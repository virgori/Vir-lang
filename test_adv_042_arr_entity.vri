# test_adv_042: Array of entity field values
# Expected: 10, 20, 30, 60

entity Point:
    x
    y
end.

func main:
    var p1 = Point(x: 10, y: 20)
    var p2 = Point(x: 30, y: 40)

    var arr = arr_new(8)
    push(arr, p1.x)
    push(arr, p1.y)
    push(arr, p2.x)

    print arr[0]
    print arr[1]
    print arr[2]

    var sum = arr[0] + arr[1] + arr[2]
    print sum
end.
