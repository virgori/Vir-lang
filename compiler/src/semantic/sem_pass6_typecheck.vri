func pass6_is_known_type(ref symbols: SymbolTable, ref scopes: ScopeTree, ty: &string):
    if fat_str_len(ty) == 0 do out true end
    if fat_cstr_eq(ty, "int") == 1 or fat_cstr_eq(ty, "i8") == 1 or fat_cstr_eq(ty, "i16") == 1 or fat_cstr_eq(ty, "i32") == 1 or fat_cstr_eq(ty, "i64") == 1 do out true end
    if fat_cstr_eq(ty, "uint") == 1 or fat_cstr_eq(ty, "u8") == 1 or fat_cstr_eq(ty, "u16") == 1 or fat_cstr_eq(ty, "u32") == 1 or fat_cstr_eq(ty, "u64") == 1 do out true end
    if fat_cstr_eq(ty, "float") == 1 or fat_cstr_eq(ty, "f32") == 1 or fat_cstr_eq(ty, "f64") == 1 do out true end
    if fat_cstr_eq(ty, "bool") == 1 or fat_cstr_eq(ty, "string") == 1 or fat_cstr_eq(ty, "ptr") == 1 or fat_cstr_eq(ty, "void") == 1 or fat_cstr_eq(ty, "any") == 1 do out true end
    if (pass6_find_entity_ast(symbols, scopes, ty) as i64) != 0 do out true end
    if (pass6_find_enum_ast(symbols, scopes, ty) as i64) != 0 do out true end
    out false
end.

func pass6_is_valid_type(ref symbols: SymbolTable, ref scopes: ScopeTree, ty: &string) -> bool:
    if fat_str_len(ty) == 0 do out false end
    let unwrapped = pass6_unwrap_type_name(ty)
    if pass6_resolve_ffi_type(unwrapped) != TypeKind.Void do out true end
    let base_name = pass6_extract_base_name(unwrapped)
    if pass6_is_known_type(symbols, scopes, base_name) do out true end
    if is_tensor_type_str(unwrapped) do out true end
    if is_flux_type_str(unwrapped as int) do out true end
    if pass6_is_array_type_str(unwrapped) do
        let elem_ty = pass6_extract_generic_or_array_elem(unwrapped)
        if fat_str_len(elem_ty) == 0 do out true end
        out pass6_is_valid_type(symbols, scopes, elem_ty)
    end
    if fat_cstr_eq(unwrapped, "dict") == 1 or fat_cstr_eq(unwrapped, "map") == 1 do out true end
    out false
end.

func pass6_is_in_generic_params(gen_params: int, ty: int):
    out typecheck_is_in_generic_params(gen_params as string, ty as string)
end.

func pass6_check_type_params_resolved(ref symbols: SymbolTable, ref scopes: ScopeTree, diag: &DiagnosticEngine, gen_params: int, ty: int, line: int):
    tlen = fat_str_len(ty)
    if tlen <= 0 or fat_str_len(gen_params) == 0 do out 0 end
    var i = 0
    var had_err = 0
    when i < tlen loop
        c = fat_str_byte_at(ty, i)
        if (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or c == 95 do
            var wstart = i
            i = i + 1
            when i < tlen loop
                c2 = fat_str_byte_at(ty, i)
                if (c2 >= 65 and c2 <= 90) or (c2 >= 97 and c2 <= 122) or (c2 >= 48 and c2 <= 57) or c2 == 95 do
                    i = i + 1
                else
                    break
                end
            end
            word = fat_str_slice(ty, wstart, i - wstart)
            if fat_cstr_eq(word, "func") != 1 and fat_cstr_eq(word, "tensor") != 1 and fat_cstr_eq(word, "mut") != 1 do
                if pass6_is_known_type(symbols, scopes, word) == 0 do
                    if pass6_is_in_generic_params(gen_params, word) == 0 do
                        report_error_info(diag, 3086, line, 0, word as string)
                        had_err = 1
                    end
                end
            end
        else
            i = i + 1
        end
    end
    out had_err
end.

func pass6_check_generic_func_def(ref symbols: SymbolTable, ref scopes: ScopeTree, diag: &DiagnosticEngine, node: &AstNode):
    if node.builtin_id == 0 do out 0 end
    gen_params = node.builtin_id as string
    if fat_str_len(node.name2) > 0 do
        pass6_check_type_params_resolved(symbols, scopes, diag, gen_params, node.name2, node.line)
    end
    child_count = vec_len_rt(node.children)
    var i = 0
    when i < child_count loop
        param = vec_get_rt(node.children, i) as AstNode
        if (param as i64) != 0 do
            if param.node_type == AstType.ParamDef or param.node_type == AstType.RefParam do
                if fat_str_len(param.name2) > 0 do
                    var pline = param.line
                    if pline <= 0 do pline = node.line end
                    pass6_check_type_params_resolved(symbols, scopes, diag, gen_params, param.name2, pline)
                end
            end
        end
        i = i + 1
    end
    out 0
end.

func pass6_check_enum_generic_arg(ref symbols: SymbolTable, ref scopes: ScopeTree, diag: &DiagnosticEngine, decl_type: &string, init_expr: &AstNode):
    if fat_str_len(decl_type) == 0 or (init_expr as i64) == 0 do out 0 end
    if init_expr.node_type != AstType.EnumConstruct do out 0 end
    let child_count = vec_len_rt(init_expr.children)
    if child_count == 0 do out 0 end
    var arg0 = vec_get_rt(init_expr.children, 0) as AstNode
    if child_count == init_expr.builtin_id + 1 and arg0.node_type == AstType.Identifier and fat_str_eq(arg0.name, init_expr.name2) == 1 do
        if child_count > 1 do
            arg0 = vec_get_rt(init_expr.children, 1) as AstNode
        else
            out 0
        end
    end
    let base_name = pass6_extract_base_name(decl_type)
    if fat_str_eq(base_name, fat_str_new("Option")) == 1 or fat_str_eq(base_name, fat_str_new("Result")) == 1 do
        let arg_type = pass6_infer_type(symbols, scopes, arg0)
        let err = typecheck_check_enum_generic_arg_rule(decl_type, init_expr.name, arg_type)
        if err != 0 do
            report_error(diag, err, init_expr.line, 0)
        end
    end
    out 0
end.

func pass6_check_enum_def(diag: &DiagnosticEngine, node: &AstNode):
    typecheck_check_enum_def(diag, node)
end.


# Entity members are selected by pass 6 from the resolved receiver AST. Keep
# their identities in the same symbol table, only for an IDE capture session.
func pass6CaptureIdeMember(symbols: SymbolTable, scopes: ScopeTree, member: &AstNode, parentId: int):
    if g_ideFactsEnabled == 0 do out 0 end
    if ideFactSymbol(member as int) >= 0 do out 0 end
    if member.node_type != AstType.Identifier and member.node_type != AstType.FuncDef do out 0 end
    var kind = SymbolKind.Variable
    if member.node_type == AstType.FuncDef do kind = SymbolKind.Method end
    let memberScope = scope_current_id(scopes)
    let symbol = SymbolNode (
        kind: kind, name_id: member.name as int, type_id: 0,
        scope_id: memberScope, ast_id: member as int, is_mutable: true,
        offset: 0, param_count: 0, return_type: 0, parent_id: parentId
    )
    let symbolId = symbol_alloc(symbols, symbol)
    ideFactResolve(member as int, symbolId, memberScope, 1)
    ideFactType(member as int, pass6_resolve_ffi_type(member.name2) as int)
end.

func pass6_type_kind_to_str(kind: TypeKind) -> string:
    if kind == TypeKind.Int do out "int" end
    if kind == TypeKind.String do out "string" end
    if kind == TypeKind.Bool do out "bool" end
    if kind == TypeKind.Float do out "float" end
    if kind == TypeKind.Array do out "array" end
    if kind == TypeKind.Entity do out "entity" end
    if kind == TypeKind.Dict do out "dict" end
    if kind == TypeKind.Tuple do out "tuple" end
    if kind == TypeKind.Func do out "func" end
    if kind == TypeKind.Tensor do out "tensor" end
    if kind == TypeKind.Void do out "void" end
    if kind == TypeKind.None do out "none" end
    out "unknown"
end.

func pass6_get_actual_type_str(ref symbols: SymbolTable, ref scopes: ScopeTree, node: &AstNode) -> string:
    if (node as i64) == 0 do out "unknown" end
    var tstr = pass6_get_expr_type_str(symbols, scopes, node)
    if fat_str_len(tstr) > 0 do out tstr end
    var tkind = pass6_infer_type(symbols, scopes, node)
    out pass6_type_kind_to_str(tkind)
end.

func pass6_report_return_type_mismatch(diag: &DiagnosticEngine, ref symbols: SymbolTable, ref scopes: ScopeTree, ret_stmt: &AstNode, ret_expr: &AstNode, expected_type_str: &string):
    var fn_ctx = fat_str_new("")
    if g_pass6_current_func_name != 0 do
        fn_ctx = g_pass6_current_func_name as string
    end
    var actual_type_str = pass6_get_actual_type_str(symbols, scopes, ret_expr)
    typecheck_report_return_type_mismatch(diag, fn_ctx, expected_type_str, actual_type_str, ret_stmt, ret_expr)
end.

func pass6_report_field_type_mismatch(diag: &DiagnosticEngine, ref symbols: SymbolTable, ref scopes: ScopeTree, assign_stmt: &AstNode, rhs_field: &AstNode, declared_field_type_str: &string):
    var fn_ctx = fat_str_new("")
    if g_pass6_current_func_name != 0 do
        fn_ctx = g_pass6_current_func_name as string
    end
    var actual_type_str = pass6_get_actual_type_str(symbols, scopes, rhs_field)
    typecheck_report_field_type_mismatch(diag, fn_ctx, declared_field_type_str, actual_type_str, assign_stmt, rhs_field)
end.

func pass6_report_type_mismatch(diag: &DiagnosticEngine, ref symbols: SymbolTable, ref scopes: ScopeTree, target_stmt: &AstNode, expr_node: &AstNode, expected_type_str: &string, actual_type_str: &string):
    var fn_ctx = fat_str_new("")
    if g_pass6_current_func_name != 0 do
        fn_ctx = g_pass6_current_func_name as string
    end
    var exp_str = expected_type_str
    var act_str = actual_type_str
    if fat_str_len(act_str) == 0 and (expr_node as i64) != 0 do
        act_str = pass6_get_actual_type_str(symbols, scopes, expr_node)
    end
    typecheck_report_type_mismatch(diag, fn_ctx, exp_str, act_str, target_stmt, expr_node)
end.

func pass6_walk(ref symbols: SymbolTable, ref scopes: ScopeTree, diag: &DiagnosticEngine, node: &AstNode):
    # Recovered/optional parser children may be represented by a null AST
    # entry.  Semantic traversal must ignore the absent child rather than
    # dereferencing its fields during large self-host inputs.
    if node as i64 == 0 do out 0 end
    # Method bodies are resolved by pass 6 rather than the pass 3 walk.
    # Capture the binding that this resolver actually selected.
    if g_ideFactsEnabled == 1 do
        if g_pass6_current_entity_name != 0 do
            if node.node_type == AstType.Identifier & ideFactSymbol(node as int) < 0 do
                let methodBinding = pass6_lookup_chain(symbols, scopes, scope_current_id(scopes), node.name)
                if methodBinding >= 0 do
                    ideFactResolve(node as int, methodBinding, scope_current_id(scopes), 2)
                    let methodSymbol = pass6_symbol_at(symbols, methodBinding)
                    ideFactType(node as int, native_read_i64(methodSymbol as int, 16))
                end
            end
        end
    end

    if node.node_type == AstType.ModuleStmt do
        g_pass6_cur_module = node.name
        out 0
    end

    if fat_str_len(node.name2) > 0 and is_tensor_type_str(node.name2) and not tensor_type_is_well_formed(node.name2) do
        report_error(diag, 3024, node.line, 0)
    end

    if node.node_type == AstType.ThrowStmt do
        if vec_len_rt(node.children) != 1 do
            report_error(diag, 3059, node.line, 0)
        else
            throw_ty = pass6_infer_type(symbols, scopes, vec_get_rt(node.children, 0) as AstNode)
            if throw_ty != TypeKind.Void and throw_ty != TypeKind.Int do
                report_error(diag, 3059, node.line, 0)
            end
        end
    end

    if node.node_type == AstType.ReturnStmt do
        if vec_len_rt(node.children) > 0 do
            var ret_val_node = vec_get_rt(node.children, 0) as AstNode
            pass6_walk(symbols, scopes, diag, ret_val_node)
            if g_pass6_current_func_ret_type != 0 do
                var cur_ret_str = g_pass6_current_func_ret_type as string
                if fat_str_len(cur_ret_str) > 0 do
                    var actual_ret_kind = pass6_infer_type(symbols, scopes, ret_val_node)
                    var ret_ent = pass6_find_entity_ast(symbols, scopes, pass6_extract_base_name(cur_ret_str))
                    if (ret_ent as i64) != 0 do
                        if ret_val_node.node_type == AstType.ArrayLiteral do
                            pass6_report_return_type_mismatch(diag, symbols, scopes, node, ret_val_node, cur_ret_str)
                        eif ret_val_node.node_type == AstType.LiteralStr or (ret_val_node.node_type == AstType.LiteralInt and ret_val_node.int_val != 0) or ret_val_node.node_type == AstType.LiteralBool or ret_val_node.node_type == AstType.DictLiteral or ret_val_node.node_type == AstType.TupleExpr do
                            pass6_report_return_type_mismatch(diag, symbols, scopes, node, ret_val_node, cur_ret_str)
                        eif ret_val_node.node_type == AstType.LiteralInt and ret_val_node.int_val == 0 do
                            # 0 is null pointer/entity reference
                        else
                            var r_val_str = pass6_get_expr_type_str(symbols, scopes, ret_val_node)
                            if fat_str_len(r_val_str) > 0 do
                                if pass6_is_array_type_str(r_val_str) do
                                    pass6_report_return_type_mismatch(diag, symbols, scopes, node, ret_val_node, cur_ret_str)
                                else
                                    var r_a_ent = pass6_find_entity_ast(symbols, scopes, pass6_extract_base_name(r_val_str))
                                    if (r_a_ent as i64) != 0 do
                                        if pass6_type_strings_compatible(symbols, scopes, cur_ret_str, r_val_str) == 0 do
                                            pass6_report_return_type_mismatch(diag, symbols, scopes, node, ret_val_node, cur_ret_str)
                                        end
                                    end
                                end
                            end
                        end
                    eif pass6_is_array_type_str(cur_ret_str) do
                        if ret_val_node.node_type == AstType.EntityLiteral do
                            pass6_report_return_type_mismatch(diag, symbols, scopes, node, ret_val_node, cur_ret_str)
                        eif ret_val_node.node_type == AstType.LiteralStr or ret_val_node.node_type == AstType.LiteralInt or ret_val_node.node_type == AstType.LiteralBool or ret_val_node.node_type == AstType.DictLiteral or ret_val_node.node_type == AstType.TupleExpr do
                            pass6_report_return_type_mismatch(diag, symbols, scopes, node, ret_val_node, cur_ret_str)
                        else
                            var r_val_arr_str = pass6_get_expr_type_str(symbols, scopes, ret_val_node)
                            if fat_str_len(r_val_arr_str) > 0 do
                                var r_a_ent2 = pass6_find_entity_ast(symbols, scopes, pass6_extract_base_name(r_val_arr_str))
                                if (r_a_ent2 as i64) != 0 do
                                    pass6_report_return_type_mismatch(diag, symbols, scopes, node, ret_val_node, cur_ret_str)
                                eif pass6_type_strings_compatible(symbols, scopes, cur_ret_str, r_val_arr_str) == 0 do
                                    pass6_report_return_type_mismatch(diag, symbols, scopes, node, ret_val_node, cur_ret_str)
                                end
                            end
                        end
                    else
                        var ret_expected_kind = pass6_resolve_ffi_type(cur_ret_str)
                        if ret_expected_kind == TypeKind.String and ret_val_node.node_type == AstType.LiteralInt do
                            pass6_report_return_type_mismatch(diag, symbols, scopes, node, ret_val_node, cur_ret_str)
                        eif ret_expected_kind == TypeKind.Int and ret_val_node.node_type == AstType.LiteralStr do
                            pass6_report_return_type_mismatch(diag, symbols, scopes, node, ret_val_node, cur_ret_str)
                        eif ret_expected_kind == TypeKind.Bool and (ret_val_node.node_type == AstType.LiteralStr or ret_val_node.node_type == AstType.LiteralInt) do
                            pass6_report_return_type_mismatch(diag, symbols, scopes, node, ret_val_node, cur_ret_str)
                        eif ret_expected_kind != TypeKind.Void and ret_expected_kind != TypeKind.None and actual_ret_kind != TypeKind.Void do
                            if pass6_types_compatible(ret_expected_kind as i64, actual_ret_kind) == 0 do
                                # In system/compiler modules, allow bool↔int return mismatch.
                                var allow_ret = 0
                                if is_user_module(g_pass6_cur_module) == 0 do
                                    if (ret_expected_kind == TypeKind.Bool and pass6_is_integer_like(actual_ret_kind as i64) == 1) or (pass6_is_integer_like(ret_expected_kind as i64) == 1 and actual_ret_kind == TypeKind.Bool) do
                                        allow_ret = 1
                                    end
                                end
                                if allow_ret == 0 do
                                    pass6_report_return_type_mismatch(diag, symbols, scopes, node, ret_val_node, cur_ret_str)
                                end
                            end
                        end
                    end
                end
            end
        end
        out 0
    end

    if node.node_type == AstType.PrintStmt do
        if vec_len_rt(node.children) > 0 do
            var p_expr = vec_get_rt(node.children, 0) as AstNode
            pass6_walk(symbols, scopes, diag, p_expr)
            var p_ty = pass6_infer_type(symbols, scopes, p_expr)
            var p_is_ent = false
            if p_expr.node_type == AstType.EntityLiteral do
                p_is_ent = true
            eif p_expr.node_type == AstType.Identifier do
                var p_ent_name = pass6_get_var_type(p_expr.name)
                if fat_str_len(p_ent_name) > 0 do
                    var p_raw = pass6_unwrap_type_name(p_ent_name)
                    if (pass6_find_entity_ast(symbols, scopes, p_raw) as i64) != 0 do
                        p_is_ent = true
                    end
                end
            eif p_ty == TypeKind.Entity do
                var ent_cname = fat_str_new("")
                if p_expr.node_type == AstType.Call or p_expr.node_type == AstType.MethodCall do
                    ent_cname = pass6_get_receiver_entity_name(symbols, scopes, p_expr)
                end
                if fat_str_len(ent_cname) > 0 do
                    var ent_raw = pass6_unwrap_type_name(ent_cname)
                    if (pass6_find_entity_ast(symbols, scopes, ent_raw) as i64) != 0 do
                        p_is_ent = true
                    end
                end
            end
            if p_is_ent or p_ty == TypeKind.Pointer do
                report_error(diag, 3001, node.line, 0)
            end
            out 0
        end
    end

    if node.node_type == AstType.AddrOf do
        if vec_len_rt(node.children) > 0 do
            var target = vec_get_rt(node.children, 0) as AstNode
            pass6_walk(symbols, scopes, diag, target)
            var is_mut_borrow = false
            if fat_cstr_eq(node.name, "mut") == 1 or node.int_val == 1 do
                is_mut_borrow = true
            end
            if is_mut_borrow do
                var is_immutable = false
                var root_name = pass6_lvalue_root_name(target)
                if fat_str_len(root_name) > 0 do
                    var addr_sid = pass6_lookup_chain(symbols, scopes, scope_current_id(scopes), root_name)
                    if addr_sid != -1 do
                        var addr_sym = pass6_symbol_at(symbols, addr_sid)
                        if addr_sym.ast_id != 0 do
                            var d_ast = addr_sym.ast_id as AstNode
                            if d_ast.node_type == AstType.ConstDecl do
                                is_immutable = true
                            end
                            var d_ty = d_ast.name2
                            if fat_str_len(d_ty) > 0 do
                                if fat_str_byte_at(d_ty, 0) == 38 do
                                    var has_mut = false
                                    var blen = fat_str_len(d_ty)
                                    if blen >= 4 and fat_str_byte_at(d_ty, 1) == 109 and fat_str_byte_at(d_ty, 2) == 117 and fat_str_byte_at(d_ty, 3) == 116 do
                                        has_mut = true
                                    end
                                    if not has_mut do
                                        is_immutable = true
                                    end
                                eif fat_str_len(d_ty) >= 4 and fat_str_byte_at(d_ty, 0) == 114 and fat_str_byte_at(d_ty, 1) == 101 and fat_str_byte_at(d_ty, 2) == 102 and fat_str_byte_at(d_ty, 3) == 32 do
                                    is_immutable = true
                                end
                            end
                        end
                    end
                end
                if is_immutable do
                    report_error(diag, 3003, node.line, 0)
                end
            end
        end
        out 0
    end

    if node.node_type == AstType.EmitStmt do
        if vec_len_rt(node.children) != 1 do
            report_error(diag, 3073, node.line, 0)
        else
            emit_expr = vec_get_rt(node.children, 0) as AstNode
            if emit_expr.node_type != AstType.Call and emit_expr.node_type != AstType.EntityLiteral do
                report_error(diag, 3073, node.line, 0)
            end
        end
    end

    if node.node_type == AstType.AtomicVarDecl do
        if vec_len_rt(node.children) != 1 do
            report_error(diag, 3072, node.line, 0)
        else
            atomic_decl = vec_get_rt(node.children, 0) as AstNode
            atomic_ty = pass6_resolve_ffi_type(atomic_decl.name2)
            if atomic_ty == TypeKind.String or atomic_ty == TypeKind.Pointer or atomic_ty == TypeKind.Entity or atomic_ty == TypeKind.Array or atomic_ty == TypeKind.Tensor do
                report_error(diag, 3072, node.line, 0)
            end
        end
    end

    if node.node_type == AstType.EntityLiteral do
        pass6_check_packed_literal(symbols, scopes, diag, node)
        ent_ast = pass6_find_best_entity_ast(symbols, scopes, node)
        if (ent_ast as i64) != 0 do
            if g_ideFactsEnabled == 1 do
                var valueIndex = 0
                when valueIndex < vec_len_rt(node.children) loop
                    let fieldValue = vec_get_rt(node.children, valueIndex) as AstNode
                    let labelNode = ideFactProjection(fieldValue as int)
                    if labelNode != 0 do
                        var fieldIndex = 0
                        when fieldIndex < vec_len_rt(ent_ast.children) loop
                            let fieldDecl = vec_get_rt(ent_ast.children, fieldIndex) as AstNode
                            if fieldDecl.node_type == AstType.Identifier do
                                if fat_str_eq(fieldDecl.name, fieldValue.name2) == 1 do
                                    ideFactResolve(labelNode, ideFactSymbol(fieldDecl as int), scope_current_id(scopes), 4)
                                end
                            end
                            fieldIndex = fieldIndex + 1
                        end
                    end
                    valueIndex = valueIndex + 1
                end
            end
            if ent_ast.builtin_id != 0 do
                ent_decl_cnt = count_list_items(ent_ast.builtin_id as string)
                var ent_prov_cnt = 0
                if fat_str_len(node.name2) > 0 do
                    ent_prov_cnt = count_list_items(node.name2)
                end
                if ent_decl_cnt != ent_prov_cnt do
                    report_error(diag, 3085, node.line, 0)
                end
            end
        end
    end

    if node.node_type == AstType.RegisterDef do
        var base_bits = pass6_register_base_bits(node.name2)
        var rf_i = 0
        when rf_i < vec_len_rt(node.children) loop
            var rf = vec_get_rt(node.children, rf_i) as AstNode
            var rf_width = rf.builtin_id
            if rf_width <= 0 do
                report_error(diag, 3077, rf.line, 0)
            eif base_bits <= 0 or rf.int_val < 0 or rf.int_val + rf_width > base_bits do
                report_error(diag, 3078, rf.line, 0)
            end
            rf_i = rf_i + 1
        end
    end

    # Register/mold fields are unsigned bit slices. Reject constant writes
    # that would otherwise be silently truncated by BIT_INSERT.
    if node.node_type == AstType.FieldAssign and vec_len_rt(node.children) > 0 do
        out pass6WalkFieldAssign(symbols, scopes, diag, node)
    end

    if node.node_type == AstType.EntityDef or node.node_type == AstType.PackedDef do
        if node.node_type == AstType.PackedDef do
            pass6_check_packed_def(symbols, scopes, diag, node)
        end
        old_ent = g_pass6_current_entity_name
        g_pass6_current_entity_name = node.name as i64
        pass6_set_var_type(fat_str_new("this"), node.name)
        pass6_scope_enter()
        scope_push(scopes, ScopeKind.Entity)
        child_count = vec_len_rt(node.children)
        var i = 0
        when i < child_count loop
            child = vec_get_rt(node.children, i)
            pass6CaptureIdeMember(symbols, scopes, child, ideFactSymbol(node as int))
            pass6_walk(symbols, scopes, diag, child)
            i = i + 1
        end
        scope_pop(scopes)
        pass6_scope_exit()
        g_pass6_current_entity_name = old_ent
        if old_ent != 0 do
            pass6_set_var_type(fat_str_new("this"), old_ent as string)
        end
        out 0
    end

    if node.node_type == AstType.MethodCall do
        if fat_cstr_eq(node.name, "backward") == 1 do
            if g_pass6_ai_mode == 1 do
                report_error(diag, 3009, node.line, 0)
            eif g_pass6_ai_mode != 2 do
                report_error(diag, 3017, node.line, 0)
            else
                backward_ok = false
                if vec_len_rt(node.children) > 0 do
                    recv = vec_get_rt(node.children, 0)
                    recv_ty = pass6_infer_type(symbols, scopes, recv)
                    if recv.node_type == AstType.Identifier and pass6_name_in_vec(g_pass6_train_values, recv.name) == 1 and (recv_ty == TypeKind.Float or recv_ty == TypeKind.Tensor) do
                        backward_ok = true
                    end
                end
                if not backward_ok do report_error(diag, 3020, node.line, 0) end
            end
            out 0
        end
        pass6_check_method_call(symbols, scopes, diag, node)
        out 0
    end

    if node.node_type == AstType.FieldAccess do
        out pass6WalkFieldAccess(symbols, scopes, diag, node)
    end

    if node.node_type == AstType.QuantizeExpr do
        q_count = vec_len_rt(node.children)
        if q_count != 2 do
            report_error(diag, 3019, node.line, 0)
        else
            q_value = vec_get_rt(node.children, 0)
            q_bits_expr = vec_get_rt(node.children, 1)
            q_value_type = pass6_infer_type(symbols, scopes, q_value)
            q_tensor_name = pass6_tensor_type_name(symbols, scopes, q_value)
            let q_val_err = typecheck_check_quantize_val(q_value_type, q_tensor_name)
            if q_val_err != 0 do
                report_error(diag, q_val_err, node.line, 0)
            end
            var q_bits = 8
            if q_bits_expr.node_type != AstType.LiteralInt do
                report_error(diag, 3019, q_bits_expr.line, 0)
            else
                q_bits = q_bits_expr.int_val
                let q_bit_err = typecheck_check_quantize_bits(q_bits)
                if q_bit_err != 0 do
                    report_error(diag, q_bit_err, q_bits_expr.line, 0)
                end
            end
            if is_tensor_type_str(q_tensor_name) do
                let elem_c = parse_tensor_elem_code(q_tensor_name as int)
                let shape_v = parse_tensor_shape(q_tensor_name)
                node.name2 = format_quantized_uniform_type(elem_c, q_bits, shape_v)
            else
                node.name2 = fat_str_new("QuantizedTensor")
            end
            pass6_walk(symbols, scopes, diag, q_value)
            pass6_walk(symbols, scopes, diag, q_bits_expr)
        end
        out 0
    end

    # String Interpolation Type Check & Node Binding
    if node.node_type == AstType.InterpExpr do
        child_count = vec_len_rt(node.children)
        var i = 0
        when i < child_count loop
            child = vec_get_rt(node.children, i)
            pass6_walk(symbols, scopes, diag, child)
            if child.node_type != AstType.LiteralStr do
                ct = pass6_infer_interp_type(symbols, scopes, child)
                # Preserve call/method builtin_id metadata. int_val is unused on
                # non-literal interpolation children and carries the checked
                # TypeKind across the semantic arena into AST-to-MIR.
                child.int_val = ct as int
                # Spec §12 defines string, integer, bool and none formatting.
                # Other representations must be rejected rather than passed to
                # str_cat as raw pointers. Float formatting has no Spec contract.
                if ct != TypeKind.String and ct != TypeKind.Int and ct != TypeKind.Bool and ct != TypeKind.None do
                    report_error(diag, 3001, child.line, 0)
                end
            end
            i = i + 1
        end
        out 0
    end

    # Spec §10.1: postfix percent accepts exactly one numeric operand and
    # always produces Float. Keep this separate from binary `mod` checking.
    if node.node_type == AstType.PercentExpr do
        percent_child_count = vec_len_rt(node.children)
        if percent_child_count != 1 do
            report_error(diag, 3002, node.line, 0)
        else
            percent_value = vec_get_rt(node.children, 0)
            percent_type = pass6_infer_type(symbols, scopes, percent_value)
            if percent_type != TypeKind.Void and percent_type != TypeKind.Int and percent_type != TypeKind.Float do
                report_error(diag, 3002, node.line, 0)
            end
            pass6_walk(symbols, scopes, diag, percent_value)
        end
        out 0
    end

    # 1. Binary Operator Type Check
    if node.node_type == AstType.BinOp do
        out pass6WalkBinOp(symbols, scopes, diag, node)
    end

    # 2. Assignment & L-Value Check
    # Parser shape: Assign.name = LHS ident; children[0] = RHS (not lhs child).
    if node.node_type == AstType.Assign do
        out pass6WalkAssign(symbols, scopes, diag, node)
    end

    if node.node_type == AstType.SwizzleAssign do
        out pass6WalkSwizzleAssign(symbols, scopes, diag, node)
    end

    if node.node_type == AstType.SwizzleExpr do
        out pass6WalkSwizzleExpr(symbols, scopes, diag, node)
    end

    if node.node_type == AstType.EnumDef do
        pass6_check_enum_def(diag, node)
        out 0
    end

    if node.node_type == AstType.CaseExpr do
        pass6_check_case_expr(symbols, scopes, diag, node)
        out 0
    end

    if node.node_type == AstType.CastExpr do
        if pass6_is_valid_type(symbols, scopes, node.name) == false do
            pass6_report_type_mismatch(diag, symbols, scopes, node, node, node.name, "unknown")
        end
    end

    if node.node_type == AstType.Compare do
        child_count_cmp = vec_len_rt(node.children)
        if child_count_cmp >= 2 do
            left_cmp = vec_get_rt(node.children, 0) as AstNode
            right_cmp = vec_get_rt(node.children, 1) as AstNode
            left_type_str = pass6_get_receiver_entity_name(symbols, scopes, left_cmp)
            right_type_str = pass6_get_receiver_entity_name(symbols, scopes, right_cmp)
            left_enum = pass6_find_enum_ast(symbols, scopes, left_type_str)
            right_enum = pass6_find_enum_ast(symbols, scopes, right_type_str)
            typecheck_check_enum_compare(diag, left_enum, right_enum, node.line)
        end
    end

    # 3. Call Resolution & Argument Count Check
    if node.node_type == AstType.EnumConstruct do
        arg_start = typecheck_check_enum_construct(diag, node)
        var vi = arg_start
        let child_count = vec_len_rt(node.children)
        when vi < child_count loop
            pass6_walk(symbols, scopes, diag, vec_get_rt(node.children, vi))
            vi = vi + 1
        end
        out 0
    end

    if node.node_type == AstType.Call do
        out pass6WalkCall(symbols, scopes, diag, node)
    end

    # A dict literal has one key type inferred from its first pair. Reject
    # mixed-key literals before lowering can compare incompatible bit patterns.
    if node.node_type == AstType.DictLiteral do
        key_type = pass6_dict_literal_key_type(symbols, scopes, node)
        child_count = vec_len_rt(node.children)
        var ki = 2
        when ki < child_count loop
            key_node = vec_get_rt(node.children, ki) as AstNode
            given_type = pass6_dict_key_expr_type(symbols, scopes, key_node)
            if key_type != TypeKind.Void and given_type != TypeKind.Void and given_type != key_type do
                pass6_report_type_mismatch(diag, symbols, scopes, node, key_node, pass6_type_kind_to_str(key_type), pass6_type_kind_to_str(given_type))
            end
            ki = ki + 2
        end
        var ci = 0
        when ci < child_count loop
            pass6_walk(symbols, scopes, diag, vec_get_rt(node.children, ci) as AstNode)
            ci = ci + 1
        end
        out 0
    end

    # 4. Index Access Check (Index must be Int, rank matching for tensor)
    if node.node_type == AstType.IndexAccess or node.node_type == AstType.ExprIndex do
        child_count = vec_len_rt(node.children)
        var start_idx = 0
        var is_tensor_base = false
        var expected_rank = 0
        var is_quantized = false
        var is_dict_base = false
        var dict_key_type = TypeKind.Void
        if node.node_type == AstType.IndexAccess do
            var q_vty = pass6_get_var_type(node.name)
            if fat_cstr_eq(q_vty, "QuantizedTensor") == 1 or is_quantized_type_str(q_vty as int) do
                is_quantized = true
                if is_quantized_type_str(q_vty as int) do
                    expected_rank = parse_quantized_rank(q_vty as int)
                    is_tensor_base = true
                end
            end
            if fat_cstr_eq(q_vty, "dict") == 1 do
                is_dict_base = true
                dict_key_type = pass6_dict_var_key_type(symbols, scopes, node.name)
            end
            start_idx = 0
            found_base = pass6_lookup_chain(symbols, scopes, scope_current_id(scopes), node.name)
            if found_base != -1 do
                sym_base = pass6_symbol_at(symbols, found_base)
                if (sym_base.type_id as TypeKind) == TypeKind.Tensor do
                    is_tensor_base = true
                    if sym_base.ast_id != 0 do
                        base_ast = sym_base.ast_id as AstNode
                        if is_tensor_type_str(base_ast.name2) do
                            expected_rank = parse_tensor_rank(base_ast.name2)
                        end
                    end
                end
            end
        else
            start_idx = 1
            if child_count > 0 do
                base_expr = vec_get_rt(node.children, 0)
                if base_expr.node_type == AstType.Identifier do
                    var q_vty2 = pass6_get_var_type(base_expr.name)
                    if fat_cstr_eq(q_vty2, "QuantizedTensor") == 1 or is_quantized_type_str(q_vty2 as int) do
                        is_quantized = true
                        if is_quantized_type_str(q_vty2 as int) do
                            expected_rank = parse_quantized_rank(q_vty2 as int)
                            is_tensor_base = true
                        end
                    end
                    if fat_cstr_eq(q_vty2, "dict") == 1 do
                        is_dict_base = true
                        dict_key_type = pass6_dict_var_key_type(symbols, scopes, base_expr.name)
                    end
                end
                base_ty = pass6_infer_type(symbols, scopes, base_expr)
                if base_ty == TypeKind.Tensor do
                    is_tensor_base = true
                    if base_expr.node_type == AstType.Identifier do
                        found_expr_base = pass6_lookup_chain(symbols, scopes, scope_current_id(scopes), base_expr.name)
                        if found_expr_base != -1 do
                            expr_sym = pass6_symbol_at(symbols, found_expr_base)
                            if expr_sym.ast_id != 0 do
                                expr_ast = expr_sym.ast_id as AstNode
                                if is_tensor_type_str(expr_ast.name2) do expected_rank = parse_tensor_rank(expr_ast.name2) end
                            end
                        end
                    end
                end
            end
        end
        if is_quantized do
            if g_pass6_ai_mode != 1 do
                report_error(diag, 3023, node.line, 0)
                out 0
            end
        end
        # Check rank if tensor
        if is_tensor_base and expected_rank > 0 do
            let given_indices = child_count - start_idx
            typecheck_check_index_rank(diag, node.line, given_indices, expected_rank)
        end
        # Check all index expressions are Int
        var ii = start_idx
        when ii < child_count loop
            idx_node = vec_get_rt(node.children, ii)
            idx_type = pass6_dict_key_expr_type(symbols, scopes, idx_node)
            let idx_status = typecheck_check_index_expr_type(diag, node.line, idx_type, is_dict_base, dict_key_type)
            if idx_status == 1 do
                pass6_report_type_mismatch(diag, symbols, scopes, node, idx_node, pass6_type_kind_to_str(dict_key_type), pass6_type_kind_to_str(idx_type))
            end
            ii = ii + 1
        end
        var i = 0
        when i < child_count loop
            child = vec_get_rt(node.children, i)
            pass6_walk(symbols, scopes, diag, child)
            i = i + 1
        end
        out 0
    end

    # 4b. Index Assign Check (Index must be Int, rank matching for tensor)
    if node.node_type == AstType.IndexAssign do
        child_count = vec_len_rt(node.children)
        if child_count >= 2 do
            var is_dict_base = false
            var dict_key_type = TypeKind.Void
            var assign_vty = pass6_get_var_type(node.name)
            if fat_cstr_eq(assign_vty, "dict") == 1 do
                is_dict_base = true
                dict_key_type = pass6_dict_var_key_type(symbols, scopes, node.name)
            end
            found_base = pass6_lookup_chain(symbols, scopes, scope_current_id(scopes), node.name)
            if found_base != -1 do
                sym_base = pass6_symbol_at(symbols, found_base)
                if (sym_base.type_id as TypeKind) == TypeKind.Tensor and sym_base.ast_id != 0 do
                    base_ast = sym_base.ast_id as AstNode
                    if is_tensor_type_str(base_ast.name2) do
                        expected_rank = parse_tensor_rank(base_ast.name2)
                        num_indices = child_count - 1
                        typecheck_check_index_rank(diag, node.line, num_indices, expected_rank)
                        value_node = vec_get_rt(node.children, child_count - 1)
                        value_type = pass6_infer_type(symbols, scopes, value_node)
                        elem_type = parse_tensor_elem_type(base_ast.name2)
                        if value_type != TypeKind.Void and value_type != elem_type and not (elem_type == TypeKind.Float and (value_type == TypeKind.Int or pass6_is_integer_like(value_type) == 1)) do
                            pass6_report_type_mismatch(diag, symbols, scopes, node, value_node, pass6_type_kind_to_str(elem_type), pass6_type_kind_to_str(value_type))
                        end
                    end
                end
            end
            var ii = 0
            when ii < child_count - 1 loop
                idx_node = vec_get_rt(node.children, ii)
                idx_type = pass6_dict_key_expr_type(symbols, scopes, idx_node)
                let idx_status = typecheck_check_index_expr_type(diag, node.line, idx_type, is_dict_base, dict_key_type)
                if idx_status == 1 do
                    pass6_report_type_mismatch(diag, symbols, scopes, node, idx_node, pass6_type_kind_to_str(dict_key_type), pass6_type_kind_to_str(idx_type))
                end
                ii = ii + 1
            end
            var assigned_val_node = vec_get_rt(node.children, child_count - 1) as AstNode
            var assigned_val_ty = pass6_infer_type(symbols, scopes, assigned_val_node)
            if is_dict_base do
                var expected_dict_val = pass6_dict_var_value_type(symbols, scopes, node.name)
                if expected_dict_val != TypeKind.Void and assigned_val_ty != TypeKind.Void do
                    if pass6_types_compatible(expected_dict_val as i64, assigned_val_ty) == 0 do
                        pass6_report_type_mismatch(diag, symbols, scopes, node, assigned_val_node, pass6_type_kind_to_str(expected_dict_val), pass6_type_kind_to_str(assigned_val_ty))
                    end
                end
            else
                var expected_arr_elem = pass6_array_var_elem_type(symbols, scopes, node.name)
                if expected_arr_elem != TypeKind.Void and assigned_val_ty != TypeKind.Void do
                    if pass6_types_compatible(expected_arr_elem as i64, assigned_val_ty) == 0 do
                        pass6_report_type_mismatch(diag, symbols, scopes, node, assigned_val_node, pass6_type_kind_to_str(expected_arr_elem), pass6_type_kind_to_str(assigned_val_ty))
                    end
                end
            end
        end
        var i = 0
        when i < child_count loop
            child = vec_get_rt(node.children, i)
            pass6_walk(symbols, scopes, diag, child)
            i = i + 1
        end
        out 0
    end
    if node.node_type == AstType.BindAttr do
        if fat_cstr_eq(node.name2, "c") == 1 or fat_cstr_eq(node.name2, "wasm") == 1 or fat_cstr_eq(node.name, "c") == 1 or fat_cstr_eq(node.name, "wasm") == 1 do
            if vec_len_rt(node.children) > 0 do
                fn_child = vec_get_rt(node.children, 0) as AstNode
                if fn_child.node_type == AstType.FuncDef or fn_child.node_type == AstType.ExternFunc do
                    var is_wasm = 0
                    if fat_cstr_eq(node.name2, "wasm") == 1 or fat_cstr_eq(node.name, "wasm") == 1 do
                        is_wasm = 1
                    end
                    var fpi = 0
                    when fpi < vec_len_rt(fn_child.children) loop
                        fp_node = vec_get_rt(fn_child.children, fpi) as AstNode
                        if fp_node.node_type == AstType.ParamDef or fp_node.node_type == AstType.RefParam or fp_node.node_type == AstType.OutParam or fp_node.node_type == AstType.Identifier do
                            if fat_str_len(fp_node.name2) == 0 do
                                if is_wasm == 1 do
                                    report_error_loc(diag, 3095, 0, fn_child.line, 1, "wasm")
                                else
                                    report_error_loc(diag, 3095, 0, fn_child.line, 1, "c")
                                end
                            end
                        end
                        fpi = fpi + 1
                    end
                end
            end
        end
        child_count = vec_len_rt(node.children)
        if child_count > 0 do
            child = vec_get_rt(node.children, 0)
            pass6_walk(symbols, scopes, diag, child)
        end
        out 0
    end

    if node.node_type == AstType.InferBlock do
        old_ai_mode = g_pass6_ai_mode
        if old_ai_mode != 0 do
            report_error(diag, 3016, node.line, 0)
        end
        g_pass6_ai_mode = 1
        child_count = vec_len_rt(node.children)
        var i = 0
        when i < child_count loop
            child = vec_get_rt(node.children, i)
            pass6_walk(symbols, scopes, diag, child)
            i = i + 1
        end
        g_pass6_ai_mode = old_ai_mode
        out 0
    end

    if node.node_type == AstType.TrainBlock do
        old_ai_mode = g_pass6_ai_mode
        if old_ai_mode != 0 do
            report_error(diag, 3016, node.line, 0)
        end
        g_pass6_ai_mode = 2
        child_count = vec_len_rt(node.children)
        var i = 0
        when i < child_count loop
            child = vec_get_rt(node.children, i)
            pass6_walk(symbols, scopes, diag, child)
            i = i + 1
        end
        g_pass6_ai_mode = old_ai_mode
        out 0
    end

    if node.node_type == AstType.ReactiveDecl or node.node_type == AstType.BundleExpr or node.node_type == AstType.ExposeAttr do
        child_count = vec_len_rt(node.children)
        var i = 0
        when i < child_count loop
            child = vec_get_rt(node.children, i)
            pass6_walk(symbols, scopes, diag, child)
            i = i + 1
        end
        out 0
    end

    # 5. FuncDef Scope & Local Parameter Registration
    if node.node_type == AstType.FuncDef do
        var old_cur_gen = g_pass6_current_generic_params
        if node.builtin_id != 0 do
            g_pass6_current_generic_params = node.builtin_id as string
            pass6_check_generic_func_def(symbols, scopes, diag, node)
        else
            g_pass6_current_generic_params = fat_str_new("")
        end
        var old_func_name = g_pass6_current_func_name
        g_pass6_current_func_name = node.name as i64
        var old_cur_ret = g_pass6_current_func_ret_type
        g_pass6_current_func_ret_type = node.name2 as i64
        g_pass6_assigned_vars = vec_new_rt()
        g_pass6_var_names = vec_new_rt()
        g_pass6_var_types = vec_new_rt()
        pass6_scope_enter()
        scope_push(scopes, ScopeKind.Func)
        child_count = vec_len_rt(node.children)
        body_idx = child_count - 1
        if body_idx < 0 do
            body_idx = 0
        end
        var bi = 0
        when bi < child_count loop
            ch = vec_get_rt(node.children, bi)
            if ch.node_type == AstType.Block do
                body_idx = bi
                bi = child_count
            else
                bi = bi + 1
            end
        end
        var i = 0
        when i < body_idx loop
            param = vec_get_rt(node.children, i)
            sid = pass6_register_local(symbols, scopes, param.name, true)
            if g_ideFactsEnabled == 1 do
                if g_pass6_current_entity_name != 0 do
                    ideFactResolve(param as int, sid, scope_current_id(scopes), 1)
                    ideFactType(param as int, pass6_resolve_ffi_type(param.name2) as int)
                end
            end
            if sid != -1 do
                psym = pass6_symbol_at(symbols, sid)
                native_write_i64(psym as i64, 32, param as i64)
                param_kind = pass6_resolve_ffi_type(param.name2)
                if fat_str_len(param.name2) > 0 and is_tensor_type_str(param.name2) do
                    native_write_i64(psym as i64, 16, TypeKind.Tensor as i64)
                eif param_kind != TypeKind.Void do
                    native_write_i64(psym as i64, 16, param_kind as i64)
                else
                    var p_ent = pass6_find_entity_ast(symbols, scopes, pass6_extract_base_name(param.name2))
                    if (p_ent as i64) != 0 do
                        native_write_i64(psym as i64, 16, TypeKind.Entity as i64)
                    eif pass6_is_array_type_str(param.name2) do
                        native_write_i64(psym as i64, 16, TypeKind.Array as i64)
                    eif psym.type_id == 0 do
                        native_write_i64(psym as i64, 16, TypeKind.Int as i64)
                    end
                end
            end
            if fat_str_len(param.name2) > 0 do
                pass6_set_var_type(param.name, param.name2)
            end
            i = i + 1
        end
        var j = body_idx
        when j < child_count loop
            child = vec_get_rt(node.children, j)
            pass6_walk(symbols, scopes, diag, child)
            j = j + 1
        end
        scope_pop(scopes)
        pass6_scope_exit()
        g_pass6_current_func_ret_type = old_cur_ret
        g_pass6_current_generic_params = old_cur_gen
        g_pass6_current_func_name = old_func_name
        out 0
    end

    if node.node_type == AstType.Block do
        pass6_scope_enter()
        scope_push(scopes, ScopeKind.Block)
        if g_ideFactsEnabled == 1 do
            if g_pass6_current_entity_name != 0 do
                ideFactScope(node as int, scope_current_id(scopes))
            end
        end
        child_count = vec_len_rt(node.children)
        var i = 0
        when i < child_count loop
            child = vec_get_rt(node.children, i)
            pass6_walk(symbols, scopes, diag, child)
            i = i + 1
        end
        scope_pop(scopes)
        pass6_scope_exit()
        out 0
    end

    if node.node_type == AstType.MapExpr do
        child_count = vec_len_rt(node.children)
        if child_count > 0 do
            pass6_walk(symbols, scopes, diag, vec_get_rt(node.children, 0))
        end
        pass6_scope_enter()
        scope_push(scopes, ScopeKind.Block)
        if fat_str_len(node.name) > 0 and fat_cstr_eq(node.name, "map") == 0 do
            pass6_register_local(symbols, scopes, node.name, true)
        end
        var mi = 1
        when mi < child_count loop
            pass6_walk(symbols, scopes, diag, vec_get_rt(node.children, mi))
            mi = mi + 1
        end
        scope_pop(scopes)
        pass6_scope_exit()
        out 0
    end

    if node.node_type == AstType.ExternFunc do
        out 0
    end

    if node.node_type == AstType.VarDecl do
        out pass6WalkVarDecl(symbols, scopes, diag, node)
    end

    if node.node_type == AstType.VarDeclGroup do
        child_count = vec_len_rt(node.children)
        var vi = 0
        when vi < child_count loop
            child = vec_get_rt(node.children, vi)
            pass6_walk(symbols, scopes, diag, child)
            vi = vi + 1
        end
        out 0
    end

    if node.node_type == AstType.ConstDecl do
        out pass6WalkConstDecl(symbols, scopes, diag, node)
    end

    # Default recurse
    child_count = vec_len_rt(node.children)
    var i = 0
    when i < child_count loop
        child = vec_get_rt(node.children, i)
        pass6_walk(symbols, scopes, diag, child)
        i = i + 1
    end
    out 0
end.


export pass6_typecheck
