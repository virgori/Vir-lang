##
 * vir/compiler/sem_pass6_typecheck.vri
 * ==============================================================
 * Pass 6: Complete Type Checking for Vir v2.0
 * Validates type compatibility for operators, assignments, calls,
 * returns, entity field accesses, and array indexing.
 ##

include typecheck_context
include ide_facts
include typecheck_index
include typecheck_compatibility
include typecheck_inference
include typecheck_calls
include typecheck_methods
include typecheck_assignment
include typecheck_operators
include typecheck_tensor
include typecheck_generics
include typecheck_entities
include typecheck_enums
include typecheck_patterns
include typecheck_containers
include typecheck_ffi
include typecheck_diagnostics
include typecheck_lookup
include typecheck_lvalue
include typecheck_walk_decl
include typecheck_walk_stmt
include typecheck_walk_case
include typecheck_walk_method
include typecheck_walk_field
include typecheck_walk_expr

# Hash ONLY global scope.  Orphan Func/Block nodes from prior passes would
# make a dense per-scope 256-bucket table allocate millions of vecs.
const PASS6_BUCKETS: int = 256
var g_pass6_symbols: i64 = 0
var g_pass6_scopes: i64 = 0
var g_pass6_diag: i64 = 0
var g_pass6_global_buckets: i64 = 0
var g_pass6_suffix_buckets: i64 = 0
var g_pass6_scope_buckets: i64 = 0
const PASS6_SCOPE_BUCKETS_COUNT: int = 1024
var g_pass6_extern_names: i64 = 0
var g_pass6_extern_nodes: i64 = 0
var g_pass6_extern_buckets: i64 = 0
var g_pass6_ai_mode: int = 0 # 0=normal, 1=infer, 2=train
var g_pass6_infer_values: i64 = 0
var g_pass6_train_values: i64 = 0
var g_pass6_entity_names: i64 = 0
var g_pass6_entity_nodes: i64 = 0
var g_pass6_entity_buckets: i64 = 0
var g_pass6_enum_buckets: i64 = 0
var g_pass6_func_names: i64 = 0
var g_pass6_func_nodes: i64 = 0
var g_pass6_func_canonical_names: i64 = 0
var g_pass6_func_buckets: i64 = 0
var g_pass6_func_canon_buckets: i64 = 0
var g_pass6_func_canon_by_node: i64 = 0
var g_pass6_ret_stmt_buckets: i64 = 0
var g_pass6_visiting_symbols: i64 = 0
var g_pass6_sym_types: i64 = 0
var g_pass6_scoped_var_names: i64 = 0
var g_pass6_scoped_var_types: i64 = 0
var g_pass6_scope_watermarks: i64 = 0
var g_pass6_current_entity_name: i64 = 0
var g_pass6_current_func_name: i64 = 0
var g_pass6_current_func_ret_type: i64 = 0
var g_pass6_var_names: i64 = 0
var g_pass6_var_types: i64 = 0
var g_pass6_assigned_vars: i64 = 0
var g_pass6_quantized_tensor_type: i64 = fat_str_new("QuantizedTensor") as i64
var g_pass6_cur_module: string = ""
var g_pass6_current_generic_params: string = ""
var g_pass6_fn_ret_cache_keys: i64 = 0
var g_pass6_fn_ret_cache_vals: i64 = 0
var g_pass6_visiting_funcs: i64 = 0
var g_pass6_visiting_local_exprs: i64 = 0

# TypeCompatKind is imported from virc.semantic.typecheck.compatibility

func is_user_module(name: &string) -> int:
    let s = name as int
    if s == 0 do out 0 end
    let slen = native_read_i64(s, 8) as int
    if slen == 0 do out 0 end
    let cstr_ptr = native_read_i64(s, 0) as int
    if cstr_ptr == 0 do out 0 end
    if slen == 4 and native_read_u8(cstr_ptr, 0) == 114 and native_read_u8(cstr_ptr, 1) == 111 and native_read_u8(cstr_ptr, 2) == 111 and native_read_u8(cstr_ptr, 3) == 116 do
        out 0
    end
    if slen >= 4 and native_read_u8(cstr_ptr, 0) == 118 and native_read_u8(cstr_ptr, 1) == 105 and native_read_u8(cstr_ptr, 2) == 114 and native_read_u8(cstr_ptr, 3) == 46 do
        out 0
    end
    out 1
end.

func pass6_hash_name(name: &string) -> int:
    out typecheck_hash_name(name)
end.

func pass6_global_map_new():
    buckets = vec_new_rt()
    var bi = 0
    when bi < PASS6_BUCKETS loop
        buckets = vec_push_rt(buckets, vec_new_rt())
        bi = bi + 1
    end
    out buckets
end.

func pass6_get_short_name(name: &string) -> string:
    out typecheck_get_short_name(name)
end.

func pass6_index_global(name: &string, sym_id: int):
    if fat_str_len(name) == 0 do
        out 0
    end
    if g_pass6_global_buckets == 0 do
        g_pass6_global_buckets = pass6_global_map_new()
    end
    bid = pass6_hash_name(name)
    bucket = vec_get_rt(g_pass6_global_buckets, bid)
    bucket = vec_push_rt(bucket, sym_id)
    vec_set_rt(g_pass6_global_buckets, bid, bucket)

    let short_name = pass6_get_short_name(name)
    if fat_str_len(short_name) > 0 do
        if g_pass6_suffix_buckets == 0 do
            g_pass6_suffix_buckets = pass6_global_map_new()
        end
        let sbid = pass6_hash_name(short_name)
        var sbucket = vec_get_rt(g_pass6_suffix_buckets, sbid)
        sbucket = vec_push_rt(sbucket, sym_id)
        vec_set_rt(g_pass6_suffix_buckets, sbid, sbucket)
    end
    out 0
end.

func pass6_scope_buckets_new():
    buckets = vec_new_rt()
    var bi = 0
    when bi < PASS6_SCOPE_BUCKETS_COUNT loop
        buckets = vec_push_rt(buckets, vec_new_rt())
        bi = bi + 1
    end
    out buckets
end.

func pass6_index_scope_symbol(scope_id: int, name: &string, sym_id: int):
    if fat_str_len(name) == 0 do out 0 end
    if g_pass6_scope_buckets == 0 do
        g_pass6_scope_buckets = pass6_scope_buckets_new()
    end
    var h = (scope_id * 37 + pass6_hash_name(name)) and 1023
    if h < 0 do h = 0 - h end
    h = h and 1023
    var bucket = vec_get_rt(g_pass6_scope_buckets, h)
    bucket = vec_push_rt(bucket, sym_id)
    vec_set_rt(g_pass6_scope_buckets, h, bucket)
    out 0
end.

func pass6_lookup_scope_indexed(ref symbols: SymbolTable, scope_id: int, name: &string) -> int:
    if scope_id <= 0 or g_pass6_scope_buckets == 0 do out -1 end
    var h = (scope_id * 37 + pass6_hash_name(name)) and 1023
    if h < 0 do h = 0 - h end
    h = h and 1023
    let bucket = vec_get_rt(g_pass6_scope_buckets, h)
    let count = vec_len_rt(bucket)
    if count == 0 do out -1 end
    let syms_vec = native_read_i64(symbols as i64, 0)
    var i = 0
    when i < count loop
        let sym_id = vec_get_rt(bucket, i) as int
        let sym = vec_get_rt(syms_vec, sym_id)
        if (sym as i64) != 0 do
            if sym.scope_id == scope_id do
                let sym_name_ptr = native_read_i64(sym as i64, 8)
                if sym_name_ptr != 0 do
                    if fat_str_eq(sym_name_ptr as string, name) == 1 do
                        out sym_id
                    end
                end
            end
        end
        i = i + 1
    end
    out -1
end.

func pass6_rebuild_index(ref symbols: SymbolTable, ref scopes: ScopeTree):
    g_pass6_global_buckets = pass6_global_map_new()
    g_pass6_suffix_buckets = pass6_global_map_new()
    g_pass6_scope_buckets = pass6_scope_buckets_new()
    scopes_vec = native_read_i64(scopes as i64, 0)
    syms_vec = native_read_i64(symbols as i64, 0)
    let n_scopes = vec_len_rt(scopes_vec)
    var s = 0
    when s < n_scopes loop
        let scope_node = vec_get_rt(scopes_vec, s)
        let sym_list = native_read_i64(scope_node as i64, 16)
        let count = vec_len_rt(sym_list)
        var i = 0
        when i < count loop
            let sym_id = vec_get_rt(sym_list, i) as int
            let sym = vec_get_rt(syms_vec, sym_id)
            let sym_name_ptr = native_read_i64(sym as i64, 8)
            if sym_name_ptr != 0 do
                let sym_name = sym_name_ptr as string
                if s == 0 do
                    pass6_index_global(sym_name, sym_id)
                else
                    pass6_index_scope_symbol(s, sym_name, sym_id)
                end
            end
            i = i + 1
        end
        s = s + 1
    end
    out 0
end.

func pass6_typecheck(ref symbols: SymbolTable, ref scopes: ScopeTree, diag: &DiagnosticEngine, node: &AstNode):
    g_pass6_symbols = symbols as i64
    g_pass6_scopes = scopes as i64
    g_pass6_diag = diag as i64
    pass6_rebuild_index(symbols, scopes)
    g_pass6_extern_names = vec_new_rt()
    g_pass6_extern_nodes = vec_new_rt()
    g_pass6_extern_buckets = pass6_global_map_new()
    g_pass6_entity_names = vec_new_rt()
    g_pass6_entity_nodes = vec_new_rt()
    g_pass6_entity_buckets = pass6_global_map_new()
    g_pass6_enum_buckets = pass6_global_map_new()
    g_pass6_func_names = vec_new_rt()
    g_pass6_func_nodes = vec_new_rt()
    g_pass6_func_canonical_names = vec_new_rt()
    g_pass6_func_buckets = pass6_global_map_new()
    g_pass6_func_canon_buckets = pass6_global_map_new()
    g_pass6_func_canon_by_node = pass6_global_map_new()
    g_pass6_ret_stmt_buckets = pass6_global_map_new()
    g_pass6_visiting_symbols = vec_new_rt()
    g_pass6_fn_ret_cache_keys = vec_new_rt()
    g_pass6_fn_ret_cache_vals = vec_new_rt()
    g_pass6_visiting_funcs = vec_new_rt()
    g_pass6_visiting_local_exprs = vec_new_rt()
    g_pass6_sym_types = vec_new_rt()
    g_pass6_scoped_var_names = vec_new_rt()
    g_pass6_scoped_var_types = vec_new_rt()
    g_pass6_scope_watermarks = vec_new_rt()
    g_pass6_var_names = vec_new_rt()
    g_pass6_var_types = vec_new_rt()
    g_pass6_current_entity_name = 0
    g_pass6_ai_mode = 0
    g_pass6_infer_values = vec_new_rt()
    g_pass6_train_values = vec_new_rt()
    g_pass6_assigned_vars = vec_new_rt()
    pass6_collect_externs(node)
    pass6_collect_entities(node)
    pass6_collect_free_functions(node)
    pass6_walk(symbols, scopes, diag, node)
end.

func pass6_collect_free_functions(node: &AstNode):
    g_pass6_func_buckets = pass6_global_map_new()
    g_pass6_func_canon_buckets = pass6_global_map_new()
    g_pass6_func_canon_by_node = pass6_global_map_new()
    var cur_mod = fat_str_new("")
    let n_children = vec_len_rt(node.children)
    var i = 0
    when i < n_children loop
        let candidate = vec_get_rt(node.children, i)
        if candidate.node_type == AstType.ModuleStmt and fat_str_len(candidate.name) > 0 do
            cur_mod = candidate.name
        end
        var fn_c = candidate
        if (fn_c.node_type == AstType.BindAttr or fn_c.node_type == AstType.ExposeAttr) and vec_len_rt(fn_c.children) > 0 do
            fn_c = vec_get_rt(fn_c.children, 0)
        end
        if fn_c.node_type == AstType.FuncDef and fat_str_len(fn_c.name) > 0 do
            var canonical_name = fn_c.name
            if is_user_module(cur_mod) == 1 and fat_cstr_eq(fn_c.name, "main") == 0 do
                canonical_name = fat_str_concat(fat_str_concat(cur_mod, fat_str_new(".")), fn_c.name)
            end
            let k = vec_len_rt(g_pass6_func_nodes)
            g_pass6_func_names = vec_push_rt(g_pass6_func_names, fn_c.name)
            g_pass6_func_nodes = vec_push_rt(g_pass6_func_nodes, fn_c)
            g_pass6_func_canonical_names = vec_push_rt(g_pass6_func_canonical_names, canonical_name)

            let fbid = pass6_hash_name(fn_c.name)
            var fbucket = vec_get_rt(g_pass6_func_buckets, fbid)
            fbucket = vec_push_rt(fbucket, k)
            vec_set_rt(g_pass6_func_buckets, fbid, fbucket)

            let cbid = pass6_hash_name(canonical_name)
            var cbucket = vec_get_rt(g_pass6_func_canon_buckets, cbid)
            cbucket = vec_push_rt(cbucket, k)
            vec_set_rt(g_pass6_func_canon_buckets, cbid, cbucket)

            let nbid = (((fn_c as i64) shr 4) and 255) as int
            var nbucket = vec_get_rt(g_pass6_func_canon_by_node, nbid)
            nbucket = vec_push_rt(nbucket, k)
            vec_set_rt(g_pass6_func_canon_by_node, nbid, nbucket)
        end
        i = i + 1
    end
    out 0
end.

func pass6_find_free_function(name: &string):
    out typecheck_find_free_function_raw(g_pass6_func_buckets, g_pass6_func_names, g_pass6_func_nodes, name)
end.

func pass6_find_canonical_identity(fn_node: &AstNode):
    if (fn_node as i64) == 0 do out fat_str_new("") end
    if g_pass6_func_canon_by_node != 0 do
        let bid = (((fn_node as i64) shr 4) and 255) as int
        let bucket = vec_get_rt(g_pass6_func_canon_by_node, bid)
        let count = vec_len_rt(bucket)
        var i = 0
        when i < count loop
            let k = vec_get_rt(bucket, i)
            if (vec_get_rt(g_pass6_func_nodes, k) as i64) == (fn_node as i64) do
                out vec_get_rt(g_pass6_func_canonical_names, k) as string
            end
            i = i + 1
        end
    end
    out fn_node.name
end.

func pass6_find_func_by_canonical_identity(id: &string):
    out typecheck_find_func_by_canonical_identity_raw(g_pass6_func_canon_buckets, g_pass6_func_canonical_names, g_pass6_func_nodes, id)
end.

func pass6_collect_externs(node: &AstNode):
    if node as i64 == 0 do out 0 end
    if node.node_type == AstType.ExternFunc and fat_str_len(node.name) > 0 do
        g_pass6_extern_names = vec_push_rt(g_pass6_extern_names, node.name as i64)
        g_pass6_extern_nodes = vec_push_rt(g_pass6_extern_nodes, node as i64)
        if g_pass6_extern_buckets == 0 do
            g_pass6_extern_buckets = pass6_global_map_new()
        end
        let bid = pass6_hash_name(node.name)
        var bucket = vec_get_rt(g_pass6_extern_buckets, bid)
        bucket = vec_push_rt(bucket, node as i64)
        vec_set_rt(g_pass6_extern_buckets, bid, bucket)
        out 0
    end
    child_count = vec_len_rt(node.children)
    var i = 0
    when i < child_count loop
        pass6_collect_externs(vec_get_rt(node.children, i))
        i = i + 1
    end
    out 0
end.

func pass6_find_extern(name: &string):
    let ext = typecheck_find_extern_node(g_pass6_extern_buckets, name)
    out ext as i64
end.


func pass6_symbol_at(ref symbols: SymbolTable, id: int):
    # Avoid ambiguous nested entity-field lowering in native self-host code.
    if (symbols as i64) == 0 or id < 0 do out 0 end
    syms_vec = native_read_i64(symbols as i64, 0)
    if syms_vec == 0 do out 0 end
    if id >= vec_len_rt(syms_vec) do out 0 end
    out vec_get_rt(syms_vec, id)
end.


# Evaluate integer constant syntax used where semantics depend on sign.  Const
# identifiers are followed through their declaration AST; mutable variables are
# deliberately not folded because their runtime value may change.
func pass6_eval_const_int(ref symbols: SymbolTable, ref scopes: ScopeTree, node: &AstNode, depth: int):
    if node as i64 == 0 or depth > 32 do out (0, 0) end
    if node.node_type == AstType.LiteralInt do out (1, node.int_val) end
    if node.node_type == AstType.Identifier do
        found = pass6_lookup_chain(symbols, scopes, scope_current_id(scopes), node.name)
        if found != -1 do
            sym = pass6_symbol_at(symbols, found)
            if not sym.is_mutable and sym.ast_id != 0 do
                decl = sym.ast_id as AstNode
                if decl.node_type == AstType.ConstDecl and vec_len_rt(decl.children) > 0 do
                    out pass6_eval_const_int(symbols, scopes, vec_get_rt(decl.children, 0), depth + 1)
                end
            end
        end
        out (0, 0)
    end
    if node.node_type == AstType.BinOp and vec_len_rt(node.children) >= 2 do
        var (lok, lv) = pass6_eval_const_int(symbols, scopes, vec_get_rt(node.children, 0), depth + 1)
        var (rok, rv) = pass6_eval_const_int(symbols, scopes, vec_get_rt(node.children, 1), depth + 1)
        if lok == 0 or rok == 0 do out (0, 0) end
        var (eval_ok, eval_val) = typecheck_eval_const_binop(node.op as int, lv, rv)
        out (eval_ok, eval_val)
    end
    out (0, 0)
end.

func pass6_call_returns_first_arg(name: i64):
    out typecheck_call_returns_first_arg(name)
end.

func pass6_find_return_stmt_uncached(node: &AstNode) -> AstNode:
    out typecheck_find_return_stmt_uncached(node)
end.

func pass6_find_return_stmt(node: &AstNode) -> AstNode:
    if (node as i64) == 0 do out 0 as AstNode end
    if g_pass6_ret_stmt_buckets == 0 do
        g_pass6_ret_stmt_buckets = pass6_global_map_new()
    end
    let bid = (((node as i64) shr 4) and 255) as int
    let bucket = vec_get_rt(g_pass6_ret_stmt_buckets, bid)
    let count = vec_len_rt(bucket)
    var i = 0
    when i < count loop
        let entry_node = vec_get_rt(bucket, i) as i64
        if entry_node == (node as i64) do
            out vec_get_rt(bucket, i + 1) as AstNode
        end
        i = i + 2
    end
    let ret_s = pass6_find_return_stmt_uncached(node)
    var new_bucket = bucket
    new_bucket = vec_push_rt(new_bucket, node as i64)
    new_bucket = vec_push_rt(new_bucket, ret_s as i64)
    vec_set_rt(g_pass6_ret_stmt_buckets, bid, new_bucket)
    out ret_s
end.

func pass6_find_param_entity(fn_node: &AstNode, param_name: &string):
    out typecheck_find_param_type_name(fn_node, param_name)
end.

func pass6_find_local_decl_in_node(node: &AstNode, name: int) -> AstNode:
    out typecheck_find_local_decl_in_node(node, name)
end.

func pass6_infer_unannotated_fn_return(ref symbols: SymbolTable, fn_node: &AstNode) -> TypeKind:
    if (fn_node as i64) == 0 do out TypeKind.Void end
    let fn_key = fn_node as i64
    if g_pass6_fn_ret_cache_keys != 0 do
        var ci = 0
        let n_c = vec_len_rt(g_pass6_fn_ret_cache_keys)
        when ci < n_c loop
            if vec_get_rt(g_pass6_fn_ret_cache_keys, ci) == fn_key do
                out vec_get_rt(g_pass6_fn_ret_cache_vals, ci) as TypeKind
            end
            ci = ci + 1
        end
    end
    if g_pass6_visiting_funcs != 0 do
        var vi = 0
        let n_v = vec_len_rt(g_pass6_visiting_funcs)
        when vi < n_v loop
            if vec_get_rt(g_pass6_visiting_funcs, vi) == fn_key do
                out TypeKind.Void
            end
            vi = vi + 1
        end
    end
    g_pass6_visiting_funcs = vec_push_rt(g_pass6_visiting_funcs, fn_key)

    var res_kind = TypeKind.Void
    let ret_stmt = pass6_find_return_stmt(fn_node)
    if (ret_stmt as i64) != 0 do
        if vec_len_rt(ret_stmt.children) > 0 do
            let ret_expr = vec_get_rt(ret_stmt.children, 0) as AstNode
            res_kind = pass6_infer_local_expr(symbols, fn_node, ret_expr)
        end
    end

    let v_len = vec_len_rt(g_pass6_visiting_funcs)
    if g_pass6_visiting_funcs != 0 and v_len > 0 do
        native_write_i64(g_pass6_visiting_funcs - 8, 0, v_len - 1)
    end

    if g_pass6_fn_ret_cache_keys != 0 do
        g_pass6_fn_ret_cache_keys = vec_push_rt(g_pass6_fn_ret_cache_keys, fn_key)
        g_pass6_fn_ret_cache_vals = vec_push_rt(g_pass6_fn_ret_cache_vals, res_kind as i64)
    end
    out res_kind
end.

func pass6_infer_local_expr(ref symbols: SymbolTable, fn_node: &AstNode, expr: &AstNode) -> TypeKind:
    if (expr as i64) == 0 do out TypeKind.Void end
    let expr_key = expr as i64
    if g_pass6_visiting_local_exprs != 0 do
        var vi = 0
        let n_v = vec_len_rt(g_pass6_visiting_local_exprs)
        when vi < n_v loop
            if vec_get_rt(g_pass6_visiting_local_exprs, vi) == expr_key do
                out TypeKind.Void
            end
            vi = vi + 1
        end
    end
    g_pass6_visiting_local_exprs = vec_push_rt(g_pass6_visiting_local_exprs, expr_key)
    let res = pass6_infer_local_expr_inner(symbols, fn_node, expr)
    let v_len = vec_len_rt(g_pass6_visiting_local_exprs)
    if g_pass6_visiting_local_exprs != 0 and v_len > 0 do
        native_write_i64(g_pass6_visiting_local_exprs - 8, 0, v_len - 1)
    end
    out res
end.

func pass6_infer_local_expr_inner(ref symbols: SymbolTable, fn_node: &AstNode, expr: &AstNode) -> TypeKind:
    if (expr as i64) == 0 do out TypeKind.Void end
    let lit_k = typecheck_infer_literal(expr)
    if lit_k != TypeKind.Void do out lit_k end
    if expr.node_type == AstType.BinOp do
        let n_ch = vec_len_rt(expr.children)
        if n_ch >= 2 do
            if fat_cstr_eq(expr.name, "==") == 1 or fat_cstr_eq(expr.name, "!=") == 1 or fat_cstr_eq(expr.name, "<") == 1 or fat_cstr_eq(expr.name, "<=") == 1 or fat_cstr_eq(expr.name, ">") == 1 or fat_cstr_eq(expr.name, ">=") == 1 or fat_cstr_eq(expr.name, "and") == 1 or fat_cstr_eq(expr.name, "or") == 1 do
                out TypeKind.Bool
            end
            let l_expr = vec_get_rt(expr.children, 0) as AstNode
            let r_expr = vec_get_rt(expr.children, 1) as AstNode
            let lk = pass6_infer_local_expr(symbols, fn_node, l_expr)
            let rk = pass6_infer_local_expr(symbols, fn_node, r_expr)
            if lk == TypeKind.Float or rk == TypeKind.Float do out TypeKind.Float end
            if lk == TypeKind.Int or rk == TypeKind.Int do out TypeKind.Int end
            if lk != TypeKind.Void do out lk end
            if rk != TypeKind.Void do out rk end
        end
        out TypeKind.Void
    end
    if expr.node_type == AstType.UnaryNot do out TypeKind.Bool end
    if expr.node_type == AstType.UnaryMinus do out TypeKind.Int end
    if expr.node_type == AstType.Identifier do
        let n_fn_ch = vec_len_rt(fn_node.children)
        var pi = 0
        var is_param = false
        var param_kind = TypeKind.Void
        when pi < n_fn_ch loop
            let p_ch = vec_get_rt(fn_node.children, pi) as AstNode
            if p_ch.node_type != AstType.Block do
                if fat_str_eq(p_ch.name, expr.name) == 1 do
                    is_param = true
                    if fat_str_len(p_ch.name2) > 0 do
                        let pk = pass6_resolve_ffi_type(p_ch.name2)
                        if pk != TypeKind.Void do param_kind = pk end
                    end
                end
            end
            pi = pi + 1
        end
        if is_param do
            if param_kind != TypeKind.Void do out param_kind end
            out TypeKind.Int
        end
        let decl = pass6_find_local_decl_in_node(fn_node, expr.name)
        if (decl as i64) != 0 do
            if fat_str_len(decl.name2) > 0 do
                let dk = pass6_resolve_ffi_type(decl.name2)
                if dk != TypeKind.Void do out dk end
            end
            if vec_len_rt(decl.children) > 0 do
                let init_expr = vec_get_rt(decl.children, 0) as AstNode
                out pass6_infer_local_expr(symbols, fn_node, init_expr)
            end
        end
        let gid = pass6_lookup_global(symbols, expr.name)
        if gid != -1 do
            let gsym = pass6_symbol_at(symbols, gid)
            if gsym.type_id != 0 do
                out gsym.type_id as TypeKind
            end
        end
        out TypeKind.Void
    end
    if expr.node_type == AstType.CastExpr do
        let c_k = pass6_resolve_ffi_type(expr.name)
        if c_k != TypeKind.Void do out c_k end
        let c_base = pass6_extract_base_name(expr.name)
        let c_sid = pass6_lookup_global(symbols, c_base)
        if c_sid != -1 do
            let c_sym = pass6_symbol_at(symbols, c_sid)
            if c_sym.kind == SymbolKind.Entity do out TypeKind.Entity end
            if c_sym.kind == SymbolKind.Enum do out TypeKind.Enum end
        end
        if pass6_is_array_type_str(expr.name) do
            out TypeKind.Array
        end
        out TypeKind.Int
    end
    if expr.node_type == AstType.Call do
        let builtin_ret = typecheck_infer_builtin_call_return(expr.name)
        if builtin_ret != TypeKind.Void do
            out builtin_ret
        end
        let c_ast = pass6_find_free_function(expr.name)
        if (c_ast as i64) != 0 do
            if fat_str_len(c_ast.name2) > 0 do
                let c_ret_k = pass6_resolve_ffi_type(c_ast.name2)
                if c_ret_k != TypeKind.Void do out c_ret_k end
            else
                out pass6_infer_unannotated_fn_return(symbols, c_ast)
            end
        else
            let ext_p = pass6_find_extern(expr.name)
            if ext_p != 0 do
                let ext_ast = ext_p as AstNode
                if fat_str_len(ext_ast.name2) > 0 do
                    let ext_k = pass6_resolve_ffi_type(ext_ast.name2)
                    if ext_k != TypeKind.Void do out ext_k end
                end
            end
        end
    end
    out TypeKind.Void
end.

func pass6_infer_call_return(ref symbols: SymbolTable, ref scopes: ScopeTree, node: &AstNode):
    if node.node_type != AstType.Call and node.node_type != AstType.MethodCall do
        out TypeKind.Void
    end
    found = pass6_lookup_chain(symbols, scopes, scope_current_id(scopes), node.name)
    if found != -1 do
        sym = pass6_symbol_at(symbols, found)
        if (sym as i64) != 0 do
            if sym.return_type != 0 and (sym.return_type as TypeKind) != TypeKind.Entity do
                out sym.return_type as TypeKind
            end
        end
    end
    if pass6_call_returns_first_arg(node.name as i64) == 1 do
        child_count = vec_len_rt(node.children)
        if child_count > 0 do
            arg0 = vec_get_rt(node.children, 0)
            arg0_ty = pass6_infer_type(symbols, scopes, arg0)
            if arg0_ty != TypeKind.Void do
                out arg0_ty
            end
        end
    end
    if node.node_type == AstType.MethodCall and vec_len_rt(node.children) > 0 do
        let m_recv = vec_get_rt(node.children, 0) as AstNode
        let m_recv_ent = pass6_get_receiver_entity_name(symbols, scopes, m_recv)
        if fat_str_len(m_recv_ent) > 0 do
            let m_ent_ast = pass6_find_entity_ast(symbols, scopes, m_recv_ent)
            if (m_ent_ast as i64) != 0 do
                let n_ech = vec_len_rt(m_ent_ast.children)
                var mi = 0
                when mi < n_ech loop
                    let m_child = vec_get_rt(m_ent_ast.children, mi) as AstNode
                    if m_child.node_type == AstType.FuncDef and fat_str_eq(m_child.name, node.name) == 1 do
                        if fat_str_len(m_child.name2) > 0 do
                            let m_ret_k = pass6_resolve_ffi_type(m_child.name2)
                            if m_ret_k != TypeKind.Void do out m_ret_k end
                            if (pass6_find_entity_ast(symbols, scopes, pass6_extract_base_name(m_child.name2)) as i64) != 0 do
                                out TypeKind.Entity
                            end
                        end
                        mi = n_ech
                    else
                        mi = mi + 1
                    end
                end
            end
        end
        if m_recv.node_type == AstType.Identifier do
            let mod_mname = fat_str_concat(fat_str_concat(m_recv.name, fat_str_new(".")), node.name)
            let mod_fn = pass6_find_func_by_canonical_identity(mod_mname)
            if (mod_fn as i64) != 0 do
                if fat_str_len(mod_fn.name2) > 0 do
                    let mod_ret_k = pass6_resolve_ffi_type(mod_fn.name2)
                    if mod_ret_k != TypeKind.Void do out mod_ret_k end
                    if (pass6_find_entity_ast(symbols, scopes, pass6_extract_base_name(mod_fn.name2)) as i64) != 0 do
                        out TypeKind.Entity
                    end
                end
            end
        end
    end
    call_fn = pass6_find_free_function(node.name)
    if (call_fn as i64) == 0 do
        if is_user_module(g_pass6_cur_module) == 1 do
            let mod_call_name = fat_str_concat(fat_str_concat(g_pass6_cur_module, fat_str_new(".")), node.name)
            call_fn = pass6_find_func_by_canonical_identity(mod_call_name)
        end
    end
    if (call_fn as i64) == 0 do
        let ext_p = pass6_find_extern(node.name)
        if ext_p != 0 do
            call_fn = ext_p as AstNode
        end
    end
    let builtin_ret = typecheck_infer_builtin_call_return(node.name)
    if builtin_ret != TypeKind.Void do
        out builtin_ret
    end
    if (call_fn as i64) != 0 do
        if fat_str_len(call_fn.name2) > 0 do
            ret_k = pass6_resolve_ffi_type(call_fn.name2)
            if ret_k != TypeKind.Void do
                out ret_k
            end
            let ent = pass6_find_entity_ast(symbols, scopes, pass6_extract_base_name(call_fn.name2))
            if (ent as i64) != 0 do
                out TypeKind.Entity
            end
            if call_fn.builtin_id != 0 do
                if fat_str_len(node.name2) > 0 do
                    let gen_ret_k = pass6_resolve_ffi_type(node.name2)
                    if gen_ret_k != TypeKind.Void do
                        out gen_ret_k
                    end
                end
            end
        end
        if fat_str_len(call_fn.name2) == 0 do
            if fat_cstr_eq(node.name, "fat_str_new") == 1 or fat_cstr_eq(node.name, "fat_str_concat") == 1 or fat_cstr_eq(node.name, "fat_char_to_str") == 1 or fat_cstr_eq(node.name, "str_from_cstr") == 1 or fat_cstr_eq(node.name, "str_concat") == 1 or fat_cstr_eq(node.name, "str_slice") == 1 or fat_cstr_eq(node.name, "fat_str_slice") == 1 or fat_cstr_eq(node.name, "rt_strcat") == 1 or fat_cstr_eq(node.name, "rt_itoa") == 1 or fat_cstr_eq(node.name, "str_trim") == 1 or fat_cstr_eq(node.name, "str_to_lower") == 1 or fat_cstr_eq(node.name, "str_to_upper") == 1 or fat_cstr_eq(node.name, "str_repeat") == 1 or fat_cstr_eq(node.name, "str_replace") == 1 do
                out TypeKind.String
            end
            let inferred_ret = pass6_infer_unannotated_fn_return(symbols, call_fn)
            if inferred_ret != TypeKind.Void do
                out inferred_ret
            end
            out TypeKind.Void
        end
    end
    out TypeKind.Void
end.

func pass6_infer_type(ref symbols: SymbolTable, ref scopes: ScopeTree, node: &AstNode):
    let lit_k = typecheck_infer_literal(node)
    if lit_k != TypeKind.Void do
        out lit_k
    end
    if node.node_type == AstType.Identifier do
        found = pass6_lookup_chain(symbols, scopes, scope_current_id(scopes), node.name)
        if found != -1 do
            sym = pass6_symbol_at(symbols, found)
            if (sym as i64) != 0 do
                if sym.type_id != 0 do
                    out sym.type_id as TypeKind
                end
                if sym.ast_id != 0 do
                    decl = sym.ast_id as AstNode
                    if (decl.node_type == AstType.VarDecl or decl.node_type == AstType.ConstDecl) and vec_len_rt(decl.children) > 0 do
                        var vi = 0
                        var n_vis = vec_len_rt(g_pass6_visiting_symbols)
                        var in_cycle = false
                        when vi < n_vis loop
                            if vec_get_rt(g_pass6_visiting_symbols, vi) == (found as i64) do
                                in_cycle = true
                                vi = n_vis
                            else
                                vi = vi + 1
                            end
                        end
                        if in_cycle do
                            if g_pass6_diag != 0 do
                                report_error(g_pass6_diag as DiagnosticEngine, 3097, decl.line, 0)
                            end
                            out TypeKind.Void
                        end
                        g_pass6_visiting_symbols = vec_push_rt(g_pass6_visiting_symbols, found as i64)
                        init_node = vec_get_rt(decl.children, 0)
                        inferred_init = pass6_infer_type(symbols, scopes, init_node)
                        let v_len = vec_len_rt(g_pass6_visiting_symbols)
                        if v_len > 0 do
                            native_write_i64(g_pass6_visiting_symbols - 8, 0, v_len - 1)
                        end
                        if inferred_init != TypeKind.Void do
                            native_write_i64(sym as i64, 16, inferred_init as i64)
                            out inferred_init
                        end
                    end
                end
                out sym.type_id as TypeKind
            end
        end
        out TypeKind.Void
    end
    if node.node_type == AstType.BinOp do
        child_count = vec_len_rt(node.children)
        if child_count >= 2 do
            left = vec_get_rt(node.children, 0)
            right = vec_get_rt(node.children, 1)
            lt = pass6_infer_type(symbols, scopes, left)
            rt_type = pass6_infer_type(symbols, scopes, right)
            out typecheck_infer_binop(lt, rt_type, node.op as int, node.int_val)
        end
    end
    if node.node_type == AstType.Compare do
        out TypeKind.Bool
    end
    if node.node_type == AstType.EnumConstruct do
        out TypeKind.Enum
    end
    if node.node_type == AstType.Call and fat_cstr_eq(node.name, "flux") do
        out TypeKind.Flux
    end
    if node.node_type == AstType.SwizzleExpr do
        out TypeKind.Flux
    end
    if node.node_type == AstType.Call or node.node_type == AstType.MethodCall do
        out pass6_infer_call_return(symbols, scopes, node)
    end
    if node.node_type == AstType.BuiltinCall do
        if node.builtin_id == 11 or node.builtin_id == 19 do
            out TypeKind.String
        end
        if node.builtin_id == 12 do
            out TypeKind.Bool
        end
        if fat_cstr_eq(node.name, "str_concat") == 1 or fat_cstr_eq(node.name, "str_cat") == 1 or fat_cstr_eq(node.name, "fat_str_concat") == 1 or fat_cstr_eq(node.name, "fat_str_new") == 1 or fat_cstr_eq(node.name, "str_slice") == 1 or fat_cstr_eq(node.name, "fat_str_slice") == 1 or fat_cstr_eq(node.name, "rt_strcat") == 1 or fat_cstr_eq(node.name, "rt_itoa") == 1 or fat_cstr_eq(node.name, "str_trim") == 1 or fat_cstr_eq(node.name, "str_to_lower") == 1 or fat_cstr_eq(node.name, "str_to_upper") == 1 or fat_cstr_eq(node.name, "str_repeat") == 1 or fat_cstr_eq(node.name, "str_replace") == 1 do
            out TypeKind.String
        end
        if fat_cstr_eq(node.name, "str_eq") == 1 or fat_cstr_eq(node.name, "fat_str_eq") == 1 or fat_cstr_eq(node.name, "str_contains") == 1 or fat_cstr_eq(node.name, "str_starts_with") == 1 or fat_cstr_eq(node.name, "str_ends_with") == 1 or fat_cstr_eq(node.name, "dict_has_key") == 1 do
            out TypeKind.Bool
        end
        out TypeKind.Int
    end
    if node.node_type == AstType.QuantizeExpr do
        out TypeKind.QuantizedTensor
    end
    if node.node_type == AstType.PrecompBlock do
        if vec_len_rt(node.children) > 0 do
            out pass6_infer_type(symbols, scopes, vec_get_rt(node.children, 0) as AstNode)
        end
        out TypeKind.Int
    end
    if node.node_type == AstType.CastExpr do
        let cty = pass6_resolve_ffi_type(node.name)
        if cty != TypeKind.Void do out cty end
        let c_ent = pass6_find_entity_ast(symbols, scopes, pass6_extract_base_name(node.name))
        if (c_ent as i64) != 0 do out TypeKind.Entity end
        let c_enum = pass6_find_enum_ast(symbols, scopes, node.name)
        if (c_enum as i64) != 0 do out TypeKind.Enum end
        out TypeKind.Void
    end
    if node.node_type == AstType.Assign do
        if vec_len_rt(node.children) > 0 do
            out pass6_infer_type(symbols, scopes, vec_get_rt(node.children, 0))
        end
        out TypeKind.Void
    end
    if node.node_type == AstType.IndexAccess do
        base_id = pass6_lookup_chain(symbols, scopes, scope_current_id(scopes), node.name)
        if base_id != -1 do
            base_sym = pass6_symbol_at(symbols, base_id)
            if base_sym.ast_id != 0 do
                base_decl = base_sym.ast_id as AstNode
                if fat_str_len(base_decl.name2) > 0 do
                    let b_elem_str = pass6_extract_generic_or_array_elem(base_decl.name2)
                    if fat_str_len(b_elem_str) > 0 do
                        let b_elem_k = pass6_resolve_ffi_type(b_elem_str)
                        if b_elem_k != TypeKind.Void do
                            out b_elem_k
                        end
                        let b_ent = pass6_find_entity_ast(symbols, scopes, pass6_extract_base_name(b_elem_str))
                        if (b_ent as i64) != 0 do
                            out TypeKind.Entity
                        end
                    end
                end
                if vec_len_rt(base_decl.children) > 0 do
                    base_init = vec_get_rt(base_decl.children, 0)
                    if base_init.node_type == AstType.ArrayLiteral and vec_len_rt(base_init.children) > 0 do
                        out pass6_infer_type(symbols, scopes, vec_get_rt(base_init.children, 0))
                    end
                end
            end
        end
        out TypeKind.Void
    end
    if node.node_type == AstType.FieldAccess do
        field_type_name = pass6_get_receiver_entity_name(symbols, scopes, node)
        if fat_str_len(field_type_name) > 0 do
            field_kind = pass6_resolve_ffi_type(field_type_name)
            if field_kind != TypeKind.Void do out field_kind end
            let f_ent = pass6_find_entity_ast(symbols, scopes, pass6_extract_base_name(field_type_name))
            if (f_ent as i64) != 0 do out TypeKind.Entity end
        end
        out TypeKind.Void
    end
    if node.node_type == AstType.UnaryMinus do
        out TypeKind.Int
    end
    if node.node_type == AstType.UnaryNot do
        out TypeKind.Bool
    end
    out TypeKind.Void
end.

# Deep inference is intentionally interpolation-local. Applying entity field
# and method return inference to all assignments changes legacy self-host type
# compatibility; interpolation needs the precision only to select stringify.
func pass6_infer_interp_type(ref symbols: SymbolTable, ref scopes: ScopeTree, node: &AstNode):
    if node.node_type == AstType.Identifier do
        ident_id = pass6_lookup_chain(symbols, scopes, scope_current_id(scopes), node.name)
        if ident_id != -1 do
            ident_sym = pass6_symbol_at(symbols, ident_id)
            if ident_sym.ast_id != 0 do
                ident_decl = ident_sym.ast_id as AstNode
                explicit_kind = pass6_resolve_ffi_type(ident_decl.name2)
                if explicit_kind != TypeKind.Void do out explicit_kind end
                if (ident_decl.node_type == AstType.VarDecl or ident_decl.node_type == AstType.ConstDecl or ident_decl.node_type == AstType.AtomicVarDecl) and vec_len_rt(ident_decl.children) > 0 do
                    ident_init = vec_get_rt(ident_decl.children, 0)
                    if ident_init.node_type != AstType.Identifier or fat_str_eq(ident_init.name, node.name) == 0 do
                        out pass6_infer_interp_type(symbols, scopes, ident_init)
                    end
                end
            end
        end
        out pass6_infer_type(symbols, scopes, node)
    end
    if node.node_type == AstType.IndexAccess do
        base_id = pass6_lookup_chain(symbols, scopes, scope_current_id(scopes), node.name)
        if base_id != -1 do
            base_sym = pass6_symbol_at(symbols, base_id)
            if base_sym.ast_id != 0 do
                base_decl = base_sym.ast_id as AstNode
                if vec_len_rt(base_decl.children) > 0 do
                    base_init = vec_get_rt(base_decl.children, 0)
                    if base_init.node_type == AstType.ArrayLiteral and vec_len_rt(base_init.children) > 0 do
                        out pass6_infer_interp_type(symbols, scopes, vec_get_rt(base_init.children, 0))
                    end
                end
            end
        end
        # Preserve the existing integer-array default when element metadata is
        # unavailable (parameters, extern buffers, and dynamically built arrays).
        out TypeKind.Int
    end
    if node.node_type == AstType.FieldAccess do
        field_type_name = pass6_get_receiver_entity_name(symbols, scopes, node)
        field_kind = pass6_resolve_ffi_type(field_type_name)
        if field_kind != TypeKind.Void do out field_kind end
        if pass6_find_entity_ast(symbols, scopes, field_type_name) != 0 do out TypeKind.Entity end
        out TypeKind.Void
    end
    if node.node_type == AstType.MethodCall and fat_str_len(node.name2) > 0 do
        owner_ast = pass6_find_entity_ast(symbols, scopes, node.name2)
        if owner_ast != 0 do
            owner_children = vec_len_rt(owner_ast.children)
            var owner_i = 0
            when owner_i < owner_children loop
                owner_child = vec_get_rt(owner_ast.children, owner_i)
                if node.builtin_id == 201 and owner_child.node_type == AstType.FuncDef and fat_str_eq(owner_child.name, node.name) == 1 do
                    method_ret_kind = pass6_resolve_ffi_type(owner_child.name2)
                    if method_ret_kind != TypeKind.Void do out method_ret_kind end
                    if pass6_find_entity_ast(symbols, scopes, owner_child.name2) != 0 do out TypeKind.Entity end
                    out TypeKind.Void
                end
                if node.builtin_id == 202 and (owner_child.node_type == AstType.Identifier or owner_child.node_type == AstType.VarDecl) and fat_str_eq(owner_child.name, node.name) == 1 do
                    callable_ret_name = pass6_callable_return_type(owner_child.name2)
                    callable_ret_kind = pass6_resolve_ffi_type(callable_ret_name)
                    if callable_ret_kind != TypeKind.Void do out callable_ret_kind end
                    if pass6_find_entity_ast(symbols, scopes, callable_ret_name) != 0 do out TypeKind.Entity end
                    out TypeKind.Void
                end
                owner_i = owner_i + 1
            end
        end
    end
    out pass6_infer_type(symbols, scopes, node)
end.

func pass6_unwrap_type_name(name: &string) -> string:
    out typecheck_unwrap_type_name(name)
end.

func pass6_resolve_ffi_type(name: &string) -> TypeKind:
    out typecheck_resolve_ffi_type(name)
end.

func pass6_is_integer_like(k: i64) -> int:
    out typecheck_is_integer_like(k)
end.

func pass6_check_compatibility(declared: i64, actual: TypeKind) -> TypeCompatKind:
    out typecheck_check_compatibility(declared, actual)
end.

func pass6_types_compatible(declared: i64, actual: TypeKind) -> int:
    out typecheck_types_compatible(declared, actual)
end.

func pass6_ufcs_types_compatible(declared: i64, actual: TypeKind) -> int:
    out typecheck_ufcs_types_compatible(declared, actual)
end.

func pass6_param_types_compatible(declared: i64, actual: i64) -> int:
    out typecheck_param_types_compatible(declared, actual)
end.

func pass6_is_lowlevel_call_or_param(call_name: &string, param_name: &string):
    out typecheck_is_lowlevel_call_or_param(call_name, param_name)
end.

func pass6_call_arg_types_compatible(ref symbols: SymbolTable, ref scopes: ScopeTree, declared: i64, actual: TypeKind, arg: &AstNode, param_type_name: &string, param_name: &string, call_name: &string):
    let is_i64_ptr = fat_cstr_eq(param_type_name, "i64") == 1 or fat_cstr_eq(param_type_name, "u64") == 1 or fat_cstr_eq(param_type_name, "ptr") == 1 or fat_cstr_eq(param_type_name, "usize") == 1
    let is_lowlevel = pass6_is_lowlevel_call_or_param(call_name, param_name)

    if is_i64_ptr or is_lowlevel == 1 do
        if (declared == TypeKind.Int as i64 or declared == TypeKind.Pointer as i64) and (actual == TypeKind.Entity or actual == TypeKind.Pointer or actual == TypeKind.Ref or actual == TypeKind.MutRef or pass6_is_integer_like(actual as i64) == 1) do
            out 1
        end
        if declared == TypeKind.Entity as i64 and (actual == TypeKind.Pointer or pass6_is_integer_like(actual as i64) == 1) do
            out 1
        end
    end

    if declared == TypeKind.Int as i64 and actual == TypeKind.String do
        if is_i64_ptr or is_lowlevel == 1 do
            out 1
        end
        let is_user_int = fat_cstr_eq(param_type_name, "int") == 1 or fat_cstr_eq(param_type_name, "i32") == 1
        if is_user_int do
            if arg.node_type == AstType.LiteralStr or arg.node_type == AstType.FieldAccess or arg.node_type == AstType.MethodCall do
                out 0
            end
            if arg.node_type == AstType.Call do
                let c_fn = pass6_find_free_function(arg.name)
                if (c_fn as i64) != 0 do
                    if fat_cstr_eq(c_fn.name2, "string") == 1 do
                        out 0
                    end
                end
            end
        end
        out 1
    end

    if declared == TypeKind.String as i64 and actual == TypeKind.Int do
        if arg.node_type == AstType.LiteralInt do
            out 0
        end
        out 1
    end

    if pass6_param_types_compatible(declared, actual as i64) == 1 do out 1 end

    # In system/compiler modules (not user code), allow bool↔int for call args
    # to support the compiler's own internal helpers that use these interchangeably.
    # This must come BEFORE the identifier unannotated-local check which may early-exit.
    if is_user_module(g_pass6_cur_module) == 0 do
        if arg.node_type != AstType.LiteralBool and arg.node_type != AstType.LiteralInt do
            if (declared == TypeKind.Bool as i64 and pass6_is_integer_like(actual as i64) == 1) or (pass6_is_integer_like(declared) == 1 and actual == TypeKind.Bool) do
                out 1
            end
        end
    end

    # An unannotated local still carries the legacy integer storage kind.  Its
    # expression-derived bool value is valid for a bool parameter; only an
    # explicit annotation or literal makes this a strict int/bool mismatch.
    if arg.node_type == AstType.Identifier do
        let sid = pass6_lookup_chain(symbols, scopes, scope_current_id(scopes), arg.name)
        if sid != -1 do
            let sym = pass6_symbol_at(symbols, sid)
            if sym.ast_id == 0 do
                out pass6_types_compatible(declared, actual)
            else
                let decl = sym.ast_id as AstNode
                if fat_str_len(decl.name2) == 0 do out pass6_types_compatible(declared, actual) end
            end
        end
    end
    if arg.node_type == AstType.Call do
        let call_ast = pass6_find_free_function(arg.name)
        if (call_ast as i64) != 0 do
            if fat_str_len(call_ast.name2) == 0 do
                out 1
            end
        end
    end
    out 0
end.

func pass6_is_logic_bit_operand(k: TypeKind):
    out typecheck_is_logic_bit_operand(k)
end.

func pass6_name_in_vec(names: i64, name: &string):
    if names == 0 do out 0 end
    var i = 0
    when i < vec_len_rt(names) loop
        if fat_str_eq(vec_get_rt(names, i) as string, name) do out 1 end
        i = i + 1
    end
    out 0
end.

# Recover the declared tensor annotation through identifiers and quantize
# wrappers.  TypeKind alone intentionally does not erase element/shape data.
func pass6_tensor_type_name(ref symbols: SymbolTable, ref scopes: ScopeTree, node: &AstNode):
    if node.node_type == AstType.Identifier do
        found = pass6_lookup_chain(symbols, scopes, scope_current_id(scopes), node.name)
        if found != -1 do
            sym = pass6_symbol_at(symbols, found)
            if sym.ast_id != 0 do
                decl = sym.ast_id as AstNode
                if is_tensor_type_str(decl.name2) do out decl.name2 end
                if is_quantized_type_str(decl.name2 as int) do out decl.name2 end
                if vec_len_rt(decl.children) > 0 do
                    out pass6_tensor_type_name(symbols, scopes, vec_get_rt(decl.children, 0))
                end
            end
        end
        let vty = pass6_get_var_type(node.name)
        if is_tensor_type_str(vty) or is_quantized_type_str(vty as int) do
            out vty
        end
    eif node.node_type == AstType.QuantizeExpr do
        if is_quantized_type_str(node.name2 as int) do out node.name2 end
        if vec_len_rt(node.children) > 0 do
            out pass6_tensor_type_name(symbols, scopes, vec_get_rt(node.children, 0))
        end
    end
    out fat_str_new("")
end.

func pass6_collect_entities(node: &AstNode):
    if node as i64 == 0 do out 0 end
    if (node.node_type == AstType.EntityDef or node.node_type == AstType.PackedDef or node.node_type == AstType.RegisterDef) and fat_str_len(node.name) > 0 do
        g_pass6_entity_names = vec_push_rt(g_pass6_entity_names, node.name as i64)
        g_pass6_entity_nodes = vec_push_rt(g_pass6_entity_nodes, node as i64)
        if g_pass6_entity_buckets == 0 do
            g_pass6_entity_buckets = pass6_global_map_new()
        end
        let ebid = pass6_hash_name(node.name)
        var ebucket = vec_get_rt(g_pass6_entity_buckets, ebid)
        ebucket = vec_push_rt(ebucket, node as i64)
        vec_set_rt(g_pass6_entity_buckets, ebid, ebucket)
    eif node.node_type == AstType.EnumDef and fat_str_len(node.name) > 0 do
        let ebid = pass6_hash_name(node.name)
        var ebucket = vec_get_rt(g_pass6_enum_buckets, ebid)
        ebucket = vec_push_rt(ebucket, node as i64)
        vec_set_rt(g_pass6_enum_buckets, ebid, ebucket)
    end
    child_count = vec_len_rt(node.children)
    var i = 0
    when i < child_count loop
        pass6_collect_entities(vec_get_rt(node.children, i))
        i = i + 1
    end
    out 0
end.

func pass6_find_entity_ast(ref symbols: SymbolTable, ref scopes: ScopeTree, entity_name: &string):
    if fat_str_len(entity_name) == 0 do out 0 as AstNode end
    sid = pass6_lookup_chain(symbols, scopes, scope_current_id(scopes), entity_name)
    if sid != -1 do
        sym = pass6_symbol_at(symbols, sid)
        if sym.kind == SymbolKind.Entity and sym.ast_id != 0 do
            out sym.ast_id as AstNode
        end
    end
    out typecheck_find_entity_ast_raw(g_pass6_entity_buckets, entity_name)
end.

func pass6_entity_has_field(ref symbols: SymbolTable, ref scopes: ScopeTree, base_name: &string, field_name: &string):
    if fat_str_len(base_name) == 0 or fat_str_len(field_name) == 0 do out 0 end
    ent_ast = pass6_find_entity_ast(symbols, scopes, base_name)
    if (ent_ast as i64) != 0 do
        out typecheck_entity_has_field(ent_ast, field_name)
    end
    out 0
end.

func pass6_find_best_entity_ast(ref symbols: SymbolTable, ref scopes: ScopeTree, lit: &AstNode):
    if fat_str_len(lit.name) == 0 do out 0 as AstNode end
    out pass6_find_entity_ast(symbols, scopes, lit.name)
end.

func pass6_is_valid_packed_primitive(name: &string) -> int:
    out typecheck_is_valid_packed_primitive(name)
end.

func pass6_register_base_bits(name: &string) -> int:
    out typecheck_register_base_bits(name)
end.

func pass6_packed_has_cycle(ref symbols: SymbolTable, ref scopes: ScopeTree, current_name: &string, active_stack: i64) -> int:
    out typecheck_packed_has_cycle(g_pass6_entity_buckets, current_name, active_stack)
end.

func pass6_check_packed_def(ref symbols: SymbolTable, ref scopes: ScopeTree, diag: &DiagnosticEngine, node: &AstNode):
    typecheck_check_packed_def(g_pass6_entity_buckets, diag, node)
end.

func pass6_check_packed_literal(ref symbols: SymbolTable, ref scopes: ScopeTree, diag: &DiagnosticEngine, lit: &AstNode):
    if fat_str_len(lit.name) == 0 do out 0 end
    ent_ast = pass6_find_best_entity_ast(symbols, scopes, lit)
    if (ent_ast as i64) == 0 do out 0 end
    if ent_ast.node_type != AstType.PackedDef and ent_ast.node_type != AstType.EntityDef do out 0 end

    n_fields = vec_len_rt(ent_ast.children)
    n_args = vec_len_rt(lit.children)

    exp_names = vec_new_rt()
    field_buckets = pass6_global_map_new()
    var fi = 0
    when fi < n_fields loop
        f_node = vec_get_rt(ent_ast.children, fi) as AstNode
        if f_node.node_type != AstType.FuncDef do
            exp_names = vec_push_rt(exp_names, f_node.name as i64)
            let fbid = pass6_hash_name(f_node.name)
            var fbucket = vec_get_rt(field_buckets, fbid)
            fbucket = vec_push_rt(fbucket, f_node.name as i64)
            fbucket = vec_push_rt(fbucket, f_node.name2 as i64)
            vec_set_rt(field_buckets, fbid, fbucket)
        end
        fi = fi + 1
    end
    n_exp = vec_len_rt(exp_names)

    var seen_args = pass6_global_map_new()
    var ai = 0
    when ai < n_args loop
        arg = vec_get_rt(lit.children, ai) as AstNode
        aname = arg.name2
        let abid = pass6_hash_name(aname)
        var abucket = vec_get_rt(seen_args, abid)
        let ablen = vec_len_rt(abucket)
        var has_dup_arg = false
        var pi = 0
        when pi < ablen loop
            if fat_str_eq(vec_get_rt(abucket, pi) as string, aname) == 1 do
                has_dup_arg = true
                pi = ablen
            else
                pi = pi + 1
            end
        end
        if has_dup_arg do
            report_error(diag, 3010, lit.line, 0)
        else
            abucket = vec_push_rt(abucket, aname as i64)
            vec_set_rt(seen_args, abid, abucket)
        end
        let field_bid = pass6_hash_name(aname)
        let field_bucket = vec_get_rt(field_buckets, field_bid)
        let field_bucket_len = vec_len_rt(field_bucket)
        var ftype = fat_str_new("")
        var matched_field = false
        var k = 0
        when k < field_bucket_len loop
            if fat_str_eq(vec_get_rt(field_bucket, k) as string, aname) == 1 do
                ftype = vec_get_rt(field_bucket, k + 1) as string
                matched_field = true
                k = field_bucket_len
            else
                k = k + 2
            end
        end
        if not matched_field do
            report_error_loc(diag, 3008, 0, lit.line, 1, aname as string)
        else
            var arg_type = pass6_infer_type(symbols, scopes, arg)
            var f_ent = pass6_find_entity_ast(symbols, scopes, pass6_extract_base_name(ftype))
            if (f_ent as i64) != 0 do
                if arg.node_type == AstType.ArrayLiteral do
                    report_error(diag, 3011, arg.line, 0)
                eif arg.node_type == AstType.LiteralStr or (arg.node_type == AstType.LiteralInt and arg.int_val != 0) or arg.node_type == AstType.LiteralBool or arg.node_type == AstType.DictLiteral or arg.node_type == AstType.TupleExpr do
                    report_error(diag, 3011, arg.line, 0)
                eif arg.node_type == AstType.LiteralInt and arg.int_val == 0 do
                    # 0 is null pointer/entity reference
                else
                    var arg_ent_name = pass6_get_expr_type_str(symbols, scopes, arg)
                    if fat_str_len(arg_ent_name) > 0 do
                        if pass6_is_array_type_str(arg_ent_name) do
                            report_error(diag, 3011, arg.line, 0)
                        else
                            var a_ent_ast = pass6_find_entity_ast(symbols, scopes, pass6_extract_base_name(arg_ent_name))
                            if (a_ent_ast as i64) != 0 do
                                if pass6_type_strings_compatible(symbols, scopes, ftype, arg_ent_name) == 0 do
                                    report_error(diag, 3011, arg.line, 0)
                                end
                            end
                        end
                    end
                end
            eif pass6_is_array_type_str(ftype) do
                if arg.node_type == AstType.EntityLiteral do
                    report_error(diag, 3011, arg.line, 0)
                eif arg.node_type == AstType.LiteralStr or arg.node_type == AstType.LiteralInt or arg.node_type == AstType.LiteralBool or arg.node_type == AstType.DictLiteral or arg.node_type == AstType.TupleExpr do
                    report_error(diag, 3011, arg.line, 0)
                else
                    var arg_arr_str = pass6_get_expr_type_str(symbols, scopes, arg)
                    if fat_str_len(arg_arr_str) > 0 do
                        var a_ent_ast2 = pass6_find_entity_ast(symbols, scopes, pass6_extract_base_name(arg_arr_str))
                        if (a_ent_ast2 as i64) != 0 do
                            report_error(diag, 3011, arg.line, 0)
                        eif pass6_type_strings_compatible(symbols, scopes, ftype, arg_arr_str) == 0 do
                            report_error(diag, 3011, arg.line, 0)
                        end
                    end
                end
            else
                var dec_type = pass6_resolve_ffi_type(ftype)
                if dec_type != TypeKind.Void and dec_type != TypeKind.None and arg_type != TypeKind.Void do
                    var is_str_int_handle = ((dec_type == TypeKind.Int and arg_type == TypeKind.String) or (dec_type == TypeKind.String and arg_type == TypeKind.Int)) and (arg.node_type != AstType.LiteralStr and arg.node_type != AstType.LiteralInt)
                    if not is_str_int_handle and pass6_types_compatible(dec_type as i64, arg_type) == 0 do
                        report_error(diag, 3011, arg.line, 0)
                    end
                end
            end
            typecheck_check_int_literal_range(diag, ftype, arg)
        end
        ai = ai + 1
    end

    var ei = 0
    when ei < n_exp loop
        exp_name = vec_get_rt(exp_names, ei) as string
        let ebid = pass6_hash_name(exp_name)
        let ebucket = vec_get_rt(seen_args, ebid)
        let eblen = vec_len_rt(ebucket)
        var found = false
        var chk_i = 0
        when chk_i < eblen loop
            if fat_str_eq(vec_get_rt(ebucket, chk_i) as string, exp_name) == 1 do
                found = true
                chk_i = eblen
            else
                chk_i = chk_i + 1
            end
        end
        if not found do
            report_error(diag, 3029, lit.line, 0)
        end
        ei = ei + 1
    end
    out 0
end.

func pass6_set_sym_type(sym_id: int, type_name: &string):
    if sym_id < 0 or fat_str_len(type_name) == 0 do out 0 end
    if g_pass6_sym_types == 0 do
        g_pass6_sym_types = vec_new_rt()
    end
    let cur_len = vec_len_rt(g_pass6_sym_types)
    var i = cur_len
    when i <= sym_id loop
        g_pass6_sym_types = vec_push_rt(g_pass6_sym_types, 0)
        i = i + 1
    end
    vec_set_rt(g_pass6_sym_types, sym_id, type_name as i64)
    out 0
end.

func pass6_get_sym_type(sym_id: int) -> string:
    if sym_id < 0 or g_pass6_sym_types == 0 do out fat_str_new("") end
    if sym_id >= vec_len_rt(g_pass6_sym_types) do out fat_str_new("") end
    let val = vec_get_rt(g_pass6_sym_types, sym_id)
    if val == 0 do out fat_str_new("") end
    out val as string
end.

func pass6_scope_enter():
    if g_pass6_scope_watermarks == 0 do
        g_pass6_scope_watermarks = vec_new_rt()
    end
    var w = 0
    if g_pass6_scoped_var_names != 0 do
        w = vec_len_rt(g_pass6_scoped_var_names)
    end
    g_pass6_scope_watermarks = vec_push_rt(g_pass6_scope_watermarks, w)
    out 0
end.

func pass6_scope_exit():
    if g_pass6_scope_watermarks != 0 do
        if vec_len_rt(g_pass6_scope_watermarks) > 0 do
            let cur_w_idx = vec_len_rt(g_pass6_scope_watermarks) - 1
            let w = vec_get_rt(g_pass6_scope_watermarks, cur_w_idx) as int
            native_write_i64(g_pass6_scope_watermarks - 8, 0, cur_w_idx)
            if g_pass6_scoped_var_names != 0 do
                let cur_n = vec_len_rt(g_pass6_scoped_var_names)
                if cur_n > w do
                    native_write_i64(g_pass6_scoped_var_names - 8, 0, w)
                    native_write_i64(g_pass6_scoped_var_types - 8, 0, w)
                end
            end
        end
    end
    out 0
end.

func pass6_get_scoped_name_type(name: &string) -> string:
    if g_pass6_scoped_var_names == 0 or fat_str_len(name) == 0 do out fat_str_new("") end
    let n = vec_len_rt(g_pass6_scoped_var_names)
    var i = n - 1
    when i >= 0 loop
        let vn = vec_get_rt(g_pass6_scoped_var_names, i) as string
        if fat_str_eq(vn, name) == 1 do
            out vec_get_rt(g_pass6_scoped_var_types, i) as string
        end
        i = i - 1
    end
    out fat_str_new("")
end.

func pass6_set_scoped_name_type(name: &string, type_name: &string):
    if fat_str_len(name) == 0 or fat_str_len(type_name) == 0 do out 0 end
    if g_pass6_scoped_var_names == 0 do
        g_pass6_scoped_var_names = vec_new_rt()
        g_pass6_scoped_var_types = vec_new_rt()
    end
    g_pass6_scoped_var_names = vec_push_rt(g_pass6_scoped_var_names, name as i64)
    g_pass6_scoped_var_types = vec_push_rt(g_pass6_scoped_var_types, type_name as i64)
    out 0
end.

func pass6_set_var_type(name: &string, type_name: &string):
    if fat_str_len(name) == 0 or fat_str_len(type_name) == 0 do out 0 end
    pass6_set_scoped_name_type(name, type_name)
    out 0
end.

func pass6_get_var_type(name: &string):
    if fat_str_len(name) == 0 do out fat_str_new("") end
    out pass6_get_scoped_name_type(name)
end.

func pass6_dict_key_expr_type(ref symbols: SymbolTable, ref scopes: ScopeTree, node: &AstNode) -> TypeKind:
    if node == 0 do out TypeKind.Void end
    var var_type_str = fat_str_new("")
    if node.node_type == AstType.Identifier do
        var_type_str = pass6_get_var_type(node.name)
    end
    let inferred = pass6_infer_type(symbols, scopes, node)
    out typecheck_dict_key_expr_type(node, var_type_str, inferred)
end.

func pass6_dict_literal_key_type(ref symbols: SymbolTable, ref scopes: ScopeTree, lit: &AstNode):
    if lit == 0 or lit.node_type != AstType.DictLiteral or vec_len_rt(lit.children) < 2 do
        out TypeKind.Void
    end
    out pass6_dict_key_expr_type(symbols, scopes, vec_get_rt(lit.children, 0) as AstNode)
end.

func pass6_dict_var_key_type(ref symbols: SymbolTable, ref scopes: ScopeTree, name: &string):
    found = pass6_lookup_chain(symbols, scopes, scope_current_id(scopes), name)
    if found < 0 do out TypeKind.Void end
    sym = pass6_symbol_at(symbols, found)
    if sym.ast_id == 0 do out TypeKind.Void end
    decl = sym.ast_id as AstNode
    if vec_len_rt(decl.children) == 0 do out TypeKind.Void end
    initializer = vec_get_rt(decl.children, 0) as AstNode
    out pass6_dict_literal_key_type(symbols, scopes, initializer)
end.

func pass6_dict_literal_value_type(ref symbols: SymbolTable, ref scopes: ScopeTree, lit: &AstNode):
    if lit == 0 or lit.node_type != AstType.DictLiteral or vec_len_rt(lit.children) < 2 do
        out TypeKind.Void
    end
    var first_type = pass6_infer_type(symbols, scopes, vec_get_rt(lit.children, 1) as AstNode)
    let n = vec_len_rt(lit.children)
    var i = 3
    when i < n loop
        var v_type = pass6_infer_type(symbols, scopes, vec_get_rt(lit.children, i) as AstNode)
        if v_type != first_type do
            out TypeKind.Void
        end
        i = i + 2
    end
    out first_type
end.

func pass6_dict_var_value_type(ref symbols: SymbolTable, ref scopes: ScopeTree, name: &string):
    found = pass6_lookup_chain(symbols, scopes, scope_current_id(scopes), name)
    if found < 0 do out TypeKind.Void end
    sym = pass6_symbol_at(symbols, found)
    if sym.ast_id == 0 do out TypeKind.Void end
    decl = sym.ast_id as AstNode
    if vec_len_rt(decl.children) == 0 do out TypeKind.Void end
    initializer = vec_get_rt(decl.children, 0) as AstNode
    out pass6_dict_literal_value_type(symbols, scopes, initializer)
end.

func pass6_array_var_elem_type(ref symbols: SymbolTable, ref scopes: ScopeTree, name: &string):
    found = pass6_lookup_chain(symbols, scopes, scope_current_id(scopes), name)
    if found < 0 do out TypeKind.Void end
    sym = pass6_symbol_at(symbols, found)
    if sym.ast_id == 0 do out TypeKind.Void end
    decl = sym.ast_id as AstNode
    if vec_len_rt(decl.children) == 0 do out TypeKind.Void end
    initializer = vec_get_rt(decl.children, 0) as AstNode
    if (initializer as i64) != 0 do
        if initializer.node_type == AstType.ArrayLiteral do
            if vec_len_rt(initializer.children) > 0 do
                out pass6_infer_type(symbols, scopes, vec_get_rt(initializer.children, 0) as AstNode)
            end
        end
    end
    out TypeKind.Void
end.

func pass6_count_callable_params(type_str: &string):
    out typecheck_count_callable_params(type_str)
end.

func pass6_callable_param_type(type_str: &string, wanted: int):
    out typecheck_callable_param_type(type_str, wanted)
end.

func pass6_callable_return_type(type_str: &string):
    out typecheck_callable_return_type(type_str)
end.

func pass6_get_receiver_entity_name(ref symbols: SymbolTable, ref scopes: ScopeTree, recv: &AstNode):
    if recv == 0 do out fat_str_new("") end
    nt = recv.node_type
    if nt == AstType.AddrOf and vec_len_rt(recv.children) > 0 do
        out pass6_get_receiver_entity_name(symbols, scopes, vec_get_rt(recv.children, 0) as AstNode)
    end
    if nt == AstType.Identifier do
        if fat_cstr_eq(recv.name, "this") == 1 do
            if g_pass6_current_entity_name != 0 do
                out g_pass6_current_entity_name as string
            end
        end
        sid = pass6_lookup_chain(symbols, scopes, scope_current_id(scopes), recv.name)
        if sid != -1 do
            sym = pass6_symbol_at(symbols, sid)
            if sym.ast_id != 0 do
                decl = sym.ast_id as AstNode
                if decl.node_type == AstType.VarDecl or decl.node_type == AstType.ConstDecl do
                    if fat_str_len(decl.name2) > 0 do
                        out pass6_unwrap_type_name(decl.name2)
                    end
                    if vec_len_rt(decl.children) > 0 do
                        init = vec_get_rt(decl.children, 0)
                        if init.node_type == AstType.EntityLiteral do
                            out init.name
                        end
                        if init.node_type == AstType.Call do
                            ent_chk = pass6_find_entity_ast(symbols, scopes, init.name)
                            if ent_chk != 0 do out init.name end
                            init_ent = pass6_get_receiver_entity_name(symbols, scopes, init)
                            if fat_str_len(init_ent) > 0 do out init_ent end
                        end
                        if init.node_type == AstType.AddrOf and vec_len_rt(init.children) > 0 do
                            init_ent = pass6_get_receiver_entity_name(symbols, scopes, vec_get_rt(init.children, 0) as AstNode)
                            if fat_str_len(init_ent) > 0 do out init_ent end
                        end
                    end
                end
                if decl.node_type == AstType.ParamDef or decl.node_type == AstType.RefParam or decl.node_type == AstType.Identifier do
                    if fat_str_len(decl.name2) > 0 do out pass6_unwrap_type_name(decl.name2) end
                end
            end
        end
        vt = pass6_get_var_type(recv.name)
        if fat_str_len(vt) > 0 do out pass6_unwrap_type_name(vt) end
        ent_chk2 = pass6_find_entity_ast(symbols, scopes, recv.name)
        if ent_chk2 != 0 do out recv.name end
        out fat_str_new("")
    end
    if nt == AstType.EntityLiteral do
        if fat_str_len(recv.name2) > 0 do
            out fat_str_concat(recv.name, fat_str_concat(fat_str_new("<"), fat_str_concat(recv.name2, fat_str_new(">"))))
        end
        out recv.name
    end
    if nt == AstType.BuiltinCall & fat_cstr_eq(recv.name, "port") == 1 do
        out recv.name
    end
    if nt == AstType.Call do
        ent_chk3 = pass6_find_entity_ast(symbols, scopes, recv.name)
        if ent_chk3 != 0 do out recv.name end
        call_ast = pass6_find_free_function(recv.name)
        if call_ast != 0 do
            call_ret = call_ast.name2
            if fat_str_len(call_ret) > 0 do
                let unwrapped_ret = pass6_unwrap_type_name(call_ret)
                call_ret_ent = pass6_find_entity_ast(symbols, scopes, unwrapped_ret)
                if (call_ret_ent as i64) != 0 do out unwrapped_ret end
            else
                let ret_s = pass6_find_return_stmt(call_ast)
                if (ret_s as i64) != 0 do
                    if vec_len_rt(ret_s.children) > 0 do
                        let ret_val = vec_get_rt(ret_s.children, 0) as AstNode
                        if ret_val.node_type == AstType.EntityLiteral do
                            out ret_val.name
                        eif ret_val.node_type == AstType.Identifier do
                            let p_ent = pass6_find_param_entity(call_ast, ret_val.name)
                            if fat_str_len(p_ent) > 0 do out p_ent end
                        end
                    end
                end
            end
        end
        out fat_str_new("")
    end
    if nt == AstType.FieldAccess and vec_len_rt(recv.children) > 0 do
        base_node = vec_get_rt(recv.children, 0)
        if base_node.node_type == AstType.Identifier do
            chk_enum = pass6_find_enum_ast(symbols, scopes, base_node.name)
            if (chk_enum as i64) != 0 do
                out base_node.name
            end
        end
        base_ent = pass6_get_receiver_entity_name(symbols, scopes, base_node)
        if fat_str_len(base_ent) > 0 do
            base_raw = pass6_unwrap_type_name(base_ent)
            base_ast = pass6_find_entity_ast(symbols, scopes, base_raw)
            if base_ast != 0 do
                n_f = vec_len_rt(base_ast.children)
                var fi = 0
                when fi < n_f loop
                    fch = vec_get_rt(base_ast.children, fi)
                    if (fch.node_type == AstType.Identifier or fch.node_type == AstType.VarDecl) and fat_str_eq(fch.name, recv.name) == 1 do
                        out fch.name2
                    end
                    fi = fi + 1
                end
            end
        end
        out fat_str_new("")
    end
    if nt == AstType.MethodCall and vec_len_rt(recv.children) > 0 do
        # A resolved free-function UFCS call carries the free callee in `name`.
        # Preserve an entity return type so the next link in a chain can resolve
        # against that entity's method set (for example: 9.to_box().score()).
        if recv.builtin_id == 203 do
            free_call_ast = 0 as AstNode
            if fat_str_len(recv.name2) > 0 do
                free_call_ast = pass6_find_func_by_canonical_identity(recv.name2)
                if free_call_ast == 0 do
                    free_call_ast = pass6_find_free_function(recv.name2)
                end
            end
            if free_call_ast == 0 do
                free_call_ast = pass6_find_free_function(recv.name)
            end
            if free_call_ast != 0 do
                free_call_ret = free_call_ast.name2
                if fat_str_len(free_call_ret) > 0 do
                    let unwrapped_ret = pass6_unwrap_type_name(free_call_ret)
                    free_call_ret_ent = pass6_find_entity_ast(symbols, scopes, unwrapped_ret)
                    if (free_call_ret_ent as i64) != 0 do out unwrapped_ret end
                end
            end
        end
        m_recv = vec_get_rt(recv.children, 0)
        m_recv_ent = pass6_get_receiver_entity_name(symbols, scopes, m_recv)
        if recv.builtin_id == 202 and fat_str_len(m_recv_ent) > 0 do
            callable_owner = pass6_find_entity_ast(symbols, scopes, m_recv_ent)
            if callable_owner != 0 do
                callable_child_count = vec_len_rt(callable_owner.children)
                var callable_i = 0
                when callable_i < callable_child_count loop
                    callable_field = vec_get_rt(callable_owner.children, callable_i)
                    if (callable_field.node_type == AstType.Identifier or callable_field.node_type == AstType.VarDecl) and fat_str_eq(callable_field.name, recv.name) == 1 do
                        callable_ret = pass6_callable_return_type(callable_field.name2)
                        callable_ret_ent = pass6_find_entity_ast(symbols, scopes, callable_ret)
                        if callable_ret_ent != 0 do out callable_ret_ent.name end
                        callable_i = callable_child_count
                    else
                        callable_i = callable_i + 1
                    end
                end
            end
        end
        if fat_str_len(m_recv_ent) > 0 do
            m_base_ast = pass6_find_entity_ast(symbols, scopes, m_recv_ent)
            if m_base_ast != 0 do
                n_m = vec_len_rt(m_base_ast.children)
                var mi = 0
                when mi < n_m loop
                    mch = vec_get_rt(m_base_ast.children, mi)
                    if mch.node_type == AstType.FuncDef and fat_str_eq(mch.name, recv.name) == 1 do
                        out mch.name2
                    end
                    mi = mi + 1
                end
            end
        end
        out fat_str_new("")
    end
    if nt == AstType.EnumConstruct do
        if fat_str_len(recv.name2) > 0 do out recv.name2 end
    end
    out fat_str_new("")
end.

func pass6_extract_base_name(type_str: &string) -> string:
    out typecheck_extract_base_name(type_str)
end.

func pass6_is_array_type_str(type_str: &string) -> bool:
    out typecheck_is_array_type_str(type_str)
end.

func pass6_extract_generic_or_array_elem(type_str: &string) -> string:
    out typecheck_extract_generic_or_array_elem(type_str)
end.

func pass6_type_strings_compatible(ref symbols: SymbolTable, ref scopes: ScopeTree, expected: &string, actual: &string) -> int:
    out typecheck_type_strings_compatible(symbols, scopes, expected, actual)
end.

func pass6_get_expr_type_str(ref symbols: SymbolTable, ref scopes: ScopeTree, node: &AstNode):
    if (node as i64) == 0 do out fat_str_new("") end
    if node.node_type == AstType.AddrOf and vec_len_rt(node.children) > 0 do
        out pass6_get_expr_type_str(symbols, scopes, vec_get_rt(node.children, 0) as AstNode)
    end
    if node.node_type == AstType.QuantizeExpr do
        if fat_str_len(node.name2) > 0 do out node.name2 end
        out fat_str_new("QuantizedTensor")
    end
    if node.node_type == AstType.ArrayLiteral do
        let n_ch = vec_len_rt(node.children)
        if n_ch == 0 do
            out fat_str_new("[]")
        end
        var elem0 = vec_get_rt(node.children, 0) as AstNode
        var elem_str = pass6_get_expr_type_str(symbols, scopes, elem0)
        if fat_str_len(elem_str) == 0 do
            let ekind = pass6_infer_type(symbols, scopes, elem0)
            if ekind == TypeKind.String do elem_str = fat_str_new("string")
            eif ekind == TypeKind.Int do elem_str = fat_str_new("int")
            eif ekind == TypeKind.Float do elem_str = fat_str_new("float")
            eif ekind == TypeKind.Bool do elem_str = fat_str_new("bool")
            end
        end
        out typecheck_format_array_type_str(elem_str)
    end
    if node.node_type == AstType.LiteralStr or node.node_type == AstType.InterpExpr do
        out fat_str_new("string")
    end
    if node.node_type == AstType.LiteralInt do
        out fat_str_new("int")
    end
    if node.node_type == AstType.LiteralFloat do
        out fat_str_new("float")
    end
    if node.node_type == AstType.LiteralBool do
        out fat_str_new("bool")
    end
    if node.node_type == AstType.EntityLiteral do
        if fat_str_len(node.name2) > 0 do
            out node.name2
        end
        out node.name
    end
    if node.node_type == AstType.Identifier do
        var vty = pass6_get_var_type(node.name)
        if fat_str_len(vty) > 0 do
            out vty
        end
        var sid = pass6_lookup_chain(symbols, scopes, scope_current_id(scopes), node.name)
        if sid != -1 do
            var sym = pass6_symbol_at(symbols, sid)
            if sym.ast_id != 0 do
                var decl_node = sym.ast_id as AstNode
                if fat_str_len(decl_node.name2) > 0 do
                    out decl_node.name2
                end
            end
        end
        out fat_str_new("")
    end
    if node.node_type == AstType.Call or node.node_type == AstType.MethodCall do
        var r_ent = pass6_get_receiver_entity_name(symbols, scopes, node)
        if fat_str_len(r_ent) > 0 do
            out r_ent
        end
        if fat_cstr_eq(node.name, "str_concat") == 1 or fat_cstr_eq(node.name, "str_cat") == 1 or fat_cstr_eq(node.name, "fat_str_concat") == 1 or fat_cstr_eq(node.name, "fat_str_new") == 1 or fat_cstr_eq(node.name, "str_slice") == 1 or fat_cstr_eq(node.name, "fat_str_slice") == 1 or fat_cstr_eq(node.name, "rt_strcat") == 1 or fat_cstr_eq(node.name, "rt_itoa") == 1 or fat_cstr_eq(node.name, "str_trim") == 1 or fat_cstr_eq(node.name, "str_to_lower") == 1 or fat_cstr_eq(node.name, "str_to_upper") == 1 or fat_cstr_eq(node.name, "str_repeat") == 1 or fat_cstr_eq(node.name, "str_replace") == 1 do
            out fat_str_new("string")
        end
        if fat_cstr_eq(node.name, "str_eq") == 1 or fat_cstr_eq(node.name, "fat_str_eq") == 1 or fat_cstr_eq(node.name, "str_contains") == 1 or fat_cstr_eq(node.name, "str_starts_with") == 1 or fat_cstr_eq(node.name, "str_ends_with") == 1 or fat_cstr_eq(node.name, "dict_has_key") == 1 do
            out fat_str_new("bool")
        end
        if fat_cstr_eq(node.name, "str_len") == 1 or fat_cstr_eq(node.name, "str_byte_len") == 1 or fat_cstr_eq(node.name, "fat_str_len") == 1 or fat_cstr_eq(node.name, "vec_len") == 1 or fat_cstr_eq(node.name, "dict_len") == 1 do
            out fat_str_new("int")
        end
        var fn_ast = pass6_find_free_function(node.name)
        if (fn_ast as i64) != 0 do
            let fn_ret = fn_ast.name2
            if fat_str_len(fn_ret) > 0 do
                out fn_ret
            end
        else
            var ext_ast = pass6_find_extern(node.name) as AstNode
            if (ext_ast as i64) != 0 do
                let ext_ret = ext_ast.name2
                if fat_str_len(ext_ret) > 0 do
                    out ext_ret
                end
            end
        end
        out fat_str_new("")
    end
    if node.node_type == AstType.BuiltinCall do
        if node.builtin_id == 11 or node.builtin_id == 19 do
            out fat_str_new("string")
        end
        if node.builtin_id == 12 do
            out fat_str_new("bool")
        end
        if fat_cstr_eq(node.name, "str_concat") == 1 or fat_cstr_eq(node.name, "str_cat") == 1 or fat_cstr_eq(node.name, "fat_str_concat") == 1 or fat_cstr_eq(node.name, "fat_str_new") == 1 or fat_cstr_eq(node.name, "str_slice") == 1 or fat_cstr_eq(node.name, "fat_str_slice") == 1 or fat_cstr_eq(node.name, "rt_strcat") == 1 or fat_cstr_eq(node.name, "rt_itoa") == 1 or fat_cstr_eq(node.name, "str_trim") == 1 or fat_cstr_eq(node.name, "str_to_lower") == 1 or fat_cstr_eq(node.name, "str_to_upper") == 1 or fat_cstr_eq(node.name, "str_repeat") == 1 or fat_cstr_eq(node.name, "str_replace") == 1 do
            out fat_str_new("string")
        end
        if fat_cstr_eq(node.name, "str_eq") == 1 or fat_cstr_eq(node.name, "fat_str_eq") == 1 or fat_cstr_eq(node.name, "str_contains") == 1 or fat_cstr_eq(node.name, "str_starts_with") == 1 or fat_cstr_eq(node.name, "str_ends_with") == 1 or fat_cstr_eq(node.name, "dict_has_key") == 1 do
            out fat_str_new("bool")
        end
        out fat_str_new("int")
    end
    if node.node_type == AstType.FieldAccess do
        var f_type = pass6_get_receiver_entity_name(symbols, scopes, node)
        if fat_str_len(f_type) > 0 do
            out f_type
        end
    end
    out fat_str_new("")
end.

func pass6_find_enum_ast(ref symbols: SymbolTable, ref scopes: ScopeTree, name: &string) -> AstNode:
    base_name = pass6_extract_base_name(name)
    if fat_str_len(base_name) == 0 do out 0 as AstNode end
    sid = pass6_lookup_chain(symbols, scopes, 0, base_name)
    if sid != -1 do
        sym = pass6_symbol_at(symbols, sid)
        if sym.kind == SymbolKind.Enum and sym.ast_id != 0 do
            out sym.ast_id as AstNode
        end
    end
    out typecheck_find_enum_ast_raw(g_pass6_enum_buckets, base_name)
end.

func pass6_enum_is_tagged(enum_ast: &AstNode) -> bool:
    out typecheck_enum_is_tagged(enum_ast)
end.

