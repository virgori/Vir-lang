##
 * vir/compiler/semantic/diagnostics/msg_semantic.vri
 * ==============================================================
 * Diagnostic message formatting for semantic, type, control flow, and borrow phases.
 ##

include string_rt
include context
include sem_diag_msg_frontend

func pass10_msg_semantic(code: int, extra: string):
    if code == 2003 or code == 3001 do out "Type mismatch in expression or operation" end
    if code == 2005 or code == 3012 do out "Invalid assignment target (not an l-value)" end
    if code == 3002 do out "Invalid operator for operand type" end
    if code == 3003 do out "Assignment to immutable variable (declared with 'let')" end
    if code == 3004 do out "Type mismatch in variable assignment" end
    if code == 3005 do out "Wrong argument count in function invocation" end
    if code == 3006 do out "Invalid operand types for and/or/xor/shl/shr" end
    if code == 3007 do out "Assignment or return value type does not match declared type" end
    if code == 3008 do
        if (extra as i64) != 0 do
            let diag_len = fat_str_len(extra)
            if diag_len > 0 do
                arena:
                    var sb = sb_new()
                    sb = sb_append(sb, "Unknown entity field access '")
                    var d_i = 0
                    when d_i < diag_len loop
                        sb = sb_append_char(sb, fat_str_byte_at(extra, d_i))
                        d_i = d_i + 1
                    end
                    sb = sb_append(sb, "'")
                    out sb_to_string(sb)
                end
            end
        end
        out "Unknown entity field access"
    end
    if code == 3009 do out "Operation prohibited in 'infer:' block (e.g. calling .backward())" end
    if code == 3010 do out "Duplicate field in entity initialization" end
    if code == 3011 do out "Field type mismatch in entity instantiation" end
    if code == 3013 do out "Tensor indexing rank mismatch" end
    if code == 3014 do out "Matrix multiplication dimension mismatch" end
    if code == 3015 do out "Tensor index must be integer" end
    if code == 3016 do out "infer/train blocks cannot be nested" end
    if code == 3017 do out ".backward() is only valid inside a train block" end
    if code == 3018 do out "quantize input must be a floating-point tensor" end
    if code == 3019 do out "quantize bits must be a compile-time constant in {4, 8, 16, 32}" end
    if code == 3020 do out ".backward() receiver must be a floating-point train value with gradient state" end
    if code == 3021 do out "Unresolved UFCS member: no entity method, callable field, or free function" end
    if code == 3022 do out "Wrong argument count in UFCS invocation" end
    if code == 3023 do out "Quantized tensor operations are only supported inside an 'infer:' block" end
    if code == 3024 do out "Invalid tensor type; expected tensor[T; S...] with T in {f32, f16, f64, i8, u8, i32, int} and positive compile-time dimensions" end
    if code == 3025 do out "Packed entity field missing type annotation" end
    if code == 3026 do out "Invalid packed entity field type; must be compile-time fixed-size primitive or packed entity" end
    if code == 3027 do out "Recursive packed entity layout cycle detected" end
    if code == 3028 do out "Normal entity cannot be embedded inline in packed entity" end
    if code == 3029 do out "Missing required field in entity initialization" end
    if code == 3030 do out "Integer literal value out of range for packed field type" end
    if code == 3031 do out "Wrong argument count in enum constructor invocation" end
    if code == 3032 do out "Non-exhaustive case expression on enum" end
    if code == 3033 do out "Unknown enum variant in pattern arm" end
    if code == 3034 do out "Variant does not belong to target enum" end
    if code == 3035 do out "Duplicate case pattern arm" end
    if code == 3036 do out "Unreachable pattern arm after wildcard" end
    if code == 3037 do out "Wrong binder count in enum pattern arm" end
    if code == 3038 do out "Ambiguous unqualified enum variant; qualify with enum name" end
    if code == 3039 do out "Duplicate explicit enum variant tag" end
    if code == 3040 do out "Enum tag value out of range (must be u32: 0..4294967295)" end
    if code == 3041 do out "Duplicate binder in case pattern arm" end
    if code == 3042 do out "Incompatible generic argument type for enum constructor" end
    if code == 3043 do out "Equality comparison '==' is not supported for payload enums; use case pattern matching" end
    if code == 3044 do out "Parameter keyword 'in' is invalid in parenthesized parameter syntax; default parameters are passed by value (§14.1)" end
    if code == 3045 do out "Parameter keyword 'out' is invalid in parenthesized parameter syntax; use parameter groups (§14.1)" end
    if code == 3046 do out "Empty parameter group is not allowed (§14.2)" end
    if code == 3047 do out "Parameter declaration without a group (§14.2)" end
    if code == 3048 do out "Cannot pass a temporary value or expression as 'ref' or 'out' parameter (§14)" end
    if code == 3049 do out "Cannot pass an uninitialized variable to 'ref' parameter (§14)" end
    if code == 3050 do out "Cannot read 'out' parameter before it has been definitely assigned (§14)" end
    if code == 3051 do out "'out' parameter is not definitely assigned on all normal return paths (§14)" end
    if code == 3054 do out "Duplicate parameter name in function definition (§14)" end
    if code == 3056 do out "ensure/revert are continuation clauses and must not use ':' (§13)" end
    if code == 3057 do out "Duplicate ensure clause in function (§13.2)" end
    if code == 3058 do out "Duplicate revert clause in function (§13.3)" end
    if code == 3059 do out "throw value must have type int (§13.6)" end
    if code == 3060 do out "erx is only available inside ensure/revert clauses (§13.5, §13.7)" end
    if code == 3061 do out "resume is only valid inside a local try revert clause (§13.7)" end
    if code == 3062 do out "resume must be followed by retry or revert (§13.7)" end
    if code == 3063 do out "Duplicate timeout option in try (§13.7)" end
    if code == 3064 do out "Expected ':' after timeout option (§13.7)" end
    if code == 3065 do out "Duplicate isolate option in try (§13.7)" end
    if code == 3066 do out "Expected ':' after isolate option (§13.7)" end
    if code == 3067 do out "Unknown try option (§13.7)" end
    if code == 3068 do out "Expected ':' after try header (§13.7)" end
    if code == 3069 do out "try requires a local revert clause (§13.7)" end
    if code == 3070 do out "try closes with end, not end. (§13.7)" end
    if code == 3071 do out "try isolate list must contain unique mutable Copy variables declared outside the try (§13.7)" end
    if code == 3072 do out "atomic retry variables must be mutable Copy values and cannot appear in isolate lists (§13.7)" end
    if code == 3073 do out "emit requires a typed event constructor invocation (§13.7)" end
    if code == 3074 do out "throw is only valid inside a function (§13.1)" end
    if code == 3075 do out "try is only valid inside a function (§13.7)" end
    if code == 3076 do out "Negative integer exponent is invalid for scalar power (§10)" end
    if code == 3077 do out "Register/mold field width must be positive (§16)" end
    if code == 3078 do out "Register/mold fields exceed the declared base width (§16)" end
    if code == 3079 do out "Register/mold field value does not fit its bit width (§16)" end
    if code == 3080 do out "precomp: I/O is forbidden during compile-time evaluation" end
    if code == 3081 do out "precomp: division by zero during compile-time evaluation" end
    if code == 3082 do out "precomp: strings, arrays, and allocations are forbidden during compile-time evaluation" end
    if code == 3083 do
        arena:
            var sb = sb_new()
            sb = sb_append(sb, "precomp: compile-time failure")
            if g_precomp_throw_kind == 1 do
                sb = sb_append(sb, " ")
                sb = sb_append_int(sb, g_precomp_throw_val)
            eif g_precomp_throw_kind == 2 do
                if fat_str_len(g_precomp_throw_str) > 0 do
                    sb = sb_append(sb, " ")
                    sb = sb_append(sb, g_precomp_throw_str)
                end
            end
            out sb_to_string(sb)
        end
    end
    if code == 3084 do out "generic type mismatch: incompatible specialized return type" end
    if code == 3085 do out "generic arity mismatch: wrong number of type arguments" end
    if code == 3086 do
        if (extra as i64) != 0 do
            let diag_len = fat_str_len(extra)
            if diag_len > 0 do
                arena:
                    var sb = sb_new()
                    sb = sb_append(sb, "unresolved generic type parameter ")
                    var d_i = 0
                    when d_i < diag_len loop
                        sb = sb_append_char(sb, fat_str_byte_at(extra, d_i))
                        d_i = d_i + 1
                    end
                    out sb_to_string(sb)
                end
            end
        end
        out "unresolved generic type parameter"
    end
    if code == 3087 do out "duplicate swizzle lane in write-mask" end
    if code == 3088 do out "swizzle width mismatch: write-mask width must match source width" end
    if code == 3089 do out "swizzle lane out of range for vector width" end
    if code == 3090 do out "flux width power of two: flux width must be a power of two" end
    if code == 3095 do
        if (extra as i64) != 0 and fat_str_len(extra) > 0 do
            arena:
                var sb = sb_new()
                sb = sb_append(sb, "bind(")
                sb = sb_append(sb, extra)
                sb = sb_append(sb, ") requires parameter types")
                out sb_to_string(sb)
            end
        end
        out "bind(c) requires parameter types"
    end
    if code == 3097 do out "Cyclic type dependency or circular inference detected" end
    if code == 302 do out "Retry may observe dirty state; reset it, isolate it, or declare a Copy counter atomic (§13.7)" end
    out ""
end.

func pass10_msg_backend(code: int, extra: string):
    # Control Flow errors (E4xxx)
    if code == 4001 do out "Missing return statement on some code paths" end
    if code == 4002 do out "Unreachable code detected" end
    if code == 4003 do out "Dead code — condition is always constant" end
    if code == 4004 do out "Loop control statement 'break' or 'skip' outside loop body" end

    # Borrow Checker errors (E5xxx / E8xxx)
    if code == 5001 or code == 8001 do out "Use of moved value" end
    if code == 5002 or code == 8002 do out "Cannot borrow as mutable while shared borrow is active" end
    if code == 5003 do out "Cannot borrow as mutable more than once (aliasing violation)" end
    if code == 5004 do out "Borrow of moved value" end
    if code == 5005 or code == 8004 do out "Arena-allocated value, reference, or borrow escapes its block scope" end
    if code == 5006 do out "Cannot borrow as shared while mutable borrow is active" end
    if code == 5007 do out "Reference to local variable escapes function scope" end
    if code == 5008 do out "Cannot move value while active borrow exists" end
    if code == 5009 do out "Cannot mutate variable while shared borrow is active" end
    if code == 5010 do out "Cannot perform arena_reset while live borrow exists" end
    if code == 5011 do out "Cannot hold borrow across await suspension boundary" end
    if code == 5012 do out "Borrowed reference escapes its enclosing block scope" end
    if code == 5013 do out "Use of uninitialized variable or reference" end
    out ""
end.

func pass10_code_to_msg(code: int, extra: string):
    if code < 3000 do
        let msg_front = pass10_msg_frontend(code, extra)
        if fat_str_len(msg_front) > 0 do out msg_front end
    eif code < 4000 do
        let msg_sem = pass10_msg_semantic(code, extra)
        if fat_str_len(msg_sem) > 0 do out msg_sem end
    else
        let msg_be = pass10_msg_backend(code, extra)
        if fat_str_len(msg_be) > 0 do out msg_be end
    end

    # Fallback
    var sb = sb_new()
    sb = sb_append(sb, "Compiler diagnostic code ")
    sb = sb_append_int(sb, code)
    out sb_to_string(sb)
end.

export pass10_msg_semantic, pass10_msg_backend, pass10_code_to_msg
