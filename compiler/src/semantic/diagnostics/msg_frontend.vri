##
 * vir/compiler/semantic/diagnostics/msg_frontend.vri
 * ==============================================================
 * Diagnostic message formatting for lexer, parser, and module resolution phases.
 ##

include rt_string_rt
include context

func pass10_code_to_prefix(level: int):
    if level == DiagnosticLevel.Warning do
        out "W"
    eif level == DiagnosticLevel.Info do
        out "I"
    end
    out "E"
end.

func pass10_code_to_result(level: int):
    if level == DiagnosticLevel.Warning do
        out "WARNING"
    eif level == DiagnosticLevel.Info do
        out "INFO"
    end
    out "FAILED"
end.

func pass10_code_to_phase(code: int):
    if code < 1000 do out "Lexer" end
    if code < 2000 do out "Parser" end
    if code >= 2100 and code < 2200 do out "ModuleResolver" end
    if code < 4000 do out "Semantic" end
    if code < 5000 do out "ControlFlow" end
    if code < 6000 or (code >= 8000 and code < 9000) do out "BorrowChecker" end
    if code >= 7000 and code < 8000 do out "ModuleResolver" end
    out "Compiler"
end.

func pass10_extra_cstr(extra: string) -> int:
    let saddr = extra as i64
    if saddr == 0 do out 0 end
    if saddr > 4096 and saddr < 281474976710656 do
        let sdata = native_read_i64(saddr, 0)
        let slen = native_read_i64(saddr, 8)
        let scap = native_read_i64(saddr, 16)
        if sdata > 4096 and sdata < 281474976710656 and slen >= 0 and scap >= slen and scap < 1048576 do
            out sdata
        end
    end
    if rt_strlen(saddr) > 0 do
        out saddr
    end
    out 0
end.

func pass10_msg_frontend(code: int, extra: string):
    # Lexer errors (E0xxx)
    if code == 1 or code == 101 do
        if (extra as i64) != 0 and rt_strlen(extra as i64) > 0 do out extra end
        out "Invalid character in source"
    end
    if code == 2 or code == 102 do
        if (extra as i64) != 0 and rt_strlen(extra as i64) > 0 do out extra end
        out "Unterminated string literal"
    end
    if code == 3 or code == 103 do
        if (extra as i64) != 0 and rt_strlen(extra as i64) > 0 do out extra end
        out "Invalid numeric literal format"
    end

    # Parser errors (E1xxx)
    if code == 1001 do
        if (extra as i64) != 0 and rt_strlen(extra as i64) > 0 do out extra end
        out "Unexpected token in syntax rule"
    end
    if code == 1002 do out "Missing block delimiter 'end' or 'end.'" end
    if code == 1003 do out "Missing colon ':' after condition or signature" end
    if code == 1004 do
        if (extra as i64) != 0 and rt_strlen(extra as i64) > 0 do out extra end
        out "Invalid expression syntax"
    end
    if code == 1005 do out "Unexpected end of file (EOF)" end
    if code == 1006 do out "Invalid function signature" end
    if code == 1007 do out "Mismatched parentheses or brackets" end

    # Semantic & Type errors (E2xxx / E3xxx)
    if code == 2001 do out "Undefined variable in current scope" end
    if code == 2002 do
        if (extra as i64) != 0 do
            let diag_len = fat_str_len(extra)
            if diag_len > 0 do
                arena:
                    var sb = sb_new()
                    sb = sb_append(sb, "Undefined function or symbol: '")
                    var d_i = 0
                    when d_i < diag_len loop
                        sb = sb_append_char(sb, fat_str_byte_at(extra, d_i))
                        d_i = d_i + 1
                    end
                    sb = sb_append(sb, "'")
                    out sb_to_string(sb)
                end
            end
        end
        out "Undefined function or symbol"
    end
    if code == 2003 or code == 3001 do out "Type mismatch in expression or operation" end
    if code == 2004 do out "Duplicate symbol definition in current scope" end
    if code == 2005 or code == 3012 do out "Invalid assignment target (not an l-value)" end
    if code == 2101 do
        if (extra as i64) != 0 and fat_str_len(extra) > 0 do
            arena:
                var sb = sb_new()
                sb = sb_append(sb, "failed to parse include statement name: '")
                sb = sb_append(sb, extra)
                sb = sb_append(sb, "'")
                out sb_to_string(sb)
            end
        end
        out "failed to parse include statement name"
    end
    if code == 2102 do
        if (extra as i64) != 0 and fat_str_len(extra) > 0 do
            arena:
                var sb = sb_new()
                sb = sb_append(sb, "included source not found: '")
                sb = sb_append(sb, extra)
                sb = sb_append(sb, "'")
                out sb_to_string(sb)
            end
        end
        out "included source not found"
    end
    if code == 2103 do out "invalid token '::'; use '.' for qualified names" end
    if code == 2104 do out "maximum include depth exceeded" end
    if code == 2105 do
        if (extra as i64) != 0 and fat_str_len(extra) > 0 do
            arena:
                var sb = sb_new()
                sb = sb_append(sb, "circular dependency detected: ")
                sb = sb_append(sb, extra)
                out sb_to_string(sb)
            end
        end
        out "circular dependency detected"
    end
    if code == 2111 do out "empty or invalid module name in import" end
    if code == 2112 do
        if (extra as i64) != 0 and fat_str_len(extra) > 0 do
            arena:
                var sb = sb_new()
                sb = sb_append(sb, "imported module not found: '")
                sb = sb_append(sb, extra)
                sb = sb_append(sb, "'")
                out sb_to_string(sb)
            end
        end
        out "imported module not found"
    end
    if code == 2113 do
        let extra_cstr = pass10_extra_cstr(extra)
        if extra_cstr != 0 do
            arena:
                var sb = sb_new()
                sb = sb_append(sb, "imported symbol not exported: ")
                sb = sb_append(sb, extra_cstr)
                out sb_to_string(sb)
            end
        end
        out "imported symbol not exported"
    end
    if code == 2114 do out "maximum import depth exceeded" end
    if code == 2115 do
        let extra_cstr = pass10_extra_cstr(extra)
        if extra_cstr != 0 do
            arena:
                var sb = sb_new()
                sb = sb_append(sb, "conflicting module dependency: cannot combine include and import for '")
                sb = sb_append(sb, extra_cstr)
                sb = sb_append(sb, "'")
                out sb_to_string(sb)
            end
        end
        out "conflicting module dependency: cannot combine include and import for the same module"
    end
    if code == 2120 do
        let extra_cstr = pass10_extra_cstr(extra)
        if extra_cstr != 0 do
            arena:
                var sb = sb_new()
                sb = sb_append(sb, "failed to read stdlib registry: ")
                sb = sb_append(sb, extra_cstr)
                out sb_to_string(sb)
            end
        end
        out "failed to read stdlib registry"
    end
    if code == 2121 do
        let extra_cstr = pass10_extra_cstr(extra)
        if extra_cstr != 0 do
            arena:
                var sb = sb_new()
                sb = sb_append(sb, "duplicate module registration: '")
                sb = sb_append(sb, extra_cstr)
                sb = sb_append(sb, "'")
                out sb_to_string(sb)
            end
        end
        out "duplicate module registration"
    end
    if code == 2122 do
        let extra_cstr = pass10_extra_cstr(extra)
        if extra_cstr != 0 do
            arena:
                var sb = sb_new()
                sb = sb_append(sb, "stdlib target file not found for '")
                sb = sb_append(sb, extra_cstr)
                sb = sb_append(sb, "'")
                out sb_to_string(sb)
            end
        end
        out "stdlib target file not found"
    end
    if code == 2123 do
        let extra_cstr = pass10_extra_cstr(extra)
        if extra_cstr != 0 do
            arena:
                var sb = sb_new()
                sb = sb_append(sb, "project module '")
                sb = sb_append(sb, extra_cstr)
                sb = sb_append(sb, "' collides with standard library")
                out sb_to_string(sb)
            end
        end
        out "project module collides with standard library"
    end
    if code == 2124 do
        let extra_cstr = pass10_extra_cstr(extra)
        if extra_cstr != 0 do
            arena:
                var sb = sb_new()
                sb = sb_append(sb, "project module target file not found: '")
                sb = sb_append(sb, extra_cstr)
                sb = sb_append(sb, "'")
                out sb_to_string(sb)
            end
        end
        out "project module target file not found"
    end
    if code == 2125 do
        let extra_cstr = pass10_extra_cstr(extra)
        if extra_cstr != 0 do
            arena:
                var sb = sb_new()
                sb = sb_append(sb, "module resolution target not found: '")
                sb = sb_append(sb, extra_cstr)
                sb = sb_append(sb, "'")
                out sb_to_string(sb)
            end
        end
        out "module resolution target not found"
    end
    if code == 2126 do
        let extra_cstr = pass10_extra_cstr(extra)
        if extra_cstr != 0 do
            arena:
                var sb = sb_new()
                sb = sb_append(sb, "project module ID prefix collision: '")
                sb = sb_append(sb, extra_cstr)
                sb = sb_append(sb, "'")
                out sb_to_string(sb)
            end
        end
        out "project module ID prefix collision"
    end
    if code == 2201 do
        if (extra as i64) != 0 and fat_str_len(extra) > 0 do
            arena:
                var sb = sb_new()
                sb = sb_append(sb, "invalid UTF-8 in '")
                sb = sb_append(sb, extra)
                sb = sb_append(sb, "'")
                out sb_to_string(sb)
            end
        end
        out "invalid UTF-8 in source encoding"
    end
    out ""
end.

export pass10_code_to_prefix, pass10_code_to_result, pass10_code_to_phase, pass10_msg_frontend
