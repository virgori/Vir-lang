##
 * vir/compiler/semantic/diagnostics/modern.vri
 * ==============================================================
 * Terminal color detection, ANSI formatting, and modern UI diagnostic reporting.
 ##

include string_rt
include context
include cli_ui
include vec_rt

include rt.alloc
import vir_alloc, vir_free, alloc from rt.alloc

include rt.syscall
import sys_platform, Platform, sys_open, sys_read, sys_close, VIR_O_RDONLY from rt.syscall

extern func syscall3(num: int, a1: int, a2: int, a3: int) -> int

include sem_diag_session
include sem_diag_msg_frontend
include sem_diag_msg_semantic

func virc_isatty(fd: int):
    var buf = vir_alloc(128)
    let plat = sys_platform()
    var rc = 0 - 1
    if plat == Platform.Linux_x86_64 do
        rc = syscall3(16, fd, 0x5401, buf)
    eif plat == Platform.Linux_ARM64 or plat == Platform.Linux_RISCV64 do
        rc = syscall3(29, fd, 0x5401, buf)
    else
        rc = syscall3(0x2000036, fd, 0x40487413, buf)
    end
    vir_free(buf)
    if rc == 0 do out 1 end
    out 0
end.

func virc_has_no_color():
    let plat = sys_platform()
    if plat == Platform.Linux_ARM64 or plat == Platform.Linux_x86_64 or plat == Platform.Linux_RISCV64 do
        let fd = sys_open("/proc/self/environ" as int, VIR_O_RDONLY, 0)
        if fd >= 0 do
            let buf_size = 4096
            let buf = vir_alloc(buf_size)
            let n = sys_read(fd, buf, buf_size)
            sys_close(fd)
            if n > 0 do
                var i = 0
                when i + 8 < n loop
                    var at_start = 0
                    if i == 0 do
                        at_start = 1
                    eif native_read_u8(buf, i - 1) == 0 do
                        at_start = 1
                    end
                    if at_start == 1 do
                        if native_read_u8(buf, i) == 78 and native_read_u8(buf, i + 1) == 79 and native_read_u8(buf, i + 2) == 95 and native_read_u8(buf, i + 3) == 67 and native_read_u8(buf, i + 4) == 79 and native_read_u8(buf, i + 5) == 76 and native_read_u8(buf, i + 6) == 79 and native_read_u8(buf, i + 7) == 82 and native_read_u8(buf, i + 8) == 61 do
                            vir_free(buf)
                            out 1
                        end
                    end
                    i = i + 1
                end
            end
            vir_free(buf)
        end
        out 0
    end
    out 0
end.

func virc_should_color():
    if g_color_mode == 1 do out 1 end
    if g_color_mode == 2 do out 0 end
    if virc_has_no_color() == 1 do out 0 end
    if virc_isatty(1) == 1 do out 1 end
    out 0
end.

func pass10_color_red(sb: StringBuilder):
    sb = sb_append_char(sb, 27)
    sb = sb_append(sb, "[1;31m")
    out sb
end.

func pass10_color_yellow(sb: StringBuilder):
    sb = sb_append_char(sb, 27)
    sb = sb_append(sb, "[1;33m")
    out sb
end.

func pass10_color_bold(sb: StringBuilder):
    sb = sb_append_char(sb, 27)
    sb = sb_append(sb, "[1m")
    out sb
end.

func pass10_color_reset(sb: StringBuilder):
    sb = sb_append_char(sb, 27)
    sb = sb_append(sb, "[0m")
    out sb
end.

func pass10HumanLine(value: int):
    if g_ui_mode == 1 do
        cliUiLine(value)
    else
        print_ln(value)
    end
end.

# Untrusted diagnostic fields may not inject layout, even in detailed reports.
func pass10HumanValueLine(value: int):
    if g_ui_mode == 1 do
        var text = sb_new()
        text = cliUiAppendSafe(text, value, 0)
        cliUiLine(sb_to_string(text))
        sb_free(text)
    else
        print_ln(value)
    end
end.

func pass10AppendCode(builder: StringBuilder, level: int, code: int):
    var text = sb_append(builder, pass10_code_to_prefix(level))
    if code < 1000 do text = sb_append(text, "0") end
    if code < 100 do text = sb_append(text, "0") end
    if code < 10 do text = sb_append(text, "0") end
    out sb_append_int(text, code)
end.

# Severity is part of identity. Only ordinary errors select detailed/compact.
# Groups retain first occurrence order; all occurrences remain in collection order.
func pass10FindGroup(groups: int, level: int, code: int):
    var index = 0
    when index < vec_len_rt(groups) loop
        let group = vec_get_rt(groups, index)
        if native_read_i64(group, 0) == level do
            if native_read_i64(group, 8) == code do out group end
        end
        index = index + 1
    end
    out 0
end.

func pass10CollectGroups(records: int):
    var
        groups = vec_new_rt()
        index = 0
    when index < vec_len_rt(records) loop
        let
            item = vec_get_rt(records, index)
            level = native_read_i64(item, 0)
            code = native_read_i64(item, 8)
            found = pass10FindGroup(groups, level, code)
        if found == 0 do
            let group = vir_alloc(24)
            native_write_i64(group, 0, level)
            native_write_i64(group, 8, code)
            native_write_i64(group, 16, 1)
            groups = vec_push_rt(groups, group)
        else
            native_write_i64(found, 16, native_read_i64(found, 16) + 1)
        end
        index = index + 1
    end
    out groups
end.

func pass10CountGroups(groups: int, level: int, occurrences: int):
    var
        count = 0
        index = 0
    when index < vec_len_rt(groups) loop
        let group = vec_get_rt(groups, index)
        if native_read_i64(group, 0) == level do
            if occurrences == 1 do
                count = count + native_read_i64(group, 16)
            else
                count = count + 1
            end
        end
        index = index + 1
    end
    out count
end.

func pass10EmitModern(diag: &DiagnosticEngine):
    let
        count = vec_len_rt(diag.diagnostics)
        groups = pass10CollectGroups(diag.diagnostics)
        uniqueErrors = pass10CountGroups(groups, DiagnosticLevel.Error, 0)
        warnings = pass10CountGroups(groups, DiagnosticLevel.Warning, 1)
        notes = pass10CountGroups(groups, DiagnosticLevel.Info, 1)
    var index = 0
    if diag.error_count > 0 do cliUiFailurePhase() end
    if uniqueErrors >= 2 do
        var text = sb_new()
        text = sb_append(text, "Summary: ")
        index = 0
        when index < vec_len_rt(groups) loop
            let group = vec_get_rt(groups, index)
            if index > 0 do text = sb_append(text, " · ") end
            text = sb_append(text, "[")
            text = pass10AppendCode(text, native_read_i64(group, 0), native_read_i64(group, 8))
            text = sb_append(text, "] × ")
            text = sb_append_int(text, native_read_i64(group, 16))
            index = index + 1
        end
        cliUiLine(sb_to_string(text))
        sb_free(text)
    end
    index = 0
    when index < count loop
        let
            item = vec_get_rt(diag.diagnostics, index)
            level = native_read_i64(item, 0)
        if level == DiagnosticLevel.Error do
            if uniqueErrors == 1 do
                pass10_print_one_detailed(item as Diagnostic, 0)
            else
                pass10_print_one_compact(item as Diagnostic, 0)
            end
        else
            pass10_print_one_compact(item as Diagnostic, 0)
        end
        index = index + 1
    end
    var text = sb_new()
    text = sb_append_int(text, diag.error_count)
    text = sb_append(text, " errors · ")
    text = sb_append_int(text, warnings)
    text = sb_append(text, " warnings · ")
    text = sb_append_int(text, notes)
    text = sb_append(text, " notes")
    cliUiLine(sb_to_string(text))
    sb_free(text)
    if diag.error_count > 0 do cliUiBuildResult(diag.error_count) end
    index = 0
    when index < vec_len_rt(groups) loop
        vir_free(vec_get_rt(groups, index))
        index = index + 1
    end
    vec_free_rt(groups)
    out diag.error_count
end.

export virc_isatty, virc_has_no_color, virc_should_color,
       pass10_color_red, pass10_color_yellow, pass10_color_bold, pass10_color_reset,
       pass10HumanLine, pass10HumanValueLine, pass10AppendCode,
       pass10FindGroup, pass10CollectGroups, pass10CountGroups, pass10EmitModern
