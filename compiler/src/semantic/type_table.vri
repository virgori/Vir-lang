##
 * vir/compiler/type_table.vri
 * ==============================================================
 * Bảng quản lý kiểu dữ liệu (Type Table) cho compiler.
 ##

include vec_rt

include string_rt

enum TypeKind:
    Void    = 0,
    Int     = 1,
    Float   = 2,
    Bool    = 3,
    String  = 4,
    Entity  = 5,
    Enum    = 6,
    Array   = 7,
    Func    = 8,
    Pointer = 9,
    Dict     = 10,
    Tuple    = 11,
    Ref      = 12,
    MutRef   = 13,
    Register = 14,
    Mold     = 15,
    Packed   = 16,
    Flux     = 17,
    Deck     = 18,
    Optional = 19,
    Tensor   = 20,
    None     = 21,
    # Distinct type-state for compact quantized storage.  It must not silently
    # regain ordinary Tensor semantics (notably mutation or autodiff).
    QuantizedTensor = 22
end.
# Const IDs for primitive types (will be allocated first)
const TYPE_VOID:   0
const TYPE_INT:    1
const TYPE_FLOAT:  2
const TYPE_BOOL:   3
const TYPE_STRING: 4

entity TypeNode:
    kind: TypeKind,
    name_id: i64,       # InternID (0 if anonymous)
    size: i64,          # Size in bytes
    elem_type: i64,     # TypeID cho Array/Pointer
    return_type: i64,   # TypeID cho Func
    fields: i64         # Vec của Field/Param (các TypeID thành phần)
end.
entity TypeTable:
    nodes: i64          # vec của TypeNode
end.
func type_table_new()
    tbl = TypeTable (
        nodes: vec_new_rt()
    )

    # Khởi tạo các primitive types theo đúng thứ tự (Void = 0, Int = 1, Float = 2, Bool = 3, String = 4)
    tbl.nodes = vec_push_rt(tbl.nodes, TypeNode ( kind: TypeKind.Void, name_id: 0, size: 0, elem_type: 0, return_type: 0, fields: 0 ))
    tbl.nodes = vec_push_rt(tbl.nodes, TypeNode ( kind: TypeKind.Int, name_id: 0, size: 8, elem_type: 0, return_type: 0, fields: 0 ))
    tbl.nodes = vec_push_rt(tbl.nodes, TypeNode ( kind: TypeKind.Float, name_id: 0, size: 8, elem_type: 0, return_type: 0, fields: 0 ))
    tbl.nodes = vec_push_rt(tbl.nodes, TypeNode ( kind: TypeKind.Bool, name_id: 0, size: 1, elem_type: 0, return_type: 0, fields: 0 ))
    tbl.nodes = vec_push_rt(tbl.nodes, TypeNode ( kind: TypeKind.String, name_id: 0, size: 8, elem_type: 0, return_type: 0, fields: 0 ))

    out tbl
end.
func type_alloc(tbl: TypeTable, node: any):
    nodes = native_read_i64(tbl as i64, 0)
    id = vec_len_rt(nodes)
    nodes = vec_push_rt(nodes, node)
    native_write_i64(tbl as i64, 0, nodes)
    out id
end.
func type_get(tbl: TypeTable, id: i64):
    nodes = native_read_i64(tbl as i64, 0)
    out vec_get_rt(nodes, id)
end.
func type_is_numeric(kind: TypeKind):
    out kind == TypeKind.Int or kind == TypeKind.Float
end.
func type_is_integer(kind: TypeKind):
    out kind == TypeKind.Int
end.
func type_is_copy(kind: TypeKind):
    out kind == TypeKind.Int or kind == TypeKind.Float or kind == TypeKind.Bool or kind == TypeKind.Enum or kind == TypeKind.Register or kind == TypeKind.Mold or kind == TypeKind.Flux
end.
func type_is_move(kind: TypeKind):
    out kind == TypeKind.String or kind == TypeKind.Array or kind == TypeKind.Entity or kind == TypeKind.Dict or kind == TypeKind.Deck or kind == TypeKind.Tensor or kind == TypeKind.QuantizedTensor
end.
func type_is_tensor(kind: TypeKind) -> bool:
    out kind == TypeKind.Tensor
end.
func tensor_type_rank(node: TypeNode) -> int:
    out node.return_type
end.
func tensor_type_shape(node: TypeNode) -> int:
    out node.fields
end.
func tensor_type_elem_type(node: TypeNode) -> int:
    out node.elem_type
end.
func tensor_type_dim(node: TypeNode, idx: int) -> int:
    out vec_get_rt(node.fields, idx)
end.
func tensor_type_stride(node: TypeNode, idx: int) -> int:
    var stride = 1
    var k = idx + 1
    let rank = node.return_type
    let shape = node.fields
    when k < rank loop
        stride = stride * (vec_get_rt(shape, k) as int)
        k = k + 1
    end
    out stride
end.
func tensor_type_numel(node: TypeNode) -> int:
    let rank = node.return_type
    if rank == 0 do
        out 0
    end
    let shape = node.fields
    var total = 1
    var k = 0
    when k < rank loop
        total = total * (vec_get_rt(shape, k) as int)
        k = k + 1
    end
    out total
end.
func tensor_type_new(tbl: TypeTable, elem_type_id: int, shape_vec: int) -> int:
    let rank = vec_len_rt(shape_vec)
    var numel = 1
    var k = 0
    when k < rank loop
        numel = numel * (vec_get_rt(shape_vec, k) as int)
        k = k + 1
    end
    let node = TypeNode (
        kind: TypeKind.Tensor,
        name_id: 0,
        size: 16 + numel * 8,
        elem_type: elem_type_id,
        return_type: rank,
        fields: shape_vec
    )
    out type_alloc(tbl, node)
end.
func type_can_binop(a: TypeKind, b: TypeKind, op: int):
    # op: 0=Add, 1=Sub, 2=Mul, 3=Div, 4=Mod, 5=Eq, 6=Ne, 7=Lt, 8=Le, 9=Gt, 10=Ge
    # String only supports Add (concat) and Eq/Ne
    if a == TypeKind.String or b == TypeKind.String do
        if a != b do
            out false
        end
        out op == 0 or op == 5 or op == 6
    end
    # Bool only supports Eq/Ne and logic (And/Or)
    if a == TypeKind.Bool or b == TypeKind.Bool do
        if a != b do
            out false
        end
        out op >= 5
    end
    # Numeric types can do everything
    if type_is_numeric(a) and type_is_numeric(b) do
        out true
    end
    if a == TypeKind.Flux and b == TypeKind.Flux do
        out true
    end
    out false
end.
func type_common(a: TypeKind, b: TypeKind):
    # Return the common type for implicit promotion
    if a == b do
        out a
    end
    # int + float -> float
    if type_is_numeric(a) and type_is_numeric(b) do
        out TypeKind.Float
    end
    out TypeKind.Void # incompatible
end.

func is_tensor_type_str(name: int) -> bool:
    if (name as i64) < 4096 do out false end
    let n_len = fat_str_len(name as int)
    if n_len < 6 do out false end
    let c0 = fat_str_byte_at(name as int, 0)
    let c1 = fat_str_byte_at(name as int, 1)
    let c2 = fat_str_byte_at(name as int, 2)
    let c3 = fat_str_byte_at(name as int, 3)
    let c4 = fat_str_byte_at(name as int, 4)
    let c5 = fat_str_byte_at(name as int, 5)
    out c0 == 116 and c1 == 101 and c2 == 110 and c3 == 115 and c4 == 111 and c5 == 114
end.
func parse_tensor_elem_code(type_str: int) -> int:
    let n = fat_str_len(type_str as int)
    if n < 8 do out 0 end
    var i = 6
    when i < n and fat_str_byte_at(type_str as int, i) == 32 loop
        i = i + 1
    end
    if i >= n or fat_str_byte_at(type_str as int, i) != 91 do
        out 0
    end
    let lbracket_pos = i
    var semi_pos = 0 - 1
    i = lbracket_pos + 1
    when i < n loop
        let b = fat_str_byte_at(type_str as int, i)
        if b == 59 do
            semi_pos = i
            i = n
        eif b == 93 do
            i = n
        else
            i = i + 1
        end
    end
    if semi_pos < 0 do out 0 end
    var start = lbracket_pos + 1
    when start < semi_pos and fat_str_byte_at(type_str as int, start) == 32 loop
        start = start + 1
    end
    var end_p = semi_pos
    when end_p > start and fat_str_byte_at(type_str as int, end_p - 1) == 32 loop
        end_p = end_p - 1
    end
    let width = end_p - start
    let a = fat_str_byte_at(type_str as int, start)
    var b = 0
    if width >= 2 do b = fat_str_byte_at(type_str as int, start + 1) end
    var c = 0
    if width == 3 do c = fat_str_byte_at(type_str as int, start + 2) end
    if width == 3 and a == 102 and b == 51 and c == 50 do out 1 end
    if width == 3 and a == 102 and b == 49 and c == 54 do out 2 end
    if width == 2 and a == 105 and b == 56 do out 3 end
    if width == 2 and a == 117 and b == 56 do out 4 end
    if width == 3 and a == 105 and b == 51 and c == 50 do out 5 end
    if width == 3 and a == 105 and b == 110 and c == 116 do out 6 end
    if width == 3 and a == 105 and b == 54 and c == 52 do out 6 end
    if width == 3 and a == 102 and b == 54 and c == 52 do out 7 end
    out 0
end.

func tensor_type_is_well_formed(type_str: int) -> bool:
    let n = fat_str_len(type_str as int)
    if parse_tensor_elem_code(type_str) == 0 do out false end
    var semi_pos = 0 - 1
    var i = 0
    when i < n loop
        let b = fat_str_byte_at(type_str as int, i)
        if b == 59 do
            semi_pos = i
            i = n
        else
            i = i + 1
        end
    end
    if semi_pos < 0 do out false end
    i = semi_pos + 1
    var rank = 0
    var total = 1
    var dim = 0
    var digits = 0
    when i < n loop
        let ch = fat_str_byte_at(type_str as int, i)
        if ch >= 48 and ch <= 57 do
            if dim > 26843545 do out false end
            dim = dim * 10 + ch - 48
            digits = digits + 1
        eif ch == 44 or ch == 93 do
            if digits == 0 or dim <= 0 do out false end
            if total > 268435456 / dim do out false end
            total = total * dim
            rank = rank + 1
            dim = 0
            digits = 0
            if ch == 93 do
                var rem = i + 1
                when rem < n and fat_str_byte_at(type_str as int, rem) == 32 loop
                    rem = rem + 1
                end
                out rank > 0 and rem == n
            end
        eif ch == 32 do
            # Allow whitespace inside dimensions
        else
            out false
        end
        i = i + 1
    end
    out false
end.

func parse_tensor_elem_type(type_str: &string) -> TypeKind:
    let elem = parse_tensor_elem_code(type_str as int)
    if elem == 1 or elem == 2 or elem == 7 do
        out TypeKind.Float
    end
    out TypeKind.Int
end.
func parse_tensor_shape(type_str: string) -> int:
    var vec = vec_new_rt()
    let n_len = fat_str_len(type_str as int)
    if n_len == 0 do out vec end
    var semi_pos = 0 - 1
    var i = 0
    when i < n_len loop
        let b = fat_str_byte_at(type_str as int, i)
        if b == 59 do
            semi_pos = i
            i = n_len
        else
            i = i + 1
        end
    end
    if semi_pos < 0 do out vec end
    i = semi_pos + 1
    var cur_num = 0
    var in_num = false
    when i < n_len loop
        let c = fat_str_byte_at(type_str as int, i)
        if c == 93 do
            if in_num do
                vec = vec_push_rt(vec, cur_num)
                cur_num = 0
                in_num = false
            end
            i = n_len
        eif c >= 48 and c <= 57 do
            cur_num = cur_num * 10 + (c - 48)
            in_num = true
        eif c == 44 do
            if in_num do
                vec = vec_push_rt(vec, cur_num)
                cur_num = 0
                in_num = false
            end
        end
        i = i + 1
    end
    out vec
end.
func parse_tensor_rank(type_str: &string) -> int:
    let vec = parse_tensor_shape(type_str)
    out vec_len_rt(vec)
end.
func parse_tensor_stride(type_str: string, idx: int) -> int:
    let vec = parse_tensor_shape(type_str)
    let n = vec_len_rt(vec)
    var stride = 1
    var k = idx + 1
    when k < n loop
        stride = stride * (vec_get_rt(vec, k) as int)
        k = k + 1
    end
    out stride
end.
func parse_tensor_numel(type_str: string) -> int:
    let vec = parse_tensor_shape(type_str)
    let n = vec_len_rt(vec)
    if n == 0 do out 0 end
    var total = 1
    var k = 0
    when k < n loop
        total = total * (vec_get_rt(vec, k) as int)
        k = k + 1
    end
    out total
end.

func tensor_elem_byte_size(type_str: string) -> int:
    let elem_code = parse_tensor_elem_code(type_str)
    if elem_code == 1 or elem_code == 5 do out 4 end
    if elem_code == 2 do out 2 end
    if elem_code == 3 or elem_code == 4 do out 1 end
    out 8
end.

func is_flux_type_str(name: int) -> bool:
    if (name as i64) < 4096 do out false end
    let n_len = fat_str_len(name as int)
    if n_len < 4 do out false end
    let c0 = fat_str_byte_at(name as int, 0)
    let c1 = fat_str_byte_at(name as int, 1)
    let c2 = fat_str_byte_at(name as int, 2)
    let c3 = fat_str_byte_at(name as int, 3)
    if c0 == 102 and c1 == 108 and c2 == 117 and c3 == 120 do
        if n_len == 4 do out true end
        let c4 = fat_str_byte_at(name as int, 4)
        if c4 == 60 or c4 == 32 or c4 == 40 do out true end
    end
    out false
end.

func parse_flux_lanes(type_str: int) -> int:
    if (type_str as i64) < 4096 do out -1 end
    let n_len = fat_str_len(type_str as int)
    if n_len < 6 do out -1 end
    var comma_pos = 0 - 1
    var i = 0
    when i < n_len loop
        let c = fat_str_byte_at(type_str as int, i)
        if c == 44 do
            comma_pos = i
        end
        i = i + 1
    end
    if comma_pos < 0 do out -1 end
    var lanes = 0
    var k = comma_pos + 1
    var has_digit = false
    when k < n_len loop
        let ch = fat_str_byte_at(type_str as int, k)
        if ch >= 48 and ch <= 57 do
            lanes = lanes * 10 + (ch - 48)
            has_digit = true
        eif ch == 62 or ch == 41 do
            k = n_len
        end
        k = k + 1
    end
    if not has_digit or lanes <= 0 do out -1 end
    out lanes
end.

func parse_flux_elem_type(type_str: int) -> TypeKind:
    if (type_str as i64) < 4096 do out TypeKind.Int end
    let n_len = fat_str_len(type_str as int)
    if n_len < 6 do out TypeKind.Int end
    var i = 0
    var in_elem = false
    var has_f = false
    when i < n_len loop
        let c = fat_str_byte_at(type_str as int, i)
        if c == 60 or c == 40 do
            in_elem = true
        eif in_elem do
            if c == 102 or c == 70 do
                has_f = true
            end
            if c == 44 or c == 62 or c == 41 do
                i = n_len
            end
        end
        i = i + 1
    end
    if has_f do out TypeKind.Float end
    out TypeKind.Int
end.

func flux_is_power_of_two(n: int) -> bool:
    if n <= 0 do out false end
    out (n and (n - 1)) == 0
end.

func swizzle_char_to_lane(c: int) -> int:
    if c == 120 or c == 114 do out 0 end
    if c == 121 or c == 103 do out 1 end
    if c == 122 or c == 98 do out 2 end
    if c == 119 or c == 97 do out 3 end
    out 0 - 1
end.

const
    Q_CODEC_NONE: 0
    Q_CODEC_UNIFORM: 1
    Q_CODEC_Q8_0: 2

func is_quantized_type_str(name: int) -> bool:
    if (name as i64) < 4096 do out false end
    let n_len = fat_str_len(name as int)
    if n_len < 10 do
        if n_len == 15 and fat_cstr_eq(name as string, "QuantizedTensor") == 1 do
            out true
        end
        out false
    end
    let c0 = fat_str_byte_at(name as int, 0)
    let c1 = fat_str_byte_at(name as int, 1)
    let c2 = fat_str_byte_at(name as int, 2)
    let c3 = fat_str_byte_at(name as int, 3)
    let c4 = fat_str_byte_at(name as int, 4)
    let c5 = fat_str_byte_at(name as int, 5)
    let c6 = fat_str_byte_at(name as int, 6)
    let c7 = fat_str_byte_at(name as int, 7)
    let c8 = fat_str_byte_at(name as int, 8)
    let c9 = fat_str_byte_at(name as int, 9)
    if c0 == 113 and c1 == 117 and c2 == 97 and c3 == 110 and c4 == 116 and c5 == 105 and c6 == 122 and c7 == 101 and c8 == 100 and c9 == 91 do
        out true
    end
    if n_len == 15 and fat_cstr_eq(name as string, "QuantizedTensor") == 1 do
        out true
    end
    out false
end.

func is_q80_view_type_str(name: int) -> bool:
    if (name as i64) < 4096 do out false end
    if fat_cstr_eq(name as string, "Q80TensorView") == 1 do out true end
    out false
end.

func parse_quantized_codec(type_str: int) -> int:
    if is_quantized_type_str(type_str) == false do
        if is_q80_view_type_str(type_str) do out Q_CODEC_Q8_0 end
        out Q_CODEC_NONE
    end
    let n = fat_str_len(type_str as int)
    if n < 14 do
        out Q_CODEC_UNIFORM
    end
    let c10 = fat_str_byte_at(type_str as int, 10)
    let c11 = fat_str_byte_at(type_str as int, 11)
    let c12 = fat_str_byte_at(type_str as int, 12)
    let c13 = fat_str_byte_at(type_str as int, 13)
    if c10 == 113 and c11 == 56 and c12 == 95 and c13 == 48 do
        out Q_CODEC_Q8_0
    end
    out Q_CODEC_UNIFORM
end.

func parse_quantized_shape(type_str: int) -> int:
    var vec = vec_new_rt()
    if (type_str as i64) < 4096 do out vec end
    let n = fat_str_len(type_str as int)
    if n < 12 do out vec end
    let codec = parse_quantized_codec(type_str)
    var start_idx = 0 - 1
    var end_idx = 0 - 1
    if codec == Q_CODEC_Q8_0 do
        var i = 0
        when i + 6 <= n loop
            let s0 = fat_str_byte_at(type_str as int, i)
            let s1 = fat_str_byte_at(type_str as int, i + 1)
            let s2 = fat_str_byte_at(type_str as int, i + 2)
            let s3 = fat_str_byte_at(type_str as int, i + 3)
            let s4 = fat_str_byte_at(type_str as int, i + 4)
            let s5 = fat_str_byte_at(type_str as int, i + 5)
            if s0 == 115 and s1 == 104 and s2 == 97 and s3 == 112 and s4 == 101 and s5 == 61 do
                start_idx = i + 6
                i = n
            else
                i = i + 1
            end
        end
        if start_idx >= 0 do
            var j = start_idx
            when j < n loop
                let b = fat_str_byte_at(type_str as int, j)
                if b == 59 or b == 93 do
                    end_idx = j
                    j = n
                else
                    j = j + 1
                end
            end
        end
    else
        var last_semi = 0 - 1
        var rbracket = 0 - 1
        var i = 0
        when i < n loop
            let b = fat_str_byte_at(type_str as int, i)
            if b == 59 do last_semi = i end
            if b == 93 do rbracket = i end
            i = i + 1
        end
        if last_semi >= 0 and rbracket > last_semi do
            start_idx = last_semi + 1
            end_idx = rbracket
        end
    end
    if start_idx < 0 or end_idx <= start_idx do out vec end
    var cur_num = 0
    var in_num = false
    var k = start_idx
    when k < end_idx loop
        let c = fat_str_byte_at(type_str as int, k)
        if c >= 48 and c <= 57 do
            cur_num = cur_num * 10 + (c - 48)
            in_num = true
        eif c == 44 or c == 59 or c == 93 or c == 32 do
            if in_num and (c == 44 or c == 59 or c == 93) do
                vec = vec_push_rt(vec, cur_num)
                cur_num = 0
                in_num = false
            end
        end
        k = k + 1
    end
    if in_num do
        vec = vec_push_rt(vec, cur_num)
    end
    out vec
end.

func parse_quantized_rank(type_str: int) -> int:
    let shape = parse_quantized_shape(type_str)
    out vec_len_rt(shape)
end.

func parse_quantized_elem_type(type_str: int) -> TypeKind:
    if (type_str as i64) < 4096 do out TypeKind.Float end
    let n = fat_str_len(type_str as int)
    var i = 0
    when i + 3 <= n loop
        let b0 = fat_str_byte_at(type_str as int, i)
        let b1 = fat_str_byte_at(type_str as int, i + 1)
        let b2 = fat_str_byte_at(type_str as int, i + 2)
        if b0 == 102 and b1 == 51 and b2 == 50 do out TypeKind.Float end
        if b0 == 102 and b1 == 54 and b2 == 52 do out TypeKind.Float end
        if b0 == 102 and b1 == 49 and b2 == 54 do out TypeKind.Float end
        if b0 == 105 and b1 == 110 and b2 == 116 do out TypeKind.Int end
        i = i + 1
    end
    out TypeKind.Float
end.

func parse_quantized_bits(type_str: int) -> int:
    if (type_str as i64) < 4096 do out 8 end
    let codec = parse_quantized_codec(type_str)
    if codec == Q_CODEC_Q8_0 do out 8 end
    let n = fat_str_len(type_str as int)
    var i = 0
    when i + 5 <= n loop
        let b0 = fat_str_byte_at(type_str as int, i)
        let b1 = fat_str_byte_at(type_str as int, i + 1)
        let b2 = fat_str_byte_at(type_str as int, i + 2)
        let b3 = fat_str_byte_at(type_str as int, i + 3)
        let b4 = fat_str_byte_at(type_str as int, i + 4)
        if b0 == 98 and b1 == 105 and b2 == 116 and b3 == 115 and b4 == 61 do
            var bits = 0
            var j = i + 5
            when j < n loop
                let ch = fat_str_byte_at(type_str as int, j)
                if ch >= 48 and ch <= 57 do
                    bits = bits * 10 + (ch - 48)
                    j = j + 1
                else
                    j = n
                end
            end
            if bits > 0 do out bits end
            i = n
        else
            i = i + 1
        end
    end
    out 8
end.

func parse_quantized_block_elements(type_str: int) -> int:
    if parse_quantized_codec(type_str) == Q_CODEC_Q8_0 do out 32 end
    out 1
end.

func parse_quantized_block_bytes(type_str: int) -> int:
    if parse_quantized_codec(type_str) == Q_CODEC_Q8_0 do out 40 end
    let bits = parse_quantized_bits(type_str)
    if bits >= 8 do out bits / 8 end
    out 1
end.

func parse_quantized_stride_bytes(type_str: int) -> int:
    if (type_str as i64) < 4096 do out 0 end
    let n = fat_str_len(type_str as int)
    var i = 0
    when i + 7 <= n loop
        let s0 = fat_str_byte_at(type_str as int, i)
        let s1 = fat_str_byte_at(type_str as int, i + 1)
        let s2 = fat_str_byte_at(type_str as int, i + 2)
        let s3 = fat_str_byte_at(type_str as int, i + 3)
        let s4 = fat_str_byte_at(type_str as int, i + 4)
        let s5 = fat_str_byte_at(type_str as int, i + 5)
        let s6 = fat_str_byte_at(type_str as int, i + 6)
        if s0 == 115 and s1 == 116 and s2 == 114 and s3 == 105 and s4 == 100 and s5 == 101 and s6 == 61 do
            var stride = 0
            var j = i + 7
            when j < n loop
                let ch = fat_str_byte_at(type_str as int, j)
                if ch >= 48 and ch <= 57 do
                    stride = stride * 10 + (ch - 48)
                    j = j + 1
                else
                    j = n
                end
            end
            if stride > 0 do out stride end
            i = n
        else
            i = i + 1
        end
    end
    let shape = parse_quantized_shape(type_str)
    if vec_len_rt(shape) >= 2 do
        let cols = vec_get_rt(shape, 1) as int
        if parse_quantized_codec(type_str) == Q_CODEC_Q8_0 do
            out (cols / 32) * 40
        end
    end
    out 0
end.

func parse_quantized_alignment(type_str: int) -> int:
    if (type_str as i64) < 4096 do out 8 end
    let n = fat_str_len(type_str as int)
    var i = 0
    when i + 6 <= n loop
        let a0 = fat_str_byte_at(type_str as int, i)
        let a1 = fat_str_byte_at(type_str as int, i + 1)
        let a2 = fat_str_byte_at(type_str as int, i + 2)
        let a3 = fat_str_byte_at(type_str as int, i + 3)
        let a4 = fat_str_byte_at(type_str as int, i + 4)
        let a5 = fat_str_byte_at(type_str as int, i + 5)
        if a0 == 97 and a1 == 108 and a2 == 105 and a3 == 103 and a4 == 110 and a5 == 61 do
            var align_val = 0
            var j = i + 6
            when j < n loop
                let ch = fat_str_byte_at(type_str as int, j)
                if ch >= 48 and ch <= 57 do
                    align_val = align_val * 10 + (ch - 48)
                    j = j + 1
                else
                    j = n
                end
            end
            if align_val > 0 do out align_val end
            i = n
        else
            i = i + 1
        end
    end
    if parse_quantized_codec(type_str) == Q_CODEC_Q8_0 do out 8 end
    out 16
end.

func parse_quantized_read_only(type_str: int) -> bool:
    out true
end.

func parse_quantized_ownership_kind(type_str: int) -> int:
    if parse_quantized_codec(type_str) == Q_CODEC_Q8_0 do out 0 end
    out 1
end.

func parse_quantized_has_lifetime(type_str: int) -> bool:
    if parse_quantized_codec(type_str) == Q_CODEC_Q8_0 do out true end
    out false
end.

func format_quantized_uniform_type(elem_code: int, bits: int, shape_vec: int) -> string:
    var res = fat_str_new("quantized[uniform; ")
    if elem_code == 1 or elem_code == 2 do
        res = fat_str_concat(res, fat_str_new("f32; bits="))
    eif elem_code == 7 do
        res = fat_str_concat(res, fat_str_new("f64; bits="))
    else
        res = fat_str_concat(res, fat_str_new("float; bits="))
    end
    res = fat_str_concat(res, str_from_cstr(rt_itoa(bits) as int))
    res = fat_str_concat(res, fat_str_new("; "))
    let r = vec_len_rt(shape_vec)
    var k = 0
    when k < r loop
        let d = vec_get_rt(shape_vec, k) as int
        res = fat_str_concat(res, str_from_cstr(rt_itoa(d) as int))
        if k + 1 < r do
            res = fat_str_concat(res, fat_str_new(", "))
        end
        k = k + 1
    end
    res = fat_str_concat(res, fat_str_new("]"))
    out res
end.

func format_quantized_q80_type(rows: int, cols: int, stride_bytes: int, align_bytes: int) -> string:
    var res = fat_str_new("quantized[q8_0; elem=f64; shape=")
    res = fat_str_concat(res, str_from_cstr(rt_itoa(rows) as int))
    res = fat_str_concat(res, fat_str_new(", "))
    res = fat_str_concat(res, str_from_cstr(rt_itoa(cols) as int))
    res = fat_str_concat(res, fat_str_new("; block=40; stride="))
    res = fat_str_concat(res, str_from_cstr(rt_itoa(stride_bytes) as int))
    res = fat_str_concat(res, fat_str_new("; align="))
    res = fat_str_concat(res, str_from_cstr(rt_itoa(align_bytes) as int))
    res = fat_str_concat(res, fat_str_new("; ro=1; own=borrowed; life=1]"))
    out res
end.

