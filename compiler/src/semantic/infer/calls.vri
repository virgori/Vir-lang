##
 * compiler/src/semantic/infer/calls.vri — Function Call & Tuple Binder Inference
 * ==============================================================================
 * VIRC-PLN-0004 & Phase 5: Type Inference Decomposition.
 *
 * Implements return type inference for function/method calls and
 * destructuring binder inference for tuple expressions.
 ##

include rt_vec_rt
include rt_string_rt
include parser
include symbol_table
include scope_tree
include type_table
include infer_context

func pass5_call_returns_first_arg(name: i64):
    if fat_cstr_eq(name, "ast_add_child") == 1 do out 1 end
    if fat_cstr_eq(name, "vec_push_rt") == 1 do out 1 end
    if fat_cstr_eq(name, "vec_set_rt") == 1 do out 1 end
    if fat_cstr_eq(name, "vec_push") == 1 do out 1 end
    if fat_cstr_eq(name, "ast_vec_push") == 1 do out 1 end
    if fat_cstr_eq(name, "ast_vec_bump_new") == 1 do out 1 end
    if fat_cstr_eq(name, "codebuf_emit_byte") == 1 do out 1 end
    if fat_cstr_eq(name, "codebuf_emit_u32") == 1 do out 1 end
    if fat_cstr_eq(name, "codebuf_emit_u64") == 1 do out 1 end
    if fat_cstr_eq(name, "codebuf_emit_i32") == 1 do out 1 end
    if fat_cstr_eq(name, "buf_write_u8") == 1 do out 1 end
    if fat_cstr_eq(name, "buf_align") == 1 do out 1 end
    if fat_cstr_eq(name, "bvec_push") == 1 do out 1 end
    if fat_cstr_eq(name, "text_splice_at") == 1 do out 1 end
    out 0
end.

func pass5_infer_call_return(ref symbols: SymbolTable, ref scopes: ScopeTree, node: &AstNode):
    if node.node_type != AstType.Call and node.node_type != AstType.MethodCall do
        out TypeKind.Void
    end
    found = pass5_lookup(symbols, scopes, scope_current_id(scopes), node.name)
    if found != -1 do
        # Read SymbolTable through its physical layout. Native self-host field
        # lowering can confuse the nested `symbols.symbols` access with a
        # same-named field from another entity and load offset 16.
        call_syms = native_read_i64(symbols as i64, 0)
        sym = vec_get_rt(call_syms, found)
        if (sym as i64) != 0 do
            if sym.return_type != 0 do
                out sym.return_type as TypeKind
            end
        end
    end
    if pass5_call_returns_first_arg(node.name as i64) == 1 do
        child_count = vec_len_rt(node.children)
        if child_count > 0 do
            arg0 = vec_get_rt(node.children, 0)
            arg0_ty = pass5_infer_expr(symbols, scopes, arg0)
            if arg0_ty != TypeKind.Void do
                out arg0_ty
            end
        end
    end
    out TypeKind.Int
end.

func pass5_tuple_binder_type(ref symbols: SymbolTable, ref scopes: ScopeTree, init: &AstNode, index: int):
    if init.node_type == AstType.TupleExpr do
        child_count = vec_len_rt(init.children)
        if index < child_count do
            elem = vec_get_rt(init.children, index)
            out pass5_infer_expr(symbols, scopes, elem)
        end
        out TypeKind.Int
    end
    if init.node_type == AstType.Call or init.node_type == AstType.MethodCall do
        let fn_ast = pass5_find_func_ast(symbols, init.name)
        if (fn_ast as i64) != 0 do
            let fn_children = vec_len_rt(fn_ast.children)
            if fn_children > 0 do
                let body = vec_get_rt(fn_ast.children, fn_children - 1) as AstNode
                if (body as i64) != 0 do
                    if body.node_type == AstType.Block do
                        var bi = 0
                        let b_count = vec_len_rt(body.children)
                        when bi < b_count loop
                            let bch = vec_get_rt(body.children, bi) as AstNode
                            if (bch as i64) != 0 do
                                if bch.node_type == AstType.ReturnStmt and vec_len_rt(bch.children) > 0 do
                                    let ret_expr = vec_get_rt(bch.children, 0) as AstNode
                                    if (ret_expr as i64) != 0 do
                                        if ret_expr.node_type == AstType.TupleExpr and index < vec_len_rt(ret_expr.children) do
                                            out pass5_infer_expr(symbols, scopes, vec_get_rt(ret_expr.children, index) as AstNode)
                                        end
                                    end
                                end
                            end
                            bi = bi + 1
                        end
                    end
                end
            end
        end
        if index == 0 do
            child_count = vec_len_rt(init.children)
            if child_count > 0 do
                arg0 = vec_get_rt(init.children, 0)
                arg0_ty = pass5_infer_expr(symbols, scopes, arg0)
                if arg0_ty != TypeKind.Void do
                    out arg0_ty
                end
            end
            out TypeKind.Entity
        end
        nm = init.name as i64
        if fat_cstr_eq(nm, "lex_advance") == 1 do
            out TypeKind.Int
        end
        if fat_cstr_eq(nm, "expect_tok") == 1 do
            if index == 2 do
                out TypeKind.Bool
            end
            out TypeKind.Entity
        end
        out TypeKind.Entity
    end
    out TypeKind.Int
end.
