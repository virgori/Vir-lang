##
 * compiler/src/semantic/infer/context.vri — Type Inference Context & Scope Indexing
 * =================================================================================
 * VIRC-PLN-0004 & Phase 5: Type Inference Decomposition.
 *
 * Owns Pass 5 global symbol index buckets, hash lookup algorithms,
 * scope chain lookups, and local symbol registration.
 ##

include vec_rt
include string_rt
include parser
include symbol_table
include scope_tree
include type_table

# Hash ONLY global scope (id 0). Prior passes leave thousands of orphan
# Func/Block ScopeNodes in scopes.scopes; allocating 256 buckets per id
# made rebuild O(scopes×256) vec_new — the real pass-5 hang.
const PASS5_BUCKETS: int = 256
var g_pass5_global_buckets: i64 = 0

func pass5_hash_name(name: &string):
    n = fat_str_len(name)
    if n <= 0 do
        out 0
    end
    # Mix pointer + length — avoids O(len) byte reads on every lookup.
    h = (name as i64) * 131 + n * 17
    if h < 0 do
        h = 0 - h
    end
    out h mod PASS5_BUCKETS
end.

func pass5_global_map_new():
    buckets = vec_new_rt()
    var bi = 0
    when bi < PASS5_BUCKETS loop
        buckets = vec_push_rt(buckets, vec_new_rt())
        bi = bi + 1
    end
    out buckets
end.

func pass5_index_global(name: &string, sym_id: int):
    if fat_str_len(name) == 0 do
        out 0
    end
    if g_pass5_global_buckets == 0 do
        g_pass5_global_buckets = pass5_global_map_new()
    end
    bid = pass5_hash_name(name)
    bucket = vec_get_rt(g_pass5_global_buckets, bid)
    bucket = vec_push_rt(bucket, sym_id)
    vec_set_rt(g_pass5_global_buckets, bid, bucket)
    out 0
end.

func pass5_rebuild_index(ref symbols: SymbolTable, ref scopes: ScopeTree):
    g_pass5_global_buckets = pass5_global_map_new()
    scopes_vec = native_read_i64(scopes as i64, 0)
    syms_vec = native_read_i64(symbols as i64, 0)
    if vec_len_rt(scopes_vec) == 0 do
        out 0
    end
    # Scope 0 only — holds builtins + top-level decls (the O(n²) hotspot).
    scope_node = vec_get_rt(scopes_vec, 0)
    sym_list = native_read_i64(scope_node as i64, 16)
    count = vec_len_rt(sym_list)
    var i = 0
    when i < count loop
        sym_id = vec_get_rt(sym_list, i)
        sym = vec_get_rt(syms_vec, sym_id)
        sym_name = native_read_i64(sym as i64, 8) as string
        pass5_index_global(sym_name, sym_id)
        i = i + 1
    end
end.

func pass5_find_func_ast(ref symbols: SymbolTable, name: &string):
    let sym_id = pass5_lookup_global(symbols, name)
    if sym_id < 0 do out 0 as AstNode end
    let syms_vec = native_read_i64(symbols as i64, 0)
    let sym = vec_get_rt(syms_vec, sym_id) as SymbolNode
    if (sym as i64) == 0 do out 0 as AstNode end
    out sym.ast_id as AstNode
end.

func pass5_lookup_global(ref symbols: SymbolTable, name: &string):
    if g_pass5_global_buckets == 0 do
        out -1
    end
    bid = pass5_hash_name(name)
    bucket = vec_get_rt(g_pass5_global_buckets, bid)
    count = vec_len_rt(bucket)
    syms_vec = native_read_i64(symbols as i64, 0)
    name_ptr = name as i64
    var i = 0
    when i < count loop
        sym_id = vec_get_rt(bucket, i)
        sym = vec_get_rt(syms_vec, sym_id)
        sym_name_ptr = native_read_i64(sym as i64, 8)
        # Pointer identity first (same AST / register handle).
        if sym_name_ptr == name_ptr do
            out sym_id
        end
        if fat_str_eq(sym_name_ptr as string, name) == 1 do
            out sym_id
        end
        i = i + 1
    end
    out -1
end.

func pass5_lookup_scope_linear(ref symbols: SymbolTable, ref scopes: ScopeTree, scope_id: int, name: &string):
    if scope_id <= 0 do
        out -1
    end
    scopes_vec = native_read_i64(scopes as i64, 0)
    if scope_id >= vec_len_rt(scopes_vec) do
        out -1
    end
    scope_node = vec_get_rt(scopes_vec, scope_id)
    sym_list = native_read_i64(scope_node as i64, 16)
    count = vec_len_rt(sym_list)
    if count == 0 do
        out -1
    end
    syms_vec = native_read_i64(symbols as i64, 0)
    name_ptr = name as i64
    var i = 0
    when i < count loop
        sym_id = vec_get_rt(sym_list, i)
        sym = vec_get_rt(syms_vec, sym_id)
        sym_name_ptr = native_read_i64(sym as i64, 8)
        if sym_name_ptr == name_ptr do
            out sym_id
        end
        if fat_str_eq(sym_name_ptr as string, name) == 1 do
            out sym_id
        end
        i = i + 1
    end
    out -1
end.

func pass5_lookup(ref symbols: SymbolTable, ref scopes: ScopeTree, start_scope: int, name: &string):
    if fat_str_len(name) == 0 do
        out -1
    end
    # Inner scopes shadow globals (match pass 3 name resolution).
    curr = start_scope
    scopes_vec = native_read_i64(scopes as i64, 0)
    when curr >= 0 loop
        if curr == 0 do
            out pass5_lookup_global(symbols, name)
        end
        found2 = pass5_lookup_scope_linear(symbols, scopes, curr, name)
        if found2 != -1 do
            out found2
        end
        scope_node = vec_get_rt(scopes_vec, curr)
        curr = native_read_i64(scope_node as i64, 8)
    end
    out -1
end.

func pass5_register_local(ref symbols: SymbolTable, ref scopes: ScopeTree, name: &string, ty: TypeKind):
    if fat_str_len(name) == 0 do
        out 0
    end
    curr = scope_current_id(scopes)
    found = pass5_lookup(symbols, scopes, curr, name)
    if found != -1 do
        local_syms = native_read_i64(symbols as i64, 0)
        sym = vec_get_rt(local_syms, found)
        if sym.type_id == 0 and ty != TypeKind.Void do
            native_write_i64(sym as i64, 16, ty as i64)
        end
        out found
    end
    sym = SymbolNode (
        kind: SymbolKind.Variable,
        name_id: name as i64,
        type_id: ty as i64,
        scope_id: curr,
        ast_id: 0,
        is_mutable: true,
        offset: 0,
        param_count: 0,
        return_type: 0,
        parent_id: -1
    )
    sym_id = symbol_alloc(symbols, sym)
    scope_add_symbol(scopes, curr, sym_id)
    if curr == 0 do
        pass5_index_global(name, sym_id)
    end
    out sym_id
end.
