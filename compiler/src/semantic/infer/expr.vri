##
 * compiler/src/semantic/infer/expr.vri — Expression Type Inference
 * ===============================================================
 * VIRC-PLN-0004 & Phase 5: Type Inference Decomposition.
 *
 * Implements bottom-up expression type inference for literals, binary operators,
 * calls, comparisons, collections, and address-of operations.
 ##

include rt_vec_rt
include rt_string_rt
include parser
include symbol_table
include scope_tree
include type_table
include infer_context
include infer_calls

func pass5_infer_expr(ref symbols: SymbolTable, ref scopes: ScopeTree, node: &AstNode):
    if node.node_type == AstType.LiteralInt do
        out TypeKind.Int
    end
    if node.node_type == AstType.LiteralFloat do
        out TypeKind.Float
    end
    if node.node_type == AstType.PercentExpr do
        out TypeKind.Float
    end
    if node.node_type == AstType.LiteralBool do
        out TypeKind.Bool
    end
    if node.node_type == AstType.LiteralNone do
        out TypeKind.None
    end
    if node.node_type == AstType.LiteralStr or node.node_type == AstType.InterpExpr do
        out TypeKind.String
    end
    if node.node_type == AstType.Identifier do
        found = pass5_lookup(symbols, scopes, scope_current_id(scopes), node.name)
        if found != -1 do
            ident_syms = native_read_i64(symbols as i64, 0)
            sym = vec_get_rt(ident_syms, found)
            out sym.type_id as TypeKind
        end
        out TypeKind.Void
    end
    if node.node_type == AstType.BinOp do
        child_count = vec_len_rt(node.children)
        if child_count >= 2 do
            left = vec_get_rt(node.children, 0)
            right = vec_get_rt(node.children, 1)
            lt = pass5_infer_expr(symbols, scopes, left)
            rt_type = pass5_infer_expr(symbols, scopes, right)
            if node.op == OpType.MatMulOp do
                out TypeKind.Tensor
            end
            if node.op == OpType.Eq or node.op == OpType.Ne or node.op == OpType.Gt or node.op == OpType.Lt or node.op == OpType.Ge or node.op == OpType.Le do
                out TypeKind.Bool
            end
            if node.op == OpType.Land or node.op == OpType.Lor do
                out TypeKind.Bool
            end
            if node.op == OpType.AndOp or node.op == OpType.OrOp or node.op == OpType.XorOp do
                if lt == TypeKind.Bool and rt_type == TypeKind.Bool do
                    out TypeKind.Bool
                end
                out TypeKind.Int
            end
            if node.op == OpType.ShlOp or node.op == OpType.ShrOp do
                out TypeKind.Int
            end
            if lt == TypeKind.Float or rt_type == TypeKind.Float do
                out TypeKind.Float
            end
            if lt == TypeKind.String and rt_type == TypeKind.String do
                out TypeKind.String
            end
            if lt == TypeKind.Bool or rt_type == TypeKind.Bool do
                out TypeKind.Bool
            end
            if lt != TypeKind.Void do
                out lt
            end
            out rt_type
        end
        out TypeKind.Void
    end
    if node.node_type == AstType.Assign do
        if vec_len_rt(node.children) > 0 do
            out pass5_infer_expr(symbols, scopes, vec_get_rt(node.children, 0))
        end
        out TypeKind.Void
    end
    if node.node_type == AstType.Compare do
        out TypeKind.Bool
    end
    if node.node_type == AstType.EnumConstruct do
        out TypeKind.Enum
    end
    if node.node_type == AstType.Call or node.node_type == AstType.MethodCall do
        out pass5_infer_call_return(symbols, scopes, node)
    end
    if node.node_type == AstType.BuiltinCall do
        if node.builtin_id == 11 or node.builtin_id == 19 do
            out TypeKind.String
        end
        if node.builtin_id == 12 do
            out TypeKind.Bool
        end
        if fat_cstr_eq(node.name, "str_concat") == 1 or fat_cstr_eq(node.name, "str_cat") == 1 or fat_cstr_eq(node.name, "fat_str_concat") == 1 or fat_cstr_eq(node.name, "fat_str_new") == 1 or fat_cstr_eq(node.name, "str_slice") == 1 or fat_cstr_eq(node.name, "fat_str_slice") == 1 or fat_cstr_eq(node.name, "rt_strcat") == 1 or fat_cstr_eq(node.name, "rt_itoa") == 1 or fat_cstr_eq(node.name, "str_trim") == 1 or fat_cstr_eq(node.name, "str_to_lower") == 1 or fat_cstr_eq(node.name, "str_to_upper") == 1 or fat_cstr_eq(node.name, "str_repeat") == 1 or fat_cstr_eq(node.name, "str_replace") == 1 do
            out TypeKind.String
        end
        if fat_cstr_eq(node.name, "str_eq") == 1 or fat_cstr_eq(node.name, "fat_str_eq") == 1 or fat_cstr_eq(node.name, "str_contains") == 1 or fat_cstr_eq(node.name, "str_starts_with") == 1 or fat_cstr_eq(node.name, "str_ends_with") == 1 or fat_cstr_eq(node.name, "dict_has_key") == 1 do
            out TypeKind.Bool
        end
        out TypeKind.Int
    end
    if node.node_type == AstType.ArrayLiteral do
        child_count = vec_len_rt(node.children)
        var i = 0
        var array_elem_type = TypeKind.Void
        when i < child_count loop
            elem = vec_get_rt(node.children, i)
            elem_t = pass5_infer_expr(symbols, scopes, elem)
            if elem_t != TypeKind.Void do
                array_elem_type = elem_t
            end
            i = i + 1
        end
        out TypeKind.Array
    end
    if node.node_type == AstType.TupleExpr do
        out TypeKind.Tuple
    end
    if node.node_type == AstType.DictLiteral do
        out TypeKind.Dict
    end
    if node.node_type == AstType.EntityLiteral do
        out TypeKind.Entity
    end
    if node.node_type == AstType.EnumAccess do
        out TypeKind.Enum
    end
    if node.node_type == AstType.AddrOf do
        if fat_cstr_eq(node.name, "mut") == 1 or node.int_val == 1 do
            out TypeKind.MutRef
        end
        out TypeKind.Ref
    end
    if node.node_type == AstType.CastExpr do
        out TypeKind.Void
    end
    if node.node_type == AstType.UnaryMinus do
        child_count = vec_len_rt(node.children)
        if child_count > 0 do
            child = vec_get_rt(node.children, 0)
            out pass5_infer_expr(symbols, scopes, child)
        end
        out TypeKind.Int
    end
    if node.node_type == AstType.IndexAccess or node.node_type == AstType.ExprIndex do
        out TypeKind.Int
    end
    out TypeKind.Void
end.
