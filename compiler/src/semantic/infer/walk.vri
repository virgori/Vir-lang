##
 * compiler/src/semantic/infer/walk.vri — AST Traversal for Type Inference
 * ======================================================================
 * VIRC-PLN-0004 & Phase 5: Type Inference Decomposition.
 *
 * Walks the AST to propagate inferred types into symbol table entries for
 * declarations, assignments, loop binders, and function signatures.
 ##

include vec_rt
include string_rt
include parser
include symbol_table
include scope_tree
include type_table
include ide_facts
include infer_context
include infer_calls
include infer_expr

func pass5_walk(ref symbols: SymbolTable, ref scopes: ScopeTree, node: &AstNode):
    if g_ideFactsEnabled == 1 do
        ideFactType(node as int, pass5_infer_expr(symbols, scopes, node) as int)
    end

    if node.node_type == AstType.VarDeclGroup do
        child_count = vec_len_rt(node.children)
        var vi = 0
        when vi < child_count loop
            child = vec_get_rt(node.children, vi)
            pass5_walk(symbols, scopes, child)
            vi = vi + 1
        end
        out 0
    end

    if node.node_type == AstType.VarDecl or node.node_type == AstType.ConstDecl do
        child_count = vec_len_rt(node.children)
        var i = 0
        when i < child_count loop
            child = vec_get_rt(node.children, i)
            pass5_walk(symbols, scopes, child)
            i = i + 1
        end
        if node.int_val == 16384 do
            # Tuple destructure: binders are children[0..n-2], init last.
            if child_count > 1 do
                init = vec_get_rt(node.children, child_count - 1)
                var di = 0
                when di < child_count - 1 loop
                    var_ident = vec_get_rt(node.children, di)
                    if fat_str_len(var_ident.name) > 0 do
                        binder_ty = pass5_tuple_binder_type(symbols, scopes, init, di)
                        if binder_ty == TypeKind.Void do
                            binder_ty = TypeKind.Int
                        end
                        pass5_register_local(symbols, scopes, var_ident.name, binder_ty)
                    end
                    di = di + 1
                end
            end
        else
            inferred = TypeKind.Void
            if child_count > 0 do
                init = vec_get_rt(node.children, 0)
                inferred = pass5_infer_expr(symbols, scopes, init)
            end
            ideFactType(node as int, inferred as int)
            if inferred != TypeKind.Void do
                pass5_register_local(symbols, scopes, node.name, inferred)
            end
        end
        out 0
    end

    # Implicit locals from `x = expr` — same inference as VarDecl.
    if node.node_type == AstType.Assign do
        inferred = TypeKind.Void
        child_count = vec_len_rt(node.children)
        if child_count > 0 do
            init = vec_get_rt(node.children, 0)
            inferred = pass5_infer_expr(symbols, scopes, init)
            pass5_walk(symbols, scopes, init)
        end
        if fat_str_len(node.name) > 0 do
            if inferred != TypeKind.Void do
                found = pass5_lookup(symbols, scopes, scope_current_id(scopes), node.name)
                if found != -1 do
                    assign_syms = native_read_i64(symbols as i64, 0)
                    sym = vec_get_rt(assign_syms, found)
                    if sym.type_id == 0 do
                        native_write_i64(sym as i64, 16, inferred as i64)
                    end
                else
                    pass5_register_local(symbols, scopes, node.name, inferred)
                end
            end
        end
        out 0
    end

    if node.node_type == AstType.FuncDef do
        scope_push(scopes, ScopeKind.Func)
        child_count = vec_len_rt(node.children)
        body_idx = child_count - 1
        if body_idx < 0 do
            body_idx = 0
        end
        var bi = 0
        when bi < child_count loop
            ch = vec_get_rt(node.children, bi)
            if ch.node_type == AstType.Block do
                body_idx = bi
                bi = child_count
            else
                bi = bi + 1
            end
        end
        var pi = 0
        when pi < body_idx loop
            param = vec_get_rt(node.children, pi)
            if fat_str_len(param.name) > 0 do
                pass5_register_local(symbols, scopes, param.name, TypeKind.Int)
            end
            pi = pi + 1
        end
        var j = body_idx
        when j < child_count loop
            child = vec_get_rt(node.children, j)
            pass5_walk(symbols, scopes, child)
            j = j + 1
        end
        scope_pop(scopes)
        out 0
    end

    if node.node_type == AstType.ForRange do
        child_count = vec_len_rt(node.children)
        if child_count >= 1 do
            pass5_walk(symbols, scopes, vec_get_rt(node.children, 0))
        end
        if child_count >= 2 do
            pass5_walk(symbols, scopes, vec_get_rt(node.children, 1))
        end
        scope_push(scopes, ScopeKind.Loop)
        if fat_str_len(node.name) > 0 do
            pass5_register_local(symbols, scopes, node.name, TypeKind.Int)
        end
        if child_count >= 3 do
            pass5_walk(symbols, scopes, vec_get_rt(node.children, 2))
        end
        scope_pop(scopes)
        out 0
    end

    if node.node_type == AstType.Block do
        scope_push(scopes, ScopeKind.Block)
        child_count = vec_len_rt(node.children)
        var i = 0
        when i < child_count loop
            child = vec_get_rt(node.children, i)
            pass5_walk(symbols, scopes, child)
            i = i + 1
        end
        scope_pop(scopes)
        out 0
    end

    # Default recurse
    child_count = vec_len_rt(node.children)
    var i = 0
    when i < child_count loop
        child = vec_get_rt(node.children, i)
        pass5_walk(symbols, scopes, child)
        i = i + 1
    end
    out 0
end.
