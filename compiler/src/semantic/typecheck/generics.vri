##
 * compiler/src/semantic/typecheck/generics.vri — Generic Type Substitution & Extraction Rules
 * =========================================================================================
 * VIRC-PLN-0004 Section 5.5: Generic Type Rules Service.
 *
 * Implements type checking, parameter matching, argument extraction, and substitution:
 * - Generic argument list item counting and indexing
 * - First and second generic argument extraction (<T>, <T, E>)
 * - Outermost generic arguments content extraction (<T1, T2, ...>)
 * - Word-level generic parameter substitution in compound types
 * - Generic parameter membership checking
 * - Enum generic variant argument validation (Option, Result)
 ##

include typecheck_context

func typecheck_count_list_items(s: &string) -> int:
    let slen = fat_str_len(s)
    if slen <= 0 do out 0 end
    var count = 1
    var angle_depth = 0
    var paren_depth = 0
    var bracket_depth = 0
    var i = 0
    when i < slen loop
        let b = fat_str_byte_at(s, i)
        if b == 60 do angle_depth = angle_depth + 1 end
        if b == 62 and angle_depth > 0 do angle_depth = angle_depth - 1 end
        if b == 40 do paren_depth = paren_depth + 1 end
        if b == 41 and paren_depth > 0 do paren_depth = paren_depth - 1 end
        if b == 91 do bracket_depth = bracket_depth + 1 end
        if b == 93 and bracket_depth > 0 do bracket_depth = bracket_depth - 1 end
        if b == 44 and angle_depth == 0 and paren_depth == 0 and bracket_depth == 0 do
            count = count + 1
        end
        i = i + 1
    end
    out count
end.

func typecheck_get_list_item(s: &string, target_idx: int) -> string:
    let slen = fat_str_len(s)
    if slen <= 0 do out fat_str_new("") end
    var cur_idx = 0
    var start = 0
    var angle_depth = 0
    var paren_depth = 0
    var bracket_depth = 0
    var i = 0
    when i <= slen loop
        var at_split = false
        if i == slen do
            at_split = true
        else
            let b = fat_str_byte_at(s, i)
            if b == 60 do angle_depth = angle_depth + 1 end
            if b == 62 and angle_depth > 0 do angle_depth = angle_depth - 1 end
            if b == 40 do paren_depth = paren_depth + 1 end
            if b == 41 and paren_depth > 0 do paren_depth = paren_depth - 1 end
            if b == 91 do bracket_depth = bracket_depth + 1 end
            if b == 93 and bracket_depth > 0 do bracket_depth = bracket_depth - 1 end
            if b == 44 and angle_depth == 0 and paren_depth == 0 and bracket_depth == 0 do
                at_split = true
            end
        end
        if at_split do
            if cur_idx == target_idx do
                var item_start = start
                when item_start < i and fat_str_byte_at(s, item_start) == 32 loop
                    item_start = item_start + 1
                end
                var item_end = i
                when item_end > item_start and fat_str_byte_at(s, item_end - 1) == 32 loop
                    item_end = item_end - 1
                end
                out fat_str_slice(s, item_start, item_end - item_start)
            end
            cur_idx = cur_idx + 1
            start = i + 1
        end
        i = i + 1
    end
    out fat_str_new("")
end.

func typecheck_split_list_items(s: &string) -> int:
    var result = vec_new_rt()
    let slen = fat_str_len(s)
    if slen <= 0 do out result end
    var start = 0
    var angle_depth = 0
    var paren_depth = 0
    var bracket_depth = 0
    var i = 0
    when i <= slen loop
        var at_split = false
        if i == slen do
            at_split = true
        else
            let b = fat_str_byte_at(s, i)
            if b == 60 do angle_depth = angle_depth + 1 end
            if b == 62 and angle_depth > 0 do angle_depth = angle_depth - 1 end
            if b == 40 do paren_depth = paren_depth + 1 end
            if b == 41 and paren_depth > 0 do paren_depth = paren_depth - 1 end
            if b == 91 do bracket_depth = bracket_depth + 1 end
            if b == 93 and bracket_depth > 0 do bracket_depth = bracket_depth - 1 end
            if b == 44 and angle_depth == 0 and paren_depth == 0 and bracket_depth == 0 do
                at_split = true
            end
        end
        if at_split do
            var item_start = start
            when item_start < i and fat_str_byte_at(s, item_start) == 32 loop
                item_start = item_start + 1
            end
            var item_end = i
            when item_end > item_start and fat_str_byte_at(s, item_end - 1) == 32 loop
                item_end = item_end - 1
            end
            let item_str = fat_str_slice(s, item_start, item_end - item_start)
            result = vec_push_rt(result, item_str as i64)
            start = i + 1
        end
        i = i + 1
    end
    out result
end.

func typecheck_extract_first_generic_arg(type_str: &string) -> string:
    let slen = fat_str_len(type_str)
    var lt = 0 - 1
    var i = 0
    when i < slen loop
        let b1 = fat_str_byte_at(type_str, i)
        if b1 == 60 or b1 == 40 do
            lt = i
            i = slen
        else
            i = i + 1
        end
    end
    if lt < 0 do out fat_str_new("") end
    var comma = 0 - 1
    var gt = 0 - 1
    var j = lt + 1
    var depth = 0
    when j < slen loop
        let b2 = fat_str_byte_at(type_str, j)
        if b2 == 60 or b2 == 40 do
            depth = depth + 1
        eif b2 == 62 or b2 == 41 do
            if depth == 0 and gt < 0 do
                gt = j
                j = slen
            else
                depth = depth - 1
            end
        eif b2 == 44 and depth == 0 and comma < 0 do
            comma = j
        end
        j = j + 1
    end
    if comma >= 0 do
        var s = lt + 1
        when s < comma and fat_str_byte_at(type_str, s) == 32 loop s = s + 1 end
        var e = comma
        when e > s and fat_str_byte_at(type_str, e - 1) == 32 loop e = e - 1 end
        out fat_str_slice(type_str, s, e - s)
    end
    if gt >= 0 do
        var s = lt + 1
        when s < gt and fat_str_byte_at(type_str, s) == 32 loop s = s + 1 end
        var e = gt
        when e > s and fat_str_byte_at(type_str, e - 1) == 32 loop e = e - 1 end
        out fat_str_slice(type_str, s, e - s)
    end
    out fat_str_new("")
end.

func typecheck_extract_second_generic_arg(type_str: &string) -> string:
    let slen = fat_str_len(type_str)
    var comma = 0 - 1
    var gt = 0 - 1
    var depth = 0
    var i = 0
    when i < slen loop
        let b = fat_str_byte_at(type_str, i)
        if b == 60 or b == 40 do
            depth = depth + 1
        eif b == 62 or b == 41 do
            if depth == 1 and gt < 0 do
                gt = i
            end
            if depth > 0 do depth = depth - 1 end
        eif b == 44 and depth == 1 and comma < 0 do
            comma = i
        end
        i = i + 1
    end
    if comma >= 0 and gt > comma do
        var start = comma + 1
        when start < gt and fat_str_byte_at(type_str, start) == 32 loop
            start = start + 1
        end
        var end_pos = gt
        when end_pos > start and fat_str_byte_at(type_str, end_pos - 1) == 32 loop
            end_pos = end_pos - 1
        end
        out fat_str_slice(type_str, start, end_pos - start)
    end
    out fat_str_new("")
end.

func typecheck_extract_generic_args_content(type_str: &string) -> string:
    let slen = fat_str_len(type_str)
    var lt = 0 - 1
    var gt = 0 - 1
    var depth = 0
    var i = 0
    when i < slen loop
        let b = fat_str_byte_at(type_str, i)
        if b == 60 or b == 40 do                      # '<' or '('
            if depth == 0 do lt = i end
            depth = depth + 1
        end
        if b == 62 or b == 41 do                      # '>' or ')'
            depth = depth - 1
            if depth == 0 and gt < 0 do gt = i end   # first outermost '>' or ')'
        end
        i = i + 1
    end
    if lt >= 0 and gt > lt do
        out fat_str_slice(type_str, lt + 1, gt - lt - 1)
    end
    out fat_str_new("")
end.

func typecheck_substitute_generic_type(param_names: &string, arg_types: &string, target_type: &string) -> string:
    let tlen = fat_str_len(target_type)
    if fat_str_len(param_names) == 0 or fat_str_len(arg_types) == 0 or tlen == 0 do
        out target_type
    end
    let p_names = typecheck_split_list_items(param_names)
    let a_types = typecheck_split_list_items(arg_types)
    let p_count = vec_len_rt(p_names)
    let a_count = vec_len_rt(a_types)
    if p_count <= 0 or a_count <= 0 do out target_type end

    # Fast path: exact whole-string match
    var p = 0
    when p < p_count and p < a_count loop
        let p_name = vec_get_rt(p_names, p) as string
        if fat_str_eq(p_name, target_type) == 1 do
            out vec_get_rt(a_types, p) as string
        end
        p = p + 1
    end

    # Word/token-level substitution for compound types:
    # Handles Vec of (T), Map of (K,V), func(U,T)->U, &T, &mut T, [T], tensor of (T)[M,N], etc.
    var res = fat_str_new("")
    var i = 0
    var changed = false
    when i < tlen loop
        let c = fat_str_byte_at(target_type, i)
        if (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or c == 95 do
            var wstart = i
            i = i + 1
            when i < tlen loop
                let c2 = fat_str_byte_at(target_type, i)
                if (c2 >= 65 and c2 <= 90) or (c2 >= 97 and c2 <= 122) or (c2 >= 48 and c2 <= 57) or c2 == 95 do
                    i = i + 1
                else
                    break
                end
            end
            let word = fat_str_slice(target_type, wstart, i - wstart)
            var matched = false
            var j = 0
            when j < p_count and j < a_count loop
                let p_name_sub = vec_get_rt(p_names, j) as string
                if fat_str_eq(p_name_sub, word) == 1 do
                    let arg_t = vec_get_rt(a_types, j) as string
                    res = fat_str_concat(res, arg_t)
                    matched = true
                    changed = true
                    break
                end
                j = j + 1
            end
            if not matched do
                res = fat_str_concat(res, word)
            end
        else
            res = fat_str_concat(res, fat_str_slice(target_type, i, 1))
            i = i + 1
        end
    end
    if changed do
        out res
    end
    out target_type
end.

func typecheck_is_in_generic_params(gen_params: &string, ty: &string) -> bool:
    if fat_str_len(gen_params) == 0 or fat_str_len(ty) == 0 do out false end
    let p_count = typecheck_count_list_items(gen_params)
    var i = 0
    when i < p_count loop
        if fat_str_eq(typecheck_get_list_item(gen_params, i), ty) == 1 do
            out true
        end
        i = i + 1
    end
    out false
end.

func typecheck_check_enum_generic_arg_rule(decl_type: &string, variant_name: &string, arg_type: TypeKind) -> int:
    let first_arg = typecheck_extract_first_generic_arg(decl_type)
    let second_arg = typecheck_extract_second_generic_arg(decl_type)

    if fat_cstr_eq(variant_name, "Some") == 1 do
        if fat_cstr_eq(first_arg, "int") == 1 and arg_type != TypeKind.Int and arg_type != TypeKind.Void do
            out 3042
        eif fat_cstr_eq(first_arg, "string") == 1 and arg_type != TypeKind.String and arg_type != TypeKind.Void do
            out 3042
        end
    eif fat_cstr_eq(variant_name, "Success") == 1 do
        if fat_cstr_eq(first_arg, "int") == 1 and arg_type != TypeKind.Int and arg_type != TypeKind.Void do
            out 3042
        eif fat_cstr_eq(first_arg, "string") == 1 and arg_type != TypeKind.String and arg_type != TypeKind.Void do
            out 3042
        end
    eif fat_cstr_eq(variant_name, "Failure") == 1 do
        if fat_cstr_eq(second_arg, "int") == 1 and arg_type != TypeKind.Int and arg_type != TypeKind.Void do
            out 3042
        eif fat_cstr_eq(second_arg, "string") == 1 and arg_type != TypeKind.String and arg_type != TypeKind.Void do
            out 3042
        end
    end
    out 0
end.

func typecheck_bind_generic_param(p_names: int, inferred_args: int, formal_t: &string, actual_t: &string) -> int:
    var f_un = typecheck_unwrap_type_name(formal_t)
    var a_un = typecheck_unwrap_type_name(actual_t)
    let flen = fat_str_len(f_un)
    let alen = fat_str_len(a_un)
    if flen == 0 or alen == 0 do out 1 end

    let p_count = vec_len_rt(p_names)
    var k = 0
    when k < p_count loop
        let pk = vec_get_rt(p_names, k) as string
        if fat_str_eq(pk, f_un) == 1 do
            let cur = vec_get_rt(inferred_args, k) as string
            if fat_str_len(cur) == 0 do
                vec_set_rt(inferred_args, k, a_un as i64)
                out 1
            else
                if fat_str_eq(cur, a_un) == 1 do
                    out 1
                end
                if (fat_cstr_eq(cur, "int") == 1 and fat_cstr_eq(a_un, "i64") == 1) or (fat_cstr_eq(cur, "i64") == 1 and fat_cstr_eq(a_un, "int") == 1) do
                    out 1
                end
                out 0
            end
        end
        k = k + 1
    end

    let base_f = typecheck_extract_base_name(f_un)
    let base_a = typecheck_extract_base_name(a_un)
    if fat_str_len(base_f) > 0 and fat_str_eq(base_f, base_a) == 1 do
        let args_f_str = typecheck_extract_generic_args_content(f_un)
        let args_a_str = typecheck_extract_generic_args_content(a_un)
        if fat_str_len(args_f_str) > 0 and fat_str_len(args_a_str) > 0 do
            let list_f = typecheck_split_list_items(args_f_str)
            let list_a = typecheck_split_list_items(args_a_str)
            let len_f = vec_len_rt(list_f)
            let len_a = vec_len_rt(list_a)
            if len_f == len_a do
                var ok = 1
                var li = 0
                when li < len_f loop
                    let sf = vec_get_rt(list_f, li) as string
                    let sa = vec_get_rt(list_a, li) as string
                    let sub_res = typecheck_bind_generic_param(p_names, inferred_args, sf, sa)
                    if sub_res == 0 do ok = 0 end
                    li = li + 1
                end
                out ok
            end
        end
    end

    if typecheck_is_array_type_str(f_un) and typecheck_is_array_type_str(a_un) do
        let elem_f = typecheck_extract_generic_or_array_elem(f_un)
        let elem_a = typecheck_extract_generic_or_array_elem(a_un)
        out typecheck_bind_generic_param(p_names, inferred_args, elem_f, elem_a)
    end

    out 1
end.

export typecheck_count_list_items, typecheck_get_list_item,
       typecheck_split_list_items, typecheck_extract_first_generic_arg,
       typecheck_extract_second_generic_arg, typecheck_extract_generic_args_content,
       typecheck_substitute_generic_type, typecheck_is_in_generic_params,
       typecheck_check_enum_generic_arg_rule, typecheck_bind_generic_param
