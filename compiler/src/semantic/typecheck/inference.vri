##
 * compiler/src/semantic/typecheck/inference.vri — Type Inference Service
 * ======================================================================
 * VIRC-PLN-0003 Section 5.5: Type Inference Service.
 *
 * Implements type inference for literals, binary operators, builtin calls,
 * returns-first-arg recognition, and local expression returns.
 ##

include typecheck_context
include typecheck_compatibility

func typecheck_infer_literal(node: &AstNode) -> TypeKind:
    if node.node_type == AstType.LiteralInt do
        out TypeKind.Int
    end
    if node.node_type == AstType.LiteralFloat or node.node_type == AstType.PercentExpr do
        out TypeKind.Float
    end
    if node.node_type == AstType.LiteralBool do
        out TypeKind.Bool
    end
    if node.node_type == AstType.LiteralNone do
        out TypeKind.None
    end
    if node.node_type == AstType.DictLiteral do
        out TypeKind.Dict
    end
    if node.node_type == AstType.ArrayLiteral do
        out TypeKind.Array
    end
    if node.node_type == AstType.TupleExpr do
        out TypeKind.Tuple
    end
    if node.node_type == AstType.EntityLiteral do
        out TypeKind.Entity
    end
    if node.node_type == AstType.AddrOf do
        out TypeKind.Ref
    end
    if node.node_type == AstType.LiteralStr or node.node_type == AstType.InterpExpr do
        out TypeKind.String
    end
    out TypeKind.Void
end.

func typecheck_infer_binop(lt: TypeKind, rt: TypeKind, op: int, int_val: int) -> TypeKind:
    if op == OpType.MatMulOp as int or op == OpType.FmaOp as int do
        out TypeKind.Tensor
    end
    if op == OpType.PowOp as int and int_val == 1 do
        out TypeKind.Float
    end
    if op == OpType.Eq as int or op == OpType.Ne as int or op == OpType.Gt as int or op == OpType.Lt as int or op == OpType.Ge as int or op == OpType.Le as int do
        out TypeKind.Bool
    end
    if op == OpType.Land as int or op == OpType.Lor as int do
        out TypeKind.Bool
    end
    if op == OpType.AndOp as int or op == OpType.OrOp as int or op == OpType.XorOp as int do
        if lt == TypeKind.Bool and rt == TypeKind.Bool do
            out TypeKind.Bool
        end
        out TypeKind.Int
    end
    if op == OpType.ShlOp as int or op == OpType.ShrOp as int do
        out TypeKind.Int
    end
    if lt == TypeKind.Float or rt == TypeKind.Float do
        out TypeKind.Float
    end
    if lt == TypeKind.String and rt == TypeKind.String do
        out TypeKind.String
    end
    if lt == TypeKind.Bool or rt == TypeKind.Bool do
        out TypeKind.Bool
    end
    if lt != TypeKind.Void do
        out lt
    end
    out rt
end.

func typecheck_call_returns_first_arg(name: i64) -> int:
    if fat_cstr_eq(name, "ast_add_child") == 1 do out 1 end
    if fat_cstr_eq(name, "vec_push_rt") == 1 do out 1 end
    if fat_cstr_eq(name, "vec_set_rt") == 1 do out 1 end
    if fat_cstr_eq(name, "vec_push") == 1 do out 1 end
    if fat_cstr_eq(name, "ast_vec_push") == 1 do out 1 end
    if fat_cstr_eq(name, "ast_vec_bump_new") == 1 do out 1 end
    if fat_cstr_eq(name, "codebuf_emit_byte") == 1 do out 1 end
    if fat_cstr_eq(name, "codebuf_emit_u32") == 1 do out 1 end
    if fat_cstr_eq(name, "codebuf_emit_u64") == 1 do out 1 end
    if fat_cstr_eq(name, "codebuf_emit_i32") == 1 do out 1 end
    if fat_cstr_eq(name, "buf_write_u8") == 1 do out 1 end
    if fat_cstr_eq(name, "buf_align") == 1 do out 1 end
    if fat_cstr_eq(name, "bvec_push") == 1 do out 1 end
    if fat_cstr_eq(name, "text_splice_at") == 1 do out 1 end
    out 0
end.

func typecheck_infer_builtin_call_return(name: &string) -> TypeKind:
    if fat_cstr_eq(name, "native_read_i64") == 1 or fat_cstr_eq(name, "native_read_u8") == 1 or fat_cstr_eq(name, "native_read_i32") == 1 or fat_cstr_eq(name, "native_read_u32") == 1 or fat_cstr_eq(name, "native_read_u64") == 1 or fat_cstr_eq(name, "native_read_i16") == 1 or fat_cstr_eq(name, "native_read_u16") == 1 do
        out TypeKind.Int
    end
    if fat_cstr_eq(name, "syscall1") == 1 or fat_cstr_eq(name, "syscall2") == 1 or fat_cstr_eq(name, "syscall3") == 1 or fat_cstr_eq(name, "syscall4") == 1 or fat_cstr_eq(name, "syscall5") == 1 or fat_cstr_eq(name, "syscall6") == 1 do
        out TypeKind.Int
    end
    if fat_cstr_eq(name, "rt_strlen") == 1 or fat_cstr_eq(name, "rt_atoi") == 1 or fat_cstr_eq(name, "rt_streq") == 1 or fat_cstr_eq(name, "str_len") == 1 or fat_cstr_eq(name, "str_byte_len") == 1 or fat_cstr_eq(name, "fat_str_len") == 1 or fat_cstr_eq(name, "vec_len") == 1 or fat_cstr_eq(name, "dict_len") == 1 do
        out TypeKind.Int
    end
    if fat_cstr_eq(name, "str_eq") == 1 or fat_cstr_eq(name, "fat_str_eq") == 1 or fat_cstr_eq(name, "str_contains") == 1 or fat_cstr_eq(name, "str_starts_with") == 1 or fat_cstr_eq(name, "str_ends_with") == 1 or fat_cstr_eq(name, "dict_has_key") == 1 do
        out TypeKind.Bool
    end
    if fat_cstr_eq(name, "fat_str_new") == 1 or fat_cstr_eq(name, "fat_str_concat") == 1 or fat_cstr_eq(name, "fat_char_to_str") == 1 or fat_cstr_eq(name, "str_from_cstr") == 1 or fat_cstr_eq(name, "str_concat") == 1 or fat_cstr_eq(name, "str_slice") == 1 or fat_cstr_eq(name, "fat_str_slice") == 1 or fat_cstr_eq(name, "rt_strcat") == 1 or fat_cstr_eq(name, "rt_itoa") == 1 or fat_cstr_eq(name, "str_trim") == 1 or fat_cstr_eq(name, "str_to_lower") == 1 or fat_cstr_eq(name, "str_to_upper") == 1 or fat_cstr_eq(name, "str_repeat") == 1 or fat_cstr_eq(name, "str_replace") == 1 do
        out TypeKind.String
    end
    out TypeKind.Void
end.

func typecheck_find_return_stmt_uncached(node: &AstNode) -> AstNode:
    if (node as i64) == 0 do out 0 as AstNode end
    if node.node_type == AstType.ReturnStmt and vec_len_rt(node.children) > 0 do
        out node
    end
    var n = vec_len_rt(node.children)
    var i = 0
    when i < n loop
        var ch = vec_get_rt(node.children, i) as AstNode
        if ch.node_type != AstType.FuncDef do
            var ret_s_child = typecheck_find_return_stmt_uncached(ch)
            if (ret_s_child as i64) != 0 do out ret_s_child end
        end
        i = i + 1
    end
    out 0 as AstNode
end.

func typecheck_find_param_type_name(fn_node: &AstNode, param_name: &string) -> string:
    if (fn_node as i64) == 0 do out fat_str_new("") end
    let n = vec_len_rt(fn_node.children)
    var i = 0
    when i < n loop
        let ch = vec_get_rt(fn_node.children, i) as AstNode
        if (ch as i64) != 0 do
            if (ch.node_type == AstType.ParamDef or ch.node_type == AstType.RefParam or ch.node_type == AstType.OutParam or ch.node_type == AstType.Identifier) and fat_str_eq(ch.name, param_name) == 1 do
                if fat_str_len(ch.name2) > 0 do
                    out typecheck_unwrap_type_name(ch.name2)
                end
                out fat_str_new("")
            end
        end
        i = i + 1
    end
    out fat_str_new("")
end.

func typecheck_find_local_decl_in_node(node: &AstNode, name: int) -> AstNode:
    if (node as i64) == 0 do out 0 as AstNode end
    if (node.node_type == AstType.VarDecl or node.node_type == AstType.ConstDecl) and fat_str_eq(node.name, name) == 1 do
        out node
    end
    let n = vec_len_rt(node.children)
    var i = 0
    when i < n loop
        let ch = vec_get_rt(node.children, i) as AstNode
        if ch.node_type != AstType.FuncDef do
            let res = typecheck_find_local_decl_in_node(ch, name)
            if (res as i64) != 0 do out res end
        end
        i = i + 1
    end
    out 0 as AstNode
end.

export typecheck_infer_literal, typecheck_infer_binop,
       typecheck_call_returns_first_arg, typecheck_infer_builtin_call_return,
       typecheck_find_return_stmt_uncached, typecheck_find_param_type_name,
       typecheck_find_local_decl_in_node
