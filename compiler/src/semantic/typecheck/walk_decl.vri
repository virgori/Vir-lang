##
 * compiler/src/semantic/typecheck/walk_decl.vri — Variable & Constant Declaration Walk
 * ====================================================================================
 * VIRC-PLN-0004 Section 5: AST walk handlers for VarDecl and ConstDecl nodes.
 *
 * Implements:
 * - pass6WalkVarDecl: type-check and register variable declarations
 * - pass6WalkConstDecl: type-check and register constant declarations
 ##

include typecheck_context

func pass6WalkVarDecl(ref symbols: SymbolTable, ref scopes: ScopeTree, diag: &DiagnosticEngine, node: &AstNode) -> int:
    if node.int_val == 16384 do
        child_count = vec_len_rt(node.children)
        if child_count > 1 do
            let init_node = vec_get_rt(node.children, child_count - 1) as AstNode
            pass6_walk(symbols, scopes, diag, init_node)
            var di = 0
            when di < child_count - 1 loop
                let var_ident = vec_get_rt(node.children, di) as AstNode
                if fat_str_len(var_ident.name) > 0 do
                    let prev_sid = pass6_lookup_chain(symbols, scopes, scope_current_id(scopes), var_ident.name)
                    var prev_ty = 0
                    if prev_sid != -1 do
                        let prev_sym = pass6_symbol_at(symbols, prev_sid)
                        prev_ty = prev_sym.type_id
                    end
                    let v_sid = pass6_register_local(symbols, scopes, var_ident.name, true)
                    if v_sid != -1 do
                        let vsyms_vec = native_read_i64(symbols as i64, 0)
                        let vsym = vec_get_rt(vsyms_vec, v_sid) as SymbolNode
                        native_write_i64(vsym as i64, 32, var_ident as i64)
                        if prev_ty != 0 do
                            native_write_i64(vsym as i64, 16, prev_ty)
                        end
                    end
                end
                di = di + 1
            end
        end
        out 0
    end
    child_count = vec_len_rt(node.children)
    var i = 0
    when i < child_count loop
        child = vec_get_rt(node.children, i)
        pass6_walk(symbols, scopes, diag, child)
        i = i + 1
    end
    sid = pass6_register_local(symbols, scopes, node.name, true)
    if g_ideFactsEnabled == 1 do
        if g_pass6_current_entity_name != 0 do
            ideFactResolve(node as int, sid, scope_current_id(scopes), 1)
        end
    end
    if sid != -1 do
        syms_vec = native_read_i64(symbols as i64, 0)
        sym = vec_get_rt(syms_vec, sid)
        native_write_i64(sym as i64, 32, node as i64)
        if fat_str_len(node.name2) > 0 do
            let c0 = fat_str_byte_at(node.name2, 0)
            if c0 == 38 do
                if fat_str_len(node.name2) > 4 and fat_str_byte_at(node.name2, 1) == 109 and fat_str_byte_at(node.name2, 2) == 117 and fat_str_byte_at(node.name2, 3) == 116 do
                    native_write_i64(sym as i64, 16, TypeKind.MutRef as i64)
                else
                    native_write_i64(sym as i64, 16, TypeKind.Ref as i64)
                end
            else
                var declared_ty = pass6_resolve_ffi_type(node.name2)
                if declared_ty != TypeKind.Void do
                    native_write_i64(sym as i64, 16, declared_ty as i64)
                else
                    var vd_ent = pass6_find_entity_ast(symbols, scopes, pass6_extract_base_name(node.name2))
                    if (vd_ent as i64) != 0 do
                        native_write_i64(sym as i64, 16, TypeKind.Entity as i64)
                    eif pass6_is_array_type_str(node.name2) do
                        native_write_i64(sym as i64, 16, TypeKind.Array as i64)
                    end
                end
            end
        end
        if fat_str_len(node.name2) > 0 and is_tensor_type_str(node.name2) do
            native_write_i64(sym as i64, 16, TypeKind.Tensor as i64)
            if node.builtin_id == 0 do
                node.builtin_id = tdesc_from_annotation(node.name2 as int)
            end
        eif fat_str_len(node.name2) > 0 and is_flux_type_str(node.name2 as int) do
            native_write_i64(sym as i64, 16, TypeKind.Flux as i64)
            pass6_set_var_type(node.name, node.name2)
            var lanes = parse_flux_lanes(node.name2 as int)
            if flux_is_power_of_two(lanes) == false do
                report_error(diag, 3090, node.line, 0)
            end
            if child_count > 0 do
                var c0 = vec_get_rt(node.children, 0) as AstNode
                if c0.node_type == AstType.Call and fat_cstr_eq(c0.name, "flux") do
                    if vec_len_rt(c0.children) != lanes do
                        report_error(diag, 3001, node.line, 0)
                    end
                end
            end
        eif child_count > 0 do
            child0 = vec_get_rt(node.children, 0)
            g_pass6_visiting_symbols = vec_push_rt(g_pass6_visiting_symbols, sid as i64)
            inferred = pass6_infer_type(symbols, scopes, child0)
            let v_len = vec_len_rt(g_pass6_visiting_symbols)
            if v_len > 0 do
                native_write_i64(g_pass6_visiting_symbols - 8, 0, v_len - 1)
            end
            if inferred != TypeKind.Void do
                var exp_v_ty = fat_str_new("")
                if fat_str_len(node.name2) > 0 do
                    exp_v_ty = node.name2
                else
                    exp_v_ty = pass6_type_kind_to_str(sym.type_id as TypeKind)
                end
                if sym.type_id == TypeKind.Int as i64 and child0.node_type == AstType.LiteralStr do
                    pass6_report_type_mismatch(diag, symbols, scopes, node, child0, exp_v_ty, "string")
                eif sym.type_id == TypeKind.String as i64 and child0.node_type == AstType.LiteralInt do
                    pass6_report_type_mismatch(diag, symbols, scopes, node, child0, exp_v_ty, "int")
                eif sym.type_id == TypeKind.Bool as i64 and (child0.node_type == AstType.LiteralStr or child0.node_type == AstType.LiteralInt) do
                    var act_s = "string"
                    if child0.node_type == AstType.LiteralInt do act_s = "int" end
                    pass6_report_type_mismatch(diag, symbols, scopes, node, child0, exp_v_ty, act_s)
                eif sym.type_id != 0 and pass6_types_compatible(sym.type_id, inferred) == 0 do
                    var allow_vinit = 0
                    if (sym.type_id == TypeKind.Entity as i64 or sym.type_id == TypeKind.Ref as i64 or sym.type_id == TypeKind.MutRef as i64 or sym.type_id == TypeKind.Pointer as i64 or sym.type_id == TypeKind.Optional as i64) and child0.node_type == AstType.LiteralInt and child0.int_val == 0 do
                        allow_vinit = 1
                    end
                    if is_user_module(g_pass6_cur_module) == 0 do
                        if (sym.type_id == TypeKind.Entity as i64 and pass6_is_integer_like(inferred as i64) == 1) or (pass6_is_integer_like(sym.type_id) == 1 and inferred == TypeKind.Entity) do
                            allow_vinit = 1
                        end
                        # System/compiler modules: bool↔int initializer is allowed.
                        if (sym.type_id == TypeKind.Bool as i64 and pass6_is_integer_like(inferred as i64) == 1) or (pass6_is_integer_like(sym.type_id) == 1 and inferred == TypeKind.Bool) do
                            allow_vinit = 1
                        end
                    end
                    if allow_vinit == 0 do
                        pass6_report_type_mismatch(diag, symbols, scopes, node, child0, exp_v_ty, pass6_type_kind_to_str(inferred))
                    end
                end
                if sym.type_id == 0 do
                    native_write_i64(sym as i64, 16, inferred as i64)
                end
            end
        end
    end
    var initializer_type = fat_str_new("")
    if fat_str_len(node.name2) > 0 do
        var vd_base = pass6_extract_base_name(node.name2)
        var vd_ent = pass6_find_entity_ast(symbols, scopes, vd_base)
        if (vd_ent as i64) != 0 do
            if vd_ent.builtin_id != 0 do
                var vd_gen_args = pass6_extract_generic_args_content(node.name2)
                var vd_decl_cnt = count_list_items(vd_ent.builtin_id as string)
                var vd_prov_cnt = 0
                if fat_str_len(vd_gen_args) > 0 do
                    vd_prov_cnt = count_list_items(vd_gen_args)
                end
                if vd_decl_cnt != vd_prov_cnt do
                    report_error(diag, 3085, node.line, 0)
                end
            end
        end
    end
    if child_count > 0 do
        child0 = vec_get_rt(node.children, 0)
        if fat_str_len(node.name2) > 0 do
            var v_ent = pass6_find_entity_ast(symbols, scopes, pass6_extract_base_name(node.name2))
            if (v_ent as i64) != 0 do
                if child0.node_type == AstType.ArrayLiteral do
                    pass6_report_type_mismatch(diag, symbols, scopes, node, child0, node.name2, "")
                eif child0.node_type == AstType.LiteralStr or (child0.node_type == AstType.LiteralInt and child0.int_val != 0) or child0.node_type == AstType.LiteralBool or child0.node_type == AstType.DictLiteral or child0.node_type == AstType.TupleExpr do
                    pass6_report_type_mismatch(diag, symbols, scopes, node, child0, node.name2, "")
                eif child0.node_type == AstType.LiteralInt and child0.int_val == 0 do
                    # 0 is null pointer/entity reference
                else
                    var init_str = pass6_get_expr_type_str(symbols, scopes, child0)
                    if fat_str_len(init_str) > 0 do
                        if pass6_is_array_type_str(init_str) do
                            pass6_report_type_mismatch(diag, symbols, scopes, node, child0, node.name2, init_str)
                        else
                            var v_a_ent = pass6_find_entity_ast(symbols, scopes, pass6_extract_base_name(init_str))
                            if (v_a_ent as i64) != 0 do
                                if pass6_type_strings_compatible(symbols, scopes, node.name2, init_str) == 0 do
                                    pass6_report_type_mismatch(diag, symbols, scopes, node, child0, node.name2, init_str)
                                end
                            end
                        end
                    end
                end
            eif pass6_is_array_type_str(node.name2) do
                if child0.node_type == AstType.EntityLiteral do
                    pass6_report_type_mismatch(diag, symbols, scopes, node, child0, node.name2, "")
                eif child0.node_type == AstType.LiteralStr or child0.node_type == AstType.LiteralInt or child0.node_type == AstType.LiteralBool or child0.node_type == AstType.DictLiteral or child0.node_type == AstType.TupleExpr do
                    pass6_report_type_mismatch(diag, symbols, scopes, node, child0, node.name2, "")
                else
                    var init_arr_str = pass6_get_expr_type_str(symbols, scopes, child0)
                    if fat_str_len(init_arr_str) > 0 do
                        var v_a_ent2 = pass6_find_entity_ast(symbols, scopes, pass6_extract_base_name(init_arr_str))
                        if (v_a_ent2 as i64) != 0 do
                            pass6_report_type_mismatch(diag, symbols, scopes, node, child0, node.name2, init_arr_str)
                        eif pass6_type_strings_compatible(symbols, scopes, node.name2, init_arr_str) == 0 do
                            pass6_report_type_mismatch(diag, symbols, scopes, node, child0, node.name2, init_arr_str)
                        end
                    end
                end
            end
        end
        if child0.node_type == AstType.Call do
            if fat_str_len(child0.name2) > 0 do
                if fat_str_len(node.name2) > 0 do
                    var call_fn = pass6_find_free_function(child0.name)
                    if (call_fn as i64) != 0 do
                        if call_fn.builtin_id != 0 do
                            var spec_ret = pass6_substitute_generic_type(call_fn.builtin_id as string, child0.name2, call_fn.name2)
                            if fat_str_len(spec_ret) > 0 do
                                if fat_str_eq(spec_ret, node.name2) == 0 do
                                    report_error(diag, 3084, child0.line, 0)
                                end
                            end
                        end
                    end
                end
            end
        end
        pass6_check_enum_generic_arg(symbols, scopes, diag, node.name2, child0)
        initializer_type = pass6_get_receiver_entity_name(symbols, scopes, child0)
        if child0.node_type == AstType.AddrOf and vec_len_rt(child0.children) > 0 do
            var addr_target_ent = pass6_get_receiver_entity_name(symbols, scopes, vec_get_rt(child0.children, 0) as AstNode)
            if fat_str_len(addr_target_ent) > 0 do
                var mut_prefix = fat_str_new("&")
                if fat_cstr_eq(child0.name, "mut") == 1 or child0.int_val == 1 do
                    mut_prefix = fat_str_new("&mut ")
                end
                initializer_type = fat_str_concat(mut_prefix, addr_target_ent)
            end
        end
        if child0.node_type == AstType.QuantizeExpr do
            if fat_str_len(child0.name2) > 0 do
                initializer_type = child0.name2
            else
                initializer_type = g_pass6_quantized_tensor_type as string
            end
        end
        if child0.node_type == AstType.Call and (fat_cstr_eq(child0.name, "q80CreateView") == 1 or is_quantized_type_str(child0.name2 as int)) do
            if is_quantized_type_str(child0.name2 as int) do
                initializer_type = child0.name2
            else
                child0.name2 = format_quantized_q80_unknown_type()
                initializer_type = child0.name2
            end
        end
        if child0.node_type == AstType.BinOp and (child0.op == OpType.MatMulOp or child0.op == OpType.FmaOp) do
            var inf_t = pass6_infer_tensor_op_result_type(symbols, scopes, child0)
            if fat_str_len(inf_t) > 0 do
                initializer_type = inf_t
            end
        end
        if child0.node_type == AstType.DictLiteral do
            initializer_type = fat_str_new("dict")
        end
    end
    if (fat_str_len(node.name2) == 0 or fat_cstr_eq(node.name2, "Q80TensorView") == 1) and fat_str_len(initializer_type) > 0 do
        node.name2 = initializer_type
        if is_tensor_type_str(initializer_type as int) and node.builtin_id == 0 do
            node.builtin_id = tdesc_from_annotation(initializer_type as int)
        end
        pass6_set_var_type(node.name, initializer_type)
    eif fat_str_len(node.name2) > 0 do
        pass6_set_var_type(node.name, node.name2)
    end
    if g_pass6_ai_mode == 1 do
        g_pass6_infer_values = vec_push_rt(g_pass6_infer_values, node.name)
    eif g_pass6_ai_mode == 2 do
        g_pass6_train_values = vec_push_rt(g_pass6_train_values, node.name)
    end
    out 0
end.

func pass6WalkConstDecl(ref symbols: SymbolTable, ref scopes: ScopeTree, diag: &DiagnosticEngine, node: &AstNode) -> int:
    child_count = vec_len_rt(node.children)
    var i = 0
    when i < child_count loop
        child = vec_get_rt(node.children, i)
        pass6_walk(symbols, scopes, diag, child)
        i = i + 1
    end
    sid = pass6_register_local(symbols, scopes, node.name, false)
    if g_ideFactsEnabled == 1 do
        if g_pass6_current_entity_name != 0 do
            ideFactResolve(node as int, sid, scope_current_id(scopes), 1)
        end
    end
    if sid != -1 do
        syms_vec = native_read_i64(symbols as i64, 0)
        sym = vec_get_rt(syms_vec, sid)
        native_write_i64(sym as i64, 32, node as i64)
        if fat_str_len(node.name2) > 0 do
            let c0 = fat_str_byte_at(node.name2, 0)
            if c0 == 38 do
                if fat_str_len(node.name2) > 4 and fat_str_byte_at(node.name2, 1) == 109 and fat_str_byte_at(node.name2, 2) == 117 and fat_str_byte_at(node.name2, 3) == 116 do
                    native_write_i64(sym as i64, 16, TypeKind.MutRef as i64)
                else
                    native_write_i64(sym as i64, 16, TypeKind.Ref as i64)
                end
            else
                var declared_ty = pass6_resolve_ffi_type(node.name2)
                if declared_ty != TypeKind.Void do
                    native_write_i64(sym as i64, 16, declared_ty as i64)
                else
                    var cd_ent_decl = pass6_find_entity_ast(symbols, scopes, pass6_extract_base_name(node.name2))
                    if (cd_ent_decl as i64) != 0 do
                        native_write_i64(sym as i64, 16, TypeKind.Entity as i64)
                    eif pass6_is_array_type_str(node.name2) do
                        native_write_i64(sym as i64, 16, TypeKind.Array as i64)
                    end
                end
            end
        end
        if fat_str_len(node.name2) > 0 and is_tensor_type_str(node.name2) do
            native_write_i64(sym as i64, 16, TypeKind.Tensor as i64)
            if node.builtin_id == 0 do
                node.builtin_id = tdesc_from_annotation(node.name2 as int)
            end
        eif fat_str_len(node.name2) > 0 and is_flux_type_str(node.name2 as int) do
            native_write_i64(sym as i64, 16, TypeKind.Flux as i64)
            pass6_set_var_type(node.name, node.name2)
            var lanes = parse_flux_lanes(node.name2 as int)
            if flux_is_power_of_two(lanes) == false do
                report_error(diag, 3090, node.line, 0)
            end
            if child_count > 0 do
                var c0 = vec_get_rt(node.children, 0) as AstNode
                if c0.node_type == AstType.Call and fat_cstr_eq(c0.name, "flux") do
                    if vec_len_rt(c0.children) != lanes do
                        report_error(diag, 3001, node.line, 0)
                    end
                end
            end
        eif child_count > 0 do
            child0 = vec_get_rt(node.children, 0)
            g_pass6_visiting_symbols = vec_push_rt(g_pass6_visiting_symbols, sid as i64)
            inferred = pass6_infer_type(symbols, scopes, child0)
            let v_len = vec_len_rt(g_pass6_visiting_symbols)
            if v_len > 0 do
                native_write_i64(g_pass6_visiting_symbols - 8, 0, v_len - 1)
            end
            if inferred != TypeKind.Void do
                var exp_c_ty = fat_str_new("")
                if fat_str_len(node.name2) > 0 do
                    exp_c_ty = node.name2
                else
                    exp_c_ty = pass6_type_kind_to_str(sym.type_id as TypeKind)
                end
                if sym.type_id == TypeKind.Int as i64 and child0.node_type == AstType.LiteralStr do
                    pass6_report_type_mismatch(diag, symbols, scopes, node, child0, exp_c_ty, "string")
                eif sym.type_id == TypeKind.String as i64 and child0.node_type == AstType.LiteralInt do
                    pass6_report_type_mismatch(diag, symbols, scopes, node, child0, exp_c_ty, "int")
                eif sym.type_id == TypeKind.Bool as i64 and (child0.node_type == AstType.LiteralStr or child0.node_type == AstType.LiteralInt) do
                    var act_cs = "string"
                    if child0.node_type == AstType.LiteralInt do act_cs = "int" end
                    pass6_report_type_mismatch(diag, symbols, scopes, node, child0, exp_c_ty, act_cs)
                eif sym.type_id != 0 and pass6_types_compatible(sym.type_id, inferred) == 0 do
                    var allow_cinit = 0
                    if (sym.type_id == TypeKind.Entity as i64 or sym.type_id == TypeKind.Ref as i64 or sym.type_id == TypeKind.MutRef as i64 or sym.type_id == TypeKind.Pointer as i64 or sym.type_id == TypeKind.Optional as i64) and child0.node_type == AstType.LiteralInt and child0.int_val == 0 do
                        allow_cinit = 1
                    end
                    if is_user_module(g_pass6_cur_module) == 0 do
                        if (sym.type_id == TypeKind.Entity as i64 and pass6_is_integer_like(inferred as i64) == 1) or (pass6_is_integer_like(sym.type_id) == 1 and inferred == TypeKind.Entity) do
                            allow_cinit = 1
                        end
                        # System/compiler modules: bool↔int initializer is allowed.
                        if (sym.type_id == TypeKind.Bool as i64 and pass6_is_integer_like(inferred as i64) == 1) or (pass6_is_integer_like(sym.type_id) == 1 and inferred == TypeKind.Bool) do
                            allow_cinit = 1
                        end
                    end
                    if allow_cinit == 0 do
                        pass6_report_type_mismatch(diag, symbols, scopes, node, child0, exp_c_ty, pass6_type_kind_to_str(inferred))
                    end
                end
                if sym.type_id == 0 do
                    native_write_i64(sym as i64, 16, inferred as i64)
                end
            end
        end
    end
    var initializer_type = fat_str_new("")
    if fat_str_len(node.name2) > 0 do
        var cd_base = pass6_extract_base_name(node.name2)
        var cd_ent = pass6_find_entity_ast(symbols, scopes, cd_base)
        if (cd_ent as i64) != 0 do
            if cd_ent.builtin_id != 0 do
                var cd_gen_args = pass6_extract_generic_args_content(node.name2)
                var cd_decl_cnt = count_list_items(cd_ent.builtin_id as string)
                var cd_prov_cnt = 0
                if fat_str_len(cd_gen_args) > 0 do
                    cd_prov_cnt = count_list_items(cd_gen_args)
                end
                if cd_decl_cnt != cd_prov_cnt do
                    report_error(diag, 3085, node.line, 0)
                end
            end
        end
    end
    if child_count > 0 do
        child0 = vec_get_rt(node.children, 0)
        if fat_str_len(node.name2) > 0 do
            var cd_v_ent = pass6_find_entity_ast(symbols, scopes, pass6_extract_base_name(node.name2))
            if (cd_v_ent as i64) != 0 do
                if child0.node_type == AstType.ArrayLiteral do
                    pass6_report_type_mismatch(diag, symbols, scopes, node, child0, node.name2, "")
                eif child0.node_type == AstType.LiteralStr or (child0.node_type == AstType.LiteralInt and child0.int_val != 0) or child0.node_type == AstType.LiteralBool or child0.node_type == AstType.DictLiteral or child0.node_type == AstType.TupleExpr do
                    pass6_report_type_mismatch(diag, symbols, scopes, node, child0, node.name2, "")
                eif child0.node_type == AstType.LiteralInt and child0.int_val == 0 do
                    # 0 is null pointer/entity reference
                else
                    var cd_init_str = pass6_get_expr_type_str(symbols, scopes, child0)
                    if fat_str_len(cd_init_str) > 0 do
                        if pass6_is_array_type_str(cd_init_str) do
                            pass6_report_type_mismatch(diag, symbols, scopes, node, child0, node.name2, cd_init_str)
                        else
                            var cd_a_ent = pass6_find_entity_ast(symbols, scopes, pass6_extract_base_name(cd_init_str))
                            if (cd_a_ent as i64) != 0 do
                                if pass6_type_strings_compatible(symbols, scopes, node.name2, cd_init_str) == 0 do
                                    pass6_report_type_mismatch(diag, symbols, scopes, node, child0, node.name2, cd_init_str)
                                end
                            end
                        end
                    end
                end
            eif pass6_is_array_type_str(node.name2) do
                if child0.node_type == AstType.EntityLiteral do
                    pass6_report_type_mismatch(diag, symbols, scopes, node, child0, node.name2, "")
                eif child0.node_type == AstType.LiteralStr or child0.node_type == AstType.LiteralInt or child0.node_type == AstType.LiteralBool or child0.node_type == AstType.DictLiteral or child0.node_type == AstType.TupleExpr do
                    pass6_report_type_mismatch(diag, symbols, scopes, node, child0, node.name2, "")
                else
                    var cd_init_arr_str = pass6_get_expr_type_str(symbols, scopes, child0)
                    if fat_str_len(cd_init_arr_str) > 0 do
                        var cd_a_ent2 = pass6_find_entity_ast(symbols, scopes, pass6_extract_base_name(cd_init_arr_str))
                        if (cd_a_ent2 as i64) != 0 do
                            pass6_report_type_mismatch(diag, symbols, scopes, node, child0, node.name2, cd_init_arr_str)
                        eif pass6_type_strings_compatible(symbols, scopes, node.name2, cd_init_arr_str) == 0 do
                            pass6_report_type_mismatch(diag, symbols, scopes, node, child0, node.name2, cd_init_arr_str)
                        end
                    end
                end
            end
        end
        if child0.node_type == AstType.Call do
            if fat_str_len(child0.name2) > 0 do
                if fat_str_len(node.name2) > 0 do
                    var cd_call_fn = pass6_find_free_function(child0.name)
                    if (cd_call_fn as i64) != 0 do
                        if cd_call_fn.builtin_id != 0 do
                            var cd_spec_ret = pass6_substitute_generic_type(cd_call_fn.builtin_id as string, child0.name2, cd_call_fn.name2)
                            if fat_str_len(cd_spec_ret) > 0 do
                                if fat_str_eq(cd_spec_ret, node.name2) == 0 do
                                    report_error(diag, 3084, child0.line, 0)
                                end
                            end
                        end
                    end
                end
            end
        end
        pass6_check_enum_generic_arg(symbols, scopes, diag, node.name2, child0)
        initializer_type = pass6_get_receiver_entity_name(symbols, scopes, child0)
        if child0.node_type == AstType.AddrOf and vec_len_rt(child0.children) > 0 do
            var c_addr_target_ent = pass6_get_receiver_entity_name(symbols, scopes, vec_get_rt(child0.children, 0) as AstNode)
            if fat_str_len(c_addr_target_ent) > 0 do
                var c_mut_prefix = fat_str_new("&")
                if fat_cstr_eq(child0.name, "mut") == 1 or child0.int_val == 1 do
                    c_mut_prefix = fat_str_new("&mut ")
                end
                initializer_type = fat_str_concat(c_mut_prefix, c_addr_target_ent)
            end
        end
        if child0.node_type == AstType.QuantizeExpr do
            if fat_str_len(child0.name2) > 0 do
                initializer_type = child0.name2
            else
                initializer_type = g_pass6_quantized_tensor_type as string
            end
        end
        if child0.node_type == AstType.Call and (fat_cstr_eq(child0.name, "q80CreateView") == 1 or is_quantized_type_str(child0.name2 as int)) do
            if is_quantized_type_str(child0.name2 as int) do
                initializer_type = child0.name2
            else
                child0.name2 = format_quantized_q80_unknown_type()
                initializer_type = child0.name2
            end
        end
        if child0.node_type == AstType.BinOp and (child0.op == OpType.MatMulOp or child0.op == OpType.FmaOp) do
            var inf_t = pass6_infer_tensor_op_result_type(symbols, scopes, child0)
            if fat_str_len(inf_t) > 0 do
                initializer_type = inf_t
            end
        end
        if child0.node_type == AstType.DictLiteral do
            initializer_type = fat_str_new("dict")
        end
        if child0.node_type == AstType.ArrayLiteral do
            initializer_type = pass6_get_expr_type_str(symbols, scopes, child0)
        end
    end
    if (fat_str_len(node.name2) == 0 or fat_cstr_eq(node.name2, "Q80TensorView") == 1) and fat_str_len(initializer_type) > 0 do
        node.name2 = initializer_type
        if is_tensor_type_str(initializer_type as int) and node.builtin_id == 0 do
            node.builtin_id = tdesc_from_annotation(initializer_type as int)
        end
        pass6_set_var_type(node.name, initializer_type)
    eif fat_str_len(node.name2) > 0 do
        pass6_set_var_type(node.name, node.name2)
    end
    out 0
end.


func pass6WalkFuncDef(ref symbols: SymbolTable, ref scopes: ScopeTree, diag: &DiagnosticEngine, node: &AstNode) -> int:
    if fat_str_len(node.name2) > 0 and is_tensor_type_str(node.name2) and (node.op as int) == 0 do
        node.op = tdesc_from_annotation(node.name2 as int) as OpType
    end
    var old_cur_gen = g_pass6_current_generic_params
    if node.builtin_id != 0 do
        g_pass6_current_generic_params = node.builtin_id as string
        pass6_check_generic_func_def(symbols, scopes, diag, node)
    else
        g_pass6_current_generic_params = fat_str_new("")
    end
    var old_func_name = g_pass6_current_func_name
    g_pass6_current_func_name = node.name as i64
    var old_cur_ret = g_pass6_current_func_ret_type
    g_pass6_current_func_ret_type = node.name2 as i64
    g_pass6_assigned_vars = vec_new_rt()
    g_pass6_var_names = vec_new_rt()
    g_pass6_var_types = vec_new_rt()
    pass6_scope_enter()
    scope_push(scopes, ScopeKind.Func)
    child_count = vec_len_rt(node.children)
    body_idx = child_count - 1
    if body_idx < 0 do
        body_idx = 0
    end
    var bi = 0
    when bi < child_count loop
        ch = vec_get_rt(node.children, bi)
        if ch.node_type == AstType.Block do
            body_idx = bi
            bi = child_count
        else
            bi = bi + 1
        end
    end
    var i = 0
    when i < body_idx loop
        param = vec_get_rt(node.children, i)
        sid = pass6_register_local(symbols, scopes, param.name, true)
        if g_ideFactsEnabled == 1 do
            if g_pass6_current_entity_name != 0 do
                ideFactResolve(param as int, sid, scope_current_id(scopes), 1)
                ideFactType(param as int, pass6_resolve_ffi_type(param.name2) as int)
            end
        end
        if sid != -1 do
            psym = pass6_symbol_at(symbols, sid)
            native_write_i64(psym as i64, 32, param as i64)
            param_kind = pass6_resolve_ffi_type(param.name2)
            if fat_str_len(param.name2) > 0 and is_tensor_type_str(param.name2) do
                native_write_i64(psym as i64, 16, TypeKind.Tensor as i64)
                if param.builtin_id == 0 do
                    param.builtin_id = tdesc_from_annotation(param.name2 as int)
                end
            eif param_kind != TypeKind.Void do
                native_write_i64(psym as i64, 16, param_kind as i64)
            else
                var p_ent = pass6_find_entity_ast(symbols, scopes, pass6_extract_base_name(param.name2))
                if (p_ent as i64) != 0 do
                    native_write_i64(psym as i64, 16, TypeKind.Entity as i64)
                eif pass6_is_array_type_str(param.name2) do
                    native_write_i64(psym as i64, 16, TypeKind.Array as i64)
                eif psym.type_id == 0 do
                    native_write_i64(psym as i64, 16, TypeKind.Int as i64)
                end
            end
        end
        if fat_str_len(param.name2) > 0 do
            pass6_set_var_type(param.name, param.name2)
        end
        i = i + 1
    end
    var j = body_idx
    when j < child_count loop
        child = vec_get_rt(node.children, j)
        pass6_walk(symbols, scopes, diag, child)
        j = j + 1
    end
    scope_pop(scopes)
    pass6_scope_exit()
    g_pass6_current_func_ret_type = old_cur_ret
    g_pass6_current_generic_params = old_cur_gen
    g_pass6_current_func_name = old_func_name
    out 0
end.

func pass6WalkVarDeclGroup(ref symbols: SymbolTable, ref scopes: ScopeTree, diag: &DiagnosticEngine, node: &AstNode) -> int:
    child_count = vec_len_rt(node.children)
    var vi = 0
    when vi < child_count loop
        child = vec_get_rt(node.children, vi)
        pass6_walk(symbols, scopes, diag, child)
        vi = vi + 1
    end
    out 0
end.

export pass6WalkVarDecl, pass6WalkConstDecl, pass6WalkFuncDef, pass6WalkVarDeclGroup
