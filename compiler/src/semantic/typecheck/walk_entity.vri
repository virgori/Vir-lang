##
 * compiler/src/semantic/typecheck/walk_entity.vri — Entity & Packed Walk Handlers
 * ==============================================================================
 * VIRC-PLN-0004 Section 5: AST walk handlers for EntityDef, PackedDef, RegisterDef,
 * and EntityLiteral nodes.
 *
 * Implements:
 * - pass6_check_packed_literal: validate packed literal fields and bounds
 * - pass6WalkEntityLiteral: walk and check entity/packed literals and IDE facts
 * - pass6WalkRegisterDef: validate register bit width constraints
 * - pass6WalkEntityDef: type-check entity and packed struct member definitions
 ##

include typecheck_context
include typecheck_index
include typecheck_entities
include ide_facts

func pass6_check_packed_literal(ref symbols: SymbolTable, ref scopes: ScopeTree, diag: &DiagnosticEngine, lit: &AstNode):
    if fat_str_len(lit.name) == 0 do out 0 end
    ent_ast = pass6_find_best_entity_ast(symbols, scopes, lit)
    if (ent_ast as i64) == 0 do out 0 end
    if ent_ast.node_type != AstType.PackedDef and ent_ast.node_type != AstType.EntityDef do out 0 end

    n_fields = vec_len_rt(ent_ast.children)
    n_args = vec_len_rt(lit.children)

    exp_names = vec_new_rt()
    field_buckets = pass6_global_map_new()
    var fi = 0
    when fi < n_fields loop
        f_node = vec_get_rt(ent_ast.children, fi) as AstNode
        if f_node.node_type != AstType.FuncDef do
            exp_names = vec_push_rt(exp_names, f_node.name as i64)
            let fbid = pass6_hash_name(f_node.name)
            var fbucket = vec_get_rt(field_buckets, fbid)
            fbucket = vec_push_rt(fbucket, f_node.name as i64)
            fbucket = vec_push_rt(fbucket, f_node.name2 as i64)
            vec_set_rt(field_buckets, fbid, fbucket)
        end
        fi = fi + 1
    end
    n_exp = vec_len_rt(exp_names)

    var seen_args = pass6_global_map_new()
    var ai = 0
    when ai < n_args loop
        arg = vec_get_rt(lit.children, ai) as AstNode
        aname = arg.name2
        let abid = pass6_hash_name(aname)
        var abucket = vec_get_rt(seen_args, abid)
        let ablen = vec_len_rt(abucket)
        var has_dup_arg = false
        var pi = 0
        when pi < ablen loop
            if fat_str_eq(vec_get_rt(abucket, pi) as string, aname) == 1 do
                has_dup_arg = true
                pi = ablen
            else
                pi = pi + 1
            end
        end
        if has_dup_arg do
            report_error(diag, 3010, lit.line, 0)
        else
            abucket = vec_push_rt(abucket, aname as i64)
            vec_set_rt(seen_args, abid, abucket)
        end
        let field_bid = pass6_hash_name(aname)
        let field_bucket = vec_get_rt(field_buckets, field_bid)
        let field_bucket_len = vec_len_rt(field_bucket)
        var ftype = fat_str_new("")
        var matched_field = false
        var k = 0
        when k < field_bucket_len loop
            if fat_str_eq(vec_get_rt(field_bucket, k) as string, aname) == 1 do
                ftype = vec_get_rt(field_bucket, k + 1) as string
                matched_field = true
                k = field_bucket_len
            else
                k = k + 2
            end
        end
        if not matched_field do
            report_error_loc(diag, 3008, 0, lit.line, 1, aname as string)
        else
            var arg_type = pass6_infer_type(symbols, scopes, arg)
            var f_ent = pass6_find_entity_ast(symbols, scopes, pass6_extract_base_name(ftype))
            if (f_ent as i64) != 0 do
                if arg.node_type == AstType.ArrayLiteral do
                    report_error(diag, 3011, arg.line, 0)
                eif arg.node_type == AstType.LiteralStr or (arg.node_type == AstType.LiteralInt and arg.int_val != 0) or arg.node_type == AstType.LiteralBool or arg.node_type == AstType.DictLiteral or arg.node_type == AstType.TupleExpr do
                    report_error(diag, 3011, arg.line, 0)
                eif arg.node_type == AstType.LiteralInt and arg.int_val == 0 do
                    # 0 is null pointer/entity reference
                else
                    var arg_ent_name = pass6_get_expr_type_str(symbols, scopes, arg)
                    if fat_str_len(arg_ent_name) > 0 do
                        if pass6_is_array_type_str(arg_ent_name) do
                            report_error(diag, 3011, arg.line, 0)
                        else
                            var a_ent_ast = pass6_find_entity_ast(symbols, scopes, pass6_extract_base_name(arg_ent_name))
                            if (a_ent_ast as i64) != 0 do
                                if pass6_type_strings_compatible(symbols, scopes, ftype, arg_ent_name) == 0 do
                                    report_error(diag, 3011, arg.line, 0)
                                end
                            end
                        end
                    end
                end
            eif pass6_is_array_type_str(ftype) do
                if arg.node_type == AstType.EntityLiteral do
                    report_error(diag, 3011, arg.line, 0)
                eif arg.node_type == AstType.LiteralStr or arg.node_type == AstType.LiteralInt or arg.node_type == AstType.LiteralBool or arg.node_type == AstType.DictLiteral or arg.node_type == AstType.TupleExpr do
                    report_error(diag, 3011, arg.line, 0)
                else
                    var arg_arr_str = pass6_get_expr_type_str(symbols, scopes, arg)
                    if fat_str_len(arg_arr_str) > 0 do
                        var a_ent_ast2 = pass6_find_entity_ast(symbols, scopes, pass6_extract_base_name(arg_arr_str))
                        if (a_ent_ast2 as i64) != 0 do
                            report_error(diag, 3011, arg.line, 0)
                        eif pass6_type_strings_compatible(symbols, scopes, ftype, arg_arr_str) == 0 do
                            report_error(diag, 3011, arg.line, 0)
                        end
                    end
                end
            else
                var dec_type = pass6_resolve_ffi_type(ftype)
                if dec_type != TypeKind.Void and dec_type != TypeKind.None and arg_type != TypeKind.Void do
                    var is_str_int_handle = ((dec_type == TypeKind.Int and arg_type == TypeKind.String) or (dec_type == TypeKind.String and arg_type == TypeKind.Int)) and (arg.node_type != AstType.LiteralStr and arg.node_type != AstType.LiteralInt)
                    if not is_str_int_handle and pass6_types_compatible(dec_type as i64, arg_type) == 0 do
                        report_error(diag, 3011, arg.line, 0)
                    end
                end
            end
            typecheck_check_int_literal_range(diag, ftype, arg)
        end
        ai = ai + 1
    end

    var ei = 0
    when ei < n_exp loop
        exp_name = vec_get_rt(exp_names, ei) as string
        let ebid = pass6_hash_name(exp_name)
        let ebucket = vec_get_rt(seen_args, ebid)
        let eblen = vec_len_rt(ebucket)
        var found = false
        var chk_i = 0
        when chk_i < eblen loop
            if fat_str_eq(vec_get_rt(ebucket, chk_i) as string, exp_name) == 1 do
                found = true
                chk_i = eblen
            else
                chk_i = chk_i + 1
            end
        end
        if not found do
            report_error(diag, 3029, lit.line, 0)
        end
        ei = ei + 1
    end
    out 0
end.



func pass6WalkEntityLiteral(ref symbols: SymbolTable, ref scopes: ScopeTree, diag: &DiagnosticEngine, node: &AstNode) -> int:
    pass6_check_packed_literal(symbols, scopes, diag, node)
    ent_ast = pass6_find_best_entity_ast(symbols, scopes, node)
    if (ent_ast as i64) != 0 do
        if g_ideFactsEnabled == 1 do
            var valueIndex = 0
            when valueIndex < vec_len_rt(node.children) loop
                let fieldValue = vec_get_rt(node.children, valueIndex) as AstNode
                let labelNode = ideFactProjection(fieldValue as int)
                if labelNode != 0 do
                    var fieldIndex = 0
                    when fieldIndex < vec_len_rt(ent_ast.children) loop
                        let fieldDecl = vec_get_rt(ent_ast.children, fieldIndex) as AstNode
                        if fieldDecl.node_type == AstType.Identifier do
                            if fat_str_eq(fieldDecl.name, fieldValue.name2) == 1 do
                                ideFactResolve(labelNode, ideFactSymbol(fieldDecl as int), scope_current_id(scopes), 4)
                            end
                        end
                        fieldIndex = fieldIndex + 1
                    end
                end
                valueIndex = valueIndex + 1
            end
        end
        if ent_ast.builtin_id != 0 do
            ent_decl_cnt = count_list_items(ent_ast.builtin_id as string)
            var ent_prov_cnt = 0
            if fat_str_len(node.name2) > 0 do
                ent_prov_cnt = count_list_items(node.name2)
            end
            if ent_decl_cnt != ent_prov_cnt do
                report_error(diag, 3085, node.line, 0)
            end
        end
    end
    out 0
end.

func pass6WalkRegisterDef(ref symbols: SymbolTable, ref scopes: ScopeTree, diag: &DiagnosticEngine, node: &AstNode) -> int:
    var base_bits = pass6_register_base_bits(node.name2)
    var rf_i = 0
    when rf_i < vec_len_rt(node.children) loop
        var rf = vec_get_rt(node.children, rf_i) as AstNode
        var rf_width = rf.builtin_id
        if rf_width <= 0 do
            report_error(diag, 3077, rf.line, 0)
        eif base_bits <= 0 or rf.int_val < 0 or rf.int_val + rf_width > base_bits do
            report_error(diag, 3078, rf.line, 0)
        end
        rf_i = rf_i + 1
    end
    out 0
end.

func pass6WalkEntityDef(ref symbols: SymbolTable, ref scopes: ScopeTree, diag: &DiagnosticEngine, node: &AstNode) -> int:
    if node.node_type == AstType.PackedDef do
        pass6_check_packed_def(symbols, scopes, diag, node)
    end
    old_ent = g_pass6_current_entity_name
    g_pass6_current_entity_name = node.name as i64
    pass6_set_var_type(fat_str_new("this"), node.name)
    pass6_scope_enter()
    scope_push(scopes, ScopeKind.Entity)
    child_count = vec_len_rt(node.children)
    var i = 0
    when i < child_count loop
        child = vec_get_rt(node.children, i)
        pass6CaptureIdeMember(symbols, scopes, child, ideFactSymbol(node as int))
        pass6_walk(symbols, scopes, diag, child)
        i = i + 1
    end
    scope_pop(scopes)
    pass6_scope_exit()
    g_pass6_current_entity_name = old_ent
    if old_ent != 0 do
        pass6_set_var_type(fat_str_new("this"), old_ent as string)
    end
    out 0
    out 0
end.

export pass6_check_packed_literal, pass6WalkEntityLiteral,
       pass6WalkRegisterDef, pass6WalkEntityDef
