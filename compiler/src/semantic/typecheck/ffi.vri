##
 * compiler/src/semantic/typecheck/ffi.vri — Foreign Function Interface Type Rules
 * =================================================================================
 * VIRC-PLN-0004 Section 5.5 (Phase 7 Part 11): FFI Type Rules Service.
 *
 * Implements type checking and resolution for FFI / extern declarations:
 * - Foreign type name to TypeKind resolution
 * - FFI primitive and pointer validity verification
 * - Extern AST node lookup
 ##

include typecheck_context
include typecheck_index
include typecheck_compatibility
include typecheck_calls

func typecheck_resolve_ffi_type(name: &string) -> TypeKind:
    out typecheck_resolve_type_name(name)
end.

func typecheck_is_valid_ffi_type(name: &string) -> bool:
    let tk = typecheck_resolve_ffi_type(name)
    if tk != TypeKind.Void and tk != TypeKind.None do out true end
    if fat_cstr_eq(name, "void") == 1 or fat_cstr_eq(name, "ptr") == 1 do out true end
    out false
end.

func typecheck_find_extern_node(extern_buckets: i64, name: &string) -> AstNode:
    out typecheck_find_extern_raw(extern_buckets, name)
end.

export typecheck_resolve_ffi_type,
       typecheck_is_valid_ffi_type,
       typecheck_find_extern_node
