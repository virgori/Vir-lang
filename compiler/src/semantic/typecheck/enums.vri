##
 * compiler/src/semantic/typecheck/enums.vri — Enum Definition & Evaluation Rules
 * ==============================================================================
 * VIRC-PLN-0004 Section 5.5 (Phase 7 Part 9): Enum Type Rules Service.
 *
 * Implements type checking and verification for enums:
 * - Enum definition validation (tag range 0..4294967295, duplicate tags: Errors 3039, 3040)
 * - Tagged enum detection (payload variants)
 * - Enum constructor arity validation (Error 3031)
 * - Tagged enum comparison restriction (Error 3043)
 * - Enum AST lookup by name from registry/buckets
 ##

include typecheck_context
include typecheck_index
include typecheck_compatibility

func typecheck_find_enum_ast_raw(enum_buckets: i64, name: &string) -> AstNode:
    if enum_buckets == 0 or fat_str_len(name) == 0 do out 0 as AstNode end
    let base_name = typecheck_extract_base_name(name)
    if fat_str_len(base_name) == 0 do out 0 as AstNode end
    let bid = typecheck_hash_name(base_name)
    let bucket = vec_get_rt(enum_buckets, bid)
    let count = vec_len_rt(bucket)
    var i = 0
    when i < count loop
        let candidate = vec_get_rt(bucket, i) as AstNode
        if fat_str_eq(candidate.name, base_name) == 1 do
            out candidate
        end
        i = i + 1
    end
    out 0 as AstNode
end.

func typecheck_enum_is_tagged(enum_ast: &AstNode) -> bool:
    if (enum_ast as i64) == 0 do out false end
    if enum_ast.children == 0 do out false end
    let vcount = vec_len_rt(enum_ast.children)
    var vi = 0
    when vi < vcount loop
        let vnode = vec_get_rt(enum_ast.children, vi) as AstNode
        if (vnode.children != 0 and vec_len_rt(vnode.children) > 0) or vnode.builtin_id > 0 do
            out true
        end
        vi = vi + 1
    end
    out false
end.

func typecheck_check_enum_def(diag: &DiagnosticEngine, node: &AstNode):
    let kids = node.children
    let vcount = vec_len_rt(kids)
    var buckets = typecheck_map_new()
    var vi = 0
    when vi < vcount loop
        let vnode = vec_get_rt(kids, vi) as AstNode
        let tag_val = vnode.int_val
        if tag_val < 0 or tag_val > 4294967295 do
            report_error(diag, 3040, vnode.line, 0)
        end
        var bid = tag_val and 255
        if bid < 0 do bid = 0 - bid end
        var bucket = vec_get_rt(buckets, bid)
        let blen = vec_len_rt(bucket)
        var has_dup = false
        var bi = 0
        when bi < blen loop
            if vec_get_rt(bucket, bi) == tag_val do
                has_dup = true
                bi = blen
            else
                bi = bi + 1
            end
        end
        if has_dup do
            report_error(diag, 3039, vnode.line, 0)
        else
            bucket = vec_push_rt(bucket, tag_val)
            vec_set_rt(buckets, bid, bucket)
        end
        vi = vi + 1
    end
end.

func typecheck_check_enum_construct(diag: &DiagnosticEngine, node: &AstNode) -> int:
    let child_count = vec_len_rt(node.children)
    var arg_start = 0
    var arg_count = child_count
    if child_count == node.builtin_id + 1 do
        let receiver = vec_get_rt(node.children, 0) as AstNode
        if receiver.node_type == AstType.Identifier and fat_str_eq(receiver.name, node.name2) == 1 do
            arg_start = 1
            arg_count = arg_count - 1
        end
    end
    if node.builtin_id != arg_count do
        report_error(diag, 3031, node.line, 0)
    end
    out arg_start
end.

func typecheck_check_enum_compare(diag: &DiagnosticEngine, left_enum: &AstNode, right_enum: &AstNode, line: int):
    if typecheck_enum_is_tagged(left_enum) or typecheck_enum_is_tagged(right_enum) do
        report_error(diag, 3043, line, 0)
    end
end.

export typecheck_find_enum_ast_raw,
       typecheck_enum_is_tagged,
       typecheck_check_enum_def,
       typecheck_check_enum_construct,
       typecheck_check_enum_compare
