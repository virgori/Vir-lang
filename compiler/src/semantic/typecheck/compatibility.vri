##
 * compiler/src/semantic/typecheck/compatibility.vri — Type Compatibility Service
 * ==============================================================================
 * VIRC-PLN-0003 Section 5.5: Type Compatibility Service.
 *
 * Defines explicit TypeCompatKind and rules for type compatibility,
 * widening, UFCS parameter matching, and type string unification.
 ##

include string_rt
import fat_str_len, fat_str_byte_at, fat_str_eq, fat_str_new, fat_str_slice, fat_cstr_eq from string_rt

include virc.semantic.type_table
import TypeKind, is_quantized_type_str, parse_quantized_codec, Q_CODEC_Q8_0 from virc.semantic.type_table

include virc.semantic.symbol_table
import SymbolTable from virc.semantic.symbol_table

include virc.semantic.scope_tree
import ScopeTree from virc.semantic.scope_tree

enum TypeCompatKind:
    Incompatible = 0,
    Exact = 1,
    AllowedConversion = 2,
    Poisoned = 3
end.

func typecheck_unwrap_type_name(name: &string) -> string:
    var tlen = fat_str_len(name)
    if tlen == 0 do out name end
    if tlen >= 5 and fat_str_byte_at(name, 0) == 38 and fat_str_byte_at(name, 1) == 109 and fat_str_byte_at(name, 2) == 117 and fat_str_byte_at(name, 3) == 116 and fat_str_byte_at(name, 4) == 32 do
        out fat_str_slice(name, 5, tlen - 5)
    end
    if tlen >= 4 and fat_str_byte_at(name, 0) == 38 and fat_str_byte_at(name, 1) == 109 and fat_str_byte_at(name, 2) == 117 and fat_str_byte_at(name, 3) == 116 do
        out fat_str_slice(name, 4, tlen - 4)
    end
    if tlen >= 4 and fat_str_byte_at(name, 0) == 114 and fat_str_byte_at(name, 1) == 101 and fat_str_byte_at(name, 2) == 102 and fat_str_byte_at(name, 3) == 32 do
        out fat_str_slice(name, 4, tlen - 4)
    end
    if tlen >= 4 and fat_str_byte_at(name, 0) == 109 and fat_str_byte_at(name, 1) == 117 and fat_str_byte_at(name, 2) == 116 and fat_str_byte_at(name, 3) == 32 do
        out fat_str_slice(name, 4, tlen - 4)
    end
    if tlen >= 2 and fat_str_byte_at(name, 0) == 38 and fat_str_byte_at(name, 1) == 32 do
        out fat_str_slice(name, 2, tlen - 2)
    end
    if tlen >= 1 and fat_str_byte_at(name, 0) == 38 do
        out fat_str_slice(name, 1, tlen - 1)
    end
    out name
end.

func typecheck_extract_base_name(type_str: &string) -> string:
    var unwrapped = typecheck_unwrap_type_name(type_str)
    let slen = fat_str_len(unwrapped)
    if slen <= 0 do out fat_str_new("") end
    if is_quantized_type_str(unwrapped as int) and parse_quantized_codec(unwrapped as int) == Q_CODEC_Q8_0 do
        out fat_str_new("Q80TensorView")
    end
    if fat_str_byte_at(unwrapped, 0) == 91 do
        out fat_str_new("[]")
    end
    var i = 0
    var end_pos = 0 - 1
    when i < slen loop
        let b = fat_str_byte_at(unwrapped, i)
        if b == 60 or b == 40 do
            end_pos = i
            i = slen
        else
            i = i + 1
        end
    end
    if end_pos >= 0 do
        when end_pos > 0 and fat_str_byte_at(unwrapped, end_pos - 1) == 32 loop
            end_pos = end_pos - 1
        end
        if end_pos >= 2 and fat_str_byte_at(unwrapped, end_pos - 2) == 111 and fat_str_byte_at(unwrapped, end_pos - 1) == 102 do
            if end_pos == 2 or fat_str_byte_at(unwrapped, end_pos - 3) == 32 do
                end_pos = end_pos - 2
                when end_pos > 0 and fat_str_byte_at(unwrapped, end_pos - 1) == 32 loop
                    end_pos = end_pos - 1
                end
            end
        end
        out fat_str_slice(unwrapped, 0, end_pos)
    end
    out unwrapped
end.

func typecheck_is_array_type_str(type_str: &string) -> bool:
    var unwrapped = typecheck_unwrap_type_name(type_str)
    let slen = fat_str_len(unwrapped)
    if slen >= 2 and fat_str_byte_at(unwrapped, 0) == 91 and fat_str_byte_at(unwrapped, slen - 1) == 93 do
        out true
    end
    out false
end.

func typecheck_extract_generic_or_array_elem(type_str: &string) -> string:
    var unwrapped = typecheck_unwrap_type_name(type_str)
    let slen = fat_str_len(unwrapped)
    if slen <= 2 do out fat_str_new("") end
    if fat_str_byte_at(unwrapped, 0) == 91 and fat_str_byte_at(unwrapped, slen - 1) == 93 do
        var arr_inner = fat_str_slice(unwrapped, 1, slen - 2)
        let in_len = fat_str_len(arr_inner)
        var semi_idx = 0 - 1
        var k = 0
        when k < in_len loop
            if fat_str_byte_at(arr_inner, k) == 59 do
                semi_idx = k
                k = in_len
            else
                k = k + 1
            end
        end
        if semi_idx >= 0 do
            when semi_idx > 0 and fat_str_byte_at(arr_inner, semi_idx - 1) == 32 loop
                semi_idx = semi_idx - 1
            end
            out fat_str_slice(arr_inner, 0, semi_idx)
        end
        out arr_inner
    end
    var start_idx = 0 - 1
    var end_idx = 0 - 1
    var depth = 0
    var i = 0
    when i < slen loop
        let b = fat_str_byte_at(unwrapped, i)
        if b == 60 or b == 40 do
            if start_idx < 0 do
                start_idx = i + 1
            end
            depth = depth + 1
        eif b == 62 or b == 41 do
            depth = depth - 1
            if depth == 0 and start_idx >= 0 do
                end_idx = i
            end
        end
        i = i + 1
    end
    if start_idx >= 0 do
        if end_idx < 0 do
            end_idx = slen
        end
        if end_idx > start_idx do
            out fat_str_slice(unwrapped, start_idx, end_idx - start_idx)
        end
    end
    out fat_str_new("")
end.

func typecheck_is_integer_like(k: i64) -> int:
    if k == TypeKind.Int as i64 or k == TypeKind.Enum as i64 do
        out 1
    end
    out 0
end.

func typecheck_check_compatibility(declared: i64, actual: TypeKind) -> TypeCompatKind:
    if declared == 0 or actual == TypeKind.Void do
        out TypeCompatKind.Incompatible
    end
    if declared == actual as i64 do
        out TypeCompatKind.Exact
    end
    if typecheck_is_integer_like(declared as TypeKind as i64) == 1 and typecheck_is_integer_like(actual as i64) == 1 do
        out TypeCompatKind.AllowedConversion
    end
    if (declared == TypeKind.Pointer as i64 and typecheck_is_integer_like(actual as i64) == 1) or (typecheck_is_integer_like(declared as i64) == 1 and actual == TypeKind.Pointer) do
        out TypeCompatKind.AllowedConversion
    end
    # Numeric widening: integer literals and values can be assigned to float variables.
    if declared == TypeKind.Float as i64 and typecheck_is_integer_like(actual as i64) == 1 do
        out TypeCompatKind.AllowedConversion
    end
    out TypeCompatKind.Incompatible
end.

func typecheck_types_compatible(declared: i64, actual: TypeKind) -> int:
    let res = typecheck_check_compatibility(declared, actual)
    if res == TypeCompatKind.Exact or res == TypeCompatKind.AllowedConversion do
        out 1
    end
    out 0
end.

func typecheck_ufcs_types_compatible(declared: i64, actual: TypeKind) -> int:
    if actual == TypeKind.Void or actual == TypeKind.None do
        out 0
    end
    if declared == actual as i64 do
        out 1
    end
    if declared == 0 do
        out 1
    end
    let dec_is_int = (declared == TypeKind.Int as i64 or declared == TypeKind.Enum as i64)
    let act_is_int = (actual == TypeKind.Int or actual == TypeKind.Enum)
    if dec_is_int and act_is_int do
        out 1
    end
    if declared == TypeKind.Bool as i64 and act_is_int do
        out 1
    end
    if actual == TypeKind.Bool and dec_is_int do
        out 1
    end
    if declared == TypeKind.Pointer as i64 and actual == TypeKind.Pointer do
        out 1
    end
    out 0
end.

func typecheck_param_types_compatible(declared: i64, actual: i64) -> int:
    if declared == TypeKind.Int as i64 and actual == TypeKind.Bool as i64 do out 0 end
    if declared == TypeKind.Bool as i64 and actual == TypeKind.Int as i64 do out 0 end
    out typecheck_types_compatible(declared, actual as TypeKind)
end.

func typecheck_type_strings_compatible(ref symbols: SymbolTable, ref scopes: ScopeTree, expected: &string, actual: &string) -> int:
    if fat_str_len(expected) == 0 or fat_str_len(actual) == 0 do
        out 1
    end
    var exp_un = typecheck_unwrap_type_name(expected)
    var act_un = typecheck_unwrap_type_name(actual)
    if fat_str_eq(exp_un, act_un) == 1 do
        out 1
    end
    var exp_is_arr = typecheck_is_array_type_str(exp_un)
    var act_is_arr = typecheck_is_array_type_str(act_un)
    if exp_is_arr and not act_is_arr do
        out 0
    end
    if not exp_is_arr and act_is_arr do
        out 0
    end
    if exp_is_arr and act_is_arr do
        var exp_elem = typecheck_extract_generic_or_array_elem(exp_un)
        var act_elem = typecheck_extract_generic_or_array_elem(act_un)
        if fat_str_len(act_elem) == 0 do
            out 1
        end
        out typecheck_type_strings_compatible(symbols, scopes, exp_elem, act_elem)
    end
    var exp_base = typecheck_extract_base_name(exp_un)
    var act_base = typecheck_extract_base_name(act_un)
    if fat_str_eq(exp_base, act_base) == 0 do
        out 0
    end
    var exp_gen = typecheck_extract_generic_or_array_elem(exp_un)
    var act_gen = typecheck_extract_generic_or_array_elem(act_un)
    if fat_str_len(exp_gen) > 0 and fat_str_len(act_gen) > 0 do
        out typecheck_type_strings_compatible(symbols, scopes, exp_gen, act_gen)
    end
    out 1
end.

func typecheck_resolve_type_name(name: &string) -> TypeKind:
    let resolved_name = typecheck_unwrap_type_name(name)
    let nlen = fat_str_len(resolved_name)
    if nlen == 0 do out TypeKind.Void end
    if nlen >= 2 and fat_str_byte_at(resolved_name, 0) == 91 and fat_str_byte_at(resolved_name, nlen - 1) == 93 do
        out TypeKind.Array
    end
    if fat_cstr_eq(resolved_name, "int") == 1 or fat_cstr_eq(resolved_name, "i8") == 1 or fat_cstr_eq(resolved_name, "i16") == 1 or fat_cstr_eq(resolved_name, "i32") == 1 or fat_cstr_eq(resolved_name, "i64") == 1 or fat_cstr_eq(resolved_name, "uint") == 1 or fat_cstr_eq(resolved_name, "u8") == 1 or fat_cstr_eq(resolved_name, "u16") == 1 or fat_cstr_eq(resolved_name, "u32") == 1 or fat_cstr_eq(resolved_name, "u64") == 1 do out TypeKind.Int end
    if fat_cstr_eq(resolved_name, "float") == 1 or fat_cstr_eq(resolved_name, "f32") == 1 or fat_cstr_eq(resolved_name, "f64") == 1 do out TypeKind.Float end
    if fat_cstr_eq(resolved_name, "bool") == 1 do out TypeKind.Bool end
    if fat_cstr_eq(resolved_name, "string") == 1 do out TypeKind.String end
    if fat_cstr_eq(resolved_name, "ptr") == 1 do out TypeKind.Pointer end
    if fat_cstr_eq(resolved_name, "none") == 1 or fat_cstr_eq(resolved_name, "void") == 1 do out TypeKind.None end
    out TypeKind.Void
end.

export TypeCompatKind,
       typecheck_unwrap_type_name, typecheck_extract_base_name,
       typecheck_is_array_type_str, typecheck_extract_generic_or_array_elem,
       typecheck_is_integer_like, typecheck_check_compatibility,
       typecheck_types_compatible, typecheck_ufcs_types_compatible,
       typecheck_param_types_compatible, typecheck_type_strings_compatible,
       typecheck_resolve_type_name
