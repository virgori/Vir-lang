##
 * compiler/src/semantic/typecheck/assignment.vri — Assignment Rules and L-Value Verification
 * ========================================================================================
 * VIRC-PLN-0003 Section 5.5: Assignment Rules Service.
 *
 * Implements L-Value validity verification, shared reference immutability checks,
 * and assignment type compatibility with null-coercion and compiler-mode rules.
 ##

include vec_rt
import vec_len_rt, vec_get_rt, vec_push_rt, vec_set_rt, vec_new_rt from vec_rt

include string_rt
import fat_str_len, fat_str_byte_at, fat_str_eq, fat_str_new, fat_str_slice, fat_cstr_eq from string_rt

include virc.frontend.parser

include virc.semantic.type_table
import TypeKind, TYPE_VOID, TYPE_INT, TYPE_FLOAT, TYPE_BOOL, TYPE_STRING from virc.semantic.type_table

include virc.semantic.symbol_table
import SymbolTable, SymbolKind, SymbolNode from virc.semantic.symbol_table

include virc.semantic.scope_tree
import ScopeTree, scope_current_id from virc.semantic.scope_tree

include virc.semantic.typecheck.context
import TypecheckContext from virc.semantic.typecheck.context

include virc.semantic.typecheck.compatibility
import typecheck_is_integer_like, typecheck_types_compatible,
       typecheck_unwrap_type_name, typecheck_extract_base_name from virc.semantic.typecheck.compatibility

func typecheck_is_assignable_lhs(node: &AstNode) -> int:
    if (node as i64) == 0 do out 0 end
    if node.node_type == AstType.Identifier or node.node_type == AstType.FieldAccess or node.node_type == AstType.IndexAccess do
        out 1
    end
    out 0
end.

func typecheck_is_shared_ref_type(type_str: &string) -> bool:
    let blen = fat_str_len(type_str)
    if blen == 0 do out false end
    if fat_str_byte_at(type_str, 0) == 38 do # '&'
        var has_mut = false
        if blen >= 4 and fat_str_byte_at(type_str, 1) == 109 and fat_str_byte_at(type_str, 2) == 117 and fat_str_byte_at(type_str, 3) == 116 do # "&mut"
            has_mut = true
        end
        if not has_mut do
            out true
        end
        out false
    end
    if blen >= 4 and fat_str_byte_at(type_str, 0) == 114 and fat_str_byte_at(type_str, 1) == 101 and fat_str_byte_at(type_str, 2) == 102 and fat_str_byte_at(type_str, 3) == 32 do # "ref "
        out true
    end
    out false
end.

func typecheck_assignment_allows_coercion(lhs_type: i64, rhs_type: TypeKind, rhs_node_type: AstType, rhs_int_val: int, is_user_mod: int) -> int:
    # Null pointer/reference: 0 assigned to Entity, Ref, MutRef, Pointer, Optional
    if (lhs_type == TypeKind.Entity as i64 or lhs_type == TypeKind.Ref as i64 or lhs_type == TypeKind.MutRef as i64 or lhs_type == TypeKind.Pointer as i64 or lhs_type == TypeKind.Optional as i64) and rhs_node_type == AstType.LiteralInt and rhs_int_val == 0 do
        out 1
    end
    # Int <-> String bridge
    if (lhs_type == TypeKind.Int as i64 and rhs_type == TypeKind.String) or (lhs_type == TypeKind.String as i64 and typecheck_is_integer_like(rhs_type as i64) == 1) do
        out 1
    end
    # In system/compiler modules (not user code), relaxed bool <-> int and Entity <-> int
    if is_user_mod == 0 do
        if (lhs_type == TypeKind.Entity as i64 and typecheck_is_integer_like(rhs_type as i64) == 1) or (typecheck_is_integer_like(lhs_type) == 1 and rhs_type == TypeKind.Entity) do
            out 1
        end
        if (lhs_type == TypeKind.Bool as i64 and typecheck_is_integer_like(rhs_type as i64) == 1) or (typecheck_is_integer_like(lhs_type) == 1 and rhs_type == TypeKind.Bool) do
            out 1
        end
    end
    out 0
end.

func typecheck_check_assign_types(lhs_type: i64, rhs_type: TypeKind, rhs_node_type: AstType, rhs_int_val: int, is_user_mod: int) -> int:
    if lhs_type == 0 or rhs_type == TypeKind.Void do
        out 1
    end
    if typecheck_types_compatible(lhs_type, rhs_type) == 1 do
        out 1
    end
    out typecheck_assignment_allows_coercion(lhs_type, rhs_type, rhs_node_type, rhs_int_val, is_user_mod)
end.

export typecheck_is_assignable_lhs, typecheck_is_shared_ref_type,
       typecheck_assignment_allows_coercion, typecheck_check_assign_types
