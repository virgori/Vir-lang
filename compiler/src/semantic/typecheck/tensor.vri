##
 * compiler/src/semantic/typecheck/tensor.vri — Tensor & Quantized Operations Type Rules
 * ====================================================================================
 * VIRC-PLN-0004 Section 5.5: Tensor Type Rules Service.
 *
 * Implements type checking and resolution for tensors and quantized tensors:
 * - Tensor annotation extraction from identifiers and quantize expressions
 * - Quantize expression validation (element type float, valid bit widths 4/8/16/32)
 * - Matmul / FMA operand shape and dimension compatibility verification
 * - AI-mode quantized tensor operation gating
 ##

include typecheck_context

func typecheck_check_quantize_bits(bits: int) -> int:
    if bits == 4 or bits == 8 or bits == 16 or bits == 32 do
        out 0
    end
    out 3019
end.

func typecheck_check_quantize_val(val_type: TypeKind, tensor_name: &string) -> int:
    if val_type != TypeKind.Tensor do
        out 3018
    end
    if not is_tensor_type_str(tensor_name) or parse_tensor_elem_type(tensor_name) != TypeKind.Float do
        out 3018
    end
    out 0
end.

func typecheck_check_matmul_dimensions(type_a_str: &string, type_b_str: &string, lt: TypeKind, rt: TypeKind, is_ai_mode: int) -> int:
    var is_q_a = false
    var is_q_b = false
    if lt == TypeKind.QuantizedTensor or is_quantized_type_str(type_a_str as int) do is_q_a = true end
    if rt == TypeKind.QuantizedTensor or is_quantized_type_str(type_b_str as int) do is_q_b = true end

    if is_q_a or is_q_b do
        if is_ai_mode != 1 do
            out 3023
        end
    end

    if lt != TypeKind.Void and lt != TypeKind.Tensor and lt != TypeKind.QuantizedTensor do
        out 3002
    end
    if rt != TypeKind.Void and rt != TypeKind.Tensor and rt != TypeKind.QuantizedTensor do
        out 3002
    end

    let a_is_valid = is_tensor_type_str(type_a_str) or is_quantized_type_str(type_a_str as int)
    let b_is_valid = is_tensor_type_str(type_b_str) or is_quantized_type_str(type_b_str as int)
    if not a_is_valid or not b_is_valid do
        out 3014
    end

    var shape_a = 0
    var elem_a = TypeKind.Float
    var rank_a = 0
    if is_quantized_type_str(type_a_str as int) do
        shape_a = parse_quantized_shape(type_a_str as int)
        elem_a = parse_quantized_elem_type(type_a_str as int)
        rank_a = parse_quantized_rank(type_a_str as int)
    else
        shape_a = parse_tensor_shape(type_a_str)
        elem_a = parse_tensor_elem_type(type_a_str)
        rank_a = vec_len_rt(shape_a)
    end

    var shape_b = 0
    var elem_b = TypeKind.Float
    var rank_b = 0
    if is_quantized_type_str(type_b_str as int) do
        shape_b = parse_quantized_shape(type_b_str as int)
        elem_b = parse_quantized_elem_type(type_b_str as int)
        rank_b = parse_quantized_rank(type_b_str as int)
    else
        shape_b = parse_tensor_shape(type_b_str)
        elem_b = parse_tensor_elem_type(type_b_str)
        rank_b = vec_len_rt(shape_b)
    end

    if elem_a != elem_b do
        out 3007
    end

    if rank_a != 2 or rank_b != 2 do
        out 3014
    end

    let k_a = vec_get_rt(shape_a, 1) as i64
    let k_b = vec_get_rt(shape_b, 0) as i64
    if k_a != k_b do
        out 3014
    end

    out 0
end.

export typecheck_check_quantize_bits, typecheck_check_quantize_val,
       typecheck_check_matmul_dimensions
