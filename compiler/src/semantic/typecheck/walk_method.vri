##
 * compiler/src/semantic/typecheck/walk_method.vri — Method Call Verification
 * =========================================================================
 * VIRC-PLN-0004 Section 5: AST walk handlers for method calls and receivers.
 *
 * Implements:
 * - pass6_check_method_call: validate method calls, entity methods, UFCS fallback
 * - pass6_check_method_mut_args: validate mutable arguments to methods
 ##

include typecheck_context
include typecheck_methods
include typecheck_generics
include typecheck_lvalue

func pass6_report_ufcs_mismatch(diag: &DiagnosticEngine, node: &AstNode, fallback_node: &AstNode):
    var span_id = 0
    if (fallback_node as i64) != 0 and fallback_node.span_id > 0 do
        span_id = fallback_node.span_id
    eif (node as i64) != 0 and node.span_id > 0 do
        span_id = node.span_id
    end
    if span_id > 0 do
        report_error_span(diag, 3001, span_id, "")
    else
        var err_line = node.line
        var err_col = node.int_val
        if (fallback_node as i64) != 0 and fallback_node.line > 0 do
            err_line = fallback_node.line
            err_col = fallback_node.int_val
        end
        if err_col <= 0 do err_col = 1 end
        report_error_loc(diag, 3001, 0, err_line, err_col, "")
    end
end.

func pass6_report_ufcs_ambiguity(diag: &DiagnosticEngine, node: &AstNode):
    if node.span_id > 0 do
        report_error_span(diag, 3052, node.span_id, "")
    else
        var call_col = node.int_val
        if call_col <= 0 do call_col = 1 end
        report_error_loc(diag, 3052, 0, node.line, call_col, "")
    end
end.

func pass6_check_method_call(ref symbols: SymbolTable, ref scopes: ScopeTree, diag: &DiagnosticEngine, node: &AstNode):
    child_count = vec_len_rt(node.children)
    if child_count <= 0 do
        if node.span_id > 0 do
            report_error_span(diag, 3021, node.span_id, "")
        else
            var call_col = node.int_val
            if call_col <= 0 do call_col = 1 end
            report_error_loc(diag, 3021, 0, node.line, call_col, "")
        end
        out 0
    end
    var ci = 0
    when ci < child_count loop
        pass6_walk(symbols, scopes, diag, vec_get_rt(node.children, ci))
        ci = ci + 1
    end

    recv = vec_get_rt(node.children, 0)
    nargs = child_count - 1
    mname = node.name
    recv_ent_name = pass6_get_receiver_entity_name(symbols, scopes, recv)

    # Priority 1: Entity Method
    if fat_str_len(recv_ent_name) > 0 do
        recv_base_name = pass6_extract_base_name(recv_ent_name)
        ent_ast = pass6_find_entity_ast(symbols, scopes, recv_base_name)
        if ent_ast != 0 do
            let found_method = typecheck_find_entity_method(ent_ast, mname)
            if found_method != 0 do
                let m_param_count = typecheck_method_param_count(found_method)
                let has_this = typecheck_method_has_this(found_method)
                var expected_nargs = m_param_count
                if has_this == 1 do
                    expected_nargs = expected_nargs - 1
                end
                if nargs != expected_nargs do
                    report_error(diag, 3022, node.line, 0)
                    out 0
                end

                var is_type_receiver = 0
                if recv.node_type == AstType.Identifier do
                    if pass6_find_entity_ast(symbols, scopes, recv.name) != 0 do
                        var is_local_var = 0
                        var chk_sid = pass6_lookup_chain(symbols, scopes, scope_current_id(scopes), recv.name)
                        if chk_sid != -1 do
                            var sym_chk = pass6_symbol_at(symbols, chk_sid)
                            if sym_chk.kind == SymbolKind.Variable or sym_chk.kind == SymbolKind.Param do
                                is_local_var = 1
                            end
                        end
                        if is_local_var == 0 do
                            is_type_receiver = 1
                        end
                    end
                end
                if is_type_receiver == 1 and has_this == 1 do
                    report_error(diag, 3021, node.line, 0)
                    out 0
                end
                if is_type_receiver == 1 and ent_ast.builtin_id != 0 and fat_str_len(node.name2) > 0 do
                    recv_ent_name = fat_str_concat(recv_base_name, fat_str_concat(fat_str_new("<"), fat_str_concat(node.name2, fat_str_new(">"))))
                    node.name2 = fat_str_new("")
                end
                if is_type_receiver == 1 and ent_ast.builtin_id != 0 and fat_str_len(node.name2) == 0 and fat_str_len(pass6_extract_generic_args_content(recv_ent_name)) == 0 do
                    let e_params_str = ent_ast.builtin_id as string
                    let e_p_names = typecheck_split_list_items(e_params_str)
                    let e_num_p = vec_len_rt(e_p_names)
                    var e_inferred = vec_new_rt()
                    var e_init_i = 0
                    when e_init_i < e_num_p loop
                        e_inferred = vec_push_rt(e_inferred, fat_str_new("") as i64)
                        e_init_i = e_init_i + 1
                    end
                    var e_inf_i = 0
                    when e_inf_i < nargs loop
                        let e_p_node = vec_get_rt(found_method.children, e_inf_i) as AstNode
                        let e_formal = e_p_node.name2
                        let e_arg_node = vec_get_rt(node.children, 1 + e_inf_i) as AstNode
                        var e_actual = pass6_get_expr_type_str(symbols, scopes, e_arg_node)
                        if fat_str_len(e_actual) == 0 do
                            let e_k = pass6_infer_type(symbols, scopes, e_arg_node)
                            e_actual = pass6_type_kind_to_str(e_k)
                        end
                        if fat_str_len(e_formal) > 0 and fat_str_len(e_actual) > 0 do
                            typecheck_bind_generic_param(e_p_names, e_inferred, e_formal, e_actual)
                        end
                        e_inf_i = e_inf_i + 1
                    end
                    var e_gen_str = fat_str_new("")
                    var e_chk_i = 0
                    var e_all_ok = 1
                    when e_chk_i < e_num_p loop
                        let inf_e_val = vec_get_rt(e_inferred, e_chk_i) as string
                        if (inf_e_val as i64) == 0 or fat_str_len(inf_e_val) == 0 do
                            e_all_ok = 0
                        end
                        if e_chk_i == 0 do
                            e_gen_str = inf_e_val
                        else
                            e_gen_str = fat_str_concat(fat_str_concat(e_gen_str, fat_str_new(", ")), inf_e_val)
                        end
                        e_chk_i = e_chk_i + 1
                    end
                    if e_all_ok == 1 and fat_str_len(e_gen_str) > 0 do
                        recv_ent_name = fat_str_concat(recv_base_name, fat_str_concat(fat_str_new("<"), fat_str_concat(e_gen_str, fat_str_new(">"))))
                    end
                end
                if is_type_receiver == 1 and ent_ast.builtin_id != 0 and fat_str_len(pass6_extract_generic_args_content(recv_ent_name)) == 0 do
                    report_error(diag, 3001, node.line, 0)
                    out 0
                end

                # Infer method-level generic parameters if present
                var method_gen_args = fat_str_new("")
                if found_method.builtin_id != 0 do
                    let m_params_str = found_method.builtin_id as string
                    let m_p_names = typecheck_split_list_items(m_params_str)
                    let m_num_p = vec_len_rt(m_p_names)
                    var m_inferred_args = vec_new_rt()
                    var m_init_i = 0
                    when m_init_i < m_num_p loop
                        m_inferred_args = vec_push_rt(m_inferred_args, fat_str_new("") as i64)
                        m_init_i = m_init_i + 1
                    end

                    var m_ent_p = fat_str_new("")
                    var m_ent_a = fat_str_new("")
                    if ent_ast.builtin_id != 0 do
                        m_ent_p = ent_ast.builtin_id as string
                        m_ent_a = pass6_extract_generic_args_content(recv_ent_name)
                    end

                    var inf_i = 0
                    when inf_i < nargs loop
                        var inf_param_pos = inf_i
                        if has_this == 1 do
                            inf_param_pos = inf_param_pos + 1
                        end
                        let inf_p_node = vec_get_rt(found_method.children, inf_param_pos) as AstNode
                        var inf_formal = inf_p_node.name2
                        if fat_str_len(m_ent_a) > 0 do
                            inf_formal = pass6_substitute_generic_type(m_ent_p, m_ent_a, inf_formal)
                        end
                        let inf_arg_node = vec_get_rt(node.children, 1 + inf_i) as AstNode
                        var inf_actual = pass6_get_expr_type_str(symbols, scopes, inf_arg_node)
                        if fat_str_len(inf_actual) == 0 do
                            let inf_k = pass6_infer_type(symbols, scopes, inf_arg_node)
                            inf_actual = pass6_type_kind_to_str(inf_k)
                        end
                        if fat_str_len(inf_formal) > 0 and fat_str_len(inf_actual) > 0 do
                            let bind_ok = typecheck_bind_generic_param(m_p_names, m_inferred_args, inf_formal, inf_actual)
                            if bind_ok == 0 do
                                pass6_report_ufcs_mismatch(diag, node, inf_arg_node)
                                out 0
                            end
                        end
                        inf_i = inf_i + 1
                    end

                    var m_check_i = 0
                    when m_check_i < m_num_p loop
                        let inf_val = vec_get_rt(m_inferred_args, m_check_i) as string
                        if (inf_val as i64) == 0 or fat_str_len(inf_val) == 0 do
                            report_error(diag, 3001, node.line, 0)
                            out 0
                        end
                        if m_check_i == 0 do
                            method_gen_args = inf_val
                        else
                            method_gen_args = fat_str_concat(fat_str_concat(method_gen_args, fat_str_new(", ")), inf_val)
                        end
                        m_check_i = m_check_i + 1
                    end
                end

                var ai = 0
                when ai < nargs loop
                    param_pos = ai
                    if has_this == 1 do
                        param_pos = param_pos + 1
                    end
                    param_node = vec_get_rt(found_method.children, param_pos)
                    var param_type_str = param_node.name2
                    if ent_ast.builtin_id != 0 do
                        let gen_params = ent_ast.builtin_id as string
                        let gen_args = pass6_extract_generic_args_content(recv_ent_name)
                        if fat_str_len(gen_args) > 0 do
                            param_type_str = pass6_substitute_generic_type(gen_params, gen_args, param_node.name2)
                        end
                    end
                    if fat_str_len(method_gen_args) > 0 do
                        let m_params_str = found_method.builtin_id as string
                        param_type_str = pass6_substitute_generic_type(m_params_str, method_gen_args, param_type_str)
                    end
                    expected_ty = pass6_resolve_ffi_type(param_type_str)
                    arg_node = vec_get_rt(node.children, 1 + ai)
                    actual_ty = pass6_infer_type(symbols, scopes, arg_node)
                    var m_p_ent = pass6_find_entity_ast(symbols, scopes, pass6_extract_base_name(param_type_str))
                    if (m_p_ent as i64) != 0 do
                        if arg_node.node_type == AstType.ArrayLiteral do
                            pass6_report_type_mismatch(diag, symbols, scopes, node, arg_node, param_type_str, "[any]")
                            out 0
                        eif arg_node.node_type == AstType.LiteralStr or (arg_node.node_type == AstType.LiteralInt and arg_node.int_val != 0) or arg_node.node_type == AstType.LiteralBool or arg_node.node_type == AstType.DictLiteral or arg_node.node_type == AstType.TupleExpr do
                            pass6_report_type_mismatch(diag, symbols, scopes, node, arg_node, param_type_str, "")
                            out 0
                        eif arg_node.node_type == AstType.LiteralInt and arg_node.int_val == 0 do
                            # 0 is null pointer/entity reference
                        else
                            var m_arg_str = pass6_get_expr_type_str(symbols, scopes, arg_node)
                            if fat_str_len(m_arg_str) > 0 do
                                if pass6_is_array_type_str(m_arg_str) do
                                    pass6_report_type_mismatch(diag, symbols, scopes, node, arg_node, param_type_str, m_arg_str)
                                    out 0
                                else
                                    var m_a_ent = pass6_find_entity_ast(symbols, scopes, pass6_extract_base_name(m_arg_str))
                                    if (m_a_ent as i64) != 0 do
                                        if pass6_type_strings_compatible(symbols, scopes, param_type_str, m_arg_str) == 0 do
                                            pass6_report_type_mismatch(diag, symbols, scopes, node, arg_node, param_type_str, m_arg_str)
                                            out 0
                                        end
                                    end
                                end
                            end
                        end
                    eif pass6_is_array_type_str(param_type_str) do
                        if arg_node.node_type == AstType.EntityLiteral do
                            pass6_report_type_mismatch(diag, symbols, scopes, node, arg_node, param_type_str, arg_node.name)
                            out 0
                        eif arg_node.node_type == AstType.LiteralStr or arg_node.node_type == AstType.LiteralInt or arg_node.node_type == AstType.LiteralBool or arg_node.node_type == AstType.DictLiteral or arg_node.node_type == AstType.TupleExpr do
                            pass6_report_type_mismatch(diag, symbols, scopes, node, arg_node, param_type_str, "")
                            out 0
                        else
                            var m_arg_arr_str = pass6_get_expr_type_str(symbols, scopes, arg_node)
                            if fat_str_len(m_arg_arr_str) > 0 do
                                var m_a_ent2 = pass6_find_entity_ast(symbols, scopes, pass6_extract_base_name(m_arg_arr_str))
                                if (m_a_ent2 as i64) != 0 do
                                    pass6_report_type_mismatch(diag, symbols, scopes, node, arg_node, param_type_str, m_arg_arr_str)
                                    out 0
                                eif pass6_type_strings_compatible(symbols, scopes, param_type_str, m_arg_arr_str) == 0 do
                                    pass6_report_type_mismatch(diag, symbols, scopes, node, arg_node, param_type_str, m_arg_arr_str)
                                    out 0
                                end
                            end
                        end
                    else
                        if expected_ty != TypeKind.Void and actual_ty != TypeKind.Void and pass6_ufcs_types_compatible(expected_ty, actual_ty) == 0 do
                            pass6_report_ufcs_mismatch(diag, node, arg_node)
                            out 0
                        end
                    end
                    ai = ai + 1
                end
                if has_this == 1 do
                    pass6_check_method_mut_args(symbols, scopes, diag, found_method, node, 0, 0, 1 + nargs)
                else
                    pass6_check_method_mut_args(symbols, scopes, diag, found_method, node, 1, 0, nargs)
                end
                ideFactResolve(node as int, ideFactSymbol(found_method as int), scope_current_id(scopes), 3)
                node.builtin_id = 201
                # Keep receiver type and any inferred method generic arguments
                if fat_str_len(method_gen_args) > 0 do
                    node.name2 = fat_str_concat(fat_str_concat(recv_ent_name, fat_str_new(";")), method_gen_args)
                else
                    node.name2 = recv_ent_name
                end
                out 0
            end

            # Priority 2: Callable Field
            let found_field = typecheck_find_entity_field(ent_ast, mname)
            if found_field != 0 do
                var ft_str = found_field.name2
                if ent_ast.builtin_id != 0 do
                    let gen_params = ent_ast.builtin_id as string
                    let gen_args = pass6_extract_generic_args_content(recv_ent_name)
                    if fat_str_len(gen_args) > 0 do
                        ft_str = pass6_substitute_generic_type(gen_params, gen_args, found_field.name2)
                    end
                end
                var is_callable = 0
                if fat_str_len(ft_str) >= 4 do
                    if fat_str_byte_at(ft_str, 0) == 102 and fat_str_byte_at(ft_str, 1) == 117 and fat_str_byte_at(ft_str, 2) == 110 and fat_str_byte_at(ft_str, 3) == 99 do
                        is_callable = 1
                    end
                end
                if is_callable == 1 do
                    expected_params = pass6_count_callable_params(ft_str)
                    if expected_params >= 0 and nargs != expected_params do
                        report_error(diag, 3022, node.line, 0)
                        out 0
                    end
                    var field_ai = 0
                    when field_ai < nargs loop
                        field_param_name = pass6_callable_param_type(ft_str, field_ai)
                        field_expected = pass6_resolve_ffi_type(field_param_name)
                        field_arg = vec_get_rt(node.children, 1 + field_ai)
                        field_actual = pass6_infer_type(symbols, scopes, field_arg)
                        if field_expected != TypeKind.Void and field_actual != TypeKind.Void and pass6_ufcs_types_compatible(field_expected, field_actual) == 0 do
                            pass6_report_ufcs_mismatch(diag, node, field_arg)
                            out 0
                        end
                        field_ai = field_ai + 1
                    end
                    node.builtin_id = 202
                    node.name2 = recv_ent_name
                    out 0
                end
            end
        end
    end

    # Builtin Port UFCS is intentionally narrow: only values produced by
    # `port(...)` receive the send/recv surface.  Opaque pointers never do.
    if fat_cstr_eq(recv_ent_name, "port") == 1 do
        if fat_cstr_eq(mname, "send") == 1 do
            if nargs != 1 do
                report_error(diag, 3022, node.line, 0)
                out 0
            end
            send_arg = vec_get_rt(node.children, 1)
            send_ty = pass6_infer_type(symbols, scopes, send_arg)
            if send_ty != TypeKind.Void & send_ty != TypeKind.Int do
                pass6_report_ufcs_mismatch(diag, node, send_arg)
                out 0
            end
            node.builtin_id = 203
            node.name2 = mname
            out 0
        end
        if fat_cstr_eq(mname, "recv") == 1 do
            if nargs != 0 do
                report_error(diag, 3022, node.line, 0)
                out 0
            end
            node.builtin_id = 203
            node.name2 = mname
            out 0
        end
    end

    # Priority 3: Free Function / Builtin UFCS
    var recv_actual = pass6_infer_type(symbols, scopes, recv)
    var recv_is_module = 0
    var recv_is_unresolved = 0
    var recv_sid = -1
    if recv.node_type == AstType.Identifier do
        recv_sid = pass6_lookup_chain(symbols, scopes, scope_current_id(scopes), recv.name)
        if recv_sid == -1 do
            recv_sid = pass6_lookup_chain(symbols, scopes, 0, recv.name)
        end
        if recv_sid != -1 do
            var rsym = pass6_symbol_at(symbols, recv_sid)
            if rsym.kind == SymbolKind.Module do
                recv_is_module = 1
            end
        else
            recv_is_unresolved = 1
        end
    end

    if recv_is_module == 0 and recv_is_unresolved == 0 and recv_actual != TypeKind.None and (recv_actual != TypeKind.Void or recv_sid != -1) do
        free_sym_id = -1
        if is_user_module(g_pass6_cur_module) == 1 do
            let mod_mname = fat_str_concat(fat_str_concat(g_pass6_cur_module, fat_str_new(".")), mname)
            if pass6_count_funcs_by_canonical_identity(mod_mname) > 1 do
                pass6_report_ufcs_ambiguity(diag, node)
                out 0
            end
            free_sym_id = pass6_lookup_chain(symbols, scopes, scope_current_id(scopes), mod_mname)
            if free_sym_id == -1 do
                free_sym_id = pass6_lookup_chain(symbols, scopes, 0, mod_mname)
            end
        end
        if free_sym_id == -1 do
            if pass6_count_funcs_by_canonical_identity(mname) > 1 do
                pass6_report_ufcs_ambiguity(diag, node)
                out 0
            end
            free_sym_id = pass6_lookup_chain(symbols, scopes, scope_current_id(scopes), mname)
        end
        if free_sym_id == -1 do
            free_sym_id = pass6_lookup_chain(symbols, scopes, 0, mname)
        end
        if free_sym_id != -1 do
            free_sym = pass6_symbol_at(symbols, free_sym_id)
            if free_sym.kind == SymbolKind.Func or free_sym.kind == SymbolKind.Builtin do
                total_args = 1 + nargs
                if free_sym.param_count >= 0 and total_args != free_sym.param_count do
                    report_error(diag, 3022, node.line, 0)
                    out 0
                end
                var free_gen_args = fat_str_new("")
                if free_sym.ast_id != 0 do
                    fn_ast = free_sym.ast_id as AstNode
                    var fn_params = vec_new_rt()
                    var fpi = 0
                    let fn_ch_len = vec_len_rt(fn_ast.children)
                    when fpi < fn_ch_len loop
                        let p_ch = vec_get_rt(fn_ast.children, fpi) as AstNode
                        if (p_ch as i64) != 0 do
                            let nt_p = p_ch.node_type
                            if nt_p == AstType.ParamDef or nt_p == AstType.RefParam or nt_p == AstType.OutParam or nt_p == AstType.Identifier do
                                fn_params = vec_push_rt(fn_params, p_ch as i64)
                            end
                        end
                        fpi = fpi + 1
                    end
                    let num_fp = vec_len_rt(fn_params)
                    if num_fp > 0 and total_args != num_fp do
                        report_error(diag, 3022, node.line, 0)
                        out 0
                    end

                    if fn_ast.builtin_id != 0 do
                        let gen_params_str = fn_ast.builtin_id as string
                        let p_names = typecheck_split_list_items(gen_params_str)
                        let p_count = vec_len_rt(p_names)
                        var inferred_args = vec_new_rt()
                        var pi_init = 0
                        when pi_init < p_count loop
                            inferred_args = vec_push_rt(inferred_args, fat_str_new("") as i64)
                            pi_init = pi_init + 1
                        end

                        var bind_conflict = 0
                        var ai_inf = 0
                        when ai_inf < total_args and ai_inf < num_fp loop
                            let p_node_inf = vec_get_rt(fn_params, ai_inf) as AstNode
                            var a_node_inf = recv
                            if ai_inf > 0 do
                                a_node_inf = vec_get_rt(node.children, ai_inf) as AstNode
                            end
                            var formal_t = p_node_inf.name2
                            var actual_t = pass6_get_receiver_entity_name(symbols, scopes, a_node_inf)
                            if fat_str_len(actual_t) == 0 do
                                actual_t = pass6_get_expr_type_str(symbols, scopes, a_node_inf)
                            end
                            if fat_str_len(actual_t) == 0 do
                                var a_kind = TypeKind.Void
                                if ai_inf == 0 do
                                    a_kind = recv_actual
                                else
                                    a_kind = pass6_infer_type(symbols, scopes, a_node_inf)
                                end
                                if a_kind != TypeKind.Void and a_kind != TypeKind.None do
                                    actual_t = pass6_type_kind_to_str(a_kind)
                                end
                            end
                            if fat_str_len(formal_t) > 0 and fat_str_len(actual_t) > 0 do
                                let b_res = typecheck_bind_generic_param(p_names, inferred_args, formal_t, actual_t)
                                if b_res == 0 do
                                    bind_conflict = 1
                                end
                            end
                            ai_inf = ai_inf + 1
                        end

                        var all_resolved = 1
                        if bind_conflict == 1 do
                            all_resolved = 0
                        end
                        var pi_chk = 0
                        when pi_chk < p_count loop
                            let inf_val = vec_get_rt(inferred_args, pi_chk) as string
                            if fat_str_len(inf_val) == 0 do
                                all_resolved = 0
                            end
                            pi_chk = pi_chk + 1
                        end

                        if all_resolved == 0 do
                            pass6_report_ufcs_mismatch(diag, node, recv)
                            out 0
                        end

                        free_gen_args = vec_get_rt(inferred_args, 0) as string
                        var pi_bld = 1
                        when pi_bld < p_count loop
                            free_gen_args = fat_str_concat(free_gen_args, fat_str_concat(fat_str_new(", "), vec_get_rt(inferred_args, pi_bld) as string))
                            pi_bld = pi_bld + 1
                        end
                    end

                    if vec_len_rt(fn_params) > 0 do
                        p0_node = vec_get_rt(fn_params, 0) as AstNode
                        if fat_str_len(p0_node.name2) > 0 do
                            var p0_name2 = p0_node.name2
                            if fn_ast.builtin_id != 0 and fat_str_len(free_gen_args) > 0 do
                                p0_name2 = pass6_substitute_generic_type(fn_ast.builtin_id as string, free_gen_args, p0_node.name2)
                            end
                            p0_expected = pass6_resolve_ffi_type(p0_name2)
                            if p0_expected != TypeKind.Void do
                                if pass6_ufcs_types_compatible(p0_expected, recv_actual) == 0 do
                                    pass6_report_ufcs_mismatch(diag, node, recv)
                                    out 0
                                end
                            else
                                p0_type_raw = pass6_unwrap_type_name(p0_name2)
                                p0_base = pass6_extract_base_name(p0_type_raw)
                                p0_entity = pass6_find_entity_ast(symbols, scopes, p0_base)
                                if p0_entity != 0 do
                                    recv_entity = pass6_get_receiver_entity_name(symbols, scopes, recv)
                                    recv_base = pass6_extract_base_name(recv_entity)
                                    if fat_str_len(recv_base) == 0 or pass6_type_strings_compatible(symbols, scopes, p0_type_raw, recv_entity) == 0 do
                                        pass6_report_ufcs_mismatch(diag, node, recv)
                                        out 0
                                    end
                                else
                                    pass6_report_ufcs_mismatch(diag, node, recv)
                                    out 0
                                end
                            end
                        end
                    end
                    var ai2 = 0
                    when ai2 < nargs loop
                        if 1 + ai2 < vec_len_rt(fn_params) do
                            pi_node = vec_get_rt(fn_params, 1 + ai2) as AstNode
                            if fat_str_len(pi_node.name2) > 0 do
                                var pi_name2 = pi_node.name2
                                if fn_ast.builtin_id != 0 and fat_str_len(free_gen_args) > 0 do
                                    pi_name2 = pass6_substitute_generic_type(fn_ast.builtin_id as string, free_gen_args, pi_node.name2)
                                end
                                pi_expected = pass6_resolve_ffi_type(pi_name2)
                                arg_node2 = vec_get_rt(node.children, 1 + ai2) as AstNode
                                arg_actual2 = pass6_infer_type(symbols, scopes, arg_node2)
                                if pi_expected != TypeKind.Void and arg_actual2 != TypeKind.Void and pass6_ufcs_types_compatible(pi_expected, arg_actual2) == 0 do
                                    pass6_report_ufcs_mismatch(diag, node, arg_node2)
                                    out 0
                                end
                                if pi_expected == TypeKind.Void do
                                    pi_type_raw = pass6_unwrap_type_name(pi_name2)
                                    pi_base = pass6_extract_base_name(pi_type_raw)
                                    pi_entity = pass6_find_entity_ast(symbols, scopes, pi_base)
                                    if pi_entity != 0 do
                                        arg_entity = pass6_get_receiver_entity_name(symbols, scopes, arg_node2)
                                        arg_base = pass6_extract_base_name(arg_entity)
                                        if fat_str_len(arg_base) > 0 and pass6_type_strings_compatible(symbols, scopes, pi_type_raw, arg_entity) == 0 do
                                            pass6_report_ufcs_mismatch(diag, node, arg_node2)
                                            out 0
                                        end
                                    end
                                end
                            end
                        end
                        ai2 = ai2 + 1
                    end
                    pass6_check_method_mut_args(symbols, scopes, diag, fn_ast, node, 0, 0, total_args)
                end
                ideFactResolve(node as int, free_sym_id, scope_current_id(scopes), 3)
                node.builtin_id = 203
                var resolved_callee_identity = mname
                if free_sym.ast_id != 0 do
                    let callee_node = free_sym.ast_id as AstNode
                    if (callee_node as i64) != 0 do
                        if fat_str_len(callee_node.name) > 0 do
                            resolved_callee_identity = pass6_find_canonical_identity(callee_node)
                        end
                    end
                end
                node.name = resolved_callee_identity
                if fat_str_len(free_gen_args) > 0 do
                    node.name2 = free_gen_args
                else
                    node.name2 = resolved_callee_identity
                end
                out 0
            end
        end
    end

    # Priority 3.5: Module-qualified call like json.string(...)
    if recv.node_type == AstType.Identifier do
        let mod_mname = fat_str_concat(fat_str_concat(recv.name, fat_str_new(".")), mname)
        let mod_fn = pass6_find_func_by_canonical_identity(mod_mname)
        if (mod_fn as i64) != 0 do
            var fn_params = vec_new_rt()
            var fpi = 0
            when fpi < vec_len_rt(mod_fn.children) loop
                let p_ch = vec_get_rt(mod_fn.children, fpi) as AstNode
                let nt_p = p_ch.node_type
                if nt_p == AstType.ParamDef or nt_p == AstType.RefParam or nt_p == AstType.OutParam or nt_p == AstType.Identifier do
                    fn_params = vec_push_rt(fn_params, p_ch)
                end
                fpi = fpi + 1
            end
            if nargs != vec_len_rt(fn_params) do
                report_error(diag, 3022, node.line, 0)
                out 0
            end
            var ai = 0
            when ai < nargs loop
                var m_param_def = vec_get_rt(fn_params, ai) as AstNode
                var m_arg_expr = vec_get_rt(node.children, 1 + ai) as AstNode
                if fat_str_len(m_param_def.name2) > 0 do
                    var expected_ty = pass6_resolve_ffi_type(m_param_def.name2)
                    var actual_ty = pass6_infer_type(symbols, scopes, m_arg_expr)
                    if expected_ty != TypeKind.Void and actual_ty != TypeKind.Void do
                        if pass6_call_arg_types_compatible(symbols, scopes, expected_ty as i64, actual_ty, m_arg_expr, m_param_def.name2, m_param_def.name, node.name) == 0 do
                            pass6_report_type_mismatch(diag, symbols, scopes, node, m_arg_expr, m_param_def.name2, "")
                        end
                    end
                end
                ai = ai + 1
            end
            node.builtin_id = 203
            node.name2 = mod_mname
            out 0
        end
    end

    # Priority 4: No candidate found
    if recv_is_unresolved == 0 do
        if node.span_id > 0 do
            report_error_span(diag, 3021, node.span_id, "")
        else
            var call_col = node.int_val
            if call_col <= 0 do call_col = 1 end
            report_error_loc(diag, 3021, 0, node.line, call_col, "")
        end
    end
    out 0
end.


func pass6_check_method_mut_args(ref symbols: SymbolTable, ref scopes: ScopeTree, diag: &DiagnosticEngine, fn_ast: &AstNode, call_node: &AstNode, arg_start: int, param_start: int, count: int):
    if (fn_ast as i64) == 0 or (call_node as i64) == 0 do out 0 end
    var fn_params = vec_new_rt()
    var fpi = 0
    let fn_ch_len = vec_len_rt(fn_ast.children)
    when fpi < fn_ch_len loop
        let p_ch = vec_get_rt(fn_ast.children, fpi) as AstNode
        if (p_ch as i64) != 0 do
            let nt_p = p_ch.node_type
            if nt_p == AstType.ParamDef or nt_p == AstType.RefParam or nt_p == AstType.OutParam or nt_p == AstType.Identifier do
                fn_params = vec_push_rt(fn_params, p_ch)
            end
        end
        fpi = fpi + 1
    end
    let num_params = vec_len_rt(fn_params)
    let num_args = vec_len_rt(call_node.children)

    var seen = vec_new_rt()
    var ai = 0
    when ai < count loop
        let p_idx = param_start + ai
        let a_idx = arg_start + ai
        if p_idx < num_params and a_idx < num_args do
            param_def = vec_get_rt(fn_params, p_idx) as AstNode
            arg_expr = vec_get_rt(call_node.children, a_idx) as AstNode
            if (param_def as i64) != 0 and (arg_expr as i64) != 0 do
                let is_ref_p = param_def.node_type == AstType.RefParam or param_def.int_val == 1
                let is_out_p = param_def.node_type == AstType.OutParam or param_def.int_val == 2
                if is_ref_p or is_out_p do
                    let is_lval = arg_expr.node_type == AstType.Identifier or arg_expr.node_type == AstType.FieldAccess or arg_expr.node_type == AstType.IndexAccess or arg_expr.node_type == AstType.ExprIndex
                    if not is_lval do
                        report_error(diag, 3048, call_node.line, 0)
                    else
                        var si = 0
                        var overlaps = false
                        when si < vec_len_rt(seen) loop
                            if pass6_lvalues_may_overlap(vec_get_rt(seen, si) as AstNode, arg_expr) do overlaps = true end
                            si = si + 1
                        end
                        if overlaps do
                            report_error(diag, 5003, call_node.line, 0)
                        else
                            seen = vec_push_rt(seen, arg_expr as i64)
                        end

                        root_name = pass6_lvalue_root_name(arg_expr)
                        sym_idx = pass6_lookup_chain(symbols, scopes, scope_current_id(scopes), root_name)
                        if sym_idx != -1 do
                            sym = pass6_symbol_at(symbols, sym_idx)
                            if sym.kind == SymbolKind.Const or not sym.is_mutable do
                                report_error(diag, 3003, call_node.line, 0)
                            end
                            if is_ref_p and sym.ast_id != 0 do
                                decl = sym.ast_id as AstNode
                                if decl.node_type == AstType.VarDecl and vec_len_rt(decl.children) == 0 and pass6_name_in_vec(g_pass6_assigned_vars, root_name) == 0 do
                                    report_error(diag, 3049, call_node.line, 0)
                                end
                            end
                        end
                        if is_out_p and arg_expr.node_type == AstType.Identifier and pass6_name_in_vec(g_pass6_assigned_vars, arg_expr.name) == 0 do
                            g_pass6_assigned_vars = vec_push_rt(g_pass6_assigned_vars, arg_expr.name as i64)
                        end
                    end
                end
            end
        end
        ai = ai + 1
    end
end.

func pass6WalkMethodCall(ref symbols: SymbolTable, ref scopes: ScopeTree, diag: &DiagnosticEngine, node: &AstNode) -> int:
    if fat_cstr_eq(node.name, "backward") == 1 do
        if g_pass6_ai_mode == 1 do
            report_error(diag, 3009, node.line, 0)
        eif g_pass6_ai_mode != 2 do
            report_error(diag, 3017, node.line, 0)
        else
            var backward_ok = false
            if vec_len_rt(node.children) > 0 do
                var recv = vec_get_rt(node.children, 0)
                var recv_ty = pass6_infer_type(symbols, scopes, recv)
                if recv.node_type == AstType.Identifier and pass6_name_in_vec(g_pass6_train_values, recv.name) == 1 and (recv_ty == TypeKind.Float or recv_ty == TypeKind.Tensor) do
                    backward_ok = true
                end
            end
            if not backward_ok do report_error(diag, 3020, node.line, 0) end
        end
        out 0
    end
    pass6_check_method_call(symbols, scopes, diag, node)
    out 0
end.

export pass6_check_method_call, pass6_check_method_mut_args, pass6WalkMethodCall
