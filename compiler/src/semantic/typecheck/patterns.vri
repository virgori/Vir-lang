##
 * compiler/src/semantic/typecheck/patterns.vri — Pattern Matching Rules & Verification
 * =====================================================================================
 * VIRC-PLN-0004 Section 5.5 (Phase 7 Part 9): Pattern Matching Rules Service.
 *
 * Implements type checking and verification for pattern matching (case expressions):
 * - Wildcard detection and misplaced wildcard errors (Error 3036)
 * - Literal pattern type constraint checking (Error 3001)
 * - Pattern arm uniqueness verification (Error 3035)
 * - Enum variant matching and qualification checking (Errors 3033, 3034)
 * - Variant binder arity and binder uniqueness checking (Errors 3037, 3041)
 * - Enum pattern match exhaustiveness verification (Error 3032)
 ##

include typecheck_context
include typecheck_index
include typecheck_compatibility
include typecheck_enums

func typecheck_case_is_wildcard(pat: &AstNode) -> bool:
    if pat.node_type == AstType.Identifier do
        if fat_cstr_eq(pat.name, "_") == 1 or pat.int_val == 0 - 1 do
            out true
        end
    end
    out false
end.

func typecheck_case_check_literal_pattern(diag: &DiagnosticEngine, pat: &AstNode, target_kind: int):
    if pat.node_type == AstType.LiteralInt do
        if target_kind != TypeKind.Void and target_kind != TypeKind.Int do
            report_error(diag, 3001, pat.line, 0)
        end
    eif pat.node_type == AstType.LiteralStr do
        if target_kind != TypeKind.Void and target_kind != TypeKind.String do
            report_error(diag, 3001, pat.line, 0)
        end
    eif pat.node_type == AstType.Identifier do
        let is_bool_pat = fat_cstr_eq(pat.name, "true") == 1 or fat_cstr_eq(pat.name, "false") == 1
        if is_bool_pat and target_kind != TypeKind.Void and target_kind != TypeKind.Bool do
            report_error(diag, 3001, pat.line, 0)
        end
    end
end.

func typecheck_case_pattern_key(pat: &AstNode) -> string:
    var pat_key = pat.name
    if fat_str_len(pat.name2) > 0 do
        pat_key = fat_str_concat(fat_str_concat(pat.name2, fat_str_new(".")), pat.name)
    end
    if pat.node_type == AstType.LiteralInt do
        pat_key = fat_str_concat(fat_str_new("int:"), fat_str_new(rt_itoa(pat.int_val)))
    eif pat.node_type == AstType.LiteralStr do
        pat_key = fat_str_concat(fat_str_new("str:"), pat.name)
    end
    out pat_key
end.

func typecheck_case_check_arm_duplicate(diag: &DiagnosticEngine, seen_arms: i64, pat_key: &string, line: int):
    let abid = typecheck_hash_name(pat_key)
    var abucket = vec_get_rt(seen_arms, abid)
    let ablen = vec_len_rt(abucket)
    var arm_dup = false
    var si = 0
    when si < ablen loop
        if fat_str_eq(vec_get_rt(abucket, si) as string, pat_key) == 1 do
            arm_dup = true
            si = ablen
        else
            si = si + 1
        end
    end
    if arm_dup do
        report_error(diag, 3035, line, 0)
    else
        abucket = vec_push_rt(abucket, pat_key as i64)
        vec_set_rt(seen_arms, abid, abucket)
    end
end.

func typecheck_case_check_variant(diag: &DiagnosticEngine, pat: &AstNode, base_enum_name: &string, target_enum_ast: &AstNode) -> AstNode:
    if pat.node_type != AstType.Identifier do out 0 as AstNode end
    if fat_str_len(pat.name2) > 0 and fat_str_eq(pat.name2, base_enum_name) == 0 do
        report_error(diag, 3034, pat.line, 0)
    end
    let target_vcount = vec_len_rt(target_enum_ast.children)
    var matched_v = 0 as AstNode
    var tvi = 0
    when tvi < target_vcount loop
        let v_cand = vec_get_rt(target_enum_ast.children, tvi) as AstNode
        if fat_str_eq(v_cand.name, pat.name) == 1 do
            matched_v = v_cand
        end
        tvi = tvi + 1
    end
    if (matched_v as i64) == 0 do
        report_error(diag, 3033, pat.line, 0)
        out 0 as AstNode
    end
    out matched_v
end.

func typecheck_case_record_variant(name: &string, covered_variants_buckets: i64) -> bool:
    let cvbid = typecheck_hash_name(name)
    var cvbucket = vec_get_rt(covered_variants_buckets, cvbid)
    let cvblen = vec_len_rt(cvbucket)
    var cvi = 0
    when cvi < cvblen loop
        if fat_str_eq(vec_get_rt(cvbucket, cvi) as string, name) == 1 do
            out false
        end
        cvi = cvi + 1
    end
    cvbucket = vec_push_rt(cvbucket, name as i64)
    vec_set_rt(covered_variants_buckets, cvbid, cvbucket)
    out true
end.

func typecheck_case_check_binders(diag: &DiagnosticEngine, pat: &AstNode, matched_v: &AstNode):
    let exp_arity = matched_v.builtin_id
    let got_binders = vec_len_rt(pat.children)
    if got_binders > 0 or exp_arity > 0 do
        if got_binders != exp_arity do
            report_error(diag, 3037, pat.line, 0)
        end
    end
    if got_binders > 1 do
        var seen_binders = typecheck_map_new()
        var bi = 0
        when bi < got_binders loop
            let b_node = vec_get_rt(pat.children, bi) as AstNode
            if fat_cstr_eq(b_node.name, "_") == 0 do
                let bbid = typecheck_hash_name(b_node.name)
                var bbucket = vec_get_rt(seen_binders, bbid)
                let bblen = vec_len_rt(bbucket)
                var has_bdup = false
                var bki = 0
                when bki < bblen loop
                    if fat_str_eq(vec_get_rt(bbucket, bki) as string, b_node.name) == 1 do
                        has_bdup = true
                        bki = bblen
                    else
                        bki = bki + 1
                    end
                end
                if has_bdup do
                    report_error(diag, 3041, b_node.line, 0)
                else
                    bbucket = vec_push_rt(bbucket, b_node.name as i64)
                    vec_set_rt(seen_binders, bbid, bbucket)
                end
            end
            bi = bi + 1
        end
    end
end.

func typecheck_case_check_exhaustiveness(diag: &DiagnosticEngine, line: int, target_enum_ast: &AstNode, covered_variants_count: int, seen_wildcard: bool, has_else: bool):
    if (target_enum_ast as i64) != 0 do
        if not seen_wildcard and not has_else do
            let total_v = vec_len_rt(target_enum_ast.children)
            if covered_variants_count < total_v do
                report_error(diag, 3032, line, 0)
            end
        end
    end
end.

export typecheck_case_is_wildcard,
       typecheck_case_check_literal_pattern,
       typecheck_case_pattern_key,
       typecheck_case_check_arm_duplicate,
       typecheck_case_check_variant,
       typecheck_case_record_variant,
       typecheck_case_check_binders,
       typecheck_case_check_exhaustiveness
