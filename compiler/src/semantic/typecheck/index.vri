##
 * compiler/src/semantic/typecheck/index.vri — Symbol Index Service
 * ================================================================
 * VIRC-PLN-0003 Section 5.5: Typecheck Index Service.
 *
 * Provides fast symbol and scope indexing using explicit TypecheckContext buckets.
 ##

include typecheck_context

func typecheck_hash_name(name: &string) -> int:
    let n = fat_str_len(name)
    if n <= 0 do
        out 0
    end
    var h = n * 17
    var i = 0
    when i < n loop
        h = h * 131 + fat_str_byte_at(name, i)
        i = i + 1
    end
    if h < 0 do
        h = 0 - h
    end
    out h mod TYPECHECK_BUCKETS
end.

func typecheck_get_short_name(name: &string) -> string:
    let n = fat_str_len(name)
    if n == 0 do out name end
    var last_dot = 0 - 1
    var i = n - 1
    when i >= 0 loop
        if fat_str_byte_at(name, i) == 46 do # '.'
            last_dot = i
            i = 0 - 1
        else
            i = i - 1
        end
    end
    if last_dot < 0 or last_dot >= n - 1 do
        out fat_str_new("")
    end
    out fat_str_slice(name, last_dot + 1, n - last_dot - 1)
end.

func typecheck_index_global(ctx: &TypecheckContext, name: &string, sym_id: int):
    if fat_str_len(name) == 0 do
        out 0
    end
    if ctx.global_buckets == 0 do
        ctx.global_buckets = typecheck_map_new()
    end
    let bid = typecheck_hash_name(name)
    var bucket = vec_get_rt(ctx.global_buckets, bid)
    bucket = vec_push_rt(bucket, sym_id)
    vec_set_rt(ctx.global_buckets, bid, bucket)

    let short_name = typecheck_get_short_name(name)
    if fat_str_len(short_name) > 0 do
        if ctx.suffix_buckets == 0 do
            ctx.suffix_buckets = typecheck_map_new()
        end
        let sbid = typecheck_hash_name(short_name)
        var sbucket = vec_get_rt(ctx.suffix_buckets, sbid)
        sbucket = vec_push_rt(sbucket, sym_id)
        vec_set_rt(ctx.suffix_buckets, sbid, sbucket)
    end
    out 0
end.

func typecheck_index_scope_symbol(ctx: &TypecheckContext, scope_id: int, name: &string, sym_id: int):
    if fat_str_len(name) == 0 do out 0 end
    if ctx.scope_buckets == 0 do
        ctx.scope_buckets = typecheck_scope_map_new()
    end
    var h = (scope_id * 37 + typecheck_hash_name(name)) and 1023
    if h < 0 do h = 0 - h end
    h = h and 1023
    var bucket = vec_get_rt(ctx.scope_buckets, h)
    bucket = vec_push_rt(bucket, sym_id)
    vec_set_rt(ctx.scope_buckets, h, bucket)
    out 0
end.

func typecheck_lookup_scope_indexed(ref symbols: SymbolTable, ctx: &TypecheckContext, scope_id: int, name: &string) -> int:
    if scope_id <= 0 or ctx.scope_buckets == 0 do out -1 end
    var h = (scope_id * 37 + typecheck_hash_name(name)) and 1023
    if h < 0 do h = 0 - h end
    h = h and 1023
    let bucket = vec_get_rt(ctx.scope_buckets, h)
    let count = vec_len_rt(bucket)
    if count == 0 do out -1 end
    let syms_vec = native_read_i64(symbols as i64, 0)
    var i = 0
    when i < count loop
        let sym_id = vec_get_rt(bucket, i) as int
        let sym = vec_get_rt(syms_vec, sym_id)
        if (sym as i64) != 0 do
            if sym.scope_id == scope_id do
                let sym_name_ptr = native_read_i64(sym as i64, 8)
                if sym_name_ptr != 0 do
                    if fat_str_eq(sym_name_ptr as string, name) == 1 do
                        out sym_id
                    end
                end
            end
        end
        i = i + 1
    end
    out -1
end.

func typecheck_rebuild_index(ref symbols: SymbolTable, ref scopes: ScopeTree, ref ctx: TypecheckContext):
    ctx.global_buckets = typecheck_map_new()
    ctx.suffix_buckets = typecheck_map_new()
    ctx.scope_buckets = typecheck_scope_map_new()
    let scopes_vec = native_read_i64(scopes as i64, 0)
    let syms_vec = native_read_i64(symbols as i64, 0)
    let n_scopes = vec_len_rt(scopes_vec)
    var s = 0
    when s < n_scopes loop
        let scope_node = vec_get_rt(scopes_vec, s)
        let sym_list = native_read_i64(scope_node as i64, 16)
        let count = vec_len_rt(sym_list)
        var i = 0
        when i < count loop
            let sym_id = vec_get_rt(sym_list, i) as int
            let sym = vec_get_rt(syms_vec, sym_id)
            let sym_name_ptr = native_read_i64(sym as i64, 8)
            if sym_name_ptr != 0 do
                let sym_name = sym_name_ptr as string
                if s == 0 do
                    typecheck_index_global(ctx, sym_name, sym_id)
                else
                    typecheck_index_scope_symbol(ctx, s, sym_name, sym_id)
                end
            end
            i = i + 1
        end
        s = s + 1
    end
end.

export typecheck_hash_name, typecheck_get_short_name,
       typecheck_index_global, typecheck_index_scope_symbol,
       typecheck_lookup_scope_indexed, typecheck_rebuild_index
