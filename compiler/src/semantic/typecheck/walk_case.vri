##
 * compiler/src/semantic/typecheck/walk_case.vri — Case Pattern Matching Walk
 * ===========================================================================
 * VIRC-PLN-0004 Section 5: AST walk handlers for case/pattern matching.
 *
 * Implements:
 * - pass6_check_case_expr: validate case expression targets, patterns, exhaustiveness
 ##

include typecheck_context
include typecheck_patterns
include typecheck_enums

func pass6_check_case_expr(ref symbols: SymbolTable, ref scopes: ScopeTree, diag: &DiagnosticEngine, node: &AstNode):
    child_count = vec_len_rt(node.children)
    if child_count < 1 do out 0 end
    target_expr = vec_get_rt(node.children, 0) as AstNode
    pass6_walk(symbols, scopes, diag, target_expr)
    target_kind = pass6_infer_type(symbols, scopes, target_expr)
    if target_expr.node_type == AstType.Call or target_expr.node_type == AstType.MethodCall do
        target_sym_id = pass6_lookup_chain(symbols, scopes, scope_current_id(scopes), target_expr.name)
        if target_sym_id == -1 do
            target_kind = TypeKind.Void
        else
            target_sym = pass6_symbol_at(symbols, target_sym_id)
            if (target_sym as i64) != 0 do
                if target_sym.return_type == 0 do
                    target_kind = TypeKind.Void
                end
            end
        end
    end

    var target_type_str = pass6_get_receiver_entity_name(symbols, scopes, target_expr)
    if fat_str_len(target_type_str) == 0 and target_expr.node_type == AstType.Identifier do
        target_type_str = pass6_get_var_type(target_expr.name)
    end
    base_enum_name = pass6_extract_base_name(target_type_str)
    target_enum_ast = pass6_find_enum_ast(symbols, scopes, base_enum_name)

    seen_wildcard = false
    seen_arms = pass6_global_map_new()
    covered_variants = vec_new_rt()
    covered_variants_buckets = pass6_global_map_new()

    var i = 1
    when i + 1 < child_count loop
        pat = vec_get_rt(node.children, i) as AstNode
        body = vec_get_rt(node.children, i + 1) as AstNode

        pass6_scope_enter()
        scope_push(scopes, ScopeKind.Block)

        is_wild = typecheck_case_is_wildcard(pat)
        if seen_wildcard do
            report_error(diag, 3036, pat.line, 0)
        end
        if is_wild do
            seen_wildcard = true
        end

        typecheck_case_check_literal_pattern(diag, pat, target_kind)

        let pat_key = typecheck_case_pattern_key(pat)
        typecheck_case_check_arm_duplicate(diag, seen_arms, pat_key, pat.line)

        if (target_enum_ast as i64) != 0 and not is_wild do
            matched_v = typecheck_case_check_variant(diag, pat, base_enum_name, target_enum_ast)
            if (matched_v as i64) != 0 do
                if typecheck_case_record_variant(pat.name, covered_variants_buckets) do
                    covered_variants = vec_push_rt(covered_variants, pat.name as i64)
                end
                typecheck_case_check_binders(diag, pat, matched_v)

                var bi2 = 0
                let got_binders = vec_len_rt(pat.children)
                when bi2 < got_binders and bi2 < vec_len_rt(matched_v.children) loop
                    b_node = vec_get_rt(pat.children, bi2) as AstNode
                    p_def = vec_get_rt(matched_v.children, bi2) as AstNode
                    if fat_str_len(p_def.name2) > 0 and fat_cstr_eq(b_node.name, "_") == 0 do
                        pass6_set_var_type(b_node.name, p_def.name2)
                    end
                    bi2 = bi2 + 1
                end
            end
        end

        var bi_reg = 0
        let n_binders = vec_len_rt(pat.children)
        when bi_reg < n_binders loop
            let b_node = vec_get_rt(pat.children, bi_reg) as AstNode
            if fat_cstr_eq(b_node.name, "_") == 0 do
                let bsid = pass6_register_local(symbols, scopes, b_node.name, true)
                if bsid != -1 do
                    let bsym = pass6_symbol_at(symbols, bsid)
                    native_write_i64(bsym as i64, 32, b_node as i64)
                    let bty_str = pass6_get_var_type(b_node.name)
                    if fat_str_len(bty_str) > 0 do
                        let bk = pass6_resolve_ffi_type(bty_str)
                        if bk != TypeKind.Void do
                            native_write_i64(bsym as i64, 16, bk as i64)
                        end
                    end
                end
            end
            bi_reg = bi_reg + 1
        end

        pass6_walk(symbols, scopes, diag, body)
        scope_pop(scopes)
        pass6_scope_exit()
        i = i + 2
    end

    if i < child_count do
        else_body = vec_get_rt(node.children, i)
        pass6_scope_enter()
        scope_push(scopes, ScopeKind.Block)
        pass6_walk(symbols, scopes, diag, else_body)
        scope_pop(scopes)
        pass6_scope_exit()
    end

    typecheck_case_check_exhaustiveness(diag, node.line, target_enum_ast, vec_len_rt(covered_variants), seen_wildcard, node.int_val == 1)
    out 0
end.

export pass6_check_case_expr
