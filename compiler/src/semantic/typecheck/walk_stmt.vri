##
 * compiler/src/semantic/typecheck/walk_stmt.vri — Assignment & Call Statement Walk
 * =================================================================================
 * VIRC-PLN-0004 Section 5: AST walk handlers for Assign and Call statement nodes.
 *
 * Implements:
 * - pass6WalkAssign: type-check assignments (simple, compound, field, index)
 * - pass6WalkCall: type-check function call arguments, ref/out parameter aliasing
 ##

include typecheck_context
include typecheck_lvalue

func pass6WalkAssign(ref symbols: SymbolTable, ref scopes: ScopeTree, diag: &DiagnosticEngine, node: &AstNode) -> int:
    child_count = vec_len_rt(node.children)
    if fat_str_len(node.name) > 0 do
        found = pass6_lookup_chain(symbols, scopes, scope_current_id(scopes), node.name)
        if found == -1 do
            pass6_register_local(symbols, scopes, node.name, true)
            found = pass6_lookup_chain(symbols, scopes, scope_current_id(scopes), node.name)
        end
        if found != -1 do
            sym = pass6_symbol_at(symbols, found)
            if sym.kind != SymbolKind.Variable and sym.kind != SymbolKind.Param do
                pass6_register_local(symbols, scopes, node.name, true)
                found = pass6_lookup_chain(symbols, scopes, scope_current_id(scopes), node.name)
                sym = pass6_symbol_at(symbols, found)
            end
            if not sym.is_mutable do
                report_error(diag, 3003, node.line, 0)
            end
            g_pass6_assigned_vars = vec_push_rt(g_pass6_assigned_vars, node.name)
            if child_count >= 1 do
                rhs = vec_get_rt(node.children, 0)
                rhs_type = pass6_infer_type(symbols, scopes, rhs)
                var assign_vty = pass6_get_var_type(node.name)
                if fat_str_len(assign_vty) == 0 and sym.ast_id != 0 do
                    var d_ast = sym.ast_id as AstNode
                    if fat_str_len(d_ast.name2) > 0 do
                        assign_vty = d_ast.name2
                    end
                end
                var exp_asgn_str = assign_vty
                if fat_str_len(exp_asgn_str) == 0 do
                    exp_asgn_str = pass6_type_kind_to_str(sym.type_id as TypeKind)
                end
                if sym.type_id == TypeKind.Int as i64 and rhs.node_type == AstType.LiteralStr do
                    pass6_report_type_mismatch(diag, symbols, scopes, node, rhs, exp_asgn_str, "string")
                eif sym.type_id == TypeKind.String as i64 and rhs.node_type == AstType.LiteralInt do
                    pass6_report_type_mismatch(diag, symbols, scopes, node, rhs, exp_asgn_str, "int")
                eif sym.type_id != 0 and rhs_type != TypeKind.Void and pass6_types_compatible(sym.type_id, rhs_type) == 0 do
                    let allow_assign = typecheck_assignment_allows_coercion(sym.type_id, rhs_type, rhs.node_type, rhs.int_val, is_user_module(g_pass6_cur_module))
                    if allow_assign == 0 do
                        pass6_report_type_mismatch(diag, symbols, scopes, node, rhs, exp_asgn_str, pass6_type_kind_to_str(rhs_type))
                    end
                end
                if sym.type_id == 0 and rhs_type != TypeKind.Void do
                    native_write_i64(sym as i64, 16, rhs_type as i64)
                end
                if fat_str_len(assign_vty) > 0 do
                    var lhs_ent_ast = pass6_find_entity_ast(symbols, scopes, pass6_extract_base_name(assign_vty))
                    if (lhs_ent_ast as i64) != 0 do
                        if rhs.node_type == AstType.ArrayLiteral do
                            pass6_report_type_mismatch(diag, symbols, scopes, node, rhs, assign_vty, "")
                        eif rhs.node_type == AstType.LiteralStr or (rhs.node_type == AstType.LiteralInt and rhs.int_val != 0) or rhs.node_type == AstType.LiteralBool or rhs.node_type == AstType.DictLiteral or rhs.node_type == AstType.TupleExpr do
                            pass6_report_type_mismatch(diag, symbols, scopes, node, rhs, assign_vty, "")
                        eif rhs.node_type == AstType.LiteralInt and rhs.int_val == 0 do
                            # 0 is null pointer/entity reference
                        else
                            var rhs_str = pass6_get_expr_type_str(symbols, scopes, rhs)
                            if fat_str_len(rhs_str) > 0 do
                                if pass6_is_array_type_str(rhs_str) do
                                    pass6_report_type_mismatch(diag, symbols, scopes, node, rhs, assign_vty, rhs_str)
                                else
                                    var a_ent1 = pass6_find_entity_ast(symbols, scopes, pass6_extract_base_name(rhs_str))
                                    if (a_ent1 as i64) != 0 do
                                        if pass6_type_strings_compatible(symbols, scopes, assign_vty, rhs_str) == 0 do
                                            pass6_report_type_mismatch(diag, symbols, scopes, node, rhs, assign_vty, rhs_str)
                                        end
                                    end
                                end
                            end
                        end
                    eif pass6_is_array_type_str(assign_vty) do
                        if rhs.node_type == AstType.EntityLiteral do
                            pass6_report_type_mismatch(diag, symbols, scopes, node, rhs, assign_vty, "")
                        eif rhs.node_type == AstType.LiteralStr or (rhs.node_type == AstType.LiteralInt and rhs.int_val != 0) or rhs.node_type == AstType.LiteralBool or rhs.node_type == AstType.DictLiteral or rhs.node_type == AstType.TupleExpr do
                            pass6_report_type_mismatch(diag, symbols, scopes, node, rhs, assign_vty, "")
                        eif rhs.node_type == AstType.LiteralInt and rhs.int_val == 0 do
                            # 0 is null pointer / borrow release
                        else
                            var rhs_arr_str = pass6_get_expr_type_str(symbols, scopes, rhs)
                            if fat_str_len(rhs_arr_str) > 0 do
                                var a_ent2 = pass6_find_entity_ast(symbols, scopes, pass6_extract_base_name(rhs_arr_str))
                                if (a_ent2 as i64) != 0 do
                                    pass6_report_type_mismatch(diag, symbols, scopes, node, rhs, assign_vty, rhs_arr_str)
                                eif pass6_type_strings_compatible(symbols, scopes, assign_vty, rhs_arr_str) == 0 do
                                    pass6_report_type_mismatch(diag, symbols, scopes, node, rhs, assign_vty, rhs_arr_str)
                                end
                            end
                        end
                    end
                end
                if fat_str_len(assign_vty) > 0 and is_flux_type_str(assign_vty as int) do
                    var lhs_lanes = parse_flux_lanes(assign_vty as int)
                    if rhs.node_type == AstType.Call and fat_cstr_eq(rhs.name, "flux") do
                        if vec_len_rt(rhs.children) != lhs_lanes do
                            report_error(diag, 3001, node.line, 0)
                        end
                    end
                end
                if rhs.node_type == AstType.EntityLiteral and fat_str_len(rhs.name) > 0 do
                    pass6_set_var_type(node.name, rhs.name)
                eif rhs.node_type == AstType.Identifier and fat_str_len(rhs.name) > 0 do
                    r_ty = pass6_get_var_type(rhs.name)
                    if fat_str_len(r_ty) > 0 do
                        pass6_set_var_type(node.name, r_ty)
                    end
                eif rhs.node_type == AstType.QuantizeExpr do
                    if fat_str_len(rhs.name2) > 0 do
                        pass6_set_var_type(node.name, rhs.name2)
                    else
                        pass6_set_var_type(node.name, fat_str_new("QuantizedTensor"))
                    end
                eif rhs.node_type == AstType.Call || rhs.node_type == AstType.MethodCall || rhs.node_type == AstType.BuiltinCall do
                    if is_quantized_type_str(rhs.name2 as int) do
                        pass6_set_var_type(node.name, rhs.name2)
                    else
                        rhs_entity_type = pass6_get_receiver_entity_name(symbols, scopes, rhs)
                        if fat_str_len(rhs_entity_type) > 0 do
                            pass6_set_var_type(node.name, rhs_entity_type)
                        end
                    end
                eif rhs.node_type == AstType.BinOp and (rhs.op == OpType.MatMulOp or rhs.op == OpType.FmaOp) do
                    var inf_t = pass6_infer_tensor_op_result_type(symbols, scopes, rhs)
                    if fat_str_len(inf_t) > 0 do
                        pass6_set_var_type(node.name, inf_t)
                    end
                eif rhs.node_type == AstType.EnumConstruct do
                    if fat_str_len(rhs.name2) > 0 do
                        pass6_set_var_type(node.name, rhs.name2)
                    end
                end
            end
        end
    eif child_count >= 2 do
        lhs = vec_get_rt(node.children, 0)
        rhs = vec_get_rt(node.children, 1)
        if typecheck_is_assignable_lhs(lhs) == 0 do
            report_error(diag, 3012, node.line, 0)
        end
        if lhs.node_type == AstType.Identifier do
            found = pass6_lookup_chain(symbols, scopes, scope_current_id(scopes), lhs.name)
            if found != -1 do
                sym = pass6_symbol_at(symbols, found)
                if sym.kind != SymbolKind.Variable and sym.kind != SymbolKind.Param do
                    pass6_register_local(symbols, scopes, lhs.name, true)
                    found = pass6_lookup_chain(symbols, scopes, scope_current_id(scopes), lhs.name)
                    sym = pass6_symbol_at(symbols, found)
                end
                if not sym.is_mutable do
                    report_error(diag, 3003, node.line, 1893)
                end
                rhs_type = pass6_infer_type(symbols, scopes, rhs)
                var_ty = pass6_get_var_type(lhs.name)
                if fat_str_len(var_ty) == 0 and sym.ast_id != 0 do
                    var d_ast2 = sym.ast_id as AstNode
                    if fat_str_len(d_ast2.name2) > 0 do
                        var_ty = d_ast2.name2
                    end
                end
                pass6_check_enum_generic_arg(symbols, scopes, diag, var_ty, rhs)
                if fat_str_len(var_ty) > 0 do
                    var lhs2_ent_ast = pass6_find_entity_ast(symbols, scopes, pass6_extract_base_name(var_ty))
                    if (lhs2_ent_ast as i64) != 0 do
                        if rhs.node_type == AstType.ArrayLiteral do
                            pass6_report_type_mismatch(diag, symbols, scopes, node, rhs, var_ty, "")
                        eif rhs.node_type == AstType.LiteralStr or (rhs.node_type == AstType.LiteralInt and rhs.int_val != 0) or rhs.node_type == AstType.LiteralBool or rhs.node_type == AstType.DictLiteral or rhs.node_type == AstType.TupleExpr do
                            pass6_report_type_mismatch(diag, symbols, scopes, node, rhs, var_ty, "")
                        eif rhs.node_type == AstType.LiteralInt and rhs.int_val == 0 do
                            # 0 is null pointer/entity reference
                        else
                            var rhs2_str = pass6_get_expr_type_str(symbols, scopes, rhs)
                            if fat_str_len(rhs2_str) > 0 do
                                if pass6_is_array_type_str(rhs2_str) do
                                    pass6_report_type_mismatch(diag, symbols, scopes, node, rhs, var_ty, rhs2_str)
                                else
                                    var a2_ent1 = pass6_find_entity_ast(symbols, scopes, pass6_extract_base_name(rhs2_str))
                                    if (a2_ent1 as i64) != 0 do
                                        if pass6_type_strings_compatible(symbols, scopes, var_ty, rhs2_str) == 0 do
                                            pass6_report_type_mismatch(diag, symbols, scopes, node, rhs, var_ty, rhs2_str)
                                        end
                                    end
                                end
                            end
                        end
                    eif pass6_is_array_type_str(var_ty) do
                        if rhs.node_type == AstType.EntityLiteral do
                            pass6_report_type_mismatch(diag, symbols, scopes, node, rhs, var_ty, "")
                        eif rhs.node_type == AstType.LiteralStr or (rhs.node_type == AstType.LiteralInt and rhs.int_val != 0) or rhs.node_type == AstType.LiteralBool or rhs.node_type == AstType.DictLiteral or rhs.node_type == AstType.TupleExpr do
                            pass6_report_type_mismatch(diag, symbols, scopes, node, rhs, var_ty, "")
                        eif rhs.node_type == AstType.LiteralInt and rhs.int_val == 0 do
                            # 0 is null pointer / borrow release
                        else
                            var rhs2_arr_str = pass6_get_expr_type_str(symbols, scopes, rhs)
                            if fat_str_len(rhs2_arr_str) > 0 do
                                var a2_ent2 = pass6_find_entity_ast(symbols, scopes, pass6_extract_base_name(rhs2_arr_str))
                                if (a2_ent2 as i64) != 0 do
                                    pass6_report_type_mismatch(diag, symbols, scopes, node, rhs, var_ty, rhs2_arr_str)
                                eif pass6_type_strings_compatible(symbols, scopes, var_ty, rhs2_arr_str) == 0 do
                                    pass6_report_type_mismatch(diag, symbols, scopes, node, rhs, var_ty, rhs2_arr_str)
                                end
                            end
                        end
                    end
                end
                if sym.type_id != 0 and rhs_type != TypeKind.Void and pass6_types_compatible(sym.type_id, rhs_type) == 0 do
                    if not (rhs.node_type == AstType.LiteralInt and rhs.int_val == 0) do
                        let allow_a2 = typecheck_assignment_allows_coercion(sym.type_id, rhs_type, rhs.node_type, rhs.int_val, is_user_module(g_pass6_cur_module))
                        if allow_a2 == 0 do
                            var exp_f_str = var_ty
                            if fat_str_len(exp_f_str) == 0 do
                                exp_f_str = pass6_type_kind_to_str(sym.type_id as TypeKind)
                            end
                            pass6_report_type_mismatch(diag, symbols, scopes, node, rhs, exp_f_str, pass6_type_kind_to_str(rhs_type))
                        end
                    end
                end
            end
        end
        if lhs.node_type == AstType.FieldAccess and vec_len_rt(lhs.children) > 0 do
            var base_node = vec_get_rt(lhs.children, 0) as AstNode
            var base_ty = pass6_infer_type(symbols, scopes, base_node)
            if base_ty == TypeKind.Pointer do
                report_error(diag, 3001, node.line, 0)
            end
            var base_type_str = fat_str_new("")
            if base_node.node_type == AstType.Identifier do
                var b_found = pass6_lookup_chain(symbols, scopes, scope_current_id(scopes), base_node.name)
                if b_found != -1 do
                    var b_sym = pass6_symbol_at(symbols, b_found)
                    if b_sym.ast_id != 0 do
                        var b_decl = b_sym.ast_id as AstNode
                        if fat_str_len(b_decl.name2) > 0 do
                            base_type_str = b_decl.name2
                        end
                    end
                end
                if fat_str_len(base_type_str) == 0 do
                    base_type_str = pass6_get_var_type(base_node.name)
                end
            end
            if fat_str_len(base_type_str) > 0 do
                if typecheck_is_shared_ref_type(base_type_str) do
                    report_error(diag, 3003, node.line, 0)
                end
            end
            var fld_exp_k = pass6_infer_type(symbols, scopes, lhs)
            var rhs_act_k = pass6_infer_type(symbols, scopes, rhs)
            if fld_exp_k != TypeKind.Void and rhs_act_k != TypeKind.Void and pass6_types_compatible(fld_exp_k as i64, rhs_act_k) == 0 do
                pass6_report_type_mismatch(diag, symbols, scopes, node, rhs, pass6_type_kind_to_str(fld_exp_k), pass6_type_kind_to_str(rhs_act_k))
            end
        end
    end
    var i = 0
    when i < child_count loop
        child = vec_get_rt(node.children, i)
        pass6_walk(symbols, scopes, diag, child)
        i = i + 1
    end
    out 0
end.

func pass6WalkCall(ref symbols: SymbolTable, ref scopes: ScopeTree, diag: &DiagnosticEngine, node: &AstNode) -> int:
    child_count = vec_len_rt(node.children)
    if fat_cstr_eq(node.name, "flux") == 1 do
        if flux_is_power_of_two(child_count) == false do
            report_error(diag, 3090, node.line, 0)
        end
        if child_count > 1 do
            var elem0_n = vec_get_rt(node.children, 0) as AstNode
            var elem0_t = pass6_infer_type(symbols, scopes, elem0_n)
            var fki = 1
            when fki < child_count loop
                var elem_k_n = vec_get_rt(node.children, fki) as AstNode
                var elem_k_t = pass6_infer_type(symbols, scopes, elem_k_n)
                if elem0_t != TypeKind.Void and elem_k_t != TypeKind.Void and elem0_t != elem_k_t do
                    report_error(diag, 3001, node.line, 0)
                end
                fki = fki + 1
            end
        end
    end
    if fat_cstr_eq(node.name, "q80CreateView") == 1 and child_count >= 12 do
        let
            arg1 = vec_get_rt(node.children, 1) as AstNode
            arg2 = vec_get_rt(node.children, 2) as AstNode
            arg3 = vec_get_rt(node.children, 3) as AstNode
            arg4 = vec_get_rt(node.children, 4) as AstNode
            arg5 = vec_get_rt(node.children, 5) as AstNode
            arg6 = vec_get_rt(node.children, 6) as AstNode
            arg7 = vec_get_rt(node.children, 7) as AstNode
            arg8 = vec_get_rt(node.children, 8) as AstNode
            arg9 = vec_get_rt(node.children, 9) as AstNode
            arg10 = vec_get_rt(node.children, 10) as AstNode
            arg11 = vec_get_rt(node.children, 11) as AstNode
        var
            byte_length = 0 - 1
            byte_offset = 0 - 1
            view_length = 0 - 1
            rows = 0 - 1
            cols = 0 - 1
            stride = 0 - 1
            align = 0 - 1
            read_only = 0 - 1
            ownership = 0 - 1
            has_lifetime = 1
            generation = 0 - 1
        if arg1.node_type == AstType.LiteralInt do byte_length = arg1.int_val end
        if arg2.node_type == AstType.LiteralInt do byte_offset = arg2.int_val end
        if arg3.node_type == AstType.LiteralInt do view_length = arg3.int_val end
        if arg4.node_type == AstType.LiteralInt do rows = arg4.int_val end
        if arg5.node_type == AstType.LiteralInt do cols = arg5.int_val end
        if arg6.node_type == AstType.LiteralInt do stride = arg6.int_val end
        if arg7.node_type == AstType.LiteralInt do align = arg7.int_val end
        if arg8.node_type == AstType.LiteralBool do read_only = arg8.int_val end
        if arg9.node_type == AstType.LiteralInt do
            ownership = arg9.int_val
        eif arg9.node_type == AstType.Identifier and fat_cstr_eq(arg9.name, "Q80_OWNERSHIP_BORROWED") == 1 do
            ownership = 0
        end
        if arg10.node_type == AstType.LiteralNone do has_lifetime = 0 end
        if arg11.node_type == AstType.LiteralInt do generation = arg11.int_val end

        if rows == 0 or (cols >= 0 and (cols == 0 or cols mod 32 != 0)) do
            report_error(diag, 3014, arg5.line, 0)
        end
        if stride >= 0 do
            var required_stride = 0 - 1
            if cols > 0 do required_stride = (cols / 32) * 40 end
            if stride mod 40 != 0 or (required_stride > 0 and stride < required_stride) do
                report_error(diag, 3014, arg6.line, 0)
            end
        end
        if align >= 0 and (align < 8 or (align and (align - 1)) != 0) do
            report_error(diag, 3014, arg7.line, 0)
        end
        if byte_length >= 0 and view_length >= 0 and byte_offset >= 0 do
            if byte_length == 0 or view_length == 0 or byte_offset > byte_length or view_length > byte_length - byte_offset do
                report_error(diag, 3014, arg3.line, 0)
            end
        end
        if read_only >= 0 and read_only != 1 do report_error(diag, 3001, arg8.line, 0) end
        if ownership >= 0 and ownership != 0 do report_error(diag, 3001, arg9.line, 0) end
        if has_lifetime == 0 do report_error(diag, 3001, arg10.line, 0) end

        node.name2 = format_quantized_q80_type_full(
            rows,
            cols,
            stride,
            align,
            byte_length,
            byte_offset,
            view_length,
            read_only,
            ownership,
            has_lifetime,
            generation
        )
    end
    if fat_cstr_eq(node.name, "q80Gemv") == 1 or fat_cstr_eq(node.name, "q80GemvScalar") == 1 or fat_cstr_eq(node.name, "q80GemvSimd") == 1 or fat_cstr_eq(node.name, "q80GemvNeon") == 1 do
        if child_count >= 5 do
            var arg0 = vec_get_rt(node.children, 0) as AstNode
            var v_ty_str = pass6_get_expr_type_str(symbols, scopes, arg0)
            if fat_str_len(v_ty_str) == 0 and arg0.node_type == AstType.AddrOf and vec_len_rt(arg0.children) > 0 do
                let target = vec_get_rt(arg0.children, 0) as AstNode
                v_ty_str = pass6_get_var_type(target.name)
            end
            if is_quantized_type_str(v_ty_str as int) do
                if parse_quantized_codec(v_ty_str as int) != Q_CODEC_Q8_0 do
                    report_error(diag, 3001, node.line, 0)
                end
                let q_shape = parse_quantized_shape(v_ty_str as int)
                if vec_len_rt(q_shape) >= 2 do
                    let expected_rows = vec_get_rt(q_shape, 0) as int
                    let expected_cols = vec_get_rt(q_shape, 1) as int
                    var arg2 = vec_get_rt(node.children, 2) as AstNode
                    if arg2.node_type == AstType.LiteralInt and arg2.int_val != expected_cols do
                        report_error(diag, 3014, arg2.line, 0)
                    end
                    var arg4 = vec_get_rt(node.children, 4) as AstNode
                    if arg4.node_type == AstType.LiteralInt and arg4.int_val < expected_rows do
                        report_error(diag, 3014, arg4.line, 0)
                    end
                end
            end
            var arg1 = vec_get_rt(node.children, 1) as AstNode
            var unwrapped_arg1 = arg1
            when unwrapped_arg1 != 0 and unwrapped_arg1.node_type == AstType.CastExpr and vec_len_rt(unwrapped_arg1.children) > 0 loop
                unwrapped_arg1 = vec_get_rt(unwrapped_arg1.children, 0) as AstNode
            end
            var a_ty = pass6_infer_type(symbols, scopes, arg1)
            var a_ty_str = pass6_get_expr_type_str(symbols, scopes, arg1)
            var u_ty = pass6_infer_type(symbols, scopes, unwrapped_arg1)
            var u_ty_str = pass6_get_expr_type_str(symbols, scopes, unwrapped_arg1)
            if fat_str_len(u_ty_str) == 0 and unwrapped_arg1 != 0 and unwrapped_arg1.node_type == AstType.Identifier do
                u_ty_str = pass6_get_var_type(unwrapped_arg1.name)
            end
            var is_int_act = false
            if arg1.node_type != AstType.CastExpr and a_ty == TypeKind.Int do is_int_act = true end
            if fat_str_len(a_ty_str) > 0 and (fat_cstr_eq(a_ty_str, "[int]") == 1) do is_int_act = true end
            if fat_str_len(u_ty_str) > 0 do
                if fat_cstr_eq(u_ty_str, "[int]") == 1 do
                    is_int_act = true
                end
                if is_tensor_type_str(u_ty_str) do
                    let el_code = parse_tensor_elem_code(u_ty_str)
                    if el_code != 1 and el_code != 2 and el_code != 7 do
                        is_int_act = true
                    end
                end
            end
            if is_int_act do
                report_error(diag, 3001, arg1.line, 0)
            end
        end
    end
    if fat_cstr_eq(node.name, "q80Gemm") == 1 do
        if child_count >= 6 do
            var arg0 = vec_get_rt(node.children, 0) as AstNode
            var v_ty_str = pass6_get_expr_type_str(symbols, scopes, arg0)
            if fat_str_len(v_ty_str) == 0 and arg0.node_type == AstType.AddrOf and vec_len_rt(arg0.children) > 0 do
                let target = vec_get_rt(arg0.children, 0) as AstNode
                v_ty_str = pass6_get_var_type(target.name)
            end
            if is_quantized_type_str(v_ty_str as int) do
                if parse_quantized_codec(v_ty_str as int) != Q_CODEC_Q8_0 do
                    report_error(diag, 3001, node.line, 0)
                end
                let q_shape = parse_quantized_shape(v_ty_str as int)
                if vec_len_rt(q_shape) >= 2 do
                    let expected_rows = vec_get_rt(q_shape, 0) as int
                    let expected_cols = vec_get_rt(q_shape, 1) as int
                    var arg3 = vec_get_rt(node.children, 3) as AstNode
                    if arg3.node_type == AstType.LiteralInt and arg3.int_val != expected_cols do
                        report_error(diag, 3014, arg3.line, 0)
                    end
                    var arg5 = vec_get_rt(node.children, 5) as AstNode
                    if arg5.node_type == AstType.LiteralInt and arg5.int_val < expected_rows do
                        report_error(diag, 3014, arg5.line, 0)
                    end
                end
            end
            var arg1 = vec_get_rt(node.children, 1) as AstNode
            var unwrapped_arg1 = arg1
            when unwrapped_arg1 != 0 and unwrapped_arg1.node_type == AstType.CastExpr and vec_len_rt(unwrapped_arg1.children) > 0 loop
                unwrapped_arg1 = vec_get_rt(unwrapped_arg1.children, 0) as AstNode
            end
            var a_ty = pass6_infer_type(symbols, scopes, arg1)
            var a_ty_str = pass6_get_expr_type_str(symbols, scopes, arg1)
            var u_ty = pass6_infer_type(symbols, scopes, unwrapped_arg1)
            var u_ty_str = pass6_get_expr_type_str(symbols, scopes, unwrapped_arg1)
            if fat_str_len(u_ty_str) == 0 and unwrapped_arg1 != 0 and unwrapped_arg1.node_type == AstType.Identifier do
                u_ty_str = pass6_get_var_type(unwrapped_arg1.name)
            end
            var is_int_act = false
            if arg1.node_type != AstType.CastExpr and a_ty == TypeKind.Int do is_int_act = true end
            if fat_str_len(a_ty_str) > 0 and (fat_cstr_eq(a_ty_str, "[int]") == 1) do is_int_act = true end
            if fat_str_len(u_ty_str) > 0 do
                if fat_cstr_eq(u_ty_str, "[int]") == 1 do
                    is_int_act = true
                end
                if is_tensor_type_str(u_ty_str) do
                    let el_code = parse_tensor_elem_code(u_ty_str)
                    if el_code != 1 and el_code != 2 and el_code != 7 do
                        is_int_act = true
                    end
                end
            end
            if is_int_act do
                report_error(diag, 3001, arg1.line, 0)
            end
        end
    end
    found = pass6_lookup_chain(symbols, scopes, scope_current_id(scopes), node.name)
    if found != -1 do
        sym = pass6_symbol_at(symbols, found)
        arg_count = child_count
        # param_count < 0 means unknown (fresh extern stub) — skip arity check.
        if sym.kind == SymbolKind.Func and sym.param_count >= 0 and sym.param_count != arg_count do
            report_error(diag, 3004, node.line, 0)
        end
    end
    extern_decl_raw = pass6_find_extern(node.name)
    if extern_decl_raw != 0 do
        decl = extern_decl_raw as AstNode
        var ai = 0
        var pi = 0
        when ai < child_count and pi < vec_len_rt(decl.children) loop
                param = vec_get_rt(decl.children, pi)
                if param.node_type != AstType.Block do
                    expected = pass6_resolve_ffi_type(param.name2)
                    actual = pass6_infer_type(symbols, scopes, vec_get_rt(node.children, ai))
                # FFI boundaries require exact semantic categories.  The
                # general assignment checker intentionally treats several
                # pointer-sized values as compatible, which is unsafe for
                # a foreign ABI declaration.
                if expected != TypeKind.Void and actual != TypeKind.Void and expected != actual do
                    var ffi_arg = vec_get_rt(node.children, ai) as AstNode
                    pass6_report_type_mismatch(diag, symbols, scopes, node, ffi_arg, param.name2, pass6_type_kind_to_str(actual))
                end
                ai = ai + 1
            end
            pi = pi + 1
        end
    end
    call_ast = pass6_find_free_function(node.name)
    if (call_ast as i64) != 0 do
        if call_ast.builtin_id != 0 do
            fn_decl_cnt = count_list_items(call_ast.builtin_id as string)
            var fn_prov_cnt = 0
            if fat_str_len(node.name2) > 0 do
                fn_prov_cnt = count_list_items(node.name2)
            end
            if fn_decl_cnt != fn_prov_cnt do
                report_error(diag, 3085, node.line, 0)
            end
        end
        var fn_params = vec_new_rt()
        var fpi = 0
        when fpi < vec_len_rt(call_ast.children) loop
            p_ch = vec_get_rt(call_ast.children, fpi)
            nt_p = p_ch.node_type
            if nt_p == AstType.ParamDef or nt_p == AstType.RefParam or nt_p == AstType.OutParam or nt_p == AstType.Identifier do
                fn_params = vec_push_rt(fn_params, p_ch)
            end
            fpi = fpi + 1
        end

        var mut_args_seen = vec_new_rt()
        var ai = 0
        when ai < child_count and ai < vec_len_rt(fn_params) loop
            param_def = vec_get_rt(fn_params, ai) as AstNode
            arg_expr = vec_get_rt(node.children, ai) as AstNode
            is_ref_p = param_def.node_type == AstType.RefParam or param_def.int_val == 1
            is_out_p = param_def.node_type == AstType.OutParam or param_def.int_val == 2
            is_mut_p = is_ref_p or is_out_p

            # Parameter annotations constrain all modes, including ordinary
            # in/value parameters.
            if fat_str_len(param_def.name2) > 0 do
                var param_ty_str = param_def.name2
                if fat_str_len(node.name2) > 0 do
                    if (call_ast.builtin_id as i64) != 0 do
                        param_ty_str = pass6_substitute_generic_type(call_ast.builtin_id as string, node.name2, param_def.name2)
                    end
                end
                expected_ty = pass6_resolve_ffi_type(param_ty_str)
                actual_ty = pass6_infer_type(symbols, scopes, arg_expr)
                var p_ent_ast = pass6_find_entity_ast(symbols, scopes, pass6_extract_base_name(param_ty_str))
                if (p_ent_ast as i64) != 0 do
                    if arg_expr.node_type == AstType.ArrayLiteral do
                        pass6_report_type_mismatch(diag, symbols, scopes, node, arg_expr, param_ty_str, "")
                    eif arg_expr.node_type == AstType.LiteralStr or (arg_expr.node_type == AstType.LiteralInt and arg_expr.int_val != 0) or arg_expr.node_type == AstType.LiteralBool or arg_expr.node_type == AstType.DictLiteral or arg_expr.node_type == AstType.TupleExpr do
                        pass6_report_type_mismatch(diag, symbols, scopes, node, arg_expr, param_ty_str, "")
                    eif arg_expr.node_type == AstType.LiteralInt and arg_expr.int_val == 0 do
                        # 0 is null pointer/entity reference
                    else
                        var arg_str = pass6_get_expr_type_str(symbols, scopes, arg_expr)
                        if fat_str_len(arg_str) > 0 do
                            if pass6_is_array_type_str(arg_str) do
                                pass6_report_type_mismatch(diag, symbols, scopes, node, arg_expr, param_ty_str, arg_str)
                            else
                                var a_ent_call = pass6_find_entity_ast(symbols, scopes, pass6_extract_base_name(arg_str))
                                if (a_ent_call as i64) != 0 do
                                    if pass6_type_strings_compatible(symbols, scopes, param_ty_str, arg_str) == 0 do
                                        pass6_report_type_mismatch(diag, symbols, scopes, node, arg_expr, param_ty_str, arg_str)
                                    end
                                end
                            end
                        end
                    end
                eif pass6_is_array_type_str(param_ty_str) do
                    if arg_expr.node_type == AstType.EntityLiteral do
                        pass6_report_type_mismatch(diag, symbols, scopes, node, arg_expr, param_ty_str, "")
                    eif arg_expr.node_type == AstType.LiteralStr or arg_expr.node_type == AstType.LiteralInt or arg_expr.node_type == AstType.LiteralBool or arg_expr.node_type == AstType.DictLiteral or arg_expr.node_type == AstType.TupleExpr do
                        pass6_report_type_mismatch(diag, symbols, scopes, node, arg_expr, param_ty_str, "")
                    else
                        var arg_arr_str = pass6_get_expr_type_str(symbols, scopes, arg_expr)
                        if fat_str_len(arg_arr_str) > 0 do
                            var a_ent_call2 = pass6_find_entity_ast(symbols, scopes, pass6_extract_base_name(arg_arr_str))
                            if (a_ent_call2 as i64) != 0 do
                                pass6_report_type_mismatch(diag, symbols, scopes, node, arg_expr, param_ty_str, arg_arr_str)
                            eif pass6_type_strings_compatible(symbols, scopes, param_ty_str, arg_arr_str) == 0 do
                                pass6_report_type_mismatch(diag, symbols, scopes, node, arg_expr, param_ty_str, arg_arr_str)
                            end
                        end
                    end
                else
                    if expected_ty != TypeKind.Void and actual_ty != TypeKind.Void do
                        if is_mut_p and expected_ty != actual_ty do
                            pass6_report_type_mismatch(diag, symbols, scopes, node, arg_expr, param_ty_str, pass6_type_kind_to_str(actual_ty))
                        eif not is_mut_p and pass6_call_arg_types_compatible(symbols, scopes, expected_ty as i64, actual_ty, arg_expr, param_ty_str, param_def.name, node.name) == 0 do
                            pass6_report_type_mismatch(diag, symbols, scopes, node, arg_expr, param_ty_str, pass6_type_kind_to_str(actual_ty))
                        end
                    end
                end
            end

            if is_mut_p do
                # 1. Lvalue check (temporary / literal check) -> E3048
                is_lval = arg_expr.node_type == AstType.Identifier or arg_expr.node_type == AstType.FieldAccess or arg_expr.node_type == AstType.IndexAccess or arg_expr.node_type == AstType.ExprIndex
                if not is_lval do
                    report_error(diag, 3048, node.line, 0)
                end

                # 2. All mutable lvalues: overlapping aliases, root
                # mutability, and initialized-before-ref.
                if is_lval do
                    var was_seen = false
                    var si = 0
                    when si < vec_len_rt(mut_args_seen) loop
                        prev_arg = vec_get_rt(mut_args_seen, si) as AstNode
                        if pass6_lvalues_may_overlap(prev_arg, arg_expr) do
                            was_seen = true
                        end
                        si = si + 1
                    end
                    if was_seen do
                        report_error(diag, 5003, node.line, 0)
                    else
                        mut_args_seen = vec_push_rt(mut_args_seen, arg_expr as i64)
                    end

                    root_name = pass6_lvalue_root_name(arg_expr)
                    # Lookup the owner/root symbol.  Field and index lvalues
                    # inherit writability and initialization from this root.
                    arg_sym_idx = pass6_lookup_chain(symbols, scopes, scope_current_id(scopes), root_name)
                    if arg_sym_idx == -1 do
                        arg_sym_idx = pass6_lookup_global(symbols, root_name)
                    end
                    if arg_sym_idx != -1 do
                        sym_ptr = pass6_symbol_at(symbols, arg_sym_idx) as i64
                        sym_kind = native_read_i64(sym_ptr, 0)
                        is_mut = native_read_i64(sym_ptr, 40)
                        ast_ptr = native_read_i64(sym_ptr, 32)

                        # Immutability check -> E3003
                        var is_immutable = false
                        if sym_kind == (SymbolKind.Const as i64) or is_mut == 0 do
                            is_immutable = true
                        eif ast_ptr != 0 do
                            decl_node_imm = ast_ptr as AstNode
                            if decl_node_imm.node_type == AstType.ConstDecl do
                                is_immutable = true
                            end
                        end
                        if is_immutable do
                            report_error(diag, 3003, node.line, 0)
                        end

                        # Uninitialized check for ref -> E3049
                        if is_ref_p and sym_kind == (SymbolKind.Variable as i64) do
                            if ast_ptr != 0 do
                                decl_node = ast_ptr as AstNode
                                if decl_node.node_type == AstType.VarDecl and vec_len_rt(decl_node.children) == 0 do
                                    var was_assigned = false
                                    var as_i = 0
                                    when as_i < vec_len_rt(g_pass6_assigned_vars) loop
                                        if fat_str_eq(vec_get_rt(g_pass6_assigned_vars, as_i) as string, arg_expr.name) == 1 do
                                            was_assigned = true
                                        eif fat_str_eq(vec_get_rt(g_pass6_assigned_vars, as_i) as string, root_name) == 1 do
                                            was_assigned = true
                                        end
                                        as_i = as_i + 1
                                    end
                                    if not was_assigned do
                                        report_error(diag, 3049, node.line, 0)
                                    end
                                end
                            end
                        end
                    end
                    # A successful normal return initializes an identifier
                    # passed to an out parameter for following calls.
                    if is_out_p and arg_expr.node_type == AstType.Identifier do
                        if pass6_name_in_vec(g_pass6_assigned_vars, arg_expr.name) == 0 do
                            g_pass6_assigned_vars = vec_push_rt(g_pass6_assigned_vars, arg_expr.name as i64)
                        end
                    end
                end
            end
            ai = ai + 1
        end
    end
    var i = 0
    when i < child_count loop
        child = vec_get_rt(node.children, i)
        pass6_walk(symbols, scopes, diag, child)
        i = i + 1
    end
    out 0
end.


func pass6WalkReturnStmt(ref symbols: SymbolTable, ref scopes: ScopeTree, diag: &DiagnosticEngine, node: &AstNode) -> int:
    if vec_len_rt(node.children) > 0 do
        var ret_val_node = vec_get_rt(node.children, 0) as AstNode
        pass6_walk(symbols, scopes, diag, ret_val_node)
        if g_pass6_current_func_ret_type != 0 do
            var cur_ret_str = g_pass6_current_func_ret_type as string
            if fat_str_len(cur_ret_str) > 0 do
                var actual_ret_kind = pass6_infer_type(symbols, scopes, ret_val_node)
                var ret_ent = pass6_find_entity_ast(symbols, scopes, pass6_extract_base_name(cur_ret_str))
                if (ret_ent as i64) != 0 do
                    if ret_val_node.node_type == AstType.ArrayLiteral do
                        pass6_report_return_type_mismatch(diag, symbols, scopes, node, ret_val_node, cur_ret_str)
                    eif ret_val_node.node_type == AstType.LiteralStr or (ret_val_node.node_type == AstType.LiteralInt and ret_val_node.int_val != 0) or ret_val_node.node_type == AstType.LiteralBool or ret_val_node.node_type == AstType.DictLiteral or ret_val_node.node_type == AstType.TupleExpr do
                        pass6_report_return_type_mismatch(diag, symbols, scopes, node, ret_val_node, cur_ret_str)
                    eif ret_val_node.node_type == AstType.LiteralInt and ret_val_node.int_val == 0 do
                        # 0 is null pointer/entity reference
                    else
                        var r_val_str = pass6_get_expr_type_str(symbols, scopes, ret_val_node)
                        if fat_str_len(r_val_str) > 0 do
                            if pass6_is_array_type_str(r_val_str) do
                                pass6_report_return_type_mismatch(diag, symbols, scopes, node, ret_val_node, cur_ret_str)
                            else
                                var r_a_ent = pass6_find_entity_ast(symbols, scopes, pass6_extract_base_name(r_val_str))
                                if (r_a_ent as i64) != 0 do
                                    if pass6_type_strings_compatible(symbols, scopes, cur_ret_str, r_val_str) == 0 do
                                        pass6_report_return_type_mismatch(diag, symbols, scopes, node, ret_val_node, cur_ret_str)
                                    end
                                end
                            end
                        end
                    end
                eif pass6_is_array_type_str(cur_ret_str) do
                    if ret_val_node.node_type == AstType.EntityLiteral do
                        pass6_report_return_type_mismatch(diag, symbols, scopes, node, ret_val_node, cur_ret_str)
                    eif ret_val_node.node_type == AstType.LiteralStr or ret_val_node.node_type == AstType.LiteralInt or ret_val_node.node_type == AstType.LiteralBool or ret_val_node.node_type == AstType.DictLiteral or ret_val_node.node_type == AstType.TupleExpr do
                        pass6_report_return_type_mismatch(diag, symbols, scopes, node, ret_val_node, cur_ret_str)
                    else
                        var r_val_arr_str = pass6_get_expr_type_str(symbols, scopes, ret_val_node)
                        if fat_str_len(r_val_arr_str) > 0 do
                            var r_a_ent2 = pass6_find_entity_ast(symbols, scopes, pass6_extract_base_name(r_val_arr_str))
                            if (r_a_ent2 as i64) != 0 do
                                pass6_report_return_type_mismatch(diag, symbols, scopes, node, ret_val_node, cur_ret_str)
                            eif pass6_type_strings_compatible(symbols, scopes, cur_ret_str, r_val_arr_str) == 0 do
                                pass6_report_return_type_mismatch(diag, symbols, scopes, node, ret_val_node, cur_ret_str)
                            end
                        end
                    end
                else
                    var ret_expected_kind = pass6_resolve_ffi_type(cur_ret_str)
                    if ret_expected_kind == TypeKind.String and ret_val_node.node_type == AstType.LiteralInt do
                        pass6_report_return_type_mismatch(diag, symbols, scopes, node, ret_val_node, cur_ret_str)
                    eif ret_expected_kind == TypeKind.Int and ret_val_node.node_type == AstType.LiteralStr do
                        pass6_report_return_type_mismatch(diag, symbols, scopes, node, ret_val_node, cur_ret_str)
                    eif ret_expected_kind == TypeKind.Bool and (ret_val_node.node_type == AstType.LiteralStr or ret_val_node.node_type == AstType.LiteralInt) do
                        pass6_report_return_type_mismatch(diag, symbols, scopes, node, ret_val_node, cur_ret_str)
                    eif ret_expected_kind != TypeKind.Void and ret_expected_kind != TypeKind.None and actual_ret_kind != TypeKind.Void do
                        if pass6_types_compatible(ret_expected_kind as i64, actual_ret_kind) == 0 do
                            # In system/compiler modules, allow bool↔int return mismatch.
                            var allow_ret = 0
                            if is_user_module(g_pass6_cur_module) == 0 do
                                if (ret_expected_kind == TypeKind.Bool and pass6_is_integer_like(actual_ret_kind as i64) == 1) or (pass6_is_integer_like(ret_expected_kind as i64) == 1 and actual_ret_kind == TypeKind.Bool) do
                                    allow_ret = 1
                                end
                            end
                            if allow_ret == 0 do
                                pass6_report_return_type_mismatch(diag, symbols, scopes, node, ret_val_node, cur_ret_str)
                            end
                        end
                    end
                end
            end
        end
    end
    out 0
    out 0
end.

export pass6WalkAssign, pass6WalkCall, pass6WalkReturnStmt
