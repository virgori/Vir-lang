##
 * compiler/src/semantic/typecheck/methods.vri — Method and Receiver Resolution Service
 * ==================================================================================
 * VIRC-PLN-0003 Section 5.5: Method and Receiver Resolution Service.
 *
 * Implements entity method lookup, method signature analysis (this-param,
 * parameter counts), entity field lookup, and entity AST retrieval.
 ##

include vec_rt
import vec_len_rt, vec_get_rt, vec_push_rt, vec_set_rt, vec_new_rt from vec_rt

include string_rt
import fat_str_len, fat_str_byte_at, fat_str_eq, fat_str_new, fat_str_slice, fat_cstr_eq, fat_str_concat from string_rt

include virc.frontend.parser

include virc.semantic.symbol_table
import SymbolTable, SymbolKind, SymbolNode from virc.semantic.symbol_table

include virc.semantic.scope_tree
import ScopeTree, scope_current_id from virc.semantic.scope_tree

include virc.semantic.typecheck.context
import TypecheckContext from virc.semantic.typecheck.context

include virc.semantic.typecheck.index
import typecheck_hash_name from virc.semantic.typecheck.index

include virc.semantic.typecheck.compatibility
import typecheck_unwrap_type_name, typecheck_extract_base_name from virc.semantic.typecheck.compatibility

include virc.semantic.typecheck.calls
import typecheck_callable_return_type, typecheck_find_free_function_raw,
       typecheck_find_func_by_canonical_identity_raw from virc.semantic.typecheck.calls

func typecheck_find_entity_method(ent_ast: &AstNode, mname: &string) -> AstNode:
    if (ent_ast as i64) == 0 or fat_str_len(mname) == 0 do out 0 as AstNode end
    let n = vec_len_rt(ent_ast.children)
    var i = 0
    when i < n loop
        let ch = vec_get_rt(ent_ast.children, i) as AstNode
        if ch.node_type == AstType.FuncDef and fat_str_eq(ch.name, mname) == 1 do
            out ch
        end
        i = i + 1
    end
    out 0 as AstNode
end.

func typecheck_find_entity_field(ent_ast: &AstNode, fname: &string) -> AstNode:
    if (ent_ast as i64) == 0 or fat_str_len(fname) == 0 do out 0 as AstNode end
    let n = vec_len_rt(ent_ast.children)
    var i = 0
    when i < n loop
        let ch = vec_get_rt(ent_ast.children, i) as AstNode
        if (ch.node_type == AstType.Identifier or ch.node_type == AstType.VarDecl) and fat_str_eq(ch.name, fname) == 1 do
            out ch
        end
        i = i + 1
    end
    out 0 as AstNode
end.

func typecheck_entity_has_field(ent_ast: &AstNode, fname: &string) -> int:
    let f = typecheck_find_entity_field(ent_ast, fname)
    if (f as i64) != 0 do out 1 end
    out 0
end.

func typecheck_method_param_count(method_node: &AstNode) -> int:
    if (method_node as i64) == 0 do out 0 end
    let n = vec_len_rt(method_node.children)
    var i = 0
    when i < n loop
        let ch = vec_get_rt(method_node.children, i) as AstNode
        if ch.node_type == AstType.Block do
            out i
        end
        i = i + 1
    end
    out n
end.

func typecheck_method_has_this(method_node: &AstNode) -> int:
    if (method_node as i64) == 0 do out 0 end
    let n = vec_len_rt(method_node.children)
    if n > 0 do
        let p0 = vec_get_rt(method_node.children, 0) as AstNode
        if fat_cstr_eq(p0.name, "this") == 1 do
            out 1
        end
    end
    out 0
end.

func typecheck_find_entity_ast_raw(entity_buckets: i64, name: &string) -> AstNode:
    if entity_buckets == 0 or fat_str_len(name) == 0 do out 0 as AstNode end
    let bid = typecheck_hash_name(name)
    let bucket = vec_get_rt(entity_buckets, bid)
    let count = vec_len_rt(bucket)
    var i = 0
    when i < count loop
        let cand = vec_get_rt(bucket, i) as AstNode
        if fat_str_eq(cand.name, name) == 1 do
            out cand
        end
        i = i + 1
    end
    out 0 as AstNode
end.

func typecheck_find_entity_ast(ref ctx: TypecheckContext, name: &string) -> AstNode:
    out typecheck_find_entity_ast_raw(ctx.entity_buckets, name)
end.

export typecheck_find_entity_method, typecheck_find_entity_field,
       typecheck_entity_has_field, typecheck_method_param_count,
       typecheck_method_has_this, typecheck_find_entity_ast_raw,
       typecheck_find_entity_ast
