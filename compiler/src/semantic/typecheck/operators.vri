##
 * compiler/src/semantic/typecheck/operators.vri — Operator Type Rules Service
 * =========================================================================
 * VIRC-PLN-0003 Section 5.5: Operator Type Rules Service.
 *
 * Implements binary and unary operator type compatibility rules:
 * - String concatenation (`+` only)
 * - Bool arithmetic prohibition (with runtime int bridging)
 * - Bitwise shift integer requirement
 * - Logical/bitwise and, or, xor requirement
 * - Constant integer expression folding for operator semantics
 ##

include typecheck_context
include typecheck_compatibility

func typecheck_is_logic_bit_operand(k: TypeKind) -> int:
    if k == TypeKind.Bool do
        out 1
    end
    out typecheck_is_integer_like(k as i64)
end.

func typecheck_check_binop_types(op: int, lt: TypeKind, rt: TypeKind) -> int:
    # String concatenation rules (`+` only).
    if op == OpType.Add as int do
        if lt == TypeKind.String and rt != TypeKind.String and typecheck_is_integer_like(rt as i64) == 0 do
            out 3001
        eif lt != TypeKind.String and rt == TypeKind.String and typecheck_is_integer_like(lt as i64) == 0 do
            out 3001
        end
    else
        if lt == TypeKind.String or rt == TypeKind.String do
            out 3001
        end
    end

    # Bool arithmetic prohibition (allow logical & comparison ops).
    # Vir bool is 0/1 at runtime — allow arithmetic with integer-like other side.
    if lt == TypeKind.Bool or rt == TypeKind.Bool do
        if op != OpType.Eq as int and op != OpType.Ne as int and op != OpType.Land as int and op != OpType.Lor as int and op != OpType.AndOp as int and op != OpType.OrOp as int and op != OpType.XorOp as int do
            var other = rt
            if lt == TypeKind.Bool do
                other = rt
            else
                other = lt
            end
            if typecheck_is_integer_like(other as i64) == 0 do
                out 3002
            end
        end
    end

    # Bitwise shifts require integers.
    if op == OpType.ShlOp as int or op == OpType.ShrOp as int do
        if typecheck_is_integer_like(lt as i64) == 0 or typecheck_is_integer_like(rt as i64) == 0 do
            out 3006
        end
    end

    # Bitwise/logical And/Or/Xor require logical or bitwise operands.
    if op == OpType.AndOp as int or op == OpType.OrOp as int or op == OpType.XorOp as int or op == OpType.Land as int or op == OpType.Lor as int do
        if typecheck_is_logic_bit_operand(lt) == 0 or typecheck_is_logic_bit_operand(rt) == 0 do
            out 3006
        end
    end

    out 0
end.

func typecheck_eval_const_binop(op: int, lv: int, rv: int) -> (int, int):
    if op == OpType.Add as int do out (1, lv + rv) end
    if op == OpType.Sub as int do out (1, lv - rv) end
    if op == OpType.Mul as int do out (1, lv * rv) end
    if op == OpType.Div as int and rv != 0 do out (1, lv / rv) end
    if op == OpType.ModOp as int and rv != 0 do out (1, lv mod rv) end
    out (0, 0)
end.

export typecheck_is_logic_bit_operand, typecheck_check_binop_types,
       typecheck_eval_const_binop
