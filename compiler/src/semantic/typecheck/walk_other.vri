##
 * compiler/src/semantic/typecheck/walk_other.vri — Miscellaneous AST Walk Handlers
 * ================================================================================
 * VIRC-PLN-0004 Section 5: Handlers for statements, literals, and control blocks.
 *
 * Implements:
 * - Statement walkers: Throw, Print, AddrOf, Emit, AtomicVarDecl, BindAttr, Block, MapExpr
 * - Expression walkers: QuantizeExpr, InterpExpr, PercentExpr, CastExpr, Compare, EnumConstruct, DictLiteral
 * - Compute block walkers: InferBlock, TrainBlock, ReactiveBlock
 ##

include typecheck_context
include typecheck_lvalue
include typecheck_enums
include typecheck_tensor
include ide_facts


func pass6WalkThrowStmt(ref symbols: SymbolTable, ref scopes: ScopeTree, diag: &DiagnosticEngine, node: &AstNode) -> int:
    if vec_len_rt(node.children) != 1 do
        report_error(diag, 3059, node.line, 0)
    else
        throw_ty = pass6_infer_type(symbols, scopes, vec_get_rt(node.children, 0) as AstNode)
        if throw_ty != TypeKind.Void and throw_ty != TypeKind.Int do
            report_error(diag, 3059, node.line, 0)
        end
    end
    out 0
end.

func pass6WalkPrintStmt(ref symbols: SymbolTable, ref scopes: ScopeTree, diag: &DiagnosticEngine, node: &AstNode) -> int:
    if vec_len_rt(node.children) > 0 do
        var p_expr = vec_get_rt(node.children, 0) as AstNode
        pass6_walk(symbols, scopes, diag, p_expr)
        var p_ty = pass6_infer_type(symbols, scopes, p_expr)
        var p_is_ent = false
        if p_expr.node_type == AstType.EntityLiteral do
            p_is_ent = true
        eif p_expr.node_type == AstType.Identifier do
            var p_ent_name = pass6_get_var_type(p_expr.name)
            if fat_str_len(p_ent_name) > 0 do
                var p_raw = pass6_unwrap_type_name(p_ent_name)
                if (pass6_find_entity_ast(symbols, scopes, p_raw) as i64) != 0 do
                    p_is_ent = true
                end
            end
        eif p_ty == TypeKind.Entity do
            var ent_cname = fat_str_new("")
            if p_expr.node_type == AstType.Call or p_expr.node_type == AstType.MethodCall do
                ent_cname = pass6_get_receiver_entity_name(symbols, scopes, p_expr)
            end
            if fat_str_len(ent_cname) > 0 do
                var ent_raw = pass6_unwrap_type_name(ent_cname)
                if (pass6_find_entity_ast(symbols, scopes, ent_raw) as i64) != 0 do
                    p_is_ent = true
                end
            end
        end
        if p_is_ent or p_ty == TypeKind.Pointer do
            report_error(diag, 3001, node.line, 0)
        end
        out 0
    end
    out 0
end.

func pass6WalkAddrOf(ref symbols: SymbolTable, ref scopes: ScopeTree, diag: &DiagnosticEngine, node: &AstNode) -> int:
    if vec_len_rt(node.children) > 0 do
        var target = vec_get_rt(node.children, 0) as AstNode
        pass6_walk(symbols, scopes, diag, target)
        var is_mut_borrow = false
        if fat_cstr_eq(node.name, "mut") == 1 or node.int_val == 1 do
            is_mut_borrow = true
        end
        if is_mut_borrow do
            var is_immutable = false
            var root_name = pass6_lvalue_root_name(target)
            if fat_str_len(root_name) > 0 do
                var addr_sid = pass6_lookup_chain(symbols, scopes, scope_current_id(scopes), root_name)
                if addr_sid != -1 do
                    var addr_sym = pass6_symbol_at(symbols, addr_sid)
                    if addr_sym.ast_id != 0 do
                        var d_ast = addr_sym.ast_id as AstNode
                        if d_ast.node_type == AstType.ConstDecl do
                            is_immutable = true
                        end
                        var d_ty = d_ast.name2
                        if fat_str_len(d_ty) > 0 do
                            if fat_str_byte_at(d_ty, 0) == 38 do
                                var has_mut = false
                                var blen = fat_str_len(d_ty)
                                if blen >= 4 and fat_str_byte_at(d_ty, 1) == 109 and fat_str_byte_at(d_ty, 2) == 117 and fat_str_byte_at(d_ty, 3) == 116 do
                                    has_mut = true
                                end
                                if not has_mut do
                                    is_immutable = true
                                end
                            eif fat_str_len(d_ty) >= 4 and fat_str_byte_at(d_ty, 0) == 114 and fat_str_byte_at(d_ty, 1) == 101 and fat_str_byte_at(d_ty, 2) == 102 and fat_str_byte_at(d_ty, 3) == 32 do
                                is_immutable = true
                            end
                        end
                    end
                end
            end
            if is_immutable do
                report_error(diag, 3003, node.line, 0)
            end
        end
    end
    out 0
end.

func pass6WalkEmitStmt(ref symbols: SymbolTable, ref scopes: ScopeTree, diag: &DiagnosticEngine, node: &AstNode) -> int:
    if vec_len_rt(node.children) != 1 do
        report_error(diag, 3073, node.line, 0)
    else
        emit_expr = vec_get_rt(node.children, 0) as AstNode
        if emit_expr.node_type != AstType.Call and emit_expr.node_type != AstType.EntityLiteral do
            report_error(diag, 3073, node.line, 0)
        end
    end
    out 0
end.

func pass6WalkAtomicVarDecl(ref symbols: SymbolTable, ref scopes: ScopeTree, diag: &DiagnosticEngine, node: &AstNode) -> int:
    if vec_len_rt(node.children) != 1 do
        report_error(diag, 3072, node.line, 0)
    else
        atomic_decl = vec_get_rt(node.children, 0) as AstNode
        atomic_ty = pass6_resolve_ffi_type(atomic_decl.name2)
        if atomic_ty == TypeKind.String or atomic_ty == TypeKind.Pointer or atomic_ty == TypeKind.Entity or atomic_ty == TypeKind.Array or atomic_ty == TypeKind.Tensor do
            report_error(diag, 3072, node.line, 0)
        end
    end
    out 0
end.

func pass6WalkQuantizeExpr(ref symbols: SymbolTable, ref scopes: ScopeTree, diag: &DiagnosticEngine, node: &AstNode) -> int:
    q_count = vec_len_rt(node.children)
    if q_count != 2 do
        report_error(diag, 3019, node.line, 0)
    else
        q_value = vec_get_rt(node.children, 0)
        q_bits_expr = vec_get_rt(node.children, 1)
        q_value_type = pass6_infer_type(symbols, scopes, q_value)
        q_tensor_name = pass6_tensor_type_name(symbols, scopes, q_value)
        let q_val_err = typecheck_check_quantize_val(q_value_type, q_tensor_name)
        if q_val_err != 0 do
            report_error(diag, q_val_err, node.line, 0)
        end
        var q_bits = 8
        if q_bits_expr.node_type != AstType.LiteralInt do
            report_error(diag, 3019, q_bits_expr.line, 0)
        else
            q_bits = q_bits_expr.int_val
            let q_bit_err = typecheck_check_quantize_bits(q_bits)
            if q_bit_err != 0 do
                report_error(diag, q_bit_err, q_bits_expr.line, 0)
            end
        end
        if is_tensor_type_str(q_tensor_name) do
            let elem_c = parse_tensor_elem_code(q_tensor_name as int)
            let shape_v = parse_tensor_shape(q_tensor_name)
            node.name2 = format_quantized_uniform_type(elem_c, q_bits, shape_v)
        else
            node.name2 = fat_str_new("QuantizedTensor")
        end
        pass6_walk(symbols, scopes, diag, q_value)
        pass6_walk(symbols, scopes, diag, q_bits_expr)
    end
    out 0
end.

func pass6WalkInterpExpr(ref symbols: SymbolTable, ref scopes: ScopeTree, diag: &DiagnosticEngine, node: &AstNode) -> int:
    child_count = vec_len_rt(node.children)
    var i = 0
    when i < child_count loop
        child = vec_get_rt(node.children, i)
        pass6_walk(symbols, scopes, diag, child)
        if child.node_type != AstType.LiteralStr do
            ct = pass6_infer_interp_type(symbols, scopes, child)
            # Preserve call/method builtin_id metadata. int_val is unused on
            # non-literal interpolation children and carries the checked
            # TypeKind across the semantic arena into AST-to-MIR.
            child.int_val = ct as int
            # Spec §12 defines string, integer, bool and none formatting.
            # Other representations must be rejected rather than passed to
            # str_cat as raw pointers. Float formatting has no Spec contract.
            if ct != TypeKind.String and ct != TypeKind.Int and ct != TypeKind.Bool and ct != TypeKind.None do
                report_error(diag, 3001, child.line, 0)
            end
        end
        i = i + 1
    end
    out 0
end.

func pass6WalkPercentExpr(ref symbols: SymbolTable, ref scopes: ScopeTree, diag: &DiagnosticEngine, node: &AstNode) -> int:
    percent_child_count = vec_len_rt(node.children)
    if percent_child_count != 1 do
        report_error(diag, 3002, node.line, 0)
    else
        percent_value = vec_get_rt(node.children, 0)
        percent_type = pass6_infer_type(symbols, scopes, percent_value)
        if percent_type != TypeKind.Void and percent_type != TypeKind.Int and percent_type != TypeKind.Float do
            report_error(diag, 3002, node.line, 0)
        end
        pass6_walk(symbols, scopes, diag, percent_value)
    end
    out 0
end.

func pass6WalkCastExpr(ref symbols: SymbolTable, ref scopes: ScopeTree, diag: &DiagnosticEngine, node: &AstNode) -> int:
    if pass6_is_valid_type(symbols, scopes, node.name) == false do
        pass6_report_type_mismatch(diag, symbols, scopes, node, node, node.name, "unknown")
    end
    out 0
end.

func pass6WalkCompare(ref symbols: SymbolTable, ref scopes: ScopeTree, diag: &DiagnosticEngine, node: &AstNode) -> int:
    child_count_cmp = vec_len_rt(node.children)
    if child_count_cmp >= 2 do
        left_cmp = vec_get_rt(node.children, 0) as AstNode
        right_cmp = vec_get_rt(node.children, 1) as AstNode
        left_type_str = pass6_get_receiver_entity_name(symbols, scopes, left_cmp)
        right_type_str = pass6_get_receiver_entity_name(symbols, scopes, right_cmp)
        left_enum = pass6_find_enum_ast(symbols, scopes, left_type_str)
        right_enum = pass6_find_enum_ast(symbols, scopes, right_type_str)
        typecheck_check_enum_compare(diag, left_enum, right_enum, node.line)
    end
    out 0
end.

func pass6WalkEnumConstruct(ref symbols: SymbolTable, ref scopes: ScopeTree, diag: &DiagnosticEngine, node: &AstNode) -> int:
    arg_start = typecheck_check_enum_construct(diag, node)
    var vi = arg_start
    let child_count = vec_len_rt(node.children)
    when vi < child_count loop
        pass6_walk(symbols, scopes, diag, vec_get_rt(node.children, vi))
        vi = vi + 1
    end
    out 0
end.

func pass6WalkDictLiteral(ref symbols: SymbolTable, ref scopes: ScopeTree, diag: &DiagnosticEngine, node: &AstNode) -> int:
    key_type = pass6_dict_literal_key_type(symbols, scopes, node)
    child_count = vec_len_rt(node.children)
    var ki = 2
    when ki < child_count loop
        key_node = vec_get_rt(node.children, ki) as AstNode
        given_type = pass6_dict_key_expr_type(symbols, scopes, key_node)
        if key_type != TypeKind.Void and given_type != TypeKind.Void and given_type != key_type do
            pass6_report_type_mismatch(diag, symbols, scopes, node, key_node, pass6_type_kind_to_str(key_type), pass6_type_kind_to_str(given_type))
        end
        ki = ki + 2
    end
    var ci = 0
    when ci < child_count loop
        pass6_walk(symbols, scopes, diag, vec_get_rt(node.children, ci) as AstNode)
        ci = ci + 1
    end
    out 0
end.

func pass6WalkBindAttr(ref symbols: SymbolTable, ref scopes: ScopeTree, diag: &DiagnosticEngine, node: &AstNode) -> int:
    if fat_cstr_eq(node.name2, "c") == 1 or fat_cstr_eq(node.name2, "wasm") == 1 or fat_cstr_eq(node.name, "c") == 1 or fat_cstr_eq(node.name, "wasm") == 1 do
        if vec_len_rt(node.children) > 0 do
            fn_child = vec_get_rt(node.children, 0) as AstNode
            if fn_child.node_type == AstType.FuncDef or fn_child.node_type == AstType.ExternFunc do
                var is_wasm = 0
                if fat_cstr_eq(node.name2, "wasm") == 1 or fat_cstr_eq(node.name, "wasm") == 1 do
                    is_wasm = 1
                end
                var fpi = 0
                when fpi < vec_len_rt(fn_child.children) loop
                    fp_node = vec_get_rt(fn_child.children, fpi) as AstNode
                    if fp_node.node_type == AstType.ParamDef or fp_node.node_type == AstType.RefParam or fp_node.node_type == AstType.OutParam or fp_node.node_type == AstType.Identifier do
                        if fat_str_len(fp_node.name2) == 0 do
                            if is_wasm == 1 do
                                report_error_loc(diag, 3095, 0, fn_child.line, 1, "wasm")
                            else
                                report_error_loc(diag, 3095, 0, fn_child.line, 1, "c")
                            end
                        end
                    end
                    fpi = fpi + 1
                end
            end
        end
    end
    child_count = vec_len_rt(node.children)
    if child_count > 0 do
        child = vec_get_rt(node.children, 0)
        pass6_walk(symbols, scopes, diag, child)
    end
    out 0
end.

func pass6WalkInferBlock(ref symbols: SymbolTable, ref scopes: ScopeTree, diag: &DiagnosticEngine, node: &AstNode) -> int:
    old_ai_mode = g_pass6_ai_mode
    if old_ai_mode != 0 do
        report_error(diag, 3016, node.line, 0)
    end
    g_pass6_ai_mode = 1
    child_count = vec_len_rt(node.children)
    var i = 0
    when i < child_count loop
        child = vec_get_rt(node.children, i)
        pass6_walk(symbols, scopes, diag, child)
        i = i + 1
    end
    g_pass6_ai_mode = old_ai_mode
    out 0
end.

func pass6WalkTrainBlock(ref symbols: SymbolTable, ref scopes: ScopeTree, diag: &DiagnosticEngine, node: &AstNode) -> int:
    old_ai_mode = g_pass6_ai_mode
    if old_ai_mode != 0 do
        report_error(diag, 3016, node.line, 0)
    end
    g_pass6_ai_mode = 2
    child_count = vec_len_rt(node.children)
    var i = 0
    when i < child_count loop
        child = vec_get_rt(node.children, i)
        pass6_walk(symbols, scopes, diag, child)
        i = i + 1
    end
    g_pass6_ai_mode = old_ai_mode
    out 0
end.

func pass6WalkReactiveBlock(ref symbols: SymbolTable, ref scopes: ScopeTree, diag: &DiagnosticEngine, node: &AstNode) -> int:
    child_count = vec_len_rt(node.children)
    var i = 0
    when i < child_count loop
        child = vec_get_rt(node.children, i)
        pass6_walk(symbols, scopes, diag, child)
        i = i + 1
    end
    out 0
end.

func pass6WalkBlock(ref symbols: SymbolTable, ref scopes: ScopeTree, diag: &DiagnosticEngine, node: &AstNode) -> int:
    pass6_scope_enter()
    scope_push(scopes, ScopeKind.Block)
    if g_ideFactsEnabled == 1 do
        if g_pass6_current_entity_name != 0 do
            ideFactScope(node as int, scope_current_id(scopes))
        end
    end
    child_count = vec_len_rt(node.children)
    var i = 0
    when i < child_count loop
        child = vec_get_rt(node.children, i)
        pass6_walk(symbols, scopes, diag, child)
        i = i + 1
    end
    scope_pop(scopes)
    pass6_scope_exit()
    out 0
end.

func pass6WalkMapExpr(ref symbols: SymbolTable, ref scopes: ScopeTree, diag: &DiagnosticEngine, node: &AstNode) -> int:
    child_count = vec_len_rt(node.children)
    if child_count > 0 do
        pass6_walk(symbols, scopes, diag, vec_get_rt(node.children, 0))
    end
    pass6_scope_enter()
    scope_push(scopes, ScopeKind.Block)
    if fat_str_len(node.name) > 0 and fat_cstr_eq(node.name, "map") == 0 do
        pass6_register_local(symbols, scopes, node.name, true)
    end
    var mi = 1
    when mi < child_count loop
        pass6_walk(symbols, scopes, diag, vec_get_rt(node.children, mi))
        mi = mi + 1
    end
    scope_pop(scopes)
    pass6_scope_exit()
    out 0
end.

export pass6WalkThrowStmt, pass6WalkPrintStmt, pass6WalkAddrOf, pass6WalkEmitStmt, pass6WalkAtomicVarDecl, pass6WalkQuantizeExpr, pass6WalkInterpExpr, pass6WalkPercentExpr, pass6WalkCastExpr, pass6WalkCompare, pass6WalkEnumConstruct, pass6WalkDictLiteral, pass6WalkBindAttr, pass6WalkInferBlock, pass6WalkTrainBlock, pass6WalkReactiveBlock, pass6WalkBlock, pass6WalkMapExpr
