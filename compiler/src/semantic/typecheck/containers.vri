##
 * compiler/src/semantic/typecheck/containers.vri — Container Type Rules (Array, Dict, Tuple)
 * =========================================================================================
 * VIRC-PLN-0004 Section 5.5 (Phase 7 Part 10): Container Type Rules Service.
 *
 * Implements type checking and verification for containers:
 * - Dict key expression type resolution (string variable identifier override)
 * - Array type string formatting ([elem])
 * - Tensor index rank checking (Error 3013)
 * - Container index type verification (Int index vs Dict key mismatch: Error 3015)
 ##

include typecheck_context
include typecheck_index
include typecheck_compatibility

func typecheck_dict_key_expr_type(node: &AstNode, var_type_str: &string, inferred_type: TypeKind) -> TypeKind:
    if (node as i64) == 0 do out TypeKind.Void end
    if node.node_type == AstType.Identifier and fat_cstr_eq(var_type_str, "string") == 1 do
        out TypeKind.String
    end
    out inferred_type
end.

func typecheck_format_array_type_str(elem_str: &string) -> string:
    if fat_str_len(elem_str) > 0 do
        out fat_str_concat(fat_str_concat(fat_str_new("["), elem_str), fat_str_new("]"))
    end
    out fat_str_new("[]")
end.

func typecheck_check_index_rank(diag: &DiagnosticEngine, line: int, given_indices: int, expected_rank: int):
    if expected_rank > 0 and given_indices != expected_rank do
        report_error(diag, 3013, line, 0)
    end
end.

func typecheck_check_index_expr_type(diag: &DiagnosticEngine, line: int, idx_type: TypeKind, is_dict: bool, dict_key_type: TypeKind) -> int:
    if is_dict do
        if dict_key_type != TypeKind.Void and idx_type != TypeKind.Void and idx_type != dict_key_type do
            out 1 # key mismatch
        end
        out 0
    end
    if idx_type != TypeKind.Void and idx_type != TypeKind.Int do
        report_error(diag, 3015, line, 0)
        out 2 # not integer index error
    end
    out 0
end.

export typecheck_dict_key_expr_type,
       typecheck_format_array_type_str,
       typecheck_check_index_rank,
       typecheck_check_index_expr_type
