##
 * compiler/src/semantic/typecheck/walk_field.vri — Field Access and Assign Walk
 * =============================================================================
 * VIRC-PLN-0004 Section 5: AST walk handlers for FieldAccess and FieldAssign nodes.
 *
 * Implements:
 * - pass6WalkFieldAssign: type-check and validate field mutations
 * - pass6WalkFieldAccess: type-check and resolve field access projections
 ##

include typecheck_context

func pass6WalkFieldAssign(ref symbols: SymbolTable, ref scopes: ScopeTree, diag: &DiagnosticEngine, node: &AstNode) -> int:
    var owner_type = pass6_get_var_type(node.name)
    # fa_is_var_decl: true only if the owner symbol comes from a VarDecl (local binding).
    # Parameter &T declarations (ParamDef/RefParam) are allowed to mutate in
    # current Vir semantics (e.g. arena-allocated AstNode, SymbolTable, etc.).
    var fa_is_var_decl = false
    var f_owner_sym = pass6_lookup_chain(symbols, scopes, scope_current_id(scopes), node.name)
    if f_owner_sym != -1 do
        var f_sym = pass6_symbol_at(symbols, f_owner_sym)
        if f_sym.ast_id != 0 do
            var f_decl = f_sym.ast_id as AstNode
            if f_decl.node_type == AstType.VarDecl or f_decl.node_type == AstType.ConstDecl do
                fa_is_var_decl = true
            end
            if fat_str_len(owner_type) == 0 do
                if fat_str_len(f_decl.name2) > 0 do
                    owner_type = f_decl.name2
                eif vec_len_rt(f_decl.children) > 0 do
                    var f_init = vec_get_rt(f_decl.children, 0) as AstNode
                    if f_init.node_type == AstType.EntityLiteral do
                        owner_type = f_init.name
                    end
                end
            end
        end
    end
    # Mutability check: reject write through local shared &T variable binding.
    # Only for VarDecl (not ParamDef) because param &T is still mutable in
    # current Vir semantics.
    if fa_is_var_decl and fat_str_len(owner_type) > 0 and fat_str_byte_at(owner_type, 0) == 38 do
        var fa_has_mut = false
        var fa_blen = fat_str_len(owner_type)
        if fa_blen >= 5 and fat_str_byte_at(owner_type, 1) == 109 and fat_str_byte_at(owner_type, 2) == 117 and fat_str_byte_at(owner_type, 3) == 116 and fat_str_byte_at(owner_type, 4) == 32 do
            fa_has_mut = true
        end
        if not fa_has_mut do
            report_error(diag, 3003, node.line, 0)
        end
    end
    # Unwrap &T / &mut T prefix for entity lookup so field checks work through refs.
    var fa_lookup_type = pass6_unwrap_type_name(owner_type)
    var owner_def = pass6_find_entity_ast(symbols, scopes, fa_lookup_type)
    if owner_def as i64 != 0 do
        var field_found = false
        var declared_field_type_str = fat_str_new("")
        var fi = 0
        when fi < vec_len_rt(owner_def.children) loop
            var field_def = vec_get_rt(owner_def.children, fi) as AstNode
            if fat_str_eq(field_def.name, node.name2) == 1 do
                field_found = true
                declared_field_type_str = field_def.name2
                let labelNode = ideFactProjection(node as int)
                if labelNode != 0 do ideFactResolve(labelNode, ideFactSymbol(field_def as int), scope_current_id(scopes), 4) end
                fi = vec_len_rt(owner_def.children)
            else
                fi = fi + 1
            end
        end
        if not field_found do
            if pass6_entity_has_field(symbols, scopes, fa_lookup_type, node.name2) == 0 do
                var f_col = node.int_val
                if f_col <= 0 do f_col = 1 end
                report_error_loc(diag, 3008, 0, node.line, f_col, node.name2 as string)
            end
        else
            var rhs_field = vec_get_rt(node.children, 0) as AstNode
            if fat_str_len(declared_field_type_str) > 0 do
                var f_ent_ast = pass6_find_entity_ast(symbols, scopes, pass6_extract_base_name(declared_field_type_str))
                if (f_ent_ast as i64) != 0 do
                    if rhs_field.node_type == AstType.ArrayLiteral do
                        pass6_report_field_type_mismatch(diag, symbols, scopes, node, rhs_field, declared_field_type_str)
                    eif rhs_field.node_type == AstType.LiteralStr or (rhs_field.node_type == AstType.LiteralInt and rhs_field.int_val != 0) or rhs_field.node_type == AstType.LiteralBool or rhs_field.node_type == AstType.DictLiteral or rhs_field.node_type == AstType.TupleExpr do
                        pass6_report_field_type_mismatch(diag, symbols, scopes, node, rhs_field, declared_field_type_str)
                    eif rhs_field.node_type == AstType.LiteralInt and rhs_field.int_val == 0 do
                        # 0 is null pointer/entity reference
                    else
                        var rhs_f_str = pass6_get_expr_type_str(symbols, scopes, rhs_field)
                        if fat_str_len(rhs_f_str) > 0 do
                            if pass6_is_array_type_str(rhs_f_str) do
                                pass6_report_field_type_mismatch(diag, symbols, scopes, node, rhs_field, declared_field_type_str)
                            else
                                var f_a_ent = pass6_find_entity_ast(symbols, scopes, pass6_extract_base_name(rhs_f_str))
                                if (f_a_ent as i64) != 0 do
                                    if pass6_type_strings_compatible(symbols, scopes, declared_field_type_str, rhs_f_str) == 0 do
                                        pass6_report_field_type_mismatch(diag, symbols, scopes, node, rhs_field, declared_field_type_str)
                                    end
                                end
                            end
                        end
                    end
                eif pass6_is_array_type_str(declared_field_type_str) do
                    if rhs_field.node_type == AstType.EntityLiteral do
                        pass6_report_field_type_mismatch(diag, symbols, scopes, node, rhs_field, declared_field_type_str)
                    eif rhs_field.node_type == AstType.LiteralStr or rhs_field.node_type == AstType.LiteralInt or rhs_field.node_type == AstType.LiteralBool or rhs_field.node_type == AstType.DictLiteral or rhs_field.node_type == AstType.TupleExpr do
                        pass6_report_field_type_mismatch(diag, symbols, scopes, node, rhs_field, declared_field_type_str)
                    else
                        var rhs_f_arr_str = pass6_get_expr_type_str(symbols, scopes, rhs_field)
                        if fat_str_len(rhs_f_arr_str) > 0 do
                            var f_a_ent2 = pass6_find_entity_ast(symbols, scopes, pass6_extract_base_name(rhs_f_arr_str))
                            if (f_a_ent2 as i64) != 0 do
                                pass6_report_field_type_mismatch(diag, symbols, scopes, node, rhs_field, declared_field_type_str)
                            eif pass6_type_strings_compatible(symbols, scopes, declared_field_type_str, rhs_f_arr_str) == 0 do
                                pass6_report_field_type_mismatch(diag, symbols, scopes, node, rhs_field, declared_field_type_str)
                            end
                        end
                    end
                else
                    var dec_field_kind = pass6_resolve_ffi_type(declared_field_type_str)
                    if dec_field_kind == TypeKind.Int and rhs_field.node_type == AstType.LiteralStr do
                        pass6_report_field_type_mismatch(diag, symbols, scopes, node, rhs_field, declared_field_type_str)
                    eif dec_field_kind == TypeKind.String and rhs_field.node_type == AstType.LiteralInt do
                        pass6_report_field_type_mismatch(diag, symbols, scopes, node, rhs_field, declared_field_type_str)
                    eif dec_field_kind != TypeKind.Void and dec_field_kind != TypeKind.None do
                        var rhs_type = pass6_infer_type(symbols, scopes, rhs_field)
                        if rhs_type != TypeKind.Void and pass6_types_compatible(dec_field_kind as i64, rhs_type) == 0 do
                            if not ((dec_field_kind == TypeKind.Int and rhs_type == TypeKind.String) or (dec_field_kind == TypeKind.String and pass6_is_integer_like(rhs_type as i64) == 1)) do
                                pass6_report_field_type_mismatch(diag, symbols, scopes, node, rhs_field, declared_field_type_str)
                            end
                        end
                    end
                end
            end
        end

        if owner_def.node_type == AstType.RegisterDef do
            var field_width = 0
            var rfi = 0
            when rfi < vec_len_rt(owner_def.children) loop
                var rf_def = vec_get_rt(owner_def.children, rfi) as AstNode
                if fat_str_eq(rf_def.name, node.name2) == 1 do
                    field_width = rf_def.builtin_id
                    rfi = vec_len_rt(owner_def.children)
                else
                    rfi = rfi + 1
                end
            end
            if field_width > 0 do
                var reg_rhs = vec_get_rt(node.children, 0) as AstNode
                var (field_known, field_value) = pass6_eval_const_int(symbols, scopes, reg_rhs, 0)
                if field_known == 1 do
                    var field_out_of_range = field_value < 0
                    if field_width < 63 and field_value >= (1 shl field_width) do
                        field_out_of_range = true
                    end
                    if field_out_of_range do report_error(diag, 3079, node.line, 0) end
                end
            end
        end
    end
    out 0
end.

func pass6WalkFieldAccess(ref symbols: SymbolTable, ref scopes: ScopeTree, diag: &DiagnosticEngine, node: &AstNode) -> int:
    child_count = vec_len_rt(node.children)
    if child_count > 0 do
        base_node = vec_get_rt(node.children, 0)
        pass6_walk(symbols, scopes, diag, base_node)
        var is_enum = false
        if base_node.node_type == AstType.Identifier do
            chk_enum = pass6_find_enum_ast(symbols, scopes, base_node.name)
            if (chk_enum as i64) != 0 do
                is_enum = true
                var found_variant = false
                var vi = 0
                when vi < vec_len_rt(chk_enum.children) loop
                    v_child = vec_get_rt(chk_enum.children, vi) as AstNode
                    if fat_str_eq(v_child.name, node.name) == 1 do
                        found_variant = true
                    end
                    vi = vi + 1
                end
                if not found_variant do
                    var f_col = node.int_val
                    if f_col <= 0 do f_col = 1 end
                    report_error_loc(diag, 3033, 0, node.line, f_col, node.name as string)
                end
            end
        end
        if not is_enum do
            var base_ty = pass6_infer_type(symbols, scopes, base_node)
            if base_ty == TypeKind.Pointer do
                report_error(diag, 3001, node.line, 0)
                out 0
            end
            base_ent = pass6_get_receiver_entity_name(symbols, scopes, base_node)
            if fat_str_len(base_ent) > 0 do
                base_raw = pass6_extract_base_name(base_ent)
                if fat_str_len(g_pass6_current_generic_params) > 0 and pass6_is_in_generic_params(g_pass6_current_generic_params, base_raw) do
                    out 0
                end
                ent_ast = pass6_find_entity_ast(symbols, scopes, base_raw)
                if (ent_ast as i64) != 0 do
                    if pass6_entity_has_field(symbols, scopes, base_raw, node.name) == 0 do
                        var f_col2 = node.int_val
                        if f_col2 <= 0 do f_col2 = 1 end
                        report_error_loc(diag, 3008, 0, node.line, f_col2, node.name as string)
                    else
                        var memberIndex = 0
                        when memberIndex < vec_len_rt(ent_ast.children) loop
                            let resolvedField = vec_get_rt(ent_ast.children, memberIndex) as AstNode
                            if resolvedField.node_type == AstType.Identifier do
                                if fat_str_eq(resolvedField.name, node.name) == 1 do
                                    ideFactResolve(node as int, ideFactSymbol(resolvedField as int), scope_current_id(scopes), 2)
                                end
                            end
                            memberIndex = memberIndex + 1
                        end
                    end
                else
                    var f_col2 = node.int_val
                    if f_col2 <= 0 do f_col2 = 1 end
                    report_error_loc(diag, 3008, 0, node.line, f_col2, node.name as string)
                end
            end
        end
    end
    out 0
    out 0
end.

export pass6WalkFieldAssign, pass6WalkFieldAccess
