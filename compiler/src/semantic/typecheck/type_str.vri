##
 * compiler/src/semantic/typecheck/type_str.vri — Receiver Types, Generics & Type Strings
 * ======================================================================================
 * VIRC-PLN-0004 Section 5: Receiver entity resolution, expression type string extraction,
 * generic substitutions, and type mismatch reporting.
 *
 * Implements:
 * - pass6_get_receiver_entity_name: receiver type name resolution
 * - pass6_get_expr_type_str: expression type string extraction
 * - pass6_substitute_generic_type, pass6_check_generic_func_def: generics support
 * - pass6_find_enum_ast, pass6_check_enum_def: enum verification
 * - pass6_report_type_mismatch, pass6_report_return_type_mismatch: diagnostics reporting
 ##

include typecheck_context
include typecheck_compatibility
include typecheck_inference
include typecheck_diagnostics
include typecheck_generics
include typecheck_entities
include typecheck_enums
include typecheck_lookup
include ide_facts

func pass6_count_callable_params(type_str: &string):
    out typecheck_count_callable_params(type_str)
end.

func pass6_callable_param_type(type_str: &string, wanted: int):
    out typecheck_callable_param_type(type_str, wanted)
end.

func pass6_callable_return_type(type_str: &string):
    out typecheck_callable_return_type(type_str)
end.

func pass6_get_receiver_entity_name(ref symbols: SymbolTable, ref scopes: ScopeTree, recv: &AstNode):
    if recv == 0 do out fat_str_new("") end
    nt = recv.node_type
    if nt == AstType.AddrOf and vec_len_rt(recv.children) > 0 do
        out pass6_get_receiver_entity_name(symbols, scopes, vec_get_rt(recv.children, 0) as AstNode)
    end
    if nt == AstType.Identifier do
        if fat_cstr_eq(recv.name, "this") == 1 do
            if g_pass6_current_entity_name != 0 do
                out g_pass6_current_entity_name as string
            end
        end
        sid = pass6_lookup_chain(symbols, scopes, scope_current_id(scopes), recv.name)
        if sid != -1 do
            sym = pass6_symbol_at(symbols, sid)
            if sym.ast_id != 0 do
                decl = sym.ast_id as AstNode
                if decl.node_type == AstType.VarDecl or decl.node_type == AstType.ConstDecl do
                    if fat_str_len(decl.name2) > 0 do
                        out pass6_unwrap_type_name(decl.name2)
                    end
                    if vec_len_rt(decl.children) > 0 do
                        init = vec_get_rt(decl.children, 0)
                        if init.node_type == AstType.EntityLiteral do
                            out init.name
                        end
                        if init.node_type == AstType.Call do
                            ent_chk = pass6_find_entity_ast(symbols, scopes, init.name)
                            if ent_chk != 0 do out init.name end
                            init_ent = pass6_get_receiver_entity_name(symbols, scopes, init)
                            if fat_str_len(init_ent) > 0 do out init_ent end
                        end
                        if init.node_type == AstType.AddrOf and vec_len_rt(init.children) > 0 do
                            init_ent = pass6_get_receiver_entity_name(symbols, scopes, vec_get_rt(init.children, 0) as AstNode)
                            if fat_str_len(init_ent) > 0 do out init_ent end
                        end
                    end
                end
                if decl.node_type == AstType.ParamDef or decl.node_type == AstType.RefParam or decl.node_type == AstType.Identifier do
                    if fat_str_len(decl.name2) > 0 do out pass6_unwrap_type_name(decl.name2) end
                end
            end
        end
        vt = pass6_get_var_type(recv.name)
        if fat_str_len(vt) > 0 do out pass6_unwrap_type_name(vt) end
        ent_chk2 = pass6_find_entity_ast(symbols, scopes, recv.name)
        if ent_chk2 != 0 do out recv.name end
        out fat_str_new("")
    end
    if nt == AstType.EntityLiteral do
        if fat_str_len(recv.name2) > 0 do
            out fat_str_concat(recv.name, fat_str_concat(fat_str_new("<"), fat_str_concat(recv.name2, fat_str_new(">"))))
        end
        out recv.name
    end
    if nt == AstType.BuiltinCall & fat_cstr_eq(recv.name, "port") == 1 do
        out recv.name
    end
    if nt == AstType.Call do
        ent_chk3 = pass6_find_entity_ast(symbols, scopes, recv.name)
        if ent_chk3 != 0 do out recv.name end
        call_ast = pass6_find_free_function(recv.name)
        if call_ast != 0 do
            call_ret = call_ast.name2
            if fat_str_len(call_ret) > 0 do
                let unwrapped_ret = pass6_unwrap_type_name(call_ret)
                call_ret_ent = pass6_find_entity_ast(symbols, scopes, unwrapped_ret)
                if (call_ret_ent as i64) != 0 do out unwrapped_ret end
            else
                let ret_s = pass6_find_return_stmt(call_ast)
                if (ret_s as i64) != 0 do
                    if vec_len_rt(ret_s.children) > 0 do
                        let ret_val = vec_get_rt(ret_s.children, 0) as AstNode
                        if ret_val.node_type == AstType.EntityLiteral do
                            out ret_val.name
                        eif ret_val.node_type == AstType.Identifier do
                            let p_ent = pass6_find_param_entity(call_ast, ret_val.name)
                            if fat_str_len(p_ent) > 0 do out p_ent end
                        end
                    end
                end
            end
        end
        out fat_str_new("")
    end
    if nt == AstType.FieldAccess and vec_len_rt(recv.children) > 0 do
        base_node = vec_get_rt(recv.children, 0)
        if base_node.node_type == AstType.Identifier do
            chk_enum = pass6_find_enum_ast(symbols, scopes, base_node.name)
            if (chk_enum as i64) != 0 do
                out base_node.name
            end
        end
        base_ent = pass6_get_receiver_entity_name(symbols, scopes, base_node)
        if fat_str_len(base_ent) > 0 do
            base_raw = pass6_unwrap_type_name(base_ent)
            base_ast = pass6_find_entity_ast(symbols, scopes, base_raw)
            if base_ast != 0 do
                n_f = vec_len_rt(base_ast.children)
                var fi = 0
                when fi < n_f loop
                    fch = vec_get_rt(base_ast.children, fi)
                    if (fch.node_type == AstType.Identifier or fch.node_type == AstType.VarDecl) and fat_str_eq(fch.name, recv.name) == 1 do
                        out fch.name2
                    end
                    fi = fi + 1
                end
            end
        end
        out fat_str_new("")
    end
    if nt == AstType.MethodCall and vec_len_rt(recv.children) > 0 do
        # A resolved free-function UFCS call carries the free callee in `name`.
        # Preserve an entity return type so the next link in a chain can resolve
        # against that entity's method set (for example: 9.to_box().score()).
        if recv.builtin_id == 203 do
            free_call_ast = 0 as AstNode
            if fat_str_len(recv.name2) > 0 do
                free_call_ast = pass6_find_func_by_canonical_identity(recv.name2)
                if free_call_ast == 0 do
                    free_call_ast = pass6_find_free_function(recv.name2)
                end
            end
            if free_call_ast == 0 do
                free_call_ast = pass6_find_free_function(recv.name)
            end
            if free_call_ast != 0 do
                free_call_ret = free_call_ast.name2
                if fat_str_len(free_call_ret) > 0 do
                    let unwrapped_ret = pass6_unwrap_type_name(free_call_ret)
                    free_call_ret_ent = pass6_find_entity_ast(symbols, scopes, unwrapped_ret)
                    if (free_call_ret_ent as i64) != 0 do out unwrapped_ret end
                end
            end
        end
        m_recv = vec_get_rt(recv.children, 0)
        m_recv_ent = pass6_get_receiver_entity_name(symbols, scopes, m_recv)
        if recv.builtin_id == 202 and fat_str_len(m_recv_ent) > 0 do
            callable_owner = pass6_find_entity_ast(symbols, scopes, m_recv_ent)
            if callable_owner != 0 do
                callable_child_count = vec_len_rt(callable_owner.children)
                var callable_i = 0
                when callable_i < callable_child_count loop
                    callable_field = vec_get_rt(callable_owner.children, callable_i)
                    if (callable_field.node_type == AstType.Identifier or callable_field.node_type == AstType.VarDecl) and fat_str_eq(callable_field.name, recv.name) == 1 do
                        callable_ret = pass6_callable_return_type(callable_field.name2)
                        callable_ret_ent = pass6_find_entity_ast(symbols, scopes, callable_ret)
                        if callable_ret_ent != 0 do out callable_ret_ent.name end
                        callable_i = callable_child_count
                    else
                        callable_i = callable_i + 1
                    end
                end
            end
        end
        if fat_str_len(m_recv_ent) > 0 do
            m_base_ast = pass6_find_entity_ast(symbols, scopes, m_recv_ent)
            if m_base_ast != 0 do
                n_m = vec_len_rt(m_base_ast.children)
                var mi = 0
                when mi < n_m loop
                    mch = vec_get_rt(m_base_ast.children, mi)
                    if mch.node_type == AstType.FuncDef and fat_str_eq(mch.name, recv.name) == 1 do
                        out mch.name2
                    end
                    mi = mi + 1
                end
            end
        end
        out fat_str_new("")
    end
    if nt == AstType.EnumConstruct do
        if fat_str_len(recv.name2) > 0 do out recv.name2 end
    end
    out fat_str_new("")
end.

