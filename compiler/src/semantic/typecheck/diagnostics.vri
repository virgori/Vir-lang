##
 * compiler/src/semantic/typecheck/diagnostics.vri — Typecheck Diagnostic Reporting Rules
 * =======================================================================================
 * VIRC-PLN-0004 Section 5.5 (Phase 7 Part 12): Typecheck Diagnostics Service.
 *
 * Implements structured diagnostic reporting for typechecking:
 * - Return type mismatch diagnostic reporting (Error 3007)
 * - Field assignment type mismatch diagnostic reporting (Error 3007)
 * - General expression type mismatch diagnostic reporting (Error 3007)
 * - Span and line/column location resolution with diagnostic context
 ##

include typecheck_context
include typecheck_index
include typecheck_compatibility

func typecheck_report_return_type_mismatch(diag: &DiagnosticEngine, fn_ctx: &string, expected_type_str: &string, actual_type_str: &string, ret_stmt: &AstNode, ret_expr: &AstNode):
    set_diag_context(fn_ctx, expected_type_str, actual_type_str)
    var span_id = 0
    if (ret_expr as i64) != 0 do
        span_id = ret_expr.span_id
    end
    if span_id <= 0 and (ret_stmt as i64) != 0 do
        span_id = ret_stmt.span_id
    end
    if span_id > 0 do
        report_error_span(diag, 3007, span_id, "")
    else
        var err_line = 0
        if (ret_stmt as i64) != 0 do
            err_line = ret_stmt.line
        end
        if (ret_expr as i64) != 0 and ret_expr.line > 0 do
            err_line = ret_expr.line
        end
        report_error_loc(diag, 3007, 0, err_line, 1, "")
    end
    clear_diag_context()
end.

func typecheck_report_field_type_mismatch(diag: &DiagnosticEngine, fn_ctx: &string, declared_field_type_str: &string, actual_type_str: &string, assign_stmt: &AstNode, rhs_field: &AstNode):
    set_diag_context(fn_ctx, declared_field_type_str, actual_type_str)
    var span_id = 0
    if (rhs_field as i64) != 0 do
        span_id = rhs_field.span_id
    end
    if span_id <= 0 and (assign_stmt as i64) != 0 do
        span_id = assign_stmt.span_id
    end
    if span_id > 0 do
        report_error_span(diag, 3007, span_id, "")
    else
        var err_line = 0
        var err_col = 1
        if (assign_stmt as i64) != 0 do
            err_line = assign_stmt.line
            err_col = assign_stmt.int_val
        end
        if err_col <= 0 do err_col = 1 end
        report_error_loc(diag, 3007, 0, err_line, err_col, "")
    end
    clear_diag_context()
end.

func typecheck_report_type_mismatch(diag: &DiagnosticEngine, fn_ctx: &string, expected_type_str: &string, actual_type_str: &string, target_stmt: &AstNode, expr_node: &AstNode):
    set_diag_context(fn_ctx, expected_type_str, actual_type_str)
    var span_id = 0
    if (expr_node as i64) != 0 do
        span_id = expr_node.span_id
    end
    if span_id <= 0 and (target_stmt as i64) != 0 do
        span_id = target_stmt.span_id
    end
    if span_id > 0 do
        report_error_span(diag, 3007, span_id, "")
    else
        var err_line = 0
        var err_col = 1
        if (expr_node as i64) != 0 and expr_node.line > 0 do
            err_line = expr_node.line
            err_col = expr_node.int_val
        eif (target_stmt as i64) != 0 do
            err_line = target_stmt.line
            err_col = target_stmt.int_val
        end
        if err_col <= 0 do err_col = 1 end
        report_error_loc(diag, 3007, 0, err_line, err_col, "")
    end
    clear_diag_context()
end.

export typecheck_report_return_type_mismatch,
       typecheck_report_field_type_mismatch,
       typecheck_report_type_mismatch
