##
 * compiler/src/semantic/typecheck/context.vri — Typecheck Context
 * ==============================================================
 * VIRC-PLN-0003 Section 5.5: Typecheck Context.
 *
 * Owns Pass 6 state, indexing buckets, caches, and function/entity scope markers.
 * Context replaces loose global variables with an explicit state container.
 ##

include vec_rt
import vec_new_rt, vec_push_rt, vec_get_rt, vec_len_rt, vec_set_rt from vec_rt

include string_rt
import fat_str_new, fat_str_len, fat_str_byte_at, fat_str_eq from string_rt

const TYPECHECK_BUCKETS: int = 256
const TYPECHECK_SCOPE_BUCKETS_COUNT: int = 1024

entity TypecheckContext:
    symbols:                 i64,
    scopes:                  i64,
    diag:                    i64,
    global_buckets:          i64,
    suffix_buckets:          i64,
    scope_buckets:           i64,
    extern_names:            i64,
    extern_nodes:            i64,
    extern_buckets:          i64,
    entity_names:            i64,
    entity_nodes:            i64,
    entity_buckets:          i64,
    enum_buckets:            i64,
    func_names:              i64,
    func_nodes:              i64,
    func_canonical_names:    i64,
    func_buckets:            i64,
    func_canon_buckets:      i64,
    func_canon_by_node:      i64,
    ret_stmt_buckets:        i64,
    visiting_symbols:        i64,
    sym_types:               i64,
    scoped_var_names:        i64,
    scoped_var_types:        i64,
    scope_watermarks:        i64,
    current_entity_name:     i64,
    current_func_name:       i64,
    current_func_ret_type:   i64,
    var_names:               i64,
    var_types:               i64,
    assigned_vars:           i64,
    cur_module:              string,
    current_generic_params:  string,
    fn_ret_cache_keys:       i64,
    fn_ret_cache_vals:       i64,
    visiting_funcs:          i64,
    visiting_local_exprs:    i64,
    ai_mode:                 int,
    infer_values:            i64,
    train_values:            i64
end.

func typecheck_map_new():
    var buckets = vec_new_rt()
    var bi = 0
    when bi < TYPECHECK_BUCKETS loop
        buckets = vec_push_rt(buckets, vec_new_rt())
        bi = bi + 1
    end
    out buckets
end.

func typecheck_scope_map_new():
    var buckets = vec_new_rt()
    var bi = 0
    when bi < TYPECHECK_SCOPE_BUCKETS_COUNT loop
        buckets = vec_push_rt(buckets, vec_new_rt())
        bi = bi + 1
    end
    out buckets
end.

func typecheck_context_new() -> TypecheckContext:
    out TypecheckContext (
        symbols: 0,
        scopes: 0,
        diag: 0,
        global_buckets: typecheck_map_new(),
        suffix_buckets: typecheck_map_new(),
        scope_buckets: typecheck_scope_map_new(),
        extern_names: vec_new_rt(),
        extern_nodes: vec_new_rt(),
        extern_buckets: typecheck_map_new(),
        entity_names: vec_new_rt(),
        entity_nodes: vec_new_rt(),
        entity_buckets: typecheck_map_new(),
        enum_buckets: typecheck_map_new(),
        func_names: vec_new_rt(),
        func_nodes: vec_new_rt(),
        func_canonical_names: vec_new_rt(),
        func_buckets: typecheck_map_new(),
        func_canon_buckets: typecheck_map_new(),
        func_canon_by_node: typecheck_map_new(),
        ret_stmt_buckets: typecheck_map_new(),
        visiting_symbols: vec_new_rt(),
        sym_types: vec_new_rt(),
        scoped_var_names: vec_new_rt(),
        scoped_var_types: vec_new_rt(),
        scope_watermarks: vec_new_rt(),
        current_entity_name: 0,
        current_func_name: 0,
        current_func_ret_type: 0,
        var_names: vec_new_rt(),
        var_types: vec_new_rt(),
        assigned_vars: vec_new_rt(),
        cur_module: fat_str_new(""),
        current_generic_params: fat_str_new(""),
        fn_ret_cache_keys: vec_new_rt(),
        fn_ret_cache_vals: vec_new_rt(),
        visiting_funcs: vec_new_rt(),
        visiting_local_exprs: vec_new_rt(),
        ai_mode: 0,
        infer_values: vec_new_rt(),
        train_values: vec_new_rt()
    )
end.

export TYPECHECK_BUCKETS, TYPECHECK_SCOPE_BUCKETS_COUNT,
       TypecheckContext, typecheck_map_new, typecheck_scope_map_new,
       typecheck_context_new
