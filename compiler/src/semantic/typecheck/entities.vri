##
 * compiler/src/semantic/typecheck/entities.vri — Entity & Packed Definition & Literal Rules
 * =========================================================================================
 * VIRC-PLN-0004 Section 5.5 (Phase 7 Part 8): Entity & Packed Rules Service.
 *
 * Implements type checking and verification for entities, packed structs, and register defs:
 * - Packed struct primitive type validation and register base bit computation
 * - Packed struct recursive definition / cycle detection (Error 3027)
 * - Packed definition field validation (Errors 2004, 3025, 3026, 3028)
 * - Integer field literal range bounds checking for packed types (Error 3030)
 * - Entity and packed field collection and lookup
 ##

include typecheck_context
include typecheck_index
include typecheck_compatibility
include typecheck_methods

func typecheck_is_valid_packed_primitive(name: &string) -> int:
    if fat_cstr_eq(name, "u8") == 1 or fat_cstr_eq(name, "i8") == 1 or fat_cstr_eq(name, "bool") == 1 do out 1 end
    if fat_cstr_eq(name, "u16") == 1 or fat_cstr_eq(name, "i16") == 1 do out 1 end
    if fat_cstr_eq(name, "u32") == 1 or fat_cstr_eq(name, "i32") == 1 do out 1 end
    if fat_cstr_eq(name, "u64") == 1 or fat_cstr_eq(name, "i64") == 1 or fat_cstr_eq(name, "int") == 1 or fat_cstr_eq(name, "uint") == 1 do out 1 end
    if fat_cstr_eq(name, "ptr") == 1 or fat_cstr_eq(name, "float") == 1 or fat_cstr_eq(name, "f32") == 1 or fat_cstr_eq(name, "f64") == 1 do out 1 end
    out 0
end.

func typecheck_register_base_bits(name: &string) -> int:
    if fat_cstr_eq(name, "u8") == 1 or fat_cstr_eq(name, "i8") == 1 do out 8 end
    if fat_cstr_eq(name, "u16") == 1 or fat_cstr_eq(name, "i16") == 1 do out 16 end
    if fat_cstr_eq(name, "u32") == 1 or fat_cstr_eq(name, "i32") == 1 do out 32 end
    if fat_cstr_eq(name, "u64") == 1 or fat_cstr_eq(name, "i64") == 1 or fat_cstr_eq(name, "int") == 1 or fat_cstr_eq(name, "uint") == 1 do out 64 end
    out 0
end.

func typecheck_packed_has_cycle(entity_buckets: i64, current_name: &string, active_stack: i64) -> int:
    var i = 0
    let n = vec_len_rt(active_stack)
    when i < n loop
        let item = vec_get_rt(active_stack, i) as string
        if fat_str_eq(item, current_name) == 1 do
            out 1
        end
        i = i + 1
    end
    let ent = typecheck_find_entity_ast_raw(entity_buckets, current_name)
    if (ent as i64) == 0 do out 0 end
    if ent.node_type != AstType.PackedDef do out 0 end
    let next_stack = vec_push_rt(active_stack, current_name as i64)
    var k = 0
    let nk = vec_len_rt(ent.children)
    when k < nk loop
        let f_k = vec_get_rt(ent.children, k) as AstNode
        if f_k.node_type != AstType.FuncDef do
            let fk_ty = f_k.name2
            if typecheck_is_valid_packed_primitive(fk_ty) == 0 do
                if typecheck_packed_has_cycle(entity_buckets, fk_ty, next_stack) == 1 do
                    out 1
                end
            end
        end
        k = k + 1
    end
    out 0
end.

func typecheck_check_packed_def(entity_buckets: i64, diag: &DiagnosticEngine, node: &AstNode):
    let n_ch = vec_len_rt(node.children)
    var seen_flds = typecheck_map_new()
    var i = 0
    when i < n_ch loop
        let fld = vec_get_rt(node.children, i) as AstNode
        if fld.node_type != AstType.FuncDef do
            if fat_str_len(fld.name2) == 0 do
                report_error(diag, 3025, fld.line, 0)
            else
                let fbid = typecheck_hash_name(fld.name)
                var fbucket = vec_get_rt(seen_flds, fbid)
                let fblen = vec_len_rt(fbucket)
                var has_dup = false
                var fi = 0
                when fi < fblen loop
                    if fat_str_eq(vec_get_rt(fbucket, fi) as string, fld.name) == 1 do
                        has_dup = true
                        fi = fblen
                    else
                        fi = fi + 1
                    end
                end
                if has_dup do
                    report_error(diag, 2004, fld.line, 0)
                else
                    fbucket = vec_push_rt(fbucket, fld.name as i64)
                    vec_set_rt(seen_flds, fbid, fbucket)
                end
                let fty = fld.name2
                if typecheck_is_valid_packed_primitive(fty) == 0 do
                    if fat_cstr_eq(fty, "string") == 1 or fat_cstr_eq(fty, "array") == 1 or fat_cstr_eq(fty, "dict") == 1 or is_tensor_type_str(fty) do
                        report_error(diag, 3026, fld.line, 0)
                    else
                        let target_ast = typecheck_find_entity_ast_raw(entity_buckets, fty)
                        if (target_ast as i64) == 0 do
                            report_error(diag, 3026, fld.line, 0)
                        eif target_ast.node_type == AstType.EntityDef do
                            report_error(diag, 3028, fld.line, 0)
                        eif target_ast.node_type == AstType.PackedDef do
                            var active_s = vec_new_rt()
                            active_s = vec_push_rt(active_s, node.name as i64)
                            if typecheck_packed_has_cycle(entity_buckets, fty, active_s) == 1 do
                                report_error(diag, 3027, fld.line, 0)
                            end
                        end
                    end
                end
            end
        end
        i = i + 1
    end
    out 0
end.

func typecheck_check_int_literal_range(diag: &DiagnosticEngine, ftype: &string, arg: &AstNode):
    var int_val = 0
    var has_int = false
    if arg.node_type == AstType.LiteralInt do
        int_val = arg.int_val
        has_int = true
    eif arg.node_type == AstType.UnaryMinus and vec_len_rt(arg.children) > 0 do
        let child0 = vec_get_rt(arg.children, 0) as AstNode
        if child0.node_type == AstType.LiteralInt do
            int_val = 0 - child0.int_val
            has_int = true
        end
    end
    if has_int do
        if fat_cstr_eq(ftype, "u8") == 1 do
            if int_val < 0 or int_val > 255 do
                report_error(diag, 3030, arg.line, 0)
            end
        eif fat_cstr_eq(ftype, "i8") == 1 do
            if int_val < (0 - 128) or int_val > 127 do
                report_error(diag, 3030, arg.line, 0)
            end
        eif fat_cstr_eq(ftype, "u16") == 1 do
            if int_val < 0 or int_val > 65535 do
                report_error(diag, 3030, arg.line, 0)
            end
        eif fat_cstr_eq(ftype, "i16") == 1 do
            if int_val < (0 - 32768) or int_val > 32767 do
                report_error(diag, 3030, arg.line, 0)
            end
        eif fat_cstr_eq(ftype, "u32") == 1 do
            if int_val < 0 or int_val > 4294967295 do
                report_error(diag, 3030, arg.line, 0)
            end
        eif fat_cstr_eq(ftype, "i32") == 1 do
            if int_val < (0 - 2147483648) or int_val > 2147483647 do
                report_error(diag, 3030, arg.line, 0)
            end
        end
    end
    out 0
end.

export typecheck_is_valid_packed_primitive,
       typecheck_register_base_bits,
       typecheck_packed_has_cycle,
       typecheck_check_packed_def,
       typecheck_check_int_literal_range
