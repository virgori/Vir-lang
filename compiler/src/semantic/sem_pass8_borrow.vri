include ide_facts

##
 * vir/compiler/sem_pass8_borrow.vri
 * ==============================================================
 * Pass 8: Borrow / Ownership / Lifetime Analysis (Pure Vir AST).
 * Implements rigorous CS affine ownership rules & borrow checking:
 *   - Move semantics for non-copy types (Array, String, Entity, Dict, etc.)
 *   - Use-after-move / Double move detection (E5001)
 *   - Re-assignment / Re-initialization reviving moved variables
 *   - Ownership transfer on by-value function call arguments
 *   - Aliasing XOR Mutability exclusivity (& vs &mut) (E5002, E5003, E5006)
 *   - Moving values while borrowed prevention (E5008)
 *   - Borrow of moved value prevention (E5004)
 *   - Function-local reference escape detection (E5007)
 *   - Region / Arena-allocated lifetime escape detection (E5005)
 ##

include borrow_context
include borrow_binding
include borrow_paths
include borrow_moves
include borrow_loans
include borrow_state


func pass8_collect_funcs(node: &AstNode, func_map: int):
    if (node as i64) == 0 do out 0 end
    let nt = pass8_ast_type(node)
    if nt == AstType.FuncDef do
        let fname = pass8_ast_name(node)
        if pass8_strlen(fname) > 0 do
            let item = var_item_new(fname, node as int)
            pass8_map_index(func_map, fname, item as int)
        end
    end
    let ch_vec = pass8_ast_children(node)
    if ch_vec != 0 do
        let count = vec_len_rt(ch_vec)
        var i = 0
        when i < count loop
            let ch = vec_get_rt(ch_vec, i)
            if nt != AstType.FuncDef do
                pass8_collect_funcs(ch, func_map)
            end
            i = i + 1
        end
    end
    out 0
end.

func pass8_find_func(fname: string):
    if g_pass8_func_map == 0 or pass8_strlen(fname) == 0 do
        out 0 as AstNode
    end
    let item = pass8_map_find(g_pass8_func_map, fname)
    if item != 0 do
        out var_item_val(item) as AstNode
    end
    out 0 as AstNode
end.

func pass8_get_param(fn_node: &AstNode, param_idx: int):
    if (fn_node as i64) == 0 or param_idx < 0 do
        out 0 as AstNode
    end
    let ch_vec = pass8_ast_children(fn_node)
    if ch_vec == 0 do
        out 0 as AstNode
    end
    let count = vec_len_rt(ch_vec)
    var cur_idx = 0
    var i = 0
    when i < count loop
        let ch = vec_get_rt(ch_vec, i)
        let t = pass8_ast_type(ch)
        if t == AstType.ParamDef or t == AstType.RefParam or t == AstType.OutParam do
            if cur_idx == param_idx do
                out ch
            end
            cur_idx = cur_idx + 1
        eif t == AstType.Identifier do
            if cur_idx == param_idx do
                out ch
            end
            cur_idx = cur_idx + 1
        eif t == AstType.Block do
            out 0 as AstNode
        end
        i = i + 1
    end
    out 0 as AstNode
end.

func pass8_analyze_borrow(ref symbols: SymbolTable, ref scopes: ScopeTree, diag: &DiagnosticEngine, node: &AstNode):
    g_pass8_func_map = pass8_map_new()
    g_pass8_shadow_frames = pass8_box_new()
    g_pass8_scope_depth = 0
    g_pass8_var_scopes = pass8_box_new()
    g_pass8_var_decl_lines = pass8_box_new()
    g_pass8_reported_diags = pass8_box_new()
    g_pass8_bindings = pass8_box_new()
    g_pass8_scope_stack = pass8_box_new()
    g_pass8_scope_ids = pass8_box_new()
    g_pass8_loop_flows = pass8_box_new()
    g_pass8_flow_kind = 0
    pass8_box_push(g_pass8_scope_stack, var_item_new(fat_str_new("scope"), 0) as i64)
    g_pass8_next_binding_id = 1
    g_pass8_next_scope_id = 1
    pass8_collect_funcs(node, g_pass8_func_map)
    let moved_vars = pass8_box_new()
    let shared_borrows = pass8_box_new()
    let mut_borrows = pass8_box_new()
    let bound_borrows = pass8_box_new()
    let arena_locals = pass8_box_new()
    let pre_arena_names = pass8_box_new()
    let var_types = pass8_box_new()
    let func_locals = pass8_box_new()
    let uninit_vars = pass8_box_new()
    if ide_enabled() == 1 do
        ide_pass8_bind(symbols, scopes)
    end
    pass8_walk(symbols, scopes, diag, node, moved_vars, shared_borrows, mut_borrows,
               bound_borrows, arena_locals, pre_arena_names, 0, var_types, func_locals, uninit_vars)
end.


func pass8_report_error_related(diag: &DiagnosticEngine, code: int, line: int, col: int, extra: int, sec_line: int, sec_col: int, sec_note: int):
    if g_pass8_reported_diags == 0 do
        g_pass8_reported_diags = pass8_box_new()
    end
    let key = extra
    let key_hash = code * 100000 + line
    let n = pass8_box_len(g_pass8_reported_diags)
    var i = 0
    when i < n loop
        let it = pass8_box_get(g_pass8_reported_diags, i)
        if (var_item_val(it) == key_hash and pass8_streq(var_item_name(it), key) == 1) or (code == 5012 and var_item_val(it) / 100000 == 5012 and pass8_streq(var_item_name(it), key) == 1) do
            out 0
        end
        i = i + 1
    end
    let rec_item = var_item_new(key, key_hash)
    pass8_box_push(g_pass8_reported_diags, rec_item as i64)
    report_error_related(diag, code, line, col, extra as string, sec_line, sec_col, sec_note as string)
    out 0
end.

func pass8_report_error(diag: &DiagnosticEngine, code: int, line: int, col: int):
    if g_pass8_reported_diags == 0 do
        g_pass8_reported_diags = pass8_box_new()
    end
    let key = fat_str_new("")
    let key_hash = code * 100000 + line
    let n = pass8_box_len(g_pass8_reported_diags)
    var i = 0
    when i < n loop
        let it = pass8_box_get(g_pass8_reported_diags, i)
        if var_item_val(it) == key_hash do
            out 0
        end
        i = i + 1
    end
    let rec_item = var_item_new(key, key_hash)
    pass8_box_push(g_pass8_reported_diags, rec_item as i64)
    report_error(diag, code, line, col)
    out 0
end.


# Loop edge accumulator. Slots 0..4 are break states, 5..9 are skip/back-edge
# states. Each component is a boxed finite-lattice set.
func pass8_loop_flow_new():
    let flow = vir_alloc(80)
    var flow_slot = 0
    when flow_slot < 10 loop
        native_write_i64(flow, flow_slot * 8, pass8_box_new() as i64)
        flow_slot = flow_slot + 1
    end
    out flow
end.

func pass8_loop_flow_box(flow: int, slot: int):
    if flow == 0 or slot < 0 or slot >= 10 do out 0 end
    out native_read_i64(flow, slot * 8)
end.

func pass8_current_loop_flow():
    if g_pass8_loop_flows == 0 or pass8_box_len(g_pass8_loop_flows) == 0 do out 0 end
    out pass8_box_get(g_pass8_loop_flows, pass8_box_len(g_pass8_loop_flows) - 1)
end.

func pass8_capture_loop_edge(kind: int, moved_vars: int, shared_borrows: int, mut_borrows: int,
                             bound_borrows: int, uninit_vars: int):
    let edge_flow = pass8_current_loop_flow()
    if edge_flow == 0 do out 0 end
    var edge_base = 0
    if kind == 2 do edge_base = 5 end
    pass8_merge_moved_box(pass8_loop_flow_box(edge_flow, edge_base), moved_vars)
    pass8_merge_borrows_box(pass8_loop_flow_box(edge_flow, edge_base + 1), shared_borrows)
    pass8_merge_borrows_box(pass8_loop_flow_box(edge_flow, edge_base + 2), mut_borrows)
    pass8_merge_bound_box(pass8_loop_flow_box(edge_flow, edge_base + 3), bound_borrows)
    pass8_merge_moved_box(pass8_loop_flow_box(edge_flow, edge_base + 4), uninit_vars)
    out 0
end.

func pass8_merge_loop_edge(flow: int, base: int, moved_vars: int, shared_borrows: int,
                           mut_borrows: int, bound_borrows: int, uninit_vars: int):
    if flow == 0 do out 0 end
    pass8_merge_moved_box(moved_vars, pass8_loop_flow_box(flow, base))
    pass8_merge_borrows_box(shared_borrows, pass8_loop_flow_box(flow, base + 1))
    pass8_merge_borrows_box(mut_borrows, pass8_loop_flow_box(flow, base + 2))
    pass8_merge_bound_box(bound_borrows, pass8_loop_flow_box(flow, base + 3))
    pass8_merge_moved_box(uninit_vars, pass8_loop_flow_box(flow, base + 4))
    out 0
end.


func pass8_register_var_scope(name: int, depth: int, line: int):
    if pass8_strlen(name) == 0 do out 0 end
    if g_pass8_var_scopes == 0 do
        g_pass8_var_scopes = pass8_box_new()
    end
    if g_pass8_var_decl_lines == 0 do
        g_pass8_var_decl_lines = pass8_box_new()
    end
    let scope_id = pass8_current_scope_id()
    var binding_key = fat_str_new("")
    if g_pass8_bindings != 0 do
        var bi = pass8_box_len(g_pass8_bindings) - 1
        when bi >= 0 loop
            let existing_binding = pass8_box_get(g_pass8_bindings, bi)
            if pass8_binding_scope(existing_binding) == scope_id and pass8_streq(pass8_binding_name(existing_binding), name) == 1 do
                binding_key = pass8_binding_key(existing_binding) as string
                bi = -1
            else
                bi = bi - 1
            end
        end
    end
    if pass8_strlen(binding_key) == 0 do
        binding_key = fat_str_concat(fat_str_concat(name as string, fat_str_new("#")), str_from_cstr(rt_itoa(g_pass8_next_binding_id)))
        g_pass8_next_binding_id = g_pass8_next_binding_id + 1
        pass8_box_push(g_pass8_bindings, pass8_binding_new(name, binding_key as int, scope_id, depth, line) as i64)
    end
    let existing_sc = pass8_box_find(g_pass8_var_scopes, binding_key)
    if existing_sc != 0 do
        var_item_set_val(existing_sc, depth)
    else
        let sc_item = var_item_new(binding_key, depth)
        pass8_box_push(g_pass8_var_scopes, sc_item as i64)
    end
    let existing_ln = pass8_box_find(g_pass8_var_decl_lines, binding_key)
    if existing_ln != 0 do
        var_item_set_val(existing_ln, line)
    else
        let ln_item = var_item_new(binding_key, line)
        pass8_box_push(g_pass8_var_decl_lines, ln_item as i64)
    end
    out 0
end.

func pass8_get_var_scope_depth(name: int) -> int:
    if g_pass8_var_scopes == 0 or pass8_strlen(name) == 0 do out 0 end
    let it = pass8_box_find(g_pass8_var_scopes, pass8_state_path(name))
    if it == 0 do out 0 end
    out var_item_val(it)
end.

func pass8_get_var_decl_line(name: int) -> int:
    if g_pass8_var_decl_lines == 0 or pass8_strlen(name) == 0 do out 0 end
    let it = pass8_box_find(g_pass8_var_decl_lines, pass8_state_path(name))
    if it == 0 do out 0 end
    out var_item_val(it)
end.

func pass8_filter_out_scope_borrows(bound_borrows: int, depth: int):
    if bound_borrows == 0 do out 0 end
    var changed = 1
    when changed == 1 loop
        changed = 0
        let len = pass8_box_len(bound_borrows)
        var i = 0
        when i < len loop
            let b = pass8_box_get(bound_borrows, i)
            let b_lhs = borrow_binding_lhs(b)
            if pass8_get_var_scope_depth(b_lhs) >= depth do
                if i < len - 1 do
                    pass8_box_set(bound_borrows, i, pass8_box_get(bound_borrows, len - 1))
                end
                let v = native_read_i64(bound_borrows, 0)
                vec_pop_rt(v)
                changed = 1
                i = len
            else
                i = i + 1
            end
        end
    end
    out 0
end.

func pass8_register_var_type(var_types: int, name: int, kind: TypeKind):
    let key = pass8_state_path(name)
    if pass8_strlen(key) == 0 do
        out 0
    end
    let item = pass8_box_find(var_types, key)
    if item != 0 do
        var_item_set_val(item, kind as int)
        out 0
    end
    let type_item = var_item_new(key, kind as int)
    pass8_box_push(var_types, type_item as i64)
    out 0
end.

func pass8_get_var_type(var_types: int, name: int):
    let key = pass8_state_path(name)
    if pass8_strlen(key) == 0 do
        out TypeKind.Void
    end
    let item = pass8_box_find(var_types, key)
    if item != 0 do
        out var_item_val(item) as TypeKind
    end
    out TypeKind.Void
end.

func pass8_infer_expr_type(var_types: int, expr: &AstNode):
    if (expr as i64) == 0 do
        out TypeKind.Void
    end
    let t = pass8_ast_type(expr)
    if t == AstType.ArrayLiteral do
        out TypeKind.Array
    end
    if t == AstType.DictLiteral do
        out TypeKind.Dict
    end
    if t == AstType.LiteralStr or t == AstType.InterpExpr do
        out TypeKind.String
    end
    if t == AstType.EntityLiteral do
        out TypeKind.Entity
    end
    if t == AstType.LiteralInt do
        out TypeKind.Int
    end
    if t == AstType.LiteralFloat do
        out TypeKind.Float
    end
    if t == AstType.LiteralBool do
        out TypeKind.Bool
    end
    if t == AstType.LiteralNone do
        out TypeKind.None
    end
    if t == AstType.Identifier do
        out pass8_get_var_type(var_types, pass8_ast_name(expr))
    end
    if t == AstType.AddrOf do
        if pass8_cstr_eq(pass8_ast_name(expr), "mut") == 1 do
            out TypeKind.MutRef
        else
            out TypeKind.Ref
        end
    end
    out TypeKind.Void
end.

func pass8_expr_has_arena_local(expr: &AstNode, arena_locals: int, in_arena: int):
    if (expr as i64) == 0 do
        out 0
    end
    if pass8_ast_type(expr) == AstType.Identifier do
        if pass8_vec_contains(arena_locals, pass8_state_path(pass8_ast_name(expr))) == 1 do
            out 1
        end
        out 0
    end
    let child_count = vec_len_rt(pass8_ast_children(expr))
    var i = 0
    when i < child_count loop
        let child = vec_get_rt(pass8_ast_children(expr), i)
        if pass8_expr_has_arena_local(child, arena_locals, in_arena) == 1 do
            out 1
        end
        i = i + 1
    end
    out 0
end.

func pass8_check_arena_escape_assign(diag: &DiagnosticEngine, lhs: string, rhs: &AstNode,
                                     arena_locals: int, pre_arena_names: int, in_arena: int, line: int):
    # Owned values may escape by being moved or assigned to a longer-lived owner (Spec §4.5–§4.8.5).
    # Borrow escapes are strictly rejected with E5005.
    let lhs_key = pass8_state_path(lhs)
    if in_arena == 1 and pass8_vec_contains(pre_arena_names, lhs_key) == 1 do
        if (rhs as i64) != 0 do
            var rhs_esc = rhs
            when (rhs_esc as i64) != 0 and pass8_ast_type(rhs_esc) == AstType.CastExpr and vec_len_rt(pass8_ast_children(rhs_esc)) > 0 loop
                rhs_esc = vec_get_rt(pass8_ast_children(rhs_esc), 0) as AstNode
            end
            let rt = pass8_ast_type(rhs_esc)
            if rt == AstType.AddrOf do
                let tgt = pass8_get_addr_target(rhs_esc)
                if pass8_strlen(tgt) > 0 and pass8_vec_contains(arena_locals, tgt) == 1 do
                    pass8_report_error(diag, 5005, line, 0)
                    out 1
                end
            end
            if pass8_expr_has_arena_local(rhs_esc, arena_locals, in_arena) == 1 and rt == AstType.AddrOf do
                pass8_report_error(diag, 5005, line, 0)
                out 1
            end
        end
    end
    out 0
end.

func pass8_register_arena_local(arena_locals: int, pre_arena_names: int, name: string, in_arena: int):
    if pass8_strlen(name) == 0 do
        out 0
    end
    let key = pass8_state_path(name)
    if in_arena == 0 do
        if pass8_vec_contains(pre_arena_names, key) == 0 do
            let pre_item = var_item_new(key, 0)
            pass8_box_push(pre_arena_names, pre_item as i64)
        end
        out 0
    end
    if pass8_vec_contains(pre_arena_names, key) == 1 do
        out 0
    end
    if pass8_vec_contains(arena_locals, key) == 0 do
        let arena_item = var_item_new(key, 0)
        pass8_box_push(arena_locals, arena_item as i64)
    end
    out 0
end.

func pass8_check_arena_borrow_escape(diag: &DiagnosticEngine, arena_locals: int, pre_arena_names: int,
                                     bound_borrows: int, line: int):
    let count = pass8_box_len(bound_borrows)
    var i = 0
    when i < count loop
        let b = pass8_box_get(bound_borrows, i)
        let tgt = borrow_binding_target(b)
        let lhs = borrow_binding_lhs(b)
        if pass8_vec_contains(arena_locals, tgt) == 1 do
            if pass8_vec_contains(pre_arena_names, lhs) == 1 do
                pass8_report_error(diag, 5005, line, 0)
            end
        end
        i = i + 1
    end
    out 0
end.

func pass8_end_stmt(shared_borrows: int, mut_borrows: int, shared_wm: int, mut_wm: int, claimed: int):
    if claimed == 0 do
        pass8_truncate_to(shared_borrows, shared_wm)
        pass8_truncate_to(mut_borrows, mut_wm)
    end
    out 0
end.



func pass8_handle_addr_of(ref symbols: SymbolTable, ref scopes: ScopeTree, diag: &DiagnosticEngine,
                          node: i64, moved_vars: int, shared_borrows: int, mut_borrows: int,
                          bound_borrows: int, arena_locals: int, pre_arena_names: int, in_arena: int,
                          var_types: int, func_locals: int, uninit_vars: int):
    let child_count = vec_len_rt(pass8_ast_children(node))
    if child_count < 1 do
        out fat_str_new("")
    end
    let child = vec_get_rt(pass8_ast_children(node), 0)
    if pass8_ast_type(child) != AstType.Identifier do
        pass8_walk(symbols, scopes, diag, child, moved_vars, shared_borrows, mut_borrows,
                   bound_borrows, arena_locals, pre_arena_names, in_arena, var_types, func_locals, uninit_vars)
    end
    let tgt = pass8_owner_path(child)
    if pass8_strlen(tgt) == 0 do
        # References require a stable place. Borrowing an entity/array/call
        # rvalue would create a reference to a temporary with no lexical owner.
        pass8_report_error(diag, 5007, pass8_ast_line(node), 0)
        out fat_str_new("")
    end
    let root_tgt = pass8_root_owner(tgt)
    if pass8_is_uninit(uninit_vars, root_tgt) == 1 do
        let decl_line = pass8_get_var_decl_line(root_tgt)
        pass8_report_error_related(diag, 5013, pass8_ast_line(node), 0, root_tgt,
                                   decl_line, 0, "Variable declared here")
        out fat_str_new("")
    end
    if pass8_is_moved(moved_vars, tgt) == 1 or pass8_is_moved(moved_vars, root_tgt) == 1 do
        var mv_line = pass8_moved_line(moved_vars, tgt)
        if mv_line == 0 do mv_line = pass8_moved_line(moved_vars, root_tgt) end
        pass8_report_error_related(diag, 5004, pass8_ast_line(node), 0, tgt,
                                   mv_line, 0, "Value was moved here")
        out fat_str_new("")
    end
    var is_mut = 0
    if pass8_cstr_eq(pass8_ast_name(node), "mut") == 1 do
        is_mut = 1
    end
    if is_mut == 1 do
        let shared_line = pass8_conflicting_borrow_line(shared_borrows, tgt)
        if shared_line > 0 do
            pass8_report_error_related(diag, 5002, pass8_ast_line(node), 0, tgt,
                                       shared_line, 0, "Shared borrow started here")
        end
        let mut_line = pass8_conflicting_borrow_line(mut_borrows, tgt)
        if mut_line > 0 do
            pass8_report_error_related(diag, 5003, pass8_ast_line(node), 0, tgt,
                                       mut_line, 0, "Mutable borrow started here")
        end
        if pass8_borrow_count(mut_borrows, tgt) == 0 do
            let mut_item = var_item_new(tgt, pass8_ast_line(node))
            pass8_box_push(mut_borrows, mut_item as i64)
        end
    else
        let mut_line = pass8_conflicting_borrow_line(mut_borrows, tgt)
        if mut_line > 0 do
            pass8_report_error_related(diag, 5006, pass8_ast_line(node), 0, tgt,
                                       mut_line, 0, "Mutable borrow started here")
        end
        if pass8_borrow_count(shared_borrows, tgt) == 0 do
            let shared_item = var_item_new(tgt, pass8_ast_line(node))
            pass8_box_push(shared_borrows, shared_item as i64)
        end
    end
    if is_mut == 1 do ideFactLoan(child, 2)
    else ideFactLoan(child, 1) end
    out tgt
end.

func pass8_process_binding_rhs(ref symbols: SymbolTable, ref scopes: ScopeTree, diag: &DiagnosticEngine,
                               rhs: AstNode, moved_vars: int, shared_borrows: int, mut_borrows: int,
                               bound_borrows: int, lhs: int, arena_locals: int, pre_arena_names: int, in_arena: int,
                               var_types: int, func_locals: int, uninit_vars: int):
    var claimed = 0
    var borrow_tgt = fat_str_new("")
    var borrow_kind = 0

    if pass8_ast_type(rhs) == AstType.AddrOf do
        borrow_tgt = pass8_handle_addr_of(symbols, scopes, diag, rhs, moved_vars,
                                          shared_borrows, mut_borrows, bound_borrows,
                                          arena_locals, pre_arena_names, in_arena, var_types, func_locals, uninit_vars)
        if pass8_strlen(borrow_tgt) > 0 do
            let root_tgt = pass8_root_owner(borrow_tgt)
            let tgt_depth = pass8_get_var_scope_depth(root_tgt)
            let lhs_depth = pass8_get_var_scope_depth(lhs)
            if tgt_depth > lhs_depth and lhs_depth > 0 and tgt_depth > 0 do
                let decl_line = pass8_get_var_decl_line(root_tgt)
                pass8_report_error_related(diag, 5012, pass8_ast_line(rhs), 0, lhs,
                                           decl_line, 0, "Owner declared here")
            end
            if pass8_cstr_eq(pass8_ast_name(rhs), "mut") == 1 do
                borrow_kind = 2
            else
                borrow_kind = 1
            end
            pass8_claim_borrow(bound_borrows, lhs, borrow_tgt, borrow_kind)
            claimed = 1
        end
    else
        pass8_walk(symbols, scopes, diag, rhs, moved_vars, shared_borrows, mut_borrows,
                   bound_borrows, arena_locals, pre_arena_names, in_arena, var_types, func_locals, uninit_vars)
        if pass8_ast_type(rhs) == AstType.Identifier do
            let rhs_name = pass8_ast_name(rhs)
            if pass8_is_uninit(uninit_vars, rhs_name) == 1 do
                let decl_line = pass8_get_var_decl_line(rhs_name)
                pass8_report_error_related(diag, 5013, pass8_ast_line(rhs), 0, rhs_name,
                                           decl_line, 0, "Variable declared here")
            eif pass8_is_moved(moved_vars, rhs_name) == 1 do
                pass8_report_error_related(diag, 5001, pass8_ast_line(rhs), 0, rhs_name,
                                           pass8_moved_line(moved_vars, rhs_name), 0, "Value was moved here")
            else
                let root_alias = pass8_resolve_borrow_root(bound_borrows, rhs_name)
                if pass8_streq(root_alias, pass8_state_path(rhs_name)) == 0 do
                    let tgt_depth = pass8_get_var_scope_depth(root_alias)
                    let lhs_depth = pass8_get_var_scope_depth(lhs)
                    if tgt_depth > lhs_depth and lhs_depth > 0 and tgt_depth > 0 do
                        let decl_line = pass8_get_var_decl_line(root_alias)
                        pass8_report_error_related(diag, 5012, pass8_ast_line(rhs), 0, lhs,
                                                   decl_line, 0, "Owner declared here")
                    end
                    pass8_claim_borrow(bound_borrows, lhs, root_alias, 1)
                    claimed = 1
                else
                    if pass8_borrow_count(shared_borrows, rhs_name) > 0 or pass8_borrow_count(mut_borrows, rhs_name) > 0 do
                        var borrow_line = pass8_borrow_line(shared_borrows, rhs_name)
                        if borrow_line == 0 do borrow_line = pass8_borrow_line(mut_borrows, rhs_name) end
                        pass8_report_error_related(diag, 5008, pass8_ast_line(rhs), 0, rhs_name,
                                                   borrow_line, 0, "Borrow started here")
                    end
                    let rhs_type = pass8_get_var_type(var_types, rhs_name)
                    if type_is_move(rhs_type) do
                        pass8_mark_moved_at(moved_vars, rhs_name, pass8_ast_line(rhs))
                    end
                end
            end
        end
    end
    out claimed
end.

func pass8_tree_uses_ident(node: &AstNode, name: int) -> int:
    if (node as i64) == 0 do out 0 end
    if pass8_ast_type(node) == AstType.Identifier do
        if pass8_streq(pass8_ast_name(node), name) == 1 do
            out 1
        end
    end
    let ch_vec = pass8_ast_children(node)
    if ch_vec != 0 do
        let count = vec_len_rt(ch_vec)
        var i = 0
        when i < count loop
            let ch = vec_get_rt(ch_vec, i)
            if pass8_tree_uses_ident(ch, name) == 1 do
                out 1
            end
            i = i + 1
        end
    end
    out 0
end.

func pass8_has_await(node: &AstNode) -> int:
    if (node as i64) == 0 do out 0 end
    if pass8_ast_type(node) == AstType.AwaitExpr do out 1 end
    let ch_vec = pass8_ast_children(node)
    if ch_vec != 0 do
        let count = vec_len_rt(ch_vec)
        var i = 0
        when i < count loop
            if pass8_has_await(vec_get_rt(ch_vec, i)) == 1 do out 1 end
            i = i + 1
        end
    end
    out 0
end.

func pass8_branch_terminates(node: &AstNode) -> int:
    if (node as i64) == 0 do out 0 end
    let nt = pass8_ast_type(node)
    if nt == AstType.ReturnStmt or nt == AstType.ThrowStmt or nt == AstType.BreakStmt or nt == AstType.ContinueStmt do
        out 1
    end
    if nt == AstType.Block do
        let ch_vec = pass8_ast_children(node)
        if ch_vec != 0 do
            let count = vec_len_rt(ch_vec)
            var i = 0
            when i < count loop
                let ch = vec_get_rt(ch_vec, i)
                if pass8_branch_terminates(ch) == 1 do
                    out 1
                end
                i = i + 1
            end
        end
    end
    if nt == AstType.IfStmt do
        let ch_vec = pass8_ast_children(node)
        if ch_vec != 0 do
            let count = vec_len_rt(ch_vec)
            if count > 2 do
                let then_ch = vec_get_rt(ch_vec, 1)
                let else_ch = vec_get_rt(ch_vec, 2)
                if pass8_branch_terminates(then_ch) == 1 and pass8_branch_terminates(else_ch) == 1 do
                    out 1
                end
            end
        end
    end
    out 0
end.

func pass8_loop_body_terminates(node: &AstNode) -> int:
    if (node as i64) == 0 do out 0 end
    let nt = pass8_ast_type(node)
    if nt == AstType.ReturnStmt or nt == AstType.ThrowStmt or nt == AstType.BreakStmt do
        out 1
    end
    if nt == AstType.Block do
        let ch_vec = pass8_ast_children(node)
        if ch_vec != 0 do
            let count = vec_len_rt(ch_vec)
            var i = 0
            when i < count loop
                let ch = vec_get_rt(ch_vec, i)
                if pass8_loop_body_terminates(ch) == 1 do
                    out 1
                end
                i = i + 1
            end
        end
    end
    if nt == AstType.IfStmt do
        let ch_vec = pass8_ast_children(node)
        if ch_vec != 0 do
            let count = vec_len_rt(ch_vec)
            if count > 2 do
                let then_ch = vec_get_rt(ch_vec, 1)
                let else_ch = vec_get_rt(ch_vec, 2)
                if pass8_loop_body_terminates(then_ch) == 1 and pass8_loop_body_terminates(else_ch) == 1 do
                    out 1
                end
            end
        end
    end
    out 0
end.


func pass8_walk_children_stmts(ref symbols: SymbolTable, ref scopes: ScopeTree, diag: &DiagnosticEngine,
                               node: AstNode, moved_vars: int, shared_borrows: int, mut_borrows: int,
                               bound_borrows: int, arena_locals: int, pre_arena_names: int, in_arena: int,
                               var_types: int, func_locals: int, uninit_vars: int):
    let child_count = vec_len_rt(pass8_ast_children(node))
    var i = 0
    var claimed_any = 0
    when i < child_count and g_pass8_flow_kind == 0 loop
        let shared_wm = pass8_box_len(shared_borrows)
        let mut_wm = pass8_box_len(mut_borrows)
        let child = vec_get_rt(pass8_ast_children(node), i)


        # Liveness-aware borrow across await check (MEM-BOR-015):
        if pass8_has_await(child) == 1 do
            bi = 0
            b_len = pass8_box_len(bound_borrows)
            when bi < b_len loop
                let b_item = pass8_box_get(bound_borrows, bi)
                let b_name = pass8_source_name_for_path(borrow_binding_lhs(b_item))
                var used_future = 0
                var j = i
                when j < child_count loop
                    if pass8_tree_uses_ident(vec_get_rt(pass8_ast_children(node), j), b_name) == 1 do
                        used_future = 1
                        j = child_count
                    else
                        j = j + 1
                    end
                end
                if used_future == 1 do
                    pass8_report_error(diag, 5011, pass8_ast_line(child), 0)
                end
                bi = bi + 1
            end
        end

        let claimed = pass8_walk(symbols, scopes, diag, child, moved_vars, shared_borrows, mut_borrows,
                                 bound_borrows, arena_locals, pre_arena_names, in_arena, var_types, func_locals, uninit_vars)
        if claimed == 1 do
            claimed_any = 1
        end
        pass8_end_stmt(shared_borrows, mut_borrows, shared_wm, mut_wm, claimed)
        # End a named borrow at its last use in this lexical block. Borrowers
        # declared by an outer block are retained because their future uses are
        # owned by that outer statement list.
        var nll_again = 1
        when nll_again == 1 loop
            nll_again = 0
            let nll_count = pass8_box_len(bound_borrows)
            var nll_idx = 0
            when nll_idx < nll_count loop
                let nll_binding = pass8_box_get(bound_borrows, nll_idx)
                let nll_lhs = borrow_binding_lhs(nll_binding)
                if pass8_get_var_scope_depth(nll_lhs) >= g_pass8_scope_depth do
                    let nll_name = pass8_source_name_for_path(nll_lhs)
                    var nll_used_later = 0
                    var nll_future = i + 1
                    when nll_future < child_count loop
                        if pass8_tree_uses_ident(vec_get_rt(pass8_ast_children(node), nll_future), nll_name) == 1 do
                            nll_used_later = 1
                            nll_future = child_count
                        else
                            nll_future = nll_future + 1
                        end
                    end
                    if nll_used_later == 0 do
                        let nll_released = pass8_release_borrower(bound_borrows, shared_borrows, mut_borrows, nll_lhs)
                        if nll_released > 0 do
                            ideFactBorrowEnd(nll_lhs, child as int)
                            nll_again = 1
                            nll_idx = nll_count
                        else
                            nll_idx = nll_idx + 1
                        end
                    else
                        nll_idx = nll_idx + 1
                    end
                else
                    nll_idx = nll_idx + 1
                end
            end
        end
        i = i + 1
    end
    out claimed_any
end.

func pass8_walk(ref symbols: SymbolTable, ref scopes: ScopeTree, diag: &DiagnosticEngine, node: &AstNode,
                moved_vars: int, shared_borrows: int, mut_borrows: int,
                bound_borrows: int, arena_locals: int, pre_arena_names: int, in_arena: int,
                var_types: int, func_locals: int, uninit_vars: int):
    if (node as i64) == 0 do
        out 0
    end

    let nt = pass8_ast_type(node)

    if nt == AstType.BreakStmt do
        pass8_capture_loop_edge(1, moved_vars, shared_borrows, mut_borrows, bound_borrows, uninit_vars)
        g_pass8_flow_kind = 1
        out 0
    end

    if nt == AstType.ContinueStmt do
        pass8_capture_loop_edge(2, moved_vars, shared_borrows, mut_borrows, bound_borrows, uninit_vars)
        g_pass8_flow_kind = 2
        out 0
    end

    if nt == AstType.ExportStmt or nt == AstType.ImportStmt or nt == AstType.ModuleStmt or nt == AstType.IncludeStmt or nt == AstType.EntityDef or nt == AstType.PackedDef or nt == AstType.RegisterDef or nt == AstType.EnumDef or nt == AstType.ExternFunc do
        out 0
    end

    # 1. Identifier — check use of uninitialized or moved value
    if nt == AstType.Identifier do
        if pass8_strlen(pass8_ast_name(node)) > 0 do
            let id_name = pass8_ast_name(node)
            pass8CaptureIdeLoan(node as int, id_name, bound_borrows, shared_borrows, mut_borrows)
            if g_ideFactsEnabled == 1 do ideFactBinding(node as int, pass8_state_path(id_name) as int) end
            if pass8_is_uninit(uninit_vars, id_name) == 1 do
                let decl_line = pass8_get_var_decl_line(id_name)
                pass8_report_error_related(diag, 5013, pass8_ast_line(node), 0, id_name,
                                           decl_line, 0, "Variable declared here")
                ide_note_var(id_name as int, pass8_ast_line(node), 0, IDE_STATE_INVALID)
                ideFactState(node as int, IDE_STATE_INVALID)
            eif pass8_is_moved(moved_vars, id_name) == 1 do
                pass8_report_error_related(diag, 5001, pass8_ast_line(node), 0, id_name,
                                           pass8_moved_line(moved_vars, id_name), 0, "Value was moved here")
                ide_note_var(id_name as int, pass8_ast_line(node), 0, IDE_STATE_MOVED)
                ideFactResourceOrigins(node as int, pass8_moved_line(moved_vars, id_name), 0, pass8_state_path(id_name))
                ideFactState(node as int, IDE_STATE_MOVED)
            else
                ide_note_var(id_name as int, pass8_ast_line(node), 0, IDE_STATE_ALIVE)
                ideFactState(node as int, IDE_STATE_ALIVE)
            end
        end
    end

    # 1b. IndexAccess — check use of uninitialized or moved base container
    if pass8_ast_type(node) == AstType.IndexAccess do
        let base_name = pass8_ast_name(node)
        if pass8_strlen(base_name) > 0 do
            if g_ideFactsEnabled == 1 do ideFactBinding(node as int, pass8_state_path(base_name) as int) end
            if pass8_is_uninit(uninit_vars, base_name) == 1 do
                ideFactState(node as int, IDE_STATE_INVALID)
                let decl_line = pass8_get_var_decl_line(base_name)
                pass8_report_error_related(diag, 5013, pass8_ast_line(node), 0, base_name,
                                           decl_line, 0, "Variable declared here")
            eif pass8_is_moved(moved_vars, base_name) == 1 do
                ideFactResourceOrigins(node as int, pass8_moved_line(moved_vars, base_name), 0, pass8_state_path(base_name))
                ideFactState(node as int, IDE_STATE_MOVED)
                pass8_report_error_related(diag, 5001, pass8_ast_line(node), 0, base_name,
                                           pass8_moved_line(moved_vars, base_name), 0, "Value was moved here")
            else
                ideFactState(node as int, IDE_STATE_ALIVE)
            end
        end
    end

    # 1c. AwaitExpr — temporary borrow directly inside await expression
    if pass8_ast_type(node) == AstType.AwaitExpr do
        let aw_count = vec_len_rt(pass8_ast_children(node))
        var ai = 0
        when ai < aw_count loop
            let ach = vec_get_rt(pass8_ast_children(node), ai)
            if pass8_ast_type(ach) == AstType.AddrOf do
                pass8_report_error(diag, 5011, pass8_ast_line(node), 0)
            end
            ai = ai + 1
        end
    end

    # 2. AddrOf
    if pass8_ast_type(node) == AstType.AddrOf do
        pass8_handle_addr_of(symbols, scopes, diag, node, moved_vars, shared_borrows, mut_borrows,
                             bound_borrows, arena_locals, pre_arena_names, in_arena, var_types, func_locals, uninit_vars)
        out 0
    end

    # 3. Variable Assignment (x = rhs / x[i] = rhs)
    if pass8_ast_type(node) == AstType.Assign or pass8_ast_type(node) == AstType.FieldAssign or pass8_ast_type(node) == AstType.SwizzleAssign or pass8_ast_type(node) == AstType.IndexAssign do
        var assign_name = pass8_assignment_path(node)
        let child_count = vec_len_rt(pass8_ast_children(node))
        var rhs = 0
        if pass8_ast_type(node) == AstType.FieldAssign do
            if child_count > 0 do
                rhs = vec_get_rt(pass8_ast_children(node), 0)
            end
        eif pass8_ast_type(node) == AstType.IndexAssign do
            if child_count > 0 do
                rhs = vec_get_rt(pass8_ast_children(node), child_count - 1)
                var ki = 0
                when ki < child_count - 1 loop
                    let idx_expr = vec_get_rt(pass8_ast_children(node), ki)
                    pass8_walk(symbols, scopes, diag, idx_expr, moved_vars, shared_borrows, mut_borrows,
                               bound_borrows, arena_locals, pre_arena_names, in_arena, var_types, func_locals, uninit_vars)
                    ki = ki + 1
                end
            end
        eif child_count == 1 do
            rhs = vec_get_rt(pass8_ast_children(node), 0)
        eif child_count >= 2 do
            rhs = vec_get_rt(pass8_ast_children(node), 1)
            if pass8_strlen(assign_name) == 0 do
                let lhs = vec_get_rt(pass8_ast_children(node), 0)
                assign_name = pass8_ast_name(lhs)
            end
        end

        if pass8_strlen(assign_name) > 0 do
            # Cannot mutate variable while shared borrow is active
            if pass8_borrow_count(shared_borrows, assign_name) > 0 do
                pass8_report_error_related(diag, 5009, pass8_ast_line(node), 0, assign_name,
                                           pass8_borrow_line(shared_borrows, assign_name), 0, "Shared borrow started here")
            end
            # Cannot mutate variable while mutable borrow is held by another reference
            if pass8_borrow_count(mut_borrows, assign_name) > 0 do
                pass8_report_error_related(diag, 5003, pass8_ast_line(node), 0, assign_name,
                                           pass8_borrow_line(mut_borrows, assign_name), 0, "Mutable borrow started here")
            end
        end

        var claimed = 0
        if (rhs as i64) != 0 do
            if pass8_strlen(assign_name) > 0 do
                let rhs_type = pass8_infer_expr_type(var_types, rhs)
                pass8_register_var_type(var_types, assign_name, rhs_type)
                pass8_register_arena_local(arena_locals, pre_arena_names, assign_name, in_arena)
                pass8_check_arena_escape_assign(diag, assign_name, rhs, arena_locals, pre_arena_names, in_arena, pass8_ast_line(node))
            end
            if pass8_ast_type(rhs) == AstType.AddrOf do
                # Validate a rebind while the old borrow is still active.
                let borrow_tgt = pass8_handle_addr_of(symbols, scopes, diag, rhs, moved_vars,
                                                      shared_borrows, mut_borrows, bound_borrows,
                                                      arena_locals, pre_arena_names, in_arena, var_types, func_locals, uninit_vars)
                if pass8_strlen(assign_name) > 0 do
                    pass8_release_borrower(bound_borrows, shared_borrows, mut_borrows, assign_name)
                    pass8_unmark_moved(moved_vars, assign_name)
                    pass8_unmark_uninit(uninit_vars, assign_name)
                end
                if pass8_strlen(borrow_tgt) > 0 do
                    let root_tgt = pass8_root_owner(borrow_tgt)
                    let tgt_depth = pass8_get_var_scope_depth(root_tgt)
                    let lhs_depth = pass8_get_var_scope_depth(assign_name)
                    if tgt_depth > lhs_depth and lhs_depth > 0 and tgt_depth > 0 do
                        let decl_line = pass8_get_var_decl_line(root_tgt)
                        pass8_report_error_related(diag, 5012, pass8_ast_line(rhs), 0, assign_name,
                                                   decl_line, 0, "Owner declared here")
                    end
                    var borrow_kind = 1
                    if pass8_cstr_eq(pass8_ast_name(rhs), "mut") == 1 do
                        borrow_kind = 2
                    end
                    pass8_claim_borrow(bound_borrows, assign_name, borrow_tgt, borrow_kind)
                    claimed = 1
                end
            else
                claimed = pass8_process_binding_rhs(symbols, scopes, diag, rhs, moved_vars,
                                                    shared_borrows, mut_borrows, bound_borrows,
                                                    assign_name, arena_locals, pre_arena_names, in_arena, var_types, func_locals, uninit_vars)
                if pass8_strlen(assign_name) > 0 do
                    pass8_release_borrower(bound_borrows, shared_borrows, mut_borrows, assign_name)
                    pass8_unmark_moved(moved_vars, assign_name)
                    pass8_unmark_uninit(uninit_vars, assign_name)
                end
            end
        end
        out claimed
    end

    if pass8_ast_type(node) == AstType.VarDeclGroup do
        let child_count = vec_len_rt(pass8_ast_children(node))
        var vi = 0
        var claimed = 0
        when vi < child_count loop
            let child = vec_get_rt(pass8_ast_children(node), vi)
            claimed = pass8_walk(symbols, scopes, diag, child, moved_vars, shared_borrows, mut_borrows,
                                 bound_borrows, arena_locals, pre_arena_names, in_arena, var_types, func_locals, uninit_vars)
            vi = vi + 1
        end
        out claimed
    end

    # 4. Variable / Constant Declaration (let x = init / var x = init)
    if pass8_ast_type(node) == AstType.VarDecl or pass8_ast_type(node) == AstType.ConstDecl do
        var claimed = 0
        let child_count = vec_len_rt(pass8_ast_children(node))
        if pass8_ast_int_val(node) == 16384 do
            var ti = 0
            when ti < child_count loop
                let tuple_child = vec_get_rt(pass8_ast_children(node), ti)
                if pass8_ast_type(tuple_child) == AstType.Identifier do
                    let tuple_name = pass8_ast_name(tuple_child)
                    pass8_record_local_binding(moved_vars, tuple_name)
                    pass8_register_var_scope(tuple_name, g_pass8_scope_depth, pass8_ast_line(node))
                    pass8_register_arena_local(arena_locals, pre_arena_names, tuple_name, in_arena)
                    if pass8_vec_contains(func_locals, tuple_name) == 0 do
                        let tuple_item = var_item_new(pass8_state_path(tuple_name), 0)
                        pass8_box_push(func_locals, tuple_item as i64)
                    end
                    pass8_unmark_moved(moved_vars, tuple_name)
                    pass8_unmark_uninit(uninit_vars, tuple_name)
                    ide_note_var(tuple_name as int, pass8_ast_line(node), 0, IDE_STATE_DECLARED)
                end
                ti = ti + 1
            end
        else
            let decl_name = pass8_ast_name(node)
            if pass8_strlen(decl_name) > 0 do
                let declared_kind = pass8_type_kind_from_type_str(pass8_ast_name2(node))
                pass8_register_var_type(var_types, decl_name, declared_kind)
                pass8_record_local_binding(moved_vars, decl_name)
                pass8_register_var_scope(decl_name, g_pass8_scope_depth, pass8_ast_line(node))
                pass8_register_arena_local(arena_locals, pre_arena_names, decl_name, in_arena)
                if pass8_vec_contains(func_locals, decl_name) == 0 do
                    let decl_item = var_item_new(pass8_state_path(decl_name), 0)
                    pass8_box_push(func_locals, decl_item as i64)
                end
                ide_note_var(decl_name as int, pass8_ast_line(node), 0, IDE_STATE_DECLARED)
                if child_count == 0 do
                    # A tensor declaration materializes its backing storage;
                    # indexed stores initialize elements in place rather than
                    # reinitializing the tensor binding itself.
                    if g_pass8_scope_depth > 0 and declared_kind != TypeKind.Tensor do
                        pass8_mark_uninit(uninit_vars, decl_name)
                    end
                else
                    pass8_unmark_uninit(uninit_vars, decl_name)
                end
            end
        end
        if child_count > 0 do
            let init = vec_get_rt(pass8_ast_children(node), child_count - 1)
            var bind_name = pass8_ast_name(node)
            if pass8_ast_int_val(node) == 16384 do
                bind_name = fat_str_new("")
            end
            if pass8_strlen(bind_name) > 0 do
                let init_type = pass8_infer_expr_type(var_types, init)
                pass8_register_var_type(var_types, bind_name, init_type)
                pass8_check_arena_escape_assign(diag, bind_name, init, arena_locals, pre_arena_names, in_arena, pass8_ast_line(node))
                claimed = pass8_process_binding_rhs(symbols, scopes, diag, init, moved_vars,
                                                    shared_borrows, mut_borrows, bound_borrows,
                                                    bind_name, arena_locals, pre_arena_names, in_arena, var_types, func_locals, uninit_vars)
                pass8_unmark_moved(moved_vars, bind_name)
                pass8_unmark_uninit(uninit_vars, bind_name)
            else
                pass8_walk(symbols, scopes, diag, init, moved_vars, shared_borrows, mut_borrows,
                           bound_borrows, arena_locals, pre_arena_names, in_arena, var_types, func_locals, uninit_vars)
            end
        end
        out claimed
    end

    # 5. Function & Method Calls — by-value arguments transfer ownership.
    if pass8_ast_type(node) == AstType.Call or pass8_ast_type(node) == AstType.MethodCall do
        let call_name = pass8_ast_name(node)
        if pass8_cstr_eq(call_name, "arena_reset") == 1 or pass8_cstr_eq(call_name, "arena_free") == 1 do
            if pass8_box_len(shared_borrows) > 0 or pass8_box_len(mut_borrows) > 0 or pass8_box_len(bound_borrows) > 0 do
                var borrow_line = pass8_first_borrow_line(shared_borrows)
                if borrow_line == 0 do borrow_line = pass8_first_borrow_line(mut_borrows) end
                pass8_report_error_related(diag, 5010, pass8_ast_line(node), 0, call_name,
                                           borrow_line, 0, "Live borrow started here")
            end
        end
        let callee_fn = pass8_find_func(call_name)
        let child_count = vec_len_rt(pass8_ast_children(node))
        var i = 0
        when i < child_count loop
            let arg = vec_get_rt(pass8_ast_children(node), i)
            let compilerArgPointer = arg as int
            # Method-call child 0 is the receiver. It is an implicit `this`
            # borrow, not a by-value argument, so repeated mutating method
            # calls must not consume the receiver.
            if pass8_ast_type(node) == AstType.MethodCall and i == 0 do
                pass8_walk(symbols, scopes, diag, arg, moved_vars, shared_borrows, mut_borrows,
                           bound_borrows, arena_locals, pre_arena_names, in_arena, var_types, func_locals, uninit_vars)
            eif pass8_ast_type(arg) == AstType.AddrOf do
                if pass8_ast_type(node) == AstType.MethodCall and i > 0 and pass8_cstr_eq(pass8_ast_name(arg), "mut") == 1 do
                    let receiver = vec_get_rt(pass8_ast_children(node), 0)
                    let receiver_path = pass8_owner_path(receiver)
                    let mutable_arg_path = pass8_get_addr_target(arg)
                    if pass8_strlen(receiver_path) > 0 and pass8_strlen(mutable_arg_path) > 0 and pass8_paths_overlap(receiver_path, mutable_arg_path) == 1 do
                        pass8_report_error_related(diag, 5003, pass8_ast_line(arg), 0, mutable_arg_path,
                                                   pass8_ast_line(receiver), 0, "Mutable method receiver aliases this argument")
                    end
                end
                pass8_handle_addr_of(symbols, scopes, diag, arg, moved_vars, shared_borrows, mut_borrows,
                                     bound_borrows, arena_locals, pre_arena_names, in_arena, var_types, func_locals, uninit_vars)
            eif pass8_ast_type(arg) == AstType.Identifier do
                let arg_name = pass8_ast_name(arg)
                if g_ideFactsEnabled == 1 do ideFactBinding(compilerArgPointer, pass8_state_path(arg_name) as int) end
                pass8CaptureIdeLoan(compilerArgPointer, arg_name, bound_borrows, shared_borrows, mut_borrows)
                var param_idx = i
                if pass8_ast_type(node) == AstType.MethodCall do
                    param_idx = i - 1
                end
                var is_out_param = 0
                if (callee_fn as i64) != 0 do
                    let p_node = pass8_get_param(callee_fn, param_idx)
                    if (p_node as i64) != 0 do
                        let p_type = pass8_ast_type(p_node)
                        let p_mode = pass8_ast_int_val(p_node)
                        if p_type == AstType.OutParam or p_mode == 2 do
                            is_out_param = 1
                        end
                    end
                end
                if is_out_param == 1 do
                    pass8_unmark_uninit(uninit_vars, arg_name)
                    pass8_unmark_moved(moved_vars, arg_name)
                    ideFactState(compilerArgPointer, IDE_STATE_OUT)
                else
                    if pass8_is_uninit(uninit_vars, arg_name) == 1 do
                        ideFactState(compilerArgPointer, IDE_STATE_INVALID)
                        let decl_line = pass8_get_var_decl_line(arg_name)
                        pass8_report_error_related(diag, 5013, pass8_ast_line(arg), 0, arg_name,
                                                   decl_line, 0, "Variable declared here")
                    eif pass8_is_moved(moved_vars, arg_name) == 1 do
                        ideFactResourceOrigins(compilerArgPointer, pass8_moved_line(moved_vars, arg_name), 0, pass8_state_path(arg_name))
                        ideFactState(compilerArgPointer, IDE_STATE_MOVED)
                        pass8_report_error_related(diag, 5001, pass8_ast_line(arg), 0, arg_name,
                                                   pass8_moved_line(moved_vars, arg_name), 0, "Value was moved here")
                    else
                        ideFactState(compilerArgPointer, IDE_STATE_ALIVE)
                        if pass8_borrow_count(shared_borrows, arg_name) > 0 or pass8_borrow_count(mut_borrows, arg_name) > 0 do
                            var borrow_line = pass8_borrow_line(shared_borrows, arg_name)
                            if borrow_line == 0 do borrow_line = pass8_borrow_line(mut_borrows, arg_name) end
                            pass8_report_error_related(diag, 5008, pass8_ast_line(arg), 0, arg_name,
                                                       borrow_line, 0, "Borrow started here")
                        end
                        let arg_type = pass8_get_var_type(var_types, arg_name)
                        if type_is_move(arg_type) do
                            var should_move = 0
                            if (callee_fn as i64) != 0 do
                                let p_node = pass8_get_param(callee_fn, param_idx)
                                if (p_node as i64) != 0 do
                                    let p_type = pass8_ast_type(p_node)
                                    let p_mode = pass8_ast_int_val(p_node)
                                    if p_type != AstType.RefParam and p_mode != 1 and p_type != AstType.OutParam and p_mode != 2 do
                                        let p_type_str = pass8_ast_name2(p_node)
                                        let p_kind = pass8_type_kind_from_type_str(p_type_str)
                                        if type_is_move(p_kind) do
                                            should_move = 1
                                        end
                                    end
                                end
                            end
                            if should_move == 1 do
                                pass8_mark_moved_at(moved_vars, arg_name, pass8_ast_line(arg))
                                ideFactResourceOrigins(compilerArgPointer, pass8_ast_line(arg), 0, pass8_state_path(arg_name))
                                ideFactState(compilerArgPointer, IDE_STATE_MOVED)
                            end
                        end
                    end
                end
            eif pass8_ast_type(arg) == AstType.FieldAccess or pass8_ast_type(arg) == AstType.IndexAccess or pass8_ast_type(arg) == AstType.ExprIndex do
                let projected_arg = pass8_owner_path(arg)
                if pass8_is_moved(moved_vars, projected_arg) == 1 do
                    pass8_report_error_related(diag, 5001, pass8_ast_line(arg), 0, projected_arg,
                                               pass8_moved_line(moved_vars, projected_arg), 0, "Value was moved here")
                else
                    if pass8_borrow_count(shared_borrows, projected_arg) > 0 or pass8_borrow_count(mut_borrows, projected_arg) > 0 do
                        var projected_borrow_line = pass8_borrow_line(shared_borrows, projected_arg)
                        if projected_borrow_line == 0 do projected_borrow_line = pass8_borrow_line(mut_borrows, projected_arg) end
                        pass8_report_error_related(diag, 5008, pass8_ast_line(arg), 0, projected_arg,
                                                   projected_borrow_line, 0, "Borrow started here")
                    end
                    var projected_param_idx = i
                    if pass8_ast_type(node) == AstType.MethodCall do projected_param_idx = i - 1 end
                    var projected_should_move = 0
                    if (callee_fn as i64) != 0 do
                        let projected_param = pass8_get_param(callee_fn, projected_param_idx)
                        if (projected_param as i64) != 0 do
                            let projected_mode = pass8_ast_int_val(projected_param)
                            let projected_param_type = pass8_ast_type(projected_param)
                            if projected_param_type != AstType.RefParam and projected_mode != 1 and projected_param_type != AstType.OutParam and projected_mode != 2 do
                                if type_is_move(pass8_type_kind_from_type_str(pass8_ast_name2(projected_param))) do
                                    projected_should_move = 1
                                end
                            end
                        end
                    end
                    if projected_should_move == 1 do
                        pass8_mark_moved_at(moved_vars, projected_arg, pass8_ast_line(arg))
                    end
                end
            else
                pass8_walk(symbols, scopes, diag, arg, moved_vars, shared_borrows, mut_borrows,
                           bound_borrows, arena_locals, pre_arena_names, in_arena, var_types, func_locals, uninit_vars)
            end
            i = i + 1
        end
        out 0
    end

    # 6. Return Statement — verify no local reference / arena reference escape
    if pass8_ast_type(node) == AstType.ReturnStmt do
        let child_count = vec_len_rt(pass8_ast_children(node))
        if child_count > 0 do
            let val = vec_get_rt(pass8_ast_children(node), 0)
            var esc_val = val
            when (esc_val as i64) != 0 and pass8_ast_type(esc_val) == AstType.CastExpr and vec_len_rt(pass8_ast_children(esc_val)) > 0 loop
                esc_val = vec_get_rt(pass8_ast_children(esc_val), 0) as AstNode
            end
            # Check local reference escape / arena borrow escape
            if pass8_ast_type(esc_val) == AstType.AddrOf do
                let tgt = pass8_get_addr_target(esc_val)
                if pass8_strlen(tgt) > 0 do
                    let root = pass8_resolve_borrow_root(bound_borrows, tgt)
                    if pass8_vec_contains(arena_locals, root) == 1 do
                        pass8_report_error(diag, 5005, pass8_ast_line(node), 0)
                    eif pass8_vec_contains(func_locals, root) == 1 do
                        if pass8_box_find(g_pass8_func_params, root) == 0 or (pass8_get_var_type(var_types, root) != TypeKind.Ref and pass8_get_var_type(var_types, root) != TypeKind.MutRef) do
                            pass8_report_error(diag, 5007, pass8_ast_line(node), 0)
                        end
                    end
                end
            end
            if pass8_ast_type(esc_val) == AstType.Identifier do
                let esc_name = pass8_ast_name(esc_val)
                let root = pass8_resolve_borrow_root(bound_borrows, esc_name)
                let esc_key = pass8_state_path(esc_name)
                if pass8_streq(root, esc_key) == 0 or pass8_box_find(bound_borrows, esc_key) != 0 do
                    if pass8_vec_contains(arena_locals, root) == 1 do
                        pass8_report_error(diag, 5005, pass8_ast_line(node), 0)
                    eif pass8_vec_contains(func_locals, root) == 1 do
                        if pass8_box_find(g_pass8_func_params, root) == 0 or (pass8_get_var_type(var_types, root) != TypeKind.Ref and pass8_get_var_type(var_types, root) != TypeKind.MutRef) do
                            pass8_report_error(diag, 5007, pass8_ast_line(node), 0)
                        end
                    end
                end
            end
            pass8_walk(symbols, scopes, diag, val, moved_vars, shared_borrows, mut_borrows,
                       bound_borrows, arena_locals, pre_arena_names, in_arena, var_types, func_locals, uninit_vars)
        end
        g_pass8_flow_kind = 3
        out 0
    end

    # 7. Print / Throw Statements
    if pass8_ast_type(node) == AstType.PrintStmt or pass8_ast_type(node) == AstType.ThrowStmt do
        let child_count = vec_len_rt(pass8_ast_children(node))
        var i = 0
        when i < child_count loop
            let child = vec_get_rt(pass8_ast_children(node), i)
            pass8_walk(symbols, scopes, diag, child, moved_vars, shared_borrows, mut_borrows,
                       bound_borrows, arena_locals, pre_arena_names, in_arena, var_types, func_locals, uninit_vars)
            i = i + 1
        end
        if pass8_ast_type(node) == AstType.ThrowStmt do
            g_pass8_flow_kind = 3
        end
        out 0
    end

    # 8. Attribute bindings
    if pass8_ast_type(node) == AstType.BindAttr or pass8_ast_type(node) == AstType.ExposeAttr do
        let child_count = vec_len_rt(pass8_ast_children(node))
        if child_count > 0 do
            let child = vec_get_rt(pass8_ast_children(node), 0)
            out pass8_walk(symbols, scopes, diag, child, moved_vars, shared_borrows, mut_borrows,
                           bound_borrows, arena_locals, pre_arena_names, in_arena, var_types, func_locals, uninit_vars)
        end
        out 0
    end

    if pass8_ast_type(node) == AstType.ExternFunc do
        out 0
    end

    # 9. Function Definition — fresh function-level ownership tracking context
    if pass8_ast_type(node) == AstType.FuncDef do
        let saved_flow_kind = g_pass8_flow_kind
        let saved_bindings = g_pass8_bindings
        let saved_scope_stack = g_pass8_scope_stack
        let saved_scope_ids = g_pass8_scope_ids
        let saved_var_scopes = g_pass8_var_scopes
        let saved_decl_lines = g_pass8_var_decl_lines
        let saved_loop_flows = g_pass8_loop_flows
        let saved_next_binding_id = g_pass8_next_binding_id
        let saved_next_scope_id = g_pass8_next_scope_id
        g_pass8_bindings = pass8_box_new()
        g_pass8_scope_stack = pass8_box_new()
        pass8_box_push(g_pass8_scope_stack, var_item_new(fat_str_new("scope"), 0) as i64)
        g_pass8_scope_ids = pass8_box_new()
        g_pass8_var_scopes = pass8_box_new()
        g_pass8_var_decl_lines = pass8_box_new()
        g_pass8_loop_flows = pass8_box_new()
        g_pass8_next_binding_id = 1
        g_pass8_next_scope_id = 1
        g_pass8_flow_kind = 0
        scope_push(scopes, ScopeKind.Func)
        pass8_enter_binding_scope(node as i64)
        let saved_scope_depth = g_pass8_scope_depth
        g_pass8_scope_depth = 1
        let old_params = g_pass8_func_params
        g_pass8_func_params = pass8_box_new()
        pass8_register_var_scope(fat_str_new("this"), 1, pass8_ast_line(node))
        pass8_box_push(g_pass8_func_params, var_item_new(pass8_state_path(fat_str_new("this")), 0) as i64)
        let func_moved = pass8_box_new()
        let func_shared = pass8_box_new()
        let func_mut = pass8_box_new()
        let func_bound_borrows = pass8_box_new()
        let func_arena_locals = pass8_box_new()
        let func_pre_arena = pass8_box_new()
        let func_var_types = pass8_box_new()
        let fn_locals = pass8_box_new()
        let func_uninit = pass8_box_new()

        let child_count = vec_len_rt(pass8_ast_children(node))
        var i = 0
        when i < child_count loop
            let child = vec_get_rt(pass8_ast_children(node), i)
            if pass8_ast_type(child) == AstType.Identifier or pass8_ast_type(child) == AstType.ParamDef or pass8_ast_type(child) == AstType.RefParam or pass8_ast_type(child) == AstType.OutParam do
                if pass8_strlen(pass8_ast_name(child)) > 0 do
                    let child_name = pass8_ast_name(child)
                    pass8_register_var_scope(child_name, 1, pass8_ast_line(child))
                    let fn_item = var_item_new(pass8_state_path(child_name), 0)
                    pass8_box_push(fn_locals, fn_item as i64)
                    let p_item = var_item_new(pass8_state_path(child_name), 0)
                    pass8_box_push(g_pass8_func_params, p_item as i64)
                    if pass8_ast_type(child) == AstType.RefParam or pass8_ast_type(child) == AstType.OutParam do
                        pass8_register_var_type(func_var_types, child_name, TypeKind.Ref)
                    else
                        let p_type_str = pass8_ast_name2(child)
                        let p_kind = pass8_type_kind_from_type_str(p_type_str)
                        pass8_register_var_type(func_var_types, child_name, p_kind)
                    end
                end
            end
            pass8_walk(symbols, scopes, diag, child, func_moved, func_shared, func_mut,
                       func_bound_borrows, func_arena_locals, func_pre_arena, 0, func_var_types, fn_locals, func_uninit)
            i = i + 1
        end
        g_pass8_func_params = old_params
        g_pass8_flow_kind = saved_flow_kind
        g_pass8_scope_depth = saved_scope_depth
        pass8_leave_binding_scope()
        g_pass8_bindings = saved_bindings
        g_pass8_scope_stack = saved_scope_stack
        g_pass8_scope_ids = saved_scope_ids
        g_pass8_var_scopes = saved_var_scopes
        g_pass8_var_decl_lines = saved_decl_lines
        g_pass8_loop_flows = saved_loop_flows
        g_pass8_next_binding_id = saved_next_binding_id
        g_pass8_next_scope_id = saved_next_scope_id
        scope_pop(scopes)
        out 0
    end

    # 10. Generic Block — lexical borrow lifetime scope
    if pass8_ast_type(node) == AstType.Block do
        scope_push(scopes, ScopeKind.Block)
        pass8_enter_binding_scope(node as i64)
        g_pass8_scope_depth = g_pass8_scope_depth + 1
        let cur_depth = g_pass8_scope_depth
        let shadow_frame = pass8_box_new()
        pass8_box_push(g_pass8_shadow_frames, shadow_frame)
        let bound_wm = pass8_box_len(bound_borrows)
        let shared_wm = pass8_box_len(shared_borrows)
        let mut_wm = pass8_box_len(mut_borrows)
        let claimed = pass8_walk_children_stmts(symbols, scopes, diag, node, moved_vars, shared_borrows, mut_borrows,
                                                bound_borrows, arena_locals, pre_arena_names, in_arena, var_types, func_locals, uninit_vars)
        # Check lexical lifetime escape at block exit:
        let b_len = pass8_box_len(bound_borrows)
        var bi = 0
        when bi < b_len loop
            let b_item = pass8_box_get(bound_borrows, bi)
            let b_lhs = borrow_binding_lhs(b_item)
            let b_tgt = borrow_binding_target(b_item)
            let lhs_depth = pass8_get_var_scope_depth(b_lhs)
            let root_tgt = pass8_root_owner(b_tgt)
            let tgt_depth = pass8_get_var_scope_depth(root_tgt)
            if lhs_depth > 0 and lhs_depth < cur_depth and tgt_depth >= cur_depth do
                let decl_line = pass8_get_var_decl_line(root_tgt)
                pass8_report_error_related(diag, 5012, pass8_ast_line(node), 0, b_lhs,
                                           decl_line, 0, "Owner declared here")
            end
            bi = bi + 1
        end

        # Release block-scoped borrows
        if in_arena == 0 do
            pass8_filter_out_scope_borrows(bound_borrows, cur_depth)
            pass8_truncate_to(bound_borrows, bound_wm)
        end
        pass8_truncate_to(shared_borrows, shared_wm)
        pass8_truncate_to(mut_borrows, mut_wm)
        pass8_filter_var_state_scope(moved_vars, cur_depth)
        pass8_filter_var_state_scope(uninit_vars, cur_depth)
        pass8_filter_var_state_scope(var_types, cur_depth)
        pass8_restore_local_bindings(moved_vars, shadow_frame)
        pass8_box_pop(g_pass8_shadow_frames)
        g_pass8_scope_depth = g_pass8_scope_depth - 1
        pass8_leave_binding_scope()
        scope_pop(scopes)
        out claimed
    end

    # 11. Arena Block — region lifetime validation
    if pass8_ast_type(node) == AstType.ArenaBlock do
        scope_push(scopes, ScopeKind.Block)
        pass8_enter_binding_scope(node as i64)
        g_pass8_scope_depth = g_pass8_scope_depth + 1
        let moved_wm = pass8_box_len(moved_vars)
        let shared_wm = pass8_box_len(shared_borrows)
        let mut_wm = pass8_box_len(mut_borrows)
        let bound_wm = pass8_box_len(bound_borrows)
        let arena_wm = pass8_box_len(arena_locals)
        pass8_walk_children_stmts(symbols, scopes, diag, node, moved_vars, shared_borrows, mut_borrows,
                                  bound_borrows, arena_locals, pre_arena_names, 1, var_types, func_locals, uninit_vars)
        pass8_check_arena_borrow_escape(diag, arena_locals, pre_arena_names, bound_borrows, pass8_ast_line(node))
        pass8_truncate_to(moved_vars, moved_wm)
        pass8_truncate_to(shared_borrows, shared_wm)
        pass8_truncate_to(mut_borrows, mut_wm)
        pass8_truncate_to(bound_borrows, bound_wm)
        pass8_truncate_to(arena_locals, arena_wm)
        g_pass8_scope_depth = g_pass8_scope_depth - 1
        pass8_leave_binding_scope()
        scope_pop(scopes)
        out 0
    end

    # 12. If joins branch move sets conservatively. Each branch starts from
    # the condition state; moves from either branch remain moved after merge.
    if pass8_ast_type(node) == AstType.IfStmt do
        scope_push(scopes, ScopeKind.Block)
        pass8_enter_binding_scope(node as i64)
        g_pass8_scope_depth = g_pass8_scope_depth + 1
        let if_depth = g_pass8_scope_depth
        let child_count = vec_len_rt(pass8_ast_children(node))
        if child_count > 0 do
            let cond = vec_get_rt(pass8_ast_children(node), 0)
            pass8_walk(symbols, scopes, diag, cond, moved_vars, shared_borrows, mut_borrows,
                       bound_borrows, arena_locals, pre_arena_names, in_arena, var_types, func_locals, uninit_vars)
        end
        let cond_moved = pass8_box_clone(moved_vars)
        let cond_shared = pass8_box_clone(shared_borrows)
        let cond_mut = pass8_box_clone(mut_borrows)
        let cond_bound = pass8_box_clone(bound_borrows)
        let cond_uninit = pass8_box_clone(uninit_vars)

        let then_moved = pass8_box_clone(cond_moved)
        let then_shared = pass8_box_clone(cond_shared)
        let then_mut = pass8_box_clone(cond_mut)
        let then_bound = pass8_box_clone(cond_bound)
        let then_uninit = pass8_box_clone(cond_uninit)
        var then_flow = 0
        if child_count > 1 do
            let then_branch = vec_get_rt(pass8_ast_children(node), 1)
            g_pass8_flow_kind = 0
            pass8_walk(symbols, scopes, diag, then_branch, then_moved, then_shared, then_mut,
                       then_bound, arena_locals, pre_arena_names, in_arena, var_types, func_locals, then_uninit)
            then_flow = g_pass8_flow_kind
        end

        let else_moved = pass8_box_clone(cond_moved)
        let else_shared = pass8_box_clone(cond_shared)
        let else_mut = pass8_box_clone(cond_mut)
        let else_bound = pass8_box_clone(cond_bound)
        let else_uninit = pass8_box_clone(cond_uninit)
        var else_flow = 0
        if child_count > 2 do
            let else_branch = vec_get_rt(pass8_ast_children(node), 2)
            g_pass8_flow_kind = 0
            pass8_walk(symbols, scopes, diag, else_branch, else_moved, else_shared, else_mut,
                       else_bound, arena_locals, pre_arena_names, in_arena, var_types, func_locals, else_uninit)
            else_flow = g_pass8_flow_kind
        end

        if then_flow != 0 and else_flow != 0 do
            # Both branches terminate; fallthrough is unreachable.
            if then_flow == else_flow do
                g_pass8_flow_kind = then_flow
            else
                g_pass8_flow_kind = 3
            end
        eif then_flow != 0 do
            g_pass8_flow_kind = 0
            pass8_box_copy_into(moved_vars, else_moved)
            pass8_box_copy_into(shared_borrows, else_shared)
            pass8_box_copy_into(mut_borrows, else_mut)
            pass8_box_copy_into(bound_borrows, else_bound)
            pass8_box_copy_into(uninit_vars, else_uninit)
        eif else_flow != 0 do
            g_pass8_flow_kind = 0
            pass8_box_copy_into(moved_vars, then_moved)
            pass8_box_copy_into(shared_borrows, then_shared)
            pass8_box_copy_into(mut_borrows, then_mut)
            pass8_box_copy_into(bound_borrows, then_bound)
            pass8_box_copy_into(uninit_vars, then_uninit)
        else
            g_pass8_flow_kind = 0
            pass8_merge_moved_box(moved_vars, then_moved)
            pass8_merge_moved_box(moved_vars, else_moved)

            let u_count = pass8_box_len(then_uninit)
            var ui = 0
            when ui < u_count loop
                let u_name = var_item_name(pass8_box_get(then_uninit, ui))
                pass8_mark_uninit(uninit_vars, u_name)
                ui = ui + 1
            end
            let eu_count = pass8_box_len(else_uninit)
            ui = 0
            when ui < eu_count loop
                let u_name = var_item_name(pass8_box_get(else_uninit, ui))
                pass8_mark_uninit(uninit_vars, u_name)
                ui = ui + 1
            end

            # Conditional points-to merging:
            var bi = 0
            let t_len = pass8_box_len(then_bound)
            when bi < t_len loop
                let b_item = pass8_box_get(then_bound, bi)
                let b_lhs = borrow_binding_lhs(b_item)
                if pass8_get_var_scope_depth(b_lhs) < if_depth do
                    pass8_release_borrower(bound_borrows, shared_borrows, mut_borrows, b_lhs)
                end
                bi = bi + 1
            end
            bi = 0
            let e_len = pass8_box_len(else_bound)
            when bi < e_len loop
                let b_item = pass8_box_get(else_bound, bi)
                let b_lhs = borrow_binding_lhs(b_item)
                if pass8_get_var_scope_depth(b_lhs) < if_depth do
                    pass8_release_borrower(bound_borrows, shared_borrows, mut_borrows, b_lhs)
                end
                bi = bi + 1
            end

            bi = 0
            when bi < t_len loop
                let b_item = pass8_box_get(then_bound, bi)
                let b_lhs = borrow_binding_lhs(b_item)
                if pass8_get_var_scope_depth(b_lhs) < if_depth do
                    let b_tgt = borrow_binding_target(b_item)
                    let b_kind = borrow_binding_kind(b_item)
                    pass8_claim_borrow(bound_borrows, b_lhs, b_tgt, b_kind)
                    if b_kind == 2 do
                        pass8_box_push(mut_borrows, var_item_new(b_tgt, pass8_ast_line(node)) as i64)
                    else
                        pass8_box_push(shared_borrows, var_item_new(b_tgt, pass8_ast_line(node)) as i64)
                    end
                end
                bi = bi + 1
            end

            bi = 0
            when bi < e_len loop
                let b_item = pass8_box_get(else_bound, bi)
                let b_lhs = borrow_binding_lhs(b_item)
                if pass8_get_var_scope_depth(b_lhs) < if_depth do
                    let b_tgt = borrow_binding_target(b_item)
                    let b_kind = borrow_binding_kind(b_item)
                    var present = 0
                    let bb_len = pass8_box_len(bound_borrows)
                    var bbi = 0
                    when bbi < bb_len loop
                        let bb = pass8_box_get(bound_borrows, bbi)
                        if pass8_streq(borrow_binding_lhs(bb), b_lhs) == 1 and pass8_streq(borrow_binding_target(bb), b_tgt) == 1 do
                            present = 1
                            bbi = bb_len
                        else
                            bbi = bbi + 1
                        end
                    end
                    if present == 0 do
                        pass8_claim_borrow(bound_borrows, b_lhs, b_tgt, b_kind)
                        if b_kind == 2 do
                            pass8_box_push(mut_borrows, var_item_new(b_tgt, pass8_ast_line(node)) as i64)
                        else
                            pass8_box_push(shared_borrows, var_item_new(b_tgt, pass8_ast_line(node)) as i64)
                        end
                    end
                end
                bi = bi + 1
            end
        end

        g_pass8_scope_depth = g_pass8_scope_depth - 1
        pass8_leave_binding_scope()
        scope_pop(scopes)
        out 1
    end

    # Case arms are CFG predecessors, not a sequential statement list. Every
    # arm starts from the selector state and only continuing arms reach the
    # join. Terminating arms keep their own break/skip/return edge semantics.
    if pass8_ast_type(node) == AstType.CaseExpr do
        let case_count = vec_len_rt(pass8_ast_children(node))
        if case_count > 0 do
            let selector = vec_get_rt(pass8_ast_children(node), 0)
            pass8_walk(symbols, scopes, diag, selector, moved_vars, shared_borrows, mut_borrows,
                       bound_borrows, arena_locals, pre_arena_names, in_arena, var_types, func_locals, uninit_vars)
        end
        let case_entry_moved = pass8_box_clone(moved_vars)
        let case_entry_shared = pass8_box_clone(shared_borrows)
        let case_entry_mut = pass8_box_clone(mut_borrows)
        let case_entry_bound = pass8_box_clone(bound_borrows)
        let case_entry_uninit = pass8_box_clone(uninit_vars)
        let case_join_moved = pass8_box_new()
        let case_join_shared = pass8_box_new()
        let case_join_mut = pass8_box_new()
        let case_join_bound = pass8_box_new()
        let case_join_uninit = pass8_box_new()
        var case_has_continuing = 0
        var case_idx = 2
        when case_idx < case_count loop
            let case_body = vec_get_rt(pass8_ast_children(node), case_idx)
            let arm_moved = pass8_box_clone(case_entry_moved)
            let arm_shared = pass8_box_clone(case_entry_shared)
            let arm_mut = pass8_box_clone(case_entry_mut)
            let arm_bound = pass8_box_clone(case_entry_bound)
            let arm_uninit = pass8_box_clone(case_entry_uninit)
            g_pass8_flow_kind = 0
            pass8_walk(symbols, scopes, diag, case_body, arm_moved, arm_shared, arm_mut,
                       arm_bound, arena_locals, pre_arena_names, in_arena, var_types, func_locals, arm_uninit)
            if g_pass8_flow_kind == 0 do
                pass8_merge_moved_box(case_join_moved, arm_moved)
                pass8_merge_borrows_box(case_join_shared, arm_shared)
                pass8_merge_borrows_box(case_join_mut, arm_mut)
                pass8_merge_bound_box(case_join_bound, arm_bound)
                pass8_merge_moved_box(case_join_uninit, arm_uninit)
                case_has_continuing = 1
            end
            case_idx = case_idx + 2
        end
        if pass8_ast_int_val(node) == 1 and case_count > 1 do
            let else_body = vec_get_rt(pass8_ast_children(node), case_count - 1)
            let else_arm_moved = pass8_box_clone(case_entry_moved)
            let else_arm_shared = pass8_box_clone(case_entry_shared)
            let else_arm_mut = pass8_box_clone(case_entry_mut)
            let else_arm_bound = pass8_box_clone(case_entry_bound)
            let else_arm_uninit = pass8_box_clone(case_entry_uninit)
            g_pass8_flow_kind = 0
            pass8_walk(symbols, scopes, diag, else_body, else_arm_moved, else_arm_shared, else_arm_mut,
                       else_arm_bound, arena_locals, pre_arena_names, in_arena, var_types, func_locals, else_arm_uninit)
            if g_pass8_flow_kind == 0 do
                pass8_merge_moved_box(case_join_moved, else_arm_moved)
                pass8_merge_borrows_box(case_join_shared, else_arm_shared)
                pass8_merge_borrows_box(case_join_mut, else_arm_mut)
                pass8_merge_bound_box(case_join_bound, else_arm_bound)
                pass8_merge_moved_box(case_join_uninit, else_arm_uninit)
                case_has_continuing = 1
            end
        else
            pass8_merge_moved_box(case_join_moved, case_entry_moved)
            pass8_merge_borrows_box(case_join_shared, case_entry_shared)
            pass8_merge_borrows_box(case_join_mut, case_entry_mut)
            pass8_merge_bound_box(case_join_bound, case_entry_bound)
            pass8_merge_moved_box(case_join_uninit, case_entry_uninit)
            case_has_continuing = 1
        end
        if case_has_continuing == 1 do
            pass8_box_copy_into(moved_vars, case_join_moved)
            pass8_box_copy_into(shared_borrows, case_join_shared)
            pass8_box_copy_into(mut_borrows, case_join_mut)
            pass8_box_copy_into(bound_borrows, case_join_bound)
            pass8_box_copy_into(uninit_vars, case_join_uninit)
            g_pass8_flow_kind = 0
        end
        out 1
    end

    # 13. Control Flow: LoopStmt, WhileStmt, ForRange, WhenStmt
    if pass8_ast_type(node) == AstType.LoopStmt or pass8_ast_type(node) == AstType.WhileStmt or pass8_ast_type(node) == AstType.ForRange or pass8_ast_type(node) == AstType.WhenStmt do
        scope_push(scopes, ScopeKind.Block)
        pass8_enter_binding_scope(node as i64)
        g_pass8_scope_depth = g_pass8_scope_depth + 1
        let loop_depth = g_pass8_scope_depth
        let child_count = vec_len_rt(pass8_ast_children(node))

        var loop_converged = 0
        let exit_moved = pass8_box_new()
        let exit_uninit = pass8_box_new()
        let loop_flow = pass8_loop_flow_new()
        pass8_box_push(g_pass8_loop_flows, loop_flow as i64)
        let loop_entry_moved = pass8_box_clone(moved_vars)
        let loop_entry_shared = pass8_box_clone(shared_borrows)
        let loop_entry_mut = pass8_box_clone(mut_borrows)
        let loop_entry_bound = pass8_box_clone(bound_borrows)
        let loop_entry_uninit = pass8_box_clone(uninit_vars)

        # The state lattice is finite. Re-evaluate the header transfer until
        # every ownership component is stable; never stop at a source-independent
        # iteration cap because long dependency chains may require more rounds.
        when loop_converged == 0 loop
            g_pass8_flow_kind = 0
            let iter_start_moved = pass8_box_clone(moved_vars)
            let iter_start_shared = pass8_box_clone(shared_borrows)
            let iter_start_mut = pass8_box_clone(mut_borrows)
            let iter_start_bound = pass8_box_clone(bound_borrows)
            let iter_start_uninit = pass8_box_clone(uninit_vars)

            if child_count > 0 do
                let cond = vec_get_rt(pass8_ast_children(node), 0)
                pass8_walk(symbols, scopes, diag, cond, moved_vars, shared_borrows, mut_borrows,
                           bound_borrows, arena_locals, pre_arena_names, in_arena, var_types, func_locals, uninit_vars)
            end

            var i = 1
            when i < child_count loop
                let shared_stmt_wm = pass8_box_len(shared_borrows)
                let mut_stmt_wm = pass8_box_len(mut_borrows)
                let child = vec_get_rt(pass8_ast_children(node), i)


                let claimed = pass8_walk(symbols, scopes, diag, child, moved_vars, shared_borrows, mut_borrows,
                                         bound_borrows, arena_locals, pre_arena_names, in_arena, var_types, func_locals, uninit_vars)
                pass8_end_stmt(shared_borrows, mut_borrows, shared_stmt_wm, mut_stmt_wm, claimed)
                i = i + 1
            end

            # `skip` is a real back-edge. Its state participates in the next
            # header join, while `break` is retained only for the loop exit.
            pass8_merge_loop_edge(loop_flow, 5, moved_vars, shared_borrows, mut_borrows,
                                  bound_borrows, uninit_vars)

            pass8_merge_moved_box(exit_moved, iter_start_moved)
            let u_count = pass8_box_len(iter_start_uninit)
            var ui = 0
            when ui < u_count loop
                let u_name = var_item_name(pass8_box_get(iter_start_uninit, ui))
                pass8_mark_uninit(exit_uninit, u_name)
                ui = ui + 1
            end

            if g_pass8_flow_kind == 1 or g_pass8_flow_kind == 3 do
                loop_converged = 1
            else
                g_pass8_flow_kind = 0
                pass8_filter_out_scope_borrows(bound_borrows, loop_depth)
                # Standard header equation: H = Entry join Latch(H). Rebuild
                # the header from the immutable entry state every round so
                # transfer kills (reinitialization/rebind) remain monotone and
                # cannot oscillate between latch states.
                let next_moved = pass8_box_clone(loop_entry_moved)
                let next_shared = pass8_box_clone(loop_entry_shared)
                let next_mut = pass8_box_clone(loop_entry_mut)
                let next_bound = pass8_box_clone(loop_entry_bound)
                let next_uninit = pass8_box_clone(loop_entry_uninit)
                pass8_merge_moved_box(next_moved, moved_vars)
                pass8_merge_borrows_box(next_shared, shared_borrows)
                pass8_merge_borrows_box(next_mut, mut_borrows)
                pass8_merge_bound_box(next_bound, bound_borrows)
                pass8_merge_moved_box(next_uninit, uninit_vars)
                if pass8_dataflow_state_equal(iter_start_moved, next_moved,
                                              iter_start_shared, next_shared,
                                              iter_start_mut, next_mut,
                                              iter_start_bound, next_bound,
                                              iter_start_uninit, next_uninit) == 1 do
                    loop_converged = 1
                end
                pass8_box_copy_into(moved_vars, next_moved)
                pass8_box_copy_into(shared_borrows, next_shared)
                pass8_box_copy_into(mut_borrows, next_mut)
                pass8_box_copy_into(bound_borrows, next_bound)
                pass8_box_copy_into(uninit_vars, next_uninit)
            end
        end

        pass8_merge_moved_box(moved_vars, exit_moved)
        let ex_u_count = pass8_box_len(exit_uninit)
        var eui = 0
        when eui < ex_u_count loop
            let u_name = var_item_name(pass8_box_get(exit_uninit, eui))
            pass8_mark_uninit(uninit_vars, u_name)
            eui = eui + 1
        end
        pass8_filter_out_scope_borrows(bound_borrows, loop_depth)
        pass8_merge_loop_edge(loop_flow, 0, moved_vars, shared_borrows, mut_borrows,
                              bound_borrows, uninit_vars)
        pass8_box_pop(g_pass8_loop_flows)
        g_pass8_flow_kind = 0

        g_pass8_scope_depth = g_pass8_scope_depth - 1
        pass8_leave_binding_scope()
        scope_pop(scopes)
        out 1
    end

    # 14. Default: walk all child AST nodes
    let child_count = vec_len_rt(pass8_ast_children(node))
    var i = 0
    when i < child_count loop
        let child = vec_get_rt(pass8_ast_children(node), i)
        pass8_walk(symbols, scopes, diag, child, moved_vars, shared_borrows, mut_borrows,
                   bound_borrows, arena_locals, pre_arena_names, in_arena, var_types, func_locals, uninit_vars)
        i = i + 1
    end
    out 0
end.

export pass8_analyze_borrow
