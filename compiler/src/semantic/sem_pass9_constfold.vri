##
 * vir/compiler/sem_pass9_constfold.vri
 * ==============================================================
 * Pass 9: Constant Folding Analysis Orchestrator.
 * Detects compile-time evaluable expressions and constant propagation.
 * Reports warnings for always-true/false conditions (dead code).
 * Actual folding is deferred to MIR optimizer.
 ##

include vec_rt
include string_rt
include parser
include symbol_table
include scope_tree
include context
include alloc
include constfold_context
include constfold_eval_precomp
include constfold_eval_expr
include constfold_walk

func pass9_const_fold(ref symbols: SymbolTable, ref scopes: ScopeTree, diag: &DiagnosticEngine, node: &AstNode):
    # const_map_box: 1-word cell holding vec of (name, value) pairs
    let const_map_box = vir_alloc(8)
    native_write_i64(const_map_box, 0, vec_new_rt())
    pass9_walk(symbols, scopes, diag, node, const_map_box, node)
end.

export pass9_const_fold
