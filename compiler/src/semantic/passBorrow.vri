##
 * compiler/src/semantic/passBorrow.vri — Borrow Analysis Pass Orchestrator
 * =======================================================================
 * VIRC-PLN-0003 Section 5.4 & 5.6: Pass Architecture & Borrow Orchestrator.
 *
 * Owns Pass ID, stage metadata, precondition verification, and dataflow dispatch.
 * Delegates move/loan/scope/Arena analysis to leaf modules (and sem_pass8_borrow).
 ##

include types
include symbol_table
import SymbolTable from symbol_table
include scope_tree
import ScopeTree from scope_tree
include context
import DiagnosticEngine from context
include parser
import AstNode from parser
include compiler.sem_pass8_borrow
import pass8_analyze_borrow from compiler.sem_pass8_borrow

# ═══════════════════════════════════════════════════════
# Pass Metadata
# ═══════════════════════════════════════════════════════

const PASS_BORROW_ID: string = "virc.semantic.borrow"
const PASS_BORROW_STAGE: int = 8
const PASS_BORROW_NAME: string = "Borrow Analysis Pass"

# ═══════════════════════════════════════════════════════
# Orchestrator Entry Points
# ═══════════════════════════════════════════════════════

func passBorrowRun(ref symbols: SymbolTable, ref scopes: ScopeTree, diag: &DiagnosticEngine, ast: &AstNode) -> int:
    # Orchestrates borrow analysis across binding, loan, move and cleanup scopes
    pass8_analyze_borrow(symbols, scopes, diag, ast)
    out 0
end.

func pass_borrow_run(ref symbols: SymbolTable, ref scopes: ScopeTree, diag: &DiagnosticEngine, ast: &AstNode) -> int:
    out passBorrowRun(symbols, scopes, diag, ast)
end.

export PASS_BORROW_ID, PASS_BORROW_STAGE, PASS_BORROW_NAME,
       passBorrowRun, pass_borrow_run, pass8_analyze_borrow
