##
 * vir/compiler/sem_pass2_symbols.vri
 * ==============================================================
 * Pass 2: Symbol Registration Orchestrator (Vir v2.0 Complete).
 * Walks the top-level AST and registers all functions, entities,
 * packed/register structs, enums, variables, constants, and builtins.
 ##

include vec_rt
include string_rt
include parser
include symbol_table
include scope_tree
include context
include ide_facts
include symbols_context
include symbols_builtins
include symbols_walk_types
include symbols_walk

func pass2_register_symbols(ref symbols: SymbolTable, ref scopes: ScopeTree, diag: &DiagnosticEngine, node: &AstNode):
    pass2_maps_reset()
    g_pass2_type_names = vec_new_rt()
    g_pass2_cur_module = fat_str_new("")
    g_pass2_cur_module_sym_id = -1
    pass2_collect_type_names(node)
    # 1. Register builtin symbols into global scope
    pass2_register_builtins(symbols, scopes)

    # 2. Walk AST for declarations
    pass2_walk_node(symbols, scopes, diag, node)
end.

export pass2_register_symbols
