##
 * vir/compiler/sem_pass10_diagnostics.vri
 * ==============================================================
 * Pass 10: Diagnostics Emission.
 * Formats and prints all collected diagnostics, returns error count.
 ##

include vec_rt
include cli_ui
include opt_trace
import optTraceAppendJson from virc.backend.opt_trace
include ide_semantic

include string_rt

include rt.alloc
import vir_alloc, vir_free, alloc from rt.alloc

include context
include source_manager

include rt.syscall
import sys_getrusage, sys_clock_gettime, sys_platform, Platform, sys_open, sys_read, sys_close, VIR_O_RDONLY from rt.syscall

include sem_diag_session
include sem_diag_msg_frontend
include sem_diag_msg_semantic
include sem_diag_actions
include sem_diag_json
include sem_diag_modern
include sem_diag_render

func pass10_emit_diagnostics(diag: &DiagnosticEngine):
    if g_diagSessionActive == 1 do pass10CaptureDiagnostics(diag) end
    count = vec_len_rt(diag.diagnostics)
    if count == 0 do
        out 0
    end

    if g_phase_timings == 1 and g_phase_semantic_start_us > 0 do
        g_phase_semantic_us = virc_elapsed_us() - g_phase_semantic_start_us
    end
    if g_diag_json == 1 do
        out pass10_emit_json(diag)
    end

    if g_ui_mode == 1 do out pass10EmitModern(diag) end

    let use_color = virc_should_color()

    if count <= 2 do
        var i = 0
        when i < count loop
            d = vec_get_rt(diag.diagnostics, i)
            pass10_print_one_detailed(d, use_color)
            i = i + 1
        end
    else
        var i = 0
        when i < count loop
            d = vec_get_rt(diag.diagnostics, i)
            pass10_print_one_compact(d, use_color)
            i = i + 1
        end
        print_ln("")
    end

    # Print summary
    arena:
        var sb = sb_new()
        sb = sb_append(sb, "virc: ")
        sb = sb_append_int(sb, diag.error_count)
        sb = sb_append(sb, " error(s), ")
        var warn_count = count - diag.error_count
        sb = sb_append_int(sb, warn_count)
        sb = sb_append(sb, " warning(s)")
        print_ln(sb_to_string(sb))
        sb_free(sb)
    end

    virc_print_compile_time()

    out diag.error_count
end.

export pass10_code_to_msg, pass10_emit_diagnostics, pass10_print_one, pass10_emit_json,
       pass10HumanLine, pass10AppendCode, pass10EmitModern,
       pass10SessionReset, pass10SessionEmit, pass10SessionSerialize, pass10CaptureDiagnostics,
       compilerFailure, compilerAbort,
       virc_timer_init, virc_elapsed_us, virc_print_compile_time, virc_print_phase_timings,
       g_color_mode, g_diag_json, g_phase_timings, g_time_buf_start, g_compile_timer_printed,
       g_phase_read_us, g_phase_preprocess_us, g_phase_lex_us, g_phase_parse_us,
       g_phase_semantic_us, g_phase_semantic_start_us, g_phase_lower_us,
       g_phase_codegen_us, g_phase_link_us
