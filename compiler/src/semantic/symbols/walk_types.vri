##
 * compiler/src/semantic/symbols/walk_types.vri — Type Declaration Symbol Walking
 * ==============================================================================
 * VIRC-PLN-0004 & Phase 2: Symbol Registration Decomposition.
 *
 * Registers symbols for entities, packed structs, registers, classes,
 * type aliases, enums, variants, and fields/methods.
 ##

include rt_vec_rt
include rt_string_rt
include parser
include symbol_table
include scope_tree
include context
include ide_facts
include symbols_context

func pass2_walk_type_def(ref symbols: SymbolTable, ref scopes: ScopeTree, diag: &DiagnosticEngine, node: &AstNode) -> int:
    if node.node_type == AstType.EntityDef or node.node_type == AstType.PackedDef or node.node_type == AstType.RegisterDef or node.node_type == AstType.ClassDef do
        pass2_register(symbols, scopes, diag, node.name, SymbolKind.Entity, node.line)
        ent_id = pass2_register(symbols, scopes, diag, node.name, SymbolKind.Entity, node.line)
        if ent_id > 0 do
            syms_vec = native_read_i64(symbols as i64, 0)
            ent_sym = vec_get_rt(syms_vec, ent_id)
            native_write_i64(ent_sym as i64, 32, node as i64)
        end
        scope_push(scopes, ScopeKind.Entity)
        child_count = vec_len_rt(node.children)
        var i = 0
        when i < child_count loop
            child = vec_get_rt(node.children, i)
            if child.node_type == AstType.VarDecl or child.node_type == AstType.Identifier do
                f_id = pass2_register(symbols, scopes, diag, child.name, SymbolKind.Variable, child.line)
                if f_id > 0 do
                    syms_vec2 = native_read_i64(symbols as i64, 0)
                    f_sym = vec_get_rt(syms_vec2, f_id)
                    native_write_i64(f_sym as i64, 32, child as i64)
                    native_write_i64(f_sym as i64, 72, ent_id as i64)
                    if g_ideFactsEnabled == 1 and node.node_type == AstType.RegisterDef do
                        ideFactResolve(child as int, f_id, scope_current_id(scopes), 1)
                        ideFactType(child as int, 1)
                    end
                end
            end
            if child.node_type == AstType.FuncDef do
                m_count = vec_len_rt(child.children)
                m_pc = m_count - 1
                if m_pc < 0 do
                    m_pc = 0
                end
                m_id = pass2_register(symbols, scopes, diag, child.name, SymbolKind.Method, child.line)
                if m_id > 0 do
                    syms_vec2 = native_read_i64(symbols as i64, 0)
                    m_sym = vec_get_rt(syms_vec2, m_id)
                    native_write_i64(m_sym as i64, 32, child as i64)
                    native_write_i64(m_sym as i64, 56, m_pc as i64)
                    native_write_i64(m_sym as i64, 72, ent_id as i64)
                end
            end
            i = i + 1
        end
        scope_pop(scopes)
        out 1
    end

    if node.node_type == AstType.TypeAlias do
        let aliasId = pass2_register(symbols, scopes, diag, node.name, SymbolKind.TypeDef, node.line)
        if aliasId >= 0 do
            let symbolsVec = native_read_i64(symbols as i64, 0)
            let aliasSymbol = vec_get_rt(symbolsVec, aliasId)
            native_write_i64(aliasSymbol as i64, 32, node as i64)
        end
        out 1
    end

    if node.node_type == AstType.EnumDef do
        enum_id = pass2_register(symbols, scopes, diag, node.name, SymbolKind.Enum, node.line)
        if enum_id > 0 do
            syms_vec = native_read_i64(symbols as i64, 0)
            enum_sym = vec_get_rt(syms_vec, enum_id)
            native_write_i64(enum_sym as i64, 32, node as i64)
        end

        # Unqualified variants are constructor symbols, not functions. Keep
        # the first declaration for colliding names (qualified Enum.Variant is
        # always unambiguous); this preserves enums such as MirType.None while
        # allowing imported Some/Ok/Err to resolve without fake helpers.
        child_count = vec_len_rt(node.children)
        var i = 0
        when i < child_count loop
            variant = vec_get_rt(node.children, i)
            existing = pass2_lookup_name_in_scope(symbols, scopes, scope_current_id(scopes), variant.name)
            if existing == -1 and pass2_is_type_name(variant.name) == false do
                variant_id = pass2_register(symbols, scopes, diag, variant.name, SymbolKind.Variant, variant.line)
                if variant_id > 0 do
                    syms_vec2 = native_read_i64(symbols as i64, 0)
                    variant_sym = vec_get_rt(syms_vec2, variant_id)
                    native_write_i64(variant_sym as i64, 32, variant as i64)
                    native_write_i64(variant_sym as i64, 56, vec_len_rt(variant.children))
                    native_write_i64(variant_sym as i64, 72, enum_id)
                end
            eif existing != -1 and pass2_is_type_name(variant.name) == false do
                syms_vec2 = native_read_i64(symbols as i64, 0)
                old_sym = vec_get_rt(syms_vec2, existing)
                old_kind = native_read_i64(old_sym as i64, 0)
                old_parent = native_read_i64(old_sym as i64, 72)
                if old_kind == SymbolKind.Variable do
                    native_write_i64(old_sym as i64, 0, SymbolKind.Variant as i64)
                    native_write_i64(old_sym as i64, 32, variant as i64)
                    native_write_i64(old_sym as i64, 56, vec_len_rt(variant.children))
                    native_write_i64(old_sym as i64, 72, enum_id)
                eif old_kind == SymbolKind.Variant do
                    # A second unqualified constructor spelling is ambiguous.
                    # Same-enum duplicates are rejected separately, so keeping
                    # this marker unconditional is bootstrap-stable and avoids
                    # depending on an aggregate-held parent id across calls.
                    native_write_i64(old_sym as i64, 72, 0 - 2)
                end
            end
            if g_ideFactsEnabled == 1 do
                # Keep declaration identity even when the unqualified spelling
                # is ambiguous. The qualified constructor is registered in the
                # actual symbol table; ordinary compilation keeps its old path.
                var declarationId = pass2_lookup_name_in_scope(symbols, scopes, scope_current_id(scopes), variant.name)
                var sameDeclaration = 0
                if declarationId >= 0 do
                    let declarationSymbol = vec_get_rt(native_read_i64(symbols as int, 0), declarationId)
                    if native_read_i64(declarationSymbol as int, 32) == variant as int do sameDeclaration = 1 end
                end
                if sameDeclaration == 0 do
                    let enumPrefix = fat_str_concat(node.name, fat_str_new("."))
                    let qualifiedName = fat_str_concat(enumPrefix, variant.name)
                    declarationId = pass2_register(symbols, scopes, diag, qualifiedName, SymbolKind.Variant, variant.line)
                    let declarationSymbol = vec_get_rt(native_read_i64(symbols as int, 0), declarationId)
                    native_write_i64(declarationSymbol as int, 32, variant as int)
                    native_write_i64(declarationSymbol as int, 56, vec_len_rt(variant.children))
                    native_write_i64(declarationSymbol as int, 72, enum_id)
                end
                ideFactResolve(variant as int, declarationId, scope_current_id(scopes), 1)
                ideFactType(variant as int, 6)
                ideFactResolvedType(variant as int, enum_id)
            end
            i = i + 1
        end
        out 1
    end

    out 0
end.
