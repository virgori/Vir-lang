##
 * compiler/src/semantic/symbols/builtins.vri — Builtin Symbol Registration
 * =======================================================================
 * VIRC-PLN-0004 & Phase 2: Symbol Registration Decomposition.
 *
 * Registers intrinsic functions, memory primitives, syscall helpers,
 * atomic operations, and system barriers into global scope 0.
 ##

include rt_string_rt
include symbol_table
include scope_tree
include symbols_context

func pass2_register_builtin_one(ref symbols: SymbolTable, ref scopes: ScopeTree, name: string, param_count: int):
    # Builtin list is fixed and unique — skip redef scan (was O(B²)).
    sym = SymbolNode (
        kind: SymbolKind.Builtin,
        name_id: name as i64,
        type_id: 0,
        scope_id: 0,
        ast_id: 0,
        is_mutable: false,
        offset: 0,
        param_count: param_count,
        return_type: 0,
        parent_id: -1
    )
    sym_id = symbol_alloc(symbols, sym)
    scope_add_symbol(scopes, 0, sym_id)
    pass2_index_symbol(0, name, sym_id)
    out sym_id
end.

func pass2_register_builtins(ref symbols: SymbolTable, ref scopes: ScopeTree):
    pass2_register_builtin_one(symbols, scopes, fat_str_new("len"), 1)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("push"), 2)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("alloc"), 1)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("dealloc"), 1)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("free"), 1)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("read_byte"), 2)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("read_u8"), 2)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("read8"), 2)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("native_read_u8"), 2)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("write_byte"), 3)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("write_u8"), 3)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("write8"), 3)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("native_write_u8"), 3)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("read_word"), 2)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("read_i64"), 2)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("read64"), 2)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("native_read_i64"), 2)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("write_word"), 3)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("write_i64"), 3)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("write64"), 3)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("native_write_i64"), 3)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("memset"), 3)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("fill_bytes"), 3)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("native_mem_set"), 3)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("memcpy"), 3)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("__memcpy"), 3)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("native_mem_copy"), 3)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("str_len"), 1)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("str_get"), 2)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("str_cat"), 2)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("str_concat"), 2)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("str_eq"), 2)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("file_open"), 2)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("native_file_open"), 2)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("file_read"), 3)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("native_file_read"), 3)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("file_write"), 3)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("native_file_write"), 3)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("file_close"), 1)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("native_file_close"), 1)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("file_write_byte"), 2)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("slurp_file"), 3)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("slurp_len"), 1)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("write_bytes"), 3)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("exit"), 1)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("exit_prog"), 1)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("i_to_str"), 1)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("int_to_str"), 1)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("str_to_i"), 1)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("str_to_int"), 1)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("arr_new"), 1)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("print"), 1)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("print_str"), 1)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("get_arg"), 1)
