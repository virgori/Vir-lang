    pass2_register_builtin_one(symbols, scopes, fat_str_new("arena_free"), 1)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("arena_reset"), 0)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("volatile_read"), 1)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("volatile_write"), 2)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("volatile_read8"), 1)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("volatile_write8"), 2)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("volatile_read16"), 1)
