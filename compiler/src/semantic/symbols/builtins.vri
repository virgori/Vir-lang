    pass2_register_builtin_one(symbols, scopes, fat_str_new("atomic_swap32"), 2)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("atomic_load64"), 1)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("atomic_store64"), 2)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("atomic_add64"), 2)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("atomic_sub64"), 2)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("atomic_cas64"), 3)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("atomic_exchange64"), 2)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("atomic_fence"), 0)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("atomic_swap64"), 2)
    # syscallN helpers
