##
 * compiler/src/semantic/symbols/walk.vri — AST Node Symbol Walking & Dispatch
 * ==========================================================================
 * VIRC-PLN-0004 & Phase 2: Symbol Registration Decomposition.
 *
 * Walks the top-level AST and registers functions, variables, constants,
 * modules, attributes, and nested extern declarations.
 ##

include vec_rt
include string_rt
include parser
include symbol_table
include scope_tree
include context
include symbols_context
include symbols_walk_types

# Walk a function body solely for nested `extern func` declarations.
func pass2_collect_nested_extern(ref symbols: SymbolTable, ref scopes: ScopeTree, diag: &DiagnosticEngine, node: &AstNode):
    if node.node_type == AstType.ExternFunc do
        if fat_str_len(node.name) > 0 do
            ex_pc = 0
            ex_children = vec_len_rt(node.children)
            var ex_i = 0
            when ex_i < ex_children loop
                ex_child = vec_get_rt(node.children, ex_i)
                if ex_child.node_type != AstType.Block do ex_pc = ex_pc + 1 end
                ex_i = ex_i + 1
            end
            curr_ex = scope_current_id(scopes)
            existed = pass2_lookup_name_in_scope(symbols, scopes, curr_ex, node.name)
            sym_id = pass2_register(symbols, scopes, diag, node.name, SymbolKind.Func, node.line)
            if existed == -1 and sym_id > 0 do
                syms_ex = native_read_i64(symbols as i64, 0)
                ex_sym = vec_get_rt(syms_ex, sym_id)
                native_write_i64(ex_sym as i64, 32, node as i64)
                native_write_i64(ex_sym as i64, 56, ex_pc)
            end
        end
        out 0
    end
    child_count = vec_len_rt(node.children)
    var i = 0
    when i < child_count loop
        child = vec_get_rt(node.children, i)
        pass2_collect_nested_extern(symbols, scopes, diag, child)
        i = i + 1
    end
    out 0
end.

func pass2_walk_node(ref symbols: SymbolTable, ref scopes: ScopeTree, diag: &DiagnosticEngine, node: &AstNode):
    var child = 0 as AstNode
    var child_count = 0

    if node.node_type == AstType.BindAttr do
        child_count = vec_len_rt(node.children)
        if child_count > 0 do
            child = vec_get_rt(node.children, 0)
            pass2_walk_node(symbols, scopes, diag, child)
        end
        out 0
    end

    if node.node_type == AstType.ModuleStmt do
        g_pass2_cur_module = node.name
        g_pass2_cur_module_sym_id = pass2_lookup_name_in_scope(symbols, scopes, 0, node.name)
        out 0
    end

    if node.node_type == AstType.FuncDef do
        # Children: params*, body Block, optional Ensure/Revert.
        child_count = vec_len_rt(node.children)
        body_idx = child_count - 1
        if body_idx < 0 do
            body_idx = 0
        end
        var bi = 0
        when bi < child_count loop
            ch = vec_get_rt(node.children, bi)
            if ch.node_type == AstType.Block do
                body_idx = bi
                bi = child_count
            else
                bi = bi + 1
            end
        end
        pc = body_idx
        if pc < 0 do
            pc = 0
        end
        if is_user_module(g_pass2_cur_module) == 1 and fat_cstr_eq(node.name, "main") == 0 do
            let qual_name = fat_str_concat(fat_str_concat(g_pass2_cur_module, fat_str_new(".")), node.name)
            sym_id = pass2_register(symbols, scopes, diag, qual_name, SymbolKind.Func, node.line)
            if sym_id > 0 do
                syms_vec = native_read_i64(symbols as i64, 0)
                sym = vec_get_rt(syms_vec, sym_id)
                native_write_i64(sym as i64, 32, node as i64)
                native_write_i64(sym as i64, 56, pc as i64)
                native_write_i64(sym as i64, 72, g_pass2_cur_module_sym_id as i64)
            end
        else
            sym_id = pass2_register(symbols, scopes, diag, node.name, SymbolKind.Func, node.line)
            if sym_id > 0 do
                syms_vec = native_read_i64(symbols as i64, 0)
                sym = vec_get_rt(syms_vec, sym_id)
                native_write_i64(sym as i64, 32, node as i64)
                native_write_i64(sym as i64, 56, pc as i64)
            end
        end
        # Only harvest nested `extern func` (do not promote body locals to globals).
        var j = body_idx
        when j < child_count loop
            pass2_collect_nested_extern(symbols, scopes, diag, vec_get_rt(node.children, j))
            j = j + 1
        end
        out 0
    end

    if pass2_walk_type_def(symbols, scopes, diag, node) == 1 do
        out 0
    end

    if node.node_type == AstType.VarDecl do
        if node.int_val == 16384 do
            child_count = vec_len_rt(node.children)
            if child_count > 1 do
                var i = 0
                when i < child_count - 1 loop
                    var_ident = vec_get_rt(node.children, i)
                    pass2_register(symbols, scopes, diag, var_ident.name, SymbolKind.Variable, var_ident.line)
                    i = i + 1
                end
            end
        else
            sid = pass2_register(symbols, scopes, diag, node.name, SymbolKind.Variable, node.line)
            if sid != -1 do
                syms_vec = native_read_i64(symbols as i64, 0)
                sym = vec_get_rt(syms_vec, sid)
                native_write_i64(sym as i64, 32, node as i64)
            end
        end
        out 0
    end

    if node.node_type == AstType.ReactiveDecl do
        if fat_str_len(node.name) > 0 do
            pass2_register(symbols, scopes, diag, node.name, SymbolKind.Variable, node.line)
        end
        out 0
    end

    if node.node_type == AstType.BundleExpr do
        if fat_str_len(node.name) > 0 do
            pass2_register(symbols, scopes, diag, node.name, SymbolKind.Const, node.line)
        end
        out 0
    end

    if node.node_type == AstType.ExposeAttr do
        child_count = vec_len_rt(node.children)
        if child_count > 0 do
            child = vec_get_rt(node.children, 0)
            pass2_walk_node(symbols, scopes, diag, child)
        end
        out 0
    end

    if node.node_type == AstType.ConstDecl do
        if node.int_val == 16384 do
            child_count = vec_len_rt(node.children)
            if child_count > 1 do
                var i = 0
                when i < child_count - 1 loop
                    var_ident = vec_get_rt(node.children, i)
                    pass2_register(symbols, scopes, diag, var_ident.name, SymbolKind.Const, var_ident.line)
                    i = i + 1
                end
            end
        else
            sid = pass2_register(symbols, scopes, diag, node.name, SymbolKind.Const, node.line)
            if sid != -1 do
                syms_vec = native_read_i64(symbols as i64, 0)
                sym = vec_get_rt(syms_vec, sid)
                native_write_i64(sym as i64, 32, node as i64)
            end
        end
        out 0
    end

    if node.node_type == AstType.VarDeclGroup do
        child_count = vec_len_rt(node.children)
        var vi = 0
        when vi < child_count loop
            child = vec_get_rt(node.children, vi)
            pass2_walk_node(symbols, scopes, diag, child)
            vi = vi + 1
        end
        out 0
    end

    if node.node_type == AstType.ExternFunc do
        if fat_str_len(node.name) > 0 do
            # Extern declarations carry a complete signature. Count only
            # parameter children; parse_func_def_mode appends an empty Block.
            ex_pc = 0
            ex_children = vec_len_rt(node.children)
            var ex_i = 0
            when ex_i < ex_children loop
                ex_child = vec_get_rt(node.children, ex_i)
                if ex_child.node_type != AstType.Block do ex_pc = ex_pc + 1 end
                ex_i = ex_i + 1
            end
            curr_ex = scope_current_id(scopes)
            existed = pass2_lookup_name_in_scope(symbols, scopes, curr_ex, node.name)
            sym_id = pass2_register(symbols, scopes, diag, node.name, SymbolKind.Func, node.line)
            if existed == -1 and sym_id > 0 do
                syms_ex = native_read_i64(symbols as i64, 0)
                ex_sym = vec_get_rt(syms_ex, sym_id)
                native_write_i64(ex_sym as i64, 32, node as i64)
                native_write_i64(ex_sym as i64, 56, ex_pc)
            end
        end
        out 0
    end

    if node.node_type == AstType.ShareDecl or node.node_type == AstType.HasDecl do
        if fat_str_len(node.name) > 0 do
            pass2_register(symbols, scopes, diag, node.name, SymbolKind.Variable, node.line)
        end
        out 0
    end

    # Recurse into block/program children
    child_count = vec_len_rt(node.children)
    var i = 0
    when i < child_count loop
        child = vec_get_rt(node.children, i)
        pass2_walk_node(symbols, scopes, diag, child)
        i = i + 1
    end
    out 0
end.
