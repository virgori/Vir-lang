##
 * compiler/src/semantic/symbols/context.vri — Symbol Table Context & Scopes
 * =========================================================================
 * VIRC-PLN-0004 & Phase 2: Symbol Registration Decomposition.
 *
 * Owns Pass 2 per-scope hash buckets, type name collection, user module
 * detection, scope lookups, and symbol allocation/registration.
 ##

include vec_rt
include string_rt
include parser
include symbol_table
include scope_tree
include context

# Per-scope name → sym_id hash (avg O(1) insert/lookup). Avoids O(n²)
# fat_str_eq scans when registering N symbols into the same scope.
const PASS2_BUCKETS: int = 256
var g_pass2_scope_maps: i64 = 0
var g_pass2_type_names: i64 = 0
var g_pass2_cur_module: string = ""
var g_pass2_cur_module_sym_id: int = -1

func is_user_module(name: string) -> int:
    let s = name as int
    if s == 0 do out 0 end
    let slen = native_read_i64(s, 8) as int
    if slen == 0 do out 0 end
    let cstr_ptr = native_read_i64(s, 0) as int
    if cstr_ptr == 0 do out 0 end
    if slen == 4 and native_read_u8(cstr_ptr, 0) == 114 and native_read_u8(cstr_ptr, 1) == 111 and native_read_u8(cstr_ptr, 2) == 111 and native_read_u8(cstr_ptr, 3) == 116 do
        out 0
    end
    if slen >= 4 and native_read_u8(cstr_ptr, 0) == 118 and native_read_u8(cstr_ptr, 1) == 105 and native_read_u8(cstr_ptr, 2) == 114 and native_read_u8(cstr_ptr, 3) == 46 do
        out 0
    end
    out 1
end.

func pass2_collect_type_names(node: &AstNode):
    if node.node_type == AstType.EntityDef or node.node_type == AstType.PackedDef or node.node_type == AstType.RegisterDef or node.node_type == AstType.ClassDef or node.node_type == AstType.TypeAlias do
        g_pass2_type_names = vec_push_rt(g_pass2_type_names, node.name as i64)
        out 0
    end
    var i = 0
    when i < vec_len_rt(node.children) loop
        pass2_collect_type_names(vec_get_rt(node.children, i))
        i = i + 1
    end
    out 0
end.

func pass2_is_type_name(name: &string):
    var i = 0
    when i < vec_len_rt(g_pass2_type_names) loop
        if fat_str_eq(vec_get_rt(g_pass2_type_names, i) as string, name as string) == 1 do out true end
        i = i + 1
    end
    out false
end.

func pass2_hash_name(name: &string):
    n = fat_str_len(name as string)
    h = n * 17
    var i = 0
    when i < n loop
        h = h * 131 + fat_str_byte_at(name as string, i)
        i = i + 1
    end
    if h < 0 do
        h = 0 - h
    end
    out h mod PASS2_BUCKETS
end.

func pass2_maps_reset():
    g_pass2_scope_maps = vec_new_rt()
end.

func pass2_scope_map_new():
    buckets = vec_new_rt()
    var bi = 0
    when bi < PASS2_BUCKETS loop
        buckets = vec_push_rt(buckets, vec_new_rt())
        bi = bi + 1
    end
    out buckets
end.

func pass2_ensure_scope_map(scope_id: int):
    if g_pass2_scope_maps == 0 do
        pass2_maps_reset()
    end
    when vec_len_rt(g_pass2_scope_maps) <= scope_id loop
        g_pass2_scope_maps = vec_push_rt(g_pass2_scope_maps, pass2_scope_map_new())
    end
end.

func pass2_index_symbol(scope_id: int, name: &string, sym_id: int):
    if fat_str_len(name as string) == 0 do
        out 0
    end
    pass2_ensure_scope_map(scope_id)
    buckets = vec_get_rt(g_pass2_scope_maps, scope_id)
    bid = pass2_hash_name(name)
    bucket = vec_get_rt(buckets, bid)
    bucket = vec_push_rt(bucket, sym_id)
    vec_set_rt(buckets, bid, bucket)
    out 0
end.

func pass2_lookup_name_in_scope(ref symbols: SymbolTable, ref scopes: ScopeTree, scope_id: int, name: &string):
    if fat_str_len(name as string) == 0 do
        out -1
    end
    pass2_ensure_scope_map(scope_id)
    buckets = vec_get_rt(g_pass2_scope_maps, scope_id)
    bid = pass2_hash_name(name)
    bucket = vec_get_rt(buckets, bid)
    count = vec_len_rt(bucket)
    syms_vec = native_read_i64(symbols as i64, 0)
    var i = 0
    when i < count loop
        sym_id = vec_get_rt(bucket, i)
        sym = vec_get_rt(syms_vec, sym_id)
        sym_name = native_read_i64(sym as i64, 8) as string
        if fat_str_eq(sym_name, name) == 1 do
            out sym_id
        end
        i = i + 1
    end
    out -1
end.

func pass2_register(ref symbols: SymbolTable, ref scopes: ScopeTree, diag: &DiagnosticEngine, name: &string, kind: SymbolKind, line: int):
    if fat_str_len(name) == 0 do
        out 0
    end
    curr_scope = scope_current_id(scopes)
    # Check redefinition in current scope (hash bucket — avg O(1))
    found = pass2_lookup_name_in_scope(symbols, scopes, curr_scope, name)
    if found != -1 do
        syms_vec = native_read_i64(symbols as i64, 0)
        old_sym = vec_get_rt(syms_vec, found)
        old_kind = native_read_i64(old_sym as i64, 0)
        if old_kind == SymbolKind.Builtin do
            # User/extern definition replaces builtin kind; keep arity.
            native_write_i64(old_sym as i64, 0, kind as i64)
            out found
        end
        # Expanded/multi-include: identical redeclare is idempotent (extern+func,
        # duplicate consts across modules) at global/module scope (curr_scope == 0).
        # In local scopes (curr_scope > 0), same-scope redefinition is an error.
        if curr_scope == 0 and old_kind == kind do
            out found
        end
        if curr_scope == 0 and old_kind == SymbolKind.Func and kind == SymbolKind.Func do
            out found
        end
        report_error(diag, 1001, line, 0)
        out found
    end
    # Create and register symbol
    sym = SymbolNode (
        kind: kind,
        name_id: name as i64,
        type_id: 0,
        scope_id: curr_scope,
        ast_id: 0,
        is_mutable: kind == SymbolKind.Variable,
        offset: 0,
        param_count: 0,
        return_type: 0,
        parent_id: -1
    )
    sym_id = symbol_alloc(symbols, sym)
    scope_add_symbol(scopes, curr_scope, sym_id)
    pass2_index_symbol(curr_scope, name, sym_id)
    out sym_id
end.
