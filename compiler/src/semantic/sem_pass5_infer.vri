##
 * vir/compiler/sem_pass5_infer.vri
 * ==============================================================
 * Pass 5: Type Inference Orchestrator (Vir v2.0 Complete).
 * Infers types for variables without explicit annotations,
 * array/tuple literals, interpolated strings, method calls, and references.
 ##

include vec_rt
include string_rt
include parser
include symbol_table
include scope_tree
include type_table
include ide_facts
include infer_context
include infer_calls
include infer_expr
include infer_walk

func pass5_infer_types(ref symbols: SymbolTable, ref scopes: ScopeTree, node: &AstNode):
    pass5_rebuild_index(symbols, scopes)
    pass5_walk(symbols, scopes, node)
end.

export pass5_infer_types, pass5_infer_expr
