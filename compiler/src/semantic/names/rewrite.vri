##
 * vir/compiler/semantic/names/rewrite.vri
 * ==============================================================
 * Pass 3: AST Variant Rewrite.
 * Rewrites identifier/call nodes into EnumConstruct variants.
 ##

include vec_rt
include string_rt
include parser
include symbol_table

func pass3_rewrite_variant(node: &AstNode, sym: &SymbolNode, syms_vec: i64):
    node_ptr = node as i64
    saved_name = native_read_i64(node_ptr, 0)
    saved_op = native_read_i64(node_ptr, 24)
    saved_line = native_read_i64(node_ptr, 32)
    saved_float = native_read_i64(node_ptr, 48)
    saved_children = native_read_i64(node_ptr, 64)
    sym_ptr = sym as i64
    variant_ast = native_read_i64(sym_ptr, 32)
    variant_tag = native_read_i64(variant_ast, 40)
    variant_arity = native_read_i64(sym_ptr, 56)
    parent_id = native_read_i64(sym_ptr, 72)
    enum_name = fat_str_new("")
    if parent_id >= 0 do
        parent = vec_get_rt(syms_vec, parent_id)
        enum_name = native_read_i64(parent as i64, 8) as string
    end
    # No calls after this point: publish the complete AST rewrite atomically
    # with respect to the bootstrap aggregate-return ABI.
    native_write_i64(node_ptr, 0, saved_name)
    native_write_i64(node_ptr, 8, enum_name as i64)
    native_write_i64(node_ptr, 16, AstType.EnumConstruct as i64)
    native_write_i64(node_ptr, 24, saved_op)
    native_write_i64(node_ptr, 32, saved_line)
    native_write_i64(node_ptr, 40, variant_tag)
    native_write_i64(node_ptr, 48, saved_float)
    native_write_i64(node_ptr, 56, variant_arity)
    native_write_i64(node_ptr, 64, saved_children)
    out 0
end.

export pass3_rewrite_variant
