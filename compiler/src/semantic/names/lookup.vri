##
 * vir/compiler/semantic/names/lookup.vri
 * ==============================================================
 * Pass 3: Name Lookup & Scope Search.
 * Lookups across global index, parent scope chain, and scope-exact queries.
 ##

include vec_rt
include string_rt
include symbol_table
include scope_tree
include names_context

func pass3_lookup_global(ref symbols: SymbolTable, ref scopes: ScopeTree, name: &string):
    if fat_str_len(name) == 0 do
        out -1
    end
    scopes_vec = native_read_i64(scopes as i64, 0)
    global_scope = vec_get_rt(scopes_vec, 0)
    global_syms = native_read_i64(global_scope as i64, 16)
    syms_vec = native_read_i64(symbols as i64, 0)

    if g_pass3_global_heads != 0 and g_pass3_global_next != 0 do
        bucket = pass3_name_bucket(name)
        link = native_read_i64(g_pass3_global_heads, bucket * 8)
        when link > 0 loop
            pos = link - 1
            sym_id = vec_get_rt(global_syms, pos)
            sym = vec_get_rt(syms_vec, sym_id)
            sym_name = native_read_i64(sym as i64, 8) as string
            if fat_str_eq(sym_name, name) == 1 do
                out sym_id
            end
            link = native_read_i64(g_pass3_global_next, pos * 8)
        end
    end

    # Normally empty: declarations handled by pass 2 are already indexed.
    # Preserve correctness for a declaration kind added by pass 3 itself.
    count = vec_len_rt(global_syms)
    var i = g_pass3_global_indexed_count
    when i < count loop
        sym_id = vec_get_rt(global_syms, i)
        sym = vec_get_rt(syms_vec, sym_id)
        sym_name = native_read_i64(sym as i64, 8) as string
        if fat_str_eq(sym_name, name) == 1 do
            out sym_id
        end
        i = i + 1
    end

    let s_ptr = name as int
    if s_ptr != 0 do
        let c_len = native_read_i64(s_ptr, 8) as int
        let c_cstr = native_read_i64(s_ptr, 0) as int
        if c_len > 0 and c_cstr != 0 do
            var found_id = -1
            var match_count = 0
            var si = 0
            when si < count loop
                let s_id = vec_get_rt(global_syms, si)
                let s_obj = vec_get_rt(syms_vec, s_id)
                let sym_ptr = native_read_i64(s_obj as i64, 8) as int
                if sym_ptr != 0 do
                    let s_len = native_read_i64(sym_ptr, 8) as int
                    let s_cstr = native_read_i64(sym_ptr, 0) as int
                    if s_len > c_len + 1 and s_cstr != 0 do
                        if native_read_u8(s_cstr, s_len - c_len - 1) == 46 do
                            var match = 1
                            var ci = 0
                            when ci < c_len loop
                                if native_read_u8(s_cstr, s_len - c_len + ci) != native_read_u8(c_cstr, ci) do
                                    match = 0
                                end
                                ci = ci + 1
                            end
                            if match == 1 do
                                match_count = match_count + 1
                                found_id = s_id
                            end
                        end
                    end
                end
                si = si + 1
            end
            if match_count == 1 do
                out found_id
            end
        end
    end

    out -1
end.

func pass3_lookup_chain(ref symbols: SymbolTable, ref scopes: ScopeTree, start_scope: int, name: &string):
    if fat_str_len(name) == 0 do
        out -1
    end
    curr = start_scope
    scopes_vec = native_read_i64(scopes as i64, 0)
    syms_vec = native_read_i64(symbols as i64, 0)
    when curr >= 0 loop
        if curr == 0 do
            out pass3_lookup_global(symbols, scopes, name)
        end
        scope_node = vec_get_rt(scopes_vec, curr)
        sym_list = native_read_i64(scope_node as i64, 16)
        count = vec_len_rt(sym_list)
        var i = 0
        when i < count loop
            sym_id = vec_get_rt(sym_list, i)
            sym = vec_get_rt(syms_vec, sym_id)
            sym_name = native_read_i64(sym as i64, 8) as string
            if fat_str_eq(sym_name, name) == 1 do
                out sym_id
            end
            i = i + 1
        end
        curr = native_read_i64(scope_node as i64, 8)
    end
    out -1
end.

func pass3_lookup_in_scope_exact(ref symbols: SymbolTable, ref scopes: ScopeTree, scope_id: int, name: &string):
    if fat_str_len(name) == 0 do
        out -1
    end
    if scope_id <= 0 do
        out -1
    end
    scopes_vec = native_read_i64(scopes as i64, 0)
    syms_vec = native_read_i64(symbols as i64, 0)
    scope_node = vec_get_rt(scopes_vec, scope_id)
    sym_list = native_read_i64(scope_node as i64, 16)
    count = vec_len_rt(sym_list)
    var i = 0
    when i < count loop
        sym_id = vec_get_rt(sym_list, i)
        sym = vec_get_rt(syms_vec, sym_id)
        sym_name = native_read_i64(sym as i64, 8) as string
        if fat_str_eq(sym_name, name) == 1 do
            out sym_id
        end
        i = i + 1
    end
    out -1
end.

func pass3_enclosing_func_scope(ref scopes: ScopeTree, curr_scope: int):
    if curr_scope <= 0 do
        out curr_scope
    end
    scopes_vec = native_read_i64(scopes as i64, 0)
    var s = curr_scope
    when s > 0 loop
        scope_node = vec_get_rt(scopes_vec, s)
        skind = native_read_i64(scope_node as i64, 0)
        if skind == ScopeKind.Func do
            out s
        end
        s = native_read_i64(scope_node as i64, 8)
    end
    out curr_scope
end.

export pass3_lookup_global, pass3_lookup_chain, pass3_lookup_in_scope_exact, pass3_enclosing_func_scope
