##
 * vir/compiler/semantic/names/walk_expr.vri
 * ==============================================================
 * Pass 3: Expression Name Resolution.
 * Resolves identifiers, function calls, method calls (UFCS / enum variants),
 * builtin calls, entity literals, field accesses, and enum accesses.
 ##

include vec_rt
include string_rt
include parser
include symbol_table
include scope_tree
include context
include ide_facts
include names_context
include names_lookup
include names_register
include names_rewrite

func pass3_walk_expr(ref symbols: SymbolTable, ref scopes: ScopeTree, diag: &DiagnosticEngine, node: &AstNode):
    if node.node_type == AstType.Identifier do
        saved_node_ptr = node as i64
        saved_node_name = native_read_i64(saved_node_ptr, 0)
        saved_node_name2 = native_read_i64(saved_node_ptr, 8)
        saved_node_type = native_read_i64(saved_node_ptr, 16)
        saved_node_op = native_read_i64(saved_node_ptr, 24)
        saved_node_line = native_read_i64(saved_node_ptr, 32)
        saved_node_int = native_read_i64(saved_node_ptr, 40)
        saved_node_float = native_read_i64(saved_node_ptr, 48)
        saved_node_bid = native_read_i64(saved_node_ptr, 56)
        saved_node_children = native_read_i64(saved_node_ptr, 64)
        saved_node_span = native_read_i64(saved_node_ptr, 72)
        nm = saved_node_name
        if fat_cstr_eq(nm, "null") or fat_cstr_eq(nm, "void") or fat_cstr_eq(nm, "true") or fat_cstr_eq(nm, "false") do
            out 1
        end
        found = pass3_lookup_chain(symbols, scopes, scope_current_id(scopes), saved_node_name as string)
        ideFactResolve(saved_node_ptr, found, scope_current_id(scopes), 2)
        if found == -1 do
            # `this` in a method body: register if the parser used ThisKw.
            if fat_cstr_eq(nm, "this") == 1 do
                pass3_register_local(symbols, scopes, fat_str_new("this"), SymbolKind.Param, node.line)
            else
                if saved_node_span > 0 do
                    report_error_span(diag, 2001, saved_node_span, "")
                else
                    var col = saved_node_int
                    if col <= 0 do col = 1 end
                    report_error_loc(diag, 2001, 0, node.line, col, "")
                end
            end
        else
            syms_vec = native_read_i64(symbols as i64, 0)
            sym = vec_get_rt(syms_vec, found) as SymbolNode
            if sym.kind == SymbolKind.Variant do
                let variant_parent_id = native_read_i64(sym as i64, 72)
                native_write_i64(saved_node_ptr, 0, saved_node_name)
                native_write_i64(saved_node_ptr, 8, saved_node_name2)
                native_write_i64(saved_node_ptr, 16, saved_node_type)
                native_write_i64(saved_node_ptr, 24, saved_node_op)
                native_write_i64(saved_node_ptr, 32, saved_node_line)
                native_write_i64(saved_node_ptr, 40, saved_node_int)
                native_write_i64(saved_node_ptr, 48, saved_node_float)
                native_write_i64(saved_node_ptr, 56, saved_node_bid)
                native_write_i64(saved_node_ptr, 64, saved_node_children)
                pass3_rewrite_variant(node, sym, syms_vec)
                native_write_i64(saved_node_ptr, 32, saved_node_line)
                native_write_i64(saved_node_ptr, 64, saved_node_children)
                if variant_parent_id == 0 - 2 do
                    report_error(diag, 3038, node.line, 0)
                else
                    native_write_i64(saved_node_ptr, 0, saved_node_name)
                    native_write_i64(saved_node_ptr, 8, saved_node_name2)
                    native_write_i64(saved_node_ptr, 16, saved_node_type)
                    native_write_i64(saved_node_ptr, 24, saved_node_op)
                    native_write_i64(saved_node_ptr, 32, saved_node_line)
                    native_write_i64(saved_node_ptr, 40, saved_node_int)
                    native_write_i64(saved_node_ptr, 48, saved_node_float)
                    native_write_i64(saved_node_ptr, 56, saved_node_bid)
                    native_write_i64(saved_node_ptr, 64, saved_node_children)
                    pass3_rewrite_variant(node, sym, syms_vec)
                    native_write_i64(saved_node_ptr, 32, saved_node_line)
                    native_write_i64(saved_node_ptr, 64, saved_node_children)
                end
            end
        end
        out 1
    end

    if node.node_type == AstType.BuiltinCall do
        # Parser already bound builtin_id; do not require a symbol name
        # (ast_add_child can clobber .name on the soft ABI).
        child_count = vec_len_rt(node.children)
        var i = 0
        when i < child_count loop
            child = vec_get_rt(node.children, i)
            pass3_walk(symbols, scopes, diag, child)
            i = i + 1
        end
        out 1
    end

    if node.node_type == AstType.Call do
        saved_node_ptr = node as i64
        saved_node_name = native_read_i64(saved_node_ptr, 0)
        saved_node_name2 = native_read_i64(saved_node_ptr, 8)
        saved_node_type = native_read_i64(saved_node_ptr, 16)
        saved_node_op = native_read_i64(saved_node_ptr, 24)
        saved_node_line = native_read_i64(saved_node_ptr, 32)
        saved_node_int = native_read_i64(saved_node_ptr, 40)
        saved_node_float = native_read_i64(saved_node_ptr, 48)
        saved_node_bid = native_read_i64(saved_node_ptr, 56)
        saved_node_children = native_read_i64(saved_node_ptr, 64)
        found = pass3_lookup_chain(symbols, scopes, scope_current_id(scopes), node.name)
        ideFactResolve(saved_node_ptr, found, scope_current_id(scopes), 4)
        if found == -1 and pass3_is_soft_call_name(node.name) == 0 do
            report_error_info(diag, 2002, node.line, 0, node.name)
        eif found != -1 do
            syms_vec = native_read_i64(symbols as i64, 0)
            sym = vec_get_rt(syms_vec, found) as SymbolNode
            if sym.kind == SymbolKind.Variant do
                let variant_parent_id = native_read_i64(sym as i64, 72)
                native_write_i64(saved_node_ptr, 0, saved_node_name)
                native_write_i64(saved_node_ptr, 8, saved_node_name2)
                native_write_i64(saved_node_ptr, 16, saved_node_type)
                native_write_i64(saved_node_ptr, 24, saved_node_op)
                native_write_i64(saved_node_ptr, 32, saved_node_line)
                native_write_i64(saved_node_ptr, 40, saved_node_int)
                native_write_i64(saved_node_ptr, 48, saved_node_float)
                native_write_i64(saved_node_ptr, 56, saved_node_bid)
                native_write_i64(saved_node_ptr, 64, saved_node_children)
                pass3_rewrite_variant(node, sym, syms_vec)
                native_write_i64(saved_node_ptr, 32, saved_node_line)
                native_write_i64(saved_node_ptr, 64, saved_node_children)
                if variant_parent_id == 0 - 2 do
                    report_error(diag, 3038, node.line, 0)
                else
                    native_write_i64(saved_node_ptr, 0, saved_node_name)
                    native_write_i64(saved_node_ptr, 8, saved_node_name2)
                    native_write_i64(saved_node_ptr, 16, saved_node_type)
                    native_write_i64(saved_node_ptr, 24, saved_node_op)
                    native_write_i64(saved_node_ptr, 32, saved_node_line)
                    native_write_i64(saved_node_ptr, 40, saved_node_int)
                    native_write_i64(saved_node_ptr, 48, saved_node_float)
                    native_write_i64(saved_node_ptr, 56, saved_node_bid)
                    native_write_i64(saved_node_ptr, 64, saved_node_children)
                    pass3_rewrite_variant(node, sym, syms_vec)
                    native_write_i64(saved_node_ptr, 32, saved_node_line)
                    native_write_i64(saved_node_ptr, 64, saved_node_children)
                end
            end
        end
        # Resolve arguments
        child_count = vec_len_rt(node.children)
        var i = 0
        when i < child_count loop
            child = vec_get_rt(node.children, i)
            pass3_walk(symbols, scopes, diag, child)
            i = i + 1
        end
        out 1
    end

    if node.node_type == AstType.MethodCall do
        # `Enum.Variant(args...)` reaches the parser as MethodCall.  Resolve it
        # against the receiver enum before applying ordinary UFCS semantics,
        # and remove the synthetic receiver from the constructor payload list.
        node_ptr = node as i64
        saved_name = native_read_i64(node_ptr, 0)
        saved_op = native_read_i64(node_ptr, 24)
        saved_line = native_read_i64(node_ptr, 32)
        saved_float = native_read_i64(node_ptr, 48)
        original_children = native_read_i64(node_ptr, 64)
        child_count = vec_len_rt(original_children)
        if child_count > 0 do
            receiver = vec_get_rt(original_children, 0) as AstNode
            if receiver.node_type == AstType.Identifier do
                receiver_name = native_read_i64(receiver as i64, 0) as string
                receiver_name = pass3_resolve_import_alias(receiver_name)
                enum_found = pass3_lookup_chain(symbols, scopes, scope_current_id(scopes), receiver_name)
                if enum_found == -1 do
                    enum_found = pass3_lookup_chain(symbols, scopes, 0, receiver_name)
                end
                if enum_found >= 0 do
                    syms_vec = native_read_i64(symbols as i64, 0)
                    enum_sym = vec_get_rt(syms_vec, enum_found) as SymbolNode
                    if enum_sym.kind == SymbolKind.Enum do
                        enum_ast = enum_sym.ast_id as AstNode
                        var vi = 0
                        when vi < vec_len_rt(enum_ast.children) loop
                            variant_ast = vec_get_rt(enum_ast.children, vi) as AstNode
                            variant_name = native_read_i64(variant_ast as i64, 0) as string
                            if fat_str_eq(variant_name, saved_name as string) == 1 do
                                if g_ideFactsEnabled == 1 do
                                    ideFactResolve(receiver as int, enum_found, scope_current_id(scopes), 5)
                                    ideFactType(receiver as int, 6)
                                    ideFactResolvedType(receiver as int, enum_found)
                                    let variantFact = ideFactFind(variant_ast as int)
                                    if variantFact != 0 do
                                        ideFactResolve(node_ptr, native_read_i64(variantFact, 8), scope_current_id(scopes), 4)
                                        ideFactType(node_ptr, 6)
                                        ideFactResolvedType(node_ptr, enum_found)
                                    end
                                end
                                variant_tag = native_read_i64(variant_ast as i64, 40)
                                variant_children = native_read_i64(variant_ast as i64, 64)
                                variant_arity = vec_len_rt(variant_children)
                                # Keep the parser's receiver child in the internal AST.
                                # Rebuilding this vector here triggers the bootstrap
                                # compiler's aggregate-return clobber bug.  Lowering
                                # recognizes and skips this one synthetic child.
                                var ri = 1
                                when ri < child_count loop
                                    payload_child = vec_get_rt(original_children, ri)
                                    pass3_walk(symbols, scopes, diag, payload_child)
                                    ri = ri + 1
                                end
                                # Restore/write raw words after nested calls.  This is
                                # the same soft-ABI discipline used by ast_add_child.
                                native_write_i64(node_ptr, 0, saved_name)
                                native_write_i64(node_ptr, 8, receiver_name as i64)
                                native_write_i64(node_ptr, 16, AstType.EnumConstruct as i64)
                                native_write_i64(node_ptr, 24, saved_op)
                                native_write_i64(node_ptr, 32, saved_line)
                                native_write_i64(node_ptr, 40, variant_tag)
                                native_write_i64(node_ptr, 48, saved_float)
                                native_write_i64(node_ptr, 56, variant_arity)
                                native_write_i64(node_ptr, 64, original_children)
                                out 1
                            end
                            vi = vi + 1
                        end
                    end
                end
            end
        end
        # UFCS / Callable field: receiver is children[0]. Missing free function
        # is allowed because callable record fields lower dynamically.
        found = pass3_lookup_chain(symbols, scopes, scope_current_id(scopes), node.name)
        if found == -1 do
            found = pass3_lookup_chain(symbols, scopes, 0, node.name)
        end
        child_count = vec_len_rt(node.children)
        if child_count > 0 do
            receiver = vec_get_rt(node.children, 0)
            pass3_walk(symbols, scopes, diag, receiver)
        end
        # Resolve method arguments
        var i = 1
        when i < child_count loop
            child = vec_get_rt(node.children, i)
            pass3_walk(symbols, scopes, diag, child)
            i = i + 1
        end
        out 1
    end

    if node.node_type == AstType.EntityLiteral do
        let typeId = pass3_lookup_chain(symbols, scopes, scope_current_id(scopes), node.name)
        ideFactResolve(node as int, typeId, scope_current_id(scopes), 5)
        child_count = vec_len_rt(node.children)
        var i = 0
        when i < child_count loop
            child = vec_get_rt(node.children, i)
            pass3_walk(symbols, scopes, diag, child)
            i = i + 1
        end
        out 1
    end

    if node.node_type == AstType.FieldAccess do
        child_count = vec_len_rt(node.children)
        var i = 0
        when i < child_count loop
            child = vec_get_rt(node.children, i)
            pass3_walk(symbols, scopes, diag, child)
            i = i + 1
        end
        out 1
    end

    if node.node_type == AstType.EnumAccess do
        found = pass3_lookup_chain(symbols, scopes, scope_current_id(scopes), node.name)
        if found == -1 do
            # Could be a qualified lookup, we try to resolve parts if needed
            # But for simplicity, logging it if totally not found globally
            report_error(diag, 1005, node.line, 0)
        end
        out 1
    end

    out 0
end.

export pass3_walk_expr
