##
 * vir/compiler/semantic/names/context.vri
 * ==============================================================
 * Pass 3: Name Resolution Context & Global Index.
 * Hash buckets for global symbol index, import aliases, and builtin predicates.
 ##

include vec_rt
include string_rt
include symbol_table
include scope_tree
include alloc

const PASS3_GLOBAL_BUCKETS: int = 4096
const PASS3_GLOBAL_BUCKET_MASK: int = 4095
var g_pass3_global_heads: i64 = 0
var g_pass3_global_next: i64 = 0
var g_pass3_global_indexed_count: i64 = 0
var g_pass3_import_aliases: i64 = 0
var g_pass3_import_targets: i64 = 0

func pass3_resolve_import_alias(name: &string):
    if g_pass3_import_aliases == 0 or fat_str_len(name) == 0 do out name end
    var i = 0
    let n = vec_len_rt(g_pass3_import_aliases)
    when i < n loop
        al = vec_get_rt(g_pass3_import_aliases, i) as string
        if fat_str_eq(al, name) == 1 do
            out vec_get_rt(g_pass3_import_targets, i) as string
        end
        i = i + 1
    end
    out name
end.

func pass3_name_bucket(name: &string):
    n = fat_str_len(name)
    if n <= 0 do
        out 0
    end
    data = native_read_i64(name as i64, 0)
    h = n and PASS3_GLOBAL_BUCKET_MASK
    var i = 0
    when i < n loop
        h = (h * 131 + native_read_u8(data, i)) and PASS3_GLOBAL_BUCKET_MASK
        i = i + 1
    end
    out h
end.

func pass3_build_global_index(ref symbols: SymbolTable, ref scopes: ScopeTree):
    if g_pass3_global_heads == 0 do
        g_pass3_global_heads = vir_alloc(PASS3_GLOBAL_BUCKETS * 8)
    end

    var i = 0
    when i < PASS3_GLOBAL_BUCKETS loop
        native_write_i64(g_pass3_global_heads, i * 8, 0)
        i = i + 1
    end

    scopes_vec = native_read_i64(scopes as i64, 0)
    global_scope = vec_get_rt(scopes_vec, 0)
    global_syms = native_read_i64(global_scope as i64, 16)
    count = vec_len_rt(global_syms)
    # semantic_run invokes pass 3 once.  Allocate the exact chain array for
    # that snapshot; symbols added later use the small linear tail fallback.
    if count > 0 do
        g_pass3_global_next = vir_alloc(count * 8)
    else
        g_pass3_global_next = 0
    end
    g_pass3_global_indexed_count = count

    syms_vec = native_read_i64(symbols as i64, 0)
    i = 0
    when i < count loop
        sym_id = vec_get_rt(global_syms, i)
        sym = vec_get_rt(syms_vec, sym_id)
        sym_name = native_read_i64(sym as i64, 8) as string
        bucket = pass3_name_bucket(sym_name)
        head = native_read_i64(g_pass3_global_heads, bucket * 8)
        native_write_i64(g_pass3_global_next, i * 8, head)
        native_write_i64(g_pass3_global_heads, bucket * 8, i + 1)
        i = i + 1
    end
end.

func is_builtin_method_name(name: i64):
    if name == 0 do out 0 end
    if fat_cstr_eq(name, "send") or fat_cstr_eq(name, "recv") or fat_cstr_eq(name, "push") or fat_cstr_eq(name, "pop") or fat_cstr_eq(name, "len") do out 1 end
    if rt_streq(name as int, "send") or rt_streq(name as int, "recv") or rt_streq(name as int, "push") or rt_streq(name as int, "pop") or rt_streq(name as int, "len") do out 1 end
    out 0
end.

func pass3_is_soft_call_name(name: &string):
    if fat_str_len(name) == 0 do
        out 0
    end
    nm = name as i64
    if fat_str_len(name) >= 7 do
        data = native_read_i64(nm, 0)
        if native_read_u8(data, 0) == 110 and native_read_u8(data, 1) == 97 and native_read_u8(data, 2) == 116 and native_read_u8(data, 3) == 105 and native_read_u8(data, 4) == 118 and native_read_u8(data, 5) == 101 and native_read_u8(data, 6) == 95 do
            out 1
        end
    end
    if fat_cstr_eq(nm, "panic") or fat_cstr_eq(nm, "free") or fat_cstr_eq(nm, "realloc") or fat_cstr_eq(nm, "size_of") or fat_cstr_eq(nm, "alloc") or fat_cstr_eq(nm, "min") or fat_cstr_eq(nm, "max") or fat_cstr_eq(nm, "to_string") or fat_cstr_eq(nm, "utf8_decode_char") or fat_cstr_eq(nm, "vec_set_at") or fat_cstr_eq(nm, "str_from_i64") or fat_cstr_eq(nm, "codebuf_get_data") or fat_cstr_eq(nm, "read_u32") or fat_cstr_eq(nm, "patch_u32") or fat_cstr_eq(nm, "patch_i32") or fat_cstr_eq(nm, "eprintln") or fat_cstr_eq(nm, "read") or fat_cstr_eq(nm, "write") or fat_cstr_eq(nm, "_next_pow2") or fat_cstr_eq(nm, "alloc_zeroed") or fat_cstr_eq(nm, "float_to_bits") or fat_cstr_eq(nm, "wf_emit_sleb128") or fat_cstr_eq(nm, "map_set") or fat_cstr_eq(nm, "write_bytes_to_file") or fat_cstr_eq(nm, "flux") or fat_cstr_eq(nm, "flux_splat") or fat_cstr_eq(nm, "flux_dot") or fat_cstr_eq(nm, "flux_norm") do
        out 1
    end
    out 0
end.

export PASS3_GLOBAL_BUCKETS, PASS3_GLOBAL_BUCKET_MASK
export g_pass3_global_heads, g_pass3_global_next, g_pass3_global_indexed_count
export g_pass3_import_aliases, g_pass3_import_targets
export pass3_resolve_import_alias, pass3_name_bucket, pass3_build_global_index
export is_builtin_method_name, pass3_is_soft_call_name
