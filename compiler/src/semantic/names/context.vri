##
 * vir/compiler/semantic/names/context.vri
 * ==============================================================
 * Pass 3: Name Resolution Context & Global Index.
 * Hash buckets for global symbol index, import aliases, and builtin predicates.
 ##

include rt_vec_rt
include rt_string_rt
include symbol_table
include scope_tree
include rt_alloc
import g_active_source_manager, sm_file_from_line, sm_get_file_path, sm_get_span from source_manager

const PASS3_GLOBAL_BUCKETS: int = 4096
const PASS3_GLOBAL_BUCKET_MASK: int = 4095
var g_pass3_global_heads: i64 = 0
var g_pass3_global_next: i64 = 0
var g_pass3_global_indexed_count: i64 = 0
var g_pass3_import_aliases: i64 = 0
var g_pass3_import_targets: i64 = 0
var g_import_visibility_modules: i64 = 0
var g_import_visibility_bindings: i64 = 0
var g_import_visibility_include_edges: i64 = 0
var g_import_visibility_public_includes: i64 = 0
var g_import_visibility_module_identities: i64 = 0

var g_module_exports_modules: i64 = 0
var g_module_exports_symbols: i64 = 0
var g_module_aliases_from: i64 = 0
var g_module_aliases_to: i64 = 0
var g_consumer_deps_files: i64 = 0
var g_consumer_deps_modules: i64 = 0
var g_consumer_deps_kinds: i64 = 0
var g_consumer_deps_lines: i64 = 0
var g_pass3_cur_module: string = ""

func module_alias_reset():
    g_module_aliases_from = vec_new_rt()
    g_module_aliases_to = vec_new_rt()
    g_module_exports_modules = vec_new_rt()
    g_module_exports_symbols = vec_new_rt()
    g_consumer_deps_files = vec_new_rt()
    g_consumer_deps_modules = vec_new_rt()
    g_consumer_deps_kinds = vec_new_rt()
    g_consumer_deps_lines = vec_new_rt()
end.

func module_alias_register(alias: &string, target: &string):
    if fat_str_len(alias) == 0 or fat_str_len(target) == 0 do out end
    if g_module_aliases_from == 0 do
        g_module_aliases_from = vec_new_rt()
        g_module_aliases_to = vec_new_rt()
    end
    var i = 0
    let n = vec_len_rt(g_module_aliases_from)
    when i < n loop
        let al = vec_get_rt(g_module_aliases_from, i) as string
        if fat_str_eq(al, alias) == 1 do
            vec_set_rt(g_module_aliases_to, i, target as i64)
            out
        end
        i = i + 1
    end
    g_module_aliases_from = vec_push_rt(g_module_aliases_from, alias as i64)
    g_module_aliases_to = vec_push_rt(g_module_aliases_to, target as i64)
end.

func module_alias_resolve(name: &string) -> string:
    if g_module_aliases_from == 0 or fat_str_len(name) == 0 do out name end
    var i = 0
    let n = vec_len_rt(g_module_aliases_from)
    when i < n loop
        let al = vec_get_rt(g_module_aliases_from, i) as string
        if fat_str_eq(al, name) == 1 do
            out vec_get_rt(g_module_aliases_to, i) as string
        end
        i = i + 1
    end
    out name
end.

func is_module_namespace(name: &string) -> int:
    if fat_str_len(name) == 0 do out 0 end
    if g_module_aliases_from != 0 do
        var i = 0
        let n = vec_len_rt(g_module_aliases_from)
        when i < n loop
            let al = vec_get_rt(g_module_aliases_from, i) as string
            let tg = vec_get_rt(g_module_aliases_to, i) as string
            if fat_str_eq(al, name) == 1 or fat_str_eq(tg, name) == 1 do
                out 1
            end
            i = i + 1
        end
    end
    out 0
end.

func import_module_register_export(mod_name: &string, sym_name: &string):
    if fat_str_len(mod_name) == 0 or fat_str_len(sym_name) == 0 do out end
    if g_module_exports_modules == 0 do
        g_module_exports_modules = vec_new_rt()
        g_module_exports_symbols = vec_new_rt()
    end
    var i = 0
    let n = vec_len_rt(g_module_exports_modules)
    when i < n loop
        let m = vec_get_rt(g_module_exports_modules, i) as string
        let s = vec_get_rt(g_module_exports_symbols, i) as string
        if fat_str_eq(m, mod_name) == 1 and fat_str_eq(s, sym_name) == 1 do
            out
        end
        i = i + 1
    end
    g_module_exports_modules = vec_push_rt(g_module_exports_modules, mod_name as i64)
    g_module_exports_symbols = vec_push_rt(g_module_exports_symbols, sym_name as i64)
end.

func import_module_is_exported(mod_name: &string, sym_name: &string) -> int:
    if g_module_exports_modules == 0 or fat_str_len(mod_name) == 0 or fat_str_len(sym_name) == 0 do
        out 0
    end
    var i = 0
    let n = vec_len_rt(g_module_exports_modules)
    when i < n loop
        let m = vec_get_rt(g_module_exports_modules, i) as string
        let s = vec_get_rt(g_module_exports_symbols, i) as string
        if fat_str_eq(m, mod_name) == 1 and fat_str_eq(s, sym_name) == 1 do
            out 1
        end
        i = i + 1
    end
    out 0
end.

func import_module_export_count() -> int:
    if g_module_exports_modules == 0 do out 0 end
    out vec_len_rt(g_module_exports_modules)
end.

func import_module_export_module(index: int) -> string:
    if g_module_exports_modules == 0 or index < 0 or index >= vec_len_rt(g_module_exports_modules) do
        out fat_str_new("")
    end
    out vec_get_rt(g_module_exports_modules, index) as string
end.

func import_module_export_symbol(index: int) -> string:
    if g_module_exports_symbols == 0 or index < 0 or index >= vec_len_rt(g_module_exports_symbols) do
        out fat_str_new("")
    end
    out vec_get_rt(g_module_exports_symbols, index) as string
end.

func consumer_dependency_check_and_register(cur_file: int, mod_id: &string, dep_kind: int, line_no: int) -> int:
    # dep_kind: 1 = include, 2 = import
    if cur_file == 0 or fat_str_len(mod_id) == 0 do out 0 end
    if g_consumer_deps_files == 0 do
        g_consumer_deps_files = vec_new_rt()
        g_consumer_deps_modules = vec_new_rt()
        g_consumer_deps_kinds = vec_new_rt()
        g_consumer_deps_lines = vec_new_rt()
    end
    var i = 0
    let n = vec_len_rt(g_consumer_deps_files)
    when i < n loop
        let f = vec_get_rt(g_consumer_deps_files, i) as int
        let m = vec_get_rt(g_consumer_deps_modules, i) as string
        let k = vec_get_rt(g_consumer_deps_kinds, i) as int
        if rt_streq(f, cur_file) == 1 and fat_str_eq(m, mod_id) == 1 do
            if k != dep_kind do
                let prev_line = vec_get_rt(g_consumer_deps_lines, i) as int
                out prev_line
            end
        end
        i = i + 1
    end
    g_consumer_deps_files = vec_push_rt(g_consumer_deps_files, cur_file as i64)
    g_consumer_deps_modules = vec_push_rt(g_consumer_deps_modules, mod_id as i64)
    g_consumer_deps_kinds = vec_push_rt(g_consumer_deps_kinds, dep_kind as i64)
    g_consumer_deps_lines = vec_push_rt(g_consumer_deps_lines, line_no as i64)
    out 0
end.

# Selective imports sometimes retain a provider's full source so exported
# declarations can keep using private helpers.  These tables preserve the
# consumer-facing boundary after preprocessing has flattened the files.
func import_visibility_reset():
    g_import_visibility_modules = vec_new_rt()
    g_import_visibility_bindings = vec_new_rt()
    g_import_visibility_include_edges = vec_new_rt()
    g_import_visibility_public_includes = vec_new_rt()
    g_import_visibility_module_identities = vec_new_rt()
    module_alias_reset()
    g_consumer_deps_files = vec_new_rt()
    g_consumer_deps_modules = vec_new_rt()
    g_consumer_deps_kinds = vec_new_rt()
    g_consumer_deps_lines = vec_new_rt()
end.

func import_visibility_register_module_identity(path: int, module_name: &string):
    if path == 0 or fat_str_len(module_name) == 0 do out end
    if g_import_visibility_module_identities == 0 do
        g_import_visibility_module_identities = vec_new_rt()
    end
    var i = 0
    when i < vec_len_rt(g_import_visibility_module_identities) loop
        let identity = vec_get_rt(g_import_visibility_module_identities, i)
        if rt_streq(native_read_i64(identity, 0), path) == 1 do out end
        i = i + 1
    end
    let identity = vir_alloc(16)
    native_write_i64(identity, 0, path)
    native_write_i64(identity, 8, module_name as i64)
    g_import_visibility_module_identities = vec_push_rt(g_import_visibility_module_identities, identity)
end.

func import_visibility_has_public_equivalent(path: int):
    if path == 0 or g_import_visibility_module_identities == 0 do out 0 end
    var module_name = 0 as string
    var i = 0
    when i < vec_len_rt(g_import_visibility_module_identities) loop
        let identity = vec_get_rt(g_import_visibility_module_identities, i)
        if rt_streq(native_read_i64(identity, 0), path) == 1 do
            module_name = native_read_i64(identity, 8) as string
            i = vec_len_rt(g_import_visibility_module_identities)
        else
            i = i + 1
        end
    end
    if fat_str_len(module_name) == 0 do out 0 end
    i = 0
    when i < vec_len_rt(g_import_visibility_module_identities) loop
        let identity = vec_get_rt(g_import_visibility_module_identities, i)
        let candidate_path = native_read_i64(identity, 0)
        let candidate_name = native_read_i64(identity, 8) as string
        if import_visibility_is_public_include(candidate_path) == 1 and fat_str_eq(candidate_name, module_name) == 1 do
            out 1
        end
        i = i + 1
    end
    out 0
end.

func import_visibility_register_module(provider_path: int):
    if provider_path == 0 do out end
    if g_import_visibility_modules == 0 do
        g_import_visibility_modules = vec_new_rt()
    end
    var i = 0
    when i < vec_len_rt(g_import_visibility_modules) loop
        if rt_streq(vec_get_rt(g_import_visibility_modules, i), provider_path) == 1 do
            out
        end
        i = i + 1
    end
    g_import_visibility_modules = vec_push_rt(g_import_visibility_modules, provider_path)
end.

func import_visibility_is_restricted_path(path: int):
    if path == 0 or g_import_visibility_modules == 0 do out 0 end
    var i = 0
    when i < vec_len_rt(g_import_visibility_modules) loop
        if rt_streq(vec_get_rt(g_import_visibility_modules, i), path) == 1 do out 1 end
        i = i + 1
    end
    out 0
end.

func import_visibility_is_public_include(path: int):
    if path == 0 or g_import_visibility_public_includes == 0 do out 0 end
    var i = 0
    when i < vec_len_rt(g_import_visibility_public_includes) loop
        if rt_streq(vec_get_rt(g_import_visibility_public_includes, i), path) == 1 do out 1 end
        i = i + 1
    end
    out 0
end.

func import_visibility_register_public_include(path: int):
    if path == 0 or import_visibility_is_public_include(path) == 1 do out end
    if g_import_visibility_public_includes == 0 do
        g_import_visibility_public_includes = vec_new_rt()
    end
    g_import_visibility_public_includes = vec_push_rt(g_import_visibility_public_includes, path)
end.

func import_visibility_register_include(parent_path: int, included_path: int):
    if parent_path == 0 or included_path == 0 do out end
    if import_visibility_is_restricted_path(parent_path) == 0 do
        import_visibility_register_public_include(included_path)
        out
    end
    if import_visibility_is_public_include(included_path) == 0 do
        import_visibility_register_module(included_path)
    end
    if g_import_visibility_include_edges == 0 do
        g_import_visibility_include_edges = vec_new_rt()
    end
    var i = 0
    when i < vec_len_rt(g_import_visibility_include_edges) loop
        let edge = vec_get_rt(g_import_visibility_include_edges, i)
        if rt_streq(native_read_i64(edge, 0), parent_path) == 1 and rt_streq(native_read_i64(edge, 8), included_path) == 1 do
            out
        end
        i = i + 1
    end
    let edge = vir_alloc(16)
    native_write_i64(edge, 0, parent_path)
    native_write_i64(edge, 8, included_path)
    g_import_visibility_include_edges = vec_push_rt(g_import_visibility_include_edges, edge)
end.

func import_visibility_register_binding(local_name: &string, provider_path: int, importer_path: int):
    if fat_str_len(local_name) == 0 or provider_path == 0 or importer_path == 0 do out end
    if g_import_visibility_bindings == 0 do
        g_import_visibility_bindings = vec_new_rt()
    end
    let binding = vir_alloc(24)
    native_write_i64(binding, 0, local_name as i64)
    native_write_i64(binding, 8, provider_path)
    native_write_i64(binding, 16, importer_path)
    g_import_visibility_bindings = vec_push_rt(g_import_visibility_bindings, binding)
end.

func import_visibility_allows(local_name: &string, use_path: int, declaration_path: int):
    if use_path == 0 or declaration_path == 0 do out 1 end
    if rt_streq(use_path, declaration_path) == 1 do out 1 end
    if import_visibility_is_public_include(declaration_path) == 1 do out 1 end
    if g_import_visibility_modules == 0 do out 1 end

    var restricted = 0
    var i = 0
    when i < vec_len_rt(g_import_visibility_modules) loop
        if rt_streq(vec_get_rt(g_import_visibility_modules, i), declaration_path) == 1 do
            restricted = 1
            i = vec_len_rt(g_import_visibility_modules)
        else
            i = i + 1
        end
    end
    if restricted == 0 do out 1 end
    # Pass 2 intentionally coalesces declarations that carry the same
    # canonical module identity.  If one copy entered through a public
    # include, the coalesced symbol retains that public visibility even when
    # its final source span happens to point at a selectively imported copy.
    if import_visibility_has_public_equivalent(declaration_path) == 1 do out 1 end
    # All sources retained to implement one selective import form a private
    # implementation closure.  Siblings in that closure may cooperate, while
    # the root consumer still sees only its explicit import bindings.
    if import_visibility_is_restricted_path(use_path) == 1 do out 1 end
    # A textual include is part of the consumer's implementation closure too.
    # Keep its internal references valid when a later selective import brings
    # in a same-identity module and pass 2 coalesces the duplicate symbols.
    # The root source is deliberately not in this set, so it remains limited
    # to the bindings explicitly named by the import statement.
    if import_visibility_is_public_include(use_path) == 1 do out 1 end
    if g_import_visibility_bindings == 0 do out 0 end

    i = 0
    when i < vec_len_rt(g_import_visibility_bindings) loop
        let binding = vec_get_rt(g_import_visibility_bindings, i)
        let binding_name = native_read_i64(binding, 0) as string
        if fat_str_eq(binding_name, local_name) == 1 and rt_streq(native_read_i64(binding, 8), declaration_path) == 1 and rt_streq(native_read_i64(binding, 16), use_path) == 1 do
            out 1
        end
        i = i + 1
    end
    if g_import_visibility_include_edges != 0 do
        i = 0
        when i < vec_len_rt(g_import_visibility_include_edges) loop
            let edge = vec_get_rt(g_import_visibility_include_edges, i)
            if rt_streq(native_read_i64(edge, 0), use_path) == 1 and rt_streq(native_read_i64(edge, 8), declaration_path) == 1 do
                out 1
            end
            i = i + 1
        end
    end
    out 0
end.

func import_visibility_name_matches(candidate_name: &string, local_name: &string):
    if fat_str_eq(candidate_name, local_name) == 1 do out 1 end
    let candidate_len = fat_str_len(candidate_name)
    let local_len = fat_str_len(local_name)
    if local_len <= 0 or candidate_len <= local_len + 1 do out 0 end
    let candidate_data = native_read_i64(candidate_name as i64, 0)
    let local_data = native_read_i64(local_name as i64, 0)
    let suffix_start = candidate_len - local_len
    if native_read_u8(candidate_data, suffix_start - 1) != 46 do out 0 end
    var i = 0
    when i < local_len loop
        if native_read_u8(candidate_data, suffix_start + i) != native_read_u8(local_data, i) do
            out 0
        end
        i = i + 1
    end
    out 1
end.

func import_visibility_filter_symbol(ref symbols: SymbolTable, symbol_id: int, local_name: &string, use_span_id: int, use_line: int):
    if symbol_id < 0 or g_active_source_manager == 0 do out symbol_id end
    var use_file_id = -1
    if use_span_id > 0 do
        let use_span = sm_get_span(g_active_source_manager, use_span_id)
        if use_span != 0 do use_file_id = native_read_i64(use_span, 0) end
    end
    if use_file_id < 0 and use_line > 0 do
        use_file_id = sm_file_from_line(g_active_source_manager, use_line)
    end
    if use_file_id < 0 do out symbol_id end
    let symbols_vec = native_read_i64(symbols as i64, 0)
    let symbol = vec_get_rt(symbols_vec, symbol_id)
    let declaration_ast = native_read_i64(symbol as i64, 32)
    if declaration_ast == 0 do out symbol_id end
    let declaration_span_id = native_read_i64(declaration_ast, 72)
    if declaration_span_id <= 0 do out symbol_id end
    let declaration_span = sm_get_span(g_active_source_manager, declaration_span_id)
    if declaration_span == 0 do out symbol_id end
    let use_path = sm_get_file_path(g_active_source_manager, use_file_id)
    let declaration_path = sm_get_file_path(g_active_source_manager, native_read_i64(declaration_span, 0))
    if import_visibility_allows(local_name, use_path, declaration_path) == 0 do
        # Flattening may leave same-named declarations from different physical
        # modules in the global symbol list.  If the hash lookup selected a
        # declaration hidden from this source, prefer an allowed declaration
        # with the same name (most importantly, the source-local definition).
        var allowed_candidate_id = -1
        var candidate_id = 0
        when candidate_id < vec_len_rt(symbols_vec) loop
            let candidate = vec_get_rt(symbols_vec, candidate_id)
            let candidate_name = native_read_i64(candidate as i64, 8) as string
            if import_visibility_name_matches(candidate_name, local_name) == 1 do
                let candidate_ast = native_read_i64(candidate as i64, 32)
                if candidate_ast != 0 do
                    let candidate_span_id = native_read_i64(candidate_ast, 72)
                    if candidate_span_id > 0 do
                        let candidate_span = sm_get_span(g_active_source_manager, candidate_span_id)
                        if candidate_span != 0 do
                            let candidate_path = sm_get_file_path(g_active_source_manager, native_read_i64(candidate_span, 0))
                            if import_visibility_allows(local_name, use_path, candidate_path) == 1 do
                                if rt_streq(use_path, candidate_path) == 1 do out candidate_id end
                                if allowed_candidate_id < 0 do allowed_candidate_id = candidate_id end
                            end
                        end
                    end
                end
            end
            candidate_id = candidate_id + 1
        end
        if allowed_candidate_id >= 0 do out allowed_candidate_id end
        out -1
    end
    out symbol_id
end.

func pass3_resolve_import_alias(name: &string):
    if g_pass3_import_aliases == 0 or fat_str_len(name) == 0 do out name end
    var i = 0
    let n = vec_len_rt(g_pass3_import_aliases)
    when i < n loop
        al = vec_get_rt(g_pass3_import_aliases, i) as string
        if fat_str_eq(al, name) == 1 do
            out vec_get_rt(g_pass3_import_targets, i) as string
        end
        i = i + 1
    end
    out name
end.

func pass3_name_bucket(name: &string):
    n = fat_str_len(name)
    if n <= 0 do
        out 0
    end
    data = native_read_i64(name as i64, 0)
    h = n and PASS3_GLOBAL_BUCKET_MASK
    var i = 0
    when i < n loop
        h = (h * 131 + native_read_u8(data, i)) and PASS3_GLOBAL_BUCKET_MASK
        i = i + 1
    end
    out h
end.

func pass3_build_global_index(ref symbols: SymbolTable, ref scopes: ScopeTree):
    if g_pass3_global_heads == 0 do
        g_pass3_global_heads = vir_alloc(PASS3_GLOBAL_BUCKETS * 8)
    end

    var i = 0
    when i < PASS3_GLOBAL_BUCKETS loop
        native_write_i64(g_pass3_global_heads, i * 8, 0)
        i = i + 1
    end

    scopes_vec = native_read_i64(scopes as i64, 0)
    global_scope = vec_get_rt(scopes_vec, 0)
    global_syms = native_read_i64(global_scope as i64, 16)
    count = vec_len_rt(global_syms)
    # semantic_run invokes pass 3 once.  Allocate the exact chain array for
    # that snapshot; symbols added later use the small linear tail fallback.
    if count > 0 do
        g_pass3_global_next = vir_alloc(count * 8)
    else
        g_pass3_global_next = 0
    end
    g_pass3_global_indexed_count = count

    syms_vec = native_read_i64(symbols as i64, 0)
    i = 0
    when i < count loop
        sym_id = vec_get_rt(global_syms, i)
        sym = vec_get_rt(syms_vec, sym_id)
        sym_name = native_read_i64(sym as i64, 8) as string
        bucket = pass3_name_bucket(sym_name)
        head = native_read_i64(g_pass3_global_heads, bucket * 8)
        native_write_i64(g_pass3_global_next, i * 8, head)
        native_write_i64(g_pass3_global_heads, bucket * 8, i + 1)
        i = i + 1
    end
end.

func is_builtin_method_name(name: i64):
    if name == 0 do out 0 end
    if fat_cstr_eq(name, "send") or fat_cstr_eq(name, "recv") or fat_cstr_eq(name, "push") or fat_cstr_eq(name, "pop") or fat_cstr_eq(name, "len") do out 1 end
    if rt_streq(name as int, "send") or rt_streq(name as int, "recv") or rt_streq(name as int, "push") or rt_streq(name as int, "pop") or rt_streq(name as int, "len") do out 1 end
    out 0
end.

func pass3_is_soft_call_name(name: &string):
    if fat_str_len(name) == 0 do
        out 0
    end
    nm = name as i64
    if fat_str_len(name) >= 7 do
        data = native_read_i64(nm, 0)
        if native_read_u8(data, 0) == 110 and native_read_u8(data, 1) == 97 and native_read_u8(data, 2) == 116 and native_read_u8(data, 3) == 105 and native_read_u8(data, 4) == 118 and native_read_u8(data, 5) == 101 and native_read_u8(data, 6) == 95 do
            out 1
        end
    end
    if fat_cstr_eq(nm, "panic") or fat_cstr_eq(nm, "free") or fat_cstr_eq(nm, "realloc") or fat_cstr_eq(nm, "size_of") or fat_cstr_eq(nm, "alloc") or fat_cstr_eq(nm, "min") or fat_cstr_eq(nm, "max") or fat_cstr_eq(nm, "to_string") or fat_cstr_eq(nm, "utf8_decode_char") or fat_cstr_eq(nm, "vec_set_at") or fat_cstr_eq(nm, "str_from_i64") or fat_cstr_eq(nm, "codebuf_get_data") or fat_cstr_eq(nm, "read_u32") or fat_cstr_eq(nm, "patch_u32") or fat_cstr_eq(nm, "patch_i32") or fat_cstr_eq(nm, "eprintln") or fat_cstr_eq(nm, "read") or fat_cstr_eq(nm, "write") or fat_cstr_eq(nm, "_next_pow2") or fat_cstr_eq(nm, "alloc_zeroed") or fat_cstr_eq(nm, "float_to_bits") or fat_cstr_eq(nm, "wf_emit_sleb128") or fat_cstr_eq(nm, "map_set") or fat_cstr_eq(nm, "write_bytes_to_file") or fat_cstr_eq(nm, "flux") or fat_cstr_eq(nm, "flux_splat") or fat_cstr_eq(nm, "flux_dot") or fat_cstr_eq(nm, "flux_norm") do
        out 1
    end
    out 0
end.

func is_user_module(name: string) -> int:
    let s = name as int
    if s == 0 do out 0 end
    let slen = native_read_i64(s, 8) as int
    if slen == 0 do out 0 end
    let cstr_ptr = native_read_i64(s, 0) as int
    if cstr_ptr == 0 do out 0 end
    if slen == 4 and native_read_u8(cstr_ptr, 0) == 114 and native_read_u8(cstr_ptr, 1) == 111 and native_read_u8(cstr_ptr, 2) == 111 and native_read_u8(cstr_ptr, 3) == 116 do
        out 0
    end
    if slen >= 4 and native_read_u8(cstr_ptr, 0) == 118 and native_read_u8(cstr_ptr, 1) == 105 and native_read_u8(cstr_ptr, 2) == 114 and native_read_u8(cstr_ptr, 3) == 46 do
        out 0
    end
    out 1
end.

