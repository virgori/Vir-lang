##
 * vir/compiler/semantic/names/walk_decl.vri
 * ==============================================================
 * Pass 3: Declaration Name Resolution Walker.
 * Handles functions, variable declarations, groups, constants, and share/has decls.
 ##

include rt_vec_rt
include rt_string_rt
include parser
include symbol_table
include scope_tree
include context
include ide_facts
include names_context
include names_lookup
include names_register

func pass3_walk_decl(ref symbols: SymbolTable, ref scopes: ScopeTree, diag: &DiagnosticEngine, node: &AstNode):
    if node.node_type == AstType.FuncDef do
        # Push function scope for body
        old_scope = scope_current_id(scopes)
        scope_id = scope_push(scopes, ScopeKind.Func)
        # Children: params*, body Block, optional Ensure/Revert.
        child_count = vec_len_rt(node.children)
        body_idx = child_count - 1
        if body_idx < 0 do
            body_idx = 0
        end
        var bi = 0
        when bi < child_count loop
            ch = vec_get_rt(node.children, bi)
            if ch.node_type == AstType.Block do
                body_idx = bi
                bi = child_count
            else
                bi = bi + 1
            end
        end
        var i = 0
        when i < body_idx loop
            let parameterPtr = vec_get_rt(node.children, i)
            param = parameterPtr as AstNode
            let parameterId = pass3_register_local(symbols, scopes, param.name, SymbolKind.Param, param.line)
            ideFactResolve(parameterPtr, parameterId, scope_current_id(scopes), 1)
            i = i + 1
        end
        var j = body_idx
        when j < child_count loop
            child = vec_get_rt(node.children, j)
            pass3_walk(symbols, scopes, diag, child)
            j = j + 1
        end
        scope_pop(scopes)
        out 1
    end

    if node.node_type == AstType.VarDeclGroup do
        child_count = vec_len_rt(node.children)
        var vi = 0
        when vi < child_count loop
            child = vec_get_rt(node.children, vi)
            curr_scope = scope_current_id(scopes)
            if curr_scope > 0 and fat_str_len(child.name) > 0 and not fat_str_eq(child.name, fat_str_new("_")) do
                existing_sym = pass3_lookup_in_scope_exact(symbols, scopes, curr_scope, child.name)
                if existing_sym != -1 do
                    var col = child.int_val
                    if col <= 0 do col = 1 end
                    report_error_loc(diag, 1001, 0, child.line, col, "[E1001] duplicate variable name in scope")
                    out 1
                end
            end
            pass3_walk(symbols, scopes, diag, child)
            vi = vi + 1
        end
        out 1
    end

    if node.node_type == AstType.VarDecl or node.node_type == AstType.ConstDecl or node.node_type == AstType.ReactiveDecl do
        is_mut = node.node_type == AstType.VarDecl or node.node_type == AstType.ReactiveDecl
        if node.int_val == 16384 do
            child_count = vec_len_rt(node.children)
            if child_count > 0 do
                # 1. Resolve initializer (last child)
                init_child = vec_get_rt(node.children, child_count - 1)
                pass3_walk(symbols, scopes, diag, init_child)
                # 2. Register destructure variable names (first child_count - 1 children)
                var i = 0
                when i < child_count - 1 loop
                    var_ident = vec_get_rt(node.children, i)
                    if is_mut do
                        let declarationId = pass3_register_local(symbols, scopes, var_ident.name, SymbolKind.Variable, var_ident.line)
                        ideFactResolve(var_ident as int, declarationId, scope_current_id(scopes), 1)
                    else
                        let declarationId = pass3_register_local(symbols, scopes, var_ident.name, SymbolKind.Const, var_ident.line)
                        ideFactResolve(var_ident as int, declarationId, scope_current_id(scopes), 1)
                    end
                    i = i + 1
                end
            end
        else
            # First resolve initializer, then register the name
            child_count = vec_len_rt(node.children)
            var i = 0
            when i < child_count loop
                child = vec_get_rt(node.children, i)
                pass3_walk(symbols, scopes, diag, child)
                i = i + 1
            end
            if is_mut do
                let declarationId = pass3_register_local(symbols, scopes, node.name, SymbolKind.Variable, node.line)
                ideFactResolve(node as int, declarationId, scope_current_id(scopes), 1)
            else
                let declarationId = pass3_register_local(symbols, scopes, node.name, SymbolKind.Const, node.line)
                ideFactResolve(node as int, declarationId, scope_current_id(scopes), 1)
            end
        end
        out 1
    end

    if node.node_type == AstType.ShareDecl or node.node_type == AstType.HasDecl do
        if fat_str_len(node.name) > 0 do
            let declarationId = pass3_register_local(symbols, scopes, node.name, SymbolKind.Variable, node.line)
            ideFactResolve(node as int, declarationId, scope_current_id(scopes), 1)
        end
        out 1
    end

    out 0
end.

export pass3_walk_decl
