##
 * vir/compiler/semantic/names/register.vri
 * ==============================================================
 * Pass 3: Local Symbol & Pattern Binder Registration.
 * Registers local variables, params, implicit assignments, and match binders.
 ##

include rt_vec_rt
include rt_string_rt
include parser
include symbol_table
include scope_tree
include context
include ide_facts
include names_context
include names_lookup

func pass3_register_pattern_binders(ref symbols: SymbolTable, ref scopes: ScopeTree, diag: &DiagnosticEngine, pat: &AstNode):
    if pat.node_type == AstType.Identifier do
        if g_ideFactsEnabled == 1 do
            var constructorId = -1
            let qualifierName = native_read_i64(pat as int, 8)
            if qualifierName != 0 and native_read_i64(qualifierName, 8) > 0 do
                let enumId = pass3_lookup_chain(symbols, scopes, 0, qualifierName as string)
                if enumId >= 0 do
                    let enumSymbol = vec_get_rt(native_read_i64(symbols as int, 0), enumId)
                    let enumAst = native_read_i64(enumSymbol as int, 32)
                    if enumAst != 0 do
                        let variants = native_read_i64(enumAst, 64)
                        var variantIndex = 0
                        when variantIndex < vec_len_rt(variants) loop
                            let variantAst = vec_get_rt(variants, variantIndex)
                            if fat_str_eq(native_read_i64(variantAst, 0) as string, pat.name) == 1 do
                                let variantFact = ideFactFind(variantAst)
                                if variantFact != 0 do constructorId = native_read_i64(variantFact, 8) end
                            end
                            variantIndex = variantIndex + 1
                        end
                    end
                end
            else
                let foundTag = pass3_lookup_chain(symbols, scopes, 0, pat.name)
                if foundTag >= 0 do
                    let tagSymbol = vec_get_rt(native_read_i64(symbols as int, 0), foundTag)
                    if native_read_i64(tagSymbol as int, 0) == SymbolKind.Variant as int do constructorId = foundTag end
                end
            end
            if constructorId >= 0 do
                ideFactResolve(pat as int, constructorId, scope_current_id(scopes), 2)
                ideFactType(pat as int, 6)
            end
        end
        child_count = vec_len_rt(pat.children)
        if child_count > 0 do
            # Tagged patterns are encoded as an Identifier constructor with
            # binder identifiers as children: Some(p), Ok(v), Err(e).
            var i = 0
            when i < child_count loop
                child = vec_get_rt(pat.children, i)
                pass3_register_pattern_binders(symbols, scopes, diag, child)
                i = i + 1
            end
            out 0
        end
        if not fat_str_eq(pat.name, fat_str_new("_")) and not fat_str_eq(pat.name, fat_str_new("true")) and not fat_str_eq(pat.name, fat_str_new("false")) and not fat_str_eq(pat.name, fat_str_new("None")) and not fat_str_eq(pat.name, fat_str_new("null")) do
            found = pass3_lookup_chain(symbols, scopes, 0, pat.name)
            if found == -1 do
                let declarationId = pass3_register_local(symbols, scopes, pat.name, SymbolKind.Variable, pat.line)
                ideFactResolve(pat as int, declarationId, scope_current_id(scopes), 1)
            end
        end
        out 0
    end
    if pat.node_type == AstType.Call or pat.node_type == AstType.TupleExpr or pat.node_type == AstType.ArrayLiteral do
        child_count = vec_len_rt(pat.children)
        var i = 0
        when i < child_count loop
            child = vec_get_rt(pat.children, i)
            pass3_register_pattern_binders(symbols, scopes, diag, child)
            i = i + 1
        end
    end
    out 0
end.

func pass3_register_local(ref symbols: SymbolTable, ref scopes: ScopeTree, name: &string, kind: SymbolKind, line: int):
    if fat_str_len(name) == 0 do
        out 0
    end
    curr_scope = scope_current_id(scopes)
    # Pass 2 already registered top-level declarations.  Registering them a
    # second time here both changed shadowing behaviour and enlarged the hot
    # global lookup set while pass 3 was running.
    if curr_scope == 0 do
        found = pass3_lookup_global(symbols, scopes, name)
        if found != -1 do
            out found
        end
    end
    sym = SymbolNode (
        kind: kind,
        name_id: name as i64,
        type_id: 0,
        scope_id: curr_scope,
        ast_id: 0,
        is_mutable: kind == SymbolKind.Variable or kind == SymbolKind.Param,
        offset: 0,
        param_count: 0,
        return_type: 0,
        parent_id: -1
    )
    sym_id = symbol_alloc(symbols, sym)
    scope_add_symbol(scopes, curr_scope, sym_id)
    out sym_id
end.

func pass3_register_implicit_local(ref symbols: SymbolTable, ref scopes: ScopeTree, name: &string, kind: SymbolKind, line: int):
    curr_scope = scope_current_id(scopes)
    sym_id = pass3_register_local(symbols, scopes, name, kind, line)
    func_scope = pass3_enclosing_func_scope(scopes, curr_scope)
    if sym_id > 0 and func_scope != curr_scope do
        scope_add_symbol(scopes, func_scope, sym_id)
    end
    out sym_id
end.

export pass3_register_pattern_binders, pass3_register_local, pass3_register_implicit_local
