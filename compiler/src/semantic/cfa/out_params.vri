##
 * compiler/src/semantic/cfa/out_params.vri — Out Parameter Definite Assignment
 * ===========================================================================
 * VIRC-PLN-0004 & Phase 7: Control Flow Analysis Decomposition.
 *
 * Implements definite assignment tracking (§14.4) for `out` parameters:
 * ensures every out parameter is initialized along every execution path before
 * function return or read.
 ##

include rt_vec_rt
include rt_string_rt
include parser
include context
include cfa_context

func pass7_state_falls_through(assigned_outs: int):
    out pass7_vec_contains(assigned_outs, fat_str_new("__vir_cfa_no_fallthrough__")) == 0
end.

func pass7_mark_no_fallthrough(assigned_outs: int):
    if pass7_state_falls_through(assigned_outs) do
        assigned_outs = vec_push_rt(assigned_outs, fat_str_new("__vir_cfa_no_fallthrough__") as i64)
    end
    out assigned_outs
end.

func pass7_require_outs_assigned(diag: &DiagnosticEngine, line: int, out_params: int, assigned_outs: int):
    var oi = 0
    when oi < vec_len_rt(out_params) loop
        op = vec_get_rt(out_params, oi) as string
        if pass7_vec_contains(assigned_outs, op) == 0 do
            report_error(diag, 3051, line, 0)
        end
        oi = oi + 1
    end
end.

func pass7_merge_fallthrough_states(out_params: int, left: int, right: int):
    let left_falls = pass7_state_falls_through(left)
    let right_falls = pass7_state_falls_through(right)
    if not left_falls and not right_falls do
        out pass7_mark_no_fallthrough(vec_new_rt())
    end
    if not left_falls do out right end
    if not right_falls do out left end
    inter = vec_new_rt()
    var oi = 0
    when oi < vec_len_rt(out_params) loop
        op = vec_get_rt(out_params, oi) as string
        if pass7_vec_contains(left, op) == 1 and pass7_vec_contains(right, op) == 1 do
            inter = vec_push_rt(inter, op as i64)
        end
        oi = oi + 1
    end
    out inter
end.

func pass7_check_call_outs(diag: &DiagnosticEngine, call: &AstNode, out_params: int, assigned_outs: int):
    fn = pass7_find_func(call.name)
    if (fn as i64) == 0 do
        pass7_check_expr_reads(diag, call, out_params, assigned_outs)
        out assigned_outs
    end
    var pi = 0
    var ai = 0
    when pi < vec_len_rt(fn.children) & ai < vec_len_rt(call.children) loop
        param = vec_get_rt(fn.children, pi) as AstNode
        if param.node_type == AstType.Identifier or param.node_type == AstType.ParamDef or param.node_type == AstType.RefParam or param.node_type == AstType.OutParam do
            arg = vec_get_rt(call.children, ai) as AstNode
            let is_out = param.node_type == AstType.OutParam or param.int_val == 2
            if is_out and arg.node_type == AstType.Identifier do
                if pass7_vec_contains(out_params, arg.name) == 1 and pass7_vec_contains(assigned_outs, arg.name) == 0 do
                    assigned_outs = vec_push_rt(assigned_outs, arg.name as i64)
                end
            else
                pass7_check_expr_reads(diag, arg, out_params, assigned_outs)
            end
            ai = ai + 1
        end
        pi = pi + 1
    end
    out assigned_outs
end.

func pass7_check_expr_reads(diag: &DiagnosticEngine, expr: &AstNode, out_params: int, assigned_outs: int):
    if (expr as i64) == 0 do out 0 end
    if expr.node_type == AstType.Identifier do
        if pass7_vec_contains(out_params, expr.name) == 1 and pass7_vec_contains(assigned_outs, expr.name) == 0 do
            report_error(diag, 3050, expr.line, 0)
        end
        out 0
    end
    child_count = vec_len_rt(expr.children)
    var i = 0
    when i < child_count loop
        pass7_check_expr_reads(diag, vec_get_rt(expr.children, i) as AstNode, out_params, assigned_outs)
        i = i + 1
    end
    out 0
end.

func pass7_check_stmt_outs(diag: &DiagnosticEngine, stmt: &AstNode, out_params: int, assigned_outs: int):
    if (stmt as i64) == 0 do out assigned_outs end
    if stmt.node_type == AstType.ReturnStmt do
        pass7_check_expr_reads(diag, stmt, out_params, assigned_outs)
        pass7_require_outs_assigned(diag, stmt.line, out_params, assigned_outs)
        out pass7_mark_no_fallthrough(assigned_outs)
    end
    if stmt.node_type == AstType.ThrowStmt do
        pass7_check_expr_reads(diag, stmt, out_params, assigned_outs)
        out pass7_mark_no_fallthrough(assigned_outs)
    end
    if stmt.node_type == AstType.Call do
        out pass7_check_call_outs(diag, stmt, out_params, assigned_outs)
    end
    if stmt.node_type == AstType.Assign do
        if vec_len_rt(stmt.children) > 0 do
            pass7_check_expr_reads(diag, vec_get_rt(stmt.children, 0) as AstNode, out_params, assigned_outs)
        end
        if pass7_vec_contains(out_params, stmt.name) == 1 do
            if pass7_vec_contains(assigned_outs, stmt.name) == 0 do
                assigned_outs = vec_push_rt(assigned_outs, stmt.name)
            end
        end
        out assigned_outs
    end
    if stmt.node_type == AstType.IfStmt do
        if vec_len_rt(stmt.children) > 0 do
            pass7_check_expr_reads(diag, vec_get_rt(stmt.children, 0) as AstNode, out_params, assigned_outs)
        end
        then_assigned = assigned_outs
        if vec_len_rt(stmt.children) >= 2 do
            then_b = vec_get_rt(stmt.children, 1) as AstNode
            then_assigned = pass7_check_stmt_outs(diag, then_b, out_params, pass7_copy_vec(assigned_outs))
        end
        if vec_len_rt(stmt.children) >= 3 do
            else_b = vec_get_rt(stmt.children, 2) as AstNode
            else_assigned = pass7_check_stmt_outs(diag, else_b, out_params, pass7_copy_vec(assigned_outs))
            out pass7_merge_fallthrough_states(out_params, then_assigned, else_assigned)
        end
        out pass7_merge_fallthrough_states(out_params, then_assigned, pass7_copy_vec(assigned_outs))
    end
    if stmt.node_type == AstType.WhileStmt or stmt.node_type == AstType.ForRange or stmt.node_type == AstType.LoopStmt do
        # A loop may execute zero times or leave through break.  Analyze its
        # children for read-before-write and early returns, but do not promote
        # assignments made only inside the loop to the post-loop state.
        var li = 0
        when li < vec_len_rt(stmt.children) loop
            pass7_check_stmt_outs(diag, vec_get_rt(stmt.children, li) as AstNode, out_params, pass7_copy_vec(assigned_outs))
            li = li + 1
        end
        out assigned_outs
    end
    if stmt.node_type == AstType.Block do
        child_count = vec_len_rt(stmt.children)
        var i = 0
        when i < child_count loop
            if pass7_state_falls_through(assigned_outs) do
                assigned_outs = pass7_check_stmt_outs(diag, vec_get_rt(stmt.children, i) as AstNode, out_params, assigned_outs)
            end
            i = i + 1
        end
        out assigned_outs
    end
    if stmt.node_type == AstType.ArenaBlock do
        child_count = vec_len_rt(stmt.children)
        if child_count > 0 do
            let body_node = vec_get_rt(stmt.children, child_count - 1) as AstNode
            out pass7_check_stmt_outs(diag, body_node, out_params, assigned_outs)
        end
        out assigned_outs
    end
    pass7_check_expr_reads(diag, stmt, out_params, assigned_outs)
    out assigned_outs
end.
