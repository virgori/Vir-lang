##
 * vir/compiler/sem_pass3_names.vri
 * ==============================================================
 * Pass 3: Name Resolution Orchestrator (Vir v2.0 Complete).
 * Resolves identifier references, function calls, method calls,
 * builtin calls, and enum access to their declaring symbols.
 ##

include vec_rt
include string_rt
include parser
include symbol_table
include scope_tree
include context
include io
include alloc
include ide_facts
include names_context
include names_lookup
include names_register
include names_rewrite
include names_walk_expr
include names_walk_decl
include names_walk

func pass3_resolve_names(ref symbols: SymbolTable, ref scopes: ScopeTree, diag: &DiagnosticEngine, node: &AstNode):
    g_pass3_import_aliases = vec_new_rt()
    g_pass3_import_targets = vec_new_rt()
    pass3_build_global_index(symbols, scopes)
    pass3_walk(symbols, scopes, diag, node)
    if g_ideFactsEnabled == 1 do
        var typeIndex = 0
        when typeIndex < vec_len_rt(g_ideTypeUses) loop
            let typeUse = vec_get_rt(g_ideTypeUses, typeIndex)
            let typeName = native_read_i64(typeUse, 0) as string
            let typeId = pass3_lookup_chain(symbols, scopes, 0, typeName)
            if typeId >= 0 do
                let entry = vec_get_rt(native_read_i64(symbols as int, 0), typeId)
                let kind = native_read_i64(entry as int, 0)
                var namedType = 0
                if kind == SymbolKind.Entity do namedType = 1 end
                if kind == SymbolKind.Enum do namedType = 1 end
                if kind == SymbolKind.TypeDef do namedType = 1 end
                if namedType == 1 do
                    ideFactResolve(typeUse, typeId, 0, 5)
                    var typeKind = 5
                    if kind == SymbolKind.Enum do typeKind = 6 end
                    ideFactType(typeUse, typeKind)
                end
            end
            typeIndex = typeIndex + 1
        end
    end
end.

export pass3_resolve_names, pass3_lookup_chain
