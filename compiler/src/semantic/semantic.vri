##
 * vir/compiler/semantic.vri
 * ==============================================================
 * Bộ Phân tích Ngữ nghĩa (Semantic Analyzer) — Orchestrator v2.0 (100% Coverage).
 *
 * Điều phối toàn bộ 10 pass theo đặc tả Vir v2.0:
 *   Pass 1: Module Collection & Import Resolution
 *   Pass 2: Symbol Registration
 *   Pass 3: Name Resolution
 *   Pass 4: Type Resolution
 *   Pass 5: Type Inference
 *   Pass 6: Type Checking
 *   Pass 7: Control Flow Analysis
 *   Pass 8: Borrow / Reference Analysis
 *   Pass 9: Constant Folding Analysis
 *   Pass 10: Diagnostics Emission
 *
 * Trả về error_count. Nếu > 0, pipeline PHẢI dừng trước codegen.
 ##

include context
import CompilerContext, DiagnosticEngine, diagnostic_engine_new, has_errors, g_has_custom_entry, g_entry_function_name from compiler.context

include parser

include type_table
import TypeTable, type_table_new from compiler.type_table

include scope_tree
import ScopeTree, ScopeKind, scope_tree_new, scope_reset from compiler.scope_tree

include symbol_table
import SymbolTable, symbol_table_new from compiler.symbol_table

include sem_pass1_modules
import pass1_collect_modules from compiler.sem_pass1_modules

include sem_pass2_symbols
import pass2_register_symbols from compiler.sem_pass2_symbols

include sem_pass3_names
import pass3_resolve_names from compiler.sem_pass3_names

include sem_pass4_types
import pass4_resolve_types from compiler.sem_pass4_types

include sem_pass5_infer
import pass5_infer_types from compiler.sem_pass5_infer

include sem_pass6_typecheck
import pass6_typecheck from compiler.sem_pass6_typecheck

include sem_pass7_cfa
import pass7_analyze_cfa from compiler.sem_pass7_cfa

include sem_pass8_borrow
import pass8_analyze_borrow from compiler.sem_pass8_borrow

include sem_pass9_constfold
import pass9_const_fold from compiler.sem_pass9_constfold

include sem_pass10_diagnostics
import pass10_emit_diagnostics from compiler.sem_pass10_diagnostics

include ide_semantic
import ide_enabled from compiler.ide_semantic

include sem_pass_ide
import pass_ide_collect from compiler.sem_pass_ide

var g_semantic_err_count: int = 0


func semantic_run(ast: &AstNode, verbose: int):
    arena:
        g_has_custom_entry = 0
        g_entry_function_name = ""
        # Semantic tables are phase-local. AST annotations that survive this
        # scope must reference parser-owned data; lowering recomputes qualified
        # method symbols from the persistent AST instead of retaining concat
        # buffers allocated here.
        var types = type_table_new()
        var symbols = symbol_table_new()
        var scopes = scope_tree_new()
        var diag = diagnostic_engine_new()

        # ── Pass 1: Module & Import Resolution ──
        if verbose == 1 do
            print_ln("virc: semantic pass 1 — module & import resolution")
        end
        pass1_collect_modules(symbols, scopes, diag, ast)

        # ── Pass 2: Symbol Registration ──
        if verbose == 1 do
            print_ln("virc: semantic pass 2 — symbol registration")
        end
        scope_reset(scopes)
        pass2_register_symbols(symbols, scopes, diag, ast)

        # ── Pass 3: Name Resolution ──
        if verbose == 1 do
            print_ln("virc: semantic pass 3 — name resolution")
        end
        scope_reset(scopes)
        pass3_resolve_names(symbols, scopes, diag, ast)

        # ── Pass 4: Type Resolution ──
        if verbose == 1 do
            print_ln("virc: semantic pass 4 — type resolution")
        end
        scope_reset(scopes)
        pass4_resolve_types(symbols, scopes, ast)

        # ── Pass 5: Type Inference ──
        if verbose == 1 do
            print_ln("virc: semantic pass 5 — type inference")
        end
        scope_reset(scopes)
        pass5_infer_types(symbols, scopes, ast)

        # ── Pass 6: Type Checking ──
        if verbose == 1 do
            print_ln("virc: semantic pass 6 — type checking")
        end
        scope_reset(scopes)
        pass6_typecheck(symbols, scopes, diag, ast)

        # ── Pass 7: Control Flow Analysis ──
        if verbose == 1 do
            print_ln("virc: semantic pass 7 — control flow analysis")
        end
        scope_reset(scopes)
        pass7_analyze_cfa(symbols, scopes, diag, ast)

        # ── Pass 8: Borrow / Ref Analysis ──
        if verbose == 1 do
            print_ln("virc: semantic pass 8 — borrow analysis")
        end
        scope_reset(scopes)
        pass8_analyze_borrow(symbols, scopes, diag, ast)

        # ── Pass 9: Constant Folding Analysis ──
        if verbose == 1 do
            print_ln("virc: semantic pass 9 — constant folding")
        end
        scope_reset(scopes)
        pass9_const_fold(symbols, scopes, diag, ast)

        if ide_enabled() == 1 do
            pass_ide_collect(symbols, scopes, ast)
        end

        # ── Pass 10: Diagnostics Emission ──
        let err_count = pass10_emit_diagnostics(diag)
        g_semantic_err_count = err_count

        if verbose == 1 do
            if err_count == 0 do
                print_ln("virc: semantic analysis 100% complete (10 passes)")
            else
                var sb = sb_new()
                sb = sb_append(sb, "virc: semantic analysis found ")
                sb = sb_append_int(sb, err_count)
                sb = sb_append(sb, " error(s)")
                print_ln(sb_to_string(sb))
                sb_free(sb)
            end
        end
    end
    out g_semantic_err_count
end.

export semantic_run
