##
 * compiler/src/semantic/types/table.vri — Core Type System Entities, Table & Predicates
 ##

include rt_vec_rt
include rt_string_rt

enum TypeKind:
    Void    = 0,
    Int     = 1,
    Float   = 2,
    Bool    = 3,
    String  = 4,
    Entity  = 5,
    Enum    = 6,
    Array   = 7,
    Func    = 8,
    Pointer = 9,
    Dict     = 10,
    Tuple    = 11,
    Ref      = 12,
    MutRef   = 13,
    Register = 14,
    Mold     = 15,
    Packed   = 16,
    Flux     = 17,
    Deck     = 18,
    Optional = 19,
    Tensor   = 20,
    None     = 21,
    # Distinct type-state for compact quantized storage.  It must not silently
    # regain ordinary Tensor semantics (notably mutation or autodiff).
    QuantizedTensor = 22
end.

func type_primitive_kind_from_name(name: &string) -> TypeKind:
    if (name as i64) == 0 do out TypeKind.Void end
    var
        resolved = name
        unwrapping = true
    when unwrapping loop
        unwrapping = false
        let length = fat_str_len(resolved)
        if length >= 5 and fat_str_byte_at(resolved, 0) == 38 and fat_str_byte_at(resolved, 1) == 109 and fat_str_byte_at(resolved, 2) == 117 and fat_str_byte_at(resolved, 3) == 116 and fat_str_byte_at(resolved, 4) == 32 do
            resolved = fat_str_slice(resolved, 5, length - 5)
            unwrapping = true
        eif length >= 4 and fat_str_byte_at(resolved, 0) == 38 and fat_str_byte_at(resolved, 1) == 109 and fat_str_byte_at(resolved, 2) == 117 and fat_str_byte_at(resolved, 3) == 116 do
            resolved = fat_str_slice(resolved, 4, length - 4)
            unwrapping = true
        eif length >= 7 and fat_str_byte_at(resolved, 0) == 109 and fat_str_byte_at(resolved, 1) == 117 and fat_str_byte_at(resolved, 2) == 116 and fat_str_byte_at(resolved, 3) == 114 and fat_str_byte_at(resolved, 4) == 101 and fat_str_byte_at(resolved, 5) == 102 and fat_str_byte_at(resolved, 6) == 32 do
            resolved = fat_str_slice(resolved, 7, length - 7)
            unwrapping = true
        eif length >= 4 and fat_str_byte_at(resolved, 0) == 114 and fat_str_byte_at(resolved, 1) == 101 and fat_str_byte_at(resolved, 2) == 102 and fat_str_byte_at(resolved, 3) == 32 do
            resolved = fat_str_slice(resolved, 4, length - 4)
            unwrapping = true
        eif length >= 4 and fat_str_byte_at(resolved, 0) == 109 and fat_str_byte_at(resolved, 1) == 117 and fat_str_byte_at(resolved, 2) == 116 and fat_str_byte_at(resolved, 3) == 32 do
            resolved = fat_str_slice(resolved, 4, length - 4)
            unwrapping = true
        eif length >= 2 and fat_str_byte_at(resolved, 0) == 38 and fat_str_byte_at(resolved, 1) == 32 do
            resolved = fat_str_slice(resolved, 2, length - 2)
            unwrapping = true
        eif length >= 1 and fat_str_byte_at(resolved, 0) == 38 do
            resolved = fat_str_slice(resolved, 1, length - 1)
            unwrapping = true
        end
    end

    if fat_cstr_eq(resolved, "int") == 1 or fat_cstr_eq(resolved, "i8") == 1 or fat_cstr_eq(resolved, "i16") == 1 or fat_cstr_eq(resolved, "i32") == 1 or fat_cstr_eq(resolved, "i64") == 1 or fat_cstr_eq(resolved, "uint") == 1 or fat_cstr_eq(resolved, "u8") == 1 or fat_cstr_eq(resolved, "u16") == 1 or fat_cstr_eq(resolved, "u32") == 1 or fat_cstr_eq(resolved, "u64") == 1 do out TypeKind.Int end
    if fat_cstr_eq(resolved, "float") == 1 or fat_cstr_eq(resolved, "f32") == 1 or fat_cstr_eq(resolved, "f64") == 1 do out TypeKind.Float end
    if fat_cstr_eq(resolved, "bool") == 1 do out TypeKind.Bool end
    if fat_cstr_eq(resolved, "string") == 1 do out TypeKind.String end
    if fat_cstr_eq(resolved, "ptr") == 1 do out TypeKind.Pointer end
    if fat_cstr_eq(resolved, "none") == 1 or fat_cstr_eq(resolved, "void") == 1 do out TypeKind.None end
    out TypeKind.Void
end.

# Const IDs for primitive types (will be allocated first)
const TYPE_VOID:   0
const TYPE_INT:    1
const TYPE_FLOAT:  2
const TYPE_BOOL:   3
const TYPE_STRING: 4

entity TypeNode:
    kind: TypeKind,
    name_id: i64,       # InternID (0 if anonymous)
    size: i64,          # Size in bytes
    elem_type: i64,     # TypeID cho Array/Pointer
    return_type: i64,   # TypeID cho Func
    fields: i64         # Vec của Field/Param (các TypeID thành phần)
end.

entity TypeTable:
    nodes: i64          # vec của TypeNode
end.

func type_table_new()
    tbl = TypeTable (
        nodes: vec_new_rt()
    )

    # Khởi tạo các primitive types theo đúng thứ tự (Void = 0, Int = 1, Float = 2, Bool = 3, String = 4)
    tbl.nodes = vec_push_rt(tbl.nodes, TypeNode ( kind: TypeKind.Void, name_id: 0, size: 0, elem_type: 0, return_type: 0, fields: 0 ))
    tbl.nodes = vec_push_rt(tbl.nodes, TypeNode ( kind: TypeKind.Int, name_id: 0, size: 8, elem_type: 0, return_type: 0, fields: 0 ))
    tbl.nodes = vec_push_rt(tbl.nodes, TypeNode ( kind: TypeKind.Float, name_id: 0, size: 8, elem_type: 0, return_type: 0, fields: 0 ))
    tbl.nodes = vec_push_rt(tbl.nodes, TypeNode ( kind: TypeKind.Bool, name_id: 0, size: 1, elem_type: 0, return_type: 0, fields: 0 ))
    tbl.nodes = vec_push_rt(tbl.nodes, TypeNode ( kind: TypeKind.String, name_id: 0, size: 8, elem_type: 0, return_type: 0, fields: 0 ))

    out tbl
end.

func type_alloc(tbl: TypeTable, node: any):
    nodes = native_read_i64(tbl as i64, 0)
    id = vec_len_rt(nodes)
    nodes = vec_push_rt(nodes, node)
    native_write_i64(tbl as i64, 0, nodes)
    out id
end.

func type_get(tbl: TypeTable, id: i64):
    nodes = native_read_i64(tbl as i64, 0)
    out vec_get_rt(nodes, id)
end.

func type_is_numeric(kind: TypeKind):
    out kind == TypeKind.Int or kind == TypeKind.Float
end.

func type_is_integer(kind: TypeKind):
    out kind == TypeKind.Int
end.

func type_is_copy(kind: TypeKind):
    out kind == TypeKind.Int or kind == TypeKind.Float or kind == TypeKind.Bool or kind == TypeKind.Enum or kind == TypeKind.Register or kind == TypeKind.Mold or kind == TypeKind.Flux
end.

func type_is_move(kind: TypeKind):
    out kind == TypeKind.String or kind == TypeKind.Array or kind == TypeKind.Entity or kind == TypeKind.Dict or kind == TypeKind.Deck or kind == TypeKind.Tensor or kind == TypeKind.QuantizedTensor
end.

func type_is_tensor(kind: TypeKind) -> bool:
    out kind == TypeKind.Tensor
end.

func tensor_type_rank(node: TypeNode) -> int:
    out node.return_type
end.

func tensor_type_shape(node: TypeNode) -> int:
    out node.fields
end.

func tensor_type_elem_type(node: TypeNode) -> int:
    out node.elem_type
end.

func tensor_type_dim(node: TypeNode, idx: int) -> int:
    out vec_get_rt(node.fields, idx)
end.

func tensor_type_stride(node: TypeNode, idx: int) -> int:
    var stride = 1
    var k = idx + 1
    let rank = node.return_type
    let shape = node.fields
    when k < rank loop
        stride = stride * (vec_get_rt(shape, k) as int)
        k = k + 1
    end
    out stride
end.

func tensor_type_numel(node: TypeNode) -> int:
    let rank = node.return_type
    if rank == 0 do
        out 0
    end
    let shape = node.fields
    var total = 1
    var k = 0
    when k < rank loop
        total = total * (vec_get_rt(shape, k) as int)
        k = k + 1
    end
    out total
end.

func tensor_type_new(tbl: TypeTable, elem_type_id: int, shape_vec: int) -> int:
    let rank = vec_len_rt(shape_vec)
    var numel = 1
    var k = 0
    when k < rank loop
        numel = numel * (vec_get_rt(shape_vec, k) as int)
        k = k + 1
    end
    let node = TypeNode (
        kind: TypeKind.Tensor,
        name_id: 0,
        size: 16 + numel * 8,
        elem_type: elem_type_id,
        return_type: rank,
        fields: shape_vec
    )
    out type_alloc(tbl, node)
end.

func type_can_binop(a: TypeKind, b: TypeKind, op: int):
    # op: 0=Add, 1=Sub, 2=Mul, 3=Div, 4=Mod, 5=Eq, 6=Ne, 7=Lt, 8=Le, 9=Gt, 10=Ge
    # String only supports Add (concat) and Eq/Ne
    if a == TypeKind.String or b == TypeKind.String do
        if a != b do
            out false
        end
        out op == 0 or op == 5 or op == 6
    end
    # Bool only supports Eq/Ne and logic (And/Or)
    if a == TypeKind.Bool or b == TypeKind.Bool do
        if a != b do
            out false
        end
        out op >= 5
    end
    # Numeric types can do everything
    if type_is_numeric(a) and type_is_numeric(b) do
        out true
    end
    if a == TypeKind.Flux and b == TypeKind.Flux do
        out true
    end
    out false
end.

func type_common(a: TypeKind, b: TypeKind):
    # Return the common type for implicit promotion
    if a == b do
        out a
    end
    # int + float -> float
    if type_is_numeric(a) and type_is_numeric(b) do
        out TypeKind.Float
    end
    out TypeKind.Void # incompatible
end.
