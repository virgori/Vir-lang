##
 * compiler/src/semantic/types/walk.vri — Pass 4: AST Type Annotation Walk
 ##

include ide_facts
include rt_vec_rt
include rt_string_rt
include parser
include symbol_table
include scope_tree
include types_table
include types_tensor
include sem_types_resolve

func pass4_walk(ref symbols: SymbolTable, ref scopes: ScopeTree, node: &AstNode):
    if node as i64 == 0 do
        out 0
    end

    if node.node_type == AstType.VarDeclGroup do
        child_count = vec_len_rt(node.children)
        var vi = 0
        when vi < child_count loop
            child = vec_get_rt(node.children, vi)
            pass4_walk(symbols, scopes, child)
            vi = vi + 1
        end
        out 0
    end

    if node.node_type == AstType.VarDecl or node.node_type == AstType.ConstDecl do
        if fat_str_len(node.name2) > 0 do
            resolved = pass4_resolve_type_name(node.name2)
            pass4_update_symbol_type(symbols, scopes, node.name, resolved, node)
            if resolved == TypeKind.Tensor do
                node.builtin_id = tdesc_from_annotation(node.name2 as int)
            end
        end
        child_count = vec_len_rt(node.children)
        var i = 0
        when i < child_count loop
            child = vec_get_rt(node.children, i)
            pass4_walk(symbols, scopes, child)
            i = i + 1
        end
        out 0
    end

    if node.node_type == AstType.FuncDef do
        if fat_str_len(node.name2) > 0 do
            ret_type = pass4_resolve_type_name(node.name2)
            pass4_update_func_return(symbols, scopes, node.name, ret_type)
            if ret_type == TypeKind.Tensor do
                node.op = tdesc_from_annotation(node.name2 as int) as OpType
            end
        end
        scope_push(scopes, ScopeKind.Func)
        child_count = vec_len_rt(node.children)
        body_idx = child_count - 1
        if body_idx < 0 do
            body_idx = 0
        end
        var bi = 0
        when bi < child_count loop
            ch = vec_get_rt(node.children, bi)
            if ch.node_type == AstType.Block do
                body_idx = bi
                bi = child_count
            else
                bi = bi + 1
            end
        end
        var i = 0
        when i < body_idx loop
            param = vec_get_rt(node.children, i)
            if fat_str_len(param.name2) > 0 do
                param_type = pass4_resolve_type_name(param.name2)
                pass4_update_symbol_type(symbols, scopes, param.name, param_type, param)
                if param_type == TypeKind.Tensor do
                    param.builtin_id = tdesc_from_annotation(param.name2 as int)
                end
            end
            i = i + 1
        end
        var j = body_idx
        when j < child_count loop
            child = vec_get_rt(node.children, j)
            pass4_walk(symbols, scopes, child)
            j = j + 1
        end
        scope_pop(scopes)
        out 0
    end

    if node.node_type == AstType.ExternFunc do
        ret_type = pass4_resolve_type_name(node.name2)
        pass4_update_func_return(symbols, scopes, node.name, ret_type)
        pass4_update_func_ast(symbols, scopes, node.name, node)
        if ret_type == TypeKind.Tensor do
            node.op = tdesc_from_annotation(node.name2 as int) as OpType
        end
        out 0
    end

    if node.node_type == AstType.EntityDef or node.node_type == AstType.PackedDef or node.node_type == AstType.RegisterDef or node.node_type == AstType.ClassDef do
        child_count = vec_len_rt(node.children)
        var i = 0
        when i < child_count loop
            field = vec_get_rt(node.children, i)
            if fat_str_len(field.name2) > 0 do
                field_type = pass4_resolve_type_name(field.name2)
                if field_type == TypeKind.Tensor do
                    field.builtin_id = tdesc_from_annotation(field.name2 as int)
                end
            end
            i = i + 1
        end
        out 0
    end

    if node.node_type == AstType.CastExpr do
        if is_tensor_type_str(node.name as int) do
            node.builtin_id = tdesc_from_annotation(node.name as int)
        end
    end

    if node.node_type == AstType.Block do
        scope_push(scopes, ScopeKind.Block)
        child_count = vec_len_rt(node.children)
        var i = 0
        when i < child_count loop
            child = vec_get_rt(node.children, i)
            pass4_walk(symbols, scopes, child)
            i = i + 1
        end
        scope_pop(scopes)
        out 0
    end

    # Default: recurse
    child_count = vec_len_rt(node.children)
    var i = 0
    when i < child_count loop
        child = vec_get_rt(node.children, i)
        pass4_walk(symbols, scopes, child)
        i = i + 1
    end
    out 0
end.

func pass4_update_symbol_type(ref symbols: SymbolTable, ref scopes: ScopeTree, name: &string, type_kind: TypeKind, ast_node: &AstNode):
    ideFactType(ast_node as int, type_kind as int)
    if fat_str_len(name) == 0 do
        out 0
    end
    curr = scopes.current_id
    tbl_syms = native_read_i64(symbols as i64, 0)
    when curr >= 0 loop
        scope_node = vec_get_rt(scopes.scopes, curr)
        count = vec_len_rt(scope_node.symbols)
        var i = 0
        when i < count loop
            sym_id = vec_get_rt(scope_node.symbols, i)
            sym = vec_get_rt(tbl_syms, sym_id)
            sym_name = native_read_i64(sym as i64, 8) as string
            if fat_str_eq(sym_name, name) do
                native_write_i64(sym as i64, 16, type_kind as i64)
                native_write_i64(sym as i64, 32, ast_node as i64)
                sym.type_id = type_kind as i64
                sym.ast_id = ast_node as i64
                out 0
            end
            i = i + 1
        end
        curr = scope_node.parent_id
    end
    out 0
end.

func pass4_update_func_return(ref symbols: SymbolTable, ref scopes: ScopeTree, name: &string, ret_type: TypeKind):
    if fat_str_len(name) == 0 do
        out 0
    end
    curr = scopes.current_id
    tbl_syms = native_read_i64(symbols as i64, 0)
    when curr >= 0 loop
        scope_node = vec_get_rt(scopes.scopes, curr)
        count = vec_len_rt(scope_node.symbols)
        var i = 0
        when i < count loop
            sym_id = vec_get_rt(scope_node.symbols, i)
            sym = vec_get_rt(tbl_syms, sym_id)
            sym_name = native_read_i64(sym as i64, 8) as string
            if fat_str_eq(sym_name, name) do
                native_write_i64(sym as i64, 64, ret_type as i64)
                sym.return_type = ret_type as i64
                out 0
            end
            i = i + 1
        end
        curr = scope_node.parent_id
    end
    out 0
end.

func pass4_update_func_ast(ref symbols: SymbolTable, ref scopes: ScopeTree, name: &string, ast_node: &AstNode):
    if fat_str_len(name) == 0 do out 0 end
    curr = scopes.current_id
    tbl_syms = native_read_i64(symbols as i64, 0)
    when curr >= 0 loop
        scope_node = vec_get_rt(scopes.scopes, curr)
        count = vec_len_rt(scope_node.symbols)
        var i = 0
        when i < count loop
            sym_id = vec_get_rt(scope_node.symbols, i)
            sym = vec_get_rt(tbl_syms, sym_id)
            sym_name = native_read_i64(sym as i64, 8) as string
            if fat_str_eq(sym_name, name) do
                native_write_i64(sym as i64, 32, ast_node as i64)
                sym.ast_id = ast_node as i64
                out 0
            end
            i = i + 1
        end
        curr = scope_node.parent_id
    end
    out 0
end.
