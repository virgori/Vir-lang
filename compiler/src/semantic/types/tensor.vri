##
 * compiler/src/semantic/types/tensor.vri — Tensor & Flux Type Parsers and Properties
 ##

include rt_vec_rt
include rt_string_rt
include types_table

func is_tensor_type_str(name: int) -> bool:
    if (name as i64) < 4096 do out false end
    let n_len = fat_str_len(name as int)
    if n_len < 6 do out false end
    let c0 = fat_str_byte_at(name as int, 0)
    let c1 = fat_str_byte_at(name as int, 1)
    let c2 = fat_str_byte_at(name as int, 2)
    let c3 = fat_str_byte_at(name as int, 3)
    let c4 = fat_str_byte_at(name as int, 4)
    let c5 = fat_str_byte_at(name as int, 5)
    out c0 == 116 and c1 == 101 and c2 == 110 and c3 == 115 and c4 == 111 and c5 == 114
end.

func raw_parse_tensor_elem_code(type_str: int) -> int:
    let n = fat_str_len(type_str as int)
    if n < 8 do out 0 end
    var i = 6
    when i < n and fat_str_byte_at(type_str as int, i) == 32 loop
        i = i + 1
    end
    if i >= n or fat_str_byte_at(type_str as int, i) != 91 do
        out 0
    end
    let lbracket_pos = i
    var semi_pos = 0 - 1
    i = lbracket_pos + 1
    when i < n loop
        let b = fat_str_byte_at(type_str as int, i)
        if b == 59 do
            semi_pos = i
            i = n
        eif b == 93 do
            i = n
        else
            i = i + 1
        end
    end
    if semi_pos < 0 do out 0 end
    var start = lbracket_pos + 1
    when start < semi_pos and fat_str_byte_at(type_str as int, start) == 32 loop
        start = start + 1
    end
    var end_p = semi_pos
    when end_p > start and fat_str_byte_at(type_str as int, end_p - 1) == 32 loop
        end_p = end_p - 1
    end
    let width = end_p - start
    let a = fat_str_byte_at(type_str as int, start)
    var b = 0
    if width >= 2 do b = fat_str_byte_at(type_str as int, start + 1) end
    var c = 0
    if width == 3 do c = fat_str_byte_at(type_str as int, start + 2) end
    if width == 3 and a == 102 and b == 51 and c == 50 do out 1 end
    if width == 3 and a == 102 and b == 49 and c == 54 do out 2 end
    if width == 2 and a == 105 and b == 56 do out 3 end
    if width == 2 and a == 117 and b == 56 do out 4 end
    if width == 3 and a == 105 and b == 51 and c == 50 do out 5 end
    if width == 3 and a == 105 and b == 110 and c == 116 do out 6 end
    if width == 3 and a == 105 and b == 54 and c == 52 do out 6 end
    if width == 3 and a == 102 and b == 54 and c == 52 do out 7 end
    if width == 5 and a == 102 and b == 108 do out 7 end
    out 0
end.

func raw_tensor_elem_byte_size(elem_code: int) -> int:
    if elem_code == 1 or elem_code == 5 do out 4 end
    if elem_code == 2 do out 2 end
    if elem_code == 3 or elem_code == 4 do out 1 end
    out 8
end.

func raw_parse_tensor_shape(type_str: string) -> int:
    var vec = vec_new_rt()
    let n_len = fat_str_len(type_str as int)
    if n_len == 0 do out vec end
    var semi_pos = 0 - 1
    var i = 0
    when i < n_len loop
        let b = fat_str_byte_at(type_str as int, i)
        if b == 59 do
            semi_pos = i
            i = n_len
        else
            i = i + 1
        end
    end
    if semi_pos < 0 do out vec end
    i = semi_pos + 1
    var cur_num = 0
    var in_num = false
    when i < n_len loop
        let c = fat_str_byte_at(type_str as int, i)
        if c == 93 do
            if in_num do
                vec = vec_push_rt(vec, cur_num)
                cur_num = 0
                in_num = false
            end
            i = n_len
        eif c >= 48 and c <= 57 do
            cur_num = cur_num * 10 + (c - 48)
            in_num = true
        eif c == 44 do
            if in_num do
                vec = vec_push_rt(vec, cur_num)
                cur_num = 0
                in_num = false
            end
        end
        i = i + 1
    end
    out vec
end.

# ---------------------------------------------------------------------------
# Structured tensor descriptors (VIRC-ISS-0016)
#
# A descriptor is an interned integer handle (0 = "not a tensor") over two flat
# parallel stores: element code and shape vector.  Lowering consumes handles
# through the tdesc_* accessors and never scans a serialized type name.  The
# only decoder is tdesc_from_annotation, which turns a *source annotation* into
# a handle once, at the declaration boundary; synthesized result types (matmul)
# are produced structurally by tdesc_matmul_result.  The stores are plain int
# vectors on purpose: the bootstrap compiler does not reliably resolve entity
# field offsets through untyped locals.
# ---------------------------------------------------------------------------
var g_td_elem: int = 0
var g_td_shape: int = 0

func tdesc_shape_equal(a: int, b: int) -> bool:
    let n = vec_len_rt(a)
    if n != vec_len_rt(b) do out false end
    var i = 0
    when i < n loop
        if (vec_get_rt(a, i) as int) != (vec_get_rt(b, i) as int) do out false end
        i = i + 1
    end
    out true
end.

func tdesc_new(elem_code: int, shape: int) -> int:
    if vec_len_rt(shape) == 0 do out 0 end
    if g_td_elem == 0 do
        g_td_elem = vec_new_rt()
        g_td_shape = vec_new_rt()
    end
    let n = vec_len_rt(g_td_elem)
    var i = 0
    when i < n loop
        if (vec_get_rt(g_td_elem, i) as int) == elem_code and tdesc_shape_equal(vec_get_rt(g_td_shape, i) as int, shape) do
            out i + 1
        end
        i = i + 1
    end
    g_td_elem = vec_push_rt(g_td_elem, elem_code as i64)
    g_td_shape = vec_push_rt(g_td_shape, shape as i64)
    out n + 1
end.

func tdesc_from_annotation(type_str: int) -> int:
    if (type_str as i64) < 4096 do out 0 end
    if not is_tensor_type_str(type_str) do out 0 end
    out tdesc_new(raw_parse_tensor_elem_code(type_str), raw_parse_tensor_shape(type_str as string))
end.

func tdesc_elem_code(d: int) -> int:
    if d <= 0 do out 0 end
    out vec_get_rt(g_td_elem, d - 1) as int
end.

func tdesc_elem_size(d: int) -> int:
    out raw_tensor_elem_byte_size(tdesc_elem_code(d))
end.

func tdesc_is_float(d: int) -> bool:
    let c = tdesc_elem_code(d)
    out c == 1 or c == 2 or c == 7
end.

func tdesc_shape(d: int) -> int:
    if d <= 0 do out vec_new_rt() end
    out vec_get_rt(g_td_shape, d - 1) as int
end.

func tdesc_rank(d: int) -> int:
    if d <= 0 do out 0 end
    out vec_len_rt(vec_get_rt(g_td_shape, d - 1) as int)
end.

func tdesc_dim(d: int, k: int) -> int:
    if d <= 0 or k < 0 or k >= tdesc_rank(d) do out 0 end
    out vec_get_rt(vec_get_rt(g_td_shape, d - 1) as int, k) as int
end.

func tdesc_stride(d: int, k: int) -> int:
    let rank = tdesc_rank(d)
    if k >= 0 and k < rank do
        var st = 1
        var j = k + 1
        when j < rank loop
            st = st * tdesc_dim(d, j)
            j = j + 1
        end
        out st
    end
    out 1
end.

func tdesc_numel(d: int) -> int:
    let rank = tdesc_rank(d)
    if rank == 0 do out 0 end
    var total = 1
    var k = 0
    when k < rank loop
        total = total * tdesc_dim(d, k)
        k = k + 1
    end
    out total
end.

# Element promotion for a rank-2 matmul/FMA result: f64 > f32 > f16 > i32 >
# i8 > u8, otherwise the default 64-bit integer.
func tdesc_promote_elem(l_code: int, r_code: int) -> int:
    if l_code == 7 or r_code == 7 do out 7 end
    if l_code == 1 or r_code == 1 do out 1 end
    if l_code == 2 or r_code == 2 do out 2 end
    if l_code == 5 or r_code == 5 do out 5 end
    if l_code == 3 or r_code == 3 do out 3 end
    if l_code == 4 or r_code == 4 do out 4 end
    out 6
end.

func tdesc_matmul_shape(rows: int, cols: int) -> int:
    var shp = vec_new_rt()
    shp = vec_push_rt(shp, rows as i64)
    shp = vec_push_rt(shp, cols as i64)
    out shp
end.

# Result of a rank-2 x rank-2 matmul: [rows(a), cols(b)] with promoted element.
# Returns 0 when either operand is not a rank>=2 tensor.
func tdesc_matmul_result(a: int, b: int) -> int:
    if tdesc_rank(a) < 2 or tdesc_rank(b) < 2 do out 0 end
    let code = tdesc_promote_elem(tdesc_elem_code(a), tdesc_elem_code(b))
    out tdesc_new(code, tdesc_matmul_shape(tdesc_dim(a, 0), tdesc_dim(b, 1)))
end.

# Result with an explicit element code (quantized-left matmul).
func tdesc_matmul_result_elem(rows: int, cols: int, code: int) -> int:
    out tdesc_new(code, tdesc_matmul_shape(rows, cols))
end.

func tdesc_elem_name(code: int) -> string:
    if code == 1 do out fat_str_new("f32") end
    if code == 2 do out fat_str_new("f16") end
    if code == 3 do out fat_str_new("i8") end
    if code == 4 do out fat_str_new("u8") end
    if code == 5 do out fat_str_new("i32") end
    if code == 7 do out fat_str_new("f64") end
    out fat_str_new("int")
end.

# Serialize a descriptor for the string-typed lowering tables.  This builds a
# name from structure; nothing reads it back except the annotation decoder.
func tdesc_type_string(d: int) -> string:
    if d <= 0 do out fat_str_new("") end
    var res = fat_str_concat(fat_str_new("tensor["), tdesc_elem_name(tdesc_elem_code(d)))
    res = fat_str_concat(res, fat_str_new(";"))
    let rank = tdesc_rank(d)
    var k = 0
    when k < rank loop
        if k > 0 do res = fat_str_concat(res, fat_str_new(",")) end
        res = fat_str_concat(res, fat_str_new(" "))
        res = fat_str_concat(res, fat_str_new(rt_itoa(tdesc_dim(d, k))))
        k = k + 1
    end
    out fat_str_concat(res, fat_str_new("]"))
end.

func parse_tensor_elem_code(type_str: int) -> int:
    out raw_parse_tensor_elem_code(type_str)
end.

func tensor_type_is_well_formed(type_str: int) -> bool:
    let n = fat_str_len(type_str as int)
    if raw_parse_tensor_elem_code(type_str) == 0 do out false end
    var semi_pos = 0 - 1
    var i = 0
    when i < n loop
        let b = fat_str_byte_at(type_str as int, i)
        if b == 59 do
            semi_pos = i
            i = n
        else
            i = i + 1
        end
    end
    if semi_pos < 0 do out false end
    i = semi_pos + 1
    var rank = 0
    var total = 1
    var dim = 0
    var digits = 0
    when i < n loop
        let ch = fat_str_byte_at(type_str as int, i)
        if ch >= 48 and ch <= 57 do
            if dim > 26843545 do out false end
            dim = dim * 10 + ch - 48
            digits = digits + 1
        eif ch == 44 or ch == 93 do
            if digits == 0 or dim <= 0 do out false end
            if total > 268435456 / dim do out false end
            total = total * dim
            rank = rank + 1
            dim = 0
            digits = 0
            if ch == 93 do
                var rem = i + 1
                when rem < n and fat_str_byte_at(type_str as int, rem) == 32 loop
                    rem = rem + 1
                end
                out rank > 0 and rem == n
            end
        eif ch == 32 do
            # Allow whitespace inside dimensions
        else
            out false
        end
        i = i + 1
    end
    out false
end.

func parse_tensor_elem_type(type_str: &string) -> TypeKind:
    let code = raw_parse_tensor_elem_code(type_str as int)
    if code == 1 or code == 2 or code == 7 do out TypeKind.Float end
    out TypeKind.Int
end.

func parse_tensor_shape(type_str: string) -> int:
    out raw_parse_tensor_shape(type_str)
end.

func parse_tensor_rank(type_str: &string) -> int:
    let shp = raw_parse_tensor_shape(type_str as string)
    out vec_len_rt(shp)
end.

func parse_tensor_stride(type_str: string, idx: int) -> int:
    let shp = raw_parse_tensor_shape(type_str as string)
    let rank = vec_len_rt(shp)
    if idx >= 0 and idx < rank do
        var st = 1
        var k = idx + 1
        when k < rank loop
            st = st * (vec_get_rt(shp, k) as int)
            k = k + 1
        end
        out st
    end
    out 1
end.

func parse_tensor_numel(type_str: string) -> int:
    let shp = raw_parse_tensor_shape(type_str as string)
    let rank = vec_len_rt(shp)
    if rank == 0 do out 0 end
    var total = 1
    var k = 0
    when k < rank loop
        total = total * (vec_get_rt(shp, k) as int)
        k = k + 1
    end
    out total
end.

func tensor_elem_byte_size(type_str: string) -> int:
    let code = raw_parse_tensor_elem_code(type_str as int)
    out raw_tensor_elem_byte_size(code)
end.


func is_flux_type_str(name: int) -> bool:
    if (name as i64) < 4096 do out false end
    let n_len = fat_str_len(name as int)
    if n_len < 4 do out false end
    let c0 = fat_str_byte_at(name as int, 0)
    let c1 = fat_str_byte_at(name as int, 1)
    let c2 = fat_str_byte_at(name as int, 2)
    let c3 = fat_str_byte_at(name as int, 3)
    if c0 == 102 and c1 == 108 and c2 == 117 and c3 == 120 do
        if n_len == 4 do out true end
        let c4 = fat_str_byte_at(name as int, 4)
        if c4 == 60 or c4 == 32 or c4 == 40 do out true end
    end
    out false
end.

func parse_flux_lanes(type_str: int) -> int:
    if (type_str as i64) < 4096 do out -1 end
    let n_len = fat_str_len(type_str as int)
    if n_len < 6 do out -1 end
    var comma_pos = 0 - 1
    var i = 0
    when i < n_len loop
        let c = fat_str_byte_at(type_str as int, i)
        if c == 44 do
            comma_pos = i
        end
        i = i + 1
    end
    if comma_pos < 0 do out -1 end
    var lanes = 0
    var k = comma_pos + 1
    var has_digit = false
    when k < n_len loop
        let ch = fat_str_byte_at(type_str as int, k)
        if ch >= 48 and ch <= 57 do
            lanes = lanes * 10 + (ch - 48)
            has_digit = true
        eif ch == 62 or ch == 41 do
            k = n_len
        end
        k = k + 1
    end
    if not has_digit or lanes <= 0 do out -1 end
    out lanes
end.

func parse_flux_elem_type(type_str: int) -> TypeKind:
    if (type_str as i64) < 4096 do out TypeKind.Int end
    let n_len = fat_str_len(type_str as int)
    if n_len < 6 do out TypeKind.Int end
    var i = 0
    var in_elem = false
    var has_f = false
    when i < n_len loop
        let c = fat_str_byte_at(type_str as int, i)
        if c == 60 or c == 40 do
            in_elem = true
        eif in_elem do
            if c == 102 or c == 70 do
                has_f = true
            end
            if c == 44 or c == 62 or c == 41 do
                i = n_len
            end
        end
        i = i + 1
    end
    if has_f do out TypeKind.Float end
    out TypeKind.Int
end.

func flux_is_power_of_two(n: int) -> bool:
    if n <= 0 do out false end
    out (n and (n - 1)) == 0
end.

func swizzle_char_to_lane(c: int) -> int:
    if c == 120 or c == 114 do out 0 end
    if c == 121 or c == 103 do out 1 end
    if c == 122 or c == 98 do out 2 end
    if c == 119 or c == 97 do out 3 end
    out 0 - 1
end.
