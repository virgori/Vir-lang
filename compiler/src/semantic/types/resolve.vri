##
 * compiler/src/semantic/types/resolve.vri — Pass 4: Type Name Resolution
 ##

include types_table
include types_tensor

func pass4_resolve_type_name(name: &string):
    if fat_str_len(name) == 0 do
        out TypeKind.Void
    end
    let name_len = fat_str_len(name)
    if name_len >= 4 and fat_str_byte_at(name, 0) == 38 and fat_str_byte_at(name, 1) == 109 and fat_str_byte_at(name, 2) == 117 and fat_str_byte_at(name, 3) == 116 do
        out TypeKind.MutRef
    end
    if name_len >= 7 and fat_str_byte_at(name, 0) == 109 and fat_str_byte_at(name, 1) == 117 and fat_str_byte_at(name, 2) == 116 and fat_str_byte_at(name, 3) == 114 and fat_str_byte_at(name, 4) == 101 and fat_str_byte_at(name, 5) == 102 and fat_str_byte_at(name, 6) == 32 do
        out TypeKind.MutRef
    end
    if fat_str_byte_at(name, 0) == 38 do out TypeKind.Ref end
    if name_len >= 4 and fat_str_byte_at(name, 0) == 114 and fat_str_byte_at(name, 1) == 101 and fat_str_byte_at(name, 2) == 102 and fat_str_byte_at(name, 3) == 32 do
        out TypeKind.Ref
    end
    let primitive_kind = type_primitive_kind_from_name(name)
    if primitive_kind != TypeKind.Void do out primitive_kind end
    if fat_cstr_eq(name, "any") == 1 do out TypeKind.Void end

    # Compound & Advanced Vir Types (§4.1 - §4.5, §26.1)
    if is_tensor_type_str(name) do out TypeKind.Tensor end
    if fat_cstr_eq(name, "tensor") == 1 do out TypeKind.Tensor end
    if fat_cstr_eq(name, "array") == 1 do out TypeKind.Array end
    if fat_cstr_eq(name, "dict") == 1 do out TypeKind.Dict end
    if fat_cstr_eq(name, "tuple") == 1 do out TypeKind.Tuple end
    if fat_cstr_eq(name, "ref") == 1 or fat_cstr_eq(name, "&") == 1 do out TypeKind.Ref end
    if fat_cstr_eq(name, "mutref") == 1 or fat_cstr_eq(name, "&mut") == 1 do out TypeKind.MutRef end
    if fat_cstr_eq(name, "register") == 1 do out TypeKind.Register end
    if fat_cstr_eq(name, "mold") == 1 do out TypeKind.Mold end
    if fat_cstr_eq(name, "packed") == 1 do out TypeKind.Packed end
    if is_flux_type_str(name as int) do out TypeKind.Flux end
    if fat_cstr_eq(name, "flux") == 1 do out TypeKind.Flux end
    if fat_cstr_eq(name, "deck") == 1 do out TypeKind.Deck end
    if fat_cstr_eq(name, "optional") == 1 or fat_cstr_eq(name, "option") == 1 do out TypeKind.Optional end

    out TypeKind.Entity
end.
