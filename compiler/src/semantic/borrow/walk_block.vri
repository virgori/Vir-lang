##
 * compiler/src/semantic/borrow/walk_block.vri — Block & Arena Scope Borrow Walker
 * ==============================================================================
 * VIRC-PLN-0004 Section 5.6 & Phase 8: Borrow Analysis Decomposition.
 *
 * Enforces lexical block boundaries, out-of-scope reference escape detection (E5012),
 * local shadow binding restoration, and Arena region escape prevention (E5005).
 ##

include borrow_context
include borrow_binding
include borrow_paths
include borrow_loans
include borrow_moves
include borrow_scopes
include borrow_arena
include borrow_walk_stmts
include borrow_diagnostics

func pass8_walk_block(ref symbols: SymbolTable, ref scopes: ScopeTree, diag: &DiagnosticEngine,
                      node: &AstNode, moved_vars: int, shared_borrows: int, mut_borrows: int,
                      bound_borrows: int, arena_locals: int, pre_arena_names: int, in_arena: int,
                      var_types: int, func_locals: int, uninit_vars: int) -> int:
    scope_push(scopes, ScopeKind.Block)
    pass8_enter_binding_scope(node as i64)
    g_pass8_scope_depth = g_pass8_scope_depth + 1
    let cur_depth = g_pass8_scope_depth
    let shadow_frame = pass8_box_new()
    pass8_box_push(g_pass8_shadow_frames, shadow_frame)
    let bound_wm = pass8_box_len(bound_borrows)
    let shared_wm = pass8_box_len(shared_borrows)
    let mut_wm = pass8_box_len(mut_borrows)
    let claimed = pass8_walk_children_stmts(symbols, scopes, diag, node, moved_vars, shared_borrows, mut_borrows,
                                            bound_borrows, arena_locals, pre_arena_names, in_arena, var_types, func_locals, uninit_vars)
    # Check lexical lifetime escape at block exit:
    let b_len = pass8_box_len(bound_borrows)
    var bi = 0
    when bi < b_len loop
        let b_item = pass8_box_get(bound_borrows, bi)
        let b_lhs = borrow_binding_lhs(b_item)
        let b_tgt = borrow_binding_target(b_item)
        let lhs_depth = pass8_get_var_scope_depth(b_lhs)
        let root_tgt = pass8_root_owner(b_tgt)
        let tgt_depth = pass8_get_var_scope_depth(root_tgt)
        if lhs_depth > 0 and lhs_depth < cur_depth and tgt_depth >= cur_depth do
            let decl_line = pass8_get_var_decl_line(root_tgt)
            pass8_report_error_related(diag, 5012, pass8_ast_line(node), 0, b_lhs,
                                       decl_line, 0, "Owner declared here")
        end
        bi = bi + 1
    end

    # Release block-scoped borrows
    if in_arena == 0 do
        pass8_filter_out_scope_borrows(bound_borrows, cur_depth)
        pass8_truncate_to(bound_borrows, bound_wm)
    end
    pass8_truncate_to(shared_borrows, shared_wm)
    pass8_truncate_to(mut_borrows, mut_wm)
    pass8_filter_var_state_scope(moved_vars, cur_depth)
    pass8_filter_var_state_scope(uninit_vars, cur_depth)
    pass8_filter_var_state_scope(var_types, cur_depth)
    pass8_restore_local_bindings(moved_vars, shadow_frame)
    pass8_box_pop(g_pass8_shadow_frames)
    g_pass8_scope_depth = g_pass8_scope_depth - 1
    pass8_leave_binding_scope()
    scope_pop(scopes)
    out claimed
end.

func pass8_walk_arena_block(ref symbols: SymbolTable, ref scopes: ScopeTree, diag: &DiagnosticEngine,
                            node: &AstNode, moved_vars: int, shared_borrows: int, mut_borrows: int,
                            bound_borrows: int, arena_locals: int, pre_arena_names: int, in_arena: int,
                            var_types: int, func_locals: int, uninit_vars: int) -> int:
    scope_push(scopes, ScopeKind.Block)
    pass8_enter_binding_scope(node as i64)
    g_pass8_scope_depth = g_pass8_scope_depth + 1
    let moved_wm = pass8_box_len(moved_vars)
    let shared_wm = pass8_box_len(shared_borrows)
    let mut_wm = pass8_box_len(mut_borrows)
    let bound_wm = pass8_box_len(bound_borrows)
    let arena_wm = pass8_box_len(arena_locals)
    pass8_walk_children_stmts(symbols, scopes, diag, node, moved_vars, shared_borrows, mut_borrows,
                              bound_borrows, arena_locals, pre_arena_names, 1, var_types, func_locals, uninit_vars)
    pass8_check_arena_borrow_escape(diag, arena_locals, pre_arena_names, bound_borrows, pass8_ast_line(node))
    pass8_truncate_to(moved_vars, moved_wm)
    pass8_truncate_to(shared_borrows, shared_wm)
    pass8_truncate_to(mut_borrows, mut_wm)
    pass8_truncate_to(bound_borrows, bound_wm)
    pass8_truncate_to(arena_locals, arena_wm)
    g_pass8_scope_depth = g_pass8_scope_depth - 1
    pass8_leave_binding_scope()
    scope_pop(scopes)
    out 0
end.
