##
 * compiler/src/semantic/borrow/loans.vri — Borrow Loan Tracking
 * =============================================================
 * VIRC-PLN-0004 Section 5.6 & Phase 8: Borrow Analysis Decomposition.
 *
 * Tracks shared and mutable loans, exclusivity enforcement (& vs &mut),
 * active loan counts, IDE loan capture, and loan release upon scope exit.
 ##

include borrow_context
include borrow_binding
include borrow_paths
include borrow_moves

func pass8_conflicting_borrow_line(borrows: int, target: int):
    let target_key = pass8_state_path(target)
    var i = 0
    let count = pass8_box_len(borrows)
    when i < count loop
        let item = pass8_box_get(borrows, i)
        if pass8_paths_overlap(var_item_name(item), target_key) == 1 do
            out var_item_val(item)
        end
        i = i + 1
    end
    out 0
end.

func pass8_borrow_line(borrows: int, name: int):
    out pass8_conflicting_borrow_line(borrows, name)
end.

func pass8_first_borrow_line(borrows: int):
    if pass8_box_len(borrows) == 0 do out 0 end
    out var_item_val(pass8_box_get(borrows, 0))
end.

func pass8_borrow_count(borrows: int, name: int):
    let key = pass8_state_path(name)
    if borrows == 0 or pass8_strlen(key) == 0 do
        out 0
    end
    let v = native_read_i64(borrows, 0)
    let n = vec_len_rt(v)
    var total = 0
    var i = 0
    when i < n loop
        let item = vec_get_rt(v, i)
        if pass8_paths_overlap(var_item_name(item), key) == 1 do
            total = total + 1
        end
        i = i + 1
    end
    out total
end.

func pass8_truncate_to(lst: int, watermark: int):
    pass8_box_truncate_to(lst, watermark)
end.

func pass8_remove_one_borrow(borrows: int, name: int):
    let key = pass8_state_path(name)
    if pass8_strlen(key) == 0 do
        out 0
    end
    let item = pass8_box_find(borrows, key)
    if item == 0 do
        out 0
    end
    let len = pass8_box_len(borrows)
    var i = len - 1
    var v = 0
    when i >= 0 loop
        if pass8_box_get(borrows, i) == item do
            if i < len - 1 do
                pass8_box_set(borrows, i, pass8_box_get(borrows, len - 1))
            end
            v = native_read_i64(borrows, 0)
            vec_pop_rt(v)
            out 0
        end
        i = i - 1
    end
    out 0
end.

func pass8CaptureIdeLoan(node: int, name: int, bindings: int, shared: int, mutable: int):
    if g_ideFactsEnabled == 0 do out 0 end
    let key = pass8_state_path(name)
    var mode = 0
    var ownerKey = key
    if pass8_borrow_count(shared, name) > 0 do mode = mode or 1 end
    if pass8_borrow_count(mutable, name) > 0 do mode = mode or 2 end
    var index = 0
    when index < pass8_box_len(bindings) loop
        let binding = pass8_box_get(bindings, index)
        if pass8_streq(borrow_binding_lhs(binding), key) == 1 do
            mode = mode or borrow_binding_kind(binding)
            ownerKey = borrow_binding_target(binding)
        end
        index = index + 1
    end
    ideFactLoan(node, mode)
    var originLine = pass8_borrow_line(shared, ownerKey)
    if originLine == 0 do originLine = pass8_borrow_line(mutable, ownerKey) end
    ideFactResourceOrigins(node, 0, originLine, ownerKey)
end.

func pass8_release_borrower(bound_borrows: int, shared_borrows: int, mut_borrows: int, borrower: int):
    let borrower_key = pass8_state_path(borrower)
    if pass8_strlen(borrower_key) == 0 or bound_borrows == 0 do
        out 0
    end
    var released_count: int = 0
    var release_again: int = 1
    when release_again == 1 loop
        release_again = 0
        let len = pass8_box_len(bound_borrows)
        for release_idx in 0..len:
            if release_again == 0 do
                let b = pass8_box_get(bound_borrows, release_idx)
                if pass8_streq(borrow_binding_lhs(b), borrower_key) == 1 do
                    let tgt = borrow_binding_target(b)
                    if borrow_binding_kind(b) == 2 do
                        pass8_remove_one_borrow(mut_borrows, tgt)
                    else
                        pass8_remove_one_borrow(shared_borrows, tgt)
                    end
                    if release_idx < len - 1 do
                        pass8_box_set(bound_borrows, release_idx, pass8_box_get(bound_borrows, len - 1))
                    end
                    let v = native_read_i64(bound_borrows, 0)
                    vec_pop_rt(v)
                    released_count = released_count + 1
                    release_again = 1
                end
            end
        end
    end
    out released_count
end.

func pass8_borrow_binding_present(bindings: int, lhs: int, target: int, kind: int) -> int:
    if bindings == 0 do out 0 end
    let count = pass8_box_len(bindings)
    var i = 0
    when i < count loop
        let binding = pass8_box_get(bindings, i)
        if pass8_streq(borrow_binding_lhs(binding), lhs) == 1 and pass8_streq(borrow_binding_target(binding), target) == 1 and borrow_binding_kind(binding) == kind do
            out 1
        end
        i = i + 1
    end
    out 0
end.

func pass8_claim_borrow(bound_borrows: int, borrower: int, target: int, kind: int):
    let borrower_key = pass8_state_path(borrower)
    let target_key = pass8_state_path(target)
    if pass8_borrow_binding_present(bound_borrows, borrower_key, target_key, kind) == 1 do
        out 0
    end
    let binding = borrow_binding_new(borrower_key, target_key, kind)
    pass8_box_push(bound_borrows, binding as i64)
    out 0
end.

func pass8_borrow_state_equal(left: int, right: int) -> int:
    if left == 0 or right == 0 do out left == right end
    if pass8_box_len(left) != pass8_box_len(right) do out 0 end
    let count = pass8_box_len(left)
    var i = 0
    when i < count loop
        let binding = pass8_box_get(left, i)
        if pass8_borrow_binding_present(right, borrow_binding_lhs(binding), borrow_binding_target(binding), borrow_binding_kind(binding)) == 0 do
            out 0
        end
        i = i + 1
    end
    out 1
end.
