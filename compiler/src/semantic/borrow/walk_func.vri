##
 * compiler/src/semantic/borrow/walk_func.vri — Function Definition Borrow Context Walker
 * ======================================================================================
 * VIRC-PLN-0004 Section 5.6 & Phase 8: Borrow Analysis Decomposition.
 *
 * Establishes fresh function-level ownership tracking frames, parameter registers,
 * and scope boundaries for FuncDef AST nodes.
 ##

include borrow_context
include borrow_binding
include borrow_scopes
include borrow_moves
include borrow_loans

func pass8_walk_func_def(ref symbols: SymbolTable, ref scopes: ScopeTree, diag: &DiagnosticEngine,
                         node: &AstNode) -> int:
    let saved_flow_kind = g_pass8_flow_kind
    let saved_bindings = g_pass8_bindings
    let saved_scope_stack = g_pass8_scope_stack
    let saved_scope_ids = g_pass8_scope_ids
    let saved_var_scopes = g_pass8_var_scopes
    let saved_decl_lines = g_pass8_var_decl_lines
    let saved_loop_flows = g_pass8_loop_flows
    let saved_next_binding_id = g_pass8_next_binding_id
    let saved_next_scope_id = g_pass8_next_scope_id
    g_pass8_bindings = pass8_box_new()
    g_pass8_scope_stack = pass8_box_new()
    pass8_box_push(g_pass8_scope_stack, var_item_new(fat_str_new("scope"), 0) as i64)
    g_pass8_scope_ids = pass8_box_new()
    g_pass8_var_scopes = pass8_box_new()
    g_pass8_var_decl_lines = pass8_box_new()
    g_pass8_loop_flows = pass8_box_new()
    g_pass8_next_binding_id = 1
    g_pass8_next_scope_id = 1
    g_pass8_flow_kind = 0
    scope_push(scopes, ScopeKind.Func)
    pass8_enter_binding_scope(node as i64)
    let saved_scope_depth = g_pass8_scope_depth
    g_pass8_scope_depth = 1
    let old_params = g_pass8_func_params
    g_pass8_func_params = pass8_box_new()
    pass8_register_var_scope(fat_str_new("this"), 1, pass8_ast_line(node))
    pass8_box_push(g_pass8_func_params, var_item_new(pass8_state_path(fat_str_new("this")), 0) as i64)
    let func_moved = pass8_box_new()
    let func_shared = pass8_box_new()
    let func_mut = pass8_box_new()
    let func_bound_borrows = pass8_box_new()
    let func_arena_locals = pass8_box_new()
    let func_pre_arena = pass8_box_new()
    let func_var_types = pass8_box_new()
    let fn_locals = pass8_box_new()
    let func_uninit = pass8_box_new()

    let child_count = vec_len_rt(pass8_ast_children(node))
    var i = 0
    when i < child_count loop
        let child = vec_get_rt(pass8_ast_children(node), i)
        if pass8_ast_type(child) == AstType.Identifier or pass8_ast_type(child) == AstType.ParamDef or pass8_ast_type(child) == AstType.RefParam or pass8_ast_type(child) == AstType.OutParam do
            if pass8_strlen(pass8_ast_name(child)) > 0 do
                let child_name = pass8_ast_name(child)
                pass8_register_var_scope(child_name, 1, pass8_ast_line(child))
                let fn_item = var_item_new(pass8_state_path(child_name), 0)
                pass8_box_push(fn_locals, fn_item as i64)
                let p_item = var_item_new(pass8_state_path(child_name), 0)
                pass8_box_push(g_pass8_func_params, p_item as i64)
                if pass8_ast_type(child) == AstType.RefParam or pass8_ast_type(child) == AstType.OutParam do
                    pass8_register_var_type(func_var_types, child_name, TypeKind.Ref)
                else
                    let p_type_str = pass8_ast_name2(child)
                    let p_kind = pass8_type_kind_from_type_str(p_type_str)
                    pass8_register_var_type(func_var_types, child_name, p_kind)
                end
            end
        end
        pass8_walk(symbols, scopes, diag, child, func_moved, func_shared, func_mut,
                   func_bound_borrows, func_arena_locals, func_pre_arena, 0, func_var_types, fn_locals, func_uninit)
        i = i + 1
    end
    g_pass8_func_params = old_params
    g_pass8_flow_kind = saved_flow_kind
    g_pass8_scope_depth = saved_scope_depth
    pass8_leave_binding_scope()
    g_pass8_bindings = saved_bindings
    g_pass8_scope_stack = saved_scope_stack
    g_pass8_scope_ids = saved_scope_ids
    g_pass8_var_scopes = saved_var_scopes
    g_pass8_var_decl_lines = saved_decl_lines
    g_pass8_loop_flows = saved_loop_flows
    g_pass8_next_binding_id = saved_next_binding_id
    g_pass8_next_scope_id = saved_next_scope_id
    scope_pop(scopes)
    out 0
end.
