##
 * compiler/src/semantic/borrow/arena.vri — Arena Lifetime Escape Checking
 * ======================================================================
 * VIRC-PLN-0004 Section 5.6 & Phase 8: Borrow Analysis Decomposition.
 *
 * Enforces Arena region lifetime boundaries:
 *   - Owned values may leave Arena by moving or assigning to an outer owner.
 *   - Borrows of Arena allocations escaping to outer scopes are rejected with E5005.
 ##

include borrow_context
include borrow_binding
include borrow_paths
include borrow_moves
include borrow_loans
include borrow_diagnostics

func pass8_expr_has_arena_local(expr: &AstNode, arena_locals: int, in_arena: int):
    if (expr as i64) == 0 do
        out 0
    end
    if pass8_ast_type(expr) == AstType.Identifier do
        if pass8_vec_contains(arena_locals, pass8_state_path(pass8_ast_name(expr))) == 1 do
            out 1
        end
        out 0
    end
    let child_count = vec_len_rt(pass8_ast_children(expr))
    var i = 0
    when i < child_count loop
        let child = vec_get_rt(pass8_ast_children(expr), i)
        if pass8_expr_has_arena_local(child, arena_locals, in_arena) == 1 do
            out 1
        end
        i = i + 1
    end
    out 0
end.

func pass8_check_arena_escape_assign(diag: &DiagnosticEngine, lhs: string, rhs: &AstNode,
                                     arena_locals: int, pre_arena_names: int, in_arena: int, line: int):
    # Owned values may escape by being moved or assigned to a longer-lived owner (Spec §4.5–§4.8.5).
    # Borrow escapes are strictly rejected with E5005.
    let lhs_key = pass8_state_path(lhs)
    if in_arena == 1 and pass8_vec_contains(pre_arena_names, lhs_key) == 1 do
        if (rhs as i64) != 0 do
            var rhs_esc = rhs
            when (rhs_esc as i64) != 0 and pass8_ast_type(rhs_esc) == AstType.CastExpr and vec_len_rt(pass8_ast_children(rhs_esc)) > 0 loop
                rhs_esc = vec_get_rt(pass8_ast_children(rhs_esc), 0) as AstNode
            end
            let rt = pass8_ast_type(rhs_esc)
            if rt == AstType.AddrOf do
                let tgt = pass8_get_addr_target(rhs_esc)
                if pass8_strlen(tgt) > 0 and pass8_vec_contains(arena_locals, tgt) == 1 do
                    pass8_report_error(diag, 5005, line, 0)
                    out 1
                end
            end
            if pass8_expr_has_arena_local(rhs_esc, arena_locals, in_arena) == 1 and rt == AstType.AddrOf do
                pass8_report_error(diag, 5005, line, 0)
                out 1
            end
        end
    end
    out 0
end.

func pass8_register_arena_local(arena_locals: int, pre_arena_names: int, name: string, in_arena: int):
    if pass8_strlen(name) == 0 do
        out 0
    end
    let key = pass8_state_path(name)
    if in_arena == 0 do
        if pass8_vec_contains(pre_arena_names, key) == 0 do
            let pre_item = var_item_new(key, 0)
            pass8_box_push(pre_arena_names, pre_item as i64)
        end
        out 0
    end
    if pass8_vec_contains(pre_arena_names, key) == 1 do
        out 0
    end
    if pass8_vec_contains(arena_locals, key) == 0 do
        let arena_item = var_item_new(key, 0)
        pass8_box_push(arena_locals, arena_item as i64)
    end
    out 0
end.

func pass8_check_arena_borrow_escape(diag: &DiagnosticEngine, arena_locals: int, pre_arena_names: int,
                                     bound_borrows: int, line: int):
    let count = pass8_box_len(bound_borrows)
    var i = 0
    when i < count loop
        let b = pass8_box_get(bound_borrows, i)
        let tgt = borrow_binding_target(b)
        let lhs = borrow_binding_lhs(b)
        if pass8_vec_contains(arena_locals, tgt) == 1 do
            if pass8_vec_contains(pre_arena_names, lhs) == 1 do
                pass8_report_error(diag, 5005, line, 0)
            end
        end
        i = i + 1
    end
    out 0
end.
