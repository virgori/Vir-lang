##
 * compiler/src/semantic/borrow/loops.vri — Borrow Loop Edge Analysis
 * =================================================================
 * VIRC-PLN-0004 Section 5.6 & Phase 8: Borrow Analysis Decomposition.
 *
 * Tracks break and continue edges, fixed-point loop flow lattice joins,
 * and loop body termination proofs.
 ##

include borrow_context
include borrow_state

# Loop edge accumulator. Slots 0..4 are break states, 5..9 are skip/back-edge
# states. Each component is a boxed finite-lattice set.
func pass8_loop_flow_new():
    let flow = vir_alloc(80)
    var flow_slot = 0
    when flow_slot < 10 loop
        native_write_i64(flow, flow_slot * 8, pass8_box_new() as i64)
        flow_slot = flow_slot + 1
    end
    out flow
end.

func pass8_loop_flow_box(flow: int, slot: int):
    if flow == 0 or slot < 0 or slot >= 10 do out 0 end
    out native_read_i64(flow, slot * 8)
end.

func pass8_current_loop_flow():
    if g_pass8_loop_flows == 0 or pass8_box_len(g_pass8_loop_flows) == 0 do out 0 end
    out pass8_box_get(g_pass8_loop_flows, pass8_box_len(g_pass8_loop_flows) - 1)
end.

func pass8_capture_loop_edge(kind: int, moved_vars: int, shared_borrows: int, mut_borrows: int,
                             bound_borrows: int, uninit_vars: int):
    let edge_flow = pass8_current_loop_flow()
    if edge_flow == 0 do out 0 end
    var edge_base = 0
    if kind == 2 do edge_base = 5 end
    pass8_merge_moved_box(pass8_loop_flow_box(edge_flow, edge_base), moved_vars)
    pass8_merge_borrows_box(pass8_loop_flow_box(edge_flow, edge_base + 1), shared_borrows)
    pass8_merge_borrows_box(pass8_loop_flow_box(edge_flow, edge_base + 2), mut_borrows)
    pass8_merge_bound_box(pass8_loop_flow_box(edge_flow, edge_base + 3), bound_borrows)
    pass8_merge_moved_box(pass8_loop_flow_box(edge_flow, edge_base + 4), uninit_vars)
    out 0
end.

func pass8_merge_loop_edge(flow: int, base: int, moved_vars: int, shared_borrows: int,
                           mut_borrows: int, bound_borrows: int, uninit_vars: int):
    if flow == 0 do out 0 end
    pass8_merge_moved_box(moved_vars, pass8_loop_flow_box(flow, base))
    pass8_merge_borrows_box(shared_borrows, pass8_loop_flow_box(flow, base + 1))
    pass8_merge_borrows_box(mut_borrows, pass8_loop_flow_box(flow, base + 2))
    pass8_merge_bound_box(bound_borrows, pass8_loop_flow_box(flow, base + 3))
    pass8_merge_moved_box(uninit_vars, pass8_loop_flow_box(flow, base + 4))
    out 0
end.

func pass8_loop_body_terminates(node: &AstNode) -> int:
    if (node as i64) == 0 do out 0 end
    let nt = pass8_ast_type(node)
    if nt == AstType.ReturnStmt or nt == AstType.ThrowStmt or nt == AstType.BreakStmt do
        out 1
    end
    if nt == AstType.Block do
        let ch_vec = pass8_ast_children(node)
        if ch_vec != 0 do
            let count = vec_len_rt(ch_vec)
            var i = 0
            when i < count loop
                let ch = vec_get_rt(ch_vec, i)
                if pass8_loop_body_terminates(ch) == 1 do
                    out 1
                end
                i = i + 1
            end
        end
    end
    if nt == AstType.IfStmt do
        let ch_vec = pass8_ast_children(node)
        if ch_vec != 0 do
            let count = vec_len_rt(ch_vec)
            if count > 2 do
                let then_ch = vec_get_rt(ch_vec, 1)
                let else_ch = vec_get_rt(ch_vec, 2)
                if pass8_loop_body_terminates(then_ch) == 1 and pass8_loop_body_terminates(else_ch) == 1 do
                    out 1
                end
            end
        end
    end
    out 0
end.
