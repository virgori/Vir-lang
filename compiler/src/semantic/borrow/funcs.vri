##
 * compiler/src/semantic/borrow/funcs.vri — Function & Parameter Index
 * ==================================================================
 * VIRC-PLN-0004 Section 5.6 & Phase 8: Borrow Analysis Decomposition.
 *
 * Traverses AST to map functions and parameter declarations for
 * by-value / by-ref ownership and out-parameter tracking.
 ##

include borrow_context

func pass8_collect_funcs(node: &AstNode, func_map: int):
    if (node as i64) == 0 do out 0 end
    var queue = vec_new_rt()
    queue = vec_push_rt(queue, node as int)
    var qi = 0
    when qi < vec_len_rt(queue) loop
        let cur = vec_get_rt(queue, qi) as AstNode
        qi = qi + 1
        if (cur as i64) != 0 do
            let nt = pass8_ast_type(cur)
            if nt == AstType.FuncDef do
                let fname = pass8_ast_name(cur)
                if pass8_strlen(fname) > 0 do
                    let item = var_item_new(fname, cur as int)
                    pass8_map_index(func_map, fname, item as int)
                end
            end
            if nt != AstType.FuncDef do
                let ch_vec = pass8_ast_children(cur)
                if ch_vec != 0 do
                    let count = vec_len_rt(ch_vec)
                    var i = 0
                    when i < count loop
                        let ch = vec_get_rt(ch_vec, i)
                        queue = vec_push_rt(queue, ch)
                        i = i + 1
                    end
                end
            end
        end
    end
    vec_free_rt(queue)
    out 0
end.

func pass8_find_func(fname: string):
    if g_pass8_func_map == 0 or pass8_strlen(fname) == 0 do
        out 0 as AstNode
    end
    let item = pass8_map_find(g_pass8_func_map, fname)
    if item != 0 do
        out var_item_val(item) as AstNode
    end
    out 0 as AstNode
end.

func pass8_get_param(fn_node: &AstNode, param_idx: int):
    if (fn_node as i64) == 0 or param_idx < 0 do
        out 0 as AstNode
    end
    let ch_vec = pass8_ast_children(fn_node)
    if ch_vec == 0 do
        out 0 as AstNode
    end
    let count = vec_len_rt(ch_vec)
    var cur_idx = 0
    var i = 0
    when i < count loop
        let ch = vec_get_rt(ch_vec, i)
        let t = pass8_ast_type(ch)
        if t == AstType.ParamDef or t == AstType.RefParam or t == AstType.OutParam do
            if cur_idx == param_idx do
                out ch
            end
            cur_idx = cur_idx + 1
        eif t == AstType.Identifier do
            if cur_idx == param_idx do
                out ch
            end
            cur_idx = cur_idx + 1
        eif t == AstType.Block do
            out 0 as AstNode
        end
        i = i + 1
    end
    out 0 as AstNode
end.
