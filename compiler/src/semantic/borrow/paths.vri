##
 * compiler/src/semantic/borrow/paths.vri — Borrow Ownership Paths
 * ==============================================================
 * VIRC-PLN-0004 Section 5.6 & Phase 8: Borrow Analysis Decomposition.
 *
 * Owns path projection, root owner extraction, path overlapping,
 * assignment path determination, address-of target extraction, and borrow root resolution.
 ##

include borrow_context
include borrow_binding

func pass8_root_owner(path: string) -> string:
    let n = pass8_strlen(path)
    if n == 0 do out path end
    var stop_pos = -1
    var i = 0
    when i < n loop
        let b = fat_str_byte_at(path, i)
        if b == 46 or b == 91 do
            stop_pos = i
            i = n
        else
            i = i + 1
        end
    end
    if stop_pos <= 0 do
        out path
    end
    out fat_str_slice(path as int, 0, stop_pos) as string
end.

func pass8_paths_overlap(left: int, right: int):
    let nl = pass8_strlen(left)
    let nr = pass8_strlen(right)
    if nl == 0 or nr == 0 do out 0 end
    if pass8_streq(left, right) == 1 do out 1 end
    var common = nl
    if nr < common do common = nr end
    var i = 0
    var mismatch = -1
    when i < common loop
        if fat_str_byte_at(left, i) != fat_str_byte_at(right, i) do
            mismatch = i
            i = common
        else
            i = i + 1
        end
    end
    if mismatch == -1 do
        if nl < nr do
            let b = fat_str_byte_at(right, nl)
            if b == 46 or b == 91 do out 1 end
        end
        if nr < nl do
            let b = fat_str_byte_at(left, nr)
            if b == 46 or b == 91 do out 1 end
        end
    end
    let root_l = pass8_root_owner(left)
    let root_r = pass8_root_owner(right)
    if pass8_streq(root_l, root_r) == 1 do
        let dyn_str = fat_str_concat(root_l, fat_str_new("[]"))
        if pass8_streq(left, dyn_str) == 1 or pass8_streq(right, dyn_str) == 1 do
            out 1
        end
    end
    out 0
end.

func pass8_state_path(path: int):
    if pass8_strlen(path) == 0 do out fat_str_new("") end
    if pass8_has_binding_marker(path) == 1 do out path as string end
    let root = pass8_root_owner(path as string)
    let key = pass8_resolve_binding_key(root)
    let root_len = pass8_strlen(root)
    let path_len = pass8_strlen(path)
    if root_len >= path_len do out key end
    let suffix = fat_str_slice(path, root_len, path_len - root_len)
    out fat_str_concat(key, suffix)
end.

func pass8_source_name_for_path(path: int):
    let root = pass8_root_owner(path as string)
    if g_pass8_bindings != 0 do
        var source_idx = pass8_box_len(g_pass8_bindings) - 1
        when source_idx >= 0 loop
            let binding = pass8_box_get(g_pass8_bindings, source_idx)
            if pass8_streq(pass8_binding_key(binding), root) == 1 do
                out pass8_binding_name(binding)
            end
            source_idx = source_idx - 1
        end
    end
    out root
end.

func pass8_binding_depth_for_path(path: int) -> int:
    let root = pass8_root_owner(pass8_state_path(path))
    if g_pass8_bindings != 0 do
        var depth_idx = pass8_box_len(g_pass8_bindings) - 1
        when depth_idx >= 0 loop
            let binding = pass8_box_get(g_pass8_bindings, depth_idx)
            if pass8_streq(pass8_binding_key(binding), root) == 1 do
                out pass8_binding_depth(binding)
            end
            depth_idx = depth_idx - 1
        end
    end
    out 0
end.

func pass8_filter_var_state_scope(state: int, depth: int):
    if state == 0 do out 0 end
    var filter_again: int = 1
    when filter_again == 1 loop
        filter_again = 0
        let state_len = pass8_box_len(state)
        for state_idx in 0..state_len:
            if filter_again == 0 do
                let item = pass8_box_get(state, state_idx)
                if pass8_binding_depth_for_path(var_item_name(item)) >= depth do
                    if state_idx < state_len - 1 do
                        pass8_box_set(state, state_idx, pass8_box_get(state, state_len - 1))
                    end
                    let state_vec = native_read_i64(state, 0)
                    vec_pop_rt(state_vec)
                    filter_again = 1
                end
            end
        end
    end
    out 0
end.

func pass8_owner_path(node: &AstNode):
    if (node as i64) == 0 do out fat_str_new("") end
    let nt = pass8_ast_type(node)
    if nt == AstType.Identifier do out pass8_state_path(pass8_ast_name(node)) end
    if nt == AstType.FieldAccess and vec_len_rt(pass8_ast_children(node)) > 0 do
        let base = pass8_owner_path(vec_get_rt(pass8_ast_children(node), 0))
        if pass8_strlen(base) == 0 do out base end
        out fat_str_concat(fat_str_concat(base, fat_str_new(".")), pass8_ast_name(node))
    end
    if nt == AstType.IndexAccess do
        let base = pass8_state_path(pass8_ast_name(node))
        if pass8_strlen(base) == 0 do out base end
        let ch_vec = pass8_ast_children(node)
        if ch_vec != 0 and vec_len_rt(ch_vec) > 0 do
            let idx_node = vec_get_rt(ch_vec, 0)
            if pass8_ast_type(idx_node) == AstType.LiteralInt do
                let ival = pass8_ast_int_val(idx_node)
                out fat_str_concat(fat_str_concat(fat_str_concat(base, fat_str_new("[")), str_from_cstr(rt_itoa(ival))), fat_str_new("]"))
            end
        end
        out fat_str_concat(base, fat_str_new("[]"))
    end
    if nt == AstType.ExprIndex do
        let expr_index_children = pass8_ast_children(node)
        if expr_index_children == 0 or vec_len_rt(expr_index_children) < 2 do out fat_str_new("") end
        let expr_index_base = pass8_owner_path(vec_get_rt(expr_index_children, 0))
        if pass8_strlen(expr_index_base) == 0 do out expr_index_base end
        let expr_index_value = vec_get_rt(expr_index_children, 1)
        if pass8_ast_type(expr_index_value) == AstType.LiteralInt do
            out fat_str_concat(fat_str_concat(fat_str_concat(expr_index_base, fat_str_new("[")), str_from_cstr(rt_itoa(pass8_ast_int_val(expr_index_value)))), fat_str_new("]"))
        end
        out fat_str_concat(expr_index_base, fat_str_new("[]"))
    end
    out fat_str_new("")
end.

func pass8_assignment_path(node: &AstNode):
    if (node as i64) == 0 do out fat_str_new("") end
    let nt = pass8_ast_type(node)
    if nt == AstType.Assign or nt == AstType.SwizzleAssign do
        out pass8_state_path(pass8_ast_name(node))
    end
    if nt == AstType.FieldAssign do
        let children = pass8_ast_children(node)
        if children != 0 and vec_len_rt(children) > 1 do
            let base = pass8_owner_path(vec_get_rt(children, 1))
            if pass8_strlen(base) > 0 do
                out fat_str_concat(fat_str_concat(base, fat_str_new(".")), pass8_ast_name2(node))
            end
        end
        out pass8_state_path(pass8_ast_name(node))
    end
    if nt == AstType.IndexAssign do
        let base = pass8_state_path(pass8_ast_name(node))
        let children = pass8_ast_children(node)
        if children != 0 and vec_len_rt(children) > 1 do
            let idx = vec_get_rt(children, 0)
            if pass8_ast_type(idx) == AstType.LiteralInt do
                out fat_str_concat(fat_str_concat(fat_str_concat(base, fat_str_new("[")), str_from_cstr(rt_itoa(pass8_ast_int_val(idx)))), fat_str_new("]"))
            end
        end
        out fat_str_concat(base, fat_str_new("[]"))
    end
    out fat_str_new("")
end.

func pass8_get_addr_target(node: i64):
    if (node as i64) == 0 do
        out fat_str_new("")
    end
    if pass8_ast_type(node) != AstType.AddrOf do
        out fat_str_new("")
    end
    let child_count = vec_len_rt(pass8_ast_children(node))
    if child_count < 1 do
        out fat_str_new("")
    end
    out pass8_owner_path(vec_get_rt(pass8_ast_children(node), 0))
end.

func pass8_resolve_borrow_root(bound_borrows: int, path: string) -> string:
    var curr = pass8_root_owner(pass8_state_path(path))
    var depth = 0
    when depth < 10 loop
        if bound_borrows != 0 do
            let binding = pass8_box_find(bound_borrows, curr)
            if binding != 0 do
                let tgt = borrow_binding_target(binding)
                if pass8_strlen(tgt) > 0 do
                    curr = pass8_root_owner(tgt)
                else
                    depth = 10
                end
            else
                depth = 10
            end
        else
            depth = 10
        end
        depth = depth + 1
    end
    out curr
end.
