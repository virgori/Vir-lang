##
 * compiler/src/semantic/borrow/binding.vri — Borrow Binding Records
 * ================================================================
 * VIRC-PLN-0004 Section 5.6 & Phase 8: Borrow Analysis Decomposition.
 *
 * Owns canonical lexical binding records, scope tracking, binding markers,
 * and key resolution to isolate shadowed declarations.
 ##

include borrow_context

func var_item_new(name: int, val: int):
    let p = vir_alloc(16)
    native_write_i64(p, 0, name)
    native_write_i64(p, 8, val as i64)
    out p
end.

func var_item_name(item: int):
    if pass8_is_heap_ptr(item) == 0 do
        out 0
    end
    out native_read_i64(item, 0)
end.

func var_item_val(item: int):
    if pass8_is_heap_ptr(item) == 0 do
        out 0
    end
    out native_read_i64(item, 8)
end.

func var_item_set_val(item: int, val: int):
    if pass8_is_heap_ptr(item) == 1 do
        native_write_i64(item, 8, val as i64)
    end
end.

func borrow_binding_new(lhs: int, target: int, kind: int):
    let p = vir_alloc(24)
    native_write_i64(p, 0, lhs)
    native_write_i64(p, 8, target)
    native_write_i64(p, 16, kind as i64)
    out p
end.

func borrow_binding_lhs(b: int):
    if pass8_is_heap_ptr(b) == 0 do
        out 0
    end
    out native_read_i64(b, 0)
end.

func borrow_binding_target(b: int):
    if pass8_is_heap_ptr(b) == 0 do
        out 0
    end
    out native_read_i64(b, 8)
end.

func borrow_binding_kind(b: int):
    if pass8_is_heap_ptr(b) == 0 do
        out 0
    end
    out native_read_i64(b, 16)
end.

# Canonical lexical binding record:
# [0]=source name, [8]=canonical key, [16]=scope id, [24]=depth, [32]=decl line.
func pass8_binding_new(name: int, key: int, scope_id: int, depth: int, line: int):
    let binding = vir_alloc(40)
    native_write_i64(binding, 0, name)
    native_write_i64(binding, 8, key)
    native_write_i64(binding, 16, scope_id)
    native_write_i64(binding, 24, depth)
    native_write_i64(binding, 32, line)
    out binding
end.

func pass8_binding_name(binding: int):
    out native_read_i64(binding, 0)
end.

func pass8_binding_key(binding: int):
    out native_read_i64(binding, 8)
end.

func pass8_binding_scope(binding: int):
    out native_read_i64(binding, 16)
end.

func pass8_binding_depth(binding: int):
    out native_read_i64(binding, 24)
end.

func pass8_binding_line(binding: int):
    out native_read_i64(binding, 32)
end.

func pass8_current_scope_id() -> int:
    if g_pass8_scope_stack == 0 or pass8_box_len(g_pass8_scope_stack) == 0 do out 0 end
    out var_item_val(pass8_box_get(g_pass8_scope_stack, pass8_box_len(g_pass8_scope_stack) - 1))
end.

func pass8_scope_is_active(scope_id: int) -> int:
    if g_pass8_scope_stack == 0 do out scope_id == 0 end
    let count = pass8_box_len(g_pass8_scope_stack)
    var i = 0
    when i < count loop
        if var_item_val(pass8_box_get(g_pass8_scope_stack, i)) == scope_id do out 1 end
        i = i + 1
    end
    out 0
end.

func pass8_enter_binding_scope(node_id: int) -> int:
    var scope_id = 0
    let scope_count = pass8_box_len(g_pass8_scope_ids)
    var scope_idx = 0
    when scope_idx < scope_count loop
        let scope_record = pass8_box_get(g_pass8_scope_ids, scope_idx)
        if native_read_i64(scope_record, 0) == node_id do
            scope_id = native_read_i64(scope_record, 8)
            scope_idx = scope_count
        else
            scope_idx = scope_idx + 1
        end
    end
    if scope_id == 0 do
        scope_id = g_pass8_next_scope_id
        g_pass8_next_scope_id = g_pass8_next_scope_id + 1
        let new_scope_record = vir_alloc(16)
        native_write_i64(new_scope_record, 0, node_id as i64)
        native_write_i64(new_scope_record, 8, scope_id as i64)
        pass8_box_push(g_pass8_scope_ids, new_scope_record as i64)
    end
    pass8_box_push(g_pass8_scope_stack, var_item_new(fat_str_new("scope"), scope_id) as i64)
    out scope_id
end.

func pass8_leave_binding_scope():
    if g_pass8_scope_stack != 0 and pass8_box_len(g_pass8_scope_stack) > 1 do
        pass8_box_pop(g_pass8_scope_stack)
    end
end.

func pass8_has_binding_marker(path: int) -> int:
    let count = pass8_strlen(path)
    var i = 0
    when i < count loop
        if pass8_str_byte_at(path, i) == 35 do out 1 end
        i = i + 1
    end
    out 0
end.

func pass8_resolve_binding_key(name: int):
    if pass8_strlen(name) == 0 do out fat_str_new("") end
    if pass8_has_binding_marker(name) == 1 do out name as string end
    if g_pass8_bindings != 0 do
        var i = pass8_box_len(g_pass8_bindings) - 1
        when i >= 0 loop
            let binding = pass8_box_get(g_pass8_bindings, i)
            if pass8_streq(pass8_binding_name(binding), name) == 1 and pass8_scope_is_active(pass8_binding_scope(binding)) == 1 do
                out pass8_binding_key(binding) as string
            end
            i = i - 1
        end
    end
    out name as string
end.
