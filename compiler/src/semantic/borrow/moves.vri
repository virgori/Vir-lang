##
 * compiler/src/semantic/borrow/moves.vri — Borrow Move Semantics
 * =============================================================
 * VIRC-PLN-0004 Section 5.6 & Phase 8: Borrow Analysis Decomposition.
 *
 * Tracks move state, use-after-move detection, variable revival upon re-assignment,
 * snapshotting and merging moved variables across control flow branches.
 ##

include borrow_context
include borrow_binding
include borrow_paths

func pass8_is_moved(moved_vars: int, name: int):
    let key = pass8_state_path(name)
    if pass8_strlen(key) == 0 do
        out 0
    end
    let moved_count = pass8_box_len(moved_vars)
    var moved_idx = 0
    when moved_idx < moved_count loop
        if pass8_paths_overlap(var_item_name(pass8_box_get(moved_vars, moved_idx)), key) == 1 do
            out 1
        end
        moved_idx = moved_idx + 1
    end
    out 0
end.

func pass8_mark_moved(moved_vars: int, name: int):
    out pass8_mark_moved_at(moved_vars, name, 0)
end.

func pass8_mark_moved_at(moved_vars: int, name: int, line: int):
    let key = pass8_state_path(name)
    if pass8_strlen(key) == 0 do
        out 0
    end
    if pass8_box_find(moved_vars, key) == 0 do
        let moved_item = var_item_new(key, line)
        pass8_box_push(moved_vars, moved_item as i64)
    end
    out 0
end.

func pass8_moved_line(moved_vars: int, name: int):
    let moved_key = pass8_state_path(name)
    let moved_line_count = pass8_box_len(moved_vars)
    var moved_line_idx = 0
    when moved_line_idx < moved_line_count loop
        let moved_line_item = pass8_box_get(moved_vars, moved_line_idx)
        if pass8_paths_overlap(var_item_name(moved_line_item), moved_key) == 1 do
            out var_item_val(moved_line_item)
        end
        moved_line_idx = moved_line_idx + 1
    end
    out 0
end.

func pass8_record_local_binding(moved_vars: int, name: int):
    # Canonical binding IDs isolate shadowed declarations.
end.

func pass8_restore_local_bindings(moved_vars: int, frame: int):
    # Canonical binding IDs isolate shadowed declarations.
end.

func pass8_unmark_moved(moved_vars: int, name: int):
    let key = pass8_state_path(name)
    if pass8_strlen(key) == 0 do
        out 0
    end
    let item = pass8_box_find(moved_vars, key)
    if item == 0 do
        out 0
    end
    let count = pass8_box_len(moved_vars)
    var i = 0
    var v = 0
    when i < count loop
        if pass8_box_get(moved_vars, i) == item do
            if i < count - 1 do
                pass8_box_set(moved_vars, i, pass8_box_get(moved_vars, count - 1))
            end
            # Truncate without re-unindexing the swapped tail: pop raw.
            v = native_read_i64(moved_vars, 0)
            vec_pop_rt(v)
            out 0
        end
        i = i + 1
    end
    out 0
end.

# Capture the moves introduced after a watermark. The snapshot only lives
# while an if-statement is joined; merging creates fresh entries in the
# destination set, so the branch state itself never escapes.
func pass8_snapshot_moved_since(moved_vars: int, watermark: int):
    let snapshot = pass8_box_new()
    let count = pass8_box_len(moved_vars)
    var i = watermark
    when i < count loop
        let snap_item = pass8_box_get(moved_vars, i)
        pass8_box_push(snapshot, snap_item)
        i = i + 1
    end
    out snapshot
end.

func pass8_merge_moved(moved_vars: int, snapshot: int):
    let count = pass8_box_len(snapshot)
    var i = 0
    when i < count loop
        let item = pass8_box_get(snapshot, i)
        let name = var_item_name(item)    # returns int
        if pass8_strlen(name) > 0 do
            pass8_mark_moved_at(moved_vars, name, var_item_val(item))
        end
        i = i + 1
    end
    out 0
end.

func pass8_vec_contains(names: int, name: int):
    let key = pass8_state_path(name)
    if pass8_strlen(key) == 0 do
        out 0
    end
    if pass8_box_find(names, key) != 0 do
        out 1
    end
    if pass8_box_find(names, name) != 0 do out 1 end
    out 0
end.
