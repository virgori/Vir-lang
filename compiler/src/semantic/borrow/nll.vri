##
 * compiler/src/semantic/borrow/nll.vri — Non-Lexical Lifetimes & Liveness Helpers
 * ==============================================================================
 * VIRC-PLN-0004 Section 5.6 & Phase 8: Borrow Analysis Decomposition.
 *
 * Inspects future AST uses of identifiers to support early loan release (NLL)
 * and stmt boundary borrow watermark truncation.
 ##

include borrow_context

func pass8_end_stmt(shared_borrows: int, mut_borrows: int, shared_wm: int, mut_wm: int, claimed: int):
    if claimed == 0 do
        pass8_truncate_to(shared_borrows, shared_wm)
        pass8_truncate_to(mut_borrows, mut_wm)
    end
    out 0
end.

func pass8_tree_uses_ident(node: &AstNode, name: int) -> int:
    if (node as i64) == 0 do out 0 end
    if pass8_ast_type(node) == AstType.Identifier do
        if pass8_streq(pass8_ast_name(node), name) == 1 do
            out 1
        end
    end
    let ch_vec = pass8_ast_children(node)
    if ch_vec != 0 do
        let count = vec_len_rt(ch_vec)
        var i = 0
        when i < count loop
            let ch = vec_get_rt(ch_vec, i)
            if pass8_tree_uses_ident(ch, name) == 1 do
                out 1
            end
            i = i + 1
        end
    end
    out 0
end.
