##
 * compiler/src/semantic/borrow/state.vri — Borrow Dataflow State
 * =============================================================
 * VIRC-PLN-0004 Section 5.6 & Phase 8: Borrow Analysis Decomposition.
 *
 * Owns dataflow state comparisons, set cloning/copying, set joins across branches,
 * and uninitialized variable state tracking.
 ##

include borrow_context
include borrow_binding
include borrow_paths
include borrow_moves
include borrow_loans

func pass8_box_clone(b: int):
    let p = pass8_box_new()
    if b == 0 do out p end
    let count = pass8_box_len(b)
    var i = 0
    when i < count loop
        pass8_box_push(p, pass8_box_get(b, i))
        i = i + 1
    end
    out p
end.

func pass8_box_copy_into(dst: int, src: int):
    if dst == 0 do out 0 end
    let v_dst = native_read_i64(dst, 0)
    when vec_len_rt(v_dst) > 0 loop
        vec_pop_rt(v_dst)
    end
    native_write_i64(dst, 8, 0)
    if src == 0 do out 0 end
    let count = pass8_box_len(src)
    var i = 0
    when i < count loop
        pass8_box_push(dst, pass8_box_get(src, i))
        i = i + 1
    end
    out 0
end.

func pass8_var_state_equal(left: int, right: int) -> int:
    if left == 0 or right == 0 do out left == right end
    if pass8_box_len(left) != pass8_box_len(right) do out 0 end
    let count = pass8_box_len(left)
    var i = 0
    when i < count loop
        let left_item = pass8_box_get(left, i)
        let name = var_item_name(left_item)
        let right_item = pass8_box_find(right, name)
        if right_item == 0 or var_item_val(left_item) != var_item_val(right_item) do
            out 0
        end
        i = i + 1
    end
    out 1
end.

func pass8_dataflow_state_equal(left_moved: int, right_moved: int,
                                left_shared: int, right_shared: int,
                                left_mut: int, right_mut: int,
                                left_bound: int, right_bound: int,
                                left_uninit: int, right_uninit: int) -> int:
    if pass8_var_state_equal(left_moved, right_moved) == 0 do out 0 end
    if pass8_var_state_equal(left_shared, right_shared) == 0 do out 0 end
    if pass8_var_state_equal(left_mut, right_mut) == 0 do out 0 end
    if pass8_borrow_state_equal(left_bound, right_bound) == 0 do out 0 end
    if pass8_var_state_equal(left_uninit, right_uninit) == 0 do out 0 end
    out 1
end.

func pass8_count_new_moves(header: int, latch: int) -> int:
    if latch == 0 do out 0 end
    let count = pass8_box_len(latch)
    var i = 0
    var new_moves = 0
    when i < count loop
        let item = pass8_box_get(latch, i)
        let name = var_item_name(item)
        if pass8_strlen(name) > 0 and pass8_is_moved(header, name) == 0 do
            new_moves = new_moves + 1
        end
        i = i + 1
    end
    out new_moves
end.

func pass8_count_new_borrows(header: int, latch: int) -> int:
    if latch == 0 do out 0 end
    let count = pass8_box_len(latch)
    var i = 0
    var new_borrows = 0
    when i < count loop
        let item = pass8_box_get(latch, i)
        let name = var_item_name(item)
        if pass8_strlen(name) > 0 and pass8_borrow_count(header, name) == 0 do
            new_borrows = new_borrows + 1
        end
        i = i + 1
    end
    out new_borrows
end.

func pass8_merge_borrows_box(dst: int, src: int):
    if src == 0 do out 0 end
    let count = pass8_box_len(src)
    var i = 0
    when i < count loop
        let item = pass8_box_get(src, i)
        let name = var_item_name(item)
        if pass8_strlen(name) > 0 and pass8_borrow_count(dst, name) == 0 do
            let line = var_item_val(item)
            let new_item = var_item_new(name, line)
            pass8_box_push(dst, new_item as i64)
        end
        i = i + 1
    end
    out 0
end.

func pass8_merge_moved_box(dst: int, src: int):
    if src == 0 do out 0 end
    let count = pass8_box_len(src)
    var i = 0
    when i < count loop
        let item = pass8_box_get(src, i)
        let name = var_item_name(item)
        if pass8_strlen(name) > 0 and pass8_is_moved(dst, name) == 0 do
            let line = var_item_val(item)
            let new_item = var_item_new(name, line)
            pass8_box_push(dst, new_item as i64)
        end
        i = i + 1
    end
    out 0
end.

func pass8_merge_bound_box(dst: int, src: int):
    if src == 0 do out 0 end
    let src_count = pass8_box_len(src)
    var src_idx = 0
    when src_idx < src_count loop
        let src_binding = pass8_box_get(src, src_idx)
        let src_lhs = borrow_binding_lhs(src_binding)
        let src_target = borrow_binding_target(src_binding)
        let src_kind = borrow_binding_kind(src_binding)
        if pass8_borrow_binding_present(dst, src_lhs, src_target, src_kind) == 0 do
            pass8_claim_borrow(dst, src_lhs, src_target, src_kind)
        end
        src_idx = src_idx + 1
    end
    out 0
end.

func pass8_mark_uninit(uninit_vars: int, name: int):
    let key = pass8_state_path(name)
    if pass8_strlen(key) == 0 or uninit_vars == 0 do out 0 end
    if pass8_box_find(uninit_vars, key) == 0 do
        let item = var_item_new(key, 0)
        pass8_box_push(uninit_vars, item as i64)
    end
    out 0
end.

func pass8_unmark_uninit(uninit_vars: int, name: int):
    let key = pass8_state_path(name)
    if pass8_strlen(key) == 0 or uninit_vars == 0 do out 0 end
    let item = pass8_box_find(uninit_vars, key)
    if item == 0 do out 0 end
    let count = pass8_box_len(uninit_vars)
    var i = 0
    var v = 0
    when i < count loop
        if pass8_box_get(uninit_vars, i) == item do
            if i < count - 1 do
                pass8_box_set(uninit_vars, i, pass8_box_get(uninit_vars, count - 1))
            end
            v = native_read_i64(uninit_vars, 0)
            vec_pop_rt(v)
            out 0
        end
        i = i + 1
    end
    out 0
end.

func pass8_is_uninit(uninit_vars: int, name: int):
    let key = pass8_state_path(name)
    if pass8_strlen(key) == 0 or uninit_vars == 0 do out 0 end
    if pass8_box_find(uninit_vars, key) != 0 do out 1 end
    out 0
end.
