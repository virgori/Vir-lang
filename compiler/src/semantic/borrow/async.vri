##
 * compiler/src/semantic/borrow/async.vri — Async/Await Borrow Inspection
 * ======================================================================
 * VIRC-PLN-0004 Section 5.6 & Phase 8: Borrow Analysis Decomposition.
 *
 * Inspects await expressions to verify borrow lifetimes across suspension points.
 ##

include borrow_context

func pass8_has_await(node: &AstNode) -> int:
    if (node as i64) == 0 do out 0 end
    if pass8_ast_type(node) == AstType.AwaitExpr do out 1 end
    let ch_vec = pass8_ast_children(node)
    if ch_vec != 0 do
        let count = vec_len_rt(ch_vec)
        var i = 0
        when i < count loop
            if pass8_has_await(vec_get_rt(ch_vec, i)) == 1 do out 1 end
            i = i + 1
        end
    end
    out 0
end.
