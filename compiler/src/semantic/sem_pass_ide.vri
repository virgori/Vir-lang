##
 * vir/compiler/sem_pass_ide.vri — IDE: modules, function reachability, usage.
 ##

include vec_rt
import vec_new_rt, vec_get_rt, vec_len_rt, vec_push_rt from vec_rt

include string_rt
import fat_str_len, fat_str_eq, fat_cstr_eq, rt_strdup, fat_str_byte_at from string_rt

include parser
import AstNode, AstType from parser

include symbol_table
import SymbolTable, symbol_lookup from symbol_table

include scope_tree
import ScopeTree from scope_tree

include type_table
import is_tensor_type_str, parse_tensor_shape from type_table

include compiler.ide_semantic
import ide_pass8_bind, ide_register_include, ide_register_module, ide_register_import, ide_register_decl,
       ide_note_type_ref, ide_register_function, ide_add_call_edge, ide_finalize_functions,
       ide_push_shape_dim from compiler.ide_semantic

var g_pass_ide_current_func: int = 0

func pass_ide_collect(ref symbols: SymbolTable, ref scopes: ScopeTree, node: &AstNode):
    ide_pass8_bind(symbols, scopes)
    g_pass_ide_current_func = 0
    pass_ide_walk_funcs(symbols, scopes, node, 2)
    ide_finalize_functions()
    pass_ide_walk_modules(node)
    pass_ide_walk_type_shapes(node)
end.

func pass_ide_push_angle_dim_digits(line: int, type_str: int, start: int, end_pos: int):
    let n = fat_str_len(type_str)
    if start < 0 or end_pos > n or start >= end_pos do
        out 0
    end
    var i = start
    var cur = 0
    var digits = 0
    when i < end_pos loop
        let c = fat_str_byte_at(type_str, i)
        if c >= 48 and c <= 57 do
            cur = cur * 10 + (c - 48)
            digits = digits + 1
        eif c == 44 or c == 32 do
            if digits > 0 do
                ide_push_shape_dim(line, cur, 0)
                cur = 0
                digits = 0
            end
        else
            if digits > 0 do
                i = end_pos
            end
        end
        i = i + 1
    end
    if digits > 0 do
        ide_push_shape_dim(line, cur, 0)
    end
    out 0
end.

func pass_ide_scan_angle_shape_dims(line: int, type_str: int):
    let n = fat_str_len(type_str)
    if n < 3 do
        out 0
    end
    var i = 0
    when i < n loop
        let c = fat_str_byte_at(type_str, i)
        if c == 60 do
            pass_ide_push_angle_dim_digits(line, type_str, i + 1, n)
            i = n
        else
            i = i + 1
        end
    end
    out 0
end.

func pass_ide_note_type_shape(line: int, type_str: int):
    if fat_str_len(type_str) == 0 do
        out 0
    end
    if is_tensor_type_str(type_str) == 1 do
        let shape = parse_tensor_shape(rt_strdup(type_str) as string)
        let sn = vec_len_rt(shape)
        var si = 0
        when si < sn loop
            ide_push_shape_dim(line, vec_get_rt(shape, si), 0)
            si = si + 1
        end
    end
    pass_ide_scan_angle_shape_dims(line, type_str)
    out 0
end.

func pass_ide_walk_type_shapes(node: &AstNode):
    if (node as i64) == 0 do
        out 0
    end
    if fat_str_len(node.name2 as int) > 0 do
        pass_ide_note_type_shape(node.line, node.name2 as int)
    end
    let n = vec_len_rt(node.children)
    var i = 0
    when i < n loop
        pass_ide_walk_type_shapes(vec_get_rt(node.children, i) as AstNode)
        i = i + 1
    end
    out 0
end.

# Build the declaration table and the reference graph in one AST walk.
#   top: 2 = the program root, 1 = a top-level statement, 0 = anything nested.
# Declarations: functions/methods (anywhere), types + constants (top level only).
# References (edges, owner -> name): calls, method calls, plain identifiers (constants,
# callbacks passed as values, qualified-access bases) and the types named in annotations.
# Imports are recorded separately: their identifiers are *bindings*, not uses.
func pass_ide_walk_funcs(ref symbols: SymbolTable, ref scopes: ScopeTree, node: &AstNode, top: int):
    if (node as i64) == 0 do
        out 0
    end
    var saved_func = g_pass_ide_current_func
    var child_top = 0
    if top == 2 do
        child_top = 1
    end
    let t = node.node_type

    if t == AstType.ImportStmt do
        pass_ide_register_import(node)
        out 0
    end

    if t == AstType.FuncDef do
        if fat_str_len(node.name as int) > 0 do
            let sym_id = symbol_lookup(symbols, scopes, 0, node.name as i64)
            ide_register_function(node.name as int, node.line, 0, 0, sym_id)
            g_pass_ide_current_func = node.name as i64
        end
    end
    if top == 1 do
        # 3 = type, 4 = constant (see IDE_SYM_* in compiler.ide_semantic)
        if t == AstType.EntityDef or t == AstType.EnumDef or t == AstType.TypeAlias do
            if fat_str_len(node.name as int) > 0 do
                ide_register_decl(node.name as int, node.line, 0, 0, 0, 3)
                g_pass_ide_current_func = node.name as i64
            end
        end
        if t == AstType.ConstDecl do
            if fat_str_len(node.name as int) > 0 do
                ide_register_decl(node.name as int, node.line, 0, 0, 0, 4)
                g_pass_ide_current_func = node.name as i64
            end
        end
    end

    if t == AstType.Call or t == AstType.MethodCall or t == AstType.Identifier do
        if fat_str_len(node.name as int) > 0 do
            ide_add_call_edge(g_pass_ide_current_func, node.name as int)
        end
    end
    if t == AstType.ExportStmt do
        if fat_str_len(node.name as int) > 0 do
            ide_add_call_edge(0, node.name as int)
        end
    end
    if fat_str_len(node.name2 as int) > 0 and t != AstType.Identifier and t != AstType.ExportStmt do
        ide_note_type_ref(g_pass_ide_current_func, node.name2 as int)
    end

    let n = vec_len_rt(node.children)
    var i = 0
    when i < n loop
        pass_ide_walk_funcs(symbols, scopes, vec_get_rt(node.children, i) as AstNode, child_top)
        i = i + 1
    end
    g_pass_ide_current_func = saved_func
    out 0
end.

func pass_ide_register_import(node: &AstNode):
    var alias = node.name2 as int
    let n = vec_len_rt(node.children)
    if n == 0 do
        # `import MOD [as ALIAS]`: qualified access through MOD / ALIAS.
        ide_register_module(node.name as int, alias, node.line, 0, 1)
        out 0
    end
    ide_register_module(node.name as int, node.name2 as int, node.line, 0, 1)
    var i = 0
    when i < n loop
        let c = vec_get_rt(node.children, i) as AstNode
        var binding = c.name as int
        if fat_str_len(c.name2 as int) > 0 do
            binding = c.name2 as int
        end
        var line = c.line
        if line <= 0 do
            line = node.line
        end
        ide_register_import(binding, c.name as int, node.name as int, line)
        i = i + 1
    end
    out 0
end.

func pass_ide_walk_modules(node: &AstNode):
    if (node as i64) == 0 do
        out 0
    end
    if node.node_type == AstType.IncludeStmt do
        var target = node.name as int
        if fat_str_len(node.name2 as int) > 0 do
            target = node.name2 as int
        end
        if fat_str_len(target) > 0 do
            # The parser records no column for `include`; 0 = "locate the name on this line".
            ide_register_include(target, node.line, 0, 1)
        end
    end
    let n = vec_len_rt(node.children)
    var i = 0
    when i < n loop
        pass_ide_walk_modules(vec_get_rt(node.children, i) as AstNode)
        i = i + 1
    end
    out 0
end.

export pass_ide_collect
