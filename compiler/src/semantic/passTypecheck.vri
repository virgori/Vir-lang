##
 * vir/compiler/sem_pass6_typecheck.vri
 * ==============================================================
 * Pass 6: Complete Type Checking for Vir v2.0
 * Validates type compatibility for operators, assignments, calls,
 * returns, entity field accesses, and array indexing.
 ##

include vec_rt
import vec_new_rt, vec_push_rt, vec_get_rt, vec_len_rt, vec_set_rt from vec_rt

include string_rt
import rt_streq, fat_str_eq, fat_str_len, fat_str_byte_at, fat_cstr_eq, fat_str_new, fat_str_concat, fat_str_slice, rt_strcat, rt_itoa, rt_strlen from string_rt

include parser
import AstNode, AstType, OpType from parser

include symbol_table
import SymbolTable, SymbolKind, SymbolNode, symbol_alloc from symbol_table

include scope_tree
import ScopeTree, ScopeKind, ScopeNode, scope_push, scope_pop, scope_add_symbol, scope_current_id from scope_tree

include ide_facts
import g_ideFactsEnabled, ideFactResolve, ideFactSymbol, ideFactType, ideFactProjection, ideFactScope from ide_facts

include context
import DiagnosticEngine, report_error, report_error_info, report_error_loc, report_error_span, set_diag_context, clear_diag_context, g_diag_func_context, g_diag_expected_type, g_diag_actual_type from context

include type_table
import TypeKind, TYPE_VOID, TYPE_INT, TYPE_FLOAT, TYPE_BOOL, TYPE_STRING, is_tensor_type_str, tensor_type_is_well_formed, parse_tensor_elem_type, parse_tensor_shape, parse_tensor_rank, parse_tensor_elem_code, is_flux_type_str, parse_flux_lanes, parse_flux_elem_type, flux_is_power_of_two, swizzle_char_to_lane, Q_CODEC_NONE, Q_CODEC_UNIFORM, Q_CODEC_Q8_0, is_quantized_type_str, is_q80_view_type_str, parse_quantized_codec, parse_quantized_elem_type, parse_quantized_bits, parse_quantized_shape, parse_quantized_rank, parse_quantized_block_elements, parse_quantized_block_bytes, parse_quantized_stride_bytes, parse_quantized_alignment, parse_quantized_read_only, parse_quantized_ownership_kind, parse_quantized_has_lifetime, format_quantized_uniform_type, format_quantized_q80_type from type_table

# Hash ONLY global scope.  Orphan Func/Block nodes from prior passes would
# make a dense per-scope 256-bucket table allocate millions of vecs.
const PASS6_BUCKETS: int = 256
var g_pass6_symbols: i64 = 0
var g_pass6_scopes: i64 = 0
var g_pass6_diag: i64 = 0
var g_pass6_global_buckets: i64 = 0
var g_pass6_suffix_buckets: i64 = 0
var g_pass6_scope_buckets: i64 = 0
const PASS6_SCOPE_BUCKETS_COUNT: int = 1024
var g_pass6_extern_names: i64 = 0
var g_pass6_extern_nodes: i64 = 0
var g_pass6_extern_buckets: i64 = 0
var g_pass6_ai_mode: int = 0 # 0=normal, 1=infer, 2=train
var g_pass6_infer_values: i64 = 0
var g_pass6_train_values: i64 = 0
var g_pass6_entity_names: i64 = 0
var g_pass6_entity_nodes: i64 = 0
var g_pass6_entity_buckets: i64 = 0
var g_pass6_enum_buckets: i64 = 0
var g_pass6_func_names: i64 = 0
var g_pass6_func_nodes: i64 = 0
var g_pass6_func_canonical_names: i64 = 0
var g_pass6_func_buckets: i64 = 0
var g_pass6_func_canon_buckets: i64 = 0
var g_pass6_func_canon_by_node: i64 = 0
var g_pass6_ret_stmt_buckets: i64 = 0
var g_pass6_visiting_symbols: i64 = 0
var g_pass6_sym_types: i64 = 0
var g_pass6_scoped_var_names: i64 = 0
var g_pass6_scoped_var_types: i64 = 0
var g_pass6_scope_watermarks: i64 = 0
var g_pass6_current_entity_name: i64 = 0
var g_pass6_current_func_name: i64 = 0
var g_pass6_current_func_ret_type: i64 = 0
var g_pass6_var_names: i64 = 0
var g_pass6_var_types: i64 = 0
var g_pass6_assigned_vars: i64 = 0
var g_pass6_quantized_tensor_type: i64 = fat_str_new("QuantizedTensor") as i64
var g_pass6_cur_module: string = ""
var g_pass6_current_generic_params: string = ""
var g_pass6_fn_ret_cache_keys: i64 = 0
var g_pass6_fn_ret_cache_vals: i64 = 0
var g_pass6_visiting_funcs: i64 = 0
var g_pass6_visiting_local_exprs: i64 = 0

enum TypeCompatKind:
    Incompatible = 0,
    Exact = 1,
    AllowedConversion = 2,
    Poisoned = 3
end.

func is_user_module(name: &string) -> int:
    let s = name as int
    if s == 0 do out 0 end
    let slen = native_read_i64(s, 8) as int
    if slen == 0 do out 0 end
    let cstr_ptr = native_read_i64(s, 0) as int
    if cstr_ptr == 0 do out 0 end
    if slen == 4 and native_read_u8(cstr_ptr, 0) == 114 and native_read_u8(cstr_ptr, 1) == 111 and native_read_u8(cstr_ptr, 2) == 111 and native_read_u8(cstr_ptr, 3) == 116 do
        out 0
    end
    if slen >= 4 and native_read_u8(cstr_ptr, 0) == 118 and native_read_u8(cstr_ptr, 1) == 105 and native_read_u8(cstr_ptr, 2) == 114 and native_read_u8(cstr_ptr, 3) == 46 do
        out 0
    end
    out 1
end.

func pass6_hash_name(name: &string):
    n = fat_str_len(name)
    if n <= 0 do
        out 0
    end
    h = n * 17
    var i = 0
    when i < n loop
        h = h * 131 + fat_str_byte_at(name, i)
        i = i + 1
    end
    if h < 0 do
        h = 0 - h
    end
    out h mod PASS6_BUCKETS
end.

func pass6_global_map_new():
    buckets = vec_new_rt()
    var bi = 0
    when bi < PASS6_BUCKETS loop
        buckets = vec_push_rt(buckets, vec_new_rt())
        bi = bi + 1
    end
    out buckets
end.

func pass6_get_short_name(name: &string) -> string:
    let n = fat_str_len(name)
    if n == 0 do out name end
    var last_dot = 0 - 1
    var i = n - 1
    when i >= 0 loop
        if fat_str_byte_at(name, i) == 46 do # '.'
            last_dot = i
            i = 0 - 1
        else
            i = i - 1
        end
    end
    if last_dot < 0 or last_dot >= n - 1 do
        out fat_str_new("")
    end
    out fat_str_slice(name, last_dot + 1, n)
end.

func pass6_index_global(name: &string, sym_id: int):
    if fat_str_len(name) == 0 do
        out 0
    end
    if g_pass6_global_buckets == 0 do
        g_pass6_global_buckets = pass6_global_map_new()
    end
    bid = pass6_hash_name(name)
    bucket = vec_get_rt(g_pass6_global_buckets, bid)
    bucket = vec_push_rt(bucket, sym_id)
    vec_set_rt(g_pass6_global_buckets, bid, bucket)

    let short_name = pass6_get_short_name(name)
    if fat_str_len(short_name) > 0 do
        if g_pass6_suffix_buckets == 0 do
            g_pass6_suffix_buckets = pass6_global_map_new()
        end
        let sbid = pass6_hash_name(short_name)
        var sbucket = vec_get_rt(g_pass6_suffix_buckets, sbid)
        sbucket = vec_push_rt(sbucket, sym_id)
        vec_set_rt(g_pass6_suffix_buckets, sbid, sbucket)
    end
    out 0
end.

func pass6_scope_buckets_new():
    buckets = vec_new_rt()
    var bi = 0
    when bi < PASS6_SCOPE_BUCKETS_COUNT loop
        buckets = vec_push_rt(buckets, vec_new_rt())
        bi = bi + 1
    end
    out buckets
end.

func pass6_index_scope_symbol(scope_id: int, name: &string, sym_id: int):
    if fat_str_len(name) == 0 do out 0 end
    if g_pass6_scope_buckets == 0 do
        g_pass6_scope_buckets = pass6_scope_buckets_new()
    end
    var h = (scope_id * 37 + pass6_hash_name(name)) and 1023
    if h < 0 do h = 0 - h end
    h = h and 1023
    var bucket = vec_get_rt(g_pass6_scope_buckets, h)
    bucket = vec_push_rt(bucket, sym_id)
    vec_set_rt(g_pass6_scope_buckets, h, bucket)
    out 0
end.

func pass6_lookup_scope_indexed(ref symbols: SymbolTable, scope_id: int, name: &string) -> int:
    if scope_id <= 0 or g_pass6_scope_buckets == 0 do out -1 end
    var h = (scope_id * 37 + pass6_hash_name(name)) and 1023
    if h < 0 do h = 0 - h end
    h = h and 1023
    let bucket = vec_get_rt(g_pass6_scope_buckets, h)
    let count = vec_len_rt(bucket)
    if count == 0 do out -1 end
    let syms_vec = native_read_i64(symbols as i64, 0)
    var i = 0
    when i < count loop
        let sym_id = vec_get_rt(bucket, i) as int
        let sym = vec_get_rt(syms_vec, sym_id)
        if (sym as i64) != 0 do
            if sym.scope_id == scope_id do
                let sym_name_ptr = native_read_i64(sym as i64, 8)
                if sym_name_ptr != 0 do
                    if fat_str_eq(sym_name_ptr as string, name) == 1 do
                        out sym_id
                    end
                end
            end
        end
        i = i + 1
    end
    out -1
end.

func pass6_rebuild_index(ref symbols: SymbolTable, ref scopes: ScopeTree):
    g_pass6_global_buckets = pass6_global_map_new()
    g_pass6_suffix_buckets = pass6_global_map_new()
    g_pass6_scope_buckets = pass6_scope_buckets_new()
    scopes_vec = native_read_i64(scopes as i64, 0)
    syms_vec = native_read_i64(symbols as i64, 0)
    let n_scopes = vec_len_rt(scopes_vec)
    var s = 0
    when s < n_scopes loop
        let scope_node = vec_get_rt(scopes_vec, s)
        let sym_list = native_read_i64(scope_node as i64, 16)
        let count = vec_len_rt(sym_list)
        var i = 0
        when i < count loop
            let sym_id = vec_get_rt(sym_list, i) as int
            let sym = vec_get_rt(syms_vec, sym_id)
            let sym_name_ptr = native_read_i64(sym as i64, 8)
            if sym_name_ptr != 0 do
                let sym_name = sym_name_ptr as string
                if s == 0 do
                    pass6_index_global(sym_name, sym_id)
                else
                    pass6_index_scope_symbol(s, sym_name, sym_id)
                end
            end
            i = i + 1
        end
        s = s + 1
    end
    out 0
end.

func pass6_typecheck(ref symbols: SymbolTable, ref scopes: ScopeTree, diag: &DiagnosticEngine, node: &AstNode):
    g_pass6_symbols = symbols as i64
    g_pass6_scopes = scopes as i64
    g_pass6_diag = diag as i64
    pass6_rebuild_index(symbols, scopes)
    g_pass6_extern_names = vec_new_rt()
    g_pass6_extern_nodes = vec_new_rt()
    g_pass6_extern_buckets = pass6_global_map_new()
    g_pass6_entity_names = vec_new_rt()
    g_pass6_entity_nodes = vec_new_rt()
    g_pass6_entity_buckets = pass6_global_map_new()
    g_pass6_enum_buckets = pass6_global_map_new()
    g_pass6_func_names = vec_new_rt()
    g_pass6_func_nodes = vec_new_rt()
    g_pass6_func_canonical_names = vec_new_rt()
    g_pass6_func_buckets = pass6_global_map_new()
    g_pass6_func_canon_buckets = pass6_global_map_new()
    g_pass6_func_canon_by_node = pass6_global_map_new()
    g_pass6_ret_stmt_buckets = pass6_global_map_new()
    g_pass6_visiting_symbols = vec_new_rt()
    g_pass6_fn_ret_cache_keys = vec_new_rt()
    g_pass6_fn_ret_cache_vals = vec_new_rt()
    g_pass6_visiting_funcs = vec_new_rt()
    g_pass6_visiting_local_exprs = vec_new_rt()
    g_pass6_sym_types = vec_new_rt()
    g_pass6_scoped_var_names = vec_new_rt()
    g_pass6_scoped_var_types = vec_new_rt()
    g_pass6_scope_watermarks = vec_new_rt()
    g_pass6_var_names = vec_new_rt()
    g_pass6_var_types = vec_new_rt()
    g_pass6_current_entity_name = 0
    g_pass6_ai_mode = 0
    g_pass6_infer_values = vec_new_rt()
    g_pass6_train_values = vec_new_rt()
    g_pass6_assigned_vars = vec_new_rt()
    pass6_collect_externs(node)
    pass6_collect_entities(node)
    pass6_collect_free_functions(node)
    pass6_walk(symbols, scopes, diag, node)
end.

func pass6_collect_free_functions(node: &AstNode):
    g_pass6_func_buckets = pass6_global_map_new()
    g_pass6_func_canon_buckets = pass6_global_map_new()
    g_pass6_func_canon_by_node = pass6_global_map_new()
    var cur_mod = fat_str_new("")
    let n_children = vec_len_rt(node.children)
    var i = 0
    when i < n_children loop
        let candidate = vec_get_rt(node.children, i)
        if candidate.node_type == AstType.ModuleStmt and fat_str_len(candidate.name) > 0 do
            cur_mod = candidate.name
        end
        var fn_c = candidate
        if (fn_c.node_type == AstType.BindAttr or fn_c.node_type == AstType.ExposeAttr) and vec_len_rt(fn_c.children) > 0 do
            fn_c = vec_get_rt(fn_c.children, 0)
        end
        if fn_c.node_type == AstType.FuncDef and fat_str_len(fn_c.name) > 0 do
            var canonical_name = fn_c.name
            if is_user_module(cur_mod) == 1 and fat_cstr_eq(fn_c.name, "main") == 0 do
                canonical_name = fat_str_concat(fat_str_concat(cur_mod, fat_str_new(".")), fn_c.name)
            end
            let k = vec_len_rt(g_pass6_func_nodes)
            g_pass6_func_names = vec_push_rt(g_pass6_func_names, fn_c.name)
            g_pass6_func_nodes = vec_push_rt(g_pass6_func_nodes, fn_c)
            g_pass6_func_canonical_names = vec_push_rt(g_pass6_func_canonical_names, canonical_name)

            let fbid = pass6_hash_name(fn_c.name)
            var fbucket = vec_get_rt(g_pass6_func_buckets, fbid)
            fbucket = vec_push_rt(fbucket, k)
            vec_set_rt(g_pass6_func_buckets, fbid, fbucket)

            let cbid = pass6_hash_name(canonical_name)
            var cbucket = vec_get_rt(g_pass6_func_canon_buckets, cbid)
            cbucket = vec_push_rt(cbucket, k)
            vec_set_rt(g_pass6_func_canon_buckets, cbid, cbucket)

            let nbid = (((fn_c as i64) shr 4) and 255) as int
            var nbucket = vec_get_rt(g_pass6_func_canon_by_node, nbid)
            nbucket = vec_push_rt(nbucket, k)
            vec_set_rt(g_pass6_func_canon_by_node, nbid, nbucket)
        end
        i = i + 1
    end
    out 0
end.

func pass6_find_free_function(name: &string):
    if g_pass6_func_buckets == 0 or fat_str_len(name) == 0 do out 0 as AstNode end
    let bid = pass6_hash_name(name)
    let bucket = vec_get_rt(g_pass6_func_buckets, bid)
    let count = vec_len_rt(bucket)
    var i = 0
    when i < count loop
        let k = vec_get_rt(bucket, i)
        if fat_str_eq(vec_get_rt(g_pass6_func_names, k) as string, name) == 1 do
            out vec_get_rt(g_pass6_func_nodes, k) as AstNode
        end
        i = i + 1
    end
    out 0 as AstNode
end.

func pass6_find_canonical_identity(fn_node: &AstNode):
    if (fn_node as i64) == 0 do out fat_str_new("") end
    if g_pass6_func_canon_by_node != 0 do
        let bid = (((fn_node as i64) shr 4) and 255) as int
        let bucket = vec_get_rt(g_pass6_func_canon_by_node, bid)
        let count = vec_len_rt(bucket)
        var i = 0
        when i < count loop
            let k = vec_get_rt(bucket, i)
            if (vec_get_rt(g_pass6_func_nodes, k) as i64) == (fn_node as i64) do
                out vec_get_rt(g_pass6_func_canonical_names, k) as string
            end
            i = i + 1
        end
    end
    out fn_node.name
end.

func pass6_find_func_by_canonical_identity(id: &string):
    if g_pass6_func_canon_buckets == 0 or fat_str_len(id) == 0 do out 0 as AstNode end
    let bid = pass6_hash_name(id)
    let bucket = vec_get_rt(g_pass6_func_canon_buckets, bid)
    let count = vec_len_rt(bucket)
    var i = 0
    when i < count loop
        let k = vec_get_rt(bucket, i)
        if fat_str_eq(vec_get_rt(g_pass6_func_canonical_names, k) as string, id) == 1 do
            out vec_get_rt(g_pass6_func_nodes, k) as AstNode
        end
        i = i + 1
    end
    out 0 as AstNode
end.

func pass6_collect_externs(node: &AstNode):
    if node as i64 == 0 do out 0 end
    if node.node_type == AstType.ExternFunc and fat_str_len(node.name) > 0 do
        g_pass6_extern_names = vec_push_rt(g_pass6_extern_names, node.name as i64)
        g_pass6_extern_nodes = vec_push_rt(g_pass6_extern_nodes, node as i64)
        if g_pass6_extern_buckets == 0 do
            g_pass6_extern_buckets = pass6_global_map_new()
        end
        let bid = pass6_hash_name(node.name)
        var bucket = vec_get_rt(g_pass6_extern_buckets, bid)
        bucket = vec_push_rt(bucket, node as i64)
        vec_set_rt(g_pass6_extern_buckets, bid, bucket)
        out 0
    end
    child_count = vec_len_rt(node.children)
    var i = 0
    when i < child_count loop
        pass6_collect_externs(vec_get_rt(node.children, i))
        i = i + 1
    end
    out 0
end.

func pass6_find_extern(name: &string):
    if g_pass6_extern_buckets == 0 or fat_str_len(name) == 0 do out 0 end
    let bid = pass6_hash_name(name)
    let bucket = vec_get_rt(g_pass6_extern_buckets, bid)
    let count = vec_len_rt(bucket)
    var i = 0
    when i < count loop
        let ext_node = vec_get_rt(bucket, i) as AstNode
        if fat_str_eq(ext_node.name, name) == 1 do
            out ext_node as i64
        end
        i = i + 1
    end
    out 0
end.


func pass6_symbol_at(ref symbols: SymbolTable, id: int):
    # Avoid ambiguous nested entity-field lowering in native self-host code.
    if (symbols as i64) == 0 or id < 0 do out 0 end
    syms_vec = native_read_i64(symbols as i64, 0)
    if syms_vec == 0 do out 0 end
    if id >= vec_len_rt(syms_vec) do out 0 end
    out vec_get_rt(syms_vec, id)
end.


# Evaluate integer constant syntax used where semantics depend on sign.  Const
# identifiers are followed through their declaration AST; mutable variables are
# deliberately not folded because their runtime value may change.
func pass6_eval_const_int(ref symbols: SymbolTable, ref scopes: ScopeTree, node: &AstNode, depth: int):
    if node as i64 == 0 or depth > 32 do out (0, 0) end
    if node.node_type == AstType.LiteralInt do out (1, node.int_val) end
    if node.node_type == AstType.Identifier do
        found = pass6_lookup_chain(symbols, scopes, scope_current_id(scopes), node.name)
        if found != -1 do
            sym = pass6_symbol_at(symbols, found)
            if not sym.is_mutable and sym.ast_id != 0 do
                decl = sym.ast_id as AstNode
                if decl.node_type == AstType.ConstDecl and vec_len_rt(decl.children) > 0 do
                    out pass6_eval_const_int(symbols, scopes, vec_get_rt(decl.children, 0), depth + 1)
                end
            end
        end
        out (0, 0)
    end
    if node.node_type == AstType.BinOp and vec_len_rt(node.children) >= 2 do
        var (lok, lv) = pass6_eval_const_int(symbols, scopes, vec_get_rt(node.children, 0), depth + 1)
        var (rok, rv) = pass6_eval_const_int(symbols, scopes, vec_get_rt(node.children, 1), depth + 1)
        if lok == 0 or rok == 0 do out (0, 0) end
        if node.op == OpType.Add do out (1, lv + rv) end
        if node.op == OpType.Sub do out (1, lv - rv) end
        if node.op == OpType.Mul do out (1, lv * rv) end
        if node.op == OpType.Div and rv != 0 do out (1, lv / rv) end
        if node.op == OpType.ModOp and rv != 0 do out (1, lv mod rv) end
    end
    out (0, 0)
end.

func pass6_call_returns_first_arg(name: i64):
    if fat_cstr_eq(name, "ast_add_child") == 1 do out 1 end
    if fat_cstr_eq(name, "vec_push_rt") == 1 do out 1 end
    if fat_cstr_eq(name, "vec_set_rt") == 1 do out 1 end
    if fat_cstr_eq(name, "vec_push") == 1 do out 1 end
    if fat_cstr_eq(name, "ast_vec_push") == 1 do out 1 end
    if fat_cstr_eq(name, "ast_vec_bump_new") == 1 do out 1 end
    if fat_cstr_eq(name, "codebuf_emit_byte") == 1 do out 1 end
    if fat_cstr_eq(name, "codebuf_emit_u32") == 1 do out 1 end
    if fat_cstr_eq(name, "codebuf_emit_u64") == 1 do out 1 end
    if fat_cstr_eq(name, "codebuf_emit_i32") == 1 do out 1 end
    if fat_cstr_eq(name, "buf_write_u8") == 1 do out 1 end
    if fat_cstr_eq(name, "buf_align") == 1 do out 1 end
    if fat_cstr_eq(name, "bvec_push") == 1 do out 1 end
    if fat_cstr_eq(name, "text_splice_at") == 1 do out 1 end
    out 0
end.

func pass6_find_return_stmt_uncached(node: &AstNode) -> AstNode:
    if (node as i64) == 0 do out 0 as AstNode end
    if node.node_type == AstType.ReturnStmt and vec_len_rt(node.children) > 0 do
        out node
    end
    var n = vec_len_rt(node.children)
    var i = 0
    when i < n loop
        var ch = vec_get_rt(node.children, i) as AstNode
        if ch.node_type != AstType.FuncDef do
            var ret_s_child = pass6_find_return_stmt_uncached(ch)
            if (ret_s_child as i64) != 0 do out ret_s_child end
        end
        i = i + 1
    end
    out 0 as AstNode
end.

func pass6_find_return_stmt(node: &AstNode) -> AstNode:
    if (node as i64) == 0 do out 0 as AstNode end
    if g_pass6_ret_stmt_buckets == 0 do
        g_pass6_ret_stmt_buckets = pass6_global_map_new()
    end
    let bid = (((node as i64) shr 4) and 255) as int
    let bucket = vec_get_rt(g_pass6_ret_stmt_buckets, bid)
    let count = vec_len_rt(bucket)
    var i = 0
    when i < count loop
        let entry_node = vec_get_rt(bucket, i) as i64
        if entry_node == (node as i64) do
            out vec_get_rt(bucket, i + 1) as AstNode
        end
        i = i + 2
    end
    let ret_s = pass6_find_return_stmt_uncached(node)
    var new_bucket = bucket
    new_bucket = vec_push_rt(new_bucket, node as i64)
    new_bucket = vec_push_rt(new_bucket, ret_s as i64)
    vec_set_rt(g_pass6_ret_stmt_buckets, bid, new_bucket)
    out ret_s
end.

func pass6_find_param_entity(fn_node: &AstNode, param_name: &string):
    if (fn_node as i64) == 0 do out fat_str_new("") end
    let n = vec_len_rt(fn_node.children)
    var i = 0
    when i < n loop
        let ch = vec_get_rt(fn_node.children, i) as AstNode
        if (ch as i64) != 0 do
            if (ch.node_type == AstType.ParamDef or ch.node_type == AstType.RefParam or ch.node_type == AstType.OutParam or ch.node_type == AstType.Identifier) and fat_str_eq(ch.name, param_name) == 1 do
                if fat_str_len(ch.name2) > 0 do
                    out pass6_unwrap_type_name(ch.name2)
                end
                out fat_str_new("")
            end
        end
        i = i + 1
    end
    out fat_str_new("")
end.

func pass6_find_local_decl_in_node(node: &AstNode, name: int) -> AstNode:
    if (node as i64) == 0 do out 0 as AstNode end
    if (node.node_type == AstType.VarDecl or node.node_type == AstType.ConstDecl) and fat_str_eq(node.name, name) == 1 do
        out node
    end
    let n = vec_len_rt(node.children)
    var i = 0
    when i < n loop
        let ch = vec_get_rt(node.children, i) as AstNode
        if ch.node_type != AstType.FuncDef do
            let res = pass6_find_local_decl_in_node(ch, name)
            if (res as i64) != 0 do out res end
        end
        i = i + 1
    end
    out 0 as AstNode
end.

func pass6_infer_unannotated_fn_return(ref symbols: SymbolTable, fn_node: &AstNode) -> TypeKind:
    if (fn_node as i64) == 0 do out TypeKind.Void end
    let fn_key = fn_node as i64
    if g_pass6_fn_ret_cache_keys != 0 do
        var ci = 0
        let n_c = vec_len_rt(g_pass6_fn_ret_cache_keys)
        when ci < n_c loop
            if vec_get_rt(g_pass6_fn_ret_cache_keys, ci) == fn_key do
                out vec_get_rt(g_pass6_fn_ret_cache_vals, ci) as TypeKind
            end
            ci = ci + 1
        end
    end
    if g_pass6_visiting_funcs != 0 do
        var vi = 0
        let n_v = vec_len_rt(g_pass6_visiting_funcs)
        when vi < n_v loop
            if vec_get_rt(g_pass6_visiting_funcs, vi) == fn_key do
                out TypeKind.Void
            end
            vi = vi + 1
        end
    end
    g_pass6_visiting_funcs = vec_push_rt(g_pass6_visiting_funcs, fn_key)

    var res_kind = TypeKind.Void
    let ret_stmt = pass6_find_return_stmt(fn_node)
    if (ret_stmt as i64) != 0 do
        if vec_len_rt(ret_stmt.children) > 0 do
            let ret_expr = vec_get_rt(ret_stmt.children, 0) as AstNode
            res_kind = pass6_infer_local_expr(symbols, fn_node, ret_expr)
        end
    end

    let v_len = vec_len_rt(g_pass6_visiting_funcs)
    if g_pass6_visiting_funcs != 0 and v_len > 0 do
        native_write_i64(g_pass6_visiting_funcs - 8, 0, v_len - 1)
    end

    if g_pass6_fn_ret_cache_keys != 0 do
        g_pass6_fn_ret_cache_keys = vec_push_rt(g_pass6_fn_ret_cache_keys, fn_key)
        g_pass6_fn_ret_cache_vals = vec_push_rt(g_pass6_fn_ret_cache_vals, res_kind as i64)
    end
    out res_kind
end.

func pass6_infer_local_expr(ref symbols: SymbolTable, fn_node: &AstNode, expr: &AstNode) -> TypeKind:
    if (expr as i64) == 0 do out TypeKind.Void end
    let expr_key = expr as i64
    if g_pass6_visiting_local_exprs != 0 do
        var vi = 0
        let n_v = vec_len_rt(g_pass6_visiting_local_exprs)
        when vi < n_v loop
            if vec_get_rt(g_pass6_visiting_local_exprs, vi) == expr_key do
                out TypeKind.Void
            end
            vi = vi + 1
        end
    end
    g_pass6_visiting_local_exprs = vec_push_rt(g_pass6_visiting_local_exprs, expr_key)
    let res = pass6_infer_local_expr_inner(symbols, fn_node, expr)
    let v_len = vec_len_rt(g_pass6_visiting_local_exprs)
    if g_pass6_visiting_local_exprs != 0 and v_len > 0 do
        native_write_i64(g_pass6_visiting_local_exprs - 8, 0, v_len - 1)
    end
    out res
end.

func pass6_infer_local_expr_inner(ref symbols: SymbolTable, fn_node: &AstNode, expr: &AstNode) -> TypeKind:
    if (expr as i64) == 0 do out TypeKind.Void end
    if expr.node_type == AstType.LiteralInt do out TypeKind.Int end
    if expr.node_type == AstType.LiteralFloat or expr.node_type == AstType.PercentExpr do out TypeKind.Float end
    if expr.node_type == AstType.LiteralBool do out TypeKind.Bool end
    if expr.node_type == AstType.LiteralStr or expr.node_type == AstType.InterpExpr do out TypeKind.String end
    if expr.node_type == AstType.BinOp do
        let n_ch = vec_len_rt(expr.children)
        if n_ch >= 2 do
            if fat_cstr_eq(expr.name, "==") == 1 or fat_cstr_eq(expr.name, "!=") == 1 or fat_cstr_eq(expr.name, "<") == 1 or fat_cstr_eq(expr.name, "<=") == 1 or fat_cstr_eq(expr.name, ">") == 1 or fat_cstr_eq(expr.name, ">=") == 1 or fat_cstr_eq(expr.name, "and") == 1 or fat_cstr_eq(expr.name, "or") == 1 do
                out TypeKind.Bool
            end
            let l_expr = vec_get_rt(expr.children, 0) as AstNode
            let r_expr = vec_get_rt(expr.children, 1) as AstNode
            let lk = pass6_infer_local_expr(symbols, fn_node, l_expr)
            let rk = pass6_infer_local_expr(symbols, fn_node, r_expr)
            if lk == TypeKind.Float or rk == TypeKind.Float do out TypeKind.Float end
            if lk == TypeKind.Int or rk == TypeKind.Int do out TypeKind.Int end
            if lk != TypeKind.Void do out lk end
            if rk != TypeKind.Void do out rk end
        end
        out TypeKind.Void
    end
    if expr.node_type == AstType.UnaryNot do out TypeKind.Bool end
    if expr.node_type == AstType.UnaryMinus do out TypeKind.Int end
    if expr.node_type == AstType.Identifier do
        let n_fn_ch = vec_len_rt(fn_node.children)
        var pi = 0
        var is_param = false
        var param_kind = TypeKind.Void
        when pi < n_fn_ch loop
            let p_ch = vec_get_rt(fn_node.children, pi) as AstNode
            if p_ch.node_type != AstType.Block do
                if fat_str_eq(p_ch.name, expr.name) == 1 do
                    is_param = true
                    if fat_str_len(p_ch.name2) > 0 do
                        let pk = pass6_resolve_ffi_type(p_ch.name2)
                        if pk != TypeKind.Void do param_kind = pk end
                    end
                end
            end
            pi = pi + 1
        end
        if is_param do
            if param_kind != TypeKind.Void do out param_kind end
            out TypeKind.Int
        end
        let decl = pass6_find_local_decl_in_node(fn_node, expr.name)
        if (decl as i64) != 0 do
            if fat_str_len(decl.name2) > 0 do
                let dk = pass6_resolve_ffi_type(decl.name2)
                if dk != TypeKind.Void do out dk end
            end
            if vec_len_rt(decl.children) > 0 do
                let init_expr = vec_get_rt(decl.children, 0) as AstNode
                out pass6_infer_local_expr(symbols, fn_node, init_expr)
            end
        end
        let gid = pass6_lookup_global(symbols, expr.name)
        if gid != -1 do
            let gsym = pass6_symbol_at(symbols, gid)
            if gsym.type_id != 0 do
                out gsym.type_id as TypeKind
            end
        end
        out TypeKind.Void
    end
    if expr.node_type == AstType.CastExpr do
        let c_k = pass6_resolve_ffi_type(expr.name)
        if c_k != TypeKind.Void do out c_k end
        let c_base = pass6_extract_base_name(expr.name)
        let c_sid = pass6_lookup_global(symbols, c_base)
        if c_sid != -1 do
            let c_sym = pass6_symbol_at(symbols, c_sid)
            if c_sym.kind == SymbolKind.Entity do out TypeKind.Entity end
            if c_sym.kind == SymbolKind.Enum do out TypeKind.Enum end
        end
        if pass6_is_array_type_str(expr.name) do
            out TypeKind.Array
        end
        out TypeKind.Int
    end
    if expr.node_type == AstType.Call do
        if fat_cstr_eq(expr.name, "fat_str_new") == 1 or fat_cstr_eq(expr.name, "fat_str_concat") == 1 or fat_cstr_eq(expr.name, "fat_char_to_str") == 1 or fat_cstr_eq(expr.name, "str_from_cstr") == 1 or fat_cstr_eq(expr.name, "str_concat") == 1 or fat_cstr_eq(expr.name, "str_slice") == 1 or fat_cstr_eq(expr.name, "fat_str_slice") == 1 or fat_cstr_eq(expr.name, "rt_strcat") == 1 or fat_cstr_eq(expr.name, "rt_itoa") == 1 or fat_cstr_eq(expr.name, "str_trim") == 1 or fat_cstr_eq(expr.name, "str_to_lower") == 1 or fat_cstr_eq(expr.name, "str_to_upper") == 1 or fat_cstr_eq(expr.name, "str_repeat") == 1 or fat_cstr_eq(expr.name, "str_replace") == 1 do
            out TypeKind.String
        end
        if fat_cstr_eq(expr.name, "native_read_i64") == 1 or fat_cstr_eq(expr.name, "native_read_u8") == 1 or fat_cstr_eq(expr.name, "native_read_i32") == 1 or fat_cstr_eq(expr.name, "native_read_u32") == 1 or fat_cstr_eq(expr.name, "native_read_u64") == 1 or fat_cstr_eq(expr.name, "native_read_i16") == 1 or fat_cstr_eq(expr.name, "native_read_u16") == 1 do
            out TypeKind.Int
        end
        if fat_cstr_eq(expr.name, "syscall1") == 1 or fat_cstr_eq(expr.name, "syscall2") == 1 or fat_cstr_eq(expr.name, "syscall3") == 1 or fat_cstr_eq(expr.name, "syscall4") == 1 or fat_cstr_eq(expr.name, "syscall5") == 1 or fat_cstr_eq(expr.name, "syscall6") == 1 do
            out TypeKind.Int
        end
        if fat_cstr_eq(expr.name, "rt_strlen") == 1 or fat_cstr_eq(expr.name, "rt_atoi") == 1 or fat_cstr_eq(expr.name, "rt_streq") == 1 or fat_cstr_eq(expr.name, "str_len") == 1 or fat_cstr_eq(expr.name, "str_byte_len") == 1 or fat_cstr_eq(expr.name, "fat_str_len") == 1 or fat_cstr_eq(expr.name, "vec_len") == 1 or fat_cstr_eq(expr.name, "dict_len") == 1 do
            out TypeKind.Int
        end
        if fat_cstr_eq(expr.name, "str_eq") == 1 or fat_cstr_eq(expr.name, "fat_str_eq") == 1 or fat_cstr_eq(expr.name, "str_contains") == 1 or fat_cstr_eq(expr.name, "str_starts_with") == 1 or fat_cstr_eq(expr.name, "str_ends_with") == 1 or fat_cstr_eq(expr.name, "dict_has_key") == 1 do
            out TypeKind.Bool
        end
        let c_ast = pass6_find_free_function(expr.name)
        if (c_ast as i64) != 0 do
            if fat_str_len(c_ast.name2) > 0 do
                let c_ret_k = pass6_resolve_ffi_type(c_ast.name2)
                if c_ret_k != TypeKind.Void do out c_ret_k end
            else
                out pass6_infer_unannotated_fn_return(symbols, c_ast)
            end
        else
            let ext_p = pass6_find_extern(expr.name)
            if ext_p != 0 do
                let ext_ast = ext_p as AstNode
                if fat_str_len(ext_ast.name2) > 0 do
                    let ext_k = pass6_resolve_ffi_type(ext_ast.name2)
                    if ext_k != TypeKind.Void do out ext_k end
                end
            end
        end
    end
    out TypeKind.Void
end.

func pass6_infer_call_return(ref symbols: SymbolTable, ref scopes: ScopeTree, node: &AstNode):
    if node.node_type != AstType.Call and node.node_type != AstType.MethodCall do
        out TypeKind.Void
    end
    found = pass6_lookup_chain(symbols, scopes, scope_current_id(scopes), node.name)
    if found != -1 do
        sym = pass6_symbol_at(symbols, found)
        if (sym as i64) != 0 do
            if sym.return_type != 0 and (sym.return_type as TypeKind) != TypeKind.Entity do
                out sym.return_type as TypeKind
            end
        end
    end
    if pass6_call_returns_first_arg(node.name as i64) == 1 do
        child_count = vec_len_rt(node.children)
        if child_count > 0 do
            arg0 = vec_get_rt(node.children, 0)
            arg0_ty = pass6_infer_type(symbols, scopes, arg0)
            if arg0_ty != TypeKind.Void do
                out arg0_ty
            end
        end
    end
    if node.node_type == AstType.MethodCall and vec_len_rt(node.children) > 0 do
        let m_recv = vec_get_rt(node.children, 0) as AstNode
        let m_recv_ent = pass6_get_receiver_entity_name(symbols, scopes, m_recv)
        if fat_str_len(m_recv_ent) > 0 do
            let m_ent_ast = pass6_find_entity_ast(symbols, scopes, m_recv_ent)
            if (m_ent_ast as i64) != 0 do
                let n_ech = vec_len_rt(m_ent_ast.children)
                var mi = 0
                when mi < n_ech loop
                    let m_child = vec_get_rt(m_ent_ast.children, mi) as AstNode
                    if m_child.node_type == AstType.FuncDef and fat_str_eq(m_child.name, node.name) == 1 do
                        if fat_str_len(m_child.name2) > 0 do
                            let m_ret_k = pass6_resolve_ffi_type(m_child.name2)
                            if m_ret_k != TypeKind.Void do out m_ret_k end
                            if (pass6_find_entity_ast(symbols, scopes, pass6_extract_base_name(m_child.name2)) as i64) != 0 do
                                out TypeKind.Entity
                            end
                        end
                        mi = n_ech
                    else
                        mi = mi + 1
                    end
                end
            end
        end
        if m_recv.node_type == AstType.Identifier do
            let mod_mname = fat_str_concat(fat_str_concat(m_recv.name, fat_str_new(".")), node.name)
            let mod_fn = pass6_find_func_by_canonical_identity(mod_mname)
            if (mod_fn as i64) != 0 do
                if fat_str_len(mod_fn.name2) > 0 do
                    let mod_ret_k = pass6_resolve_ffi_type(mod_fn.name2)
                    if mod_ret_k != TypeKind.Void do out mod_ret_k end
                    if (pass6_find_entity_ast(symbols, scopes, pass6_extract_base_name(mod_fn.name2)) as i64) != 0 do
                        out TypeKind.Entity
                    end
                end
            end
        end
    end
    call_fn = pass6_find_free_function(node.name)
    if (call_fn as i64) == 0 do
        if is_user_module(g_pass6_cur_module) == 1 do
            let mod_call_name = fat_str_concat(fat_str_concat(g_pass6_cur_module, fat_str_new(".")), node.name)
            call_fn = pass6_find_func_by_canonical_identity(mod_call_name)
        end
    end
    if (call_fn as i64) == 0 do
        let ext_p = pass6_find_extern(node.name)
        if ext_p != 0 do
            call_fn = ext_p as AstNode
        end
    end
    if fat_cstr_eq(node.name, "native_read_i64") == 1 or fat_cstr_eq(node.name, "native_read_u8") == 1 or fat_cstr_eq(node.name, "native_read_i32") == 1 or fat_cstr_eq(node.name, "native_read_u32") == 1 or fat_cstr_eq(node.name, "native_read_u64") == 1 or fat_cstr_eq(node.name, "native_read_i16") == 1 or fat_cstr_eq(node.name, "native_read_u16") == 1 do
        out TypeKind.Int
    end
    if fat_cstr_eq(node.name, "syscall1") == 1 or fat_cstr_eq(node.name, "syscall2") == 1 or fat_cstr_eq(node.name, "syscall3") == 1 or fat_cstr_eq(node.name, "syscall4") == 1 or fat_cstr_eq(node.name, "syscall5") == 1 or fat_cstr_eq(node.name, "syscall6") == 1 do
        out TypeKind.Int
    end
    if fat_cstr_eq(node.name, "rt_strlen") == 1 or fat_cstr_eq(node.name, "rt_atoi") == 1 or fat_cstr_eq(node.name, "rt_streq") == 1 or fat_cstr_eq(node.name, "str_len") == 1 or fat_cstr_eq(node.name, "str_byte_len") == 1 or fat_cstr_eq(node.name, "fat_str_len") == 1 or fat_cstr_eq(node.name, "vec_len") == 1 or fat_cstr_eq(node.name, "dict_len") == 1 do
        out TypeKind.Int
    end
    if fat_cstr_eq(node.name, "str_eq") == 1 or fat_cstr_eq(node.name, "fat_str_eq") == 1 or fat_cstr_eq(node.name, "str_contains") == 1 or fat_cstr_eq(node.name, "str_starts_with") == 1 or fat_cstr_eq(node.name, "str_ends_with") == 1 or fat_cstr_eq(node.name, "dict_has_key") == 1 do
        out TypeKind.Bool
    end
    if fat_cstr_eq(node.name, "fat_str_new") == 1 or fat_cstr_eq(node.name, "fat_str_concat") == 1 or fat_cstr_eq(node.name, "fat_char_to_str") == 1 or fat_cstr_eq(node.name, "str_from_cstr") == 1 or fat_cstr_eq(node.name, "str_concat") == 1 or fat_cstr_eq(node.name, "str_slice") == 1 or fat_cstr_eq(node.name, "fat_str_slice") == 1 or fat_cstr_eq(node.name, "rt_strcat") == 1 or fat_cstr_eq(node.name, "rt_itoa") == 1 or fat_cstr_eq(node.name, "str_trim") == 1 or fat_cstr_eq(node.name, "str_to_lower") == 1 or fat_cstr_eq(node.name, "str_to_upper") == 1 or fat_cstr_eq(node.name, "str_repeat") == 1 or fat_cstr_eq(node.name, "str_replace") == 1 do
        out TypeKind.String
    end
    if (call_fn as i64) != 0 do
        if fat_str_len(call_fn.name2) > 0 do
            ret_k = pass6_resolve_ffi_type(call_fn.name2)
            if ret_k != TypeKind.Void do
                out ret_k
            end
            let ent = pass6_find_entity_ast(symbols, scopes, pass6_extract_base_name(call_fn.name2))
            if (ent as i64) != 0 do
                out TypeKind.Entity
            end
            if call_fn.builtin_id != 0 do
                if fat_str_len(node.name2) > 0 do
                    let gen_ret_k = pass6_resolve_ffi_type(node.name2)
                    if gen_ret_k != TypeKind.Void do
                        out gen_ret_k
                    end
                end
            end
        end
        if fat_str_len(call_fn.name2) == 0 do
            if fat_cstr_eq(node.name, "fat_str_new") == 1 or fat_cstr_eq(node.name, "fat_str_concat") == 1 or fat_cstr_eq(node.name, "fat_char_to_str") == 1 or fat_cstr_eq(node.name, "str_from_cstr") == 1 or fat_cstr_eq(node.name, "str_concat") == 1 or fat_cstr_eq(node.name, "str_slice") == 1 or fat_cstr_eq(node.name, "fat_str_slice") == 1 or fat_cstr_eq(node.name, "rt_strcat") == 1 or fat_cstr_eq(node.name, "rt_itoa") == 1 or fat_cstr_eq(node.name, "str_trim") == 1 or fat_cstr_eq(node.name, "str_to_lower") == 1 or fat_cstr_eq(node.name, "str_to_upper") == 1 or fat_cstr_eq(node.name, "str_repeat") == 1 or fat_cstr_eq(node.name, "str_replace") == 1 do
                out TypeKind.String
            end
            let inferred_ret = pass6_infer_unannotated_fn_return(symbols, call_fn)
            if inferred_ret != TypeKind.Void do
                out inferred_ret
            end
            out TypeKind.Void
        end
    end
    out TypeKind.Void
end.

func pass6_infer_type(ref symbols: SymbolTable, ref scopes: ScopeTree, node: &AstNode):
    if node.node_type == AstType.LiteralInt do
        out TypeKind.Int
    end
    if node.node_type == AstType.LiteralFloat do
        out TypeKind.Float
    end
    if node.node_type == AstType.PercentExpr do
        out TypeKind.Float
    end
    if node.node_type == AstType.LiteralBool do
        out TypeKind.Bool
    end
    if node.node_type == AstType.LiteralNone do
        out TypeKind.None
    end
    if node.node_type == AstType.DictLiteral do
        out TypeKind.Dict
    end
    if node.node_type == AstType.ArrayLiteral do
        out TypeKind.Array
    end
    if node.node_type == AstType.TupleExpr do
        out TypeKind.Tuple
    end
    if node.node_type == AstType.EntityLiteral do
        out TypeKind.Entity
    end
    if node.node_type == AstType.AddrOf do
        out TypeKind.Ref
    end
    if node.node_type == AstType.LiteralStr or node.node_type == AstType.InterpExpr do
        out TypeKind.String
    end
    if node.node_type == AstType.Identifier do
        found = pass6_lookup_chain(symbols, scopes, scope_current_id(scopes), node.name)
        if found != -1 do
            sym = pass6_symbol_at(symbols, found)
            if (sym as i64) != 0 do
                if sym.type_id != 0 do
                    out sym.type_id as TypeKind
                end
                if sym.ast_id != 0 do
                    decl = sym.ast_id as AstNode
                    if (decl.node_type == AstType.VarDecl or decl.node_type == AstType.ConstDecl) and vec_len_rt(decl.children) > 0 do
                        var vi = 0
                        var n_vis = vec_len_rt(g_pass6_visiting_symbols)
                        var in_cycle = false
                        when vi < n_vis loop
                            if vec_get_rt(g_pass6_visiting_symbols, vi) == (found as i64) do
                                in_cycle = true
                                vi = n_vis
                            else
                                vi = vi + 1
                            end
                        end
                        if in_cycle do
                            if g_pass6_diag != 0 do
                                report_error(g_pass6_diag as DiagnosticEngine, 3097, decl.line, 0)
                            end
                            out TypeKind.Void
                        end
                        g_pass6_visiting_symbols = vec_push_rt(g_pass6_visiting_symbols, found as i64)
                        init_node = vec_get_rt(decl.children, 0)
                        inferred_init = pass6_infer_type(symbols, scopes, init_node)
                        let v_len = vec_len_rt(g_pass6_visiting_symbols)
                        if v_len > 0 do
                            native_write_i64(g_pass6_visiting_symbols - 8, 0, v_len - 1)
                        end
                        if inferred_init != TypeKind.Void do
                            native_write_i64(sym as i64, 16, inferred_init as i64)
                            out inferred_init
                        end
                    end
                end
                out sym.type_id as TypeKind
            end
        end
        out TypeKind.Void
    end
    if node.node_type == AstType.BinOp do
        child_count = vec_len_rt(node.children)
        if child_count >= 2 do
            left = vec_get_rt(node.children, 0)
            right = vec_get_rt(node.children, 1)
            lt = pass6_infer_type(symbols, scopes, left)
            rt_type = pass6_infer_type(symbols, scopes, right)
            if node.op == OpType.MatMulOp or node.op == OpType.FmaOp do
                out TypeKind.Tensor
            end
            if node.op == OpType.PowOp and node.int_val == 1 do
                out TypeKind.Float
            end
            if node.op == OpType.Eq or node.op == OpType.Ne or node.op == OpType.Gt or node.op == OpType.Lt or node.op == OpType.Ge or node.op == OpType.Le do
                out TypeKind.Bool
            end
            if node.op == OpType.Land or node.op == OpType.Lor do
                out TypeKind.Bool
            end
            if node.op == OpType.AndOp or node.op == OpType.OrOp or node.op == OpType.XorOp do
                if lt == TypeKind.Bool and rt_type == TypeKind.Bool do
                    out TypeKind.Bool
                end
                out TypeKind.Int
            end
            if node.op == OpType.ShlOp or node.op == OpType.ShrOp do
                out TypeKind.Int
            end
            if lt == TypeKind.Float or rt_type == TypeKind.Float do
                out TypeKind.Float
            end
            if lt == TypeKind.String and rt_type == TypeKind.String do
                out TypeKind.String
            end
            if lt == TypeKind.Bool or rt_type == TypeKind.Bool do
                out TypeKind.Bool
            end
            if lt != TypeKind.Void do
                out lt
            end
            out rt_type
        end
    end
    if node.node_type == AstType.Compare do
        out TypeKind.Bool
    end
    if node.node_type == AstType.EnumConstruct do
        out TypeKind.Enum
    end
    if node.node_type == AstType.Call and fat_cstr_eq(node.name, "flux") do
        out TypeKind.Flux
    end
    if node.node_type == AstType.SwizzleExpr do
        out TypeKind.Flux
    end
    if node.node_type == AstType.Call or node.node_type == AstType.MethodCall do
        out pass6_infer_call_return(symbols, scopes, node)
    end
    if node.node_type == AstType.BuiltinCall do
        if node.builtin_id == 11 or node.builtin_id == 19 do
            out TypeKind.String
        end
        if node.builtin_id == 12 do
            out TypeKind.Bool
        end
        if fat_cstr_eq(node.name, "str_concat") == 1 or fat_cstr_eq(node.name, "str_cat") == 1 or fat_cstr_eq(node.name, "fat_str_concat") == 1 or fat_cstr_eq(node.name, "fat_str_new") == 1 or fat_cstr_eq(node.name, "str_slice") == 1 or fat_cstr_eq(node.name, "fat_str_slice") == 1 or fat_cstr_eq(node.name, "rt_strcat") == 1 or fat_cstr_eq(node.name, "rt_itoa") == 1 or fat_cstr_eq(node.name, "str_trim") == 1 or fat_cstr_eq(node.name, "str_to_lower") == 1 or fat_cstr_eq(node.name, "str_to_upper") == 1 or fat_cstr_eq(node.name, "str_repeat") == 1 or fat_cstr_eq(node.name, "str_replace") == 1 do
            out TypeKind.String
        end
        if fat_cstr_eq(node.name, "str_eq") == 1 or fat_cstr_eq(node.name, "fat_str_eq") == 1 or fat_cstr_eq(node.name, "str_contains") == 1 or fat_cstr_eq(node.name, "str_starts_with") == 1 or fat_cstr_eq(node.name, "str_ends_with") == 1 or fat_cstr_eq(node.name, "dict_has_key") == 1 do
            out TypeKind.Bool
        end
        out TypeKind.Int
    end
    if node.node_type == AstType.QuantizeExpr do
        out TypeKind.QuantizedTensor
    end
    if node.node_type == AstType.PrecompBlock do
        if vec_len_rt(node.children) > 0 do
            out pass6_infer_type(symbols, scopes, vec_get_rt(node.children, 0) as AstNode)
        end
        out TypeKind.Int
    end
    if node.node_type == AstType.CastExpr do
        let cty = pass6_resolve_ffi_type(node.name)
        if cty != TypeKind.Void do out cty end
        let c_ent = pass6_find_entity_ast(symbols, scopes, pass6_extract_base_name(node.name))
        if (c_ent as i64) != 0 do out TypeKind.Entity end
        let c_enum = pass6_find_enum_ast(symbols, scopes, node.name)
        if (c_enum as i64) != 0 do out TypeKind.Enum end
        out TypeKind.Void
    end
    if node.node_type == AstType.Assign do
        if vec_len_rt(node.children) > 0 do
            out pass6_infer_type(symbols, scopes, vec_get_rt(node.children, 0))
        end
        out TypeKind.Void
    end
    if node.node_type == AstType.IndexAccess do
        base_id = pass6_lookup_chain(symbols, scopes, scope_current_id(scopes), node.name)
        if base_id != -1 do
            base_sym = pass6_symbol_at(symbols, base_id)
            if base_sym.ast_id != 0 do
                base_decl = base_sym.ast_id as AstNode
                if fat_str_len(base_decl.name2) > 0 do
                    let b_elem_str = pass6_extract_generic_or_array_elem(base_decl.name2)
                    if fat_str_len(b_elem_str) > 0 do
                        let b_elem_k = pass6_resolve_ffi_type(b_elem_str)
                        if b_elem_k != TypeKind.Void do
                            out b_elem_k
                        end
                        let b_ent = pass6_find_entity_ast(symbols, scopes, pass6_extract_base_name(b_elem_str))
                        if (b_ent as i64) != 0 do
                            out TypeKind.Entity
                        end
                    end
                end
                if vec_len_rt(base_decl.children) > 0 do
                    base_init = vec_get_rt(base_decl.children, 0)
                    if base_init.node_type == AstType.ArrayLiteral and vec_len_rt(base_init.children) > 0 do
                        out pass6_infer_type(symbols, scopes, vec_get_rt(base_init.children, 0))
                    end
                end
            end
        end
        out TypeKind.Void
    end
    if node.node_type == AstType.FieldAccess do
        field_type_name = pass6_get_receiver_entity_name(symbols, scopes, node)
        if fat_str_len(field_type_name) > 0 do
            field_kind = pass6_resolve_ffi_type(field_type_name)
            if field_kind != TypeKind.Void do out field_kind end
            let f_ent = pass6_find_entity_ast(symbols, scopes, pass6_extract_base_name(field_type_name))
            if (f_ent as i64) != 0 do out TypeKind.Entity end
        end
        out TypeKind.Void
    end
    if node.node_type == AstType.UnaryMinus do
        out TypeKind.Int
    end
    if node.node_type == AstType.UnaryNot do
        out TypeKind.Bool
    end
    out TypeKind.Void
end.

# Deep inference is intentionally interpolation-local. Applying entity field
# and method return inference to all assignments changes legacy self-host type
# compatibility; interpolation needs the precision only to select stringify.
func pass6_infer_interp_type(ref symbols: SymbolTable, ref scopes: ScopeTree, node: &AstNode):
    if node.node_type == AstType.Identifier do
        ident_id = pass6_lookup_chain(symbols, scopes, scope_current_id(scopes), node.name)
        if ident_id != -1 do
            ident_sym = pass6_symbol_at(symbols, ident_id)
            if ident_sym.ast_id != 0 do
                ident_decl = ident_sym.ast_id as AstNode
                explicit_kind = pass6_resolve_ffi_type(ident_decl.name2)
                if explicit_kind != TypeKind.Void do out explicit_kind end
                if (ident_decl.node_type == AstType.VarDecl or ident_decl.node_type == AstType.ConstDecl or ident_decl.node_type == AstType.AtomicVarDecl) and vec_len_rt(ident_decl.children) > 0 do
                    ident_init = vec_get_rt(ident_decl.children, 0)
                    if ident_init.node_type != AstType.Identifier or fat_str_eq(ident_init.name, node.name) == 0 do
                        out pass6_infer_interp_type(symbols, scopes, ident_init)
                    end
                end
            end
        end
        out pass6_infer_type(symbols, scopes, node)
    end
    if node.node_type == AstType.IndexAccess do
        base_id = pass6_lookup_chain(symbols, scopes, scope_current_id(scopes), node.name)
        if base_id != -1 do
            base_sym = pass6_symbol_at(symbols, base_id)
            if base_sym.ast_id != 0 do
                base_decl = base_sym.ast_id as AstNode
                if vec_len_rt(base_decl.children) > 0 do
                    base_init = vec_get_rt(base_decl.children, 0)
                    if base_init.node_type == AstType.ArrayLiteral and vec_len_rt(base_init.children) > 0 do
                        out pass6_infer_interp_type(symbols, scopes, vec_get_rt(base_init.children, 0))
                    end
                end
            end
        end
        # Preserve the existing integer-array default when element metadata is
        # unavailable (parameters, extern buffers, and dynamically built arrays).
        out TypeKind.Int
    end
    if node.node_type == AstType.FieldAccess do
        field_type_name = pass6_get_receiver_entity_name(symbols, scopes, node)
        field_kind = pass6_resolve_ffi_type(field_type_name)
        if field_kind != TypeKind.Void do out field_kind end
        if pass6_find_entity_ast(symbols, scopes, field_type_name) != 0 do out TypeKind.Entity end
        out TypeKind.Void
    end
    if node.node_type == AstType.MethodCall and fat_str_len(node.name2) > 0 do
        owner_ast = pass6_find_entity_ast(symbols, scopes, node.name2)
        if owner_ast != 0 do
            owner_children = vec_len_rt(owner_ast.children)
            var owner_i = 0
            when owner_i < owner_children loop
                owner_child = vec_get_rt(owner_ast.children, owner_i)
                if node.builtin_id == 201 and owner_child.node_type == AstType.FuncDef and fat_str_eq(owner_child.name, node.name) == 1 do
                    method_ret_kind = pass6_resolve_ffi_type(owner_child.name2)
                    if method_ret_kind != TypeKind.Void do out method_ret_kind end
                    if pass6_find_entity_ast(symbols, scopes, owner_child.name2) != 0 do out TypeKind.Entity end
                    out TypeKind.Void
                end
                if node.builtin_id == 202 and (owner_child.node_type == AstType.Identifier or owner_child.node_type == AstType.VarDecl) and fat_str_eq(owner_child.name, node.name) == 1 do
                    callable_ret_name = pass6_callable_return_type(owner_child.name2)
                    callable_ret_kind = pass6_resolve_ffi_type(callable_ret_name)
                    if callable_ret_kind != TypeKind.Void do out callable_ret_kind end
                    if pass6_find_entity_ast(symbols, scopes, callable_ret_name) != 0 do out TypeKind.Entity end
                    out TypeKind.Void
                end
                owner_i = owner_i + 1
            end
        end
    end
    out pass6_infer_type(symbols, scopes, node)
end.

func pass6_unwrap_type_name(name: &string):
    var tlen = fat_str_len(name)
    if tlen == 0 do out name end
    if tlen >= 5 and fat_str_byte_at(name, 0) == 38 and fat_str_byte_at(name, 1) == 109 and fat_str_byte_at(name, 2) == 117 and fat_str_byte_at(name, 3) == 116 and fat_str_byte_at(name, 4) == 32 do
        out fat_str_slice(name, 5, tlen - 5)
    end
    if tlen >= 4 and fat_str_byte_at(name, 0) == 38 and fat_str_byte_at(name, 1) == 109 and fat_str_byte_at(name, 2) == 117 and fat_str_byte_at(name, 3) == 116 do
        out fat_str_slice(name, 4, tlen - 4)
    end
    if tlen >= 4 and fat_str_byte_at(name, 0) == 114 and fat_str_byte_at(name, 1) == 101 and fat_str_byte_at(name, 2) == 102 and fat_str_byte_at(name, 3) == 32 do
        out fat_str_slice(name, 4, tlen - 4)
    end
    if tlen >= 4 and fat_str_byte_at(name, 0) == 109 and fat_str_byte_at(name, 1) == 117 and fat_str_byte_at(name, 2) == 116 and fat_str_byte_at(name, 3) == 32 do
        out fat_str_slice(name, 4, tlen - 4)
    end
    if tlen >= 2 and fat_str_byte_at(name, 0) == 38 and fat_str_byte_at(name, 1) == 32 do
        out fat_str_slice(name, 2, tlen - 2)
    end
    if tlen >= 1 and fat_str_byte_at(name, 0) == 38 do
        out fat_str_slice(name, 1, tlen - 1)
    end
    out name
end.

func pass6_resolve_ffi_type(name: &string):
    let resolved_name = pass6_unwrap_type_name(name)
    let nlen = fat_str_len(resolved_name)
    if nlen == 0 do out TypeKind.Void end
    if nlen >= 2 and fat_str_byte_at(resolved_name, 0) == 91 and fat_str_byte_at(resolved_name, nlen - 1) == 93 do
        out TypeKind.Array
    end
    if fat_cstr_eq(resolved_name, "int") == 1 or fat_cstr_eq(resolved_name, "i8") == 1 or fat_cstr_eq(resolved_name, "i16") == 1 or fat_cstr_eq(resolved_name, "i32") == 1 or fat_cstr_eq(resolved_name, "i64") == 1 or fat_cstr_eq(resolved_name, "uint") == 1 or fat_cstr_eq(resolved_name, "u8") == 1 or fat_cstr_eq(resolved_name, "u16") == 1 or fat_cstr_eq(resolved_name, "u32") == 1 or fat_cstr_eq(resolved_name, "u64") == 1 do out TypeKind.Int end
    if fat_cstr_eq(resolved_name, "float") == 1 or fat_cstr_eq(resolved_name, "f32") == 1 or fat_cstr_eq(resolved_name, "f64") == 1 do out TypeKind.Float end
    if fat_cstr_eq(resolved_name, "bool") == 1 do out TypeKind.Bool end
    if fat_cstr_eq(resolved_name, "string") == 1 do out TypeKind.String end
    if fat_cstr_eq(resolved_name, "ptr") == 1 do out TypeKind.Pointer end
    if fat_cstr_eq(resolved_name, "none") == 1 or fat_cstr_eq(resolved_name, "void") == 1 do out TypeKind.None end
    out TypeKind.Void
end.

func pass6_is_integer_like(k: i64):
    if k == TypeKind.Int as i64 or k == TypeKind.Enum as i64 do
        out 1
    end
    out 0
end.

func pass6_check_compatibility(declared: i64, actual: TypeKind) -> TypeCompatKind:
    if declared == 0 or actual == TypeKind.Void do
        out TypeCompatKind.Incompatible
    end
    if declared == actual as i64 do
        out TypeCompatKind.Exact
    end
    if pass6_is_integer_like(declared as TypeKind as i64) == 1 and pass6_is_integer_like(actual as i64) == 1 do
        out TypeCompatKind.AllowedConversion
    end
    if (declared == TypeKind.Pointer as i64 and pass6_is_integer_like(actual as i64) == 1) or (pass6_is_integer_like(declared as i64) == 1 and actual == TypeKind.Pointer) do
        out TypeCompatKind.AllowedConversion
    end
    # Numeric widening: integer literals and values can be assigned to float variables.
    if declared == TypeKind.Float as i64 and pass6_is_integer_like(actual as i64) == 1 do
        out TypeCompatKind.AllowedConversion
    end
    out TypeCompatKind.Incompatible
end.

func pass6_types_compatible(declared: i64, actual: TypeKind):
    let res = pass6_check_compatibility(declared, actual)
    if res == TypeCompatKind.Exact or res == TypeCompatKind.AllowedConversion do
        out 1
    end
    out 0
end.

func pass6_ufcs_types_compatible(declared: i64, actual: TypeKind):
    if actual == TypeKind.Void or actual == TypeKind.None do
        out 0
    end
    if declared == actual as i64 do
        out 1
    end
    if declared == 0 do
        out 1
    end
    let dec_is_int = (declared == TypeKind.Int as i64 or declared == TypeKind.Enum as i64)
    let act_is_int = (actual == TypeKind.Int or actual == TypeKind.Enum)
    if dec_is_int and act_is_int do
        out 1
    end
    if declared == TypeKind.Bool as i64 and act_is_int do
        out 1
    end
    if actual == TypeKind.Bool and dec_is_int do
        out 1
    end
    if declared == TypeKind.Pointer as i64 and actual == TypeKind.Pointer do
        out 1
    end
    out 0
end.

# Ordinary Vir calls retain the compiler's pointer-sized compatibility rules,
# but bool is not silently accepted for a declared numeric parameter (or the
# reverse).  This keeps annotated `in` parameters meaningful without breaking
# self-hosted code that represents strings/entities/addresses as `int`.
func pass6_param_types_compatible(declared: i64, actual: i64):
    if declared == TypeKind.Int as i64 and actual == TypeKind.Bool as i64 do out 0 end
    if declared == TypeKind.Bool as i64 and actual == TypeKind.Int as i64 do out 0 end
    out pass6_types_compatible(declared, actual as TypeKind)
end.

func pass6_is_lowlevel_call_or_param(call_name: &string, param_name: &string):
    if fat_str_len(call_name) >= 3 do
        if fat_str_byte_at(call_name, 0) == 114 and fat_str_byte_at(call_name, 1) == 116 and fat_str_byte_at(call_name, 2) == 95 do # rt_
            out 1
        end
        if fat_str_byte_at(call_name, 0) == 115 and fat_str_byte_at(call_name, 1) == 98 and fat_str_byte_at(call_name, 2) == 95 do # sb_
            out 1
        end
    end
    if fat_str_len(call_name) >= 4 do
        if fat_str_byte_at(call_name, 0) == 115 and fat_str_byte_at(call_name, 1) == 121 and fat_str_byte_at(call_name, 2) == 115 and fat_str_byte_at(call_name, 3) == 95 do # sys_
            out 1
        end
        if fat_str_byte_at(call_name, 0) == 102 and fat_str_byte_at(call_name, 1) == 97 and fat_str_byte_at(call_name, 2) == 116 and fat_str_byte_at(call_name, 3) == 95 do # fat_
            out 1
        end
        if fat_str_byte_at(call_name, 0) == 105 and fat_str_byte_at(call_name, 1) == 110 and fat_str_byte_at(call_name, 2) == 99 and fat_str_byte_at(call_name, 3) == 95 do # inc_
            out 1
        end
        if fat_str_byte_at(call_name, 0) == 109 and fat_str_byte_at(call_name, 1) == 105 and fat_str_byte_at(call_name, 2) == 114 and fat_str_byte_at(call_name, 3) == 95 do # mir_
            out 1
        end
        if fat_str_byte_at(call_name, 0) == 108 and fat_str_byte_at(call_name, 1) == 105 and fat_str_byte_at(call_name, 2) == 114 and fat_str_byte_at(call_name, 3) == 95 do # lir_
            out 1
        end
        if fat_str_byte_at(call_name, 0) == 118 and fat_str_byte_at(call_name, 1) == 101 and fat_str_byte_at(call_name, 2) == 99 and fat_str_byte_at(call_name, 3) == 95 do # vec_
            out 1
        end
    end
    if fat_str_len(call_name) >= 5 do
        if fat_str_byte_at(call_name, 0) == 98 and fat_str_byte_at(call_name, 1) == 118 and fat_str_byte_at(call_name, 2) == 101 and fat_str_byte_at(call_name, 3) == 99 and fat_str_byte_at(call_name, 4) == 95 do # bvec_
            out 1
        end
        if fat_str_byte_at(call_name, 0) == 101 and fat_str_byte_at(call_name, 1) == 109 and fat_str_byte_at(call_name, 2) == 105 and fat_str_byte_at(call_name, 3) == 116 and fat_str_byte_at(call_name, 4) == 95 do # emit_
            out 1
        end
    end
    if fat_str_len(call_name) >= 6 do
        if fat_str_byte_at(call_name, 0) == 112 and fat_str_byte_at(call_name, 1) == 97 and fat_str_byte_at(call_name, 2) == 115 and fat_str_byte_at(call_name, 3) == 115 and fat_str_byte_at(call_name, 4) == 54 and fat_str_byte_at(call_name, 5) == 95 do # pass6_
            out 1
        end
        if fat_str_byte_at(call_name, 0) == 112 and fat_str_byte_at(call_name, 1) == 97 and fat_str_byte_at(call_name, 2) == 115 and fat_str_byte_at(call_name, 3) == 115 and fat_str_byte_at(call_name, 4) == 56 and fat_str_byte_at(call_name, 5) == 95 do # pass8_
            out 1
        end
    end
    if fat_str_len(call_name) >= 7 do
        if fat_str_byte_at(call_name, 0) == 110 and fat_str_byte_at(call_name, 1) == 97 and fat_str_byte_at(call_name, 2) == 116 and fat_str_byte_at(call_name, 3) == 105 and fat_str_byte_at(call_name, 4) == 118 and fat_str_byte_at(call_name, 5) == 101 and fat_str_byte_at(call_name, 6) == 95 do # native_
            out 1
        end
        if fat_str_byte_at(call_name, 0) == 99 and fat_str_byte_at(call_name, 1) == 111 and fat_str_byte_at(call_name, 2) == 100 and fat_str_byte_at(call_name, 3) == 101 and fat_str_byte_at(call_name, 4) == 98 and fat_str_byte_at(call_name, 5) == 117 and fat_str_byte_at(call_name, 6) == 102 do # codebuf
            out 1
        end
    end
    if fat_cstr_eq(param_name, "buf") == 1 or fat_cstr_eq(param_name, "ptr") == 1 or fat_cstr_eq(param_name, "data") == 1 or fat_cstr_eq(param_name, "addr") == 1 do
        out 1
    end
    if fat_cstr_eq(param_name, "fat") == 1 or fat_cstr_eq(param_name, "cstr") == 1 or fat_cstr_eq(param_name, "str") == 1 or fat_cstr_eq(param_name, "s") == 1 do
        out 1
    end
    if fat_cstr_eq(param_name, "name") == 1 or fat_cstr_eq(param_name, "source") == 1 or fat_cstr_eq(param_name, "type_str") == 1 or fat_cstr_eq(param_name, "func_name") == 1 or fat_cstr_eq(param_name, "fname") == 1 or fat_cstr_eq(param_name, "lhs") == 1 do
        out 1
    end
    if fat_cstr_eq(param_name, "a") == 1 or fat_cstr_eq(param_name, "b") == 1 or fat_cstr_eq(param_name, "p") == 1 or fat_cstr_eq(param_name, "val") == 1 or fat_cstr_eq(param_name, "dst") == 1 or fat_cstr_eq(param_name, "src") == 1 or fat_cstr_eq(param_name, "src1") == 1 or fat_cstr_eq(param_name, "src2") == 1 or fat_cstr_eq(param_name, "opnd") == 1 or fat_cstr_eq(param_name, "ins") == 1 do
        out 1
    end
    out 0
end.

func pass6_call_arg_types_compatible(ref symbols: SymbolTable, ref scopes: ScopeTree, declared: i64, actual: TypeKind, arg: &AstNode, param_type_name: &string, param_name: &string, call_name: &string):
    let is_i64_ptr = fat_cstr_eq(param_type_name, "i64") == 1 or fat_cstr_eq(param_type_name, "u64") == 1 or fat_cstr_eq(param_type_name, "ptr") == 1 or fat_cstr_eq(param_type_name, "usize") == 1
    let is_lowlevel = pass6_is_lowlevel_call_or_param(call_name, param_name)

    if is_i64_ptr or is_lowlevel == 1 do
        if (declared == TypeKind.Int as i64 or declared == TypeKind.Pointer as i64) and (actual == TypeKind.Entity or actual == TypeKind.Pointer or actual == TypeKind.Ref or actual == TypeKind.MutRef or pass6_is_integer_like(actual as i64) == 1) do
            out 1
        end
        if declared == TypeKind.Entity as i64 and (actual == TypeKind.Pointer or pass6_is_integer_like(actual as i64) == 1) do
            out 1
        end
    end

    if declared == TypeKind.Int as i64 and actual == TypeKind.String do
        if is_i64_ptr or is_lowlevel == 1 do
            out 1
        end
        let is_user_int = fat_cstr_eq(param_type_name, "int") == 1 or fat_cstr_eq(param_type_name, "i32") == 1
        if is_user_int do
            if arg.node_type == AstType.LiteralStr or arg.node_type == AstType.FieldAccess or arg.node_type == AstType.MethodCall do
                out 0
            end
            if arg.node_type == AstType.Call do
                let c_fn = pass6_find_free_function(arg.name)
                if (c_fn as i64) != 0 do
                    if fat_cstr_eq(c_fn.name2, "string") == 1 do
                        out 0
                    end
                end
            end
        end
        out 1
    end

    if declared == TypeKind.String as i64 and actual == TypeKind.Int do
        if arg.node_type == AstType.LiteralInt do
            out 0
        end
        out 1
    end

    if pass6_param_types_compatible(declared, actual as i64) == 1 do out 1 end

    # In system/compiler modules (not user code), allow bool↔int for call args
    # to support the compiler's own internal helpers that use these interchangeably.
    # This must come BEFORE the identifier unannotated-local check which may early-exit.
    if is_user_module(g_pass6_cur_module) == 0 do
        if arg.node_type != AstType.LiteralBool and arg.node_type != AstType.LiteralInt do
            if (declared == TypeKind.Bool as i64 and pass6_is_integer_like(actual as i64) == 1) or (pass6_is_integer_like(declared) == 1 and actual == TypeKind.Bool) do
                out 1
            end
        end
    end

    # An unannotated local still carries the legacy integer storage kind.  Its
    # expression-derived bool value is valid for a bool parameter; only an
    # explicit annotation or literal makes this a strict int/bool mismatch.
    if arg.node_type == AstType.Identifier do
        let sid = pass6_lookup_chain(symbols, scopes, scope_current_id(scopes), arg.name)
        if sid != -1 do
            let sym = pass6_symbol_at(symbols, sid)
            if sym.ast_id == 0 do
                out pass6_types_compatible(declared, actual)
            else
                let decl = sym.ast_id as AstNode
                if fat_str_len(decl.name2) == 0 do out pass6_types_compatible(declared, actual) end
            end
        end
    end
    if arg.node_type == AstType.Call do
        let call_ast = pass6_find_free_function(arg.name)
        if (call_ast as i64) != 0 do
            if fat_str_len(call_ast.name2) == 0 do
                out 1
            end
        end
    end
    out 0
end.

func pass6_is_logic_bit_operand(k: TypeKind):
    if k == TypeKind.Bool do
        out 1
    end
    out pass6_is_integer_like(k)
end.

func pass6_name_in_vec(names: i64, name: &string):
    if names == 0 do out 0 end
    var i = 0
    when i < vec_len_rt(names) loop
        if fat_str_eq(vec_get_rt(names, i) as string, name) do out 1 end
        i = i + 1
    end
    out 0
end.

# Recover the declared tensor annotation through identifiers and quantize
# wrappers.  TypeKind alone intentionally does not erase element/shape data.
func pass6_tensor_type_name(ref symbols: SymbolTable, ref scopes: ScopeTree, node: &AstNode):
    if node.node_type == AstType.Identifier do
        found = pass6_lookup_chain(symbols, scopes, scope_current_id(scopes), node.name)
        if found != -1 do
            sym = pass6_symbol_at(symbols, found)
            if sym.ast_id != 0 do
                decl = sym.ast_id as AstNode
                if is_tensor_type_str(decl.name2) do out decl.name2 end
                if is_quantized_type_str(decl.name2 as int) do out decl.name2 end
                if vec_len_rt(decl.children) > 0 do
                    out pass6_tensor_type_name(symbols, scopes, vec_get_rt(decl.children, 0))
                end
            end
        end
        let vty = pass6_get_var_type(node.name)
        if is_tensor_type_str(vty) or is_quantized_type_str(vty as int) do
            out vty
        end
    eif node.node_type == AstType.QuantizeExpr do
        if is_quantized_type_str(node.name2 as int) do out node.name2 end
        if vec_len_rt(node.children) > 0 do
            out pass6_tensor_type_name(symbols, scopes, vec_get_rt(node.children, 0))
        end
    end
    out fat_str_new("")
end.

func pass6_collect_entities(node: &AstNode):
    if node as i64 == 0 do out 0 end
    if (node.node_type == AstType.EntityDef or node.node_type == AstType.PackedDef or node.node_type == AstType.RegisterDef) and fat_str_len(node.name) > 0 do
        g_pass6_entity_names = vec_push_rt(g_pass6_entity_names, node.name as i64)
        g_pass6_entity_nodes = vec_push_rt(g_pass6_entity_nodes, node as i64)
        if g_pass6_entity_buckets == 0 do
            g_pass6_entity_buckets = pass6_global_map_new()
        end
        let ebid = pass6_hash_name(node.name)
        var ebucket = vec_get_rt(g_pass6_entity_buckets, ebid)
        ebucket = vec_push_rt(ebucket, node as i64)
        vec_set_rt(g_pass6_entity_buckets, ebid, ebucket)
    eif node.node_type == AstType.EnumDef and fat_str_len(node.name) > 0 do
        let ebid = pass6_hash_name(node.name)
        var ebucket = vec_get_rt(g_pass6_enum_buckets, ebid)
        ebucket = vec_push_rt(ebucket, node as i64)
        vec_set_rt(g_pass6_enum_buckets, ebid, ebucket)
    end
    child_count = vec_len_rt(node.children)
    var i = 0
    when i < child_count loop
        pass6_collect_entities(vec_get_rt(node.children, i))
        i = i + 1
    end
    out 0
end.

func pass6_find_entity_ast(ref symbols: SymbolTable, ref scopes: ScopeTree, entity_name: &string):
    if fat_str_len(entity_name) == 0 do out 0 as AstNode end
    sid = pass6_lookup_chain(symbols, scopes, scope_current_id(scopes), entity_name)
    if sid != -1 do
        sym = pass6_symbol_at(symbols, sid)
        if sym.kind == SymbolKind.Entity and sym.ast_id != 0 do
            out sym.ast_id as AstNode
        end
    end
    if g_pass6_entity_buckets != 0 do
        let bid = pass6_hash_name(entity_name)
        let bucket = vec_get_rt(g_pass6_entity_buckets, bid)
        let count = vec_len_rt(bucket)
        var i = 0
        when i < count loop
            let cand = vec_get_rt(bucket, i) as AstNode
            if fat_str_eq(cand.name, entity_name) == 1 do
                out cand
            end
            i = i + 1
        end
    end
    out 0 as AstNode
end.

func pass6_entity_has_field(ref symbols: SymbolTable, ref scopes: ScopeTree, base_name: &string, field_name: &string):
    if fat_str_len(base_name) == 0 or fat_str_len(field_name) == 0 do out 0 end
    ent_ast = pass6_find_entity_ast(symbols, scopes, base_name)
    if (ent_ast as i64) != 0 do
        let n_ch = vec_len_rt(ent_ast.children)
        var fi = 0
        when fi < n_ch loop
            fch = vec_get_rt(ent_ast.children, fi) as AstNode
            if fat_str_eq(fch.name, field_name) == 1 do
                out 1
            end
            fi = fi + 1
        end
    end
    out 0
end.

func pass6_find_best_entity_ast(ref symbols: SymbolTable, ref scopes: ScopeTree, lit: &AstNode):
    if fat_str_len(lit.name) == 0 do out 0 as AstNode end
    out pass6_find_entity_ast(symbols, scopes, lit.name)
end.

func pass6_is_valid_packed_primitive(name: &string):
    if fat_cstr_eq(name, "u8") == 1 or fat_cstr_eq(name, "i8") == 1 or fat_cstr_eq(name, "bool") == 1 do out 1 end
    if fat_cstr_eq(name, "u16") == 1 or fat_cstr_eq(name, "i16") == 1 do out 1 end
    if fat_cstr_eq(name, "u32") == 1 or fat_cstr_eq(name, "i32") == 1 do out 1 end
    if fat_cstr_eq(name, "u64") == 1 or fat_cstr_eq(name, "i64") == 1 or fat_cstr_eq(name, "int") == 1 or fat_cstr_eq(name, "uint") == 1 do out 1 end
    if fat_cstr_eq(name, "ptr") == 1 or fat_cstr_eq(name, "float") == 1 or fat_cstr_eq(name, "f32") == 1 or fat_cstr_eq(name, "f64") == 1 do out 1 end
    out 0
end.

func pass6_register_base_bits(name: &string):
    if fat_cstr_eq(name, "u8") == 1 or fat_cstr_eq(name, "i8") == 1 do out 8 end
    if fat_cstr_eq(name, "u16") == 1 or fat_cstr_eq(name, "i16") == 1 do out 16 end
    if fat_cstr_eq(name, "u32") == 1 or fat_cstr_eq(name, "i32") == 1 do out 32 end
    if fat_cstr_eq(name, "u64") == 1 or fat_cstr_eq(name, "i64") == 1 or fat_cstr_eq(name, "int") == 1 or fat_cstr_eq(name, "uint") == 1 do out 64 end
    out 0
end.

func pass6_packed_has_cycle(ref symbols: SymbolTable, ref scopes: ScopeTree, current_name: &string, active_stack: i64):
    var i = 0
    let n = vec_len_rt(active_stack)
    when i < n loop
        let item = vec_get_rt(active_stack, i) as string
        if fat_str_eq(item, current_name) == 1 do
            out 1
        end
        i = i + 1
    end
    ent = pass6_find_entity_ast(symbols, scopes, current_name)
    if (ent as i64) == 0 do out 0 end
    if ent.node_type != AstType.PackedDef do out 0 end
    let next_stack = vec_push_rt(active_stack, current_name as i64)
    var k = 0
    var nk = vec_len_rt(ent.children)
    when k < nk loop
        f_k = vec_get_rt(ent.children, k) as AstNode
        if f_k.node_type != AstType.FuncDef do
            fk_ty = f_k.name2
            if pass6_is_valid_packed_primitive(fk_ty) == 0 do
                if pass6_packed_has_cycle(symbols, scopes, fk_ty, next_stack) == 1 do
                    out 1
                end
            end
        end
        k = k + 1
    end
    out 0
end.

func pass6_check_packed_def(ref symbols: SymbolTable, ref scopes: ScopeTree, diag: &DiagnosticEngine, node: &AstNode):
    n_ch = vec_len_rt(node.children)
    var seen_flds = pass6_global_map_new()
    var i = 0
    when i < n_ch loop
        fld = vec_get_rt(node.children, i) as AstNode
        if fld.node_type != AstType.FuncDef do
            if fat_str_len(fld.name2) == 0 do
                report_error(diag, 3025, fld.line, 0)
            else
                let fbid = pass6_hash_name(fld.name)
                var fbucket = vec_get_rt(seen_flds, fbid)
                let fblen = vec_len_rt(fbucket)
                var has_dup = false
                var fi = 0
                when fi < fblen loop
                    if fat_str_eq(vec_get_rt(fbucket, fi) as string, fld.name) == 1 do
                        has_dup = true
                        fi = fblen
                    else
                        fi = fi + 1
                    end
                end
                if has_dup do
                    report_error(diag, 2004, fld.line, 0)
                else
                    fbucket = vec_push_rt(fbucket, fld.name as i64)
                    vec_set_rt(seen_flds, fbid, fbucket)
                end
                fty = fld.name2
                if pass6_is_valid_packed_primitive(fty) == 0 do
                    if fat_cstr_eq(fty, "string") == 1 or fat_cstr_eq(fty, "array") == 1 or fat_cstr_eq(fty, "dict") == 1 or is_tensor_type_str(fty) do
                        report_error(diag, 3026, fld.line, 0)
                    else
                        target_ast = pass6_find_entity_ast(symbols, scopes, fty)
                        if (target_ast as i64) == 0 do
                            report_error(diag, 3026, fld.line, 0)
                        eif target_ast.node_type == AstType.EntityDef do
                            report_error(diag, 3028, fld.line, 0)
                        eif target_ast.node_type == AstType.PackedDef do
                            var active_s = vec_new_rt()
                            active_s = vec_push_rt(active_s, node.name as i64)
                            if pass6_packed_has_cycle(symbols, scopes, fty, active_s) == 1 do
                                report_error(diag, 3027, fld.line, 0)
                            end
                        end
                    end
                end
            end
        end
        i = i + 1
    end
    out 0
end.

func pass6_check_packed_literal(ref symbols: SymbolTable, ref scopes: ScopeTree, diag: &DiagnosticEngine, lit: &AstNode):
    if fat_str_len(lit.name) == 0 do out 0 end
    ent_ast = pass6_find_best_entity_ast(symbols, scopes, lit)
    if (ent_ast as i64) == 0 do out 0 end
    if ent_ast.node_type != AstType.PackedDef and ent_ast.node_type != AstType.EntityDef do out 0 end

    n_fields = vec_len_rt(ent_ast.children)
    n_args = vec_len_rt(lit.children)

    exp_names = vec_new_rt()
    field_buckets = pass6_global_map_new()
    var fi = 0
    when fi < n_fields loop
        f_node = vec_get_rt(ent_ast.children, fi) as AstNode
        if f_node.node_type != AstType.FuncDef do
            exp_names = vec_push_rt(exp_names, f_node.name as i64)
            let fbid = pass6_hash_name(f_node.name)
            var fbucket = vec_get_rt(field_buckets, fbid)
            fbucket = vec_push_rt(fbucket, f_node.name as i64)
            fbucket = vec_push_rt(fbucket, f_node.name2 as i64)
            vec_set_rt(field_buckets, fbid, fbucket)
        end
        fi = fi + 1
    end
    n_exp = vec_len_rt(exp_names)

    var seen_args = pass6_global_map_new()
    var ai = 0
    when ai < n_args loop
        arg = vec_get_rt(lit.children, ai) as AstNode
        aname = arg.name2
        let abid = pass6_hash_name(aname)
        var abucket = vec_get_rt(seen_args, abid)
        let ablen = vec_len_rt(abucket)
        var has_dup_arg = false
        var pi = 0
        when pi < ablen loop
            if fat_str_eq(vec_get_rt(abucket, pi) as string, aname) == 1 do
                has_dup_arg = true
                pi = ablen
            else
                pi = pi + 1
            end
        end
        if has_dup_arg do
            report_error(diag, 3010, lit.line, 0)
        else
            abucket = vec_push_rt(abucket, aname as i64)
            vec_set_rt(seen_args, abid, abucket)
        end
        let field_bid = pass6_hash_name(aname)
        let field_bucket = vec_get_rt(field_buckets, field_bid)
        let field_bucket_len = vec_len_rt(field_bucket)
        var ftype = fat_str_new("")
        var matched_field = false
        var k = 0
        when k < field_bucket_len loop
            if fat_str_eq(vec_get_rt(field_bucket, k) as string, aname) == 1 do
                ftype = vec_get_rt(field_bucket, k + 1) as string
                matched_field = true
                k = field_bucket_len
            else
                k = k + 2
            end
        end
        if not matched_field do
            report_error_loc(diag, 3008, 0, lit.line, 1, aname as string)
        else
            var arg_type = pass6_infer_type(symbols, scopes, arg)
            var f_ent = pass6_find_entity_ast(symbols, scopes, pass6_extract_base_name(ftype))
            if (f_ent as i64) != 0 do
                if arg.node_type == AstType.ArrayLiteral do
                    report_error(diag, 3011, arg.line, 0)
                eif arg.node_type == AstType.LiteralStr or (arg.node_type == AstType.LiteralInt and arg.int_val != 0) or arg.node_type == AstType.LiteralBool or arg.node_type == AstType.DictLiteral or arg.node_type == AstType.TupleExpr do
                    report_error(diag, 3011, arg.line, 0)
                eif arg.node_type == AstType.LiteralInt and arg.int_val == 0 do
                    # 0 is null pointer/entity reference
                else
                    var arg_ent_name = pass6_get_expr_type_str(symbols, scopes, arg)
                    if fat_str_len(arg_ent_name) > 0 do
                        if pass6_is_array_type_str(arg_ent_name) do
                            report_error(diag, 3011, arg.line, 0)
                        else
                            var a_ent_ast = pass6_find_entity_ast(symbols, scopes, pass6_extract_base_name(arg_ent_name))
                            if (a_ent_ast as i64) != 0 do
                                if pass6_type_strings_compatible(symbols, scopes, ftype, arg_ent_name) == 0 do
                                    report_error(diag, 3011, arg.line, 0)
                                end
                            end
                        end
                    end
                end
            eif pass6_is_array_type_str(ftype) do
                if arg.node_type == AstType.EntityLiteral do
                    report_error(diag, 3011, arg.line, 0)
                eif arg.node_type == AstType.LiteralStr or arg.node_type == AstType.LiteralInt or arg.node_type == AstType.LiteralBool or arg.node_type == AstType.DictLiteral or arg.node_type == AstType.TupleExpr do
                    report_error(diag, 3011, arg.line, 0)
                else
                    var arg_arr_str = pass6_get_expr_type_str(symbols, scopes, arg)
                    if fat_str_len(arg_arr_str) > 0 do
                        var a_ent_ast2 = pass6_find_entity_ast(symbols, scopes, pass6_extract_base_name(arg_arr_str))
                        if (a_ent_ast2 as i64) != 0 do
                            report_error(diag, 3011, arg.line, 0)
                        eif pass6_type_strings_compatible(symbols, scopes, ftype, arg_arr_str) == 0 do
                            report_error(diag, 3011, arg.line, 0)
                        end
                    end
                end
            else
                var dec_type = pass6_resolve_ffi_type(ftype)
                if dec_type != TypeKind.Void and dec_type != TypeKind.None and arg_type != TypeKind.Void do
                    var is_str_int_handle = ((dec_type == TypeKind.Int and arg_type == TypeKind.String) or (dec_type == TypeKind.String and arg_type == TypeKind.Int)) and (arg.node_type != AstType.LiteralStr and arg.node_type != AstType.LiteralInt)
                    if not is_str_int_handle and pass6_types_compatible(dec_type as i64, arg_type) == 0 do
                        report_error(diag, 3011, arg.line, 0)
                    end
                end
            end
            var int_val = 0
            var has_int = false
            if arg.node_type == AstType.LiteralInt do
                int_val = arg.int_val
                has_int = true
            eif arg.node_type == AstType.UnaryMinus and vec_len_rt(arg.children) > 0 do
                child0 = vec_get_rt(arg.children, 0) as AstNode
                if child0.node_type == AstType.LiteralInt do
                    int_val = 0 - child0.int_val
                    has_int = true
                end
            end
            if has_int do
                if fat_cstr_eq(ftype, "u8") == 1 do
                    if int_val < 0 or int_val > 255 do
                        report_error(diag, 3030, arg.line, 0)
                    end
                eif fat_cstr_eq(ftype, "i8") == 1 do
                    if int_val < (0 - 128) or int_val > 127 do
                        report_error(diag, 3030, arg.line, 0)
                    end
                eif fat_cstr_eq(ftype, "u16") == 1 do
                    if int_val < 0 or int_val > 65535 do
                        report_error(diag, 3030, arg.line, 0)
                    end
                eif fat_cstr_eq(ftype, "i16") == 1 do
                    if int_val < (0 - 32768) or int_val > 32767 do
                        report_error(diag, 3030, arg.line, 0)
                    end
                eif fat_cstr_eq(ftype, "u32") == 1 do
                    if int_val < 0 or int_val > 4294967295 do
                        report_error(diag, 3030, arg.line, 0)
                    end
                eif fat_cstr_eq(ftype, "i32") == 1 do
                    if int_val < (0 - 2147483648) or int_val > 2147483647 do
                        report_error(diag, 3030, arg.line, 0)
                    end
                end
            end
        end
        ai = ai + 1
    end

    var ei = 0
    when ei < n_exp loop
        exp_name = vec_get_rt(exp_names, ei) as string
        let ebid = pass6_hash_name(exp_name)
        let ebucket = vec_get_rt(seen_args, ebid)
        let eblen = vec_len_rt(ebucket)
        var found = false
        var chk_i = 0
        when chk_i < eblen loop
            if fat_str_eq(vec_get_rt(ebucket, chk_i) as string, exp_name) == 1 do
                found = true
                chk_i = eblen
            else
                chk_i = chk_i + 1
            end
        end
        if not found do
            report_error(diag, 3029, lit.line, 0)
        end
        ei = ei + 1
    end
    out 0
end.

func pass6_set_sym_type(sym_id: int, type_name: &string):
    if sym_id < 0 or fat_str_len(type_name) == 0 do out 0 end
    if g_pass6_sym_types == 0 do
        g_pass6_sym_types = vec_new_rt()
    end
    let cur_len = vec_len_rt(g_pass6_sym_types)
    var i = cur_len
    when i <= sym_id loop
        g_pass6_sym_types = vec_push_rt(g_pass6_sym_types, 0)
        i = i + 1
    end
    vec_set_rt(g_pass6_sym_types, sym_id, type_name as i64)
    out 0
end.

func pass6_get_sym_type(sym_id: int) -> string:
    if sym_id < 0 or g_pass6_sym_types == 0 do out fat_str_new("") end
    if sym_id >= vec_len_rt(g_pass6_sym_types) do out fat_str_new("") end
    let val = vec_get_rt(g_pass6_sym_types, sym_id)
    if val == 0 do out fat_str_new("") end
    out val as string
end.

func pass6_scope_enter():
    if g_pass6_scope_watermarks == 0 do
        g_pass6_scope_watermarks = vec_new_rt()
    end
    var w = 0
    if g_pass6_scoped_var_names != 0 do
        w = vec_len_rt(g_pass6_scoped_var_names)
    end
    g_pass6_scope_watermarks = vec_push_rt(g_pass6_scope_watermarks, w)
    out 0
end.

func pass6_scope_exit():
    if g_pass6_scope_watermarks != 0 do
        if vec_len_rt(g_pass6_scope_watermarks) > 0 do
            let cur_w_idx = vec_len_rt(g_pass6_scope_watermarks) - 1
            let w = vec_get_rt(g_pass6_scope_watermarks, cur_w_idx) as int
            native_write_i64(g_pass6_scope_watermarks - 8, 0, cur_w_idx)
            if g_pass6_scoped_var_names != 0 do
                let cur_n = vec_len_rt(g_pass6_scoped_var_names)
                if cur_n > w do
                    native_write_i64(g_pass6_scoped_var_names - 8, 0, w)
                    native_write_i64(g_pass6_scoped_var_types - 8, 0, w)
                end
            end
        end
    end
    out 0
end.

func pass6_get_scoped_name_type(name: &string) -> string:
    if g_pass6_scoped_var_names == 0 or fat_str_len(name) == 0 do out fat_str_new("") end
    let n = vec_len_rt(g_pass6_scoped_var_names)
    var i = n - 1
    when i >= 0 loop
        let vn = vec_get_rt(g_pass6_scoped_var_names, i) as string
        if fat_str_eq(vn, name) == 1 do
            out vec_get_rt(g_pass6_scoped_var_types, i) as string
        end
        i = i - 1
    end
    out fat_str_new("")
end.

func pass6_set_scoped_name_type(name: &string, type_name: &string):
    if fat_str_len(name) == 0 or fat_str_len(type_name) == 0 do out 0 end
    if g_pass6_scoped_var_names == 0 do
        g_pass6_scoped_var_names = vec_new_rt()
        g_pass6_scoped_var_types = vec_new_rt()
    end
    g_pass6_scoped_var_names = vec_push_rt(g_pass6_scoped_var_names, name as i64)
    g_pass6_scoped_var_types = vec_push_rt(g_pass6_scoped_var_types, type_name as i64)
    out 0
end.

func pass6_set_var_type(name: &string, type_name: &string):
    if fat_str_len(name) == 0 or fat_str_len(type_name) == 0 do out 0 end
    pass6_set_scoped_name_type(name, type_name)
    out 0
end.

func pass6_get_var_type(name: &string):
    if fat_str_len(name) == 0 do out fat_str_new("") end
    out pass6_get_scoped_name_type(name)
end.

func pass6_dict_key_expr_type(ref symbols: SymbolTable, ref scopes: ScopeTree, node: &AstNode):
    if node == 0 do out TypeKind.Void end
    if node.node_type == AstType.Identifier and fat_cstr_eq(pass6_get_var_type(node.name), "string") == 1 do
        out TypeKind.String
    end
    out pass6_infer_type(symbols, scopes, node)
end.

func pass6_dict_literal_key_type(ref symbols: SymbolTable, ref scopes: ScopeTree, lit: &AstNode):
    if lit == 0 or lit.node_type != AstType.DictLiteral or vec_len_rt(lit.children) < 2 do
        out TypeKind.Void
    end
    out pass6_dict_key_expr_type(symbols, scopes, vec_get_rt(lit.children, 0) as AstNode)
end.

func pass6_dict_var_key_type(ref symbols: SymbolTable, ref scopes: ScopeTree, name: &string):
    found = pass6_lookup_chain(symbols, scopes, scope_current_id(scopes), name)
    if found < 0 do out TypeKind.Void end
    sym = pass6_symbol_at(symbols, found)
    if sym.ast_id == 0 do out TypeKind.Void end
    decl = sym.ast_id as AstNode
    if vec_len_rt(decl.children) == 0 do out TypeKind.Void end
    initializer = vec_get_rt(decl.children, 0) as AstNode
    out pass6_dict_literal_key_type(symbols, scopes, initializer)
end.

func pass6_dict_literal_value_type(ref symbols: SymbolTable, ref scopes: ScopeTree, lit: &AstNode):
    if lit == 0 or lit.node_type != AstType.DictLiteral or vec_len_rt(lit.children) < 2 do
        out TypeKind.Void
    end
    var first_type = pass6_infer_type(symbols, scopes, vec_get_rt(lit.children, 1) as AstNode)
    let n = vec_len_rt(lit.children)
    var i = 3
    when i < n loop
        var v_type = pass6_infer_type(symbols, scopes, vec_get_rt(lit.children, i) as AstNode)
        if v_type != first_type do
            out TypeKind.Void
        end
        i = i + 2
    end
    out first_type
end.

func pass6_dict_var_value_type(ref symbols: SymbolTable, ref scopes: ScopeTree, name: &string):
    found = pass6_lookup_chain(symbols, scopes, scope_current_id(scopes), name)
    if found < 0 do out TypeKind.Void end
    sym = pass6_symbol_at(symbols, found)
    if sym.ast_id == 0 do out TypeKind.Void end
    decl = sym.ast_id as AstNode
    if vec_len_rt(decl.children) == 0 do out TypeKind.Void end
    initializer = vec_get_rt(decl.children, 0) as AstNode
    out pass6_dict_literal_value_type(symbols, scopes, initializer)
end.

func pass6_array_var_elem_type(ref symbols: SymbolTable, ref scopes: ScopeTree, name: &string):
    found = pass6_lookup_chain(symbols, scopes, scope_current_id(scopes), name)
    if found < 0 do out TypeKind.Void end
    sym = pass6_symbol_at(symbols, found)
    if sym.ast_id == 0 do out TypeKind.Void end
    decl = sym.ast_id as AstNode
    if vec_len_rt(decl.children) == 0 do out TypeKind.Void end
    initializer = vec_get_rt(decl.children, 0) as AstNode
    if (initializer as i64) != 0 do
        if initializer.node_type == AstType.ArrayLiteral do
            if vec_len_rt(initializer.children) > 0 do
                out pass6_infer_type(symbols, scopes, vec_get_rt(initializer.children, 0) as AstNode)
            end
        end
    end
    out TypeKind.Void
end.

func pass6_count_callable_params(type_str: &string):
    slen = fat_str_len(type_str)
    if slen <= 0 do out 0 - 1 end
    var lparen = 0 - 1
    var rparen = 0 - 1
    var i = 0
    when i < slen loop
        b = fat_str_byte_at(type_str, i)
        if b == 40 and lparen < 0 do
            lparen = i
        eif b == 41 and rparen < 0 do
            rparen = i
            i = slen
        end
        i = i + 1
    end
    if lparen < 0 or rparen < 0 or rparen <= lparen do
        out 0 - 1
    end
    var has_content = 0
    var commas = 0
    var j = lparen + 1
    when j < rparen loop
        cb = fat_str_byte_at(type_str, j)
        if cb != 32 and cb != 9 and cb != 10 and cb != 13 do
            has_content = 1
        end
        if cb == 44 do
            commas = commas + 1
        end
        j = j + 1
    end
    if has_content == 0 do
        out 0
    end
    out commas + 1
end.

func pass6_callable_param_type(type_str: &string, wanted: int):
    slen = fat_str_len(type_str)
    var lparen = 0 - 1
    var i = 0
    when i < slen loop
        if fat_str_byte_at(type_str, i) == 40 do
            lparen = i
            i = slen
        else
            i = i + 1
        end
    end
    if lparen < 0 do out fat_str_new("") end

    var current = 0
    var start = lparen + 1
    var pos = start
    when pos < slen loop
        ch = fat_str_byte_at(type_str, pos)
        if ch == 44 or ch == 41 do
            if current == wanted do
                var trim_start = start
                var trim_end = pos
                when trim_start < trim_end & (fat_str_byte_at(type_str, trim_start) == 32 || fat_str_byte_at(type_str, trim_start) == 9) loop
                    trim_start = trim_start + 1
                end
                when trim_end > trim_start & (fat_str_byte_at(type_str, trim_end - 1) == 32 || fat_str_byte_at(type_str, trim_end - 1) == 9) loop
                    trim_end = trim_end - 1
                end
                out fat_str_slice(type_str as i64, trim_start, trim_end - trim_start) as string
            end
            if ch == 41 do out fat_str_new("") end
            current = current + 1
            start = pos + 1
        end
        pos = pos + 1
    end
    out fat_str_new("")
end.

func pass6_callable_return_type(type_str: &string):
    slen = fat_str_len(type_str)
    var pos = 0
    when pos < slen and fat_str_byte_at(type_str, pos) != 41 loop
        pos = pos + 1
    end
    if pos >= slen do out fat_str_new("") end
    pos = pos + 1
    when pos < slen and (fat_str_byte_at(type_str, pos) == 32 or fat_str_byte_at(type_str, pos) == 9) loop
        pos = pos + 1
    end
    # The self-host token spelling currently compacts `func(int) -> Box` as
    # `func(int)Box`; accept an explicit arrow too for parser compatibility.
    if pos + 1 < slen and fat_str_byte_at(type_str, pos) == 45 and fat_str_byte_at(type_str, pos + 1) == 62 do
        pos = pos + 2
    end
    when pos < slen and (fat_str_byte_at(type_str, pos) == 32 or fat_str_byte_at(type_str, pos) == 9) loop
        pos = pos + 1
    end
    if pos >= slen do out fat_str_new("") end
    out fat_str_slice(type_str as i64, pos, slen - pos) as string
end.

func pass6_get_receiver_entity_name(ref symbols: SymbolTable, ref scopes: ScopeTree, recv: &AstNode):
    if recv == 0 do out fat_str_new("") end
    nt = recv.node_type
    if nt == AstType.AddrOf and vec_len_rt(recv.children) > 0 do
        out pass6_get_receiver_entity_name(symbols, scopes, vec_get_rt(recv.children, 0) as AstNode)
    end
    if nt == AstType.Identifier do
        if fat_cstr_eq(recv.name, "this") == 1 do
            if g_pass6_current_entity_name != 0 do
                out g_pass6_current_entity_name as string
            end
        end
        sid = pass6_lookup_chain(symbols, scopes, scope_current_id(scopes), recv.name)
        if sid != -1 do
            sym = pass6_symbol_at(symbols, sid)
            if sym.ast_id != 0 do
                decl = sym.ast_id as AstNode
                if decl.node_type == AstType.VarDecl or decl.node_type == AstType.ConstDecl do
                    if fat_str_len(decl.name2) > 0 do
                        out pass6_unwrap_type_name(decl.name2)
                    end
                    if vec_len_rt(decl.children) > 0 do
                        init = vec_get_rt(decl.children, 0)
                        if init.node_type == AstType.EntityLiteral do
                            out init.name
                        end
                        if init.node_type == AstType.Call do
                            ent_chk = pass6_find_entity_ast(symbols, scopes, init.name)
                            if ent_chk != 0 do out init.name end
                            init_ent = pass6_get_receiver_entity_name(symbols, scopes, init)
                            if fat_str_len(init_ent) > 0 do out init_ent end
                        end
                        if init.node_type == AstType.AddrOf and vec_len_rt(init.children) > 0 do
                            init_ent = pass6_get_receiver_entity_name(symbols, scopes, vec_get_rt(init.children, 0) as AstNode)
                            if fat_str_len(init_ent) > 0 do out init_ent end
                        end
                    end
                end
                if decl.node_type == AstType.ParamDef or decl.node_type == AstType.RefParam or decl.node_type == AstType.Identifier do
                    if fat_str_len(decl.name2) > 0 do out pass6_unwrap_type_name(decl.name2) end
                end
            end
        end
        vt = pass6_get_var_type(recv.name)
        if fat_str_len(vt) > 0 do out pass6_unwrap_type_name(vt) end
        ent_chk2 = pass6_find_entity_ast(symbols, scopes, recv.name)
        if ent_chk2 != 0 do out recv.name end
        out fat_str_new("")
    end
    if nt == AstType.EntityLiteral do
        if fat_str_len(recv.name2) > 0 do
            out fat_str_concat(recv.name, fat_str_concat(fat_str_new("<"), fat_str_concat(recv.name2, fat_str_new(">"))))
        end
        out recv.name
    end
    if nt == AstType.BuiltinCall & fat_cstr_eq(recv.name, "port") == 1 do
        out recv.name
    end
    if nt == AstType.Call do
        ent_chk3 = pass6_find_entity_ast(symbols, scopes, recv.name)
        if ent_chk3 != 0 do out recv.name end
        call_ast = pass6_find_free_function(recv.name)
        if call_ast != 0 do
            call_ret = call_ast.name2
            if fat_str_len(call_ret) > 0 do
                let unwrapped_ret = pass6_unwrap_type_name(call_ret)
                call_ret_ent = pass6_find_entity_ast(symbols, scopes, unwrapped_ret)
                if (call_ret_ent as i64) != 0 do out unwrapped_ret end
            else
                let ret_s = pass6_find_return_stmt(call_ast)
                if (ret_s as i64) != 0 do
                    if vec_len_rt(ret_s.children) > 0 do
                        let ret_val = vec_get_rt(ret_s.children, 0) as AstNode
                        if ret_val.node_type == AstType.EntityLiteral do
                            out ret_val.name
                        eif ret_val.node_type == AstType.Identifier do
                            let p_ent = pass6_find_param_entity(call_ast, ret_val.name)
                            if fat_str_len(p_ent) > 0 do out p_ent end
                        end
                    end
                end
            end
        end
        out fat_str_new("")
    end
    if nt == AstType.FieldAccess and vec_len_rt(recv.children) > 0 do
        base_node = vec_get_rt(recv.children, 0)
        if base_node.node_type == AstType.Identifier do
            chk_enum = pass6_find_enum_ast(symbols, scopes, base_node.name)
            if (chk_enum as i64) != 0 do
                out base_node.name
            end
        end
        base_ent = pass6_get_receiver_entity_name(symbols, scopes, base_node)
        if fat_str_len(base_ent) > 0 do
            base_raw = pass6_unwrap_type_name(base_ent)
            base_ast = pass6_find_entity_ast(symbols, scopes, base_raw)
            if base_ast != 0 do
                n_f = vec_len_rt(base_ast.children)
                var fi = 0
                when fi < n_f loop
                    fch = vec_get_rt(base_ast.children, fi)
                    if (fch.node_type == AstType.Identifier or fch.node_type == AstType.VarDecl) and fat_str_eq(fch.name, recv.name) == 1 do
                        out fch.name2
                    end
                    fi = fi + 1
                end
            end
        end
        out fat_str_new("")
    end
    if nt == AstType.MethodCall and vec_len_rt(recv.children) > 0 do
        # A resolved free-function UFCS call carries the free callee in `name`.
        # Preserve an entity return type so the next link in a chain can resolve
        # against that entity's method set (for example: 9.to_box().score()).
        if recv.builtin_id == 203 do
            free_call_ast = 0 as AstNode
            if fat_str_len(recv.name2) > 0 do
                free_call_ast = pass6_find_func_by_canonical_identity(recv.name2)
                if free_call_ast == 0 do
                    free_call_ast = pass6_find_free_function(recv.name2)
                end
            end
            if free_call_ast == 0 do
                free_call_ast = pass6_find_free_function(recv.name)
            end
            if free_call_ast != 0 do
                free_call_ret = free_call_ast.name2
                if fat_str_len(free_call_ret) > 0 do
                    let unwrapped_ret = pass6_unwrap_type_name(free_call_ret)
                    free_call_ret_ent = pass6_find_entity_ast(symbols, scopes, unwrapped_ret)
                    if (free_call_ret_ent as i64) != 0 do out unwrapped_ret end
                end
            end
        end
        m_recv = vec_get_rt(recv.children, 0)
        m_recv_ent = pass6_get_receiver_entity_name(symbols, scopes, m_recv)
        if recv.builtin_id == 202 and fat_str_len(m_recv_ent) > 0 do
            callable_owner = pass6_find_entity_ast(symbols, scopes, m_recv_ent)
            if callable_owner != 0 do
                callable_child_count = vec_len_rt(callable_owner.children)
                var callable_i = 0
                when callable_i < callable_child_count loop
                    callable_field = vec_get_rt(callable_owner.children, callable_i)
                    if (callable_field.node_type == AstType.Identifier or callable_field.node_type == AstType.VarDecl) and fat_str_eq(callable_field.name, recv.name) == 1 do
                        callable_ret = pass6_callable_return_type(callable_field.name2)
                        callable_ret_ent = pass6_find_entity_ast(symbols, scopes, callable_ret)
                        if callable_ret_ent != 0 do out callable_ret_ent.name end
                        callable_i = callable_child_count
                    else
                        callable_i = callable_i + 1
                    end
                end
            end
        end
        if fat_str_len(m_recv_ent) > 0 do
            m_base_ast = pass6_find_entity_ast(symbols, scopes, m_recv_ent)
            if m_base_ast != 0 do
                n_m = vec_len_rt(m_base_ast.children)
                var mi = 0
                when mi < n_m loop
                    mch = vec_get_rt(m_base_ast.children, mi)
                    if mch.node_type == AstType.FuncDef and fat_str_eq(mch.name, recv.name) == 1 do
                        out mch.name2
                    end
                    mi = mi + 1
                end
            end
        end
        out fat_str_new("")
    end
    if nt == AstType.EnumConstruct do
        if fat_str_len(recv.name2) > 0 do out recv.name2 end
    end
    out fat_str_new("")
end.

func pass6_extract_base_name(type_str: &string):
    var unwrapped = pass6_unwrap_type_name(type_str)
    let slen = fat_str_len(unwrapped)
    if slen <= 0 do out fat_str_new("") end
    if is_quantized_type_str(unwrapped as int) and parse_quantized_codec(unwrapped as int) == Q_CODEC_Q8_0 do
        out fat_str_new("Q80TensorView")
    end
    if fat_str_byte_at(unwrapped, 0) == 91 do
        out fat_str_new("[]")
    end
    var i = 0
    var end_pos = 0 - 1
    when i < slen loop
        let b = fat_str_byte_at(unwrapped, i)
        if b == 60 or b == 40 do
            end_pos = i
            i = slen
        else
            i = i + 1
        end
    end
    if end_pos >= 0 do
        when end_pos > 0 and fat_str_byte_at(unwrapped, end_pos - 1) == 32 loop
            end_pos = end_pos - 1
        end
        if end_pos >= 2 and fat_str_byte_at(unwrapped, end_pos - 2) == 111 and fat_str_byte_at(unwrapped, end_pos - 1) == 102 do
            if end_pos == 2 or fat_str_byte_at(unwrapped, end_pos - 3) == 32 do
                end_pos = end_pos - 2
                when end_pos > 0 and fat_str_byte_at(unwrapped, end_pos - 1) == 32 loop
                    end_pos = end_pos - 1
                end
            end
        end
        out fat_str_slice(unwrapped, 0, end_pos)
    end
    out unwrapped
end.

func pass6_is_array_type_str(type_str: &string):
    var unwrapped = pass6_unwrap_type_name(type_str)
    let slen = fat_str_len(unwrapped)
    if slen >= 2 and fat_str_byte_at(unwrapped, 0) == 91 and fat_str_byte_at(unwrapped, slen - 1) == 93 do
        out true
    end
    out false
end.

func pass6_extract_generic_or_array_elem(type_str: &string):
    var unwrapped = pass6_unwrap_type_name(type_str)
    let slen = fat_str_len(unwrapped)
    if slen <= 2 do out fat_str_new("") end
    if fat_str_byte_at(unwrapped, 0) == 91 and fat_str_byte_at(unwrapped, slen - 1) == 93 do
        var arr_inner = fat_str_slice(unwrapped, 1, slen - 2)
        let in_len = fat_str_len(arr_inner)
        var semi_idx = 0 - 1
        var k = 0
        when k < in_len loop
            if fat_str_byte_at(arr_inner, k) == 59 do
                semi_idx = k
                k = in_len
            else
                k = k + 1
            end
        end
        if semi_idx >= 0 do
            when semi_idx > 0 and fat_str_byte_at(arr_inner, semi_idx - 1) == 32 loop
                semi_idx = semi_idx - 1
            end
            out fat_str_slice(arr_inner, 0, semi_idx)
        end
        out arr_inner
    end
    var start_idx = 0 - 1
    var end_idx = 0 - 1
    var depth = 0
    var i = 0
    when i < slen loop
        let b = fat_str_byte_at(unwrapped, i)
        if b == 60 or b == 40 do
            if start_idx < 0 do
                start_idx = i + 1
            end
            depth = depth + 1
        eif b == 62 or b == 41 do
            depth = depth - 1
            if depth == 0 and start_idx >= 0 do
                end_idx = i
            end
        end
        i = i + 1
    end
    if start_idx >= 0 do
        if end_idx < 0 do
            end_idx = slen
        end
        if end_idx > start_idx do
            out fat_str_slice(unwrapped, start_idx, end_idx - start_idx)
        end
    end
    out fat_str_new("")
end.

func pass6_type_strings_compatible(ref symbols: SymbolTable, ref scopes: ScopeTree, expected: &string, actual: &string):
    if fat_str_len(expected) == 0 or fat_str_len(actual) == 0 do
        out 1
    end
    var exp_un = pass6_unwrap_type_name(expected)
    var act_un = pass6_unwrap_type_name(actual)
    if fat_str_eq(exp_un, act_un) == 1 do
        out 1
    end
    var exp_is_arr = pass6_is_array_type_str(exp_un)
    var act_is_arr = pass6_is_array_type_str(act_un)
    if exp_is_arr and not act_is_arr do
        out 0
    end
    if not exp_is_arr and act_is_arr do
        out 0
    end
    if exp_is_arr and act_is_arr do
        var exp_elem = pass6_extract_generic_or_array_elem(exp_un)
        var act_elem = pass6_extract_generic_or_array_elem(act_un)
        if fat_str_len(act_elem) == 0 do
            out 1
        end
        out pass6_type_strings_compatible(symbols, scopes, exp_elem, act_elem)
    end
    var exp_base = pass6_extract_base_name(exp_un)
    var act_base = pass6_extract_base_name(act_un)
    if fat_str_eq(exp_base, act_base) == 0 do
        out 0
    end
    var exp_gen = pass6_extract_generic_or_array_elem(exp_un)
    var act_gen = pass6_extract_generic_or_array_elem(act_un)
    if fat_str_len(exp_gen) > 0 and fat_str_len(act_gen) > 0 do
        out pass6_type_strings_compatible(symbols, scopes, exp_gen, act_gen)
    end
    out 1
end.

func pass6_get_expr_type_str(ref symbols: SymbolTable, ref scopes: ScopeTree, node: &AstNode):
    if (node as i64) == 0 do out fat_str_new("") end
    if node.node_type == AstType.AddrOf and vec_len_rt(node.children) > 0 do
        out pass6_get_expr_type_str(symbols, scopes, vec_get_rt(node.children, 0) as AstNode)
    end
    if node.node_type == AstType.QuantizeExpr do
        if fat_str_len(node.name2) > 0 do out node.name2 end
        out fat_str_new("QuantizedTensor")
    end
    if node.node_type == AstType.ArrayLiteral do
        let n_ch = vec_len_rt(node.children)
        if n_ch == 0 do
            out fat_str_new("[]")
        end
        var elem0 = vec_get_rt(node.children, 0) as AstNode
        var elem_str = pass6_get_expr_type_str(symbols, scopes, elem0)
        if fat_str_len(elem_str) == 0 do
            let ekind = pass6_infer_type(symbols, scopes, elem0)
            if ekind == TypeKind.String do elem_str = fat_str_new("string")
            eif ekind == TypeKind.Int do elem_str = fat_str_new("int")
            eif ekind == TypeKind.Float do elem_str = fat_str_new("float")
            eif ekind == TypeKind.Bool do elem_str = fat_str_new("bool")
            end
        end
        if fat_str_len(elem_str) > 0 do
            out fat_str_concat(fat_str_concat(fat_str_new("["), elem_str), fat_str_new("]"))
        end
        out fat_str_new("[]")
    end
    if node.node_type == AstType.LiteralStr or node.node_type == AstType.InterpExpr do
        out fat_str_new("string")
    end
    if node.node_type == AstType.LiteralInt do
        out fat_str_new("int")
    end
    if node.node_type == AstType.LiteralFloat do
        out fat_str_new("float")
    end
    if node.node_type == AstType.LiteralBool do
        out fat_str_new("bool")
    end
    if node.node_type == AstType.EntityLiteral do
        if fat_str_len(node.name2) > 0 do
            out node.name2
        end
        out node.name
    end
    if node.node_type == AstType.Identifier do
        var vty = pass6_get_var_type(node.name)
        if fat_str_len(vty) > 0 do
            out vty
        end
        var sid = pass6_lookup_chain(symbols, scopes, scope_current_id(scopes), node.name)
        if sid != -1 do
            var sym = pass6_symbol_at(symbols, sid)
            if sym.ast_id != 0 do
                var decl_node = sym.ast_id as AstNode
                if fat_str_len(decl_node.name2) > 0 do
                    out decl_node.name2
                end
            end
        end
        out fat_str_new("")
    end
    if node.node_type == AstType.Call or node.node_type == AstType.MethodCall do
        var r_ent = pass6_get_receiver_entity_name(symbols, scopes, node)
        if fat_str_len(r_ent) > 0 do
            out r_ent
        end
        if fat_cstr_eq(node.name, "str_concat") == 1 or fat_cstr_eq(node.name, "str_cat") == 1 or fat_cstr_eq(node.name, "fat_str_concat") == 1 or fat_cstr_eq(node.name, "fat_str_new") == 1 or fat_cstr_eq(node.name, "str_slice") == 1 or fat_cstr_eq(node.name, "fat_str_slice") == 1 or fat_cstr_eq(node.name, "rt_strcat") == 1 or fat_cstr_eq(node.name, "rt_itoa") == 1 or fat_cstr_eq(node.name, "str_trim") == 1 or fat_cstr_eq(node.name, "str_to_lower") == 1 or fat_cstr_eq(node.name, "str_to_upper") == 1 or fat_cstr_eq(node.name, "str_repeat") == 1 or fat_cstr_eq(node.name, "str_replace") == 1 do
            out fat_str_new("string")
        end
        if fat_cstr_eq(node.name, "str_eq") == 1 or fat_cstr_eq(node.name, "fat_str_eq") == 1 or fat_cstr_eq(node.name, "str_contains") == 1 or fat_cstr_eq(node.name, "str_starts_with") == 1 or fat_cstr_eq(node.name, "str_ends_with") == 1 or fat_cstr_eq(node.name, "dict_has_key") == 1 do
            out fat_str_new("bool")
        end
        if fat_cstr_eq(node.name, "str_len") == 1 or fat_cstr_eq(node.name, "str_byte_len") == 1 or fat_cstr_eq(node.name, "fat_str_len") == 1 or fat_cstr_eq(node.name, "vec_len") == 1 or fat_cstr_eq(node.name, "dict_len") == 1 do
            out fat_str_new("int")
        end
        var fn_ast = pass6_find_free_function(node.name)
        if (fn_ast as i64) != 0 do
            let fn_ret = fn_ast.name2
            if fat_str_len(fn_ret) > 0 do
                out fn_ret
            end
        else
            var ext_ast = pass6_find_extern(node.name) as AstNode
            if (ext_ast as i64) != 0 do
                let ext_ret = ext_ast.name2
                if fat_str_len(ext_ret) > 0 do
                    out ext_ret
                end
            end
        end
        out fat_str_new("")
    end
    if node.node_type == AstType.BuiltinCall do
        if node.builtin_id == 11 or node.builtin_id == 19 do
            out fat_str_new("string")
        end
        if node.builtin_id == 12 do
            out fat_str_new("bool")
        end
        if fat_cstr_eq(node.name, "str_concat") == 1 or fat_cstr_eq(node.name, "str_cat") == 1 or fat_cstr_eq(node.name, "fat_str_concat") == 1 or fat_cstr_eq(node.name, "fat_str_new") == 1 or fat_cstr_eq(node.name, "str_slice") == 1 or fat_cstr_eq(node.name, "fat_str_slice") == 1 or fat_cstr_eq(node.name, "rt_strcat") == 1 or fat_cstr_eq(node.name, "rt_itoa") == 1 or fat_cstr_eq(node.name, "str_trim") == 1 or fat_cstr_eq(node.name, "str_to_lower") == 1 or fat_cstr_eq(node.name, "str_to_upper") == 1 or fat_cstr_eq(node.name, "str_repeat") == 1 or fat_cstr_eq(node.name, "str_replace") == 1 do
            out fat_str_new("string")
        end
        if fat_cstr_eq(node.name, "str_eq") == 1 or fat_cstr_eq(node.name, "fat_str_eq") == 1 or fat_cstr_eq(node.name, "str_contains") == 1 or fat_cstr_eq(node.name, "str_starts_with") == 1 or fat_cstr_eq(node.name, "str_ends_with") == 1 or fat_cstr_eq(node.name, "dict_has_key") == 1 do
            out fat_str_new("bool")
        end
        out fat_str_new("int")
    end
    if node.node_type == AstType.FieldAccess do
        var f_type = pass6_get_receiver_entity_name(symbols, scopes, node)
        if fat_str_len(f_type) > 0 do
            out f_type
        end
    end
    out fat_str_new("")
end.

func pass6_find_enum_ast(ref symbols: SymbolTable, ref scopes: ScopeTree, name: &string):
    base_name = pass6_extract_base_name(name)
    if fat_str_len(base_name) == 0 do out 0 as AstNode end
    sid = pass6_lookup_chain(symbols, scopes, 0, base_name)
    if sid != -1 do
        sym = pass6_symbol_at(symbols, sid)
        if sym.kind == SymbolKind.Enum and sym.ast_id != 0 do
            out sym.ast_id as AstNode
        end
    end
    if g_pass6_enum_buckets != 0 do
        let bid = pass6_hash_name(base_name)
        let bucket = vec_get_rt(g_pass6_enum_buckets, bid)
        let count = vec_len_rt(bucket)
        var i = 0
        when i < count loop
            let candidate = vec_get_rt(bucket, i) as AstNode
            if fat_str_eq(candidate.name, base_name) == 1 do
                out candidate
            end
            i = i + 1
        end
    end
    out 0 as AstNode
end.

func pass6_enum_is_tagged(enum_ast: &AstNode):
    if (enum_ast as i64) == 0 do out false end
    vcount = vec_len_rt(enum_ast.children)
    var vi = 0
    when vi < vcount loop
        vnode = vec_get_rt(enum_ast.children, vi) as AstNode
        if vec_len_rt(vnode.children) > 0 or vnode.builtin_id > 0 do
            out true
        end
        vi = vi + 1
    end
    out false
end.

func pass6_extract_first_generic_arg(type_str: &string):
    slen = fat_str_len(type_str)
    var lt = 0 - 1
    var i = 0
    when i < slen loop
        let b1 = fat_str_byte_at(type_str, i)
        if b1 == 60 or b1 == 40 do
            lt = i
            i = slen
        else
            i = i + 1
        end
    end
    if lt < 0 do out fat_str_new("") end
    var comma = 0 - 1
    var gt = 0 - 1
    var j = lt + 1
    var depth = 0
    when j < slen loop
        let b2 = fat_str_byte_at(type_str, j)
        if b2 == 60 or b2 == 40 do
            depth = depth + 1
        eif b2 == 62 or b2 == 41 do
            if depth == 0 and gt < 0 do
                gt = j
                j = slen
            else
                depth = depth - 1
            end
        eif b2 == 44 and depth == 0 and comma < 0 do
            comma = j
        end
        j = j + 1
    end
    if comma >= 0 do
        var s = lt + 1
        when s < comma and fat_str_byte_at(type_str, s) == 32 loop s = s + 1 end
        var e = comma
        when e > s and fat_str_byte_at(type_str, e - 1) == 32 loop e = e - 1 end
        out fat_str_slice(type_str, s, e - s)
    end
    if gt >= 0 do
        var s = lt + 1
        when s < gt and fat_str_byte_at(type_str, s) == 32 loop s = s + 1 end
        var e = gt
        when e > s and fat_str_byte_at(type_str, e - 1) == 32 loop e = e - 1 end
        out fat_str_slice(type_str, s, e - s)
    end
    out fat_str_new("")
end.

func pass6_extract_second_generic_arg(type_str: &string):
    slen = fat_str_len(type_str)
    var comma = 0 - 1
    var gt = 0 - 1
    var depth = 0
    var i = 0
    when i < slen loop
        let b = fat_str_byte_at(type_str, i)
        if b == 60 or b == 40 do
            depth = depth + 1
        eif b == 62 or b == 41 do
            if depth == 1 and gt < 0 do
                gt = i
            end
            if depth > 0 do depth = depth - 1 end
        eif b == 44 and depth == 1 and comma < 0 do
            comma = i
        end
        i = i + 1
    end
    if comma >= 0 and gt > comma do
        var start = comma + 1
        when start < gt and fat_str_byte_at(type_str, start) == 32 loop
            start = start + 1
        end
        var end_pos = gt
        when end_pos > start and fat_str_byte_at(type_str, end_pos - 1) == 32 loop
            end_pos = end_pos - 1
        end
        out fat_str_slice(type_str, start, end_pos - start)
    end
    out fat_str_new("")
end.

func count_list_items(s: &string):
    slen = fat_str_len(s)
    if slen <= 0 do out 0 end
    var count = 1
    var angle_depth = 0
    var paren_depth = 0
    var bracket_depth = 0
    var i = 0
    when i < slen loop
        b = fat_str_byte_at(s, i)
        if b == 60 do angle_depth = angle_depth + 1 end
        if b == 62 and angle_depth > 0 do angle_depth = angle_depth - 1 end
        if b == 40 do paren_depth = paren_depth + 1 end
        if b == 41 and paren_depth > 0 do paren_depth = paren_depth - 1 end
        if b == 91 do bracket_depth = bracket_depth + 1 end
        if b == 93 and bracket_depth > 0 do bracket_depth = bracket_depth - 1 end
        if b == 44 and angle_depth == 0 and paren_depth == 0 and bracket_depth == 0 do
            count = count + 1
        end
        i = i + 1
    end
    out count
end.

func get_list_item(s: &string, target_idx: int):
    slen = fat_str_len(s)
    if slen <= 0 do out fat_str_new("") end
    var cur_idx = 0
    var start = 0
    var angle_depth = 0
    var paren_depth = 0
    var bracket_depth = 0
    var i = 0
    when i <= slen loop
        var at_split = false
        if i == slen do
            at_split = true
        else
            b = fat_str_byte_at(s, i)
            if b == 60 do angle_depth = angle_depth + 1 end
            if b == 62 and angle_depth > 0 do angle_depth = angle_depth - 1 end
            if b == 40 do paren_depth = paren_depth + 1 end
            if b == 41 and paren_depth > 0 do paren_depth = paren_depth - 1 end
            if b == 91 do bracket_depth = bracket_depth + 1 end
            if b == 93 and bracket_depth > 0 do bracket_depth = bracket_depth - 1 end
            if b == 44 and angle_depth == 0 and paren_depth == 0 and bracket_depth == 0 do
                at_split = true
            end
        end
        if at_split do
            if cur_idx == target_idx do
                var item_start = start
                when item_start < i and fat_str_byte_at(s, item_start) == 32 loop
                    item_start = item_start + 1
                end
                var item_end = i
                when item_end > item_start and fat_str_byte_at(s, item_end - 1) == 32 loop
                    item_end = item_end - 1
                end
                out fat_str_slice(s, item_start, item_end - item_start)
            end
            cur_idx = cur_idx + 1
            start = i + 1
        end
        i = i + 1
    end
    out fat_str_new("")
end.

func pass6_split_list_items(s: &string):
    var result = vec_new_rt()
    slen = fat_str_len(s)
    if slen <= 0 do out result end
    var start = 0
    var angle_depth = 0
    var paren_depth = 0
    var bracket_depth = 0
    var i = 0
    when i <= slen loop
        var at_split = false
        if i == slen do
            at_split = true
        else
            b = fat_str_byte_at(s, i)
            if b == 60 do angle_depth = angle_depth + 1 end
            if b == 62 and angle_depth > 0 do angle_depth = angle_depth - 1 end
            if b == 40 do paren_depth = paren_depth + 1 end
            if b == 41 and paren_depth > 0 do paren_depth = paren_depth - 1 end
            if b == 91 do bracket_depth = bracket_depth + 1 end
            if b == 93 and bracket_depth > 0 do bracket_depth = bracket_depth - 1 end
            if b == 44 and angle_depth == 0 and paren_depth == 0 and bracket_depth == 0 do
                at_split = true
            end
        end
        if at_split do
            var item_start = start
            when item_start < i and fat_str_byte_at(s, item_start) == 32 loop
                item_start = item_start + 1
            end
            var item_end = i
            when item_end > item_start and fat_str_byte_at(s, item_end - 1) == 32 loop
                item_end = item_end - 1
            end
            var item_str = fat_str_slice(s, item_start, item_end - item_start)
            result = vec_push_rt(result, item_str as i64)
            start = i + 1
        end
        i = i + 1
    end
    out result
end.

func pass6_extract_generic_args_content(type_str: &string):
    slen = fat_str_len(type_str)
    var lt = 0 - 1
    var gt = 0 - 1
    var depth = 0
    var i = 0
    when i < slen loop
        b = fat_str_byte_at(type_str, i)
        if b == 60 or b == 40 do                      # '<' or '('
            if depth == 0 do lt = i end
            depth = depth + 1
        end
        if b == 62 or b == 41 do                      # '>' or ')'
            depth = depth - 1
            if depth == 0 and gt < 0 do gt = i end   # first outermost '>' or ')'
        end
        i = i + 1
    end
    if lt >= 0 and gt > lt do
        out fat_str_slice(type_str, lt + 1, gt - lt - 1)
    end
    out fat_str_new("")
end.

func pass6_substitute_generic_type(param_names: &string, arg_types: &string, target_type: &string):
    tlen = fat_str_len(target_type)
    if fat_str_len(param_names) == 0 or fat_str_len(arg_types) == 0 or tlen == 0 do
        out target_type
    end
    let p_names = pass6_split_list_items(param_names)
    let a_types = pass6_split_list_items(arg_types)
    p_count = vec_len_rt(p_names)
    let a_count = vec_len_rt(a_types)
    if p_count <= 0 or a_count <= 0 do out target_type end

    # Fast path: exact whole-string match
    var p = 0
    when p < p_count and p < a_count loop
        p_name = vec_get_rt(p_names, p) as string
        if fat_str_eq(p_name, target_type) == 1 do
            out vec_get_rt(a_types, p) as string
        end
        p = p + 1
    end

    # Word/token-level substitution for compound types:
    # Handles Vec of (T), Map of (K,V), func(U,T)->U, &T, &mut T, [T], tensor of (T)[M,N], etc.
    var res = fat_str_new("")
    var i = 0
    var changed = false
    when i < tlen loop
        c = fat_str_byte_at(target_type, i)
        if (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or c == 95 do
            var wstart = i
            i = i + 1
            when i < tlen loop
                c2 = fat_str_byte_at(target_type, i)
                if (c2 >= 65 and c2 <= 90) or (c2 >= 97 and c2 <= 122) or (c2 >= 48 and c2 <= 57) or c2 == 95 do
                    i = i + 1
                else
                    break
                end
            end
            word = fat_str_slice(target_type, wstart, i - wstart)
            var matched = false
            var j = 0
            when j < p_count and j < a_count loop
                p_name = vec_get_rt(p_names, j) as string
                if fat_str_eq(p_name, word) == 1 do
                    arg_t = vec_get_rt(a_types, j) as string
                    res = fat_str_concat(res, arg_t)
                    matched = true
                    changed = true
                    break
                end
                j = j + 1
            end
            if not matched do
                res = fat_str_concat(res, word)
            end
        else
            res = fat_str_concat(res, fat_str_slice(target_type, i, 1))
            i = i + 1
        end
    end
    if changed do
        out res
    end
    out target_type
end.

func pass6_is_known_type(ref symbols: SymbolTable, ref scopes: ScopeTree, ty: &string):
    if fat_str_len(ty) == 0 do out true end
    if fat_cstr_eq(ty, "int") == 1 or fat_cstr_eq(ty, "i8") == 1 or fat_cstr_eq(ty, "i16") == 1 or fat_cstr_eq(ty, "i32") == 1 or fat_cstr_eq(ty, "i64") == 1 do out true end
    if fat_cstr_eq(ty, "uint") == 1 or fat_cstr_eq(ty, "u8") == 1 or fat_cstr_eq(ty, "u16") == 1 or fat_cstr_eq(ty, "u32") == 1 or fat_cstr_eq(ty, "u64") == 1 do out true end
    if fat_cstr_eq(ty, "float") == 1 or fat_cstr_eq(ty, "f32") == 1 or fat_cstr_eq(ty, "f64") == 1 do out true end
    if fat_cstr_eq(ty, "bool") == 1 or fat_cstr_eq(ty, "string") == 1 or fat_cstr_eq(ty, "ptr") == 1 or fat_cstr_eq(ty, "void") == 1 or fat_cstr_eq(ty, "any") == 1 do out true end
    if (pass6_find_entity_ast(symbols, scopes, ty) as i64) != 0 do out true end
    if (pass6_find_enum_ast(symbols, scopes, ty) as i64) != 0 do out true end
    out false
end.

func pass6_is_valid_type(ref symbols: SymbolTable, ref scopes: ScopeTree, ty: &string) -> bool:
    if fat_str_len(ty) == 0 do out false end
    let unwrapped = pass6_unwrap_type_name(ty)
    if pass6_resolve_ffi_type(unwrapped) != TypeKind.Void do out true end
    let base_name = pass6_extract_base_name(unwrapped)
    if pass6_is_known_type(symbols, scopes, base_name) do out true end
    if is_tensor_type_str(unwrapped) do out true end
    if is_flux_type_str(unwrapped as int) do out true end
    if pass6_is_array_type_str(unwrapped) do
        let elem_ty = pass6_extract_generic_or_array_elem(unwrapped)
        if fat_str_len(elem_ty) == 0 do out true end
        out pass6_is_valid_type(symbols, scopes, elem_ty)
    end
    if fat_cstr_eq(unwrapped, "dict") == 1 or fat_cstr_eq(unwrapped, "map") == 1 do out true end
    out false
end.

func pass6_is_in_generic_params(gen_params: int, ty: int):
    if fat_str_len(gen_params) == 0 or fat_str_len(ty) == 0 do out false end
    p_count = count_list_items(gen_params)
    var i = 0
    when i < p_count loop
        if fat_str_eq(get_list_item(gen_params, i), ty) == 1 do
            out true
        end
        i = i + 1
    end
    out false
end.

func pass6_check_type_params_resolved(ref symbols: SymbolTable, ref scopes: ScopeTree, diag: &DiagnosticEngine, gen_params: int, ty: int, line: int):
    tlen = fat_str_len(ty)
    if tlen <= 0 or fat_str_len(gen_params) == 0 do out 0 end
    var i = 0
    var had_err = 0
    when i < tlen loop
        c = fat_str_byte_at(ty, i)
        if (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or c == 95 do
            var wstart = i
            i = i + 1
            when i < tlen loop
                c2 = fat_str_byte_at(ty, i)
                if (c2 >= 65 and c2 <= 90) or (c2 >= 97 and c2 <= 122) or (c2 >= 48 and c2 <= 57) or c2 == 95 do
                    i = i + 1
                else
                    break
                end
            end
            word = fat_str_slice(ty, wstart, i - wstart)
            if fat_cstr_eq(word, "func") != 1 and fat_cstr_eq(word, "tensor") != 1 and fat_cstr_eq(word, "mut") != 1 do
                if pass6_is_known_type(symbols, scopes, word) == 0 do
                    if pass6_is_in_generic_params(gen_params, word) == 0 do
                        report_error_info(diag, 3086, line, 0, word as string)
                        had_err = 1
                    end
                end
            end
        else
            i = i + 1
        end
    end
    out had_err
end.

func pass6_check_generic_func_def(ref symbols: SymbolTable, ref scopes: ScopeTree, diag: &DiagnosticEngine, node: &AstNode):
    if node.builtin_id == 0 do out 0 end
    gen_params = node.builtin_id as string
    if fat_str_len(node.name2) > 0 do
        pass6_check_type_params_resolved(symbols, scopes, diag, gen_params, node.name2, node.line)
    end
    child_count = vec_len_rt(node.children)
    var i = 0
    when i < child_count loop
        param = vec_get_rt(node.children, i) as AstNode
        if (param as i64) != 0 do
            if param.node_type == AstType.ParamDef or param.node_type == AstType.RefParam do
                if fat_str_len(param.name2) > 0 do
                    var pline = param.line
                    if pline <= 0 do pline = node.line end
                    pass6_check_type_params_resolved(symbols, scopes, diag, gen_params, param.name2, pline)
                end
            end
        end
        i = i + 1
    end
    out 0
end.

func pass6_check_enum_generic_arg(ref symbols: SymbolTable, ref scopes: ScopeTree, diag: &DiagnosticEngine, decl_type: &string, init_expr: &AstNode):
    if fat_str_len(decl_type) == 0 or (init_expr as i64) == 0 do out 0 end
    if init_expr.node_type != AstType.EnumConstruct do out 0 end
    child_count = vec_len_rt(init_expr.children)
    if child_count == 0 do out 0 end
    arg0 = vec_get_rt(init_expr.children, 0) as AstNode
    if child_count == init_expr.builtin_id + 1 and arg0.node_type == AstType.Identifier and fat_str_eq(arg0.name, init_expr.name2) == 1 do
        if child_count > 1 do
            arg0 = vec_get_rt(init_expr.children, 1) as AstNode
        else
            out 0
        end
    end
    base_name = pass6_extract_base_name(decl_type)
    if fat_str_eq(base_name, fat_str_new("Option")) == 1 do
        if fat_str_eq(init_expr.name, fat_str_new("Some")) == 1 do
            first_arg = pass6_extract_first_generic_arg(decl_type)
            arg_type = pass6_infer_type(symbols, scopes, arg0)
            if fat_str_eq(first_arg, fat_str_new("int")) == 1 and arg_type != TypeKind.Int and arg_type != TypeKind.Void do
                report_error(diag, 3042, init_expr.line, 0)
            eif fat_str_eq(first_arg, fat_str_new("string")) == 1 and arg_type != TypeKind.String and arg_type != TypeKind.Void do
                report_error(diag, 3042, init_expr.line, 0)
            end
        end
    eif fat_str_eq(base_name, fat_str_new("Result")) == 1 do
        first_arg = pass6_extract_first_generic_arg(decl_type)
        second_arg = pass6_extract_second_generic_arg(decl_type)
        arg_type = pass6_infer_type(symbols, scopes, arg0)
        if fat_str_eq(init_expr.name, fat_str_new("Ok")) == 1 do
            if fat_str_eq(first_arg, fat_str_new("int")) == 1 and arg_type != TypeKind.Int and arg_type != TypeKind.Void do
                report_error(diag, 3042, init_expr.line, 0)
            eif fat_str_eq(first_arg, fat_str_new("string")) == 1 and arg_type != TypeKind.String and arg_type != TypeKind.Void do
                report_error(diag, 3042, init_expr.line, 0)
            end
        eif fat_str_eq(init_expr.name, fat_str_new("Err")) == 1 do
            if fat_str_eq(second_arg, fat_str_new("int")) == 1 and arg_type != TypeKind.Int and arg_type != TypeKind.Void do
                report_error(diag, 3042, init_expr.line, 0)
            eif fat_str_eq(second_arg, fat_str_new("string")) == 1 and arg_type != TypeKind.String and arg_type != TypeKind.Void do
                report_error(diag, 3042, init_expr.line, 0)
            end
        end
    end
    out 0
end.

func pass6_check_enum_def(diag: &DiagnosticEngine, node: &AstNode):
    kids = node.children
    vcount = vec_len_rt(kids)
    var buckets = pass6_global_map_new()
    var vi = 0
    when vi < vcount loop
        vnode = vec_get_rt(kids, vi) as AstNode
        tag_val = vnode.int_val
        if tag_val < 0 or tag_val > 4294967295 do
            report_error(diag, 3040, vnode.line, 0)
        end
        var bid = tag_val and 255
        if bid < 0 do bid = 0 - bid end
        var bucket = vec_get_rt(buckets, bid)
        var blen = vec_len_rt(bucket)
        var has_dup = false
        var bi = 0
        when bi < blen loop
            if vec_get_rt(bucket, bi) == tag_val do
                has_dup = true
                bi = blen
            else
                bi = bi + 1
            end
        end
        if has_dup do
            report_error(diag, 3039, vnode.line, 0)
        else
            bucket = vec_push_rt(bucket, tag_val)
            vec_set_rt(buckets, bid, bucket)
        end
        vi = vi + 1
    end
    out 0
end.

func pass6_check_case_expr(ref symbols: SymbolTable, ref scopes: ScopeTree, diag: &DiagnosticEngine, node: &AstNode):
    child_count = vec_len_rt(node.children)
    if child_count < 1 do out 0 end
    target_expr = vec_get_rt(node.children, 0) as AstNode
    pass6_walk(symbols, scopes, diag, target_expr)
    target_kind = pass6_infer_type(symbols, scopes, target_expr)
    # An unannotated function call is not known to return Int. The general
    # expression inferencer keeps that legacy fallback for compatibility, but
    # case-pattern validation must not turn it into a false type mismatch.
    if target_expr.node_type == AstType.Call or target_expr.node_type == AstType.MethodCall do
        target_sym_id = pass6_lookup_chain(symbols, scopes, scope_current_id(scopes), target_expr.name)
        if target_sym_id == -1 do
            target_kind = TypeKind.Void
        else
            target_sym = pass6_symbol_at(symbols, target_sym_id)
            if (target_sym as i64) != 0 do
                if target_sym.return_type == 0 do
                    target_kind = TypeKind.Void
                end
            end
        end
    end

    var target_type_str = pass6_get_receiver_entity_name(symbols, scopes, target_expr)
    if fat_str_len(target_type_str) == 0 and target_expr.node_type == AstType.Identifier do
        target_type_str = pass6_get_var_type(target_expr.name)
    end
    base_enum_name = pass6_extract_base_name(target_type_str)
    target_enum_ast = pass6_find_enum_ast(symbols, scopes, base_enum_name)

    seen_wildcard = false
    seen_arms = pass6_global_map_new()
    covered_variants = vec_new_rt()
    covered_variants_buckets = pass6_global_map_new()

    var i = 1
    when i + 1 < child_count loop
        pat = vec_get_rt(node.children, i) as AstNode
        body = vec_get_rt(node.children, i + 1) as AstNode

        pass6_scope_enter()
        scope_push(scopes, ScopeKind.Block)

        is_wild = false
        if pat.node_type == AstType.Identifier do
            if fat_cstr_eq(pat.name, "_") == 1 or pat.int_val == 0 - 1 do
                is_wild = true
            end
        end

        if seen_wildcard do
            report_error(diag, 3036, pat.line, 0)
        end
        if is_wild do
            seen_wildcard = true
        end

        # Literal case patterns are type-strict. Unknown target types are left
        # to name/type recovery, but known primitive categories cannot mix.
        if pat.node_type == AstType.LiteralInt do
            if target_kind != TypeKind.Void and target_kind != TypeKind.Int do
                report_error(diag, 3001, pat.line, 0)
            end
        eif pat.node_type == AstType.LiteralStr do
            if target_kind != TypeKind.Void and target_kind != TypeKind.String do
                report_error(diag, 3001, pat.line, 0)
            end
        eif pat.node_type == AstType.Identifier do
            is_bool_pat = fat_cstr_eq(pat.name, "true") == 1 or fat_cstr_eq(pat.name, "false") == 1
            if is_bool_pat and target_kind != TypeKind.Void and target_kind != TypeKind.Bool do
                report_error(diag, 3001, pat.line, 0)
            end
        end

        pat_key = pat.name
        if fat_str_len(pat.name2) > 0 do
            pat_key = fat_str_concat(fat_str_concat(pat.name2, fat_str_new(".")), pat.name)
        end
        if pat.node_type == AstType.LiteralInt do
            pat_key = fat_str_concat(fat_str_new("int:"), fat_str_new(rt_itoa(pat.int_val)))
        eif pat.node_type == AstType.LiteralStr do
            pat_key = fat_str_concat(fat_str_new("str:"), pat.name)
        end
        let abid = pass6_hash_name(pat_key)
        var abucket = vec_get_rt(seen_arms, abid)
        let ablen = vec_len_rt(abucket)
        arm_dup = false
        var si = 0
        when si < ablen loop
            if fat_str_eq(vec_get_rt(abucket, si) as string, pat_key) == 1 do
                arm_dup = true
                si = ablen
            else
                si = si + 1
            end
        end
        if arm_dup do
            report_error(diag, 3035, pat.line, 0)
        else
            abucket = vec_push_rt(abucket, pat_key as i64)
            vec_set_rt(seen_arms, abid, abucket)
        end

        if (target_enum_ast as i64) != 0 do
            if not is_wild do
                if pat.node_type == AstType.Identifier do
            if fat_str_len(pat.name2) > 0 and fat_str_eq(pat.name2, base_enum_name) == 0 do
                report_error(diag, 3034, pat.line, 0)
            end

            target_vcount = vec_len_rt(target_enum_ast.children)
            var matched_v = 0 as AstNode
            var tvi = 0
            when tvi < target_vcount loop
                v_cand = vec_get_rt(target_enum_ast.children, tvi) as AstNode
                if fat_str_eq(v_cand.name, pat.name) == 1 do
                    matched_v = v_cand
                end
                tvi = tvi + 1
            end

            if (matched_v as i64) == 0 do
                report_error(diag, 3033, pat.line, 0)
            else
                let cvbid = pass6_hash_name(pat.name)
                var cvbucket = vec_get_rt(covered_variants_buckets, cvbid)
                let cvblen = vec_len_rt(cvbucket)
                already_covered = false
                var cvi = 0
                when cvi < cvblen loop
                    if fat_str_eq(vec_get_rt(cvbucket, cvi) as string, pat.name) == 1 do
                        already_covered = true
                        cvi = cvblen
                    else
                        cvi = cvi + 1
                    end
                end
                if not already_covered do
                    cvbucket = vec_push_rt(cvbucket, pat.name as i64)
                    vec_set_rt(covered_variants_buckets, cvbid, cvbucket)
                    covered_variants = vec_push_rt(covered_variants, pat.name as i64)
                end

                exp_arity = matched_v.builtin_id
                got_binders = vec_len_rt(pat.children)
                if got_binders > 0 or exp_arity > 0 do
                    if got_binders != exp_arity do
                        report_error(diag, 3037, pat.line, 0)
                    end
                end

                if got_binders > 1 do
                    var seen_binders = pass6_global_map_new()
                    var bi = 0
                    when bi < got_binders loop
                        b_node = vec_get_rt(pat.children, bi) as AstNode
                        if fat_cstr_eq(b_node.name, "_") == 0 do
                            let bbid = pass6_hash_name(b_node.name)
                            var bbucket = vec_get_rt(seen_binders, bbid)
                            let bblen = vec_len_rt(bbucket)
                            var has_bdup = false
                            var bki = 0
                            when bki < bblen loop
                                if fat_str_eq(vec_get_rt(bbucket, bki) as string, b_node.name) == 1 do
                                    has_bdup = true
                                    bki = bblen
                                else
                                    bki = bki + 1
                                end
                            end
                            if has_bdup do
                                report_error(diag, 3041, b_node.line, 0)
                            else
                                bbucket = vec_push_rt(bbucket, b_node.name as i64)
                                vec_set_rt(seen_binders, bbid, bbucket)
                            end
                        end
                        bi = bi + 1
                    end
                end

                var bi2 = 0
                when bi2 < got_binders and bi2 < vec_len_rt(matched_v.children) loop
                    b_node = vec_get_rt(pat.children, bi2) as AstNode
                    p_def = vec_get_rt(matched_v.children, bi2) as AstNode
                    if fat_str_len(p_def.name2) > 0 and fat_cstr_eq(b_node.name, "_") == 0 do
                        pass6_set_var_type(b_node.name, p_def.name2)
                    end
                    bi2 = bi2 + 1
                end
            end
        end
    end
end

        var bi_reg = 0
        let n_binders = vec_len_rt(pat.children)
        when bi_reg < n_binders loop
            let b_node = vec_get_rt(pat.children, bi_reg) as AstNode
            if fat_cstr_eq(b_node.name, "_") == 0 do
                let bsid = pass6_register_local(symbols, scopes, b_node.name, true)
                if bsid != -1 do
                    let bsym = pass6_symbol_at(symbols, bsid)
                    native_write_i64(bsym as i64, 32, b_node as i64)
                    let bty_str = pass6_get_var_type(b_node.name)
                    if fat_str_len(bty_str) > 0 do
                        let bk = pass6_resolve_ffi_type(bty_str)
                        if bk != TypeKind.Void do
                            native_write_i64(bsym as i64, 16, bk as i64)
                        end
                    end
                end
            end
            bi_reg = bi_reg + 1
        end

        pass6_walk(symbols, scopes, diag, body)
        scope_pop(scopes)
        pass6_scope_exit()
        i = i + 2
    end

    if i < child_count do
        else_body = vec_get_rt(node.children, i)
        pass6_scope_enter()
        scope_push(scopes, ScopeKind.Block)
        pass6_walk(symbols, scopes, diag, else_body)
        scope_pop(scopes)
        pass6_scope_exit()
    end

    has_else = node.int_val == 1
    if (target_enum_ast as i64) != 0 do
        if not seen_wildcard and not has_else do
            total_v = vec_len_rt(target_enum_ast.children)
            cov_v = vec_len_rt(covered_variants)
            if cov_v < total_v do
                report_error(diag, 3032, node.line, 0)
            end
        end
    end
    out 0
end.

func pass6_check_method_call(ref symbols: SymbolTable, ref scopes: ScopeTree, diag: &DiagnosticEngine, node: &AstNode):
    child_count = vec_len_rt(node.children)
    if child_count <= 0 do
        if node.span_id > 0 do
            report_error_span(diag, 3021, node.span_id, "")
        else
            var call_col = node.int_val
            if call_col <= 0 do call_col = 1 end
            report_error_loc(diag, 3021, 0, node.line, call_col, "")
        end
        out 0
    end
    var ci = 0
    when ci < child_count loop
        pass6_walk(symbols, scopes, diag, vec_get_rt(node.children, ci))
        ci = ci + 1
    end

    recv = vec_get_rt(node.children, 0)
    nargs = child_count - 1
    mname = node.name
    recv_ent_name = pass6_get_receiver_entity_name(symbols, scopes, recv)

    # Priority 1: Entity Method
    if fat_str_len(recv_ent_name) > 0 do
        ent_ast = pass6_find_entity_ast(symbols, scopes, recv_ent_name)
        if ent_ast != 0 do
            n_ech = vec_len_rt(ent_ast.children)
            var mi = 0
            var found_method: AstNode = 0
            when mi < n_ech loop
                m_child = vec_get_rt(ent_ast.children, mi)
                if m_child.node_type == AstType.FuncDef and fat_str_eq(m_child.name, mname) == 1 do
                    found_method = m_child
                    mi = n_ech
                else
                    mi = mi + 1
                end
            end
            if found_method != 0 do
                m_children = vec_len_rt(found_method.children)
                var m_body_idx = m_children - 1
                var bi = 0
                when bi < m_children loop
                    ch = vec_get_rt(found_method.children, bi)
                    if ch.node_type == AstType.Block do
                        m_body_idx = bi
                        bi = m_children
                    else
                        bi = bi + 1
                    end
                end
                m_param_count = m_body_idx
                var has_this = 0
                if m_param_count > 0 do
                    p0 = vec_get_rt(found_method.children, 0)
                    if fat_cstr_eq(p0.name, "this") == 1 do
                        has_this = 1
                    end
                end
                expected_nargs = m_param_count
                if has_this == 1 do
                    expected_nargs = expected_nargs - 1
                end
                if nargs != expected_nargs do
                    report_error(diag, 3022, node.line, 0)
                    out 0
                end
                var ai = 0
                when ai < nargs loop
                    param_pos = ai
                    if has_this == 1 do
                        param_pos = param_pos + 1
                    end
                    param_node = vec_get_rt(found_method.children, param_pos)
                    expected_ty = pass6_resolve_ffi_type(param_node.name2)
                    arg_node = vec_get_rt(node.children, 1 + ai)
                    actual_ty = pass6_infer_type(symbols, scopes, arg_node)
                    var m_p_ent = pass6_find_entity_ast(symbols, scopes, pass6_extract_base_name(param_node.name2))
                    if (m_p_ent as i64) != 0 do
                        if arg_node.node_type == AstType.ArrayLiteral do
                            pass6_report_type_mismatch(diag, symbols, scopes, node, arg_node, param_node.name2, "[any]")
                            out 0
                        eif arg_node.node_type == AstType.LiteralStr or (arg_node.node_type == AstType.LiteralInt and arg_node.int_val != 0) or arg_node.node_type == AstType.LiteralBool or arg_node.node_type == AstType.DictLiteral or arg_node.node_type == AstType.TupleExpr do
                            pass6_report_type_mismatch(diag, symbols, scopes, node, arg_node, param_node.name2, "")
                            out 0
                        eif arg_node.node_type == AstType.LiteralInt and arg_node.int_val == 0 do
                            # 0 is null pointer/entity reference
                        else
                            var m_arg_str = pass6_get_expr_type_str(symbols, scopes, arg_node)
                            if fat_str_len(m_arg_str) > 0 do
                                if pass6_is_array_type_str(m_arg_str) do
                                    pass6_report_type_mismatch(diag, symbols, scopes, node, arg_node, param_node.name2, m_arg_str)
                                    out 0
                                else
                                    var m_a_ent = pass6_find_entity_ast(symbols, scopes, pass6_extract_base_name(m_arg_str))
                                    if (m_a_ent as i64) != 0 do
                                        if pass6_type_strings_compatible(symbols, scopes, param_node.name2, m_arg_str) == 0 do
                                            pass6_report_type_mismatch(diag, symbols, scopes, node, arg_node, param_node.name2, m_arg_str)
                                            out 0
                                        end
                                    end
                                end
                            end
                        end
                    eif pass6_is_array_type_str(param_node.name2) do
                        if arg_node.node_type == AstType.EntityLiteral do
                            pass6_report_type_mismatch(diag, symbols, scopes, node, arg_node, param_node.name2, arg_node.name)
                            out 0
                        eif arg_node.node_type == AstType.LiteralStr or arg_node.node_type == AstType.LiteralInt or arg_node.node_type == AstType.LiteralBool or arg_node.node_type == AstType.DictLiteral or arg_node.node_type == AstType.TupleExpr do
                            pass6_report_type_mismatch(diag, symbols, scopes, node, arg_node, param_node.name2, "")
                            out 0
                        else
                            var m_arg_arr_str = pass6_get_expr_type_str(symbols, scopes, arg_node)
                            if fat_str_len(m_arg_arr_str) > 0 do
                                var m_a_ent2 = pass6_find_entity_ast(symbols, scopes, pass6_extract_base_name(m_arg_arr_str))
                                if (m_a_ent2 as i64) != 0 do
                                    pass6_report_type_mismatch(diag, symbols, scopes, node, arg_node, param_node.name2, m_arg_arr_str)
                                    out 0
                                eif pass6_type_strings_compatible(symbols, scopes, param_node.name2, m_arg_arr_str) == 0 do
                                    pass6_report_type_mismatch(diag, symbols, scopes, node, arg_node, param_node.name2, m_arg_arr_str)
                                    out 0
                                end
                            end
                        end
                    else
                        if expected_ty != TypeKind.Void and actual_ty != TypeKind.Void and pass6_ufcs_types_compatible(expected_ty, actual_ty) == 0 do
                            report_error(diag, 3001, node.line, 0)
                            out 0
                        end
                    end
                    ai = ai + 1
                end
                if has_this == 1 do
                    pass6_check_method_mut_args(symbols, scopes, diag, found_method, node, 0, 0, 1 + nargs)
                else
                    pass6_check_method_mut_args(symbols, scopes, diag, found_method, node, 1, 0, nargs)
                end
                ideFactResolve(node as int, ideFactSymbol(found_method as int), scope_current_id(scopes), 3)
                node.builtin_id = 201
                # Keep only the parser-owned receiver type across the semantic
                # arena boundary. AST-to-MIR rebuilds the qualified method name
                # from its persistent scoped-method table.
                node.name2 = recv_ent_name
                out 0
            end

            # Priority 2: Callable Field
            var fi = 0
            var found_field: AstNode = 0
            when fi < n_ech loop
                f_child = vec_get_rt(ent_ast.children, fi)
                if (f_child.node_type == AstType.Identifier or f_child.node_type == AstType.VarDecl) and fat_str_eq(f_child.name, mname) == 1 do
                    found_field = f_child
                    fi = n_ech
                else
                    fi = fi + 1
                end
            end
            if found_field != 0 do
                ft_str = found_field.name2
                var is_callable = 0
                if fat_str_len(ft_str) >= 4 do
                    if fat_str_byte_at(ft_str, 0) == 102 and fat_str_byte_at(ft_str, 1) == 117 and fat_str_byte_at(ft_str, 2) == 110 and fat_str_byte_at(ft_str, 3) == 99 do
                        is_callable = 1
                    end
                end
                if is_callable == 1 do
                    expected_params = pass6_count_callable_params(ft_str)
                    if expected_params >= 0 and nargs != expected_params do
                        report_error(diag, 3022, node.line, 0)
                        out 0
                    end
                    var field_ai = 0
                    when field_ai < nargs loop
                        field_param_name = pass6_callable_param_type(ft_str, field_ai)
                        field_expected = pass6_resolve_ffi_type(field_param_name)
                        field_arg = vec_get_rt(node.children, 1 + field_ai)
                        field_actual = pass6_infer_type(symbols, scopes, field_arg)
                        if field_expected != TypeKind.Void and field_actual != TypeKind.Void and pass6_ufcs_types_compatible(field_expected, field_actual) == 0 do
                            report_error(diag, 3001, node.line, 0)
                            out 0
                        end
                        field_ai = field_ai + 1
                    end
                    node.builtin_id = 202
                    node.name2 = recv_ent_name
                    out 0
                end
            end
        end
    end

    # Builtin Port UFCS is intentionally narrow: only values produced by
    # `port(...)` receive the send/recv surface.  Opaque pointers never do.
    if fat_cstr_eq(recv_ent_name, "port") == 1 do
        if fat_cstr_eq(mname, "send") == 1 do
            if nargs != 1 do
                report_error(diag, 3022, node.line, 0)
                out 0
            end
            send_arg = vec_get_rt(node.children, 1)
            send_ty = pass6_infer_type(symbols, scopes, send_arg)
            if send_ty != TypeKind.Void & send_ty != TypeKind.Int do
                report_error(diag, 3001, node.line, 0)
                out 0
            end
            node.builtin_id = 203
            node.name2 = mname
            out 0
        end
        if fat_cstr_eq(mname, "recv") == 1 do
            if nargs != 0 do
                report_error(diag, 3022, node.line, 0)
                out 0
            end
            node.builtin_id = 203
            node.name2 = mname
            out 0
        end
    end

    # Priority 3: Free Function / Builtin UFCS
    var recv_actual = pass6_infer_type(symbols, scopes, recv)
    var recv_is_module = 0
    var recv_is_unresolved = 0
    var recv_sid = -1
    if recv.node_type == AstType.Identifier do
        recv_sid = pass6_lookup_chain(symbols, scopes, scope_current_id(scopes), recv.name)
        if recv_sid == -1 do
            recv_sid = pass6_lookup_chain(symbols, scopes, 0, recv.name)
        end
        if recv_sid != -1 do
            var rsym = pass6_symbol_at(symbols, recv_sid)
            if rsym.kind == SymbolKind.Module do
                recv_is_module = 1
            end
        else
            recv_is_unresolved = 1
        end
    end

    if recv_is_module == 0 and recv_is_unresolved == 0 and recv_actual != TypeKind.None and (recv_actual != TypeKind.Void or recv_sid != -1) do
        free_sym_id = -1
        if is_user_module(g_pass6_cur_module) == 1 do
            let mod_mname = fat_str_concat(fat_str_concat(g_pass6_cur_module, fat_str_new(".")), mname)
            free_sym_id = pass6_lookup_chain(symbols, scopes, scope_current_id(scopes), mod_mname)
            if free_sym_id == -1 do
                free_sym_id = pass6_lookup_chain(symbols, scopes, 0, mod_mname)
            end
        end
        if free_sym_id == -1 do
            free_sym_id = pass6_lookup_chain(symbols, scopes, scope_current_id(scopes), mname)
        end
        if free_sym_id == -1 do
            free_sym_id = pass6_lookup_chain(symbols, scopes, 0, mname)
        end
        if free_sym_id != -1 do
            free_sym = pass6_symbol_at(symbols, free_sym_id)
            if free_sym.kind == SymbolKind.Func or free_sym.kind == SymbolKind.Builtin do
                total_args = 1 + nargs
                if free_sym.param_count >= 0 and total_args != free_sym.param_count do
                    report_error(diag, 3022, node.line, 0)
                    out 0
                end
                if free_sym.ast_id != 0 do
                    fn_ast = free_sym.ast_id as AstNode
                    if vec_len_rt(fn_ast.children) > 0 do
                        p0_node = vec_get_rt(fn_ast.children, 0)
                        if p0_node.node_type != AstType.Block and fat_str_len(p0_node.name2) > 0 do
                            p0_expected = pass6_resolve_ffi_type(p0_node.name2)
                            if p0_expected != TypeKind.Void do
                                if pass6_ufcs_types_compatible(p0_expected, recv_actual) == 0 do
                                    report_error(diag, 3001, node.line, 0)
                                    out 0
                                end
                            else
                                p0_type_raw = pass6_unwrap_type_name(p0_node.name2)
                                p0_entity = pass6_find_entity_ast(symbols, scopes, p0_type_raw)
                                if p0_entity != 0 do
                                    recv_entity = pass6_get_receiver_entity_name(symbols, scopes, recv)
                                    if fat_str_len(recv_entity) == 0 or fat_str_eq(recv_entity, p0_type_raw) == 0 do
                                        report_error(diag, 3001, node.line, 0)
                                        out 0
                                    end
                                else
                                    report_error(diag, 3001, node.line, 0)
                                    out 0
                                end
                            end
                        end
                    end
                    var ai2 = 0
                    when ai2 < nargs loop
                        if 1 + ai2 < vec_len_rt(fn_ast.children) do
                            pi_node = vec_get_rt(fn_ast.children, 1 + ai2)
                            if pi_node.node_type != AstType.Block and fat_str_len(pi_node.name2) > 0 do
                                pi_expected = pass6_resolve_ffi_type(pi_node.name2)
                                arg_node2 = vec_get_rt(node.children, 1 + ai2)
                                arg_actual2 = pass6_infer_type(symbols, scopes, arg_node2)
                                if pi_expected != TypeKind.Void and arg_actual2 != TypeKind.Void and pass6_ufcs_types_compatible(pi_expected, arg_actual2) == 0 do
                                    report_error(diag, 3001, node.line, 0)
                                    out 0
                                end
                                if pi_expected == TypeKind.Void do
                                    pi_type_raw = pass6_unwrap_type_name(pi_node.name2)
                                    pi_entity = pass6_find_entity_ast(symbols, scopes, pi_type_raw)
                                    if pi_entity != 0 do
                                        arg_entity = pass6_get_receiver_entity_name(symbols, scopes, arg_node2)
                                        if fat_str_len(arg_entity) > 0 and fat_str_eq(arg_entity, pi_type_raw) == 0 do
                                            report_error(diag, 3001, node.line, 0)
                                            out 0
                                        end
                                    end
                                end
                            end
                        end
                        ai2 = ai2 + 1
                    end
                    pass6_check_method_mut_args(symbols, scopes, diag, fn_ast, node, 0, 0, total_args)
                end
                ideFactResolve(node as int, free_sym_id, scope_current_id(scopes), 3)
                node.builtin_id = 203
                var resolved_callee_identity = mname
                if free_sym.ast_id != 0 do
                    let callee_node = free_sym.ast_id as AstNode
                    if (callee_node as i64) != 0 do
                        if fat_str_len(callee_node.name) > 0 do
                            resolved_callee_identity = pass6_find_canonical_identity(callee_node)
                        end
                    end
                end
                node.name2 = resolved_callee_identity
                out 0
            end
        end
    end

    # Priority 3.5: Module-qualified call like json.string(...)
    if recv.node_type == AstType.Identifier do
        let mod_mname = fat_str_concat(fat_str_concat(recv.name, fat_str_new(".")), mname)
        let mod_fn = pass6_find_func_by_canonical_identity(mod_mname)
        if (mod_fn as i64) != 0 do
            var fn_params = vec_new_rt()
            var fpi = 0
            when fpi < vec_len_rt(mod_fn.children) loop
                let p_ch = vec_get_rt(mod_fn.children, fpi) as AstNode
                let nt_p = p_ch.node_type
                if nt_p == AstType.ParamDef or nt_p == AstType.RefParam or nt_p == AstType.OutParam or nt_p == AstType.Identifier do
                    fn_params = vec_push_rt(fn_params, p_ch)
                end
                fpi = fpi + 1
            end
            if nargs != vec_len_rt(fn_params) do
                report_error(diag, 3022, node.line, 0)
                out 0
            end
            var ai = 0
            when ai < nargs loop
                var m_param_def = vec_get_rt(fn_params, ai) as AstNode
                var m_arg_expr = vec_get_rt(node.children, 1 + ai) as AstNode
                if fat_str_len(m_param_def.name2) > 0 do
                    var expected_ty = pass6_resolve_ffi_type(m_param_def.name2)
                    var actual_ty = pass6_infer_type(symbols, scopes, m_arg_expr)
                    if expected_ty != TypeKind.Void and actual_ty != TypeKind.Void do
                        if pass6_call_arg_types_compatible(symbols, scopes, expected_ty as i64, actual_ty, m_arg_expr, m_param_def.name2, m_param_def.name, node.name) == 0 do
                            pass6_report_type_mismatch(diag, symbols, scopes, node, m_arg_expr, m_param_def.name2, "")
                        end
                    end
                end
                ai = ai + 1
            end
            node.builtin_id = 203
            node.name2 = mod_mname
            out 0
        end
    end

    # Priority 4: No candidate found
    if recv_is_unresolved == 0 do
        if node.span_id > 0 do
            report_error_span(diag, 3021, node.span_id, "")
        else
            var call_col = node.int_val
            if call_col <= 0 do call_col = 1 end
            report_error_loc(diag, 3021, 0, node.line, call_col, "")
        end
    end
    out 0
end.

func pass6_lvalue_root_name(expr: &AstNode):
    if (expr as i64) == 0 do out fat_str_new("") end
    if expr.node_type == AstType.Identifier or expr.node_type == AstType.IndexAccess do
        out expr.name
    end
    if expr.node_type == AstType.FieldAccess or expr.node_type == AstType.ExprIndex do
        if vec_len_rt(expr.children) > 0 do
            out pass6_lvalue_root_name(vec_get_rt(expr.children, 0) as AstNode)
        end
    end
    out fat_str_new("")
end.

func pass6_index_paths_may_overlap(left: &AstNode, right: &AstNode, left_start: int, right_start: int):
    let left_count = vec_len_rt(left.children) - left_start
    let right_count = vec_len_rt(right.children) - right_start
    if left_count != right_count do out 1 end
    var ii = 0
    when ii < left_count loop
        li = vec_get_rt(left.children, left_start + ii) as AstNode
        ri = vec_get_rt(right.children, right_start + ii) as AstNode
        if li.node_type == AstType.LiteralInt and ri.node_type == AstType.LiteralInt do
            if li.int_val != ri.int_val do out 0 end
        else
            # Dynamic indices may evaluate to the same element.
            out 1
        end
        ii = ii + 1
    end
    out 1
end.

func pass6_lvalues_may_overlap(left: &AstNode, right: &AstNode):
    let left_root = pass6_lvalue_root_name(left)
    let right_root = pass6_lvalue_root_name(right)
    if fat_str_len(left_root) == 0 or fat_str_len(right_root) == 0 do out 0 end
    if fat_str_eq(left_root, right_root) == 0 do out 0 end
    if left.node_type == AstType.FieldAccess and right.node_type == AstType.FieldAccess do
        if fat_str_eq(left.name, right.name) == 0 do out 0 end
        if vec_len_rt(left.children) > 0 and vec_len_rt(right.children) > 0 do
            out pass6_lvalues_may_overlap(vec_get_rt(left.children, 0) as AstNode, vec_get_rt(right.children, 0) as AstNode)
        end
        out 1
    end
    if left.node_type == AstType.IndexAccess and right.node_type == AstType.IndexAccess do
        out pass6_index_paths_may_overlap(left, right, 0, 0)
    end
    if left.node_type == AstType.ExprIndex and right.node_type == AstType.ExprIndex do
        if vec_len_rt(left.children) == 0 or vec_len_rt(right.children) == 0 do out 1 end
        if not pass6_lvalues_may_overlap(vec_get_rt(left.children, 0) as AstNode, vec_get_rt(right.children, 0) as AstNode) do out 0 end
        out pass6_index_paths_may_overlap(left, right, 1, 1)
    end
    # A whole object and one of its fields/elements overlap conservatively.
    out 1
end.

func pass6_check_method_mut_args(ref symbols: SymbolTable, ref scopes: ScopeTree, diag: &DiagnosticEngine, fn_ast: &AstNode, call_node: &AstNode, arg_start: int, param_start: int, count: int):
    if (fn_ast as i64) == 0 or (call_node as i64) == 0 do out 0 end
    var fn_params = vec_new_rt()
    var fpi = 0
    let fn_ch_len = vec_len_rt(fn_ast.children)
    when fpi < fn_ch_len loop
        let p_ch = vec_get_rt(fn_ast.children, fpi) as AstNode
        if (p_ch as i64) != 0 do
            let nt_p = p_ch.node_type
            if nt_p == AstType.ParamDef or nt_p == AstType.RefParam or nt_p == AstType.OutParam or nt_p == AstType.Identifier do
                fn_params = vec_push_rt(fn_params, p_ch)
            end
        end
        fpi = fpi + 1
    end
    let num_params = vec_len_rt(fn_params)
    let num_args = vec_len_rt(call_node.children)

    var seen = vec_new_rt()
    var ai = 0
    when ai < count loop
        let p_idx = param_start + ai
        let a_idx = arg_start + ai
        if p_idx < num_params and a_idx < num_args do
            param_def = vec_get_rt(fn_params, p_idx) as AstNode
            arg_expr = vec_get_rt(call_node.children, a_idx) as AstNode
            if (param_def as i64) != 0 and (arg_expr as i64) != 0 do
                let is_ref_p = param_def.node_type == AstType.RefParam or param_def.int_val == 1
                let is_out_p = param_def.node_type == AstType.OutParam or param_def.int_val == 2
                if is_ref_p or is_out_p do
                    let is_lval = arg_expr.node_type == AstType.Identifier or arg_expr.node_type == AstType.FieldAccess or arg_expr.node_type == AstType.IndexAccess or arg_expr.node_type == AstType.ExprIndex
                    if not is_lval do
                        report_error(diag, 3048, call_node.line, 0)
                    else
                        var si = 0
                        var overlaps = false
                        when si < vec_len_rt(seen) loop
                            if pass6_lvalues_may_overlap(vec_get_rt(seen, si) as AstNode, arg_expr) do overlaps = true end
                            si = si + 1
                        end
                        if overlaps do
                            report_error(diag, 5003, call_node.line, 0)
                        else
                            seen = vec_push_rt(seen, arg_expr as i64)
                        end

                        root_name = pass6_lvalue_root_name(arg_expr)
                        sym_idx = pass6_lookup_chain(symbols, scopes, scope_current_id(scopes), root_name)
                        if sym_idx != -1 do
                            sym = pass6_symbol_at(symbols, sym_idx)
                            if sym.kind == SymbolKind.Const or not sym.is_mutable do
                                report_error(diag, 3003, call_node.line, 0)
                            end
                            if is_ref_p and sym.ast_id != 0 do
                                decl = sym.ast_id as AstNode
                                if decl.node_type == AstType.VarDecl and vec_len_rt(decl.children) == 0 and pass6_name_in_vec(g_pass6_assigned_vars, root_name) == 0 do
                                    report_error(diag, 3049, call_node.line, 0)
                                end
                            end
                        end
                        if is_out_p and arg_expr.node_type == AstType.Identifier and pass6_name_in_vec(g_pass6_assigned_vars, arg_expr.name) == 0 do
                            g_pass6_assigned_vars = vec_push_rt(g_pass6_assigned_vars, arg_expr.name as i64)
                        end
                    end
                end
            end
        end
        ai = ai + 1
    end
end.

# Entity members are selected by pass 6 from the resolved receiver AST. Keep
# their identities in the same symbol table, only for an IDE capture session.
func pass6CaptureIdeMember(symbols: SymbolTable, scopes: ScopeTree, member: &AstNode, parentId: int):
    if g_ideFactsEnabled == 0 do out 0 end
    if ideFactSymbol(member as int) >= 0 do out 0 end
    if member.node_type != AstType.Identifier and member.node_type != AstType.FuncDef do out 0 end
    var kind = SymbolKind.Variable
    if member.node_type == AstType.FuncDef do kind = SymbolKind.Method end
    let memberScope = scope_current_id(scopes)
    let symbol = SymbolNode (
        kind: kind, name_id: member.name as int, type_id: 0,
        scope_id: memberScope, ast_id: member as int, is_mutable: true,
        offset: 0, param_count: 0, return_type: 0, parent_id: parentId
    )
    let symbolId = symbol_alloc(symbols, symbol)
    ideFactResolve(member as int, symbolId, memberScope, 1)
    ideFactType(member as int, pass6_resolve_ffi_type(member.name2) as int)
end.

func pass6_type_kind_to_str(kind: TypeKind) -> string:
    if kind == TypeKind.Int do out "int" end
    if kind == TypeKind.String do out "string" end
    if kind == TypeKind.Bool do out "bool" end
    if kind == TypeKind.Float do out "float" end
    if kind == TypeKind.Array do out "array" end
    if kind == TypeKind.Entity do out "entity" end
    if kind == TypeKind.Dict do out "dict" end
    if kind == TypeKind.Tuple do out "tuple" end
    if kind == TypeKind.Func do out "func" end
    if kind == TypeKind.Tensor do out "tensor" end
    if kind == TypeKind.Void do out "void" end
    if kind == TypeKind.None do out "none" end
    out "unknown"
end.

func pass6_get_actual_type_str(ref symbols: SymbolTable, ref scopes: ScopeTree, node: &AstNode) -> string:
    if (node as i64) == 0 do out "unknown" end
    var tstr = pass6_get_expr_type_str(symbols, scopes, node)
    if fat_str_len(tstr) > 0 do out tstr end
    var tkind = pass6_infer_type(symbols, scopes, node)
    out pass6_type_kind_to_str(tkind)
end.

func pass6_report_return_type_mismatch(diag: &DiagnosticEngine, ref symbols: SymbolTable, ref scopes: ScopeTree, ret_stmt: &AstNode, ret_expr: &AstNode, expected_type_str: &string):
    var fn_ctx = fat_str_new("")
    if g_pass6_current_func_name != 0 do
        fn_ctx = g_pass6_current_func_name as string
    end
    var actual_type_str = pass6_get_actual_type_str(symbols, scopes, ret_expr)
    set_diag_context(fn_ctx, expected_type_str, actual_type_str)
    var span_id = 0
    if (ret_expr as i64) != 0 do
        span_id = ret_expr.span_id
    end
    if span_id <= 0 and (ret_stmt as i64) != 0 do
        span_id = ret_stmt.span_id
    end
    if span_id > 0 do
        report_error_span(diag, 3007, span_id, "")
    else
        var err_line = ret_stmt.line
        if (ret_expr as i64) != 0 and ret_expr.line > 0 do
            err_line = ret_expr.line
        end
        report_error_loc(diag, 3007, 0, err_line, 1, "")
    end
    clear_diag_context()
end.

func pass6_report_field_type_mismatch(diag: &DiagnosticEngine, ref symbols: SymbolTable, ref scopes: ScopeTree, assign_stmt: &AstNode, rhs_field: &AstNode, declared_field_type_str: &string):
    var fn_ctx = fat_str_new("")
    if g_pass6_current_func_name != 0 do
        fn_ctx = g_pass6_current_func_name as string
    end
    var actual_type_str = pass6_get_actual_type_str(symbols, scopes, rhs_field)
    set_diag_context(fn_ctx, declared_field_type_str, actual_type_str)
    var span_id = 0
    if (rhs_field as i64) != 0 do
        span_id = rhs_field.span_id
    end
    if span_id <= 0 and (assign_stmt as i64) != 0 do
        span_id = assign_stmt.span_id
    end
    if span_id > 0 do
        report_error_span(diag, 3007, span_id, "")
    else
        var err_line = assign_stmt.line
        var err_col = assign_stmt.int_val
        if err_col <= 0 do err_col = 1 end
        report_error_loc(diag, 3007, 0, err_line, err_col, "")
    end
    clear_diag_context()
end.

func pass6_report_type_mismatch(diag: &DiagnosticEngine, ref symbols: SymbolTable, ref scopes: ScopeTree, target_stmt: &AstNode, expr_node: &AstNode, expected_type_str: &string, actual_type_str: &string):
    var fn_ctx = fat_str_new("")
    if g_pass6_current_func_name != 0 do
        fn_ctx = g_pass6_current_func_name as string
    end
    var exp_str = expected_type_str
    var act_str = actual_type_str
    if fat_str_len(act_str) == 0 and (expr_node as i64) != 0 do
        act_str = pass6_get_actual_type_str(symbols, scopes, expr_node)
    end
    set_diag_context(fn_ctx, exp_str, act_str)
    var span_id = 0
    if (expr_node as i64) != 0 do
        span_id = expr_node.span_id
    end
    if span_id <= 0 and (target_stmt as i64) != 0 do
        span_id = target_stmt.span_id
    end
    if span_id > 0 do
        report_error_span(diag, 3007, span_id, "")
    else
        var err_line = 0
        var err_col = 1
        if (expr_node as i64) != 0 and expr_node.line > 0 do
            err_line = expr_node.line
            err_col = expr_node.int_val
        eif (target_stmt as i64) != 0 do
            err_line = target_stmt.line
            err_col = target_stmt.int_val
        end
        if err_col <= 0 do err_col = 1 end
        report_error_loc(diag, 3007, 0, err_line, err_col, "")
    end
    clear_diag_context()
end.

func pass6_walk(ref symbols: SymbolTable, ref scopes: ScopeTree, diag: &DiagnosticEngine, node: &AstNode):
    # Recovered/optional parser children may be represented by a null AST
    # entry.  Semantic traversal must ignore the absent child rather than
    # dereferencing its fields during large self-host inputs.
    if node as i64 == 0 do out 0 end
    # Method bodies are resolved by pass 6 rather than the pass 3 walk.
    # Capture the binding that this resolver actually selected.
    if g_ideFactsEnabled == 1 do
        if g_pass6_current_entity_name != 0 do
            if node.node_type == AstType.Identifier & ideFactSymbol(node as int) < 0 do
                let methodBinding = pass6_lookup_chain(symbols, scopes, scope_current_id(scopes), node.name)
                if methodBinding >= 0 do
                    ideFactResolve(node as int, methodBinding, scope_current_id(scopes), 2)
                    let methodSymbol = pass6_symbol_at(symbols, methodBinding)
                    ideFactType(node as int, native_read_i64(methodSymbol as int, 16))
                end
            end
        end
    end

    if node.node_type == AstType.ModuleStmt do
        g_pass6_cur_module = node.name
        out 0
    end

    if fat_str_len(node.name2) > 0 and is_tensor_type_str(node.name2) and not tensor_type_is_well_formed(node.name2) do
        report_error(diag, 3024, node.line, 0)
    end

    if node.node_type == AstType.ThrowStmt do
        if vec_len_rt(node.children) != 1 do
            report_error(diag, 3059, node.line, 0)
        else
            throw_ty = pass6_infer_type(symbols, scopes, vec_get_rt(node.children, 0) as AstNode)
            if throw_ty != TypeKind.Void and throw_ty != TypeKind.Int do
                report_error(diag, 3059, node.line, 0)
            end
        end
    end

    if node.node_type == AstType.ReturnStmt do
        if vec_len_rt(node.children) > 0 do
            var ret_val_node = vec_get_rt(node.children, 0) as AstNode
            pass6_walk(symbols, scopes, diag, ret_val_node)
            if g_pass6_current_func_ret_type != 0 do
                var cur_ret_str = g_pass6_current_func_ret_type as string
                if fat_str_len(cur_ret_str) > 0 do
                    var actual_ret_kind = pass6_infer_type(symbols, scopes, ret_val_node)
                    var ret_ent = pass6_find_entity_ast(symbols, scopes, pass6_extract_base_name(cur_ret_str))
                    if (ret_ent as i64) != 0 do
                        if ret_val_node.node_type == AstType.ArrayLiteral do
                            pass6_report_return_type_mismatch(diag, symbols, scopes, node, ret_val_node, cur_ret_str)
                        eif ret_val_node.node_type == AstType.LiteralStr or (ret_val_node.node_type == AstType.LiteralInt and ret_val_node.int_val != 0) or ret_val_node.node_type == AstType.LiteralBool or ret_val_node.node_type == AstType.DictLiteral or ret_val_node.node_type == AstType.TupleExpr do
                            pass6_report_return_type_mismatch(diag, symbols, scopes, node, ret_val_node, cur_ret_str)
                        eif ret_val_node.node_type == AstType.LiteralInt and ret_val_node.int_val == 0 do
                            # 0 is null pointer/entity reference
                        else
                            var r_val_str = pass6_get_expr_type_str(symbols, scopes, ret_val_node)
                            if fat_str_len(r_val_str) > 0 do
                                if pass6_is_array_type_str(r_val_str) do
                                    pass6_report_return_type_mismatch(diag, symbols, scopes, node, ret_val_node, cur_ret_str)
                                else
                                    var r_a_ent = pass6_find_entity_ast(symbols, scopes, pass6_extract_base_name(r_val_str))
                                    if (r_a_ent as i64) != 0 do
                                        if pass6_type_strings_compatible(symbols, scopes, cur_ret_str, r_val_str) == 0 do
                                            pass6_report_return_type_mismatch(diag, symbols, scopes, node, ret_val_node, cur_ret_str)
                                        end
                                    end
                                end
                            end
                        end
                    eif pass6_is_array_type_str(cur_ret_str) do
                        if ret_val_node.node_type == AstType.EntityLiteral do
                            pass6_report_return_type_mismatch(diag, symbols, scopes, node, ret_val_node, cur_ret_str)
                        eif ret_val_node.node_type == AstType.LiteralStr or ret_val_node.node_type == AstType.LiteralInt or ret_val_node.node_type == AstType.LiteralBool or ret_val_node.node_type == AstType.DictLiteral or ret_val_node.node_type == AstType.TupleExpr do
                            pass6_report_return_type_mismatch(diag, symbols, scopes, node, ret_val_node, cur_ret_str)
                        else
                            var r_val_arr_str = pass6_get_expr_type_str(symbols, scopes, ret_val_node)
                            if fat_str_len(r_val_arr_str) > 0 do
                                var r_a_ent2 = pass6_find_entity_ast(symbols, scopes, pass6_extract_base_name(r_val_arr_str))
                                if (r_a_ent2 as i64) != 0 do
                                    pass6_report_return_type_mismatch(diag, symbols, scopes, node, ret_val_node, cur_ret_str)
                                eif pass6_type_strings_compatible(symbols, scopes, cur_ret_str, r_val_arr_str) == 0 do
                                    pass6_report_return_type_mismatch(diag, symbols, scopes, node, ret_val_node, cur_ret_str)
                                end
                            end
                        end
                    else
                        var ret_expected_kind = pass6_resolve_ffi_type(cur_ret_str)
                        if ret_expected_kind == TypeKind.String and ret_val_node.node_type == AstType.LiteralInt do
                            pass6_report_return_type_mismatch(diag, symbols, scopes, node, ret_val_node, cur_ret_str)
                        eif ret_expected_kind == TypeKind.Int and ret_val_node.node_type == AstType.LiteralStr do
                            pass6_report_return_type_mismatch(diag, symbols, scopes, node, ret_val_node, cur_ret_str)
                        eif ret_expected_kind == TypeKind.Bool and (ret_val_node.node_type == AstType.LiteralStr or ret_val_node.node_type == AstType.LiteralInt) do
                            pass6_report_return_type_mismatch(diag, symbols, scopes, node, ret_val_node, cur_ret_str)
                        eif ret_expected_kind != TypeKind.Void and ret_expected_kind != TypeKind.None and actual_ret_kind != TypeKind.Void do
                            if pass6_types_compatible(ret_expected_kind as i64, actual_ret_kind) == 0 do
                                # In system/compiler modules, allow bool↔int return mismatch.
                                var allow_ret = 0
                                if is_user_module(g_pass6_cur_module) == 0 do
                                    if (ret_expected_kind == TypeKind.Bool and pass6_is_integer_like(actual_ret_kind as i64) == 1) or (pass6_is_integer_like(ret_expected_kind as i64) == 1 and actual_ret_kind == TypeKind.Bool) do
                                        allow_ret = 1
                                    end
                                end
                                if allow_ret == 0 do
                                    pass6_report_return_type_mismatch(diag, symbols, scopes, node, ret_val_node, cur_ret_str)
                                end
                            end
                        end
                    end
                end
            end
        end
        out 0
    end

    if node.node_type == AstType.PrintStmt do
        if vec_len_rt(node.children) > 0 do
            var p_expr = vec_get_rt(node.children, 0) as AstNode
            pass6_walk(symbols, scopes, diag, p_expr)
            var p_ty = pass6_infer_type(symbols, scopes, p_expr)
            var p_is_ent = false
            if p_expr.node_type == AstType.EntityLiteral do
                p_is_ent = true
            eif p_expr.node_type == AstType.Identifier do
                var p_ent_name = pass6_get_var_type(p_expr.name)
                if fat_str_len(p_ent_name) > 0 do
                    var p_raw = pass6_unwrap_type_name(p_ent_name)
                    if (pass6_find_entity_ast(symbols, scopes, p_raw) as i64) != 0 do
                        p_is_ent = true
                    end
                end
            eif p_ty == TypeKind.Entity do
                var ent_cname = fat_str_new("")
                if p_expr.node_type == AstType.Call or p_expr.node_type == AstType.MethodCall do
                    ent_cname = pass6_get_receiver_entity_name(symbols, scopes, p_expr)
                end
                if fat_str_len(ent_cname) > 0 do
                    var ent_raw = pass6_unwrap_type_name(ent_cname)
                    if (pass6_find_entity_ast(symbols, scopes, ent_raw) as i64) != 0 do
                        p_is_ent = true
                    end
                end
            end
            if p_is_ent or p_ty == TypeKind.Pointer do
                report_error(diag, 3001, node.line, 0)
            end
            out 0
        end
    end

    if node.node_type == AstType.AddrOf do
        if vec_len_rt(node.children) > 0 do
            var target = vec_get_rt(node.children, 0) as AstNode
            pass6_walk(symbols, scopes, diag, target)
            var is_mut_borrow = false
            if fat_cstr_eq(node.name, "mut") == 1 or node.int_val == 1 do
                is_mut_borrow = true
            end
            if is_mut_borrow do
                var is_immutable = false
                var root_name = pass6_lvalue_root_name(target)
                if fat_str_len(root_name) > 0 do
                    var addr_sid = pass6_lookup_chain(symbols, scopes, scope_current_id(scopes), root_name)
                    if addr_sid != -1 do
                        var addr_sym = pass6_symbol_at(symbols, addr_sid)
                        if addr_sym.ast_id != 0 do
                            var d_ast = addr_sym.ast_id as AstNode
                            if d_ast.node_type == AstType.ConstDecl do
                                is_immutable = true
                            end
                            var d_ty = d_ast.name2
                            if fat_str_len(d_ty) > 0 do
                                if fat_str_byte_at(d_ty, 0) == 38 do
                                    var has_mut = false
                                    var blen = fat_str_len(d_ty)
                                    if blen >= 4 and fat_str_byte_at(d_ty, 1) == 109 and fat_str_byte_at(d_ty, 2) == 117 and fat_str_byte_at(d_ty, 3) == 116 do
                                        has_mut = true
                                    end
                                    if not has_mut do
                                        is_immutable = true
                                    end
                                eif fat_str_len(d_ty) >= 4 and fat_str_byte_at(d_ty, 0) == 114 and fat_str_byte_at(d_ty, 1) == 101 and fat_str_byte_at(d_ty, 2) == 102 and fat_str_byte_at(d_ty, 3) == 32 do
                                    is_immutable = true
                                end
                            end
                        end
                    end
                end
                if is_immutable do
                    report_error(diag, 3003, node.line, 0)
                end
            end
        end
        out 0
    end

    if node.node_type == AstType.EmitStmt do
        if vec_len_rt(node.children) != 1 do
            report_error(diag, 3073, node.line, 0)
        else
            emit_expr = vec_get_rt(node.children, 0) as AstNode
            if emit_expr.node_type != AstType.Call and emit_expr.node_type != AstType.EntityLiteral do
                report_error(diag, 3073, node.line, 0)
            end
        end
    end

    if node.node_type == AstType.AtomicVarDecl do
        if vec_len_rt(node.children) != 1 do
            report_error(diag, 3072, node.line, 0)
        else
            atomic_decl = vec_get_rt(node.children, 0) as AstNode
            atomic_ty = pass6_resolve_ffi_type(atomic_decl.name2)
            if atomic_ty == TypeKind.String or atomic_ty == TypeKind.Pointer or atomic_ty == TypeKind.Entity or atomic_ty == TypeKind.Array or atomic_ty == TypeKind.Tensor do
                report_error(diag, 3072, node.line, 0)
            end
        end
    end

    if node.node_type == AstType.EntityLiteral do
        pass6_check_packed_literal(symbols, scopes, diag, node)
        ent_ast = pass6_find_best_entity_ast(symbols, scopes, node)
        if (ent_ast as i64) != 0 do
            if g_ideFactsEnabled == 1 do
                var valueIndex = 0
                when valueIndex < vec_len_rt(node.children) loop
                    let fieldValue = vec_get_rt(node.children, valueIndex) as AstNode
                    let labelNode = ideFactProjection(fieldValue as int)
                    if labelNode != 0 do
                        var fieldIndex = 0
                        when fieldIndex < vec_len_rt(ent_ast.children) loop
                            let fieldDecl = vec_get_rt(ent_ast.children, fieldIndex) as AstNode
                            if fieldDecl.node_type == AstType.Identifier do
                                if fat_str_eq(fieldDecl.name, fieldValue.name2) == 1 do
                                    ideFactResolve(labelNode, ideFactSymbol(fieldDecl as int), scope_current_id(scopes), 4)
                                end
                            end
                            fieldIndex = fieldIndex + 1
                        end
                    end
                    valueIndex = valueIndex + 1
                end
            end
            if ent_ast.builtin_id != 0 do
                ent_decl_cnt = count_list_items(ent_ast.builtin_id as string)
                var ent_prov_cnt = 0
                if fat_str_len(node.name2) > 0 do
                    ent_prov_cnt = count_list_items(node.name2)
                end
                if ent_decl_cnt != ent_prov_cnt do
                    report_error(diag, 3085, node.line, 0)
                end
            end
        end
    end

    if node.node_type == AstType.RegisterDef do
        var base_bits = pass6_register_base_bits(node.name2)
        var rf_i = 0
        when rf_i < vec_len_rt(node.children) loop
            var rf = vec_get_rt(node.children, rf_i) as AstNode
            var rf_width = rf.builtin_id
            if rf_width <= 0 do
                report_error(diag, 3077, rf.line, 0)
            eif base_bits <= 0 or rf.int_val < 0 or rf.int_val + rf_width > base_bits do
                report_error(diag, 3078, rf.line, 0)
            end
            rf_i = rf_i + 1
        end
    end

    # Register/mold fields are unsigned bit slices. Reject constant writes
    # that would otherwise be silently truncated by BIT_INSERT.
    if node.node_type == AstType.FieldAssign and vec_len_rt(node.children) > 0 do
        var owner_type = pass6_get_var_type(node.name)
        # fa_is_var_decl: true only if the owner symbol comes from a VarDecl (local binding).
        # Parameter &T declarations (ParamDef/RefParam) are allowed to mutate in
        # current Vir semantics (e.g. arena-allocated AstNode, SymbolTable, etc.).
        var fa_is_var_decl = false
        var f_owner_sym = pass6_lookup_chain(symbols, scopes, scope_current_id(scopes), node.name)
        if f_owner_sym != -1 do
            var f_sym = pass6_symbol_at(symbols, f_owner_sym)
            if f_sym.ast_id != 0 do
                var f_decl = f_sym.ast_id as AstNode
                if f_decl.node_type == AstType.VarDecl or f_decl.node_type == AstType.ConstDecl do
                    fa_is_var_decl = true
                end
                if fat_str_len(owner_type) == 0 do
                    if fat_str_len(f_decl.name2) > 0 do
                        owner_type = f_decl.name2
                    eif vec_len_rt(f_decl.children) > 0 do
                        var f_init = vec_get_rt(f_decl.children, 0) as AstNode
                        if f_init.node_type == AstType.EntityLiteral do
                            owner_type = f_init.name
                        end
                    end
                end
            end
        end
        # Mutability check: reject write through local shared &T variable binding.
        # Only for VarDecl (not ParamDef) because param &T is still mutable in
        # current Vir semantics.
        if fa_is_var_decl and fat_str_len(owner_type) > 0 and fat_str_byte_at(owner_type, 0) == 38 do
            var fa_has_mut = false
            var fa_blen = fat_str_len(owner_type)
            if fa_blen >= 5 and fat_str_byte_at(owner_type, 1) == 109 and fat_str_byte_at(owner_type, 2) == 117 and fat_str_byte_at(owner_type, 3) == 116 and fat_str_byte_at(owner_type, 4) == 32 do
                fa_has_mut = true
            end
            if not fa_has_mut do
                report_error(diag, 3003, node.line, 0)
            end
        end
        # Unwrap &T / &mut T prefix for entity lookup so field checks work through refs.
        var fa_lookup_type = pass6_unwrap_type_name(owner_type)
        var owner_def = pass6_find_entity_ast(symbols, scopes, fa_lookup_type)
        if owner_def as i64 != 0 do
            var field_found = false
            var declared_field_type_str = fat_str_new("")
            var fi = 0
            when fi < vec_len_rt(owner_def.children) loop
                var field_def = vec_get_rt(owner_def.children, fi) as AstNode
                if fat_str_eq(field_def.name, node.name2) == 1 do
                    field_found = true
                    declared_field_type_str = field_def.name2
                    let labelNode = ideFactProjection(node as int)
                    if labelNode != 0 do ideFactResolve(labelNode, ideFactSymbol(field_def as int), scope_current_id(scopes), 4) end
                    fi = vec_len_rt(owner_def.children)
                else
                    fi = fi + 1
                end
            end
            if not field_found do
                if pass6_entity_has_field(symbols, scopes, fa_lookup_type, node.name2) == 0 do
                    var f_col = node.int_val
                    if f_col <= 0 do f_col = 1 end
                    report_error_loc(diag, 3008, 0, node.line, f_col, node.name2 as string)
                end
            else
                var rhs_field = vec_get_rt(node.children, 0) as AstNode
                if fat_str_len(declared_field_type_str) > 0 do
                    var f_ent_ast = pass6_find_entity_ast(symbols, scopes, pass6_extract_base_name(declared_field_type_str))
                    if (f_ent_ast as i64) != 0 do
                        if rhs_field.node_type == AstType.ArrayLiteral do
                            pass6_report_field_type_mismatch(diag, symbols, scopes, node, rhs_field, declared_field_type_str)
                        eif rhs_field.node_type == AstType.LiteralStr or (rhs_field.node_type == AstType.LiteralInt and rhs_field.int_val != 0) or rhs_field.node_type == AstType.LiteralBool or rhs_field.node_type == AstType.DictLiteral or rhs_field.node_type == AstType.TupleExpr do
                            pass6_report_field_type_mismatch(diag, symbols, scopes, node, rhs_field, declared_field_type_str)
                        eif rhs_field.node_type == AstType.LiteralInt and rhs_field.int_val == 0 do
                            # 0 is null pointer/entity reference
                        else
                            var rhs_f_str = pass6_get_expr_type_str(symbols, scopes, rhs_field)
                            if fat_str_len(rhs_f_str) > 0 do
                                if pass6_is_array_type_str(rhs_f_str) do
                                    pass6_report_field_type_mismatch(diag, symbols, scopes, node, rhs_field, declared_field_type_str)
                                else
                                    var f_a_ent = pass6_find_entity_ast(symbols, scopes, pass6_extract_base_name(rhs_f_str))
                                    if (f_a_ent as i64) != 0 do
                                        if pass6_type_strings_compatible(symbols, scopes, declared_field_type_str, rhs_f_str) == 0 do
                                            pass6_report_field_type_mismatch(diag, symbols, scopes, node, rhs_field, declared_field_type_str)
                                        end
                                    end
                                end
                            end
                        end
                    eif pass6_is_array_type_str(declared_field_type_str) do
                        if rhs_field.node_type == AstType.EntityLiteral do
                            pass6_report_field_type_mismatch(diag, symbols, scopes, node, rhs_field, declared_field_type_str)
                        eif rhs_field.node_type == AstType.LiteralStr or rhs_field.node_type == AstType.LiteralInt or rhs_field.node_type == AstType.LiteralBool or rhs_field.node_type == AstType.DictLiteral or rhs_field.node_type == AstType.TupleExpr do
                            pass6_report_field_type_mismatch(diag, symbols, scopes, node, rhs_field, declared_field_type_str)
                        else
                            var rhs_f_arr_str = pass6_get_expr_type_str(symbols, scopes, rhs_field)
                            if fat_str_len(rhs_f_arr_str) > 0 do
                                var f_a_ent2 = pass6_find_entity_ast(symbols, scopes, pass6_extract_base_name(rhs_f_arr_str))
                                if (f_a_ent2 as i64) != 0 do
                                    pass6_report_field_type_mismatch(diag, symbols, scopes, node, rhs_field, declared_field_type_str)
                                eif pass6_type_strings_compatible(symbols, scopes, declared_field_type_str, rhs_f_arr_str) == 0 do
                                    pass6_report_field_type_mismatch(diag, symbols, scopes, node, rhs_field, declared_field_type_str)
                                end
                            end
                        end
                    else
                        var dec_field_kind = pass6_resolve_ffi_type(declared_field_type_str)
                        if dec_field_kind == TypeKind.Int and rhs_field.node_type == AstType.LiteralStr do
                            pass6_report_field_type_mismatch(diag, symbols, scopes, node, rhs_field, declared_field_type_str)
                        eif dec_field_kind == TypeKind.String and rhs_field.node_type == AstType.LiteralInt do
                            pass6_report_field_type_mismatch(diag, symbols, scopes, node, rhs_field, declared_field_type_str)
                        eif dec_field_kind != TypeKind.Void and dec_field_kind != TypeKind.None do
                            var rhs_type = pass6_infer_type(symbols, scopes, rhs_field)
                            if rhs_type != TypeKind.Void and pass6_types_compatible(dec_field_kind as i64, rhs_type) == 0 do
                                if not ((dec_field_kind == TypeKind.Int and rhs_type == TypeKind.String) or (dec_field_kind == TypeKind.String and pass6_is_integer_like(rhs_type as i64) == 1)) do
                                    pass6_report_field_type_mismatch(diag, symbols, scopes, node, rhs_field, declared_field_type_str)
                                end
                            end
                        end
                    end
                end
            end

            if owner_def.node_type == AstType.RegisterDef do
                var field_width = 0
                var rfi = 0
                when rfi < vec_len_rt(owner_def.children) loop
                    var rf_def = vec_get_rt(owner_def.children, rfi) as AstNode
                    if fat_str_eq(rf_def.name, node.name2) == 1 do
                        field_width = rf_def.builtin_id
                        rfi = vec_len_rt(owner_def.children)
                    else
                        rfi = rfi + 1
                    end
                end
                if field_width > 0 do
                    var reg_rhs = vec_get_rt(node.children, 0) as AstNode
                    var (field_known, field_value) = pass6_eval_const_int(symbols, scopes, reg_rhs, 0)
                    if field_known == 1 do
                        var field_out_of_range = field_value < 0
                        if field_width < 63 and field_value >= (1 shl field_width) do
                            field_out_of_range = true
                        end
                        if field_out_of_range do report_error(diag, 3079, node.line, 0) end
                    end
                end
            end
        end
    end

    if node.node_type == AstType.EntityDef or node.node_type == AstType.PackedDef do
        if node.node_type == AstType.PackedDef do
            pass6_check_packed_def(symbols, scopes, diag, node)
        end
        old_ent = g_pass6_current_entity_name
        g_pass6_current_entity_name = node.name as i64
        pass6_set_var_type(fat_str_new("this"), node.name)
        pass6_scope_enter()
        scope_push(scopes, ScopeKind.Entity)
        child_count = vec_len_rt(node.children)
        var i = 0
        when i < child_count loop
            child = vec_get_rt(node.children, i)
            pass6CaptureIdeMember(symbols, scopes, child, ideFactSymbol(node as int))
            pass6_walk(symbols, scopes, diag, child)
            i = i + 1
        end
        scope_pop(scopes)
        pass6_scope_exit()
        g_pass6_current_entity_name = old_ent
        if old_ent != 0 do
            pass6_set_var_type(fat_str_new("this"), old_ent as string)
        end
        out 0
    end

    if node.node_type == AstType.MethodCall do
        if fat_cstr_eq(node.name, "backward") == 1 do
            if g_pass6_ai_mode == 1 do
                report_error(diag, 3009, node.line, 0)
            eif g_pass6_ai_mode != 2 do
                report_error(diag, 3017, node.line, 0)
            else
                backward_ok = false
                if vec_len_rt(node.children) > 0 do
                    recv = vec_get_rt(node.children, 0)
                    recv_ty = pass6_infer_type(symbols, scopes, recv)
                    if recv.node_type == AstType.Identifier and pass6_name_in_vec(g_pass6_train_values, recv.name) == 1 and (recv_ty == TypeKind.Float or recv_ty == TypeKind.Tensor) do
                        backward_ok = true
                    end
                end
                if not backward_ok do report_error(diag, 3020, node.line, 0) end
            end
            out 0
        end
        pass6_check_method_call(symbols, scopes, diag, node)
        out 0
    end

    if node.node_type == AstType.FieldAccess do
        child_count = vec_len_rt(node.children)
        if child_count > 0 do
            base_node = vec_get_rt(node.children, 0)
            pass6_walk(symbols, scopes, diag, base_node)
            var is_enum = false
            if base_node.node_type == AstType.Identifier do
                chk_enum = pass6_find_enum_ast(symbols, scopes, base_node.name)
                if (chk_enum as i64) != 0 do
                    is_enum = true
                    var found_variant = false
                    var vi = 0
                    when vi < vec_len_rt(chk_enum.children) loop
                        v_child = vec_get_rt(chk_enum.children, vi) as AstNode
                        if fat_str_eq(v_child.name, node.name) == 1 do
                            found_variant = true
                        end
                        vi = vi + 1
                    end
                    if not found_variant do
                        var f_col = node.int_val
                        if f_col <= 0 do f_col = 1 end
                        report_error_loc(diag, 3033, 0, node.line, f_col, node.name as string)
                    end
                end
            end
            if not is_enum do
                var base_ty = pass6_infer_type(symbols, scopes, base_node)
                if base_ty == TypeKind.Pointer do
                    report_error(diag, 3001, node.line, 0)
                    out 0
                end
                base_ent = pass6_get_receiver_entity_name(symbols, scopes, base_node)
                if fat_str_len(base_ent) > 0 do
                    base_raw = pass6_extract_base_name(base_ent)
                    if fat_str_len(g_pass6_current_generic_params) > 0 and pass6_is_in_generic_params(g_pass6_current_generic_params, base_raw) do
                        out 0
                    end
                    ent_ast = pass6_find_entity_ast(symbols, scopes, base_raw)
                    if (ent_ast as i64) != 0 do
                        if pass6_entity_has_field(symbols, scopes, base_raw, node.name) == 0 do
                            var f_col2 = node.int_val
                            if f_col2 <= 0 do f_col2 = 1 end
                            report_error_loc(diag, 3008, 0, node.line, f_col2, node.name as string)
                        else
                            var memberIndex = 0
                            when memberIndex < vec_len_rt(ent_ast.children) loop
                                let resolvedField = vec_get_rt(ent_ast.children, memberIndex) as AstNode
                                if resolvedField.node_type == AstType.Identifier do
                                    if fat_str_eq(resolvedField.name, node.name) == 1 do
                                        ideFactResolve(node as int, ideFactSymbol(resolvedField as int), scope_current_id(scopes), 2)
                                    end
                                end
                                memberIndex = memberIndex + 1
                            end
                        end
                    else
                        var f_col2 = node.int_val
                        if f_col2 <= 0 do f_col2 = 1 end
                        report_error_loc(diag, 3008, 0, node.line, f_col2, node.name as string)
                    end
                end
            end
        end
        out 0
    end

    if node.node_type == AstType.QuantizeExpr do
        q_count = vec_len_rt(node.children)
        if q_count != 2 do
            report_error(diag, 3019, node.line, 0)
        else
            q_value = vec_get_rt(node.children, 0)
            q_bits_expr = vec_get_rt(node.children, 1)
            q_value_type = pass6_infer_type(symbols, scopes, q_value)
            if q_value_type != TypeKind.Tensor do
                report_error(diag, 3018, node.line, 0)
            else
                q_tensor_name = pass6_tensor_type_name(symbols, scopes, q_value)
                if not is_tensor_type_str(q_tensor_name) or parse_tensor_elem_type(q_tensor_name) != TypeKind.Float do
                    report_error(diag, 3018, node.line, 0)
                end
            end
            var q_bits = 8
            if q_bits_expr.node_type != AstType.LiteralInt do
                report_error(diag, 3019, q_bits_expr.line, 0)
            else
                q_bits = q_bits_expr.int_val
                if q_bits != 4 and q_bits != 8 and q_bits != 16 and q_bits != 32 do
                    report_error(diag, 3019, q_bits_expr.line, 0)
                end
            end
            if is_tensor_type_str(q_tensor_name) do
                let elem_c = parse_tensor_elem_code(q_tensor_name as int)
                let shape_v = parse_tensor_shape(q_tensor_name)
                node.name2 = format_quantized_uniform_type(elem_c, q_bits, shape_v)
            else
                node.name2 = fat_str_new("QuantizedTensor")
            end
            pass6_walk(symbols, scopes, diag, q_value)
            pass6_walk(symbols, scopes, diag, q_bits_expr)
        end
        out 0
    end

    # String Interpolation Type Check & Node Binding
    if node.node_type == AstType.InterpExpr do
        child_count = vec_len_rt(node.children)
        var i = 0
        when i < child_count loop
            child = vec_get_rt(node.children, i)
            pass6_walk(symbols, scopes, diag, child)
            if child.node_type != AstType.LiteralStr do
                ct = pass6_infer_interp_type(symbols, scopes, child)
                # Preserve call/method builtin_id metadata. int_val is unused on
                # non-literal interpolation children and carries the checked
                # TypeKind across the semantic arena into AST-to-MIR.
                child.int_val = ct as int
                # Spec §12 defines string, integer, bool and none formatting.
                # Other representations must be rejected rather than passed to
                # str_cat as raw pointers. Float formatting has no Spec contract.
                if ct != TypeKind.String and ct != TypeKind.Int and ct != TypeKind.Bool and ct != TypeKind.None do
                    report_error(diag, 3001, child.line, 0)
                end
            end
            i = i + 1
        end
        out 0
    end

    # Spec §10.1: postfix percent accepts exactly one numeric operand and
    # always produces Float. Keep this separate from binary `mod` checking.
    if node.node_type == AstType.PercentExpr do
        percent_child_count = vec_len_rt(node.children)
        if percent_child_count != 1 do
            report_error(diag, 3002, node.line, 0)
        else
            percent_value = vec_get_rt(node.children, 0)
            percent_type = pass6_infer_type(symbols, scopes, percent_value)
            if percent_type != TypeKind.Void and percent_type != TypeKind.Int and percent_type != TypeKind.Float do
                report_error(diag, 3002, node.line, 0)
            end
            pass6_walk(symbols, scopes, diag, percent_value)
        end
        out 0
    end

    # 1. Binary Operator Type Check
    if node.node_type == AstType.BinOp do
        child_count = vec_len_rt(node.children)
        if child_count >= 2 do
            left = vec_get_rt(node.children, 0)
            right = vec_get_rt(node.children, 1)
            lt = pass6_infer_type(symbols, scopes, left)
            rt_type = pass6_infer_type(symbols, scopes, right)
            if node.op == OpType.PowOp do
                var (exp_known, exp_value) = pass6_eval_const_int(symbols, scopes, right, 0)
                if exp_known == 1 and exp_value < 0 do
                    # Mark this power expression as floating-result lowering.
                    node.int_val = 1
                end
            end
            if lt != TypeKind.Void and rt_type != TypeKind.Void do
                # String concatenation rules (`+` only).
                if node.op == OpType.Add do
                    if lt == TypeKind.String and rt_type != TypeKind.String and pass6_is_integer_like(rt_type as i64) == 0 do
                        report_error(diag, 3001, node.line, 0)
                    eif lt != TypeKind.String and rt_type == TypeKind.String and pass6_is_integer_like(lt as i64) == 0 do
                        report_error(diag, 3001, node.line, 0)
                    end
                else
                    if lt == TypeKind.String or rt_type == TypeKind.String do
                        report_error(diag, 3001, node.line, 0)
                    end
                end
                # Bool arithmetic prohibition (allow logical & comparison ops).
                # Vir bool is 0/1 at runtime — allow arithmetic with integer-like other side.
                if lt == TypeKind.Bool or rt_type == TypeKind.Bool do
                    if node.op != OpType.Eq and node.op != OpType.Ne and node.op != OpType.Land and node.op != OpType.Lor and node.op != OpType.AndOp and node.op != OpType.OrOp and node.op != OpType.XorOp do
                        other = rt_type
                        if lt == TypeKind.Bool do
                            other = rt_type
                        else
                            other = lt
                        end
                        if pass6_is_integer_like(other) == 0 do
                            report_error(diag, 3002, node.line, 0)
                        end
                    end
                end
                # Bitwise shifts require integers.  And/Or/Xor are also used as
                # boolean logical ops — allow Int×Int or Bool×Bool; Enum~Int OK.
                if node.op == OpType.ShlOp or node.op == OpType.ShrOp do
                    if pass6_is_integer_like(lt) == 0 or pass6_is_integer_like(rt_type) == 0 do
                        report_error(diag, 3006, node.line, 0)
                    end
                end
                if node.op == OpType.AndOp or node.op == OpType.OrOp or node.op == OpType.XorOp or node.op == OpType.Land or node.op == OpType.Lor do
                    if pass6_is_logic_bit_operand(lt) == 0 or pass6_is_logic_bit_operand(rt_type) == 0 do
                        report_error(diag, 3006, node.line, 0)
                    end
                end
                if node.op == OpType.MatMulOp or node.op == OpType.FmaOp do
                    var is_q_a = false
                    var is_q_b = false
                    if lt == TypeKind.QuantizedTensor do is_q_a = true end
                    if rt_type == TypeKind.QuantizedTensor do is_q_b = true end

                    var type_a_str = fat_str_new("")
                    var type_b_str = fat_str_new("")
                    if left.node_type == AstType.Identifier do
                        found_a = pass6_lookup_chain(symbols, scopes, scope_current_id(scopes), left.name)
                        if found_a != -1 do
                            sym_a = pass6_symbol_at(symbols, found_a)
                            if sym_a.ast_id != 0 do
                                ast_a = sym_a.ast_id as AstNode
                                type_a_str = ast_a.name2
                            end
                        end
                        if fat_str_len(type_a_str) == 0 do
                            type_a_str = pass6_get_var_type(left.name)
                        end
                    eif left.node_type == AstType.QuantizeExpr do
                        type_a_str = left.name2
                    end
                    if is_quantized_type_str(type_a_str as int) do is_q_a = true end

                    if right.node_type == AstType.Identifier do
                        found_b = pass6_lookup_chain(symbols, scopes, scope_current_id(scopes), right.name)
                        if found_b != -1 do
                            sym_b = pass6_symbol_at(symbols, found_b)
                            if sym_b.ast_id != 0 do
                                ast_b = sym_b.ast_id as AstNode
                                type_b_str = ast_b.name2
                            end
                        end
                        if fat_str_len(type_b_str) == 0 do
                            type_b_str = pass6_get_var_type(right.name)
                        end
                    eif right.node_type == AstType.QuantizeExpr do
                        type_b_str = right.name2
                    end
                    if is_quantized_type_str(type_b_str as int) do is_q_b = true end

                    if is_q_a or is_q_b do
                        if g_pass6_ai_mode != 1 do
                            report_error(diag, 3023, node.line, 0)
                        end
                    end

                    if lt != TypeKind.Void and lt != TypeKind.Tensor and lt != TypeKind.QuantizedTensor do
                        report_error(diag, 3002, node.line, 0)
                    end
                    if rt_type != TypeKind.Void and rt_type != TypeKind.Tensor and rt_type != TypeKind.QuantizedTensor do
                        report_error(diag, 3002, node.line, 0)
                    end
                    let a_is_valid = is_tensor_type_str(type_a_str) or is_quantized_type_str(type_a_str as int)
                    let b_is_valid = is_tensor_type_str(type_b_str) or is_quantized_type_str(type_b_str as int)
                    if not a_is_valid or not b_is_valid do
                        # Matmul/FMA dimensions must be known statically.  Do not
                        # let lowering invent the historical 2x2 fallback.
                        report_error(diag, 3014, node.line, 0)
                    else
                        var shape_a = 0
                        var elem_a = TypeKind.Float
                        var rank_a = 0
                        if is_quantized_type_str(type_a_str as int) do
                            shape_a = parse_quantized_shape(type_a_str as int)
                            elem_a = parse_quantized_elem_type(type_a_str as int)
                            rank_a = parse_quantized_rank(type_a_str as int)
                        else
                            shape_a = parse_tensor_shape(type_a_str)
                            elem_a = parse_tensor_elem_type(type_a_str)
                            rank_a = vec_len_rt(shape_a)
                        end

                        var shape_b = 0
                        var elem_b = TypeKind.Float
                        var rank_b = 0
                        if is_quantized_type_str(type_b_str as int) do
                            shape_b = parse_quantized_shape(type_b_str as int)
                            elem_b = parse_quantized_elem_type(type_b_str as int)
                            rank_b = parse_quantized_rank(type_b_str as int)
                        else
                            shape_b = parse_tensor_shape(type_b_str)
                            elem_b = parse_tensor_elem_type(type_b_str)
                            rank_b = vec_len_rt(shape_b)
                        end

                        if elem_a != elem_b do
                            pass6_report_type_mismatch(diag, symbols, scopes, node, right, pass6_type_kind_to_str(elem_a), pass6_type_kind_to_str(elem_b))
                        end
                        if rank_a != 2 or rank_b != 2 do
                            report_error(diag, 3014, node.line, 0)
                        else
                            k_a = vec_get_rt(shape_a, 1) as i64
                            k_b = vec_get_rt(shape_b, 0) as i64
                            if k_a != k_b do
                                report_error(diag, 3014, node.line, 0)
                            end
                        end
                    end
                end
                # Flux arithmetic width and element type compatibility check [E3001]
                var type_f_a = fat_str_new("")
                var type_f_b = fat_str_new("")
                if left.node_type == AstType.Identifier do
                    let found_fa = pass6_lookup_chain(symbols, scopes, scope_current_id(scopes), left.name)
                    if found_fa != -1 do
                        let sym_fa = pass6_symbol_at(symbols, found_fa)
                        if sym_fa.ast_id != 0 do
                            let ast_fa = sym_fa.ast_id as AstNode
                            type_f_a = ast_fa.name2
                        end
                    end
                eif left.node_type == AstType.Call and fat_cstr_eq(left.name, "flux") do
                    var fa_elem = fat_str_new("int")
                    if vec_len_rt(left.children) > 0 do
                        let ch0 = vec_get_rt(left.children, 0) as AstNode
                        if ch0.node_type == AstType.LiteralFloat do fa_elem = fat_str_new("float") end
                    end
                    type_f_a = fat_str_concat(fat_str_new("flux of ("), fat_str_concat(fa_elem, fat_str_concat(fat_str_new(", "), fat_str_concat(fat_str_new(rt_itoa(vec_len_rt(left.children))), fat_str_new(")")))))
                end
                if right.node_type == AstType.Identifier do
                    let found_fb = pass6_lookup_chain(symbols, scopes, scope_current_id(scopes), right.name)
                    if found_fb != -1 do
                        let sym_fb = pass6_symbol_at(symbols, found_fb)
                        if sym_fb.ast_id != 0 do
                            let ast_fb = sym_fb.ast_id as AstNode
                            type_f_b = ast_fb.name2
                        end
                    end
                eif right.node_type == AstType.Call and fat_cstr_eq(right.name, "flux") do
                    var fb_elem = fat_str_new("int")
                    if vec_len_rt(right.children) > 0 do
                        let ch1 = vec_get_rt(right.children, 0) as AstNode
                        if ch1.node_type == AstType.LiteralFloat do fb_elem = fat_str_new("float") end
                    end
                    type_f_b = fat_str_concat(fat_str_new("flux of ("), fat_str_concat(fb_elem, fat_str_concat(fat_str_new(", "), fat_str_concat(fat_str_new(rt_itoa(vec_len_rt(right.children))), fat_str_new(")")))))
                end
                if is_flux_type_str(type_f_a as int) and is_flux_type_str(type_f_b as int) do
                    let lanes_a = parse_flux_lanes(type_f_a as int)
                    let lanes_b = parse_flux_lanes(type_f_b as int)
                    let elem_fa = parse_flux_elem_type(type_f_a as int) as int
                    let elem_fb = parse_flux_elem_type(type_f_b as int) as int
                    if lanes_a > 0 and lanes_b > 0 and lanes_a != lanes_b do
                        report_error(diag, 3001, node.line, 0)
                    end
                    if elem_fa != elem_fb do
                        report_error(diag, 3001, node.line, 0)
                    end
                eif is_flux_type_str(type_f_a as int) and not is_flux_type_str(type_f_b as int) do
                    let elem_fa = parse_flux_elem_type(type_f_a as int) as int
                    let r_elem = pass6_infer_type(symbols, scopes, right)
                    if (elem_fa == (TypeKind.Int as int) and r_elem == TypeKind.Float) or (elem_fa == (TypeKind.Float as int) and r_elem == TypeKind.Int) do
                        report_error(diag, 3001, node.line, 0)
                    end
                eif not is_flux_type_str(type_f_a as int) and is_flux_type_str(type_f_b as int) do
                    let elem_fb = parse_flux_elem_type(type_f_b as int) as int
                    let l_elem = pass6_infer_type(symbols, scopes, left)
                    if (elem_fb == (TypeKind.Int as int) and l_elem == TypeKind.Float) or (elem_fb == (TypeKind.Float as int) and l_elem == TypeKind.Int) do
                        report_error(diag, 3001, node.line, 0)
                    end
                end
            end
        end
        child_count2 = vec_len_rt(node.children)
        var i = 0
        when i < child_count2 loop
            child = vec_get_rt(node.children, i)
            pass6_walk(symbols, scopes, diag, child)
            i = i + 1
        end
        out 0
    end

    # 2. Assignment & L-Value Check
    # Parser shape: Assign.name = LHS ident; children[0] = RHS (not lhs child).
    if node.node_type == AstType.Assign do
        out pass6WalkAssign(symbols, scopes, diag, node)
    end

    if node.node_type == AstType.SwizzleAssign do
        child_count = vec_len_rt(node.children)
        if fat_str_len(node.name) > 0 do
            found = pass6_lookup_chain(symbols, scopes, scope_current_id(scopes), node.name)
            if found == -1 do
                report_error(diag, 2001, node.line, 0)
            else
                sym = pass6_symbol_at(symbols, found)
                if not sym.is_mutable do
                    report_error(diag, 3003, node.line, 0)
                end
                var target_w = 4
                if sym.ast_id != 0 do
                    var d_ast = sym.ast_id as AstNode
                    if fat_str_len(d_ast.name2) > 0 and is_flux_type_str(d_ast.name2 as int) do
                        target_w = parse_flux_lanes(d_ast.name2 as int)
                    end
                end
                var m_len = fat_str_len(node.name2)
                var has_duplicate = false
                var seen_mask = 0
                var m_idx = 0
                when m_idx < m_len loop
                    var ch_i = fat_str_byte_at(node.name2 as int, m_idx)
                    var l_i = swizzle_char_to_lane(ch_i)
                    if l_i >= target_w or l_i < 0 do
                        report_error(diag, 3089, node.line, 0)
                    else
                        var bit = 1 shl l_i
                        if (seen_mask and bit) != 0 do
                            has_duplicate = true
                        end
                        seen_mask = seen_mask or bit
                    end
                    m_idx = m_idx + 1
                end
                if has_duplicate do
                    report_error(diag, 3087, node.line, 0)
                end
                if child_count >= 1 do
                    var rhs_n = vec_get_rt(node.children, 0) as AstNode
                    var rhs_w = 0
                    if rhs_n.node_type == AstType.Call and fat_cstr_eq(rhs_n.name, "flux") do
                        rhs_w = vec_len_rt(rhs_n.children)
                    eif rhs_n.node_type == AstType.SwizzleExpr do
                        rhs_w = fat_str_len(rhs_n.name)
                    eif rhs_n.node_type == AstType.Identifier do
                        var r_found = pass6_lookup_chain(symbols, scopes, scope_current_id(scopes), rhs_n.name)
                        if r_found != -1 do
                            var r_sym = pass6_symbol_at(symbols, r_found)
                            if r_sym.ast_id != 0 do
                                var rd_ast = r_sym.ast_id as AstNode
                                if fat_str_len(rd_ast.name2) > 0 and is_flux_type_str(rd_ast.name2 as int) do
                                    rhs_w = parse_flux_lanes(rd_ast.name2 as int)
                                end
                            end
                        end
                    eif rhs_n.node_type == AstType.ArrayLiteral do
                        rhs_w = vec_len_rt(rhs_n.children)
                    end
                    if rhs_w > 0 and rhs_w != m_len do
                        report_error(diag, 3088, node.line, 0)
                    end
                end
            end
        end
        var ci = 0
        when ci < child_count loop
            pass6_walk(symbols, scopes, diag, vec_get_rt(node.children, ci) as AstNode)
            ci = ci + 1
        end
        out 0
    end

    if node.node_type == AstType.SwizzleExpr do
        child_count = vec_len_rt(node.children)
        var recv_w = 4
        if child_count > 0 do
            var rec_n = vec_get_rt(node.children, 0) as AstNode
            if rec_n.node_type == AstType.Identifier do
                var r_f = pass6_lookup_chain(symbols, scopes, scope_current_id(scopes), rec_n.name)
                if r_f != -1 do
                    var r_s = pass6_symbol_at(symbols, r_f)
                    if r_s.ast_id != 0 do
                        var rd = r_s.ast_id as AstNode
                        if fat_str_len(rd.name2) > 0 and is_flux_type_str(rd.name2 as int) do
                            recv_w = parse_flux_lanes(rd.name2 as int)
                        end
                    end
                end
            eif rec_n.node_type == AstType.Call and fat_cstr_eq(rec_n.name, "flux") do
                recv_w = vec_len_rt(rec_n.children)
            eif rec_n.node_type == AstType.SwizzleExpr do
                recv_w = fat_str_len(rec_n.name)
            end
        end
        var sw_l = fat_str_len(node.name)
        var sw_k = 0
        when sw_k < sw_l loop
            var sc = fat_str_byte_at(node.name as int, sw_k)
            var l_idx = swizzle_char_to_lane(sc)
            if l_idx >= recv_w or l_idx < 0 do
                report_error(diag, 3089, node.line, 0)
            end
            sw_k = sw_k + 1
        end
        var si = 0
        when si < child_count loop
            pass6_walk(symbols, scopes, diag, vec_get_rt(node.children, si) as AstNode)
            si = si + 1
        end
        out 0
    end

    if node.node_type == AstType.EnumDef do
        pass6_check_enum_def(diag, node)
        out 0
    end

    if node.node_type == AstType.CaseExpr do
        pass6_check_case_expr(symbols, scopes, diag, node)
        out 0
    end

    if node.node_type == AstType.CastExpr do
        if pass6_is_valid_type(symbols, scopes, node.name) == false do
            pass6_report_type_mismatch(diag, symbols, scopes, node, node, node.name, "unknown")
        end
    end

    if node.node_type == AstType.Compare do
        child_count_cmp = vec_len_rt(node.children)
        if child_count_cmp >= 2 do
            left_cmp = vec_get_rt(node.children, 0) as AstNode
            right_cmp = vec_get_rt(node.children, 1) as AstNode
            left_type_str = pass6_get_receiver_entity_name(symbols, scopes, left_cmp)
            right_type_str = pass6_get_receiver_entity_name(symbols, scopes, right_cmp)
            left_enum = pass6_find_enum_ast(symbols, scopes, left_type_str)
            right_enum = pass6_find_enum_ast(symbols, scopes, right_type_str)
            if pass6_enum_is_tagged(left_enum) or pass6_enum_is_tagged(right_enum) do
                report_error(diag, 3043, node.line, 0)
            end
        end
    end

    # 3. Call Resolution & Argument Count Check
    if node.node_type == AstType.EnumConstruct do
        child_count = vec_len_rt(node.children)
        arg_start = 0
        arg_count = child_count
        if child_count == node.builtin_id + 1 do
            receiver = vec_get_rt(node.children, 0) as AstNode
            if receiver.node_type == AstType.Identifier and fat_str_eq(receiver.name, node.name2) == 1 do
                arg_start = 1
                arg_count = arg_count - 1
            end
        end
        if node.builtin_id != arg_count do
            report_error(diag, 3031, node.line, 0)
        end
        var vi = arg_start
        when vi < child_count loop
            pass6_walk(symbols, scopes, diag, vec_get_rt(node.children, vi))
            vi = vi + 1
        end
        out 0
    end

    if node.node_type == AstType.Call do
        out pass6WalkCall(symbols, scopes, diag, node)
    end

    # A dict literal has one key type inferred from its first pair. Reject
    # mixed-key literals before lowering can compare incompatible bit patterns.
    if node.node_type == AstType.DictLiteral do
        key_type = pass6_dict_literal_key_type(symbols, scopes, node)
        child_count = vec_len_rt(node.children)
        var ki = 2
        when ki < child_count loop
            key_node = vec_get_rt(node.children, ki) as AstNode
            given_type = pass6_dict_key_expr_type(symbols, scopes, key_node)
            if key_type != TypeKind.Void and given_type != TypeKind.Void and given_type != key_type do
                pass6_report_type_mismatch(diag, symbols, scopes, node, key_node, pass6_type_kind_to_str(key_type), pass6_type_kind_to_str(given_type))
            end
            ki = ki + 2
        end
        var ci = 0
        when ci < child_count loop
            pass6_walk(symbols, scopes, diag, vec_get_rt(node.children, ci) as AstNode)
            ci = ci + 1
        end
        out 0
    end

    # 4. Index Access Check (Index must be Int, rank matching for tensor)
    if node.node_type == AstType.IndexAccess or node.node_type == AstType.ExprIndex do
        child_count = vec_len_rt(node.children)
        var start_idx = 0
        var is_tensor_base = false
        var expected_rank = 0
        var is_quantized = false
        var is_dict_base = false
        var dict_key_type = TypeKind.Void
        if node.node_type == AstType.IndexAccess do
            var q_vty = pass6_get_var_type(node.name)
            if fat_cstr_eq(q_vty, "QuantizedTensor") == 1 or is_quantized_type_str(q_vty as int) do
                is_quantized = true
                if is_quantized_type_str(q_vty as int) do
                    expected_rank = parse_quantized_rank(q_vty as int)
                    is_tensor_base = true
                end
            end
            if fat_cstr_eq(q_vty, "dict") == 1 do
                is_dict_base = true
                dict_key_type = pass6_dict_var_key_type(symbols, scopes, node.name)
            end
            start_idx = 0
            found_base = pass6_lookup_chain(symbols, scopes, scope_current_id(scopes), node.name)
            if found_base != -1 do
                sym_base = pass6_symbol_at(symbols, found_base)
                if (sym_base.type_id as TypeKind) == TypeKind.Tensor do
                    is_tensor_base = true
                    if sym_base.ast_id != 0 do
                        base_ast = sym_base.ast_id as AstNode
                        if is_tensor_type_str(base_ast.name2) do
                            expected_rank = parse_tensor_rank(base_ast.name2)
                        end
                    end
                end
            end
        else
            start_idx = 1
            if child_count > 0 do
                base_expr = vec_get_rt(node.children, 0)
                if base_expr.node_type == AstType.Identifier do
                    var q_vty2 = pass6_get_var_type(base_expr.name)
                    if fat_cstr_eq(q_vty2, "QuantizedTensor") == 1 or is_quantized_type_str(q_vty2 as int) do
                        is_quantized = true
                        if is_quantized_type_str(q_vty2 as int) do
                            expected_rank = parse_quantized_rank(q_vty2 as int)
                            is_tensor_base = true
                        end
                    end
                    if fat_cstr_eq(q_vty2, "dict") == 1 do
                        is_dict_base = true
                        dict_key_type = pass6_dict_var_key_type(symbols, scopes, base_expr.name)
                    end
                end
                base_ty = pass6_infer_type(symbols, scopes, base_expr)
                if base_ty == TypeKind.Tensor do
                    is_tensor_base = true
                    if base_expr.node_type == AstType.Identifier do
                        found_expr_base = pass6_lookup_chain(symbols, scopes, scope_current_id(scopes), base_expr.name)
                        if found_expr_base != -1 do
                            expr_sym = pass6_symbol_at(symbols, found_expr_base)
                            if expr_sym.ast_id != 0 do
                                expr_ast = expr_sym.ast_id as AstNode
                                if is_tensor_type_str(expr_ast.name2) do expected_rank = parse_tensor_rank(expr_ast.name2) end
                            end
                        end
                    end
                end
            end
        end
        if is_quantized do
            if g_pass6_ai_mode != 1 do
                report_error(diag, 3023, node.line, 0)
                out 0
            end
        end
        # Check rank if tensor
        if is_tensor_base and expected_rank > 0 do
            given_indices = child_count - start_idx
            if given_indices != expected_rank do
                report_error(diag, 3013, node.line, 0)
            end
        end
        # Check all index expressions are Int
        var ii = start_idx
        when ii < child_count loop
            idx_node = vec_get_rt(node.children, ii)
            idx_type = pass6_dict_key_expr_type(symbols, scopes, idx_node)
            if is_dict_base do
                if dict_key_type != TypeKind.Void and idx_type != TypeKind.Void and idx_type != dict_key_type do
                    pass6_report_type_mismatch(diag, symbols, scopes, node, idx_node, pass6_type_kind_to_str(dict_key_type), pass6_type_kind_to_str(idx_type))
                end
            eif idx_type != TypeKind.Void and idx_type != TypeKind.Int do
                report_error(diag, 3015, node.line, 0)
            end
            ii = ii + 1
        end
        var i = 0
        when i < child_count loop
            child = vec_get_rt(node.children, i)
            pass6_walk(symbols, scopes, diag, child)
            i = i + 1
        end
        out 0
    end

    # 4b. Index Assign Check (Index must be Int, rank matching for tensor)
    if node.node_type == AstType.IndexAssign do
        child_count = vec_len_rt(node.children)
        if child_count >= 2 do
            var is_dict_base = false
            var dict_key_type = TypeKind.Void
            var assign_vty = pass6_get_var_type(node.name)
            if fat_cstr_eq(assign_vty, "dict") == 1 do
                is_dict_base = true
                dict_key_type = pass6_dict_var_key_type(symbols, scopes, node.name)
            end
            found_base = pass6_lookup_chain(symbols, scopes, scope_current_id(scopes), node.name)
            if found_base != -1 do
                sym_base = pass6_symbol_at(symbols, found_base)
                if (sym_base.type_id as TypeKind) == TypeKind.Tensor and sym_base.ast_id != 0 do
                    base_ast = sym_base.ast_id as AstNode
                    if is_tensor_type_str(base_ast.name2) do
                        expected_rank = parse_tensor_rank(base_ast.name2)
                        num_indices = child_count - 1
                        if expected_rank > 0 and num_indices != expected_rank do
                            report_error(diag, 3013, node.line, 0)
                        end
                        value_node = vec_get_rt(node.children, child_count - 1)
                        value_type = pass6_infer_type(symbols, scopes, value_node)
                        elem_type = parse_tensor_elem_type(base_ast.name2)
                        if value_type != TypeKind.Void and value_type != elem_type and not (elem_type == TypeKind.Float and (value_type == TypeKind.Int or pass6_is_integer_like(value_type) == 1)) do
                            pass6_report_type_mismatch(diag, symbols, scopes, node, value_node, pass6_type_kind_to_str(elem_type), pass6_type_kind_to_str(value_type))
                        end
                    end
                end
            end
            var ii = 0
            when ii < child_count - 1 loop
                idx_node = vec_get_rt(node.children, ii)
                idx_type = pass6_dict_key_expr_type(symbols, scopes, idx_node)
                if is_dict_base do
                    if dict_key_type != TypeKind.Void and idx_type != TypeKind.Void and idx_type != dict_key_type do
                        pass6_report_type_mismatch(diag, symbols, scopes, node, idx_node, pass6_type_kind_to_str(dict_key_type), pass6_type_kind_to_str(idx_type))
                    end
                eif idx_type != TypeKind.Void and idx_type != TypeKind.Int do
                    report_error(diag, 3015, node.line, 0)
                end
                ii = ii + 1
            end
            var assigned_val_node = vec_get_rt(node.children, child_count - 1) as AstNode
            var assigned_val_ty = pass6_infer_type(symbols, scopes, assigned_val_node)
            if is_dict_base do
                var expected_dict_val = pass6_dict_var_value_type(symbols, scopes, node.name)
                if expected_dict_val != TypeKind.Void and assigned_val_ty != TypeKind.Void do
                    if pass6_types_compatible(expected_dict_val as i64, assigned_val_ty) == 0 do
                        pass6_report_type_mismatch(diag, symbols, scopes, node, assigned_val_node, pass6_type_kind_to_str(expected_dict_val), pass6_type_kind_to_str(assigned_val_ty))
                    end
                end
            else
                var expected_arr_elem = pass6_array_var_elem_type(symbols, scopes, node.name)
                if expected_arr_elem != TypeKind.Void and assigned_val_ty != TypeKind.Void do
                    if pass6_types_compatible(expected_arr_elem as i64, assigned_val_ty) == 0 do
                        pass6_report_type_mismatch(diag, symbols, scopes, node, assigned_val_node, pass6_type_kind_to_str(expected_arr_elem), pass6_type_kind_to_str(assigned_val_ty))
                    end
                end
            end
        end
        var i = 0
        when i < child_count loop
            child = vec_get_rt(node.children, i)
            pass6_walk(symbols, scopes, diag, child)
            i = i + 1
        end
        out 0
    end
    if node.node_type == AstType.BindAttr do
        if fat_cstr_eq(node.name2, "c") == 1 or fat_cstr_eq(node.name2, "wasm") == 1 or fat_cstr_eq(node.name, "c") == 1 or fat_cstr_eq(node.name, "wasm") == 1 do
            if vec_len_rt(node.children) > 0 do
                fn_child = vec_get_rt(node.children, 0) as AstNode
                if fn_child.node_type == AstType.FuncDef or fn_child.node_type == AstType.ExternFunc do
                    var is_wasm = 0
                    if fat_cstr_eq(node.name2, "wasm") == 1 or fat_cstr_eq(node.name, "wasm") == 1 do
                        is_wasm = 1
                    end
                    var fpi = 0
                    when fpi < vec_len_rt(fn_child.children) loop
                        fp_node = vec_get_rt(fn_child.children, fpi) as AstNode
                        if fp_node.node_type == AstType.ParamDef or fp_node.node_type == AstType.RefParam or fp_node.node_type == AstType.OutParam or fp_node.node_type == AstType.Identifier do
                            if fat_str_len(fp_node.name2) == 0 do
                                if is_wasm == 1 do
                                    report_error_loc(diag, 3095, 0, fn_child.line, 1, "wasm")
                                else
                                    report_error_loc(diag, 3095, 0, fn_child.line, 1, "c")
                                end
                            end
                        end
                        fpi = fpi + 1
                    end
                end
            end
        end
        child_count = vec_len_rt(node.children)
        if child_count > 0 do
            child = vec_get_rt(node.children, 0)
            pass6_walk(symbols, scopes, diag, child)
        end
        out 0
    end

    if node.node_type == AstType.InferBlock do
        old_ai_mode = g_pass6_ai_mode
        if old_ai_mode != 0 do
            report_error(diag, 3016, node.line, 0)
        end
        g_pass6_ai_mode = 1
        child_count = vec_len_rt(node.children)
        var i = 0
        when i < child_count loop
            child = vec_get_rt(node.children, i)
            pass6_walk(symbols, scopes, diag, child)
            i = i + 1
        end
        g_pass6_ai_mode = old_ai_mode
        out 0
    end

    if node.node_type == AstType.TrainBlock do
        old_ai_mode = g_pass6_ai_mode
        if old_ai_mode != 0 do
            report_error(diag, 3016, node.line, 0)
        end
        g_pass6_ai_mode = 2
        child_count = vec_len_rt(node.children)
        var i = 0
        when i < child_count loop
            child = vec_get_rt(node.children, i)
            pass6_walk(symbols, scopes, diag, child)
            i = i + 1
        end
        g_pass6_ai_mode = old_ai_mode
        out 0
    end

    if node.node_type == AstType.ReactiveDecl or node.node_type == AstType.BundleExpr or node.node_type == AstType.ExposeAttr do
        child_count = vec_len_rt(node.children)
        var i = 0
        when i < child_count loop
            child = vec_get_rt(node.children, i)
            pass6_walk(symbols, scopes, diag, child)
            i = i + 1
        end
        out 0
    end

    # 5. FuncDef Scope & Local Parameter Registration
    if node.node_type == AstType.FuncDef do
        var old_cur_gen = g_pass6_current_generic_params
        if node.builtin_id != 0 do
            g_pass6_current_generic_params = node.builtin_id as string
            pass6_check_generic_func_def(symbols, scopes, diag, node)
        else
            g_pass6_current_generic_params = fat_str_new("")
        end
        var old_func_name = g_pass6_current_func_name
        g_pass6_current_func_name = node.name as i64
        var old_cur_ret = g_pass6_current_func_ret_type
        g_pass6_current_func_ret_type = node.name2 as i64
        g_pass6_assigned_vars = vec_new_rt()
        g_pass6_var_names = vec_new_rt()
        g_pass6_var_types = vec_new_rt()
        pass6_scope_enter()
        scope_push(scopes, ScopeKind.Func)
        child_count = vec_len_rt(node.children)
        body_idx = child_count - 1
        if body_idx < 0 do
            body_idx = 0
        end
        var bi = 0
        when bi < child_count loop
            ch = vec_get_rt(node.children, bi)
            if ch.node_type == AstType.Block do
                body_idx = bi
                bi = child_count
            else
                bi = bi + 1
            end
        end
        var i = 0
        when i < body_idx loop
            param = vec_get_rt(node.children, i)
            sid = pass6_register_local(symbols, scopes, param.name, true)
            if g_ideFactsEnabled == 1 do
                if g_pass6_current_entity_name != 0 do
                    ideFactResolve(param as int, sid, scope_current_id(scopes), 1)
                    ideFactType(param as int, pass6_resolve_ffi_type(param.name2) as int)
                end
            end
            if sid != -1 do
                psym = pass6_symbol_at(symbols, sid)
                native_write_i64(psym as i64, 32, param as i64)
                param_kind = pass6_resolve_ffi_type(param.name2)
                if fat_str_len(param.name2) > 0 and is_tensor_type_str(param.name2) do
                    native_write_i64(psym as i64, 16, TypeKind.Tensor as i64)
                eif param_kind != TypeKind.Void do
                    native_write_i64(psym as i64, 16, param_kind as i64)
                else
                    var p_ent = pass6_find_entity_ast(symbols, scopes, pass6_extract_base_name(param.name2))
                    if (p_ent as i64) != 0 do
                        native_write_i64(psym as i64, 16, TypeKind.Entity as i64)
                    eif pass6_is_array_type_str(param.name2) do
                        native_write_i64(psym as i64, 16, TypeKind.Array as i64)
                    eif psym.type_id == 0 do
                        native_write_i64(psym as i64, 16, TypeKind.Int as i64)
                    end
                end
            end
            if fat_str_len(param.name2) > 0 do
                pass6_set_var_type(param.name, param.name2)
            end
            i = i + 1
        end
        var j = body_idx
        when j < child_count loop
            child = vec_get_rt(node.children, j)
            pass6_walk(symbols, scopes, diag, child)
            j = j + 1
        end
        scope_pop(scopes)
        pass6_scope_exit()
        g_pass6_current_func_ret_type = old_cur_ret
        g_pass6_current_generic_params = old_cur_gen
        g_pass6_current_func_name = old_func_name
        out 0
    end

    if node.node_type == AstType.Block do
        pass6_scope_enter()
        scope_push(scopes, ScopeKind.Block)
        if g_ideFactsEnabled == 1 do
            if g_pass6_current_entity_name != 0 do
                ideFactScope(node as int, scope_current_id(scopes))
            end
        end
        child_count = vec_len_rt(node.children)
        var i = 0
        when i < child_count loop
            child = vec_get_rt(node.children, i)
            pass6_walk(symbols, scopes, diag, child)
            i = i + 1
        end
        scope_pop(scopes)
        pass6_scope_exit()
        out 0
    end

    if node.node_type == AstType.MapExpr do
        child_count = vec_len_rt(node.children)
        if child_count > 0 do
            pass6_walk(symbols, scopes, diag, vec_get_rt(node.children, 0))
        end
        pass6_scope_enter()
        scope_push(scopes, ScopeKind.Block)
        if fat_str_len(node.name) > 0 and fat_cstr_eq(node.name, "map") == 0 do
            pass6_register_local(symbols, scopes, node.name, true)
        end
        var mi = 1
        when mi < child_count loop
            pass6_walk(symbols, scopes, diag, vec_get_rt(node.children, mi))
            mi = mi + 1
        end
        scope_pop(scopes)
        pass6_scope_exit()
        out 0
    end

    if node.node_type == AstType.ExternFunc do
        out 0
    end

    if node.node_type == AstType.VarDecl do
        out pass6WalkVarDecl(symbols, scopes, diag, node)
    end

    if node.node_type == AstType.VarDeclGroup do
        child_count = vec_len_rt(node.children)
        var vi = 0
        when vi < child_count loop
            child = vec_get_rt(node.children, vi)
            pass6_walk(symbols, scopes, diag, child)
            vi = vi + 1
        end
        out 0
    end

    if node.node_type == AstType.ConstDecl do
        out pass6WalkConstDecl(symbols, scopes, diag, node)
    end

    # Default recurse
    child_count = vec_len_rt(node.children)
    var i = 0
    when i < child_count loop
        child = vec_get_rt(node.children, i)
        pass6_walk(symbols, scopes, diag, child)
        i = i + 1
    end
    out 0
end.

# Keep the recursive visitor's stack frame small. Declaration/call validation
# has its own locals; ordinary AST depth must not multiply a giant frame.
func pass6_infer_tensor_op_result_type(ref symbols: SymbolTable, ref scopes: ScopeTree, binop: &AstNode) -> string:
    if binop.node_type != AstType.BinOp or (binop.op != OpType.MatMulOp and binop.op != OpType.FmaOp) do
        out fat_str_new("")
    end
    if vec_len_rt(binop.children) < 2 do out fat_str_new("") end
    let left_n = vec_get_rt(binop.children, 0) as AstNode
    let right_n = vec_get_rt(binop.children, 1) as AstNode
    let left_t = pass6_tensor_type_name(symbols, scopes, left_n)
    let right_t = pass6_tensor_type_name(symbols, scopes, right_n)
    if not (is_tensor_type_str(left_t) or is_quantized_type_str(left_t as int)) do out fat_str_new("") end
    if not is_tensor_type_str(right_t) do out fat_str_new("") end
    var shape_a = 0
    if is_quantized_type_str(left_t as int) do
        shape_a = parse_quantized_shape(left_t as int)
    else
        shape_a = parse_tensor_shape(left_t)
    end
    let shape_b = parse_tensor_shape(right_t)
    if vec_len_rt(shape_a) < 2 or vec_len_rt(shape_b) < 2 do out fat_str_new("") end
    let dim_m = vec_get_rt(shape_a, 0) as int
    let dim_n = vec_get_rt(shape_b, 1) as int
    var res_elem = fat_str_new("f32; ")
    if parse_tensor_elem_type(right_t) == TypeKind.Float do
        let r_code = parse_tensor_elem_code(right_t as int)
        if r_code == 7 do res_elem = fat_str_new("f64; ") end
    end
    var res = fat_str_concat(fat_str_new("tensor["), res_elem)
    res = fat_str_concat(res, str_from_cstr(rt_itoa(dim_m) as int))
    res = fat_str_concat(res, fat_str_new(", "))
    res = fat_str_concat(res, str_from_cstr(rt_itoa(dim_n) as int))
    res = fat_str_concat(res, fat_str_new("]"))
    out res
end.

func pass6WalkVarDecl(ref symbols: SymbolTable, ref scopes: ScopeTree, diag: &DiagnosticEngine, node: &AstNode) -> int:
    if node.int_val == 16384 do
        child_count = vec_len_rt(node.children)
        if child_count > 1 do
            let init_node = vec_get_rt(node.children, child_count - 1) as AstNode
            pass6_walk(symbols, scopes, diag, init_node)
            var di = 0
            when di < child_count - 1 loop
                let var_ident = vec_get_rt(node.children, di) as AstNode
                if fat_str_len(var_ident.name) > 0 do
                    let prev_sid = pass6_lookup_chain(symbols, scopes, scope_current_id(scopes), var_ident.name)
                    var prev_ty = 0
                    if prev_sid != -1 do
                        let prev_sym = pass6_symbol_at(symbols, prev_sid)
                        prev_ty = prev_sym.type_id
                    end
                    let v_sid = pass6_register_local(symbols, scopes, var_ident.name, true)
                    if v_sid != -1 do
                        let vsyms_vec = native_read_i64(symbols as i64, 0)
                        let vsym = vec_get_rt(vsyms_vec, v_sid) as SymbolNode
                        native_write_i64(vsym as i64, 32, var_ident as i64)
                        if prev_ty != 0 do
                            native_write_i64(vsym as i64, 16, prev_ty)
                        end
                    end
                end
                di = di + 1
            end
        end
        out 0
    end
    child_count = vec_len_rt(node.children)
    var i = 0
    when i < child_count loop
        child = vec_get_rt(node.children, i)
        pass6_walk(symbols, scopes, diag, child)
        i = i + 1
    end
    sid = pass6_register_local(symbols, scopes, node.name, true)
    if g_ideFactsEnabled == 1 do
        if g_pass6_current_entity_name != 0 do
            ideFactResolve(node as int, sid, scope_current_id(scopes), 1)
        end
    end
    if sid != -1 do
        syms_vec = native_read_i64(symbols as i64, 0)
        sym = vec_get_rt(syms_vec, sid)
        native_write_i64(sym as i64, 32, node as i64)
        if fat_str_len(node.name2) > 0 do
            let c0 = fat_str_byte_at(node.name2, 0)
            if c0 == 38 do
                if fat_str_len(node.name2) > 4 and fat_str_byte_at(node.name2, 1) == 109 and fat_str_byte_at(node.name2, 2) == 117 and fat_str_byte_at(node.name2, 3) == 116 do
                    native_write_i64(sym as i64, 16, TypeKind.MutRef as i64)
                else
                    native_write_i64(sym as i64, 16, TypeKind.Ref as i64)
                end
            else
                var declared_ty = pass6_resolve_ffi_type(node.name2)
                if declared_ty != TypeKind.Void do
                    native_write_i64(sym as i64, 16, declared_ty as i64)
                else
                    var vd_ent = pass6_find_entity_ast(symbols, scopes, pass6_extract_base_name(node.name2))
                    if (vd_ent as i64) != 0 do
                        native_write_i64(sym as i64, 16, TypeKind.Entity as i64)
                    eif pass6_is_array_type_str(node.name2) do
                        native_write_i64(sym as i64, 16, TypeKind.Array as i64)
                    end
                end
            end
        end
        if fat_str_len(node.name2) > 0 and is_tensor_type_str(node.name2) do
            native_write_i64(sym as i64, 16, TypeKind.Tensor as i64)
        eif fat_str_len(node.name2) > 0 and is_flux_type_str(node.name2 as int) do
            native_write_i64(sym as i64, 16, TypeKind.Flux as i64)
            pass6_set_var_type(node.name, node.name2)
            var lanes = parse_flux_lanes(node.name2 as int)
            if flux_is_power_of_two(lanes) == false do
                report_error(diag, 3090, node.line, 0)
            end
            if child_count > 0 do
                var c0 = vec_get_rt(node.children, 0) as AstNode
                if c0.node_type == AstType.Call and fat_cstr_eq(c0.name, "flux") do
                    if vec_len_rt(c0.children) != lanes do
                        report_error(diag, 3001, node.line, 0)
                    end
                end
            end
        eif child_count > 0 do
            child0 = vec_get_rt(node.children, 0)
            g_pass6_visiting_symbols = vec_push_rt(g_pass6_visiting_symbols, sid as i64)
            inferred = pass6_infer_type(symbols, scopes, child0)
            let v_len = vec_len_rt(g_pass6_visiting_symbols)
            if v_len > 0 do
                native_write_i64(g_pass6_visiting_symbols - 8, 0, v_len - 1)
            end
            if inferred != TypeKind.Void do
                var exp_v_ty = fat_str_new("")
                if fat_str_len(node.name2) > 0 do
                    exp_v_ty = node.name2
                else
                    exp_v_ty = pass6_type_kind_to_str(sym.type_id as TypeKind)
                end
                if sym.type_id == TypeKind.Int as i64 and child0.node_type == AstType.LiteralStr do
                    pass6_report_type_mismatch(diag, symbols, scopes, node, child0, exp_v_ty, "string")
                eif sym.type_id == TypeKind.String as i64 and child0.node_type == AstType.LiteralInt do
                    pass6_report_type_mismatch(diag, symbols, scopes, node, child0, exp_v_ty, "int")
                eif sym.type_id == TypeKind.Bool as i64 and (child0.node_type == AstType.LiteralStr or child0.node_type == AstType.LiteralInt) do
                    var act_s = "string"
                    if child0.node_type == AstType.LiteralInt do act_s = "int" end
                    pass6_report_type_mismatch(diag, symbols, scopes, node, child0, exp_v_ty, act_s)
                eif sym.type_id != 0 and pass6_types_compatible(sym.type_id, inferred) == 0 do
                    var allow_vinit = 0
                    if (sym.type_id == TypeKind.Entity as i64 or sym.type_id == TypeKind.Ref as i64 or sym.type_id == TypeKind.MutRef as i64 or sym.type_id == TypeKind.Pointer as i64 or sym.type_id == TypeKind.Optional as i64) and child0.node_type == AstType.LiteralInt and child0.int_val == 0 do
                        allow_vinit = 1
                    end
                    if is_user_module(g_pass6_cur_module) == 0 do
                        if (sym.type_id == TypeKind.Entity as i64 and pass6_is_integer_like(inferred as i64) == 1) or (pass6_is_integer_like(sym.type_id) == 1 and inferred == TypeKind.Entity) do
                            allow_vinit = 1
                        end
                        # System/compiler modules: bool↔int initializer is allowed.
                        if (sym.type_id == TypeKind.Bool as i64 and pass6_is_integer_like(inferred as i64) == 1) or (pass6_is_integer_like(sym.type_id) == 1 and inferred == TypeKind.Bool) do
                            allow_vinit = 1
                        end
                    end
                    if allow_vinit == 0 do
                        pass6_report_type_mismatch(diag, symbols, scopes, node, child0, exp_v_ty, pass6_type_kind_to_str(inferred))
                    end
                end
                if sym.type_id == 0 do
                    native_write_i64(sym as i64, 16, inferred as i64)
                end
            end
        end
    end
    var initializer_type = fat_str_new("")
    if fat_str_len(node.name2) > 0 do
        var vd_base = pass6_extract_base_name(node.name2)
        var vd_ent = pass6_find_entity_ast(symbols, scopes, vd_base)
        if (vd_ent as i64) != 0 do
            if vd_ent.builtin_id != 0 do
                var vd_gen_args = pass6_extract_generic_args_content(node.name2)
                var vd_decl_cnt = count_list_items(vd_ent.builtin_id as string)
                var vd_prov_cnt = 0
                if fat_str_len(vd_gen_args) > 0 do
                    vd_prov_cnt = count_list_items(vd_gen_args)
                end
                if vd_decl_cnt != vd_prov_cnt do
                    report_error(diag, 3085, node.line, 0)
                end
            end
        end
    end
    if child_count > 0 do
        child0 = vec_get_rt(node.children, 0)
        if fat_str_len(node.name2) > 0 do
            var v_ent = pass6_find_entity_ast(symbols, scopes, pass6_extract_base_name(node.name2))
            if (v_ent as i64) != 0 do
                if child0.node_type == AstType.ArrayLiteral do
                    pass6_report_type_mismatch(diag, symbols, scopes, node, child0, node.name2, "")
                eif child0.node_type == AstType.LiteralStr or (child0.node_type == AstType.LiteralInt and child0.int_val != 0) or child0.node_type == AstType.LiteralBool or child0.node_type == AstType.DictLiteral or child0.node_type == AstType.TupleExpr do
                    pass6_report_type_mismatch(diag, symbols, scopes, node, child0, node.name2, "")
                eif child0.node_type == AstType.LiteralInt and child0.int_val == 0 do
                    # 0 is null pointer/entity reference
                else
                    var init_str = pass6_get_expr_type_str(symbols, scopes, child0)
                    if fat_str_len(init_str) > 0 do
                        if pass6_is_array_type_str(init_str) do
                            pass6_report_type_mismatch(diag, symbols, scopes, node, child0, node.name2, init_str)
                        else
                            var v_a_ent = pass6_find_entity_ast(symbols, scopes, pass6_extract_base_name(init_str))
                            if (v_a_ent as i64) != 0 do
                                if pass6_type_strings_compatible(symbols, scopes, node.name2, init_str) == 0 do
                                    pass6_report_type_mismatch(diag, symbols, scopes, node, child0, node.name2, init_str)
                                end
                            end
                        end
                    end
                end
            eif pass6_is_array_type_str(node.name2) do
                if child0.node_type == AstType.EntityLiteral do
                    pass6_report_type_mismatch(diag, symbols, scopes, node, child0, node.name2, "")
                eif child0.node_type == AstType.LiteralStr or child0.node_type == AstType.LiteralInt or child0.node_type == AstType.LiteralBool or child0.node_type == AstType.DictLiteral or child0.node_type == AstType.TupleExpr do
                    pass6_report_type_mismatch(diag, symbols, scopes, node, child0, node.name2, "")
                else
                    var init_arr_str = pass6_get_expr_type_str(symbols, scopes, child0)
                    if fat_str_len(init_arr_str) > 0 do
                        var v_a_ent2 = pass6_find_entity_ast(symbols, scopes, pass6_extract_base_name(init_arr_str))
                        if (v_a_ent2 as i64) != 0 do
                            pass6_report_type_mismatch(diag, symbols, scopes, node, child0, node.name2, init_arr_str)
                        eif pass6_type_strings_compatible(symbols, scopes, node.name2, init_arr_str) == 0 do
                            pass6_report_type_mismatch(diag, symbols, scopes, node, child0, node.name2, init_arr_str)
                        end
                    end
                end
            end
        end
        if child0.node_type == AstType.Call do
            if fat_str_len(child0.name2) > 0 do
                if fat_str_len(node.name2) > 0 do
                    var call_fn = pass6_find_free_function(child0.name)
                    if (call_fn as i64) != 0 do
                        if call_fn.builtin_id != 0 do
                            var spec_ret = pass6_substitute_generic_type(call_fn.builtin_id as string, child0.name2, call_fn.name2)
                            if fat_str_len(spec_ret) > 0 do
                                if fat_str_eq(spec_ret, node.name2) == 0 do
                                    report_error(diag, 3084, child0.line, 0)
                                end
                            end
                        end
                    end
                end
            end
        end
        pass6_check_enum_generic_arg(symbols, scopes, diag, node.name2, child0)
        initializer_type = pass6_get_receiver_entity_name(symbols, scopes, child0)
        if child0.node_type == AstType.AddrOf and vec_len_rt(child0.children) > 0 do
            var addr_target_ent = pass6_get_receiver_entity_name(symbols, scopes, vec_get_rt(child0.children, 0) as AstNode)
            if fat_str_len(addr_target_ent) > 0 do
                var mut_prefix = fat_str_new("&")
                if fat_cstr_eq(child0.name, "mut") == 1 or child0.int_val == 1 do
                    mut_prefix = fat_str_new("&mut ")
                end
                initializer_type = fat_str_concat(mut_prefix, addr_target_ent)
            end
        end
        if child0.node_type == AstType.QuantizeExpr do
            if fat_str_len(child0.name2) > 0 do
                initializer_type = child0.name2
            else
                initializer_type = g_pass6_quantized_tensor_type as string
            end
        end
        if child0.node_type == AstType.Call and (fat_cstr_eq(child0.name, "q80CreateView") == 1 or is_quantized_type_str(child0.name2 as int)) do
            if is_quantized_type_str(child0.name2 as int) do
                initializer_type = child0.name2
            end
        end
        if child0.node_type == AstType.BinOp and (child0.op == OpType.MatMulOp or child0.op == OpType.FmaOp) do
            var inf_t = pass6_infer_tensor_op_result_type(symbols, scopes, child0)
            if fat_str_len(inf_t) > 0 do
                initializer_type = inf_t
            end
        end
        if child0.node_type == AstType.DictLiteral do
            initializer_type = fat_str_new("dict")
        end
    end
    if fat_str_len(node.name2) == 0 and fat_str_len(initializer_type) > 0 do
        node.name2 = initializer_type
        pass6_set_var_type(node.name, initializer_type)
    eif fat_str_len(node.name2) > 0 do
        pass6_set_var_type(node.name, node.name2)
    end
    if g_pass6_ai_mode == 1 do
        g_pass6_infer_values = vec_push_rt(g_pass6_infer_values, node.name)
    eif g_pass6_ai_mode == 2 do
        g_pass6_train_values = vec_push_rt(g_pass6_train_values, node.name)
    end
    out 0
end.

func pass6WalkConstDecl(ref symbols: SymbolTable, ref scopes: ScopeTree, diag: &DiagnosticEngine, node: &AstNode) -> int:
    child_count = vec_len_rt(node.children)
    var i = 0
    when i < child_count loop
        child = vec_get_rt(node.children, i)
        pass6_walk(symbols, scopes, diag, child)
        i = i + 1
    end
    sid = pass6_register_local(symbols, scopes, node.name, false)
    if g_ideFactsEnabled == 1 do
        if g_pass6_current_entity_name != 0 do
            ideFactResolve(node as int, sid, scope_current_id(scopes), 1)
        end
    end
    if sid != -1 do
        syms_vec = native_read_i64(symbols as i64, 0)
        sym = vec_get_rt(syms_vec, sid)
        native_write_i64(sym as i64, 32, node as i64)
        if fat_str_len(node.name2) > 0 do
            let c0 = fat_str_byte_at(node.name2, 0)
            if c0 == 38 do
                if fat_str_len(node.name2) > 4 and fat_str_byte_at(node.name2, 1) == 109 and fat_str_byte_at(node.name2, 2) == 117 and fat_str_byte_at(node.name2, 3) == 116 do
                    native_write_i64(sym as i64, 16, TypeKind.MutRef as i64)
                else
                    native_write_i64(sym as i64, 16, TypeKind.Ref as i64)
                end
            else
                var declared_ty = pass6_resolve_ffi_type(node.name2)
                if declared_ty != TypeKind.Void do
                    native_write_i64(sym as i64, 16, declared_ty as i64)
                else
                    var cd_ent_decl = pass6_find_entity_ast(symbols, scopes, pass6_extract_base_name(node.name2))
                    if (cd_ent_decl as i64) != 0 do
                        native_write_i64(sym as i64, 16, TypeKind.Entity as i64)
                    eif pass6_is_array_type_str(node.name2) do
                        native_write_i64(sym as i64, 16, TypeKind.Array as i64)
                    end
                end
            end
        end
        if fat_str_len(node.name2) > 0 and is_tensor_type_str(node.name2) do
            native_write_i64(sym as i64, 16, TypeKind.Tensor as i64)
        eif fat_str_len(node.name2) > 0 and is_flux_type_str(node.name2 as int) do
            native_write_i64(sym as i64, 16, TypeKind.Flux as i64)
            pass6_set_var_type(node.name, node.name2)
            var lanes = parse_flux_lanes(node.name2 as int)
            if flux_is_power_of_two(lanes) == false do
                report_error(diag, 3090, node.line, 0)
            end
            if child_count > 0 do
                var c0 = vec_get_rt(node.children, 0) as AstNode
                if c0.node_type == AstType.Call and fat_cstr_eq(c0.name, "flux") do
                    if vec_len_rt(c0.children) != lanes do
                        report_error(diag, 3001, node.line, 0)
                    end
                end
            end
        eif child_count > 0 do
            child0 = vec_get_rt(node.children, 0)
            g_pass6_visiting_symbols = vec_push_rt(g_pass6_visiting_symbols, sid as i64)
            inferred = pass6_infer_type(symbols, scopes, child0)
            let v_len = vec_len_rt(g_pass6_visiting_symbols)
            if v_len > 0 do
                native_write_i64(g_pass6_visiting_symbols - 8, 0, v_len - 1)
            end
            if inferred != TypeKind.Void do
                var exp_c_ty = fat_str_new("")
                if fat_str_len(node.name2) > 0 do
                    exp_c_ty = node.name2
                else
                    exp_c_ty = pass6_type_kind_to_str(sym.type_id as TypeKind)
                end
                if sym.type_id == TypeKind.Int as i64 and child0.node_type == AstType.LiteralStr do
                    pass6_report_type_mismatch(diag, symbols, scopes, node, child0, exp_c_ty, "string")
                eif sym.type_id == TypeKind.String as i64 and child0.node_type == AstType.LiteralInt do
                    pass6_report_type_mismatch(diag, symbols, scopes, node, child0, exp_c_ty, "int")
                eif sym.type_id == TypeKind.Bool as i64 and (child0.node_type == AstType.LiteralStr or child0.node_type == AstType.LiteralInt) do
                    var act_cs = "string"
                    if child0.node_type == AstType.LiteralInt do act_cs = "int" end
                    pass6_report_type_mismatch(diag, symbols, scopes, node, child0, exp_c_ty, act_cs)
                eif sym.type_id != 0 and pass6_types_compatible(sym.type_id, inferred) == 0 do
                    var allow_cinit = 0
                    if (sym.type_id == TypeKind.Entity as i64 or sym.type_id == TypeKind.Ref as i64 or sym.type_id == TypeKind.MutRef as i64 or sym.type_id == TypeKind.Pointer as i64 or sym.type_id == TypeKind.Optional as i64) and child0.node_type == AstType.LiteralInt and child0.int_val == 0 do
                        allow_cinit = 1
                    end
                    if is_user_module(g_pass6_cur_module) == 0 do
                        if (sym.type_id == TypeKind.Entity as i64 and pass6_is_integer_like(inferred as i64) == 1) or (pass6_is_integer_like(sym.type_id) == 1 and inferred == TypeKind.Entity) do
                            allow_cinit = 1
                        end
                        # System/compiler modules: bool↔int initializer is allowed.
                        if (sym.type_id == TypeKind.Bool as i64 and pass6_is_integer_like(inferred as i64) == 1) or (pass6_is_integer_like(sym.type_id) == 1 and inferred == TypeKind.Bool) do
                            allow_cinit = 1
                        end
                    end
                    if allow_cinit == 0 do
                        pass6_report_type_mismatch(diag, symbols, scopes, node, child0, exp_c_ty, pass6_type_kind_to_str(inferred))
                    end
                end
                if sym.type_id == 0 do
                    native_write_i64(sym as i64, 16, inferred as i64)
                end
            end
        end
    end
    var initializer_type = fat_str_new("")
    if fat_str_len(node.name2) > 0 do
        var cd_base = pass6_extract_base_name(node.name2)
        var cd_ent = pass6_find_entity_ast(symbols, scopes, cd_base)
        if (cd_ent as i64) != 0 do
            if cd_ent.builtin_id != 0 do
                var cd_gen_args = pass6_extract_generic_args_content(node.name2)
                var cd_decl_cnt = count_list_items(cd_ent.builtin_id as string)
                var cd_prov_cnt = 0
                if fat_str_len(cd_gen_args) > 0 do
                    cd_prov_cnt = count_list_items(cd_gen_args)
                end
                if cd_decl_cnt != cd_prov_cnt do
                    report_error(diag, 3085, node.line, 0)
                end
            end
        end
    end
    if child_count > 0 do
        child0 = vec_get_rt(node.children, 0)
        if fat_str_len(node.name2) > 0 do
            var cd_v_ent = pass6_find_entity_ast(symbols, scopes, pass6_extract_base_name(node.name2))
            if (cd_v_ent as i64) != 0 do
                if child0.node_type == AstType.ArrayLiteral do
                    pass6_report_type_mismatch(diag, symbols, scopes, node, child0, node.name2, "")
                eif child0.node_type == AstType.LiteralStr or (child0.node_type == AstType.LiteralInt and child0.int_val != 0) or child0.node_type == AstType.LiteralBool or child0.node_type == AstType.DictLiteral or child0.node_type == AstType.TupleExpr do
                    pass6_report_type_mismatch(diag, symbols, scopes, node, child0, node.name2, "")
                eif child0.node_type == AstType.LiteralInt and child0.int_val == 0 do
                    # 0 is null pointer/entity reference
                else
                    var cd_init_str = pass6_get_expr_type_str(symbols, scopes, child0)
                    if fat_str_len(cd_init_str) > 0 do
                        if pass6_is_array_type_str(cd_init_str) do
                            pass6_report_type_mismatch(diag, symbols, scopes, node, child0, node.name2, cd_init_str)
                        else
                            var cd_a_ent = pass6_find_entity_ast(symbols, scopes, pass6_extract_base_name(cd_init_str))
                            if (cd_a_ent as i64) != 0 do
                                if pass6_type_strings_compatible(symbols, scopes, node.name2, cd_init_str) == 0 do
                                    pass6_report_type_mismatch(diag, symbols, scopes, node, child0, node.name2, cd_init_str)
                                end
                            end
                        end
                    end
                end
            eif pass6_is_array_type_str(node.name2) do
                if child0.node_type == AstType.EntityLiteral do
                    pass6_report_type_mismatch(diag, symbols, scopes, node, child0, node.name2, "")
                eif child0.node_type == AstType.LiteralStr or child0.node_type == AstType.LiteralInt or child0.node_type == AstType.LiteralBool or child0.node_type == AstType.DictLiteral or child0.node_type == AstType.TupleExpr do
                    pass6_report_type_mismatch(diag, symbols, scopes, node, child0, node.name2, "")
                else
                    var cd_init_arr_str = pass6_get_expr_type_str(symbols, scopes, child0)
                    if fat_str_len(cd_init_arr_str) > 0 do
                        var cd_a_ent2 = pass6_find_entity_ast(symbols, scopes, pass6_extract_base_name(cd_init_arr_str))
                        if (cd_a_ent2 as i64) != 0 do
                            pass6_report_type_mismatch(diag, symbols, scopes, node, child0, node.name2, cd_init_arr_str)
                        eif pass6_type_strings_compatible(symbols, scopes, node.name2, cd_init_arr_str) == 0 do
                            pass6_report_type_mismatch(diag, symbols, scopes, node, child0, node.name2, cd_init_arr_str)
                        end
                    end
                end
            end
        end
        if child0.node_type == AstType.Call do
            if fat_str_len(child0.name2) > 0 do
                if fat_str_len(node.name2) > 0 do
                    var cd_call_fn = pass6_find_free_function(child0.name)
                    if (cd_call_fn as i64) != 0 do
                        if cd_call_fn.builtin_id != 0 do
                            var cd_spec_ret = pass6_substitute_generic_type(cd_call_fn.builtin_id as string, child0.name2, cd_call_fn.name2)
                            if fat_str_len(cd_spec_ret) > 0 do
                                if fat_str_eq(cd_spec_ret, node.name2) == 0 do
                                    report_error(diag, 3084, child0.line, 0)
                                end
                            end
                        end
                    end
                end
            end
        end
        pass6_check_enum_generic_arg(symbols, scopes, diag, node.name2, child0)
        initializer_type = pass6_get_receiver_entity_name(symbols, scopes, child0)
        if child0.node_type == AstType.AddrOf and vec_len_rt(child0.children) > 0 do
            var c_addr_target_ent = pass6_get_receiver_entity_name(symbols, scopes, vec_get_rt(child0.children, 0) as AstNode)
            if fat_str_len(c_addr_target_ent) > 0 do
                var c_mut_prefix = fat_str_new("&")
                if fat_cstr_eq(child0.name, "mut") == 1 or child0.int_val == 1 do
                    c_mut_prefix = fat_str_new("&mut ")
                end
                initializer_type = fat_str_concat(c_mut_prefix, c_addr_target_ent)
            end
        end
        if child0.node_type == AstType.QuantizeExpr do
            if fat_str_len(child0.name2) > 0 do
                initializer_type = child0.name2
            else
                initializer_type = g_pass6_quantized_tensor_type as string
            end
        end
        if child0.node_type == AstType.Call and (fat_cstr_eq(child0.name, "q80CreateView") == 1 or is_quantized_type_str(child0.name2 as int)) do
            if is_quantized_type_str(child0.name2 as int) do
                initializer_type = child0.name2
            end
        end
        if child0.node_type == AstType.BinOp and (child0.op == OpType.MatMulOp or child0.op == OpType.FmaOp) do
            var inf_t = pass6_infer_tensor_op_result_type(symbols, scopes, child0)
            if fat_str_len(inf_t) > 0 do
                initializer_type = inf_t
            end
        end
        if child0.node_type == AstType.DictLiteral do
            initializer_type = fat_str_new("dict")
        end
        if child0.node_type == AstType.ArrayLiteral do
            initializer_type = pass6_get_expr_type_str(symbols, scopes, child0)
        end
    end
    if fat_str_len(node.name2) == 0 and fat_str_len(initializer_type) > 0 do
        node.name2 = initializer_type
        pass6_set_var_type(node.name, initializer_type)
    eif fat_str_len(node.name2) > 0 do
        pass6_set_var_type(node.name, node.name2)
    end
    out 0
end.

func pass6WalkAssign(ref symbols: SymbolTable, ref scopes: ScopeTree, diag: &DiagnosticEngine, node: &AstNode) -> int:
    child_count = vec_len_rt(node.children)
    if fat_str_len(node.name) > 0 do
        found = pass6_lookup_chain(symbols, scopes, scope_current_id(scopes), node.name)
        if found == -1 do
            pass6_register_local(symbols, scopes, node.name, true)
            found = pass6_lookup_chain(symbols, scopes, scope_current_id(scopes), node.name)
        end
        if found != -1 do
            sym = pass6_symbol_at(symbols, found)
            if sym.kind != SymbolKind.Variable and sym.kind != SymbolKind.Param do
                pass6_register_local(symbols, scopes, node.name, true)
                found = pass6_lookup_chain(symbols, scopes, scope_current_id(scopes), node.name)
                sym = pass6_symbol_at(symbols, found)
            end
            if not sym.is_mutable do
                report_error(diag, 3003, node.line, 0)
            end
            g_pass6_assigned_vars = vec_push_rt(g_pass6_assigned_vars, node.name)
            if child_count >= 1 do
                rhs = vec_get_rt(node.children, 0)
                rhs_type = pass6_infer_type(symbols, scopes, rhs)
                var assign_vty = pass6_get_var_type(node.name)
                if fat_str_len(assign_vty) == 0 and sym.ast_id != 0 do
                    var d_ast = sym.ast_id as AstNode
                    if fat_str_len(d_ast.name2) > 0 do
                        assign_vty = d_ast.name2
                    end
                end
                var exp_asgn_str = assign_vty
                if fat_str_len(exp_asgn_str) == 0 do
                    exp_asgn_str = pass6_type_kind_to_str(sym.type_id as TypeKind)
                end
                if sym.type_id == TypeKind.Int as i64 and rhs.node_type == AstType.LiteralStr do
                    pass6_report_type_mismatch(diag, symbols, scopes, node, rhs, exp_asgn_str, "string")
                eif sym.type_id == TypeKind.String as i64 and rhs.node_type == AstType.LiteralInt do
                    pass6_report_type_mismatch(diag, symbols, scopes, node, rhs, exp_asgn_str, "int")
                eif sym.type_id != 0 and rhs_type != TypeKind.Void and pass6_types_compatible(sym.type_id, rhs_type) == 0 do
                    var allow_assign = 0
                    if (sym.type_id == TypeKind.Entity as i64 or sym.type_id == TypeKind.Ref as i64 or sym.type_id == TypeKind.MutRef as i64 or sym.type_id == TypeKind.Pointer as i64 or sym.type_id == TypeKind.Optional as i64) and rhs.node_type == AstType.LiteralInt and rhs.int_val == 0 do
                        allow_assign = 1
                    end
                    if (sym.type_id == TypeKind.Int as i64 and rhs_type == TypeKind.String) or (sym.type_id == TypeKind.String as i64 and pass6_is_integer_like(rhs_type as i64) == 1) do
                        allow_assign = 1
                    end
                    if is_user_module(g_pass6_cur_module) == 0 do
                        if (sym.type_id == TypeKind.Entity as i64 and pass6_is_integer_like(rhs_type as i64) == 1) or (pass6_is_integer_like(sym.type_id) == 1 and rhs_type == TypeKind.Entity) do
                            allow_assign = 1
                        end
                        # In system/compiler modules, bool↔int is allowed (legacy
                        # compiler source uses int and bool interchangeably in many
                        # internal helpers). User code still gets strict checking.
                        if (sym.type_id == TypeKind.Bool as i64 and pass6_is_integer_like(rhs_type as i64) == 1) or (pass6_is_integer_like(sym.type_id) == 1 and rhs_type == TypeKind.Bool) do
                            allow_assign = 1
                        end
                    end
                    if allow_assign == 0 do
                        pass6_report_type_mismatch(diag, symbols, scopes, node, rhs, exp_asgn_str, pass6_type_kind_to_str(rhs_type))
                    end
                end
                if sym.type_id == 0 and rhs_type != TypeKind.Void do
                    native_write_i64(sym as i64, 16, rhs_type as i64)
                end
                if fat_str_len(assign_vty) > 0 do
                    var lhs_ent_ast = pass6_find_entity_ast(symbols, scopes, pass6_extract_base_name(assign_vty))
                    if (lhs_ent_ast as i64) != 0 do
                        if rhs.node_type == AstType.ArrayLiteral do
                            pass6_report_type_mismatch(diag, symbols, scopes, node, rhs, assign_vty, "")
                        eif rhs.node_type == AstType.LiteralStr or (rhs.node_type == AstType.LiteralInt and rhs.int_val != 0) or rhs.node_type == AstType.LiteralBool or rhs.node_type == AstType.DictLiteral or rhs.node_type == AstType.TupleExpr do
                            pass6_report_type_mismatch(diag, symbols, scopes, node, rhs, assign_vty, "")
                        eif rhs.node_type == AstType.LiteralInt and rhs.int_val == 0 do
                            # 0 is null pointer/entity reference
                        else
                            var rhs_str = pass6_get_expr_type_str(symbols, scopes, rhs)
                            if fat_str_len(rhs_str) > 0 do
                                if pass6_is_array_type_str(rhs_str) do
                                    pass6_report_type_mismatch(diag, symbols, scopes, node, rhs, assign_vty, rhs_str)
                                else
                                    var a_ent1 = pass6_find_entity_ast(symbols, scopes, pass6_extract_base_name(rhs_str))
                                    if (a_ent1 as i64) != 0 do
                                        if pass6_type_strings_compatible(symbols, scopes, assign_vty, rhs_str) == 0 do
                                            pass6_report_type_mismatch(diag, symbols, scopes, node, rhs, assign_vty, rhs_str)
                                        end
                                    end
                                end
                            end
                        end
                    eif pass6_is_array_type_str(assign_vty) do
                        if rhs.node_type == AstType.EntityLiteral do
                            pass6_report_type_mismatch(diag, symbols, scopes, node, rhs, assign_vty, "")
                        eif rhs.node_type == AstType.LiteralStr or (rhs.node_type == AstType.LiteralInt and rhs.int_val != 0) or rhs.node_type == AstType.LiteralBool or rhs.node_type == AstType.DictLiteral or rhs.node_type == AstType.TupleExpr do
                            pass6_report_type_mismatch(diag, symbols, scopes, node, rhs, assign_vty, "")
                        eif rhs.node_type == AstType.LiteralInt and rhs.int_val == 0 do
                            # 0 is null pointer / borrow release
                        else
                            var rhs_arr_str = pass6_get_expr_type_str(symbols, scopes, rhs)
                            if fat_str_len(rhs_arr_str) > 0 do
                                var a_ent2 = pass6_find_entity_ast(symbols, scopes, pass6_extract_base_name(rhs_arr_str))
                                if (a_ent2 as i64) != 0 do
                                    pass6_report_type_mismatch(diag, symbols, scopes, node, rhs, assign_vty, rhs_arr_str)
                                eif pass6_type_strings_compatible(symbols, scopes, assign_vty, rhs_arr_str) == 0 do
                                    pass6_report_type_mismatch(diag, symbols, scopes, node, rhs, assign_vty, rhs_arr_str)
                                end
                            end
                        end
                    end
                end
                if fat_str_len(assign_vty) > 0 and is_flux_type_str(assign_vty as int) do
                    var lhs_lanes = parse_flux_lanes(assign_vty as int)
                    if rhs.node_type == AstType.Call and fat_cstr_eq(rhs.name, "flux") do
                        if vec_len_rt(rhs.children) != lhs_lanes do
                            report_error(diag, 3001, node.line, 0)
                        end
                    end
                end
                if rhs.node_type == AstType.EntityLiteral and fat_str_len(rhs.name) > 0 do
                    pass6_set_var_type(node.name, rhs.name)
                eif rhs.node_type == AstType.Identifier and fat_str_len(rhs.name) > 0 do
                    r_ty = pass6_get_var_type(rhs.name)
                    if fat_str_len(r_ty) > 0 do
                        pass6_set_var_type(node.name, r_ty)
                    end
                eif rhs.node_type == AstType.QuantizeExpr do
                    if fat_str_len(rhs.name2) > 0 do
                        pass6_set_var_type(node.name, rhs.name2)
                    else
                        pass6_set_var_type(node.name, fat_str_new("QuantizedTensor"))
                    end
                eif rhs.node_type == AstType.Call || rhs.node_type == AstType.MethodCall || rhs.node_type == AstType.BuiltinCall do
                    if is_quantized_type_str(rhs.name2 as int) do
                        pass6_set_var_type(node.name, rhs.name2)
                    else
                        rhs_entity_type = pass6_get_receiver_entity_name(symbols, scopes, rhs)
                        if fat_str_len(rhs_entity_type) > 0 do
                            pass6_set_var_type(node.name, rhs_entity_type)
                        end
                    end
                eif rhs.node_type == AstType.BinOp and (rhs.op == OpType.MatMulOp or rhs.op == OpType.FmaOp) do
                    var inf_t = pass6_infer_tensor_op_result_type(symbols, scopes, rhs)
                    if fat_str_len(inf_t) > 0 do
                        pass6_set_var_type(node.name, inf_t)
                    end
                eif rhs.node_type == AstType.EnumConstruct do
                    if fat_str_len(rhs.name2) > 0 do
                        pass6_set_var_type(node.name, rhs.name2)
                    end
                end
            end
        end
    eif child_count >= 2 do
        lhs = vec_get_rt(node.children, 0)
        rhs = vec_get_rt(node.children, 1)
        if lhs.node_type != AstType.Identifier and lhs.node_type != AstType.FieldAccess and lhs.node_type != AstType.IndexAccess do
            report_error(diag, 3012, node.line, 0)
        end
        if lhs.node_type == AstType.Identifier do
            found = pass6_lookup_chain(symbols, scopes, scope_current_id(scopes), lhs.name)
            if found != -1 do
                sym = pass6_symbol_at(symbols, found)
                if sym.kind != SymbolKind.Variable and sym.kind != SymbolKind.Param do
                    pass6_register_local(symbols, scopes, lhs.name, true)
                    found = pass6_lookup_chain(symbols, scopes, scope_current_id(scopes), lhs.name)
                    sym = pass6_symbol_at(symbols, found)
                end
                if not sym.is_mutable do
                    report_error(diag, 3003, node.line, 1893)
                end
                rhs_type = pass6_infer_type(symbols, scopes, rhs)
                var_ty = pass6_get_var_type(lhs.name)
                if fat_str_len(var_ty) == 0 and sym.ast_id != 0 do
                    var d_ast2 = sym.ast_id as AstNode
                    if fat_str_len(d_ast2.name2) > 0 do
                        var_ty = d_ast2.name2
                    end
                end
                pass6_check_enum_generic_arg(symbols, scopes, diag, var_ty, rhs)
                if fat_str_len(var_ty) > 0 do
                    var lhs2_ent_ast = pass6_find_entity_ast(symbols, scopes, pass6_extract_base_name(var_ty))
                    if (lhs2_ent_ast as i64) != 0 do
                        if rhs.node_type == AstType.ArrayLiteral do
                            pass6_report_type_mismatch(diag, symbols, scopes, node, rhs, var_ty, "")
                        eif rhs.node_type == AstType.LiteralStr or (rhs.node_type == AstType.LiteralInt and rhs.int_val != 0) or rhs.node_type == AstType.LiteralBool or rhs.node_type == AstType.DictLiteral or rhs.node_type == AstType.TupleExpr do
                            pass6_report_type_mismatch(diag, symbols, scopes, node, rhs, var_ty, "")
                        eif rhs.node_type == AstType.LiteralInt and rhs.int_val == 0 do
                            # 0 is null pointer/entity reference
                        else
                            var rhs2_str = pass6_get_expr_type_str(symbols, scopes, rhs)
                            if fat_str_len(rhs2_str) > 0 do
                                if pass6_is_array_type_str(rhs2_str) do
                                    pass6_report_type_mismatch(diag, symbols, scopes, node, rhs, var_ty, rhs2_str)
                                else
                                    var a2_ent1 = pass6_find_entity_ast(symbols, scopes, pass6_extract_base_name(rhs2_str))
                                    if (a2_ent1 as i64) != 0 do
                                        if pass6_type_strings_compatible(symbols, scopes, var_ty, rhs2_str) == 0 do
                                            pass6_report_type_mismatch(diag, symbols, scopes, node, rhs, var_ty, rhs2_str)
                                        end
                                    end
                                end
                            end
                        end
                    eif pass6_is_array_type_str(var_ty) do
                        if rhs.node_type == AstType.EntityLiteral do
                            pass6_report_type_mismatch(diag, symbols, scopes, node, rhs, var_ty, "")
                        eif rhs.node_type == AstType.LiteralStr or (rhs.node_type == AstType.LiteralInt and rhs.int_val != 0) or rhs.node_type == AstType.LiteralBool or rhs.node_type == AstType.DictLiteral or rhs.node_type == AstType.TupleExpr do
                            pass6_report_type_mismatch(diag, symbols, scopes, node, rhs, var_ty, "")
                        eif rhs.node_type == AstType.LiteralInt and rhs.int_val == 0 do
                            # 0 is null pointer / borrow release
                        else
                            var rhs2_arr_str = pass6_get_expr_type_str(symbols, scopes, rhs)
                            if fat_str_len(rhs2_arr_str) > 0 do
                                var a2_ent2 = pass6_find_entity_ast(symbols, scopes, pass6_extract_base_name(rhs2_arr_str))
                                if (a2_ent2 as i64) != 0 do
                                    pass6_report_type_mismatch(diag, symbols, scopes, node, rhs, var_ty, rhs2_arr_str)
                                eif pass6_type_strings_compatible(symbols, scopes, var_ty, rhs2_arr_str) == 0 do
                                    pass6_report_type_mismatch(diag, symbols, scopes, node, rhs, var_ty, rhs2_arr_str)
                                end
                            end
                        end
                    end
                end
                if sym.type_id != 0 and rhs_type != TypeKind.Void and pass6_types_compatible(sym.type_id, rhs_type) == 0 do
                    if not (rhs.node_type == AstType.LiteralInt and rhs.int_val == 0) do
                        var allow_a2 = 0
                        if is_user_module(g_pass6_cur_module) == 0 do
                            if (sym.type_id == TypeKind.Bool as i64 and pass6_is_integer_like(rhs_type as i64) == 1) or (pass6_is_integer_like(sym.type_id) == 1 and rhs_type == TypeKind.Bool) do
                                allow_a2 = 1
                            end
                        end
                        if allow_a2 == 0 do
                            var exp_f_str = var_ty
                            if fat_str_len(exp_f_str) == 0 do
                                exp_f_str = pass6_type_kind_to_str(sym.type_id as TypeKind)
                            end
                            pass6_report_type_mismatch(diag, symbols, scopes, node, rhs, exp_f_str, pass6_type_kind_to_str(rhs_type))
                        end
                    end
                end
            end
        end
        if lhs.node_type == AstType.FieldAccess and vec_len_rt(lhs.children) > 0 do
            var base_node = vec_get_rt(lhs.children, 0) as AstNode
            var base_ty = pass6_infer_type(symbols, scopes, base_node)
            if base_ty == TypeKind.Pointer do
                report_error(diag, 3001, node.line, 0)
            end
            var base_type_str = fat_str_new("")
            if base_node.node_type == AstType.Identifier do
                var b_found = pass6_lookup_chain(symbols, scopes, scope_current_id(scopes), base_node.name)
                if b_found != -1 do
                    var b_sym = pass6_symbol_at(symbols, b_found)
                    if b_sym.ast_id != 0 do
                        var b_decl = b_sym.ast_id as AstNode
                        if fat_str_len(b_decl.name2) > 0 do
                            base_type_str = b_decl.name2
                        end
                    end
                end
                if fat_str_len(base_type_str) == 0 do
                    base_type_str = pass6_get_var_type(base_node.name)
                end
            end
            if fat_str_len(base_type_str) > 0 do
                var is_shared_ref = false
                if fat_str_byte_at(base_type_str, 0) == 38 do
                    var has_mut = false
                    var blen = fat_str_len(base_type_str)
                    if blen >= 4 and fat_str_byte_at(base_type_str, 1) == 109 and fat_str_byte_at(base_type_str, 2) == 117 and fat_str_byte_at(base_type_str, 3) == 116 do
                        has_mut = true
                    end
                    if not has_mut do
                        is_shared_ref = true
                    end
                eif fat_str_len(base_type_str) >= 4 and fat_str_byte_at(base_type_str, 0) == 114 and fat_str_byte_at(base_type_str, 1) == 101 and fat_str_byte_at(base_type_str, 2) == 102 and fat_str_byte_at(base_type_str, 3) == 32 do
                    is_shared_ref = true
                end
                if is_shared_ref do
                    report_error(diag, 3003, node.line, 0)
                end
            end
            var fld_exp_k = pass6_infer_type(symbols, scopes, lhs)
            var rhs_act_k = pass6_infer_type(symbols, scopes, rhs)
            if fld_exp_k != TypeKind.Void and rhs_act_k != TypeKind.Void and pass6_types_compatible(fld_exp_k as i64, rhs_act_k) == 0 do
                pass6_report_type_mismatch(diag, symbols, scopes, node, rhs, pass6_type_kind_to_str(fld_exp_k), pass6_type_kind_to_str(rhs_act_k))
            end
        end
    end
    var i = 0
    when i < child_count loop
        child = vec_get_rt(node.children, i)
        pass6_walk(symbols, scopes, diag, child)
        i = i + 1
    end
    out 0
end.

func pass6WalkCall(ref symbols: SymbolTable, ref scopes: ScopeTree, diag: &DiagnosticEngine, node: &AstNode) -> int:
    child_count = vec_len_rt(node.children)
    if fat_cstr_eq(node.name, "flux") == 1 do
        if flux_is_power_of_two(child_count) == false do
            report_error(diag, 3090, node.line, 0)
        end
        if child_count > 1 do
            var elem0_n = vec_get_rt(node.children, 0) as AstNode
            var elem0_t = pass6_infer_type(symbols, scopes, elem0_n)
            var fki = 1
            when fki < child_count loop
                var elem_k_n = vec_get_rt(node.children, fki) as AstNode
                var elem_k_t = pass6_infer_type(symbols, scopes, elem_k_n)
                if elem0_t != TypeKind.Void and elem_k_t != TypeKind.Void and elem0_t != elem_k_t do
                    report_error(diag, 3001, node.line, 0)
                end
                fki = fki + 1
            end
        end
    end
    if fat_cstr_eq(node.name, "q80CreateView") == 1 and child_count >= 8 do
        var rows = 0
        var cols = 0
        var stride = 0
        var align = 8
        let arg4 = vec_get_rt(node.children, 4) as AstNode
        let arg5 = vec_get_rt(node.children, 5) as AstNode
        let arg6 = vec_get_rt(node.children, 6) as AstNode
        let arg7 = vec_get_rt(node.children, 7) as AstNode
        if arg4.node_type == AstType.LiteralInt do rows = arg4.int_val end
        if arg5.node_type == AstType.LiteralInt do cols = arg5.int_val end
        if arg6.node_type == AstType.LiteralInt do stride = arg6.int_val end
        if arg7.node_type == AstType.LiteralInt do align = arg7.int_val end
        if cols > 0 and cols mod 32 != 0 do
            report_error(diag, 3014, arg5.line, 0)
        end
        if rows > 0 and cols > 0 do
            if stride <= 0 do stride = (cols / 32) * 40 end
            node.name2 = format_quantized_q80_type(rows, cols, stride, align)
        end
    end
    if fat_cstr_eq(node.name, "q80Gemv") == 1 or fat_cstr_eq(node.name, "q80GemvScalar") == 1 or fat_cstr_eq(node.name, "q80GemvSimd") == 1 or fat_cstr_eq(node.name, "q80GemvNeon") == 1 do
        if child_count >= 5 do
            var arg0 = vec_get_rt(node.children, 0) as AstNode
            var v_ty_str = pass6_get_expr_type_str(symbols, scopes, arg0)
            if fat_str_len(v_ty_str) == 0 and arg0.node_type == AstType.AddrOf and vec_len_rt(arg0.children) > 0 do
                let target = vec_get_rt(arg0.children, 0) as AstNode
                v_ty_str = pass6_get_var_type(target.name)
            end
            if is_quantized_type_str(v_ty_str as int) do
                if parse_quantized_codec(v_ty_str as int) != Q_CODEC_Q8_0 do
                    report_error(diag, 3001, node.line, 0)
                end
                let q_shape = parse_quantized_shape(v_ty_str as int)
                if vec_len_rt(q_shape) >= 2 do
                    let expected_rows = vec_get_rt(q_shape, 0) as int
                    let expected_cols = vec_get_rt(q_shape, 1) as int
                    var arg2 = vec_get_rt(node.children, 2) as AstNode
                    if arg2.node_type == AstType.LiteralInt and arg2.int_val != expected_cols do
                        report_error(diag, 3014, arg2.line, 0)
                    end
                    var arg4 = vec_get_rt(node.children, 4) as AstNode
                    if arg4.node_type == AstType.LiteralInt and arg4.int_val < expected_rows do
                        report_error(diag, 3014, arg4.line, 0)
                    end
                end
            end
            var arg1 = vec_get_rt(node.children, 1) as AstNode
            var a_ty = pass6_infer_type(symbols, scopes, arg1)
            var a_ty_str = pass6_get_expr_type_str(symbols, scopes, arg1)
            if a_ty == TypeKind.Int or (fat_str_len(a_ty_str) > 0 and (fat_cstr_eq(a_ty_str, "int") == 1 or fat_cstr_eq(a_ty_str, "[int]") == 1)) do
                report_error(diag, 3001, arg1.line, 0)
            end
        end
    end
    if fat_cstr_eq(node.name, "q80Gemm") == 1 do
        if child_count >= 6 do
            var arg0 = vec_get_rt(node.children, 0) as AstNode
            var v_ty_str = pass6_get_expr_type_str(symbols, scopes, arg0)
            if fat_str_len(v_ty_str) == 0 and arg0.node_type == AstType.AddrOf and vec_len_rt(arg0.children) > 0 do
                let target = vec_get_rt(arg0.children, 0) as AstNode
                v_ty_str = pass6_get_var_type(target.name)
            end
            if is_quantized_type_str(v_ty_str as int) do
                if parse_quantized_codec(v_ty_str as int) != Q_CODEC_Q8_0 do
                    report_error(diag, 3001, node.line, 0)
                end
                let q_shape = parse_quantized_shape(v_ty_str as int)
                if vec_len_rt(q_shape) >= 2 do
                    let expected_rows = vec_get_rt(q_shape, 0) as int
                    let expected_cols = vec_get_rt(q_shape, 1) as int
                    var arg3 = vec_get_rt(node.children, 3) as AstNode
                    if arg3.node_type == AstType.LiteralInt and arg3.int_val != expected_cols do
                        report_error(diag, 3014, arg3.line, 0)
                    end
                    var arg5 = vec_get_rt(node.children, 5) as AstNode
                    if arg5.node_type == AstType.LiteralInt and arg5.int_val < expected_rows do
                        report_error(diag, 3014, arg5.line, 0)
                    end
                end
            end
            var arg1 = vec_get_rt(node.children, 1) as AstNode
            var a_ty = pass6_infer_type(symbols, scopes, arg1)
            var a_ty_str = pass6_get_expr_type_str(symbols, scopes, arg1)
            if a_ty == TypeKind.Int or (fat_str_len(a_ty_str) > 0 and (fat_cstr_eq(a_ty_str, "int") == 1 or fat_cstr_eq(a_ty_str, "[int]") == 1)) do
                report_error(diag, 3001, arg1.line, 0)
            end
        end
    end
    found = pass6_lookup_chain(symbols, scopes, scope_current_id(scopes), node.name)
    if found != -1 do
        sym = pass6_symbol_at(symbols, found)
        arg_count = child_count
        # param_count < 0 means unknown (fresh extern stub) — skip arity check.
        if sym.kind == SymbolKind.Func and sym.param_count >= 0 and sym.param_count != arg_count do
            report_error(diag, 3004, node.line, 0)
        end
    end
    extern_decl_raw = pass6_find_extern(node.name)
    if extern_decl_raw != 0 do
        decl = extern_decl_raw as AstNode
        var ai = 0
        var pi = 0
        when ai < child_count and pi < vec_len_rt(decl.children) loop
                param = vec_get_rt(decl.children, pi)
                if param.node_type != AstType.Block do
                    expected = pass6_resolve_ffi_type(param.name2)
                    actual = pass6_infer_type(symbols, scopes, vec_get_rt(node.children, ai))
                # FFI boundaries require exact semantic categories.  The
                # general assignment checker intentionally treats several
                # pointer-sized values as compatible, which is unsafe for
                # a foreign ABI declaration.
                if expected != TypeKind.Void and actual != TypeKind.Void and expected != actual do
                    var ffi_arg = vec_get_rt(node.children, ai) as AstNode
                    pass6_report_type_mismatch(diag, symbols, scopes, node, ffi_arg, param.name2, pass6_type_kind_to_str(actual))
                end
                ai = ai + 1
            end
            pi = pi + 1
        end
    end
    call_ast = pass6_find_free_function(node.name)
    if (call_ast as i64) != 0 do
        if call_ast.builtin_id != 0 do
            fn_decl_cnt = count_list_items(call_ast.builtin_id as string)
            var fn_prov_cnt = 0
            if fat_str_len(node.name2) > 0 do
                fn_prov_cnt = count_list_items(node.name2)
            end
            if fn_decl_cnt != fn_prov_cnt do
                report_error(diag, 3085, node.line, 0)
            end
        end
        var fn_params = vec_new_rt()
        var fpi = 0
        when fpi < vec_len_rt(call_ast.children) loop
            p_ch = vec_get_rt(call_ast.children, fpi)
            nt_p = p_ch.node_type
            if nt_p == AstType.ParamDef or nt_p == AstType.RefParam or nt_p == AstType.OutParam or nt_p == AstType.Identifier do
                fn_params = vec_push_rt(fn_params, p_ch)
            end
            fpi = fpi + 1
        end

        var mut_args_seen = vec_new_rt()
        var ai = 0
        when ai < child_count and ai < vec_len_rt(fn_params) loop
            param_def = vec_get_rt(fn_params, ai) as AstNode
            arg_expr = vec_get_rt(node.children, ai) as AstNode
            is_ref_p = param_def.node_type == AstType.RefParam or param_def.int_val == 1
            is_out_p = param_def.node_type == AstType.OutParam or param_def.int_val == 2
            is_mut_p = is_ref_p or is_out_p

            # Parameter annotations constrain all modes, including ordinary
            # in/value parameters.
            if fat_str_len(param_def.name2) > 0 do
                var param_ty_str = param_def.name2
                if fat_str_len(node.name2) > 0 do
                    if (call_ast.builtin_id as i64) != 0 do
                        param_ty_str = pass6_substitute_generic_type(call_ast.builtin_id as string, node.name2, param_def.name2)
                    end
                end
                expected_ty = pass6_resolve_ffi_type(param_ty_str)
                actual_ty = pass6_infer_type(symbols, scopes, arg_expr)
                var p_ent_ast = pass6_find_entity_ast(symbols, scopes, pass6_extract_base_name(param_ty_str))
                if (p_ent_ast as i64) != 0 do
                    if arg_expr.node_type == AstType.ArrayLiteral do
                        pass6_report_type_mismatch(diag, symbols, scopes, node, arg_expr, param_ty_str, "")
                    eif arg_expr.node_type == AstType.LiteralStr or (arg_expr.node_type == AstType.LiteralInt and arg_expr.int_val != 0) or arg_expr.node_type == AstType.LiteralBool or arg_expr.node_type == AstType.DictLiteral or arg_expr.node_type == AstType.TupleExpr do
                        pass6_report_type_mismatch(diag, symbols, scopes, node, arg_expr, param_ty_str, "")
                    eif arg_expr.node_type == AstType.LiteralInt and arg_expr.int_val == 0 do
                        # 0 is null pointer/entity reference
                    else
                        var arg_str = pass6_get_expr_type_str(symbols, scopes, arg_expr)
                        if fat_str_len(arg_str) > 0 do
                            if pass6_is_array_type_str(arg_str) do
                                pass6_report_type_mismatch(diag, symbols, scopes, node, arg_expr, param_ty_str, arg_str)
                            else
                                var a_ent_call = pass6_find_entity_ast(symbols, scopes, pass6_extract_base_name(arg_str))
                                if (a_ent_call as i64) != 0 do
                                    if pass6_type_strings_compatible(symbols, scopes, param_ty_str, arg_str) == 0 do
                                        pass6_report_type_mismatch(diag, symbols, scopes, node, arg_expr, param_ty_str, arg_str)
                                    end
                                end
                            end
                        end
                    end
                eif pass6_is_array_type_str(param_ty_str) do
                    if arg_expr.node_type == AstType.EntityLiteral do
                        pass6_report_type_mismatch(diag, symbols, scopes, node, arg_expr, param_ty_str, "")
                    eif arg_expr.node_type == AstType.LiteralStr or arg_expr.node_type == AstType.LiteralInt or arg_expr.node_type == AstType.LiteralBool or arg_expr.node_type == AstType.DictLiteral or arg_expr.node_type == AstType.TupleExpr do
                        pass6_report_type_mismatch(diag, symbols, scopes, node, arg_expr, param_ty_str, "")
                    else
                        var arg_arr_str = pass6_get_expr_type_str(symbols, scopes, arg_expr)
                        if fat_str_len(arg_arr_str) > 0 do
                            var a_ent_call2 = pass6_find_entity_ast(symbols, scopes, pass6_extract_base_name(arg_arr_str))
                            if (a_ent_call2 as i64) != 0 do
                                pass6_report_type_mismatch(diag, symbols, scopes, node, arg_expr, param_ty_str, arg_arr_str)
                            eif pass6_type_strings_compatible(symbols, scopes, param_ty_str, arg_arr_str) == 0 do
                                pass6_report_type_mismatch(diag, symbols, scopes, node, arg_expr, param_ty_str, arg_arr_str)
                            end
                        end
                    end
                else
                    if expected_ty != TypeKind.Void and actual_ty != TypeKind.Void do
                        if is_mut_p and expected_ty != actual_ty do
                            pass6_report_type_mismatch(diag, symbols, scopes, node, arg_expr, param_ty_str, pass6_type_kind_to_str(actual_ty))
                        eif not is_mut_p and pass6_call_arg_types_compatible(symbols, scopes, expected_ty as i64, actual_ty, arg_expr, param_ty_str, param_def.name, node.name) == 0 do
                            pass6_report_type_mismatch(diag, symbols, scopes, node, arg_expr, param_ty_str, pass6_type_kind_to_str(actual_ty))
                        end
                    end
                end
            end

            if is_mut_p do
                # 1. Lvalue check (temporary / literal check) -> E3048
                is_lval = arg_expr.node_type == AstType.Identifier or arg_expr.node_type == AstType.FieldAccess or arg_expr.node_type == AstType.IndexAccess or arg_expr.node_type == AstType.ExprIndex
                if not is_lval do
                    report_error(diag, 3048, node.line, 0)
                end

                # 2. All mutable lvalues: overlapping aliases, root
                # mutability, and initialized-before-ref.
                if is_lval do
                    var was_seen = false
                    var si = 0
                    when si < vec_len_rt(mut_args_seen) loop
                        prev_arg = vec_get_rt(mut_args_seen, si) as AstNode
                        if pass6_lvalues_may_overlap(prev_arg, arg_expr) do
                            was_seen = true
                        end
                        si = si + 1
                    end
                    if was_seen do
                        report_error(diag, 5003, node.line, 0)
                    else
                        mut_args_seen = vec_push_rt(mut_args_seen, arg_expr as i64)
                    end

                    root_name = pass6_lvalue_root_name(arg_expr)
                    # Lookup the owner/root symbol.  Field and index lvalues
                    # inherit writability and initialization from this root.
                    arg_sym_idx = pass6_lookup_chain(symbols, scopes, scope_current_id(scopes), root_name)
                    if arg_sym_idx == -1 do
                        arg_sym_idx = pass6_lookup_global(symbols, root_name)
                    end
                    if arg_sym_idx != -1 do
                        sym_ptr = pass6_symbol_at(symbols, arg_sym_idx) as i64
                        sym_kind = native_read_i64(sym_ptr, 0)
                        is_mut = native_read_i64(sym_ptr, 40)
                        ast_ptr = native_read_i64(sym_ptr, 32)

                        # Immutability check -> E3003
                        var is_immutable = false
                        if sym_kind == (SymbolKind.Const as i64) or is_mut == 0 do
                            is_immutable = true
                        eif ast_ptr != 0 do
                            decl_node_imm = ast_ptr as AstNode
                            if decl_node_imm.node_type == AstType.ConstDecl do
                                is_immutable = true
                            end
                        end
                        if is_immutable do
                            report_error(diag, 3003, node.line, 0)
                        end

                        # Uninitialized check for ref -> E3049
                        if is_ref_p and sym_kind == (SymbolKind.Variable as i64) do
                            if ast_ptr != 0 do
                                decl_node = ast_ptr as AstNode
                                if decl_node.node_type == AstType.VarDecl and vec_len_rt(decl_node.children) == 0 do
                                    var was_assigned = false
                                    var as_i = 0
                                    when as_i < vec_len_rt(g_pass6_assigned_vars) loop
                                        if fat_str_eq(vec_get_rt(g_pass6_assigned_vars, as_i) as string, arg_expr.name) == 1 do
                                            was_assigned = true
                                        eif fat_str_eq(vec_get_rt(g_pass6_assigned_vars, as_i) as string, root_name) == 1 do
                                            was_assigned = true
                                        end
                                        as_i = as_i + 1
                                    end
                                    if not was_assigned do
                                        report_error(diag, 3049, node.line, 0)
                                    end
                                end
                            end
                        end
                    end
                    # A successful normal return initializes an identifier
                    # passed to an out parameter for following calls.
                    if is_out_p and arg_expr.node_type == AstType.Identifier do
                        if pass6_name_in_vec(g_pass6_assigned_vars, arg_expr.name) == 0 do
                            g_pass6_assigned_vars = vec_push_rt(g_pass6_assigned_vars, arg_expr.name as i64)
                        end
                    end
                end
            end
            ai = ai + 1
        end
    end
    var i = 0
    when i < child_count loop
        child = vec_get_rt(node.children, i)
        pass6_walk(symbols, scopes, diag, child)
        i = i + 1
    end
    out 0
end.

func pass6_lookup_global(ref symbols: SymbolTable, name: &string):
    if g_pass6_global_buckets == 0 do
        out -1
    end
    bid = pass6_hash_name(name)
    bucket = vec_get_rt(g_pass6_global_buckets, bid)
    count = vec_len_rt(bucket)
    syms_vec = native_read_i64(symbols as i64, 0)
    var i = 0
    when i < count loop
        sym_id = vec_get_rt(bucket, i)
        sym = vec_get_rt(syms_vec, sym_id)
        sym_name_ptr = native_read_i64(sym as i64, 8)
        if fat_str_eq(sym_name_ptr as string, name) == 1 do
            out sym_id
        end
        i = i + 1
    end

    if g_pass6_suffix_buckets != 0 and fat_str_len(name) > 0 do
        let sbid = pass6_hash_name(name)
        let sbucket = vec_get_rt(g_pass6_suffix_buckets, sbid)
        let scount = vec_len_rt(sbucket)
        var match_count = 0
        var found_id = -1
        var si = 0
        when si < scount loop
            let cand_id = vec_get_rt(sbucket, si)
            let cand_sym = vec_get_rt(syms_vec, cand_id)
            let cand_name_ptr = native_read_i64(cand_sym as i64, 8)
            let cand_short = pass6_get_short_name(cand_name_ptr as string)
            if fat_str_eq(cand_short, name) == 1 do
                match_count = match_count + 1
                found_id = cand_id
            end
            si = si + 1
        end
        if match_count == 1 do
            out found_id
        end
    end

    out -1
end.

func pass6_lookup_chain(ref symbols: SymbolTable, ref scopes: ScopeTree, start_scope: int, name: &string):
    if fat_str_len(name) == 0 do
        out -1
    end
    # Inner scopes shadow globals (match pass 3 name resolution).
    curr = start_scope
    scopes_vec = native_read_i64(scopes as i64, 0)
    let num_scopes = vec_len_rt(scopes_vec)
    var depth = 0
    when curr >= 0 and curr < num_scopes and depth <= num_scopes loop
        if curr == 0 do
            out pass6_lookup_global(symbols, name)
        end
        found2 = pass6_lookup_scope_indexed(symbols, curr, name)
        if found2 != -1 do
            out found2
        end
        scope_node = vec_get_rt(scopes_vec, curr)
        let parent = native_read_i64(scope_node as i64, 8) as int
        if parent == curr do
            # Scope parent self-cycle guard
            out -1
        end
        curr = parent
        depth = depth + 1
    end
    out -1
end.

func pass6_enclosing_func_scope(ref scopes: ScopeTree, curr_scope: int):
    if curr_scope <= 0 do
        out curr_scope
    end
    scopes_vec = native_read_i64(scopes as i64, 0)
    var s = curr_scope
    when s > 0 loop
        scope_node = vec_get_rt(scopes_vec, s)
        skind = native_read_i64(scope_node as i64, 0)
        if skind == ScopeKind.Func do
            out s
        end
        s = native_read_i64(scope_node as i64, 8)
    end
    out curr_scope
end.

func pass6_register_local(ref symbols: SymbolTable, ref scopes: ScopeTree, name: &string, is_mutable: bool):
    if fat_str_len(name) == 0 do
        out 0
    end
    curr = scope_current_id(scopes)
    sym = SymbolNode (
        kind: SymbolKind.Variable,
        name_id: name as i64,
        type_id: 0,
        scope_id: curr,
        ast_id: 0,
        is_mutable: is_mutable,
        offset: 0,
        param_count: 0,
        return_type: 0,
        parent_id: -1
    )
    sym_id = symbol_alloc(symbols, sym)
    func_scope = pass6_enclosing_func_scope(scopes, curr)
    scope_add_symbol(scopes, func_scope, sym_id)
    pass6_index_scope_symbol(func_scope, name, sym_id)
    if func_scope != curr do
        scope_add_symbol(scopes, curr, sym_id)
        pass6_index_scope_symbol(curr, name, sym_id)
    end
    if curr == 0 do
        pass6_index_global(name, sym_id)
    end
    out sym_id
end.

export pass6_typecheck
