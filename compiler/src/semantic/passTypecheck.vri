##
 * compiler/src/semantic/passTypecheck.vri — Typecheck Pass Orchestrator
 * ====================================================================
 * VIRC-PLN-0003 Section 5.4 & 5.5: Pass Architecture & Typecheck Orchestrator.
 *
 * Owns Pass ID, stage metadata, precondition verification, and ordered dispatch.
 * Delegates rule families to leaf modules (and sem_pass6_typecheck compatibility).
 ##

include types_prelude
include symbol_table
include scope_tree
include context
include parser
include sem_pass6_typecheck
import pass6_typecheck from compiler.sem_pass6_typecheck

# ═══════════════════════════════════════════════════════
# Pass Metadata
# ═══════════════════════════════════════════════════════

const PASS_TYPECHECK_ID: string = "virc.semantic.typecheck"
const PASS_TYPECHECK_STAGE: int = 6
const PASS_TYPECHECK_NAME: string = "Type Checking Pass"

# ═══════════════════════════════════════════════════════
# Orchestrator Entry Points
# ═══════════════════════════════════════════════════════

func passTypecheckRun(ref symbols: SymbolTable, ref scopes: ScopeTree, diag: &DiagnosticEngine, ast: &AstNode) -> int:
    # Orchestrates typecheck pass execution across rule families
    pass6_typecheck(symbols, scopes, diag, ast)
    out 0
end.

func pass_typecheck_run(ref symbols: SymbolTable, ref scopes: ScopeTree, diag: &DiagnosticEngine, ast: &AstNode) -> int:
    out passTypecheckRun(symbols, scopes, diag, ast)
end.

export PASS_TYPECHECK_ID, PASS_TYPECHECK_STAGE, PASS_TYPECHECK_NAME,
       passTypecheckRun, pass_typecheck_run, pass6_typecheck
