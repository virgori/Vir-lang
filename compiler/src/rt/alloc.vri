##
 * vir/rt/alloc.vri — Memory Allocator (Pure Vir, No libc) Orchestrator
 * ===================================================================
 * Strict Two-Level Segregated Fit (TLSF) O(1) Allocator + Bump Arena.
 * Zero C library. Zero malloc. Zero free. Pure kernel syscalls.
 *
 * VIRC-PLN-0011 / VIRC-ISS-0021: Decomposed into submodules:
 *   - compiler/src/rt/alloc/mmap_core.vri: Virtual memory & page allocator
 *   - compiler/src/rt/alloc/tlsf_core.vri: TLSF core structures, bitmaps, segment registry
 *   - compiler/src/rt/alloc/slab.vri: TLSF bins & core heap operations
 *   - compiler/src/rt/alloc/verify.vri: Heap verification & destruction
 *   - compiler/src/rt/alloc/promote.vri: Graph promotion runtime
 ##

module vir.rt.alloc

include rt_alloc_mmap_core
include rt_alloc_tlsf_core
include rt_alloc_slab
include rt_alloc_verify
include rt_alloc_promote

# ═══════════════════════════════════════════════════════
# Global Allocator API (FFI heap — lowered to vir_alloc/vir_free)
# ═══════════════════════════════════════════════════════

func vir_alloc(size: int):
    if g_initialized == false do
        heap_init(MIN_ARENA_SIZE * 4);   # 4MB initial heap
        g_initialized = true
    end
    out heap_alloc(size)
end.

func vir_free(p: int):
    heap_free(p)
end.

func vir_realloc(p: int, new_size: int):
    if g_initialized == false do
        heap_init(MIN_ARENA_SIZE * 4)
        g_initialized = true
    end
    out heap_realloc(p, new_size)
end.

func alloc(size: int):
    out vir_alloc(size)
end.

func free(p: int):
    vir_free(p)
end.

func realloc(p: int, new_size: int):
    out vir_realloc(p, new_size)
end.

func alloc_zeroed(size: int):
    let p = vir_alloc(size)
    if p != 0 do
        var i = 0
        extern func native_write_u8(addr: int, offset: int, val: int)
        when i < size loop
            native_write_u8(p, i, 0)
            i = i + 1
        end
    end
    out p
end.

export PAGE_SIZE, MIN_ARENA_SIZE, BLOCK_HEADER, MIN_BLOCK_SIZE, ALIGNMENT, BLOCK_FREE, PREV_FREE, BLOCK_DIRECT_MAP, FLAG_MASK, LARGE_ALLOC_THRESHOLD, MAX_ALLOC_SIZE, FL_INDEX_COUNT, SL_INDEX_COUNT, TOTAL_BINS, HEAP_THREAD_SAFE, DM_HASH_BASE, DM_HASH_SIZE, vm_alloc, vm_free, rt_page_size, page_alloc, page_free, Arena, arena_new, arena_alloc, arena_reset, arena_destroy, FreeNode, Heap, g_heap, g_tlsf_ctrl, g_heapSegments, g_heapSegmentCapacity, g_heap_inspect_count, g_initialized, heap_is_thread_safe, heap_get_inspect_count, heap_reset_inspect_count, get_fl_bitmap, set_fl_bitmap, get_sl_bitmap, set_sl_bitmap, get_bin_head, set_bin_head, tlsf_seg_count, tlsf_seg_add, tlsf_seg_find, tlsf_seg_base, tlsf_seg_size, tlsf_direct_count, tlsf_dm_hash_slot, tlsf_direct_hash_find, tlsf_direct_hash_insert, tlsf_direct_hash_remove, tlsf_direct_add, tlsf_direct_find, tlsf_direct_remove, tlsf_fls, tlsf_ffs, tlsf_mapping_bin, tlsf_search_suitable_bin, tlsf_insert_block, tlsf_remove_block, heap_init, heap_alloc, heap_free, heap_realloc, heap_verify, heap_destroy, vir_alloc, vir_free, vir_realloc, alloc, free, realloc, alloc_zeroed, rt_promote_graph
