##
 * compiler/src/rt/alloc/promote.vri — Deep Graph Promotion Runtime
 * ================================================================
 * Promotes graph allocations across arena bounds (MIR_MEM_PROMOTE).
 ##

module vir.rt.alloc.promote

include types_prelude

# ═══════════════════════════════════════════════════════
# Deep Graph Promotion Runtime (MIR_MEM_PROMOTE)
# ═══════════════════════════════════════════════════════

func rt_promote_graph(p: int, arena_base: int, arena_top: int) -> int:
    if p < 65536 do out p end
    if arena_base <= 0 or arena_top <= arena_base do out p end
    if p < arena_base or p >= arena_top do out p end

    extern func native_read_i64(addr: int, offset: int) -> int
    extern func native_write_i64(addr: int, offset: int, val: int)

    let hdr = p - 16
    let mark_flag = native_read_i64(hdr, 8)
    # Check if already promoted (cycle / alias handling)
    if mark_flag == 0 - 1 do
        out native_read_i64(hdr, 0)
    end

    let total_size = native_read_i64(hdr, 0)
    var size = 0
    if total_size >= 16 and total_size <= 67108864 and (total_size bit_and 15) == 0 do
        # Arena headers record header + aligned payload. vir_alloc() expects
        # payload bytes, so never copy the 16-byte header as object data.
        size = total_size - 16
    else
        let n_elem = native_read_i64(p, 0)
        if n_elem >= 0 and n_elem < 8388608 do
            size = 16 + n_elem * 8
            size = (size + 15) bit_and (0 - 16)
        else
            size = 32
        end
    end

    var cur_heap = native_read_i64(arena_base, 80)
    if cur_heap <= 0 do
        cur_heap = native_read_i64(arena_base, 24)
    end
    let total_alloc = size + 16
    cur_heap = cur_heap - total_alloc
    cur_heap = cur_heap bit_and (0 - 16)
    native_write_i64(arena_base, 80, cur_heap)

    native_write_i64(cur_heap, 0, total_alloc)
    native_write_i64(cur_heap, 8, 1)
    let new_p = cur_heap + 16

    # Copy payload
    if size >= 32 do
        extern func native_mem_copy(dst: int, src: int, len: int)
        native_mem_copy(new_p, p, size)
    else
        var off = 0
        when off < size loop
            native_write_i64(new_p, off, native_read_i64(p, off))
            off = off + 8
        end
    end

    # Mark original object as forwarded: hdr[8] = -1, hdr[0] = new_p
    native_write_i64(hdr, 8, 0 - 1)
    native_write_i64(hdr, 0, new_p)

    # Recursively traverse and promote child pointers
    off = 0
    when off < size loop
        let child = native_read_i64(new_p, off)
        if child >= 65536 and child >= arena_base and child < arena_top do
            let prom_child = rt_promote_graph(child, arena_base, arena_top)
            native_write_i64(new_p, off, prom_child)
        end
        off = off + 8
    end

    out new_p
end.

export rt_promote_graph
