##
 * Canonical Result<T, E> prelude for `include result;`.
 ##

include option_prelude

enum Result:
    Success(value: T)
    Failure(error: E)
end.

func isSuccess(r: Result):
    case r
        Success(_): out true
        Failure(_): out false
    end
end.

func isFailure(r: Result):
    out !isSuccess(r)
end.

export Result, Success, Failure, isSuccess, isFailure
