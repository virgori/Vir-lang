##
 * vir/compiler/lir_verifier.vri — Mandatory Post-RA Invariant Verifier
 * ====================================================================
 * Verifies register allocation correctness before code emission:
 * 1. No unallocated virtual registers remain in executable LIR.
 * 2. No physical register collision along interference edges.
 * 3. Caller-saved registers are never live across calls without spilling.
 * 4. Target-reserved registers are never allocated to virtual registers.
 * 5. Stack slots do not overlap and frame size satisfies 16-byte alignment.
 *
 * Implements the contract specified in REGISTER_ALLOCATION_STRICT_SPEC.md.
 ##

module vir.compiler.lir_verifier

include types_prelude
include rt_vec_rt
include rt_string_rt
include context
include lir
include lir_interference
include lir_target_desc

func lir_quant_meta_fail(fn_name: string, b_idx: i64, ins_idx: i64):
    print_str("lir_verifier error [E-QMETA-01]: invalid quantized descriptor in ")
    print_str(fn_name)
    print_str(" block ")
    print_int(b_idx)
    print_str(" ins ")
    print_int(ins_idx)
    print_ln("")
    out 0
end.

func lir_verify_quant_meta(meta: i64, fn_name: string, b_idx: i64, ins_idx: i64):
    if meta == 0 do out 1 end
    let
        codec = native_read_i64(meta, 0)
        bits = native_read_i64(meta, 8)
        rank = native_read_i64(meta, 24)
        dim0 = native_read_i64(meta, 32)
        dim1 = native_read_i64(meta, 40)
        block_bytes = native_read_i64(meta, 48)
        stride_bytes = native_read_i64(meta, 56)
        align_bytes = native_read_i64(meta, 64)
        byte_length = native_read_i64(meta, 72)
        byte_offset = native_read_i64(meta, 80)
        view_length = native_read_i64(meta, 88)
        read_only = native_read_i64(meta, 96)
        ownership = native_read_i64(meta, 104)
        has_lifetime = native_read_i64(meta, 112)
    if codec != 1 and codec != 2 do out lir_quant_meta_fail(fn_name, b_idx, ins_idx) end
    if bits <= 0 or bits > 32 do out lir_quant_meta_fail(fn_name, b_idx, ins_idx) end
    if align_bytes > 0 and (align_bytes and (align_bytes - 1)) != 0 do
        out lir_quant_meta_fail(fn_name, b_idx, ins_idx)
    end
    if codec == 2 do
        if bits != 8 or rank != 2 or block_bytes != 40 do
            out lir_quant_meta_fail(fn_name, b_idx, ins_idx)
        end
        if dim0 == 0 or dim1 == 0 or (dim1 > 0 and dim1 mod 32 != 0) do
            out lir_quant_meta_fail(fn_name, b_idx, ins_idx)
        end
        if stride_bytes > 0 do
            if stride_bytes mod 40 != 0 do out lir_quant_meta_fail(fn_name, b_idx, ins_idx) end
            if dim1 > 0 and stride_bytes < (dim1 / 32) * 40 do
                out lir_quant_meta_fail(fn_name, b_idx, ins_idx)
            end
        end
        if align_bytes > 0 and align_bytes < 8 do out lir_quant_meta_fail(fn_name, b_idx, ins_idx) end
        if read_only >= 0 and read_only != 1 do out lir_quant_meta_fail(fn_name, b_idx, ins_idx) end
        if ownership >= 0 and ownership != 0 do out lir_quant_meta_fail(fn_name, b_idx, ins_idx) end
        if has_lifetime != 1 do out lir_quant_meta_fail(fn_name, b_idx, ins_idx) end
        if byte_length >= 0 and byte_offset >= 0 and view_length >= 0 do
            if byte_length == 0 or view_length == 0 or byte_offset > byte_length or view_length > byte_length - byte_offset do
                out lir_quant_meta_fail(fn_name, b_idx, ins_idx)
            end
        end
    end
    out 1
end.

func lir_verify_opnd(opnd: LirOperand, fn_name: string, b_idx: i64, ins_idx: i64):
    if (opnd as i64) == 0 do out 1 end
    let typ = native_read_i64(opnd as i64, 0)
    # LirOperandType.VRegInt = 1, VRegFloat = 2
    if typ == 1 or typ == 2 do
        print_str("lir_verifier error [E-RA-01]: unallocated virtual register remains in ")
        print_str(fn_name)
        print_str(" block ")
        print_int(b_idx)
        print_str(" ins ")
        print_int(ins_idx)
        print_ln("")
        out 0
    end
    out 1
end.

func lir_verify_func(func_obj: LirFunc, ig: InterferenceGraph, assigned_phys: i64, assigned_stack: i64, is_leaf: i64, intervals: i64):
    let f_blocks = native_read_i64(func_obj as i64, 16)
    let n_fb = vec_len_rt(f_blocks)
    let fn_name = native_read_i64(func_obj as i64, 8) as string

    # 1. Verify no virtual registers remain in instructions
    var bi = 0
    when bi < n_fb loop
        let fb = vec_get_rt(f_blocks, bi)
        let fb_instrs = native_read_i64(fb as i64, 8)
        let n_ins = vec_len_rt(fb_instrs)
        var ii = 0
        when ii < n_ins loop
            let ins = vec_get_rt(fb_instrs, ii)
            let op = native_read_i64(ins as i64, 0)
            if op != 0 do # Non-Nop
                if lir_verify_quant_meta(lir_instr_quant_meta(ins), fn_name, bi, ii) == 0 do out 0 end
                # Vector instruction validation (Phase 3)
                if op >= (LirOp.VLoad as int) and op <= (LirOp.Shuffle as int) do
                    let v_aux = native_read_i64(ins as i64, 40)
                    let v_lanes = (v_aux shr 8) and 255
                    if v_lanes <= 0 or v_lanes > 64 do
                        print_str("lir_verifier error [E-VEC-01]: invalid vector lane count ")
                        print_int(v_lanes)
                        print_str(" in ")
                        print_str(fn_name)
                        print_ln("")
                        out 0
                    end
                    let v_align = (v_aux shr 16) and 255
                    if v_align > 0 and (v_align mod 4) != 0 do
                        print_str("lir_verifier error [E-VEC-02]: invalid vector alignment ")
                        print_int(v_align)
                        print_str(" in ")
                        print_str(fn_name)
                        print_ln("")
                        out 0
                    end
                end
                let d = native_read_i64(ins as i64, 16) as LirOperand
                let s1 = native_read_i64(ins as i64, 24) as LirOperand
                let s2 = native_read_i64(ins as i64, 32) as LirOperand
                if lir_verify_opnd(d, fn_name, bi, ii) == 0 do out 0 end
                if lir_verify_opnd(s1, fn_name, bi, ii) == 0 do out 0 end
                if lir_verify_opnd(s2, fn_name, bi, ii) == 0 do out 0 end
            end
            ii = ii + 1
        end
        bi = bi + 1
    end

    # 2. Verify interference edge coloring (no two neighbors have identical color)
    if (ig as i64) != 0 do
        let n_nodes = ig_num_nodes(ig)
        let adj_lists = ig_adj_lists(ig)
        var u = 0
        when u < n_nodes loop
            let p_u = vec_get_rt(assigned_phys, u)
            if p_u >= 0 do
                let neighbors = vec_get_rt(adj_lists, u)
                let nn = vec_len_rt(neighbors)
                var ni = 0
                when ni < nn loop
                    let v = vec_get_rt(neighbors, ni)
                    if v > u do
                        let p_v = vec_get_rt(assigned_phys, v)
                        if p_v >= 0 and p_u == p_v do
                            print_str("lir_verifier error [E-RA-02]: physical register collision between vreg ")
                            print_int(u)
                            print_str(" and vreg ")
                            print_int(v)
                            print_str(" in ")
                            print_str(fn_name)
                            print_ln("")
                            out 0
                        end
                    end
                    ni = ni + 1
                end
            end
            u = u + 1
        end
    end

    # 3. Verify caller-saved vs call clobbers & reserved registers
    if (ig as i64) != 0 do
        let n_nodes = ig_num_nodes(ig)
        var u = 0
        when u < n_nodes loop
            let p_u = vec_get_rt(assigned_phys, u)
            if p_u >= 0 do
                let phys_reg = target_desc_color_to_phys(p_u, is_leaf)
                # 3a. Reserved registers check
                if target_desc_is_reserved(phys_reg) == 1 do
                    print_str("lir_verifier error [E-RA-04]: target reserved register allocated to vreg ")
                    print_int(u)
                    print_str(" in ")
                    print_str(fn_name)
                    print_ln("")
                    out 0
                end
                # 3b. Caller-saved across call check
                if is_leaf == 0 and intervals != 0 and u < vec_len_rt(intervals) do
                    let iv = vec_get_rt(intervals, u)
                    let crosses_call = native_read_i64(iv as i64, 24)
                    if crosses_call == 1 and target_desc_is_call_clobbered(phys_reg) == 1 do
                        print_str("lir_verifier error [E-RA-03]: caller-saved register crosses call without spill: vreg ")
                        print_int(u)
                        print_str(" in ")
                        print_str(fn_name)
                        print_ln("")
                        out 0
                    end
                end
            end
            u = u + 1
        end
    end

    # 4. Verify stack alignment
    let stack_size = lir_func_stack_size(func_obj)
    if stack_size > 0 do
        if (stack_size mod 16) != 0 do
            print_str("lir_verifier error [E-RA-05]: stack frame size is not 16-byte aligned in ")
            print_str(fn_name)
            print_ln("")
            out 0
        end
    end

    out 1
end.

export lir_verify_func
