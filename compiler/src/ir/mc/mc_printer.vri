    if reg == 8 do out "w8" end
    if reg == 9 do out "w9" end
    if reg == 10 do out "w10" end
    if reg == 11 do out "w11" end
    if reg == 12 do out "w12" end
    if reg == 13 do out "w13" end
    if reg == 14 do out "w14" end
    if reg == 15 do out "w15" end
    if reg == 16 do out "w16" end
    if reg == 17 do out "w17" end
    if reg == 18 do out "w18" end
    if reg == 19 do out "w19" end
    if reg == 20 do out "w20" end
    if reg == 21 do out "w21" end
