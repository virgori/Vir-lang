##
 * vir/compiler/mc_verify.vri — MCInst Stream Verifier
 * ===================================================
 * Verifies machine instruction validity, register ranges, scratch isolation,
 * immediate bounds, and branch target consistency prior to assembly emission.
 ##

module vir.compiler.mc_verify

include types
include vec_rt
include string_rt
include rt.io
import print_ln, print_str from rt.io
include mc

var g_mc_verified_symbols: i64 = 0
var g_mc_verified_ptrs: i64 = 0

func mc_verify_is_known_ptr(ptr: int) -> int:
    if ptr == 0 do out 0 end
    if mc_is_trusted_symbol_ptr(ptr) == 1 do out 1 end
    if g_mc_verified_ptrs == 0 do out 0 end
    let n = vec_len_rt(g_mc_verified_ptrs)
    var i = 0
    when i < n loop
        if (vec_get_rt(g_mc_verified_ptrs, i) as int) == ptr do
            out 1
        end
        i = i + 1
    end
    out 0
end.

func mc_verify_register_symbol_cstr(cstr: int):
    if cstr == 0 do out end
    let slen = rt_strlen(cstr)
    if slen == 0 or slen > 255 do out end
    var ci = 0
    when ci < slen loop
        let b = native_read_u8(cstr, ci)
        var ok = 0
        if (b >= 97 and b <= 122) or (b >= 65 and b <= 90) or (b >= 48 and b <= 57) or b == 95 or b == 46 or b == 36 do
            ok = 1
        end
        if ok == 0 do out end
        ci = ci + 1
    end
    let p = alloc(slen + 1)
    var i = 0
    when i < slen loop
        native_write_u8(p, i, native_read_u8(cstr, i))
        i = i + 1
    end
    native_write_u8(p, slen, 0)
    if g_mc_verified_symbols == 0 do
        g_mc_verified_symbols = vec_new_rt()
    end
    g_mc_verified_symbols = vec_push_rt(g_mc_verified_symbols, p as i64)
    if g_mc_verified_ptrs == 0 do
        g_mc_verified_ptrs = vec_new_rt()
    end
    g_mc_verified_ptrs = vec_push_rt(g_mc_verified_ptrs, cstr as i64)
    g_mc_verified_ptrs = vec_push_rt(g_mc_verified_ptrs, p as i64)
end.

func mc_verify_register_symbol(name: string):
    let s = name as int
    if s == 0 do out end
    let slen = native_read_i64(s, 8) as int
    if slen == 0 or slen > 255 do out end
    let cstr_ptr = native_read_i64(s, 0) as int
    if cstr_ptr == 0 do out end
    var ci = 0
    when ci < slen loop
        let b = native_read_u8(cstr_ptr, ci)
        var ok = 0
        if (b >= 97 and b <= 122) or (b >= 65 and b <= 90) or (b >= 48 and b <= 57) or b == 95 or b == 46 or b == 36 do
            ok = 1
        end
        if ok == 0 do out end
        ci = ci + 1
    end
    let p = alloc(slen + 1)
    var i = 0
    when i < slen loop
        native_write_u8(p, i, native_read_u8(cstr_ptr, i))
        i = i + 1
    end
    native_write_u8(p, slen, 0)
    if g_mc_verified_symbols == 0 do
        g_mc_verified_symbols = vec_new_rt()
    end
    g_mc_verified_symbols = vec_push_rt(g_mc_verified_symbols, p as i64)
    if g_mc_verified_ptrs == 0 do
        g_mc_verified_ptrs = vec_new_rt()
    end
    g_mc_verified_ptrs = vec_push_rt(g_mc_verified_ptrs, s as i64)
    g_mc_verified_ptrs = vec_push_rt(g_mc_verified_ptrs, cstr_ptr as i64)
    g_mc_verified_ptrs = vec_push_rt(g_mc_verified_ptrs, p as i64)
end.

func mc_verify_register_defaults:
    # Note: In the ARM64 binary, string literals are lowered to raw C-string pointers
    # (via ADRP+ADD_LO12), NOT fat-string headers. mc_verify_register_symbol_cstr
    # accepts raw C-string pointers directly.
    mc_verify_register_symbol_cstr("main" as int)
    mc_verify_register_symbol_cstr("_main" as int)
    mc_verify_register_symbol_cstr("_start" as int)
    mc_verify_register_symbol_cstr("_vir_globals" as int)
    mc_verify_register_symbol_cstr("rt_print_int" as int)
    mc_verify_register_symbol_cstr("rt_print_str" as int)
    mc_verify_register_symbol_cstr("rt_str_eq" as int)
    mc_verify_register_symbol_cstr("rt_str_cat" as int)
    mc_verify_register_symbol_cstr("rt_alloc" as int)
    mc_verify_register_symbol_cstr("vir_free" as int)
    mc_verify_register_symbol_cstr("rt_int_to_str" as int)
    mc_verify_register_symbol_cstr("rt_bool_to_str" as int)
    mc_verify_register_symbol_cstr("_vir_train_active" as int)
    mc_verify_register_symbol_cstr("_vir_train_w" as int)
    mc_verify_register_symbol_cstr("_vir_train_x" as int)
    mc_verify_register_symbol_cstr("rt_quantize" as int)
    mc_verify_register_symbol_cstr("rt_backward" as int)
    mc_verify_register_symbol_cstr("rt_exit" as int)
    mc_verify_register_symbol_cstr("rt_matmul" as int)
    mc_verify_register_symbol_cstr("rt_fma" as int)
    mc_verify_register_symbol_cstr("native_read_u8" as int)
    mc_verify_register_symbol_cstr("native_read_i64" as int)
    mc_verify_register_symbol_cstr("native_write_u8" as int)
    mc_verify_register_symbol_cstr("native_write_i64" as int)
end.

func mc_verify_reset:
    mc_reset_trusted_symbol_ptrs()
    g_mc_verified_symbols = vec_new_rt()
    g_mc_verified_ptrs = vec_new_rt()
    mc_verify_register_defaults()
end.

func mc_verify_ensure_init:
    if g_mc_verified_symbols == 0 do
        g_mc_verified_symbols = vec_new_rt()
        g_mc_verified_ptrs = vec_new_rt()
        mc_verify_register_defaults()
    end
end.

func mc_verify_is_valid_symbol_tagged(tag: int, sym_val: i64):
    mc_verify_ensure_init()
    if sym_val <= 65536 do
        out 0
    end
    if tag != 1 and tag != 2 do
        out 0
    end
    if mc_verify_is_known_ptr(sym_val as int) == 0 do
        out 0
    end
    var cstr_base = sym_val as int
    if tag == 2 do
        let cstr = native_read_i64(sym_val, 0) as int
        let slen_fat = native_read_i64(sym_val, 8) as int
        if cstr <= 65536 or slen_fat <= 0 or slen_fat > 255 do
            out 0
        end
        if mc_verify_is_known_ptr(cstr) == 0 do
            out 0
        end
        cstr_base = cstr
    end
    var slen = 0
    var has_invalid_char = 0
    var i = 0
    when i < 256 loop
        let b = native_read_u8(cstr_base, i)
        if b == 0 do
            slen = i
            i = 256
        else
            var ok = 0
            if (b >= 97 and b <= 122) or (b >= 65 and b <= 90) or (b >= 48 and b <= 57) or b == 95 or b == 46 or b == 36 do
                ok = 1
            end
            if ok == 0 do
                has_invalid_char = 1
            end
            i = i + 1
        end
    end
    if slen == 0 or slen > 255 or has_invalid_char == 1 do
        out 0
    end

    if g_mc_verified_symbols != 0 and vec_len_rt(g_mc_verified_symbols) > 0 do
        var reg_i = 0
        let reg_count = vec_len_rt(g_mc_verified_symbols)
        when reg_i < reg_count loop
            let reg_p = vec_get_rt(g_mc_verified_symbols, reg_i) as int
            # Both cstr_base and reg_p are raw C-string pointers — compare byte by byte.
            var match = 1
            var ci = 0
            when ci < slen loop
                if native_read_u8(cstr_base, ci) != native_read_u8(reg_p, ci) do
                    match = 0
                    ci = slen
                else
                    ci = ci + 1
                end
            end
            if match == 1 and native_read_u8(reg_p, slen) == 0 do
                if g_mc_verified_ptrs != 0 do
                    g_mc_verified_ptrs = vec_push_rt(g_mc_verified_ptrs, sym_val)
                    if (cstr_base as i64) != sym_val do
                        g_mc_verified_ptrs = vec_push_rt(g_mc_verified_ptrs, cstr_base as i64)
                    end
                end
                out 1
            end
            reg_i = reg_i + 1
        end
    end
    out 0
end.

func mc_verify_is_valid_symbol(sym_val: i64):
    out mc_verify_is_valid_symbol_tagged(1, sym_val)
end.

func mc_verify_opnd_sym(opnd: MCOperand):
    if (opnd as i64) != 0 and mc_opnd_kind(opnd) == 4 do # Symbol
        let tag = mc_opnd_reg_val(opnd as i64)
        let sym_name = native_read_i64(opnd as i64, 56)
        if mc_verify_is_valid_symbol_tagged(tag as int, sym_name) == 0 do
            print_ln("mc_verify: error: missing or invalid symbol operand in instruction")
            out 0
        end
    end
    out 1
end.


func mc_verify_inst_reg(r: int, arch: int, ins_idx: int):
    if r < 0 do out 1 end
    if arch == TargetArch.X86_64 or arch == 1 do # x86_64
        if r > 15 do
            print_ln("mc_verify: error: x86_64 register ID out of bounds (0..15)")
            out 0
        end
    eif arch == TargetArch.RISCV64 or arch == 3 do # RISCV64
        if r > 31 do
            print_ln("mc_verify: error: RISC-V register ID out of bounds (0..31)")
            out 0
        end
    else # ARM64 (arch == 2 or arch == 0)
        if r > 31 do
            print_ln("mc_verify: error: ARM64 register ID out of bounds (0..31)")
            out 0
        end
    end
    out 1
end.

func mc_verify_inst(inst: MCInst, arch: int, ins_idx: int):
    let opc = mc_inst_opc(inst)

    # 1. Verify operand registers
    let op0 = mc_inst_op0(inst)
    if mc_opnd_kind(op0) == 1 do
        if mc_verify_inst_reg(mc_opnd_reg_val(op0), arch, ins_idx) == 0 do out 0 end
    eif mc_opnd_kind(op0) == 3 do
        if mc_verify_inst_reg(mc_opnd_mem_base(op0), arch, ins_idx) == 0 do out 0 end
    end

    let op1 = mc_inst_op1(inst)
    if mc_opnd_kind(op1) == 1 do
        if mc_verify_inst_reg(mc_opnd_reg_val(op1), arch, ins_idx) == 0 do out 0 end
    eif mc_opnd_kind(op1) == 3 do
        if mc_verify_inst_reg(mc_opnd_mem_base(op1), arch, ins_idx) == 0 do out 0 end
    end

    let op2 = mc_inst_op2(inst)
    if mc_opnd_kind(op2) == 1 do
        if mc_verify_inst_reg(mc_opnd_reg_val(op2), arch, ins_idx) == 0 do out 0 end
    eif mc_opnd_kind(op2) == 3 do
        if mc_verify_inst_reg(mc_opnd_mem_base(op2), arch, ins_idx) == 0 do out 0 end
    end

    let op3 = mc_inst_op3(inst)
    if mc_opnd_kind(op3) == 1 do
        if mc_verify_inst_reg(mc_opnd_reg_val(op3), arch, ins_idx) == 0 do out 0 end
    end

    # 2. Verify immediate bounds
    if arch == TargetArch.RISCV64 or arch == 3 do # RISC-V
        if opc == MCOpcode.RISCV_ADDI or opc == MCOpcode.RISCV_SLTIU or opc == MCOpcode.RISCV_XORI do
            let imm = mc_opnd_imm_val(op2)
            if imm < 0 - 2048 or imm > 2047 do
                print_ln("mc_verify: error: RISC-V immediate out of 12-bit range [-2048, 2047]")
                out 0
            end
        end
    end

    if arch == TargetArch.X86_64 or arch == 1 do # x86_64
        if opc == MCOpcode.X86_64_ADD_RI or opc == MCOpcode.X86_64_SUB_RI or opc == MCOpcode.X86_64_CMP_RI do
            let imm = mc_opnd_imm_val(op1)
            if imm < 0 - 2147483648 or imm > 2147483647 do
                print_ln("mc_verify: error: x86_64 ALU immediate out of signed 32-bit range")
                out 0
            end
        end
    end

    # 3. Verify symbol operands
    if mc_verify_opnd_sym(op0) == 0 do out 0 end
    if mc_verify_opnd_sym(op1) == 0 do out 0 end
    if mc_verify_opnd_sym(op2) == 0 do out 0 end
    if mc_verify_opnd_sym(op3) == 0 do out 0 end

    out 1
end.

func mc_verify_function(mc_insts: i64, arch: int):
    let n = vec_len_rt(mc_insts)
    var i = 0
    when i < n loop
        let ins = vec_get_rt(mc_insts, i) as MCInst
        if mc_verify_inst(ins, arch, i) == 0 do
            out 0
        end
        i = i + 1
    end
    out 1
end.

export mc_verify_inst, mc_verify_function, mc_verify_register_symbol, mc_verify_register_symbol_cstr, mc_verify_is_valid_symbol, mc_verify_is_valid_symbol_tagged, mc_verify_reset
