##
 * compiler/src/ir/mc/mc_printer/stubs_x86.vri — x86-64 Assembly Runtime Stubs
 * =========================================================================
 ##

include types_prelude
include rt_string_rt
import bvec_push from rt_vec_rt
include mc_printer_helpers

func print_mc_stubs_x86(b: int, entry_name: int) -> int:
        b = bvec_emit_cstr(b, ".globl rt_exit
.type rt_exit, @function
.p2align 4
rt_exit:
")
        b = bvec_emit_cstr(b, "    mov eax, 60
    syscall
    ret
.size rt_exit, .-rt_exit

")

        b = bvec_emit_cstr(b, ".globl rt_print_int
.type rt_print_int, @function
.p2align 4
rt_print_int:
")
        b = bvec_emit_cstr(b, "    push rbp
    mov rbp, rsp
    sub rsp, 128
")
        b = bvec_emit_cstr(b, "    mov [rsp+0], rsi
    mov [rsp+8], rdx
    mov [rsp+16], rcx
")
        b = bvec_emit_cstr(b, "    mov [rsp+24], r8
    mov [rsp+32], r9
    mov [rsp+40], r10
")
        b = bvec_emit_cstr(b, "    mov byte ptr [rsp+127], 10
")
        b = bvec_emit_cstr(b, "    cmp rdi, 0
    jne .L_p_nz
")
        b = bvec_emit_cstr(b, "    mov byte ptr [rsp+126], 48
    mov eax, 1
    mov edi, 1
    lea rsi, [rsp+126]
    mov edx, 2
    syscall
    jmp .L_p_done
")
        b = bvec_emit_cstr(b, ".L_p_nz:
    mov rax, rdi
    xor r8d, r8d
    test rax, rax
    jns .L_p_loop
    inc r8d
    neg rax
")
        b = bvec_emit_cstr(b, ".L_p_loop:
    lea rsi, [rsp+127]
    mov rcx, 10
")
        b = bvec_emit_cstr(b, ".L_p_div:
    dec rsi
    xor edx, edx
    div rcx
    add dl, 48
    mov [rsi], dl
    test rax, rax
    jnz .L_p_div
")
        b = bvec_emit_cstr(b, "    test r8d, r8d
    jz .L_p_wr
    dec rsi
    mov byte ptr [rsi], 45
")
        b = bvec_emit_cstr(b, ".L_p_wr:
    lea rdx, [rsp+128]
    sub rdx, rsi
    mov eax, 1
    mov edi, 1
    syscall
")
        b = bvec_emit_cstr(b, ".L_p_done:
    mov rsi, [rsp+0]
    mov rdx, [rsp+8]
    mov rcx, [rsp+16]
    mov r8, [rsp+24]
    mov r9, [rsp+32]
    mov r10, [rsp+40]
")
        b = bvec_emit_cstr(b, "    mov rsp, rbp
    pop rbp
    ret
.size rt_print_int, .-rt_print_int

")

        b = bvec_emit_cstr(b, ".globl rt_print_str
.type rt_print_str, @function
.p2align 4
rt_print_str:
")
        b = bvec_emit_cstr(b, "    push rbp
    mov rbp, rsp
    sub rsp, 32
")
        b = bvec_emit_cstr(b, "    mov [rsp+0], rsi
    mov [rsp+8], rdx
    mov rsi, rdi
    xor edx, edx
")
        b = bvec_emit_cstr(b, ".L_ps_1:
    cmp byte ptr [rsi+rdx], 0
    je .L_ps_2
    inc rdx
    jmp .L_ps_1
")
        b = bvec_emit_cstr(b, ".L_ps_2:
    mov eax, 1
    mov edi, 1
    syscall
    mov byte ptr [rsp+16], 10
    mov eax, 1
    mov edi, 1
    lea rsi, [rsp+16]
    mov edx, 1
    syscall
")
        b = bvec_emit_cstr(b, "    mov rsi, [rsp+0]
    mov rdx, [rsp+8]
    mov rsp, rbp
    pop rbp
    ret
.size rt_print_str, .-rt_print_str
")
        b = bvec_emit_cstr(b, ".globl rt_str_eq
.type rt_str_eq, @function
.p2align 4
rt_str_eq:
.L_xseq_loop:
    mov al, byte ptr [rdi]
    mov dl, byte ptr [rsi]
    cmp al, dl
    jne .L_xseq_false
    test al, al
    je .L_xseq_true
    inc rdi
    inc rsi
    jmp .L_xseq_loop
.L_xseq_false:
    xor eax, eax
    ret
.L_xseq_true:
    mov eax, 1
    ret
.size rt_str_eq, .-rt_str_eq

")
        b = bvec_emit_cstr(b, ".globl rt_alloc
.type rt_alloc, @function
.p2align 4
rt_alloc:
    lea r10, [rip + _vir_heap_curr]
    mov rax, qword ptr [r10]
    test rax, rax
    jne .L_xalloc_ready
    lea rax, [rip + _vir_heap_start]
.L_xalloc_ready:
    lea r11, [rax + rdi + 7]
    and r11, -8
    mov qword ptr [r10], r11
    ret
.size rt_alloc, .-rt_alloc

")
        b = bvec_emit_cstr(b, ".globl rt_str_cat
.type rt_str_cat, @function
.p2align 4
rt_str_cat:
    mov r8, rdi
.L_xca_len:
    cmp byte ptr [r8], 0
    je .L_xca_done
    inc r8
    jmp .L_xca_len
.L_xca_done:
    mov r10, r8
    sub r10, rdi
    mov r9, rsi
.L_xcb_len:
    cmp byte ptr [r9], 0
    je .L_xcb_done
    inc r9
    jmp .L_xcb_len
.L_xcb_done:
    mov r11, r9
    sub r11, rsi
    lea rcx, [r10 + r11 + 8]
    and rcx, -8
    lea r15, [rip + _vir_heap_curr]
    mov rax, [r15]
    test rax, rax
    jnz .L_xcat_h1
    lea rax, [rip + _vir_heap_start]
.L_xcat_h1:
    mov rdx, rax
    add rdx, rcx
    mov [r15], rdx
    mov rdx, rax
    mov r8, rdi
.L_xca_cp:
    cmp byte ptr [r8], 0
    je .L_xca_cp_done
    mov cl, [r8]
    mov [rdx], cl
    inc r8
    inc rdx
    jmp .L_xca_cp
.L_xca_cp_done:
    mov r9, rsi
.L_xcb_cp:
    cmp byte ptr [r9], 0
    je .L_xcb_cp_done
    mov cl, [r9]
    mov [rdx], cl
    inc r9
    inc rdx
    jmp .L_xcb_cp
.L_xcb_cp_done:
    mov byte ptr [rdx], 0
    ret
.size rt_str_cat, .-rt_str_cat

.globl rt_int_to_str
.type rt_int_to_str, @function
.p2align 4
rt_int_to_str:
    lea r15, [rip + _vir_heap_curr]
    mov rax, [r15]
    test rax, rax
    jnz .L_xits_h1
    lea rax, [rip + _vir_heap_start]
.L_xits_h1:
    lea rcx, [rax + 32]
    mov [r15], rcx
    lea r8, [rax + 31]
    mov byte ptr [r8], 0
    mov rcx, rdi
    xor r9d, r9d
    test rcx, rcx
    jns .L_xits_pos
    mov r9d, 1
    neg rcx
.L_xits_pos:
    mov rax, rcx
    mov r10, 10
.L_xits_loop:
    xor edx, edx
    div r10
    add dl, 48
    dec r8
    mov [r8], dl
    test rax, rax
    jnz .L_xits_loop
    test r9d, r9d
    jz .L_xits_done
    dec r8
    mov byte ptr [r8], 45
.L_xits_done:
    mov rax, r8
    ret
.size rt_int_to_str, .-rt_int_to_str

.globl rt_bool_to_str
.type rt_bool_to_str, @function
.p2align 4
rt_bool_to_str:
    lea rax, [rip + .L_interp_false]
    test rdi, rdi
    jz .L_interp_bool_done
    lea rax, [rip + .L_interp_true]
.L_interp_bool_done:
    ret
.L_interp_true:
    .asciz \"true\"
.L_interp_false:
    .asciz \"false\"
.size rt_bool_to_str, .-rt_bool_to_str

.globl _start
.type _start, @function
.p2align 4
_start:
    call __vir_global_init
    call ")
    b = bvec_emit_cstr(b, entry_name)
    b = bvec_emit_cstr(b, "
    mov rdi, rax
    mov rax, 60
    syscall
.size _start, .-_start

.section .bss
.p2align 3
_vir_heap_start:
    .space 1048576
_vir_heap_curr:
    .quad 0
_vir_globals:
    .space 32768
")
    out b
end.
