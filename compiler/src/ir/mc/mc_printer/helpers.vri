##
 * compiler/src/ir/mc/mc_printer/helpers.vri — Assembly Emission Helpers
 * ====================================================================
 ##

include types_prelude
include rt_string_rt
import bvec_new, bvec_push, bvec_len, bvec_data_ptr, vec_get_rt, vec_len_rt from rt_vec_rt

func bvec_emit_cstr(b: int, s: string):
    if (s as i64) == 0 do out b end
    let slen = rt_strlen(s as i64)
    var i = 0
    when i < slen loop
        b = bvec_push(b, native_read_u8(s as i64, i))
        i = i + 1
    end
    out b
end.

func bvec_emit_int(b: int, n: int):
    if n == 0 do
        out bvec_push(b, 48)
    end
    var val = n
    if val < 0 do
        b = bvec_push(b, 45) # '-'
        val = 0 - val
    end
    var digits = 0
    var temp = val
    when temp > 0 loop
        digits = digits + 1
        temp = temp / 10
    end
    var d = digits
    when d > 0 loop
        var p = 1
        var k = 1
        when k < d loop
            p = p * 10
            k = k + 1
        end
        let digit = (val / p) mod 10
        b = bvec_push(b, 48 + digit)
        d = d - 1
    end
    out b
end.
