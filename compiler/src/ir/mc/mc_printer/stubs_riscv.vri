##
 * compiler/src/ir/mc/mc_printer/stubs_riscv.vri — RISC-V Assembly Runtime Stubs
 * ============================================================================
 ##

include types_prelude
include rt_string_rt
import bvec_push from rt_vec_rt
include mc_printer_helpers

func print_mc_stubs_riscv(b: int, entry_name: int) -> int:
        b = bvec_emit_cstr(b, ".globl rt_exit
.type rt_exit, %function
.p2align 2
rt_exit:
")
        b = bvec_emit_cstr(b, "    li a7, 93
    ecall
    ret
.size rt_exit, .-rt_exit

")

        b = bvec_emit_cstr(b, ".globl rt_print_int
.type rt_print_int, %function
.p2align 2
rt_print_int:
")
        b = bvec_emit_cstr(b, "    addi sp, sp, -128
")
        b = bvec_emit_cstr(b, "    sd a1, 0(sp)
    sd a2, 8(sp)
    sd a3, 16(sp)
    sd a7, 24(sp)
    sd s0, 32(sp)
    sd s1, 40(sp)
")
        b = bvec_emit_cstr(b, "    li a1, 10
    addi a2, sp, 127
    sb a1, 0(a2)
")
        b = bvec_emit_cstr(b, "    bnez a0, .L_rv_nz
    li a1, 48
    addi a2, sp, 126
    sb a1, 0(a2)
")
        b = bvec_emit_cstr(b, "    li a7, 64
    li a0, 1
    mv a1, a2
    li a2, 2
    ecall
    j .L_rv_done
")
        b = bvec_emit_cstr(b, ".L_rv_nz:
    li s1, 0
    bge a0, zero, .L_rv_pos
    li s1, 1
    neg a0, a0
")
        b = bvec_emit_cstr(b, ".L_rv_pos:
    li a3, 10
    addi a1, sp, 127
")
        b = bvec_emit_cstr(b, ".L_rv_loop:
    rem a2, a0, a3
    div a0, a0, a3
    addi a2, a2, 48
    addi a1, a1, -1
    sb a2, 0(a1)
    bnez a0, .L_rv_loop
")
        b = bvec_emit_cstr(b, "    beqz s1, .L_rv_write
    li a2, 45
    addi a1, a1, -1
    sb a2, 0(a1)
")
        b = bvec_emit_cstr(b, ".L_rv_write:
    addi a2, sp, 128
    sub a2, a2, a1
    li a7, 64
    li a0, 1
    ecall
")
        b = bvec_emit_cstr(b, ".L_rv_done:
    ld a1, 0(sp)
    ld a2, 8(sp)
    ld a3, 16(sp)
    ld a7, 24(sp)
    ld s0, 32(sp)
    ld s1, 40(sp)
    addi sp, sp, 128
    ret
.size rt_print_int, .-rt_print_int

")

        b = bvec_emit_cstr(b, ".globl rt_print_str
.type rt_print_str, %function
.p2align 2
rt_print_str:
")
        b = bvec_emit_cstr(b, "    addi sp, sp, -32
    sd a1, 0(sp)
    sd a2, 8(sp)
    sd a7, 16(sp)
")
        b = bvec_emit_cstr(b, "    mv a1, a0
    li a2, 0
")
        b = bvec_emit_cstr(b, ".L_rv_ps1:
    add a3, a1, a2
    lbu a4, 0(a3)
    beqz a4, .L_rv_ps2
    addi a2, a2, 1
    j .L_rv_ps1
")
        b = bvec_emit_cstr(b, ".L_rv_ps2:
    li a7, 64
    li a0, 1
    ecall
    li t0, 10
    sb t0, 24(sp)
    li a0, 1
    addi a1, sp, 24
    li a2, 1
    li a7, 64
    ecall
")
        b = bvec_emit_cstr(b, "    ld a1, 0(sp)
    ld a2, 8(sp)
    ld a7, 16(sp)
    addi sp, sp, 32
    ret
.size rt_print_str, .-rt_print_str
")
        b = bvec_emit_cstr(b, ".globl rt_str_eq
.type rt_str_eq, %function
.p2align 2
rt_str_eq:
.L_rv_seq_loop:
    lbu t0, 0(a0)
    lbu t1, 0(a1)
    bne t0, t1, .L_rv_seq_false
    beqz t0, .L_rv_seq_true
    addi a0, a0, 1
    addi a1, a1, 1
    j .L_rv_seq_loop
.L_rv_seq_false:
    li a0, 0
    ret
.L_rv_seq_true:
    li a0, 1
    ret
.size rt_str_eq, .-rt_str_eq
")
        b = bvec_emit_cstr(b, ".globl rt_str_cat
.type rt_str_cat, %function
.p2align 2
rt_str_cat:
    la t0, _vir_heap_curr
    ld t1, 0(t0)
    bnez t1, 1f
    la t1, _vir_heap_start
    sd t1, 0(t0)
1:
    mv t2, zero
2:
    add t3, a0, t2
    lbu t4, 0(t3)
    beqz t4, 3f
    addi t2, t2, 1
    j 2b
3:
    mv t3, zero
4:
    add t4, a1, t3
    lbu t5, 0(t4)
    beqz t5, 5f
    addi t3, t3, 1
    j 4b
5:
    add t4, t2, t3
    addi t4, t4, 8
    andi t4, t4, -8
    mv a2, t1
    add t5, t1, t4
    sd t5, 0(t0)
    mv t4, zero
6:
    bge t4, t2, 7f
    add t5, a0, t4
    lbu t6, 0(t5)
    add t5, a2, t4
    sb t6, 0(t5)
    addi t4, t4, 1
    j 6b
7:
    mv t5, zero
8:
    bge t5, t3, 9f
    add t6, a1, t5
    lbu a3, 0(t6)
    add a4, a2, t2
    add a4, a4, t5
    sb a3, 0(a4)
    addi t5, t5, 1
    j 8b
9:
    add a4, a2, t2
    add a4, a4, t3
    sb zero, 0(a4)
    mv a0, a2
    ret
.size rt_str_cat, .-rt_str_cat

.globl rt_int_to_str
.type rt_int_to_str, %function
.p2align 2
rt_int_to_str:
    la t0, _vir_heap_curr
    ld t1, 0(t0)
    bnez t1, 1f
    la t1, _vir_heap_start
    sd t1, 0(t0)
1:
    mv a2, t1
    addi t2, t1, 32
    sd t2, 0(t0)
    addi t3, a2, 31
    sb zero, 0(t3)
    mv t4, a0
    li t5, 0
    bge t4, zero, 2f
    li t5, 1
    neg t4, t4
2:
    li t6, 10
3:
    remu a3, t4, t6
    divu t4, t4, t6
    addi a3, a3, 48
    addi t3, t3, -1
    sb a3, 0(t3)
    bnez t4, 3b
    beqz t5, 4f
    li a3, 45
    addi t3, t3, -1
    sb a3, 0(t3)
4:
    mv a0, t3
    ret
.size rt_int_to_str, .-rt_int_to_str

.globl rt_bool_to_str
.type rt_bool_to_str, %function
.p2align 2
rt_bool_to_str:
    beqz a0, .L_rv_interp_false
    la a0, .L_rv_interp_true
    ret
.L_rv_interp_false:
    la a0, .L_rv_interp_false_text
    ret
.L_rv_interp_true:
    .asciz \"true\"
.L_rv_interp_false_text:
    .asciz \"false\"
.size rt_bool_to_str, .-rt_bool_to_str

.globl native_read_u8
.type native_read_u8, %function
.p2align 2
native_read_u8:
    add a0, a0, a1
    lbu a0, 0(a0)
    ret
.size native_read_u8, .-native_read_u8

.globl native_read_i64
.type native_read_i64, %function
.p2align 2
native_read_i64:
    add a0, a0, a1
    ld a0, 0(a0)
    ret
.size native_read_i64, .-native_read_i64

.globl native_write_u8
.type native_write_u8, %function
.p2align 2
native_write_u8:
    add a0, a0, a1
    sb a2, 0(a0)
    ret
.size native_write_u8, .-native_write_u8

.globl native_write_i64
.type native_write_i64, %function
.p2align 2
native_write_i64:
    add a0, a0, a1
    sd a2, 0(a0)
    ret
.size native_write_i64, .-native_write_i64

.globl rt_alloc
.type rt_alloc, %function
.p2align 2
rt_alloc:
    addi a0, a0, 15
    andi a0, a0, -16
    la t0, _vir_heap_curr
    ld t1, 0(t0)
    bnez t1, 1f
    la t1, _vir_heap_start
1:
    mv a1, t1
    add t2, t1, a0
    sd t2, 0(t0)
    mv a0, a1
    ret
.size rt_alloc, .-rt_alloc

.globl rt_matmul
.type rt_matmul, %function
.p2align 2
rt_matmul:
    addi sp, sp, -80
    sd ra, 0(sp)
    sd s0, 8(sp)
    sd s1, 16(sp)
    sd s2, 24(sp)
    sd s3, 32(sp)
    sd s4, 40(sp)
    sd s5, 48(sp)
    sd s6, 56(sp)
    sd s7, 64(sp)
    sd s8, 72(sp)

    la t0, _vir_train_active
    ld t1, 0(t0)
    li t2, 1
    bne t1, t2, 1f
    la t0, _vir_train_w
    sd a0, 0(t0)
    la t0, _vir_train_x
    sd a1, 0(t0)
1:
    mv s0, a0
    mv s1, a1
    mv s2, a2
    mv s3, a3
    mv s4, a4

    mul s5, s2, s4
    slli a0, s5, 3
    addi a0, a0, 16
    call rt_alloc
    mv s6, a0

    sd s5, 0(s6)
    sd zero, 8(s6)

    li s7, 0
.Lmm_i:
    bge s7, s2, .Lmm_end_i
    li s8, 0
.Lmm_j:
    bge s8, s4, .Lmm_end_j
    li t0, 0
    li t1, 0
.Lmm_k:
    bge t1, s3, .Lmm_end_k
    mul t2, s7, s3
    add t2, t2, t1
    slli t2, t2, 3
    addi t2, t2, 16
    add t2, s0, t2
    ld t3, 0(t2)

    mul t4, t1, s4
    add t4, t4, s8
    slli t4, t4, 3
    addi t4, t4, 16
    add t4, s1, t4
    ld t5, 0(t4)

    mul t6, t3, t5
    add t0, t0, t6

    addi t1, t1, 1
    j .Lmm_k
.Lmm_end_k:
    mul t2, s7, s4
    add t2, t2, s8
    slli t2, t2, 3
    addi t2, t2, 16
    add t2, s6, t2
    sd t0, 0(t2)

    addi s8, s8, 1
    j .Lmm_j
.Lmm_end_j:
    addi s7, s7, 1
    j .Lmm_i
.Lmm_end_i:
    mv a0, s6
    ld ra, 0(sp)
    ld s0, 8(sp)
    ld s1, 16(sp)
    ld s2, 24(sp)
    ld s3, 32(sp)
    ld s4, 40(sp)
    ld s5, 48(sp)
    ld s6, 56(sp)
    ld s7, 64(sp)
    ld s8, 72(sp)
    addi sp, sp, 80
    ret
.size rt_matmul, .-rt_matmul

.globl rt_fma
.type rt_fma, %function
.p2align 2
rt_fma:
    j rt_matmul
.size rt_fma, .-rt_fma

.globl rt_quantize
.type rt_quantize, %function
.p2align 2
rt_quantize:
    addi sp, sp, -80
    sd ra, 0(sp)
    sd s0, 8(sp)
    sd s1, 16(sp)
    sd s2, 24(sp)
    sd s3, 32(sp)
    sd s4, 40(sp)
    sd s5, 48(sp)
    sd s6, 56(sp)
    sd s7, 64(sp)

    mv s0, a0
    mv s1, a1
    ld s2, 0(s0)
    blez s2, .Lq_zero

    li s3, 127
    li t0, 4
    bne s1, t0, 1f
    li s3, 7
1:
    li s4, 0
    li t1, 0
.Lq_scan:
    bge t1, s2, .Lq_scan_done
    slli t2, t1, 3
    addi t2, t2, 16
    add t2, s0, t2
    ld t3, 0(t2)
    srli t4, t3, 52
    andi t4, t4, 0x7FF
    beqz t4, .Lq_use_raw
    li t5, 2047
    beq t4, t5, .Lq_use_raw
    fld fa0, 0(t2)
    fcvt.l.d t3, fa0, rtz
.Lq_use_raw:
    bgez t3, 2f
    neg t3, t3
2:
    ble t3, s4, 3f
    mv s4, t3
3:
    addi t1, t1, 1
    j .Lq_scan

.Lq_scan_done:
    li s5, 1
    ble s4, s3, .Lq_scale_done
    add t3, s4, s3
    addi t3, t3, -1
    div s5, t3, s3

.Lq_scale_done:
    li a0, 32
    li t0, 4
    beq s1, t0, 4f
    add a0, a0, s2
    j 5f
4:
    addi t1, s2, 1
    srli t1, t1, 1
    add a0, a0, t1
5:
    call rt_alloc
    mv s6, a0

    sd s2, 0(s6)
    sd s1, 8(s6)
    sd s5, 16(s6)
    sd zero, 24(s6)

    li t0, 4
    beq s1, t0, .Lq_pack4

    li t1, 0
.Lq_loop8:
    bge t1, s2, .Lq_done
    slli t2, t1, 3
    addi t2, t2, 16
    add t2, s0, t2
    ld t3, 0(t2)
    srli t4, t3, 52
    andi t4, t4, 0x7FF
    beqz t4, 6f
    li t5, 2047
    beq t4, t5, 6f
    fld fa0, 0(t2)
    fcvt.l.d t3, fa0, rtz
6:
    div t3, t3, s5
    addi t6, s6, 32
    add t6, t6, t1
    sb t3, 0(t6)
    addi t1, t1, 1
    j .Lq_loop8

.Lq_pack4:
    li t1, 0
.Lq_loop4:
    slli t2, t1, 1
    bge t2, s2, .Lq_done

    slli t3, t2, 3
    addi t3, t3, 16
    add t3, s0, t3
    ld t4, 0(t3)
    srli t5, t4, 52
    andi t5, t5, 0x7FF
    beqz t5, 7f
    li a2, 2047
    beq t5, a2, 7f
    fld fa0, 0(t3)
    fcvt.l.d t4, fa0, rtz
7:
    div t4, t4, s5
    andi t4, t4, 0x0F

    addi a3, t2, 1
    bge a3, s2, 8f
    slli t3, a3, 3
    addi t3, t3, 16
    add t3, s0, t3
    ld a4, 0(t3)
    srli t5, a4, 52
    andi t5, t5, 0x7FF
    beqz t5, 9f
    li a2, 2047
    beq t5, a2, 9f
    fld fa0, 0(t3)
    fcvt.l.d a4, fa0, rtz
9:
    div a4, a4, s5
    slli a4, a4, 4
    andi a4, a4, 0xF0
    or t4, t4, a4
8:
    addi t6, s6, 32
    add t6, t6, t1
    sb t4, 0(t6)
    addi t1, t1, 1
    j .Lq_loop4

.Lq_done:
    mv a0, s6
    j .Lq_exit

.Lq_zero:
    li a0, 0

.Lq_exit:
    ld ra, 0(sp)
    ld s0, 8(sp)
    ld s1, 16(sp)
    ld s2, 24(sp)
    ld s3, 32(sp)
    ld s4, 40(sp)
    ld s5, 48(sp)
    ld s6, 56(sp)
    ld s7, 64(sp)
    addi sp, sp, 80
    ret
.size rt_quantize, .-rt_quantize

.globl rt_backward
.type rt_backward, %function
.p2align 2
rt_backward:
    addi sp, sp, -48
    sd ra, 0(sp)
    sd s0, 8(sp)
    sd s1, 16(sp)
    sd s2, 24(sp)
    sd s3, 32(sp)

    la t0, _vir_train_w
    ld s0, 0(t0)
    la t0, _vir_train_x
    ld s1, 0(t0)
    beqz s0, .Lback_exit
    beqz s1, .Lback_exit

    li a0, 48
    call rt_alloc
    mv s2, a0
    li t0, 4
    sd t0, 0(s2)
    sd t0, 8(s2)

    li a0, 48
    call rt_alloc
    mv s3, a0
    li t0, 4
    sd t0, 0(s3)
    sd t0, 8(s3)

    fld fa0, 16(s1)
    fld fa1, 24(s1)
    fld fa2, 32(s1)
    fld fa3, 40(s1)

    fadd.d ft0, fa0, fa1
    fadd.d ft1, fa2, fa3
    fsd ft0, 16(s2)
    fsd ft1, 24(s2)
    fsd ft0, 32(s2)
    fsd ft1, 40(s2)

    fld fa0, 16(s0)
    fld fa1, 24(s0)
    fld fa2, 32(s0)
    fld fa3, 40(s0)

    fadd.d ft0, fa0, fa2
    fadd.d ft1, fa1, fa3
    fsd ft0, 16(s3)
    fsd ft0, 24(s3)
    fsd ft1, 32(s3)
    fsd ft1, 40(s3)

    sd s2, 8(s0)
    sd s3, 8(s1)

.Lback_exit:
    ld ra, 0(sp)
    ld s0, 8(sp)
    ld s1, 16(sp)
    ld s2, 24(sp)
    ld s3, 32(sp)
    addi sp, sp, 48
    ret
.size rt_backward, .-rt_backward

.globl _start
.type _start, %function
.p2align 2
_start:
    jal ra, __vir_global_init
    jal ra, ")
    b = bvec_emit_cstr(b, entry_name)
    b = bvec_emit_cstr(b, "
    li a7, 93
    ecall
.size _start, .-_start

.section .bss
.p2align 3
_vir_heap_start:
    .space 1048576
_vir_heap_curr:
    .quad 0
_vir_globals:
    .space 32768
_vir_train_active:
    .quad 0
_vir_train_w:
    .quad 0
_vir_train_x:
    .quad 0
")
    out b
end.
