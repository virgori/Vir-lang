include types_prelude
include rt_string_rt
import bvec_push from rt_vec_rt
include mc_printer_helpers

func print_mc_stubs_arm64_darwin(b: int) -> int:
        b = bvec_emit_cstr(b, ".globl _rt_exit
.p2align 2
_rt_exit:
")
        b = bvec_emit_cstr(b, "    mov x16, #1
    movk x16, #0x200, lsl #16
    svc #0x80
    ret

")

        b = bvec_emit_cstr(b, ".globl _rt_print_int
.p2align 2
_rt_print_int:
")
        b = bvec_emit_cstr(b, "    sub sp, sp, #128
")
        b = bvec_emit_cstr(b, "    str x1, [sp, #0]
    str x2, [sp, #8]
    str x3, [sp, #16]
")
        b = bvec_emit_cstr(b, "    str x4, [sp, #24]
    str x5, [sp, #32]
    str x6, [sp, #40]
    str x16, [sp, #48]
")
        b = bvec_emit_cstr(b, "    mov x2, #10
    mov x3, #10
    strb w2, [sp, #127]
")
        b = bvec_emit_cstr(b, "    cmp x0, #0
    b.ne 1f
")
        b = bvec_emit_cstr(b, "    mov x2, #48
    strb w2, [sp, #126]
")
        b = bvec_emit_cstr(b, "    mov x0, #1
    add x1, sp, #126
    mov x2, #2
    b 5f
")
        b = bvec_emit_cstr(b, "1:
    add x1, sp, #127
    cmp x0, #0
    cset x4, lt
    cmp x4, #0
    b.eq 2f
    neg x0, x0
")
        b = bvec_emit_cstr(b, "2:
    udiv x5, x0, x3
    msub x6, x5, x3, x0
    add x6, x6, #48
    sub x1, x1, #1
    strb w6, [x1]
")
        b = bvec_emit_cstr(b, "    mov x0, x5
    cmp x0, #0
    b.ne 2b
")
        b = bvec_emit_cstr(b, "    cmp x4, #0
    b.eq 3f
    mov x6, #45
    sub x1, x1, #1
    strb w6, [x1]
")
        b = bvec_emit_cstr(b, "3:
    mov x2, x1
    add x5, sp, #128
    sub x3, x5, x1
    mov x0, #1
    mov x1, x2
    mov x2, x3
")
        b = bvec_emit_cstr(b, "5:
    mov x16, #4
    movk x16, #0x200, lsl #16
    svc #0x80
")
        b = bvec_emit_cstr(b, "    ldr x1, [sp, #0]
    ldr x2, [sp, #8]
    ldr x3, [sp, #16]
")
        b = bvec_emit_cstr(b, "    ldr x4, [sp, #24]
    ldr x5, [sp, #32]
    ldr x6, [sp, #40]
    ldr x16, [sp, #48]
")
        b = bvec_emit_cstr(b, "    add sp, sp, #128
    ret

")

        b = bvec_emit_cstr(b, ".globl _rt_print_str
.p2align 2
_rt_print_str:
")
        b = bvec_emit_cstr(b, "    stp fp, lr, [sp, #-16]!
    mov fp, sp
    sub sp, sp, #32
")
        b = bvec_emit_cstr(b, "    str x19, [sp, #0]
    str x20, [sp, #8]
    mov x19, x0
    mov x20, #0
")
        b = bvec_emit_cstr(b, "1:
    ldrb w1, [x19, x20]
    cbz w1, 2f
    add x20, x20, #1
    b 1b
")
        b = bvec_emit_cstr(b, "2:
    mov x0, #1
    mov x1, x19
    mov x2, x20
    mov x16, #4
    movk x16, #0x200, lsl #16
    svc #0x80
    mov w3, #10
    strb w3, [sp, #16]
    mov x0, #1
    add x1, sp, #16
    mov x2, #1
    mov x16, #4
    movk x16, #0x200, lsl #16
    svc #0x80
")
        b = bvec_emit_cstr(b, "    ldr x19, [sp, #0]
    ldr x20, [sp, #8]
    add sp, sp, #32
    ldp fp, lr, [sp], #16
    ret
")
        b = bvec_emit_cstr(b, ".globl _rt_str_cat
.p2align 2
_rt_str_cat:
    mov x9, x0
1:  ldrb w13, [x9]
    cbz w13, 2f
    add x9, x9, #1
    b 1b
2:  sub x2, x9, x0
    mov x10, x1
3:  ldrb w13, [x10]
    cbz w13, 4f
    add x10, x10, #1
    b 3b
4:  sub x3, x10, x1
    add x4, x2, x3
    add x4, x4, #8
    and x4, x4, #-8
    adrp x14, _vir_heap_curr@PAGE
    add x14, x14, _vir_heap_curr@PAGEOFF
    ldr x11, [x14]
    cbnz x11, 5f
    adrp x11, _vir_heap_start@PAGE
    add x11, x11, _vir_heap_start@PAGEOFF
5:  add x12, x11, x4
    str x12, [x14]
    mov x12, x11
    mov x9, x0
6:  ldrb w13, [x9]
    cbz w13, 7f
    strb w13, [x12]
    add x9, x9, #1
    add x12, x12, #1
    b 6b
7:  mov x10, x1
8:  ldrb w13, [x10]
    cbz w13, 9f
    strb w13, [x12]
    add x10, x10, #1
    add x12, x12, #1
    b 8b
9:  strb wzr, [x12]
    mov x0, x11
    ret

.globl _rt_int_to_str
.p2align 2
_rt_int_to_str:
    adrp x14, _vir_heap_curr@PAGE
    add x14, x14, _vir_heap_curr@PAGEOFF
    ldr x11, [x14]
    cbnz x11, 1f
    adrp x11, _vir_heap_start@PAGE
    add x11, x11, _vir_heap_start@PAGEOFF
1:  add x12, x11, #32
    str x12, [x14]
    add x10, x11, #31
    strb wzr, [x10]
    mov x9, x0
    mov x12, #0
    cmp x9, #0
    b.ge 2f
    mov x12, #1
    neg x9, x9
2:  mov x15, #10
3:  udiv x13, x9, x15
    msub x14, x13, x15, x9
    add x14, x14, #48
    sub x10, x10, #1
    strb w14, [x10]
    mov x9, x13
    cbnz x9, 3b
    cbz x12, 4f
    mov x15, #45
    sub x10, x10, #1
    strb w15, [x10]
4:  mov x0, x10
    ret

.globl _rt_bool_to_str
.p2align 2
_rt_bool_to_str:
    mov x9, x0
    adrp x14, _vir_heap_curr@PAGE
    add x14, x14, _vir_heap_curr@PAGEOFF
    ldr x11, [x14]
    cbnz x11, 1f
    adrp x11, _vir_heap_start@PAGE
    add x11, x11, _vir_heap_start@PAGEOFF
1:  add x12, x11, #8
    str x12, [x14]
    cbz x9, 2f
    movz x13, #0x7274
    movk x13, #0x6575, lsl #16
    str x13, [x11]
    mov x0, x11
    ret
2:  movz x13, #0x6166
    movk x13, #0x736c, lsl #16
    movk x13, #0x0065, lsl #32
    str x13, [x11]
    mov x0, x11
    ret

.section __DATA,__bss
.p2align 3
_vir_heap_start:
    .space 1048576
_vir_heap_curr:
    .quad 0
")
    out b
end.

func print_mc_stubs_arm64_gnu(b: int, entry_name: int) -> int:
        b = bvec_emit_cstr(b, ".globl rt_exit
.type rt_exit, %function
.p2align 2
rt_exit:
")
        b = bvec_emit_cstr(b, "    mov x8, #93
    svc #0
    ret
.size rt_exit, .-rt_exit

")

        b = bvec_emit_cstr(b, ".globl rt_print_int
.type rt_print_int, %function
.p2align 2
rt_print_int:
")
        b = bvec_emit_cstr(b, "    sub sp, sp, #128
")
        b = bvec_emit_cstr(b, "    str x1, [sp, #0]
    str x2, [sp, #8]
    str x3, [sp, #16]
")
        b = bvec_emit_cstr(b, "    str x4, [sp, #24]
    str x5, [sp, #32]
    str x6, [sp, #40]
")
        b = bvec_emit_cstr(b, "    mov x2, #10
    mov x3, #10
    strb w2, [sp, #127]
")
        b = bvec_emit_cstr(b, "    cmp x0, #0
    b.ne .L_print_nz
")
        b = bvec_emit_cstr(b, "    mov x2, #48
    strb w2, [sp, #126]
")
        b = bvec_emit_cstr(b, "    mov x0, #1
    add x1, sp, #126
    mov x2, #2
    b .L_print_sc
")
        b = bvec_emit_cstr(b, ".L_print_nz:
    add x1, sp, #127
    cmp x0, #0
    cset x4, lt
    cmp x4, #0
    b.eq .L_print_lp
    neg x0, x0
")
        b = bvec_emit_cstr(b, ".L_print_lp:
    sdiv x5, x0, x3
    msub x6, x5, x3, x0
    add x6, x6, #48
    sub x1, x1, #1
    strb w6, [x1]
")
        b = bvec_emit_cstr(b, "    mov x0, x5
    cmp x0, #0
    b.ne .L_print_lp
")
        b = bvec_emit_cstr(b, "    cmp x4, #0
    b.eq .L_print_fn
    mov x6, #45
    sub x1, x1, #1
    strb w6, [x1]
")
        b = bvec_emit_cstr(b, ".L_print_fn:
    mov x2, x1
    add x5, sp, #128
    sub x3, x5, x1
    mov x0, #1
    mov x1, x2
    mov x2, x3
")
        b = bvec_emit_cstr(b, ".L_print_sc:
    mov x8, #64
    svc #0
")
        b = bvec_emit_cstr(b, "    ldr x1, [sp, #0]
    ldr x2, [sp, #8]
    ldr x3, [sp, #16]
")
        b = bvec_emit_cstr(b, "    ldr x4, [sp, #24]
    ldr x5, [sp, #32]
    ldr x6, [sp, #40]
")
        b = bvec_emit_cstr(b, "    add sp, sp, #128
    ret
.size rt_print_int, .-rt_print_int

")

        b = bvec_emit_cstr(b, ".globl rt_print_str
.type rt_print_str, %function
.p2align 2
rt_print_str:
")
        b = bvec_emit_cstr(b, "    stp fp, lr, [sp, #-16]!
    mov fp, sp
    sub sp, sp, #32
")
        b = bvec_emit_cstr(b, "    str x19, [sp, #0]
    str x20, [sp, #8]
    mov x19, x0
    mov x20, #0
")
        b = bvec_emit_cstr(b, ".L_pstr_1:
    ldrb w1, [x19, x20]
    cbz w1, .L_pstr_2
    add x20, x20, #1
    b .L_pstr_1
")
        b = bvec_emit_cstr(b, ".L_pstr_2:
    mov x0, #1
    mov x1, x19
    mov x2, x20
    mov x8, #64
    svc #0
    mov w3, #10
    strb w3, [sp, #16]
    mov x0, #1
    add x1, sp, #16
    mov x2, #1
    mov x8, #64
    svc #0
")
        b = bvec_emit_cstr(b, "    ldr x19, [sp, #0]
    ldr x20, [sp, #8]
    add sp, sp, #32
    ldp fp, lr, [sp], #16
    ret
.size rt_print_str, .-rt_print_str
")
        b = bvec_emit_cstr(b, ".globl rt_str_eq
.type rt_str_eq, %function
.p2align 2
rt_str_eq:
.L_gelf_seq_loop:
    ldrb w9, [x0]
    ldrb w10, [x1]
    cmp w9, w10
    b.ne .L_gelf_seq_false
    cbz w9, .L_gelf_seq_true
    add x0, x0, #1
    add x1, x1, #1
    b .L_gelf_seq_loop
.L_gelf_seq_false:
    mov x0, #0
    ret
.L_gelf_seq_true:
    mov x0, #1
    ret
.size rt_str_eq, .-rt_str_eq

.globl rt_alloc
.type rt_alloc, %function
.p2align 2
rt_alloc:
    add x9, x0, #15
    and x9, x9, #-16
    adrp x10, _vir_heap_curr
    add x10, x10, :lo12:_vir_heap_curr
    ldr x0, [x10]
    cbnz x0, .L_gelf_alloc_ready
    adrp x0, _vir_heap_start
    add x0, x0, :lo12:_vir_heap_start
.L_gelf_alloc_ready:
    add x11, x0, x9
    str x11, [x10]
    ret
.size rt_alloc, .-rt_alloc

")
        b = bvec_emit_cstr(b, ".globl rt_str_cat
.type rt_str_cat, %function
.p2align 2
rt_str_cat:
    mov x9, x0
.L_gelf_ca1:
    ldrb w13, [x9]
    cbz w13, .L_gelf_ca2
    add x9, x9, #1
    b .L_gelf_ca1
.L_gelf_ca2:
    sub x2, x9, x0
    mov x10, x1
.L_gelf_cb1:
    ldrb w13, [x10]
    cbz w13, .L_gelf_cb2
    add x10, x10, #1
    b .L_gelf_cb1
.L_gelf_cb2:
    sub x3, x10, x1
    add x4, x2, x3
    add x4, x4, #8
    and x4, x4, #-8
    adrp x14, _vir_heap_curr
    add x14, x14, :lo12:_vir_heap_curr
    ldr x11, [x14]
    cbnz x11, .L_gelf_ch1
    adrp x11, _vir_heap_start
    add x11, x11, :lo12:_vir_heap_start
.L_gelf_ch1:
    add x12, x11, x4
    str x12, [x14]
    mov x12, x11
    mov x9, x0
.L_gelf_cca:
    ldrb w13, [x9]
    cbz w13, .L_gelf_ccb
    strb w13, [x12]
    add x9, x9, #1
    add x12, x12, #1
    b .L_gelf_cca
.L_gelf_ccb:
    mov x10, x1
.L_gelf_ccb1:
    ldrb w13, [x10]
    cbz w13, .L_gelf_cce
    strb w13, [x12]
    add x10, x10, #1
    add x12, x12, #1
    b .L_gelf_ccb1
.L_gelf_cce:
    strb wzr, [x12]
    mov x0, x11
    ret
.size rt_str_cat, .-rt_str_cat

.globl rt_int_to_str
.type rt_int_to_str, %function
.p2align 2
rt_int_to_str:
    adrp x14, _vir_heap_curr
    add x14, x14, :lo12:_vir_heap_curr
    ldr x11, [x14]
    cbnz x11, .L_gelf_ih1
    adrp x11, _vir_heap_start
    add x11, x11, :lo12:_vir_heap_start
.L_gelf_ih1:
    add x12, x11, #32
    str x12, [x14]
    add x10, x11, #31
    strb wzr, [x10]
    mov x9, x0
    mov x12, #0
    cmp x9, #0
    b.ge .L_gelf_ipos
    mov x12, #1
    neg x9, x9
.L_gelf_ipos:
    mov x15, #10
.L_gelf_iloop:
    udiv x13, x9, x15
    msub x14, x13, x15, x9
    add x14, x14, #48
    sub x10, x10, #1
    strb w14, [x10]
    mov x9, x13
    cbnz x9, .L_gelf_iloop
    cbz x12, .L_gelf_idone
    mov x15, #45
    sub x10, x10, #1
    strb w15, [x10]
.L_gelf_idone:
    mov x0, x10
    ret
.size rt_int_to_str, .-rt_int_to_str

.globl rt_bool_to_str
.type rt_bool_to_str, %function
.p2align 2
rt_bool_to_str:
    cbz x0, .L_gelf_bool_false
    adr x0, .L_gelf_bool_true_text
    ret
.L_gelf_bool_false:
    adr x0, .L_gelf_bool_false_text
    ret
.L_gelf_bool_true_text:
    .asciz \"true\"
.L_gelf_bool_false_text:
    .asciz \"false\"

.globl _start
.type _start, %function
.p2align 2
_start:
    bl __vir_global_init
    bl ")
    b = bvec_emit_cstr(b, entry_name)
    b = bvec_emit_cstr(b, "
    mov x8, #93
    svc #0
.size _start, .-_start

.section .bss
.p2align 3
_vir_heap_start:
    .space 1048576
_vir_heap_curr:
    .quad 0
_vir_globals:
    .space 32768
")
    out b
end.
