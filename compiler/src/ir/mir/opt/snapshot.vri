##
 * compiler/src/ir/mir/opt/snapshot.vri — MIR structure snapshots and CFG/SSA verifier
 * ====================================================================================
 * VIRC-ISS-0001 / VIRC-PLN-0001: deterministic before/after structure evidence for
 * the production PRE and loop transforms, plus a CFG/SSA verifier.
 *
 * Snapshot grammar (one block per ` | ` segment, instructions joined by `;`):
 *   B<id> succ=<ids|-> phi=<v:incoming@pred,...;...|-> ins=<Op dst src1 src2;...>
 * Operands print as `v<N>` (vreg), `#<N>` (immediate), `B<N>` or `_` (none).
 ##

include types_prelude
include rt_vec_rt
include rt_string_rt
include mir
include mir_opt_context
include mir_opt_verifier_common

func mirOpName(op: i64) -> string:
    if op == MirOp.Nop do out "Nop" end
    if op == MirOp.Move do out "Move" end
    if op == MirOp.Load do out "Load" end
    if op == MirOp.Store do out "Store" end
    if op == MirOp.Add do out "Add" end
    if op == MirOp.Sub do out "Sub" end
    if op == MirOp.Mul do out "Mul" end
    if op == MirOp.Div do out "Div" end
    if op == MirOp.Call do out "Call" end
    if op == MirOp.Intrinsic do out "Intrinsic" end
    if op == MirOp.Jump do out "Jump" end
    if op == MirOp.JumpIf do out "JumpIf" end
    if op == MirOp.Return do out "Return" end
    if op == MirOp.CmpEq do out "CmpEq" end
    if op == MirOp.CmpNe do out "CmpNe" end
    if op == MirOp.CmpGt do out "CmpGt" end
    if op == MirOp.CmpLt do out "CmpLt" end
    if op == MirOp.CmpGe do out "CmpGe" end
    if op == MirOp.CmpLe do out "CmpLe" end
    if op == MirOp.Mod do out "Mod" end
    if op == MirOp.SetArg do out "SetArg" end
    if op == MirOp.JumpIfNot do out "JumpIfNot" end
    if op == MirOp.And do out "And" end
    if op == MirOp.Or do out "Or" end
    if op == MirOp.Xor do out "Xor" end
    if op == MirOp.Shl do out "Shl" end
    if op == MirOp.Shr do out "Shr" end
    if op == MirOp.Not do out "Not" end
    if op == MirOp.Pow do out "Pow" end
    if op == MirOp.MatMul do out "MatMul" end
    if op == MirOp.Fma do out "Fma" end
    out "Vec"
end.

func mirSnapshotOperand(sb: StringBuilder, opnd: i64) -> StringBuilder:
    let kind = mir_opnd_type(opnd)
    if kind == MirOperandType.VReg do
        out sb_append_int(sb_append(sb, "v"), mir_opnd_vreg_id(opnd))
    end
    if kind == MirOperandType.Imm do
        out sb_append_int(sb_append(sb, "#"), mir_opnd_imm_val(opnd))
    end
    if kind == MirOperandType.Block do
        out sb_append_int(sb_append(sb, "B"), mir_opnd_block_id(opnd))
    end
    out sb_append(sb, "_")
end.

func mirPushUnique(items: i64, value: i64) -> i64:
    var at = 0
    let count = vec_len_rt(items)
    when at < count loop
        if vec_get_rt(items, at) == value do out items end
        at = at + 1
    end
    out vec_push_rt(items, value)
end.

func mirBlockEdgeTargets(blocks: i64, index: int) -> i64:
    var targets = vec_new_rt()
    let blockCount = vec_len_rt(blocks)
    let instrs = mir_block_head(vec_get_rt(blocks, index))
    var lastOp = MirOp.Nop as i64
    if instrs >= 0 do
        let count = vec_len_rt(instrs)
        var at = 0
        when at < count loop
            let ins = vec_get_rt(instrs, at)
            let op = mir_instr_op(ins)
            if op == MirOp.Jump do
                let operand = mir_instr_src1(ins)
                targets = mirPushUnique(targets, mir_find_block_index(blocks, mir_opnd_imm_val(operand)))
            eif op == MirOp.JumpIf or op == MirOp.JumpIfNot do
                let operand = mir_instr_src2(ins)
                targets = mirPushUnique(targets, mir_find_block_index(blocks, mir_opnd_imm_val(operand)))
            end
            if op != MirOp.Nop do lastOp = op end
            at = at + 1
        end
    end
    if lastOp != MirOp.Jump and lastOp != MirOp.Return do
        if index + 1 < blockCount do
            targets = mirPushUnique(targets, index + 1)
        else
            targets = mirPushUnique(targets, 0 - 2)
        end
    end
    out targets
end.

func mirSnapshotBlocks(blocks: i64) -> i64:
    var sb = sb_new()
    let blockCount = vec_len_rt(blocks)
    var index = 0
    when index < blockCount loop
        let block = vec_get_rt(blocks, index)
        if index > 0 do sb = sb_append(sb, " | ") end
        sb = sb_append_int(sb_append(sb, "B"), mir_block_id(block))

        sb = sb_append(sb, " succ=")
        let edges = mirBlockEdgeTargets(blocks, index)
        var edgeAt = 0
        if vec_len_rt(edges) == 0 do sb = sb_append(sb, "-") end
        when edgeAt < vec_len_rt(edges) loop
            if edgeAt > 0 do sb = sb_append(sb, ",") end
            let target = vec_get_rt(edges, edgeAt)
            if target >= 0 do
                sb = sb_append_int(sb, mir_block_id(vec_get_rt(blocks, target)))
            else
                sb = sb_append(sb, "!")
            end
            edgeAt = edgeAt + 1
        end

        sb = sb_append(sb, " phi=")
        let phis = mir_block_phis(block)
        if phis < 0 or vec_len_rt(phis) == 0 do
            sb = sb_append(sb, "-")
        else
            var phiAt = 0
            when phiAt < vec_len_rt(phis) loop
                let phi = vec_get_rt(phis, phiAt)
                if phiAt > 0 do sb = sb_append(sb, ";") end
                sb = sb_append_int(sb_append(sb, "v"), mir_phi_dst(phi))
                sb = sb_append(sb, ":")
                let values = mir_phi_incoming_values(phi)
                let preds = mir_phi_incoming_blocks(phi)
                var incomingAt = 0
                when incomingAt < vec_len_rt(values) loop
                    if incomingAt > 0 do sb = sb_append(sb, ",") end
                    sb = mirSnapshotOperand(sb, vec_get_rt(values, incomingAt))
                    sb = sb_append_int(sb_append(sb, "@"), vec_get_rt(preds, incomingAt))
                    incomingAt = incomingAt + 1
                end
                phiAt = phiAt + 1
            end
        end

        sb = sb_append(sb, " ins=")
        let instrs = mir_block_head(block)
        if instrs < 0 or vec_len_rt(instrs) == 0 do
            sb = sb_append(sb, "-")
        else
            var insAt = 0
            when insAt < vec_len_rt(instrs) loop
                let ins = vec_get_rt(instrs, insAt)
                if insAt > 0 do sb = sb_append(sb, ";") end
                sb = sb_append(sb, mirOpName(mir_instr_op(ins)))
                sb = mirSnapshotOperand(sb_append(sb, " "), mir_instr_dst(ins))
                sb = mirSnapshotOperand(sb_append(sb, " "), mir_instr_src1(ins))
                sb = mirSnapshotOperand(sb_append(sb, " "), mir_instr_src2(ins))
                insAt = insAt + 1
            end
        end
        index = index + 1
    end
    out sb_to_string(sb)
end.

# Vector ops (VLoad..Shuffle) use their dst operand as a use, not a definition.
func mirOpDefinesDst(op: i64) -> bool:
    if op >= MirOp.VLoad as i64 and op <= MirOp.Shuffle as i64 do
        out false
    end
    out true
end.

# CFG/SSA verifier for production MIR transforms.
# Verifies:
#   1. block IDs are unique and all jump/branch targets resolve.
#   2. phi node arity and incoming block IDs match actual CFG predecessors.
#   3. single-definition invariant of SSA is preserved.
#   4. variable definitions dominate their uses.
func mirVerifyCfgSsa(blocks: i64) -> bool:
    g_mir_verify_reason = ""
    g_mir_verify_block = 0 - 1
    g_mir_verify_instr = 0 - 1
    g_mir_verify_origin = 0 - 1
    let n_blocks = vec_len_rt(blocks)
    if n_blocks == 0 do out true end

    # 1. Verify block IDs are unique and branch targets exist
    var b_idx = 0
    when b_idx < n_blocks loop
        let b = vec_get_rt(blocks, b_idx)
        let b_id = mir_block_id(b)
        if mir_find_block_index(blocks, b_id) != b_idx do
            out mir_verify_fail("cfg: duplicate block id", b_idx, 0 - 1, b_id)
        end
        let instrs = mir_block_head(b)
        if instrs >= 0 do
            let ni = vec_len_rt(instrs)
            var ii = 0
            when ii < ni loop
                let ins = vec_get_rt(instrs, ii)
                let op = mir_instr_op(ins)
                if op == MirOp.Jump do
                    let tgt = mir_instr_src1(ins)
                    if mir_opnd_type(tgt) == MirOperandType.Imm do
                        if mir_find_block_index(blocks, mir_opnd_imm_val(tgt)) < 0 do
                            out mir_verify_fail("cfg: unresolved jump target", b_idx, ii, mir_opnd_imm_val(tgt))
                        end
                    end
                eif op == MirOp.JumpIf or op == MirOp.JumpIfNot do
                    let tgt2 = mir_instr_src2(ins)
                    if mir_opnd_type(tgt2) == MirOperandType.Imm do
                        if mir_find_block_index(blocks, mir_opnd_imm_val(tgt2)) < 0 do
                            out mir_verify_fail("cfg: unresolved branch target", b_idx, ii, mir_opnd_imm_val(tgt2))
                        end
                    end
                end
                ii = ii + 1
            end
        end
        b_idx = b_idx + 1
    end

    # 2. Verify phi predecessors match CFG predecessors
    b_idx = 0
    when b_idx < n_blocks loop
        let b = vec_get_rt(blocks, b_idx)
        let phis = mir_block_phis(b)
        let preds = mir_block_preds(b)
        let n_preds = vec_len_rt(preds)
        if phis >= 0 and vec_len_rt(phis) > 0 do
            let n_phis = vec_len_rt(phis)
            var pi = 0
            when pi < n_phis loop
                let phi = vec_get_rt(phis, pi)
                let inc_blks = mir_phi_incoming_blocks(phi)
                let n_inc = vec_len_rt(inc_blks)
                if n_inc != n_preds do
                    out mir_verify_fail("ssa: phi incoming arity differs from pred count", b_idx, 0 - 1, mir_phi_dst(phi))
                end
                # Each incoming block must be an actual predecessor
                var ik = 0
                when ik < n_inc loop
                    let inc_bid = vec_get_rt(inc_blks, ik)
                    var found = false
                    var pk = 0
                    when pk < n_preds loop
                        let pred_bidx = vec_get_rt(preds, pk)
                        if pred_bidx >= 0 and pred_bidx < n_blocks do
                            if mir_block_id(vec_get_rt(blocks, pred_bidx)) == inc_bid do
                                found = true
                            end
                        end
                        pk = pk + 1
                    end
                    if not found do
                        out mir_verify_fail("ssa: phi incoming block is not a cfg predecessor", b_idx, 0 - 1, inc_bid)
                    end
                    ik = ik + 1
                end
                pi = pi + 1
            end
        end
        b_idx = b_idx + 1
    end

    # 3. Verify single definition rule for SSA
    let max_v = max_vreg_mir(blocks)
    var def_counts = vec_new_rt()
    var def_block = vec_new_rt()
    var def_pos = vec_new_rt()
    var vi = 0
    when vi <= max_v loop
        def_counts = vec_push_rt(def_counts, 0 as i64)
        def_block = vec_push_rt(def_block, 0 - 1)
        def_pos = vec_push_rt(def_pos, 0 - 1)
        vi = vi + 1
    end

    b_idx = 0
    when b_idx < n_blocks loop
        let b = vec_get_rt(blocks, b_idx)
        let phis = mir_block_phis(b)
        if phis >= 0 do
            let n_phis = vec_len_rt(phis)
            var pi = 0
            when pi < n_phis loop
                let phi_dst = mir_phi_dst(vec_get_rt(phis, pi))
                if phi_dst >= 0 and phi_dst <= max_v do
                    let prev = vec_get_rt(def_counts, phi_dst)
                    if prev > 0 do
                        out mir_verify_fail("ssa: vreg defined more than once (phi)", b_idx, 0 - 1, phi_dst)
                    end
                    vec_set_rt(def_counts, phi_dst, 1 as i64)
                    vec_set_rt(def_block, phi_dst, b_idx)
                    vec_set_rt(def_pos, phi_dst, 0 - 1)
                end
                pi = pi + 1
            end
        end
        let instrs = mir_block_head(b)
        if instrs >= 0 do
            let ni = vec_len_rt(instrs)
            var ii = 0
            when ii < ni loop
                let ins = vec_get_rt(instrs, ii)
                let dst = mir_instr_dst(ins)
                if mir_opnd_type(dst) == MirOperandType.VReg and mirOpDefinesDst(mir_instr_op(ins)) do
                    let vid = mir_opnd_vreg_id(dst)
                    if vid >= 0 and vid <= max_v do
                        let prev = vec_get_rt(def_counts, vid)
                        if prev > 0 do
                            out mir_verify_fail("ssa: vreg defined more than once (instruction)", b_idx, ii, vid)
                        end
                        vec_set_rt(def_counts, vid, 1 as i64)
                        vec_set_rt(def_block, vid, b_idx)
                        vec_set_rt(def_pos, vid, ii)
                    end
                end
                ii = ii + 1
            end
        end
        b_idx = b_idx + 1
    end

    # 4. Verify dominance for uses
    b_idx = 0
    when b_idx < n_blocks loop
        let b = vec_get_rt(blocks, b_idx)
        let instrs = mir_block_head(b)
        if instrs >= 0 do
            let ni = vec_len_rt(instrs)
            var ii = 0
            when ii < ni loop
                let ins = vec_get_rt(instrs, ii)
                var slot = 0
                when slot < 2 loop
                    var opnd = mir_instr_src1(ins)
                    if slot == 1 do opnd = mir_instr_src2(ins) end
                    if mir_opnd_type(opnd) == MirOperandType.VReg do
                        let vid = mir_opnd_vreg_id(opnd)
                        if vid >= 0 and vid <= max_v do
                            if vec_get_rt(def_counts, vid) == 1 do
                                let d_bidx = vec_get_rt(def_block, vid)
                                if d_bidx == b_idx do
                                    let d_pos = vec_get_rt(def_pos, vid)
                                    if d_pos >= ii do
                                        out mir_verify_fail("ssa: use precedes definition in block", b_idx, ii, vid)
                                    end
                                else
                                    if not mir_block_dominates(blocks, n_blocks, d_bidx, b_idx) do
                                        out mir_verify_fail("ssa: definition does not dominate use", b_idx, ii, vid)
                                    end
                                end
                            end
                        end
                    end
                    slot = slot + 1
                end
                ii = ii + 1
            end
        end
        b_idx = b_idx + 1
    end

    vec_free_rt(def_counts)
    vec_free_rt(def_block)
    vec_free_rt(def_pos)
    out true
end.

export mirOpName, mirSnapshotBlocks, mirVerifyCfgSsa
