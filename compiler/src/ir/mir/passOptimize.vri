##
 * compiler/src/ir/mir/passOptimize.vri — MIR Optimization Pass Orchestrator
 * =========================================================================
 * VIRC-PLN-0003 Section 5.4 & 5.7: Pass Architecture & MIR Optimize Orchestrator.
 *
 * Owns Pass ID, stage metadata, transform ordering, and -O capability guards.
 * Delegates scalar/control/loop/memory transformations to dedicated leaf modules.
 ##

include types
include compiler.mir_opt_pipeline
import mir_opt_run_spec_pipeline, mir_optimize_all, set_mir_opt_level, get_mir_opt_level from compiler.mir_opt_pipeline

# ═══════════════════════════════════════════════════════
# Pass Metadata
# ═══════════════════════════════════════════════════════

const PASS_OPTIMIZE_ID: string = "virc.ir.mir.optimize"
const PASS_OPTIMIZE_STAGE: int = 12
const PASS_OPTIMIZE_NAME: string = "MIR Optimization Pass"

# ═══════════════════════════════════════════════════════
# Orchestrator Entry Points
# ═══════════════════════════════════════════════════════

func passOptimizeRun(blocks: i64, opt_level: int) -> i64:
    # Orchestrates MIR optimizations according to -O optimization level
    out mir_opt_run_spec_pipeline(blocks, opt_level)
end.

func pass_optimize_run(blocks: i64, opt_level: int) -> i64:
    out passOptimizeRun(blocks, opt_level)
end.

func passOptimizeAll(blocks: i64) -> i64:
    out mir_optimize_all(blocks)
end.

export PASS_OPTIMIZE_ID, PASS_OPTIMIZE_STAGE, PASS_OPTIMIZE_NAME,
       passOptimizeRun, pass_optimize_run, passOptimizeAll,
       mir_optimize_all, mir_opt_run_spec_pipeline,
       set_mir_opt_level, get_mir_opt_level
