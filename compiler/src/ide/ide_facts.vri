# Compiler-owned facts keyed by AST identity. Capture is disabled for normal builds.
include vec_rt
include string_rt
include alloc

var g_ideFactsEnabled: int = 0
var g_ideFacts: int = 0
var g_ideFactEvent: int = 0
var g_ideFactSlots: int = 0
var g_ideFactCapacity: int = 0
var g_ideTypeUses: int = 0
var g_ideBindingSlots: int = 0
var g_ideBindingCapacity: int = 0
var g_ideBindingCount: int = 0

func ideBindingHash(key: int) -> int:
    let data = native_read_i64(key, 0)
    let length = native_read_i64(key, 8)
    var hash = 0
    var index = 0
    when index < length loop
        hash = ((hash * 131) + native_read_u8(data, index)) and 2147483647
        index = index + 1
    end
    out hash
end.

func ideBindingInsert(key: int, fact: int):
    var slot = ideBindingHash(key) and (g_ideBindingCapacity - 1)
    when native_read_i64(g_ideBindingSlots, slot * 16) != 0 loop
        let existingKey = native_read_i64(g_ideBindingSlots, slot * 16)
        if fat_str_eq(existingKey as string, key as string) == 1 do
            native_write_i64(g_ideBindingSlots, slot * 16 + 8, fact)
            out
        end
        slot = (slot + 1) and (g_ideBindingCapacity - 1)
    end
    native_write_i64(g_ideBindingSlots, slot * 16, key)
    native_write_i64(g_ideBindingSlots, slot * 16 + 8, fact)
    g_ideBindingCount = g_ideBindingCount + 1
end.

func ideBindingCapture(fact: int):
    let key = native_read_i64(fact, 48)
    if key == 0 do out end
    if g_ideBindingCapacity == 0 or (g_ideBindingCount + 1) * 2 >= g_ideBindingCapacity do
        let oldSlots = g_ideBindingSlots
        let oldCapacity = g_ideBindingCapacity
        var capacity = oldCapacity * 2
        if capacity < 1024 do capacity = 1024 end
        g_ideBindingSlots = vir_alloc(capacity * 16)
        g_ideBindingCapacity = capacity
        g_ideBindingCount = 0
        var index = 0
        when index < capacity loop
            native_write_i64(g_ideBindingSlots, index * 16, 0)
            native_write_i64(g_ideBindingSlots, index * 16 + 8, 0)
            index = index + 1
        end
        index = 0
        when index < oldCapacity loop
            let oldKey = native_read_i64(oldSlots, index * 16)
            if oldKey != 0 do ideBindingInsert(oldKey, native_read_i64(oldSlots, index * 16 + 8)) end
            index = index + 1
        end
        if oldSlots != 0 do vir_free(oldSlots) end
    end
    ideBindingInsert(key, fact)
end.

func ideBindingLatest(key: int) -> int:
    if g_ideBindingCapacity == 0 do out 0 end
    var slot = ideBindingHash(key) and (g_ideBindingCapacity - 1)
    var probes = 0
    when probes < g_ideBindingCapacity loop
        let existingKey = native_read_i64(g_ideBindingSlots, slot * 16)
        if existingKey == 0 do out 0 end
        if fat_str_eq(existingKey as string, key as string) == 1 do
            out native_read_i64(g_ideBindingSlots, slot * 16 + 8)
        end
        slot = (slot + 1) and (g_ideBindingCapacity - 1)
        probes = probes + 1
    end
    out 0
end.

# AST addresses are stable for the lifetime of a compiler snapshot. Keep the
# ordered vector for serialization, and index it for constant-time capture.
func ideFactIndexInsert(factEntry: int):
    let node = native_read_i64(factEntry, 0)
    var slot = (node shr 4) and (g_ideFactCapacity - 1)
    when native_read_i64(g_ideFactSlots, slot * 8) != 0 loop
        slot = (slot + 1) and (g_ideFactCapacity - 1)
    end
    native_write_i64(g_ideFactSlots, slot * 8, factEntry)
end.

func ideFactReserve():
    if g_ideFactCapacity > 0 do
        if (vec_len_rt(g_ideFacts) + 1) * 2 < g_ideFactCapacity do out end
    end
    let oldSlots = g_ideFactSlots
    var capacity = g_ideFactCapacity * 2
    if capacity < 1024 do capacity = 1024 end
    g_ideFactSlots = vir_alloc(capacity * 8)
    g_ideFactCapacity = capacity
    var index = 0
    when index < capacity loop
        native_write_i64(g_ideFactSlots, index * 8, 0)
        index = index + 1
    end
    index = 0
    when index < vec_len_rt(g_ideFacts) loop
        ideFactIndexInsert(vec_get_rt(g_ideFacts, index))
        index = index + 1
    end
    if oldSlots != 0 do vir_free(oldSlots) end
end.

func ideFactFind(node: int) -> int:
    if g_ideFactSlots == 0 do out 0 end
    var slot = (node shr 4) and (g_ideFactCapacity - 1)
    var probes = 0
    when probes < g_ideFactCapacity loop
        let factEntry = native_read_i64(g_ideFactSlots, slot * 8)
        if factEntry == 0 do out 0 end
        if native_read_i64(factEntry, 0) == node do out factEntry end
        slot = (slot + 1) and (g_ideFactCapacity - 1)
        probes = probes + 1
    end
    out 0
end.

func ideFactsReset():
    if g_ideFacts != 0 do
        var i = 0
        when i < vec_len_rt(g_ideFacts) loop
            vir_free(vec_get_rt(g_ideFacts, i))
            i = i + 1
        end
        vec_free_rt(g_ideFacts)
    end
    if g_ideFactSlots != 0 do vir_free(g_ideFactSlots) end
    if g_ideBindingSlots != 0 do vir_free(g_ideBindingSlots) end
    if g_ideTypeUses != 0 do vec_free_rt(g_ideTypeUses) end
    g_ideBindingSlots = 0
    g_ideBindingCapacity = 0
    g_ideBindingCount = 0
    g_ideFactSlots = 0
    g_ideFactCapacity = 0
    g_ideFacts = vec_new_rt()
    g_ideFactEvent = 0
    g_ideTypeUses = vec_new_rt()
end.

# factEntry: AST pointer, resolver symbol, scope, role, inferred kind, checker state.
func ideFact(node: int) -> int:
    if g_ideFactsEnabled == 0 do out 0 end
    let existing = ideFactFind(node)
    if existing != 0 do out existing end
    ideFactReserve()
    let factEntry = vir_alloc(192)
    native_write_i64(factEntry, 0, node)
    native_write_i64(factEntry, 8, -1)
    native_write_i64(factEntry, 16, 0)
    native_write_i64(factEntry, 24, 0)
    native_write_i64(factEntry, 32, -1)
    native_write_i64(factEntry, 40, 0)
    native_write_i64(factEntry, 48, 0)
    native_write_i64(factEntry, 56, 0)
    native_write_i64(factEntry, 64, 0)
    native_write_i64(factEntry, 72, 0)
    native_write_i64(factEntry, 80, native_read_i64(node, 72))
    native_write_i64(factEntry, 88, native_read_i64(node, 32))
    native_write_i64(factEntry, 96, native_read_i64(node, 0))
    native_write_i64(factEntry, 104, native_read_i64(node, 16))
    native_write_i64(factEntry, 112, native_read_i64(node, 8))
    native_write_i64(factEntry, 120, 0)
    native_write_i64(factEntry, 128, 0)
    native_write_i64(factEntry, 136, 0)
    native_write_i64(factEntry, 144, 0)
    native_write_i64(factEntry, 152, 0)
    native_write_i64(factEntry, 160, 0)
    native_write_i64(factEntry, 168, 0)
    native_write_i64(factEntry, 176, 0)
    native_write_i64(factEntry, 184, -1)
    g_ideFacts = vec_push_rt(g_ideFacts, factEntry)
    ideFactIndexInsert(factEntry)
    out factEntry
end.

func ideFactResolve(node: int, symbolId: int, scopeId: int, role: int):
    let factEntry = ideFact(node)
    if factEntry != 0 do
        native_write_i64(factEntry, 8, symbolId)
        native_write_i64(factEntry, 16, scopeId)
        native_write_i64(factEntry, 24, role)
    end
end.

func ideFactType(node: int, kind: int):
    let factEntry = ideFact(node)
    if factEntry != 0 and kind > 0 do native_write_i64(factEntry, 32, kind) end
end.

func ideFactState(node: int, state: int):
    let factEntry = ideFact(node)
    if factEntry != 0 do
        g_ideFactEvent = g_ideFactEvent + 1
        if native_read_i64(factEntry, 152) == 0 do native_write_i64(factEntry, 152, state) end
        native_write_i64(factEntry, 40, state)
        native_write_i64(factEntry, 56, g_ideFactEvent)
        ideBindingCapture(factEntry)
    end
end.

# Preserve parser origin before later passes can rewrite an AST node.
func ideFactOrigin(node: int, span: int, line: int):
    let factEntry = ideFact(node)
    if factEntry != 0 do
        native_write_i64(factEntry, 80, span)
        native_write_i64(factEntry, 88, line)
        native_write_i64(factEntry, 96, native_read_i64(node, 0))
        native_write_i64(factEntry, 104, native_read_i64(node, 16))
        native_write_i64(factEntry, 112, native_read_i64(node, 8))
    end
end.

func ideFactBinding(node: int, bindingKey: int):
    let factEntry = ideFact(node)
    if factEntry != 0 do native_write_i64(factEntry, 48, bindingKey) end
end.

# Called only after the checker actually releases a named borrow at NLL.
func ideFactBorrowEnd(bindingKey: int, boundaryNode: int):
    if g_ideFactsEnabled == 0 do out 0 end
    let latest = ideBindingLatest(bindingKey)
    if latest != 0 do
        let currentKey = native_read_i64(latest, 48)
        if currentKey == 0 do out 0 end
        if fat_str_eq(currentKey as string, bindingKey as string) == 0 do out 0 end
        # A release after branching/iteration proves a boundary for the loan,
        # not a single linear last-use occurrence within that control flow.
        let boundaryKind = native_read_i64(boundaryNode, 16)
        var proof = 1
        if boundaryKind == 8 do proof = 2 end
        if boundaryKind == 9 do proof = 2 end
        if boundaryKind == 10 do proof = 2 end
        if boundaryKind == 11 do proof = 2 end
        if boundaryKind == 59 do proof = 2 end
        if boundaryKind == 67 do proof = 2 end
        if boundaryKind == 82 do proof = 2 end
        native_write_i64(latest, 64, proof)
        native_write_i64(latest, 72, boundaryNode)
    end
end.

export ideFactOrigin, ideFactBinding, ideFactBorrowEnd, g_ideFactsEnabled, g_ideFacts, ideFactsReset, ideFactResolve, ideFactType, ideFactState

# Loan mode is recorded from the checker's active loan/binding sets.
func ideFactLoan(node: int, mode: int):
    let factEntry = ideFact(node)
    if factEntry != 0 do native_write_i64(factEntry, 120, mode) end
end.
export ideFactLoan

func ideFactSymbol(node: int) -> int:
    if g_ideFactsEnabled == 0 do out -1 end
    let factEntry = ideFactFind(node)
    if factEntry == 0 do out -1 end
    out native_read_i64(factEntry, 8)
end.
export ideFactSymbol

func ideFactSetProjection(node: int, projection: int):
    let factEntry = ideFact(node)
    if factEntry != 0 do native_write_i64(factEntry, 128, projection) end
end.

func ideFactProjection(node: int) -> int:
    if g_ideFactsEnabled == 0 do out 0 end
    let factEntry = ideFactFind(node)
    if factEntry == 0 do out 0 end
    out native_read_i64(factEntry, 128)
end.
export ideFactSetProjection, ideFactProjection

func ideFactScope(node: int, scopeId: int):
    let factEntry = ideFact(node)
    if factEntry != 0 do native_write_i64(factEntry, 136, scopeId + 1) end
end.

func ideFactScopeEnd(node: int, endLine: int):
    let factEntry = ideFact(node)
    if factEntry != 0 do native_write_i64(factEntry, 144, endLine) end
end.
export ideFactScope, ideFactScopeEnd
export ideFactFind

# The borrow checker supplies physical expanded lines, never inferred origins.
func ideFactResourceOrigins(node: int, moveLine: int, loanLine: int, ownerKey: int):
    let factEntry = ideFact(node)
    if factEntry != 0 do
        if moveLine > 0 do native_write_i64(factEntry, 160, moveLine) end
        if loanLine > 0 do native_write_i64(factEntry, 168, loanLine) end
        native_write_i64(factEntry, 176, ownerKey)
    end
end.
export ideFactResourceOrigins

func ideFactTypeUse(node: int):
    if g_ideFactsEnabled == 1 do g_ideTypeUses = vec_push_rt(g_ideTypeUses, node) end
end.
export ideFactTypeUse, g_ideTypeUses

func ideFactResolvedType(node: int, typeSymbol: int):
    let factEntry = ideFact(node)
    if factEntry != 0 do native_write_i64(factEntry, 184, typeSymbol) end
end.
export ideFactResolvedType
