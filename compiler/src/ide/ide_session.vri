include compiler.main
import expand_includes_text, expand_imports_text, g_inc_main_file, g_inc_base, g_inc_err, text_find_import, g_ideEarlyDiagnostics, g_ideImportOrigins, g_ideResolvedModules from compiler.main
include compiler.sem.modules
import pass1_collect_modules from compiler.sem.modules
# In-process analysis of an unsaved buffer using the active compiler passes.
include compiler.lexer
import lexer_lex, lexer_token_count, lexer_token_get, lexer_error_message, g_lexer_error_offset from compiler.lexer
include compiler.parser
import g_parserErrors, g_parserErrorCode, g_parserErrorDetail, Parser, AstNode, AstType, parser_new, parse_program from compiler.parser
include compiler.symbols
import symbol_table_new from compiler.symbols
include compiler.scopes
import scope_tree_new, scope_reset from compiler.scopes
include compiler.context
import diagnostic_engine_new, report_error_loc, report_error_loc_related from compiler.context
include compiler.sem.symbols
import pass2_register_symbols from compiler.sem.symbols
include compiler.sem.names
import pass3_resolve_names, pass3_lookup_chain from compiler.sem.names
include compiler.sem.types
import pass4_resolve_types from compiler.sem.types
include compiler.sem.infer
import pass5_infer_types from compiler.sem.infer
include compiler.sem.typecheck
import pass6_typecheck from compiler.sem.typecheck
include compiler.sem.cfa
import pass7_analyze_cfa from compiler.sem.cfa
include compiler.sem.borrow
import pass8_analyze_borrow from compiler.sem.borrow
include compiler.sem.diagnostics
import g_diag_json, pass10_code_to_msg from compiler.sem.diagnostics
include compiler.ide_facts
import g_ideFacts, ideFactFind, ideFactResolvedType, g_ideFactsEnabled, ideFactsReset from compiler.ide_facts
include vec_rt
import vec_new_rt, vec_push_rt, vec_get_rt, vec_len_rt from vec_rt
include string_rt
import fat_str_len, str_from_cstr from string_rt
include source_manager
import g_active_source_manager, sm_new, sm_register_file, sm_build_from_source, sm_file_from_line, sm_line_from_expanded, sm_get_span, sm_add_span_ex from source_manager

var g_ideSymbolNodes: int = 0
var g_ideHasImports: int = 0
var g_ideExpandedSource: int = 0
var g_ideSessionAst: int = 0
var g_ideSessionErrors: int = 0
var g_ideScopeParents: int = 0
var g_ideSessionDiagnostics: int = 0
var g_ideParseCode: int = 1001
var g_ideParseFileId: int = 0
var g_ideParseLine: int = 0
var g_ideParseColumn: int = 0
var g_ideParseMessage: int = 0

func ideSessionAnalyze(source: int, uri: int) -> int:
    ideFactsReset()
    g_ideFactsEnabled = 1
    g_diag_json = 1
    g_ideSessionErrors = 0
    g_ideSessionAst = 0
    g_ideSymbolNodes = 0
    g_ideScopeParents = 0
    g_ideParseCode = 1001
    g_ideParseFileId = 0
    g_ideParseLine = 0
    g_ideParseColumn = 0
    g_ideParseMessage = 0
    g_ideSessionDiagnostics = 0
    g_ideEarlyDiagnostics = 0
    g_ideImportOrigins = vec_new_rt()
    g_ideResolvedModules = vec_new_rt()
    var fatSource = str_from_cstr(source)
    g_ideHasImports = 0
    if text_find_import(fatSource) >= 0 do g_ideHasImports = 1 end
    g_inc_main_file = uri
    g_inc_base = 0
    var lastSlash = -1
    var pathIndex = 0
    when native_read_u8(uri, pathIndex) != 0 loop
        if native_read_u8(uri, pathIndex) == 47 do lastSlash = pathIndex end
        pathIndex = pathIndex + 1
    end
    if lastSlash >= 0 do
        g_inc_base = vir_alloc(lastSlash + 1)
        var index = 0
        when index < lastSlash loop
            native_write_u8(g_inc_base, index, native_read_u8(uri, index))
            index = index + 1
        end
        native_write_u8(g_inc_base, lastSlash, 0)
    end
    fatSource = expand_includes_text(fatSource)
    if g_inc_err == 0 do fatSource = expand_imports_text(fatSource) end
    if g_inc_err == 0 do fatSource = expand_includes_text(fatSource) end
    if g_inc_err != 0 do
        g_ideSessionErrors = 1
        g_ideSessionDiagnostics = g_ideEarlyDiagnostics
        g_ideFactsEnabled = 0
        g_ideParseLine = 0
        g_ideParseColumn = 0
        g_ideParseMessage = 0
        out 0
    end
    g_ideExpandedSource = native_read_i64(fatSource, 0)
    g_active_source_manager = sm_new()
    let fileId = sm_register_file(g_active_source_manager, str_from_cstr(uri), str_from_cstr(uri))
    sm_build_from_source(g_active_source_manager, fatSource, uri)
    let lexer = lexer_lex(g_ideExpandedSource)
    if lexer_error_message() != 0 do
        g_ideFactsEnabled = 0
        g_ideSessionErrors = 1
        g_ideParseCode = 1
        g_ideParseMessage = lexer_error_message()
        g_ideParseLine = 1
        g_ideParseColumn = 1
        var offset = 0
        when offset < g_lexer_error_offset loop
            if native_read_u8(g_ideExpandedSource, offset) == 10 do
                g_ideParseLine = g_ideParseLine + 1
                g_ideParseColumn = 1
            else
                g_ideParseColumn = g_ideParseColumn + 1
            end
            offset = offset + 1
        end
        g_ideParseFileId = sm_file_from_line(g_active_source_manager, g_ideParseLine)
        g_ideParseLine = sm_line_from_expanded(g_active_source_manager, g_ideParseLine)
        out 0
    end
    var tokens = vec_new_rt()
    var i = 0
    when i < lexer_token_count() loop
        tokens = vec_push_rt(tokens, lexer_token_get(i))
        i = i + 1
    end
    var parser = parser_new(tokens)
    var (parsed, ast) = parse_program(parser)
    g_ideSessionAst = ast as int
    if parsed.error_line > 0 do
        g_ideSessionErrors = 1
        var parseDiagnostics = diagnostic_engine_new()
        var errorIndex = 0
        when errorIndex < vec_len_rt(g_parserErrors) loop
            let parseErrorEntry = vec_get_rt(g_parserErrors, errorIndex)
            let errorCode = native_read_i64(parseErrorEntry, 0)
            let errorLine = native_read_i64(parseErrorEntry, 8)
            let errorColumn = native_read_i64(parseErrorEntry, 16)
            let errorDetail = native_read_i64(parseErrorEntry, 24)
            let secLine = native_read_i64(parseErrorEntry, 32)
            let secCol = native_read_i64(parseErrorEntry, 40)
            let secNote = native_read_i64(parseErrorEntry, 48) as string
            report_error_loc_related(parseDiagnostics, errorCode, 0, errorLine, errorColumn, errorDetail as string, secLine, secCol, secNote)
            errorIndex = errorIndex + 1
        end
        g_ideSessionDiagnostics = native_read_i64(parseDiagnostics as int, 0)
        g_ideSessionErrors = native_read_i64(parseDiagnostics as int, 8)
        g_ideFactsEnabled = 0
        out 0
    end
    var symbols = symbol_table_new()
    var scopes = scope_tree_new()
    var diagnostics = diagnostic_engine_new()
    pass1_collect_modules(symbols, scopes, diagnostics, ast)
    scope_reset(scopes)
    pass2_register_symbols(symbols, scopes, diagnostics, ast)
    scope_reset(scopes)
    pass3_resolve_names(symbols, scopes, diagnostics, ast)
    scope_reset(scopes)
    pass4_resolve_types(symbols, scopes, ast)
    scope_reset(scopes)
    pass5_infer_types(symbols, scopes, ast)
    scope_reset(scopes)
    pass6_typecheck(symbols, scopes, diagnostics, ast)
    scope_reset(scopes)
    pass7_analyze_cfa(symbols, scopes, diagnostics, ast)
    scope_reset(scopes)
    pass8_analyze_borrow(symbols, scopes, diagnostics, ast)
    g_ideSymbolNodes = native_read_i64(symbols as int, 0)
    ideSessionCaptureTypes(symbols, scopes)
    ideSessionCaptureExpressionRanges(g_ideSessionAst)
    g_ideScopeParents = vec_new_rt()
    let resolverScopes = native_read_i64(scopes as int, 0)
    var scopeIndex = 0
    when scopeIndex < vec_len_rt(resolverScopes) loop
        let scopeNode = vec_get_rt(resolverScopes, scopeIndex)
        g_ideScopeParents = vec_push_rt(g_ideScopeParents, native_read_i64(scopeNode, 8))
        scopeIndex = scopeIndex + 1
    end
    g_ideSessionDiagnostics = native_read_i64(diagnostics as int, 0)
    g_ideSessionErrors = g_ideSessionErrors + diagnostics.error_count
    g_ideFactsEnabled = 0
    out 1
end.

export g_ideHasImports, g_ideExpandedSource, ideSessionAnalyze, g_ideSessionAst, g_ideSessionErrors, g_ideScopeParents,
       g_ideSessionDiagnostics, g_ideParseLine, g_ideParseColumn, g_ideParseMessage

# Resolve named expression types through the same resolver table, keeping the
# actual declaration identity separate from the TypeKind category.
func ideSessionCaptureTypes(ref symbols: SymbolTable, ref scopes: ScopeTree):
    var index = 0
    when index < vec_len_rt(g_ideFacts) loop
        let factEntry = vec_get_rt(g_ideFacts, index)
        let node = native_read_i64(factEntry, 0)
        var declaration = node
        let binding = native_read_i64(factEntry, 8)
        if binding >= 0 do
            let bindingNode = vec_get_rt(g_ideSymbolNodes, binding)
            let bindingAst = native_read_i64(bindingNode, 32)
            if bindingAst != 0 do declaration = bindingAst end
            if native_read_i64(bindingNode, 0) == 8 and bindingAst != 0 do
                let declarationFact = ideFactFind(bindingAst)
                if declarationFact != 0 do
                    let enumOwner = native_read_i64(declarationFact, 184)
                    if enumOwner >= 0 do ideFactResolvedType(node, enumOwner) end
                end
            end
        end
        var typeName = native_read_i64(declaration, 8)
        if native_read_i64(declaration, 16) == 17 || native_read_i64(declaration, 16) == 16 || native_read_i64(declaration, 16) == 63 || native_read_i64(declaration, 16) == 64 || native_read_i64(declaration, 16) == 87 || native_read_i64(declaration, 16) == 91 do
            typeName = native_read_i64(declaration, 0)
        end
        if typeName == 0 || native_read_i64(typeName, 8) == 0 do
            let children = native_read_i64(declaration, 64)
            if children != 0 do
                if vec_len_rt(children) > 0 do
                    let initializer = vec_get_rt(children, 0)
                    if native_read_i64(initializer, 16) == 43 do typeName = native_read_i64(initializer, 0) end
                    if native_read_i64(initializer, 16) == 118 do typeName = native_read_i64(initializer, 8) end
                end
            end
        end
        if typeName != 0 do
            if native_read_i64(typeName, 8) > 0 do
                let typeSymbol = pass3_lookup_chain(symbols, scopes, native_read_i64(factEntry, 16), typeName as string)
                if typeSymbol >= 0 do
                    let entry = vec_get_rt(g_ideSymbolNodes, typeSymbol)
                    let kind = native_read_i64(entry, 0)
                    var namedType = 0
                    if kind == 3 do namedType = 1 end
                    if kind == 6 do namedType = 1 end
                    if kind == 7 do namedType = 1 end
                    if namedType == 1 do ideFactResolvedType(node, typeSymbol) end
                end
            end
        end
        index = index + 1
    end
end.
export g_ideSymbolNodes

export g_ideParseCode, g_ideParseFileId

# A binary expression covers its parsed children, including the operator
# between them. Derive physical ranges from compiler spans, bottom-up once;
# never search source text or scan the entire fact vector per expression.
func ideSessionCaptureExpressionRanges(node: int):
    if node == 0 do out end
    let children = native_read_i64(node, 64)
    var index = 0
    when index < vec_len_rt(children) loop
        ideSessionCaptureExpressionRanges(vec_get_rt(children, index))
        index = index + 1
    end
    let kind = native_read_i64(node, 16)
    var binary = 0
    if kind == 34 do binary = 1 end
    if kind == 35 do binary = 1 end
    if binary == 0 do out end
    if vec_len_rt(children) != 2 do out end
    let fact = ideFactFind(node)
    if fact == 0 do out end
    if native_read_i64(fact, 80) > 0 do out end
    let leftFact = ideFactFind(vec_get_rt(children, 0))
    let rightFact = ideFactFind(vec_get_rt(children, 1))
    if leftFact == 0 or rightFact == 0 do out end
    let leftSpan = sm_get_span(g_active_source_manager, native_read_i64(leftFact, 80))
    let rightSpan = sm_get_span(g_active_source_manager, native_read_i64(rightFact, 80))
    if leftSpan == 0 or rightSpan == 0 do out end
    if native_read_i64(leftSpan, 0) != native_read_i64(rightSpan, 0) do out end
    let fileId = native_read_i64(leftSpan, 0)
    let firstLine = native_read_i64(leftSpan, 8)
    let firstColumn = native_read_i64(leftSpan, 16)
    let lastLine = native_read_i64(rightSpan, 24)
    let lastColumn = native_read_i64(rightSpan, 32)
    let firstOffset = native_read_i64(leftSpan, 40)
    let lastOffset = native_read_i64(rightSpan, 48)
    let expansion = native_read_i64(leftSpan, 56)
    let span = sm_add_span_ex(g_active_source_manager, fileId, firstLine, firstColumn, lastLine, lastColumn, firstOffset, lastOffset, expansion)
    native_write_i64(fact, 80, span)
end.
