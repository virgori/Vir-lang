##
 * vir/compiler/opt_backend_arm64.vri — ARM64-only MIR/LIR optimizer hooks
 * ====================================================================
 * Not part of the architecture-neutral MIR pipeline.
 ##

include types
include vec_rt
include mir_opt
include lir

const LIR_SHRINK_WRAP_AUX: i64 = 88

func lir_is_alu_op(op: i64):
    if op == (LirOp.Add as i64) or op == (LirOp.Sub as i64) or op == (LirOp.Mul as i64) or op == (LirOp.Div as i64) or op == (LirOp.Rem as i64) do
        out 1
    end
    if op == (LirOp.And as i64) or op == (LirOp.Or as i64) or op == (LirOp.Xor as i64) or op == (LirOp.Shl as i64) or op == (LirOp.Shr as i64) do
        out 1
    end
    if op == (LirOp.Not as i64) or op == (LirOp.Pow as i64) or op == (LirOp.Load as i64) or op == (LirOp.Fma as i64) do
        out 1
    end
    out 0
end.

func lir_ins_reads_phys(ins: i64, reg: i64):
    let s1 = lir_instr_src1(ins)
    if s1 != 0 and lir_opnd_type(s1) == 3 and lir_opnd_phys_reg_val(s1) == reg do
        out 1
    end
    let s2 = lir_instr_src2(ins)
    if s2 != 0 and lir_opnd_type(s2) == 3 and lir_opnd_phys_reg_val(s2) == reg do
        out 1
    end
    out 0
end.

func lir_ins_writes_phys(ins: i64, reg: i64):
    let dst = lir_instr_dst(ins)
    if dst != 0 and lir_opnd_type(dst) == 3 and lir_opnd_phys_reg_val(dst) == reg do
        out 1
    end
    out 0
end.

func lir_replace_phys_reg_in_ins(ins: i64, old_reg: i64, new_reg: i64):
    let op = lir_instr_op(ins)
    let typ = lir_instr_typ(ins)
    var dst = lir_instr_dst(ins)
    var s1 = lir_instr_src1(ins)
    var s2 = lir_instr_src2(ins)
    let aux = lir_instr_aux(ins)
    if s1 != 0 and lir_opnd_type(s1) == 3 and lir_opnd_phys_reg_val(s1) == old_reg do
        s1 = lir_opnd_phys_reg(new_reg as LirPhysReg) as i64
    end
    if s2 != 0 and lir_opnd_type(s2) == 3 and lir_opnd_phys_reg_val(s2) == old_reg do
        s2 = lir_opnd_phys_reg(new_reg as LirPhysReg) as i64
    end
    out lir_instr_new(op, typ, dst, s1, s2, aux)
end.

func opt_post_ra_clean_block(instrs: i64):
    if instrs <= 0 do out instrs end
    let n_ins = vec_len_rt(instrs)
    if n_ins <= 0 do out instrs end

    var alias = vec_new_rt()
    var r_init = 0
    when r_init < 32 loop
        alias = vec_push_rt(alias, 0 - 1)
        r_init = r_init + 1
    end

    var ii = 0
    when ii < n_ins loop
        ins = vec_get_rt(instrs, ii)
        op = lir_instr_op(ins)
        if op == (LirOp.Nop as i64) do
            # ignore
        eif op == (LirOp.Mov as i64) do
            dst = lir_instr_dst(ins)
            src1 = lir_instr_src1(ins)
            var is_redundant = 0
            if dst != 0 and src1 != 0 do
                dt = lir_opnd_type(dst)
                st = lir_opnd_type(src1)
                if dt == 3 and st == 3 do # PhysReg
                    rd = lir_opnd_phys_reg_val(dst)
                    rs = lir_opnd_phys_reg_val(src1)
                    if rd == rs do
                        is_redundant = 1
                    eif rd >= 0 and rd < 32 and rs >= 0 and rs < 32 do
                        alias_d = vec_get_rt(alias, rd)
                        alias_s = vec_get_rt(alias, rs)
                        if alias_d == rs do
                            is_redundant = 1
                        eif alias_s == rd do
                            is_redundant = 1
                        eif alias_d >= 0 and alias_s >= 0 and alias_d == alias_s do
                            is_redundant = 1
                        end
                    end

                eif dt == 4 and st == 4 do # StackMem
                    off_d = lir_opnd_stack_offset(dst)
                    off_s = lir_opnd_stack_offset(src1)
                    if off_d == off_s do
                        is_redundant = 1
                    end
                end
            end

            if is_redundant == 1 do
                vec_set_rt(instrs, ii, lir_instr_new(LirOp.Nop as i64, 0, lir_opnd_none() as i64, lir_opnd_none() as i64, lir_opnd_none() as i64, 0))
            else
                if dst != 0 and lir_opnd_type(dst) == 3 do
                    rd = lir_opnd_phys_reg_val(dst)
                    if rd >= 0 and rd < 32 do
                        var xi = 0
                        when xi < 32 loop
                            if vec_get_rt(alias, xi) == rd do
                                vec_set_rt(alias, xi, 0 - 1)
                            end
                            xi = xi + 1
                        end
                        if src1 != 0 and lir_opnd_type(src1) == 3 do
                            rs = lir_opnd_phys_reg_val(src1)
                            if rs >= 0 and rs < 32 do
                                var s_root = rs
                                if vec_get_rt(alias, rs) >= 0 do
                                    s_root = vec_get_rt(alias, rs)
                                end
                                vec_set_rt(alias, rd, s_root)
                            else
                                vec_set_rt(alias, rd, 0 - 1)
                            end
                        else
                            vec_set_rt(alias, rd, 0 - 1)
                        end
                    end
                end
            end
        eif op == (LirOp.Ret as i64) do
            let r_s1 = lir_instr_src1(ins)
            if r_s1 != 0 and lir_opnd_type(r_s1) == 3 do
                let r_reg = lir_opnd_phys_reg_val(r_s1)
                if r_reg > 0 and r_reg < 32 do
                    var rk = ii - 1
                    var stop_ret_back = 0
                    when rk >= 0 and stop_ret_back == 0 loop
                        let r_prev = vec_get_rt(instrs, rk)
                        let rp_op = lir_instr_op(r_prev)
                        if rp_op != (LirOp.Nop as i64) do
                            if rp_op == (LirOp.Call as i64) or rp_op == (LirOp.Ret as i64) or rp_op == (LirOp.Jmp as i64) or rp_op == (LirOp.JmpCond as i64) do
                                stop_ret_back = 1
                            eif lir_ins_writes_phys(r_prev, r_reg) == 1 do
                                if lir_is_alu_op(rp_op) == 1 or rp_op == (LirOp.Mov as i64) do
                                    if rp_op == (LirOp.Mov as i64) and lir_ins_reads_phys(r_prev, 0) == 1 do
                                        vec_set_rt(instrs, rk, lir_instr_new(LirOp.Nop as i64, 0, lir_opnd_none() as i64, lir_opnd_none() as i64, lir_opnd_none() as i64, 0))
                                    else
                                        let new_p = lir_instr_new(rp_op, lir_instr_typ(r_prev), lir_opnd_phys_reg(0 as LirPhysReg), lir_instr_src1(r_prev), lir_instr_src2(r_prev), lir_instr_aux(r_prev))
                                        vec_set_rt(instrs, rk, new_p)
                                    end
                                    let new_ret2 = lir_instr_new(LirOp.Ret as i64, lir_instr_typ(ins), lir_opnd_none() as i64, lir_opnd_phys_reg(0 as LirPhysReg), lir_opnd_none() as i64, lir_instr_aux(ins))
                                    vec_set_rt(instrs, ii, new_ret2)
                                end
                                stop_ret_back = 1
                            eif lir_ins_reads_phys(r_prev, 0) == 1 or lir_ins_writes_phys(r_prev, 0) == 1 do
                                stop_ret_back = 1
                            eif lir_ins_reads_phys(r_prev, r_reg) == 1 do
                                stop_ret_back = 1
                            end
                        end
                        rk = rk - 1
                    end
                end
            end
        else
            if op == (LirOp.Call as i64) or op == (LirOp.MatMul as i64) or op == (LirOp.Fma as i64) do
                var c = 0
                when c < 19 loop
                    vec_set_rt(alias, c, 0 - 1)
                    c = c + 1
                end
                var xi = 0
                when xi < 32 loop
                    let a_val = vec_get_rt(alias, xi)
                    if a_val >= 0 and a_val < 19 do
                        vec_set_rt(alias, xi, 0 - 1)
                    end
                    xi = xi + 1
                end
            eif op == (LirOp.Intrinsic as i64) do
                let aux = lir_instr_aux(ins)
                if aux != 100 and aux != 103 and aux != 104 and aux != 105 do
                    var c = 0
                    when c < 19 loop
                        vec_set_rt(alias, c, 0 - 1)
                        c = c + 1
                    end
                    var xi = 0
                    when xi < 32 loop
                        let a_val = vec_get_rt(alias, xi)
                        if a_val >= 0 and a_val < 19 do
                            vec_set_rt(alias, xi, 0 - 1)
                        end
                        xi = xi + 1
                    end
                end
            end

            # SetArg writes to physical argument register X0..X7
            if op == (LirOp.SetArg as i64) do
                var ai = lir_instr_aux(ins)
                let s1 = lir_instr_src1(ins)
                if s1 != 0 and lir_opnd_type(s1) == 5 do
                    ai = lir_opnd_imm_val(s1)
                end
                if ai >= 0 and ai < 8 do
                    var xi = 0
                    when xi < 32 loop
                        if vec_get_rt(alias, xi) == ai do
                            vec_set_rt(alias, xi, 0 - 1)
                        end
                        xi = xi + 1
                    end
                    vec_set_rt(alias, ai, 0 - 1)
                end
            end

            # Any instruction defining a physical destination register writes to rd
            dst = lir_instr_dst(ins)
            if dst != 0 and lir_opnd_type(dst) == 3 do
                rd = lir_opnd_phys_reg_val(dst)
                if rd >= 0 and rd < 32 do
                    var xi = 0
                    when xi < 32 loop
                        if vec_get_rt(alias, xi) == rd do
                            vec_set_rt(alias, xi, 0 - 1)
                        end
                        xi = xi + 1
                    end
                    vec_set_rt(alias, rd, 0 - 1)
                end
            end
        end
        ii = ii + 1
    end
    vec_free_rt(alias)

    # Compact unneeded Nops (keeping shrink wrap aux marker)
    new_instrs = vec_new_rt()
    ii = 0
    when ii < n_ins loop
        ins = vec_get_rt(instrs, ii)
        op = lir_instr_op(ins)
        if op == (LirOp.Nop as i64) do
            if lir_instr_aux(ins) == LIR_SHRINK_WRAP_AUX do
                new_instrs = vec_push_rt(new_instrs, ins)
            end
        else
            new_instrs = vec_push_rt(new_instrs, ins)
        end
        ii = ii + 1
    end
    out new_instrs
end.

# MIR-stage ISA prep (strength patterns that become ARM64 MADD/LSL later)
func opt_arm64_run_mir_passes(blocks: i64):
    # Instruction scheduling is disabled until nested-loop SSA safety is
    # proven; it currently reorders dependent memory operations in tiled code.
    blocks = mir_opt_arm64_addressing_modes_and_register_induction(blocks)
    out blocks
end.

# LIR-stage: reachable block pruning, single-predecessor block merging,
# shrink-wrap marking, and post-RA redundant move cleanup
func opt_arm64_run_lir_passes(lf: i64):
    if lf == 0 do out 0 end
    var blocks = lir_func_blocks(lf)
    if blocks <= 0 do out lf end
    let n_blocks = vec_len_rt(blocks)
    if n_blocks <= 0 do out lf end

    # Compute max_bid and bid_to_idx
    var max_bid = 0
    var bi = 0
    when bi < n_blocks loop
        let b = vec_get_rt(blocks, bi)
        let bid = lir_block_id(b)
        if bid > max_bid do max_bid = bid end
        bi = bi + 1
    end

    var bid_to_idx = vec_new_rt()
    var init_k = 0
    when init_k <= max_bid loop
        bid_to_idx = vec_push_rt(bid_to_idx, 0 - 1)
        init_k = init_k + 1
    end
    bi = 0
    when bi < n_blocks loop
        let b = vec_get_rt(blocks, bi)
        let bid = lir_block_id(b)
        if bid >= 0 and bid <= max_bid do
            vec_set_rt(bid_to_idx, bid, bi)
        end
        bi = bi + 1
    end

    # ── Phase 1: Reachability Analysis with Fallthroughs ──
    var reachable = vec_new_rt()
    bi = 0
    when bi < n_blocks loop
        reachable = vec_push_rt(reachable, 0)
        bi = bi + 1
    end
    vec_set_rt(reachable, 0, 1)

    var wl = vec_new_rt()
    wl = vec_push_rt(wl, 0)
    var wl_head = 0
    when wl_head < vec_len_rt(wl) loop
        let cur_idx = vec_get_rt(wl, wl_head)
        wl_head = wl_head + 1
        let cur_b = vec_get_rt(blocks, cur_idx)
        let binstrs = lir_block_instrs(cur_b)
        let n_ins = vec_len_rt(binstrs)
        if n_ins == 0 do
            # Empty block falls through to cur_idx + 1
            if cur_idx + 1 < n_blocks and vec_get_rt(reachable, cur_idx + 1) == 0 do
                vec_set_rt(reachable, cur_idx + 1, 1)
                wl = vec_push_rt(wl, cur_idx + 1)
            end
        else
            var can_fallthrough = 1
            var ii = 0
            when ii < n_ins loop
                let ins = vec_get_rt(binstrs, ii)
                let op = lir_instr_op(ins)
                if op == (LirOp.Ret as i64) do
                    can_fallthrough = 0
                eif op == (LirOp.Jmp as i64) do
                    can_fallthrough = 0
                    let s1 = lir_instr_src1(ins)
                    var tgt = 0 - 1
                    if s1 > 4096 do
                        let st = lir_opnd_type(s1)
                        if st == 6 do tgt = lir_opnd_label_id(s1) end
                        if st == 5 do tgt = lir_opnd_imm_val(s1) end
                    end
                    if tgt >= 0 and tgt <= max_bid do
                        let t_idx = vec_get_rt(bid_to_idx, tgt)
                        if t_idx >= 0 and vec_get_rt(reachable, t_idx) == 0 do
                            vec_set_rt(reachable, t_idx, 1)
                            wl = vec_push_rt(wl, t_idx)
                        end
                    end
                eif op == (LirOp.JmpCond as i64) do
                    let s2 = lir_instr_src2(ins)
                    var tgt = 0 - 1
                    if s2 > 4096 do
                        let st = lir_opnd_type(s2)
                        if st == 6 do tgt = lir_opnd_label_id(s2) end
                        if st == 5 do tgt = lir_opnd_imm_val(s2) end
                    end
                    if tgt >= 0 and tgt <= max_bid do
                        let t_idx = vec_get_rt(bid_to_idx, tgt)
                        if t_idx >= 0 and vec_get_rt(reachable, t_idx) == 0 do
                            vec_set_rt(reachable, t_idx, 1)
                            wl = vec_push_rt(wl, t_idx)
                        end
                    end
                end
                ii = ii + 1
            end
            if can_fallthrough == 1 and cur_idx + 1 < n_blocks do
                if vec_get_rt(reachable, cur_idx + 1) == 0 do
                    vec_set_rt(reachable, cur_idx + 1, 1)
                    wl = vec_push_rt(wl, cur_idx + 1)
                end
            end
        end
    end
    vec_free_rt(wl)

    # Empty instructions of unreachable blocks
    bi = 0
    when bi < n_blocks loop
        if vec_get_rt(reachable, bi) == 0 do
            let ub = vec_get_rt(blocks, bi)
            vec_set_rt(blocks, bi, lir_block_new(lir_block_id(ub), vec_new_rt()))
        end
        bi = bi + 1
    end
    vec_free_rt(reachable)

    # ── Phase 2: Straight-Line Adjacent Block Merging ──
    # Compute true predecessor counts including fallthroughs and all branch types
    var pred_counts = vec_new_rt()
    bi = 0
    when bi < n_blocks loop
        pred_counts = vec_push_rt(pred_counts, 0)
        bi = bi + 1
    end

    bi = 0
    when bi < n_blocks loop
        let b = vec_get_rt(blocks, bi)
        let binstrs = lir_block_instrs(b)
        let n_ins = vec_len_rt(binstrs)
        if n_ins == 0 do
            if bi + 1 < n_blocks do
                vec_set_rt(pred_counts, bi + 1, vec_get_rt(pred_counts, bi + 1) + 1)
            end
        else
            var can_ft = 1
            var ii = 0
            when ii < n_ins loop
                let ins = vec_get_rt(binstrs, ii)
                let op = lir_instr_op(ins)
                if op == (LirOp.Ret as i64) do
                    can_ft = 0
                eif op == (LirOp.Jmp as i64) do
                    can_ft = 0
                    let s1 = lir_instr_src1(ins)
                    var tgt = 0 - 1
                    if s1 > 4096 do
                        let st = lir_opnd_type(s1)
                        if st == 6 do tgt = lir_opnd_label_id(s1) end
                        if st == 5 do tgt = lir_opnd_imm_val(s1) end
                    end
                    if tgt >= 0 and tgt <= max_bid do
                        let t_idx = vec_get_rt(bid_to_idx, tgt)
                        if t_idx >= 0 do
                            vec_set_rt(pred_counts, t_idx, vec_get_rt(pred_counts, t_idx) + 1)
                        end
                    end
                eif op == (LirOp.JmpCond as i64) do
                    let s2 = lir_instr_src2(ins)
                    var tgt = 0 - 1
                    if s2 > 4096 do
                        let st = lir_opnd_type(s2)
                        if st == 6 do tgt = lir_opnd_label_id(s2) end
                        if st == 5 do tgt = lir_opnd_imm_val(s2) end
                    end
                    if tgt >= 0 and tgt <= max_bid do
                        let t_idx = vec_get_rt(bid_to_idx, tgt)
                        if t_idx >= 0 do
                            vec_set_rt(pred_counts, t_idx, vec_get_rt(pred_counts, t_idx) + 1)
                        end
                    end
                end
                ii = ii + 1
            end
            if can_ft == 1 and bi + 1 < n_blocks do
                vec_set_rt(pred_counts, bi + 1, vec_get_rt(pred_counts, bi + 1) + 1)
            end
        end
        bi = bi + 1
    end

    bi = 0
    when bi < n_blocks - 1 loop
        let b = vec_get_rt(blocks, bi)
        let binstrs = lir_block_instrs(b)
        let n_ins = vec_len_rt(binstrs)
        if n_ins > 0 do
            let last_ins = vec_get_rt(binstrs, n_ins - 1)
            if lir_instr_op(last_ins) == (LirOp.Jmp as i64) do
                let s1 = lir_instr_src1(last_ins)
                var tgt = 0 - 1
                if s1 > 4096 do
                    let st = lir_opnd_type(s1)
                    if st == 6 do tgt = lir_opnd_label_id(s1) end
                    if st == 5 do tgt = lir_opnd_imm_val(s1) end
                end
                if tgt >= 0 and tgt <= max_bid do
                    let t_idx = vec_get_rt(bid_to_idx, tgt)
                    if t_idx == bi + 1 and vec_get_rt(pred_counts, t_idx) == 1 do
                        let tb = vec_get_rt(blocks, t_idx)
                        let tb_instrs = lir_block_instrs(tb)
                        if vec_len_rt(tb_instrs) > 0 do
                            var comb = vec_new_rt()
                            var ci = 0
                            when ci < n_ins - 1 loop
                                comb = vec_push_rt(comb, vec_get_rt(binstrs, ci))
                                ci = ci + 1
                            end
                            var ti = 0
                            let tn = vec_len_rt(tb_instrs)
                            when ti < tn loop
                                comb = vec_push_rt(comb, vec_get_rt(tb_instrs, ti))
                                ti = ti + 1
                            end
                            vec_set_rt(blocks, bi, lir_block_new(lir_block_id(b), comb))
                            vec_set_rt(blocks, t_idx, lir_block_new(lir_block_id(tb), vec_new_rt()))
                            vec_set_rt(pred_counts, t_idx, 0)
                        end
                    end
                end
            end
        end
        bi = bi + 1
    end
    vec_free_rt(bid_to_idx)
    vec_free_rt(pred_counts)

    # ── Phase 3: Post-RA Clean & Shrink Wrap Marker (preserving every block) ──
    bi = 0
    when bi < n_blocks loop
        let b = vec_get_rt(blocks, bi)
        var binstrs = lir_block_instrs(b)
        let n_ins = vec_len_rt(binstrs)
        if n_ins > 0 do
            binstrs = opt_post_ra_clean_block(binstrs)
            var has_call = 0
            var ii = 0
            let cur_n = vec_len_rt(binstrs)
            when ii < cur_n loop
                let op = lir_instr_op(vec_get_rt(binstrs, ii))
                if op == (LirOp.Call as i64) or op == (LirOp.MatMul as i64) or op == (LirOp.Fma as i64) do
                    has_call = 1
                eif op == (LirOp.Intrinsic as i64) do
                    let iaux = lir_instr_aux(vec_get_rt(binstrs, ii))
                    if iaux != 100 do # Not MIR_INTR_PARAM
                        has_call = 1
                    end
                end
                ii = ii + 1
            end
            if has_call == 0 do
                let marker = lir_instr_new(LirOp.Nop as i64, 0, 0, 0, 0, LIR_SHRINK_WRAP_AUX)
                binstrs = vec_push_rt(binstrs, marker)
            end
            vec_set_rt(blocks, bi, lir_block_new(lir_block_id(b), binstrs))
        end
        bi = bi + 1
    end

    out lf
end.

# Codegen-stage SIMD lowering (NEON)
func opt_arm64_run_simd_mir_passes(blocks: i64):
    blocks = mir_opt_neon_simd_vector_lowering(blocks)
    blocks = mir_opt_hot_cold_layout_partitioning(blocks)
    out blocks
end.

export opt_arm64_run_mir_passes, opt_arm64_run_lir_passes, opt_arm64_run_simd_mir_passes
func opt_arm64_run_lir_pre(lf: i64):
    out lf
end.

func opt_arm64_run_lir_post(lf: i64):
    out opt_arm64_run_lir_passes(lf)
end.

export opt_arm64_run_mir_passes, opt_arm64_run_lir_passes, opt_arm64_run_simd_mir_passes, opt_arm64_run_lir_pre, opt_arm64_run_lir_post
