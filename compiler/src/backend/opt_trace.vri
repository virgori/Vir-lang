##
 * Compiler-owned optimization invocation observations, not an optimizer.
 * Reset before each request. Counters never influence pass eligibility.
 ##

include types
include alloc
include string_rt

var g_optTraceCounts: int = 0
var g_optTraceEnabled: int = 0
var g_optRequestedSelector: int = 0
var g_optResolvedLevel: int = 1

func optTraceReset(selector: int, level: int, enabled: int):
    if g_optTraceCounts == 0 do
        g_optTraceCounts = vir_alloc(1024)
    end
    var index = 0
    when index < 128 loop
        native_write_i64(g_optTraceCounts, index * 8, 0)
        index = index + 1
    end
    g_optRequestedSelector = selector
    g_optResolvedLevel = level
    g_optTraceEnabled = enabled
end.

func optTraceNote(id: int):
    if g_optTraceEnabled == 0 || g_optTraceCounts == 0 do out end
    if id < 1 || id >= 128 do out end
    let offset = id * 8
    native_write_i64(g_optTraceCounts, offset, native_read_i64(g_optTraceCounts, offset) + 1)
end.

func optTraceCount(id: int):
    if id < 1 || id >= 128 || g_optTraceCounts == 0 do out 0 end
    out native_read_i64(g_optTraceCounts, id * 8)
end.

func optTraceHookName(id: int):
    if id == 101 do out "arm64.mir" end
    if id == 102 do out "arm64.simd-layout" end
    if id == 103 do out "generic.mir-layout" end
    if id == 104 do out "x86.mir-identity" end
    if id == 105 do out "riscv.mir-identity" end
    if id == 106 do out "wasm.mir-identity" end
    if id == 107 do out "generic.mir-identity" end
    if id == 108 do out "generic.arc" end
    if id == 110 do out "arm64.lir-pre-identity" end
    if id == 111 do out "x86.lir-pre-identity" end
    if id == 112 do out "riscv.lir-pre-identity" end
    if id == 113 do out "wasm.lir-pre-identity" end
    if id == 120 do out "arm64.lir-post" end
    if id == 121 do out "x86.lir-post-identity" end
    if id == 122 do out "riscv.lir-post-identity" end
    if id == 123 do out "wasm.lir-post-identity" end
    out "generic.lir-post-identity"
end.

func optTraceAppendJson(builder: StringBuilder):
    var text = builder
    text = sb_append(text, "\"optimization\":{\"requestedSelector\":\"")
    if g_optRequestedSelector == 0 do
        text = sb_append(text, "default")
    else
        text = sb_append(text, g_optRequestedSelector)
    end
    text = sb_append(text, "\",\"resolvedLevel\":")
    text = sb_append_int(text, g_optResolvedLevel)
    text = sb_append(text, ",\"passInvocations\":[")
    var
        id = 1
        first = 1
    when id <= 26 loop
        let count = optTraceCount(id)
        if count > 0 do
            if first == 0 do text = sb_append(text, ",") end
            first = 0
            text = sb_append(text, "{\"id\":")
            text = sb_append_int(text, id)
            text = sb_append(text, ",\"count\":")
            text = sb_append_int(text, count)
            text = sb_append(text, "}")
        end
        id = id + 1
    end
    text = sb_append(text, "],\"hookInvocations\":[")
    id = 101
    first = 1
    when id < 128 loop
        let count = optTraceCount(id)
        if count > 0 do
            if first == 0 do text = sb_append(text, ",") end
            first = 0
            text = sb_append(text, "{\"name\":\"")
            text = sb_append(text, optTraceHookName(id))
            text = sb_append(text, "\",\"count\":")
            text = sb_append_int(text, count)
            text = sb_append(text, "}")
        end
        id = id + 1
    end
    out sb_append(text, "]},")
end.

export optTraceReset, optTraceNote, optTraceCount, optTraceAppendJson
