##
 * vir/compiler/opt_backend_generic.vri — Target-neutral backend hooks (x86_64, wasm32, …)
 ##

include types_prelude
include mir_opt

# This marks MIR CFG layout only; it emits no ISA-specific instructions.
# Keep it separate from the legacy no-op SIMD hook and target capabilities.
func optGenericRunMirLayout(blocks: i64):
    out mir_opt_hot_cold_layout_partitioning(blocks)
end.

func opt_generic_run_mir_passes(blocks: i64):
    out blocks
end.

func opt_generic_run_lir_passes(lf: i64):
    out lf
end.

func opt_generic_run_simd_mir_passes(blocks: i64):
    out blocks
end.

export opt_generic_run_mir_passes, opt_generic_run_lir_passes, opt_generic_run_simd_mir_passes, optGenericRunMirLayout
