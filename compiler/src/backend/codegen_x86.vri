##
 * vir/compiler/codegen_x86.vri — x86_64 Binary Instruction Emitters
 * ==================================================================
 * Ported from core.src.codegen.c (hand-coded REX + opcode bytes).
 * Register IDs match codegen.h: RAX=0 .. R15=15.
 ##

include types_prelude
include codegen

# ── Register constants (codegen.h) ──
const X86_RAX  = 0
const X86_RCX  = 1
const X86_RDX  = 2
const X86_RBX  = 3
const X86_RSP  = 4
const X86_RBP  = 5
const X86_RSI  = 6
const X86_RDI  = 7
const X86_R8   = 8
const X86_R9   = 9
const X86_R10  = 10
const X86_R11  = 11
const X86_R12  = 12
const X86_R13  = 13
const X86_R14  = 14
const X86_R15  = 15

# SysV AMD64 argument registers (SetArg order): RDI, RSI, RDX, RCX, R8, R9

func x86_arg_reg(idx: int):
    if idx == 0 do out X86_RDI end
    if idx == 1 do out X86_RSI end
    if idx == 2 do out X86_RDX end
    if idx == 3 do out X86_RCX end
    if idx == 4 do out X86_R8 end
    if idx == 5 do out X86_R9 end
    out X86_RAX
end.

func x86_rex_w(r: int, rm: int):
    var rex = 0x48
    if r >= X86_R8 do
        rex = rex or 0x04
    end
    if rm >= X86_R8 do
        rex = rex or 0x01
    end
    out rex
end.

func x86_rex(r: int, rm: int):
    var rex = 0x40
    if r >= X86_R8 do
        rex = rex or 0x04
    end
    if rm >= X86_R8 do
        rex = rex or 0x01
    end
    out rex
end.

func x86_modrm(mod_bits: int, reg: int, rm: int):
    v = (mod_bits shl 6) or ((reg and 7) shl 3)
    out v or (rm and 7)
end.

func x86_emit_add_rr(cb: CodeBuf, dst: int, src: int):
    cb = codebuf_emit_byte(cb, x86_rex_w(src, dst))
    cb = codebuf_emit_byte(cb, 0x01)
    out codebuf_emit_byte(cb, x86_modrm(3, src, dst))
end.

func x86_emit_sub_rr(cb: CodeBuf, dst: int, src: int):
    cb = codebuf_emit_byte(cb, x86_rex_w(src, dst))
    cb = codebuf_emit_byte(cb, 0x29)
    out codebuf_emit_byte(cb, x86_modrm(3, src, dst))
end.

func x86_emit_imul_rr(cb: CodeBuf, dst: int, src: int):
    cb = codebuf_emit_byte(cb, x86_rex_w(dst, src))
    cb = codebuf_emit_byte(cb, 0x0F)
    cb = codebuf_emit_byte(cb, 0xAF)
    out codebuf_emit_byte(cb, x86_modrm(3, dst, src))
end.

func x86_emit_mov_rr(cb: CodeBuf, dst: int, src: int):
    cb = codebuf_emit_byte(cb, x86_rex_w(src, dst))
    cb = codebuf_emit_byte(cb, 0x89)
    out codebuf_emit_byte(cb, x86_modrm(3, src, dst))
end.

func x86_emit_mov_reg_imm64(cb: CodeBuf, dst: int, imm: int):
    var rex = 0x48
    if dst >= X86_R8 do
        rex = rex or 0x01
    end
    cb = codebuf_emit_byte(cb, rex)
    cb = codebuf_emit_byte(cb, 0xB8 + (dst and 7))
    out codebuf_emit_u64(cb, imm)
end.

func x86_emit_mov_reg_imm32(cb: CodeBuf, dst: int, imm: int):
    var rex = 0x48
    if dst >= X86_R8 do
        rex = rex or 0x01
    end
    cb = codebuf_emit_byte(cb, rex)
    cb = codebuf_emit_byte(cb, 0xC7)
    cb = codebuf_emit_byte(cb, x86_modrm(3, 0, dst))
    out codebuf_emit_i32(cb, imm)
end.

func x86_emit_push(cb: CodeBuf, reg: int):
    if reg >= X86_R8 do
        cb = codebuf_emit_byte(cb, 0x41)
    end
    out codebuf_emit_byte(cb, 0x50 + (reg and 7))
end.

func x86_emit_pop(cb: CodeBuf, reg: int):
    if reg >= X86_R8 do
        cb = codebuf_emit_byte(cb, 0x41)
    end
    out codebuf_emit_byte(cb, 0x58 + (reg and 7))
end.

func x86_emit_ret(cb: CodeBuf):
    out codebuf_emit_byte(cb, 0xC3)
end.

func x86_emit_nop(cb: CodeBuf):
    out codebuf_emit_byte(cb, 0x90)
end.

func x86_emit_jmp_rel32(cb: CodeBuf, offset: int):
    cb = codebuf_emit_byte(cb, 0xE9)
    out codebuf_emit_i32(cb, offset)
end.

func x86_emit_call_rel32(cb: CodeBuf, offset: int):
    cb = codebuf_emit_byte(cb, 0xE8)
    out codebuf_emit_i32(cb, offset)
end.

func x86_emit_call_reg(cb: CodeBuf, reg: int):
    if reg >= 8 do
        cb = codebuf_emit_byte(cb, 0x41)
    end
    cb = codebuf_emit_byte(cb, 0xFF)
    out codebuf_emit_byte(cb, 0xD0 + (reg mod 8))
end.

func x86_emit_cmp_rr(cb: CodeBuf, a: int, b: int):
    cb = codebuf_emit_byte(cb, x86_rex_w(b, a))
    cb = codebuf_emit_byte(cb, 0x39)
    out codebuf_emit_byte(cb, x86_modrm(3, b, a))
end.

func x86_emit_sete(cb: CodeBuf, dst: int):
    var rex = 0x40
    if dst >= X86_R8 do
        rex = 0x41
    end
    cb = codebuf_emit_byte(cb, rex)
    cb = codebuf_emit_byte(cb, 0x0F)
    cb = codebuf_emit_byte(cb, 0x94)
    out codebuf_emit_byte(cb, x86_modrm(3, 0, dst))
end.

func x86_emit_setne(cb: CodeBuf, dst: int):
    var rex = 0x40
    if dst >= X86_R8 do
        rex = 0x41
    end
    cb = codebuf_emit_byte(cb, rex)
    cb = codebuf_emit_byte(cb, 0x0F)
    cb = codebuf_emit_byte(cb, 0x95)
    out codebuf_emit_byte(cb, x86_modrm(3, 0, dst))
end.

func x86_emit_setg(cb: CodeBuf, dst: int):
    var rex = 0x40
    if dst >= X86_R8 do
        rex = 0x41
    end
    cb = codebuf_emit_byte(cb, rex)
    cb = codebuf_emit_byte(cb, 0x0F)
    cb = codebuf_emit_byte(cb, 0x9F)
    out codebuf_emit_byte(cb, x86_modrm(3, 0, dst))
end.

func x86_emit_setl(cb: CodeBuf, dst: int):
    var rex = 0x40
    if dst >= X86_R8 do
        rex = 0x41
    end
    cb = codebuf_emit_byte(cb, rex)
    cb = codebuf_emit_byte(cb, 0x0F)
    cb = codebuf_emit_byte(cb, 0x9C)
    out codebuf_emit_byte(cb, x86_modrm(3, 0, dst))
end.

func x86_emit_je_rel32(cb: CodeBuf, offset: int):
    cb = codebuf_emit_byte(cb, 0x0F)
    cb = codebuf_emit_byte(cb, 0x84)
    out codebuf_emit_i32(cb, offset)
end.

func x86_emit_jne_rel32(cb: CodeBuf, offset: int):
    cb = codebuf_emit_byte(cb, 0x0F)
    cb = codebuf_emit_byte(cb, 0x85)
    out codebuf_emit_i32(cb, offset)
end.

func x86_emit_jg_rel32(cb: CodeBuf, offset: int):
    cb = codebuf_emit_byte(cb, 0x0F)
    cb = codebuf_emit_byte(cb, 0x8F)
    out codebuf_emit_i32(cb, offset)
end.

func x86_emit_jl_rel32(cb: CodeBuf, offset: int):
    cb = codebuf_emit_byte(cb, 0x0F)
    cb = codebuf_emit_byte(cb, 0x8C)
    out codebuf_emit_i32(cb, offset)
end.

func x86_emit_xor_rr(cb: CodeBuf, dst: int, src: int):
    cb = codebuf_emit_byte(cb, x86_rex_w(src, dst))
    cb = codebuf_emit_byte(cb, 0x31)
    out codebuf_emit_byte(cb, x86_modrm(3, src, dst))
end.

func x86_emit_cqo(cb: CodeBuf):
    cb = codebuf_emit_byte(cb, 0x48)
    out codebuf_emit_byte(cb, 0x99)
end.

func x86_emit_idiv(cb: CodeBuf, divisor: int):
    var rex = 0x48
    if divisor >= X86_R8 do
        rex = rex or 0x01
    end
    cb = codebuf_emit_byte(cb, rex)
    cb = codebuf_emit_byte(cb, 0xF7)
    out codebuf_emit_byte(cb, x86_modrm(3, 7, divisor))
end.

func x86_emit_syscall(cb: CodeBuf):
    cb = codebuf_emit_byte(cb, 0x0F)
    out codebuf_emit_byte(cb, 0x05)
end.

func x86_emit_sub_rsp_imm(cb: CodeBuf, imm: int):
    if imm <= 127 do
        cb = codebuf_emit_byte(cb, 0x48)
        cb = codebuf_emit_byte(cb, 0x83)
        cb = codebuf_emit_byte(cb, x86_modrm(3, 5, X86_RSP))
        out codebuf_emit_byte(cb, imm and 0xFF)
    end
    cb = codebuf_emit_byte(cb, 0x48)
    cb = codebuf_emit_byte(cb, 0x81)
    cb = codebuf_emit_byte(cb, x86_modrm(3, 5, X86_RSP))
    out codebuf_emit_i32(cb, imm)
end.

func x86_emit_add_rsp_imm(cb: CodeBuf, imm: int):
    if imm <= 127 do
        cb = codebuf_emit_byte(cb, 0x48)
        cb = codebuf_emit_byte(cb, 0x83)
        cb = codebuf_emit_byte(cb, x86_modrm(3, 0, X86_RSP))
        out codebuf_emit_byte(cb, imm and 0xFF)
    end
    cb = codebuf_emit_byte(cb, 0x48)
    cb = codebuf_emit_byte(cb, 0x81)
    cb = codebuf_emit_byte(cb, x86_modrm(3, 0, X86_RSP))
    out codebuf_emit_i32(cb, imm)
end.

func x86_emit_cmp_imm0(cb: CodeBuf, reg: int):
    cb = codebuf_emit_byte(cb, x86_rex_w(0, reg))
    cb = codebuf_emit_byte(cb, 0x83)
    cb = codebuf_emit_byte(cb, x86_modrm(3, 7, reg))
    out codebuf_emit_byte(cb, 0)
end.

func x86_emit_test_rr(cb: CodeBuf, a: int, b: int):
    cb = codebuf_emit_byte(cb, x86_rex_w(b, a))
    cb = codebuf_emit_byte(cb, 0x85)
    out codebuf_emit_byte(cb, x86_modrm(3, b, a))
end.

func x86_emit_disp(cb: CodeBuf, reg_or_op: int, base: int, disp: int):
    let b7 = base and 7
    if disp == 0 and b7 != 5 do
        cb = codebuf_emit_byte(cb, x86_modrm(0, reg_or_op, base))
        if b7 == 4 do cb = codebuf_emit_byte(cb, 0x24) end
        out cb
    eif disp >= (0 - 128) and disp <= 127 do
        cb = codebuf_emit_byte(cb, x86_modrm(1, reg_or_op, base))
        if b7 == 4 do cb = codebuf_emit_byte(cb, 0x24) end
        out codebuf_emit_byte(cb, disp and 0xFF)
    else
        cb = codebuf_emit_byte(cb, x86_modrm(2, reg_or_op, base))
        if b7 == 4 do cb = codebuf_emit_byte(cb, 0x24) end
        out codebuf_emit_i32(cb, disp)
    end
end.

func x86_emit_mov_reg_mem(cb: CodeBuf, dst: int, base: int, disp: int):
    cb = codebuf_emit_byte(cb, x86_rex_w(dst, base))
    cb = codebuf_emit_byte(cb, 0x8B)
    out x86_emit_disp(cb, dst, base, disp)
end.

func x86_emit_mov_mem_reg(cb: CodeBuf, base: int, disp: int, src: int):
    cb = codebuf_emit_byte(cb, x86_rex_w(src, base))
    cb = codebuf_emit_byte(cb, 0x89)
    out x86_emit_disp(cb, src, base, disp)
end.

func x86_emit_mov_reg_mem32(cb: CodeBuf, dst: int, base: int, disp: int):
    if dst >= X86_R8 or base >= X86_R8 do
        cb = codebuf_emit_byte(cb, x86_rex(dst, base))
    end
    cb = codebuf_emit_byte(cb, 0x8B)
    out x86_emit_disp(cb, dst, base, disp)
end.

func x86_emit_mov_mem_reg32(cb: CodeBuf, base: int, disp: int, src: int):
    if src >= X86_R8 or base >= X86_R8 do
        cb = codebuf_emit_byte(cb, x86_rex(src, base))
    end
    cb = codebuf_emit_byte(cb, 0x89)
    out x86_emit_disp(cb, src, base, disp)
end.

func x86_emit_mov_reg_mem16(cb: CodeBuf, dst: int, base: int, disp: int):
    cb = codebuf_emit_byte(cb, 0x66)
    if dst >= X86_R8 or base >= X86_R8 do
        cb = codebuf_emit_byte(cb, x86_rex(dst, base))
    end
    cb = codebuf_emit_byte(cb, 0x8B)
    out x86_emit_disp(cb, dst, base, disp)
end.

func x86_emit_mov_mem_reg16(cb: CodeBuf, base: int, disp: int, src: int):
    cb = codebuf_emit_byte(cb, 0x66)
    if src >= X86_R8 or base >= X86_R8 do
        cb = codebuf_emit_byte(cb, x86_rex(src, base))
    end
    cb = codebuf_emit_byte(cb, 0x89)
    out x86_emit_disp(cb, src, base, disp)
end.

func x86_emit_movzx_reg_mem8(cb: CodeBuf, dst: int, base: int, disp: int):
    cb = codebuf_emit_byte(cb, x86_rex_w(dst, base))
    cb = codebuf_emit_byte(cb, 0x0F)
    cb = codebuf_emit_byte(cb, 0xB6)
    out x86_emit_disp(cb, dst, base, disp)
end.

func x86_emit_mov_mem_reg8(cb: CodeBuf, base: int, disp: int, src: int):
    var rex = 0x40
    if src >= X86_R8 do rex = rex or 0x04 end
    if base >= X86_R8 do rex = rex or 0x01 end
    cb = codebuf_emit_byte(cb, rex)
    cb = codebuf_emit_byte(cb, 0x88)
    out x86_emit_disp(cb, src, base, disp)
end.

func x86_emit_setge(cb: CodeBuf, dst: int):
    var rex = 0x40
    if dst >= X86_R8 do
        rex = 0x41
    end
    cb = codebuf_emit_byte(cb, rex)
    cb = codebuf_emit_byte(cb, 0x0F)
    cb = codebuf_emit_byte(cb, 0x9D)
    out codebuf_emit_byte(cb, x86_modrm(3, 0, dst))
end.

func x86_emit_setle(cb: CodeBuf, dst: int):
    var rex = 0x40
    if dst >= X86_R8 do
        rex = 0x41
    end
    cb = codebuf_emit_byte(cb, rex)
    cb = codebuf_emit_byte(cb, 0x0F)
    cb = codebuf_emit_byte(cb, 0x9E)
    out codebuf_emit_byte(cb, x86_modrm(3, 0, dst))
end.

func x86_emit_jge_rel32(cb: CodeBuf, offset: int):
    cb = codebuf_emit_byte(cb, 0x0F)
    cb = codebuf_emit_byte(cb, 0x8D)
    out codebuf_emit_i32(cb, offset)
end.

func x86_emit_jle_rel32(cb: CodeBuf, offset: int):
    cb = codebuf_emit_byte(cb, 0x0F)
    cb = codebuf_emit_byte(cb, 0x8E)
    out codebuf_emit_i32(cb, offset)
end.

func x86_emit_and_rr(cb: CodeBuf, dst: int, src: int):
    cb = codebuf_emit_byte(cb, x86_rex_w(src, dst))
    cb = codebuf_emit_byte(cb, 0x21)
    out codebuf_emit_byte(cb, x86_modrm(3, src, dst))
end.

func x86_emit_or_rr(cb: CodeBuf, dst: int, src: int):
    cb = codebuf_emit_byte(cb, x86_rex_w(src, dst))
    cb = codebuf_emit_byte(cb, 0x09)
    out codebuf_emit_byte(cb, x86_modrm(3, src, dst))
end.

func x86_emit_shl_cl(cb: CodeBuf, dst: int):
    cb = codebuf_emit_byte(cb, x86_rex_w(0, dst))
    cb = codebuf_emit_byte(cb, 0xD3)
    out codebuf_emit_byte(cb, x86_modrm(3, 4, dst))
end.

func x86_emit_shr_cl(cb: CodeBuf, dst: int):
    cb = codebuf_emit_byte(cb, x86_rex_w(0, dst))
    cb = codebuf_emit_byte(cb, 0xD3)
    out codebuf_emit_byte(cb, x86_modrm(3, 5, dst))
end.

func x86_emit_not_rr(cb: CodeBuf, dst: int):
    cb = codebuf_emit_byte(cb, x86_rex_w(0, dst))
    cb = codebuf_emit_byte(cb, 0xF7)
    out codebuf_emit_byte(cb, x86_modrm(3, 2, dst))
end.

# ── x86_64 SSE2 / AVX SIMD Instruction Emitters ──
func x86_emit_movupd_load(cb: CodeBuf, xmm_dst: int, r_base: int):
    cb = codebuf_emit_byte(cb, 0x66)
    cb = codebuf_emit_byte(cb, 0x0F)
    cb = codebuf_emit_byte(cb, 0x10)
    out codebuf_emit_byte(cb, x86_modrm(0, xmm_dst, r_base))
end.

func x86_emit_movupd_store(cb: CodeBuf, r_base: int, xmm_src: int):
    cb = codebuf_emit_byte(cb, 0x66)
    cb = codebuf_emit_byte(cb, 0x0F)
    cb = codebuf_emit_byte(cb, 0x11)
    out codebuf_emit_byte(cb, x86_modrm(0, xmm_src, r_base))
end.

func x86_emit_addpd(cb: CodeBuf, xmm_dst: int, xmm_src: int):
    cb = codebuf_emit_byte(cb, 0x66)
    cb = codebuf_emit_byte(cb, 0x0F)
    cb = codebuf_emit_byte(cb, 0x58)
    out codebuf_emit_byte(cb, x86_modrm(3, xmm_dst, xmm_src))
end.

func x86_emit_subpd(cb: CodeBuf, xmm_dst: int, xmm_src: int):
    cb = codebuf_emit_byte(cb, 0x66)
    cb = codebuf_emit_byte(cb, 0x0F)
    cb = codebuf_emit_byte(cb, 0x5C)
    out codebuf_emit_byte(cb, x86_modrm(3, xmm_dst, xmm_src))
end.

func x86_emit_mulpd(cb: CodeBuf, xmm_dst: int, xmm_src: int):
    cb = codebuf_emit_byte(cb, 0x66)
    cb = codebuf_emit_byte(cb, 0x0F)
    cb = codebuf_emit_byte(cb, 0x59)
    out codebuf_emit_byte(cb, x86_modrm(3, xmm_dst, xmm_src))
end.

func x86_emit_paddq(cb: CodeBuf, xmm_dst: int, xmm_src: int):
    cb = codebuf_emit_byte(cb, 0x66)
    cb = codebuf_emit_byte(cb, 0x0F)
    cb = codebuf_emit_byte(cb, 0xD4)
    out codebuf_emit_byte(cb, x86_modrm(3, xmm_dst, xmm_src))
end.

func x86_emit_psubq(cb: CodeBuf, xmm_dst: int, xmm_src: int):
    cb = codebuf_emit_byte(cb, 0x66)
    cb = codebuf_emit_byte(cb, 0x0F)
    cb = codebuf_emit_byte(cb, 0xFB)
    out codebuf_emit_byte(cb, x86_modrm(3, xmm_dst, xmm_src))
end.

func x86_emit_neg_r(cb: CodeBuf, reg: int):
    if reg >= 8 do
        cb = codebuf_emit_byte(cb, 0x49)
        cb = codebuf_emit_byte(cb, 0xF7)
        out codebuf_emit_byte(cb, 0xD8 + (reg - 8))
    else
        cb = codebuf_emit_byte(cb, 0x48)
        cb = codebuf_emit_byte(cb, 0xF7)
        out codebuf_emit_byte(cb, 0xD8 + reg)
    end
end.

func x86_emit_shr_imm(cb: CodeBuf, reg: int, imm: int):
    if reg >= 8 do
        cb = codebuf_emit_byte(cb, 0x49)
        cb = codebuf_emit_byte(cb, 0xC1)
        cb = codebuf_emit_byte(cb, 0xE8 + (reg - 8))
        out codebuf_emit_byte(cb, imm and 0xFF)
    else
        cb = codebuf_emit_byte(cb, 0x48)
        cb = codebuf_emit_byte(cb, 0xC1)
        cb = codebuf_emit_byte(cb, 0xE8 + reg)
        out codebuf_emit_byte(cb, imm and 0xFF)
    end
end.

func x86_emit_shl_imm(cb: CodeBuf, reg: int, imm: int):
    if reg >= 8 do
        cb = codebuf_emit_byte(cb, 0x49)
        cb = codebuf_emit_byte(cb, 0xC1)
        cb = codebuf_emit_byte(cb, 0xE0 + (reg - 8))
        out codebuf_emit_byte(cb, imm and 0xFF)
    else
        cb = codebuf_emit_byte(cb, 0x48)
        cb = codebuf_emit_byte(cb, 0xC1)
        cb = codebuf_emit_byte(cb, 0xE0 + reg)
        out codebuf_emit_byte(cb, imm and 0xFF)
    end
end.

func x86_emit_cmp_reg_imm32(cb: CodeBuf, reg: int, imm: int):
    if imm >= (0 - 128) and imm <= 127 do
        if reg >= 8 do
            cb = codebuf_emit_byte(cb, 0x49)
            cb = codebuf_emit_byte(cb, 0x83)
            cb = codebuf_emit_byte(cb, 0xF8 + (reg - 8))
            out codebuf_emit_byte(cb, imm and 0xFF)
        else
            cb = codebuf_emit_byte(cb, 0x48)
            cb = codebuf_emit_byte(cb, 0x83)
            cb = codebuf_emit_byte(cb, 0xF8 + reg)
            out codebuf_emit_byte(cb, imm and 0xFF)
        end
    else
        if reg >= 8 do
            cb = codebuf_emit_byte(cb, 0x49)
            cb = codebuf_emit_byte(cb, 0x81)
            cb = codebuf_emit_byte(cb, 0xF8 + (reg - 8))
            out codebuf_emit_u32(cb, imm)
        else
            cb = codebuf_emit_byte(cb, 0x48)
            cb = codebuf_emit_byte(cb, 0x81)
            cb = codebuf_emit_byte(cb, 0xF8 + reg)
            out codebuf_emit_u32(cb, imm)
        end
    end
end.

func x86_emit_and_imm8(cb: CodeBuf, reg: int, imm: int):
    if reg >= 8 do
        cb = codebuf_emit_byte(cb, 0x49)
        cb = codebuf_emit_byte(cb, 0x83)
        cb = codebuf_emit_byte(cb, 0xE0 + (reg - 8))
        out codebuf_emit_byte(cb, imm and 0xFF)
    else
        cb = codebuf_emit_byte(cb, 0x48)
        cb = codebuf_emit_byte(cb, 0x83)
        cb = codebuf_emit_byte(cb, 0xE0 + reg)
        out codebuf_emit_byte(cb, imm and 0xFF)
    end
end.

func x86_emit_add_imm8(cb: CodeBuf, reg: int, imm: int):
    if reg >= 8 do
        cb = codebuf_emit_byte(cb, 0x49)
        cb = codebuf_emit_byte(cb, 0x83)
        cb = codebuf_emit_byte(cb, 0xC0 + (reg - 8))
        out codebuf_emit_byte(cb, imm and 0xFF)
    else
        cb = codebuf_emit_byte(cb, 0x48)
        cb = codebuf_emit_byte(cb, 0x83)
        cb = codebuf_emit_byte(cb, 0xC0 + reg)
        out codebuf_emit_byte(cb, imm and 0xFF)
    end
end.

func x86_emit_movq_xmm_gpr(cb: CodeBuf, xmm: int, gpr: int):
    # movq xmm, r64: 66 REX.W 0F 6E /r
    cb = codebuf_emit_byte(cb, 0x66)
    var rex = 0x48
    if xmm >= 8 do rex = rex or 0x04 end
    if gpr >= 8 do rex = rex or 0x01 end
    cb = codebuf_emit_byte(cb, rex)
    cb = codebuf_emit_byte(cb, 0x0F)
    cb = codebuf_emit_byte(cb, 0x6E)
    out codebuf_emit_byte(cb, x86_modrm(3, xmm, gpr))
end.

func x86_emit_movq_gpr_xmm(cb: CodeBuf, gpr: int, xmm: int):
    # movq r64, xmm: 66 REX.W 0F 7E /r
    cb = codebuf_emit_byte(cb, 0x66)
    var rex = 0x48
    if xmm >= 8 do rex = rex or 0x04 end
    if gpr >= 8 do rex = rex or 0x01 end
    cb = codebuf_emit_byte(cb, rex)
    cb = codebuf_emit_byte(cb, 0x0F)
    cb = codebuf_emit_byte(cb, 0x7E)
    out codebuf_emit_byte(cb, x86_modrm(3, xmm, gpr))
end.

func x86_emit_movd_xmm_gpr(cb: CodeBuf, xmm: int, gpr: int):
    # movd xmm, r32: 66 [REX] 0F 6E /r
    cb = codebuf_emit_byte(cb, 0x66)
    var rex = 0
    if xmm >= 8 do rex = rex or 0x04 end
    if gpr >= 8 do rex = rex or 0x01 end
    if rex != 0 do cb = codebuf_emit_byte(cb, 0x40 or rex) end
    cb = codebuf_emit_byte(cb, 0x0F)
    cb = codebuf_emit_byte(cb, 0x6E)
    out codebuf_emit_byte(cb, x86_modrm(3, xmm, gpr))
end.

func x86_emit_movd_gpr_xmm(cb: CodeBuf, gpr: int, xmm: int):
    # movd r32, xmm: 66 [REX] 0F 7E /r
    cb = codebuf_emit_byte(cb, 0x66)
    var rex = 0
    if xmm >= 8 do rex = rex or 0x04 end
    if gpr >= 8 do rex = rex or 0x01 end
    if rex != 0 do cb = codebuf_emit_byte(cb, 0x40 or rex) end
    cb = codebuf_emit_byte(cb, 0x0F)
    cb = codebuf_emit_byte(cb, 0x7E)
    out codebuf_emit_byte(cb, x86_modrm(3, xmm, gpr))
end.

func x86_emit_movsbq_reg_mem(cb: CodeBuf, dst: int, base: int, disp: int):
    # movsbq r64, m8: REX.W 0F BE /r
    var rex = 0x48
    if dst >= 8 do rex = rex or 0x04 end
    if base >= 8 do rex = rex or 0x01 end
    cb = codebuf_emit_byte(cb, rex)
    cb = codebuf_emit_byte(cb, 0x0F)
    cb = codebuf_emit_byte(cb, 0xBE)
    out x86_emit_disp(cb, dst, base, disp)
end.

func x86_emit_movzwq_reg_mem(cb: CodeBuf, dst: int, base: int, disp: int):
    # movzwq r64, m16: REX.W 0F B7 /r
    var rex = 0x48
    if dst >= 8 do rex = rex or 0x04 end
    if base >= 8 do rex = rex or 0x01 end
    cb = codebuf_emit_byte(cb, rex)
    cb = codebuf_emit_byte(cb, 0x0F)
    cb = codebuf_emit_byte(cb, 0xB7)
    out x86_emit_disp(cb, dst, base, disp)
end.

func x86_emit_movswq_reg_mem(cb: CodeBuf, dst: int, base: int, disp: int):
    # movswq r64, m16: REX.W 0F BF /r
    var rex = 0x48
    if dst >= 8 do rex = rex or 0x04 end
    if base >= 8 do rex = rex or 0x01 end
    cb = codebuf_emit_byte(cb, rex)
    cb = codebuf_emit_byte(cb, 0x0F)
    cb = codebuf_emit_byte(cb, 0xBF)
    out x86_emit_disp(cb, dst, base, disp)
end.

func x86_emit_movslq_reg_mem(cb: CodeBuf, dst: int, base: int, disp: int):
    # movslq r64, m32: REX.W 63 /r
    var rex = 0x48
    if dst >= 8 do rex = rex or 0x04 end
    if base >= 8 do rex = rex or 0x01 end
    cb = codebuf_emit_byte(cb, rex)
    cb = codebuf_emit_byte(cb, 0x63)
    out x86_emit_disp(cb, dst, base, disp)
end.

func x86_emit_mulsd_xx(cb: CodeBuf, dst_xmm: int, src_xmm: int):
    cb = codebuf_emit_byte(cb, 0xF2)
    cb = codebuf_emit_byte(cb, 0x0F)
    cb = codebuf_emit_byte(cb, 0x59)
    out codebuf_emit_byte(cb, x86_modrm(3, dst_xmm, src_xmm))
end.

func x86_emit_addsd_xx(cb: CodeBuf, dst_xmm: int, src_xmm: int):
    cb = codebuf_emit_byte(cb, 0xF2)
    cb = codebuf_emit_byte(cb, 0x0F)
    cb = codebuf_emit_byte(cb, 0x58)
    out codebuf_emit_byte(cb, x86_modrm(3, dst_xmm, src_xmm))
end.

func x86_emit_subsd_xx(cb: CodeBuf, dst_xmm: int, src_xmm: int):
