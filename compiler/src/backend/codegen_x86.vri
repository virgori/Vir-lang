    cb = codebuf_emit_byte(cb, 0xF3)
    cb = codebuf_emit_byte(cb, 0x0F)
    cb = codebuf_emit_byte(cb, 0x58)
    out codebuf_emit_byte(cb, x86_modrm(3, dst_xmm, src_xmm))
end.

func x86_emit_subss_xx(cb: CodeBuf, dst_xmm: int, src_xmm: int):
    cb = codebuf_emit_byte(cb, 0xF3)
    cb = codebuf_emit_byte(cb, 0x0F)
    cb = codebuf_emit_byte(cb, 0x5C)
    out codebuf_emit_byte(cb, x86_modrm(3, dst_xmm, src_xmm))
