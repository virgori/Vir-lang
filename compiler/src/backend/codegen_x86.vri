func x86_emit_cvtss2sd_xx(cb: CodeBuf, dst_xmm: int, src_xmm: int):
    cb = codebuf_emit_byte(cb, 0xF3)
    var rex = 0x40
    if dst_xmm >= 8 do rex = rex or 0x04 end
    if src_xmm >= 8 do rex = rex or 0x01 end
    if rex != 0x40 do cb = codebuf_emit_byte(cb, rex) end
    cb = codebuf_emit_byte(cb, 0x0F)
    cb = codebuf_emit_byte(cb, 0x5A)
    out codebuf_emit_byte(cb, x86_modrm(3, dst_xmm, src_xmm))
end.

func x86_emit_cvtsd2ss_xx(cb: CodeBuf, dst_xmm: int, src_xmm: int):
    cb = codebuf_emit_byte(cb, 0xF2)
    var rex = 0x40
    if dst_xmm >= 8 do rex = rex or 0x04 end
    if src_xmm >= 8 do rex = rex or 0x01 end
    if rex != 0x40 do cb = codebuf_emit_byte(cb, rex) end
    cb = codebuf_emit_byte(cb, 0x0F)
    cb = codebuf_emit_byte(cb, 0x5A)
    out codebuf_emit_byte(cb, x86_modrm(3, dst_xmm, src_xmm))
end.

func x86_emit_cvtsi2sd_xg(cb: CodeBuf, dst_xmm: int, src_gpr: int):
    cb = codebuf_emit_byte(cb, 0xF2)
    cb = codebuf_emit_byte(cb, 0x48 or (((dst_xmm / 8) and 1) shl 2) or ((src_gpr / 8) and 1))
    cb = codebuf_emit_byte(cb, 0x0F)
    cb = codebuf_emit_byte(cb, 0x2A)
    out codebuf_emit_byte(cb, x86_modrm(3, dst_xmm, src_gpr))
end.

func x86_emit_cvttsd2si_gx(cb: CodeBuf, dst_gpr: int, src_xmm: int):
    cb = codebuf_emit_byte(cb, 0xF2)
    cb = codebuf_emit_byte(cb, 0x48 or (((dst_gpr / 8) and 1) shl 2) or ((src_xmm / 8) and 1))
    cb = codebuf_emit_byte(cb, 0x0F)
    cb = codebuf_emit_byte(cb, 0x2C)
    out codebuf_emit_byte(cb, x86_modrm(3, dst_gpr, src_xmm))
end.

func x86_emit_movdqu_load(cb: CodeBuf, xmm_dst: int, r_base: int, disp: int):
    cb = codebuf_emit_byte(cb, 0xF3)
    var rex = 0x40
    if xmm_dst >= 8 do rex = rex or 0x04 end
    if r_base >= 8 do rex = rex or 0x01 end
    if rex != 0x40 do cb = codebuf_emit_byte(cb, rex) end
    cb = codebuf_emit_byte(cb, 0x0F)
    cb = codebuf_emit_byte(cb, 0x6F)
    out x86_emit_disp(cb, xmm_dst, r_base, disp)
end.

func x86_emit_movdqu_store(cb: CodeBuf, r_base: int, disp: int, xmm_src: int):
    cb = codebuf_emit_byte(cb, 0xF3)
    var rex = 0x40
    if xmm_src >= 8 do rex = rex or 0x04 end
    if r_base >= 8 do rex = rex or 0x01 end
    if rex != 0x40 do cb = codebuf_emit_byte(cb, rex) end
    cb = codebuf_emit_byte(cb, 0x0F)
    cb = codebuf_emit_byte(cb, 0x7F)
    out x86_emit_disp(cb, xmm_src, r_base, disp)
end.

func x86_emit_punpcklqdq(cb: CodeBuf, xmm_dst: int, xmm_src: int):
    cb = codebuf_emit_byte(cb, 0x66)
    var rex = 0x40
    if xmm_dst >= 8 do rex = rex or 0x04 end
    if xmm_src >= 8 do rex = rex or 0x01 end
    if rex != 0x40 do cb = codebuf_emit_byte(cb, rex) end
    cb = codebuf_emit_byte(cb, 0x0F)
    cb = codebuf_emit_byte(cb, 0x6C)
    out codebuf_emit_byte(cb, x86_modrm(3, xmm_dst, xmm_src))
end.

func x86_emit_pxor(cb: CodeBuf, xmm_dst: int, xmm_src: int):
    cb = codebuf_emit_byte(cb, 0x66)
    var rex = 0x40
    if xmm_dst >= 8 do rex = rex or 0x04 end
    if xmm_src >= 8 do rex = rex or 0x01 end
    if rex != 0x40 do cb = codebuf_emit_byte(cb, rex) end
    cb = codebuf_emit_byte(cb, 0x0F)
    cb = codebuf_emit_byte(cb, 0xEF)
    out codebuf_emit_byte(cb, x86_modrm(3, xmm_dst, xmm_src))
end.

func x86_emit_cvtsi2ss_xg(cb: CodeBuf, dst_xmm: int, src_gpr: int):
    # cvtsi2ss xmm, r64: F3 REX.W 0F 2A /r
    cb = codebuf_emit_byte(cb, 0xF3)
    cb = codebuf_emit_byte(cb, 0x48 or (((dst_xmm / 8) and 1) shl 2) or ((src_gpr / 8) and 1))
    cb = codebuf_emit_byte(cb, 0x0F)
    cb = codebuf_emit_byte(cb, 0x2A)
    out codebuf_emit_byte(cb, x86_modrm(3, dst_xmm, src_gpr))
end.

func x86_emit_cvtss2si_gx(cb: CodeBuf, dst_gpr: int, src_xmm: int):
    # cvtss2si r64, xmm: F3 REX.W 0F 2D /r (honours MXCSR rounding, default nearest-even)
    cb = codebuf_emit_byte(cb, 0xF3)
    cb = codebuf_emit_byte(cb, 0x48 or (((dst_gpr / 8) and 1) shl 2) or ((src_xmm / 8) and 1))
    cb = codebuf_emit_byte(cb, 0x0F)
    cb = codebuf_emit_byte(cb, 0x2D)
    out codebuf_emit_byte(cb, x86_modrm(3, dst_gpr, src_xmm))
end.

func x86_emit_cvttss2si_gx(cb: CodeBuf, dst_gpr: int, src_xmm: int):
    # cvttss2si r64, xmm: F3 REX.W 0F 2C /r (truncation towards zero)
    cb = codebuf_emit_byte(cb, 0xF3)
    cb = codebuf_emit_byte(cb, 0x48 or (((dst_gpr / 8) and 1) shl 2) or ((src_xmm / 8) and 1))
    cb = codebuf_emit_byte(cb, 0x0F)
    cb = codebuf_emit_byte(cb, 0x2C)
    out codebuf_emit_byte(cb, x86_modrm(3, dst_gpr, src_xmm))
end.


func x86_emit_cvtsd2si_gx(cb: CodeBuf, dst_gpr: int, src_xmm: int):
    # cvtsd2si r64, xmm: F2 REX.W 0F 2D /r (honours MXCSR rounding, default nearest-even)
    cb = codebuf_emit_byte(cb, 0xF2)
    cb = codebuf_emit_byte(cb, 0x48 or (((dst_gpr / 8) and 1) shl 2) or ((src_xmm / 8) and 1))
    cb = codebuf_emit_byte(cb, 0x0F)
    cb = codebuf_emit_byte(cb, 0x2D)
    out codebuf_emit_byte(cb, x86_modrm(3, dst_gpr, src_xmm))
end.

func x86_f16_patch_rel32(cb: CodeBuf, at: int, dest: int):
    out codebuf_patch_i32(cb, at, dest - (at + 4))
end.

# IEEE-754 binary16 -> binary32 (exact; every half value is representable).
# in : h holds the zero-extended 16-bit pattern
# out: dst_xmm low lane = float32; clobbers t1, t2, tmp_xmm (h is preserved)
func x86_emit_f16_to_f32(cb: CodeBuf, h: int, dst_xmm: int, t1: int, t2: int, tmp_xmm: int):
    cb = x86_emit_mov_rr(cb, t1, h)
    cb = x86_emit_shr_imm(cb, t1, 10)
    cb = x86_emit_and_imm8(cb, t1, 31)
    cb = x86_emit_cmp_imm0(cb, t1)
    cb = x86_emit_je_rel32(cb, 0)
    let fix_sub = codebuf_offset(cb) as int
    cb = x86_emit_cmp_reg_imm32(cb, t1, 31)
    cb = x86_emit_jne_rel32(cb, 0)
    let fix_normal = codebuf_offset(cb) as int
    # Inf / NaN: exponent 0xFF, mantissa carried over
    cb = x86_emit_mov_reg_imm32(cb, t1, 0x7F800000)
    cb = x86_emit_jmp_rel32(cb, 0)
    let fix_special_mant = codebuf_offset(cb) as int
    # Normal: exponent rebias 15 -> 127
    let normal_pos = codebuf_offset(cb) as int
    cb = x86_f16_patch_rel32(cb, fix_normal - 4, normal_pos)
    cb = x86_emit_mov_reg_imm32(cb, t2, 112)
    cb = x86_emit_add_rr(cb, t1, t2)
    cb = x86_emit_shl_imm(cb, t1, 23)
    let mant_pos = codebuf_offset(cb) as int
    cb = x86_f16_patch_rel32(cb, fix_special_mant - 4, mant_pos)
    cb = x86_emit_mov_rr(cb, t2, h)
    cb = x86_emit_shl_imm(cb, t2, 54)
    cb = x86_emit_shr_imm(cb, t2, 54)
    cb = x86_emit_shl_imm(cb, t2, 13)
    cb = x86_emit_or_rr(cb, t1, t2)
    cb = x86_emit_jmp_rel32(cb, 0)
    let fix_sign_a = codebuf_offset(cb) as int
    # Zero / subnormal: value = mantissa * 2^-24 (exact), sign applied below
    let sub_pos = codebuf_offset(cb) as int
    cb = x86_f16_patch_rel32(cb, fix_sub - 4, sub_pos)
    cb = x86_emit_mov_rr(cb, t1, h)
    cb = x86_emit_shl_imm(cb, t1, 54)
    cb = x86_emit_shr_imm(cb, t1, 54)
    cb = x86_emit_cvtsi2ss_xg(cb, dst_xmm, t1)
    cb = x86_emit_mov_reg_imm32(cb, t2, 0x33800000)
    cb = x86_emit_movd_xmm_gpr(cb, tmp_xmm, t2)
    cb = x86_emit_mulss_xx(cb, dst_xmm, tmp_xmm)
    cb = x86_emit_movd_gpr_xmm(cb, t1, dst_xmm)
    let sign_pos = codebuf_offset(cb) as int
    cb = x86_f16_patch_rel32(cb, fix_sign_a - 4, sign_pos)
    cb = x86_emit_mov_rr(cb, t2, h)
    cb = x86_emit_shr_imm(cb, t2, 15)
    cb = x86_emit_shl_imm(cb, t2, 31)
    cb = x86_emit_or_rr(cb, t1, t2)
    out x86_emit_movd_xmm_gpr(cb, dst_xmm, t1)
end.

# binary32 (wide == 0) or binary64 (wide == 1) -> IEEE-754 binary16, round to
# nearest even, with signed zero, subnormals, overflow to Inf, Inf and quiet NaN.
# in : src_xmm low lane holds the value
# out: dst holds the zero-extended 16-bit pattern; clobbers src_xmm, t1, t2, tmp_xmm
func x86_emit_float_to_f16(cb: CodeBuf, wide: int, src_xmm: int, dst: int, t1: int, t2: int, tmp_xmm: int):
    var inf_bits = 0x7F800000
    var ovf_bits = 0x477FF000
    var sub_lim = 0x38800000
    var rebias = 0x38000000
    var mul_bits = 0x4B800000
    var shift = 13
    var sign_shift = 16
    var round_add = 0xFFF
    var abs_shift = 33
    if wide == 1 do
        inf_bits = 0x7FF0000000000000
        ovf_bits = 0x40EFFE0000000000
        sub_lim = 0x3F10000000000000
        rebias = 0x3F00000000000000
        mul_bits = 0x4170000000000000
        shift = 42
        sign_shift = 48
        round_add = 0x1FFFFFFFFFF
        abs_shift = 1
    end
    if wide == 1 do
        cb = x86_emit_movq_gpr_xmm(cb, t1, src_xmm)
    else
        cb = x86_emit_movd_gpr_xmm(cb, t1, src_xmm)
    end
    # sign -> bit 15 of dst
    cb = x86_emit_mov_rr(cb, dst, t1)
    cb = x86_emit_shr_imm(cb, dst, sign_shift)
    cb = x86_emit_mov_reg_imm32(cb, t2, 0x8000)
    cb = x86_emit_and_rr(cb, dst, t2)
    # t1 = |x| bit pattern
    cb = x86_emit_shl_imm(cb, t1, abs_shift)
    cb = x86_emit_shr_imm(cb, t1, abs_shift)
    cb = x86_emit_mov_reg_imm64(cb, t2, inf_bits)
    cb = x86_emit_cmp_rr(cb, t1, t2)
    cb = x86_emit_jg_rel32(cb, 0)
    let fix_nan = codebuf_offset(cb) as int
    cb = x86_emit_je_rel32(cb, 0)
    let fix_inf_a = codebuf_offset(cb) as int
    cb = x86_emit_mov_reg_imm64(cb, t2, ovf_bits)
    cb = x86_emit_cmp_rr(cb, t1, t2)
    cb = x86_emit_jge_rel32(cb, 0)
    let fix_inf_b = codebuf_offset(cb) as int
    cb = x86_emit_mov_reg_imm64(cb, t2, sub_lim)
    cb = x86_emit_cmp_rr(cb, t1, t2)
    cb = x86_emit_jl_rel32(cb, 0)
    let fix_subn = codebuf_offset(cb) as int
    # Normal range: rebias exponent, round to nearest even on the dropped bits
    cb = x86_emit_mov_rr(cb, t2, t1)
    cb = x86_emit_shr_imm(cb, t2, shift)
    cb = x86_emit_and_imm8(cb, t2, 1)
    cb = x86_emit_add_rr(cb, t1, t2)
    cb = x86_emit_mov_reg_imm64(cb, t2, round_add - rebias)
    cb = x86_emit_add_rr(cb, t1, t2)
    cb = x86_emit_shr_imm(cb, t1, shift)
    cb = x86_emit_or_rr(cb, dst, t1)
    cb = x86_emit_jmp_rel32(cb, 0)
    let fix_done_a = codebuf_offset(cb) as int
    # Infinity / overflow
    let inf_pos = codebuf_offset(cb) as int
    cb = x86_f16_patch_rel32(cb, fix_inf_a - 4, inf_pos)
    cb = x86_f16_patch_rel32(cb, fix_inf_b - 4, inf_pos)
    cb = x86_emit_mov_reg_imm32(cb, t2, 0x7C00)
    cb = x86_emit_or_rr(cb, dst, t2)
    cb = x86_emit_jmp_rel32(cb, 0)
    let fix_done_b = codebuf_offset(cb) as int
    # NaN: keep the top payload bits and force the quiet bit
    let nan_pos = codebuf_offset(cb) as int
    cb = x86_f16_patch_rel32(cb, fix_nan - 4, nan_pos)
    cb = x86_emit_shr_imm(cb, t1, shift)
    cb = x86_emit_shl_imm(cb, t1, 54)
    cb = x86_emit_shr_imm(cb, t1, 54)
    cb = x86_emit_or_rr(cb, dst, t1)
    cb = x86_emit_mov_reg_imm32(cb, t2, 0x7E00)
    cb = x86_emit_or_rr(cb, dst, t2)
    cb = x86_emit_jmp_rel32(cb, 0)
    let fix_done_c = codebuf_offset(cb) as int
    # Zero / subnormal: round(|x| * 2^24) is the mantissa field; 1024 carries into the smallest normal
    let subn_pos = codebuf_offset(cb) as int
    cb = x86_f16_patch_rel32(cb, fix_subn - 4, subn_pos)
    cb = x86_emit_mov_reg_imm64(cb, t2, mul_bits)
    if wide == 1 do
        cb = x86_emit_movq_xmm_gpr(cb, src_xmm, t1)
        cb = x86_emit_movq_xmm_gpr(cb, tmp_xmm, t2)
        cb = x86_emit_mulsd_xx(cb, src_xmm, tmp_xmm)
        cb = x86_emit_cvtsd2si_gx(cb, t1, src_xmm)
    else
        cb = x86_emit_movd_xmm_gpr(cb, src_xmm, t1)
        cb = x86_emit_movd_xmm_gpr(cb, tmp_xmm, t2)
        cb = x86_emit_mulss_xx(cb, src_xmm, tmp_xmm)
        cb = x86_emit_cvtss2si_gx(cb, t1, src_xmm)
    end
    cb = x86_emit_or_rr(cb, dst, t1)
    let done_pos = codebuf_offset(cb) as int
    cb = x86_f16_patch_rel32(cb, fix_done_a - 4, done_pos)
    cb = x86_f16_patch_rel32(cb, fix_done_b - 4, done_pos)
    cb = x86_f16_patch_rel32(cb, fix_done_c - 4, done_pos)
    out cb
end.

export x86_emit_cvtsi2ss_xg, x86_emit_cvtss2si_gx, x86_emit_cvttss2si_gx, x86_emit_cvtsd2si_gx, x86_emit_f16_to_f32, x86_emit_float_to_f16
export X86_RAX, X86_RCX, X86_RDX, X86_RBX, X86_RSP, X86_RBP, X86_RSI, X86_RDI
