##
 * compiler/src/frontend/parser/diagnostics.vri — Parser Error Tracking
 * =====================================================================
 ##

include types
include string_rt
include rt.alloc
import vir_alloc, page_alloc from rt.alloc
include parser_ast
include parser_state


# Code is explicit parser metadata, never recovered from rendered wording.
func parse_error_code_loc:
    ref p: Parser
    in code: int
       message: string
       line: int
       column: int
    g_parserPendingLine = line
    g_parserPendingColumn = column
    let first = p.error_line == 0
    g_parserPendingCode = code
    g_parserPendingTagged = 1
    let prefix = rt_strcat(rt_strcat("[E", rt_itoa(code)), "] ")
    p = parse_error(p, rt_strcat(prefix, message))
    g_parserPendingCode = 1001
    g_parserPendingTagged = 0
    g_parserPendingLine = 0
    g_parserPendingColumn = 0
    if first do
        g_parserErrorCode = code
        g_parserErrorDetail = native_read_i64(p as int, 24) + 8
    end
    out p
end.

func parse_error_code_loc_related:
    ref p: Parser
    in code: int
       message: string
       line: int
       column: int
       sec_line: int
       sec_column: int
       sec_note: string
    g_parserPendingLine = line
    g_parserPendingColumn = column
    g_parserPendingSecLine = sec_line
    g_parserPendingSecColumn = sec_column
    g_parserPendingSecNote = sec_note as int
    let first = p.error_line == 0
    g_parserPendingCode = code
    g_parserPendingTagged = 1
    let prefix = rt_strcat(rt_strcat("[E", rt_itoa(code)), "] ")
    p = parse_error(p, rt_strcat(prefix, message))
    g_parserPendingCode = 1001
    g_parserPendingTagged = 0
    g_parserPendingLine = 0
    g_parserPendingColumn = 0
    g_parserPendingSecLine = 0
    g_parserPendingSecColumn = 0
    g_parserPendingSecNote = 0
    if first do
        g_parserErrorCode = code
        g_parserErrorDetail = native_read_i64(p as int, 24) + 8
    end
    out p
end.

