export g_parserErrorCode, g_parserErrorDetail, g_parserErrors

func parse_error_code(ref p: Parser, code: int, message: string):
    let first = p.error_line == 0
    g_parserPendingCode = code
    g_parserPendingTagged = 1
    let prefix = rt_strcat(rt_strcat("[E", rt_itoa(code)), "] ")
    p = parse_error(p, rt_strcat(prefix, message))
    g_parserPendingCode = 1001
    g_parserPendingTagged = 0
    if first do
        g_parserErrorCode = code
        g_parserErrorDetail = native_read_i64(p as int, 24) + 8
    end
    out p
end.

func expect_tok_code:
    ref p: Parser
    in tokenType: TokType
       code: int
       message: string
    let first = p.error_line == 0
    g_parserPendingCode = code
    g_parserPendingTagged = 1
    let prefix = rt_strcat(rt_strcat("[E", rt_itoa(code)), "] ")
    var (parsed, taken, matched) = expect_tok(p, tokenType, rt_strcat(prefix, message))
    g_parserPendingCode = 1001
    g_parserPendingTagged = 0
    if first do
        if !matched do
            g_parserErrorCode = code
            g_parserErrorDetail = native_read_i64(parsed as int, 24) + 8
        end
    end
    out (parsed, taken, matched)
end.

func parserErrorEntryRelated(code: int, line: int, column: int, detail: int, sec_line: int, sec_col: int, sec_note: int) -> int:
    let entry = vir_alloc(56)
    native_write_i64(entry, 0, code)
    native_write_i64(entry, 8, line)
    native_write_i64(entry, 16, column)
    native_write_i64(entry, 24, detail)
    native_write_i64(entry, 32, sec_line)
    native_write_i64(entry, 40, sec_col)
    native_write_i64(entry, 48, sec_note)
    out entry
end.

# Return the allocation to its persistent vector owner before leaving the scope.
func parserErrorEntry(code: int, line: int, column: int, detail: int) -> int:
    out parserErrorEntryRelated(code, line, column, detail, 0, 0, 0)
end.
