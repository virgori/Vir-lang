##
 * compiler/src/frontend/parser/stmt_dispatch.vri — Statement Parsing Dispatcher
 * ============================================================================
 ##

include types_prelude
include rt_string_rt
include lexer
include ide_facts
include parser_ast
include parser_state
include parser_diagnostics
include parser_expr
include parser_stmt_control
include parser_stmt_decl
include parser_stmt_module
include parser_stmt_dispatch_modifiers
include parser_stmt_dispatch_declarations
include parser_stmt_dispatch_concurrency
include parser_stmt_dispatch_try_stmt
include parser_stmt_dispatch_name_stmt

func parse_statement(ref p: Parser):
    p = skip_newlines(p)
    let token: int = peek(p) as int
    let originSpan = native_read_i64(token, 72)
    let originLine = native_read_i64(token, 8)
    var (nextParser, statement) = parse_statement_impl(p)
    let parserHandle = nextParser as int
    let statementHandle = statement as int
    if g_ideFactsEnabled == 1 and statementHandle != 0 do
        let fact = ideFactFind(statementHandle)
        var captured = 0
        if native_read_i64(statementHandle, 72) > 0 do captured = 1 end
        let statementKind = native_read_i64(statementHandle, 16)
        if statementKind == 2 do captured = 1 end
        if statementKind == 16 do captured = 1 end
        if statementKind == 17 do captured = 1 end
        if statementKind == 63 do captured = 1 end
        if statementKind == 64 do captured = 1 end
        if statementKind == 52 do captured = 1 end
        if statementKind == 87 do captured = 1 end
        if statementKind == 91 do captured = 1 end
        if fact != 0 do
            if native_read_i64(fact, 80) > 0 do captured = 1 end
        end
        if captured == 0 do ideFactOrigin(statementHandle, originSpan, originLine) end
    end
    out (parserHandle as Parser, statementHandle as AstNode)
end.

func parse_statement_impl(ref p: Parser):

    p = skip_newlines(p)
    t = peek(p)

    let statementSpan = native_read_i64(t as int, 72)
    let statementLine = native_read_i64(t as int, 8)

    if t.tok_type == TokType.Extern do
        out parseExternStatement(p, t)
    end

    if t.tok_type == TokType.TypeKw do
        out parseTypeAliasStatement(p, t)
    end

    if t.tok_type == TokType.Async do
        out parseAsyncStatement(p, t)
    end

    if t.tok_type == TokType.AtomicKw do
        out parseAtomicStatement(p, t)
    end

    # `mut var ...` binder
    if t.tok_type == TokType.MutKw do
        var (p2, _) = advance(p)
        if check(p2, TokType.Var) do
            var (p3, _) = advance(p2)
            out parse_var_decl(p3, false, t.col, t.line)
        end
        out parse_var_decl(p2, false, t.col, t.line)
    end

    if t.tok_type == TokType.PrecompKw do
        out parsePrecompStatement(p, t)
    end

    if t.tok_type == TokType.PortKw do
        out parsePortDeclaration(p, t)
    end

    if t.tok_type == TokType.SendKw do
        out parseSendStatement(p, t)
    end

    if t.tok_type == TokType.CancelKw do
        out parseCancelStatement(p, t)
    end

    if t.tok_type == TokType.QuietKw do
        out parseQuietStatement(p, t)
    end

    if t.tok_type == TokType.LazyKw do
        out parseLazyStatement(p, t)
    end

    if t.tok_type == TokType.Func do
        var (p2, _) = advance(p)
        var (p3, fn) = parse_func_def(p2)
        out (p3, fn)
    end

    if t.tok_type == TokType.Method do
        var (p2, _) = advance(p)
        var (p3, fn) = parse_func_def(p2)
        fn.name2 = fat_str_new("method")
        out (p3, fn)
    end

    if t.tok_type == TokType.Class do
        var (p2, _) = advance(p)
        var (p3, ed) = parse_entity_def(p2)
        ed.node_type = AstType.ClassDef
        out (p3, ed)
    end

    if t.tok_type == TokType.Share do
        out parseShareStatement(p, t)
    end

    if t.tok_type == TokType.Has do
        out parseHasStatement(p, t)
    end

    if t.tok_type == TokType.DictKw or t.tok_type == TokType.TensorKw or t.tok_type == TokType.FluxKw do
        out parseCollectionDeclaration(p, t)
    end

    if t.tok_type == TokType.ReactiveKw or t.tok_type == TokType.MorphKw do
        out parseReactiveMorphDeclaration(p, t)
    end

    if t.tok_type == TokType.BundleKw do
        out parseBundleDeclaration(p, t)
    end

    if t.tok_type == TokType.ExposeKw do
        out parseExposeStatement(p, t)
    end

    if t.tok_type == TokType.Var do
        var (p2, _) = advance(p)
        out parse_var_decl(p2, false, t.col, t.line)
    end

    if t.tok_type == TokType.Const do
        var (p2, _) = advance(p)
        out parse_const_decl(p2, t.col, t.line)
    end

    if t.tok_type == TokType.Let do
        var (p2, _) = advance(p)
        out parse_const_decl(p2, t.col, t.line)
    end

    if t.tok_type == TokType.If do
        var (p2, _) = advance(p)
        out parse_if_stmt(p2)
    end

    if t.tok_type == TokType.Loop do
        var (p2, _) = advance(p)
        out parse_loop_stmt(p2)
    end

    if t.tok_type == TokType.When do
        var (p2, _) = advance(p)
        out parse_when_loop_stmt(p2, 1)
    end

    if t.tok_type == TokType.While do
        var (p2, _) = advance(p)
        out parse_when_loop_stmt(p2, 0)
    end

    if t.tok_type == TokType.For do
        var (p2, _) = advance(p)
        out parse_for_range_stmt(p2)
    end

    if t.tok_type == TokType.Case do
        var (p2, _) = advance(p)
        out parse_case_stmt(p2)
    end

    if t.tok_type == TokType.Enum do
        var (p2, _) = advance(p)
        out parse_enum_def(p2)
    end

    if t.tok_type == TokType.ThrowKw do
        var (p2, _) = advance(p)
        var (p3, expr) = parse_expr(p2)
        n = ast_new(AstType.ThrowStmt)
        n.line = t.line
        n = ast_add_child(n, expr)
        out (p3, n)
    end

    if t.tok_type == TokType.SelectKw do
        out parseSelectStatement(p, t)
    end

    if t.tok_type == TokType.RecvKw and peek_n(p, 1).tok_type != TokType.Assign do
        out parseRecvStatement(p, t)
    end

    if t.tok_type == TokType.TrainKw do
        out parseTrainStatement(p, t)
    end

    if t.tok_type == TokType.InferKw do
        out parseInferStatement(p, t)
    end

    if t.tok_type == TokType.AwaitKw do
        out parseAwaitStatement(p, t)
    end

    if t.tok_type == TokType.ArenaKw and isArenaBlockHeader(p, t) do
        out parseArenaBlockStatement(p, t)
    end

    if t.tok_type == TokType.EmitKw do
        var (p2, _) = advance(p)
        var (p3, expr) = parse_expr(p2)
        n = ast_new(AstType.EmitStmt)
        n.line = t.line
        n = ast_add_child(n, expr)
        out (p3, n)
    end

    if t.tok_type == TokType.ErxKw do
        var (p2, _) = advance(p)
        n = ast_new(AstType.ErxExpr)
        n.line = t.line
        out (p2, n)
    end

    if t.tok_type == TokType.Task do
        var (p2, _) = advance(p)
        var (p3, expr) = parse_expr(p2)
        n = ast_new(AstType.TaskExpr)
        n.line = t.line
        n = ast_add_child(n, expr)
        out (p3, n)
    end

    if t.tok_type == TokType.Wait do
        var (p2, _) = advance(p)
        var (p3, expr) = parse_expr(p2)
        n = ast_new(AstType.WaitExpr)
        n.line = t.line
        n = ast_add_child(n, expr)
        out (p3, n)
    end

    if t.tok_type == TokType.ResumeKw do
        out parseResumeStatement(p, t)
    end

    if t.tok_type == TokType.Try do
        out parseTryStatement(p, t)
    end

    if t.tok_type == TokType.IsolateKw do
        out parseIsolateStatement(p, t)
    end

    # timeout as bare stmt is invalid alone — allow `timeout expr` marker for completeness
    if t.tok_type == TokType.TimeoutKw do
        var (p2, _) = advance(p)
        var (p3, tex) = parse_expr(p2)
        n = ast_new(AstType.TimeoutClause)
        n.line = t.line
        n = ast_add_child(n, tex)
        out (p3, n)
    end

    if t.tok_type == TokType.QuantizeKw do
        var (p2, _) = advance(p)
        var (p3, expr) = parse_expr(p2)
        n = ast_new(AstType.QuantizeExpr)
        n.line = t.line
        n = ast_add_child(n, expr)
        out (p3, n)
    end

    if t.tok_type == TokType.Lock do
        out parseLockStatement(p, t)
    end

    if t.tok_type == TokType.DeckKw do
        out parseDeckStatement(p, t)
    end

    if t.tok_type == TokType.MoldKw do
        var (p2, _) = advance(p)
        out parse_mold_def(p2)
    end

    if t.tok_type == TokType.Entity do
        var (p2, _) = advance(p)
        out parse_entity_def(p2)
    end

    if t.tok_type == TokType.InterfaceKw do
        var (p2, _) = advance(p)
        out parse_interface_def(p2)
    end

    if t.tok_type == TokType.PackedKw do
        out parsePackedStatement(p, t)
    end

    if t.tok_type == TokType.RegisterKw do
        out parseRegisterStatement(p, t)
    end

    if t.tok_type == TokType.AtSign do
        out parseAttributeStatement(p, t)
    end

    if t.tok_type == TokType.Out do
        var (p2, _) = advance(p)
        out parse_return_stmt(p2)
    end

    if t.tok_type == TokType.Print do
        var (p2, _) = advance(p)
        out parse_print_stmt(p2, statementSpan, statementLine)
    end

    if t.tok_type == TokType.Break do
        var (p2, _) = advance(p)
        n = ast_new(AstType.BreakStmt)
        n.line = t.line
        out (p2, n)
    end

    if t.tok_type == TokType.Skip do
        var (p2, _) = advance(p)
        n = ast_new(AstType.ContinueStmt)
        n.line = t.line
        out (p2, n)
    end


    if t.tok_type == TokType.Import or t.tok_type == TokType.Get or t.tok_type == TokType.From or t.tok_type == TokType.Module or t.tok_type == TokType.Export or t.tok_type == TokType.Include or t.tok_type == TokType.CheckCpu or t.tok_type == TokType.Patch do
        out parse_module_or_directive_stmt(p, t)
    end

    # Be liberal with a standalone block-closing dot.  It is purely a
    # separator and can remain after recovery from an optional `end.`.
    if t.tok_type == TokType.Dot do
        var (p2, _) = advance(p)
        out (p2, ast_new(AstType.LiteralInt))
    end

    if is_name_token(t.tok_type) do
        out parseNameStatement(p, t, statementSpan, statementLine)
    end

    # EOF / END / ELSE / EIF — no statement
    is_terminator = t.tok_type == TokType.Eof or t.tok_type == TokType.End or t.tok_type == TokType.Else or t.tok_type == TokType.Eif or t.tok_type == TokType.EnsureKw or t.tok_type == TokType.RevertKw
    if is_terminator do
        out (p, ast_new(AstType.LiteralInt))
    end

    # Default: try as expression statement
    out parse_expr(p)
end.
