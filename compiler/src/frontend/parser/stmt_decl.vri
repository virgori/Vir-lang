##
 * compiler/src/frontend/parser/stmt_decl.vri — Declarations & Definitions
 * =======================================================================
 ##

include types
include string_rt
include lexer
include ide_facts
include parser_ast
include parser_state
include parser_diagnostics
include parser_expr
include parser_stmt_control

func parse_generic_param_list(ref p: Parser):
    if check(p, TokType.Lt) do
        let lt_tok = peek(p)
        p = parse_error_loc(p, "legacy generic syntax '<...>' is not supported; use 'of (...)'", lt_tok.line, lt_tok.col)
        out (p, fat_str_new(""))
    end
    if is_tok_of(peek(p)) and p.pos + 1 < p.token_count and vec_get_rt(p.tokens, p.pos + 1).tok_type == TokType.LParen do
        var (p_of, _) = advance(p)   # consume 'of'
        var (p_lp, _) = advance(p_of) # consume '('
        p = p_lp
        var depth = 1
        var res = fat_str_new("")
        var first = true
        when not check(p, TokType.Eof) loop
            if check(p, TokType.LParen) do
                depth = depth + 1
            eif check(p, TokType.RParen) do
                depth = depth - 1
            end
            if depth == 1 and not check(p, TokType.LParen) and not check(p, TokType.RParen) and not check(p, TokType.Comma) and not check(p, TokType.Newline) do
                let tk = peek(p)
                if is_name_token(tk.tok_type) do
                    if not first do
                        res = fat_str_concat(res, fat_str_new(","))
                    end
                    res = fat_str_concat(res, tok_lex(tk))
                    first = false
                end
            end
            var (p2, _) = advance(p)
            p = p2
            if depth <= 0 do
                break
            end
        end
        out (p, res)
    end
    out (p, fat_str_new(""))
end.

# Skip a complete type expression without consuming the surrounding list or
# declaration delimiter.  This covers references, arrays, nested generics and
# function types such as `&Map<K,V>` and `func(K, K) -> bool`.
func skip_type_expr(ref p: Parser):
    paren_depth = 0
    bracket_depth = 0
    keep_going = true
    when keep_going and not check(p, TokType.Eof) loop
        t = peek(p).tok_type
        at_top = paren_depth == 0 and bracket_depth == 0
        # Never swallow a block `end` while recovering a type expression.
        if t == TokType.End do
            keep_going = false
        eif at_top and (t == TokType.Comma or t == TokType.Semicolon or t == TokType.Newline or t == TokType.RParen or t == TokType.Colon or t == TokType.Assign) do
            keep_going = false
        else
            if t == TokType.Lt do
                let lt_tok = peek(p)
                p = parse_error_loc(p, "legacy generic syntax '<...>' is not supported; use 'of (...)'", lt_tok.line, lt_tok.col)
                keep_going = false
            eif t == TokType.LParen do
                paren_depth = paren_depth + 1
            eif t == TokType.RParen and paren_depth > 0 do
                paren_depth = paren_depth - 1
            eif t == TokType.LBracket do
                bracket_depth = bracket_depth + 1
            eif t == TokType.RBracket and bracket_depth > 0 do
                bracket_depth = bracket_depth - 1
            end
            if keep_going do
                var (p2, _) = advance(p)
                p = p2
            end
        end
    end
    out p
end.

func parse_type_expr_string(ref p: Parser):
    paren_depth = 0
    bracket_depth = 0
    keep_going = true
    res = fat_str_new("")
    var last_was_tensor = false
    when keep_going and not check(p, TokType.Eof) loop
        t = peek(p).tok_type
        at_top = paren_depth == 0 and bracket_depth == 0
        # Never swallow a block `end` while recovering a type expression.
        if t == TokType.End do
            keep_going = false
        eif at_top and (t == TokType.Comma or t == TokType.Semicolon or t == TokType.Newline or t == TokType.RParen or t == TokType.Colon or t == TokType.Assign) do
            keep_going = false
        else
            if at_top and last_was_tensor and is_tok_of(peek(p)) do
                let of_tok = peek(p)
                p = parse_error_loc(p, "tensor is not a generic; use 'tensor[T; S...]', not 'tensor of (...)'", of_tok.line, of_tok.col)
                keep_going = false
            eif at_top and last_was_tensor and t == TokType.LParen do
                let lp_tok = peek(p)
                p = parse_error_loc(p, "tensor does not use '(...)' syntax; use 'tensor[T; S...]'", lp_tok.line, lp_tok.col)
                keep_going = false
            eif at_top and last_was_tensor and t == TokType.Lt do
                let lt_tok = peek(p)
                p = parse_error_loc(p, "legacy generic syntax '<...>' is not supported; use 'tensor[T; S...]'", lt_tok.line, lt_tok.col)
                keep_going = false
            eif t == TokType.Lt do
                let lt_tok = peek(p)
                p = parse_error_loc(p, "legacy generic syntax '<...>' is not supported; use 'of (...)'", lt_tok.line, lt_tok.col)
                keep_going = false
            eif t == TokType.LParen do
                paren_depth = paren_depth + 1
            eif t == TokType.RParen and paren_depth > 0 do
                paren_depth = paren_depth - 1
            eif t == TokType.LBracket do
                bracket_depth = bracket_depth + 1
            eif t == TokType.RBracket and bracket_depth > 0 do
                bracket_depth = bracket_depth - 1
            end
            if keep_going do
                let cur_tok = peek(p)
                let cur_t = cur_tok.tok_type
                let typeToken: int = cur_tok as int
                if g_ideFactsEnabled == 1 do
                    if is_name_token(native_read_i64(typeToken, 0) as TokType) do
                        let typeTokenSpan = native_read_i64(typeToken, 72)
                        let typeTokenLine = native_read_i64(typeToken, 8)
                        let typeTokenName: int = tok_lex(typeToken as Token) as int
                        let typeUse: int = ast_new(AstType.Identifier) as int
                        native_write_i64(typeUse, 0, typeTokenName)
                        native_write_i64(typeUse, 32, typeTokenLine)
                        native_write_i64(typeUse, 72, typeTokenSpan)
                        ideFactOrigin(typeUse, typeTokenSpan, typeTokenLine)
                        ideFactTypeUse(typeUse)
                    end
                end
                if cur_t == TokType.Arrow do
                    res = fat_str_concat(res, fat_str_new(" -> "))
                eif is_tok_of(cur_tok) do
                    if fat_str_len(res) > 0 and fat_str_byte_at(res, fat_str_len(res) - 1) != 32 do
                        res = fat_str_concat(res, fat_str_new(" "))
                    end
                    res = fat_str_concat(res, fat_str_new("of "))
                eif cur_t == TokType.Comma do
                    res = fat_str_concat(res, fat_str_new(", "))
                eif cur_t == TokType.Semicolon do
                    res = fat_str_concat(res, fat_str_new("; "))
                eif cur_t == TokType.Colon do
                    res = fat_str_concat(res, fat_str_new(": "))
                else
                    lex = tok_lex(cur_tok)
                    if fat_str_len(res) > 0 and fat_str_len(lex) > 0 do
                        let prev_ch = fat_str_byte_at(res, fat_str_len(res) - 1)
                        let next_ch = fat_str_byte_at(lex, 0)
                        let prev_is_word = (prev_ch >= 97 and prev_ch <= 122) or (prev_ch >= 65 and prev_ch <= 90) or (prev_ch >= 48 and prev_ch <= 57) or prev_ch == 95
                        let next_is_word = (next_ch >= 97 and next_ch <= 122) or (next_ch >= 65 and next_ch <= 90) or (next_ch >= 48 and next_ch <= 57) or next_ch == 95
                        if prev_is_word and next_is_word do
                            res = fat_str_concat(res, fat_str_new(" "))
                        end
                    end
                    res = fat_str_concat(res, lex)
                end
                if at_top and (cur_t == TokType.TensorKw or (is_name_token(cur_t) and fat_cstr_eq(tok_lex(cur_tok), "tensor") == 1)) do
                    last_was_tensor = true
                else
                    last_was_tensor = false
                end
                var (p2, _) = advance(p)
                p = p2
            end
        end
    end
    out (p, res)
end.

# Skip optional `out(TYPE)` / `out TYPE` return annotation (§6).
# Without this, `out(Vec):` is parsed as a body return statement.
func skip_out_return_type(ref p: Parser):
    if not check(p, TokType.Out) do
        out p
    end
    var (p2, _) = advance(p)
    if check(p2, TokType.LParen) do
        depth = 1
        var (p3, _) = advance(p2)
        p2 = p3
        when depth > 0 and not check(p2, TokType.Eof) loop
            if check(p2, TokType.LParen) do
                depth = depth + 1
            eif check(p2, TokType.RParen) do
                depth = depth - 1
            end
            var (p4, _) = advance(p2)
            p2 = p4
        end
        out p2
    end
    if is_name_token(peek(p2).tok_type) do
        var (p3, _) = advance(p2)
        p2 = p3
        p2 = skip_generic_list(p2)
    end
    out p2
end.

func is_param_group_out(ref p: Parser):
    let saved_pos = p.pos
    var (p_adv, _) = advance(p)
    p_adv = skip_newlines(p_adv)
    let tok1 = peek(p_adv)
    var is_out_grp = false
    if is_name_token(tok1.tok_type) do
        var (p_adv2, _) = advance(p_adv)
        p_adv2 = skip_newlines(p_adv2)
        let tok2 = peek(p_adv2)
        if tok2.tok_type == TokType.Colon do
            is_out_grp = true
        end
    eif tok1.tok_type == TokType.LParen do
        var (p_lp, _) = advance(p_adv)
        p_lp = skip_newlines(p_lp)
        let tok_in_p = peek(p_lp)
        if is_name_token(tok_in_p.tok_type) do
            var (p_lp2, _) = advance(p_lp)
            p_lp2 = skip_newlines(p_lp2)
            let tok_col = peek(p_lp2)
            if tok_col.tok_type == TokType.Colon do
                is_out_grp = true
            end
        end
    end
    p.pos = saved_pos
    out is_out_grp
end.

func is_orphan_param(ref p: Parser):
    let saved_pos = p.pos
    let tok1 = peek(p)
    var is_orph = false
    if is_name_token(tok1.tok_type) do
        var (p2, _) = advance(p)
        p2 = skip_newlines(p2)
        if check(p2, TokType.Colon) do
            var (p3, _) = advance(p2)
            p3 = skip_newlines(p3)
            let tok_t = peek(p3)
            if is_name_token(tok_t.tok_type) do
                var (p4, _) = advance(p3)
                let tok_sep = peek(p4)
                if tok_sep.tok_type == TokType.Newline or tok_sep.tok_type == TokType.Semicolon or tok_sep.tok_type == TokType.Comma or tok_sep.tok_type == TokType.End or tok_sep.tok_type == TokType.Eof do
                    is_orph = true
                end
            end
        end
    end
    p.pos = saved_pos
    out is_orph
end.

func parse_func_def_mode(ref p: Parser, signature_only: bool):

    var (p2, name_tok, ok) = expect_name_tok(p, "expected function name")
    if not ok do
        out (p2, ast_new(AstType.FuncDef))
    end

    let functionNameSpan = name_tok.span_id
    fn_node = ast_new(AstType.FuncDef)
    native_write_i64(fn_node as i64, 72, functionNameSpan)
    fn_name = name_tok.str_val
    fn_node.name = fn_name
    fn_node.line = name_tok.line

    # Generic declaration: `func name<T, U>(...)`.
    var (p_gen, gen_params) = parse_generic_param_list(p2)
    p2 = p_gen
    if fat_str_len(gen_params) > 0 do
        fn_node.builtin_id = gen_params as int
    end

    # Parse parameters (optional parens — `func name` and `func name(...)` both valid)
    var had_parens = false
    if check(p2, TokType.LParen) do
        had_parens = true
        var (p3, _) = advance(p2)
        p3 = skip_newlines(p3)

        # Parse parameters
        if not check(p3, TokType.RParen) do
            # Check if user wrongly placed 'in' or 'out' inside () (§14.1)
            if check(p3, TokType.In) do
                p3 = parse_error_code_at(p3, 3044, "từ khoá 'in' không hợp lệ trong cú pháp ngoặc () — tham số mặc định theo giá trị (§14.1)", peek(p3).line)
            eif check(p3, TokType.Out) do
                p3 = parse_error_code_at(p3, 3045, "tham số 'out' không được khai báo trong cú pháp ngoặc () — sử dụng khối nhóm (§14.1)", peek(p3).line)
            end

            # Check for 'this' as first parameter (method syntax)
            if check(p3, TokType.ThisKw) do
                var (p_this, this_ptok) = advance(p3)
                p3 = p_this
                param = ast_new(AstType.Identifier)
                param.name = fat_str_new("this")
                fn_node = ast_add_child(fn_node, param)
                fn_node.int_val = 1
                # Preserve the receiver annotation for strict UFCS type checks.
                if check(p3, TokType.Colon) do
                    var (p_type_start, _) = advance(p3)
                    var (p_type_end, this_type) = parse_type_expr_string(p_type_start)
                    param.name2 = this_type
                    p3 = p_type_end
                end
            else
                # Check for 'ref' modifier
                is_ref = false
                if check(p3, TokType.RefKw) do
                    var (p_ref, _) = advance(p3)
                    p3 = p_ref
                    is_ref = true
                end
                let parameterNameToken = peek(p3)
                let parameterLine = parameterNameToken.line
                let parameterSpan = parameterNameToken.span_id
                param_name = fat_str_new("")
                ok2 = false
                if check(p3, TokType.Ident) do
                    var (p4, pt) = advance(p3)
                    p3 = p4
                    param_name = pt.str_val
                    ok2 = true
                eif check(p3, TokType.PtrKw) do
                    var (p4, _) = advance(p3)
                    p3 = p4
                    param_name = fat_str_new("ptr")
                    ok2 = true
                else
                    var (p4, param_tok, ok_e) = expect_name_tok(p3, "expected parameter name")
                    p3 = p4
                    param_name = param_tok.str_val
                    ok2 = ok_e
                end
                if ok2 do
                    if is_ref do
                        param = ast_new(AstType.RefParam)
                        param.int_val = 1 # ParamMode.Ref
                    else
                        param = ast_new(AstType.ParamDef)
                        param.int_val = 0 # ParamMode.In
                    end
                    param.name = param_name
                    native_write_i64(param as i64, 32, parameterLine)
                    native_write_i64(param as i64, 72, parameterSpan)
                    # Keep annotation parsing in the same lexical scope as the
                    # parameter handle.  Using `param` after this block yielded
                    # an empty handle in the native self-hosted compiler.
                    if check(p3, TokType.Colon) do
                        var (p_skip, _) = advance(p3)
                        var (p_type_end, type_str) = parse_type_expr_string(p_skip)
                        param.name2 = type_str
                        p3 = p_type_end
                    end
                    native_write_i64(param as i64, 32, parameterLine)
                    native_write_i64(param as i64, 72, parameterSpan)
                    ideFactOrigin(param as int, parameterSpan, parameterLine)
                    fn_node = ast_add_child(fn_node, param)
                else
                    if check(p3, TokType.Colon) do
                        var (p_skip_bad, _) = advance(p3)
                        p3 = skip_type_expr(p_skip_bad)
                    end
                end
            end
            # §1.0: param separator is "," | ";" | NEWLINE
            should_loop = true
            when should_loop loop
                var (p5, has_sep) = match_list_sep(p3, true)
                p3 = p5
                if not has_sep or check(p3, TokType.RParen) do
                    should_loop = false
                else
                    if check(p3, TokType.In) do
                        p3 = parse_error_code_at(p3, 3044, "từ khoá 'in' không hợp lệ trong cú pháp ngoặc () — tham số mặc định theo giá trị (§14.1)", peek(p3).line)
                    eif check(p3, TokType.Out) do
                        p3 = parse_error_code_at(p3, 3045, "tham số 'out' không được khai báo trong cú pháp ngoặc () — sử dụng khối nhóm (§14.1)", peek(p3).line)
                    end
                    # Check for 'ref' modifier on subsequent params
                    is_ref2 = false
                    if check(p3, TokType.RefKw) do
                        var (p_ref2, _) = advance(p3)
                        p3 = p_ref2
                        is_ref2 = true
                    end
                    let parameter2NameToken = peek(p3)
                    let parameter2Line = parameter2NameToken.line
                    let parameter2Span = parameter2NameToken.span_id
                    param2_name = fat_str_new("")
                    ok3 = false
                    if check(p3, TokType.Ident) do
                        var (p6, pt2) = advance(p3)
                        p3 = p6
                        param2_name = pt2.str_val
                        ok3 = true
                    eif check(p3, TokType.PtrKw) do
                        var (p6, _) = advance(p3)
                        p3 = p6
                        param2_name = fat_str_new("ptr")
                        ok3 = true
                    else
                        var (p6, pt, ok_e3) = expect_name_tok(p3, "expected parameter name")
                        p3 = p6
                        param2_name = pt.str_val
                        ok3 = ok_e3
                    end
                    if ok3 do
                        # Check duplicate parameter in fn_node
                        var dup = false
                        var dpi = 0
                        let dp_count = vec_len_rt(fn_node.children)
                        when dpi < dp_count loop
                            let existing = vec_get_rt(fn_node.children, dpi) as AstNode
                            if fat_str_eq(existing.name, param2_name) == 1 do
                                dup = true
                                dpi = dp_count
                            end
                            dpi = dpi + 1
                        end
                        if dup do
                            p3 = parse_error_code_at(p3, 3054, "tham số bị khai báo trùng lặp trong cùng một hàm", peek(p3).line)
                        end
                        if is_ref2 do
                            param2 = ast_new(AstType.RefParam)
                            param2.int_val = 1 # ParamMode.Ref
                        else
                            param2 = ast_new(AstType.ParamDef)
                            param2.int_val = 0 # ParamMode.In
                        end
                        param2.name = param2_name
                        native_write_i64(param2 as i64, 32, parameter2Line)
                        native_write_i64(param2 as i64, 72, parameter2Span)
                        if check(p3, TokType.Colon) do
                            var (p_skip3, _) = advance(p3)
                            var (p_type_end3, type_str3) = parse_type_expr_string(p_skip3)
                            param2.name2 = type_str3
                            p3 = p_type_end3
                        end
                        native_write_i64(param2 as i64, 32, parameter2Line)
                        native_write_i64(param2 as i64, 72, parameter2Span)
                        ideFactOrigin(param2 as int, parameter2Span, parameter2Line)
                        fn_node = ast_add_child(fn_node, param2)
                    else
                        if check(p3, TokType.Colon) do
                            var (p_skip_bad3, _) = advance(p3)
                            p3 = skip_type_expr(p_skip_bad3)
                        end
                    end
                end
            end
        end

        var (p4, _, _) = expect_tok(p3, TokType.RParen, "expected ')' after parameters")
        p2 = p4
    end

    # Skip optional return type `-> type` or `out(TYPE)` / `out TYPE`
    if check(p2, TokType.Arrow) do
        var (p_arr, _) = advance(p2)
        var (p_ret_end, ret_str) = parse_type_expr_string(p_arr)
        fn_node.name2 = ret_str
        p2 = p_ret_end
    end
    p2 = skip_out_return_type(p2)

    # Skip optional trailing colon `:`
    var (p_colon, _) = match_tok(p2, TokType.Colon)
    p2 = p_colon

    p2 = skip_newlines(p2)

    # Interface members are declarations, not nested function blocks. Their
    # trailing `:` and newline finish the signature; the interface owns the
    # only `end` token.
    if signature_only do
        empty_body = ast_new(AstType.Block)
        fn_node = ast_add_child(fn_node, empty_body)
        fn_node.name = fn_name
        out (p2, fn_node)
    end

    # Form 2: Khối nhóm tham số `in` / `ref` / `out` (§14.2)
    # Chỉ áp dụng khi chữ ký là `func tên:` không có danh sách ngoặc `()`.
    if had_parens do
        if check(p2, TokType.In) or check(p2, TokType.RefKw) or (check(p2, TokType.Out) and is_param_group_out(p2)) do
            p2 = parse_error_at(p2, "hàm đã có danh sách tham số trong () không được khai báo thêm khối tham số (§14)", peek(p2).line)
        end
    else
        var in_param_groups = true
        when in_param_groups loop
            p2 = skip_newlines(p2)
            var cur_group = 0 # 0=None, 1=In, 2=Ref, 3=Out
            var group_name = fat_str_new("")
            if check(p2, TokType.In) do
                cur_group = 1
                group_name = fat_str_new("in")
            eif check(p2, TokType.RefKw) do
                cur_group = 2
                group_name = fat_str_new("ref")
            eif check(p2, TokType.Out) do
                if is_param_group_out(p2) do
                    cur_group = 3
                    group_name = fat_str_new("out")
                end
            end

            if cur_group == 0 do
                # Kiểm tra tham số mồ côi (orphan parameter) (§14.2)
                if is_orphan_param(p2) do
                    p2 = parse_error_code_at(p2, 3047, "tham số không có nhóm (§14.2)", peek(p2).line)
                end
                in_param_groups = false
            else
                var (p_grp_next, grp_tok) = advance(p2)
                p2 = p_grp_next
                has_grp_paren = false
                if check(p2, TokType.LParen) do
                    p2 = parse_error_code_at(p2, 3044, "cú pháp nhóm tham số với dấu ngoặc () không được hỗ trợ trong Spec v2.0 (§14.2)", peek(p2).line)
                    var (p_glp, _) = advance(p2)
                    p2 = p_glp
                    has_grp_paren = true
                end
                p2 = skip_newlines(p2)
                when check(p2, TokType.Semicolon) or check(p2, TokType.Comma) loop
                    if check(p2, TokType.Comma) do
                        p2 = parse_error_code_at(p2, 3055, "dấu phẩy không phải separator hợp lệ trong nhóm tham số; dùng ';' hoặc xuống dòng (§14.2)", peek(p2).line)
                    end
                    var (p_gsep, _) = advance(p2)
                    p2 = p_gsep
                end
                p2 = skip_newlines(p2)

                var group_param_count = 0
                var more_in_group = true
                when more_in_group loop
                    p2 = skip_newlines(p2)
                    is_end_of_group = false
                    if check(p2, TokType.End) or check(p2, TokType.Eof) or check(p2, TokType.RParen) do
                        is_end_of_group = true
                    eif check(p2, TokType.In) or check(p2, TokType.RefKw) do
                        is_end_of_group = true
                    eif check(p2, TokType.Out) do
                        if is_param_group_out(p2) do
                            is_end_of_group = true
                        end
                    end

                    if is_end_of_group do
                        more_in_group = false
                    else
                        tok_cur = peek(p2)
                        if not is_name_token(tok_cur.tok_type) do
                            more_in_group = false
                        else
                            let saved_p2 = p2.pos
                            var (p_c2_s, _) = advance(p2)
                            tok_c2_s = peek(p_c2_s)
                            p2.pos = saved_p2
                            if tok_c2_s.tok_type == TokType.Assign or tok_c2_s.tok_type == TokType.Dot or tok_c2_s.tok_type == TokType.LParen do
                                more_in_group = false
                            else
                                let groupParserPtr = p2 as int
                                let groupTokens = native_read_i64(groupParserPtr, 0)
                                let groupPosition = native_read_i64(groupParserPtr, 8)
                                let groupNameToken = native_read_i64(groupTokens, groupPosition * 8)
                                let groupParameterLine = native_read_i64(groupNameToken, 8)
                                let groupParameterSpan = native_read_i64(groupNameToken, 72)
                                var (p_pn, p_name_tok, ok_pn) = expect_name_tok(p2, "expected parameter name")
                                p2 = p_pn
                                if not ok_pn do
                                    more_in_group = false
                                else
                                    p_name = p_name_tok.str_val
                                    param_node = ast_new(AstType.ParamDef)
                                    if cur_group == 1 do
                                        param_node.node_type = AstType.ParamDef
                                        param_node.int_val = 0 # ParamMode.In
                                    eif cur_group == 2 do
                                        param_node.node_type = AstType.RefParam
                                        param_node.int_val = 1 # ParamMode.Ref
                                    eif cur_group == 3 do
                                        param_node.node_type = AstType.OutParam
                                        param_node.int_val = 2 # ParamMode.Out
                                    end
                                    param_node.name = p_name
                                    native_write_i64(param_node as i64, 32, groupParameterLine)
                                    native_write_i64(param_node as i64, 72, groupParameterSpan)

                                    if check(p2, TokType.Colon) do
                                        var (p_col, _) = advance(p2)
                                        var (p_tend, type_str) = parse_type_expr_string(p_col)
                                        param_node.name2 = type_str
                                        p2 = p_tend
                                    end

                                    # Kiểm tra trùng tên tham số trong hàm
                                    var dup_f2 = false
                                    var dpi_f2 = 0
                                    let dp_f2_count = vec_len_rt(fn_node.children)
                                    when dpi_f2 < dp_f2_count loop
                                        let existing_f2 = vec_get_rt(fn_node.children, dpi_f2) as AstNode
                                        if fat_str_eq(existing_f2.name, p_name) == 1 do
                                            dup_f2 = true
                                            dpi_f2 = dp_f2_count
                                        end
                                        dpi_f2 = dpi_f2 + 1
                                    end
                                    if dup_f2 do
                                        p2 = parse_error_code_at(p2, 3054, "tham số bị khai báo trùng lặp trong cùng một hàm (§14)", p_name_tok.line)
                                    end

                                    native_write_i64(param_node as i64, 32, groupParameterLine)
                                    native_write_i64(param_node as i64, 72, groupParameterSpan)
                                    ideFactOrigin(param_node as int, groupParameterSpan, groupParameterLine)
                                    fn_node = ast_add_child(fn_node, param_node)
                                    group_param_count = group_param_count + 1

                                    let before_sep2 = p2.pos
                                    p2 = skip_newlines(p2)
                                    let got_nl2 = p2.pos != before_sep2
                                    if has_grp_paren and check(p2, TokType.RParen) do
                                        more_in_group = false
                                    else
                                        var m_cm2 = false
                                        if check(p2, TokType.Comma) do
                                            m_cm2 = true
                                            p2 = parse_error_code_at(p2, 3055, "dấu phẩy không phải separator hợp lệ trong nhóm tham số; dùng ';' hoặc xuống dòng (§14.2)", peek(p2).line)
                                            var (p_cm2, _) = advance(p2)
                                            p2 = p_cm2
                                        end
                                        var (p_sc2, m_sc2) = match_tok(p2, TokType.Semicolon)
                                        p2 = p_sc2
                                        has_sep2 = m_cm2 or m_sc2
                                        if has_sep2 do
                                            p2 = skip_newlines(p2)
                                            if has_grp_paren and check(p2, TokType.RParen) do
                                                more_in_group = false
                                            end
                                        eif not got_nl2 do
                                            more_in_group = false
                                        else
                                            nt_next = peek(p2).tok_type
                                            if is_name_token(nt_next) do
                                                nt_n2 = peek_n(p2, 1).tok_type
                                                if nt_n2 != TokType.Colon and nt_n2 != TokType.Newline and nt_n2 != TokType.Semicolon and nt_n2 != TokType.Comma do
                                                    more_in_group = false
                                                end
                                            else
                                                more_in_group = false
                                            end
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
                if has_grp_paren do
                    var (p_grp_rp, _, _) = expect_tok(p2, TokType.RParen, "expected ')' after group parameters")
                    p2 = p_grp_rp
                end

                if group_param_count == 0 do
                    let next_t = peek(p2)
                    p2 = parse_error_code_loc_related(p2, 3046, "nhóm tham số rỗng (§14.2)", grp_tok.line, grp_tok.col, next_t.line, next_t.col, "nhóm tiếp theo")
                end
            end
        end
    end

    var (p5, body) = parse_block(p2)
    fn_node = ast_add_child(fn_node, body)

    # Parse optional ensure / revert blocks in either source order.  They are
    # clauses (not independent block openers), so `:` is always an error.
    var seen_ensure = false
    var seen_revert = false
    has_cleanup = true
    when has_cleanup loop
        if check(p5, TokType.EnsureKw) do
            if seen_ensure do
                p5 = parse_error_code_at(p5, 3057, "duplicate ensure clause in function (§13.2)", peek(p5).line)
            end
            seen_ensure = true
            var (p_ens, _) = advance(p5)
            var p_ens2 = p_ens
            if check(p_ens2, TokType.Colon) do
                p_ens2 = parse_error_code_at(p_ens2, 3056, "ensure/revert clauses must not use ':' (§13.2–13.3)", peek(p_ens2).line)
                var (p_ens_col, _) = advance(p_ens2)
                p_ens2 = p_ens_col
            end
            p_ens2 = skip_newlines(p_ens2)
            var (p_ens3, ensure_body) = parse_block(p_ens2)
            ensure_node = ast_new(AstType.EnsureBlock)
            ensure_node = ast_add_child(ensure_node, ensure_body)
            fn_node = ast_add_child(fn_node, ensure_node)
            p5 = p_ens3
        eif check(p5, TokType.RevertKw) do
            if seen_revert do
                p5 = parse_error_code_at(p5, 3058, "duplicate revert clause in function (§13.3)", peek(p5).line)
            end
            seen_revert = true
            var (p_rev, _) = advance(p5)
            var p_rev2 = p_rev
            if check(p_rev2, TokType.Colon) do
                p_rev2 = parse_error_code_at(p_rev2, 3056, "ensure/revert clauses must not use ':' (§13.2–13.3)", peek(p_rev2).line)
                var (p_rev_col, _) = advance(p_rev2)
                p_rev2 = p_rev_col
            end
            p_rev2 = skip_newlines(p_rev2)
            var (p_rev3, revert_body) = parse_block(p_rev2)
            revert_node = ast_new(AstType.RevertBlock)
            revert_node = ast_add_child(revert_node, revert_body)
            fn_node = ast_add_child(fn_node, revert_node)
            p5 = p_rev3
        else
            has_cleanup = false
        end
    end

    if not check(p5, TokType.End) do
        p5 = parse_error_at(p5, "expected 'end' to close function", fn_node.line)
    end
    var (p6, _, _) = expect_tok(p5, TokType.End, "expected 'end' to close function")
    # `end` and `end.` are both accepted by the C parser/spec-compatible
    # frontend.  Keep the dot optional on the soft self-host path as well.
    var (p6b, _) = match_tok(p6, TokType.Dot)
    # ast_add_child corrupts soft .name — restore for lowering / Call lookup.
    fn_node.name = fn_name
    out (p6b, fn_node)
end.

func parse_func_def(ref p: Parser):
    out parse_func_def_mode(p, false)
end.
func parse_for_range_stmt(ref p: Parser):

    line = peek(p).line
    var (p2, var_tok, ok) = expect_name_tok(p, "expected loop variable")
    if not ok do
        out (p2, ast_new(AstType.ForRange))
    end
    loop_name = tok_lex(var_tok)

    var (p3, _, ok2) = expect_tok(p2, TokType.In, "expected 'in' after for variable")
    if not ok2 do
        out (p3, ast_new(AstType.ForRange))
    end

    var (p4, start_expr) = parse_expr(p3)
    if check(p4, TokType.DotDot) do
        var (p5, _) = advance(p4)
        var (p6, end_expr) = parse_expr(p5)
        # Body opener: ':' or 'do' (stdlib uses both).
        var (p6b, _) = match_tok(p6, TokType.Colon)
        p6 = p6b
        var (p6c, _) = match_tok(p6, TokType.Do)
        p6 = p6c
        p6 = skip_newlines(p6)

        var (p7, body) = parse_block(p6)
        var (p8, _, _) = expect_tok(p7, TokType.End, "expected 'end' after for block")

        n = ast_new(AstType.ForRange)
        n.name = loop_name
        n.line = line
        n = ast_add_child(n, start_expr)
        n = ast_add_child(n, end_expr)
        n = ast_add_child(n, body)
        out (p8, n)
    end

    # Array loop: for x in arr do ... end
    var (p4b, _) = match_tok(p4, TokType.Colon)
    p4 = p4b
    var (p4c, _) = match_tok(p4, TokType.Do)
    p4 = p4c
    p4 = skip_newlines(p4)

    var (p7a, body_arr) = parse_block(p4)
    var (p8a, _, _) = expect_tok(p7a, TokType.End, "expected 'end' after for block")

    n = ast_new(AstType.ForRange)
    n.name = loop_name
    n.line = line
    n = ast_add_child(n, start_expr)
    n = ast_add_child(n, body_arr)
    out (p8a, n)
end.
func parse_enum_def(ref p: Parser):

    line = peek(p).line
    var (p2, name_tok, ok) = expect_name_tok(p, "expected enum name")
    if not ok do
        out (p2, ast_new(AstType.EnumDef))
    end

    let enumNameSpan = native_read_i64(name_tok as int, 72)
    let enumNameLine = native_read_i64(name_tok as int, 8)
    p2 = skip_newlines(p2)

    en = ast_new(AstType.EnumDef)
    en.name = name_tok.str_val
    en.line = enumNameLine
    ideFactOrigin(en as int, enumNameSpan, enumNameLine)

    # Generic parameters affect semantic specialization, not the canonical
    # tagged-union layout.  Keep accepting `enum Option<T>:` here instead of
    # mis-parsing `<T>` as the first variant.
    p2 = skip_generic_list(p2)
    p2 = skip_newlines(p2)

    # Consume optional ':' after enum name
    var (p2b, _) = match_tok(p2, TokType.Colon)
    p2 = p2b
    p2 = skip_newlines(p2)

    next_val = 0
    when not check(p2, TokType.End) and not check(p2, TokType.Eof) loop
        var (p3, vname, ok2) = expect_name_tok(p2, "expected enum variant")
        p2 = p3
        if not ok2 do
            out (p2, en)
        end

        let variantNameSpan = native_read_i64(vname as int, 72)
        let variantNameLine = native_read_i64(vname as int, 8)
        val = next_val
        var (p4, has_val) = match_tok(p2, TokType.Assign)
        if has_val do
            var (p5, int_tok, _) = expect_tok(p4, TokType.Int, "expected integer value")
            p2 = p5
            val = int_tok.int_val
        else
            p2 = p4
        end
        # Optional payload: preserve one child per payload slot.  Earlier code
        # skipped this list, which made constructor arity and enum layout
        # unknowable after parsing.
        payload_count = 0
        payloads = vec_new_rt()
        if check(p2, TokType.LParen) do
            var (p_lp, _) = advance(p2)
            p2 = p_lp
            p2 = skip_newlines(p2)
            when not check(p2, TokType.RParen) and not check(p2, TokType.Eof) loop
                payload = ast_new(AstType.ParamDef)
                ptok = peek(p2)
                if is_name_token(ptok.tok_type) do
                    var (p_name, taken_name) = advance(p2)
                    payload.name = tok_lex(taken_name)
                    payload.line = taken_name.line
                    p2 = p_name
                else
                    payload.name = fat_str_new("_")
                    payload.line = vname.line
                end
                # A typed slot uses `name: Type`.  `Some(T)` is also retained
                # as one opaque word slot; later generic specialization can
                # refine its type without changing the ABI offsets.
                if check(p2, TokType.Colon) do
                    var (p_colon, _) = advance(p2)
                    var (p_type, type_name) = parse_type_expr_string(p_colon)
                    payload.name2 = type_name
                    p2 = p_type
                end
                payloads = vec_push_rt(payloads, payload as i64)
                payload_count = payload_count + 1
                p2 = skip_newlines(p2)
                if check(p2, TokType.Comma) or check(p2, TokType.Semicolon) do
                    var (p_sep, _) = advance(p2)
                    p2 = skip_newlines(p_sep)
                else
                    # Malformed/legacy slot syntax: consume to the closing
                    # parenthesis so parsing always makes forward progress.
                    when not check(p2, TokType.RParen) and not check(p2, TokType.Eof) loop
                        var (p_adv, _) = advance(p2)
                        p2 = p_adv
                    end
                end
            end
            var (p_rp, _, _) = expect_tok(p2, TokType.RParen, "expected ')' after enum payload")
            p2 = p_rp
        end
        next_val = val + 1

        variant = ast_new(AstType.LiteralInt)
        variant.name = vname.str_val
        variant.int_val = val
        variant.line = variantNameLine
        ideFactOrigin(variant as int, variantNameSpan, variantNameLine)
        var pi = 0
        when pi < vec_len_rt(payloads) loop
            variant = ast_add_child(variant, vec_get_rt(payloads, pi))
            pi = pi + 1
        end
        variant.builtin_id = payload_count
        en = ast_add_child(en, variant)
        var (p6c, _) = match_tok(p2, TokType.Comma)
        var (p6, _) = match_tok(p6c, TokType.Semicolon)
        p2 = p6
        p2 = skip_newlines(p2)
    end

    var (p3, _, _) = expect_tok(p2, TokType.End, "expected 'end' after enum")
    # v1.2: definition blocks close with 'end' — consume optional dot
    var (p3b, _) = match_tok(p3, TokType.Dot)
    out (p3b, en)
end.
func parse_entity_def(ref p: Parser):

    line = peek(p).line
    var (p2, name_tok, ok) = expect_name_tok(p, "expected entity name")
    if not ok do
        out (p2, ast_new(AstType.EntityDef))
    end

    let entityNameLine = name_tok.line
    let entityNameSpan = name_tok.span_id

    # Generic declaration: `entity Name<T, U>`.
    var (p_gen, gen_params) = parse_generic_param_list(p2)
    p2 = p_gen
    p2 = skip_newlines(p2)

    # Optional base type for register / mold: `register UART_SR: u32`
    var base_type_name = fat_str_new("")
    var (p2b, has_colon) = match_tok(p2, TokType.Colon)
    if has_colon do
        if check(p2b, TokType.Ident) do
            var (p2c, type_tok) = advance(p2b)
            base_type_name = type_tok.str_val
            p2 = p2c
        else
            p2 = p2b
        end
    end
    p2 = skip_newlines(p2)

    ed = ast_new(AstType.EntityDef)
    ed.name = name_tok.str_val
    ed.name2 = base_type_name
    native_write_i64(ed as i64, 32, entityNameLine)
    native_write_i64(ed as i64, 72, entityNameSpan)
    if fat_str_len(gen_params) > 0 do
        ed.builtin_id = gen_params as int
    end

    when not check(p2, TokType.End) and not check(p2, TokType.Eof) loop
        if check(p2, TokType.Method) or check(p2, TokType.Func) do
            var (p_m, _) = advance(p2)
            var (p_mdef, mnode) = parse_func_def(p_m)
            p2 = p_mdef
            ed = ast_add_child(ed, mnode)
            p2 = skip_newlines(p2)
            skip
        end
        var (p3, fname, ok2) = expect_name_tok(p2, "expected field name")
        p2 = p3
        if not ok2 do
            p2 = parse_error(p2, "expected field name in entity body")
            p2 = sync_past_block_end(p2)
            ed.name = name_tok.str_val
            out (p2, ed)
        end

        field = ast_new(AstType.Identifier)
        field.name = fname.str_val
        field.line = fname.line
        let fieldDeclarationLine = native_read_i64(fname as int, 8)
        let fieldDeclarationSpan = native_read_i64(fname as int, 72)

        # Optional type or bitfield hint
        var (p4, has_fcolon) = match_tok(p2, TokType.Colon)
        if has_fcolon do
            if check(p4, TokType.Int) do
                var (p5, int_tok) = advance(p4)
                start_bit = int_tok.int_val
                width = 1
                if check(p5, TokType.DotDot) do
                    var (p6, _) = advance(p5)
                    var (p7, hi_tok) = advance(p6)
                    end_bit = hi_tok.int_val
                    width = end_bit - start_bit + 1
                    p2 = p7
                else
                    p2 = p5
                end
                field.int_val = start_bit
                field.builtin_id = width
            else
                if not check(p4, TokType.Comma) and not check(p4, TokType.Semicolon) and not check(p4, TokType.Newline) and not check(p4, TokType.End) and not check(p4, TokType.Eof) do
                    var (p_type_end, field_type_str) = parse_type_expr_string(p4)
                    field.name2 = field_type_str
                    p2 = p_type_end
                else
                    p2 = p4
                end
            end
        else
            p2 = p4
        end

        ideFactOrigin(field as int, fieldDeclarationSpan, fieldDeclarationLine)
        ed = ast_add_child(ed, field)
        # Hard parser accepts ',' or ';' between entity fields (lexer.vri uses commas).
        var (p6, had_semi) = match_tok(p2, TokType.Semicolon)
        if had_semi do
            p2 = p6
        else
            var (p7, _) = match_tok(p6, TokType.Comma)
            p2 = p7
        end
        p2 = skip_newlines(p2)
    end

    p2 = expect_block_end(p2, "expected 'end' after entity")
    # ast_add_child corrupts soft .name — restore for entity ctor lookup.
    ed.name = name_tok.str_val
    out (p2, ed)
end.

func parse_interface_def(ref p: Parser):
    line = peek(p).line
    var (p2, name_tok, ok) = expect_name_tok(p, "expected interface name")
    if not ok do
        out (p2, ast_new(AstType.EntityDef))
    end

    p2 = skip_generic_list(p2)
    var (p_colon, _) = match_tok(p2, TokType.Colon)
    p2 = skip_newlines(p_colon)

    iface = ast_new(AstType.EntityDef)
    iface.name = name_tok.str_val
    iface.name2 = fat_str_new("interface")
    iface.line = line

    when not check(p2, TokType.End) and not check(p2, TokType.Eof) loop
        if check(p2, TokType.Func) or check(p2, TokType.Method) do
            var (p_func, _) = advance(p2)
            var (p_after, method_node) = parse_func_def_mode(p_func, true)
            iface = ast_add_child(iface, method_node)
            p2 = skip_newlines(p_after)
        else
            # `implement Base` and future interface metadata are line-scoped.
            # Preserve parser progress without treating them as method bodies.
            when not check(p2, TokType.Newline) and not check(p2, TokType.End) and not check(p2, TokType.Eof) loop
                var (p_next, _) = advance(p2)
                p2 = p_next
            end
            p2 = skip_newlines(p2)
        end
    end

    p2 = expect_block_end(p2, "expected 'end' after interface")
    iface.name = name_tok.str_val
    out (p2, iface)
end.

func parse_mold_def(ref p: Parser):
    line = peek(p).line
    var (p2, name_tok, ok) = expect_name_tok(p, "expected mold name")
    if not ok do
        out (p2, ast_new(AstType.RegisterDef))
    end
    p2 = skip_newlines(p2)
    var base_type_name = fat_str_new("")
    var (p2b, has_colon) = match_tok(p2, TokType.Colon)
    if has_colon do
        if check(p2b, TokType.Ident) do
            var (p2c, type_tok) = advance(p2b)
            base_type_name = type_tok.str_val
            p2 = p2c
        else
            p2 = parse_error(p2b, "expected mold base type after ':'")
        end
    else
        p2 = parse_error(p2, "expected ':' and base type after mold name")
    end
    p2 = skip_newlines(p2)

    ed = ast_new(AstType.RegisterDef)
    ed.name = name_tok.str_val
    ed.name2 = base_type_name
    ed.line = line

    var cur_bit = 0
    when not check(p2, TokType.End) and not check(p2, TokType.Eof) loop
        var (p3, fname, ok2) = expect_name_tok(p2, "expected field name")
        p2 = p3
        if not ok2 do
            out (p2, ed)
        end

        field = ast_new(AstType.Identifier)
        field.name = fname.str_val
        field.line = fname.line

        var (p4, has_fcolon) = match_tok(p2, TokType.Colon)
        if has_fcolon do
            if check(p4, TokType.Int) do
                var (p5, int_tok) = advance(p4)
                w = int_tok.int_val
                field.int_val = cur_bit
                field.builtin_id = w
                cur_bit = cur_bit + w
                p2 = p5
            else
                p2 = parse_error(p4, "expected integer width after mold field ':'")
            end
        else
            p2 = parse_error(p4, "expected ':' and integer width after mold field")
        end

        ed = ast_add_child(ed, field)
        var had_separator = false
        var (p6, had_semi) = match_tok(p2, TokType.Semicolon)
        if had_semi do
            p2 = p6
            had_separator = true
        else
            var (p7, had_comma) = match_tok(p6, TokType.Comma)
            p2 = p7
            if had_comma do had_separator = true end
        end
        if check(p2, TokType.Newline) do had_separator = true end
        if not had_separator and not check(p2, TokType.End) and not check(p2, TokType.Eof) do
            p2 = parse_error(p2, "expected comma, semicolon, or newline between mold fields")
        end
        p2 = skip_newlines(p2)
    end

    var p3 = p2
    if check(p3, TokType.End) do
        var (p4, _) = advance(p3)
        var (p5, _, _) = expect_tok(p4, TokType.Dot, "expected '.' after mold 'end'")
        p3 = p5
    else
        p3 = parse_error(p3, "expected 'end.' after mold")
        p3 = sync_past_block_end(p3)
    end
    out (p3, ed)
end.

func is_compound_assign(tok: Token):
    t = tok.tok_type
    if t == TokType.PlusAssign or t == TokType.MinusAssign or t == TokType.StarAssign or t == TokType.SlashAssign or t == TokType.ModAssign or t == TokType.BitAndAssign or t == TokType.BitOrAssign or t == TokType.BitXorAssign or t == TokType.BitShlAssign or t == TokType.BitShrAssign do
        out true
    end
    out false
end.

func is_compound_assign_type(t: TokType):
    if t == TokType.PlusAssign or t == TokType.MinusAssign or t == TokType.StarAssign or t == TokType.SlashAssign or t == TokType.ModAssign or t == TokType.BitAndAssign or t == TokType.BitOrAssign or t == TokType.BitXorAssign or t == TokType.BitShlAssign or t == TokType.BitShrAssign do
        out true
    end
    out false
end.

func stmt_is_field_assign(ref p: Parser):
    var k = 1
    when peek_n(p, k).tok_type == TokType.Dot and is_name_token(peek_n(p, k + 1).tok_type) loop
        k = k + 2
    end
    if k == 1 do out false end
    nxt = peek_n(p, k).tok_type
    if nxt == TokType.Assign do out true end
    out is_compound_assign_type(nxt)
end.

func compound_assign_op(t: TokType):
    if t == TokType.PlusAssign do out OpType.Add end
    if t == TokType.MinusAssign do out OpType.Sub end
    if t == TokType.StarAssign do out OpType.Mul end
    if t == TokType.SlashAssign do out OpType.Div end
    if t == TokType.ModAssign do out OpType.ModOp end
    if t == TokType.BitAndAssign do out OpType.AndOp end
    if t == TokType.BitOrAssign do out OpType.OrOp end
    if t == TokType.BitXorAssign do out OpType.XorOp end
    if t == TokType.BitShlAssign do out OpType.ShlOp end
    if t == TokType.BitShrAssign do out OpType.ShrOp end
    out OpType.Add
end.

# Preserve the exact statement token for checker lifetime boundaries, including
# branches/loops and multiple statements on one physical line.
