##
 * compiler/src/frontend/parser/state.vri — Parser State & Navigation
 * ===================================================================
 ##

include types_prelude
include rt_string_rt
include lexer
import vir_alloc, page_alloc from rt_alloc
include parser_ast
include parser_builtins

# ═══════════════════════════════════════════════════════
# Parser State
# ═══════════════════════════════════════════════════════

entity Parser:
    tokens:         int,
        pos:            int,
        token_count:    int,
        error_msg:          string,
        error_line:     int,
        builtins:       int,
        error_col:      int
end.
var g_parserErrorCode: int = 1001
var g_parserErrorDetail: int = 0
# Structured errors survive parser recovery; records hold code/line/column/detail.
var g_parserErrors: int = 0
var g_parserPendingCode: int = 1001
var g_parserPendingTagged: int = 0
var g_parserPendingLine: int = 0
var g_parserPendingColumn: int = 0
var g_parserPendingSecLine: int = 0
var g_parserPendingSecColumn: int = 0
var g_parserPendingSecNote: int = 0

func parser_new(tokens: int):
    g_parserErrorCode = 1001
    g_parserErrorDetail = 0
    g_parserErrors = vec_new_rt()
    g_parserPendingCode = 1001
    g_parserPendingTagged = 0
    g_parserPendingLine = 0
    g_parserPendingColumn = 0
    g_parserPendingSecLine = 0
    g_parserPendingSecColumn = 0
    g_parserPendingSecNote = 0

    tc = vec_len_rt(tokens)
    held_toks = tokens
    bi = build_builtins()
    p = page_alloc(56)
    native_write_i64(p, 0, held_toks)
    native_write_i64(p, 8, 0)
    native_write_i64(p, 16, tc)
    native_write_i64(p, 24, "" as i64)
    native_write_i64(p, 32, 0)
    native_write_i64(p, 40, bi)
    native_write_i64(p, 48, 0)
    pp = p as Parser
    pp.error_msg = ""
    pp.error_line = 0
    pp.builtins = bi
    pp.error_col = 0
    out pp
end.
# ═══════════════════════════════════════════════════════
# Parser Helpers
# ═══════════════════════════════════════════════════════

func tok_display_name(t: Token):
    let tt = t.tok_type
    if tt == TokType.Eof do out "end of file" end
    if tt == TokType.Newline do out "newline" end
    if tt == TokType.LParen do out "'('" end
    if tt == TokType.RParen do out "')'" end
    if tt == TokType.LBracket do out "'['" end
    if tt == TokType.RBracket do out "']'" end
    if tt == TokType.LBrace do out "'{'" end
    if tt == TokType.RBrace do out "'}'" end
    if tt == TokType.Colon do out "':'" end
    if tt == TokType.Semicolon do out "';'" end
    if tt == TokType.Comma do out "','" end
    if tt == TokType.Dot do out "'.'" end
    if tt == TokType.DotDot do out "'..'" end
    if tt == TokType.Arrow do out "'->'" end
    if tt == TokType.Assign do out "'='" end
    if tt == TokType.Plus do out "'+'" end
    if tt == TokType.Minus do out "'-'" end
    if tt == TokType.Star do out "'*'" end
    if tt == TokType.Slash do out "'/'" end
    if tt == TokType.Percent do out "'%'" end
    if tt == TokType.Power do out "'^'" end
    if tt == TokType.Eq do out "'=='" end
    if tt == TokType.Ne do out "'!='" end
    if tt == TokType.Lt do out "'<'" end
    if tt == TokType.Gt do out "'>'" end
    if tt == TokType.Le do out "'<='" end
    if tt == TokType.Ge do out "'>='" end
    if tt == TokType.Ident do
        let lex = token_lexeme(t)
        if fat_str_len(lex) > 0 do
            let cdata = native_read_i64(lex as i64, 0) as string
            out rt_strcat("identifier '", rt_strcat(cdata, "'"))
        end
        out "identifier"
    end
    if tt == TokType.Str do out "string literal" end
    if tt == TokType.Int do out "integer literal" end
    if tt == TokType.Float do out "float literal" end
    if tt == TokType.Func do out "keyword 'func'" end
    if tt == TokType.Var do out "keyword 'var'" end
    if tt == TokType.Let do out "keyword 'let'" end
    if tt == TokType.Const do out "keyword 'const'" end
    if tt == TokType.Entity do out "keyword 'entity'" end
    if tt == TokType.Enum do out "keyword 'enum'" end
    if tt == TokType.If do out "keyword 'if'" end
    if tt == TokType.Else do out "keyword 'else'" end
    if tt == TokType.Eif do out "keyword 'eif'" end
    if tt == TokType.When do out "keyword 'when'" end
    if tt == TokType.While do out "keyword 'while'" end
    if tt == TokType.Loop do out "keyword 'loop'" end
    if tt == TokType.For do out "keyword 'for'" end
    if tt == TokType.End do out "keyword 'end'" end
    if tt == TokType.Do do out "keyword 'do'" end
    if tt == TokType.Out do out "keyword 'out'" end
    if tt == TokType.Import do out "keyword 'import'" end
    if tt == TokType.Export do out "keyword 'export'" end
    if tt == TokType.Include do out "keyword 'include'" end
    let lex2 = token_lexeme(t)
    if fat_str_len(lex2) > 0 do
        let cdata2 = native_read_i64(lex2 as i64, 0) as string
        out rt_strcat("'", rt_strcat(cdata2, "'"))
    end
    out rt_strcat("token ", rt_itoa(tt as int))
end.

func parse_error(ref p: Parser, msg: string):

    if rt_strlen(p.error_msg) == 0 do
        t = peek(p)
        var errorLine = native_read_i64(t as int, 8)
        var errorColumn = native_read_i64(t as int, 16)
        if g_parserPendingLine > 0 do errorLine = g_parserPendingLine end
        if g_parserPendingColumn > 0 do errorColumn = g_parserPendingColumn end
        p.error_msg = msg
        if check(p, TokType.Eof) do
            p.error_msg = rt_strcat(p.error_msg, " (at end of file)")
        else
            p.error_msg = rt_strcat(
                p.error_msg,
                rt_strcat(", found ", tok_display_name(t))
            )
        end
        # Capture the offending lexer token before formatting/recovery.
        # Legacy parser fields retain a failure flag; diagnostic coordinates
        # come exclusively from these immutable token records.
        if p.error_line == 0 do
            p.error_line = errorLine
            p.error_col = errorColumn
        end
        let detail = p.error_msg as int
        var cleanDetail = detail
        if g_parserPendingTagged == 1 do cleanDetail = detail + 8 end
        g_parserErrors = vec_push_rt(g_parserErrors,
            parserErrorEntryRelated(g_parserPendingCode, errorLine, errorColumn, cleanDetail, g_parserPendingSecLine, g_parserPendingSecColumn, g_parserPendingSecNote))
        if vec_len_rt(g_parserErrors) == 1 do
            g_parserErrorCode = g_parserPendingCode
            g_parserErrorDetail = cleanDetail
        end
    end
    out p
end.
func parse_error_loc(ref p: Parser, msg: string, line: int, col: int):
    g_parserPendingLine = line
    g_parserPendingColumn = col

    first_error = p.error_line == 0
    p = parse_error(p, msg)
    if first_error do
        if line > 0 do
            p.error_line = line
        end
        if col > 0 do
            p.error_col = col
        end
    end
    g_parserPendingLine = 0
    g_parserPendingColumn = 0
    out p
end.
func parse_error_at(ref p: Parser, msg: string, line: int):
    g_parserPendingLine = line

    first_error = p.error_line == 0
    p = parse_error(p, msg)
    # An expression parser can consume through EOF while diagnosing a missing
    # delimiter.  Keep the line where the construct began so source-map
    # diagnostics point at the offending statement, not the end of a bundle.
    if first_error and line > 0 do
        p.error_line = line
    end
    g_parserPendingLine = 0
    g_parserPendingColumn = 0
    out p
end.
func peek(ref p: Parser) -> Token:

    if p.pos >= p.token_count do
        out token_new(TokType.Eof, 0, 0)
    end
    out native_read_i64(p.tokens, p.pos * 8) as Token
end.
func advance(ref p: Parser):
    if p.pos >= p.token_count do
        out (p, peek(p))
    end
    t = native_read_i64(p.tokens, p.pos * 8) as Token
    p.pos = p.pos + 1
    # Zero-copy lexer leaves Ident/keyword with start/len only.  Many parse
    # paths still read .str_val; materialize once on advance so names are not
    # empty (that flooded pass3 with fake "undefined" / E1002 reports).
    if t.len > 0 do
        if fat_str_len(t.str_val) == 0 do
            t.str_val = token_lexeme(t)
        end
    end
    out (p, t)
end.
func peek_n(ref p: Parser, offset: int):

    idx = p.pos + offset
    if idx >= p.token_count or idx < 0 do
        out token_new(TokType.Eof, 0, 0)
    end
    out native_read_i64(p.tokens, idx * 8) as Token
end.
func sync_statement(ref p: Parser):

    when not check(p, TokType.Eof) and not check(p, TokType.Semicolon) and not check(p, TokType.Newline) and not check(p, TokType.End) loop
        var (p2, _) = advance(p)
        p = p2
    end
    var (p3, _) = match_tok(p, TokType.Semicolon)
    p3 = skip_newlines(p3)
    out p3
end.
func check(ref p: Parser, tok_type: TokType):
    if p.pos >= p.token_count do
        out tok_type == TokType.Eof
    end
    t = native_read_i64(p.tokens, p.pos * 8) as Token
    out t.tok_type == tok_type
end.
func match_tok(ref p: Parser, tok_type: TokType):

    if check(p, tok_type) do
        var (p2, _) = advance(p)
        out (p2, true)
    end
    out (p, false)
end.
func expect_tok:
    in  p: Parser
        tok_type: TokType
        msg: string

    if check(p, tok_type) do
        var (p2, t) = advance(p)
        out (p2, t, true)
    end
    p = parse_error(p, msg)
    out (p, peek(p), false)
end.

func is_reserved_keyword(t: TokType):
    if t == TokType.PortKw do out true end
    if t == TokType.Module do out true end
    # Definitions & Declarations
    if t == TokType.Func or t == TokType.Var or t == TokType.Const or t == TokType.Entity or t == TokType.Enum or t == TokType.Class or t == TokType.Extern or t == TokType.Let do
        out true
    end
    # Control flow
    if t == TokType.If or t == TokType.Else or t == TokType.Eif or t == TokType.Loop or t == TokType.While or t == TokType.When or t == TokType.For or t == TokType.Break or t == TokType.Skip or t == TokType.Out or t == TokType.Case or t == TokType.End or t == TokType.Do or t == TokType.Then do
        out true
    end
    # Modules & Imports
    if t == TokType.Import or t == TokType.Export or t == TokType.Include do
        out true
    end
    out false
end.

func keyword_name(t: TokType):
    if t == TokType.PortKw do out "port" end
    if t == TokType.Module do out "module" end
    if t == TokType.Func do out "func" end
    if t == TokType.Var do out "var" end
    if t == TokType.Const do out "const" end
    if t == TokType.Entity do out "entity" end
    if t == TokType.Enum do out "enum" end
    if t == TokType.Class do out "class" end
    if t == TokType.Extern do out "extern" end
    if t == TokType.Let do out "let" end
    if t == TokType.If do out "if" end
    if t == TokType.Else do out "else" end
    if t == TokType.Eif do out "eif" end
    if t == TokType.Loop do out "loop" end
    if t == TokType.While do out "while" end
    if t == TokType.When do out "when" end
    if t == TokType.For do out "for" end
    if t == TokType.Break do out "break" end
    if t == TokType.Skip do out "skip" end
    if t == TokType.Out do out "out" end
    if t == TokType.Case do out "case" end
    if t == TokType.End do out "end" end
    if t == TokType.Do do out "do" end
    if t == TokType.Then do out "then" end
    if t == TokType.Import do out "import" end
    if t == TokType.Export do out "export" end
    if t == TokType.Include do out "include" end
    out "keyword"
end.

# Vir keywords are contextual: runtime/compiler code may legally use names
# such as `arena`, `timeout`, `map`, or `type` in binder and expression
# positions. Match the C parser's is_name_token policy here.
func is_name_token(t: TokType):
    v = t as int
    if t == TokType.Ident do out true end
    if v >= 10 and v <= 42 do out true end
    if v >= 120 and v <= 159 do out true end
    if v >= 162 and v <= 166 do out true end
    if v >= 191 and v <= 230 do out true end
    out false
end.

func tok_lex(tok: Token):
    out token_lexeme(tok)
end.

func is_tok_of(tok: Token) -> bool:
    if is_name_token(tok.tok_type) and fat_cstr_eq(tok_lex(tok), "of") == 1 do
        out true
    end
    out false
end.

func expect_name_tok:
    in  p: Parser
        msg: string

    t = peek(p)
    if is_reserved_keyword(t.tok_type) do
        let kw_name = keyword_name(t.tok_type)
        var msg_buf = rt_strcat(rt_strcat("expected identifier, found reserved keyword '", kw_name), "'")
        p = parse_error(p, msg_buf)
        out (p, peek(p), false)
    end
    if is_name_token(t.tok_type) do
        var (p2, got) = advance(p)
        got.str_val = tok_lex(got)
        out (p2, got, true)
    end
    p = parse_error(p, msg)
    out (p, peek(p), false)
end.
func skip_newlines(ref p: Parser):

    when check(p, TokType.Newline) loop
        var (p2, _) = advance(p)
        p = p2
    end
    out p
end.

# Close a definition block per spec: `end` with optional trailing `.` (§12).
# On mismatch, record a parse error and resync — never abort the VM.
func sync_past_block_end(ref p: Parser):
    when not check(p, TokType.Eof) loop
        if check(p, TokType.End) do
            var (p2, _) = advance(p)
            var (p3, _) = match_tok(p2, TokType.Dot)
            out p3
        end
        if check(p, TokType.Func) or check(p, TokType.Entity) or check(p, TokType.Enum) or check(p, TokType.Const) or check(p, TokType.Var) or check(p, TokType.Extern) or check(p, TokType.Import) or check(p, TokType.Module) or check(p, TokType.Class) do
            out p
        end
        var (p2, _) = advance(p)
        p = p2
    end
    out p
end.

func expect_block_end(ref p: Parser, msg: string):
    if check(p, TokType.End) do
        var (p2, _) = advance(p)
        var (p3, _) = match_tok(p2, TokType.Dot)
        out p3
    end
    p = parse_error(p, msg)
    out sync_past_block_end(p)
end.
# §1.0 list separator: ";" | NEWLINE  (+ optional ",").
# Returns (parser, matched). After match, newlines / extra trailing seps are consumed.
func match_list_sep(ref p: Parser, allow_comma: bool):

    got = false
    if allow_comma do
        var (p2, m) = match_tok(p, TokType.Comma)
        p = p2
        if m do
            got = true
        end
    end
    if not got do
        var (p3, m2) = match_tok(p, TokType.Semicolon)
        p = p3
        if m2 do
            got = true
        end
    end
    if not got do
        if check(p, TokType.Newline) do
            got = true
        end
    end
    if not got do
        out (p, false)
    end
    p = skip_newlines(p)
    # Extra trailing ;/, — flag loop (avoid when-true+break on VM)
    more = true
    when more loop
        ate = false
        var (p4, m3) = match_tok(p, TokType.Semicolon)
        p = p4
        if m3 do
            ate = true
        end
        if not ate and allow_comma do
            var (p5, m4) = match_tok(p, TokType.Comma)
            p = p5
            if m4 do
                ate = true
            end
        end
        if ate do
            p = skip_newlines(p)
        else
            more = false
        end
    end
    out (p, true)
end.
func is_stmt_start(t: TokType):

    out (t == TokType.Var or t == TokType.Const or t == TokType.If or
        t == TokType.Loop or t == TokType.While or t == TokType.When or t == TokType.For or
        t == TokType.Out or t == TokType.Print or t == TokType.Input or
        t == TokType.Ident or t == TokType.Int or t == TokType.Float or
        t == TokType.Str or t == TokType.LParen or t == TokType.Minus or
        t == TokType.Not or t == TokType.CheckCpu or t == TokType.Patch or
        t == TokType.Func or t == TokType.Break or t == TokType.Skip or
        t == TokType.True or t == TokType.False or t == TokType.LBracket or
        t == TokType.Enum or t == TokType.Entity or
        t == TokType.Import or t == TokType.From or t == TokType.Module or
        t == TokType.Export or t == TokType.Include or
        t == TokType.Async or t == TokType.AwaitKw or t == TokType.Task or
        t == TokType.Wait or t == TokType.BitAnd or t == TokType.BorrowMut or
        t == TokType.BitNot or t == TokType.ErxKw or t == TokType.MapKw or
        t == TokType.ArrCompactKw or t == TokType.PtrKw or t == TokType.ThisKw or
        t == TokType.ErrorKw or t == TokType.NoneLit)
end.
