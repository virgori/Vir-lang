##
 * compiler/src/frontend/parser/stmt_decl/aggregate_def.vri — for-range, enum, entity, interface and mold definitions
 * VIRC-PLN-0009: extracted verbatim from compiler/src/frontend/parser/stmt_decl.vri.
 ##

include types_prelude
include rt_string_rt
include lexer
include ide_facts
include parser_ast
include parser_state
include parser_diagnostics
include parser_expr
include parser_stmt_control

func parse_for_range_stmt(ref p: Parser):

    line = peek(p).line
    var (p2, var_tok, ok) = expect_name_tok(p, "expected loop variable")
    if not ok do
        out (p2, ast_new(AstType.ForRange))
    end
    loop_name = tok_lex(var_tok)

    var (p3, _, ok2) = expect_tok(p2, TokType.In, "expected 'in' after for variable")
    if not ok2 do
        out (p3, ast_new(AstType.ForRange))
    end

    var (p4, start_expr) = parse_expr(p3)
    if check(p4, TokType.DotDot) do
        var (p5, _) = advance(p4)
        var (p6, end_expr) = parse_expr(p5)
        # Body opener: ':' or 'do' (stdlib uses both).
        var (p6b, _) = match_tok(p6, TokType.Colon)
        p6 = p6b
        var (p6c, _) = match_tok(p6, TokType.Do)
        p6 = p6c
        p6 = skip_newlines(p6)

        var (p7, body) = parse_block(p6)
        var (p8, _, _) = expect_tok(p7, TokType.End, "expected 'end' after for block")

        n = ast_new(AstType.ForRange)
        n.name = loop_name
        n.line = line
        n = ast_add_child(n, start_expr)
        n = ast_add_child(n, end_expr)
        n = ast_add_child(n, body)
        out (p8, n)
    end

    # Array loop: for x in arr do ... end
    var (p4b, _) = match_tok(p4, TokType.Colon)
    p4 = p4b
    var (p4c, _) = match_tok(p4, TokType.Do)
    p4 = p4c
    p4 = skip_newlines(p4)

    var (p7a, body_arr) = parse_block(p4)
    var (p8a, _, _) = expect_tok(p7a, TokType.End, "expected 'end' after for block")

    n = ast_new(AstType.ForRange)
    n.name = loop_name
    n.line = line
    n = ast_add_child(n, start_expr)
    n = ast_add_child(n, body_arr)
    out (p8a, n)
end.
func parse_enum_def(ref p: Parser):

    line = peek(p).line
    var (p2, name_tok, ok) = expect_name_tok(p, "expected enum name")
    if not ok do
        out (p2, ast_new(AstType.EnumDef))
    end

    let enumNameSpan = native_read_i64(name_tok as int, 72)
    let enumNameLine = native_read_i64(name_tok as int, 8)
    p2 = skip_newlines(p2)

    en = ast_new(AstType.EnumDef)
    en.name = name_tok.str_val
    en.line = enumNameLine
    ideFactOrigin(en as int, enumNameSpan, enumNameLine)

    # Generic parameters affect semantic specialization, not the canonical
    # tagged-union layout.  Keep accepting `enum Option<T>:` here instead of
    # mis-parsing `<T>` as the first variant.
    p2 = skip_generic_list(p2)
    p2 = skip_newlines(p2)

    # Consume optional ':' after enum name
    var (p2b, _) = match_tok(p2, TokType.Colon)
    p2 = p2b
    p2 = skip_newlines(p2)

    next_val = 0
    when not check(p2, TokType.End) and not check(p2, TokType.Eof) loop
        var (p3, vname, ok2) = expect_name_tok(p2, "expected enum variant")
        p2 = p3
        if not ok2 do
            out (p2, en)
        end

        let variantNameSpan = native_read_i64(vname as int, 72)
        let variantNameLine = native_read_i64(vname as int, 8)
        val = next_val
        var (p4, has_val) = match_tok(p2, TokType.Assign)
        if has_val do
            var (p5, int_tok, _) = expect_tok(p4, TokType.Int, "expected integer value")
            p2 = p5
            val = int_tok.int_val
        else
            p2 = p4
        end
        # Optional payload: preserve one child per payload slot.  Earlier code
        # skipped this list, which made constructor arity and enum layout
        # unknowable after parsing.
        payload_count = 0
        payloads = vec_new_rt()
        if check(p2, TokType.LParen) do
            var (p_lp, _) = advance(p2)
            p2 = p_lp
            p2 = skip_newlines(p2)
            when not check(p2, TokType.RParen) and not check(p2, TokType.Eof) loop
                payload = ast_new(AstType.ParamDef)
                ptok = peek(p2)
                if is_name_token(ptok.tok_type) do
                    var (p_name, taken_name) = advance(p2)
                    payload.name = tok_lex(taken_name)
                    payload.line = taken_name.line
                    p2 = p_name
                else
                    payload.name = fat_str_new("_")
                    payload.line = vname.line
                end
                # A typed slot uses `name: Type`.  `Some(T)` is also retained
                # as one opaque word slot; later generic specialization can
                # refine its type without changing the ABI offsets.
                if check(p2, TokType.Colon) do
                    var (p_colon, _) = advance(p2)
                    var (p_type, type_name) = parse_type_expr_string(p_colon)
                    payload.name2 = type_name
                    p2 = p_type
                end
                payloads = vec_push_rt(payloads, payload as i64)
                payload_count = payload_count + 1
                p2 = skip_newlines(p2)
                if check(p2, TokType.Comma) or check(p2, TokType.Semicolon) do
                    var (p_sep, _) = advance(p2)
                    p2 = skip_newlines(p_sep)
                else
                    # Malformed/legacy slot syntax: consume to the closing
                    # parenthesis so parsing always makes forward progress.
                    when not check(p2, TokType.RParen) and not check(p2, TokType.Eof) loop
                        var (p_adv, _) = advance(p2)
                        p2 = p_adv
                    end
                end
            end
            var (p_rp, _, _) = expect_tok(p2, TokType.RParen, "expected ')' after enum payload")
            p2 = p_rp
        end
        next_val = val + 1

        variant = ast_new(AstType.LiteralInt)
        variant.name = vname.str_val
        variant.int_val = val
        variant.line = variantNameLine
        ideFactOrigin(variant as int, variantNameSpan, variantNameLine)
        var pi = 0
        when pi < vec_len_rt(payloads) loop
            variant = ast_add_child(variant, vec_get_rt(payloads, pi))
            pi = pi + 1
        end
        variant.builtin_id = payload_count
        en = ast_add_child(en, variant)
        var (p6c, _) = match_tok(p2, TokType.Comma)
        var (p6, _) = match_tok(p6c, TokType.Semicolon)
        p2 = p6
        p2 = skip_newlines(p2)
    end

    var (p3, _, _) = expect_tok(p2, TokType.End, "expected 'end' after enum")
    # v1.2: definition blocks close with 'end' — consume optional dot
    var (p3b, _) = match_tok(p3, TokType.Dot)
    out (p3b, en)
end.
func parse_entity_def(ref p: Parser):

    line = peek(p).line
    var (p2, name_tok, ok) = expect_name_tok(p, "expected entity name")
    if not ok do
        out (p2, ast_new(AstType.EntityDef))
    end

    let entityNameLine = name_tok.line
    let entityNameSpan = name_tok.span_id

    # Generic declaration: `entity Name<T, U>`.
    var (p_gen, gen_params) = parse_generic_param_list(p2)
    p2 = p_gen
    p2 = skip_newlines(p2)

    # Optional base type for register / mold: `register UART_SR: u32`
    var base_type_name = fat_str_new("")
    var (p2b, has_colon) = match_tok(p2, TokType.Colon)
    if has_colon do
        if check(p2b, TokType.Ident) do
            var (p2c, type_tok) = advance(p2b)
            base_type_name = type_tok.str_val
            p2 = p2c
        else
            p2 = p2b
        end
    end
    p2 = skip_newlines(p2)

    ed = ast_new(AstType.EntityDef)
    ed.name = name_tok.str_val
    ed.name2 = base_type_name
    native_write_i64(ed as i64, 32, entityNameLine)
    native_write_i64(ed as i64, 72, entityNameSpan)
    if fat_str_len(gen_params) > 0 do
        ed.builtin_id = gen_params as int
    end

    when not check(p2, TokType.End) and not check(p2, TokType.Eof) loop
        p2 = skip_newlines(p2)
        if check(p2, TokType.End) or check(p2, TokType.Eof) do
            break
        end
        if check(p2, TokType.Method) or check(p2, TokType.Func) do
            var (p_m, _) = advance(p2)
            var (p_mdef, mnode) = parse_func_def(p_m)
            p2 = p_mdef
            ed = ast_add_child(ed, mnode)
            p2 = skip_newlines(p2)
            skip
        end
        var (p3, fname, ok2) = expect_name_tok(p2, "expected field name")
        p2 = p3
        if not ok2 do
            p2 = parse_error(p2, "expected field name in entity body")
            p2 = sync_past_block_end(p2)
            ed.name = name_tok.str_val
            out (p2, ed)
        end

        field = ast_new(AstType.Identifier)
        field.name = fname.str_val
        field.line = fname.line
        let fieldDeclarationLine = native_read_i64(fname as int, 8)
        let fieldDeclarationSpan = native_read_i64(fname as int, 72)

        # Optional type or bitfield hint
        var (p4, has_fcolon) = match_tok(p2, TokType.Colon)
        if has_fcolon do
            if check(p4, TokType.Int) do
                var (p5, int_tok) = advance(p4)
                start_bit = int_tok.int_val
                width = 1
                if check(p5, TokType.DotDot) do
                    var (p6, _) = advance(p5)
                    var (p7, hi_tok) = advance(p6)
                    end_bit = hi_tok.int_val
                    width = end_bit - start_bit + 1
                    p2 = p7
                else
                    p2 = p5
                end
                field.int_val = start_bit
                field.builtin_id = width
            else
                if not check(p4, TokType.Comma) and not check(p4, TokType.Semicolon) and not check(p4, TokType.Newline) and not check(p4, TokType.End) and not check(p4, TokType.Eof) do
                    var (p_type_end, field_type_str) = parse_type_expr_string(p4)
                    field.name2 = field_type_str
                    p2 = p_type_end
                else
                    p2 = p4
                end
            end
        else
            p2 = p4
        end

        ideFactOrigin(field as int, fieldDeclarationSpan, fieldDeclarationLine)
        ed = ast_add_child(ed, field)
        # Hard parser accepts ',' or ';' between entity fields (lexer.vri uses commas).
        var (p6, had_semi) = match_tok(p2, TokType.Semicolon)
        if had_semi do
            p2 = p6
        else
            var (p7, _) = match_tok(p6, TokType.Comma)
            p2 = p7
        end
        p2 = skip_newlines(p2)
    end

    p2 = expect_block_end(p2, "expected 'end' after entity")
    # ast_add_child corrupts soft .name — restore for entity ctor lookup.
    ed.name = name_tok.str_val
    out (p2, ed)
end.

func parse_interface_def(ref p: Parser):
    line = peek(p).line
    var (p2, name_tok, ok) = expect_name_tok(p, "expected interface name")
    if not ok do
        out (p2, ast_new(AstType.EntityDef))
    end

    p2 = skip_generic_list(p2)
    var (p_colon, _) = match_tok(p2, TokType.Colon)
    p2 = skip_newlines(p_colon)

    iface = ast_new(AstType.EntityDef)
    iface.name = name_tok.str_val
    iface.name2 = fat_str_new("interface")
    iface.line = line

    when not check(p2, TokType.End) and not check(p2, TokType.Eof) loop
        if check(p2, TokType.Func) or check(p2, TokType.Method) do
            var (p_func, _) = advance(p2)
            var (p_after, method_node) = parse_func_def_mode(p_func, true)
            iface = ast_add_child(iface, method_node)
            p2 = skip_newlines(p_after)
        else
            # `implement Base` and future interface metadata are line-scoped.
            # Preserve parser progress without treating them as method bodies.
            when not check(p2, TokType.Newline) and not check(p2, TokType.End) and not check(p2, TokType.Eof) loop
                var (p_next, _) = advance(p2)
                p2 = p_next
            end
            p2 = skip_newlines(p2)
        end
    end

    p2 = expect_block_end(p2, "expected 'end' after interface")
    iface.name = name_tok.str_val
    out (p2, iface)
end.

func parse_mold_def(ref p: Parser):
    line = peek(p).line
    var (p2, name_tok, ok) = expect_name_tok(p, "expected mold name")
    if not ok do
        out (p2, ast_new(AstType.RegisterDef))
    end
    p2 = skip_newlines(p2)
    var base_type_name = fat_str_new("")
    var (p2b, has_colon) = match_tok(p2, TokType.Colon)
    if has_colon do
        if check(p2b, TokType.Ident) do
            var (p2c, type_tok) = advance(p2b)
            base_type_name = type_tok.str_val
            p2 = p2c
        else
            p2 = parse_error(p2b, "expected mold base type after ':'")
        end
    else
        p2 = parse_error(p2, "expected ':' and base type after mold name")
    end
    p2 = skip_newlines(p2)

    ed = ast_new(AstType.RegisterDef)
    ed.name = name_tok.str_val
    ed.name2 = base_type_name
    ed.line = line

    var cur_bit = 0
    when not check(p2, TokType.End) and not check(p2, TokType.Eof) loop
        var (p3, fname, ok2) = expect_name_tok(p2, "expected field name")
        p2 = p3
        if not ok2 do
            out (p2, ed)
        end

        field = ast_new(AstType.Identifier)
        field.name = fname.str_val
        field.line = fname.line

        var (p4, has_fcolon) = match_tok(p2, TokType.Colon)
        if has_fcolon do
            if check(p4, TokType.Int) do
                var (p5, int_tok) = advance(p4)
                w = int_tok.int_val
                field.int_val = cur_bit
                field.builtin_id = w
                cur_bit = cur_bit + w
                p2 = p5
            else
                p2 = parse_error(p4, "expected integer width after mold field ':'")
            end
        else
            p2 = parse_error(p4, "expected ':' and integer width after mold field")
        end

        ed = ast_add_child(ed, field)
        var had_separator = false
        var (p6, had_semi) = match_tok(p2, TokType.Semicolon)
        if had_semi do
            p2 = p6
            had_separator = true
        else
            var (p7, had_comma) = match_tok(p6, TokType.Comma)
            p2 = p7
            if had_comma do had_separator = true end
        end
        if check(p2, TokType.Newline) do had_separator = true end
        if not had_separator and not check(p2, TokType.End) and not check(p2, TokType.Eof) do
            p2 = parse_error(p2, "expected comma, semicolon, or newline between mold fields")
        end
        p2 = skip_newlines(p2)
    end

    var p3 = p2
    if check(p3, TokType.End) do
        var (p4, _) = advance(p3)
        var (p5, _, _) = expect_tok(p4, TokType.Dot, "expected '.' after mold 'end'")
        p3 = p5
    else
        p3 = parse_error(p3, "expected 'end.' after mold")
        p3 = sync_past_block_end(p3)
    end
    out (p3, ed)
end.
