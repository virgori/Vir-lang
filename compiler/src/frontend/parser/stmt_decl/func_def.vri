##
 * compiler/src/frontend/parser/stmt_decl/func_def.vri — function definition parsing
 * VIRC-PLN-0009: extracted verbatim from compiler/src/frontend/parser/stmt_decl.vri.
 ##

include types_prelude
include rt_string_rt
include lexer
include ide_facts
include parser_ast
include parser_state
include parser_diagnostics
include parser_expr
include parser_stmt_control

func parse_func_def_mode(ref p: Parser, signature_only: bool):

    var (p2, name_tok, ok) = expect_name_tok(p, "expected function name")
    if not ok do
        out (p2, ast_new(AstType.FuncDef))
    end

    let functionNameSpan = name_tok.span_id
    fn_node = ast_new(AstType.FuncDef)
    native_write_i64(fn_node as i64, 72, functionNameSpan)
    fn_name = name_tok.str_val
    fn_node.name = fn_name
    fn_node.line = name_tok.line

    # Generic declaration: `func name<T, U>(...)`.
    var (p_gen, gen_params) = parse_generic_param_list(p2)
    p2 = p_gen
    if fat_str_len(gen_params) > 0 do
        fn_node.builtin_id = gen_params as int
    end

    # Parse parameters (optional parens — `func name` and `func name(...)` both valid)
    var had_parens = false
    if check(p2, TokType.LParen) do
        had_parens = true
        var (p3, _) = advance(p2)
        p3 = skip_newlines(p3)

        # Parse parameters
        if not check(p3, TokType.RParen) do
            # Check if user wrongly placed 'in' or 'out' inside () (§14.1)
            if check(p3, TokType.In) do
                p3 = parse_error_code_at(p3, 3044, "từ khoá 'in' không hợp lệ trong cú pháp ngoặc () — tham số mặc định theo giá trị (§14.1)", peek(p3).line)
            eif check(p3, TokType.Out) do
                p3 = parse_error_code_at(p3, 3045, "tham số 'out' không được khai báo trong cú pháp ngoặc () — sử dụng khối nhóm (§14.1)", peek(p3).line)
            end

            # Check for 'this' as first parameter (method syntax)
            if check(p3, TokType.ThisKw) do
                var (p_this, this_ptok) = advance(p3)
                p3 = p_this
                param = ast_new(AstType.Identifier)
                param.name = fat_str_new("this")
                fn_node = ast_add_child(fn_node, param)
                fn_node.int_val = 1
                # Preserve the receiver annotation for strict UFCS type checks.
                if check(p3, TokType.Colon) do
                    var (p_type_start, _) = advance(p3)
                    var (p_type_end, this_type) = parse_type_expr_string(p_type_start)
                    param.name2 = this_type
                    p3 = p_type_end
                end
            else
                # Check for 'ref' modifier
                is_ref = false
                if check(p3, TokType.RefKw) do
                    var (p_ref, _) = advance(p3)
                    p3 = p_ref
                    is_ref = true
                end
                let parameterNameToken = peek(p3)
                let parameterLine = parameterNameToken.line
                let parameterSpan = parameterNameToken.span_id
                param_name = fat_str_new("")
                ok2 = false
                if check(p3, TokType.Ident) do
                    var (p4, pt) = advance(p3)
                    p3 = p4
                    param_name = pt.str_val
                    ok2 = true
                eif check(p3, TokType.PtrKw) do
                    var (p4, _) = advance(p3)
                    p3 = p4
                    param_name = fat_str_new("ptr")
                    ok2 = true
                else
                    var (p4, param_tok, ok_e) = expect_name_tok(p3, "expected parameter name")
                    p3 = p4
                    param_name = param_tok.str_val
                    ok2 = ok_e
                end
                if ok2 do
                    if is_ref do
                        param = ast_new(AstType.RefParam)
                        param.int_val = 1 # ParamMode.Ref
                    else
                        param = ast_new(AstType.ParamDef)
                        param.int_val = 0 # ParamMode.In
                    end
                    param.name = param_name
                    native_write_i64(param as i64, 32, parameterLine)
                    native_write_i64(param as i64, 72, parameterSpan)
                    # Keep annotation parsing in the same lexical scope as the
                    # parameter handle.  Using `param` after this block yielded
                    # an empty handle in the native self-hosted compiler.
                    if check(p3, TokType.Colon) do
                        var (p_skip, _) = advance(p3)
                        var (p_type_end, type_str) = parse_type_expr_string(p_skip)
                        param.name2 = type_str
                        p3 = p_type_end
                    end
                    native_write_i64(param as i64, 32, parameterLine)
                    native_write_i64(param as i64, 72, parameterSpan)
                    ideFactOrigin(param as int, parameterSpan, parameterLine)
                    fn_node = ast_add_child(fn_node, param)
                else
                    if check(p3, TokType.Colon) do
                        var (p_skip_bad, _) = advance(p3)
                        p3 = skip_type_expr(p_skip_bad)
                    end
                end
            end
            # §1.0: param separator is "," | ";" | NEWLINE
            should_loop = true
            when should_loop loop
                var (p5, has_sep) = match_list_sep(p3, true)
                p3 = p5
                if not has_sep or check(p3, TokType.RParen) do
                    should_loop = false
                else
                    if check(p3, TokType.In) do
                        p3 = parse_error_code_at(p3, 3044, "từ khoá 'in' không hợp lệ trong cú pháp ngoặc () — tham số mặc định theo giá trị (§14.1)", peek(p3).line)
                    eif check(p3, TokType.Out) do
                        p3 = parse_error_code_at(p3, 3045, "tham số 'out' không được khai báo trong cú pháp ngoặc () — sử dụng khối nhóm (§14.1)", peek(p3).line)
                    end
                    # Check for 'ref' modifier on subsequent params
                    is_ref2 = false
                    if check(p3, TokType.RefKw) do
                        var (p_ref2, _) = advance(p3)
                        p3 = p_ref2
                        is_ref2 = true
                    end
                    let parameter2NameToken = peek(p3)
                    let parameter2Line = parameter2NameToken.line
                    let parameter2Span = parameter2NameToken.span_id
                    param2_name = fat_str_new("")
                    ok3 = false
                    if check(p3, TokType.Ident) do
                        var (p6, pt2) = advance(p3)
                        p3 = p6
                        param2_name = pt2.str_val
                        ok3 = true
                    eif check(p3, TokType.PtrKw) do
                        var (p6, _) = advance(p3)
                        p3 = p6
                        param2_name = fat_str_new("ptr")
                        ok3 = true
                    else
                        var (p6, pt, ok_e3) = expect_name_tok(p3, "expected parameter name")
                        p3 = p6
                        param2_name = pt.str_val
                        ok3 = ok_e3
                    end
                    if ok3 do
                        # Check duplicate parameter in fn_node
                        var dup = false
                        var dpi = 0
                        let dp_count = vec_len_rt(fn_node.children)
                        when dpi < dp_count loop
                            let existing = vec_get_rt(fn_node.children, dpi) as AstNode
                            if fat_str_eq(existing.name, param2_name) == 1 do
                                dup = true
                                dpi = dp_count
                            end
                            dpi = dpi + 1
                        end
                        if dup do
                            p3 = parse_error_code_at(p3, 3054, "tham số bị khai báo trùng lặp trong cùng một hàm", peek(p3).line)
                        end
                        if is_ref2 do
                            param2 = ast_new(AstType.RefParam)
                            param2.int_val = 1 # ParamMode.Ref
                        else
                            param2 = ast_new(AstType.ParamDef)
                            param2.int_val = 0 # ParamMode.In
                        end
                        param2.name = param2_name
                        native_write_i64(param2 as i64, 32, parameter2Line)
                        native_write_i64(param2 as i64, 72, parameter2Span)
                        if check(p3, TokType.Colon) do
                            var (p_skip3, _) = advance(p3)
                            var (p_type_end3, type_str3) = parse_type_expr_string(p_skip3)
                            param2.name2 = type_str3
                            p3 = p_type_end3
                        end
                        native_write_i64(param2 as i64, 32, parameter2Line)
                        native_write_i64(param2 as i64, 72, parameter2Span)
                        ideFactOrigin(param2 as int, parameter2Span, parameter2Line)
                        fn_node = ast_add_child(fn_node, param2)
                    else
                        if check(p3, TokType.Colon) do
                            var (p_skip_bad3, _) = advance(p3)
                            p3 = skip_type_expr(p_skip_bad3)
                        end
                    end
                end
            end
        end

        var (p4, _, _) = expect_tok(p3, TokType.RParen, "expected ')' after parameters")
        p2 = p4
    end

    # Skip optional return type `-> type` or `out(TYPE)` / `out TYPE`
    if check(p2, TokType.Arrow) do
        var (p_arr, _) = advance(p2)
        var (p_ret_end, ret_str) = parse_type_expr_string(p_arr)
        fn_node.name2 = ret_str
        p2 = p_ret_end
    end
    p2 = skip_out_return_type(p2)

    # Skip optional trailing colon `:`
    var (p_colon, _) = match_tok(p2, TokType.Colon)
    p2 = p_colon

    p2 = skip_newlines(p2)

    # Interface members are declarations, not nested function blocks. Their
    # trailing `:` and newline finish the signature; the interface owns the
    # only `end` token.
    if signature_only do
        empty_body = ast_new(AstType.Block)
        fn_node = ast_add_child(fn_node, empty_body)
        fn_node.name = fn_name
        out (p2, fn_node)
    end

    # Form 2: Khối nhóm tham số `in` / `ref` / `out` (§14.2)
    # Chỉ áp dụng khi chữ ký là `func tên:` không có danh sách ngoặc `()`.
    if had_parens do
        if check(p2, TokType.In) or check(p2, TokType.RefKw) or (check(p2, TokType.Out) and is_param_group_out(p2)) do
            p2 = parse_error_at(p2, "hàm đã có danh sách tham số trong () không được khai báo thêm khối tham số (§14)", peek(p2).line)
        end
    else
        var in_param_groups = true
        when in_param_groups loop
            p2 = skip_newlines(p2)
            var cur_group = 0 # 0=None, 1=In, 2=Ref, 3=Out
            var group_name = fat_str_new("")
            if check(p2, TokType.In) do
                cur_group = 1
                group_name = fat_str_new("in")
            eif check(p2, TokType.RefKw) do
                cur_group = 2
                group_name = fat_str_new("ref")
            eif check(p2, TokType.Out) do
                if is_param_group_out(p2) do
                    cur_group = 3
                    group_name = fat_str_new("out")
                end
            end

            if cur_group == 0 do
                # Kiểm tra tham số mồ côi (orphan parameter) (§14.2)
                if is_orphan_param(p2) do
                    p2 = parse_error_code_at(p2, 3047, "tham số không có nhóm (§14.2)", peek(p2).line)
                end
                in_param_groups = false
            else
                var (p_grp_next, grp_tok) = advance(p2)
                p2 = p_grp_next
                has_grp_paren = false
                if check(p2, TokType.LParen) do
                    p2 = parse_error_code_at(p2, 3044, "cú pháp nhóm tham số với dấu ngoặc () không được hỗ trợ trong Spec v2.0 (§14.2)", peek(p2).line)
                    var (p_glp, _) = advance(p2)
                    p2 = p_glp
                    has_grp_paren = true
                end
                p2 = skip_newlines(p2)
                when check(p2, TokType.Semicolon) or check(p2, TokType.Comma) loop
                    if check(p2, TokType.Comma) do
                        p2 = parse_error_code_at(p2, 3055, "dấu phẩy không phải separator hợp lệ trong nhóm tham số; dùng ';' hoặc xuống dòng (§14.2)", peek(p2).line)
                    end
                    var (p_gsep, _) = advance(p2)
                    p2 = p_gsep
                end
                p2 = skip_newlines(p2)

                var group_param_count = 0
                var more_in_group = true
                when more_in_group loop
                    p2 = skip_newlines(p2)
                    is_end_of_group = false
                    if check(p2, TokType.End) or check(p2, TokType.Eof) or check(p2, TokType.RParen) do
                        is_end_of_group = true
                    eif check(p2, TokType.In) or check(p2, TokType.RefKw) do
                        is_end_of_group = true
                    eif check(p2, TokType.Out) do
                        if is_param_group_out(p2) do
                            is_end_of_group = true
                        end
                    end

                    if is_end_of_group do
                        more_in_group = false
                    else
                        tok_cur = peek(p2)
                        if not is_name_token(tok_cur.tok_type) do
                            more_in_group = false
                        else
                            let saved_p2 = p2.pos
                            var (p_c2_s, _) = advance(p2)
                            tok_c2_s = peek(p_c2_s)
                            p2.pos = saved_p2
                            if tok_c2_s.tok_type == TokType.Assign or tok_c2_s.tok_type == TokType.Dot or tok_c2_s.tok_type == TokType.LParen do
                                more_in_group = false
                            else
                                let groupParserPtr = p2 as int
                                let groupTokens = native_read_i64(groupParserPtr, 0)
                                let groupPosition = native_read_i64(groupParserPtr, 8)
                                let groupNameToken = native_read_i64(groupTokens, groupPosition * 8)
                                let groupParameterLine = native_read_i64(groupNameToken, 8)
                                let groupParameterSpan = native_read_i64(groupNameToken, 72)
                                var (p_pn, p_name_tok, ok_pn) = expect_name_tok(p2, "expected parameter name")
                                p2 = p_pn
                                if not ok_pn do
                                    more_in_group = false
                                else
                                    p_name = p_name_tok.str_val
                                    param_node = ast_new(AstType.ParamDef)
                                    if cur_group == 1 do
                                        param_node.node_type = AstType.ParamDef
                                        param_node.int_val = 0 # ParamMode.In
                                    eif cur_group == 2 do
                                        param_node.node_type = AstType.RefParam
                                        param_node.int_val = 1 # ParamMode.Ref
                                    eif cur_group == 3 do
                                        param_node.node_type = AstType.OutParam
                                        param_node.int_val = 2 # ParamMode.Out
                                    end
                                    param_node.name = p_name
                                    native_write_i64(param_node as i64, 32, groupParameterLine)
                                    native_write_i64(param_node as i64, 72, groupParameterSpan)

                                    if check(p2, TokType.Colon) do
                                        var (p_col, _) = advance(p2)
                                        var (p_tend, type_str) = parse_type_expr_string(p_col)
                                        param_node.name2 = type_str
                                        p2 = p_tend
                                    end

                                    # Kiểm tra trùng tên tham số trong hàm
                                    var dup_f2 = false
                                    var dpi_f2 = 0
                                    let dp_f2_count = vec_len_rt(fn_node.children)
                                    when dpi_f2 < dp_f2_count loop
                                        let existing_f2 = vec_get_rt(fn_node.children, dpi_f2) as AstNode
                                        if fat_str_eq(existing_f2.name, p_name) == 1 do
                                            dup_f2 = true
                                            dpi_f2 = dp_f2_count
                                        end
                                        dpi_f2 = dpi_f2 + 1
                                    end
                                    if dup_f2 do
                                        p2 = parse_error_code_at(p2, 3054, "tham số bị khai báo trùng lặp trong cùng một hàm (§14)", p_name_tok.line)
                                    end

                                    native_write_i64(param_node as i64, 32, groupParameterLine)
                                    native_write_i64(param_node as i64, 72, groupParameterSpan)
                                    ideFactOrigin(param_node as int, groupParameterSpan, groupParameterLine)
                                    fn_node = ast_add_child(fn_node, param_node)
                                    group_param_count = group_param_count + 1

                                    let before_sep2 = p2.pos
                                    p2 = skip_newlines(p2)
                                    let got_nl2 = p2.pos != before_sep2
                                    if has_grp_paren and check(p2, TokType.RParen) do
                                        more_in_group = false
                                    else
                                        var m_cm2 = false
                                        if check(p2, TokType.Comma) do
                                            m_cm2 = true
                                            p2 = parse_error_code_at(p2, 3055, "dấu phẩy không phải separator hợp lệ trong nhóm tham số; dùng ';' hoặc xuống dòng (§14.2)", peek(p2).line)
                                            var (p_cm2, _) = advance(p2)
                                            p2 = p_cm2
                                        end
                                        var (p_sc2, m_sc2) = match_tok(p2, TokType.Semicolon)
                                        p2 = p_sc2
                                        has_sep2 = m_cm2 or m_sc2
                                        if has_sep2 do
                                            p2 = skip_newlines(p2)
                                            if has_grp_paren and check(p2, TokType.RParen) do
                                                more_in_group = false
                                            end
                                        eif not got_nl2 do
                                            more_in_group = false
                                        else
                                            nt_next = peek(p2).tok_type
                                            if is_name_token(nt_next) do
                                                nt_n2 = peek_n(p2, 1).tok_type
                                                if nt_n2 != TokType.Colon and nt_n2 != TokType.Newline and nt_n2 != TokType.Semicolon and nt_n2 != TokType.Comma do
                                                    more_in_group = false
                                                end
                                            else
                                                more_in_group = false
                                            end
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
                if has_grp_paren do
                    var (p_grp_rp, _, _) = expect_tok(p2, TokType.RParen, "expected ')' after group parameters")
                    p2 = p_grp_rp
                end

                if group_param_count == 0 do
                    let next_t = peek(p2)
                    p2 = parse_error_code_loc_related(p2, 3046, "nhóm tham số rỗng (§14.2)", grp_tok.line, grp_tok.col, next_t.line, next_t.col, "nhóm tiếp theo")
                end
            end
        end
    end

    var (p5, body) = parse_block(p2)
    fn_node = ast_add_child(fn_node, body)

    # Parse optional ensure / revert blocks in either source order.  They are
    # clauses (not independent block openers), so `:` is always an error.
    var seen_ensure = false
    var seen_revert = false
    has_cleanup = true
    when has_cleanup loop
        if check(p5, TokType.EnsureKw) do
            if seen_ensure do
                p5 = parse_error_code_at(p5, 3057, "duplicate ensure clause in function (§13.2)", peek(p5).line)
            end
            seen_ensure = true
            var (p_ens, _) = advance(p5)
            var p_ens2 = p_ens
            if check(p_ens2, TokType.Colon) do
                p_ens2 = parse_error_code_at(p_ens2, 3056, "ensure/revert clauses must not use ':' (§13.2–13.3)", peek(p_ens2).line)
                var (p_ens_col, _) = advance(p_ens2)
                p_ens2 = p_ens_col
            end
            p_ens2 = skip_newlines(p_ens2)
            var (p_ens3, ensure_body) = parse_block(p_ens2)
            ensure_node = ast_new(AstType.EnsureBlock)
            ensure_node = ast_add_child(ensure_node, ensure_body)
            fn_node = ast_add_child(fn_node, ensure_node)
            p5 = p_ens3
        eif check(p5, TokType.RevertKw) do
            if seen_revert do
                p5 = parse_error_code_at(p5, 3058, "duplicate revert clause in function (§13.3)", peek(p5).line)
            end
            seen_revert = true
            var (p_rev, _) = advance(p5)
            var p_rev2 = p_rev
            if check(p_rev2, TokType.Colon) do
                p_rev2 = parse_error_code_at(p_rev2, 3056, "ensure/revert clauses must not use ':' (§13.2–13.3)", peek(p_rev2).line)
                var (p_rev_col, _) = advance(p_rev2)
                p_rev2 = p_rev_col
            end
            p_rev2 = skip_newlines(p_rev2)
            var (p_rev3, revert_body) = parse_block(p_rev2)
            revert_node = ast_new(AstType.RevertBlock)
            revert_node = ast_add_child(revert_node, revert_body)
            fn_node = ast_add_child(fn_node, revert_node)
            p5 = p_rev3
        else
            has_cleanup = false
        end
    end

    if not check(p5, TokType.End) do
        p5 = parse_error_at(p5, "expected 'end' to close function", fn_node.line)
    end
    var (p6, _, _) = expect_tok(p5, TokType.End, "expected 'end' to close function")
    # `end` and `end.` are both accepted by the C parser/spec-compatible
    # frontend.  Keep the dot optional on the soft self-host path as well.
    var (p6b, _) = match_tok(p6, TokType.Dot)
    # ast_add_child corrupts soft .name — restore for lowering / Call lookup.
    fn_node.name = fn_name
    out (p6b, fn_node)
end.

func parse_func_def(ref p: Parser):
    out parse_func_def_mode(p, false)
end.
