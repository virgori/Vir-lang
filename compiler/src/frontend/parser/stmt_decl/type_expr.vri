##
 * compiler/src/frontend/parser/stmt_decl/type_expr.vri — generic parameter lists and type-expression parsing
 * VIRC-PLN-0009: extracted verbatim from compiler/src/frontend/parser/stmt_decl.vri.
 ##

include types_prelude
include rt_string_rt
include lexer
include ide_facts
include parser_ast
include parser_state
include parser_diagnostics
include parser_expr
include parser_stmt_control

func parse_generic_param_list(ref p: Parser):
    if check(p, TokType.Lt) do
        let lt_tok = peek(p)
        p = parse_error_loc(p, "legacy generic syntax '<...>' is not supported; use 'of (...)'", lt_tok.line, lt_tok.col)
        out (p, fat_str_new(""))
    end
    if is_tok_of(peek(p)) and p.pos + 1 < p.token_count and vec_get_rt(p.tokens, p.pos + 1).tok_type == TokType.LParen do
        var (p_of, _) = advance(p)   # consume 'of'
        var (p_lp, _) = advance(p_of) # consume '('
        p = p_lp
        var depth = 1
        var res = fat_str_new("")
        var first = true
        when not check(p, TokType.Eof) loop
            if check(p, TokType.LParen) do
                depth = depth + 1
            eif check(p, TokType.RParen) do
                depth = depth - 1
            end
            if depth == 1 and not check(p, TokType.LParen) and not check(p, TokType.RParen) and not check(p, TokType.Comma) and not check(p, TokType.Newline) do
                let tk = peek(p)
                if is_name_token(tk.tok_type) do
                    if not first do
                        res = fat_str_concat(res, fat_str_new(","))
                    end
                    res = fat_str_concat(res, tok_lex(tk))
                    first = false
                end
            end
            var (p2, _) = advance(p)
            p = p2
            if depth <= 0 do
                break
            end
        end
        out (p, res)
    end
    out (p, fat_str_new(""))
end.

# Skip a complete type expression without consuming the surrounding list or
# declaration delimiter.  This covers references, arrays, nested generics and
# function types such as `&Map<K,V>` and `func(K, K) -> bool`.
func skip_type_expr(ref p: Parser):
    paren_depth = 0
    bracket_depth = 0
    keep_going = true
    when keep_going and not check(p, TokType.Eof) loop
        t = peek(p).tok_type
        at_top = paren_depth == 0 and bracket_depth == 0
        # Never swallow a block `end` while recovering a type expression.
        if t == TokType.End do
            keep_going = false
        eif at_top and (t == TokType.Comma or t == TokType.Semicolon or t == TokType.Newline or t == TokType.RParen or t == TokType.Colon or t == TokType.Assign) do
            keep_going = false
        else
            if t == TokType.Lt do
                let lt_tok = peek(p)
                p = parse_error_loc(p, "legacy generic syntax '<...>' is not supported; use 'of (...)'", lt_tok.line, lt_tok.col)
                keep_going = false
            eif t == TokType.LParen do
                paren_depth = paren_depth + 1
            eif t == TokType.RParen and paren_depth > 0 do
                paren_depth = paren_depth - 1
            eif t == TokType.LBracket do
                bracket_depth = bracket_depth + 1
            eif t == TokType.RBracket and bracket_depth > 0 do
                bracket_depth = bracket_depth - 1
            end
            if keep_going do
                var (p2, _) = advance(p)
                p = p2
            end
        end
    end
    out p
end.

func parse_type_expr_string(ref p: Parser):
    paren_depth = 0
    bracket_depth = 0
    keep_going = true
    res = fat_str_new("")
    var last_was_tensor = false
    when keep_going and not check(p, TokType.Eof) loop
        t = peek(p).tok_type
        at_top = paren_depth == 0 and bracket_depth == 0
        # Never swallow a block `end` while recovering a type expression.
        if t == TokType.End do
            keep_going = false
        eif at_top and (t == TokType.Comma or t == TokType.Semicolon or t == TokType.Newline or t == TokType.RParen or t == TokType.Colon or t == TokType.Assign) do
            keep_going = false
        else
            if at_top and last_was_tensor and is_tok_of(peek(p)) do
                let of_tok = peek(p)
                p = parse_error_loc(p, "tensor is not a generic; use 'tensor[T; S...]', not 'tensor of (...)'", of_tok.line, of_tok.col)
                keep_going = false
            eif at_top and last_was_tensor and t == TokType.LParen do
                let lp_tok = peek(p)
                p = parse_error_loc(p, "tensor does not use '(...)' syntax; use 'tensor[T; S...]'", lp_tok.line, lp_tok.col)
                keep_going = false
            eif at_top and last_was_tensor and t == TokType.Lt do
                let lt_tok = peek(p)
                p = parse_error_loc(p, "legacy generic syntax '<...>' is not supported; use 'tensor[T; S...]'", lt_tok.line, lt_tok.col)
                keep_going = false
            eif t == TokType.Lt do
                let lt_tok = peek(p)
                p = parse_error_loc(p, "legacy generic syntax '<...>' is not supported; use 'of (...)'", lt_tok.line, lt_tok.col)
                keep_going = false
            eif t == TokType.LParen do
                paren_depth = paren_depth + 1
            eif t == TokType.RParen and paren_depth > 0 do
                paren_depth = paren_depth - 1
            eif t == TokType.LBracket do
                bracket_depth = bracket_depth + 1
            eif t == TokType.RBracket and bracket_depth > 0 do
                bracket_depth = bracket_depth - 1
            end
            if keep_going do
                let cur_tok = peek(p)
                let cur_t = cur_tok.tok_type
                let typeToken: int = cur_tok as int
                if g_ideFactsEnabled == 1 do
                    if is_name_token(native_read_i64(typeToken, 0) as TokType) do
                        let typeTokenSpan = native_read_i64(typeToken, 72)
                        let typeTokenLine = native_read_i64(typeToken, 8)
                        let typeTokenName: int = tok_lex(typeToken as Token) as int
                        let typeUse: int = ast_new(AstType.Identifier) as int
                        native_write_i64(typeUse, 0, typeTokenName)
                        native_write_i64(typeUse, 32, typeTokenLine)
                        native_write_i64(typeUse, 72, typeTokenSpan)
                        ideFactOrigin(typeUse, typeTokenSpan, typeTokenLine)
                        ideFactTypeUse(typeUse)
                    end
                end
                if cur_t == TokType.Arrow do
                    res = fat_str_concat(res, fat_str_new(" -> "))
                eif is_tok_of(cur_tok) do
                    if fat_str_len(res) > 0 and fat_str_byte_at(res, fat_str_len(res) - 1) != 32 do
                        res = fat_str_concat(res, fat_str_new(" "))
                    end
                    res = fat_str_concat(res, fat_str_new("of "))
                eif cur_t == TokType.Comma do
                    res = fat_str_concat(res, fat_str_new(", "))
                eif cur_t == TokType.Semicolon do
                    res = fat_str_concat(res, fat_str_new("; "))
                eif cur_t == TokType.Colon do
                    res = fat_str_concat(res, fat_str_new(": "))
                else
                    lex = tok_lex(cur_tok)
                    if fat_str_len(res) > 0 and fat_str_len(lex) > 0 do
                        let prev_ch = fat_str_byte_at(res, fat_str_len(res) - 1)
                        let next_ch = fat_str_byte_at(lex, 0)
                        let prev_is_word = (prev_ch >= 97 and prev_ch <= 122) or (prev_ch >= 65 and prev_ch <= 90) or (prev_ch >= 48 and prev_ch <= 57) or prev_ch == 95
                        let next_is_word = (next_ch >= 97 and next_ch <= 122) or (next_ch >= 65 and next_ch <= 90) or (next_ch >= 48 and next_ch <= 57) or next_ch == 95
                        if prev_is_word and next_is_word do
                            res = fat_str_concat(res, fat_str_new(" "))
                        end
                    end
                    res = fat_str_concat(res, lex)
                end
                if at_top and (cur_t == TokType.TensorKw or (is_name_token(cur_t) and fat_cstr_eq(tok_lex(cur_tok), "tensor") == 1)) do
                    last_was_tensor = true
                else
                    last_was_tensor = false
                end
                var (p2, _) = advance(p)
                p = p2
            end
        end
    end
    out (p, res)
end.

# Skip optional `out(TYPE)` / `out TYPE` return annotation (§6).
# Without this, `out(Vec):` is parsed as a body return statement.
func skip_out_return_type(ref p: Parser):
    if not check(p, TokType.Out) do
        out p
    end
    var (p2, _) = advance(p)
    if check(p2, TokType.LParen) do
        depth = 1
        var (p3, _) = advance(p2)
        p2 = p3
        when depth > 0 and not check(p2, TokType.Eof) loop
            if check(p2, TokType.LParen) do
                depth = depth + 1
            eif check(p2, TokType.RParen) do
                depth = depth - 1
            end
            var (p4, _) = advance(p2)
            p2 = p4
        end
        out p2
    end
    if is_name_token(peek(p2).tok_type) do
        var (p3, _) = advance(p2)
        p2 = p3
        p2 = skip_generic_list(p2)
    end
    out p2
end.

func is_param_group_out(ref p: Parser):
    let saved_pos = p.pos
    var (p_adv, _) = advance(p)
    p_adv = skip_newlines(p_adv)
    let tok1 = peek(p_adv)
    var is_out_grp = false
    if is_name_token(tok1.tok_type) do
        var (p_adv2, _) = advance(p_adv)
        p_adv2 = skip_newlines(p_adv2)
        let tok2 = peek(p_adv2)
        if tok2.tok_type == TokType.Colon do
            is_out_grp = true
        end
    eif tok1.tok_type == TokType.LParen do
        var (p_lp, _) = advance(p_adv)
        p_lp = skip_newlines(p_lp)
        let tok_in_p = peek(p_lp)
        if is_name_token(tok_in_p.tok_type) do
            var (p_lp2, _) = advance(p_lp)
            p_lp2 = skip_newlines(p_lp2)
            let tok_col = peek(p_lp2)
            if tok_col.tok_type == TokType.Colon do
                is_out_grp = true
            end
        end
    end
    p.pos = saved_pos
    out is_out_grp
end.

func is_orphan_param(ref p: Parser):
    let saved_pos = p.pos
    let tok1 = peek(p)
    var is_orph = false
    if is_name_token(tok1.tok_type) do
        var (p2, _) = advance(p)
        p2 = skip_newlines(p2)
        if check(p2, TokType.Colon) do
            var (p3, _) = advance(p2)
            p3 = skip_newlines(p3)
            let tok_t = peek(p3)
            if is_name_token(tok_t.tok_type) do
                var (p4, _) = advance(p3)
                let tok_sep = peek(p4)
                if tok_sep.tok_type == TokType.Newline or tok_sep.tok_type == TokType.Semicolon or tok_sep.tok_type == TokType.Comma or tok_sep.tok_type == TokType.End or tok_sep.tok_type == TokType.Eof do
                    is_orph = true
                end
            end
        end
    end
    p.pos = saved_pos
    out is_orph
end.
