##
 * compiler/src/frontend/parser/stmt_dispatch/try_stmt.vri — try statement parsing
 * VIRC-PLN-0010: helpers extracted from parse_statement_impl in compiler/src/frontend/parser/stmt_dispatch.vri.
 ##

include types_prelude
include rt_string_rt
include lexer
include ide_facts
include parser_ast
include parser_state
include parser_diagnostics
include parser_expr
include parser_stmt_control
include parser_stmt_decl
include parser_stmt_module

func parseTryStatement(ref p: Parser, t: Token) -> (Parser, AstNode):
    var (p2, _) = advance(p)
    n = ast_new(AstType.TryStmt)
    n.line = t.line
    # try(timeout: …) / try(isolate: […])
    if check(p2, TokType.LParen) do
        var (p3, _) = advance(p2)
        var seen_timeout = false
        var seen_isolate = false
        when not check(p3, TokType.RParen) and not check(p3, TokType.Eof) loop
            if check(p3, TokType.TimeoutKw) do
                if seen_timeout do
                    p3 = parse_error_code_at(p3, 3063, "duplicate timeout option in try (§13.7)", peek(p3).line)
                end
                seen_timeout = true
                var (p4, _) = advance(p3)
                var (p5, _, _) = expect_tok_code(p4, TokType.Colon, 3064, "expected ':' after timeout option (§13.7)")
                var (p6, tex) = parse_expr(p5)
                cl = ast_new(AstType.TimeoutClause)
                cl = ast_add_child(cl, tex)
                n = ast_add_child(n, cl)
                p3 = p6
            eif check(p3, TokType.IsolateKw) do
                if seen_isolate do
                    p3 = parse_error_code_at(p3, 3065, "duplicate isolate option in try (§13.7)", peek(p3).line)
                end
                seen_isolate = true
                var (p4, _) = advance(p3)
                var (p5, _, _) = expect_tok_code(p4, TokType.Colon, 3066, "expected ':' after isolate option (§13.7)")
                var (p6, iex) = parse_expr(p5)
                cl = ast_new(AstType.IsolateClause)
                cl = ast_add_child(cl, iex)
                n = ast_add_child(n, cl)
                p3 = p6
            else
                p3 = parse_error_code_at(p3, 3067, "unknown try option; expected timeout or isolate (§13.7)", peek(p3).line)
                var (p4, _) = advance(p3)
                p3 = p4
            end
            var (p_c, _) = match_tok(p3, TokType.Comma)
            p3 = p_c
        end
        var (p_rp, _, _) = expect_tok(p3, TokType.RParen, "expected ')' after try options")
        p2 = p_rp
    end
    var (p3, _, _) = expect_tok_code(p2, TokType.Colon, 3068, "expected ':' after try header (§13.7)")
    p3 = skip_newlines(p3)
    var (p4, body) = parse_block(p3)
    n = ast_add_child(n, body)
    if check(p4, TokType.RevertKw) do
        var (p5, _) = advance(p4)
        if check(p5, TokType.Colon) do
            p5 = parse_error_code_at(p5, 3056, "ensure/revert clauses must not use ':' (§13.7)", peek(p5).line)
            var (p5b, _) = advance(p5)
            p5 = p5b
        end
        p5 = skip_newlines(p5)
        var (p6, rev) = parse_block(p5)
        n = ast_add_child(n, rev)
        p4 = p6
    else
        p4 = parse_error_code_at(p4, 3069, "try requires a local revert clause (§13.7)", t.line)
    end
    var (p7, _, _) = expect_tok(p4, TokType.End, "expected 'end' after try")
    if check(p7, TokType.Dot) do
        p7 = parse_error_code_at(p7, 3070, "try is a control block and closes with 'end', not 'end.' (§13.7)", peek(p7).line)
        var (p8, _) = advance(p7)
        p7 = p8
    end
    out (p7, n)
end.
