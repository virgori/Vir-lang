##
 * compiler/src/frontend/parser/stmt_dispatch/concurrency.vri — select/recv/train/infer/await/arena/resume/isolate/lock/deck statements
 * VIRC-PLN-0010: helpers extracted from parse_statement_impl in compiler/src/frontend/parser/stmt_dispatch.vri.
 ##

include types_prelude
include rt_string_rt
include lexer
include ide_facts
include parser_ast
include parser_state
include parser_diagnostics
include parser_expr
include parser_stmt_control
include parser_stmt_decl
include parser_stmt_module

func parseSelectStatement(ref p: Parser, t: Token) -> (Parser, AstNode):
    var (p2, _) = advance(p)
    var (p3, _) = match_tok(p2, TokType.Colon)
    p3 = skip_newlines(p3)
    var (p4, body) = parse_block(p3)
    var (p5, _, _) = expect_tok(p4, TokType.End, "expected 'end' after select block")
    var (p6, _) = match_tok(p5, TokType.Dot)
    n = ast_new(AstType.SelectStmt)
    n.line = t.line
    n = ast_add_child(n, body)
    out (p6, n)
end.

func parseRecvStatement(ref p: Parser, t: Token) -> (Parser, AstNode):
    var (p2, _) = advance(p)
    var (p3, port_expr) = parse_expr(p2)
    n = ast_new(AstType.BuiltinCall)
    n.name = fat_str_new("__mir_recv")
    n.line = t.line
    n.builtin_id = 33;  # MIR_INTR_RECV
    n = ast_add_child(n, port_expr)
    out (p3, n)
end.

