##
 * compiler/src/frontend/parser/ast.vri — AST Node Types & Allocator
 * ================================================================
 ##

include types
include result
include vec_rt
include rt.alloc
import vir_alloc, page_alloc from rt.alloc
include ide_facts
import ideFactTypeUse, g_ideFactsEnabled, ideFactOrigin, ideFactFind, ideFactSetProjection, ideFactScopeEnd from compiler.ide_facts

extern func native_read_i64(addr: int, offset: int) -> int
extern func native_write_i64(addr: int, offset: int, val: int) -> int
extern func native_write_u8(addr: int, offset: int, val: int) -> int


# ═══════════════════════════════════════════════════════
# AST Node Types
# ═══════════════════════════════════════════════════════

enum AstType:
    Program         = 0
    Block           = 1
    FuncDef         = 2
    VarDecl         = 3
    ConstDecl       = 4
    Assign          = 5
    IndexAssign     = 6
    FieldAssign     = 7
    IfStmt          = 8
    LoopStmt        = 9
    WhileStmt       = 10
    ForRange        = 11
    ReturnStmt      = 12
    PrintStmt       = 13
    BreakStmt       = 14
    ContinueStmt    = 15
    EnumDef         = 16
    EntityDef       = 17
    ImportStmt      = 18
    ModuleStmt      = 19
    ExportStmt      = 20
    IncludeStmt     = 21
    ParamDef        = 22
    RangeExpr       = 23
    LiteralInt      = 30
    LiteralFloat    = 31
    LiteralStr      = 32
    Identifier      = 33
    BinOp           = 34
    Compare         = 35
    Call            = 36
    BuiltinCall     = 37
    InputExpr       = 38
    ArrayLiteral    = 39
    IndexAccess     = 40
    FieldAccess     = 41
    EnumAccess      = 42
    EntityLiteral   = 43
    CheckCpu        = 50
    PatchPoint      = 51
    ExternFunc      = 52
    WhenStmt        = 53
    CastExpr        = 54
    UnaryMinus      = 55
    ExprIndex       = 56
    TupleExpr       = 57
    # Phase 8: New language features
    ThrowStmt       = 58
    EnsureBlock     = 59
    RevertBlock     = 60
    InterpExpr      = 61
    MethodCall      = 62
    PackedDef       = 63
    RegisterDef     = 64
    BindAttr        = 65
    RefParam        = 66
    CaseExpr        = 67
    # Resolved enum variant construction.  The parser initially emits Call /
    # Identifier; semantic pass 3 rewrites those nodes once variants are known.
    EnumConstruct   = 118
    # §22 / §4.5 additions (Phase 7.2 parity)
    ArenaBlock      = 68
    AwaitExpr       = 69
    CancelStmt      = 70
    QuietStmt       = 71
    NamedArg        = 72
    AddrOf          = 73
    UnaryNot        = 74;   # bitwise `~` → MirOp.Not
    SwizzleExpr     = 75;   # postfix v~mask → MIR_INTR_SWIZZLE
    SafeAccessExpr  = 76;   # a?.b → MIR_INTR_SAFE_ACCESS
    EmitStmt        = 77
    ErxExpr         = 78
    TaskExpr        = 79
    WaitExpr        = 80
    SelectStmt      = 81
    TryStmt         = 82
    ResumeStmt      = 83
    InferBlock      = 84
    TrainBlock      = 85
    QuantizeExpr    = 86
    # Spec §29 keyword surface (parser layer — MIR later)
    TypeAlias       = 87
    LazyIncludeStmt = 88
    ShareDecl       = 89
    HasDecl         = 90
    ClassDef        = 91
    DictDecl        = 92
    PrecompBlock    = 93
    ReactiveDecl    = 94
    MorphDecl       = 95
    BundleExpr      = 96
    ExposeAttr      = 97
    TensorDecl      = 98
    FluxDecl        = 99
    MapExpr         = 100
    ArrCompactExpr  = 101
    PtrTypeExpr     = 102
    AtomicVarDecl   = 103
    ExistExpr       = 104;   # postfix `?`
    PatternExpr     = 105;   # `a :~ b`
    ErrorExpr       = 106
    TimeoutClause   = 107;   # child of TryStmt
    IsolateClause   = 108;   # child of TryStmt
    PortDecl        = 109;   # Spec §23 port declaration
    SendStmt        = 110;   # Spec §23 send port <- msg
    RecvExpr        = 111,   # Spec §23 recv port
    AwaitPass       = 112,   # Spec §22 await pass
    LiteralBool     = 113,   # Spec §4.3 boolean literal (true / false)
    LiteralNone     = 114,   # Spec §4.3 null literal (none)
    DictLiteral     = 115,   # Spec §4.3 dictionary literal ([k: v, ...])
    PercentExpr     = 116,   # Spec §10.1 postfix percent (e.g. 10% == 0.1)
    SizeofExpr      = 117,   # Spec §4.4 / §7.3 sizeof(Type) operator
    OutParam        = 119,   # Spec §14 parameter mode Out
    SwizzleAssign   = 120,   # Spec §24.2 swizzle write-mask: v~mask = expr
    VarDeclGroup    = 121    # Grouped var/let/const declaration list
end.

enum ParamMode:
    In  = 0
    Ref = 1
    Out = 2
end.
# ═══════════════════════════════════════════════════════
# Operator Types
# ═══════════════════════════════════════════════════════

enum OpType:
    Add     = 0
    Sub     = 1
    Mul     = 2
    Div     = 3
    ModOp   = 4
    Eq      = 10
    Ne      = 11
    Gt      = 12
    Lt      = 13
    Ge      = 14
    Le      = 15
    AndOp   = 20
    OrOp    = 21
    XorOp   = 22
    ShlOp   = 23
    ShrOp   = 24
    PowOp   = 25
    Land    = 26;   # boolean `and` — short-circuit CFG
    Lor     = 27;   # boolean `or`  — short-circuit CFG
    MatMulOp = 28;  # ** tensor/matmul (§26.2)
    FmaOp    = 29;  # >< fused multiply-add (§26.2)
    SafeEq   = 30;  # ?=
    SafeNe   = 31;  # ?=/=
    PatternOp = 32;  # :~
    PercentOp = 33  # % percent (not mod) — Spec §10.1
end.
# ═══════════════════════════════════════════════════════
# AST Node
# ═══════════════════════════════════════════════════════

entity AstNode:
    name:           string,
    name2:          string,
    node_type:      AstType,
    op:             OpType,
    line:           int,
    int_val:        int,
    float_val:      float,
    builtin_id:     int,
    children:       int,
    span_id:        int
end.

# Bump-pointer AST arena: one slab for child vecs + node handle log (reset per parse).
const AST_BUMP_BYTES: int = 8388608
# Runtime feature toggle: keeping this mutable avoids dead-branch diagnostics
# while the bump allocator remains available for benchmarking/rollout.
var AST_BUMP_ENABLED: int = 0
const VEC_RT_HEADER: int = 16
const VEC_RT_INIT_CAP: int = 16
const VEC_RT_ELEM: int = 8

var g_ast_bump_mem: i64 = 0
var g_ast_bump_pos: int = 0
var g_ast_empty_name: i64 = 0

func ast_bump_align(pos: int):
    rem = pos mod 8
    if rem != 0 do out pos + (8 - rem) end
    out pos
end.

func ast_vec_bump_alloc(cap: int):
    if g_ast_bump_mem == 0 do out 0 end
    need = VEC_RT_HEADER + cap * VEC_RT_ELEM
    g_ast_bump_pos = ast_bump_align(g_ast_bump_pos)
    if g_ast_bump_pos + need > AST_BUMP_BYTES do out 0 end
    base = g_ast_bump_mem + g_ast_bump_pos
    g_ast_bump_pos = g_ast_bump_pos + need
    data = base + VEC_RT_HEADER
    native_write_i64(base, 0, cap)
    native_write_i64(base, 8, 0)
    out data
end.

func ast_vec_bump_new():
    data = ast_vec_bump_alloc(VEC_RT_INIT_CAP)
    if data == 0 do out vec_new_rt() end
    out data
end.

func ast_vec_is_bump(v: int):
    if v == 0 or g_ast_bump_mem == 0 do out false end
    out v >= g_ast_bump_mem + VEC_RT_HEADER and v < g_ast_bump_mem + AST_BUMP_BYTES
end.

# vec_push_rt cannot grow an interior slab pointer with vir_realloc.  Grow
# bump-backed child vectors into a fresh slab slice; if the slab is full,
# copy into a normal heap vector and let vec_rt own future growth.
func ast_vec_push(v: int, val: int):
    if not ast_vec_is_bump(v) do out vec_push_rt(v, val) end
    len = native_read_i64(v - 8, 0)
    cap = native_read_i64(v - VEC_RT_HEADER, 0)
    if len < cap do
        native_write_i64(v, len * VEC_RT_ELEM, val)
        native_write_i64(v - 8, 0, len + 1)
        out v
    end

    new_cap = cap * 2
    if new_cap < VEC_RT_INIT_CAP do new_cap = VEC_RT_INIT_CAP end
    new_v = ast_vec_bump_alloc(new_cap)
    if new_v == 0 do
        new_v = vec_new_rt()
        i = 0
        when i < len loop
            new_v = vec_push_rt(new_v, native_read_i64(v, i * VEC_RT_ELEM))
            i = i + 1
        end
        out vec_push_rt(new_v, val)
    end

    i = 0
    when i < len loop
        native_write_i64(new_v, i * VEC_RT_ELEM, native_read_i64(v, i * VEC_RT_ELEM))
        i = i + 1
    end
    native_write_i64(new_v - 8, 0, len)
    native_write_i64(new_v, len * VEC_RT_ELEM, val)
    native_write_i64(new_v - 8, 0, len + 1)
    out new_v
end.

func ast_arena_begin():
    if g_ast_empty_name == 0 do
        g_ast_empty_name = fat_str_new("")
    end
    if AST_BUMP_ENABLED == 1 and g_ast_bump_mem == 0 do
        g_ast_bump_mem = vir_alloc(AST_BUMP_BYTES)
    end
    if AST_BUMP_ENABLED == 0 do g_ast_bump_mem = 0 end
    g_ast_bump_pos = 0
end.

func ast_arena_end():
    g_ast_bump_pos = 0
end.

func ast_new(typ: AstType):
    # Most AST nodes are leaves.  Allocate their child vector lazily in
    # ast_add_child instead of reserving 16 slots for every literal/name.
    # Empty node names are immutable, so all nodes can share one fat header.
    if g_ast_empty_name == 0 do
        g_ast_empty_name = fat_str_new("")
    end
    p = vir_alloc(80)
    native_write_i64(p, 0, g_ast_empty_name)
    native_write_i64(p, 8, g_ast_empty_name)
    native_write_i64(p, 16, typ as int)
    native_write_i64(p, 24, OpType.Add as int)
    native_write_i64(p, 32, 0)
    native_write_i64(p, 40, 0)
    native_write_i64(p, 48, 0)
    native_write_i64(p, 56, 0)
    native_write_i64(p, 64, 0)
    native_write_i64(p, 72, 0)
    out p as AstNode
end.

func ast_set_span(node: AstNode, span_id: int):
    native_write_i64(node as i64, 72, span_id)
end.

func ast_get_span(node: AstNode):
    out native_read_i64(node as i64, 72)
end.

func ast_new_tok(typ: AstType, tok: Token):
    let n = ast_new(typ)
    n.line = tok.line
    native_write_i64(n as i64, 72, tok.span_id)
    out n
end.

func ast_add_child(parent: AstNode, child: AstNode):
    # Soft ABI: nested CALL (vec_new_rt / vec_push_rt) can clobber entity
    # fields on the parent handle. Save/restore raw 64-bit words directly
    # without allocating temporary heap string headers.
    let p_ptr = parent as i64
    let s_name = native_read_i64(p_ptr, 0)
    let s_name2 = native_read_i64(p_ptr, 8)
    let s_type = native_read_i64(p_ptr, 16)
    let s_op = native_read_i64(p_ptr, 24)
    let s_line = native_read_i64(p_ptr, 32)
    let s_int = native_read_i64(p_ptr, 40)
    let s_float = native_read_i64(p_ptr, 48)
    let s_bid = native_read_i64(p_ptr, 56)
    var kids = native_read_i64(p_ptr, 64)
    let s_span = native_read_i64(p_ptr, 72)
    if kids == 0 do
        if AST_BUMP_ENABLED == 0 do
            kids = vec_new_rt()
        else
            kids = ast_vec_bump_new()
        end
    end
    if AST_BUMP_ENABLED == 0 do
        kids = vec_push_rt(kids, child)
    else
        kids = ast_vec_push(kids, child)
    end
    native_write_i64(p_ptr, 0, s_name)
    native_write_i64(p_ptr, 8, s_name2)
    native_write_i64(p_ptr, 16, s_type)
    native_write_i64(p_ptr, 24, s_op)
    native_write_i64(p_ptr, 32, s_line)
    native_write_i64(p_ptr, 40, s_int)
    native_write_i64(p_ptr, 48, s_float)
    native_write_i64(p_ptr, 56, s_bid)
    native_write_i64(p_ptr, 64, kids)
    native_write_i64(p_ptr, 72, s_span)
    out parent
end.
