##
 * compiler/src/frontend/parser.vri — Parser Subsystem Orchestrator & Entry Point
 * ==============================================================================
 * VIRC-PLN-0004 Phase 10 / VIRC-ISS-0006: Modularized Parser Subsystem.
 ##

include types_prelude
include rt_string_rt

include rt_vec_rt


include parser_ast
include parser_builtins
include parser_state
include parser_diagnostics
include parser_expr
include parser_stmt_control
include parser_stmt_decl
include parser_stmt_module
include parser_stmt_dispatch

# ═══════════════════════════════════════════════════════
# Top-Level Entry Point
# ═══════════════════════════════════════════════════════

func parse_program(ref p: Parser):

    ast_arena_begin()
    prog = ast_new(AstType.Program)
    p = skip_newlines(p)

    when not check(p, TokType.Eof) loop
        let old_pos = p.pos
        var (p2, stmt) = parse_statement(p)
        if p2.pos == old_pos and rt_strlen(p2.error_msg) == 0 do
            # Forced progress if parse_statement failed to consume any token
            var (p_adv, _) = advance(p)
            p = p_adv
        eif rt_strlen(p2.error_msg) > 0 do
            # Keep all structured errors, then resume at the next declaration.
            # The first error line remains the driver's failure flag.
            p = p2
            if p.pos <= old_pos do
                var (p_adv, _) = advance(p)
                p = p_adv
            end
            p.error_msg = ""
            when not check(p, TokType.Eof) and not check(p, TokType.Func) and not check(p, TokType.Enum) and not check(p, TokType.Entity) and not check(p, TokType.Const) and not check(p, TokType.Var) and not check(p, TokType.Extern) and not check(p, TokType.Import) loop
                var (p3, _) = advance(p)
                p = p3
            end
        else
            p = p2
            if stmt.node_type == AstType.VarDeclGroup do
                var vi = 0
                when vi < vec_len_rt(stmt.children) loop
                    prog = ast_add_child(prog, vec_get_rt(stmt.children, vi))
                    vi = vi + 1
                end
            else
                prog = ast_add_child(prog, stmt)
            end
        end
        # Skip optional trailing semicolons at top level
        when check(p, TokType.Semicolon) loop
            var (p_semi, _) = advance(p)
            p = p_semi
        end
        p = skip_newlines(p)
    end

    ast_arena_end()
    out (p, prog)
end.

