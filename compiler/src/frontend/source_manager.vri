##
 * vir/compiler/source_manager.vri — Source Origin & Source Manager
 * ==============================================================
 * Single source of truth for physical and logical source locations,
 * mapping preprocessed / expanded text back to pre-include origins.
 ##

include types_prelude
import fat_str_new, fat_str_len, fat_str_byte_at, fat_str_eq, str_from_cstr from rt_string_rt
import vir_alloc from rt_alloc
import vec_new_rt, vec_push_rt, vec_get_rt, vec_len_rt from rt_vec_rt

extern func native_read_u8(addr: int, offset: int) -> int
extern func native_write_u8(addr: int, offset: int, val: int)
extern func native_read_i64(addr: int, offset: int) -> int
extern func native_write_i64(addr: int, offset: int, val: int)

entity SourceFile:
    file_id:        int,
    display_path:   string,
    canonical_path: string,
    src_content:    int,
    line_count:     int,
    line_starts:    int
end.

entity SourceLocation:
    file_id:        int,
    byte_offset:    int
end.

entity ExpansionFrame:
    kind:           int, # 1: include, 2: import, 3: generated
    call_site:      int, # SourceSpan id
    definition:     int, # SourceSpan id
    parent:         int  # ExpansionFrame id
end.

entity SourceMapSegment:
    expanded_start_line: int,
    expanded_end_line:   int,
    original_file_id:    int,
    original_start_line: int,
    expanded_start_byte: int,
    expanded_end_byte:   int,
    original_start_byte: int,
    expansion_frame_id:  int
end.

entity SourceSpan:
    file_id:       int,
    start_line:    int,
    start_col:     int,
    end_line:      int,
    end_col:       int,
    start_offset:  int,
    end_offset:    int,
    expansion_id:  int
end.

entity SourceManager:
    files:            int,
    segments:         int,
    spans:            int,
    expansion_frames: int
end.

var g_active_source_manager: i64 = 0

func sm_new():
    let sm = vir_alloc(32)
    var spans = vec_new_rt()
    spans = vec_push_rt(spans, 0); # span id 0 is invalid
    var frames = vec_new_rt()
    frames = vec_push_rt(frames, 0); # frame id 0 is invalid
    native_write_i64(sm, 0, vec_new_rt())
    native_write_i64(sm, 8, vec_new_rt())
    native_write_i64(sm, 16, spans)
    native_write_i64(sm, 24, frames)
    out sm
end.

func sm_register_file(sm: i64, display_path: string, canonical_path: string):
    if sm == 0 do out 0 end
    let files = native_read_i64(sm, 0)
    let n = vec_len_rt(files)
    if n > 0 do
        let last_f = vec_get_rt(files, n - 1)
        if fat_str_eq(native_read_i64(last_f, 8) as string, display_path) == 1 do
            out n - 1
        end
    end
    var i = n - 2
    when i >= 0 loop
        let f = vec_get_rt(files, i)
        let cur_disp = native_read_i64(f, 8) as string
        if fat_str_eq(cur_disp, display_path) == 1 do
            out i
        end
        i = i - 1
    end
    let f_obj = vir_alloc(48)
    native_write_i64(f_obj, 0, n)
    native_write_i64(f_obj, 8, display_path as i64)
    native_write_i64(f_obj, 16, canonical_path as i64)
    native_write_i64(f_obj, 24, 0)
    native_write_i64(f_obj, 32, 0)
    var ls = vec_new_rt()
    ls = vec_push_rt(ls, 0); # 1-based indexing: index 0 unused
    ls = vec_push_rt(ls, 0); # line 1 starts at byte 0
    native_write_i64(f_obj, 40, ls)
    let new_files = vec_push_rt(files, f_obj)
    native_write_i64(sm, 0, new_files)
    out n
end.

func sm_file_compute_line_starts(sm: i64, file_id: int, source_str: string):
    if sm == 0 do out 0 end
    let files = native_read_i64(sm, 0)
    let n = vec_len_rt(files)
    if file_id < 0 or file_id >= n do out 0 end
    let f = vec_get_rt(files, file_id)
    let data = native_read_i64(source_str as i64, 0)
    let slen = native_read_i64(source_str as i64, 8)
    var ls = vec_new_rt()
    ls = vec_push_rt(ls, 0); # index 0 unused (1-based lines)
    ls = vec_push_rt(ls, 0); # line 1 starts at byte 0
    var line_count = 1
    var p = 0
    when p < slen loop
        if native_read_u8(data, p) == 10 do
            line_count = line_count + 1
            ls = vec_push_rt(ls, p + 1)
        end
        p = p + 1
    end
    native_write_i64(f, 24, source_str as i64)
    native_write_i64(f, 32, line_count)
    native_write_i64(f, 40, ls)
    out 0
end.

func sm_line_col_from_byte_offset(sm: i64, file_id: int, byte_offset: int):
    if sm == 0 or file_id < 0 do out (1, 1) end
    let files = native_read_i64(sm, 0)
    let n = vec_len_rt(files)
    if file_id >= n do out (1, 1) end
    let f = vec_get_rt(files, file_id)
    let ls = native_read_i64(f, 40)
    if ls == 0 do out (1, 1) end
    let num_lines = vec_len_rt(ls) - 1
    if num_lines <= 1 do out (1, byte_offset + 1) end
    var low = 1
    var high = num_lines
    var best = 1
    when low <= high loop
        let mid = (low + high) / 2
        let off = vec_get_rt(ls, mid)
        if off <= byte_offset do
            best = mid
            low = mid + 1
        else
            high = mid - 1
        end
    end
    let line_start_off = vec_get_rt(ls, best)
    let col = byte_offset - line_start_off + 1
    out (best, col)
end.

func sm_col_from_byte_offset(sm: i64, file_id: int, byte_offset: int):
    if sm == 0 or file_id < 0 do out 1 end
    let files = native_read_i64(sm, 0)
    let n = vec_len_rt(files)
    if file_id >= n do out 1 end
    let f = vec_get_rt(files, file_id)
    let ls = native_read_i64(f, 40)
    if ls == 0 do out 1 end
    let num_lines = vec_len_rt(ls) - 1
    if num_lines <= 1 do out byte_offset + 1 end
    var low = 1
    var high = num_lines
    var best = 1
    when low <= high loop
        let mid = (low + high) / 2
        let off = vec_get_rt(ls, mid)
        if off <= byte_offset do
            best = mid
            low = mid + 1
        else
            high = mid - 1
        end
    end
    let line_start_off = vec_get_rt(ls, best)
    let col = byte_offset - line_start_off + 1
    if col <= 0 do out 1 end
    out col
end.

func sm_byte_offset_from_line_col(sm: i64, file_id: int, line: int, col: int):
    if sm == 0 or file_id < 0 do out 0 end
    let files = native_read_i64(sm, 0)
    let n = vec_len_rt(files)
    if file_id >= n do out 0 end
    let f = vec_get_rt(files, file_id)
    let ls = native_read_i64(f, 40)
    if ls == 0 do out 0 end
    let num_lines = vec_len_rt(ls) - 1
    var target_line = line
    if target_line < 1 do target_line = 1 end
    if target_line > num_lines do target_line = num_lines end
    let line_start = vec_get_rt(ls, target_line)
    var c = col
    if c < 1 do c = 1 end
    out line_start + (c - 1)
end.

func sm_get_file_path(sm: i64, file_id: int):
    if sm == 0 do out 0 end
    let files = native_read_i64(sm, 0)
    let n = vec_len_rt(files)
    if file_id < 0 or file_id >= n do
        out 0
    end
    let f = vec_get_rt(files, file_id)
    let fat = native_read_i64(f, 8)
    if fat == 0 do out 0 end
    out native_read_i64(fat, 0)
end.

func sm_add_segment_ex(sm: i64, exp_start: int, exp_end: int, orig_fid: int, orig_start: int, exp_s_byte: int, exp_e_byte: int, orig_s_byte: int, exp_frame_id: int):
    if sm == 0 do out 0 end
    let segs = native_read_i64(sm, 8)
    let seg = vir_alloc(64)
    native_write_i64(seg, 0, exp_start)
    native_write_i64(seg, 8, exp_end)
    native_write_i64(seg, 16, orig_fid)
    native_write_i64(seg, 24, orig_start)
    native_write_i64(seg, 32, exp_s_byte)
    native_write_i64(seg, 40, exp_e_byte)
    native_write_i64(seg, 48, orig_s_byte)
    native_write_i64(seg, 56, exp_frame_id)
    let new_segs = vec_push_rt(segs, seg)
    native_write_i64(sm, 8, new_segs)
    out 0
end.

func sm_add_segment(sm: i64, exp_start: int, exp_end: int, orig_fid: int, orig_start: int):
    out sm_add_segment_ex(sm, exp_start, exp_end, orig_fid, orig_start, 0, 0, 0, 0)
end.

func sm_find_segment(sm: i64, exp_line: int):
    if sm == 0 do out 0 - 1 end
    let segs = native_read_i64(sm, 8)
    let count = vec_len_rt(segs)
    if count <= 0 do out 0 - 1 end
    var low = 0
    var high = count - 1
    var best = 0 - 1
    when low <= high loop
        let mid = (low + high) / 2
        let seg = vec_get_rt(segs, mid)
        let s_start = native_read_i64(seg, 0)
        let s_end = native_read_i64(seg, 8)
        if exp_line >= s_start and exp_line <= s_end do
            out mid
        eif exp_line < s_start do
            high = mid - 1
        else
            best = mid
            low = mid + 1
        end
    end
    out best
end.

func sm_file_from_line(sm: i64, exp_line: int):
    let s_idx = sm_find_segment(sm, exp_line)
    if s_idx < 0 do out 0 end
    let segs = native_read_i64(sm, 8)
    let seg = vec_get_rt(segs, s_idx)
    out native_read_i64(seg, 16)
end.

func sm_line_from_expanded(sm: i64, exp_line: int):
    let s_idx = sm_find_segment(sm, exp_line)
    if s_idx < 0 do out exp_line end
    let segs = native_read_i64(sm, 8)
    let seg = vec_get_rt(segs, s_idx)
    let s_start = native_read_i64(seg, 0)
    let orig_start = native_read_i64(seg, 24)
    out orig_start + (exp_line - s_start)
end.

func sm_add_span_ex(sm: i64, fid: int, s_line: int, s_col: int, e_line: int, e_col: int, s_off: int, e_off: int, exp_id: int):
    if sm == 0 do out 0 end
    let spans = native_read_i64(sm, 16)
    let n = vec_len_rt(spans)
    let sp = vir_alloc(64)
    native_write_i64(sp, 0, fid)
    native_write_i64(sp, 8, s_line)
    native_write_i64(sp, 16, s_col)
    native_write_i64(sp, 24, e_line)
    native_write_i64(sp, 32, e_col)
    native_write_i64(sp, 40, s_off)
    native_write_i64(sp, 48, e_off)
    native_write_i64(sp, 56, exp_id)
    let new_spans = vec_push_rt(spans, sp)
    native_write_i64(sm, 16, new_spans)
    out n
end.

func sm_add_span(sm: i64, fid: int, s_line: int, s_col: int, e_line: int, e_col: int):
    var s_off = 0
    var e_off = 0
    if sm != 0 do
        s_off = sm_byte_offset_from_line_col(sm, fid, s_line, s_col)
        e_off = sm_byte_offset_from_line_col(sm, fid, e_line, e_col)
    end
    out sm_add_span_ex(sm, fid, s_line, s_col, e_line, e_col, s_off, e_off, 0)
end.

func sm_add_expansion_frame(sm: i64, kind: int, call_site: int, definition: int, parent: int):
    if sm == 0 do out 0 end
    let frames = native_read_i64(sm, 24)
    let n = vec_len_rt(frames)
    let ef = vir_alloc(32)
    native_write_i64(ef, 0, kind)
    native_write_i64(ef, 8, call_site)
    native_write_i64(ef, 16, definition)
    native_write_i64(ef, 24, parent)
    let new_frames = vec_push_rt(frames, ef)
    native_write_i64(sm, 24, new_frames)
    out n
end.

func sm_get_expansion_frame(sm: i64, frame_id: int):
    if sm == 0 or frame_id <= 0 do out 0 end
    let frames = native_read_i64(sm, 24)
    let n = vec_len_rt(frames)
    if frame_id >= n do out 0 end
    out vec_get_rt(frames, frame_id)
end.

func sm_get_span(sm: i64, span_id: int):
    if sm == 0 or span_id <= 0 do out 0 end
    let spans = native_read_i64(sm, 16)
    let n = vec_len_rt(spans)
    if span_id >= n do out 0 end
    out vec_get_rt(spans, span_id)
end.

func sm_build_from_source(sm: i64, source: string, main_file: int):
    if sm == 0 do out 0 end
    let data = native_read_i64(source as i64, 0)
    let n = native_read_i64(source as i64, 8)
    if n <= 0 do out 0 end

    let main_fat = str_from_cstr(main_file)
    let main_fid = sm_register_file(sm, main_fat, main_fat)

    var cur_fid = main_fid
    var cur_orig_start = 1
    var cur_exp_start = 1
    var pos = 0
    var cur_line = 1
    var has_markers = 0

    when pos < n loop
        let line_start = pos
        when pos < n and native_read_u8(data, pos) != 10 loop
            pos = pos + 1
        end
        let line_end = pos

        var is_marker = 0
        if line_end - line_start >= 15 do
            if native_read_u8(data, line_start) == 35 and native_read_u8(data, line_start + 1) == 32 and native_read_u8(data, line_start + 2) == 64 and native_read_u8(data, line_start + 3) == 118 and native_read_u8(data, line_start + 4) == 105 and native_read_u8(data, line_start + 5) == 114 and native_read_u8(data, line_start + 6) == 95 and native_read_u8(data, line_start + 7) == 115 and native_read_u8(data, line_start + 8) == 111 and native_read_u8(data, line_start + 9) == 117 and native_read_u8(data, line_start + 10) == 114 and native_read_u8(data, line_start + 11) == 99 and native_read_u8(data, line_start + 12) == 101 and native_read_u8(data, line_start + 13) == 32 do
                is_marker = 1
            end
        end

        if is_marker == 1 do
            has_markers = 1
            if cur_exp_start <= cur_line - 1 do
                sm_add_segment(sm, cur_exp_start, cur_line - 1, cur_fid, cur_orig_start)
            end

            var p_start = line_start + 14
            when p_start < line_end and native_read_u8(data, p_start) == 32 loop
                p_start = p_start + 1
            end

            var p_end = p_start
            var orig_line = 1
            if p_start < line_end and native_read_u8(data, p_start) == 34 do
                p_start = p_start + 1
                p_end = p_start
                when p_end < line_end and native_read_u8(data, p_end) != 34 loop
                    p_end = p_end + 1
                end
                var l_pos = p_end + 1
                when l_pos < line_end and native_read_u8(data, l_pos) == 32 loop
                    l_pos = l_pos + 1
                end
                orig_line = 0
                when l_pos < line_end loop
                    let c = native_read_u8(data, l_pos)
                    if c >= 48 and c <= 57 do
                        orig_line = orig_line * 10 + c - 48
                    end
                    l_pos = l_pos + 1
                end
            else
                var last_sp = line_end - 1
                when last_sp > p_start and native_read_u8(data, last_sp) != 32 loop
                    last_sp = last_sp - 1
                end
                p_end = last_sp
                orig_line = 0
                var l_pos = last_sp + 1
                when l_pos < line_end loop
                    let c = native_read_u8(data, l_pos)
                    if c >= 48 and c <= 57 do
                        orig_line = orig_line * 10 + c - 48
                    end
                    l_pos = l_pos + 1
                end
            end

            if orig_line <= 0 do orig_line = 1 end
            let path_len = p_end - p_start
            let path_buf = vir_alloc(path_len + 1)
            var pi = 0
            when pi < path_len loop
                native_write_u8(path_buf, pi, native_read_u8(data, p_start + pi))
                pi = pi + 1
            end
            native_write_u8(path_buf, path_len, 0)
            let path_fat = str_from_cstr(path_buf)
            cur_fid = sm_register_file(sm, path_fat, path_fat)
            cur_orig_start = orig_line
            cur_exp_start = cur_line + 1
        end

        if pos < n and native_read_u8(data, pos) == 10 do
            pos = pos + 1
        end
        cur_line = cur_line + 1
    end

    if cur_exp_start <= cur_line do
        sm_add_segment(sm, cur_exp_start, cur_line, cur_fid, cur_orig_start)
    end
    if has_markers == 0 do
        sm_add_segment(sm, 1, cur_line, main_fid, 1)
    end
    sm_file_compute_line_starts(sm, main_fid, source)
    out 0
end.

export SourceFile, SourceLocation, SourceSpan, ExpansionFrame, SourceMapSegment, SourceManager, g_active_source_manager,
       sm_new, sm_register_file, sm_get_file_path, sm_add_segment, sm_add_segment_ex, sm_find_segment,
       sm_file_from_line, sm_line_from_expanded, sm_add_span, sm_add_span_ex, sm_get_span,
       sm_add_expansion_frame, sm_get_expansion_frame,
       sm_file_compute_line_starts, sm_line_col_from_byte_offset, sm_col_from_byte_offset, sm_byte_offset_from_line_col,
       sm_build_from_source
