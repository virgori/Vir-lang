# Keyword Lookup Table
# ═══════════════════════════════════════════════════════

entity KeywordEntry:
    word:   string,
        tok:    TokType
end.
func kw_entry(word: string, tok: TokType):
    p = alloc(16)
    native_write_i64(p, 0, word as i64)
    native_write_i64(p, 8, tok as int)
    out p as KeywordEntry
end.
