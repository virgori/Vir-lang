# Keyword lookup index.  The old path scanned all ~100 keywords for every
# source word.  Bucket by first byte + length so a lookup normally compares
# only one or two candidates while keeping the table as the source of truth.
const KW_LEN_SLOTS: int = 32
const KW_BUCKET_COUNT: int = 8192
const KW_MAX_ENTRIES: int = 256
var g_kw_bucket_head: i64 = 0
var g_kw_bucket_next: i64 = 0

func keyword_bucket_build(table: &Vec of (KeywordEntry)):
    if g_kw_bucket_head == 0 do
        g_kw_bucket_head = vir_alloc(KW_BUCKET_COUNT * 8)
    end
    if g_kw_bucket_next == 0 do
        g_kw_bucket_next = vir_alloc(KW_MAX_ENTRIES * 8)
    end

    var i = 0
    when i < KW_BUCKET_COUNT loop
        native_write_i64(g_kw_bucket_head, i * 8, 0)
        i = i + 1
    end

    count = vec_len(table)
    i = 0
    when i < count and i < KW_MAX_ENTRIES loop
        entry = vec_get(table, i)
        word_len = fat_str_len(entry.word)
        if word_len > 0 and word_len < KW_LEN_SLOTS do
            first = fat_str_byte_at(entry.word, 0)
            key = first * KW_LEN_SLOTS + word_len
            head = native_read_i64(g_kw_bucket_head, key * 8)
            native_write_i64(g_kw_bucket_next, i * 8, head)
            native_write_i64(g_kw_bucket_head, key * 8, i + 1)
        end
        i = i + 1
    end
end.

func build_keyword_table:
    table = vec_new()
    table = kw_table_part1(table)
    table = kw_table_part2(table)
    keyword_bucket_build(table)
    out table
end.
# Zero-copy keyword match: compare lexeme span in source buffer (no substring alloc).
func lookup_keyword_span(table: &Vec of (KeywordEntry), source: &string, start: int, span_len: int):
    if span_len <= 0 do out TokType.Error end
    if span_len >= KW_LEN_SLOTS or g_kw_bucket_head == 0 or g_kw_bucket_next == 0 do
        i = 0
        when i < vec_len(table) loop
            entry = vec_get(table, i)
            if fat_str_len(entry.word) == span_len do
                if fat_str_eq_span(source, start, span_len, entry.word) do out entry.tok end
            end
            i = i + 1
        end
        out TokType.Error
    end
    first = fat_str_byte_at(source, start)
    key = first * KW_LEN_SLOTS + span_len
    link = native_read_i64(g_kw_bucket_head, key * 8)
    when link > 0 loop
        i = link - 1
        entry = vec_get(table, i)
        if fat_str_eq_span(source, start, span_len, entry.word) do
            out entry.tok
        end
        link = native_read_i64(g_kw_bucket_next, i * 8)
    end
    # Runtime keyword registration may grow beyond the fixed fast index.
    i = KW_MAX_ENTRIES
    when i < vec_len(table) loop
        entry = vec_get(table, i)
        if fat_str_len(entry.word) == span_len do
            if fat_str_eq_span(source, start, span_len, entry.word) do out entry.tok end
        end
        i = i + 1
    end
    out TokType.Error
end.
# ═══════════════════════════════════════════════════════
# Lexer State
# ═══════════════════════════════════════════════════════

entity Lexer:
    source:         string,
        source_len:     int,
        pos:            int,
        line:           int,
        col:            int,
        tokens:         Vec of (Token),
        paren_depth:    int,
        keywords:       Vec of (KeywordEntry),
        error_msg:          string
end.

# Stable C-VM hand-off.  Returning the Lexer aggregate can lose fields when
# the caller performs another CALL, so publish the final token vector/error
# from inside tokenize while the aggregate is still live.
var g_lexer_tokens: i64 = 0
var g_lexer_error: i64 = 0
var g_lexer_error_offset: int = 0
var g_lexer_source: i64 = 0
var g_lexer_source_data: i64 = 0
var g_ident_intern: i64 = 0
var g_lexer_err_unterminated_string: i64 = fat_str_new("unterminated string literal") as i64
var g_lexer_err_unterminated_interp: i64 = fat_str_new("unterminated expression in string interpolation") as i64
var g_lexer_err_double_colon: i64 = fat_str_new("invalid token '::'; use '.' for qualified names") as i64

func token_name(t: TokType):

    if t == TokType.Eof do
        out fat_str_new("EOF")
    end
    if t == TokType.Int do
        out fat_str_new("INT")
    end
    if t == TokType.Float do
        out fat_str_new("FLOAT")
    end
    if t == TokType.Str do
        out fat_str_new("STRING")
    end
    if t == TokType.Ident do
        out fat_str_new("IDENT")
    end
    if t == TokType.Newline do
        out fat_str_new("NEWLINE")
    end
