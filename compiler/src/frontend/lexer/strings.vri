func utf8_source_invalid_offset_bytes(data: int, n: int):
    if n < 0 do
        out 0
    end
    if data == 0 do
        if n == 0 do
            out -1
        end
        out 0
    end

    var i = 0
    when i < n loop
        let lead = native_read_u8(data, i)
        if lead < 128 do
            i = i + 1
            skip
        end

        var width = 0
        var second_min = 128
        var second_max = 191
        if lead >= 194 and lead <= 223 do
            width = 2
        eif lead == 224 do
            width = 3
            second_min = 160
        eif lead >= 225 and lead <= 236 do
            width = 3
        eif lead == 237 do
            width = 3
            second_max = 159
        eif lead >= 238 and lead <= 239 do
            width = 3
        eif lead == 240 do
            width = 4
            second_min = 144
        eif lead >= 241 and lead <= 243 do
            width = 4
        eif lead == 244 do
            width = 4
            second_max = 143
        else
            out i
        end

        if i + width > n do
            out i
        end
        let second = native_read_u8(data, i + 1)
        if second < second_min or second > second_max do
            out i
        end
        var j = 2
        when j < width loop
            let continuation = native_read_u8(data, i + j)
            if continuation < 128 or continuation > 191 do
                out i
            end
            j = j + 1
        end
        i = i + width
    end
    out -1
end.
export TokType, Token, KeywordEntry, Lexer, lexer_new, tokenize, lexer_lex, token_new,
       token_update_span, lexer_token_count, lexer_token_get, lexer_error_message, g_lexer_error_offset, token_name,
       token_lexeme, g_lexer_source, lookup_keyword_span, utf8_source_invalid_offset_bytes
