func string_has_interp(ref lex: Lexer):
    var p = lex.pos + 1
    let slen = lex.source_len
    when p < slen loop
        b = native_read_u8(g_lexer_source_data, p)
        if b == 34 do # closing '"'
            out 0
        end
        if b == 10 or b == 0 do # newline or EOF
            out 0
        end
        if b == 92 do # backslash
            p = p + 2
        eif b == 36 do # '$'
            if p + 1 < slen do
                b_next = native_read_u8(g_lexer_source_data, p + 1)
                if b_next == 36 do # '$$'
                    p = p + 2
                eif b_next == 40 or lex_is_id_start(b_next) == 1 do # '(' or ident
                    out 1
                else
                    p = p + 1
                end
            else
                p = p + 1
            end
        else
            p = p + 1
        end
    end
    out 0
end.

func lex_operator_in_interp(ref lex: Lexer):
    start_line = lex.line
    start_col = lex.col
    start_pos = lex.pos
    var (lex2, c) = lex_advance(lex)
    c2 = lex_peek(lex2)

    # 2-char operators
    if c == 61 and c2 == 61 do # ==
        var (lex3, _) = lex_advance(lex2)
        tok = token_new(TokType.Eq, start_line, start_col)
        tok.start = start_pos; tok.len = 2
        out (lex3, tok)
    end
    if c == 33 and c2 == 61 do # !=
        var (lex3, _) = lex_advance(lex2)
        tok = token_new(TokType.Ne, start_line, start_col)
        tok.start = start_pos; tok.len = 2
        out (lex3, tok)
    end
    if c == 62 and c2 == 61 do # >=
        var (lex3, _) = lex_advance(lex2)
        tok = token_new(TokType.Ge, start_line, start_col)
        tok.start = start_pos; tok.len = 2
        out (lex3, tok)
    end
    if c == 60 and c2 == 61 do # <=
        var (lex3, _) = lex_advance(lex2)
        tok = token_new(TokType.Le, start_line, start_col)
        tok.start = start_pos; tok.len = 2
        out (lex3, tok)
    end
    if c == 42 and c2 == 42 do # **
        var (lex3, _) = lex_advance(lex2)
        tok = token_new(TokType.MatMul, start_line, start_col)
        tok.start = start_pos; tok.len = 2
        out (lex3, tok)
    end

    # 1-char lookup via g_lex_single
    single_val = native_read_i64(g_lex_single, c * 8)
    if single_val != 0 do
        tok = token_new(single_val as TokType, start_line, start_col)
        tok.start = start_pos
        tok.len = 1
        out (lex2, tok)
    end

    tok = token_new(TokType.Error, start_line, start_col)
    tok.start = start_pos
    tok.len = 1
    out (lex2, tok)
end.

func lex_interpolated_string(ref lex: Lexer):
    start_line = lex.line
    start_col = lex.col
    var (lex2, _) = lex_advance(lex) # consume opening quote
    lex = lex2

    tok_start = token_new(TokType.InterpStart, start_line, start_col)
    lex.tokens = vec_push(lex.tokens, tok_start)

    sb = sb_new()
    var seg_line = lex.line
    var seg_col = lex.col

    when not is_eof(lex) and lex_peek(lex) != 34 loop
        c = lex_peek(lex)
        if c == 92 do # backslash
            var (lex3, _) = lex_advance(lex)
            lex = lex3
            if is_eof(lex) do
                tok_err = token_new(TokType.Error, lex.line, lex.col)
                tok_err.str_val = g_lexer_err_unterminated_string as string
                lex.error_msg = tok_err.str_val
                g_lexer_error = tok_err.str_val as i64
                g_lexer_error_offset = lex.pos
                out lex
            end
            var (lex4, esc) = lex_advance(lex)
            lex = lex4
            known = 0
            if esc == 110 do sb = sb_append_char(sb, 10); known = 1 end
            if esc == 116 do sb = sb_append_char(sb, 9);  known = 1 end
            if esc == 92  do sb = sb_append_char(sb, 92); known = 1 end
            if esc == 114 do sb = sb_append_char(sb, 13); known = 1 end
            if esc == 48  do sb = sb_append_char(sb, 0);  known = 1 end
            if esc == 34  do sb = sb_append_char(sb, 34); known = 1 end
            if esc == 39  do sb = sb_append_char(sb, 39); known = 1 end
            if esc == 36  do sb = sb_append_char(sb, 36); known = 1 end
            if known == 0 do sb = sb_append_char(sb, esc) end
        eif c == 36 and lex_peek_at(lex, 1) == 36 do # $$ -> literal $
            var (l_d1, _) = lex_advance(lex)
            var (l_d2, _) = lex_advance(l_d1)
            lex = l_d2
            sb = sb_append_char(sb, 36)
        eif c == 36 and (lex_peek_at(lex, 1) == 40 or lex_is_id_start(lex_peek_at(lex, 1)) == 1) do
            # Flush preceding string segment if non-empty
            if sb_len(sb) > 0 do
                tok_str = token_new(TokType.Str, seg_line, seg_col)
                tok_str.str_val = str_from_cstr(sb_to_string(sb))
                lex.tokens = vec_push(lex.tokens, tok_str)
                sb = sb_new()
            end
            # Advance past '$'
            var (l_dl, _) = lex_advance(lex)
            lex = l_dl
            if lex_peek(lex) == 40 do # '(' -> $(expr)
                var (l_lp, _) = lex_advance(lex)
                lex = l_lp
                tok_lp = token_new(TokType.LParen, lex.line, lex.col)
                lex.tokens = vec_push(lex.tokens, tok_lp)
                var paren_depth = 1
                when not is_eof(lex) and paren_depth > 0 loop
                    lex = skip_trivia(lex)
                    if is_eof(lex) do
                        tok_err2 = token_new(TokType.Error, lex.line, lex.col)
                        tok_err2.str_val = g_lexer_err_unterminated_interp as string
                        lex.error_msg = tok_err2.str_val
                        # Publish before the early aggregate return; otherwise
                        # the native self-host ABI can lose error_msg.
                        g_lexer_error = tok_err2.str_val as i64
                        g_lexer_error_offset = lex.pos
                        out lex
                    end
                    c_in = lex_peek(lex)
                    if c_in == 40 do # '('
                        var (l_n, _) = lex_advance(lex)
                        lex = l_n
                        paren_depth = paren_depth + 1
                        lex.tokens = vec_push(lex.tokens, token_new(TokType.LParen, lex.line, lex.col))
                    eif c_in == 41 do # ')'
                        var (l_n, _) = lex_advance(lex)
                        lex = l_n
                        paren_depth = paren_depth - 1
                        lex.tokens = vec_push(lex.tokens, token_new(TokType.RParen, lex.line, lex.col))
                    eif c_in == 10 do # newline
                        paren_depth = 0
                    eif c_in == 34 do
                        var scan_p = lex.pos + 1
                        var has_inner_closing = 0
                        when scan_p < lex.source_len loop
                            let sc = native_read_u8(g_lexer_source_data, scan_p)
                            if sc == 10 or sc == 0 do
                                scan_p = lex.source_len
                            eif sc == 92 do
                                scan_p = scan_p + 2
                            eif sc == 34 do
                                has_inner_closing = 1
                                scan_p = lex.source_len
                            else
                                scan_p = scan_p + 1
                            end
                        end
                        if has_inner_closing == 1 do
                            var (l_n, s_tok) = lex_string(lex)
                            lex = l_n
                            lex.tokens = vec_push(lex.tokens, s_tok)
                        else
                            paren_depth = 0
                        end
                    eif c_in == 39 do
                        var (l_n, s_tok) = lex_string(lex)
                        lex = l_n
                        lex.tokens = vec_push(lex.tokens, s_tok)
                    eif (native_read_u8(g_lex_ascii, c_in) & LEX_C_DIGIT) != 0 do
                        var (l_n, n_tok) = lex_number(lex)
                        lex = l_n
                        lex.tokens = vec_push(lex.tokens, n_tok)
                    eif (native_read_u8(g_lex_ascii, c_in) & LEX_C_ID_START) != 0 or c_in >= 128 do
                        var (l_n, w_tok) = lex_word(lex)
                        lex = l_n
                        lex.tokens = vec_push(lex.tokens, w_tok)
                    else
                        var (l_n, op_tok) = lex_operator_in_interp(lex)
                        lex = l_n
                        lex.tokens = vec_push(lex.tokens, op_tok)
                    end
                end
                if paren_depth > 0 do
                    g_lexer_error = fat_str_new("unterminated expression in string interpolation") as i64
                    g_lexer_error_offset = lex.pos
                    out lex
                end
            else
                # $ident or $ident.field...
                var (l_id, id_tok) = lex_word(lex)
                lex = l_id
                lex.tokens = vec_push(lex.tokens, id_tok)
                when lex_peek(lex) == 46 and lex_is_id_start(lex_peek_at(lex, 1)) == 1 loop
                    var (l_dot, _) = lex_advance(lex)
                    lex = l_dot
                    tok_dot = token_new(TokType.Dot, lex.line, lex.col)
                    lex.tokens = vec_push(lex.tokens, tok_dot)
                    var (l_fld, fld_tok) = lex_word(lex)
                    lex = l_fld
                    lex.tokens = vec_push(lex.tokens, fld_tok)
                end
            end
            seg_line = lex.line
            seg_col = lex.col
        else
            var (lex5, ch) = lex_advance(lex)
            lex = lex5
            sb = sb_append_char(sb, ch)
        end
    end

    if is_eof(lex) do
        tok_err3 = token_new(TokType.Error, tok_start.line, tok_start.col)
        tok_err3.str_val = g_lexer_err_unterminated_string as string
        lex.error_msg = tok_err3.str_val
        g_lexer_error = tok_err3.str_val as i64
        g_lexer_error_offset = lex.pos
        out lex
    end

    if sb_len(sb) > 0 do
        tok_str = token_new(TokType.Str, seg_line, seg_col)
        tok_str.str_val = str_from_cstr(sb_to_string(sb))
        lex.tokens = vec_push(lex.tokens, tok_str)
    end

    var (lex6, _) = lex_advance(lex) # consume closing quote
    lex = lex6

    tok_end = token_new(TokType.InterpEnd, lex.line, lex.col)
    lex.tokens = vec_push(lex.tokens, tok_end)
    out lex
end.

func lex_string(ref lex: Lexer):

    let stringStart = lex.pos
    let stringLine = lex.line
    let stringColumn = lex.col
    tok = token_new(TokType.Str, stringLine, stringColumn)
    let stringToken = tok as int
    var (lex2, quote) = lex_advance(lex)  # consume opening quote
    lex = lex2
    sb = sb_new()

    when not is_eof(lex) and lex_peek(lex) != quote loop
        if lex_peek(lex) == 92 do # backslash
            var (lex3, _) = lex_advance(lex)
            lex = lex3
            if is_eof(lex) do
                tok = token_new(TokType.Error, tok.line, tok.col)
                tok.str_val = fat_str_new("unterminated string literal")
                lex.error_msg = tok.str_val
                g_lexer_error = tok.str_val as i64
                g_lexer_error_offset = lex.pos
                out (lex, tok)
            end
            var (lex4, esc) = lex_advance(lex)
            lex = lex4
            known = 0
            if esc == 110 do # \n
                sb = sb_append_char(sb, 10)
                known = 1
            end
            if esc == 116 do # \t
                sb = sb_append_char(sb, 9)
                known = 1
            end
            if esc == 92 do # \\
                sb = sb_append_char(sb, 92)
                known = 1
            end
            if esc == 114 do # \r
                sb = sb_append_char(sb, 13)
                known = 1
            end
            if esc == 48 do # \0
                sb = sb_append_char(sb, 0)
                known = 1
            end
            if esc == 34 do # \"
                sb = sb_append_char(sb, 34)
                known = 1
            end
            if esc == 39 do # \'
                sb = sb_append_char(sb, 39)
                known = 1
            end
            if esc == 36 do # \$
                sb = sb_append_char(sb, 36)
                known = 1
            end
            # C core default: keep the escaped character as-is
            if known == 0 do
                sb = sb_append_char(sb, esc)
            end
        eif quote == 34 and lex_peek(lex) == 36 and lex_peek_at(lex, 1) == 36 do # $$
            var (l_d1, _) = lex_advance(lex)
            var (l_d2, _) = lex_advance(l_d1)
            lex = l_d2
            sb = sb_append_char(sb, 36)
        else
            var (lex5, ch) = lex_advance(lex)
            lex = lex5
            sb = sb_append_char(sb, ch)
        end
    end

    # Consume closing quote — Error if EOF (C reports unterminated string)
    if is_eof(lex) do
        tok = token_new(TokType.Error, tok.line, tok.col)
        tok.str_val = fat_str_new("unterminated string literal")
        lex.error_msg = tok.str_val
        g_lexer_error = tok.str_val as i64
        g_lexer_error_offset = lex.pos
        out (lex, tok)
    end
    var (lex6, _) = lex_advance(lex)
    lex = lex6

    tok.str_val = str_from_cstr(sb_to_string(sb))
    let stringEnd = lex.pos
    native_write_i64(stringToken, 8, stringLine)
    native_write_i64(stringToken, 16, stringColumn)
    native_write_i64(stringToken, 24, stringStart)
    native_write_i64(stringToken, 32, stringEnd - stringStart)
    out (lex, stringToken as Token)
end.
