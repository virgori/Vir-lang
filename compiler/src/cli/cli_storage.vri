# Descriptor-relative diagnostic cache primitives. No rendered-output capture.
# Callers own project identity/schema validation. This module never compiles.
# All cache components are opened O_DIRECTORY | O_NOFOLLOW. Build/entry keys
# are strict hex, never user paths. Temporary files are O_EXCL | O_NOFOLLOW.

include cli_environment
include rt.string_rt
include rt.alloc
include rt.syscall
import cliIsDarwinPlatform, cliIsLinuxPlatform from virc.cli.cli_environment
import sys_platform, Platform, sys_read, sys_write, sys_close, sys_open,
       VIR_O_RDONLY from rt.syscall
import vir_alloc, vir_free from rt.alloc
import rt_strlen, native_read_u8, native_write_u8, sb_new, sb_append,
       sb_append_char, sb_to_string, sb_free from rt.string_rt

extern func syscall1(number: int, first: int) -> int
extern func syscall3(number: int, first: int, second: int, third: int) -> int
extern func syscall4(number: int, first: int, second: int, third: int, fourth: int) -> int
extern func syscall5(number: int, first: int, second: int, third: int, fourth: int, fifth: int) -> int

func cliStoreNumber(darwin: int, arm64: int, x86: int):
    let platform = sys_platform()
    if cliIsDarwinPlatform(platform) == 1 do out darwin end
    if platform == Platform.Linux_x86_64 do out x86 end
    if cliIsLinuxPlatform(platform) == 1 do out arm64 end
    out 0
end.

func cliStoreOpenAt:
    in parent: int
       name: int
       flags: int
       mode: int
    let number = cliStoreNumber(0x20001CF, 56, 257)
    if number == 0 do out 0 - 1 end
    out syscall4(number, parent, name, flags, mode)
end.

func cliStoreDirectoryFlags():
    if cliIsDarwinPlatform(sys_platform()) == 1 do out 0x100100 end
    # Linux arm64 keeps AArch32-compatible open flags, unlike x86/RISCV.
    if sys_platform() == Platform.Linux_ARM64 do out 0xC000 end
    out 0x30000
end.

func cliStoreCreateFlags():
    if cliIsDarwinPlatform(sys_platform()) == 1 do out 0xB01 end
    if sys_platform() == Platform.Linux_ARM64 do out 0x80C1 end
    out 0x200C1
end.

func cliStoreReadFlags():
    if cliIsDarwinPlatform(sys_platform()) == 1 do out 0x100 end
    if sys_platform() == Platform.Linux_ARM64 do out 0x8000 end
    out 0x20000
end.

func cliStoreChildDirectory(parent: int, name: int, create: int):
    if create == 1 do
        let number = cliStoreNumber(0x20001DB, 34, 258)
        if number == 0 do out 0 - 1 end
        # EEXIST is acceptable only if subsequent no-follow directory open works.
        syscall3(number, parent, name, 448)
    end
    out cliStoreOpenAt(parent, name, cliStoreDirectoryFlags(), 0)
end.

func cliStoreOpenCache(project: int, create: int):
    var cwd = 0 - 100
    if cliIsDarwinPlatform(sys_platform()) == 1 do cwd = 0 - 2 end
    let root = cliStoreOpenAt(cwd, project, cliStoreDirectoryFlags(), 0)
    if root < 0 do out 0 - 1 end
    let vir = cliStoreChildDirectory(root, ".vir" as int, create)
    sys_close(root)
    if vir < 0 do out 0 - 1 end
    let diagnostics = cliStoreChildDirectory(vir, "diagnostics" as int, create)
    sys_close(vir)
    if diagnostics < 0 do out 0 - 1 end
    let version = cliStoreChildDirectory(diagnostics, "v1" as int, create)
    sys_close(diagnostics)
    out version
end.

func cliStoreHexKey(value: int, length: int):
    if value == 0 do out 0 end
    if rt_strlen(value) != length do out 0 end
    var index = 0
    when index < length loop
        let byte = native_read_u8(value, index)
        var valid = 0
        if byte >= 48 do
            if byte <= 57 do valid = 1 end
        end
        if byte >= 97 do
            if byte <= 102 do valid = 1 end
        end
        if valid == 0 do out 0 end
        index = index + 1
    end
    out 1
end.

func cliStoreBuildId():
    let descriptor = sys_open("/dev/urandom" as int, VIR_O_RDONLY, 0)
    if descriptor < 0 do out 0 end
    let raw = vir_alloc(16)
    var received = 0
    when received < 16 loop
        let count = sys_read(descriptor, raw + received, 16 - received)
        if count <= 0 do
            sys_close(descriptor)
            vir_free(raw)
            out 0
        end
        received = received + count
    end
    sys_close(descriptor)
    var text = sb_new()
    let digits = "0123456789abcdef" as int
    var index = 0
    when index < 16 loop
        let byte = native_read_u8(raw, index)
        text = sb_append_char(text, native_read_u8(digits, byte shr 4))
        text = sb_append_char(text, native_read_u8(digits, byte and 15))
        index = index + 1
    end
    vir_free(raw)
    out sb_to_string(text)
end.

func cliStoreSync(descriptor: int):
    let number = cliStoreNumber(0x200005F, 82, 74)
    if number == 0 do out 0 - 1 end
    out syscall1(number, descriptor)
end.

func cliStoreUnlink(directory: int, name: int):
    let number = cliStoreNumber(0x20001D8, 35, 263)
    if number == 0 do out 0 - 1 end
    out syscall3(number, directory, name, 0)
end.

func cliStoreWriteExclusive(directory: int, name: int, payload: int):
    let length = rt_strlen(payload)
    if length > 16777216 do out 0 - 1 end
    let descriptor = cliStoreOpenAt(directory, name, cliStoreCreateFlags(), 384)
    if descriptor < 0 do out 0 - 1 end
    var written = 0
    when written < length loop
        let count = sys_write(descriptor, payload + written, length - written)
        if count <= 0 do
            sys_close(descriptor)
            cliStoreUnlink(directory, name)
            out 0 - 1
        end
        written = written + count
    end
    let synced = cliStoreSync(descriptor)
    sys_close(descriptor)
    if synced != 0 do
        cliStoreUnlink(directory, name)
        out 0 - 1
    end
    out 0
end.

# Publish immutable inode without replacing a previous build. A hard link
# atomically exposes the complete file and fails if finalName already exists.
# Latest is separately renamed; interruption never truncates its previous inode.
func cliStorePublish:
    in directory: int
       build: int
       entryKey: int
       payload: int
    if cliStoreHexKey(build, 32) != 1 do out 0 - 1 end
    if cliStoreHexKey(entryKey, 64) != 1 do out 0 - 1 end
    let
        tempName = sb_to_string(sb_append(sb_append(sb_new(), build), ".tmp"))
        finalName = sb_to_string(sb_append(sb_append(sb_new(), build), ".json"))
    if cliStoreWriteExclusive(directory, tempName, payload) != 0 do out 0 - 1 end
    let linkNumber = cliStoreNumber(0x20001D7, 37, 265)
    if linkNumber == 0 do cliStoreUnlink(directory, tempName); out 0 - 1 end
    let linked = syscall5(linkNumber, directory, tempName, directory, finalName, 0)
    cliStoreUnlink(directory, tempName)
    if linked != 0 do out 0 - 1 end
    if cliStoreSync(directory) != 0 do out 0 - 1 end
    var indexTemp = sb_append(sb_new(), entryKey)
    indexTemp = sb_append_char(indexTemp, 45)
    indexTemp = sb_append(indexTemp, build)
    indexTemp = sb_append(indexTemp, ".tmp")
    let
        indexName = sb_to_string(indexTemp)
        latestName = sb_to_string(sb_append(sb_append(sb_new(), entryKey), ".latest"))
    if cliStoreWriteExclusive(directory, indexName, build) != 0 do out 0 - 1 end
    let renameNumber = cliStoreNumber(0x20001D1, 38, 264)
    if renameNumber == 0 do cliStoreUnlink(directory, indexName); out 0 - 1 end
    let renamed = syscall4(renameNumber, directory, indexName, directory, latestName)
    if renamed != 0 do
        cliStoreUnlink(directory, indexName)
        out 0 - 1
    end
    out cliStoreSync(directory)
end.

func cliStoreReadFile(directory: int, name: int, limit: int):
    if limit < 1 do out 0 end
    if limit > 16777216 do out 0 end
    let descriptor = cliStoreOpenAt(directory, name, cliStoreReadFlags(), 0)
    if descriptor < 0 do out 0 end
    let data = vir_alloc(limit + 2)
    var received = 0
    when received <= limit loop
        let count = sys_read(descriptor, data + received, limit + 1 - received)
        if count < 0 do
            sys_close(descriptor)
            vir_free(data)
            out 0
        end
        if count == 0 do break end
        received = received + count
    end
    sys_close(descriptor)
    if received > limit do vir_free(data); out 0 end
    var index = 0
    when index < received loop
        if native_read_u8(data, index) == 0 do vir_free(data); out 0 end
        index = index + 1
    end
    native_write_u8(data, received, 0)
    out data
end.

func cliStoreReadLatest(directory: int, entryKey: int):
    if cliStoreHexKey(entryKey, 64) != 1 do out 0 end
    let name = sb_to_string(sb_append(sb_append(sb_new(), entryKey), ".latest"))
    let build = cliStoreReadFile(directory, name, 32)
    if cliStoreHexKey(build, 32) != 1 do
        if build != 0 do vir_free(build) end
        out 0
    end
    let snapshot = sb_to_string(sb_append(sb_append(sb_new(), build), ".json"))
    vir_free(build)
    out cliStoreReadFile(directory, snapshot, 16777216)
end.

export cliStoreOpenCache, cliStoreHexKey, cliStoreBuildId, cliStorePublish,
       cliStoreReadLatest, cliStoreOpenAt, cliStoreReadFlags, cliStoreNumber,
       cliStoreWriteExclusive, cliStoreUnlink, cliStoreSync, cliStoreReadFile
