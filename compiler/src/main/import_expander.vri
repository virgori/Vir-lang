##
 * compiler/src/main/import_expander.vri — Import Statement Parsing & Selective Symbol Expansion
 * ============================================================================================
 ##

include rt.alloc
import vir_alloc from rt.alloc
include rt.string_rt
import fat_str_new, fat_str_len, fat_str_byte_at, fat_cstr_eq, fat_str_concat, fat_str_eq, rt_streq, str_from_cstr, rt_strlen, rt_itoa, vir_free from rt.string_rt
include rt.vec_rt
import bvec_len, bvec_get, vec_len_rt, vec_get_rt, vec_new_rt, vec_push_rt from rt.vec_rt
include rt.io
import read_file_str, print_str, print_ln, print_int, print_newline from rt.io
include main_path_util
include main_module_resolver
include main_include_expander

func text_find_import(source: int):
    # Line-start "import " (7 letters + space) or "from " (5 letters + space).
    data = native_read_i64(source, 0)
    n = native_read_i64(source, 8)
    i = 0
    at_line = 1
    when i < n loop
        if at_line == 1 do
            if i + 7 <= n and native_read_u8(data, i) == 105 and native_read_u8(data, i + 1) == 109 and native_read_u8(data, i + 2) == 112 and native_read_u8(data, i + 3) == 111 and native_read_u8(data, i + 4) == 114 and native_read_u8(data, i + 5) == 116 and native_read_u8(data, i + 6) == 32 do
                out i
            end
            if i + 5 <= n and native_read_u8(data, i) == 102 and native_read_u8(data, i + 1) == 114 and native_read_u8(data, i + 2) == 111 and native_read_u8(data, i + 3) == 109 and native_read_u8(data, i + 4) == 32 do
                out i
            end
        end
        ch = native_read_u8(data, i)
        if ch == 10 do
            at_line = 1
        else
            if ch != 32 and ch != 9 do
                at_line = 0
            end
        end
        i = i + 1
    end
    out (0 - 1)
end.

func text_is_ident_char(c: int):
    if c >= 97 and c <= 122 do
        out 1
    end
    if c >= 65 and c <= 90 do
        out 1
    end
    if c >= 48 and c <= 57 do
        out 1
    end
    if c == 95 do
        out 1
    end
    out 0
end.

func text_skip_hspace(data: int, n: int, i: int):
    when i < n and (native_read_u8(data, i) == 32 or native_read_u8(data, i) == 9) loop
        i = i + 1
    end
    out i
end.

func text_skip_import_ws(data: int, n: int, i: int):
    when i < n and (native_read_u8(data, i) == 32 or native_read_u8(data, i) == 9 or native_read_u8(data, i) == 10 or native_read_u8(data, i) == 13) loop
        i = i + 1
    end
    out i
end.

func text_import_stmt_end(data: int, n: int, i: int):
    i = text_skip_hspace(data, n, i)
    if i < n and native_read_u8(data, i) == 59 do
        out i + 1
    end
    if i < n and native_read_u8(data, i) == 13 do
        i = i + 1
    end
    if i < n and native_read_u8(data, i) == 10 do
        out i + 1
    end
    out i
end.

func text_fat_from_range(data: int, start: int, len: int):
    if len <= 0 do
        out 0
    end
    buf = vir_alloc(len + 1)
    j = 0
    when j < len loop
        native_write_u8(buf, j, native_read_u8(data, start + j))
        j = j + 1
    end
    native_write_u8(buf, len, 0)
    out str_from_cstr(buf)
end.

func text_eq_ident(data: int, start: int, len: int, name: int):
    nd = native_read_i64(name, 0)
    nl = native_read_i64(name, 8)
    if len != nl do
        out 0
    end
    j = 0
    when j < len loop
        if native_read_u8(data, start + j) != native_read_u8(nd, j) do
            out 0
        end
        j = j + 1
    end
    out 1
end.

func text_has_any_export(body: int):
    data = native_read_i64(body, 0)
    n = native_read_i64(body, 8)
    var i = 0
    var at_line = 1
    when i + 7 <= n loop
        if at_line == 1 do
            if native_read_u8(data, i) == 101 and native_read_u8(data, i + 1) == 120 and native_read_u8(data, i + 2) == 112 and native_read_u8(data, i + 3) == 111 and native_read_u8(data, i + 4) == 114 and native_read_u8(data, i + 5) == 116 and native_read_u8(data, i + 6) == 32 do
                out 1
            end
        end
        ch = native_read_u8(data, i)
        if ch == 10 do
            at_line = 1
        else
            if ch != 32 and ch != 9 do
                at_line = 0
            end
        end
        i = i + 1
    end
    out 0
end.

func text_extract_enum_for_variant(body: int, vname: int):
    # Searches for an `enum <Name> ... end.` block containing `vname` as a variant.
    data = native_read_i64(body, 0)
    n = native_read_i64(body, 8)
    vl = native_read_i64(vname, 8)
    if vl <= 0 do out 0 end
    var i = 0
    var at_line = 1
    when i + 5 <= n loop
        if at_line == 1 and native_read_u8(data, i) == 101 and native_read_u8(data, i + 1) == 110 and native_read_u8(data, i + 2) == 117 and native_read_u8(data, i + 3) == 109 and native_read_u8(data, i + 4) == 32 do
            let enum_start = i
            var k = i + 5
            var enum_end = 0
            when k + 4 <= n and enum_end == 0 loop
                if native_read_u8(data, k) == 101 and native_read_u8(data, k + 1) == 110 and native_read_u8(data, k + 2) == 100 and native_read_u8(data, k + 3) == 46 do
                    let after_end = k + 4
                    if after_end >= n or native_read_u8(data, after_end) == 10 or native_read_u8(data, after_end) == 32 or native_read_u8(data, after_end) == 9 or native_read_u8(data, after_end) == 13 do
                        enum_end = after_end
                    end
                end
                k = k + 1
            end
            if enum_end > enum_start do
                var p = enum_start + 5
                when p < enum_end and native_read_u8(data, p) != 10 loop
                    p = p + 1
                end
                if p < enum_end and native_read_u8(data, p) == 10 do
                    p = p + 1
                end
                when p < enum_end loop
                    when p < enum_end and (native_read_u8(data, p) == 32 or native_read_u8(data, p) == 9) loop
                        p = p + 1
                    end
                    if p < enum_end and native_read_u8(data, p) != 10 and native_read_u8(data, p) != 35 do
                        if p + 4 <= enum_end and native_read_u8(data, p) == 101 and native_read_u8(data, p + 1) == 110 and native_read_u8(data, p + 2) == 100 and native_read_u8(data, p + 3) == 46 do
                            p = enum_end
                        else
                            let var_start = p
                            when p < enum_end and text_is_ident_char(native_read_u8(data, p)) == 1 loop
                                p = p + 1
                            end
                            let var_len = p - var_start
                            if var_len == vl and text_eq_ident(data, var_start, vl, vname) == 1 do
                                out text_fat_from_range(data, enum_start, enum_end - enum_start)
                            end
                        end
                    end
                    when p < enum_end and native_read_u8(data, p) != 10 loop
                        p = p + 1
                    end
                    if p < enum_end and native_read_u8(data, p) == 10 do
                        p = p + 1
                    end
                end
            end
        end
        ch = native_read_u8(data, i)
        if ch == 10 do
            at_line = 1
        else
            if ch != 32 and ch != 9 do
                at_line = 0
            end
        end
        i = i + 1
    end
    out 0
end.

func text_contains_enum(buf: int, blen: int, name_data: int, name_start: int, name_len: int):
    var i = 0
    when i + 5 + name_len <= blen loop
        if native_read_u8(buf, i) == 101 and native_read_u8(buf, i + 1) == 110 and native_read_u8(buf, i + 2) == 117 and native_read_u8(buf, i + 3) == 109 and native_read_u8(buf, i + 4) == 32 do
            var j = i + 5
            when j < blen and (native_read_u8(buf, j) == 32 or native_read_u8(buf, j) == 9) loop
                j = j + 1
            end
            var match = 1
            var k = 0
            when k < name_len and match == 1 loop
                if native_read_u8(buf, j + k) != native_read_u8(name_data, name_start + k) do
                    match = 0
                end
                k = k + 1
            end
            if match == 1 do
                let after = j + name_len
                if after >= blen or text_is_ident_char(native_read_u8(buf, after)) == 0 do
                    out 1
                end
            end
        end
        i = i + 1
    end
    out 0
end.

func text_has_export(body: int, fname: int):
    if text_has_any_export(body) == 0 do
        out 1
    end
    # True if body contains line-start "export <fname>" or "export ..., <fname>, ..."
    data = native_read_i64(body, 0)
    n = native_read_i64(body, 8)
    fl = native_read_i64(fname, 8)
    i = 0
    at_line = 1
    when i + 7 <= n loop
        if at_line == 1 do
            if native_read_u8(data, i) == 101 and native_read_u8(data, i + 1) == 120 and native_read_u8(data, i + 2) == 112 and native_read_u8(data, i + 3) == 111 and native_read_u8(data, i + 4) == 114 and native_read_u8(data, i + 5) == 116 and native_read_u8(data, i + 6) == 32 do
                j = i + 7
                var in_exp = 1
                when j < n and in_exp == 1 loop
                    when j < n and (native_read_u8(data, j) == 32 or native_read_u8(data, j) == 9 or native_read_u8(data, j) == 44 or native_read_u8(data, j) == 13) loop
                        j = j + 1
                    end
                    if j < n and native_read_u8(data, j) == 10 do
                        j = j + 1
                        let ls = j
                        when j < n and (native_read_u8(data, j) == 32 or native_read_u8(data, j) == 9) loop
                            j = j + 1
                        end
                        if j == ls or (j < n and (native_read_u8(data, j) == 10 or native_read_u8(data, j) == 13)) do
                            in_exp = 0
                            break
                        end
                    end
                    if in_exp == 1 and j < n do
                        sym_start = j
                        when j < n and text_is_ident_char(native_read_u8(data, j)) == 1 loop
                            j = j + 1
                        end
                        sym_len = j - sym_start
                        if sym_len > 0 and text_eq_ident(data, sym_start, sym_len, fname) == 1 do
                            out 1
                        end
                        if sym_len <= 0 do
                            j = j + 1
                        end
                    end
                end
            end
        end
        ch = native_read_u8(data, i)
        if ch == 10 do
            at_line = 1
        else
            if ch != 32 and ch != 9 do
                at_line = 0
            end
        end
        i = i + 1
    end
    let enum_chunk = text_extract_enum_for_variant(body, fname)
    if enum_chunk != 0 do
        let edata = native_read_i64(enum_chunk, 0)
        let elen = native_read_i64(enum_chunk, 8)
        var ei = 5
        when ei < elen and (native_read_u8(edata, ei) == 32 or native_read_u8(edata, ei) == 9) loop
            ei = ei + 1
        end
        let es = ei
        when ei < elen and text_is_ident_char(native_read_u8(edata, ei)) == 1 loop
            ei = ei + 1
        end
        let ename = text_fat_from_range(edata, es, ei - es)
        if text_has_export(body, ename) == 1 do
            out 1
        end
    end
    out 0
end.

func text_extract_func(body: int, fname: int):
    # Slice "func <fname> ... end." / "entity <fname> ... end." / "enum <fname> ... end." / "const <fname> ..." from body.
    data = native_read_i64(body, 0)
    n = native_read_i64(body, 8)
    fl = native_read_i64(fname, 8)
    i = 0
    at_line = 1
    var source_line = 1
    when i + fl <= n loop
        if at_line == 1 do
            pref_len = 0
            is_const = 0
            if i + 5 <= n and native_read_u8(data, i) == 102 and native_read_u8(data, i + 1) == 117 and native_read_u8(data, i + 2) == 110 and native_read_u8(data, i + 3) == 99 and native_read_u8(data, i + 4) == 32 do
                pref_len = 5
            end
            if i + 7 <= n and native_read_u8(data, i) == 101 and native_read_u8(data, i + 1) == 110 and native_read_u8(data, i + 2) == 116 and native_read_u8(data, i + 3) == 105 and native_read_u8(data, i + 4) == 116 and native_read_u8(data, i + 5) == 121 and native_read_u8(data, i + 6) == 32 do
                pref_len = 7
            end
            if i + 5 <= n and native_read_u8(data, i) == 101 and native_read_u8(data, i + 1) == 110 and native_read_u8(data, i + 2) == 117 and native_read_u8(data, i + 3) == 109 and native_read_u8(data, i + 4) == 32 do
                pref_len = 5
            end
            if i + 6 <= n and native_read_u8(data, i) == 99 and native_read_u8(data, i + 1) == 111 and native_read_u8(data, i + 2) == 110 and native_read_u8(data, i + 3) == 115 and native_read_u8(data, i + 4) == 116 and native_read_u8(data, i + 5) == 32 do
                pref_len = 6
                is_const = 1
            end
            if i + 12 <= n and native_read_u8(data, i) == 101 and native_read_u8(data, i + 1) == 120 and native_read_u8(data, i + 2) == 116 and native_read_u8(data, i + 3) == 101 and native_read_u8(data, i + 4) == 114 and native_read_u8(data, i + 5) == 110 and native_read_u8(data, i + 6) == 32 and native_read_u8(data, i + 7) == 102 and native_read_u8(data, i + 8) == 117 and native_read_u8(data, i + 9) == 110 and native_read_u8(data, i + 10) == 99 and native_read_u8(data, i + 11) == 32 do
                pref_len = 12
                is_const = 1
            end
            if i + 4 <= n and native_read_u8(data, i) == 118 and native_read_u8(data, i + 1) == 97 and native_read_u8(data, i + 2) == 114 and native_read_u8(data, i + 3) == 32 do
                pref_len = 4
                is_const = 1
            end
            if i + 4 <= n and native_read_u8(data, i) == 108 and native_read_u8(data, i + 1) == 101 and native_read_u8(data, i + 2) == 116 and native_read_u8(data, i + 3) == 32 do
                pref_len = 4
                is_const = 1
            end
            if pref_len > 0 do
                j = i + pref_len
                when j < n and (native_read_u8(data, j) == 32 or native_read_u8(data, j) == 9) loop
                    j = j + 1
                end
                if text_eq_ident(data, j, fl, fname) == 1 do
                    after = j + fl
                    if after >= n or text_is_ident_char(native_read_u8(data, after)) == 0 do
                        g_imp_chunk_line = source_line
                        if is_const == 1 do
                            k = after
                            when k < n and native_read_u8(data, k) != 10 loop
                                k = k + 1
                            end
                            if k < n and native_read_u8(data, k) == 10 do
                                k = k + 1
                            end
                            out text_fat_from_range(data, i, k - i)
                        else
                            k = after
                            when k + 4 <= n loop
                                if native_read_u8(data, k) == 101 and native_read_u8(data, k + 1) == 110 and native_read_u8(data, k + 2) == 100 and native_read_u8(data, k + 3) == 46 do
                                    after_end = k + 4
                                    if after_end >= n or native_read_u8(data, after_end) == 10 or native_read_u8(data, after_end) == 32 or native_read_u8(data, after_end) == 9 or native_read_u8(data, after_end) == 13 do
                                        out text_fat_from_range(data, i, after_end - i)
                                    end
                                end
                                k = k + 1
                            end
                            out 0
                        end
                    end
                end
            end
        end
        ch = native_read_u8(data, i)
        if ch == 10 do
            at_line = 1
            source_line = source_line + 1
        else
            if ch != 32 and ch != 9 do
                at_line = 0
            end
        end
        i = i + 1
    end
    out 0
end.

func text_fat_append_nl_sym(list: int, sym: int):
    # list + "\n" + sym
    ad = native_read_i64(list, 0)
    al = native_read_i64(list, 8)
    sd = native_read_i64(sym, 0)
    sl = native_read_i64(sym, 8)
    nb = vir_alloc(al + 1 + sl + 1)
    i = 0
    when i < al loop
        native_write_u8(nb, i, native_read_u8(ad, i))
        i = i + 1
    end
    native_write_u8(nb, al, 10)
    j = 0
    when j < sl loop
        native_write_u8(nb, al + 1 + j, native_read_u8(sd, j))
        j = j + 1
    end
    native_write_u8(nb, al + 1 + sl, 0)
    out str_from_cstr(nb)
end.

func text_rename_func_chunk(chunk: int, old_name: int, new_name: int):
    # Rewrite leading "func <old>" → "func <new>" inside extracted chunk.
    cd = native_read_i64(chunk, 0)
    cl = native_read_i64(chunk, 8)
    od = native_read_i64(old_name, 0)
    ol = native_read_i64(old_name, 8)
    nd = native_read_i64(new_name, 0)
    nl = native_read_i64(new_name, 8)
    # Expect "func " at 0
    if cl < 5 + ol do
        out chunk
    end
    if native_read_u8(cd, 0) != 102 do
        out chunk
    end
    # Skip "func " and spaces to name start
    j = 5
    when j < cl and (native_read_u8(cd, j) == 32 or native_read_u8(cd, j) == 9) loop
        j = j + 1
    end
    if text_eq_ident(cd, j, ol, old_name) == 0 do
        out chunk
    end
    # prefix = chunk[0..j), then new_name, then chunk[j+ol..)
    prefix_len = j
    suffix_start = j + ol
    suffix_len = cl - suffix_start
    nb = vir_alloc(prefix_len + nl + suffix_len + 1)
    a = 0
    when a < prefix_len loop
        native_write_u8(nb, a, native_read_u8(cd, a))
        a = a + 1
    end
    b = 0
    when b < nl loop
        native_write_u8(nb, prefix_len + b, native_read_u8(nd, b))
        b = b + 1
    end
    c = 0
    when c < suffix_len loop
        native_write_u8(nb, prefix_len + nl + c, native_read_u8(cd, suffix_start + c))
        c = c + 1
    end
    native_write_u8(nb, prefix_len + nl + suffix_len, 0)
    out str_from_cstr(nb)
end.

func text_parse_import_at(source: int, at: int):
    data = native_read_i64(source, 0)
    n = native_read_i64(source, 8)
    i = at
    g_imp_alias = 0
    g_imp_syms = 0
    g_imp_aliases = 0
    g_imp_sym_count = 0
    g_imp_mod = 0
    g_imp_end = 0

    # Check if starting with "from " (102, 114, 111, 109, 32)
    if i + 5 <= n and native_read_u8(data, i) == 102 and native_read_u8(data, i + 1) == 114 and native_read_u8(data, i + 2) == 111 and native_read_u8(data, i + 3) == 109 and native_read_u8(data, i + 4) == 32 do
        i = i + 5
        i = text_skip_hspace(data, n, i)
        # Read module name
        if i < n and native_read_u8(data, i) == 34 do
            i = i + 1
            ms = i
            when i < n and native_read_u8(data, i) != 34 loop
                i = i + 1
            end
            if i <= ms do out 0 end
            g_imp_mod = text_fat_from_range(data, ms, i - ms)
            if i < n and native_read_u8(data, i) == 34 do i = i + 1 end
        else
            ms = i
            when i < n and (text_is_ident_char(native_read_u8(data, i)) == 1 or native_read_u8(data, i) == 46 or native_read_u8(data, i) == 47) loop
                i = i + 1
            end
            if i <= ms do out 0 end
            g_imp_mod = text_fat_from_range(data, ms, i - ms)
        end
        i = text_skip_import_ws(data, n, i)
        # Require "import" (6 letters: 105, 109, 112, 111, 114, 116)
        if i + 6 > n or native_read_u8(data, i) != 105 or native_read_u8(data, i + 1) != 109 or native_read_u8(data, i + 2) != 112 or native_read_u8(data, i + 3) != 111 or native_read_u8(data, i + 4) != 114 or native_read_u8(data, i + 5) != 116 do
            out 0
        end
        i = i + 6
        i = text_skip_import_ws(data, n, i)
        # Collect symbols: sym [as alias], sym2 [as alias2]
        var looping = 1
        when looping == 1 loop
            ss = i
            when i < n and text_is_ident_char(native_read_u8(data, i)) == 1 loop
                i = i + 1
            end
            if i <= ss do out 0 end
            sym = text_fat_from_range(data, ss, i - ss)
            i = text_skip_import_ws(data, n, i)
            # Check for "as <alias>"
            var alias = sym
            if i + 3 <= n and native_read_u8(data, i) == 97 and native_read_u8(data, i + 1) == 115 and (native_read_u8(data, i + 2) == 32 or native_read_u8(data, i + 2) == 9) do
                i = i + 2
                i = text_skip_hspace(data, n, i)
                as0 = i
                when i < n and text_is_ident_char(native_read_u8(data, i)) == 1 loop
                    i = i + 1
                end
                if i > as0 do
                    alias = text_fat_from_range(data, as0, i - as0)
                end
                i = text_skip_import_ws(data, n, i)
            end
            if g_imp_sym_count == 0 do
                g_imp_syms = sym
                g_imp_aliases = alias
            else
                g_imp_syms = text_fat_append_nl_sym(g_imp_syms, sym)
                g_imp_aliases = text_fat_append_nl_sym(g_imp_aliases, alias)
            end
            g_imp_sym_count = g_imp_sym_count + 1
            if i < n and native_read_u8(data, i) == 44 do
                i = i + 1
                i = text_skip_import_ws(data, n, i)
            else
                looping = 0
            end
        end
        g_imp_end = text_import_stmt_end(data, n, i)
        out 1
    end

    # Otherwise expect "import " (105, 109, 112, 111, 114, 116, 32)
    i = at + 7
    i = text_skip_hspace(data, n, i)
    if i < n and native_read_u8(data, i) == 42 do
        i = i + 1
        i = text_skip_hspace(data, n, i)
        if i + 5 <= n and native_read_u8(data, i) == 102 and native_read_u8(data, i + 1) == 114 and native_read_u8(data, i + 2) == 111 and native_read_u8(data, i + 3) == 109 and native_read_u8(data, i + 4) == 32 do
            i = i + 5
            i = text_skip_hspace(data, n, i)
            let ms = i
            when i < n and (text_is_ident_char(native_read_u8(data, i)) == 1 or native_read_u8(data, i) == 46 or native_read_u8(data, i) == 47) loop
                i = i + 1
            end
            if i <= ms do out 0 end
            g_imp_mod = text_fat_from_range(data, ms, i - ms)
            g_imp_sym_count = 0
            g_imp_syms = 0
            g_imp_aliases = 0
            g_imp_end = text_import_stmt_end(data, n, i)
            out 1
        end
        out 0
    end
    # First ident / path
    start = i
    when i < n and (text_is_ident_char(native_read_u8(data, i)) == 1 or native_read_u8(data, i) == 46 or native_read_u8(data, i) == 47) loop
        i = i + 1
    end
    if i <= start do out 0 end
    first = text_fat_from_range(data, start, i - start)
    i = text_skip_hspace(data, n, i)
    # Check if first has optional "as alias" before "from" or at end
    var first_alias = first
    if i + 3 <= n and native_read_u8(data, i) == 97 and native_read_u8(data, i + 1) == 115 and (native_read_u8(data, i + 2) == 32 or native_read_u8(data, i + 2) == 9) do
        i = i + 2
        i = text_skip_hspace(data, n, i)
        as0 = i
        when i < n and text_is_ident_char(native_read_u8(data, i)) == 1 loop
            i = i + 1
        end
        if i > as0 do
            first_alias = text_fat_from_range(data, as0, i - as0)
        end
        i = text_skip_hspace(data, n, i)
    end

    # Check if this is selective: "from ..." or comma
    is_sel = 0
    if i + 4 <= n and native_read_u8(data, i) == 102 and native_read_u8(data, i + 1) == 114 and native_read_u8(data, i + 2) == 111 and native_read_u8(data, i + 3) == 109 do
        is_sel = 1
    end
    if i < n and native_read_u8(data, i) == 44 do
        is_sel = 1
    end
    if is_sel == 0 do
        # import mod [as alias]
        g_imp_mod = first
        if not rt_streq(first_alias, first) do
            g_imp_alias = first_alias
        end
        g_imp_end = text_import_stmt_end(data, n, i)
        out 2
    end

    # Collect symbols starting with first
    g_imp_syms = first
    g_imp_aliases = first_alias
    g_imp_sym_count = 1
    when i < n and native_read_u8(data, i) == 44 loop
        i = i + 1
        i = text_skip_import_ws(data, n, i)
        ss = i
        when i < n and text_is_ident_char(native_read_u8(data, i)) == 1 loop
            i = i + 1
        end
        if i <= ss do out 0 end
        sym = text_fat_from_range(data, ss, i - ss)
        i = text_skip_import_ws(data, n, i)
        var sym_alias = sym
        if i + 3 <= n and native_read_u8(data, i) == 97 and native_read_u8(data, i + 1) == 115 and (native_read_u8(data, i + 2) == 32 or native_read_u8(data, i + 2) == 9) do
            i = i + 2
            i = text_skip_hspace(data, n, i)
            as0 = i
            when i < n and text_is_ident_char(native_read_u8(data, i)) == 1 loop
                i = i + 1
            end
            if i > as0 do
                sym_alias = text_fat_from_range(data, as0, i - as0)
            end
            i = text_skip_import_ws(data, n, i)
        end
        g_imp_syms = text_fat_append_nl_sym(g_imp_syms, sym)
        g_imp_aliases = text_fat_append_nl_sym(g_imp_aliases, sym_alias)
        g_imp_sym_count = g_imp_sym_count + 1
    end

    # Require "from"
    if i + 4 > n or native_read_u8(data, i) != 102 or native_read_u8(data, i + 1) != 114 or native_read_u8(data, i + 2) != 111 or native_read_u8(data, i + 3) != 109 do
        out 0
    end
    i = i + 4
    i = text_skip_import_ws(data, n, i)
    # Module: bare ident or "quoted/path.vri"
    if i < n and native_read_u8(data, i) == 34 do
        i = i + 1
        ms = i
        when i < n and native_read_u8(data, i) != 34 loop
            i = i + 1
        end
        if i <= ms do out 0 end
        g_imp_mod = text_fat_from_range(data, ms, i - ms)
        if i < n and native_read_u8(data, i) == 34 do i = i + 1 end
    else
        ms = i
        when i < n and (text_is_ident_char(native_read_u8(data, i)) == 1 or native_read_u8(data, i) == 46 or native_read_u8(data, i) == 47) loop
            i = i + 1
        end
        if i <= ms do out 0 end
        g_imp_mod = text_fat_from_range(data, ms, i - ms)
    end
    # Optional trailing "as <alias>" (Vir form: import <sym> from <mod> as <alias>).
    i = text_skip_hspace(data, n, i)
    if g_imp_sym_count == 1 and i + 3 <= n and native_read_u8(data, i) == 97 and native_read_u8(data, i + 1) == 115 and (native_read_u8(data, i + 2) == 32 or native_read_u8(data, i + 2) == 9) do
        i = i + 2
        i = text_skip_hspace(data, n, i)
        as0 = i
        when i < n and text_is_ident_char(native_read_u8(data, i)) == 1 loop
            i = i + 1
        end
        if i > as0 do
            g_imp_aliases = text_fat_from_range(data, as0, i - as0)
        end
    end
    g_imp_end = text_import_stmt_end(data, n, i)
    out 1
end.

func text_skip_import_stmt(source: int, at: int):
    if g_imp_end > at do
        out g_imp_end
    end
    data = native_read_i64(source, 0)
    n = native_read_i64(source, 8)
    i = at
    when i < n loop
        c = native_read_u8(data, i)
        i = i + 1
        if c == 59 or c == 10 do
            out i
        end
    end
    out n
end.

func text_validate_import_exports(mod_body: int):
    # A selective import of a module with nested includes splices the whole
    # source, but it must still enforce that the module exports each symbol.
    let sym_data = native_read_i64(g_imp_syms, 0)
    let sym_len = native_read_i64(g_imp_syms, 8)
    var pos = 0
    when pos < sym_len loop
        let start = pos
        when pos < sym_len and native_read_u8(sym_data, pos) != 10 loop
            pos = pos + 1
        end
        if pos > start do
            let sym = text_fat_from_range(sym_data, start, pos - start)
            if text_has_export(mod_body, sym) == 0 do
                inc_set_error(2113)
                out 0
            end
        end
        pos = pos + 1
    end
    out 1
end.

func text_build_import_body(mod_body: int, alias_only: int):
    let importSourcePath = g_inc_resolved_path
    # If g_imp_sym_count == 0 → whole module. Else extract each exported func.
    # alias_only=1 → emit only symbols that are renamed (alias != name); used when
    # the module was already brought in via `include` and we just need alias shims.
    if g_imp_sym_count == 0 do
        if alias_only == 1 do
            out 0
        end
        out mod_body
    end
    if alias_only == 0 and (text_find_include(mod_body) >= 0 or text_find_import(mod_body) >= 0) do
        if text_validate_import_exports(mod_body) == 0 do
            out 0
        end
        out mod_body
    end
    if alias_only == 1 and g_imp_aliases == 0 do
        out 0
    end
    sd = native_read_i64(g_imp_syms, 0)
    sl = native_read_i64(g_imp_syms, 8)
    ad = native_read_i64(g_imp_aliases, 0)
    al = native_read_i64(g_imp_aliases, 8)
    out_buf = 0
    out_len = 0
    p = 0
    var ap = 0
    when p < sl loop
        s0 = p
        when p < sl and native_read_u8(sd, p) != 10 loop
            p = p + 1
        end
        a0 = ap
        when ap < al and native_read_u8(ad, ap) != 10 loop
            ap = ap + 1
        end
        if p > s0 do
            fname = text_fat_from_range(sd, s0, p - s0)
            var alias_name = fname
            if ap > a0 do
                alias_name = text_fat_from_range(ad, a0, ap - a0)
            end
            # Even if an included module needs no alias shim, selective import
            if text_has_export(mod_body, fname) == 0 do
                inc_set_error(2113)
                out 0
            end
            var skip_sym = 0
            if alias_only == 1 and fat_str_eq(fname, alias_name) == 1 do
                skip_sym = 1
            end
            if skip_sym == 0 do
                chunk = text_extract_func(mod_body, fname)
                if chunk == 0 do
                    chunk = text_extract_enum_for_variant(mod_body, fname)
                end
                if chunk == 0 do
                    inc_set_error(2113)
                    out 0
                end
            end
            if alias_only == 0 and skip_sym == 0 and out_len > 0 and out_buf != 0 do
                let ckd = native_read_i64(chunk, 0)
                let ckl = native_read_i64(chunk, 8)
                if ckl >= 5 and native_read_u8(ckd, 0) == 101 and native_read_u8(ckd, 1) == 110 and native_read_u8(ckd, 2) == 117 and native_read_u8(ckd, 3) == 109 and native_read_u8(ckd, 4) == 32 do
                    var ei = 5
                    when ei < ckl and (native_read_u8(ckd, ei) == 32 or native_read_u8(ckd, ei) == 9) loop
                        ei = ei + 1
                    end
                    let es = ei
                    when ei < ckl and text_is_ident_char(native_read_u8(ckd, ei)) == 1 loop
                        ei = ei + 1
                    end
                    let elen = ei - es
                    if text_contains_enum(out_buf, out_len, ckd, es, elen) == 1 do
                        skip_sym = 1
                    end
                end
            end
            if skip_sym == 0 do
                if g_ideFactsEnabled == 1 do
                    let origin = vir_alloc(48)
                    native_write_i64(origin, 0, alias_name)
                    native_write_i64(origin, 8, fname)
                    native_write_i64(origin, 16, importSourcePath)
                    native_write_i64(origin, 24, g_ideImportParentFile)
                    native_write_i64(origin, 32, g_ideImportParentLine)
                    native_write_i64(origin, 40, g_imp_chunk_line)
                    g_ideImportOrigins = vec_push_rt(g_ideImportOrigins, origin)
                end
                if fat_str_eq(fname, alias_name) == 0 do
                    chunk = text_rename_func_chunk(chunk, fname, alias_name)
                end
                if g_ideFactsEnabled == 1 do
                    chunk = inc_wrap_source_at(chunk, importSourcePath, g_imp_chunk_line, importSourcePath, g_imp_chunk_line)
                end
                cd = native_read_i64(chunk, 0)
                cl = native_read_i64(chunk, 8)
                nb = vir_alloc(out_len + cl + 2)
                a = 0
                when a < out_len loop
                    native_write_u8(nb, a, native_read_u8(out_buf, a))
                    a = a + 1
                end
                b = 0
                when b < cl loop
                    native_write_u8(nb, out_len + b, native_read_u8(cd, b))
                    b = b + 1
                end
                native_write_u8(nb, out_len + cl, 10)
                native_write_u8(nb, out_len + cl + 1, 0)
                out_buf = nb
                out_len = out_len + cl + 1
            end
        end
        if p < sl and native_read_u8(sd, p) == 10 do
            p = p + 1
        end
        if ap < al and native_read_u8(ad, ap) == 10 do
            ap = ap + 1
        end
    end
    if out_len <= 0 or out_buf == 0 do
        out 0
    end
    out str_from_cstr(out_buf)
end.

func expand_imports_text(source: int):
    guard = 0
    when guard < G_PREPROCESS_MAX loop
        guard = guard + 1
        at = text_find_import(source)
        if at < 0 do
            out source
        end
        if text_line_has_double_colon(source, at) == 1 do
            inc_locate_marker_before(source, at)
            inc_report_early_error(2103, g_inc_cur_parent_file, g_inc_cur_parent_line, "")
            out source
        end
        kind = text_parse_import_at(source, at)
        if kind == 0 or g_imp_mod == 0 do
            inc_locate_marker_before(source, at)
            inc_report_early_error(2111, g_inc_cur_parent_file, g_inc_cur_parent_line, "")
            out source
        end
        end_at = text_skip_import_stmt(source, at)
        inc_locate_marker_before(source, at)
        let import_parent_file = g_inc_cur_parent_file
        let import_parent_line = g_inc_cur_parent_line
        let import_resume_line = import_parent_line + inc_count_newlines(source, at, end_at)
        g_inc_resolved_path = 0
        body = read_include_source(g_imp_mod)
        ideCaptureResolvedModule(g_imp_mod, import_parent_file, import_parent_line, body)
        if ide_enabled() == 1 do
            var is_root = 0
            if g_inc_main_file == 0 do
                is_root = 1
            eif import_parent_file != 0 and rt_streq(import_parent_file, g_inc_main_file) == 1 do
                is_root = 1
            end
            if is_root == 1 do
                var mod_res = 0
                if body != 0 do mod_res = 1 end
                ide_register_module(g_imp_mod, g_imp_alias, import_parent_line, 0, mod_res)
                if g_imp_sym_count > 0 and g_imp_syms != 0 and g_imp_aliases != 0 do
                    let sd = native_read_i64(g_imp_syms, 0)
                    let sl = native_read_i64(g_imp_syms, 8)
                    let ad = native_read_i64(g_imp_aliases, 0)
                    let al = native_read_i64(g_imp_aliases, 8)
                    var p = 0
                    var ap = 0
                    when p < sl loop
                        let s0 = p
                        when p < sl and native_read_u8(sd, p) != 10 loop
                            p = p + 1
                        end
                        let a0 = ap
                        when ap < al and native_read_u8(ad, ap) != 10 loop
                            ap = ap + 1
                        end
                        if p > s0 do
                            let fname = text_fat_from_range(sd, s0, p - s0)
                            var aname = fname
                            if ap > a0 do
                                aname = text_fat_from_range(ad, a0, ap - a0)
                            end
                            ide_register_import(aname, fname, g_imp_mod, import_parent_line)
                        end
                        p = p + 1
                        ap = ap + 1
                    end
                end
            end
        end
        if body == 0 do
            inc_report_early_error(2112, import_parent_file, import_parent_line, native_read_i64(g_imp_mod, 0) as string)
            out source
        end
        var body_path = g_inc_resolved_path
        if body_path == 0 do body_path = native_read_i64(g_imp_mod as i64, 0) end
        if inc_validate_utf8_source(body, body_path) == 0 do out source end
        g_imp_chunk_line = 1
        var imp_key = g_inc_canonical_id
        if imp_key == 0 do
            imp_key = g_inc_resolved_path
        end
        if imp_key == 0 do
            imp_key = native_read_i64(g_imp_mod as i64, 0)
        end
        if check_active_cycle(source, at, imp_key) == 1 do
            inc_set_error(2105)
            out source
        end
        let imp_key_fat = str_from_cstr(imp_key)
        # Already pulled in via include/import — the exported names are already
        # in scope, so we only need rename shims for aliased imports.
        if g_inc_has(imp_key_fat) == 1 do
            var shim = 0
            g_ideImportParentFile = import_parent_file
            g_ideImportParentLine = import_parent_line
            shim = text_build_import_body(body, 1)
            if g_inc_err == 3 do
                inc_report_early_error(2113, import_parent_file, import_parent_line, native_read_i64(g_imp_mod, 0) as string)
                out source
            end
            if shim == 0 do
                ebuf = vir_alloc(1)
                native_write_u8(ebuf, 0, 0)
                shim = str_from_cstr(ebuf)
            end
            if shim != 0 do
                shim = inc_wrap_source_at(shim, body_path, g_imp_chunk_line, import_parent_file, import_resume_line)
            end
            source = text_splice_at(source, at, end_at, shim)
        else
            g_ideImportParentFile = import_parent_file
            g_ideImportParentLine = import_parent_line
            piece = text_build_import_body(body, 0)
            if piece == 0 do
                if g_imp_sym_count > 0 do
                    inc_report_early_error(2113, import_parent_file, import_parent_line, native_read_i64(g_imp_mod, 0) as string)
                    out source
                end
                # No export list (stdlib modules): splice whole module once.
                if g_inc_err == 3 do
                    g_inc_err = 0
                    g_inc_mark(imp_key_fat)
                    piece = body
                else
                    inc_report_early_error(2113, import_parent_file, import_parent_line, native_read_i64(g_imp_mod, 0) as string)
                    out source
                end
            end
            g_inc_mark(imp_key_fat)
            piece = inc_wrap_source_with_mod_at(piece, body_path, g_imp_chunk_line, import_parent_file, import_resume_line, imp_key)
            source = text_splice_at(source, at, end_at, piece)
        end
    end
    if guard >= G_PREPROCESS_MAX do
        inc_report_early_error(2114, g_inc_cur_parent_file, g_inc_cur_parent_line, "")
    end
    out source
end.

