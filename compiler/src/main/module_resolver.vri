##
 * compiler/src/main/module_resolver.vri — Project Registry Loading & Module Resolution
 * =====================================================================================
 ##

include rt.alloc
import vir_alloc from rt.alloc
include rt.string_rt
import fat_str_new, fat_str_len, fat_str_byte_at, fat_cstr_eq, fat_str_concat, fat_str_eq, rt_streq, str_from_cstr, rt_strlen, rt_itoa, vir_free from rt.string_rt
include rt.vec_rt
import bvec_len, bvec_get, vec_len_rt, vec_get_rt, vec_new_rt, vec_push_rt from rt.vec_rt
include rt.io
import read_file_str, print_str, print_ln, print_int, print_newline from rt.io
include main_path_util

func virc_registry_load:
    if g_reg_loaded == 1 do
        out 0
    end
    g_reg_names = vir_alloc(G_REG_MAX * 8)
    g_reg_paths = vir_alloc(G_REG_MAX * 8)
    g_reg_phys = vir_alloc(G_REG_MAX * 8)
    g_reg_lines = vir_alloc(G_REG_MAX * 8)
    g_reg_source = vir_alloc(G_REG_MAX * 8)
    g_reg_isdir = vir_alloc(G_REG_MAX * 8)

    var reg_path = g_ideStdlibRegistry
    if reg_path == 0 do
        if g_inc_base != 0 do
        reg_path = find_file_up(g_inc_base, "stdlib/stdlib.vri" as int)
        end
    end
    if reg_path == 0 do
        if file_exists_cstr("stdlib/stdlib.vri" as int) == 1 do
            reg_path = "stdlib/stdlib.vri" as int
        eif file_exists_cstr("../stdlib/stdlib.vri" as int) == 1 do
            reg_path = "../stdlib/stdlib.vri" as int
        eif file_exists_cstr("../../stdlib/stdlib.vri" as int) == 1 do
            reg_path = "../../stdlib/stdlib.vri" as int
        end
    end
    if reg_path == 0 do
        inc_report_early_error(2120, "stdlib/stdlib.vri" as int, 1, "failed to locate stdlib/stdlib.vri")
        out 1
    end

    let rcontent = read_file_str(reg_path)
    if rcontent == 0 do
        inc_report_early_error(2120, reg_path, 1, "cannot read stdlib/stdlib.vri")
        out 1
    end

    let rplen = rt_strlen(reg_path)
    var has_slash = 0
    var last_slash = 0
    var rpi = 0
    when rpi < rplen loop
        if native_read_u8(reg_path, rpi) == 47 do
            has_slash = 1
            last_slash = rpi
        end
        rpi = rpi + 1
    end
    var stdlib_parent = "stdlib" as int
    if has_slash == 1 do
        let sp_buf = vir_alloc(last_slash + 1)
        var spi = 0
        when spi < last_slash loop
            native_write_u8(sp_buf, spi, native_read_u8(reg_path, spi))
            spi = spi + 1
        end
        native_write_u8(sp_buf, last_slash, 0)
        stdlib_parent = sp_buf
    end
    g_reg_stdlib_dir = join_path_cstr(stdlib_parent, "vir" as int)
    g_reg_root = "vir" as int

    let total_len = rt_strlen(rcontent)
    var pos = 0
    var line_no = 1
    var count = 0

    when pos < total_len loop
        let line_start = pos
        when pos < total_len and native_read_u8(rcontent, pos) != 10 loop
            pos = pos + 1
        end
        let line_end = pos
        if pos < total_len and native_read_u8(rcontent, pos) == 10 do
            pos = pos + 1
        end

        var p = line_start
        when p < line_end and (native_read_u8(rcontent, p) == 32 or native_read_u8(rcontent, p) == 9 or native_read_u8(rcontent, p) == 13) loop
            p = p + 1
        end
        if p < line_end and native_read_u8(rcontent, p) != 35 do
            var eq = p
            when eq < line_end and native_read_u8(rcontent, eq) != 61 loop
                eq = eq + 1
            end
            if eq >= line_end do
                inc_report_early_error(2120, reg_path, line_no, "malformed entry")
                out 1
            end

            let klen = eq - p
            let kbuf = vir_alloc(klen + 1)
            var ki = 0
            when ki < klen loop
                native_write_u8(kbuf, ki, native_read_u8(rcontent, p + ki))
                ki = ki + 1
            end
            native_write_u8(kbuf, klen, 0)
            let key = trim_cstr(kbuf)

            let vlen = line_end - (eq + 1)
            let vbuf = vir_alloc(vlen + 1)
            var vi = 0
            when vi < vlen loop
                native_write_u8(vbuf, vi, native_read_u8(rcontent, eq + 1 + vi))
                vi = vi + 1
            end
            native_write_u8(vbuf, vlen, 0)
            let val = trim_cstr(vbuf)

            if rt_streq(key, "root" as int) == 1 do
                g_reg_root = val
                g_reg_stdlib_dir = join_path_cstr(stdlib_parent, val)
            else
                var found_dup = 0
                var dup_line = 0
                var dup_path = 0
                var si = 0
                when si < count loop
                    let s_name = native_read_i64(g_reg_names, si * 8)
                    if rt_streq(s_name, key) == 1 do
                        found_dup = 1
                        dup_line = native_read_i64(g_reg_lines, si * 8)
                        dup_path = native_read_i64(g_reg_paths, si * 8)
                        break
                    end
                    si = si + 1
                end
                if found_dup == 1 do
                    inc_report_early_error(2121, reg_path, line_no, key as string)
                    out 1
                end

                let phys = join_path_cstr(g_reg_stdlib_dir, val)
                if file_exists_cstr(phys) == 0 do
                    inc_report_early_error(2122, reg_path, line_no, key as string)
                    out 1
                end

                if count < G_REG_MAX do
                    native_write_i64(g_reg_names, count * 8, key)
                    native_write_i64(g_reg_paths, count * 8, val)
                    native_write_i64(g_reg_phys, count * 8, phys)
                    native_write_i64(g_reg_lines, count * 8, line_no)
                    native_write_i64(g_reg_source, count * 8, 1)
                    native_write_i64(g_reg_isdir, count * 8, 0)
                    count = count + 1
                end
            end
        end
        line_no = line_no + 1
    end
    g_reg_stdlib_count = count

    var mod_list_path = 0
    if g_inc_base != 0 do
        mod_list_path = find_file_up(g_inc_base, "module.list" as int)
    end
    if mod_list_path == 0 and file_exists_cstr("module.list" as int) == 1 do
        mod_list_path = "module.list" as int
    end
    if mod_list_path == 0 and g_inc_base != 0 do
        mod_list_path = find_file_up(g_inc_base, "compiler/module.list" as int)
    end
    if mod_list_path == 0 and file_exists_cstr("compiler/module.list" as int) == 1 do
        mod_list_path = "compiler/module.list" as int
    end

    if mod_list_path != 0 do
        let mcontent = read_file_str(mod_list_path)
        if mcontent != 0 do
            let ml_len = rt_strlen(mod_list_path)
            var has_ml_slash = 0
            var ml_slash = 0
            var mi = 0
            when mi < ml_len loop
                if native_read_u8(mod_list_path, mi) == 47 do
                    has_ml_slash = 1
                    ml_slash = mi
                end
                mi = mi + 1
            end
            var proj_dir = "." as int
            if has_ml_slash == 1 do
                let pd_buf = vir_alloc(ml_slash + 1)
                var pdi = 0
                when pdi < ml_slash loop
                    native_write_u8(pd_buf, pdi, native_read_u8(mod_list_path, pdi))
                    pdi = pdi + 1
                end
                native_write_u8(pd_buf, ml_slash, 0)
                proj_dir = pd_buf
            end
            g_reg_project_root = proj_dir

            let mtotal = rt_strlen(mcontent)
            var mpos = 0
            var mline = 1
            when mpos < mtotal loop
                let m_start = mpos
                when mpos < mtotal and native_read_u8(mcontent, mpos) != 10 loop
                    mpos = mpos + 1
                end
                let m_end = mpos
                if mpos < mtotal and native_read_u8(mcontent, mpos) == 10 do
                    mpos = mpos + 1
                end

                var mp = m_start
                when mp < m_end and (native_read_u8(mcontent, mp) == 32 or native_read_u8(mcontent, mp) == 9 or native_read_u8(mcontent, mp) == 13) loop
                    mp = mp + 1
                end
                if mp < m_end and native_read_u8(mcontent, mp) != 35 do
                    var meq = mp
                    when meq < m_end and native_read_u8(mcontent, meq) != 61 loop
                        meq = meq + 1
                    end
                    if meq < m_end do
                        let mklen = meq - mp
                        let mkbuf = vir_alloc(mklen + 1)
                        var mki = 0
                        when mki < mklen loop
                            native_write_u8(mkbuf, mki, native_read_u8(mcontent, mp + mki))
                            mki = mki + 1
                        end
                        native_write_u8(mkbuf, mklen, 0)
                        let mkey = trim_cstr(mkbuf)

                        let mvlen = m_end - (meq + 1)
                        let mvbuf = vir_alloc(mvlen + 1)
                        var mvi = 0
                        when mvi < mvlen loop
                            native_write_u8(mvbuf, mvi, native_read_u8(mcontent, meq + 1 + mvi))
                            mvi = mvi + 1
                        end
                        native_write_u8(mvbuf, mvlen, 0)
                        let mval = trim_cstr(mvbuf)

                        if rt_streq(mkey, "root" as int) == 1 do
                            g_reg_project_root = join_path_cstr(proj_dir, mval)
                        else
                            var p_found = 0
                            var p_prev_line = 0
                            var p_i = g_reg_stdlib_count
                            when p_i < count loop
                                let pn = native_read_i64(g_reg_names, p_i * 8)
                                if rt_streq(pn, mkey) == 1 do
                                    p_found = 1
                                    p_prev_line = native_read_i64(g_reg_lines, p_i * 8)
                                    break
                                end
                                p_i = p_i + 1
                            end
                            if p_found == 1 do
                                inc_report_early_error(2121, mod_list_path, mline, mkey as string)
                                out 1
                            end

                            var c_found = 0
                            var c_prev_line = 0
                            var ci = 0
                            when ci < g_reg_stdlib_count loop
                                let sn = native_read_i64(g_reg_names, ci * 8)
                                if rt_streq(sn, mkey) == 1 do
                                    c_found = 1
                                    c_prev_line = native_read_i64(g_reg_lines, ci * 8)
                                    break
                                end
                                ci = ci + 1
                            end
                            if c_found == 1 do
                                inc_report_early_error(2123, mod_list_path, mline, mkey as string)
                                out 1
                            end

                            let is_vri_file = fat_ends_with_vri(str_from_cstr(mval))
                            var is_dir = 1
                            var mphys = join_path_cstr(g_reg_project_root, mval)
                            if is_vri_file == 1 do
                                is_dir = 0
                                if file_exists_cstr(mphys) == 0 do
                                    inc_report_early_error(2124, mod_list_path, mline, mkey as string)
                                    out 1
                                end
                            end

                            if count < G_REG_MAX do
                                native_write_i64(g_reg_names, count * 8, mkey)
                                native_write_i64(g_reg_paths, count * 8, mval)
                                native_write_i64(g_reg_phys, count * 8, mphys)
                                native_write_i64(g_reg_lines, count * 8, mline)
                                native_write_i64(g_reg_source, count * 8, 2)
                                native_write_i64(g_reg_isdir, count * 8, is_dir)
                                count = count + 1
                            end
                        end
                    end
                end
                mline = mline + 1
            end
        end
    end

    g_reg_count = count
    g_reg_loaded = 1
    out 0
end.

func resolve_include_target(mod_name: int):
    if g_reg_loaded == 0 do
        virc_registry_load()
    end
    if g_inc_err != 0 do
        out 0
    end
    let nd = native_read_i64(mod_name as i64, 0)
    let nl = native_read_i64(mod_name as i64, 8)
    if nd == 0 or nl <= 0 do
        out 0
    end

    # Step 1: Project registry lookup
    var pi = g_reg_stdlib_count
    when pi < g_reg_count loop
        let is_dir = native_read_i64(g_reg_isdir, pi * 8)
        let pname = native_read_i64(g_reg_names, pi * 8)
        if is_dir == 0 and fat_cstr_eq(mod_name, pname) == 1 do
            let phys = native_read_i64(g_reg_phys, pi * 8)
            g_inc_canonical_id = join_path_cstr("project::" as int, pname)
            g_inc_resolved_path = phys
            out try_read_file(str_from_cstr(phys))
        end
        pi = pi + 1
    end

    var has_dot = 0
    var dot_pos = 0
    var di = 0
    when di < nl loop
        if native_read_u8(nd, di) == 46 do
            has_dot = 1
            dot_pos = di
            break
        end
        di = di + 1
    end
    if has_dot == 1 and dot_pos > 0 do
        let pref_buf = vir_alloc(dot_pos + 1)
        var pj = 0
        when pj < dot_pos loop
            native_write_u8(pref_buf, pj, native_read_u8(nd, pj))
            pj = pj + 1
        end
        native_write_u8(pref_buf, dot_pos, 0)
        let pref_fat = str_from_cstr(pref_buf)

        var pdi = g_reg_stdlib_count
        when pdi < g_reg_count loop
            let is_dir = native_read_i64(g_reg_isdir, pdi * 8)
            let pname = native_read_i64(g_reg_names, pdi * 8)
            if is_dir == 1 and fat_cstr_eq(pref_fat, pname) == 1 do
                let tail_len = nl - (dot_pos + 1)
                let tail_buf = vir_alloc(tail_len + 5)
                var tj = 0
                when tj < tail_len loop
                    let tc = native_read_u8(nd, dot_pos + 1 + tj)
                    if tc == 46 do
                        native_write_u8(tail_buf, tj, 47)
                    else
                        native_write_u8(tail_buf, tj, tc)
                    end
                    tj = tj + 1
                end
                var ends_vri = 0
                if tail_len >= 4 and native_read_u8(tail_buf, tail_len - 4) == 46 and native_read_u8(tail_buf, tail_len - 3) == 118 and native_read_u8(tail_buf, tail_len - 2) == 114 and native_read_u8(tail_buf, tail_len - 1) == 105 do
                    ends_vri = 1
                end
                var final_tail_len = tail_len
                if ends_vri == 0 do
                    native_write_u8(tail_buf, tail_len, 46)
                    native_write_u8(tail_buf, tail_len + 1, 118)
                    native_write_u8(tail_buf, tail_len + 2, 114)
                    native_write_u8(tail_buf, tail_len + 3, 105)
                    final_tail_len = tail_len + 4
                end
                native_write_u8(tail_buf, final_tail_len, 0)

                let target_path = join_path_cstr(native_read_i64(g_reg_phys, pdi * 8), tail_buf)
                if file_exists_cstr(target_path) == 0 do
                    inc_report_early_error(2125, target_path, 1, nd as string)
                    out 0
                end
                g_inc_canonical_id = join_path_cstr("project::" as int, nd)
                g_inc_resolved_path = target_path
                out try_read_file(str_from_cstr(target_path))
            end
            pdi = pdi + 1
        end
    end

    # Step 2: Stdlib registry lookup
    var si = 0
    when si < g_reg_stdlib_count loop
        let sname = native_read_i64(g_reg_names, si * 8)
        if fat_cstr_eq(mod_name, sname) == 1 do
            let phys = native_read_i64(g_reg_phys, si * 8)
            var first_si = 0
            when first_si < si loop
                let f_phys = native_read_i64(g_reg_phys, first_si * 8)
                if rt_streq(f_phys, phys) == 1 do
                    break
                end
                first_si = first_si + 1
            end
            let primary_name = native_read_i64(g_reg_names, first_si * 8)
            g_inc_canonical_id = join_path_cstr("stdlib::" as int, primary_name)
            g_inc_resolved_path = phys
            out try_read_file(str_from_cstr(phys))
        end
        si = si + 1
    end

    # Step 3: Quoted or relative path compatibility
    let has_slash = fat_has_slash(mod_name)
    let is_vri = fat_ends_with_vri(mod_name)
    var sib_found = 0
    if has_slash == 0 do
        var sib_fat = 0
        if is_vri == 1 do
            sib_fat = str_from_cstr(nd)
        else
            let sib_buf = vir_alloc(nl + 5)
            var si_k = 0
            when si_k < nl loop
                native_write_u8(sib_buf, si_k, native_read_u8(nd, si_k))
                si_k = si_k + 1
            end
            native_write_u8(sib_buf, nl, 46)
            native_write_u8(sib_buf, nl + 1, 118)
            native_write_u8(sib_buf, nl + 2, 114)
            native_write_u8(sib_buf, nl + 3, 105)
            native_write_u8(sib_buf, nl + 4, 0)
            sib_fat = str_from_cstr(sib_buf)
        end
        if g_inc_active_dir != 0 do
            let joined_active = join_dir_file(g_inc_active_dir, sib_fat)
            if file_exists_cstr(native_read_i64(joined_active as i64, 0)) == 1 do
                sib_found = joined_active
            end
        end
        if sib_found == 0 and g_inc_base != 0 do
            let joined_sib = join_dir_file(g_inc_base, sib_fat)
            if file_exists_cstr(native_read_i64(joined_sib as i64, 0)) == 1 do
                sib_found = joined_sib
            end
        end
    end
    if has_slash == 1 or is_vri == 1 or sib_found != 0 do
        var path_found = sib_found
        if path_found == 0 and g_inc_base != 0 do
            let joined = join_dir_file(g_inc_base, str_from_cstr(nd))
            if file_exists_cstr(native_read_i64(joined as i64, 0)) == 1 do
                path_found = joined
            end
        end
        if path_found == 0 do
            if file_exists_cstr(nd) == 1 do
                path_found = str_from_cstr(nd)
            end
        end
        if path_found != 0 do
            let norm = path_normalize_fat(path_found)
            let norm_cstr = native_read_i64(norm as i64, 0)
            var mi = 0
            var matched_id = 0
            when mi < g_reg_stdlib_count loop
                let phys = native_read_i64(g_reg_phys, mi * 8)
                let phys_norm = path_normalize_fat(str_from_cstr(phys))
                if fat_str_eq(norm, phys_norm) == 1 do
                    matched_id = join_path_cstr("stdlib::" as int, native_read_i64(g_reg_names, mi * 8))
                    break
                end
                mi = mi + 1
            end
            if matched_id == 0 do
                let norm_len = native_read_i64(norm as i64, 8)
                let norm_data = native_read_i64(norm as i64, 0)
                if norm_len >= 9 and native_read_u8(norm_data, norm_len - 9) == 97 and native_read_u8(norm_data, norm_len - 8) == 108 and native_read_u8(norm_data, norm_len - 7) == 108 and native_read_u8(norm_data, norm_len - 6) == 111 and native_read_u8(norm_data, norm_len - 5) == 99 do
                    matched_id = "stdlib::alloc" as int
                eif norm_len >= 13 and native_read_u8(norm_data, norm_len - 13) == 115 and native_read_u8(norm_data, norm_len - 12) == 116 and native_read_u8(norm_data, norm_len - 11) == 114 and native_read_u8(norm_data, norm_len - 10) == 105 and native_read_u8(norm_data, norm_len - 9) == 110 and native_read_u8(norm_data, norm_len - 8) == 103 and native_read_u8(norm_data, norm_len - 7) == 95 and native_read_u8(norm_data, norm_len - 6) == 114 and native_read_u8(norm_data, norm_len - 5) == 116 do
                    matched_id = "stdlib::string_rt" as int
                eif norm_len >= 11 and native_read_u8(norm_data, norm_len - 11) == 115 and native_read_u8(norm_data, norm_len - 10) == 121 and native_read_u8(norm_data, norm_len - 9) == 115 and native_read_u8(norm_data, norm_len - 8) == 99 and native_read_u8(norm_data, norm_len - 7) == 97 and native_read_u8(norm_data, norm_len - 6) == 108 and native_read_u8(norm_data, norm_len - 5) == 108 do
                    matched_id = "stdlib::syscall" as int
                else
                    matched_id = join_path_cstr("path::" as int, norm_cstr)
                end
            end
            g_inc_canonical_id = matched_id
            g_inc_resolved_path = norm_cstr
            out try_read_file(norm)
        end
    end

    # Step 4: Legacy dotted namespace compatibility (e.g. vir.data.json, rt.alloc)
    if dot_pos > 0 do
        let slash_buf = vir_alloc(nl + 5)
        var s_i = 0
        when s_i < nl loop
            let ch = native_read_u8(nd, s_i)
            if ch == 46 do
                native_write_u8(slash_buf, s_i, 47)
            else
                native_write_u8(slash_buf, s_i, ch)
            end
            s_i = s_i + 1
        end
        native_write_u8(slash_buf, nl, 46)
        native_write_u8(slash_buf, nl + 1, 118)
        native_write_u8(slash_buf, nl + 2, 114)
        native_write_u8(slash_buf, nl + 3, 105)
        native_write_u8(slash_buf, nl + 4, 0)
        let rel_slash = str_from_cstr(slash_buf)

        var sub_rel = rel_slash
        if nl >= 4 and native_read_u8(nd, 0) == 118 and native_read_u8(nd, 1) == 105 and native_read_u8(nd, 2) == 114 and native_read_u8(nd, 3) == 46 do
            let sub_len = (nl - 4) + 4
            let sub_buf = vir_alloc(sub_len + 1)
            var sj = 0
            when sj < nl - 4 loop
                let sc = native_read_u8(nd, 4 + sj)
                if sc == 46 do
                    native_write_u8(sub_buf, sj, 47)
                else
                    native_write_u8(sub_buf, sj, sc)
                end
                sj = sj + 1
            end
            native_write_u8(sub_buf, nl - 4, 46)
            native_write_u8(sub_buf, nl - 4 + 1, 118)
            native_write_u8(sub_buf, nl - 4 + 2, 114)
            native_write_u8(sub_buf, nl - 4 + 3, 105)
            native_write_u8(sub_buf, sub_len, 0)
            sub_rel = str_from_cstr(sub_buf)
        end

        let cand_phys = join_path_cstr(g_reg_stdlib_dir, native_read_i64(sub_rel as i64, 0))
        if file_exists_cstr(cand_phys) == 1 do
            let norm = path_normalize_fat(str_from_cstr(cand_phys))
            let norm_cstr = native_read_i64(norm as i64, 0)
            var smi = 0
            var matched_id = 0
            when smi < g_reg_stdlib_count loop
                let phys = native_read_i64(g_reg_phys, smi * 8)
                let phys_norm = path_normalize_fat(str_from_cstr(phys))
                if fat_str_eq(norm, phys_norm) == 1 do
                    matched_id = join_path_cstr("stdlib::" as int, native_read_i64(g_reg_names, smi * 8))
                    break
                end
                smi = smi + 1
            end
            if matched_id == 0 do
                matched_id = join_path_cstr("stdlib::" as int, nd)
            end
            g_inc_canonical_id = matched_id
            g_inc_resolved_path = norm_cstr
            out try_read_file(norm)
        end

        if g_inc_base != 0 do
            let joined_proj = join_dir_file(g_inc_base, rel_slash)
            if file_exists_cstr(native_read_i64(joined_proj as i64, 0)) == 1 do
                let norm = path_normalize_fat(joined_proj)
                g_inc_canonical_id = join_path_cstr("path::" as int, native_read_i64(norm as i64, 0))
                g_inc_resolved_path = native_read_i64(norm as i64, 0)
                out try_read_file(norm)
            end
        end
    end

    # Step 5: Unqualified basename fallback to unique stdlib module
    if has_slash == 0 and has_dot == 0 do
        if nl == 3 and native_read_u8(nd, 0) == 115 and native_read_u8(nd, 1) == 116 and native_read_u8(nd, 2) == 114 do
            var str_phys = join_path_cstr(g_reg_stdlib_dir, "str/string.vri" as int)
            g_inc_canonical_id = "stdlib::string" as int
            g_inc_resolved_path = str_phys
            out try_read_file(str_from_cstr(str_phys))
        end
        if nl == 14 and native_read_u8(nd, 0) == 115 and native_read_u8(nd, 6) == 95 and native_read_u8(nd, 7) == 98 do
            var sb_phys = join_path_cstr(g_reg_stdlib_dir, "str/builder.vri" as int)
            g_inc_canonical_id = "stdlib::builder" as int
            g_inc_resolved_path = sb_phys
            out try_read_file(str_from_cstr(sb_phys))
        end
        if nl == 4 and native_read_u8(nd, 0) == 102 and native_read_u8(nd, 1) == 105 and native_read_u8(nd, 2) == 108 and native_read_u8(nd, 3) == 101 do
            var f_phys = join_path_cstr(g_reg_stdlib_dir, "io/file.vri" as int)
            g_inc_canonical_id = "stdlib::io.file" as int
            g_inc_resolved_path = f_phys
            out try_read_file(str_from_cstr(f_phys))
        end

        let slash_stem_buf = vir_alloc(nl + 6)
        native_write_u8(slash_stem_buf, 0, 47)
        var ssk = 0
        when ssk < nl loop
            native_write_u8(slash_stem_buf, 1 + ssk, native_read_u8(nd, ssk))
            ssk = ssk + 1
        end
        native_write_u8(slash_stem_buf, nl + 1, 46)
        native_write_u8(slash_stem_buf, nl + 2, 118)
        native_write_u8(slash_stem_buf, nl + 3, 114)
        native_write_u8(slash_stem_buf, nl + 4, 105)
        native_write_u8(slash_stem_buf, nl + 5, 0)
        let needle_len = nl + 5

        var b_si = 0
        var found_si = 0 - 1
        var match_count = 0
        when b_si < g_reg_stdlib_count loop
            let rpath = native_read_i64(g_reg_paths, b_si * 8)
            let rlen = rt_strlen(rpath)
            if rlen >= needle_len do
                let offset = rlen - needle_len
                var is_m = 1
                var chk = 0
                when chk < needle_len loop
                    if native_read_u8(rpath, offset + chk) != native_read_u8(slash_stem_buf, chk) do
                        is_m = 0
                        break
                    end
                    chk = chk + 1
                end
                if is_m == 1 do
                    found_si = b_si
                    match_count = match_count + 1
                end
            end
            b_si = b_si + 1
        end
        if match_count == 1 and found_si >= 0 do
            let cname = native_read_i64(g_reg_names, found_si * 8)
            let cphys = native_read_i64(g_reg_phys, found_si * 8)
            g_inc_canonical_id = join_path_cstr("stdlib::" as int, cname)
            g_inc_resolved_path = cphys
            out try_read_file(str_from_cstr(cphys))
        end
    end

    out 0
end.

func read_include_source(mod_name: int):
    out resolve_include_target(mod_name)
end.
