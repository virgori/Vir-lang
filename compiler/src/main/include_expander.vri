##
 * compiler/src/main/include_expander.vri — Text Include Splice & Expansion
 * ========================================================================
 ##

include rt.alloc
import vir_alloc from rt.alloc
include rt.string_rt
import fat_str_new, fat_str_len, fat_str_byte_at, fat_cstr_eq, fat_str_concat, fat_str_eq, rt_streq, str_from_cstr, rt_strlen, rt_itoa, vir_free from rt.string_rt
include rt.vec_rt
import bvec_len, bvec_get, vec_len_rt, vec_get_rt, vec_new_rt, vec_push_rt from rt.vec_rt
include rt.io
import read_file_str, print_str, print_ln, print_int, print_newline from rt.io
include main_path_util
include main_module_resolver

func check_active_cycle(source: int, at: int, target_id: int):
    if target_id == 0 do out 0 end
    if at <= 0 do out 0 end
    let sdata = native_read_i64(source as i64, 0)
    var stack = vir_alloc(64 * 8)
    var stack_len = 0
    var pos = 0
    when pos < at loop
        let line_start = pos
        when pos < at and native_read_u8(sdata, pos) != 10 loop
            pos = pos + 1
        end
        let line_len = pos - line_start
        if line_len > 17 and native_read_u8(sdata, line_start) == 35 and native_read_u8(sdata, line_start + 1) == 32 and native_read_u8(sdata, line_start + 2) == 64 and native_read_u8(sdata, line_start + 11) == 115 and native_read_u8(sdata, line_start + 16) == 32 do
            let id_start = line_start + 17
            let id_len = line_len - 17
            let id_buf = vir_alloc(id_len + 1)
            var j = 0
            when j < id_len loop
                native_write_u8(id_buf, j, native_read_u8(sdata, id_start + j))
                j = j + 1
            end
            native_write_u8(id_buf, id_len, 0)
            if stack_len < 64 do
                native_write_i64(stack, stack_len * 8, id_buf)
                stack_len = stack_len + 1
            end
        eif line_len > 15 and native_read_u8(sdata, line_start) == 35 and native_read_u8(sdata, line_start + 1) == 32 and native_read_u8(sdata, line_start + 2) == 64 and native_read_u8(sdata, line_start + 11) == 101 and native_read_u8(sdata, line_start + 14) == 32 do
            if stack_len > 0 do
                stack_len = stack_len - 1
            end
        end
        if pos < at and native_read_u8(sdata, pos) == 10 do
            pos = pos + 1
        end
    end

    var k = 0
    var cycle_found = 0
    var cycle_pos = 0
    when k < stack_len loop
        let mid = native_read_i64(stack, k * 8)
        if rt_streq(mid, target_id) == 1 do
            cycle_found = 1
            cycle_pos = k
            break
        end
        k = k + 1
    end

    if cycle_found == 1 do
        var cycle_str = str_from_cstr(target_id)
        arena:
            var sb = sb_new()
            var m = cycle_pos
            when m < stack_len loop
                sb = sb_append(sb, str_from_cstr(native_read_i64(stack, m * 8)))
                sb = sb_append(sb, " -> ")
                m = m + 1
            end
            sb = sb_append(sb, str_from_cstr(target_id))
            cycle_str = sb_to_string(sb)
        end
        inc_locate_marker_before(source, at)
        inc_report_early_error(2105, g_inc_cur_parent_file, g_inc_cur_parent_line, cycle_str)
        out 1
    end
    out 0
end.

func inc_wrap_source_with_mod_at(body: string, r_path: int, r_line: int, p_file: int, p_line: int, mod_id: int):
    let bdata = native_read_i64(body as i64, 0)
    let blen = native_read_i64(body as i64, 8)
    let rlen = rt_strlen(r_path)
    let plen = rt_strlen(p_file)
    let idlen = rt_strlen(mod_id)
    let rline_str = rt_itoa(r_line)
    let rline_len = rt_strlen(rline_str)
    let pline_str = rt_itoa(p_line)
    let pline_len = rt_strlen(pline_str)
    var need_nl = 0
    if blen > 0 and native_read_u8(bdata, blen - 1) != 10 do
        need_nl = 1
    end
    let total = 17 + idlen + 1 + 14 + rlen + 1 + rline_len + 1 + blen + need_nl + 14 + plen + 1 + pline_len + 1 + 15 + idlen + 1
    let buf = vir_alloc(total + 1)
    var out_i = 0

    native_write_u8(buf, out_i, 35); out_i = out_i + 1
    native_write_u8(buf, out_i, 32); out_i = out_i + 1
    native_write_u8(buf, out_i, 64); out_i = out_i + 1
    native_write_u8(buf, out_i, 118); out_i = out_i + 1
    native_write_u8(buf, out_i, 105); out_i = out_i + 1
    native_write_u8(buf, out_i, 114); out_i = out_i + 1
    native_write_u8(buf, out_i, 95); out_i = out_i + 1
    native_write_u8(buf, out_i, 109); out_i = out_i + 1
    native_write_u8(buf, out_i, 111); out_i = out_i + 1
    native_write_u8(buf, out_i, 100); out_i = out_i + 1
    native_write_u8(buf, out_i, 95); out_i = out_i + 1
    native_write_u8(buf, out_i, 115); out_i = out_i + 1
    native_write_u8(buf, out_i, 116); out_i = out_i + 1
    native_write_u8(buf, out_i, 97); out_i = out_i + 1
    native_write_u8(buf, out_i, 114); out_i = out_i + 1
    native_write_u8(buf, out_i, 116); out_i = out_i + 1
    native_write_u8(buf, out_i, 32); out_i = out_i + 1
    var i = 0
    when i < idlen loop
        native_write_u8(buf, out_i, native_read_u8(mod_id, i))
        out_i = out_i + 1
        i = i + 1
    end
    native_write_u8(buf, out_i, 10); out_i = out_i + 1

    native_write_u8(buf, out_i, 35); out_i = out_i + 1
    native_write_u8(buf, out_i, 32); out_i = out_i + 1
    native_write_u8(buf, out_i, 64); out_i = out_i + 1
    native_write_u8(buf, out_i, 118); out_i = out_i + 1
    native_write_u8(buf, out_i, 105); out_i = out_i + 1
    native_write_u8(buf, out_i, 114); out_i = out_i + 1
    native_write_u8(buf, out_i, 95); out_i = out_i + 1
    native_write_u8(buf, out_i, 115); out_i = out_i + 1
    native_write_u8(buf, out_i, 111); out_i = out_i + 1
    native_write_u8(buf, out_i, 117); out_i = out_i + 1
    native_write_u8(buf, out_i, 114); out_i = out_i + 1
    native_write_u8(buf, out_i, 99); out_i = out_i + 1
    native_write_u8(buf, out_i, 101); out_i = out_i + 1
    native_write_u8(buf, out_i, 32); out_i = out_i + 1
    i = 0
    when i < rlen loop
        native_write_u8(buf, out_i, native_read_u8(r_path, i))
        out_i = out_i + 1
        i = i + 1
    end
    native_write_u8(buf, out_i, 32); out_i = out_i + 1
    i = 0
    when i < rline_len loop
        native_write_u8(buf, out_i, native_read_u8(rline_str, i))
        out_i = out_i + 1
        i = i + 1
    end
    native_write_u8(buf, out_i, 10); out_i = out_i + 1

    i = 0
    when i < blen loop
        native_write_u8(buf, out_i, native_read_u8(bdata, i))
        out_i = out_i + 1
        i = i + 1
    end
    if need_nl == 1 do
        native_write_u8(buf, out_i, 10); out_i = out_i + 1
    end

    native_write_u8(buf, out_i, 35); out_i = out_i + 1
    native_write_u8(buf, out_i, 32); out_i = out_i + 1
    native_write_u8(buf, out_i, 64); out_i = out_i + 1
    native_write_u8(buf, out_i, 118); out_i = out_i + 1
    native_write_u8(buf, out_i, 105); out_i = out_i + 1
    native_write_u8(buf, out_i, 114); out_i = out_i + 1
    native_write_u8(buf, out_i, 95); out_i = out_i + 1
    native_write_u8(buf, out_i, 109); out_i = out_i + 1
    native_write_u8(buf, out_i, 111); out_i = out_i + 1
    native_write_u8(buf, out_i, 100); out_i = out_i + 1
    native_write_u8(buf, out_i, 95); out_i = out_i + 1
    native_write_u8(buf, out_i, 101); out_i = out_i + 1
    native_write_u8(buf, out_i, 110); out_i = out_i + 1
    native_write_u8(buf, out_i, 100); out_i = out_i + 1
    native_write_u8(buf, out_i, 32); out_i = out_i + 1
    i = 0
    when i < idlen loop
        native_write_u8(buf, out_i, native_read_u8(mod_id, i))
        out_i = out_i + 1
        i = i + 1
    end
    native_write_u8(buf, out_i, 10); out_i = out_i + 1

    native_write_u8(buf, out_i, 35); out_i = out_i + 1
    native_write_u8(buf, out_i, 32); out_i = out_i + 1
    native_write_u8(buf, out_i, 64); out_i = out_i + 1
    native_write_u8(buf, out_i, 118); out_i = out_i + 1
    native_write_u8(buf, out_i, 105); out_i = out_i + 1
    native_write_u8(buf, out_i, 114); out_i = out_i + 1
    native_write_u8(buf, out_i, 95); out_i = out_i + 1
    native_write_u8(buf, out_i, 115); out_i = out_i + 1
    native_write_u8(buf, out_i, 111); out_i = out_i + 1
    native_write_u8(buf, out_i, 117); out_i = out_i + 1
    native_write_u8(buf, out_i, 114); out_i = out_i + 1
    native_write_u8(buf, out_i, 99); out_i = out_i + 1
    native_write_u8(buf, out_i, 101); out_i = out_i + 1
    native_write_u8(buf, out_i, 32); out_i = out_i + 1
    i = 0
    when i < plen loop
        native_write_u8(buf, out_i, native_read_u8(p_file, i))
        out_i = out_i + 1
        i = i + 1
    end
    native_write_u8(buf, out_i, 32); out_i = out_i + 1
    i = 0
    when i < pline_len loop
        native_write_u8(buf, out_i, native_read_u8(pline_str, i))
        out_i = out_i + 1
        i = i + 1
    end
    native_write_u8(buf, out_i, 10); out_i = out_i + 1

    native_write_u8(buf, out_i, 0)
    out str_from_cstr(buf)
end.

func inc_wrap_source_with_mod(body: string, r_path: int, p_file: int, p_line: int, mod_id: int):
    out inc_wrap_source_with_mod_at(body, r_path, 1, p_file, p_line, mod_id)
end.

# ── Text-level include splice (avoids nested parse_program depth bugs) ──

func text_find_include(source: int):
    # Returns byte index of "include " or -1. Scans for line-start include.
    data = native_read_i64(source, 0)
    n = native_read_i64(source, 8)
    i = 0
    at_line = 1
    when i + 8 <= n loop
        if at_line == 1 do
            if native_read_u8(data, i) == 105 and native_read_u8(data, i + 1) == 110 and native_read_u8(data, i + 2) == 99 and native_read_u8(data, i + 3) == 108 and native_read_u8(data, i + 4) == 117 and native_read_u8(data, i + 5) == 100 and native_read_u8(data, i + 6) == 101 and native_read_u8(data, i + 7) == 32 do
                out i
            end
        end
        ch = native_read_u8(data, i)
        if ch == 10 do
            at_line = 1
        else
            if ch != 32 and ch != 9 do
                at_line = 0
            end
        end
        i = i + 1
    end
    out 0 - 1
end.

func text_parse_include_name(source: int, at: int):
    # after "include ", read ident or "quoted/path.vri" until ; or newline.
    data = native_read_i64(source, 0)
    n = native_read_i64(source, 8)
    i = at + 8
    when i < n and (native_read_u8(data, i) == 32 or native_read_u8(data, i) == 9) loop
        i = i + 1
    end
    # Quoted path: include "stdlib/vir/rt/alloc.vri"
    if i < n and native_read_u8(data, i) == 34 do
        i = i + 1
        start = i
        when i < n and native_read_u8(data, i) != 34 loop
            i = i + 1
        end
        len = i - start
        if len <= 0 do
            out 0
        end
        buf = vir_alloc(len + 1)
        j = 0
        when j < len loop
            native_write_u8(buf, j, native_read_u8(data, start + j))
            j = j + 1
        end
        native_write_u8(buf, len, 0)
        out str_from_cstr(buf)
    end
    start = i
    done = 0
    when i < n and done == 0 loop
        c = native_read_u8(data, i)
        if c == 59 or c == 10 or c == 13 or c == 32 or c == 9 do
            done = 1
        else
            i = i + 1
        end
    end
    len = i - start
    if len <= 0 do
        out 0
    end
    buf = vir_alloc(len + 1)
    j = 0
    when j < len loop
        native_write_u8(buf, j, native_read_u8(data, start + j))
        j = j + 1
    end
    native_write_u8(buf, len, 0)
    out str_from_cstr(buf)
end.

func inc_count_newlines(source: int, start: int, end_pos: int):
    let data = native_read_i64(source as i64, 0)
    var count = 0
    var i = start
    when i < end_pos loop
        if native_read_u8(data, i) == 10 do
            count = count + 1
        end
        i = i + 1
    end
    if count == 0 do count = 1 end
    out count
end.

func text_skip_include_stmt(source: int, at: int):
    # Return index just past the include statement (after ; or newline).
    data = native_read_i64(source, 0)
    n = native_read_i64(source, 8)
    i = at
    when i < n loop
        c = native_read_u8(data, i)
        i = i + 1
        if c == 59 or c == 10 do
            out i
        end
    end
    out n
end.

func text_splice_at(source: int, at: int, end_at: int, insert: int):
    sdata = native_read_i64(source as i64, 0)
    slen = native_read_i64(source as i64, 8)
    idata = native_read_i64(insert as i64, 0)
    ilen = native_read_i64(insert as i64, 8)

    var need_lead_nl = 0
    if at > 0 and native_read_u8(sdata, at - 1) != 10 do
        need_lead_nl = 1
    end
    var need_trail_nl = 0
    if ilen > 0 and native_read_u8(idata, ilen - 1) != 10 do
        need_trail_nl = 1
    end

    total = at + need_lead_nl + ilen + need_trail_nl + (slen - end_at)
    buf = vir_alloc(total + 1)
    var out_i = 0
    var i = 0
    when i < at loop
        native_write_u8(buf, out_i, native_read_u8(sdata, i))
        out_i = out_i + 1
        i = i + 1
    end
    if need_lead_nl == 1 do
        native_write_u8(buf, out_i, 10)
        out_i = out_i + 1
    end
    var j = 0
    when j < ilen loop
        native_write_u8(buf, out_i, native_read_u8(idata, j))
        out_i = out_i + 1
        j = j + 1
    end
    if need_trail_nl == 1 do
        native_write_u8(buf, out_i, 10)
        out_i = out_i + 1
    end
    var k = end_at
    when k < slen loop
        native_write_u8(buf, out_i, native_read_u8(sdata, k))
        out_i = out_i + 1
        k = k + 1
    end
    native_write_u8(buf, out_i, 0)
    out str_from_cstr(buf)
end.

func text_strip_func_defs(source: int):
    # Drop top-level `func … end.` blocks; keep type/const/enum.
    data = native_read_i64(source, 0)
    n = native_read_i64(source, 8)
    buf = vir_alloc(n + 1)
    out_i = 0
    i = 0
    at_line = 1
    in_func = 0
    when i < n loop
        if in_func == 0 and at_line == 1 and i + 5 <= n and native_read_u8(data, i) == 102 and native_read_u8(data, i + 1) == 117 and native_read_u8(data, i + 2) == 110 and native_read_u8(data, i + 3) == 99 and native_read_u8(data, i + 4) == 32 do
            in_func = 1
        end
        if in_func == 1 do
            if at_line == 1 and i + 4 <= n and native_read_u8(data, i) == 101 and native_read_u8(data, i + 1) == 110 and native_read_u8(data, i + 2) == 100 and native_read_u8(data, i + 3) == 46 do
                i = i + 4
                if i < n and native_read_u8(data, i) == 10 do
                    i = i + 1
                    at_line = 1
                end
                in_func = 0
            else
                ch = native_read_u8(data, i)
                i = i + 1
                if ch == 10 do
                    at_line = 1
                else
                    if ch != 32 and ch != 9 do
                        at_line = 0
                    end
                end
            end
        else
            ch = native_read_u8(data, i)
            native_write_u8(buf, out_i, ch)
            out_i = out_i + 1
            i = i + 1
            if ch == 10 do
                at_line = 1
            else
                if ch != 32 and ch != 9 do
                    at_line = 0
                end
            end
        end
    end
    native_write_u8(buf, out_i, 0)
    out str_from_cstr(buf)
end.

func text_ascii_sanitize(source: int):
    # Preserve UTF-8 bytes in source and string literals.  The old sanitizer
    # replaced every byte >= 128 with a space, corrupting Unicode string
    # literals before the lexer saw them.  Keep the conservative sanitization
    # only inside comments, where bytes are discarded by the lexer anyway.
    data = native_read_i64(source, 0)
    n = native_read_i64(source, 8)
    buf = vir_alloc(n + 1)
    i = 0
    state = 0; # 0=normal, 1=string, 2=line comment, 3=block comment #*#, 4=block comment ##
    quote = 0
    escaped = 0
    when i < n loop
        b = native_read_u8(data, i)
        if state == 1 do
            native_write_u8(buf, i, b)
            if escaped == 1 do
                escaped = 0
            eif b == 92 do
                escaped = 1
            eif b == quote do
                state = 0
                quote = 0
            end
        eif state == 2 do
            if b == 10 do
                state = 0
                native_write_u8(buf, i, b)
            eif b >= 128 do
                native_write_u8(buf, i, 32)
            else
                native_write_u8(buf, i, b)
            end
        eif state == 3 do
            if b == 35 do
                if i + 2 < n do
                    if native_read_u8(data, i + 1) == 42 do
                        if native_read_u8(data, i + 2) == 35 do
                            native_write_u8(buf, i, 35)
                            native_write_u8(buf, i + 1, 42)
                            native_write_u8(buf, i + 2, 35)
                            i = i + 2
                            state = 0
                        end
                    end
                end
            end
            if state == 3 do
                if b >= 128 do
                    native_write_u8(buf, i, 32)
                else
                    native_write_u8(buf, i, b)
                end
            end
        eif state == 4 do
            if b == 35 do
                if i + 1 < n do
                    if native_read_u8(data, i + 1) == 35 do
                        native_write_u8(buf, i, 35)
                        native_write_u8(buf, i + 1, 35)
                        i = i + 1
                        state = 0
                    end
                end
            end
            if state == 4 do
                if b >= 128 do
                    native_write_u8(buf, i, 32)
                else
                    native_write_u8(buf, i, b)
                end
            end
        else
            native_write_u8(buf, i, b)
            if b == 34 or b == 39 do
                state = 1
                quote = b
                escaped = 0
            eif b == 35 do
                var handled = false
                if i + 2 < n do
                    if native_read_u8(data, i + 1) == 42 do
                        if native_read_u8(data, i + 2) == 35 do
                            native_write_u8(buf, i + 1, 42)
                            native_write_u8(buf, i + 2, 35)
                            i = i + 2
                            state = 3
                            handled = true
                        end
                    end
                end
                if not handled do
                    if i + 1 < n do
                        if native_read_u8(data, i + 1) == 35 do
                            native_write_u8(buf, i + 1, 35)
                            i = i + 1
                            state = 4
                            handled = true
                        end
                    end
                end
                if not handled do
                    state = 2
                end
            end
        end
        i = i + 1
    end
    native_write_u8(buf, n, 0)
    out str_from_cstr(buf)
end.

func inc_locate_marker_before(source: string, at: int):
    data = native_read_i64(source as i64, 0)
    n = native_read_i64(source as i64, 8)
    var limit = at
    if limit > n do
        limit = n
    end
    var pos = 0
    var cur_line = 1
    var cur_file = "<main>" as i64
    if g_inc_main_file != 0 do
        cur_file = g_inc_main_file
    end

    when pos < limit loop
        let line_start = pos
        when pos < limit and native_read_u8(data, pos) != 10 loop
            pos = pos + 1
        end
        let line_end = pos

        # Check for "# @vir_source " (14 bytes)
        var is_marker = 0
        if line_end - line_start >= 15 do
            if native_read_u8(data, line_start) == 35 and native_read_u8(data, line_start + 1) == 32 and native_read_u8(data, line_start + 2) == 64 and native_read_u8(data, line_start + 3) == 118 and native_read_u8(data, line_start + 4) == 105 and native_read_u8(data, line_start + 5) == 114 and native_read_u8(data, line_start + 6) == 95 and native_read_u8(data, line_start + 7) == 115 and native_read_u8(data, line_start + 8) == 111 and native_read_u8(data, line_start + 9) == 117 and native_read_u8(data, line_start + 10) == 114 and native_read_u8(data, line_start + 11) == 99 and native_read_u8(data, line_start + 12) == 101 and native_read_u8(data, line_start + 13) == 32 do
                is_marker = 1
            end
        end

        if is_marker == 1 do
            let path_start = line_start + 14
            var sep = path_start
            when sep < line_end and native_read_u8(data, sep) != 32 loop
                sep = sep + 1
            end
            let path_len = sep - path_start
            let path_buf = vir_alloc(path_len + 1)
            var j = 0
            when j < path_len loop
                native_write_u8(path_buf, j, native_read_u8(data, path_start + j))
                j = j + 1
            end
            native_write_u8(path_buf, path_len, 0)
            cur_file = path_buf
            cur_line = 0
            var k = sep + 1
            when k < line_end loop
                let c = native_read_u8(data, k)
                if c >= 48 and c <= 57 do
                    cur_line = cur_line * 10 + c - 48
                end
                k = k + 1
            end
        else
            cur_line = cur_line + 1
        end

        if pos < limit and native_read_u8(data, pos) == 10 do
            pos = pos + 1
        end
    end

    g_inc_cur_parent_file = cur_file
    g_inc_cur_parent_line = cur_line
    g_inc_active_dir = 0
    if cur_file != 0 do
        let cflen = rt_strlen(cur_file)
        var has_slash = 0
        var last_slash = 0
        var ci = 0
        when ci < cflen loop
            if native_read_u8(cur_file, ci) == 47 do
                has_slash = 1
                last_slash = ci
            end
            ci = ci + 1
        end
        if has_slash == 1 and last_slash > 0 do
            let dir_buf = vir_alloc(last_slash + 1)
            var dj = 0
            when dj < last_slash loop
                native_write_u8(dir_buf, dj, native_read_u8(cur_file, dj))
                dj = dj + 1
            end
            native_write_u8(dir_buf, last_slash, 0)
            g_inc_active_dir = dir_buf
        end
    end
    out 0
end.

func inc_prepend_root_marker(source: string):
    let sdata = native_read_i64(source as i64, 0)
    let slen = native_read_i64(source as i64, 8)
    if slen >= 15 do
        if native_read_u8(sdata, 0) == 35 and native_read_u8(sdata, 1) == 32 and native_read_u8(sdata, 2) == 64 do
            out source
        end
    end
    var root_f = "<main>" as i64
    if g_inc_main_file != 0 do
        root_f = g_inc_main_file
    end
    let flen = rt_strlen(root_f)
    let total = 17 + flen + 1 + 17 + flen + slen + 16 + flen + 1
    let buf = vir_alloc(total + 1)
    var out_i = 0

    native_write_u8(buf, out_i, 35); out_i = out_i + 1
    native_write_u8(buf, out_i, 32); out_i = out_i + 1
    native_write_u8(buf, out_i, 64); out_i = out_i + 1
    native_write_u8(buf, out_i, 118); out_i = out_i + 1
    native_write_u8(buf, out_i, 105); out_i = out_i + 1
    native_write_u8(buf, out_i, 114); out_i = out_i + 1
    native_write_u8(buf, out_i, 95); out_i = out_i + 1
    native_write_u8(buf, out_i, 109); out_i = out_i + 1
    native_write_u8(buf, out_i, 111); out_i = out_i + 1
    native_write_u8(buf, out_i, 100); out_i = out_i + 1
    native_write_u8(buf, out_i, 95); out_i = out_i + 1
    native_write_u8(buf, out_i, 115); out_i = out_i + 1
    native_write_u8(buf, out_i, 116); out_i = out_i + 1
    native_write_u8(buf, out_i, 97); out_i = out_i + 1
    native_write_u8(buf, out_i, 114); out_i = out_i + 1
    native_write_u8(buf, out_i, 116); out_i = out_i + 1
    native_write_u8(buf, out_i, 32); out_i = out_i + 1
    var i = 0
    when i < flen loop
        native_write_u8(buf, out_i, native_read_u8(root_f, i))
        out_i = out_i + 1
        i = i + 1
    end
    native_write_u8(buf, out_i, 10); out_i = out_i + 1

    native_write_u8(buf, out_i, 35); out_i = out_i + 1
    native_write_u8(buf, out_i, 32); out_i = out_i + 1
    native_write_u8(buf, out_i, 64); out_i = out_i + 1
    native_write_u8(buf, out_i, 118); out_i = out_i + 1
    native_write_u8(buf, out_i, 105); out_i = out_i + 1
    native_write_u8(buf, out_i, 114); out_i = out_i + 1
    native_write_u8(buf, out_i, 95); out_i = out_i + 1
    native_write_u8(buf, out_i, 115); out_i = out_i + 1
    native_write_u8(buf, out_i, 111); out_i = out_i + 1
    native_write_u8(buf, out_i, 117); out_i = out_i + 1
    native_write_u8(buf, out_i, 114); out_i = out_i + 1
    native_write_u8(buf, out_i, 99); out_i = out_i + 1
    native_write_u8(buf, out_i, 101); out_i = out_i + 1
    native_write_u8(buf, out_i, 32); out_i = out_i + 1
    i = 0
    when i < flen loop
        native_write_u8(buf, out_i, native_read_u8(root_f, i))
        out_i = out_i + 1
        i = i + 1
    end
    native_write_u8(buf, out_i, 32); out_i = out_i + 1
    native_write_u8(buf, out_i, 49); out_i = out_i + 1
    native_write_u8(buf, out_i, 10); out_i = out_i + 1

    i = 0
    when i < slen loop
        native_write_u8(buf, out_i, native_read_u8(sdata, i))
        out_i = out_i + 1
        i = i + 1
    end

    native_write_u8(buf, out_i, 10); out_i = out_i + 1
    native_write_u8(buf, out_i, 35); out_i = out_i + 1
    native_write_u8(buf, out_i, 32); out_i = out_i + 1
    native_write_u8(buf, out_i, 64); out_i = out_i + 1
    native_write_u8(buf, out_i, 118); out_i = out_i + 1
    native_write_u8(buf, out_i, 105); out_i = out_i + 1
    native_write_u8(buf, out_i, 114); out_i = out_i + 1
    native_write_u8(buf, out_i, 95); out_i = out_i + 1
    native_write_u8(buf, out_i, 109); out_i = out_i + 1
    native_write_u8(buf, out_i, 111); out_i = out_i + 1
    native_write_u8(buf, out_i, 100); out_i = out_i + 1
    native_write_u8(buf, out_i, 95); out_i = out_i + 1
    native_write_u8(buf, out_i, 101); out_i = out_i + 1
    native_write_u8(buf, out_i, 110); out_i = out_i + 1
    native_write_u8(buf, out_i, 100); out_i = out_i + 1
    native_write_u8(buf, out_i, 32); out_i = out_i + 1
    i = 0
    when i < flen loop
        native_write_u8(buf, out_i, native_read_u8(root_f, i))
        out_i = out_i + 1
        i = i + 1
    end
    native_write_u8(buf, out_i, 10); out_i = out_i + 1

    native_write_u8(buf, out_i, 0)
    out str_from_cstr(buf)
end.

func inc_wrap_source(body: string, r_path: int, p_file: int, p_line: int):
    out inc_wrap_source_at(body, r_path, 1, p_file, p_line)
end.

func inc_wrap_source_at(body: string, r_path: int, r_line: int, p_file: int, p_line: int):
    let bdata = native_read_i64(body as i64, 0)
    let blen = native_read_i64(body as i64, 8)
    let rlen = rt_strlen(r_path)
    let plen = rt_strlen(p_file)
    let pline_str = rt_itoa(p_line)
    let pline_len = rt_strlen(pline_str)
    var need_nl = 0
    if blen > 0 and native_read_u8(bdata, blen - 1) != 10 do
        need_nl = 1
    end
    let rline_str = rt_itoa(r_line)
    let rline_len = rt_strlen(rline_str)
    let total = 16 + rlen + rline_len + blen + need_nl + 16 + plen + pline_len
    let buf = vir_alloc(total + 1)
    native_write_u8(buf, 0, 35)
    native_write_u8(buf, 1, 32)
    native_write_u8(buf, 2, 64)
    native_write_u8(buf, 3, 118)
    native_write_u8(buf, 4, 105)
    native_write_u8(buf, 5, 114)
    native_write_u8(buf, 6, 95)
    native_write_u8(buf, 7, 115)
    native_write_u8(buf, 8, 111)
    native_write_u8(buf, 9, 117)
    native_write_u8(buf, 10, 114)
    native_write_u8(buf, 11, 99)
    native_write_u8(buf, 12, 101)
    native_write_u8(buf, 13, 32)
    var out_i = 14
    var i = 0
    when i < rlen loop
        native_write_u8(buf, out_i, native_read_u8(r_path, i))
        out_i = out_i + 1
        i = i + 1
    end
    native_write_u8(buf, out_i, 32)
    out_i = out_i + 1
    i = 0
    when i < rline_len loop
        native_write_u8(buf, out_i, native_read_u8(rline_str, i))
        out_i = out_i + 1
        i = i + 1
    end
    native_write_u8(buf, out_i, 10)
    out_i = out_i + 1
    i = 0
    when i < blen loop
        native_write_u8(buf, out_i, native_read_u8(bdata, i))
        out_i = out_i + 1
        i = i + 1
    end
    if need_nl == 1 do
        native_write_u8(buf, out_i, 10)
        out_i = out_i + 1
    end
    native_write_u8(buf, out_i, 35)
    native_write_u8(buf, out_i + 1, 32)
    native_write_u8(buf, out_i + 2, 64)
    native_write_u8(buf, out_i + 3, 118)
    native_write_u8(buf, out_i + 4, 105)
    native_write_u8(buf, out_i + 5, 114)
    native_write_u8(buf, out_i + 6, 95)
    native_write_u8(buf, out_i + 7, 115)
    native_write_u8(buf, out_i + 8, 111)
    native_write_u8(buf, out_i + 9, 117)
    native_write_u8(buf, out_i + 10, 114)
    native_write_u8(buf, out_i + 11, 99)
    native_write_u8(buf, out_i + 12, 101)
    native_write_u8(buf, out_i + 13, 32)
    out_i = out_i + 14
    i = 0
    when i < plen loop
        native_write_u8(buf, out_i, native_read_u8(p_file, i))
        out_i = out_i + 1
        i = i + 1
    end
    native_write_u8(buf, out_i, 32)
    out_i = out_i + 1
    i = 0
    when i < pline_len loop
        native_write_u8(buf, out_i, native_read_u8(pline_str, i))
        out_i = out_i + 1
        i = i + 1
    end
    native_write_u8(buf, out_i, 10)
    out_i = out_i + 1
    native_write_u8(buf, out_i, 0)
    out str_from_cstr(buf)
end.

func inc_make_dup_comment(iname_cstr: int):
    let ilen = rt_strlen(iname_cstr)
    let total = 29 + ilen
    let buf = vir_alloc(total + 1)
    native_write_u8(buf, 0, 35)
    native_write_u8(buf, 1, 32)
    native_write_u8(buf, 2, 91)
    native_write_u8(buf, 3, 105)
    native_write_u8(buf, 4, 110)
    native_write_u8(buf, 5, 99)
    native_write_u8(buf, 6, 108)
    native_write_u8(buf, 7, 117)
    native_write_u8(buf, 8, 100)
    native_write_u8(buf, 9, 101)
    native_write_u8(buf, 10, 32)
    var i = 0
    when i < ilen loop
        native_write_u8(buf, 11 + i, native_read_u8(iname_cstr, i))
        i = i + 1
    end
    let p2 = 11 + ilen
    native_write_u8(buf, p2 + 0, 32)
    native_write_u8(buf, p2 + 1, 97)
    native_write_u8(buf, p2 + 2, 108)
    native_write_u8(buf, p2 + 3, 114)
    native_write_u8(buf, p2 + 4, 101)
    native_write_u8(buf, p2 + 5, 97)
    native_write_u8(buf, p2 + 6, 100)
    native_write_u8(buf, p2 + 7, 121)
    native_write_u8(buf, p2 + 8, 32)
    native_write_u8(buf, p2 + 9, 101)
    native_write_u8(buf, p2 + 10, 120)
    native_write_u8(buf, p2 + 11, 112)
    native_write_u8(buf, p2 + 12, 97)
    native_write_u8(buf, p2 + 13, 110)
    native_write_u8(buf, p2 + 14, 100)
    native_write_u8(buf, p2 + 15, 101)
    native_write_u8(buf, p2 + 16, 100)
    native_write_u8(buf, p2 + 17, 93)
    native_write_u8(buf, total, 0)
    out str_from_cstr(buf)
end.

func inc_validate_utf8_source(body: string, path: int):
    let data = native_read_i64(body as i64, 0)
    let n = native_read_i64(body as i64, 8)
    let bad = utf8_source_invalid_offset_bytes(data, n)
    if bad >= 0 do
        print_str("virc: error [E2201] Source Encoding: invalid UTF-8 in '")
        print_str(path)
        print_str("' at byte offset ")
        print_int(bad)
        print_str("\n")
        inc_set_error(2201)
        out 0
    end
    out 1
end.

func expand_includes_text(source: int):
    g_inc_init()
    g_inc_resolved_path = 0

    let first_inc = text_find_include(source)
    if first_inc < 0 do
        out source
    end

    source = inc_prepend_root_marker(source)

    var guard = 0
    when guard < G_PREPROCESS_MAX loop
        guard = guard + 1
        let at = text_find_include(source)
        if at < 0 do
            out source
        end
        if text_line_has_double_colon(source, at) == 1 do
            inc_locate_marker_before(source, at)
            inc_report_early_error(2103, g_inc_cur_parent_file, g_inc_cur_parent_line, "")
            out source
        end
        let iname = text_parse_include_name(source, at)
        if iname == 0 do
            inc_locate_marker_before(source, at)
            inc_report_early_error(2101, g_inc_cur_parent_file, g_inc_cur_parent_line, "")
            out source
        end
        inc_locate_marker_before(source, at)
        g_inc_resolved_path = 0
        var body = read_include_source(iname)
        ideCaptureResolvedModule(iname, g_inc_cur_parent_file, g_inc_cur_parent_line, body)
        if ide_enabled() == 1 do
            var is_root = 0
            if g_inc_main_file == 0 do
                is_root = 1
            eif g_inc_cur_parent_file != 0 and rt_streq(g_inc_cur_parent_file, g_inc_main_file) == 1 do
                is_root = 1
            end
            if is_root == 1 do
                var inc_res = 0
                if body != 0 do inc_res = 1 end
                ide_register_include(iname, g_inc_cur_parent_line, 0, inc_res)
            end
        end
        if body == 0 do
            inc_report_early_error(2102, g_inc_cur_parent_file, g_inc_cur_parent_line, native_read_i64(iname as i64, 0) as string)
            out source
        end
        var body_path = g_inc_resolved_path
        if body_path == 0 do body_path = native_read_i64(iname as i64, 0) end
        if inc_validate_utf8_source(body, body_path) == 0 do out source end
        var inc_key = g_inc_canonical_id
        if inc_key == 0 do
            inc_key = g_inc_resolved_path
        end
        if inc_key == 0 do
            inc_key = native_read_i64(iname as i64, 0)
        end
        if check_active_cycle(source, at, inc_key) == 1 do
            inc_set_error(2105)
            out source
        end
        let inc_key_fat = str_from_cstr(inc_key)
        if g_inc_has(inc_key_fat) == 1 do
            let end_at = text_skip_include_stmt(source, at)
            let dup_str = inc_make_dup_comment(inc_key)
            source = text_splice_at(source, at, end_at, dup_str)
        else
            g_inc_mark(inc_key_fat)
            body = text_ascii_sanitize(body)
            let end_at = text_skip_include_stmt(source, at)
            inc_locate_marker_before(source, at)
            let p_file = g_inc_cur_parent_file
            let p_line = g_inc_cur_parent_line + inc_count_newlines(source, at, end_at)
            let wrapped_body = inc_wrap_source_with_mod(body, body_path, p_file, p_line, inc_key)
            source = text_splice_at(source, at, end_at, wrapped_body)
        end
    end
    if guard >= G_PREPROCESS_MAX do
        inc_report_early_error(2104, g_inc_cur_parent_file, g_inc_cur_parent_line, "")
    end
    out source
end.

# ── Text-level import splice: import add from math → splice func add ──

