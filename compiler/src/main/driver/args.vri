##
 * compiler/src/main/driver/args.vri — Compiler Driver: command-line argument parsing
 * VIRC-PLN-0008: extracted verbatim from compiler/src/main/driver.vri.
 ##

# CLI Argument Parsing
# ═══════════════════════════════════════════════════════

func virc_derive_default_output_path(input_path: int, emit_asm: int) -> int:
    if input_path == 0 do
        if emit_asm == 1 do out "a.s" as int end
        out "a.out" as int
    end

    let plen = rt_strlen(input_path)
    var
        start = 0
        i = 0
    when i < plen loop
        let ch = native_read_u8(input_path, i)
        if ch == 47 or ch == 92 do
            start = i + 1
        end
        i = i + 1
    end

    var dot = plen
    i = start
    when i < plen loop
        if native_read_u8(input_path, i) == 46 do
            dot = i
        end
        i = i + 1
    end

    if dot == start do
        dot = plen
    end

    var stem_len = dot - start
    if stem_len <= 0 do
        stem_len = plen - start
    end
    if stem_len <= 0 do
        if emit_asm == 1 do out "a.s" as int end
        out "a.out" as int
    end

    let out_buf = vir_alloc(stem_len + 4)
    var j = 0
    when j < stem_len loop
        native_write_u8(out_buf, j, native_read_u8(input_path, start + j))
        j = j + 1
    end

    if emit_asm == 1 do
        native_write_u8(out_buf, j, 46)
        native_write_u8(out_buf, j + 1, 115)
        native_write_u8(out_buf, j + 2, 0)
    else
        native_write_u8(out_buf, j, 0)
    end

    out out_buf
end.

func parse_args:
    vircResolveUi()
    let argc = arg_count()
    let cfg = default_config()

    # A fresh request owns optimizer selection; globals are reset bridges.
    set_pipeline_opt_level(1)
    set_pipeline_hir_mode(0)
    set_pipeline_mutate_mir(0)
    set_simd_feature_enabled(1)
    set_rvv_feature_enabled(0)
    g_diag_json = 0
    g_check_only = 0
    g_dump_semantic = 0
    g_dump_mir = 0
    g_dump_lir = 0
    g_ide_semantic = 0
    g_color_mode = 0
    g_phase_timings = 0
    g_has_custom_entry = 0
    g_entry_function_name = ""

    var base_idx = 0
    if argc > 0 do
        let executable_arg = get_arg(0)
        if executable_arg != 0 and cstr_ends_with_vri(executable_arg) == 0 do
            base_idx = 1
        end
    end

    var a = base_idx
    var cli_sysroot = 0
    var print_sysroot_flag = 0
    var print_stdlib_flag = 0
    # Machine-mode errors must not depend on where --json appears in argv.
    when a < argc loop
        let jsonArg = get_arg(a)
        if rt_streq(jsonArg, "--json" as int) do g_diag_json = 1 end
        if rt_streq(jsonArg, "--check" as int) do g_diag_json = 1 end
        if rt_streq(jsonArg, "--ide-semantic" as int) do g_diag_json = 1 end
        if rt_streq(jsonArg, "--print-sysroot" as int) do print_sysroot_flag = 1 end
        if rt_streq(jsonArg, "--print-stdlib" as int) do print_stdlib_flag = 1 end
        if rt_streq(jsonArg, "--sysroot" as int) do
            if a + 1 < argc do
                cli_sysroot = get_arg(a + 1)
                a = a + 1
            else
                vircArgumentError("--sysroot requires an argument" as int, 0)
            end
        end
        a = a + 1
    end
    a = base_idx
    when a < argc loop
        let cur = get_arg(a)
        if rt_streq(cur, "--version" as int) or rt_streq(cur, "-v" as int) do
            vircPrintVersion()
            sys_exit(0)
        end
        if rt_streq(cur, "--help" as int) or rt_streq(cur, "-h" as int) do
            vircPrintHelp()
            sys_exit(0)
        end
        a = a + 1
    end

    # Resolve sysroot before handling observability print flags or compilation
    virc_resolve_sysroot(cli_sysroot)

    if print_sysroot_flag == 1 do
        if g_virc_sysroot != 0 do
            if g_diag_json == 1 do
                var sb = sb_new()
                sb = sb_append(sb, "{\"status\":\"ok\",\"sysroot\":\"")
                sb = sb_append(sb, g_virc_sysroot)
                sb = sb_append(sb, "\"}")
                print_str(sb_to_string(sb))
                sb_free(sb)
            else
                print_str(g_virc_sysroot)
            end
            sys_exit(0)
        else
            if g_diag_json == 1 do
                print_str("{\"schema_version\":1,\"success\":false,\"error_kind\":\"sysroot\",\"message\":\"failed to resolve toolchain sysroot\",\"argument\":\"\",\"diagnostics\":[],\"error_count\":1,\"warning_count\":0}")
            else
                print_str("virc: error [E2120]: failed to resolve toolchain sysroot")
            end
            sys_exit(1)
        end
    end

    if print_stdlib_flag == 1 do
        if g_virc_stdlib_dir != 0 do
            if g_diag_json == 1 do
                var sb = sb_new()
                sb = sb_append(sb, "{\"status\":\"ok\",\"stdlib\":\"")
                sb = sb_append(sb, g_virc_stdlib_dir)
                sb = sb_append(sb, "\",\"registry\":\"")
                sb = sb_append(sb, g_virc_stdlib_registry)
                sb = sb_append(sb, "\"}")
                print_str(sb_to_string(sb))
                sb_free(sb)
            else
                print_str(g_virc_stdlib_dir)
            end
            sys_exit(0)
        else
            if g_diag_json == 1 do
                print_str("{\"schema_version\":1,\"success\":false,\"error_kind\":\"sysroot\",\"message\":\"failed to resolve toolchain sysroot and stdlib\",\"argument\":\"\",\"diagnostics\":[],\"error_count\":1,\"warning_count\":0}")
            else
                print_str("virc: error [E2120]: failed to resolve toolchain sysroot and stdlib")
            end
            sys_exit(1)
        end
    end

    if argc <= base_idx do
        vircArgumentError("no input file" as int, 0)
    end


    var i = base_idx
    when i < argc loop
        let arg = get_arg(i)

        if rt_streq(arg, "-o" as int) do
            if i + 1 < argc do
                let outputValue = get_arg(i + 1)
                if native_read_u8(outputValue, 0) == 45 do
                    vircArgumentError("-o requires an argument" as int, 0)
                end
                if native_read_u8(outputValue, 0) == 0 do
                    vircArgumentError("-o requires an argument" as int, 0)
                end
                i = i + 1
                cfg_set_output_path(cfg, get_arg(i))
            else
                vircArgumentError("-o requires an argument" as int, 0)
            end

        eif rt_streq(arg, "-S" as int) do
            cfg_set_emit_asm(cfg, 1)

        eif rt_streq(arg, "--target" as int) do
            if i + 1 < argc do
                let targetValue = get_arg(i + 1)
                if native_read_u8(targetValue, 0) == 45 do
                    vircArgumentError("--target requires an argument" as int, 0)
                end
                if native_read_u8(targetValue, 0) == 0 do
                    vircArgumentError("--target requires an argument" as int, 0)
                end
                i = i + 1
                let tgt = get_arg(i)
                let spec = parse_target_spec(tgt)
                if spec == 0 do
                    vircArgumentError("unknown target" as int, tgt)
                end
                if target_spec_is_supported(spec) == 0 do
                    vircArgumentError("target runtime is not supported" as int, tgt)
                end
                cfg_set_target_spec(cfg, spec)
                var t_code = 0
                let arch = target_spec_arch(spec)
                if arch == TargetArch.X86_64 do
                    t_code = 1
                eif arch == TargetArch.Wasm32 do
                    t_code = 2
                eif arch == TargetArch.RISCV64 do
                    t_code = 3
                end
                cfg_set_target(cfg, t_code)
                cfg_set_out_fmt(cfg, target_spec_format(spec))
            else
                vircArgumentError("--target requires an argument" as int, 0)
            end

        eif rt_streq(arg, "--format" as int) do
            if i + 1 < argc do
                let formatValue = get_arg(i + 1)
                if native_read_u8(formatValue, 0) == 45 do
                    vircArgumentError("--format requires an argument" as int, 0)
                end
                if native_read_u8(formatValue, 0) == 0 do
                    vircArgumentError("--format requires an argument" as int, 0)
                end
                i = i + 1
                let fmt = get_arg(i)
                if rt_streq(fmt, "macho" as int) do
                    cfg_set_out_fmt(cfg, ObjectFormat.MachO)
                eif rt_streq(fmt, "elf" as int) do
                    cfg_set_out_fmt(cfg, ObjectFormat.ELF)
                eif rt_streq(fmt, "wasm" as int) do
                    cfg_set_out_fmt(cfg, ObjectFormat.Wasm)
                eif rt_streq(fmt, "pe" as int) or rt_streq(fmt, "pe_coff" as int) or rt_streq(fmt, "coff" as int) do
                    cfg_set_out_fmt(cfg, ObjectFormat.PE_COFF)
                eif rt_streq(fmt, "asm" as int) or rt_streq(fmt, "s" as int) do
                    cfg_set_emit_asm(cfg, 1)
                else
                    vircArgumentError("unknown format" as int, fmt)
                end
            else
                vircArgumentError("--format requires an argument" as int, 0)
            end

        eif rt_streq(arg, "--hir" as int) do
            set_pipeline_hir_mode(1)

        eif rt_streq(arg, "--ui=classic" as int) do
            native_write_i64(cfg as i64, 72, 0)
        eif rt_streq(arg, "--ui=modern" as int) do
            native_write_i64(cfg as i64, 72, 1)

        eif rt_streq(arg, "--mir-full" as int) do
            cfgSetOptimization(cfg, 3, arg)

        eif rt_streq(arg, "-O0" as int) do
            cfgSetOptimization(cfg, 0, arg)
        eif rt_streq(arg, "-O1" as int) do
            cfgSetOptimization(cfg, 1, arg)
        eif rt_streq(arg, "-O2" as int) do
            cfgSetOptimization(cfg, 2, arg)
        eif rt_streq(arg, "-O3" as int) do
            cfgSetOptimization(cfg, 3, arg)

        eif rt_streq(arg, "--mutate-mir=missing_reset" as int) do
            set_pipeline_mutate_mir(1)
        eif rt_streq(arg, "--mutate-mir=duplicate_reset" as int) do
            set_pipeline_mutate_mir(2)
        eif rt_streq(arg, "--mutate-mir=misordered_reset" as int) do
            set_pipeline_mutate_mir(3)
        eif rt_streq(arg, "--mutate-mir=missing_slp_alias_check" as int) do
            set_pipeline_mutate_mir(4)
        eif rt_streq(arg, "--mutate-mir=missing_slp_tail" as int) do
            set_pipeline_mutate_mir(5)
        eif rt_streq(arg, "--mutate-mir=unresolved_direct_call" as int) do
            set_pipeline_mutate_mir(6)
        eif rt_streq(arg, "--mutate-mir=unresolved_addr_of" as int) do
            set_pipeline_mutate_mir(7)
        eif rt_streq(arg, "--mutate-mir=identity_pre" as int) do
            set_pipeline_mutate_mir(8)
        eif rt_streq(arg, "--mutate-mir=marker_loop_transforms" as int) do
            set_pipeline_mutate_mir(9)
        eif rt_streq(arg, "--mutate-mir=corrupt_pre_phi" as int) do
            set_pipeline_mutate_mir(10)
        eif rt_streq(arg, "--no-simd" as int) do
            set_simd_feature_enabled(0)
        eif rt_streq(arg, "--enable-rvv" as int) do
            set_rvv_feature_enabled(1)

        eif rt_streq(arg, "-q" as int) or rt_streq(arg, "--quiet" as int) do
            cfg_set_verbose(cfg, 0)

        eif rt_streq(arg, "--color=always" as int) do
            g_color_mode = 1

        eif rt_streq(arg, "--color=never" as int) do
            g_color_mode = 2

        eif rt_streq(arg, "--color=auto" as int) do
            g_color_mode = 0

        eif rt_streq(arg, "--json" as int) do
            g_diag_json = 1
            cfg_set_verbose(cfg, 0)

        eif rt_streq(arg, "--ide-semantic" as int) do
            g_ide_semantic = 1
            g_diag_json = 1
            g_check_only = 1
            cfg_set_verbose(cfg, 0)

        eif rt_streq(arg, "--check" as int) do
            g_check_only = 1
            g_diag_json = 1
            cfg_set_verbose(cfg, 0)

        eif rt_streq(arg, "--timings" as int) do
            g_phase_timings = 1

        eif rt_streq(arg, "--borrow-stats" as int) do
            # Internal deterministic performance-contract instrumentation.

        eif rt_streq(arg, "--dump-semantic" as int) do
            g_dump_semantic = 1

        eif rt_streq(arg, "--dump-mir" as int) do
            g_dump_mir = 1

        eif rt_streq(arg, "--dump-lir" as int) do
            g_dump_lir = 1

        eif rt_streq(arg, "--sysroot" as int) do
            if i + 1 < argc do
                i = i + 1
                cfg_set_sysroot(cfg, get_arg(i))
            else
                vircArgumentError("--sysroot requires an argument" as int, 0)
            end

        else
            if native_read_u8(arg, 0) == 45 do
                vircArgumentError("unknown option" as int, arg)
            end
            if cfg_get_input_path(cfg) != 0 do
                vircArgumentError("multiple input files are not supported" as int, arg)
            end
            cfg_set_input_path(cfg, arg)
        end

        i = i + 1
    end

    if cfg_get_input_path(cfg) == 0 do
        vircArgumentError("no input file" as int, 0)
    end
    if cfg_get_output_path(cfg) == 0 do
        let default_out = virc_derive_default_output_path(cfg_get_input_path(cfg), cfg_get_emit_asm(cfg))
        cfg_set_output_path(cfg, default_out)
    end
    if cfg_get_sysroot(cfg) == 0 do
        if g_virc_sysroot != 0 do
            cfg_set_sysroot(cfg, g_virc_sysroot)
        end
    end
    if cfg_get_sysroot(cfg) == 0 or g_virc_stdlib_registry == 0 do
        if g_diag_json == 1 do
            print_str("{\"schema_version\":1,\"success\":false,\"error_kind\":\"sysroot\",\"message\":\"failed to resolve toolchain sysroot and stdlib\",\"argument\":\"\",\"diagnostics\":[],\"error_count\":1,\"warning_count\":0}")
        else
            print_str("virc: error [E2120]: failed to resolve toolchain sysroot and stdlib\n")
        end
        sys_exit(1)
    end
    let final_spec = cfg_get_target_spec(cfg)
    let final_fmt = cfg_get_out_fmt(cfg)
    if cfg_get_emit_asm(cfg) == 0 and g_check_only == 0 and g_dump_semantic == 0 and g_dump_mir == 0 and g_dump_lir == 0 do
        if target_spec_format_compatible(final_spec, final_fmt) == 0 do
            vircArgumentError("output format is incompatible with target" as int, target_spec_name(final_spec) as int)
        end
    end
    out cfg
end.
# ═══════════════════════════════════════════════════════
