##
 * compiler/src/main/driver/pipeline.vri — Compiler Driver: compile session reset and the virc_compile pipeline orchestrator
 * VIRC-PLN-0008, VIRC-PLN-0011: modularized into pipeline steps under compiler/src/main/driver/pipeline/.
 ##

# Compiler Pipeline Orchestrator
# ═══════════════════════════════════════════════════════

include driver_pipeline_step_frontend
include driver_pipeline_step_semantic
include driver_pipeline_step_lower
include driver_pipeline_step_backend

func vircResetCompileSession(cfg: &CompilerConfig):
    # Config owns the level even when a caller bypasses parse_args.
    set_pipeline_opt_level(cfgOptimizationLevel(cfg))
    var uiMode = native_read_i64(cfg as i64, 72)
    if g_diag_json == 1 do uiMode = 0 end
    cliUiConfigure(g_color_mode)
    cliUiReset(uiMode, 1 - cfg_get_verbose(cfg))
    optTraceReset(native_read_i64(cfg as i64, 64), cfgOptimizationLevel(cfg), g_diag_json)
    if g_time_buf_start != 0 do vir_free(g_time_buf_start) end
    g_time_buf_start = 0
    g_compile_timer_printed = 0
    g_phase_read_us = 0
    g_phase_preprocess_us = 0
    g_phase_lex_us = 0
    g_phase_parse_us = 0
    g_phase_semantic_us = 0
    g_phase_semantic_start_us = 0
    g_phase_lower_us = 0
    g_phase_codegen_us = 0
    g_phase_link_us = 0
    virc_timer_init()
    pass10SessionReset()
    g_has_custom_entry = 0
    g_entry_function_name = ""
end.

func virc_compile(cfg: CompilerConfig):
    vircResetCompileSession(cfg)
    let input_path = cfg_get_input_path(cfg)
    diagnosticStoreBegin(input_path as int, "{}" as int)
    let output_path = cfg_get_output_path(cfg)
    cliUiSetArtifact(output_path as int)
    let target = cfg_get_target(cfg)
    let out_fmt = cfg_get_out_fmt(cfg)
    var verbose = cfg_get_verbose(cfg)
    if g_ui_mode == 1 do verbose = 0 end
    let emit_asm = cfg_get_emit_asm(cfg)

    if g_ui_mode == 1 do
        if g_ui_quiet == 0 do vircModernBanner(cfg) end
    end

    # Step 1 & 2: Frontend (read, preprocess, tokenize, parse)
    let (ast, f_err) = virc_step_frontend(input_path, verbose)
    if f_err != 0 do out f_err end

    # Step 2.5: Semantic Analysis
    let sem_err = virc_step_semantic(ast, verbose)
    if g_phase_timings == 1 do
        let d5 = cliUiPhaseDurationNs(5)
        if d5 >= 0 do g_phase_semantic_us = d5 / 1000 end
    end
    if sem_err != 0 do out sem_err end

    if g_check_only == 1 do
        virc_print_compile_time()
        out 0
    end

    # Step 3: Target selection & Lowering (AST -> MIR -> LIR)
    var target_spec = cfg_get_target_spec(cfg)
    if target_spec == 0 do
        target_spec = get_host_target_spec()
        cfg_set_target_spec(cfg, target_spec)
    end

    let (lir_funcs, l_err) = virc_step_lower(input_path, ast, target_spec, verbose)
    if g_phase_timings == 1 do
        var lower_ns = 0
        let d6 = cliUiPhaseDurationNs(6)
        if d6 > 0 do lower_ns = lower_ns + d6 end
        let d7 = cliUiPhaseDurationNs(7)
        if d7 > 0 do lower_ns = lower_ns + d7 end
        let d8 = cliUiPhaseDurationNs(8)
        if d8 > 0 do lower_ns = lower_ns + d8 end
        let d9 = cliUiPhaseDurationNs(9)
        if d9 > 0 do lower_ns = lower_ns + d9 end
        if lower_ns > 0 do g_phase_lower_us = lower_ns / 1000 end
    end
    if l_err != 0 do out l_err end

    # Step 4.5: Assembly emission (-S)
    if emit_asm == 1 do
        out virc_step_emit_asm(cfg, lir_funcs, target_spec, output_path, verbose)
    end

    # Step 5 & 6: Machine code generation and binary linking
    out virc_step_emit_and_link(cfg, lir_funcs, target_spec, output_path, verbose)
end.
