##
 * compiler/src/main/driver/locate.vri — Compiler Driver: expanded-bundle source line resolution for diagnostics
 * VIRC-PLN-0008: extracted verbatim from compiler/src/main/driver.vri.
 ##

# Resolve an expanded-bundle line through markers emitted by
# tools/preexpand_virc.py:
#     # @vir_source path/to/module.vri ORIGINAL_LINE
func virc_locate_source(source: string, target_line: int):
    data = native_read_i64(source as i64, 0)
    n = native_read_i64(source as i64, 8)
    pos = 0
    expanded_line = 1
    original_line = 1
    g_virc_diag_file = "<expanded>" as i64

    when pos < n loop
        line_start = pos
        when pos < n and native_read_u8(data, pos) != 10 loop
            pos = pos + 1
        end
        line_end = pos

        is_marker = line_end - line_start >= 15
        if is_marker do
            # "# @vir_source "
            is_marker = native_read_u8(data, line_start) == 35 and native_read_u8(data, line_start + 1) == 32 and native_read_u8(data, line_start + 2) == 64 and native_read_u8(data, line_start + 3) == 118 and native_read_u8(data, line_start + 4) == 105 and native_read_u8(data, line_start + 5) == 114 and native_read_u8(data, line_start + 6) == 95 and native_read_u8(data, line_start + 7) == 115 and native_read_u8(data, line_start + 8) == 111 and native_read_u8(data, line_start + 9) == 117 and native_read_u8(data, line_start + 10) == 114 and native_read_u8(data, line_start + 11) == 99 and native_read_u8(data, line_start + 12) == 101 and native_read_u8(data, line_start + 13) == 32
        end

        if is_marker do
            path_start = line_start + 14
            sep = path_start
            when sep < line_end and native_read_u8(data, sep) != 32 loop
                sep = sep + 1
            end
            path_len = sep - path_start
            path_buf = vir_alloc(path_len + 1)
            j = 0
            when j < path_len loop
                native_write_u8(path_buf, j, native_read_u8(data, path_start + j))
                j = j + 1
            end
            native_write_u8(path_buf, path_len, 0)
            # Store a raw C-string pointer.  Keeping a fat-string aggregate in
            # a global is not stable across the many scanner CALLs in C-VM.
            g_virc_diag_file = path_buf
            original_line = 0
            k = sep + 1
            when k < line_end loop
                c = native_read_u8(data, k)
                if c >= 48 and c <= 57 do
                    original_line = original_line * 10 + c - 48
                end
                k = k + 1
            end
        else
            if expanded_line == target_line do
                g_virc_diag_line = original_line
                out 0
            end
            original_line = original_line + 1
        end

        if pos < n do
            pos = pos + 1
        end
        expanded_line = expanded_line + 1
    end

    g_virc_diag_line = original_line
    out 0
end.

