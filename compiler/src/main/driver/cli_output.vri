##
 * compiler/src/main/driver/cli_output.vri — Compiler Driver: version, help and argument-error output
 * VIRC-PLN-0008: extracted verbatim from compiler/src/main/driver.vri.
 ##

func vircPrintVersion():
    var text = sb_new()
    text = sb_append(text, "virc ")
    text = sb_append(text, vircVersionNumber())
    text = sb_append(text, " (self-hosted)")
    print_ln(sb_to_string(text))
    sb_free(text)
end.

func vircPrintHelp():
    print_ln("Usage: virc <input.vri> [-o output] [options]")
    print_ln("  -O0, -O1, -O2, -O3  Optimization level (default: O1)")
    print_ln("  --mir-full          Compatibility alias for -O3; last selector wins")
    print_ln("  --ui=classic|modern Human UI (default: classic; CLI overrides VIRC_UI)")
    print_ln("                      Modern progress with host monotonic durations")
    print_ln("  --target <target>   macos-arm64, macos-arm64-libsystem, linux-arm64, windows-arm64, linux-x86_64, windows-x86_64, linux-riscv64, wasm32-wasi-p1")
    print_ln("  --format <format>   macho, elf, pe, wasm or asm")
    print_ln("  -S                  Emit assembly")
    print_ln("  -q, --quiet         Suppress progress messages")
    print_ln("  --color=auto|always|never  Diagnostic color policy")
    print_ln("  --json, --check, --ide-semantic  Structured diagnostic/tooling output")
    print_ln("  --timings           Phase timings")
    print_ln("  --hir               Use HIR lowering")
    print_ln("  --no-simd, --enable-rvv  Target SIMD feature controls")
    print_ln("  --sysroot <path>    Override toolchain sysroot path")
    print_ln("  --print-sysroot     Print canonical resolved sysroot directory and exit")
    print_ln("  --print-stdlib      Print canonical resolved standard library directory and exit")
    print_ln("  -v, --version       Print version")
    print_ln("  -h, --help          Print help")
end.

func vircArgumentError(message: int, argument: int):
    if g_diag_json == 1 do
        var text = sb_new()
        text = sb_append(text, "{\"schema_version\":1,\"success\":false,\"error_kind\":\"argument\",\"message\":\"")
        text = pass10_json_escape_cstr(text, message)
        text = sb_append(text, "\",\"argument\":\"")
        text = pass10_json_escape_cstr(text, argument)
        text = sb_append(text, "\",\"diagnostics\":[],\"error_count\":1,\"warning_count\":0}")
        print_ln(sb_to_string(text))
        sb_free(text)
    else
        var text = sb_new()
        text = sb_append(text, "virc: error_msg: ")
        text = sb_append(text, message)
        if argument != 0 do
            text = sb_append(text, ": ")
            text = sb_append(text, argument)
        end
        if g_ui_mode == 1 do
            cliUiLine(sb_to_string(text))
        else
            print_ln(sb_to_string(text))
        end
        sb_free(text)
    end
    sys_exit(1)
end.
