##
 * compiler/src/main/driver/banner.vri — Compiler Driver: compatibility and modern banner rendering
 * VIRC-PLN-0008: extracted verbatim from compiler/src/main/driver.vri.
 ##

# Entry Point (called from _start via rt/start.vri)
# ═══════════════════════════════════════════════════════

func should_print_banner:
    let argc = arg_count()
    var i = 0
    when i < argc loop
        let a = get_arg(i)
        if rt_streq(a, "-q" as int) or rt_streq(a, "--quiet" as int) or rt_streq(a, "--json" as int) or rt_streq(a, "--print-sysroot" as int) or rt_streq(a, "--print-stdlib" as int) do
            out 0
        end
        i = i + 1
    end
    out 1
end.

func virc_print_banner:
    print_ln("====================================")
    print_ln("  virc — Vir Self-Hosting Compiler")
    var text = sb_new()
    text = sb_append(text, "  v")
    text = sb_append(text, vircVersionNumber())
    text = sb_append(text, " — ")
    text = sb_append(text, vircReleaseHighlights())
    print_ln(sb_to_string(text))
    sb_free(text)
    print_ln("====================================")
end.

func vircBannerBoxRow(content: i64):
    var text = sb_new()
    if g_ui_colorEnabled == 1 do
        text = cliUiAppendAnsi(text, "[90m")
        text = sb_append(text, "│")
        text = cliUiAppendReset(text)
        text = sb_append(text, "  ")
    else
        text = sb_append(text, "│  ")
    end
    text = cliUiAppendSafe(text, content as int, 0)
    var cur_len = rt_strlen(content) + 2
    when cur_len < 70 loop
        text = sb_append_char(text, 32)
        cur_len = cur_len + 1
    end
    if g_ui_colorEnabled == 1 do
        text = cliUiAppendAnsi(text, "[90m")
        text = sb_append(text, "│")
        text = cliUiAppendReset(text)
    else
        text = sb_append(text, "│")
    end
    cliUiLine(sb_to_string(text))
    sb_free(text)
end.

func vircBannerBoxRowColor(content: i64, visible_len: int, styled: i64):
    var text = sb_new()
    if g_ui_colorEnabled == 1 do
        text = cliUiAppendAnsi(text, "[90m")
        text = sb_append(text, "│")
        text = cliUiAppendReset(text)
        text = sb_append(text, "  ")
        text = sb_append(text, styled)
    else
        text = sb_append(text, "│  ")
        text = cliUiAppendSafe(text, content as int, 0)
    end
    var cur_len = visible_len + 2
    when cur_len < 70 loop
        text = sb_append_char(text, 32)
        cur_len = cur_len + 1
    end
    if g_ui_colorEnabled == 1 do
        text = cliUiAppendAnsi(text, "[90m")
        text = sb_append(text, "│")
        text = cliUiAppendReset(text)
    else
        text = sb_append(text, "│")
    end
    cliUiLine(sb_to_string(text))
    sb_free(text)
end.

func vircModernBanner(cfg: &CompilerConfig):
    var top = sb_new()
    top = cliUiAppendAnsi(top, "[90m")
    top = sb_append(top, "╭──────────────────────────────────────────────────────────────────────╮")
    top = cliUiAppendReset(top)
    cliUiLine(sb_to_string(top))
    sb_free(top)

    var st1 = sb_new()
    st1 = cliUiAppendAnsi(st1, "[1;36m")
    st1 = sb_append(st1, "VIRC")
    st1 = cliUiAppendReset(st1)
    vircBannerBoxRowColor("VIRC", 4, sb_to_string(st1))
    sb_free(st1)

    var st2 = sb_new()
    st2 = cliUiAppendAnsi(st2, "[37m")
    st2 = sb_append(st2, "The Virgori (Vir) Programming Language Compiler")
    st2 = cliUiAppendReset(st2)
    vircBannerBoxRowColor("The Virgori (Vir) Programming Language Compiler", 47, sb_to_string(st2))
    sb_free(st2)

    vircBannerBoxRow("")

    var vnum = vircVersionNumber()
    var p4 = sb_new()
    p4 = sb_append(p4, "Version      ")
    p4 = sb_append(p4, vnum)
    var st4 = sb_new()
    st4 = cliUiAppendAnsi(st4, "[90m")
    st4 = sb_append(st4, "Version      ")
    st4 = cliUiAppendReset(st4)
    st4 = cliUiAppendAnsi(st4, "[37m")
    st4 = sb_append(st4, vnum)
    st4 = cliUiAppendReset(st4)
    vircBannerBoxRowColor(sb_to_string(p4), 13 + rt_strlen(vnum), sb_to_string(st4))
    sb_free(p4)
    sb_free(st4)

    var rel = vircReleaseHighlights()
    var p5 = sb_new()
    p5 = sb_append(p5, "What's New   ")
    p5 = sb_append(p5, rel)
    var st5 = sb_new()
    st5 = cliUiAppendAnsi(st5, "[90m")
    st5 = sb_append(st5, "What's New   ")
    st5 = cliUiAppendReset(st5)
    st5 = cliUiAppendAnsi(st5, "[36m")
    st5 = sb_append(st5, rel)
    st5 = cliUiAppendReset(st5)
    vircBannerBoxRowColor(sb_to_string(p5), 13 + rt_strlen(rel), sb_to_string(st5))
    sb_free(p5)
    sb_free(st5)

    var hspec = target_spec_name(get_host_target_spec())
    var p6 = sb_new()
    p6 = sb_append(p6, "Host         ")
    p6 = sb_append(p6, hspec)
    var st6 = sb_new()
    st6 = cliUiAppendAnsi(st6, "[90m")
    st6 = sb_append(st6, "Host         ")
    st6 = sb_append(st6, hspec)
    st6 = cliUiAppendReset(st6)
    vircBannerBoxRowColor(sb_to_string(p6), 13 + rt_strlen(hspec), sb_to_string(st6))
    sb_free(p6)
    sb_free(st6)

    var tspec = target_spec_name(cfg_get_target_spec(cfg))
    var p7 = sb_new()
    p7 = sb_append(p7, "Target       ")
    p7 = sb_append(p7, tspec)
    var st7 = sb_new()
    st7 = cliUiAppendAnsi(st7, "[90m")
    st7 = sb_append(st7, "Target       ")
    st7 = sb_append(st7, tspec)
    st7 = cliUiAppendReset(st7)
    vircBannerBoxRowColor(sb_to_string(p7), 13 + rt_strlen(tspec), sb_to_string(st7))
    sb_free(p7)
    sb_free(st7)

    var bot = sb_new()
    bot = cliUiAppendAnsi(bot, "[90m")
    bot = sb_append(bot, "╰──────────────────────────────────────────────────────────────────────╯")
    bot = cliUiAppendReset(bot)
    cliUiLine(sb_to_string(bot))
    sb_free(bot)

    cliUiLine("")
    var text = sb_new()
    text = cliUiAppendAnsi(text, "[36m")
    text = sb_append(text, "Reading ")
    text = cliUiAppendReset(text)
    text = cliUiAppendAnsi(text, "[90m")
    text = cliUiAppendSafe(text, cfg_get_input_path(cfg) as int, 0)
    text = sb_append(text, "...")
    text = cliUiAppendReset(text)
    cliUiLine(sb_to_string(text))
    sb_free(text)
    cliUiLine("")
end.
