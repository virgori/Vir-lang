func dump_semantic_node(node: &AstNode, depth: int):
    if node == 0 do out 0 end
    let child_count = vec_len_rt(node.children)
    var i = 0
    when i < child_count loop
        let child = vec_get_rt(node.children, i) as AstNode
        if child != 0 do
            if child.node_type == AstType.VarDecl or child.node_type == AstType.ConstDecl do
                var sb = sb_new()
                var d = 0
                when d < depth loop
                    sb = sb_append(sb, "  ")
                    d = d + 1
                end
                sb = sb_append(sb, "var ")
                if child.name as int != 0 do
                    sb = sb_append_fat(sb, child.name as int)
                end
                sb = sb_append(sb, ": ")
                if child.name2 as int != 0 and fat_str_len(child.name2 as string) > 0 do
                    sb = sb_append_fat(sb, child.name2 as int)
                else
                    sb = sb_append(sb, "unknown")
                end
                print_ln(sb_to_string(sb))
                sb_free(sb)
            end
            if child.node_type == AstType.Block or child.node_type == AstType.WhenStmt or child.node_type == AstType.IfStmt or child.node_type == AstType.LoopStmt or child.node_type == AstType.TryStmt or child.node_type == AstType.InferBlock do
                dump_semantic_node(child, depth + 1)
            end
        end
        i = i + 1
    end
    out 0
end.

func virc_step_semantic(ast: &AstNode, verbose: int):
    # ── Step 2.5: Semantic Analysis ──
    cliUiPhaseBegin(5)
    if verbose == 1 do
        print_ln("virc: running semantic analysis...")
    end

    let sem_errors = semantic_run(ast, verbose)
    if sem_errors > 0 do
        if g_diag_json == 0 do
            if g_ui_mode == 0 do
            arena:
                var sb_sem = sb_new()
                sb_sem = sb_append(sb_sem, "virc: compilation aborted — ")
                sb_sem = sb_append_int(sb_sem, sem_errors)
                sb_sem = sb_append(sb_sem, " semantic error(s)")
                print_ln(sb_to_string(sb_sem))
                sb_free(sb_sem)
            end
            end
        end
        virc_print_compile_time()
        out 1
    end

    cliUiPhaseEnd(5, 0 - 1, 0)

    if get_dump_semantic() == 1 do
        print_ln("=== SEMANTIC DUMP ===")
        if ast != 0 do
            let child_count = vec_len_rt(ast.children)
            var i = 0
            when i < child_count loop
                let child = vec_get_rt(ast.children, i) as AstNode
                if child != 0 do
                    var sb = sb_new()
                    sb = sb_append(sb, "  decl [")
                    sb = sb_append_int(sb, child.node_type as int)
                    sb = sb_append(sb, "] line ")
                    sb = sb_append_int(sb, child.line)
                    if child.name as int != 0 do
                        sb = sb_append(sb, ": ")
                        sb = sb_append_fat(sb, child.name as int)
                    end
                    print_ln(sb_to_string(sb))
                    sb_free(sb)
                    if child.node_type == AstType.FuncDef do
                        dump_semantic_node(child, 2)
                    end
                end
                i = i + 1
            end
        end
        sys_exit(0)
    end

    out 0
end.
