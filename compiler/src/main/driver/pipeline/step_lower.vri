##
 * compiler/src/main/driver/pipeline/step_lower.vri — Compiler Driver: AST to LIR lowering step
 ##

func virc_step_lower(input_path: string, ast: &AstNode, target_spec: &TargetSpec, verbose: int):
    let target_arch = target_spec_arch(target_spec)
    set_codegen_spec(target_spec)
    set_codegen_target(target_arch as int)

    if verbose == 1 do
        print_ln("virc: lowering via v2.0 MIR/SSA/LIR pipeline...")
    end

    let lir_funcs = compile_pipeline(input_path, ast, verbose)
    let n_funcs = vec_len_rt(lir_funcs)

    # Executable compilation must never silently accept an empty pipeline.
    # Without this guard the runtime-only ARM64 stubs form a valid Mach-O that
    # exits 0 immediately, which looks like a successful compiler promotion.
    if n_funcs <= 0 do
        compilerFailure(0, "pipeline produced no LIR functions" as int, "virc: error: pipeline produced no LIR functions" as int)
        out (0, 1)
    end

    if verbose == 1 do
        arena:
            var sb = sb_new()
            sb = sb_append(sb, "virc: ")
            sb = sb_append_int(sb, n_funcs)
            sb = sb_append(sb, " function(s) lowered to LIR")
            print_ln(sb_to_string(sb))
            sb_free(sb)
        end
    end

    var entry_name = fat_str_new("main")
    if g_has_custom_entry == 1 and fat_str_len(g_entry_function_name) > 0 do
        entry_name = g_entry_function_name
    end

    let main_idx = lir_find_func_index(lir_funcs, entry_name)
    if main_idx < 0 do
        if g_has_custom_entry == 1 do
            arena:
                var sb = sb_new()
                sb = sb_append(sb, "virc: error: executable has no ")
                sb = sb_append(sb, entry_name)
                sb = sb_append(sb, " function in LIR")
                let msg = sb_to_string(sb)
                compilerFailure(0, "executable has no entry function in LIR" as int, msg as int)
                sb_free(sb)
            end
        else
            compilerFailure(0, "executable has no main function in LIR" as int, "virc: error: executable has no main function in LIR" as int)
        end
        out (0, 1)
    end

    out (lir_funcs, 0)
end.
