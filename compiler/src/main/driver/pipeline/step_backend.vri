##
 * compiler/src/main/driver/pipeline/step_backend.vri — Compiler Driver: Assembly emission and machine-code linking
 ##

func virc_step_emit_asm(cfg: CompilerConfig, lir_funcs: i64, target_spec: &TargetSpec, output_path: string, verbose: int):
    let target = cfg_get_target(cfg)
    let target_arch = target_spec_arch(target_spec)
    let target_name = target_spec_name(target_spec)
    let n_funcs = vec_len_rt(lir_funcs)

    cliUiPhaseBegin(10)
    if verbose == 1 do
        arena:
            var sb_v = sb_new()
            sb_v = sb_append(sb_v, "virc: emitting ")
            sb_v = sb_append(sb_v, target_name)
            sb_v = sb_append(sb_v, " assembly (MCInst pipeline)...")
            print_ln(sb_to_string(sb_v))
            sb_free(sb_v)
        end
    end

    var dialect = target_spec_dialect(target_spec)

    var asm_b = bvec_new()
    asm_b = print_mc_assembly_prologue(dialect, asm_b)

    var f_asm_idx = 0
    when f_asm_idx < n_funcs loop
        let f_obj = vec_get_rt(lir_funcs, f_asm_idx)
        let f_fat = native_read_i64(f_obj as i64, 8)
        var f_name = f_fat
        if f_fat != 0 do
            f_name = native_read_i64(f_fat, 0)
        end
        asm_b = print_mc_function_header(f_name as int, dialect, asm_b)

        let mc_insts = lir_func_to_mc(f_obj, 0 - 1, target as int)
        if mc_insts == 0 do
            compilerFailure(0, "unresolved symbol during MCInst lowering" as int, "virc: error: unresolved symbol during MCInst lowering" as int)
            out 1
        end
        let v_ok = mc_verify_function(mc_insts, target_arch as int)
        if v_ok == 0 do
            compilerFailure(0, "MCInst verification failed" as int, "virc: error: MCInst verification failed" as int)
            out 1
        end
        let n_mc = vec_len_rt(mc_insts)
        var mc_i = 0
        when mc_i < n_mc loop
            let mc_ins = vec_get_rt(mc_insts, mc_i)
            asm_b = print_mc_inst(mc_ins as MCInst, dialect, asm_b)
            mc_i = mc_i + 1
        end

        asm_b = print_mc_function_footer(f_name as int, dialect, asm_b)
        f_asm_idx = f_asm_idx + 1
    end

    asm_b = print_mc_runtime_stubs(dialect, asm_b)
    asm_b = print_mc_string_pool(lir_funcs, dialect, asm_b)

    var out_asm_path = output_path
    if rt_streq(out_asm_path, "a.out" as int) do
        out_asm_path = "a.s" as int
    end

    if !write_file_bytes(out_asm_path, asm_b, bvec_len(asm_b), 0o644) do
        compilerFailure(0, "cannot write output file" as int, "virc: error: cannot write output file" as int)
        out 1
    end
    cliUiPhaseEnd(10, bvec_len(asm_b), "bytes" as int)
    if g_phase_timings == 1 do
        let d10 = cliUiPhaseDurationNs(10)
        if d10 >= 0 do g_phase_codegen_us = d10 / 1000 end
    end

    if verbose == 1 do
        arena:
            var sb_done = sb_new()
            sb_done = sb_append(sb_done, "virc: done! ")
            sb_done = sb_append(sb_done, out_asm_path)
            sb_done = sb_append(sb_done, " (assembly)")
            print_ln(sb_to_string(sb_done))
            sb_free(sb_done)
        end
    end
    out 0
end.

func virc_step_emit_and_link(cfg: CompilerConfig, lir_funcs: i64, target_spec: &TargetSpec, output_path: string, verbose: int):
    let target_arch = target_spec_arch(target_spec)
    let target_name = target_spec_name(target_spec)
    var container_arch = 0
    if target_arch == TargetArch.X86_64 do
        container_arch = 1
    eif target_arch == TargetArch.Wasm32 do
        container_arch = 2
    eif target_arch == TargetArch.RISCV64 do
        container_arch = 3
    end

    # ── Step 5: Code Generation directly from LIR ──
    cliUiPhaseBegin(10)
    if verbose == 1 do
        arena:
            var sb = sb_new()
            sb = sb_append(sb, "virc: generating ")
            sb = sb_append(sb, target_name)
            sb = sb_append(sb, " machine code...")
            print_ln(sb_to_string(sb))
            sb_free(sb)
        end
    end

    var code = codebuf_new(target_arch)
    if target_arch == TargetArch.ARM64 do
        code = emit_lir_module_arm64(lir_funcs, target_spec)
    eif target_arch == TargetArch.X86_64 do
        code = emit_lir_module_x86_64(lir_funcs, target_spec)
    eif target_arch == TargetArch.RISCV64 do
        code = emit_lir_module_riscv64(lir_funcs)
    else
        code = lir_emit_module(lir_funcs, target_arch)
    end
    let code_size = codebuf_offset(code)

    if target_arch != TargetArch.Wasm32 and code_size <= 0 do
        compilerFailure("E-CODEGEN-EMPTY" as int, "target backend emitted no machine code" as int, "virc: error [E-CODEGEN-EMPTY]: target backend emitted no machine code" as int)
        out 1
    end

    if target_spec_format(target_spec) == ObjectFormat.ELF and ffi_import_used_count() > 0 do
        compilerFailure("E-FFI-ELF-UNSUPPORTED" as int, "dynamic ELF extern imports are not implemented for this target" as int, "virc: error [E-FFI-ELF-UNSUPPORTED]: dynamic ELF extern imports are not implemented for this target" as int)
        out 1
    end

    if verbose == 1 do
        arena:
            var sb = sb_new()
            sb = sb_append(sb, "virc: ")
            sb = sb_append_int(sb, code_size)
            sb = sb_append(sb, " bytes machine code")
            print_ln(sb_to_string(sb))
            sb_free(sb)
        end
    end

    # ── Step 6: Emit executable ──
    cliUiPhaseEnd(10, code_size, "bytes" as int)
    cliUiPhaseBegin(11)
    if verbose == 1 do
        var fmt_name = "Mach-O"
        let t_fmt = target_spec_format(target_spec)
        if t_fmt == ObjectFormat.ELF do
            fmt_name = "ELF"
        eif t_fmt == ObjectFormat.Wasm or target_arch == TargetArch.Wasm32 do
            fmt_name = "WASM"
        eif t_fmt == ObjectFormat.PE_COFF do
            fmt_name = "PE32+"
        end
        arena:
            var sb = sb_new()
            sb = sb_append(sb, "virc: linking ")
            sb = sb_append(sb, fmt_name)
            sb = sb_append(sb, " ")
            sb = sb_append(sb, target_name)
            sb = sb_append(sb, " executable...")
            print_ln(sb_to_string(sb))
            sb_free(sb)
        end
    end

    let final_fmt = cfg_get_out_fmt(cfg)
    var outputWritten = false
    if target_arch == TargetArch.Wasm32 or final_fmt == ObjectFormat.Wasm do
        outputWritten = wasm_lir_write_module(lir_funcs, output_path)
    eif final_fmt == ObjectFormat.MachO do
        let mb = macho_new(container_arch)
        let c_data = native_read_i64(code as i64, 8)
        let c_entry = native_read_i64(code as i64, 24)
        native_write_i64(mb as i64, 24, c_data)
        native_write_i64(mb as i64, 40, c_entry)
        outputWritten = macho_write_to_file(mb, output_path)
    eif final_fmt == ObjectFormat.ELF do
        let eb = elf_new(container_arch)
        let c_data = native_read_i64(code as i64, 8)
        let c_entry = native_read_i64(code as i64, 24)
        native_write_i64(eb as i64, 24, c_data)
        native_write_i64(eb as i64, 40, c_entry)
        outputWritten = elf_write_to_file(eb, output_path)
    eif final_fmt == ObjectFormat.PE_COFF do
        let pb = pe_new(container_arch)
        let c_data = native_read_i64(code as i64, 8)
        let c_entry = native_read_i64(code as i64, 24)
        native_write_i64(pb as i64, 16, c_data)
        native_write_i64(pb as i64, 24, c_entry)
        outputWritten = pe_write_to_file(pb, output_path)
    else
        compilerFailure("E-FORMAT-UNSUPPORTED" as int, "unsupported output format" as int, "virc: error [E-FORMAT-UNSUPPORTED]: unsupported output format" as int)
        out 1
    end

    if !outputWritten do
        compilerFailure(0, "cannot write output file" as int, "virc: error: cannot write output file" as int)
        out 1
    end
    cliUiPhaseEnd(11, 0 - 1, 0)
    if g_phase_timings == 1 do
        let d10 = cliUiPhaseDurationNs(10)
        if d10 >= 0 do g_phase_codegen_us = d10 / 1000 end
        let d11 = cliUiPhaseDurationNs(11)
        if d11 >= 0 do g_phase_link_us = d11 / 1000 end
    end

    if verbose == 1 do
        arena:
            var sb = sb_new()
            sb = sb_append(sb, "virc: done! ")
            sb = sb_append(sb, output_path)
            sb = sb_append(sb, " (")
            sb = sb_append_int(sb, code_size)
            sb = sb_append(sb, " bytes code)")
            print_ln(sb_to_string(sb))
            sb_free(sb)
        end
    end

    out 0
end.
