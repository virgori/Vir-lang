##
 * compiler/src/main/driver/defaults.vri — Compiler Driver: bootstrap globals, panic target, default config and path predicates
 * VIRC-PLN-0008: extracted verbatim from compiler/src/main/driver.vri.
 ##

# C-VM bootstrap CALLs may clobber locals that hold aggregate values.  Keep
# the parser hand-off pointer global so it is reloaded for every use.
var g_virc_parser_tokens: i64 = 0
var g_virc_diag_file: i64 = 0
var g_virc_diag_line: i64 = 0

# Bootstrap-wide panic target for low-level mem helpers.  These helpers are
# part of the compiler bundle and must resolve to a real terminating function,
# not an unresolved linker placeholder.
func panic(msg: string):
    print_ln(msg)
    sys_exit(1)
end.

func default_config:
    let p = vir_alloc(88)
    native_write_i64(p, 0, 0)
    native_write_i64(p, 8, 0)
    native_write_i64(p, 16, 0)
    native_write_i64(p, 24, 0)
    native_write_i64(p, 32, 1)
    native_write_i64(p, 40, 0)
    native_write_i64(p, 56, 1)
    native_write_i64(p, 64, "default" as int)
    native_write_i64(p, 72, g_ui_mode)
    native_write_i64(p, 80, 0)
    let def_spec = get_host_target_spec()
    native_write_i64(p, 48, def_spec as i64)
    if def_spec != 0 do
        var t_code = 0
        let arch = target_spec_arch(def_spec)
        if arch == TargetArch.X86_64 do
            t_code = 1
        eif arch == TargetArch.Wasm32 do
            t_code = 2
        eif arch == TargetArch.RISCV64 do
            t_code = 3
        end
        native_write_i64(p, 16, t_code)
        native_write_i64(p, 24, target_spec_format(def_spec))
    end
    out p as CompilerConfig
end.
func cstr_ends_with_vri(s: int):
    if s == 0 do out 0 end
    let l = rt_strlen(s)
    if l < 4 do out 0 end
    if native_read_u8(s, l - 4) != 46 do out 0 end
    if native_read_u8(s, l - 3) != 118 do out 0 end
    if native_read_u8(s, l - 2) != 114 do out 0 end
    if native_read_u8(s, l - 1) != 105 do out 0 end
    out 1
end.
