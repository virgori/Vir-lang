##
 * compiler/src/main/driver/ui.vri — Compiler Driver: UI/colour/JSON mode resolution
 * VIRC-PLN-0008: extracted verbatim from compiler/src/main/driver.vri.
 ##

# Resolve before the compatibility banner, so modern/help/JSON never leak it.
# An explicit CLI selector supersedes the environment; invalid selectors fail
# before lexer/pipeline. JSON overrides rendering, not argument validation.
func vircResolveUi():
    g_ui_mode = 0
    g_diag_json = 0
    var
        selector = 0
        index = 0
    when index < arg_count() loop
        let argument = get_arg(index)
        if rt_streq(argument, "--json" as int) do g_diag_json = 1 end
        if rt_streq(argument, "--check" as int) do g_diag_json = 1 end
        if rt_streq(argument, "--ide-semantic" as int) do g_diag_json = 1 end
        index = index + 1
    end
    index = 0
    when index < arg_count() loop
        let argument = get_arg(index)
        if rt_streq(argument, "--json" as int) do g_diag_json = 1 end
        if rt_streq(argument, "--check" as int) do g_diag_json = 1 end
        if rt_streq(argument, "--ide-semantic" as int) do g_diag_json = 1 end
        if rt_strlen(argument) >= 5 do
            var prefix = 1
            let expected = "--ui=" as int
            var character = 0
            when character < 5 loop
                if native_read_u8(argument, character) != native_read_u8(expected, character) do prefix = 0 end
                character = character + 1
            end
            if prefix == 1 do
                selector = argument + 5
                if rt_streq(selector, "classic" as int) == 0 do
                    if rt_streq(selector, "modern" as int) == 0 do
                        vircArgumentError("--ui requires classic or modern" as int, selector)
                    end
                end
            end
        end
        index = index + 1
    end
    if selector != 0 do
        if rt_streq(selector, "modern" as int) do g_ui_mode = 1 end
        out
    end
    let environment = cliEnvironmentGet("VIRC_UI" as int)
    if environment < 0 do
        vircArgumentError("cannot read VIRC_UI; select --ui=classic or --ui=modern explicitly" as int, rt_itoa(environment) as int)
    end
    if environment == 0 do out end
    if rt_streq(environment, "classic" as int) do
        vir_free(environment)
        out
    end
    if rt_streq(environment, "modern" as int) do
        g_ui_mode = 1
        vir_free(environment)
        out
    end
    vircArgumentError("VIRC_UI requires classic or modern" as int, environment)
end.
