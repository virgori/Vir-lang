##
 * compiler/src/main/driver/config.vri — Compiler Driver: CompilerConfig entity, accessors and version metadata
 * VIRC-PLN-0008: extracted verbatim from compiler/src/main/driver.vri.
 ##

# ═══════════════════════════════════════════════════════
# Configuration
# ═══════════════════════════════════════════════════════

func vircVersionNumber():
    out "2026.1.1"
end.

func vircVersionMajor() -> int:
    out 2026
end.

func vircVersionMinor() -> int:
    out 1
end.

func vircVersionPatch() -> int:
    out 1
end.

func vircReleaseHighlights():
    out "Native LSP Daemon, IDE Semantic Engine & Strict CLI"
end.

entity CompilerConfig:
    input_path:     int;    # string pointer
    output_path:    int;    # string pointer
    target:         int;    # 0=ARM64, 1=x86_64, 2=WASM, 3=RISCV
    out_fmt:        int;    # 0=Mach-O, 1=ELF, 2=WASM, 3=PE
    verbose:        int;    # 0=quiet, 1=verbose
    emit_asm:       int;    # 0=binary, 1=assembly text (-S)
    target_spec:    TargetSpec
    optimization_level: int
    optimization_selector: int
    ui_mode: int
    sysroot_path: int
end.

func cfg_get_input_path(cfg: &CompilerConfig):
    out native_read_i64(cfg as i64, 0)
end.
func cfg_set_input_path(cfg: &CompilerConfig, val: int):
    native_write_i64(cfg as i64, 0, val)
end.

func cfg_get_output_path(cfg: &CompilerConfig):
    out native_read_i64(cfg as i64, 8)
end.
func cfg_set_output_path(cfg: &CompilerConfig, val: int):
    native_write_i64(cfg as i64, 8, val)
end.

func cfg_get_target(cfg: &CompilerConfig):
    out native_read_i64(cfg as i64, 16)
end.
func cfg_set_target(cfg: &CompilerConfig, val: int):
    native_write_i64(cfg as i64, 16, val)
end.

func cfg_get_out_fmt(cfg: &CompilerConfig):
    out native_read_i64(cfg as i64, 24)
end.
func cfg_set_out_fmt(cfg: &CompilerConfig, val: int):
    native_write_i64(cfg as i64, 24, val)
end.

func cfg_get_verbose(cfg: &CompilerConfig):
    out native_read_i64(cfg as i64, 32)
end.
func cfg_set_verbose(cfg: &CompilerConfig, val: int):
    native_write_i64(cfg as i64, 32, val)
end.

func cfg_get_emit_asm(cfg: &CompilerConfig):
    out native_read_i64(cfg as i64, 40)
end.
func cfg_set_emit_asm(cfg: &CompilerConfig, val: int):
    native_write_i64(cfg as i64, 40, val)
end.

func cfg_get_target_spec(cfg: &CompilerConfig):
    out native_read_i64(cfg as i64, 48) as TargetSpec
end.
func cfg_set_target_spec(cfg: &CompilerConfig, val: TargetSpec):
    native_write_i64(cfg as i64, 48, val as i64)
end.

func cfgOptimizationLevel(cfg: &CompilerConfig):
    out native_read_i64(cfg as i64, 56)
end.

func cfgSetOptimization(cfg: &CompilerConfig, level: int, selector: int):
    native_write_i64(cfg as i64, 56, level)
    native_write_i64(cfg as i64, 64, selector)
end.

func cfg_get_sysroot(cfg: &CompilerConfig):
    out native_read_i64(cfg as i64, 80)
end.

func cfg_set_sysroot(cfg: &CompilerConfig, val: int):
    native_write_i64(cfg as i64, 80, val)
end.
