##
 * compiler/src/main/driver/main_entry.vri — Compiler Driver: program entry point
 * VIRC-PLN-0008: extracted verbatim from compiler/src/main/driver.vri.
 ##

func main:
    vircResolveUi()
    let argc = arg_count()
    var base_idx = 0
    if argc > 0 do
        let exec_arg = get_arg(0)
        if exec_arg != 0 and cstr_ends_with_vri(exec_arg) == 0 do
            base_idx = 1
        end
    end

    var show_idx = -1
    var show_json = 0
    var si = base_idx
    when si < argc loop
        let arg = get_arg(si)
        if rt_streq(arg, "show" as int) do
            show_idx = si
        eif rt_streq(arg, "--json" as int) do
            show_json = 1
        end
        si = si + 1
    end

    if show_idx >= 0 do
        var entry = 0
        var code = 0
        var ai = base_idx
        when ai < argc loop
            let arg = get_arg(ai)
            if ai != show_idx and !rt_streq(arg, "--json" as int) and !rt_streq(arg, "--ui=classic" as int) and !rt_streq(arg, "--ui=modern" as int) and !rt_streq(arg, "--color=always" as int) and !rt_streq(arg, "--color=never" as int) and !rt_streq(arg, "--color=auto" as int) do
                if entry == 0 do
                    entry = arg
                eif code == 0 do
                    code = arg
                end
            end
            ai = ai + 1
        end
        if entry == 0 do
            if show_json == 1 do
                print_ln("{\"schemaVersion\":1,\"status\":\"invalid\",\"message\":\"missing entry file\",\"diagnostics\":[]}")
            else
                print_ln("virc: error: 'show' requires an entry file")
            end
            sys_exit(1)
            out 1
        end
        let exit_code = diagnosticStoreShow(entry, code, show_json)
        sys_exit(exit_code)
        out exit_code
    end

    if g_ui_mode == 0 do
        if g_diag_json == 0 do
            if should_print_banner() == 1 do virc_print_banner() end
        end
    end

    virc_timer_init()
    let cfg = parse_args()

    let result = virc_compile(cfg)
    cliSessionFinish(result)
    pass10SessionEmit(result)
    g_diagSessionActive = 0
    var artifact = 0
    if result == 0 do
        artifact = cfg_get_output_path(cfg) as int
    end
    diagnosticStoreFinish(pass10SessionSerialize(result), artifact)
    if result == 0 do
        virc_print_compile_time()
        cliUiBuildResult(0)
    end
    sys_exit(result)
    out result
end.
