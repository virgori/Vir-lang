export main, emit_macho_executable, emit_macho_with_entry, FuncLayout, expand_includes_text, expand_imports_text, text_ascii_sanitize, g_inc_base, g_inc_err, g_inc_main_file

export g_ideImportOrigins, g_ideEarlyDiagnostics, g_ideVirtualFiles, try_read_file, path_normalize_fat, text_find_import

func ideCaptureResolvedModule(name: int, parentPath: int, line: int, body: int):
    if g_ideFactsEnabled == 0 do out 0 end
    let entry = vir_alloc(48)
    native_write_i64(entry, 0, name)
    native_write_i64(entry, 8, g_inc_canonical_id)
    native_write_i64(entry, 16, g_inc_resolved_path)
    native_write_i64(entry, 24, parentPath)
    native_write_i64(entry, 32, line)
    var resolved = 0
    if body != 0 do resolved = 1 end
    native_write_i64(entry, 40, resolved)
    g_ideResolvedModules = vec_push_rt(g_ideResolvedModules, entry)
end.
export g_ideResolvedModules
