##
 * vir/compiler/lir_lower.vri — SSA Destruction & MIR to LIR Lowering
 * ====================================================================
 * Translates MIR functions to LIR functions.
 * Destroys SSA form by resolving Phi nodes into parallel Move instructions
 * in predecessor basic blocks.
 ##

include types
include vec_rt
include string_rt
include context
include mir
include lir

func lower_mir_opnd(m_opnd: MirOperand):
    if mir_opnd_type(m_opnd) == MirOperandType.VReg do
        out lir_opnd_vreg_int(mir_opnd_vreg_id(m_opnd))
    eif mir_opnd_type(m_opnd) == MirOperandType.Imm do
        out lir_opnd_imm(mir_opnd_imm_val(m_opnd))
    end
    out lir_opnd_none()
end.

func lower_mir_op(m_op: MirOp):
    if m_op == MirOp.Move do out LirOp.Mov end
    if m_op == MirOp.Load do out LirOp.Load end
    if m_op == MirOp.Store do out LirOp.Store end
    if m_op == MirOp.Add do out LirOp.Add end
    if m_op == MirOp.Sub do out LirOp.Sub end
    if m_op == MirOp.Mul do out LirOp.Mul end
    if m_op == MirOp.Div do out LirOp.Div end
    if m_op == MirOp.Mod do out LirOp.Rem end
    if m_op == MirOp.SetArg do out LirOp.SetArg end
    if m_op == MirOp.Call do out LirOp.Call end
    if m_op == MirOp.Return do out LirOp.Ret end
    if m_op == MirOp.Jump do out LirOp.Jmp end
    if m_op == MirOp.JumpIf or m_op == MirOp.JumpIfNot do out LirOp.JmpCond end
    if m_op == MirOp.CmpEq or m_op == MirOp.CmpNe or m_op == MirOp.CmpGt or m_op == MirOp.CmpLt or m_op == MirOp.CmpGe or m_op == MirOp.CmpLe do
        out LirOp.Cmp
    end
    if m_op == MirOp.Intrinsic do out LirOp.Intrinsic end
    if m_op == MirOp.And do out LirOp.And end
    if m_op == MirOp.Or do out LirOp.Or end
    if m_op == MirOp.Xor do out LirOp.Xor end
    if m_op == MirOp.Shl do out LirOp.Shl end
    if m_op == MirOp.Shr do out LirOp.Shr end
    if m_op == MirOp.Not do out LirOp.Not end
    if m_op == MirOp.Pow do out LirOp.Pow end
    if m_op == MirOp.MatMul do out LirOp.MatMul end
    if m_op == MirOp.Fma do out LirOp.Fma end
    if m_op == MirOp.VLoad do out LirOp.VLoad end
    if m_op == MirOp.VStore do out LirOp.VStore end
    if m_op == MirOp.VAdd do out LirOp.VAdd end
    if m_op == MirOp.VSub do out LirOp.VSub end
    if m_op == MirOp.VMul do out LirOp.VMul end
    if m_op == MirOp.VFma do out LirOp.VFma end
    if m_op == MirOp.Splat do out LirOp.Splat end
    if m_op == MirOp.Shuffle do out LirOp.Shuffle end
    out LirOp.Nop
end.

func lower_mir_aux(m_ins: MirInstr):
    op = mir_instr_op(m_ins)
    if op == MirOp.CmpEq do out LIR_CMP_EQ end
    if op == MirOp.CmpNe do out LIR_CMP_NE end
    if op == MirOp.CmpGt do out LIR_CMP_GT end
    if op == MirOp.CmpLt do out LIR_CMP_LT end
    if op == MirOp.CmpGe do out LIR_CMP_GE end
    if op == MirOp.CmpLe do out LIR_CMP_LE end
    if op == MirOp.JumpIf do out LIR_JMP_IF end
    if op == MirOp.JumpIfNot do out LIR_JMP_IFNOT end
    if op == MirOp.Intrinsic do out mir_opnd_imm_val(mir_instr_src2(m_ins)) end
    if op == MirOp.Call do
        if mir_opnd_type(mir_instr_src2(m_ins)) == MirOperandType.Imm do
            out mir_opnd_imm_val(mir_instr_src2(m_ins))
        end
        out 0 - 1
    end
    if op == MirOp.SetArg do out mir_opnd_imm_val(mir_instr_src1(m_ins)) end
    if op == MirOp.MatMul or op == MirOp.Fma or op == MirOp.Load or op == MirOp.Store or op == MirOp.VLoad or op == MirOp.VStore or op == MirOp.VAdd or op == MirOp.VSub or op == MirOp.VMul or op == MirOp.VFma or op == MirOp.Splat or op == MirOp.Shuffle do out mir_instr_aux(m_ins) end
    out 0
end.

func lower_mir_type(m_typ: i64):
    if m_typ == (MirType.F64 as i64) do out LirType.F64 as i64 end
    if m_typ == (MirType.F32 as i64) do out LirType.F32 as i64 end
    if m_typ == (MirType.Int8 as i64) do out LirType.Int8 as i64 end
    if m_typ == (MirType.Int16 as i64) do out LirType.Int16 as i64 end
    if m_typ == (MirType.Int32 as i64) do out LirType.Int32 as i64 end
    if m_typ == (MirType.Ptr as i64) do out LirType.Ptr as i64 end
    if m_typ == (MirType.Vector as i64) do out LirType.Vector as i64 end
    out LirType.Int64 as i64
end.

func insert_before_terminator(instrs: i64, ins: LirInstr):
    n = vec_len_rt(instrs)
    if n == 0 do
        out vec_push_rt(instrs, ins)
    end
    last_ins = vec_get_rt(instrs, n - 1)
    last_op = lir_instr_op(last_ins)
    if last_op == LirOp.Jmp as i64 or last_op == LirOp.JmpCond as i64 or last_op == LirOp.Ret as i64 do
        vec_set_rt(instrs, n - 1, ins)
        out vec_push_rt(instrs, last_ins)
    end
    out vec_push_rt(instrs, ins)
end.

func lir_lower_func(m_func: MirFunc, m_blocks: i64):
    blocks = vec_new_rt()
    n_blocks = vec_len_rt(m_blocks)

    # 1. Create LIR blocks and lower instructions
    var i = 0
    when i < n_blocks loop
        m_b = vec_get_rt(m_blocks, i)
        instrs = vec_new_rt()

        m_instrs = mir_block_head(m_b)
        if m_instrs >= 0 do
            n_instrs = vec_len_rt(m_instrs)
            var j = 0
            when j < n_instrs loop
                m_ins = vec_get_rt(m_instrs, j)
                m_op = mir_instr_op(m_ins)
                l_op = lower_mir_op(m_op)
                m_typ = mir_instr_type(m_ins)
                l_typ = lower_mir_type(m_typ)
                var l_dst = lower_mir_opnd(mir_instr_dst(m_ins)) as i64
                if l_op == (LirOp.Nop as i64) or l_op == (LirOp.Jmp as i64) or l_op == (LirOp.JmpCond as i64) or l_op == (LirOp.Ret as i64) or l_op == (LirOp.Push as i64) or l_op == (LirOp.Store as i64) or l_op == (LirOp.SetArg as i64) or l_op == (LirOp.VStore as i64) do
                    l_dst = lir_opnd_none() as i64
                end
                if l_op == (LirOp.Intrinsic as i64) do
                    aux_kind = lower_mir_aux(m_ins)
                    if aux_kind == MIR_INTR_NOP_MARKER or aux_kind == MIR_INTR_DECL or aux_kind == MIR_INTR_QUIET or aux_kind == MIR_INTR_CHECK_CPU or aux_kind == MIR_INTR_PATCH_POINT or aux_kind == MIR_INTR_PRECOMP or aux_kind == MIR_INTR_EXPOSE or aux_kind == MIR_INTR_ASYNC or aux_kind == MIR_INTR_ATOMIC_VAR or aux_kind == MIR_INTR_TIMEOUT or aux_kind == MIR_INTR_ISOLATE or aux_kind == MIR_INTR_PTR or aux_kind == MIR_INTR_AWAIT_PASS or aux_kind == MIR_INTR_ENSURE or aux_kind == MIR_INTR_REVERT or aux_kind == MIR_INTR_ENUM or aux_kind == MIR_INTR_ERROR or aux_kind == MIR_INTR_EXIST or aux_kind == MIR_INTR_REACTIVE or aux_kind == MIR_INTR_MORPH or aux_kind == MIR_INTR_TRY or aux_kind == MIR_INTR_RESUME or aux_kind == MIR_INTR_EMIT or aux_kind == MIR_INTR_INDEX_STORE or aux_kind == MIR_INTR_FIELD_STORE or aux_kind == MIR_INTR_THROW or aux_kind == MIR_INTR_PRINT or aux_kind == MIR_INTR_PRINT_STR or aux_kind == MIR_INTR_PRINT_FLOAT or aux_kind == MIR_INTR_PRINT_BOOL or aux_kind == MIR_INTR_TRAIN or aux_kind == MIR_INTR_INFER or aux_kind == MIR_MEM_RESET or aux_kind == MIR_MEM_DROP do
                        l_dst = lir_opnd_none() as i64
                    end
                    if aux_kind == MIR_INTR_ARENA or aux_kind == MIR_MEM_MARK do
                        m_s1 = mir_instr_src1(m_ins)
                        if mir_opnd_type(m_s1) != MirOperandType.None do
                            l_dst = lir_opnd_none() as i64
                        end
                    end
                    if aux_kind == MIR_INTR_BUILTIN do
                        m_s1 = mir_instr_src1(m_ins)
                        if mir_opnd_type(m_s1) == MirOperandType.Imm do
                            bid = mir_opnd_imm_val(m_s1)
                            if bid == 6 or bid == 8 or bid == 47 or bid == 32 or bid == 51 or bid == 18 do
                                l_dst = lir_opnd_none() as i64
                            end
                        end
                    end
                end
                l_ins = lir_instr_new(
                    l_op as i64,
                    l_typ,
                    l_dst,
                    lower_mir_opnd(mir_instr_src1(m_ins)) as i64,
                    lower_mir_opnd(mir_instr_src2(m_ins)) as i64,
                    lower_mir_aux(m_ins)
                )
                instrs = vec_push_rt(instrs, l_ins)
                j = j + 1
            end
        end

        l_b = lir_block_new(
            mir_block_id(m_b),
            instrs
        )
        blocks = vec_push_rt(blocks, l_b)
        i = i + 1
    end

    # 2. SSA Destruction: For each Phi node in m_b, insert Mov in predecessor blocks BEFORE terminator
    i = 0
    when i < n_blocks loop
        m_b = vec_get_rt(m_blocks, i)
        phis = mir_block_phis(m_b)
        if phis >= 0 do
            n_phis = vec_len_rt(phis)
            var p_idx = 0
            when p_idx < n_phis loop
                phi = vec_get_rt(phis, p_idx)
                inc_blocks = mir_phi_incoming_blocks(phi)
                inc_values = mir_phi_incoming_values(phi)
                n_incoming = vec_len_rt(inc_blocks)
                var k = 0
                when k < n_incoming loop
                    pred_id = vec_get_rt(inc_blocks, k)
                    val = vec_get_rt(inc_values, k)

                    if mir_opnd_type(val) != MirOperandType.None do
                        let is_phi_self_move = (mir_opnd_type(val) == MirOperandType.VReg) and (mir_opnd_vreg_id(val) == mir_phi_dst(phi))
                        if not is_phi_self_move do
                            pred_lb = vec_get_rt(blocks, pred_id)
                            mov_ins = lir_instr_new(
                                LirOp.Mov as i64,
                                LirType.Int64 as i64,
                                lir_opnd_vreg_int(mir_phi_dst(phi)) as i64,
                                lower_mir_opnd(val) as i64,
                                lir_opnd_none() as i64,
                                0
                            )
                            p_instrs = insert_before_terminator(lir_block_instrs(pred_lb), mov_ins)
                            pred_lb_new = lir_block_new(
                                lir_block_id(pred_lb),
                                p_instrs
                            )
                            vec_set_rt(blocks, pred_id, pred_lb_new)
                        end
                    end
                    k = k + 1
                end
                p_idx = p_idx + 1
            end
        end
        i = i + 1
    end

    out lir_func_new(
        mir_func_id(m_func),
        mir_func_name(m_func),
        blocks,
        0,
        mir_func_strings(m_func)
    )
end.

func lir_lower_program(mir_funcs: i64):
    lir_funcs = vec_new_rt()
    n_funcs = vec_len_rt(mir_funcs)
    var i = 0
    when i < n_funcs loop
        mf = vec_get_rt(mir_funcs, i)
        lf = lir_lower_func(mf, mir_func_blocks(mf))
        lir_funcs = vec_push_rt(lir_funcs, lf)
        i = i + 1
    end
    out lir_funcs
end.

export lir_lower_func, lir_lower_program
