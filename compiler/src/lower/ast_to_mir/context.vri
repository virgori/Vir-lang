##
 * compiler/src/lower/ast_to_mir/context.vri — Lowering Context, Globals & Maps
 * =============================================================================
 ##

include types
include vec_rt
include string_rt
include parser
include ffi_imports
include type_table
include mir
import print_str, print_ln, g_disable_specialization from compiler.context

var g_ast_lower_verbose: int = 0
var g_lower_expr_result_opnd: i64 = 0
var g_ast_to_mir_cur_module: string = ""

func is_user_module(name: string) -> int:
    let s = name as int
    if s == 0 do out 0 end
    let slen = native_read_i64(s, 8) as int
    if slen == 0 do out 0 end
    let cstr_ptr = native_read_i64(s, 0) as int
    if cstr_ptr == 0 do out 0 end
    if slen == 4 and native_read_u8(cstr_ptr, 0) == 114 and native_read_u8(cstr_ptr, 1) == 111 and native_read_u8(cstr_ptr, 2) == 111 and native_read_u8(cstr_ptr, 3) == 116 do
        out 0
    end
    if slen >= 4 and native_read_u8(cstr_ptr, 0) == 118 and native_read_u8(cstr_ptr, 1) == 105 and native_read_u8(cstr_ptr, 2) == 114 and native_read_u8(cstr_ptr, 3) == 46 do
        out 0
    end
    out 1
end.

func expr_result(b: MirBuilder, opnd: &MirOperand):
	g_lower_expr_result_opnd = opnd as i64
	out b
end.

func set_ast_lower_verbose(mode: int):
    g_ast_lower_verbose = mode
end.

func mir_op_from_optype(op: OpType):
	if op == OpType.Add do out MirOp.Add as i64 end
	if op == OpType.Sub do out MirOp.Sub as i64 end
	if op == OpType.Mul do out MirOp.Mul as i64 end
	if op == OpType.Div do out MirOp.Div as i64 end
	if op == OpType.ModOp do out MirOp.Mod as i64 end
	if op == OpType.Eq do out MirOp.CmpEq as i64 end
	if op == OpType.Ne do out MirOp.CmpNe as i64 end
	if op == OpType.Gt do out MirOp.CmpGt as i64 end
	if op == OpType.Lt do out MirOp.CmpLt as i64 end
	if op == OpType.Ge do out MirOp.CmpGe as i64 end
	if op == OpType.Le do out MirOp.CmpLe as i64 end
	if op == OpType.SafeEq do out MirOp.CmpEq as i64 end
	if op == OpType.SafeNe do out MirOp.CmpNe as i64 end
	if op == OpType.AndOp do out MirOp.And as i64 end
	if op == OpType.OrOp do out MirOp.Or as i64 end
	if op == OpType.XorOp do out MirOp.Xor as i64 end
	if op == OpType.ShlOp do out MirOp.Shl as i64 end
	if op == OpType.ShrOp do out MirOp.Shr as i64 end
	if op == OpType.PowOp do out MirOp.Pow as i64 end
	if op == OpType.MatMulOp do out MirOp.MatMul as i64 end
	if op == OpType.FmaOp do out MirOp.Fma as i64 end
	if op == OpType.Land do out 0 - 2 end
	if op == OpType.Lor do out 0 - 3 end
	if op == OpType.PatternOp do out 0 - 4 end
	out 0 - 1
end.

const MIR_VAR_BUCKETS: i64 = 256

entity VarMap:
	name: string,
	vreg: i64
end.

func var_map_new(name: string, vreg: i64):
    p = alloc(16)
    native_write_i64(p, 0, name as i64)
    native_write_i64(p, 8, vreg)
    out p as VarMap
end.

# Typed accessors — bare vec_get_rt results have no record type.
func var_map_name(vm: VarMap):
	out vm.name
end.
func var_map_vreg(vm: VarMap):
	out vm.vreg
end.


entity LoopTarget:
	break_block: i64,
	continue_block: i64
end.

func loop_target_new(break_block: i64, continue_block: i64):
    p = alloc(24)
    native_write_i64(p, 0, break_block)
    native_write_i64(p, 8, continue_block)
    var cur_depth = 0
    if g_arena_mark_stack != 0 do
        cur_depth = vec_len_rt(g_arena_mark_stack)
    end
    native_write_i64(p, 16, cur_depth)
    out p
end.

func loop_target_break_block(lt: LoopTarget):
    out native_read_i64(lt as i64, 0)
end.

func loop_target_continue_block(lt: LoopTarget):
    out native_read_i64(lt as i64, 8)
end.

func loop_target_arena_depth(lt: LoopTarget):
    if (lt as i64) == 0 do out 0 end
    out native_read_i64(lt as i64, 16)
end.

entity MirBuilder:
	current_block: i64,
	vreg_counter: i64,
	loop_stack: i64, # Vec<LoopTarget>
	func_box: i64, # Vec<MirFunc> length 1 — locals live on MirFunc.var_buckets
	cur_func_ptr: i64,
	cur_block_ptr: i64
end.

var g_prog_ast: AstNode = 0
var g_entity_names: i64 = 0
var g_import_aliases: i64 = 0
var g_import_targets: i64 = 0
var g_field_names: i64 = 0
var g_field_indices: i64 = 0
var g_register_field_names: i64 = 0
var g_register_field_starts: i64 = 0
var g_register_field_widths: i64 = 0
var g_builtin_lookup_buckets: i64 = 0
var g_mir_scratch_args: i64 = 0
var g_mir_scratch_top: i64 = 0

# Active `try` handler context (for `throw` inside a try body). These are saved
# and restored around each TryStmt lowering so nested try blocks work.
var g_try_revert_block: i64 = 0 - 1
var g_try_retry_block: i64 = 0 - 1
var g_try_err_vreg: i64 = 0 - 1
var g_try_parent_err_vreg: i64 = 0 - 1
var g_func_return_block: i64 = 0 - 1
var g_func_normal_ensure_block: i64 = 0 - 1
var g_func_ret_vreg: i64 = 0 - 1
var g_in_func_cleanup: i64 = 0

# Stack of active arena mark vregs for break/continue restore.
# Each entry is the vreg representing the arena watermark for that arena block.
var g_arena_mark_stack: i64 = 0   # Vec<i64> — created lazily
var g_arena_escaped_stack: i64 = 0 # Vec<i64> — created lazily
var g_try_arena_depth: i64 = 0

var g_entity_hash: i64 = 0
var g_import_hash: i64 = 0
var g_field_hash: i64 = 0
var g_regfield_hash: i64 = 0
var g_const_names: i64 = 0
var g_const_values: i64 = 0
var g_const_hash: i64 = 0
# Canonical enum layout registry.  Every tagged enum is represented by an
# 8-byte discriminant slot followed by 8-byte payload slots.  The logical tag
# is u32; bytes 4..7 are ABI padding, keeping payload offset/alignment at 8.
const ENUM_TAG_SIZE: i64 = 4
const ENUM_TAG_SLOT_SIZE: i64 = 8
const ENUM_PAYLOAD_ALIGN: i64 = 8
const ENUM_PAYLOAD_SLOT_SIZE: i64 = 8
var g_enum_names: i64 = 0
var g_enum_nodes: i64 = 0
var g_enum_is_tagged: i64 = 0
var g_enum_sizes: i64 = 0
var g_enum_hash: i64 = 0
var g_enum_variant_keys: i64 = 0
var g_enum_variant_names: i64 = 0
var g_enum_variant_enum_indices: i64 = 0
var g_enum_variant_tags: i64 = 0
var g_enum_variant_arities: i64 = 0
var g_enum_variant_hash: i64 = 0
var g_enum_variant_nodes: i64 = 0
var g_lower_global_names: i64 = 0
var g_lower_global_values: i64 = 0
var g_lower_global_hash: i64 = 0
var g_lower_global_init_nodes: i64 = 0

var g_scoped_field_hash: i64 = 0
var g_scoped_field_names: i64 = 0
var g_scoped_field_indices: i64 = 0
var g_scoped_field_types: i64 = 0
var g_scoped_method_hash: i64 = 0
var g_scoped_method_names: i64 = 0
var g_scoped_method_nodes: i64 = 0
var g_scope_stack: i64 = 0
var g_current_func_buckets: i64 = 0

var g_func_ast_names: i64 = 0
var g_func_ast_nodes: i64 = 0
var g_func_ast_hash: i64 = 0


var g_func_ref_param_names: i64 = 0
var g_func_ref_param_vregs: i64 = 0
var g_func_ref_param_modes: i64 = 0
var g_func_ref_param_hash: i64 = 0

var g_entity_is_packed: i64 = 0
var g_entity_sizes: i64 = 0
var g_entity_nodes: i64 = 0
var g_scoped_field_offsets: i64 = 0
var g_scoped_field_sizes: i64 = 0
var g_scoped_field_signed: i64 = 0
var g_scoped_field_is_nested: i64 = 0

var g_var_type_hash: i64 = 0
var g_var_type_names: i64 = 0
var g_var_type_values: i64 = 0
var g_dict_var_hash: i64 = 0
var g_dict_var_names: i64 = 0

var g_current_entity_name: i64 = 0

func set_var_type(var_name: &string, type_name: &string):
    if g_var_type_hash != 0 and var_name != 0 and type_name != 0 do
        idx = hash_table_lookup(g_var_type_hash, g_var_type_names, var_name)
        if idx >= 0 do
            vec_set_rt(g_var_type_values, idx, type_name as i64)
        else
            idx = vec_len_rt(g_var_type_names)
            g_var_type_names = vec_push_rt(g_var_type_names, var_name as i64)
            g_var_type_values = vec_push_rt(g_var_type_values, type_name as i64)
            hash_table_insert(g_var_type_hash, g_var_type_names, var_name, idx)
        end
    end
end.

func get_var_type(var_name: &string):
    if g_var_type_hash != 0 and var_name != 0 do
        idx = hash_table_lookup(g_var_type_hash, g_var_type_names, var_name)
        if idx >= 0 do
            out vec_get_rt(g_var_type_values, idx) as string
        end
    end
    out 0
end.

func mark_dict_var(var_name: &string):
    if g_dict_var_hash != 0 and var_name != 0 do
        if hash_table_lookup(g_dict_var_hash, g_dict_var_names, var_name) < 0 do
            idx = vec_len_rt(g_dict_var_names)
            g_dict_var_names = vec_push_rt(g_dict_var_names, var_name as i64)
            hash_table_insert(g_dict_var_hash, g_dict_var_names, var_name, idx)
        end
    end
end.

func is_known_dict_var(var_name: &string):
    if g_dict_var_hash != 0 and var_name != 0 do
        if hash_table_lookup(g_dict_var_hash, g_dict_var_names, var_name) >= 0 do out 1 end
    end
    out 0
end.


func name_hash_256(name: &string):
    n = fat_str_len(name as int) as i64
    h = n * 17
    var i = 0
    when i < n loop
        h = h * 131 + (fat_str_byte_at(name as int, i) as i64)
        i = i + 1
    end
    if h < 0 do h = 0 - h end
    out h mod 256
end.

func hash_table_new():
    tab = vec_new_rt()
    var i = 0
    when i < 256 loop
        tab = vec_push_rt(tab, 0)
        i = i + 1
    end
    out tab
end.

func hash_table_lookup(hash_tab: i64, names: i64, name: &string):
    if hash_tab == 0 or names == 0 do out 0 - 1 end
    bid = name_hash_256(name)
    bucket = vec_get_rt(hash_tab, bid)
    if bucket == 0 do out 0 - 1 end
    n = vec_len_rt(bucket)
    var i = 0
    when i < n loop
        idx = vec_get_rt(bucket, i)
        if fat_str_eq(vec_get_rt(names, idx) as string, name as string) == 1 do
            out idx
        end
        i = i + 1
    end
    out 0 - 1
end.

func hash_table_insert(hash_tab: i64, names: i64, name: &string, idx: i64):
    if hash_tab == 0 do out 0 end
    bid = name_hash_256(name)
    bucket = vec_get_rt(hash_tab, bid)
    if bucket == 0 do
        bucket = vec_new_rt()
    end
    bucket = vec_push_rt(bucket, idx)
    vec_set_rt(hash_tab, bid, bucket)
    out 0
end.

func lookup_cached_name(names: i64, name: &string):
    if names == 0 do out 0 - 1 end
    if names == g_field_names and g_field_hash != 0 do
        out hash_table_lookup(g_field_hash, names, name)
    end
    if names == g_scoped_field_names and g_scoped_field_hash != 0 do
        out hash_table_lookup(g_scoped_field_hash, names, name)
    end
    if names == g_entity_names and g_entity_hash != 0 do
        out hash_table_lookup(g_entity_hash, names, name)
    end
    if names == g_import_aliases and g_import_hash != 0 do
        out hash_table_lookup(g_import_hash, names, name)
    end
    if names == g_register_field_names and g_regfield_hash != 0 do
        out hash_table_lookup(g_regfield_hash, names, name)
    end
    n = vec_len_rt(names)
    var i = 0
    when i < n loop
        if fat_str_eq(vec_get_rt(names, i) as string, name as string) == 1 do out i end
        i = i + 1
    end
    out 0 - 1
end.


func is_packed_entity(type_name: &string):
    if g_entity_hash != 0 and type_name != 0 and fat_str_len(type_name as string) > 0 do
        var idx = hash_table_lookup(g_entity_hash, g_entity_names, type_name)
        if idx >= 0 and idx < vec_len_rt(g_entity_is_packed) do
            out vec_get_rt(g_entity_is_packed, idx) == 1
        end
    end
    out false
end.

func is_signed_type(t: string):
    if t == 0 or fat_str_len(t) == 0 do out 0 end
    if fat_cstr_eq(t, "i8") == 1 or fat_cstr_eq(t, "i16") == 1 or fat_cstr_eq(t, "i32") == 1 or fat_cstr_eq(t, "i64") == 1 do
        out 1
    end
    out 0
end.

func get_type_byte_size(type_name: string):
    if type_name == 0 or fat_str_len(type_name) == 0 do out 8 end
    if fat_cstr_eq(type_name, "u8") == 1 or fat_cstr_eq(type_name, "i8") == 1 or fat_cstr_eq(type_name, "bool") == 1 do
        out 1
    end
    if fat_cstr_eq(type_name, "u16") == 1 or fat_cstr_eq(type_name, "i16") == 1 do
        out 2
    end
    if fat_cstr_eq(type_name, "u32") == 1 or fat_cstr_eq(type_name, "i32") == 1 do
        out 4
    end
    if fat_cstr_eq(type_name, "u64") == 1 or fat_cstr_eq(type_name, "i64") == 1 or fat_cstr_eq(type_name, "int") == 1 or fat_cstr_eq(type_name, "float") == 1 or fat_cstr_eq(type_name, "ptr") == 1 or fat_cstr_eq(type_name, "usize") == 1 or fat_cstr_eq(type_name, "isize") == 1 do
        out 8
    end
    if g_entity_hash != 0 do
        var idx = hash_table_lookup(g_entity_hash, g_entity_names, type_name)
        if idx >= 0 and idx < vec_len_rt(g_entity_sizes) do
            var sz = vec_get_rt(g_entity_sizes, idx)
            if sz > 0 do out sz end
        end
    end
    out 8
end.


func eval_const_expr(node: &AstNode):
    if node == 0 do out 0 end
    nt = ast_node_type_of(node)
    if nt == AstType.SizeofExpr do
        out get_type_byte_size(ast_node_name(node))
    end
    if nt == AstType.LiteralInt do
        out ast_node_int_val(node)
    end
    if nt == AstType.PrecompBlock do
        out ast_node_int_val(node)
    end
    if nt == AstType.LiteralFloat do
        # Float constants travel through the integer MIR immediate lane as their
        # IEEE-754 payload. `int_val` is a distinct AST field and is zero for a
        # float token, so using it silently rewrites every float const to 0.0.
        out native_read_i64(node as i64, 48)
    end
    if nt == AstType.UnaryMinus do
        if ast_node_child_count(node) > 0 do
            out 0 - eval_const_expr(ast_node_child(node, 0))
            let c = ast_node_child(node, 0)
            if ast_node_type_of(c) == AstType.LiteralFloat do
                out eval_const_expr(c) xor (1 shl 63)
            end
            out 0 - eval_const_expr(c)
        end
        out 0
    end
    if nt == AstType.Identifier do
        cname = ast_node_name(node)
        if fat_cstr_eq(cname, "true") == 1 do out 1 end
        if fat_cstr_eq(cname, "false") == 1 do out 0 end
        if fat_cstr_eq(cname, "null") == 1 do out 0 end
        if fat_cstr_eq(cname, "void") == 1 do out 0 end
        if g_const_hash > 0 do
            c_idx = hash_table_lookup(g_const_hash, g_const_names, cname)
            if c_idx >= 0 do
                out vec_get_rt(g_const_values, c_idx)
            end
        end
        out 0
    end
    if nt == AstType.FieldAccess do
        if ast_node_child_count(node) > 0 do
            base = ast_node_child(node, 0)
            if ast_node_type_of(base) == AstType.Identifier do
                key = fat_str_concat(fat_str_concat(ast_node_name(base), fat_str_new(".")), ast_node_name(node))
                if g_const_hash > 0 do
                    c_idx = hash_table_lookup(g_const_hash, g_const_names, key)
                    if c_idx >= 0 do
                        out vec_get_rt(g_const_values, c_idx)
                    end
                end
            end
        end
        out 0
    end
    if nt == AstType.EnumAccess do
        key = fat_str_concat(fat_str_concat(ast_node_name(node), fat_str_new(".")), ast_node_name2(node))
        if g_const_hash > 0 do
            c_idx = hash_table_lookup(g_const_hash, g_const_names, key)
            if c_idx >= 0 do
                out vec_get_rt(g_const_values, c_idx)
            end
        end
        out 0
    end
    if nt == AstType.BinOp or nt == AstType.Compare do
        if ast_node_child_count(node) >= 2 do
            lval = eval_const_expr(ast_node_child(node, 0))
            rval = eval_const_expr(ast_node_child(node, 1))
            op = ast_node_op_of(node)
            if op == OpType.Add do out lval + rval end
            if op == OpType.Sub do out lval - rval end
            if op == OpType.Mul do out lval * rval end
            if op == OpType.Div do
                if rval != 0 do out lval / rval end
                out 0
            end
            if op == OpType.ModOp do
                if rval != 0 do out lval mod rval end
                out 0
            end
            if op == OpType.OrOp or op == OpType.Lor do out lval or rval end
            if op == OpType.AndOp or op == OpType.Land do out lval and rval end
            if op == OpType.XorOp do out lval xor rval end
            if op == OpType.ShlOp do out lval shl rval end
            if op == OpType.ShrOp do out lval shr rval end
        end
        out 0
    end
    out 0
end.


func set_global_prog_ast(ast: &AstNode):
    g_entity_names = vec_new_rt()
    g_import_aliases = vec_new_rt()
    g_import_targets = vec_new_rt()
    g_field_names = vec_new_rt()
    g_field_indices = vec_new_rt()
    g_register_field_names = vec_new_rt()
    g_register_field_starts = vec_new_rt()
    g_register_field_widths = vec_new_rt()

    g_entity_hash = hash_table_new()
    g_import_hash = hash_table_new()
    g_field_hash = hash_table_new()
    g_regfield_hash = hash_table_new()

    g_const_names = vec_new_rt()
    g_const_values = vec_new_rt()
    g_const_hash = hash_table_new()

    g_enum_names = vec_new_rt()
    g_enum_nodes = vec_new_rt()
    g_enum_is_tagged = vec_new_rt()
    g_enum_sizes = vec_new_rt()
    g_enum_hash = hash_table_new()
    g_enum_variant_keys = vec_new_rt()
    g_enum_variant_names = vec_new_rt()
    g_enum_variant_enum_indices = vec_new_rt()
    g_enum_variant_tags = vec_new_rt()
    g_enum_variant_arities = vec_new_rt()
    g_enum_variant_hash = hash_table_new()
    g_enum_variant_nodes = vec_new_rt()

    g_scoped_field_names = vec_new_rt()
    g_scoped_field_indices = vec_new_rt()
    g_scoped_field_types = vec_new_rt()
    g_scoped_field_offsets = vec_new_rt()
    g_scoped_field_sizes = vec_new_rt()
    g_scoped_field_signed = vec_new_rt()
    g_scoped_field_is_nested = vec_new_rt()
    g_scoped_field_hash = hash_table_new()
    g_scoped_method_names = vec_new_rt()
    g_scoped_method_nodes = vec_new_rt()
    g_scoped_method_hash = hash_table_new()

    g_func_ast_names = vec_new_rt()
    g_func_ast_nodes = vec_new_rt()
    g_func_ast_hash = hash_table_new()

    g_entity_is_packed = vec_new_rt()
    g_entity_sizes = vec_new_rt()
    g_entity_nodes = vec_new_rt()

    g_var_type_names = vec_new_rt()
    g_var_type_values = vec_new_rt()
    g_var_type_hash = hash_table_new()
    g_dict_var_names = vec_new_rt()
    g_dict_var_hash = hash_table_new()

    g_current_entity_name = 0

    # Native code needs real cross-function storage for top-level `var`s.
    # Assign each declaration a stable heap-header slot before lowering funcs.
    g_lower_global_names = vec_new_rt()
    g_lower_global_values = vec_new_rt()
    g_lower_global_hash = hash_table_new()
    g_lower_global_init_nodes = vec_new_rt()

    var cur_module = fat_str_new("")
    n = ast_node_child_count(ast)
    var i = 0
    when i < n loop
        child = ast_node_child(ast, i)
        child_type = ast_node_type_of(child)
        if child_type == AstType.ModuleStmt do
            if fat_str_len(ast_node_name(child)) > 0 do
                cur_module = ast_node_name(child)
            end
        end
        if child_type == AstType.FuncDef do
            fn_name = ast_node_name(child)
            var canonical_name = fn_name
            if is_user_module(cur_module) == 1 and fat_cstr_eq(fn_name, "main") == 0 do
                canonical_name = fat_str_concat(fat_str_concat(cur_module, fat_str_new(".")), fn_name)
            end
            if hash_table_lookup(g_func_ast_hash, g_func_ast_names, canonical_name) < 0 do
                fn_idx = vec_len_rt(g_func_ast_names)
                g_func_ast_names = vec_push_rt(g_func_ast_names, canonical_name as i64)
                g_func_ast_nodes = vec_push_rt(g_func_ast_nodes, child as i64)
                hash_table_insert(g_func_ast_hash, g_func_ast_names, canonical_name, fn_idx)
            end
            if is_user_module(cur_module) == 0 and hash_table_lookup(g_func_ast_hash, g_func_ast_names, fn_name) < 0 do
                fn_idx = vec_len_rt(g_func_ast_names)
                g_func_ast_names = vec_push_rt(g_func_ast_names, fn_name as i64)
                g_func_ast_nodes = vec_push_rt(g_func_ast_nodes, child as i64)
                hash_table_insert(g_func_ast_hash, g_func_ast_names, fn_name, fn_idx)
            end
        end
        if child_type == AstType.ImportStmt do
            child_count = ast_node_child_count(child)
            var j = 0
            when j < child_count loop
                sym = ast_node_child(child, j)
                alias = ast_node_name2(sym)
                target = ast_node_name(sym)
                if fat_str_len(alias) == 0 do
                    alias = target
                end
                if hash_table_lookup(g_import_hash, g_import_aliases, alias) < 0 do
                    idx = vec_len_rt(g_import_aliases)
                    g_import_aliases = vec_push_rt(g_import_aliases, alias as i64)
                    g_import_targets = vec_push_rt(g_import_targets, target as i64)
                    hash_table_insert(g_import_hash, g_import_aliases, alias, idx)
                end
                j = j + 1
            end
        end
        if child_type == AstType.EnumDef do
            enum_name = ast_node_name(child)
            var vcount = ast_node_child_count(child)
            enum_idx = hash_table_lookup(g_enum_hash, g_enum_names, enum_name)
            if enum_idx < 0 do
                enum_idx = vec_len_rt(g_enum_names)
                max_payloads = 0
                var scan_i = 0
                when scan_i < vcount loop
                    scan_variant = ast_node_child(child, scan_i)
                    scan_arity = ast_node_child_count(scan_variant)
                    if scan_arity > max_payloads do max_payloads = scan_arity end
                    scan_i = scan_i + 1
                end
                tagged = 0
                layout_size = ENUM_TAG_SLOT_SIZE
                if max_payloads > 0 do
                    tagged = 1
                    layout_size = ENUM_TAG_SLOT_SIZE + max_payloads * ENUM_PAYLOAD_SLOT_SIZE
                end
                g_enum_names = vec_push_rt(g_enum_names, enum_name as i64)
                g_enum_nodes = vec_push_rt(g_enum_nodes, child as i64)
                g_enum_is_tagged = vec_push_rt(g_enum_is_tagged, tagged)
                g_enum_sizes = vec_push_rt(g_enum_sizes, layout_size)
                hash_table_insert(g_enum_hash, g_enum_names, enum_name, enum_idx)
            end
            var vi = 0
            when vi < vcount loop
                vnode = ast_node_child(child, vi)
                vname = ast_node_name(vnode)
                vval = ast_node_int_val(vnode)
                dot_str = fat_str_new(".")
                key = fat_str_concat(fat_str_concat(enum_name, dot_str), vname)
                if hash_table_lookup(g_enum_variant_hash, g_enum_variant_keys, key) < 0 do
                    variant_idx = vec_len_rt(g_enum_variant_keys)
                    g_enum_variant_keys = vec_push_rt(g_enum_variant_keys, key as i64)
                    g_enum_variant_names = vec_push_rt(g_enum_variant_names, vname as i64)
                    g_enum_variant_enum_indices = vec_push_rt(g_enum_variant_enum_indices, enum_idx)
                    g_enum_variant_tags = vec_push_rt(g_enum_variant_tags, vval)
                    g_enum_variant_arities = vec_push_rt(g_enum_variant_arities, ast_node_child_count(vnode))
                    g_enum_variant_nodes = vec_push_rt(g_enum_variant_nodes, vnode as i64)
                    hash_table_insert(g_enum_variant_hash, g_enum_variant_keys, key, variant_idx)
                end
                if hash_table_lookup(g_const_hash, g_const_names, key) < 0 do
                    idx = vec_len_rt(g_const_names)
                    g_const_names = vec_push_rt(g_const_names, key as i64)
                    g_const_values = vec_push_rt(g_const_values, vval)
                    hash_table_insert(g_const_hash, g_const_names, key, idx)
                end
                vi = vi + 1
            end
        end
        if child_type == AstType.ConstDecl do
            const_name = ast_node_name(child)
            if ast_node_child_count(child) > 0 do
                init_expr = ast_node_child(child, 0)
                val = eval_const_expr(init_expr)
                if hash_table_lookup(g_const_hash, g_const_names, const_name) < 0 do
                    idx = vec_len_rt(g_const_names)
                    g_const_names = vec_push_rt(g_const_names, const_name as i64)
                    g_const_values = vec_push_rt(g_const_values, val)
                    hash_table_insert(g_const_hash, g_const_names, const_name, idx)
                end
            end
        end
        if child_type == AstType.BundleExpr do
            const_name = ast_node_name(child)
            if fat_str_len(const_name) > 0 do
                val = 0
                if ast_node_child_count(child) > 0 do
                    val = eval_const_expr(ast_node_child(child, 0))
                end
                if hash_table_lookup(g_const_hash, g_const_names, const_name) < 0 do
                    idx = vec_len_rt(g_const_names)
                    g_const_names = vec_push_rt(g_const_names, const_name as i64)
                    g_const_values = vec_push_rt(g_const_values, val)
                    hash_table_insert(g_const_hash, g_const_names, const_name, idx)
                end
            end
        end
        if child_type == AstType.EntityDef or child_type == AstType.PackedDef or child_type == AstType.RegisterDef do
            entity_name = ast_node_name(child)
            var is_packed = 0
            if child_type == AstType.PackedDef do is_packed = 1 end
            if hash_table_lookup(g_entity_hash, g_entity_names, entity_name) < 0 do
                idx = vec_len_rt(g_entity_names)
                g_entity_names = vec_push_rt(g_entity_names, entity_name as i64)
                g_entity_is_packed = vec_push_rt(g_entity_is_packed, is_packed)
                g_entity_sizes = vec_push_rt(g_entity_sizes, 0)
                g_entity_nodes = vec_push_rt(g_entity_nodes, child as i64)
                hash_table_insert(g_entity_hash, g_entity_names, entity_name, idx)
            end
            field_count = ast_node_child_count(child)
            var j = 0
            var actual_field_idx = 0
            when j < field_count loop
                field = ast_node_child(child, j)
                if ast_node_type_of(field) == AstType.FuncDef do
                    method_key = qualified_member_name(entity_name, ast_node_name(field))
                    if hash_table_lookup(g_scoped_method_hash, g_scoped_method_names, method_key) < 0 do
                        method_idx = vec_len_rt(g_scoped_method_names)
                        g_scoped_method_names = vec_push_rt(g_scoped_method_names, method_key as i64)
                        g_scoped_method_nodes = vec_push_rt(g_scoped_method_nodes, field as i64)
                        hash_table_insert(g_scoped_method_hash, g_scoped_method_names, method_key, method_idx)
                    end
                else
                    field_name = ast_node_name(field)
                    dot_str = fat_str_new(".")
                    scoped_key = fat_str_concat(fat_str_concat(entity_name, dot_str), field_name)
                    if hash_table_lookup(g_scoped_field_hash, g_scoped_field_names, scoped_key) < 0 do
                        idx_s = vec_len_rt(g_scoped_field_names)
                        g_scoped_field_names = vec_push_rt(g_scoped_field_names, scoped_key as i64)
                        g_scoped_field_indices = vec_push_rt(g_scoped_field_indices, actual_field_idx)
                        var ft_decl = ast_node_name2(field)
                        if ft_decl == 0 do ft_decl = fat_str_new("") end
                        g_scoped_field_types = vec_push_rt(g_scoped_field_types, ft_decl as i64)
                        g_scoped_field_offsets = vec_push_rt(g_scoped_field_offsets, 0)
                        g_scoped_field_sizes = vec_push_rt(g_scoped_field_sizes, 0)
                        g_scoped_field_signed = vec_push_rt(g_scoped_field_signed, 0)
                        g_scoped_field_is_nested = vec_push_rt(g_scoped_field_is_nested, 0)
                        hash_table_insert(g_scoped_field_hash, g_scoped_field_names, scoped_key, idx_s)
                    end
                    field_t = ast_node_name2(field)
                    if field_t != 0 and fat_str_len(field_t) > 0 do
                        set_var_type(field_name, field_t)
                    end
                    if hash_table_lookup(g_field_hash, g_field_names, field_name) < 0 do
                        idx = vec_len_rt(g_field_names)
                        g_field_names = vec_push_rt(g_field_names, field_name as i64)
                        g_field_indices = vec_push_rt(g_field_indices, actual_field_idx)
                        hash_table_insert(g_field_hash, g_field_names, field_name, idx)
                    end
                    if child_type == AstType.RegisterDef and hash_table_lookup(g_regfield_hash, g_register_field_names, field_name) < 0 do
                        width = ast_node_builtin_id(field)
                        if width <= 0 do width = 1 end
                        idx = vec_len_rt(g_register_field_names)
                        g_register_field_names = vec_push_rt(g_register_field_names, field_name as i64)
                        g_register_field_starts = vec_push_rt(g_register_field_starts, ast_node_int_val(field))
                        g_register_field_widths = vec_push_rt(g_register_field_widths, width)
                        hash_table_insert(g_regfield_hash, g_register_field_names, field_name, idx)
                    end
                    actual_field_idx = actual_field_idx + 1
                end
                j = j + 1
            end
        end
        i = i + 1
    end

    var pk_i = 0
    when pk_i < n loop
        pk_child = ast_node_child(ast, pk_i)
        if ast_node_type_of(pk_child) == AstType.PackedDef do
            compute_packed_layout(pk_child)
        end
        pk_i = pk_i + 1
    end

    global_n = ast_node_child_count(ast)
    var global_i = 0
    when global_i < global_n loop
        global_node = ast_node_child(ast, global_i)
        g_node_type = ast_node_type_of(global_node)
        if g_node_type == AstType.VarDecl or g_node_type == AstType.ReactiveDecl or g_node_type == AstType.MorphDecl do
            global_name = ast_node_name(global_node)
            if hash_table_lookup(g_lower_global_hash, g_lower_global_names, global_name) < 0 do
                global_slot = vec_len_rt(g_lower_global_names)
                global_value = 0
                init_node = 0
                if ast_node_child_count(global_node) > 0 do
                    init_node = ast_node_child(global_node, 0) as i64
                    global_value = eval_const_expr(ast_node_child(global_node, 0))
                end
                g_lower_global_names = vec_push_rt(g_lower_global_names, global_name as i64)
                g_lower_global_values = vec_push_rt(g_lower_global_values, global_value)
                g_lower_global_init_nodes = vec_push_rt(g_lower_global_init_nodes, init_node)
                hash_table_insert(g_lower_global_hash, g_lower_global_names, global_name, global_slot)
            end
        end
        global_i = global_i + 1
    end
    g_prog_ast = ast
end.

func global_slot_lookup(name: string):
    out hash_table_lookup(g_lower_global_hash, g_lower_global_names, name)
end.

func find_func_ast(fn_name: &string):
    if g_func_ast_hash != 0 and fn_name != 0 do
        let idx = hash_table_lookup(g_func_ast_hash, g_func_ast_names, fn_name)
        if idx >= 0 do
            out vec_get_rt(g_func_ast_nodes, idx) as AstNode
        end
        if is_user_module(g_ast_to_mir_cur_module) == 1 do
            let mod_fn = fat_str_concat(fat_str_concat(g_ast_to_mir_cur_module, fat_str_new(".")), fn_name as string)
            let idx_mod = hash_table_lookup(g_func_ast_hash, g_func_ast_names, mod_fn)
            if idx_mod >= 0 do
                out vec_get_rt(g_func_ast_nodes, idx_mod) as AstNode
            end
        end
        let s_ptr = fn_name as int
        if s_ptr != 0 and g_func_ast_names != 0 do
            let c_len = native_read_i64(s_ptr, 8) as int
            let c_cstr = native_read_i64(s_ptr, 0) as int
            let n_fn = vec_len_rt(g_func_ast_names)
            var k_fn = 0
            when k_fn < n_fn loop
                let cand_ptr = vec_get_rt(g_func_ast_names, k_fn) as int
                if cand_ptr != 0 do
                    let cand_len = native_read_i64(cand_ptr, 8) as int
                    let cand_cstr = native_read_i64(cand_ptr, 0) as int
                    if cand_len > c_len + 1 and c_cstr != 0 and cand_cstr != 0 do
                        if native_read_u8(cand_cstr, cand_len - c_len - 1) == 46 do
                            var match = 1
                            var ci = 0
                            when ci < c_len loop
                                if native_read_u8(cand_cstr, cand_len - c_len + ci) != native_read_u8(c_cstr, ci) do
                                    match = 0
                                end
                                ci = ci + 1
                            end
                            if match == 1 do
                                out vec_get_rt(g_func_ast_nodes, k_fn) as AstNode
                            end
                        end
                    end
                end
                k_fn = k_fn + 1
            end
        end
    end
    if g_scoped_method_hash != 0 and fn_name != 0 do
        let idx_m = hash_table_lookup(g_scoped_method_hash, g_scoped_method_names, fn_name)
        if idx_m >= 0 do
            out vec_get_rt(g_scoped_method_nodes, idx_m) as AstNode
        end
    end
    out 0 as AstNode
end.

func find_func_return_tuple_elem_type(callee: string, elem_idx: int):
    if fat_cstr_eq(callee, "advance") == 1 do
        if elem_idx == 0 do out fat_str_new("Parser") end
        if elem_idx == 1 do out fat_str_new("Token") end
    end
    if fat_cstr_eq(callee, "match_tok") == 1 do
        if elem_idx == 0 do out fat_str_new("Parser") end
        if elem_idx == 1 do out fat_str_new("bool") end
    end
    if fat_cstr_eq(callee, "expect_tok") == 1 do
        if elem_idx == 0 do out fat_str_new("Parser") end
        if elem_idx == 1 do out fat_str_new("Token") end
        if elem_idx == 2 do out fat_str_new("bool") end
    end
    if fat_cstr_eq(callee, "expect_name_tok") == 1 do
        if elem_idx == 0 do out fat_str_new("Parser") end
        if elem_idx == 1 do out fat_str_new("Token") end
        if elem_idx == 2 do out fat_str_new("bool") end
    end
    if fat_str_len(callee) == 0 do out fat_str_new("") end
    let fn_ast = find_func_ast(callee)
    if (fn_ast as i64) == 0 do out fat_str_new("") end
    let n_children = ast_node_child_count(fn_ast)
    if n_children == 0 do out fat_str_new("") end
    let body = ast_node_child(fn_ast, n_children - 1)
    if (body as i64) == 0 do out fat_str_new("") end
    let body_children = ast_node_child_count(body)
    var bi = 0
    when bi < body_children loop
        let bch = ast_node_child(body, bi)
        if ast_node_type_of(bch) == AstType.ReturnStmt and ast_node_child_count(bch) > 0 do
            let ret_expr = ast_node_child(bch, 0)
            if ast_node_type_of(ret_expr) == AstType.TupleExpr and elem_idx < ast_node_child_count(ret_expr) do
                let elem_node = ast_node_child(ret_expr, elem_idx)
                out infer_expr_type_name(elem_node)
            end
        end
        bi = bi + 1
    end
    out fat_str_new("")
end.

func get_func_param_mode(fn_ast: &AstNode, p_idx: i64):
    if (fn_ast as i64) == 0 do out 0 end
    var cur_p = 0
    let n_ch = ast_node_child_count(fn_ast)
    var ci = 0
    when ci < n_ch loop
        let ch = ast_node_child(fn_ast, ci)
        let cnt = ast_node_type_of(ch)
        if cnt == AstType.Identifier or cnt == AstType.RefParam or cnt == AstType.ParamDef or cnt == AstType.OutParam do
            if cur_p == p_idx do
                if cnt == AstType.RefParam or (cnt == AstType.ParamDef and ast_node_int_val(ch) == 1) do
                    out 1
                eif cnt == AstType.OutParam or (cnt == AstType.ParamDef and ast_node_int_val(ch) == 2) do
                    out 2
                else
                    out 0
                end
            end
            cur_p = cur_p + 1
        end
        ci = ci + 1
    end
    out 0
end.

