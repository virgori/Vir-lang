##
 * compiler/src/lower/ast_to_mir/expr.vri — Expressions & Literals Lowering
 * ==========================================================================
 ##

include types_prelude
include rt_vec_rt
include rt_string_rt
include parser
include mir
include ast_to_mir_context
include ast_to_mir_layout
include ast_to_mir_builder
include ast_to_mir_calls
include ast_to_mir_expr_ops
import is_module_namespace, module_alias_resolve from names_context

func lower_expr_impl(b: MirBuilder, expr: &AstNode):
	expr_type = ast_node_type_of(expr)

	if expr_type == AstType.Call or expr_type == AstType.BuiltinCall or expr_type == AstType.MethodCall do
		out lower_expr_calls(b, expr, expr_type)
	end

	if expr_type == AstType.BinOp or expr_type == AstType.Compare or expr_type == AstType.UnaryNot or expr_type == AstType.SwizzleExpr or expr_type == AstType.SafeAccessExpr or expr_type == AstType.ErxExpr or expr_type == AstType.TaskExpr or expr_type == AstType.WaitExpr or expr_type == AstType.QuantizeExpr or expr_type == AstType.PercentExpr or expr_type == AstType.UnaryMinus or expr_type == AstType.AddrOf do
		out lower_expr_ops(b, expr, expr_type)
	end

	if expr_type == AstType.Assign do
		var b_stmt = lower_stmt(b, expr)
		var v_res = get_var_vreg(b_stmt, ast_node_name(expr))
		if v_res >= 0 do
			out expr_result(b_stmt, mir_opnd_vreg(v_res))
		end
		out expr_result(b_stmt, g_lower_expr_result_opnd as MirOperand)
	end

    # Enum constructors are resolved by semantic pass 3.  They never become
    # ordinary function calls and require no runtime/prelude helper.
    if expr_type == AstType.EnumConstruct do
        out lower_enum_construct(b, expr, ast_node_name2(expr), ast_node_name(expr))
    end

    # 1. Literal Int
	if expr_type == AstType.LiteralInt do
		var (b2, v) = builder_new_vreg(b)
		ins = mir_instr_new(MirOp.Move, mir_opnd_vreg(v), mir_opnd_imm(ast_node_int_val(expr)), mir_opnd_none())
		b2 = builder_add_instr(b2, ins)
		out expr_result(b2, mir_opnd_vreg(v))
	end

	if expr_type == AstType.PrecompBlock do
		var (b2, v) = builder_new_vreg(b)
		ins = mir_instr_new(MirOp.Move, mir_opnd_vreg(v), mir_opnd_imm(ast_node_int_val(expr)), mir_opnd_none())
		b2 = builder_add_instr(b2, ins)
		out expr_result(b2, mir_opnd_vreg(v))
	end

    # 2. Literal Float (raw 64-bit IEEE 754 bits from offset 48)
	if expr_type == AstType.LiteralFloat do
		var (b2, v) = builder_new_vreg(b)
		f_bits = native_read_i64(expr as i64, 48)
		ins = mir_instr_new(MirOp.Move, mir_opnd_vreg(v), mir_opnd_imm(f_bits), mir_opnd_none())
		mir_instr_set_type(ins, MirType.F64 as i64)
		b2 = builder_add_instr(b2, ins)
		out expr_result(b2, mir_opnd_vreg(v))
	end

    # 2b. Literal Bool
	if expr_type == AstType.LiteralBool do
		var (b2, v) = builder_new_vreg(b)
		ins = mir_instr_new(MirOp.Move, mir_opnd_vreg(v), mir_opnd_imm(ast_node_int_val(expr)), mir_opnd_none())
		b2 = builder_add_instr(b2, ins)
		out expr_result(b2, mir_opnd_vreg(v))
	end

    # 2c. Literal None
	if expr_type == AstType.LiteralNone do
		var (b2, v) = builder_new_vreg(b)
		ins = mir_instr_new(MirOp.Move, mir_opnd_vreg(v), mir_opnd_imm(0), mir_opnd_none())
		b2 = builder_add_instr(b2, ins)
		out expr_result(b2, mir_opnd_vreg(v))
	end

    # 3. Literal Str — src1 = string-pool id (100% static, zero runtime alloc)
	if expr_type == AstType.LiteralStr do
		var (b1, sid) = builder_intern(b, ast_node_name(expr))
		var (b2, v) = builder_new_vreg(b1)
		b2 = emit_intrinsic(b2, MIR_INTR_STR_LIT, mir_opnd_vreg(v), mir_opnd_imm(sid))
		out expr_result(b2, mir_opnd_vreg(v))
	end

    # 3b. InterpExpr — lowered to str_cat (bid 11) and int_to_str (bid 19) in Arena
	if expr_type == AstType.InterpExpr do
		n_segs = ast_node_child_count(expr)
		if n_segs == 0 do
			var (b1, sid) = builder_intern(b, fat_str_new(""))
			var (b2, v) = builder_new_vreg(b1)
			b2 = emit_intrinsic(b2, MIR_INTR_STR_LIT, mir_opnd_vreg(v), mir_opnd_imm(sid))
			out expr_result(b2, mir_opnd_vreg(v))
		end

		# Lower first segment and convert non-string values deterministically.
		first_child = ast_node_child(expr, 0)
		var b_cur = lower_interp_segment(b, first_child)
		var cur_opnd = g_lower_expr_result_opnd as MirOperand

		# If only 1 segment and already evaluated:
		if n_segs == 1 do
			out expr_result(b_cur, cur_opnd)
		end

		# Concatenate subsequent segments using str_cat (bid 11)
		var si = 1
		when si < n_segs loop
			seg_child = ast_node_child(expr, si)
			b_cur = lower_interp_segment(b_cur, seg_child)
			var seg_opnd = g_lower_expr_result_opnd as MirOperand

			# Call str_cat(cur_opnd, seg_opnd) (bid 11)
			b_cur = emit_set_arg(b_cur, 0, cur_opnd)
			b_cur = emit_set_arg(b_cur, 1, seg_opnd)
			var (b_cat, res_v) = builder_new_vreg(b_cur)
			b_cur = emit_intrinsic(b_cat, MIR_INTR_BUILTIN, mir_opnd_vreg(res_v), mir_opnd_imm(11))
			cur_opnd = mir_opnd_vreg(res_v)
			si = si + 1
		end
		out expr_result(b_cur, cur_opnd)
	end

    # 4. Identifier
	if expr_type == AstType.Identifier do
		fname = ast_node_name(expr)
		if g_func_ref_param_hash != 0 do
			ref_idx = hash_table_lookup(g_func_ref_param_hash, g_func_ref_param_names, fname)
			if ref_idx >= 0 do
				ptr_vreg = vec_get_rt(g_func_ref_param_vregs, ref_idx)
				var (b_load, val_vreg) = builder_new_vreg(b)
				b_load = emit_load(b_load, val_vreg, mir_opnd_vreg(ptr_vreg))
				out expr_result(b_load, mir_opnd_vreg(val_vreg))
			end
		end
		v = get_var_vreg(b, fname)
		if v >= 0 do
			out expr_result(b, mir_opnd_vreg(v))
		else
            if fat_cstr_eq(fname, "true") == 1 do
                out expr_result(b, mir_opnd_imm(1))
            end
            if fat_cstr_eq(fname, "false") == 1 do
                out expr_result(b, mir_opnd_imm(0))
            end
            if fat_cstr_eq(fname, "null") == 1 do
                out expr_result(b, mir_opnd_imm(0))
            end
            if fat_cstr_eq(fname, "void") == 1 do
                out expr_result(b, mir_opnd_imm(0))
            end
            if g_const_hash > 0 do
                c_idx = hash_table_lookup(g_const_hash, g_const_names, fname)
                if c_idx >= 0 do
                    c_val = vec_get_rt(g_const_values, c_idx)
                    out expr_result(b, mir_opnd_imm(c_val))
                end
            end
			global_slot = global_slot_lookup(fname)
			if global_slot >= 0 do
				var (b_global, global_vreg) = builder_new_vreg(b)
				b_global = emit_intrinsic(b_global, MIR_INTR_GLOBAL_LOAD, mir_opnd_vreg(global_vreg), mir_opnd_imm(global_slot))
				out expr_result(b_global, mir_opnd_vreg(global_vreg))
			end
			let resolved_fn = resolve_callee_alias(fname)
			let is_fn = (find_func_ast(resolved_fn as i64) as i64 != 0) or (find_func_ast(fname as i64) as i64 != 0)
			let is_ffi = (ffi_import_find(resolved_fn) >= 0) or (ffi_import_find(fname) >= 0)
			if not is_fn and not is_ffi do
				var sb_err = sb_new()
				sb_err = sb_append(sb_err, "virc: error: lowering unresolved identifier: ")
				var f_len = fat_str_len(fname)
				var fi = 0
				when fi < f_len loop
					sb_err = sb_append_char(sb_err, fat_str_byte_at(fname, fi))
					fi = fi + 1
				end
				print_ln(sb_to_string(sb_err))
				sb_free(sb_err)
				sys_exit(1)
			end
			var (b1, cid) = builder_intern(b, resolved_fn)
			var (b2, dst) = builder_new_vreg(b1)
			b2 = emit_intrinsic(b2, MIR_INTR_ADDR_OF, mir_opnd_vreg(dst), mir_opnd_imm(cid))
			out expr_result(b2, mir_opnd_vreg(dst))
		end
	end

    # 5. BinOp & Compare — full OpType→MirOp; Land/Lor → CFG (no silent Add)
	if expr_type == AstType.PatternExpr do
		if ast_node_child_count(expr) >= 2 do
			var b3 = lower_expr(b, ast_node_child(expr, 0))
			var opnd_l = g_lower_expr_result_opnd as MirOperand
			var b4 = lower_expr(b3, ast_node_child(expr, 1))
			var opnd_r = g_lower_expr_result_opnd as MirOperand
			var (b5, dst) = builder_new_vreg(b4)
			b5 = emit_set_arg(b5, 0, opnd_l)
			b5 = emit_set_arg(b5, 1, opnd_r)
			out expr_result(emit_intrinsic(b5, MIR_INTR_PATTERN, mir_opnd_vreg(dst), opnd_l), mir_opnd_vreg(dst))
		end
	end
	if expr_type == AstType.ExistExpr do
		if ast_node_child_count(expr) >= 2 do
			var b_m = lower_expr(b, ast_node_child(expr, 0))
			var m_op = g_lower_expr_result_opnd as MirOperand
			var key_node = ast_node_child(expr, 1)
			var b_k = lower_expr(b_m, key_node)
			var k_op = g_lower_expr_result_opnd as MirOperand
			out lower_dict_contains(b_k, m_op, k_op, dict_key_is_string(key_node))
		end
		if ast_node_child_count(expr) > 0 do
			var b2 = lower_expr(b, ast_node_child(expr, 0))
			var v = g_lower_expr_result_opnd as MirOperand
			var (b3, dst) = builder_new_vreg(b2)
			out expr_result(emit_intrinsic(b3, MIR_INTR_EXIST, mir_opnd_vreg(dst), v), mir_opnd_vreg(dst))
		end
	end
	if expr_type == AstType.MapExpr do
		if fat_str_len(ast_node_name(expr)) > 0 and fat_cstr_eq(ast_node_name(expr), "map") == 0 do
			out lower_map_block_expr(b, expr)
		end
		var (b2, nargs) = lower_call_args(b, expr, 0, 0)
		var (b3, dst) = builder_new_vreg(b2)
		out expr_result(emit_intrinsic(b3, MIR_INTR_MAP, mir_opnd_vreg(dst), mir_opnd_imm(nargs)), mir_opnd_vreg(dst))
	end
	if expr_type == AstType.ArrCompactExpr do
		var (b2, nargs) = lower_call_args(b, expr, 0, 0)
		var (b3, dst) = builder_new_vreg(b2)
		out expr_result(emit_intrinsic(b3, MIR_INTR_ARR_COMPACT, mir_opnd_vreg(dst), mir_opnd_imm(nargs)), mir_opnd_vreg(dst))
	end
	if expr_type == AstType.BundleExpr do
		child_count = ast_node_child_count(expr)
		if child_count > 0 do
			c0 = ast_node_child(expr, 0)
			if ast_node_type_of(c0) == AstType.LiteralStr do
				var (b1, sid) = builder_intern(b, ast_node_name(c0))
				var (b2, dst) = builder_new_vreg(b1)
				out expr_result(emit_intrinsic(b2, MIR_INTR_STR_LIT, mir_opnd_vreg(dst), mir_opnd_imm(sid)), mir_opnd_vreg(dst))
			end
		end
		var (b2, nargs) = lower_call_args(b, expr, 0, 0)
		var (b3, dst) = builder_new_vreg(b2)
		out expr_result(emit_intrinsic(b3, MIR_INTR_BUNDLE, mir_opnd_vreg(dst), mir_opnd_imm(nargs)), mir_opnd_vreg(dst))
	end
	if expr_type == AstType.ErrorExpr do
		var (b1, dst) = builder_new_vreg(b)
		out expr_result(emit_intrinsic(b1, MIR_INTR_ERROR, mir_opnd_vreg(dst), mir_opnd_none()), mir_opnd_vreg(dst))
	end
	if expr_type == AstType.PtrTypeExpr do
        fname = ast_node_name(expr)
        v = get_var_vreg(b, fname)
        if v >= 0 do
            out expr_result(b, mir_opnd_vreg(v))
        end
		var (b1, pid) = builder_intern(b, fname)
		var (b2, dst) = builder_new_vreg(b1)
		out expr_result(emit_intrinsic(b2, MIR_INTR_PTR, mir_opnd_vreg(dst), mir_opnd_imm(pid)), mir_opnd_vreg(dst))
	end
	if expr_type == AstType.PrecompBlock do
		if ast_node_child_count(expr) > 0 do
			out lower_expr(b, ast_node_child(expr, 0))
		end
		out expr_result(b, mir_opnd_imm(0))
	end

    # 8. Aggregate literals — SetArg each element then Intrinsic
	if expr_type == AstType.ArrayLiteral do
		out lower_aggregate(b, MIR_INTR_ARRAY, expr)
	end
	if expr_type == AstType.DictLiteral do
		out lower_dict_literal(b, expr)
	end
	if expr_type == AstType.TupleExpr do
		out lower_aggregate(b, MIR_INTR_TUPLE, expr)
	end
	if expr_type == AstType.EntityLiteral do
		out lower_aggregate(b, MIR_INTR_ENTITY, expr)
	end
	if expr_type == AstType.SizeofExpr do
		sz = get_type_byte_size(ast_node_name(expr))
		out expr_result(b, mir_opnd_imm(sz))
	end

    # 9. Index — shapes: children[base,idx] OR name=base + children[idx]
	if expr_type == AstType.IndexAccess or expr_type == AstType.ExprIndex do
		if fat_cstr_eq(ast_node_name2(expr), "__slice__") == 1 do
			bv = get_var_vreg(b, ast_node_name(expr))
			var b2 = lower_expr(b, ast_node_child(expr, 0))
			var start_op = g_lower_expr_result_opnd as MirOperand
			var b3 = lower_expr(b2, ast_node_child(expr, 1))
			var end_op = g_lower_expr_result_opnd as MirOperand
			var (b4, slen_vreg) = builder_new_vreg(b3)
			ins_sub = mir_instr_new(MirOp.Sub, mir_opnd_vreg(slen_vreg), end_op, start_op)
			b4 = builder_add_instr(b4, ins_sub)

			var (b5, tmp8) = builder_new_vreg(b4)
			ins_mul = mir_instr_new(MirOp.Mul, mir_opnd_vreg(tmp8), mir_opnd_vreg(slen_vreg), mir_opnd_imm(8))
			b5 = builder_add_instr(b5, ins_mul)
			var (b6, alloc_sz) = builder_new_vreg(b5)
			ins_add = mir_instr_new(MirOp.Add, mir_opnd_vreg(alloc_sz), mir_opnd_vreg(tmp8), mir_opnd_imm(16))
			b6 = builder_add_instr(b6, ins_add)

			b6 = emit_set_arg(b6, 0, mir_opnd_vreg(alloc_sz))
			var (b7, dst_base) = builder_new_vreg(b6)
			b7 = emit_intrinsic(b7, MIR_INTR_BUILTIN, mir_opnd_vreg(dst_base), mir_opnd_imm(3))

			b7 = emit_set_arg(b7, 0, mir_opnd_vreg(dst_base))
			b7 = emit_set_arg(b7, 1, mir_opnd_imm(0))
			b7 = emit_set_arg(b7, 2, mir_opnd_vreg(slen_vreg))
			b7 = emit_intrinsic(b7, MIR_INTR_BUILTIN, mir_opnd_none(), mir_opnd_imm(8))

			b7 = emit_set_arg(b7, 0, mir_opnd_vreg(dst_base))
			b7 = emit_set_arg(b7, 1, mir_opnd_imm(8))
			b7 = emit_set_arg(b7, 2, mir_opnd_vreg(slen_vreg))
			b7 = emit_intrinsic(b7, MIR_INTR_BUILTIN, mir_opnd_none(), mir_opnd_imm(8))

			var (b8, iv) = builder_new_vreg(b7)
			ins0 = mir_instr_new(MirOp.Move, mir_opnd_vreg(iv), mir_opnd_imm(0), mir_opnd_none())
			b8 = builder_add_instr(b8, ins0)
			loop_var_name = fat_str_concat(fat_str_new("__slice_i_"), ast_node_name(expr))
			b8 = set_var_vreg(b8, loop_var_name, iv)

			var (b9, cond_id) = builder_add_block(b8)
			var (b10, body_id) = builder_add_block(b9)
			var (b11, step_id) = builder_add_block(b10)
			var (b12, end_id) = builder_add_block(b11)

			b12 = emit_jump(b12, cond_id)
			b12 = builder_push_loop(b12, end_id, step_id)
			b12 = builder_set_current_block(b12, cond_id)

			iv_cur = get_var_vreg(b12, loop_var_name)
			var (b13, cmpv) = builder_new_vreg(b12)
			insc = mir_instr_new(MirOp.CmpLt, mir_opnd_vreg(cmpv), mir_opnd_vreg(iv_cur), mir_opnd_vreg(slen_vreg))
			b13 = builder_add_instr(b13, insc)
			b13 = emit_jump_if_not(b13, mir_opnd_vreg(cmpv), end_id, body_id)

			b13 = builder_set_current_block(b13, body_id)
			var (b14, src_idx) = builder_new_vreg(b13)
			ins_src = mir_instr_new(MirOp.Add, mir_opnd_vreg(src_idx), start_op, mir_opnd_vreg(iv_cur))
			b14 = builder_add_instr(b14, ins_src)

			var (b15, elem_val) = builder_new_vreg(b14)
			b15 = emit_set_arg(b15, 0, mir_opnd_vreg(src_idx))
			b15 = emit_intrinsic(b15, MIR_INTR_INDEX, mir_opnd_vreg(elem_val), mir_opnd_vreg(bv))

			b15 = emit_set_arg(b15, 0, mir_opnd_vreg(iv_cur))
			b15 = emit_set_arg(b15, 1, mir_opnd_vreg(elem_val))
			b15 = emit_intrinsic(b15, MIR_INTR_INDEX_STORE, mir_opnd_none(), mir_opnd_vreg(dst_base))

			b15 = emit_jump(b15, step_id)
			b15 = builder_set_current_block(b15, step_id)
			iv_cur2 = get_var_vreg(b15, loop_var_name)
			var (b16, ivn) = builder_new_vreg(b15)
			ins_add1 = mir_instr_new(MirOp.Add, mir_opnd_vreg(ivn), mir_opnd_vreg(iv_cur2), mir_opnd_imm(1))
			b16 = builder_add_instr(b16, ins_add1)
			ins_mov1 = mir_instr_new(MirOp.Move, mir_opnd_vreg(iv_cur2), mir_opnd_vreg(ivn), mir_opnd_none())
			b16 = builder_add_instr(b16, ins_mov1)
			b16 = set_var_vreg(b16, loop_var_name, iv_cur2)
			b16 = emit_jump(b16, cond_id)
			b16 = builder_pop_loop(b16)
			b16 = builder_set_current_block(b16, end_id)

			out expr_result(b16, mir_opnd_vreg(dst_base))
		end
	nch = ast_node_child_count(expr)
	base = mir_opnd_none()
	var vtype = fat_str_new("")
	var vdesc = 0
	var start_idx = 0
	var num_idx = 0
	if expr_type == AstType.IndexAccess do
		b_mut = b
		base_name = ast_node_name(expr)
		bv = get_var_vreg(b_mut, base_name)
		if bv >= 0 do
			base = mir_opnd_vreg(bv)
		end
		if is_known_dict_var(base_name) == 0 do
			vtype = get_var_type(base_name)
			vdesc = get_var_tdesc(base_name)
		end
		start_idx = 0
		num_idx = nch
	else
		var b_base = lower_expr(b, ast_node_child(expr, 0))
		var base_op = g_lower_expr_result_opnd as MirOperand
		b_mut = b_base
		base = base_op
		vtype = infer_expr_type_name(ast_node_child(expr, 0))
		vdesc = infer_expr_tdesc(ast_node_child(expr, 0))
		start_idx = 1
		num_idx = nch - 1
	end

	flat_opnd = mir_opnd_none()
	if num_idx <= 1 do
		if num_idx == 1 do
			var b_idx = lower_expr(b_mut, ast_node_child(expr, start_idx))
			var idx_op = g_lower_expr_result_opnd as MirOperand
			b_mut = b_idx
			flat_opnd = idx_op
		else
			flat_opnd = mir_opnd_imm(0)
		end
	else
		var k = 0
		when k < num_idx loop
			idx_ast = ast_node_child(expr, start_idx + k)
			var b_next = lower_expr(b_mut, idx_ast)
			var idx_op = g_lower_expr_result_opnd as MirOperand
			b_mut = b_next
			stride = 1
			if vdesc != 0 do
				stride = tdesc_stride(vdesc, k)
			end
			term_op = idx_op
			if stride > 1 do
				var (b_mul, mul_v) = builder_new_vreg(b_mut)
				ins_m = mir_instr_new(MirOp.Mul, mir_opnd_vreg(mul_v), idx_op, mir_opnd_imm(stride))
				b_mut = builder_add_instr(b_mul, ins_m)
				term_op = mir_opnd_vreg(mul_v)
			end
			if k == 0 do
				flat_opnd = term_op
			else
				var (b_add, add_v) = builder_new_vreg(b_mut)
				ins_a = mir_instr_new(MirOp.Add, mir_opnd_vreg(add_v), flat_opnd, term_op)
				b_mut = builder_add_instr(b_add, ins_a)
				flat_opnd = mir_opnd_vreg(add_v)
			end
			k = k + 1
		end
	end

	if base.op_type != MirOperandType.None do
		if expr_type == AstType.IndexAccess and is_known_dict_var(ast_node_name(expr)) == 1 do
			out lower_dict_index(b_mut, base, flat_opnd, dict_key_is_string(ast_node_child(expr, 0)))
		end
		var (b4, dst) = builder_new_vreg(b_mut)
		b4 = emit_set_arg(b4, 0, flat_opnd)
		var elem_m_typ = MirType.Int64
		var is_signed: i64 = 1
		if vdesc != 0 do
			let code = tdesc_elem_code(vdesc)
			if code == 1 do elem_m_typ = MirType.F32 end
			if code == 2 do elem_m_typ = MirType.F16 end
			if code == 3 do elem_m_typ = MirType.Int8; is_signed = 1 end
			if code == 4 do elem_m_typ = MirType.Int8; is_signed = 0 end
			if code == 5 do elem_m_typ = MirType.Int32 end
			if code == 7 do elem_m_typ = MirType.F64 end
		end
		if is_flux_type_str(vtype) do
			let f_elem = parse_flux_elem_type(vtype) as int
			if f_elem == (TypeKind.Float as int) do
				elem_m_typ = MirType.F64
			end
		end
		b4 = emit_intrinsic_typed_with_bits(b4, MIR_INTR_INDEX, mir_opnd_vreg(dst), base, elem_m_typ, is_signed)
		out expr_result(b4, mir_opnd_vreg(dst))
	end
	out expr_result(b_mut, mir_opnd_none())
	end
	if expr_type == AstType.FieldAccess do
		nch = ast_node_child_count(expr)
		if nch >= 1 do
			base_ast = ast_node_child(expr, 0)
			if ast_node_type_of(base_ast) == AstType.Identifier do
				base_name_str = ast_node_name(base_ast)
				field_name_str = ast_node_name(expr)
				if is_module_namespace(base_name_str) == 1 do
					let mod_target = module_alias_resolve(base_name_str)
					dot_str = fat_str_new(".")
					key = fat_str_concat(fat_str_concat(mod_target, dot_str), field_name_str)
					if g_const_hash > 0 do
						c_idx = hash_table_lookup(g_const_hash, g_const_names, key)
						if c_idx >= 0 do
							c_val = vec_get_rt(g_const_values, c_idx)
							out expr_result(b, mir_opnd_imm(c_val))
						end
					end
				end
				# A qualified variant of a tagged enum must allocate the same
				# canonical representation as an unqualified constructor.
				if enum_index_from_type_name(base_name_str) >= 0 do
					out lower_enum_construct(b, expr, base_name_str, field_name_str)
				end
				dot_str = fat_str_new(".")
				key = fat_str_concat(base_name_str, dot_str)
				key = fat_str_concat(key, field_name_str)
				if g_const_hash > 0 do
					c_idx = hash_table_lookup(g_const_hash, g_const_names, key)
					if c_idx >= 0 do
						c_val = vec_get_rt(g_const_values, c_idx)
						out expr_result(b, mir_opnd_imm(c_val))
					end
				end
				base_name = ast_node_name(base_ast)
				bv = get_var_vreg(b, base_name)
				gv = global_slot_lookup(base_name)
				if bv < 0 and gv < 0 do
					print_str("virc: error: unresolved symbol or enum: base=")
					print_str(native_read_i64(base_name, 0))
					print_str(" field=")
					print_ln(native_read_i64(field_name_str, 0))
					sys_exit(1)
					out expr_result(b, mir_opnd_imm(0))
				end
			eif ast_node_type_of(base_ast) == AstType.FieldAccess and ast_node_child_count(base_ast) > 0 do
				let mod_ast = ast_node_child(base_ast, 0)
				if ast_node_type_of(mod_ast) == AstType.Identifier do
					let mod_name_str = ast_node_name(mod_ast)
					if is_module_namespace(mod_name_str) == 1 do
						let mod_target = module_alias_resolve(mod_name_str)
						let enum_name_str = ast_node_name(base_ast)
						let variant_name_str = ast_node_name(expr)
						if enum_index_from_type_name(enum_name_str) >= 0 do
							out lower_enum_construct(b, expr, enum_name_str, variant_name_str)
						end
						dot_str = fat_str_new(".")
						let qual_key = fat_str_concat(fat_str_concat(mod_target, dot_str), fat_str_concat(fat_str_concat(enum_name_str, dot_str), variant_name_str))
						if g_const_hash > 0 do
							c_idx = hash_table_lookup(g_const_hash, g_const_names, qual_key)
							if c_idx >= 0 do
								c_val = vec_get_rt(g_const_values, c_idx)
								out expr_result(b, mir_opnd_imm(c_val))
							end
							let bare_key = fat_str_concat(fat_str_concat(enum_name_str, dot_str), variant_name_str)
							c_idx = hash_table_lookup(g_const_hash, g_const_names, bare_key)
							if c_idx >= 0 do
								c_val = vec_get_rt(g_const_values, c_idx)
								out expr_result(b, mir_opnd_imm(c_val))
							end
						end
					end
				end
			end
			var b2 = lower_expr(b, base_ast)
			var base = g_lower_expr_result_opnd as MirOperand
			fname = ast_node_name(expr)
			base_type = get_expr_entity_type(base_ast)
			if fat_str_len(base_type) == 0 and ast_node_type_of(base_ast) == AstType.Identifier do
				base_type = get_var_type(ast_node_name(base_ast))
			end
			if is_register_field_scoped(base_type, fname) == 1 do
				start_bit = get_register_field_start_scoped(base_type, fname)
				width = get_register_field_width_scoped(base_type, fname)
				var (b3, dst) = builder_new_vreg(b2)
				let pack_info = MIR_INTR_BIT_EXTRACT or (start_bit shl 8) or (width shl 16)
				ins = mir_instr_new(MirOp.Intrinsic, mir_opnd_vreg(dst), base, mir_opnd_imm(pack_info))
				b3 = builder_add_instr(b3, ins)
				out expr_result(b3, mir_opnd_vreg(dst))
			end
			var (b3, dst) = builder_new_vreg(b2)
			fname = ast_node_name(expr)
			if fat_cstr_eq(fname, "grad") == 1 do
				if g_lower_ai_mode != 2 or mir_opnd_type(base) != MirOperandType.VReg do
					print_str("virc: error: [E3109] gradient projection is only available for a differentiated train value\n")
					sys_exit(1)
					out expr_result(b2, mir_opnd_imm(0))
				end
				let grad_vreg = ad_grad_get(mir_opnd_vreg_id(base))
				if grad_vreg < 0 do
					print_str("virc: error: [E3109] gradient is unavailable before backward or for an unreachable value\n")
					sys_exit(1)
					out expr_result(b2, mir_opnd_imm(0))
				end
				out expr_result(b2, mir_opnd_vreg(grad_vreg))
			end
			if is_packed_entity(base_type) do
				f_off = get_scoped_field_offset(base_type, fname)
				f_sz = get_scoped_field_size(base_type, fname)
				f_sgn = get_scoped_field_signed(base_type, fname)
				f_nested = get_scoped_field_is_nested(base_type, fname)
				var (b4, addr) = builder_new_vreg(b3)
				ins_a = mir_instr_new(MirOp.Add, mir_opnd_vreg(addr), base, mir_opnd_imm(f_off))
				b4 = builder_add_instr(b4, ins_a)
				if f_nested == 1 do
					out expr_result(b4, mir_opnd_vreg(addr))
				else
					b4 = emit_load_typed(b4, dst, mir_opnd_vreg(addr), f_sz, f_sgn)
					out expr_result(b4, mir_opnd_vreg(dst))
				end
			end
			var fid = 0 - 1
			if fat_str_len(base_type) > 0 do
				fid = get_scoped_field_index(base_type, fname)
			end
			if fid < 0 do
				if fat_cstr_eq(fname, "grad") == 1 do
					fid = 1
				else
					base_name = ast_node_name(base_ast)
					fid = find_field_index_for_base(base_name, fname)
				end
			end
			var (b4, addr) = builder_new_vreg(b3)
			ins_a = mir_instr_new(MirOp.Add, mir_opnd_vreg(addr), base, mir_opnd_imm(fid * 8))
			b4 = builder_add_instr(b4, ins_a)
			b4 = emit_load(b4, dst, mir_opnd_vreg(addr))
			out expr_result(b4, mir_opnd_vreg(dst))
		end
	end

    # 10. EnumAccess — enum name + variant name (source syntax: Enum.Variant)
	if expr_type == AstType.EnumAccess do
		enum_name_str = ast_node_name(expr)
		variant_name_str = ast_node_name2(expr)
		out lower_enum_construct(b, expr, enum_name_str, variant_name_str)
	end

    # 11. InputExpr
 if expr_type == AstType.InputExpr do
 var (b2, dst) = builder_new_vreg(b)
 b2 = emit_intrinsic(b2, MIR_INTR_INPUT, mir_opnd_vreg(dst), mir_opnd_none())
 out expr_result(b2, mir_opnd_vreg(dst))
 end

    # 12. CastExpr — preserve source/destination numeric categories in kind.
 if expr_type == AstType.CastExpr do
 nch = ast_node_child_count(expr)
 if nch > 0 do
 var cast_child = ast_node_child(expr, 0)
 var b2 = lower_expr(b, cast_child)
 var child_opnd = g_lower_expr_result_opnd as MirOperand
 var (b3, dst) = builder_new_vreg(b2)
 var cast_src_name = infer_expr_type_name(cast_child)
 var cast_dst_name = ast_node_name(expr)
 var cast_src_cat = 1
 var cast_dst_cat = 1
 var cast_dst_bits = 64
 var cast_is_unsigned = 0
 var cast_mir_type = MirType.Int64 as i64
 if is_float_type_name(cast_src_name) do cast_src_cat = 2 end
 if is_float_type_name(cast_dst_name) do
     cast_dst_cat = 2
     cast_mir_type = MirType.F64 as i64
     if fat_cstr_eq(cast_dst_name, "f32") == 1 do cast_dst_bits = 32 end
 end
 var resolved_dst_name = get_mold_or_register_backing_type(cast_dst_name)
 if fat_cstr_eq(resolved_dst_name, "i8") == 1 do cast_dst_bits = 8; cast_mir_type = MirType.Int8 as i64 end
 if fat_cstr_eq(resolved_dst_name, "u8") == 1 do cast_dst_bits = 8; cast_is_unsigned = 1; cast_mir_type = MirType.Int8 as i64 end
 if fat_cstr_eq(resolved_dst_name, "i16") == 1 do cast_dst_bits = 16; cast_mir_type = MirType.Int16 as i64 end
 if fat_cstr_eq(resolved_dst_name, "u16") == 1 do cast_dst_bits = 16; cast_is_unsigned = 1; cast_mir_type = MirType.Int16 as i64 end
 if fat_cstr_eq(resolved_dst_name, "i32") == 1 do cast_dst_bits = 32; cast_mir_type = MirType.Int32 as i64 end
 if fat_cstr_eq(resolved_dst_name, "u32") == 1 do cast_dst_bits = 32; cast_is_unsigned = 1; cast_mir_type = MirType.Int32 as i64 end
 if fat_cstr_eq(resolved_dst_name, "u64") == 1 or fat_cstr_eq(resolved_dst_name, "uint") == 1 or fat_cstr_eq(resolved_dst_name, "usize") == 1 do cast_dst_bits = 64; cast_is_unsigned = 1; cast_mir_type = MirType.Int64 as i64 end
 var cast_kind = MIR_INTR_CAST + (cast_src_cat shl 8) + (cast_dst_cat shl 16) + (cast_dst_bits shl 24) + (cast_is_unsigned shl 32)
 b3 = emit_intrinsic_typed(b3, cast_kind, mir_opnd_vreg(dst), child_opnd, cast_mir_type)
 out expr_result(b3, mir_opnd_vreg(dst))
 end
 end

    # 13. AwaitExpr — await expr | await pass
 if expr_type == AstType.AwaitExpr do
 if fat_cstr_eq(ast_node_name(expr), "pass") do
 var (b2, dst) = builder_new_vreg(b)
 b2 = emit_intrinsic(b2, MIR_INTR_AWAIT_PASS, mir_opnd_vreg(dst), mir_opnd_none())
 out expr_result(b2, mir_opnd_vreg(dst))
 end
 nch = ast_node_child_count(expr)
 if nch > 0 do
 var b2 = lower_expr(b, ast_node_child(expr, 0))
 var child_opnd = g_lower_expr_result_opnd as MirOperand
 var (b3, dst) = builder_new_vreg(b2)
 b3 = emit_intrinsic(b3, MIR_INTR_AWAIT, mir_opnd_vreg(dst), child_opnd)
 out expr_result(b3, mir_opnd_vreg(dst))
 end
 end

    # 15. CheckCpu / PatchPoint
 if expr_type == AstType.CheckCpu do
 var (b2, dst) = builder_new_vreg(b)
 b2 = emit_intrinsic(b2, MIR_INTR_CHECK_CPU, mir_opnd_vreg(dst), mir_opnd_none())
 out expr_result(b2, mir_opnd_vreg(dst))
 end
	if expr_type == AstType.PatchPoint do
		var (b1, pid) = builder_intern(b, ast_node_name(expr))
		var (b2, dst) = builder_new_vreg(b1)
		b2 = emit_intrinsic(b2, MIR_INTR_PATCH_POINT, mir_opnd_vreg(dst), mir_opnd_imm(pid))
		out expr_result(b2, mir_opnd_vreg(dst))
	end

    # 14. NamedArg — children[0] is value (name on .name)
	if expr_type == AstType.NamedArg do
		nch = ast_node_child_count(expr)
		if nch > 0 do
			out lower_expr(b, ast_node_child(expr, 0))
		end
	end

	out expr_result(b, mir_opnd_none())
end.


func is_dict_type_name(type_name: string):
	if (type_name as i64) == 0 do out 0 end
	if fat_cstr_eq(type_name, "dict") == 1 do out 1 end
	let n_len = fat_str_len(type_name)
	if n_len < 4 do out 0 end
	let c0 = fat_str_byte_at(type_name, 0)
	let c1 = fat_str_byte_at(type_name, 1)
	let c2 = fat_str_byte_at(type_name, 2)
	let c3 = fat_str_byte_at(type_name, 3)
	if not (c0 == 100 and c1 == 105 and c2 == 99 and c3 == 116) do out 0 end
	if n_len == 4 do out 1 end
	let c4 = fat_str_byte_at(type_name, 4)
	if c4 == 32 or c4 == 91 or c4 == 40 or c4 == 60 do out 1 end
	out 0
end.

func dict_key_is_string(node: &AstNode):
	if fat_cstr_eq(infer_expr_type_name(node), "string") == 1 do out 1 end
	out 0
end.

func lower_dict_key_equal(b: &MirBuilder, stored_key: &MirOperand, key: &MirOperand, key_is_string: int):
	var (b_eq, eq_v) = builder_new_vreg(b)
	if key_is_string == 1 do
		b_eq = emit_set_arg(b_eq, 0, stored_key)
		b_eq = emit_set_arg(b_eq, 1, key)
		b_eq = emit_intrinsic(b_eq, MIR_INTR_BUILTIN, mir_opnd_vreg(eq_v), mir_opnd_imm(12))
	else
		b_eq = builder_add_instr(b_eq, mir_instr_new(MirOp.CmpEq, mir_opnd_vreg(eq_v), stored_key, key))
	end
	out expr_result(b_eq, mir_opnd_vreg(eq_v))
end.

func lower_dict_hash(b: MirBuilder, key: &MirOperand, is_string: int):
	var (b_h, h_v) = builder_new_vreg(b)
	if is_string == 0 do
		b_h = emit_move(b_h, h_v, key)
		out expr_result(b_h, mir_opnd_vreg(h_v))
	end
	b_h = emit_move(b_h, h_v, mir_opnd_imm(5381))
	var (b_idx, idx_v) = builder_new_vreg(b_h)
	b_idx = emit_move(b_idx, idx_v, mir_opnd_imm(0))
	var (b1, cond_id) = builder_add_block(b_idx)
	var (b2, body_id) = builder_add_block(b1)
	var (b3, end_id) = builder_add_block(b2)
	b3 = emit_jump(b3, cond_id)
	b3 = builder_set_current_block(b3, cond_id)
	b3 = emit_set_arg(b3, 0, key)
	b3 = emit_set_arg(b3, 1, mir_opnd_vreg(idx_v))
	var (b4, ch_v) = builder_new_vreg(b3)
	b4 = emit_intrinsic(b4, MIR_INTR_BUILTIN, mir_opnd_vreg(ch_v), mir_opnd_imm(5))
	var (b5, is_zero) = builder_new_vreg(b4)
	b5 = builder_add_instr(b5, mir_instr_new(MirOp.CmpEq, mir_opnd_vreg(is_zero), mir_opnd_vreg(ch_v), mir_opnd_imm(0)))
	b5 = emit_jump_if(b5, mir_opnd_vreg(is_zero), end_id, body_id)
	b5 = builder_set_current_block(b5, body_id)
	var (b6, mul_v) = builder_new_vreg(b5)
	b6 = builder_add_instr(b6, mir_instr_new(MirOp.Mul, mir_opnd_vreg(mul_v), mir_opnd_vreg(h_v), mir_opnd_imm(33)))
	var (b7, add_v) = builder_new_vreg(b6)
	b7 = builder_add_instr(b7, mir_instr_new(MirOp.Add, mir_opnd_vreg(add_v), mir_opnd_vreg(mul_v), mir_opnd_vreg(ch_v)))
	b7 = emit_move(b7, h_v, mir_opnd_vreg(add_v))
	var (b8, next_idx) = builder_new_vreg(b7)
	b8 = builder_add_instr(b8, mir_instr_new(MirOp.Add, mir_opnd_vreg(next_idx), mir_opnd_vreg(idx_v), mir_opnd_imm(1)))
	b8 = emit_move(b8, idx_v, mir_opnd_vreg(next_idx))
	b8 = emit_jump(b8, cond_id)
	b8 = builder_set_current_block(b8, end_id)
	out expr_result(b8, mir_opnd_vreg(h_v))
end.

func lower_dict_literal(b: MirBuilder, expr: &AstNode):
	n = ast_node_child_count(expr) / 2
	var cap = 16
	when (cap * 3) < (n * 4 + 4) loop
		cap = cap * 2
	end
	b_mut = emit_set_arg(b, 0, mir_opnd_imm(32))
	var (b_base, base) = builder_new_vreg(b_mut)
	b_base = emit_intrinsic(b_base, MIR_INTR_BUILTIN, mir_opnd_vreg(base), mir_opnd_imm(3))

	var b_bkt_alloc = emit_set_arg(b_base, 0, mir_opnd_imm(cap * 24))
	var (b_bkt, bkt_ptr) = builder_new_vreg(b_bkt_alloc)
	b_bkt = emit_intrinsic(b_bkt, MIR_INTR_BUILTIN, mir_opnd_vreg(bkt_ptr), mir_opnd_imm(3))

	b_bkt = emit_store(b_bkt, mir_opnd_vreg(base), mir_opnd_imm(0))
	var (b_caddr, cap_addr) = builder_new_vreg(b_bkt)
	b_caddr = builder_add_instr(b_caddr, mir_instr_new(MirOp.Add, mir_opnd_vreg(cap_addr), mir_opnd_vreg(base), mir_opnd_imm(8)))
	b_caddr = emit_store(b_caddr, mir_opnd_vreg(cap_addr), mir_opnd_imm(cap))
	var (b_oaddr, occ_addr) = builder_new_vreg(b_caddr)
	b_oaddr = builder_add_instr(b_oaddr, mir_instr_new(MirOp.Add, mir_opnd_vreg(occ_addr), mir_opnd_vreg(base), mir_opnd_imm(16)))
	b_oaddr = emit_store(b_oaddr, mir_opnd_vreg(occ_addr), mir_opnd_imm(0))
	var (b_baddr, bkt_haddr) = builder_new_vreg(b_oaddr)
	b_baddr = builder_add_instr(b_baddr, mir_instr_new(MirOp.Add, mir_opnd_vreg(bkt_haddr), mir_opnd_vreg(base), mir_opnd_imm(24)))
	b_baddr = emit_store(b_baddr, mir_opnd_vreg(bkt_haddr), mir_opnd_vreg(bkt_ptr))

	var (b_init_i, init_i_v) = builder_new_vreg(b_baddr)
	b_init_i = emit_move(b_init_i, init_i_v, mir_opnd_imm(0))
	var (b_icond, icond_id) = builder_add_block(b_init_i)
	var (b_ibody, ibody_id) = builder_add_block(b_icond)
	var (b_iend, iend_id) = builder_add_block(b_ibody)
	b_iend = emit_jump(b_iend, icond_id)
	b_iend = builder_set_current_block(b_iend, icond_id)
	var (b_icmp, icmp_v) = builder_new_vreg(b_iend)
	b_icmp = builder_add_instr(b_icmp, mir_instr_new(MirOp.CmpLt, mir_opnd_vreg(icmp_v), mir_opnd_vreg(init_i_v), mir_opnd_imm(cap)))
	b_icmp = emit_jump_if_not(b_icmp, mir_opnd_vreg(icmp_v), iend_id, ibody_id)
	b_icmp = builder_set_current_block(b_icmp, ibody_id)
	var (b_ioff, ioff_v) = builder_new_vreg(b_icmp)
	b_ioff = builder_add_instr(b_ioff, mir_instr_new(MirOp.Mul, mir_opnd_vreg(ioff_v), mir_opnd_vreg(init_i_v), mir_opnd_imm(24)))
	var (b_isaddr0, isaddr0_v) = builder_new_vreg(b_ioff)
	b_isaddr0 = builder_add_instr(b_isaddr0, mir_instr_new(MirOp.Add, mir_opnd_vreg(isaddr0_v), mir_opnd_vreg(bkt_ptr), mir_opnd_vreg(ioff_v)))
	var (b_isaddr, isaddr_v) = builder_new_vreg(b_isaddr0)
	b_isaddr = builder_add_instr(b_isaddr, mir_instr_new(MirOp.Add, mir_opnd_vreg(isaddr_v), mir_opnd_vreg(isaddr0_v), mir_opnd_imm(16)))
	b_isaddr = emit_store(b_isaddr, mir_opnd_vreg(isaddr_v), mir_opnd_imm(0))
	var (b_inext, inext_v) = builder_new_vreg(b_isaddr)
	b_inext = builder_add_instr(b_inext, mir_instr_new(MirOp.Add, mir_opnd_vreg(inext_v), mir_opnd_vreg(init_i_v), mir_opnd_imm(1)))
	b_inext = emit_move(b_inext, init_i_v, mir_opnd_vreg(inext_v))
	b_inext = emit_jump(b_inext, icond_id)
	b_inext = builder_set_current_block(b_inext, iend_id)

	var cur_b = b_inext
	var i = 0
	when i < n loop
		var key_node = ast_node_child(expr, i * 2)
		var b_key = lower_expr(cur_b, key_node)
		var kop = g_lower_expr_result_opnd as MirOperand
		var b_val = lower_expr(b_key, ast_node_child(expr, i * 2 + 1))
		var vop = g_lower_expr_result_opnd as MirOperand
		cur_b = lower_dict_store(b_val, mir_opnd_vreg(base), kop, vop, dict_key_is_string(key_node))
		i = i + 1
	end
	out expr_result(cur_b, mir_opnd_vreg(base))
end.

func lower_dict_index(b: MirBuilder, base: &MirOperand, key: &MirOperand, key_is_string: int):
	var (b_cap_addr, cap_addr) = builder_new_vreg(b)
	b_cap_addr = builder_add_instr(b_cap_addr, mir_instr_new(MirOp.Add, mir_opnd_vreg(cap_addr), base, mir_opnd_imm(8)))
	var (b_cap, cap_v) = builder_new_vreg(b_cap_addr)
	b_cap = emit_load(b_cap, cap_v, mir_opnd_vreg(cap_addr))
	var (b_bkt_addr, bkt_addr) = builder_new_vreg(b_cap)
	b_bkt_addr = builder_add_instr(b_bkt_addr, mir_instr_new(MirOp.Add, mir_opnd_vreg(bkt_addr), base, mir_opnd_imm(24)))
	var (b_bkt, bkt_v) = builder_new_vreg(b_bkt_addr)
	b_bkt = emit_load(b_bkt, bkt_v, mir_opnd_vreg(bkt_addr))

	var (b_mask, mask_v) = builder_new_vreg(b_bkt)
	b_mask = builder_add_instr(b_mask, mir_instr_new(MirOp.Sub, mir_opnd_vreg(mask_v), mir_opnd_vreg(cap_v), mir_opnd_imm(1)))

	var b_hash = lower_dict_hash(b_mask, key, key_is_string)
	var h_opnd = g_lower_expr_result_opnd as MirOperand
	var (b_idx, idx_v) = builder_new_vreg(b_hash)
	b_idx = builder_add_instr(b_idx, mir_instr_new(MirOp.And, mir_opnd_vreg(idx_v), h_opnd, mir_opnd_vreg(mask_v)))

	var (b_res, res_v) = builder_new_vreg(b_idx)
	b_res = emit_move(b_res, res_v, mir_opnd_imm(0))
	var (b_cnt, probe_cnt_v) = builder_new_vreg(b_res)
	b_cnt = emit_move(b_cnt, probe_cnt_v, mir_opnd_imm(0))

	var (b1, cond_id) = builder_add_block(b_cnt)
	var (b2, body_id) = builder_add_block(b1)
	var (b3, match_id) = builder_add_block(b2)
	var (b4, step_id) = builder_add_block(b3)
	var (b5, end_id) = builder_add_block(b4)

	b5 = emit_jump(b5, cond_id)
	b5 = builder_set_current_block(b5, cond_id)
	var (b_cmp, cmp_v) = builder_new_vreg(b5)
	b_cmp = builder_add_instr(b_cmp, mir_instr_new(MirOp.CmpLt, mir_opnd_vreg(cmp_v), mir_opnd_vreg(probe_cnt_v), mir_opnd_vreg(cap_v)))
	b_cmp = emit_jump_if_not(b_cmp, mir_opnd_vreg(cmp_v), end_id, body_id)

	b_cmp = builder_set_current_block(b_cmp, body_id)
	var (b_mul, off_v) = builder_new_vreg(b_cmp)
	b_mul = builder_add_instr(b_mul, mir_instr_new(MirOp.Mul, mir_opnd_vreg(off_v), mir_opnd_vreg(idx_v), mir_opnd_imm(24)))
	var (b_sl, slot_addr) = builder_new_vreg(b_mul)
	b_sl = builder_add_instr(b_sl, mir_instr_new(MirOp.Add, mir_opnd_vreg(slot_addr), mir_opnd_vreg(bkt_v), mir_opnd_vreg(off_v)))
	var (b_st_addr, st_addr) = builder_new_vreg(b_sl)
	b_st_addr = builder_add_instr(b_st_addr, mir_instr_new(MirOp.Add, mir_opnd_vreg(st_addr), mir_opnd_vreg(slot_addr), mir_opnd_imm(16)))
	var (b_st, st_v) = builder_new_vreg(b_st_addr)
	b_st = emit_load(b_st, st_v, mir_opnd_vreg(st_addr))

	var (b_is_empty, is_empty_v) = builder_new_vreg(b_st)
	b_is_empty = builder_add_instr(b_is_empty, mir_instr_new(MirOp.CmpEq, mir_opnd_vreg(is_empty_v), mir_opnd_vreg(st_v), mir_opnd_imm(0)))
	var (b_check_occ, check_occ_id) = builder_add_block(b_is_empty)
	b_check_occ = emit_jump_if(b_check_occ, mir_opnd_vreg(is_empty_v), end_id, check_occ_id)

	b_check_occ = builder_set_current_block(b_check_occ, check_occ_id)
	var (b_is_occ, is_occ_v) = builder_new_vreg(b_check_occ)
	b_is_occ = builder_add_instr(b_is_occ, mir_instr_new(MirOp.CmpEq, mir_opnd_vreg(is_occ_v), mir_opnd_vreg(st_v), mir_opnd_imm(1)))
	var (b_key_cmp, key_cmp_id) = builder_add_block(b_is_occ)
	b_key_cmp = emit_jump_if(b_key_cmp, mir_opnd_vreg(is_occ_v), key_cmp_id, step_id)

	b_key_cmp = builder_set_current_block(b_key_cmp, key_cmp_id)
	var (b_sk, stored_key) = builder_new_vreg(b_key_cmp)
	b_sk = emit_load(b_sk, stored_key, mir_opnd_vreg(slot_addr))
	var b_eq = lower_dict_key_equal(b_sk, mir_opnd_vreg(stored_key), key, key_is_string)
	var eq_opnd = g_lower_expr_result_opnd as MirOperand
	b_eq = emit_jump_if(b_eq, eq_opnd, match_id, step_id)

	b_eq = builder_set_current_block(b_eq, match_id)
	var (b_val_addr, val_addr) = builder_new_vreg(b_eq)
	b_val_addr = builder_add_instr(b_val_addr, mir_instr_new(MirOp.Add, mir_opnd_vreg(val_addr), mir_opnd_vreg(slot_addr), mir_opnd_imm(8)))
	var (b_val, val_v) = builder_new_vreg(b_val_addr)
	b_val = emit_load(b_val, val_v, mir_opnd_vreg(val_addr))
	b_val = emit_move(b_val, res_v, mir_opnd_vreg(val_v))
	b_val = emit_jump(b_val, end_id)

	b_val = builder_set_current_block(b_val, step_id)
	var (b_next_idx0, next_idx0) = builder_new_vreg(b_val)
	b_next_idx0 = builder_add_instr(b_next_idx0, mir_instr_new(MirOp.Add, mir_opnd_vreg(next_idx0), mir_opnd_vreg(idx_v), mir_opnd_imm(1)))
	var (b_next_idx, next_idx) = builder_new_vreg(b_next_idx0)
	b_next_idx = builder_add_instr(b_next_idx, mir_instr_new(MirOp.And, mir_opnd_vreg(next_idx), mir_opnd_vreg(next_idx0), mir_opnd_vreg(mask_v)))
	b_next_idx = emit_move(b_next_idx, idx_v, mir_opnd_vreg(next_idx))
	var (b_next_cnt, next_cnt) = builder_new_vreg(b_next_idx)
	b_next_cnt = builder_add_instr(b_next_cnt, mir_instr_new(MirOp.Add, mir_opnd_vreg(next_cnt), mir_opnd_vreg(probe_cnt_v), mir_opnd_imm(1)))
	b_next_cnt = emit_move(b_next_cnt, probe_cnt_v, mir_opnd_vreg(next_cnt))
	b_next_cnt = emit_jump(b_next_cnt, cond_id)

	b_next_cnt = builder_set_current_block(b_next_cnt, end_id)
	out expr_result(b_next_cnt, mir_opnd_vreg(res_v))
end.

func lower_dict_contains(b: MirBuilder, base: &MirOperand, key: &MirOperand, key_is_string: int):
	var (b_cap_addr, cap_addr) = builder_new_vreg(b)
	b_cap_addr = builder_add_instr(b_cap_addr, mir_instr_new(MirOp.Add, mir_opnd_vreg(cap_addr), base, mir_opnd_imm(8)))
	var (b_cap, cap_v) = builder_new_vreg(b_cap_addr)
	b_cap = emit_load(b_cap, cap_v, mir_opnd_vreg(cap_addr))
	var (b_bkt_addr, bkt_addr) = builder_new_vreg(b_cap)
	b_bkt_addr = builder_add_instr(b_bkt_addr, mir_instr_new(MirOp.Add, mir_opnd_vreg(bkt_addr), base, mir_opnd_imm(24)))
	var (b_bkt, bkt_v) = builder_new_vreg(b_bkt_addr)
	b_bkt = emit_load(b_bkt, bkt_v, mir_opnd_vreg(bkt_addr))

	var (b_mask, mask_v) = builder_new_vreg(b_bkt)
	b_mask = builder_add_instr(b_mask, mir_instr_new(MirOp.Sub, mir_opnd_vreg(mask_v), mir_opnd_vreg(cap_v), mir_opnd_imm(1)))

	var b_hash = lower_dict_hash(b_mask, key, key_is_string)
	var h_opnd = g_lower_expr_result_opnd as MirOperand
	var (b_idx, idx_v) = builder_new_vreg(b_hash)
	b_idx = builder_add_instr(b_idx, mir_instr_new(MirOp.And, mir_opnd_vreg(idx_v), h_opnd, mir_opnd_vreg(mask_v)))

	var (b_res, res_v) = builder_new_vreg(b_idx)
	b_res = emit_move(b_res, res_v, mir_opnd_imm(0))
	var (b_cnt, probe_cnt_v) = builder_new_vreg(b_res)
	b_cnt = emit_move(b_cnt, probe_cnt_v, mir_opnd_imm(0))

	var (b1, cond_id) = builder_add_block(b_cnt)
	var (b2, body_id) = builder_add_block(b1)
	var (b3, match_id) = builder_add_block(b2)
	var (b4, step_id) = builder_add_block(b3)
	var (b5, end_id) = builder_add_block(b4)

	b5 = emit_jump(b5, cond_id)
	b5 = builder_set_current_block(b5, cond_id)
	var (b_cmp, cmp_v) = builder_new_vreg(b5)
	b_cmp = builder_add_instr(b_cmp, mir_instr_new(MirOp.CmpLt, mir_opnd_vreg(cmp_v), mir_opnd_vreg(probe_cnt_v), mir_opnd_vreg(cap_v)))
	b_cmp = emit_jump_if_not(b_cmp, mir_opnd_vreg(cmp_v), end_id, body_id)

	b_cmp = builder_set_current_block(b_cmp, body_id)
	var (b_mul, off_v) = builder_new_vreg(b_cmp)
	b_mul = builder_add_instr(b_mul, mir_instr_new(MirOp.Mul, mir_opnd_vreg(off_v), mir_opnd_vreg(idx_v), mir_opnd_imm(24)))
	var (b_sl, slot_addr) = builder_new_vreg(b_mul)
	b_sl = builder_add_instr(b_sl, mir_instr_new(MirOp.Add, mir_opnd_vreg(slot_addr), mir_opnd_vreg(bkt_v), mir_opnd_vreg(off_v)))
	var (b_st_addr, st_addr) = builder_new_vreg(b_sl)
	b_st_addr = builder_add_instr(b_st_addr, mir_instr_new(MirOp.Add, mir_opnd_vreg(st_addr), mir_opnd_vreg(slot_addr), mir_opnd_imm(16)))
	var (b_st, st_v) = builder_new_vreg(b_st_addr)
	b_st = emit_load(b_st, st_v, mir_opnd_vreg(st_addr))

	var (b_is_empty, is_empty_v) = builder_new_vreg(b_st)
	b_is_empty = builder_add_instr(b_is_empty, mir_instr_new(MirOp.CmpEq, mir_opnd_vreg(is_empty_v), mir_opnd_vreg(st_v), mir_opnd_imm(0)))
	var (b_check_occ, check_occ_id) = builder_add_block(b_is_empty)
	b_check_occ = emit_jump_if(b_check_occ, mir_opnd_vreg(is_empty_v), end_id, check_occ_id)

	b_check_occ = builder_set_current_block(b_check_occ, check_occ_id)
	var (b_is_occ, is_occ_v) = builder_new_vreg(b_check_occ)
	b_is_occ = builder_add_instr(b_is_occ, mir_instr_new(MirOp.CmpEq, mir_opnd_vreg(is_occ_v), mir_opnd_vreg(st_v), mir_opnd_imm(1)))
	var (b_key_cmp, key_cmp_id) = builder_add_block(b_is_occ)
	b_key_cmp = emit_jump_if(b_key_cmp, mir_opnd_vreg(is_occ_v), key_cmp_id, step_id)

	b_key_cmp = builder_set_current_block(b_key_cmp, key_cmp_id)
	var (b_sk, stored_key) = builder_new_vreg(b_key_cmp)
	b_sk = emit_load(b_sk, stored_key, mir_opnd_vreg(slot_addr))
	var b_eq = lower_dict_key_equal(b_sk, mir_opnd_vreg(stored_key), key, key_is_string)
	var eq_opnd = g_lower_expr_result_opnd as MirOperand
	b_eq = emit_jump_if(b_eq, eq_opnd, match_id, step_id)

	b_eq = builder_set_current_block(b_eq, match_id)
	var b_val = emit_move(b_eq, res_v, mir_opnd_imm(1))
	b_val = emit_jump(b_val, end_id)

	b_val = builder_set_current_block(b_val, step_id)
	var (b_next_idx0, next_idx0) = builder_new_vreg(b_val)
	b_next_idx0 = builder_add_instr(b_next_idx0, mir_instr_new(MirOp.Add, mir_opnd_vreg(next_idx0), mir_opnd_vreg(idx_v), mir_opnd_imm(1)))
	var (b_next_idx, next_idx) = builder_new_vreg(b_next_idx0)
	b_next_idx = builder_add_instr(b_next_idx, mir_instr_new(MirOp.And, mir_opnd_vreg(next_idx), mir_opnd_vreg(next_idx0), mir_opnd_vreg(mask_v)))
	b_next_idx = emit_move(b_next_idx, idx_v, mir_opnd_vreg(next_idx))
	var (b_next_cnt, next_cnt) = builder_new_vreg(b_next_idx)
	b_next_cnt = builder_add_instr(b_next_cnt, mir_instr_new(MirOp.Add, mir_opnd_vreg(next_cnt), mir_opnd_vreg(probe_cnt_v), mir_opnd_imm(1)))
	b_next_cnt = emit_move(b_next_cnt, probe_cnt_v, mir_opnd_vreg(next_cnt))
	b_next_cnt = emit_jump(b_next_cnt, cond_id)

	b_next_cnt = builder_set_current_block(b_next_cnt, end_id)
	out expr_result(b_next_cnt, mir_opnd_vreg(res_v))
end.

func lower_dict_delete(b: MirBuilder, base: &MirOperand, key: &MirOperand, key_is_string: int):
	var (b_cnt_ld, count_v) = builder_new_vreg(b)
	b_cnt_ld = emit_load(b_cnt_ld, count_v, base)
	var (b_cap_addr, cap_addr) = builder_new_vreg(b_cnt_ld)
	b_cap_addr = builder_add_instr(b_cap_addr, mir_instr_new(MirOp.Add, mir_opnd_vreg(cap_addr), base, mir_opnd_imm(8)))
	var (b_cap, cap_v) = builder_new_vreg(b_cap_addr)
	b_cap = emit_load(b_cap, cap_v, mir_opnd_vreg(cap_addr))
	var (b_bkt_addr, bkt_addr) = builder_new_vreg(b_cap)
	b_bkt_addr = builder_add_instr(b_bkt_addr, mir_instr_new(MirOp.Add, mir_opnd_vreg(bkt_addr), base, mir_opnd_imm(24)))
	var (b_bkt, bkt_v) = builder_new_vreg(b_bkt_addr)
	b_bkt = emit_load(b_bkt, bkt_v, mir_opnd_vreg(bkt_addr))

	var (b_mask, mask_v) = builder_new_vreg(b_bkt)
	b_mask = builder_add_instr(b_mask, mir_instr_new(MirOp.Sub, mir_opnd_vreg(mask_v), mir_opnd_vreg(cap_v), mir_opnd_imm(1)))

	var b_hash = lower_dict_hash(b_mask, key, key_is_string)
	var h_opnd = g_lower_expr_result_opnd as MirOperand
	var (b_idx, idx_v) = builder_new_vreg(b_hash)
	b_idx = builder_add_instr(b_idx, mir_instr_new(MirOp.And, mir_opnd_vreg(idx_v), h_opnd, mir_opnd_vreg(mask_v)))

	var (b_cnt, probe_cnt_v) = builder_new_vreg(b_idx)
	b_cnt = emit_move(b_cnt, probe_cnt_v, mir_opnd_imm(0))

	var (b1, cond_id) = builder_add_block(b_cnt)
	var (b2, body_id) = builder_add_block(b1)
	var (b3, match_id) = builder_add_block(b2)
	var (b4, step_id) = builder_add_block(b3)
	var (b5, end_id) = builder_add_block(b4)

	b5 = emit_jump(b5, cond_id)
	b5 = builder_set_current_block(b5, cond_id)
	var (b_cmp, cmp_v) = builder_new_vreg(b5)
	b_cmp = builder_add_instr(b_cmp, mir_instr_new(MirOp.CmpLt, mir_opnd_vreg(cmp_v), mir_opnd_vreg(probe_cnt_v), mir_opnd_vreg(cap_v)))
	b_cmp = emit_jump_if_not(b_cmp, mir_opnd_vreg(cmp_v), end_id, body_id)

	b_cmp = builder_set_current_block(b_cmp, body_id)
	var (b_mul, off_v) = builder_new_vreg(b_cmp)
	b_mul = builder_add_instr(b_mul, mir_instr_new(MirOp.Mul, mir_opnd_vreg(off_v), mir_opnd_vreg(idx_v), mir_opnd_imm(24)))
	var (b_sl, slot_addr) = builder_new_vreg(b_mul)
	b_sl = builder_add_instr(b_sl, mir_instr_new(MirOp.Add, mir_opnd_vreg(slot_addr), mir_opnd_vreg(bkt_v), mir_opnd_vreg(off_v)))
	var (b_st_addr, st_addr) = builder_new_vreg(b_sl)
	b_st_addr = builder_add_instr(b_st_addr, mir_instr_new(MirOp.Add, mir_opnd_vreg(st_addr), mir_opnd_vreg(slot_addr), mir_opnd_imm(16)))
	var (b_st, st_v) = builder_new_vreg(b_st_addr)
	b_st = emit_load(b_st, st_v, mir_opnd_vreg(st_addr))

	var (b_is_empty, is_empty_v) = builder_new_vreg(b_st)
	b_is_empty = builder_add_instr(b_is_empty, mir_instr_new(MirOp.CmpEq, mir_opnd_vreg(is_empty_v), mir_opnd_vreg(st_v), mir_opnd_imm(0)))
	var (b_check_occ, check_occ_id) = builder_add_block(b_is_empty)
	b_check_occ = emit_jump_if(b_check_occ, mir_opnd_vreg(is_empty_v), end_id, check_occ_id)

	b_check_occ = builder_set_current_block(b_check_occ, check_occ_id)
	var (b_is_occ, is_occ_v) = builder_new_vreg(b_check_occ)
	b_is_occ = builder_add_instr(b_is_occ, mir_instr_new(MirOp.CmpEq, mir_opnd_vreg(is_occ_v), mir_opnd_vreg(st_v), mir_opnd_imm(1)))
	var (b_key_cmp, key_cmp_id) = builder_add_block(b_is_occ)
	b_key_cmp = emit_jump_if(b_key_cmp, mir_opnd_vreg(is_occ_v), key_cmp_id, step_id)

	b_key_cmp = builder_set_current_block(b_key_cmp, key_cmp_id)
	var (b_sk, stored_key) = builder_new_vreg(b_key_cmp)
	b_sk = emit_load(b_sk, stored_key, mir_opnd_vreg(slot_addr))
	var b_eq = lower_dict_key_equal(b_sk, mir_opnd_vreg(stored_key), key, key_is_string)
	var eq_opnd = g_lower_expr_result_opnd as MirOperand
	b_eq = emit_jump_if(b_eq, eq_opnd, match_id, step_id)

	b_eq = builder_set_current_block(b_eq, match_id)
	var b_del = emit_store(b_eq, mir_opnd_vreg(st_addr), mir_opnd_imm(2))
	var (b_dec, new_count) = builder_new_vreg(b_del)
	b_dec = builder_add_instr(b_dec, mir_instr_new(MirOp.Sub, mir_opnd_vreg(new_count), mir_opnd_vreg(count_v), mir_opnd_imm(1)))
	b_dec = emit_store(b_dec, base, mir_opnd_vreg(new_count))
	b_dec = emit_jump(b_dec, end_id)

	b_dec = builder_set_current_block(b_dec, step_id)
	var (b_next_idx0, next_idx0) = builder_new_vreg(b_dec)
	b_next_idx0 = builder_add_instr(b_next_idx0, mir_instr_new(MirOp.Add, mir_opnd_vreg(next_idx0), mir_opnd_vreg(idx_v), mir_opnd_imm(1)))
	var (b_next_idx, next_idx) = builder_new_vreg(b_next_idx0)
	b_next_idx = builder_add_instr(b_next_idx, mir_instr_new(MirOp.And, mir_opnd_vreg(next_idx), mir_opnd_vreg(next_idx0), mir_opnd_vreg(mask_v)))
	b_next_idx = emit_move(b_next_idx, idx_v, mir_opnd_vreg(next_idx))
	var (b_next_cnt, next_cnt) = builder_new_vreg(b_next_idx)
	b_next_cnt = builder_add_instr(b_next_cnt, mir_instr_new(MirOp.Add, mir_opnd_vreg(next_cnt), mir_opnd_vreg(probe_cnt_v), mir_opnd_imm(1)))
	b_next_cnt = emit_move(b_next_cnt, probe_cnt_v, mir_opnd_vreg(next_cnt))
	b_next_cnt = emit_jump(b_next_cnt, cond_id)

	b_next_cnt = builder_set_current_block(b_next_cnt, end_id)
	out b_next_cnt
end.

func lower_dict_store(b: MirBuilder, base: &MirOperand, key: &MirOperand, val: &MirOperand, key_is_string: int):
	var (b_cnt, count_v) = builder_new_vreg(b)
	b_cnt = emit_load(b_cnt, count_v, base)
	var (b_cap_addr, cap_addr) = builder_new_vreg(b_cnt)
	b_cap_addr = builder_add_instr(b_cap_addr, mir_instr_new(MirOp.Add, mir_opnd_vreg(cap_addr), base, mir_opnd_imm(8)))
	var (b_cap, cap_v) = builder_new_vreg(b_cap_addr)
	b_cap = emit_load(b_cap, cap_v, mir_opnd_vreg(cap_addr))
	var (b_occ_addr, occ_addr) = builder_new_vreg(b_cap)
	b_occ_addr = builder_add_instr(b_occ_addr, mir_instr_new(MirOp.Add, mir_opnd_vreg(occ_addr), base, mir_opnd_imm(16)))
	var (b_occ, occ_v) = builder_new_vreg(b_occ_addr)
	b_occ = emit_load(b_occ, occ_v, mir_opnd_vreg(occ_addr))
	var (b_bkt_addr, bkt_addr) = builder_new_vreg(b_occ)
	b_bkt_addr = builder_add_instr(b_bkt_addr, mir_instr_new(MirOp.Add, mir_opnd_vreg(bkt_addr), base, mir_opnd_imm(24)))
	var (b_bkt, bkt_v) = builder_new_vreg(b_bkt_addr)
	b_bkt = emit_load(b_bkt, bkt_v, mir_opnd_vreg(bkt_addr))

	var (b_occ4, occ4_v) = builder_new_vreg(b_bkt)
	b_occ4 = builder_add_instr(b_occ4, mir_instr_new(MirOp.Mul, mir_opnd_vreg(occ4_v), mir_opnd_vreg(occ_v), mir_opnd_imm(4)))
	var (b_cap3, cap3_v) = builder_new_vreg(b_occ4)
	b_cap3 = builder_add_instr(b_cap3, mir_instr_new(MirOp.Mul, mir_opnd_vreg(cap3_v), mir_opnd_vreg(cap_v), mir_opnd_imm(3)))
	var (b_need_grow, need_grow_v) = builder_new_vreg(b_cap3)
	b_need_grow = builder_add_instr(b_need_grow, mir_instr_new(MirOp.CmpGe, mir_opnd_vreg(need_grow_v), mir_opnd_vreg(occ4_v), mir_opnd_vreg(cap3_v)))

	var (b_grow_block, grow_do_id) = builder_add_block(b_need_grow)
	var (b_done_grow, grow_done_id) = builder_add_block(b_grow_block)
	b_done_grow = emit_jump_if(b_done_grow, mir_opnd_vreg(need_grow_v), grow_do_id, grow_done_id)

	b_done_grow = builder_set_current_block(b_done_grow, grow_do_id)
	var (b_ncap, new_cap_v) = builder_new_vreg(b_done_grow)
	b_ncap = builder_add_instr(b_ncap, mir_instr_new(MirOp.Mul, mir_opnd_vreg(new_cap_v), mir_opnd_vreg(cap_v), mir_opnd_imm(2)))
	var (b_nbkt_sz, new_bkt_sz) = builder_new_vreg(b_ncap)
	b_nbkt_sz = builder_add_instr(b_nbkt_sz, mir_instr_new(MirOp.Mul, mir_opnd_vreg(new_bkt_sz), mir_opnd_vreg(new_cap_v), mir_opnd_imm(24)))
	b_nbkt_sz = emit_set_arg(b_nbkt_sz, 0, mir_opnd_vreg(new_bkt_sz))
	var (b_nbkt_alloc, new_bkt_v) = builder_new_vreg(b_nbkt_sz)
	b_nbkt_alloc = emit_intrinsic(b_nbkt_alloc, MIR_INTR_BUILTIN, mir_opnd_vreg(new_bkt_v), mir_opnd_imm(3))

	var (b_zi, zero_i_v) = builder_new_vreg(b_nbkt_alloc)
	b_zi = emit_move(b_zi, zero_i_v, mir_opnd_imm(0))
	var (b_zcond, zcond_id) = builder_add_block(b_zi)
	var (b_zbody, zbody_id) = builder_add_block(b_zcond)
	var (b_zend, zend_id) = builder_add_block(b_zbody)
	b_zend = emit_jump(b_zend, zcond_id)
	b_zend = builder_set_current_block(b_zend, zcond_id)
	var (b_zcmp, zcmp_v) = builder_new_vreg(b_zend)
	b_zcmp = builder_add_instr(b_zcmp, mir_instr_new(MirOp.CmpLt, mir_opnd_vreg(zcmp_v), mir_opnd_vreg(zero_i_v), mir_opnd_vreg(new_cap_v)))
	b_zcmp = emit_jump_if_not(b_zcmp, mir_opnd_vreg(zcmp_v), zend_id, zbody_id)
	b_zcmp = builder_set_current_block(b_zcmp, zbody_id)
	var (b_zoff, zoff_v) = builder_new_vreg(b_zcmp)
	b_zoff = builder_add_instr(b_zoff, mir_instr_new(MirOp.Mul, mir_opnd_vreg(zoff_v), mir_opnd_vreg(zero_i_v), mir_opnd_imm(24)))
	var (b_zs0, zs0_v) = builder_new_vreg(b_zoff)
	b_zs0 = builder_add_instr(b_zs0, mir_instr_new(MirOp.Add, mir_opnd_vreg(zs0_v), mir_opnd_vreg(new_bkt_v), mir_opnd_vreg(zoff_v)))
	var (b_zs, zs_v) = builder_new_vreg(b_zs0)
	b_zs = builder_add_instr(b_zs, mir_instr_new(MirOp.Add, mir_opnd_vreg(zs_v), mir_opnd_vreg(zs0_v), mir_opnd_imm(16)))
	b_zs = emit_store(b_zs, mir_opnd_vreg(zs_v), mir_opnd_imm(0))
	var (b_znext, znext_v) = builder_new_vreg(b_zs)
	b_znext = builder_add_instr(b_znext, mir_instr_new(MirOp.Add, mir_opnd_vreg(znext_v), mir_opnd_vreg(zero_i_v), mir_opnd_imm(1)))
	b_znext = emit_move(b_znext, zero_i_v, mir_opnd_vreg(znext_v))
	b_znext = emit_jump(b_znext, zcond_id)
	b_znext = builder_set_current_block(b_znext, zend_id)

	var (b_ri, re_i_v) = builder_new_vreg(b_znext)
	b_ri = emit_move(b_ri, re_i_v, mir_opnd_imm(0))
	var (b_nmask, new_mask_v) = builder_new_vreg(b_ri)
	b_nmask = builder_add_instr(b_nmask, mir_instr_new(MirOp.Sub, mir_opnd_vreg(new_mask_v), mir_opnd_vreg(new_cap_v), mir_opnd_imm(1)))

	var (b_rcond, rcond_id) = builder_add_block(b_nmask)
	var (b_rbody, rbody_id) = builder_add_block(b_rcond)
	var (b_rstep, rstep_id) = builder_add_block(b_rbody)
	var (b_rend, rend_id) = builder_add_block(b_rstep)

	b_rend = emit_jump(b_rend, rcond_id)
	b_rend = builder_set_current_block(b_rend, rcond_id)
	var (b_rcmp, rcmp_v) = builder_new_vreg(b_rend)
	b_rcmp = builder_add_instr(b_rcmp, mir_instr_new(MirOp.CmpLt, mir_opnd_vreg(rcmp_v), mir_opnd_vreg(re_i_v), mir_opnd_vreg(cap_v)))
	b_rcmp = emit_jump_if_not(b_rcmp, mir_opnd_vreg(rcmp_v), rend_id, rbody_id)

	b_rcmp = builder_set_current_block(b_rcmp, rbody_id)
	var (b_roff, roff_v) = builder_new_vreg(b_rcmp)
	b_roff = builder_add_instr(b_roff, mir_instr_new(MirOp.Mul, mir_opnd_vreg(roff_v), mir_opnd_vreg(re_i_v), mir_opnd_imm(24)))
	var (b_rslot, rslot_v) = builder_new_vreg(b_roff)
	b_rslot = builder_add_instr(b_rslot, mir_instr_new(MirOp.Add, mir_opnd_vreg(rslot_v), mir_opnd_vreg(bkt_v), mir_opnd_vreg(roff_v)))
	var (b_rst_addr, rst_addr) = builder_new_vreg(b_rslot)
	b_rst_addr = builder_add_instr(b_rst_addr, mir_instr_new(MirOp.Add, mir_opnd_vreg(rst_addr), mir_opnd_vreg(rslot_v), mir_opnd_imm(16)))
	var (b_rst, rst_v) = builder_new_vreg(b_rst_addr)
	b_rst = emit_load(b_rst, rst_v, mir_opnd_vreg(rst_addr))
	var (b_rocc, rocc_v) = builder_new_vreg(b_rst)
	b_rocc = builder_add_instr(b_rocc, mir_instr_new(MirOp.CmpEq, mir_opnd_vreg(rocc_v), mir_opnd_vreg(rst_v), mir_opnd_imm(1)))

	var (b_reinsert, reinsert_id) = builder_add_block(b_rocc)
	b_reinsert = emit_jump_if(b_reinsert, mir_opnd_vreg(rocc_v), reinsert_id, rstep_id)
	b_reinsert = builder_set_current_block(b_reinsert, reinsert_id)

	var (b_rk, rk_v) = builder_new_vreg(b_reinsert)
	b_rk = emit_load(b_rk, rk_v, mir_opnd_vreg(rslot_v))
	var (b_rv_addr, rv_addr) = builder_new_vreg(b_rk)
	b_rv_addr = builder_add_instr(b_rv_addr, mir_instr_new(MirOp.Add, mir_opnd_vreg(rv_addr), mir_opnd_vreg(rslot_v), mir_opnd_imm(8)))
	var (b_rv, rv_v) = builder_new_vreg(b_rv_addr)
	b_rv = emit_load(b_rv, rv_v, mir_opnd_vreg(rv_addr))

	var b_rhash = lower_dict_hash(b_rv, mir_opnd_vreg(rk_v), key_is_string)
	var rh_opnd = g_lower_expr_result_opnd as MirOperand
	var (b_ridx, ridx_v) = builder_new_vreg(b_rhash)
	b_ridx = builder_add_instr(b_ridx, mir_instr_new(MirOp.And, mir_opnd_vreg(ridx_v), rh_opnd, mir_opnd_vreg(new_mask_v)))

	var (b_rpcond, rpcond_id) = builder_add_block(b_ridx)
	var (b_rpbody, rpbody_id) = builder_add_block(b_rpcond)
	var (b_rpstep, rpstep_id) = builder_add_block(b_rpbody)

	b_rpstep = emit_jump(b_rpstep, rpcond_id)
	b_rpstep = builder_set_current_block(b_rpstep, rpcond_id)
	var (b_rpsl_off, rpsl_off) = builder_new_vreg(b_rpstep)
	b_rpsl_off = builder_add_instr(b_rpsl_off, mir_instr_new(MirOp.Mul, mir_opnd_vreg(rpsl_off), mir_opnd_vreg(ridx_v), mir_opnd_imm(24)))
	var (b_rpsl, rpsl_v) = builder_new_vreg(b_rpsl_off)
	b_rpsl = builder_add_instr(b_rpsl, mir_instr_new(MirOp.Add, mir_opnd_vreg(rpsl_v), mir_opnd_vreg(new_bkt_v), mir_opnd_vreg(rpsl_off)))
	var (b_rpst_addr, rpst_addr) = builder_new_vreg(b_rpsl)
	b_rpst_addr = builder_add_instr(b_rpst_addr, mir_instr_new(MirOp.Add, mir_opnd_vreg(rpst_addr), mir_opnd_vreg(rpsl_v), mir_opnd_imm(16)))
	var (b_rpst, rpst_v) = builder_new_vreg(b_rpst_addr)
	b_rpst = emit_load(b_rpst, rpst_v, mir_opnd_vreg(rpst_addr))
	var (b_rpempty, rpempty_v) = builder_new_vreg(b_rpst)
	b_rpempty = builder_add_instr(b_rpempty, mir_instr_new(MirOp.CmpEq, mir_opnd_vreg(rpempty_v), mir_opnd_vreg(rpst_v), mir_opnd_imm(0)))
	b_rpempty = emit_jump_if(b_rpempty, mir_opnd_vreg(rpempty_v), rpbody_id, rpstep_id)

	b_rpempty = builder_set_current_block(b_rpempty, rpbody_id)
	var b_put = emit_store(b_rpempty, mir_opnd_vreg(rpsl_v), mir_opnd_vreg(rk_v))
	var (b_put_va, put_va) = builder_new_vreg(b_put)
	b_put_va = builder_add_instr(b_put_va, mir_instr_new(MirOp.Add, mir_opnd_vreg(put_va), mir_opnd_vreg(rpsl_v), mir_opnd_imm(8)))
	b_put_va = emit_store(b_put_va, mir_opnd_vreg(put_va), mir_opnd_vreg(rv_v))
	b_put_va = emit_store(b_put_va, mir_opnd_vreg(rpst_addr), mir_opnd_imm(1))
	b_put_va = emit_jump(b_put_va, rstep_id)

	b_put_va = builder_set_current_block(b_put_va, rpstep_id)
	var (b_rnext0, rnext0_v) = builder_new_vreg(b_put_va)
	b_rnext0 = builder_add_instr(b_rnext0, mir_instr_new(MirOp.Add, mir_opnd_vreg(rnext0_v), mir_opnd_vreg(ridx_v), mir_opnd_imm(1)))
	var (b_rnext, rnext_v) = builder_new_vreg(b_rnext0)
	b_rnext = builder_add_instr(b_rnext, mir_instr_new(MirOp.And, mir_opnd_vreg(rnext_v), mir_opnd_vreg(rnext0_v), mir_opnd_vreg(new_mask_v)))
	b_rnext = emit_move(b_rnext, ridx_v, mir_opnd_vreg(rnext_v))
	b_rnext = emit_jump(b_rnext, rpcond_id)

	b_rnext = builder_set_current_block(b_rnext, rstep_id)
	var (b_rinext, rinext_v) = builder_new_vreg(b_rnext)
	b_rinext = builder_add_instr(b_rinext, mir_instr_new(MirOp.Add, mir_opnd_vreg(rinext_v), mir_opnd_vreg(re_i_v), mir_opnd_imm(1)))
	b_rinext = emit_move(b_rinext, re_i_v, mir_opnd_vreg(rinext_v))
	b_rinext = emit_jump(b_rinext, rcond_id)

	b_rinext = builder_set_current_block(b_rinext, rend_id)
	var b_upd_cap = emit_store(b_rinext, mir_opnd_vreg(cap_addr), mir_opnd_vreg(new_cap_v))
	var b_upd_occ = emit_store(b_upd_cap, mir_opnd_vreg(occ_addr), mir_opnd_vreg(count_v))
	var b_upd_bkt = emit_store(b_upd_occ, mir_opnd_vreg(bkt_addr), mir_opnd_vreg(new_bkt_v))
	b_upd_bkt = emit_jump(b_upd_bkt, grow_done_id)

	b_upd_bkt = builder_set_current_block(b_upd_bkt, grow_done_id)
	var (b_acap, act_cap_v) = builder_new_vreg(b_upd_bkt)
	b_acap = emit_load(b_acap, act_cap_v, mir_opnd_vreg(cap_addr))
	var (b_abkt, act_bkt_v) = builder_new_vreg(b_acap)
	b_abkt = emit_load(b_abkt, act_bkt_v, mir_opnd_vreg(bkt_addr))
	var (b_acnt, act_cnt_v) = builder_new_vreg(b_abkt)
	b_acnt = emit_load(b_acnt, act_cnt_v, base)
	var (b_aocc, act_occ_v) = builder_new_vreg(b_acnt)
	b_aocc = emit_load(b_aocc, act_occ_v, mir_opnd_vreg(occ_addr))

	var (b_amask, act_mask_v) = builder_new_vreg(b_aocc)
	b_amask = builder_add_instr(b_amask, mir_instr_new(MirOp.Sub, mir_opnd_vreg(act_mask_v), mir_opnd_vreg(act_cap_v), mir_opnd_imm(1)))

	var b_hash = lower_dict_hash(b_amask, key, key_is_string)
	var h_opnd = g_lower_expr_result_opnd as MirOperand
	var (b_idx, idx_v) = builder_new_vreg(b_hash)
	b_idx = builder_add_instr(b_idx, mir_instr_new(MirOp.And, mir_opnd_vreg(idx_v), h_opnd, mir_opnd_vreg(act_mask_v)))

	var (b_cnt_pr, probe_cnt_v) = builder_new_vreg(b_idx)
	b_cnt_pr = emit_move(b_cnt_pr, probe_cnt_v, mir_opnd_imm(0))
	var (b_ftb, ftb_v) = builder_new_vreg(b_cnt_pr)
	b_ftb = emit_move(b_ftb, ftb_v, mir_opnd_imm(0 - 1))

	var (bp1, pcond_id) = builder_add_block(b_ftb)
	var (bp2, pbody_id) = builder_add_block(bp1)
	var (bp3, pempty_id) = builder_add_block(bp2)
	var (bp4, pcheck_occ_id) = builder_add_block(bp3)
	var (bp5, pmatch_id) = builder_add_block(bp4)
	var (bp6, ptb_id) = builder_add_block(bp5)
	var (bp7, pstep_id) = builder_add_block(bp6)
	var (bp8, pend_id) = builder_add_block(bp7)

	bp8 = emit_jump(bp8, pcond_id)
	bp8 = builder_set_current_block(bp8, pcond_id)
	var (b_pcmp, pcmp_v) = builder_new_vreg(bp8)
	b_pcmp = builder_add_instr(b_pcmp, mir_instr_new(MirOp.CmpLt, mir_opnd_vreg(pcmp_v), mir_opnd_vreg(probe_cnt_v), mir_opnd_vreg(act_cap_v)))
	b_pcmp = emit_jump_if_not(b_pcmp, mir_opnd_vreg(pcmp_v), pend_id, pbody_id)

	bp8 = builder_set_current_block(b_pcmp, pbody_id)
	var (b_psl_off, psl_off) = builder_new_vreg(bp8)
	b_psl_off = builder_add_instr(b_psl_off, mir_instr_new(MirOp.Mul, mir_opnd_vreg(psl_off), mir_opnd_vreg(idx_v), mir_opnd_imm(24)))
	var (b_psl, psl_v) = builder_new_vreg(b_psl_off)
	b_psl = builder_add_instr(b_psl, mir_instr_new(MirOp.Add, mir_opnd_vreg(psl_v), mir_opnd_vreg(act_bkt_v), mir_opnd_vreg(psl_off)))
	var (b_pst_addr, pst_addr) = builder_new_vreg(b_psl)
	b_pst_addr = builder_add_instr(b_pst_addr, mir_instr_new(MirOp.Add, mir_opnd_vreg(pst_addr), mir_opnd_vreg(psl_v), mir_opnd_imm(16)))
	var (b_pst, pst_v) = builder_new_vreg(b_pst_addr)
	b_pst = emit_load(b_pst, pst_v, mir_opnd_vreg(pst_addr))

	var (b_pempty_cmp, pempty_cmp_v) = builder_new_vreg(b_pst)
	b_pempty_cmp = builder_add_instr(b_pempty_cmp, mir_instr_new(MirOp.CmpEq, mir_opnd_vreg(pempty_cmp_v), mir_opnd_vreg(pst_v), mir_opnd_imm(0)))
	b_pempty_cmp = emit_jump_if(b_pempty_cmp, mir_opnd_vreg(pempty_cmp_v), pempty_id, pcheck_occ_id)

	b_pempty_cmp = builder_set_current_block(b_pempty_cmp, pcheck_occ_id)
	var (b_pocc_cmp, pocc_cmp_v) = builder_new_vreg(b_pempty_cmp)
	b_pocc_cmp = builder_add_instr(b_pocc_cmp, mir_instr_new(MirOp.CmpEq, mir_opnd_vreg(pocc_cmp_v), mir_opnd_vreg(pst_v), mir_opnd_imm(1)))
	var (b_pocc_next, pocc_next_id) = builder_add_block(b_pocc_cmp)
	b_pocc_next = emit_jump_if(b_pocc_next, mir_opnd_vreg(pocc_cmp_v), pocc_next_id, ptb_id)

	b_pocc_next = builder_set_current_block(b_pocc_next, pocc_next_id)
	var (b_psk, pstored_k) = builder_new_vreg(b_pocc_next)
	b_psk = emit_load(b_psk, pstored_k, mir_opnd_vreg(psl_v))
	var b_peq = lower_dict_key_equal(b_psk, mir_opnd_vreg(pstored_k), key, key_is_string)
	var peq_opnd = g_lower_expr_result_opnd as MirOperand
	b_peq = emit_jump_if(b_peq, peq_opnd, pmatch_id, pstep_id)

	b_peq = builder_set_current_block(b_peq, pmatch_id)
	var (b_pvaddr, pvaddr_v) = builder_new_vreg(b_peq)
	b_pvaddr = builder_add_instr(b_pvaddr, mir_instr_new(MirOp.Add, mir_opnd_vreg(pvaddr_v), mir_opnd_vreg(psl_v), mir_opnd_imm(8)))
	b_pvaddr = emit_store(b_pvaddr, mir_opnd_vreg(pvaddr_v), val)
	b_pvaddr = emit_jump(b_pvaddr, pend_id)

	b_pvaddr = builder_set_current_block(b_pvaddr, ptb_id)
	var (b_has_ftb, has_ftb_v) = builder_new_vreg(b_pvaddr)
	b_has_ftb = builder_add_instr(b_has_ftb, mir_instr_new(MirOp.CmpLt, mir_opnd_vreg(has_ftb_v), mir_opnd_vreg(ftb_v), mir_opnd_imm(0)))
	var (b_set_ftb, set_ftb_id) = builder_add_block(b_has_ftb)
	b_set_ftb = emit_jump_if(b_set_ftb, mir_opnd_vreg(has_ftb_v), set_ftb_id, pstep_id)
	b_set_ftb = builder_set_current_block(b_set_ftb, set_ftb_id)
	b_set_ftb = emit_move(b_set_ftb, ftb_v, mir_opnd_vreg(idx_v))
	b_set_ftb = emit_jump(b_set_ftb, pstep_id)

	b_set_ftb = builder_set_current_block(b_set_ftb, pempty_id)
	var (b_reuse_tb, reuse_tb_v) = builder_new_vreg(b_set_ftb)
	b_reuse_tb = builder_add_instr(b_reuse_tb, mir_instr_new(MirOp.CmpGe, mir_opnd_vreg(reuse_tb_v), mir_opnd_vreg(ftb_v), mir_opnd_imm(0)))
	var (b_do_reuse, reuse_id) = builder_add_block(b_reuse_tb)
	var (b_no_reuse, noreuse_id) = builder_add_block(b_do_reuse)
	b_no_reuse = emit_jump_if(b_no_reuse, mir_opnd_vreg(reuse_tb_v), reuse_id, noreuse_id)

	b_no_reuse = builder_set_current_block(b_no_reuse, reuse_id)
	var (b_tboff, tboff_v) = builder_new_vreg(b_no_reuse)
	b_tboff = builder_add_instr(b_tboff, mir_instr_new(MirOp.Mul, mir_opnd_vreg(tboff_v), mir_opnd_vreg(ftb_v), mir_opnd_imm(24)))
	var (b_tbsl, tbsl_v) = builder_new_vreg(b_tboff)
	b_tbsl = builder_add_instr(b_tbsl, mir_instr_new(MirOp.Add, mir_opnd_vreg(tbsl_v), mir_opnd_vreg(act_bkt_v), mir_opnd_vreg(tboff_v)))
	var b_tb_putk = emit_store(b_tbsl, mir_opnd_vreg(tbsl_v), key)
	var (b_tb_vaddr, tb_vaddr_v) = builder_new_vreg(b_tb_putk)
	b_tb_vaddr = builder_add_instr(b_tb_vaddr, mir_instr_new(MirOp.Add, mir_opnd_vreg(tb_vaddr_v), mir_opnd_vreg(tbsl_v), mir_opnd_imm(8)))
	b_tb_vaddr = emit_store(b_tb_vaddr, mir_opnd_vreg(tb_vaddr_v), val)
	var (b_tb_saddr, tb_saddr_v) = builder_new_vreg(b_tb_vaddr)
	b_tb_saddr = builder_add_instr(b_tb_saddr, mir_instr_new(MirOp.Add, mir_opnd_vreg(tb_saddr_v), mir_opnd_vreg(tbsl_v), mir_opnd_imm(16)))
	b_tb_saddr = emit_store(b_tb_saddr, mir_opnd_vreg(tb_saddr_v), mir_opnd_imm(1))
	var (b_tb_cnt_next, tb_cnt_next) = builder_new_vreg(b_tb_saddr)
	b_tb_cnt_next = builder_add_instr(b_tb_cnt_next, mir_instr_new(MirOp.Add, mir_opnd_vreg(tb_cnt_next), mir_opnd_vreg(act_cnt_v), mir_opnd_imm(1)))
	b_tb_cnt_next = emit_store(b_tb_cnt_next, base, mir_opnd_vreg(tb_cnt_next))
	b_tb_cnt_next = emit_jump(b_tb_cnt_next, pend_id)

	b_tb_cnt_next = builder_set_current_block(b_tb_cnt_next, noreuse_id)
	var b_nr_putk = emit_store(b_tb_cnt_next, mir_opnd_vreg(psl_v), key)
	var (b_nr_vaddr, nr_vaddr_v) = builder_new_vreg(b_nr_putk)
	b_nr_vaddr = builder_add_instr(b_nr_vaddr, mir_instr_new(MirOp.Add, mir_opnd_vreg(nr_vaddr_v), mir_opnd_vreg(psl_v), mir_opnd_imm(8)))
	b_nr_vaddr = emit_store(b_nr_vaddr, mir_opnd_vreg(nr_vaddr_v), val)
	b_nr_vaddr = emit_store(b_nr_vaddr, mir_opnd_vreg(pst_addr), mir_opnd_imm(1))
	var (b_nr_cnt_next, nr_cnt_next) = builder_new_vreg(b_nr_vaddr)
	b_nr_cnt_next = builder_add_instr(b_nr_cnt_next, mir_instr_new(MirOp.Add, mir_opnd_vreg(nr_cnt_next), mir_opnd_vreg(act_cnt_v), mir_opnd_imm(1)))
	b_nr_cnt_next = emit_store(b_nr_cnt_next, base, mir_opnd_vreg(nr_cnt_next))
	var (b_nr_occ_next, nr_occ_next) = builder_new_vreg(b_nr_cnt_next)
	b_nr_occ_next = builder_add_instr(b_nr_occ_next, mir_instr_new(MirOp.Add, mir_opnd_vreg(nr_occ_next), mir_opnd_vreg(act_occ_v), mir_opnd_imm(1)))
	b_nr_occ_next = emit_store(b_nr_occ_next, mir_opnd_vreg(occ_addr), mir_opnd_vreg(nr_occ_next))
	b_nr_occ_next = emit_jump(b_nr_occ_next, pend_id)

	b_nr_occ_next = builder_set_current_block(b_nr_occ_next, pstep_id)
	var (b_pnext0, pnext0_v) = builder_new_vreg(b_nr_occ_next)
	b_pnext0 = builder_add_instr(b_pnext0, mir_instr_new(MirOp.Add, mir_opnd_vreg(pnext0_v), mir_opnd_vreg(idx_v), mir_opnd_imm(1)))
	var (b_pnext, pnext_v) = builder_new_vreg(b_pnext0)
	b_pnext = builder_add_instr(b_pnext, mir_instr_new(MirOp.And, mir_opnd_vreg(pnext_v), mir_opnd_vreg(pnext0_v), mir_opnd_vreg(act_mask_v)))
	b_pnext = emit_move(b_pnext, idx_v, mir_opnd_vreg(pnext_v))
	var (b_pcnt_next, pcnt_next) = builder_new_vreg(b_pnext)
	b_pcnt_next = builder_add_instr(b_pcnt_next, mir_instr_new(MirOp.Add, mir_opnd_vreg(pcnt_next), mir_opnd_vreg(probe_cnt_v), mir_opnd_imm(1)))
	b_pcnt_next = emit_move(b_pcnt_next, probe_cnt_v, mir_opnd_vreg(pcnt_next))
	b_pcnt_next = emit_jump(b_pcnt_next, pcond_id)

	b_pcnt_next = builder_set_current_block(b_pcnt_next, pend_id)
	out b_pcnt_next
end.

func lower_dict_extract(b: MirBuilder, base: &MirOperand, extract_values: int):
	var (b_cnt, count_v) = builder_new_vreg(b)
	b_cnt = emit_load(b_cnt, count_v, base)
	var (b_cap_addr, cap_addr) = builder_new_vreg(b_cnt)
	b_cap_addr = builder_add_instr(b_cap_addr, mir_instr_new(MirOp.Add, mir_opnd_vreg(cap_addr), base, mir_opnd_imm(8)))
	var (b_cap, cap_v) = builder_new_vreg(b_cap_addr)
	b_cap = emit_load(b_cap, cap_v, mir_opnd_vreg(cap_addr))
	var (b_bkt_addr, bkt_addr) = builder_new_vreg(b_cap)
	b_bkt_addr = builder_add_instr(b_bkt_addr, mir_instr_new(MirOp.Add, mir_opnd_vreg(bkt_addr), base, mir_opnd_imm(24)))
	var (b_bkt, bkt_v) = builder_new_vreg(b_bkt_addr)
	b_bkt = emit_load(b_bkt, bkt_v, mir_opnd_vreg(bkt_addr))

	var (b_sz_mul, sz_mul) = builder_new_vreg(b_bkt)
	b_sz_mul = builder_add_instr(b_sz_mul, mir_instr_new(MirOp.Mul, mir_opnd_vreg(sz_mul), mir_opnd_vreg(count_v), mir_opnd_imm(8)))
	var (b_sz, alloc_sz) = builder_new_vreg(b_sz_mul)
	b_sz = builder_add_instr(b_sz, mir_instr_new(MirOp.Add, mir_opnd_vreg(alloc_sz), mir_opnd_vreg(sz_mul), mir_opnd_imm(16)))
	b_sz = emit_set_arg(b_sz, 0, mir_opnd_vreg(alloc_sz))
	var (b_arr, out_arr) = builder_new_vreg(b_sz)
	b_arr = emit_intrinsic(b_arr, MIR_INTR_BUILTIN, mir_opnd_vreg(out_arr), mir_opnd_imm(3))

	b_arr = emit_store(b_arr, mir_opnd_vreg(out_arr), mir_opnd_vreg(count_v))
	var (b_acap, acap_addr) = builder_new_vreg(b_arr)
	b_acap = builder_add_instr(b_acap, mir_instr_new(MirOp.Add, mir_opnd_vreg(acap_addr), mir_opnd_vreg(out_arr), mir_opnd_imm(8)))
	b_acap = emit_store(b_acap, mir_opnd_vreg(acap_addr), mir_opnd_vreg(count_v))

	var (b_dst_i, dst_i_v) = builder_new_vreg(b_acap)
	b_dst_i = emit_move(b_dst_i, dst_i_v, mir_opnd_imm(0))
	var (b_i, i_v) = builder_new_vreg(b_dst_i)
	b_i = emit_move(b_i, i_v, mir_opnd_imm(0))

	var (b_cond, cond_id) = builder_add_block(b_i)
	var (b_body, body_id) = builder_add_block(b_cond)
	var (b_step, step_id) = builder_add_block(b_body)
	var (b_end, end_id) = builder_add_block(b_step)

	b_end = emit_jump(b_end, cond_id)
	b_end = builder_set_current_block(b_end, cond_id)
	var (b_cmp, cmp_v) = builder_new_vreg(b_end)
	b_cmp = builder_add_instr(b_cmp, mir_instr_new(MirOp.CmpLt, mir_opnd_vreg(cmp_v), mir_opnd_vreg(i_v), mir_opnd_vreg(cap_v)))
	b_cmp = emit_jump_if_not(b_cmp, mir_opnd_vreg(cmp_v), end_id, body_id)

	b_cmp = builder_set_current_block(b_cmp, body_id)
	var (b_mul, off_v) = builder_new_vreg(b_cmp)
	b_mul = builder_add_instr(b_mul, mir_instr_new(MirOp.Mul, mir_opnd_vreg(off_v), mir_opnd_vreg(i_v), mir_opnd_imm(24)))
	var (b_sl, slot_addr) = builder_new_vreg(b_mul)
	b_sl = builder_add_instr(b_sl, mir_instr_new(MirOp.Add, mir_opnd_vreg(slot_addr), mir_opnd_vreg(bkt_v), mir_opnd_vreg(off_v)))
	var (b_st_addr, st_addr) = builder_new_vreg(b_sl)
	b_st_addr = builder_add_instr(b_st_addr, mir_instr_new(MirOp.Add, mir_opnd_vreg(st_addr), mir_opnd_vreg(slot_addr), mir_opnd_imm(16)))
	var (b_st, st_v) = builder_new_vreg(b_st_addr)
	b_st = emit_load(b_st, st_v, mir_opnd_vreg(st_addr))
	var (b_is_occ, is_occ) = builder_new_vreg(b_st)
	b_is_occ = builder_add_instr(b_is_occ, mir_instr_new(MirOp.CmpEq, mir_opnd_vreg(is_occ), mir_opnd_vreg(st_v), mir_opnd_imm(1)))

	var (b_copy, copy_id) = builder_add_block(b_is_occ)
	b_copy = emit_jump_if(b_copy, mir_opnd_vreg(is_occ), copy_id, step_id)
	b_copy = builder_set_current_block(b_copy, copy_id)

	var elem_off = 0
	if extract_values == 1 do
		elem_off = 8
	end
	var (b_el_addr, el_addr) = builder_new_vreg(b_copy)
	b_el_addr = builder_add_instr(b_el_addr, mir_instr_new(MirOp.Add, mir_opnd_vreg(el_addr), mir_opnd_vreg(slot_addr), mir_opnd_imm(elem_off)))
	var (b_el, el_v) = builder_new_vreg(b_el_addr)
	b_el = emit_load(b_el, el_v, mir_opnd_vreg(el_addr))

	var (b_dst_mul, dst_mul) = builder_new_vreg(b_el)
	b_dst_mul = builder_add_instr(b_dst_mul, mir_instr_new(MirOp.Mul, mir_opnd_vreg(dst_mul), mir_opnd_vreg(dst_i_v), mir_opnd_imm(8)))
	var (b_dst_el0, dst_el0) = builder_new_vreg(b_dst_mul)
	b_dst_el0 = builder_add_instr(b_dst_el0, mir_instr_new(MirOp.Add, mir_opnd_vreg(dst_el0), mir_opnd_vreg(out_arr), mir_opnd_vreg(dst_mul)))
	var (b_dst_el, dst_el) = builder_new_vreg(b_dst_el0)
	b_dst_el = builder_add_instr(b_dst_el, mir_instr_new(MirOp.Add, mir_opnd_vreg(dst_el), mir_opnd_vreg(dst_el0), mir_opnd_imm(16)))
	b_dst_el = emit_store(b_dst_el, mir_opnd_vreg(dst_el), mir_opnd_vreg(el_v))

	var (b_dnext, dnext_v) = builder_new_vreg(b_dst_el)
	b_dnext = builder_add_instr(b_dnext, mir_instr_new(MirOp.Add, mir_opnd_vreg(dnext_v), mir_opnd_vreg(dst_i_v), mir_opnd_imm(1)))
	b_dnext = emit_move(b_dnext, dst_i_v, mir_opnd_vreg(dnext_v))
	b_dnext = emit_jump(b_dnext, step_id)

	b_dnext = builder_set_current_block(b_dnext, step_id)
	var (b_inext, inext_v) = builder_new_vreg(b_dnext)
	b_inext = builder_add_instr(b_inext, mir_instr_new(MirOp.Add, mir_opnd_vreg(inext_v), mir_opnd_vreg(i_v), mir_opnd_imm(1)))
	b_inext = emit_move(b_inext, i_v, mir_opnd_vreg(inext_v))
	b_inext = emit_jump(b_inext, cond_id)

	b_inext = builder_set_current_block(b_inext, end_id)
	out expr_result(b_inext, mir_opnd_vreg(out_arr))
end.

func lower_dict_keys(b: MirBuilder, base: &MirOperand):
	out lower_dict_extract(b, base, 0)
end.

func lower_dict_values(b: MirBuilder, base: &MirOperand):
	out lower_dict_extract(b, base, 1)
end.

func lower_map_emit_value(b: MirBuilder, out_base: &MirOperand, len_v: i64, value_expr: &AstNode):
	var b_val = lower_expr(b, value_expr)
	var val_op = g_lower_expr_result_opnd as MirOperand
	out lower_map_emit_operand(b_val, out_base, len_v, val_op)
end.

func lower_map_emit_operand(b: MirBuilder, out_base: &MirOperand, len_v: i64, val_op: &MirOperand):
	b_val = b
	var (b_len, cur_len) = builder_new_vreg(b_val)
	b_len = emit_load(b_len, cur_len, out_base)
	b_val = b_len
	b_val = emit_set_arg(b_val, 0, mir_opnd_vreg(cur_len))
	b_val = emit_set_arg(b_val, 1, val_op)
	b_val = emit_intrinsic(b_val, MIR_INTR_INDEX_STORE, mir_opnd_none(), out_base)
	var (b_next, next_len) = builder_new_vreg(b_val)
	b_next = builder_add_instr(b_next, mir_instr_new(MirOp.Add, mir_opnd_vreg(next_len), mir_opnd_vreg(cur_len), mir_opnd_imm(1)))
	b_next = emit_store(b_next, out_base, mir_opnd_vreg(next_len))
	out b_next
end.

func lower_map_condition(b: MirBuilder, cond: &AstNode, binder_name: &string, current_addr: &MirOperand):
	if (cond.node_type == AstType.Compare or cond.node_type == AstType.BinOp) and ast_node_op_of(cond) == OpType.Eq and ast_node_child_count(cond) >= 2 do
		left = ast_node_child(cond, 0)
		right = ast_node_child(cond, 1)
		if left.node_type == AstType.BinOp and ast_node_op_of(left) == OpType.ModOp and ast_node_child_count(left) >= 2 do
			mod_left = ast_node_child(left, 0)
			mod_right = ast_node_child(left, 1)
			if mod_left.node_type == AstType.Identifier and fat_str_eq(mod_left.name, binder_name as string) == 1 do
				var (b_load_cur, cur_v) = builder_new_vreg(b)
				b_load_cur = emit_load(b_load_cur, cur_v, current_addr)
				var b_mod_rhs = lower_expr(b_load_cur, mod_right)
				var rhs_op = g_lower_expr_result_opnd as MirOperand
				var (b_mod, mod_v) = builder_new_vreg(b_mod_rhs)
				b_mod = builder_add_instr(b_mod, mir_instr_new(MirOp.Mod, mir_opnd_vreg(mod_v), mir_opnd_vreg(cur_v), rhs_op))
				var b_cmp_rhs = lower_expr(b_mod, right)
				var cmp_rhs = g_lower_expr_result_opnd as MirOperand
				var (b_cmp, cmp_v) = builder_new_vreg(b_cmp_rhs)
				b_cmp = builder_add_instr(b_cmp, mir_instr_new(MirOp.CmpEq, mir_opnd_vreg(cmp_v), mir_opnd_vreg(mod_v), cmp_rhs))
				out expr_result(b_cmp, mir_opnd_vreg(cmp_v))
			end
		end
	end
	out lower_expr(b, cond)
end.

func lower_map_body_emit(b: MirBuilder, out_base: &MirOperand, len_v: i64, body: &AstNode, binder_name: &string, binder_op: &MirOperand, current_addr: &MirOperand):
	if (body as i64) == 0 do out b end
	var body_t = ast_node_type_of(body)
	if body_t == AstType.Block do
		var n = ast_node_child_count(body)
		if n <= 0 do out b end
		var cur_b = b
		var i = 0
		when i < n loop
			var stmt = ast_node_child(body, i)
			var st = ast_node_type_of(stmt)
			if st == AstType.ReturnStmt or st == AstType.IfStmt do
				cur_b = lower_map_body_emit(cur_b, out_base, len_v, stmt, binder_name, binder_op, current_addr)
			else
				if st == AstType.VarDecl or st == AstType.ConstDecl or st == AstType.Assign do
					cur_b = lower_stmt(cur_b, stmt)
				else
					cur_b = lower_map_body_emit(cur_b, out_base, len_v, stmt, binder_name, binder_op, current_addr)
				end
			end
			i = i + 1
		end
		out cur_b
	end
	if body_t == AstType.ReturnStmt do
		if ast_node_child_count(body) > 0 do
			ret_expr = ast_node_child(body, 0)
			if ret_expr.node_type == AstType.Identifier and fat_str_eq(ret_expr.name, binder_name as string) == 1 do
				var (b_reload, reload_v) = builder_new_vreg(b)
				b_reload = emit_load(b_reload, reload_v, current_addr)
				out lower_map_emit_operand(b_reload, out_base, len_v, mir_opnd_vreg(reload_v))
			end
			out lower_map_emit_value(b, out_base, len_v, ret_expr)
		end
		out b
	end
	if body_t == AstType.IfStmt do
		var cc = ast_node_child_count(body)
		if cc >= 2 do
			var (b_cond_base, cond_reload) = builder_new_vreg(b)
			b_cond_base = emit_load(b_cond_base, cond_reload, current_addr)
			b_cond_base = set_var_vreg(b_cond_base, binder_name as string, cond_reload)
			var b_cond = lower_map_condition(b_cond_base, ast_node_child(body, 0), binder_name, current_addr)
			var cond_op = g_lower_expr_result_opnd as MirOperand
			var (b_then, then_id) = builder_add_block(b_cond)
			var (b_else, else_id) = builder_add_block(b_then)
			var (b_end, end_id) = builder_add_block(b_else)

			b_end = emit_jump_if_not(b_end, cond_op, else_id, then_id)

			b_end = builder_set_current_block(b_end, then_id)
			b_end = lower_map_body_emit(b_end, out_base, len_v, ast_node_child(body, 1), binder_name, binder_op, current_addr)
			if not builder_current_block_terminated(b_end) do
				b_end = emit_jump(b_end, end_id)
			end

			b_end = builder_set_current_block(b_end, else_id)
			if cc >= 3 do
				b_end = lower_map_body_emit(b_end, out_base, len_v, ast_node_child(body, 2), binder_name, binder_op, current_addr)
			end
			if not builder_current_block_terminated(b_end) do
				b_end = emit_jump(b_end, end_id)
			end

			out builder_set_current_block(b_end, end_id)
		end
		out b
	end
	out lower_map_emit_value(b, out_base, len_v, body)
end.

func lower_map_block_expr(b: MirBuilder, expr: &AstNode):
	child_count = ast_node_child_count(expr)
	if child_count < 2 do
		var (b_empty, empty_dst) = builder_new_vreg(b)
		b_empty = emit_set_arg(b_empty, 0, mir_opnd_imm(16))
		b_empty = emit_intrinsic(b_empty, MIR_INTR_BUILTIN, mir_opnd_vreg(empty_dst), mir_opnd_imm(3))
		out expr_result(b_empty, mir_opnd_vreg(empty_dst))
	end
	source_expr = ast_node_child(expr, 0)
	body = ast_node_child(expr, 1)

	var (b_len, src_len) = builder_new_vreg(b)
	var (b_i_start, i_start_v) = builder_new_vreg(b_len)
	var (b_end_val, end_val_v) = builder_new_vreg(b_i_start)
	var is_range = 0
	var src_op = mir_opnd_none()
	var b_src = b_end_val

	if ast_node_type_of(source_expr) == AstType.ForRange and ast_node_child_count(source_expr) >= 2 do
		is_range = 1
		b_src = lower_expr(b_end_val, ast_node_child(source_expr, 0))
		var start_op = g_lower_expr_result_opnd as MirOperand
		b_src = lower_expr(b_src, ast_node_child(source_expr, 1))
		var end_op = g_lower_expr_result_opnd as MirOperand
		b_src = emit_move(b_src, i_start_v, start_op)
		b_src = emit_move(b_src, end_val_v, end_op)
		b_src = builder_add_instr(b_src, mir_instr_new(MirOp.Sub, mir_opnd_vreg(src_len), end_op, start_op))
	else
		b_src = lower_expr(b_end_val, source_expr)
		src_op = g_lower_expr_result_opnd as MirOperand
		b_src = emit_load(b_src, src_len, src_op)
		b_src = emit_move(b_src, i_start_v, mir_opnd_imm(0))
		b_src = emit_move(b_src, end_val_v, mir_opnd_vreg(src_len))
	end

	var (b_bytes_mul, bytes_payload) = builder_new_vreg(b_src)
	b_bytes_mul = builder_add_instr(b_bytes_mul, mir_instr_new(MirOp.Mul, mir_opnd_vreg(bytes_payload), mir_opnd_vreg(src_len), mir_opnd_imm(8)))
	var (b_bytes, alloc_bytes) = builder_new_vreg(b_bytes_mul)
	b_bytes = builder_add_instr(b_bytes, mir_instr_new(MirOp.Add, mir_opnd_vreg(alloc_bytes), mir_opnd_vreg(bytes_payload), mir_opnd_imm(16)))
	b_bytes = emit_set_arg(b_bytes, 0, mir_opnd_vreg(alloc_bytes))
	var (b_alloc, out_v) = builder_new_vreg(b_bytes)
	b_alloc = emit_intrinsic(b_alloc, MIR_INTR_BUILTIN, mir_opnd_vreg(out_v), mir_opnd_imm(3))
	b_alloc = emit_store(b_alloc, mir_opnd_vreg(out_v), mir_opnd_imm(0))
	var (b_cap_addr, cap_addr) = builder_new_vreg(b_alloc)
	b_cap_addr = builder_add_instr(b_cap_addr, mir_instr_new(MirOp.Add, mir_opnd_vreg(cap_addr), mir_opnd_vreg(out_v), mir_opnd_imm(8)))
	b_cap_addr = emit_store(b_cap_addr, mir_opnd_vreg(cap_addr), mir_opnd_vreg(src_len))

	var (b_i, i_v) = builder_new_vreg(b_cap_addr)
	b_i = emit_move(b_i, i_v, mir_opnd_vreg(i_start_v))
	var (b_out_len, out_len_v) = builder_new_vreg(b_i)
	b_out_len = emit_move(b_out_len, out_len_v, mir_opnd_imm(0))
	b_out_len = emit_set_arg(b_out_len, 0, mir_opnd_imm(8))
	var (b_cell_alloc, current_cell) = builder_new_vreg(b_out_len)
	b_cell_alloc = emit_intrinsic(b_cell_alloc, MIR_INTR_BUILTIN, mir_opnd_vreg(current_cell), mir_opnd_imm(3))

	var (b1, cond_id) = builder_add_block(b_cell_alloc)
	var (b2, body_id) = builder_add_block(b1)
	var (b3, step_id) = builder_add_block(b2)
	var (b4, end_id) = builder_add_block(b3)

	b4 = emit_jump(b4, cond_id)
	b4 = builder_set_current_block(b4, cond_id)
	var (b_cmp, cmp_v) = builder_new_vreg(b4)
	b_cmp = builder_add_instr(b_cmp, mir_instr_new(MirOp.CmpLt, mir_opnd_vreg(cmp_v), mir_opnd_vreg(i_v), mir_opnd_vreg(end_val_v)))
	b_cmp = emit_jump_if_not(b_cmp, mir_opnd_vreg(cmp_v), end_id, body_id)

	b_cmp = builder_set_current_block(b_cmp, body_id)
	var (b_elem, elem_v) = builder_new_vreg(b_cmp)
	if is_range == 1 do
		b_elem = emit_move(b_elem, elem_v, mir_opnd_vreg(i_v))
	else
		b_elem = emit_set_arg(b_elem, 0, mir_opnd_vreg(i_v))
		b_elem = emit_intrinsic(b_elem, MIR_INTR_INDEX, mir_opnd_vreg(elem_v), src_op)
	end
	b_elem = emit_store(b_elem, mir_opnd_vreg(current_cell), mir_opnd_vreg(elem_v))
	b_elem = set_var_vreg(b_elem, ast_node_name(expr), elem_v)
	if fat_str_len(ast_node_name2(expr)) > 0 do
		var (b_idx_bind, idx_bind_v) = builder_new_vreg(b_elem)
		if is_range == 1 do
			b_idx_bind = builder_add_instr(b_idx_bind, mir_instr_new(MirOp.Sub, mir_opnd_vreg(idx_bind_v), mir_opnd_vreg(i_v), mir_opnd_vreg(i_start_v)))
		else
			b_idx_bind = emit_move(b_idx_bind, idx_bind_v, mir_opnd_vreg(i_v))
		end
		b_elem = set_var_vreg(b_idx_bind, ast_node_name2(expr), idx_bind_v)
	end

	b_elem = lower_map_body_emit(b_elem, mir_opnd_vreg(out_v), out_len_v, body, ast_node_name(expr) as i64, mir_opnd_vreg(elem_v), mir_opnd_vreg(current_cell))
	b_elem = emit_jump(b_elem, step_id)
	b_elem = builder_set_current_block(b_elem, step_id)
	var (b_inc, next_i) = builder_new_vreg(b_elem)
	b_inc = builder_add_instr(b_inc, mir_instr_new(MirOp.Add, mir_opnd_vreg(next_i), mir_opnd_vreg(i_v), mir_opnd_imm(1)))
	b_inc = emit_move(b_inc, i_v, mir_opnd_vreg(next_i))
	b_inc = emit_jump(b_inc, cond_id)
	b_inc = builder_set_current_block(b_inc, end_id)
	out expr_result(b_inc, mir_opnd_vreg(out_v))
end.

func lower_expr(b: &MirBuilder, expr: &AstNode):
	out lower_expr_impl(b, expr)
end.

func scan_has_local_arena_alloc(node: &AstNode):
    if node == 0 do out 0 end
    let nt = ast_node_type_of(node)
    if nt == AstType.ArrayLiteral do out 1 end
    let nc = ast_node_child_count(node)
    var i = 0
    when i < nc loop
        let ch = ast_node_child(node, i)
        if scan_has_local_arena_alloc(ch) == 1 do
            out 1
        end
        i = i + 1
    end
    out 0
end.
