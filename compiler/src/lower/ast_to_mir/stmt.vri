##
 * compiler/src/lower/ast_to_mir/stmt.vri — Declarations & Assignment Statements
 * ==============================================================================
 ##

include types
include vec_rt
include string_rt
include parser
include mir
include ast_to_mir_context
include ast_to_mir_layout
include ast_to_mir_builder
include ast_to_mir_calls
include ast_to_mir_expr_ops
include ast_to_mir_expr
include ast_to_mir_stmt_control

func lower_stmt_impl(b: &MirBuilder, stmt: &AstNode):
	stmt_type = ast_node_type_of(stmt)

	if stmt_type == AstType.IfStmt or stmt_type == AstType.WhileStmt or stmt_type == AstType.LoopStmt or stmt_type == AstType.Block or stmt_type == AstType.ReturnStmt or stmt_type == AstType.BreakStmt or stmt_type == AstType.ContinueStmt or stmt_type == AstType.CaseExpr or stmt_type == AstType.ForRange or stmt_type == AstType.EnsureBlock or stmt_type == AstType.RevertBlock or stmt_type == AstType.WhenStmt or stmt_type == AstType.ThrowStmt or stmt_type == AstType.CancelStmt or stmt_type == AstType.QuietStmt or stmt_type == AstType.ArenaBlock or stmt_type == AstType.EmitStmt or stmt_type == AstType.SelectStmt or stmt_type == AstType.TryStmt or stmt_type == AstType.TimeoutClause or stmt_type == AstType.IsolateClause or stmt_type == AstType.ResumeStmt do
		lowered_ctl = lower_stmt_control(b, stmt, stmt_type)
		out b
	end

	if stmt_type == AstType.VarDeclGroup do
		child_count = ast_node_child_count(stmt)
		var b_curr = b
		var vi = 0
		when vi < child_count loop
			child = ast_node_child(stmt, vi)
			b_curr = lower_stmt(b_curr, child)
			vi = vi + 1
		end
		out b_curr
	end

    # 1. VarDecl & ConstDecl
	if stmt_type == AstType.VarDecl or stmt_type == AstType.ConstDecl do
		if ast_node_int_val(stmt) == 16384 do
			child_count = ast_node_child_count(stmt)
			if child_count > 1 do
				init_expr = ast_node_child(stmt, child_count - 1)
				var b2 = lower_expr(b, init_expr)
				var base_opnd = g_lower_expr_result_opnd as MirOperand
				var b_curr = b2
				var i = 0
				when i < child_count - 1 loop
					var_ident = ast_node_child(stmt, i)
					var_name = ast_node_name(var_ident)
					# Tuples/entities are flat aggregates. MIR_INTR_INDEX is for Vec
					# storage and adds a 16-byte capacity/length header, so using it
					# here made `(a, b) = pair()` read beyond the returned object.
					var (b_addr, elem_addr) = builder_new_vreg(b_curr)
					b_addr = builder_add_instr(b_addr, mir_instr_new(MirOp.Add, mir_opnd_vreg(elem_addr), base_opnd, mir_opnd_imm(i * 8)))
					var (b_elem, dst_v) = builder_new_vreg(b_addr)
					b_elem = emit_load(b_elem, dst_v, mir_opnd_vreg(elem_addr))
					record_var_declaration(var_name)
					var elem_type_str = fat_str_new("")
					if ast_node_type_of(init_expr) == AstType.TupleExpr and i < ast_node_child_count(init_expr) do
						elem_type_str = infer_expr_type_name(ast_node_child(init_expr, i))
					eif ast_node_type_of(init_expr) == AstType.Call do
						elem_type_str = find_func_return_tuple_elem_type(ast_node_name(init_expr), i)
					end
					if fat_str_len(elem_type_str) > 0 do
						set_var_type(var_name, elem_type_str)
					end
					b_elem = set_var_vreg(b_elem, var_name, dst_v)
					b_curr = b_elem
					i = i + 1
				end
				out b_curr
			end
			out b
		end
		child_count = ast_node_child_count(stmt)
		if child_count > 0 do
			expr = ast_node_child(stmt, 0)
			var b2 = lower_expr(b, expr)
			var val_opnd = g_lower_expr_result_opnd as MirOperand
			# Typed declarations perform the numeric coercion promised by the
			# source type instead of merely relabelling the source bit-pattern.
			var declared_t = ast_node_name2(stmt)
			var source_t = infer_expr_type_name(expr)
			if declared_t != 0 and fat_str_len(declared_t) > 0 do
				var source_is_float = fat_cstr_eq(source_t, "float") == 1 or fat_cstr_eq(source_t, "f64") == 1
				var target_is_float = fat_cstr_eq(declared_t, "float") == 1 or fat_cstr_eq(declared_t, "f64") == 1
				var source_is_int = fat_cstr_eq(source_t, "int") == 1 or fat_cstr_eq(source_t, "i64") == 1
				var target_is_int = fat_cstr_eq(declared_t, "int") == 1 or fat_cstr_eq(declared_t, "i64") == 1
				if (source_is_int and target_is_float) or (source_is_float and target_is_int) do
					var (b_cast, cast_v) = builder_new_vreg(b2)
					var cast_src_cat = 1
					var cast_dst_cat = 1
					var cast_typ = MirType.Int64 as i64
					if source_is_float do cast_src_cat = 2 end
					if target_is_float do cast_dst_cat = 2; cast_typ = MirType.F64 as i64 end
					var cast_kind = MIR_INTR_CAST + (cast_src_cat shl 8) + (cast_dst_cat shl 16)
					b2 = emit_intrinsic_typed(b_cast, cast_kind, mir_opnd_vreg(cast_v), val_opnd, cast_typ)
					val_opnd = mir_opnd_vreg(cast_v)
				end
			end
			# Flux copy semantics in VarDecl: deep-copy when source or declared type is flux
			# and the initializer is not a freshly created vector value.
			var vd_flux_type = declared_t
			if (vd_flux_type as i64) == 0 or fat_str_len(vd_flux_type) == 0 do
				vd_flux_type = infer_expr_type_name(expr)
			end
			var vd_expr_nt = ast_node_type_of(expr)
			var vd_is_fresh = vd_expr_nt == AstType.BinOp or vd_expr_nt == AstType.UnaryMinus or vd_expr_nt == AstType.UnaryNot or vd_expr_nt == AstType.SwizzleExpr or vd_expr_nt == AstType.Call
			if is_flux_type_str(vd_flux_type) and not vd_is_fresh do
				var (b_vd_fdc, vd_cloned) = emit_flux_clone(b2, val_opnd, vd_flux_type)
				val_opnd = vd_cloned
				b2 = b_vd_fdc
			end
			var (b3, v) = builder_new_vreg(b2)
			ins = mir_instr_new(MirOp.Move, mir_opnd_vreg(v), val_opnd, mir_opnd_none())
			b3 = builder_add_instr(b3, ins)
			record_var_declaration(ast_node_name(stmt))
			b3 = set_var_vreg(b3, ast_node_name(stmt), v)
			var var_t = ast_node_name2(stmt)
			if var_t != 0 and is_tensor_type_str(var_t) do
				if ast_node_type_of(expr) == AstType.ArrayLiteral and ast_node_child_count(expr) > 0 do
					let first_ch = ast_node_child(expr, 0)
					let first_nt = ast_node_type_of(first_ch)
					if first_nt == AstType.LiteralFloat or first_nt == AstType.LiteralInt do
						let shape_init = parse_tensor_shape(var_t)
						let rank_init = vec_len_rt(shape_init)
						if rank_init > 0 do
							var prefix = fat_str_new("tensor[int; ")
							if first_nt == AstType.LiteralFloat do
								prefix = fat_str_new("tensor[f64; ")
							end
							var new_vt = prefix
							var si = 0
							when si < rank_init loop
								if si > 0 do new_vt = fat_str_concat(new_vt, fat_str_new(", ")) end
								let d_val = vec_get_rt(shape_init, si) as int
								new_vt = fat_str_concat(new_vt, fat_str_new(rt_itoa(d_val)))
								si = si + 1
							end
							new_vt = fat_str_concat(new_vt, fat_str_new("]"))
							var_t = new_vt
						end
					end
				end
			end
			if var_t == 0 or fat_str_len(var_t) == 0 do
				var expr_nt = ast_node_type_of(expr)
				var_t = infer_expr_type_name(expr)
				# Keep literal inference direct here: ConstDecl (`let`) nodes are
				# pre-indexed before lowering, and older bootstrap binaries can
				# otherwise retain their empty placeholder type.
				if expr_nt == AstType.LiteralInt do var_t = fat_str_new("int") end
				if expr_nt == AstType.LiteralFloat do var_t = fat_str_new("float") end
				if expr_nt == AstType.LiteralBool do var_t = fat_str_new("bool") end
				if expr_nt == AstType.LiteralNone do var_t = fat_str_new("none") end
				if expr_nt == AstType.LiteralStr or expr_nt == AstType.InterpExpr do var_t = fat_str_new("string") end
				if expr_nt == AstType.DictLiteral do var_t = fat_str_new("dict") end
				if expr_nt == AstType.QuantizeExpr do
					if fat_str_len(ast_node_name2(expr)) > 0 do
						var_t = ast_node_name2(expr)
					else
						var_t = fat_str_new("QuantizedTensor")
					end
				end
				if expr_nt == AstType.EnumConstruct do var_t = ast_node_name2(expr) end
				if expr_nt == AstType.SwizzleExpr do
					var_t = infer_expr_type_name(expr)
				end
				if expr_nt == AstType.Call and fat_cstr_eq(ast_node_name(expr), "flux") == 1 do
					var flux_child_c = ast_node_child_count(expr)
					var flux_vt_elem = fat_str_new("int")
					if flux_child_c > 0 do
						var flux_fc0 = ast_node_child(expr, 0)
						var flux_nt0 = ast_node_type_of(flux_fc0)
						if flux_nt0 == AstType.LiteralFloat do flux_vt_elem = fat_str_new("float") end
						var flux_ft0 = infer_expr_type_name(flux_fc0)
						if fat_cstr_eq(flux_ft0, "float") == 1 or fat_cstr_eq(flux_ft0, "f64") == 1 do flux_vt_elem = fat_str_new("float") end
					end
					var_t = fat_str_concat(fat_str_new("flux<"), fat_str_concat(flux_vt_elem, fat_str_concat(fat_str_new(", "), fat_str_concat(fat_str_new(rt_itoa(flux_child_c)), fat_str_new(">")))))
				end
				if expr_nt == AstType.EntityLiteral or expr_nt == AstType.Call do
					var cname = resolve_callee_alias(ast_node_name(expr))
					if is_entity_name(cname) == 1 do
						var_t = cname
						let gen_args_lit = ast_node_name2(expr)
						if (gen_args_lit as i64) != 0 and fat_str_len(gen_args_lit) > 0 do
							var_t = fat_str_concat(cname, fat_str_concat(fat_str_new("<"), fat_str_concat(gen_args_lit, fat_str_new(">"))))
						end
					else
						let fn_ast = find_func_ast(cname)
						if (fn_ast as i64) != 0 do
							let fn_ret = ast_node_name2(fn_ast)
							if (fn_ret as i64) != 0 and fat_str_len(fn_ret) > 0 do
								let unwrapped_ret = unwrap_ref_type_name(fn_ret)
								if is_entity_name(unwrapped_ret) == 1 do
									var_t = unwrapped_ret
								end
							end
						end
					end
				end
				if expr_nt == AstType.BinOp and (ast_node_op_of(expr) == OpType.MatMulOp or ast_node_op_of(expr) == OpType.FmaOp) do
					left_n = ast_node_child(expr, 0)
					right_n = ast_node_child(expr, 1)
					left_t = get_var_type(ast_node_name(left_n))
					right_t = get_var_type(ast_node_name(right_n))
					if (is_tensor_type_str(left_t) or is_quantized_type_str(left_t as int)) and is_tensor_type_str(right_t) do
						var shape_a = 0
						if is_quantized_type_str(left_t as int) do
							shape_a = parse_quantized_shape(left_t as int)
						else
							shape_a = parse_tensor_shape(left_t)
						end
						shape_b = parse_tensor_shape(right_t)
						if vec_len_rt(shape_a) >= 2 and vec_len_rt(shape_b) >= 2 do
							dim_m = vec_get_rt(shape_a, 0) as i64
							dim_n = vec_get_rt(shape_b, 1) as i64
							var elem_prefix = fat_str_new("tensor[int; ")
							if is_quantized_type_str(left_t as int) do
								elem_prefix = fat_str_new("tensor[f32; ")
							else
								let l_code = parse_tensor_elem_code(left_t)
								if l_code == 1 do elem_prefix = fat_str_new("tensor[f32; ") end
								if l_code == 2 do elem_prefix = fat_str_new("tensor[f16; ") end
								if l_code == 3 do elem_prefix = fat_str_new("tensor[i8; ") end
								if l_code == 4 do elem_prefix = fat_str_new("tensor[u8; ") end
								if l_code == 5 do elem_prefix = fat_str_new("tensor[i32; ") end
								if l_code == 6 do elem_prefix = fat_str_new("tensor[int; ") end
								if l_code == 7 do elem_prefix = fat_str_new("tensor[f64; ") end
							end
							var_t = fat_str_concat(elem_prefix, fat_str_new(rt_itoa(dim_m)))
							var_t = fat_str_concat(var_t, fat_str_new(", "))
							var_t = fat_str_concat(var_t, fat_str_new(rt_itoa(dim_n)))
							var_t = fat_str_concat(var_t, fat_str_new("]"))
						end
					end
				end
			end
			# `let` is a ConstDecl and may carry an internal non-empty placeholder
			# in name2.  Literal inference must override that placeholder.
			if ast_node_type_of(stmt) == AstType.ConstDecl do
				expr_nt_const = ast_node_type_of(expr)
				if expr_nt_const == AstType.LiteralInt do var_t = fat_str_new("int"); set_var_type(ast_node_name(stmt), var_t) end
				if expr_nt_const == AstType.LiteralFloat do var_t = fat_str_new("float"); set_var_type(ast_node_name(stmt), var_t) end
				if expr_nt_const == AstType.LiteralBool do var_t = fat_str_new("bool"); set_var_type(ast_node_name(stmt), var_t) end
				if expr_nt_const == AstType.LiteralNone do var_t = fat_str_new("none"); set_var_type(ast_node_name(stmt), var_t) end
				if expr_nt_const == AstType.LiteralStr or expr_nt_const == AstType.InterpExpr do var_t = fat_str_new("string"); set_var_type(ast_node_name(stmt), var_t) end
				if expr_nt_const == AstType.DictLiteral do var_t = fat_str_new("dict"); set_var_type(ast_node_name(stmt), var_t) end
			end
			if var_t != 0 and fat_str_len(var_t) > 0 do
				set_var_type(ast_node_name(stmt), var_t)
			end
			if ast_node_type_of(expr) == AstType.DictLiteral or is_dict_type_name(var_t) == 1 do
				mark_dict_var(ast_node_name(stmt))
			end
			out b3
		end
		decl_name = ast_node_name(stmt)
		var_t = ast_node_name2(stmt)
		record_var_declaration(decl_name)
		if var_t != 0 and is_tensor_type_str(var_t) do
			numel = parse_tensor_numel(var_t)
			if numel <= 0 do numel = 4 end
			var elem_bytes = tensor_elem_byte_size(var_t)
			let e_code = parse_tensor_elem_code(var_t)
			if e_code == 1 or elem_bytes < 8 do
				elem_bytes = 8
			end
			alloc_sz = 16 + numel * elem_bytes
			alloc_sz = (alloc_sz + 15) / 16 * 16
			b_mut = emit_set_arg(b, 0, mir_opnd_imm(alloc_sz))
			var (b_base, base_vr) = builder_new_vreg(b_mut)
			b_base = emit_intrinsic(b_base, MIR_INTR_BUILTIN, mir_opnd_vreg(base_vr), mir_opnd_imm(3))
			b_base = emit_set_arg(b_base, 0, mir_opnd_vreg(base_vr))
			b_base = emit_set_arg(b_base, 1, mir_opnd_imm(0))
			b_base = emit_set_arg(b_base, 2, mir_opnd_imm(numel))
			b_base = emit_intrinsic(b_base, MIR_INTR_BUILTIN, mir_opnd_none(), mir_opnd_imm(8))
			b_base = emit_set_arg(b_base, 0, mir_opnd_vreg(base_vr))
			b_base = emit_set_arg(b_base, 1, mir_opnd_imm(8))
			b_base = emit_set_arg(b_base, 2, mir_opnd_imm(numel))
			b_base = emit_intrinsic(b_base, MIR_INTR_BUILTIN, mir_opnd_none(), mir_opnd_imm(8))
			b_base = set_var_vreg(b_base, decl_name, base_vr)
			set_var_type(decl_name, var_t)
			out b_base
		end
		out b
	end

	if stmt_type == AstType.Assign do
		child_count = ast_node_child_count(stmt)
		var expr = 0
		var target_name = ast_node_name(stmt)
		if child_count >= 2 do
			target_name = ast_node_name(ast_node_child(stmt, 0))
			expr = ast_node_child(stmt, 1)
		else
			expr = ast_node_child(stmt, 0)
		end
		if expr != 0 do
			var expr_nt = ast_node_type_of(expr)
			if expr_nt == AstType.EntityLiteral or expr_nt == AstType.Call do
				var cname = resolve_callee_alias(ast_node_name(expr))
				if is_entity_name(cname) == 1 do
					set_var_type(target_name, cname)
				else
					let fn_ast = find_func_ast(cname)
					if (fn_ast as i64) != 0 do
						let fn_ret = ast_node_name2(fn_ast)
						if (fn_ret as i64) != 0 and fat_str_len(fn_ret) > 0 do
							let unwrapped_ret = unwrap_ref_type_name(fn_ret)
							if is_entity_name(unwrapped_ret) == 1 do
								set_var_type(target_name, unwrapped_ret)
							end
						end
					end
				end
			end
			if expr_nt == AstType.Identifier do
				var src_var_t = get_var_type(ast_node_name(expr))
				if is_entity_name(src_var_t) == 1 do
					set_var_type(target_name, src_var_t)
				end
			end
			if expr_nt == AstType.QuantizeExpr do
				if fat_str_len(ast_node_name2(expr)) > 0 do
					set_var_type(target_name, ast_node_name2(expr))
				else
					set_var_type(target_name, fat_str_new("QuantizedTensor"))
				end
			end
			if expr_nt == AstType.DictLiteral do
				set_var_type(target_name, fat_str_new("dict"))
				mark_dict_var(target_name)
			end
			if expr_nt == AstType.BinOp and (ast_node_op_of(expr) == OpType.MatMulOp or ast_node_op_of(expr) == OpType.FmaOp) do
				left_n = ast_node_child(expr, 0)
				right_n = ast_node_child(expr, 1)
				left_t = get_var_type(ast_node_name(left_n))
				right_t = get_var_type(ast_node_name(right_n))
				if (is_tensor_type_str(left_t) or is_quantized_type_str(left_t as int)) and is_tensor_type_str(right_t) do
					var shape_a = 0
					if is_quantized_type_str(left_t as int) do
						shape_a = parse_quantized_shape(left_t as int)
					else
						shape_a = parse_tensor_shape(left_t)
					end
					shape_b = parse_tensor_shape(right_t)
					if vec_len_rt(shape_a) >= 2 and vec_len_rt(shape_b) >= 2 do
						dim_m = vec_get_rt(shape_a, 0) as i64
						dim_n = vec_get_rt(shape_b, 1) as i64
						var elem_prefix = fat_str_new("tensor[int; ")
						if is_quantized_type_str(left_t as int) do
							elem_prefix = fat_str_new("tensor[f32; ")
						else
							let l_code = parse_tensor_elem_code(left_t)
							if l_code == 1 do elem_prefix = fat_str_new("tensor[f32; ") end
							if l_code == 2 do elem_prefix = fat_str_new("tensor[f16; ") end
							if l_code == 3 do elem_prefix = fat_str_new("tensor[i8; ") end
							if l_code == 4 do elem_prefix = fat_str_new("tensor[u8; ") end
							if l_code == 5 do elem_prefix = fat_str_new("tensor[i32; ") end
							if l_code == 6 do elem_prefix = fat_str_new("tensor[int; ") end
							if l_code == 7 do elem_prefix = fat_str_new("tensor[f64; ") end
						end
						var mm_type = fat_str_concat(elem_prefix, fat_str_new(rt_itoa(dim_m)))
						mm_type = fat_str_concat(mm_type, fat_str_new(", "))
						mm_type = fat_str_concat(mm_type, fat_str_new(rt_itoa(dim_n)))
						mm_type = fat_str_concat(mm_type, fat_str_new("]"))
						set_var_type(target_name, mm_type)
					end
				end
			end
		end
		var b2 = lower_expr(b, expr)
		var val_opnd = g_lower_expr_result_opnd as MirOperand
		# Preserve the established type of an assignment target. A numeric
		# assignment changes representation just like an explicit `as` cast.
		var assign_target_t = get_var_type(target_name)
		var assign_source_t = infer_expr_type_name(expr)
		if assign_target_t != 0 and fat_str_len(assign_target_t) > 0 do
			var assign_source_float = fat_cstr_eq(assign_source_t, "float") == 1 or fat_cstr_eq(assign_source_t, "f64") == 1
			var assign_target_float = fat_cstr_eq(assign_target_t, "float") == 1 or fat_cstr_eq(assign_target_t, "f64") == 1
			var assign_source_int = fat_cstr_eq(assign_source_t, "int") == 1 or fat_cstr_eq(assign_source_t, "i64") == 1
			var assign_target_int = fat_cstr_eq(assign_target_t, "int") == 1 or fat_cstr_eq(assign_target_t, "i64") == 1
			if (assign_source_int and assign_target_float) or (assign_source_float and assign_target_int) do
				var (b_assign_cast, assign_cast_v) = builder_new_vreg(b2)
				var assign_src_cat = 1
				var assign_dst_cat = 1
				var assign_cast_typ = MirType.Int64 as i64
				if assign_source_float do assign_src_cat = 2 end
				if assign_target_float do assign_dst_cat = 2; assign_cast_typ = MirType.F64 as i64 end
				var assign_cast_kind = MIR_INTR_CAST + (assign_src_cat shl 8) + (assign_dst_cat shl 16)
				b2 = emit_intrinsic_typed(b_assign_cast, assign_cast_kind, mir_opnd_vreg(assign_cast_v), val_opnd, assign_cast_typ)
				val_opnd = mir_opnd_vreg(assign_cast_v)
			end
		end
		if g_func_ref_param_hash != 0 do
			ref_idx = hash_table_lookup(g_func_ref_param_hash, g_func_ref_param_names, target_name)
			if ref_idx >= 0 do
				ptr_vreg = vec_get_rt(g_func_ref_param_vregs, ref_idx)
				b2 = emit_store(b2, mir_opnd_vreg(ptr_vreg), val_opnd)
				out b2
			end
		end
		# Flux copy semantics: assignment of flux<T,N> must deep-copy all N lanes
		# so that mutating the copy does not affect the original.
		var fc_flux_type = assign_target_t
		if (fc_flux_type as i64) == 0 or fat_str_len(fc_flux_type) == 0 do
			fc_flux_type = assign_source_t
		end
		var fc_expr_nt = ast_node_type_of(expr)
		var fc_is_fresh = fc_expr_nt == AstType.BinOp or fc_expr_nt == AstType.UnaryMinus or fc_expr_nt == AstType.UnaryNot or fc_expr_nt == AstType.SwizzleExpr or fc_expr_nt == AstType.Call
		if is_flux_type_str(fc_flux_type) and not fc_is_fresh and (mir_opnd_type(val_opnd) as int) != 0 do
			var (b_fdc, fc_cloned) = emit_flux_clone(b2, val_opnd, fc_flux_type)
			val_opnd = fc_cloned
			b2 = b_fdc
		end
		v = get_var_vreg(b2, target_name)
		if v >= 0 do
			b2 = emit_move(b2, v, val_opnd)
			out b2
		end
		global_slot = global_slot_lookup(target_name)
		if global_slot >= 0 do
			out emit_intrinsic(b2, MIR_INTR_GLOBAL_STORE, mir_opnd_imm(global_slot), val_opnd)
		end
		var (b3, v2) = builder_new_vreg(b2)
		b3 = emit_move(b3, v2, val_opnd)
		b3 = set_var_vreg(b3, target_name, v2)
		out b3
	end

    # 2b. IndexAssign — name[idx, ...] = val → INDEX_STORE
	if stmt_type == AstType.IndexAssign do
		child_count = ast_node_child_count(stmt)
		if child_count >= 2 do
			vname = ast_node_name(stmt)
			bv = get_var_vreg(b, vname)
			var is_dict_container = is_known_dict_var(vname)
			var vtype = fat_str_new("")
			if is_dict_container == 0 do vtype = get_var_type(vname) end
			val_expr = ast_node_child(stmt, child_count - 1)
			if is_tensor_type_str(vtype) and parse_tensor_elem_code(vtype) == 1 do
				var is_flt_val = false
				if ast_node_type_of(val_expr) == AstType.LiteralFloat do is_flt_val = true end
				if fat_cstr_eq(infer_expr_type_name(val_expr), "float") == 1 do is_flt_val = true end
				let shape_v = parse_tensor_shape(vtype)
				let rank_v = vec_len_rt(shape_v)
				if rank_v > 0 do
					var prefix = fat_str_new("tensor[int; ")
					if is_flt_val do
						prefix = fat_str_new("tensor[f64; ")
					end
					var new_t = prefix
					var si = 0
					when si < rank_v loop
						if si > 0 do new_t = fat_str_concat(new_t, fat_str_new(", ")) end
						let d_val = vec_get_rt(shape_v, si) as int
						new_t = fat_str_concat(new_t, fat_str_new(rt_itoa(d_val)))
						si = si + 1
					end
					new_t = fat_str_concat(new_t, fat_str_new("]"))
					set_var_type(vname, new_t)
					vtype = new_t
				end
			end
			num_indices = child_count - 1
			b_cur = b
			flat_opnd = mir_opnd_none()
			if num_indices == 1 do
				var b2 = lower_expr(b_cur, ast_node_child(stmt, 0))
				var idx = g_lower_expr_result_opnd as MirOperand
				b_cur = b2
				flat_opnd = idx
			else
				var k = 0
				when k < num_indices loop
					idx_ast = ast_node_child(stmt, k)
					var b_next = lower_expr(b_cur, idx_ast)
					var idx_op = g_lower_expr_result_opnd as MirOperand
					b_cur = b_next
					stride = 1
					if is_tensor_type_str(vtype) do
						stride = parse_tensor_stride(vtype, k)
					end
					term_op = idx_op
					if stride > 1 do
						var (b_mul, mul_v) = builder_new_vreg(b_cur)
						ins_m = mir_instr_new(MirOp.Mul, mir_opnd_vreg(mul_v), idx_op, mir_opnd_imm(stride))
						b_cur = builder_add_instr(b_mul, ins_m)
						term_op = mir_opnd_vreg(mul_v)
					end
					if k == 0 do
						flat_opnd = term_op
					else
						var (b_add, add_v) = builder_new_vreg(b_cur)
						ins_a = mir_instr_new(MirOp.Add, mir_opnd_vreg(add_v), flat_opnd, term_op)
						b_cur = builder_add_instr(b_add, ins_a)
						flat_opnd = mir_opnd_vreg(add_v)
					end
					k = k + 1
				end
			end
			var b3 = lower_expr(b_cur, val_expr)
			var val = g_lower_expr_result_opnd as MirOperand
			# `lower_expr` is a deep call under register pressure. Reload the
			# declared container type instead of relying on a caller-held fat
			# string surviving the call sequence.
			if is_dict_container == 0 do vtype = get_var_type(vname) end
			if bv >= 0 do
				if is_dict_container == 1 do
					out lower_dict_store(b3, mir_opnd_vreg(bv), flat_opnd, val, dict_key_is_string(ast_node_child(stmt, 0)))
				end
				b3 = emit_set_arg(b3, 0, flat_opnd)
				b3 = emit_set_arg(b3, 1, val)
				var elem_m_typ = MirType.Int64
				if is_tensor_type_str(vtype) do
					let code = parse_tensor_elem_code(vtype)
					if code == 1 do elem_m_typ = MirType.F32 end
					if code == 2 do elem_m_typ = MirType.F16 end
					if code == 3 or code == 4 do elem_m_typ = MirType.Int8 end
					if code == 5 do elem_m_typ = MirType.Int32 end
				end
				b3 = emit_intrinsic_typed(b3, MIR_INTR_INDEX_STORE, mir_opnd_none(), mir_opnd_vreg(bv), elem_m_typ)
			end
			out b3
		end
		out b
	end

	if stmt_type == AstType.SwizzleAssign do
		var target_name = ast_node_name(stmt)
		var mask_str = ast_node_name2(stmt)
		var mask_len = fat_str_len(mask_str)
		var bv = get_var_vreg(b, target_name)
		if bv >= 0 and ast_node_child_count(stmt) > 0 do
			var b2 = lower_expr(b, ast_node_child(stmt, 0))
			var rhs_op = g_lower_expr_result_opnd as MirOperand
			var b_cur = b2
			var k = 0
			when k < mask_len loop
				var ch = fat_str_byte_at(mask_str as int, k)
				var dst_lane = swizzle_char_to_lane(ch)
				if dst_lane >= 0 do
					b_cur = emit_set_arg(b_cur, 0, mir_opnd_imm(k))
					var (b_load, elem_v) = builder_new_vreg(b_cur)
					b_load = emit_intrinsic(b_load, MIR_INTR_INDEX, mir_opnd_vreg(elem_v), rhs_op)
					b_load = emit_set_arg(b_load, 0, mir_opnd_imm(dst_lane))
					b_load = emit_set_arg(b_load, 1, mir_opnd_vreg(elem_v))
					b_load = emit_intrinsic(b_load, MIR_INTR_INDEX_STORE, mir_opnd_none(), mir_opnd_vreg(bv))
					b_cur = b_load
				end
				k = k + 1
			end
			out b_cur
		end
		out b
	end

	if stmt_type == AstType.FieldAssign do
		child_count = ast_node_child_count(stmt)
		if child_count >= 1 do
			var fld_name = ast_node_name2(stmt)
			var base_name = ast_node_name(stmt)
			if child_count >= 2 do
				base_ast = ast_node_child(stmt, 1)
				if ast_node_type_of(base_ast) == AstType.Identifier do
					base_name = ast_node_name(base_ast)
				end
			end
			var bv = get_var_vreg(b, base_name)
			if is_register_field(fld_name) == 1 and bv >= 0 do
				var b2 = lower_expr(b, ast_node_child(stmt, 0))
				var val = g_lower_expr_result_opnd as MirOperand
				start_bit = get_register_field_start(fld_name)
				width = get_register_field_width(fld_name)
				let pack_info = MIR_INTR_BIT_INSERT or (start_bit shl 8) or (width shl 16)
				b2 = emit_set_arg(b2, 0, val)
				var (b3, new_vreg) = builder_new_vreg(b2)
				ins = mir_instr_new(MirOp.Intrinsic, mir_opnd_vreg(new_vreg), mir_opnd_vreg(bv), mir_opnd_imm(pack_info))
				b3 = builder_add_instr(b3, ins)
				out set_var_vreg(b3, base_name, new_vreg)
			end
			var b2 = lower_expr(b, ast_node_child(stmt, 0))
			var val = g_lower_expr_result_opnd as MirOperand
			var base_opnd = mir_opnd_none()
			var base_type = fat_str_new("")
			var b_curr = b2
			if child_count >= 2 do
				base_ast = ast_node_child(stmt, 1)
				base_type = get_expr_entity_type(base_ast)
				var b_b = lower_expr(b_curr, base_ast)
				var b_op = g_lower_expr_result_opnd as MirOperand
				b_curr = b_b
				base_opnd = b_op
			else
				base_type = get_var_type(base_name)
				if base_type != 0 do
					base_type = unwrap_ref_type_name(base_type)
				end
				if bv >= 0 do
					base_opnd = mir_opnd_vreg(bv)
				end
			end
			if (base_opnd as i64) != 0 and native_read_i64(base_opnd as i64, 0) != MirOperandType.None do
				if is_packed_entity(base_type) do
					f_off = get_scoped_field_offset(base_type, fld_name)
					f_sz = get_scoped_field_size(base_type, fld_name)
					var (b3, addr) = builder_new_vreg(b_curr)
					ins_a = mir_instr_new(MirOp.Add, mir_opnd_vreg(addr), base_opnd, mir_opnd_imm(f_off))
					b3 = builder_add_instr(b3, ins_a)
					out emit_store_typed(b3, mir_opnd_vreg(addr), val, f_sz)
				end
				var fid = 0 - 1
				if fat_str_len(base_type) > 0 do
					fid = get_scoped_field_index(base_type, fld_name)
				end
				if fid < 0 do
					base_name = ast_node_name(stmt)
					fid = find_field_index_for_base(base_name, fld_name)
				end
				var (b3, addr) = builder_new_vreg(b_curr)
				ins_a = mir_instr_new(MirOp.Add, mir_opnd_vreg(addr), base_opnd, mir_opnd_imm(fid * 8))
				b3 = builder_add_instr(b3, ins_a)
				out emit_store(b3, mir_opnd_vreg(addr), val)
			end
			out b_curr
		end
		out b
	end

    # 3. IfStmt
	if stmt_type == AstType.PrintStmt do
		child_count = ast_node_child_count(stmt)
		if child_count > 0 do
			expr = ast_node_child(stmt, 0)
			var b2 = lower_expr(b, expr)
			var val_opnd = g_lower_expr_result_opnd as MirOperand
			print_type = infer_expr_type_name(expr)
			if ast_node_type_of(expr) == AstType.LiteralStr or ast_node_type_of(expr) == AstType.InterpExpr or fat_cstr_eq(print_type, "string") == 1 do
				b2 = emit_intrinsic(b2, MIR_INTR_PRINT_STR, mir_opnd_none(), val_opnd)
			eif ast_node_type_of(expr) == AstType.LiteralBool or fat_cstr_eq(print_type, "bool") == 1 do
				b2 = emit_intrinsic(b2, MIR_INTR_PRINT_BOOL, mir_opnd_none(), val_opnd)
			eif ast_node_type_of(expr) == AstType.LiteralFloat or fat_cstr_eq(print_type, "float") == 1 do
				b2 = emit_intrinsic(b2, MIR_INTR_PRINT_FLOAT, mir_opnd_none(), val_opnd)
			else
				b2 = emit_intrinsic(b2, MIR_INTR_PRINT, mir_opnd_none(), val_opnd)
			end
			out b2
		end
		out b
	end

    # 8. Break / Continue
	if stmt_type == AstType.InferBlock do
		b = emit_intrinsic(b, MIR_INTR_INFER, mir_opnd_none(), mir_opnd_none())
		if ast_node_child_count(stmt) > 0 do
			out lower_stmt(b, ast_node_child(stmt, 0))
		end
		out b
	end
	if stmt_type == AstType.TrainBlock do
		b = emit_intrinsic(b, MIR_INTR_TRAIN, mir_opnd_none(), mir_opnd_none())
		if ast_node_child_count(stmt) > 0 do
			out lower_stmt(b, ast_node_child(stmt, 0))
		end
		out b
	end
	if stmt_type == AstType.PrecompBlock do
		out b
	end
	if stmt_type == AstType.AtomicVarDecl do
		b = emit_intrinsic(b, MIR_INTR_ATOMIC_VAR, mir_opnd_none(), mir_opnd_none())
		if ast_node_child_count(stmt) > 0 do
			out lower_stmt(b, ast_node_child(stmt, 0))
		end
		out b
	end
	if stmt_type == AstType.ReactiveDecl do
		var (b1, nid) = builder_intern(b, ast_node_name(stmt))
		b1 = emit_set_arg(b1, 0, mir_opnd_imm(nid))
		b1 = emit_intrinsic(b1, MIR_INTR_REACTIVE, mir_opnd_none(), mir_opnd_imm(nid))
		if ast_node_child_count(stmt) > 0 do
			var b2 = lower_expr(b1, ast_node_child(stmt, 0))
			out b2
		end
		out b1
	end
	if stmt_type == AstType.MorphDecl do
		var (b1, nid) = builder_intern(b, ast_node_name(stmt))
		b1 = emit_set_arg(b1, 0, mir_opnd_imm(nid))
		b1 = emit_intrinsic(b1, MIR_INTR_MORPH, mir_opnd_none(), mir_opnd_imm(nid))
		if ast_node_child_count(stmt) > 0 do
			var b2 = lower_expr(b1, ast_node_child(stmt, 0))
			out b2
		end
		out b1
	end
	if stmt_type == AstType.ExposeAttr do
		b = emit_intrinsic(b, MIR_INTR_EXPOSE, mir_opnd_none(), mir_opnd_none())
		if ast_node_child_count(stmt) > 0 do
			out lower_stmt(b, ast_node_child(stmt, 0))
		end
		out b
	end
    # Decl-style stmts inside functions → DECL markers
	if stmt_type == AstType.TypeAlias or stmt_type == AstType.LazyIncludeStmt or stmt_type == AstType.ShareDecl or stmt_type == AstType.HasDecl or stmt_type == AstType.ClassDef or stmt_type == AstType.DictDecl or stmt_type == AstType.TensorDecl or stmt_type == AstType.FluxDecl do
		out lower_decl_marker(b, stmt)
	end
	if stmt_type == AstType.BundleExpr or stmt_type == AstType.MapExpr or stmt_type == AstType.ArrCompactExpr or stmt_type == AstType.ErrorExpr or stmt_type == AstType.PtrTypeExpr or stmt_type == AstType.ExistExpr or stmt_type == AstType.PatternExpr or stmt_type == AstType.AddrOf or stmt_type == AstType.ErxExpr do
		var b2 = lower_expr(b, stmt)
		out b2
	end

    # 15. Expr-as-stmt
	if stmt_type == AstType.Call or stmt_type == AstType.BuiltinCall or stmt_type == AstType.MethodCall or stmt_type == AstType.AwaitExpr or stmt_type == AstType.TaskExpr or stmt_type == AstType.WaitExpr or stmt_type == AstType.QuantizeExpr do
		var b2 = lower_expr(b, stmt)
		out b2
	end

	out b
end.


func lower_stmt(b: &MirBuilder, stmt: &AstNode):
	# MirBuilder is mutated in place. In native self-host output the large
	# lower_stmt_impl return CFG can occasionally leave an AstType/boolean in
	# X0 instead of the builder pointer (for example 2 after a terminated
	# function body). Preserve the input handle in that case; all mutations
	# performed by the lowering call are already visible through it.
	lowered_b = lower_stmt_impl(b, stmt)
	out b
end.
