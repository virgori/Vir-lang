##
 * compiler/src/lower/ast_to_mir/layout/field_layout.vri — scoped field layout, entity lookup and register fields
 * VIRC-PLN-0009: extracted verbatim from compiler/src/lower/ast_to_mir/layout.vri.
 ##

include types_prelude
include rt_vec_rt
include rt_string_rt
include parser
include mir
include ast_to_mir_context

func get_scoped_field_type(entity_name: &string, field_name: &string):
    if g_scoped_field_hash != 0 and entity_name != 0 and field_name != 0 do
        dot_str = fat_str_new(".")
        scoped_key = fat_str_concat(fat_str_concat(entity_name as string, dot_str), field_name as string)
        idx_s = hash_table_lookup(g_scoped_field_hash, g_scoped_field_names, scoped_key)
        if idx_s >= 0 do
            out vec_get_rt(g_scoped_field_types, idx_s) as string
        end
        base_name = extract_base_entity_name(entity_name)
        if fat_str_eq(base_name, entity_name as string) == 0 do
            scoped_key2 = fat_str_concat(fat_str_concat(base_name, dot_str), field_name as string)
            idx_s2 = hash_table_lookup(g_scoped_field_hash, g_scoped_field_names, scoped_key2)
            if idx_s2 >= 0 do
                out vec_get_rt(g_scoped_field_types, idx_s2) as string
            end
        end
    end
    out fat_str_new("")
end.

func get_scoped_field_index(entity_name: &string, field_name: &string):
    if g_scoped_field_hash != 0 and entity_name != 0 and field_name != 0 do
        dot_str = fat_str_new(".")
        scoped_key = fat_str_concat(fat_str_concat(entity_name as string, dot_str), field_name as string)
        idx_s = hash_table_lookup(g_scoped_field_hash, g_scoped_field_names, scoped_key)
        if idx_s >= 0 do
            out vec_get_rt(g_scoped_field_indices, idx_s)
        end
        base_name = extract_base_entity_name(entity_name)
        if fat_str_eq(base_name, entity_name as string) == 0 do
            scoped_key2 = fat_str_concat(fat_str_concat(base_name, dot_str), field_name as string)
            idx_s2 = hash_table_lookup(g_scoped_field_hash, g_scoped_field_names, scoped_key2)
            if idx_s2 >= 0 do
                out vec_get_rt(g_scoped_field_indices, idx_s2)
            end
        end
    end
    out 0 - 1
end.

func get_scoped_field_offset(entity_name: &string, field_name: &string):
    if g_scoped_field_hash != 0 and entity_name != 0 and field_name != 0 do
        dot_str = fat_str_new(".")
        scoped_key = fat_str_concat(fat_str_concat(entity_name as string, dot_str), field_name as string)
        idx_s = hash_table_lookup(g_scoped_field_hash, g_scoped_field_names, scoped_key)
        if idx_s >= 0 and idx_s < vec_len_rt(g_scoped_field_offsets) do
            out vec_get_rt(g_scoped_field_offsets, idx_s)
        end
        base_name = extract_base_entity_name(entity_name)
        if fat_str_eq(base_name, entity_name as string) == 0 do
            scoped_key2 = fat_str_concat(fat_str_concat(base_name, dot_str), field_name as string)
            idx_s2 = hash_table_lookup(g_scoped_field_hash, g_scoped_field_names, scoped_key2)
            if idx_s2 >= 0 and idx_s2 < vec_len_rt(g_scoped_field_offsets) do
                out vec_get_rt(g_scoped_field_offsets, idx_s2)
            end
        end
    end
    out 0
end.

