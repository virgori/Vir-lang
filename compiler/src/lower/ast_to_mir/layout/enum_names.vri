##
 * compiler/src/lower/ast_to_mir/layout/enum_names.vri — enum variant layout and qualified member names
 * VIRC-PLN-0009: extracted verbatim from compiler/src/lower/ast_to_mir/layout.vri.
 ##

include types_prelude
include rt_vec_rt
include rt_string_rt
include parser
include mir
include ast_to_mir_context

func enum_index_from_type_name(type_name: string):
    if type_name == 0 or g_enum_names == 0 do out 0 - 1 end
    exact = hash_table_lookup(g_enum_hash, g_enum_names, type_name)
    if exact >= 0 do out exact end
    # Generic specialization `Option of (T)` shares the declaration's canonical
    # layout; match the declaration name before the first '<' or '('.
    n = fat_str_len(type_name)
    var cut = n
    var i = 0
    when i < n loop
        let b = fat_str_byte_at(type_name, i)
        if b == 60 or b == 40 do
            cut = i
            i = n
        else
            i = i + 1
        end
    end
    if cut < n do
        when cut > 0 and fat_str_byte_at(type_name, cut - 1) == 32 loop
            cut = cut - 1
        end
        if cut >= 2 and fat_str_byte_at(type_name, cut - 2) == 111 and fat_str_byte_at(type_name, cut - 1) == 102 do
            if cut == 2 or fat_str_byte_at(type_name, cut - 3) == 32 do
                cut = cut - 2
                when cut > 0 and fat_str_byte_at(type_name, cut - 1) == 32 loop
                    cut = cut - 1
                end
            end
        end
        data = native_read_i64(type_name as i64, 0)
        var ei = 0
        when ei < vec_len_rt(g_enum_names) loop
            en = vec_get_rt(g_enum_names, ei) as string
            if fat_str_len(en) == cut do
                var same = 1
                var j = 0
                when j < cut and same == 1 loop
                    if native_read_u8(data, j) != fat_str_byte_at(en, j) do same = 0 end
                    j = j + 1
                end
                if same == 1 do out ei end
            end
            ei = ei + 1
        end
    end
    out 0 - 1
end.

func enum_variant_index(enum_name: &string, variant_name: &string):
    if g_enum_variant_names == 0 do out 0 - 1 end
    if enum_name != 0 and fat_str_len(enum_name) > 0 do
        key = qualified_member_name(enum_name as string, variant_name as string)
        out hash_table_lookup(g_enum_variant_hash, g_enum_variant_keys, key)
    end
    # Unqualified constructor: semantic resolution has already selected the
    # declaration for expression nodes.  Patterns use the target enum type
    # when available and fall back to the first matching imported variant.
    var i = 0
    when i < vec_len_rt(g_enum_variant_names) loop
        if fat_str_eq(vec_get_rt(g_enum_variant_names, i) as string, variant_name as string) == 1 do
            out i
        end
        i = i + 1
    end
    out 0 - 1
end.

func enum_variant_index_for_target(target: &AstNode, enum_qualifier: string, variant_name: string):
    if enum_qualifier != 0 and fat_str_len(enum_qualifier) > 0 do
        out enum_variant_index(enum_qualifier as i64, variant_name as i64)
    end
    if target != 0 and ast_node_type_of(target) == AstType.Identifier do
        target_type = get_var_type(ast_node_name(target))
        enum_idx = enum_index_from_type_name(target_type)
        if enum_idx >= 0 do
            enum_name = vec_get_rt(g_enum_names, enum_idx) as string
            exact = enum_variant_index(enum_name as i64, variant_name as i64)
            if exact >= 0 do out exact end
        end
    end
    out enum_variant_index(fat_str_new("") as i64, variant_name as i64)
end.

func enum_variant_is_tagged(variant_idx: int):
    if variant_idx < 0 do out false end
    enum_idx = vec_get_rt(g_enum_variant_enum_indices, variant_idx)
    out vec_get_rt(g_enum_is_tagged, enum_idx) == 1
end.

func enum_variant_layout_size(variant_idx: int):
    if variant_idx < 0 do out ENUM_TAG_SLOT_SIZE end
    enum_idx = vec_get_rt(g_enum_variant_enum_indices, variant_idx)
    out vec_get_rt(g_enum_sizes, enum_idx)
end.

func enum_variant_index_for_type_name(type_name: &string, variant_name: &string):
    enum_idx = enum_index_from_type_name(type_name)
    if enum_idx < 0 do out enum_variant_index(fat_str_new("") as i64, variant_name as i64) end
    out enum_variant_index(vec_get_rt(g_enum_names, enum_idx), variant_name as i64)
end.

func enum_variant_tag(variant_idx: int):
    if variant_idx < 0 do out 0 end
    out vec_get_rt(g_enum_variant_tags, variant_idx)
end.

func enum_variant_arity(variant_idx: int):
    if variant_idx < 0 do out 0 end
    out vec_get_rt(g_enum_variant_arities, variant_idx)
end.

func enum_variant_payload_type(variant_idx: int, slot_idx: int):
    if (g_enum_variant_nodes as i64) == 0 do out fat_str_new("") end
    if variant_idx < 0 or variant_idx >= vec_len_rt(g_enum_variant_nodes) do
        out fat_str_new("")
    end
    vnode = vec_get_rt(g_enum_variant_nodes, variant_idx) as AstNode
    if (vnode as i64) == 0 do out fat_str_new("") end
    if slot_idx < 0 or slot_idx >= ast_node_child_count(vnode) do
        out fat_str_new("")
    end
    p_def = ast_node_child(vnode, slot_idx)
    out ast_node_name2(p_def)
end.

func qualified_member_name(entity_name: string, member_name: string):
    out fat_str_concat(fat_str_concat(entity_name, fat_str_new(".")), member_name)
end.

func get_scoped_method_name(entity_name: string, method_name: string):
    if g_scoped_method_hash != 0 and entity_name != 0 and method_name != 0 do
        key = qualified_member_name(entity_name, method_name)
        if hash_table_lookup(g_scoped_method_hash, g_scoped_method_names, key) >= 0 do
            out key
        end
    end
    out fat_str_new("")
end.

func scoped_field_is_callable(entity_name: string, field_name: string):
    field_type = get_scoped_field_type(entity_name, field_name)
    if fat_str_len(field_type) >= 4 do
        if fat_str_byte_at(field_type, 0) == 102 and fat_str_byte_at(field_type, 1) == 117 and fat_str_byte_at(field_type, 2) == 110 and fat_str_byte_at(field_type, 3) == 99 do out 1 end
    end
    if fat_cstr_eq(field_type, "ptr") == 1 do out 1 end
    out 0
end.

func count_list_items(s: &string):
    slen = fat_str_len(s)
    if slen <= 0 do out 0 end
    var count = 1
    var angle_depth = 0
    var paren_depth = 0
    var bracket_depth = 0
    var i = 0
    when i < slen loop
        b = fat_str_byte_at(s, i)
        if b == 60 do angle_depth = angle_depth + 1 end
        if b == 62 and angle_depth > 0 do angle_depth = angle_depth - 1 end
        if b == 40 do paren_depth = paren_depth + 1 end
        if b == 41 and paren_depth > 0 do paren_depth = paren_depth - 1 end
        if b == 91 do bracket_depth = bracket_depth + 1 end
        if b == 93 and bracket_depth > 0 do bracket_depth = bracket_depth - 1 end
        if b == 44 and angle_depth == 0 and paren_depth == 0 and bracket_depth == 0 do
            count = count + 1
        end
        i = i + 1
    end
    out count
end.

func get_list_item(s: &string, target_idx: int):
    slen = fat_str_len(s)
    if slen <= 0 do out fat_str_new("") end
    var cur_idx = 0
    var start = 0
    var angle_depth = 0
    var paren_depth = 0
    var bracket_depth = 0
    var i = 0
    when i <= slen loop
        var at_split = false
        if i == slen do
            at_split = true
        else
            b = fat_str_byte_at(s, i)
            if b == 60 do angle_depth = angle_depth + 1 end
            if b == 62 and angle_depth > 0 do angle_depth = angle_depth - 1 end
            if b == 40 do paren_depth = paren_depth + 1 end
            if b == 41 and paren_depth > 0 do paren_depth = paren_depth - 1 end
            if b == 91 do bracket_depth = bracket_depth + 1 end
            if b == 93 and bracket_depth > 0 do bracket_depth = bracket_depth - 1 end
            if b == 44 and angle_depth == 0 and paren_depth == 0 and bracket_depth == 0 do
                at_split = true
            end
        end
        if at_split do
            if cur_idx == target_idx do
                var item_start = start
                when item_start < i and fat_str_byte_at(s, item_start) == 32 loop
                    item_start = item_start + 1
                end
                var item_end = i
                when item_end > item_start and fat_str_byte_at(s, item_end - 1) == 32 loop
                    item_end = item_end - 1
                end
                out fat_str_slice(s, item_start, item_end - item_start)
            end
            cur_idx = cur_idx + 1
            start = i + 1
        end
        i = i + 1
    end
    out fat_str_new("")
end.

func extract_base_entity_name(type_str: &string):
    if is_quantized_type_str(type_str as int) do
        let q_codec = parse_quantized_codec(type_str as int)
        if q_codec == Q_CODEC_Q8_0 do
            out fat_str_new("Q80TensorView")
        end
    end
    slen = fat_str_len(type_str as string)
    if slen <= 0 do out fat_str_new("") end
    var i = 0
    var end_pos = 0 - 1
    when i < slen loop
        let b = fat_str_byte_at(type_str as string, i)
        if b == 60 or b == 40 do
            end_pos = i
            i = slen
        else
            i = i + 1
        end
    end
    if end_pos >= 0 do
        when end_pos > 0 and fat_str_byte_at(type_str as string, end_pos - 1) == 32 loop
            end_pos = end_pos - 1
        end
        if end_pos >= 2 and fat_str_byte_at(type_str as string, end_pos - 2) == 111 and fat_str_byte_at(type_str as string, end_pos - 1) == 102 do
            if end_pos == 2 or fat_str_byte_at(type_str as string, end_pos - 3) == 32 do
                end_pos = end_pos - 2
                when end_pos > 0 and fat_str_byte_at(type_str as string, end_pos - 1) == 32 loop
                    end_pos = end_pos - 1
                end
            end
        end
        out fat_str_slice(type_str as string, 0, end_pos)
    end
    out type_str as string
end.

func extract_generic_args_content(type_str: &string):
    slen = fat_str_len(type_str as string)
    var lt = 0 - 1
    var gt = 0 - 1
    var depth = 0
    var i = 0
    when i < slen loop
        b = fat_str_byte_at(type_str as string, i)
        if b == 60 or b == 40 do                      # '<' or '('
            if depth == 0 do lt = i end
            depth = depth + 1
        end
        if b == 62 or b == 41 do                      # '>' or ')'
            depth = depth - 1
            if depth == 0 and gt < 0 do gt = i end   # first outermost '>' or ')'
        end
        i = i + 1
    end
    if lt >= 0 and gt > lt do
        out fat_str_slice(type_str as string, lt + 1, gt - lt - 1)
    end
    out fat_str_new("")
end.
