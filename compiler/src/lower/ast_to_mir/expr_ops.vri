##
 * compiler/src/lower/ast_to_mir/expr_ops.vri — Operators & Unary Expressions
 * ===========================================================================
 ##

include types
include vec_rt
include string_rt
include parser
include mir
include ast_to_mir_context
include ast_to_mir_layout
include ast_to_mir_builder

# ═══════════════════════════════════════════════════════
# Operator Expression Lowering Dispatcher
# ═══════════════════════════════════════════════════════
func lower_expr_ops(b: MirBuilder, expr: &AstNode, expr_type: AstType):
	if expr_type == AstType.BinOp or expr_type == AstType.Compare do
		child_count = ast_node_child_count(expr)
		if child_count >= 2 do
			left = ast_node_child(expr, 0)
			right = ast_node_child(expr, 1)
			mop_i = mir_op_from_optype(ast_node_op_of(expr))

            # Land: if !lhs → 0 else rhs
			if mop_i == -2 do
				var b1 = lower_expr(b, left)
				var opnd_l = g_lower_expr_result_opnd as MirOperand
				var (b2, dst) = builder_new_vreg(b1)
				var (b3, rhs_id) = builder_add_block(b2)
				var (b4, end_id) = builder_add_block(b3)
				b4 = emit_move(b4, dst, mir_opnd_imm(0))
				b4 = emit_jump_if_not(b4, opnd_l, end_id, rhs_id)
				b4 = builder_set_current_block(b4, rhs_id)
				var b5 = lower_expr(b4, right)
				var opnd_r = g_lower_expr_result_opnd as MirOperand
				b5 = emit_move(b5, dst, opnd_r)
				b5 = emit_jump(b5, end_id)
				b5 = builder_set_current_block(b5, end_id)
				out expr_result(b5, mir_opnd_vreg(dst))
			end

            # Lor: if lhs → 1 else rhs
			if mop_i == -3 do
				var b1 = lower_expr(b, left)
				var opnd_l = g_lower_expr_result_opnd as MirOperand
				var (b2, dst) = builder_new_vreg(b1)
				var (b3, rhs_id) = builder_add_block(b2)
				var (b4, end_id) = builder_add_block(b3)
				b4 = emit_move(b4, dst, mir_opnd_imm(1))
				b4 = emit_jump_if(b4, opnd_l, end_id, rhs_id)
				b4 = builder_set_current_block(b4, rhs_id)
				var b5 = lower_expr(b4, right)
				var opnd_r = g_lower_expr_result_opnd as MirOperand
				b5 = emit_move(b5, dst, opnd_r)
				b5 = emit_jump(b5, end_id)
				b5 = builder_set_current_block(b5, end_id)
				out expr_result(b5, mir_opnd_vreg(dst))
			end

            # PatternOp `:~` → MIR_INTR_PATTERN
			if mop_i == -4 do
				var b3 = lower_expr(b, left)
				var opnd_l = g_lower_expr_result_opnd as MirOperand
				var b4 = lower_expr(b3, right)
				var opnd_r = g_lower_expr_result_opnd as MirOperand
				var (b5, dst) = builder_new_vreg(b4)
				b5 = emit_set_arg(b5, 0, opnd_l)
				b5 = emit_set_arg(b5, 1, opnd_r)
				out expr_result(emit_intrinsic(b5, MIR_INTR_PATTERN, mir_opnd_vreg(dst), opnd_l), mir_opnd_vreg(dst))
			end

			if mop_i < 0 do
                # Unknown OpType — emit Nop marker, return 0 (never default Add)
				var (b1, dst) = builder_new_vreg(b)
				b1 = emit_intrinsic(b1, MIR_INTR_NOP_MARKER, mir_opnd_vreg(dst), mir_opnd_imm(ast_node_op_of(expr) as i64))
				out expr_result(b1, mir_opnd_vreg(dst))
			end

			var b3 = lower_expr(b, left)
			var opnd_l = g_lower_expr_result_opnd as MirOperand
			var b4 = lower_expr(b3, right)
			var opnd_r = g_lower_expr_result_opnd as MirOperand
			var (b5, dst) = builder_new_vreg(b4)
			var m_op = MirOp.Add
			if mop_i == 5 do m_op = MirOp.Sub end
			if mop_i == 6 do m_op = MirOp.Mul end
			if mop_i == 7 do m_op = MirOp.Div end
			if mop_i == 19 do m_op = MirOp.Mod end
			if mop_i == 13 do m_op = MirOp.CmpEq end
			if mop_i == 14 do m_op = MirOp.CmpNe end
			if mop_i == 15 do m_op = MirOp.CmpGt end
			if mop_i == 16 do m_op = MirOp.CmpLt end
			if mop_i == 17 do m_op = MirOp.CmpGe end
			if mop_i == 18 do m_op = MirOp.CmpLe end
			if mop_i == 22 do m_op = MirOp.And end
			if mop_i == 23 do m_op = MirOp.Or end
			if mop_i == 24 do m_op = MirOp.Xor end
			if mop_i == 25 do m_op = MirOp.Shl end
			if mop_i == 26 do m_op = MirOp.Shr end
			if mop_i == 28 do m_op = MirOp.Pow end
			if mop_i == 29 do m_op = MirOp.MatMul end
			if mop_i == 30 do m_op = MirOp.Fma end
			var bin_lt = fat_str_new("")
			var bin_rt = fat_str_new("")
			if (mop_i >= 4 and mop_i <= 8) or mop_i == 19 do
				bin_lt = infer_expr_type_name(left)
				bin_rt = infer_expr_type_name(right)
			end
			if mop_i == 4 and (fat_cstr_eq(bin_lt, "string") == 1 or fat_cstr_eq(bin_rt, "string") == 1) do
				b5 = emit_set_arg(b5, 0, opnd_l)
				b5 = emit_set_arg(b5, 1, opnd_r)
				var (b_cat, res_v) = builder_new_vreg(b5)
				b_cat = emit_intrinsic(b_cat, MIR_INTR_BUILTIN, mir_opnd_vreg(res_v), mir_opnd_imm(11))
				out expr_result(b_cat, mir_opnd_vreg(res_v))
			end
			if is_flux_type_str(bin_lt) or is_flux_type_str(bin_rt) do
				var f_lanes = 4
				if is_flux_type_str(bin_lt) do
					f_lanes = parse_flux_lanes(bin_lt)
				else
					f_lanes = parse_flux_lanes(bin_rt)
				end
				if f_lanes <= 0 do f_lanes = 4 end
				# Shape and element-type compatibility check [E3001]
				if is_flux_type_str(bin_lt) and is_flux_type_str(bin_rt) do
					let r_lanes = parse_flux_lanes(bin_rt)
					let l_elem = parse_flux_elem_type(bin_lt) as int
					let r_elem = parse_flux_elem_type(bin_rt) as int
					if r_lanes > 0 and r_lanes != f_lanes do
						print_str("virc: error: [E3001] flux lane count mismatch in binary op\n")
						sys_exit(1)
					end
					if l_elem != r_elem do
						print_str("virc: error: [E3001] flux element type mismatch in binary op\n")
						sys_exit(1)
					end
				end
				if is_flux_type_str(bin_lt) and not is_flux_type_str(bin_rt) do
					let l_elem = parse_flux_elem_type(bin_lt) as int
					let r_is_float = fat_cstr_eq(bin_rt, "float") == 1 or fat_cstr_eq(bin_rt, "f64") == 1 or fat_cstr_eq(bin_rt, "f32") == 1
					if (l_elem == (TypeKind.Int as int) and r_is_float) or (l_elem == (TypeKind.Float as int) and not r_is_float) do
						print_str("virc: error: [E3001] flux element and scalar operand type mismatch in binary op\n")
						sys_exit(1)
					end
				end
				if not is_flux_type_str(bin_lt) and is_flux_type_str(bin_rt) do
					let r_elem = parse_flux_elem_type(bin_rt) as int
					let l_is_float = fat_cstr_eq(bin_lt, "float") == 1 or fat_cstr_eq(bin_lt, "f64") == 1 or fat_cstr_eq(bin_lt, "f32") == 1
					if (r_elem == (TypeKind.Int as int) and l_is_float) or (r_elem == (TypeKind.Float as int) and not l_is_float) do
						print_str("virc: error: [E3001] flux element and scalar operand type mismatch in binary op\n")
						sys_exit(1)
					end
				end
				var m_v_op = MirOp.VAdd
				if mop_i == 4 do m_v_op = MirOp.VAdd end
				if mop_i == 5 do m_v_op = MirOp.VSub end
				if mop_i == 6 do m_v_op = MirOp.VMul end
				let alloc_sz = 16 + f_lanes * 8
				b5 = emit_set_arg(b5, 0, mir_opnd_imm(alloc_sz))
				var (b_fres, f_base) = builder_new_vreg(b5)
				ins_f_alloc = mir_instr_new(MirOp.Intrinsic as i64, mir_opnd_vreg(f_base) as i64, mir_opnd_imm(3) as i64, mir_opnd_imm(MIR_INTR_BUILTIN) as i64)
				annotate_owned_alloc(ins_f_alloc, f_base, alloc_sz, 16, ast_node_line(expr))
				b_fres = builder_add_instr(b_fres, ins_f_alloc)
				b_fres = emit_set_arg(b_fres, 0, mir_opnd_vreg(f_base))
				b_fres = emit_set_arg(b_fres, 1, mir_opnd_imm(0))
				b_fres = emit_set_arg(b_fres, 2, mir_opnd_imm(f_lanes))
				b_fres = emit_intrinsic(b_fres, MIR_INTR_BUILTIN, mir_opnd_none(), mir_opnd_imm(8))
				b_fres = emit_set_arg(b_fres, 0, mir_opnd_vreg(f_base))
				b_fres = emit_set_arg(b_fres, 1, mir_opnd_imm(8))
				b_fres = emit_set_arg(b_fres, 2, mir_opnd_imm(f_lanes))
				b_fres = emit_intrinsic(b_fres, MIR_INTR_BUILTIN, mir_opnd_none(), mir_opnd_imm(8))
				var is_float_elem = false
				if is_flux_type_str(bin_lt) do
					is_float_elem = (parse_flux_elem_type(bin_lt) as int) == (TypeKind.Float as int)
				eif is_flux_type_str(bin_rt) do
					is_float_elem = (parse_flux_elem_type(bin_rt) as int) == (TypeKind.Float as int)
				eif fat_cstr_eq(bin_lt, "float") == 1 or fat_cstr_eq(bin_lt, "f64") == 1 or fat_cstr_eq(bin_rt, "float") == 1 or fat_cstr_eq(bin_rt, "f64") == 1 do
					is_float_elem = true
				end
				var is_l_scalar = 0
				var is_r_scalar = 0
				if not is_flux_type_str(bin_lt) do is_l_scalar = 1 end
				if not is_flux_type_str(bin_rt) do is_r_scalar = 1 end
				var elem_code = 1
				if is_float_elem do elem_code = 2 end
				var v_flags = (is_l_scalar) or (is_r_scalar shl 1)
				let v_aux = vec_aux_pack(elem_code, f_lanes, 16, v_flags)
				var v_ins = mir_instr_new(m_v_op as i64, mir_opnd_vreg(f_base) as i64, opnd_l, opnd_r)
				mir_instr_set_type(v_ins, MirType.Vector as i64)
				mir_instr_set_aux(v_ins, v_aux)
				b_fres = builder_add_instr(b_fres, v_ins)
				out expr_result(b_fres, mir_opnd_vreg(f_base))
			end
			if mop_i == 4 do m_op = MirOp.Add end
			ins = mir_instr_new(m_op, mir_opnd_vreg(dst), opnd_l, opnd_r)
			if fat_cstr_eq(bin_lt, "float") == 1 or fat_cstr_eq(bin_lt, "f64") == 1 or fat_cstr_eq(bin_rt, "float") == 1 or fat_cstr_eq(bin_rt, "f64") == 1 do
				mir_instr_set_type(ins, MirType.F64 as i64)
			end
			if mop_i == 28 and ast_node_int_val(expr) == 1 do
				mir_instr_set_type(ins, MirType.F64 as i64)
			end
			if mop_i == 29 or mop_i == 30 do
				# Semantic pass 6 guarantees known rank-2 operands.  Zero is an
				# invalid sentinel, never a guessed 2x2 shape.
				var dim_m = 0
				var dim_k = 0
				var dim_n = 0
				var left_t = ""
				var right_t = ""
				if ast_node_type_of(left) == AstType.Identifier do
					left_t = get_var_type(ast_node_name(left))
				end
				if ast_node_type_of(right) == AstType.Identifier do
					right_t = get_var_type(ast_node_name(right))
				end
				var is_quantized = 0
				if (is_tensor_type_str(left_t) or is_quantized_type_str(left_t as int)) and is_tensor_type_str(right_t) do
					var shape_a = 0
					if is_quantized_type_str(left_t as int) do
						is_quantized = 1
						shape_a = parse_quantized_shape(left_t as int)
					else
						shape_a = parse_tensor_shape(left_t)
					end
					shape_b = parse_tensor_shape(right_t)
					if vec_len_rt(shape_a) >= 2 and vec_len_rt(shape_b) >= 2 do
						dim_m = vec_get_rt(shape_a, 0) as int
						dim_k = vec_get_rt(shape_a, 1) as int
						dim_n = vec_get_rt(shape_b, 1) as int
					end
				end
				var is_32bit = 0
				var is_float = 0
				if is_quantized == 1 do
					is_float = 1
					is_32bit = 1
				else
					let elem_sz = tensor_elem_byte_size(left_t)
					if elem_sz == 4 do
						is_32bit = 1
					end
					let t_code = parse_tensor_elem_code(left_t)
					if t_code == 1 or t_code == 2 or t_code == 7 do
						is_float = 1
					end
				end
				let aux_val = (is_quantized shl 50) + (is_32bit shl 49) + (is_float shl 48) + (dim_m shl 32) + (dim_k shl 16) + dim_n
				mir_instr_set_aux(ins, aux_val)
				if is_float == 1 do
					mir_instr_set_type(ins, MirType.F64 as i64)
				eif is_32bit == 1 do
					mir_instr_set_type(ins, MirType.Int32 as i64)
				else
					mir_instr_set_type(ins, MirType.Int64 as i64)
				end
			end
			b5 = builder_add_instr(b5, ins)
			out expr_result(b5, mir_opnd_vreg(dst))
		end
	end

    # 5b. UnaryNot → MirOp.Not
	if expr_type == AstType.UnaryNot do
		if ast_node_child_count(expr) > 0 do
			var b2 = lower_expr(b, ast_node_child(expr, 0))
			var opnd = g_lower_expr_result_opnd as MirOperand
			var (b3, dst) = builder_new_vreg(b2)
			ins = mir_instr_new(MirOp.Not, mir_opnd_vreg(dst), opnd, mir_opnd_none())
			b3 = builder_add_instr(b3, ins)
			out expr_result(b3, mir_opnd_vreg(dst))
		end
	end

    # 5c. Swizzle / SafeAccess
	if expr_type == AstType.SwizzleExpr do
		if ast_node_child_count(expr) > 0 do
			var b2 = lower_expr(b, ast_node_child(expr, 0))
			var base = g_lower_expr_result_opnd as MirOperand
			var mask = ast_node_name(expr)
			var m_len = fat_str_len(mask)
			let alloc_sz = 16 + m_len * 8
			var b_mut = emit_set_arg(b2, 0, mir_opnd_imm(alloc_sz))
			var (b_dst, dst_base) = builder_new_vreg(b_mut)
			ins_alloc = mir_instr_new(MirOp.Intrinsic as i64, mir_opnd_vreg(dst_base) as i64, mir_opnd_imm(3) as i64, mir_opnd_imm(MIR_INTR_BUILTIN) as i64)
			annotate_owned_alloc(ins_alloc, dst_base, alloc_sz, 16, ast_node_line(expr))
			b_dst = builder_add_instr(b_dst, ins_alloc)
			b_mut = b_dst
			b_mut = emit_set_arg(b_mut, 0, mir_opnd_vreg(dst_base))
			b_mut = emit_set_arg(b_mut, 1, mir_opnd_imm(0))
			b_mut = emit_set_arg(b_mut, 2, mir_opnd_imm(m_len))
			b_mut = emit_intrinsic(b_mut, MIR_INTR_BUILTIN, mir_opnd_none(), mir_opnd_imm(8))
			b_mut = emit_set_arg(b_mut, 0, mir_opnd_vreg(dst_base))
			b_mut = emit_set_arg(b_mut, 1, mir_opnd_imm(8))
			b_mut = emit_set_arg(b_mut, 2, mir_opnd_imm(m_len))
			b_mut = emit_intrinsic(b_mut, MIR_INTR_BUILTIN, mir_opnd_none(), mir_opnd_imm(8))
			var mask_val: i64 = 0
			var si = 0
			when si < m_len loop
				var sc = fat_str_byte_at(mask as int, si)
				var src_lane = swizzle_char_to_lane(sc)
				if src_lane < 0 do src_lane = 0 end
				mask_val = mask_val or ((src_lane and 15) shl (si * 4))
				si = si + 1
			end
			var sh_ins = mir_instr_new(MirOp.Shuffle as i64, mir_opnd_vreg(dst_base) as i64, base, mir_opnd_imm(mask_val))
			mir_instr_set_type(sh_ins, MirType.Vector as i64)
			var sh_elem = 1
			let sh_c_t = infer_expr_type_name(ast_node_child(expr, 0))
			if is_flux_type_str(sh_c_t) and (parse_flux_elem_type(sh_c_t) as int) == (TypeKind.Float as int) do
				sh_elem = 2
			end
			let sh_aux = (vec_aux_pack(sh_elem, m_len, 16, 0) and 0xFFFFFFFF) or (mask_val shl 32)
			mir_instr_set_aux(sh_ins, sh_aux)
			b_mut = builder_add_instr(b_mut, sh_ins)
			out expr_result(b_mut, mir_opnd_vreg(dst_base))
		end
	end
	if expr_type == AstType.SafeAccessExpr do
		var (b1, fid) = builder_intern(b, ast_node_name(expr))
		if ast_node_child_count(expr) > 0 do
			var b2 = lower_expr(b1, ast_node_child(expr, 0))
			var base = g_lower_expr_result_opnd as MirOperand
			var (b3, dst) = builder_new_vreg(b2)
			b3 = emit_set_arg(b3, 0, base)
			b3 = emit_set_arg(b3, 1, mir_opnd_imm(fid))
			out expr_result(emit_intrinsic(b3, MIR_INTR_SAFE_ACCESS, mir_opnd_vreg(dst), mir_opnd_imm(fid)), mir_opnd_vreg(dst))
		end
	end

    # 5d. Erx / Task / Wait / Quantize
	if expr_type == AstType.ErxExpr do
		if g_try_err_vreg >= 0 do
			out expr_result(b, mir_opnd_vreg(g_try_err_vreg))
		end
		var (b1, dst) = builder_new_vreg(b)
		out expr_result(emit_intrinsic(b1, MIR_INTR_ERX, mir_opnd_vreg(dst), mir_opnd_none()), mir_opnd_vreg(dst))
	end
	if expr_type == AstType.TaskExpr do
		if ast_node_child_count(expr) > 0 do
			var b2 = lower_expr(b, ast_node_child(expr, 0))
			var v = g_lower_expr_result_opnd as MirOperand
			var (b3, dst) = builder_new_vreg(b2)
			out expr_result(emit_intrinsic(b3, MIR_INTR_TASK, mir_opnd_vreg(dst), v), mir_opnd_vreg(dst))
		end
	end
	if expr_type == AstType.WaitExpr do
		if ast_node_child_count(expr) > 0 do
			var b2 = lower_expr(b, ast_node_child(expr, 0))
			var v = g_lower_expr_result_opnd as MirOperand
			var (b3, dst) = builder_new_vreg(b2)
			out expr_result(emit_intrinsic(b3, MIR_INTR_WAIT, mir_opnd_vreg(dst), v), mir_opnd_vreg(dst))
		end
	end
	if expr_type == AstType.QuantizeExpr do
		if ast_node_child_count(expr) > 0 do
			var b2 = lower_expr(b, ast_node_child(expr, 0))
			var v = g_lower_expr_result_opnd as MirOperand
			var q_bits: i64 = 8
			if ast_node_child_count(expr) > 1 do
				let b_node = ast_node_child(expr, 1)
				if ast_node_type_of(b_node) == AstType.LiteralInt do
					q_bits = ast_node_int_val(b_node)
				end
			end
			b2 = emit_set_arg(b2, 0, mir_opnd_imm(q_bits))
			var (b3, dst) = builder_new_vreg(b2)
			out expr_result(emit_intrinsic(b3, MIR_INTR_QUANTIZE, mir_opnd_vreg(dst), v), mir_opnd_vreg(dst))
		end
	end

    # 6. Call — SetArg* then Call(dst, nargs); src2 = callee string-pool id
	if expr_type == AstType.PercentExpr do
		if ast_node_child_count(expr) > 0 do
			child = ast_node_child(expr, 0)
			var b2 = lower_expr(b, child)
			var child_opnd = g_lower_expr_result_opnd as MirOperand
			var (b3, dst) = builder_new_vreg(b2)
			var ct = infer_expr_type_name(child)
			var m_type = MirType.Int64 as i64
			if fat_cstr_eq(ct, "float") == 1 or ast_node_type_of(child) == AstType.LiteralFloat do
				m_type = MirType.F64 as i64
			end
			out expr_result(emit_intrinsic_typed(b3, MIR_INTR_PERCENT, mir_opnd_vreg(dst), child_opnd, m_type), mir_opnd_vreg(dst))
		end
	end

    # 7. UnaryMinus
	if expr_type == AstType.UnaryMinus do
		child_count = ast_node_child_count(expr)
		if child_count > 0 do
			child = ast_node_child(expr, 0)
			var b2 = lower_expr(b, child)
			var child_opnd = g_lower_expr_result_opnd as MirOperand
			var c_t = infer_expr_type_name(child)
			if is_flux_type_str(c_t) do
				var f_lanes = parse_flux_lanes(c_t)
				if f_lanes <= 0 do f_lanes = 4 end
				let alloc_sz = 16 + f_lanes * 8
				b2 = emit_set_arg(b2, 0, mir_opnd_imm(alloc_sz))
				var (b_fres, f_base) = builder_new_vreg(b2)
				ins_f_alloc = mir_instr_new(MirOp.Intrinsic as i64, mir_opnd_vreg(f_base) as i64, mir_opnd_imm(3) as i64, mir_opnd_imm(MIR_INTR_BUILTIN) as i64)
				annotate_owned_alloc(ins_f_alloc, f_base, alloc_sz, 16, ast_node_line(expr))
				b_fres = builder_add_instr(b_fres, ins_f_alloc)
				b_fres = emit_set_arg(b_fres, 0, mir_opnd_vreg(f_base))
				b_fres = emit_set_arg(b_fres, 1, mir_opnd_imm(0))
				b_fres = emit_set_arg(b_fres, 2, mir_opnd_imm(f_lanes))
				b_fres = emit_intrinsic(b_fres, MIR_INTR_BUILTIN, mir_opnd_none(), mir_opnd_imm(8))
				b_fres = emit_set_arg(b_fres, 0, mir_opnd_vreg(f_base))
				b_fres = emit_set_arg(b_fres, 1, mir_opnd_imm(8))
				b_fres = emit_set_arg(b_fres, 2, mir_opnd_imm(f_lanes))
				b_fres = emit_intrinsic(b_fres, MIR_INTR_BUILTIN, mir_opnd_none(), mir_opnd_imm(8))
				var is_float_elem = (parse_flux_elem_type(c_t) as int) == (TypeKind.Float as int)
				var elem_code = 1
				if is_float_elem do elem_code = 2 end
				var v_flags = 1
				let v_aux = vec_aux_pack(elem_code, f_lanes, 16, v_flags)
				var v_ins = mir_instr_new(MirOp.VSub as i64, mir_opnd_vreg(f_base) as i64, mir_opnd_imm(0), child_opnd)
				mir_instr_set_type(v_ins, MirType.Vector as i64)
				mir_instr_set_aux(v_ins, v_aux)
				b_fres = builder_add_instr(b_fres, v_ins)
				out expr_result(b_fres, mir_opnd_vreg(f_base))
			end
			var (b3, dst) = builder_new_vreg(b2)
			ins = mir_instr_new(MirOp.Sub, mir_opnd_vreg(dst), mir_opnd_imm(0), child_opnd)
			b3 = builder_add_instr(b3, ins)
			out expr_result(b3, mir_opnd_vreg(dst))
		end
	end

    # 7b. AddrOf — shared (&) / mut (&mut); SetArg0 = mut flag
	if expr_type == AstType.AddrOf do
		child_count = ast_node_child_count(expr)
		if child_count > 0 do
			child = ast_node_child(expr, 0)
			var b2 = lower_expr(b, child)
			var child_opnd = g_lower_expr_result_opnd as MirOperand
			var (b3, dst) = builder_new_vreg(b2)
			mutf = 0
			if fat_cstr_eq(ast_node_name(expr), "mut") do
				mutf = 1
			end
			b3 = emit_set_arg(b3, 0, mir_opnd_imm(mutf))
			b3 = emit_intrinsic(b3, MIR_INTR_ADDR_OF, mir_opnd_vreg(dst), child_opnd)
			out expr_result(b3, mir_opnd_vreg(dst))
		end
	end

	out b
end.
