##
 * compiler/src/lower/ast_to_mir/stmt_control.vri — Control Flow Statement Lowering Orchestrator
 ##

include types_prelude
include rt_vec_rt
include rt_string_rt
include parser
include mir
include ast_to_mir_context
include ast_to_mir_layout
include ast_to_mir_builder
include ast_to_mir_calls
include ast_to_mir_expr_ops
include ast_to_mir_expr

include ast_to_mir_stmt_control_arena_scan
include ast_to_mir_stmt_control_loops
include ast_to_mir_stmt_control_jumps
include ast_to_mir_stmt_control_pattern
include ast_to_mir_stmt_control_error
include ast_to_mir_stmt_control_async_arena

# ═══════════════════════════════════════════════════════
# Control Flow Statement Lowering Dispatcher
# ═══════════════════════════════════════════════════════
func lower_stmt_control(b: &MirBuilder, stmt: &AstNode, stmt_type: AstType):
	if stmt_type == AstType.IfStmt do out lower_stmt_if(b, stmt) end
	if stmt_type == AstType.WhileStmt do out lower_stmt_while(b, stmt) end
	if stmt_type == AstType.LoopStmt do out lower_stmt_loop(b, stmt) end
	if stmt_type == AstType.Block do out lower_stmt_block(b, stmt) end
	if stmt_type == AstType.ReturnStmt do out lower_stmt_return(b, stmt) end
	if stmt_type == AstType.PrintStmt do out lower_stmt_print(b, stmt) end
	if stmt_type == AstType.BreakStmt do out lower_stmt_break(b, stmt) end
	if stmt_type == AstType.ContinueStmt do out lower_stmt_continue(b, stmt) end
	if stmt_type == AstType.CaseExpr do out lower_stmt_case(b, stmt) end
	if stmt_type == AstType.ForRange do out lower_stmt_for_range(b, stmt) end
	if stmt_type == AstType.EnsureBlock do out lower_stmt_ensure(b, stmt) end
	if stmt_type == AstType.RevertBlock do out lower_stmt_revert(b, stmt) end
	if stmt_type == AstType.WhenStmt do out lower_stmt_when(b, stmt) end
	if stmt_type == AstType.ThrowStmt do out lower_stmt_throw(b, stmt) end
	if stmt_type == AstType.CancelStmt do out lower_stmt_cancel(b, stmt) end
	if stmt_type == AstType.QuietStmt do out lower_stmt_quiet(b, stmt) end
	if stmt_type == AstType.ArenaBlock do out lower_stmt_arena(b, stmt) end
	if stmt_type == AstType.EmitStmt do out lower_stmt_emit(b, stmt) end
	if stmt_type == AstType.SelectStmt do out lower_stmt_select(b, stmt) end
	if stmt_type == AstType.TryStmt do out lower_stmt_try(b, stmt) end
	if stmt_type == AstType.TimeoutClause do out lower_stmt_timeout(b, stmt) end
	if stmt_type == AstType.IsolateClause do out lower_stmt_isolate(b, stmt) end
	if stmt_type == AstType.ResumeStmt do out lower_stmt_resume(b, stmt) end
	out b
end.
