func get_entity_field_name_by_index(ent_name: string, target_idx: i64):
    if g_entity_hash != 0 and ent_name != 0 do
        e_idx = hash_table_lookup(g_entity_hash, g_entity_names, ent_name)
        if e_idx >= 0 and e_idx < vec_len_rt(g_entity_nodes) do
            ent_ast = vec_get_rt(g_entity_nodes, e_idx) as AstNode
            if (ent_ast as i64) != 0 do
                n_ch = ast_node_child_count(ent_ast)
                var j = 0
                var actual_idx = 0
                when j < n_ch loop
                    f_child = ast_node_child(ent_ast, j)
                    if ast_node_type_of(f_child) != AstType.FuncDef do
                        if actual_idx == target_idx do
                            out ast_node_name(f_child)
                        end
                        actual_idx = actual_idx + 1
                    end
                    j = j + 1
                end
            end
        end
    end
    out fat_str_new("")
end.

func compute_packed_layout(ent_ast: &AstNode):
    ent_name = ast_node_name(ent_ast)
    e_idx = hash_table_lookup(g_entity_hash, g_entity_names, ent_name)
    if e_idx < 0 do out 0 end
    if vec_get_rt(g_entity_sizes, e_idx) > 0 do
        out vec_get_rt(g_entity_sizes, e_idx)
    end
    var cur_off = 0
    n_ch = ast_node_child_count(ent_ast)
    var j = 0
    when j < n_ch loop
        f_node = ast_node_child(ent_ast, j)
        if ast_node_type_of(f_node) != AstType.FuncDef do
            f_name = ast_node_name(f_node)
            ft = ast_node_name2(f_node)
            if ft == 0 do ft = fat_str_new("") end
            dot_str = fat_str_new(".")
            scoped_key = fat_str_concat(fat_str_concat(ent_name, dot_str), f_name)
            idx_s = hash_table_lookup(g_scoped_field_hash, g_scoped_field_names, scoped_key)

            var f_sz = 8
            var f_sgn = 0
            var f_nested = 0
            if is_packed_entity(ft) do
                var ft_e_idx = hash_table_lookup(g_entity_hash, g_entity_names, ft)
                if ft_e_idx >= 0 and ft_e_idx < vec_len_rt(g_entity_nodes) do
                    var ft_node = vec_get_rt(g_entity_nodes, ft_e_idx) as AstNode
                    if (ft_node as i64) != 0 do
                        compute_packed_layout(ft_node)
                    end
                end
                f_sz = get_type_byte_size(ft)
                f_nested = 1
                f_sgn = 0
            else
                f_sz = get_type_byte_size(ft)
                f_sgn = is_signed_type(ft)
                f_nested = 0
            end

            if idx_s >= 0 do
                vec_set_rt(g_scoped_field_offsets, idx_s, cur_off)
                vec_set_rt(g_scoped_field_sizes, idx_s, f_sz)
                vec_set_rt(g_scoped_field_signed, idx_s, f_sgn)
                vec_set_rt(g_scoped_field_is_nested, idx_s, f_nested)
            end
            cur_off = cur_off + f_sz
        end
        j = j + 1
    end
    vec_set_rt(g_entity_sizes, e_idx, cur_off)
    out cur_off
end.

func unwrap_ref_type_name(name: string):
    var tlen = fat_str_len(name)
    if tlen == 0 do out name end
    if tlen >= 5 and fat_str_byte_at(name, 0) == 38 and fat_str_byte_at(name, 1) == 109 and fat_str_byte_at(name, 2) == 117 and fat_str_byte_at(name, 3) == 116 and fat_str_byte_at(name, 4) == 32 do
        out fat_str_slice(name, 5, tlen - 5)
    end
    if tlen >= 4 and fat_str_byte_at(name, 0) == 38 and fat_str_byte_at(name, 1) == 109 and fat_str_byte_at(name, 2) == 117 and fat_str_byte_at(name, 3) == 116 do
        out fat_str_slice(name, 4, tlen - 4)
    end
    if tlen >= 2 and fat_str_byte_at(name, 0) == 38 and fat_str_byte_at(name, 1) == 32 do
        out fat_str_slice(name, 2, tlen - 2)
    end
    if tlen >= 1 and fat_str_byte_at(name, 0) == 38 do
        out fat_str_slice(name, 1, tlen - 1)
    end
    out name
end.

func get_expr_entity_type(node: &AstNode):
    if node == 0 do out fat_str_new("") end
    nt = ast_node_type_of(node)
    if nt == AstType.Identifier do
        vname = ast_node_name(node)
        vt = get_var_type(vname)
        if vt != 0 and fat_str_len(vt) > 0 do out unwrap_ref_type_name(vt) end
        if is_entity_name(vname) == 1 do out vname end
        out fat_str_new("")
    end
    if nt == AstType.FieldAccess do
        if ast_node_child_count(node) > 0 do
            base_node = ast_node_child(node, 0)
            base_type = get_expr_entity_type(base_node)
            if fat_str_len(base_type) > 0 do
                field_name = ast_node_name(node)
                out unwrap_ref_type_name(get_scoped_field_type(base_type, field_name))
            end
        end
        out fat_str_new("")
    end
    if nt == AstType.EntityLiteral do
        out ast_node_name(node)
    end
    if nt == AstType.Call do
        callee = resolve_callee_alias(ast_node_name(node))
        if is_entity_name(callee) == 1 do out callee end
        let fn_ast = find_func_ast(callee)
        if (fn_ast as i64) != 0 do
            let fn_ret = ast_node_name2(fn_ast)
            if (fn_ret as i64) != 0 and fat_str_len(fn_ret) > 0 do
                let unwrapped_ret = unwrap_ref_type_name(fn_ret)
                if is_entity_name(unwrapped_ret) == 1 do out unwrapped_ret end
            end
        end
        out fat_str_new("")
    end
    if nt == AstType.MethodCall and ast_node_child_count(node) > 0 do
        recv_type = get_expr_entity_type(ast_node_child(node, 0))
        if fat_str_len(recv_type) > 0 do
            method_key = get_scoped_method_name(recv_type, ast_node_name(node))
            if fat_str_len(method_key) > 0 do
                method_idx = hash_table_lookup(g_scoped_method_hash, g_scoped_method_names, method_key)
                if method_idx >= 0 and g_scoped_method_nodes != 0 and method_idx < vec_len_rt(g_scoped_method_nodes) do
                    method_node = vec_get_rt(g_scoped_method_nodes, method_idx) as AstNode
                    if (method_node as i64) != 0 do
                        return_name = ast_node_name2(method_node)
                        let unwrapped_m_ret = unwrap_ref_type_name(return_name)
                        if is_entity_name(unwrapped_m_ret) == 1 do out unwrapped_m_ret end
                    end
                end
            end
        end
        out fat_str_new("")
    end
    out fat_str_new("")
end.

func find_field_index_for_base(base_name: &string, field_name: &string):
    if base_name != 0 do
        var ent_type = get_var_type(base_name)
        if ent_type != 0 do
            ent_type = unwrap_ref_type_name(ent_type)
        end
        if ent_type == 0 and is_entity_name(base_name) == 1 do
            ent_type = base_name as string
        end
        if ent_type != 0 do
            idx_s = get_scoped_field_index(ent_type as i64, field_name)
            if idx_s >= 0 do
                out idx_s
            end
        end
    end

    # Lexer entity fields (base is lex, lex2, etc.)
    if fat_cstr_eq(base_name, "lex") == 1 or fat_cstr_eq(base_name, "lex2") == 1 or fat_cstr_eq(base_name, "l") == 1 do
        if fat_cstr_eq(field_name, "source") == 1 do out 0 end
        if fat_cstr_eq(field_name, "source_len") == 1 do out 1 end
        if fat_cstr_eq(field_name, "pos") == 1 do out 2 end
        if fat_cstr_eq(field_name, "line") == 1 do out 3 end
        if fat_cstr_eq(field_name, "col") == 1 do out 4 end
        if fat_cstr_eq(field_name, "tokens") == 1 do out 5 end
        if fat_cstr_eq(field_name, "paren_depth") == 1 do out 6 end
        if fat_cstr_eq(field_name, "keywords") == 1 do out 7 end
        if fat_cstr_eq(field_name, "error_msg") == 1 do out 8 end
    end

    # Parser entity fields (tokens:0, pos:1, token_count:2, error_msg:3, error_line:4, builtins:5, error_col:6)
    if fat_cstr_eq(field_name, "token_count") == 1 do out 2 end
    if fat_cstr_eq(field_name, "builtins") == 1 do out 5 end
    if fat_cstr_eq(field_name, "tokens") == 1 do out 0 end
    if fat_cstr_eq(field_name, "pos") == 1 do out 1 end
    if fat_cstr_eq(field_name, "error_line") == 1 do out 4 end
    if fat_cstr_eq(field_name, "error_col") == 1 do out 6 end
    if fat_cstr_eq(field_name, "error_msg") == 1 do
        if fat_cstr_eq(base_name, "lex") == 1 or fat_cstr_eq(base_name, "lex2") == 1 or fat_cstr_eq(base_name, "l") == 1 do
            out 8
        end
        out 3
    end

    # StringBuilder entity fields (buf: 0, len: 1, cap: 2)
    if fat_cstr_eq(field_name, "buf") == 1 do out 0 end
    if fat_cstr_eq(field_name, "cap") == 1 do out 2 end
    if fat_cstr_eq(base_name, "sb") == 1 or fat_cstr_eq(base_name, "sb_pre") == 1 or fat_cstr_eq(base_name, "sb_src") == 1 or fat_cstr_eq(base_name, "builder") == 1 or fat_cstr_eq(base_name, "out_sb") == 1 or fat_cstr_eq(base_name, "resp_sb") == 1 do
        if fat_cstr_eq(field_name, "len") == 1 do out 1 end
    end

    # Token entity fields (tok_type:0, line:1, col:2, start:3, len:4, str_val:5, int_val:6, float_val:7)
    if fat_cstr_eq(field_name, "tok_type") == 1 do out 0 end
    if fat_cstr_eq(field_name, "str_val") == 1 do out 5 end
    if fat_cstr_eq(base_name, "grp_tok") == 1 or fat_cstr_eq(base_name, "next_t") == 1 or fat_cstr_eq(base_name, "ref_tok") == 1 or fat_cstr_eq(base_name, "t") == 1 or fat_cstr_eq(base_name, "t2") == 1 or fat_cstr_eq(base_name, "t3") == 1 or fat_cstr_eq(base_name, "tok") == 1 or fat_cstr_eq(base_name, "op_tok") == 1 or fat_cstr_eq(base_name, "id_tok") == 1 or fat_cstr_eq(base_name, "name_tok") == 1 or fat_cstr_eq(base_name, "field_tok") == 1 or fat_cstr_eq(base_name, "count_tok") == 1 or fat_cstr_eq(base_name, "int_tok") == 1 or fat_cstr_eq(base_name, "hi_tok") == 1 or fat_cstr_eq(base_name, "it") == 1 or fat_cstr_eq(base_name, "st") == 1 or fat_cstr_eq(base_name, "cur") == 1 or fat_cstr_eq(base_name, "prev") == 1 or fat_cstr_eq(base_name, "vt") == 1 or fat_cstr_eq(base_name, "end_tok") == 1 or fat_cstr_eq(base_name, "val_tok") == 1 or fat_cstr_eq(base_name, "t_next") == 1 or fat_cstr_eq(base_name, "t_first") == 1 or fat_cstr_eq(base_name, "t_comma") == 1 or fat_cstr_eq(base_name, "last_tok") == 1 or fat_cstr_eq(base_name, "nxt_last_tok") == 1 or fat_cstr_eq(base_name, "tok_next") == 1 or fat_cstr_eq(base_name, "cand_t") == 1 do
        if fat_cstr_eq(field_name, "line") == 1 do out 1 end
        if fat_cstr_eq(field_name, "col") == 1 do out 2 end
        if fat_cstr_eq(field_name, "start") == 1 do out 3 end
        if fat_cstr_eq(field_name, "len") == 1 do out 4 end
        if fat_cstr_eq(field_name, "int_val") == 1 do out 6 end
        if fat_cstr_eq(field_name, "float_val") == 1 do out 7 end
        if fat_cstr_eq(field_name, "file_id") == 1 do out 8 end
        if fat_cstr_eq(field_name, "span_id") == 1 do out 9 end
    end

    # CodeBuf entity fields (arch: 0, data: 1, len: 2, start_offset: 3)
    if fat_cstr_eq(base_name, "cb") == 1 or fat_cstr_eq(base_name, "code") == 1 do
        if fat_cstr_eq(field_name, "arch") == 1 do out 0 end
        if fat_cstr_eq(field_name, "data") == 1 do out 1 end
        if fat_cstr_eq(field_name, "len") == 1 do out 2 end
        if fat_cstr_eq(field_name, "start_offset") == 1 do out 3 end
    end

    out find_field_index(field_name)
end.

func find_field_index(field_name: &string):
    # Builtin compiler entity field indices (AstNode, Token, Lexer, ScopeNode, SymbolNode)
    if fat_cstr_eq(field_name, "name") == 1 do out 0 end
    if fat_cstr_eq(field_name, "name2") == 1 do out 1 end
    if fat_cstr_eq(field_name, "node_type") == 1 do out 2 end
    if fat_cstr_eq(field_name, "op") == 1 do out 3 end
    if fat_cstr_eq(field_name, "line") == 1 do out 4 end
    if fat_cstr_eq(field_name, "int_val") == 1 do out 5 end
    if fat_cstr_eq(field_name, "float_val") == 1 do out 6 end
    if fat_cstr_eq(field_name, "builtin_id") == 1 do out 7 end
    if fat_cstr_eq(field_name, "children") == 1 do out 8 end
    if fat_cstr_eq(field_name, "span_id") == 1 do out 9 end
    if fat_cstr_eq(field_name, "file_id") == 1 do out 8 end
    if fat_cstr_eq(field_name, "start_offset") == 1 do out 3 end

    if fat_cstr_eq(field_name, "parent_id") == 1 do out 1 end
    if fat_cstr_eq(field_name, "symbols") == 1 do out 2 end
    if fat_cstr_eq(field_name, "scopes") == 1 do out 0 end
    if fat_cstr_eq(field_name, "current_id") == 1 do out 1 end
    if fat_cstr_eq(field_name, "name_id") == 1 do out 1 end
    if fat_cstr_eq(field_name, "type_id") == 1 do out 2 end
    if fat_cstr_eq(field_name, "scope_id") == 1 do out 3 end
    if fat_cstr_eq(field_name, "ast_id") == 1 do out 4 end
    if fat_cstr_eq(field_name, "is_mutable") == 1 do out 5 end
    if fat_cstr_eq(field_name, "offset") == 1 do out 6 end
    if fat_cstr_eq(field_name, "param_count") == 1 do out 7 end
    if fat_cstr_eq(field_name, "return_type") == 1 do out 8 end

    if fat_cstr_eq(field_name, "tok_type") == 1 do out 0 end
    if fat_cstr_eq(field_name, "col") == 1 do out 2 end
    if fat_cstr_eq(field_name, "start") == 1 do out 3 end
    if fat_cstr_eq(field_name, "len") == 1 do out 4 end
    if fat_cstr_eq(field_name, "str_val") == 1 do out 5 end

    if fat_cstr_eq(field_name, "source") == 1 do out 0 end
    if fat_cstr_eq(field_name, "source_len") == 1 do out 1 end
    if fat_cstr_eq(field_name, "pos") == 1 do out 2 end
    if fat_cstr_eq(field_name, "token_count") == 1 do out 3 end
    if fat_cstr_eq(field_name, "error_line") == 1 do out 4 end
    if fat_cstr_eq(field_name, "error_col") == 1 do out 6 end
    if fat_cstr_eq(field_name, "tokens") == 1 do out 5 end
    if fat_cstr_eq(field_name, "paren_depth") == 1 do out 6 end
    if fat_cstr_eq(field_name, "builtins") == 1 do out 6 end
    if fat_cstr_eq(field_name, "keywords") == 1 do out 7 end
    if fat_cstr_eq(field_name, "error_msg") == 1 do out 8 end

    idx = lookup_cached_name(g_field_names, field_name)
    if idx >= 0 do out vec_get_rt(g_field_indices, idx) end
    out 0
end.

func resolve_callee_alias(callee_name: &string):
    let idx = lookup_cached_name(g_import_aliases, callee_name)
    if idx >= 0 do out vec_get_rt(g_import_targets, idx) as string end
    let s_ptr = callee_name as int
    if s_ptr != 0 and g_func_ast_hash != 0 do
        if hash_table_lookup(g_func_ast_hash, g_func_ast_names, callee_name) >= 0 do
            out callee_name as string
        end
        if is_user_module(g_ast_to_mir_cur_module) == 1 do
            let mod_c = fat_str_concat(fat_str_concat(g_ast_to_mir_cur_module, fat_str_new(".")), callee_name as string)
            if hash_table_lookup(g_func_ast_hash, g_func_ast_names, mod_c) >= 0 do
                out mod_c
            end
        end
        if builtin_id_from_name(callee_name as string) <= 0 and g_func_ast_names != 0 do
            let c_len = native_read_i64(s_ptr, 8) as int
            let c_cstr = native_read_i64(s_ptr, 0) as int
            let n_fn = vec_len_rt(g_func_ast_names)
            var k_fn = 0
            when k_fn < n_fn loop
                let cand_ptr = vec_get_rt(g_func_ast_names, k_fn) as int
                if cand_ptr != 0 do
                    let cand_len = native_read_i64(cand_ptr, 8) as int
                    let cand_cstr = native_read_i64(cand_ptr, 0) as int
                    if cand_len > c_len + 1 and c_cstr != 0 and cand_cstr != 0 do
                        if native_read_u8(cand_cstr, cand_len - c_len - 1) == 46 do
                            var match = 1
                            var ci = 0
                            when ci < c_len loop
                                if native_read_u8(cand_cstr, cand_len - c_len + ci) != native_read_u8(c_cstr, ci) do
                                    match = 0
                                end
                                ci = ci + 1
                            end
                            if match == 1 do
                                out cand_ptr as string
                            end
                        end
                    end
                end
                k_fn = k_fn + 1
            end
        end
    end
    out callee_name as string
end.

func is_entity_name(type_name: &string):
    if type_name < 4096 do out 0 end
    if lookup_cached_name(g_entity_names, type_name) >= 0 do out 1 end
    base_name = extract_base_entity_name(type_name)
    if fat_str_eq(base_name, type_name as string) == 0 do
        out lookup_cached_name(g_entity_names, base_name as i64) >= 0
    end
    out 0
end.

func is_register_field(field_name: &string):
    if g_register_field_names == 0 do out 0 end
    if field_name < 4096 do out 0 end
    if lookup_cached_name(g_register_field_names, field_name) >= 0 do out 1 end
    out 0
end.

func get_register_field_start(field_name: &string):
    if g_register_field_names == 0 do out 0 end
    idx = lookup_cached_name(g_register_field_names, field_name)
    if idx >= 0 do out vec_get_rt(g_register_field_starts, idx) end
    out 0
end.

func get_register_field_width(field_name: &string):
    if g_register_field_names == 0 do out 1 end
    idx = lookup_cached_name(g_register_field_names, field_name)
    if idx >= 0 do out vec_get_rt(g_register_field_widths, idx) end
    out 1
end.

func is_register_field_scoped(base_type: &string, field_name: &string):
    out is_register_field(field_name)
end.

func get_register_field_start_scoped(base_type: &string, field_name: &string):
    out get_register_field_start(field_name)
end.

func get_register_field_width_scoped(base_type: &string, field_name: &string):
    out get_register_field_width(field_name)
end.

