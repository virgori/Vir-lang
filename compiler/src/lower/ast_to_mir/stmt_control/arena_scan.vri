##
 * compiler/src/lower/ast_to_mir/stmt_control/arena_scan.vri — Arena escaped variable scanning helpers
 ##

include types_prelude
include rt_vec_rt
include rt_string_rt
include parser
include mir
include ast_to_mir_context
include ast_to_mir_layout
include ast_to_mir_builder
include ast_to_mir_calls
include ast_to_mir_expr_ops
include ast_to_mir_expr

func scan_arena_escaped_vars_into(node: &AstNode, list: i64) -> i64:
    if node == 0 do out list end
    let nt = ast_node_type_of(node)
    if nt == AstType.Assign do
        var target_name = ast_node_name(node)
        if ast_node_child_count(node) >= 2 do
            target_name = ast_node_name(ast_node_child(node, 0))
        end
        if (target_name as i64) != 0 and fat_str_len(target_name) > 0 do
            if g_current_func_buckets != 0 do
                let existing_vr = buckets_get_var(g_current_func_buckets, target_name as i64)
                if existing_vr >= 0 do
                    var already = 0
                    var li = 0
                    let llen = vec_len_rt(list)
                    when li < llen loop
                        if fat_str_eq(vec_get_rt(list, li) as string, target_name) == 1 do
                            already = 1
                        end
                        li = li + 1
                    end
                    if already == 0 do
                        list = vec_push_rt(list, target_name as i64)
                    end
                end
            end
        end
    end
    if nt == AstType.ReturnStmt do
        if ast_node_child_count(node) > 0 do
            let ch = ast_node_child(node, 0)
            if ast_node_type_of(ch) == AstType.Identifier do
                let ret_name = ast_node_name(ch)
                if (ret_name as i64) != 0 and fat_str_len(ret_name) > 0 do
                    var already = 0
                    var li = 0
                    let llen = vec_len_rt(list)
                    when li < llen loop
                        if fat_str_eq(vec_get_rt(list, li) as string, ret_name) == 1 do
                            already = 1
                        end
                        li = li + 1
                    end
                    if already == 0 do
                        list = vec_push_rt(list, ret_name as i64)
                    end
                end
            end
        end
    end
    let nc = ast_node_child_count(node)
    var i = 0
    when i < nc loop
        let ch = ast_node_child(node, i)
        list = scan_arena_escaped_vars_into(ch, list)
        i = i + 1
    end
    out list
end.

func scan_arena_escaped_vars(node: &AstNode) -> i64:
    var list = vec_new_rt()
    out scan_arena_escaped_vars_into(node, list)
end.

func scan_arena_escaped_var(node: &AstNode):
    let list = scan_arena_escaped_vars(node)
    if vec_len_rt(list) > 0 do
        out vec_get_rt(list, 0) as string
    end
    out fat_str_new("")
end.


