##
 * compiler/src/lower/ast_to_mir/stmt_control/pattern.vri — Statement lowering: pattern
 ##

include types_prelude
include rt_vec_rt
include rt_string_rt
include parser
include mir
include ast_to_mir_context
include ast_to_mir_layout
include ast_to_mir_builder
include ast_to_mir_calls
include ast_to_mir_expr_ops
include ast_to_mir_expr

func lower_stmt_case(b: &MirBuilder, stmt: &AstNode):
	child_count = ast_node_child_count(stmt)
	if child_count >= 1 do
		target_expr = ast_node_child(stmt, 0)
		var b2 = lower_expr(b, target_expr)
		var target_opnd = g_lower_expr_result_opnd as MirOperand
		var (b3, end_id) = builder_add_block(b2)
		var i = 1
		b_mut = b3
		when i + 1 < child_count loop
			pat = ast_node_child(stmt, i)
			body = ast_node_child(stmt, i + 1)
			variant_idx = 0 - 1
			is_tagged_variant = 0
			if ast_node_type_of(pat) == AstType.Identifier do
				variant_idx = enum_variant_index_for_target(target_expr, ast_node_name2(pat), ast_node_name(pat))
				if variant_idx >= 0 and enum_variant_is_tagged(variant_idx) do
					is_tagged_variant = 1
				end
			end
			var (b4, arm_id) = builder_add_block(b_mut)
			var (b5, next_id) = builder_add_block(b4)
            # Wildcard / else
			is_wild = 0
			if ast_node_type_of(pat) == AstType.Identifier do
				if fat_cstr_eq(ast_node_name(pat), "_") do
					is_wild = 1
				end
				if ast_node_int_val(pat) == 0 - 1 do
					is_wild = 1
				end
			end
			if is_wild != 0 do
				b5 = emit_jump(b5, arm_id)
			else
				if variant_idx >= 0 do
					match_value = target_opnd
					if is_tagged_variant == 1 do
						var (b_tag, tag_vreg) = builder_new_vreg(b5)
						b_tag = emit_load_typed(b_tag, tag_vreg, target_opnd, ENUM_TAG_SIZE, 0)
						b5 = b_tag
						match_value = mir_opnd_vreg(tag_vreg)
					end
					var (b_cmp, cv) = builder_new_vreg(b5)
					insc = mir_instr_new(MirOp.CmpEq, mir_opnd_vreg(cv), match_value, mir_opnd_imm(vec_get_rt(g_enum_variant_tags, variant_idx)))
					b_cmp = builder_add_instr(b_cmp, insc)
					b5 = emit_jump_if(b_cmp, mir_opnd_vreg(cv), arm_id, next_id)
				else
				if ast_node_type_of(pat) == AstType.BinOp or ast_node_type_of(pat) == AstType.RangeExpr do
					low_node = ast_node_child(pat, 0)
					high_node = ast_node_child(pat, 1)
					var (b5_1, v_ge) = builder_new_vreg(b5)
					ins_ge = mir_instr_new(MirOp.CmpGe, mir_opnd_vreg(v_ge), target_opnd, mir_opnd_imm(ast_node_int_val(low_node)))
					b5_1 = builder_add_instr(b5_1, ins_ge)
					var (b5_2, v_lt) = builder_new_vreg(b5_1)
					ins_lt = mir_instr_new(MirOp.CmpLt, mir_opnd_vreg(v_lt), target_opnd, mir_opnd_imm(ast_node_int_val(high_node)))
					b5_2 = builder_add_instr(b5_2, ins_lt)
					var (b5_3, v_in_range) = builder_new_vreg(b5_2)
					ins_and = mir_instr_new(MirOp.And, mir_opnd_vreg(v_in_range), mir_opnd_vreg(v_ge), mir_opnd_vreg(v_lt))
					b5_3 = builder_add_instr(b5_3, ins_and)
					b5 = emit_jump_if(b5_3, mir_opnd_vreg(v_in_range), arm_id, next_id)
				else
				if ast_node_type_of(pat) == AstType.LiteralInt do
					var (b6, cv) = builder_new_vreg(b5)
					insc = mir_instr_new(MirOp.CmpEq, mir_opnd_vreg(cv), target_opnd, mir_opnd_imm(ast_node_int_val(pat)))
					b6 = builder_add_instr(b6, insc)
					b5 = emit_jump_if(b6, mir_opnd_vreg(cv), arm_id, next_id)
				else
					if ast_node_type_of(pat) == AstType.Identifier and fat_cstr_eq(ast_node_name(pat), "true") do
						var (b6, cv) = builder_new_vreg(b5)
						insc = mir_instr_new(MirOp.CmpEq, mir_opnd_vreg(cv), target_opnd, mir_opnd_imm(1))
						b6 = builder_add_instr(b6, insc)
						b5 = emit_jump_if(b6, mir_opnd_vreg(cv), arm_id, next_id)
					else
						if ast_node_type_of(pat) == AstType.Identifier and fat_cstr_eq(ast_node_name(pat), "false") do
							var (b6, cv) = builder_new_vreg(b5)
							insc = mir_instr_new(MirOp.CmpEq, mir_opnd_vreg(cv), target_opnd, mir_opnd_imm(0))
							b6 = builder_add_instr(b6, insc)
							b5 = emit_jump_if(b6, mir_opnd_vreg(cv), arm_id, next_id)
						else
							if ast_node_type_of(pat) == AstType.LiteralStr do
								var (b5b, pid) = builder_intern(b5, ast_node_name(pat))
								b5b = emit_set_arg(b5b, 0, mir_opnd_imm(pid))
								var (b6, cv) = builder_new_vreg(b5b)
								b6 = emit_intrinsic(b6, MIR_INTR_STR_EQ, mir_opnd_vreg(cv), target_opnd)
								b5 = emit_jump_if(b6, mir_opnd_vreg(cv), arm_id, next_id)
							else
                                # Tagged / other — pool id in SetArg0, then MATCH_PAT
								var (b5b, pid) = builder_intern(b5, ast_node_name(pat))
								b5b = emit_set_arg(b5b, 0, mir_opnd_imm(pid))
								var (b6, cv) = builder_new_vreg(b5b)
								b6 = emit_intrinsic(b6, MIR_INTR_MATCH_PAT, mir_opnd_vreg(cv), target_opnd)
								b5 = emit_jump_if(b6, mir_opnd_vreg(cv), arm_id, next_id)
							end
						end
					end
				end
				end
				end
			end
			b5 = builder_set_current_block(b5, arm_id)
			# Payload binders are direct loads from the canonical union payload;
			# no stdlib/prelude helper participates in bootstrap matching.
			if is_tagged_variant == 1 do
				binder_count = ast_node_child_count(pat)
				var_arity = vec_get_rt(g_enum_variant_arities, variant_idx)
				var bind_i = 0
				when bind_i < binder_count and bind_i < var_arity loop
					binder = ast_node_child(pat, bind_i)
					binder_name = ast_node_name(binder)
					if fat_cstr_eq(binder_name, "_") == 0 do
						var (b_addr, payload_addr) = builder_new_vreg(b5)
						payload_offset = ENUM_TAG_SLOT_SIZE + bind_i * ENUM_PAYLOAD_SLOT_SIZE
						b_addr = builder_add_instr(b_addr, mir_instr_new(MirOp.Add, mir_opnd_vreg(payload_addr), target_opnd, mir_opnd_imm(payload_offset)))
						var (b_load, payload_vreg) = builder_new_vreg(b_addr)
						b_load = emit_load(b_load, payload_vreg, mir_opnd_vreg(payload_addr))
						b5 = set_var_vreg(b_load, binder_name, payload_vreg)
						ptype = enum_variant_payload_type(variant_idx, bind_i)
						if fat_str_len(ptype) > 0 do
							set_var_type(binder_name, ptype)
						end
					end
					bind_i = bind_i + 1
				end
			end
			b5 = lower_stmt(b5, body)
			if not builder_current_block_terminated(b5) do
				b5 = emit_jump(b5, end_id)
			end
			b5 = builder_set_current_block(b5, next_id)
			b_mut = b5
			i = i + 2
		end
		if i < child_count do
			else_body = ast_node_child(stmt, i)
			b_mut = lower_stmt(b_mut, else_body)
		end
        # Fallthrough if no arm matched → end
		b_mut = emit_jump(b_mut, end_id)
		if not builder_current_block_terminated(b_mut) do
			b_mut = emit_jump(b_mut, end_id)
		end
		b_mut = builder_set_current_block(b_mut, end_id)
		out b_mut
	end
	out b
end.

func lower_stmt_for_range(b: &MirBuilder, stmt: &AstNode):
	child_count = ast_node_child_count(stmt)
	if child_count >= 3 do
		start_expr = ast_node_child(stmt, 0)
		end_expr = ast_node_child(stmt, 1)
		body_stmt = ast_node_child(stmt, 2)
		var b2 = lower_expr(b, start_expr)
		var start_opnd = g_lower_expr_result_opnd as MirOperand
		var b3 = lower_expr(b2, end_expr)
		var end_opnd = g_lower_expr_result_opnd as MirOperand
		var (b4, iv) = builder_new_vreg(b3)
		ins0 = mir_instr_new(MirOp.Move, mir_opnd_vreg(iv), start_opnd, mir_opnd_none())
		b4 = builder_add_instr(b4, ins0)
		b4 = set_var_vreg(b4, ast_node_name(stmt), iv)
		var (b5, cond_id) = builder_add_block(b4)
		var (b6, body_id) = builder_add_block(b5)
		var (b7, step_id) = builder_add_block(b6)
		var (b8, end_id) = builder_add_block(b7)
		b8 = emit_jump(b8, cond_id)
		b8 = builder_push_loop(b8, end_id, step_id)
		b8 = builder_set_current_block(b8, cond_id)
        # Re-read iv from var_map (may be updated each iter after SSA-ish Move)
		iv_cur = get_var_vreg(b8, ast_node_name(stmt))
		var (b9, cmpv) = builder_new_vreg(b8)
		insc = mir_instr_new(MirOp.CmpLt, mir_opnd_vreg(cmpv), mir_opnd_vreg(iv_cur), end_opnd)
		b9 = builder_add_instr(b9, insc)
		b9 = emit_jump_if_not(b9, mir_opnd_vreg(cmpv), end_id, body_id)
		b9 = builder_set_current_block(b9, body_id)
		let has_arena_for = scan_has_local_arena_alloc(body_stmt)
		let esc_name_for = scan_arena_escaped_var(body_stmt)
		var b_body = b9
		var iter_mark = 0
		if has_arena_for == 1 and fat_str_len(esc_name_for) == 0 do
			var (b_mark, imk) = builder_new_vreg(b_body)
			iter_mark = imk
			b_body = emit_intrinsic(b_mark, MIR_MEM_MARK, mir_opnd_vreg(iter_mark), mir_opnd_none())
			if g_arena_mark_stack == 0 do
				g_arena_mark_stack = vec_new_rt()
			end
			g_arena_mark_stack = vec_push_rt(g_arena_mark_stack, iter_mark as i64)
			if g_arena_escaped_stack != 0 do g_arena_escaped_stack = vec_push_rt(g_arena_escaped_stack, 0 as i64) end
		end

		b_body = lower_stmt(b_body, body_stmt)

		if has_arena_for == 1 and fat_str_len(esc_name_for) == 0 do
			if g_arena_mark_stack != 0 and vec_len_rt(g_arena_mark_stack) > 0 do
				vec_pop_rt(g_arena_mark_stack)
			end
			if g_arena_escaped_stack != 0 and vec_len_rt(g_arena_escaped_stack) > 0 do
				vec_pop_rt(g_arena_escaped_stack)
			end
			if not builder_current_block_terminated(b_body) do
				b_body = emit_intrinsic(b_body, MIR_MEM_RESET, mir_opnd_none(), mir_opnd_vreg(iter_mark))
			end
		end

		if not builder_current_block_terminated(b_body) do
			b_body = emit_jump(b_body, step_id)
		end
		b_body = builder_set_current_block(b_body, step_id)
		iv_cur2 = get_var_vreg(b_body, ast_node_name(stmt))
		var (b10, ivn) = builder_new_vreg(b_body)
		ins1 = mir_instr_new(MirOp.Add, mir_opnd_vreg(ivn), mir_opnd_vreg(iv_cur2), mir_opnd_imm(1))
		b10 = builder_add_instr(b10, ins1)
		insm = mir_instr_new(MirOp.Move, mir_opnd_vreg(iv_cur2), mir_opnd_vreg(ivn), mir_opnd_none())
		b10 = builder_add_instr(b10, insm)
		b10 = set_var_vreg(b10, ast_node_name(stmt), iv_cur2)
		b10 = emit_jump(b10, cond_id)
		b10 = builder_pop_loop(b10)
		b10 = builder_set_current_block(b10, end_id)
		out b10
	end
	out b
end.
