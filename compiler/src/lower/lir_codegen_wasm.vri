include sem_pass10_diagnostics
##
 * LIR -> WASI preview1 WebAssembly emitter.
 *
 * This deliberately avoids the obsolete soft QIR `Vec<T>` backend.  The
 * compiler's active path is MIR -> LIR, so this writer consumes its raw LIR
 * layout and emits a self-contained WASI module with a real `_start`.
 ##
module vir.compiler.lir_codegen_wasm

include rt.vec_rt
import bvec_new, bvec_push, bvec_len, bvec_data_ptr, vec_new_rt, vec_push_rt, vec_get_rt, vec_len_rt from rt.vec_rt
include rt.io
import write_file_bytes, print_str, print_ln, print_int, print_newline from rt.io
include rt.syscall
import sys_exit from rt.syscall
include string_rt
include lir
include mir
include ffi_imports
include lir_codegen
include target

const W_I32: int = 0x7f
const W_I64: int = 0x7e
const W_VOID: int = 0x40
const W_END: int = 0x0b
const W_LOCAL_GET: int = 0x20
const W_LOCAL_SET: int = 0x21
const W_CALL: int = 0x10
const W_DROP: int = 0x1a
const W_SELECT: int = 0x1b
const W_I32_CONST: int = 0x41
const W_I64_CONST: int = 0x42
const W_I32_ADD: int = 0x6a
const W_I32_SUB: int = 0x6b
const W_I32_MUL: int = 0x6c
const W_I32_OR: int = 0x72
const W_I32_GE_U: int = 0x4f
const W_I32_LT_U: int = 0x49
const W_I32_GT_U: int = 0x4b
const W_I32_AND: int = 0x71
const W_I32_EQZ: int = 0x45
const W_I32_LOAD: int = 0x28
const W_I32_LOAD8_U: int = 0x2d
const W_I32_STORE: int = 0x36
const W_I32_STORE8: int = 0x3a
const W_I32_EQ: int = 0x46
const W_IF: int = 0x04
const W_I32_WRAP_I64: int = 0xa7
const W_I64_EXTEND_I32_U: int = 0xad
const W_I64_EQZ: int = 0x50
const W_I64_DIV_S: int = 0x7f
const W_I64_REM_S: int = 0x81
const W_F64_CONST: int = 0x44
const W_F64_DIV: int = 0xa3
const W_F64_CONVERT_I64_S: int = 0xb9
const W_I64_REINTERPRET_F64: int = 0xbd
const W_F64_REINTERPRET_I64: int = 0xbf
const W_GLOBAL_GET: int = 0x23
const W_GLOBAL_SET: int = 0x24
const W_BLOCK: int = 0x02
const W_LOOP: int = 0x03
const W_BR: int = 0x0c
const W_BR_IF: int = 0x0d
const W_ELSE: int = 0x05

func w_u(b: int, value: int):
    var v = value
    when true loop
        byte = v and 0x7f
        v = v shr 7
        if v != 0 do byte = byte or 0x80 end
        b = bvec_push(b, byte)
        if v == 0 do out b end
    end
    out b
end.

func w_s(b: int, value: int):
    var v = value
    more = 1
    when more == 1 loop
        byte = v and 0x7f
        # Vir `shr` is logical. Signed LEB128 needs an arithmetic shift so
        # negative immediates converge to -1 instead of emitting extra bits.
        if v < 0 do
            v = (v + 1) / 128 - 1
        else
            v = v / 128
        end
        if (v == 0 and (byte and 0x40) == 0) or (v == 0 - 1 and (byte and 0x40) != 0) do
            more = 0
        else
            byte = byte or 0x80
        end
        b = bvec_push(b, byte)
    end
    out b
end.

func w_bytes(dst: int, src: int):
    var i = 0
    when i < bvec_len(src) loop
        dst = bvec_push(dst, native_read_u8(src, i))
        i = i + 1
    end
    out dst
end.

func w_name(b: int, s: string):
    if s as int == 0 do
        b = w_u(b, 0)
        out b
    end
    n = fat_str_len(s)
    b = w_u(b, n)
    data = native_read_i64(s as int, 0)
    var i = 0
    when i < n loop
        b = bvec_push(b, native_read_u8(data, i))
        i = i + 1
    end
    out b
end.

func w_section(outb: int, sid: int, body: int):
    outb = bvec_push(outb, sid)
    outb = w_u(outb, bvec_len(body))
    out w_bytes(outb, body)
end.

func w_i32_const(b: int, v: int):
    b = bvec_push(b, W_I32_CONST)
    out w_s(b, v)
end.

func w_i64_const(b: int, v: int):
    b = bvec_push(b, W_I64_CONST)
    out w_s(b, v)
end.

func w_f64_const_100(b: int):
    # IEEE-754 f64 100.0 = 0x4059000000000000, encoded little-endian.
    b = bvec_push(b, W_F64_CONST)
    b = bvec_push(b, 0); b = bvec_push(b, 0); b = bvec_push(b, 0); b = bvec_push(b, 0)
    b = bvec_push(b, 0); b = bvec_push(b, 0); b = bvec_push(b, 0x59); b = bvec_push(b, 0x40)
    out b
end.

func w_local_get(b: int, i: int):
    b = bvec_push(b, W_LOCAL_GET)
    out w_u(b, i)
end.

func w_local_set(b: int, i: int):
    b = bvec_push(b, W_LOCAL_SET)
    out w_u(b, i)
end.

func w_call(b: int, i: int):
    b = bvec_push(b, W_CALL)
    out w_u(b, i)
end.

func w_func_body(code: int, local_count: int, local_type: int):
    body = bvec_new()
    if local_count == 0 do
        body = w_u(body, 0)
    else
        body = w_u(body, 1)
        body = w_u(body, local_count)
        body = bvec_push(body, local_type)
    end
    body = w_bytes(body, code)
    body = bvec_push(body, W_END)
    outb = bvec_new()
    outb = w_u(outb, bvec_len(body))
    out w_bytes(outb, body)
end.

func w_itoa_body(code: int):
    # n:i64 plus dst/pos/digit/sign:i32
    body = bvec_new()
    body = w_u(body, 2)
    body = w_u(body, 1); body = bvec_push(body, W_I64)
    body = w_u(body, 4); body = bvec_push(body, W_I32)
    body = w_bytes(body, code)
    body = bvec_push(body, W_END)
    outb = bvec_new(); outb = w_u(outb, bvec_len(body))
    out w_bytes(outb, body)
end.

func w_emit_fd_write(b: int, ptr: int, len: int):
    # iovec at 0, nwritten at 8.
    b = w_i32_const(b, 0); b = w_i32_const(b, ptr); b = bvec_push(b, W_I32_STORE); b = bvec_push(b, 2); b = bvec_push(b, 0)
    b = w_i32_const(b, 4); b = w_i32_const(b, len); b = bvec_push(b, W_I32_STORE); b = bvec_push(b, 2); b = bvec_push(b, 0)
    b = w_i32_const(b, 1); b = w_i32_const(b, 0); b = w_i32_const(b, 1); b = w_i32_const(b, 8)
    b = w_call(b, 0)
    out bvec_push(b, W_DROP)
end.

func w_print_code():
    # (i64 ptr) -> (); locals: p:i32, len:i32
    b = bvec_new()
    b = w_local_get(b, 0); b = bvec_push(b, W_I32_WRAP_I64); b = w_local_set(b, 1)
    b = w_i32_const(b, 0); b = w_local_set(b, 2)
    b = bvec_push(b, W_BLOCK); b = bvec_push(b, W_VOID)
    b = bvec_push(b, W_LOOP); b = bvec_push(b, W_VOID)
    b = w_local_get(b, 1); b = w_local_get(b, 2); b = bvec_push(b, W_I32_ADD); b = bvec_push(b, W_I32_LOAD8_U); b = bvec_push(b, 0); b = bvec_push(b, 0)
    b = bvec_push(b, W_I32_EQZ); b = bvec_push(b, W_BR_IF); b = w_u(b, 1)
    b = w_local_get(b, 2); b = w_i32_const(b, 1); b = bvec_push(b, W_I32_ADD); b = w_local_set(b, 2)
    b = bvec_push(b, W_BR); b = w_u(b, 0)
    b = bvec_push(b, W_END); b = bvec_push(b, W_END)
    # dynamic iovec write
    b = w_i32_const(b, 0); b = w_local_get(b, 1); b = bvec_push(b, W_I32_STORE); b = bvec_push(b, 2); b = bvec_push(b, 0)
    b = w_i32_const(b, 4); b = w_local_get(b, 2); b = bvec_push(b, W_I32_STORE); b = bvec_push(b, 2); b = bvec_push(b, 0)
    b = w_i32_const(b, 1); b = w_i32_const(b, 0); b = w_i32_const(b, 1); b = w_i32_const(b, 8); b = w_call(b, 0); b = bvec_push(b, W_DROP)
    # newline stored at data offset 1024
    out w_emit_fd_write(b, 1024, 1)
end.

func w_strcat_code():
    # (i64 a, i64 b) -> i64. locals a,b,la,lb,dst,i are i32 indices 2..7.
    b = bvec_new()
    b = w_local_get(b, 0); b = bvec_push(b, W_I32_WRAP_I64); b = w_local_set(b, 2)
    b = w_local_get(b, 1); b = bvec_push(b, W_I32_WRAP_I64); b = w_local_set(b, 3)
    b = w_i32_const(b, 0); b = w_local_set(b, 4)
    b = bvec_push(b, W_BLOCK); b = bvec_push(b, W_VOID); b = bvec_push(b, W_LOOP); b = bvec_push(b, W_VOID)
    b = w_local_get(b, 2); b = w_local_get(b, 4); b = bvec_push(b, W_I32_ADD); b = bvec_push(b, W_I32_LOAD8_U); b = bvec_push(b, 0); b = bvec_push(b, 0); b = bvec_push(b, W_I32_EQZ); b = bvec_push(b, W_BR_IF); b = w_u(b, 1)
    b = w_local_get(b, 4); b = w_i32_const(b, 1); b = bvec_push(b, W_I32_ADD); b = w_local_set(b, 4); b = bvec_push(b, W_BR); b = w_u(b, 0); b = bvec_push(b, W_END); b = bvec_push(b, W_END)
    b = w_i32_const(b, 0); b = w_local_set(b, 5)
    b = bvec_push(b, W_BLOCK); b = bvec_push(b, W_VOID); b = bvec_push(b, W_LOOP); b = bvec_push(b, W_VOID)
    b = w_local_get(b, 3); b = w_local_get(b, 5); b = bvec_push(b, W_I32_ADD); b = bvec_push(b, W_I32_LOAD8_U); b = bvec_push(b, 0); b = bvec_push(b, 0); b = bvec_push(b, W_I32_EQZ); b = bvec_push(b, W_BR_IF); b = w_u(b, 1)
    b = w_local_get(b, 5); b = w_i32_const(b, 1); b = bvec_push(b, W_I32_ADD); b = w_local_set(b, 5); b = bvec_push(b, W_BR); b = w_u(b, 0); b = bvec_push(b, W_END); b = bvec_push(b, W_END)
    b = bvec_push(b, W_GLOBAL_GET); b = w_u(b, 0); b = w_local_set(b, 6)
    b = w_local_get(b, 6); b = w_local_get(b, 4); b = bvec_push(b, W_I32_ADD); b = w_local_get(b, 5); b = bvec_push(b, W_I32_ADD); b = w_i32_const(b, 1); b = bvec_push(b, W_I32_ADD); b = bvec_push(b, W_GLOBAL_SET); b = w_u(b, 0)
    # Store 8-byte header at G0 with blk_size = (((la + lb + 8) & -8) + 8)
    b = bvec_push(b, W_GLOBAL_GET); b = w_u(b, 0)
    b = w_local_get(b, 4); b = w_local_get(b, 5); b = bvec_push(b, W_I32_ADD)
    b = w_i32_const(b, 8); b = bvec_push(b, W_I32_ADD)
    b = w_i32_const(b, 0 - 8); b = bvec_push(b, 0x71)
    b = w_i32_const(b, 8); b = bvec_push(b, W_I32_ADD)
    b = bvec_push(b, W_I32_STORE); b = bvec_push(b, 0); b = bvec_push(b, 0)
    # forward_flag = 0 @ G0 + 4
    b = bvec_push(b, W_GLOBAL_GET); b = w_u(b, 0)
    b = w_i32_const(b, 4); b = bvec_push(b, W_I32_ADD)
    b = w_i32_const(b, 0)
    b = bvec_push(b, W_I32_STORE); b = bvec_push(b, 0); b = bvec_push(b, 0)
    # dst (local 6) = G0 + 8
    b = bvec_push(b, W_GLOBAL_GET); b = w_u(b, 0)
    b = w_i32_const(b, 8); b = bvec_push(b, W_I32_ADD)
    b = w_local_set(b, 6)
    # G0 = G0 + *(G0)
    b = bvec_push(b, W_GLOBAL_GET); b = w_u(b, 0)
    b = bvec_push(b, W_GLOBAL_GET); b = w_u(b, 0)
    b = bvec_push(b, W_I32_LOAD); b = bvec_push(b, 0); b = bvec_push(b, 0)
    b = bvec_push(b, W_I32_ADD)
    b = bvec_push(b, W_GLOBAL_SET); b = w_u(b, 0)
    # copy a
    b = w_i32_const(b, 0); b = w_local_set(b, 7); b = bvec_push(b, W_BLOCK); b = bvec_push(b, W_VOID); b = bvec_push(b, W_LOOP); b = bvec_push(b, W_VOID)
    b = w_local_get(b, 7); b = w_local_get(b, 4); b = bvec_push(b, W_I32_GE_U); b = bvec_push(b, W_BR_IF); b = w_u(b, 1)
    b = w_local_get(b, 6); b = w_local_get(b, 7); b = bvec_push(b, W_I32_ADD); b = w_local_get(b, 2); b = w_local_get(b, 7); b = bvec_push(b, W_I32_ADD); b = bvec_push(b, W_I32_LOAD8_U); b = bvec_push(b, 0); b = bvec_push(b, 0); b = bvec_push(b, W_I32_STORE8); b = bvec_push(b, 0); b = bvec_push(b, 0)
    b = w_local_get(b, 7); b = w_i32_const(b, 1); b = bvec_push(b, W_I32_ADD); b = w_local_set(b, 7); b = bvec_push(b, W_BR); b = w_u(b, 0); b = bvec_push(b, W_END); b = bvec_push(b, W_END)
    # copy b
    b = w_i32_const(b, 0); b = w_local_set(b, 7); b = bvec_push(b, W_BLOCK); b = bvec_push(b, W_VOID); b = bvec_push(b, W_LOOP); b = bvec_push(b, W_VOID)
    b = w_local_get(b, 7); b = w_local_get(b, 5); b = bvec_push(b, W_I32_GE_U); b = bvec_push(b, W_BR_IF); b = w_u(b, 1)
    b = w_local_get(b, 6); b = w_local_get(b, 4); b = bvec_push(b, W_I32_ADD); b = w_local_get(b, 7); b = bvec_push(b, W_I32_ADD); b = w_local_get(b, 3); b = w_local_get(b, 7); b = bvec_push(b, W_I32_ADD); b = bvec_push(b, W_I32_LOAD8_U); b = bvec_push(b, 0); b = bvec_push(b, 0); b = bvec_push(b, W_I32_STORE8); b = bvec_push(b, 0); b = bvec_push(b, 0)
    b = w_local_get(b, 7); b = w_i32_const(b, 1); b = bvec_push(b, W_I32_ADD); b = w_local_set(b, 7); b = bvec_push(b, W_BR); b = w_u(b, 0); b = bvec_push(b, W_END); b = bvec_push(b, W_END)
    b = w_local_get(b, 6); b = w_local_get(b, 4); b = bvec_push(b, W_I32_ADD); b = w_local_get(b, 5); b = bvec_push(b, W_I32_ADD); b = w_i32_const(b, 0); b = bvec_push(b, W_I32_STORE8); b = bvec_push(b, 0); b = bvec_push(b, 0)
    b = w_local_get(b, 6)
    out bvec_push(b, W_I64_EXTEND_I32_U)
end.

func w_itoa_code():
    # (i64 n) -> i64 with the same signed decimal spelling as native targets.
    b = bvec_new()
    # locals: n:i64 index1, dst:i32 index2, pos:i32 index3, digit:i32 index4,
    # sign:i32 index5
    b = w_local_get(b, 0); b = w_local_set(b, 1); b = bvec_push(b, W_GLOBAL_GET); b = w_u(b, 0); b = w_local_set(b, 2)
    # sign = n < 0; n = sign ? (0 - n) : n
    b = w_local_get(b, 1); b = w_i64_const(b, 0); b = bvec_push(b, 0x53); b = w_local_set(b, 5)
    b = w_i64_const(b, 0); b = w_local_get(b, 1); b = bvec_push(b, 0x7d)
    b = w_local_get(b, 1); b = w_local_get(b, 5); b = bvec_push(b, W_SELECT); b = w_local_set(b, 1)
    b = w_local_get(b, 2); b = w_i32_const(b, 32); b = bvec_push(b, W_I32_ADD); b = bvec_push(b, W_GLOBAL_SET); b = w_u(b, 0)
    b = w_local_get(b, 2); b = w_i32_const(b, 31); b = bvec_push(b, W_I32_ADD); b = w_i32_const(b, 0); b = bvec_push(b, W_I32_STORE8); b = bvec_push(b, 0); b = bvec_push(b, 0)
    b = w_i32_const(b, 30); b = w_local_set(b, 3)
    b = bvec_push(b, W_LOOP); b = bvec_push(b, W_VOID)
    b = w_local_get(b, 1); b = w_i64_const(b, 10); b = bvec_push(b, W_I64_REM_S); b = bvec_push(b, W_I32_WRAP_I64); b = w_i32_const(b, 48); b = bvec_push(b, W_I32_ADD); b = w_local_set(b, 4)
    b = w_local_get(b, 2); b = w_local_get(b, 3); b = bvec_push(b, W_I32_ADD); b = w_local_get(b, 4); b = bvec_push(b, W_I32_STORE8); b = bvec_push(b, 0); b = bvec_push(b, 0)
    b = w_local_get(b, 1); b = w_i64_const(b, 10); b = bvec_push(b, W_I64_DIV_S); b = w_local_set(b, 1)
    b = w_local_get(b, 3); b = w_i32_const(b, 1); b = bvec_push(b, W_I32_SUB); b = w_local_set(b, 3)
    b = w_local_get(b, 1); b = bvec_push(b, W_I64_EQZ); b = bvec_push(b, W_I32_EQZ); b = bvec_push(b, W_BR_IF); b = w_u(b, 0)
    b = bvec_push(b, W_END)
    # Prefix '-' when the original input was negative.
    b = bvec_push(b, W_BLOCK); b = bvec_push(b, W_VOID)
    b = w_local_get(b, 5); b = bvec_push(b, W_I32_EQZ); b = bvec_push(b, W_BR_IF); b = w_u(b, 0)
    b = w_local_get(b, 2); b = w_local_get(b, 3); b = bvec_push(b, W_I32_ADD); b = w_i32_const(b, 45); b = bvec_push(b, W_I32_STORE8); b = bvec_push(b, 0); b = bvec_push(b, 0)
    b = w_local_get(b, 3); b = w_i32_const(b, 1); b = bvec_push(b, W_I32_SUB); b = w_local_set(b, 3)
    b = bvec_push(b, W_END)
    b = w_local_get(b, 2); b = w_local_get(b, 3); b = w_i32_const(b, 1); b = bvec_push(b, W_I32_ADD); b = bvec_push(b, W_I32_ADD); b = bvec_push(b, W_I64_EXTEND_I32_U)
    out b
end.

func w_bool_code():
    # (i64 value) -> i64 pointer. Fixed strings live at data offsets below.
    b = bvec_new()
    b = w_i64_const(b, 1032) # "true"
    b = w_i64_const(b, 1026) # "false"
    b = w_local_get(b, 0); b = bvec_push(b, W_I64_EQZ); b = bvec_push(b, W_I32_EQZ)
    out bvec_push(b, W_SELECT)
end.

func w_promote_graph_code(pg_fn_idx: int):
    ##
     * (p: i32) -> (new_p: i32)
     * Conservative transitive graph promotion: Arena -> Persistent Heap.
     *
     * Block layout in Wasm Arena (p = user pointer):
     *   [blk_size: i32]     @ p - 8   (total block size including header)
     *   [forward_flag: i32] @ p - 4   (0 = live; 0xFFFFFF = already promoted)
     *   [payload...]        @ p
     *
     * Locals (all i32):
     *   0: p            parameter
     *   1: hdr          = p - 8
     *   2: blk_size
     *   3: payload_size = blk_size - 8
     *   4: new_base     start of new block in Persistent Heap
     *   5: new_p        = new_base + 8
     *   6: off          loop counter
     *   7: word         candidate child pointer
     *   8: child_new    promoted child address
     ##
    b = bvec_new()

    # Guard: p < 1048576 → not an arena pointer, return p unchanged
    b = w_local_get(b, 0)
    b = w_i32_const(b, 1048576)
    b = bvec_push(b, W_I32_GE_U)
    b = bvec_push(b, W_IF); b = bvec_push(b, W_I32)

    # ── p is in arena ─────────────────────────────────────────────────

    # local 1: hdr = p - 8
    b = w_local_get(b, 0); b = w_i32_const(b, 8); b = bvec_push(b, W_I32_SUB)
    b = w_local_set(b, 1)

    # Check forward_flag @ hdr + 4
    b = w_local_get(b, 1); b = w_i32_const(b, 4); b = bvec_push(b, W_I32_ADD)
    b = bvec_push(b, W_I32_LOAD); b = bvec_push(b, 0); b = bvec_push(b, 0)
    b = w_i32_const(b, 0 - 1); b = bvec_push(b, W_I32_EQ)
    b = bvec_push(b, W_IF); b = bvec_push(b, W_I32)
    # Already promoted → return forwarding pointer stored at payload[0]
    b = w_local_get(b, 0)
    b = bvec_push(b, W_I32_LOAD); b = bvec_push(b, 0); b = bvec_push(b, 0)
    b = bvec_push(b, W_ELSE)

    # ── not yet promoted ──────────────────────────────────────────────

    # local 2: blk_size = i32.load(hdr)
    b = w_local_get(b, 1)
    b = bvec_push(b, W_I32_LOAD); b = bvec_push(b, 0); b = bvec_push(b, 0)
    b = w_local_set(b, 2)

    # Guard blk_size in [8, 1048576]; default to 32
    b = w_local_get(b, 2); b = w_i32_const(b, 8); b = bvec_push(b, W_I32_LT_U)
    b = w_local_get(b, 2); b = w_i32_const(b, 1048576); b = bvec_push(b, W_I32_GE_U)
    b = bvec_push(b, W_I32_OR)
    b = bvec_push(b, W_IF); b = bvec_push(b, W_VOID)
    b = w_i32_const(b, 32); b = w_local_set(b, 2)
    b = bvec_push(b, W_END)

    # local 3: payload_size = blk_size - 8
    b = w_local_get(b, 2); b = w_i32_const(b, 8); b = bvec_push(b, W_I32_SUB)
    b = w_local_set(b, 3)

    # Allocate block in Persistent Heap (Global 1):
    # local 4: new_base = Global1
    b = bvec_push(b, W_GLOBAL_GET); b = w_u(b, 1)
    b = w_local_set(b, 4)
    # Global1 += blk_size
    b = bvec_push(b, W_GLOBAL_GET); b = w_u(b, 1)
    b = w_local_get(b, 2); b = bvec_push(b, W_I32_ADD)
    b = bvec_push(b, W_GLOBAL_SET); b = w_u(b, 1)

    # local 5: new_p = new_base + 8
    b = w_local_get(b, 4); b = w_i32_const(b, 8); b = bvec_push(b, W_I32_ADD)
    b = w_local_set(b, 5)

    # Write header in Persistent Heap
    b = w_local_get(b, 4); b = w_local_get(b, 2)
    b = bvec_push(b, W_I32_STORE); b = bvec_push(b, 0); b = bvec_push(b, 0)
    # forward_flag = 0 in new block (Persistent Heap is never re-promoted)
    b = w_local_get(b, 4); b = w_i32_const(b, 4); b = bvec_push(b, W_I32_ADD)
    b = w_i32_const(b, 0)
    b = bvec_push(b, W_I32_STORE); b = bvec_push(b, 0); b = bvec_push(b, 0)

    # Copy payload: off (local 6) = 0
    b = w_i32_const(b, 0); b = w_local_set(b, 6)
    if target_has_wasm_simd128() == 1 do
        # 16-byte SIMD128 copy loop: while off + 16 <= payload_size
        b = bvec_push(b, W_BLOCK); b = bvec_push(b, W_VOID)
        b = bvec_push(b, W_LOOP); b = bvec_push(b, W_VOID)
        b = w_local_get(b, 6); b = w_i32_const(b, 16); b = bvec_push(b, W_I32_ADD)
        b = w_local_get(b, 3); b = bvec_push(b, W_I32_GT_U)
        b = bvec_push(b, W_BR_IF); b = w_u(b, 1)
        b = w_local_get(b, 5); b = w_local_get(b, 6); b = bvec_push(b, W_I32_ADD)
        b = w_local_get(b, 0); b = w_local_get(b, 6); b = bvec_push(b, W_I32_ADD)
        b = bvec_push(b, 0xfd); b = bvec_push(b, 0x00); b = bvec_push(b, 0); b = bvec_push(b, 0)
        b = bvec_push(b, 0xfd); b = bvec_push(b, 0x0b); b = bvec_push(b, 0); b = bvec_push(b, 0)
        b = w_local_get(b, 6); b = w_i32_const(b, 16); b = bvec_push(b, W_I32_ADD); b = w_local_set(b, 6)
        b = bvec_push(b, W_BR); b = w_u(b, 0)
        b = bvec_push(b, W_END); b = bvec_push(b, W_END)
    end
    # Copy remaining tail bytes byte-by-byte:
    b = bvec_push(b, W_BLOCK); b = bvec_push(b, W_VOID)
    b = bvec_push(b, W_LOOP); b = bvec_push(b, W_VOID)
    b = w_local_get(b, 6); b = w_local_get(b, 3); b = bvec_push(b, W_I32_GE_U)
    b = bvec_push(b, W_BR_IF); b = w_u(b, 1)
    b = w_local_get(b, 5); b = w_local_get(b, 6); b = bvec_push(b, W_I32_ADD)
    b = w_local_get(b, 0); b = w_local_get(b, 6); b = bvec_push(b, W_I32_ADD)
    b = bvec_push(b, W_I32_LOAD8_U); b = bvec_push(b, 0); b = bvec_push(b, 0)
    b = bvec_push(b, W_I32_STORE8); b = bvec_push(b, 0); b = bvec_push(b, 0)
    b = w_local_get(b, 6); b = w_i32_const(b, 1); b = bvec_push(b, W_I32_ADD); b = w_local_set(b, 6)
    b = bvec_push(b, W_BR); b = w_u(b, 0)
    b = bvec_push(b, W_END); b = bvec_push(b, W_END)

    # Mark source as FORWARDED before recursion (cycle prevention):
    # i32.store(hdr + 4, -1)
    b = w_local_get(b, 1); b = w_i32_const(b, 4); b = bvec_push(b, W_I32_ADD)
    b = w_i32_const(b, 0 - 1)
    b = bvec_push(b, W_I32_STORE); b = bvec_push(b, 0); b = bvec_push(b, 0)
    # i32.store(p, new_p) — forwarding pointer in old payload[0]
    b = w_local_get(b, 0); b = w_local_get(b, 5)
    b = bvec_push(b, W_I32_STORE); b = bvec_push(b, 0); b = bvec_push(b, 0)

    # Conservative pointer scan: every 4-byte aligned word in new payload
    b = w_i32_const(b, 0); b = w_local_set(b, 6)
    b = bvec_push(b, W_BLOCK); b = bvec_push(b, W_VOID)
    b = bvec_push(b, W_LOOP); b = bvec_push(b, W_VOID)
    # if off + 4 > payload_size: break
    b = w_local_get(b, 6); b = w_i32_const(b, 4); b = bvec_push(b, W_I32_ADD)
    b = w_local_get(b, 3); b = bvec_push(b, W_I32_GT_U)
    b = bvec_push(b, W_BR_IF); b = w_u(b, 1)
    # word (local 7) = i32.load(new_p + off)
    b = w_local_get(b, 5); b = w_local_get(b, 6); b = bvec_push(b, W_I32_ADD)
    b = bvec_push(b, W_I32_LOAD); b = bvec_push(b, 0); b = bvec_push(b, 0)
    b = w_local_set(b, 7)
    # if word >= 1048576 AND word < Global0 (inside arena)
    b = w_local_get(b, 7); b = w_i32_const(b, 1048576); b = bvec_push(b, W_I32_GE_U)
    b = w_local_get(b, 7); b = bvec_push(b, W_GLOBAL_GET); b = w_u(b, 0)
    b = bvec_push(b, W_I32_LT_U)
    b = bvec_push(b, W_I32_AND)
    b = bvec_push(b, W_IF); b = bvec_push(b, W_VOID)
    # child_new (local 8) = call w_promote_graph(word)  [recursive]
    b = w_local_get(b, 7)
    b = w_call(b, pg_fn_idx)
    b = w_local_set(b, 8)
    # i32.store(new_p + off, child_new)
    b = w_local_get(b, 5); b = w_local_get(b, 6); b = bvec_push(b, W_I32_ADD)
    b = w_local_get(b, 8)
    b = bvec_push(b, W_I32_STORE); b = bvec_push(b, 0); b = bvec_push(b, 0)
    b = bvec_push(b, W_END)  # end if word in arena
    b = w_local_get(b, 6); b = w_i32_const(b, 4); b = bvec_push(b, W_I32_ADD); b = w_local_set(b, 6)
    b = bvec_push(b, W_BR); b = w_u(b, 0)
    b = bvec_push(b, W_END); b = bvec_push(b, W_END)  # end loop/block

    # return new_p
    b = w_local_get(b, 5)
    b = bvec_push(b, W_END)   # end ELSE (not-yet-promoted)

    b = bvec_push(b, W_ELSE)  # p < 1048576: not arena
    b = w_local_get(b, 0)     # return p unchanged
    b = bvec_push(b, W_END)   # end IF (p >= 1048576)

    out b
end.



func w_opnd(b: int, op: int):
    typ = lir_opnd_type(op)
    if typ == LirOperandType.VRegInt as int or typ == LirOperandType.VRegFloat as int do out w_local_get(b, lir_opnd_vreg(op)) end
    if typ == LirOperandType.Imm as int do out w_i64_const(b, lir_opnd_imm_val(op)) end
    out w_i64_const(b, 0)
end.

func wasm_lir_unsupported(op: int, detail: int):
    var text = sb_append(sb_new(), "wasm32-wasi-p1 backend cannot lower LIR op ")
    text = sb_append_int(text, op)
    if detail >= 0 do
        text = sb_append(text, " (detail ")
        text = sb_append_int(text, detail)
        text = sb_append_char(text, 41)
    end
    let message = sb_to_string(text)
    var classic = sb_append(sb_new(), "virc: error [E-WASM-UNSUPPORTED]: ")
    classic = sb_append(classic, message)
    compilerFailure("E-WASM-UNSUPPORTED" as int, message, sb_to_string(classic))
    compilerAbort()
end.

func wasm_lir_validate_supported(mainf: int, lir_funcs: int):
    blocks = lir_func_blocks(mainf)
    var bi = 0
    var done = 0
    when bi < vec_len_rt(blocks) & done == 0 loop
        insv = lir_block_instrs(vec_get_rt(blocks, bi))
        var ii = 0
        when ii < vec_len_rt(insv) loop
            ins = vec_get_rt(insv, ii)
            op = lir_instr_op(ins)
            var supported = op == LirOp.Mov as int or op == LirOp.Add as int or op == LirOp.Sub as int or op == LirOp.Mul as int or op == LirOp.Div as int or op == LirOp.SetArg as int or op == LirOp.Ret as int or op == LirOp.Load as int or op == LirOp.Store as int or op == LirOp.Nop as int or (op >= LirOp.VLoad as int and op <= LirOp.Shuffle as int)
            var kind = 0 - 1
            if op == LirOp.Jmp as int do
                target = lir_opnd_imm_val(lir_instr_src1(ins))
                if bi + 1 < vec_len_rt(blocks) & lir_block_id(vec_get_rt(blocks, bi + 1)) == target do
                    supported = true
                end
            eif op == LirOp.Call as int do
                sid = lir_instr_aux(ins)
                strings = lir_func_strings(mainf)
                var call_unresolved = 0
                if sid < 0 or sid >= vec_len_rt(strings) do
                    call_unresolved = 1
                else
                    cname = vec_get_rt(strings, sid)
                    if cname as int == 0 do
                        call_unresolved = 1
                    else
                        ffi_id = ffi_import_find(cname)
                        if ffi_id >= 0 do
                            ffi_import_mark_used(ffi_id as int)
                            supported = true
                        eif fat_cstr_eq(cname, "print_ln") == 1 or fat_cstr_eq(cname, "print_str") == 1 or fat_cstr_eq(cname, "print") == 1 do
                            supported = true
                        eif lir_funcs != 0 and lir_find_func_index(lir_funcs as i64, cname as string) >= 0 do
                            supported = true
                        else
                            call_unresolved = 1
                        end
                    end
                end
                if call_unresolved == 1 do
                    print_str("virc: linker error: unresolved direct function call\n")
                    sys_exit(1)
                end
            eif op == LirOp.Intrinsic as int do
                kind = lir_instr_aux(ins)
                if kind == MIR_INTR_ADDR_OF do
                    sid = lir_opnd_imm_val(lir_instr_src1(ins))
                    strings = lir_func_strings(mainf)
                    var addr_unresolved = 0
                    if sid < 0 or sid >= vec_len_rt(strings) do
                        addr_unresolved = 1
                    else
                        cname = vec_get_rt(strings, sid)
                        if cname as int == 0 do
                            addr_unresolved = 1
                        else
                            ffi_id = ffi_import_find(cname)
                            if ffi_id >= 0 do
                                # FFI function address
                            eif fat_cstr_eq(cname, "print_ln") == 1 or fat_cstr_eq(cname, "print_str") == 1 or fat_cstr_eq(cname, "print") == 1 do
                                # Built-in print
                            eif lir_funcs != 0 and lir_find_func_index(lir_funcs as i64, cname as string) >= 0 do
                                # LIR function
                            else
                                addr_unresolved = 1
                            end
                        end
                    end
                    if addr_unresolved == 1 do
                        print_str("virc: linker error: unresolved function address\n")
                        sys_exit(1)
                    end
                end
                supported = kind == MIR_INTR_STR_LIT or kind == MIR_INTR_PRINT or kind == MIR_INTR_PRINT_STR or kind == MIR_INTR_PERCENT or kind == MIR_INTR_LOAD_ADDR or kind == MIR_INTR_ERX or kind == MIR_INTR_PATCH_POINT or kind == 28 or kind == MIR_MEM_MARK or kind == MIR_MEM_RESET or kind == MIR_MEM_DROP or kind == MIR_MEM_PROMOTE or kind == MIR_INTR_THROW or kind == MIR_INTR_INDEX or kind == MIR_INTR_INDEX_STORE
                if (kind and 0xFF) == MIR_INTR_CAST do
                    supported = lir_instr_typ(ins) != LirType.F64 as int & lir_opnd_type(lir_instr_src1(ins)) != LirOperandType.VRegFloat as int
                end
                if kind == MIR_INTR_BUILTIN do
                    bid = lir_opnd_imm_val(lir_instr_src1(ins))
                    supported = bid == 11 or bid == 19 or bid == 1000 or bid == 3 or bid == 4 or bid == 5 or bid == 6 or bid == 7 or bid == 8 or bid == 22 or bid == 18 or bid == 1 or bid == 9 or bid == 31 or bid == 32
                end
            end
            if not supported do
                wasm_lir_unsupported(op, kind)
            end
            if op == LirOp.Ret as int do done = 1 end
            ii = ii + 1
        end
        bi = bi + 1
    end
end.

func wasm_lir_write_module(lir_funcs: int, path: int):
    # The active frontend always emits global-init then main; use main's LIR
    # body and real vreg operands. Unsupported CFG/function features remain a
    # compiler diagnostic concern, never an empty placeholder body.
    mainf = 0
    var fi = 0
    when fi <  vec_len_rt(lir_funcs) loop
        f = vec_get_rt(lir_funcs, fi)
        # main is normally the final user function; global init has no strings.
        if vec_len_rt(lir_func_strings(f)) > 0 do mainf = f end
        fi = fi + 1
    end
    if mainf == 0 do mainf = vec_get_rt(lir_funcs, vec_len_rt(lir_funcs) - 1) end
    wasm_lir_validate_supported(mainf, lir_funcs)
    let n_ffi = ffi_import_used_count()
    strings = lir_func_strings(mainf)
    data = bvec_new(); data = bvec_push(data, 10); data = bvec_push(data, 0)
    # Stable bool spellings used by w_bool_code: false@1026, true@1032.
    data = bvec_push(data, 102); data = bvec_push(data, 97); data = bvec_push(data, 108); data = bvec_push(data, 115); data = bvec_push(data, 101); data = bvec_push(data, 0)
    data = bvec_push(data, 116); data = bvec_push(data, 114); data = bvec_push(data, 117); data = bvec_push(data, 101); data = bvec_push(data, 0)
    offsets = vec_new_rt(); off = 1037
    var si = 0
    when si < vec_len_rt(strings) loop
        s = vec_get_rt(strings, si) as string
        offsets = vec_push_rt(offsets, off)
        if s as int != 0 do
            sp = native_read_i64(s as int, 0); sl = fat_str_len(s)
            var bi = 0
            when bi < sl loop data = bvec_push(data, native_read_u8(sp, bi)); bi = bi + 1 end
            data = bvec_push(data, 0); off = off + sl + 1
        else
            data = bvec_push(data, 0); off = off + 1
        end
        si = si + 1
    end
    heap = off + 16
    var freelists_base = off + 16
    heap = freelists_base + 32
    code = bvec_new(); maxr = 0; args_base = 128
    blocks = lir_func_blocks(mainf)
    var bi = 0
    var code_done = 0
    when bi < vec_len_rt(blocks) & code_done == 0 loop
        insv = lir_block_instrs(vec_get_rt(blocks, bi))
        var ii = 0
        when ii < vec_len_rt(insv) loop
            ins = vec_get_rt(insv, ii); dst = lir_instr_dst(ins); src1 = lir_instr_src1(ins); src2 = lir_instr_src2(ins)
            if (lir_opnd_type(dst) == LirOperandType.VRegInt as int or lir_opnd_type(dst) == LirOperandType.VRegFloat as int) and lir_opnd_vreg(dst) > maxr do maxr = lir_opnd_vreg(dst) end
            op = lir_instr_op(ins)
            if op == LirOp.Mov as int do
                code = w_opnd(code, src1); code = w_local_set(code, lir_opnd_vreg(dst))
            eif op == LirOp.Add as int or op == LirOp.Sub as int or op == LirOp.Mul as int or op == LirOp.Div as int do
                code = w_opnd(code, src1); code = w_opnd(code, src2)
                if op == LirOp.Add as int do code = bvec_push(code, 0x7c) end
                if op == LirOp.Sub as int do code = bvec_push(code, 0x7d) end
                if op == LirOp.Mul as int do code = bvec_push(code, 0x7e) end
                if op == LirOp.Div as int do code = bvec_push(code, W_I64_DIV_S) end
                code = w_local_set(code, lir_opnd_vreg(dst))
            eif op == LirOp.SetArg as int do
                code = w_opnd(code, src2); code = w_local_set(code, args_base + lir_opnd_imm_val(src1))
            eif op == LirOp.Call as int do
                sid = lir_instr_aux(ins)
                var call_unresolved = 0
                if sid < 0 or sid >= vec_len_rt(strings) do
                    call_unresolved = 1
                else
                    cname = vec_get_rt(strings, sid)
                    if cname as int == 0 or fat_cstr_eq(cname, "__unresolved_callee__") == 1 do
                        call_unresolved = 1
                    end
                end
                if call_unresolved == 1 do
                    print_str("virc: linker error: unresolved direct function call\n")
                    sys_exit(1)
                end
                        ffi_id = ffi_import_find(cname)
                        if ffi_id >= 0 do
                            var ffi_dense = 0 - 1
                            var ffi_k = 0
                            when ffi_k < n_ffi loop
                                if ffi_import_used_at(ffi_k) == ffi_id do
                                    ffi_dense = ffi_k
                                end
                                ffi_k = ffi_k + 1
                            end
                            if ffi_dense >= 0 do
                                call_target = 1 + ffi_dense
                                code = w_call(code, call_target)
                                code = bvec_push(code, W_I64_EXTEND_I32_U)
                                if lir_opnd_type(dst) == LirOperandType.VRegInt as int do
                                    code = w_local_set(code, lir_opnd_vreg(dst))
                                else
                                    code = bvec_push(code, W_DROP)
                                end
                            end
                        eif fat_cstr_eq(cname, "print_ln") == 1 or fat_cstr_eq(cname, "print_str") == 1 or fat_cstr_eq(cname, "print") == 1 do
                            code = w_local_get(code, args_base)
                            code = w_call(code, 1 + n_ffi)
                        end
            eif op == LirOp.Load as int do
                code = w_opnd(code, src1)
                code = bvec_push(code, W_I32_WRAP_I64)
                code = bvec_push(code, 0x29)
                code = bvec_push(code, 3)
                code = bvec_push(code, 0)
                code = w_local_set(code, lir_opnd_vreg(dst))
            eif op == LirOp.Store as int do
                code = w_opnd(code, src2)
                code = bvec_push(code, W_I32_WRAP_I64)
                code = w_opnd(code, src1)
                code = bvec_push(code, 0x37)
                code = bvec_push(code, 3)
                code = bvec_push(code, 0)
            eif op == LirOp.Splat as int do
                sp_aux = lir_instr_aux(ins)
                var sp_lanes = (sp_aux shr 8) and 255
                if sp_lanes <= 0 do sp_lanes = 4 end
                var spi = 0
                if target_has_wasm_simd128() == 1 do
                    when spi + 2 <= sp_lanes loop
                        code = w_opnd(code, dst)
                        code = w_i64_const(code, 16 + spi * 8)
                        code = bvec_push(code, 0x7c)
                        code = bvec_push(code, W_I32_WRAP_I64)
                        code = w_opnd(code, src1)
                        code = bvec_push(code, 0xfd)
                        code = bvec_push(code, 0x12)
                        code = bvec_push(code, 0xfd)
                        code = bvec_push(code, 0x0b)
                        code = bvec_push(code, 3)
                        code = bvec_push(code, 0)
                        spi = spi + 2
                    end
                end
                when spi < sp_lanes loop
                    code = w_opnd(code, dst)
                    code = w_i64_const(code, 16 + spi * 8)
                    code = bvec_push(code, 0x7c)
                    code = bvec_push(code, W_I32_WRAP_I64)
                    code = w_opnd(code, src1)
                    code = bvec_push(code, 0x37)
                    code = bvec_push(code, 3)
                    code = bvec_push(code, 0)
                    spi = spi + 1
                end
            eif op == LirOp.Shuffle as int do
                sh_aux = lir_instr_aux(ins)
                var sh_lanes = (sh_aux shr 8) and 255
                if sh_lanes <= 0 do sh_lanes = 4 end
                let sh_mask = (sh_aux shr 32)
                var shi = 0
                when shi < sh_lanes loop
                    let src_lane = (sh_mask shr (shi * 4)) and 15
                    code = w_opnd(code, dst)
                    code = w_i64_const(code, 16 + shi * 8)
                    code = bvec_push(code, 0x7c)
                    code = bvec_push(code, W_I32_WRAP_I64)
                    code = w_opnd(code, src1)
                    code = w_i64_const(code, 16 + src_lane * 8)
                    code = bvec_push(code, 0x7c)
                    code = bvec_push(code, W_I32_WRAP_I64)
                    code = bvec_push(code, 0x29)
                    code = bvec_push(code, 3)
                    code = bvec_push(code, 0)
                    code = bvec_push(code, 0x37)
                    code = bvec_push(code, 3)
                    code = bvec_push(code, 0)
                    shi = shi + 1
                end
            eif op == LirOp.VAdd as int or op == LirOp.VSub as int or op == LirOp.VMul as int or op == LirOp.VFma as int do
                v_aux = lir_instr_aux(ins)
                var v_lanes = (v_aux shr 8) and 255
                if v_lanes <= 0 do v_lanes = 4 end
                var v_is_float = 0
                if (v_aux and 255) == 2 or lir_instr_typ(ins) == (LirType.F64 as int) or lir_instr_typ(ins) == (LirType.F32 as int) do
                    v_is_float = 1
                end
                let v_l_scalar = (v_aux shr 24) and 1
                let v_r_scalar = (v_aux shr 25) and 1
                let v_dyn_idx = (v_aux shr 26) and 1
                var vi = 0
                if target_has_wasm_simd128() == 1 do
                    when vi + 2 <= v_lanes loop
                        code = w_opnd(code, dst)
                        if v_dyn_idx == 1 do
                            code = w_local_get(code, args_base)
                            if vi > 0 do
                                code = w_i64_const(code, vi)
                                code = bvec_push(code, 0x7c)
                            end
                            code = w_i64_const(code, 8)
                            code = bvec_push(code, 0x7e)
                            code = w_i64_const(code, 16)
                            code = bvec_push(code, 0x7c)
                        else
                            code = w_i64_const(code, 16 + vi * 8)
                        end
                        code = bvec_push(code, 0x7c)
                        code = bvec_push(code, W_I32_WRAP_I64)
                        if v_l_scalar == 1 do
                            code = w_opnd(code, src1)
                            if v_is_float == 1 do
                                code = bvec_push(code, W_F64_REINTERPRET_I64)
                                code = bvec_push(code, 0xfd)
                                code = bvec_push(code, 0x14)
                            else
                                code = bvec_push(code, 0xfd)
                                code = bvec_push(code, 0x12)
                            end
                        else
                            code = w_opnd(code, src1)
                            if v_dyn_idx == 1 do
                                code = w_local_get(code, args_base)
                                if vi > 0 do
                                    code = w_i64_const(code, vi)
                                    code = bvec_push(code, 0x7c)
                                end
                                code = w_i64_const(code, 8)
                                code = bvec_push(code, 0x7e)
                                code = w_i64_const(code, 16)
                                code = bvec_push(code, 0x7c)
                            else
                                code = w_i64_const(code, 16 + vi * 8)
                            end
                            code = bvec_push(code, 0x7c)
                            code = bvec_push(code, W_I32_WRAP_I64)
                            code = bvec_push(code, 0xfd)
                            code = bvec_push(code, 0x00)
                            code = bvec_push(code, 3)
                            code = bvec_push(code, 0)
                        end
                        if v_r_scalar == 1 do
                            code = w_opnd(code, src2)
                            if v_is_float == 1 do
                                code = bvec_push(code, W_F64_REINTERPRET_I64)
                                code = bvec_push(code, 0xfd)
                                code = bvec_push(code, 0x14)
                            else
                                code = bvec_push(code, 0xfd)
                                code = bvec_push(code, 0x12)
                            end
                        else
                            code = w_opnd(code, src2)
                            if v_dyn_idx == 1 do
                                code = w_local_get(code, args_base)
                                if vi > 0 do
                                    code = w_i64_const(code, vi)
                                    code = bvec_push(code, 0x7c)
                                end
                                code = w_i64_const(code, 8)
                                code = bvec_push(code, 0x7e)
                                code = w_i64_const(code, 16)
                                code = bvec_push(code, 0x7c)
                            else
                                code = w_i64_const(code, 16 + vi * 8)
                            end
                            code = bvec_push(code, 0x7c)
                            code = bvec_push(code, W_I32_WRAP_I64)
                            code = bvec_push(code, 0xfd)
                            code = bvec_push(code, 0x00)
                            code = bvec_push(code, 3)
                            code = bvec_push(code, 0)
                        end
                        code = bvec_push(code, 0xfd)
                        if v_is_float == 1 do
                            if op == LirOp.VAdd as int do code = w_u(code, 0xF0) end
                            if op == LirOp.VSub as int do code = w_u(code, 0xF1) end
                            if op == LirOp.VMul as int or op == LirOp.VFma as int do code = w_u(code, 0xF2) end
                        else
                            if op == LirOp.VAdd as int do code = w_u(code, 0xCE) end
                            if op == LirOp.VSub as int do code = w_u(code, 0xD1) end
                            if op == LirOp.VMul as int or op == LirOp.VFma as int do code = w_u(code, 0xD5) end
                        end
                        code = bvec_push(code, 0xfd)
                        code = bvec_push(code, 0x0b)
                        code = bvec_push(code, 3)
                        code = bvec_push(code, 0)
                        vi = vi + 2
                    end
                end
                when vi < v_lanes loop
                    code = w_opnd(code, dst)
                    if v_dyn_idx == 1 do
                        code = w_local_get(code, args_base)
                        if vi > 0 do
                            code = w_i64_const(code, vi)
                            code = bvec_push(code, 0x7c)
                        end
                        code = w_i64_const(code, 8)
                        code = bvec_push(code, 0x7e)
                        code = w_i64_const(code, 16)
                        code = bvec_push(code, 0x7c)
                    else
                        code = w_i64_const(code, 16 + vi * 8)
                    end
                    code = bvec_push(code, 0x7c)
                    code = bvec_push(code, W_I32_WRAP_I64)
                    if v_l_scalar == 1 do
                        code = w_opnd(code, src1)
                        if v_is_float == 1 do
                            code = bvec_push(code, W_F64_REINTERPRET_I64)
                        end
                    else
                        code = w_opnd(code, src1)
                        if v_dyn_idx == 1 do
                            code = w_local_get(code, args_base)
                            if vi > 0 do
                                code = w_i64_const(code, vi)
                                code = bvec_push(code, 0x7c)
                            end
                            code = w_i64_const(code, 8)
                            code = bvec_push(code, 0x7e)
                            code = w_i64_const(code, 16)
                            code = bvec_push(code, 0x7c)
                        else
                            code = w_i64_const(code, 16 + vi * 8)
                        end
                        code = bvec_push(code, 0x7c)
                        code = bvec_push(code, W_I32_WRAP_I64)
                        if v_is_float == 1 do
                            code = bvec_push(code, 0x2b)
                        else
                            code = bvec_push(code, 0x29)
                        end
                        code = bvec_push(code, 3)
                        code = bvec_push(code, 0)
                    end
                    if v_r_scalar == 1 do
                        code = w_opnd(code, src2)
                        if v_is_float == 1 do
                            code = bvec_push(code, W_F64_REINTERPRET_I64)
                        end
                    else
                        code = w_opnd(code, src2)
                        if v_dyn_idx == 1 do
                            code = w_local_get(code, args_base)
                            if vi > 0 do
                                code = w_i64_const(code, vi)
                                code = bvec_push(code, 0x7c)
                            end
                            code = w_i64_const(code, 8)
                            code = bvec_push(code, 0x7e)
                            code = w_i64_const(code, 16)
                            code = bvec_push(code, 0x7c)
                        else
                            code = w_i64_const(code, 16 + vi * 8)
                        end
                        code = bvec_push(code, 0x7c)
                        code = bvec_push(code, W_I32_WRAP_I64)
                        if v_is_float == 1 do
                            code = bvec_push(code, 0x2b)
                        else
                            code = bvec_push(code, 0x29)
                        end
                        code = bvec_push(code, 3)
                        code = bvec_push(code, 0)
                    end
                    if v_is_float == 1 do
                        if op == LirOp.VAdd as int do code = bvec_push(code, 0xa0) end
                        if op == LirOp.VSub as int do code = bvec_push(code, 0xa1) end
                        if op == LirOp.VMul as int or op == LirOp.VFma as int do code = bvec_push(code, 0xa2) end
                        code = bvec_push(code, 0x39)
                    else
                        if op == LirOp.VAdd as int do code = bvec_push(code, 0x7c) end
                        if op == LirOp.VSub as int do code = bvec_push(code, 0x7d) end
                        if op == LirOp.VMul as int or op == LirOp.VFma as int do code = bvec_push(code, 0x7e) end
                        code = bvec_push(code, 0x37)
                    end
                    code = bvec_push(code, 3)
                    code = bvec_push(code, 0)
                    vi = vi + 1
                end
            eif op == LirOp.VLoad as int do
                vl_aux = lir_instr_aux(ins)
                var vl_lanes = (vl_aux shr 8) and 255
                if vl_lanes <= 0 do vl_lanes = 4 end
                var vli = 0
                if target_has_wasm_simd128() == 1 do
                    when vli + 2 <= vl_lanes loop
                        code = w_opnd(code, dst)
                        code = w_i64_const(code, 16 + vli * 8)
                        code = bvec_push(code, 0x7c)
                        code = bvec_push(code, W_I32_WRAP_I64)
                        code = w_opnd(code, src1)
                        code = w_i64_const(code, vli * 8)
                        code = bvec_push(code, 0x7c)
                        code = bvec_push(code, W_I32_WRAP_I64)
                        code = bvec_push(code, 0xfd)
                        code = bvec_push(code, 0x00)
                        code = bvec_push(code, 3)
                        code = bvec_push(code, 0)
                        code = bvec_push(code, 0xfd)
                        code = bvec_push(code, 0x0b)
                        code = bvec_push(code, 3)
                        code = bvec_push(code, 0)
                        vli = vli + 2
                    end
                end
                when vli < vl_lanes loop
                    code = w_opnd(code, dst)
                    code = w_i64_const(code, 16 + vli * 8)
                    code = bvec_push(code, 0x7c)
                    code = bvec_push(code, W_I32_WRAP_I64)
                    code = w_opnd(code, src1)
                    code = w_i64_const(code, vli * 8)
                    code = bvec_push(code, 0x7c)
                    code = bvec_push(code, W_I32_WRAP_I64)
                    code = bvec_push(code, 0x29)
                    code = bvec_push(code, 3)
                    code = bvec_push(code, 0)
                    code = bvec_push(code, 0x37)
                    code = bvec_push(code, 3)
                    code = bvec_push(code, 0)
                    vli = vli + 1
                end
            eif op == LirOp.VStore as int do
                vs_aux = lir_instr_aux(ins)
                var vs_lanes = (vs_aux shr 8) and 255
                if vs_lanes <= 0 do vs_lanes = 4 end
                var vsi = 0
                if target_has_wasm_simd128() == 1 do
                    when vsi + 2 <= vs_lanes loop
                        code = w_opnd(code, src1)
                        code = w_i64_const(code, vsi * 8)
                        code = bvec_push(code, 0x7c)
                        code = bvec_push(code, W_I32_WRAP_I64)
                        code = w_opnd(code, src2)
                        code = w_i64_const(code, 16 + vsi * 8)
                        code = bvec_push(code, 0x7c)
                        code = bvec_push(code, W_I32_WRAP_I64)
                        code = bvec_push(code, 0xfd)
                        code = bvec_push(code, 0x00)
                        code = bvec_push(code, 3)
                        code = bvec_push(code, 0)
                        code = bvec_push(code, 0xfd)
                        code = bvec_push(code, 0x0b)
                        code = bvec_push(code, 3)
                        code = bvec_push(code, 0)
                        vsi = vsi + 2
                    end
                end
                when vsi < vs_lanes loop
                    code = w_opnd(code, src1)
                    code = w_i64_const(code, vsi * 8)
                    code = bvec_push(code, 0x7c)
                    code = bvec_push(code, W_I32_WRAP_I64)
                    code = w_opnd(code, src2)
                    code = w_i64_const(code, 16 + vsi * 8)
                    code = bvec_push(code, 0x7c)
                    code = bvec_push(code, W_I32_WRAP_I64)
                    code = bvec_push(code, 0x29)
                    code = bvec_push(code, 3)
                    code = bvec_push(code, 0)
                    code = bvec_push(code, 0x37)
                    code = bvec_push(code, 3)
                    code = bvec_push(code, 0)
                    vsi = vsi + 1
                end
            eif op == LirOp.Intrinsic as int do
                kind = lir_instr_aux(ins)
                if kind == MIR_INTR_ADDR_OF do
                    sid = lir_opnd_imm_val(src1)
                    var addr_unresolved = 0
                    if sid < 0 or sid >= vec_len_rt(strings) do
                        addr_unresolved = 1
                    else
                        cname = vec_get_rt(strings, sid)
                        if cname as int == 0 or fat_cstr_eq(cname, "__unresolved_callee__") == 1 do
                            addr_unresolved = 1
                        end
                    end
                    if addr_unresolved == 1 do
                        print_str("virc: linker error: unresolved function address\n")
                        sys_exit(1)
                    end
                end
                if kind == MIR_INTR_LOAD_ADDR do
                    slot = lir_opnd_imm_val(src1)
                    code = w_i64_const(code, 512 + 8 * slot)
                    code = w_local_set(code, lir_opnd_vreg(dst))
                eif kind == MIR_INTR_ERX do
                    # WASI helpers emitted by this backend are non-throwing;
                    # the function-level error check therefore observes zero.
                    if lir_opnd_type(dst) == LirOperandType.VRegInt as int do
                        code = w_i64_const(code, 0)
                        code = w_local_set(code, lir_opnd_vreg(dst))
                    end
                eif kind == MIR_INTR_STR_LIT do
                    sid = lir_opnd_imm_val(src1); ptr = 0
                    if sid >= 0 and sid < vec_len_rt(offsets) do ptr = vec_get_rt(offsets, sid) end
                    code = w_i64_const(code, ptr); code = w_local_set(code, lir_opnd_vreg(dst))
                eif kind == MIR_INTR_PRINT_STR do
                    print_op = src1
                    if lir_opnd_type(print_op) == LirOperandType.None as int do print_op = src2 end
                    code = w_opnd(code, print_op); code = w_call(code, 1 + n_ffi)
                eif kind == MIR_INTR_PRINT do
                    print_op = src1
                    if lir_opnd_type(print_op) == LirOperandType.None as int do print_op = src2 end
                    code = w_opnd(code, print_op)
                    code = w_call(code, 3 + n_ffi)
                    code = w_call(code, 1 + n_ffi)
                eif (kind and 0xFF) == MIR_INTR_CAST do
                    if lir_instr_typ(ins) == LirType.F64 as int || lir_opnd_type(src1) == LirOperandType.VRegFloat as int do
                        wasm_lir_unsupported(LirOp.Intrinsic as int, kind)
                    end
                    code = w_opnd(code, src1)
                    code = w_local_set(code, lir_opnd_vreg(dst))
                eif kind == MIR_INTR_INDEX do
                    code = w_opnd(code, src1)
                    code = bvec_push(code, W_I32_WRAP_I64)
                    code = w_i32_const(code, 16)
                    code = bvec_push(code, W_I32_ADD)
                    code = w_local_get(code, args_base)
                    code = bvec_push(code, W_I32_WRAP_I64)
                    code = w_i32_const(code, 8)
                    code = bvec_push(code, W_I32_MUL)
                    code = bvec_push(code, W_I32_ADD)
                    code = bvec_push(code, 0x29)
                    code = bvec_push(code, 3)
                    code = bvec_push(code, 0)
                    code = w_local_set(code, lir_opnd_vreg(dst))
                eif kind == MIR_INTR_INDEX_STORE do
                    code = w_opnd(code, src1)
                    code = bvec_push(code, W_I32_WRAP_I64)
                    code = w_i32_const(code, 16)
                    code = bvec_push(code, W_I32_ADD)
                    code = w_local_get(code, args_base)
                    code = bvec_push(code, W_I32_WRAP_I64)
                    code = w_i32_const(code, 8)
                    code = bvec_push(code, W_I32_MUL)
                    code = bvec_push(code, W_I32_ADD)
                    code = w_local_get(code, args_base + 1)
                    code = bvec_push(code, 0x37)
                    code = bvec_push(code, 3)
                    code = bvec_push(code, 0)
                eif kind == MIR_INTR_BUILTIN do
                    bid = lir_opnd_imm_val(src1)
                    if bid == 11 do
                        code = w_local_get(code, args_base); code = w_local_get(code, args_base + 1); code = w_call(code, 2 + n_ffi); code = w_local_set(code, lir_opnd_vreg(dst))
                    eif bid == 19 do
                        code = w_local_get(code, args_base); code = w_call(code, 3 + n_ffi); code = w_local_set(code, lir_opnd_vreg(dst))
                    eif bid == 1000 do
                        code = w_local_get(code, args_base); code = w_call(code, 4 + n_ffi); code = w_local_set(code, lir_opnd_vreg(dst))
                    eif bid == 3 do
                        code = w_local_get(code, args_base)
                        code = bvec_push(code, W_I64_EQZ)
                        code = bvec_push(code, W_IF); code = bvec_push(code, W_VOID)
                        code = bvec_push(code, W_GLOBAL_GET); code = w_u(code, 0)
                        code = bvec_push(code, W_I64_EXTEND_I32_U)
                        code = w_local_set(code, lir_opnd_vreg(dst))
                        code = bvec_push(code, W_ELSE)

                        code = bvec_push(code, W_BLOCK); code = bvec_push(code, W_VOID)

                        # sc = 29 - clz((size - 1) | 7)
                        code = w_i32_const(code, 29)
                        code = w_local_get(code, args_base); code = bvec_push(code, W_I32_WRAP_I64)
                        code = w_i32_const(code, 1); code = bvec_push(code, W_I32_SUB)
                        code = w_i32_const(code, 7); code = bvec_push(code, W_I32_OR)
                        code = bvec_push(code, 0x67) # W_I32_CLZ
                        code = bvec_push(code, W_I32_SUB)
                        code = bvec_push(code, W_I64_EXTEND_I32_U); code = w_local_set(code, args_base + 1)

                        code = w_local_get(code, args_base + 1); code = bvec_push(code, W_I32_WRAP_I64)
                        code = w_i32_const(code, 8); code = bvec_push(code, 0x48) # W_I32_LT_S
                        code = bvec_push(code, W_IF); code = bvec_push(code, W_VOID)

                        code = w_i32_const(code, freelists_base)
                        code = w_local_get(code, args_base + 1); code = bvec_push(code, W_I32_WRAP_I64)
                        code = w_i32_const(code, 4); code = bvec_push(code, W_I32_MUL)
                        code = bvec_push(code, W_I32_ADD)
                        code = bvec_push(code, W_I64_EXTEND_I32_U); code = w_local_set(code, args_base + 2)

                        code = w_local_get(code, args_base + 2); code = bvec_push(code, W_I32_WRAP_I64)
                        code = bvec_push(code, W_I32_LOAD); code = bvec_push(code, 0); code = bvec_push(code, 0)
                        code = bvec_push(code, W_I64_EXTEND_I32_U); code = w_local_set(code, args_base + 3)

                        code = w_local_get(code, args_base + 3); code = bvec_push(code, W_I32_WRAP_I64)
                        code = bvec_push(code, W_I32_EQZ)
                        code = bvec_push(code, 0x45) # W_I32_EQZ (which is just 'not', so head != 0)
                        code = bvec_push(code, W_IF); code = bvec_push(code, W_VOID)

                        # i32.store(addr, i32.load(head))
                        code = w_local_get(code, args_base + 2); code = bvec_push(code, W_I32_WRAP_I64)
                        code = w_local_get(code, args_base + 3); code = bvec_push(code, W_I32_WRAP_I64)
                        code = bvec_push(code, W_I32_LOAD); code = bvec_push(code, 0); code = bvec_push(code, 0)
                        code = bvec_push(code, W_I32_STORE); code = bvec_push(code, 0); code = bvec_push(code, 0)

                        code = w_local_get(code, args_base + 3)
                        code = w_local_set(code, lir_opnd_vreg(dst))
                        code = bvec_push(code, W_BR); code = w_u(code, 2) # break to end of W_BLOCK

                        code = bvec_push(code, W_END)
                        code = bvec_push(code, W_END)

                        # bump alloc fallback
                        code = bvec_push(code, W_GLOBAL_GET); code = w_u(code, 0)
                        code = w_local_get(code, args_base); code = bvec_push(code, W_I32_WRAP_I64)
                        code = w_i32_const(code, 7); code = bvec_push(code, W_I32_ADD)
                        code = w_i32_const(code, 0 - 8); code = bvec_push(code, 0x71)
                        code = w_i32_const(code, 8); code = bvec_push(code, W_I32_ADD)
                        code = bvec_push(code, W_I32_STORE); code = bvec_push(code, 0); code = bvec_push(code, 0)

                        # forward_flag = 0 @ G0 + 4
                        code = bvec_push(code, W_GLOBAL_GET); code = w_u(code, 0)
                        code = w_i32_const(code, 4); code = bvec_push(code, W_I32_ADD)
                        code = w_i32_const(code, 0)
                        code = bvec_push(code, W_I32_STORE); code = bvec_push(code, 0); code = bvec_push(code, 0)

                        code = bvec_push(code, W_GLOBAL_GET); code = w_u(code, 0)
                        code = w_i32_const(code, 8); code = bvec_push(code, W_I32_ADD)
                        code = bvec_push(code, W_I64_EXTEND_I32_U)
                        code = w_local_set(code, lir_opnd_vreg(dst))

                        code = bvec_push(code, W_GLOBAL_GET); code = w_u(code, 0)
                        code = bvec_push(code, W_GLOBAL_GET); code = w_u(code, 0)
                        code = bvec_push(code, W_I32_LOAD); code = bvec_push(code, 0); code = bvec_push(code, 0)
                        code = bvec_push(code, W_I32_ADD)
                        code = bvec_push(code, W_GLOBAL_SET); code = w_u(code, 0)

                        code = bvec_push(code, W_END) # W_BLOCK
                        code = bvec_push(code, W_END) # W_ELSE
                    eif bid == 4 do
                        # free: no-op
                        code = w_local_get(code, args_base); code = bvec_push(code, W_I32_WRAP_I64)
                        code = bvec_push(code, W_IF); code = bvec_push(code, W_VOID)

                        code = w_local_get(code, args_base); code = bvec_push(code, W_I32_WRAP_I64)
                        code = w_i32_const(code, 8); code = bvec_push(code, W_I32_SUB)
                        code = bvec_push(code, W_I64_EXTEND_I32_U); code = w_local_set(code, args_base + 1) # hdr_addr

                        code = w_local_get(code, args_base + 1); code = bvec_push(code, W_I32_WRAP_I64)
                        code = bvec_push(code, W_I32_LOAD); code = bvec_push(code, 0); code = bvec_push(code, 0)
                        code = bvec_push(code, W_I64_EXTEND_I32_U); code = w_local_set(code, args_base + 2) # blk_size

                        code = w_local_get(code, args_base + 1); code = bvec_push(code, W_I32_WRAP_I64)
                        code = w_local_get(code, args_base + 2); code = bvec_push(code, W_I32_WRAP_I64)
                        code = bvec_push(code, W_I32_ADD)
                        code = bvec_push(code, W_GLOBAL_GET); code = w_u(code, 0)
                        code = bvec_push(code, W_I32_EQ)
                        code = bvec_push(code, W_IF); code = bvec_push(code, W_VOID)

                        code = w_local_get(code, args_base + 1); code = bvec_push(code, W_I32_WRAP_I64)
                        code = bvec_push(code, W_GLOBAL_SET); code = w_u(code, 0)

                        code = bvec_push(code, W_ELSE)

                        # user_size = blk_size - 8
                        code = w_local_get(code, args_base + 2); code = bvec_push(code, W_I32_WRAP_I64)
                        code = w_i32_const(code, 8); code = bvec_push(code, W_I32_SUB)

                        # sc = 29 - clz((user_size - 1) | 7)
                        code = w_i32_const(code, 1); code = bvec_push(code, W_I32_SUB)
                        code = w_i32_const(code, 7); code = bvec_push(code, W_I32_OR)
                        code = bvec_push(code, 0x67) # W_I32_CLZ
                        code = bvec_push(code, W_I64_EXTEND_I32_U); code = w_local_set(code, args_base + 3)
                        code = w_i32_const(code, 29)
                        code = w_local_get(code, args_base + 3); code = bvec_push(code, W_I32_WRAP_I64)
                        code = bvec_push(code, W_I32_SUB)
                        code = bvec_push(code, W_I64_EXTEND_I32_U); code = w_local_set(code, args_base + 3) # sc

                        # if sc < 8
                        code = w_local_get(code, args_base + 3); code = bvec_push(code, W_I32_WRAP_I64)
                        code = w_i32_const(code, 8); code = bvec_push(code, 0x48) # W_I32_LT_S
                        code = bvec_push(code, W_IF); code = bvec_push(code, W_VOID)

                        # addr = freelists_base + sc * 4
                        code = w_i32_const(code, freelists_base)
                        code = w_local_get(code, args_base + 3); code = bvec_push(code, W_I32_WRAP_I64)
                        code = w_i32_const(code, 4); code = bvec_push(code, W_I32_MUL)
                        code = bvec_push(code, W_I32_ADD)
                        code = bvec_push(code, W_I64_EXTEND_I32_U); code = w_local_set(code, args_base + 4) # addr

                        # i32.store(ptr, i32.load(addr))
                        code = w_local_get(code, args_base); code = bvec_push(code, W_I32_WRAP_I64)
                        code = w_local_get(code, args_base + 4); code = bvec_push(code, W_I32_WRAP_I64)
                        code = bvec_push(code, W_I32_LOAD); code = bvec_push(code, 0); code = bvec_push(code, 0)
                        code = bvec_push(code, W_I32_STORE); code = bvec_push(code, 0); code = bvec_push(code, 0)

                        # i32.store(addr, ptr)
                        code = w_local_get(code, args_base + 4); code = bvec_push(code, W_I32_WRAP_I64)
                        code = w_local_get(code, args_base); code = bvec_push(code, W_I32_WRAP_I64)
                        code = bvec_push(code, W_I32_STORE); code = bvec_push(code, 0); code = bvec_push(code, 0)

                        code = bvec_push(code, W_END) # sc < 8 IF
                        code = bvec_push(code, W_END) # LIFO IF
                        code = bvec_push(code, W_END) # ptr != 0 IF
                    eif bid == 5 do
                        code = w_local_get(code, args_base); code = bvec_push(code, W_I32_WRAP_I64)
                        code = w_local_get(code, args_base + 1); code = bvec_push(code, W_I32_WRAP_I64)
                        code = bvec_push(code, W_I32_ADD)
                        code = bvec_push(code, W_I32_LOAD8_U); code = bvec_push(code, 0); code = bvec_push(code, 0)
                        code = bvec_push(code, W_I64_EXTEND_I32_U)
                        code = w_local_set(code, lir_opnd_vreg(dst))
                    eif bid == 6 do
                        code = w_local_get(code, args_base); code = bvec_push(code, W_I32_WRAP_I64)
                        code = w_local_get(code, args_base + 1); code = bvec_push(code, W_I32_WRAP_I64)
                        code = bvec_push(code, W_I32_ADD)
                        code = w_local_get(code, args_base + 2); code = bvec_push(code, W_I32_WRAP_I64)
                        code = bvec_push(code, W_I32_STORE8); code = bvec_push(code, 0); code = bvec_push(code, 0)
                    eif bid == 7 do
                        code = w_local_get(code, args_base); code = bvec_push(code, W_I32_WRAP_I64)
                        code = w_local_get(code, args_base + 1); code = bvec_push(code, W_I32_WRAP_I64)
                        code = bvec_push(code, W_I32_ADD)
                        code = bvec_push(code, 0x29); code = bvec_push(code, 3); code = bvec_push(code, 0)
                        code = w_local_set(code, lir_opnd_vreg(dst))
                    eif bid == 8 do
                        code = w_local_get(code, args_base); code = bvec_push(code, W_I32_WRAP_I64)
                        code = w_local_get(code, args_base + 1); code = bvec_push(code, W_I32_WRAP_I64)
                        code = bvec_push(code, W_I32_ADD)
                        code = w_local_get(code, args_base + 2)
                        code = bvec_push(code, 0x37); code = bvec_push(code, 3); code = bvec_push(code, 0)
                    eif bid == 31 do
                        if lir_opnd_type(dst) == (LirOperandType.VRegInt as int) do
                            code = w_local_get(code, args_base)
                            code = w_local_set(code, lir_opnd_vreg(dst))
                        end
                        code = bvec_push(code, W_BLOCK); code = bvec_push(code, W_VOID)
                        code = bvec_push(code, W_LOOP); code = bvec_push(code, W_VOID)
                        code = w_local_get(code, args_base + 2)
                        code = bvec_push(code, W_I64_EQZ)
                        code = bvec_push(code, W_BR_IF); code = w_u(code, 1)
                        code = w_local_get(code, args_base); code = bvec_push(code, W_I32_WRAP_I64)
                        code = w_local_get(code, args_base + 1); code = bvec_push(code, W_I32_WRAP_I64)
                        code = bvec_push(code, W_I32_LOAD8_U); code = bvec_push(code, 0); code = bvec_push(code, 0)
                        code = bvec_push(code, W_I32_STORE8); code = bvec_push(code, 0); code = bvec_push(code, 0)
                        code = w_local_get(code, args_base); code = w_i64_const(code, 1); code = bvec_push(code, 0x7c); code = w_local_set(code, args_base)
                        code = w_local_get(code, args_base + 1); code = w_i64_const(code, 1); code = bvec_push(code, 0x7c); code = w_local_set(code, args_base + 1)
                        code = w_local_get(code, args_base + 2); code = w_i64_const(code, 1); code = bvec_push(code, 0x7d); code = w_local_set(code, args_base + 2)
                        code = bvec_push(code, W_BR); code = w_u(code, 0)
                        code = bvec_push(code, W_END); code = bvec_push(code, W_END)
                    eif bid == 32 do
                        if lir_opnd_type(dst) == (LirOperandType.VRegInt as int) do
                            code = w_local_get(code, args_base)
                            code = w_local_set(code, lir_opnd_vreg(dst))
                        end
                        code = bvec_push(code, W_BLOCK); code = bvec_push(code, W_VOID)
                        code = bvec_push(code, W_LOOP); code = bvec_push(code, W_VOID)
                        code = w_local_get(code, args_base + 2)
                        code = bvec_push(code, W_I64_EQZ)
                        code = bvec_push(code, W_BR_IF); code = w_u(code, 1)
                        code = w_local_get(code, args_base); code = bvec_push(code, W_I32_WRAP_I64)
                        code = w_local_get(code, args_base + 1); code = bvec_push(code, W_I32_WRAP_I64)
                        code = bvec_push(code, W_I32_STORE8); code = bvec_push(code, 0); code = bvec_push(code, 0)
                        code = w_local_get(code, args_base); code = w_i64_const(code, 1); code = bvec_push(code, 0x7c); code = w_local_set(code, args_base)
                        code = w_local_get(code, args_base + 2); code = w_i64_const(code, 1); code = bvec_push(code, 0x7d); code = w_local_set(code, args_base + 2)
                        code = bvec_push(code, W_BR); code = w_u(code, 0)
                        code = bvec_push(code, W_END); code = bvec_push(code, W_END)
                    eif bid == 22 do
                        code = w_local_get(code, args_base)
                        code = w_call(code, 1 + n_ffi)
                    eif bid == 18 do
                        code = bvec_push(code, 0x00)
                    end
                eif kind == MIR_INTR_PERCENT do
                    code = w_opnd(code, src1)
                    if lir_instr_typ(ins) == LirType.F64 as int do
                        code = bvec_push(code, W_F64_REINTERPRET_I64)
                    else
                        code = bvec_push(code, W_F64_CONVERT_I64_S)
                    end
                    code = w_f64_const_100(code)
                    code = bvec_push(code, W_F64_DIV)
                    code = bvec_push(code, W_I64_REINTERPRET_F64)
                    code = w_local_set(code, lir_opnd_vreg(dst))
                eif kind == MIR_MEM_MARK do
                    if lir_opnd_type(dst) == (LirOperandType.VRegInt as int) do
                        code = bvec_push(code, W_GLOBAL_GET); code = w_u(code, 0)
                        code = bvec_push(code, W_I64_EXTEND_I32_U)
                        code = w_local_set(code, lir_opnd_vreg(dst))
                    end
                eif kind == MIR_MEM_RESET do
                    if lir_opnd_type(src1) == (LirOperandType.VRegInt as int) do
                        code = w_local_get(code, lir_opnd_vreg(src1))
                        code = bvec_push(code, W_I32_WRAP_I64)
                        code = bvec_push(code, W_GLOBAL_SET); code = w_u(code, 0)
                    end
                eif kind == MIR_MEM_DROP do
                    if lir_opnd_type(src1) == (LirOperandType.VRegInt as int) do
                        code = w_local_get(code, lir_opnd_vreg(src1)); code = bvec_push(code, W_I32_WRAP_I64)
                        code = bvec_push(code, W_IF); code = bvec_push(code, W_VOID)
                        code = w_local_get(code, lir_opnd_vreg(src1)); code = bvec_push(code, W_I32_WRAP_I64)
                        code = w_i32_const(code, 8); code = bvec_push(code, W_I32_SUB)
                        code = w_local_get(code, lir_opnd_vreg(src1)); code = bvec_push(code, W_I32_WRAP_I64)
                        code = w_i32_const(code, 8); code = bvec_push(code, W_I32_SUB)
                        code = bvec_push(code, W_I32_LOAD); code = bvec_push(code, 0); code = bvec_push(code, 0)
                        code = bvec_push(code, W_I32_ADD)
                        code = bvec_push(code, W_GLOBAL_GET); code = w_u(code, 0)
                        code = bvec_push(code, W_I32_EQ)
                        code = bvec_push(code, W_IF); code = bvec_push(code, W_VOID)
                        code = w_local_get(code, lir_opnd_vreg(src1)); code = bvec_push(code, W_I32_WRAP_I64)
                        code = w_i32_const(code, 8); code = bvec_push(code, W_I32_SUB)
                        code = bvec_push(code, W_GLOBAL_SET); code = w_u(code, 0)
                        code = bvec_push(code, W_END)
                        code = bvec_push(code, W_END)
                    end
                eif kind == MIR_MEM_PROMOTE do
                    if lir_opnd_type(src1) == (LirOperandType.VRegInt as int) do
                        let s1_vreg = lir_opnd_vreg(src1)
                        code = w_local_get(code, s1_vreg); code = bvec_push(code, W_I32_WRAP_I64)
                        code = w_call(code, 5 + n_ffi)
                        code = bvec_push(code, W_I64_EXTEND_I32_U)
                        code = w_local_set(code, s1_vreg)
                        if lir_opnd_type(dst) == (LirOperandType.VRegInt as int) do
                            code = w_local_get(code, s1_vreg)
                            code = w_local_set(code, lir_opnd_vreg(dst))
                        end
                    end
                end
            end
            if op == LirOp.Ret as int do code_done = 1 end
            ii = ii + 1
        end
        bi = bi + 1
    end
    # Header
    outb = bvec_new(); outb = bvec_push(outb, 0); outb = bvec_push(outb, 97); outb = bvec_push(outb, 115); outb = bvec_push(outb, 109); outb = bvec_push(outb, 1); outb = bvec_push(outb, 0); outb = bvec_push(outb, 0); outb = bvec_push(outb, 0)
    # types: fd_write, print, strcat, itoa, _start, wasi_fn, promote_graph
    t = bvec_new(); t = w_u(t, 7)
    t = bvec_push(t, 0x60); t = w_u(t, 4); t = bvec_push(t,W_I32); t=bvec_push(t,W_I32); t=bvec_push(t,W_I32); t=bvec_push(t,W_I32); t=w_u(t,1); t=bvec_push(t,W_I32)
    t = bvec_push(t,0x60); t=w_u(t,1); t=bvec_push(t,W_I64); t=w_u(t,0)
    t = bvec_push(t,0x60); t=w_u(t,2); t=bvec_push(t,W_I64); t=bvec_push(t,W_I64); t=w_u(t,1); t=bvec_push(t,W_I64)
    t = bvec_push(t,0x60); t=w_u(t,1); t=bvec_push(t,W_I64); t=w_u(t,1); t=bvec_push(t,W_I64)
    t = bvec_push(t,0x60); t=w_u(t,0); t=w_u(t,0)
    t = bvec_push(t,0x60); t=w_u(t,0); t=w_u(t,1); t=bvec_push(t,W_I32)
    # type 6: w_promote_graph (i32) -> i32
    t = bvec_push(t,0x60); t=w_u(t,1); t=bvec_push(t,W_I32); t=w_u(t,1); t=bvec_push(t,W_I32); outb=w_section(outb,1,t)
    im = bvec_new(); im = w_u(im, 1 + n_ffi)
    im = w_name(im, fat_str_new("wasi_snapshot_preview1")); im = w_name(im, fat_str_new("fd_write")); im = bvec_push(im, 0); im = w_u(im, 0)
    var ffi_w = 0
    when ffi_w < n_ffi loop
        let u_id = ffi_import_used_at(ffi_w)
        var s_mod = ffi_import_source(u_id)
        if s_mod as int == 0 or ffi_source_is_os(s_mod as int) == 1 do
            s_mod = fat_str_new("wasi_snapshot_preview1")
        end
        var s_fun = ffi_import_name(u_id)
        if s_fun as int == 0 do
            s_fun = fat_str_new("unnamed")
        end
        im = w_name(im, s_mod)
        im = w_name(im, s_fun)
        im = bvec_push(im, 0)
        im = w_u(im, 5)
        ffi_w = ffi_w + 1
    end
    outb = w_section(outb, 2, im)
    # function section: print(1), strcat(2), itoa(3), bool(3), promote_graph(6), _start(4)
    fs = bvec_new(); fs = w_u(fs, 6); fs = w_u(fs, 1); fs = w_u(fs, 2); fs = w_u(fs, 3); fs = w_u(fs, 3); fs = w_u(fs, 6); fs = w_u(fs, 4); outb = w_section(outb, 3, fs)
    mem = bvec_new(); mem = w_u(mem, 1); mem = bvec_push(mem, 0); mem = w_u(mem, 32); outb = w_section(outb, 5, mem)
    gl = bvec_new(); gl = w_u(gl, 2)
    gl = bvec_push(gl, W_I32); gl = bvec_push(gl, 1); gl = w_i32_const(gl, 1048576); gl = bvec_push(gl, W_END)
    gl = bvec_push(gl, W_I32); gl = bvec_push(gl, 1); gl = w_i32_const(gl, heap); gl = bvec_push(gl, W_END)
    outb = w_section(outb, 6, gl)
    # _start is now at index 6 + n_ffi (shifted by new promote_graph function)
    ex = bvec_new(); ex = w_u(ex, 2); ex = w_name(ex, fat_str_new("_start")); ex = bvec_push(ex, 0); ex = w_u(ex, 6 + n_ffi); ex = w_name(ex, fat_str_new("memory")); ex = bvec_push(ex, 2); ex = w_u(ex, 0); outb = w_section(outb, 7, ex)
    local_count = maxr + 1
    if local_count < args_base + 2 do local_count = args_base + 2 end
    if local_count < args_base + 16 do local_count = args_base + 16 end
    # pg_fn_idx = absolute index of w_promote_graph_code = 5 + n_ffi (after 1 imported + n_ffi + 4 builtins)
    let pg_fn_idx = 5 + n_ffi
    cs=bvec_new(); cs=w_u(cs,6); cs=w_bytes(cs,w_func_body(w_print_code(),2,W_I32)); cs=w_bytes(cs,w_func_body(w_strcat_code(),6,W_I32)); cs=w_bytes(cs,w_itoa_body(w_itoa_code())); cs=w_bytes(cs,w_func_body(w_bool_code(),0,W_I64)); cs=w_bytes(cs,w_func_body(w_promote_graph_code(pg_fn_idx),8,W_I32)); cs=w_bytes(cs,w_func_body(code,local_count,W_I64)); outb=w_section(outb,10,cs)
    ds=bvec_new(); ds=w_u(ds,1); ds=bvec_push(ds,0); ds=w_i32_const(ds,1024); ds=bvec_push(ds,W_END); ds=w_u(ds,bvec_len(data)); ds=w_bytes(ds,data); outb=w_section(outb,11,ds)
    out write_file_bytes(path, bvec_data_ptr(outb), bvec_len(outb), 0o644)
end.

export wasm_lir_write_module
