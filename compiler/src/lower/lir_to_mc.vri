##
 * vir/compiler/lir_to_mc.vri — LIR to Machine Instruction Stream Orchestrator
 * ============================================================================
 * VIRC-PLN-0004 Phase 10 / VIRC-ISS-0006 / VIRC-ISS-0009: Target Lowering Split.
 ##

include types
include vec_rt
include string_rt
include lir
include mc

include lir_to_mc_common
include lir_to_mc_arm64
include lir_to_mc_x86_64
include lir_to_mc_riscv64

func lir_func_to_mc(func_obj: &LirFunc, assigned_phys: i64, arch: int):
    if arch == TargetArch.X86_64 or arch == 1 do
        out lir_func_to_mc_x86_64(func_obj, assigned_phys)
    eif arch == TargetArch.RISCV64 or arch == 3 do
        out lir_func_to_mc_riscv64(func_obj, assigned_phys)
    end
    out lir_func_to_mc_arm64(func_obj, assigned_phys)
end.

export lir_func_to_mc_arm64, lir_func_to_mc_x86_64, lir_func_to_mc_riscv64, lir_func_to_mc, lir_mc_string_symbol
