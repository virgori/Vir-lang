##
 * compiler/src/lower/lir_codegen/intrinsics.vri — LIR ARM64 Intrinsic Emitters
 * ============================================================================
 ##

include types
include vec_rt
include string_rt
include codegen
include target
include lir_codegen_types

func emit_lir_intrinsic(cb: &CodeBuf, ins: LirInstr, rd: i64, rs1: i64, assigned_phys: i64, call_fixups: i64, func_obj: &LirFunc, str_fixups: i64, recent_setargs: i64, lir_funcs: i64, is_linux: i64):
    kind = native_read_i64(ins as i64, 40)
    ins_dst = native_read_i64(ins as i64, 16) as LirOperand
    ins_src1 = native_read_i64(ins as i64, 24) as LirOperand
    ins_src2 = native_read_i64(ins as i64, 32) as LirOperand
    ins_typ = native_read_i64(ins as i64, 8)
    SCR = 9
    if kind == MIR_INTR_LOAD_ADDR do
        slot = native_read_i64(ins_src1 as i64, 32)
        distance = 88 + 8 * slot
        if rd >= 0 do
            out emit_fp_sub_addr(cb, rd, distance)
        else
            cb = emit_fp_sub_addr(cb, SCR, distance)
            out emit_spill_store(cb, ins_dst as i64, SCR)
        end
    end
    if kind == MIR_INTR_GLOBAL_LOAD do
        slot = native_read_i64(ins_src1 as i64, 32)
        if rd >= 0 and slot >= 0 and slot < 4092 do
            out arm64_ldr_uoff(cb, rd as int, 28, (32 + slot * 8) as int)
        end
        if rd < 0 and slot >= 0 and slot < 4092 do
            cb = arm64_ldr_uoff(cb, SCR as int, 28, (32 + slot * 8) as int)
            out emit_spill_store(cb, ins_dst as i64, SCR)
        end
        out arm64_nop(cb)
    end
    if kind == MIR_INTR_GLOBAL_STORE do
        slot = native_read_i64(ins_dst as i64, 32)
        if slot >= 0 and slot < 4092 do
            var (cb_global, global_reg) = lir_load_opnd_to_reg(cb, ins_src1 as i64, assigned_phys, SCR)
            out arm64_str_uoff(cb_global, global_reg as int, 28, (32 + slot * 8) as int)
        end
        out arm64_nop(cb)
    end
    if (kind and 0xFF) == MIR_INTR_BIT_EXTRACT do
        lsb = (kind shr 8) and 0x3F
        width = (kind shr 16) and 0x7F
        var (cb_ext, r_base) = lir_load_opnd_to_reg(cb, ins_src1 as i64, assigned_phys, SCR)
        if rd >= 0 do
            out arm64_ubfx(cb_ext, rd as int, r_base as int, lsb as int, width as int)
        else
            cb_ext = arm64_ubfx(cb_ext, SCR as int, r_base as int, lsb as int, width as int)
            out emit_spill_store(cb_ext, ins_dst as i64, SCR)
        end
    end
    if (kind and 0xFF) == MIR_INTR_BIT_INSERT do
        lsb = (kind shr 8) and 0x3F
        width = (kind shr 16) and 0x7F
        s0 = vec_get_rt(recent_setargs, 0)
        var (cb_val, r_val) = lir_load_opnd_to_reg(cb, s0, assigned_phys, SCR)
        var target_rd = rd
        if target_rd < 0 do target_rd = 10 end
        var (cb_base, r_base) = lir_load_opnd_to_reg(cb_val, ins_src1 as i64, assigned_phys, target_rd)
        if r_base != target_rd do
            cb_base = arm64_mov_rr(cb_base, target_rd as int, r_base as int)
        end
        cb_base = arm64_bfi(cb_base, target_rd as int, r_val as int, lsb as int, width as int)
        if rd < 0 do
            cb_base = emit_spill_store(cb_base, ins_dst as i64, target_rd)
        end
        out cb_base
    end
    if kind == MIR_INTR_TRAIN do
        cb = arm64_movz_imm64(cb, SCR, 1)
        cb = arm64_str_uoff(cb, SCR as int, 28, 8)
        cb = arm64_movz_imm64(cb, SCR, 0)
        cb = arm64_str_uoff(cb, SCR as int, 28, 16)
        cb = arm64_str_uoff(cb, SCR as int, 28, 24)
        out cb
    end
    if kind == MIR_INTR_INFER do
        cb = arm64_movz_imm64(cb, SCR, 0)
        cb = arm64_str_uoff(cb, SCR as int, 28, 8)
        out cb
    end
    if kind == MIR_INTR_QUANTIZE do
        s0 = vec_get_rt(recent_setargs, 0)
        var (cb1, r_bits) = lir_load_opnd_to_reg(cb, s0, assigned_phys, 1)
        var (cb2, r_tensor) = lir_load_opnd_to_reg(cb1, ins_src1 as i64, assigned_phys, 0)
        if r_tensor != 0 do cb2 = arm64_mov_rr(cb2, 0, r_tensor as int) end
        if r_bits != 1 do cb2 = arm64_mov_rr(cb2, 1, r_bits as int) end
        cb2 = emit_bl_fixup(cb2, call_fixups, 1, LIR_RT_QUANTIZE, rd)
        if rd < 0 and (ins_dst as i64) != 0 do
            cb2 = emit_spill_store(cb2, ins_dst as i64, 0)
        end
        out cb2
    end
    if kind == MIR_INTR_BACKWARD do
        cb = emit_bl_fixup(cb, call_fixups, 1, LIR_RT_BACKWARD, rd)
        out cb
    end
    if kind == MIR_INTR_PERCENT do
        var (cb1, r_val) = lir_load_opnd_to_reg(cb, ins_src1 as i64, assigned_phys, SCR)
        if ins_typ == (LirType.F64 as i64) do
            cb1 = arm64_fmov_dx(cb1, 0, r_val as int)
        else
            cb1 = arm64_scvtf_dx(cb1, 0, r_val as int)
        end
        cb1 = arm64_movz_imm64(cb1, 10, 4636737291354636288)
        cb1 = arm64_fmov_dx(cb1, 1, 10)
        cb1 = arm64_fdiv_ddd(cb1, 0, 0, 1)
        var target_rd = rd
        if target_rd < 0 do target_rd = SCR end
        cb1 = arm64_fmov_xd(cb1, target_rd as int, 0)
        if rd < 0 and (ins_dst as i64) != 0 do
            cb1 = emit_spill_store(cb1, ins_dst as i64, target_rd)
        end
        out cb1
    end
    if (kind and 0xFF) == MIR_INTR_CAST do
        cast_src_cat = (kind shr 8) and 0xFF
        cast_dst_cat = (kind shr 16) and 0xFF
        var (cb_cast, cast_src_reg) = lir_load_opnd_to_reg(cb, ins_src1 as i64, assigned_phys, SCR)
        var cast_dst_reg = rd
        if cast_dst_reg < 0 do cast_dst_reg = 10 end
        if cast_src_cat == 1 and cast_dst_cat == 2 do
            cb_cast = arm64_scvtf_dx(cb_cast, 0, cast_src_reg as int)
            cb_cast = arm64_fmov_xd(cb_cast, cast_dst_reg as int, 0)
        eif cast_src_cat == 2 and cast_dst_cat == 1 do
            cb_cast = arm64_fmov_dx(cb_cast, 0, cast_src_reg as int)
            # FCVTZS alone saturates infinities/out-of-range values on ARM64.
            # Guard the half-open signed range [min, max+1) first; VS catches
            # unordered comparisons (NaN).  A failed conversion uses the same
            # native trap path as other checked runtime operations.
            var cast_bits = (kind shr 24) and 0xFF
            if cast_bits == 0 do cast_bits = 64 end
            var cast_lower = -4332462841530417152
            var cast_upper = 4890909195324358656
            if cast_bits == 8 do cast_lower = -4584629236291076096; cast_upper = 4638707616191610880 end
            if cast_bits == 16 do cast_lower = -4548635486205247488; cast_upper = 4674736413210574848 end
            if cast_bits == 32 do cast_lower = -4476578029604175872; cast_upper = 4746794007248502784 end
            cb_cast = arm64_movz_imm64(cb_cast, 11, cast_lower)
            cb_cast = arm64_fmov_dx(cb_cast, 1, 11)
            cb_cast = arm64_fcmp_dd(cb_cast, 0, 1)
            var cast_low_fix = codebuf_offset(cb_cast)
            if cast_bits == 64 do
                cb_cast = arm64_blt_imm19(cb_cast, 0)
            else
                cb_cast = arm64_ble_imm19(cb_cast, 0)
            end
            var cast_nan_fix1 = codebuf_offset(cb_cast)
            cb_cast = arm64_bvs_imm19(cb_cast, 0)
            cb_cast = arm64_movz_imm64(cb_cast, 11, cast_upper)
            cb_cast = arm64_fmov_dx(cb_cast, 1, 11)
            cb_cast = arm64_fcmp_dd(cb_cast, 0, 1)
            var cast_high_fix = codebuf_offset(cb_cast)
            cb_cast = arm64_bge_imm19(cb_cast, 0)
            var cast_nan_fix2 = codebuf_offset(cb_cast)
            cb_cast = arm64_bvs_imm19(cb_cast, 0)
            cb_cast = arm64_fcvtzs_xd(cb_cast, cast_dst_reg as int, 0)
            var cast_done_fix = codebuf_offset(cb_cast)
            cb_cast = arm64_b_imm26(cb_cast, 0)
            var cast_trap_at = codebuf_offset(cb_cast)
            cb_cast = arm64_brk(cb_cast, 2)
            var cast_done_at = codebuf_offset(cb_cast)
            var cast_low_imm = ((cast_trap_at - cast_low_fix) shr 2) and 0x7FFFF
            var cast_nan_imm1 = ((cast_trap_at - cast_nan_fix1) shr 2) and 0x7FFFF
            var cast_high_imm = ((cast_trap_at - cast_high_fix) shr 2) and 0x7FFFF
            var cast_nan_imm2 = ((cast_trap_at - cast_nan_fix2) shr 2) and 0x7FFFF
            var cast_done_imm = ((cast_done_at - cast_done_fix) shr 2) and 0x03FFFFFF
            var low_cond = 0x5400000D
            if cast_bits == 64 do low_cond = 0x5400000B end
            cb_cast = codebuf_patch_u32(cb_cast, cast_low_fix, (low_cond or (cast_low_imm shl 5)) as int)
            cb_cast = codebuf_patch_u32(cb_cast, cast_nan_fix1, (0x54000006 or (cast_nan_imm1 shl 5)) as int)
            cb_cast = codebuf_patch_u32(cb_cast, cast_high_fix, (0x5400000A or (cast_high_imm shl 5)) as int)
            cb_cast = codebuf_patch_u32(cb_cast, cast_nan_fix2, (0x54000006 or (cast_nan_imm2 shl 5)) as int)
            cb_cast = codebuf_patch_u32(cb_cast, cast_done_fix, (0x14000000 or cast_done_imm) as int)
        eif cast_dst_reg != cast_src_reg do
            cb_cast = arm64_mov_rr(cb_cast, cast_dst_reg as int, cast_src_reg as int)
        end
        if rd < 0 and (ins_dst as i64) != 0 do
            cb_cast = emit_spill_store(cb_cast, ins_dst as i64, cast_dst_reg)
        end
        out cb_cast
    end
    if kind == MIR_INTR_ERX do
        if rd >= 0 do out arm64_mov_rr(cb, rd as int, 19) end
        if lir_opnd_spill_off(ins_dst as i64) != 0 do
            out emit_spill_store(cb, ins_dst as i64, 19)
        end
        var erx_src = ins_src1
        if (erx_src as i64) != 0 and native_read_i64(erx_src as i64, 0) != 0 do
            var (cb_erx, erx_reg) = lir_load_opnd_to_reg(cb, erx_src, assigned_phys, 9)
            cb = cb_erx
            if erx_reg != 19 do cb = arm64_mov_rr(cb, 19, erx_reg as int) end
            out cb
        end
        out arm64_movz_imm64(cb, 19, 0)
    end
    if kind == MIR_INTR_THROW do
        var thrown_src = ins_src1
        if (thrown_src as i64) != 0 and native_read_i64(thrown_src as i64, 0) != 0 do
            var (cb_throw, throw_reg) = lir_load_opnd_to_reg(cb, thrown_src, assigned_phys, 9)
            cb = cb_throw
            if throw_reg != 19 do cb = arm64_mov_rr(cb, 19, throw_reg as int) end
        else
            cb = arm64_movz_imm64(cb, 19, 1)
        end
        out arm64_brk(cb, 1)
    end
    if lir_intr_is_marker(kind) == 1 do
        out arm64_nop(cb)
    end
    if kind == MIR_INTR_PARAM do
        abi = native_read_i64(ins_src1 as i64, 32)
        if abi >= 0 and abi < 8 do
            if rd >= 0 do
                if rd != abi do
                    cb = arm64_mov_rr(cb, rd as int, abi as int)
                end
            else
                if (ins_dst as i64) != 0 do
                    cb = emit_spill_store(cb, ins_dst as i64, abi)
                end
            end
            out cb
        end
        if abi >= 8 do
            # AAPCS64: caller stack arguments start at FP + 16
            off = 16 + ((abi - 8) * 8)
            if rd >= 0 do
                cb = arm64_ldr_uoff(cb, rd as int, 29, off as int)
            else
                if (ins_dst as i64) != 0 do
                    cb = arm64_ldr_uoff(cb, SCR as int, 29, off as int)
                    cb = emit_spill_store(cb, ins_dst as i64, SCR)
                end
            end
            out cb
        end
        out arm64_nop(cb)
    end
    if kind == MIR_INTR_BUILTIN do
        bid = native_read_i64(ins_src1 as i64, 32)
        # ── Inline read_byte(ptr, idx) / str_get(str, idx) → LDRB Wrd, [X_ptr, X_idx] ──
        if bid == 5 or bid == 10 do
            if rd >= 0 do
                s0 = vec_get_rt(recent_setargs, 0)
                s1 = vec_get_rt(recent_setargs, 1)
                cb1 = lir_materialize_opnd_to_reg(cb, s0, assigned_phys, 9)
                cb2 = lir_materialize_opnd_to_reg(cb1, s1, assigned_phys, 10)
                cb = arm64_ldrb_reg(cb2, rd as int, 9, 10)
            end
            out cb
        end
        # ── Inline write_byte(ptr, idx, val) → STRB W_val, [X_ptr, X_idx] ──
        if bid == 6 do
            s0 = vec_get_rt(recent_setargs, 0)
            s1 = vec_get_rt(recent_setargs, 1)
            s2 = vec_get_rt(recent_setargs, 2)
            cb1 = lir_materialize_opnd_to_reg(cb, s0, assigned_phys, 9)
            cb2 = lir_materialize_opnd_to_reg(cb1, s1, assigned_phys, 10)
            cb3 = lir_materialize_opnd_to_reg(cb2, s2, assigned_phys, 11)
            cb = arm64_strb_reg(cb3, 11, 9, 10)
            out cb
        end
        # ── Inline read_word(ptr, idx) → LDR Xrd, [X_ptr, X_idx] ──
        if bid == 7 or bid == 46 do
            if rd >= 0 do
                s0 = vec_get_rt(recent_setargs, 0)
                s1 = vec_get_rt(recent_setargs, 1)
                cb1 = lir_materialize_opnd_to_reg(cb, s0, assigned_phys, 9)
                cb2 = lir_materialize_opnd_to_reg(cb1, s1, assigned_phys, 10)
                cb = arm64_ldr_reg(cb2, rd as int, 9, 10)
            end
            out cb
        end
        # ── Inline write_word(ptr, idx, val) → STR X_val, [X_ptr, X_idx] ──
        if bid == 8 or bid == 47 do
            s0 = vec_get_rt(recent_setargs, 0)
            s1 = vec_get_rt(recent_setargs, 1)
            s2 = vec_get_rt(recent_setargs, 2)
            cb1 = lir_materialize_opnd_to_reg(cb, s0, assigned_phys, 9)
            cb2 = lir_materialize_opnd_to_reg(cb1, s1, assigned_phys, 10)
            cb3 = lir_materialize_opnd_to_reg(cb2, s2, assigned_phys, 11)
            cb = arm64_str_reg(cb3, 11, 9, 10)
            out cb
        end
        # ── Inline memcpy(dst, src, len) (bid == 31) → Hardware 16-Byte NEON + 8B/1B Tail ──
        if bid == 31 do
            s0 = vec_get_rt(recent_setargs, 0)
            s1 = vec_get_rt(recent_setargs, 1)
            s2 = vec_get_rt(recent_setargs, 2)
            if s0 != 0 do
                typ0 = native_read_i64(s0 as i64, 0)
                if typ0 == 5 do
                    cb = arm64_movz_imm64(cb, 9, native_read_i64(s0 as i64, 32) as int)
                eif typ0 == 4 do
                    off0 = native_read_i64(s0 as i64, 24)
                    cb = emit_fp_sub_addr(cb, 9, 0 - off0)
                    cb = arm64_ldr_uoff(cb, 9, 9, 0)
                else
                    r_s0 = resolve_reg(s0 as LirOperand, assigned_phys)
                    if r_s0 >= 0 and r_s0 != 9 do
                        cb = arm64_mov_rr(cb, 9, r_s0 as int)
                    end
                end
            end
            if s1 != 0 do
                typ1 = native_read_i64(s1 as i64, 0)
                if typ1 == 5 do
                    cb = arm64_movz_imm64(cb, 10, native_read_i64(s1 as i64, 32) as int)
                eif typ1 == 4 do
                    off1 = native_read_i64(s1 as i64, 24)
                    cb = emit_fp_sub_addr(cb, 10, 0 - off1)
                    cb = arm64_ldr_uoff(cb, 10, 10, 0)
                else
                    r_s1 = resolve_reg(s1 as LirOperand, assigned_phys)
                    if r_s1 >= 0 and r_s1 != 10 do
                        cb = arm64_mov_rr(cb, 10, r_s1 as int)
                    end
                end
            end
            if s2 != 0 do
                typ2 = native_read_i64(s2 as i64, 0)
                if typ2 == 5 do
                    cb = arm64_movz_imm64(cb, 11, native_read_i64(s2 as i64, 32) as int)
                eif typ2 == 4 do
                    off2 = native_read_i64(s2 as i64, 24)
                    cb = emit_fp_sub_addr(cb, 11, 0 - off2)
                    cb = arm64_ldr_uoff(cb, 11, 11, 0)
                else
                    r_s2 = resolve_reg(s2 as LirOperand, assigned_phys)
                    if r_s2 >= 0 and r_s2 != 11 do
                        cb = arm64_mov_rr(cb, 11, r_s2 as int)
                    end
                end
            end
            if target_has_neon() == 1 do
                cb = arm64_cmp_imm(cb, 11, 16)
                cb = codebuf_emit_u32(cb, 0x540000AB)
                cb = codebuf_emit_u32(cb, 0x3CC10542)
                cb = codebuf_emit_u32(cb, 0x3C810522)
                cb = arm64_sub_imm(cb, 11, 11, 16)
                cb = arm64_b_imm26(cb, 0 - 20)
            end
            cb = arm64_cmp_imm(cb, 11, 8)
            cb = codebuf_emit_u32(cb, 0x540000AB)
            cb = codebuf_emit_u32(cb, 0xF840854C)
            cb = codebuf_emit_u32(cb, 0xF800852C)
            cb = arm64_sub_imm(cb, 11, 11, 8)
            cb = arm64_b_imm26(cb, 0 - 20)
            cb = codebuf_emit_u32(cb, 0xF100017F)
            cb = codebuf_emit_u32(cb, 0x540000AD)
            cb = codebuf_emit_u32(cb, 0x3840154C)
            cb = codebuf_emit_u32(cb, 0x3800152C)
            cb = codebuf_emit_u32(cb, 0xF100056B)
            cb = codebuf_emit_u32(cb, 0x54FFFFA1)
            if rd >= 0 do
                cb = arm64_mov_rr(cb, rd as int, 9)
            end
            out cb
        end
        # ── Inline memset(buf, val, len) / fill_bytes → Hardware 16-Byte NEON + 8B/1B Tail ──
        if bid == 32 do
            s0 = vec_get_rt(recent_setargs, 0)
            s1 = vec_get_rt(recent_setargs, 1)
            s2 = vec_get_rt(recent_setargs, 2)
            if s0 != 0 do
                typ0 = native_read_i64(s0 as i64, 0)
                if typ0 == 5 do # Imm
                    cb = arm64_movz_imm64(cb, 9, native_read_i64(s0 as i64, 32) as int)
                eif typ0 == 4 do # StackMem
                    off0 = native_read_i64(s0 as i64, 24)
                    cb = emit_fp_sub_addr(cb, 9, 0 - off0)
                    cb = arm64_ldr_uoff(cb, 9, 9, 0)
                else
                    r_s0 = resolve_reg(s0 as LirOperand, assigned_phys)
                    if r_s0 >= 0 and r_s0 != 9 do
                        cb = arm64_mov_rr(cb, 9, r_s0 as int)
                    end
                end
            end
            if s1 != 0 do
                typ1 = native_read_i64(s1 as i64, 0)
                if typ1 == 5 do # Imm
                    cb = arm64_movz_imm64(cb, 10, native_read_i64(s1 as i64, 32) as int)
                eif typ1 == 4 do # StackMem
                    off1 = native_read_i64(s1 as i64, 24)
                    cb = emit_fp_sub_addr(cb, 10, 0 - off1)
                    cb = arm64_ldr_uoff(cb, 10, 10, 0)
                else
                    r_s1 = resolve_reg(s1 as LirOperand, assigned_phys)
                    if r_s1 >= 0 and r_s1 != 10 do
                        cb = arm64_mov_rr(cb, 10, r_s1 as int)
                    end
                end
            end
            if s2 != 0 do
                typ2 = native_read_i64(s2 as i64, 0)
                if typ2 == 5 do # Imm
                    cb = arm64_movz_imm64(cb, 11, native_read_i64(s2 as i64, 32) as int)
                eif typ2 == 4 do # StackMem
                    off2 = native_read_i64(s2 as i64, 24)
                    cb = emit_fp_sub_addr(cb, 11, 0 - off2)
                    cb = arm64_ldr_uoff(cb, 11, 11, 0)
                else
                    r_s2 = resolve_reg(s2 as LirOperand, assigned_phys)
                    if r_s2 >= 0 and r_s2 != 11 do
                        cb = arm64_mov_rr(cb, 11, r_s2 as int)
                    end
                end
            end
            if target_has_neon() == 1 do
                cb = arm64_dup_16b(cb, 2, 10)
                cb = arm64_cmp_imm(cb, 11, 16)
                cb = codebuf_emit_u32(cb, 0x5400008B)
                cb = codebuf_emit_u32(cb, 0x3C810522)
                cb = arm64_sub_imm(cb, 11, 11, 16)
                cb = arm64_b_imm26(cb, 0 - 16)
            end
            cb = arm64_and_mask(cb, 12, 10, 255)
            cb = arm64_movz_imm64(cb, 13, 8)
            cb = arm64_lsl_rrr(cb, 13, 12, 13)
            cb = arm64_orr_rrr(cb, 12, 12, 13)
            cb = arm64_movz_imm64(cb, 13, 16)
            cb = arm64_lsl_rrr(cb, 13, 12, 13)
            cb = arm64_orr_rrr(cb, 12, 12, 13)
            cb = arm64_movz_imm64(cb, 13, 32)
            cb = arm64_lsl_rrr(cb, 13, 12, 13)
            cb = arm64_orr_rrr(cb, 12, 12, 13)
            cb = arm64_cmp_imm(cb, 11, 8)
            cb = codebuf_emit_u32(cb, 0x5400008B)
            cb = codebuf_emit_u32(cb, 0xF800852C)
            cb = arm64_sub_imm(cb, 11, 11, 8)
            cb = arm64_b_imm26(cb, 0 - 16)
            cb = codebuf_emit_u32(cb, 0xF100017F)
            cb = codebuf_emit_u32(cb, 0x5400008D)
            cb = codebuf_emit_u32(cb, 0x3800152A)
            cb = codebuf_emit_u32(cb, 0xF100056B)
            cb = codebuf_emit_u32(cb, 0x54FFFFC1)
            if rd >= 0 do
                cb = arm64_mov_rr(cb, rd as int, 9)
            end
            out cb
        end
        # ── Zero-Cost Inlined Linear / Arena Allocator (bid 3, 49, 50, 51) ──
        if bid == 3 or bid == 49 or bid == 50 do
            var size_arg_idx = 0
            if bid == 50 do
                size_arg_idx = 1
            end
            var out_r = rd
            if out_r < 0 do
                out_r = 12
            end
            # Load the size argument from recent_setargs into scratch register X0
            var size_reg = 0
            if vec_len_rt(recent_setargs) > size_arg_idx do
                s_size = vec_get_rt(recent_setargs, size_arg_idx)
                if s_size != 0 do
                    var (cb_sz, r_sz) = lir_load_opnd_to_reg(cb, s_size as LirOperand, assigned_phys, 0)
                    cb = cb_sz
                    size_reg = r_sz
                end
            end
            cb = emit_arm64_checked_bump_alloc(cb, size_reg, out_r, is_linux)
            if rd < 0 and ins_dst != 0 do
                off = lir_opnd_spill_off(ins_dst as i64)
                if off != 0 do
                    if off < 0 and off >= 0 - 255 do
                        cb = arm64_stur(cb, out_r as int, 29, off as int)
                    else
                        if off < 0 do
                            cb = emit_fp_sub_addr(cb, 9, 0 - off)
                            cb = arm64_str_uoff(cb, out_r as int, 9, 0)
                        end
                    end
                end
            end
            out cb
        end
        # ── Zero-Cost Instant Arena Reset / Free (bid == 51) ──
        if bid == 51 do
            if vec_len_rt(recent_setargs) >= 1 do
                s0 = vec_get_rt(recent_setargs, 0)
                if s0 != 0 do
                    r_mark = resolve_or_imm_reg(cb, s0 as LirOperand, assigned_phys, 9)
                    cb = arm64_str_uoff(cb, r_mark as int, 28, 0)
                end
            end
            out cb
        end
        # ── Inline rotl32(val, n) → Hardware 32-bit ROR / RORV ──
        if bid == 84 do
            if rd >= 0 do
                s0 = vec_get_rt(recent_setargs, 0)
                s1 = vec_get_rt(recent_setargs, 1)
                var (cb1, r0) = lir_load_opnd_to_reg(cb, s0, assigned_phys, 14)
                var (cb2, r1) = lir_load_opnd_to_reg(cb1, s1, assigned_phys, 15)
                # ARM64: neg w15, w_r1; ror w_rd, w_r0, w15
                cb = codebuf_emit_u32(cb2, 0x4B0003EF or ((r1 as int and 0x1F) shl 16))
                cb = codebuf_emit_u32(cb, 0x1AC02C00 or (15 shl 16) or ((r0 as int and 0x1F) shl 5) or (rd as int and 0x1F))
                out cb
            end
            out cb
        end
        # ── Inline rotr32(val, n) → Hardware 32-bit ROR / RORV ──
        if bid == 85 do
            if rd >= 0 do
                s0 = vec_get_rt(recent_setargs, 0)
                s1 = vec_get_rt(recent_setargs, 1)
                var (cb1, r0) = lir_load_opnd_to_reg(cb, s0, assigned_phys, 14)
                var (cb2, r1) = lir_load_opnd_to_reg(cb1, s1, assigned_phys, 15)
                # ARM64: ror w_rd, w_r0, w_r1
                cb = codebuf_emit_u32(cb2, 0x1AC02C00 or ((r1 as int and 0x1F) shl 16) or ((r0 as int and 0x1F) shl 5) or (rd as int and 0x1F))
                out cb
            end
            out cb
        end
        # ── Inline __clz(val) (bid == 33) → ARM64 CLZ Xd, Xn ──
        if bid == 33 do
            if rd >= 0 do
                s0 = vec_get_rt(recent_setargs, 0)
                var (cb1, r0) = lir_load_opnd_to_reg(cb, s0, assigned_phys, 9)
                cb = arm64_clz(cb1, rd as int, r0 as int)
            end
            out cb
        end
        # ── Inline __ctz(val) (bid == 34) → ARM64 RBIT + CLZ ──
        if bid == 34 do
            if rd >= 0 do
                s0 = vec_get_rt(recent_setargs, 0)
                var (cb1, r0) = lir_load_opnd_to_reg(cb, s0, assigned_phys, 9)
                cb = arm64_rbit(cb1, 9, r0 as int)
                cb = arm64_clz(cb, rd as int, 9)
            end
            out cb
        end
        # ── Inline __popcnt(val) (bid == 35) → ARM64 NEON FMOV + CNT + UADDLV + FMOV ──
        if bid == 35 do
            if rd >= 0 do
                s0 = vec_get_rt(recent_setargs, 0)
                var (cb1, r0) = lir_load_opnd_to_reg(cb, s0, assigned_phys, 9)
                # fmov d16, x_r0
                cb = codebuf_emit_u32(cb1, 0x9E670000 or ((r0 as int and 0x1F) shl 5) or 16)
                # cnt v16.8b, v16.8b
                cb = codebuf_emit_u32(cb, 0x0E205A10)
                # uaddlv h16, v16.8b
                cb = codebuf_emit_u32(cb, 0x2E303A10)
                # fmov x_rd, d16
                cb = codebuf_emit_u32(cb, 0x9E660200 or (rd as int and 0x1F))
            end
            out cb
        end
        # ── Inline __not(val) (bid == 37) → ARM64 MVN Xd, Xn ──
        if bid == 37 do
            if rd >= 0 do
                s0 = vec_get_rt(recent_setargs, 0)
                var (cb1, r0) = lir_load_opnd_to_reg(cb, s0, assigned_phys, 9)
                cb = arm64_mvn_rr(cb1, rd as int, r0 as int)
            end
            out cb
        end
        # ── Inline __neg(val) (bid == 38) → ARM64 SUB Xd, XZR, Xn ──
        if bid == 38 do
            if rd >= 0 do
                s0 = vec_get_rt(recent_setargs, 0)
                var (cb1, r0) = lir_load_opnd_to_reg(cb, s0, assigned_phys, 9)
                cb = arm64_sub_rrr(cb1, rd as int, 31, r0 as int)
            end
            out cb
        end
        # ── Inline sys_platform() (bid == 105) → MOV Xd, #2 (Linux_ARM64) or #0 (macOS_ARM64) ──
        if bid == 105 do
            if rd >= 0 do
                var plat_val = 0
                if is_linux == 1 do
                    plat_val = 2
                end
                cb = arm64_movz_imm64(cb, rd as int, plat_val)
            end
            out cb
        end
        stub = lir_stub_for_builtin_id(bid)
        if stub < 0 do
            stub = LIR_RT_UNRESOLVED
        end
        var cb_builtin = emit_bl_fixup(cb, call_fixups, 1, stub, rd)
        if rd < 0 do
            cb_builtin = emit_spill_store(cb_builtin, ins_dst as i64, 0)
        end
        out cb_builtin
    end
    if kind == MIR_INTR_PRINT do
        var target_src = ins_src1
        if (target_src as i64) == 0 or native_read_i64(target_src as i64, 0) == 0 do
            target_src = ins_src2
        end
        cb = emit_to_x0(cb, target_src, assigned_phys, 9)
        out emit_bl_fixup(cb, call_fixups, 1, MIR_INTR_PRINT, rd)
    end
    if kind == MIR_INTR_PRINT_FLOAT do
        var target_src_flt = ins_src1
        if (target_src_flt as i64) == 0 or native_read_i64(target_src_flt as i64, 0) == 0 do
            target_src_flt = ins_src2
        end
        cb = emit_to_x0(cb, target_src_flt, assigned_phys, 9)
        out emit_bl_fixup(cb, call_fixups, 1, LIR_RT_PRINT_FLOAT, rd)
    end
    if kind == MIR_INTR_PRINT_BOOL do
        var target_src_b = ins_src1
        if (target_src_b as i64) == 0 or native_read_i64(target_src_b as i64, 0) == 0 do
            target_src_b = ins_src2
        end
        cb = emit_to_x0(cb, target_src_b, assigned_phys, 9)
        out emit_bl_fixup(cb, call_fixups, 1, LIR_RT_PRINT_BOOL, rd)
    end
    if kind == MIR_INTR_PRINT_STR do
        var target_src2 = ins_src1
        if (target_src2 as i64) == 0 or native_read_i64(target_src2 as i64, 0) == 0 do
            target_src2 = ins_src2
        end
        cb = emit_to_x0(cb, target_src2, assigned_phys, 9)
        out emit_bl_fixup(cb, call_fixups, 1, LIR_RT_PRINT_STR, rd)
    end
    if kind == MIR_INTR_STR_EQ do
        cb = emit_to_x0(cb, ins_src1, assigned_phys, 9)
        pattern_op = vec_get_rt(recent_setargs, 0)
        if (pattern_op as i64) != 0 and native_read_i64(pattern_op as i64, 0) == (LirOperandType.Imm as i64) do
            sid = native_read_i64(pattern_op as i64, 32)
            f_strings = native_read_i64(func_obj as i64, 32)
            if f_strings > 0 and sid >= 0 and sid < vec_len_rt(f_strings) do
                s_val = vec_get_rt(f_strings, sid)
                sf = native_read_i64(str_fixups, 0)
                sf = vec_push_rt(sf, lir_str_fixup_new(codebuf_offset(cb) as i64, s_val as i64, 1))
                native_write_i64(str_fixups, 0, sf)
                cb = codebuf_emit_u32(cb, 0x90000001)
                cb = codebuf_emit_u32(cb, 0x91000021)
                cb = emit_bl_fixup(cb, call_fixups, 1, LIR_RT_STR_EQ, rd)
                if rd < 0 and (ins_dst as i64) != 0 do cb = emit_spill_store(cb, ins_dst as i64, 0) end
                out cb
            end
        end
        cb = arm64_movz_imm64(cb, 0, 0)
        if rd >= 0 and rd != 0 do cb = arm64_mov_rr(cb, rd as int, 0) end
        out cb
    end
    if kind == MIR_INTR_STR_LIT or kind == MIR_INTR_INTERP or kind == MIR_INTR_BUNDLE do
        sid = native_read_i64(ins_src1 as i64, 32)
        f_strings = native_read_i64(func_obj as i64, 32)
        var str_rd = rd
        if str_rd < 0 do
            str_rd = 12
        end
        if f_strings > 0 and sid >= 0 and sid < vec_len_rt(f_strings) do
            s_val = vec_get_rt(f_strings, sid)
            sf = native_read_i64(str_fixups, 0)
            sf = vec_push_rt(sf, lir_str_fixup_new(codebuf_offset(cb) as i64, s_val as i64, str_rd))
            native_write_i64(str_fixups, 0, sf)
            cb = codebuf_emit_u32(cb, 0x90000000 or (str_rd as int and 0x1F))
            cb = codebuf_emit_u32(cb, 0x91000000 or ((str_rd as int and 0x1F) shl 5) or (str_rd as int and 0x1F))
            if rd < 0 and (ins_dst as i64) != 0 do
                cb = emit_spill_store(cb, ins_dst as i64, str_rd)
            end
            out cb
        end
        if rd >= 0 do
            arm64_movz_imm64(cb, rd as int, 0)
            out cb
        end
        out arm64_nop(cb)
    end
    if lir_intr_is_payload(kind) == 1 do
        if rd >= 0 do
            if native_read_i64(ins_src1 as i64, 0) == (LirOperandType.Imm as i64) do
                arm64_movz_imm64(cb, rd as int, native_read_i64(ins_src1 as i64, 32) as int)
                out cb
            eif rs1 >= 0 do
                arm64_mov_rr(cb, rd as int, rs1 as int)
                out cb
            end
        end
        out arm64_nop(cb)
    end
    if kind == MIR_INTR_INDEX do
        s0 = vec_get_rt(recent_setargs, 0)
        var (cb1, r_idx) = lir_load_opnd_to_reg(cb, s0, assigned_phys, 9)
        var (cb2, r_base) = lir_load_opnd_to_reg(cb1, ins_src1 as i64, assigned_phys, 10)
        if rd >= 0 do
            cb2 = arm64_add_imm(cb2, 11, r_base as int, 16)
            if ins_typ == (LirType.F32 as i64) or ins_typ == (LirType.Int32 as i64) do
                cb2 = arm64_ldr_w_reg_lsl2(cb2, rd as int, 11, r_idx as int)
            eif ins_typ == (LirType.Int16 as i64) do
                cb2 = arm64_ldrh_reg_lsl1(cb2, rd as int, 11, r_idx as int)
            eif ins_typ == (LirType.Int8 as i64) do
                cb2 = arm64_ldrb_reg(cb2, rd as int, 11, r_idx as int)
            else
                cb2 = arm64_ldr_reg_lsl3(cb2, rd as int, 11, r_idx as int)
            end
        end
        out cb2
    end
    if kind == MIR_INTR_INDEX_STORE do
        s0 = vec_get_rt(recent_setargs, 0)
        s1 = vec_get_rt(recent_setargs, 1)
        var (cb1, r_idx) = lir_load_opnd_to_reg(cb, s0, assigned_phys, 9)
        var (cb2, r_val) = lir_load_opnd_to_reg(cb1, s1, assigned_phys, 10)
        var (cb3, r_base) = lir_load_opnd_to_reg(cb2, ins_src1 as i64, assigned_phys, 11)
        cb3 = arm64_add_imm(cb3, 12, r_base as int, 16)
        if ins_typ == (LirType.F32 as i64) or ins_typ == (LirType.Int32 as i64) do
            cb3 = arm64_str_w_reg_lsl2(cb3, r_val as int, 12, r_idx as int)
        eif ins_typ == (LirType.Int16 as i64) do
            cb3 = arm64_strh_reg_lsl1(cb3, r_val as int, 12, r_idx as int)
        eif ins_typ == (LirType.Int8 as i64) do
            cb3 = arm64_strb_reg(cb3, r_val as int, 12, r_idx as int)
        else
            cb3 = arm64_str_reg_lsl3(cb3, r_val as int, 12, r_idx as int)
        end
        out cb3
    end
    if kind == MIR_INTR_FIELD do
        if rd >= 0 and rs1 >= 0 do
            cb = arm64_ldr_reg_lsl3(cb, rd as int, rs1 as int, 0)
            out cb
        end
        out arm64_nop(cb)
    end
    if kind == MIR_INTR_FIELD_STORE do
        if rs1 >= 0 do
            cb = arm64_str_reg_lsl3(cb, 1, rs1 as int, 0)
            out cb
        end
        out arm64_nop(cb)
    end
    if kind == MIR_MEM_MARK do
        if rd >= 0 do
            cb = arm64_ldr_uoff(cb, rd as int, 28, 0)
            out cb
        end
        out arm64_nop(cb)
    end
    if kind == MIR_MEM_RESET do
        if rs1 >= 0 do
            # Simple mark restore: store saved mark back to *(X28+0).
            # All escaping values have already been promoted to heap by
            # MIR_MEM_PROMOTE before this point.
            cb = arm64_str_uoff(cb, rs1 as int, 28, 0)
            out cb
        end
        out arm64_nop(cb)
    end
    if kind == MIR_MEM_PROMOTE do
        if rs1 >= 0 do
            cb = arm64_mov_rr(cb, 0, rs1 as int)
            cb = arm64_mov_rr(cb, 1, 28)
            cb = arm64_ldr_uoff(cb, 2, 28, 0)
            cb = emit_bl_fixup(cb, call_fixups, 1, LIR_RT_PROMOTE_GRAPH, rd)
            out cb
        end
        out arm64_nop(cb)
    end
    if kind == MIR_MEM_DROP do
        if rs1 >= 0 do
            cb = arm64_movz_imm64(cb, 9, 65536)
            cb = arm64_cmp_rr(cb, rs1 as int, 9)
            let not_ptr_fixup = codebuf_offset(cb) as int
            cb = arm64_blt_imm19(cb, 0)

            cb = arm64_ldr_uoff(cb, 14, 28, 0)
            cb = arm64_cmp_rr(cb, rs1 as int, 14)
            let not_in_arena_fixup = codebuf_offset(cb) as int
            cb = arm64_bge_imm19(cb, 0)

            cb = arm64_sub_imm(cb, 9, rs1 as int, 16)
            cb = arm64_str_uoff(cb, 31, 9, 8)
            cb = arm64_ldr_uoff(cb, 10, 9, 0)
            cb = arm64_add_rrr(cb, 11, 9, 10)
            cb = arm64_cmp_rr(cb, 11, 14)
            let no_rewind_fixup = codebuf_offset(cb) as int
            cb = arm64_bne_imm19(cb, 0)

            cb = arm64_str_uoff(cb, 9, 28, 0)

            let drop_end = codebuf_offset(cb) as int
            let imm_no = ((drop_end - no_rewind_fixup) shr 2) and 0x7FFFF
            cb = codebuf_patch_u32(cb, no_rewind_fixup, (0x54000001 or (imm_no shl 5)) as int)

            let imm_not_arena = ((drop_end - not_in_arena_fixup) shr 2) and 0x7FFFF
            cb = codebuf_patch_u32(cb, not_in_arena_fixup, (0x5400000A or (imm_not_arena shl 5)) as int)

            let imm_not_ptr = ((drop_end - not_ptr_fixup) shr 2) and 0x7FFFF
            cb = codebuf_patch_u32(cb, not_ptr_fixup, (0x5400000B or (imm_not_ptr shl 5)) as int)

            out cb
        end
        out arm64_nop(cb)
    end
    if kind == MIR_INTR_ARENA do
        if rd >= 0 and rs1 < 0 do
            cb = arm64_ldr_uoff(cb, rd as int, 28, 0)
            out cb
        end
        if rs1 >= 0 do
            cb = arm64_str_uoff(cb, rs1 as int, 28, 0)
            out cb
        end
        out arm64_nop(cb)
    end
    if kind == MIR_INTR_ENTITY or kind == MIR_INTR_ARRAY or kind == MIR_INTR_TUPLE do
        n_elem = 0
        if (ins_src1 as i64) != 0 do
            styp = native_read_i64(ins_src1 as i64, 0)
            if styp == 5 do # Imm
                n_elem = native_read_i64(ins_src1 as i64, 32)
            end
        end
        if rd >= 0 do
            cb = arm64_ldr_uoff(cb, 9, 28, 0)
            cb = arm64_mov_rr(cb, rd as int, 9)
            alloc_bytes = n_elem * 8
            if alloc_bytes > 0 do
                cb = arm64_add_imm(cb, 10, 9, alloc_bytes as int)
                cb = arm64_str_uoff(cb, 10, 28, 0)
            end
            var ei = 0
            when ei < n_elem and ei < 8 loop
                cb = arm64_str_uoff(cb, ei as int, rd as int, (ei * 8) as int)
                ei = ei + 1
            end
            out cb
        end
        out arm64_nop(cb)
    end
    if kind == MIR_INTR_ADDR_OF do
        var target_rd = rd
        if (ins_src1 as i64) != 0 and native_read_i64(ins_src1 as i64, 0) == (LirOperandType.Imm as i64) do
            cid = native_read_i64(ins_src1 as i64, 32)
            f_strings = native_read_i64(func_obj as i64, 32)
            if f_strings > 0 and cid >= 0 and cid < vec_len_rt(f_strings) do
                cname = vec_get_rt(f_strings, cid)
                fi = lir_find_func_index(lir_funcs, cname)
                if fi >= 0 do
                    at = codebuf_offset(cb) as i64
                    cb = codebuf_emit_u32(cb, 0x90000000 or (target_rd as int and 0x1F))
                    cb = codebuf_emit_u32(cb, 0x91000000 or ((target_rd as int and 0x1F) shl 5) or (target_rd as int and 0x1F))
                    cf = native_read_i64(call_fixups, 0)
                    cf = vec_push_rt(cf, lir_call_fixup_new(at, 2, fi, target_rd))
                    native_write_i64(call_fixups, 0, cf)
                    if rd < 0 and (ins_dst as i64) != 0 do
                        cb = emit_spill_store(cb, ins_dst as i64, target_rd)
                    end
                    out cb
                end
            end
            print_str("virc: linker error: unresolved function address: ")
            if f_strings > 0 and cid >= 0 and cid < vec_len_rt(f_strings) do
                cname = vec_get_rt(f_strings, cid)
                if (cname as i64) >= 4096 do
                    print_str(native_read_i64(cname as i64, 0))
                else
                    print_str(cname as string)
                end
            end
            print_str("\n")
            sys_exit(1)
            out cb
        end
        if (ins_src1 as i64) != 0 do
            if rd >= 0 do
                if rs1 >= 0 do
                    cb = arm64_mov_rr(cb, rd as int, rs1 as int)
                else
                    cb = arm64_mov_imm16(cb, rd as int, 0)
                end
            eif (ins_dst as i64) != 0 do
                cb = arm64_mov_imm16(cb, target_rd as int, 0)
                cb = emit_spill_store(cb, ins_dst as i64, target_rd)
            end
            out cb
        end
        print_str("virc: linker error: unresolved function address: missing symbol operand\n")
        sys_exit(1)
        out cb
    end
    emit_to_x0(cb, ins_src1, assigned_phys, SCR)
    stub2 = kind
    if stub2 < 1 or stub2 >= LIR_RT_STUB_COUNT do
        stub2 = LIR_RT_UNRESOLVED
    end
    out emit_bl_fixup(cb, call_fixups, 1, stub2, rd)
end.

var g_arm64_func_index_source: i64 = 0
var g_arm64_func_index_buckets: i64 = 0
var g_codegen_func_obj: i64 = 0
var g_codegen_blocks: i64 = 0
var g_codegen_cur_block: i64 = 0
var g_codegen_cur_instrs: i64 = 0
var g_codegen_stack_size: i64 = 0
var g_codegen_max_phys: i64 = 0

func arm64_func_name_hash(name: string):
    if name as i64 == 0 do out 0 end
    data = native_read_i64(name as i64, 0)
    n = native_read_i64(name as i64, 8)
    if data == 0 and n > 0 do out 0 end
    h = n * 17
    var i = 0
    when i < n loop
        h = h * 131 + native_read_u8(data, i)
        i = i + 1
    end
    if h < 0 do h = 0 - h end
    out h mod 256
end.

func arm64_prepare_func_index(lir_funcs: i64):
    held_funcs = lir_funcs
    buckets = vec_new_cap_rt(256)
    var bi = 0
    when bi < 256 loop
        buckets = vec_push_rt(buckets, 0)
        bi = bi + 1
    end
    n = vec_len_rt(held_funcs)
    var i = 0
    when i < n loop
        lf = vec_get_rt(held_funcs, i)
        if lf != 0 do
            fn_name = native_read_i64(lf as i64, 8) as string
            if fn_name as i64 != 0 do
                bid = arm64_func_name_hash(fn_name)
                bucket = vec_get_rt(buckets, bid)
                if bucket == 0 do bucket = vec_new_rt() end
                bucket = vec_push_rt(bucket, i)
                vec_set_rt(buckets, bid, bucket)
            end
        end
        i = i + 1
    end
    g_arm64_func_index_source = held_funcs
    g_arm64_func_index_buckets = buckets
end.

func lir_find_func_index(lir_funcs: i64, name: string):
    # Keep bootstrap lookup independent of the cached hash index.  A compiler
    # generation can reuse an arena address for a different LIR vector, making
    # pointer-identity cache invalidation return stale buckets.
    n = vec_len_rt(lir_funcs)
    var i = 0
    when i < n loop
        lf = vec_get_rt(lir_funcs, i)
        if lf != 0 do
            fn_name = native_read_i64(lf as i64, 8) as string
            if (fn_name as i64) != 0 and fat_str_eq(fn_name, name) == 1 do out i end
        end
        i = i + 1
    end
    out 0 - 1
end.

