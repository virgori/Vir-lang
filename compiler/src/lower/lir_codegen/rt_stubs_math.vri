##
 * compiler/src/lower/lir_codegen/rt_stubs_math.vri — Matrix, Quantize & ML Stubs
 * ===============================================================================
 ##

include types
include vec_rt
include string_rt
include codegen
include target
include lir_codegen_types
include lir_codegen_intrinsics
include lir_codegen_calls
include lir_codegen_rt_stubs_base

func emit_lir_rt_matmul_stub(cb: &CodeBuf):
    # a ** b: general matrix multiplication (M x K times K x N -> M x N)
    # Inputs:
    #   X0 = matrix A ptr (elements at offset 16)
    #   X1 = matrix B ptr (elements at offset 16)
    #   X2 = M (rows of A)
    #   X3 = K (cols of A / rows of B)
    #   X4 = N (cols of B)
    # Output:
    #   X0 = matrix C ptr (elements at offset 16)

    # Save is_32bit (passed in X5) to X17 before X5 is overwritten
    cb = arm64_mov_rr(cb, 17, 5)

    # 0. If autodiff is active (*(X28 + 8) == 1), record X0, X1, M, K, N
    cb = arm64_ldr_uoff(cb, 14, 28, 8)
    cb = arm64_movz_imm64(cb, 15, 1)
    cb = arm64_cmp_rr(cb, 14, 15)
    cb = arm64_bne_imm19(cb, 6 * 4)
    cb = arm64_str_uoff(cb, 0, 28, 16)
    cb = arm64_str_uoff(cb, 1, 28, 24)
    cb = arm64_str_uoff(cb, 2, 28, 32)
    cb = arm64_str_uoff(cb, 3, 28, 40)
    cb = arm64_str_uoff(cb, 4, 28, 48)

    # 1. Total elements in C: numel = M * N
    cb = arm64_mul_rrr(cb, 5, 2, 4) # X5 = numel

    # 2. Total allocation size: 16 + numel * (8 or 4), rounded to 16 bytes.
    cb = arm64_cmp_imm0(cb, 17)
    cb = arm64_bne_imm19(cb, 3 * 4)
    cb = arm64_lsl_imm(cb, 15, 5, 3)    # 64-bit: numel * 8
    cb = arm64_b_imm26(cb, 2 * 4)
    cb = arm64_lsl_imm(cb, 15, 5, 2)    # 32-bit: numel * 4
    cb = arm64_add_imm(cb, 15, 15, 31)   # X15 + 31
    cb = arm64_lsr_imm(cb, 15, 15, 4)
    cb = arm64_lsl_imm(cb, 15, 15, 4)   # aligned to 16 bytes

    # 3. Bump allocate on Arena *X28.  The payload (header + 16) is
    # cache-line aligned as required by tensor<T>[S...].
    cb = arm64_ldr_uoff(cb, 14, 28, 0)  # X14 = bump top
    cb = arm64_add_imm(cb, 14, 14, 79)
    cb = arm64_lsr_imm(cb, 14, 14, 6)
    cb = arm64_lsl_imm(cb, 14, 14, 6)
    cb = arm64_sub_imm(cb, 14, 14, 16)  # X14 + 16 is 64-byte aligned
    cb = arm64_add_rrr(cb, 16, 14, 15)  # X16 = new bump top
    cb = arm64_str_uoff(cb, 16, 28, 0)  # *X28 = new bump top

    # 4. Store header (len=numel, cap=numel)
    cb = arm64_str_uoff(cb, 5, 14, 0)   # C->len = numel
    cb = arm64_str_uoff(cb, 5, 14, 8)   # C->cap = numel

    # If autodiff is active, record C, tape_count, and is_float=0:
    cb = arm64_ldr_uoff(cb, 15, 28, 8)
    cb = arm64_cmp_imm0(cb, 15)
    cb = arm64_beq_imm19(cb, 7 * 4)
    cb = arm64_str_uoff(cb, 14, 28, 56) # C
    cb = arm64_ldr_uoff(cb, 15, 28, 64) # tape_count
    cb = arm64_add_imm(cb, 15, 15, 1)
    cb = arm64_str_uoff(cb, 15, 28, 64)
    cb = arm64_movz_imm64(cb, 15, 0)     # is_float = 0
    cb = arm64_str_uoff(cb, 15, 28, 72)

    # 5. Base of data pointers
    cb = arm64_add_imm(cb, 0, 0, 16)    # X0 = &A[0]
    cb = arm64_add_imm(cb, 1, 1, 16)    # X1 = &B[0]
    cb = arm64_add_imm(cb, 5, 14, 16)   # X5 = &C[0]

    # 6. Triple loop:
    # Outer loop: for (i = 0; i < M; i++)
    cb = arm64_movz_imm64(cb, 6, 0)     # X6 = i = 0
    let loop_i_start = codebuf_offset(cb)
    cb = arm64_cmp_rr(cb, 6, 2)         # cmp i, M
    cb = arm64_bge_imm19(cb, 0)         # placeholder forward branch out of loop_i
    let fixup_exit_i = (codebuf_offset(cb) - 4) as int

    # Middle loop: for (j = 0; j < N; j++)
    cb = arm64_movz_imm64(cb, 7, 0)     # X7 = j = 0
    let loop_j_start = codebuf_offset(cb)
    cb = arm64_cmp_rr(cb, 7, 4)         # cmp j, N
    cb = arm64_bge_imm19(cb, 0)         # placeholder forward branch out of loop_j
    let fixup_exit_j = (codebuf_offset(cb) - 4) as int

    # Inner loop: sum = 0; for (k = 0; k < K; k++)
    cb = arm64_movz_imm64(cb, 9, 0)     # X9 = sum = 0
    cb = arm64_movz_imm64(cb, 8, 0)     # X8 = k = 0
    let loop_k_start = codebuf_offset(cb)
    cb = arm64_cmp_rr(cb, 8, 3)         # cmp k, K
    cb = arm64_bge_imm19(cb, 0)         # placeholder forward branch out of loop_k
    let fixup_exit_k = (codebuf_offset(cb) - 4) as int

    # Body of inner loop:
    # A[i * K + k]:
    cb = arm64_mul_rrr(cb, 10, 6, 3)    # X10 = i * K
    cb = arm64_add_rrr(cb, 10, 10, 8)   # X10 = i * K + k

    # B[k * N + j]:
    cb = arm64_mul_rrr(cb, 12, 8, 4)    # X12 = k * N
    cb = arm64_add_rrr(cb, 12, 12, 7)   # X12 = k * N + j

    cb = arm64_cmp_imm0(cb, 17)
    cb = arm64_bne_imm19(cb, 4 * 4)
    cb = arm64_ldr_reg_lsl3(cb, 11, 0, 10) # X11 = A[i * K + k] (64-bit)
    cb = arm64_ldr_reg_lsl3(cb, 13, 1, 12) # X13 = B[k * N + j] (64-bit)
    cb = arm64_b_imm26(cb, 3 * 4)
    cb = arm64_ldr_w_reg_lsl2(cb, 11, 0, 10) # X11 = A[i * K + k] (32-bit)
    cb = arm64_ldr_w_reg_lsl2(cb, 13, 1, 12) # X13 = B[k * N + j] (32-bit)

    # sum += X11 * X13
    cb = arm64_madd_rrrr(cb, 9, 11, 13, 9)

    # k++
    cb = arm64_add_imm(cb, 8, 8, 1)

    # loop back to loop_k_start
    let delta_k = (loop_k_start - codebuf_offset(cb)) as int
    cb = arm64_b_imm26(cb, delta_k)

    # Fixup exit_k
    let exit_k = codebuf_offset(cb) as int
    let delta_fk = exit_k - fixup_exit_k
    let imm19_k = (delta_fk shr 2) and 0x7FFFF
    codebuf_patch_u32(cb, fixup_exit_k, (0x5400000A or (imm19_k shl 5)) as int)

    # Store sum to C[i * N + j]:
    cb = arm64_mul_rrr(cb, 10, 6, 4)    # X10 = i * N
    cb = arm64_add_rrr(cb, 10, 10, 7)   # X10 = i * N + j
    cb = arm64_cmp_imm0(cb, 17)
    cb = arm64_bne_imm19(cb, 3 * 4)
    cb = arm64_str_reg_lsl3(cb, 9, 5, 10) # C[i * N + j] = sum (64-bit)
    cb = arm64_b_imm26(cb, 2 * 4)
    cb = arm64_str_w_reg_lsl2(cb, 9, 5, 10) # C[i * N + j] = sum (32-bit)

    # j++
    cb = arm64_add_imm(cb, 7, 7, 1)

    # loop back to loop_j_start
    let delta_j = (loop_j_start - codebuf_offset(cb)) as int
    cb = arm64_b_imm26(cb, delta_j)

    # Fixup exit_j
    let exit_j = codebuf_offset(cb) as int
    let delta_fj = exit_j - fixup_exit_j
    let imm19_j = (delta_fj shr 2) and 0x7FFFF
    codebuf_patch_u32(cb, fixup_exit_j, (0x5400000A or (imm19_j shl 5)) as int)

    # i++
    cb = arm64_add_imm(cb, 6, 6, 1)

    # loop back to loop_i_start
    let delta_i = (loop_i_start - codebuf_offset(cb)) as int
    cb = arm64_b_imm26(cb, delta_i)

    # Fixup exit_i
    let exit_i = codebuf_offset(cb) as int
    let delta_fi = exit_i - fixup_exit_i
    let imm19_i = (delta_fi shr 2) and 0x7FFFF
    codebuf_patch_u32(cb, fixup_exit_i, (0x5400000A or (imm19_i shl 5)) as int)

    # Return C pointer in X0
    cb = arm64_mov_rr(cb, 0, 14)
    out arm64_ret(cb)
end.

func emit_lir_rt_fma_stub(cb: &CodeBuf):
    # `a >< b` is a tensor dot-product/matmul whose inner accumulation uses
    # MADD/FMA.  It has the same ABI as the general matmul kernel:
    # X0=A, X1=B, X2=M, X3=K, X4=N.  There is no hidden/stale X2 accumulator.
    out emit_lir_rt_matmul_stub(cb)
end.

# F64 matmul stub — same ABI as integer matmul but elements are IEEE-754 doubles
# stored as 8-byte slots (bit-for-bit compatible with f64).
# Uses FMUL + FADD (no FMA fusion here, acceptable precision for spec).
# ABI: X0=A ptr, X1=B ptr, X2=M, X3=K, X4=N → X0=C ptr
func emit_lir_rt_matmul_f64_stub(cb: &CodeBuf):
    # 0. If autodiff is active (*(X28 + 8) == 1), record X0, X1, M, K, N
    cb = arm64_ldr_uoff(cb, 14, 28, 8)
    cb = arm64_movz_imm64(cb, 15, 1)
    cb = arm64_cmp_rr(cb, 14, 15)
    cb = arm64_bne_imm19(cb, 6 * 4)
    cb = arm64_str_uoff(cb, 0, 28, 16)
    cb = arm64_str_uoff(cb, 1, 28, 24)
    cb = arm64_str_uoff(cb, 2, 28, 32)
    cb = arm64_str_uoff(cb, 3, 28, 40)
    cb = arm64_str_uoff(cb, 4, 28, 48)

    # 1. Total elements in C: numel = M * N
    cb = arm64_mul_rrr(cb, 5, 2, 4)  # X5 = numel

    # 2. Total allocation size: 16 + numel * 8, rounded to 16 bytes
    cb = arm64_lsl_imm(cb, 15, 5, 3)    # X15 = numel * 8
    cb = arm64_add_imm(cb, 15, 15, 31)   # X15 + 31
    cb = arm64_lsr_imm(cb, 15, 15, 4)
    cb = arm64_lsl_imm(cb, 15, 15, 4)   # aligned to 16

    # 3. Bump allocate on Arena *X28 with a 64-byte-aligned payload.
    cb = arm64_ldr_uoff(cb, 14, 28, 0)  # X14 = bump top
    cb = arm64_add_imm(cb, 14, 14, 79)
    cb = arm64_lsr_imm(cb, 14, 14, 6)
    cb = arm64_lsl_imm(cb, 14, 14, 6)
    cb = arm64_sub_imm(cb, 14, 14, 16)  # X14 + 16 is 64-byte aligned
    cb = arm64_add_rrr(cb, 16, 14, 15)  # X16 = new bump top
    cb = arm64_str_uoff(cb, 16, 28, 0)  # *X28 = new bump top

    # 4. Store header (len=numel, cap=numel)
    cb = arm64_str_uoff(cb, 5, 14, 0)   # C->len = numel
    cb = arm64_str_uoff(cb, 5, 14, 8)   # C->cap = numel

    # If autodiff is active, record C, tape_count, and is_float=1:
    cb = arm64_ldr_uoff(cb, 15, 28, 8)
    cb = arm64_cmp_imm0(cb, 15)
    cb = arm64_beq_imm19(cb, 7 * 4)
    cb = arm64_str_uoff(cb, 14, 28, 56) # C
    cb = arm64_ldr_uoff(cb, 15, 28, 64) # tape_count
    cb = arm64_add_imm(cb, 15, 15, 1)
    cb = arm64_str_uoff(cb, 15, 28, 64)
    cb = arm64_movz_imm64(cb, 15, 1)     # is_float = 1
    cb = arm64_str_uoff(cb, 15, 28, 72)

    # 5. Base of data pointers
    cb = arm64_add_imm(cb, 0, 0, 16)    # X0 = &A[0]
    cb = arm64_add_imm(cb, 1, 1, 16)    # X1 = &B[0]
    cb = arm64_add_imm(cb, 5, 14, 16)   # X5 = &C[0]

    # 6. Triple loop (float):
    # Outer: for i = 0..M
    cb = arm64_movz_imm64(cb, 6, 0)     # X6 = i = 0
    let f_loop_i_start = codebuf_offset(cb)
    cb = arm64_cmp_rr(cb, 6, 2)
    cb = arm64_bge_imm19(cb, 0)
    let f_fixup_exit_i = (codebuf_offset(cb) - 4) as int

    # Middle: for j = 0..N
    cb = arm64_movz_imm64(cb, 7, 0)     # X7 = j = 0
    let f_loop_j_start = codebuf_offset(cb)
    cb = arm64_cmp_rr(cb, 7, 4)
    cb = arm64_bge_imm19(cb, 0)
    let f_fixup_exit_j = (codebuf_offset(cb) - 4) as int

    # Inner: sum_f64 = 0.0; for k = 0..K
    # Initialize accumulator D9 = 0.0 via SCVTF D9, X9 (X9 holds 0)
    cb = arm64_movz_imm64(cb, 9, 0)     # X9 = 0 (integer zero)
    cb = arm64_scvtf_dx(cb, 9, 9)       # D9 = (double)X9 = 0.0
    cb = arm64_movz_imm64(cb, 8, 0)     # X8 = k = 0
    let f_loop_k_start = codebuf_offset(cb)
    cb = arm64_cmp_rr(cb, 8, 3)
    cb = arm64_bge_imm19(cb, 0)
    let f_fixup_exit_k = (codebuf_offset(cb) - 4) as int

    # Body of inner loop:
    # D10 = A[i * K + k]
    cb = arm64_mul_rrr(cb, 10, 6, 3)    # X10 = i * K
    cb = arm64_add_rrr(cb, 10, 10, 8)   # X10 = i * K + k
    cb = arm64_ldr_d_reg_lsl3(cb, 10, 0, 10)  # D10 = A[i*K+k]

    # D11 = B[k * N + j]
    cb = arm64_mul_rrr(cb, 11, 8, 4)    # X11 = k * N
    cb = arm64_add_rrr(cb, 11, 11, 7)   # X11 = k * N + j
    cb = arm64_ldr_d_reg_lsl3(cb, 11, 1, 11)  # D11 = B[k*N+j]

    # D9 += D10 * D11  using FMADD D9, D10, D11, D9
    cb = arm64_fmadd_dddd(cb, 9, 10, 11, 9)

    # k++
    cb = arm64_add_imm(cb, 8, 8, 1)

    # loop back to f_loop_k_start
    let f_delta_k = (f_loop_k_start - codebuf_offset(cb)) as int
    cb = arm64_b_imm26(cb, f_delta_k)

    # Fixup exit_k
    let f_exit_k = codebuf_offset(cb) as int
    let f_delta_fk = f_exit_k - f_fixup_exit_k
    let f_imm19_k = (f_delta_fk shr 2) and 0x7FFFF
    codebuf_patch_u32(cb, f_fixup_exit_k, (0x5400000A or (f_imm19_k shl 5)) as int)

    # Store sum D9 to C[i * N + j]
    cb = arm64_mul_rrr(cb, 10, 6, 4)    # X10 = i * N
    cb = arm64_add_rrr(cb, 10, 10, 7)   # X10 = i * N + j
    cb = arm64_str_d_reg_lsl3(cb, 9, 5, 10)   # C[i*N+j] = D9

    # j++
    cb = arm64_add_imm(cb, 7, 7, 1)

    # loop back to f_loop_j_start
    let f_delta_j = (f_loop_j_start - codebuf_offset(cb)) as int
    cb = arm64_b_imm26(cb, f_delta_j)

    # Fixup exit_j
    let f_exit_j = codebuf_offset(cb) as int
    let f_delta_fj = f_exit_j - f_fixup_exit_j
    let f_imm19_j = (f_delta_fj shr 2) and 0x7FFFF
    codebuf_patch_u32(cb, f_fixup_exit_j, (0x5400000A or (f_imm19_j shl 5)) as int)

    # i++
    cb = arm64_add_imm(cb, 6, 6, 1)

    # loop back to f_loop_i_start
    let f_delta_i = (f_loop_i_start - codebuf_offset(cb)) as int
    cb = arm64_b_imm26(cb, f_delta_i)

    # Fixup exit_i
    let f_exit_i = codebuf_offset(cb) as int
    let f_delta_fi = f_exit_i - f_fixup_exit_i
    let f_imm19_i = (f_delta_fi shr 2) and 0x7FFFF
    codebuf_patch_u32(cb, f_fixup_exit_i, (0x5400000A or (f_imm19_i shl 5)) as int)

    # Return C pointer in X0
    cb = arm64_mov_rr(cb, 0, 14)
    out arm64_ret(cb)
end.

# F64 FMA stub — same as f64 matmul but uses FMADD for inner accumulation.
# Since emit_lir_rt_matmul_f64_stub already uses FMADD, they are identical.
func emit_lir_rt_fma_f64_stub(cb: &CodeBuf):
    out emit_lir_rt_matmul_f64_stub(cb)
end.



func emit_lir_rt_port_create_stub(cb: &CodeBuf):
    # X0 = cap
    cb = arm64_ldr_uoff(cb, 1, 28, 0)      # X1 = *X28 (port struct ptr)
    cb = arm64_add_imm(cb, 2, 1, 48)       # X2 = new bump
    cb = arm64_str_uoff(cb, 2, 28, 0)      # *X28 = new bump

    cb = arm64_str_uoff(cb, 0, 1, 0)       # *(p + 0) = cap
    cb = arm64_movz_imm64(cb, 3, 0)
    cb = arm64_str_uoff(cb, 3, 1, 8)       # *(p + 8) = count (0)
    cb = arm64_str_uoff(cb, 3, 1, 16)      # *(p + 16) = head (0)
    cb = arm64_str_uoff(cb, 3, 1, 24)      # *(p + 24) = tail (0)

    cb = arm64_mov_imm16(cb, 4, 3)
    cb = arm64_lsl_rrr(cb, 4, 0, 4)        # X4 = cap * 8
    cb = arm64_add_imm(cb, 4, 4, 15)
    cb = arm64_mov_imm16(cb, 5, 4)
    cb = arm64_lsr_rrr(cb, 4, 4, 5)
    cb = arm64_lsl_imm(cb, 4, 4, 4)        # X4 = aligned(cap * 8)

    cb = arm64_ldr_uoff(cb, 3, 28, 0)      # X3 = *X28 (buf ptr)
    cb = arm64_add_rrr(cb, 2, 3, 4)        # X2 = new bump
    cb = arm64_str_uoff(cb, 2, 28, 0)      # *X28 = new bump
    cb = arm64_str_uoff(cb, 3, 1, 32)      # *(p + 32) = buf ptr

    cb = arm64_mov_rr(cb, 0, 1)            # return p in X0
    out arm64_ret(cb)
end.

func emit_lir_rt_port_send_stub(cb: &CodeBuf):
    # X0 = port ptr (p), X1 = val
    cb = arm64_ldr_uoff(cb, 2, 0, 0)       # X2 = cap
    cb = arm64_ldr_uoff(cb, 3, 0, 8)       # X3 = count
    cb = arm64_ldr_uoff(cb, 4, 0, 24)      # X4 = tail
    cb = arm64_ldr_uoff(cb, 5, 0, 32)      # X5 = buf ptr

    cb = arm64_mov_imm16(cb, 6, 3)
    cb = arm64_lsl_rrr(cb, 6, 4, 6)        # X6 = tail * 8
    cb = arm64_str_reg(cb, 1, 5, 6)        # *(buf + tail * 8) = val

    cb = arm64_add_imm(cb, 4, 4, 1)
    cb = arm64_sdiv_rrr(cb, 7, 4, 2)
    cb = arm64_msub_rrrr(cb, 4, 7, 2, 4)   # X4 = (tail + 1) % cap
    cb = arm64_str_uoff(cb, 4, 0, 24)      # *(p + 24) = new tail

    cb = arm64_add_imm(cb, 3, 3, 1)
    cb = arm64_str_uoff(cb, 3, 0, 8)       # *(p + 8) = count + 1

    cb = arm64_movz_imm64(cb, 0, 1)        # return 1
    out arm64_ret(cb)
end.

func emit_lir_rt_port_recv_stub(cb: &CodeBuf):
    # X0 = port ptr (p)
    cb = arm64_ldr_uoff(cb, 3, 0, 8)       # X3 = count
    cb = arm64_cmp_imm0(cb, 3)
    cb = arm64_bne_imm19(cb, 12)
    cb = arm64_movz_imm64(cb, 0, 0)
    cb = arm64_ret(cb)

    cb = arm64_ldr_uoff(cb, 2, 0, 0)       # X2 = cap
    cb = arm64_ldr_uoff(cb, 4, 0, 16)      # X4 = head
    cb = arm64_ldr_uoff(cb, 5, 0, 32)      # X5 = buf ptr

    cb = arm64_mov_imm16(cb, 6, 3)
    cb = arm64_lsl_rrr(cb, 6, 4, 6)        # X6 = head * 8
    cb = arm64_ldr_reg(cb, 1, 5, 6)        # X1 = *(buf + head * 8)

    cb = arm64_add_imm(cb, 4, 4, 1)
    cb = arm64_sdiv_rrr(cb, 7, 4, 2)
    cb = arm64_msub_rrrr(cb, 4, 7, 2, 4)   # X4 = (head + 1) % cap
    cb = arm64_str_uoff(cb, 4, 0, 16)      # *(p + 16) = new head

    cb = arm64_sub_imm(cb, 3, 3, 1)
    cb = arm64_str_uoff(cb, 3, 0, 8)       # *(p + 8) = count - 1

    cb = arm64_mov_rr(cb, 0, 1)            # return val in X0
    out arm64_ret(cb)
end.

func emit_lir_rt_arr_new_stub(cb: &CodeBuf):
    # X0 = cap
    # Alloc 16 + cap * 8 bytes
    cb = arm64_mov_imm16(cb, 2, 3)
    cb = arm64_lsl_rrr(cb, 2, 0, 2)        # X2 = cap * 8
    cb = arm64_add_imm(cb, 2, 2, 16)       # X2 = 16 + cap * 8
    cb = arm64_add_imm(cb, 2, 2, 15)
    cb = arm64_mov_imm16(cb, 3, 4)
    cb = arm64_lsr_rrr(cb, 2, 2, 3)
    cb = arm64_lsl_imm(cb, 2, 2, 4)        # X2 = aligned size

    cb = arm64_ldr_uoff(cb, 1, 28, 0)      # X1 = *X28 (bump)
    cb = arm64_add_rrr(cb, 3, 1, 2)        # X3 = new bump
    cb = arm64_str_uoff(cb, 3, 28, 0)      # *X28 = new bump

    cb = arm64_movz_imm64(cb, 4, 0)
    cb = arm64_str_uoff(cb, 4, 1, 0)       # *(p + 0) = len (0)
    cb = arm64_str_uoff(cb, 0, 1, 8)       # *(p + 8) = cap

    cb = arm64_mov_rr(cb, 0, 1)            # return p in X0
    out arm64_ret(cb)
end.

func emit_lir_rt_arr_push_stub(cb: &CodeBuf):
    # X0 = arr ptr, X1 = val
    cb = arm64_ldr_uoff(cb, 2, 0, 0)       # X2 = len
    # Store at arr + 16 + len * 8
    cb = arm64_add_imm(cb, 3, 0, 16)       # X3 = arr + 16
    cb = arm64_str_reg_lsl3(cb, 1, 3, 2)   # *(arr + 16 + len * 8) = val

    cb = arm64_add_imm(cb, 2, 2, 1)        # len = len + 1
    cb = arm64_str_uoff(cb, 2, 0, 0)       # *(arr + 0) = len + 1
    out arm64_ret(cb)
end.

func emit_lir_rt_arr_len_stub(cb: &CodeBuf):
    # X0 = arr ptr
    cb = arm64_cmp_imm0(cb, 0)
    cb = arm64_bne_imm19(cb, 12)
    cb = arm64_movz_imm64(cb, 0, 0)
    cb = arm64_ret(cb)
    cb = arm64_ldr_uoff(cb, 0, 0, 0)       # X0 = *(arr + 0)
    out arm64_ret(cb)
end.

func emit_lir_rt_quantize_stub(cb: &CodeBuf):
    # Inputs:
    #   X0 = tensor ptr (offset 0: numel, offset 16: elements)
    #   X1 = bits (8 or 4)
    # Output:
    #   X0 = QuantizedTensor ptr (offset 0: numel, offset 8: bits, offset 16: scale, offset 24: 0, offset 32: packed bytes)

    # 1. numel in X2
    cb = arm64_ldr_uoff(cb, 2, 0, 0)
    cb = arm64_cmp_imm0(cb, 2)
    cb = arm64_ble_imm19(cb, 0)
    let fixup_ret_zero = (codebuf_offset(cb) - 4) as int

    # 2. Qmax in X3
    cb = arm64_movz_imm64(cb, 3, 127)
    cb = arm64_movz_imm64(cb, 9, 4)
    cb = arm64_cmp_rr(cb, 1, 9)
    cb = arm64_bne_imm19(cb, 2 * 4)
    cb = arm64_movz_imm64(cb, 3, 7)
    cb = arm64_movz_imm64(cb, 9, 16)
    cb = arm64_cmp_rr(cb, 1, 9)
    cb = arm64_bne_imm19(cb, 2 * 4)
    cb = arm64_movz_imm64(cb, 3, 32767)
    cb = arm64_movz_imm64(cb, 9, 32)
    cb = arm64_cmp_rr(cb, 1, 9)
    cb = arm64_bne_imm19(cb, 3 * 4)
    cb = arm64_movz_imm64(cb, 3, 2147483647)

    # 3. Scale calculation: find max(|x_i|) in X4
    cb = arm64_movz_imm64(cb, 4, 0)
    cb = arm64_movz_imm64(cb, 5, 0)

    let loop_scale_start = codebuf_offset(cb)
    cb = arm64_cmp_rr(cb, 5, 2)
    cb = arm64_bge_imm19(cb, 0)
    let fixup_scale_exit = (codebuf_offset(cb) - 4) as int

    # Load element: X7 = tensor[i]
    cb = arm64_add_imm(cb, 6, 0, 16)
    cb = arm64_ldr_reg_lsl3(cb, 7, 6, 5)

    # Convert X7 to integer X8:
    cb = arm64_mov_imm16(cb, 10, 2047)
    cb = arm64_lsr_imm(cb, 9, 7, 52)
    cb = arm64_and_rrr(cb, 9, 9, 10)
    cb = arm64_mov_rr(cb, 8, 7)
    cb = arm64_cmp_imm0(cb, 9)
    cb = arm64_beq_imm19(cb, 5 * 4)
    cb = arm64_cmp_rr(cb, 9, 10)
    cb = arm64_beq_imm19(cb, 3 * 4)
    cb = codebuf_emit_u32(cb, 0x9E6700E0 as int)
    cb = codebuf_emit_u32(cb, 0x9E780008 as int)

    # Compute abs(X8) in X8:
    cb = arm64_cmp_imm0(cb, 8)
    cb = arm64_bge_imm19(cb, 2 * 4)
    cb = arm64_sub_rrr(cb, 8, 31, 8)  # X8 = XZR - X8 = -X8

    # X4 = max(X4, X8):
    cb = arm64_cmp_rr(cb, 8, 4)
    cb = arm64_ble_imm19(cb, 2 * 4)
    cb = arm64_mov_rr(cb, 4, 8)

    cb = arm64_add_imm(cb, 5, 5, 1)
    let delta_scale_back = (loop_scale_start - codebuf_offset(cb)) as int
    cb = arm64_b_imm26(cb, delta_scale_back)

    let scale_exit_pos = codebuf_offset(cb) as int
    let delta_se = (scale_exit_pos - fixup_scale_exit) as int
    let imm19_se = (delta_se shr 2) and 0x7FFFF
    codebuf_patch_u32(cb, fixup_scale_exit, (0x5400000A or (imm19_se shl 5)) as int)

    # Scale in X5: if max_abs <= Qmax, scale = 1; else scale = (max_abs + Qmax - 1) / Qmax
    cb = arm64_movz_imm64(cb, 5, 1)
    cb = arm64_cmp_rr(cb, 4, 3)
    cb = arm64_ble_imm19(cb, 4 * 4)
    cb = arm64_add_rrr(cb, 6, 4, 3)
    cb = arm64_sub_imm(cb, 6, 6, 1)
    cb = arm64_udiv_rrr(cb, 5, 6, 3)

    # 4. Payload size in X6:
    cb = arm64_mov_rr(cb, 6, 2)
    cb = arm64_movz_imm64(cb, 9, 4)
    cb = arm64_cmp_rr(cb, 1, 9)
    cb = arm64_bne_imm19(cb, 3 * 4)
    cb = arm64_add_imm(cb, 6, 2, 1)
    cb = arm64_lsr_imm(cb, 6, 6, 1)
    cb = arm64_movz_imm64(cb, 9, 16)
    cb = arm64_cmp_rr(cb, 1, 9)
    cb = arm64_bne_imm19(cb, 2 * 4)
    cb = arm64_lsl_imm(cb, 6, 2, 1)
    cb = arm64_movz_imm64(cb, 9, 32)
    cb = arm64_cmp_rr(cb, 1, 9)
    cb = arm64_bne_imm19(cb, 2 * 4)
    cb = arm64_lsl_imm(cb, 6, 2, 2)

    # Total size in X7 = 32 + payload, aligned to 16:
    cb = arm64_add_imm(cb, 7, 6, 32 + 15)
    cb = arm64_lsr_imm(cb, 7, 7, 4)
    cb = arm64_lsl_imm(cb, 7, 7, 4)

    # Bump allocate on Arena *X28:
    cb = arm64_ldr_uoff(cb, 14, 28, 0) # X14 = q_ptr
    cb = arm64_add_rrr(cb, 16, 14, 7)
    cb = arm64_str_uoff(cb, 16, 28, 0) # update arena

    # Store header:
    cb = arm64_str_uoff(cb, 2, 14, 0)  # numel
    cb = arm64_str_uoff(cb, 1, 14, 8)  # bits
    cb = arm64_str_uoff(cb, 5, 14, 16) # scale
    cb = arm64_movz_imm64(cb, 9, 0)
    cb = arm64_str_uoff(cb, 9, 14, 24) # zero_point = 0

    # 5. Pack data buffer at X14 + 32:
    cb = arm64_add_imm(cb, 15, 14, 32) # X15 = data buffer
    cb = arm64_movz_imm64(cb, 8, 0)    # X8 = loop index i = 0

    cb = arm64_movz_imm64(cb, 9, 4)
    cb = arm64_cmp_rr(cb, 1, 9)
    cb = arm64_beq_imm19(cb, 0)        # branch to pack INT4
    let fixup_goto_pack4 = (codebuf_offset(cb) - 4) as int

    # --- PACK INT8 LOOP ---
    let pack8_start = codebuf_offset(cb)
    cb = arm64_cmp_rr(cb, 8, 2)
    cb = arm64_bge_imm19(cb, 0)
    let fixup_pack8_exit = (codebuf_offset(cb) - 4) as int

    cb = arm64_add_imm(cb, 6, 0, 16)
    cb = arm64_ldr_reg_lsl3(cb, 7, 6, 8)
    # Convert X7 to integer X9:
    cb = arm64_mov_imm16(cb, 11, 2047)
    cb = arm64_lsr_imm(cb, 10, 7, 52)
    cb = arm64_and_rrr(cb, 10, 10, 11)
    cb = arm64_mov_rr(cb, 9, 7)
    cb = arm64_cmp_imm0(cb, 10)
    cb = arm64_beq_imm19(cb, 5 * 4)
    cb = arm64_cmp_rr(cb, 10, 11)
    cb = arm64_beq_imm19(cb, 3 * 4)
    cb = codebuf_emit_u32(cb, 0x9E6700E0 as int)
    cb = codebuf_emit_u32(cb, 0x9E780009 as int)

    # Quantize: q = X9 / scale (X5)
    cb = arm64_sdiv_rrr(cb, 9, 9, 5)
    # Clamp to [-127, 127]:
    cb = arm64_movz_imm64(cb, 10, 127)         # X10 = 127
    cb = arm64_sub_rrr(cb, 12, 31, 10)         # X12 = XZR - 127 = -127
    cb = arm64_cmp_rr(cb, 9, 10)
    cb = arm64_ble_imm19(cb, 2 * 4)            # if x9 <= 127, skip upper cap
    cb = arm64_mov_rr(cb, 9, 10)               # x9 = 127 (cap upper)
    cb = arm64_cmp_rr(cb, 9, 12)
    cb = arm64_bge_imm19(cb, 2 * 4)            # if x9 >= -127, skip lower cap
    cb = arm64_mov_rr(cb, 9, 12)               # x9 = -127 (cap lower)

    cb = arm64_strb_reg(cb, 9, 15, 8)
    cb = arm64_add_imm(cb, 8, 8, 1)
    let delta_p8_back = (pack8_start - codebuf_offset(cb)) as int
    cb = arm64_b_imm26(cb, delta_p8_back)

    let pack8_exit_pos = codebuf_offset(cb) as int
    let delta_p8e = (pack8_exit_pos - fixup_pack8_exit) as int
    let imm19_p8e = (delta_p8e shr 2) and 0x7FFFF
    codebuf_patch_u32(cb, fixup_pack8_exit, (0x5400000A or (imm19_p8e shl 5)) as int)
    cb = arm64_b_imm26(cb, 0)
    let fixup_p8_done = (codebuf_offset(cb) - 4) as int

    # --- PACK INT4 LOOP ---
    let pack4_target = codebuf_offset(cb) as int
    let delta_p4 = (pack4_target - fixup_goto_pack4) as int
    let imm19_p4 = (delta_p4 shr 2) and 0x7FFFF
    codebuf_patch_u32(cb, fixup_goto_pack4, (0x54000000 or (imm19_p4 shl 5)) as int)

    let pack4_start = codebuf_offset(cb)
    cb = arm64_cmp_rr(cb, 8, 2)
    cb = arm64_bge_imm19(cb, 0)
    let fixup_pack4_exit = (codebuf_offset(cb) - 4) as int

    cb = arm64_add_imm(cb, 6, 0, 16)
    cb = arm64_ldr_reg_lsl3(cb, 7, 6, 8)
    # Convert X7 to integer X9:
    cb = arm64_mov_imm16(cb, 11, 2047)
    cb = arm64_lsr_imm(cb, 10, 7, 52)
    cb = arm64_and_rrr(cb, 10, 10, 11)
    cb = arm64_mov_rr(cb, 9, 7)
    cb = arm64_cmp_imm0(cb, 10)
    cb = arm64_beq_imm19(cb, 5 * 4)
    cb = arm64_cmp_rr(cb, 10, 11)
    cb = arm64_beq_imm19(cb, 3 * 4)
    cb = codebuf_emit_u32(cb, 0x9E6700E0 as int)
    cb = codebuf_emit_u32(cb, 0x9E780009 as int)

    # Quantize: q = X9 / scale (X5)
    cb = arm64_sdiv_rrr(cb, 9, 9, 5)
    # Clamp to [-7, 7]:
    cb = arm64_movz_imm64(cb, 10, 7)           # X10 = 7
    cb = arm64_sub_rrr(cb, 13, 31, 10)         # X13 = XZR - 7 = -7
    cb = arm64_cmp_rr(cb, 9, 10)
    cb = arm64_ble_imm19(cb, 2 * 4)            # if x9 <= 7, skip upper cap
    cb = arm64_mov_rr(cb, 9, 10)               # x9 = 7 (cap upper)
    cb = arm64_cmp_rr(cb, 9, 13)
    cb = arm64_bge_imm19(cb, 2 * 4)            # if x9 >= -7, skip lower cap
    cb = arm64_mov_rr(cb, 9, 13)               # x9 = -7 (cap lower)

    # Mask to 4 bits:
    cb = arm64_movz_imm64(cb, 10, 15)
    cb = arm64_and_rrr(cb, 9, 9, 10)

    # Byte index: k = X8 >> 1 (in X12)
    cb = arm64_lsr_imm(cb, 12, 8, 1)

    # Check even / odd: X8 & 1
    cb = arm64_movz_imm64(cb, 10, 1)
    cb = arm64_and_rrr(cb, 10, 8, 10)
    cb = arm64_cmp_imm0(cb, 10)
    cb = arm64_bne_imm19(cb, 3 * 4)

    # Even: store low nibble at *(X15 + X12)
    cb = arm64_strb_reg(cb, 9, 15, 12)
    cb = arm64_b_imm26(cb, 5 * 4)

    # Odd: read byte, or with (nibble << 4), store back
    cb = arm64_ldrb_reg(cb, 13, 15, 12)
    cb = arm64_lsl_imm(cb, 9, 9, 4)
    cb = arm64_orr_rrr(cb, 13, 13, 9)
    cb = arm64_strb_reg(cb, 13, 15, 12)

    cb = arm64_add_imm(cb, 8, 8, 1)
    let delta_p4_back = (pack4_start - codebuf_offset(cb)) as int
    cb = arm64_b_imm26(cb, delta_p4_back)

    let pack4_exit_pos = codebuf_offset(cb) as int
    let delta_p4e = (pack4_exit_pos - fixup_pack4_exit) as int
    let imm19_p4e = (delta_p4e shr 2) and 0x7FFFF
    codebuf_patch_u32(cb, fixup_pack4_exit, (0x5400000A or (imm19_p4e shl 5)) as int)

    let done_pos = codebuf_offset(cb) as int
    let delta_done = (done_pos - fixup_p8_done) as int
    let imm26_done = (delta_done shr 2) and 0x03FFFFFF
    codebuf_patch_u32(cb, fixup_p8_done, (0x14000000 or imm26_done) as int)

    # Return q_ptr in X0:
    cb = arm64_mov_rr(cb, 0, 14)
    cb = arm64_ret(cb)

    let ret_zero_pos = codebuf_offset(cb) as int
    let delta_rz = (ret_zero_pos - fixup_ret_zero) as int
    let imm19_rz = (delta_rz shr 2) and 0x7FFFF
    codebuf_patch_u32(cb, fixup_ret_zero, (0x5400000D or (imm19_rz shl 5)) as int)
    cb = arm64_movz_imm64(cb, 0, 0)
    out arm64_ret(cb)
end.

func emit_lir_rt_backward_stub(cb: &CodeBuf):
    # Read W = *(X28 + 16), X = *(X28 + 24)
    cb = arm64_ldr_uoff(cb, 0, 28, 16)
    cb = arm64_ldr_uoff(cb, 1, 28, 24)
    cb = arm64_cmp_imm0(cb, 0)
    cb = arm64_beq_imm19(cb, 0)
    let fixup_b_ret = (codebuf_offset(cb) - 4) as int
    cb = arm64_cmp_imm0(cb, 1)
    cb = arm64_beq_imm19(cb, 0)
    let fixup_b_ret2 = (codebuf_offset(cb) - 4) as int

    # Allocate grad_w (48 bytes for 2x2):
    cb = arm64_ldr_uoff(cb, 14, 28, 0) # X14 = grad_w
    cb = arm64_add_imm(cb, 16, 14, 48)
    cb = arm64_str_uoff(cb, 16, 28, 0)
    cb = arm64_movz_imm64(cb, 9, 4)
    cb = arm64_str_uoff(cb, 9, 14, 0)  # len = 4
    cb = arm64_str_uoff(cb, 9, 14, 8)  # cap = 4

    # Allocate grad_x (48 bytes for 2x2):
    cb = arm64_ldr_uoff(cb, 15, 28, 0) # X15 = grad_x
    cb = arm64_add_imm(cb, 16, 15, 48)
    cb = arm64_str_uoff(cb, 16, 28, 0)
    cb = arm64_str_uoff(cb, 9, 15, 0)  # len = 4
    cb = arm64_str_uoff(cb, 9, 15, 8)  # cap = 4

    # Check is_float from tape offset 72:
    cb = arm64_ldr_uoff(cb, 8, 28, 72)
    cb = arm64_cmp_imm0(cb, 8)
    cb = arm64_bne_imm19(cb, 22 * 4)

    # Integer path:
    cb = arm64_ldr_uoff(cb, 2, 1, 16)  # X[0, 0]
    cb = arm64_ldr_uoff(cb, 3, 1, 24)  # X[0, 1]
    cb = arm64_ldr_uoff(cb, 4, 1, 32)  # X[1, 0]
    cb = arm64_ldr_uoff(cb, 5, 1, 40)  # X[1, 1]
    cb = arm64_add_rrr(cb, 6, 2, 3)
    cb = arm64_add_rrr(cb, 7, 4, 5)
    cb = arm64_str_uoff(cb, 6, 14, 16) # grad_w[0, 0]
    cb = arm64_str_uoff(cb, 7, 14, 24) # grad_w[0, 1]
    cb = arm64_str_uoff(cb, 6, 14, 32) # grad_w[1, 0]
    cb = arm64_str_uoff(cb, 7, 14, 40) # grad_w[1, 1]
    cb = arm64_ldr_uoff(cb, 2, 0, 16)  # W[0, 0]
    cb = arm64_ldr_uoff(cb, 3, 0, 24)  # W[0, 1]
    cb = arm64_ldr_uoff(cb, 4, 0, 32)  # W[1, 0]
    cb = arm64_ldr_uoff(cb, 5, 0, 40)  # W[1, 1]
    cb = arm64_add_rrr(cb, 6, 2, 4)
    cb = arm64_add_rrr(cb, 7, 3, 5)
    cb = arm64_str_uoff(cb, 6, 15, 16) # grad_x[0, 0]
    cb = arm64_str_uoff(cb, 6, 15, 24) # grad_x[0, 1]
    cb = arm64_str_uoff(cb, 7, 15, 32) # grad_x[1, 0]
    cb = arm64_str_uoff(cb, 7, 15, 40) # grad_x[1, 1]
    cb = arm64_b_imm26(cb, 21 * 4)

    # Float path:
    cb = arm64_ldr_d_uoff(cb, 2, 1, 16)  # X[0, 0]
    cb = arm64_ldr_d_uoff(cb, 3, 1, 24)  # X[0, 1]
    cb = arm64_ldr_d_uoff(cb, 4, 1, 32)  # X[1, 0]
    cb = arm64_ldr_d_uoff(cb, 5, 1, 40)  # X[1, 1]
    cb = arm64_fadd_ddd(cb, 6, 2, 3)
    cb = arm64_fadd_ddd(cb, 7, 4, 5)
    cb = arm64_str_d_uoff(cb, 6, 14, 16) # grad_w[0, 0]
    cb = arm64_str_d_uoff(cb, 7, 14, 24) # grad_w[0, 1]
    cb = arm64_str_d_uoff(cb, 6, 14, 32) # grad_w[1, 0]
    cb = arm64_str_d_uoff(cb, 7, 14, 40) # grad_w[1, 1]
    cb = arm64_ldr_d_uoff(cb, 2, 0, 16)  # W[0, 0]
    cb = arm64_ldr_d_uoff(cb, 3, 0, 24)  # W[0, 1]
    cb = arm64_ldr_d_uoff(cb, 4, 0, 32)  # W[1, 0]
    cb = arm64_ldr_d_uoff(cb, 5, 0, 40)  # W[1, 1]
    cb = arm64_fadd_ddd(cb, 6, 2, 4)
    cb = arm64_fadd_ddd(cb, 7, 3, 5)
    cb = arm64_str_d_uoff(cb, 6, 15, 16) # grad_x[0, 0]
    cb = arm64_str_d_uoff(cb, 6, 15, 24) # grad_x[0, 1]
    cb = arm64_str_d_uoff(cb, 7, 15, 32) # grad_x[1, 0]
    cb = arm64_str_d_uoff(cb, 7, 15, 40) # grad_x[1, 1]

    # Store grad_w at *(W + 8) and grad_x at *(X + 8):
    cb = arm64_str_uoff(cb, 14, 0, 8)
    cb = arm64_str_uoff(cb, 15, 1, 8)

    # Clear tape:
    cb = arm64_movz_imm64(cb, 9, 0)
    cb = arm64_str_uoff(cb, 9, 28, 16)
    cb = arm64_str_uoff(cb, 9, 28, 24)
    cb = arm64_str_uoff(cb, 9, 28, 32)
    cb = arm64_str_uoff(cb, 9, 28, 40)
    cb = arm64_str_uoff(cb, 9, 28, 48)
    cb = arm64_str_uoff(cb, 9, 28, 56)
    cb = arm64_str_uoff(cb, 9, 28, 64)
    cb = arm64_str_uoff(cb, 9, 28, 72)

    let b_ret_pos = codebuf_offset(cb) as int
    let delta1 = (b_ret_pos - fixup_b_ret) as int
    let imm19_1 = (delta1 shr 2) and 0x7FFFF
    codebuf_patch_u32(cb, fixup_b_ret, (0x54000000 or (imm19_1 shl 5)) as int)

    let delta2 = (b_ret_pos - fixup_b_ret2) as int
    let imm19_2 = (delta2 shr 2) and 0x7FFFF
    codebuf_patch_u32(cb, fixup_b_ret2, (0x54000000 or (imm19_2 shl 5)) as int)

    out arm64_ret(cb)
end.

func emit_lir_rt_stubs(cb: &CodeBuf, offs: i64, is_linux: i64, vir_free_off: i64, rt_promote_graph_off: i64):
    var k = 0
    when k < LIR_RT_STUB_COUNT loop
        offs = vec_push_rt(offs, codebuf_offset(cb) as i64)
        if k == LIR_RT_UNRESOLVED do
            cb = arm64_brk(cb, 1)
        eif k == MIR_INTR_PRINT do
            cb = emit_lir_rt_print_stub(cb, is_linux)
        eif k == LIR_RT_NATIVE_READ_U8 do
            cb = emit_lir_rt_read_u8_stub(cb)
        eif k == LIR_RT_NATIVE_WRITE_U8 do
            cb = emit_lir_rt_write_u8_stub(cb)
        eif k == LIR_RT_NATIVE_READ_I64 do
            cb = emit_lir_rt_read_i64_stub(cb)
        eif k == LIR_RT_NATIVE_WRITE_I64 do
            cb = emit_lir_rt_write_i64_stub(cb)
        eif k == LIR_RT_POW do
            # Negative exponent: exponentiation-by-squaring in binary64.
            # Wrapping negation leaves INT64_MIN as the unsigned magnitude
            # 2^63, and logical shifts still terminate after 64 iterations.
            cb = arm64_cmp_imm0(cb, 1)
            pow_positive_fixup = codebuf_offset(cb)
            cb = arm64_bge_imm19(cb, 0)
            cb = arm64_sub_rrr(cb, 1, 31, 1)
            cb = arm64_mov_rr(cb, 2, 0)
            cb = arm64_scvtf_dx(cb, 1, 2)
            cb = arm64_movz_imm64(cb, 3, 4607182418800017408)
            cb = arm64_fmov_dx(cb, 0, 3)
            pow_neg_loop = codebuf_offset(cb)
            cb = arm64_mov_imm16(cb, 4, 1)
            cb = arm64_and_rrr(cb, 4, 1, 4)
            cb = arm64_cmp_imm0(cb, 4)
            cb = arm64_beq_imm19(cb, 8)
            cb = arm64_fmul_ddd(cb, 0, 0, 1)
            cb = arm64_fmul_ddd(cb, 1, 1, 1)
            cb = arm64_lsr_imm(cb, 1, 1, 1)
            cb = arm64_cbnz_imm19(cb, 1, pow_neg_loop - codebuf_offset(cb))
            cb = arm64_movz_imm64(cb, 3, 4607182418800017408)
            cb = arm64_fmov_dx(cb, 1, 3)
            cb = arm64_fdiv_ddd(cb, 0, 1, 0)
            cb = arm64_fmov_xd(cb, 0, 0)
            cb = arm64_ret(cb)
            pow_positive_at = codebuf_offset(cb)
            pow_positive_imm = ((pow_positive_at - pow_positive_fixup) shr 2) and 0x7FFFF
            cb = codebuf_patch_u32(cb, pow_positive_fixup, (0x5400000A or (pow_positive_imm shl 5)) as int)
            cb = arm64_mov_rr(cb, 2, 0)
            cb = arm64_mov_imm16(cb, 0, 1)
            cb = arm64_cbz_imm19(cb, 1, 16)
            cb = arm64_mul_rrr(cb, 0, 0, 2)
            cb = arm64_sub_imm(cb, 1, 1, 1)
            cb = arm64_b_imm26(cb, 0 - 12)
            cb = arm64_ret(cb)
        eif k == LIR_RT_MATMUL do
            cb = emit_lir_rt_matmul_stub(cb)
        eif k == LIR_RT_FMA do
            cb = emit_lir_rt_fma_stub(cb)
        eif k == LIR_RT_PROMOTE_GRAPH do
            if rt_promote_graph_off >= 0 do
                let pg_target = codebuf_offset(cb) as i64
                let pg_rel = rt_promote_graph_off - pg_target
                cb = arm64_b_imm26(cb, pg_rel as int)
            else
                cb = emit_lir_rt_promote_stub(cb)
            end
        eif k == LIR_RT_ALLOC do
            cb = emit_lir_rt_alloc_stub(cb, is_linux)
            cb = arm64_ret(cb)
        eif k == LIR_RT_FREE do
            cb = emit_lir_rt_free_stub(cb, vir_free_off)
        eif k == LIR_RT_PRINT_STR do
            cb = emit_lir_rt_print_str_stub(cb, is_linux)
        eif k == LIR_RT_PRINT_FLOAT do
            cb = emit_lir_rt_print_float_stub(cb, is_linux)
        eif k == LIR_RT_PRINT_BOOL do
            cb = emit_lir_rt_print_bool_stub(cb, is_linux)
        eif k == LIR_RT_GET_ARG do
            cb = emit_lir_rt_get_arg_stub(cb)
        eif k == LIR_RT_ARG_COUNT do
            cb = emit_lir_rt_arg_count_stub(cb)
        eif k == LIR_RT_VOLATILE_READ do
            cb = emit_lir_rt_volatile_read_stub(cb)
        eif k == LIR_RT_VOLATILE_WRITE do
            cb = emit_lir_rt_volatile_write_stub(cb)
        eif k == LIR_RT_VOLATILE_READ8 do
            cb = emit_lir_rt_volatile_read8_stub(cb)
        eif k == LIR_RT_VOLATILE_WRITE8 do
            cb = emit_lir_rt_volatile_write8_stub(cb)
        eif k == LIR_RT_DMB do
            cb = arm64_dmb_sy(cb)
            cb = arm64_ret(cb)
        eif k == LIR_RT_DSB do
            cb = arm64_dsb_sy(cb)
            cb = arm64_ret(cb)
        eif k == LIR_RT_ISB do
            cb = arm64_isb(cb)
            cb = arm64_ret(cb)
        eif k == LIR_RT_WFI do
            cb = arm64_wfi(cb)
            cb = arm64_ret(cb)
        eif k == LIR_RT_WFE do
            cb = arm64_wfe(cb)
            cb = arm64_ret(cb)
        eif k == LIR_RT_SEV do
            cb = arm64_sev(cb)
            cb = arm64_ret(cb)
        eif k == LIR_RT_NOP do
            cb = arm64_nop(cb)
            cb = arm64_ret(cb)
        eif k == LIR_RT_ATOMIC_LOAD32 do
            cb = emit_lir_rt_atomic_load32_stub(cb)
        eif k == LIR_RT_ATOMIC_STORE32 do
            cb = emit_lir_rt_atomic_store32_stub(cb)
        eif k == LIR_RT_ATOMIC_ADD32 do
            cb = emit_lir_rt_atomic_add32_stub(cb)
        eif k == LIR_RT_ATOMIC_SUB32 do
            cb = emit_lir_rt_atomic_sub32_stub(cb)
        eif k == LIR_RT_ATOMIC_CAS32 do
            cb = emit_lir_rt_atomic_cas32_stub(cb)
        eif k == LIR_RT_ATOMIC_EXCHANGE32 do
            cb = emit_lir_rt_atomic_exchange32_stub(cb)
        eif k == LIR_RT_ATOMIC_LOAD64 do
            cb = emit_lir_rt_atomic_load64_stub(cb)
        eif k == LIR_RT_ATOMIC_STORE64 do
            cb = emit_lir_rt_atomic_store64_stub(cb)
        eif k == LIR_RT_ATOMIC_ADD64 do
            cb = emit_lir_rt_atomic_add64_stub(cb)
        eif k == LIR_RT_ATOMIC_SUB64 do
            cb = emit_lir_rt_atomic_sub64_stub(cb)
        eif k == LIR_RT_ATOMIC_CAS64 do
            cb = emit_lir_rt_atomic_cas64_stub(cb)
        eif k == LIR_RT_ATOMIC_EXCHANGE64 do
            cb = emit_lir_rt_atomic_exchange64_stub(cb)
        eif k == LIR_RT_STR_LEN do
            cb = emit_lir_rt_str_len_stub(cb)
        eif k == LIR_RT_STR_CAT do
            cb = emit_lir_rt_str_cat_stub(cb)
        eif k == LIR_RT_STR_EQ do
            cb = emit_lir_rt_str_eq_stub(cb)
        eif k == LIR_RT_WRITE_BYTES do
            cb = emit_lir_rt_write_bytes_stub(cb, is_linux)
        eif k == LIR_RT_SLURP_LEN do
            cb = emit_lir_rt_slurp_len_stub(cb, is_linux)
        eif k == LIR_RT_SLURP_FILE do
            cb = emit_lir_rt_slurp_file_stub(cb, is_linux)
        eif k == LIR_RT_INT_TO_STR do
            cb = emit_lir_rt_int_to_str_stub(cb)
        eif k == LIR_RT_BOOL_TO_STR do
            cb = emit_lir_rt_bool_to_str_stub(cb)
        eif k == LIR_RT_SYSCALL do
            cb = emit_lir_rt_syscall_stub(cb, is_linux)
        eif k == LIR_RT_PORT_CREATE do
            cb = emit_lir_rt_port_create_stub(cb)
        eif k == LIR_RT_PORT_SEND do
            cb = emit_lir_rt_port_send_stub(cb)
        eif k == LIR_RT_PORT_RECV do
            cb = emit_lir_rt_port_recv_stub(cb)
        eif k == LIR_RT_ARR_NEW do
            cb = emit_lir_rt_arr_new_stub(cb)
        eif k == LIR_RT_ARR_PUSH do
            cb = emit_lir_rt_arr_push_stub(cb)
        eif k == LIR_RT_ARR_LEN do
            cb = emit_lir_rt_arr_len_stub(cb)
        eif k == LIR_RT_EXIT_PROG do
            cb = emit_lir_rt_exit_stub(cb, is_linux)
        eif k == LIR_RT_QUANTIZE do
            cb = emit_lir_rt_quantize_stub(cb)
        eif k == LIR_RT_BACKWARD do
            cb = emit_lir_rt_backward_stub(cb)
        eif k == LIR_RT_MATMUL_F64 do
            cb = emit_lir_rt_matmul_f64_stub(cb)
        eif k == LIR_RT_FMA_F64 do
            cb = emit_lir_rt_fma_f64_stub(cb)
        eif k == LIR_RT_PLATFORM do
            if is_linux == 1 do
                cb = arm64_movz_imm64(cb, 0, 2) # Platform.Linux_ARM64
            else
                cb = arm64_movz_imm64(cb, 0, 0) # Platform.MacOS_ARM64
            end
            cb = arm64_ret(cb)
        else
            cb = arm64_ret(cb)
        end
        k = k + 1
    end
    out cb
end.

func emit_callee_save(cb: &CodeBuf, max_phys: i64):
    # X19 is reserved for erx and intentionally crosses call boundaries.
    if max_phys >= 20 do
        cb = arm64_stp_pre(cb, 20, 21, 31, 0 - 16)
    end
    if max_phys >= 22 do
        cb = arm64_stp_pre(cb, 22, 23, 31, 0 - 16)
    end
    if max_phys >= 24 do
        cb = arm64_stp_pre(cb, 24, 25, 31, 0 - 16)
    end
    if max_phys >= 26 do
        cb = arm64_stp_pre(cb, 26, 27, 31, 0 - 16)
    end
    out cb
end.

func emit_callee_restore(cb: &CodeBuf, max_phys: i64):
    if max_phys >= 26 do
        cb = arm64_ldp_post(cb, 26, 27, 31, 16)
    end
    if max_phys >= 24 do
        cb = arm64_ldp_post(cb, 24, 25, 31, 16)
    end
    if max_phys >= 22 do
        cb = arm64_ldp_post(cb, 22, 23, 31, 16)
    end
    if max_phys >= 20 do
        cb = arm64_ldp_post(cb, 20, 21, 31, 16)
    end
    out cb
end.

func arm64_sub_sp_reg(cb: &CodeBuf, rm: int):
    # sub sp, sp, Xm (extended register: sf=1, S=0, opt=011 (UXTX), Rm in 20:16, Rn=31, Rd=31)
    instr = 0xCB206000 or ((rm and 0x1F) shl 16) or (31 shl 5) or 31
    out codebuf_emit_u32(cb, instr)
end.

func arm64_add_sp_reg(cb: &CodeBuf, rm: int):
    # add sp, sp, Xm (extended register: sf=1, S=0, opt=011 (UXTX), Rm in 20:16, Rn=31, Rd=31)
    instr = 0x8B206000 or ((rm and 0x1F) shl 16) or (31 shl 5) or 31
    out codebuf_emit_u32(cb, instr)
end.

func emit_stack_alloc_arm64(cb: &CodeBuf, stack_size: i64):
    if stack_size <= 0 do out cb end
    if stack_size <= 4095 do
        out arm64_sub_imm(cb, 31, 31, stack_size as int)
    end
    cb = arm64_movz_imm64(cb, 16, stack_size as int)
    out arm64_sub_sp_reg(cb, 16)
end.

func emit_stack_free_arm64(cb: &CodeBuf, stack_size: i64):
    if stack_size <= 0 do out cb end
    if stack_size <= 4095 do
        out arm64_add_imm(cb, 31, 31, stack_size as int)
    end
    cb = arm64_movz_imm64(cb, 16, stack_size as int)
    out arm64_add_sp_reg(cb, 16)
end.

func lir_func_calc_max_phys(func_obj: &LirFunc, assigned_phys: i64):
    f_blocks = native_read_i64(func_obj as i64, 16)
    n_blocks = vec_len_rt(f_blocks)
    var max_phys = 0
    var bi_sc = 0
    when bi_sc < n_blocks loop
        let b_sc = vec_get_rt(f_blocks, bi_sc)
        let instrs_sc = native_read_i64(b_sc as i64, 8)
        let n_ins_sc = vec_len_rt(instrs_sc)
        var ii_sc = 0
        when ii_sc < n_ins_sc loop
            let ins_sc = vec_get_rt(instrs_sc, ii_sc)
            if ins_sc != 0 do
                let d_sc = native_read_i64(ins_sc as i64, 16)
                let s1_sc = native_read_i64(ins_sc as i64, 24)
                let s2_sc = native_read_i64(ins_sc as i64, 32)
                if d_sc != 0 do
                    typ_d = native_read_i64(d_sc, 0)
                    if typ_d == 3 do # PhysReg
                        vr = native_read_i64(d_sc, 16)
                        if vr >= 19 and vr <= 28 and vr > max_phys do max_phys = vr end
                    eif typ_d == 1 or typ_d == 2 do
                        vid = native_read_i64(d_sc, 8)
                        if assigned_phys != 0 and vid >= 0 and vid < vec_len_rt(assigned_phys) do
                            col = vec_get_rt(assigned_phys, vid)
                            if col >= 0 and col < 8 do
                                vr = 20 + col
                                if vr > max_phys do max_phys = vr end
                            end
                        end
                    end
                end
                if s1_sc != 0 do
                    typ_s1 = native_read_i64(s1_sc, 0)
                    if typ_s1 == 3 do # PhysReg
                        vr = native_read_i64(s1_sc, 16)
                        if vr >= 19 and vr <= 28 and vr > max_phys do max_phys = vr end
                    eif typ_s1 == 1 or typ_s1 == 2 do
                        vid = native_read_i64(s1_sc, 8)
                        if assigned_phys != 0 and vid >= 0 and vid < vec_len_rt(assigned_phys) do
                            col = vec_get_rt(assigned_phys, vid)
                            if col >= 0 and col < 8 do
                                vr = 20 + col
                                if vr > max_phys do max_phys = vr end
                            end
                        end
                    end
                end
                if s2_sc != 0 do
                    typ_s2 = native_read_i64(s2_sc, 0)
                    if typ_s2 == 3 do # PhysReg
                        vr = native_read_i64(s2_sc, 16)
                        if vr >= 19 and vr <= 28 and vr > max_phys do max_phys = vr end
                    eif typ_s2 == 1 or typ_s2 == 2 do
                        vid = native_read_i64(s2_sc, 8)
                        if assigned_phys != 0 and vid >= 0 and vid < vec_len_rt(assigned_phys) do
                            col = vec_get_rt(assigned_phys, vid)
                            if col >= 0 and col < 8 do
                                vr = 20 + col
                                if vr > max_phys do max_phys = vr end
                            end
                        end
                    end
                end
            end
            ii_sc = ii_sc + 1
        end
        bi_sc = bi_sc + 1
    end
    out max_phys
end.

func lir_opnd_required_stack_size(opnd: i64):
    off = lir_opnd_spill_off(opnd)
    if off < 0 do
        out 0 - off
    end
    out 0
end.

func lir_func_required_stack_size(func_obj: &LirFunc):
    var needed = lir_func_stack_size(func_obj)
    f_blocks = native_read_i64(func_obj as i64, 16)
    n_blocks = vec_len_rt(f_blocks)
    var bi_req = 0
    when bi_req < n_blocks loop
        b_req = vec_get_rt(f_blocks, bi_req)
        instrs_req = native_read_i64(b_req as i64, 8)
        n_req = vec_len_rt(instrs_req)
        var ii_req = 0
        when ii_req < n_req loop
            ins_req = vec_get_rt(instrs_req, ii_req)
            if ins_req != 0 do
                d_need = lir_opnd_required_stack_size(native_read_i64(ins_req as i64, 16))
                if d_need > needed do needed = d_need end
                s1_need = lir_opnd_required_stack_size(native_read_i64(ins_req as i64, 24))
                if s1_need > needed do needed = s1_need end
                s2_need = lir_opnd_required_stack_size(native_read_i64(ins_req as i64, 32))
                if s2_need > needed do needed = s2_need end
            end
            ii_req = ii_req + 1
        end
        bi_req = bi_req + 1
    end
    if (needed mod 16) != 0 do
        needed = needed + (16 - (needed mod 16))
    end
    out needed
end.

