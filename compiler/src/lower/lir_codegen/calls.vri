##
 * compiler/src/lower/lir_codegen/calls.vri — Function Calls & Print/Alloc Stubs
 * =============================================================================
 ##

include types_prelude
include rt_vec_rt
include rt_string_rt
include codegen
include target
include lir_codegen_types
include lir_codegen_intrinsics

func emit_lir_call(cb: &CodeBuf, ins: LirInstr, rd: i64, func_obj: &LirFunc, lir_funcs: i64, call_fixups: i64, pending_stk: i64, assigned_phys: i64):
    sid = native_read_i64(ins as i64, 40)
    ins_src2 = native_read_i64(ins as i64, 32) as LirOperand
    is_dynamic = 0
    if sid < 0 do
        is_dynamic = 1
    eif (ins_src2 as i64) != 0 do
        s2_typ = native_read_i64(ins_src2 as i64, 0)
        if s2_typ == (LirOperandType.VRegInt as i64) or s2_typ == (LirOperandType.PhysReg as i64) do
            is_dynamic = 1
        end
    end
    if is_dynamic == 1 do
        if (ins_src2 as i64) == 0 do
            print_str("virc: linker error: unresolved dynamic function call: missing target operand\n")
            sys_exit(1)
        end
        var (cb_dyn, r_target) = lir_load_opnd_to_reg(cb, ins_src2 as i64, assigned_phys, 16)
        cb = cb_dyn
        if r_target >= 0 do
            cb = arm64_blr(cb, r_target as int)
        else
            cb = arm64_blr(cb, 16)
        end
        if rd >= 0 do
            if rd != 0 do
                cb = arm64_mov_rr(cb, rd as int, 0)
            end
        end
    else
        target_kind = 0 - 1
        target_id = 0 - 1
        var cname = fat_str_new("")
        f_strings = native_read_i64(func_obj as i64, 32)
        if f_strings > 0 and sid >= 0 and sid < vec_len_rt(f_strings) do
            cname = vec_get_rt(f_strings, sid)
            fi = lir_find_func_index(lir_funcs, cname)
            if fi >= 0 do
                target_kind = 0
                target_id = fi
            else
                stub_id = lir_stub_for_callee_name(cname)
                if stub_id >= 0 do
                    target_kind = 1
                    target_id = stub_id
                else
                    ffi_id = ffi_import_find(cname)
                    if ffi_id >= 0 do
                        # 3 = object-format foreign-import stub.
                        target_kind = 3
                        target_id = ffi_id
                        ffi_import_mark_used(ffi_id as int)
                    end
                end
            end
        end
        if target_id < 0 or (target_kind == 1 and target_id == LIR_RT_UNRESOLVED) do
            print_str("virc: linker error: unresolved direct function call: ")
            if (cname as i64) != 0 do
                if (cname as i64) >= 4096 do
                    print_str(native_read_i64(cname as i64, 0))
                else
                    print_str(cname as string)
                end
            end
            print_str("\n")
            sys_exit(1)
        end
        if target_kind == 3 and (fat_cstr_eq(ffi_import_return_type(target_id), "float") == 1 or fat_cstr_eq(ffi_import_return_type(target_id), "f64") == 1) do
            cb = emit_bl_fixup(cb, call_fixups, target_kind, target_id, 0 - 1)
            cb = arm64_fmov_xd(cb, 0, 0)
            if rd >= 0 and rd != 0 do cb = arm64_mov_rr(cb, rd as int, 0) end
        else
            cb = emit_bl_fixup(cb, call_fixups, target_kind, target_id, rd)
        end
    end
    # A call result can be allocated directly to a stack slot.  The generic
    # call emitter only moves X0 for physical-register destinations, so keep
    # the return value when register pressure spills the destination.
    var call_dst = native_read_i64(ins as i64, 16) as LirOperand
    if rd < 0 do
        if (call_dst as i64) != 0 do
            if native_read_i64(call_dst as i64, 0) == (LirOperandType.StackMem as i64) do
                cb = emit_spill_store(cb, call_dst as i64, 0)
            end
        end
    end
    if pending_stk > 0 do
        bytes = pending_stk * 16
        if bytes <= 4095 do
            cb = arm64_add_imm(cb, 31, 31, bytes as int)
        end
    end
    out (cb, 0)
end.

func emit_lir_rt_print_stub(cb: &CodeBuf, is_linux: i64):
    cb = arm64_sub_imm(cb, 31, 31, 128)
    cb = arm64_str_uoff(cb, 1, 31, 0)
    cb = arm64_str_uoff(cb, 2, 31, 8)
    cb = arm64_str_uoff(cb, 3, 31, 16)
    cb = arm64_str_uoff(cb, 4, 31, 24)
    cb = arm64_str_uoff(cb, 5, 31, 32)
    cb = arm64_str_uoff(cb, 6, 31, 40)
    cb = arm64_str_uoff(cb, 16, 31, 48)

    cb = arm64_mov_imm16(cb, 2, 10)
    cb = arm64_mov_imm16(cb, 3, 10)
    cb = arm64_strb_uoff(cb, 2, 31, 127)

    cb = arm64_cmp_imm0(cb, 0)
    cb = arm64_bne_imm19(cb, 28)
    cb = arm64_mov_imm16(cb, 2, 48)
    cb = arm64_strb_uoff(cb, 2, 31, 126)
    cb = arm64_mov_imm16(cb, 0, 1)
    cb = arm64_add_imm(cb, 1, 31, 126)
    cb = arm64_mov_imm16(cb, 2, 2)
    cb = arm64_b_imm26(cb, 104)

    cb = arm64_add_imm(cb, 1, 31, 127)
    cb = arm64_cmp_imm0(cb, 0)
    cb = arm64_cset_lt(cb, 4)
    cb = arm64_cmp_imm0(cb, 4)
    cb = arm64_beq_imm19(cb, 8)
    cb = arm64_sub_rrr(cb, 0, 31, 0)

    loop_top = codebuf_offset(cb)
    cb = arm64_udiv_rrr(cb, 5, 0, 3)
    cb = arm64_msub_rrrr(cb, 6, 5, 3, 0)
    cb = arm64_add_imm(cb, 6, 6, 48)
    cb = arm64_sub_imm(cb, 1, 1, 1)
    cb = arm64_strb_uoff(cb, 6, 1, 0)
    cb = arm64_mov_rr(cb, 0, 5)
    cb = arm64_cmp_imm0(cb, 0)
    delta = (loop_top - codebuf_offset(cb)) as int
    cb = arm64_bne_imm19(cb, delta)

    cb = arm64_cmp_imm0(cb, 4)
    cb = arm64_beq_imm19(cb, 16)
    cb = arm64_mov_imm16(cb, 6, 45)
    cb = arm64_sub_imm(cb, 1, 1, 1)
    cb = arm64_strb_uoff(cb, 6, 1, 0)

    cb = arm64_mov_rr(cb, 2, 1)
    cb = arm64_add_imm(cb, 5, 31, 128)
    cb = arm64_sub_rrr(cb, 3, 5, 1)

    cb = arm64_mov_imm16(cb, 0, 1)
    cb = arm64_mov_rr(cb, 1, 2)
    cb = arm64_mov_rr(cb, 2, 3)
    if is_linux == 1 do
        cb = arm64_mov_imm16(cb, 8, 64)
        cb = arm64_svc(cb, 0)
    else
        cb = arm64_mov_imm16(cb, 16, 4)
        cb = codebuf_emit_u32(cb, 0xF2A04010)
        cb = arm64_svc(cb, 0x80)
    end

    cb = arm64_ldr_uoff(cb, 1, 31, 0)
    cb = arm64_ldr_uoff(cb, 2, 31, 8)
    cb = arm64_ldr_uoff(cb, 3, 31, 16)
    cb = arm64_ldr_uoff(cb, 4, 31, 24)
    cb = arm64_ldr_uoff(cb, 5, 31, 32)
    cb = arm64_ldr_uoff(cb, 6, 31, 40)
    cb = arm64_ldr_uoff(cb, 16, 31, 48)
    cb = arm64_add_imm(cb, 31, 31, 128)
    out arm64_ret(cb)
end.

func emit_lir_rt_print_bool_stub(cb: &CodeBuf, is_linux: i64):
    cb = arm64_sub_imm(cb, 31, 31, 32)
    cb = arm64_str_uoff(cb, 19, 31, 0)
    cb = arm64_str_uoff(cb, 30, 31, 8)

    cb = arm64_cmp_imm0(cb, 0)
    let fixup_true = codebuf_offset(cb)
    cb = arm64_bne_imm19(cb, 0)

    # False case: store "false\n" (11430844457318)
    cb = arm64_movz_imm64(cb, 1, 11430844457318)
    cb = arm64_str_uoff(cb, 1, 31, 16)
    cb = arm64_mov_imm16(cb, 2, 6)
    let fixup_after = codebuf_offset(cb)
    cb = arm64_b_imm26(cb, 0)

    # True case: store "true\n" (44651868788)
    let true_start = codebuf_offset(cb)
    cb = arm64_movz_imm64(cb, 1, 44651868788)
    cb = arm64_str_uoff(cb, 1, 31, 16)
    cb = arm64_mov_imm16(cb, 2, 5)

    let after_start = codebuf_offset(cb)
    let delta_true = (true_start - fixup_true) as int
    let imm19_t = (delta_true shr 2) and 0x7FFFF
    cb = codebuf_patch_u32(cb, fixup_true, (0x54000001 or (imm19_t shl 5)) as int)
    let delta_after = (after_start - fixup_after) as int
    let imm26_a = (delta_after shr 2) and 0x3FFFFFF
    cb = codebuf_patch_u32(cb, fixup_after, (0x14000000 or imm26_a) as int)

    # Syscall write(1, sp + 16, len)
    cb = arm64_mov_imm16(cb, 0, 1)
    cb = arm64_add_imm(cb, 1, 31, 16)
    if is_linux == 1 do
        cb = arm64_mov_imm16(cb, 8, 64)
        cb = arm64_svc(cb, 0)
    else
        cb = arm64_mov_imm16(cb, 16, 4)
        cb = codebuf_emit_u32(cb, 0xF2A04010)
        cb = arm64_svc(cb, 0x80)
    end

    cb = arm64_ldr_uoff(cb, 19, 31, 0)
    cb = arm64_ldr_uoff(cb, 30, 31, 8)
    cb = arm64_add_imm(cb, 31, 31, 32)
    out arm64_ret(cb)
end.

func emit_lir_rt_print_float_stub(cb: &CodeBuf, is_linux: i64):
    cb = arm64_sub_imm(cb, 31, 31, 128)
    cb = arm64_str_uoff(cb, 30, 31, 0)

    # Output pointer x10 = sp + 48
    cb = arm64_add_imm(cb, 10, 31, 48)

    # Check sign bit: x0 < 0
    cb = arm64_cmp_imm0(cb, 0)
    let fixup_sign = codebuf_offset(cb)
    cb = arm64_bge_imm19(cb, 0)

    # Negative case: output '-' and clear sign bit
    cb = arm64_mov_imm16(cb, 6, 45)
    cb = arm64_strb_uoff(cb, 6, 10, 0)
    cb = arm64_add_imm(cb, 10, 10, 1)
    cb = arm64_lsl_imm(cb, 0, 0, 1)
    cb = arm64_lsr_imm(cb, 0, 0, 1)

    let sign_done = codebuf_offset(cb)
    let delta_sign = (sign_done - fixup_sign) as int
    let imm19_s = (delta_sign shr 2) and 0x7FFFF
    cb = codebuf_patch_u32(cb, fixup_sign, (0x5400000A or (imm19_s shl 5)) as int)

    # Convert to float d0, truncate integer part to x1
    cb = arm64_fmov_dx(cb, 0, 0)
    cb = arm64_fcvtzs_xd(cb, 1, 0)
    cb = arm64_scvtf_dx(cb, 1, 1)
    cb = arm64_fsub_ddd(cb, 0, 0, 1)

    # Output integer part in x1
    cb = arm64_cmp_imm0(cb, 1)
    let fixup_int_zero = codebuf_offset(cb)
    cb = arm64_bne_imm19(cb, 0)

    # x1 == 0
    cb = arm64_mov_imm16(cb, 6, 48)
    cb = arm64_strb_uoff(cb, 6, 10, 0)
    cb = arm64_add_imm(cb, 10, 10, 1)
    let fixup_int_done = codebuf_offset(cb)
    cb = arm64_b_imm26(cb, 0)

    # x1 != 0: divide by 10 into scratch buffer backwards
    let int_nonzero_start = codebuf_offset(cb)
    cb = arm64_mov_imm16(cb, 3, 10)
    cb = arm64_add_imm(cb, 4, 31, 48)
    let int_loop_top = codebuf_offset(cb)
    cb = arm64_udiv_rrr(cb, 5, 1, 3)
    cb = arm64_msub_rrrr(cb, 6, 5, 3, 1)
    cb = arm64_add_imm(cb, 6, 6, 48)
    cb = arm64_sub_imm(cb, 4, 4, 1)
    cb = arm64_strb_uoff(cb, 6, 4, 0)
    cb = arm64_mov_rr(cb, 1, 5)
    cb = arm64_cmp_imm0(cb, 1)
    let int_loop_delta = (int_loop_top - codebuf_offset(cb)) as int
    cb = arm64_bne_imm19(cb, int_loop_delta)

    # Copy digits from scratch buffer [x4 .. sp+48) to [x10]
    cb = arm64_add_imm(cb, 5, 31, 48)
    let copy_loop_top = codebuf_offset(cb)
    cb = arm64_ldrb_uoff(cb, 6, 4, 0)
    cb = arm64_strb_uoff(cb, 6, 10, 0)
    cb = arm64_add_imm(cb, 4, 4, 1)
    cb = arm64_add_imm(cb, 10, 10, 1)
    cb = arm64_cmp_rr(cb, 4, 5)
    let copy_delta = (copy_loop_top - codebuf_offset(cb)) as int
    cb = arm64_bne_imm19(cb, copy_delta)

    let int_done = codebuf_offset(cb)
    let delta_iz = (int_nonzero_start - fixup_int_zero) as int
    cb = codebuf_patch_u32(cb, fixup_int_zero, (0x54000001 or (((delta_iz shr 2) and 0x7FFFF) shl 5)) as int)
    let delta_id = (int_done - fixup_int_done) as int
    cb = codebuf_patch_u32(cb, fixup_int_done, (0x14000000 or (((delta_id shr 2) and 0x3FFFFFF))) as int)

    # Output decimal point '.' (46)
    cb = arm64_mov_imm16(cb, 6, 46)
    cb = arm64_strb_uoff(cb, 6, 10, 0)
    cb = arm64_add_imm(cb, 10, 10, 1)

    # Format fractional part in d0
    cb = arm64_mov_imm16(cb, 6, 10)
    cb = arm64_scvtf_dx(cb, 2, 6)
    cb = arm64_mov_imm16(cb, 6, 0)
    cb = arm64_scvtf_dx(cb, 3, 6)
    cb = arm64_mov_imm16(cb, 7, 0)

    let frac_loop_top = codebuf_offset(cb)
    cb = arm64_fmul_ddd(cb, 0, 0, 2)
    cb = arm64_fcvtzs_xd(cb, 6, 0)
    cb = arm64_scvtf_dx(cb, 1, 6)
    cb = arm64_fsub_ddd(cb, 0, 0, 1)
    cb = arm64_add_imm(cb, 6, 6, 48)
    cb = arm64_strb_uoff(cb, 6, 10, 0)
    cb = arm64_add_imm(cb, 10, 10, 1)
    cb = arm64_add_imm(cb, 7, 7, 1)
    cb = arm64_fcmp_dd(cb, 0, 3)
    let fixup_frac_zero = codebuf_offset(cb)
    cb = arm64_beq_imm19(cb, 0)
    cb = arm64_cmp_imm(cb, 7, 9)
    let frac_delta = (frac_loop_top - codebuf_offset(cb)) as int
    cb = arm64_blt_imm19(cb, frac_delta)

    let frac_done = codebuf_offset(cb)
    let delta_fz = (frac_done - fixup_frac_zero) as int
    cb = codebuf_patch_u32(cb, fixup_frac_zero, (0x54000000 or (((delta_fz shr 2) and 0x7FFFF) shl 5)) as int)

    # Output newline '\n' (10)
    cb = arm64_mov_imm16(cb, 6, 10)
    cb = arm64_strb_uoff(cb, 6, 10, 0)
    cb = arm64_add_imm(cb, 10, 10, 1)

    # Write syscall(1, sp + 48, x10 - (sp + 48))
    cb = arm64_add_imm(cb, 1, 31, 48)
    cb = arm64_sub_rrr(cb, 2, 10, 1)
    cb = arm64_mov_imm16(cb, 0, 1)
    if is_linux == 1 do
        cb = arm64_mov_imm16(cb, 8, 64)
        cb = arm64_svc(cb, 0)
    else
        cb = arm64_mov_imm16(cb, 16, 4)
        cb = codebuf_emit_u32(cb, 0xF2A04010)
        cb = arm64_svc(cb, 0x80)
    end

    cb = arm64_ldr_uoff(cb, 30, 31, 0)
    cb = arm64_add_imm(cb, 31, 31, 128)
    out arm64_ret(cb)
end.

func emit_lir_rt_print_str_stub(cb: &CodeBuf, is_linux: i64):
    cb = arm64_sub_imm(cb, 31, 31, 32)
    cb = arm64_str_uoff(cb, 19, 31, 0)
    cb = arm64_str_uoff(cb, 20, 31, 8)
    cb = arm64_str_uoff(cb, 30, 31, 16)

    cb = arm64_mov_rr(cb, 19, 0)
    cb = arm64_mov_rr(cb, 20, 0)

    len_loop = codebuf_offset(cb)
    cb = arm64_ldrb_uoff(cb, 0, 20, 0)
    cb = arm64_cmp_imm0(cb, 0)
    cb = arm64_beq_imm19(cb, 12)
    cb = arm64_add_imm(cb, 20, 20, 1)
    delta = (len_loop - codebuf_offset(cb)) as int
    cb = arm64_b_imm26(cb, delta)

    cb = arm64_sub_rrr(cb, 2, 20, 19)

    cb = arm64_cmp_imm0(cb, 2)
    skip_empty_write = 24
    if is_linux == 1 do skip_empty_write = 20 end
    cb = arm64_beq_imm19(cb, skip_empty_write)
    cb = arm64_mov_imm16(cb, 0, 1)
    cb = arm64_mov_rr(cb, 1, 19)
    if is_linux == 1 do
        cb = arm64_mov_imm16(cb, 8, 64)
        cb = arm64_svc(cb, 0)
    else
        cb = arm64_mov_imm16(cb, 16, 4)
        cb = codebuf_emit_u32(cb, 0xF2A04010)
        cb = arm64_svc(cb, 0x80)
    end

    cb = arm64_mov_imm16(cb, 0, 10)
    cb = arm64_strb_uoff(cb, 0, 31, 24)
    cb = arm64_mov_imm16(cb, 0, 1)
    cb = arm64_add_imm(cb, 1, 31, 24)
    cb = arm64_mov_imm16(cb, 2, 1)
    if is_linux == 1 do
        cb = arm64_mov_imm16(cb, 8, 64)
        cb = arm64_svc(cb, 0)
    else
        cb = arm64_mov_imm16(cb, 16, 4)
        cb = codebuf_emit_u32(cb, 0xF2A04010)
        cb = arm64_svc(cb, 0x80)
    end

    cb = arm64_ldr_uoff(cb, 19, 31, 0)
    cb = arm64_ldr_uoff(cb, 20, 31, 8)
    cb = arm64_ldr_uoff(cb, 30, 31, 16)
    cb = arm64_add_imm(cb, 31, 31, 32)
    out arm64_ret(cb)
end.

func emit_lir_rt_read_u8_stub(cb: &CodeBuf):
    cb = arm64_ldrb_reg(cb, 0, 0, 1)
    out arm64_ret(cb)
end.

func emit_lir_rt_write_u8_stub(cb: &CodeBuf):
    cb = arm64_strb_reg(cb, 2, 0, 1)
    out arm64_ret(cb)
end.

func emit_arm64_checked_bump_alloc(cb: &CodeBuf, size_reg: i64, out_reg: i64, is_linux: i64):
    cb = arm64_cmp_imm0(cb, size_reg as int)
    let zero_size_fixup = codebuf_offset(cb) as int
    cb = arm64_beq_imm19(cb, 0)

    cb = arm64_add_imm(cb, 10, size_reg as int, 31)
    cb = arm64_lsr_imm(cb, 10, 10, 4)
    cb = arm64_lsl_imm(cb, 10, 10, 4)
    cb = arm64_ldr_uoff(cb, out_reg as int, 28, 0)
    # X17 is reserved scratch.  `out_reg` can be X12 when the destination is
    # spilled, so using X12 for the next bump would overwrite the returned
    # allocation base before it is stored to the spill slot.
    cb = arm64_add_rrr(cb, 17, out_reg as int, 10)
    cb = arm64_ldr_uoff(cb, 13, 28, 24)
    cb = arm64_cmp_rr(cb, 17, 13)
    let fits_fixup = codebuf_offset(cb) as int
    cb = arm64_ble_imm19(cb, 0)

    cb = arm64_movz_imm64(cb, 6, 0x800000)
    cb = arm64_cmp_rr(cb, 10, 6)
    let keep_chunk_fixup = codebuf_offset(cb) as int
    cb = arm64_ble_imm19(cb, 0)
    cb = arm64_mov_rr(cb, 6, 10)

    let mmap_setup = codebuf_offset(cb) as int
    let imm_keep = ((mmap_setup - keep_chunk_fixup) shr 2) and 0x7FFFF
    cb = codebuf_patch_u32(cb, keep_chunk_fixup, (0x5400000D or (imm_keep shl 5)) as int)

    cb = arm64_mov_imm16(cb, 0, 0)
    cb = arm64_mov_rr(cb, 1, 6)
    cb = arm64_mov_imm16(cb, 2, 3)
    if is_linux == 1 do
        cb = arm64_mov_imm16(cb, 3, 34)
        cb = codebuf_emit_u32(cb, 0x92800004)
        cb = arm64_mov_imm16(cb, 5, 0)
        cb = arm64_mov_imm16(cb, 8, 222)
        cb = arm64_svc(cb, 0)
    else
        cb = arm64_mov_imm16(cb, 3, 4098)
        cb = codebuf_emit_u32(cb, 0x92800004)
        cb = arm64_mov_imm16(cb, 5, 0)
        cb = arm64_mov_imm16(cb, 16, 197)
        cb = codebuf_emit_u32(cb, 0xF2A04010)
        cb = arm64_svc(cb, 0x80)
    end
    cb = arm64_mov_rr(cb, out_reg as int, 0)
    cb = arm64_add_rrr(cb, 17, out_reg as int, 10)
    cb = arm64_add_rrr(cb, 13, out_reg as int, 6)
    cb = arm64_str_uoff(cb, 13, 28, 24)

    let store_bump = codebuf_offset(cb) as int
    let imm_fits = ((store_bump - fits_fixup) shr 2) and 0x7FFFF
    cb = codebuf_patch_u32(cb, fits_fixup, (0x5400000D or (imm_fits shl 5)) as int)

    # Store header: total_size at offset 0, flags (1) at offset 8
    cb = arm64_mov_imm16(cb, 11, 1)
    cb = arm64_stp_off(cb, 10, 11, out_reg as int, 0)

    cb = arm64_str_uoff(cb, 17, 28, 0)
    cb = arm64_add_imm(cb, out_reg as int, out_reg as int, 16)

    let skip_zero_fixup = codebuf_offset(cb) as int
    cb = arm64_b_imm26(cb, 0)

    let zero_off = codebuf_offset(cb) as int
    let imm_z = ((zero_off - zero_size_fixup) shr 2) and 0x7FFFF
    cb = codebuf_patch_u32(cb, zero_size_fixup, (0x54000000 or (imm_z shl 5)) as int)
    cb = arm64_ldr_uoff(cb, out_reg as int, 28, 0)

    let end_off = codebuf_offset(cb) as int
    let imm_sz = ((end_off - skip_zero_fixup) shr 2) and 0x3FFFFFF
    cb = codebuf_patch_u32(cb, skip_zero_fixup, (0x14000000 or imm_sz) as int)
    out cb
end.

func emit_lir_rt_alloc_stub(cb: &CodeBuf, is_linux: i64):
    # X0 = requested size
    cb = arm64_ldr_uoff(cb, 1, 28, 0)      # X1 = *X28 (bump_curr)
    cb = arm64_mov_rr(cb, 2, 1)           # X2 = bump_curr (return pointer)

    cb = arm64_cmp_imm0(cb, 0)
    let zero_size_fixup = codebuf_offset(cb) as int
    cb = arm64_beq_imm19(cb, 0)

    cb = arm64_add_imm(cb, 7, 0, 31)
    cb = arm64_lsr_imm(cb, 7, 7, 4)
    cb = arm64_lsl_imm(cb, 7, 7, 4)
    cb = arm64_add_rrr(cb, 3, 1, 7)       # X3 = next bump

    # Grow by mapping a new chunk when the current arena is exhausted.  This
    # keeps self-host allocations correct without relying on a lucky initial
    # arena size.
    cb = arm64_ldr_uoff(cb, 4, 28, 24)    # X4 = heap_end
    cb = arm64_cmp_rr(cb, 3, 4)
    let fits_fixup = codebuf_offset(cb) as int
    cb = arm64_ble_imm19(cb, 0)

    cb = arm64_movz_imm64(cb, 6, 0x800000) # X6 = minimum grow chunk (8MB)
    cb = arm64_cmp_rr(cb, 7, 6)
    let keep_chunk_fixup = codebuf_offset(cb) as int
    cb = arm64_ble_imm19(cb, 0)
    cb = arm64_mov_rr(cb, 6, 7)           # large allocation: grow by request

    let mmap_setup = codebuf_offset(cb) as int
    let imm_keep = ((mmap_setup - keep_chunk_fixup) shr 2) and 0x7FFFF
    codebuf_patch_u32(cb, keep_chunk_fixup, (0x5400000D or (imm_keep shl 5)) as int)

    cb = arm64_mov_imm16(cb, 0, 0)
    cb = arm64_mov_rr(cb, 1, 6)
    cb = arm64_mov_imm16(cb, 2, 3)
    if is_linux == 1 do
        cb = arm64_mov_imm16(cb, 3, 34)
        cb = codebuf_emit_u32(cb, 0x92800004) # MOVN X4, #0 (-1 fd)
        cb = arm64_mov_imm16(cb, 5, 0)
        cb = arm64_mov_imm16(cb, 8, 222)
        cb = arm64_svc(cb, 0)
    else
        cb = arm64_mov_imm16(cb, 3, 4098)
        cb = codebuf_emit_u32(cb, 0x92800004) # MOVN X4, #0 (-1 fd)
        cb = arm64_mov_imm16(cb, 5, 0)
        cb = arm64_mov_imm16(cb, 16, 197)
        cb = codebuf_emit_u32(cb, 0xF2A04010)
        cb = arm64_svc(cb, 0x80)
    end
    cb = arm64_mov_rr(cb, 2, 0)           # X2 = new chunk base
    cb = arm64_add_rrr(cb, 3, 2, 7)       # X3 = new chunk bump
    cb = arm64_add_rrr(cb, 4, 2, 6)       # X4 = new chunk end
    cb = arm64_str_uoff(cb, 4, 28, 24)

    let store_bump = codebuf_offset(cb) as int
    let imm_fits = ((store_bump - fits_fixup) shr 2) and 0x7FFFF
    codebuf_patch_u32(cb, fits_fixup, (0x5400000D or (imm_fits shl 5)) as int)

    # Store header: total_size at offset 0, flags (1) at offset 8
    cb = arm64_mov_imm16(cb, 5, 1)
    cb = arm64_stp_off(cb, 7, 5, 2, 0)

    cb = arm64_str_uoff(cb, 3, 28, 0)

    cb = arm64_add_imm(cb, 0, 2, 16)      # X0 = return pointer (X2 + 16)
    let ret_normal_fixup = codebuf_offset(cb) as int
    cb = arm64_b_imm26(cb, 0)

    let ret_zero_off = codebuf_offset(cb) as int
    let imm_zero = ((ret_zero_off - zero_size_fixup) shr 2) and 0x7FFFF
    cb = codebuf_patch_u32(cb, zero_size_fixup, (0x54000000 or (imm_zero shl 5)) as int)
    cb = arm64_mov_rr(cb, 0, 1)

    let ret_off = codebuf_offset(cb) as int
    let imm_ret = ((ret_off - ret_normal_fixup) shr 2) and 0x3FFFFFF
    codebuf_patch_u32(cb, ret_normal_fixup, (0x14000000 or imm_ret) as int)
    out arm64_ret(cb)
end.

func emit_lir_rt_free_stub(cb: &CodeBuf, vir_free_off: i64):
    # X0 = pointer to free
    cb = arm64_cmp_imm0(cb, 0)
    let null_fixup = codebuf_offset(cb) as int
    cb = arm64_beq_imm19(cb, 0)

    cb = arm64_cmp_rr(cb, 0, 28)
    let below_arena_fixup = codebuf_offset(cb) as int
    cb = arm64_blt_imm19(cb, 0)

    cb = arm64_ldr_uoff(cb, 3, 28, 0)      # X3 = *X28 (bump_curr)
    cb = arm64_cmp_rr(cb, 0, 3)
    let above_arena_fixup = codebuf_offset(cb) as int
    cb = arm64_bge_imm19(cb, 0)

    cb = arm64_sub_imm(cb, 1, 0, 16)      # X1 = hdr = p - 16
    cb = arm64_ldr_uoff(cb, 2, 1, 0)       # X2 = total_size
    cb = arm64_mov_imm16(cb, 5, 0)
    cb = arm64_str_uoff(cb, 5, 1, 8)       # *(hdr + 8) = 0 (mark free)
    cb = arm64_add_rrr(cb, 4, 1, 2)        # X4 = hdr + total_size
    cb = arm64_cmp_rr(cb, 4, 3)
    let no_rewind_fixup = codebuf_offset(cb) as int
    cb = arm64_bne_imm19(cb, 0)

    cb = arm64_str_uoff(cb, 1, 28, 0)      # *X28 = hdr (rewind!)

    let end_off = codebuf_offset(cb) as int
    let imm_no = ((end_off - no_rewind_fixup) shr 2) and 0x7FFFF
    cb = codebuf_patch_u32(cb, no_rewind_fixup, (0x54000001 or (imm_no shl 5)) as int)

    let null_off = codebuf_offset(cb) as int
    let imm_null = ((null_off - null_fixup) shr 2) and 0x7FFFF
    cb = codebuf_patch_u32(cb, null_fixup, (0x54000000 or (imm_null shl 5)) as int)

    cb = arm64_ret(cb)

    let heap_free_target = codebuf_offset(cb) as int
    if vir_free_off >= 0 do
        let b_rel = vir_free_off - (heap_free_target as i64)
        cb = arm64_b_imm26(cb, b_rel as int)
    else
        # A pointer outside the native bump arena requires the general heap
        # owner. Silently returning here used to turn free into a no-op and
        # hide ownership bugs; fail closed when no vir_free implementation was
        # linked into the program.
        cb = arm64_brk(cb, 3)
    end

    let imm_below = ((heap_free_target - below_arena_fixup) shr 2) and 0x7FFFF
    cb = codebuf_patch_u32(cb, below_arena_fixup, (0x5400000B or (imm_below shl 5)) as int)

    let imm_above = ((heap_free_target - above_arena_fixup) shr 2) and 0x7FFFF
    cb = codebuf_patch_u32(cb, above_arena_fixup, (0x5400000A or (imm_above shl 5)) as int)

    out cb
end.
