##
 * compiler/src/lower/lir_codegen/rt_stubs_math/quantize_backward.vri — quantize and backward runtime stubs
 * VIRC-PLN-0009: extracted verbatim from compiler/src/lower/lir_codegen/rt_stubs_math.vri.
 ##

include types_prelude
include rt_vec_rt
include rt_string_rt
include codegen
include target
include lir_codegen_types
include lir_codegen_intrinsics
include lir_codegen_calls
include lir_codegen_rt_stubs_base

func emit_arm64_quantize_elem_int(cb: &CodeBuf, index_reg: int, out_reg: int):
    # Convert one source element to i64 with truncation toward zero.
    # Integer quantization accepts only finite values whose magnitude is
    # strictly below 2^63; the guard also rejects NaN and infinities before
    # FCVTZS can apply target-specific saturation.
    cb = arm64_add_imm(cb, 6, 0, 16)
    cb = arm64_movz_imm64(cb, 9, 4)
    cb = arm64_cmp_rr(cb, 17, 9)
    cb = arm64_bne_imm19(cb, 0)
    let fix_not4 = (codebuf_offset(cb) - 4) as int

    cb = arm64_ldr_w_reg_lsl2(cb, 10, 6, index_reg)
    cb = arm64_movz_imm64(cb, 11, 0x7FFFFFFF)
    cb = arm64_and_rrr(cb, 10, 10, 11)
    cb = arm64_movz_imm64(cb, 11, 0x5F000000)
    cb = arm64_cmp_rr(cb, 10, 11)
    cb = arm64_bge_imm19(cb, 0)
    let fix_bad4 = (codebuf_offset(cb) - 4) as int
    cb = arm64_ldr_s_reg_lsl2(cb, 0, 6, index_reg)
    cb = arm64_fcvt_ds(cb, 0, 0)
    cb = arm64_fcvtzs_xd(cb, out_reg, 0)
    cb = arm64_b_imm26(cb, 0)
    let fix_done4 = (codebuf_offset(cb) - 4) as int

    let not4_pos = codebuf_offset(cb) as int
    let imm19_not4 = ((not4_pos - fix_not4) shr 2) and 0x7FFFF
    codebuf_patch_u32(cb, fix_not4, (0x54000001 or (imm19_not4 shl 5)) as int)
    cb = arm64_movz_imm64(cb, 9, 2)
    cb = arm64_cmp_rr(cb, 17, 9)
    cb = arm64_bne_imm19(cb, 0)
    let fix_not2 = (codebuf_offset(cb) - 4) as int

    cb = arm64_ldrh_reg_lsl1(cb, 10, 6, index_reg)
    cb = arm64_movz_imm64(cb, 11, 0x7FFF)
    cb = arm64_and_rrr(cb, 10, 10, 11)
    cb = arm64_movz_imm64(cb, 11, 0x7C00)
    cb = arm64_cmp_rr(cb, 10, 11)
    cb = arm64_bge_imm19(cb, 0)
    let fix_bad2 = (codebuf_offset(cb) - 4) as int
    cb = arm64_ldr_h_reg_lsl1(cb, 0, 6, index_reg)
    cb = arm64_fcvt_dh(cb, 0, 0)
    cb = arm64_fcvtzs_xd(cb, out_reg, 0)
    cb = arm64_b_imm26(cb, 0)
    let fix_done2 = (codebuf_offset(cb) - 4) as int

    let not2_pos = codebuf_offset(cb) as int
    let imm19_not2 = ((not2_pos - fix_not2) shr 2) and 0x7FFFF
    codebuf_patch_u32(cb, fix_not2, (0x54000001 or (imm19_not2 shl 5)) as int)
    cb = arm64_ldr_reg_lsl3(cb, 10, 6, index_reg)
    cb = arm64_movz_imm64(cb, 11, 0x7FFFFFFFFFFFFFFF)
    cb = arm64_and_rrr(cb, 10, 10, 11)
    cb = arm64_movz_imm64(cb, 11, 0x43E0000000000000)
    cb = arm64_cmp_rr(cb, 10, 11)
    cb = arm64_bge_imm19(cb, 0)
    let fix_bad8 = (codebuf_offset(cb) - 4) as int
    cb = arm64_ldr_d_reg_lsl3(cb, 0, 6, index_reg)
    cb = arm64_fcvtzs_xd(cb, out_reg, 0)
    cb = arm64_b_imm26(cb, 0)
    let fix_done8 = (codebuf_offset(cb) - 4) as int

    let trap_pos = codebuf_offset(cb) as int
    cb = arm64_brk(cb, 2)
    let done_pos = codebuf_offset(cb) as int

    let imm19_bad4 = ((trap_pos - fix_bad4) shr 2) and 0x7FFFF
    let imm19_bad2 = ((trap_pos - fix_bad2) shr 2) and 0x7FFFF
    let imm19_bad8 = ((trap_pos - fix_bad8) shr 2) and 0x7FFFF
    codebuf_patch_u32(cb, fix_bad4, (0x5400000A or (imm19_bad4 shl 5)) as int)
    codebuf_patch_u32(cb, fix_bad2, (0x5400000A or (imm19_bad2 shl 5)) as int)
    codebuf_patch_u32(cb, fix_bad8, (0x5400000A or (imm19_bad8 shl 5)) as int)

    let imm26_done4 = ((done_pos - fix_done4) shr 2) and 0x03FFFFFF
    let imm26_done2 = ((done_pos - fix_done2) shr 2) and 0x03FFFFFF
    let imm26_done8 = ((done_pos - fix_done8) shr 2) and 0x03FFFFFF
    codebuf_patch_u32(cb, fix_done4, (0x14000000 or imm26_done4) as int)
    codebuf_patch_u32(cb, fix_done2, (0x14000000 or imm26_done2) as int)
    codebuf_patch_u32(cb, fix_done8, (0x14000000 or imm26_done8) as int)
    out cb
end.

func emit_lir_rt_quantize_stub(cb: &CodeBuf):
    # Inputs:
    #   X0 = tensor ptr (offset 0: numel, offset 16: elements)
    #   X1 = bits (4, 8, 16, 32)
    #   X2 = element size in bytes (4 for f32, 8 for f64)
    # Output:
    #   X0 = QuantizedTensor ptr (offset 0: numel, offset 8: bits, offset 16: scale, offset 24: 0, offset 32: packed bytes)

    # 1. elem_sz in X17 (4 for f32, 2 for f16, default 8 for f64)
    cb = arm64_mov_rr(cb, 17, 2)
    cb = arm64_movz_imm64(cb, 9, 4)
    cb = arm64_cmp_rr(cb, 17, 9)
    cb = arm64_beq_imm19(cb, 5 * 4)
    cb = arm64_movz_imm64(cb, 9, 2)
    cb = arm64_cmp_rr(cb, 17, 9)
    cb = arm64_beq_imm19(cb, 2 * 4)
    cb = arm64_movz_imm64(cb, 17, 8)

    # 2. numel in X2
    cb = arm64_ldr_uoff(cb, 2, 0, 0)
    cb = arm64_cmp_imm0(cb, 2)
    cb = arm64_ble_imm19(cb, 0)
    let fixup_ret_zero = (codebuf_offset(cb) - 4) as int

    # 3. Qmax in X3
    cb = arm64_movz_imm64(cb, 3, 127)
    cb = arm64_movz_imm64(cb, 9, 4)
    cb = arm64_cmp_rr(cb, 1, 9)
    cb = arm64_bne_imm19(cb, 2 * 4)
    cb = arm64_movz_imm64(cb, 3, 7)
    cb = arm64_movz_imm64(cb, 9, 16)
    cb = arm64_cmp_rr(cb, 1, 9)
    cb = arm64_bne_imm19(cb, 2 * 4)
    cb = arm64_movz_imm64(cb, 3, 32767)
    cb = arm64_movz_imm64(cb, 9, 32)
    cb = arm64_cmp_rr(cb, 1, 9)
    cb = arm64_bne_imm19(cb, 3 * 4)
    cb = arm64_movz_imm64(cb, 3, 2147483647)

    # 4. Scale calculation: find max(|x_i|) in X4
    cb = arm64_movz_imm64(cb, 4, 0)
    cb = arm64_movz_imm64(cb, 5, 0)

    # Floating storage modes preserve IEEE values and always use scale 1.
    # Skip integer conversion so NaN, infinities, and signed zero survive.
    cb = arm64_movz_imm64(cb, 9, 16)
    cb = arm64_cmp_rr(cb, 1, 9)
    cb = arm64_beq_imm19(cb, 0)
    let fixup_scale_skip16 = (codebuf_offset(cb) - 4) as int
    cb = arm64_movz_imm64(cb, 9, 32)
    cb = arm64_cmp_rr(cb, 1, 9)
    cb = arm64_beq_imm19(cb, 0)
    let fixup_scale_skip32 = (codebuf_offset(cb) - 4) as int

    let loop_scale_start = codebuf_offset(cb)
    cb = arm64_cmp_rr(cb, 5, 2)
    cb = arm64_bge_imm19(cb, 0)
    let fixup_scale_exit = (codebuf_offset(cb) - 4) as int

    cb = emit_arm64_quantize_elem_int(cb, 5, 8)

    # Compute abs(X8) in X8:
    cb = arm64_cmp_imm0(cb, 8)
    cb = arm64_bge_imm19(cb, 2 * 4)
    cb = arm64_sub_rrr(cb, 8, 31, 8)  # X8 = XZR - X8 = -X8

    # X4 = max(X4, X8):
    cb = arm64_cmp_rr(cb, 8, 4)
    cb = arm64_ble_imm19(cb, 2 * 4)
    cb = arm64_mov_rr(cb, 4, 8)

    cb = arm64_add_imm(cb, 5, 5, 1)
    let delta_scale_back = (loop_scale_start - codebuf_offset(cb)) as int
    cb = arm64_b_imm26(cb, delta_scale_back)

    let scale_exit_pos = codebuf_offset(cb) as int
    let imm19_skip16 = ((scale_exit_pos - fixup_scale_skip16) shr 2) and 0x7FFFF
    let imm19_skip32 = ((scale_exit_pos - fixup_scale_skip32) shr 2) and 0x7FFFF
    codebuf_patch_u32(cb, fixup_scale_skip16, (0x54000000 or (imm19_skip16 shl 5)) as int)
    codebuf_patch_u32(cb, fixup_scale_skip32, (0x54000000 or (imm19_skip32 shl 5)) as int)
    let delta_se = (scale_exit_pos - fixup_scale_exit) as int
    let imm19_se = (delta_se shr 2) and 0x7FFFF
    codebuf_patch_u32(cb, fixup_scale_exit, (0x5400000A or (imm19_se shl 5)) as int)

    # Scale in X5: if bits == 16 or bits == 32: scale = 1
    # else: if max_abs <= Qmax, scale = 1; else scale = (max_abs + Qmax - 1) / Qmax
    cb = arm64_movz_imm64(cb, 5, 1)
    cb = arm64_movz_imm64(cb, 9, 16)
    cb = arm64_cmp_rr(cb, 1, 9)
    cb = arm64_beq_imm19(cb, 9 * 4)
    cb = arm64_movz_imm64(cb, 9, 32)
    cb = arm64_cmp_rr(cb, 1, 9)
    cb = arm64_beq_imm19(cb, 6 * 4)
    cb = arm64_cmp_rr(cb, 4, 3)
    cb = arm64_ble_imm19(cb, 4 * 4)
    cb = arm64_add_rrr(cb, 6, 4, 3)
    cb = arm64_sub_imm(cb, 6, 6, 1)
    cb = arm64_udiv_rrr(cb, 5, 6, 3)

    # 5. Payload size in X6:
    cb = arm64_mov_rr(cb, 6, 2)
    cb = arm64_movz_imm64(cb, 9, 4)
    cb = arm64_cmp_rr(cb, 1, 9)
    cb = arm64_bne_imm19(cb, 3 * 4)
    cb = arm64_add_imm(cb, 6, 2, 1)
    cb = arm64_lsr_imm(cb, 6, 6, 1)
    cb = arm64_movz_imm64(cb, 9, 16)
    cb = arm64_cmp_rr(cb, 1, 9)
    cb = arm64_bne_imm19(cb, 2 * 4)
    cb = arm64_lsl_imm(cb, 6, 2, 1)
    cb = arm64_movz_imm64(cb, 9, 32)
    cb = arm64_cmp_rr(cb, 1, 9)
    cb = arm64_bne_imm19(cb, 2 * 4)
    cb = arm64_lsl_imm(cb, 6, 2, 2)

    # Total size in X7 = 32 + payload, aligned to 16:
    cb = arm64_add_imm(cb, 7, 6, 32 + 15)
    cb = arm64_lsr_imm(cb, 7, 7, 4)
    cb = arm64_lsl_imm(cb, 7, 7, 4)

    # Bump allocate on Arena *X28:
    cb = arm64_ldr_uoff(cb, 14, 28, 0) # X14 = q_ptr
    cb = arm64_add_rrr(cb, 16, 14, 7)
    cb = arm64_str_uoff(cb, 16, 28, 0) # update arena

    # Store header:
    cb = arm64_str_uoff(cb, 2, 14, 0)  # numel
    cb = arm64_str_uoff(cb, 1, 14, 8)  # bits
    cb = arm64_str_uoff(cb, 5, 14, 16) # scale
    cb = arm64_movz_imm64(cb, 9, 0)
    cb = arm64_str_uoff(cb, 9, 14, 24) # zero_point = 0

    # 6. Pack data buffer at X14 + 32:
    cb = arm64_add_imm(cb, 15, 14, 32) # X15 = data buffer
    cb = arm64_movz_imm64(cb, 8, 0)    # X8 = loop index i = 0

    cb = arm64_movz_imm64(cb, 9, 4)
    cb = arm64_cmp_rr(cb, 1, 9)
    cb = arm64_beq_imm19(cb, 0)        # branch to pack INT4
    let fixup_goto_pack4 = (codebuf_offset(cb) - 4) as int

    cb = arm64_movz_imm64(cb, 9, 16)
    cb = arm64_cmp_rr(cb, 1, 9)
    cb = arm64_beq_imm19(cb, 0)        # branch to pack f16
    let fixup_goto_pack16 = (codebuf_offset(cb) - 4) as int

    cb = arm64_movz_imm64(cb, 9, 32)
    cb = arm64_cmp_rr(cb, 1, 9)
    cb = arm64_beq_imm19(cb, 0)        # branch to pack f32
    let fixup_goto_pack32 = (codebuf_offset(cb) - 4) as int

    # --- PACK INT8 LOOP ---
    let pack8_start = codebuf_offset(cb)
    cb = arm64_cmp_rr(cb, 8, 2)
    cb = arm64_bge_imm19(cb, 0)
    let fixup_pack8_exit = (codebuf_offset(cb) - 4) as int

    cb = emit_arm64_quantize_elem_int(cb, 8, 9)

    # Quantize: q = X9 / scale (X5)
    cb = arm64_sdiv_rrr(cb, 9, 9, 5)
    # Clamp to [-127, 127]:
    cb = arm64_movz_imm64(cb, 10, 127)         # X10 = 127
    cb = arm64_sub_rrr(cb, 12, 31, 10)         # X12 = XZR - 127 = -127
    cb = arm64_cmp_rr(cb, 9, 10)
    cb = arm64_ble_imm19(cb, 2 * 4)            # if x9 <= 127, skip upper cap
    cb = arm64_mov_rr(cb, 9, 10)               # x9 = 127 (cap upper)
    cb = arm64_cmp_rr(cb, 9, 12)
    cb = arm64_bge_imm19(cb, 2 * 4)            # if x9 >= -127, skip lower cap
    cb = arm64_mov_rr(cb, 9, 12)               # x9 = -127 (cap lower)

    cb = arm64_strb_reg(cb, 9, 15, 8)
    cb = arm64_add_imm(cb, 8, 8, 1)
    let delta_p8_back = (pack8_start - codebuf_offset(cb)) as int
    cb = arm64_b_imm26(cb, delta_p8_back)

    let pack8_exit_pos = codebuf_offset(cb) as int
    let delta_p8e = (pack8_exit_pos - fixup_pack8_exit) as int
    let imm19_p8e = (delta_p8e shr 2) and 0x7FFFF
    codebuf_patch_u32(cb, fixup_pack8_exit, (0x5400000A or (imm19_p8e shl 5)) as int)
    cb = arm64_b_imm26(cb, 0)
    let fixup_p8_done = (codebuf_offset(cb) - 4) as int

    # --- PACK INT4 LOOP ---
    let pack4_target = codebuf_offset(cb) as int
    let delta_p4 = (pack4_target - fixup_goto_pack4) as int
    let imm19_p4 = (delta_p4 shr 2) and 0x7FFFF
    codebuf_patch_u32(cb, fixup_goto_pack4, (0x54000000 or (imm19_p4 shl 5)) as int)

    let pack4_start = codebuf_offset(cb)
    cb = arm64_cmp_rr(cb, 8, 2)
    cb = arm64_bge_imm19(cb, 0)
    let fixup_pack4_exit = (codebuf_offset(cb) - 4) as int

    cb = emit_arm64_quantize_elem_int(cb, 8, 9)

    # Quantize: q = X9 / scale (X5)
    cb = arm64_sdiv_rrr(cb, 9, 9, 5)
    # Clamp to [-7, 7]:
    cb = arm64_movz_imm64(cb, 10, 7)           # X10 = 7
    cb = arm64_sub_rrr(cb, 13, 31, 10)         # X13 = XZR - 7 = -7
    cb = arm64_cmp_rr(cb, 9, 10)
    cb = arm64_ble_imm19(cb, 2 * 4)            # if x9 <= 7, skip upper cap
    cb = arm64_mov_rr(cb, 9, 10)               # x9 = 7 (cap upper)
    cb = arm64_cmp_rr(cb, 9, 13)
    cb = arm64_bge_imm19(cb, 2 * 4)            # if x9 >= -7, skip lower cap
    cb = arm64_mov_rr(cb, 9, 13)               # x9 = -7 (cap lower)

    # Mask to 4 bits:
    cb = arm64_movz_imm64(cb, 10, 15)
    cb = arm64_and_rrr(cb, 9, 9, 10)

    # Byte index: k = X8 >> 1 (in X12)
    cb = arm64_lsr_imm(cb, 12, 8, 1)

    # Check even / odd: X8 & 1
    cb = arm64_movz_imm64(cb, 10, 1)
    cb = arm64_and_rrr(cb, 10, 8, 10)
    cb = arm64_cmp_imm0(cb, 10)
    cb = arm64_bne_imm19(cb, 3 * 4)

    # Even: store low nibble at *(X15 + X12)
    cb = arm64_strb_reg(cb, 9, 15, 12)
    cb = arm64_b_imm26(cb, 5 * 4)

    # Odd: read byte, or with (nibble << 4), store back
    cb = arm64_ldrb_reg(cb, 13, 15, 12)
    cb = arm64_lsl_imm(cb, 9, 9, 4)
    cb = arm64_orr_rrr(cb, 13, 13, 9)
    cb = arm64_strb_reg(cb, 13, 15, 12)

    cb = arm64_add_imm(cb, 8, 8, 1)
    let delta_p4_back = (pack4_start - codebuf_offset(cb)) as int
    cb = arm64_b_imm26(cb, delta_p4_back)

    let pack4_exit_pos = codebuf_offset(cb) as int
    let delta_p4e = (pack4_exit_pos - fixup_pack4_exit) as int
    let imm19_p4e = (delta_p4e shr 2) and 0x7FFFF
    codebuf_patch_u32(cb, fixup_pack4_exit, (0x5400000A or (imm19_p4e shl 5)) as int)
    cb = arm64_b_imm26(cb, 0)
    let fixup_p4_done = (codebuf_offset(cb) - 4) as int

    # --- PACK F16 LOOP ---
    let pack16_target = codebuf_offset(cb) as int
    let delta_p16 = (pack16_target - fixup_goto_pack16) as int
    let imm19_p16 = (delta_p16 shr 2) and 0x7FFFF
    codebuf_patch_u32(cb, fixup_goto_pack16, (0x54000000 or (imm19_p16 shl 5)) as int)

    let pack16_start = codebuf_offset(cb)
    cb = arm64_cmp_rr(cb, 8, 2)
    cb = arm64_bge_imm19(cb, 0)
    let fixup_pack16_exit = (codebuf_offset(cb) - 4) as int

    cb = arm64_add_imm(cb, 6, 0, 16)
    cb = arm64_movz_imm64(cb, 9, 4)
    cb = arm64_cmp_rr(cb, 17, 9)
    cb = arm64_bne_imm19(cb, 4 * 4)
    # f32 path:
    cb = arm64_ldr_s_reg_lsl2(cb, 0, 6, 8) # S0
    cb = arm64_fcvt_hs(cb, 0, 0)           # H0 = (f16)S0
    cb = arm64_b_imm26(cb, 8 * 4)
    # f16 check:
    cb = arm64_movz_imm64(cb, 9, 2)
    cb = arm64_cmp_rr(cb, 17, 9)
    cb = arm64_bne_imm19(cb, 3 * 4)
    # f16 path:
    cb = arm64_ldr_h_reg_lsl1(cb, 0, 6, 8) # H0
    cb = arm64_b_imm26(cb, 3 * 4)
    # f64 path:
    cb = arm64_ldr_d_reg_lsl3(cb, 0, 6, 8) # D0
    cb = arm64_fcvt_hd(cb, 0, 0)           # H0 = (f16)D0
    cb = arm64_str_h_reg_lsl1(cb, 0, 15, 8) # store H0 at X15 + X8 * 2

    cb = arm64_add_imm(cb, 8, 8, 1)
    let delta_p16_back = (pack16_start - codebuf_offset(cb)) as int
    cb = arm64_b_imm26(cb, delta_p16_back)

    let pack16_exit_pos = codebuf_offset(cb) as int
    let delta_p16e = (pack16_exit_pos - fixup_pack16_exit) as int
    let imm19_p16e = (delta_p16e shr 2) and 0x7FFFF
    codebuf_patch_u32(cb, fixup_pack16_exit, (0x5400000A or (imm19_p16e shl 5)) as int)
    cb = arm64_b_imm26(cb, 0)
    let fixup_p16_done = (codebuf_offset(cb) - 4) as int

    # --- PACK F32 LOOP ---
    let pack32_target = codebuf_offset(cb) as int
    let delta_p32 = (pack32_target - fixup_goto_pack32) as int
    let imm19_p32 = (delta_p32 shr 2) and 0x7FFFF
    codebuf_patch_u32(cb, fixup_goto_pack32, (0x54000000 or (imm19_p32 shl 5)) as int)

    let pack32_start = codebuf_offset(cb)
    cb = arm64_cmp_rr(cb, 8, 2)
    cb = arm64_bge_imm19(cb, 0)
    let fixup_pack32_exit = (codebuf_offset(cb) - 4) as int

    cb = arm64_add_imm(cb, 6, 0, 16)
    cb = arm64_movz_imm64(cb, 9, 4)
    cb = arm64_cmp_rr(cb, 17, 9)
    cb = arm64_bne_imm19(cb, 3 * 4)
    # f32 path:
    cb = arm64_ldr_s_reg_lsl2(cb, 0, 6, 8) # S0
    cb = arm64_b_imm26(cb, 9 * 4)
    # f16 check:
    cb = arm64_movz_imm64(cb, 9, 2)
    cb = arm64_cmp_rr(cb, 17, 9)
    cb = arm64_bne_imm19(cb, 4 * 4)
    # f16 path:
    cb = arm64_ldr_h_reg_lsl1(cb, 0, 6, 8) # H0
    cb = arm64_fcvt_sh(cb, 0, 0)           # S0 = (f32)H0
    cb = arm64_b_imm26(cb, 3 * 4)
    # f64 path:
    cb = arm64_ldr_d_reg_lsl3(cb, 0, 6, 8) # D0
    cb = arm64_fcvt_sd(cb, 0, 0)           # S0 = (f32)D0
    cb = arm64_str_s_reg_lsl2(cb, 0, 15, 8) # store S0 at X15 + X8 * 4

    cb = arm64_add_imm(cb, 8, 8, 1)
    let delta_p32_back = (pack32_start - codebuf_offset(cb)) as int
    cb = arm64_b_imm26(cb, delta_p32_back)

    let pack32_exit_pos = codebuf_offset(cb) as int
    let delta_p32e = (pack32_exit_pos - fixup_pack32_exit) as int
    let imm19_p32e = (delta_p32e shr 2) and 0x7FFFF
    codebuf_patch_u32(cb, fixup_pack32_exit, (0x5400000A or (imm19_p32e shl 5)) as int)

    let done_pos = codebuf_offset(cb) as int

    let delta_p8 = (done_pos - fixup_p8_done) as int
    let imm26_p8 = (delta_p8 shr 2) and 0x03FFFFFF
    codebuf_patch_u32(cb, fixup_p8_done, (0x14000000 or imm26_p8) as int)

    let delta_p4d = (done_pos - fixup_p4_done) as int
    let imm26_p4d = (delta_p4d shr 2) and 0x03FFFFFF
    codebuf_patch_u32(cb, fixup_p4_done, (0x14000000 or imm26_p4d) as int)

    let delta_p16d = (done_pos - fixup_p16_done) as int
    let imm26_p16d = (delta_p16d shr 2) and 0x03FFFFFF
    codebuf_patch_u32(cb, fixup_p16_done, (0x14000000 or imm26_p16d) as int)

    # Return q_ptr in X0:
    cb = arm64_mov_rr(cb, 0, 14)
    cb = arm64_ret(cb)

    let ret_zero_pos = codebuf_offset(cb) as int
    let delta_rz = (ret_zero_pos - fixup_ret_zero) as int
    let imm19_rz = (delta_rz shr 2) and 0x7FFFF
    codebuf_patch_u32(cb, fixup_ret_zero, (0x5400000D or (imm19_rz shl 5)) as int)
    cb = arm64_movz_imm64(cb, 0, 0)
    out arm64_ret(cb)
end.

func emit_lir_rt_backward_legacy_stub(cb: &CodeBuf):
    # Read W = *(X28 + 16), X = *(X28 + 24)
    cb = arm64_ldr_uoff(cb, 0, 28, 16)
    cb = arm64_ldr_uoff(cb, 1, 28, 24)
    cb = arm64_cmp_imm0(cb, 0)
    cb = arm64_beq_imm19(cb, 0)
    let fixup_b_ret = (codebuf_offset(cb) - 4) as int
    cb = arm64_cmp_imm0(cb, 1)
    cb = arm64_beq_imm19(cb, 0)
    let fixup_b_ret2 = (codebuf_offset(cb) - 4) as int

    # Allocate grad_w (48 bytes for 2x2):
    cb = arm64_ldr_uoff(cb, 14, 28, 0) # X14 = grad_w
    cb = arm64_add_imm(cb, 16, 14, 48)
    cb = arm64_str_uoff(cb, 16, 28, 0)
    cb = arm64_movz_imm64(cb, 9, 4)
    cb = arm64_str_uoff(cb, 9, 14, 0)  # len = 4
    cb = arm64_str_uoff(cb, 9, 14, 8)  # cap = 4

    # Allocate grad_x (48 bytes for 2x2):
    cb = arm64_ldr_uoff(cb, 15, 28, 0) # X15 = grad_x
    cb = arm64_add_imm(cb, 16, 15, 48)
    cb = arm64_str_uoff(cb, 16, 28, 0)
    cb = arm64_str_uoff(cb, 9, 15, 0)  # len = 4
    cb = arm64_str_uoff(cb, 9, 15, 8)  # cap = 4

    # Check is_float from tape offset 72:
    cb = arm64_ldr_uoff(cb, 8, 28, 72)
    cb = arm64_cmp_imm0(cb, 8)
    cb = arm64_bne_imm19(cb, 22 * 4)

    # Integer path:
    cb = arm64_ldr_uoff(cb, 2, 1, 16)  # X[0, 0]
    cb = arm64_ldr_uoff(cb, 3, 1, 24)  # X[0, 1]
    cb = arm64_ldr_uoff(cb, 4, 1, 32)  # X[1, 0]
    cb = arm64_ldr_uoff(cb, 5, 1, 40)  # X[1, 1]
    cb = arm64_add_rrr(cb, 6, 2, 3)
    cb = arm64_add_rrr(cb, 7, 4, 5)
    cb = arm64_str_uoff(cb, 6, 14, 16) # grad_w[0, 0]
    cb = arm64_str_uoff(cb, 7, 14, 24) # grad_w[0, 1]
    cb = arm64_str_uoff(cb, 6, 14, 32) # grad_w[1, 0]
    cb = arm64_str_uoff(cb, 7, 14, 40) # grad_w[1, 1]
    cb = arm64_ldr_uoff(cb, 2, 0, 16)  # W[0, 0]
    cb = arm64_ldr_uoff(cb, 3, 0, 24)  # W[0, 1]
    cb = arm64_ldr_uoff(cb, 4, 0, 32)  # W[1, 0]
    cb = arm64_ldr_uoff(cb, 5, 0, 40)  # W[1, 1]
    cb = arm64_add_rrr(cb, 6, 2, 4)
    cb = arm64_add_rrr(cb, 7, 3, 5)
    cb = arm64_str_uoff(cb, 6, 15, 16) # grad_x[0, 0]
    cb = arm64_str_uoff(cb, 6, 15, 24) # grad_x[0, 1]
    cb = arm64_str_uoff(cb, 7, 15, 32) # grad_x[1, 0]
    cb = arm64_str_uoff(cb, 7, 15, 40) # grad_x[1, 1]
    cb = arm64_b_imm26(cb, 21 * 4)

    # Float path:
    cb = arm64_ldr_d_uoff(cb, 2, 1, 16)  # X[0, 0]
    cb = arm64_ldr_d_uoff(cb, 3, 1, 24)  # X[0, 1]
    cb = arm64_ldr_d_uoff(cb, 4, 1, 32)  # X[1, 0]
    cb = arm64_ldr_d_uoff(cb, 5, 1, 40)  # X[1, 1]
    cb = arm64_fadd_ddd(cb, 6, 2, 3)
    cb = arm64_fadd_ddd(cb, 7, 4, 5)
    cb = arm64_str_d_uoff(cb, 6, 14, 16) # grad_w[0, 0]
    cb = arm64_str_d_uoff(cb, 7, 14, 24) # grad_w[0, 1]
    cb = arm64_str_d_uoff(cb, 6, 14, 32) # grad_w[1, 0]
    cb = arm64_str_d_uoff(cb, 7, 14, 40) # grad_w[1, 1]
    cb = arm64_ldr_d_uoff(cb, 2, 0, 16)  # W[0, 0]
    cb = arm64_ldr_d_uoff(cb, 3, 0, 24)  # W[0, 1]
    cb = arm64_ldr_d_uoff(cb, 4, 0, 32)  # W[1, 0]
    cb = arm64_ldr_d_uoff(cb, 5, 0, 40)  # W[1, 1]
    cb = arm64_fadd_ddd(cb, 6, 2, 4)
    cb = arm64_fadd_ddd(cb, 7, 3, 5)
    cb = arm64_str_d_uoff(cb, 6, 15, 16) # grad_x[0, 0]
    cb = arm64_str_d_uoff(cb, 6, 15, 24) # grad_x[0, 1]
    cb = arm64_str_d_uoff(cb, 7, 15, 32) # grad_x[1, 0]
    cb = arm64_str_d_uoff(cb, 7, 15, 40) # grad_x[1, 1]

    # Store grad_w at *(W + 8) and grad_x at *(X + 8):
    cb = arm64_str_uoff(cb, 14, 0, 8)
    cb = arm64_str_uoff(cb, 15, 1, 8)

    # Clear tape:
    cb = arm64_movz_imm64(cb, 9, 0)
    cb = arm64_str_uoff(cb, 9, 28, 16)
    cb = arm64_str_uoff(cb, 9, 28, 24)
    cb = arm64_str_uoff(cb, 9, 28, 32)
    cb = arm64_str_uoff(cb, 9, 28, 40)
    cb = arm64_str_uoff(cb, 9, 28, 48)
    cb = arm64_str_uoff(cb, 9, 28, 56)
    cb = arm64_str_uoff(cb, 9, 28, 64)
    cb = arm64_str_uoff(cb, 9, 28, 72)

    let b_ret_pos = codebuf_offset(cb) as int
    let delta1 = (b_ret_pos - fixup_b_ret) as int
    let imm19_1 = (delta1 shr 2) and 0x7FFFF
    codebuf_patch_u32(cb, fixup_b_ret, (0x54000000 or (imm19_1 shl 5)) as int)

    let delta2 = (b_ret_pos - fixup_b_ret2) as int
    let imm19_2 = (delta2 shr 2) and 0x7FFFF
    codebuf_patch_u32(cb, fixup_b_ret2, (0x54000000 or (imm19_2 shl 5)) as int)

    out arm64_ret(cb)
end.

func emit_arm64_ad_alloc_f32(cb: CodeBuf, numel_reg: int, out_reg: int, fill_one: int):
    # Gradient tensors use the ordinary fixed-tensor header and a packed f32
    # payload.  The payload is 64-byte aligned like forward tensor storage.
    cb = arm64_mov_rr(cb, 0, numel_reg)
    cb = arm64_lsl_imm(cb, 0, 0, 2)
    cb = arm64_add_imm(cb, 0, 0, 31)
    cb = arm64_lsr_imm(cb, 0, 0, 4)
    cb = arm64_lsl_imm(cb, 0, 0, 4)
    cb = arm64_ldr_uoff(cb, 1, 28, 0)
    cb = arm64_add_imm(cb, 1, 1, 79)
    cb = arm64_lsr_imm(cb, 1, 1, 6)
    cb = arm64_lsl_imm(cb, 1, 1, 6)
    cb = arm64_sub_imm(cb, 1, 1, 16)
    cb = arm64_add_rrr(cb, 12, 1, 0)
    cb = arm64_str_uoff(cb, 12, 28, 0)
    cb = arm64_mov_rr(cb, out_reg, 1)
    cb = arm64_str_uoff(cb, numel_reg, out_reg, 0)
    cb = arm64_str_uoff(cb, numel_reg, out_reg, 8)
    cb = arm64_add_imm(cb, 9, out_reg, 16)
    cb = arm64_movz_imm64(cb, 10, 0)
    if fill_one == 1 do cb = arm64_movz_imm64(cb, 10, 0x3F800000) end
    cb = arm64_movz_imm64(cb, 8, 0)
    let fill_loop = codebuf_offset(cb)
    cb = arm64_cmp_rr(cb, 8, numel_reg)
    cb = arm64_bge_imm19(cb, 0)
    let fill_exit = (codebuf_offset(cb) - 4) as int
    cb = arm64_str_w_reg_lsl2(cb, 10, 9, 8)
    cb = arm64_add_imm(cb, 8, 8, 1)
    cb = arm64_b_imm26(cb, (fill_loop - codebuf_offset(cb)) as int)
    let fill_done = codebuf_offset(cb) as int
    let fill_imm19 = ((fill_done - fill_exit) shr 2) and 0x7FFFF
    codebuf_patch_u32(cb, fill_exit, (0x5400000A or (fill_imm19 shl 5)) as int)
    out cb
end.

func emit_lir_rt_backward_stub(cb: &CodeBuf):
    # AOT f32 matmul derivative kernel.  Each call computes one operand
    # derivative and returns its ordinary tensor value in X0.  No primal
    # tensor header is mutated and no runtime graph exists.
    #   X0=A, X1=B, X2=upstream-or-zero, X3=prior-grad-or-zero, X4=metadata.
    cb = arm64_mov_rr(cb, 14, 0)
    cb = arm64_mov_rr(cb, 15, 1)
    cb = arm64_mov_rr(cb, 16, 2)
    cb = arm64_mov_rr(cb, 17, 3)       # accumulated result, if any
    cb = arm64_ubfx(cb, 5, 4, 32, 16) # M
    cb = arm64_ubfx(cb, 6, 4, 16, 16) # K
    cb = arm64_ubfx(cb, 7, 4, 0, 16)  # N

    cb = arm64_ubfx(cb, 8, 4, 48, 1)
    cb = arm64_cmp_imm0(cb, 8)
    cb = arm64_beq_imm19(cb, 0)
    let bad_not_float = (codebuf_offset(cb) - 4) as int
    cb = arm64_ubfx(cb, 8, 4, 49, 1)
    cb = arm64_cmp_imm0(cb, 8)
    cb = arm64_beq_imm19(cb, 0)
    let bad_not_f32 = (codebuf_offset(cb) - 4) as int

    # Bit 54 requests the ordinary all-ones tensor exposed as root.grad.
    cb = arm64_ubfx(cb, 8, 4, 54, 1)
    cb = arm64_cmp_imm0(cb, 8)
    cb = arm64_beq_imm19(cb, 0)
    let not_root_seed = (codebuf_offset(cb) - 4) as int
    cb = arm64_mul_rrr(cb, 11, 5, 7)
    cb = emit_arm64_ad_alloc_f32(cb, 11, 17, 1)
    cb = arm64_mov_rr(cb, 0, 17)
    cb = arm64_ret(cb)
    let derivative_start = codebuf_offset(cb) as int
    codebuf_patch_u32(cb, not_root_seed, (0x54000000 or ((((derivative_start - not_root_seed) shr 2) and 0x7FFFF) shl 5)) as int)

    # A zero upstream is the implicit all-ones seed only for the root.  For an
    # unreachable non-root node, preserve and return the prior gradient.
    cb = arm64_cmp_imm0(cb, 16)
    cb = arm64_bne_imm19(cb, 0)
    let upstream_present = (codebuf_offset(cb) - 4) as int
    cb = arm64_ubfx(cb, 8, 4, 52, 1)
    cb = arm64_cmp_imm0(cb, 8)
    cb = arm64_beq_imm19(cb, 0)
    let no_upstream_ret = (codebuf_offset(cb) - 4) as int
    let upstream_ready = codebuf_offset(cb) as int
    codebuf_patch_u32(cb, upstream_present, (0x54000001 or ((((upstream_ready - upstream_present) shr 2) and 0x7FFFF) shl 5)) as int)

    # Preserve the derivative selector across allocation (bit 53: 0=dA, 1=dB).
    cb = arm64_ubfx(cb, 4, 4, 53, 1)
    cb = arm64_cmp_imm0(cb, 17)
    cb = arm64_bne_imm19(cb, 0)
    let have_grad = (codebuf_offset(cb) - 4) as int
    cb = arm64_cmp_imm0(cb, 4)
    cb = arm64_bne_imm19(cb, 0)
    let alloc_db = (codebuf_offset(cb) - 4) as int
    cb = arm64_mul_rrr(cb, 11, 5, 6)
    cb = arm64_b_imm26(cb, 0)
    let alloc_numel_ready_jump = (codebuf_offset(cb) - 4) as int
    let alloc_db_pos = codebuf_offset(cb) as int
    codebuf_patch_u32(cb, alloc_db, (0x54000001 or ((((alloc_db_pos - alloc_db) shr 2) and 0x7FFFF) shl 5)) as int)
    cb = arm64_mul_rrr(cb, 11, 6, 7)
    let alloc_numel_ready = codebuf_offset(cb) as int
    codebuf_patch_u32(cb, alloc_numel_ready_jump, (0x14000000 or (((alloc_numel_ready - alloc_numel_ready_jump) shr 2) and 0x03FFFFFF)) as int)
    cb = emit_arm64_ad_alloc_f32(cb, 11, 17, 0)
    let grad_ready = codebuf_offset(cb) as int
    codebuf_patch_u32(cb, have_grad, (0x54000001 or ((((grad_ready - have_grad) shr 2) and 0x7FFFF) shl 5)) as int)

    cb = arm64_add_imm(cb, 0, 14, 16) # A data
    cb = arm64_add_imm(cb, 1, 15, 16) # B data
    cb = arm64_add_imm(cb, 2, 16, 16) # G data; ignored for implicit root seed
    cb = arm64_add_imm(cb, 3, 17, 16) # destination data
    cb = arm64_cmp_imm0(cb, 4)
    cb = arm64_bne_imm19(cb, 0)
    let goto_db = (codebuf_offset(cb) - 4) as int

    # dA[i,k] += sum_j G[i,j] * B[k,j]
    cb = arm64_movz_imm64(cb, 8, 0)
    let da_i_loop = codebuf_offset(cb)
    cb = arm64_cmp_rr(cb, 8, 5)
    cb = arm64_bge_imm19(cb, 0)
    let da_i_exit = (codebuf_offset(cb) - 4) as int
    cb = arm64_movz_imm64(cb, 9, 0)
    let da_k_loop = codebuf_offset(cb)
    cb = arm64_cmp_rr(cb, 9, 6)
    cb = arm64_bge_imm19(cb, 0)
    let da_k_exit = (codebuf_offset(cb) - 4) as int
    cb = arm64_mul_rrr(cb, 11, 8, 6)
    cb = arm64_add_rrr(cb, 11, 11, 9)
    cb = arm64_ldr_s_reg_lsl2(cb, 0, 3, 11)
    cb = arm64_movz_imm64(cb, 10, 0)
    let da_j_loop = codebuf_offset(cb)
    cb = arm64_cmp_rr(cb, 10, 7)
    cb = arm64_bge_imm19(cb, 0)
    let da_j_exit = (codebuf_offset(cb) - 4) as int
    cb = arm64_cmp_imm0(cb, 16)
    cb = arm64_beq_imm19(cb, 0)
    let da_seed_one = (codebuf_offset(cb) - 4) as int
    cb = arm64_mul_rrr(cb, 11, 8, 7)
    cb = arm64_add_rrr(cb, 11, 11, 10)
    cb = arm64_ldr_s_reg_lsl2(cb, 1, 2, 11)
    cb = arm64_b_imm26(cb, 0)
    let da_seed_ready_jump = (codebuf_offset(cb) - 4) as int
    let da_seed_one_pos = codebuf_offset(cb) as int
    codebuf_patch_u32(cb, da_seed_one, (0x54000000 or ((((da_seed_one_pos - da_seed_one) shr 2) and 0x7FFFF) shl 5)) as int)
    cb = arm64_movz_imm64(cb, 12, 0x3F800000)
    cb = arm64_fmov_dx(cb, 1, 12)
    let da_seed_ready = codebuf_offset(cb) as int
    codebuf_patch_u32(cb, da_seed_ready_jump, (0x14000000 or (((da_seed_ready - da_seed_ready_jump) shr 2) and 0x03FFFFFF)) as int)
    cb = arm64_mul_rrr(cb, 12, 9, 7)
    cb = arm64_add_rrr(cb, 12, 12, 10)
    cb = arm64_ldr_s_reg_lsl2(cb, 2, 1, 12)
    cb = arm64_fmadd_ssss(cb, 0, 1, 2, 0)
    cb = arm64_add_imm(cb, 10, 10, 1)
    cb = arm64_b_imm26(cb, (da_j_loop - codebuf_offset(cb)) as int)
    let da_j_done = codebuf_offset(cb) as int
    codebuf_patch_u32(cb, da_j_exit, (0x5400000A or ((((da_j_done - da_j_exit) shr 2) and 0x7FFFF) shl 5)) as int)
	cb = arm64_mul_rrr(cb, 11, 8, 6)
	cb = arm64_add_rrr(cb, 11, 11, 9)
    cb = arm64_str_s_reg_lsl2(cb, 0, 3, 11)
    cb = arm64_add_imm(cb, 9, 9, 1)
    cb = arm64_b_imm26(cb, (da_k_loop - codebuf_offset(cb)) as int)
    let da_k_done = codebuf_offset(cb) as int
    codebuf_patch_u32(cb, da_k_exit, (0x5400000A or ((((da_k_done - da_k_exit) shr 2) and 0x7FFFF) shl 5)) as int)
    cb = arm64_add_imm(cb, 8, 8, 1)
    cb = arm64_b_imm26(cb, (da_i_loop - codebuf_offset(cb)) as int)
    let da_i_done = codebuf_offset(cb) as int
    codebuf_patch_u32(cb, da_i_exit, (0x5400000A or ((((da_i_done - da_i_exit) shr 2) and 0x7FFFF) shl 5)) as int)
    cb = arm64_mov_rr(cb, 0, 17)
    cb = arm64_ret(cb)

    # dB[k,j] += sum_i A[i,k] * G[i,j]
    let db_start = codebuf_offset(cb) as int
    codebuf_patch_u32(cb, goto_db, (0x54000001 or ((((db_start - goto_db) shr 2) and 0x7FFFF) shl 5)) as int)
    cb = arm64_movz_imm64(cb, 8, 0)
    let db_k_loop = codebuf_offset(cb)
    cb = arm64_cmp_rr(cb, 8, 6)
    cb = arm64_bge_imm19(cb, 0)
    let db_k_exit = (codebuf_offset(cb) - 4) as int
    cb = arm64_movz_imm64(cb, 9, 0)
    let db_j_loop = codebuf_offset(cb)
    cb = arm64_cmp_rr(cb, 9, 7)
    cb = arm64_bge_imm19(cb, 0)
    let db_j_exit = (codebuf_offset(cb) - 4) as int
    cb = arm64_mul_rrr(cb, 11, 8, 7)
    cb = arm64_add_rrr(cb, 11, 11, 9)
    cb = arm64_ldr_s_reg_lsl2(cb, 0, 3, 11)
    cb = arm64_movz_imm64(cb, 10, 0)
    let db_i_loop = codebuf_offset(cb)
    cb = arm64_cmp_rr(cb, 10, 5)
    cb = arm64_bge_imm19(cb, 0)
    let db_i_exit = (codebuf_offset(cb) - 4) as int
    cb = arm64_mul_rrr(cb, 11, 10, 6)
    cb = arm64_add_rrr(cb, 11, 11, 8)
    cb = arm64_ldr_s_reg_lsl2(cb, 1, 0, 11)
    cb = arm64_cmp_imm0(cb, 16)
    cb = arm64_beq_imm19(cb, 0)
    let db_seed_one = (codebuf_offset(cb) - 4) as int
    cb = arm64_mul_rrr(cb, 12, 10, 7)
    cb = arm64_add_rrr(cb, 12, 12, 9)
    cb = arm64_ldr_s_reg_lsl2(cb, 2, 2, 12)
    cb = arm64_b_imm26(cb, 0)
    let db_seed_ready_jump = (codebuf_offset(cb) - 4) as int
    let db_seed_one_pos = codebuf_offset(cb) as int
    codebuf_patch_u32(cb, db_seed_one, (0x54000000 or ((((db_seed_one_pos - db_seed_one) shr 2) and 0x7FFFF) shl 5)) as int)
    cb = arm64_movz_imm64(cb, 12, 0x3F800000)
    cb = arm64_fmov_dx(cb, 2, 12)
    let db_seed_ready = codebuf_offset(cb) as int
    codebuf_patch_u32(cb, db_seed_ready_jump, (0x14000000 or (((db_seed_ready - db_seed_ready_jump) shr 2) and 0x03FFFFFF)) as int)
    cb = arm64_fmadd_ssss(cb, 0, 1, 2, 0)
    cb = arm64_add_imm(cb, 10, 10, 1)
    cb = arm64_b_imm26(cb, (db_i_loop - codebuf_offset(cb)) as int)
    let db_i_done = codebuf_offset(cb) as int
    codebuf_patch_u32(cb, db_i_exit, (0x5400000A or ((((db_i_done - db_i_exit) shr 2) and 0x7FFFF) shl 5)) as int)
	cb = arm64_mul_rrr(cb, 11, 8, 7)
	cb = arm64_add_rrr(cb, 11, 11, 9)
    cb = arm64_str_s_reg_lsl2(cb, 0, 3, 11)
    cb = arm64_add_imm(cb, 9, 9, 1)
    cb = arm64_b_imm26(cb, (db_j_loop - codebuf_offset(cb)) as int)
    let db_j_done = codebuf_offset(cb) as int
    codebuf_patch_u32(cb, db_j_exit, (0x5400000A or ((((db_j_done - db_j_exit) shr 2) and 0x7FFFF) shl 5)) as int)
    cb = arm64_add_imm(cb, 8, 8, 1)
    cb = arm64_b_imm26(cb, (db_k_loop - codebuf_offset(cb)) as int)
    let db_k_done = codebuf_offset(cb) as int
    codebuf_patch_u32(cb, db_k_exit, (0x5400000A or ((((db_k_done - db_k_exit) shr 2) and 0x7FFFF) shl 5)) as int)

    let ret_pos = codebuf_offset(cb) as int
    let ret_imm19 = ((ret_pos - no_upstream_ret) shr 2) and 0x7FFFF
    codebuf_patch_u32(cb, no_upstream_ret, (0x54000000 or (ret_imm19 shl 5)) as int)
    cb = arm64_mov_rr(cb, 0, 17)
    cb = arm64_ret(cb)

    let bad_pos = codebuf_offset(cb) as int
    codebuf_patch_u32(cb, bad_not_float, (0x54000000 or ((((bad_pos - bad_not_float) shr 2) and 0x7FFFF) shl 5)) as int)
    codebuf_patch_u32(cb, bad_not_f32, (0x54000000 or ((((bad_pos - bad_not_f32) shr 2) and 0x7FFFF) shl 5)) as int)
    cb = arm64_brk(cb, 2)
    out arm64_ret(cb)
end.
