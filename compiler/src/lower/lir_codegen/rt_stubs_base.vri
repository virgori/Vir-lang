    out arm64_ret(cb)
end.

func emit_lir_rt_atomic_add32_stub(cb: &CodeBuf):
    cb = codebuf_emit_u32(cb, 0x885F7C02)
    cb = codebuf_emit_u32(cb, 0x0B010043)
    cb = codebuf_emit_u32(cb, 0x88047C03)
    cb = codebuf_emit_u32(cb, 0x35FFFFA4)
    cb = codebuf_emit_u32(cb, 0x2A0203E0)
    out arm64_ret(cb)
end.

func emit_lir_rt_atomic_sub32_stub(cb: &CodeBuf):
    cb = codebuf_emit_u32(cb, 0x885F7C02)
    cb = codebuf_emit_u32(cb, 0x4B010043)
    cb = codebuf_emit_u32(cb, 0x88047C03)
    cb = codebuf_emit_u32(cb, 0x35FFFFA4)
    cb = codebuf_emit_u32(cb, 0x2A0203E0)
    out arm64_ret(cb)
end.

func emit_lir_rt_atomic_cas32_stub(cb: &CodeBuf):
    cb = codebuf_emit_u32(cb, 0x885F7C03) # ldaxr w3, [x0]
    cb = codebuf_emit_u32(cb, 0x6B01007F) # cmp w3, w1
    cb = codebuf_emit_u32(cb, 0x540000A1) # b.ne +20 (to clrex)
    cb = codebuf_emit_u32(cb, 0x88047C02) # stlxr w4, w2, [x0]
    cb = codebuf_emit_u32(cb, 0x35FFFF84) # cbnz w4, -16 (to ldaxr)
    cb = codebuf_emit_u32(cb, 0xD2800020) # mov x0, #1
    cb = arm64_ret(cb)
    cb = codebuf_emit_u32(cb, 0xD5033F5F) # clrex
    cb = codebuf_emit_u32(cb, 0xD2800000) # mov x0, #0
    out arm64_ret(cb)
end.

