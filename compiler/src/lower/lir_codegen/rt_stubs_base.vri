func emit_lir_rt_str_len_stub(cb: &CodeBuf):
    # X0 = C-string ptr → X0 = length (excluding NUL)
    cb = arm64_cmp_imm0(cb, 0)
    cb = arm64_bne_imm19(cb, 12)
    cb = arm64_movz_imm64(cb, 0, 0)
    cb = arm64_ret(cb)
    cb = arm64_mov_rr(cb, 1, 0)
    len_loop = codebuf_offset(cb)
    cb = arm64_ldrb_uoff(cb, 2, 1, 0)
    cb = arm64_cmp_imm0(cb, 2)
    cb = arm64_beq_imm19(cb, 12)
    cb = arm64_add_imm(cb, 1, 1, 1)
    delta = (len_loop - codebuf_offset(cb)) as int
    cb = arm64_b_imm26(cb, delta)
    cb = arm64_sub_rrr(cb, 0, 1, 0)
    out arm64_ret(cb)
end.

func emit_lir_rt_str_eq_stub(cb: &CodeBuf):
    # X0 = a, X1 = b → X0 = 1 if equal (as C-strings) else 0
    cb = arm64_cmp_rr(cb, 0, 1)
    cb = arm64_bne_imm19(cb, 12)
    cb = arm64_mov_imm16(cb, 0, 1)
    cb = arm64_ret(cb)
    cb = arm64_cmp_imm0(cb, 0)
    cb = arm64_beq_imm19(cb, 12)
    cb = arm64_cmp_imm0(cb, 1)
    cb = arm64_bne_imm19(cb, 12)
    cb = arm64_mov_imm16(cb, 0, 0)
    cb = arm64_ret(cb)
    eq_loop = codebuf_offset(cb)
    cb = arm64_ldrb_uoff(cb, 2, 0, 0)
    cb = arm64_ldrb_uoff(cb, 3, 1, 0)
    cb = arm64_cmp_rr(cb, 2, 3)
    cb = arm64_bne_imm19(cb, 24)
    cb = arm64_cmp_imm0(cb, 2)
    cb = arm64_beq_imm19(cb, 24)
    cb = arm64_add_imm(cb, 0, 0, 1)
    cb = arm64_add_imm(cb, 1, 1, 1)
    delta = (eq_loop - codebuf_offset(cb)) as int
    cb = arm64_b_imm26(cb, delta)
    cb = arm64_mov_imm16(cb, 0, 0)
    cb = arm64_ret(cb)
    cb = arm64_mov_imm16(cb, 0, 1)
    out arm64_ret(cb)
end.

func emit_lir_rt_int_to_str_stub(cb: &CodeBuf):
    # X0 = signed integer n → X0 = ptr to freshly bump-allocated NUL-terminated decimal string
    # --- allocate 32 bytes: X11 = base ; *X28 += 32 ---
    cb = arm64_ldr_uoff(cb, 14, 28, 0)
    cb = arm64_mov_rr(cb, 11, 14)
    cb = arm64_add_imm(cb, 14, 14, 32)
    cb = arm64_str_uoff(cb, 14, 28, 0)
    # --- cursor X10 = base+31, write NUL terminator ---
    cb = arm64_add_imm(cb, 10, 11, 31)
    cb = arm64_mov_imm16(cb, 15, 0)
    cb = arm64_strb_uoff(cb, 15, 10, 0)
    # --- X9 = n ; X12 = sign flag ---
    cb = arm64_mov_rr(cb, 9, 0)
    cb = arm64_mov_imm16(cb, 12, 0)
    # --- if n < 0: sign=1, n = 0 - n ---
    cb = arm64_cmp_imm0(cb, 9)
    cb = arm64_cset_lt(cb, 14)
    cb = arm64_cmp_imm0(cb, 14)
    cb = arm64_beq_imm19(cb, 16)
    cb = arm64_mov_imm16(cb, 12, 1)
    cb = arm64_mov_imm16(cb, 15, 0)
    cb = arm64_sub_rrr(cb, 9, 15, 9)
    # --- digit loop (do-while so 0 produces "0") ---
    dloop = codebuf_offset(cb)
    cb = arm64_mov_imm16(cb, 15, 10)
    cb = arm64_udiv_rrr(cb, 13, 9, 15)
    cb = arm64_msub_rrrr(cb, 14, 13, 15, 9)
    cb = arm64_add_imm(cb, 14, 14, 48)
    cb = arm64_sub_imm(cb, 10, 10, 1)
    cb = arm64_strb_uoff(cb, 14, 10, 0)
    cb = arm64_mov_rr(cb, 9, 13)
    cb = arm64_cmp_imm0(cb, 9)
    ddelta = (dloop - codebuf_offset(cb)) as int
    cb = arm64_bne_imm19(cb, ddelta)
    # --- prepend '-' when negative ---
    cb = arm64_cmp_imm0(cb, 12)
    cb = arm64_beq_imm19(cb, 16)
    cb = arm64_sub_imm(cb, 10, 10, 1)
    cb = arm64_mov_imm16(cb, 15, 45)
    cb = arm64_strb_uoff(cb, 15, 10, 0)
    # --- return pointer to first char ---
    cb = arm64_mov_rr(cb, 0, 10)
    out arm64_ret(cb)
end.

func emit_lir_rt_bool_to_str_stub(cb: &CodeBuf):
    # X0 = Bool -> X0 = freshly bump-allocated "true" or "false" C-string.
    cb = arm64_ldr_uoff(cb, 11, 28, 0)
    cb = arm64_add_imm(cb, 14, 11, 8)
    cb = arm64_str_uoff(cb, 14, 28, 0)
    cb = arm64_cmp_imm0(cb, 0)
    cb = arm64_beq_imm19(cb, 24)
    cb = arm64_movz_imm64(cb, 15, 0x65757274)
    cb = arm64_str_uoff(cb, 15, 11, 0)
    cb = arm64_mov_rr(cb, 0, 11)
    cb = arm64_ret(cb)
    cb = arm64_movz_imm64(cb, 15, 0x65736C6166)
    cb = arm64_str_uoff(cb, 15, 11, 0)
    cb = arm64_mov_rr(cb, 0, 11)
    out arm64_ret(cb)
end.

func emit_lir_rt_str_cat_stub(cb: &CodeBuf):
    # X0 = a, X1 = b → newly bump-allocated NUL-terminated a++b in X0
    # --- len_a into X2 ---
    cb = arm64_mov_rr(cb, 9, 0)
    la = codebuf_offset(cb)
    cb = arm64_ldrb_uoff(cb, 13, 9, 0)
    cb = arm64_cmp_imm0(cb, 13)
    cb = arm64_beq_imm19(cb, 12)
    cb = arm64_add_imm(cb, 9, 9, 1)
    dla = (la - codebuf_offset(cb)) as int
    cb = arm64_b_imm26(cb, dla)
    cb = arm64_sub_rrr(cb, 2, 9, 0)
    # --- len_b into X3 ---
    cb = arm64_mov_rr(cb, 10, 1)
    lb = codebuf_offset(cb)
    cb = arm64_ldrb_uoff(cb, 13, 10, 0)
    cb = arm64_cmp_imm0(cb, 13)
    cb = arm64_beq_imm19(cb, 12)
    cb = arm64_add_imm(cb, 10, 10, 1)
    dlb = (lb - codebuf_offset(cb)) as int
    cb = arm64_b_imm26(cb, dlb)
    cb = arm64_sub_rrr(cb, 3, 10, 1)
    # --- total = len_a + len_b + 1, aligned up to 8 ---
    cb = arm64_add_rrr(cb, 4, 2, 3)
    cb = arm64_add_imm(cb, 4, 4, 1)
    cb = arm64_add_imm(cb, 4, 4, 7)
    cb = arm64_mov_imm16(cb, 15, 3)
    cb = arm64_lsr_rrr(cb, 4, 4, 15)
    cb = arm64_lsl_imm(cb, 4, 4, 3)
    # --- bump allocate: X11 = *X28 ; *X28 += total ---
    cb = arm64_ldr_uoff(cb, 14, 28, 0)
    cb = arm64_mov_rr(cb, 11, 14)
    cb = arm64_add_rrr(cb, 14, 14, 4)
    cb = arm64_str_uoff(cb, 14, 28, 0)
    # --- copy a into dest (X12 = cursor) ---
    cb = arm64_mov_rr(cb, 12, 11)
    cb = arm64_mov_rr(cb, 9, 0)
    ca = codebuf_offset(cb)
    cb = arm64_ldrb_uoff(cb, 13, 9, 0)
    cb = arm64_cmp_imm0(cb, 13)
    cb = arm64_beq_imm19(cb, 20)
    cb = arm64_strb_uoff(cb, 13, 12, 0)
    cb = arm64_add_imm(cb, 9, 9, 1)
    cb = arm64_add_imm(cb, 12, 12, 1)
    dca = (ca - codebuf_offset(cb)) as int
    cb = arm64_b_imm26(cb, dca)
    # --- copy b into dest ---
    cb = arm64_mov_rr(cb, 10, 1)
    cbl = codebuf_offset(cb)
    cb = arm64_ldrb_uoff(cb, 13, 10, 0)
    cb = arm64_cmp_imm0(cb, 13)
    cb = arm64_beq_imm19(cb, 20)
    cb = arm64_strb_uoff(cb, 13, 12, 0)
    cb = arm64_add_imm(cb, 10, 10, 1)
    cb = arm64_add_imm(cb, 12, 12, 1)
    dcb = (cbl - codebuf_offset(cb)) as int
    cb = arm64_b_imm26(cb, dcb)
    # --- NUL terminate + return dest ---
    cb = arm64_mov_imm16(cb, 13, 0)
    cb = arm64_strb_uoff(cb, 13, 12, 0)
    cb = arm64_mov_rr(cb, 0, 11)
    out arm64_ret(cb)
end.

func emit_lir_rt_syscall_stub(cb: &CodeBuf, is_linux: i64):
    if is_linux == 1 do
        cb = arm64_mov_rr(cb, 8, 0)      # X8 = syscall num
        cb = arm64_mov_rr(cb, 0, 1)      # X0 = a1
        cb = arm64_mov_rr(cb, 1, 2)      # X1 = a2
        cb = arm64_mov_rr(cb, 2, 3)      # X2 = a3
        cb = arm64_mov_rr(cb, 3, 4)      # X3 = a4
        cb = arm64_mov_rr(cb, 4, 5)      # X4 = a5
        cb = arm64_mov_rr(cb, 5, 6)      # X5 = a6
        cb = arm64_svc(cb, 0)
        out arm64_ret(cb)
    else
        cb = arm64_mov_rr(cb, 16, 0)     # X16 = syscall num
        cb = codebuf_emit_u32(cb, 0xF2A04010) # MOVK X16, #0x200, LSL #16 (0x2000000 | num)
        cb = arm64_mov_rr(cb, 0, 1)      # X0 = a1
        cb = arm64_mov_rr(cb, 1, 2)      # X1 = a2
        cb = arm64_mov_rr(cb, 2, 3)      # X2 = a3
        cb = arm64_mov_rr(cb, 3, 4)      # X3 = a4
        cb = arm64_mov_rr(cb, 4, 5)      # X4 = a5
        cb = arm64_mov_rr(cb, 5, 6)      # X5 = a6
        cb = arm64_svc(cb, 0x80)
        cb = codebuf_emit_u32(cb, 0x54000043) # B.CC +8 (skip neg x0, x0 to ret if carry clear)
        cb = codebuf_emit_u32(cb, 0xCB0003E0) # NEG X0, X0 (x0 = -errno if carry set)
        out arm64_ret(cb)
    end
end.

# macOS BSD syscall: X16 = 0x2000000 | num, then svc #0x80
func emit_x16_bsd_syscall(cb: &CodeBuf, num: i64):
    cb = arm64_mov_imm16(cb, 16, num)
    cb = codebuf_emit_u32(cb, 0xF2A04010)   # movk x16, #0x200, lsl #16
    cb = arm64_svc(cb, 0x80)
    cb = codebuf_emit_u32(cb, 0x54000043)   # B.CC +8
    out codebuf_emit_u32(cb, 0xCB0003E0)   # NEG X0, X0
end.

func emit_lir_rt_exit_stub(cb: &CodeBuf, is_linux: i64):
    # X0 = exit code
    if is_linux == 1 do
        cb = arm64_mov_imm16(cb, 8, 93)   # sys_exit linux arm64
        cb = arm64_svc(cb, 0)
    else
        cb = arm64_mov_imm16(cb, 16, 1)   # SYS_exit bsd macos = 1
        cb = codebuf_emit_u32(cb, 0xF2A04010) # movk x16, #0x200, lsl #16 (0x2000001)
        cb = arm64_svc(cb, 0x80)
    end
    out arm64_ret(cb)
end.

func emit_arm64_open(cb: &CodeBuf, is_linux: i64, path_reg: i64, flags: i64, mode: i64):
    if is_linux == 1 do
        # openat(AT_FDCWD=-100, path, flags, mode)
        cb = arm64_mov_rr(cb, 1, path_reg)
        cb = arm64_mov_imm16(cb, 0, 100)
        cb = arm64_sub_rrr(cb, 0, 31, 0) # X0 = -100 (AT_FDCWD)
        cb = arm64_mov_imm16(cb, 2, flags)
        cb = arm64_mov_imm16(cb, 3, mode)
        cb = arm64_mov_imm16(cb, 8, 56)   # SYS_openat
        cb = arm64_svc(cb, 0)
    else
        cb = arm64_mov_rr(cb, 0, path_reg)
        cb = arm64_mov_imm16(cb, 1, flags)
        cb = arm64_mov_imm16(cb, 2, mode)
        cb = emit_x16_bsd_syscall(cb, 5)  # open
    end
    out cb
end.

func emit_arm64_close(cb: &CodeBuf, is_linux: i64, fd_reg: i64):
    cb = arm64_mov_rr(cb, 0, fd_reg)
    if is_linux == 1 do
        cb = arm64_mov_imm16(cb, 8, 57)   # SYS_close
        cb = arm64_svc(cb, 0)
    else
        cb = emit_x16_bsd_syscall(cb, 6)  # close
    end
    out cb
end.

func emit_arm64_read(cb: &CodeBuf, is_linux: i64, fd_reg: i64, buf_reg: i64, len_reg: i64):
    cb = arm64_mov_rr(cb, 0, fd_reg)
    cb = arm64_mov_rr(cb, 1, buf_reg)
    cb = arm64_mov_rr(cb, 2, len_reg)
    if is_linux == 1 do
        cb = arm64_mov_imm16(cb, 8, 63)   # SYS_read
        cb = arm64_svc(cb, 0)
    else
        cb = emit_x16_bsd_syscall(cb, 3)  # read
    end
    out cb
end.

func emit_arm64_write(cb: &CodeBuf, is_linux: i64, fd_reg: i64, buf_reg: i64, len_reg: i64):
    cb = arm64_mov_rr(cb, 0, fd_reg)
    cb = arm64_mov_rr(cb, 1, buf_reg)
    cb = arm64_mov_rr(cb, 2, len_reg)
    if is_linux == 1 do
        cb = arm64_mov_imm16(cb, 8, 64)   # SYS_write
        cb = arm64_svc(cb, 0)
    else
        cb = emit_x16_bsd_syscall(cb, 4)  # write
    end
    out cb
end.

func emit_arm64_lseek(cb: &CodeBuf, is_linux: i64, fd_reg: i64, offset: i64, whence: i64):
    cb = arm64_mov_rr(cb, 0, fd_reg)
    cb = arm64_mov_imm16(cb, 1, offset)
    cb = arm64_mov_imm16(cb, 2, whence)
    if is_linux == 1 do
        cb = arm64_mov_imm16(cb, 8, 62)   # SYS_lseek
        cb = arm64_svc(cb, 0)
    else
        cb = emit_x16_bsd_syscall(cb, 199) # lseek
    end
    out cb
end.

func emit_lir_rt_write_bytes_stub(cb: &CodeBuf, is_linux: i64):
    # X0=path(cstr), X1=data, X2=len → X0=1 on success
    cb = arm64_mov_rr(cb, 9, 1)             # save data
    cb = arm64_mov_rr(cb, 10, 2)            # save len
    cb = arm64_mov_rr(cb, 12, 0)            # save path

    # /dev/stdout is a symlink to the caller's fd 1 on Darwin.  Reopening it
    # with O_CREAT|O_TRUNC is not a valid stdout operation in all launch
    # environments (notably a captured pipe), so write it directly instead.
    # Keep the ordinary open/write/close path below for real filesystem paths.
    stdout_bytes = vec_new_rt()
    stdout_bytes = vec_push_rt(stdout_bytes, 47)   # /
    stdout_bytes = vec_push_rt(stdout_bytes, 100)  # d
    stdout_bytes = vec_push_rt(stdout_bytes, 101)  # e
    stdout_bytes = vec_push_rt(stdout_bytes, 118)  # v
    stdout_bytes = vec_push_rt(stdout_bytes, 47)   # /
    stdout_bytes = vec_push_rt(stdout_bytes, 115)  # s
    stdout_bytes = vec_push_rt(stdout_bytes, 116)  # t
    stdout_bytes = vec_push_rt(stdout_bytes, 100)  # d
    stdout_bytes = vec_push_rt(stdout_bytes, 111)  # o
    stdout_bytes = vec_push_rt(stdout_bytes, 117)  # u
    stdout_bytes = vec_push_rt(stdout_bytes, 116)  # t
    stdout_bytes = vec_push_rt(stdout_bytes, 0)    # terminator
    stdout_mismatches = vec_new_rt()
    var stdout_i = 0
    when stdout_i < vec_len_rt(stdout_bytes) loop
        cb = arm64_ldrb_uoff(cb, 13, 12, stdout_i)
        cb = arm64_mov_imm16(cb, 14, vec_get_rt(stdout_bytes, stdout_i))
        cb = arm64_cmp_rr(cb, 13, 14)
        mismatch_at = codebuf_offset(cb) as i64
        cb = arm64_bne_imm19(cb, 0)
        stdout_mismatches = vec_push_rt(stdout_mismatches, mismatch_at)
        stdout_i = stdout_i + 1
    end
    cb = arm64_mov_imm16(cb, 11, 1)
    cb = emit_arm64_write(cb, is_linux, 11, 9, 10)
    cb = arm64_mov_imm16(cb, 0, 1)
    cb = arm64_ret(cb)

    stdout_fallback = codebuf_offset(cb) as i64
    stdout_i = 0
    when stdout_i < vec_len_rt(stdout_mismatches) loop
        mismatch_at = vec_get_rt(stdout_mismatches, stdout_i)
        delta = stdout_fallback - mismatch_at
        imm19 = (delta shr 2) and 0x7FFFF
        cb = codebuf_patch_u32(cb, mismatch_at as int, 0x54000001 or (imm19 shl 5))
        stdout_i = stdout_i + 1
    end

    var flags = 1537                        # Darwin 0x601
    if is_linux == 1 do
        flags = 577                         # Linux 0x241
    end
    cb = emit_arm64_open(cb, is_linux, 12, flags, 420)
    cb = arm64_mov_rr(cb, 11, 0)            # save fd
    cb = emit_arm64_write(cb, is_linux, 11, 9, 10)
    cb = emit_arm64_close(cb, is_linux, 11)
    cb = arm64_mov_imm16(cb, 0, 1)
    out arm64_ret(cb)
end.

func emit_lir_rt_slurp_len_stub(cb: &CodeBuf, is_linux: i64):
    # X0=path(cstr) → X0=file length in bytes
    cb = arm64_mov_rr(cb, 12, 0)            # save path
    cb = emit_arm64_open(cb, is_linux, 12, 0, 0)
    cb = arm64_mov_rr(cb, 9, 0)             # save fd
    cb = emit_arm64_lseek(cb, is_linux, 9, 0, 2) # SEEK_END
    cb = arm64_mov_rr(cb, 10, 0)            # save len
    cb = emit_arm64_close(cb, is_linux, 9)
    cb = arm64_mov_rr(cb, 0, 10)
    out arm64_ret(cb)
end.

func emit_lir_rt_slurp_file_stub(cb: &CodeBuf, is_linux: i64):
    # X0=path(cstr), X1=buf, X2=len → X0=1 on success
    cb = arm64_mov_rr(cb, 9, 1)             # save buf
    cb = arm64_mov_rr(cb, 10, 2)            # save len
    cb = arm64_mov_rr(cb, 12, 0)            # save path
    cb = emit_arm64_open(cb, is_linux, 12, 0, 0)
    cb = arm64_mov_rr(cb, 11, 0)            # save fd
    cb = emit_arm64_read(cb, is_linux, 11, 9, 10)
    cb = emit_arm64_close(cb, is_linux, 11)
    cb = arm64_mov_imm16(cb, 0, 1)
    out arm64_ret(cb)
end.

