##
 * compiler/src/lower/lir_codegen/rt_stubs_base.vri — Memory & String Runtime Stubs
 * =================================================================================
 ##

include types_prelude
include rt_vec_rt
include rt_string_rt
include codegen
include target
include lir_codegen_types
include lir_codegen_intrinsics
include lir_codegen_calls

func emit_lir_rt_promote_stub(cb: &CodeBuf):
    let stub_entry_off = codebuf_offset(cb) as i64

    # X0 = p, X1 = arena_base, X2 = arena_top
    # Guard 1: if p < 65536: return p
    cb = arm64_movz_imm64(cb, 9, 65536)
    cb = arm64_cmp_rr(cb, 0, 9)
    let g1_fixup = codebuf_offset(cb) as int
    cb = arm64_blt_imm19(cb, 0)

    # Guard 2: if arena_base <= 0 or arena_top <= arena_base: return p
    cb = arm64_cmp_imm0(cb, 1)
    let g2_fixup = codebuf_offset(cb) as int
    cb = arm64_ble_imm19(cb, 0)

    cb = arm64_cmp_rr(cb, 2, 1)
    let g3_fixup = codebuf_offset(cb) as int
    cb = arm64_ble_imm19(cb, 0)

    # Guard 3: if p < arena_base: return p
    cb = arm64_cmp_rr(cb, 0, 1)
    let g4_fixup = codebuf_offset(cb) as int
    cb = arm64_blt_imm19(cb, 0)

    # Guard 4: if p >= arena_top: return p
    cb = arm64_cmp_rr(cb, 0, 2)
    let g5_fixup = codebuf_offset(cb) as int
    cb = arm64_bge_imm19(cb, 0)

    # Forwarding check at p - 16:
    cb = arm64_sub_imm(cb, 9, 0, 16)
    cb = arm64_ldr_uoff(cb, 10, 9, 8) # mark_flag
    cb = arm64_add_imm(cb, 11, 10, 1) # if mark_flag == -1, mark_flag + 1 == 0
    cb = arm64_cmp_imm0(cb, 11)
    let not_fwd_fixup = codebuf_offset(cb) as int
    cb = arm64_bne_imm19(cb, 0)

    # Forwarded! Return hdr[0]
    cb = arm64_ldr_uoff(cb, 0, 9, 0)
    cb = arm64_ret(cb)

    let not_fwd_off = codebuf_offset(cb) as int
    let imm_nf = ((not_fwd_off - not_fwd_fixup) shr 2) and 0x7FFFF
    codebuf_patch_u32(cb, not_fwd_fixup, (0x54000001 or (imm_nf shl 5)) as int)

    # Prologue: save X19-X22, FP, LR
    cb = arm64_sub_imm(cb, 31, 31, 48)
    cb = arm64_str_uoff(cb, 29, 31, 0)
    cb = arm64_str_uoff(cb, 30, 31, 8)
    cb = arm64_str_uoff(cb, 19, 31, 16)
    cb = arm64_str_uoff(cb, 20, 31, 24)
    cb = arm64_str_uoff(cb, 21, 31, 32)
    cb = arm64_str_uoff(cb, 22, 31, 40)
    cb = arm64_add_imm(cb, 29, 31, 0)

    cb = arm64_mov_rr(cb, 19, 0) # X19 = p
    cb = arm64_mov_rr(cb, 20, 1) # X20 = arena_base
    cb = arm64_mov_rr(cb, 21, 2) # X21 = arena_top

    # Read total_size from hdr[0]
    cb = arm64_sub_imm(cb, 9, 19, 16)
    cb = arm64_ldr_uoff(cb, 10, 9, 0) # total_size

    # Validate size:
    cb = arm64_cmp_imm0(cb, 10)
    let bad_sz_fixup = codebuf_offset(cb) as int
    cb = arm64_ble_imm19(cb, 0)
    cb = arm64_movz_imm64(cb, 11, 67108864)
    cb = arm64_cmp_rr(cb, 10, 11)
    let too_big_fixup = codebuf_offset(cb) as int
    cb = arm64_bgt_imm19(cb, 0)

    # payload_size = total_size - 16
    cb = arm64_sub_imm(cb, 12, 10, 16)
    let sz_ok_fixup = codebuf_offset(cb) as int
    cb = arm64_b_imm26(cb, 0)

    # Fallback size estimation from payload
    let bad_sz_off = codebuf_offset(cb) as int
    let imm_bs = ((bad_sz_off - bad_sz_fixup) shr 2) and 0x7FFFF
    codebuf_patch_u32(cb, bad_sz_fixup, (0x5400000D or (imm_bs shl 5)) as int)
    let imm_tb = ((bad_sz_off - too_big_fixup) shr 2) and 0x7FFFF
    codebuf_patch_u32(cb, too_big_fixup, (0x5400000C or (imm_tb shl 5)) as int)

    # Read array length: n = *p
    cb = arm64_ldr_uoff(cb, 10, 19, 0)
    cb = arm64_cmp_imm0(cb, 10)
    let neg_n_fixup = codebuf_offset(cb) as int
    cb = arm64_blt_imm19(cb, 0)
    cb = arm64_movz_imm64(cb, 11, 8388608)
    cb = arm64_cmp_rr(cb, 10, 11)
    let big_n_fixup = codebuf_offset(cb) as int
    cb = arm64_bgt_imm19(cb, 0)

    # size = (16 + n * 8 + 15) & ~15
    cb = arm64_lsl_imm(cb, 12, 10, 3)
    cb = arm64_add_imm(cb, 12, 12, 31)
    cb = arm64_lsr_imm(cb, 12, 12, 4)
    cb = arm64_lsl_imm(cb, 12, 12, 4)
    let fallback_ok_fixup = codebuf_offset(cb) as int
    cb = arm64_b_imm26(cb, 0)

    # Default size = 32
    let neg_n_off = codebuf_offset(cb) as int
    let imm_nn = ((neg_n_off - neg_n_fixup) shr 2) and 0x7FFFF
    codebuf_patch_u32(cb, neg_n_fixup, (0x5400000B or (imm_nn shl 5)) as int)
    let imm_bn = ((neg_n_off - big_n_fixup) shr 2) and 0x7FFFF
    codebuf_patch_u32(cb, big_n_fixup, (0x5400000C or (imm_bn shl 5)) as int)
    cb = arm64_mov_imm16(cb, 12, 32)

    let do_alloc_off = codebuf_offset(cb) as int
    let imm_sok = ((do_alloc_off - sz_ok_fixup) shr 2) and 0x3FFFFFF
    codebuf_patch_u32(cb, sz_ok_fixup, (0x14000000 or imm_sok) as int)
    let imm_fok = ((do_alloc_off - fallback_ok_fixup) shr 2) and 0x3FFFFFF
    codebuf_patch_u32(cb, fallback_ok_fixup, (0x14000000 or imm_fok) as int)

    # Allocate from permanent heap at *(X28 + 80):
    # total_alloc = payload_size (X12) + 16 (in X10)
    cb = arm64_add_imm(cb, 10, 12, 16)

    # cur_heap = *(X28 + 80)
    cb = arm64_ldr_uoff(cb, 11, 28, 80)
    cb = arm64_cbnz_imm19(cb, 11, 8)
    cb = arm64_ldr_uoff(cb, 11, 28, 24) # heap_end fallback

    # cur_heap = (cur_heap - total_alloc) & ~15
    cb = arm64_sub_rrr(cb, 11, 11, 10)
    cb = arm64_lsr_imm(cb, 11, 11, 4)
    cb = arm64_lsl_imm(cb, 11, 11, 4)
    cb = arm64_str_uoff(cb, 11, 28, 80)

    # Write new object header:
    cb = arm64_str_uoff(cb, 10, 11, 0) # hdr[0] = total_alloc
    cb = arm64_mov_imm16(cb, 13, 1)
    cb = arm64_str_uoff(cb, 13, 11, 8) # hdr[8] = 1

    # new_p = cur_heap + 16 (in X22)
    cb = arm64_add_imm(cb, 22, 11, 16)

    # Copy payload from p (X19) to new_p (X22): payload_size = X12
    cb = arm64_mov_imm16(cb, 13, 0)
    if target_has_neon() == 1 do
        let neon_loop_off = codebuf_offset(cb) as int
        cb = arm64_add_imm(cb, 14, 13, 16)
        cb = arm64_cmp_rr(cb, 14, 12)
        let neon_done_fixup = codebuf_offset(cb) as int
        cb = arm64_bgt_imm19(cb, 0)
        cb = codebuf_emit_u32(cb, 0x3CED6A60) # ldr q0, [x19, x13]
        cb = codebuf_emit_u32(cb, 0x3CAD6AC0) # str q0, [x22, x13]
        cb = arm64_add_imm(cb, 13, 13, 16)
        cb = arm64_b_imm26(cb, (neon_loop_off - (codebuf_offset(cb) as int)) as int)

        let neon_done_off = codebuf_offset(cb) as int
        let imm_nd = ((neon_done_off - neon_done_fixup) shr 2) and 0x7FFFF
        codebuf_patch_u32(cb, neon_done_fixup, (0x5400000C or (imm_nd shl 5)) as int)
    end
    let copy_loop_off = codebuf_offset(cb) as int
    cb = arm64_cmp_rr(cb, 13, 12)
    let copy_done_fixup = codebuf_offset(cb) as int
    cb = arm64_bge_imm19(cb, 0)
    cb = arm64_ldr_reg(cb, 14, 19, 13)
    cb = arm64_str_reg(cb, 14, 22, 13)
    cb = arm64_add_imm(cb, 13, 13, 8)
    cb = arm64_b_imm26(cb, (copy_loop_off - (codebuf_offset(cb) as int)) as int)

    let copy_done_off = codebuf_offset(cb) as int
    let imm_cd = ((copy_done_off - copy_done_fixup) shr 2) and 0x7FFFF
    codebuf_patch_u32(cb, copy_done_fixup, (0x5400000A or (imm_cd shl 5)) as int)

    # Mark original object as forwarded: hdr[8] = -1, hdr[0] = new_p
    cb = arm64_sub_imm(cb, 9, 19, 16)
    cb = arm64_mov_imm16(cb, 14, 0)
    cb = arm64_mvn_rr(cb, 14, 14)
    cb = arm64_str_uoff(cb, 14, 9, 8)
    cb = arm64_str_uoff(cb, 22, 9, 0)

    # Recursively promote child pointers in new_p:
    cb = arm64_mov_imm16(cb, 13, 0)
    let child_loop_off = codebuf_offset(cb) as int
    cb = arm64_cmp_rr(cb, 13, 12)
    let child_done_fixup = codebuf_offset(cb) as int
    cb = arm64_bge_imm19(cb, 0)

    cb = arm64_ldr_reg(cb, 0, 22, 13) # X0 = child
    cb = arm64_movz_imm64(cb, 9, 65536)
    cb = arm64_cmp_rr(cb, 0, 9)
    let skip_ch1 = codebuf_offset(cb) as int
    cb = arm64_blt_imm19(cb, 0)
    cb = arm64_cmp_rr(cb, 0, 20)
    let skip_ch2 = codebuf_offset(cb) as int
    cb = arm64_blt_imm19(cb, 0)
    cb = arm64_cmp_rr(cb, 0, 21)
    let skip_ch3 = codebuf_offset(cb) as int
    cb = arm64_bge_imm19(cb, 0)

    # Child needs promotion:
    cb = arm64_sub_imm(cb, 31, 31, 16)
    cb = arm64_str_uoff(cb, 13, 31, 0)
    cb = arm64_mov_rr(cb, 1, 20)
    cb = arm64_mov_rr(cb, 2, 21)
    let rel_self = stub_entry_off - (codebuf_offset(cb) as i64)
    cb = arm64_bl_imm26(cb, rel_self as int)
    cb = arm64_ldr_uoff(cb, 13, 31, 0)
    cb = arm64_add_imm(cb, 31, 31, 16)
    cb = arm64_str_reg(cb, 0, 22, 13)

    let next_ch_off = codebuf_offset(cb) as int
    let imm_sc1 = ((next_ch_off - skip_ch1) shr 2) and 0x7FFFF
    codebuf_patch_u32(cb, skip_ch1, (0x5400000B or (imm_sc1 shl 5)) as int)
    let imm_sc2 = ((next_ch_off - skip_ch2) shr 2) and 0x7FFFF
    codebuf_patch_u32(cb, skip_ch2, (0x5400000B or (imm_sc2 shl 5)) as int)
    let imm_sc3 = ((next_ch_off - skip_ch3) shr 2) and 0x7FFFF
    codebuf_patch_u32(cb, skip_ch3, (0x5400000A or (imm_sc3 shl 5)) as int)

    cb = arm64_add_imm(cb, 13, 13, 8)
    cb = arm64_b_imm26(cb, (child_loop_off - (codebuf_offset(cb) as int)) as int)

    let child_done_off = codebuf_offset(cb) as int
    let imm_cd2 = ((child_done_off - child_done_fixup) shr 2) and 0x7FFFF
    codebuf_patch_u32(cb, child_done_fixup, (0x5400000A or (imm_cd2 shl 5)) as int)

    # Return new_p:
    cb = arm64_mov_rr(cb, 0, 22)

    # Epilogue:
    cb = arm64_ldr_uoff(cb, 29, 31, 0)
    cb = arm64_ldr_uoff(cb, 30, 31, 8)
    cb = arm64_ldr_uoff(cb, 19, 31, 16)
    cb = arm64_ldr_uoff(cb, 20, 31, 24)
    cb = arm64_ldr_uoff(cb, 21, 31, 32)
    cb = arm64_ldr_uoff(cb, 22, 31, 40)
    cb = arm64_add_imm(cb, 31, 31, 48)
    cb = arm64_ret(cb)

    # Guard exits: return original p in X0
    let g_ret_off = codebuf_offset(cb) as int
    cb = arm64_ret(cb)
    let imm_g1 = ((g_ret_off - g1_fixup) shr 2) and 0x7FFFF
    codebuf_patch_u32(cb, g1_fixup, (0x5400000B or (imm_g1 shl 5)) as int)
    let imm_g2 = ((g_ret_off - g2_fixup) shr 2) and 0x7FFFF
    codebuf_patch_u32(cb, g2_fixup, (0x5400000D or (imm_g2 shl 5)) as int)
    let imm_g3 = ((g_ret_off - g3_fixup) shr 2) and 0x7FFFF
    codebuf_patch_u32(cb, g3_fixup, (0x5400000D or (imm_g3 shl 5)) as int)
    let imm_g4 = ((g_ret_off - g4_fixup) shr 2) and 0x7FFFF
    codebuf_patch_u32(cb, g4_fixup, (0x5400000B or (imm_g4 shl 5)) as int)
    let imm_g5 = ((g_ret_off - g5_fixup) shr 2) and 0x7FFFF
    codebuf_patch_u32(cb, g5_fixup, (0x5400000A or (imm_g5 shl 5)) as int)

    out cb
end.

func emit_lir_rt_arg_count_stub(cb: &CodeBuf):
    cb = arm64_ldr_uoff(cb, 0, 28, 8)
    out arm64_ret(cb)
end.

func emit_lir_rt_get_arg_stub(cb: &CodeBuf):
    # X0 = arg index (0..N-1)
    cb = arm64_ldr_uoff(cb, 1, 28, 8)      # X1 = argc
    cb = arm64_cmp_rr(cb, 0, 1)
    cb = arm64_bge_imm19(cb, 20)           # if idx >= argc -> return null

    cb = arm64_ldr_uoff(cb, 2, 28, 16)     # X2 = argv base ptr (load char** pointer)
    cb = arm64_lsl_imm(cb, 3, 0, 3)        # X3 = idx * 8
    cb = arm64_ldr_reg(cb, 0, 2, 3)        # X0 = argv[idx]
    cb = arm64_ret(cb)

    cb = arm64_mov_imm16(cb, 0, 0)
    out arm64_ret(cb)
end.

func emit_lir_rt_read_i64_stub(cb: &CodeBuf):
    cb = arm64_ldr_reg(cb, 0, 0, 1)
    out arm64_ret(cb)
end.

func emit_lir_rt_write_i64_stub(cb: &CodeBuf):
    cb = arm64_str_reg(cb, 2, 0, 1)
    out arm64_ret(cb)
end.

func emit_lir_rt_volatile_read_stub(cb: &CodeBuf):
    cb = arm64_dmb_ishld(cb)
    cb = arm64_ldr_uoff(cb, 0, 0, 0)
    cb = arm64_dmb_ishld(cb)
    out arm64_ret(cb)
end.

func emit_lir_rt_volatile_write_stub(cb: &CodeBuf):
    cb = arm64_dmb_ishst(cb)
    cb = arm64_str_uoff(cb, 1, 0, 0)
    cb = arm64_dmb_ishst(cb)
    out arm64_ret(cb)
end.

