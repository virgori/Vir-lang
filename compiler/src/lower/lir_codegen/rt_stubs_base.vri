    cb = arm64_dmb_ishld(cb)
    cb = arm64_ldrb_uoff(cb, 0, 0, 0)
    cb = arm64_dmb_ishld(cb)
    out arm64_ret(cb)
end.

func emit_lir_rt_volatile_write8_stub(cb: &CodeBuf):
    cb = arm64_dmb_ishst(cb)
    cb = arm64_strb_uoff(cb, 1, 0, 0)
    cb = arm64_dmb_ishst(cb)
    out arm64_ret(cb)
end.

func emit_lir_rt_atomic_load32_stub(cb: &CodeBuf):
