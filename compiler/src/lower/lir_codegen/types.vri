##
 * compiler/src/lower/lir_codegen/types.vri — LIR ARM64 ABI, Fixups & Frame Helpers
 * ================================================================================
 ##

include types_prelude
include rt_vec_rt
include rt_string_rt
import print_str, print_int from rt_io
import sys_exit from rt_syscall
include lir
include mir
include ffi_imports
include codegen
include target

func vec_new_cap_rt(cap: int):
    base = alloc(16 + cap * 8)
    data = base + 16
    native_write_i64(base, 0, cap as i64)
    native_write_i64(base, 8, 0)
    out data
end.

func lir_fixup_new(at_off: i64, target_block: i64, kind: i64):
    p = alloc(24)
    native_write_i64(p, 0, at_off)
    native_write_i64(p, 8, target_block)
    native_write_i64(p, 16, kind)
    out p
end.

func lir_fixup_at_off(fx: LirFixup): out native_read_i64(fx as i64, 0) end.
func lir_fixup_target_block(fx: LirFixup): out native_read_i64(fx as i64, 8) end.
func lir_fixup_kind(fx: LirFixup): out native_read_i64(fx as i64, 16) end.

func lir_call_fixup_new(at_off: i64, target_kind: i64, target_id: i64, rd: i64):
    p = alloc(32)
    native_write_i64(p, 0, at_off)
    native_write_i64(p, 8, target_kind)
    native_write_i64(p, 16, target_id)
    native_write_i64(p, 24, rd)
    out p
end.

func lir_str_fixup_new(at_off: i64, str_val: i64, rd: i64):
    p = alloc(24)
    native_write_i64(p, 0, at_off)
    native_write_i64(p, 8, str_val)
    native_write_i64(p, 16, rd)
    out p
end.

func resolve_reg(opnd: &LirOperand, assigned_phys: i64):
    if (opnd as i64) == 0 do
        out 0 - 1
    end
    typ = native_read_i64(opnd as i64, 0)
    if typ == 1 or typ == 2 do
        if assigned_phys >= 0 do
            vid = native_read_i64(opnd as i64, 8)
            if vid >= 0 and vid < vec_len_rt(assigned_phys) do
                col = vec_get_rt(assigned_phys, vid)
                if col >= 0 and col < 8 do
                    out (col + 20)
                end
                out col
            end
        end
        out native_read_i64(opnd as i64, 8)
    end
    if typ == 3 do # PhysReg
        out native_read_i64(opnd as i64, 16)
    end
    out 0 - 1
end.

func emit_fp_sub_addr(cb: &CodeBuf, rd: i64, distance: i64):
    # ARM64 SUB (immediate) only carries 12 immediate bits. Large frames must
    # materialize the full distance or offsets such as 4096 alias FP+0 and
    # overwrite the frame header/callee-save area.
    if distance <= 4095 do
        out arm64_sub_imm(cb, rd as int, 29, distance as int)
    end
    cb = arm64_movz_imm64(cb, rd as int, distance as int)
    out arm64_sub_rrr(cb, rd as int, 29, rd as int)
end.

func resolve_or_imm_reg(cb: &CodeBuf, opnd: &LirOperand, assigned_phys: i64, scratch: i64):
    if (opnd as i64) == 0 do
        out scratch
    end
    r = resolve_reg(opnd, assigned_phys)
    if r >= 0 do
        out r
    end
    typ = native_read_i64(opnd as i64, 0)
    if typ == 5 do # Imm
        imm_val = native_read_i64(opnd as i64, 32)
        cb = arm64_movz_imm64(cb, scratch as int, imm_val as int)
        out scratch
    end
    if typ == 4 do # StackMem
        off = native_read_i64(opnd as i64, 24)
        if off < 0 and off >= 0 - 255 do
            cb = arm64_ldur(cb, scratch as int, 29, off as int)
            out scratch
        else
            if off < 0 do
                cb = emit_fp_sub_addr(cb, scratch, 0 - off)
                cb = arm64_ldr_uoff(cb, scratch as int, scratch as int, 0)
                out scratch
            end
        end
    end
    if typ == 3 do # PhysReg
        out native_read_i64(opnd as i64, 16)
    end
    out scratch
end.

func lir_opnd_spill_off(opnd: i64):
    # Returns the negative stack offset if `opnd` is a StackMem slot, else 0.
    if opnd == 0 do
        out 0
    end
    if native_read_i64(opnd, 0) == 4 do
        out native_read_i64(opnd, 24)
    end
    out 0
end.

func robust_src_reg(cb: &CodeBuf, opnd: i64, assigned_phys: i64, scratch: i64):
    # Like resolve_reg, but transparently reloads a spilled (StackMem) source
    # into `scratch` so every consumer sees a real register.
    if opnd == 0 do
        out 0 - 1
    end
    r = resolve_reg(opnd as LirOperand, assigned_phys)
    if r >= 0 do
        out r
    end
    if native_read_i64(opnd, 0) == 4 do
        out resolve_or_imm_reg(cb, opnd as LirOperand, assigned_phys, scratch)
    end
    out r
end.

func lir_load_opnd_to_reg(cb: &CodeBuf, opnd: i64, assigned_phys: i64, scratch: i64):
    if opnd == 0 do
        out (cb, scratch)
    end
    typ = native_read_i64(opnd, 0)
    if typ == 5 do # Imm
        cb = arm64_movz_imm64(cb, scratch as int, native_read_i64(opnd, 32) as int)
        out (cb, scratch)
    end
    if typ == 4 do # StackMem
        off = native_read_i64(opnd, 24)
        if off < 0 and off >= 0 - 255 do
            cb = arm64_ldur(cb, scratch as int, 29, off as int)
        else
            if off < 0 do
                cb = emit_fp_sub_addr(cb, scratch, 0 - off)
                cb = arm64_ldr_uoff(cb, scratch as int, scratch as int, 0)
            end
        end
        out (cb, scratch)
    end
    if typ == 3 do # PhysReg
        out (cb, native_read_i64(opnd, 16))
    end
    r = resolve_reg(opnd as LirOperand, assigned_phys)
    if r >= 0 do
        out (cb, r)
    end
    out (cb, scratch)
end.

func lir_materialize_opnd_to_reg(cb: &CodeBuf, opnd: i64, assigned_phys: i64, target: i64):
    var (cb1, r) = lir_load_opnd_to_reg(cb, opnd, assigned_phys, target)
    if r >= 0 and r != target do
        cb1 = arm64_mov_rr(cb1, target as int, r as int)
    end
    out cb1
end.

func emit_spill_store(cb: &CodeBuf, opnd: i64, src_reg: i64):
    off = lir_opnd_spill_off(opnd)
    if off < 0 and off >= 0 - 255 do
        cb = arm64_stur(cb, src_reg as int, 29, off as int)
    else
        if off < 0 do
            cb = emit_fp_sub_addr(cb, 13, 0 - off)
            cb = arm64_str_uoff(cb, src_reg as int, 13, 0)
        end
    end
    out cb
end.

func emit_cmp_cset(cb: &CodeBuf, rd: i64, rs1: i64, rs2: i64, pred: i64):
    cb = arm64_cmp_rr(cb, rs1 as int, rs2 as int)
    if pred == LIR_CMP_EQ do
        out arm64_cset_eq(cb, rd as int)
    eif pred == LIR_CMP_NE do
        out arm64_cset_ne(cb, rd as int)
    eif pred == LIR_CMP_GT do
        out arm64_cset_gt(cb, rd as int)
    eif pred == LIR_CMP_LT do
        out arm64_cset_lt(cb, rd as int)
    eif pred == LIR_CMP_GE do
        out arm64_cset_ge(cb, rd as int)
    eif pred == LIR_CMP_LE do
        out arm64_cset_le(cb, rd as int)
    end
    out arm64_cset_eq(cb, rd as int)
end.

func arm64_cond_code(pred: i64, is_ifnot: i64):
    if is_ifnot == 0 do
        if pred == LIR_CMP_EQ do out 0 end    # EQ (0x0)
        if pred == LIR_CMP_NE do out 1 end    # NE (0x1)
        if pred == LIR_CMP_GE do out 10 end   # GE (0xA)
        if pred == LIR_CMP_LT do out 11 end   # LT (0xB)
        if pred == LIR_CMP_GT do out 12 end   # GT (0xC)
        if pred == LIR_CMP_LE do out 13 end   # LE (0xD)
        out 0
    end
    # Inverted condition (IFNOT)
    if pred == LIR_CMP_EQ do out 1 end        # NE (0x1)
    if pred == LIR_CMP_NE do out 0 end        # EQ (0x0)
    if pred == LIR_CMP_GE do out 11 end       # LT (0xB)
    if pred == LIR_CMP_LT do out 10 end       # GE (0xA)
    if pred == LIR_CMP_GT do out 13 end       # LE (0xD)
    if pred == LIR_CMP_LE do out 12 end       # GT (0xC)
    out 1
end.

func lir_opnd_matches(o1: i64, o2: i64):
    if o1 == 0 or o2 == 0 do out 0 end
    t1 = native_read_i64(o1, 0)
    t2 = native_read_i64(o2, 0)
    if t1 != t2 do out 0 end
    if t1 == 1 do
        v1 = native_read_i64(o1, 8)
        v2 = native_read_i64(o2, 8)
        if v1 == v2 do out 1 end
    end
    if t1 == 2 do
        v1 = native_read_i64(o1, 16)
        v2 = native_read_i64(o2, 16)
        if v1 == v2 do out 1 end
    end
    out 0
end.

func arm64_and_mask(cb: &CodeBuf, rd: int, rn: int, mask: i64):
    if mask == 255 do       # 0xFF (8-bit) -> uxtb w_rd, w_rn
        out codebuf_emit_u32(cb, 0x53001C00 or ((rn and 0x1F) shl 5) or (rd and 0x1F))
    end
    if mask == 4095 do      # 0xFFF (12-bit) -> ubfx w_rd, w_rn, #0, #12
        out codebuf_emit_u32(cb, 0x53002C00 or ((rn and 0x1F) shl 5) or (rd and 0x1F))
    end
    if mask == 65535 do     # 0xFFFF (16-bit) -> uxth w_rd, w_rn
        out codebuf_emit_u32(cb, 0x53003C00 or ((rn and 0x1F) shl 5) or (rd and 0x1F))
    end
    if mask == 4294967295 do # 0xFFFFFFFF (32-bit) -> mov w_rd, w_rn (ORR Wd, WZR, Wn)
        out codebuf_emit_u32(cb, 0x2A0003E0 or ((rn and 0x1F) shl 16) or (rd and 0x1F))
    end
    out cb
end.

# ── ARM64 NEON 128-bit SIMD Emitters ──────────────────────────────
func arm64_neon_ld1_2d(cb: &CodeBuf, vt: int, xn: int):
    # LD1 {Vt.2D}, [Xn] -> 0x4C407000 | (Xn << 5) | Vt
    out codebuf_emit_u32(cb, 0x4C407000 or ((xn and 0x1F) shl 5) or (vt and 0x1F))
end.

func arm64_neon_st1_2d(cb: &CodeBuf, vt: int, xn: int):
    # ST1 {Vt.2D}, [Xn] -> 0x4C007000 | (Xn << 5) | Vt
    out codebuf_emit_u32(cb, 0x4C007000 or ((xn and 0x1F) shl 5) or (vt and 0x1F))
end.

func arm64_neon_ld1_4s(cb: &CodeBuf, vt: int, xn: int):
    # LD1 {Vt.4S}, [Xn] -> 0x4C402000 | (Xn << 5) | Vt
    out codebuf_emit_u32(cb, 0x4C402000 or ((xn and 0x1F) shl 5) or (vt and 0x1F))
end.

func arm64_neon_st1_4s(cb: &CodeBuf, vt: int, xn: int):
    # ST1 {Vt.4S}, [Xn] -> 0x4C002000 | (Xn << 5) | Vt
    out codebuf_emit_u32(cb, 0x4C002000 or ((xn and 0x1F) shl 5) or (vt and 0x1F))
end.

func arm64_neon_add_2d(cb: &CodeBuf, vd: int, vn: int, vm: int):
    # ADD Vd.2D, Vn.2D, Vm.2D -> 0x4EE08400 | (Vm << 16) | (Vn << 5) | Vd
    out codebuf_emit_u32(cb, 0x4EE08400 or ((vm and 0x1F) shl 16) or ((vn and 0x1F) shl 5) or (vd and 0x1F))
end.

func arm64_neon_sub_2d(cb: &CodeBuf, vd: int, vn: int, vm: int):
    # SUB Vd.2D, Vn.2D, Vm.2D -> 0x4EE08C00 | (Vm << 16) | (Vn << 5) | Vd
    out codebuf_emit_u32(cb, 0x4EE08C00 or ((vm and 0x1F) shl 16) or ((vn and 0x1F) shl 5) or (vd and 0x1F))
end.

func arm64_neon_eor_16b(cb: &CodeBuf, vd: int, vn: int, vm: int):
    # EOR Vd.16B, Vn.16B, Vm.16B -> 0x6E201C00 | (Vm << 16) | (Vn << 5) | Vd
    out codebuf_emit_u32(cb, 0x6E201C00 or ((vm and 0x1F) shl 16) or ((vn and 0x1F) shl 5) or (vd and 0x1F))
end.

func arm64_neon_orr_16b(cb: &CodeBuf, vd: int, vn: int, vm: int):
    # ORR Vd.16B, Vn.16B, Vm.16B -> 0x4EA01C00 | (Vm << 16) | (Vn << 5) | Vd
    out codebuf_emit_u32(cb, 0x4EA01C00 or ((vm and 0x1F) shl 16) or ((vn and 0x1F) shl 5) or (vd and 0x1F))
end.

func arm64_neon_and_16b(cb: &CodeBuf, vd: int, vn: int, vm: int):
    # AND Vd.16B, Vn.16B, Vm.16B -> 0x4E201C00 | (Vm << 16) | (Vn << 5) | Vd
    out codebuf_emit_u32(cb, 0x4E201C00 or ((vm and 0x1F) shl 16) or ((vn and 0x1F) shl 5) or (vd and 0x1F))
end.

func arm64_neon_fmla_4s(cb: &CodeBuf, vd: int, vn: int, vm: int):
    # FMLA Vd.4S, Vn.4S, Vm.4S -> 0x4E20CC00 | (Vm << 16) | (Vn << 5) | Vd
    out codebuf_emit_u32(cb, 0x4E20CC00 or ((vm and 0x1F) shl 16) or ((vn and 0x1F) shl 5) or (vd and 0x1F))
end.

func arm64_neon_fmla_2d(cb: &CodeBuf, vd: int, vn: int, vm: int):
    # FMLA Vd.2D, Vn.2D, Vm.2D -> 0x4EE0CC00 | (Vm << 16) | (Vn << 5) | Vd
    out codebuf_emit_u32(cb, 0x4EE0CC00 or ((vm and 0x1F) shl 16) or ((vn and 0x1F) shl 5) or (vd and 0x1F))
end.

func arm64_neon_dup_2d_gpr(cb: &CodeBuf, vd: int, xn: int):
    # DUP Vd.2D, Xn -> 0x4E080C00 | ((xn & 0x1F) << 5) | (vd & 0x1F)
    out codebuf_emit_u32(cb, 0x4E080C00 or ((xn and 0x1F) shl 5) or (vd and 0x1F))
end.

# ── Apple AMX (Apple Matrix Coprocessor) Direct Emitters ───────────
func arm64_amx_set(cb: &CodeBuf):
    # AMXSET -> Enable AMX hardware coprocessor
    out codebuf_emit_u32(cb, 0x00201000)
end.

func arm64_amx_clr(cb: &CodeBuf):
    # AMXCLR -> Disable / Clear AMX coprocessor state
    out codebuf_emit_u32(cb, 0x00201020)
end.

func arm64_amx_ldx(cb: &CodeBuf, xn: int):
    # AMX_LDX Xn -> Load 64-byte row from [Xn] into Matrix X
    out codebuf_emit_u32(cb, 0x00201000 or (xn and 0x1F))
end.

func arm64_amx_ldy(cb: &CodeBuf, xn: int):
    # AMX_LDY Xn -> Load 64-byte column from [Xn] into Matrix Y
    out codebuf_emit_u32(cb, 0x00201020 or (xn and 0x1F))
end.

func arm64_amx_fma64(cb: &CodeBuf, xn: int):
    # AMX_FMA64 Xn -> Outer-product FP64 multiply-accumulate: Z += X (x) Y
    out codebuf_emit_u32(cb, 0x00201180 or (xn and 0x1F))
end.

func arm64_amx_stz(cb: &CodeBuf, xn: int):
    # AMX_STZ Xn -> Store Matrix Z accumulator tile to [Xn]
    out codebuf_emit_u32(cb, 0x00201080 or (xn and 0x1F))
end.

func arm64_cmp_imm(cb: &CodeBuf, rn: int, imm: int):
    instr = 0xF100001F or ((imm and 0xFFF) shl 10) or ((rn and 0x1F) shl 5)
    out codebuf_emit_u32(cb, instr)
end.

func is_opnd_used_later(instrs: i64, start_idx: i64, n_instrs: i64, target_opnd: i64):
    var idx = start_idx
    when idx < n_instrs loop
        ins = vec_get_rt(instrs, idx)
        s1 = native_read_i64(ins as i64, 24)
        s2 = native_read_i64(ins as i64, 32)
        if lir_opnd_matches(target_opnd, s1) == 1 or lir_opnd_matches(target_opnd, s2) == 1 do
            out 1
        end
        d = native_read_i64(ins as i64, 16)
        if lir_opnd_matches(target_opnd, d) == 1 do
            out 0
        end
        idx = idx + 1
    end
    out 0
end.

func is_inlined_imm_consumer(instrs: i64, ii: i64, n_instrs: i64, imm_dst: i64, imm_val: i64):
    if (ii + 1) >= n_instrs do
        out 0
    end
    next_ins = vec_get_rt(g_codegen_cur_instrs, ii + 1)
    next_op = native_read_i64(next_ins as i64, 0)
    next_src1 = native_read_i64(next_ins as i64, 24)
    next_src2 = native_read_i64(next_ins as i64, 32)
    if (next_op == (LirOp.Add as i64) or next_op == (LirOp.Sub as i64) or next_op == (LirOp.Cmp as i64)) and imm_val >= 0 and imm_val <= 4095 do
        if lir_opnd_matches(imm_dst, next_src2) == 1 or lir_opnd_matches(imm_dst, next_src1) == 1 do
            if is_opnd_used_later(instrs, ii + 2, n_instrs, imm_dst) == 0 do
                out 1
            end
        end
    end
    if next_op == (LirOp.And as i64) and (imm_val == 255 or imm_val == 4095 or imm_val == 65535 or imm_val == 4294967295) do
        if lir_opnd_matches(imm_dst, next_src2) == 1 or lir_opnd_matches(imm_dst, next_src1) == 1 do
            if is_opnd_used_later(instrs, ii + 2, n_instrs, imm_dst) == 0 do
                out 1
            end
        end
    end
    out 0
end.

func is_inlined_builtin_arg(instrs: i64, ii: i64, n_instrs: i64):
    var k = 1
    when k <= 4 loop
        if (ii + k) < n_instrs do
            target_ins = vec_get_rt(instrs, ii + k)
            top = native_read_i64(target_ins as i64, 0)
            if top == (LirOp.Intrinsic as i64) do
                tkind = native_read_i64(target_ins as i64, 40)
                if tkind == MIR_INTR_BUILTIN do
                    tsrc1 = native_read_i64(target_ins as i64, 24)
                    if (tsrc1 as i64) != 0 do
                        tbid = native_read_i64(tsrc1 as i64, 32)
                        if tbid == 3 or tbid == 5 or tbid == 6 or tbid == 7 or tbid == 8 or tbid == 32 do
                            out 1
                        end
                    end
                end
            end
            if top != (LirOp.SetArg as i64) and top != (LirOp.Mov as i64) do
                out 0
            end
        end
        k = k + 1
    end
    out 0
end.

func lir_intr_is_marker(kind: i64):
    if kind == MIR_INTR_NOP_MARKER or kind == MIR_INTR_DECL or kind == MIR_INTR_QUIET or kind == MIR_INTR_CHECK_CPU or kind == MIR_INTR_PATCH_POINT or kind == MIR_INTR_PRECOMP or kind == MIR_INTR_EXPOSE or kind == MIR_INTR_ASYNC or kind == MIR_INTR_ATOMIC_VAR or kind == MIR_INTR_TIMEOUT or kind == MIR_INTR_ISOLATE or kind == MIR_INTR_PTR or kind == MIR_INTR_AWAIT_PASS or kind == MIR_INTR_ENSURE or kind == MIR_INTR_REVERT or kind == MIR_INTR_ENUM or kind == MIR_INTR_ERROR or kind == MIR_INTR_EXIST or kind == MIR_INTR_REACTIVE or kind == MIR_INTR_MORPH or kind == MIR_INTR_TRY or kind == MIR_INTR_RESUME or kind == MIR_INTR_EMIT do
        out 1
    end
    out 0
end.

func lir_intr_is_payload(kind: i64):
    if (kind and 0xFF) == MIR_INTR_CAST do
        out 1
    end
    out 0
end.

func lir_instr_has_def(ins: LirInstr):
    if (ins as i64) == 0 do out 0 end
    ins_i = ins as i64
    dst = native_read_i64(ins_i, 16)
    if dst == 0 do out 0 end
    if native_read_i64(dst, 0) == 0 do out 0 end
    op = native_read_i64(ins_i, 0)
    if op == (LirOp.Nop as i64) or op == (LirOp.Jmp as i64) or op == (LirOp.JmpCond as i64) or op == (LirOp.Ret as i64) or op == (LirOp.Push as i64) or op == (LirOp.Store as i64) or op == (LirOp.SetArg as i64) or op == (LirOp.TailCall as i64) or op == (LirOp.VStore as i64) or (op >= (LirOp.VLoad as i64) and op <= (LirOp.Shuffle as i64)) do
        out 0
    end
    if op == (LirOp.Intrinsic as i64) do
        kind = native_read_i64(ins_i, 40)
        if lir_intr_is_marker(kind) == 1 do
            out 0
        end
        if kind == MIR_INTR_GLOBAL_STORE or kind == MIR_INTR_INDEX_STORE or kind == MIR_INTR_FIELD_STORE or kind == MIR_INTR_THROW or kind == MIR_INTR_PRINT or kind == MIR_INTR_PRINT_STR or kind == MIR_INTR_PRINT_FLOAT or kind == MIR_INTR_PRINT_BOOL or kind == MIR_INTR_TRAIN or kind == MIR_INTR_INFER do
            out 0
        end
        if kind == MIR_MEM_PROMOTE do
            out 1
        end
        if kind == MIR_INTR_ARENA or kind == MIR_MEM_MARK or kind == MIR_MEM_RESET or kind == MIR_MEM_DROP do
            s1 = native_read_i64(ins_i, 24)
            if s1 != 0 and native_read_i64(s1, 0) != 0 do
                out 0
            end
            out 1
        end
        if kind == MIR_INTR_BUILTIN do
            s1 = native_read_i64(ins_i, 24)
            if s1 != 0 and native_read_i64(s1, 0) == 5 do
                bid = native_read_i64(s1, 32)
                if bid == 6 or bid == 8 or bid == 47 or bid == 32 or bid == 51 or bid == 18 do
                    out 0
                end
            end
        end
        out 1
    end
    out 1
end.

func lir_stub_for_builtin_id(bid: i64):
    if bid == 3 or bid == 49 or bid == 50 do out LIR_RT_ALLOC end
    if bid == 4 do out LIR_RT_FREE end

    if bid == 18 do out LIR_RT_EXIT_PROG end
    if bid == 22 do out LIR_RT_PRINT_STR end
    if bid == 9 do out LIR_RT_STR_LEN end
    if bid == 11 do out LIR_RT_STR_CAT end
    if bid == 12 do out LIR_RT_STR_EQ end
    if bid == 19 do out LIR_RT_INT_TO_STR end
    if bid == 1000 do out LIR_RT_BOOL_TO_STR end
    if bid == 25 do out LIR_RT_SLURP_FILE end
    if bid == 26 do out LIR_RT_SLURP_LEN end
    if bid == 27 do out LIR_RT_WRITE_BYTES end
    if bid == 5 do out LIR_RT_NATIVE_READ_U8 end
    if bid == 6 do out LIR_RT_NATIVE_WRITE_U8 end
    if bid == 7 or bid == 46 do out LIR_RT_NATIVE_READ_I64 end
    if bid == 8 or bid == 47 do out LIR_RT_NATIVE_WRITE_I64 end
    if bid == 23 do out LIR_RT_GET_ARG end
    if bid == 24 do out LIR_RT_ARG_COUNT end
    if bid == 54 or bid == 60 or bid == 62 do out LIR_RT_VOLATILE_READ end
    if bid == 55 or bid == 61 or bid == 63 do out LIR_RT_VOLATILE_WRITE end
    if bid == 56 or bid == 58 do out LIR_RT_VOLATILE_READ8 end
    if bid == 57 or bid == 59 do out LIR_RT_VOLATILE_WRITE8 end
    if bid == 64 or bid == 39 do out LIR_RT_DMB end
    if bid == 65 do out LIR_RT_DSB end
    if bid == 66 do out LIR_RT_ISB end
    if bid == 67 do out LIR_RT_WFI end
    if bid == 68 do out LIR_RT_WFE end
    if bid == 69 do out LIR_RT_SEV end
    if bid == 70 or bid == 31 or bid == 32 do out LIR_RT_NOP end

    if bid == 40 or bid == 78 do out LIR_RT_ATOMIC_LOAD64 end
    if bid == 72 do out LIR_RT_ATOMIC_LOAD32 end
    if bid == 41 or bid == 79 do out LIR_RT_ATOMIC_STORE64 end
    if bid == 73 do out LIR_RT_ATOMIC_STORE32 end
    if bid == 43 or bid == 80 do out LIR_RT_ATOMIC_ADD64 end
    if bid == 74 do out LIR_RT_ATOMIC_ADD32 end
    if bid == 44 or bid == 81 do out LIR_RT_ATOMIC_SUB64 end
    if bid == 75 do out LIR_RT_ATOMIC_SUB32 end
    if bid == 30 do out LIR_RT_SYSCALL end
    if bid == 42 or bid == 82 do out LIR_RT_ATOMIC_CAS64 end
    if bid == 76 do out LIR_RT_ATOMIC_CAS32 end
    if bid == 71 or bid == 83 do out LIR_RT_ATOMIC_EXCHANGE64 end
    if bid == 1 or bid == 20 do out LIR_RT_ARR_LEN end
    if bid == 2 do out LIR_RT_ARR_PUSH end
    if bid == 21 do out LIR_RT_ARR_NEW end
    if bid == 90 do out LIR_RT_PORT_CREATE end
    if bid == 105 do out LIR_RT_PLATFORM end
    out 0 - 1
end.

func lir_stub_for_callee_name(cname: string):
    if fat_cstr_eq(cname, "read_byte") or fat_cstr_eq(cname, "native_read_u8") or fat_cstr_eq(cname, "read_u8") or fat_cstr_eq(cname, "read8") or rt_streq(cname as int, "read_byte") or rt_streq(cname as int, "native_read_u8") or rt_streq(cname as int, "read_u8") or rt_streq(cname as int, "read8") do out LIR_RT_NATIVE_READ_U8 end
    if fat_cstr_eq(cname, "write_byte") or fat_cstr_eq(cname, "native_write_u8") or fat_cstr_eq(cname, "write_u8") or fat_cstr_eq(cname, "write8") or rt_streq(cname as int, "write_byte") or rt_streq(cname as int, "native_write_u8") or rt_streq(cname as int, "write_u8") or rt_streq(cname as int, "write8") do out LIR_RT_NATIVE_WRITE_U8 end
    if fat_cstr_eq(cname, "read_word") or fat_cstr_eq(cname, "native_read_i64") or fat_cstr_eq(cname, "native_read_f64") or fat_cstr_eq(cname, "read_i64") or fat_cstr_eq(cname, "read64") or rt_streq(cname as int, "read_word") or rt_streq(cname as int, "native_read_i64") or rt_streq(cname as int, "native_read_f64") or rt_streq(cname as int, "read_i64") or rt_streq(cname as int, "read64") do out LIR_RT_NATIVE_READ_I64 end
    if fat_cstr_eq(cname, "write_word") or fat_cstr_eq(cname, "native_write_i64") or fat_cstr_eq(cname, "native_write_f64") or fat_cstr_eq(cname, "write_i64") or fat_cstr_eq(cname, "write64") or rt_streq(cname as int, "write_word") or rt_streq(cname as int, "native_write_i64") or rt_streq(cname as int, "native_write_f64") or rt_streq(cname as int, "write_i64") or rt_streq(cname as int, "write64") do out LIR_RT_NATIVE_WRITE_I64 end
    if fat_cstr_eq(cname, "get_arg") or fat_cstr_eq(cname, "rt_argv") or fat_cstr_eq(cname, "rt_get_arg") or rt_streq(cname as int, "get_arg") or rt_streq(cname as int, "rt_argv") or rt_streq(cname as int, "rt_get_arg") do out LIR_RT_GET_ARG end
    if fat_cstr_eq(cname, "arg_count") or fat_cstr_eq(cname, "rt_argc") or rt_streq(cname as int, "arg_count") or rt_streq(cname as int, "rt_argc") do out LIR_RT_ARG_COUNT end
    if fat_cstr_eq(cname, "alloc") or rt_streq(cname as int, "alloc") do out LIR_RT_ALLOC end
    if fat_cstr_eq(cname, "free") or fat_cstr_eq(cname, "dealloc") or rt_streq(cname as int, "free") or rt_streq(cname as int, "dealloc") do out LIR_RT_FREE end

    if fat_cstr_eq(cname, "print_str") or rt_streq(cname as int, "print_str") do out LIR_RT_PRINT_STR end
    if fat_cstr_eq(cname, "str_len") or rt_streq(cname as int, "str_len") do out LIR_RT_STR_LEN end
    if fat_cstr_eq(cname, "str_cat") or fat_cstr_eq(cname, "str_concat") or fat_cstr_eq(cname, "strcat") or rt_streq(cname as int, "str_cat") or rt_streq(cname as int, "str_concat") or rt_streq(cname as int, "strcat") do out LIR_RT_STR_CAT end
    if fat_cstr_eq(cname, "str_eq") or rt_streq(cname as int, "str_eq") do out LIR_RT_STR_EQ end
    if fat_cstr_eq(cname, "write_bytes") or rt_streq(cname as int, "write_bytes") do out LIR_RT_WRITE_BYTES end
    if fat_cstr_eq(cname, "slurp_len") or rt_streq(cname as int, "slurp_len") do out LIR_RT_SLURP_LEN end
    if fat_cstr_eq(cname, "slurp_file") or rt_streq(cname as int, "slurp_file") do out LIR_RT_SLURP_FILE end
    if fat_cstr_eq(cname, "int_to_str") or fat_cstr_eq(cname, "i_to_str") or fat_cstr_eq(cname, "itoa") or rt_streq(cname as int, "int_to_str") or rt_streq(cname as int, "i_to_str") or rt_streq(cname as int, "itoa") do out LIR_RT_INT_TO_STR end
    if fat_cstr_eq(cname, "syscall") or fat_cstr_eq(cname, "__syscall") or fat_cstr_eq(cname, "syscall0") or fat_cstr_eq(cname, "syscall1") or fat_cstr_eq(cname, "syscall2") or fat_cstr_eq(cname, "syscall3") or fat_cstr_eq(cname, "syscall4") or fat_cstr_eq(cname, "syscall5") or fat_cstr_eq(cname, "syscall6") or rt_streq(cname as int, "syscall") or rt_streq(cname as int, "__syscall") or rt_streq(cname as int, "syscall0") or rt_streq(cname as int, "syscall1") or rt_streq(cname as int, "syscall2") or rt_streq(cname as int, "syscall3") or rt_streq(cname as int, "syscall4") or rt_streq(cname as int, "syscall5") or rt_streq(cname as int, "syscall6") do out LIR_RT_SYSCALL end
    if fat_cstr_eq(cname, "port") or rt_streq(cname as int, "port") do out LIR_RT_PORT_CREATE end
    if fat_cstr_eq(cname, "send") or rt_streq(cname as int, "send") do out LIR_RT_PORT_SEND end
    if fat_cstr_eq(cname, "recv") or rt_streq(cname as int, "recv") do out LIR_RT_PORT_RECV end
    if fat_cstr_eq(cname, "arr_new") or rt_streq(cname as int, "arr_new") do out LIR_RT_ARR_NEW end
    if fat_cstr_eq(cname, "push") or fat_cstr_eq(cname, "arr_push") or rt_streq(cname as int, "push") or rt_streq(cname as int, "arr_push") do out LIR_RT_ARR_PUSH end
    if fat_cstr_eq(cname, "len") or fat_cstr_eq(cname, "arr_len") or rt_streq(cname as int, "len") or rt_streq(cname as int, "arr_len") do out LIR_RT_ARR_LEN end
    if fat_cstr_eq(cname, "vir_get_platform") or fat_cstr_eq(cname, "sys_platform") or rt_streq(cname as int, "vir_get_platform") or rt_streq(cname as int, "sys_platform") do out LIR_RT_PLATFORM end
    if fat_cstr_eq(cname, "exit") or fat_cstr_eq(cname, "exit_prog") or fat_cstr_eq(cname, "sys_exit") or rt_streq(cname as int, "exit") or rt_streq(cname as int, "exit_prog") or rt_streq(cname as int, "sys_exit") do out LIR_RT_EXIT_PROG end
    out 0 - 1
end.

func lir_intr_is_identity(kind: i64):
    out lir_intr_is_payload(kind)
end.

func patch_bl_site(cb: &CodeBuf, at_off: i64, dest_off: i64):
    rel = (dest_off - at_off) as int
    imm26 = (rel shr 2) and 0x03FFFFFF
    word = 0x94000000 or imm26
    out codebuf_patch_u32(cb, at_off as int, word)
end.

func emit_bl_fixup(cb: &CodeBuf, call_fixups: i64, target_kind: i64, target_id: i64, rd: i64):
    at = codebuf_offset(cb) as i64
    cb = arm64_bl_imm26(cb, 0)
    cf = native_read_i64(call_fixups, 0)
    cf = vec_push_rt(cf, lir_call_fixup_new(at, target_kind, target_id, rd))
    native_write_i64(call_fixups, 0, cf)
    if rd >= 0 and rd != 0 do
        cb = arm64_mov_rr(cb, rd as int, 0)
    end
    out cb
end.

func emit_to_x0(cb: &CodeBuf, opnd: &LirOperand, assigned_phys: i64, scratch: i64):
    r = resolve_or_imm_reg(cb, opnd, assigned_phys, scratch)
    if r >= 0 and r != 0 do
        cb = arm64_mov_rr(cb, 0, r as int)
    end
    out cb
end.

func emit_lir_setarg(cb: &CodeBuf, ins: LirInstr, assigned_phys: i64, pending_stk: i64):
    SCR = 9
    ai = native_read_i64(ins as i64, 40)
    src1 = native_read_i64(ins as i64, 24)
    if (src1 as i64) != 0 do
        if native_read_i64(src1 as i64, 0) == (LirOperandType.Imm as i64) do
            ai = native_read_i64(src1 as i64, 32)
        end
    end
    src2 = native_read_i64(ins as i64, 32)
    var (cb_arg, rval) = lir_load_opnd_to_reg(cb, src2, assigned_phys, SCR)
    cb = cb_arg
    if rval < 0 do
        out (cb, pending_stk)
    end
    if ai >= 0 and ai < 8 do
		if lir_instr_typ(ins) == LirType.F64 as i64 do
			cb = arm64_fmov_dx(cb, ai as int, rval as int)
			out (cb, pending_stk)
		end
        if rval != ai do
            cb = arm64_mov_rr(cb, ai as int, rval as int)
        end
        out (cb, pending_stk)
    end
    cb = arm64_str_pre(cb, rval as int, 31, 0 - 16)
    out (cb, pending_stk + 1)
end.
