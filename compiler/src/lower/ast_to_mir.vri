##
 * compiler/src/lower/ast_to_mir.vri — AST-to-MIR Lowering Subsystem Orchestrator
 * ==============================================================================
 * VIRC-PLN-0004 Phase 10 / VIRC-ISS-0006: Modularized Lowering Subsystem.
 ##

include types
include vec_rt
include string_rt
include parser
include ffi_imports
include type_table
include mir
import print_str, print_ln, g_disable_specialization from compiler.context

include ast_to_mir_context
include ast_to_mir_layout
include ast_to_mir_builder
include ast_to_mir_calls
include ast_to_mir_expr_ops
include ast_to_mir_expr
include ast_to_mir_stmt_control
include ast_to_mir_stmt
include ast_to_mir_func

func ast_lower_program(prog: &AstNode):
    set_global_prog_ast(prog)
	ffi_import_reset()
	g_mir_scratch_top = 0
	if g_disable_specialization == 0 do
		monomorphize_walk(prog, prog)
	end
	# Soft/C-VM: keep `var` on the result vec so push reassignments stick.
	var mir_funcs = vec_new_rt()
	mir_funcs = vec_push_rt(mir_funcs, ast_build_global_init_func())
	g_ast_to_mir_cur_module = fat_str_new("")
	var child_count = ast_node_child_count(prog)
	var lowered = 0
	var i = 0
	when i < child_count loop
		var child = ast_node_child(prog, i)
		var is_func = 0
		nt = ast_node_type_of(child)
		if nt == AstType.ModuleStmt do
			if fat_str_len(ast_node_name(child)) > 0 do
				g_ast_to_mir_cur_module = ast_node_name(child)
			end
		end
		if nt == AstType.BindAttr or nt == AstType.ExposeAttr do
			if ast_node_child_count(child) > 0 do
				child = ast_node_child(child, 0)
				nt = ast_node_type_of(child)
			end
		end
		if nt == AstType.FuncDef do
			if fat_cstr_eq(ast_node_name2(child), "precomp") == 0 do
				if g_disable_specialization == 1 or child.builtin_id == 0 do
					is_func = 1
				end
			end
		end
		if nt == AstType.ExternFunc do
			# Externs are symbols, not empty executable functions.  The registry
			# is consumed by target object writers (Mach-O/ELF/PE/Wasm).
			param_types = vec_new_rt()
			var epi = 0
			when epi < ast_node_child_count(child) loop
				ep = ast_node_child(child, epi)
				if ast_node_type_of(ep) != AstType.Block do
					param_types = vec_push_rt(param_types, ast_node_name2(ep))
				end
				epi = epi + 1
			end
			provider = ast_node_int_val(child) as string
			if ast_node_int_val(child) == 0 do provider = fat_str_new("os") end
			ffi_import_register(ast_node_name(child), provider, param_types, ast_node_name2(child))
		end
		if is_func == 1 do
			var old_name = child.name
			var is_renamed = 0
			if is_user_module(g_ast_to_mir_cur_module) == 1 and fat_cstr_eq(old_name, "main") == 0 do
				child.name = fat_str_concat(fat_str_concat(g_ast_to_mir_cur_module, fat_str_new(".")), old_name)
				is_renamed = 1
			end
			if g_ast_lower_verbose == 1 do
				arena:
					var sb = sb_new()
					sb = sb_append(sb, "virc: pipeline — AST->MIR func ")
					sb = sb_append_int(sb, lowered + 1)
					sb = sb_append(sb, " : ")
					var fn_cstr = native_read_i64(ast_node_name(child) as i64, 0)
					sb = sb_append(sb, fn_cstr)
					print_ln(sb_to_string(sb))
					sb_free(sb)
				end
			end
			var m_func = ast_lower_func(i, child)
			if is_renamed == 1 do
				child.name = old_name
			end
			mir_funcs = vec_push_rt(mir_funcs, m_func)
			lowered = lowered + 1
		end
		if (nt == AstType.EntityDef or nt == AstType.PackedDef) and fat_cstr_eq(ast_node_name2(child), "interface") == 0 do
			g_current_entity_name = ast_node_name(child) as i64
			var n_ech = ast_node_child_count(child)
			var j = 0
			when j < n_ech loop
				var m_node = ast_node_child(child, j)
				if ast_node_type_of(m_node) == AstType.FuncDef do
					old_method_name = ast_node_name(m_node)
					old_method_meta = ast_node_name2(m_node)
					m_node.name = qualified_member_name(ast_node_name(child), old_method_name)
					m_node.name2 = fat_str_new("method")
					var m_func = ast_lower_func(vec_len_rt(mir_funcs), m_node)
					m_node.name = old_method_name
					m_node.name2 = old_method_meta
					mir_funcs = vec_push_rt(mir_funcs, m_func)
					lowered = lowered + 1
					if g_ast_lower_verbose == 1 do
						if lowered == 1 || (lowered mod 50) == 0 do
							arena:
								var sb = sb_new()
								sb = sb_append(sb, "virc: pipeline — AST->MIR func ")
								sb = sb_append_int(sb, lowered)
								print_ln(sb_to_string(sb))
								sb_free(sb)
							end
						end
					end
				end
				j = j + 1
			end
			g_current_entity_name = 0
		end
		i = i + 1
	end
	out mir_funcs
end.

export ast_lower_program, ast_lower_func, set_ast_lower_verbose, name_hash_bucket, get_var_vreg, set_var_vreg, get_var_type, set_var_type, emit_jump, emit_jump_if, emit_jump_if_not, emit_set_arg, emit_intrinsic, emit_move, emit_load, emit_store, emit_load_typed, emit_store_typed, lower_aggregate, MIR_VAR_BUCKETS, set_global_prog_ast, enum_index_from_type_name, enum_variant_index, enum_variant_index_for_type_name, enum_variant_is_tagged, enum_variant_layout_size, enum_variant_tag, enum_variant_arity, enum_variant_payload_type, find_field_index, is_entity_name, is_register_field, get_register_field_start, get_register_field_width, is_register_field_scoped, get_register_field_start_scoped, get_register_field_width_scoped
