##
 * compiler/src/lower/lir_to_mc/riscv64/helpers.vri — RISC-V 64 Helper Functions
 ##

include types_prelude
include rt_vec_rt
include rt_string_rt
include lir
include mc
include lir_to_mc_common

func riscv_mc_arg_reg(idx: int):
    if idx >= 0 and idx < 8 do
        out 10 + idx # a0..a7
    end
    out 10 # a0
end.

func emit_riscv_stack_adjust(insts: i64, op_reg: MCInstOperand, delta: int, op_n0: MCInstOperand):
    if delta < 0 do
        var rem = 0 - delta
        when rem > 2000 loop
            insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_ADDI, op_reg, op_reg, mc_opnd_imm(0 - 2000), op_n0, 0) as i64)
            rem = rem - 2000
        end
        if rem > 0 do
            insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_ADDI, op_reg, op_reg, mc_opnd_imm(0 - rem), op_n0, 0) as i64)
        end
    else
        var rem = delta
        when rem > 2000 loop
            insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_ADDI, op_reg, op_reg, mc_opnd_imm(2000), op_n0, 0) as i64)
            rem = rem - 2000
        end
        if rem > 0 do
            insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_ADDI, op_reg, op_reg, mc_opnd_imm(rem), op_n0, 0) as i64)
        end
    end
    out insts
end.

func riscv_mc_error_intrinsic(insts: i64, kind: i64, d: &LirOperand, s1: &LirOperand, s2: &LirOperand, rd: i64, assigned_phys: i64):
    let op_n0 = mc_opnd_none()
    let op_n1 = mc_opnd_none()
    # s1/x9 is outside the allocator palette and carries erx on RV64.
    if kind == MIR_INTR_ERX and rd >= 0 do
        out vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_MV, mc_opnd_reg(rd), mc_opnd_reg(9), op_n0, op_n1, 0) as i64)
    end
    if kind == MIR_INTR_ERX and is_stack_mem(d) do
        out vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_SD, mc_opnd_reg(9), mc_opnd_reg(8), mc_opnd_imm(stack_mem_off(d)), op_n0, 0) as i64)
    end
    var src = s1
    if (src as i64) <= 4096 or native_read_i64(src as i64, 0) == 0 do
        insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_LI, mc_opnd_reg(9), mc_opnd_imm(0), op_n0, op_n1, 0) as i64)
    eif is_stack_mem(src) do
        insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_LD, mc_opnd_reg(9), mc_opnd_reg(8), mc_opnd_imm(stack_mem_off(src)), op_n0, 0) as i64)
    eif native_read_i64(src as i64, 0) == 5 do
        insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_LI, mc_opnd_reg(9), mc_opnd_imm(native_read_i64(src as i64, 32)), op_n0, op_n1, 0) as i64)
    else
        let src_reg = resolve_mc_reg(src, assigned_phys)
        if src_reg >= 0 and src_reg != 9 do insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_MV, mc_opnd_reg(9), mc_opnd_reg(src_reg), op_n0, op_n1, 0) as i64) end
    end
    if kind == MIR_INTR_THROW do insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_EBREAK, op_n0, op_n0, op_n0, op_n1, 0) as i64) end
    out insts
end.
