##
 * compiler/src/lower/lir_to_mc/riscv64/mov.vri — RISC-V 64 Mov, Load, Store Operations
 ##

include types_prelude
include rt_vec_rt
include rt_string_rt
include lir
include mc
include lir_to_mc_common

func emit_riscv_mov(insts: i64, d: &LirOperand, s1: &LirOperand, rd: i64, rs1: i64):
    let op_n0 = mc_opnd_none()
    let op_n1 = mc_opnd_none()
    if is_stack_mem(d) do
        if is_stack_mem(s1) do
            let op_t0 = mc_opnd_reg(5)
            let op_s0_b = mc_opnd_reg(8)
            let op_off_s = mc_opnd_imm(stack_mem_off(s1))
            insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_LD, op_t0, op_s0_b, op_off_s, op_n0, 0) as i64)
            let op_off_d = mc_opnd_imm(stack_mem_off(d))
            insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_SD, op_t0, op_s0_b, op_off_d, op_n0, 0) as i64)
        eif (s1 as i64) > 4096 and native_read_i64(s1 as i64, 0) == 5 do
            let imm = native_read_i64(s1 as i64, 32)
            let op_t0 = mc_opnd_reg(5)
            let op_i = mc_opnd_imm(imm)
            insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_LI, op_t0, op_i, op_n0, op_n1, 0) as i64)
            let op_s0_b = mc_opnd_reg(8)
            let op_off_d = mc_opnd_imm(stack_mem_off(d))
            insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_SD, op_t0, op_s0_b, op_off_d, op_n0, 0) as i64)
        eif rs1 >= 0 do
            let op_s = mc_opnd_reg(rs1)
            let op_s0_b = mc_opnd_reg(8)
            let op_off_d = mc_opnd_imm(stack_mem_off(d))
            insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_SD, op_s, op_s0_b, op_off_d, op_n0, 0) as i64)
        end
    eif rd >= 0 do
        if is_stack_mem(s1) do
            let op_d = mc_opnd_reg(rd)
            let op_s0_b = mc_opnd_reg(8)
            let op_off_s = mc_opnd_imm(stack_mem_off(s1))
            insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_LD, op_d, op_s0_b, op_off_s, op_n0, 0) as i64)
        eif (s1 as i64) > 4096 and native_read_i64(s1 as i64, 0) == 5 do
            let imm = native_read_i64(s1 as i64, 32)
            let op_d = mc_opnd_reg(rd)
            let op_i = mc_opnd_imm(imm)
            insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_LI, op_d, op_i, op_n0, op_n1, 0) as i64)
        eif rs1 >= 0 and rd != rs1 do
            let op_d = mc_opnd_reg(rd)
            let op_s = mc_opnd_reg(rs1)
            insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_MV, op_d, op_s, op_n0, op_n1, 0) as i64)
        end
    end
    out insts
end.

func emit_riscv_load(insts: i64, d: &LirOperand, s1: &LirOperand, rd: i64, rs1: i64, aux: i64):
    let op_n0 = mc_opnd_none()
    if lir_is_valid_typed_mem_aux(aux) == 0 do
        print_ln("virc: error: invalid typed memory aux in RISC-V Load lowering")
        out 0
    end
    var r_base = rs1
    if is_stack_mem(s1) do
        let op_t0 = mc_opnd_reg(5)
        let op_s0_b = mc_opnd_reg(8)
        let op_off_s = mc_opnd_imm(stack_mem_off(s1))
        insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_LD, op_t0, op_s0_b, op_off_s, op_n0, 0) as i64)
        r_base = 5
    end
    var r_dst = rd
    if is_stack_mem(d) do r_dst = 6 end
    if r_dst >= 0 and r_base >= 0 do
        let op_d = mc_opnd_reg(r_dst)
        let op_b = mc_opnd_reg(r_base)
        let op_t2 = mc_opnd_reg(7)
        if aux == 1 do
            insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_LBU, op_d, op_b, mc_opnd_imm(0), op_n0, 0) as i64)
        eif aux == 0 - 1 do
            insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_LB, op_d, op_b, mc_opnd_imm(0), op_n0, 0) as i64)
        eif aux == 2 or aux == 0 - 2 do
            # Byte-wise reconstruction for unaligned 16-bit load
            insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_LBU, op_d, op_b, mc_opnd_imm(0), op_n0, 0) as i64)
            insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_LBU, op_t2, op_b, mc_opnd_imm(1), op_n0, 0) as i64)
            insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_SLLI, op_t2, op_t2, mc_opnd_imm(8), op_n0, 0) as i64)
            insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_OR, op_d, op_d, op_t2, op_n0, 0) as i64)
            if aux == 0 - 2 do
                insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_SLLI, op_d, op_d, mc_opnd_imm(48), op_n0, 0) as i64)
                insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_SRAI, op_d, op_d, mc_opnd_imm(48), op_n0, 0) as i64)
            end
        eif aux == 4 or aux == 0 - 4 do
            # Byte-wise reconstruction for unaligned 32-bit load
            insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_LBU, op_d, op_b, mc_opnd_imm(0), op_n0, 0) as i64)
            insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_LBU, op_t2, op_b, mc_opnd_imm(1), op_n0, 0) as i64)
            insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_SLLI, op_t2, op_t2, mc_opnd_imm(8), op_n0, 0) as i64)
            insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_OR, op_d, op_d, op_t2, op_n0, 0) as i64)
            insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_LBU, op_t2, op_b, mc_opnd_imm(2), op_n0, 0) as i64)
            insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_SLLI, op_t2, op_t2, mc_opnd_imm(16), op_n0, 0) as i64)
            insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_OR, op_d, op_d, op_t2, op_n0, 0) as i64)
            insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_LBU, op_t2, op_b, mc_opnd_imm(3), op_n0, 0) as i64)
            insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_SLLI, op_t2, op_t2, mc_opnd_imm(24), op_n0, 0) as i64)
            insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_OR, op_d, op_d, op_t2, op_n0, 0) as i64)
            if aux == 0 - 4 do
                insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_SLLI, op_d, op_d, mc_opnd_imm(32), op_n0, 0) as i64)
                insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_SRAI, op_d, op_d, mc_opnd_imm(32), op_n0, 0) as i64)
            end
        else
            insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_LD, op_d, op_b, mc_opnd_imm(0), op_n0, 0) as i64)
        end
    end
    if is_stack_mem(d) do
        let op_d = mc_opnd_reg(r_dst)
        let op_s0_b = mc_opnd_reg(8)
        let op_off_d = mc_opnd_imm(stack_mem_off(d))
        insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_SD, op_d, op_s0_b, op_off_d, op_n0, 0) as i64)
    end
    out insts
end.

func emit_riscv_store(insts: i64, s1: &LirOperand, s2: &LirOperand, rs1: i64, rs2: i64, aux: i64):
    let op_n0 = mc_opnd_none()
    let op_n1 = mc_opnd_none()
    if lir_is_valid_typed_mem_aux(aux) == 0 do
        print_ln("virc: error: invalid typed memory aux in RISC-V Store lowering")
        out 0
    end
    var r_val = rs1
    if (s1 as i64) > 4096 and native_read_i64(s1 as i64, 0) == 5 do
        let op_t0 = mc_opnd_reg(5)
        let op_imm = mc_opnd_imm(native_read_i64(s1 as i64, 32))
        insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_LI, op_t0, op_imm, op_n0, op_n1, 0) as i64)
        r_val = 5
    eif is_stack_mem(s1) do
        let op_t0 = mc_opnd_reg(5)
        let op_s0_b = mc_opnd_reg(8)
        let op_off_s = mc_opnd_imm(stack_mem_off(s1))
        insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_LD, op_t0, op_s0_b, op_off_s, op_n0, 0) as i64)
        r_val = 5
    end
    var r_base = rs2
    if is_stack_mem(s2) do
        let op_t1 = mc_opnd_reg(6)
        let op_s0_b = mc_opnd_reg(8)
        let op_off_s2 = mc_opnd_imm(stack_mem_off(s2))
        insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_LD, op_t1, op_s0_b, op_off_s2, op_n0, 0) as i64)
        r_base = 6
    end
    if r_val >= 0 and r_base >= 0 do
        let op_s = mc_opnd_reg(r_val)
        let op_b = mc_opnd_reg(r_base)
        let op_t2 = mc_opnd_reg(7)
        if aux == 1 or aux == 0 - 1 do
            insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_SB, op_s, op_b, mc_opnd_imm(0), op_n0, 0) as i64)
        eif aux == 2 or aux == 0 - 2 do
            # Byte-wise reconstruction for unaligned 16-bit store
            insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_SB, op_s, op_b, mc_opnd_imm(0), op_n0, 0) as i64)
            insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_SRLI, op_t2, op_s, mc_opnd_imm(8), op_n0, 0) as i64)
            insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_SB, op_t2, op_b, mc_opnd_imm(1), op_n0, 0) as i64)
        eif aux == 4 or aux == 0 - 4 do
            # Byte-wise reconstruction for unaligned 32-bit store
            insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_SB, op_s, op_b, mc_opnd_imm(0), op_n0, 0) as i64)
            insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_SRLI, op_t2, op_s, mc_opnd_imm(8), op_n0, 0) as i64)
            insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_SB, op_t2, op_b, mc_opnd_imm(1), op_n0, 0) as i64)
            insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_SRLI, op_t2, op_s, mc_opnd_imm(16), op_n0, 0) as i64)
            insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_SB, op_t2, op_b, mc_opnd_imm(2), op_n0, 0) as i64)
            insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_SRLI, op_t2, op_s, mc_opnd_imm(24), op_n0, 0) as i64)
            insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_SB, op_t2, op_b, mc_opnd_imm(3), op_n0, 0) as i64)
        else
            insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_SD, op_s, op_b, mc_opnd_imm(0), op_n0, 0) as i64)
        end
    end
    out insts
end.
