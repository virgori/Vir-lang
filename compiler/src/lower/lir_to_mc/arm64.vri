##
 * compiler/src/lower/lir_to_mc/arm64.vri — ARM64 LIR to MCInst Lowering
 * =====================================================================
 ##

include types_prelude
include rt_vec_rt
include rt_string_rt
include lir
include mc
include lir_to_mc_common

func emit_arm64_int_cast_mc(insts_slot: i64, dst_reg: int, src_reg: int, cast_bits: int, cast_is_unsigned: int):
    let op_d = mc_opnd_reg(dst_reg)
    let op_s = mc_opnd_reg(src_reg)
    let op_n0 = mc_opnd_none()
    let op_n1 = mc_opnd_none()
    var cast_op = 0 - 1
    if cast_is_unsigned == 1 do
        if cast_bits == 8 do cast_op = MCOpcode.ARM64_UXTB end
        if cast_bits == 16 do cast_op = MCOpcode.ARM64_UXTH end
        if cast_bits == 32 do cast_op = MCOpcode.ARM64_UXTW end
    else
        if cast_bits == 8 do cast_op = MCOpcode.ARM64_SXTB end
        if cast_bits == 16 do cast_op = MCOpcode.ARM64_SXTH end
        if cast_bits == 32 do cast_op = MCOpcode.ARM64_SXTW end
    end
    if cast_op >= 0 do
        mc_emit_inst(insts_slot, mc_inst_new(cast_op, op_d, op_s, op_n0, op_n1, 0) as i64)
    eif dst_reg != src_reg do
        mc_emit_inst(insts_slot, mc_inst_new(MCOpcode.ARM64_MOV_RR, op_d, op_s, op_n0, op_n1, 0) as i64)
    end
end.

func lir_func_to_mc_arm64(func_obj: &LirFunc, assigned_phys: i64):
    var fid = lir_func_id(func_obj)
    if fid < 0 do
        fid = 0
    else
        fid = fid + 1
    end
    let insts_slot = vec_new_rt()
    native_write_i64(insts_slot, 0, vec_new_rt())
    let op_n0 = mc_opnd_none()
    let op_n1 = mc_opnd_none()

    # ── 1. Function Prologue ──
    # stp fp, lr, [sp, #-16]!
    let op_fp = mc_opnd_reg(29)
    let op_lr = mc_opnd_reg(30)
    let p_ins0 = mc_inst_new(MCOpcode.ARM64_STP_PRE, op_fp, op_lr, op_n0, op_n1, 0)
    mc_emit_inst(insts_slot, p_ins0 as i64)

    # mov fp, sp
    let p_ins1 = mc_inst_new(MCOpcode.ARM64_MOV_FROM_SP, op_fp, op_n0, op_n0, op_n1, 0)
    mc_emit_inst(insts_slot, p_ins1 as i64)

    # Save allocator registers x20..x27. x19 carries erx across calls.
    let op_x20 = mc_opnd_reg(20)
    let op_x21 = mc_opnd_reg(21)
    let op_x22 = mc_opnd_reg(22)
    let op_x23 = mc_opnd_reg(23)
    let op_x24 = mc_opnd_reg(24)
    let op_x25 = mc_opnd_reg(25)
    let op_x26 = mc_opnd_reg(26)
    let op_x27 = mc_opnd_reg(27)
    mc_emit_inst(insts_slot, mc_inst_new(MCOpcode.ARM64_STP_PRE, op_x20, op_x21, op_n0, op_n1, 0) as i64)
    mc_emit_inst(insts_slot, mc_inst_new(MCOpcode.ARM64_STP_PRE, op_x22, op_x23, op_n0, op_n1, 0) as i64)
    mc_emit_inst(insts_slot, mc_inst_new(MCOpcode.ARM64_STP_PRE, op_x24, op_x25, op_n0, op_n1, 0) as i64)
    mc_emit_inst(insts_slot, mc_inst_new(MCOpcode.ARM64_STP_PRE, op_x26, op_x27, op_n0, op_n1, 0) as i64)

    let ssz = lir_to_mc_required_stack_size(func_obj)
    var aligned_ssz = ssz
    if (aligned_ssz mod 16) != 0 do
        aligned_ssz = aligned_ssz + (16 - (aligned_ssz mod 16))
    end
    if aligned_ssz > 0 do
        # sub sp, sp, #ssz
        let op_sp = mc_opnd_reg(31)
        let op_ssz = mc_opnd_imm(aligned_ssz)
        let p_ins2 = mc_inst_new(MCOpcode.ARM64_SUB_IMM, op_sp, op_sp, op_ssz, op_n0, 0)
        mc_emit_inst(insts_slot, p_ins2 as i64)
    end

    # ── 2. Blocks & Instructions ──
    let blocks = lir_func_blocks(func_obj)
    let n_blocks = vec_len_rt(blocks)
    var bi = 0
    var last_cmp_cond = 0 - 1
    var pending_stack_args = vec_new_rt()
    var pending_arg0_imm = 0 - 1
    var last_op = 0 - 1

    when bi < n_blocks loop
        let b = vec_get_rt(blocks, bi)
        let bid = lir_block_id(b)

        # Label definition for basic block
        let op_lbl = mc_opnd_imm(fid * 10000 + bid)
        let ins_lbl = mc_inst_new(MCOpcode.LABEL_DEF, op_lbl, op_n0, op_n0, op_n1, 0)
        mc_emit_inst(insts_slot, ins_lbl as i64)

        let binstrs = lir_block_instrs(b)
        let n_ins = vec_len_rt(binstrs)
        var ii = 0

        when ii < n_ins loop
            let ins = vec_get_rt(binstrs, ii)
            let op = lir_instr_op(ins)
            last_op = op
            let d = lir_instr_dst(ins)
            let s1 = lir_instr_src1(ins)
            let s2 = lir_instr_src2(ins)
            let rd = resolve_mc_reg(d, assigned_phys)
            let rs1 = resolve_mc_reg(s1, assigned_phys)
            let rs2 = resolve_mc_reg(s2, assigned_phys)

            if op == LirOp.Mov do
                if is_stack_mem(d) do
                    if is_stack_mem(s1) do
                        let op_x9 = mc_opnd_reg(9)
                        let op_ms = mc_opnd_mem(29, stack_mem_off(s1))
                        mc_emit_inst(insts_slot, mc_inst_new(MCOpcode.ARM64_LDR_UOFF, op_x9, op_ms, op_n0, op_n1, 0) as i64)
                        let op_md = mc_opnd_mem(29, stack_mem_off(d))
                        mc_emit_inst(insts_slot, mc_inst_new(MCOpcode.ARM64_STR_UOFF, op_x9, op_md, op_n0, op_n1, 0) as i64)
                    eif (s1 as i64) > 4096 and native_read_i64(s1 as i64, 0) == 5 do
                        let imm = native_read_i64(s1 as i64, 32)
                        let op_x9 = mc_opnd_reg(9)
                        let op_i = mc_opnd_imm(imm)
                        mc_emit_inst(insts_slot, mc_inst_new(MCOpcode.ARM64_MOVZ, op_x9, op_i, op_n0, op_n1, 0) as i64)
                        let op_md = mc_opnd_mem(29, stack_mem_off(d))
                        mc_emit_inst(insts_slot, mc_inst_new(MCOpcode.ARM64_STR_UOFF, op_x9, op_md, op_n0, op_n1, 0) as i64)
                    eif rs1 >= 0 do
                        let op_s = mc_opnd_reg(rs1)
                        let op_md = mc_opnd_mem(29, stack_mem_off(d))
                        mc_emit_inst(insts_slot, mc_inst_new(MCOpcode.ARM64_STR_UOFF, op_s, op_md, op_n0, op_n1, 0) as i64)
                    end
                eif rd >= 0 do
                    if is_stack_mem(s1) do
                        let op_d = mc_opnd_reg(rd)
                        let op_ms = mc_opnd_mem(29, stack_mem_off(s1))
                        mc_emit_inst(insts_slot, mc_inst_new(MCOpcode.ARM64_LDR_UOFF, op_d, op_ms, op_n0, op_n1, 0) as i64)
                    eif (s1 as i64) > 4096 and native_read_i64(s1 as i64, 0) == 5 do
                        let imm = native_read_i64(s1 as i64, 32)
                        let op_d = mc_opnd_reg(rd)
                        let op_i = mc_opnd_imm(imm)
                        mc_emit_inst(insts_slot, mc_inst_new(MCOpcode.ARM64_MOVZ, op_d, op_i, op_n0, op_n1, 0) as i64)
                    eif rs1 >= 0 and rd != rs1 do
                        let op_d = mc_opnd_reg(rd)
                        let op_s = mc_opnd_reg(rs1)
                        mc_emit_inst(insts_slot, mc_inst_new(MCOpcode.ARM64_MOV_RR, op_d, op_s, op_n0, op_n1, 0) as i64)
                    end
                end
                last_cmp_cond = 0 - 1
            eif op == LirOp.Add or op == LirOp.Sub do
                var r_s1 = rs1
                if (s1 as i64) > 4096 and native_read_i64(s1 as i64, 0) == 5 do
                    let imm = native_read_i64(s1 as i64, 32)
                    let op_x9 = mc_opnd_reg(9)
                    let op_i = mc_opnd_imm(imm)
                    mc_emit_inst(insts_slot, mc_inst_new(MCOpcode.ARM64_MOVZ, op_x9, op_i, op_n0, op_n1, 0) as i64)
                    r_s1 = 9
                eif is_stack_mem(s1) do
                    let op_x9 = mc_opnd_reg(9)
                    let op_ms = mc_opnd_mem(29, stack_mem_off(s1))
                    mc_emit_inst(insts_slot, mc_inst_new(MCOpcode.ARM64_LDR_UOFF, op_x9, op_ms, op_n0, op_n1, 0) as i64)
                    r_s1 = 9
                end
                var is_imm = 0
                var imm_val = 0
                var r_s2 = rs2
                if (s2 as i64) > 4096 and native_read_i64(s2 as i64, 0) == 5 do
                    imm_val = native_read_i64(s2 as i64, 32)
                    if imm_val >= 0 and imm_val <= 4095 do
                        is_imm = 1
                    else
                        let op_x10 = mc_opnd_reg(10)
                        let op_i = mc_opnd_imm(imm_val)
                        mc_emit_inst(insts_slot, mc_inst_new(MCOpcode.ARM64_MOVZ, op_x10, op_i, op_n0, op_n1, 0) as i64)
                        r_s2 = 10
                    end
                eif is_stack_mem(s2) do
                    let op_x10 = mc_opnd_reg(10)
                    let op_ms2 = mc_opnd_mem(29, stack_mem_off(s2))
                    mc_emit_inst(insts_slot, mc_inst_new(MCOpcode.ARM64_LDR_UOFF, op_x10, op_ms2, op_n0, op_n1, 0) as i64)
                    r_s2 = 10
                end
                var r_dst = rd
                if is_stack_mem(d) do r_dst = 9 end
                if is_imm == 1 do
                    var opc = MCOpcode.ARM64_ADD_IMM
                    if op == LirOp.Sub do opc = MCOpcode.ARM64_SUB_IMM end
                    let op_d = mc_opnd_reg(r_dst)
                    let op_s = mc_opnd_reg(r_s1)
                    let op_i = mc_opnd_imm(imm_val)
                    mc_emit_inst(insts_slot, mc_inst_new(opc, op_d, op_s, op_i, op_n0, 0) as i64)
                else
                    var opc = MCOpcode.ARM64_ADD_RRR
                    if op == LirOp.Sub do opc = MCOpcode.ARM64_SUB_RRR end
                    let op_d = mc_opnd_reg(r_dst)
                    let op_s1 = mc_opnd_reg(r_s1)
                    let op_s2 = mc_opnd_reg(r_s2)
                    mc_emit_inst(insts_slot, mc_inst_new(opc, op_d, op_s1, op_s2, op_n0, 0) as i64)
                end
                if is_stack_mem(d) do
                    let op_d = mc_opnd_reg(r_dst)
                    let op_md = mc_opnd_mem(29, stack_mem_off(d))
                    mc_emit_inst(insts_slot, mc_inst_new(MCOpcode.ARM64_STR_UOFF, op_d, op_md, op_n0, op_n1, 0) as i64)
                end
                last_cmp_cond = 0 - 1
            eif op == LirOp.Mul or op == LirOp.Div or op == LirOp.And or op == LirOp.Or or op == LirOp.Xor or op == LirOp.Shl or op == LirOp.Shr do
                var r_s1 = rs1
                if (s1 as i64) > 4096 and native_read_i64(s1 as i64, 0) == 5 do
                    let imm = native_read_i64(s1 as i64, 32)
                    let op_x9 = mc_opnd_reg(9)
                    let op_i = mc_opnd_imm(imm)
                    mc_emit_inst(insts_slot, mc_inst_new(MCOpcode.ARM64_MOVZ, op_x9, op_i, op_n0, op_n1, 0) as i64)
                    r_s1 = 9
                eif is_stack_mem(s1) do
                    let op_x9 = mc_opnd_reg(9)
                    let op_ms = mc_opnd_mem(29, stack_mem_off(s1))
                    mc_emit_inst(insts_slot, mc_inst_new(MCOpcode.ARM64_LDR_UOFF, op_x9, op_ms, op_n0, op_n1, 0) as i64)
                    r_s1 = 9
                end
                var r_s2 = rs2
                if (s2 as i64) > 4096 and native_read_i64(s2 as i64, 0) == 5 do
                    let imm = native_read_i64(s2 as i64, 32)
                    let op_x10 = mc_opnd_reg(10)
                    let op_i = mc_opnd_imm(imm)
                    mc_emit_inst(insts_slot, mc_inst_new(MCOpcode.ARM64_MOVZ, op_x10, op_i, op_n0, op_n1, 0) as i64)
                    r_s2 = 10
                eif is_stack_mem(s2) do
                    let op_x10 = mc_opnd_reg(10)
                    let op_ms2 = mc_opnd_mem(29, stack_mem_off(s2))
                    mc_emit_inst(insts_slot, mc_inst_new(MCOpcode.ARM64_LDR_UOFF, op_x10, op_ms2, op_n0, op_n1, 0) as i64)
                    r_s2 = 10
                end
                var r_dst = rd
                if is_stack_mem(d) do r_dst = 9 end
                var opc = MCOpcode.ARM64_MUL_RRR
                if op == LirOp.Div do opc = MCOpcode.ARM64_SDIV_RRR end
                if op == LirOp.And do opc = MCOpcode.ARM64_AND_RRR end
                if op == LirOp.Or  do opc = MCOpcode.ARM64_ORR_RRR end
                if op == LirOp.Xor do opc = MCOpcode.ARM64_EOR_RRR end
                if op == LirOp.Shl do opc = MCOpcode.ARM64_LSL_RRR end
                if op == LirOp.Shr do opc = MCOpcode.ARM64_LSR_RRR end
                let op_d = mc_opnd_reg(r_dst)
                let op_op_s1 = mc_opnd_reg(r_s1)
                let op_op_s2 = mc_opnd_reg(r_s2)
                mc_emit_inst(insts_slot, mc_inst_new(opc, op_d, op_op_s1, op_op_s2, op_n0, 0) as i64)
                if is_stack_mem(d) do
                    let op_md = mc_opnd_mem(29, stack_mem_off(d))
                    mc_emit_inst(insts_slot, mc_inst_new(MCOpcode.ARM64_STR_UOFF, op_d, op_md, op_n0, op_n1, 0) as i64)
                end
                last_cmp_cond = 0 - 1
            eif op == LirOp.Rem do
                var r_s1 = rs1
                if (s1 as i64) > 4096 and native_read_i64(s1 as i64, 0) == 5 do
                    let imm = native_read_i64(s1 as i64, 32)
                    let op_x9 = mc_opnd_reg(9)
                    let op_i = mc_opnd_imm(imm)
                    mc_emit_inst(insts_slot, mc_inst_new(MCOpcode.ARM64_MOVZ, op_x9, op_i, op_n0, op_n1, 0) as i64)
                    r_s1 = 9
                eif is_stack_mem(s1) do
                    let op_x9 = mc_opnd_reg(9)
                    let op_ms = mc_opnd_mem(29, stack_mem_off(s1))
                    mc_emit_inst(insts_slot, mc_inst_new(MCOpcode.ARM64_LDR_UOFF, op_x9, op_ms, op_n0, op_n1, 0) as i64)
                    r_s1 = 9
                end
                var r_s2 = rs2
                if (s2 as i64) > 4096 and native_read_i64(s2 as i64, 0) == 5 do
                    let imm = native_read_i64(s2 as i64, 32)
                    let op_x10 = mc_opnd_reg(10)
                    let op_i = mc_opnd_imm(imm)
                    mc_emit_inst(insts_slot, mc_inst_new(MCOpcode.ARM64_MOVZ, op_x10, op_i, op_n0, op_n1, 0) as i64)
                    r_s2 = 10
                eif is_stack_mem(s2) do
                    let op_x10 = mc_opnd_reg(10)
                    let op_ms2 = mc_opnd_mem(29, stack_mem_off(s2))
                    mc_emit_inst(insts_slot, mc_inst_new(MCOpcode.ARM64_LDR_UOFF, op_x10, op_ms2, op_n0, op_n1, 0) as i64)
                    r_s2 = 10
                end
                var r_dst = rd
                if is_stack_mem(d) do r_dst = 9 end
                let op_tmp = mc_opnd_reg(16)
                let op_s1_reg = mc_opnd_reg(r_s1)
                let op_s2_reg = mc_opnd_reg(r_s2)
                mc_emit_inst(insts_slot, mc_inst_new(MCOpcode.ARM64_SDIV_RRR, op_tmp, op_s1_reg, op_s2_reg, op_n0, 0) as i64)
                let op_d = mc_opnd_reg(r_dst)
                mc_emit_inst(insts_slot, mc_inst_new(MCOpcode.ARM64_MSUB_RRRR, op_d, op_tmp, op_s2_reg, op_s1_reg, 0) as i64)
                if is_stack_mem(d) do
                    let op_md = mc_opnd_mem(29, stack_mem_off(d))
                    mc_emit_inst(insts_slot, mc_inst_new(MCOpcode.ARM64_STR_UOFF, op_d, op_md, op_n0, op_n1, 0) as i64)
                end
                last_cmp_cond = 0 - 1
            eif op == LirOp.Load do
                var r_base = rs1
                if is_stack_mem(s1) do
                    let op_x9 = mc_opnd_reg(9)
                    let op_ms = mc_opnd_mem(29, stack_mem_off(s1))
                    mc_emit_inst(insts_slot, mc_inst_new(MCOpcode.ARM64_LDR_UOFF, op_x9, op_ms, op_n0, op_n1, 0) as i64)
                    r_base = 9
                end
                if is_stack_mem(d) do
                    if r_base < 0 do out 0 end
                    let op_d = mc_opnd_reg(10)
                    let op_m = mc_opnd_mem(r_base, 0)
                    mc_emit_inst(insts_slot, mc_inst_new(MCOpcode.ARM64_LDR_UOFF, op_d, op_m, op_n0, op_n1, 0) as i64)
                    let op_d = mc_opnd_reg(10)
                    let op_md = mc_opnd_mem(29, stack_mem_off(d))
                    mc_emit_inst(insts_slot, mc_inst_new(MCOpcode.ARM64_STR_UOFF, op_d, op_md, op_n0, op_n1, 0) as i64)
                eif rd >= 0 and r_base >= 0 do
                    let op_d = mc_opnd_reg(rd)
                    let op_m = mc_opnd_mem(r_base, 0)
                    mc_emit_inst(insts_slot, mc_inst_new(MCOpcode.ARM64_LDR_UOFF, op_d, op_m, op_n0, op_n1, 0) as i64)
                end
                last_cmp_cond = 0 - 1
            eif op == LirOp.Store do
                var r_val = rs1
                if (s1 as i64) > 4096 and native_read_i64(s1 as i64, 0) == 5 do
                    let op_x9 = mc_opnd_reg(9)
                    let op_imm = mc_opnd_imm(native_read_i64(s1 as i64, 32))
                    mc_emit_inst(insts_slot, mc_inst_new(MCOpcode.ARM64_MOVZ, op_x9, op_imm, op_n0, op_n1, 0) as i64)
                    r_val = 9
                eif is_stack_mem(s1) do
                    let op_x9 = mc_opnd_reg(9)
                    let op_ms = mc_opnd_mem(29, stack_mem_off(s1))
                    mc_emit_inst(insts_slot, mc_inst_new(MCOpcode.ARM64_LDR_UOFF, op_x9, op_ms, op_n0, op_n1, 0) as i64)
                    r_val = 9
                end
                var r_base = rs2
                if is_stack_mem(s2) do
                    let op_x10 = mc_opnd_reg(10)
                    let op_ms2 = mc_opnd_mem(29, stack_mem_off(s2))
                    mc_emit_inst(insts_slot, mc_inst_new(MCOpcode.ARM64_LDR_UOFF, op_x10, op_ms2, op_n0, op_n1, 0) as i64)
                    r_base = 10
                end
                if r_val >= 0 and r_base >= 0 do
                    let op_s = mc_opnd_reg(r_val)
                    let op_m = mc_opnd_mem(r_base, 0)
                    mc_emit_inst(insts_slot, mc_inst_new(MCOpcode.ARM64_STR_UOFF, op_s, op_m, op_n0, op_n1, 0) as i64)
                end
                last_cmp_cond = 0 - 1
            eif op == LirOp.Not do
                var r_s1 = rs1
                if is_stack_mem(s1) do
                    let op_x9 = mc_opnd_reg(9)
                    let op_ms = mc_opnd_mem(29, stack_mem_off(s1))
                    mc_emit_inst(insts_slot, mc_inst_new(MCOpcode.ARM64_LDR_UOFF, op_x9, op_ms, op_n0, op_n1, 0) as i64)
                    r_s1 = 9
                end
                var r_dst = rd
                if is_stack_mem(d) do r_dst = 9 end
                let op_d = mc_opnd_reg(r_dst)
                let op_s1_reg = mc_opnd_reg(r_s1)
                mc_emit_inst(insts_slot, mc_inst_new(MCOpcode.ARM64_MVN_RR, op_d, op_s1_reg, op_n0, op_n1, 0) as i64)
                if is_stack_mem(d) do
                    let op_md = mc_opnd_mem(29, stack_mem_off(d))
                    mc_emit_inst(insts_slot, mc_inst_new(MCOpcode.ARM64_STR_UOFF, op_d, op_md, op_n0, op_n1, 0) as i64)
                end
                last_cmp_cond = 0 - 1
            eif op == LirOp.Cmp do
                var r_s1 = rs1
                if (s1 as i64) > 4096 and native_read_i64(s1 as i64, 0) == 5 do
                    let imm = native_read_i64(s1 as i64, 32)
                    let op_x9 = mc_opnd_reg(9)
                    let op_i = mc_opnd_imm(imm)
                    mc_emit_inst(insts_slot, mc_inst_new(MCOpcode.ARM64_MOVZ, op_x9, op_i, op_n0, op_n1, 0) as i64)
                    r_s1 = 9
                eif is_stack_mem(s1) do
                    let op_x9 = mc_opnd_reg(9)
                    let op_ms = mc_opnd_mem(29, stack_mem_off(s1))
                    mc_emit_inst(insts_slot, mc_inst_new(MCOpcode.ARM64_LDR_UOFF, op_x9, op_ms, op_n0, op_n1, 0) as i64)
                    r_s1 = 9
                end
                var r_s2 = rs2
                if (s2 as i64) > 4096 and native_read_i64(s2 as i64, 0) == 5 do
                    let imm = native_read_i64(s2 as i64, 32)
                    let op_x10 = mc_opnd_reg(10)
                    let op_i = mc_opnd_imm(imm)
                    mc_emit_inst(insts_slot, mc_inst_new(MCOpcode.ARM64_MOVZ, op_x10, op_i, op_n0, op_n1, 0) as i64)
                    r_s2 = 10
                eif is_stack_mem(s2) do
                    let op_x10 = mc_opnd_reg(10)
                    let op_ms2 = mc_opnd_mem(29, stack_mem_off(s2))
                    mc_emit_inst(insts_slot, mc_inst_new(MCOpcode.ARM64_LDR_UOFF, op_x10, op_ms2, op_n0, op_n1, 0) as i64)
                    r_s2 = 10
                end
                let op_s1_reg = mc_opnd_reg(r_s1)
                let op_s2_reg = mc_opnd_reg(r_s2)
                mc_emit_inst(insts_slot, mc_inst_new(MCOpcode.ARM64_CMP_RR, op_s1_reg, op_s2_reg, op_n0, op_n1, 0) as i64)
                last_cmp_cond = lir_instr_aux(ins)
                if rd >= 0 or is_stack_mem(d) do
                    var r_dst = rd
                    if is_stack_mem(d) do r_dst = 9 end
                    var cset_opc = MCOpcode.ARM64_CSET_EQ
                    if last_cmp_cond == LIR_CMP_EQ do cset_opc = MCOpcode.ARM64_CSET_EQ end
                    if last_cmp_cond == LIR_CMP_NE do cset_opc = MCOpcode.ARM64_CSET_NE end
                    if last_cmp_cond == LIR_CMP_GT do cset_opc = MCOpcode.ARM64_CSET_GT end
                    if last_cmp_cond == LIR_CMP_LT do cset_opc = MCOpcode.ARM64_CSET_LT end
                    if last_cmp_cond == LIR_CMP_GE do cset_opc = MCOpcode.ARM64_CSET_GE end
                    if last_cmp_cond == LIR_CMP_LE do cset_opc = MCOpcode.ARM64_CSET_LE end
                    let op_d = mc_opnd_reg(r_dst)
                    mc_emit_inst(insts_slot, mc_inst_new(cset_opc, op_d, op_n0, op_n0, op_n1, 0) as i64)
                    if is_stack_mem(d) do
                        let op_md = mc_opnd_mem(29, stack_mem_off(d))
                        mc_emit_inst(insts_slot, mc_inst_new(MCOpcode.ARM64_STR_UOFF, op_d, op_md, op_n0, op_n1, 0) as i64)
                    end
                end
            eif op == LirOp.Jmp do
                var tgt = 0 - 1
                if (s1 as i64) > 4096 do
                    let s1_typ = native_read_i64(s1 as i64, 0)
                    if s1_typ == 6 do tgt = native_read_i64(s1 as i64, 40) end
                    if s1_typ == 5 do tgt = native_read_i64(s1 as i64, 32) end
                end
                if tgt >= 0 do
                    let op_jmp = mc_opnd_imm(fid * 10000 + tgt)
                    let ins_b = mc_inst_new(MCOpcode.ARM64_B, op_jmp, op_n0, op_n0, op_n1, 0)
                    mc_emit_inst(insts_slot, ins_b as i64)
                end
            eif op == LirOp.TailCall do
                let n_stk = vec_len_rt(pending_stack_args)
                if n_stk > 0 do
                    var si = 0
                    when si < n_stk loop
                        let s_ins = vec_get_rt(pending_stack_args, si)
                        let s_s2 = native_read_i64(s_ins as i64, 32)
                        let s_rs2 = resolve_mc_reg(s_s2 as LirOperand, assigned_phys)
                        var r_val = s_rs2
                        if is_stack_mem(s_s2 as LirOperand) do
                            let op_x9 = mc_opnd_reg(9)
                            let op_mem_src = mc_opnd_mem(29, stack_mem_off(s_s2 as LirOperand))
                            mc_emit_inst(insts_slot, mc_inst_new(MCOpcode.ARM64_LDR_UOFF, op_x9, op_mem_src, op_n0, op_n1, 0) as i64)
                            r_val = 9
                        eif (s_s2 as i64) > 4096 and native_read_i64(s_s2 as i64, 0) == 5 do
                            let imm = native_read_i64(s_s2 as i64, 32)
                            let op_x9 = mc_opnd_reg(9)
                            mc_emit_inst(insts_slot, mc_inst_new(MCOpcode.ARM64_MOVZ, op_x9, mc_opnd_imm(imm), op_n0, op_n1, 0) as i64)
                            r_val = 9
                        end
                        let op_val = mc_opnd_reg(r_val)
                        let op_stk_dst = mc_opnd_mem(29, 16 + (si * 8))
                        mc_emit_inst(insts_slot, mc_inst_new(MCOpcode.ARM64_STR_UOFF, op_val, op_stk_dst, op_n0, op_n1, 0) as i64)
                        si = si + 1
                    end
                    pending_stack_args = vec_new_rt()
                end
                let op_jmp = mc_opnd_imm(fid * 10000 + 0)
                let ins_b = mc_inst_new(MCOpcode.ARM64_B, op_jmp, op_n0, op_n0, op_n1, 0)
                mc_emit_inst(insts_slot, ins_b as i64)
            eif op == LirOp.JmpCond do
                var tgt = 0 - 1
                if (s2 as i64) > 4096 do
                    let s2_typ = native_read_i64(s2 as i64, 0)
                    if s2_typ == 6 do tgt = native_read_i64(s2 as i64, 40) end
                    if s2_typ == 5 do tgt = native_read_i64(s2 as i64, 32) end
                end
                if tgt >= 0 do
                    let op_target = mc_opnd_imm(fid * 10000 + tgt)
                    let aux = lir_instr_aux(ins)
                    var cond_reg = rs1
                    if is_stack_mem(s1) do
                        let op_x9 = mc_opnd_reg(9)
                        mc_emit_inst(insts_slot, mc_inst_new(MCOpcode.ARM64_LDR_UOFF, op_x9, mc_opnd_mem(29, stack_mem_off(s1)), op_n0, op_n1, 0) as i64)
                        cond_reg = 9
                    eif (s1 as i64) > 4096 and native_read_i64(s1 as i64, 0) == 5 do
                        let op_x9 = mc_opnd_reg(9)
                        mc_emit_inst(insts_slot, mc_inst_new(MCOpcode.ARM64_MOVZ, op_x9, mc_opnd_imm(native_read_i64(s1 as i64, 32)), op_n0, op_n1, 0) as i64)
                        cond_reg = 9
                    end
                    if cond_reg >= 0 do
                        mc_emit_inst(insts_slot, mc_inst_new(MCOpcode.ARM64_CMP_IMM0, mc_opnd_reg(cond_reg), op_n0, op_n0, op_n1, 0) as i64)
                    end
                    var b_opc = MCOpcode.ARM64_BNE
                    if aux == LIR_JMP_IFNOT do b_opc = MCOpcode.ARM64_BEQ end
                    let ins_cond = mc_inst_new(b_opc, op_target, op_n0, op_n0, op_n1, 0)
                    mc_emit_inst(insts_slot, ins_cond as i64)
                end
            eif op == LirOp.Call do
                let n_stk = vec_len_rt(pending_stack_args)
                var stk_bytes = 0
                if n_stk > 0 do
                    stk_bytes = (n_stk * 8) + 15
                    stk_bytes = stk_bytes - (stk_bytes mod 16)
                    let op_sp = mc_opnd_reg(31)
                    let op_ssz = mc_opnd_imm(stk_bytes)
                    mc_emit_inst(insts_slot, mc_inst_new(MCOpcode.ARM64_SUB_IMM, op_sp, op_sp, op_ssz, op_n0, 0) as i64)
                    var si = 0
                    when si < n_stk loop
                        let s_ins = vec_get_rt(pending_stack_args, si)
                        let s_s2 = native_read_i64(s_ins as i64, 32)
                        let s_rs2 = resolve_mc_reg(s_s2 as LirOperand, assigned_phys)
                        var r_val = s_rs2
                        if is_stack_mem(s_s2 as LirOperand) do
                            let op_x9 = mc_opnd_reg(9)
                            let op_mem_src = mc_opnd_mem(29, stack_mem_off(s_s2 as LirOperand))
                            mc_emit_inst(insts_slot, mc_inst_new(MCOpcode.ARM64_LDR_UOFF, op_x9, op_mem_src, op_n0, op_n1, 0) as i64)
                            r_val = 9
                        eif (s_s2 as i64) > 4096 and native_read_i64(s_s2 as i64, 0) == 5 do
                            let imm = native_read_i64(s_s2 as i64, 32)
                            let op_x9 = mc_opnd_reg(9)
                            let op_imm = mc_opnd_imm(imm)
                            mc_emit_inst(insts_slot, mc_inst_new(MCOpcode.ARM64_MOVZ, op_x9, op_imm, op_n0, op_n1, 0) as i64)
                            r_val = 9
                        end
                        let op_val = mc_opnd_reg(r_val)
                        let op_mem = mc_opnd_mem(31, si * 8)
                        mc_emit_inst(insts_slot, mc_inst_new(MCOpcode.ARM64_STR_UOFF, op_val, op_mem, op_n0, op_n1, 0) as i64)
                        si = si + 1
                    end
                    pending_stack_args = vec_new_rt()
                end

                let sid = native_read_i64(ins as i64, 40)
                let ins_src2 = native_read_i64(ins as i64, 32)
                var is_dynamic = 0
                if sid < 0 do
                    is_dynamic = 1
                eif ins_src2 > 4096 do
                    let s2_typ = native_read_i64(ins_src2, 0)
                    if s2_typ == 1 or s2_typ == 2 or s2_typ == 3 do
                        is_dynamic = 1
                    end
                end
                var call_ffi_id = 0 - 1
                if is_dynamic == 1 do
                    var r_target = rs2
                    if r_target < 0 do r_target = 16 end
                    let op_r = mc_opnd_reg(r_target)
                    mc_emit_inst(insts_slot, mc_inst_new(MCOpcode.ARM64_BLR, op_r, op_n0, op_n0, op_n1, 0) as i64)
                else
                    let f_strings = native_read_i64(func_obj as i64, 32)
                    var cname_str = 0
                    if f_strings > 0 and sid >= 0 and sid < vec_len_rt(f_strings) do
                        let fat_cname = vec_get_rt(f_strings, sid)
                        if fat_cname != 0 do
                            cname_str = native_read_i64(fat_cname, 0)
                        end
                    end
                    if cname_str == 0 do
                        print_str("virc: error: unresolved symbol in direct call\n")
                        sys_exit(1)
                        out 0
                    end
                    let call_fat_name = vec_get_rt(f_strings, sid) as string
                    call_ffi_id = ffi_import_find(call_fat_name)
                    let op_sym = mc_opnd_symbol_cstr(cname_str, RelocKind.ARM64_CALL26, 0)
                    mc_emit_inst(insts_slot, mc_inst_new(MCOpcode.ARM64_BL, op_sym, op_n0, op_n0, op_n1, 0) as i64)
                end
                if stk_bytes > 0 do
                    let op_sp = mc_opnd_reg(31)
                    let op_ssz = mc_opnd_imm(stk_bytes)
                    mc_emit_inst(insts_slot, mc_inst_new(MCOpcode.ARM64_ADD_IMM, op_sp, op_sp, op_ssz, op_n0, 0) as i64)
                end
                if call_ffi_id >= 0 do
                    let foreign_return_type = ffi_import_return_type(call_ffi_id)
                    if fat_cstr_eq(foreign_return_type, "float") == 1 or fat_cstr_eq(foreign_return_type, "f64") == 1 do
                        mc_emit_inst(insts_slot, mc_inst_new(MCOpcode.ARM64_FMOV_XD, mc_opnd_reg(0), mc_opnd_reg(0), op_n0, op_n1, 0) as i64)
                    end
                end
                if rd >= 0 and rd != 0 do
                    let op_d = mc_opnd_reg(rd)
                    let op_ret = mc_opnd_reg(0)
                    mc_emit_inst(insts_slot, mc_inst_new(MCOpcode.ARM64_MOV_RR, op_d, op_ret, op_n0, op_n1, 0) as i64)
                eif is_stack_mem(d) do
                    let op_ret = mc_opnd_reg(0)
                    let op_m = mc_opnd_mem(29, stack_mem_off(d))
                    mc_emit_inst(insts_slot, mc_inst_new(MCOpcode.ARM64_STR_UOFF, op_ret, op_m, op_n0, op_n1, 0) as i64)
                end
                last_cmp_cond = 0 - 1
            eif op == LirOp.SetArg do
                let ai = native_read_i64(ins as i64, 40)
                if ai == 0 do
                    pending_arg0_imm = 0 - 1
                    if (s2 as i64) > 4096 and native_read_i64(s2 as i64, 0) == 5 do pending_arg0_imm = native_read_i64(s2 as i64, 32) end
                end
                if ai >= 0 and ai < 8 do
                    if lir_instr_typ(ins) == LirType.F64 as i64 do
                        var float_src_reg = rs2
                        if is_stack_mem(s2) do
                            let op_x9 = mc_opnd_reg(9)
                            let op_m = mc_opnd_mem(29, stack_mem_off(s2))
                            mc_emit_inst(insts_slot, mc_inst_new(MCOpcode.ARM64_LDR_UOFF, op_x9, op_m, op_n0, op_n1, 0) as i64)
                            float_src_reg = 9
                        eif (s2 as i64) > 4096 and native_read_i64(s2 as i64, 0) == 5 do
                            let imm = native_read_i64(s2 as i64, 32)
                            let op_x9 = mc_opnd_reg(9)
                            mc_emit_inst(insts_slot, mc_inst_new(MCOpcode.ARM64_MOVZ, op_x9, mc_opnd_imm(imm), op_n0, op_n1, 0) as i64)
                            float_src_reg = 9
                        end
                        if float_src_reg >= 0 do
                            mc_emit_inst(insts_slot, mc_inst_new(MCOpcode.ARM64_FMOV_DX, mc_opnd_reg(ai), mc_opnd_reg(float_src_reg), op_n0, op_n1, 0) as i64)
                        end
                    eif is_stack_mem(s2) do
                        let op_ar = mc_opnd_reg(ai)
                        let op_m = mc_opnd_mem(29, stack_mem_off(s2))
                        mc_emit_inst(insts_slot, mc_inst_new(MCOpcode.ARM64_LDR_UOFF, op_ar, op_m, op_n0, op_n1, 0) as i64)
                    eif (s2 as i64) > 4096 and native_read_i64(s2 as i64, 0) == 5 do
                        let imm = native_read_i64(s2 as i64, 32)
                        let op_ar = mc_opnd_reg(ai)
                        let op_imm = mc_opnd_imm(imm)
                        mc_emit_inst(insts_slot, mc_inst_new(MCOpcode.ARM64_MOVZ, op_ar, op_imm, op_n0, op_n1, 0) as i64)
                    eif rs2 >= 0 and rs2 != ai do
                        let op_ar = mc_opnd_reg(ai)
                        let op_s = mc_opnd_reg(rs2)
                        mc_emit_inst(insts_slot, mc_inst_new(MCOpcode.ARM64_MOV_RR, op_ar, op_s, op_n0, op_n1, 0) as i64)
                    end
                else
                    pending_stack_args = vec_push_rt(pending_stack_args, ins)
                end
            eif op == LirOp.Intrinsic do
                let kind = native_read_i64(ins as i64, 40)
                if kind == MIR_INTR_PARAM do
                    if (s1 as i64) > 4096 do
                        let abi = native_read_i64(s1 as i64, 32)
                        if abi >= 0 and abi < 8 do
                            if rd >= 0 and rd != abi do
                                let op_d = mc_opnd_reg(rd)
                                let op_ar = mc_opnd_reg(abi)
                                mc_emit_inst(insts_slot, mc_inst_new(MCOpcode.ARM64_MOV_RR, op_d, op_ar, op_n0, op_n1, 0) as i64)
                            eif is_stack_mem(d) do
                                let op_ar = mc_opnd_reg(abi)
                                let op_m = mc_opnd_mem(29, stack_mem_off(d))
                                mc_emit_inst(insts_slot, mc_inst_new(MCOpcode.ARM64_STR_UOFF, op_ar, op_m, op_n0, op_n1, 0) as i64)
                            end
                        eif abi >= 8 do
                            let off = 16 + ((abi - 8) * 8)
                            if rd >= 0 do
                                let op_d = mc_opnd_reg(rd)
                                let op_mem = mc_opnd_mem(29, off)
                                mc_emit_inst(insts_slot, mc_inst_new(MCOpcode.ARM64_LDR_UOFF, op_d, op_mem, op_n0, op_n1, 0) as i64)
                            eif is_stack_mem(d) do
                                let op_x9 = mc_opnd_reg(9)
                                let op_mem_src = mc_opnd_mem(29, off)
                                mc_emit_inst(insts_slot, mc_inst_new(MCOpcode.ARM64_LDR_UOFF, op_x9, op_mem_src, op_n0, op_n1, 0) as i64)
                                let op_mem_dst = mc_opnd_mem(29, stack_mem_off(d))
                                mc_emit_inst(insts_slot, mc_inst_new(MCOpcode.ARM64_STR_UOFF, op_x9, op_mem_dst, op_n0, op_n1, 0) as i64)
                            end
                        end
                    end
                eif kind == MIR_INTR_ERX do
                    if rd >= 0 do
                        mc_emit_inst(insts_slot, mc_inst_new(MCOpcode.ARM64_MOV_RR, mc_opnd_reg(rd), mc_opnd_reg(19), op_n0, op_n1, 0) as i64)
                    eif is_stack_mem(d) do
                        mc_emit_inst(insts_slot, mc_inst_new(MCOpcode.ARM64_STR_UOFF, mc_opnd_reg(19), mc_opnd_mem(29, stack_mem_off(d)), op_n0, op_n1, 0) as i64)
                    else
                        var erx_src = s1
                        if (erx_src as i64) <= 4096 or native_read_i64(erx_src as i64, 0) == 0 do
                            mc_emit_inst(insts_slot, mc_inst_new(MCOpcode.ARM64_MOVZ, mc_opnd_reg(19), mc_opnd_imm(0), op_n0, op_n1, 0) as i64)
                        eif is_stack_mem(erx_src as LirOperand) do
                            mc_emit_inst(insts_slot, mc_inst_new(MCOpcode.ARM64_LDR_UOFF, mc_opnd_reg(19), mc_opnd_mem(29, stack_mem_off(erx_src as LirOperand)), op_n0, op_n1, 0) as i64)
                        eif native_read_i64(erx_src as i64, 0) == 5 do
                            mc_emit_inst(insts_slot, mc_inst_new(MCOpcode.ARM64_MOVZ, mc_opnd_reg(19), mc_opnd_imm(native_read_i64(erx_src as i64, 32)), op_n0, op_n1, 0) as i64)
                        else
                            let erx_reg = resolve_mc_reg(erx_src as LirOperand, assigned_phys)
                            if erx_reg >= 0 and erx_reg != 19 do mc_emit_inst(insts_slot, mc_inst_new(MCOpcode.ARM64_MOV_RR, mc_opnd_reg(19), mc_opnd_reg(erx_reg), op_n0, op_n1, 0) as i64) end
                        end
                    end
                eif kind == MIR_INTR_THROW do
                    var throw_src = s1
                    if (throw_src as i64) > 4096 and native_read_i64(throw_src as i64, 0) == 5 do
                        mc_emit_inst(insts_slot, mc_inst_new(MCOpcode.ARM64_MOVZ, mc_opnd_reg(19), mc_opnd_imm(native_read_i64(throw_src as i64, 32)), op_n0, op_n1, 0) as i64)
                    eif is_stack_mem(throw_src as LirOperand) do
                        mc_emit_inst(insts_slot, mc_inst_new(MCOpcode.ARM64_LDR_UOFF, mc_opnd_reg(19), mc_opnd_mem(29, stack_mem_off(throw_src as LirOperand)), op_n0, op_n1, 0) as i64)
                    else
                        let throw_reg = resolve_mc_reg(throw_src as LirOperand, assigned_phys)
                        if throw_reg >= 0 and throw_reg != 19 do mc_emit_inst(insts_slot, mc_inst_new(MCOpcode.ARM64_MOV_RR, mc_opnd_reg(19), mc_opnd_reg(throw_reg), op_n0, op_n1, 0) as i64) end
                    end
                    mc_emit_inst(insts_slot, mc_inst_new(MCOpcode.ARM64_BRK, mc_opnd_imm(1), op_n0, op_n0, op_n1, 0) as i64)
                eif kind == MIR_INTR_LOAD_ADDR do
                    let slot = native_read_i64(s1 as i64, 32)
                    let distance = 88 + 8 * slot
                    var target_reg = rd
                    if is_stack_mem(d) or target_reg < 0 do target_reg = 9 end
                    mc_emit_inst(insts_slot, mc_inst_new(MCOpcode.ARM64_SUB_IMM, mc_opnd_reg(target_reg), mc_opnd_reg(29), mc_opnd_imm(distance), op_n0, 0) as i64)
                    if is_stack_mem(d) do
                        mc_emit_inst(insts_slot, mc_inst_new(MCOpcode.ARM64_STR_UOFF, mc_opnd_reg(target_reg), mc_opnd_mem(29, stack_mem_off(d)), op_n0, op_n1, 0) as i64)
                    end
                eif kind == MIR_INTR_GLOBAL_LOAD do
                    let global_slot = native_read_i64(s1 as i64, 32)
                    let op_base = mc_opnd_reg(9)
                    let global_sym = mc_opnd_symbol_cstr("_vir_globals", RelocKind.ARM64_PAGE21, 0)
                    let global_off = mc_opnd_symbol_cstr("_vir_globals", RelocKind.ARM64_PAGEOFF12, 0)
                    mc_emit_inst(insts_slot, mc_inst_new(MCOpcode.ARM64_ADRP, op_base, global_sym, op_n0, op_n1, 0) as i64)
                    mc_emit_inst(insts_slot, mc_inst_new(MCOpcode.ARM64_ADD_LO12, op_base, op_base, global_off, op_n1, 0) as i64)
                    if global_slot != 0 do mc_emit_inst(insts_slot, mc_inst_new(MCOpcode.ARM64_ADD_IMM, op_base, op_base, mc_opnd_imm(global_slot * 8), op_n0, 0) as i64) end
                    var global_dst = rd
                    if is_stack_mem(d) do global_dst = 10 end
                    if global_dst >= 0 do
                        let op_dst = mc_opnd_reg(global_dst)
                        mc_emit_inst(insts_slot, mc_inst_new(MCOpcode.ARM64_LDR_UOFF, op_dst, mc_opnd_mem(9, 0), op_n0, op_n1, 0) as i64)
                        if is_stack_mem(d) do mc_emit_inst(insts_slot, mc_inst_new(MCOpcode.ARM64_STR_UOFF, op_dst, mc_opnd_mem(29, stack_mem_off(d)), op_n0, op_n1, 0) as i64) end
                    end
                eif kind == MIR_INTR_GLOBAL_STORE do
                    let global_slot = native_read_i64(d as i64, 32)
                    let op_base = mc_opnd_reg(9)
                    mc_emit_inst(insts_slot, mc_inst_new(MCOpcode.ARM64_ADRP, op_base, mc_opnd_symbol_cstr("_vir_globals", RelocKind.ARM64_PAGE21, 0), op_n0, op_n1, 0) as i64)
                    mc_emit_inst(insts_slot, mc_inst_new(MCOpcode.ARM64_ADD_LO12, op_base, op_base, mc_opnd_symbol_cstr("_vir_globals", RelocKind.ARM64_PAGEOFF12, 0), op_n1, 0) as i64)
                    if global_slot != 0 do mc_emit_inst(insts_slot, mc_inst_new(MCOpcode.ARM64_ADD_IMM, op_base, op_base, mc_opnd_imm(global_slot * 8), op_n0, 0) as i64) end
                    var global_value = rs1
                    if is_stack_mem(s1) do
                        mc_emit_inst(insts_slot, mc_inst_new(MCOpcode.ARM64_LDR_UOFF, mc_opnd_reg(10), mc_opnd_mem(29, stack_mem_off(s1)), op_n0, op_n1, 0) as i64)
                        global_value = 10
                    eif (s1 as i64) > 4096 and native_read_i64(s1 as i64, 0) == 5 do
                        mc_emit_inst(insts_slot, mc_inst_new(MCOpcode.ARM64_MOVZ, mc_opnd_reg(10), mc_opnd_imm(native_read_i64(s1 as i64, 32)), op_n0, op_n1, 0) as i64)
                        global_value = 10
                    end
                    if global_value >= 0 do mc_emit_inst(insts_slot, mc_inst_new(MCOpcode.ARM64_STR_UOFF, mc_opnd_reg(global_value), mc_opnd_mem(9, 0), op_n0, op_n1, 0) as i64) end
                eif kind == MIR_INTR_PRINT do
                    var target_src = s1
                    if (target_src as i64) <= 4096 or native_read_i64(target_src as i64, 0) == 0 do
                        target_src = s2
                    end
                    if (target_src as i64) > 4096 do
                        let t_typ = native_read_i64(target_src as i64, 0)
                        if is_stack_mem(target_src as LirOperand) do
                            let op_ar = mc_opnd_reg(0)
                            let op_m = mc_opnd_mem(29, stack_mem_off(target_src as LirOperand))
                            mc_emit_inst(insts_slot, mc_inst_new(MCOpcode.ARM64_LDR_UOFF, op_ar, op_m, op_n0, op_n1, 0) as i64)
                        eif t_typ == 5 do # Imm
                            let imm = native_read_i64(target_src as i64, 32)
                            let op_ar = mc_opnd_reg(0)
                            let op_imm = mc_opnd_imm(imm)
                            mc_emit_inst(insts_slot, mc_inst_new(MCOpcode.ARM64_MOVZ, op_ar, op_imm, op_n0, op_n1, 0) as i64)
                        else
                            let r = resolve_mc_reg(target_src as LirOperand, assigned_phys)
                            if r >= 0 and r != 0 do
                                let op_ar = mc_opnd_reg(0)
                                let op_s = mc_opnd_reg(r)
                                mc_emit_inst(insts_slot, mc_inst_new(MCOpcode.ARM64_MOV_RR, op_ar, op_s, op_n0, op_n1, 0) as i64)
                            end
                        end
                    end
                    let op_sym = mc_opnd_symbol_cstr("rt_print_int", RelocKind.ARM64_CALL26, 0)
                    mc_emit_inst(insts_slot, mc_inst_new(MCOpcode.ARM64_BL, op_sym, op_n0, op_n0, op_n1, 0) as i64)
                eif kind == MIR_INTR_PRINT_STR do
                    var target_src2 = s1
                    if (target_src2 as i64) <= 4096 or native_read_i64(target_src2 as i64, 0) == 0 do
                        target_src2 = s2
                    end
                    if (target_src2 as i64) > 4096 do
                        let t_typ = native_read_i64(target_src2 as i64, 0)
                        if is_stack_mem(target_src2 as LirOperand) do
                            let op_ar = mc_opnd_reg(0)
                            let op_m = mc_opnd_mem(29, stack_mem_off(target_src2 as LirOperand))
                            mc_emit_inst(insts_slot, mc_inst_new(MCOpcode.ARM64_LDR_UOFF, op_ar, op_m, op_n0, op_n1, 0) as i64)
                        eif t_typ == 5 do # Imm
                            let imm = native_read_i64(target_src2 as i64, 32)
                            let op_ar = mc_opnd_reg(0)
                            let op_imm = mc_opnd_imm(imm)
                            mc_emit_inst(insts_slot, mc_inst_new(MCOpcode.ARM64_MOVZ, op_ar, op_imm, op_n0, op_n1, 0) as i64)
                        else
                            let r = resolve_mc_reg(target_src2 as LirOperand, assigned_phys)
                            if r >= 0 and r != 0 do
                                let op_ar = mc_opnd_reg(0)
                                let op_s = mc_opnd_reg(r)
                                mc_emit_inst(insts_slot, mc_inst_new(MCOpcode.ARM64_MOV_RR, op_ar, op_s, op_n0, op_n1, 0) as i64)
                            end
                        end
                    end
                    let op_sym = mc_opnd_symbol_cstr("rt_print_str", RelocKind.ARM64_CALL26, 0)
                    mc_emit_inst(insts_slot, mc_inst_new(MCOpcode.ARM64_BL, op_sym, op_n0, op_n0, op_n1, 0) as i64)
                eif kind == MIR_INTR_STR_EQ do
                    var target_src3 = s1
                    if (target_src3 as i64) <= 4096 or native_read_i64(target_src3 as i64, 0) == 0 do target_src3 = s2 end
                    if is_stack_mem(target_src3 as LirOperand) do
                        mc_emit_inst(insts_slot, mc_inst_new(MCOpcode.ARM64_LDR_UOFF, mc_opnd_reg(0), mc_opnd_mem(29, stack_mem_off(target_src3 as LirOperand)), op_n0, op_n1, 0) as i64)
                    else
                        let target_reg = resolve_mc_reg(target_src3 as LirOperand, assigned_phys)
                        if target_reg >= 0 and target_reg != 0 do mc_emit_inst(insts_slot, mc_inst_new(MCOpcode.ARM64_MOV_RR, mc_opnd_reg(0), mc_opnd_reg(target_reg), op_n0, op_n1, 0) as i64) end
                    end
                    if pending_arg0_imm >= 0 do
                        let pattern_sym = lir_mc_string_symbol(lir_func_id(func_obj), pending_arg0_imm)
                        mc_emit_inst(insts_slot, mc_inst_new(MCOpcode.ARM64_ADRP, mc_opnd_reg(1), mc_opnd_symbol_cstr(pattern_sym, RelocKind.ARM64_PAGE21, 0), op_n0, op_n1, 0) as i64)
                        mc_emit_inst(insts_slot, mc_inst_new(MCOpcode.ARM64_ADD_LO12, mc_opnd_reg(1), mc_opnd_reg(1), mc_opnd_symbol_cstr(pattern_sym, RelocKind.ARM64_PAGEOFF12, 0), op_n1, 0) as i64)
                    end
                    mc_emit_inst(insts_slot, mc_inst_new(MCOpcode.ARM64_BL, mc_opnd_symbol_cstr("rt_str_eq", RelocKind.ARM64_CALL26, 0), op_n0, op_n0, op_n1, 0) as i64)
                    if is_stack_mem(d) do
                        mc_emit_inst(insts_slot, mc_inst_new(MCOpcode.ARM64_STR_UOFF, mc_opnd_reg(0), mc_opnd_mem(29, stack_mem_off(d)), op_n0, op_n1, 0) as i64)
                    eif rd >= 0 and rd != 0 do
                        mc_emit_inst(insts_slot, mc_inst_new(MCOpcode.ARM64_MOV_RR, mc_opnd_reg(rd), mc_opnd_reg(0), op_n0, op_n1, 0) as i64)
                    end
                    last_cmp_cond = 0 - 1
                eif kind == MIR_INTR_STR_LIT do
                    var sid = 0
                    if (s1 as i64) > 4096 and native_read_i64(s1 as i64, 0) == 5 do
                        sid = native_read_i64(s1 as i64, 32)
                    end
                    var r_dst = rd
                    if is_stack_mem(d) do r_dst = 9 end
                    if r_dst >= 0 do
                        let sym = lir_mc_string_symbol(lir_func_id(func_obj), sid)
                        let op_d = mc_opnd_reg(r_dst)
                        let op_sym_page = mc_opnd_symbol_cstr(sym, RelocKind.ARM64_PAGE21, 0)
                        let op_sym_off = mc_opnd_symbol_cstr(sym, RelocKind.ARM64_PAGEOFF12, 0)
                        mc_emit_inst(insts_slot, mc_inst_new(MCOpcode.ARM64_ADRP, op_d, op_sym_page, op_n0, op_n1, 0) as i64)
                        mc_emit_inst(insts_slot, mc_inst_new(MCOpcode.ARM64_ADD_LO12, op_d, op_d, op_sym_off, op_n1, 0) as i64)
                        if is_stack_mem(d) do
                            let op_m = mc_opnd_mem(29, stack_mem_off(d))
                            mc_emit_inst(insts_slot, mc_inst_new(MCOpcode.ARM64_STR_UOFF, op_d, op_m, op_n0, op_n1, 0) as i64)
                        end
                    end
                eif kind == MIR_INTR_ADDR_OF do
                    var cid = 0 - 1
                    if (s1 as i64) > 4096 and native_read_i64(s1 as i64, 0) == 5 do
                        cid = native_read_i64(s1 as i64, 32)
                    end
                    let f_strings = native_read_i64(func_obj as i64, 32)
                    var cname_str = 0
                    if f_strings > 0 and cid >= 0 and cid < vec_len_rt(f_strings) do
                        let fat_cname = vec_get_rt(f_strings, cid)
                        if fat_cname != 0 do
                            cname_str = native_read_i64(fat_cname, 0)
                        end
                    end
                    if cname_str == 0 do
                        print_str("virc: error: unresolved symbol in function address\n")
                        sys_exit(1)
                        out 0
                    end
                    var r_dst = rd
                    if is_stack_mem(d) do r_dst = 9 end
                    if r_dst >= 0 do
                        let op_d = mc_opnd_reg(r_dst)
                        let op_sym_page = mc_opnd_symbol_cstr(cname_str, RelocKind.ARM64_PAGE21, 0)
                        let op_sym_off = mc_opnd_symbol_cstr(cname_str, RelocKind.ARM64_PAGEOFF12, 0)
                        mc_emit_inst(insts_slot, mc_inst_new(MCOpcode.ARM64_ADRP, op_d, op_sym_page, op_n0, op_n1, 0) as i64)
                        mc_emit_inst(insts_slot, mc_inst_new(MCOpcode.ARM64_ADD_LO12, op_d, op_d, op_sym_off, op_n1, 0) as i64)
                        if is_stack_mem(d) do
                            let op_md = mc_opnd_mem(29, stack_mem_off(d))
                            mc_emit_inst(insts_slot, mc_inst_new(MCOpcode.ARM64_STR_UOFF, op_d, op_md, op_n0, op_n1, 0) as i64)
                        end
                    end
                eif kind == MIR_INTR_BUILTIN do
                    var bid = 0
                    if (s1 as i64) > 4096 and native_read_i64(s1 as i64, 0) == 5 do
                        bid = native_read_i64(s1 as i64, 32)
                    end
                    if bid == 11 do
                        let op_sym = mc_opnd_symbol_cstr("rt_str_cat", RelocKind.ARM64_CALL26, 0)
                        mc_emit_inst(insts_slot, mc_inst_new(MCOpcode.ARM64_BL, op_sym, op_n0, op_n0, op_n1, 0) as i64)
                    eif bid == 3 or bid == 35 or bid == 49 or bid == 50 do
                        let op_sym = mc_opnd_symbol_cstr("rt_alloc", RelocKind.ARM64_CALL26, 0)
                        mc_emit_inst(insts_slot, mc_inst_new(MCOpcode.ARM64_BL, op_sym, op_n0, op_n0, op_n1, 0) as i64)
                    eif bid == 4 do
                        let op_sym = mc_opnd_symbol_cstr("vir_free", RelocKind.ARM64_CALL26, 0)
                        mc_emit_inst(insts_slot, mc_inst_new(MCOpcode.ARM64_BL, op_sym, op_n0, op_n0, op_n1, 0) as i64)
                    eif bid == 19 do
                        let op_sym = mc_opnd_symbol_cstr("rt_int_to_str", RelocKind.ARM64_CALL26, 0)
                        mc_emit_inst(insts_slot, mc_inst_new(MCOpcode.ARM64_BL, op_sym, op_n0, op_n0, op_n1, 0) as i64)
                    eif bid == 1000 do
                        let op_sym = mc_opnd_symbol_cstr("rt_bool_to_str", RelocKind.ARM64_CALL26, 0)
                        mc_emit_inst(insts_slot, mc_inst_new(MCOpcode.ARM64_BL, op_sym, op_n0, op_n0, op_n1, 0) as i64)
                    end
                    if rd >= 0 and rd != 0 do
                        let op_d = mc_opnd_reg(rd)
                        let op_ret = mc_opnd_reg(0)
                        mc_emit_inst(insts_slot, mc_inst_new(MCOpcode.ARM64_MOV_RR, op_d, op_ret, op_n0, op_n1, 0) as i64)
                    eif is_stack_mem(d) do
                        let op_ret = mc_opnd_reg(0)
                        let op_m = mc_opnd_mem(29, stack_mem_off(d))
                        mc_emit_inst(insts_slot, mc_inst_new(MCOpcode.ARM64_STR_UOFF, op_ret, op_m, op_n0, op_n1, 0) as i64)
                    end
                eif (kind and 0xFF) == MIR_INTR_CAST do
                    let cast_src_cat = (kind shr 8) and 0xFF
                    let cast_dst_cat = (kind shr 16) and 0xFF
                    var cast_bits = (kind shr 24) and 0xFF
                    let cast_is_unsigned = (kind shr 32) and 0xFF
                    if cast_bits == 0 do cast_bits = 64 end
                    var cast_dst_reg = rd
                    if is_stack_mem(d) do cast_dst_reg = 9 end
                    var cast_src_reg = rs1
                    if cast_dst_reg >= 0 do
                        if is_stack_mem(s1) do
                            let op_cast_dst = mc_opnd_reg(cast_dst_reg)
                            let op_cast_src = mc_opnd_mem(29, stack_mem_off(s1))
                            mc_emit_inst(insts_slot, mc_inst_new(MCOpcode.ARM64_LDR_UOFF, op_cast_dst, op_cast_src, op_n0, op_n1, 0) as i64)
                            cast_src_reg = cast_dst_reg
                        eif (s1 as i64) > 4096 and native_read_i64(s1 as i64, 0) == 5 do
                            let op_cast_dst = mc_opnd_reg(cast_dst_reg)
                            let op_cast_imm = mc_opnd_imm(native_read_i64(s1 as i64, 32))
                            mc_emit_inst(insts_slot, mc_inst_new(MCOpcode.ARM64_MOVZ, op_cast_dst, op_cast_imm, op_n0, op_n1, 0) as i64)
                            cast_src_reg = cast_dst_reg
                        end
                        if cast_src_reg >= 0 do
                            if cast_src_cat == 1 and cast_dst_cat == 1 do
                                emit_arm64_int_cast_mc(insts_slot, cast_dst_reg, cast_src_reg, cast_bits, cast_is_unsigned)
                            eif cast_dst_reg != cast_src_reg do
                                mc_emit_inst(insts_slot, mc_inst_new(MCOpcode.ARM64_MOV_RR, mc_opnd_reg(cast_dst_reg), mc_opnd_reg(cast_src_reg), op_n0, op_n1, 0) as i64)
                            end
                            if is_stack_mem(d) do
                                let op_cast_dst_mem = mc_opnd_mem(29, stack_mem_off(d))
                                mc_emit_inst(insts_slot, mc_inst_new(MCOpcode.ARM64_STR_UOFF, mc_opnd_reg(cast_dst_reg), op_cast_dst_mem, op_n0, op_n1, 0) as i64)
                            end
                        end
                    end
                eif kind == MIR_MEM_MARK do
                    var mark_dst = rd
                    if is_stack_mem(d) or mark_dst < 0 do mark_dst = 9 end
                    if mark_dst >= 0 do
                        mc_emit_inst(insts_slot, mc_inst_new(MCOpcode.ARM64_LDR_UOFF, mc_opnd_reg(mark_dst), mc_opnd_mem(28, 0), op_n0, op_n1, 0) as i64)
                        if is_stack_mem(d) do
                            mc_emit_inst(insts_slot, mc_inst_new(MCOpcode.ARM64_STR_UOFF, mc_opnd_reg(mark_dst), mc_opnd_mem(29, stack_mem_off(d)), op_n0, op_n1, 0) as i64)
                        end
                    end
                eif kind == MIR_MEM_RESET do
                    var reset_src = rs1
                    if is_stack_mem(s1) do
                        mc_emit_inst(insts_slot, mc_inst_new(MCOpcode.ARM64_LDR_UOFF, mc_opnd_reg(9), mc_opnd_mem(29, stack_mem_off(s1)), op_n0, op_n1, 0) as i64)
                        reset_src = 9
                    eif (s1 as i64) > 4096 and native_read_i64(s1 as i64, 0) == 5 do
                        mc_emit_inst(insts_slot, mc_inst_new(MCOpcode.ARM64_MOVZ, mc_opnd_reg(9), mc_opnd_imm(native_read_i64(s1 as i64, 32)), op_n0, op_n1, 0) as i64)
                        reset_src = 9
                    end
                    if reset_src >= 0 do
                        mc_emit_inst(insts_slot, mc_inst_new(MCOpcode.ARM64_STR_UOFF, mc_opnd_reg(reset_src), mc_opnd_mem(28, 0), op_n0, op_n1, 0) as i64)
                    end
                eif kind == MIR_MEM_PROMOTE do
                    var prom_src = rs1
                    if is_stack_mem(s1) do
                        mc_emit_inst(insts_slot, mc_inst_new(MCOpcode.ARM64_LDR_UOFF, mc_opnd_reg(0), mc_opnd_mem(29, stack_mem_off(s1)), op_n0, op_n1, 0) as i64)
                        prom_src = 0
                    eif (s1 as i64) > 4096 and native_read_i64(s1 as i64, 0) == 5 do
                        mc_emit_inst(insts_slot, mc_inst_new(MCOpcode.ARM64_MOVZ, mc_opnd_reg(0), mc_opnd_imm(native_read_i64(s1 as i64, 32)), op_n0, op_n1, 0) as i64)
                        prom_src = 0
                    end
                    if prom_src >= 0 do
                        if prom_src != 0 do
                            mc_emit_inst(insts_slot, mc_inst_new(MCOpcode.ARM64_MOV_RR, mc_opnd_reg(0), mc_opnd_reg(prom_src), op_n0, op_n1, 0) as i64)
                        end
                        mc_emit_inst(insts_slot, mc_inst_new(MCOpcode.ARM64_MOV_RR, mc_opnd_reg(1), mc_opnd_reg(28), op_n0, op_n1, 0) as i64)
                        mc_emit_inst(insts_slot, mc_inst_new(MCOpcode.ARM64_LDR_UOFF, mc_opnd_reg(2), mc_opnd_mem(28, 0), op_n0, op_n1, 0) as i64)
                        let op_sym = mc_opnd_symbol_cstr("rt_promote_graph", RelocKind.ARM64_CALL26, 0)
                        mc_emit_inst(insts_slot, mc_inst_new(MCOpcode.ARM64_BL, op_sym, op_n0, op_n0, op_n1, 0) as i64)
                        if rd >= 0 and rd != 0 do
                            mc_emit_inst(insts_slot, mc_inst_new(MCOpcode.ARM64_MOV_RR, mc_opnd_reg(rd), mc_opnd_reg(0), op_n0, op_n1, 0) as i64)
                        eif is_stack_mem(d) do
                            mc_emit_inst(insts_slot, mc_inst_new(MCOpcode.ARM64_STR_UOFF, mc_opnd_reg(0), mc_opnd_mem(29, stack_mem_off(d)), op_n0, op_n1, 0) as i64)
                        end
                    end
                end
                last_cmp_cond = 0 - 1
            eif op == LirOp.Ret do
                if is_stack_mem(s1) do
                    let op_ar = mc_opnd_reg(0)
                    let op_m = mc_opnd_mem(29, stack_mem_off(s1))
                    mc_emit_inst(insts_slot, mc_inst_new(MCOpcode.ARM64_LDR_UOFF, op_ar, op_m, op_n0, op_n1, 0) as i64)
                eif (s1 as i64) > 4096 do
                    let s1_typ = native_read_i64(s1 as i64, 0)
                    if s1_typ == 5 do # Imm
                        let imm_val = native_read_i64(s1 as i64, 32)
                        let op_ar = mc_opnd_reg(0)
                        let op_imm = mc_opnd_imm(imm_val)
                        mc_emit_inst(insts_slot, mc_inst_new(MCOpcode.ARM64_MOVZ, op_ar, op_imm, op_n0, op_n1, 0) as i64)
                    eif rs1 >= 0 and rs1 != 0 do
                        let op_ar = mc_opnd_reg(0)
                        let op_s = mc_opnd_reg(rs1)
                        mc_emit_inst(insts_slot, mc_inst_new(MCOpcode.ARM64_MOV_RR, op_ar, op_s, op_n0, op_n1, 0) as i64)
                    end
                eif rs1 >= 0 and rs1 != 0 do
                    let op_ar = mc_opnd_reg(0)
                    let op_s = mc_opnd_reg(rs1)
                    mc_emit_inst(insts_slot, mc_inst_new(MCOpcode.ARM64_MOV_RR, op_ar, op_s, op_n0, op_n1, 0) as i64)
                end
                let op_sp = mc_opnd_reg(31)
                let op_fp = mc_opnd_reg(29)
                let op_lr = mc_opnd_reg(30)
                mc_emit_inst(insts_slot, mc_inst_new(MCOpcode.ARM64_MOV_RR, op_sp, op_fp, op_n0, op_n1, 0) as i64)
                let op_64 = mc_opnd_imm(64)
                mc_emit_inst(insts_slot, mc_inst_new(MCOpcode.ARM64_SUB_IMM, op_sp, op_sp, op_64, op_n0, 0) as i64)
                let op_x20 = mc_opnd_reg(20)
                let op_x21 = mc_opnd_reg(21)
                let op_x22 = mc_opnd_reg(22)
                let op_x23 = mc_opnd_reg(23)
                let op_x24 = mc_opnd_reg(24)
                let op_x25 = mc_opnd_reg(25)
                let op_x26 = mc_opnd_reg(26)
                let op_x27 = mc_opnd_reg(27)
                mc_emit_inst(insts_slot, mc_inst_new(MCOpcode.ARM64_LDP_POST, op_x26, op_x27, op_n0, op_n1, 0) as i64)
                mc_emit_inst(insts_slot, mc_inst_new(MCOpcode.ARM64_LDP_POST, op_x24, op_x25, op_n0, op_n1, 0) as i64)
                mc_emit_inst(insts_slot, mc_inst_new(MCOpcode.ARM64_LDP_POST, op_x22, op_x23, op_n0, op_n1, 0) as i64)
                mc_emit_inst(insts_slot, mc_inst_new(MCOpcode.ARM64_LDP_POST, op_x20, op_x21, op_n0, op_n1, 0) as i64)
                mc_emit_inst(insts_slot, mc_inst_new(MCOpcode.ARM64_LDP_POST, op_fp, op_lr, op_n0, op_n1, 0) as i64)
                mc_emit_inst(insts_slot, mc_inst_new(MCOpcode.ARM64_RET, op_n0, op_n0, op_n0, op_n1, 0) as i64)
                last_cmp_cond = 0 - 1
            end

            ii = ii + 1
        end
        bi = bi + 1
    end

    # Fall-through epilogue (suppressed if last instruction was already Ret)
    if last_op != (LirOp.Ret as i64) do
        let op_ret = mc_opnd_reg(0)
        let op_imm0 = mc_opnd_imm(0)
        mc_emit_inst(insts_slot, mc_inst_new(MCOpcode.ARM64_MOVZ, op_ret, op_imm0, op_n0, op_n1, 0) as i64)
        let op_sp = mc_opnd_reg(31)
        let op_fp = mc_opnd_reg(29)
        let op_lr = mc_opnd_reg(30)
        mc_emit_inst(insts_slot, mc_inst_new(MCOpcode.ARM64_MOV_RR, op_sp, op_fp, op_n0, op_n1, 0) as i64)
        let op_64 = mc_opnd_imm(64)
        mc_emit_inst(insts_slot, mc_inst_new(MCOpcode.ARM64_SUB_IMM, op_sp, op_sp, op_64, op_n0, 0) as i64)
        let op_x20 = mc_opnd_reg(20)
        let op_x21 = mc_opnd_reg(21)
        let op_x22 = mc_opnd_reg(22)
        let op_x23 = mc_opnd_reg(23)
        let op_x24 = mc_opnd_reg(24)
        let op_x25 = mc_opnd_reg(25)
        let op_x26 = mc_opnd_reg(26)
        let op_x27 = mc_opnd_reg(27)
        mc_emit_inst(insts_slot, mc_inst_new(MCOpcode.ARM64_LDP_POST, op_x26, op_x27, op_n0, op_n1, 0) as i64)
        mc_emit_inst(insts_slot, mc_inst_new(MCOpcode.ARM64_LDP_POST, op_x24, op_x25, op_n0, op_n1, 0) as i64)
        mc_emit_inst(insts_slot, mc_inst_new(MCOpcode.ARM64_LDP_POST, op_x22, op_x23, op_n0, op_n1, 0) as i64)
        mc_emit_inst(insts_slot, mc_inst_new(MCOpcode.ARM64_LDP_POST, op_x20, op_x21, op_n0, op_n1, 0) as i64)
        mc_emit_inst(insts_slot, mc_inst_new(MCOpcode.ARM64_LDP_POST, op_fp, op_lr, op_n0, op_n1, 0) as i64)
        mc_emit_inst(insts_slot, mc_inst_new(MCOpcode.ARM64_RET, op_n0, op_n0, op_n0, op_n1, 0) as i64)
    end

    out native_read_i64(insts_slot, 0)
end.

# ═══════════════════════════════════════════════════════
# 2. x86_64 Lowering (System V AMD64)
# ═══════════════════════════════════════════════════════
