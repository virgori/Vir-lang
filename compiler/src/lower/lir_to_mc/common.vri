##
 * compiler/src/lower/lir_to_mc/common.vri — LIR to MC Common Utilities & Stack Sizing
 * ====================================================================================
 ##

include types_prelude
include rt_vec_rt
include rt_string_rt
include lir
include mc

func resolve_mc_reg(opnd: &LirOperand, assigned_phys: i64):
    if (opnd as i64) < 4096 do
        out 0 - 1
    end
    let typ = native_read_i64(opnd as i64, 0)
    if typ == 1 or typ == 2 do # VReg
        if assigned_phys >= 0 do
            let vid = native_read_i64(opnd as i64, 8)
            if vid >= 0 and vid < vec_len_rt(assigned_phys) do
                let col = vec_get_rt(assigned_phys, vid)
                if col >= 0 and col < 8 do
                    out (col + 20)
                end
                out col
            end
        end
        out native_read_i64(opnd as i64, 8)
    end
    if typ == 3 do # PhysReg
        out native_read_i64(opnd as i64, 16)
    end
    out 0 - 1
end.

func is_stack_mem(opnd: &LirOperand):
    if (opnd as i64) <= 4096 do
        out 0
    end
    if native_read_i64(opnd as i64, 0) == 4 do
        out 1
    end
    out 0
end.

func stack_mem_off(opnd: &LirOperand):
    if (opnd as i64) <= 4096 do
        out 0
    end
    out native_read_i64(opnd as i64, 24)
end.

func lir_to_mc_opnd_required_stack_size(opnd: &LirOperand):
    if is_stack_mem(opnd) == 1 do
        off = stack_mem_off(opnd)
        if off < 0 do
            out 0 - off
        end
    end
    out 0
end.

func lir_to_mc_required_stack_size(func_obj: &LirFunc):
    var needed = lir_func_stack_size(func_obj)
    let blocks_req = lir_func_blocks(func_obj)
    let n_blocks_req = vec_len_rt(blocks_req)
    var bi_req = 0
    when bi_req < n_blocks_req loop
        let blk_req = vec_get_rt(blocks_req, bi_req)
        let instrs_req = lir_block_instrs(blk_req)
        let n_req = vec_len_rt(instrs_req)
        var ii_req = 0
        when ii_req < n_req loop
            let ins_req = vec_get_rt(instrs_req, ii_req)
            d_need = lir_to_mc_opnd_required_stack_size(lir_instr_dst(ins_req))
            if d_need > needed do needed = d_need end
            s1_need = lir_to_mc_opnd_required_stack_size(lir_instr_src1(ins_req))
            if s1_need > needed do needed = s1_need end
            s2_need = lir_to_mc_opnd_required_stack_size(lir_instr_src2(ins_req))
            if s2_need > needed do needed = s2_need end
            ii_req = ii_req + 1
        end
        bi_req = bi_req + 1
    end
    if (needed mod 16) != 0 do
        needed = needed + (16 - (needed mod 16))
    end
    out needed
end.

# Keep the instruction-list accumulator behind a stable slot. The self-host
# SSA builder can otherwise create an invalid phi for `insts` across the many
# conditional arms in the ARM64 selector.
func mc_emit_inst(insts_slot: i64, inst: i64):
    var insts = native_read_i64(insts_slot, 0)
    insts = vec_push_rt(insts, inst)
    native_write_i64(insts_slot, 0, insts)
end.

# Stable across all MC backends and matched by print_mc_string_pool. A literal
# is identified by its owning LIR function and that function's MIR string-pool
# index, not by an address in the compiler process.
func lir_mc_string_symbol(func_id: i64, sid: i64):
    var sb = sb_new()
    sb = sb_append(sb, "vir_str_")
    sb = sb_append_int(sb, func_id)
    sb = sb_append(sb, "_")
    sb = sb_append_int(sb, sid)
    out sb_to_string(sb)
end.

