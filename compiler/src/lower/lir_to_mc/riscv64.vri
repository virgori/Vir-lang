##
 * compiler/src/lower/lir_to_mc/riscv64.vri — RISC-V 64 LIR to MCInst Lowering
 * ===========================================================================
 ##

include types
include vec_rt
include string_rt
include lir
include mc
include lir_to_mc_common

func riscv_mc_arg_reg(idx: int):
    if idx >= 0 and idx < 8 do
        out 10 + idx # a0..a7
    end
    out 10 # a0
end.

func emit_riscv_stack_adjust(insts: i64, op_reg: MCInstOperand, delta: int, op_n0: MCInstOperand):
    if delta < 0 do
        var rem = 0 - delta
        when rem > 2000 loop
            insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_ADDI, op_reg, op_reg, mc_opnd_imm(0 - 2000), op_n0, 0) as i64)
            rem = rem - 2000
        end
        if rem > 0 do
            insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_ADDI, op_reg, op_reg, mc_opnd_imm(0 - rem), op_n0, 0) as i64)
        end
    else
        var rem = delta
        when rem > 2000 loop
            insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_ADDI, op_reg, op_reg, mc_opnd_imm(2000), op_n0, 0) as i64)
            rem = rem - 2000
        end
        if rem > 0 do
            insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_ADDI, op_reg, op_reg, mc_opnd_imm(rem), op_n0, 0) as i64)
        end
    end
    out insts
end.

func riscv_mc_error_intrinsic(insts: i64, kind: i64, d: &LirOperand, s1: &LirOperand, s2: &LirOperand, rd: i64, assigned_phys: i64):
    let op_n0 = mc_opnd_none()
    let op_n1 = mc_opnd_none()
    # s1/x9 is outside the allocator palette and carries erx on RV64.
    if kind == MIR_INTR_ERX and rd >= 0 do
        out vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_MV, mc_opnd_reg(rd), mc_opnd_reg(9), op_n0, op_n1, 0) as i64)
    end
    if kind == MIR_INTR_ERX and is_stack_mem(d) do
        out vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_SD, mc_opnd_reg(9), mc_opnd_reg(8), mc_opnd_imm(stack_mem_off(d)), op_n0, 0) as i64)
    end
    var src = s1
    if (src as i64) <= 4096 or native_read_i64(src as i64, 0) == 0 do
        insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_LI, mc_opnd_reg(9), mc_opnd_imm(0), op_n0, op_n1, 0) as i64)
    eif is_stack_mem(src) do
        insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_LD, mc_opnd_reg(9), mc_opnd_reg(8), mc_opnd_imm(stack_mem_off(src)), op_n0, 0) as i64)
    eif native_read_i64(src as i64, 0) == 5 do
        insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_LI, mc_opnd_reg(9), mc_opnd_imm(native_read_i64(src as i64, 32)), op_n0, op_n1, 0) as i64)
    else
        let src_reg = resolve_mc_reg(src, assigned_phys)
        if src_reg >= 0 and src_reg != 9 do insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_MV, mc_opnd_reg(9), mc_opnd_reg(src_reg), op_n0, op_n1, 0) as i64) end
    end
    if kind == MIR_INTR_THROW do insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_EBREAK, op_n0, op_n0, op_n0, op_n1, 0) as i64) end
    out insts
end.

func lir_func_to_mc_riscv64(func_obj: &LirFunc, assigned_phys: i64):
    var fid = lir_func_id(func_obj)
    if fid < 0 do
        fid = 0
    else
        fid = fid + 1
    end
    var insts = vec_new_rt()
    let op_n0 = mc_opnd_none()
    let op_n1 = mc_opnd_none()

    let ssz = lir_func_stack_size(func_obj)
    var aligned_ssz = ssz
    if (aligned_ssz mod 16) != 0 do
        aligned_ssz = aligned_ssz + (16 - (aligned_ssz mod 16))
    end
    # ra(1), s0(8), s2..s9(18..25): total 10 regs = 80 bytes.
    let total_ssz = aligned_ssz + 80

    # ── Prologue ──
    let op_sp = mc_opnd_reg(2)
    insts = emit_riscv_stack_adjust(insts, op_sp, 0 - total_ssz, op_n0)
    # sd ra, 0(sp)
    let op_ra = mc_opnd_reg(1)
    let op_off_ra = mc_opnd_imm(0)
    insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_SD, op_ra, op_sp, op_off_ra, op_n0, 0) as i64)
    # sd s0, 8(sp)
    let op_s0 = mc_opnd_reg(8)
    let op_off_s0 = mc_opnd_imm(8)
    insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_SD, op_s0, op_sp, op_off_s0, op_n0, 0) as i64)
    # Save s2..s9
    var si_cs = 0
    when si_cs < 8 loop
        let op_sr = mc_opnd_reg(18 + si_cs)
        let off_sr = mc_opnd_imm(16 + (si_cs * 8))
        insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_SD, op_sr, op_sp, off_sr, op_n0, 0) as i64)
        si_cs = si_cs + 1
    end
    # addi s0, sp, total_ssz
    if total_ssz <= 2047 do
        let op_p_ssz = mc_opnd_imm(total_ssz)
        insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_ADDI, op_s0, op_sp, op_p_ssz, op_n0, 0) as i64)
    else
        insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_ADDI, op_s0, op_sp, mc_opnd_imm(0), op_n0, 0) as i64)
        insts = emit_riscv_stack_adjust(insts, op_s0, total_ssz, op_n0)
    end

    # ── Blocks & Instructions ──
    let blocks = lir_func_blocks(func_obj)
    let n_blocks = vec_len_rt(blocks)
    var bi = 0
    var last_cmp_cond = 0 - 1
    var last_cmp_rs1 = 0 - 1
    var last_cmp_rs2 = 0 - 1
    var pending_stack_args = vec_new_rt()
    var pending_arg0_imm = 0 - 1
    var last_op = 0 - 1

    when bi < n_blocks loop
        let b = vec_get_rt(blocks, bi)
        let bid = lir_block_id(b)

        let op_lbl = mc_opnd_imm(fid * 10000 + bid)
        insts = vec_push_rt(insts, mc_inst_new(MCOpcode.LABEL_DEF, op_lbl, op_n0, op_n0, op_n1, 0) as i64)

        let binstrs = lir_block_instrs(b)
        let n_ins = vec_len_rt(binstrs)
        var ii = 0

        when ii < n_ins loop
            let ins = vec_get_rt(binstrs, ii)
            let op = lir_instr_op(ins)
            last_op = op
            let d = lir_instr_dst(ins)
            let s1 = lir_instr_src1(ins)
            let s2 = lir_instr_src2(ins)
            let rd = resolve_mc_reg(d, assigned_phys)
            let rs1 = resolve_mc_reg(s1, assigned_phys)
            let rs2 = resolve_mc_reg(s2, assigned_phys)

            if op == LirOp.Mov do
                if is_stack_mem(d) do
                    if is_stack_mem(s1) do
                        let op_t0 = mc_opnd_reg(5)
                        let op_s0_b = mc_opnd_reg(8)
                        let op_off_s = mc_opnd_imm(stack_mem_off(s1))
                        insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_LD, op_t0, op_s0_b, op_off_s, op_n0, 0) as i64)
                        let op_off_d = mc_opnd_imm(stack_mem_off(d))
                        insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_SD, op_t0, op_s0_b, op_off_d, op_n0, 0) as i64)
                    eif (s1 as i64) > 4096 and native_read_i64(s1 as i64, 0) == 5 do
                        let imm = native_read_i64(s1 as i64, 32)
                        let op_t0 = mc_opnd_reg(5)
                        let op_i = mc_opnd_imm(imm)
                        insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_LI, op_t0, op_i, op_n0, op_n1, 0) as i64)
                        let op_s0_b = mc_opnd_reg(8)
                        let op_off_d = mc_opnd_imm(stack_mem_off(d))
                        insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_SD, op_t0, op_s0_b, op_off_d, op_n0, 0) as i64)
                    eif rs1 >= 0 do
                        let op_s = mc_opnd_reg(rs1)
                        let op_s0_b = mc_opnd_reg(8)
                        let op_off_d = mc_opnd_imm(stack_mem_off(d))
                        insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_SD, op_s, op_s0_b, op_off_d, op_n0, 0) as i64)
                    end
                eif rd >= 0 do
                    if is_stack_mem(s1) do
                        let op_d = mc_opnd_reg(rd)
                        let op_s0_b = mc_opnd_reg(8)
                        let op_off_s = mc_opnd_imm(stack_mem_off(s1))
                        insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_LD, op_d, op_s0_b, op_off_s, op_n0, 0) as i64)
                    eif (s1 as i64) > 4096 and native_read_i64(s1 as i64, 0) == 5 do
                        let imm = native_read_i64(s1 as i64, 32)
                        let op_d = mc_opnd_reg(rd)
                        let op_i = mc_opnd_imm(imm)
                        insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_LI, op_d, op_i, op_n0, op_n1, 0) as i64)
                    eif rs1 >= 0 and rd != rs1 do
                        let op_d = mc_opnd_reg(rd)
                        let op_s = mc_opnd_reg(rs1)
                        insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_MV, op_d, op_s, op_n0, op_n1, 0) as i64)
                    end
                end
                last_cmp_cond = 0 - 1
            eif op == LirOp.Add or op == LirOp.Sub or op == LirOp.Mul or op == LirOp.Div or op == LirOp.Rem or op == LirOp.And or op == LirOp.Or or op == LirOp.Xor or op == LirOp.Shl or op == LirOp.Shr do
                var r_s1 = rs1
                if (s1 as i64) > 4096 and native_read_i64(s1 as i64, 0) == 5 do
                    let imm = native_read_i64(s1 as i64, 32)
                    let op_t0 = mc_opnd_reg(5)
                    let op_i = mc_opnd_imm(imm)
                    insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_LI, op_t0, op_i, op_n0, op_n1, 0) as i64)
                    r_s1 = 5
                eif is_stack_mem(s1) do
                    let op_t0 = mc_opnd_reg(5)
                    let op_s0_b = mc_opnd_reg(8)
                    let op_off_s = mc_opnd_imm(stack_mem_off(s1))
                    insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_LD, op_t0, op_s0_b, op_off_s, op_n0, 0) as i64)
                    r_s1 = 5
                end
                var r_s2 = rs2
                var is_imm_addi = 0
                var addi_imm = 0
                if (s2 as i64) > 4096 and native_read_i64(s2 as i64, 0) == 5 do
                    let imm = native_read_i64(s2 as i64, 32)
                    if op == LirOp.Add and (imm >= 0 - 2048 and imm <= 2047) do
                        is_imm_addi = 1
                        addi_imm = imm
                    eif op == LirOp.Sub and ((0 - imm) >= 0 - 2048 and (0 - imm) <= 2047) do
                        is_imm_addi = 1
                        addi_imm = 0 - imm
                    else
                        let op_t1 = mc_opnd_reg(6)
                        let op_i = mc_opnd_imm(imm)
                        insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_LI, op_t1, op_i, op_n0, op_n1, 0) as i64)
                        r_s2 = 6
                    end
                eif is_stack_mem(s2) do
                    let op_t1 = mc_opnd_reg(6)
                    let op_s0_b = mc_opnd_reg(8)
                    let op_off_s2 = mc_opnd_imm(stack_mem_off(s2))
                    insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_LD, op_t1, op_s0_b, op_off_s2, op_n0, 0) as i64)
                    r_s2 = 6
                end
                var r_dst = rd
                if is_stack_mem(d) do r_dst = 5 end
                if is_imm_addi == 1 do
                    let op_d = mc_opnd_reg(r_dst)
                    let op_s1_reg = mc_opnd_reg(r_s1)
                    let op_i = mc_opnd_imm(addi_imm)
                    insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_ADDI, op_d, op_s1_reg, op_i, op_n0, 0) as i64)
                else
                    var opc = MCOpcode.RISCV_ADD
                    if op == LirOp.Sub do opc = MCOpcode.RISCV_SUB end
                    if op == LirOp.Mul do opc = MCOpcode.RISCV_MUL end
                    if op == LirOp.Div do opc = MCOpcode.RISCV_DIV end
                    if op == LirOp.Rem do opc = MCOpcode.RISCV_REM end
                    if op == LirOp.And do opc = MCOpcode.RISCV_AND end
                    if op == LirOp.Or  do opc = MCOpcode.RISCV_OR end
                    if op == LirOp.Xor do opc = MCOpcode.RISCV_XOR end
                    if op == LirOp.Shl do opc = MCOpcode.RISCV_SLL end
                    if op == LirOp.Shr do opc = MCOpcode.RISCV_SRL end
                    let op_d = mc_opnd_reg(r_dst)
                    let op_s1_reg = mc_opnd_reg(r_s1)
                    let op_s2_reg = mc_opnd_reg(r_s2)
                    insts = vec_push_rt(insts, mc_inst_new(opc, op_d, op_s1_reg, op_s2_reg, op_n0, 0) as i64)
                end
                if is_stack_mem(d) do
                    let op_d = mc_opnd_reg(r_dst)
                    let op_s0_b = mc_opnd_reg(8)
                    let op_off_d = mc_opnd_imm(stack_mem_off(d))
                    insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_SD, op_d, op_s0_b, op_off_d, op_n0, 0) as i64)
                end
                last_cmp_cond = 0 - 1
            eif op == LirOp.MatMul or op == LirOp.Fma do
                let ins_aux = native_read_i64(ins as i64, 40)
                let dim_m = (ins_aux shr 32) and 65535
                let dim_k = (ins_aux shr 16) and 65535
                let dim_n = ins_aux and 65535

                if is_stack_mem(s1) do
                    let op_a0 = mc_opnd_reg(10)
                    let op_s0_b = mc_opnd_reg(8)
                    let op_off_s = mc_opnd_imm(stack_mem_off(s1))
                    insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_LD, op_a0, op_s0_b, op_off_s, op_n0, 0) as i64)
                eif rs1 >= 0 and rs1 != 10 do
                    let op_a0 = mc_opnd_reg(10)
                    let op_s = mc_opnd_reg(rs1)
                    insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_MV, op_a0, op_s, op_n0, op_n1, 0) as i64)
                end

                if is_stack_mem(s2) do
                    let op_a1 = mc_opnd_reg(11)
                    let op_s0_b = mc_opnd_reg(8)
                    let op_off_s = mc_opnd_imm(stack_mem_off(s2))
                    insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_LD, op_a1, op_s0_b, op_off_s, op_n0, 0) as i64)
                eif rs2 >= 0 and rs2 != 11 do
                    let op_a1 = mc_opnd_reg(11)
                    let op_s = mc_opnd_reg(rs2)
                    insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_MV, op_a1, op_s, op_n0, op_n1, 0) as i64)
                end

                let op_a2 = mc_opnd_reg(12)
                let op_a3 = mc_opnd_reg(13)
                let op_a4 = mc_opnd_reg(14)
                insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_LI, op_a2, mc_opnd_imm(dim_m), op_n0, op_n1, 0) as i64)
                insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_LI, op_a3, mc_opnd_imm(dim_k), op_n0, op_n1, 0) as i64)
                insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_LI, op_a4, mc_opnd_imm(dim_n), op_n0, op_n1, 0) as i64)

                var sym_name = "rt_matmul"
                if op == LirOp.Fma do sym_name = "rt_fma" end
                let op_sym = mc_opnd_symbol_cstr(sym_name, RelocKind.RISCV_CALL, 0)
                insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_JAL, op_sym, op_n0, op_n0, op_n1, 0) as i64)

                if rd >= 0 and rd != 10 do
                    let op_d = mc_opnd_reg(rd)
                    let op_a0 = mc_opnd_reg(10)
                    insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_MV, op_d, op_a0, op_n0, op_n1, 0) as i64)
                eif is_stack_mem(d) do
                    let op_a0 = mc_opnd_reg(10)
                    let op_s0_b = mc_opnd_reg(8)
                    let op_off_d = mc_opnd_imm(stack_mem_off(d))
                    insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_SD, op_a0, op_s0_b, op_off_d, op_n0, 0) as i64)
                end
                last_cmp_cond = 0 - 1
            eif op == LirOp.Load do
                var r_base = rs1
                if is_stack_mem(s1) do
                    let op_t0 = mc_opnd_reg(5)
                    let op_s0_b = mc_opnd_reg(8)
                    let op_off_s = mc_opnd_imm(stack_mem_off(s1))
                    insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_LD, op_t0, op_s0_b, op_off_s, op_n0, 0) as i64)
                    r_base = 5
                end
                var r_dst = rd
                if is_stack_mem(d) do r_dst = 6 end
                if r_dst >= 0 and r_base >= 0 do
                    let op_d = mc_opnd_reg(r_dst)
                    let op_b = mc_opnd_reg(r_base)
                    let op_off = mc_opnd_imm(0)
                    insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_LD, op_d, op_b, op_off, op_n0, 0) as i64)
                end
                if is_stack_mem(d) do
                    let op_d = mc_opnd_reg(r_dst)
                    let op_s0_b = mc_opnd_reg(8)
                    let op_off_d = mc_opnd_imm(stack_mem_off(d))
                    insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_SD, op_d, op_s0_b, op_off_d, op_n0, 0) as i64)
                end
                last_cmp_cond = 0 - 1
            eif op == LirOp.Store do
                var r_val = rs1
                if (s1 as i64) > 4096 and native_read_i64(s1 as i64, 0) == 5 do
                    let op_t0 = mc_opnd_reg(5)
                    let op_imm = mc_opnd_imm(native_read_i64(s1 as i64, 32))
                    insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_LI, op_t0, op_imm, op_n0, op_n1, 0) as i64)
                    r_val = 5
                eif is_stack_mem(s1) do
                    let op_t0 = mc_opnd_reg(5)
                    let op_s0_b = mc_opnd_reg(8)
                    let op_off_s = mc_opnd_imm(stack_mem_off(s1))
                    insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_LD, op_t0, op_s0_b, op_off_s, op_n0, 0) as i64)
                    r_val = 5
                end
                var r_base = rs2
                if is_stack_mem(s2) do
                    let op_t1 = mc_opnd_reg(6)
                    let op_s0_b = mc_opnd_reg(8)
                    let op_off_s2 = mc_opnd_imm(stack_mem_off(s2))
                    insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_LD, op_t1, op_s0_b, op_off_s2, op_n0, 0) as i64)
                    r_base = 6
                end
                if r_val >= 0 and r_base >= 0 do
                    let op_s = mc_opnd_reg(r_val)
                    let op_b = mc_opnd_reg(r_base)
                    let op_off = mc_opnd_imm(0)
                    insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_SD, op_s, op_b, op_off, op_n0, 0) as i64)
                end
                last_cmp_cond = 0 - 1
            eif op == LirOp.Not do
                var r_s1 = rs1
                if is_stack_mem(s1) do
                    let op_t0 = mc_opnd_reg(5)
                    let op_s0_b = mc_opnd_reg(8)
                    let op_off_s = mc_opnd_imm(stack_mem_off(s1))
                    insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_LD, op_t0, op_s0_b, op_off_s, op_n0, 0) as i64)
                    r_s1 = 5
                end
                var r_dst = rd
                if is_stack_mem(d) do r_dst = 5 end
                let op_d = mc_opnd_reg(r_dst)
                let op_s1_reg = mc_opnd_reg(r_s1)
                let op_m1 = mc_opnd_imm(0 - 1)
                insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_XORI, op_d, op_s1_reg, op_m1, op_n0, 0) as i64)
                if is_stack_mem(d) do
                    let op_s0_b = mc_opnd_reg(8)
                    let op_off_d = mc_opnd_imm(stack_mem_off(d))
                    insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_SD, op_d, op_s0_b, op_off_d, op_n0, 0) as i64)
                end
                last_cmp_cond = 0 - 1
            eif op == LirOp.Cmp do
                var r_s1 = rs1
                if (s1 as i64) > 4096 and native_read_i64(s1 as i64, 0) == 5 do
                    let imm = native_read_i64(s1 as i64, 32)
                    let op_t0 = mc_opnd_reg(5)
                    let op_i = mc_opnd_imm(imm)
                    insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_LI, op_t0, op_i, op_n0, op_n1, 0) as i64)
                    r_s1 = 5
                eif is_stack_mem(s1) do
                    let op_t0 = mc_opnd_reg(5)
                    let op_s0_b = mc_opnd_reg(8)
                    let op_off_s = mc_opnd_imm(stack_mem_off(s1))
                    insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_LD, op_t0, op_s0_b, op_off_s, op_n0, 0) as i64)
                    r_s1 = 5
                end
                var r_s2 = rs2
                if (s2 as i64) > 4096 and native_read_i64(s2 as i64, 0) == 5 do
                    let imm = native_read_i64(s2 as i64, 32)
                    let op_t1 = mc_opnd_reg(6)
                    let op_i = mc_opnd_imm(imm)
                    insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_LI, op_t1, op_i, op_n0, op_n1, 0) as i64)
                    r_s2 = 6
                eif is_stack_mem(s2) do
                    let op_t1 = mc_opnd_reg(6)
                    let op_s0_b = mc_opnd_reg(8)
                    let op_off_s2 = mc_opnd_imm(stack_mem_off(s2))
                    insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_LD, op_t1, op_s0_b, op_off_s2, op_n0, 0) as i64)
                    r_s2 = 6
                end
                last_cmp_cond = lir_instr_aux(ins)
                last_cmp_rs1 = r_s1
                last_cmp_rs2 = r_s2
                if rd >= 0 or is_stack_mem(d) do
                    var r_dst = rd
                    if is_stack_mem(d) do r_dst = 5 end
                    let op_d = mc_opnd_reg(r_dst)
                    let op_s1_reg = mc_opnd_reg(r_s1)
                    let op_s2_reg = mc_opnd_reg(r_s2)
                    let op_zero = mc_opnd_reg(0)
                    if last_cmp_cond == LIR_CMP_LT do
                        insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_SLT, op_d, op_s1_reg, op_s2_reg, op_n0, 0) as i64)
                    eif last_cmp_cond == LIR_CMP_GT do
                        insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_SLT, op_d, op_s2_reg, op_s1_reg, op_n0, 0) as i64)
                    eif last_cmp_cond == LIR_CMP_EQ do
                        insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_SUB, op_d, op_s1_reg, op_s2_reg, op_n0, 0) as i64)
                        insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_SLTIU, op_d, op_d, mc_opnd_imm(1), op_n0, 0) as i64)
                    eif last_cmp_cond == LIR_CMP_NE do
                        insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_SUB, op_d, op_s1_reg, op_s2_reg, op_n0, 0) as i64)
                        insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_SLTU, op_d, op_zero, op_d, op_n0, 0) as i64)
                    eif last_cmp_cond == LIR_CMP_GE do
                        insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_SLT, op_d, op_s1_reg, op_s2_reg, op_n0, 0) as i64)
                        insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_XORI, op_d, op_d, mc_opnd_imm(1), op_n0, 0) as i64)
                    eif last_cmp_cond == LIR_CMP_LE do
                        insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_SLT, op_d, op_s2_reg, op_s1_reg, op_n0, 0) as i64)
                        insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_XORI, op_d, op_d, mc_opnd_imm(1), op_n0, 0) as i64)
                    end
                    if is_stack_mem(d) do
                        let op_s0_b = mc_opnd_reg(8)
                        let op_off_d = mc_opnd_imm(stack_mem_off(d))
                        insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_SD, op_d, op_s0_b, op_off_d, op_n0, 0) as i64)
                    end
                end
            eif op == LirOp.Jmp do
                var tgt = 0 - 1
                if (s1 as i64) > 4096 do
                    let s1_typ = native_read_i64(s1 as i64, 0)
                    if s1_typ == 6 do tgt = native_read_i64(s1 as i64, 40) end
                    if s1_typ == 5 do tgt = native_read_i64(s1 as i64, 32) end
                end
                if tgt >= 0 do
                    let op_jmp = mc_opnd_imm(fid * 10000 + tgt)
                    insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_JAL, op_jmp, op_n0, op_n0, op_n1, 0) as i64)
                end
            eif op == LirOp.JmpCond do
                var tgt = 0 - 1
                if (s2 as i64) > 4096 do
                    let s2_typ = native_read_i64(s2 as i64, 0)
                    if s2_typ == 6 do tgt = native_read_i64(s2 as i64, 40) end
                    if s2_typ == 5 do tgt = native_read_i64(s2 as i64, 32) end
                end
                if tgt >= 0 do
                    let op_target = mc_opnd_imm(fid * 10000 + tgt)
                    let aux = lir_instr_aux(ins)
                    var b_opc = MCOpcode.RISCV_BNE
                    if aux != LIR_JMP_IF do b_opc = MCOpcode.RISCV_BEQ end

                    # JmpCond consumes the materialized boolean in src1. Do
                    # not branch on the operands of a previous Cmp: src1 may
                    # instead come from an intrinsic (for example STR_EQ), and
                    # comparison state from an earlier block is stale there.
                    var r1 = rs1
                    if is_stack_mem(s1) do
                        r1 = 5
                        let op_t0 = mc_opnd_reg(5)
                        let op_s0_b = mc_opnd_reg(8)
                        let op_off_s1 = mc_opnd_imm(stack_mem_off(s1))
                        insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_LD, op_t0, op_s0_b, op_off_s1, op_n0, 0) as i64)
                    eif (s1 as i64) > 4096 and native_read_i64(s1 as i64, 0) == 5 do
                        r1 = 5
                        let op_t0 = mc_opnd_reg(5)
                        let op_bool = mc_opnd_imm(native_read_i64(s1 as i64, 32))
                        insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_LI, op_t0, op_bool, op_n0, op_n1, 0) as i64)
                    end
                    if r1 < 0 do r1 = 0 end
                    let op_s1 = mc_opnd_reg(r1)
                    let op_s2 = mc_opnd_reg(0)
                    insts = vec_push_rt(insts, mc_inst_new(b_opc, op_s1, op_s2, op_target, op_n0, 0) as i64)
                end
            eif op == LirOp.Call do
                let n_stk = vec_len_rt(pending_stack_args)
                var stk_bytes = 0
                if n_stk > 0 do
                    stk_bytes = (n_stk * 8) + 15
                    stk_bytes = stk_bytes - (stk_bytes mod 16)
                    let op_sp = mc_opnd_reg(2)
                    let op_ssz = mc_opnd_imm(0 - stk_bytes)
                    insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_ADDI, op_sp, op_sp, op_ssz, op_n0, 0) as i64)
                    var si = 0
                    when si < n_stk loop
                        let s_ins = vec_get_rt(pending_stack_args, si)
                        let s_s2 = native_read_i64(s_ins as i64, 32)
                        let s_rs2 = resolve_mc_reg(s_s2 as LirOperand, assigned_phys)
                        var r_val = s_rs2
                        if is_stack_mem(s_s2 as LirOperand) do
                            let op_t0 = mc_opnd_reg(5)
                            let op_s0_b = mc_opnd_reg(8)
                            let op_off_src = mc_opnd_imm(stack_mem_off(s_s2 as LirOperand))
                            insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_LD, op_t0, op_s0_b, op_off_src, op_n0, 0) as i64)
                            r_val = 5
                        eif (s_s2 as i64) > 4096 and native_read_i64(s_s2 as i64, 0) == 5 do
                            let imm = native_read_i64(s_s2 as i64, 32)
                            let op_t0 = mc_opnd_reg(5)
                            let op_imm = mc_opnd_imm(imm)
                            insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_LI, op_t0, op_imm, op_n0, op_n1, 0) as i64)
                            r_val = 5
                        end
                        let op_val = mc_opnd_reg(r_val)
                        let op_off = mc_opnd_imm(si * 8)
                        insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_SD, op_val, op_sp, op_off, op_n0, 0) as i64)
                        si = si + 1
                    end
                    pending_stack_args = vec_new_rt()
                end

                let sid = native_read_i64(ins as i64, 40)
                let ins_src2 = native_read_i64(ins as i64, 32)
                var is_dynamic = 0
                if sid < 0 do
                    is_dynamic = 1
                eif ins_src2 > 4096 do
                    let s2_typ = native_read_i64(ins_src2, 0)
                    if s2_typ == 1 or s2_typ == 2 or s2_typ == 3 do
                        is_dynamic = 1
                    end
                end
                if is_dynamic == 1 do
                    var r_target = rs2
                    if r_target < 0 do r_target = 5 end # t0
                    let op_r = mc_opnd_reg(r_target)
                    insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_JALR, op_r, op_n0, op_n0, op_n1, 0) as i64)
                else
                    let f_strings = native_read_i64(func_obj as i64, 32)
                    var cname_str = 0
                    if f_strings > 0 and sid >= 0 and sid < vec_len_rt(f_strings) do
                        let fat_cname = vec_get_rt(f_strings, sid)
                        if fat_cname != 0 do
                            cname_str = native_read_i64(fat_cname, 0)
                        end
                    end
                    if cname_str == 0 do
                        print_str("virc: error: unresolved symbol in direct call\n")
                        sys_exit(1)
                        out 0
                    end
                    let op_sym = mc_opnd_symbol_cstr(cname_str, RelocKind.RISCV_CALL, 0)
                    insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_JAL, op_sym, op_n0, op_n0, op_n1, 0) as i64)
                end
                if stk_bytes > 0 do
                    let op_sp = mc_opnd_reg(2)
                    let op_ssz = mc_opnd_imm(stk_bytes)
                    insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_ADDI, op_sp, op_sp, op_ssz, op_n0, 0) as i64)
                end
                if rd >= 0 and rd != 10 do # a0
                    let op_d = mc_opnd_reg(rd)
                    let op_a0 = mc_opnd_reg(10)
                    insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_MV, op_d, op_a0, op_n0, op_n1, 0) as i64)
                eif is_stack_mem(d) do
                    let op_a0 = mc_opnd_reg(10)
                    let op_s0_b = mc_opnd_reg(8)
                    let op_off_d = mc_opnd_imm(stack_mem_off(d))
                    insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_SD, op_a0, op_s0_b, op_off_d, op_n0, 0) as i64)
                end
                last_cmp_cond = 0 - 1
            eif op == LirOp.SetArg do
                let ai = native_read_i64(ins as i64, 40)
                if ai == 0 do
                    pending_arg0_imm = 0 - 1
                    if (s2 as i64) > 4096 and native_read_i64(s2 as i64, 0) == 5 do
                        pending_arg0_imm = native_read_i64(s2 as i64, 32)
                    end
                end
                if ai >= 0 and ai < 8 do
                    let arg_r = riscv_mc_arg_reg(ai)
                    if is_stack_mem(s2) do
                        let op_ar = mc_opnd_reg(arg_r)
                        let op_s0_b = mc_opnd_reg(8)
                        let op_off_s = mc_opnd_imm(stack_mem_off(s2))
                        insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_LD, op_ar, op_s0_b, op_off_s, op_n0, 0) as i64)
                    eif (s2 as i64) > 4096 and native_read_i64(s2 as i64, 0) == 5 do
                        let imm = native_read_i64(s2 as i64, 32)
                        let op_ar = mc_opnd_reg(arg_r)
                        let op_imm = mc_opnd_imm(imm)
                        insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_LI, op_ar, op_imm, op_n0, op_n1, 0) as i64)
                    eif rs2 >= 0 and rs2 != arg_r do
                        let op_ar = mc_opnd_reg(arg_r)
                        let op_s = mc_opnd_reg(rs2)
                        insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_MV, op_ar, op_s, op_n0, op_n1, 0) as i64)
                    end
                else
                    pending_stack_args = vec_push_rt(pending_stack_args, ins)
                end
            eif op == LirOp.Intrinsic do
                let kind = native_read_i64(ins as i64, 40)
                if kind == MIR_INTR_PARAM do
                    if (s1 as i64) > 4096 do
                        let abi = native_read_i64(s1 as i64, 32)
                        if abi >= 0 and abi < 8 do
                            let arg_r = riscv_mc_arg_reg(abi)
                            if rd >= 0 and rd != arg_r do
                                let op_d = mc_opnd_reg(rd)
                                let op_ar = mc_opnd_reg(arg_r)
                                insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_MV, op_d, op_ar, op_n0, op_n1, 0) as i64)
                            eif is_stack_mem(d) do
                                let op_ar = mc_opnd_reg(arg_r)
                                let op_s0_b = mc_opnd_reg(8)
                                let op_off_d = mc_opnd_imm(stack_mem_off(d))
                                insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_SD, op_ar, op_s0_b, op_off_d, op_n0, 0) as i64)
                            end
                        eif abi >= 8 do
                            let off = (abi - 8) * 8
                            if rd >= 0 do
                                let op_d = mc_opnd_reg(rd)
                                let op_s0_b = mc_opnd_reg(8)
                                let op_off = mc_opnd_imm(off)
                                insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_LD, op_d, op_s0_b, op_off, op_n0, 0) as i64)
                            eif is_stack_mem(d) do
                                let op_t0 = mc_opnd_reg(5)
                                let op_s0_b = mc_opnd_reg(8)
                                let op_off_src = mc_opnd_imm(off)
                                insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_LD, op_t0, op_s0_b, op_off_src, op_n0, 0) as i64)
                                let op_off_dst = mc_opnd_imm(stack_mem_off(d))
                                insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_SD, op_t0, op_s0_b, op_off_dst, op_n0, 0) as i64)
                            end
                        end
                    end
                eif kind == MIR_INTR_ERX or kind == MIR_INTR_THROW do
                    insts = riscv_mc_error_intrinsic(insts, kind, d, s1, s2, rd, assigned_phys)
                eif kind == MIR_INTR_LOAD_ADDR do
                    let slot = native_read_i64(s1 as i64, 32)
                    let distance = 88 + 8 * slot
                    var target_reg = rd
                    if is_stack_mem(d) or target_reg < 0 do target_reg = 5 end
                    if distance <= 2047 do
                        insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_ADDI, mc_opnd_reg(target_reg), mc_opnd_reg(8), mc_opnd_imm(0 - distance), op_n0, 0) as i64)
                    else
                        insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_LI, mc_opnd_reg(target_reg), mc_opnd_imm(distance), op_n0, op_n1, 0) as i64)
                        insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_SUB, mc_opnd_reg(target_reg), mc_opnd_reg(8), mc_opnd_reg(target_reg), op_n0, 0) as i64)
                    end
                    if is_stack_mem(d) do
                        let op_s0_b = mc_opnd_reg(8)
                        let op_spill = mc_opnd_imm(stack_mem_off(d))
                        insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_SD, mc_opnd_reg(target_reg), op_s0_b, op_spill, op_n0, 0) as i64)
                    end
                eif kind == MIR_INTR_GLOBAL_LOAD do
                    let global_slot = native_read_i64(s1 as i64, 32)
                    let op_base = mc_opnd_reg(5)
                    let op_off = mc_opnd_reg(7)
                    let op_globals = mc_opnd_symbol_cstr("_vir_globals", RelocKind.RISCV_HI20, 0)
                    insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_LA, op_base, op_globals, op_n0, op_n1, 0) as i64)
                    insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_LI, op_off, mc_opnd_imm(global_slot * 8), op_n0, op_n1, 0) as i64)
                    insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_ADD, op_base, op_base, op_off, op_n0, 0) as i64)
                    var global_dst = rd
                    if is_stack_mem(d) do global_dst = 6 end
                    if global_dst >= 0 do
                        let op_dst = mc_opnd_reg(global_dst)
                        insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_LD, op_dst, op_base, mc_opnd_imm(0), op_n0, 0) as i64)
                        if is_stack_mem(d) do
                            let op_s0_b = mc_opnd_reg(8)
                            let op_spill = mc_opnd_imm(stack_mem_off(d))
                            insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_SD, op_dst, op_s0_b, op_spill, op_n0, 0) as i64)
                        end
                    end
                eif kind == MIR_INTR_GLOBAL_STORE do
                    let global_slot = native_read_i64(d as i64, 32)
                    let op_value = mc_opnd_reg(6)
                    if is_stack_mem(s1) do
                        let op_s0_b = mc_opnd_reg(8)
                        let op_spill = mc_opnd_imm(stack_mem_off(s1))
                        insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_LD, op_value, op_s0_b, op_spill, op_n0, 0) as i64)
                    eif (s1 as i64) > 4096 and native_read_i64(s1 as i64, 0) == 5 do
                        insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_LI, op_value, mc_opnd_imm(native_read_i64(s1 as i64, 32)), op_n0, op_n1, 0) as i64)
                    eif rs1 >= 0 and rs1 != 6 do
                        insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_MV, op_value, mc_opnd_reg(rs1), op_n0, op_n1, 0) as i64)
                    end
                    let op_base = mc_opnd_reg(5)
                    let op_off = mc_opnd_reg(7)
                    let op_globals = mc_opnd_symbol_cstr("_vir_globals", RelocKind.RISCV_HI20, 0)
                    insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_LA, op_base, op_globals, op_n0, op_n1, 0) as i64)
                    insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_LI, op_off, mc_opnd_imm(global_slot * 8), op_n0, op_n1, 0) as i64)
                    insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_ADD, op_base, op_base, op_off, op_n0, 0) as i64)
                    insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_SD, op_value, op_base, mc_opnd_imm(0), op_n0, 0) as i64)
                eif kind == MIR_INTR_STR_EQ do
                    # Case string patterns carry their function-local string
                    # pool id through the immediately preceding SetArg(0).
                    # Materialize the two C-string pointers and preserve the
                    # boolean result across register allocation/spilling.
                    var target_src3 = s1
                    if (target_src3 as i64) <= 4096 or native_read_i64(target_src3 as i64, 0) == 0 do
                        target_src3 = s2
                    end
                    if is_stack_mem(target_src3 as LirOperand) do
                        let op_a0 = mc_opnd_reg(10)
                        let op_s0_b = mc_opnd_reg(8)
                        let op_off = mc_opnd_imm(stack_mem_off(target_src3 as LirOperand))
                        insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_LD, op_a0, op_s0_b, op_off, op_n0, 0) as i64)
                    else
                        let target_r = resolve_mc_reg(target_src3 as LirOperand, assigned_phys)
                        if target_r >= 0 and target_r != 10 do
                            let op_a0 = mc_opnd_reg(10)
                            let op_target_r = mc_opnd_reg(target_r)
                            insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_MV, op_a0, op_target_r, op_n0, op_n1, 0) as i64)
                        end
                    end
                    if pending_arg0_imm >= 0 do
                        let pattern_sym = lir_mc_string_symbol(lir_func_id(func_obj), pending_arg0_imm)
                        let op_a1 = mc_opnd_reg(11)
                        let op_pattern = mc_opnd_symbol_cstr(pattern_sym, RelocKind.RISCV_HI20, 0)
                        insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_LA, op_a1, op_pattern, op_n0, op_n1, 0) as i64)
                        let op_eq = mc_opnd_symbol_cstr("rt_str_eq", RelocKind.RISCV_CALL, 0)
                        insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_JAL, op_eq, op_n0, op_n0, op_n1, 0) as i64)
                        if is_stack_mem(d) do
                            let op_a0 = mc_opnd_reg(10)
                            let op_s0_b = mc_opnd_reg(8)
                            let op_off_d = mc_opnd_imm(stack_mem_off(d))
                            insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_SD, op_a0, op_s0_b, op_off_d, op_n0, 0) as i64)
                        eif rd >= 0 and rd != 10 do
                            let op_d = mc_opnd_reg(rd)
                            let op_a0 = mc_opnd_reg(10)
                            insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_MV, op_d, op_a0, op_n0, op_n1, 0) as i64)
                        end
                    end
                    pending_arg0_imm = 0 - 1
                eif kind == MIR_INTR_PRINT do
                    var target_src = s1
                    if (target_src as i64) <= 4096 or native_read_i64(target_src as i64, 0) == 0 do
                        target_src = s2
                    end
                    if (target_src as i64) > 4096 do
                        let t_typ = native_read_i64(target_src as i64, 0)
                        if is_stack_mem(target_src as LirOperand) do
                            let op_a0 = mc_opnd_reg(10)
                            let op_s0_b = mc_opnd_reg(8)
                            let op_off = mc_opnd_imm(stack_mem_off(target_src as LirOperand))
                            insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_LD, op_a0, op_s0_b, op_off, op_n0, 0) as i64)
                        eif t_typ == 5 do # Imm
                            let imm = native_read_i64(target_src as i64, 32)
                            let op_a0 = mc_opnd_reg(10)
                            let op_imm = mc_opnd_imm(imm)
                            insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_LI, op_a0, op_imm, op_n0, op_n1, 0) as i64)
                        else
                            let r = resolve_mc_reg(target_src as LirOperand, assigned_phys)
                            if r >= 0 and r != 10 do
                                let op_a0 = mc_opnd_reg(10)
                                let op_s = mc_opnd_reg(r)
                                insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_MV, op_a0, op_s, op_n0, op_n1, 0) as i64)
                            end
                        end
                    end
                    let op_sym = mc_opnd_symbol_cstr("rt_print_int", RelocKind.RISCV_CALL, 0)
                    insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_JAL, op_sym, op_n0, op_n0, op_n1, 0) as i64)
                eif kind == MIR_INTR_PRINT_STR do
                    var target_src2 = s1
                    if (target_src2 as i64) <= 4096 or native_read_i64(target_src2 as i64, 0) == 0 do
                        target_src2 = s2
                    end
                    if (target_src2 as i64) > 4096 do
                        let t_typ = native_read_i64(target_src2 as i64, 0)
                        if is_stack_mem(target_src2 as LirOperand) do
                            let op_a0 = mc_opnd_reg(10)
                            let op_s0_b = mc_opnd_reg(8)
                            let op_off = mc_opnd_imm(stack_mem_off(target_src2 as LirOperand))
                            insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_LD, op_a0, op_s0_b, op_off, op_n0, 0) as i64)
                        eif t_typ == 5 do # Imm
                            let imm = native_read_i64(target_src2 as i64, 32)
                            let op_a0 = mc_opnd_reg(10)
                            let op_imm = mc_opnd_imm(imm)
                            insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_LI, op_a0, op_imm, op_n0, op_n1, 0) as i64)
                        else
                            let r = resolve_mc_reg(target_src2 as LirOperand, assigned_phys)
                            if r >= 0 and r != 10 do
                                let op_a0 = mc_opnd_reg(10)
                                let op_s = mc_opnd_reg(r)
                                insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_MV, op_a0, op_s, op_n0, op_n1, 0) as i64)
                            end
                        end
                    end
                    let op_sym = mc_opnd_symbol_cstr("rt_print_str", RelocKind.RISCV_CALL, 0)
                    insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_JAL, op_sym, op_n0, op_n0, op_n1, 0) as i64)
                eif kind == MIR_INTR_INDEX do
                    var r_base = rs1
                    if is_stack_mem(s1) do
                        let op_t0 = mc_opnd_reg(5)
                        let op_s0_b = mc_opnd_reg(8)
                        let op_off = mc_opnd_imm(stack_mem_off(s1))
                        insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_LD, op_t0, op_s0_b, op_off, op_n0, 0) as i64)
                        r_base = 5
                    end
                    let op_t1 = mc_opnd_reg(6)
                    let op_a0 = mc_opnd_reg(10)
                    insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_LI, op_t1, mc_opnd_imm(3), op_n0, op_n1, 0) as i64)
                    insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_SLL, op_t1, op_a0, op_t1, op_n0, 0) as i64)
                    let op_base = mc_opnd_reg(r_base)
                    insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_ADD, op_t1, op_t1, op_base, op_n0, 0) as i64)
                    var r_dst = rd
                    if is_stack_mem(d) do r_dst = 5 end
                    if r_dst >= 0 do
                        let op_d = mc_opnd_reg(r_dst)
                        insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_LD, op_d, op_t1, mc_opnd_imm(16), op_n0, 0) as i64)
                        if is_stack_mem(d) do
                            let op_s0_b = mc_opnd_reg(8)
                            let op_off_d = mc_opnd_imm(stack_mem_off(d))
                            insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_SD, op_d, op_s0_b, op_off_d, op_n0, 0) as i64)
                        end
                    end
                eif kind == MIR_INTR_INDEX_STORE do
                    var r_base = rs1
                    if is_stack_mem(s1) do
                        let op_t0 = mc_opnd_reg(5)
                        let op_s0_b = mc_opnd_reg(8)
                        let op_off = mc_opnd_imm(stack_mem_off(s1))
                        insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_LD, op_t0, op_s0_b, op_off, op_n0, 0) as i64)
                        r_base = 5
                    end
                    let op_t1 = mc_opnd_reg(6)
                    let op_a0 = mc_opnd_reg(10)
                    insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_LI, op_t1, mc_opnd_imm(3), op_n0, op_n1, 0) as i64)
                    insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_SLL, op_t1, op_a0, op_t1, op_n0, 0) as i64)
                    let op_base = mc_opnd_reg(r_base)
                    insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_ADD, op_t1, op_t1, op_base, op_n0, 0) as i64)
                    let op_a1 = mc_opnd_reg(11)
                    insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_SD, op_a1, op_t1, mc_opnd_imm(16), op_n0, 0) as i64)
                eif kind == MIR_INTR_STR_LIT do
                    var sid = 0
                    if (s1 as i64) > 4096 and native_read_i64(s1 as i64, 0) == 5 do
                        sid = native_read_i64(s1 as i64, 32)
                    end
                    var r_dst = rd
                    if is_stack_mem(d) do r_dst = 5 end
                    if r_dst >= 0 do
                        let sym = lir_mc_string_symbol(lir_func_id(func_obj), sid)
                        let op_d = mc_opnd_reg(r_dst)
                        let op_sym = mc_opnd_symbol_cstr(sym, RelocKind.RISCV_HI20, 0)
                        insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_LA, op_d, op_sym, op_n0, op_n1, 0) as i64)
                        if is_stack_mem(d) do
                            let op_s0_b = mc_opnd_reg(8)
                            let op_off = mc_opnd_imm(stack_mem_off(d))
                            insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_SD, op_d, op_s0_b, op_off, op_n1, 0) as i64)
                        end
                    end
                eif kind == MIR_INTR_ADDR_OF do
                    var cid = 0 - 1
                    if (s1 as i64) > 4096 and native_read_i64(s1 as i64, 0) == 5 do
                        cid = native_read_i64(s1 as i64, 32)
                    end
                    let f_strings = native_read_i64(func_obj as i64, 32)
                    var cname_str = 0
                    if f_strings > 0 and cid >= 0 and cid < vec_len_rt(f_strings) do
                        let fat_cname = vec_get_rt(f_strings, cid)
                        if fat_cname != 0 do
                            cname_str = native_read_i64(fat_cname, 0)
                        end
                    end
                    var r_dst = rd
                    if is_stack_mem(d) do r_dst = 5 end
                    if cname_str == 0 do
                        print_str("virc: error: unresolved symbol in function address\n")
                        sys_exit(1)
                        out 0
                    end
                    if r_dst < 0 do out 0 end
                    let op_d = mc_opnd_reg(r_dst)
                    let op_sym = mc_opnd_symbol_cstr(cname_str, RelocKind.RISCV_HI20, 0)
                    insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_LA, op_d, op_sym, op_n0, op_n1, 0) as i64)
                    if is_stack_mem(d) do
                        let op_s0_b = mc_opnd_reg(8)
                        let op_off = mc_opnd_imm(stack_mem_off(d))
                        insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_SD, op_d, op_s0_b, op_off, op_n1, 0) as i64)
                    end
                eif kind == MIR_INTR_BUILTIN do
                    var bid = 0
                    if (s1 as i64) > 4096 and native_read_i64(s1 as i64, 0) == 5 do
                        bid = native_read_i64(s1 as i64, 32)
                    end
                    if bid == 3 do
                        let op_sym = mc_opnd_symbol_cstr("rt_alloc", RelocKind.RISCV_CALL, 0)
                        insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_JAL, op_sym, op_n0, op_n0, op_n1, 0) as i64)
                    eif bid == 4 do
                        let op_sym = mc_opnd_symbol_cstr("vir_free", RelocKind.RISCV_CALL, 0)
                        insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_JAL, op_sym, op_n0, op_n0, op_n1, 0) as i64)
                    eif bid == 5 or bid == 10 do # read_byte / str_get / native_read_u8
                        let op_t0 = mc_opnd_reg(5)
                        let op_a0 = mc_opnd_reg(10)
                        let op_a1 = mc_opnd_reg(11)
                        insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_ADD, op_t0, op_a0, op_a1, op_n0, 0) as i64)
                        insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_LBU, op_a0, op_t0, mc_opnd_imm(0), op_n0, 0) as i64)
                    eif bid == 6 do # write_byte / native_write_u8
                        let op_t0 = mc_opnd_reg(5)
                        let op_a0 = mc_opnd_reg(10)
                        let op_a1 = mc_opnd_reg(11)
                        let op_a2 = mc_opnd_reg(12)
                        insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_ADD, op_t0, op_a0, op_a1, op_n0, 0) as i64)
                        insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_SB, op_a2, op_t0, mc_opnd_imm(0), op_n0, 0) as i64)
                    eif bid == 7 or bid == 46 do # read_word / native_read_i64
                        let op_t0 = mc_opnd_reg(5)
                        let op_a0 = mc_opnd_reg(10)
                        let op_a1 = mc_opnd_reg(11)
                        insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_ADD, op_t0, op_a0, op_a1, op_n0, 0) as i64)
                        insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_LD, op_a0, op_t0, mc_opnd_imm(0), op_n0, 0) as i64)
                    eif bid == 8 or bid == 47 do # write_word / native_write_i64
                        let op_t0 = mc_opnd_reg(5)
                        let op_a0 = mc_opnd_reg(10)
                        let op_a1 = mc_opnd_reg(11)
                        let op_a2 = mc_opnd_reg(12)
                        insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_ADD, op_t0, op_a0, op_a1, op_n0, 0) as i64)
                        insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_SD, op_a2, op_t0, mc_opnd_imm(0), op_n0, 0) as i64)
                    eif bid == 11 do
                        let op_sym = mc_opnd_symbol_cstr("rt_str_cat", RelocKind.RISCV_CALL, 0)
                        insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_JAL, op_sym, op_n0, op_n0, op_n1, 0) as i64)
                    eif bid == 19 do
                        let op_sym = mc_opnd_symbol_cstr("rt_int_to_str", RelocKind.RISCV_CALL, 0)
                        insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_JAL, op_sym, op_n0, op_n0, op_n1, 0) as i64)
                    eif bid == 1000 do
                        let op_sym = mc_opnd_symbol_cstr("rt_bool_to_str", RelocKind.RISCV_CALL, 0)
                        insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_JAL, op_sym, op_n0, op_n0, op_n1, 0) as i64)
                    end
                    if rd >= 0 and rd != 10 do
                        let op_d = mc_opnd_reg(rd)
                        let op_a0 = mc_opnd_reg(10)
                        insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_MV, op_d, op_a0, op_n0, op_n1, 0) as i64)
                    eif is_stack_mem(d) do
                        let op_a0 = mc_opnd_reg(10)
                        let op_s0_b = mc_opnd_reg(8)
                        let op_off_d = mc_opnd_imm(stack_mem_off(d))
                        insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_SD, op_a0, op_s0_b, op_off_d, op_n0, 0) as i64)
                    end
                eif kind == MIR_INTR_TRAIN do
                    let op_t0 = mc_opnd_reg(5)
                    let op_t1 = mc_opnd_reg(6)
                    let op_zero = mc_opnd_reg(0)
                    let op_sym = mc_opnd_symbol_cstr("_vir_train_active", RelocKind.RISCV_HI20, 0)
                    insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_LA, op_t0, op_sym, op_n0, op_n1, 0) as i64)
                    insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_LI, op_t1, mc_opnd_imm(1), op_n0, op_n1, 0) as i64)
                    insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_SD, op_t1, op_t0, mc_opnd_imm(0), op_n0, 0) as i64)
                    let op_sym_w = mc_opnd_symbol_cstr("_vir_train_w", RelocKind.RISCV_HI20, 0)
                    insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_LA, op_t0, op_sym_w, op_n0, op_n1, 0) as i64)
                    insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_SD, op_zero, op_t0, mc_opnd_imm(0), op_n0, 0) as i64)
                    let op_sym_x = mc_opnd_symbol_cstr("_vir_train_x", RelocKind.RISCV_HI20, 0)
                    insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_LA, op_t0, op_sym_x, op_n0, op_n1, 0) as i64)
                    insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_SD, op_zero, op_t0, mc_opnd_imm(0), op_n0, 0) as i64)
                eif kind == MIR_INTR_INFER do
                    let op_t0 = mc_opnd_reg(5)
                    let op_zero = mc_opnd_reg(0)
                    let op_sym = mc_opnd_symbol_cstr("_vir_train_active", RelocKind.RISCV_HI20, 0)
                    insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_LA, op_t0, op_sym, op_n0, op_n1, 0) as i64)
                    insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_SD, op_zero, op_t0, mc_opnd_imm(0), op_n0, 0) as i64)
                eif kind == MIR_INTR_QUANTIZE do
                    let op_a0 = mc_opnd_reg(10)
                    let op_a1 = mc_opnd_reg(11)
                    insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_MV, op_a1, op_a0, op_n0, op_n1, 0) as i64)
                    if is_stack_mem(s1) do
                        let op_s0_b = mc_opnd_reg(8)
                        let op_off_s = mc_opnd_imm(stack_mem_off(s1))
                        insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_LD, op_a0, op_s0_b, op_off_s, op_n0, 0) as i64)
                    eif rs1 >= 0 and rs1 != 10 do
                        let op_s = mc_opnd_reg(rs1)
                        insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_MV, op_a0, op_s, op_n0, op_n1, 0) as i64)
                    end
                    let op_sym = mc_opnd_symbol_cstr("rt_quantize", RelocKind.RISCV_CALL, 0)
                    insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_JAL, op_sym, op_n0, op_n0, op_n1, 0) as i64)
                    if rd >= 0 and rd != 10 do
                        let op_d = mc_opnd_reg(rd)
                        insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_MV, op_d, op_a0, op_n0, op_n1, 0) as i64)
                    eif is_stack_mem(d) do
                        let op_s0_b = mc_opnd_reg(8)
                        let op_off_d = mc_opnd_imm(stack_mem_off(d))
                        insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_SD, op_a0, op_s0_b, op_off_d, op_n0, 0) as i64)
                    end
                eif kind == MIR_INTR_BACKWARD do
                    let op_sym = mc_opnd_symbol_cstr("rt_backward", RelocKind.RISCV_CALL, 0)
                    insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_JAL, op_sym, op_n0, op_n0, op_n1, 0) as i64)
                eif kind == MIR_INTR_CAST do
                    if is_stack_mem(d) do
                        if is_stack_mem(s1) do
                            let op_t0 = mc_opnd_reg(5)
                            let op_s0_b = mc_opnd_reg(8)
                            let op_off_s = mc_opnd_imm(stack_mem_off(s1))
                            insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_LD, op_t0, op_s0_b, op_off_s, op_n0, 0) as i64)
                            let op_off_d = mc_opnd_imm(stack_mem_off(d))
                            insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_SD, op_t0, op_s0_b, op_off_d, op_n0, 0) as i64)
                        eif (s1 as i64) > 4096 and native_read_i64(s1 as i64, 0) == 5 do
                            let imm = native_read_i64(s1 as i64, 32)
                            let op_t0 = mc_opnd_reg(5)
                            let op_i = mc_opnd_imm(imm)
                            insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_LI, op_t0, op_i, op_n0, op_n1, 0) as i64)
                            let op_s0_b = mc_opnd_reg(8)
                            let op_off_d = mc_opnd_imm(stack_mem_off(d))
                            insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_SD, op_t0, op_s0_b, op_off_d, op_n0, 0) as i64)
                        eif rs1 >= 0 do
                            let op_s = mc_opnd_reg(rs1)
                            let op_s0_b = mc_opnd_reg(8)
                            let op_off_d = mc_opnd_imm(stack_mem_off(d))
                            insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_SD, op_s, op_s0_b, op_off_d, op_n0, 0) as i64)
                        end
                    eif rd >= 0 do
                        if is_stack_mem(s1) do
                            let op_d = mc_opnd_reg(rd)
                            let op_s0_b = mc_opnd_reg(8)
                            let op_off_s = mc_opnd_imm(stack_mem_off(s1))
                            insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_LD, op_d, op_s0_b, op_off_s, op_n0, 0) as i64)
                        eif (s1 as i64) > 4096 and native_read_i64(s1 as i64, 0) == 5 do
                            let imm = native_read_i64(s1 as i64, 32)
                            let op_d = mc_opnd_reg(rd)
                            let op_i = mc_opnd_imm(imm)
                            insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_LI, op_d, op_i, op_n0, op_n1, 0) as i64)
                        eif rs1 >= 0 and rd != rs1 do
                            let op_d = mc_opnd_reg(rd)
                            let op_s = mc_opnd_reg(rs1)
                            insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_MV, op_d, op_s, op_n0, op_n1, 0) as i64)
                        end
                    end
                end
                last_cmp_cond = 0 - 1
            eif op == LirOp.Ret do
                if is_stack_mem(s1) do
                    let op_a0 = mc_opnd_reg(10)
                    let op_s0_b = mc_opnd_reg(8)
                    let op_off = mc_opnd_imm(stack_mem_off(s1))
                    insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_LD, op_a0, op_s0_b, op_off, op_n0, 0) as i64)
                eif (s1 as i64) > 4096 do
                    let s1_typ = native_read_i64(s1 as i64, 0)
                    if s1_typ == 5 do # Imm
                        let imm_val = native_read_i64(s1 as i64, 32)
                        let op_a0 = mc_opnd_reg(10)
                        let op_imm = mc_opnd_imm(imm_val)
                        insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_LI, op_a0, op_imm, op_n0, op_n1, 0) as i64)
                    eif rs1 >= 0 and rs1 != 10 do
                        let op_a0 = mc_opnd_reg(10)
                        let op_s = mc_opnd_reg(rs1)
                        insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_MV, op_a0, op_s, op_n0, op_n1, 0) as i64)
                    end
                eif rs1 >= 0 and rs1 != 10 do
                    let op_a0 = mc_opnd_reg(10)
                    let op_s = mc_opnd_reg(rs1)
                    insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_MV, op_a0, op_s, op_n0, op_n1, 0) as i64)
                end
                let op_sp = mc_opnd_reg(2)
                let op_ra = mc_opnd_reg(1)
                let op_s0 = mc_opnd_reg(8)
                let op_off_ra = mc_opnd_imm(0)
                let op_off_s0 = mc_opnd_imm(8)
                var si_ld = 0
                when si_ld < 8 loop
                    let op_sr = mc_opnd_reg(18 + si_ld)
                    let off_sr = mc_opnd_imm(16 + (si_ld * 8))
                    insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_LD, op_sr, op_sp, off_sr, op_n0, 0) as i64)
                    si_ld = si_ld + 1
                end
                insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_LD, op_ra, op_sp, op_off_ra, op_n0, 0) as i64)
                insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_LD, op_s0, op_sp, op_off_s0, op_n0, 0) as i64)
                insts = emit_riscv_stack_adjust(insts, op_sp, total_ssz, op_n0)
                insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_RET, op_n0, op_n0, op_n0, op_n1, 0) as i64)
                last_cmp_cond = 0 - 1
            end

            ii = ii + 1
        end
        bi = bi + 1
    end

    # Fall-through epilogue (suppressed if last instruction was already Ret)
    if last_op != (LirOp.Ret as i64) do
        let op_a0 = mc_opnd_reg(10)
        let op_imm0 = mc_opnd_imm(0)
        insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_LI, op_a0, op_imm0, op_n0, op_n1, 0) as i64)
        let op_sp = mc_opnd_reg(2)
        let op_ra = mc_opnd_reg(1)
        let op_s0 = mc_opnd_reg(8)
        let op_off_ra = mc_opnd_imm(0)
        let op_off_s0 = mc_opnd_imm(8)
        var si_ld_ft = 0
        when si_ld_ft < 8 loop
            let op_sr = mc_opnd_reg(18 + si_ld_ft)
            let off_sr = mc_opnd_imm(16 + (si_ld_ft * 8))
            insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_LD, op_sr, op_sp, off_sr, op_n0, 0) as i64)
            si_ld_ft = si_ld_ft + 1
        end
        insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_LD, op_ra, op_sp, op_off_ra, op_n0, 0) as i64)
        insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_LD, op_s0, op_sp, op_off_s0, op_n0, 0) as i64)
        insts = emit_riscv_stack_adjust(insts, op_sp, total_ssz, op_n0)
        insts = vec_push_rt(insts, mc_inst_new(MCOpcode.RISCV_RET, op_n0, op_n0, op_n0, op_n1, 0) as i64)
    end

    out insts
end.

# ═══════════════════════════════════════════════════════
# 4. Unified LIR-to-MC Dispatcher
# ═══════════════════════════════════════════════════════

