##
 * compiler/src/lower/lir_codegen_x86/rt_stubs_base.vri — x86-64 Memory & String Runtime Stubs
 * ============================================================================================
 ##

include types
include vec_rt
include string_rt
include codegen
include lir_codegen_x86_types
include lir_codegen_x86_intrinsics
include lir_codegen_x86_calls

func emit_lir_rt_str_cat_stub_x86(cb: &CodeBuf):
    # RDI = a, RSI = b, R15 = ptr to bump pointer -> RAX = newly allocated concatenated string
    cb = codebuf_emit_byte(cb, 0x49); cb = codebuf_emit_byte(cb, 0x89); cb = codebuf_emit_byte(cb, 0xF8) # mov r8, rdi
    cb = codebuf_emit_byte(cb, 0x41); cb = codebuf_emit_byte(cb, 0x80); cb = codebuf_emit_byte(cb, 0x38); cb = codebuf_emit_byte(cb, 0x00) # cmp byte ptr [r8], 0
    cb = codebuf_emit_byte(cb, 0x74); cb = codebuf_emit_byte(cb, 0x05) # je +5
    cb = codebuf_emit_byte(cb, 0x49); cb = codebuf_emit_byte(cb, 0xFF); cb = codebuf_emit_byte(cb, 0xC0) # inc r8
    cb = codebuf_emit_byte(cb, 0xEB); cb = codebuf_emit_byte(cb, 0xF5) # jmp -11
    cb = codebuf_emit_byte(cb, 0x4D); cb = codebuf_emit_byte(cb, 0x89); cb = codebuf_emit_byte(cb, 0xC2) # mov r10, r8
    cb = codebuf_emit_byte(cb, 0x49); cb = codebuf_emit_byte(cb, 0x29); cb = codebuf_emit_byte(cb, 0xFA) # sub r10, rdi
    cb = codebuf_emit_byte(cb, 0x49); cb = codebuf_emit_byte(cb, 0x89); cb = codebuf_emit_byte(cb, 0xF1) # mov r9, rsi
    cb = codebuf_emit_byte(cb, 0x41); cb = codebuf_emit_byte(cb, 0x80); cb = codebuf_emit_byte(cb, 0x39); cb = codebuf_emit_byte(cb, 0x00) # cmp byte ptr [r9], 0
    cb = codebuf_emit_byte(cb, 0x74); cb = codebuf_emit_byte(cb, 0x05) # je +5
    cb = codebuf_emit_byte(cb, 0x49); cb = codebuf_emit_byte(cb, 0xFF); cb = codebuf_emit_byte(cb, 0xC1) # inc r9
    cb = codebuf_emit_byte(cb, 0xEB); cb = codebuf_emit_byte(cb, 0xF5) # jmp -11
    cb = codebuf_emit_byte(cb, 0x4D); cb = codebuf_emit_byte(cb, 0x89); cb = codebuf_emit_byte(cb, 0xCB) # mov r11, r9
    cb = codebuf_emit_byte(cb, 0x49); cb = codebuf_emit_byte(cb, 0x29); cb = codebuf_emit_byte(cb, 0xF3) # sub r11, rsi
    cb = codebuf_emit_byte(cb, 0x4B); cb = codebuf_emit_byte(cb, 0x8D); cb = codebuf_emit_byte(cb, 0x4C); cb = codebuf_emit_byte(cb, 0x1A); cb = codebuf_emit_byte(cb, 0x01) # lea rcx, [r10+r11+1]
    cb = codebuf_emit_byte(cb, 0x48); cb = codebuf_emit_byte(cb, 0x83); cb = codebuf_emit_byte(cb, 0xC1); cb = codebuf_emit_byte(cb, 0x07) # add rcx, 7
    cb = codebuf_emit_byte(cb, 0x48); cb = codebuf_emit_byte(cb, 0x83); cb = codebuf_emit_byte(cb, 0xE1); cb = codebuf_emit_byte(cb, 0xF8) # and rcx, -8
    cb = codebuf_emit_byte(cb, 0x49); cb = codebuf_emit_byte(cb, 0x8B); cb = codebuf_emit_byte(cb, 0x07) # mov rax, [r15]
    cb = codebuf_emit_byte(cb, 0x48); cb = codebuf_emit_byte(cb, 0x89); cb = codebuf_emit_byte(cb, 0xC2) # mov rdx, rax
    cb = codebuf_emit_byte(cb, 0x48); cb = codebuf_emit_byte(cb, 0x01); cb = codebuf_emit_byte(cb, 0xCA) # add rdx, rcx
    cb = codebuf_emit_byte(cb, 0x49); cb = codebuf_emit_byte(cb, 0x89); cb = codebuf_emit_byte(cb, 0x17) # mov [r15], rdx
    cb = codebuf_emit_byte(cb, 0x48); cb = codebuf_emit_byte(cb, 0x89); cb = codebuf_emit_byte(cb, 0xC2) # mov rdx, rax
    cb = codebuf_emit_byte(cb, 0x49); cb = codebuf_emit_byte(cb, 0x89); cb = codebuf_emit_byte(cb, 0xF8) # mov r8, rdi
    cb = codebuf_emit_byte(cb, 0x41); cb = codebuf_emit_byte(cb, 0x80); cb = codebuf_emit_byte(cb, 0x38); cb = codebuf_emit_byte(cb, 0x00) # cmp byte ptr [r8], 0
    cb = codebuf_emit_byte(cb, 0x74); cb = codebuf_emit_byte(cb, 0x0D) # je +13
    cb = codebuf_emit_byte(cb, 0x41); cb = codebuf_emit_byte(cb, 0x8A); cb = codebuf_emit_byte(cb, 0x08) # mov cl, [r8]
    cb = codebuf_emit_byte(cb, 0x88); cb = codebuf_emit_byte(cb, 0x0A) # mov [rdx], cl
    cb = codebuf_emit_byte(cb, 0x49); cb = codebuf_emit_byte(cb, 0xFF); cb = codebuf_emit_byte(cb, 0xC0) # inc r8
    cb = codebuf_emit_byte(cb, 0x48); cb = codebuf_emit_byte(cb, 0xFF); cb = codebuf_emit_byte(cb, 0xC2) # inc rdx
    cb = codebuf_emit_byte(cb, 0xEB); cb = codebuf_emit_byte(cb, 0xED) # jmp -19
    cb = codebuf_emit_byte(cb, 0x49); cb = codebuf_emit_byte(cb, 0x89); cb = codebuf_emit_byte(cb, 0xF1) # mov r9, rsi
    cb = codebuf_emit_byte(cb, 0x41); cb = codebuf_emit_byte(cb, 0x80); cb = codebuf_emit_byte(cb, 0x39); cb = codebuf_emit_byte(cb, 0x00) # cmp byte ptr [r9], 0
    cb = codebuf_emit_byte(cb, 0x74); cb = codebuf_emit_byte(cb, 0x0D) # je +13
    cb = codebuf_emit_byte(cb, 0x41); cb = codebuf_emit_byte(cb, 0x8A); cb = codebuf_emit_byte(cb, 0x09) # mov cl, [r9]
    cb = codebuf_emit_byte(cb, 0x88); cb = codebuf_emit_byte(cb, 0x0A) # mov [rdx], cl
    cb = codebuf_emit_byte(cb, 0x49); cb = codebuf_emit_byte(cb, 0xFF); cb = codebuf_emit_byte(cb, 0xC1) # inc r9
    cb = codebuf_emit_byte(cb, 0x48); cb = codebuf_emit_byte(cb, 0xFF); cb = codebuf_emit_byte(cb, 0xC2) # inc rdx
    cb = codebuf_emit_byte(cb, 0xEB); cb = codebuf_emit_byte(cb, 0xED) # jmp -19
    cb = codebuf_emit_byte(cb, 0xC6); cb = codebuf_emit_byte(cb, 0x02); cb = codebuf_emit_byte(cb, 0x00) # mov byte ptr [rdx], 0
    out x86_emit_ret(cb)
end.

func emit_lir_rt_int_to_str_stub_x86(cb: &CodeBuf):
    # RDI = signed int n, R15 = ptr to bump pointer -> RAX = ptr to freshly bump-allocated decimal string
    cb = codebuf_emit_byte(cb, 0x49); cb = codebuf_emit_byte(cb, 0x8B); cb = codebuf_emit_byte(cb, 0x07) # mov rax, [r15]
    cb = codebuf_emit_byte(cb, 0x48); cb = codebuf_emit_byte(cb, 0x8D); cb = codebuf_emit_byte(cb, 0x48); cb = codebuf_emit_byte(cb, 0x20) # lea rcx, [rax+32]
    cb = codebuf_emit_byte(cb, 0x49); cb = codebuf_emit_byte(cb, 0x89); cb = codebuf_emit_byte(cb, 0x0F) # mov [r15], rcx
    cb = codebuf_emit_byte(cb, 0x4C); cb = codebuf_emit_byte(cb, 0x8D); cb = codebuf_emit_byte(cb, 0x40); cb = codebuf_emit_byte(cb, 0x1F) # lea r8, [rax+31]
    cb = codebuf_emit_byte(cb, 0x41); cb = codebuf_emit_byte(cb, 0xC6); cb = codebuf_emit_byte(cb, 0x00); cb = codebuf_emit_byte(cb, 0x00) # mov byte ptr [r8], 0
    cb = codebuf_emit_byte(cb, 0x48); cb = codebuf_emit_byte(cb, 0x89); cb = codebuf_emit_byte(cb, 0xF9) # mov rcx, rdi
    cb = codebuf_emit_byte(cb, 0x45); cb = codebuf_emit_byte(cb, 0x31); cb = codebuf_emit_byte(cb, 0xC9) # xor r9d, r9d
    cb = codebuf_emit_byte(cb, 0x48); cb = codebuf_emit_byte(cb, 0x85); cb = codebuf_emit_byte(cb, 0xC9) # test rcx, rcx
    cb = codebuf_emit_byte(cb, 0x79); cb = codebuf_emit_byte(cb, 0x09) # jns +9
    cb = codebuf_emit_byte(cb, 0x41); cb = codebuf_emit_byte(cb, 0xB9); cb = codebuf_emit_byte(cb, 0x01); cb = codebuf_emit_byte(cb, 0x00); cb = codebuf_emit_byte(cb, 0x00); cb = codebuf_emit_byte(cb, 0x00) # mov r9d, 1
    cb = codebuf_emit_byte(cb, 0x48); cb = codebuf_emit_byte(cb, 0xF7); cb = codebuf_emit_byte(cb, 0xD9) # neg rcx
    cb = codebuf_emit_byte(cb, 0x48); cb = codebuf_emit_byte(cb, 0x89); cb = codebuf_emit_byte(cb, 0xC8) # mov rax, rcx
    cb = codebuf_emit_byte(cb, 0x49); cb = codebuf_emit_byte(cb, 0xC7); cb = codebuf_emit_byte(cb, 0xC2); cb = codebuf_emit_byte(cb, 0x0A); cb = codebuf_emit_byte(cb, 0x00); cb = codebuf_emit_byte(cb, 0x00); cb = codebuf_emit_byte(cb, 0x00) # mov r10, 10
    cb = codebuf_emit_byte(cb, 0x31); cb = codebuf_emit_byte(cb, 0xD2) # xor edx, edx
    cb = codebuf_emit_byte(cb, 0x49); cb = codebuf_emit_byte(cb, 0xF7); cb = codebuf_emit_byte(cb, 0xF2) # div r10
    cb = codebuf_emit_byte(cb, 0x80); cb = codebuf_emit_byte(cb, 0xC2); cb = codebuf_emit_byte(cb, 0x30) # add dl, 48
    cb = codebuf_emit_byte(cb, 0x49); cb = codebuf_emit_byte(cb, 0xFF); cb = codebuf_emit_byte(cb, 0xC8) # dec r8
    cb = codebuf_emit_byte(cb, 0x41); cb = codebuf_emit_byte(cb, 0x88); cb = codebuf_emit_byte(cb, 0x10) # mov [r8], dl
    cb = codebuf_emit_byte(cb, 0x48); cb = codebuf_emit_byte(cb, 0x85); cb = codebuf_emit_byte(cb, 0xC0) # test rax, rax
    cb = codebuf_emit_byte(cb, 0x75); cb = codebuf_emit_byte(cb, 0xED) # jne -19
    cb = codebuf_emit_byte(cb, 0x45); cb = codebuf_emit_byte(cb, 0x85); cb = codebuf_emit_byte(cb, 0xC9) # test r9d, r9d
    cb = codebuf_emit_byte(cb, 0x74); cb = codebuf_emit_byte(cb, 0x07) # je +7
    cb = codebuf_emit_byte(cb, 0x49); cb = codebuf_emit_byte(cb, 0xFF); cb = codebuf_emit_byte(cb, 0xC8) # dec r8
    cb = codebuf_emit_byte(cb, 0x41); cb = codebuf_emit_byte(cb, 0xC6); cb = codebuf_emit_byte(cb, 0x00); cb = codebuf_emit_byte(cb, 0x2D) # mov byte ptr [r8], 45
    cb = codebuf_emit_byte(cb, 0x4C); cb = codebuf_emit_byte(cb, 0x89); cb = codebuf_emit_byte(cb, 0xC0) # mov rax, r8
    out x86_emit_ret(cb)
end.

func emit_lir_rt_bool_to_str_stub_x86(cb: &CodeBuf):
    # RDI = Bool, R15 = ptr to bump pointer -> RAX = allocated C-string.
    cb = x86_emit_mov_reg_mem(cb, X86_RDX, X86_R15, 0)
    cb = x86_emit_mov_rr(cb, X86_RCX, X86_RDX)
    cb = x86_emit_mov_reg_imm32(cb, X86_RAX, 8)
    cb = x86_emit_add_rr(cb, X86_RCX, X86_RAX)
    cb = x86_emit_mov_mem_reg(cb, X86_R15, 0, X86_RCX)
    cb = x86_emit_mov_reg_imm64(cb, X86_RAX, 0x65736C6166)
    cb = x86_emit_mov_mem_reg(cb, X86_RDX, 0, X86_RAX)
    cb = codebuf_emit_byte(cb, 0x48); cb = codebuf_emit_byte(cb, 0x85); cb = codebuf_emit_byte(cb, 0xFF) # test rdi, rdi
    cb = codebuf_emit_byte(cb, 0x74); cb = codebuf_emit_byte(cb, 0x0D) # je +13
    cb = x86_emit_mov_reg_imm64(cb, X86_RAX, 0x65757274)
    cb = x86_emit_mov_mem_reg(cb, X86_RDX, 0, X86_RAX)
    cb = x86_emit_mov_rr(cb, X86_RAX, X86_RDX)
    out x86_emit_ret(cb)
end.

func x86_emit_div_idiv(cb: &CodeBuf):
    cb = x86_emit_cqo(cb)
    out x86_emit_idiv(cb, X86_RCX)
end.

# Integer tensor dot-product kernel shared by `**` and `><`.
# SysV input: RDI=A, RSI=B, RDX=M, RCX=K, R8=N.
# Tensor storage is [len, cap, row-major i64 elements...].  Integer
# multiplication/addition is exact modulo i64, so the fused form has no
# intermediate rounding to expose.  Floating-point fusion is selected by the
# typed/vector backend; this scalar kernel is the exact portable fallback.

func emit_lir_rt_promote_stub_x86(cb: &CodeBuf):
    # RDI = p, RSI = arena_base, RDX = arena_top
    let stub_entry_off = codebuf_offset(cb) as int
    # Guard 1: if p < 65536: return p (in RAX)
    cb = x86_emit_mov_rr(cb, X86_RAX, X86_RDI)
    cb = x86_emit_cmp_reg_imm32(cb, X86_RDI, 65536)
    cb = x86_emit_jl_rel32(cb, 0)
    let g1_fixup = codebuf_offset(cb) as int

    # Guard 2: if arena_base <= 0 or arena_top <= arena_base: return p
    cb = x86_emit_test_rr(cb, X86_RSI, X86_RSI)
    cb = x86_emit_jle_rel32(cb, 0)
    let g2_fixup = codebuf_offset(cb) as int

    cb = x86_emit_cmp_rr(cb, X86_RDX, X86_RSI)
    cb = x86_emit_jle_rel32(cb, 0)
    let g3_fixup = codebuf_offset(cb) as int

    # Guard 3: if p < arena_base or p >= arena_top: return p
    cb = x86_emit_cmp_rr(cb, X86_RDI, X86_RSI)
    cb = x86_emit_jl_rel32(cb, 0)
    let g4_fixup = codebuf_offset(cb) as int

    cb = x86_emit_cmp_rr(cb, X86_RDI, X86_RDX)
    cb = x86_emit_jge_rel32(cb, 0)
    let g5_fixup = codebuf_offset(cb) as int

    # Forwarding check at p - 16: if hdr[8] == -1, return hdr[0]
    cb = x86_emit_mov_reg_mem(cb, X86_R8, X86_RDI, 0 - 8)
    cb = x86_emit_mov_reg_imm64(cb, X86_R9, 0 - 1)
    cb = x86_emit_cmp_rr(cb, X86_R8, X86_R9)
    cb = x86_emit_jne_rel32(cb, 0)
    let not_fwd_fixup = codebuf_offset(cb) as int

    # Forwarded! Return hdr[0]
    cb = x86_emit_mov_reg_mem(cb, X86_RAX, X86_RDI, 0 - 16)
    cb = x86_emit_ret(cb)

    let not_fwd_off = codebuf_offset(cb) as int
    cb = patch_rel32(cb, not_fwd_fixup - 4, not_fwd_off)

    # Save callee-saved registers: RBX, R12, R13, R14
    cb = x86_emit_push(cb, X86_RBX)
    cb = x86_emit_push(cb, X86_R12)
    cb = x86_emit_push(cb, X86_R13)
    cb = x86_emit_push(cb, X86_R14)

    cb = x86_emit_mov_rr(cb, X86_RBX, X86_RDI) # RBX = p
    cb = x86_emit_mov_rr(cb, X86_R12, X86_RSI) # R12 = arena_base
    cb = x86_emit_mov_rr(cb, X86_R13, X86_RDX) # R13 = arena_top

    # Read total_size from [p - 16]
    cb = x86_emit_mov_reg_mem(cb, X86_R8, X86_RBX, 0 - 16)
    # payload_size = total_size - 16 (in R14)
    cb = x86_emit_mov_rr(cb, X86_R14, X86_R8)
    cb = x86_emit_mov_reg_imm32(cb, X86_RCX, 16)
    cb = x86_emit_sub_rr(cb, X86_R14, X86_RCX)
    cb = x86_emit_cmp_imm0(cb, X86_R14)
    cb = x86_emit_jg_rel32(cb, 0)
    let sz_ok_fixup = codebuf_offset(cb) as int
    cb = x86_emit_mov_reg_imm32(cb, X86_R14, 32)
    let sz_ok_off = codebuf_offset(cb) as int
    cb = patch_rel32(cb, sz_ok_fixup - 4, sz_ok_off)

    # total_alloc = payload_size + 16 (in R8)
    cb = x86_emit_mov_rr(cb, X86_R8, X86_R14)
    cb = x86_emit_mov_reg_imm32(cb, X86_RCX, 16)
    cb = x86_emit_add_rr(cb, X86_R8, X86_RCX)

    # Allocate from heap at [arena_base + 80]:
    cb = x86_emit_mov_reg_mem(cb, X86_R9, X86_R12, 80)
    cb = x86_emit_test_rr(cb, X86_R9, X86_R9)
    cb = x86_emit_jne_rel32(cb, 0)
    let heap_ok_fixup = codebuf_offset(cb) as int
    cb = x86_emit_mov_reg_mem(cb, X86_R9, X86_R12, 24)
    let heap_ok_off = codebuf_offset(cb) as int
    cb = patch_rel32(cb, heap_ok_fixup - 4, heap_ok_off)

    # cur_heap = (cur_heap - total_alloc) & ~15
    cb = x86_emit_sub_rr(cb, X86_R9, X86_R8)
    cb = x86_emit_shr_imm(cb, X86_R9, 4)
    cb = x86_emit_shl_imm(cb, X86_R9, 4)
    cb = x86_emit_mov_mem_reg(cb, X86_R12, 80, X86_R9)

    # Write new object header: hdr[0] = total_alloc, hdr[8] = 1
    cb = x86_emit_mov_mem_reg(cb, X86_R9, 0, X86_R8)
    cb = x86_emit_mov_reg_imm32(cb, X86_RCX, 1)
    cb = x86_emit_mov_mem_reg(cb, X86_R9, 8, X86_RCX)

    # new_p = cur_heap + 16 (in RAX)
    cb = x86_emit_mov_rr(cb, X86_RAX, X86_R9)
    cb = x86_emit_mov_reg_imm32(cb, X86_RCX, 16)
    cb = x86_emit_add_rr(cb, X86_RAX, X86_RCX)

    # Copy payload from p (RBX) to new_p (RAX): payload_size = R14
    cb = x86_emit_xor_rr(cb, X86_RCX, X86_RCX) # RCX = off = 0
    if target_has_sse2() == 1 do
        let sse_loop_off = codebuf_offset(cb) as int
        cb = x86_emit_mov_rr(cb, X86_R8, X86_RCX)
        cb = x86_emit_mov_reg_imm32(cb, X86_R9, 16)
        cb = x86_emit_add_rr(cb, X86_R8, X86_R9)
        cb = x86_emit_cmp_rr(cb, X86_R8, X86_R14)
        cb = x86_emit_jg_rel32(cb, 0)
        let sse_done_fixup = codebuf_offset(cb) as int
        # Load 16 bytes from [RBX + RCX] to XMM0
        cb = x86_emit_mov_rr(cb, X86_R8, X86_RBX)
        cb = x86_emit_add_rr(cb, X86_R8, X86_RCX)
        cb = x86_emit_movdqu_load(cb, 0, X86_R8, 0)
        # Store 16 bytes from XMM0 to [RAX + RCX]
        cb = x86_emit_mov_rr(cb, X86_R8, X86_RAX)
        cb = x86_emit_add_rr(cb, X86_R8, X86_RCX)
        cb = x86_emit_movdqu_store(cb, X86_R8, 0, 0)
        cb = x86_emit_mov_reg_imm32(cb, X86_R9, 16)
        cb = x86_emit_add_rr(cb, X86_RCX, X86_R9)
        cb = x86_emit_jmp_rel32(cb, 0)
        let sse_back_site = codebuf_offset(cb) as int
        cb = patch_rel32(cb, sse_back_site - 4, sse_loop_off)
        let sse_done_off = codebuf_offset(cb) as int
        cb = patch_rel32(cb, sse_done_fixup - 4, sse_done_off)
    end

    # Scalar 8-byte copy loop
    let scal_loop_off = codebuf_offset(cb) as int
    cb = x86_emit_cmp_rr(cb, X86_RCX, X86_R14)
    cb = x86_emit_jge_rel32(cb, 0)
    let scal_done_fixup = codebuf_offset(cb) as int
    cb = x86_emit_mov_rr(cb, X86_R10, X86_RBX)
    cb = x86_emit_add_rr(cb, X86_R10, X86_RCX)
    cb = x86_emit_mov_reg_mem(cb, X86_R8, X86_R10, 0)
    cb = x86_emit_mov_rr(cb, X86_R10, X86_RAX)
    cb = x86_emit_add_rr(cb, X86_R10, X86_RCX)
    cb = x86_emit_mov_mem_reg(cb, X86_R10, 0, X86_R8)
    cb = x86_emit_mov_reg_imm32(cb, X86_R9, 8)
    cb = x86_emit_add_rr(cb, X86_RCX, X86_R9)
    cb = x86_emit_jmp_rel32(cb, 0)
    let scal_back_site = codebuf_offset(cb) as int
    cb = patch_rel32(cb, scal_back_site - 4, scal_loop_off)
    let scal_done_off = codebuf_offset(cb) as int
    cb = patch_rel32(cb, scal_done_fixup - 4, scal_done_off)

    # Mark original object as forwarded: hdr[8] = -1, hdr[0] = new_p
    cb = x86_emit_mov_reg_imm64(cb, X86_R8, 0 - 1)
    cb = x86_emit_mov_mem_reg(cb, X86_RBX, 0 - 8, X86_R8)
    cb = x86_emit_mov_mem_reg(cb, X86_RBX, 0 - 16, X86_RAX)

    # Recursively promote child pointers in new_p (RAX):
    # R11 = scan offset (caller-saved; 0..R14 step 8).
    # Stack at entry of loop body: 4 callee pushes (32B) + original ret-addr (8B) = 40B below RSP.
    # Around call: push RAX + push R11 = +16B; CALL pushes ret-addr +8B => 64B -> 16-aligned.
    cb = x86_emit_xor_rr(cb, X86_R11, X86_R11)
    let child_loop_off = codebuf_offset(cb) as int
    cb = x86_emit_cmp_rr(cb, X86_R11, X86_R14)
    cb = x86_emit_jge_rel32(cb, 0)
    let child_done_fixup = codebuf_offset(cb) as int

    # Load child = [new_p + R11] into R10
    cb = x86_emit_mov_rr(cb, X86_R10, X86_RAX)
    cb = x86_emit_add_rr(cb, X86_R10, X86_R11)
    cb = x86_emit_mov_reg_mem(cb, X86_R10, X86_R10, 0)

    # Skip: child <= 65535
    cb = x86_emit_cmp_reg_imm32(cb, X86_R10, 65536)
    cb = x86_emit_jl_rel32(cb, 0)
    let skip_ch1 = codebuf_offset(cb) as int

    # Skip: child < arena_base
    cb = x86_emit_cmp_rr(cb, X86_R10, X86_R12)
    cb = x86_emit_jl_rel32(cb, 0)
    let skip_ch2 = codebuf_offset(cb) as int

    # Skip: child >= arena_top
    cb = x86_emit_cmp_rr(cb, X86_R10, X86_R13)
    cb = x86_emit_jge_rel32(cb, 0)
    let skip_ch3 = codebuf_offset(cb) as int

    # Call self(child, arena_base, arena_top); save new_p and scan offset
    cb = x86_emit_push(cb, X86_RAX)
    cb = x86_emit_push(cb, X86_R11)
    cb = x86_emit_mov_rr(cb, X86_RDI, X86_R10)
    cb = x86_emit_mov_rr(cb, X86_RSI, X86_R12)
    cb = x86_emit_mov_rr(cb, X86_RDX, X86_R13)
    cb = x86_emit_call_rel32(cb, 0)
    let call_fixup = codebuf_offset(cb) as int
    cb = patch_rel32(cb, call_fixup - 4, stub_entry_off)
    # RAX = promoted child pointer
    cb = x86_emit_pop(cb, X86_R11)
    cb = x86_emit_add_rsp_imm(cb, 8)           # discard saved new_p slot
    # Reload new_p from [RBX - 16] (hdr[0] = new_p, written above)
    cb = x86_emit_mov_reg_mem(cb, X86_R9, X86_RBX, 0 - 16)
    # Store promoted child back to [new_p + R11]
    cb = x86_emit_mov_rr(cb, X86_R8, X86_R9)
    cb = x86_emit_add_rr(cb, X86_R8, X86_R11)
    cb = x86_emit_mov_mem_reg(cb, X86_R8, 0, X86_RAX)
    # Restore RAX = new_p for next iteration
    cb = x86_emit_mov_rr(cb, X86_RAX, X86_R9)

    let next_ch_off = codebuf_offset(cb) as int
    cb = patch_rel32(cb, skip_ch1 - 4, next_ch_off)
    cb = patch_rel32(cb, skip_ch2 - 4, next_ch_off)
    cb = patch_rel32(cb, skip_ch3 - 4, next_ch_off)

    # R11 += 8; continue loop
    cb = x86_emit_mov_reg_imm32(cb, X86_R9, 8)
    cb = x86_emit_add_rr(cb, X86_R11, X86_R9)
    cb = x86_emit_jmp_rel32(cb, 0)
    let loop_back_site = codebuf_offset(cb) as int
    cb = patch_rel32(cb, loop_back_site - 4, child_loop_off)

    let child_done_off = codebuf_offset(cb) as int
    cb = patch_rel32(cb, child_done_fixup - 4, child_done_off)

    # Restore callee-saved registers and return new_p (RAX)
    cb = x86_emit_pop(cb, X86_R14)
    cb = x86_emit_pop(cb, X86_R13)
    cb = x86_emit_pop(cb, X86_R12)
    cb = x86_emit_pop(cb, X86_RBX)
    cb = x86_emit_ret(cb)

    # Patch guard exits to return p (RAX set at guard-1 entry)
    let done_off = codebuf_offset(cb) as int
    cb = patch_rel32(cb, g1_fixup - 4, done_off)
    cb = patch_rel32(cb, g2_fixup - 4, done_off)
    cb = patch_rel32(cb, g3_fixup - 4, done_off)
    cb = patch_rel32(cb, g4_fixup - 4, done_off)
    cb = patch_rel32(cb, g5_fixup - 4, done_off)
    out x86_emit_ret(cb)
end.

