##
 * compiler/src/lower/lir_codegen_x86/calls.vri — x86-64 Calls & Basic Print Stubs
 * ===============================================================================
 ##

include types_prelude
include rt_vec_rt
include rt_string_rt
include codegen
include lir_codegen_x86_types
include lir_codegen_x86_intrinsics

func emit_lir_call_x86(cb: &CodeBuf, ins: LirInstr, rd: i64, func_obj: &LirFunc, lir_funcs: i64, call_fixups: i64, pending_stk: i64, assigned_phys: i64):
    if pending_stk > 1 do
        cb = reverse_pending_stack_args_x86(cb, pending_stk)
    end
    sid = native_read_i64(ins as i64, 40)
    ins_src2 = native_read_i64(ins as i64, 32)
    var is_dynamic = 0
    if sid < 0 do
        is_dynamic = 1
    eif (ins_src2 as i64) != 0 do
        s2_typ = native_read_i64(ins_src2 as i64, 0)
        if s2_typ == 1 or s2_typ == 3 do
            is_dynamic = 1
        end
    end
    if is_dynamic == 1 do
        if (ins_src2 as i64) == 0 do
            print_str("virc: linker error: unresolved dynamic function call: missing target operand\n")
            sys_exit(1)
        end
        var r_target = resolve_reg_x86(ins_src2 as LirOperand, assigned_phys)
        if r_target < 0 do
            r_target = X86_R11
        end
        cb = x86_emit_call_reg(cb, r_target as int)
        if rd >= 0 and rd != X86_RAX do
            cb = x86_emit_mov_rr(cb, rd as int, X86_RAX)
        end
        if rd < 0 do
            cb = store_spilled_result_x86(cb, native_read_i64(ins as i64, 16) as LirOperand, X86_RAX)
        end
        if pending_stk > 0 do
            bytes = pending_stk * 8
            if bytes > 0 and bytes <= 4096 do
                cb = x86_emit_add_rsp_imm(cb, bytes)
            end
        end
        out 0
    end
    target_kind = 1
    target_id = LIR_RT_UNRESOLVED
    target_kind = 0 - 1
    target_id = 0 - 1
    var cname = fat_str_new("")
    f_strings = native_read_i64(func_obj as i64, 32)
    if f_strings > 0 and sid >= 0 and sid < vec_len_rt(f_strings) do
        cname = vec_get_rt(f_strings, sid)
        fi = x86_find_func_index(lir_funcs, cname)
        if fi >= 0 do
            target_kind = 0
            target_id = fi
        else
            stub_id = x86_stub_for_callee_name(cname)
            if stub_id >= 0 do
                target_kind = 1
                target_id = stub_id
            else
                ffi_id = ffi_import_find(cname)
                if ffi_id >= 0 do
                    target_kind = 3
                    target_id = ffi_id
                    ffi_import_mark_used(ffi_id as int)
                end
            end
        end
    end
    if target_id < 0 or (target_kind == 1 and target_id == LIR_RT_UNRESOLVED) do
        print_str("virc: linker error: unresolved direct function call: ")
        if (cname as i64) != 0 do
            print_str(cname as string)
        end
        print_str("\n")
        sys_exit(1)
    end
    if target_kind == 3 and (fat_cstr_eq(ffi_import_return_type(target_id), "float") == 1 or fat_cstr_eq(ffi_import_return_type(target_id), "f64") == 1) do
        cb = emit_call_fixup_x86(cb, call_fixups, target_kind, target_id, 0 - 1)
        cb = x86_emit_movq_gpr_xmm(cb, X86_RAX, 0)
        if rd >= 0 and rd != X86_RAX do cb = x86_emit_mov_rr(cb, rd as int, X86_RAX) end
    else
        cb = emit_call_fixup_x86(cb, call_fixups, target_kind, target_id, rd)
    end
    if rd < 0 do
        cb = store_spilled_result_x86(cb, native_read_i64(ins as i64, 16) as LirOperand, X86_RAX)
    end
    if pending_stk > 0 do
        bytes = pending_stk * 8
        if bytes > 0 and bytes <= 4096 do
            cb = x86_emit_add_rsp_imm(cb, bytes)
        end
    end
    out 0
end.

func emit_lir_rt_print_stub_x86(cb: &CodeBuf):
    cb = codebuf_emit_byte(cb, 0x55)
    cb = codebuf_emit_byte(cb, 0x48); cb = codebuf_emit_byte(cb, 0x89); cb = codebuf_emit_byte(cb, 0xE5)
    cb = codebuf_emit_byte(cb, 0x48); cb = codebuf_emit_byte(cb, 0x83); cb = codebuf_emit_byte(cb, 0xEC); cb = codebuf_emit_byte(cb, 0x40)
    cb = codebuf_emit_byte(cb, 0x48); cb = codebuf_emit_byte(cb, 0x89); cb = codebuf_emit_byte(cb, 0xF8)
    cb = codebuf_emit_byte(cb, 0x48); cb = codebuf_emit_byte(cb, 0x8D); cb = codebuf_emit_byte(cb, 0x75); cb = codebuf_emit_byte(cb, 0xFF)
    cb = codebuf_emit_byte(cb, 0xC6); cb = codebuf_emit_byte(cb, 0x06); cb = codebuf_emit_byte(cb, 0x0A)
    cb = codebuf_emit_byte(cb, 0x4D); cb = codebuf_emit_byte(cb, 0x31); cb = codebuf_emit_byte(cb, 0xC9)
    cb = codebuf_emit_byte(cb, 0x48); cb = codebuf_emit_byte(cb, 0x85); cb = codebuf_emit_byte(cb, 0xC0)
    cb = codebuf_emit_byte(cb, 0x79); cb = codebuf_emit_byte(cb, 0x06)
    cb = codebuf_emit_byte(cb, 0x49); cb = codebuf_emit_byte(cb, 0xFF); cb = codebuf_emit_byte(cb, 0xC1)
    cb = codebuf_emit_byte(cb, 0x48); cb = codebuf_emit_byte(cb, 0xF7); cb = codebuf_emit_byte(cb, 0xD8)
    cb = codebuf_emit_byte(cb, 0x48); cb = codebuf_emit_byte(cb, 0xC7); cb = codebuf_emit_byte(cb, 0xC1); cb = codebuf_emit_byte(cb, 0x0A); cb = codebuf_emit_byte(cb, 0x00); cb = codebuf_emit_byte(cb, 0x00); cb = codebuf_emit_byte(cb, 0x00)
    cb = codebuf_emit_byte(cb, 0x48); cb = codebuf_emit_byte(cb, 0x85); cb = codebuf_emit_byte(cb, 0xC0)
    cb = codebuf_emit_byte(cb, 0x75); cb = codebuf_emit_byte(cb, 0x08)
    cb = codebuf_emit_byte(cb, 0x48); cb = codebuf_emit_byte(cb, 0xFF); cb = codebuf_emit_byte(cb, 0xCE)
    cb = codebuf_emit_byte(cb, 0xC6); cb = codebuf_emit_byte(cb, 0x06); cb = codebuf_emit_byte(cb, 0x30)
    cb = codebuf_emit_byte(cb, 0xEB); cb = codebuf_emit_byte(cb, 0x13)
    cb = codebuf_emit_byte(cb, 0x48); cb = codebuf_emit_byte(cb, 0x31); cb = codebuf_emit_byte(cb, 0xD2)
    cb = codebuf_emit_byte(cb, 0x48); cb = codebuf_emit_byte(cb, 0xF7); cb = codebuf_emit_byte(cb, 0xF1)
    cb = codebuf_emit_byte(cb, 0x80); cb = codebuf_emit_byte(cb, 0xC2); cb = codebuf_emit_byte(cb, 0x30)
    cb = codebuf_emit_byte(cb, 0x48); cb = codebuf_emit_byte(cb, 0xFF); cb = codebuf_emit_byte(cb, 0xCE)
    cb = codebuf_emit_byte(cb, 0x88); cb = codebuf_emit_byte(cb, 0x16)
    cb = codebuf_emit_byte(cb, 0x48); cb = codebuf_emit_byte(cb, 0x85); cb = codebuf_emit_byte(cb, 0xC0)
    cb = codebuf_emit_byte(cb, 0x75); cb = codebuf_emit_byte(cb, 0xED)
    cb = codebuf_emit_byte(cb, 0x4D); cb = codebuf_emit_byte(cb, 0x85); cb = codebuf_emit_byte(cb, 0xC9)
    cb = codebuf_emit_byte(cb, 0x74); cb = codebuf_emit_byte(cb, 0x06)
    cb = codebuf_emit_byte(cb, 0x48); cb = codebuf_emit_byte(cb, 0xFF); cb = codebuf_emit_byte(cb, 0xCE)
    cb = codebuf_emit_byte(cb, 0xC6); cb = codebuf_emit_byte(cb, 0x06); cb = codebuf_emit_byte(cb, 0x2D)
    cb = codebuf_emit_byte(cb, 0x48); cb = codebuf_emit_byte(cb, 0x89); cb = codebuf_emit_byte(cb, 0xEA)
    cb = codebuf_emit_byte(cb, 0x48); cb = codebuf_emit_byte(cb, 0x29); cb = codebuf_emit_byte(cb, 0xF2)
    cb = codebuf_emit_byte(cb, 0x48); cb = codebuf_emit_byte(cb, 0xC7); cb = codebuf_emit_byte(cb, 0xC0); cb = codebuf_emit_byte(cb, 0x01); cb = codebuf_emit_byte(cb, 0x00); cb = codebuf_emit_byte(cb, 0x00); cb = codebuf_emit_byte(cb, 0x00)
    cb = codebuf_emit_byte(cb, 0x48); cb = codebuf_emit_byte(cb, 0xC7); cb = codebuf_emit_byte(cb, 0xC7); cb = codebuf_emit_byte(cb, 0x01); cb = codebuf_emit_byte(cb, 0x00); cb = codebuf_emit_byte(cb, 0x00); cb = codebuf_emit_byte(cb, 0x00)
    cb = codebuf_emit_byte(cb, 0x0F); cb = codebuf_emit_byte(cb, 0x05)
    cb = codebuf_emit_byte(cb, 0x48); cb = codebuf_emit_byte(cb, 0x89); cb = codebuf_emit_byte(cb, 0xEC)
    cb = codebuf_emit_byte(cb, 0x5D)
    out codebuf_emit_byte(cb, 0xC3)
end.

func emit_lir_rt_print_float_stub_x86(cb: &CodeBuf):
    # push rbp
    cb = codebuf_emit_byte(cb, 0x55)
    # mov rbp, rsp
    cb = codebuf_emit_byte(cb, 0x48); cb = codebuf_emit_byte(cb, 0x89); cb = codebuf_emit_byte(cb, 0xE5)
    # sub rsp, 128
    cb = codebuf_emit_byte(cb, 0x48); cb = codebuf_emit_byte(cb, 0x81); cb = codebuf_emit_byte(cb, 0xEC)
    cb = codebuf_emit_byte(cb, 0x80); cb = codebuf_emit_byte(cb, 0x00); cb = codebuf_emit_byte(cb, 0x00); cb = codebuf_emit_byte(cb, 0x00)

    # mov r8, rbp; sub r8, 128 (write pointer r8)
    cb = codebuf_emit_byte(cb, 0x49); cb = codebuf_emit_byte(cb, 0x89); cb = codebuf_emit_byte(cb, 0xE8)
    cb = codebuf_emit_byte(cb, 0x49); cb = codebuf_emit_byte(cb, 0x81); cb = codebuf_emit_byte(cb, 0xE8)
    cb = codebuf_emit_byte(cb, 0x80); cb = codebuf_emit_byte(cb, 0x00); cb = codebuf_emit_byte(cb, 0x00); cb = codebuf_emit_byte(cb, 0x00)

    # test rdi, rdi (check sign bit)
    cb = codebuf_emit_byte(cb, 0x48); cb = codebuf_emit_byte(cb, 0x85); cb = codebuf_emit_byte(cb, 0xFF)
    cb = x86_emit_jge_rel32(cb, 0)
    let fix_pos = codebuf_offset(cb) as int

    # Negative: mov byte ptr [r8], '-'; inc r8; clear sign bit of rdi
    cb = codebuf_emit_byte(cb, 0x41); cb = codebuf_emit_byte(cb, 0xC6); cb = codebuf_emit_byte(cb, 0x00); cb = codebuf_emit_byte(cb, 0x2D)
    cb = codebuf_emit_byte(cb, 0x49); cb = codebuf_emit_byte(cb, 0xFF); cb = codebuf_emit_byte(cb, 0xC0)
    cb = codebuf_emit_byte(cb, 0x48); cb = codebuf_emit_byte(cb, 0xB8)
    cb = codebuf_emit_byte(cb, 0xFF); cb = codebuf_emit_byte(cb, 0xFF); cb = codebuf_emit_byte(cb, 0xFF); cb = codebuf_emit_byte(cb, 0xFF)
    cb = codebuf_emit_byte(cb, 0xFF); cb = codebuf_emit_byte(cb, 0xFF); cb = codebuf_emit_byte(cb, 0xFF); cb = codebuf_emit_byte(cb, 0x7F)
    cb = codebuf_emit_byte(cb, 0x48); cb = codebuf_emit_byte(cb, 0x21); cb = codebuf_emit_byte(cb, 0xC7)

    let pos_lbl = codebuf_offset(cb) as int
    cb = patch_rel32(cb, fix_pos - 4, pos_lbl)

    # movq xmm0, rdi (load double into xmm0)
    cb = codebuf_emit_byte(cb, 0x66); cb = codebuf_emit_byte(cb, 0x48); cb = codebuf_emit_byte(cb, 0x0F)
    cb = codebuf_emit_byte(cb, 0x6E); cb = codebuf_emit_byte(cb, 0xC7)

    # cvttsd2si rax, xmm0 (truncate integer part)
    cb = codebuf_emit_byte(cb, 0xF2); cb = codebuf_emit_byte(cb, 0x48); cb = codebuf_emit_byte(cb, 0x0F)
    cb = codebuf_emit_byte(cb, 0x2C); cb = codebuf_emit_byte(cb, 0xC0)

    # cvtsi2sd xmm1, rax
    cb = codebuf_emit_byte(cb, 0xF2); cb = codebuf_emit_byte(cb, 0x48); cb = codebuf_emit_byte(cb, 0x0F)
    cb = codebuf_emit_byte(cb, 0x2A); cb = codebuf_emit_byte(cb, 0xC8)

    # subsd xmm0, xmm1 (xmm0 = fractional part)
    cb = codebuf_emit_byte(cb, 0xF2); cb = codebuf_emit_byte(cb, 0x0F); cb = codebuf_emit_byte(cb, 0x5C); cb = codebuf_emit_byte(cb, 0xC1)

    # Format integer part rax:
    cb = codebuf_emit_byte(cb, 0x48); cb = codebuf_emit_byte(cb, 0x85); cb = codebuf_emit_byte(cb, 0xC0)
    cb = x86_emit_jne_rel32(cb, 0)
    let fix_int_nz = codebuf_offset(cb) as int

    # rax == 0:
    cb = codebuf_emit_byte(cb, 0x41); cb = codebuf_emit_byte(cb, 0xC6); cb = codebuf_emit_byte(cb, 0x00); cb = codebuf_emit_byte(cb, 0x30)
    cb = codebuf_emit_byte(cb, 0x49); cb = codebuf_emit_byte(cb, 0xFF); cb = codebuf_emit_byte(cb, 0xC0)
    cb = x86_emit_jmp_rel32(cb, 0)
    let fix_int_done = codebuf_offset(cb) as int

    let int_nz_lbl = codebuf_offset(cb) as int
    cb = patch_rel32(cb, fix_int_nz - 4, int_nz_lbl)

    # rax != 0: divide by 10 backwards into [rbp - 1] using r9
    cb = codebuf_emit_byte(cb, 0x49); cb = codebuf_emit_byte(cb, 0x89); cb = codebuf_emit_byte(cb, 0xE9)
    cb = codebuf_emit_byte(cb, 0x49); cb = codebuf_emit_byte(cb, 0xFF); cb = codebuf_emit_byte(cb, 0xC9)
    cb = codebuf_emit_byte(cb, 0x48); cb = codebuf_emit_byte(cb, 0xC7); cb = codebuf_emit_byte(cb, 0xC1)
    cb = codebuf_emit_byte(cb, 0x0A); cb = codebuf_emit_byte(cb, 0x00); cb = codebuf_emit_byte(cb, 0x00); cb = codebuf_emit_byte(cb, 0x00)

    let int_div_top = codebuf_offset(cb) as int
    cb = codebuf_emit_byte(cb, 0x48); cb = codebuf_emit_byte(cb, 0x31); cb = codebuf_emit_byte(cb, 0xD2)
    cb = codebuf_emit_byte(cb, 0x48); cb = codebuf_emit_byte(cb, 0xF7); cb = codebuf_emit_byte(cb, 0xF1)
    cb = codebuf_emit_byte(cb, 0x80); cb = codebuf_emit_byte(cb, 0xC2); cb = codebuf_emit_byte(cb, 0x30)
    cb = codebuf_emit_byte(cb, 0x41); cb = codebuf_emit_byte(cb, 0x88); cb = codebuf_emit_byte(cb, 0x11)
    cb = codebuf_emit_byte(cb, 0x48); cb = codebuf_emit_byte(cb, 0x85); cb = codebuf_emit_byte(cb, 0xC0)
    cb = x86_emit_je_rel32(cb, 0)
    let fix_div_done = codebuf_offset(cb) as int
    cb = codebuf_emit_byte(cb, 0x49); cb = codebuf_emit_byte(cb, 0xFF); cb = codebuf_emit_byte(cb, 0xC9)
    cb = x86_emit_jmp_rel32(cb, 0)
    let fix_div_loop = codebuf_offset(cb) as int
    cb = patch_rel32(cb, fix_div_loop - 4, int_div_top)
    let div_done_lbl = codebuf_offset(cb) as int
    cb = patch_rel32(cb, fix_div_done - 4, div_done_lbl)

    # Copy digits from r9 up to rbp into [r8]
    cb = codebuf_emit_byte(cb, 0x49); cb = codebuf_emit_byte(cb, 0x89); cb = codebuf_emit_byte(cb, 0xEA)
    let copy_top = codebuf_offset(cb) as int
    cb = codebuf_emit_byte(cb, 0x41); cb = codebuf_emit_byte(cb, 0x8A); cb = codebuf_emit_byte(cb, 0x01)
    cb = codebuf_emit_byte(cb, 0x41); cb = codebuf_emit_byte(cb, 0x88); cb = codebuf_emit_byte(cb, 0x00)
    cb = codebuf_emit_byte(cb, 0x49); cb = codebuf_emit_byte(cb, 0xFF); cb = codebuf_emit_byte(cb, 0xC1)
    cb = codebuf_emit_byte(cb, 0x49); cb = codebuf_emit_byte(cb, 0xFF); cb = codebuf_emit_byte(cb, 0xC0)
    cb = codebuf_emit_byte(cb, 0x4D); cb = codebuf_emit_byte(cb, 0x39); cb = codebuf_emit_byte(cb, 0xD1)
    cb = x86_emit_jl_rel32(cb, 0)
    let fix_copy = codebuf_offset(cb) as int
    cb = patch_rel32(cb, fix_copy - 4, copy_top)

    let int_done_lbl = codebuf_offset(cb) as int
    cb = patch_rel32(cb, fix_int_done - 4, int_done_lbl)

    # Output decimal point '.' (0x2E)
    cb = codebuf_emit_byte(cb, 0x41); cb = codebuf_emit_byte(cb, 0xC6); cb = codebuf_emit_byte(cb, 0x00); cb = codebuf_emit_byte(cb, 0x2E)
    cb = codebuf_emit_byte(cb, 0x49); cb = codebuf_emit_byte(cb, 0xFF); cb = codebuf_emit_byte(cb, 0xC0)

    # Format fractional part in xmm0:
    cb = codebuf_emit_byte(cb, 0x48); cb = codebuf_emit_byte(cb, 0xC7); cb = codebuf_emit_byte(cb, 0xC1)
    cb = codebuf_emit_byte(cb, 0x0A); cb = codebuf_emit_byte(cb, 0x00); cb = codebuf_emit_byte(cb, 0x00); cb = codebuf_emit_byte(cb, 0x00)
    # cvtsi2sd xmm2, rcx
    cb = codebuf_emit_byte(cb, 0xF2); cb = codebuf_emit_byte(cb, 0x48); cb = codebuf_emit_byte(cb, 0x0F)
    cb = codebuf_emit_byte(cb, 0x2A); cb = codebuf_emit_byte(cb, 0xD1)
    # xorps xmm3, xmm3
    cb = codebuf_emit_byte(cb, 0x0F); cb = codebuf_emit_byte(cb, 0x57); cb = codebuf_emit_byte(cb, 0xDB)
    # xor rcx, rcx
    cb = codebuf_emit_byte(cb, 0x48); cb = codebuf_emit_byte(cb, 0x31); cb = codebuf_emit_byte(cb, 0xC9)

    let frac_top = codebuf_offset(cb) as int
    # mulsd xmm0, xmm2
    cb = codebuf_emit_byte(cb, 0xF2); cb = codebuf_emit_byte(cb, 0x0F); cb = codebuf_emit_byte(cb, 0x59); cb = codebuf_emit_byte(cb, 0xC2)
    # cvttsd2si rdx, xmm0
    cb = codebuf_emit_byte(cb, 0xF2); cb = codebuf_emit_byte(cb, 0x48); cb = codebuf_emit_byte(cb, 0x0F)
    cb = codebuf_emit_byte(cb, 0x2C); cb = codebuf_emit_byte(cb, 0xD0)
    # cvtsi2sd xmm1, rdx
    cb = codebuf_emit_byte(cb, 0xF2); cb = codebuf_emit_byte(cb, 0x48); cb = codebuf_emit_byte(cb, 0x0F)
    cb = codebuf_emit_byte(cb, 0x2A); cb = codebuf_emit_byte(cb, 0xCA)
    # subsd xmm0, xmm1
    cb = codebuf_emit_byte(cb, 0xF2); cb = codebuf_emit_byte(cb, 0x0F); cb = codebuf_emit_byte(cb, 0x5C); cb = codebuf_emit_byte(cb, 0xC1)
    # add dl, '0'
    cb = codebuf_emit_byte(cb, 0x80); cb = codebuf_emit_byte(cb, 0xC2); cb = codebuf_emit_byte(cb, 0x30)
    # mov [r8], dl
    cb = codebuf_emit_byte(cb, 0x41); cb = codebuf_emit_byte(cb, 0x88); cb = codebuf_emit_byte(cb, 0x10)
    # inc r8
    cb = codebuf_emit_byte(cb, 0x49); cb = codebuf_emit_byte(cb, 0xFF); cb = codebuf_emit_byte(cb, 0xC0)
    # inc rcx
    cb = codebuf_emit_byte(cb, 0x48); cb = codebuf_emit_byte(cb, 0xFF); cb = codebuf_emit_byte(cb, 0xC1)
    # ucomisd xmm0, xmm3
    cb = codebuf_emit_byte(cb, 0x66); cb = codebuf_emit_byte(cb, 0x0F); cb = codebuf_emit_byte(cb, 0x2E); cb = codebuf_emit_byte(cb, 0xC3)
    cb = x86_emit_je_rel32(cb, 0)
    let fix_frac_zero = codebuf_offset(cb) as int
    # cmp rcx, 9
    cb = codebuf_emit_byte(cb, 0x48); cb = codebuf_emit_byte(cb, 0x83); cb = codebuf_emit_byte(cb, 0xF9); cb = codebuf_emit_byte(cb, 0x09)
    cb = x86_emit_jl_rel32(cb, 0)
    let fix_frac_loop = codebuf_offset(cb) as int
    cb = patch_rel32(cb, fix_frac_loop - 4, frac_top)

    let frac_done_lbl = codebuf_offset(cb) as int
    cb = patch_rel32(cb, fix_frac_zero - 4, frac_done_lbl)

    # Output newline '\n' (0x0A)
    cb = codebuf_emit_byte(cb, 0x41); cb = codebuf_emit_byte(cb, 0xC6); cb = codebuf_emit_byte(cb, 0x00); cb = codebuf_emit_byte(cb, 0x0A)
    cb = codebuf_emit_byte(cb, 0x49); cb = codebuf_emit_byte(cb, 0xFF); cb = codebuf_emit_byte(cb, 0xC0)

    # Syscall write(1, buf, len)
    cb = codebuf_emit_byte(cb, 0x48); cb = codebuf_emit_byte(cb, 0x89); cb = codebuf_emit_byte(cb, 0xEE)
    cb = codebuf_emit_byte(cb, 0x48); cb = codebuf_emit_byte(cb, 0x81); cb = codebuf_emit_byte(cb, 0xEE)
    cb = codebuf_emit_byte(cb, 0x80); cb = codebuf_emit_byte(cb, 0x00); cb = codebuf_emit_byte(cb, 0x00); cb = codebuf_emit_byte(cb, 0x00)
    # mov rdx, r8 (end pointer); length = end - start
    cb = codebuf_emit_byte(cb, 0x4C); cb = codebuf_emit_byte(cb, 0x89); cb = codebuf_emit_byte(cb, 0xC2)
    cb = codebuf_emit_byte(cb, 0x48); cb = codebuf_emit_byte(cb, 0x29); cb = codebuf_emit_byte(cb, 0xF2)
    cb = codebuf_emit_byte(cb, 0x48); cb = codebuf_emit_byte(cb, 0xC7); cb = codebuf_emit_byte(cb, 0xC0)
    cb = codebuf_emit_byte(cb, 0x01); cb = codebuf_emit_byte(cb, 0x00); cb = codebuf_emit_byte(cb, 0x00); cb = codebuf_emit_byte(cb, 0x00)
    cb = codebuf_emit_byte(cb, 0x48); cb = codebuf_emit_byte(cb, 0xC7); cb = codebuf_emit_byte(cb, 0xC7)
    cb = codebuf_emit_byte(cb, 0x01); cb = codebuf_emit_byte(cb, 0x00); cb = codebuf_emit_byte(cb, 0x00); cb = codebuf_emit_byte(cb, 0x00)
    cb = codebuf_emit_byte(cb, 0x0F); cb = codebuf_emit_byte(cb, 0x05)

    # mov rsp, rbp; pop rbp; ret
    cb = codebuf_emit_byte(cb, 0x48); cb = codebuf_emit_byte(cb, 0x89); cb = codebuf_emit_byte(cb, 0xEC)
    cb = codebuf_emit_byte(cb, 0x5D)
    out codebuf_emit_byte(cb, 0xC3)
end.
