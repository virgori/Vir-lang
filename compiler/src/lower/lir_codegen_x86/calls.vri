    cb = codebuf_emit_byte(cb, 0x48); cb = codebuf_emit_byte(cb, 0xFF); cb = codebuf_emit_byte(cb, 0xCE)
    cb = codebuf_emit_byte(cb, 0xC6); cb = codebuf_emit_byte(cb, 0x06); cb = codebuf_emit_byte(cb, 0x2D)
    cb = codebuf_emit_byte(cb, 0x48); cb = codebuf_emit_byte(cb, 0x89); cb = codebuf_emit_byte(cb, 0xEA)
