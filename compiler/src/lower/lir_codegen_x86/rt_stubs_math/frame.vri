##
 * compiler/src/lower/lir_codegen_x86/rt_stubs_math/frame.vri — callee-save and callee-restore helpers
 * VIRC-PLN-0009: extracted verbatim from compiler/src/lower/lir_codegen_x86/rt_stubs_math.vri.
 ##

include types_prelude
include rt_vec_rt
include rt_string_rt
include codegen
include lir_codegen_x86_types
include lir_codegen_x86_intrinsics
include lir_codegen_x86_calls
include lir_codegen_x86_rt_stubs_base

func emit_callee_save_x86(cb: &CodeBuf):
    cb = x86_emit_push(cb, X86_RBX)
    cb = x86_emit_push(cb, X86_R13)
    out x86_emit_push(cb, X86_R14)
end.

func emit_callee_restore_x86(cb: &CodeBuf):
    cb = x86_emit_pop(cb, X86_R14)
    cb = x86_emit_pop(cb, X86_R13)
    out x86_emit_pop(cb, X86_RBX)
end.
