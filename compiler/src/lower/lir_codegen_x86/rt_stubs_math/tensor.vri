##
 * compiler/src/lower/lir_codegen_x86/rt_stubs_math/tensor.vri — tensor dot and matmul stubs
 * VIRC-PLN-0009: extracted verbatim from compiler/src/lower/lir_codegen_x86/rt_stubs_math.vri.
 ##

include types_prelude
include rt_vec_rt
include rt_string_rt
include codegen
include lir_codegen_x86_types
include lir_codegen_x86_intrinsics
include lir_codegen_x86_calls
include lir_codegen_x86_rt_stubs_base

func emit_lir_rt_tensor_dot_stub_x86(cb: &CodeBuf):
    cb = x86_emit_push(cb, X86_RBX)
    cb = x86_emit_push(cb, X86_RBP)
    cb = x86_emit_push(cb, X86_R12)
    cb = x86_emit_push(cb, X86_R13)
    cb = x86_emit_push(cb, X86_R14)
    cb = x86_emit_push(cb, X86_R9)
    cb = x86_emit_sub_rsp_imm(cb, 8)
    # 0. If autodiff is active (*(R15 + 8) == 1), record RDI (W) and RSI (X):
    cb = x86_emit_mov_reg_mem(cb, X86_RAX, X86_R15, 8)
    cb = x86_emit_cmp_reg_imm32(cb, X86_RAX, 1)
    cb = x86_emit_jne_rel32(cb, 0)
    let fixup_tape = codebuf_offset(cb) as int
    cb = x86_emit_mov_mem_reg(cb, X86_R15, 16, X86_RDI)
    cb = x86_emit_mov_mem_reg(cb, X86_R15, 24, X86_RSI)
    cb = x86_emit_mov_mem_reg(cb, X86_R15, 32, X86_RDX)
    cb = x86_emit_mov_mem_reg(cb, X86_R15, 40, X86_RCX)
    cb = x86_emit_mov_mem_reg(cb, X86_R15, 48, X86_R8)
    let tape_done_pos = codebuf_offset(cb) as int
    cb = patch_rel32(cb, fixup_tape - 4, tape_done_pos)

    # Preserve inputs and point at element payloads.
    cb = x86_emit_mov_rr(cb, X86_RBX, X86_RDI)
    cb = x86_emit_mov_reg_imm32(cb, X86_RAX, 16)
    cb = x86_emit_add_rr(cb, X86_RBX, X86_RAX)
    cb = x86_emit_mov_rr(cb, X86_R13, X86_RSI)
    cb = x86_emit_add_rr(cb, X86_R13, X86_RAX)
    cb = x86_emit_mov_rr(cb, X86_R12, X86_RDX) # M
    cb = x86_emit_mov_rr(cb, X86_R14, X86_RCX) # K

    # Allocate from [R15], placing the element payload (header + 16) on a
    # 64-byte cache-line boundary.
    cb = x86_emit_mov_reg_mem(cb, X86_RBP, X86_R15, 0)
    cb = x86_emit_mov_reg_imm32(cb, X86_RAX, 79)
    cb = x86_emit_add_rr(cb, X86_RBP, X86_RAX)
    cb = x86_emit_mov_reg_imm32(cb, X86_RAX, 0 - 64)
    cb = x86_emit_and_rr(cb, X86_RBP, X86_RAX)
    cb = x86_emit_mov_reg_imm32(cb, X86_RAX, 16)
    cb = x86_emit_sub_rr(cb, X86_RBP, X86_RAX)
    cb = x86_emit_mov_rr(cb, X86_RAX, X86_R12)
    cb = x86_emit_imul_rr(cb, X86_RAX, X86_R8)
    cb = x86_emit_mov_mem_reg(cb, X86_RBP, 0, X86_RAX)
    cb = x86_emit_mov_mem_reg(cb, X86_RBP, 8, X86_RAX)
    cb = x86_emit_mov_rr(cb, X86_RDI, X86_RAX)

    # Check is_32bit for allocation payload size
    cb = x86_emit_mov_reg_mem(cb, X86_RAX, X86_RSP, 8)
    cb = x86_emit_cmp_imm0(cb, X86_RAX)
    cb = x86_emit_jne_rel32(cb, 0)
    let fixup_alloc_32 = codebuf_offset(cb) as int
    # 64-bit: shl 3 (8 bytes per elem)
    cb = x86_emit_mov_reg_imm32(cb, X86_RCX, 3)
    cb = x86_emit_shl_cl(cb, X86_RDI)
    cb = x86_emit_jmp_rel32(cb, 0)
    let fixup_alloc_done = codebuf_offset(cb) as int
    let alloc_32_pos = codebuf_offset(cb) as int
    cb = patch_rel32(cb, fixup_alloc_32 - 4, alloc_32_pos)
    # 32-bit: shl 2 (4 bytes per elem)
    cb = x86_emit_mov_reg_imm32(cb, X86_RCX, 2)
    cb = x86_emit_shl_cl(cb, X86_RDI)
    let alloc_done_pos = codebuf_offset(cb) as int
    cb = patch_rel32(cb, fixup_alloc_done - 4, alloc_done_pos)

    cb = x86_emit_mov_reg_imm32(cb, X86_RAX, 31)
    cb = x86_emit_add_rr(cb, X86_RDI, X86_RAX)
    cb = x86_emit_mov_reg_imm32(cb, X86_RAX, 0 - 16)
    cb = x86_emit_and_rr(cb, X86_RDI, X86_RAX)
    cb = x86_emit_add_rr(cb, X86_RDI, X86_RBP)
    cb = x86_emit_mov_mem_reg(cb, X86_R15, 0, X86_RDI)

    # If autodiff is active, record C and increment tape_count:
    cb = x86_emit_mov_reg_mem(cb, X86_RAX, X86_R15, 8)
    cb = x86_emit_cmp_reg_imm32(cb, X86_RAX, 1)
    cb = x86_emit_jne_rel32(cb, 0)
    let fixup_tape_c = codebuf_offset(cb) as int
    cb = x86_emit_mov_mem_reg(cb, X86_R15, 56, X86_RBP) # C
    cb = x86_emit_mov_reg_mem(cb, X86_RAX, X86_R15, 64) # tape_count
    cb = x86_emit_mov_reg_imm32(cb, X86_RCX, 1)
    cb = x86_emit_add_rr(cb, X86_RAX, X86_RCX)
    cb = x86_emit_mov_mem_reg(cb, X86_R15, 64, X86_RAX)
    let tape_c_done_pos = codebuf_offset(cb) as int
    cb = patch_rel32(cb, fixup_tape_c - 4, tape_c_done_pos)

    # Check is_32bit before loops
    cb = x86_emit_mov_reg_mem(cb, X86_RAX, X86_RSP, 8)
    cb = x86_emit_cmp_imm0(cb, X86_RAX)
    cb = x86_emit_jne_rel32(cb, 0)
    let fixup_i32_loop = codebuf_offset(cb) as int

    # ═══════════════════════════════════════════════════════════
    # 64-bit Int Loop
    # ═══════════════════════════════════════════════════════════
    # for i in [0,M), j in [0,N), k in [0,K)
    cb = x86_emit_xor_rr(cb, X86_RDI, X86_RDI) # i
    outer_check = codebuf_offset(cb) as int
    cb = x86_emit_cmp_rr(cb, X86_RDI, X86_R12)
    outer_done_at = codebuf_offset(cb) as int
    cb = x86_emit_jge_rel32(cb, 0)

    cb = x86_emit_xor_rr(cb, X86_RSI, X86_RSI) # j
    middle_check = codebuf_offset(cb) as int
    cb = x86_emit_cmp_rr(cb, X86_RSI, X86_R8)
    middle_done_at = codebuf_offset(cb) as int
    cb = x86_emit_jge_rel32(cb, 0)

    cb = x86_emit_xor_rr(cb, X86_R9, X86_R9)   # accumulator
    cb = x86_emit_xor_rr(cb, X86_RDX, X86_RDX) # k
    inner_check = codebuf_offset(cb) as int
    cb = x86_emit_cmp_rr(cb, X86_RDX, X86_R14)
    inner_done_at = codebuf_offset(cb) as int
    cb = x86_emit_jge_rel32(cb, 0)

    # A[i*K+k]
    cb = x86_emit_mov_rr(cb, X86_R10, X86_RDI)
    cb = x86_emit_imul_rr(cb, X86_R10, X86_R14)
    cb = x86_emit_add_rr(cb, X86_R10, X86_RDX)
    cb = x86_emit_mov_reg_imm32(cb, X86_RCX, 3)
    cb = x86_emit_shl_cl(cb, X86_R10)
    cb = x86_emit_add_rr(cb, X86_R10, X86_RBX)
    cb = x86_emit_mov_reg_mem(cb, X86_R10, X86_R10, 0)
    # B[k*N+j]
    cb = x86_emit_mov_rr(cb, X86_R11, X86_RDX)
    cb = x86_emit_imul_rr(cb, X86_R11, X86_R8)
    cb = x86_emit_add_rr(cb, X86_R11, X86_RSI)
    cb = x86_emit_shl_cl(cb, X86_R11)
    cb = x86_emit_add_rr(cb, X86_R11, X86_R13)
    cb = x86_emit_mov_reg_mem(cb, X86_R11, X86_R11, 0)
    cb = x86_emit_imul_rr(cb, X86_R10, X86_R11)
    cb = x86_emit_add_rr(cb, X86_R9, X86_R10)
    cb = x86_emit_mov_reg_imm32(cb, X86_RAX, 1)
    cb = x86_emit_add_rr(cb, X86_RDX, X86_RAX)
    inner_back_at = codebuf_offset(cb) as int
    cb = x86_emit_jmp_rel32(cb, 0)

    inner_done = codebuf_offset(cb) as int
    cb = patch_rel32(cb, inner_done_at + 2, inner_done)
    cb = patch_rel32(cb, inner_back_at + 1, inner_check)
    # C[i*N+j] = accumulator
    cb = x86_emit_mov_rr(cb, X86_R10, X86_RDI)
    cb = x86_emit_imul_rr(cb, X86_R10, X86_R8)
    cb = x86_emit_add_rr(cb, X86_R10, X86_RSI)
    cb = x86_emit_mov_reg_imm32(cb, X86_RCX, 3)
    cb = x86_emit_shl_cl(cb, X86_R10)
    cb = x86_emit_add_rr(cb, X86_R10, X86_RBP)
    cb = x86_emit_mov_mem_reg(cb, X86_R10, 16, X86_R9)
    cb = x86_emit_mov_reg_imm32(cb, X86_RAX, 1)
    cb = x86_emit_add_rr(cb, X86_RSI, X86_RAX)
    middle_back_at = codebuf_offset(cb) as int
    cb = x86_emit_jmp_rel32(cb, 0)

    middle_done = codebuf_offset(cb) as int
    cb = patch_rel32(cb, middle_done_at + 2, middle_done)
    cb = patch_rel32(cb, middle_back_at + 1, middle_check)
    cb = x86_emit_mov_reg_imm32(cb, X86_RAX, 1)
    cb = x86_emit_add_rr(cb, X86_RDI, X86_RAX)
    outer_back_at = codebuf_offset(cb) as int
    cb = x86_emit_jmp_rel32(cb, 0)

    outer_done = codebuf_offset(cb) as int
    cb = patch_rel32(cb, outer_done_at + 2, outer_done)
    cb = patch_rel32(cb, outer_back_at + 1, outer_check)

    cb = x86_emit_jmp_rel32(cb, 0)
    let fixup_dot_done = codebuf_offset(cb) as int

    # ═══════════════════════════════════════════════════════════
    # 32-bit Int Loop
    # ═══════════════════════════════════════════════════════════
    let i32_loop_pos = codebuf_offset(cb) as int
    cb = patch_rel32(cb, fixup_i32_loop - 4, i32_loop_pos)

    cb = x86_emit_xor_rr(cb, X86_RDI, X86_RDI) # i
    let outer_check_32 = codebuf_offset(cb) as int
    cb = x86_emit_cmp_rr(cb, X86_RDI, X86_R12)
    let outer_done_at_32 = codebuf_offset(cb) as int
    cb = x86_emit_jge_rel32(cb, 0)

    cb = x86_emit_xor_rr(cb, X86_RSI, X86_RSI) # j
    let middle_check_32 = codebuf_offset(cb) as int
    cb = x86_emit_cmp_rr(cb, X86_RSI, X86_R8)
    let middle_done_at_32 = codebuf_offset(cb) as int
    cb = x86_emit_jge_rel32(cb, 0)

    cb = x86_emit_xor_rr(cb, X86_R9, X86_R9)   # accumulator
    cb = x86_emit_xor_rr(cb, X86_RDX, X86_RDX) # k
    let inner_check_32 = codebuf_offset(cb) as int
    cb = x86_emit_cmp_rr(cb, X86_RDX, X86_R14)
    let inner_done_at_32 = codebuf_offset(cb) as int
    cb = x86_emit_jge_rel32(cb, 0)

    # A[i*K+k]
    cb = x86_emit_mov_rr(cb, X86_R10, X86_RDI)
    cb = x86_emit_imul_rr(cb, X86_R10, X86_R14)
    cb = x86_emit_add_rr(cb, X86_R10, X86_RDX)
    cb = x86_emit_mov_reg_imm32(cb, X86_RCX, 2)
    cb = x86_emit_shl_cl(cb, X86_R10)
    cb = x86_emit_add_rr(cb, X86_R10, X86_RBX)
    cb = x86_emit_movslq_reg_mem(cb, X86_R10, X86_R10, 0)

    # B[k*N+j]
    cb = x86_emit_mov_rr(cb, X86_R11, X86_RDX)
    cb = x86_emit_imul_rr(cb, X86_R11, X86_R8)
    cb = x86_emit_add_rr(cb, X86_R11, X86_RSI)
    cb = x86_emit_shl_cl(cb, X86_R11)
    cb = x86_emit_add_rr(cb, X86_R11, X86_R13)
    cb = x86_emit_movslq_reg_mem(cb, X86_R11, X86_R11, 0)

    cb = x86_emit_imul_rr(cb, X86_R10, X86_R11)
    cb = x86_emit_add_rr(cb, X86_R9, X86_R10)
    cb = x86_emit_mov_reg_imm32(cb, X86_RAX, 1)
    cb = x86_emit_add_rr(cb, X86_RDX, X86_RAX)
    let inner_back_at_32 = codebuf_offset(cb) as int
    cb = x86_emit_jmp_rel32(cb, 0)

    let inner_done_32 = codebuf_offset(cb) as int
    cb = patch_rel32(cb, inner_done_at_32 + 2, inner_done_32)
    cb = patch_rel32(cb, inner_back_at_32 + 1, inner_check_32)

    # C[i*N+j] = accumulator (32-bit store)
    cb = x86_emit_mov_rr(cb, X86_R10, X86_RDI)
    cb = x86_emit_imul_rr(cb, X86_R10, X86_R8)
    cb = x86_emit_add_rr(cb, X86_R10, X86_RSI)
    cb = x86_emit_mov_reg_imm32(cb, X86_RCX, 2)
    cb = x86_emit_shl_cl(cb, X86_R10)
    cb = x86_emit_add_rr(cb, X86_R10, X86_RBP)
    cb = x86_emit_mov_mem_reg32(cb, X86_R10, 16, X86_R9)

    cb = x86_emit_mov_reg_imm32(cb, X86_RAX, 1)
    cb = x86_emit_add_rr(cb, X86_RSI, X86_RAX)
    let middle_back_at_32 = codebuf_offset(cb) as int
    cb = x86_emit_jmp_rel32(cb, 0)

    let middle_done_32 = codebuf_offset(cb) as int
    cb = patch_rel32(cb, middle_done_at_32 + 2, middle_done_32)
    cb = patch_rel32(cb, middle_back_at_32 + 1, middle_check_32)

    cb = x86_emit_mov_reg_imm32(cb, X86_RAX, 1)
    cb = x86_emit_add_rr(cb, X86_RDI, X86_RAX)
    let outer_back_at_32 = codebuf_offset(cb) as int
    cb = x86_emit_jmp_rel32(cb, 0)

    let outer_done_32 = codebuf_offset(cb) as int
    cb = patch_rel32(cb, outer_done_at_32 + 2, outer_done_32)
    cb = patch_rel32(cb, outer_back_at_32 + 1, outer_check_32)

    let dot_done_pos = codebuf_offset(cb) as int
    cb = patch_rel32(cb, fixup_dot_done - 4, dot_done_pos)

    cb = x86_emit_mov_rr(cb, X86_RAX, X86_RBP)
    cb = x86_emit_add_rsp_imm(cb, 8)
    cb = x86_emit_pop(cb, X86_R9)
    cb = x86_emit_pop(cb, X86_R14)
    cb = x86_emit_pop(cb, X86_R13)
    cb = x86_emit_pop(cb, X86_R12)
    cb = x86_emit_pop(cb, X86_RBP)
    cb = x86_emit_pop(cb, X86_RBX)
    out x86_emit_ret(cb)
end.

func emit_lir_rt_matmul_f64_stub_x86(cb: &CodeBuf):
    cb = x86_emit_push(cb, X86_RBX)
    cb = x86_emit_push(cb, X86_RBP)
    cb = x86_emit_push(cb, X86_R12)
    cb = x86_emit_push(cb, X86_R13)
    cb = x86_emit_push(cb, X86_R14)
    cb = x86_emit_push(cb, X86_R9)
    cb = x86_emit_sub_rsp_imm(cb, 8)
    # 0. If autodiff is active (*(R15 + 8) == 1), record RDI (W), RSI (X), RDX (M), RCX (K), R8 (N):
    cb = x86_emit_mov_reg_mem(cb, X86_RAX, X86_R15, 8)
    cb = x86_emit_cmp_reg_imm32(cb, X86_RAX, 1)
    cb = x86_emit_jne_rel32(cb, 0)
    let fixup_tape = codebuf_offset(cb) as int
    cb = x86_emit_mov_mem_reg(cb, X86_R15, 16, X86_RDI)
    cb = x86_emit_mov_mem_reg(cb, X86_R15, 24, X86_RSI)
    cb = x86_emit_mov_mem_reg(cb, X86_R15, 32, X86_RDX)
    cb = x86_emit_mov_mem_reg(cb, X86_R15, 40, X86_RCX)
    cb = x86_emit_mov_mem_reg(cb, X86_R15, 48, X86_R8)
    let tape_done_pos = codebuf_offset(cb) as int
    cb = patch_rel32(cb, fixup_tape - 4, tape_done_pos)

    # Preserve inputs and point at element payloads.
    cb = x86_emit_mov_rr(cb, X86_RBX, X86_RDI)
    cb = x86_emit_mov_reg_imm32(cb, X86_RAX, 16)
    cb = x86_emit_add_rr(cb, X86_RBX, X86_RAX)
    cb = x86_emit_mov_rr(cb, X86_R13, X86_RSI)
    cb = x86_emit_add_rr(cb, X86_R13, X86_RAX)
    cb = x86_emit_mov_rr(cb, X86_R12, X86_RDX) # M
    cb = x86_emit_mov_rr(cb, X86_R14, X86_RCX) # K

    # Allocate from [R15], placing payload on 64-byte boundary
    cb = x86_emit_mov_reg_mem(cb, X86_RBP, X86_R15, 0)
    cb = x86_emit_mov_reg_imm32(cb, X86_RAX, 79)
    cb = x86_emit_add_rr(cb, X86_RBP, X86_RAX)
    cb = x86_emit_mov_reg_imm32(cb, X86_RAX, 0 - 64)
    cb = x86_emit_and_rr(cb, X86_RBP, X86_RAX)
    cb = x86_emit_mov_reg_imm32(cb, X86_RAX, 16)
    cb = x86_emit_sub_rr(cb, X86_RBP, X86_RAX)
    cb = x86_emit_mov_rr(cb, X86_RAX, X86_R12)
    cb = x86_emit_imul_rr(cb, X86_RAX, X86_R8)
    cb = x86_emit_mov_mem_reg(cb, X86_RBP, 0, X86_RAX)
    cb = x86_emit_mov_mem_reg(cb, X86_RBP, 8, X86_RAX)
    cb = x86_emit_mov_rr(cb, X86_RDI, X86_RAX)

    # Branch on the width code (0 = 8-byte, 1 = 4-byte, 2 = 2-byte) for allocation payload size
    cb = x86_emit_mov_reg_mem(cb, X86_RAX, X86_RSP, 8)
    cb = x86_emit_cmp_imm0(cb, X86_RAX)
    cb = x86_emit_jne_rel32(cb, 0)
    let fixup_alloc_not64 = codebuf_offset(cb) as int
    # 64-bit: shl 3 (8 bytes per elem)
    cb = x86_emit_mov_reg_imm32(cb, X86_RCX, 3)
    cb = x86_emit_shl_cl(cb, X86_RDI)
    cb = x86_emit_jmp_rel32(cb, 0)
    let fixup_alloc_done_a = codebuf_offset(cb) as int
    let alloc_not64_pos = codebuf_offset(cb) as int
    cb = patch_rel32(cb, fixup_alloc_not64 - 4, alloc_not64_pos)
    cb = x86_emit_cmp_reg_imm32(cb, X86_RAX, 2)
    cb = x86_emit_je_rel32(cb, 0)
    let fixup_alloc_16 = codebuf_offset(cb) as int
    # 32-bit: shl 2 (4 bytes per elem)
    cb = x86_emit_mov_reg_imm32(cb, X86_RCX, 2)
    cb = x86_emit_shl_cl(cb, X86_RDI)
    cb = x86_emit_jmp_rel32(cb, 0)
    let fixup_alloc_done_b = codebuf_offset(cb) as int
    let alloc_16_pos = codebuf_offset(cb) as int
    cb = patch_rel32(cb, fixup_alloc_16 - 4, alloc_16_pos)
    # 16-bit: shl 1 (2 bytes per elem)
    cb = x86_emit_mov_reg_imm32(cb, X86_RCX, 1)
    cb = x86_emit_shl_cl(cb, X86_RDI)
    let alloc_done_pos = codebuf_offset(cb) as int
    cb = patch_rel32(cb, fixup_alloc_done_a - 4, alloc_done_pos)
    cb = patch_rel32(cb, fixup_alloc_done_b - 4, alloc_done_pos)

    cb = x86_emit_mov_reg_imm32(cb, X86_RAX, 31)
    cb = x86_emit_add_rr(cb, X86_RDI, X86_RAX)
    cb = x86_emit_mov_reg_imm32(cb, X86_RAX, 0 - 16)
    cb = x86_emit_and_rr(cb, X86_RDI, X86_RAX)
    cb = x86_emit_add_rr(cb, X86_RDI, X86_RBP)
    cb = x86_emit_mov_mem_reg(cb, X86_R15, 0, X86_RDI)

    # If autodiff is active, record C, tape_count, and is_float=1:
    cb = x86_emit_mov_reg_mem(cb, X86_RAX, X86_R15, 8)
    cb = x86_emit_cmp_reg_imm32(cb, X86_RAX, 1)
    cb = x86_emit_jne_rel32(cb, 0)
    let fixup_tape_c = codebuf_offset(cb) as int
    cb = x86_emit_mov_mem_reg(cb, X86_R15, 56, X86_RBP) # C
    cb = x86_emit_mov_reg_mem(cb, X86_RAX, X86_R15, 64) # tape_count
    cb = x86_emit_mov_reg_imm32(cb, X86_RCX, 1)
    cb = x86_emit_add_rr(cb, X86_RAX, X86_RCX)
    cb = x86_emit_mov_mem_reg(cb, X86_R15, 64, X86_RAX)
    cb = x86_emit_mov_reg_imm32(cb, X86_RAX, 1)
    cb = x86_emit_mov_mem_reg(cb, X86_R15, 72, X86_RAX) # is_float = 1
    let tape_c_done_pos = codebuf_offset(cb) as int
    cb = patch_rel32(cb, fixup_tape_c - 4, tape_c_done_pos)

    # Select the kernel from the width code (0 = f64, 1 = f32, 2 = f16)
    cb = x86_emit_mov_reg_mem(cb, X86_RAX, X86_RSP, 8)
    cb = x86_emit_cmp_reg_imm32(cb, X86_RAX, 2)
    cb = x86_emit_je_rel32(cb, 0)
    let fixup_f16_loop = codebuf_offset(cb) as int
    cb = x86_emit_cmp_imm0(cb, X86_RAX)
    cb = x86_emit_jne_rel32(cb, 0)
    let fixup_f32_loop = codebuf_offset(cb) as int

    # ═══════════════════════════════════════════════════════════
    # 64-bit Double Precision Loop
    # ═══════════════════════════════════════════════════════════
    # for i in [0,M), j in [0,N), k in [0,K)
    cb = x86_emit_xor_rr(cb, X86_RDI, X86_RDI) # i
    let outer_check = codebuf_offset(cb) as int
    cb = x86_emit_cmp_rr(cb, X86_RDI, X86_R12)
    let outer_done_at = codebuf_offset(cb) as int
    cb = x86_emit_jge_rel32(cb, 0)

    cb = x86_emit_xor_rr(cb, X86_RSI, X86_RSI) # j
    let middle_check = codebuf_offset(cb) as int
    cb = x86_emit_cmp_rr(cb, X86_RSI, X86_R8)
    let middle_done_at = codebuf_offset(cb) as int
    cb = x86_emit_jge_rel32(cb, 0)

    # accumulator: XMM2 = 0.0
    cb = x86_emit_xor_rr(cb, X86_RAX, X86_RAX)
    cb = x86_emit_movq_xmm_gpr(cb, 2, X86_RAX)
    cb = x86_emit_xor_rr(cb, X86_RDX, X86_RDX) # k
    let inner_check = codebuf_offset(cb) as int
    cb = x86_emit_cmp_rr(cb, X86_RDX, X86_R14)
    let inner_done_at = codebuf_offset(cb) as int
    cb = x86_emit_jge_rel32(cb, 0)

    # A[i*K+k]
    cb = x86_emit_mov_rr(cb, X86_R10, X86_RDI)
    cb = x86_emit_imul_rr(cb, X86_R10, X86_R14)
    cb = x86_emit_add_rr(cb, X86_R10, X86_RDX)
    cb = x86_emit_mov_reg_imm32(cb, X86_RCX, 3)
    cb = x86_emit_shl_cl(cb, X86_R10)
    cb = x86_emit_add_rr(cb, X86_R10, X86_RBX)
    cb = x86_emit_mov_reg_mem(cb, X86_R10, X86_R10, 0)
    cb = x86_emit_movq_xmm_gpr(cb, 0, X86_R10) # XMM0 = A[i*K+k]

    # B[k*N+j]
    cb = x86_emit_mov_rr(cb, X86_R11, X86_RDX)
    cb = x86_emit_imul_rr(cb, X86_R11, X86_R8)
    cb = x86_emit_add_rr(cb, X86_R11, X86_RSI)
    cb = x86_emit_shl_cl(cb, X86_R11)
    cb = x86_emit_add_rr(cb, X86_R11, X86_R13)
    cb = x86_emit_mov_reg_mem(cb, X86_R11, X86_R11, 0)
    cb = x86_emit_movq_xmm_gpr(cb, 1, X86_R11) # XMM1 = B[k*N+j]

    # XMM0 = XMM0 * XMM1 (mulsd)
    cb = x86_emit_mulsd_xx(cb, 0, 1)
    # XMM2 += XMM0 (addsd)
    cb = x86_emit_addsd_xx(cb, 2, 0)

    cb = x86_emit_mov_reg_imm32(cb, X86_RAX, 1)
    cb = x86_emit_add_rr(cb, X86_RDX, X86_RAX)
    let inner_back_at = codebuf_offset(cb) as int
    cb = x86_emit_jmp_rel32(cb, 0)

    let inner_done = codebuf_offset(cb) as int
    cb = patch_rel32(cb, inner_done_at + 2, inner_done)
    cb = patch_rel32(cb, inner_back_at + 1, inner_check)

    # C[i*N+j] = accumulator (XMM2)
    cb = x86_emit_mov_rr(cb, X86_R10, X86_RDI)
    cb = x86_emit_imul_rr(cb, X86_R10, X86_R8)
    cb = x86_emit_add_rr(cb, X86_R10, X86_RSI)
    cb = x86_emit_mov_reg_imm32(cb, X86_RCX, 3)
    cb = x86_emit_shl_cl(cb, X86_R10)
    cb = x86_emit_add_rr(cb, X86_R10, X86_RBP)
    cb = x86_emit_movq_gpr_xmm(cb, X86_R9, 2)
    cb = x86_emit_mov_mem_reg(cb, X86_R10, 16, X86_R9)

    cb = x86_emit_mov_reg_imm32(cb, X86_RAX, 1)
    cb = x86_emit_add_rr(cb, X86_RSI, X86_RAX)
    let middle_back_at = codebuf_offset(cb) as int
    cb = x86_emit_jmp_rel32(cb, 0)

    let middle_done = codebuf_offset(cb) as int
    cb = patch_rel32(cb, middle_done_at + 2, middle_done)
    cb = patch_rel32(cb, middle_back_at + 1, middle_check)
    cb = x86_emit_mov_reg_imm32(cb, X86_RAX, 1)
    cb = x86_emit_add_rr(cb, X86_RDI, X86_RAX)
    let outer_back_at = codebuf_offset(cb) as int
    cb = x86_emit_jmp_rel32(cb, 0)

    let outer_done = codebuf_offset(cb) as int
    cb = patch_rel32(cb, outer_done_at + 2, outer_done)
    cb = patch_rel32(cb, outer_back_at + 1, outer_check)

    cb = x86_emit_jmp_rel32(cb, 0)
    let fixup_matmul_done = codebuf_offset(cb) as int

    # ═══════════════════════════════════════════════════════════
    # 32-bit Single Precision Loop
    # ═══════════════════════════════════════════════════════════
    let f32_loop_pos = codebuf_offset(cb) as int
    cb = patch_rel32(cb, fixup_f32_loop - 4, f32_loop_pos)

    cb = x86_emit_xor_rr(cb, X86_RDI, X86_RDI) # i
    let outer_check_32 = codebuf_offset(cb) as int
    cb = x86_emit_cmp_rr(cb, X86_RDI, X86_R12)
    let outer_done_at_32 = codebuf_offset(cb) as int
    cb = x86_emit_jge_rel32(cb, 0)

    cb = x86_emit_xor_rr(cb, X86_RSI, X86_RSI) # j
    let middle_check_32 = codebuf_offset(cb) as int
    cb = x86_emit_cmp_rr(cb, X86_RSI, X86_R8)
    let middle_done_at_32 = codebuf_offset(cb) as int
    cb = x86_emit_jge_rel32(cb, 0)

    # accumulator: XMM2 = 0.0
    cb = x86_emit_xor_rr(cb, X86_RAX, X86_RAX)
    cb = x86_emit_movd_xmm_gpr(cb, 2, X86_RAX)
    cb = x86_emit_xor_rr(cb, X86_RDX, X86_RDX) # k
    let inner_check_32 = codebuf_offset(cb) as int
    cb = x86_emit_cmp_rr(cb, X86_RDX, X86_R14)
    let inner_done_at_32 = codebuf_offset(cb) as int
    cb = x86_emit_jge_rel32(cb, 0)

    # A[i*K+k]
    cb = x86_emit_mov_rr(cb, X86_R10, X86_RDI)
    cb = x86_emit_imul_rr(cb, X86_R10, X86_R14)
    cb = x86_emit_add_rr(cb, X86_R10, X86_RDX)
    cb = x86_emit_mov_reg_imm32(cb, X86_RCX, 2)
    cb = x86_emit_shl_cl(cb, X86_R10)
    cb = x86_emit_add_rr(cb, X86_R10, X86_RBX)
    cb = x86_emit_mov_reg_mem32(cb, X86_R10, X86_R10, 0)
    cb = x86_emit_movd_xmm_gpr(cb, 0, X86_R10) # XMM0 = A[i*K+k]

    # B[k*N+j]
    cb = x86_emit_mov_rr(cb, X86_R11, X86_RDX)
    cb = x86_emit_imul_rr(cb, X86_R11, X86_R8)
    cb = x86_emit_add_rr(cb, X86_R11, X86_RSI)
    cb = x86_emit_mov_reg_imm32(cb, X86_RCX, 2)
    cb = x86_emit_shl_cl(cb, X86_R11)
    cb = x86_emit_add_rr(cb, X86_R11, X86_R13)
    cb = x86_emit_mov_reg_mem32(cb, X86_R11, X86_R11, 0)
    cb = x86_emit_movd_xmm_gpr(cb, 1, X86_R11) # XMM1 = B[k*N+j]

    # XMM0 = XMM0 * XMM1 (mulss)
    cb = x86_emit_mulss_xx(cb, 0, 1)
    # XMM2 += XMM0 (addss)
    cb = x86_emit_addss_xx(cb, 2, 0)

    cb = x86_emit_mov_reg_imm32(cb, X86_RAX, 1)
    cb = x86_emit_add_rr(cb, X86_RDX, X86_RAX)
    let inner_back_at_32 = codebuf_offset(cb) as int
    cb = x86_emit_jmp_rel32(cb, 0)

    let inner_done_32 = codebuf_offset(cb) as int
    cb = patch_rel32(cb, inner_done_at_32 + 2, inner_done_32)
    cb = patch_rel32(cb, inner_back_at_32 + 1, inner_check_32)

    # C[i*N+j] = accumulator (XMM2)
    cb = x86_emit_mov_rr(cb, X86_R10, X86_RDI)
    cb = x86_emit_imul_rr(cb, X86_R10, X86_R8)
    cb = x86_emit_add_rr(cb, X86_R10, X86_RSI)
    cb = x86_emit_mov_reg_imm32(cb, X86_RCX, 2)
    cb = x86_emit_shl_cl(cb, X86_R10)
    cb = x86_emit_add_rr(cb, X86_R10, X86_RBP)
    cb = x86_emit_movd_gpr_xmm(cb, X86_R9, 2)
    cb = x86_emit_mov_mem_reg32(cb, X86_R10, 16, X86_R9)

    cb = x86_emit_mov_reg_imm32(cb, X86_RAX, 1)
    cb = x86_emit_add_rr(cb, X86_RSI, X86_RAX)
    let middle_back_at_32 = codebuf_offset(cb) as int
    cb = x86_emit_jmp_rel32(cb, 0)

    let middle_done_32 = codebuf_offset(cb) as int
    cb = patch_rel32(cb, middle_done_at_32 + 2, middle_done_32)
    cb = patch_rel32(cb, middle_back_at_32 + 1, middle_check_32)
    cb = x86_emit_mov_reg_imm32(cb, X86_RAX, 1)
    cb = x86_emit_add_rr(cb, X86_RDI, X86_RAX)
    let outer_back_at_32 = codebuf_offset(cb) as int
    cb = x86_emit_jmp_rel32(cb, 0)

    let outer_done_32 = codebuf_offset(cb) as int
    cb = patch_rel32(cb, outer_done_at_32 + 2, outer_done_32)
    cb = patch_rel32(cb, outer_back_at_32 + 1, outer_check_32)

    cb = x86_emit_jmp_rel32(cb, 0)
    let fixup_f32_done = codebuf_offset(cb) as int

    # ═══════════════════════════════════════════════════════════
    # 16-bit Half Precision Loop (f32 accumulation, IEEE binary16 storage)
    # ═══════════════════════════════════════════════════════════
    let f16_loop_pos = codebuf_offset(cb) as int
    cb = patch_rel32(cb, fixup_f16_loop - 4, f16_loop_pos)

    cb = x86_emit_xor_rr(cb, X86_RDI, X86_RDI) # i
    let outer_check_16 = codebuf_offset(cb) as int
    cb = x86_emit_cmp_rr(cb, X86_RDI, X86_R12)
    let outer_done_at_16 = codebuf_offset(cb) as int
    cb = x86_emit_jge_rel32(cb, 0)

    cb = x86_emit_xor_rr(cb, X86_RSI, X86_RSI) # j
    let middle_check_16 = codebuf_offset(cb) as int
    cb = x86_emit_cmp_rr(cb, X86_RSI, X86_R8)
    let middle_done_at_16 = codebuf_offset(cb) as int
    cb = x86_emit_jge_rel32(cb, 0)

    # accumulator: XMM2 = 0.0f
    cb = x86_emit_xor_rr(cb, X86_RAX, X86_RAX)
    cb = x86_emit_movd_xmm_gpr(cb, 2, X86_RAX)
    cb = x86_emit_xor_rr(cb, X86_RDX, X86_RDX) # k
    let inner_check_16 = codebuf_offset(cb) as int
    cb = x86_emit_cmp_rr(cb, X86_RDX, X86_R14)
    let inner_done_at_16 = codebuf_offset(cb) as int
    cb = x86_emit_jge_rel32(cb, 0)

    # A[i*K+k] (2-byte stride) -> XMM0 as f32
    cb = x86_emit_mov_rr(cb, X86_R10, X86_RDI)
    cb = x86_emit_imul_rr(cb, X86_R10, X86_R14)
    cb = x86_emit_add_rr(cb, X86_R10, X86_RDX)
    cb = x86_emit_mov_reg_imm32(cb, X86_RCX, 1)
    cb = x86_emit_shl_cl(cb, X86_R10)
    cb = x86_emit_add_rr(cb, X86_R10, X86_RBX)
    cb = x86_emit_xor_rr(cb, X86_RAX, X86_RAX)
    cb = x86_emit_mov_reg_mem16(cb, X86_RAX, X86_R10, 0)
    cb = x86_emit_f16_to_f32(cb, X86_RAX, 0, X86_R9, X86_RCX, 3)

    # B[k*N+j] (2-byte stride) -> XMM1 as f32
    cb = x86_emit_mov_rr(cb, X86_R11, X86_RDX)
    cb = x86_emit_imul_rr(cb, X86_R11, X86_R8)
    cb = x86_emit_add_rr(cb, X86_R11, X86_RSI)
    cb = x86_emit_mov_reg_imm32(cb, X86_RCX, 1)
    cb = x86_emit_shl_cl(cb, X86_R11)
    cb = x86_emit_add_rr(cb, X86_R11, X86_R13)
    cb = x86_emit_xor_rr(cb, X86_RAX, X86_RAX)
    cb = x86_emit_mov_reg_mem16(cb, X86_RAX, X86_R11, 0)
    cb = x86_emit_f16_to_f32(cb, X86_RAX, 1, X86_R9, X86_RCX, 3)

    cb = x86_emit_mulss_xx(cb, 0, 1)
    cb = x86_emit_addss_xx(cb, 2, 0)

    cb = x86_emit_mov_reg_imm32(cb, X86_RAX, 1)
    cb = x86_emit_add_rr(cb, X86_RDX, X86_RAX)
    let inner_back_at_16 = codebuf_offset(cb) as int
    cb = x86_emit_jmp_rel32(cb, 0)

    let inner_done_16 = codebuf_offset(cb) as int
    cb = patch_rel32(cb, inner_done_at_16 + 2, inner_done_16)
    cb = patch_rel32(cb, inner_back_at_16 + 1, inner_check_16)

    # C[i*N+j] = round_to_half(accumulator)
    cb = x86_emit_mov_rr(cb, X86_R10, X86_RDI)
    cb = x86_emit_imul_rr(cb, X86_R10, X86_R8)
    cb = x86_emit_add_rr(cb, X86_R10, X86_RSI)
    cb = x86_emit_mov_reg_imm32(cb, X86_RCX, 1)
    cb = x86_emit_shl_cl(cb, X86_R10)
    cb = x86_emit_add_rr(cb, X86_R10, X86_RBP)
    cb = x86_emit_float_to_f16(cb, 0, 2, X86_RAX, X86_R9, X86_RCX, 3)
    cb = x86_emit_mov_mem_reg16(cb, X86_R10, 16, X86_RAX)

    cb = x86_emit_mov_reg_imm32(cb, X86_RAX, 1)
    cb = x86_emit_add_rr(cb, X86_RSI, X86_RAX)
    let middle_back_at_16 = codebuf_offset(cb) as int
    cb = x86_emit_jmp_rel32(cb, 0)

    let middle_done_16 = codebuf_offset(cb) as int
    cb = patch_rel32(cb, middle_done_at_16 + 2, middle_done_16)
    cb = patch_rel32(cb, middle_back_at_16 + 1, middle_check_16)
    cb = x86_emit_mov_reg_imm32(cb, X86_RAX, 1)
    cb = x86_emit_add_rr(cb, X86_RDI, X86_RAX)
    let outer_back_at_16 = codebuf_offset(cb) as int
    cb = x86_emit_jmp_rel32(cb, 0)

    let outer_done_16 = codebuf_offset(cb) as int
    cb = patch_rel32(cb, outer_done_at_16 + 2, outer_done_16)
    cb = patch_rel32(cb, outer_back_at_16 + 1, outer_check_16)

    let matmul_done_pos = codebuf_offset(cb) as int
    cb = patch_rel32(cb, fixup_matmul_done - 4, matmul_done_pos)
    cb = patch_rel32(cb, fixup_f32_done - 4, matmul_done_pos)

    cb = x86_emit_mov_rr(cb, X86_RAX, X86_RBP)
    cb = x86_emit_add_rsp_imm(cb, 8)
    cb = x86_emit_pop(cb, X86_R9)
    cb = x86_emit_pop(cb, X86_R14)
    cb = x86_emit_pop(cb, X86_R13)
    cb = x86_emit_pop(cb, X86_R12)
    cb = x86_emit_pop(cb, X86_RBP)
    cb = x86_emit_pop(cb, X86_RBX)
    out x86_emit_ret(cb)
end.

func emit_lir_rt_matmul_quantized_stub_x86(cb: &CodeBuf):
    # Quantized matmul: compact ** input (M x K times K x N -> M x N)
    # Inputs (System V AMD64 ABI):
    #   RDI = matrix A (QuantizedTensor: numel at 0, bits at 8, scale at 16, data at 32)
    #   RSI = matrix B (Tensor: numel at 0, cap at 8, elements at 16)
    #   RDX = M (rows of A)
    #   RCX = K (cols of A / rows of B)
    #   R8  = N (cols of B)
    #   R15 = Arena bump pointer (*R15 is current top)
    # Output:
    #   RAX = matrix C (Tensor ptr: elements at 16 as double / float bit pattern)

    cb = x86_emit_push(cb, X86_RBX)
    cb = x86_emit_push(cb, X86_RBP)
    cb = x86_emit_push(cb, X86_R12)
    cb = x86_emit_push(cb, X86_R13)
    cb = x86_emit_push(cb, X86_R14)
    cb = x86_emit_sub_rsp_imm(cb, 32)

    # Save N, bits, scale on stack
    cb = x86_emit_mov_mem_reg(cb, X86_RSP, 0, X86_R8)         # [rsp + 0] = N
    cb = x86_emit_mov_reg_mem(cb, X86_RAX, X86_RDI, 8)        # bits
    cb = x86_emit_mov_mem_reg(cb, X86_RSP, 8, X86_RAX)        # [rsp + 8] = bits
    cb = x86_emit_mov_reg_mem(cb, X86_RAX, X86_RDI, 16)       # scale
    cb = x86_emit_mov_mem_reg(cb, X86_RSP, 16, X86_RAX)       # [rsp + 16] = scale

    # Preserve base pointers and dimensions
    cb = x86_emit_mov_rr(cb, X86_RBX, X86_RDI)
    cb = x86_emit_mov_reg_imm32(cb, X86_RAX, 32)
    cb = x86_emit_add_rr(cb, X86_RBX, X86_RAX)                 # RBX = &A_bytes[0]

    cb = x86_emit_mov_rr(cb, X86_R13, X86_RSI)
    cb = x86_emit_mov_reg_imm32(cb, X86_RAX, 16)
    cb = x86_emit_add_rr(cb, X86_R13, X86_RAX)                 # R13 = &B_elements[0]

    cb = x86_emit_mov_rr(cb, X86_R12, X86_RDX)                 # R12 = M
    cb = x86_emit_mov_rr(cb, X86_R14, X86_RCX)                 # R14 = K

    # Allocate C from [R15], placing elements (header + 16) on a 64-byte boundary
    # RAX = numel = M * N
    cb = x86_emit_mov_rr(cb, X86_RAX, X86_R12)
    cb = x86_emit_imul_rr(cb, X86_RAX, X86_R8)

    # RBP = bump top aligned
    cb = x86_emit_mov_reg_mem(cb, X86_RBP, X86_R15, 0)
    cb = x86_emit_mov_reg_imm32(cb, X86_RCX, 79)
    cb = x86_emit_add_rr(cb, X86_RBP, X86_RCX)
    cb = x86_emit_mov_reg_imm32(cb, X86_RCX, 0 - 64)
    cb = x86_emit_and_rr(cb, X86_RBP, X86_RCX)
    cb = x86_emit_mov_reg_imm32(cb, X86_RCX, 16)
    cb = x86_emit_sub_rr(cb, X86_RBP, X86_RCX)

    # Store header: numel at 0, cap at 8
    cb = x86_emit_mov_mem_reg(cb, X86_RBP, 0, X86_RAX)
    cb = x86_emit_mov_mem_reg(cb, X86_RBP, 8, X86_RAX)

    # Update bump top: 16 + numel * 8, rounded to 16 bytes
    cb = x86_emit_mov_rr(cb, X86_RDI, X86_RAX)
    cb = x86_emit_shl_imm(cb, X86_RDI, 3)
    cb = x86_emit_mov_reg_imm32(cb, X86_RCX, 31)
    cb = x86_emit_add_rr(cb, X86_RDI, X86_RCX)
    cb = x86_emit_mov_reg_imm32(cb, X86_RCX, 0 - 16)
    cb = x86_emit_and_rr(cb, X86_RDI, X86_RCX)
    cb = x86_emit_add_rr(cb, X86_RDI, X86_RBP)
    cb = x86_emit_mov_mem_reg(cb, X86_R15, 0, X86_RDI)

    # Outer loop: for (i = 0; i < M; i++)
    cb = x86_emit_xor_rr(cb, X86_RDI, X86_RDI)                 # i = 0
    let loop_i_start = codebuf_offset(cb) as int
    cb = x86_emit_cmp_rr(cb, X86_RDI, X86_R12)
    cb = x86_emit_jge_rel32(cb, 0)
    let fixup_exit_i = codebuf_offset(cb) as int

    # Middle loop: for (j = 0; j < N; j++)
    cb = x86_emit_xor_rr(cb, X86_RSI, X86_RSI)                 # j = 0
    let loop_j_start = codebuf_offset(cb) as int
    cb = x86_emit_mov_reg_mem(cb, X86_R8, X86_RSP, 0)          # R8 = N
    cb = x86_emit_cmp_rr(cb, X86_RSI, X86_R8)
    cb = x86_emit_jge_rel32(cb, 0)
    let fixup_exit_j = codebuf_offset(cb) as int

    # Inner loop: sum = 0.0 (in XMM2); for (k = 0; k < K; k++)
    cb = x86_emit_xor_rr(cb, X86_RAX, X86_RAX)
    cb = x86_emit_movq_xmm_gpr(cb, 2, X86_RAX)
    cb = x86_emit_xor_rr(cb, X86_RDX, X86_RDX)                 # k = 0
    let loop_k_start = codebuf_offset(cb) as int
    cb = x86_emit_cmp_rr(cb, X86_RDX, X86_R14)
    cb = x86_emit_jge_rel32(cb, 0)
    let fixup_exit_k = codebuf_offset(cb) as int

    # idx = i * K + k
    cb = x86_emit_mov_rr(cb, X86_R10, X86_RDI)
    cb = x86_emit_imul_rr(cb, X86_R10, X86_R14)
    cb = x86_emit_add_rr(cb, X86_R10, X86_RDX)                 # R10 = idx

    # Check bits: if bits != 4, jump to 8-bit branch
    cb = x86_emit_mov_reg_mem(cb, X86_R9, X86_RSP, 8)          # R9 = bits
    cb = x86_emit_cmp_reg_imm32(cb, X86_R9, 4)
    cb = x86_emit_jne_rel32(cb, 0)
    let fixup_is_8bit = codebuf_offset(cb) as int

    # --- 4-bit unpacking branch ---
    cb = x86_emit_mov_rr(cb, X86_R11, X86_R10)
    cb = x86_emit_shr_imm(cb, X86_R11, 1)                      # R11 = idx >> 1
    cb = x86_emit_mov_rr(cb, X86_RCX, X86_RBX)
    cb = x86_emit_add_rr(cb, X86_RCX, X86_R11)
    cb = x86_emit_movzx_reg_mem8(cb, X86_RAX, X86_RCX, 0)      # RAX = byte

    cb = x86_emit_mov_rr(cb, X86_RCX, X86_R10)
    cb = x86_emit_and_imm8(cb, X86_RCX, 1)                     # RCX = idx & 1
    cb = x86_emit_cmp_reg_imm32(cb, X86_RCX, 0)
    cb = x86_emit_je_rel32(cb, 0)
    let fixup_even_nibble = codebuf_offset(cb) as int
    cb = x86_emit_shr_imm(cb, X86_RAX, 4)                      # odd: high nibble
    let even_pos = codebuf_offset(cb) as int
    cb = patch_rel32(cb, fixup_even_nibble - 4, even_pos)

    cb = x86_emit_and_imm8(cb, X86_RAX, 15)                    # RAX = nibble (0..15)
    cb = x86_emit_cmp_reg_imm32(cb, X86_RAX, 8)
    cb = x86_emit_jl_rel32(cb, 0)
    let fixup_nibble_pos = codebuf_offset(cb) as int
    cb = x86_emit_mov_reg_imm32(cb, X86_RCX, 16)
    cb = x86_emit_sub_rr(cb, X86_RAX, X86_RCX)                 # sign-extend: RAX - 16
    let nibble_pos = codebuf_offset(cb) as int
    cb = patch_rel32(cb, fixup_nibble_pos - 4, nibble_pos)

    cb = x86_emit_jmp_rel32(cb, 0)
    let fixup_weight_done = codebuf_offset(cb) as int

    # --- 8-bit unpacking branch ---
    let is_8bit_pos = codebuf_offset(cb) as int
    cb = patch_rel32(cb, fixup_is_8bit - 4, is_8bit_pos)
    cb = x86_emit_mov_rr(cb, X86_RCX, X86_RBX)
    cb = x86_emit_add_rr(cb, X86_RCX, X86_R10)
    cb = x86_emit_movzx_reg_mem8(cb, X86_RAX, X86_RCX, 0)      # RAX = byte (0..255)
    cb = x86_emit_cmp_reg_imm32(cb, X86_RAX, 128)
    cb = x86_emit_jl_rel32(cb, 0)
    let fixup_byte_pos = codebuf_offset(cb) as int
    cb = x86_emit_mov_reg_imm32(cb, X86_RCX, 256)
    cb = x86_emit_sub_rr(cb, X86_RAX, X86_RCX)                 # sign-extend: RAX - 256
    let byte_pos = codebuf_offset(cb) as int
    cb = patch_rel32(cb, fixup_byte_pos - 4, byte_pos)

    let weight_done_pos = codebuf_offset(cb) as int
    cb = patch_rel32(cb, fixup_weight_done - 4, weight_done_pos)

    # Signed weight in RAX -> double in XMM0
    cb = x86_emit_cvtsi2sd_xg(cb, 0, X86_RAX)

    # Load B[k * N + j]
    cb = x86_emit_mov_rr(cb, X86_R11, X86_RDX)                 # R11 = k
    cb = x86_emit_mov_reg_mem(cb, X86_R8, X86_RSP, 0)          # R8 = N
    cb = x86_emit_imul_rr(cb, X86_R11, X86_R8)                 # R11 = k * N
    cb = x86_emit_add_rr(cb, X86_R11, X86_RSI)                 # R11 = k * N + j
    cb = x86_emit_shl_imm(cb, X86_R11, 3)                      # * 8
    cb = x86_emit_add_rr(cb, X86_R11, X86_R13)                 # &B_elements[k * N + j]
    cb = x86_emit_mov_reg_mem(cb, X86_RAX, X86_R11, 0)         # RAX = B element

    # Convert RAX to double in XMM1 (preserving IEEE 754 floats without truncation)
    cb = x86_emit_mov_rr(cb, X86_R11, X86_RAX)
    cb = x86_emit_shr_imm(cb, X86_R11, 52)
    cb = x86_emit_mov_reg_imm32(cb, X86_RCX, 2047)
    cb = x86_emit_and_rr(cb, X86_R11, X86_RCX)
    cb = x86_emit_cmp_reg_imm32(cb, X86_R11, 0)
    cb = x86_emit_je_rel32(cb, 0)
    let fixup_b_int = codebuf_offset(cb) as int
    cb = x86_emit_cmp_reg_imm32(cb, X86_R11, 2047)
    cb = x86_emit_je_rel32(cb, 0)
    let fixup_b_int2 = codebuf_offset(cb) as int

    # Float bit pattern: move directly to XMM1
    cb = x86_emit_movq_xmm_gpr(cb, 1, X86_RAX)
    cb = x86_emit_jmp_rel32(cb, 0)
    let fixup_b_done = codebuf_offset(cb) as int

    # Integer: convert to double in XMM1
    let b_int_pos = codebuf_offset(cb) as int
    cb = patch_rel32(cb, fixup_b_int - 4, b_int_pos)
    cb = patch_rel32(cb, fixup_b_int2 - 4, b_int_pos)
    cb = x86_emit_cvtsi2sd_xg(cb, 1, X86_RAX)

    let b_done_pos = codebuf_offset(cb) as int
    cb = patch_rel32(cb, fixup_b_done - 4, b_done_pos)

    # XMM0 = W * B
    cb = x86_emit_mulsd_xx(cb, 0, 1)

    # XMM2 += XMM0
    cb = x86_emit_addsd_xx(cb, 2, 0)

    # k++
    cb = x86_emit_mov_reg_imm32(cb, X86_RAX, 1)
    cb = x86_emit_add_rr(cb, X86_RDX, X86_RAX)
    cb = x86_emit_jmp_rel32(cb, 0)
    let fixup_loop_k = codebuf_offset(cb) as int
    cb = patch_rel32(cb, fixup_loop_k - 4, loop_k_start)

    let exit_k_pos = codebuf_offset(cb) as int
    cb = patch_rel32(cb, fixup_exit_k - 4, exit_k_pos)

    # Multiply sum (XMM2) by scale
    cb = x86_emit_mov_reg_mem(cb, X86_RAX, X86_RSP, 16)        # RAX = scale
    cb = x86_emit_mov_rr(cb, X86_R11, X86_RAX)
    cb = x86_emit_shr_imm(cb, X86_R11, 52)
    cb = x86_emit_mov_reg_imm32(cb, X86_RCX, 2047)
    cb = x86_emit_and_rr(cb, X86_R11, X86_RCX)
    cb = x86_emit_cmp_reg_imm32(cb, X86_R11, 0)
    cb = x86_emit_je_rel32(cb, 0)
    let fixup_sc_int = codebuf_offset(cb) as int
    cb = x86_emit_cmp_reg_imm32(cb, X86_R11, 2047)
    cb = x86_emit_je_rel32(cb, 0)
    let fixup_sc_int2 = codebuf_offset(cb) as int

    # Float scale:
    cb = x86_emit_movq_xmm_gpr(cb, 3, X86_RAX)
    cb = x86_emit_jmp_rel32(cb, 0)
    let fixup_sc_done = codebuf_offset(cb) as int

    # Integer scale:
    let sc_int_pos = codebuf_offset(cb) as int
    cb = patch_rel32(cb, fixup_sc_int - 4, sc_int_pos)
    cb = patch_rel32(cb, fixup_sc_int2 - 4, sc_int_pos)
    cb = x86_emit_cvtsi2sd_xg(cb, 3, X86_RAX)

    let sc_done_pos = codebuf_offset(cb) as int
    cb = patch_rel32(cb, fixup_sc_done - 4, sc_done_pos)

    # XMM2 = sum * scale
    cb = x86_emit_mulsd_xx(cb, 2, 3)

    # Store sum to C[i * N + j]
    cb = x86_emit_mov_rr(cb, X86_R10, X86_RDI)                 # R10 = i
    cb = x86_emit_mov_reg_mem(cb, X86_R8, X86_RSP, 0)          # R8 = N
    cb = x86_emit_imul_rr(cb, X86_R10, X86_R8)                 # R10 = i * N
    cb = x86_emit_add_rr(cb, X86_R10, X86_RSI)                 # R10 = i * N + j
    cb = x86_emit_shl_imm(cb, X86_R10, 3)                      # * 8
    cb = x86_emit_add_rr(cb, X86_R10, X86_RBP)                 # + C base
    cb = x86_emit_movq_gpr_xmm(cb, X86_RAX, 2)                 # RAX = sum bitwise
    cb = x86_emit_mov_mem_reg(cb, X86_R10, 16, X86_RAX)        # C[i * N + j] = sum

    # j++
    cb = x86_emit_mov_reg_imm32(cb, X86_RAX, 1)
    cb = x86_emit_add_rr(cb, X86_RSI, X86_RAX)
    cb = x86_emit_jmp_rel32(cb, 0)
    let fixup_loop_j = codebuf_offset(cb) as int
    cb = patch_rel32(cb, fixup_loop_j - 4, loop_j_start)

    let exit_j_pos = codebuf_offset(cb) as int
    cb = patch_rel32(cb, fixup_exit_j - 4, exit_j_pos)

    # i++
    cb = x86_emit_mov_reg_imm32(cb, X86_RAX, 1)
    cb = x86_emit_add_rr(cb, X86_RDI, X86_RAX)
    cb = x86_emit_jmp_rel32(cb, 0)
    let fixup_loop_i = codebuf_offset(cb) as int
    cb = patch_rel32(cb, fixup_loop_i - 4, loop_i_start)

    let exit_i_pos = codebuf_offset(cb) as int
    cb = patch_rel32(cb, fixup_exit_i - 4, exit_i_pos)

    # Return C in RAX
    cb = x86_emit_mov_rr(cb, X86_RAX, X86_RBP)
    cb = x86_emit_add_rsp_imm(cb, 32)
    cb = x86_emit_pop(cb, X86_R14)
    cb = x86_emit_pop(cb, X86_R13)
    cb = x86_emit_pop(cb, X86_R12)
    cb = x86_emit_pop(cb, X86_RBP)
    cb = x86_emit_pop(cb, X86_RBX)
    out x86_emit_ret(cb)
end.

