##
 * compiler/src/lower/lir_codegen_x86/rt_stubs_math/backward_quantize.vri — backward and quantize stubs
 * VIRC-PLN-0009: extracted verbatim from compiler/src/lower/lir_codegen_x86/rt_stubs_math.vri.
 ##

include types_prelude
include rt_vec_rt
include rt_string_rt
include codegen
include lir_codegen_x86_types
include lir_codegen_x86_intrinsics
include lir_codegen_x86_calls
include lir_codegen_x86_rt_stubs_base

func emit_lir_rt_backward_legacy_stub_x86(cb: &CodeBuf):
    cb = x86_emit_push(cb, X86_RBX)
    cb = x86_emit_push(cb, X86_R12)
    cb = x86_emit_push(cb, X86_R13)
    cb = x86_emit_push(cb, X86_R14)

    cb = x86_emit_mov_reg_mem(cb, X86_R12, X86_R15, 16)
    cb = x86_emit_mov_reg_mem(cb, X86_R13, X86_R15, 24)

    cb = x86_emit_test_rr(cb, X86_R12, X86_R12)
    cb = x86_emit_je_rel32(cb, 0)
    let fixup_b_ret = codebuf_offset(cb) as int
    cb = x86_emit_test_rr(cb, X86_R13, X86_R13)
    cb = x86_emit_je_rel32(cb, 0)
    let fixup_b_ret2 = codebuf_offset(cb) as int

    cb = x86_emit_mov_reg_mem(cb, X86_R14, X86_R15, 0)
    cb = x86_emit_mov_rr(cb, X86_RAX, X86_R14)
    cb = x86_emit_mov_reg_imm32(cb, X86_RDX, 48)
    cb = x86_emit_add_rr(cb, X86_RAX, X86_RDX)
    cb = x86_emit_mov_mem_reg(cb, X86_R15, 0, X86_RAX)
    cb = x86_emit_mov_reg_imm32(cb, X86_RAX, 4)
    cb = x86_emit_mov_mem_reg(cb, X86_R14, 0, X86_RAX)
    cb = x86_emit_mov_mem_reg(cb, X86_R14, 8, X86_RAX)

    cb = x86_emit_mov_reg_mem(cb, X86_RBX, X86_R15, 0)
    cb = x86_emit_mov_rr(cb, X86_RAX, X86_RBX)
    cb = x86_emit_add_rr(cb, X86_RAX, X86_RDX)
    cb = x86_emit_mov_mem_reg(cb, X86_R15, 0, X86_RAX)
    cb = x86_emit_mov_reg_imm32(cb, X86_RAX, 4)
    cb = x86_emit_mov_mem_reg(cb, X86_RBX, 0, X86_RAX)
    cb = x86_emit_mov_mem_reg(cb, X86_RBX, 8, X86_RAX)

    cb = x86_emit_mov_rr(cb, X86_RDI, X86_R13)
    cb = x86_emit_mov_reg_imm32(cb, X86_RAX, 16)
    cb = x86_emit_add_rr(cb, X86_RDI, X86_RAX)

    cb = x86_emit_mov_rr(cb, X86_RSI, X86_R14)
    cb = x86_emit_add_rr(cb, X86_RSI, X86_RAX)

    cb = codebuf_emit_byte(cb, 0xF2)
    cb = codebuf_emit_byte(cb, 0x0F)
    cb = codebuf_emit_byte(cb, 0x10)
    cb = codebuf_emit_byte(cb, 0x07)
    cb = codebuf_emit_byte(cb, 0xF2)
    cb = codebuf_emit_byte(cb, 0x0F)
    cb = codebuf_emit_byte(cb, 0x10)
    cb = codebuf_emit_byte(cb, 0x4F)
    cb = codebuf_emit_byte(cb, 0x08)
    cb = codebuf_emit_byte(cb, 0xF2)
    cb = codebuf_emit_byte(cb, 0x0F)
    cb = codebuf_emit_byte(cb, 0x10)
    cb = codebuf_emit_byte(cb, 0x57)
    cb = codebuf_emit_byte(cb, 0x10)
    cb = codebuf_emit_byte(cb, 0xF2)
    cb = codebuf_emit_byte(cb, 0x0F)
    cb = codebuf_emit_byte(cb, 0x10)
    cb = codebuf_emit_byte(cb, 0x5F)
    cb = codebuf_emit_byte(cb, 0x18)

    cb = codebuf_emit_byte(cb, 0xF2)
    cb = codebuf_emit_byte(cb, 0x0F)
    cb = codebuf_emit_byte(cb, 0x58)
    cb = codebuf_emit_byte(cb, 0xC1)
    cb = codebuf_emit_byte(cb, 0xF2)
    cb = codebuf_emit_byte(cb, 0x0F)
    cb = codebuf_emit_byte(cb, 0x58)
    cb = codebuf_emit_byte(cb, 0xD3)

    cb = codebuf_emit_byte(cb, 0xF2)
    cb = codebuf_emit_byte(cb, 0x0F)
    cb = codebuf_emit_byte(cb, 0x11)
    cb = codebuf_emit_byte(cb, 0x06)
    cb = codebuf_emit_byte(cb, 0xF2)
    cb = codebuf_emit_byte(cb, 0x0F)
    cb = codebuf_emit_byte(cb, 0x11)
    cb = codebuf_emit_byte(cb, 0x56)
    cb = codebuf_emit_byte(cb, 0x08)
    cb = codebuf_emit_byte(cb, 0xF2)
    cb = codebuf_emit_byte(cb, 0x0F)
    cb = codebuf_emit_byte(cb, 0x11)
    cb = codebuf_emit_byte(cb, 0x46)
    cb = codebuf_emit_byte(cb, 0x10)
    cb = codebuf_emit_byte(cb, 0xF2)
    cb = codebuf_emit_byte(cb, 0x0F)
    cb = codebuf_emit_byte(cb, 0x11)
    cb = codebuf_emit_byte(cb, 0x56)
    cb = codebuf_emit_byte(cb, 0x18)

    cb = x86_emit_mov_rr(cb, X86_RDI, X86_R12)
    cb = x86_emit_mov_reg_imm32(cb, X86_RAX, 16)
    cb = x86_emit_add_rr(cb, X86_RDI, X86_RAX)

    cb = x86_emit_mov_rr(cb, X86_RSI, X86_RBX)
    cb = x86_emit_add_rr(cb, X86_RSI, X86_RAX)

    cb = codebuf_emit_byte(cb, 0xF2)
    cb = codebuf_emit_byte(cb, 0x0F)
    cb = codebuf_emit_byte(cb, 0x10)
    cb = codebuf_emit_byte(cb, 0x07)
    cb = codebuf_emit_byte(cb, 0xF2)
    cb = codebuf_emit_byte(cb, 0x0F)
    cb = codebuf_emit_byte(cb, 0x10)
    cb = codebuf_emit_byte(cb, 0x4F)
    cb = codebuf_emit_byte(cb, 0x08)
    cb = codebuf_emit_byte(cb, 0xF2)
    cb = codebuf_emit_byte(cb, 0x0F)
    cb = codebuf_emit_byte(cb, 0x10)
    cb = codebuf_emit_byte(cb, 0x57)
    cb = codebuf_emit_byte(cb, 0x10)
    cb = codebuf_emit_byte(cb, 0xF2)
    cb = codebuf_emit_byte(cb, 0x0F)
    cb = codebuf_emit_byte(cb, 0x10)
    cb = codebuf_emit_byte(cb, 0x5F)
    cb = codebuf_emit_byte(cb, 0x18)

    cb = codebuf_emit_byte(cb, 0xF2)
    cb = codebuf_emit_byte(cb, 0x0F)
    cb = codebuf_emit_byte(cb, 0x58)
    cb = codebuf_emit_byte(cb, 0xC2)
    cb = codebuf_emit_byte(cb, 0xF2)
    cb = codebuf_emit_byte(cb, 0x0F)
    cb = codebuf_emit_byte(cb, 0x58)
    cb = codebuf_emit_byte(cb, 0xCB)

    cb = codebuf_emit_byte(cb, 0xF2)
    cb = codebuf_emit_byte(cb, 0x0F)
    cb = codebuf_emit_byte(cb, 0x11)
    cb = codebuf_emit_byte(cb, 0x06)
    cb = codebuf_emit_byte(cb, 0xF2)
    cb = codebuf_emit_byte(cb, 0x0F)
    cb = codebuf_emit_byte(cb, 0x11)
    cb = codebuf_emit_byte(cb, 0x46)
    cb = codebuf_emit_byte(cb, 0x08)
    cb = codebuf_emit_byte(cb, 0xF2)
    cb = codebuf_emit_byte(cb, 0x0F)
    cb = codebuf_emit_byte(cb, 0x11)
    cb = codebuf_emit_byte(cb, 0x4E)
    cb = codebuf_emit_byte(cb, 0x10)
    cb = codebuf_emit_byte(cb, 0xF2)
    cb = codebuf_emit_byte(cb, 0x0F)
    cb = codebuf_emit_byte(cb, 0x11)
    cb = codebuf_emit_byte(cb, 0x4E)
    cb = codebuf_emit_byte(cb, 0x18)

    cb = x86_emit_mov_mem_reg(cb, X86_R12, 8, X86_R14)
    cb = x86_emit_mov_mem_reg(cb, X86_R13, 8, X86_RBX)

    cb = x86_emit_xor_rr(cb, X86_RAX, X86_RAX)
    cb = x86_emit_mov_mem_reg(cb, X86_R15, 16, X86_RAX)
    cb = x86_emit_mov_mem_reg(cb, X86_R15, 24, X86_RAX)
    cb = x86_emit_mov_mem_reg(cb, X86_R15, 32, X86_RAX)
    cb = x86_emit_mov_mem_reg(cb, X86_R15, 40, X86_RAX)
    cb = x86_emit_mov_mem_reg(cb, X86_R15, 48, X86_RAX)
    cb = x86_emit_mov_mem_reg(cb, X86_R15, 56, X86_RAX)
    cb = x86_emit_mov_mem_reg(cb, X86_R15, 64, X86_RAX)

    let back_ret_pos = codebuf_offset(cb) as int
    cb = patch_rel32(cb, fixup_b_ret - 4, back_ret_pos)
    cb = patch_rel32(cb, fixup_b_ret2 - 4, back_ret_pos)

    cb = x86_emit_pop(cb, X86_R14)
    cb = x86_emit_pop(cb, X86_R13)
    cb = x86_emit_pop(cb, X86_R12)
    cb = x86_emit_pop(cb, X86_RBX)
    out x86_emit_ret(cb)
end.

func emit_x86_ad_alloc_f32(cb: CodeBuf, numel_reg: int, out_reg: int, fill_one: int):
    # Preserve numel in RDX.  The allocation is emitted inline in the reverse
    # kernel, so it must honor the same arena cap/growth contract as alloc().
    cb = x86_emit_mov_rr(cb, X86_RDX, numel_reg)
    let alloc_retry = codebuf_offset(cb) as int
    cb = x86_emit_mov_reg_mem(cb, out_reg, X86_R15, 0)
    cb = x86_emit_mov_reg_imm32(cb, X86_RAX, 79)
    cb = x86_emit_add_rr(cb, out_reg, X86_RAX)
    cb = x86_emit_mov_reg_imm32(cb, X86_RAX, 0 - 64)
    cb = x86_emit_and_rr(cb, out_reg, X86_RAX)
    cb = x86_emit_mov_reg_imm32(cb, X86_RAX, 16)
    cb = x86_emit_sub_rr(cb, out_reg, X86_RAX)
    cb = x86_emit_mov_rr(cb, X86_RAX, X86_RDX)
    cb = x86_emit_shl_imm(cb, X86_RAX, 2)
    cb = x86_emit_mov_reg_imm32(cb, X86_RCX, 31)
    cb = x86_emit_add_rr(cb, X86_RAX, X86_RCX)
    cb = x86_emit_mov_reg_imm32(cb, X86_RCX, 0 - 16)
    cb = x86_emit_and_rr(cb, X86_RAX, X86_RCX)
    cb = x86_emit_add_rr(cb, X86_RAX, out_reg) # proposed arena top
    cb = x86_emit_mov_reg_mem(cb, X86_RCX, X86_R15, 24)
    cb = x86_emit_test_rr(cb, X86_RCX, X86_RCX)
    cb = x86_emit_je_rel32(cb, 0)
    let no_cap = codebuf_offset(cb) as int
    cb = x86_emit_cmp_rr(cb, X86_RAX, X86_RCX)
    cb = x86_emit_jle_rel32(cb, 0)
    let fits_cap = codebuf_offset(cb) as int

    # Grow with a fresh 8 MiB Linux mapping.  Existing tensor pointers remain
    # valid; subsequent allocations continue in the new chunk.
    cb = x86_emit_push(cb, X86_RDX)
    cb = x86_emit_xor_rr(cb, X86_RDI, X86_RDI)
    cb = x86_emit_mov_reg_imm32(cb, X86_RSI, 0x800000)
    cb = x86_emit_mov_reg_imm32(cb, X86_RDX, 3)
    cb = x86_emit_mov_reg_imm32(cb, X86_R10, 34)
    cb = x86_emit_mov_reg_imm64(cb, X86_R8, 0 - 1)
    cb = x86_emit_xor_rr(cb, X86_R9, X86_R9)
    cb = x86_emit_mov_reg_imm32(cb, X86_RAX, X86_SYS_MMAP)
    cb = x86_emit_syscall(cb)
    cb = x86_emit_pop(cb, X86_RDX)
    cb = x86_emit_mov_mem_reg(cb, X86_R15, 0, X86_RAX)
    cb = x86_emit_mov_rr(cb, X86_RCX, X86_RAX)
    cb = x86_emit_mov_reg_imm32(cb, X86_R10, 0x800000)
    cb = x86_emit_add_rr(cb, X86_RCX, X86_R10)
    cb = x86_emit_mov_mem_reg(cb, X86_R15, 24, X86_RCX)
    cb = x86_emit_jmp_rel32(cb, alloc_retry - (codebuf_offset(cb) + 5))

    let cap_ready = codebuf_offset(cb) as int
    cb = patch_rel32(cb, no_cap - 4, cap_ready)
    cb = patch_rel32(cb, fits_cap - 4, cap_ready)
    cb = x86_emit_mov_mem_reg(cb, out_reg, 0, X86_RDX)
    cb = x86_emit_mov_mem_reg(cb, out_reg, 8, X86_RDX)
    cb = x86_emit_mov_mem_reg(cb, X86_R15, 0, X86_RAX)
    cb = x86_emit_xor_rr(cb, X86_R8, X86_R8)
    cb = x86_emit_xor_rr(cb, X86_R10, X86_R10)
    if fill_one == 1 do cb = x86_emit_mov_reg_imm32(cb, X86_R10, 0x3F800000) end
    let fill_loop = codebuf_offset(cb) as int
    cb = x86_emit_cmp_rr(cb, X86_R8, X86_RDX)
    cb = x86_emit_jge_rel32(cb, 0)
    let fill_exit = codebuf_offset(cb) as int
    cb = x86_emit_mov_rr(cb, X86_RAX, X86_R8)
    cb = x86_emit_shl_imm(cb, X86_RAX, 2)
    cb = x86_emit_add_rr(cb, X86_RAX, out_reg)
    cb = x86_emit_mov_mem_reg32(cb, X86_RAX, 16, X86_R10)
    cb = x86_emit_mov_reg_imm32(cb, X86_RCX, 1)
    cb = x86_emit_add_rr(cb, X86_R8, X86_RCX)
    cb = x86_emit_jmp_rel32(cb, fill_loop - (codebuf_offset(cb) + 5))
    let fill_done = codebuf_offset(cb) as int
    cb = patch_rel32(cb, fill_exit - 4, fill_done)
    out cb
end.

func emit_lir_rt_backward_header_legacy_stub_x86(cb: &CodeBuf):
    # AOT f32 matmul reverse kernel: RDI=A, RSI=B, RDX=C, RCX=static meta.
    cb = x86_emit_push(cb, X86_RBX)
    cb = x86_emit_push(cb, X86_RBP)
    cb = x86_emit_push(cb, X86_R12)
    cb = x86_emit_push(cb, X86_R13)
    cb = x86_emit_push(cb, X86_R14)
    cb = x86_emit_sub_rsp_imm(cb, 64)
    cb = x86_emit_mov_rr(cb, X86_R12, X86_RDI)
    cb = x86_emit_mov_rr(cb, X86_R13, X86_RSI)
    cb = x86_emit_mov_rr(cb, X86_R14, X86_RDX)
    cb = x86_emit_mov_rr(cb, X86_RBX, X86_RCX)

    cb = x86_emit_mov_rr(cb, X86_RAX, X86_RBX)
    cb = x86_emit_shr_imm(cb, X86_RAX, 32)
    cb = x86_emit_mov_reg_imm32(cb, X86_RCX, 65535)
    cb = x86_emit_and_rr(cb, X86_RAX, X86_RCX)
    cb = x86_emit_mov_mem_reg(cb, X86_RSP, 0, X86_RAX)  # M
    cb = x86_emit_mov_rr(cb, X86_RAX, X86_RBX)
    cb = x86_emit_shr_imm(cb, X86_RAX, 16)
    cb = x86_emit_and_rr(cb, X86_RAX, X86_RCX)
    cb = x86_emit_mov_mem_reg(cb, X86_RSP, 8, X86_RAX)  # K
    cb = x86_emit_mov_rr(cb, X86_RAX, X86_RBX)
    cb = x86_emit_and_rr(cb, X86_RAX, X86_RCX)
    cb = x86_emit_mov_mem_reg(cb, X86_RSP, 16, X86_RAX) # N
    cb = x86_emit_mov_rr(cb, X86_RAX, X86_RBX)
    cb = x86_emit_shr_imm(cb, X86_RAX, 52)
    cb = x86_emit_mov_reg_imm32(cb, X86_RCX, 1)
    cb = x86_emit_and_rr(cb, X86_RAX, X86_RCX)
    cb = x86_emit_mov_mem_reg(cb, X86_RSP, 24, X86_RAX) # root

    cb = x86_emit_mov_rr(cb, X86_RAX, X86_RBX)
    cb = x86_emit_shr_imm(cb, X86_RAX, 48)
    cb = x86_emit_mov_reg_imm32(cb, X86_RCX, 3)
    cb = x86_emit_and_rr(cb, X86_RAX, X86_RCX)
    cb = x86_emit_cmp_reg_imm32(cb, X86_RAX, 3) # float + f32 bits
    cb = x86_emit_jne_rel32(cb, 0)
    let bad_dtype = codebuf_offset(cb) as int

    cb = x86_emit_mov_reg_mem(cb, X86_RBP, X86_R14, 8)
    cb = x86_emit_test_rr(cb, X86_RBP, X86_RBP)
    cb = x86_emit_jne_rel32(cb, 0)
    let have_upstream = codebuf_offset(cb) as int
    cb = x86_emit_mov_reg_mem(cb, X86_RAX, X86_RSP, 24)
    cb = x86_emit_test_rr(cb, X86_RAX, X86_RAX)
    cb = x86_emit_je_rel32(cb, 0)
    let no_upstream = codebuf_offset(cb) as int
    cb = x86_emit_mov_reg_mem(cb, X86_R11, X86_RSP, 0)
    cb = x86_emit_mov_reg_mem(cb, X86_RAX, X86_RSP, 16)
    cb = x86_emit_imul_rr(cb, X86_R11, X86_RAX)
    cb = emit_x86_ad_alloc_f32(cb, X86_R11, X86_RBP, 1)
    cb = x86_emit_mov_mem_reg(cb, X86_R14, 8, X86_RBP)
    let upstream_ready = codebuf_offset(cb) as int
    cb = patch_rel32(cb, have_upstream - 4, upstream_ready)

    cb = x86_emit_mov_reg_mem(cb, X86_RDI, X86_R12, 8)
    cb = x86_emit_test_rr(cb, X86_RDI, X86_RDI)
    cb = x86_emit_jne_rel32(cb, 0)
    let have_grad_a = codebuf_offset(cb) as int
    cb = x86_emit_mov_reg_mem(cb, X86_R11, X86_RSP, 0)
    cb = x86_emit_mov_reg_mem(cb, X86_RAX, X86_RSP, 8)
    cb = x86_emit_imul_rr(cb, X86_R11, X86_RAX)
    cb = emit_x86_ad_alloc_f32(cb, X86_R11, X86_RDI, 0)
    cb = x86_emit_mov_mem_reg(cb, X86_R12, 8, X86_RDI)
    let grad_a_ready = codebuf_offset(cb) as int
    cb = patch_rel32(cb, have_grad_a - 4, grad_a_ready)
    cb = x86_emit_mov_mem_reg(cb, X86_RSP, 32, X86_RDI)

    cb = x86_emit_mov_reg_mem(cb, X86_RSI, X86_R13, 8)
    cb = x86_emit_test_rr(cb, X86_RSI, X86_RSI)
    cb = x86_emit_jne_rel32(cb, 0)
    let have_grad_b = codebuf_offset(cb) as int
    cb = x86_emit_mov_reg_mem(cb, X86_R11, X86_RSP, 8)
    cb = x86_emit_mov_reg_mem(cb, X86_RAX, X86_RSP, 16)
    cb = x86_emit_imul_rr(cb, X86_R11, X86_RAX)
    cb = emit_x86_ad_alloc_f32(cb, X86_R11, X86_RSI, 0)
    cb = x86_emit_mov_mem_reg(cb, X86_R13, 8, X86_RSI)
    let grad_b_ready = codebuf_offset(cb) as int
    cb = patch_rel32(cb, have_grad_b - 4, grad_b_ready)
    cb = x86_emit_mov_mem_reg(cb, X86_RSP, 40, X86_RSI)

    cb = x86_emit_add_imm8(cb, X86_R12, 16)
    cb = x86_emit_add_imm8(cb, X86_R13, 16)
    cb = x86_emit_add_imm8(cb, X86_RBP, 16)
    cb = x86_emit_mov_reg_mem(cb, X86_RDI, X86_RSP, 32)
    cb = x86_emit_add_imm8(cb, X86_RDI, 16)
    cb = x86_emit_mov_reg_mem(cb, X86_RSI, X86_RSP, 40)
    cb = x86_emit_add_imm8(cb, X86_RSI, 16)

    # dA[i,k]
    cb = x86_emit_xor_rr(cb, X86_R8, X86_R8)
    let da_i = codebuf_offset(cb) as int
    cb = x86_emit_mov_reg_mem(cb, X86_RAX, X86_RSP, 0)
    cb = x86_emit_cmp_rr(cb, X86_R8, X86_RAX)
    cb = x86_emit_jge_rel32(cb, 0)
    let da_i_exit = codebuf_offset(cb) as int
    cb = x86_emit_xor_rr(cb, X86_R9, X86_R9)
    let da_k = codebuf_offset(cb) as int
    cb = x86_emit_mov_reg_mem(cb, X86_RAX, X86_RSP, 8)
    cb = x86_emit_cmp_rr(cb, X86_R9, X86_RAX)
    cb = x86_emit_jge_rel32(cb, 0)
    let da_k_exit = codebuf_offset(cb) as int
    cb = x86_emit_mov_rr(cb, X86_R11, X86_R8)
    cb = x86_emit_mov_reg_mem(cb, X86_RAX, X86_RSP, 8)
    cb = x86_emit_imul_rr(cb, X86_R11, X86_RAX)
    cb = x86_emit_add_rr(cb, X86_R11, X86_R9)
    cb = x86_emit_shl_imm(cb, X86_R11, 2)
    cb = x86_emit_add_rr(cb, X86_R11, X86_RDI)
    cb = x86_emit_mov_reg_mem32(cb, X86_RAX, X86_R11, 0)
    cb = x86_emit_movd_xmm_gpr(cb, 0, X86_RAX)
    cb = x86_emit_xor_rr(cb, X86_R10, X86_R10)
    let da_j = codebuf_offset(cb) as int
    cb = x86_emit_mov_reg_mem(cb, X86_RAX, X86_RSP, 16)
    cb = x86_emit_cmp_rr(cb, X86_R10, X86_RAX)
    cb = x86_emit_jge_rel32(cb, 0)
    let da_j_exit = codebuf_offset(cb) as int
    cb = x86_emit_mov_rr(cb, X86_R11, X86_R8)
    cb = x86_emit_mov_reg_mem(cb, X86_RAX, X86_RSP, 16)
    cb = x86_emit_imul_rr(cb, X86_R11, X86_RAX)
    cb = x86_emit_add_rr(cb, X86_R11, X86_R10)
    cb = x86_emit_shl_imm(cb, X86_R11, 2)
    cb = x86_emit_add_rr(cb, X86_R11, X86_RBP)
    cb = x86_emit_mov_reg_mem32(cb, X86_RAX, X86_R11, 0)
    cb = x86_emit_movd_xmm_gpr(cb, 1, X86_RAX)
    cb = x86_emit_mov_rr(cb, X86_R11, X86_R9)
    cb = x86_emit_mov_reg_mem(cb, X86_RAX, X86_RSP, 16)
    cb = x86_emit_imul_rr(cb, X86_R11, X86_RAX)
    cb = x86_emit_add_rr(cb, X86_R11, X86_R10)
    cb = x86_emit_shl_imm(cb, X86_R11, 2)
    cb = x86_emit_add_rr(cb, X86_R11, X86_R13)
    cb = x86_emit_mov_reg_mem32(cb, X86_RAX, X86_R11, 0)
    cb = x86_emit_movd_xmm_gpr(cb, 2, X86_RAX)
    cb = x86_emit_mulss_xx(cb, 1, 2)
    cb = x86_emit_addss_xx(cb, 0, 1)
    cb = x86_emit_add_imm8(cb, X86_R10, 1)
    cb = x86_emit_jmp_rel32(cb, da_j - (codebuf_offset(cb) + 5))
    let da_j_done = codebuf_offset(cb) as int
    cb = patch_rel32(cb, da_j_exit - 4, da_j_done)
    cb = x86_emit_movd_gpr_xmm(cb, X86_RAX, 0)
    cb = x86_emit_mov_rr(cb, X86_R11, X86_R8)
    cb = x86_emit_mov_reg_mem(cb, X86_RCX, X86_RSP, 8)
    cb = x86_emit_imul_rr(cb, X86_R11, X86_RCX)
    cb = x86_emit_add_rr(cb, X86_R11, X86_R9)
    cb = x86_emit_shl_imm(cb, X86_R11, 2)
    cb = x86_emit_add_rr(cb, X86_R11, X86_RDI)
    cb = x86_emit_mov_mem_reg32(cb, X86_R11, 0, X86_RAX)
    cb = x86_emit_add_imm8(cb, X86_R9, 1)
    cb = x86_emit_jmp_rel32(cb, da_k - (codebuf_offset(cb) + 5))
    let da_k_done = codebuf_offset(cb) as int
    cb = patch_rel32(cb, da_k_exit - 4, da_k_done)
    cb = x86_emit_add_imm8(cb, X86_R8, 1)
    cb = x86_emit_jmp_rel32(cb, da_i - (codebuf_offset(cb) + 5))
    let da_i_done = codebuf_offset(cb) as int
    cb = patch_rel32(cb, da_i_exit - 4, da_i_done)

    # dB[k,j]
    cb = x86_emit_xor_rr(cb, X86_R8, X86_R8)
    let db_k = codebuf_offset(cb) as int
    cb = x86_emit_mov_reg_mem(cb, X86_RAX, X86_RSP, 8)
    cb = x86_emit_cmp_rr(cb, X86_R8, X86_RAX)
    cb = x86_emit_jge_rel32(cb, 0)
    let db_k_exit = codebuf_offset(cb) as int
    cb = x86_emit_xor_rr(cb, X86_R9, X86_R9)
    let db_j = codebuf_offset(cb) as int
    cb = x86_emit_mov_reg_mem(cb, X86_RAX, X86_RSP, 16)
    cb = x86_emit_cmp_rr(cb, X86_R9, X86_RAX)
    cb = x86_emit_jge_rel32(cb, 0)
    let db_j_exit = codebuf_offset(cb) as int
    cb = x86_emit_mov_rr(cb, X86_R11, X86_R8)
    cb = x86_emit_mov_reg_mem(cb, X86_RAX, X86_RSP, 16)
    cb = x86_emit_imul_rr(cb, X86_R11, X86_RAX)
    cb = x86_emit_add_rr(cb, X86_R11, X86_R9)
    cb = x86_emit_shl_imm(cb, X86_R11, 2)
    cb = x86_emit_add_rr(cb, X86_R11, X86_RSI)
    cb = x86_emit_mov_reg_mem32(cb, X86_RAX, X86_R11, 0)
    cb = x86_emit_movd_xmm_gpr(cb, 0, X86_RAX)
    cb = x86_emit_xor_rr(cb, X86_R10, X86_R10)
    let db_i = codebuf_offset(cb) as int
    cb = x86_emit_mov_reg_mem(cb, X86_RAX, X86_RSP, 0)
    cb = x86_emit_cmp_rr(cb, X86_R10, X86_RAX)
    cb = x86_emit_jge_rel32(cb, 0)
    let db_i_exit = codebuf_offset(cb) as int
    cb = x86_emit_mov_rr(cb, X86_R11, X86_R10)
    cb = x86_emit_mov_reg_mem(cb, X86_RAX, X86_RSP, 8)
    cb = x86_emit_imul_rr(cb, X86_R11, X86_RAX)
    cb = x86_emit_add_rr(cb, X86_R11, X86_R8)
    cb = x86_emit_shl_imm(cb, X86_R11, 2)
    cb = x86_emit_add_rr(cb, X86_R11, X86_R12)
    cb = x86_emit_mov_reg_mem32(cb, X86_RAX, X86_R11, 0)
    cb = x86_emit_movd_xmm_gpr(cb, 1, X86_RAX)
    cb = x86_emit_mov_rr(cb, X86_R11, X86_R10)
    cb = x86_emit_mov_reg_mem(cb, X86_RAX, X86_RSP, 16)
    cb = x86_emit_imul_rr(cb, X86_R11, X86_RAX)
    cb = x86_emit_add_rr(cb, X86_R11, X86_R9)
    cb = x86_emit_shl_imm(cb, X86_R11, 2)
    cb = x86_emit_add_rr(cb, X86_R11, X86_RBP)
    cb = x86_emit_mov_reg_mem32(cb, X86_RAX, X86_R11, 0)
    cb = x86_emit_movd_xmm_gpr(cb, 2, X86_RAX)
    cb = x86_emit_mulss_xx(cb, 1, 2)
    cb = x86_emit_addss_xx(cb, 0, 1)
    cb = x86_emit_add_imm8(cb, X86_R10, 1)
    cb = x86_emit_jmp_rel32(cb, db_i - (codebuf_offset(cb) + 5))
    let db_i_done = codebuf_offset(cb) as int
    cb = patch_rel32(cb, db_i_exit - 4, db_i_done)
    cb = x86_emit_movd_gpr_xmm(cb, X86_RAX, 0)
    cb = x86_emit_mov_rr(cb, X86_R11, X86_R8)
    cb = x86_emit_mov_reg_mem(cb, X86_RCX, X86_RSP, 16)
    cb = x86_emit_imul_rr(cb, X86_R11, X86_RCX)
    cb = x86_emit_add_rr(cb, X86_R11, X86_R9)
    cb = x86_emit_shl_imm(cb, X86_R11, 2)
    cb = x86_emit_add_rr(cb, X86_R11, X86_RSI)
    cb = x86_emit_mov_mem_reg32(cb, X86_R11, 0, X86_RAX)
    cb = x86_emit_add_imm8(cb, X86_R9, 1)
    cb = x86_emit_jmp_rel32(cb, db_j - (codebuf_offset(cb) + 5))
    let db_j_done = codebuf_offset(cb) as int
    cb = patch_rel32(cb, db_j_exit - 4, db_j_done)
    cb = x86_emit_add_imm8(cb, X86_R8, 1)
    cb = x86_emit_jmp_rel32(cb, db_k - (codebuf_offset(cb) + 5))
    let db_k_done = codebuf_offset(cb) as int
    cb = patch_rel32(cb, db_k_exit - 4, db_k_done)

    let ret_pos = codebuf_offset(cb) as int
    cb = patch_rel32(cb, no_upstream - 4, ret_pos)
    cb = x86_emit_xor_rr(cb, X86_RAX, X86_RAX)
    cb = x86_emit_add_rsp_imm(cb, 64)
    cb = x86_emit_pop(cb, X86_R14)
    cb = x86_emit_pop(cb, X86_R13)
    cb = x86_emit_pop(cb, X86_R12)
    cb = x86_emit_pop(cb, X86_RBP)
    cb = x86_emit_pop(cb, X86_RBX)
    cb = x86_emit_ret(cb)

    let bad_pos = codebuf_offset(cb) as int
    cb = patch_rel32(cb, bad_dtype - 4, bad_pos)
    cb = x86_emit_mov_reg_imm32(cb, X86_RDI, 133)
    cb = x86_emit_mov_reg_imm32(cb, X86_RAX, X86_SYS_EXIT)
    cb = x86_emit_syscall(cb)
    out x86_emit_ret(cb)
end.

func emit_lir_rt_backward_stub_x86(cb: &CodeBuf):
    # SysV inputs: RDI=A, RSI=B, RDX=upstream-or-zero,
    # RCX=prior-grad-or-zero, R8=static metadata/derivative selector.
    cb = x86_emit_push(cb, X86_RBX)
    cb = x86_emit_push(cb, X86_RBP)
    cb = x86_emit_push(cb, X86_R12)
    cb = x86_emit_push(cb, X86_R13)
    cb = x86_emit_push(cb, X86_R14)
    cb = x86_emit_sub_rsp_imm(cb, 64)
    cb = x86_emit_mov_rr(cb, X86_R12, X86_RDI)
    cb = x86_emit_mov_rr(cb, X86_R13, X86_RSI)
    cb = x86_emit_mov_rr(cb, X86_R14, X86_RDX)
    cb = x86_emit_mov_rr(cb, X86_RBP, X86_RCX)
    cb = x86_emit_mov_rr(cb, X86_RBX, X86_R8)

    cb = x86_emit_mov_rr(cb, X86_RAX, X86_RBX)
    cb = x86_emit_shr_imm(cb, X86_RAX, 32)
    cb = x86_emit_mov_reg_imm32(cb, X86_RCX, 65535)
    cb = x86_emit_and_rr(cb, X86_RAX, X86_RCX)
    cb = x86_emit_mov_mem_reg(cb, X86_RSP, 0, X86_RAX)  # M
    cb = x86_emit_mov_rr(cb, X86_RAX, X86_RBX)
    cb = x86_emit_shr_imm(cb, X86_RAX, 16)
    cb = x86_emit_and_rr(cb, X86_RAX, X86_RCX)
    cb = x86_emit_mov_mem_reg(cb, X86_RSP, 8, X86_RAX)  # K
    cb = x86_emit_mov_rr(cb, X86_RAX, X86_RBX)
    cb = x86_emit_and_rr(cb, X86_RAX, X86_RCX)
    cb = x86_emit_mov_mem_reg(cb, X86_RSP, 16, X86_RAX) # N
    cb = x86_emit_mov_rr(cb, X86_RAX, X86_RBX)
    cb = x86_emit_shr_imm(cb, X86_RAX, 52)
    cb = x86_emit_mov_reg_imm32(cb, X86_RCX, 1)
    cb = x86_emit_and_rr(cb, X86_RAX, X86_RCX)
    cb = x86_emit_mov_mem_reg(cb, X86_RSP, 24, X86_RAX) # root
    cb = x86_emit_mov_rr(cb, X86_RAX, X86_RBX)
    cb = x86_emit_shr_imm(cb, X86_RAX, 53)
    cb = x86_emit_and_rr(cb, X86_RAX, X86_RCX)
    cb = x86_emit_mov_mem_reg(cb, X86_RSP, 32, X86_RAX) # side

    cb = x86_emit_mov_rr(cb, X86_RAX, X86_RBX)
    cb = x86_emit_shr_imm(cb, X86_RAX, 48)
    cb = x86_emit_mov_reg_imm32(cb, X86_RCX, 3)
    cb = x86_emit_and_rr(cb, X86_RAX, X86_RCX)
    cb = x86_emit_cmp_reg_imm32(cb, X86_RAX, 3)
    cb = x86_emit_jne_rel32(cb, 0)
    let bad_dtype = codebuf_offset(cb) as int

    # Bit 54 requests the ordinary all-ones tensor exposed as root.grad.
    cb = x86_emit_mov_rr(cb, X86_RAX, X86_RBX)
    cb = x86_emit_shr_imm(cb, X86_RAX, 54)
    cb = x86_emit_mov_reg_imm32(cb, X86_RCX, 1)
    cb = x86_emit_and_rr(cb, X86_RAX, X86_RCX)
    cb = x86_emit_test_rr(cb, X86_RAX, X86_RAX)
    cb = x86_emit_je_rel32(cb, 0)
    let not_root_seed = codebuf_offset(cb) as int
    cb = x86_emit_mov_reg_mem(cb, X86_R11, X86_RSP, 0)
    cb = x86_emit_mov_reg_mem(cb, X86_RAX, X86_RSP, 16)
    cb = x86_emit_imul_rr(cb, X86_R11, X86_RAX)
    cb = emit_x86_ad_alloc_f32(cb, X86_R11, X86_RBP, 1)
    cb = x86_emit_mov_rr(cb, X86_RAX, X86_RBP)
    cb = x86_emit_add_rsp_imm(cb, 64)
    cb = x86_emit_pop(cb, X86_R14)
    cb = x86_emit_pop(cb, X86_R13)
    cb = x86_emit_pop(cb, X86_R12)
    cb = x86_emit_pop(cb, X86_RBP)
    cb = x86_emit_pop(cb, X86_RBX)
    cb = x86_emit_ret(cb)
    let derivative_start = codebuf_offset(cb) as int
    cb = patch_rel32(cb, not_root_seed - 4, derivative_start)

    cb = x86_emit_test_rr(cb, X86_R14, X86_R14)
    cb = x86_emit_jne_rel32(cb, 0)
    let upstream_present = codebuf_offset(cb) as int
    cb = x86_emit_mov_reg_mem(cb, X86_RAX, X86_RSP, 24)
    cb = x86_emit_test_rr(cb, X86_RAX, X86_RAX)
    cb = x86_emit_je_rel32(cb, 0)
    let no_upstream = codebuf_offset(cb) as int
    let upstream_ready = codebuf_offset(cb) as int
    cb = patch_rel32(cb, upstream_present - 4, upstream_ready)

    cb = x86_emit_test_rr(cb, X86_RBP, X86_RBP)
    cb = x86_emit_jne_rel32(cb, 0)
    let have_grad = codebuf_offset(cb) as int
    cb = x86_emit_mov_reg_mem(cb, X86_RAX, X86_RSP, 32)
    cb = x86_emit_test_rr(cb, X86_RAX, X86_RAX)
    cb = x86_emit_jne_rel32(cb, 0)
    let alloc_db = codebuf_offset(cb) as int
    cb = x86_emit_mov_reg_mem(cb, X86_R11, X86_RSP, 0)
    cb = x86_emit_mov_reg_mem(cb, X86_RAX, X86_RSP, 8)
    cb = x86_emit_imul_rr(cb, X86_R11, X86_RAX)
    cb = x86_emit_jmp_rel32(cb, 0)
    let alloc_ready_jump = codebuf_offset(cb) as int
    let alloc_db_pos = codebuf_offset(cb) as int
    cb = patch_rel32(cb, alloc_db - 4, alloc_db_pos)
    cb = x86_emit_mov_reg_mem(cb, X86_R11, X86_RSP, 8)
    cb = x86_emit_mov_reg_mem(cb, X86_RAX, X86_RSP, 16)
    cb = x86_emit_imul_rr(cb, X86_R11, X86_RAX)
    let alloc_ready = codebuf_offset(cb) as int
    cb = patch_rel32(cb, alloc_ready_jump - 4, alloc_ready)
    cb = emit_x86_ad_alloc_f32(cb, X86_R11, X86_RBP, 0)
    let grad_ready = codebuf_offset(cb) as int
    cb = patch_rel32(cb, have_grad - 4, grad_ready)

    cb = x86_emit_add_imm8(cb, X86_R12, 16)
    cb = x86_emit_add_imm8(cb, X86_R13, 16)
    cb = x86_emit_test_rr(cb, X86_R14, X86_R14)
    cb = x86_emit_je_rel32(cb, 0)
    let no_upstream_data = codebuf_offset(cb) as int
    cb = x86_emit_add_imm8(cb, X86_R14, 16)
    let upstream_data_ready = codebuf_offset(cb) as int
    cb = patch_rel32(cb, no_upstream_data - 4, upstream_data_ready)
    cb = x86_emit_mov_rr(cb, X86_RDI, X86_RBP)
    cb = x86_emit_add_imm8(cb, X86_RDI, 16)
    cb = x86_emit_mov_reg_mem(cb, X86_RAX, X86_RSP, 32)
    cb = x86_emit_test_rr(cb, X86_RAX, X86_RAX)
    cb = x86_emit_jne_rel32(cb, 0)
    let goto_db = codebuf_offset(cb) as int

    # dA[i,k] += sum_j G[i,j] * B[k,j]
    cb = x86_emit_xor_rr(cb, X86_R8, X86_R8)
    let da_i = codebuf_offset(cb) as int
    cb = x86_emit_mov_reg_mem(cb, X86_RAX, X86_RSP, 0)
    cb = x86_emit_cmp_rr(cb, X86_R8, X86_RAX)
    cb = x86_emit_jge_rel32(cb, 0)
    let da_i_exit = codebuf_offset(cb) as int
    cb = x86_emit_xor_rr(cb, X86_R9, X86_R9)
    let da_k = codebuf_offset(cb) as int
    cb = x86_emit_mov_reg_mem(cb, X86_RAX, X86_RSP, 8)
    cb = x86_emit_cmp_rr(cb, X86_R9, X86_RAX)
    cb = x86_emit_jge_rel32(cb, 0)
    let da_k_exit = codebuf_offset(cb) as int
    cb = x86_emit_mov_rr(cb, X86_R11, X86_R8)
    cb = x86_emit_imul_rr(cb, X86_R11, X86_RAX)
    cb = x86_emit_add_rr(cb, X86_R11, X86_R9)
    cb = x86_emit_shl_imm(cb, X86_R11, 2)
    cb = x86_emit_add_rr(cb, X86_R11, X86_RDI)
    cb = x86_emit_mov_reg_mem32(cb, X86_RAX, X86_R11, 0)
    cb = x86_emit_movd_xmm_gpr(cb, 0, X86_RAX)
    cb = x86_emit_xor_rr(cb, X86_R10, X86_R10)
    let da_j = codebuf_offset(cb) as int
    cb = x86_emit_mov_reg_mem(cb, X86_RAX, X86_RSP, 16)
    cb = x86_emit_cmp_rr(cb, X86_R10, X86_RAX)
    cb = x86_emit_jge_rel32(cb, 0)
    let da_j_exit = codebuf_offset(cb) as int
    cb = x86_emit_test_rr(cb, X86_R14, X86_R14)
    cb = x86_emit_je_rel32(cb, 0)
    let da_seed_one = codebuf_offset(cb) as int
    cb = x86_emit_mov_rr(cb, X86_R11, X86_R8)
    cb = x86_emit_imul_rr(cb, X86_R11, X86_RAX)
    cb = x86_emit_add_rr(cb, X86_R11, X86_R10)
    cb = x86_emit_shl_imm(cb, X86_R11, 2)
    cb = x86_emit_add_rr(cb, X86_R11, X86_R14)
    cb = x86_emit_mov_reg_mem32(cb, X86_RAX, X86_R11, 0)
    cb = x86_emit_movd_xmm_gpr(cb, 1, X86_RAX)
    cb = x86_emit_jmp_rel32(cb, 0)
    let da_seed_ready_jump = codebuf_offset(cb) as int
    let da_seed_one_pos = codebuf_offset(cb) as int
    cb = patch_rel32(cb, da_seed_one - 4, da_seed_one_pos)
    cb = x86_emit_mov_reg_imm32(cb, X86_RAX, 0x3F800000)
    cb = x86_emit_movd_xmm_gpr(cb, 1, X86_RAX)
    let da_seed_ready = codebuf_offset(cb) as int
    cb = patch_rel32(cb, da_seed_ready_jump - 4, da_seed_ready)
    cb = x86_emit_mov_rr(cb, X86_R11, X86_R9)
    cb = x86_emit_mov_reg_mem(cb, X86_RAX, X86_RSP, 16)
    cb = x86_emit_imul_rr(cb, X86_R11, X86_RAX)
    cb = x86_emit_add_rr(cb, X86_R11, X86_R10)
    cb = x86_emit_shl_imm(cb, X86_R11, 2)
    cb = x86_emit_add_rr(cb, X86_R11, X86_R13)
    cb = x86_emit_mov_reg_mem32(cb, X86_RAX, X86_R11, 0)
    cb = x86_emit_movd_xmm_gpr(cb, 2, X86_RAX)
    cb = x86_emit_mulss_xx(cb, 1, 2)
    cb = x86_emit_addss_xx(cb, 0, 1)
    cb = x86_emit_add_imm8(cb, X86_R10, 1)
    cb = x86_emit_jmp_rel32(cb, da_j - (codebuf_offset(cb) + 5))
    let da_j_done = codebuf_offset(cb) as int
    cb = patch_rel32(cb, da_j_exit - 4, da_j_done)
    cb = x86_emit_movd_gpr_xmm(cb, X86_RAX, 0)
    cb = x86_emit_mov_rr(cb, X86_R11, X86_R8)
    cb = x86_emit_mov_reg_mem(cb, X86_RCX, X86_RSP, 8)
    cb = x86_emit_imul_rr(cb, X86_R11, X86_RCX)
    cb = x86_emit_add_rr(cb, X86_R11, X86_R9)
    cb = x86_emit_shl_imm(cb, X86_R11, 2)
    cb = x86_emit_add_rr(cb, X86_R11, X86_RDI)
    cb = x86_emit_mov_mem_reg32(cb, X86_R11, 0, X86_RAX)
    cb = x86_emit_add_imm8(cb, X86_R9, 1)
    cb = x86_emit_jmp_rel32(cb, da_k - (codebuf_offset(cb) + 5))
    let da_k_done = codebuf_offset(cb) as int
    cb = patch_rel32(cb, da_k_exit - 4, da_k_done)
    cb = x86_emit_add_imm8(cb, X86_R8, 1)
    cb = x86_emit_jmp_rel32(cb, da_i - (codebuf_offset(cb) + 5))
    let da_i_done = codebuf_offset(cb) as int
    cb = patch_rel32(cb, da_i_exit - 4, da_i_done)
    cb = x86_emit_jmp_rel32(cb, 0)
    let da_return = codebuf_offset(cb) as int

    # dB[k,j] += sum_i A[i,k] * G[i,j]
    let db_start = codebuf_offset(cb) as int
    cb = patch_rel32(cb, goto_db - 4, db_start)
    cb = x86_emit_xor_rr(cb, X86_R8, X86_R8)
    let db_k = codebuf_offset(cb) as int
    cb = x86_emit_mov_reg_mem(cb, X86_RAX, X86_RSP, 8)
    cb = x86_emit_cmp_rr(cb, X86_R8, X86_RAX)
    cb = x86_emit_jge_rel32(cb, 0)
    let db_k_exit = codebuf_offset(cb) as int
    cb = x86_emit_xor_rr(cb, X86_R9, X86_R9)
    let db_j = codebuf_offset(cb) as int
    cb = x86_emit_mov_reg_mem(cb, X86_RAX, X86_RSP, 16)
    cb = x86_emit_cmp_rr(cb, X86_R9, X86_RAX)
    cb = x86_emit_jge_rel32(cb, 0)
    let db_j_exit = codebuf_offset(cb) as int
    cb = x86_emit_mov_rr(cb, X86_R11, X86_R8)
    cb = x86_emit_imul_rr(cb, X86_R11, X86_RAX)
    cb = x86_emit_add_rr(cb, X86_R11, X86_R9)
    cb = x86_emit_shl_imm(cb, X86_R11, 2)
    cb = x86_emit_add_rr(cb, X86_R11, X86_RDI)
    cb = x86_emit_mov_reg_mem32(cb, X86_RAX, X86_R11, 0)
    cb = x86_emit_movd_xmm_gpr(cb, 0, X86_RAX)
    cb = x86_emit_xor_rr(cb, X86_R10, X86_R10)
    let db_i = codebuf_offset(cb) as int
    cb = x86_emit_mov_reg_mem(cb, X86_RAX, X86_RSP, 0)
    cb = x86_emit_cmp_rr(cb, X86_R10, X86_RAX)
    cb = x86_emit_jge_rel32(cb, 0)
    let db_i_exit = codebuf_offset(cb) as int
    cb = x86_emit_mov_rr(cb, X86_R11, X86_R10)
    cb = x86_emit_mov_reg_mem(cb, X86_RAX, X86_RSP, 8)
    cb = x86_emit_imul_rr(cb, X86_R11, X86_RAX)
    cb = x86_emit_add_rr(cb, X86_R11, X86_R8)
    cb = x86_emit_shl_imm(cb, X86_R11, 2)
    cb = x86_emit_add_rr(cb, X86_R11, X86_R12)
    cb = x86_emit_mov_reg_mem32(cb, X86_RAX, X86_R11, 0)
    cb = x86_emit_movd_xmm_gpr(cb, 1, X86_RAX)
    cb = x86_emit_test_rr(cb, X86_R14, X86_R14)
    cb = x86_emit_je_rel32(cb, 0)
    let db_seed_one = codebuf_offset(cb) as int
    cb = x86_emit_mov_rr(cb, X86_R11, X86_R10)
    cb = x86_emit_mov_reg_mem(cb, X86_RAX, X86_RSP, 16)
    cb = x86_emit_imul_rr(cb, X86_R11, X86_RAX)
    cb = x86_emit_add_rr(cb, X86_R11, X86_R9)
    cb = x86_emit_shl_imm(cb, X86_R11, 2)
    cb = x86_emit_add_rr(cb, X86_R11, X86_R14)
    cb = x86_emit_mov_reg_mem32(cb, X86_RAX, X86_R11, 0)
    cb = x86_emit_movd_xmm_gpr(cb, 2, X86_RAX)
    cb = x86_emit_jmp_rel32(cb, 0)
    let db_seed_ready_jump = codebuf_offset(cb) as int
    let db_seed_one_pos = codebuf_offset(cb) as int
    cb = patch_rel32(cb, db_seed_one - 4, db_seed_one_pos)
    cb = x86_emit_mov_reg_imm32(cb, X86_RAX, 0x3F800000)
    cb = x86_emit_movd_xmm_gpr(cb, 2, X86_RAX)
    let db_seed_ready = codebuf_offset(cb) as int
    cb = patch_rel32(cb, db_seed_ready_jump - 4, db_seed_ready)
    cb = x86_emit_mulss_xx(cb, 1, 2)
    cb = x86_emit_addss_xx(cb, 0, 1)
    cb = x86_emit_add_imm8(cb, X86_R10, 1)
    cb = x86_emit_jmp_rel32(cb, db_i - (codebuf_offset(cb) + 5))
    let db_i_done = codebuf_offset(cb) as int
    cb = patch_rel32(cb, db_i_exit - 4, db_i_done)
    cb = x86_emit_movd_gpr_xmm(cb, X86_RAX, 0)
    cb = x86_emit_mov_rr(cb, X86_R11, X86_R8)
    cb = x86_emit_mov_reg_mem(cb, X86_RCX, X86_RSP, 16)
    cb = x86_emit_imul_rr(cb, X86_R11, X86_RCX)
    cb = x86_emit_add_rr(cb, X86_R11, X86_R9)
    cb = x86_emit_shl_imm(cb, X86_R11, 2)
    cb = x86_emit_add_rr(cb, X86_R11, X86_RDI)
    cb = x86_emit_mov_mem_reg32(cb, X86_R11, 0, X86_RAX)
    cb = x86_emit_add_imm8(cb, X86_R9, 1)
    cb = x86_emit_jmp_rel32(cb, db_j - (codebuf_offset(cb) + 5))
    let db_j_done = codebuf_offset(cb) as int
    cb = patch_rel32(cb, db_j_exit - 4, db_j_done)
    cb = x86_emit_add_imm8(cb, X86_R8, 1)
    cb = x86_emit_jmp_rel32(cb, db_k - (codebuf_offset(cb) + 5))
    let db_k_done = codebuf_offset(cb) as int
    cb = patch_rel32(cb, db_k_exit - 4, db_k_done)

    let return_pos = codebuf_offset(cb) as int
    cb = patch_rel32(cb, da_return - 4, return_pos)
    cb = patch_rel32(cb, no_upstream - 4, return_pos)
    cb = x86_emit_mov_rr(cb, X86_RAX, X86_RBP)
    cb = x86_emit_add_rsp_imm(cb, 64)
    cb = x86_emit_pop(cb, X86_R14)
    cb = x86_emit_pop(cb, X86_R13)
    cb = x86_emit_pop(cb, X86_R12)
    cb = x86_emit_pop(cb, X86_RBP)
    cb = x86_emit_pop(cb, X86_RBX)
    cb = x86_emit_ret(cb)

    let bad_pos = codebuf_offset(cb) as int
    cb = patch_rel32(cb, bad_dtype - 4, bad_pos)
    cb = x86_emit_mov_reg_imm32(cb, X86_RDI, 133)
    cb = x86_emit_mov_reg_imm32(cb, X86_RAX, X86_SYS_EXIT)
    cb = x86_emit_syscall(cb)
    out x86_emit_ret(cb)
end.

func emit_x86_quantize_elem_addr(cb: &CodeBuf):
    # in: RCX = index i, R12 = tensor base, RBP = elem_sz (2, 4, 8)
    # out: RDI = &tensor_elements[i], clobbers RAX
    cb = x86_emit_mov_rr(cb, X86_RDI, X86_RCX)
    cb = x86_emit_cmp_reg_imm32(cb, X86_RBP, 4)
    cb = x86_emit_jne_rel32(cb, 0)
    let fix_not4 = codebuf_offset(cb) as int
    cb = x86_emit_shl_imm(cb, X86_RDI, 2)
    cb = x86_emit_jmp_rel32(cb, 0)
    let fix_done1 = codebuf_offset(cb) as int

    let not4_pos = codebuf_offset(cb) as int
    cb = patch_rel32(cb, fix_not4 - 4, not4_pos)
    cb = x86_emit_cmp_reg_imm32(cb, X86_RBP, 2)
    cb = x86_emit_jne_rel32(cb, 0)
    let fix_not2 = codebuf_offset(cb) as int
    cb = x86_emit_shl_imm(cb, X86_RDI, 1)
    cb = x86_emit_jmp_rel32(cb, 0)
    let fix_done2 = codebuf_offset(cb) as int

    let not2_pos = codebuf_offset(cb) as int
    cb = patch_rel32(cb, fix_not2 - 4, not2_pos)
    cb = x86_emit_shl_imm(cb, X86_RDI, 3)

    let done_pos = codebuf_offset(cb) as int
    cb = patch_rel32(cb, fix_done1 - 4, done_pos)
    cb = patch_rel32(cb, fix_done2 - 4, done_pos)

    cb = x86_emit_add_rr(cb, X86_RDI, X86_R12)
    cb = x86_emit_mov_reg_imm32(cb, X86_RAX, 16)
    cb = x86_emit_add_rr(cb, X86_RDI, X86_RAX)
    out cb
end.

func emit_x86_quantize_elem_int(cb: &CodeBuf):
    # in: RDI = element address, RBP = elem_sz (2, 4, 8)
    # out: RAX = (int64)val, clobbers XMM0, XMM1, R9, R10, R11
    # Integer quantization accepts only finite values with abs(value) < 2^63.
    # Classify from IEEE bits before CVTT so invalid conversion never inherits
    # x86's indefinite-integer result.
    cb = x86_emit_cmp_reg_imm32(cb, X86_RBP, 4)
    cb = x86_emit_jne_rel32(cb, 0)
    let fix_not4 = codebuf_offset(cb) as int
    cb = x86_emit_mov_reg_mem32(cb, X86_RAX, X86_RDI, 0)
    cb = x86_emit_mov_rr(cb, X86_R11, X86_RAX)
    cb = x86_emit_mov_reg_imm32(cb, X86_R10, 0x7FFFFFFF)
    cb = x86_emit_and_rr(cb, X86_R11, X86_R10)
    cb = x86_emit_cmp_reg_imm32(cb, X86_R11, 0x5F000000)
    cb = x86_emit_jge_rel32(cb, 0)
    let fix_bad4 = codebuf_offset(cb) as int
    # f32 load: cvttss2si rax, [rdi]
    cb = codebuf_emit_byte(cb, 0xF3)
    cb = codebuf_emit_byte(cb, 0x48)
    cb = codebuf_emit_byte(cb, 0x0F)
    cb = codebuf_emit_byte(cb, 0x2C)
    cb = codebuf_emit_byte(cb, 0x07)
    cb = x86_emit_jmp_rel32(cb, 0)
    let fix_done1 = codebuf_offset(cb) as int

    let not4_pos = codebuf_offset(cb) as int
    cb = patch_rel32(cb, fix_not4 - 4, not4_pos)
    cb = x86_emit_cmp_reg_imm32(cb, X86_RBP, 2)
    cb = x86_emit_jne_rel32(cb, 0)
    let fix_not2 = codebuf_offset(cb) as int
    # f16 load: movzx word, f16_to_f32, cvttss2si (truncation toward zero)
    cb = x86_emit_xor_rr(cb, X86_RAX, X86_RAX)
    cb = x86_emit_mov_reg_mem16(cb, X86_RAX, X86_RDI, 0)
    cb = x86_emit_mov_rr(cb, X86_R11, X86_RAX)
    cb = x86_emit_mov_reg_imm32(cb, X86_R10, 0x7FFF)
    cb = x86_emit_and_rr(cb, X86_R11, X86_R10)
    cb = x86_emit_cmp_reg_imm32(cb, X86_R11, 0x7C00)
    cb = x86_emit_jge_rel32(cb, 0)
    let fix_bad2 = codebuf_offset(cb) as int
    cb = x86_emit_f16_to_f32(cb, X86_RAX, 0, X86_R9, X86_R10, 1)
    cb = x86_emit_cvttss2si_gx(cb, X86_RAX, 0)
    cb = x86_emit_jmp_rel32(cb, 0)
    let fix_done2 = codebuf_offset(cb) as int

    let not2_pos = codebuf_offset(cb) as int
    cb = patch_rel32(cb, fix_not2 - 4, not2_pos)
    cb = x86_emit_mov_reg_mem(cb, X86_RAX, X86_RDI, 0)
    cb = x86_emit_mov_rr(cb, X86_R11, X86_RAX)
    cb = x86_emit_mov_reg_imm64(cb, X86_R10, 0x7FFFFFFFFFFFFFFF)
    cb = x86_emit_and_rr(cb, X86_R11, X86_R10)
    cb = x86_emit_mov_reg_imm64(cb, X86_R10, 0x43E0000000000000)
    cb = x86_emit_cmp_rr(cb, X86_R11, X86_R10)
    cb = x86_emit_jge_rel32(cb, 0)
    let fix_bad8 = codebuf_offset(cb) as int
    # f64 load: cvttsd2si rax, [rdi]
    cb = codebuf_emit_byte(cb, 0xF2)
    cb = codebuf_emit_byte(cb, 0x48)
    cb = codebuf_emit_byte(cb, 0x0F)
    cb = codebuf_emit_byte(cb, 0x2C)
    cb = codebuf_emit_byte(cb, 0x07)
    cb = x86_emit_jmp_rel32(cb, 0)
    let fix_done3 = codebuf_offset(cb) as int

    let trap_pos = codebuf_offset(cb) as int
    # QEMU/binfmt can stall on guest UD2/INT3 delivery. Terminate through the
    # Linux syscall ABI with the same observable status as ARM64 BRK.
    cb = x86_emit_mov_reg_imm32(cb, X86_RDI, 133)
    cb = x86_emit_mov_reg_imm32(cb, X86_RAX, X86_SYS_EXIT)
    cb = x86_emit_syscall(cb)
    let done_pos = codebuf_offset(cb) as int
    cb = patch_rel32(cb, fix_done1 - 4, done_pos)
    cb = patch_rel32(cb, fix_done2 - 4, done_pos)
    cb = patch_rel32(cb, fix_done3 - 4, done_pos)
    cb = patch_rel32(cb, fix_bad4 - 4, trap_pos)
    cb = patch_rel32(cb, fix_bad2 - 4, trap_pos)
    cb = patch_rel32(cb, fix_bad8 - 4, trap_pos)
    out cb
end.

func emit_lir_rt_quantize_stub_x86(cb: &CodeBuf):
    cb = x86_emit_push(cb, X86_RBX)
    cb = x86_emit_push(cb, X86_RBP)
    cb = x86_emit_push(cb, X86_R12)
    cb = x86_emit_push(cb, X86_R13)
    cb = x86_emit_push(cb, X86_R14)

    cb = x86_emit_mov_rr(cb, X86_R12, X86_RDI)
    cb = x86_emit_mov_rr(cb, X86_R13, X86_RSI)
    cb = x86_emit_mov_rr(cb, X86_RBP, X86_RDX)

    # Validate elem_sz: if not 4 and not 2, default to 8
    cb = x86_emit_cmp_reg_imm32(cb, X86_RBP, 4)
    cb = x86_emit_je_rel32(cb, 0)
    let fixup_esz_4 = codebuf_offset(cb) as int
    cb = x86_emit_cmp_reg_imm32(cb, X86_RBP, 2)
    cb = x86_emit_je_rel32(cb, 0)
    let fixup_esz_2 = codebuf_offset(cb) as int
    cb = x86_emit_mov_reg_imm32(cb, X86_RBP, 8)
    let esz_done = codebuf_offset(cb) as int
    cb = patch_rel32(cb, fixup_esz_4 - 4, esz_done)
    cb = patch_rel32(cb, fixup_esz_2 - 4, esz_done)

    cb = x86_emit_mov_reg_mem(cb, X86_R14, X86_R12, 0)

    cb = x86_emit_cmp_reg_imm32(cb, X86_R14, 0)
    cb = x86_emit_jle_rel32(cb, 0)
    let fixup_ret_zero = codebuf_offset(cb) as int

    cb = x86_emit_mov_reg_imm32(cb, X86_RBX, 127)
    cb = x86_emit_cmp_reg_imm32(cb, X86_R13, 4)
    cb = x86_emit_jne_rel32(cb, 0)
    let fixup_not_4 = codebuf_offset(cb) as int
    cb = x86_emit_mov_reg_imm32(cb, X86_RBX, 7)
    let qmax_pos = codebuf_offset(cb) as int
    cb = patch_rel32(cb, fixup_not_4 - 4, qmax_pos)

    cb = x86_emit_cmp_reg_imm32(cb, X86_R13, 16)
    cb = x86_emit_jne_rel32(cb, 0)
    let fixup_not_16 = codebuf_offset(cb) as int
    cb = x86_emit_mov_reg_imm32(cb, X86_RBX, 32767)
    let qmax_pos16 = codebuf_offset(cb) as int
    cb = patch_rel32(cb, fixup_not_16 - 4, qmax_pos16)

    cb = x86_emit_cmp_reg_imm32(cb, X86_R13, 32)
    cb = x86_emit_jne_rel32(cb, 0)
    let fixup_not_32 = codebuf_offset(cb) as int
    cb = x86_emit_mov_reg_imm32(cb, X86_RBX, 2147483647)
    let qmax_pos32 = codebuf_offset(cb) as int
    cb = patch_rel32(cb, fixup_not_32 - 4, qmax_pos32)

    cb = x86_emit_xor_rr(cb, X86_R8, X86_R8)
    cb = x86_emit_xor_rr(cb, X86_RCX, X86_RCX)

    # Floating storage modes preserve IEEE values and always use scale 1.
    cb = x86_emit_cmp_reg_imm32(cb, X86_R13, 16)
    cb = x86_emit_je_rel32(cb, 0)
    let fixup_scale_skip16 = codebuf_offset(cb) as int
    cb = x86_emit_cmp_reg_imm32(cb, X86_R13, 32)
    cb = x86_emit_je_rel32(cb, 0)
    let fixup_scale_skip32 = codebuf_offset(cb) as int

    let loop_scale_start = codebuf_offset(cb) as int
    cb = x86_emit_cmp_rr(cb, X86_RCX, X86_R14)
    cb = x86_emit_jge_rel32(cb, 0)
    let fixup_scale_exit = codebuf_offset(cb) as int

    cb = emit_x86_quantize_elem_addr(cb)
    cb = emit_x86_quantize_elem_int(cb)

    cb = x86_emit_cmp_reg_imm32(cb, X86_RAX, 0)
    cb = x86_emit_jge_rel32(cb, 0)
    let fixup_non_neg = codebuf_offset(cb) as int
    cb = x86_emit_neg_r(cb, X86_RAX)
    let abs_done_pos = codebuf_offset(cb) as int
    cb = patch_rel32(cb, fixup_non_neg - 4, abs_done_pos)

    cb = x86_emit_cmp_rr(cb, X86_RAX, X86_R8)
    cb = x86_emit_jle_rel32(cb, 0)
    let fixup_not_max = codebuf_offset(cb) as int
    cb = x86_emit_mov_rr(cb, X86_R8, X86_RAX)
    let max_done_pos = codebuf_offset(cb) as int
    cb = patch_rel32(cb, fixup_not_max - 4, max_done_pos)

    cb = x86_emit_mov_reg_imm32(cb, X86_RAX, 1)
    cb = x86_emit_add_rr(cb, X86_RCX, X86_RAX)
    cb = x86_emit_jmp_rel32(cb, 0)
    let fixup_scale_loop = codebuf_offset(cb) as int
    cb = patch_rel32(cb, fixup_scale_loop - 4, loop_scale_start)

    let scale_done_pos = codebuf_offset(cb) as int
    cb = patch_rel32(cb, fixup_scale_exit - 4, scale_done_pos)
    cb = patch_rel32(cb, fixup_scale_skip16 - 4, scale_done_pos)
    cb = patch_rel32(cb, fixup_scale_skip32 - 4, scale_done_pos)

    # Scale in R8: if bits == 16 or bits == 32: scale = 1
    cb = x86_emit_cmp_reg_imm32(cb, X86_R13, 16)
    cb = x86_emit_je_rel32(cb, 0)
    let fixup_sc16 = codebuf_offset(cb) as int

    cb = x86_emit_cmp_reg_imm32(cb, X86_R13, 32)
    cb = x86_emit_je_rel32(cb, 0)
    let fixup_sc32 = codebuf_offset(cb) as int

    cb = x86_emit_cmp_rr(cb, X86_R8, X86_RBX)
    cb = x86_emit_jle_rel32(cb, 0)
    let fixup_scale_1 = codebuf_offset(cb) as int

    cb = x86_emit_mov_rr(cb, X86_RAX, X86_R8)
    cb = x86_emit_add_rr(cb, X86_RAX, X86_RBX)
    cb = x86_emit_mov_reg_imm32(cb, X86_RDX, 1)
    cb = x86_emit_sub_rr(cb, X86_RAX, X86_RDX)
    cb = x86_emit_cqo(cb)
    cb = x86_emit_idiv(cb, X86_RBX)
    cb = x86_emit_mov_rr(cb, X86_R8, X86_RAX)
    cb = x86_emit_jmp_rel32(cb, 0)
    let fixup_scale_calc_done = codebuf_offset(cb) as int

    let scale_1_pos = codebuf_offset(cb) as int
    cb = patch_rel32(cb, fixup_sc16 - 4, scale_1_pos)
    cb = patch_rel32(cb, fixup_sc32 - 4, scale_1_pos)
    cb = patch_rel32(cb, fixup_scale_1 - 4, scale_1_pos)
    cb = x86_emit_mov_reg_imm32(cb, X86_R8, 1)
    let scale_final_pos = codebuf_offset(cb) as int
    cb = patch_rel32(cb, fixup_scale_calc_done - 4, scale_final_pos)

    # Compute payload size in RAX based on bits (R13):
    cb = x86_emit_mov_rr(cb, X86_RAX, X86_R14)
    cb = x86_emit_cmp_reg_imm32(cb, X86_R13, 4)
    cb = x86_emit_jne_rel32(cb, 0)
    let fixup_alloc_not4 = codebuf_offset(cb) as int
    cb = x86_emit_mov_reg_imm32(cb, X86_RDX, 1)
    cb = x86_emit_add_rr(cb, X86_RAX, X86_RDX)
    cb = x86_emit_shr_imm(cb, X86_RAX, 1)
    let alloc_p_pos = codebuf_offset(cb) as int
    cb = patch_rel32(cb, fixup_alloc_not4 - 4, alloc_p_pos)

    cb = x86_emit_cmp_reg_imm32(cb, X86_R13, 16)
    cb = x86_emit_jne_rel32(cb, 0)
    let fixup_alloc_not16 = codebuf_offset(cb) as int
    cb = x86_emit_shl_imm(cb, X86_RAX, 1)
    let alloc_p_pos16 = codebuf_offset(cb) as int
    cb = patch_rel32(cb, fixup_alloc_not16 - 4, alloc_p_pos16)

    cb = x86_emit_cmp_reg_imm32(cb, X86_R13, 32)
    cb = x86_emit_jne_rel32(cb, 0)
    let fixup_alloc_not32 = codebuf_offset(cb) as int
    cb = x86_emit_shl_imm(cb, X86_RAX, 2)
    let alloc_p_pos32 = codebuf_offset(cb) as int
    cb = patch_rel32(cb, fixup_alloc_not32 - 4, alloc_p_pos32)

    cb = x86_emit_mov_reg_imm32(cb, X86_RDX, 47)
    cb = x86_emit_add_rr(cb, X86_RAX, X86_RDX)
    cb = x86_emit_mov_reg_imm32(cb, X86_RDX, 0 - 16)
    cb = x86_emit_and_rr(cb, X86_RAX, X86_RDX)

    cb = x86_emit_mov_reg_mem(cb, X86_RDI, X86_R15, 0)
    cb = x86_emit_mov_rr(cb, X86_RDX, X86_RDI)
    cb = x86_emit_add_rr(cb, X86_RDX, X86_RAX)
    cb = x86_emit_mov_mem_reg(cb, X86_R15, 0, X86_RDX)

    cb = x86_emit_mov_mem_reg(cb, X86_RDI, 0, X86_R14)
    cb = x86_emit_mov_mem_reg(cb, X86_RDI, 8, X86_R13)
    cb = x86_emit_mov_mem_reg(cb, X86_RDI, 16, X86_R8)
    cb = x86_emit_xor_rr(cb, X86_RAX, X86_RAX)
    cb = x86_emit_mov_mem_reg(cb, X86_RDI, 24, X86_RAX)

    cb = x86_emit_push(cb, X86_RDI)

    cb = x86_emit_mov_rr(cb, X86_RSI, X86_RDI)
    cb = x86_emit_mov_reg_imm32(cb, X86_RAX, 32)
    cb = x86_emit_add_rr(cb, X86_RSI, X86_RAX)

    cb = x86_emit_xor_rr(cb, X86_RCX, X86_RCX)

    cb = x86_emit_cmp_reg_imm32(cb, X86_R13, 4)
    cb = x86_emit_je_rel32(cb, 0)
    let fixup_goto_p4 = codebuf_offset(cb) as int

    cb = x86_emit_cmp_reg_imm32(cb, X86_R13, 16)
    cb = x86_emit_je_rel32(cb, 0)
    let fixup_goto_p16 = codebuf_offset(cb) as int

    cb = x86_emit_cmp_reg_imm32(cb, X86_R13, 32)
    cb = x86_emit_je_rel32(cb, 0)
    let fixup_goto_p32 = codebuf_offset(cb) as int

    # --- PACK INT8 LOOP ---
    let loop_p8_start = codebuf_offset(cb) as int
    cb = x86_emit_cmp_rr(cb, X86_RCX, X86_R14)
    cb = x86_emit_jge_rel32(cb, 0)
    let fixup_p8_exit = codebuf_offset(cb) as int

    cb = emit_x86_quantize_elem_addr(cb)
    cb = emit_x86_quantize_elem_int(cb)

    cb = x86_emit_cqo(cb)
    cb = x86_emit_idiv(cb, X86_R8)

    cb = x86_emit_cmp_reg_imm32(cb, X86_RAX, 127)
    cb = x86_emit_jle_rel32(cb, 0)
    let fixup_c8_up = codebuf_offset(cb) as int
    cb = x86_emit_mov_reg_imm32(cb, X86_RAX, 127)
    let c8_up_pos = codebuf_offset(cb) as int
    cb = patch_rel32(cb, fixup_c8_up - 4, c8_up_pos)

    cb = x86_emit_cmp_reg_imm32(cb, X86_RAX, 0 - 127)
    cb = x86_emit_jge_rel32(cb, 0)
    let fixup_c8_lo = codebuf_offset(cb) as int
    cb = x86_emit_mov_reg_imm32(cb, X86_RAX, 0 - 127)
    let c8_lo_pos = codebuf_offset(cb) as int
    cb = patch_rel32(cb, fixup_c8_lo - 4, c8_lo_pos)

    cb = x86_emit_mov_rr(cb, X86_RDI, X86_RSI)
    cb = x86_emit_add_rr(cb, X86_RDI, X86_RCX)
    cb = codebuf_emit_byte(cb, 0x88)
    cb = codebuf_emit_byte(cb, 0x07)

    cb = x86_emit_mov_reg_imm32(cb, X86_RAX, 1)
    cb = x86_emit_add_rr(cb, X86_RCX, X86_RAX)
    cb = x86_emit_jmp_rel32(cb, 0)
    let fixup_p8_back = codebuf_offset(cb) as int
    cb = patch_rel32(cb, fixup_p8_back - 4, loop_p8_start)

    let p8_exit_pos = codebuf_offset(cb) as int
    cb = patch_rel32(cb, fixup_p8_exit - 4, p8_exit_pos)
    cb = x86_emit_jmp_rel32(cb, 0)
    let fixup_p8_done = codebuf_offset(cb) as int

    # --- PACK INT4 LOOP ---
    let p4_target = codebuf_offset(cb) as int
    cb = patch_rel32(cb, fixup_goto_p4 - 4, p4_target)

    let loop_p4_start = codebuf_offset(cb) as int
    cb = x86_emit_cmp_rr(cb, X86_RCX, X86_R14)
    cb = x86_emit_jge_rel32(cb, 0)
    let fixup_p4_exit = codebuf_offset(cb) as int

    cb = emit_x86_quantize_elem_addr(cb)
    cb = emit_x86_quantize_elem_int(cb)

    cb = x86_emit_cqo(cb)
    cb = x86_emit_idiv(cb, X86_R8)

    cb = x86_emit_cmp_reg_imm32(cb, X86_RAX, 7)
    cb = x86_emit_jle_rel32(cb, 0)
    let fixup_c4_up = codebuf_offset(cb) as int
    cb = x86_emit_mov_reg_imm32(cb, X86_RAX, 7)
    let c4_up_pos = codebuf_offset(cb) as int
    cb = patch_rel32(cb, fixup_c4_up - 4, c4_up_pos)

    cb = x86_emit_cmp_reg_imm32(cb, X86_RAX, 0 - 7)
    cb = x86_emit_jge_rel32(cb, 0)
    let fixup_c4_lo = codebuf_offset(cb) as int
    cb = x86_emit_mov_reg_imm32(cb, X86_RAX, 0 - 7)
    let c4_lo_pos = codebuf_offset(cb) as int
    cb = patch_rel32(cb, fixup_c4_lo - 4, c4_lo_pos)

    cb = x86_emit_mov_reg_imm32(cb, X86_RDX, 15)
    cb = x86_emit_and_rr(cb, X86_RAX, X86_RDX)

    cb = x86_emit_mov_rr(cb, X86_RDI, X86_RCX)
    cb = x86_emit_shr_imm(cb, X86_RDI, 1)
    cb = x86_emit_add_rr(cb, X86_RDI, X86_RSI)

    cb = x86_emit_mov_rr(cb, X86_RDX, X86_RCX)
    cb = x86_emit_and_imm8(cb, X86_RDX, 1)
    cb = x86_emit_test_rr(cb, X86_RDX, X86_RDX)
    cb = x86_emit_jne_rel32(cb, 0)
    let fixup_p4_odd = codebuf_offset(cb) as int

    # Even: store low nibble at [RDI]
    cb = codebuf_emit_byte(cb, 0x88)
    cb = codebuf_emit_byte(cb, 0x07)
    cb = x86_emit_jmp_rel32(cb, 0)
    let fixup_p4_even_done = codebuf_offset(cb) as int

    # Odd: read byte, or with (al << 4), store back
    let p4_odd_pos = codebuf_offset(cb) as int
    cb = patch_rel32(cb, fixup_p4_odd - 4, p4_odd_pos)
    cb = x86_emit_movzx_reg_mem8(cb, X86_RDX, X86_RDI, 0)
    cb = x86_emit_shl_imm(cb, X86_RAX, 4)
    cb = x86_emit_or_rr(cb, X86_RDX, X86_RAX)
    cb = codebuf_emit_byte(cb, 0x88)
    cb = codebuf_emit_byte(cb, 0x17)

    let p4_even_done_pos = codebuf_offset(cb) as int
    cb = patch_rel32(cb, fixup_p4_even_done - 4, p4_even_done_pos)

    cb = x86_emit_mov_reg_imm32(cb, X86_RAX, 1)
    cb = x86_emit_add_rr(cb, X86_RCX, X86_RAX)
    cb = x86_emit_jmp_rel32(cb, 0)
    let fixup_p4_back = codebuf_offset(cb) as int
    cb = patch_rel32(cb, fixup_p4_back - 4, loop_p4_start)

    let p4_exit_pos = codebuf_offset(cb) as int
    cb = patch_rel32(cb, fixup_p4_exit - 4, p4_exit_pos)
    cb = x86_emit_jmp_rel32(cb, 0)
    let fixup_p4_done = codebuf_offset(cb) as int

    # --- PACK F16 LOOP ---
    let p16_target = codebuf_offset(cb) as int
    cb = patch_rel32(cb, fixup_goto_p16 - 4, p16_target)

    let loop_p16_start = codebuf_offset(cb) as int
    cb = x86_emit_cmp_rr(cb, X86_RCX, X86_R14)
    cb = x86_emit_jge_rel32(cb, 0)
    let fixup_p16_exit = codebuf_offset(cb) as int

    cb = emit_x86_quantize_elem_addr(cb)

    cb = x86_emit_cmp_reg_imm32(cb, X86_RBP, 2)
    cb = x86_emit_jne_rel32(cb, 0)
    let fixup_p16_l_not2 = codebuf_offset(cb) as int
    cb = x86_emit_xor_rr(cb, X86_RAX, X86_RAX)
    cb = x86_emit_mov_reg_mem16(cb, X86_RAX, X86_RDI, 0)
    cb = x86_emit_jmp_rel32(cb, 0)
    let fixup_p16_l_done1 = codebuf_offset(cb) as int

    let p16_l_not2_pos = codebuf_offset(cb) as int
    cb = patch_rel32(cb, fixup_p16_l_not2 - 4, p16_l_not2_pos)
    cb = x86_emit_cmp_reg_imm32(cb, X86_RBP, 4)
    cb = x86_emit_jne_rel32(cb, 0)
    let fixup_p16_l_not4 = codebuf_offset(cb) as int
    cb = x86_emit_mov_reg_mem32(cb, X86_RAX, X86_RDI, 0)
    cb = x86_emit_movd_xmm_gpr(cb, 0, X86_RAX)
    cb = x86_emit_float_to_f16(cb, 0, 0, X86_RAX, X86_R9, X86_R10, 1)
    cb = x86_emit_jmp_rel32(cb, 0)
    let fixup_p16_l_done2 = codebuf_offset(cb) as int

    let p16_l_not4_pos = codebuf_offset(cb) as int
    cb = patch_rel32(cb, fixup_p16_l_not4 - 4, p16_l_not4_pos)
    cb = x86_emit_mov_reg_mem(cb, X86_RAX, X86_RDI, 0)
    cb = x86_emit_movq_xmm_gpr(cb, 0, X86_RAX)
    cb = x86_emit_float_to_f16(cb, 1, 0, X86_RAX, X86_R9, X86_R10, 1)

    let p16_l_done_pos = codebuf_offset(cb) as int
    cb = patch_rel32(cb, fixup_p16_l_done1 - 4, p16_l_done_pos)
    cb = patch_rel32(cb, fixup_p16_l_done2 - 4, p16_l_done_pos)

    cb = x86_emit_mov_rr(cb, X86_RDX, X86_RCX)
    cb = x86_emit_shl_imm(cb, X86_RDX, 1)
    cb = x86_emit_add_rr(cb, X86_RDX, X86_RSI)
    cb = x86_emit_mov_mem_reg16(cb, X86_RDX, 0, X86_RAX)

    cb = x86_emit_mov_reg_imm32(cb, X86_RAX, 1)
    cb = x86_emit_add_rr(cb, X86_RCX, X86_RAX)
    cb = x86_emit_jmp_rel32(cb, 0)
    let fixup_p16_back = codebuf_offset(cb) as int
    cb = patch_rel32(cb, fixup_p16_back - 4, loop_p16_start)

    let p16_exit_pos = codebuf_offset(cb) as int
    cb = patch_rel32(cb, fixup_p16_exit - 4, p16_exit_pos)
    cb = x86_emit_jmp_rel32(cb, 0)
    let fixup_p16_done = codebuf_offset(cb) as int

    # --- PACK F32 LOOP ---
    let p32_target = codebuf_offset(cb) as int
    cb = patch_rel32(cb, fixup_goto_p32 - 4, p32_target)

    let loop_p32_start = codebuf_offset(cb) as int
    cb = x86_emit_cmp_rr(cb, X86_RCX, X86_R14)
    cb = x86_emit_jge_rel32(cb, 0)
    let fixup_p32_exit = codebuf_offset(cb) as int

    cb = emit_x86_quantize_elem_addr(cb)

    cb = x86_emit_cmp_reg_imm32(cb, X86_RBP, 4)
    cb = x86_emit_jne_rel32(cb, 0)
    let fixup_p32_l_not4 = codebuf_offset(cb) as int
    cb = x86_emit_mov_reg_mem32(cb, X86_RAX, X86_RDI, 0)
    cb = x86_emit_jmp_rel32(cb, 0)
    let fixup_p32_l_done1 = codebuf_offset(cb) as int

    let p32_l_not4_pos = codebuf_offset(cb) as int
    cb = patch_rel32(cb, fixup_p32_l_not4 - 4, p32_l_not4_pos)
    cb = x86_emit_cmp_reg_imm32(cb, X86_RBP, 2)
    cb = x86_emit_jne_rel32(cb, 0)
    let fixup_p32_l_not2 = codebuf_offset(cb) as int
    cb = x86_emit_xor_rr(cb, X86_RAX, X86_RAX)
    cb = x86_emit_mov_reg_mem16(cb, X86_RAX, X86_RDI, 0)
    cb = x86_emit_f16_to_f32(cb, X86_RAX, 0, X86_R9, X86_R10, 1)
    cb = x86_emit_movd_gpr_xmm(cb, X86_RAX, 0)
    cb = x86_emit_jmp_rel32(cb, 0)
    let fixup_p32_l_done2 = codebuf_offset(cb) as int

    let p32_l_not2_pos = codebuf_offset(cb) as int
    cb = patch_rel32(cb, fixup_p32_l_not2 - 4, p32_l_not2_pos)
    cb = x86_emit_mov_reg_mem(cb, X86_RAX, X86_RDI, 0)
    cb = x86_emit_movq_xmm_gpr(cb, 0, X86_RAX)
    cb = x86_emit_cvtsd2ss_xx(cb, 0, 0)
    cb = x86_emit_movd_gpr_xmm(cb, X86_RAX, 0)

    let p32_l_done_pos = codebuf_offset(cb) as int
    cb = patch_rel32(cb, fixup_p32_l_done1 - 4, p32_l_done_pos)
    cb = patch_rel32(cb, fixup_p32_l_done2 - 4, p32_l_done_pos)

    cb = x86_emit_mov_rr(cb, X86_RDX, X86_RCX)
    cb = x86_emit_shl_imm(cb, X86_RDX, 2)
    cb = x86_emit_add_rr(cb, X86_RDX, X86_RSI)
    cb = x86_emit_mov_mem_reg32(cb, X86_RDX, 0, X86_RAX)

    cb = x86_emit_mov_reg_imm32(cb, X86_RAX, 1)
    cb = x86_emit_add_rr(cb, X86_RCX, X86_RAX)
    cb = x86_emit_jmp_rel32(cb, 0)
    let fixup_p32_back = codebuf_offset(cb) as int
    cb = patch_rel32(cb, fixup_p32_back - 4, loop_p32_start)

    let p32_exit_pos = codebuf_offset(cb) as int
    cb = patch_rel32(cb, fixup_p32_exit - 4, p32_exit_pos)

    let done_all_pos = codebuf_offset(cb) as int
    cb = patch_rel32(cb, fixup_p8_done - 4, done_all_pos)
    cb = patch_rel32(cb, fixup_p4_done - 4, done_all_pos)
    cb = patch_rel32(cb, fixup_p16_done - 4, done_all_pos)

    cb = x86_emit_pop(cb, X86_RAX)
    cb = x86_emit_pop(cb, X86_R14)
    cb = x86_emit_pop(cb, X86_R13)
    cb = x86_emit_pop(cb, X86_R12)
    cb = x86_emit_pop(cb, X86_RBP)
    cb = x86_emit_pop(cb, X86_RBX)
    cb = x86_emit_ret(cb)

    let ret_zero_pos = codebuf_offset(cb) as int
    cb = patch_rel32(cb, fixup_ret_zero - 4, ret_zero_pos)
    cb = x86_emit_xor_rr(cb, X86_RAX, X86_RAX)
    cb = x86_emit_pop(cb, X86_R14)
    cb = x86_emit_pop(cb, X86_R13)
    cb = x86_emit_pop(cb, X86_R12)
    cb = x86_emit_pop(cb, X86_RBP)
    cb = x86_emit_pop(cb, X86_RBX)
    out x86_emit_ret(cb)
end.
