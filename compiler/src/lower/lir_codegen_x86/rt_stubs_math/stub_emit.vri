##
 * compiler/src/lower/lir_codegen_x86/rt_stubs_math/stub_emit.vri — runtime-stub emission driver
 * VIRC-PLN-0009: extracted verbatim from compiler/src/lower/lir_codegen_x86/rt_stubs_math.vri.
 ##

include types_prelude
include rt_vec_rt
include rt_string_rt
include codegen
include lir_codegen_x86_types
include lir_codegen_x86_intrinsics
include lir_codegen_x86_calls
include lir_codegen_x86_rt_stubs_base

func emit_lir_rt_stubs_x86(cb: &CodeBuf, offs: i64, vir_free_off: i64, rt_promote_graph_off: i64):
    var k = 0
    when k < LIR_RT_STUB_COUNT loop
        offs = vec_push_rt(offs, codebuf_offset(cb) as i64)
        if k == LIR_RT_UNRESOLVED do
            cb = x86_emit_mov_reg_imm64(cb, X86_RDI, 1)
            cb = x86_emit_mov_reg_imm64(cb, X86_RAX, X86_SYS_EXIT)
            cb = x86_emit_syscall(cb)
        eif k == MIR_INTR_PRINT do
            cb = emit_lir_rt_print_stub_x86(cb)
        eif k == LIR_RT_PRINT_STR do
            # RDI = string pointer. Save to RSI and RCX
            cb = x86_emit_mov_rr(cb, X86_RSI, X86_RDI)
            cb = x86_emit_mov_rr(cb, X86_RCX, X86_RDI)
            # Count length in bytes until null terminator
            cb = codebuf_emit_byte(cb, 0x80)
            cb = codebuf_emit_byte(cb, 0x39)
            cb = codebuf_emit_byte(cb, 0x00)
            cb = codebuf_emit_byte(cb, 0x74)
            cb = codebuf_emit_byte(cb, 0x05)
            cb = codebuf_emit_byte(cb, 0x48)
            cb = codebuf_emit_byte(cb, 0xFF)
            cb = codebuf_emit_byte(cb, 0xC1)
            cb = codebuf_emit_byte(cb, 0xEB)
            cb = codebuf_emit_byte(cb, 0xF6)
            # RDX = len = RCX - RSI
            cb = x86_emit_mov_rr(cb, X86_RDX, X86_RCX)
            cb = x86_emit_sub_rr(cb, X86_RDX, X86_RSI)
            cb = x86_emit_mov_reg_imm64(cb, X86_RAX, X86_SYS_WRITE)
            cb = x86_emit_mov_reg_imm64(cb, X86_RDI, 1)
            cb = x86_emit_syscall(cb)
            # Emit newline \n:
            cb = codebuf_emit_byte(cb, 0x6A)
            cb = codebuf_emit_byte(cb, 0x0A)
            cb = x86_emit_mov_rr(cb, X86_RSI, X86_RSP)
            cb = x86_emit_mov_reg_imm64(cb, X86_RDX, 1)
            cb = x86_emit_mov_reg_imm64(cb, X86_RDI, 1)
            cb = x86_emit_mov_reg_imm64(cb, X86_RAX, X86_SYS_WRITE)
            cb = x86_emit_syscall(cb)
            cb = x86_emit_pop(cb, SCR as int)
            cb = x86_emit_ret(cb)
        eif k == LIR_RT_STR_EQ do
            let eq_loop = codebuf_offset(cb) as int
            cb = x86_emit_movzx_reg_mem8(cb, X86_RAX, X86_RDI, 0)
            cb = x86_emit_movzx_reg_mem8(cb, X86_RDX, X86_RSI, 0)
            cb = x86_emit_cmp_rr(cb, X86_RAX, X86_RDX)
            cb = x86_emit_jne_rel32(cb, 0)
            let eq_false_fixup = codebuf_offset(cb) as int
            cb = x86_emit_test_rr(cb, X86_RAX, X86_RAX)
            cb = x86_emit_je_rel32(cb, 0)
            let eq_true_fixup = codebuf_offset(cb) as int
            cb = x86_emit_mov_reg_imm32(cb, X86_RCX, 1)
            cb = x86_emit_add_rr(cb, X86_RDI, X86_RCX)
            cb = x86_emit_add_rr(cb, X86_RSI, X86_RCX)
            cb = x86_emit_jmp_rel32(cb, 0)
            let eq_loop_fixup = codebuf_offset(cb) as int
            cb = patch_rel32(cb, eq_loop_fixup - 4, eq_loop)
            let eq_false = codebuf_offset(cb) as int
            cb = x86_emit_xor_rr(cb, X86_RAX, X86_RAX)
            cb = x86_emit_ret(cb)
            let eq_true = codebuf_offset(cb) as int
            cb = x86_emit_mov_reg_imm32(cb, X86_RAX, 1)
            cb = x86_emit_ret(cb)
            cb = patch_rel32(cb, eq_false_fixup - 4, eq_false)
            cb = patch_rel32(cb, eq_true_fixup - 4, eq_true)
        eif k == LIR_RT_ARG_COUNT do
            # The ELF entry stores argc in the arena runtime header.
            cb = x86_emit_mov_reg_mem(cb, X86_RAX, X86_R15, 8)
            cb = x86_emit_ret(cb)
        eif k == LIR_RT_GET_ARG do
            # RDI = zero-based argument index. Reject negative and out-of-range
            # indexes before loading argv[index] from the runtime header.
            cb = x86_emit_cmp_reg_imm32(cb, X86_RDI, 0)
            cb = x86_emit_jl_rel32(cb, 0)
            let argNegativeFixup = codebuf_offset(cb) as int

            cb = x86_emit_mov_reg_mem(cb, X86_RCX, X86_R15, 8)
            cb = x86_emit_cmp_rr(cb, X86_RDI, X86_RCX)
            cb = x86_emit_jge_rel32(cb, 0)
            let argRangeFixup = codebuf_offset(cb) as int

            cb = x86_emit_mov_reg_mem(cb, X86_RAX, X86_R15, 16)
            cb = x86_emit_mov_rr(cb, X86_RCX, X86_RDI)
            cb = x86_emit_shl_imm(cb, X86_RCX, 3)
            cb = x86_emit_add_rr(cb, X86_RAX, X86_RCX)
            cb = x86_emit_mov_reg_mem(cb, X86_RAX, X86_RAX, 0)
            cb = x86_emit_ret(cb)

            let argNull = codebuf_offset(cb) as int
            cb = x86_emit_xor_rr(cb, X86_RAX, X86_RAX)
            cb = x86_emit_ret(cb)
            cb = patch_rel32(cb, argNegativeFixup - 4, argNull)
            cb = patch_rel32(cb, argRangeFixup - 4, argNull)
        eif k == LIR_RT_ALLOC do
            # RDI = requested size, R15 = pointer to bump_curr
            cb = x86_emit_cmp_imm0(cb, X86_RDI)
            cb = x86_emit_jne_rel32(cb, 0)
            let non_zero_fixup = codebuf_offset(cb) as int
            cb = x86_emit_mov_reg_mem(cb, X86_RAX, X86_R15, 0)
            cb = x86_emit_ret(cb)
            let non_zero_lbl = codebuf_offset(cb) as int
            cb = patch_rel32(cb, non_zero_fixup - 4, non_zero_lbl)

            cb = x86_emit_mov_reg_mem(cb, X86_RAX, X86_R15, 0)
            cb = x86_emit_mov_rr(cb, X86_RSI, X86_RDI)
            cb = x86_emit_add_imm8(cb, X86_RSI, 31)
            cb = x86_emit_and_imm8(cb, X86_RSI, 0xF0)
            cb = x86_emit_mov_rr(cb, X86_RDX, X86_RAX)
            cb = x86_emit_add_rr(cb, X86_RDX, X86_RSI)
            cb = x86_emit_mov_reg_mem(cb, SCR as int, X86_R15, 24)
            cb = x86_emit_test_rr(cb, SCR as int, SCR as int)
            cb = x86_emit_je_rel32(cb, 0)
            let skip_cap_fixup = codebuf_offset(cb) as int
            cb = x86_emit_cmp_rr(cb, X86_RDX, SCR as int)
            cb = x86_emit_jle_rel32(cb, 0)
            let fits_fixup = codebuf_offset(cb) as int
            cb = codebuf_emit_byte(cb, 0x0F)
            cb = codebuf_emit_byte(cb, 0x0B)
            let fits_lbl = codebuf_offset(cb) as int
            cb = patch_rel32(cb, fits_fixup - 4, fits_lbl)
            cb = patch_rel32(cb, skip_cap_fixup - 4, fits_lbl)
            cb = x86_emit_mov_mem_reg(cb, X86_RAX, 0, X86_RSI)
            cb = x86_emit_mov_reg_imm32(cb, SCR as int, 1)
            cb = x86_emit_mov_mem_reg(cb, X86_RAX, 8, SCR as int)
            cb = x86_emit_mov_mem_reg(cb, X86_R15, 0, X86_RDX)
            cb = x86_emit_add_imm8(cb, X86_RAX, 16)
            cb = x86_emit_ret(cb)
        eif k == LIR_RT_FREE do
            # RDI = pointer to free
            cb = x86_emit_cmp_imm0(cb, X86_RDI)
            cb = x86_emit_je_rel32(cb, 0)
            let null_fixup = codebuf_offset(cb) as int

            cb = x86_emit_cmp_rr(cb, X86_RDI, X86_R15)
            cb = x86_emit_jl_rel32(cb, 0)
            let below_arena_fixup = codebuf_offset(cb) as int

            cb = x86_emit_mov_reg_mem(cb, X86_RSI, X86_R15, 0)
            cb = x86_emit_cmp_rr(cb, X86_RDI, X86_RSI)
            cb = x86_emit_jge_rel32(cb, 0)
            let above_arena_fixup = codebuf_offset(cb) as int

            cb = x86_emit_mov_reg_imm32(cb, SCR as int, 16)
            cb = x86_emit_sub_rr(cb, X86_RDI, SCR as int)
            cb = x86_emit_mov_reg_mem(cb, X86_RDX, X86_RDI, 0)
            cb = x86_emit_mov_reg_imm32(cb, SCR as int, 0)
            cb = x86_emit_mov_mem_reg(cb, X86_RDI, 8, SCR as int)
            cb = x86_emit_mov_rr(cb, X86_RAX, X86_RDI)
            cb = x86_emit_add_rr(cb, X86_RAX, X86_RDX)
            cb = x86_emit_cmp_rr(cb, X86_RAX, X86_RSI)
            cb = x86_emit_jne_rel32(cb, 0)
            let no_rewind_fixup = codebuf_offset(cb) as int

            cb = x86_emit_mov_mem_reg(cb, X86_R15, 0, X86_RDI)

            let end_off = codebuf_offset(cb) as int
            cb = patch_rel32(cb, no_rewind_fixup - 4, end_off)
            cb = patch_rel32(cb, null_fixup - 4, end_off)
            cb = x86_emit_ret(cb)

            let heap_free_target = codebuf_offset(cb) as int
            if vir_free_off >= 0 do
                cb = x86_emit_jmp_rel32(cb, 0)
                let jmp_site = codebuf_offset(cb) as int
                cb = patch_rel32(cb, jmp_site - 4, vir_free_off as int)
            else
                # No general heap owner is available for this non-arena
                # pointer. Exit with the allocator trap code instead of
                # silently accepting a leaking free.
                cb = x86_emit_mov_reg_imm64(cb, X86_RDI, 134)
                cb = x86_emit_mov_reg_imm64(cb, X86_RAX, X86_SYS_EXIT)
                cb = x86_emit_syscall(cb)
            end

            cb = patch_rel32(cb, below_arena_fixup - 4, heap_free_target)
            cb = patch_rel32(cb, above_arena_fixup - 4, heap_free_target)
        eif k == LIR_RT_NATIVE_READ_I64 do
            cb = x86_emit_add_rr(cb, X86_RDI, X86_RSI)
            cb = x86_emit_mov_reg_mem(cb, X86_RAX, X86_RDI, 0)
            cb = x86_emit_ret(cb)
        eif k == LIR_RT_NATIVE_WRITE_I64 do
            cb = x86_emit_add_rr(cb, X86_RDI, X86_RSI)
            cb = x86_emit_mov_mem_reg(cb, X86_RDI, 0, X86_RDX)
            cb = x86_emit_ret(cb)
        eif k == LIR_RT_NATIVE_READ_U8 do
            cb = x86_emit_add_rr(cb, X86_RDI, X86_RSI)
            cb = x86_emit_xor_rr(cb, X86_RAX, X86_RAX)
            cb = codebuf_emit_byte(cb, 0x0F)
            cb = codebuf_emit_byte(cb, 0xB6)
            cb = codebuf_emit_byte(cb, 0x07)
            cb = x86_emit_ret(cb)
        eif k == LIR_RT_NATIVE_WRITE_U8 do
            cb = x86_emit_add_rr(cb, X86_RDI, X86_RSI)
            cb = codebuf_emit_byte(cb, 0x88)
            cb = codebuf_emit_byte(cb, 0x17)
            cb = x86_emit_ret(cb)
        eif k == LIR_RT_MATMUL or k == LIR_RT_FMA do
            cb = emit_lir_rt_tensor_dot_stub_x86(cb)
        eif k == LIR_RT_STR_CAT do
            cb = emit_lir_rt_str_cat_stub_x86(cb)
        eif k == LIR_RT_INT_TO_STR do
            cb = emit_lir_rt_int_to_str_stub_x86(cb)
        eif k == LIR_RT_BOOL_TO_STR do
            cb = emit_lir_rt_bool_to_str_stub_x86(cb)
        eif k == LIR_RT_POW do
            cb = x86_emit_cmp_reg_imm32(cb, X86_RSI, 0)
            nonneg_disp = codebuf_offset(cb) + 2
            cb = x86_emit_jge_rel32(cb, 0)
            cb = x86_emit_neg_r(cb, X86_RSI)
            cb = x86_emit_mov_reg_imm32(cb, X86_RAX, 1)
            neg_loop_at = codebuf_offset(cb)
            cb = x86_emit_cmp_reg_imm32(cb, X86_RSI, 0)
            neg_done_disp = codebuf_offset(cb) + 2
            cb = x86_emit_je_rel32(cb, 0)
            cb = x86_emit_imul_rr(cb, X86_RAX, X86_RDI)
            cb = x86_emit_mov_reg_imm32(cb, X86_RDX, 1)
            cb = x86_emit_sub_rr(cb, X86_RSI, X86_RDX)
            cb = x86_emit_jmp_rel32(cb, neg_loop_at - (codebuf_offset(cb) + 5))
            neg_done_at = codebuf_offset(cb)
            cb = codebuf_patch_i32(cb, neg_done_disp, neg_done_at - (neg_done_disp + 4))
            cb = x86_emit_cvtsi2sd_xg(cb, 0, X86_RAX)
            cb = x86_emit_mov_reg_imm64(cb, X86_RDX, 4607182418800017408)
            cb = x86_emit_movq_xmm_gpr(cb, 1, X86_RDX)
            cb = x86_emit_divsd_xx(cb, 1, 0)
            cb = x86_emit_movq_gpr_xmm(cb, X86_RAX, 1)
            cb = x86_emit_ret(cb)
            nonneg_at = codebuf_offset(cb)
            cb = codebuf_patch_i32(cb, nonneg_disp, nonneg_at - (nonneg_disp + 4))
            cb = x86_emit_mov_reg_imm32(cb, X86_RAX, 1)
            loop_at = codebuf_offset(cb)
            cb = x86_emit_cmp_reg_imm32(cb, X86_RSI, 0)
            je_disp = codebuf_offset(cb) + 2
            cb = x86_emit_je_rel32(cb, 0)
            cb = x86_emit_imul_rr(cb, X86_RAX, X86_RDI)
            # decrement exponent without clobbering the base
            cb = x86_emit_mov_reg_imm32(cb, X86_RDX, 1)
            cb = x86_emit_sub_rr(cb, X86_RSI, X86_RDX)
            cb = x86_emit_jmp_rel32(cb, loop_at - (codebuf_offset(cb) + 5))
            end_at = codebuf_offset(cb)
            cb = codebuf_patch_i32(cb, je_disp, end_at - (je_disp + 4))
            cb = x86_emit_ret(cb)
        eif k == LIR_RT_QUANTIZE do
            cb = emit_lir_rt_quantize_stub_x86(cb)
        eif k == LIR_RT_BACKWARD do
            cb = emit_lir_rt_backward_stub_x86(cb)
        eif k == LIR_RT_MATMUL_F64 or k == LIR_RT_FMA_F64 do
            cb = emit_lir_rt_matmul_f64_stub_x86(cb)
        eif k == LIR_RT_MATMUL_QUANTIZED do
            cb = emit_lir_rt_matmul_quantized_stub_x86(cb)
        eif k == LIR_RT_SYSCALL do
            # syscallN(num, a0, a1, a2, a3, a4, a5)
            # On entry (System V x86-64 ABI): RDI=num, RSI=a0, RDX=a1, RCX=a2, R8=a3, R9=a4, 8(%rsp)=a5
            # Linux syscall: RAX=num, RDI=a0, RSI=a1, RDX=a2, R10=a3, R8=a4, R9=a5
            cb = x86_emit_mov_rr(cb, X86_R10, X86_R8)         # R10 = a3 (from R8)
            cb = x86_emit_mov_rr(cb, X86_R8, X86_R9)          # R8  = a4 (from R9)
            cb = x86_emit_mov_reg_mem(cb, X86_R9, X86_RSP, 8) # R9  = a5 (from 8(%rsp))
            cb = x86_emit_mov_rr(cb, X86_RAX, X86_RDI)        # RAX = num
            cb = x86_emit_mov_rr(cb, X86_RDI, X86_RSI)        # RDI = a0
            cb = x86_emit_mov_rr(cb, X86_RSI, X86_RDX)        # RSI = a1
            cb = x86_emit_mov_rr(cb, X86_RDX, X86_RCX)        # RDX = a2
            cb = x86_emit_syscall(cb)
            cb = x86_emit_ret(cb)
        eif k == LIR_RT_PLATFORM do
            cb = x86_emit_mov_reg_imm32(cb, X86_RAX, 3) # Platform.Linux_x86_64
            cb = x86_emit_ret(cb)
        eif k == LIR_RT_EXIT_PROG do
            # RDI = exit code; Linux x86_64 SYS_exit_group = 231
            cb = x86_emit_mov_reg_imm64(cb, X86_RAX, 231)
            cb = x86_emit_syscall(cb)
        eif k == LIR_RT_PROMOTE_GRAPH do
            if rt_promote_graph_off >= 0 do
                cb = x86_emit_jmp_rel32(cb, 0)
                let jmp_site = codebuf_offset(cb) as int
                cb = patch_rel32(cb, jmp_site - 4, rt_promote_graph_off as int)
            else
                cb = emit_lir_rt_promote_stub_x86(cb)
            end
        else
            cb = x86_emit_ret(cb)
        end
        k = k + 1
    end
    out cb
end.
