##
 * compiler/src/lower/lir_codegen_x86/intrinsics.vri — x86-64 Intrinsic Instruction Emitters
 * =========================================================================================
 ##

include types_prelude
include rt_vec_rt
include rt_string_rt
include codegen
include lir_codegen_x86_types

func emit_lir_intrinsic_x86(cb: &CodeBuf, ins: LirInstr, rd: i64, rs1: i64, assigned_phys: i64, call_fixups: i64, func_obj: &LirFunc, str_fixups: i64, recent_setargs: i64, lir_funcs: i64):
    kind = native_read_i64(ins as i64, 40)
    ins_dst = native_read_i64(ins as i64, 16) as LirOperand
    ins_src1 = native_read_i64(ins as i64, 24) as LirOperand
    ins_src2 = native_read_i64(ins as i64, 32) as LirOperand
    ins_typ = native_read_i64(ins as i64, 8)
    if kind == MIR_INTR_STR_EQ do
        cb = emit_to_rdi(cb, ins_src1, assigned_phys)
        pattern_op = vec_get_rt(recent_setargs, 0)
        if (pattern_op as i64) != 0 and native_read_i64(pattern_op as i64, 0) == (LirOperandType.Imm as i64) do
            sid = native_read_i64(pattern_op as i64, 32)
            f_strings = native_read_i64(func_obj as i64, 32)
            if f_strings > 0 and sid >= 0 and sid < vec_len_rt(f_strings) do
                s_val = vec_get_rt(f_strings, sid)
                sf = native_read_i64(str_fixups, 0)
                imm_off = (codebuf_offset(cb) + 2) as i64
                sf = vec_push_rt(sf, x86_str_fixup_new(imm_off, s_val as i64, X86_RSI))
                native_write_i64(str_fixups, 0, sf)
                cb = x86_emit_mov_reg_imm64(cb, X86_RSI, 0)
                cb = emit_call_fixup_x86(cb, call_fixups, 1, LIR_RT_STR_EQ, rd)
                if rd < 0 do cb = store_spilled_result_x86(cb, ins_dst, X86_RAX) end
                out cb
            end
        end
        out x86_emit_xor_rr(cb, X86_RAX, X86_RAX)
    end
    if kind == MIR_INTR_STR_LIT or kind == MIR_INTR_INTERP or kind == MIR_INTR_BUNDLE do
        sid = native_read_i64(ins_src1 as i64, 32)
        f_strings = native_read_i64(func_obj as i64, 32)
        if f_strings > 0 and sid >= 0 and sid < vec_len_rt(f_strings) and rd >= 0 do
            s_val = vec_get_rt(f_strings, sid)
            sf = native_read_i64(str_fixups, 0)
            imm_off = (codebuf_offset(cb) + 2) as i64
            sf = vec_push_rt(sf, x86_str_fixup_new(imm_off, s_val as i64, rd))
            native_write_i64(str_fixups, 0, sf)
            cb = x86_emit_mov_reg_imm64(cb, rd as int, 0)
            out cb
        end
        if f_strings > 0 and sid >= 0 and sid < vec_len_rt(f_strings) and rd < 0 do
            s_val = vec_get_rt(f_strings, sid)
            sf = native_read_i64(str_fixups, 0)
            imm_off = (codebuf_offset(cb) + 2) as i64
            sf = vec_push_rt(sf, x86_str_fixup_new(imm_off, s_val as i64, SCR))
            native_write_i64(str_fixups, 0, sf)
            cb = x86_emit_mov_reg_imm64(cb, SCR as int, 0)
            out store_spilled_result_x86(cb, ins_dst as LirOperand, SCR)
        end
        if rd >= 0 do
            cb = x86_emit_mov_reg_imm64(cb, rd as int, 0)
            out cb
        end
        out x86_emit_nop(cb)
    end
    if kind == MIR_INTR_LOAD_ADDR do
        slot = native_read_i64(ins_src1 as i64, 32)
        distance = 88 + 8 * slot
        target_rd = rd
        if target_rd < 0 do target_rd = SCR end
        cb = x86_emit_mov_reg_imm32(cb, SCR2 as int, distance as int)
        cb = x86_emit_mov_rr(cb, target_rd as int, X86_RBP)
        cb = x86_emit_sub_rr(cb, target_rd as int, SCR2 as int)
        if rd < 0 do
            cb = store_spilled_result_x86(cb, ins_dst as LirOperand, target_rd)
        end
        out cb
    end
    if kind == MIR_INTR_GLOBAL_LOAD do
        slot = native_read_i64(ins_src1 as i64, 32)
        if rd >= 0 and slot >= 0 and slot < 4092 do
            out x86_emit_mov_reg_mem(cb, rd as int, X86_R15, (32 + slot * 8) as int)
        end
        if rd < 0 and slot >= 0 and slot < 4092 do
            cb = x86_emit_mov_reg_mem(cb, SCR as int, X86_R15, (32 + slot * 8) as int)
            out store_spilled_result_x86(cb, ins_dst as LirOperand, SCR)
        end
        out x86_emit_nop(cb)
    end
    if kind == MIR_INTR_GLOBAL_STORE do
        slot = native_read_i64(ins_dst as i64, 32)
        if slot >= 0 and slot < 4092 do
            global_reg = resolve_or_imm_reg_x86(cb, ins_src1, assigned_phys, SCR)
            out x86_emit_mov_mem_reg(cb, X86_R15, (32 + slot * 8) as int, global_reg as int)
        end
        out x86_emit_nop(cb)
    end
    if kind == MIR_INTR_ERX do
        if rd >= 0 do out x86_emit_mov_rr(cb, rd as int, X86_R12) end
        if native_read_i64(ins_dst as i64, 0) == (LirOperandType.StackMem as i64) do
            out store_spilled_result_x86(cb, ins_dst as LirOperand, X86_R12)
        end
        var erx_src = ins_src1
        if (erx_src as i64) != 0 and native_read_i64(erx_src as i64, 0) != 0 do
            erx_reg = resolve_or_imm_reg_x86(cb, erx_src, assigned_phys, SCR)
            if erx_reg != X86_R12 do cb = x86_emit_mov_rr(cb, X86_R12, erx_reg as int) end
            out cb
        end
        out x86_emit_xor_rr(cb, X86_R12, X86_R12)
    end
    if kind == MIR_INTR_THROW do
        var thrown_src = ins_src1
        if (thrown_src as i64) != 0 and native_read_i64(thrown_src as i64, 0) != 0 do
            throw_reg = resolve_or_imm_reg_x86(cb, thrown_src, assigned_phys, SCR)
            if throw_reg != X86_R12 do cb = x86_emit_mov_rr(cb, X86_R12, throw_reg as int) end
        else
            cb = x86_emit_mov_reg_imm32(cb, X86_R12, 1)
        end
        cb = codebuf_emit_byte(cb, 0x0F)
        out codebuf_emit_byte(cb, 0x0B)
    end
    if x86_intr_is_marker(kind) == 1 do
        out x86_emit_nop(cb)
    end
    if kind == MIR_INTR_TRAIN do
        cb = x86_emit_mov_reg_imm32(cb, SCR as int, 1)
        cb = x86_emit_mov_mem_reg(cb, X86_R15, 8, SCR as int)
        cb = x86_emit_xor_rr(cb, SCR as int, SCR as int)
        cb = x86_emit_mov_mem_reg(cb, X86_R15, 16, SCR as int)
        cb = x86_emit_mov_mem_reg(cb, X86_R15, 24, SCR as int)
        out cb
    end
    if kind == MIR_INTR_INFER do
        cb = x86_emit_xor_rr(cb, SCR as int, SCR as int)
        cb = x86_emit_mov_mem_reg(cb, X86_R15, 8, SCR as int)
        out cb
    end
    if kind == MIR_INTR_QUANTIZE do
        cb = x86_emit_mov_rr(cb, X86_RSI, X86_RDI)
        cb = emit_to_rdi(cb, ins_src1, assigned_phys)
        cb = emit_call_fixup_x86(cb, call_fixups, 1, LIR_RT_QUANTIZE, rd)
        if rd < 0 do
            cb = store_spilled_result_x86(cb, ins_dst as LirOperand, X86_RAX)
        end
        out cb
    end
    if kind == MIR_INTR_BACKWARD do
        cb = emit_call_fixup_x86(cb, call_fixups, 1, LIR_RT_BACKWARD, rd)
        if rd < 0 do
            cb = store_spilled_result_x86(cb, ins_dst as LirOperand, X86_RAX)
        end
        out cb
    end
    if kind == MIR_INTR_PERCENT do
        a = resolve_or_imm_reg_x86(cb, ins_src1, assigned_phys, SCR)
        var target_rd = rd
        if target_rd < 0 do target_rd = SCR end
        if ins_typ == (LirType.F64 as i64) do
            cb = x86_emit_movq_xmm_gpr(cb, 0, a as int)
        else
            cb = x86_emit_cvtsi2sd_xg(cb, 0, a as int)
        end
        cb = x86_emit_mov_reg_imm64(cb, SCR2 as int, 4636737291354636288)
        cb = x86_emit_movq_xmm_gpr(cb, 1, SCR2 as int)
        cb = x86_emit_divsd_xx(cb, 0, 1)
        cb = x86_emit_movq_gpr_xmm(cb, target_rd as int, 0)
        out cb
    end
    if (kind and 0xFF) == MIR_INTR_CAST do
        cast_src_cat = (kind shr 8) and 0xFF
        cast_dst_cat = (kind shr 16) and 0xFF
        cast_src_reg = resolve_or_imm_reg_x86(cb, ins_src1, assigned_phys, SCR)
        var cast_dst_reg = rd
        if cast_dst_reg < 0 do cast_dst_reg = SCR2 end
        if cast_src_cat == 1 and cast_dst_cat == 2 do
            cb = x86_emit_cvtsi2sd_xg(cb, 0, cast_src_reg as int)
            cb = x86_emit_movq_gpr_xmm(cb, cast_dst_reg as int, 0)
        eif cast_src_cat == 2 and cast_dst_cat == 1 do
            cb = x86_emit_movq_xmm_gpr(cb, 0, cast_src_reg as int)
            cb = x86_emit_cvttsd2si_gx(cb, cast_dst_reg as int, 0)
        else
            var cast_bits = (kind shr 24) and 0xFF
            if cast_bits == 0 do cast_bits = 64 end
            var cast_is_unsigned = (kind shr 32) and 0xFF
            if cast_is_unsigned == 1 do
                if cast_bits == 8 do
                    var rex_u8 = 0x40
                    if cast_dst_reg >= 8 do rex_u8 = rex_u8 or 0x04 end
                    if cast_src_reg >= 8 do rex_u8 = rex_u8 or 0x01 end
                    cb = codebuf_emit_byte(cb, rex_u8)
                    cb = codebuf_emit_byte(cb, 0x0F)
                    cb = codebuf_emit_byte(cb, 0xB6)
                    cb = codebuf_emit_byte(cb, x86_modrm(3, cast_dst_reg as int, cast_src_reg as int))
                eif cast_bits == 16 do
                    var rex_u16 = 0x40
                    if cast_dst_reg >= 8 do rex_u16 = rex_u16 or 0x04 end
                    if cast_src_reg >= 8 do rex_u16 = rex_u16 or 0x01 end
                    cb = codebuf_emit_byte(cb, rex_u16)
                    cb = codebuf_emit_byte(cb, 0x0F)
                    cb = codebuf_emit_byte(cb, 0xB7)
                    cb = codebuf_emit_byte(cb, x86_modrm(3, cast_dst_reg as int, cast_src_reg as int))
                eif cast_bits == 32 do
                    var rex_u32 = 0x40
                    if cast_src_reg >= 8 do rex_u32 = rex_u32 or 0x04 end
                    if cast_dst_reg >= 8 do rex_u32 = rex_u32 or 0x01 end
                    if rex_u32 != 0x40 do cb = codebuf_emit_byte(cb, rex_u32) end
                    cb = codebuf_emit_byte(cb, 0x89)
                    cb = codebuf_emit_byte(cb, x86_modrm(3, cast_src_reg as int, cast_dst_reg as int))
                else
                    if cast_dst_reg != cast_src_reg do
                        cb = x86_emit_mov_rr(cb, cast_dst_reg as int, cast_src_reg as int)
                    end
                end
            else
                if cast_bits == 8 do
                    var rex_s8 = 0x48
                    if cast_dst_reg >= 8 do rex_s8 = rex_s8 or 0x04 end
                    if cast_src_reg >= 8 do rex_s8 = rex_s8 or 0x01 end
                    cb = codebuf_emit_byte(cb, rex_s8)
                    cb = codebuf_emit_byte(cb, 0x0F)
                    cb = codebuf_emit_byte(cb, 0xBE)
                    cb = codebuf_emit_byte(cb, x86_modrm(3, cast_dst_reg as int, cast_src_reg as int))
                eif cast_bits == 16 do
                    var rex_s16 = 0x48
                    if cast_dst_reg >= 8 do rex_s16 = rex_s16 or 0x04 end
                    if cast_src_reg >= 8 do rex_s16 = rex_s16 or 0x01 end
                    cb = codebuf_emit_byte(cb, rex_s16)
                    cb = codebuf_emit_byte(cb, 0x0F)
                    cb = codebuf_emit_byte(cb, 0xBF)
                    cb = codebuf_emit_byte(cb, x86_modrm(3, cast_dst_reg as int, cast_src_reg as int))
                eif cast_bits == 32 do
                    var rex_s32 = 0x48
                    if cast_dst_reg >= 8 do rex_s32 = rex_s32 or 0x04 end
                    if cast_src_reg >= 8 do rex_s32 = rex_s32 or 0x01 end
                    cb = codebuf_emit_byte(cb, rex_s32)
                    cb = codebuf_emit_byte(cb, 0x63)
                    cb = codebuf_emit_byte(cb, x86_modrm(3, cast_dst_reg as int, cast_src_reg as int))
                else
                    if cast_dst_reg != cast_src_reg do
                        cb = x86_emit_mov_rr(cb, cast_dst_reg as int, cast_src_reg as int)
                    end
                end
            end
        end
        if rd < 0 and (ins_dst as i64) != 0 do
            cb = store_spilled_result_x86(cb, ins_dst, cast_dst_reg)
        end
        out cb
    end
    if kind == MIR_INTR_PARAM do
        abi = native_read_i64(ins_src1 as i64, 32)
        if abi >= 0 and abi < 6 do
            areg = x86_arg_reg(abi as int)
            if rd >= 0 do
                if rd != areg do
                    cb = x86_emit_mov_rr(cb, rd as int, areg)
                end
            else
                if (ins_dst as i64) != 0 do
                    cb = store_spilled_result_x86(cb, ins_dst as LirOperand, areg)
                end
            end
            out cb
        end
        if abi >= 6 do
            # SysV AMD64 ABI: stack parameters start at [RBP + 16]
            off = 16 + ((abi - 6) * 8)
            cb = x86_emit_mov_reg_imm32(cb, SCR as int, off as int)
            cb = x86_emit_add_rr(cb, SCR as int, X86_RBP)
            if rd >= 0 do
                cb = x86_emit_mov_reg_mem(cb, rd as int, SCR as int, 0)
            else
                cb = x86_emit_mov_reg_mem(cb, SCR as int, SCR as int, 0)
                if (ins_dst as i64) != 0 do
                    cb = store_spilled_result_x86(cb, ins_dst as LirOperand, SCR)
                end
            end
            out cb
        end
        out x86_emit_nop(cb)
    end
    if kind == MIR_INTR_BUILTIN do
        bid = native_read_i64(ins_src1 as i64, 32)
        if bid == 31 do
            # native_mem_copy(dst=RDI, src=RSI, len=RDX)
            cb = x86_emit_mov_rr(cb, X86_RAX, X86_RDI)
            if target_has_sse2() == 1 do
                let loop16 = codebuf_offset(cb) as int
                cb = x86_emit_cmp_reg_imm32(cb, X86_RDX, 16)
                cb = x86_emit_jl_rel32(cb, 0)
                let tail16_fixup = codebuf_offset(cb) as int
                cb = x86_emit_movdqu_load(cb, 0, X86_RSI, 0)
                cb = x86_emit_movdqu_store(cb, X86_RDI, 0, 0)
                cb = x86_emit_mov_reg_imm32(cb, X86_RCX, 16)
                cb = x86_emit_add_rr(cb, X86_RSI, X86_RCX)
                cb = x86_emit_add_rr(cb, X86_RDI, X86_RCX)
                cb = x86_emit_sub_rr(cb, X86_RDX, X86_RCX)
                cb = x86_emit_jmp_rel32(cb, 0)
                let back16_site = codebuf_offset(cb) as int
                cb = patch_rel32(cb, back16_site - 4, loop16)
                let tail16_pos = codebuf_offset(cb) as int
                cb = patch_rel32(cb, tail16_fixup - 4, tail16_pos)
            end
            let loop1 = codebuf_offset(cb) as int
            cb = x86_emit_cmp_reg_imm32(cb, X86_RDX, 0)
            cb = x86_emit_jle_rel32(cb, 0)
            let done1_fixup = codebuf_offset(cb) as int
            cb = x86_emit_movzx_reg_mem8(cb, X86_RCX, X86_RSI, 0)
            cb = x86_emit_mov_mem_reg8(cb, X86_RDI, 0, X86_RCX)
            cb = x86_emit_mov_reg_imm32(cb, SCR as int, 1)
            cb = x86_emit_add_rr(cb, X86_RSI, SCR as int)
            cb = x86_emit_add_rr(cb, X86_RDI, SCR as int)
            cb = x86_emit_sub_rr(cb, X86_RDX, SCR as int)
            cb = x86_emit_jmp_rel32(cb, 0)
            let back1_site = codebuf_offset(cb) as int
            cb = patch_rel32(cb, back1_site - 4, loop1)
            let done1_pos = codebuf_offset(cb) as int
            cb = patch_rel32(cb, done1_fixup - 4, done1_pos)
            if rd >= 0 and rd != X86_RAX do cb = x86_emit_mov_rr(cb, rd as int, X86_RAX) end
            if rd < 0 do cb = store_spilled_result_x86(cb, ins_dst, X86_RAX) end
            out cb
        end
        if bid == 32 do
            # native_mem_set(dst=RDI, val=RSI, len=RDX)
            cb = x86_emit_mov_rr(cb, X86_RAX, X86_RDI)
            cb = x86_emit_mov_rr(cb, X86_RCX, X86_RSI)
            cb = x86_emit_and_imm8(cb, X86_RCX, 0xFF)
            cb = x86_emit_mov_reg_imm64(cb, SCR as int, 0x0101010101010101)
            cb = x86_emit_imul_rr(cb, X86_RCX, SCR as int)
            if target_has_sse2() == 1 do
                cb = x86_emit_movq_xmm_gpr(cb, 0, X86_RCX)
                cb = x86_emit_punpcklqdq(cb, 0, 0)
                let loop16 = codebuf_offset(cb) as int
                cb = x86_emit_cmp_reg_imm32(cb, X86_RDX, 16)
                cb = x86_emit_jl_rel32(cb, 0)
                let tail16_fixup = codebuf_offset(cb) as int
                cb = x86_emit_movdqu_store(cb, X86_RDI, 0, 0)
                cb = x86_emit_mov_reg_imm32(cb, SCR as int, 16)
                cb = x86_emit_add_rr(cb, X86_RDI, SCR as int)
                cb = x86_emit_sub_rr(cb, X86_RDX, SCR as int)
                cb = x86_emit_jmp_rel32(cb, 0)
                let back16_site = codebuf_offset(cb) as int
                cb = patch_rel32(cb, back16_site - 4, loop16)
                let tail16_pos = codebuf_offset(cb) as int
                cb = patch_rel32(cb, tail16_fixup - 4, tail16_pos)
            end
            let loop1 = codebuf_offset(cb) as int
            cb = x86_emit_cmp_reg_imm32(cb, X86_RDX, 0)
            cb = x86_emit_jle_rel32(cb, 0)
            let done1_fixup = codebuf_offset(cb) as int
            cb = x86_emit_mov_mem_reg8(cb, X86_RDI, 0, X86_RCX)
            cb = x86_emit_mov_reg_imm32(cb, SCR as int, 1)
            cb = x86_emit_add_rr(cb, X86_RDI, SCR as int)
            cb = x86_emit_sub_rr(cb, X86_RDX, SCR as int)
            cb = x86_emit_jmp_rel32(cb, 0)
            let back1_site = codebuf_offset(cb) as int
            cb = patch_rel32(cb, back1_site - 4, loop1)
            let done1_pos = codebuf_offset(cb) as int
            cb = patch_rel32(cb, done1_fixup - 4, done1_pos)
            if rd >= 0 and rd != X86_RAX do cb = x86_emit_mov_rr(cb, rd as int, X86_RAX) end
            if rd < 0 do cb = store_spilled_result_x86(cb, ins_dst, X86_RAX) end
            out cb
        end
        stub = x86_stub_for_builtin_id(bid)
        if stub < 0 do
            stub = LIR_RT_UNRESOLVED
        end
        var cb_builtin = emit_call_fixup_x86(cb, call_fixups, 1, stub, rd)
        if rd < 0 do
            cb_builtin = store_spilled_result_x86(cb_builtin, ins_dst, X86_RAX)
        end
        out cb_builtin
    end
    if kind == MIR_INTR_PRINT do
        cb = emit_to_rdi(cb, ins_src1, assigned_phys)
        out emit_call_fixup_x86(cb, call_fixups, 1, MIR_INTR_PRINT, rd)
    end
    if kind == MIR_INTR_PRINT_STR do
        var target_src2 = ins_src1
        if (target_src2 as i64) == 0 or native_read_i64(target_src2 as i64, 0) == 0 do
            target_src2 = ins_src2
        end
        cb = emit_to_rdi(cb, target_src2, assigned_phys)
        out emit_call_fixup_x86(cb, call_fixups, 1, LIR_RT_PRINT_STR, rd)
    end
    if kind == MIR_INTR_ADDR_OF do
        var target_rd = rd
        if target_rd < 0 do target_rd = SCR end
        if (ins_src1 as i64) != 0 and native_read_i64(ins_src1 as i64, 0) == (LirOperandType.Imm as i64) do
            cid = native_read_i64(ins_src1 as i64, 32)
            f_strings = native_read_i64(func_obj as i64, 32)
            if f_strings > 0 and cid >= 0 and cid < vec_len_rt(f_strings) do
                cname = vec_get_rt(f_strings, cid)
                fi = x86_find_func_index(lir_funcs, cname)
                if fi >= 0 do
                    imm_at = (codebuf_offset(cb) + 2) as i64
                    cb = x86_emit_mov_reg_imm64(cb, target_rd as int, 0)
                    cf = native_read_i64(call_fixups, 0)
                    cf = vec_push_rt(cf, x86_call_fixup_new(imm_at, 2, fi))
                    native_write_i64(call_fixups, 0, cf)
                    if rd < 0 do
                        cb = store_spilled_result_x86(cb, ins_dst as LirOperand, target_rd)
                    end
                    out cb
                end
            end
            print_str("virc: linker error: unresolved function address: ")
            if f_strings > 0 and cid >= 0 and cid < vec_len_rt(f_strings) do
                cname = vec_get_rt(f_strings, cid)
                print_str(cname as string)
            end
            print_str("\n")
            sys_exit(1)
            out cb
        end
        if (ins_src1 as i64) != 0 do
            if rd >= 0 do
                cb = x86_emit_mov_reg_imm64(cb, rd as int, 0)
            eif (ins_dst as i64) != 0 do
                cb = x86_emit_mov_reg_imm64(cb, target_rd as int, 0)
                cb = store_spilled_result_x86(cb, ins_dst as LirOperand, target_rd)
            end
            out cb
        end
        print_str("virc: linker error: unresolved function address: missing symbol operand\n")
        sys_exit(1)
        out cb
    end
    if x86_intr_is_payload(kind) == 1 do
        if rd >= 0 do
            if native_read_i64(ins_src1 as i64, 0) == (LirOperandType.Imm as i64) do
                cb = x86_emit_mov_reg_imm64(cb, rd as int, native_read_i64(ins_src1 as i64, 32) as int)
                out cb
            eif rs1 >= 0 do
                cb = x86_emit_mov_rr(cb, rd as int, rs1 as int)
                out cb
            end
        end
        out x86_emit_nop(cb)
    end
    if kind == MIR_INTR_INDEX do
        # SetArg(0) places the flattened index in RDI.  Tensor elements start
        # after the 16-byte [len, cap] header.
        var idx_base = resolve_or_imm_reg_x86(cb, ins_src1, assigned_phys, SCR2)
        if idx_base >= 0 do
            var idx_rd = rd
            if idx_rd < 0 do idx_rd = X86_RAX end
            cb = x86_emit_mov_rr(cb, X86_RAX, idx_base as int)
            cb = x86_emit_mov_rr(cb, SCR as int, X86_RDI)
            var shift = 3
            if ins_typ == (LirType.F32 as i64) or ins_typ == (LirType.Int32 as i64) do
                shift = 2
            eif ins_typ == (LirType.Int16 as i64) or ins_typ == (LirType.F16 as i64) do
                shift = 1
            eif ins_typ == (LirType.Int8 as i64) do
                shift = 0
            end
            if shift > 0 do
                cb = x86_emit_mov_reg_imm32(cb, X86_RCX, shift)
                cb = x86_emit_shl_cl(cb, SCR as int)
            end
            cb = x86_emit_add_rr(cb, SCR as int, X86_RAX)
            if ins_typ == (LirType.F32 as i64) do
                cb = x86_emit_mov_reg_mem32(cb, idx_rd as int, SCR as int, 16)
                cb = x86_emit_movd_xmm_gpr(cb, 0, idx_rd as int)
                cb = x86_emit_cvtss2sd_xx(cb, 0, 0)
                cb = x86_emit_movq_gpr_xmm(cb, idx_rd as int, 0)
            eif ins_typ == (LirType.F16 as i64) do
                cb = x86_emit_xor_rr(cb, idx_rd as int, idx_rd as int)
                cb = x86_emit_mov_reg_mem16(cb, idx_rd as int, SCR as int, 16)
                cb = x86_emit_f16_to_f32(cb, idx_rd as int, 0, X86_RCX, SCR2 as int, 1)
                cb = x86_emit_cvtss2sd_xx(cb, 0, 0)
                cb = x86_emit_movq_gpr_xmm(cb, idx_rd as int, 0)
            eif ins_typ == (LirType.Int32 as i64) do
                cb = x86_emit_movslq_reg_mem(cb, idx_rd as int, SCR as int, 16)
            eif ins_typ == (LirType.Int16 as i64) do
                cb = x86_emit_mov_reg_mem16(cb, idx_rd as int, SCR as int, 16)
            eif ins_typ == (LirType.Int8 as i64) do
                if lir_instr_bits(ins) == 1 do
                    cb = x86_emit_movsbq_reg_mem(cb, idx_rd as int, SCR as int, 16)
                else
                    cb = x86_emit_movzx_reg_mem8(cb, idx_rd as int, SCR as int, 16)
                end
            else
                cb = x86_emit_mov_reg_mem(cb, idx_rd as int, SCR as int, 16)
            end
            if rd < 0 and (ins_dst as i64) != 0 do
                out store_spilled_result_x86(cb, ins_dst as LirOperand, idx_rd)
            end
            out cb
        end
        out x86_emit_nop(cb)
    end
    if kind == MIR_INTR_INDEX_STORE do
        # SetArg(0/1) places index/value in RDI/RSI.
        var idxs_base = resolve_or_imm_reg_x86(cb, ins_src1, assigned_phys, SCR2)
        if idxs_base >= 0 do
            cb = x86_emit_mov_rr(cb, X86_RAX, idxs_base as int)
            cb = x86_emit_mov_rr(cb, SCR as int, X86_RDI)
            var shift = 3
            if ins_typ == (LirType.F32 as i64) or ins_typ == (LirType.Int32 as i64) do
                shift = 2
            eif ins_typ == (LirType.Int16 as i64) or ins_typ == (LirType.F16 as i64) do
                shift = 1
            eif ins_typ == (LirType.Int8 as i64) do
                shift = 0
            end
            if shift > 0 do
                cb = x86_emit_mov_reg_imm32(cb, X86_RCX, shift)
                cb = x86_emit_shl_cl(cb, SCR as int)
            end
            cb = x86_emit_add_rr(cb, SCR as int, X86_RAX)
            if ins_typ == (LirType.F32 as i64) do
                cb = x86_emit_movq_xmm_gpr(cb, 0, X86_RSI)
                cb = x86_emit_cvtsd2ss_xx(cb, 0, 0)
                cb = x86_emit_movd_gpr_xmm(cb, X86_RSI, 0)
                cb = x86_emit_mov_mem_reg32(cb, SCR as int, 16, X86_RSI)
            eif ins_typ == (LirType.F16 as i64) do
                cb = x86_emit_movq_xmm_gpr(cb, 0, X86_RSI)
                cb = x86_emit_float_to_f16(cb, 1, 0, X86_RAX, X86_RCX, SCR2 as int, 1)
                cb = x86_emit_mov_mem_reg16(cb, SCR as int, 16, X86_RAX)
            eif ins_typ == (LirType.Int32 as i64) do
                cb = x86_emit_mov_mem_reg32(cb, SCR as int, 16, X86_RSI)
            eif ins_typ == (LirType.Int16 as i64) do
                cb = x86_emit_mov_mem_reg16(cb, SCR as int, 16, X86_RSI)
            eif ins_typ == (LirType.Int8 as i64) do
                cb = x86_emit_mov_mem_reg8(cb, SCR as int, 16, X86_RSI)
            else
                cb = x86_emit_mov_mem_reg(cb, SCR as int, 16, X86_RSI)
            end
            out cb
        end
        out x86_emit_nop(cb)
    end
    if kind == MIR_INTR_FIELD do
        # resolve_or_imm_reg_x86 handles spilled (StackMem) source pointers too
        f_base = resolve_or_imm_reg_x86(cb, ins_src1, assigned_phys, SCR2)
        if f_base >= 0 do
            var f_dst = rd
            if f_dst < 0 do f_dst = SCR end
            cb = x86_emit_mov_reg_mem(cb, f_dst as int, f_base as int, 0)
            if rd < 0 and (ins_dst as i64) != 0 do
                out store_spilled_result_x86(cb, ins_dst as LirOperand, f_dst)
            end
            out cb
        end
        out x86_emit_nop(cb)
    end
    if kind == MIR_INTR_FIELD_STORE do
        fs_base = resolve_or_imm_reg_x86(cb, ins_src1, assigned_phys, SCR2)
        if fs_base >= 0 do
            cb = x86_emit_mov_mem_reg(cb, fs_base as int, 0, X86_RSI)
            out cb
        end
        out x86_emit_nop(cb)
    end
    if kind == MIR_MEM_MARK do
        var mark_rd = rd
        if mark_rd < 0 do mark_rd = SCR end
        cb = x86_emit_mov_reg_mem(cb, mark_rd as int, X86_R15, 0)
        if rd < 0 and (ins_dst as i64) != 0 do
            cb = store_spilled_result_x86(cb, ins_dst, mark_rd)
        end
        out cb
    end
    if kind == MIR_MEM_RESET do
        if (ins_src1 as i64) != 0 do
            reset_reg = resolve_or_imm_reg_x86(cb, ins_src1, assigned_phys, SCR)
            if reset_reg >= 0 do
                cb = x86_emit_mov_mem_reg(cb, X86_R15, 0, reset_reg as int)
                out cb
            end
        end
        out x86_emit_nop(cb)
    end
    if kind == MIR_MEM_PROMOTE do
        if (ins_src1 as i64) != 0 do
            p_reg = resolve_or_imm_reg_x86(cb, ins_src1, assigned_phys, X86_RDI)
            if p_reg >= 0 do
                if p_reg != X86_RDI do
                    cb = x86_emit_mov_rr(cb, X86_RDI, p_reg as int)
                end
                # Default result in RAX = RDI
                cb = x86_emit_mov_rr(cb, X86_RAX, X86_RDI)

                # Guard: p >= 65536
                cb = x86_emit_mov_reg_imm32(cb, SCR as int, 65536)
                cb = x86_emit_cmp_rr(cb, X86_RDI, SCR as int)
                cb = x86_emit_jl_rel32(cb, 0)
                let not_ptr_fixup = codebuf_offset(cb) as int

                # Guard: p in arena [R15, [R15])
                cb = x86_emit_cmp_rr(cb, X86_RDI, X86_R15)
                cb = x86_emit_jl_rel32(cb, 0)
                let not_in_arena1_fixup = codebuf_offset(cb) as int

                cb = x86_emit_mov_reg_mem(cb, X86_RSI, X86_R15, 0)
                cb = x86_emit_cmp_rr(cb, X86_RDI, X86_RSI)
                cb = x86_emit_jge_rel32(cb, 0)
                let not_in_arena2_fixup = codebuf_offset(cb) as int

                # System V ABI: RDI = arg0 = p, RSI = arg1 = arena_base = R15, RDX = arg2 = arena_top = [R15]
                cb = x86_emit_mov_rr(cb, X86_RSI, X86_R15)
                cb = x86_emit_mov_reg_mem(cb, X86_RDX, X86_R15, 0)

                # Call rt_promote_graph stub (result in RAX)
                cb = emit_call_fixup_x86(cb, call_fixups, 1, LIR_RT_PROMOTE_GRAPH, 0 - 1)

                let promote_end = codebuf_offset(cb) as int
                cb = patch_rel32(cb, not_ptr_fixup - 4, promote_end)
                cb = patch_rel32(cb, not_in_arena1_fixup - 4, promote_end)
                cb = patch_rel32(cb, not_in_arena2_fixup - 4, promote_end)

                if rd >= 0 and rd != X86_RAX do cb = x86_emit_mov_rr(cb, rd as int, X86_RAX) end
                if rd < 0 and (ins_dst as i64) != 0 do cb = store_spilled_result_x86(cb, ins_dst, X86_RAX) end
                out cb
            end
        end
        out x86_emit_nop(cb)
    end
    if kind == MIR_MEM_DROP do
        if (ins_src1 as i64) != 0 do
            drop_reg = resolve_or_imm_reg_x86(cb, ins_src1, assigned_phys, X86_RDI)
            if drop_reg >= 0 do
                if drop_reg != X86_RDI do
                    cb = x86_emit_mov_rr(cb, X86_RDI, drop_reg as int)
                end
                cb = x86_emit_mov_reg_imm32(cb, X86_RAX, 65536)
                cb = x86_emit_cmp_rr(cb, X86_RDI, X86_RAX)
                cb = x86_emit_jl_rel32(cb, 0)
                let not_ptr_fixup = codebuf_offset(cb) as int

                cb = x86_emit_cmp_rr(cb, X86_RDI, X86_R15)
                cb = x86_emit_jl_rel32(cb, 0)
                let not_in_arena1 = codebuf_offset(cb) as int

                cb = x86_emit_mov_reg_mem(cb, X86_RSI, X86_R15, 0)
                cb = x86_emit_cmp_rr(cb, X86_RDI, X86_RSI)
                cb = x86_emit_jge_rel32(cb, 0)
                let not_in_arena2 = codebuf_offset(cb) as int

                cb = x86_emit_mov_rr(cb, X86_RAX, X86_RDI)
                cb = x86_emit_mov_reg_imm32(cb, SCR as int, 16)
                cb = x86_emit_sub_rr(cb, X86_RAX, SCR as int)
                cb = x86_emit_mov_reg_mem(cb, X86_RDX, X86_RAX, 0)
                cb = x86_emit_mov_reg_imm32(cb, SCR as int, 0)
                cb = x86_emit_mov_mem_reg(cb, X86_RAX, 8, SCR as int)
                cb = x86_emit_mov_rr(cb, X86_RCX, X86_RAX)
                cb = x86_emit_add_rr(cb, X86_RCX, X86_RDX)
                cb = x86_emit_cmp_rr(cb, X86_RCX, X86_RSI)
                cb = x86_emit_jne_rel32(cb, 0)
                let no_rewind_fixup = codebuf_offset(cb) as int

                cb = x86_emit_mov_mem_reg(cb, X86_R15, 0, X86_RAX)

                let drop_end = codebuf_offset(cb) as int
                cb = patch_rel32(cb, no_rewind_fixup - 4, drop_end)
                cb = patch_rel32(cb, not_in_arena2 - 4, drop_end)
                cb = patch_rel32(cb, not_in_arena1 - 4, drop_end)
                cb = patch_rel32(cb, not_ptr_fixup - 4, drop_end)

                out cb
            end
        end
        out x86_emit_nop(cb)
    end
    if kind == MIR_INTR_ARENA do
        if (ins_dst as i64) != 0 and native_read_i64(ins_dst as i64, 0) != 0 do
            var arena_rd = rd
            if arena_rd < 0 do arena_rd = SCR end
            cb = x86_emit_mov_reg_mem(cb, arena_rd as int, X86_R15, 0)
            if rd < 0 do
                cb = store_spilled_result_x86(cb, ins_dst, arena_rd)
            end
            out cb
        end
        if (ins_src1 as i64) != 0 and native_read_i64(ins_src1 as i64, 0) != 0 do
            arena_rs = resolve_or_imm_reg_x86(cb, ins_src1, assigned_phys, SCR)
            if arena_rs >= 0 do
                cb = x86_emit_mov_mem_reg(cb, X86_R15, 0, arena_rs as int)
                out cb
            end
        end
        out x86_emit_nop(cb)
    end
    cb = emit_to_rdi(cb, ins_src1, assigned_phys)
    stub2 = kind
    if stub2 < 1 or stub2 >= LIR_RT_STUB_COUNT do
        stub2 = LIR_RT_UNRESOLVED
    end
    cb = emit_call_fixup_x86(cb, call_fixups, 1, stub2, rd)
    if rd < 0 do
        cb = store_spilled_result_x86(cb, ins_dst as LirOperand, X86_RAX)
    end
    out cb
end.

func x86_stub_for_callee_name(cname: string):
    if fat_cstr_eq(cname, "read_byte") or fat_cstr_eq(cname, "native_read_u8") or fat_cstr_eq(cname, "read_u8") or fat_cstr_eq(cname, "read8") or rt_streq(cname as int, "read_byte") or rt_streq(cname as int, "native_read_u8") or rt_streq(cname as int, "read_u8") or rt_streq(cname as int, "read8") do out LIR_RT_NATIVE_READ_U8 end
    if fat_cstr_eq(cname, "write_byte") or fat_cstr_eq(cname, "native_write_u8") or fat_cstr_eq(cname, "write_u8") or fat_cstr_eq(cname, "write8") or rt_streq(cname as int, "write_byte") or rt_streq(cname as int, "native_write_u8") or rt_streq(cname as int, "write_u8") or rt_streq(cname as int, "write8") do out LIR_RT_NATIVE_WRITE_U8 end
    if fat_cstr_eq(cname, "read_word") or fat_cstr_eq(cname, "native_read_i64") or fat_cstr_eq(cname, "native_read_f64") or fat_cstr_eq(cname, "read_i64") or fat_cstr_eq(cname, "read64") or rt_streq(cname as int, "read_word") or rt_streq(cname as int, "native_read_i64") or rt_streq(cname as int, "native_read_f64") or rt_streq(cname as int, "read_i64") or rt_streq(cname as int, "read64") do out LIR_RT_NATIVE_READ_I64 end
    if fat_cstr_eq(cname, "write_word") or fat_cstr_eq(cname, "native_write_i64") or fat_cstr_eq(cname, "native_write_f64") or fat_cstr_eq(cname, "write_i64") or fat_cstr_eq(cname, "write64") or rt_streq(cname as int, "write_word") or rt_streq(cname as int, "native_write_i64") or rt_streq(cname as int, "native_write_f64") or rt_streq(cname as int, "write_i64") or rt_streq(cname as int, "write64") do out LIR_RT_NATIVE_WRITE_I64 end
    if fat_cstr_eq(cname, "get_arg") or fat_cstr_eq(cname, "rt_argv") or fat_cstr_eq(cname, "rt_get_arg") or rt_streq(cname as int, "get_arg") or rt_streq(cname as int, "rt_argv") or rt_streq(cname as int, "rt_get_arg") do out LIR_RT_GET_ARG end
    if fat_cstr_eq(cname, "arg_count") or fat_cstr_eq(cname, "rt_argc") or rt_streq(cname as int, "arg_count") or rt_streq(cname as int, "rt_argc") do out LIR_RT_ARG_COUNT end
    if fat_cstr_eq(cname, "alloc") or rt_streq(cname as int, "alloc") do out LIR_RT_ALLOC end
    if fat_cstr_eq(cname, "free") or fat_cstr_eq(cname, "dealloc") or rt_streq(cname as int, "free") or rt_streq(cname as int, "dealloc") do out LIR_RT_FREE end

    if fat_cstr_eq(cname, "print_str") or rt_streq(cname as int, "print_str") do out LIR_RT_PRINT_STR end
    if fat_cstr_eq(cname, "vir_get_platform") or fat_cstr_eq(cname, "sys_platform") or rt_streq(cname as int, "vir_get_platform") or rt_streq(cname as int, "sys_platform") do out LIR_RT_PLATFORM end
    if fat_cstr_eq(cname, "exit") or fat_cstr_eq(cname, "exit_prog") or fat_cstr_eq(cname, "sys_exit") or rt_streq(cname as int, "exit") or rt_streq(cname as int, "exit_prog") or rt_streq(cname as int, "sys_exit") do out LIR_RT_EXIT_PROG end
    if fat_cstr_eq(cname, "syscall") or fat_cstr_eq(cname, "__syscall") or fat_cstr_eq(cname, "syscall0") or fat_cstr_eq(cname, "syscall1") or fat_cstr_eq(cname, "syscall2") or fat_cstr_eq(cname, "syscall3") or fat_cstr_eq(cname, "syscall4") or fat_cstr_eq(cname, "syscall5") or fat_cstr_eq(cname, "syscall6") or rt_streq(cname as int, "syscall") or rt_streq(cname as int, "__syscall") or rt_streq(cname as int, "syscall0") or rt_streq(cname as int, "syscall1") or rt_streq(cname as int, "syscall2") or rt_streq(cname as int, "syscall3") or rt_streq(cname as int, "syscall4") or rt_streq(cname as int, "syscall5") or rt_streq(cname as int, "syscall6") do out LIR_RT_SYSCALL end
    out 0 - 1
end.

func reverse_pending_stack_args_x86(cb: &CodeBuf, pending_stk: i64):
    if pending_stk > 1 do
        var rev_i = 0
        let half = pending_stk / 2
        when rev_i < half loop
            let off1 = rev_i * 8
            let off2 = (pending_stk - 1 - rev_i) * 8
            cb = x86_emit_mov_reg_mem(cb, SCR as int, X86_RSP, off1 as int)
            cb = x86_emit_mov_reg_mem(cb, SCR2 as int, X86_RSP, off2 as int)
            cb = x86_emit_mov_mem_reg(cb, X86_RSP, off1 as int, SCR2 as int)
            cb = x86_emit_mov_mem_reg(cb, X86_RSP, off2 as int, SCR as int)
            rev_i = rev_i + 1
        end
    end
    out cb
end.

