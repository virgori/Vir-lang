##
 * compiler/src/lower/lir_codegen_x86/emit_func.vri — x86-64 Function-level Code Generation
 * ========================================================================================
 ##

include types_prelude
include rt_vec_rt
include rt_string_rt
include codegen
include lir_codegen_x86_types
include lir_codegen_x86_intrinsics
include lir_codegen_x86_calls
include lir_codegen_x86_rt_stubs_base
include lir_codegen_x86_rt_stubs_math

func emit_lir_x86_into(cb: &CodeBuf, func_obj: &LirFunc, assigned_phys: i64, lir_funcs: i64, call_fixups: i64, str_fixups: i64):
    var stack_size = lir_func_stack_size(func_obj)
    if (stack_size mod 16) != 0 do
        stack_size = stack_size + (16 - (stack_size mod 16))
    end
    let total_frame = 32 + stack_size

    # Controlled call-stack exhaustion check before prologue frame growth (VIRC-ISS-0053)
    cb = x86_emit_mov_reg_mem(cb, X86_R11, X86_R15, 32760)
    cb = x86_emit_mov_reg_imm64(cb, X86_RAX, total_frame)
    cb = x86_emit_add_rr(cb, X86_R11, X86_RAX)
    cb = x86_emit_cmp_rr(cb, X86_RSP, X86_R11)
    let fixup_stack_ok = codebuf_offset(cb) as int
    cb = x86_emit_ja_rel32(cb, 0)
    let ja_end_stk = codebuf_offset(cb) as int
    cb = emit_call_fixup_x86(cb, call_fixups, 1, LIR_RT_STACK_OVERFLOW, 0 - 1)
    let stack_ok_off = codebuf_offset(cb) as int
    cb = patch_rel32(cb, ja_end_stk - 4, stack_ok_off)

    # Frame allocation proceeds only after safe stack bound is verified:
    cb = x86_emit_push(cb, X86_RBP)
    cb = x86_emit_mov_rr(cb, X86_RBP, X86_RSP)
    cb = emit_callee_save_x86(cb)
    if stack_size > 0 do
        cb = x86_emit_sub_rsp_imm(cb, stack_size as int)
    end

    f_blocks = native_read_i64(func_obj as i64, 16)
    n_blocks = vec_len_rt(f_blocks)
    var max_bid = n_blocks
    var bi = 0
    when bi < n_blocks loop
        b = vec_get_rt(f_blocks, bi)
        bid = native_read_i64(b as i64, 0)
        if bid >= max_bid do
            max_bid = bid + 1
        end
        bi = bi + 1
    end
    block_off = vec_new_cap_rt_x86(1024)
    bi = 0
    when bi < max_bid loop
        block_off = vec_push_rt(block_off, 0 - 1)
        bi = bi + 1
    end
    fixups = vec_new_cap_rt_x86(1024)
    var pending_stk = 0
    recent_setargs = vec_new_cap_rt_x86(8)
    vec_push_rt(recent_setargs, 0)
    vec_push_rt(recent_setargs, 0)
    vec_push_rt(recent_setargs, 0)
    vec_push_rt(recent_setargs, 0)
    vec_push_rt(recent_setargs, 0)
    vec_push_rt(recent_setargs, 0)

    bi = 0
    when bi < n_blocks loop
        b = vec_get_rt(f_blocks, bi)
        bid = native_read_i64(b as i64, 0)
        vec_set_rt(block_off, bid, codebuf_offset(cb) as i64)
        instrs = native_read_i64(b as i64, 8)
        n_instrs = vec_len_rt(instrs)
        var ii = 0
        when ii < n_instrs loop
            ins = vec_get_rt(instrs, ii)
            op = native_read_i64(ins as i64, 0)
            ins_dst = native_read_i64(ins as i64, 16)
            ins_src1 = native_read_i64(ins as i64, 24)
            ins_src2 = native_read_i64(ins as i64, 32)
            ins_aux = native_read_i64(ins as i64, 40)
            ins_typ = native_read_i64(ins as i64, 8)
            rd = resolve_reg_x86(ins_dst, assigned_phys)
            rs1 = resolve_reg_x86(ins_src1, assigned_phys)
            rs2 = resolve_reg_x86(ins_src2, assigned_phys)

            if op == LirOp.Nop do
                cb = x86_emit_nop(cb)
            eif op == LirOp.Mov do
                if (ins_src1 as i64) != 0 do
                    src1_typ = native_read_i64(ins_src1 as i64, 0)
                    if src1_typ == 5 do # Imm
                        imm_val = native_read_i64(ins_src1 as i64, 32)
                        if rd >= 0 do
                            cb = x86_emit_mov_reg_imm64(cb, rd as int, imm_val as int)
                        end
                    eif src1_typ == 4 do # StackMem reload
                        off = native_read_i64(ins_src1 as i64, 24)
                        if rd >= 0 and off < 0 do
                            cb = x86_emit_mov_reg_imm32(cb, SCR as int, off as int)
                            cb = x86_emit_add_rr(cb, SCR as int, X86_RBP)
                            cb = x86_emit_mov_reg_mem(cb, rd as int, SCR as int, 0)
                        end
                    eif rd >= 0 and rs1 >= 0 do
                        if rd != rs1 do
                            cb = x86_emit_mov_rr(cb, rd as int, rs1 as int)
                        end
                    end
                end
                if (ins_dst as i64) != 0 do
                    dst_typ = native_read_i64(ins_dst as i64, 0)
                    if dst_typ == 4 do # StackMem spill store
                        off_d = native_read_i64(ins_dst as i64, 24)
                        if off_d < 0 do
                            var move_value_reg = rs1
                            src_for_spill_typ = 0
                            if (ins_src1 as i64) != 0 do
                                src_for_spill_typ = native_read_i64(ins_src1 as i64, 0)
                            end
                            if src_for_spill_typ == 4 do
                                src_off = native_read_i64(ins_src1 as i64, 24)
                                cb = x86_emit_mov_reg_imm32(cb, SCR as int, src_off as int)
                                cb = x86_emit_add_rr(cb, SCR as int, X86_RBP)
                                cb = x86_emit_mov_reg_mem(cb, SCR as int, SCR as int, 0)
                                move_value_reg = SCR
                            eif src_for_spill_typ == 5 do
                                cb = x86_emit_mov_reg_imm64(cb, SCR as int, native_read_i64(ins_src1 as i64, 32) as int)
                                move_value_reg = SCR
                            end
                            if move_value_reg >= 0 do
                                addr_reg = SCR
                                if move_value_reg == SCR do addr_reg = SCR2 end
                                cb = x86_emit_mov_reg_imm32(cb, addr_reg as int, off_d as int)
                                cb = x86_emit_add_rr(cb, addr_reg as int, X86_RBP)
                                cb = x86_emit_mov_mem_reg(cb, addr_reg as int, 0, move_value_reg as int)
                            end
                        end
                    end
                end
            eif op == LirOp.Add do
                a = resolve_or_imm_reg_x86(cb, ins_src1, assigned_phys, SCR)
                breg = resolve_or_imm_reg_x86(cb, ins_src2, assigned_phys, SCR2)
                add_dst = rd
                if add_dst < 0 and (ins_dst as i64) != 0 and native_read_i64(ins_dst as i64, 0) == 4 do
                    add_dst = X86_RAX
                end
                if add_dst >= 0 and a >= 0 and breg >= 0 do
                    if ins_typ == (LirType.F64 as i64) do
                        cb = x86_emit_movq_xmm_gpr(cb, 0, a as int)
                        cb = x86_emit_movq_xmm_gpr(cb, 1, breg as int)
                        cb = x86_emit_addsd_xx(cb, 0, 1)
                        cb = x86_emit_movq_gpr_xmm(cb, add_dst as int, 0)
                    eif ins_typ == (LirType.F32 as i64) do
                        cb = x86_emit_movq_xmm_gpr(cb, 0, a as int)
                        cb = x86_emit_movq_xmm_gpr(cb, 1, breg as int)
                        cb = x86_emit_addss_xx(cb, 0, 1)
                        cb = x86_emit_movq_gpr_xmm(cb, add_dst as int, 0)
                    else
                        # Allocated operands never use RAX; reserve it for a
                        # stack destination so neither input is clobbered.
                        if add_dst == breg and add_dst != a do
                            cb = x86_emit_add_rr(cb, add_dst as int, a as int)
                        else
                            if add_dst != a do cb = x86_emit_mov_rr(cb, add_dst as int, a as int) end
                            cb = x86_emit_add_rr(cb, add_dst as int, breg as int)
                        end
                    end
                    cb = store_spilled_result_x86(cb, ins_dst as LirOperand, add_dst)
                end
            eif op == LirOp.Sub do
                a = resolve_or_imm_reg_x86(cb, ins_src1, assigned_phys, SCR)
                breg = resolve_or_imm_reg_x86(cb, ins_src2, assigned_phys, SCR2)
                sub_dst = rd
                if sub_dst < 0 and (ins_dst as i64) != 0 and native_read_i64(ins_dst as i64, 0) == 4 do
                    sub_dst = X86_RAX
                end
                if sub_dst >= 0 and a >= 0 and breg >= 0 do
                    if ins_typ == (LirType.F64 as i64) do
                        cb = x86_emit_movq_xmm_gpr(cb, 0, a as int)
                        cb = x86_emit_movq_xmm_gpr(cb, 1, breg as int)
                        cb = x86_emit_subsd_xx(cb, 0, 1)
                        cb = x86_emit_movq_gpr_xmm(cb, sub_dst as int, 0)
                    eif ins_typ == (LirType.F32 as i64) do
                        cb = x86_emit_movq_xmm_gpr(cb, 0, a as int)
                        cb = x86_emit_movq_xmm_gpr(cb, 1, breg as int)
                        cb = x86_emit_subss_xx(cb, 0, 1)
                        cb = x86_emit_movq_gpr_xmm(cb, sub_dst as int, 0)
                    else
                        if sub_dst == breg and sub_dst != a do
                            cb = x86_emit_mov_rr(cb, SCR as int, a as int)
                            cb = x86_emit_sub_rr(cb, SCR as int, sub_dst as int)
                            cb = x86_emit_mov_rr(cb, sub_dst as int, SCR as int)
                        else
                            if sub_dst != a do cb = x86_emit_mov_rr(cb, sub_dst as int, a as int) end
                            cb = x86_emit_sub_rr(cb, sub_dst as int, breg as int)
                        end
                    end
                    cb = store_spilled_result_x86(cb, ins_dst as LirOperand, sub_dst)
                end
            eif op == LirOp.Mul do
                a = resolve_or_imm_reg_x86(cb, ins_src1, assigned_phys, SCR)
                breg = resolve_or_imm_reg_x86(cb, ins_src2, assigned_phys, SCR2)
                mul_dst = rd
                if mul_dst < 0 and (ins_dst as i64) != 0 and native_read_i64(ins_dst as i64, 0) == 4 do
                    mul_dst = X86_RAX
                end
                if mul_dst >= 0 and a >= 0 and breg >= 0 do
                    if ins_typ == (LirType.F64 as i64) do
                        cb = x86_emit_movq_xmm_gpr(cb, 0, a as int)
                        cb = x86_emit_movq_xmm_gpr(cb, 1, breg as int)
                        cb = x86_emit_mulsd_xx(cb, 0, 1)
                        cb = x86_emit_movq_gpr_xmm(cb, mul_dst as int, 0)
                    eif ins_typ == (LirType.F32 as i64) do
                        cb = x86_emit_movq_xmm_gpr(cb, 0, a as int)
                        cb = x86_emit_movq_xmm_gpr(cb, 1, breg as int)
                        cb = x86_emit_mulss_xx(cb, 0, 1)
                        cb = x86_emit_movq_gpr_xmm(cb, mul_dst as int, 0)
                    else
                        if mul_dst == breg and mul_dst != a do
                            cb = x86_emit_imul_rr(cb, mul_dst as int, a as int)
                        else
                            if mul_dst != a do cb = x86_emit_mov_rr(cb, mul_dst as int, a as int) end
                            cb = x86_emit_imul_rr(cb, mul_dst as int, breg as int)
                        end
                    end
                    cb = store_spilled_result_x86(cb, ins_dst as LirOperand, mul_dst)
                end
            eif op == LirOp.Div do
                a = resolve_or_imm_reg_x86(cb, ins_src1, assigned_phys, SCR)
                breg = resolve_or_imm_reg_x86(cb, ins_src2, assigned_phys, SCR2)
                div_dst = rd
                if div_dst < 0 and (ins_dst as i64) != 0 and native_read_i64(ins_dst as i64, 0) == 4 do
                    div_dst = X86_RAX
                end
                if div_dst >= 0 and a >= 0 and breg >= 0 do
                    if ins_typ == (LirType.F64 as i64) do
                        cb = x86_emit_movq_xmm_gpr(cb, 0, a as int)
                        cb = x86_emit_movq_xmm_gpr(cb, 1, breg as int)
                        cb = x86_emit_divsd_xx(cb, 0, 1)
                        cb = x86_emit_movq_gpr_xmm(cb, div_dst as int, 0)
                    eif ins_typ == (LirType.F32 as i64) do
                        cb = x86_emit_movq_xmm_gpr(cb, 0, a as int)
                        cb = x86_emit_movq_xmm_gpr(cb, 1, breg as int)
                        cb = x86_emit_divss_xx(cb, 0, 1)
                        cb = x86_emit_movq_gpr_xmm(cb, div_dst as int, 0)
                    else
                        cb = x86_emit_mov_rr(cb, X86_RAX, a as int)
                        cb = x86_emit_cqo(cb)
                        cb = x86_emit_idiv(cb, breg as int)
                        if div_dst != X86_RAX do
                            cb = x86_emit_mov_rr(cb, div_dst as int, X86_RAX)
                        end
                    end
                    cb = store_spilled_result_x86(cb, ins_dst as LirOperand, div_dst)
                end
            eif op == LirOp.Rem do
                a = resolve_or_imm_reg_x86(cb, ins_src1, assigned_phys, SCR)
                breg = resolve_or_imm_reg_x86(cb, ins_src2, assigned_phys, SCR2)
                rem_dst = rd
                if rem_dst < 0 and (ins_dst as i64) != 0 and native_read_i64(ins_dst as i64, 0) == 4 do
                    rem_dst = X86_RDX
                end
                if rem_dst >= 0 and a >= 0 and breg >= 0 do
                    cb = x86_emit_mov_rr(cb, X86_RAX, a as int)
                    cb = x86_emit_cqo(cb)
                    cb = x86_emit_idiv(cb, breg as int)
                    if rem_dst != X86_RDX do
                        cb = x86_emit_mov_rr(cb, rem_dst as int, X86_RDX)
                    end
                    cb = store_spilled_result_x86(cb, ins_dst as LirOperand, rem_dst)
                end
            eif op == LirOp.And do
                a = resolve_or_imm_reg_x86(cb, ins_src1, assigned_phys, SCR)
                breg = resolve_or_imm_reg_x86(cb, ins_src2, assigned_phys, SCR2)
                and_dst = rd
                if and_dst < 0 and (ins_dst as i64) != 0 and native_read_i64(ins_dst as i64, 0) == 4 do
                    and_dst = X86_RAX
                end
                if and_dst >= 0 and a >= 0 and breg >= 0 do
                    if and_dst == breg and and_dst != a do
                        cb = x86_emit_and_rr(cb, and_dst as int, a as int)
                    else
                        if and_dst != a do cb = x86_emit_mov_rr(cb, and_dst as int, a as int) end
                        cb = x86_emit_and_rr(cb, and_dst as int, breg as int)
                    end
                    cb = store_spilled_result_x86(cb, ins_dst as LirOperand, and_dst)
                end
            eif op == LirOp.Or do
                a = resolve_or_imm_reg_x86(cb, ins_src1, assigned_phys, SCR)
                breg = resolve_or_imm_reg_x86(cb, ins_src2, assigned_phys, SCR2)
                or_dst = rd
                if or_dst < 0 and (ins_dst as i64) != 0 and native_read_i64(ins_dst as i64, 0) == 4 do
                    or_dst = X86_RAX
                end
                if or_dst >= 0 and a >= 0 and breg >= 0 do
                    if or_dst == breg and or_dst != a do
                        cb = x86_emit_or_rr(cb, or_dst as int, a as int)
                    else
                        if or_dst != a do cb = x86_emit_mov_rr(cb, or_dst as int, a as int) end
                        cb = x86_emit_or_rr(cb, or_dst as int, breg as int)
                    end
                    cb = store_spilled_result_x86(cb, ins_dst as LirOperand, or_dst)
                end
            eif op == LirOp.Xor do
                a = resolve_or_imm_reg_x86(cb, ins_src1, assigned_phys, SCR)
                breg = resolve_or_imm_reg_x86(cb, ins_src2, assigned_phys, SCR2)
                xor_dst = rd
                if xor_dst < 0 and (ins_dst as i64) != 0 and native_read_i64(ins_dst as i64, 0) == 4 do
                    xor_dst = X86_RAX
                end
                if xor_dst >= 0 and a >= 0 and breg >= 0 do
                    if xor_dst == breg and xor_dst != a do
                        cb = x86_emit_xor_rr(cb, xor_dst as int, a as int)
                    else
                        if xor_dst != a do cb = x86_emit_mov_rr(cb, xor_dst as int, a as int) end
                        cb = x86_emit_xor_rr(cb, xor_dst as int, breg as int)
                    end
                    cb = store_spilled_result_x86(cb, ins_dst as LirOperand, xor_dst)
                end
            eif op == LirOp.Shl do
                a = resolve_or_imm_reg_x86(cb, ins_src1, assigned_phys, SCR)
                breg = resolve_or_imm_reg_x86(cb, ins_src2, assigned_phys, SCR2)
                shl_dst = rd
                if shl_dst < 0 and (ins_dst as i64) != 0 and native_read_i64(ins_dst as i64, 0) == 4 do
                    shl_dst = X86_RAX
                end
                if shl_dst >= 0 and a >= 0 and breg >= 0 do
                    cb = x86_emit_mov_rr(cb, X86_RCX, breg as int)
                    if shl_dst != a do cb = x86_emit_mov_rr(cb, shl_dst as int, a as int) end
                    cb = x86_emit_shl_cl(cb, shl_dst as int)
                    cb = store_spilled_result_x86(cb, ins_dst as LirOperand, shl_dst)
                end
            eif op == LirOp.Shr do
                a = resolve_or_imm_reg_x86(cb, ins_src1, assigned_phys, SCR)
                breg = resolve_or_imm_reg_x86(cb, ins_src2, assigned_phys, SCR2)
                shr_dst = rd
                if shr_dst < 0 and (ins_dst as i64) != 0 and native_read_i64(ins_dst as i64, 0) == 4 do
                    shr_dst = X86_RAX
                end
                if shr_dst >= 0 and a >= 0 and breg >= 0 do
                    cb = x86_emit_mov_rr(cb, X86_RCX, breg as int)
                    if shr_dst != a do cb = x86_emit_mov_rr(cb, shr_dst as int, a as int) end
                    cb = x86_emit_shr_cl(cb, shr_dst as int)
                    cb = store_spilled_result_x86(cb, ins_dst as LirOperand, shr_dst)
                end
            eif op == LirOp.Not do
                a = resolve_or_imm_reg_x86(cb, ins_src1, assigned_phys, SCR)
                not_dst = rd
                if not_dst < 0 and (ins_dst as i64) != 0 and native_read_i64(ins_dst as i64, 0) == 4 do
                    not_dst = X86_RAX
                end
                if not_dst >= 0 and a >= 0 do
                    cb = x86_emit_mov_rr(cb, not_dst as int, a as int)
                    cb = x86_emit_not_rr(cb, not_dst as int)
                    cb = store_spilled_result_x86(cb, ins_dst as LirOperand, not_dst)
                end
            eif op == LirOp.Pow do
                a_pow = resolve_or_imm_reg_x86(cb, ins_src1, assigned_phys, SCR)
                b_pow = resolve_or_imm_reg_x86(cb, ins_src2, assigned_phys, SCR2)
                if a_pow == X86_RSI and b_pow == X86_RDI do
                    cb = x86_emit_mov_rr(cb, X86_RAX, X86_RDI)
                    cb = x86_emit_mov_rr(cb, X86_RDI, X86_RSI)
                    cb = x86_emit_mov_rr(cb, X86_RSI, X86_RAX)
                eif b_pow == X86_RDI and a_pow != X86_RDI do
                    cb = x86_emit_mov_rr(cb, X86_RAX, X86_RDI)
                    if a_pow >= 0 do cb = x86_emit_mov_rr(cb, X86_RDI, a_pow as int) end
                    cb = x86_emit_mov_rr(cb, X86_RSI, X86_RAX)
                eif a_pow == X86_RSI do
                    cb = x86_emit_mov_rr(cb, X86_RDI, X86_RSI)
                    if b_pow >= 0 and b_pow != X86_RSI do cb = x86_emit_mov_rr(cb, X86_RSI, b_pow as int) end
                else
                    if b_pow >= 0 and b_pow != X86_RSI do cb = x86_emit_mov_rr(cb, X86_RSI, b_pow as int) end
                    if a_pow >= 0 and a_pow != X86_RDI do cb = x86_emit_mov_rr(cb, X86_RDI, a_pow as int) end
                end
                cb = emit_call_fixup_x86(cb, call_fixups, 1, LIR_RT_POW, rd)
                if rd < 0 do
                    cb = store_spilled_result_x86(cb, ins_dst as LirOperand, X86_RAX)
                end
            eif op == LirOp.MatMul or op == LirOp.Fma do
                a_dot = resolve_or_imm_reg_x86(cb, ins_src1, assigned_phys, SCR)
                b_dot = resolve_or_imm_reg_x86(cb, ins_src2, assigned_phys, SCR2)
                # Parallel move A/B into the SysV RDI/RSI argument pair without
                # losing an operand when the allocator chose the opposite pair.
                if a_dot == X86_RSI and b_dot == X86_RDI do
                    cb = x86_emit_mov_rr(cb, X86_RAX, X86_RDI)
                    cb = x86_emit_mov_rr(cb, X86_RDI, X86_RSI)
                    cb = x86_emit_mov_rr(cb, X86_RSI, X86_RAX)
                eif b_dot == X86_RDI and a_dot != X86_RDI do
                    cb = x86_emit_mov_rr(cb, X86_RAX, X86_RDI)
                    if a_dot >= 0 do cb = x86_emit_mov_rr(cb, X86_RDI, a_dot as int) end
                    cb = x86_emit_mov_rr(cb, X86_RSI, X86_RAX)
                eif a_dot == X86_RSI do
                    cb = x86_emit_mov_rr(cb, X86_RDI, X86_RSI)
                    if b_dot >= 0 and b_dot != X86_RSI do cb = x86_emit_mov_rr(cb, X86_RSI, b_dot as int) end
                else
                    if b_dot >= 0 and b_dot != X86_RSI do cb = x86_emit_mov_rr(cb, X86_RSI, b_dot as int) end
                    if a_dot >= 0 and a_dot != X86_RDI do cb = x86_emit_mov_rr(cb, X86_RDI, a_dot as int) end
                end
                dot_is_float = (ins_aux shr 48) and 1
                var dot_is_32bit = (ins_aux shr 49) and 1
                dot_is_quant = (ins_aux shr 50) and 1
                var dot_is_16bit = (ins_aux shr 51) and 1
                dot_m = (ins_aux shr 32) and 65535
                dot_k = (ins_aux shr 16) and 65535
                dot_n = ins_aux and 65535
                var dot_width_code = 0
                if dot_is_16bit == 1 do
                    dot_width_code = 2
                eif dot_is_32bit == 1 do
                    dot_width_code = 1
                end
                cb = x86_emit_mov_reg_imm32(cb, X86_RDX, dot_m as int)
                cb = x86_emit_mov_reg_imm32(cb, X86_RCX, dot_k as int)
                cb = x86_emit_mov_reg_imm32(cb, X86_R8, dot_n as int)
                cb = x86_emit_mov_reg_imm32(cb, X86_R9, dot_width_code as int)
                dot_stub = LIR_RT_MATMUL
                if dot_is_quant == 1 do
                    dot_stub = LIR_RT_MATMUL_QUANTIZED
                eif dot_is_float == 1 do
                    dot_stub = LIR_RT_MATMUL_F64
                    if op == LirOp.Fma do dot_stub = LIR_RT_FMA_F64 end
                else
                    if op == LirOp.Fma do dot_stub = LIR_RT_FMA end
                end
                cb = emit_call_fixup_x86(cb, call_fixups, 1, dot_stub, rd)
                if rd < 0 and (ins_dst as i64) != 0 do
                    dst_dot_typ = native_read_i64(ins_dst as i64, 0)
                    if dst_dot_typ == 4 do
                        dst_dot_off = native_read_i64(ins_dst as i64, 24)
                        if dst_dot_off < 0 do
                            cb = x86_emit_mov_reg_imm32(cb, SCR as int, dst_dot_off as int)
                            cb = x86_emit_add_rr(cb, SCR as int, X86_RBP)
                            cb = x86_emit_mov_mem_reg(cb, SCR as int, 0, X86_RAX)
                        end
                    end
                end
            eif op == LirOp.VAdd or op == LirOp.VSub or op == LirOp.VMul or op == LirOp.VFma do
                a = resolve_or_imm_reg_x86(cb, ins_src1, assigned_phys, SCR)
                breg = resolve_or_imm_reg_x86(cb, ins_src2, assigned_phys, SCR2)
                v_aux = native_read_i64(ins as i64, 40)
                var v_lanes = (v_aux shr 8) and 255
                if v_lanes <= 0 do v_lanes = 4 end
                var v_is_float = 0
                if (v_aux and 255) == 2 or ins_typ == (LirType.F64 as i64) or ins_typ == (LirType.F32 as i64) do
                    v_is_float = 1
                end
                let v_l_scalar = (v_aux shr 24) and 1
                let v_r_scalar = (v_aux shr 25) and 1
                let v_dyn_idx = (v_aux shr 26) and 1

                var r_dst = rd
                if r_dst < 0 and (ins_dst as i64) != 0 do
                    r_dst = resolve_or_imm_reg_x86(cb, ins_dst, assigned_phys, X86_RAX)
                end
                if r_dst >= 0 and a >= 0 and breg >= 0 do
                    var vi = 0
                    if v_dyn_idx == 1 do
                        let r_idx = resolve_or_imm_reg_x86(cb, vec_get_rt(recent_setargs, 0) as LirOperand, assigned_phys, X86_RCX)
                        if target_has_sse2() == 1 and (v_is_float == 1 or op == LirOp.VAdd or op == LirOp.VSub) and v_lanes == 2 do
                            if r_idx != X86_RCX do cb = x86_emit_mov_rr(cb, X86_RCX, r_idx as int) end
                            cb = x86_emit_shl_imm(cb, X86_RCX, 3)
                            cb = x86_emit_mov_reg_imm32(cb, X86_RDX, 16)
                            cb = x86_emit_add_rr(cb, X86_RCX, X86_RDX)
                            if v_l_scalar == 1 do
                                cb = x86_emit_movq_xmm_gpr(cb, 0, a as int)
                                cb = x86_emit_punpcklqdq(cb, 0, 0)
                            else
                                cb = x86_emit_mov_rr(cb, X86_RDX, a as int)
                                cb = x86_emit_add_rr(cb, X86_RDX, X86_RCX)
                                cb = x86_emit_movdqu_load(cb, 0, X86_RDX, 0)
                            end
                            if v_r_scalar == 1 do
                                cb = x86_emit_movq_xmm_gpr(cb, 1, breg as int)
                                cb = x86_emit_punpcklqdq(cb, 1, 1)
                            else
                                cb = x86_emit_mov_rr(cb, X86_RDX, breg as int)
                                cb = x86_emit_add_rr(cb, X86_RDX, X86_RCX)
                                cb = x86_emit_movdqu_load(cb, 1, X86_RDX, 0)
                            end
                            if v_is_float == 1 do
                                if op == LirOp.VAdd do
                                    cb = x86_emit_addpd(cb, 0, 1)
                                eif op == LirOp.VSub do
                                    cb = x86_emit_subpd(cb, 0, 1)
                                eif op == LirOp.VMul do
                                    cb = x86_emit_mulpd(cb, 0, 1)
                                eif op == LirOp.VFma do
                                    cb = x86_emit_mulpd(cb, 0, 1)
                                    cb = x86_emit_mov_rr(cb, X86_RDX, r_dst as int)
                                    cb = x86_emit_add_rr(cb, X86_RDX, X86_RCX)
                                    cb = x86_emit_movdqu_load(cb, 2, X86_RDX, 0)
                                    cb = x86_emit_addpd(cb, 0, 2)
                                end
                            else
                                if op == LirOp.VAdd do
                                    cb = x86_emit_paddq(cb, 0, 1)
                                eif op == LirOp.VSub do
                                    cb = x86_emit_psubq(cb, 0, 1)
                                end
                            end
                            cb = x86_emit_mov_rr(cb, X86_RDX, r_dst as int)
                            cb = x86_emit_add_rr(cb, X86_RDX, X86_RCX)
                            cb = x86_emit_movdqu_store(cb, X86_RDX, 0, 0)
                            vi = 2
                        end
                        when vi < v_lanes loop
                            if r_idx != X86_RCX do cb = x86_emit_mov_rr(cb, X86_RCX, r_idx as int) end
                            if vi > 0 do
                                cb = x86_emit_mov_reg_imm32(cb, X86_RDX, vi as int)
                                cb = x86_emit_add_rr(cb, X86_RCX, X86_RDX)
                            end
                            cb = x86_emit_shl_imm(cb, X86_RCX, 3)
                            cb = x86_emit_mov_reg_imm32(cb, X86_RDX, 16)
                            cb = x86_emit_add_rr(cb, X86_RCX, X86_RDX)
                            if v_is_float == 1 do
                                if v_l_scalar == 1 do
                                    cb = x86_emit_movq_xmm_gpr(cb, 0, a as int)
                                else
                                    cb = x86_emit_mov_rr(cb, X86_RDX, a as int)
                                    cb = x86_emit_add_rr(cb, X86_RDX, X86_RCX)
                                    cb = x86_emit_mov_reg_mem(cb, SCR as int, X86_RDX, 0)
                                    cb = x86_emit_movq_xmm_gpr(cb, 0, SCR as int)
                                end
                                if v_r_scalar == 1 do
                                    cb = x86_emit_movq_xmm_gpr(cb, 1, breg as int)
                                else
                                    cb = x86_emit_mov_rr(cb, X86_RDX, breg as int)
                                    cb = x86_emit_add_rr(cb, X86_RDX, X86_RCX)
                                    cb = x86_emit_mov_reg_mem(cb, SCR2 as int, X86_RDX, 0)
                                    cb = x86_emit_movq_xmm_gpr(cb, 1, SCR2 as int)
                                end
                                if op == LirOp.VAdd do
                                    cb = x86_emit_addsd_xx(cb, 0, 1)
                                eif op == LirOp.VSub do
                                    cb = x86_emit_subsd_xx(cb, 0, 1)
                                eif op == LirOp.VMul do
                                    cb = x86_emit_mulsd_xx(cb, 0, 1)
                                end
                                cb = x86_emit_movq_gpr_xmm(cb, SCR as int, 0)
                                cb = x86_emit_mov_rr(cb, X86_RDX, r_dst as int)
                                cb = x86_emit_add_rr(cb, X86_RDX, X86_RCX)
                                cb = x86_emit_mov_mem_reg(cb, X86_RDX, 0, SCR as int)
                            else
                                if v_l_scalar == 1 do
                                    if a != SCR do cb = x86_emit_mov_rr(cb, SCR as int, a as int) end
                                else
                                    cb = x86_emit_mov_rr(cb, X86_RDX, a as int)
                                    cb = x86_emit_add_rr(cb, X86_RDX, X86_RCX)
                                    cb = x86_emit_mov_reg_mem(cb, SCR as int, X86_RDX, 0)
                                end
                                if v_r_scalar == 1 do
                                    if breg != SCR2 do cb = x86_emit_mov_rr(cb, SCR2 as int, breg as int) end
                                else
                                    cb = x86_emit_mov_rr(cb, X86_RDX, breg as int)
                                    cb = x86_emit_add_rr(cb, X86_RDX, X86_RCX)
                                    cb = x86_emit_mov_reg_mem(cb, SCR2 as int, X86_RDX, 0)
                                end
                                if op == LirOp.VAdd do
                                    cb = x86_emit_add_rr(cb, SCR as int, SCR2 as int)
                                eif op == LirOp.VSub do
                                    cb = x86_emit_sub_rr(cb, SCR as int, SCR2 as int)
                                eif op == LirOp.VMul do
                                    cb = x86_emit_imul_rr(cb, SCR as int, SCR2 as int)
                                end
                                cb = x86_emit_mov_rr(cb, X86_RDX, r_dst as int)
                                cb = x86_emit_add_rr(cb, X86_RDX, X86_RCX)
                                cb = x86_emit_mov_mem_reg(cb, X86_RDX, 0, SCR as int)
                            end
                            vi = vi + 1
                        end
                    else
                        if target_has_sse2() == 1 and (v_is_float == 1 or op == LirOp.VAdd or op == LirOp.VSub) do
                            when vi + 2 <= v_lanes loop
                                let lane_off = (16 + vi * 8) as int
                                if v_l_scalar == 1 do
                                    cb = x86_emit_movq_xmm_gpr(cb, 0, a as int)
                                    cb = x86_emit_punpcklqdq(cb, 0, 0)
                                else
                                    cb = x86_emit_movdqu_load(cb, 0, a as int, lane_off)
                                end
                                if v_r_scalar == 1 do
                                    cb = x86_emit_movq_xmm_gpr(cb, 1, breg as int)
                                    cb = x86_emit_punpcklqdq(cb, 1, 1)
                                else
                                    cb = x86_emit_movdqu_load(cb, 1, breg as int, lane_off)
                                end
                                if v_is_float == 1 do
                                    if op == LirOp.VAdd do
                                        cb = x86_emit_addpd(cb, 0, 1)
                                    eif op == LirOp.VSub do
                                        cb = x86_emit_subpd(cb, 0, 1)
                                    eif op == LirOp.VMul do
                                        cb = x86_emit_mulpd(cb, 0, 1)
                                    eif op == LirOp.VFma do
                                        cb = x86_emit_mulpd(cb, 0, 1)
                                        cb = x86_emit_movdqu_load(cb, 2, r_dst as int, lane_off)
                                        cb = x86_emit_addpd(cb, 0, 2)
                                    end
                                else
                                    if op == LirOp.VAdd do
                                        cb = x86_emit_paddq(cb, 0, 1)
                                    eif op == LirOp.VSub do
                                        cb = x86_emit_psubq(cb, 0, 1)
                                    end
                                end
                                cb = x86_emit_movdqu_store(cb, r_dst as int, lane_off, 0)
                                vi = vi + 2
                            end
                        end
                        when vi < v_lanes loop
                            let lane_off = (16 + vi * 8) as int
                            if v_is_float == 1 do
                                if v_l_scalar == 1 do
                                    cb = x86_emit_movq_xmm_gpr(cb, 0, a as int)
                                else
                                    cb = x86_emit_mov_reg_mem(cb, SCR as int, a as int, lane_off)
                                    cb = x86_emit_movq_xmm_gpr(cb, 0, SCR as int)
                                end
                                if v_r_scalar == 1 do
                                    cb = x86_emit_movq_xmm_gpr(cb, 1, breg as int)
                                else
                                    cb = x86_emit_mov_reg_mem(cb, SCR2 as int, breg as int, lane_off)
                                    cb = x86_emit_movq_xmm_gpr(cb, 1, SCR2 as int)
                                end
                                if op == LirOp.VAdd do
                                    cb = x86_emit_addsd_xx(cb, 0, 1)
                                eif op == LirOp.VSub do
                                    cb = x86_emit_subsd_xx(cb, 0, 1)
                                eif op == LirOp.VMul do
                                    cb = x86_emit_mulsd_xx(cb, 0, 1)
                                end
                                cb = x86_emit_movq_gpr_xmm(cb, SCR as int, 0)
                                cb = x86_emit_mov_mem_reg(cb, r_dst as int, lane_off, SCR as int)
                            else
                                if v_l_scalar == 1 do
                                    if a != SCR do cb = x86_emit_mov_rr(cb, SCR as int, a as int) end
                                else
                                    cb = x86_emit_mov_reg_mem(cb, SCR as int, a as int, lane_off)
                                end
                                if v_r_scalar == 1 do
                                    if breg != SCR2 do cb = x86_emit_mov_rr(cb, SCR2 as int, breg as int) end
                                else
                                    cb = x86_emit_mov_reg_mem(cb, SCR2 as int, breg as int, lane_off)
                                end
                                if op == LirOp.VAdd do
                                    cb = x86_emit_add_rr(cb, SCR as int, SCR2 as int)
                                eif op == LirOp.VSub do
                                    cb = x86_emit_sub_rr(cb, SCR as int, SCR2 as int)
                                eif op == LirOp.VMul do
                                    cb = x86_emit_imul_rr(cb, SCR as int, SCR2 as int)
                                end
                                cb = x86_emit_mov_mem_reg(cb, r_dst as int, lane_off, SCR as int)
                            end
                            vi = vi + 1
                        end
                    end
                end
            eif op == LirOp.Splat do
                a = resolve_or_imm_reg_x86(cb, ins_src1, assigned_phys, SCR)
                s_aux = native_read_i64(ins as i64, 40)
                var s_lanes = (s_aux shr 8) and 255
                if s_lanes <= 0 do s_lanes = 4 end
                var r_dst = rd
                if r_dst < 0 and (ins_dst as i64) != 0 do
                    r_dst = resolve_or_imm_reg_x86(cb, ins_dst, assigned_phys, X86_RAX)
                end
                if r_dst >= 0 and a >= 0 do
                    var si = 0
                    if target_has_sse2() == 1 do
                        cb = x86_emit_movq_xmm_gpr(cb, 0, a as int)
                        cb = x86_emit_punpcklqdq(cb, 0, 0)
                        when si + 2 <= s_lanes loop
                            cb = x86_emit_movdqu_store(cb, r_dst as int, (16 + si * 8) as int, 0)
                            si = si + 2
                        end
                    end
                    when si < s_lanes loop
                        cb = x86_emit_mov_mem_reg(cb, r_dst as int, (16 + si * 8) as int, a as int)
                        si = si + 1
                    end
                end
            eif op == LirOp.Shuffle do
                a = resolve_or_imm_reg_x86(cb, ins_src1, assigned_phys, SCR)
                sh_aux = native_read_i64(ins as i64, 40)
                var sh_lanes = (sh_aux shr 8) and 255
                if sh_lanes <= 0 do sh_lanes = 4 end
                let sh_mask = (sh_aux shr 32)
                if rd >= 0 and a >= 0 do
                    var shi = 0
                    when shi < sh_lanes loop
                        let src_lane = (sh_mask shr (shi * 4)) and 15
                        cb = x86_emit_mov_reg_mem(cb, SCR2 as int, a as int, (16 + src_lane * 8) as int)
                        cb = x86_emit_mov_mem_reg(cb, rd as int, (16 + shi * 8) as int, SCR2 as int)
                        shi = shi + 1
                    end
                end
            eif op == LirOp.VLoad do
                a = resolve_or_imm_reg_x86(cb, ins_src1, assigned_phys, SCR)
                vl_aux = native_read_i64(ins as i64, 40)
                var vl_lanes = (vl_aux shr 8) and 255
                if vl_lanes <= 0 do vl_lanes = 4 end
                var r_dst = rd
                if r_dst < 0 and (ins_dst as i64) != 0 do
                    r_dst = resolve_or_imm_reg_x86(cb, ins_dst, assigned_phys, X86_RAX)
                end
                if r_dst >= 0 and a >= 0 do
                    var vli = 0
                    if target_has_sse2() == 1 do
                        when vli + 2 <= vl_lanes loop
                            cb = x86_emit_movdqu_load(cb, 0, a as int, (vli * 8) as int)
                            cb = x86_emit_movdqu_store(cb, r_dst as int, (16 + vli * 8) as int, 0)
                            vli = vli + 2
                        end
                    end
                    when vli < vl_lanes loop
                        cb = x86_emit_mov_reg_mem(cb, SCR2 as int, a as int, (vli * 8) as int)
                        cb = x86_emit_mov_mem_reg(cb, r_dst as int, (16 + vli * 8) as int, SCR2 as int)
                        vli = vli + 1
                    end
                end
            eif op == LirOp.VStore do
                a = resolve_or_imm_reg_x86(cb, ins_src1, assigned_phys, SCR)
                breg = resolve_or_imm_reg_x86(cb, ins_src2, assigned_phys, SCR2)
                vs_aux = native_read_i64(ins as i64, 40)
                var vs_lanes = (vs_aux shr 8) and 255
                if vs_lanes <= 0 do vs_lanes = 4 end
                if a >= 0 and breg >= 0 do
                    var vsi = 0
                    if target_has_sse2() == 1 do
                        when vsi + 2 <= vs_lanes loop
                            cb = x86_emit_movdqu_load(cb, 0, breg as int, (16 + vsi * 8) as int)
                            cb = x86_emit_movdqu_store(cb, a as int, (vsi * 8) as int, 0)
                            vsi = vsi + 2
                        end
                    end
                    when vsi < vs_lanes loop
                        cb = x86_emit_mov_reg_mem(cb, SCR as int, breg as int, (16 + vsi * 8) as int)
                        cb = x86_emit_mov_mem_reg(cb, a as int, (vsi * 8) as int, SCR as int)
                        vsi = vsi + 1
                    end
                end
            eif op == LirOp.Cmp do
                a = resolve_or_imm_reg_x86(cb, ins_src1, assigned_phys, SCR)
                breg = resolve_or_imm_reg_x86(cb, ins_src2, assigned_phys, SCR2)
                if a >= 0 and breg >= 0 do
                    cb = x86_emit_cmp_rr(cb, a as int, breg as int)
                end
                cmp_dst = rd
                if cmp_dst < 0 and (ins_dst as i64) != 0 and native_read_i64(ins_dst as i64, 0) == 4 do
                    cmp_dst = X86_RAX
                end
                if cmp_dst >= 0 do
                    cb = emit_setcc(cb, cmp_dst as int, ins_aux)
                    cb = store_spilled_result_x86(cb, ins_dst as LirOperand, cmp_dst)
                end
            eif op == LirOp.Load do
                if lir_is_valid_typed_mem_aux(ins_aux) == 0 do
                    print_str("virc: error: invalid typed memory aux in direct x86 Load codegen\n")
                    sys_exit(1)
                end
                load_base = resolve_or_imm_reg_x86(cb, ins_src1, assigned_phys, SCR)
                load_dst = rd
                if load_dst < 0 and (ins_dst as i64) != 0 and native_read_i64(ins_dst as i64, 0) == 4 do
                    load_dst = X86_RAX
                end
                if load_dst >= 0 and load_base >= 0 do
                    if ins_aux == 1 do
                        cb = x86_emit_movzx_reg_mem8(cb, load_dst as int, load_base as int, 0)
                    eif ins_aux == (0 - 1) do
                        cb = x86_emit_movsbq_reg_mem(cb, load_dst as int, load_base as int, 0)
                    eif ins_aux == 2 do
                        cb = x86_emit_movzwq_reg_mem(cb, load_dst as int, load_base as int, 0)
                    eif ins_aux == (0 - 2) do
                        cb = x86_emit_movswq_reg_mem(cb, load_dst as int, load_base as int, 0)
                    eif ins_aux == 4 do
                        cb = x86_emit_mov_reg_mem32(cb, load_dst as int, load_base as int, 0)
                    eif ins_aux == (0 - 4) do
                        cb = x86_emit_movslq_reg_mem(cb, load_dst as int, load_base as int, 0)
                    else
                        cb = x86_emit_mov_reg_mem(cb, load_dst as int, load_base as int, 0)
                    end
                    cb = store_spilled_result_x86(cb, ins_dst as LirOperand, load_dst)
                end
            eif op == LirOp.Store do
                # LIR Store is (src1=value, src2=address).
                if lir_is_valid_typed_mem_aux(ins_aux) == 0 do
                    print_str("virc: error: invalid typed memory aux in direct x86 Store codegen\n")
                    sys_exit(1)
                end
                store_base = resolve_or_imm_reg_x86(cb, ins_src2, assigned_phys, SCR)
                store_value = resolve_or_imm_reg_x86(cb, ins_src1, assigned_phys, SCR2)
                if store_base >= 0 and store_value >= 0 do
                    if ins_aux == 1 or ins_aux == (0 - 1) do
                        cb = x86_emit_mov_mem_reg8(cb, store_base as int, 0, store_value as int)
                    eif ins_aux == 2 or ins_aux == (0 - 2) do
                        cb = x86_emit_mov_mem_reg16(cb, store_base as int, 0, store_value as int)
                    eif ins_aux == 4 or ins_aux == (0 - 4) do
                        cb = x86_emit_mov_mem_reg32(cb, store_base as int, 0, store_value as int)
                    else
                        cb = x86_emit_mov_mem_reg(cb, store_base as int, 0, store_value as int)
                    end
                end
            eif op == LirOp.SetArg do
                if ins_aux >= 0 and ins_aux < 6 do vec_set_rt(recent_setargs, ins_aux, ins_src2) end
                pending_stk = emit_lir_setarg_x86(cb, ins, assigned_phys, pending_stk)
            eif op == LirOp.Call do
                pending_stk = emit_lir_call_x86(cb, ins, rd, func_obj, lir_funcs, call_fixups, pending_stk, assigned_phys)
            eif op == LirOp.Intrinsic do
                cb = emit_lir_intrinsic_x86(cb, ins, rd, rs1, assigned_phys, call_fixups, func_obj, str_fixups, recent_setargs, lir_funcs)
                if pending_stk > 0 do
                    let bytes = pending_stk * 8
                    if bytes > 0 and bytes <= 4096 do
                        cb = x86_emit_add_rsp_imm(cb, bytes)
                    end
                    pending_stk = 0
                end
            eif op == LirOp.Jmp do
                tgt = 0 - 1
                if (ins_src1 as i64) != 0 do
                    src1_typ = native_read_i64(ins_src1 as i64, 0)
                    if src1_typ == 6 do # Label
                        tgt = native_read_i64(ins_src1 as i64, 40)
                    eif src1_typ == 5 do # Imm
                        tgt = native_read_i64(ins_src1 as i64, 32)
                    end
                end
                if tgt >= 0 do
                    at = codebuf_offset(cb) as i64
                    cb = x86_emit_jmp_rel32(cb, 0)
                    fixups = vec_push_rt(fixups, x86_fixup_new(at + 1, tgt, 0))
                end
            eif op == LirOp.TailCall do
                if pending_stk > 0 do
                    var si = pending_stk - 1
                    when si >= 0 loop
                        cb = x86_emit_pop(cb, SCR as int)
                        cb = x86_emit_mov_mem_reg(cb, X86_RBP, (16 + si * 8) as int, SCR as int)
                        si = si - 1
                    end
                    pending_stk = 0
                end
                at = codebuf_offset(cb) as i64
                cb = x86_emit_jmp_rel32(cb, 0)
                fixups = vec_push_rt(fixups, x86_fixup_new(at + 1, 0, 0))
            eif op == LirOp.JmpCond do
                tgt = 0 - 1
                if (ins_src2 as i64) != 0 do
                    src2_typ = native_read_i64(ins_src2 as i64, 0)
                    if src2_typ == 6 do # Label
                        tgt = native_read_i64(ins_src2 as i64, 40)
                    eif src2_typ == 5 do # Imm
                        tgt = native_read_i64(ins_src2 as i64, 32)
                    end
                end
                a = resolve_or_imm_reg_x86(cb, ins_src1, assigned_phys, SCR)
                if a >= 0 do
                    cb = x86_emit_test_rr(cb, a as int, a as int)
                end
                if tgt >= 0 do
                    at = codebuf_offset(cb) as i64
                    kind = 2
                    if ins_aux == LIR_JMP_IFNOT do
                        kind = 1
                    end
                    if kind == 1 do
                        cb = x86_emit_je_rel32(cb, 0)
                    else
                        cb = x86_emit_jne_rel32(cb, 0)
                    end
                    fixups = vec_push_rt(fixups, x86_fixup_new(at + 2, tgt, kind))
                end
            eif op == LirOp.Ret do
                if (ins_src1 as i64) != 0 do
                    src1_typ = native_read_i64(ins_src1 as i64, 0)
                    if src1_typ == 5 do # Imm
                        imm_val = native_read_i64(ins_src1 as i64, 32)
                        cb = x86_emit_mov_reg_imm64(cb, X86_RAX, imm_val as int)
                    eif src1_typ == 4 do # StackMem reload
                        off = native_read_i64(ins_src1 as i64, 24)
                        if off < 0 do
                            cb = x86_emit_mov_reg_imm32(cb, SCR as int, off as int)
                            cb = x86_emit_add_rr(cb, SCR as int, X86_RBP)
                            cb = x86_emit_mov_reg_mem(cb, X86_RAX, SCR as int, 0)
                        end
                    eif rs1 >= 0 and rs1 != X86_RAX do
                        cb = x86_emit_mov_rr(cb, X86_RAX, rs1 as int)
                    eif src1_typ == 0 do
                        cb = x86_emit_xor_rr(cb, X86_RAX, X86_RAX)
                    end
                eif rs1 >= 0 and rs1 != X86_RAX do
                    cb = x86_emit_mov_rr(cb, X86_RAX, rs1 as int)
                else
                    cb = x86_emit_xor_rr(cb, X86_RAX, X86_RAX)
                end
                if stack_size > 0 do
                    cb = x86_emit_add_rsp_imm(cb, stack_size as int)
                end
                cb = emit_callee_restore_x86(cb)
                cb = x86_emit_mov_rr(cb, X86_RSP, X86_RBP)
                cb = x86_emit_pop(cb, X86_RBP)
                cb = x86_emit_ret(cb)
            end
            ii = ii + 1
        end
        bi = bi + 1
    end

    cb = x86_emit_mov_reg_imm64(cb, X86_RAX, 0)
    if stack_size > 0 do
        cb = x86_emit_add_rsp_imm(cb, stack_size as int)
    end
    cb = emit_callee_restore_x86(cb)
    cb = x86_emit_mov_rr(cb, X86_RSP, X86_RBP)
    cb = x86_emit_pop(cb, X86_RBP)
    cb = x86_emit_ret(cb)

    nf = vec_len_rt(fixups)
    var fxi = 0
    when fxi < nf loop
        fx = vec_get_rt(fixups, fxi)
        f_tgt = x86_fixup_target_block(fx)
        f_kind = x86_fixup_kind(fx)
        f_at = x86_fixup_at_off(fx)
        if f_tgt >= 0 and f_tgt < max_bid do
            dest = vec_get_rt(block_off, f_tgt)
            if dest >= 0 do
                cb = patch_rel32(cb, f_at as int, dest as int)
            end
        end
        fxi = fxi + 1
    end

    out cb
end.

