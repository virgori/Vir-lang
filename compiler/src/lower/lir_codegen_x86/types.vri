##
 * compiler/src/lower/lir_codegen_x86/types.vri — x86-64 ABI, Fixups & Frame Helpers
 * ==================================================================================
 ##

include types
include vec_rt
include string_rt
include rt.io
import print_str, print_int from rt.io
import sys_exit from rt.syscall
include lir
include mir
include ffi_imports
include codegen
include codegen_x86
include target
const X86_SYS_EXIT   = 60
const X86_SYS_WRITE  = 1
const X86_SYS_MMAP   = 9
const X86_MAP_ANON   = 0x20
const X86_MAP_PRIVATE = 0x02
const X86_PROT_RW    = 3

const SCR  = X86_R10
const SCR2 = X86_R11
const SCRQ = X86_RCX

func vec_new_cap_rt_x86(cap: int):
    base = alloc(16 + cap * 8)
    data = base + 16
    native_write_i64(base, 0, cap as i64)
    native_write_i64(base, 8, 0)
    out data
end.

func patch_rel32(cb: &CodeBuf, rel_off: int, dest_off: int):
    rel = dest_off - (rel_off + 4)
    out codebuf_patch_i32(cb, rel_off, rel)
end.

func x86_fixup_new(at_off: i64, target_block: i64, kind: i64):
    p = alloc(24)
    native_write_i64(p, 0, at_off)
    native_write_i64(p, 8, target_block)
    native_write_i64(p, 16, kind)
    out p
end.

func x86_fixup_at_off(fx: i64): out native_read_i64(fx, 0) end.
func x86_fixup_target_block(fx: i64): out native_read_i64(fx, 8) end.
func x86_fixup_kind(fx: i64): out native_read_i64(fx, 16) end.

func x86_call_fixup_new(at_off: i64, target_kind: i64, target_id: i64):
    p = alloc(24)
    native_write_i64(p, 0, at_off)
    native_write_i64(p, 8, target_kind)
    native_write_i64(p, 16, target_id)
    out p
end.

func x86_str_fixup_new(at_off: i64, str_val: i64, rd: i64):
    p = alloc(24)
    native_write_i64(p, 0, at_off)
    native_write_i64(p, 8, str_val)
    native_write_i64(p, 16, rd)
    out p
end.

func x86_intr_is_marker(kind: i64):
    if kind == MIR_INTR_NOP_MARKER or kind == MIR_INTR_DECL or kind == MIR_INTR_QUIET or kind == MIR_INTR_CHECK_CPU or kind == MIR_INTR_PATCH_POINT or kind == MIR_INTR_PRECOMP or kind == MIR_INTR_EXPOSE or kind == MIR_INTR_ASYNC or kind == MIR_INTR_ATOMIC_VAR or kind == MIR_INTR_TIMEOUT or kind == MIR_INTR_ISOLATE or kind == MIR_INTR_PTR or kind == MIR_INTR_AWAIT_PASS or kind == MIR_INTR_ENSURE or kind == MIR_INTR_REVERT or kind == MIR_INTR_ENUM or kind == MIR_INTR_ERROR or kind == MIR_INTR_EXIST or kind == MIR_INTR_REACTIVE or kind == MIR_INTR_MORPH do
        out 1
    end

    out 0
end.

func x86_intr_is_payload(kind: i64):
    if (kind and 0xFF) == MIR_INTR_CAST do
        out 1
    end
    out 0
end.

func x86_stub_for_builtin_id(bid: i64):
    if bid == 11 do out LIR_RT_STR_CAT end
    if bid == 12 do out LIR_RT_STR_EQ end
    if bid == 18 do out LIR_RT_EXIT_PROG end
    if bid == 19 do out LIR_RT_INT_TO_STR end
    if bid == 22 do out LIR_RT_PRINT_STR end
    if bid == 30 do out LIR_RT_SYSCALL end
    if bid == 1000 do out LIR_RT_BOOL_TO_STR end
    if bid == 3 or bid == 35 or bid == 49 or bid == 50 do out LIR_RT_ALLOC end
    if bid == 4 do out LIR_RT_FREE end
    if bid == 5 do out LIR_RT_NATIVE_READ_U8 end
    if bid == 6 do out LIR_RT_NATIVE_WRITE_U8 end
    if bid == 7 or bid == 46 do out LIR_RT_NATIVE_READ_I64 end
    if bid == 8 or bid == 47 do out LIR_RT_NATIVE_WRITE_I64 end
    if bid == 23 do out LIR_RT_GET_ARG end
    if bid == 24 do out LIR_RT_ARG_COUNT end
    if bid == 54 or bid == 60 or bid == 62 do out LIR_RT_VOLATILE_READ end
    if bid == 55 or bid == 61 or bid == 63 do out LIR_RT_VOLATILE_WRITE end
    if bid == 56 or bid == 58 do out LIR_RT_VOLATILE_READ8 end
    if bid == 57 or bid == 59 do out LIR_RT_VOLATILE_WRITE8 end
    if bid == 64 or bid == 39 do out LIR_RT_DMB end
    if bid == 65 do out LIR_RT_DSB end
    if bid == 66 do out LIR_RT_ISB end
    if bid == 67 do out LIR_RT_WFI end
    if bid == 68 do out LIR_RT_WFE end
    if bid == 69 do out LIR_RT_SEV end
    if bid == 70 do out LIR_RT_NOP end
    if bid == 40 or bid == 78 do out LIR_RT_ATOMIC_LOAD64 end
    if bid == 72 do out LIR_RT_ATOMIC_LOAD32 end
    if bid == 41 or bid == 79 do out LIR_RT_ATOMIC_STORE64 end
    if bid == 73 do out LIR_RT_ATOMIC_STORE32 end
    if bid == 43 or bid == 80 do out LIR_RT_ATOMIC_ADD64 end
    if bid == 74 do out LIR_RT_ATOMIC_ADD32 end
    if bid == 44 or bid == 81 do out LIR_RT_ATOMIC_SUB64 end
    if bid == 75 do out LIR_RT_ATOMIC_SUB32 end
    if bid == 42 or bid == 82 do out LIR_RT_ATOMIC_CAS64 end
    if bid == 76 do out LIR_RT_ATOMIC_CAS32 end
    if bid == 71 or bid == 83 do out LIR_RT_ATOMIC_EXCHANGE64 end
    if bid == 77 do out LIR_RT_ATOMIC_EXCHANGE32 end
    if bid == 105 do out LIR_RT_PLATFORM end
    out 0 - 1
end.

var g_x86_func_index_source: i64 = 0
var g_x86_func_index_buckets: i64 = 0

func x86_func_name_hash(name: string):
    data = native_read_i64(name as i64, 0)
    n = native_read_i64(name as i64, 8)
    h = n * 17
    var i = 0
    when i < n loop
        h = h * 131 + native_read_u8(data, i)
        i = i + 1
    end
    if h < 0 do h = 0 - h end
    out h mod 256
end.

func x86_prepare_func_index(lir_funcs: i64):
    held_funcs = lir_funcs
    buckets = vec_new_cap_rt_x86(256)
    var bi = 0
    when bi < 256 loop
        buckets = vec_push_rt(buckets, 0)
        bi = bi + 1
    end
    n = vec_len_rt(held_funcs)
    var i = 0
    when i < n loop
        lf = vec_get_rt(held_funcs, i)
        fn_name = native_read_i64(lf as i64, 8) as string
        bid = x86_func_name_hash(fn_name)
        bucket = vec_get_rt(buckets, bid)
        if bucket == 0 do bucket = vec_new_rt() end
        bucket = vec_push_rt(bucket, i)
        vec_set_rt(buckets, bid, bucket)
        i = i + 1
    end
    g_x86_func_index_source = held_funcs
    g_x86_func_index_buckets = buckets
end.

func x86_find_func_index(lir_funcs: i64, name: string):
    # Do not trust pointer-identity cache invalidation across self-hosted arena
    # generations; the same address may hold a newly allocated LIR vector.
    n = vec_len_rt(lir_funcs)
    var i = 0
    when i < n loop
        lf = vec_get_rt(lir_funcs, i)
        if lf != 0 do
            fn_name = native_read_i64(lf as i64, 8) as string
            if (fn_name as i64) != 0 and fat_str_eq(fn_name, name) == 1 do out i end
        end
        i = i + 1
    end
    out 0 - 1
end.

func resolve_reg_x86(opnd: &LirOperand, assigned_phys: i64):
    if (opnd as i64) == 0 do
        out 0 - 1
    end
    typ = native_read_i64(opnd as i64, 0)
    if typ == 1 do # VRegInt
        if assigned_phys >= 0 do
            out vec_get_rt(assigned_phys, native_read_i64(opnd as i64, 8))
        end
        out native_read_i64(opnd as i64, 8)
    end
    if typ == 3 do # PhysReg
        out native_read_i64(opnd as i64, 16)
    end
    out 0 - 1
end.

func resolve_or_imm_reg_x86(cb: &CodeBuf, opnd: &LirOperand, assigned_phys: i64, scratch: i64):
    if (opnd as i64) == 0 do
        out scratch
    end
    r = resolve_reg_x86(opnd, assigned_phys)
    if r >= 0 do
        out r
    end
    typ = native_read_i64(opnd as i64, 0)
    if typ == 5 do # Imm
        imm_val = native_read_i64(opnd as i64, 32)
        cb = x86_emit_mov_reg_imm64(cb, scratch as int, imm_val as int)
        out scratch
    end
    if typ == 4 do # StackMem
        off = native_read_i64(opnd as i64, 24)
        if off < 0 do
            cb = x86_emit_mov_reg_imm32(cb, scratch as int, off as int)
            cb = x86_emit_add_rr(cb, scratch as int, X86_RBP)
            cb = x86_emit_mov_reg_mem(cb, scratch as int, scratch as int, 0)
            out scratch
        end
    end
    out scratch
end.

func store_spilled_result_x86(cb: &CodeBuf, dst: &LirOperand, value_reg: i64):
    if (dst as i64) == 0 or native_read_i64(dst as i64, 0) != 4 do out cb end
    off = native_read_i64(dst as i64, 24)
    if off >= 0 do out cb end
    addr_reg = SCR
    if value_reg == SCR do addr_reg = SCR2 end
    cb = x86_emit_mov_reg_imm32(cb, addr_reg as int, off as int)
    cb = x86_emit_add_rr(cb, addr_reg as int, X86_RBP)
    out x86_emit_mov_mem_reg(cb, addr_reg as int, 0, value_reg as int)
end.

func emit_call_fixup_x86(cb: &CodeBuf, call_fixups: i64, target_kind: i64, target_id: i64, rd: i64):
    at = codebuf_offset(cb) as i64
    cb = x86_emit_call_rel32(cb, 0)
    cf = native_read_i64(call_fixups, 0)
    cf = vec_push_rt(cf, x86_call_fixup_new(at, target_kind, target_id))
    native_write_i64(call_fixups, 0, cf)
    if rd >= 0 and rd != X86_RAX do
        cb = x86_emit_mov_rr(cb, rd as int, X86_RAX)
    end
    out cb
end.

func emit_to_rdi(cb: &CodeBuf, opnd: &LirOperand, assigned_phys: i64):
    r = resolve_or_imm_reg_x86(cb, opnd, assigned_phys, SCR)
    if r >= 0 and r != X86_RDI do
        cb = x86_emit_mov_rr(cb, X86_RDI, r as int)
    end
    out cb
end.

func emit_setcc(cb: &CodeBuf, rd: int, pred: i64):
    if pred == LIR_CMP_EQ do
        cb = x86_emit_sete(cb, rd)
    eif pred == LIR_CMP_NE do
        cb = x86_emit_setne(cb, rd)
    eif pred == LIR_CMP_GT do
        cb = x86_emit_setg(cb, rd)
    eif pred == LIR_CMP_LT do
        cb = x86_emit_setl(cb, rd)
    eif pred == LIR_CMP_GE do
        cb = x86_emit_setge(cb, rd)
    eif pred == LIR_CMP_LE do
        cb = x86_emit_setle(cb, rd)
    else
        cb = x86_emit_sete(cb, rd)
    end
    out x86_emit_and_imm8(cb, rd, 1)
end.

func emit_lir_setarg_x86(cb: &CodeBuf, ins: LirInstr, assigned_phys: i64, pending_stk: i64):
    ai = native_read_i64(ins as i64, 40)
    src1 = native_read_i64(ins as i64, 24)
    if (src1 as i64) != 0 do
        if native_read_i64(src1 as i64, 0) == (LirOperandType.Imm as i64) do
            ai = native_read_i64(src1 as i64, 32)
        end
    end
    src2 = native_read_i64(ins as i64, 32) as LirOperand
    rval = resolve_or_imm_reg_x86(cb, src2, assigned_phys, SCR)
    if rval < 0 do
        out pending_stk
    end
    if ai >= 0 and ai < 6 do
        areg = x86_arg_reg(ai as int)
        if rval != areg do
            cb = x86_emit_mov_rr(cb, areg, rval as int)
        end
        out pending_stk
    end
    cb = x86_emit_push(cb, rval as int)
    out pending_stk + 1
end.

