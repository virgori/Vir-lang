# ==============================================================================
# Vir Compiler Module Registry (compiler/module.list)
# ==============================================================================
# Single source of truth for canonical compiler source modules.
# Resolves flat module names without leaking physical filesystem hierarchy.
# Root is '.', all paths are relative to compiler/
# ==============================================================================

root = .
virc = src

# ── Compiler Core & Pipeline ──────────────────────────────────────────────────
main = src/main.vri
pipeline = src/pipeline.vri

# ── Diagnostic Subsystem ──────────────────────────────────────────────────────
context = src/diagnostic/context.vri
diagnostic_context = src/diagnostic/context.vri
diagnostic_store = src/diagnostic/diagnostic_store.vri
error_codes = src/diagnostic/error_codes.vri

# ── Frontend Subsystem ────────────────────────────────────────────────────────
source_manager = src/frontend/source_manager.vri
lexer = src/frontend/lexer.vri
parser = src/frontend/parser.vri
file = src/frontend/file.vri
compiler_slice = src/frontend/slice.vri

# ── Semantic Subsystem — Tables & Foundation ──────────────────────────────────
type_table = src/semantic/type_table.vri
symbol_table = src/semantic/symbol_table.vri
scope_tree = src/semantic/scope_tree.vri

# ── Semantic Subsystem — Typecheck (Pass 6) Submodules ─────────────────────────
typecheck_context = src/semantic/typecheck/context.vri
typecheck_index = src/semantic/typecheck/index.vri
typecheck_compatibility = src/semantic/typecheck/compatibility.vri
typecheck_inference = src/semantic/typecheck/inference.vri
typecheck_calls = src/semantic/typecheck/calls.vri
typecheck_methods = src/semantic/typecheck/methods.vri
typecheck_assignment = src/semantic/typecheck/assignment.vri
typecheck_operators = src/semantic/typecheck/operators.vri
typecheck_tensor = src/semantic/typecheck/tensor.vri
typecheck_generics = src/semantic/typecheck/generics.vri
typecheck_entities = src/semantic/typecheck/entities.vri
typecheck_enums = src/semantic/typecheck/enums.vri
typecheck_patterns = src/semantic/typecheck/patterns.vri
typecheck_containers = src/semantic/typecheck/containers.vri
typecheck_ffi = src/semantic/typecheck/ffi.vri
typecheck_diagnostics = src/semantic/typecheck/diagnostics.vri
typecheck_lookup = src/semantic/typecheck/lookup.vri
typecheck_lvalue = src/semantic/typecheck/lvalue.vri
typecheck_walk_decl = src/semantic/typecheck/walk_decl.vri
typecheck_walk_stmt = src/semantic/typecheck/walk_stmt.vri
typecheck_walk_case = src/semantic/typecheck/walk_case.vri
typecheck_walk_method = src/semantic/typecheck/walk_method.vri
typecheck_walk_field = src/semantic/typecheck/walk_field.vri
typecheck_walk_expr = src/semantic/typecheck/walk_expr.vri
typecheck_walk_index = src/semantic/typecheck/walk_index.vri
typecheck_walk_entity = src/semantic/typecheck/walk_entity.vri
typecheck_walk_other = src/semantic/typecheck/walk_other.vri
typecheck_eval = src/semantic/typecheck/eval.vri

# ── Semantic Subsystem — Passes ───────────────────────────────────────────────
sem_pass1_modules = src/semantic/sem_pass1_modules.vri
sem_pass2_symbols = src/semantic/sem_pass2_symbols.vri
sem_pass3_names = src/semantic/sem_pass3_names.vri
sem_pass4_types = src/semantic/sem_pass4_types.vri
sem_pass5_infer = src/semantic/sem_pass5_infer.vri
sem_pass6_typecheck = src/semantic/sem_pass6_typecheck.vri
sem_pass7_cfa = src/semantic/sem_pass7_cfa.vri
sem_pass8_borrow = src/semantic/sem_pass8_borrow.vri
sem_pass9_constfold = src/semantic/sem_pass9_constfold.vri
sem_pass10_diagnostics = src/semantic/sem_pass10_diagnostics.vri
sem_pass_ide = src/semantic/sem_pass_ide.vri
semantic = src/semantic/semantic.vri

# ── IDE Support ───────────────────────────────────────────────────────────────
ide_facts = src/ide/ide_facts.vri
ide_semantic = src/ide/ide_semantic.vri
ide_session = src/ide/ide_session.vri

# ── Intermediate Representations (HIR / MIR / LIR / MC) ──────────────────────
hir = src/ir/hir/hir.vri
mir = src/ir/mir/mir.vri
mir_cfg = src/ir/mir/mir_cfg.vri
mir_ssa = src/ir/mir/mir_ssa.vri
mir_opt = src/ir/mir/mir_opt.vri
mir_opt_pipeline = src/ir/mir/mir_opt_pipeline.vri
mir_opt_advanced = src/ir/mir/mir_opt_advanced.vri
passOptimize = src/ir/mir/passOptimize.vri

lir = src/ir/lir/lir.vri
lir_liveness = src/ir/lir/lir_liveness.vri
