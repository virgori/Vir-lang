lir_codegen_x86 = src/lower/lir_codegen_x86.vri
lir_codegen_wasm = src/lower/lir_codegen_wasm.vri
lir_codegen_riscv = src/lower/lir_codegen_riscv.vri
lir_to_mc = src/lower/lir_to_mc.vri

# ── Target & Architectures ────────────────────────────────────────────────────
target = src/target/target.vri
target_spec = src/target/target_spec.vri
target_triple = src/target/target_triple.vri
target_paging = src/target/target_paging.vri
lir_target_desc = src/target/lir_target_desc.vri

# ── Backend Emitters & Optimizers ─────────────────────────────────────────────
binary = src/backend/binary.vri
macho = src/backend/macho.vri
pe = src/backend/pe.vri
linker = src/backend/linker.vri
codegen = src/backend/codegen.vri
codegen_x86 = src/backend/codegen_x86.vri
codegen_wasm = src/backend/codegen_wasm.vri
opt_pass = src/backend/opt_pass.vri
opt_trace = src/backend/opt_trace.vri
opt_backend = src/backend/opt_backend.vri
opt_backend_arm64 = src/backend/opt_backend_arm64.vri
opt_backend_x86 = src/backend/opt_backend_x86.vri
opt_backend_riscv = src/backend/opt_backend_riscv.vri
opt_backend_wasm = src/backend/opt_backend_wasm.vri
opt_backend_generic = src/backend/opt_backend_generic.vri
opt_backend_arc = src/backend/opt_backend_arc.vri

# ── CLI & Tools ───────────────────────────────────────────────────────────────
cli_ui = src/cli/cli_ui.vri
cli_storage = src/cli/cli_storage.vri
cli_environment = src/cli/cli_environment.vri
