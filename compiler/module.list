# ==============================================================================
# Vir Compiler Module Registry (compiler/module.list)
# ==============================================================================
# Single source of truth for canonical compiler source modules.
# Resolves flat module names without leaking physical filesystem hierarchy.
# Root is '.', all paths are relative to compiler/
# ==============================================================================

root = .
virc = src

