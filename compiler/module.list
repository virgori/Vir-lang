# ── Lowering Pipeline ─────────────────────────────────────────────────────────
ast_to_hir = src/lower/ast_to_hir.vri
ast_to_mir = src/lower/ast_to_mir.vri
hir_to_mir = src/lower/hir_to_mir.vri
lir_lower = src/lower/lir_lower.vri
