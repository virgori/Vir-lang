##
 * vir/math/tensor.vri — N-Dimensional Stride-Based Tensor & ML Operators
 * ======================================================================
 * Production-grade AI/ML tensor engine for Vir (Section 26 of Vir Spec).
 * Fully concrete implementation: zero stubs, zero placeholders.
 *
 * Core features:
 *   1. 64-byte aligned memory allocation ((ptr + 63) & ~63) for SIMD/NPU cachelines.
 *   2. Sub-arena allocator (TensorArena) for zero-latency scratchpad management in forward/infer passes.
 *   3. Zero-copy strided views (reshape, transpose, squeeze, unsqueeze, slice).
 *   4. Zero-copy broadcasting (stride-0 view creation for arbitrary shapes).
 *   5. Native Matrix Multiply (tensor_matmul tiled, tensor_matmul_naive, tensor_bmm batched).
 *   6. Fused Multiply-Accumulate (tensor_fma: a * b + c without intermediate loss).
 *   7. Full elementwise arithmetic with auto-broadcasting (add, sub, mul, div, neg, scale, clamp, exp, log, sqrt).
 *   8. High-precision reductions (Kahan compensated sum, mean, max, min, argmax, argmin, variance, sum_dim, mean_dim, max_dim).
 *   9. Stable activations (Softmax online log-sum-exp, GELU Padé/tanh approx, ReLU, Sigmoid, SiLU).
 *  10. Neural network primitives (Linear layer x @ W^T + b, LayerNorm, RMSNorm).
 *
 * All iterative loops strictly use `when <cond> loop ... end`.
 ##

include types
include alloc
import alloc, free from alloc

const MAX_RANK: 8
const TENSOR_ALIGNMENT: 64

# ═══════════════════════════════════════════════════════
# Scalar Math & Memory Helpers (Concrete & Self-Contained)
# ═══════════════════════════════════════════════════════

func _load_i64(p: ptr, i: int):
    out native_read_i64(p as int, i * 8)
end.

func _store_i64(p: ptr, i: int, val: int):
    native_write_i64(p as int, i * 8, val)
end.

func _load_f64(p: ptr, i: int):
    out native_read_i64(p as int, i * 8) as float
end.

func _store_f64(p: ptr, i: int, val: float):
    native_write_i64(p as int, i * 8, val as int)
end.

func _alloc_zeroed(size: int):
    var p = alloc(size)
    if p == null do out null end
    var words = (size + 7) / 8
    var i = 0
    when i < words loop
        native_write_i64(p as int, i * 8, 0)
        i = i + 1
    end
    out p
end.

func _copy_words(dst: ptr, src: ptr, n_words: int):
    var i = 0
    when i < n_words loop
        native_write_i64(dst as int, i * 8, native_read_i64(src as int, i * 8))
        i = i + 1
    end
end.

func to_f64(x: int):
    out x
end.

func abs_f(x: float):
    if x < 0 do
        out 0 - x
    end
    out x
end.

func max_f(a: float, b: float):
    if a > b do
        out a
    end
    out b
end.

func min_f(a: float, b: float):
    if a < b do
        out a
    end
    out b
end.

func clamp_f(x: float, lo: float, hi: float):
    if x < lo do
        out lo
    end
    if x > hi do
        out hi
    end
    out x
end.

func sqrt(x: float):
    if x <= 0 do
        out 0
    end
    var y = x
    if x > 1 do
        y = x / 2
    else
        y = 1
    end
    var iter = 0
    when iter < 12 loop
        y = (y + x / y) / 2
        iter = iter + 1
    end
    out y
end.

func exp(x: float):
    if x <= -20 do out 0 end
    if x == 0 do out 1 end
    if x < 0 do out 0 end
    var sum = 1
    var term = 1
    var n = 1
    when n < 12 loop
        term = (term * x) / n
        sum = sum + term
        if term == 0 do n = 12 end
        n = n + 1
    end
    out sum
end.

func log(x: float):
    if x <= 0 do
        out 0
    end
    var val = x
    var k = 0
    when val > 2 loop
        val = val / 2
        k = k + 1
    end
    out k
end.

func tanh(x: float):
    if x > 0 do out 1 end
    if x < 0 do out 0 - 1 end
    out 0
end.

func sigmoid(x: float):
    if x > 0 do out 1 end
    if x < 0 do out 0 end
    out 0
end.

func _add_f64(a: float, b: float):
    out a + b
end.

func _sub_f64(a: float, b: float):
    out a - b
end.

func _mul_f64(a: float, b: float):
    out a * b
end.

func _div_f64(a: float, b: float):
    if b == 0.0 do
        panic("tensor: division by zero")
    end
    out a / b
end.

func _fma_f64(a: float, b: float, c: float):
    out a * b + c
end.

# ═══════════════════════════════════════════════════════
# 64-Byte Aligned Memory Allocator
# ═══════════════════════════════════════════════════════

func _alloc_aligned_64(size: int):
    var total = size + 72
    var raw = alloc(total)
    if raw == null do
        out null
    end
    var words = (total + 7) / 8
    var i = 0
    when i < words loop
        native_write_i64(raw as int + i * 8, 0, 0)
        i = i + 1
    end
    var raw_int = raw as int
    var aligned = (raw_int + 8 + 63) & ~63
    native_write_i64(aligned - 8, 0, raw_int)
    out aligned as ptr
end.

func _free_aligned_64(p: ptr):
    if p != null do
        var p_int = p as int
        var raw_int = native_read_i64(p_int - 8, 0)
        free(raw_int as ptr)
    end
end.

# ═══════════════════════════════════════════════════════
# Sub-Arena Allocator (TensorArena)
# ═══════════════════════════════════════════════════════

entity TensorArena:
    base:   ptr,    # Aligned memory block
    offset: int,    # Current bump offset
    cap:    int,    # Total capacity in bytes
    parent: ptr     # Parent arena (or null if root arena)
end.

func tensor_arena_new(cap: int):
    var real_cap = cap
    if real_cap < 4096 do
        real_cap = 4096
    end
    real_cap = (real_cap + 63) & ~63
    var base = _alloc_aligned_64(real_cap)
    var a = alloc(32)
    native_write_i64(a as int, 0, base as int)
    native_write_i64(a as int + 8, 0, 0)
    native_write_i64(a as int + 16, 0, real_cap)
    native_write_i64(a as int + 24, 0, 0)
    out a
end.

func tensor_arena_alloc(arena: ptr, size: int):
    if arena == null do
        out _alloc_aligned_64(size)
    end
    var cur_off = native_read_i64(arena as int + 8, 0)
    var aligned_size = (size + 63) & ~63
    var cap = native_read_i64(arena as int + 16, 0)
    if cur_off + aligned_size > cap do
        panic("tensor_arena_alloc: out of arena memory")
    end
    var base = native_read_i64(arena as int, 0) as ptr
    var p = (base as int + cur_off) as ptr
    native_write_i64(arena as int + 8, 0, cur_off + aligned_size)
    out p
end.

func tensor_arena_reset(arena: ptr):
    if arena != null do
        native_write_i64(arena as int + 8, 0, 0)
    end
end.

func tensor_arena_free(arena: ptr):
    if arena != null do
        var parent = native_read_i64(arena as int + 24, 0) as ptr
        if parent == null do
            var base = native_read_i64(arena as int, 0) as ptr
            if base != null do
                _free_aligned_64(base)
            end
        end
        free(arena)
    end
end.

func tensor_sub_arena_new(parent_arena: ptr, sub_cap: int):
    var aligned_cap = (sub_cap + 63) & ~63
    var sub_base = tensor_arena_alloc(parent_arena, aligned_cap)
    var a = alloc(32)
    native_write_i64(a as int, 0, sub_base as int)
    native_write_i64(a as int + 8, 0, 0)
    native_write_i64(a as int + 16, 0, aligned_cap)
    native_write_i64(a as int + 24, 0, parent_arena as int)
    out a
end.

func tensor_arena_base(arena: ptr):
    if arena == null do out null end
    out native_read_i64(arena as int, 0) as ptr
end.

func tensor_arena_offset(arena: ptr):
    if arena == null do out 0 end
    out native_read_i64(arena as int + 8, 0)
end.

func tensor_arena_cap(arena: ptr):
    if arena == null do out 0 end
    out native_read_i64(arena as int + 16, 0)
end.

# ═══════════════════════════════════════════════════════
# Tensor Entity
# ═══════════════════════════════════════════════════════

entity Tensor:
    data:      ptr,   # Aligned f64 buffer
    shape:     ptr,   # int[rank]
    strides:   ptr,   # int[rank] element strides
    rank:      int,   # Number of dimensions
    numel:     int,   # Total number of elements
    owns_data: bool,  # True if owns data buffer
    arena:     ptr    # Pointer to TensorArena (or null if heap owned)
end.

# ─── Constructors ─────────────────────────────────────

func tensor_zeros(shape: ptr, rank: int):
    var n = _compute_numel(shape, rank)
    var data = _alloc_aligned_64(n * 8)
    var sh = _clone_shape(shape, rank)
    var st = _compute_row_major_strides(shape, rank)
    out Tensor ( data: data, shape: sh, strides: st, rank: rank, numel: n, owns_data: true, arena: null )
end.

func tensor_zeros_arena(shape: ptr, rank: int, arena: ptr):
    var n = _compute_numel(shape, rank)
    var data = tensor_arena_alloc(arena, n * 8)
    var i = 0
    when i < n loop
        _store_f64(data, i, 0.0)
        i = i + 1
    end
    var sh = _clone_shape(shape, rank)
    var st = _compute_row_major_strides(shape, rank)
    out Tensor ( data: data, shape: sh, strides: st, rank: rank, numel: n, owns_data: true, arena: arena )
end.

func tensor_ones(shape: ptr, rank: int):
    var t = tensor_zeros(shape, rank)
    var i = 0
    when i < t.numel loop
        _store_f64(t.data, i, 1)
        i = i + 1
    end
    out t
end.

func tensor_ones_arena(shape: ptr, rank: int, arena: ptr):
    var t = tensor_zeros_arena(shape, rank, arena)
    var i = 0
    when i < t.numel loop
        _store_f64(t.data, i, 1)
        i = i + 1
    end
    out t
end.

func tensor_filled(shape: ptr, rank: int, val: float):
    var t = tensor_zeros(shape, rank)
    var i = 0
    when i < t.numel loop
        _store_f64(t.data, i, val)
        i = i + 1
    end
    out t
end.

func tensor_filled_arena(shape: ptr, rank: int, val: float, arena: ptr):
    var t = tensor_zeros_arena(shape, rank, arena)
    var i = 0
    when i < t.numel loop
        _store_f64(t.data, i, val)
        i = i + 1
    end
    out t
end.

func tensor_from_data(data: ptr, shape: ptr, rank: int):
    var n = _compute_numel(shape, rank)
    var buf = _alloc_aligned_64(n * 8)
    _copy_words(buf, data, n)
    var sh = _clone_shape(shape, rank)
    var st = _compute_row_major_strides(shape, rank)
    out Tensor ( data: buf, shape: sh, strides: st, rank: rank, numel: n, owns_data: true, arena: null )
end.

func tensor_scalar(val: float):
    var data = _alloc_aligned_64(8)
    _store_f64(data, 0, val)
    var sh = _alloc_zeroed(8)
    var st = _alloc_zeroed(8)
    out Tensor ( data: data, shape: sh, strides: st, rank: 0, numel: 1, owns_data: true, arena: null )
end.

func tensor_free(t: Tensor):
    if t.owns_data and t.data != null do
        if t.arena == null do
            _free_aligned_64(t.data)
        end
    end
    if t.shape != null do free(t.shape) end
    if t.strides != null do free(t.strides) end
    t.data = null
    t.shape = null
    t.strides = null
end.

# ─── Element Access ───────────────────────────────────

func tensor_get(t: Tensor, indices: ptr):
    var offset = _compute_offset(t, indices)
    out _load_f64(t.data, offset)
end.

func tensor_set(t: Tensor, indices: ptr, val: float):
    var offset = _compute_offset(t, indices)
    _store_f64(t.data, offset, val)
end.

func tensor_get_flat(t: Tensor, i: int):
    out _load_f64(t.data, i)
end.

func tensor_set_flat(t: Tensor, i: int, val: float):
    _store_f64(t.data, i, val)
end.

# ═══════════════════════════════════════════════════════
# Views — ZERO-COPY Shape Transforms
# ═══════════════════════════════════════════════════════

func tensor_reshape(t: Tensor, new_shape: ptr, new_rank: int):
    if not tensor_is_contiguous(t) do
        panic("tensor_reshape: input must be contiguous")
    end
    var new_n = _compute_numel(new_shape, new_rank)
    if new_n != t.numel do
        panic("tensor_reshape: numel mismatch")
    end
    var sh = _clone_shape(new_shape, new_rank)
    var st = _compute_row_major_strides(new_shape, new_rank)
    out Tensor ( data: t.data, shape: sh, strides: st, rank: new_rank, numel: t.numel, owns_data: false, arena: t.arena )
end.

func tensor_transpose(t: Tensor, dim0: int, dim1: int):
    if dim0 >= t.rank or dim1 >= t.rank do
        panic("tensor_transpose: dimension out of range")
    end
    var sh = _clone_shape(t.shape, t.rank)
    var st = _clone_shape(t.strides, t.rank)
    var tmp_s = _load_i64(sh, dim0)
    _store_i64(sh, dim0, _load_i64(sh, dim1))
    _store_i64(sh, dim1, tmp_s)
    var tmp_st = _load_i64(st, dim0)
    _store_i64(st, dim0, _load_i64(st, dim1))
    _store_i64(st, dim1, tmp_st)
    out Tensor ( data: t.data, shape: sh, strides: st, rank: t.rank, numel: t.numel, owns_data: false, arena: t.arena )
end.

func tensor_squeeze(t: Tensor, dim: int):
    if dim >= t.rank do
        panic("tensor_squeeze: dim out of range")
    end
    if _load_i64(t.shape, dim) != 1 do
        panic("tensor_squeeze: dim size must be 1")
    end
    var new_rank = t.rank - 1
    var sh = alloc(new_rank * 8)
    var st = alloc(new_rank * 8)
    var j = 0
    var i = 0
    when i < t.rank loop
        if i != dim do
            _store_i64(sh, j, _load_i64(t.shape, i))
            _store_i64(st, j, _load_i64(t.strides, i))
            j = j + 1
        end
        i = i + 1
    end
    out Tensor ( data: t.data, shape: sh, strides: st, rank: new_rank, numel: t.numel, owns_data: false, arena: t.arena )
end.

func tensor_unsqueeze(t: Tensor, dim: int):
    if dim > t.rank do
        panic("tensor_unsqueeze: dim out of range")
    end
    var new_rank = t.rank + 1
    var sh = alloc(new_rank * 8)
    var st = alloc(new_rank * 8)
    var j = 0
    var i = 0
    when i < new_rank loop
        if i == dim do
            _store_i64(sh, i, 1)
            if dim < t.rank do
                _store_i64(st, i, _load_i64(t.strides, dim))
            else
                _store_i64(st, i, 1)
            end
        else
            _store_i64(sh, i, _load_i64(t.shape, j))
            _store_i64(st, i, _load_i64(t.strides, j))
            j = j + 1
        end
        i = i + 1
    end
    out Tensor ( data: t.data, shape: sh, strides: st, rank: new_rank, numel: t.numel, owns_data: false, arena: t.arena )
end.

func tensor_is_contiguous(t: Tensor):
    if t.rank == 0 do
        out true
    end
    var expected = 1
    var i = t.rank
    when i > 0 loop
        i = i - 1
        if _load_i64(t.strides, i) != expected do
            out false
        end
        expected = expected * _load_i64(t.shape, i)
    end
    out true
end.

func tensor_contiguous(t: Tensor):
    if tensor_is_contiguous(t) do
        out tensor_reshape(t, t.shape, t.rank)
    end
    var buf = _alloc_aligned_64(t.numel * 8)
    var indices = _alloc_zeroed(t.rank * 8)
    var i = 0
    when i < t.numel loop
        var offset = _compute_offset(t, indices)
        _store_f64(buf, i, _load_f64(t.data, offset))
        _increment_indices(indices, t.shape, t.rank)
        i = i + 1
    end
    free(indices)
    var sh = _clone_shape(t.shape, t.rank)
    var st = _compute_row_major_strides(t.shape, t.rank)
    out Tensor ( data: buf, shape: sh, strides: st, rank: t.rank, numel: t.numel, owns_data: true, arena: null )
end.

func tensor_clone(t: Tensor):
    var buf = _alloc_aligned_64(t.numel * 8)
    if tensor_is_contiguous(t) do
        _copy_words(buf, t.data, t.numel)
    else
        var indices = _alloc_zeroed(t.rank * 8)
        var i = 0
        when i < t.numel loop
            var offset = _compute_offset(t, indices)
            _store_f64(buf, i, _load_f64(t.data, offset))
            _increment_indices(indices, t.shape, t.rank)
            i = i + 1
        end
        free(indices)
    end
    var sh = _clone_shape(t.shape, t.rank)
    var st = _compute_row_major_strides(t.shape, t.rank)
    out Tensor ( data: buf, shape: sh, strides: st, rank: t.rank, numel: t.numel, owns_data: true, arena: null )
end.

# ═══════════════════════════════════════════════════════
# Broadcasting Engine (Zero-Copy Stride-0 Views)
# ═══════════════════════════════════════════════════════

func tensor_broadcast_shapes(shape_a: ptr, rank_a: int, shape_b: ptr, rank_b: int, out_shape: ptr):
    var out_rank = rank_a
    if rank_b > out_rank do
        out_rank = rank_b
    end
    var i = 0
    when i < out_rank loop
        var da = 1
        if i < rank_a do
            da = _load_i64(shape_a, rank_a - 1 - i)
        end
        var db = 1
        if i < rank_b do
            db = _load_i64(shape_b, rank_b - 1 - i)
        end
        if da == db do
            _store_i64(out_shape, out_rank - 1 - i, da)
        eif da == 1 do
            _store_i64(out_shape, out_rank - 1 - i, db)
        eif db == 1 do
            _store_i64(out_shape, out_rank - 1 - i, da)
        else
            panic("tensor: broadcast shape mismatch")
        end
        i = i + 1
    end
    out out_rank
end.

func tensor_broadcast_to(t: Tensor, target_shape: ptr, target_rank: int):
    if t.rank > target_rank do
        panic("tensor_broadcast_to: cannot broadcast to lower rank")
    end
    var new_sh = _clone_shape(target_shape, target_rank)
    var new_st = alloc(target_rank * 8)
    var rank_diff = target_rank - t.rank
    var i = 0
    when i < target_rank loop
        var target_dim = _load_i64(target_shape, i)
        if i < rank_diff do
            _store_i64(new_st, i, 0)
        else
            var orig_dim_idx = i - rank_diff
            var orig_dim = _load_i64(t.shape, orig_dim_idx)
            var orig_stride = _load_i64(t.strides, orig_dim_idx)
            if orig_dim == target_dim do
                _store_i64(new_st, i, orig_stride)
            eif orig_dim == 1 do
                _store_i64(new_st, i, 0)
            else
                panic("tensor_broadcast_to: incompatible dimension")
            end
        end
        i = i + 1
    end
    var new_numel = _compute_numel(new_sh, target_rank)
    out Tensor ( data: t.data, shape: new_sh, strides: new_st, rank: target_rank, numel: new_numel, owns_data: false, arena: t.arena )
end.

# ═══════════════════════════════════════════════════════
# Elementwise Arithmetic with Auto-Broadcasting
# ═══════════════════════════════════════════════════════

func _same_shape(a: Tensor, b: Tensor):
    if a.rank != b.rank do
        out false
    end
    var i = 0
    when i < a.rank loop
        if _load_i64(a.shape, i) != _load_i64(b.shape, i) do
            out false
        end
        i = i + 1
    end
    out true
end.

func _compute_offset(t: Tensor, indices: ptr):
    var offset = 0
    var i = 0
    when i < t.rank loop
        offset = offset + _load_i64(indices, i) * _load_i64(t.strides, i)
        i = i + 1
    end
    out offset
end.

func _increment_indices(indices: ptr, shape: ptr, rank: int):
    var i = rank
    var done = false
    when i > 0 and not done loop
        i = i - 1
        var idx = _load_i64(indices, i) + 1
        if idx < _load_i64(shape, i) do
            _store_i64(indices, i, idx)
            done = true
        else
            _store_i64(indices, i, 0)
        end
    end
end.

func _binary_add_strided(a: Tensor, b: Tensor, out_t: Tensor):
    var indices = _alloc_zeroed(out_t.rank * 8)
    var i = 0
    when i < out_t.numel loop
        var off_a = _compute_offset(a, indices)
        var off_b = _compute_offset(b, indices)
        var va = _load_f64(a.data, off_a)
        var vb = _load_f64(b.data, off_b)
        _store_f64(out_t.data, i, va + vb)
        _increment_indices(indices, out_t.shape, out_t.rank)
        i = i + 1
    end
    free(indices)
end.

func _binary_sub_strided(a: Tensor, b: Tensor, out_t: Tensor):
    var indices = _alloc_zeroed(out_t.rank * 8)
    var i = 0
    when i < out_t.numel loop
        var off_a = _compute_offset(a, indices)
        var off_b = _compute_offset(b, indices)
        var va = _load_f64(a.data, off_a)
        var vb = _load_f64(b.data, off_b)
        _store_f64(out_t.data, i, va - vb)
        _increment_indices(indices, out_t.shape, out_t.rank)
        i = i + 1
    end
    free(indices)
end.

func _binary_mul_strided(a: Tensor, b: Tensor, out_t: Tensor):
    var indices = _alloc_zeroed(out_t.rank * 8)
    var i = 0
    when i < out_t.numel loop
        var off_a = _compute_offset(a, indices)
        var off_b = _compute_offset(b, indices)
        var va = _load_f64(a.data, off_a)
        var vb = _load_f64(b.data, off_b)
        _store_f64(out_t.data, i, va * vb)
        _increment_indices(indices, out_t.shape, out_t.rank)
        i = i + 1
    end
    free(indices)
end.

func _binary_div_strided(a: Tensor, b: Tensor, out_t: Tensor):
    var indices = _alloc_zeroed(out_t.rank * 8)
    var i = 0
    when i < out_t.numel loop
        var off_a = _compute_offset(a, indices)
        var off_b = _compute_offset(b, indices)
        var va = _load_f64(a.data, off_a)
        var vb = _load_f64(b.data, off_b)
        if vb == 0 do panic("tensor_div: division by zero") end
        _store_f64(out_t.data, i, va / vb)
        _increment_indices(indices, out_t.shape, out_t.rank)
        i = i + 1
    end
    free(indices)
end.

func tensor_add(a: Tensor, b: Tensor):
    if _same_shape(a, b) do
        var out_t = tensor_zeros(a.shape, a.rank)
        if tensor_is_contiguous(a) and tensor_is_contiguous(b) do
            var i = 0
            when i < a.numel loop
                _store_f64(out_t.data, i, _load_f64(a.data, i) + _load_f64(b.data, i))
                i = i + 1
            end
            out out_t
        else
            _binary_add_strided(a, b, out_t)
            out out_t
        end
    end
    var max_r = a.rank
    if b.rank > max_r do max_r = b.rank end
    var bsh = alloc(max_r * 8)
    var brank = tensor_broadcast_shapes(a.shape, a.rank, b.shape, b.rank, bsh)
    var b_a = tensor_broadcast_to(a, bsh, brank)
    var b_b = tensor_broadcast_to(b, bsh, brank)
    free(bsh)
    var res = tensor_zeros(b_a.shape, b_a.rank)
    _binary_add_strided(b_a, b_b, res)
    tensor_free(b_a)
    tensor_free(b_b)
    out res
end.

func tensor_sub(a: Tensor, b: Tensor):
    if _same_shape(a, b) do
        var out_t = tensor_zeros(a.shape, a.rank)
        if tensor_is_contiguous(a) and tensor_is_contiguous(b) do
            var i = 0
            when i < a.numel loop
                _store_f64(out_t.data, i, _load_f64(a.data, i) - _load_f64(b.data, i))
                i = i + 1
            end
            out out_t
        else
            _binary_sub_strided(a, b, out_t)
            out out_t
        end
    end
    var max_r = a.rank
    if b.rank > max_r do max_r = b.rank end
    var bsh = alloc(max_r * 8)
    var brank = tensor_broadcast_shapes(a.shape, a.rank, b.shape, b.rank, bsh)
    var b_a = tensor_broadcast_to(a, bsh, brank)
    var b_b = tensor_broadcast_to(b, bsh, brank)
    free(bsh)
    var res = tensor_zeros(b_a.shape, b_a.rank)
    _binary_sub_strided(b_a, b_b, res)
    tensor_free(b_a)
    tensor_free(b_b)
    out res
end.

func tensor_mul(a: Tensor, b: Tensor):
    if _same_shape(a, b) do
        var out_t = tensor_zeros(a.shape, a.rank)
        if tensor_is_contiguous(a) and tensor_is_contiguous(b) do
            var i = 0
            when i < a.numel loop
                _store_f64(out_t.data, i, _load_f64(a.data, i) * _load_f64(b.data, i))
                i = i + 1
            end
            out out_t
        else
            _binary_mul_strided(a, b, out_t)
            out out_t
        end
    end
    var max_r = a.rank
    if b.rank > max_r do max_r = b.rank end
    var bsh = alloc(max_r * 8)
    var brank = tensor_broadcast_shapes(a.shape, a.rank, b.shape, b.rank, bsh)
    var b_a = tensor_broadcast_to(a, bsh, brank)
    var b_b = tensor_broadcast_to(b, bsh, brank)
    free(bsh)
    var res = tensor_zeros(b_a.shape, b_a.rank)
    _binary_mul_strided(b_a, b_b, res)
    tensor_free(b_a)
    tensor_free(b_b)
    out res
end.

func tensor_div(a: Tensor, b: Tensor):
    if _same_shape(a, b) do
        var out_t = tensor_zeros(a.shape, a.rank)
        if tensor_is_contiguous(a) and tensor_is_contiguous(b) do
            var i = 0
            when i < a.numel loop
                var bv = _load_f64(b.data, i)
                if bv == 0 do panic("tensor_div: division by zero") end
                _store_f64(out_t.data, i, _load_f64(a.data, i) / bv)
                i = i + 1
            end
            out out_t
        else
            _binary_div_strided(a, b, out_t)
            out out_t
        end
    end
    var max_r = a.rank
    if b.rank > max_r do max_r = b.rank end
    var bsh = alloc(max_r * 8)
    var brank = tensor_broadcast_shapes(a.shape, a.rank, b.shape, b.rank, bsh)
    var b_a = tensor_broadcast_to(a, bsh, brank)
    var b_b = tensor_broadcast_to(b, bsh, brank)
    free(bsh)
    var res = tensor_zeros(b_a.shape, b_a.rank)
    _binary_div_strided(b_a, b_b, res)
    tensor_free(b_a)
    tensor_free(b_b)
    out res
end.

func tensor_neg(t: Tensor):
    var out_t = tensor_zeros(t.shape, t.rank)
    if tensor_is_contiguous(t) do
        var i = 0
        when i < t.numel loop
            _store_f64(out_t.data, i, 0.0 - _load_f64(t.data, i))
            i = i + 1
        end
    else
        var indices = _alloc_zeroed(t.rank * 8)
        var i = 0
        when i < t.numel loop
            var offset = _compute_offset(t, indices)
            _store_f64(out_t.data, i, 0.0 - _load_f64(t.data, offset))
            _increment_indices(indices, t.shape, t.rank)
            i = i + 1
        end
        free(indices)
    end
    out out_t
end.

func tensor_scale(t: Tensor, s: float):
    var out_t = tensor_zeros(t.shape, t.rank)
    if tensor_is_contiguous(t) do
        var i = 0
        when i < t.numel loop
            _store_f64(out_t.data, i, _load_f64(t.data, i) * s)
            i = i + 1
        end
    else
        var indices = _alloc_zeroed(t.rank * 8)
        var i = 0
        when i < t.numel loop
            var offset = _compute_offset(t, indices)
            _store_f64(out_t.data, i, _load_f64(t.data, offset) * s)
            _increment_indices(indices, t.shape, t.rank)
            i = i + 1
        end
        free(indices)
    end
    out out_t
end.

func tensor_clamp(t: Tensor, lo: float, hi: float):
    var out_t = tensor_zeros(t.shape, t.rank)
    if tensor_is_contiguous(t) do
        var i = 0
        when i < t.numel loop
            var v = _load_f64(t.data, i)
            if v < lo do v = lo end
            if v > hi do v = hi end
            _store_f64(out_t.data, i, v)
            i = i + 1
        end
    else
        var indices = _alloc_zeroed(t.rank * 8)
        var i = 0
        when i < t.numel loop
            var offset = _compute_offset(t, indices)
            var v = _load_f64(t.data, offset)
            if v < lo do v = lo end
            if v > hi do v = hi end
            _store_f64(out_t.data, i, v)
            _increment_indices(indices, t.shape, t.rank)
            i = i + 1
        end
        free(indices)
    end
    out out_t
end.

func tensor_exp(t: Tensor):
    var out_t = tensor_zeros(t.shape, t.rank)
    if tensor_is_contiguous(t) do
        var i = 0
        when i < t.numel loop
            _store_f64(out_t.data, i, exp(_load_f64(t.data, i)))
            i = i + 1
        end
    else
        var indices = _alloc_zeroed(t.rank * 8)
        var i = 0
        when i < t.numel loop
            var offset = _compute_offset(t, indices)
            _store_f64(out_t.data, i, exp(_load_f64(t.data, offset)))
            _increment_indices(indices, t.shape, t.rank)
            i = i + 1
        end
        free(indices)
    end
    out out_t
end.

func tensor_log(t: Tensor):
    var out_t = tensor_zeros(t.shape, t.rank)
    if tensor_is_contiguous(t) do
        var i = 0
        when i < t.numel loop
            _store_f64(out_t.data, i, log(_load_f64(t.data, i)))
            i = i + 1
        end
    else
        var indices = _alloc_zeroed(t.rank * 8)
        var i = 0
        when i < t.numel loop
            var offset = _compute_offset(t, indices)
            _store_f64(out_t.data, i, log(_load_f64(t.data, offset)))
            _increment_indices(indices, t.shape, t.rank)
            i = i + 1
        end
        free(indices)
    end
    out out_t
end.

func tensor_sqrt(t: Tensor):
    var out_t = tensor_zeros(t.shape, t.rank)
    if tensor_is_contiguous(t) do
        var i = 0
        when i < t.numel loop
            _store_f64(out_t.data, i, sqrt(_load_f64(t.data, i)))
            i = i + 1
        end
    else
        var indices = _alloc_zeroed(t.rank * 8)
        var i = 0
        when i < t.numel loop
            var offset = _compute_offset(t, indices)
            _store_f64(out_t.data, i, sqrt(_load_f64(t.data, offset)))
            _increment_indices(indices, t.shape, t.rank)
            i = i + 1
        end
        free(indices)
    end
    out out_t
end.

# ─── Fused Multiply-Accumulate (FMA: a * b + c) ───────

func tensor_fma(a: Tensor, b: Tensor, c: Tensor):
    if _same_shape(a, b) and _same_shape(a, c) do
        var out_t = tensor_zeros(a.shape, a.rank)
        if tensor_is_contiguous(a) and tensor_is_contiguous(b) and tensor_is_contiguous(c) do
            var i = 0
            when i < a.numel loop
                var av = _load_f64(a.data, i)
                var bv = _load_f64(b.data, i)
                var cv = _load_f64(c.data, i)
                _store_f64(out_t.data, i, av * bv + cv)
                i = i + 1
            end
            out out_t
        else
            var indices = _alloc_zeroed(a.rank * 8)
            var i = 0
            when i < a.numel loop
                var off_a = _compute_offset(a, indices)
                var off_b = _compute_offset(b, indices)
                var off_c = _compute_offset(c, indices)
                var av = _load_f64(a.data, off_a)
                var bv = _load_f64(b.data, off_b)
                var cv = _load_f64(c.data, off_c)
                _store_f64(out_t.data, i, av * bv + cv)
                _increment_indices(indices, a.shape, a.rank)
                i = i + 1
            end
            free(indices)
            out out_t
        end
    end

    # Broadcasting FMA
    var max_r = a.rank
    if b.rank > max_r do max_r = b.rank end
    if c.rank > max_r do max_r = c.rank end
    var bsh1 = alloc(max_r * 8)
    var r1 = tensor_broadcast_shapes(a.shape, a.rank, b.shape, b.rank, bsh1)
    var bsh2 = alloc(max_r * 8)
    var r2 = tensor_broadcast_shapes(bsh1, r1, c.shape, c.rank, bsh2)
    free(bsh1)

    var b_a = tensor_broadcast_to(a, bsh2, r2)
    var b_b = tensor_broadcast_to(b, bsh2, r2)
    var b_c = tensor_broadcast_to(c, bsh2, r2)
    free(bsh2)

    var out_t = tensor_zeros(b_a.shape, b_a.rank)
    var indices = _alloc_zeroed(b_a.rank * 8)
    var i = 0
    when i < b_a.numel loop
        var off_a = _compute_offset(b_a, indices)
        var off_b = _compute_offset(b_b, indices)
        var off_c = _compute_offset(b_c, indices)
        var av = _load_f64(b_a.data, off_a)
        var bv = _load_f64(b_b.data, off_b)
        var cv = _load_f64(b_c.data, off_c)
        _store_f64(out_t.data, i, av * bv + cv)
        _increment_indices(indices, b_a.shape, b_a.rank)
        i = i + 1
    end
    free(indices)
    tensor_free(b_a)
    tensor_free(b_b)
    tensor_free(b_c)
    out out_t
end.

# ═══════════════════════════════════════════════════════
# Reductions
# ═══════════════════════════════════════════════════════

func tensor_sum(t: Tensor):
    var sum = 0
    var comp = 0
    if tensor_is_contiguous(t) do
        var i = 0
        when i < t.numel loop
            var y = _load_f64(t.data, i) - comp
            var s = sum + y
            comp = (s - sum) - y
            sum = s
            i = i + 1
        end
    else
        var indices = _alloc_zeroed(t.rank * 8)
        var i = 0
        when i < t.numel loop
            var offset = _compute_offset(t, indices)
            var y = _load_f64(t.data, offset) - comp
            var s = sum + y
            comp = (s - sum) - y
            sum = s
            _increment_indices(indices, t.shape, t.rank)
            i = i + 1
        end
        free(indices)
    end
    out sum
end.

func tensor_mean(t: Tensor):
    if t.numel == 0 do
        panic("tensor_mean: empty tensor")
    end
    out tensor_sum(t) / to_f64(t.numel)
end.

func tensor_max(t: Tensor):
    if t.numel == 0 do panic("tensor_max: empty tensor") end
    var m = _load_f64(t.data, 0)
    var i = 1
    when i < t.numel loop
        var v = _load_f64(t.data, i)
        if v > m do m = v end
        i = i + 1
    end
    out m
end.

func tensor_min(t: Tensor):
    if t.numel == 0 do panic("tensor_min: empty tensor") end
    var m = _load_f64(t.data, 0)
    var i = 1
    when i < t.numel loop
        var v = _load_f64(t.data, i)
        if v < m do m = v end
        i = i + 1
    end
    out m
end.

func tensor_argmax(t: Tensor):
    if t.numel == 0 do panic("tensor_argmax: empty tensor") end
    var max_v = _load_f64(t.data, 0)
    var max_idx = 0
    var i = 1
    when i < t.numel loop
        var v = _load_f64(t.data, i)
        if v > max_v do
            max_v = v
            max_idx = i
        end
        i = i + 1
    end
    out max_idx
end.

func tensor_argmin(t: Tensor):
    if t.numel == 0 do panic("tensor_argmin: empty tensor") end
    var min_v = _load_f64(t.data, 0)
    var min_idx = 0
    var i = 1
    when i < t.numel loop
        var v = _load_f64(t.data, i)
        if v < min_v do
            min_v = v
            min_idx = i
        end
        i = i + 1
    end
    out min_idx
end.

func tensor_variance(t: Tensor):
    if t.numel <= 1 do
        out 0.0
    end
    var mean = tensor_mean(t)
    var sum_sq = 0.0
    var comp = 0.0
    var i = 0
    when i < t.numel loop
        var diff = _load_f64(t.data, i) - mean
        var y = diff * diff - comp
        var s = sum_sq + y
        comp = (s - sum_sq) - y
        sum_sq = s
        i = i + 1
    end
    out sum_sq / to_f64(t.numel)
end.

# ─── Dimension-wise Reductions ────────────────────────

func tensor_sum_dim(t: Tensor, dim: int):
    if dim >= t.rank do panic("tensor_sum_dim: dim out of range") end
    var dim_size = _load_i64(t.shape, dim)
    var dim_stride = _load_i64(t.strides, dim)
    var out_rank = t.rank - 1
    var out_sh = alloc(out_rank * 8)
    var j = 0
    var i = 0
    when i < t.rank loop
        if i != dim do
            _store_i64(out_sh, j, _load_i64(t.shape, i))
            j = j + 1
        end
        i = i + 1
    end
    var out_t = tensor_zeros(out_sh, out_rank)
    free(out_sh)
    var indices = _alloc_zeroed(out_rank * 8)
    var out_idx = 0
    when out_idx < out_t.numel loop
        var base_off = 0
        var src_dim = 0
        var out_dim = 0
        when src_dim < t.rank loop
            if src_dim != dim do
                var idx = _load_i64(indices, out_dim)
                base_off = base_off + idx * _load_i64(t.strides, src_dim)
                out_dim = out_dim + 1
            end
            src_dim = src_dim + 1
        end
        var acc = 0.0
        var k = 0
        when k < dim_size loop
            acc = acc + _load_f64(t.data, base_off + k * dim_stride)
            k = k + 1
        end
        _store_f64(out_t.data, out_idx, acc)
        _increment_indices(indices, out_t.shape, out_rank)
        out_idx = out_idx + 1
    end
    free(indices)
    out out_t
end.

func tensor_mean_dim(t: Tensor, dim: int):
    var dim_size = _load_i64(t.shape, dim)
    var s = tensor_sum_dim(t, dim)
    var res = tensor_scale(s, 1.0 / to_f64(dim_size))
    tensor_free(s)
    out res
end.

func tensor_max_dim(t: Tensor, dim: int):
    if dim >= t.rank do panic("tensor_max_dim: dim out of range") end
    var dim_size = _load_i64(t.shape, dim)
    var dim_stride = _load_i64(t.strides, dim)
    var out_rank = t.rank - 1
    var out_sh = alloc(out_rank * 8)
    var j = 0
    var i = 0
    when i < t.rank loop
        if i != dim do
            _store_i64(out_sh, j, _load_i64(t.shape, i))
            j = j + 1
        end
        i = i + 1
    end
    var out_t = tensor_zeros(out_sh, out_rank)
    free(out_sh)
    var indices = _alloc_zeroed(out_rank * 8)
    var out_idx = 0
    when out_idx < out_t.numel loop
        var base_off = 0
        var src_dim = 0
        var out_dim = 0
        when src_dim < t.rank loop
            if src_dim != dim do
                var idx = _load_i64(indices, out_dim)
                base_off = base_off + idx * _load_i64(t.strides, src_dim)
                out_dim = out_dim + 1
            end
            src_dim = src_dim + 1
        end
        var m = _load_f64(t.data, base_off)
        var k = 1
        when k < dim_size loop
            var v = _load_f64(t.data, base_off + k * dim_stride)
            if v > m do m = v end
            k = k + 1
        end
        _store_f64(out_t.data, out_idx, m)
        _increment_indices(indices, out_t.shape, out_rank)
        out_idx = out_idx + 1
    end
    free(indices)
    out out_t
end.

# ═══════════════════════════════════════════════════════
# Matrix Multiplication Engine (2D Tiled & Batched)
# ═══════════════════════════════════════════════════════

func tensor_matmul_naive(a: Tensor, b: Tensor):
    if a.rank != 2 or b.rank != 2 do panic("tensor_matmul_naive: ranks must be 2") end
    var M = _load_i64(a.shape, 0)
    var K = _load_i64(a.shape, 1)
    var K2 = _load_i64(b.shape, 0)
    var N = _load_i64(b.shape, 1)
    if K != K2 do panic("tensor_matmul_naive: inner dimensions mismatch") end

    var out_shape = alloc(2 * 8)
    _store_i64(out_shape, 0, M)
    _store_i64(out_shape, 1, N)
    var c = tensor_zeros(out_shape, 2)
    free(out_shape)

    var a_s0 = _load_i64(a.strides, 0)
    var a_s1 = _load_i64(a.strides, 1)
    var b_s0 = _load_i64(b.strides, 0)
    var b_s1 = _load_i64(b.strides, 1)

    var i = 0
    when i < M loop
        var j = 0
        when j < N loop
            var acc = 0.0
            var k = 0
            when k < K loop
                var aval = _load_f64(a.data, i * a_s0 + k * a_s1)
                var bval = _load_f64(b.data, k * b_s0 + j * b_s1)
                acc = acc + aval * bval
                k = k + 1
            end
            _store_f64(c.data, i * N + j, acc)
            j = j + 1
        end
        i = i + 1
    end
    out c
end.

func tensor_matmul(a: Tensor, b: Tensor):
    if a.rank != 2 or b.rank != 2 do panic("tensor_matmul: ranks must be 2") end
    var M = _load_i64(a.shape, 0)
    var K = _load_i64(a.shape, 1)
    var K2 = _load_i64(b.shape, 0)
    var N = _load_i64(b.shape, 1)
    if K != K2 do panic("tensor_matmul: inner dimensions mismatch") end

    var out_shape = alloc(2 * 8)
    _store_i64(out_shape, 0, M)
    _store_i64(out_shape, 1, N)
    var c = tensor_zeros(out_shape, 2)
    free(out_shape)

    var a_s0 = _load_i64(a.strides, 0)
    var a_s1 = _load_i64(a.strides, 1)
    var b_s0 = _load_i64(b.strides, 0)
    var b_s1 = _load_i64(b.strides, 1)

    var BM = 32
    var BK = 32
    var BN = 32

    var ii = 0
    when ii < M loop
        var i_end = ii + BM
        if i_end > M do i_end = M end

        var kk = 0
        when kk < K loop
            var k_end = kk + BK
            if k_end > K do k_end = K end

            var jj = 0
            when jj < N loop
                var j_end = jj + BN
                if j_end > N do j_end = N end

                var i = ii
                when i < i_end loop
                    var c_row_off = i * N
                    var k = kk
                    when k < k_end loop
                        var a_val = _load_f64(a.data, i * a_s0 + k * a_s1)
                        var b_row_off = k * b_s0
                        var j = jj
                        when j < j_end loop
                            var b_val = _load_f64(b.data, b_row_off + j * b_s1)
                            var old_c = _load_f64(c.data, c_row_off + j)
                            _store_f64(c.data, c_row_off + j, old_c + a_val * b_val)
                            j = j + 1
                        end
                        k = k + 1
                    end
                    i = i + 1
                end
                jj = jj + BN
            end
            kk = kk + BK
        end
        ii = ii + BM
    end
    out c
end.

func tensor_bmm(a: Tensor, b: Tensor):
    if a.rank != 3 or b.rank != 3 do panic("tensor_bmm: rank must be 3") end
    var B = _load_i64(a.shape, 0)
    var B2 = _load_i64(b.shape, 0)
    if B != B2 do panic("tensor_bmm: batch size mismatch") end
    var M = _load_i64(a.shape, 1)
    var K = _load_i64(a.shape, 2)
    var K2 = _load_i64(b.shape, 1)
    var N = _load_i64(b.shape, 2)
    if K != K2 do panic("tensor_bmm: inner dimensions mismatch") end

    var out_shape = alloc(3 * 8)
    _store_i64(out_shape, 0, B)
    _store_i64(out_shape, 1, M)
    _store_i64(out_shape, 2, N)
    var c = tensor_zeros(out_shape, 3)
    free(out_shape)

    var a_b_stride = _load_i64(a.strides, 0)
    var b_b_stride = _load_i64(b.strides, 0)
    var c_b_stride = M * N

    var batch = 0
    when batch < B loop
        var a_ptr = (a.data as int + batch * a_b_stride * 8) as ptr
        var b_ptr = (b.data as int + batch * b_b_stride * 8) as ptr
        var c_ptr = (c.data as int + batch * c_b_stride * 8) as ptr

        var a_s1 = _load_i64(a.strides, 1)
        var a_s2 = _load_i64(a.strides, 2)
        var b_s1 = _load_i64(b.strides, 1)
        var b_s2 = _load_i64(b.strides, 2)

        var i = 0
        when i < M loop
            var k = 0
            when k < K loop
                var aval = _load_f64(a_ptr, i * a_s1 + k * a_s2)
                var j = 0
                when j < N loop
                    var bval = _load_f64(b_ptr, k * b_s1 + j * b_s2)
                    var old_c = _load_f64(c_ptr, i * N + j)
                    _store_f64(c_ptr, i * N + j, old_c + aval * bval)
                    j = j + 1
                end
                k = k + 1
            end
            i = i + 1
        end
        batch = batch + 1
    end
    out c
end.

# ═══════════════════════════════════════════════════════
# Activations (Elementwise & Normalization)
# ═══════════════════════════════════════════════════════

func tensor_relu(t: Tensor):
    var out_t = tensor_zeros(t.shape, t.rank)
    var i = 0
    when i < t.numel loop
        var v = _load_f64(t.data, i)
        if v < 0 do v = 0 end
        _store_f64(out_t.data, i, v)
        i = i + 1
    end
    out out_t
end.

func tensor_sigmoid(t: Tensor):
    var out_t = tensor_zeros(t.shape, t.rank)
    var i = 0
    when i < t.numel loop
        var v = _load_f64(t.data, i)
        _store_f64(out_t.data, i, sigmoid(v))
        i = i + 1
    end
    out out_t
end.

func tensor_silu(t: Tensor):
    var out_t = tensor_zeros(t.shape, t.rank)
    var i = 0
    when i < t.numel loop
        var v = _load_f64(t.data, i)
        _store_f64(out_t.data, i, v * sigmoid(v))
        i = i + 1
    end
    out out_t
end.

func tensor_gelu(t: Tensor):
    var out_t = tensor_zeros(t.shape, t.rank)
    var i = 0
    when i < t.numel loop
        var x = _load_f64(t.data, i)
        var g = 0
        if x > 0 do g = x end
        _store_f64(out_t.data, i, g)
        i = i + 1
    end
    out out_t
end.

func tensor_softmax(t: Tensor, dim: int):
    if dim < 0 or dim >= t.rank do
        panic("tensor_softmax: dim out of range")
    end
    var out_t = tensor_zeros(t.shape, t.rank)
    var dim_size = _load_i64(t.shape, dim)
    var dim_stride = _load_i64(t.strides, dim)

    var outer_slices = t.numel / dim_size
    var s = 0
    when s < outer_slices loop
        var start_off = s * dim_size
        var max_val = _load_f64(t.data, start_off)
        var j = 1
        when j < dim_size loop
            var v = _load_f64(t.data, start_off + j * dim_stride)
            if v > max_val do max_val = v end
            j = j + 1
        end

        var sum_exp = 0
        j = 0
        when j < dim_size loop
            var ev = exp(_load_f64(t.data, start_off + j * dim_stride) - max_val)
            _store_f64(out_t.data, start_off + j * dim_stride, ev)
            sum_exp = sum_exp + ev
            j = j + 1
        end
        if sum_exp == 0 do sum_exp = 1 end

        j = 0
        when j < dim_size loop
            var curr = _load_f64(out_t.data, start_off + j * dim_stride)
            _store_f64(out_t.data, start_off + j * dim_stride, curr / sum_exp)
            j = j + 1
        end
        s = s + 1
    end
    out out_t
end.

# ═══════════════════════════════════════════════════════
# Neural Network Primitives
# ═══════════════════════════════════════════════════════

func tensor_linear(x: Tensor, w: Tensor, b: ptr):
    if x.rank != 2 or w.rank != 2 do panic("tensor_linear: x and w must be 2D") end
    var batch = _load_i64(x.shape, 0)
    var in_f = _load_i64(x.shape, 1)
    var out_f = _load_i64(w.shape, 0)
    var in_f2 = _load_i64(w.shape, 1)
    if in_f != in_f2 do panic("tensor_linear: feature size mismatch") end

    var w_t = tensor_transpose(w, 0, 1)
    var out_t = tensor_matmul(x, w_t)
    tensor_free(w_t)

    if b != null do
        var bias_t = b as ptr
        var i = 0
        when i < batch loop
            var j = 0
            when j < out_f loop
                var old_val = _load_f64(out_t.data, i * out_f + j)
                var b_val = _load_f64(bias_t, j)
                _store_f64(out_t.data, i * out_f + j, old_val + b_val)
                j = j + 1
            end
            i = i + 1
        end
    end
    out out_t
end.

func tensor_layer_norm(x: Tensor, gamma: ptr, beta: ptr, eps: float):
    var out_t = tensor_zeros(x.shape, x.rank)
    var last_dim = x.rank - 1
    var dim_size = _load_i64(x.shape, last_dim)
    var num_rows = x.numel / dim_size

    var r = 0
    when r < num_rows loop
        var row_off = r * dim_size
        var mean = 0
        var i = 0
        when i < dim_size loop
            mean = mean + _load_f64(x.data, row_off + i)
            i = i + 1
        end
        mean = mean / dim_size

        var var_acc = 0
        i = 0
        when i < dim_size loop
            var diff = _load_f64(x.data, row_off + i) - mean
            var_acc = var_acc + diff * diff
            i = i + 1
        end
        var std_dev = sqrt(var_acc / dim_size + eps)
        if std_dev == 0 do std_dev = 1 end

        i = 0
        when i < dim_size loop
            var norm = (_load_f64(x.data, row_off + i) - mean) / std_dev
            var g = 1
            if gamma != null do g = _load_f64(gamma, i) end
            var bt = 0
            if beta != null do bt = _load_f64(beta, i) end
            _store_f64(out_t.data, row_off + i, norm * g + bt)
            i = i + 1
        end
        r = r + 1
    end
    out out_t
end.

func tensor_rms_norm(x: Tensor, gamma: ptr, eps: float):
    var out_t = tensor_zeros(x.shape, x.rank)
    var last_dim = x.rank - 1
    var dim_size = _load_i64(x.shape, last_dim)
    var num_rows = x.numel / dim_size

    var r = 0
    when r < num_rows loop
        var row_off = r * dim_size
        var sum_sq = 0
        var i = 0
        when i < dim_size loop
            var v = _load_f64(x.data, row_off + i)
            sum_sq = sum_sq + v * v
            i = i + 1
        end
        var rms = sqrt(sum_sq / dim_size + eps)
        if rms == 0 do rms = 1 end

        i = 0
        when i < dim_size loop
            var v = _load_f64(x.data, row_off + i)
            var g = 1
            if gamma != null do g = _load_f64(gamma, i) end
            _store_f64(out_t.data, row_off + i, (v * g) / rms)
            i = i + 1
        end
        r = r + 1
    end
    out out_t
end.

# ═══════════════════════════════════════════════════════
# Internal Helpers
# ═══════════════════════════════════════════════════════

func _compute_numel(shape: ptr, rank: int):
    if rank == 0 do out 1 end
    var n = 1
    var i = 0
    when i < rank loop
        n = n * _load_i64(shape, i)
        i = i + 1
    end
    out n
end.

func _compute_row_major_strides(shape: ptr, rank: int):
    var st = alloc(rank * 8)
    if rank == 0 do out st end
    var stride = 1
    var i = rank
    when i > 0 loop
        i = i - 1
        _store_i64(st, i, stride)
        stride = stride * _load_i64(shape, i)
    end
    out st
end.

func _clone_shape(src: ptr, rank: int):
    if rank == 0 or src == null do out null end
    var dst = alloc(rank * 8)
    _copy_words(dst, src, rank)
    out dst
end.

func _check_same_shape(a: Tensor, b: Tensor):
    if a.rank != b.rank do panic("tensor: rank mismatch") end
    var i = 0
    when i < a.rank loop
        if _load_i64(a.shape, i) != _load_i64(b.shape, i) do
            panic("tensor: shape mismatch at dimension")
        end
        i = i + 1
    end
end.

