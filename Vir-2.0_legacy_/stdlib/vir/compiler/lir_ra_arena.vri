##
 * vir/compiler/lir_ra_arena.vri — RA Scratch Block-Arena Allocator
 * ================================================================
 * Supplies aligned bump allocation for ephemeral register allocation
 * data structures (CFG liveness sets, worklists, adjacency chunks).
 *
 * Scoped ownership contract:
 * - Lifetimes bounded by single RA function invocation or checkpoint.
 * - Supports rewind to checkpoint and whole-arena reset per function.
 * - Zero escaping pointers to returned LirFunc or compiler diagnostics.
 ##

module vir.compiler.lir_ra_arena

include types
include vec_rt
import vec_new_rt, vec_push_rt, vec_get_rt, vec_set_rt, vec_len_rt from vec_rt
include string_rt
import native_read_i64, native_write_i64 from string_rt

const RA_BLOCK_SIZE: i64 = 65536   # 64 KiB initial block size

# RaBlock header layout (32 bytes):
# 0:  data_ptr (i64)
# 8:  offset (i64)
# 16: capacity (i64)
# 24: next_block (i64)

# RaArena header layout (32 bytes):
# 0:  head_block (i64)
# 8:  cur_block (i64)
# 16: block_count (i64)
# 24: total_bytes (i64)

func ra_block_new(cap_bytes: i64):
    let blk = alloc(32)
    let buf = alloc(cap_bytes)
    native_write_i64(blk, 0, buf)
    native_write_i64(blk, 8, 0)
    native_write_i64(blk, 16, cap_bytes)
    native_write_i64(blk, 24, 0)
    out blk
end.

func ra_arena_new():
    let arena = alloc(32)
    let first_blk = ra_block_new(RA_BLOCK_SIZE)
    native_write_i64(arena, 0, first_blk)
    native_write_i64(arena, 8, first_blk)
    native_write_i64(arena, 16, 1)
    native_write_i64(arena, 24, 0)
    out arena
end.

# Allocates bytes aligned to 16 bytes.
func ra_arena_alloc(arena: i64, size: i64):
    if arena == 0 do
        out alloc(size)
    end
    # Align to 16 bytes
    let aligned = (size + 15) and (0 - 16)
    var cur = native_read_i64(arena, 8)
    if cur == 0 do
        cur = ra_block_new(RA_BLOCK_SIZE)
        native_write_i64(arena, 0, cur)
        native_write_i64(arena, 8, cur)
    end
    let off = native_read_i64(cur, 8)
    let cap = native_read_i64(cur, 16)
    if off + aligned <= cap do
        let ptr = native_read_i64(cur, 0) + off
        native_write_i64(cur, 8, off + aligned)
        let tot = native_read_i64(arena, 24)
        native_write_i64(arena, 24, tot + aligned)
        out ptr
    end

    # Need a new block
    var next_cap = RA_BLOCK_SIZE
    if aligned > next_cap do
        next_cap = aligned + 128
    end
    let new_blk = ra_block_new(next_cap)
    native_write_i64(cur, 24, new_blk)
    native_write_i64(arena, 8, new_blk)
    let cnt = native_read_i64(arena, 16)
    native_write_i64(arena, 16, cnt + 1)

    let ptr = native_read_i64(new_blk, 0)
    native_write_i64(new_blk, 8, aligned)
    let tot = native_read_i64(arena, 24)
    native_write_i64(arena, 24, tot + aligned)
    out ptr
end.

# Checkpoint: pack current block pointer and current offset
func ra_arena_checkpoint(arena: i64):
    if arena == 0 do out 0 end
    let cur = native_read_i64(arena, 8)
    if cur == 0 do out 0 end
    let off = native_read_i64(cur, 8)
    out cur + off
end.

# Reset whole arena back to initial state (reusing allocated blocks)
func ra_arena_reset(arena: i64):
    if arena == 0 do out 0 end
    var b = native_read_i64(arena, 0)
    when b != 0 loop
        native_write_i64(b, 8, 0)
        b = native_read_i64(b, 24)
    end
    let head = native_read_i64(arena, 0)
    native_write_i64(arena, 8, head)
    native_write_i64(arena, 24, 0)
    out 0
end.

export ra_arena_new, ra_arena_alloc, ra_arena_checkpoint, ra_arena_reset
