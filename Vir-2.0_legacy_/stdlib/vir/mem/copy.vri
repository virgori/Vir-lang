##
 * vir/mem/copy.vri — Memory Operations
 * ======================================
 * Inspired by C23: <string.h> memcpy, memset, memmove, memcmp
 * Features bulk 16-byte fast paths with scalar oracle fallback and scalar tails.
 ##

include types

func mem_copy_scalar:
    in  dst: ptr
        src: ptr
        n: int
    var i = 0
    when i < n loop
        native_write_u8(dst as int, i, native_read_u8(src as int, i))
        i = i + 1
    end
end.

func mem_copy:
    in  dst: ptr
        src: ptr
        n: int
    let d = dst as int
    let s = src as int
    if n <= 0 or d == s do out end
    if n == 8 do
        native_write_i64(d, 0, native_read_i64(s, 0))
        out
    end
    if n == 16 do
        native_write_i64(d, 0, native_read_i64(s, 0))
        native_write_i64(d, 8, native_read_i64(s, 8))
        out
    end
    if n >= 32 do
        native_mem_copy(d, s, n)
        out
    end
    var i = 0
    when i + 8 <= n loop
        let w = native_read_i64(s, i)
        native_write_i64(d, i, w)
        i = i + 8
    end
    when i < n loop
        native_write_u8(d, i, native_read_u8(s, i))
        i = i + 1
    end
end.

func mem_set_scalar:
    in  dst: ptr
        val: int
        n: int
    var i = 0
    when i < n loop
        native_write_u8(dst as int, i, val and 255)
        i = i + 1
    end
end.

func mem_set:
    in  dst: ptr
        val: int
        n: int
    let d = dst as int
    if n <= 0 do out end
    let b = val and 255
    var w = b or (b shl 8)
    w = w or (w shl 16)
    w = w or (w shl 32)
    if n == 8 do
        native_write_i64(d, 0, w)
        out
    end
    if n == 16 do
        native_write_i64(d, 0, w)
        native_write_i64(d, 8, w)
        out
    end
    if n >= 32 do
        native_mem_set(d, val, n)
        out
    end
    var i = 0
    when i + 8 <= n loop
        native_write_i64(d, i, w)
        i = i + 8
    end
    when i < n loop
        native_write_u8(d, i, b)
        i = i + 1
    end
end.

func mem_zero_scalar(dst: ptr, n: int):
    mem_set_scalar(dst, 0, n)
end.

func mem_zero(dst: ptr, n: int):
    mem_set(dst, 0, n)
end.

func mem_move_scalar:
    in  dst: ptr
        src: ptr
        n: int
    if (dst as int) <= (src as int) do
        mem_copy_scalar(dst, src, n)
        out
    end
    var i = n
    when i > 0 loop
        i = i - 1
        native_write_u8(dst as int, i, native_read_u8(src as int, i))
    end
end.

func mem_move:
    in  dst: ptr
        src: ptr
        n: int
    let d = dst as int
    let s = src as int
    if n <= 0 or d == s do out end
    if d < s do
        mem_copy(dst, src, n)
        out
    end
    var i = n
    when (i and 7) != 0 loop
        i = i - 1
        native_write_u8(d, i, native_read_u8(s, i))
    end
    when i >= 16 loop
        i = i - 16
        let w0 = native_read_i64(s, i)
        let w1 = native_read_i64(s, i + 8)
        native_write_i64(d, i, w0)
        native_write_i64(d, i + 8, w1)
    end
    if i >= 8 do
        i = i - 8
        let w = native_read_i64(s, i)
        native_write_i64(d, i, w)
    end
    when i > 0 loop
        i = i - 1
        native_write_u8(d, i, native_read_u8(s, i))
    end
end.

func mem_cmp:
    in  a: ptr
        b: ptr
        n: int
    if n <= 0 do out 0 end
    let pa = a as int
    let pb = b as int
    if pa == pb do out 0 end
    var i = 0
    when i + 8 <= n loop
        let wa = native_read_i64(pa, i)
        let wb = native_read_i64(pb, i)
        if wa != wb do
            var j = 0
            when j < 8 loop
                let av = native_read_u8(pa, i + j)
                let bv = native_read_u8(pb, i + j)
                if av < bv do out 0 - 1 end
                if av > bv do out 1 end
                j = j + 1
            end
        end
        i = i + 8
    end
    when i < n loop
        let av = native_read_u8(pa, i)
        let bv = native_read_u8(pb, i)
        if av < bv do out 0 - 1 end
        if av > bv do out 1 end
        i = i + 1
    end
    out 0
end.

func mem_eq:
    in  a: ptr
        b: ptr
        n: int
    out mem_cmp(a, b, n) == 0
end.
