##
 * vir/sync/spinlock.vri — Multi-Core Spinlock for Embedded & Bare Metal
 * ====================================================================
 * Low-level mutual exclusion lock using atomic compare-and-swap (CAS)
 * and power-saving event wait/send instructions (WFE/SEV).
 ##

# Allocate a new spinlock (state: 0 = unlocked, 1 = locked)
func spinlock_new:
    var p = alloc(8)
    native_write_i64(p, 0, 0)
    out p
end.

# Acquire spinlock (blocking spin with WFE)
func spinlock_acquire(lock_ptr: int):
    when atomic_cas(lock_ptr, 0, 1) == 0 loop
        wfe()
    end.
end.

# Try to acquire spinlock once without waiting (returns 1 on success, 0 on busy)
func spinlock_try_acquire(lock_ptr: int):
    out atomic_cas(lock_ptr, 0, 1)
end.

# Release spinlock and send event to wake other cores
func spinlock_release(lock_ptr: int):
    atomic_store(lock_ptr, 0)
    sev()
end.

export spinlock_new, spinlock_acquire, spinlock_try_acquire, spinlock_release
