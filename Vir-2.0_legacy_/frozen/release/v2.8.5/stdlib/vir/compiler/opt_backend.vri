##
 * vir/compiler/opt_backend.vri — Backend optimizer dispatch (no arch in MIR pipeline)
 * ================================================================================
 * Passes 10 (SIMD), 11 (TCO), 12 (IRC), 15 (ARC), 21 (shrink-wrap) are routed here.
 ##

include types
include target
import TargetArch, get_codegen_target from target
include opt_backend_arm64
import opt_arm64_run_mir_passes, opt_arm64_run_lir_passes, opt_arm64_run_simd_mir_passes from opt_backend_arm64
import opt_arm64_run_mir_passes, opt_arm64_run_lir_passes, opt_arm64_run_simd_mir_passes, opt_arm64_run_lir_pre, opt_arm64_run_lir_post from opt_backend_arm64
include opt_backend_x86
import opt_x86_run_mir_passes, opt_x86_run_lir_pre, opt_x86_run_lir_post from opt_backend_x86
include opt_backend_riscv
import opt_riscv_run_mir_passes, opt_riscv_run_lir_pre, opt_riscv_run_lir_post from opt_backend_riscv
include opt_backend_wasm
import opt_wasm_run_mir_passes, opt_wasm_run_lir_pre, opt_wasm_run_lir_post from opt_backend_wasm
include opt_backend_generic
import opt_generic_run_mir_passes, opt_generic_run_lir_passes, opt_generic_run_simd_mir_passes from opt_backend_generic
include opt_backend_arc
import opt_backend_run_arc_passes from opt_backend_arc

# MIR hooks after shared spec pipeline (ISA-specific MIR prep only).
func opt_backend_run_mir_post(blocks: i64, arch: int, opt_level: int):
    if arch == TargetArch.ARM64 or arch == 2 or arch == 0 do
        blocks = opt_arm64_run_mir_passes(blocks)
        if opt_level >= 2 do
            blocks = opt_arm64_run_simd_mir_passes(blocks)
        end
        blocks = opt_backend_run_arc_passes(blocks, opt_level)
        out blocks
    end
    if arch == TargetArch.X86_64 or arch == 1 do
        blocks = opt_x86_run_mir_passes(blocks)
        blocks = opt_backend_run_arc_passes(blocks, opt_level)
        out blocks
    end
    if arch == TargetArch.RISCV64 or arch == 3 do
        blocks = opt_riscv_run_mir_passes(blocks)
        blocks = opt_backend_run_arc_passes(blocks, opt_level)
        out blocks
    end
    if arch == TargetArch.Wasm32 or arch == 4 do
        blocks = opt_wasm_run_mir_passes(blocks)
        blocks = opt_backend_run_arc_passes(blocks, opt_level)
        out blocks
    end
    blocks = opt_generic_run_mir_passes(blocks)
    blocks = opt_backend_run_arc_passes(blocks, opt_level)
    out blocks
end.

# LIR hooks: shrink-wrap (21), TCO (11) marking done in lir_codegen; IRC (12) in regalloc.
# Pre-RA LIR hook: branch by target before register allocation
func opt_backend_run_lir_pre(lf: i64, arch: int):
    if arch == TargetArch.ARM64 or arch == 2 or arch == 0 do
        out opt_arm64_run_lir_pre(lf)
    end
    if arch == TargetArch.X86_64 or arch == 1 do
        out opt_x86_run_lir_pre(lf)
    end
    if arch == TargetArch.RISCV64 or arch == 3 do
        out opt_riscv_run_lir_pre(lf)
    end
    if arch == TargetArch.Wasm32 or arch == 4 do
        out opt_wasm_run_lir_pre(lf)
    end
    out lf
end.

# Post-RA LIR hook: completely independent optimizations per target
func opt_backend_run_lir_post(lf: i64, arch: int):
    if arch == TargetArch.ARM64 or arch == 2 or arch == 0 do
        out opt_arm64_run_lir_post(lf)
    end
    if arch == TargetArch.X86_64 or arch == 1 do
        out opt_x86_run_lir_post(lf)
    end
    if arch == TargetArch.RISCV64 or arch == 3 do
        out opt_riscv_run_lir_post(lf)
    end
    if arch == TargetArch.Wasm32 or arch == 4 do
        out opt_wasm_run_lir_post(lf)
    end
    out opt_generic_run_lir_passes(lf)
end.

export opt_backend_run_mir_post, opt_backend_run_lir_pre, opt_backend_run_lir_post
