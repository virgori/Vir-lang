##
 * vir/compiler/opt_pass.vri — Spec §1.2.1 optimizer pass registry (26 passes)
 * ========================================================================
 * Stages
 *   MIR     — architecture-neutral SSA/MIR (shared pipeline)
 *   LIR     — lowering / prologue-epilogue (per-target hooks, generic core)
 *   BACKEND — ISA-specific selection, SIMD, scheduling (never in MIR pipeline)
 ##

include types

# Optimization tier (spec §1.2.1)
const OptTier1: 1   # local / arithmetic
const OptTier2: 2   # loops / matrices
const OptTier3: 3   # memory / vector / register (MIR subset only)
const OptTier4: 4   # IPA / SSA advanced
const OptTier5: 5   # hyper backend structure (MIR: CFG; LIR: shrink-wrap)
const OptTier6: 6   # whole-program / SCCP / DAE / devirt

# Where the pass runs — shared MIR pipeline must only use OptStageMIR.
const OptStageMIR: 0
const OptStageLIR: 1
const OptStageBackend: 2

# Spec pass IDs 1..26 (names match vir_language_spec_v2.0_vi.md §1.2.1)
const OptPassConstFold: 1
const OptPassStrengthReduce: 2
const OptPassCSE: 3
const OptPassDCE: 4
const OptPassLICM: 5
const OptPassIVSR: 6
const OptPassLoopUnroll: 7
const OptPassLoopCollapse: 8
const OptPassLoopTiling: 9
const OptPassSIMD: 10
const OptPassTCO: 11
const OptPassIRC: 12
const OptPassBCE: 13
const OptPassEscapeArena: 14
const OptPassARCTrial: 15
const OptPassOrchestrator: 16
const OptPassInlining: 17
const OptPassGVN: 18
const OptPassPRE: 19
const OptPassSLP: 20
const OptPassShrinkWrap: 21
const OptPassJumpThread: 22
const OptPassSROA: 23
const OptPassSCCP: 24
const OptPassDAE: 25
const OptPassDevirt: 26

# Minimum -O level to run pass (0 = always when opts enabled)
func opt_pass_min_level(pass_id: int):
    if pass_id == OptPassConstFold or pass_id == OptPassDCE do out 0 end
    if pass_id <= OptPassCSE do out 1 end
    if pass_id <= OptPassLoopTiling do out 1 end
    if pass_id == OptPassBCE or pass_id == OptPassEscapeArena do out 2 end
    if pass_id == OptPassARCTrial do out 2 end
    if pass_id <= OptPassSLP do out 2 end
    if pass_id <= OptPassSROA do out 2 end
    if pass_id <= OptPassDevirt do out 3 end
    out 3
end.

func opt_pass_stage(pass_id: int):
    if pass_id == OptPassSIMD do out OptStageBackend end
    if pass_id == OptPassTCO do out OptStageLIR end
    if pass_id == OptPassIRC do out OptStageLIR end
    if pass_id == OptPassShrinkWrap do out OptStageLIR end
    if pass_id == OptPassARCTrial do out OptStageBackend end
    out OptStageMIR
end.

export OptTier1, OptTier2, OptTier3, OptTier4, OptTier5, OptTier6,
       OptStageMIR, OptStageLIR, OptStageBackend,
       OptPassConstFold, OptPassStrengthReduce, OptPassCSE, OptPassDCE,
       OptPassLICM, OptPassIVSR, OptPassLoopUnroll, OptPassLoopCollapse, OptPassLoopTiling,
       OptPassSIMD, OptPassTCO, OptPassIRC, OptPassBCE, OptPassEscapeArena, OptPassARCTrial,
       OptPassOrchestrator, OptPassInlining, OptPassGVN, OptPassPRE, OptPassSLP,
       OptPassShrinkWrap, OptPassJumpThread, OptPassSROA, OptPassSCCP, OptPassDAE, OptPassDevirt,
       opt_pass_min_level, opt_pass_stage
