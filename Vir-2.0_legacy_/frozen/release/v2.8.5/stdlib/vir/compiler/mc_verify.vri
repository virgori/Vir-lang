##
 * vir/compiler/mc_verify.vri — MCInst Stream Verifier
 * ===================================================
 * Verifies machine instruction validity, register ranges, scratch isolation,
 * immediate bounds, and branch target consistency prior to assembly emission.
 ##

module vir.compiler.mc_verify

include types
include vec_rt
import vec_new_rt, vec_push_rt, vec_get_rt, vec_len_rt from vec_rt
include string_rt
import native_read_i64, native_write_i64, sb_new, sb_append, sb_append_int, sb_to_string, sb_free from string_rt
include compiler.context
import print_ln from compiler.context
include compiler.mc
import TargetArch, MCOpcode, MCOperandKind, MCInst, MCOperand, mc_inst_opc, mc_inst_op0, mc_inst_op1, mc_inst_op2, mc_inst_op3, mc_opnd_kind, mc_opnd_reg_val, mc_opnd_imm_val, mc_opnd_mem_base, mc_opnd_mem_off from compiler.mc

func mc_verify_inst_reg(r: int, arch: int, ins_idx: int):
    if r < 0 do out 1 end
    if arch == TargetArch.X86_64 or arch == 1 do # x86_64
        if r > 15 do
            print_ln("mc_verify: error: x86_64 register ID out of bounds (0..15)")
            out 0
        end
    eif arch == TargetArch.RISCV64 or arch == 3 do # RISCV64
        if r > 31 do
            print_ln("mc_verify: error: RISC-V register ID out of bounds (0..31)")
            out 0
        end
    else # ARM64 (arch == 2 or arch == 0)
        if r > 31 do
            print_ln("mc_verify: error: ARM64 register ID out of bounds (0..31)")
            out 0
        end
    end
    out 1
end.

func mc_verify_inst(inst: MCInst, arch: int, ins_idx: int):
    let opc = mc_inst_opc(inst)

    # 1. Verify operand registers
    let op0 = mc_inst_op0(inst)
    if mc_opnd_kind(op0) == 1 do
        if mc_verify_inst_reg(mc_opnd_reg_val(op0), arch, ins_idx) == 0 do out 0 end
    eif mc_opnd_kind(op0) == 3 do
        if mc_verify_inst_reg(mc_opnd_mem_base(op0), arch, ins_idx) == 0 do out 0 end
    end

    let op1 = mc_inst_op1(inst)
    if mc_opnd_kind(op1) == 1 do
        if mc_verify_inst_reg(mc_opnd_reg_val(op1), arch, ins_idx) == 0 do out 0 end
    eif mc_opnd_kind(op1) == 3 do
        if mc_verify_inst_reg(mc_opnd_mem_base(op1), arch, ins_idx) == 0 do out 0 end
    end

    let op2 = mc_inst_op2(inst)
    if mc_opnd_kind(op2) == 1 do
        if mc_verify_inst_reg(mc_opnd_reg_val(op2), arch, ins_idx) == 0 do out 0 end
    eif mc_opnd_kind(op2) == 3 do
        if mc_verify_inst_reg(mc_opnd_mem_base(op2), arch, ins_idx) == 0 do out 0 end
    end

    let op3 = mc_inst_op3(inst)
    if mc_opnd_kind(op3) == 1 do
        if mc_verify_inst_reg(mc_opnd_reg_val(op3), arch, ins_idx) == 0 do out 0 end
    end

    # 2. Verify immediate bounds
    if arch == TargetArch.RISCV64 or arch == 3 do # RISC-V
        if opc == MCOpcode.RISCV_ADDI or opc == MCOpcode.RISCV_SLTIU or opc == MCOpcode.RISCV_XORI do
            let imm = mc_opnd_imm_val(op2)
            if imm < 0 - 2048 or imm > 2047 do
                print_ln("mc_verify: error: RISC-V immediate out of 12-bit range [-2048, 2047]")
                out 0
            end
        end
    end

    if arch == TargetArch.X86_64 or arch == 1 do # x86_64
        if opc == MCOpcode.X86_64_ADD_RI or opc == MCOpcode.X86_64_SUB_RI or opc == MCOpcode.X86_64_CMP_RI do
            let imm = mc_opnd_imm_val(op1)
            if imm < 0 - 2147483648 or imm > 2147483647 do
                print_ln("mc_verify: error: x86_64 ALU immediate out of signed 32-bit range")
                out 0
            end
        end
    end

    out 1
end.

func mc_verify_function(mc_insts: i64, arch: int):
    let n = vec_len_rt(mc_insts)
    var i = 0
    when i < n loop
        let ins = vec_get_rt(mc_insts, i) as MCInst
        if mc_verify_inst(ins, arch, i) == 0 do
            out 0
        end
        i = i + 1
    end
    out 1
end.
