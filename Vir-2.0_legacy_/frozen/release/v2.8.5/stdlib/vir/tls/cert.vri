##
 * vir/tls/cert.vri — TLS Certificate Helpers
 * ===========================================
 * Inspired by Go: crypto/tls Certificate / x509
 * Inspired by Python: ssl.SSLContext load_cert_chain
 *
 * Bridges vir/crypto/x509 parsing with vir/tls config loading.
 ##

module vir.tls.cert

include types
include option
import Option, Some, None from option
include result
import Result, Ok, Err, is_err from result
include string
import String, str_new from string
include tls
import TlsConfig, tls_config_new, tls_config_server, tls_config_set_ca, tls_config_free from tls
include crypto/x509
import X509Cert, x509_parse_pem, x509_matches_hostname, pem_decode from crypto/x509

entity TlsCertMaterial:
    cert_pem_path: string
    key_pem_path:  string
    ca_pem_path:   Option
end.

func tls_cert_material(cert_path: string, key_path: string):
    out TlsCertMaterial (
        cert_pem_path = cert_path,
        key_pem_path = key_path,
        ca_pem_path = None
    )
end.

func tls_cert_material_with_ca(cert_path: string, key_path: string, ca_path: string):
    out TlsCertMaterial (
        cert_pem_path = cert_path,
        key_pem_path = key_path,
        ca_pem_path = Some(ca_path)
    )
end.

func tls_cert_load_server(mat: TlsCertMaterial):
    out tls_config_server(mat.cert_pem_path, mat.key_pem_path)
end.

func tls_cert_load_client_ca(ca_path: string):
    cfg = tls_config_new()
    r = tls_config_set_ca(cfg, ca_path)
    if is_err(r) do
        tls_config_free(cfg)
        out r
    end
    out Ok(cfg)
end.

func tls_cert_parse_pem(pem: string):
    out x509_parse_pem(pem)
end.

func tls_cert_hostname_ok(cert: X509Cert, hostname: string):
    out x509_matches_hostname(cert, hostname)
end.

export TlsCertMaterial, tls_cert_material, tls_cert_material_with_ca
export tls_cert_load_server, tls_cert_load_client_ca
export tls_cert_parse_pem, tls_cert_hostname_ok
