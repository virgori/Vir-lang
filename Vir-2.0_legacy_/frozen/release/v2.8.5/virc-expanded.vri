# virc driver uses vir.rt.io.  Do not recursively pull vir/io/traits into every
# self-host promotion merely to preprocess includes.
import File, FileMode, file_read_all, file_create, file_write_all, file_close from file
import vir_alloc from vir.rt.alloc
