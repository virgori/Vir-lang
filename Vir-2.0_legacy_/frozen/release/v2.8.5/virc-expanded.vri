import x86_emit_jmp_rel32, x86_emit_je_rel32, x86_emit_jne_rel32, x86_emit_jg_rel32, x86_emit_jl_rel32, x86_emit_jge_rel32, x86_emit_jle_rel32 from compiler.codegen_x86
import x86_emit_sub_rsp_imm, x86_emit_add_rsp_imm, x86_emit_mov_reg_mem, x86_emit_mov_mem_reg, x86_emit_mov_reg_mem32, x86_emit_mov_mem_reg32, x86_emit_mov_reg_mem16, x86_emit_mov_mem_reg16, x86_emit_movzx_reg_mem8, x86_emit_mov_mem_reg8, x86_emit_nop, x86_emit_shl_cl, x86_emit_shr_cl, x86_emit_not_rr, x86_emit_neg_r, x86_emit_shr_imm, x86_emit_shl_imm, x86_emit_cmp_reg_imm32, x86_emit_and_imm8 from compiler.codegen_x86
