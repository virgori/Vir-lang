# @vir_source stdlib/vir/rt/io.vri 1
##
 * vir/rt/io.vri — I/O Runtime (Pure Vir, No libc)
 * ==================================================
 * File and console I/O built on raw syscalls.
 * Replaces C stdio (printf, fopen, fread, fwrite, fclose).
 *
 * Buffered I/O for performance.
 * UTF-8 native throughout.
 ##

module vir.rt.io

import sys_read, sys_write, sys_open, sys_close, sys_lseek,
    sys_fstat, STDIN_FD, STDOUT_FD, STDERR_FD,
    O_RDONLY, O_WRONLY, O_RDWR, O_CREAT, O_TRUNC, O_APPEND from syscall
import vir_alloc, vir_free, vir_realloc from alloc

# @vir_source stdlib/vir/rt/io.vri 21
import rt_strlen, rt_itoa, sb_new, sb_append, sb_append_char,
    sb_append_int, sb_to_string, sb_free, StringBuilder from string_rt


# ═══════════════════════════════════════════════════════
# Console Write — replaces printf/fputs
# ═══════════════════════════════════════════════════════

func print_str(s: int):

    let len = rt_strlen(s)
    sys_write(STDOUT_FD, s, len)
end.
func print_int(n: int):

    let s = rt_itoa(n)
    print_str(s)
end.
func print_ln(s: int):

    print_str(s)
    print_str("\n")
end.
func print_newline:
    let nl = "\n"
    sys_write(STDOUT_FD, nl, 1)
end.
func eprint_str(s: int):

    let len = rt_strlen(s)
    sys_write(STDERR_FD, s, len)
end.
func eprint_ln(s: int):

    eprint_str(s)
    let nl = "\n"
    sys_write(STDERR_FD, nl, 1)
end.
# ═══════════════════════════════════════════════════════
# Console Read — replaces scanf/fgets
# ═══════════════════════════════════════════════════════

func read_line:
    let buf = vir_alloc(4096)
    let pos = 0
    let byte_buf = vir_alloc(1)

    when true loop
        let n = sys_read(STDIN_FD, byte_buf, 1)
        if n <= 0 do
            out skip
        end

        extern func native_read_u8(addr: int, offset: int) -> int
        extern func native_write_u8(addr: int, offset: int, val: int)

        let ch = native_read_u8(byte_buf, 0)
        if ch == 10 do # '\n'
            out skip
        end
        native_write_u8(buf, pos, ch)
        pos = pos + 1

        if pos >= 4095 do
            out skip
        end
    end

    extern func native_write_u8(addr: int, offset: int, val: int)
    native_write_u8(buf, pos, 0)
    out buf
end.
# ═══════════════════════════════════════════════════════
# File Handle
# ═══════════════════════════════════════════════════════

entity VirFile:
    fd:       int,
        is_open:  bool,
        mode:     int     # O_RDONLY / O_WRONLY / O_RDWR
end.
const FILE_NONE = VirFile ( fd: -1, is_open: false, mode: 0 )

# ═══════════════════════════════════════════════════════
# File Open / Close
# ═══════════════════════════════════════════════════════

func file_open_read(path: int):

    let fd = sys_open(path, O_RDONLY, 0)
    print_str("virc: bootstrap read fd=")
    print_int(fd)
    print_ln("")
    if fd < 0 do
        out VirFile ( fd: -1, is_open: false, mode: 0 )
    end
    out VirFile ( fd: fd, is_open: true, mode: O_RDONLY )
end.
func file_open_write(path: int, mode: int):

    let fd = sys_open(path, O_WRONLY bit_or O_CREAT bit_or O_TRUNC, mode)
    if fd < 0 do
        out VirFile ( fd: -1, is_open: false, mode: 0 )
    end
    out VirFile ( fd: fd, is_open: true, mode: O_WRONLY )
end.
func file_open_append(path: int, mode: int):

    let fd = sys_open(path, O_WRONLY bit_or O_CREAT bit_or O_APPEND, mode)
    if fd < 0 do
        out VirFile ( fd: -1, is_open: false, mode: 0 )
    end
    out VirFile ( fd: fd, is_open: true, mode: O_WRONLY )
end.
func file_close(f: VirFile):

    if (f as i64) <= 4096 do
        out 0
    end
    if f.is_open do
        sys_close(f.fd)
    end
end.
# ═══════════════════════════════════════════════════════
# File Read
# ═══════════════════════════════════════════════════════

func file_read_all(f: VirFile):

    if (f as i64) <= 4096 or f.is_open == false do
        out 0
    end

    # Get file size
    let end_pos = sys_lseek(f.fd, 0, 2);    # SEEK_END
    sys_lseek(f.fd, 0, 0);                   # SEEK_SET

    if end_pos <= 0 do
        let empty = vir_alloc(1)
        extern func native_write_u8(addr: int, offset: int, val: int)
        native_write_u8(empty, 0, 0)
        out empty
    end

    let buf = vir_alloc(end_pos + 1)
    var total = 0
    var keep_reading = 1
    when total < end_pos and keep_reading == 1 loop
        let n = sys_read(f.fd, buf + total, end_pos - total)
        if n == -4 do
            skip
        end
        if n <= 0 do
            keep_reading = 0
            skip
        end
        total = total + n
    end

    extern func native_write_u8(addr: int, offset: int, val: int)
    native_write_u8(buf, total, 0);    # null-terminate
    out buf
end.
func file_read_bytes:
    in  f: VirFile
        buf: int
        count: int

    if f.is_open == false do
        out -1
    end
    out sys_read(f.fd, buf, count)
end.
# ═══════════════════════════════════════════════════════
# File Write
# ═══════════════════════════════════════════════════════

func file_write_str(f: VirFile, s: int):

    if f.is_open == false do
        out -1
    end
    let len = rt_strlen(s)
    out sys_write(f.fd, s, len)
end.
func file_write_bytes:
    in  f: VirFile
        data: int
        len: int

    if f.is_open == false do
        out -1
    end
    var written = 0
    var keep_writing = 1
    when written < len and keep_writing == 1 loop
        let n = sys_write(f.fd, data + written, len - written)
        if n == -4 do
            skip
        end
        if n <= 0 do
            keep_writing = 0
            skip
        end
        written = written + n
    end
    out written
end.
# ═══════════════════════════════════════════════════════
# File Size
# ═══════════════════════════════════════════════════════

func file_size(f: VirFile):

    let cur = sys_lseek(f.fd, 0, 1);      # SEEK_CUR
    let end_pos = sys_lseek(f.fd, 0, 2);  # SEEK_END
    sys_lseek(f.fd, cur, 0);              # restore position
    out end_pos
end.
# ═══════════════════════════════════════════════════════

# Convenience: Read file by path
# ═══════════════════════════════════════════════════════

extern func native_write_u8(addr: int, offset: int, val: int)

func read_file_str(path: int):
    # Keep the bootstrap path scalar-only. Returning VirFile across a
    # self-hosted generation currently depends on aggregate-return ABI details
    # and can turn a valid descriptor into an empty read in the next compiler.
    let fd = sys_open(path, O_RDONLY, 0)
    if fd < 0 do
        out 0
    end
    var cap = 67108864
    var content = vir_alloc(cap)
    var total = 0
    var reading = 1
    when reading == 1 loop
        var to_read = cap - total - 1
        if to_read > 65536 do
            to_read = 65536
        end
        let n = sys_read(fd, content + total, to_read)
        if n == -4 do
            skip
        end
        if n <= 0 do
            reading = 0
            skip
        end
        total = total + n
    end
    native_write_u8(content, total, 0)
    sys_close(fd)
    out content
end.
# ═══════════════════════════════════════════════════════
# Convenience: Write string to file by path
# ═══════════════════════════════════════════════════════

func write_file_str(path: int, content: int):

    let f = file_open_write(path, 0o644)
    if (f as i64) <= 4096 or f.is_open == false do
        out false
    end
    file_write_str(f, content)
    out true
end.
# ═══════════════════════════════════════════════════════
# Convenience: Write bytes to file by path
# ═══════════════════════════════════════════════════════

func write_file_bytes:
    in  path: int
        data: int
        len: int
        mode: int

    let f = file_open_write(path, mode)
    if f.is_open == false do
        out false
    end
    file_write_bytes(f, data, len)
    sys_close(f.fd)
    out true
end.

# @vir_source stdlib/vir/compiler/virc.vri 29
import print_str, print_int, print_ln, print_newline, eprint_ln,
        file_open_read, file_read_all, file_close,
        write_file_bytes, write_file_str, read_file_str from vir.rt.io
# @vir_source stdlib/vir/rt/vec_rt.vri 1
##
 * vir/rt/vec_rt.vri — Dynamic Array Runtime (Pure Vir)
 * =====================================================
 * Growable vector (dynamic array) built on vir_alloc/realloc.
 * Core data structure for the self-hosting compiler.
 *
 * Layout: [cap:i64][len:i64][data[0]][data[1]]...
 *                            ^-- returned pointer
 ##

module vir.rt.vec_rt

import vir_alloc, vir_free, vir_realloc from alloc

extern func native_read_i64(addr: int, offset: int) -> int
extern func native_write_i64(addr: int, offset: int, val: int)
extern func native_mem_copy(dst: int, src: int, len: int)

# ═══════════════════════════════════════════════════════
# Vec operations (i64 element array)
# ═══════════════════════════════════════════════════════
# Header: ptr[-2] = capacity, ptr[-1] = length
# Data starts at ptr[0]

const VEC_INIT_CAP = 16
const ELEM_SIZE = 8;          # i64 = 8 bytes
const HEADER_SIZE = 16;       # 2 * 8 bytes

func vec_new_rt():
    # Bind the derived data pointer directly.  A separate owning `base`
    # local is auto-dropped before `out base + HEADER_SIZE`, which returns a
    # dangling interior pointer.
    let data = vir_alloc(HEADER_SIZE + VEC_INIT_CAP * ELEM_SIZE) + HEADER_SIZE
    native_write_i64(data - HEADER_SIZE, 0, VEC_INIT_CAP)
    native_write_i64(data - 8, 0, 0)
    out data
end.
func vec_len_rt(v: int):

    if v == 0 do
        out 0
    end
    out native_read_i64(v - 8, 0)    # ptr[-1]
end.
func vec_cap_rt(v: int):

    out native_read_i64(v - 16, 0)   # ptr[-2]
end.
func vec_push_rt(v: int, val: int):

    let len = vec_len_rt(v)
    let cap = vec_cap_rt(v)

    if len >= cap do
        # Grow: double capacity
        var new_cap = cap * 2
        if new_cap < VEC_INIT_CAP do
            new_cap = VEC_INIT_CAP
        end
        let base = v - HEADER_SIZE
        let old_bytes = HEADER_SIZE + cap * ELEM_SIZE
        let new_bytes = HEADER_SIZE + new_cap * ELEM_SIZE
        let new_base = vir_alloc(new_bytes)
        if base != 0 and old_bytes > 0 do
            var ci = 0
            when ci + 8 <= old_bytes loop
                let word = native_read_i64(base, ci)
                let _w = native_write_i64(new_base, ci, word)
                ci = ci + 8
            end
        end
        let new_data = new_base + HEADER_SIZE
        native_write_i64(new_base, 0, new_cap)
        v = new_data
    end

    native_write_i64(v, len * 8, val)
    native_write_i64(v - 8, 0, len + 1)
    out v
end.
func vec_get_rt(v: int, index: int):

    if v == 0 do
        out 0
    end
    out native_read_i64(v, index * 8)
end.
func vec_set_rt(v: int, index: int, val: int):
    native_write_i64(v, index * 8, val)
    out v
end.
func vec_pop_rt(v: int):

    let len = vec_len_rt(v)
    if len == 0 do
        out 0
    end
    let val = vec_get_rt(v, len - 1)
    native_write_i64(v - 8, 0, len - 1)
    out val
end.
func vec_last_rt(v: int):

    let len = vec_len_rt(v)
    if len == 0 do
        out 0
    end
    out vec_get_rt(v, len - 1)
end.
func vec_clear_rt(v: int):

    native_write_i64(v - 8, 0, 0)
end.
func vec_free_rt(v: int):
    # vir_free(v - HEADER_SIZE)
end.
func vec_copy_rt(v: int):

    let len = vec_len_rt(v)
    let new_v = vec_new_rt()
    let i = 0
    when i < len loop
        new_v = vec_push_rt(new_v, vec_get_rt(v, i))
        i = i + 1
    end
    out new_v
end.
func vec_contains_rt(v: int, val: int):

    let len = vec_len_rt(v)
    let i = 0
    when i < len loop
        if vec_get_rt(v, i) == val do
            out true
        end
        i = i + 1
    end
    out false
end.
func vec_index_of_rt(v: int, val: int):

    let len = vec_len_rt(v)
    let i = 0
    when i < len loop
        if vec_get_rt(v, i) == val do
            out i
        end
        i = i + 1
    end
    out -1
end.
# ═══════════════════════════════════════════════════════
# Byte Vec — for code buffers (u8 elements)
# ═══════════════════════════════════════════════════════

extern func native_read_u8(addr: int, offset: int) -> int
extern func native_write_u8(addr: int, offset: int, val: int)

const BVEC_INIT_CAP = 4096

func bvec_new:
    # See vec_new_rt: do not give the allocation base a separate owner.
    let data = vir_alloc(HEADER_SIZE + BVEC_INIT_CAP) + HEADER_SIZE
    # Offsets are bytes (same as vec native_read/write_i64 convention).
    native_write_i64(data - HEADER_SIZE, 0, BVEC_INIT_CAP)
    native_write_i64(data - HEADER_SIZE, 8, 0)
    out data
end.
func bvec_len(v: int):

    out native_read_i64(v - 8, 0)
end.
func bvec_push(v: int, byte: int):

    let len = bvec_len(v)
    let cap = native_read_i64(v - 16, 0)

    if len >= cap do
        let new_cap = cap * 2
        let base = v - HEADER_SIZE
        let old_bytes = HEADER_SIZE + cap
        let new_bytes = HEADER_SIZE + new_cap
        let new_base = vir_alloc(new_bytes)
        if base != 0 and old_bytes > 0 do
            var ci = 0
            when ci + 8 <= old_bytes loop
                let word = native_read_i64(base, ci)
                let _w = native_write_i64(new_base, ci, word)
                ci = ci + 8
            end
            when ci < old_bytes loop
                let bval = native_read_u8(base, ci)
                let _b = native_write_u8(new_base, ci, bval)
                ci = ci + 1
            end
        end
        let new_data = new_base + HEADER_SIZE
        native_write_i64(new_base, 0, new_cap)
        v = new_data
    end

    native_write_u8(v, len, byte & 0xFF)
    native_write_i64(v - 8, 0, len + 1)
    out v
end.
func bvec_push_u16_le(v: int, val: int):

    v = bvec_push(v, val & 0xFF)
    v = bvec_push(v, (val shr 8) & 0xFF)
    out v
end.
func bvec_push_u32_le(v: int, val: int):

    v = bvec_push(v, val & 0xFF)
    v = bvec_push(v, (val shr 8) & 0xFF)
    v = bvec_push(v, (val shr 16) & 0xFF)
    v = bvec_push(v, (val shr 24) & 0xFF)
    out v
end.
func bvec_push_u64_le(v: int, val: int):

    v = bvec_push_u32_le(v, val & 0xFFFFFFFF)
    v = bvec_push_u32_le(v, (val shr 32) & 0xFFFFFFFF)
    out v
end.
func bvec_get(v: int, index: int):

    out native_read_u8(v, index)
end.
func bvec_set:
    in  v: int
        index: int
        byte: int

    native_write_u8(v, index, byte & 0xFF)
end.
func bvec_patch_u32_le:
    in  v: int
        offset: int
        val: int

    native_write_u8(v, offset, val & 0xFF)
    native_write_u8(v, offset + 1, (val shr 8) & 0xFF)
    native_write_u8(v, offset + 2, (val shr 16) & 0xFF)
    native_write_u8(v, offset + 3, (val shr 24) & 0xFF)
end.
func bvec_data_ptr(v: int):

    out v   # data pointer is v itself
end.
func bvec_free(v: int):
    # vir_free(v - HEADER_SIZE)
end.

# @vir_source stdlib/vir/compiler/virc.vri 33
import vec_new_rt, vec_push_rt, vec_get_rt, vec_set_rt, vec_len_rt,
       vec_free_rt, bvec_new, bvec_push, bvec_push_u32_le,
       bvec_push_u64_le, bvec_len, bvec_get, bvec_data_ptr,
       bvec_free from vir.rt.vec_rt
# @vir_source stdlib/vir/rt/start.vri 1
##
 * vir/rt/start.vri — Program Entry Point (Pure Vir, No C)
 * =========================================================
 * This replaces runtime.c entirely.
 *
 * On macOS ARM64 (Mach-O), the kernel jumps to _start.
 * The stack contains
 *   [SP]     → argc (i64)
 *   [SP+8]   → argv[0] pointer
 *   [SP+16]  → argv[1] pointer
 *   ...
 *   [SP+8*(argc+1)] → NULL
 *   then envp[]
 *
 * On Linux ARM64 (ELF), identical stack layout.
 *
 * This module
 *   1. Extracts argc/argv from stack
 *   2. Initializes the heap allocator
 *   3. Calls user's main() function
 *   4. Calls sys_exit with return code
 ##

module vir.rt.start

import sys_exit from syscall
import heap_init, MIN_ARENA_SIZE from alloc

# ═══════════════════════════════════════════════════════
# Global argc/argv (set by _start)
# ═══════════════════════════════════════════════════════

var g_argc = 0
var g_argv = 0;     # pointer to argv array

func rt_argc:
    out g_argc
end.
func rt_argv(index: int):

    if index < 0 or index >= g_argc do
        out 0
    end
    extern func native_read_i64(addr: int, offset: int) -> int
    out native_read_i64(g_argv, index * 8)
end.
# ═══════════════════════════════════════════════════════
# ═══════════════════════════════════════════════════════
# Compiler-emitted intrinsics
# ═══════════════════════════════════════════════════════
# The following are emitted as inline machine code by the
# Vir compiler. They do NOT call libc.

# Memory intrinsics (compiled to plain load/store instructions)
# native_read_u8(addr, offset)   → ldrb w0, [x0, x1]
# native_write_u8(addr, ofs, v)  → strb w2, [x0, x1]
# native_read_i64(addr, offset)  → ldr  x0, [x0, x1]
# native_write_i64(addr, ofs, v) → str  x2, [x0, x1]
# native_mem_copy(dst, src, len) → loop of ldrb/strb
# native_mem_set(dst, val, len)  → loop of strb

# Syscall intrinsics (compiled to SVC / SYSCALL instructions)
# syscall0..6 → mov args to regs, mov sysnum to x16/x8/rax, svc/syscall

# @vir_source stdlib/vir/compiler/virc.vri 38
import rt_argc, rt_argv from vir.rt.start
# Note: vir.str.string removed — compiler modules use stdlib/vir/string.vri shim instead

# ── Mach-O/ELF emitters — MUST be BEFORE compiler/main (which includes
#    binary.vri) so that these definitions win under "first compiled wins" ──
# @vir_source stdlib/vir/compiler/macho.vri 1
##
 * vir/compiler/macho.vri — Mach-O Executable Emitter (Pure Vir)
 * =========================================================
 * Emits a complete Mach-O 64-bit executable for macOS ARM64
 * and x86-64. No external assembler (as) or linker (ld) needed.
 *
 * Produces a standalone binary that the kernel can exec directly
 *   Mach-O Header → Load Commands → __TEXT → __DATA → LC_MAIN
 *
 * The binary uses direct BSD syscalls — no dyld, no libSystem
 * unless linking is explicitly requested.
 ##
module vir.compiler.macho


# @vir_source stdlib/vir/compiler/macho.vri 17
import bvec_new, bvec_push, bvec_push_u16_le, bvec_push_u32_le, bvec_push_u64_le,
    bvec_len, bvec_get, bvec_set, bvec_patch_u32_le, bvec_data_ptr, bvec_free,
    vec_new_rt, vec_push_rt, vec_get_rt, vec_set_rt, vec_len_rt from vec_rt

# @vir_source stdlib/vir/compiler/macho.vri 21
import write_file_bytes from io
import rt_strlen, fat_str_new, fat_str_eq, fat_str_len, fat_str_byte_at from string_rt
# @vir_source stdlib/vir/compiler/ffi_imports.vri 1
##
 * vir/compiler/ffi_imports.vri — target-neutral external symbol registry
 *
 * Parser/lowering record extern declarations here.  Object-format writers
 * consume the same registry to make their platform import tables; keeping
 * the registry independent of Mach-O avoids encoding macOS policy in MIR.
 ##

import vec_new_rt, vec_push_rt, vec_get_rt, vec_set_rt, vec_len_rt from vec_rt
import fat_str_eq, fat_str_new from string_rt

var g_ffi_import_names: i64 = 0
var g_ffi_import_sources: i64 = 0
var g_ffi_import_used: i64 = 0
var g_ffi_import_param_types: i64 = 0
var g_ffi_import_return_types: i64 = 0
var g_ffi_arm64_stub_offsets: i64 = 0
var g_ffi_arm64_stub_imports: i64 = 0

func ffi_import_reset():
    g_ffi_import_names = vec_new_rt()
    g_ffi_import_sources = vec_new_rt()
    g_ffi_import_used = vec_new_rt()
    g_ffi_import_param_types = vec_new_rt()
    g_ffi_import_return_types = vec_new_rt()
    g_ffi_arm64_stub_offsets = vec_new_rt()
end.

func ffi_import_register(name: string, source: string, param_types: int, return_type: string):
    if g_ffi_import_names == 0 do ffi_import_reset() end
    var i = 0
    when i < vec_len_rt(g_ffi_import_names) loop
        if fat_str_eq(vec_get_rt(g_ffi_import_names, i) as string, name) == 1 do
            # One symbol has one linker source.  Keep the first declaration;
            # semantic analysis reports duplicate user symbols separately.
            out i
        end
        i = i + 1
    end
    g_ffi_import_names = vec_push_rt(g_ffi_import_names, name)
    g_ffi_import_sources = vec_push_rt(g_ffi_import_sources, source)
    g_ffi_import_used = vec_push_rt(g_ffi_import_used, 0)
    g_ffi_import_param_types = vec_push_rt(g_ffi_import_param_types, param_types)
    g_ffi_import_return_types = vec_push_rt(g_ffi_import_return_types, return_type)
    out vec_len_rt(g_ffi_import_names) - 1
end.

func ffi_import_find(name: string):
    if g_ffi_import_names == 0 do out 0 - 1 end
    var i = 0
    when i < vec_len_rt(g_ffi_import_names) loop
        if fat_str_eq(vec_get_rt(g_ffi_import_names, i) as string, name) == 1 do out i end
        i = i + 1
    end
    out 0 - 1
end.

func ffi_import_count():
    if g_ffi_import_names == 0 do out 0 end
    out vec_len_rt(g_ffi_import_names)
end.

func ffi_import_mark_used(index: int):
    if index >= 0 and index < ffi_import_count() do vec_set_rt(g_ffi_import_used, index, 1) end
end.

func ffi_import_used_count():
    var count = 0
    var i = 0
    when i < ffi_import_count() loop
        if vec_get_rt(g_ffi_import_used, i) != 0 do count = count + 1 end
        i = i + 1
    end
    out count
end.

func ffi_import_used_at(dense_index: int):
    var seen = 0
    var i = 0
    when i < ffi_import_count() loop
        if vec_get_rt(g_ffi_import_used, i) != 0 do
            if seen == dense_index do out i end
            seen = seen + 1
        end
        i = i + 1
    end
    out 0 - 1
end.

func ffi_import_name(index: int):
    if index < 0 or index >= ffi_import_count() do out fat_str_new("") end
    out vec_get_rt(g_ffi_import_names, index) as string
end.

func ffi_import_source(index: int):
    if index < 0 or index >= ffi_import_count() do out fat_str_new("os") end
    out vec_get_rt(g_ffi_import_sources, index) as string
end.

func ffi_import_param_count(index: int):
    if index < 0 or index >= ffi_import_count() do out 0 end
    params = vec_get_rt(g_ffi_import_param_types, index)
    if params == 0 do out 0 end
    out vec_len_rt(params)
end.

func ffi_import_param_type(index: int, param_index: int):
    if index < 0 or index >= ffi_import_count() do out fat_str_new("") end
    params = vec_get_rt(g_ffi_import_param_types, index)
    if params == 0 or param_index < 0 or param_index >= vec_len_rt(params) do
        out fat_str_new("")
    end
    out vec_get_rt(params, param_index) as string
end.

func ffi_import_return_type(index: int):
    if index < 0 or index >= ffi_import_count() do out fat_str_new("") end
    out vec_get_rt(g_ffi_import_return_types, index) as string
end.

# Platform policy belongs at the object writer boundary.  The symbolic `os`
# source is intentionally retained until then, so ELF, PE and Wasm can map it
# to their own standard import provider without changing parser/MIR.
func ffi_source_is_os(source: string):
    out fat_str_eq(source, fat_str_new("os"))
end.

func ffi_arm64_stubs_reset():
    g_ffi_arm64_stub_offsets = vec_new_rt()
    g_ffi_arm64_stub_imports = vec_new_rt()
end.

func ffi_arm64_stub_add(import_index: int, offset: int):
    if g_ffi_arm64_stub_offsets == 0 do ffi_arm64_stubs_reset() end
    g_ffi_arm64_stub_offsets = vec_push_rt(g_ffi_arm64_stub_offsets, offset)
    g_ffi_arm64_stub_imports = vec_push_rt(g_ffi_arm64_stub_imports, import_index)
end.

func ffi_arm64_stub_offset(import_index: int):
    if g_ffi_arm64_stub_offsets == 0 do out 0 - 1 end
    var i = 0
    when i < vec_len_rt(g_ffi_arm64_stub_offsets) loop
        if vec_get_rt(g_ffi_arm64_stub_imports, i) == import_index do out vec_get_rt(g_ffi_arm64_stub_offsets, i) end
        i = i + 1
    end
    out 0 - 1
end.

const MACHO_FFI_CODE_OFFSET: i64 = 2048

export ffi_import_reset, ffi_import_register, ffi_import_find, ffi_import_count,
       ffi_import_name, ffi_import_source, ffi_source_is_os, ffi_import_mark_used,
       ffi_import_param_count, ffi_import_param_type, ffi_import_return_type,
       ffi_import_used_count, ffi_import_used_at,
       ffi_arm64_stubs_reset, ffi_arm64_stub_add, ffi_arm64_stub_offset,
       MACHO_FFI_CODE_OFFSET

# @vir_source stdlib/vir/compiler/macho.vri 25
import ffi_import_used_count, ffi_import_used_at, ffi_import_name, ffi_import_source, ffi_source_is_os, ffi_arm64_stub_offset from vir.compiler.ffi_imports

# ═══════════════════════════════════════════════════════
# Mach-O Constants
# ═══════════════════════════════════════════════════════

# Magic numbers
const MH_MAGIC_64:      0xFEEDFACF

# CPU types
const CPU_TYPE_X86_64:  0x01000007
const CPU_TYPE_ARM64:   0x0100000C
const CPU_SUB_ALL:      0x00000000
const CPU_SUB_ARM64_ALL: 0x00000000

# File types
const MH_EXECUTE:       2

# Flags
const MH_NOUNDEFS:      0x00000001
const MH_DYLDLINK:      0x00000004
const MH_TWOLEVEL:      0x00000080
const MH_PIE:           0x00200000

# Load command types
const LC_SEGMENT_64:    0x19
const LC_MAIN:          0x80000028
const LC_SYMTAB:        0x02
const LC_DYSYMTAB:      0x0B
const LC_UUID:          0x1B
const LC_BUILD_VERSION: 0x32
const LC_SOURCE_VERSION: 0x2A
const LC_LOAD_DYLIB:    0x0C
const LC_LOAD_DYLINKER: 0x0E
const LC_DYLD_INFO_ONLY: 0x80000022
const LC_DYLD_CHAINED_FIXUPS: 0x80000034
const LC_CODE_SIGNATURE: 0x1D

# Embedded ad-hoc signature constants.  Apple Silicon requires every executed
# Mach-O page to be covered by a CodeDirectory, including binaries that do not
# carry a developer identity.  The compiler emits the compact SHA-256 form
# directly so generated artifacts do not depend on an external `codesign` step.
const CSMAGIC_EMBEDDED_SIGNATURE: 0xFADE0CC0
const CSMAGIC_CODEDIRECTORY: 0xFADE0C02
const CS_ADHOC: 2
const CS_HASHTYPE_SHA256: 2
const CS_HASH_SIZE_SHA256: 32
const CS_PAGE_SHIFT_ARM64: 14

# Segment/section constants
const VM_PROT_READ:     1
const VM_PROT_WRITE:    2
const VM_PROT_EXECUTE:  4

const S_ATTR_PURE_INSTRUCTIONS: 0x80000000
const S_ATTR_SOME_INSTRUCTIONS: 0x00000400
const S_REGULAR:        0x00000000
const S_ZEROFILL:       0x00000001
const S_NON_LAZY_SYMBOL_POINTERS: 0x00000006
const S_SYMBOL_STUBS:   0x00000008

# Page sizes
const PAGE_SIZE_ARM64:  0x4000;     # 16KB
const PAGE_SIZE_X86:    0x1000;     # 4KB
const TEXT_BASE:        0x100000000

# FFI constants
const MACHO_FFI_CODE_OFFSET: 16384

# ═══════════════════════════════════════════════════════
# Mach-O Builder
# ═══════════════════════════════════════════════════════

entity MachOBuilder:
    buf: i64;        # bvec byte buffer
    macho_arch: i64;        # 0=ARM64, 1=x86_64
    page_size: i64;
    text_code: i64;        # bvec with machine code
    data_bytes: i64;        # bvec with data section
    entry_offset: i64        # offset of _start in __text
end.

func macho_new(arch: i64):
    let page = PAGE_SIZE_ARM64
    if arch == 1 do
        page = PAGE_SIZE_X86
    end
    out MachOBuilder(buf: bvec_new(),
        macho_arch: arch,
        page_size: page,
        text_code: bvec_new(),
        data_bytes: bvec_new(),
        entry_offset: 0)
end.

# ═══════════════════════════════════════════════════════
# Write Header
# ═══════════════════════════════════════════════════════

func macho_write_header(b: MachOBuilder, ncmds: i64, sizeofcmds: i64):
    let buf = b.buf

    # MH_MAGIC_64
    buf = bvec_push_u32_le(buf, MH_MAGIC_64)

    # cputype
    if b.macho_arch == 0 do
        buf = bvec_push_u32_le(buf, CPU_TYPE_ARM64)
        buf = bvec_push_u32_le(buf, CPU_SUB_ARM64_ALL)
    else
        buf = bvec_push_u32_le(buf, CPU_TYPE_X86_64)
        buf = bvec_push_u32_le(buf, CPU_SUB_ALL)
    end

    # filetype: MH_EXECUTE
    buf = bvec_push_u32_le(buf, MH_EXECUTE)

    # ncmds, sizeofcmds
    buf = bvec_push_u32_le(buf, ncmds)
    buf = bvec_push_u32_le(buf, sizeofcmds)

    # flags: MH_NOUNDEFS | MH_DYLDLINK | MH_TWOLEVEL | MH_PIE
    let flags = MH_NOUNDEFS or MH_DYLDLINK or MH_TWOLEVEL or MH_PIE
    buf = bvec_push_u32_le(buf, flags)

    # reserved
    buf = bvec_push_u32_le(buf, 0)

    b.buf = buf
    out b
end.

func macho_write_dynamic_header(b: MachOBuilder, ncmds: i64, sizeofcmds: i64):
    let buf = b.buf
    buf = bvec_push_u32_le(buf, MH_MAGIC_64)
    if b.macho_arch == 0 do
        buf = bvec_push_u32_le(buf, CPU_TYPE_ARM64)
        buf = bvec_push_u32_le(buf, CPU_SUB_ARM64_ALL)
    else
        buf = bvec_push_u32_le(buf, CPU_TYPE_X86_64)
        buf = bvec_push_u32_le(buf, CPU_SUB_ALL)
    end
    buf = bvec_push_u32_le(buf, MH_EXECUTE)
    buf = bvec_push_u32_le(buf, ncmds)
    buf = bvec_push_u32_le(buf, sizeofcmds)
    let flags = MH_NOUNDEFS or MH_DYLDLINK or MH_TWOLEVEL or MH_PIE
    buf = bvec_push_u32_le(buf, flags)
    buf = bvec_push_u32_le(buf, 0)
    b.buf = buf
    out b
end.

# ═══════════════════════════════════════════════════════
# Write Segments & Sections
# ═══════════════════════════════════════════════════════

func macho_write_segment(b: MachOBuilder, name: i64, vmaddr: i64, vmsize: i64,
       fileoff: i64, filesize: i64, maxprot: i64, initprot: i64,
       nsects: i64):
    let buf = b.buf

    # cmd
    buf = bvec_push_u32_le(buf, LC_SEGMENT_64)

    # cmdsize: 72 + nsects * 80
    let cmdsize = 72 + nsects * 80
    buf = bvec_push_u32_le(buf, cmdsize)

    # segname (16 bytes, null-padded)
    extern func native_read_u8(addr: i64, offset: i64) -> i64
    let name_len = rt_strlen(name)
    var i = 0
    when i < 16 loop
        if i < name_len do
            buf = bvec_push(buf, native_read_u8(name, i))
        else
            buf = bvec_push(buf, 0)
        end
        i = i + 1
    end

    # vmaddr, vmsize
    buf = bvec_push_u64_le(buf, vmaddr)
    buf = bvec_push_u64_le(buf, vmsize)

    # fileoff, filesize
    buf = bvec_push_u64_le(buf, fileoff)
    buf = bvec_push_u64_le(buf, filesize)

    # maxprot, initprot
    buf = bvec_push_u32_le(buf, maxprot)
    buf = bvec_push_u32_le(buf, initprot)

    # nsects, flags
    buf = bvec_push_u32_le(buf, nsects)
    buf = bvec_push_u32_le(buf, 0)

    b.buf = buf
    out b
end.

func macho_write_section(b: MachOBuilder, sectname: i64, segname: i64,
       addr: i64, size: i64, offset: i64, align: i64,
       flags: i64):
    let buf = b.buf

    extern func native_read_u8(addr: i64, offset: i64) -> i64

    # sectname (16 bytes)
    let sname_len = rt_strlen(sectname)
    var i = 0
    when i < 16 loop
        if i < sname_len do
            buf = bvec_push(buf, native_read_u8(sectname, i))
        else
            buf = bvec_push(buf, 0)
        end
        i = i + 1
    end

    # segname (16 bytes)
    let gname_len = rt_strlen(segname)
    i = 0
    when i < 16 loop
        if i < gname_len do
            buf = bvec_push(buf, native_read_u8(segname, i))
        else
            buf = bvec_push(buf, 0)
        end
        i = i + 1
    end

    # addr, size
    buf = bvec_push_u64_le(buf, addr)
    buf = bvec_push_u64_le(buf, size)

    # offset, align
    buf = bvec_push_u32_le(buf, offset)
    buf = bvec_push_u32_le(buf, align)

    # reloff, nreloc
    buf = bvec_push_u32_le(buf, 0)
    buf = bvec_push_u32_le(buf, 0)

    # flags
    buf = bvec_push_u32_le(buf, flags)

    # reserved1, reserved2, reserved3
    buf = bvec_push_u32_le(buf, 0)
    buf = bvec_push_u32_le(buf, 0)
    buf = bvec_push_u32_le(buf, 0)

    b.buf = buf
    out b
end.

func macho_write_lc_main(b: MachOBuilder, entryoff: i64):
    let buf = b.buf

    buf = bvec_push_u32_le(buf, LC_MAIN)
    buf = bvec_push_u32_le(buf, 24);           # cmdsize
    buf = bvec_push_u64_le(buf, entryoff);      # entryoff (file offset of entry)
    buf = bvec_push_u64_le(buf, 0);             # stacksize (0 = default)

    b.buf = buf
    out b
end.

func macho_bvec_u32_le(buf: i64, at: int) -> int:
    out bvec_get(buf, at) or
        (bvec_get(buf, at + 1) shl 8) or
        (bvec_get(buf, at + 2) shl 16) or
        (bvec_get(buf, at + 3) shl 24)
end.

func macho_bvec_patch_u64_le(buf: i64, at: int, value: int):
    bvec_patch_u32_le(buf, at, value and 0xFFFFFFFF)
    bvec_patch_u32_le(buf, at + 4, (value shr 32) and 0xFFFFFFFF)
end.

func macho_bvec_push_u32_be(buf: i64, value: int) -> i64:
    buf = bvec_push(buf, (value shr 24) and 255)
    buf = bvec_push(buf, (value shr 16) and 255)
    buf = bvec_push(buf, (value shr 8) and 255)
    out bvec_push(buf, value and 255)
end.

func macho_sha256_k(i: int) -> int:
    if i == 0 do out 0x428a2f98 end
    if i == 1 do out 0x71374491 end
    if i == 2 do out 0xb5c0fbcf end
    if i == 3 do out 0xe9b5dba5 end
    if i == 4 do out 0x3956c25b end
    if i == 5 do out 0x59f111f1 end
    if i == 6 do out 0x923f82a4 end
    if i == 7 do out 0xab1c5ed5 end
    if i == 8 do out 0xd807aa98 end
    if i == 9 do out 0x12835b01 end
    if i == 10 do out 0x243185be end
    if i == 11 do out 0x550c7dc3 end
    if i == 12 do out 0x72be5d74 end
    if i == 13 do out 0x80deb1fe end
    if i == 14 do out 0x9bdc06a7 end
    if i == 15 do out 0xc19bf174 end
    if i == 16 do out 0xe49b69c1 end
    if i == 17 do out 0xefbe4786 end
    if i == 18 do out 0x0fc19dc6 end
    if i == 19 do out 0x240ca1cc end
    if i == 20 do out 0x2de92c6f end
    if i == 21 do out 0x4a7484aa end
    if i == 22 do out 0x5cb0a9dc end
    if i == 23 do out 0x76f988da end
    if i == 24 do out 0x983e5152 end
    if i == 25 do out 0xa831c66d end
    if i == 26 do out 0xb00327c8 end
    if i == 27 do out 0xbf597fc7 end
    if i == 28 do out 0xc6e00bf3 end
    if i == 29 do out 0xd5a79147 end
    if i == 30 do out 0x06ca6351 end
    if i == 31 do out 0x14292967 end
    if i == 32 do out 0x27b70a85 end
    if i == 33 do out 0x2e1b2138 end
    if i == 34 do out 0x4d2c6dfc end
    if i == 35 do out 0x53380d13 end
    if i == 36 do out 0x650a7354 end
    if i == 37 do out 0x766a0abb end
    if i == 38 do out 0x81c2c92e end
    if i == 39 do out 0x92722c85 end
    if i == 40 do out 0xa2bfe8a1 end
    if i == 41 do out 0xa81a664b end
    if i == 42 do out 0xc24b8b70 end
    if i == 43 do out 0xc76c51a3 end
    if i == 44 do out 0xd192e819 end
    if i == 45 do out 0xd6990624 end
    if i == 46 do out 0xf40e3585 end
    if i == 47 do out 0x106aa070 end
    if i == 48 do out 0x19a4c116 end
    if i == 49 do out 0x1e376c08 end
    if i == 50 do out 0x2748774c end
    if i == 51 do out 0x34b0bcb5 end
    if i == 52 do out 0x391c0cb3 end
    if i == 53 do out 0x4ed8aa4a end
    if i == 54 do out 0x5b9cca4f end
    if i == 55 do out 0x682e6ff3 end
    if i == 56 do out 0x748f82ee end
    if i == 57 do out 0x78a5636f end
    if i == 58 do out 0x84c87814 end
    if i == 59 do out 0x8cc70208 end
    if i == 60 do out 0x90befffa end
    if i == 61 do out 0xa4506ceb end
    if i == 62 do out 0xbef9a3f7 end
    out 0xc67178f2
end.

func macho_rotr32(value: int, shift: int) -> int:
    let word = value and 0xFFFFFFFF
    out ((word shr shift) or (word shl (32 - shift))) and 0xFFFFFFFF
end.

func macho_sha256_compress(state: i64, block: i64):
    var words = vec_new_rt()
    var i = 0
    when i < 64 loop
        words = vec_push_rt(words, 0)
        i = i + 1
    end
    i = 0
    when i < 16 loop
        let at = i * 4
        let word = (bvec_get(block, at) shl 24) or
            (bvec_get(block, at + 1) shl 16) or
            (bvec_get(block, at + 2) shl 8) or bvec_get(block, at + 3)
        vec_set_rt(words, i, word)
        i = i + 1
    end
    when i < 64 loop
        let w15 = vec_get_rt(words, i - 15)
        let w2 = vec_get_rt(words, i - 2)
        let s0 = macho_rotr32(w15, 7) xor macho_rotr32(w15, 18) xor (w15 shr 3)
        let s1 = macho_rotr32(w2, 17) xor macho_rotr32(w2, 19) xor (w2 shr 10)
        let next = (vec_get_rt(words, i - 16) + s0 + vec_get_rt(words, i - 7) + s1) and 0xFFFFFFFF
        vec_set_rt(words, i, next)
        i = i + 1
    end

    var a = vec_get_rt(state, 0)
    var bb = vec_get_rt(state, 1)
    var c = vec_get_rt(state, 2)
    var d = vec_get_rt(state, 3)
    var e = vec_get_rt(state, 4)
    var f = vec_get_rt(state, 5)
    var g = vec_get_rt(state, 6)
    var h = vec_get_rt(state, 7)
    i = 0
    when i < 64 loop
        let sum1 = macho_rotr32(e, 6) xor macho_rotr32(e, 11) xor macho_rotr32(e, 25)
        let choose = (e and f) xor (((0xFFFFFFFF - e) and 0xFFFFFFFF) and g)
        let temp1 = (h + sum1 + choose + macho_sha256_k(i) + vec_get_rt(words, i)) and 0xFFFFFFFF
        let sum0 = macho_rotr32(a, 2) xor macho_rotr32(a, 13) xor macho_rotr32(a, 22)
        let majority = (a and bb) xor (a and c) xor (bb and c)
        let temp2 = (sum0 + majority) and 0xFFFFFFFF
        h = g
        g = f
        f = e
        e = (d + temp1) and 0xFFFFFFFF
        d = c
        c = bb
        bb = a
        a = (temp1 + temp2) and 0xFFFFFFFF
        i = i + 1
    end
    vec_set_rt(state, 0, (vec_get_rt(state, 0) + a) and 0xFFFFFFFF)
    vec_set_rt(state, 1, (vec_get_rt(state, 1) + bb) and 0xFFFFFFFF)
    vec_set_rt(state, 2, (vec_get_rt(state, 2) + c) and 0xFFFFFFFF)
    vec_set_rt(state, 3, (vec_get_rt(state, 3) + d) and 0xFFFFFFFF)
    vec_set_rt(state, 4, (vec_get_rt(state, 4) + e) and 0xFFFFFFFF)
    vec_set_rt(state, 5, (vec_get_rt(state, 5) + f) and 0xFFFFFFFF)
    vec_set_rt(state, 6, (vec_get_rt(state, 6) + g) and 0xFFFFFFFF)
    vec_set_rt(state, 7, (vec_get_rt(state, 7) + h) and 0xFFFFFFFF)
end.

func macho_sha256_range(buf: i64, start: int, count: int) -> i64:
    var state = vec_new_rt()
    state = vec_push_rt(state, 0x6a09e667)
    state = vec_push_rt(state, 0xbb67ae85)
    state = vec_push_rt(state, 0x3c6ef372)
    state = vec_push_rt(state, 0xa54ff53a)
    state = vec_push_rt(state, 0x510e527f)
    state = vec_push_rt(state, 0x9b05688c)
    state = vec_push_rt(state, 0x1f83d9ab)
    state = vec_push_rt(state, 0x5be0cd19)

    var padded = bvec_new()
    var i = 0
    when i < count loop
        padded = bvec_push(padded, bvec_get(buf, start + i))
        i = i + 1
    end
    padded = bvec_push(padded, 0x80)
    when (bvec_len(padded) mod 64) != 56 loop
        padded = bvec_push(padded, 0)
    end
    let bit_count = count * 8
    padded = macho_bvec_push_u32_be(padded, 0)
    padded = macho_bvec_push_u32_be(padded, bit_count)

    var off = 0
    when off < bvec_len(padded) loop
        var block = bvec_new()
        i = 0
        when i < 64 loop
            block = bvec_push(block, bvec_get(padded, off + i))
            i = i + 1
        end
        macho_sha256_compress(state, block)
        off = off + 64
    end

    var digest = bvec_new()
    i = 0
    when i < 8 loop
        digest = macho_bvec_push_u32_be(digest, vec_get_rt(state, i))
        i = i + 1
    end
    out digest
end.

func macho_emit_adhoc_signature(b: MachOBuilder) -> MachOBuilder:
    # Load-command area is deliberately followed by at least 32 bytes of
    # zero padding in both static and dynamic layouts, so one 16-byte command
    # can be installed without moving __text or invalidating branch fixups.
    let old_ncmds = macho_bvec_u32_le(b.buf, 16)
    let old_sizeofcmds = macho_bvec_u32_le(b.buf, 20)
    let command_at = 32 + old_sizeofcmds

    var command = 32
    var linkedit_command = 0
    var ci = 0
    when ci < old_ncmds loop
        let kind = macho_bvec_u32_le(b.buf, command)
        let size = macho_bvec_u32_le(b.buf, command + 4)
        if kind == LC_SEGMENT_64 do
            # __LINKEDIT is the final segment command in both writer paths.
            linkedit_command = command
        end
        command = command + size
        ci = ci + 1
    end

    let signature_at = ((bvec_len(b.buf) + 15) / 16) * 16
    let identifier = fat_str_new("virc-adhoc")
    let identifier_bytes = fat_str_len(identifier) + 1
    let fixed_bytes = 48
    let hash_offset = fixed_bytes + identifier_bytes
    let code_slots = (signature_at + PAGE_SIZE_ARM64 - 1) / PAGE_SIZE_ARM64
    let code_directory_bytes = hash_offset + code_slots * CS_HASH_SIZE_SHA256
    let signature_bytes = 20 + code_directory_bytes

    bvec_patch_u32_le(b.buf, 16, old_ncmds + 1)
    bvec_patch_u32_le(b.buf, 20, old_sizeofcmds + 16)
    bvec_patch_u32_le(b.buf, command_at, LC_CODE_SIGNATURE)
    bvec_patch_u32_le(b.buf, command_at + 4, 16)
    bvec_patch_u32_le(b.buf, command_at + 8, signature_at)
    bvec_patch_u32_le(b.buf, command_at + 12, signature_bytes)

    if linkedit_command > 0 do
        let linkedit_fileoff = macho_bvec_u32_le(b.buf, linkedit_command + 40)
        let linkedit_filesize = signature_at + signature_bytes - linkedit_fileoff
        let linkedit_vmsize = ((linkedit_filesize + b.page_size - 1) / b.page_size) * b.page_size
        macho_bvec_patch_u64_le(b.buf, linkedit_command + 32, linkedit_vmsize)
        macho_bvec_patch_u64_le(b.buf, linkedit_command + 48, linkedit_filesize)
    end

    when bvec_len(b.buf) < signature_at loop
        b.buf = bvec_push(b.buf, 0)
    end

    # SuperBlob header with one CSSLOT_CODEDIRECTORY entry.
    b.buf = macho_bvec_push_u32_be(b.buf, CSMAGIC_EMBEDDED_SIGNATURE)
    b.buf = macho_bvec_push_u32_be(b.buf, signature_bytes)
    b.buf = macho_bvec_push_u32_be(b.buf, 1)
    b.buf = macho_bvec_push_u32_be(b.buf, 0)
    b.buf = macho_bvec_push_u32_be(b.buf, 20)

    b.buf = macho_bvec_push_u32_be(b.buf, CSMAGIC_CODEDIRECTORY)
    b.buf = macho_bvec_push_u32_be(b.buf, code_directory_bytes)
    b.buf = macho_bvec_push_u32_be(b.buf, 0x00020100)
    b.buf = macho_bvec_push_u32_be(b.buf, CS_ADHOC)
    b.buf = macho_bvec_push_u32_be(b.buf, hash_offset)
    b.buf = macho_bvec_push_u32_be(b.buf, fixed_bytes)
    b.buf = macho_bvec_push_u32_be(b.buf, 0)
    b.buf = macho_bvec_push_u32_be(b.buf, code_slots)
    b.buf = macho_bvec_push_u32_be(b.buf, signature_at)
    b.buf = bvec_push(b.buf, CS_HASH_SIZE_SHA256)
    b.buf = bvec_push(b.buf, CS_HASHTYPE_SHA256)
    b.buf = bvec_push(b.buf, 0)
    b.buf = bvec_push(b.buf, CS_PAGE_SHIFT_ARM64)
    b.buf = macho_bvec_push_u32_be(b.buf, 0)
    b.buf = macho_bvec_push_u32_be(b.buf, 0)

    var ident_i = 0
    when ident_i < fat_str_len(identifier) loop
        b.buf = bvec_push(b.buf, fat_str_byte_at(identifier, ident_i))
        ident_i = ident_i + 1
    end
    b.buf = bvec_push(b.buf, 0)

    var slot = 0
    when slot < code_slots loop
        let page_start = slot * PAGE_SIZE_ARM64
        var page_bytes = PAGE_SIZE_ARM64
        if page_start + page_bytes > signature_at do
            page_bytes = signature_at - page_start
        end
        let digest = macho_sha256_range(b.buf, page_start, page_bytes)
        var di = 0
        when di < CS_HASH_SIZE_SHA256 loop
            b.buf = bvec_push(b.buf, bvec_get(digest, di))
            di = di + 1
        end
        slot = slot + 1
    end
    out b
end.

func macho_push_uleb(v: i64, value: i64):
    var n = value
    when n >= 128 loop
        v = bvec_push(v, (n mod 128) or 0x80)
        n = n / 128
    end
    out bvec_push(v, n)
end.

func macho_ffi_library_for_source(source: string):
    if ffi_source_is_os(source) == 1 do out fat_str_new("/usr/lib/libSystem.B.dylib") end
    out source
end.

func macho_ffi_library_index(libs: i64, library: string):
    var i = 0
    when i < vec_len_rt(libs) loop
        if fat_str_eq(vec_get_rt(libs, i) as string, library) == 1 do out i end
        i = i + 1
    end
    out 0 - 1
end.

func macho_write_section_indirect(b: MachOBuilder, sectname: i64, segname: i64,
       addr: i64, size: i64, offset: i64, align: i64,
       flags: i64, indirect_start: i64, stub_size: i64):
    b = macho_write_section(b, sectname, segname, addr, size, offset, align, flags)
    let section_end = bvec_len(b.buf)
    bvec_patch_u32_le(b.buf, section_end - 12, indirect_start)
    bvec_patch_u32_le(b.buf, section_end - 8, stub_size)
    out b
end.

func macho_write_dylib_fat(b: MachOBuilder, path: string):
    let plen = fat_str_len(path)
    let cmdsize = 24 + ((plen + 1 + 7) / 8) * 8
    b.buf = bvec_push_u32_le(b.buf, LC_LOAD_DYLIB)
    b.buf = bvec_push_u32_le(b.buf, cmdsize)
    b.buf = bvec_push_u32_le(b.buf, 24)
    b.buf = bvec_push_u32_le(b.buf, 0)
    b.buf = bvec_push_u32_le(b.buf, 0x00010000)
    b.buf = bvec_push_u32_le(b.buf, 0x00010000)
    var i = 0
    when i < cmdsize - 24 loop
        if i < plen do
            b.buf = bvec_push(b.buf, fat_str_byte_at(path, i))
        else
            b.buf = bvec_push(b.buf, 0)
        end
        i = i + 1
    end
    out b
end.

func macho_emit_ffi(b: MachOBuilder, entry_off_param: i64):
    let nimp = ffi_import_used_count()
    if nimp <= 0 do out b end
    if b.macho_arch != 0 do out b end

    var libs = vec_new_rt()
    var ii = 0
    when ii < nimp loop
        import_id = ffi_import_used_at(ii)
        lib = macho_ffi_library_for_source(ffi_import_source(import_id))
        if macho_ffi_library_index(libs, lib) < 0 do libs = vec_push_rt(libs, lib) end
        ii = ii + 1
    end
    let nlibs = vec_len_rt(libs)

    var bind = bvec_new()
    ii = 0
    when ii < nimp loop
        import_id = ffi_import_used_at(ii)
        name = ffi_import_name(import_id)
        lib = macho_ffi_library_for_source(ffi_import_source(import_id))
        ord = macho_ffi_library_index(libs, lib) + 1
        bind = bvec_push(bind, 0x10 or ord)
        bind = bvec_push(bind, 0x40)
        bind = bvec_push(bind, 95)
        var ni = 0
        when ni < fat_str_len(name) loop
            bind = bvec_push(bind, fat_str_byte_at(name, ni))
            ni = ni + 1
        end
        bind = bvec_push(bind, 0)
        bind = bvec_push(bind, 0x51)
        bind = bvec_push(bind, 0x72)
        bind = macho_push_uleb(bind, ii * 8)
        bind = bvec_push(bind, 0x90)
        ii = ii + 1
    end
    bind = bvec_push(bind, 0)
    let bind_size = bvec_len(bind)

    var str_size = 1
    ii = 0
    when ii < nimp loop
        str_size = str_size + 2 + fat_str_len(ffi_import_name(ffi_import_used_at(ii)))
        ii = ii + 1
    end

    var dylib_cmd_bytes = 0
    ii = 0
    when ii < nlibs loop
        dylib_cmd_bytes = dylib_cmd_bytes + 24 + ((fat_str_len(vec_get_rt(libs, ii) as string) + 1 + 7) / 8) * 8
        ii = ii + 1
    end
    let ncmds = 10 + nlibs
    let sizeofcmds = 840 + dylib_cmd_bytes
    let code_offset = MACHO_FFI_CODE_OFFSET
    let code_size = bvec_len(b.text_code)
    let stub_start = ffi_arm64_stub_offset(ffi_import_used_at(0))
    let stubs_size = nimp * 12
    let entry_file_offset = code_offset + entry_off_param
    let text_raw = code_offset + code_size
    let text_size = ((text_raw + b.page_size - 1) / b.page_size) * b.page_size
    let data_fileoff = text_size
    let data_size = b.page_size
    let linkedit_fileoff = data_fileoff + data_size
    let symoff = linkedit_fileoff + bind_size
    let indirectoff = symoff + nimp * 16
    let stroff = indirectoff + nimp * 4
    let linkedit_size = bind_size + nimp * 16 + nimp * 4 + str_size
    let linkedit_vmsize = ((linkedit_size + b.page_size - 1) / b.page_size) * b.page_size
    let text_vm = TEXT_BASE
    let data_vm = TEXT_BASE + data_fileoff
    let linkedit_vm = TEXT_BASE + linkedit_fileoff

    ii = 0
    when ii < nimp loop
        import_id = ffi_import_used_at(ii)
        stub = ffi_arm64_stub_offset(import_id)
        pc = TEXT_BASE + code_offset + stub
        target = data_vm + ii * 8
        delta_pages = ((target and (0 - 4096)) - (pc and (0 - 4096))) / 4096
        page_imm = delta_pages and 0x1FFFFF
        adrp = 0x90000010 or ((page_imm and 3) shl 29) or (((page_imm shr 2) and 0x7FFFF) shl 5)
        ldr = 0xF9400210 or (((target and 0xFFF) / 8) shl 10)
        bvec_patch_u32_le(b.text_code, stub, adrp)
        bvec_patch_u32_le(b.text_code, stub + 4, ldr)
        ii = ii + 1
    end

    b = macho_write_dynamic_header(b, ncmds, sizeofcmds)
    b = macho_write_segment(b, "__PAGEZERO", 0, TEXT_BASE, 0, 0, 0, 0, 0)
    b = macho_write_segment(b, "__TEXT", text_vm, text_size, 0, text_size,
                            VM_PROT_READ or VM_PROT_EXECUTE, VM_PROT_READ or VM_PROT_EXECUTE, 3)
    b = macho_write_section(b, "__text", "__TEXT", text_vm + code_offset, stub_start, code_offset, 2,
                            S_ATTR_PURE_INSTRUCTIONS or S_ATTR_SOME_INSTRUCTIONS)
    b = macho_write_section_indirect(b, "__stubs", "__TEXT", text_vm + code_offset + stub_start,
                            stubs_size, code_offset + stub_start, 2, S_SYMBOL_STUBS or S_ATTR_PURE_INSTRUCTIONS,
                            0, 12)
    let tail_off = stub_start + stubs_size
    let tail_size = code_size - tail_off
    b = macho_write_section(b, "__const", "__TEXT", text_vm + code_offset + tail_off,
                            tail_size, code_offset + tail_off, 2, S_REGULAR)
    b = macho_write_segment(b, "__DATA", data_vm, data_size, data_fileoff, data_size,
                            VM_PROT_READ or VM_PROT_WRITE, VM_PROT_READ or VM_PROT_WRITE, 1)
    b = macho_write_section_indirect(b, "__la_symbol_ptr", "__DATA", data_vm, nimp * 8,
                            data_fileoff, 3, S_NON_LAZY_SYMBOL_POINTERS, 0, 0)
    b = macho_write_segment(b, "__LINKEDIT", linkedit_vm, linkedit_vmsize,
                            linkedit_fileoff, linkedit_size, VM_PROT_READ, VM_PROT_READ, 0)

    b.buf = bvec_push_u32_le(b.buf, LC_DYLD_INFO_ONLY)
    b.buf = bvec_push_u32_le(b.buf, 48)
    b.buf = bvec_push_u32_le(b.buf, 0); b.buf = bvec_push_u32_le(b.buf, 0)
    b.buf = bvec_push_u32_le(b.buf, linkedit_fileoff); b.buf = bvec_push_u32_le(b.buf, bind_size)
    var zi = 0
    when zi < 6 loop b.buf = bvec_push_u32_le(b.buf, 0); zi = zi + 1 end
    b.buf = bvec_push_u32_le(b.buf, LC_SYMTAB); b.buf = bvec_push_u32_le(b.buf, 24)
    b.buf = bvec_push_u32_le(b.buf, symoff); b.buf = bvec_push_u32_le(b.buf, nimp)
    b.buf = bvec_push_u32_le(b.buf, stroff); b.buf = bvec_push_u32_le(b.buf, str_size)
    b.buf = bvec_push_u32_le(b.buf, LC_DYSYMTAB); b.buf = bvec_push_u32_le(b.buf, 80)
    b.buf = bvec_push_u32_le(b.buf, 0); b.buf = bvec_push_u32_le(b.buf, 0)
    b.buf = bvec_push_u32_le(b.buf, 0); b.buf = bvec_push_u32_le(b.buf, 0)
    b.buf = bvec_push_u32_le(b.buf, 0); b.buf = bvec_push_u32_le(b.buf, nimp)
    zi = 0
    when zi < 6 loop b.buf = bvec_push_u32_le(b.buf, 0); zi = zi + 1 end
    b.buf = bvec_push_u32_le(b.buf, indirectoff); b.buf = bvec_push_u32_le(b.buf, nimp)
    b.buf = bvec_push_u32_le(b.buf, 0); b.buf = bvec_push_u32_le(b.buf, 0)
    b.buf = bvec_push_u32_le(b.buf, 0); b.buf = bvec_push_u32_le(b.buf, 0)
    b.buf = bvec_push_u32_le(b.buf, LC_LOAD_DYLINKER); b.buf = bvec_push_u32_le(b.buf, 32)
    b.buf = bvec_push_u32_le(b.buf, 12)
    let dyld_path = "/usr/lib/dyld"
    zi = 0
    when zi < 20 loop
        if zi < 13 do b.buf = bvec_push(b.buf, native_read_u8(dyld_path, zi)) else b.buf = bvec_push(b.buf, 0) end
        zi = zi + 1
    end
    b.buf = bvec_push_u32_le(b.buf, LC_UUID); b.buf = bvec_push_u32_le(b.buf, 24)
    zi = 1
    when zi <= 16 loop b.buf = bvec_push(b.buf, zi); zi = zi + 1 end
    b = macho_write_lc_main(b, entry_file_offset)
    ii = 0
    when ii < nlibs loop b = macho_write_dylib_fat(b, vec_get_rt(libs, ii) as string); ii = ii + 1 end

    var cur = bvec_len(b.buf)
    when cur < code_offset loop b.buf = bvec_push(b.buf, 0); cur = cur + 1 end
    ii = 0
    when ii < code_size loop b.buf = bvec_push(b.buf, bvec_get(b.text_code, ii)); ii = ii + 1 end
    cur = bvec_len(b.buf)
    when cur < data_fileoff loop b.buf = bvec_push(b.buf, 0); cur = cur + 1 end
    ii = 0
    when ii < nimp loop b.buf = bvec_push_u64_le(b.buf, 0); ii = ii + 1 end
    cur = bvec_len(b.buf)
    when cur < linkedit_fileoff loop b.buf = bvec_push(b.buf, 0); cur = cur + 1 end
    ii = 0
    when ii < bind_size loop b.buf = bvec_push(b.buf, bvec_get(bind, ii)); ii = ii + 1 end
    var strx = 1
    ii = 0
    when ii < nimp loop
        b.buf = bvec_push_u32_le(b.buf, strx); b.buf = bvec_push(b.buf, 1)
        b.buf = bvec_push(b.buf, 0); b.buf = bvec_push_u16_le(b.buf, 0); b.buf = bvec_push_u64_le(b.buf, 0)
        strx = strx + 2 + fat_str_len(ffi_import_name(ffi_import_used_at(ii)))
        ii = ii + 1
    end
    ii = 0
    when ii < nimp loop b.buf = bvec_push_u32_le(b.buf, ii); ii = ii + 1 end
    b.buf = bvec_push(b.buf, 0)
    ii = 0
    when ii < nimp loop
        name = ffi_import_name(ffi_import_used_at(ii))
        b.buf = bvec_push(b.buf, 95)
        var ni = 0
        when ni < fat_str_len(name) loop b.buf = bvec_push(b.buf, fat_str_byte_at(name, ni)); ni = ni + 1 end
        b.buf = bvec_push(b.buf, 0)
        ii = ii + 1
    end
    out b
end.

func macho_emit(b: MachOBuilder, entry_off_param: i64):
    if ffi_import_used_count() > 0 and b.macho_arch == 0 do
        out macho_emit_ffi(b, entry_off_param)
    end
    let page = b.page_size
    let code_size = bvec_len(b.text_code)

    let ncmds = 10
    let sizeofcmds = 552
    let header_end = 32 + sizeofcmds

    let code_offset = header_end + 32
    let entry_file_offset = code_offset + entry_off_param

    let text_raw_size = code_offset + code_size
    let text_segment_size = ((text_raw_size + page - 1) / page) * page

    let chained_fixups_size = 48
    let string_table_size = 4
    let linkedit_data_size = chained_fixups_size + string_table_size
    let linkedit_fileoff = text_segment_size
    let linkedit_vmaddr = TEXT_BASE + text_segment_size
    let strtab_off = linkedit_fileoff + chained_fixups_size

    b = macho_write_header(b, ncmds, sizeofcmds)
    b = macho_write_segment(b, "__PAGEZERO", 0, TEXT_BASE, 0, 0, 0, 0, 0)
    b = macho_write_segment(b, "__TEXT",
                            TEXT_BASE, text_segment_size,
                            0, text_segment_size,
                            VM_PROT_READ or VM_PROT_WRITE or VM_PROT_EXECUTE,
                            VM_PROT_READ or VM_PROT_EXECUTE,
                            1)
    b = macho_write_section(b, "__text", "__TEXT",
                            TEXT_BASE + code_offset, code_size, code_offset,
                            2,
                            S_ATTR_PURE_INSTRUCTIONS or S_ATTR_SOME_INSTRUCTIONS)
    b = macho_write_segment(b, "__LINKEDIT",
                            linkedit_vmaddr, page,
                            linkedit_fileoff, linkedit_data_size,
                            VM_PROT_READ,
                            VM_PROT_READ,
                            0)

    b.buf = bvec_push_u32_le(b.buf, LC_DYLD_CHAINED_FIXUPS)
    b.buf = bvec_push_u32_le(b.buf, 16)
    b.buf = bvec_push_u32_le(b.buf, linkedit_fileoff)
    b.buf = bvec_push_u32_le(b.buf, chained_fixups_size)

    b.buf = bvec_push_u32_le(b.buf, LC_SYMTAB)
    b.buf = bvec_push_u32_le(b.buf, 24)
    b.buf = bvec_push_u32_le(b.buf, strtab_off)
    b.buf = bvec_push_u32_le(b.buf, 0)
    b.buf = bvec_push_u32_le(b.buf, strtab_off)
    b.buf = bvec_push_u32_le(b.buf, string_table_size)

    b.buf = bvec_push_u32_le(b.buf, LC_DYSYMTAB)
    b.buf = bvec_push_u32_le(b.buf, 80)
    var dsi = 0
    when dsi < 18 loop
        b.buf = bvec_push_u32_le(b.buf, 0)
        dsi = dsi + 1
    end

    b.buf = bvec_push_u32_le(b.buf, LC_LOAD_DYLINKER)
    b.buf = bvec_push_u32_le(b.buf, 32)
    b.buf = bvec_push_u32_le(b.buf, 12)
    extern func native_read_u8(addr: i64, offset: i64) -> i64
    let dyld_path = "/usr/lib/dyld"
    let dyld_len = 13
    var di = 0
    when di < 20 loop
        if di < dyld_len do
            b.buf = bvec_push(b.buf, native_read_u8(dyld_path as i64, di))
        else
            b.buf = bvec_push(b.buf, 0)
        end
        di = di + 1
    end

    b.buf = bvec_push_u32_le(b.buf, LC_UUID)
    b.buf = bvec_push_u32_le(b.buf, 24)
    var ui = 1
    when ui <= 16 loop
        b.buf = bvec_push(b.buf, ui)
        ui = ui + 1
    end

    b = macho_write_lc_main(b, entry_file_offset)

    b.buf = bvec_push_u32_le(b.buf, LC_LOAD_DYLIB)
    b.buf = bvec_push_u32_le(b.buf, 56)
    b.buf = bvec_push_u32_le(b.buf, 24)
    b.buf = bvec_push_u32_le(b.buf, 0)
    b.buf = bvec_push_u32_le(b.buf, 0x00010000)
    b.buf = bvec_push_u32_le(b.buf, 0x00010000)
    let dylib_path = "/usr/lib/libSystem.B.dylib"
    let dylib_len = 26
    var dli = 0
    when dli < 32 loop
        if dli < dylib_len do
            b.buf = bvec_push(b.buf, native_read_u8(dylib_path as i64, dli))
        else
            b.buf = bvec_push(b.buf, 0)
        end
        dli = dli + 1
    end

    var current = bvec_len(b.buf)
    when current < code_offset loop
        b.buf = bvec_push(b.buf, 0)
        current = current + 1
    end

    var i = 0
    when i < code_size loop
        b.buf = bvec_push(b.buf, bvec_get(b.text_code, i))
        i = i + 1
    end

    current = bvec_len(b.buf)
    when current < text_segment_size loop
        b.buf = bvec_push(b.buf, 0)
        current = current + 1
    end

    let link_buf = b.buf
    link_buf = bvec_push_u32_le(link_buf, 0)
    link_buf = bvec_push_u32_le(link_buf, 28)
    link_buf = bvec_push_u32_le(link_buf, 44)
    link_buf = bvec_push_u32_le(link_buf, 44)
    link_buf = bvec_push_u32_le(link_buf, 0)
    link_buf = bvec_push_u32_le(link_buf, 1)
    link_buf = bvec_push_u32_le(link_buf, 0)

    link_buf = bvec_push_u32_le(link_buf, 3)
    link_buf = bvec_push_u32_le(link_buf, 0)
    link_buf = bvec_push_u32_le(link_buf, 0)
    link_buf = bvec_push_u32_le(link_buf, 0)

    link_buf = bvec_push_u32_le(link_buf, 0)
    link_buf = bvec_push_u32_le(link_buf, 0)
    b.buf = link_buf

    out b
end.

func macho_write_to_file(b: MachOBuilder, path: i64):
    let eo = b.entry_offset
    b = macho_emit(b, eo)
    b = macho_emit_adhoc_signature(b)
    let data = bvec_data_ptr(b.buf)
    let size = bvec_len(b.buf)
    write_file_bytes(path, data, size, 493)
    out true
end.

# @vir_source stdlib/vir/compiler/virc.vri 44
import MachOBuilder, macho_new, macho_write_to_file from vir.compiler.macho
# @vir_source stdlib/vir/rt/elf.vri 1
##
 * vir/rt/elf.vri — ELF Executable Emitter (Pure Vir)
 * ====================================================
 * Emits a complete ELF 64-bit executable for Linux ARM64
 * and x86-64. No external assembler or linker needed.
 *
 * Produces a statically-linked, no-libc binary that the
 * kernel can exec directly via _start + raw syscalls.
 *
 * Layout: ELF Header → Program Headers → .text → .data
 ##

module vir.rt.elf

import bvec_new, bvec_push, bvec_push_u16_le, bvec_push_u32_le,
       bvec_push_u64_le, bvec_len, bvec_get, bvec_data_ptr, bvec_free from vec_rt
import write_file_bytes from io

# ═══════════════════════════════════════════════════════
# ELF Constants
# ═══════════════════════════════════════════════════════

# ELF identification
const ELFMAG0:      0x7F
const ELFMAG1:      0x45;      # 'E'
const ELFMAG2:      0x4C;      # 'L'
const ELFMAG3:      0x46;      # 'F'
const ELFCLASS64:   2
const ELFDATA2LSB:  1;         # Little-endian
const EV_CURRENT:   1
const ELFOSABI_NONE: 0

# ELF type
const ET_EXEC:      2

# Machine types
const EM_X86_64:    62
const EM_AARCH64:   183
const EM_RISCV:     243

# Program header types
const PT_LOAD:      1
const PT_NOTE:      4

# Flags
const PF_R:         4
const PF_W:         2
const PF_X:         1

# Section header types
const SHT_NULL:     0
const SHT_PROGBITS: 1
const SHT_STRTAB:   3

const SHF_ALLOC:    2
const SHF_EXECINSTR: 4
const SHF_WRITE:    1

# Standard addresses
const ELF_BASE:     0x400000
const ELF_PAGE_X86:    0x1000;    # 4KB pages for x86_64
const ELF_PAGE_ARM64:  0x10000;   # 64KB pages for ARM64 and RISCV64 Linux
const ELF_PAGE:        0x1000;    # default 4KB

# The native self-host ABI does not reliably preserve aggregate fields across
# the long writer call chain.  Keep the selected container architecture in a
# writer-local scalar as well; one compiler invocation emits one artifact.
var g_elf_arch: int = 0
var g_elf_page_size: int = ELF_PAGE_ARM64

# Header sizes
const ELF_HEADER_SIZE: 64
const PHDR_SIZE:    56
const SHDR_SIZE:    64

# ═══════════════════════════════════════════════════════
# ELF Builder
# ═══════════════════════════════════════════════════════

entity ElfBuilder:
    buf:            int;        # bvec byte buffer
    arch:           int;        # 0=ARM64, 1=x86_64, 3=RISCV64
    page_size:      int,
    text_code:      int;        # bvec with machine code
    data_bytes:     int;        # bvec with data section
    entry_offset:   int        # offset of _start in .text
end.
func elf_new(arch: int):

    var ps = ELF_PAGE_ARM64
    if arch == 1 do
        ps = ELF_PAGE_X86
    end
    g_elf_arch = arch
    g_elf_page_size = ps
    out ElfBuilder (
        buf: bvec_new(),
        arch: arch,
        page_size: ps,
        text_code: bvec_new(),
        data_bytes: bvec_new(),
        entry_offset: 0
    )
end.
# ═══════════════════════════════════════════════════════
# Write ELF Header (64 bytes)
# ═══════════════════════════════════════════════════════

func elf_write_header:
    in  b: ElfBuilder
        entry: int
        phoff: int
        shoff: int
        phnum: int
        shnum: int
        shstrndx: int
    let buf = b.buf

    # e_ident (16 bytes)
    buf = bvec_push(buf, ELFMAG0)
    buf = bvec_push(buf, ELFMAG1)
    buf = bvec_push(buf, ELFMAG2)
    buf = bvec_push(buf, ELFMAG3)
    buf = bvec_push(buf, ELFCLASS64)
    buf = bvec_push(buf, ELFDATA2LSB)
    buf = bvec_push(buf, EV_CURRENT)
    buf = bvec_push(buf, ELFOSABI_NONE)
    # 8 bytes padding
    let i = 0
    when i < 8 loop
        buf = bvec_push(buf, 0)
        i = i + 1
    end

    # e_type
    buf = bvec_push_u16_le(buf, ET_EXEC)

    # e_machine
    if g_elf_arch == 0 do
        buf = bvec_push_u16_le(buf, EM_AARCH64)
    eif g_elf_arch == 3 do
        buf = bvec_push_u16_le(buf, EM_RISCV)
    else
        buf = bvec_push_u16_le(buf, EM_X86_64)
    end

    # e_version
    buf = bvec_push_u32_le(buf, EV_CURRENT)

    # e_entry
    buf = bvec_push_u64_le(buf, entry)

    # e_phoff
    buf = bvec_push_u64_le(buf, phoff)

    # e_shoff
    buf = bvec_push_u64_le(buf, shoff)

    # e_flags
    buf = bvec_push_u32_le(buf, 0)

    # e_ehsize
    buf = bvec_push_u16_le(buf, ELF_HEADER_SIZE)

    # e_phentsize
    buf = bvec_push_u16_le(buf, PHDR_SIZE)

    # e_phnum
    buf = bvec_push_u16_le(buf, phnum)

    # e_shentsize
    buf = bvec_push_u16_le(buf, SHDR_SIZE)

    # e_shnum
    buf = bvec_push_u16_le(buf, shnum)

    # e_shstrndx
    buf = bvec_push_u16_le(buf, shstrndx)

    b.buf = buf
    out b
end.
# ═══════════════════════════════════════════════════════
# Write Program Header (56 bytes)
# ═══════════════════════════════════════════════════════

func elf_write_phdr:
    in  b: ElfBuilder
        p_type: int
        p_flags: int
        p_offset: int
        p_vaddr: int
        p_paddr: int
        p_filesz: int
        p_memsz: int
        p_align: int
    let buf = b.buf

    buf = bvec_push_u32_le(buf, p_type)
    buf = bvec_push_u32_le(buf, p_flags)
    buf = bvec_push_u64_le(buf, p_offset)
    buf = bvec_push_u64_le(buf, p_vaddr)
    buf = bvec_push_u64_le(buf, p_paddr)
    buf = bvec_push_u64_le(buf, p_filesz)
    buf = bvec_push_u64_le(buf, p_memsz)
    buf = bvec_push_u64_le(buf, p_align)

    b.buf = buf
    out b
end.
# ═══════════════════════════════════════════════════════
# Write Section Header (64 bytes)
# ═══════════════════════════════════════════════════════

func elf_write_shdr:
    in  b: ElfBuilder
        sh_name: int
        sh_type: int
        sh_flags: int
        sh_addr: int
        sh_offset: int
        sh_size: int
        sh_link: int
        sh_info: int
        sh_addralign: int
        sh_entsize: int
    let buf = b.buf

    buf = bvec_push_u32_le(buf, sh_name)
    buf = bvec_push_u32_le(buf, sh_type)
    buf = bvec_push_u64_le(buf, sh_flags)
    buf = bvec_push_u64_le(buf, sh_addr)
    buf = bvec_push_u64_le(buf, sh_offset)
    buf = bvec_push_u64_le(buf, sh_size)
    buf = bvec_push_u32_le(buf, sh_link)
    buf = bvec_push_u32_le(buf, sh_info)
    buf = bvec_push_u64_le(buf, sh_addralign)
    buf = bvec_push_u64_le(buf, sh_entsize)

    b.buf = buf
    out b
end.
# ═══════════════════════════════════════════════════════
# Emit Complete ELF Executable
# ═══════════════════════════════════════════════════════

func elf_emit(b: ElfBuilder):


    let code_size = bvec_len(b.text_code)
    let data_size = bvec_len(b.data_bytes)
    var page = g_elf_page_size
    if page <= 0 do
        page = ELF_PAGE
    end

    let has_data = 0
    if data_size > 0 do
        has_data = 1
    end

    # Program headers: PT_LOAD for .text, PT_LOAD for .data (if any)
    let phnum = 1 + has_data

    # Section headers: NULL + .text + .data (opt) + .shstrtab
    let shnum = 2 + has_data + 1
    let shstrndx = 1 + has_data + 1;    # last section = .shstrtab

    # Layout calculation
    let headers_size = ELF_HEADER_SIZE + phnum * PHDR_SIZE

    # Text starts at next page
    let text_offset = page
    let text_vaddr = ELF_BASE + text_offset

    # Align text size to page
    let text_pad_size = ((code_size + page - 1) / page) * page

    # Data follows text
    let data_offset = text_offset + text_pad_size
    let data_vaddr = ELF_BASE + data_offset
    let data_pad_size = 0
    if has_data == 1 do
        data_pad_size = ((data_size + page - 1) / page) * page
    end

    # Section headers at end
    let shoff = data_offset + data_pad_size

    # Shstrtab content:  \0 .text \0 .data \0 .shstrtab \0
    let strtab_offset = shoff + shnum * SHDR_SIZE

    # Entry point
    let entry = text_vaddr + b.entry_offset

    # ── ELF Header ──
    b = elf_write_header(b, entry, ELF_HEADER_SIZE, shoff, phnum, shnum, shstrndx)

    # ── Program Headers ──

    # PT_LOAD: .text (RX)
    b = elf_write_phdr(b, PT_LOAD, PF_R or PF_X,
                       text_offset, text_vaddr, text_vaddr,
                       code_size, code_size, page)

    # PT_LOAD: .data (RW)
    if has_data == 1 do
        b = elf_write_phdr(b, PT_LOAD, PF_R or PF_W,
                           data_offset, data_vaddr, data_vaddr,
                           data_size, data_size, page)
    end

    # ── Pad to text_offset ──
    let current = bvec_len(b.buf)
    when current < text_offset loop
        b.buf = bvec_push(b.buf, 0)
        current = current + 1
    end

    # ── Write .text ──
    let i = 0
    when i < code_size loop
        b.buf = bvec_push(b.buf, bvec_get(b.text_code, i))
        i = i + 1
    end

    # ── Pad to page ──
    current = bvec_len(b.buf)
    let text_end = text_offset + text_pad_size
    when current < text_end loop
        b.buf = bvec_push(b.buf, 0)
        current = current + 1
    end

    # ── Write .data ──
    if has_data == 1 do
        i = 0
        when i < data_size loop
            b.buf = bvec_push(b.buf, bvec_get(b.data_bytes, i))
            i = i + 1
        end

        current = bvec_len(b.buf)
        let data_end = data_offset + data_pad_size
        when current < data_end loop
            b.buf = bvec_push(b.buf, 0)
            current = current + 1
        end
    end

    # ── Section Headers ──

    # SHT_NULL (index 0)
    b = elf_write_shdr(b, 0, SHT_NULL, 0, 0, 0, 0, 0, 0, 0, 0)

    # .text (index 1) — name offset 1 in shstrtab
    b = elf_write_shdr(b, 1, SHT_PROGBITS,
                       SHF_ALLOC or SHF_EXECINSTR,
                       text_vaddr, text_offset, code_size,
                       0, 0, 16, 0)

    # .data (index 2, if present) — name offset 7 in shstrtab
    if has_data == 1 do
        b = elf_write_shdr(b, 7, SHT_PROGBITS,
                           SHF_ALLOC or SHF_WRITE,
                           data_vaddr, data_offset, data_size,
                           0, 0, 8, 0)
    end

    # .shstrtab (last section)
    let shstrtab_name_off = 7
    if has_data == 1 do
        shstrtab_name_off = 13
    end
    # Build shstrtab: \0.text\0.data\0.shstrtab\0
    let strtab_start = bvec_len(b.buf)
    let strtab_size = 0
    if has_data == 1 do
        # \0 .text\0 .data\0 .shstrtab\0
        strtab_size = 23
    else
        # \0 .text\0 .shstrtab\0
        strtab_size = 17
    end

    b = elf_write_shdr(b, shstrtab_name_off, SHT_STRTAB,
                       0, 0, strtab_start + SHDR_SIZE, strtab_size,
                       0, 0, 1, 0)

    # ── Write .shstrtab content ──
    # \0
    b.buf = bvec_push(b.buf, 0)

    # .text
    b.buf = bvec_push(b.buf, 0x2E);   # '.'
    b.buf = bvec_push(b.buf, 0x74);   # 't'
    b.buf = bvec_push(b.buf, 0x65);   # 'e'
    b.buf = bvec_push(b.buf, 0x78);   # 'x'
    b.buf = bvec_push(b.buf, 0x74);   # 't'
    b.buf = bvec_push(b.buf, 0)

    if has_data == 1 do
        # .data
        b.buf = bvec_push(b.buf, 0x2E);   # '.'
        b.buf = bvec_push(b.buf, 0x64);   # 'd'
        b.buf = bvec_push(b.buf, 0x61);   # 'a'
        b.buf = bvec_push(b.buf, 0x74);   # 't'
        b.buf = bvec_push(b.buf, 0x61);   # 'a'
        b.buf = bvec_push(b.buf, 0)
    end

    # .shstrtab
    b.buf = bvec_push(b.buf, 0x2E);   # '.'
    b.buf = bvec_push(b.buf, 0x73);   # 's'
    b.buf = bvec_push(b.buf, 0x68);   # 'h'
    b.buf = bvec_push(b.buf, 0x73);   # 's'
    b.buf = bvec_push(b.buf, 0x74);   # 't'
    b.buf = bvec_push(b.buf, 0x72);   # 'r'
    b.buf = bvec_push(b.buf, 0x74);   # 't'
    b.buf = bvec_push(b.buf, 0x61);   # 'a'
    b.buf = bvec_push(b.buf, 0x62);   # 'b'
    b.buf = bvec_push(b.buf, 0)

    out b
end.
# ═══════════════════════════════════════════════════════
# Write to disk
# ═══════════════════════════════════════════════════════

func elf_write_to_file(b: ElfBuilder, path: int):

    b = elf_emit(b)
    let data = bvec_data_ptr(b.buf)
    let size = bvec_len(b.buf)
    write_file_bytes(path, data, size, 0o755)
    out true
end.

# @vir_source stdlib/vir/compiler/virc.vri 46
import ElfBuilder, elf_new, elf_write_to_file from vir.rt.elf

# ── Compiler modules (self-hosting, pure Vir) ──
# @vir_source stdlib/vir/compiler/lexer.vri 1

 # vir/compiler/lexer.vri — Vir Source Lexer (Pure Vir)
 # =====================================================
 # Converted from C (core/src/lexer.c) for self-hosting.
 #
 # Features
 #   - Full v1.2 keyword set (English standard)
 #   - Multi-char operators (?=, ?., :~, >>, ||, ->, ..)
 #   - Block comments: #*# ... #*# (preferred) and ## ... ## (legacy)
 #   - Hex literal support (0x...)
 #   - Paren-depth tracking (brackets / grouping; NEWLINE still emitted for §1.0)
 #   - String escape sequences (\n, \t, \\, \", \')

# @vir_source stdlib/vir/compiler/result_prelude.vri 1
##
 * Soft-bootstrap prelude for `include result;`
 * Full result.vri uses case/panic; soft parse/lower not ready.
 ##

# @vir_source stdlib/vir/compiler/option_prelude.vri 1
##
 * Soft-bootstrap prelude for `include option;`
 * Full option.vri uses case/panic; soft parse/lower not ready.
 * Tag values: Some=0, None=1 would mismatch is_some; use Some=1, None=0.
 ##

enum Option:
    None
    Some
end.

# @vir_source stdlib/vir/compiler/result_prelude.vri 7

enum Result:
    Ok
    Err
end.

func is_ok(r: Result):
    out r == Result.Ok
end.

func is_err(r: Result):
    out r == Result.Err
end.

# @vir_source stdlib/vir/compiler/lexer.vri 16
import Result, Ok, Err from result
import fat_str_new, fat_str_concat, fat_str_len, fat_str_byte_at, fat_str_eq, fat_str_eq_span, fat_str_slice,
    fat_str_sentinel_pad, fat_char_to_str, rt_streq, str_from_cstr, sb_new, sb_append_char, sb_to_string, sb_len,
    StringBuilder, native_read_u8, native_write_u8, native_read_i64, native_write_i64, rt_memcpy from vir.rt.string_rt
import alloc, vir_alloc, vir_free from alloc
# @vir_source stdlib/vir/compiler/vec_prelude.vri 1
##
 * Soft-bootstrap prelude for `include vec;` (collections Vec).
 * Provides a minimal in-process Vec using vir_alloc.
 ##


entity Vec:
    data: int
    len: int
    cap: int
end.

func vec_new:
    v = Vec ( data: 0, len: 0, cap: 0 )
    out v
end.

func vec_reserve:
    in  v: Vec
        additional: int

    if (v as i64) == 0 do
        out
    end
    let v_len = native_read_i64(v as i64, 8)
    let v_cap = native_read_i64(v as i64, 16)
    let new_cap = v_len + additional
    if new_cap <= v_cap do
        out
    end
    var target = v_cap * 2
    if target < new_cap do
        target = new_cap
    end
    if target < 16 do
        target = 16
    end
    let new_bytes = target * 8
    let old_data = native_read_i64(v as i64, 0)
    let new_data = vir_alloc(new_bytes)
    if old_data != 0 and v_len > 0 do
        var ci = 0
        when ci < v_len loop
            let word = native_read_i64(old_data, ci * 8)
            let _w = native_write_i64(new_data, ci * 8, word)
            ci = ci + 1
        end
    end
    let _s0 = native_write_i64(v as i64, 0, new_data)
    let _s16 = native_write_i64(v as i64, 16, target)
end.

func vec_push:
    in  v: Vec
        item: int

    if (v as i64) == 0 do
        out v
    end
    vec_reserve(v, 1)
    let v_data = native_read_i64(v as i64, 0)
    let v_len = native_read_i64(v as i64, 8)
    let _w = native_write_i64(v_data, v_len * 8, item)
    let _wl = native_write_i64(v as i64, 8, v_len + 1)
    out v
end.

func vec_len:
    in  v: Vec
    if (v as i64) == 0 do
        out 0
    end
    out native_read_i64(v as i64, 8)
end.

func vec_get:
    in  v: Vec
        i: int
    if (v as i64) == 0 do
        out 0
    end
    let v_len = native_read_i64(v as i64, 8)
    if i < 0 or i >= v_len do
        out 0
    end
    let v_data = native_read_i64(v as i64, 0)
    out native_read_i64(v_data, i * 8)
end.

func vec_set:
    in  v: Vec
        i: int
        val: int
    if (v as i64) != 0 do
        let v_len = native_read_i64(v as i64, 8)
        if i >= 0 and i < v_len do
            let v_data = native_read_i64(v as i64, 0)
            let _w = native_write_i64(v_data, i * 8, val)
        end
    end
    out v
end.

# @vir_source stdlib/vir/compiler/lexer.vri 24
import Vec, vec_new, vec_push, vec_len, vec_get, vec_reserve from vec

# ═══════════════════════════════════════════════════════
# Token Types (v1.2 Standard)
# ═══════════════════════════════════════════════════════

enum TokType:
    # Literals
    Eof         = 0
    Error       = 1
    Int         = 2
    Float       = 3
    Str         = 4
    Ident       = 5
    Newline     = 6

    # Definitions
    Func        = 10
    Var         = 11
    Const       = 12
    Entity      = 13
    Enum        = 14
    Method      = 15
    Class       = 16
    Has         = 17
    Share       = 18
    Async       = 19
    Task        = 20
    Wait        = 21
    TypeKw      = 22

    # Control flow
    If          = 30
    Else        = 31
    Eif         = 32
    Loop        = 33
    While       = 34
    When        = 35
    For         = 36
    Break       = 37
    Skip        = 38
    Out         = 39
    Case        = 40
    End         = 41
    In          = 42

    # Arithmetic operators
    Plus        = 50
    Minus       = 51
    Star        = 52
    Slash       = 53
    Percent     = 54
    Power       = 55
    Mod         = 56

    # Comparison operators
    Eq          = 60
    Ne          = 61
    Gt          = 62
    Lt          = 63
    Ge          = 64
    Le          = 65
    SafeEq      = 66
    SafeNe      = 67

    # Logical operators
    And         = 70
    Or          = 71
    Not         = 72

    # Bitwise operators
    BitXor      = 75
    BitShl      = 76
    BitShr      = 77
    BitAnd      = 78
    BitOr       = 79
    BitNot      = 80

    # Access / transform
    SafeAccess  = 85
    Exist       = 86
    Cast        = 87
    Pattern     = 88

    # Assignment
    Assign      = 90

    # Delimiters
    LParen      = 100
    RParen      = 101
    LBracket    = 102
    RBracket    = 103
    LBrace      = 104
    RBrace      = 105
    Comma       = 106
    Dot         = 107
    DotDot      = 108
    Colon       = 109
    DoubleColon = 112
    Semicolon   = 110
    Arrow       = 111

    # I/O
    Print       = 120
    Input       = 121
    CheckCpu    = 122
    Patch       = 123

    # Module
    Import      = 130
    From        = 131
    Module      = 132
    Export      = 133
    As          = 134
    Include     = 135
    Get         = 136

    # Boolean / None
    True        = 140
    False       = 141
    NoneLit     = 142

    # Error handling
    Try         = 150
    ErrorKw     = 151
    MapKw       = 152
    Extern      = 153
    EnsureKw    = 154
    PackedKw    = 155
    RefKw       = 156
    RegisterKw  = 157
    RevertKw    = 158
    ThisKw      = 159
    InterpStart = 160
    InterpEnd   = 161
    ThrowKw     = 162
    AtSign      = 163
    Do          = 164
    Let         = 165
    Del         = 166;   # reserved keyword token

    # §26.2 AI / advanced operators, §24.4 atomics, compound assign
    MatMul      = 180;   # **
    Fma         = 181;   # ><
    Lock        = 182;   # lock keyword
    AtomicBang  = 183;   # !!
    PlusAssign  = 184;   # +=
    MinusAssign = 185;   # -=
    StarAssign  = 186;   # *=
    SlashAssign = 187;   # /=
    ModAssign   = 170;   # %=
    BitAndAssign = 171;  # &=
    BitOrAssign = 172;   # |=
    BitXorAssign = 173;  # ^=
    BitShlAssign = 174;  #  shl =
    BitShrAssign = 175;  # >>=
    Swizzle     = 188;   # ~ (postfix swizzle)
    SendArrow   = 189;   # <-
    LogicalOr   = 190;   # ||
    LogicalAnd  = 187;   # &&

    # P0 Keywords & Annotations
    BindKw      = 191;   # @bind
    EntryKw     = 192;   # @entry
    AtomicKw    = 193;   # atomic
    IsolateKw   = 194;   # isolate
    ResumeKw    = 195;   # resume
    RetryKw     = 196;   # retry
    EmitKw      = 197;   # emit
    ErxKw       = 198;   # erx
    PrecompKw   = 199;   # precomp
    PortKw      = 200;   # port
    SendKw      = 201;   # send
    RecvKw      = 202;   # recv
    SelectKw    = 203;   # select

    # P1 Keywords & Subsystem Tokens
    BorrowMut   = 204;   # &mut
    LazyKw      = 205;   # lazy
    TensorKw    = 206;   # tensor
    InferKw     = 207;   # infer
    TrainKw     = 208;   # train
    QuantizeKw  = 209;   # quantize
    FluxKw      = 210;   # flux
    DeckKw      = 211;   # deck
    MoldKw      = 212;   # mold
    ReactiveKw  = 213;   # reactive
    MorphKw     = 214;   # morph
    BundleKw    = 215;   # bundle
    ExposeKw    = 216;   # expose

    # P2 VPS Pattern Delimiters
    VpsGroupOpen  = 217; # :(
    VpsGroupClose = 218; # :)

    # Runtime keywords (spec §22 / §4.6) — distinct from Wait.Task
    AwaitKw       = 219
    CancelKw      = 220
    QuietKw       = 221
    ArenaKw       = 222
    PassKw        = 223;  # await pass
    TimeoutKw     = 224
    DictKw        = 225
    ArrCompactKw  = 226
    PtrKw         = 227;  # ptr type keyword (§29 FFI)
    MutKw         = 228;  # mut (after & or standalone binder)
    Then          = 229;  # then — block opener (alias of Do)
    EmbedKw       = 230;  # embed (bundle asset macro §25.3)
    InterfaceKw   = 231,  # interface declaration (signature-only methods)
    SizeofKw      = 232   # sizeof(Type) operator (Spec §4.4 / §7.3)
end.
# ═══════════════════════════════════════════════════════
# Token
# ═══════════════════════════════════════════════════════

entity Token:
    tok_type:   TokType,
    line:       int,
    col:        int,
    start:      int,
    len:        int,
    str_val:    string,
    int_val:    int,
    float_val:  float
end.
# Shared empty string — avoid allocating "" per token (P1).
var g_tok_empty_str = 0
func tok_empty_str:
    if g_tok_empty_str == 0 do
        g_tok_empty_str = fat_str_new("")
    end
    out g_tok_empty_str
end.

func token_new:
    in  t: TokType
        line: int
        col: int

    out Token (
        tok_type: t,
        line: line,
        col: col,
        start: 0,
        len: 0,
        str_val: tok_empty_str(),
        int_val: 0,
        float_val: 0.0
    )
end.
# ═══════════════════════════════════════════════════════
# Keyword Lookup Table
# ═══════════════════════════════════════════════════════

entity KeywordEntry:
    word:   string,
        tok:    TokType
end.
