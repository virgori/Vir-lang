    pass2_register_builtin_one(symbols, scopes, fat_str_new("volatile_read8"), 1)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("volatile_write8"), 2)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("volatile_read16"), 1)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("volatile_write16"), 2)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("volatile_read32"), 1)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("volatile_write32"), 2)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("volatile_read64"), 1)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("volatile_write64"), 2)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("dmb"), 0)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("dsb"), 0)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("isb"), 0)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("wfi"), 0)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("wfe"), 0)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("sev"), 0)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("nop"), 0)
    # Atomic primitives
    pass2_register_builtin_one(symbols, scopes, fat_str_new("atomic_load"), 1)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("atomic_store"), 2)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("atomic_add"), 2)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("atomic_sub"), 2)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("atomic_cas"), 3)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("atomic_exchange"), 2)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("atomic_swap"), 2)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("atomic_load32"), 1)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("atomic_store32"), 2)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("atomic_add32"), 2)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("atomic_sub32"), 2)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("atomic_cas32"), 3)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("atomic_exchange32"), 2)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("atomic_swap32"), 2)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("atomic_load64"), 1)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("atomic_store64"), 2)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("atomic_add64"), 2)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("atomic_sub64"), 2)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("atomic_cas64"), 3)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("atomic_exchange64"), 2)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("atomic_fence"), 0)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("atomic_swap64"), 2)
    # syscallN helpers
    pass2_register_builtin_one(symbols, scopes, fat_str_new("syscall0"), 1)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("syscall1"), 2)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("syscall2"), 3)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("syscall3"), 4)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("syscall4"), 5)
