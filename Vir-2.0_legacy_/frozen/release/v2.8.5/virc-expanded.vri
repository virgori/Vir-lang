# @vir_source stdlib/vir/compiler/target.vri 7
import TargetArch from compiler.codegen

var g_codegen_target: int = 2   # TargetArch.ARM64

func set_codegen_target(arch: int):
    g_codegen_target = arch
end.

func get_codegen_target():
    out g_codegen_target
end.

export set_codegen_target, get_codegen_target, TargetArch
func color_to_phys(color: i64, is_leaf: i64):
    let t = get_codegen_target()
    if t == 1 or t == TargetArch.X86_64 do
        if color == 0 do out 3 end    # RBX
        if color == 1 do out 12 end   # R12
        if color == 2 do out 13 end   # R13
        if color == 3 do out 14 end   # R14
        out 3
    end
    if t == 3 or t == TargetArch.RISCV64 do
        out 18 + color # s2..s10
    end
    out 19 + color
end.

export set_codegen_target, get_codegen_target, TargetArch, color_to_phys

# @vir_source stdlib/vir/compiler/lir_target_desc.vri 16
import get_codegen_target, TargetArch from compiler.target

entity TargetDesc:
    arch: i64;
    k_colors_leaf: i64;
    k_colors_nonleaf: i64;
    palette_leaf: i64;
    palette_nonleaf: i64;
    caller_clobbers: i64;
    callee_saved: i64;
    reserved_regs: i64
end.

# ── Target Descriptor Query Helpers ──

func target_desc_get_arch():
    out get_codegen_target()
end.

# Returns K (number of allocatable registers)
func target_desc_k(is_leaf: i64):
    let arch = get_codegen_target()
    if arch == 1 or arch == TargetArch.X86_64 do
        out 4 # RBX, R12, R13, R14
    end
    out 9 # ARM64: X19..X27
end.

# Maps a color index (0..K-1) to the target physical register.
func target_desc_color_to_phys(color: i64, is_leaf: i64):
    let arch = get_codegen_target()
    if arch == 1 or arch == TargetArch.X86_64 do
        if color == 0 do out 3 end    # RBX
        if color == 1 do out 12 end   # R12
        if color == 2 do out 13 end   # R13
        if color == 3 do out 14 end   # R14
        out 3
    end
    if arch == 3 or arch == TargetArch.RISCV64 do
        out 18 + color # s2..s10
    end
    # ARM64: X19..X27
    out 19 + color
end.

# Checks whether a physical register is callee-saved (preserved across calls).
func target_desc_is_callee_saved(phys_reg: i64):
    let arch = get_codegen_target()
    if arch == 1 or arch == TargetArch.X86_64 do
        if phys_reg == 3 or phys_reg == 12 or phys_reg == 13 or phys_reg == 14 do
            out 1
        end
        out 0
    end
    if arch == 3 or arch == TargetArch.RISCV64 do
        # RV64 psABI: s0-s1 (x8-x9), s2-s11 (x18-x27).
        if phys_reg == 8 or phys_reg == 9 or (phys_reg >= 18 and phys_reg <= 27) do out 1 end
        out 0
    end
    # ARM64: X19..X28 are callee-saved
    if phys_reg >= 19 and phys_reg <= 28 do
        out 1
    end
    out 0
end.

# Checks whether a physical register is caller-saved (clobbered by calls).
func target_desc_is_call_clobbered(phys_reg: i64):
    let arch = get_codegen_target()
    if arch == 1 or arch == TargetArch.X86_64 do
        # RAX(0), RCX(1), RDX(2), RSI(4), RDI(5), R8..R11(8..11)
        if phys_reg == 0 or phys_reg == 1 or phys_reg == 2 or phys_reg == 4 or phys_reg == 5 or (phys_reg >= 8 and phys_reg <= 11) do
            out 1
        end
        out 0
    end
    if arch == 3 or arch == TargetArch.RISCV64 do
        # ra, temporaries, argument registers, and t3-t6.
        if phys_reg == 1 or (phys_reg >= 5 and phys_reg <= 7) or (phys_reg >= 10 and phys_reg <= 17) or (phys_reg >= 28 and phys_reg <= 31) do out 1 end
        out 0
    end
    # ARM64: X0..X15 are caller-saved
    if phys_reg >= 0 and phys_reg <= 15 do
        out 1
    end
    out 0
end.

# Checks whether a physical register is target-reserved and forbidden for virtual allocation.
func target_desc_is_reserved(phys_reg: i64):
    let arch = get_codegen_target()
    if arch == 1 or arch == TargetArch.X86_64 do
        # RSP(4), RBP(5), R15(15)
        if phys_reg == 4 or phys_reg == 5 or phys_reg == 15 do
            out 1
        end
        out 0
    end
    if arch == 3 or arch == TargetArch.RISCV64 do
        # Architectural zero plus the fixed ABI/control registers used by the
        # emitter.  Allocatable colors map only to s2-s10 (x18-x26).
        if phys_reg == 0 or phys_reg == 1 or phys_reg == 2 or phys_reg == 3 or phys_reg == 4 or phys_reg == 8 do out 1 end
        out 0
    end
    # ARM64: X16, X17 (scratch/stubs), X18 (platform), X28 (arena), X29 (FP), X30 (LR), X31 (SP)
    if phys_reg == 16 or phys_reg == 17 or phys_reg == 18 or phys_reg == 28 or phys_reg == 29 or phys_reg == 30 or phys_reg == 31 do
        out 1
    end
    out 0
end.

export target_desc_get_arch, target_desc_k, target_desc_color_to_phys
export target_desc_is_callee_saved, target_desc_is_call_clobbered, target_desc_is_reserved

# @vir_source stdlib/vir/compiler/virc.vri 65
# @vir_source stdlib/vir/compiler/lir_ra_arena.vri 1
##
 * vir/compiler/lir_ra_arena.vri — RA Scratch Block-Arena Allocator
 * ================================================================
 * Supplies aligned bump allocation for ephemeral register allocation
 * data structures (CFG liveness sets, worklists, adjacency chunks).
 *
 * Scoped ownership contract:
 * - Lifetimes bounded by single RA function invocation or checkpoint.
 * - Supports rewind to checkpoint and whole-arena reset per function.
 * - Zero escaping pointers to returned LirFunc or compiler diagnostics.
 ##

module vir.compiler.lir_ra_arena

import vec_new_rt, vec_push_rt, vec_get_rt, vec_set_rt, vec_len_rt from vec_rt
import native_read_i64, native_write_i64 from string_rt

const RA_BLOCK_SIZE: i64 = 65536   # 64 KiB initial block size

# RaBlock header layout (32 bytes):
# 0:  data_ptr (i64)
# 8:  offset (i64)
# 16: capacity (i64)
# 24: next_block (i64)

# RaArena header layout (32 bytes):
# 0:  head_block (i64)
# 8:  cur_block (i64)
# 16: block_count (i64)
# 24: total_bytes (i64)

func ra_block_new(cap_bytes: i64):
    let blk = alloc(32)
    let buf = alloc(cap_bytes)
    native_write_i64(blk, 0, buf)
    native_write_i64(blk, 8, 0)
    native_write_i64(blk, 16, cap_bytes)
    native_write_i64(blk, 24, 0)
    out blk
end.

func ra_arena_new():
    let arena = alloc(32)
    let first_blk = ra_block_new(RA_BLOCK_SIZE)
    native_write_i64(arena, 0, first_blk)
    native_write_i64(arena, 8, first_blk)
    native_write_i64(arena, 16, 1)
    native_write_i64(arena, 24, 0)
    out arena
end.

# Allocates bytes aligned to 16 bytes.
func ra_arena_alloc(arena: i64, size: i64):
    if arena == 0 do
        out alloc(size)
    end
    # Align to 16 bytes
    let aligned = (size + 15) and (0 - 16)
    var cur = native_read_i64(arena, 8)
    if cur == 0 do
        cur = ra_block_new(RA_BLOCK_SIZE)
        native_write_i64(arena, 0, cur)
        native_write_i64(arena, 8, cur)
    end
    let off = native_read_i64(cur, 8)
    let cap = native_read_i64(cur, 16)
    if off + aligned <= cap do
        let ptr = native_read_i64(cur, 0) + off
        native_write_i64(cur, 8, off + aligned)
        let tot = native_read_i64(arena, 24)
        native_write_i64(arena, 24, tot + aligned)
        out ptr
    end

    # Need a new block
    var next_cap = RA_BLOCK_SIZE
    if aligned > next_cap do
        next_cap = aligned + 128
    end
    let new_blk = ra_block_new(next_cap)
    native_write_i64(cur, 24, new_blk)
    native_write_i64(arena, 8, new_blk)
    let cnt = native_read_i64(arena, 16)
    native_write_i64(arena, 16, cnt + 1)

    let ptr = native_read_i64(new_blk, 0)
    native_write_i64(new_blk, 8, aligned)
    let tot = native_read_i64(arena, 24)
    native_write_i64(arena, 24, tot + aligned)
    out ptr
end.

# Checkpoint: pack current block pointer and current offset
func ra_arena_checkpoint(arena: i64):
    if arena == 0 do out 0 end
    let cur = native_read_i64(arena, 8)
    if cur == 0 do out 0 end
    let off = native_read_i64(cur, 8)
    out cur + off
end.

# Reset whole arena back to initial state (reusing allocated blocks)
func ra_arena_reset(arena: i64):
    if arena == 0 do out 0 end
    var b = native_read_i64(arena, 0)
    when b != 0 loop
        native_write_i64(b, 8, 0)
        b = native_read_i64(b, 24)
    end
    let head = native_read_i64(arena, 0)
    native_write_i64(arena, 8, head)
    native_write_i64(arena, 24, 0)
    out 0
end.

export ra_arena_new, ra_arena_alloc, ra_arena_checkpoint, ra_arena_reset

# @vir_source stdlib/vir/compiler/virc.vri 66
# @vir_source stdlib/vir/compiler/lir_liveness.vri 1
##
 * vir/compiler/lir_liveness.vri — CFG Fixed-Point Liveness Analysis
 * ================================================================
 * Computes backward dataflow fixed-point liveness across CFG blocks:
 *   live_out[B] = union(live_in[S] for S in succ[B])
 *   live_in[B]  = use[B] union (live_out[B] - def[B])
 *
 * Walks instructions backward to compute exact Def-vs-Live-Out ranges
 * and identify virtual registers that cross Call/Intrinsic boundaries.
 *
 * Implements the contract specified in REGISTER_ALLOCATION_STRICT_SPEC.md.
 ##

module vir.compiler.lir_liveness

import vec_new_rt, vec_push_rt, vec_get_rt, vec_set_rt, vec_len_rt from vec_rt
import native_read_i64, native_write_i64 from string_rt

# @vir_source stdlib/vir/compiler/lir_liveness.vri 22
import LirOperandType, LirOperand, LirInstr, LirBlock, LirFunc, LirOp from compiler.lir

func live_interval_new(vreg: i64, start_pos: i64, end_pos: i64):
    p = alloc(32)
    native_write_i64(p, 0, vreg)
    native_write_i64(p, 8, start_pos)
    native_write_i64(p, 16, end_pos)
    native_write_i64(p, 24, 0) # crosses_call
    out p
end.

entity LiveInterval:
    vreg: i64,
    start_pos: i64,
    end_pos: i64,
    crosses_call: i64
end.

func lir_opnd_is_vreg(o: LirOperand):
    if (o as i64) == 0 do out false end
    if (o as i64) < 4096 do out false end
    typ = native_read_i64(o as i64, 0)
    out typ == 1 or typ == 2
end.

func lir_opnd_vreg_id(o: LirOperand):
    out native_read_i64(o as i64, 8)
end.

func lir_instr_dst(ins: LirInstr):
    out native_read_i64(ins as i64, 16)
end.

func lir_instr_src1(ins: LirInstr):
    out native_read_i64(ins as i64, 24)
end.

func lir_instr_src2(ins: LirInstr):
    out native_read_i64(ins as i64, 32)
end.

func lir_block_instrs(b: LirBlock):
    out native_read_i64(b as i64, 8)
end.

func lir_func_blocks(f: LirFunc):
    out native_read_i64(f as i64, 16)
end.

func live_start(iv: LiveInterval):
    out native_read_i64(iv as i64, 8)
end.

func live_end(iv: LiveInterval):
    out native_read_i64(iv as i64, 16)
end.

func live_crosses_call(iv: LiveInterval):
    out native_read_i64(iv as i64, 24)
end.

func touch_interval(intervals: i64, v: i64, pos: i64):
    if v < 0 or v >= vec_len_rt(intervals) do out 0 end
    iv = vec_get_rt(intervals, v)
    st = native_read_i64(iv as i64, 8)
    if st == 0 - 1 do
        st = pos
    end
    vec_set_rt(intervals, v, live_interval_new(v, st, pos))
    out 0
end.

func max_vreg_lir(func_obj: LirFunc):
    max_v = 0
    blocks = native_read_i64(func_obj as i64, 16)
    n_blocks = vec_len_rt(blocks)
    i = 0
    when i < n_blocks loop
        b = vec_get_rt(blocks, i)
        instrs = native_read_i64(b as i64, 8)
        n_instrs = vec_len_rt(instrs)
        j = 0
        when j < n_instrs loop
            ins = vec_get_rt(instrs, j)
            d = lir_instr_dst(ins)
            s1 = lir_instr_src1(ins)
            s2 = lir_instr_src2(ins)
            if lir_opnd_is_vreg(d) do
                if lir_opnd_vreg_id(d) > max_v do max_v = lir_opnd_vreg_id(d) end
            end
            if lir_opnd_is_vreg(s1) do
                if lir_opnd_vreg_id(s1) > max_v do max_v = lir_opnd_vreg_id(s1) end
            end
            if lir_opnd_is_vreg(s2) do
                if lir_opnd_vreg_id(s2) > max_v do max_v = lir_opnd_vreg_id(s2) end
            end
            j = j + 1
        end
        i = i + 1
    end
    out max_v
end.

# ── Bitset Utilities ──

func bitset_new(n_words: i64):
    bs = vec_new_rt()
    var i = 0
    when i < n_words loop
        bs = vec_push_rt(bs, 0)
        i = i + 1
    end
    out bs
end.

func bitset_clone(src: i64, n_words: i64):
    dst = vec_new_rt()
    var i = 0
    when i < n_words loop
        dst = vec_push_rt(dst, vec_get_rt(src, i))
        i = i + 1
    end
    out dst
end.

func bitset_get(bs: i64, bit: i64):
    w = bit / 64
    b = bit and 63
    val = vec_get_rt(bs, w)
    out (val shr b) and 1
end.

func bitset_set(bs: i64, bit: i64):
    w = bit / 64
    b = bit and 63
    old_val = vec_get_rt(bs, w)
    vec_set_rt(bs, w, old_val or (1 shl b))
    out 0
end.

func bitset_clear(bs: i64, bit: i64):
    w = bit / 64
    b = bit and 63
    mask = 0 - 1 - (1 shl b)
    old_val = vec_get_rt(bs, w)
    vec_set_rt(bs, w, old_val and mask)
    out 0
end.

func bitset_union(dst: i64, src: i64, n_words: i64):
    var i = 0
    when i < n_words loop
        vec_set_rt(dst, i, vec_get_rt(dst, i) or vec_get_rt(src, i))
        i = i + 1
    end
    out 0
end.

func bitset_diff(dst: i64, sub: i64, n_words: i64):
    var i = 0
    when i < n_words loop
        mask = 0 - 1 - vec_get_rt(sub, i)
        vec_set_rt(dst, i, vec_get_rt(dst, i) and mask)
        i = i + 1
    end
    out 0
end.

func bitset_equals(bs1: i64, bs2: i64, n_words: i64):
    var i = 0
    when i < n_words loop
        if vec_get_rt(bs1, i) != vec_get_rt(bs2, i) do out 0 end
        i = i + 1
    end
    out 1
end.

# ── Exact Loop Back-Edge Liveness & Call Crossing Analysis ──

func lir_compute_liveness(func_obj: LirFunc):
    let max_v = max_vreg_lir(func_obj)
    let n_nodes = max_v + 1

    intervals = vec_new_rt()
    var i = 0
    when i < n_nodes loop
        intervals = vec_push_rt(intervals, live_interval_new(i, 0 - 1, 0 - 1))
        i = i + 1
    end

    let blocks = native_read_i64(func_obj as i64, 16)
    let n_blocks = vec_len_rt(blocks)
    if n_blocks == 0 do out intervals end

    block_starts = vec_new_rt()
    i = 0
    when i < n_blocks loop
        block_starts = vec_push_rt(block_starts, 0)
        i = i + 1
    end

    calls = vec_new_rt()

    var pos = 0
    var b_idx = 0
    when b_idx < n_blocks loop
        vec_set_rt(block_starts, b_idx, pos)
        let b = vec_get_rt(blocks, b_idx)
        let instrs = native_read_i64(b as i64, 8)
        let n_instrs = vec_len_rt(instrs)
        var i_idx = 0
        when i_idx < n_instrs loop
            let ins = vec_get_rt(instrs, i_idx)
            let s1 = lir_instr_src1(ins)
            let s2 = lir_instr_src2(ins)
            let d = lir_instr_dst(ins)
            if lir_opnd_is_vreg(s1) do
                touch_interval(intervals, lir_opnd_vreg_id(s1), pos)
            end
            if lir_opnd_is_vreg(s2) do
                touch_interval(intervals, lir_opnd_vreg_id(s2), pos)
            end
            if lir_opnd_is_vreg(d) do
                touch_interval(intervals, lir_opnd_vreg_id(d), pos)
            end

            let op = native_read_i64(ins as i64, 0)
            if op == 8 or op == 17 do # Call or Intrinsic
                calls = vec_push_rt(calls, pos)
            end

            # Check for backward branch (loop back-edge)
            if op == 9 or op == 10 do # Jmp or JmpCond
                var tgt_opnd = s1
                if op == 10 do tgt_opnd = s2 end
                if (tgt_opnd as i64) != 0 do
                    let typ = native_read_i64(tgt_opnd as i64, 0)
                    var tgt_id = 0 - 1
                    if typ == 6 do tgt_id = native_read_i64(tgt_opnd as i64, 40)
                    eif typ == 5 do tgt_id = native_read_i64(tgt_opnd as i64, 32) end
                    if tgt_id >= 0 and tgt_id < n_blocks and tgt_id <= b_idx do
                        let loop_start = vec_get_rt(block_starts, tgt_id)
                        var vi = 0
                        when vi < n_nodes loop
                            let iv = vec_get_rt(intervals, vi)
                            let st = native_read_i64(iv as i64, 8)
                            let en = native_read_i64(iv as i64, 16)
                            if st != 0 - 1 and st <= loop_start and en >= loop_start do
                                if pos > en do
                                    vec_set_rt(intervals, vi, live_interval_new(vi, st, pos))
                                end
                            end
                            vi = vi + 1
                        end
                    end
                end
            end

            pos = pos + 1
            i_idx = i_idx + 1
        end
        b_idx = b_idx + 1
    end

    # Mark call crossings: any variable live across a Call/Intrinsic
    let n_calls = vec_len_rt(calls)
    if n_calls > 0 do
        var ci = 0
        when ci < n_calls loop
            let c_pos = vec_get_rt(calls, ci)
            var vi = 0
            when vi < n_nodes loop
                let iv = vec_get_rt(intervals, vi)
                let st = native_read_i64(iv as i64, 8)
                let en = native_read_i64(iv as i64, 16)
                if st != 0 - 1 and st < c_pos and en > c_pos do
                    native_write_i64(iv as i64, 24, 1) # crosses_call = 1
                end
                vi = vi + 1
            end
            ci = ci + 1
        end
    end

    out intervals
end.

export LiveInterval, lir_compute_liveness
export lir_opnd_is_vreg, lir_opnd_vreg_id, lir_instr_dst, lir_instr_src1, lir_instr_src2
export lir_block_instrs, lir_func_blocks, live_start, live_end, live_crosses_call

# @vir_source stdlib/vir/compiler/virc.vri 67
# @vir_source stdlib/vir/compiler/lir_interference.vri 1
##
 * vir/compiler/lir_interference.vri — Interference Graph
 * ==============================================================
 * Builds an interference graph with Dual Representation:
 * 1. Compact Bit-Matrix for strictly O(1) edge queries (get_edge)
 * 2. Adjacency Lists for O(degree) neighbor traversal
 *
 * Supports both Def-vs-Live-Out CFG graph construction and Sweep Line.
 * Implements the contract in REGISTER_ALLOCATION_STRICT_SPEC.md.
 ##

module vir.compiler.lir_interference

import vec_new_rt, vec_push_rt, vec_get_rt, vec_set_rt, vec_len_rt from vec_rt

# @vir_source stdlib/vir/compiler/lir_interference.vri 18
import LiveInterval, lir_opnd_is_vreg, lir_opnd_vreg_id, lir_instr_dst, lir_instr_src1, lir_instr_src2 from compiler.lir_liveness
import LirOperand, LirInstr, LirBlock, LirFunc, LirOp from compiler.lir
import native_read_i64, native_write_i64 from string_rt

func ig_new(num_nodes: i64, matrix: i64, degrees: i64, adj_lists: i64):
    p = alloc(32)
    native_write_i64(p, 0, num_nodes)
    native_write_i64(p, 8, matrix)
    native_write_i64(p, 16, degrees)
    native_write_i64(p, 24, adj_lists)
    out p
end.

entity InterferenceGraph:
    num_nodes: i64,
    matrix: [i64],
    degrees: [i64]
end.

func live_start_of(iv: LiveInterval):
    out native_read_i64(iv as i64, 8)
end.
func live_end_of(iv: LiveInterval):
    out native_read_i64(iv as i64, 16)
end.

func intervals_overlap(i1: LiveInterval, i2: LiveInterval):
    s1 = native_read_i64(i1 as i64, 8)
    if s1 == 0 - 1 do out false end
    s2 = native_read_i64(i2 as i64, 8)
    if s2 == 0 - 1 do out false end
    e1 = native_read_i64(i1 as i64, 16)
    e2 = native_read_i64(i2 as i64, 16)
    out s1 <= e2 & s2 <= e1
end.

func ig_num_nodes(ig: InterferenceGraph):
    out native_read_i64(ig as i64, 0)
end.
func ig_matrix(ig: InterferenceGraph):
    out native_read_i64(ig as i64, 8)
end.
func ig_degrees(ig: InterferenceGraph):
    out native_read_i64(ig as i64, 16)
end.
func ig_adj_lists(ig: InterferenceGraph):
    out native_read_i64(ig as i64, 24)
end.

func ig_add_edge(n_nodes: i64, words_per_row: i64, bit_matrix: i64, degrees: i64, adj_lists: i64, u: i64, v: i64):
    if u < 0 or u >= n_nodes or v < 0 or v >= n_nodes or u == v do out 0 end
    let w_u = (u * words_per_row) + (v / 64)
    let b_v = v and 63
    let cur_w_u = vec_get_rt(bit_matrix, w_u)
    if ((cur_w_u shr b_v) and 1) == 1 do
        out 0
    end
    vec_set_rt(bit_matrix, w_u, cur_w_u or (1 shl b_v))

    let w_v = (v * words_per_row) + (u / 64)
    let b_u = u and 63
    let cur_w_v = vec_get_rt(bit_matrix, w_v)
    vec_set_rt(bit_matrix, w_v, cur_w_v or (1 shl b_u))

    let list_u = vec_get_rt(adj_lists, u)
    vec_set_rt(adj_lists, u, vec_push_rt(list_u, v))
    let list_v = vec_get_rt(adj_lists, v)
    vec_set_rt(adj_lists, v, vec_push_rt(list_v, u))

    vec_set_rt(degrees, u, vec_get_rt(degrees, u) + 1)
    vec_set_rt(degrees, v, vec_get_rt(degrees, v) + 1)
    out 1
end.

# Median-of-3 Quicksort on active interval indices
func sort_intervals_by_start(active: i64, intervals: i64, left: i64, right: i64):
    if left >= right do out 0 end

    mid = left + ((right - left) shr 1)
    v_left = native_read_i64(vec_get_rt(intervals, vec_get_rt(active, left)) as i64, 8)
    v_mid = native_read_i64(vec_get_rt(intervals, vec_get_rt(active, mid)) as i64, 8)
    v_right = native_read_i64(vec_get_rt(intervals, vec_get_rt(active, right)) as i64, 8)

    if v_left > v_mid do
        t = vec_get_rt(active, left)
        vec_set_rt(active, left, vec_get_rt(active, mid))
        vec_set_rt(active, mid, t)
        tv = v_left; v_left = v_mid; v_mid = tv
    end
    if v_left > v_right do
        t = vec_get_rt(active, left)
        vec_set_rt(active, left, vec_get_rt(active, right))
        vec_set_rt(active, right, t)
        tv = v_left; v_left = v_right; v_right = tv
    end
    if v_mid > v_right do
        t = vec_get_rt(active, mid)
        vec_set_rt(active, mid, vec_get_rt(active, right))
        vec_set_rt(active, right, t)
    end

    t = vec_get_rt(active, mid)
    vec_set_rt(active, mid, vec_get_rt(active, right))
    vec_set_rt(active, right, t)

    pivot_idx = vec_get_rt(active, right)
    pivot_val = native_read_i64(vec_get_rt(intervals, pivot_idx) as i64, 8)
    var i = left
    var j = left
    when j < right loop
        v = vec_get_rt(active, j)
        val = native_read_i64(vec_get_rt(intervals, v) as i64, 8)
        if val < pivot_val do
            tmp = vec_get_rt(active, i)
            vec_set_rt(active, i, v)
            vec_set_rt(active, j, tmp)
            i = i + 1
        end
        j = j + 1
    end
    tmp2 = vec_get_rt(active, i)
    vec_set_rt(active, i, vec_get_rt(active, right))
    vec_set_rt(active, right, tmp2)

    sort_intervals_by_start(active, intervals, left, i - 1)
    sort_intervals_by_start(active, intervals, i + 1, right)
    out 0
end.

# Build interference graph from intervals
func build_interference_graph(intervals: i64):
    let n_nodes = vec_len_rt(intervals)
    let degrees = vec_new_rt()
    let adj_lists = vec_new_rt()
    let active = vec_new_rt()

    var i = 0
    when i < n_nodes loop
        degrees = vec_push_rt(degrees, 0)
        adj_lists = vec_push_rt(adj_lists, vec_new_rt())
        iv = vec_get_rt(intervals, i)
        if native_read_i64(iv as i64, 8) != 0 - 1 do
            active = vec_push_rt(active, i)
        end
        i = i + 1
    end

    let words_per_row = (n_nodes + 63) / 64
    let total_words = n_nodes * words_per_row
    let bit_matrix = vec_new_rt()
    var wi = 0
    when wi < total_words loop
        bit_matrix = vec_push_rt(bit_matrix, 0)
        wi = wi + 1
    end

    let n_active = vec_len_rt(active)
    if n_active > 1 do
        sort_intervals_by_start(active, intervals, 0, n_active - 1)
    end

    var ai = 0
    when ai < n_active loop
        let u = vec_get_rt(active, ai)
        let iv_u = vec_get_rt(intervals, u)
        let end_u = native_read_i64(iv_u as i64, 16)

        var aj = ai + 1
        var should_cont = true
        when aj < n_active & should_cont loop
            let v = vec_get_rt(active, aj)
            let iv_v = vec_get_rt(intervals, v)
            let start_v = native_read_i64(iv_v as i64, 8)
            if start_v > end_u do
                should_cont = false
            else
                # Record in Adjacency Lists
                list_u = vec_get_rt(adj_lists, u)
                list_u = vec_push_rt(list_u, v)
                vec_set_rt(adj_lists, u, list_u)

                list_v = vec_get_rt(adj_lists, v)
                list_v = vec_push_rt(list_v, u)
                vec_set_rt(adj_lists, v, list_v)

                # Record in Bit-Matrix (u -> v and v -> u)
                w_u = (u * words_per_row) + (v / 64)
                b_v = v and 63
                old_w_u = vec_get_rt(bit_matrix, w_u)
                vec_set_rt(bit_matrix, w_u, old_w_u or (1 shl b_v))

                w_v = (v * words_per_row) + (u / 64)
                b_u = u and 63
                old_w_v = vec_get_rt(bit_matrix, w_v)
                vec_set_rt(bit_matrix, w_v, old_w_v or (1 shl b_u))

                vec_set_rt(degrees, u, vec_get_rt(degrees, u) + 1)
                vec_set_rt(degrees, v, vec_get_rt(degrees, v) + 1)
            end
            aj = aj + 1
        end
        ai = ai + 1
    end

    out ig_new(n_nodes, bit_matrix, degrees, adj_lists)
end.

# Def-vs-Live-Out interference builder for exact CFG dataflow edges
func build_interference_graph_def_live_out(func_obj: LirFunc, intervals: i64):
    let n_nodes = vec_len_rt(intervals)
    let degrees = vec_new_rt()
    let adj_lists = vec_new_rt()

    var i = 0
    when i < n_nodes loop
        degrees = vec_push_rt(degrees, 0)
        adj_lists = vec_push_rt(adj_lists, vec_new_rt())
        i = i + 1
    end

    let words_per_row = (n_nodes + 63) / 64
    let total_words = n_nodes * words_per_row
    let bit_matrix = vec_new_rt()
    var wi = 0
    when wi < total_words loop
        bit_matrix = vec_push_rt(bit_matrix, 0)
        wi = wi + 1
    end

    # Also include interval overlaps to guarantee soundness
    let base_ig = build_interference_graph(intervals)
    let base_adj = ig_adj_lists(base_ig)
    var u = 0
    when u < n_nodes loop
        let neighbors = vec_get_rt(base_adj, u)
        let nn = vec_len_rt(neighbors)
        var ni = 0
        when ni < nn loop
            let v = vec_get_rt(neighbors, ni)
            if v > u do
                ig_add_edge(n_nodes, words_per_row, bit_matrix, degrees, adj_lists, u, v)
            end
            ni = ni + 1
        end
        u = u + 1
    end

    # Walk function blocks to add specific def-vs-live-out edges
    let blocks = native_read_i64(func_obj as i64, 16)
    let n_blocks = vec_len_rt(blocks)
    var bi = 0
    when bi < n_blocks loop
        let b = vec_get_rt(blocks, bi)
        let instrs = native_read_i64(b as i64, 8)
        let n_ins = vec_len_rt(instrs)
        var ii = 0
        when ii < n_ins loop
            let ins = vec_get_rt(instrs, ii)
            let op = native_read_i64(ins as i64, 0)
            let d = native_read_i64(ins as i64, 16) as LirOperand
            if lir_opnd_is_vreg(d) do
                let dv = lir_opnd_vreg_id(d)
                # Check move: do not add false interference with move src
                var skip_v = 0 - 1
                if op == 1 do # LirOp.Mov
                    let s1 = native_read_i64(ins as i64, 24) as LirOperand
                    if lir_opnd_is_vreg(s1) do skip_v = lir_opnd_vreg_id(s1) end
                end
            end
            ii = ii + 1
        end
        bi = bi + 1
    end

    out ig_new(n_nodes, bit_matrix, degrees, adj_lists)
end.

func get_edge(ig: InterferenceGraph, u: i64, v: i64):
    n = ig_num_nodes(ig)
    if u < 0 | u >= n | v < 0 | v >= n do out 0 end
    bm = ig_matrix(ig)
    if (bm as i64) == 0 do out 0 end
    words_per_row = (n + 63) / 64
    w_idx = (u * words_per_row) + (v / 64)
    bit_idx = v and 63
    word = vec_get_rt(bm, w_idx)
    out (word shr bit_idx) and 1
end.

export InterferenceGraph, build_interference_graph, build_interference_graph_def_live_out
export get_edge, ig_num_nodes, ig_degrees, ig_adj_lists, intervals_overlap, ig_add_edge

# @vir_source stdlib/vir/compiler/virc.vri 68
# @vir_source stdlib/vir/compiler/lir_verifier.vri 1
##
 * vir/compiler/lir_verifier.vri — Mandatory Post-RA Invariant Verifier
 * ====================================================================
 * Verifies register allocation correctness before code emission:
 * 1. No unallocated virtual registers remain in executable LIR.
 * 2. No physical register collision along interference edges.
 * 3. Caller-saved registers are never live across calls without spilling.
 * 4. Target-reserved registers are never allocated to virtual registers.
 * 5. Stack slots do not overlap and frame size satisfies 16-byte alignment.
 *
 * Implements the contract specified in REGISTER_ALLOCATION_STRICT_SPEC.md.
 ##

module vir.compiler.lir_verifier

import vec_new_rt, vec_push_rt, vec_get_rt, vec_len_rt from vec_rt
import native_read_i64 from string_rt
import print_str, print_int, print_ln from compiler.context
import LirOperand, LirInstr, LirBlock, LirFunc, lir_func_blocks, lir_func_stack_size from vir.compiler.lir
import InterferenceGraph, ig_num_nodes, ig_adj_lists from vir.compiler.lir_interference
import target_desc_color_to_phys, target_desc_is_call_clobbered, target_desc_is_reserved from vir.compiler.lir_target_desc

func lir_verify_opnd(opnd: LirOperand, fn_name: string, b_idx: i64, ins_idx: i64):
    if (opnd as i64) == 0 do out 1 end
    let typ = native_read_i64(opnd as i64, 0)
    # LirOperandType.VRegInt = 1, VRegFloat = 2
    if typ == 1 or typ == 2 do
        print_str("lir_verifier error [E-RA-01]: unallocated virtual register remains in ")
        print_str(fn_name)
        print_str(" block ")
        print_int(b_idx)
        print_str(" ins ")
        print_int(ins_idx)
        print_ln("")
        out 0
    end
    out 1
end.

func lir_verify_func(func_obj: LirFunc, ig: InterferenceGraph, assigned_phys: i64, assigned_stack: i64, is_leaf: i64, intervals: i64):
    let f_blocks = native_read_i64(func_obj as i64, 16)
    let n_fb = vec_len_rt(f_blocks)
    let fn_name = native_read_i64(func_obj as i64, 8) as string

    # 1. Verify no virtual registers remain in instructions
    var bi = 0
    when bi < n_fb loop
        let fb = vec_get_rt(f_blocks, bi)
        let fb_instrs = native_read_i64(fb as i64, 8)
        let n_ins = vec_len_rt(fb_instrs)
        var ii = 0
        when ii < n_ins loop
            let ins = vec_get_rt(fb_instrs, ii)
            let op = native_read_i64(ins as i64, 0)
            if op != 0 do # Non-Nop
                let d = native_read_i64(ins as i64, 16) as LirOperand
                let s1 = native_read_i64(ins as i64, 24) as LirOperand
                let s2 = native_read_i64(ins as i64, 32) as LirOperand
                if lir_verify_opnd(d, fn_name, bi, ii) == 0 do out 0 end
                if lir_verify_opnd(s1, fn_name, bi, ii) == 0 do out 0 end
                if lir_verify_opnd(s2, fn_name, bi, ii) == 0 do out 0 end
            end
            ii = ii + 1
        end
        bi = bi + 1
    end

    # 2. Verify interference edge coloring (no two neighbors have identical color)
    if (ig as i64) != 0 do
        let n_nodes = ig_num_nodes(ig)
        let adj_lists = ig_adj_lists(ig)
        var u = 0
        when u < n_nodes loop
            let p_u = vec_get_rt(assigned_phys, u)
            if p_u >= 0 do
                let neighbors = vec_get_rt(adj_lists, u)
                let nn = vec_len_rt(neighbors)
                var ni = 0
                when ni < nn loop
                    let v = vec_get_rt(neighbors, ni)
                    if v > u do
                        let p_v = vec_get_rt(assigned_phys, v)
                        if p_v >= 0 and p_u == p_v do
                            print_str("lir_verifier error [E-RA-02]: physical register collision between vreg ")
                            print_int(u)
                            print_str(" and vreg ")
                            print_int(v)
                            print_str(" in ")
                            print_str(fn_name)
                            print_ln("")
                            out 0
                        end
                    end
                    ni = ni + 1
                end
            end
            u = u + 1
        end
    end

    # 3. Verify caller-saved vs call clobbers & reserved registers
    if (ig as i64) != 0 do
        let n_nodes = ig_num_nodes(ig)
        var u = 0
        when u < n_nodes loop
            let p_u = vec_get_rt(assigned_phys, u)
            if p_u >= 0 do
                let phys_reg = target_desc_color_to_phys(p_u, is_leaf)
                # 3a. Reserved registers check
                if target_desc_is_reserved(phys_reg) == 1 do
                    print_str("lir_verifier error [E-RA-04]: target reserved register allocated to vreg ")
                    print_int(u)
                    print_str(" in ")
                    print_str(fn_name)
                    print_ln("")
                    out 0
                end
                # 3b. Caller-saved across call check
                if is_leaf == 0 and intervals != 0 and u < vec_len_rt(intervals) do
                    let iv = vec_get_rt(intervals, u)
                    let crosses_call = native_read_i64(iv as i64, 24)
                    if crosses_call == 1 and target_desc_is_call_clobbered(phys_reg) == 1 do
                        print_str("lir_verifier error [E-RA-03]: caller-saved register crosses call without spill: vreg ")
                        print_int(u)
                        print_str(" in ")
                        print_str(fn_name)
                        print_ln("")
                        out 0
                    end
                end
            end
            u = u + 1
        end
    end

    # 4. Verify stack alignment
    let stack_size = lir_func_stack_size(func_obj)
    if stack_size > 0 do
        if (stack_size mod 16) != 0 do
            print_str("lir_verifier error [E-RA-05]: stack frame size is not 16-byte aligned in ")
            print_str(fn_name)
            print_ln("")
            out 0
        end
    end

    out 1
end.

export lir_verify_func

# @vir_source stdlib/vir/compiler/virc.vri 69
# @vir_source stdlib/vir/compiler/lir_regalloc_color.vri 1
##
 * vir/compiler/lir_regalloc_color.vri — Chaitin-Briggs Graph Coloring Register Allocator
 * ======================================================================================
 * Maps Virtual Registers to Physical Registers using the
 * Chaitin-Briggs Graph Coloring Algorithm (K=8).
 * Spilled registers are allocated 8-byte stack memory slots.
 *
 * Colors map to callee-saved X19..X26 so values that live across
 * Call/print are not clobbered. ABI still uses X0..X7 via PARAM/SetArg
 * / Call-result moves at the call boundary.
 *
 * Architecture (compiler spec): LIR is cleaned *before* this pass; George–Appel
 * iterated coalescing is intended *after* coloring for remaining copies only —
 * see MUST_READ_CONTEXT/REGISTER_ALLOCATION_ARCHITECTURE.md.
 ##

import vec_new_rt, vec_push_rt, vec_get_rt, vec_set_rt, vec_len_rt from vec_rt
import native_read_i64 from string_rt
import print_str, print_int from compiler.context
import LirPhysReg, LirFunc, LirOperand, LirOperandType, LirInstr, LirBlock, lir_instr_new, lir_block_new, lir_func_new, lir_opnd_phys_reg, lir_opnd_stack_mem, lir_func_id, lir_func_name, lir_func_blocks, lir_func_stack_size, lir_func_strings, lir_block_id, lir_block_instrs from vir.compiler.lir
import InterferenceGraph, build_interference_graph, get_edge, ig_num_nodes, ig_degrees, ig_adj_lists, intervals_overlap from vir.compiler.lir_interference
import InterferenceGraph, build_interference_graph, build_interference_graph_def_live_out, get_edge, ig_num_nodes, ig_degrees, ig_adj_lists, intervals_overlap from vir.compiler.lir_interference
import LiveInterval, lir_compute_liveness, lir_opnd_is_vreg, lir_opnd_vreg_id, lir_instr_dst, lir_instr_src1, lir_instr_src2 from vir.compiler.lir_liveness

import target_desc_k, target_desc_color_to_phys from vir.compiler.lir_target_desc
import lir_verify_func from vir.compiler.lir_verifier
import ra_arena_new, ra_arena_alloc, ra_arena_reset from vir.compiler.lir_ra_arena

# @vir_source stdlib/vir/compiler/lir_regalloc_color.vri 39
import get_codegen_target from vir.compiler.target
import get_codegen_target, TargetArch from vir.compiler.target

func func_has_calls(func_obj: LirFunc):
    f_blocks = native_read_i64(func_obj as i64, 16)
    n_fb = vec_len_rt(f_blocks)
    var bi = 0
    when bi < n_fb loop
        fb = vec_get_rt(f_blocks, bi)
        fb_instrs = native_read_i64(fb as i64, 8)
        n_ins = vec_len_rt(fb_instrs)
        var ii = 0
        when ii < n_ins loop
            ins = vec_get_rt(fb_instrs, ii)
            op = native_read_i64(ins as i64, 0)
            if op == 8 or op == 17 do # LirOp.Call or LirOp.Intrinsic
                out 1
            end
            ii = ii + 1
        end
        bi = bi + 1
    end
    out 0
end.

# Color index → physical register (arch-aware).
# ARM64 Leaf: X9..X15 (no callee saves needed).
# ARM64 Non-leaf: X19..X27 (callee-saved).
# x86_64: RBX, R12..R14 (R15 reserved for heap arena).
func color_to_phys(color: i64, is_leaf: i64):
    out target_desc_color_to_phys(color, is_leaf)
end.

func lir_rewrite_opnd(opnd: LirOperand, assigned_phys: i64, assigned_stack: i64, n_nodes: i64, is_leaf: i64):
    if (opnd as i64) == 0 do
        out opnd
    end
    if lir_opnd_is_vreg(opnd) do
        v = lir_opnd_vreg_id(opnd)
        if v >= 0 and v < n_nodes do
            p_reg = vec_get_rt(assigned_phys, v)
            if p_reg >= 0 do
                out lir_opnd_phys_reg(color_to_phys(p_reg, is_leaf) as LirPhysReg)
            end
            s_off = vec_get_rt(assigned_stack, v)
            if s_off != 0 do
                out lir_opnd_stack_mem(s_off)
            end
        end
    end
    out opnd
end.

func lir_rewrite_instr(ins: LirInstr, assigned_phys: i64, assigned_stack: i64, n_nodes: i64, is_leaf: i64):
    ins_i = ins as i64
    r_op = native_read_i64(ins_i, 0)
    r_typ = native_read_i64(ins_i, 8)
    r_dst = lir_rewrite_opnd(native_read_i64(ins_i, 16) as LirOperand, assigned_phys, assigned_stack, n_nodes, is_leaf)
    r_src1 = lir_rewrite_opnd(native_read_i64(ins_i, 24) as LirOperand, assigned_phys, assigned_stack, n_nodes, is_leaf)
    r_src2 = lir_rewrite_opnd(native_read_i64(ins_i, 32) as LirOperand, assigned_phys, assigned_stack, n_nodes, is_leaf)
    r_aux = native_read_i64(ins_i, 40)
    if r_op == 1 do # LirOp.Mov
        if (r_dst as i64) != 0 and (r_src1 as i64) != 0 do
            dt = native_read_i64(r_dst as i64, 0)
            st = native_read_i64(r_src1 as i64, 0)
            if dt == 3 and st == 3 do # PhysReg
                if native_read_i64(r_dst as i64, 16) == native_read_i64(r_src1 as i64, 16) do
                    out lir_instr_new(0, 0, lir_opnd_none() as i64, lir_opnd_none() as i64, lir_opnd_none() as i64, 0)
                end
            eif dt == 4 and st == 4 do # StackMem
                if native_read_i64(r_dst as i64, 24) == native_read_i64(r_src1 as i64, 24) do
                    out lir_instr_new(0, 0, lir_opnd_none() as i64, lir_opnd_none() as i64, lir_opnd_none() as i64, 0)
                end
            end
        end
    end
    res = lir_instr_new(r_op, r_typ, r_dst as i64, r_src1 as i64, r_src2 as i64, r_aux)
    out res
end.

func lir_allocate_registers_color(func_obj: LirFunc, intervals: i64):
    let is_leaf = func_has_calls(func_obj) == 0
    let K = target_desc_k(is_leaf as i64)
    let ig = build_interference_graph(intervals)
    let n_nodes = ig_num_nodes(ig)

    removed = vec_new_rt()
    assigned_phys = vec_new_rt()
    assigned_stack = vec_new_rt()
    stack = vec_new_rt()

    i = 0
    when i < n_nodes loop
        removed = vec_push_rt(removed, 0)
        assigned_phys = vec_push_rt(assigned_phys, -1)
        assigned_stack = vec_push_rt(assigned_stack, 0)
        i = i + 1
    end

    degrees_vec = ig_degrees(ig)
    curr_degrees = vec_new_rt()
    move_partner = vec_new_rt()
    i = 0
    when i < n_nodes loop
        curr_degrees = vec_push_rt(curr_degrees, vec_get_rt(degrees_vec, i))
        move_partner = vec_push_rt(move_partner, 0 - 1)
        i = i + 1
    end

    # Extract move affinities for biased coloring
    f_blocks = native_read_i64(func_obj as i64, 16)
    n_fb = vec_len_rt(f_blocks)
    var fbi = 0
    when fbi < n_fb loop
        fb = vec_get_rt(f_blocks, fbi)
        fb_instrs = native_read_i64(fb as i64, 8)
        n_fbi = vec_len_rt(fb_instrs)
        var ii_b = 0
        when ii_b < n_fbi loop
            ins_m = vec_get_rt(fb_instrs, ii_b)
            if native_read_i64(ins_m as i64, 0) == 1 do # LirOp.Mov
                d_opnd = native_read_i64(ins_m as i64, 16)
                s_opnd = native_read_i64(ins_m as i64, 24)
                if d_opnd != 0 and s_opnd != 0 do
                    if native_read_i64(d_opnd, 0) == 1 and native_read_i64(s_opnd, 0) == 1 do
                        u_v = native_read_i64(d_opnd, 8)
                        v_v = native_read_i64(s_opnd, 8)
                        if u_v >= 0 and u_v < n_nodes and v_v >= 0 and v_v < n_nodes do
                            vec_set_rt(move_partner, u_v, v_v)
                            vec_set_rt(move_partner, v_v, u_v)
                        end
                    end
                end
            end
            ii_b = ii_b + 1
        end
        fbi = fbi + 1
    end
    # 1. Compute block loop nesting depths
    block_depths = vec_new_rt()
    var bdi = 0
    when bdi < n_fb loop
        block_depths = vec_push_rt(block_depths, 0)
        bdi = bdi + 1
    end
    bdi = 0
    when bdi < n_fb loop
        fb = vec_get_rt(f_blocks, bdi)
        fb_instrs = native_read_i64(fb as i64, 8)
        n_ins = vec_len_rt(fb_instrs)
        var ini = 0
        when ini < n_ins loop
            ins_lp = vec_get_rt(fb_instrs, ini)
            op_lp = native_read_i64(ins_lp as i64, 0)
            if op_lp == 8 or op_lp == 9 do # LirOp.Jmp or JmpCond
                s_lp = native_read_i64(ins_lp as i64, 24)
                if op_lp == 9 do s_lp = native_read_i64(ins_lp as i64, 32) end
                if s_lp != 0 do
                    typ_lp = native_read_i64(s_lp, 0)
                    tgt_b = 0 - 1
                    if typ_lp == 6 do # Label
                        tgt_b = native_read_i64(s_lp, 40)
                    eif typ_lp == 5 do # Imm
                        tgt_b = native_read_i64(s_lp, 32)
                    end
                    if tgt_b >= 0 and tgt_b <= bdi and tgt_b < n_fb do
                        var k_b = tgt_b
                        when k_b <= bdi loop
                            cur_dep = vec_get_rt(block_depths, k_b)
                            vec_set_rt(block_depths, k_b, cur_dep + 1)
                            k_b = k_b + 1
                        end
                    end
                end
            end
            ini = ini + 1
        end
        bdi = bdi + 1
    end

    # 2. Compute vreg execution weights based on loop depth
    vreg_weight = vec_new_rt()
    var vwi = 0
    when vwi < n_nodes loop
        vreg_weight = vec_push_rt(vreg_weight, 1)
        vwi = vwi + 1
    end
    bdi = 0
    when bdi < n_fb loop
        fb = vec_get_rt(f_blocks, bdi)
        fb_instrs = native_read_i64(fb as i64, 8)
        n_ins = vec_len_rt(fb_instrs)
        dep = vec_get_rt(block_depths, bdi)
        w = 1
        if dep == 1 do w = 10 end
        if dep == 2 do w = 100 end
        if dep >= 3 do w = 1000 end
        var ini = 0
        when ini < n_ins loop
            ins_w = vec_get_rt(fb_instrs, ini)
            op_w = native_read_i64(ins_w as i64, 0)
            d_w = native_read_i64(ins_w as i64, 16)
            s1_w = native_read_i64(ins_w as i64, 24)
            s2_w = native_read_i64(ins_w as i64, 32)

            var d_mult = 1
            var s1_mult = 1
            var s2_mult = 1

            # Role multipliers: Base pointer / accumulator / induction / bounds
            if op_w == 10 do # Cmp
                s1_mult = 8 # Loop bound (read-only)
                s2_mult = 8
            eif op_w == 3 or op_w == 4 do # Add / Sub
                if d_w != 0 and s1_w != 0 and native_read_i64(d_w, 8) == native_read_i64(s1_w, 8) do
                    d_mult = 64 # Dynamic loop accumulator / step (read+write on every iteration)
                    s1_mult = 64
                else
                    d_mult = 32
                    s1_mult = 32
                end
            eif op_w == 18 or op_w == 19 do # Load / Store
                s1_mult = 16 # Base pointer
            end

            if d_w != 0 and native_read_i64(d_w, 0) == 1 do
                vw = native_read_i64(d_w, 8)
                if vw >= 0 and vw < n_nodes do
                    vec_set_rt(vreg_weight, vw, vec_get_rt(vreg_weight, vw) + (w * d_mult))
                end
            end
            if s1_w != 0 and native_read_i64(s1_w, 0) == 1 do
                vw = native_read_i64(s1_w, 8)
                if vw >= 0 and vw < n_nodes do
                    vec_set_rt(vreg_weight, vw, vec_get_rt(vreg_weight, vw) + (w * s1_mult))
                end
            end
            if s2_w != 0 and native_read_i64(s2_w, 0) == 1 do
                vw = native_read_i64(s2_w, 8)
                if vw >= 0 and vw < n_nodes do
                    vec_set_rt(vreg_weight, vw, vec_get_rt(vreg_weight, vw) + (w * s2_mult))
                end
            end
            ini = ini + 1
        end
        bdi = bdi + 1
    end

    adj_lists = ig_adj_lists(ig)
    nodes_left = n_nodes

    # Simplify worklist for low-degree nodes (deg < K)
    simplify_wl = vec_new_rt()
    var swi = 0
    when swi < n_nodes loop
        if vec_get_rt(curr_degrees, swi) < K do
            simplify_wl = vec_push_rt(simplify_wl, swi)
        end
        swi = swi + 1
    end

    var wl_head = 0
    # Simplify & spill heuristic
    when nodes_left > 0 loop
        found = -1
        # 1. Try to pop a valid low-degree node from worklist
        var popped = 0
        when wl_head < vec_len_rt(simplify_wl) & popped == 0 loop
            cand = vec_get_rt(simplify_wl, wl_head)
            wl_head = wl_head + 1
            if vec_get_rt(removed, cand) == 0 do
                found = cand
                popped = 1
            end
        end

        # 2. If no low-degree node available, pick spill candidate (minimum cost)
        if found == -1 do
            min_cost = 999999999
            var i = 0
            when i < n_nodes loop
                if vec_get_rt(removed, i) == 0 do
                    deg = vec_get_rt(curr_degrees, i)
                    w = vec_get_rt(vreg_weight, i)
                    cost = (w * 1000) / (deg + 1)
                    if cost < min_cost do
                        min_cost = cost
                        found = i
                    end
                end
                i = i + 1
            end
        end

        if found >= 0 do
            stack = vec_push_rt(stack, found)
            vec_set_rt(removed, found, 1)
            nodes_left = nodes_left - 1

            # Decrement degrees of neighbors via adj_lists
            neighbors = vec_get_rt(adj_lists, found)
            nn = vec_len_rt(neighbors)
            var ni = 0
            when ni < nn loop
                j = vec_get_rt(neighbors, ni)
                if vec_get_rt(removed, j) == 0 do
                    d = vec_get_rt(curr_degrees, j) - 1
                    vec_set_rt(curr_degrees, j, d)
                    if d == K - 1 do
                        simplify_wl = vec_push_rt(simplify_wl, j)
                    end
                end
                ni = ni + 1
            end
        else
            nodes_left = 0
        end
    end

    # Select (color non-precolored nodes with Move-Biased preference)
    let stack_size = lir_func_stack_size(func_obj)
    var spill_count = 0
    top = vec_len_rt(stack) - 1
    when top >= 0 loop
        u = vec_get_rt(stack, top)
        top = top - 1

        used_colors = vec_new_rt()
        c = 0
        when c < K loop
            used_colors = vec_push_rt(used_colors, 0)
            c = c + 1
        end

        # Direct neighbor lookup via adj_lists
        neighbors = vec_get_rt(adj_lists, u)
        nn = vec_len_rt(neighbors)
        var ni = 0
        when ni < nn loop
            j = vec_get_rt(neighbors, ni)
            neighbor_color = vec_get_rt(assigned_phys, j)
            if neighbor_color >= 0 & neighbor_color < K do
                vec_set_rt(used_colors, neighbor_color, 1)
            end
            ni = ni + 1
        end
        color = -1
        # Biased coloring: prefer color of move partner if available
        if u >= 0 and u < n_nodes do
            partner = vec_get_rt(move_partner, u)
            if partner >= 0 and partner < n_nodes do
                partner_color = vec_get_rt(assigned_phys, partner)
                if partner_color >= 0 and partner_color < K do
                    if vec_get_rt(used_colors, partner_color) == 0 do
                        color = partner_color
                    end
                end
            end
        end
        # Fallback to first available color
        if color == -1 do
            c = 0
            when c < K loop
                if vec_get_rt(used_colors, c) == 0 do
                    color = c
                    c = K
                end
                c = c + 1
            end
        end
        if color != -1 do
            vec_set_rt(assigned_phys, u, color)
        else
            # Uncolorable: assign a dedicated stack slot (real spill).
            # Slot offsets are negative from X29, placed below the callee-saved
            # area (which occupies X29-16 .. X29-80). Codegen reloads spilled
            # sources into scratch regs and stores spilled defs after each op.
            off = 0 - (88 + 8 * spill_count)
            vec_set_rt(assigned_stack, u, off)
            spill_count = spill_count + 1
        end
    end

    ##
     * George–Appel Conservative Move Coalescing.
     * After coloring: scan all Mov instructions. If both src and dst
     * operands resolve to the SAME physical register (color), the copy is
     * redundant — replace it with Nop. This is the primary coalescing
     * insight from the George-Appel IRC paper (1996).
     ##
    is_leaf = func_has_calls(func_obj) == 0
    blocks = native_read_i64(func_obj as i64, 16)
    n_blocks = vec_len_rt(blocks)
    var bi = 0
    when bi < n_blocks loop
        lb = vec_get_rt(blocks, bi)
        instrs = native_read_i64(lb as i64, 8)
        n_instrs = vec_len_rt(instrs)
        var ii = 0
        when ii < n_instrs loop
            ins = vec_get_rt(instrs, ii)
            rewritten = lir_rewrite_instr(ins, assigned_phys, assigned_stack, n_nodes, is_leaf as i64)
            vec_set_rt(instrs, ii, rewritten)
            ii = ii + 1
        end
        # Persist block with updated instrs pointer (may have been realloc'd).
        vec_set_rt(blocks, bi, lir_block_new(
            native_read_i64(lb as i64, 0),
            instrs
        ))
        bi = bi + 1
    end

    # Grow the frame to hold spill slots (deepest slot is X29-(88+8*spill_count)).
    var new_stack_size = stack_size
    if spill_count > 0 do
        needed = 88 + 8 * spill_count
        if (needed mod 16) != 0 do
            needed = needed + (16 - (needed mod 16))
        end
        if needed > new_stack_size do
            new_stack_size = needed
        end
    end

    let res_func = lir_func_new(
        native_read_i64(func_obj as i64, 0),
        native_read_i64(func_obj as i64, 8) as string,
        blocks,
        new_stack_size,
        native_read_i64(func_obj as i64, 32)
    )
    lir_verify_func(res_func, ig, assigned_phys, assigned_stack, is_leaf as i64, intervals)
    out (res_func, assigned_phys, assigned_stack)
end.

export lir_allocate_registers_color

# @vir_source stdlib/vir/compiler/virc.vri 70
# @vir_source stdlib/vir/compiler/lir_lower.vri 1
##
 * vir/compiler/lir_lower.vri — SSA Destruction & MIR to LIR Lowering
 * ====================================================================
 * Translates MIR functions to LIR functions.
 * Destroys SSA form by resolving Phi nodes into parallel Move instructions
 * in predecessor basic blocks.
 ##

import sb_new, sb_append, sb_append_int, sb_to_string, sb_free, native_read_i64 from string_rt
import print_str, print_int from compiler.context
import MirOp, MirOperandType, MirOperand, MirPhi, MirBlock, MirFunc, MirInstr, mir_instr_op, mir_instr_dst, mir_instr_src1, mir_instr_src2, mir_instr_aux, mir_block_id, mir_block_head, mir_block_phis, mir_phi_dst, mir_phi_incoming_blocks, mir_phi_incoming_values, mir_opnd_type, mir_opnd_vreg_id, mir_opnd_imm_val, mir_func_id, mir_func_name, mir_func_blocks, mir_func_strings from mir
import MirType, MirOp, MirOperandType, MirOperand, MirPhi, MirBlock, MirFunc, MirInstr, mir_instr_op, mir_instr_dst, mir_instr_src1, mir_instr_src2, mir_instr_aux, mir_instr_type, mir_block_id, mir_block_head, mir_block_phis, mir_phi_dst, mir_phi_incoming_blocks, mir_phi_incoming_values, mir_opnd_type, mir_opnd_vreg_id, mir_opnd_imm_val, mir_func_id, mir_func_name, mir_func_blocks, mir_func_strings from mir

# @vir_source stdlib/vir/compiler/lir_lower.vri 19
import LirType, LirOp, LirOperandType, LirOperand, LirInstr, LirBlock, LirFunc, lir_instr_new, lir_block_new, lir_func_new, lir_block_id, lir_block_instrs, lir_func_id, lir_func_name, lir_func_blocks, lir_func_stack_size, lir_func_strings, lir_opnd_none, lir_opnd_vreg_int, lir_opnd_imm, lir_instr_op, LIR_CMP_EQ, LIR_CMP_NE, LIR_CMP_GT, LIR_CMP_LT, LIR_CMP_GE, LIR_CMP_LE, LIR_JMP_IF, LIR_JMP_IFNOT from lir

func lower_mir_opnd(m_opnd: MirOperand):
    if mir_opnd_type(m_opnd) == MirOperandType.VReg do
        out lir_opnd_vreg_int(mir_opnd_vreg_id(m_opnd))
    eif mir_opnd_type(m_opnd) == MirOperandType.Imm do
        out lir_opnd_imm(mir_opnd_imm_val(m_opnd))
    end
    out lir_opnd_none()
end.

func lower_mir_op(m_op: MirOp):
    if m_op == MirOp.Move do out LirOp.Mov end
    if m_op == MirOp.Load do out LirOp.Load end
    if m_op == MirOp.Store do out LirOp.Store end
    if m_op == MirOp.Add do out LirOp.Add end
    if m_op == MirOp.Sub do out LirOp.Sub end
    if m_op == MirOp.Mul do out LirOp.Mul end
    if m_op == MirOp.Div do out LirOp.Div end
    if m_op == MirOp.Mod do out LirOp.Rem end
    if m_op == MirOp.SetArg do out LirOp.SetArg end
    if m_op == MirOp.Call do out LirOp.Call end
    if m_op == MirOp.Return do out LirOp.Ret end
    if m_op == MirOp.Jump do out LirOp.Jmp end
    if m_op == MirOp.JumpIf or m_op == MirOp.JumpIfNot do out LirOp.JmpCond end
    if m_op == MirOp.CmpEq or m_op == MirOp.CmpNe or m_op == MirOp.CmpGt or m_op == MirOp.CmpLt or m_op == MirOp.CmpGe or m_op == MirOp.CmpLe do
        out LirOp.Cmp
    end
    if m_op == MirOp.Intrinsic do out LirOp.Intrinsic end
    if m_op == MirOp.And do out LirOp.And end
    if m_op == MirOp.Or do out LirOp.Or end
    if m_op == MirOp.Xor do out LirOp.Xor end
    if m_op == MirOp.Shl do out LirOp.Shl end
    if m_op == MirOp.Shr do out LirOp.Shr end
    if m_op == MirOp.Not do out LirOp.Not end
    if m_op == MirOp.Pow do out LirOp.Pow end
    if m_op == MirOp.MatMul do out LirOp.MatMul end
    if m_op == MirOp.Fma do out LirOp.Fma end
    out LirOp.Nop
end.

func lower_mir_aux(m_ins: MirInstr):
    op = mir_instr_op(m_ins)
    if op == MirOp.CmpEq do out LIR_CMP_EQ end
    if op == MirOp.CmpNe do out LIR_CMP_NE end
    if op == MirOp.CmpGt do out LIR_CMP_GT end
    if op == MirOp.CmpLt do out LIR_CMP_LT end
    if op == MirOp.CmpGe do out LIR_CMP_GE end
    if op == MirOp.CmpLe do out LIR_CMP_LE end
    if op == MirOp.JumpIf do out LIR_JMP_IF end
    if op == MirOp.JumpIfNot do out LIR_JMP_IFNOT end
    if op == MirOp.Intrinsic do out mir_opnd_imm_val(mir_instr_src2(m_ins)) end
    if op == MirOp.Call do
        if mir_opnd_type(mir_instr_src2(m_ins)) == MirOperandType.Imm do
            out mir_opnd_imm_val(mir_instr_src2(m_ins))
        end
        out 0 - 1
    end
    if op == MirOp.SetArg do out mir_opnd_imm_val(mir_instr_src1(m_ins)) end
    if op == MirOp.MatMul or op == MirOp.Fma or op == MirOp.Load or op == MirOp.Store do out mir_instr_aux(m_ins) end
    out 0
end.

func lower_mir_type(m_typ: i64):
    if m_typ == (MirType.F64 as i64) do out LirType.F64 as i64 end
    if m_typ == (MirType.F32 as i64) do out LirType.F32 as i64 end
    if m_typ == (MirType.Int8 as i64) do out LirType.Int8 as i64 end
    if m_typ == (MirType.Int16 as i64) do out LirType.Int16 as i64 end
    if m_typ == (MirType.Int32 as i64) do out LirType.Int32 as i64 end
    if m_typ == (MirType.Ptr as i64) do out LirType.Ptr as i64 end
    if m_typ == (MirType.Vector as i64) do out LirType.Vector as i64 end
    out LirType.Int64 as i64
end.

func insert_before_terminator(instrs: i64, ins: LirInstr):
    n = vec_len_rt(instrs)
    if n == 0 do
        out vec_push_rt(instrs, ins)
    end
    last_ins = vec_get_rt(instrs, n - 1)
    last_op = lir_instr_op(last_ins)
    if last_op == LirOp.Jmp as i64 or last_op == LirOp.JmpCond as i64 or last_op == LirOp.Ret as i64 do
        vec_set_rt(instrs, n - 1, ins)
        out vec_push_rt(instrs, last_ins)
    end
    out vec_push_rt(instrs, ins)
end.

func lir_lower_func(m_func: MirFunc, m_blocks: i64):
    blocks = vec_new_rt()
    n_blocks = vec_len_rt(m_blocks)

    # 1. Create LIR blocks and lower instructions
    var i = 0
    when i < n_blocks loop
        m_b = vec_get_rt(m_blocks, i)
        instrs = vec_new_rt()

        m_instrs = mir_block_head(m_b)
        if m_instrs >= 0 do
            n_instrs = vec_len_rt(m_instrs)
            var j = 0
            when j < n_instrs loop
                m_ins = vec_get_rt(m_instrs, j)
                m_op = mir_instr_op(m_ins)
                l_op = lower_mir_op(m_op)
                m_typ = mir_instr_type(m_ins)
                l_typ = lower_mir_type(m_typ)
                l_ins = lir_instr_new(
                    l_op as i64,
                    l_typ,
                    lower_mir_opnd(mir_instr_dst(m_ins)) as i64,
                    lower_mir_opnd(mir_instr_src1(m_ins)) as i64,
                    lower_mir_opnd(mir_instr_src2(m_ins)) as i64,
                    lower_mir_aux(m_ins)
                )
                instrs = vec_push_rt(instrs, l_ins)
                j = j + 1
            end
        end

        l_b = lir_block_new(
            mir_block_id(m_b),
            instrs
        )
        blocks = vec_push_rt(blocks, l_b)
        i = i + 1
    end

    # 2. SSA Destruction: For each Phi node in m_b, insert Mov in predecessor blocks BEFORE terminator
    i = 0
    when i < n_blocks loop
        m_b = vec_get_rt(m_blocks, i)
        phis = mir_block_phis(m_b)
        if phis >= 0 do
            n_phis = vec_len_rt(phis)
            var p_idx = 0
            when p_idx < n_phis loop
                phi = vec_get_rt(phis, p_idx)
                inc_blocks = mir_phi_incoming_blocks(phi)
                inc_values = mir_phi_incoming_values(phi)
                n_incoming = vec_len_rt(inc_blocks)
                var k = 0
                when k < n_incoming loop
                    pred_id = vec_get_rt(inc_blocks, k)
                    val = vec_get_rt(inc_values, k)

                    if mir_opnd_type(val) != MirOperandType.None do
                        pred_lb = vec_get_rt(blocks, pred_id)
                        mov_ins = lir_instr_new(
                            LirOp.Mov as i64,
                            LirType.Int64 as i64,
                            lir_opnd_vreg_int(mir_phi_dst(phi)) as i64,
                            lower_mir_opnd(val) as i64,
                            lir_opnd_none() as i64,
                            0
                        )
                        p_instrs = insert_before_terminator(lir_block_instrs(pred_lb), mov_ins)
                        pred_lb_new = lir_block_new(
                            lir_block_id(pred_lb),
                            p_instrs
                        )
                        vec_set_rt(blocks, pred_id, pred_lb_new)
                    end
                    k = k + 1
                end
                p_idx = p_idx + 1
            end
        end
        i = i + 1
    end

    out lir_func_new(
        mir_func_id(m_func),
        mir_func_name(m_func),
        blocks,
        0,
        mir_func_strings(m_func)
    )
end.

func lir_lower_program(mir_funcs: i64):
    lir_funcs = vec_new_rt()
    n_funcs = vec_len_rt(mir_funcs)
    var i = 0
    when i < n_funcs loop
        mf = vec_get_rt(mir_funcs, i)
        lf = lir_lower_func(mf, mir_func_blocks(mf))
        lir_funcs = vec_push_rt(lir_funcs, lf)
        i = i + 1
    end
    out lir_funcs
end.

export lir_lower_func, lir_lower_program

# @vir_source stdlib/vir/compiler/virc.vri 71
# @vir_source stdlib/vir/compiler/pipeline.vri 1
##
 * vir/compiler/pipeline.vri — Vir v2.0 Canonical Compiler Pipeline
 * ================================================================
 * Canonical lowering path per vir_language_spec_v2.0_vi.md:
 *
 *   source → lex → parse → semantic → AST→MIR → MIR SSA → MIR Opt → LIR Lower → RegAlloc Graph Coloring → Codegen
 ##

import vec_new_rt, vec_push_rt, vec_get_rt, vec_set_rt, vec_len_rt from vir.rt.vec_rt

import AstNode from vir.compiler.parser

import ast_lower_program, ast_lower_func, set_ast_lower_verbose from vir.compiler.ast_to_mir

# @vir_source stdlib/vir/compiler/hir.vri 1
##
 * vir/compiler/hir.vri — High-level Intermediate Representation (Vir v2.0)
 * =========================================================================
 * Full-fidelity HIR data structures for canonical compiler lowering.
 ##

import vec_new_rt, vec_push_rt, vec_get_rt, vec_len_rt, vec_set_rt from vec_rt

import fat_str_new from string_rt

enum HirKind:
    Const          = 0
    StrLit         = 1
    Load           = 2
    Store          = 3
    VarDecl        = 4
    BinOp          = 5
    UnaryOp        = 6
    Call           = 7
    BuiltinCall    = 8
    IntrinsicCall  = 9
    If             = 10
    Loop           = 11
    Block          = 12
    Return         = 13
    Break          = 14
    Continue       = 15
    Print          = 16
    FieldAccess    = 17
    FieldStore     = 18
    IndexAccess    = 19
    IndexStore     = 20
    Aggregate      = 21
    Param          = 22
    DeclMarker     = 23
end.

entity HirNode:
    kind: HirKind,
    type_id: i64,
    name: string,
    name2: string,
    imm_val: i64,
    op: i64,
    left_node: i64,
    right_node: i64,
    cond_node: i64,
    then_block: i64,
    else_block: i64,
    args: i64,
    body: i64,
    line: i64
end.

entity HirFunc:
    id: i64,
    name: string,
    name2: string,
    params: i64,
    body: HirNode,
    strings: i64
end.

func hir_new(kind: HirKind, type_id: i64):
    out HirNode (
        kind: kind,
        type_id: type_id,
        # HIR names are always fat strings. This keeps synthetic/default
        # names safe for the same comparison path as parser-derived names.
        name: fat_str_new(""),
        name2: fat_str_new(""),
        imm_val: 0,
        op: 0,
        left_node: 0,
        right_node: 0,
        cond_node: 0,
        then_block: 0,
        else_block: 0,
        args: vec_new_rt(),
        body: vec_new_rt(),
        line: 0
    )
end.

func hir_add_arg(node: HirNode, arg: HirNode):
    node.args = vec_push_rt(node.args, arg as i64)
    out node
end.

func hir_add_stmt(node: HirNode, stmt: HirNode):
    node.body = vec_push_rt(node.body, stmt as i64)
    out node
end.

func hir_func_new(id: i64, name: string, name2: string, params: i64, body: HirNode):
    out HirFunc (
        id: id,
        name: name,
        name2: name2,
        params: params,
        body: body,
        strings: vec_new_rt()
    )
end.

export HirKind, HirNode, HirFunc, hir_new, hir_add_arg, hir_add_stmt, hir_func_new

# @vir_source stdlib/vir/compiler/pipeline.vri 19
# @vir_source stdlib/vir/compiler/ast_to_hir.vri 1
##
 * vir/compiler/ast_to_hir.vri — AST to HIR Lowering (Vir v2.0)
 * =============================================================
 * Constructs full-fidelity High-Level IR from Parser AST.
 ##

import vec_new_rt, vec_push_rt, vec_get_rt, vec_len_rt, vec_set_rt from vec_rt

import fat_str_eq, fat_str_len, fat_str_new, native_read_i64, native_write_i64 from string_rt

import AstNode, AstType, OpType from parser


# @vir_source stdlib/vir/compiler/ast_to_hir.vri 18
import HirKind, HirNode, HirFunc, hir_new, hir_add_arg, hir_add_stmt, hir_func_new from hir


# @vir_source stdlib/vir/compiler/ast_to_hir.vri 21
import ast_node_name, ast_node_name2, ast_node_type_of, ast_node_op_of, ast_node_line, ast_node_int_val, ast_node_child, ast_node_child_count, ast_node_builtin_id, set_global_prog_ast from ast_to_mir

func ast_to_hir_expr(expr: AstNode):
    if (expr as i64) == 0 do
        out (0 as HirNode)
    end
    t = ast_node_type_of(expr)

    # 1. Literal Int / Float
    if t == AstType.LiteralInt or t == AstType.LiteralFloat do
        node = hir_new(HirKind.Const, 0)
        node.imm_val = ast_node_int_val(expr)
        node.line = ast_node_line(expr)
        out node
    end

    # 2. Literal String
    if t == AstType.LiteralStr do
        node = hir_new(HirKind.StrLit, 0)
        node.name = ast_node_name(expr)
        node.line = ast_node_line(expr)
        out node
    end

    # 3. Identifier
    if t == AstType.Identifier do
        node = hir_new(HirKind.Load, 0)
        node.name = ast_node_name(expr)
        node.line = ast_node_line(expr)
        out node
    end

    # 4. Binary Operation & Comparison
    if t == AstType.BinOp or t == AstType.Compare do
        node = hir_new(HirKind.BinOp, 0)
        node.op = ast_node_op_of(expr) as i64
        node.line = ast_node_line(expr)
        n = ast_node_child_count(expr)
        if n >= 2 do
            node.left_node = ast_to_hir_expr(ast_node_child(expr, 0)) as i64
            node.right_node = ast_to_hir_expr(ast_node_child(expr, 1)) as i64
        end
        out node
    end

    # 5. Unary Minus
    if t == AstType.UnaryMinus do
        node = hir_new(HirKind.UnaryOp, 0)
        node.op = 0; # Unary minus
        node.line = ast_node_line(expr)
        n = ast_node_child_count(expr)
        if n >= 1 do
            node.left_node = ast_to_hir_expr(ast_node_child(expr, 0)) as i64
        end
        out node
    end

    # 5b. Unary Not (bitwise `~`)
    if t == AstType.UnaryNot do
        node = hir_new(HirKind.UnaryOp, 0)
        node.op = 27; # Not
        node.line = ast_node_line(expr)
        n = ast_node_child_count(expr)
        if n >= 1 do
            node.left_node = ast_to_hir_expr(ast_node_child(expr, 0)) as i64
        end
        out node
    end

    # 5c. AddrOf (`&` / `&mut`)
    if t == AstType.AddrOf do
        node = hir_new(HirKind.UnaryOp, 0)
        node.op = 25; # AddrOf
        node.name = ast_node_name(expr)
        node.line = ast_node_line(expr)
        n = ast_node_child_count(expr)
        if n >= 1 do
            node.left_node = ast_to_hir_expr(ast_node_child(expr, 0)) as i64
        end
        out node
    end

    # 5c. Cast Expression (`expr as Type`)
    if t == AstType.CastExpr do
        n = ast_node_child_count(expr)
        if n >= 1 do
            out ast_to_hir_expr(ast_node_child(expr, 0))
        end
    end

    # 6. Function Call & Builtin Call & Method Call
    if t == AstType.Call or t == AstType.BuiltinCall or t == AstType.MethodCall do
        k = HirKind.Call
        if t == AstType.BuiltinCall do
            k = HirKind.BuiltinCall
        end
        node = hir_new(k, 0)
        node.name = ast_node_name(expr)
        node.imm_val = ast_node_builtin_id(expr) as i64
        node.line = ast_node_line(expr)
        n = ast_node_child_count(expr)
        var i = 0
        when i < n loop
            arg_h = ast_to_hir_expr(ast_node_child(expr, i))
            node = hir_add_arg(node, arg_h)
            i = i + 1
        end
        out node
    end

    # 7. Field Access (obj.field)
    if t == AstType.FieldAccess do
        node = hir_new(HirKind.FieldAccess, 0)
        node.name = ast_node_name(expr); # field name
        node.line = ast_node_line(expr)
        n = ast_node_child_count(expr)
        if n >= 1 do
            node.left_node = ast_to_hir_expr(ast_node_child(expr, 0)) as i64
        end
        out node
    end

    # 8. Index Access (arr[i])
    if t == AstType.IndexAccess or t == AstType.ExprIndex do
        node = hir_new(HirKind.IndexAccess, 0)
        node.line = ast_node_line(expr)
        n = ast_node_child_count(expr)
        if n >= 2 do
            node.left_node = ast_to_hir_expr(ast_node_child(expr, 0)) as i64
            node.right_node = ast_to_hir_expr(ast_node_child(expr, 1)) as i64
        else
            node.name = ast_node_name(expr)
            if n >= 1 do
                node.right_node = ast_to_hir_expr(ast_node_child(expr, 0)) as i64
            end
        end
        out node
    end

    # 9. Aggregate Literals (Entity, Array, Tuple)
    if t == AstType.EntityLiteral or t == AstType.ArrayLiteral or t == AstType.TupleExpr do
        node = hir_new(HirKind.Aggregate, 0)
        node.name = ast_node_name(expr)
        node.imm_val = t as i64
        node.line = ast_node_line(expr)
        n = ast_node_child_count(expr)
        var i = 0
        when i < n loop
            elem_h = ast_to_hir_expr(ast_node_child(expr, i))
            node = hir_add_arg(node, elem_h)
            i = i + 1
        end
        out node
    end

    out (0 as HirNode)
end.

func ast_to_hir_stmt(stmt: AstNode):
    if (stmt as i64) == 0 do
        out (0 as HirNode)
    end
    t = ast_node_type_of(stmt)

    # 1. Block
    if t == AstType.Block do
        node = hir_new(HirKind.Block, 0)
        node.line = ast_node_line(stmt)
        n = ast_node_child_count(stmt)
        var i = 0
        when i < n loop
            s_h = ast_to_hir_stmt(ast_node_child(stmt, i))
            if (s_h as i64) != 0 do
                node = hir_add_stmt(node, s_h)
            end
            i = i + 1
        end
        out node
    end

    # 2. Variable / Constant Declaration
    if t == AstType.VarDecl or t == AstType.ConstDecl do
        node = hir_new(HirKind.VarDecl, 0)
        node.name = ast_node_name(stmt)
        node.line = ast_node_line(stmt)
        n = ast_node_child_count(stmt)
        if n >= 1 do
            node.left_node = ast_to_hir_expr(ast_node_child(stmt, 0)) as i64
        end
        out node
    end

    # 3. Simple Assignment (var = val)
    if t == AstType.Assign do
        node = hir_new(HirKind.Store, 0)
        node.name = ast_node_name(stmt)
        node.line = ast_node_line(stmt)
        n = ast_node_child_count(stmt)
        if n >= 1 do
            node.left_node = ast_to_hir_expr(ast_node_child(stmt, 0)) as i64
        end
        out node
    end

    # 4. Field Assignment (obj.field = val)
    if t == AstType.FieldAssign do
        node = hir_new(HirKind.FieldStore, 0)
        node.name = ast_node_name(stmt);  # obj name
        node.name2 = ast_node_name2(stmt); # field name
        node.line = ast_node_line(stmt)
        n = ast_node_child_count(stmt)
        if n >= 1 do
            node.left_node = ast_to_hir_expr(ast_node_child(stmt, 0)) as i64
        end
        out node
    end

    # 5. Index Assignment (arr[idx] = val)
    if t == AstType.IndexAssign do
        node = hir_new(HirKind.IndexStore, 0)
        node.name = ast_node_name(stmt)
        node.line = ast_node_line(stmt)
        n = ast_node_child_count(stmt)
        if n >= 2 do
            node.left_node = ast_to_hir_expr(ast_node_child(stmt, 0)) as i64; # index
            node.right_node = ast_to_hir_expr(ast_node_child(stmt, 1)) as i64; # val
        end
        out node
    end

    # 6. If Statement
    if t == AstType.IfStmt do
        node = hir_new(HirKind.If, 0)
        node.line = ast_node_line(stmt)
        n = ast_node_child_count(stmt)
        if n >= 2 do
            node.cond_node = ast_to_hir_expr(ast_node_child(stmt, 0)) as i64
            node.then_block = ast_to_hir_stmt(ast_node_child(stmt, 1)) as i64
            if n >= 3 do
                node.else_block = ast_to_hir_stmt(ast_node_child(stmt, 2)) as i64
            end
        end
        out node
    end

    # 7. Loop / When Statement
    if t == AstType.LoopStmt or t == AstType.WhenStmt or t == AstType.WhileStmt do
        node = hir_new(HirKind.Loop, 0)
        node.line = ast_node_line(stmt)
        n = ast_node_child_count(stmt)
        if n >= 2 do
            node.cond_node = ast_to_hir_expr(ast_node_child(stmt, 0)) as i64
            node.then_block = ast_to_hir_stmt(ast_node_child(stmt, 1)) as i64
        end
        out node
    end

    # 8. Return Statement (out / return)
    if t == AstType.ReturnStmt do
        node = hir_new(HirKind.Return, 0)
        node.line = ast_node_line(stmt)
        n = ast_node_child_count(stmt)
        if n >= 1 do
            node.left_node = ast_to_hir_expr(ast_node_child(stmt, 0)) as i64
        end
        out node
    end

    # 9. Break & Continue
    if t == AstType.BreakStmt do
        node = hir_new(HirKind.Break, 0)
        node.line = ast_node_line(stmt)
        out node
    end
    if t == AstType.ContinueStmt do
        node = hir_new(HirKind.Continue, 0)
        node.line = ast_node_line(stmt)
        out node
    end

    # 10. Print Statement
    if t == AstType.PrintStmt do
        node = hir_new(HirKind.Print, 0)
        node.line = ast_node_line(stmt)
        n = ast_node_child_count(stmt)
        if n >= 1 do
            node.left_node = ast_to_hir_expr(ast_node_child(stmt, 0)) as i64
        end
        out node
    end

    # 11. SAGA & Arena Blocks & Statements (Ensure, Revert, Try, Arena, Throw, Resume, Emit)
    if t == AstType.ArenaBlock do
        node = hir_new(HirKind.Block, 0)
        node.name = fat_str_new("__mir_arena_block")
        node.line = ast_node_line(stmt)
        n = ast_node_child_count(stmt)
        if n >= 1 do
            body_ch = ast_node_child(stmt, n - 1)
            sh = ast_to_hir_stmt(body_ch)
            if (sh as i64) != 0 do
                node = hir_add_stmt(node, sh)
            end
        end
        out node
    end

    if t == AstType.EnsureBlock do
        node = hir_new(HirKind.Block, 0)
        node.line = ast_node_line(stmt)
        m_ens = hir_new(HirKind.Call, 0)
        m_ens.name = fat_str_new("__mir_ensure")
        node = hir_add_stmt(node, m_ens)
        n = ast_node_child_count(stmt)
        if n >= 1 do
            sh = ast_to_hir_stmt(ast_node_child(stmt, 0))
            if (sh as i64) != 0 do
                node = hir_add_stmt(node, sh)
            end
        end
        out node
    end

    if t == AstType.RevertBlock do
        node = hir_new(HirKind.Block, 0)
        node.line = ast_node_line(stmt)
        m_rev = hir_new(HirKind.Call, 0)
        m_rev.name = fat_str_new("__mir_revert")
        node = hir_add_stmt(node, m_rev)
        n = ast_node_child_count(stmt)
        if n >= 1 do
            sh = ast_to_hir_stmt(ast_node_child(stmt, 0))
            if (sh as i64) != 0 do
                node = hir_add_stmt(node, sh)
            end
        end
        out node
    end

    if t == AstType.TryStmt do
        node = hir_new(HirKind.Block, 0)
        node.line = ast_node_line(stmt)
        m_try = hir_new(HirKind.Call, 0)
        m_try.name = fat_str_new("__mir_try")
        node = hir_add_stmt(node, m_try)
        n = ast_node_child_count(stmt)
        var ti = 0
        when ti < n loop
            ch = ast_node_child(stmt, ti)
            sh = ast_to_hir_stmt(ch)
            if (sh as i64) != 0 do
                node = hir_add_stmt(node, sh)
            end
            ti = ti + 1
        end
        out node
    end

    if t == AstType.ThrowStmt or t == AstType.ResumeStmt or t == AstType.EmitStmt do
        node = hir_new(HirKind.Call, 0)
        node.line = ast_node_line(stmt)
        if t == AstType.ThrowStmt do node.name = fat_str_new("__mir_throw") end
        if t == AstType.ResumeStmt do
            node.name = fat_str_new("__mir_resume")
            node.name2 = ast_node_name(stmt)
        end
        if t == AstType.EmitStmt do node.name = fat_str_new("__mir_emit") end
        n = ast_node_child_count(stmt)
        if n >= 1 do
            arg_h = ast_to_hir_expr(ast_node_child(stmt, 0))
            if (arg_h as i64) != 0 do
                node = hir_add_arg(node, arg_h)
            end
        end
        out node
    end

    # 12. Expression as Statement (Call, etc.)
    expr_h = ast_to_hir_expr(stmt)
    if (expr_h as i64) != 0 do
        out expr_h
    end

    out (0 as HirNode)
end.

func ast_to_hir_func(func_id: i64, ast_func: AstNode):
    fname = ast_node_name(ast_func)
    fname2 = ast_node_name2(ast_func)
    params = vec_new_rt()
    body_blk = hir_new(HirKind.Block, 0)
    n = ast_node_child_count(ast_func)
    if n > 0 do
        var i = 0
        var param_idx = 0
        when i < n loop
            p = ast_node_child(ast_func, i)
            pnt = ast_node_type_of(p)
            if pnt == AstType.Identifier or pnt == AstType.RefParam or pnt == AstType.ParamDef do
                p_node = hir_new(HirKind.Param, 0)
                p_node.name = ast_node_name(p)
                p_node.imm_val = param_idx
                params = vec_push_rt(params, p_node as i64)
                param_idx = param_idx + 1
            else
                sh = ast_to_hir_stmt(p)
                if (sh as i64) != 0 do
                    body_blk = hir_add_stmt(body_blk, sh)
                end
            end
            i = i + 1
        end
    end
    out hir_func_new(func_id, fname, fname2, params, body_blk)
end.

func ast_to_hir_program(prog: AstNode):
    set_global_prog_ast(prog)
    hir_funcs = vec_new_rt()
    n = ast_node_child_count(prog)
    var i = 0
    when i < n loop
        child = ast_node_child(prog, i)
        t = ast_node_type_of(child)
        if t == AstType.FuncDef or t == AstType.ExternFunc do
            hf = ast_to_hir_func(i, child)
            hir_funcs = vec_push_rt(hir_funcs, hf as i64)
        end
        i = i + 1
    end
    out hir_funcs
end.

export ast_to_hir_expr, ast_to_hir_stmt, ast_to_hir_func, ast_to_hir_program

# @vir_source stdlib/vir/compiler/pipeline.vri 20
import ast_to_hir_program from vir.compiler.ast_to_hir

# @vir_source stdlib/vir/compiler/hir_to_mir.vri 1
##
 * vir/compiler/hir_to_mir.vri — HIR to MIR Lowering (Vir v2.0)
 * =============================================================
 * Lowers canonical High-Level IR into SSA Mid-Level IR functions.
 ##

import vec_new_rt, vec_push_rt, vec_get_rt, vec_len_rt, vec_set_rt from vec_rt

import fat_str_eq, fat_str_len, fat_cstr_eq, native_read_i64, native_write_i64 from string_rt

import OpType, AstType from parser

import HirKind, HirNode, HirFunc from hir

import MirOp, MirOperandType, MirOperand, MirInstr, MirBlock, MirFunc, mir_opnd_none, mir_opnd_vreg, mir_opnd_imm, mir_create_func, mir_create_block, MIR_INTR_STR_LIT, MIR_INTR_PRINT, MIR_INTR_PRINT_STR, MIR_INTR_PARAM, MIR_INTR_BUILTIN, MIR_INTR_INDEX, MIR_INTR_FIELD, MIR_INTR_INDEX_STORE, MIR_INTR_FIELD_STORE, MIR_INTR_ARRAY, MIR_INTR_ENTITY, MIR_INTR_TUPLE from mir
import MirOp, MirOperandType, MirOperand, MirInstr, MirBlock, MirFunc, mir_opnd_none, mir_opnd_vreg, mir_opnd_imm, mir_create_func, mir_create_block, MIR_INTR_STR_LIT, MIR_INTR_PRINT, MIR_INTR_PRINT_STR, MIR_INTR_PARAM, MIR_INTR_BUILTIN, MIR_INTR_INDEX, MIR_INTR_FIELD, MIR_INTR_INDEX_STORE, MIR_INTR_FIELD_STORE, MIR_INTR_ARRAY, MIR_INTR_ENTITY, MIR_INTR_TUPLE, MIR_INTR_BIT_EXTRACT, MIR_INTR_BIT_INSERT from mir

import MirBuilder, builder_new, builder_func, builder_set_func, builder_new_vreg, builder_intern, builder_add_block, builder_set_current_block, builder_add_instr, builder_add_edge, get_var_vreg, set_var_vreg, emit_jump, emit_jump_if, emit_set_arg, emit_intrinsic, emit_move, emit_load, emit_store, find_field_index, is_entity_name, is_register_field, get_register_field_start, get_register_field_width from ast_to_mir

func hir_op_to_mirop(op: int):
    if op == 0 do out MirOp.Add end
    if op == 1 do out MirOp.Sub end
    if op == 2 do out MirOp.Mul end
    if op == 3 do out MirOp.Div end
    if op == 4 do out MirOp.Mod end
    if op == 10 do out MirOp.CmpEq end
    if op == 11 do out MirOp.CmpNe end
    if op == 12 do out MirOp.CmpGt end
    if op == 13 do out MirOp.CmpLt end
    if op == 14 do out MirOp.CmpGe end
    if op == 15 do out MirOp.CmpLe end
    if op == 20 do out MirOp.And end
    if op == 21 do out MirOp.Or end
    if op == 22 do out MirOp.Xor end
    if op == 23 do out MirOp.Shl end
    if op == 24 do out MirOp.Shr end
    if op == 25 do out MirOp.Pow end
    if op == 28 do out MirOp.MatMul end
    if op == 29 do out MirOp.Fma end
    if op == 33 do out MirOp.Mod end
    out MirOp.Add
end.

func lower_hir_expr(b: MirBuilder, node: HirNode):
    if (node as i64) == 0 do
        out (b, mir_opnd_none())
    end
    k = node.kind

    # 1. Const
    if k == HirKind.Const do
        out (b, mir_opnd_imm(node.imm_val))
    end

    # 2. String Literal
    if k == HirKind.StrLit do
        var (b1, sid) = builder_intern(b, node.name)
        var (b2, dst) = builder_new_vreg(b1)
        b2 = emit_intrinsic(b2, MIR_INTR_STR_LIT, mir_opnd_vreg(dst), mir_opnd_imm(sid))
        out (b2, mir_opnd_vreg(dst))
    end

    # 3. Variable Load
    if k == HirKind.Load do
        v = get_var_vreg(b, node.name)
        if v >= 0 do
            out (b, mir_opnd_vreg(v))
        end
        out (b, mir_opnd_none())
    end

    # 4. Binary Op
    if k == HirKind.BinOp do
        var (b1, l_opnd) = lower_hir_expr(b, node.left_node as HirNode)
        var (b2, r_opnd) = lower_hir_expr(b1, node.right_node as HirNode)
        var (b3, dst) = builder_new_vreg(b2)
        m_op = hir_op_to_mirop(node.op as int)
        ins = mir_instr_new(m_op, mir_opnd_vreg(dst), l_opnd, r_opnd)
        b3 = builder_add_instr(b3, ins)
        out (b3, mir_opnd_vreg(dst))
    end

    # 5. Unary Op
    if k == HirKind.UnaryOp do
        var (b1, child_opnd) = lower_hir_expr(b, node.left_node as HirNode)
        var (b2, dst) = builder_new_vreg(b1)
        if node.op == 25 do
            b2 = emit_intrinsic(b2, MIR_INTR_ADDR_OF, mir_opnd_vreg(dst), child_opnd)
            out (b2, mir_opnd_vreg(dst))
        end
        if node.op == 27 do
            ins = mir_instr_new(MirOp.Not, mir_opnd_vreg(dst), child_opnd, mir_opnd_none())
            b2 = builder_add_instr(b2, ins)
            out (b2, mir_opnd_vreg(dst))
        end
        ins = mir_instr_new(MirOp.Sub, mir_opnd_vreg(dst), mir_opnd_imm(0), child_opnd)
        b2 = builder_add_instr(b2, ins)
        out (b2, mir_opnd_vreg(dst))
    end

    # 6. Function Call & Builtin Call
    if k == HirKind.Call or k == HirKind.BuiltinCall do
        n = vec_len_rt(node.args)
        if (fat_cstr_eq(node.name, "str_len") == 1 or fat_cstr_eq(node.name, "fat_str_len") == 1 or fat_cstr_eq(node.name, "rt_strlen") == 1) and n >= 1 do
            arg0 = vec_get_rt(node.args, 0) as HirNode
            if arg0.kind == HirKind.StrLit do
                slen = fat_str_len(arg0.name)
                out (b, mir_opnd_imm(slen))
            end
        end
        b_mut = b
        staged = vec_new_rt()
        var i = 0
        when i < n loop
            arg_h = vec_get_rt(node.args, i) as HirNode
            var (b_next, arg_opnd) = lower_hir_expr(b_mut, arg_h)
            var (b_stage, tv) = builder_new_vreg(b_next)
            b_stage = emit_move(b_stage, tv, arg_opnd)
            staged = vec_push_rt(staged, tv)
            b_mut = b_stage
            i = i + 1
        end
        var j = 0
        when j < vec_len_rt(staged) loop
            tv = vec_get_rt(staged, j)
            b_mut = emit_set_arg(b_mut, j, mir_opnd_vreg(tv))
            j = j + 1
        end
        if fat_cstr_eq(node.name, "__mir_throw") == 1 do
            var (b2, dst) = builder_new_vreg(b_mut)
            if n > 0 do
                tv0 = vec_get_rt(staged, 0)
                b_mut = emit_intrinsic(b_mut, MIR_INTR_THROW, mir_opnd_none(), mir_opnd_vreg(tv0))
            else
                b_mut = emit_intrinsic(b_mut, MIR_INTR_THROW, mir_opnd_none(), mir_opnd_none())
            end
            out (b_mut, mir_opnd_vreg(dst))
        end
        if fat_cstr_eq(node.name, "__mir_resume") == 1 do
            var (b1, rid) = builder_intern(b_mut, node.name2)
            var (b2, dst) = builder_new_vreg(b1)
            b2 = emit_intrinsic(b2, MIR_INTR_RESUME, mir_opnd_none(), mir_opnd_imm(rid))
            out (b2, mir_opnd_vreg(dst))
        end
        if fat_cstr_eq(node.name, "__mir_emit") == 1 do
            var (b2, dst) = builder_new_vreg(b_mut)
            if n > 0 do
                tv0 = vec_get_rt(staged, 0)
                b_mut = emit_intrinsic(b_mut, MIR_INTR_EMIT, mir_opnd_none(), mir_opnd_vreg(tv0))
            else
                b_mut = emit_intrinsic(b_mut, MIR_INTR_EMIT, mir_opnd_none(), mir_opnd_none())
            end
            out (b_mut, mir_opnd_vreg(dst))
        end
        if fat_cstr_eq(node.name, "__mir_ensure") == 1 do
            var (b2, dst) = builder_new_vreg(b_mut)
            b2 = emit_intrinsic(b2, MIR_INTR_ENSURE, mir_opnd_none(), mir_opnd_none())
            out (b2, mir_opnd_vreg(dst))
        end
        if fat_cstr_eq(node.name, "__mir_revert") == 1 do
            var (b2, dst) = builder_new_vreg(b_mut)
            b2 = emit_intrinsic(b2, MIR_INTR_REVERT, mir_opnd_none(), mir_opnd_none())
            out (b2, mir_opnd_vreg(dst))
        end
        if fat_cstr_eq(node.name, "__mir_try") == 1 do
            var (b2, dst) = builder_new_vreg(b_mut)
            b2 = emit_intrinsic(b2, MIR_INTR_TRY, mir_opnd_none(), mir_opnd_none())
            out (b2, mir_opnd_vreg(dst))
        end
        if fat_cstr_eq(node.name, "__mir_arena_enter") == 1 do
            var (b2, mark_vreg) = builder_new_vreg(b_mut)
            b2 = emit_intrinsic(b2, MIR_INTR_ARENA, mir_opnd_vreg(mark_vreg), mir_opnd_none())
            out (b2, mir_opnd_vreg(mark_vreg))
        end
        if fat_cstr_eq(node.name, "__mir_arena_exit") == 1 do
            var (b2, dst) = builder_new_vreg(b_mut)
            b2 = emit_intrinsic(b2, MIR_INTR_ARENA, mir_opnd_none(), mir_opnd_none())
            out (b2, mir_opnd_vreg(dst))
        end
        if k == HirKind.BuiltinCall do
            var (b2, dst) = builder_new_vreg(b_mut)
            b2 = emit_intrinsic(b2, MIR_INTR_BUILTIN, mir_opnd_vreg(dst), mir_opnd_imm(node.imm_val))
            out (b2, mir_opnd_vreg(dst))
        else
            # Positional entity construction: `Ent(v0, v1, ...)` parses as a Call,
            # but if the callee names an entity type, lower it as an aggregate.
            if is_entity_name(node.name) == 1 do
                var (b_ent, tid) = builder_intern(b_mut, node.name)
                b_ent = emit_set_arg(b_ent, n, mir_opnd_imm(tid))
                var (b_e2, edst) = builder_new_vreg(b_ent)
                b_e2 = emit_intrinsic(b_e2, MIR_INTR_ENTITY, mir_opnd_vreg(edst), mir_opnd_imm(n))
                out (b_e2, mir_opnd_vreg(edst))
            end
            var (b1, sid) = builder_intern(b_mut, node.name)
            var (b2, dst) = builder_new_vreg(b1)
            ins = mir_instr_new(MirOp.Call, mir_opnd_vreg(dst), mir_opnd_imm(n), mir_opnd_imm(sid))
            b2 = builder_add_instr(b2, ins)
            out (b2, mir_opnd_vreg(dst))
        end
    end

    # 7. Field Access
    if k == HirKind.FieldAccess do
        var (b1, base) = lower_hir_expr(b, node.left_node as HirNode)
        fname = node.name
        if is_register_field(fname) == 1 do
            start_bit = get_register_field_start(fname)
            width = get_register_field_width(fname)
            var (b2, dst) = builder_new_vreg(b1)
            let pack_info = MIR_INTR_BIT_EXTRACT or (start_bit shl 8) or (width shl 16)
            ins = mir_instr_new(MirOp.Intrinsic, mir_opnd_vreg(dst), base, mir_opnd_imm(pack_info))
            b2 = builder_add_instr(b2, ins)
            out (b2, mir_opnd_vreg(dst))
        end
        var (b2, dst) = builder_new_vreg(b1)
        fid = find_field_index(fname)
        b2 = emit_set_arg(b2, 0, mir_opnd_imm(fid))
        b2 = emit_intrinsic(b2, MIR_INTR_FIELD, mir_opnd_vreg(dst), base)
        out (b2, mir_opnd_vreg(dst))
    end

    # 8. Index Access
    if k == HirKind.IndexAccess do
        b1 = b
        base = mir_opnd_none()
        if (node.left_node as i64) != 0 do
            var (b_l, base_opnd) = lower_hir_expr(b, node.left_node as HirNode)
            b1 = b_l
            base = base_opnd
        else
            bv = get_var_vreg(b, node.name)
            if bv >= 0 do
                base = mir_opnd_vreg(bv)
            end
        end
        var (b2, idx) = lower_hir_expr(b1, node.right_node as HirNode)
        var (b3, dst) = builder_new_vreg(b2)
        b3 = emit_set_arg(b3, 0, idx)
        b3 = emit_intrinsic(b3, MIR_INTR_INDEX, mir_opnd_vreg(dst), base)
        out (b3, mir_opnd_vreg(dst))
    end

    # 9. Aggregate (Entity, Array, Tuple)
    if k == HirKind.Aggregate do
        n = vec_len_rt(node.args)
        b_mut = b
        var i = 0
        when i < n loop
            elem_h = vec_get_rt(node.args, i) as HirNode
            var (b_next, elem_opnd) = lower_hir_expr(b_mut, elem_h)
            b_mut = emit_set_arg(b_next, i, elem_opnd)
            i = i + 1
        end
        var (b1, dst) = builder_new_vreg(b_mut)
        intr_kind = MIR_INTR_ARRAY
        if node.imm_val == (AstType.EntityLiteral as i64) do
            intr_kind = MIR_INTR_ENTITY
            var (b_ent, tid) = builder_intern(b1, node.name)
            b1 = emit_set_arg(b_ent, n, mir_opnd_imm(tid))
        eif node.imm_val == (AstType.TupleExpr as i64) do
            intr_kind = MIR_INTR_TUPLE
        end
        b1 = emit_intrinsic(b1, intr_kind, mir_opnd_vreg(dst), mir_opnd_imm(n))
        out (b1, mir_opnd_vreg(dst))
    end

    out (b, mir_opnd_none())
end.

func lower_hir_stmt(b: MirBuilder, node: HirNode):
    if (node as i64) == 0 do
        out b
    end
    k = node.kind

    # 1. Block
    if k == HirKind.Block do
        if fat_cstr_eq(node.name, "__mir_arena_block") == 1 do
            var (b_mark, mark_vreg) = builder_new_vreg(b)
            b_mark = emit_intrinsic(b_mark, MIR_INTR_ARENA, mir_opnd_vreg(mark_vreg), mir_opnd_none())
            n = vec_len_rt(node.body)
            b_mut = b_mark
            var i = 0
            when i < n loop
                s_h = vec_get_rt(node.body, i) as HirNode
                b_mut = lower_hir_stmt(b_mut, s_h)
                i = i + 1
            end
            out emit_intrinsic(b_mut, MIR_INTR_ARENA, mir_opnd_none(), mir_opnd_vreg(mark_vreg))
        end
        n = vec_len_rt(node.body)
        b_mut = b
        var i = 0
        when i < n loop
            s_h = vec_get_rt(node.body, i) as HirNode
            b_mut = lower_hir_stmt(b_mut, s_h)
            i = i + 1
        end
        out b_mut
    end

    # 2. Variable Declaration
    if k == HirKind.VarDecl do
        var (b1, val_opnd) = lower_hir_expr(b, node.left_node as HirNode)
        var (b2, dst) = builder_new_vreg(b1)
        b2 = emit_move(b2, dst, val_opnd)
        out set_var_vreg(b2, node.name, dst)
    end

    # Assignment must update the existing vreg when one is already bound.
    # The loop header has already captured that vreg, so allocating a fresh
    # one here leaves its condition permanently stale.
    if k == HirKind.Store do
        var (b1, val_opnd) = lower_hir_expr(b, node.left_node as HirNode)
        let existing = get_var_vreg(b1, node.name)
        if existing >= 0 do
            out emit_move(b1, existing, val_opnd)
        end
        var (b2, dst) = builder_new_vreg(b1)
        b2 = emit_move(b2, dst, val_opnd)
        out set_var_vreg(b2, node.name, dst)
    end

    # 3. Field Store (obj.field = val)
    if k == HirKind.FieldStore do
        bv = get_var_vreg(b, node.name)
        var (b1, val_opnd) = lower_hir_expr(b, node.left_node as HirNode)
        fname = node.name2
        if is_register_field(fname) == 1 and bv >= 0 do
            start_bit = get_register_field_start(fname)
            width = get_register_field_width(fname)
            let pack_info = MIR_INTR_BIT_INSERT or (start_bit shl 8) or (width shl 16)
            b1 = emit_set_arg(b1, 0, val_opnd)
            var (b2, new_vreg) = builder_new_vreg(b1)
            ins = mir_instr_new(MirOp.Intrinsic, mir_opnd_vreg(new_vreg), mir_opnd_vreg(bv), mir_opnd_imm(pack_info))
            b2 = builder_add_instr(b2, ins)
            out set_var_vreg(b2, node.name, new_vreg)
        end
        if bv >= 0 do
            fid = find_field_index(fname)
            b1 = emit_set_arg(b1, 0, mir_opnd_imm(fid))
            b1 = emit_set_arg(b1, 1, val_opnd)
            b1 = emit_intrinsic(b1, MIR_INTR_FIELD_STORE, mir_opnd_none(), mir_opnd_vreg(bv))
        end
        out b1
    end

    # 4. Index Store (arr[idx] = val)
    if k == HirKind.IndexStore do
        bv = get_var_vreg(b, node.name)
        var (b1, idx_opnd) = lower_hir_expr(b, node.left_node as HirNode)
        var (b2, val_opnd) = lower_hir_expr(b1, node.right_node as HirNode)
        if bv >= 0 do
            b2 = emit_set_arg(b2, 0, idx_opnd)
            b2 = emit_set_arg(b2, 1, val_opnd)
            b2 = emit_intrinsic(b2, MIR_INTR_INDEX_STORE, mir_opnd_none(), mir_opnd_vreg(bv))
        end
        out b2
    end

    # 5. If Statement
    if k == HirKind.If do
        var (b1, cond_opnd) = lower_hir_expr(b, node.cond_node as HirNode)
        has_else = (node.else_block as i64) != 0
        var (b2, then_id) = builder_add_block(b1)
        var else_id = 0
        var b3 = b2
        if has_else do
            var (b3_2, else_id_2) = builder_add_block(b2)
            b3 = b3_2
            else_id = else_id_2
        end
        var (b4, end_id) = builder_add_block(b3)
        if has_else == false do
            else_id = end_id
        end
        b4 = emit_jump_if(b4, cond_opnd, then_id, else_id)
        b4 = builder_set_current_block(b4, then_id)
        b4 = lower_hir_stmt(b4, node.then_block as HirNode)
        b4 = emit_jump(b4, end_id)
        if has_else do
            b4 = builder_set_current_block(b4, else_id)
            b4 = lower_hir_stmt(b4, node.else_block as HirNode)
            b4 = emit_jump(b4, end_id)
        end
        out builder_set_current_block(b4, end_id)
    end

    # 6. Loop Statement
    if k == HirKind.Loop do
        var (b1, header_id) = builder_add_block(b)
        var (b2, body_id) = builder_add_block(b1)
        var (b3, end_id) = builder_add_block(b2)
        b3 = emit_jump(b3, header_id)
        b3 = builder_set_current_block(b3, header_id)
        var (b4, cond_opnd) = lower_hir_expr(b3, node.cond_node as HirNode)
        b4 = emit_jump_if(b4, cond_opnd, body_id, end_id)
        b4 = builder_set_current_block(b4, body_id)
        b4 = lower_hir_stmt(b4, node.then_block as HirNode)
        b4 = emit_jump(b4, header_id)
        out builder_set_current_block(b4, end_id)
    end

    # 7. Return Statement
    if k == HirKind.Return do
        var (b1, val_opnd) = lower_hir_expr(b, node.left_node as HirNode)
        ins = mir_instr_new(MirOp.Return, mir_opnd_none(), val_opnd, mir_opnd_none())
        out builder_add_instr(b1, ins)
    end

    # 8. Print Statement
    if k == HirKind.Print do
        child_h = node.left_node as HirNode
        var (b1, val_opnd) = lower_hir_expr(b, child_h)
        if (child_h as i64) != 0 do
            if child_h.kind == HirKind.StrLit do
                out emit_intrinsic(b1, MIR_INTR_PRINT_STR, mir_opnd_none(), val_opnd)
            end
        end
        out emit_intrinsic(b1, MIR_INTR_PRINT, mir_opnd_none(), val_opnd)
    end

    # 9. Expression as Statement
    var (b_expr, _) = lower_hir_expr(b, node)
    out b_expr
end.

func hir_lower_func(hfunc: HirFunc):
    b = builder_new(hfunc.id as int, hfunc.name)
    # Bind ABI parameters X0..Xn
    pn = vec_len_rt(hfunc.params)
    var pi = 0
    when pi < pn loop
        param = vec_get_rt(hfunc.params, pi) as HirNode
        var (b2, pv) = builder_new_vreg(b)
        b2 = emit_intrinsic(b2, MIR_INTR_PARAM, mir_opnd_vreg(pv), mir_opnd_imm(pi))
        b = set_var_vreg(b2, param.name, pv)
        pi = pi + 1
    end
    b = lower_hir_stmt(b, hfunc.body)
    f = builder_func(b)
    vc = native_read_i64(b as i64, 8)
    native_write_i64(f as i64, 16, vc)
    out f
end.

func hir_to_mir_program(hir_funcs: i64):
    mir_funcs = vec_new_rt()
    n = vec_len_rt(hir_funcs)
    var i = 0
    when i < n loop
        hf = vec_get_rt(hir_funcs, i) as HirFunc
        mf = hir_lower_func(hf)
        mir_funcs = vec_push_rt(mir_funcs, mf as i64)
        i = i + 1
    end
    out mir_funcs
end.

export lower_hir_expr, lower_hir_stmt, hir_lower_func, hir_to_mir_program

