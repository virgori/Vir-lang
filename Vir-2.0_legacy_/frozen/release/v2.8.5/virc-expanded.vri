end.

func arm64_sev(cb: CodeBuf):
    out codebuf_emit_u32(cb, 0xD503209F)
end.

func arm64_clz(cb: CodeBuf, rd: int, rn: int):
    out codebuf_emit_u32(cb, 0xDAC01000 or ((rn and 0x1F)  shl  5) or (rd and 0x1F))
end.

func arm64_rbit(cb: CodeBuf, rd: int, rn: int):
    out codebuf_emit_u32(cb, 0xDAC00000 or ((rn and 0x1F)  shl  5) or (rd and 0x1F))
end.

func arm64_rev(cb: CodeBuf, rd: int, rn: int):
    out codebuf_emit_u32(cb, 0xDAC00C00 or ((rn and 0x1F)  shl  5) or (rd and 0x1F))
end.

func arm64_brk(cb: CodeBuf, imm16: int):
    out codebuf_emit_u32(cb, 0xD4200000 or ((imm16 and 0xFFFF)  shl  5))
end.

# ── ARM64 128-Bit NEON SIMD Instructions ──
func arm64_ldr_q_reg(cb: CodeBuf, qt: int, xn: int, xm: int):
    out codebuf_emit_u32(cb, 0x3CE06800 or ((xm and 0x1F)  shl  16) or ((xn and 0x1F)  shl  5) or (qt and 0x1F))
end.

func arm64_str_q_reg(cb: CodeBuf, qt: int, xn: int, xm: int):
