# @vir_source stdlib/vir/compiler/sem_pass1_modules.vri 1
##
 * vir/compiler/sem_pass1_modules.vri
 * ==============================================================
 * Pass 1: Module Collection & Import Resolution.
 * Walks top-level statements for ModuleStmt, ImportStmt, ExportStmt, IncludeStmt.
 * Registers module namespaces and imported symbols into scope.
 ##

import vec_new_rt, vec_push_rt, vec_get_rt, vec_len_rt from vec_rt

import rt_streq, fat_str_eq, fat_str_len, fat_cstr_eq, fat_str_eq, fat_str_len, fat_cstr_eq, rt_strcat, rt_itoa, rt_strlen from string_rt

import AstNode, AstType from parser

import SymbolTable, SymbolKind, SymbolNode, symbol_alloc from symbol_table

import ScopeTree, ScopeKind, ScopeNode, scope_push, scope_pop, scope_add_symbol from scope_tree


# @vir_source stdlib/vir/compiler/sem_pass1_modules.vri 25
import DiagnosticEngine, report_error from context

func pass1_collect_modules(symbols: SymbolTable, scopes: ScopeTree, diag: DiagnosticEngine, node: AstNode):
    pass1_walk(symbols, scopes, diag, node)
end.
func pass1_walk(symbols: SymbolTable, scopes: ScopeTree, diag: DiagnosticEngine, node: AstNode):

    # ModuleStmt (19)
    if node.node_type == AstType.ModuleStmt do
        if fat_str_len(node.name) > 0 do
            pass1_register_module_symbol(symbols, scopes, diag, node.name, node.line)
        end
        out 0
    end

    # ImportStmt (18)
    if node.node_type == AstType.ImportStmt do
        # Case A: import X, Y from MOD
        child_count = vec_len_rt(node.children)
        if child_count > 0 do
            var i = 0
            when i < child_count loop
                sym_child = vec_get_rt(node.children, i)
                var sym_name = sym_child.name
                if fat_str_len(sym_child.name2) > 0 do
                    sym_name = sym_child.name2
                end
                if fat_str_len(sym_name) > 0 do
                    pass1_register_imported_symbol(symbols, scopes, diag, sym_name, sym_child.line)
                end
                i = i + 1
            end
        else
            # Case B: import MOD as ALIAS (or simple import MOD)
            target_name = node.name
            if fat_str_len(node.name2) > 0 do
                target_name = node.name2
            end
            if fat_str_len(target_name) > 0 do
                pass1_register_imported_symbol(symbols, scopes, diag, target_name, node.line)
            end
        end
        out 0
    end

    # ExportStmt (20)
    if node.node_type == AstType.ExportStmt do
        out 0
    end

    # IncludeStmt (21)
    if node.node_type == AstType.IncludeStmt do
        target_name = node.name
        if fat_str_len(node.name2) > 0 do
            target_name = node.name2
        end
        if fat_str_len(target_name) > 0 do
            pass1_register_imported_symbol(symbols, scopes, diag, target_name, node.line)
        end
        out 0
    end

    # Recurse into program/block children
    child_count = vec_len_rt(node.children)
    var i = 0
    when i < child_count loop
        child = vec_get_rt(node.children, i)
        pass1_walk(symbols, scopes, diag, child)
        i = i + 1
    end
    out 0
end.
func pass1_register_module_symbol(symbols: SymbolTable, scopes: ScopeTree, diag: DiagnosticEngine, name: string, line: int):
    sym = SymbolNode (
        kind: SymbolKind.Module,
        name_id: name as i64,
        type_id: 0,
        scope_id: scopes.current_id,
        ast_id: 0,
        is_mutable: false,
        offset: 0,
        param_count: 0,
        return_type: 0,
        parent_id: -1
    )
    sym_id = symbol_alloc(symbols, sym)
    scope_add_symbol(scopes, scopes.current_id, sym_id)
    out sym_id
end.
func pass1_register_imported_symbol(symbols: SymbolTable, scopes: ScopeTree, diag: DiagnosticEngine, name: string, line: int):
    sym = SymbolNode (
        kind: SymbolKind.Variable,
        name_id: name as i64,
        type_id: 0,
        scope_id: scopes.current_id,
        ast_id: 0,
        is_mutable: true,
        offset: 0,
        param_count: 0,
        return_type: 0,
        parent_id: -1
    )
    sym_id = symbol_alloc(symbols, sym)
    scope_add_symbol(scopes, scopes.current_id, sym_id)
    out sym_id
end.

export pass1_collect_modules

# @vir_source stdlib/vir/compiler/semantic.vri 37
import pass1_collect_modules from compiler.sem_pass1_modules

# @vir_source stdlib/vir/compiler/sem_pass2_symbols.vri 1
##
 * vir/compiler/sem_pass2_symbols.vri
 * ==============================================================
 * Pass 2: Symbol Registration (Vir v2.0 Complete).
 * Walks the top-level AST and registers all functions, entities,
 * packed/register structs, enums, variables, constants, and builtins.
 ##

import vec_new_rt, vec_push_rt, vec_get_rt, vec_len_rt, vec_set_rt from vec_rt

import fat_str_new, rt_streq, fat_str_eq, fat_str_len, fat_str_byte_at, fat_cstr_eq, rt_strcat, rt_itoa, rt_strlen, str_from_cstr from string_rt

import AstNode, AstType from parser

import SymbolTable, SymbolKind, SymbolNode, symbol_alloc, symbol_lookup_in_scope from compiler.symbol_table

import ScopeTree, ScopeKind, ScopeNode, scope_push, scope_pop, scope_add_symbol, scope_current_id from compiler.scope_tree

import DiagnosticEngine, report_error from compiler.context

# Per-scope name → sym_id hash (avg O(1) insert/lookup).  Avoids O(n²)
# fat_str_eq scans when registering N symbols into the same scope.
const PASS2_BUCKETS: int = 256
var g_pass2_scope_maps: i64 = 0

func pass2_hash_name(name: string):
    n = fat_str_len(name)
    h = n * 17
    var i = 0
    when i < n loop
        h = h * 131 + fat_str_byte_at(name, i)
        i = i + 1
    end
    if h < 0 do
        h = 0 - h
    end
    out h mod PASS2_BUCKETS
end.

func pass2_maps_reset():
    g_pass2_scope_maps = vec_new_rt()
end.

func pass2_scope_map_new():
    buckets = vec_new_rt()
    var bi = 0
    when bi < PASS2_BUCKETS loop
        buckets = vec_push_rt(buckets, vec_new_rt())
        bi = bi + 1
    end
    out buckets
end.

func pass2_ensure_scope_map(scope_id: int):
    if g_pass2_scope_maps == 0 do
        pass2_maps_reset()
    end
    when vec_len_rt(g_pass2_scope_maps) <= scope_id loop
        g_pass2_scope_maps = vec_push_rt(g_pass2_scope_maps, pass2_scope_map_new())
    end
end.

func pass2_index_symbol(scope_id: int, name: string, sym_id: int):
    if fat_str_len(name) == 0 do
        out 0
    end
    pass2_ensure_scope_map(scope_id)
    buckets = vec_get_rt(g_pass2_scope_maps, scope_id)
    bid = pass2_hash_name(name)
    bucket = vec_get_rt(buckets, bid)
    bucket = vec_push_rt(bucket, sym_id)
    vec_set_rt(buckets, bid, bucket)
    out 0
end.

func pass2_register_symbols(symbols: SymbolTable, scopes: ScopeTree, diag: DiagnosticEngine, node: AstNode):
    pass2_maps_reset()
    # 1. Register builtin symbols into global scope
    pass2_register_builtins(symbols, scopes)

    # 2. Walk AST for declarations
    pass2_walk_node(symbols, scopes, diag, node)
end.
func pass2_register_builtins(symbols: SymbolTable, scopes: ScopeTree):
    pass2_register_builtin_one(symbols, scopes, fat_str_new("len"), 1)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("push"), 2)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("alloc"), 1)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("dealloc"), 1)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("free"), 1)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("read_byte"), 2)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("read_u8"), 2)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("read8"), 2)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("native_read_u8"), 2)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("write_byte"), 3)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("write_u8"), 3)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("write8"), 3)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("native_write_u8"), 3)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("read_word"), 2)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("read_i64"), 2)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("read64"), 2)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("native_read_i64"), 2)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("write_word"), 3)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("write_i64"), 3)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("write64"), 3)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("native_write_i64"), 3)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("memset"), 3)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("fill_bytes"), 3)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("native_mem_set"), 3)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("memcpy"), 3)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("__memcpy"), 3)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("native_mem_copy"), 3)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("str_len"), 1)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("str_get"), 2)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("str_cat"), 2)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("str_concat"), 2)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("str_eq"), 2)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("file_open"), 2)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("native_file_open"), 2)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("file_read"), 3)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("native_file_read"), 3)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("file_write"), 3)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("native_file_write"), 3)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("file_close"), 1)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("native_file_close"), 1)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("file_write_byte"), 2)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("slurp_file"), 3)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("slurp_len"), 1)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("write_bytes"), 3)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("exit"), 1)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("exit_prog"), 1)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("i_to_str"), 1)
