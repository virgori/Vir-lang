import vec_new_rt, vec_push_rt, vec_get_rt, vec_set_rt, vec_len_rt from vec_rt

# @vir_source stdlib/vir/compiler/mir_cfg.vri 12
import MirBlock, mir_block_successors, mir_block_preds, mir_block_replace_preds, mir_block_reset_cfg, mir_block_idom, mir_block_replace_idom, mir_block_dom_children, mir_block_replace_dom_children, mir_block_df, mir_block_replace_df from mir

func mir_build_cfg(blocks: i64):
    n_blocks = vec_len_rt(blocks)

    # 1. Reuse CFG metadata vectors in place. Constructing fresh vectors as
    # nested call arguments leaves arena-scoped pointers inside the block.
    var i = 0
    when i < n_blocks loop
        b = vec_get_rt(blocks, i)
        mir_block_reset_cfg(b)
        i = i + 1
    end

    # 2. Add predecessors from successors Vec
    i = 0
    when i < n_blocks loop
        b = vec_get_rt(blocks, i)
        succs = mir_block_successors(b)
        if succs >= 0 do
            ns = vec_len_rt(succs)
            var s = 0
            when s < ns loop
                succ_idx = vec_get_rt(succs, s)
                if succ_idx >= 0 and succ_idx < n_blocks do
                    sb = vec_get_rt(blocks, succ_idx)
                    new_preds = vec_push_rt(mir_block_preds(sb), i)
                    mir_block_replace_preds(sb, new_preds)
                end
                s = s + 1
            end
        end
        i = i + 1
    end
    out blocks
end.

func intersect_idom_chains(idoms: i64, left: i64, right: i64, marks: i64, epoch: i64, n_blocks: i64):
    x = left
    var steps = 0
    when x >= 0 and x < n_blocks and steps < n_blocks loop
        vec_set_rt(marks, x, epoch)
        parent = vec_get_rt(idoms, x)
        if parent < 0 or parent == x do
            steps = n_blocks
        else
            x = parent
            steps = steps + 1
        end
    end

    y = right
    steps = 0
    when y >= 0 and y < n_blocks and steps < n_blocks loop
        if vec_get_rt(marks, y) == epoch do out y end
        parent = vec_get_rt(idoms, y)
        if parent < 0 or parent == y do
            steps = n_blocks
        else
            y = parent
            steps = steps + 1
        end
    end
    out 0 - 1
end.

func mir_compute_dominators(blocks: i64, entry_idx: i64):
    n_blocks = vec_len_rt(blocks)
    if n_blocks == 0 do out blocks end

    # Direct idom fixed point. This avoids the old n*n dominance matrix,
    # repeated set intersections, and cubic immediate-dominator search.
    idoms = vec_new_rt()
    marks = vec_new_rt()
    var i = 0
    when i < n_blocks loop
        idoms = vec_push_rt(idoms, 0 - 1)
        marks = vec_push_rt(marks, 0)
        i = i + 1
    end
    vec_set_rt(idoms, entry_idx, entry_idx)

    changed = true
    var iter = 0
    var epoch = 0
    when changed and iter < n_blocks * 2 loop
        changed = false
        iter = iter + 1
        i = 0
        when i < n_blocks loop
            if i != entry_idx do
                b = vec_get_rt(blocks, i)
                preds = mir_block_preds(b)
                candidate = 0 - 1
                var p = 0
                when p < vec_len_rt(preds) loop
                    pred_idx = vec_get_rt(preds, p)
                    if pred_idx >= 0 and pred_idx < n_blocks do
                        if vec_get_rt(idoms, pred_idx) >= 0 do
                            if candidate < 0 do
                                candidate = pred_idx
                            else
                                epoch = epoch + 1
                                candidate = intersect_idom_chains(idoms, candidate, pred_idx, marks, epoch, n_blocks)
                            end
                        end
                    end
                    p = p + 1
                end
                if candidate >= 0 and candidate != vec_get_rt(idoms, i) do
                    vec_set_rt(idoms, i, candidate)
                    changed = true
                end
            end
            i = i + 1
        end
    end

    i = 0
    when i < n_blocks loop
        b = vec_get_rt(blocks, i)
        idom_idx = vec_get_rt(idoms, i)
        mir_block_replace_idom(b, idom_idx)
        if i != entry_idx and idom_idx >= 0 do
            idom_block = vec_get_rt(blocks, idom_idx)
            idom_children = vec_push_rt(mir_block_dom_children(idom_block), i)
            mir_block_replace_dom_children(idom_block, idom_children)
        end
        i = i + 1
    end

    i = 0
    when i < n_blocks loop
        b = vec_get_rt(blocks, i)
        b_preds = mir_block_preds(b)
        if vec_len_rt(b_preds) >= 2 do
            var p = 0
            when p < vec_len_rt(b_preds) loop
                runner = vec_get_rt(b_preds, p)
                var step = 0
                when runner >= 0 and runner != mir_block_idom(b) and step < n_blocks loop
                    r_block = vec_get_rt(blocks, runner)
                    r_df = mir_block_df(r_block)
                    exists = false
                    df_len = vec_len_rt(r_df)
                    var df_idx = 0
                    when df_idx < df_len loop
                        if vec_get_rt(r_df, df_idx) == i do
                            exists = true
                        end
                        df_idx = df_idx + 1
                    end
                    if not exists do
                        new_df = vec_push_rt(r_df, i)
                        mir_block_replace_df(r_block, new_df)
                    end
                    runner = mir_block_idom(r_block)
                    step = step + 1
                end
                p = p + 1
            end
        end
        i = i + 1
    end
    out blocks
end.

export mir_build_cfg, mir_compute_dominators

# @vir_source stdlib/vir/compiler/virc.vri 58
# @vir_source stdlib/vir/compiler/mir_ssa.vri 1
##
 * vir/compiler/mir_ssa.vri — SSA Construction & Variable Renaming
 * ==============================================================
 * Inserts Phi nodes and renames variables to guarantee
 * Static Single Assignment form (Cytron-style rename over idom tree).
 ##

import vec_new_rt, vec_push_rt, vec_get_rt, vec_set_rt, vec_len_rt, vec_pop_rt from vec_rt
import MirOp, MirOperandType, MirOperand, MirPhi, MirBlock, MirFunc, MirInstr, mir_opnd_none, mir_opnd_vreg, mir_instr_new, mir_phi_new, mir_block_new, mir_func_new, mir_instr_op, mir_instr_dst, mir_instr_src1, mir_instr_src2, mir_block_id, mir_block_head, mir_block_tail, mir_block_successors, mir_block_preds, mir_block_idom, mir_block_dom_children, mir_block_df, mir_block_next_block, mir_block_phis, mir_phi_dst, mir_phi_orig_vreg, mir_phi_incoming_blocks, mir_phi_incoming_values, mir_opnd_type, mir_opnd_vreg_id, mir_func_id, mir_func_name, mir_func_next_vreg, mir_func_def_uses, mir_func_next_block_id, mir_func_entry_block, mir_func_blocks, mir_func_strings, mir_func_var_buckets from mir
import MirOp, MirOperandType, MirOperand, MirPhi, MirBlock, MirFunc, MirInstr, mir_opnd_none, mir_opnd_vreg, mir_instr_new, mir_phi_new, mir_block_new, mir_func_new, mir_instr_op, mir_instr_dst, mir_instr_src1, mir_instr_src2, mir_instr_aux, mir_instr_set_aux, mir_block_id, mir_block_head, mir_block_tail, mir_block_successors, mir_block_preds, mir_block_idom, mir_block_dom_children, mir_block_df, mir_block_next_block, mir_block_phis, mir_phi_dst, mir_phi_orig_vreg, mir_phi_incoming_blocks, mir_phi_incoming_values, mir_opnd_type, mir_opnd_vreg_id, mir_func_id, mir_func_name, mir_func_next_vreg, mir_func_def_uses, mir_func_next_block_id, mir_func_entry_block, mir_func_blocks, mir_func_strings, mir_func_var_buckets from mir
import MirOp, MirOperandType, MirOperand, MirPhi, MirBlock, MirFunc, MirInstr, mir_opnd_none, mir_opnd_vreg, mir_instr_new, mir_phi_new, mir_block_new, mir_func_new, mir_instr_op, mir_instr_dst, mir_instr_src1, mir_instr_src2, mir_instr_aux, mir_instr_set_aux, mir_instr_type, mir_instr_set_type, mir_block_id, mir_block_head, mir_block_tail, mir_block_successors, mir_block_preds, mir_block_idom, mir_block_dom_children, mir_block_df, mir_block_next_block, mir_block_phis, mir_phi_dst, mir_phi_orig_vreg, mir_phi_incoming_blocks, mir_phi_incoming_values, mir_opnd_type, mir_opnd_vreg_id, mir_func_id, mir_func_name, mir_func_next_vreg, mir_func_def_uses, mir_func_next_block_id, mir_func_entry_block, mir_func_blocks, mir_func_strings, mir_func_var_buckets from mir

func find_max_vreg(func_obj: MirFunc, blocks: i64):
    max_vreg = 0
    n_blocks = vec_len_rt(blocks)
    var i = 0
    when i < n_blocks loop
        b = vec_get_rt(blocks, i)
        instrs = mir_block_head(b)
        if instrs >= 0 do
            n_instrs = vec_len_rt(instrs)
            var j = 0
            when j < n_instrs loop
                ins = vec_get_rt(instrs, j)
                d = mir_instr_dst(ins)
                s1 = mir_instr_src1(ins)
                s2 = mir_instr_src2(ins)
                if mir_opnd_type(d) == MirOperandType.VReg and mir_opnd_vreg_id(d) > max_vreg do
                    max_vreg = mir_opnd_vreg_id(d)
                end
                if mir_opnd_type(s1) == MirOperandType.VReg and mir_opnd_vreg_id(s1) > max_vreg do
                    max_vreg = mir_opnd_vreg_id(s1)
                end
                if mir_opnd_type(s2) == MirOperandType.VReg and mir_opnd_vreg_id(s2) > max_vreg do
                    max_vreg = mir_opnd_vreg_id(s2)
                end
                j = j + 1
            end
        end
        b_phis = mir_block_phis(b)
        if b_phis >= 0 do
            np = vec_len_rt(b_phis)
            var p = 0
            when p < np loop
                phi = vec_get_rt(b_phis, p)
                if mir_phi_orig_vreg(phi) > max_vreg do
                    max_vreg = mir_phi_orig_vreg(phi)
                end
                if mir_phi_dst(phi) > max_vreg do
                    max_vreg = mir_phi_dst(phi)
                end
                p = p + 1
            end
        end
        i = i + 1
    end
    out max_vreg
end.

func mir_collect_defined_vregs(blocks: i64, max_vreg: i64):
    # O(B*I): only vregs that actually have a def — skip empty slots in 0..max_vreg.
    vregs = vec_new_rt()
    if max_vreg < 0 do out vregs end
    seen = vec_new_rt()
    var si = 0
    when si <= max_vreg loop
        seen = vec_push_rt(seen, 0)
        si = si + 1
    end
    n_blocks = vec_len_rt(blocks)
    var bi = 0
    when bi < n_blocks loop
        b = vec_get_rt(blocks, bi)
        instrs = mir_block_head(b)
        if instrs >= 0 do
            n_instrs = vec_len_rt(instrs)
            var j = 0
            when j < n_instrs loop
                ins = vec_get_rt(instrs, j)
                d = mir_instr_dst(ins)
                if mir_opnd_type(d) == MirOperandType.VReg do
                    vid = mir_opnd_vreg_id(d)
                    if vid >= 0 and vid <= max_vreg and vec_get_rt(seen, vid) == 0 do
                        vec_set_rt(seen, vid, 1)
                        vregs = vec_push_rt(vregs, vid)
                    end
                end
                j = j + 1
            end
        end
        bi = bi + 1
    end
    out vregs
end.

func mir_insert_phi_nodes(func_obj: MirFunc, blocks: i64):
    max_vreg = find_max_vreg(func_obj, blocks)
    n_blocks = vec_len_rt(blocks)
    if n_blocks == 0 do
        out blocks
    end

    defined_vregs = mir_collect_defined_vregs(blocks, max_vreg)
    def_blocks = vec_new_rt()
    has_phi = vec_new_rt()
    var i = 0
    when i < n_blocks loop
        def_blocks = vec_push_rt(def_blocks, 0)
        has_phi = vec_push_rt(has_phi, 0)
        i = i + 1
    end

    # Precompute vreg -> def_blocks map once (O(I) instead of O(V * I))
    vreg_defs = vec_new_rt()
    var vdi = 0
    when vdi <= max_vreg loop
        vreg_defs = vec_push_rt(vreg_defs, 0)
        vdi = vdi + 1
    end

    var bi = 0
    when bi < n_blocks loop
        b = vec_get_rt(blocks, bi)
        instrs = mir_block_head(b)
        if instrs >= 0 do
            n_instrs = vec_len_rt(instrs)
            var j = 0
            when j < n_instrs loop
                ins = vec_get_rt(instrs, j)
                d = mir_instr_dst(ins)
                if mir_opnd_type(d) == MirOperandType.VReg do
                    vid = mir_opnd_vreg_id(d)
                    if vid >= 0 & vid <= max_vreg do
                        blist = vec_get_rt(vreg_defs, vid)
                        if blist == 0 do
                            blist = vec_new_rt()
                        end
                        blen = vec_len_rt(blist)
                        var push_block = false
                        if blen == 0 do
                            push_block = true
                        else
                            if vec_get_rt(blist, blen - 1) != bi do
                                push_block = true
                            end
                        end
                        if push_block do
                            blist = vec_push_rt(blist, bi)
                            vec_set_rt(vreg_defs, vid, blist)
                        end
                    end
                end
                j = j + 1
            end
        end
        bi = bi + 1
    end

    var vi = 0
    when vi < vec_len_rt(defined_vregs) loop
        v = vec_get_rt(defined_vregs, vi)
        defs = vec_get_rt(vreg_defs, v)
        if defs == 0 do
            vi = vi + 1
            skip
        end
        if vec_len_rt(defs) <= 1 do
            vi = vi + 1
            skip
        end

        bi = 0
        when bi < n_blocks loop
            vec_set_rt(def_blocks, bi, 0)
            vec_set_rt(has_phi, bi, 0)
            bi = bi + 1
        end

        worklist = vec_new_rt()
        n_defs = vec_len_rt(defs)
        var di = 0
        when di < n_defs loop
            blk_idx = vec_get_rt(defs, di)
            vec_set_rt(def_blocks, blk_idx, 1)
            worklist = vec_push_rt(worklist, blk_idx)
            di = di + 1
        end

        if vec_len_rt(worklist) > 1 do
            var head = 0
            when head < vec_len_rt(worklist) loop
                x = vec_get_rt(worklist, head)
                head = head + 1

                b = vec_get_rt(blocks, x)
                b_df = mir_block_df(b)

                if b_df >= 0 do
                    df_len = vec_len_rt(b_df)
                    var j = 0
                    when j < df_len loop
                        y_idx = vec_get_rt(b_df, j)
                        if vec_get_rt(has_phi, y_idx) == 0 do
                            y = vec_get_rt(blocks, y_idx)
                            y_preds = mir_block_preds(y)
                            n_preds = vec_len_rt(y_preds)

                            inc_vals = vec_new_rt()
                            inc_blks = vec_new_rt()
                            var p = 0
                            when p < n_preds loop
                                pred_idx = vec_get_rt(y_preds, p)
                                inc_vals = vec_push_rt(inc_vals, mir_opnd_vreg(v))
                                inc_blks = vec_push_rt(inc_blks, pred_idx)
                                p = p + 1
                            end

                            phi_node = mir_phi_new(
                                v,
                                v,
                                inc_vals,
                                inc_blks,
                                0
                            )

                            y_phis = mir_block_phis(y)
                            if y_phis < 0 do
                                y_phis = vec_new_rt()
                            end
                            y_phis = vec_push_rt(y_phis, phi_node)

                            y_new = mir_block_new(
                                mir_block_id(y),
                                y_phis,
                                mir_block_head(y),
                                mir_block_tail(y),
                                mir_block_successors(y),
                                mir_block_preds(y),
                                mir_block_idom(y),
                                mir_block_dom_children(y),
                                mir_block_df(y),
                                mir_block_next_block(y)
                            )
                            vec_set_rt(blocks, y_idx, y_new)

                            vec_set_rt(has_phi, y_idx, 1)

                            if vec_get_rt(def_blocks, y_idx) == 0 do
                                vec_set_rt(def_blocks, y_idx, 1)
                                worklist = vec_push_rt(worklist, y_idx)
                            end
                        end
                        j = j + 1
                    end
                end
            end
        end
        vi = vi + 1
    end
    out blocks
end.

func ssa_stack_top(stacks: i64, v: i64):
    if v < 0 or v >= vec_len_rt(stacks) do
        out v
    end
    stk = vec_get_rt(stacks, v)
    n = vec_len_rt(stk)
    if n <= 0 do
        out v
    end
    top = vec_get_rt(stk, n - 1)
    # The initial stack entry is an explicit "undefined" sentinel.  A use
    # without a dominating definition remains in its original vreg slot.
    if top < 0 do
        out v
    end
    out top
end.

func ssa_stack_push(stacks: i64, v: i64, name: i64):
    stk = vec_get_rt(stacks, v)
    stk = vec_push_rt(stk, name)
    vec_set_rt(stacks, v, stk)
    out stacks
end.

func ssa_stack_pop(stacks: i64, v: i64):
    stk = vec_get_rt(stacks, v)
    if vec_len_rt(stk) <= 0 do
        out stacks
    end
    vec_pop_rt(stk)
    out stacks
end.

func ssa_fresh(func_obj: MirFunc):
    n = mir_func_next_vreg(func_obj)
    native_write_i64(func_obj as i64, 16, n + 1)
    out (func_obj, n)
end.

func mir_rename_block(func_obj: MirFunc, blocks: i64, bi: i64, stacks: i64):
    b = vec_get_rt(blocks, bi)
    pushed = vec_new_rt()

    # 1. Rename phi destinations
    b_phis = mir_block_phis(b)
    if b_phis >= 0 do
        np = vec_len_rt(b_phis)
        var p = 0
        when p < np loop
            phi = vec_get_rt(b_phis, p)
            var (func_obj_new, nn) = ssa_fresh(func_obj)
            func_obj = func_obj_new
            stacks = ssa_stack_push(stacks, mir_phi_orig_vreg(phi), nn)
            pushed = vec_push_rt(pushed, mir_phi_orig_vreg(phi))
            phi_new = mir_phi_new(
                nn,
                mir_phi_orig_vreg(phi),
                mir_phi_incoming_values(phi),
                mir_phi_incoming_blocks(phi),
                0
            )
            vec_set_rt(b_phis, p, phi_new)
            p = p + 1
        end
    end

    # 2. Rename instruction uses then defs
    b_head = mir_block_head(b)
    if b_head >= 0 do
        n_instrs = vec_len_rt(b_head)
        var j = 0
        when j < n_instrs loop
            ins = vec_get_rt(b_head, j)
            s1 = mir_instr_src1(ins)
            s2 = mir_instr_src2(ins)
            dst = mir_instr_dst(ins)
            if mir_opnd_type(s1) == MirOperandType.VReg do
                s1 = mir_opnd_vreg(ssa_stack_top(stacks, mir_opnd_vreg_id(s1)))
            end
            if mir_opnd_type(s2) == MirOperandType.VReg do
                s2 = mir_opnd_vreg(ssa_stack_top(stacks, mir_opnd_vreg_id(s2)))
            end
            if mir_opnd_type(dst) == MirOperandType.VReg do
                orig = mir_opnd_vreg_id(dst)
                var (func_obj_new2, nn2) = ssa_fresh(func_obj)
                func_obj = func_obj_new2
                stacks = ssa_stack_push(stacks, orig, nn2)
                pushed = vec_push_rt(pushed, orig)
                dst = mir_opnd_vreg(nn2)
            end
            ins_new = mir_instr_new(
                mir_instr_op(ins),
                dst,
                s1,
                s2
            )
            mir_instr_set_aux(ins_new, mir_instr_aux(ins))
            mir_instr_set_type(ins_new, mir_instr_type(ins))
            vec_set_rt(b_head, j, ins_new)
            j = j + 1
        end
    end
    b_new = mir_block_new(
        mir_block_id(b),
        b_phis,
        b_head,
        mir_block_tail(b),
        mir_block_successors(b),
        mir_block_preds(b),
        mir_block_idom(b),
        mir_block_dom_children(b),
        mir_block_df(b),
        mir_block_next_block(b)
    )
    vec_set_rt(blocks, bi, b_new)

    # 3. Fill phi operands in successors for this predecessor
    b_succs = mir_block_successors(b)
    if b_succs >= 0 do
        ns = vec_len_rt(b_succs)
        var s = 0
        when s < ns loop
            succ = vec_get_rt(b_succs, s)
            sb = vec_get_rt(blocks, succ)
            sb_phis = mir_block_phis(sb)
            if sb_phis >= 0 do
                np2 = vec_len_rt(sb_phis)
                var p2 = 0
                when p2 < np2 loop
                    phi2 = vec_get_rt(sb_phis, p2)
                    phi2_inc_blks = mir_phi_incoming_blocks(phi2)
                    phi2_inc_vals = mir_phi_incoming_values(phi2)
                    nin = vec_len_rt(phi2_inc_blks)
                    var k = 0
                    when k < nin loop
                        if vec_get_rt(phi2_inc_blks, k) == bi do
                            cur = ssa_stack_top(stacks, mir_phi_orig_vreg(phi2))
                            vec_set_rt(phi2_inc_vals, k, mir_opnd_vreg(cur))
                        end
                        k = k + 1
                    end
                    p2 = p2 + 1
                end
            end
            s = s + 1
        end
    end

    # 4. Recurse on dominator-tree children
    b = vec_get_rt(blocks, bi)
    b_dom_children = mir_block_dom_children(b)
    if b_dom_children >= 0 do
        nc = vec_len_rt(b_dom_children)
        var c = 0
        when c < nc loop
            child = vec_get_rt(b_dom_children, c)
            var (func_obj_rec, blocks_rec, stacks_rec) = mir_rename_block(func_obj, blocks, child, stacks)
            func_obj = func_obj_rec
            blocks = blocks_rec
            stacks = stacks_rec
            c = c + 1
        end
    end

    # 5. Pop names defined in this block
    var pi = 0
    when pi < vec_len_rt(pushed) loop
        ov = vec_get_rt(pushed, pi)
        stacks = ssa_stack_pop(stacks, ov)
        pi = pi + 1
    end

    out (func_obj, blocks, stacks)
end.

func mir_rename_variables(func_obj: MirFunc, blocks: i64):
    max_vreg = find_max_vreg(func_obj, blocks)
    stacks = vec_new_rt()
    var v = 0
    when v <= max_vreg loop
        stk = vec_new_rt()
        # Do not seed the SSA stack with a pre-SSA vreg.  ssa_stack_top
        # deliberately falls back to the slot index until a definition is
        # pushed on the dominator path.
        stk = vec_push_rt(stk, 0 - 1)
        stacks = vec_push_rt(stacks, stk)
        v = v + 1
    end
    if mir_func_next_vreg(func_obj) <= max_vreg do
        native_write_i64(func_obj as i64, 16, max_vreg + 1)
    end
    entry = 0
    if mir_func_entry_block(func_obj) >= 0 do
        entry = mir_func_entry_block(func_obj)
    end
    var (func_obj2, blocks2, _) = mir_rename_block(func_obj, blocks, entry, stacks)
    out (func_obj2, blocks2)
end.

export mir_insert_phi_nodes, mir_rename_variables, find_max_vreg

# @vir_source stdlib/vir/compiler/virc.vri 59
# @vir_source stdlib/vir/compiler/mir_opt.vri 1
##
 * vir/compiler/mir_opt.vri — MIR SSA Optimizations (Vir v2.0 Expansion)
 * ======================================================================
 * Block-local passes with kill-on-redef (safe on SSA and pre-SSA form).
 ##

import vec_new_rt, vec_push_rt, vec_get_rt, vec_set_rt, vec_len_rt from vec_rt

import MirOp, MirOperandType, MirOperand, MirInstr, MirBlock, MirFunc, mir_opnd_imm, mir_opnd_vreg, mir_opnd_none, mir_instr_new, mir_block_new, mir_instr_op, mir_instr_dst, mir_instr_src1, mir_instr_src2, mir_block_id, mir_block_head, mir_block_replace_head, mir_block_tail, mir_block_successors, mir_block_preds, mir_block_idom, mir_block_dom_children, mir_block_df, mir_block_next_block, mir_block_phis, mir_phi_new, mir_phi_dst, mir_phi_orig_vreg, mir_phi_incoming_values, mir_phi_incoming_blocks, mir_opnd_type, mir_opnd_vreg_id, mir_opnd_imm_val, mir_opnd_block_id, mir_func_name, mir_func_blocks, mir_func_strings, mir_func_next_vreg, MIR_INTR_BUILTIN, MIR_INTR_PARAM, MIR_INTR_SAFE_ACCESS, MIR_INTR_INDEX, MIR_INTR_FIELD, MIR_INTR_ENTITY, MIR_INTR_TUPLE, MIR_INTR_ADDR_OF, MIR_INTR_ARENA, MIR_INTR_PATCH_POINT, MIR_INTR_NOP_MARKER, MIR_INTR_SWIZZLE from mir
import MirOp, MirOperandType, MirOperand, MirInstr, MirBlock, MirFunc, mir_opnd_imm, mir_opnd_vreg, mir_opnd_none, mir_instr_new, mir_instr_aux, mir_instr_set_aux, mir_block_new, mir_instr_op, mir_instr_dst, mir_instr_src1, mir_instr_src2, mir_block_id, mir_block_head, mir_block_replace_head, mir_block_tail, mir_block_successors, mir_block_preds, mir_block_idom, mir_block_dom_children, mir_block_df, mir_block_next_block, mir_block_phis, mir_phi_new, mir_phi_dst, mir_phi_orig_vreg, mir_phi_incoming_values, mir_phi_incoming_blocks, mir_opnd_type, mir_opnd_vreg_id, mir_opnd_imm_val, mir_opnd_block_id, mir_func_name, mir_func_blocks, mir_func_strings, mir_func_next_vreg, MIR_INTR_BUILTIN, MIR_INTR_PARAM, MIR_INTR_SAFE_ACCESS, MIR_INTR_INDEX, MIR_INTR_FIELD, MIR_INTR_ENTITY, MIR_INTR_TUPLE, MIR_INTR_ADDR_OF, MIR_INTR_ARENA, MIR_INTR_PATCH_POINT, MIR_INTR_NOP_MARKER, MIR_INTR_SWIZZLE from mir
import MirOp, MirOperandType, MirOperand, MirInstr, MirBlock, MirFunc, mir_opnd_imm, mir_opnd_vreg, mir_opnd_none, mir_instr_new, mir_instr_aux, mir_instr_set_aux, mir_instr_type, mir_instr_set_type, mir_block_new, mir_instr_op, mir_instr_dst, mir_instr_src1, mir_instr_src2, mir_block_id, mir_block_head, mir_block_replace_head, mir_block_tail, mir_block_successors, mir_block_preds, mir_block_idom, mir_block_dom_children, mir_block_df, mir_block_next_block, mir_block_phis, mir_phi_new, mir_phi_dst, mir_phi_orig_vreg, mir_phi_incoming_values, mir_phi_incoming_blocks, mir_opnd_type, mir_opnd_vreg_id, mir_opnd_imm_val, mir_opnd_block_id, mir_func_name, mir_func_blocks, mir_func_strings, mir_func_next_vreg, MIR_INTR_BUILTIN, MIR_INTR_PARAM, MIR_INTR_SAFE_ACCESS, MIR_INTR_INDEX, MIR_INTR_FIELD, MIR_INTR_ENTITY, MIR_INTR_TUPLE, MIR_INTR_ADDR_OF, MIR_INTR_ARENA, MIR_INTR_PATCH_POINT, MIR_INTR_NOP_MARKER, MIR_INTR_SWIZZLE from mir

import rt_streq, fat_str_eq from string_rt

var g_mir_opt_last_changes: i64 = 0
var g_mir_opt_total_changes: i64 = 0
var g_mir_opt_program: i64 = -1
var g_mir_opt_current_func: i64 = 0

const MIR_INLINE_MAX_INSTRS: i64 = 40
const MIR_SROA_MAX_FIELDS: i64 = 4
const MIR_UNROLL_MAX: i64 = 4
const MIR_BCE_MARKER: i64 = 77
const MIR_SHRINK_WRAP_MARKER: i64 = 88
const MIR_HOT_BLOCK_MARKER: i64 = 99
const MIR_COLD_BLOCK_MARKER: i64 = 100
const MIR_ARC_RETAIN: i64 = 201
const MIR_ARC_RELEASE: i64 = 202
const MIR_ARC_TRIAL: i64 = 203

func mir_opt_set_program(program: i64):
    g_mir_opt_program = program
end.

func mir_opt_set_current_func(func_obj: i64):
    g_mir_opt_current_func = func_obj
end.

func mir_opt_reset_counters():
    g_mir_opt_last_changes = 0
    g_mir_opt_total_changes = 0
end.

func mir_opt_note_change():
    g_mir_opt_last_changes = g_mir_opt_last_changes + 1
    g_mir_opt_total_changes = g_mir_opt_total_changes + 1
end.

func mir_opt_get_last_changes():
    out g_mir_opt_last_changes
end.

func mir_opt_get_total_changes():
    out g_mir_opt_total_changes
end.

func mir_instr_defines_vreg(ins: MirInstr, v: i64):
    d = mir_instr_dst(ins)
    if mir_opnd_type(d) == MirOperandType.VReg and mir_opnd_vreg_id(d) == v do
        out true
    end
    out false
end.

func mir_opt_constant_folding(blocks: i64):
    n_blocks = vec_len_rt(blocks)
    var i = 0

    when i < n_blocks loop
        b = vec_get_rt(blocks, i)
        instrs = mir_block_head(b)
        if instrs >= 0 do
            n_instrs = vec_len_rt(instrs)
            var j = 0
            when j < n_instrs loop
                ins = vec_get_rt(instrs, j)
                op = mir_instr_op(ins)
                dst = mir_instr_dst(ins)
                s1 = mir_instr_src1(ins)
                s2 = mir_instr_src2(ins)
                s1_t = mir_opnd_type(s1)
                s2_t = mir_opnd_type(s2)

                if s1_t == MirOperandType.Imm and s2_t == MirOperandType.Imm do
                    var (ok, val) = mir_eval_const_binary(op, mir_opnd_imm_val(s1), mir_opnd_imm_val(s2))
                    if ok do
                        new_ins = mir_instr_new(MirOp.Move, dst, mir_opnd_imm(val), mir_opnd_none())
                        vec_set_rt(instrs, j, new_ins)
                        mir_opt_note_change()
                    end
                eif op == MirOp.Not and s1_t == MirOperandType.Imm do
                    new_not = mir_instr_new(MirOp.Move, dst, mir_opnd_imm(mir_opnd_imm_val(s1) xor (0 - 1)), mir_opnd_none())
                    vec_set_rt(instrs, j, new_not)
                    mir_opt_note_change()
                end
                j = j + 1
            end
        end
        i = i + 1
    end
    out blocks
end.

func count_vreg_defs_mir(blocks: i64, target_vreg: i64):
    n_blocks = vec_len_rt(blocks)
    var def_cnt = 0
    var i = 0
    when i < n_blocks loop
        b = vec_get_rt(blocks, i)
        instrs = mir_block_head(b)
        if instrs >= 0 do
            n_instrs = vec_len_rt(instrs)
            var j = 0
            when j < n_instrs loop
                ins = vec_get_rt(instrs, j)
                if mir_instr_defines_vreg(ins, target_vreg) do
                    def_cnt = def_cnt + 1
                end
                j = j + 1
            end
        end
        i = i + 1
    end
    out def_cnt
end.

# O(B*I) vreg def-count table; index = vreg id. Avoids repeated full-block scans.
func mir_build_vreg_def_counts(blocks: i64):
    counts = vec_new_rt()
    n_blocks = vec_len_rt(blocks)
    var i = 0
    when i < n_blocks loop
        instrs = mir_block_head(vec_get_rt(blocks, i))
        if instrs >= 0 do
            var j = 0
            when j < vec_len_rt(instrs) loop
                ins = vec_get_rt(instrs, j)
                dst = mir_instr_dst(ins)
                if mir_opnd_type(dst) == MirOperandType.VReg do
                    vid = mir_opnd_vreg_id(dst)
                    if vid >= 0 do
                        cl = vec_len_rt(counts)
                        when cl <= vid loop
                            counts = vec_push_rt(counts, 0)
                            cl = cl + 1
                        end
                        vec_set_rt(counts, vid, vec_get_rt(counts, vid) + 1)
                    end
                end
                j = j + 1
            end
        end
        i = i + 1
    end
    out counts
end.

func mir_vreg_def_count(def_counts: i64, vreg: i64):
    if def_counts < 0 do out 0 end
    if vreg < 0 or vreg >= vec_len_rt(def_counts) do out 0 end
    out vec_get_rt(def_counts, vreg)
end.

func mir_opt_copy_propagation(blocks: i64):
    def_counts = mir_build_vreg_def_counts(blocks)
    n_blocks = vec_len_rt(blocks)
    var i = 0
    when i < n_blocks loop
        b = vec_get_rt(blocks, i)
        instrs = mir_block_head(b)
        if instrs >= 0 do
            n_instrs = vec_len_rt(instrs)
            var j = 0
            when j < n_instrs loop
                ins = vec_get_rt(instrs, j)
                op = mir_instr_op(ins)
                dst = mir_instr_dst(ins)
                src1 = mir_instr_src1(ins)
                if op == MirOp.Move and mir_opnd_type(dst) == MirOperandType.VReg do
                    dst_v = mir_opnd_vreg_id(dst)
                    if mir_vreg_def_count(def_counts, dst_v) == 1 do
                        is_prop_vreg = mir_opnd_type(src1) == MirOperandType.VReg
                        is_prop_imm = mir_opnd_type(src1) == MirOperandType.Imm
                        if is_prop_vreg or is_prop_imm do
                            var k = j + 1
                            var stop = false
                            when k < n_instrs and not stop loop
                                ins_next = vec_get_rt(instrs, k)
                                if mir_instr_defines_vreg(ins_next, dst_v) do
                                    stop = true
                                else
                                    if is_prop_vreg do
                                        if mir_instr_defines_vreg(ins_next, mir_opnd_vreg_id(src1)) do
                                            stop = true
                                        end
                                    end
                                    if not stop do
                                        var changed = false
                                        n_s1 = mir_instr_src1(ins_next)
                                        n_s2 = mir_instr_src2(ins_next)
                                        if mir_opnd_type(n_s1) == MirOperandType.VReg and mir_opnd_vreg_id(n_s1) == dst_v do
                                            n_s1 = src1
                                            changed = true
                                        end
                                        if mir_opnd_type(n_s2) == MirOperandType.VReg and mir_opnd_vreg_id(n_s2) == dst_v do
                                            n_s2 = src1
                                            changed = true
                                        end
                                        if changed do
                                            new_next = mir_instr_new(mir_instr_op(ins_next), mir_instr_dst(ins_next), n_s1, n_s2)
                                            mir_instr_set_aux(new_next, mir_instr_aux(ins_next))
                                            mir_instr_set_type(new_next, mir_instr_type(ins_next))
                                            vec_set_rt(instrs, k, new_next)
                                            mir_opt_note_change()
                                        end
                                    end
                                    k = k + 1
                                end
                            end
                        end
                    end
                end
                j = j + 1
            end
        end
        i = i + 1
    end
    out blocks
end.

func mir_opt_constant_propagation(blocks: i64):
    def_counts = mir_build_vreg_def_counts(blocks)
    n_blocks = vec_len_rt(blocks)
    var i = 0
    when i < n_blocks loop
        instrs = mir_block_head(vec_get_rt(blocks, i))
        if instrs >= 0 do
            n_instrs = vec_len_rt(instrs)
            var j = 0
            when j < n_instrs loop
                ins = vec_get_rt(instrs, j)
                if mir_instr_op(ins) == MirOp.Move and mir_opnd_type(mir_instr_dst(ins)) == MirOperandType.VReg and mir_opnd_type(mir_instr_src1(ins)) == MirOperandType.Imm do
                    dst_v = mir_opnd_vreg_id(mir_instr_dst(ins))
                    if mir_vreg_def_count(def_counts, dst_v) == 1 do
                        blocks = mir_rewrite_uses_from(blocks, dst_v, mir_instr_src1(ins))
                    end
                end
                j = j + 1
            end
        end
        i = i + 1
    end
    out blocks
end.

func mir_opt_cse(blocks: i64):
    n_blocks = vec_len_rt(blocks)
    var i = 0
    when i < n_blocks loop
        b = vec_get_rt(blocks, i)
        instrs = mir_block_head(b)
        if instrs >= 0 do
            n_instrs = vec_len_rt(instrs)
            var j = 0
            when j < n_instrs loop
                ins1 = vec_get_rt(instrs, j)
                op1 = mir_instr_op(ins1)
                s1_1 = mir_instr_src1(ins1)
                s2_1 = mir_instr_src2(ins1)
                if mir_gvn_candidate(op1) and mir_opnd_type(mir_instr_dst(ins1)) == MirOperandType.VReg do
                    var k = j + 1
                    var stop = false
                    dst1_v = -1
                    if mir_opnd_type(mir_instr_dst(ins1)) == MirOperandType.VReg do
                        dst1_v = mir_opnd_vreg_id(mir_instr_dst(ins1))
                    end
                    when k < n_instrs and not stop loop
                        ins2 = vec_get_rt(instrs, k)
                        if mir_instr_redefines_operand(ins2, s1_1) or mir_instr_redefines_operand(ins2, s2_1) or (dst1_v >= 0 and mir_instr_defines_vreg(ins2, dst1_v)) do
                            stop = true
                        else
                            if mir_gvn_expr_same(ins2, op1, s1_1, s2_1) and mir_opnd_type(mir_instr_dst(ins2)) == MirOperandType.VReg do
                                new_ins2 = mir_instr_new(MirOp.Move, mir_instr_dst(ins2), mir_instr_dst(ins1), mir_opnd_none())
                                vec_set_rt(instrs, k, new_ins2)
                                mir_opt_note_change()
                            end
                            k = k + 1
                        end
                    end
                end
                j = j + 1
            end
        end
        i = i + 1
    end
    out blocks
end.

func mir_instr_redefines_operand(ins: MirInstr, opnd: MirOperand):
    if mir_opnd_type(opnd) == MirOperandType.VReg do
        out mir_instr_defines_vreg(ins, mir_opnd_vreg_id(opnd))
    end
    out false
end.

func count_vreg_uses_mir(blocks: i64, n_vregs: i64):
    uses = vec_new_rt()
    var vi = 0
    when vi < n_vregs loop
        uses = vec_push_rt(uses, 0)
        vi = vi + 1
    end
    n_blocks = vec_len_rt(blocks)
    var i = 0
    when i < n_blocks loop
        b = vec_get_rt(blocks, i)
        instrs = mir_block_head(b)
        if instrs >= 0 do
            n_instrs = vec_len_rt(instrs)
            var j = 0
            when j < n_instrs loop
                ins = vec_get_rt(instrs, j)
                s1 = mir_instr_src1(ins)
                s2 = mir_instr_src2(ins)
                if mir_opnd_type(s1) == MirOperandType.VReg do
                    v1 = mir_opnd_vreg_id(s1)
                    if v1 >= 0 and v1 < n_vregs do
                        cnt = vec_get_rt(uses, v1)
                        vec_set_rt(uses, v1, cnt + 1)
                    end
                end
                if mir_opnd_type(s2) == MirOperandType.VReg do
                    v2 = mir_opnd_vreg_id(s2)
                    if v2 >= 0 and v2 < n_vregs do
                        cnt2 = vec_get_rt(uses, v2)
                        vec_set_rt(uses, v2, cnt2 + 1)
                    end
                end
                j = j + 1
            end
        end
        phis = mir_block_phis(b)
        if phis >= 0 do
            n_phis = vec_len_rt(phis)
            var p = 0
            when p < n_phis loop
                phi = vec_get_rt(phis, p)
                inc_vals = mir_phi_incoming_values(phi)
                n_inc = vec_len_rt(inc_vals)
                var k = 0
                when k < n_inc loop
                    val = vec_get_rt(inc_vals, k)
                    if mir_opnd_type(val) == MirOperandType.VReg do
                        pv = mir_opnd_vreg_id(val)
                        if pv >= 0 and pv < n_vregs do
                            cntp = vec_get_rt(uses, pv)
                            vec_set_rt(uses, pv, cntp + 1)
                        end
                    end
                    k = k + 1
                end
                p = p + 1
            end
        end
        i = i + 1
    end
    out uses
end.

func max_vreg_mir(blocks: i64):
    var max_v = 0
    n_blocks = vec_len_rt(blocks)
    var i = 0
    when i < n_blocks loop
        b = vec_get_rt(blocks, i)
        instrs = mir_block_head(b)
        if instrs >= 0 do
            n_instrs = vec_len_rt(instrs)
            var j = 0
            when j < n_instrs loop
                ins = vec_get_rt(instrs, j)
                d = mir_instr_dst(ins)
                s1 = mir_instr_src1(ins)
                s2 = mir_instr_src2(ins)
                if mir_opnd_type(d) == MirOperandType.VReg and mir_opnd_vreg_id(d) > max_v do max_v = mir_opnd_vreg_id(d) end
                if mir_opnd_type(s1) == MirOperandType.VReg and mir_opnd_vreg_id(s1) > max_v do max_v = mir_opnd_vreg_id(s1) end
                if mir_opnd_type(s2) == MirOperandType.VReg and mir_opnd_vreg_id(s2) > max_v do max_v = mir_opnd_vreg_id(s2) end
                j = j + 1
            end
        end
        i = i + 1
    end
    out max_v + 1
end.

func is_pure_mir_op(op: i64):
    if op == MirOp.Move as i64 or op == MirOp.Add as i64 or op == MirOp.Sub as i64 or op == MirOp.Mul as i64 or op == MirOp.Div as i64 or op == MirOp.Mod as i64 or op == MirOp.Shl as i64 or op == MirOp.Shr as i64 or op == MirOp.And as i64 or op == MirOp.Or as i64 or op == MirOp.Xor as i64 or op == MirOp.Not as i64 or op == MirOp.CmpEq as i64 or op == MirOp.CmpNe as i64 or op == MirOp.CmpGt as i64 or op == MirOp.CmpLt as i64 or op == MirOp.CmpGe as i64 or op == MirOp.CmpLe as i64 do
        out true
    end
    out false
end.

func mir_opt_dce(blocks: i64):
    n_vregs = max_vreg_mir(blocks)
    if n_vregs <= 0 do out blocks end
    uses = count_vreg_uses_mir(blocks, n_vregs)

    # Tables to track definition for each vreg
    def_ins_tab = vec_new_rt()
    var vi = 0
    when vi < n_vregs loop
        def_ins_tab = vec_push_rt(def_ins_tab, 0)
        vi = vi + 1
    end

    worklist = vec_new_rt()
    n_blocks = vec_len_rt(blocks)
    var bi = 0
    when bi < n_blocks loop
        b = vec_get_rt(blocks, bi)
        instrs = mir_block_head(b)
        if instrs >= 0 do
            n_instrs = vec_len_rt(instrs)
            var j = 0
            when j < n_instrs loop
                ins = vec_get_rt(instrs, j)
                op = mir_instr_op(ins)
                dst = mir_instr_dst(ins)
                src1 = mir_instr_src1(ins)

                if op == MirOp.Nop as i64 do
                    # already dead
                eif op == MirOp.Move as i64 & mir_opnd_type(dst) == MirOperandType.VReg & mir_opnd_type(src1) == MirOperandType.VReg & mir_opnd_vreg_id(dst) == mir_opnd_vreg_id(src1) do
                    native_write_i64(ins as i64, 0, MirOp.Nop as i64)
                    mir_opt_note_change()
                eif mir_opnd_type(dst) == MirOperandType.VReg do
                    dst_v = mir_opnd_vreg_id(dst)
                    if dst_v >= 0 & dst_v < n_vregs do
                        vec_set_rt(def_ins_tab, dst_v, ins)
                        if is_pure_mir_op(op) & vec_get_rt(uses, dst_v) == 0 do
                            worklist = vec_push_rt(worklist, dst_v)
                        end
                    end
                end
                j = j + 1
            end
        end
        bi = bi + 1
    end

    # Process dead worklist recursively
    var wl_head = 0
    when wl_head < vec_len_rt(worklist) loop
        dead_v = vec_get_rt(worklist, wl_head)
        wl_head = wl_head + 1
        d_ins = vec_get_rt(def_ins_tab, dead_v)
        if d_ins != 0 do
            d_op = mir_instr_op(d_ins)
            if d_op != MirOp.Nop as i64 do
                native_write_i64(d_ins as i64, 0, MirOp.Nop as i64)
                mir_opt_note_change()

                # Decrement uses of operands
                s1 = mir_instr_src1(d_ins)
                if mir_opnd_type(s1) == MirOperandType.VReg do
                    s1_v = mir_opnd_vreg_id(s1)
                    if s1_v >= 0 & s1_v < n_vregs do
                        cnt = vec_get_rt(uses, s1_v) - 1
                        vec_set_rt(uses, s1_v, cnt)
                        if cnt == 0 do
                            p_ins = vec_get_rt(def_ins_tab, s1_v)
                            if p_ins != 0 do
                                if is_pure_mir_op(mir_instr_op(p_ins)) do
                                    worklist = vec_push_rt(worklist, s1_v)
                                end
                            end
                        end
                    end
                end

                s2 = mir_instr_src2(d_ins)
                if mir_opnd_type(s2) == MirOperandType.VReg do
                    s2_v = mir_opnd_vreg_id(s2)
                    if s2_v >= 0 & s2_v < n_vregs do
                        cnt2 = vec_get_rt(uses, s2_v) - 1
                        vec_set_rt(uses, s2_v, cnt2)
                        if cnt2 == 0 do
                            p_ins2 = vec_get_rt(def_ins_tab, s2_v)
                            if p_ins2 != 0 do
                                if is_pure_mir_op(mir_instr_op(p_ins2)) do
                                    worklist = vec_push_rt(worklist, s2_v)
                                end
                            end
                        end
                    end
                end
            end
        end
    end

    # Single sweep: rebuild blocks omitting Nop instructions
    bi = 0
    when bi < n_blocks loop
        b = vec_get_rt(blocks, bi)
        instrs = mir_block_head(b)
        if instrs >= 0 do
            n_instrs = vec_len_rt(instrs)
            new_instrs = vec_new_rt()
            var j = 0
            when j < n_instrs loop
                ins = vec_get_rt(instrs, j)
                if mir_instr_op(ins) != MirOp.Nop as i64 do
                    new_instrs = vec_push_rt(new_instrs, ins)
                end
                j = j + 1
            end
            b_new = mir_block_new(
                mir_block_id(b),
                mir_block_phis(b),
                new_instrs,
                mir_block_tail(b),
                mir_block_successors(b),
                mir_block_preds(b),
                mir_block_idom(b),
                mir_block_dom_children(b),
                mir_block_df(b),
                mir_block_next_block(b)
            )
            vec_set_rt(blocks, bi, b_new)
        end
        bi = bi + 1
    end
    out blocks
end.

##
 * mir_opt_strength_reduction — Replace expensive ops with cheaper equivalents.
 * Mul(v, 2^k) -> Shl(v, k). Signed Div/Mod by pow2 is not rewritten
 * without non-negative range facts because shift/and do not match all i64 inputs.
 ## 
func mir_log2(v: i64):
    var k = 0
    x = v
    when x > 1 loop
        x = x / 2
        k = k + 1
    end
    out k
end.

func mir_is_pow2(v: i64):
    if v <= 0 do
        out false
    end
    out (v and (v - 1)) == 0
end.

func mir_opt_strength_reduction(blocks: i64):
    n_blocks = vec_len_rt(blocks)
    var i = 0
    when i < n_blocks loop
        b = vec_get_rt(blocks, i)
        instrs = mir_block_head(b)
        if instrs >= 0 do
            n_instrs = vec_len_rt(instrs)
            var j = 0
            when j < n_instrs loop
                ins = vec_get_rt(instrs, j)
                op = mir_instr_op(ins)
                dst = mir_instr_dst(ins)
                s1 = mir_instr_src1(ins)
                s2 = mir_instr_src2(ins)
                s1_t = mir_opnd_type(s1)
                s2_t = mir_opnd_type(s2)
                # Mul(v, 2^k) → Shl(v, k)
                if op == MirOp.Mul do
                    if s2_t == MirOperandType.Imm do
                        imm_v = mir_opnd_imm_val(s2)
                        if mir_is_pow2(imm_v) do
                            new_ins = mir_instr_new(MirOp.Shl, dst, s1, mir_opnd_imm(mir_log2(imm_v)))
                            vec_set_rt(instrs, j, new_ins)
                            mir_opt_note_change()
                        end
                    eif s1_t == MirOperandType.Imm do
                        imm_v = mir_opnd_imm_val(s1)
                        if mir_is_pow2(imm_v) do
                            new_ins = mir_instr_new(MirOp.Shl, dst, s2, mir_opnd_imm(mir_log2(imm_v)))
                            vec_set_rt(instrs, j, new_ins)
                            mir_opt_note_change()
                        end
                    end
                end
                j = j + 1
            end
        end
        i = i + 1
    end
    out blocks
end.

func mir_is_control_terminator(op: i64):
    out op == MirOp.Jump or op == MirOp.JumpIf or op == MirOp.JumpIfNot or op == MirOp.Return
end.

func mir_block_insert_before_terminator(instrs: i64, ins: MirInstr):
    n = vec_len_rt(instrs)
    insert_at = n
    var scan = n - 1
    when scan >= 0 loop
        op = mir_instr_op(vec_get_rt(instrs, scan))
        if mir_is_control_terminator(op) do
            insert_at = scan
        end
        scan = scan - 1
    end
    new_instrs = vec_new_rt()
    var j = 0
    when j < n loop
        if j == insert_at do
            new_instrs = vec_push_rt(new_instrs, ins)
        end
        new_instrs = vec_push_rt(new_instrs, vec_get_rt(instrs, j))
        j = j + 1
    end
    if insert_at == n do
        new_instrs = vec_push_rt(new_instrs, ins)
    end
    out new_instrs
end.

func mir_find_block_index(blocks: i64, block_id: i64):
    n_blocks = vec_len_rt(blocks)
    var i = 0
    when i < n_blocks loop
        if mir_block_id(vec_get_rt(blocks, i)) == block_id do out i end
        i = i + 1
    end
    out 0 - 1
end.

func mir_find_loop_preheader(blocks: i64, hdr_idx: i64, back_edge_body_id: i64):
    hdr = vec_get_rt(blocks, hdr_idx)
    preds = mir_block_preds(hdr)
    if preds < 0 do out 0 - 1 end
    var pi = 0
    when pi < vec_len_rt(preds) loop
        pred_id = vec_get_rt(preds, pi)
        if pred_id != back_edge_body_id do
            out mir_find_block_index(blocks, pred_id)
        end
        pi = pi + 1
    end
    out 0 - 1
end.

func mir_vreg_defined_in_body(blocks: i64, body_idx: i64, v: i64, except_idx: i64):
    instrs = mir_block_head(vec_get_rt(blocks, body_idx))
    if instrs < 0 do out false end
    var ji = 0
    when ji < vec_len_rt(instrs) loop
        if ji != except_idx do
            ins = vec_get_rt(instrs, ji)
            if mir_instr_defines_vreg(ins, v) do out true end
        end
        ji = ji + 1
    end
    out false
end.

func mir_opt_licm_hoistable(op: i64):
    if is_pure_mir_op(op) do out true end
    if op == MirOp.Load do out true end
    out false
end.

func mir_opt_licm_operands_invariant(blocks: i64, body_idx: i64, op: i64, ins: MirInstr, def_counts: i64):
    s1 = mir_instr_src1(ins)
    if op == MirOp.Not do
        out mir_opt_operand_loop_invariant(blocks, body_idx, s1, def_counts)
    end
    if op == MirOp.Load do
        s2 = mir_instr_src2(ins)
        out mir_opt_operand_loop_invariant(blocks, body_idx, s1, def_counts) and mir_opt_operand_loop_invariant(blocks, body_idx, s2, def_counts)
    end
    s2 = mir_instr_src2(ins)
    out mir_opt_operand_loop_invariant(blocks, body_idx, s1, def_counts) and mir_opt_operand_loop_invariant(blocks, body_idx, s2, def_counts)
end.

##
 * mir_opt_licm — Loop-Invariant Code Motion.
 * Hoists pure invariant ops to the loop preheader (or header before terminator).
 ## 
func mir_opt_licm(blocks: i64):
    def_counts = mir_build_vreg_def_counts(blocks)
    n_blocks = vec_len_rt(blocks)
    var hdr_idx = 0
    when hdr_idx < n_blocks loop
        hdr = vec_get_rt(blocks, hdr_idx)
        hdr_id = mir_block_id(hdr)
        succs = mir_block_successors(hdr)
        if succs >= 0 do
            ns = vec_len_rt(succs)
            var si = 0
            when si < ns loop
                body_id = vec_get_rt(succs, si)
                body_idx = mir_find_block_index(blocks, body_id)
                if body_idx >= 0 do
                    preds = mir_block_preds(vec_get_rt(blocks, body_idx))
                    var is_back_edge = 0
                    if preds >= 0 do
                        var pi = 0
                        when pi < vec_len_rt(preds) loop
                            if vec_get_rt(preds, pi) == hdr_id do is_back_edge = 1 end
                            pi = pi + 1
                        end
                    end
                    if is_back_edge == 1 do
                        pre_idx = mir_find_loop_preheader(blocks, hdr_idx, body_id)
                        hoist_idx = pre_idx
                        if hoist_idx < 0 do hoist_idx = hdr_idx end
                        body = vec_get_rt(blocks, body_idx)
                        instrs = mir_block_head(body)
                        hoist_b = vec_get_rt(blocks, hoist_idx)
                        hoist_instrs = mir_block_head(hoist_b)
                        if instrs >= 0 and hoist_instrs >= 0 do
                            n_ins = vec_len_rt(instrs)
                            var ii = 0
                            when ii < n_ins loop
                                ins = vec_get_rt(instrs, ii)
                                op = mir_instr_op(ins)
                                if mir_opt_licm_hoistable(op) do
                                    dst = mir_instr_dst(ins)
                                    can_hoist = mir_opt_licm_operands_invariant(blocks, body_idx, op, ins, def_counts)
                                    if can_hoist and mir_opnd_type(dst) == MirOperandType.VReg do
                                        dv = mir_opnd_vreg_id(dst)
                                        if not mir_vreg_defined_in_body(blocks, body_idx, dv, ii) do
                                            hoisted = mir_instr_new(op, dst, mir_instr_src1(ins), mir_instr_src2(ins))
                                            mir_instr_set_aux(hoisted, mir_instr_aux(ins))
                                            mir_instr_set_type(hoisted, mir_instr_type(ins))
                                            hoist_instrs = mir_block_insert_before_terminator(hoist_instrs, hoisted)
                                            vec_set_rt(instrs, ii, mir_instr_new(MirOp.Nop, mir_opnd_none(), mir_opnd_none(), mir_opnd_none()))
                                            mir_opt_note_change()
                                        end
                                    end
                                end
                                ii = ii + 1
                            end
                            body = mir_block_replace_head(body, instrs)
                            hoist_b = mir_block_replace_head(hoist_b, hoist_instrs)
                            vec_set_rt(blocks, body_idx, body)
                            vec_set_rt(blocks, hoist_idx, hoist_b)
                        end
                    end
                end
                si = si + 1
            end
        end
        hdr_idx = hdr_idx + 1
    end
    out blocks
end.

func mir_opt_operand_loop_invariant(blocks: i64, loop_body_idx: i64, opnd: MirOperand, def_counts: i64):
    if mir_opnd_type(opnd) == MirOperandType.Imm do out true end
    if mir_opnd_type(opnd) != MirOperandType.VReg do out false end
    v = mir_opnd_vreg_id(opnd)
    if mir_vreg_def_count(def_counts, v) != 1 do out false end
    n_blocks = vec_len_rt(blocks)
    var bi = 0
    when bi < n_blocks loop
        instrs = mir_block_head(vec_get_rt(blocks, bi))
        if instrs >= 0 do
            var ji = 0
            when ji < vec_len_rt(instrs) loop
                ins = vec_get_rt(instrs, ji)
                if mir_instr_defines_vreg(ins, v) do
                    if bi == loop_body_idx do out false end
                    out true
                end
                ji = ji + 1
            end
        end
        bi = bi + 1
    end
    out true
end.

##
 * mir_opt_gvn — Global Value Numbering over Dominator Tree.
 ##
func mir_opt_gvn(blocks: i64):
    n_blocks = vec_len_rt(blocks)
    var b_idx = 0
    when b_idx < n_blocks loop
        b = vec_get_rt(blocks, b_idx)
        instrs = mir_block_head(b)
        if instrs >= 0 do
            n_instrs = vec_len_rt(instrs)
            var i = 0
            when i < n_instrs loop
                ins = vec_get_rt(instrs, i)
                op = mir_instr_op(ins)
                dst = mir_instr_dst(ins)
                if mir_gvn_candidate(op) and mir_opnd_type(dst) == MirOperandType.VReg do
                    s1 = mir_instr_src1(ins)
                    s2 = mir_instr_src2(ins)
                    var (cs1, cs2) = mir_gvn_canonicalize_pair(op, s1, s2)
                    replacement = mir_opnd_none()
                    found = false
                    var d_idx = 0
                    when d_idx < n_blocks and not found loop
                        if mir_block_index_dominates(blocks, d_idx, b_idx) do
                            db = vec_get_rt(blocks, d_idx)
                            d_instrs = mir_block_head(db)
                            if d_instrs >= 0 do
                                limit = vec_len_rt(d_instrs)
                                if d_idx == b_idx do limit = i end
                                var j = 0
                                when j < limit and not found loop
                                    prev = vec_get_rt(d_instrs, j)
                                    if mir_gvn_expr_same(prev, op, cs1, cs2) do
                                        prev_dst = mir_instr_dst(prev)
                                        if mir_opnd_type(prev_dst) == MirOperandType.VReg do
                                            replacement = prev_dst
                                            found = true
                                        end
                                    end
                                    j = j + 1
                                end
                            end
                        end
                        d_idx = d_idx + 1
                    end
                    if found do
                        vec_set_rt(instrs, i, mir_instr_new(MirOp.Move, dst, replacement, mir_opnd_none()))
                        mir_opt_note_change()
                    end
                end
                i = i + 1
            end
        end
        b_idx = b_idx + 1
    end
    out blocks
end.

func mir_gvn_candidate(op: i64):
    if op == MirOp.Not do out true end
    out op == MirOp.Add or op == MirOp.Sub or op == MirOp.Mul or op == MirOp.Div or op == MirOp.Mod or op == MirOp.And or op == MirOp.Or or op == MirOp.Xor or op == MirOp.Shl or op == MirOp.Shr or op == MirOp.CmpEq or op == MirOp.CmpNe or op == MirOp.CmpGt or op == MirOp.CmpLt or op == MirOp.CmpGe or op == MirOp.CmpLe
end.

func mir_gvn_canonicalize_pair(op: i64, s1: MirOperand, s2: MirOperand):
    if mir_gvn_commutative(op) do
        if mir_opnd_type(s1) == MirOperandType.Imm and mir_opnd_type(s2) != MirOperandType.Imm do
            out (s2, s1)
        end
        if mir_opnd_type(s1) == MirOperandType.VReg and mir_opnd_type(s2) == MirOperandType.VReg do
            if mir_opnd_vreg_id(s1) > mir_opnd_vreg_id(s2) do
                out (s2, s1)
            end
        end
    end
    out (s1, s2)
end.

func mir_gvn_commutative(op: i64):
    out op == MirOp.Add or op == MirOp.Mul or op == MirOp.And or op == MirOp.Or or op == MirOp.Xor or op == MirOp.CmpEq or op == MirOp.CmpNe
end.

func mir_gvn_expr_same(ins: MirInstr, op: i64, s1: MirOperand, s2: MirOperand):
    if mir_instr_op(ins) != op do out false end
    p1 = mir_instr_src1(ins)
    p2 = mir_instr_src2(ins)
    var (cs1, cs2) = mir_gvn_canonicalize_pair(op, s1, s2)
    var (cp1, cp2) = mir_gvn_canonicalize_pair(op, p1, p2)
    if mir_opnd_is_same(cp1, cs1) and mir_opnd_is_same(cp2, cs2) do out true end
    out false
end.

func mir_block_index_dominates(blocks: i64, dom_idx: i64, block_idx: i64):
    if dom_idx == block_idx do out true end
    n_blocks = vec_len_rt(blocks)
    current = block_idx
    var steps = 0
    when current >= 0 and current < n_blocks and steps < n_blocks loop
        current = mir_block_idom(vec_get_rt(blocks, current))
        if current == dom_idx do out true end
        steps = steps + 1
    end
    out false
end.

##
 * mir_opt_jump_threading — CFG simplification, empty block pruning, and jump threading.
 ##
func mir_opt_jump_threading(blocks: i64):
    n_blocks = vec_len_rt(blocks)
    var b_idx = 0
    when b_idx < n_blocks loop
        b = vec_get_rt(blocks, b_idx)
        instrs = mir_block_head(b)
        if instrs >= 0 do
            n_instrs = vec_len_rt(instrs)
            var i = 0
            when i < n_instrs loop
                ins = vec_get_rt(instrs, i)
                op = mir_instr_op(ins)
                if op == MirOp.Jump do
                    target = mir_instr_src1(ins)
                    if mir_opnd_type(target) == MirOperandType.Imm do
                        resolved = mir_resolve_trampoline(blocks, mir_opnd_imm_val(target))
                        if resolved != mir_opnd_imm_val(target) do
                            vec_set_rt(instrs, i, mir_instr_new(MirOp.Jump, mir_instr_dst(ins), mir_opnd_imm(resolved), mir_instr_src2(ins)))
                            mir_opt_note_change()
                        end
                    end
                eif op == MirOp.JumpIf or op == MirOp.JumpIfNot do
                    target = mir_instr_src2(ins)
                    if mir_opnd_type(target) == MirOperandType.Imm do
                        resolved = mir_resolve_trampoline(blocks, mir_opnd_imm_val(target))
                        if resolved != mir_opnd_imm_val(target) do
                            vec_set_rt(instrs, i, mir_instr_new(op, mir_instr_dst(ins), mir_instr_src1(ins), mir_opnd_imm(resolved)))
                            mir_opt_note_change()
                        end
                    end
                end
                i = i + 1
            end
        end
        b_idx = b_idx + 1
    end
    out blocks
end.

func mir_trampoline_target(blocks: i64, block_id: i64):
    idx = mir_find_block_index(blocks, block_id)
    if idx < 0 do out 0 - 1 end
    b = vec_get_rt(blocks, idx)
    phis = mir_block_phis(b)
    if phis >= 0 and vec_len_rt(phis) > 0 do out 0 - 1 end
    instrs = mir_block_head(b)
    if instrs < 0 do out 0 - 1 end
    n_instrs = vec_len_rt(instrs)
    target = 0 - 1
    var meaningful = 0
    var i = 0
    when i < n_instrs loop
        ins = vec_get_rt(instrs, i)
        op = mir_instr_op(ins)
        if op != MirOp.Nop do
            meaningful = meaningful + 1
            if op == MirOp.Jump and mir_opnd_type(mir_instr_src1(ins)) == MirOperandType.Imm do
                target = mir_opnd_imm_val(mir_instr_src1(ins))
            else
                target = 0 - 1
            end
        end
        i = i + 1
    end
    if meaningful == 1 do out target end
    out 0 - 1
end.

func mir_resolve_trampoline(blocks: i64, target_id: i64):
    n_blocks = vec_len_rt(blocks)
    current = target_id
    var hops = 0
    when hops < n_blocks loop
        next_target = mir_trampoline_target(blocks, current)
        if next_target < 0 or next_target == current do out current end
        current = next_target
        hops = hops + 1
    end
    out target_id
end.

const MIR_SCCP_TOP: i64 = 0
const MIR_SCCP_CONST: i64 = 1
const MIR_SCCP_OVER: i64 = 2

func mir_sccp_lattice_meet(a_state: i64, a_val: i64, b_state: i64, b_val: i64):
    if a_state == MIR_SCCP_OVER or b_state == MIR_SCCP_OVER do out (MIR_SCCP_OVER, 0) end
    if a_state == MIR_SCCP_TOP do out (b_state, b_val) end
    if b_state == MIR_SCCP_TOP do out (a_state, a_val) end
    if a_state == MIR_SCCP_CONST and b_state == MIR_SCCP_CONST do
        if a_val == b_val do out (MIR_SCCP_CONST, a_val) end
        out (MIR_SCCP_OVER, 0)
    end
    out (MIR_SCCP_OVER, 0)
end.

func mir_sccp_operand_state(opnd: MirOperand, states: i64, values: i64):
    if mir_opnd_type(opnd) == MirOperandType.Imm do
        out (MIR_SCCP_CONST, mir_opnd_imm_val(opnd))
    end
    if mir_opnd_type(opnd) == MirOperandType.VReg do
        id = mir_opnd_vreg_id(opnd)
        if id >= 0 and id < vec_len_rt(states) do
            st = vec_get_rt(states, id)
            if st == MIR_SCCP_CONST do out (MIR_SCCP_CONST, vec_get_rt(values, id)) end
            out (st, 0)
        end
    end
    out (MIR_SCCP_OVER, 0)
end.

func mir_sccp_try_set(states: i64, values: i64, v: i64, new_state: i64, new_val: i64):
    if v < 0 or v >= vec_len_rt(states) do out false end
    old_state = vec_get_rt(states, v)
    old_val = vec_get_rt(values, v)
    if old_state == new_state and (new_state != MIR_SCCP_CONST or old_val == new_val) do out false end
    vec_set_rt(states, v, new_state)
    if new_state == MIR_SCCP_CONST do vec_set_rt(values, v, new_val) end
    out true
end.

##
 * mir_opt_sccp — Sparse Conditional Constant Propagation (lattice + phi meet).
 ##
func mir_opt_sccp(blocks: i64):
    n_vregs = max_vreg_mir(blocks)
    states = vec_new_rt()
    values = vec_new_rt()
    var v = 0
    when v < n_vregs loop
        states = vec_push_rt(states, MIR_SCCP_TOP)
        values = vec_push_rt(values, 0)
        v = v + 1
    end

    changed = true
    var iter = 0
    n_blocks = vec_len_rt(blocks)
    max_iter = (n_blocks + 1) * 8
    if max_iter > 512 do max_iter = 512 end
    when changed and iter < max_iter loop
        changed = false
        n_blocks = vec_len_rt(blocks)
        var b_idx = 0
        when b_idx < n_blocks loop
            b = vec_get_rt(blocks, b_idx)
            phis = mir_block_phis(b)
            if phis >= 0 do
                var p = 0
                when p < vec_len_rt(phis) loop
                    phi = vec_get_rt(phis, p)
                    dst_v = mir_phi_dst(phi)
                    inc_vals = mir_phi_incoming_values(phi)
                    meet_state = MIR_SCCP_TOP
                    meet_val = 0
                    var k = 0
                    when k < vec_len_rt(inc_vals) loop
                        inc = vec_get_rt(inc_vals, k)
                        var (ist, ival) = mir_sccp_operand_state(inc, states, values)
                        var (mst, mval) = mir_sccp_lattice_meet(meet_state, meet_val, ist, ival)
                        meet_state = mst
                        meet_val = mval
                        k = k + 1
                    end
                    if mir_sccp_try_set(states, values, dst_v, meet_state, meet_val) do
                        changed = true
                    end
                    p = p + 1
                end
            end
            instrs = mir_block_head(b)
            if instrs >= 0 do
                var i = 0
                when i < vec_len_rt(instrs) loop
                    ins = vec_get_rt(instrs, i)
                    op = mir_instr_op(ins)
                    dst = mir_instr_dst(ins)
                    if mir_op_defines_value(op) and mir_opnd_type(dst) == MirOperandType.VReg do
                        dst_v = mir_opnd_vreg_id(dst)
                        s1 = mir_instr_src1(ins)
                        s2 = mir_instr_src2(ins)
                        var (s1_st, s1_val) = mir_sccp_operand_state(s1, states, values)
                        var (s2_st, s2_val) = mir_sccp_operand_state(s2, states, values)
                        if s1_st == MIR_SCCP_OVER or s2_st == MIR_SCCP_OVER do
                            if mir_sccp_try_set(states, values, dst_v, MIR_SCCP_OVER, 0) do changed = true end
                        eif s1_st == MIR_SCCP_TOP or s2_st == MIR_SCCP_TOP do
                            # wait for operands
                        else
                            rs1_eval = s1
                            rs2_eval = s2
                            if s1_st == MIR_SCCP_CONST do rs1_eval = mir_opnd_imm(s1_val) end
                            if s2_st == MIR_SCCP_CONST do rs2_eval = mir_opnd_imm(s2_val) end
                            var (is_const, const_val) = mir_sccp_eval(op, rs1_eval, rs2_eval)
                            if is_const do
                                if mir_sccp_try_set(states, values, dst_v, MIR_SCCP_CONST, const_val) do changed = true end
                            else
                                if mir_sccp_try_set(states, values, dst_v, MIR_SCCP_OVER, 0) do changed = true end
                            end
                        end
                    end
                    i = i + 1
                end
            end
            b_idx = b_idx + 1
        end
        iter = iter + 1
    end

    n_blocks2 = vec_len_rt(blocks)
    var bi = 0
    when bi < n_blocks2 loop
        instrs2 = mir_block_head(vec_get_rt(blocks, bi))
        if instrs2 >= 0 do
            var ii = 0
            when ii < vec_len_rt(instrs2) loop
                ins2 = vec_get_rt(instrs2, ii)
                op2 = mir_instr_op(ins2)
                dst2 = mir_instr_dst(ins2)
                rs1 = mir_sccp_resolve_operand(mir_instr_src1(ins2), states, values)
                rs2 = mir_sccp_resolve_operand(mir_instr_src2(ins2), states, values)
                if mir_op_defines_value(op2) and mir_opnd_type(dst2) == MirOperandType.VReg do
                    dv = mir_opnd_vreg_id(dst2)
                    if dv >= 0 and dv < n_vregs and vec_get_rt(states, dv) == MIR_SCCP_CONST do
                        cval = vec_get_rt(values, dv)
                        if op2 != MirOp.Move or mir_opnd_type(mir_instr_src1(ins2)) != MirOperandType.Imm or mir_opnd_imm_val(mir_instr_src1(ins2)) != cval do
                            vec_set_rt(instrs2, ii, mir_instr_new(MirOp.Move, dst2, mir_opnd_imm(cval), mir_opnd_none()))
                            mir_opt_note_change()
                        end
                    else
                        if not mir_opnd_is_same(rs1, mir_instr_src1(ins2)) or not mir_opnd_is_same(rs2, mir_instr_src2(ins2)) do
                            vec_set_rt(instrs2, ii, mir_instr_new(op2, dst2, rs1, rs2))
                            new_ins2 = mir_instr_new(op2, dst2, rs1, rs2)
                            mir_instr_set_aux(new_ins2, mir_instr_aux(ins2))
                            mir_instr_set_type(new_ins2, mir_instr_type(ins2))
                            vec_set_rt(instrs2, ii, new_ins2)
                            mir_opt_note_change()
                        end
                    end
                else
                    if not mir_opnd_is_same(rs1, mir_instr_src1(ins2)) or not mir_opnd_is_same(rs2, mir_instr_src2(ins2)) do
                        vec_set_rt(instrs2, ii, mir_instr_new(op2, dst2, rs1, rs2))
                        new_ins2 = mir_instr_new(op2, dst2, rs1, rs2)
                        mir_instr_set_aux(new_ins2, mir_instr_aux(ins2))
                        mir_instr_set_type(new_ins2, mir_instr_type(ins2))
                        vec_set_rt(instrs2, ii, new_ins2)
                        mir_opt_note_change()
                    end
                end
                ii = ii + 1
            end
        end
        bi = bi + 1
    end
    out blocks
end.

func mir_op_defines_value(op: i64):
    out op == MirOp.Move or op == MirOp.Load or op == MirOp.Add or op == MirOp.Sub or op == MirOp.Mul or op == MirOp.Div or op == MirOp.Mod or op == MirOp.And or op == MirOp.Or or op == MirOp.Xor or op == MirOp.Shl or op == MirOp.Shr or op == MirOp.Not or op == MirOp.CmpEq or op == MirOp.CmpNe or op == MirOp.CmpGt or op == MirOp.CmpLt or op == MirOp.CmpGe or op == MirOp.CmpLe
end.

func count_vreg_value_defs_mir(blocks: i64, target_vreg: i64):
    n_blocks = vec_len_rt(blocks)
    var defs = 0
    var i = 0
    when i < n_blocks loop
        instrs = mir_block_head(vec_get_rt(blocks, i))
        if instrs >= 0 do
            var j = 0
            when j < vec_len_rt(instrs) loop
                ins = vec_get_rt(instrs, j)
                if mir_op_defines_value(mir_instr_op(ins)) and mir_instr_defines_vreg(ins, target_vreg) do
                    defs = defs + 1
                end
                j = j + 1
            end
        end
        i = i + 1
    end
    out defs
end.

func mir_sccp_resolve_operand(opnd: MirOperand, states: i64, values: i64):
    if mir_opnd_type(opnd) == MirOperandType.VReg do
        id = mir_opnd_vreg_id(opnd)
        if id >= 0 and id < vec_len_rt(states) and vec_get_rt(states, id) == MIR_SCCP_CONST do
            out mir_opnd_imm(vec_get_rt(values, id))
        end
    end
    out opnd
end.

func mir_sccp_eval(op: i64, s1: MirOperand, s2: MirOperand):
    if op == MirOp.Move and mir_opnd_type(s1) == MirOperandType.Imm do
        out (true, mir_opnd_imm_val(s1))
    end
    if op == MirOp.Not and mir_opnd_type(s1) == MirOperandType.Imm do
        out (true, mir_opnd_imm_val(s1) xor (0 - 1))
    end
    if mir_opnd_type(s1) != MirOperandType.Imm or mir_opnd_type(s2) != MirOperandType.Imm do
        out (false, 0)
    end
    out mir_eval_const_binary(op, mir_opnd_imm_val(s1), mir_opnd_imm_val(s2))
end.

func mir_opnd_is_same(o1: MirOperand, o2: MirOperand):
    if (o1 as i64) == 0 or (o2 as i64) == 0 do out false end
    t1 = mir_opnd_type(o1)
    t2 = mir_opnd_type(o2)
    if t1 != t2 do out false end
    if t1 == MirOperandType.None do
        out true
    end
    if t1 == MirOperandType.VReg do
        out mir_opnd_vreg_id(o1) == mir_opnd_vreg_id(o2)
    end
    if t1 == MirOperandType.Imm do
        out mir_opnd_imm_val(o1) == mir_opnd_imm_val(o2)
    end
    if t1 == MirOperandType.Block do
        out mir_opnd_block_id(o1) == mir_opnd_block_id(o2)
    end
    out false
end.

func mir_opnd_replace_vreg(o: MirOperand, from_v: i64, to: MirOperand):
    if mir_opnd_type(o) == MirOperandType.VReg and mir_opnd_vreg_id(o) == from_v do
        out to
    end
    out o
end.

func mir_rewrite_uses_from(blocks: i64, from_v: i64, to: MirOperand):
    n_blocks = vec_len_rt(blocks)
    var i = 0
    when i < n_blocks loop
        b = vec_get_rt(blocks, i)
        instrs = mir_block_head(b)
        if instrs >= 0 do
            n_instrs = vec_len_rt(instrs)
            var j = 0
            when j < n_instrs loop
                ins = vec_get_rt(instrs, j)
                ns1 = mir_opnd_replace_vreg(mir_instr_src1(ins), from_v, to)
                ns2 = mir_opnd_replace_vreg(mir_instr_src2(ins), from_v, to)
                if not mir_opnd_is_same(ns1, mir_instr_src1(ins)) or not mir_opnd_is_same(ns2, mir_instr_src2(ins)) do
                    vec_set_rt(instrs, j, mir_instr_new(mir_instr_op(ins), mir_instr_dst(ins), ns1, ns2))
                    new_ins = mir_instr_new(mir_instr_op(ins), mir_instr_dst(ins), ns1, ns2)
                    mir_instr_set_aux(new_ins, mir_instr_aux(ins))
                    mir_instr_set_type(new_ins, mir_instr_type(ins))
                    vec_set_rt(instrs, j, new_ins)
                    mir_opt_note_change()
                end
                j = j + 1
            end
        end
        phis = mir_block_phis(b)
        if phis >= 0 do
            n_phis = vec_len_rt(phis)
            var p = 0
            when p < n_phis loop
                phi = vec_get_rt(phis, p)
                inc_vals = mir_phi_incoming_values(phi)
                n_inc = vec_len_rt(inc_vals)
                var k = 0
                when k < n_inc loop
                    val = vec_get_rt(inc_vals, k)
                    nval = mir_opnd_replace_vreg(val, from_v, to)
                    if not mir_opnd_is_same(nval, val) do
                        vec_set_rt(inc_vals, k, nval)
                        mir_opt_note_change()
                    end
                    k = k + 1
                end
                p = p + 1
            end
        end
        i = i + 1
    end
    out blocks
end.

func mir_bool_i64(cond: bool):
    if cond do out 1 end
    out 0
end.

func mir_eval_const_binary(op: i64, a: i64, b: i64):
    if op == MirOp.Add do out (true, a + b) end
    if op == MirOp.Sub do out (true, a - b) end
    if op == MirOp.Mul do out (true, a * b) end
    if op == MirOp.Div and b != 0 do out (true, a / b) end
    if op == MirOp.Mod and b != 0 do out (true, a mod b) end
    if op == MirOp.And do out (true, a and b) end
    if op == MirOp.Or do out (true, a or b) end
    if op == MirOp.Xor do out (true, a xor b) end
    if op == MirOp.Shl and b >= 0 and b < 63 do out (true, a shl b) end
    if op == MirOp.Shr and b >= 0 and b < 63 do out (true, a shr b) end
    if op == MirOp.CmpEq do out (true, mir_bool_i64(a == b)) end
    if op == MirOp.CmpNe do out (true, mir_bool_i64(a != b)) end
    if op == MirOp.CmpGt do out (true, mir_bool_i64(a > b)) end
    if op == MirOp.CmpLt do out (true, mir_bool_i64(a < b)) end
    if op == MirOp.CmpGe do out (true, mir_bool_i64(a >= b)) end
    if op == MirOp.CmpLe do out (true, mir_bool_i64(a <= b)) end
    out (false, 0)
end.

func mir_opt_algebraic_simplification(blocks: i64):
    n_blocks = vec_len_rt(blocks)
    var i = 0
    when i < n_blocks loop
        instrs = mir_block_head(vec_get_rt(blocks, i))
        if instrs >= 0 do
            n_instrs = vec_len_rt(instrs)
            var j = 0
            when j < n_instrs loop
                ins = vec_get_rt(instrs, j)
                op = mir_instr_op(ins)
                dst = mir_instr_dst(ins)
                s1 = mir_instr_src1(ins)
                s2 = mir_instr_src2(ins)
                t1 = mir_opnd_type(s1)
                t2 = mir_opnd_type(s2)
                changed = false
                repl = ins
                if t1 == MirOperandType.Imm and t2 == MirOperandType.Imm do
                    var (ok, val) = mir_eval_const_binary(op, mir_opnd_imm_val(s1), mir_opnd_imm_val(s2))
                    if ok do
                        repl = mir_instr_new(MirOp.Move, dst, mir_opnd_imm(val), mir_opnd_none())
                        changed = true
                    end
                end
                if not changed and op == MirOp.Add and t2 == MirOperandType.Imm and mir_opnd_imm_val(s2) == 0 do
                    repl = mir_instr_new(MirOp.Move, dst, s1, mir_opnd_none())
                    changed = true
                end
                if not changed and op == MirOp.Add and t1 == MirOperandType.Imm and mir_opnd_imm_val(s1) == 0 do
                    repl = mir_instr_new(MirOp.Move, dst, s2, mir_opnd_none())
                    changed = true
                end
                if not changed and op == MirOp.Sub and t2 == MirOperandType.Imm and mir_opnd_imm_val(s2) == 0 do
                    repl = mir_instr_new(MirOp.Move, dst, s1, mir_opnd_none())
                    changed = true
                end
                if not changed and op == MirOp.Sub and mir_opnd_is_same(s1, s2) do
                    repl = mir_instr_new(MirOp.Move, dst, mir_opnd_imm(0), mir_opnd_none())
                    changed = true
                end
                if not changed and op == MirOp.Mul and t2 == MirOperandType.Imm and mir_opnd_imm_val(s2) == 1 do
                    repl = mir_instr_new(MirOp.Move, dst, s1, mir_opnd_none())
                    changed = true
                end
                if not changed and op == MirOp.Mul and t1 == MirOperandType.Imm and mir_opnd_imm_val(s1) == 1 do
                    repl = mir_instr_new(MirOp.Move, dst, s2, mir_opnd_none())
                    changed = true
                end
                if not changed and op == MirOp.Mul and ((t1 == MirOperandType.Imm and mir_opnd_imm_val(s1) == 0) or (t2 == MirOperandType.Imm and mir_opnd_imm_val(s2) == 0)) do
                    repl = mir_instr_new(MirOp.Move, dst, mir_opnd_imm(0), mir_opnd_none())
                    changed = true
                end
                if not changed and op == MirOp.Div and t2 == MirOperandType.Imm and mir_opnd_imm_val(s2) == 1 do
                    repl = mir_instr_new(MirOp.Move, dst, s1, mir_opnd_none())
                    changed = true
                end
                if not changed and op == MirOp.And and ((t1 == MirOperandType.Imm and mir_opnd_imm_val(s1) == 0) or (t2 == MirOperandType.Imm and mir_opnd_imm_val(s2) == 0)) do
                    repl = mir_instr_new(MirOp.Move, dst, mir_opnd_imm(0), mir_opnd_none())
                    changed = true
                end
                if not changed and op == MirOp.And and t2 == MirOperandType.Imm and mir_opnd_imm_val(s2) == (0 - 1) do
                    repl = mir_instr_new(MirOp.Move, dst, s1, mir_opnd_none())
                    changed = true
                end
                if not changed and op == MirOp.And and t1 == MirOperandType.Imm and mir_opnd_imm_val(s1) == (0 - 1) do
                    repl = mir_instr_new(MirOp.Move, dst, s2, mir_opnd_none())
                    changed = true
                end
                if not changed and op == MirOp.Or and t2 == MirOperandType.Imm and mir_opnd_imm_val(s2) == 0 do
                    repl = mir_instr_new(MirOp.Move, dst, s1, mir_opnd_none())
                    changed = true
                end
                if not changed and op == MirOp.Or and t1 == MirOperandType.Imm and mir_opnd_imm_val(s1) == 0 do
                    repl = mir_instr_new(MirOp.Move, dst, s2, mir_opnd_none())
                    changed = true
                end
                if not changed and op == MirOp.Xor and t2 == MirOperandType.Imm and mir_opnd_imm_val(s2) == 0 do
                    repl = mir_instr_new(MirOp.Move, dst, s1, mir_opnd_none())
                    changed = true
                end
                if not changed and op == MirOp.Xor and t1 == MirOperandType.Imm and mir_opnd_imm_val(s1) == 0 do
                    repl = mir_instr_new(MirOp.Move, dst, s2, mir_opnd_none())
                    changed = true
                end
                if not changed and (op == MirOp.Xor or op == MirOp.Or or op == MirOp.And) and mir_opnd_is_same(s1, s2) do
                    if op == MirOp.Xor do
                        repl = mir_instr_new(MirOp.Move, dst, mir_opnd_imm(0), mir_opnd_none())
                    else
                        repl = mir_instr_new(MirOp.Move, dst, s1, mir_opnd_none())
                    end
                    changed = true
                end
                if not changed and (op == MirOp.CmpEq or op == MirOp.CmpGe or op == MirOp.CmpLe) and mir_opnd_is_same(s1, s2) do
                    repl = mir_instr_new(MirOp.Move, dst, mir_opnd_imm(1), mir_opnd_none())
                    changed = true
                end
                if not changed and (op == MirOp.CmpNe or op == MirOp.CmpGt or op == MirOp.CmpLt) and mir_opnd_is_same(s1, s2) do
                    repl = mir_instr_new(MirOp.Move, dst, mir_opnd_imm(0), mir_opnd_none())
                    changed = true
                end
                if changed do
                    vec_set_rt(instrs, j, repl)
                    mir_opt_note_change()
                end
                j = j + 1
            end
        end
        i = i + 1
    end
    out blocks
end.

func mir_opt_branch_folding(blocks: i64):
    n_blocks = vec_len_rt(blocks)
    var i = 0
    when i < n_blocks loop
        instrs = mir_block_head(vec_get_rt(blocks, i))
        if instrs >= 0 do
            n_instrs = vec_len_rt(instrs)
            var j = 0
            when j < n_instrs loop
                ins = vec_get_rt(instrs, j)
                op = mir_instr_op(ins)
                cond = mir_instr_src1(ins)
                target = mir_instr_src2(ins)
                if op == MirOp.JumpIf and mir_opnd_type(cond) == MirOperandType.Imm do
                    if mir_opnd_imm_val(cond) != 0 do
                        vec_set_rt(instrs, j, mir_instr_new(MirOp.Jump, mir_opnd_none(), target, mir_opnd_none()))
                    else
                        vec_set_rt(instrs, j, mir_instr_new(MirOp.Nop, mir_opnd_none(), mir_opnd_none(), mir_opnd_none()))
                    end
                    mir_opt_note_change()
                eif op == MirOp.JumpIfNot and mir_opnd_type(cond) == MirOperandType.Imm do
                    if mir_opnd_imm_val(cond) == 0 do
                        vec_set_rt(instrs, j, mir_instr_new(MirOp.Jump, mir_opnd_none(), target, mir_opnd_none()))
                    else
                        vec_set_rt(instrs, j, mir_instr_new(MirOp.Nop, mir_opnd_none(), mir_opnd_none(), mir_opnd_none()))
                    end
                    mir_opt_note_change()
                end
                j = j + 1
            end
        end
        i = i + 1
    end
    out blocks
end.

func mir_opt_phi_simplification(blocks: i64):
    n_blocks = vec_len_rt(blocks)
    var i = 0
    when i < n_blocks loop
        b = vec_get_rt(blocks, i)
        phis = mir_block_phis(b)
        if phis >= 0 do
            n_phis = vec_len_rt(phis)
            var p = 0
            when p < n_phis loop
                phi = vec_get_rt(phis, p)
                vals = mir_phi_incoming_values(phi)
                n_vals = vec_len_rt(vals)
                if n_vals > 0 do
                    first = vec_get_rt(vals, 0)
                    all_same = true
                    var k = 1
                    when k < n_vals loop
                        if not mir_opnd_is_same(first, vec_get_rt(vals, k)) do
                            all_same = false
                        end
                        k = k + 1
                    end
                    if all_same do
                        blocks = mir_rewrite_uses_from(blocks, mir_phi_dst(phi), first)
                        empty_vals = vec_new_rt()
                        empty_blocks = vec_new_rt()
                        vec_set_rt(phis, p, mir_phi_new(mir_phi_dst(phi), mir_phi_orig_vreg(phi), empty_vals, empty_blocks, 0))
                        mir_opt_note_change()
                    end
                end
                p = p + 1
            end
        end
        i = i + 1
    end
    out blocks
end.

# Remove phi placeholders left behind by mir_opt_phi_simplification.  A
# simplified phi has no incoming values and must not reserve a register slot
# for later lowering or allocation.
func mir_opt_sweep_dead_phis(blocks: i64):
    n_blocks = vec_len_rt(blocks)
    var i = 0
    when i < n_blocks loop
        b = vec_get_rt(blocks, i)
        phis = mir_block_phis(b)
        if phis >= 0 do
            live_phis = vec_new_rt()
            n_phis = vec_len_rt(phis)
            var p = 0
            when p < n_phis loop
                phi = vec_get_rt(phis, p)
                if vec_len_rt(mir_phi_incoming_values(phi)) > 0 do
                    live_phis = vec_push_rt(live_phis, phi)
                else
                    mir_opt_note_change()
                end
                p = p + 1
            end
            b_new = mir_block_new(
                mir_block_id(b),
                live_phis,
                mir_block_head(b),
                mir_block_tail(b),
                mir_block_successors(b),
                mir_block_preds(b),
                mir_block_idom(b),
                mir_block_dom_children(b),
                mir_block_df(b),
                mir_block_next_block(b)
            )
            vec_set_rt(blocks, i, b_new)
        end
        i = i + 1
    end
    out blocks
end.

func mir_terminates_control(op: i64):
    out mir_is_control_terminator(op)
end.

func mir_opt_cfg_simplification(blocks: i64):
    n_blocks = vec_len_rt(blocks)
    var i = 0
    when i < n_blocks loop
        instrs = mir_block_head(vec_get_rt(blocks, i))
        if instrs >= 0 do
            n_instrs = vec_len_rt(instrs)
            var terminated = false
            var j = 0
            when j < n_instrs loop
                ins = vec_get_rt(instrs, j)
                op = mir_instr_op(ins)
                if terminated do
                    if op != MirOp.Nop do
                        vec_set_rt(instrs, j, mir_instr_new(MirOp.Nop, mir_opnd_none(), mir_opnd_none(), mir_opnd_none()))
                        mir_opt_note_change()
                    end
                eif mir_terminates_control(op) do
                    terminated = true
                end
                j = j + 1
            end
        end
        i = i + 1
    end
    out blocks
end.

##
 * mir_opt_redundant_load_store_elimination — Eliminates redundant load/store & forwards values.
 ##
func mir_opt_redundant_load_store_elimination(blocks: i64):
    n_blocks = vec_len_rt(blocks)
    var b_idx = 0
    when b_idx < n_blocks loop
        b = vec_get_rt(blocks, b_idx)
        instrs = mir_block_head(b)
        if instrs >= 0 do
            n_ins = vec_len_rt(instrs)
            var i = 0
            when i < n_ins loop
                ins = vec_get_rt(instrs, i)
                op = mir_instr_op(ins)
                
                if op == MirOp.Load do
                    ld_dst0 = mir_instr_dst(ins)
                    ld_ptr0 = mir_instr_src1(ins)
                    ld_off0 = mir_instr_src2(ins)
                    var j_load = i + 1
                    var stop_load = 0
                    when j_load < n_ins and stop_load == 0 loop
                        ins_load2 = vec_get_rt(instrs, j_load)
                        op_load2 = mir_instr_op(ins_load2)
                        if op_load2 == MirOp.Load do
                            if mir_opnd_is_same(ld_ptr0, mir_instr_src1(ins_load2)) and mir_opnd_is_same(ld_off0, mir_instr_src2(ins_load2)) do
                                vec_set_rt(instrs, j_load, mir_instr_new(MirOp.Move, mir_instr_dst(ins_load2), ld_dst0, mir_opnd_none()))
                                mir_opt_note_change()
                            end
                        end
                        if mir_memory_barrier(op_load2) do
                            stop_load = 1
                        end
                        j_load = j_load + 1
                    end
                end

                if op == MirOp.Store do
                    st_ptr = mir_instr_dst(ins)
                    st_off = mir_instr_src1(ins)
                    st_val = mir_instr_src2(ins)
                    
                    var j = i + 1
                    var stop = 0
                    when j < n_ins and stop == 0 loop
                        ins2 = vec_get_rt(instrs, j)
                        op2 = mir_instr_op(ins2)
                        if op2 == MirOp.Load do
                            ld_dst = mir_instr_dst(ins2)
                            ld_ptr = mir_instr_src1(ins2)
                            ld_off = mir_instr_src2(ins2)
                            if mir_opnd_is_same(st_ptr, ld_ptr) and mir_opnd_is_same(st_off, ld_off) do
                                ins_fwd = mir_instr_new(MirOp.Move, ld_dst, st_val, mir_opnd_none())
                                vec_set_rt(instrs, j, ins_fwd)
                                mir_opt_note_change()
                            end
                        eif op2 == MirOp.Store do
                            st2_ptr = mir_instr_dst(ins2)
                            st2_off = mir_instr_src1(ins2)
                            if mir_opnd_is_same(st_ptr, st2_ptr) and mir_opnd_is_same(st_off, st2_off) do
                                vec_set_rt(instrs, i, mir_instr_new(MirOp.Nop, mir_opnd_none(), mir_opnd_none(), mir_opnd_none()))
                                mir_opt_note_change()
                                stop = 1
                            else
                                stop = 1
                            end
                        eif mir_memory_barrier(op2) do
                            stop = 1
                        end
                        j = j + 1
                    end
                end
                i = i + 1
            end
        end
        b_idx = b_idx + 1
    end
    out blocks
end.

func mir_memory_barrier(op: i64):
    out op == MirOp.Store or op == MirOp.Call or op == MirOp.Intrinsic or op == MirOp.Jump or op == MirOp.JumpIf or op == MirOp.JumpIfNot or op == MirOp.Return
end.

##
 * mir_opt_arm64_instruction_selection_and_scheduling — Immediate folding & MADD/MSUB fusion.
 ##
func mir_arm64_trace_vreg_def(instrs: i64, before_idx: i64, vreg: i64):
  var k = before_idx - 1
  when k >= 0 loop
    ins = vec_get_rt(instrs, k)
    if mir_instr_defines_vreg(ins, vreg) do
      out ins
    end
    k = k - 1
  end
  out mir_instr_new(MirOp.Nop, mir_opnd_none(), mir_opnd_none(), mir_opnd_none())
end.

func mir_opt_arm64_instruction_selection_and_scheduling(blocks: i64):
    n_blocks = vec_len_rt(blocks)
    var b_idx = 0
    when b_idx < n_blocks loop
        b = vec_get_rt(blocks, b_idx)
        instrs = mir_block_head(b)
        if instrs >= 0 do
            n_ins = vec_len_rt(instrs)
            var i = 0
            when i < n_ins loop
                ins = vec_get_rt(instrs, i)
                op = mir_instr_op(ins)
                dst = mir_instr_dst(ins)
                s1 = mir_instr_src1(ins)
                s2 = mir_instr_src2(ins)

                if op == MirOp.Mul do
                    if mir_opnd_type(s2) == MirOperandType.Imm do
                        v = mir_opnd_imm_val(s2)
                        if mir_is_pow2(v) do
                            vec_set_rt(instrs, i, mir_instr_new(MirOp.Shl, dst, s1, mir_opnd_imm(mir_log2(v))))
                            mir_opt_note_change()
                        end
                    eif mir_opnd_type(s1) == MirOperandType.Imm do
                        v = mir_opnd_imm_val(s1)
                        if mir_is_pow2(v) do
                            vec_set_rt(instrs, i, mir_instr_new(MirOp.Shl, dst, s2, mir_opnd_imm(mir_log2(v))))
                            mir_opt_note_change()
                        end
                    end
                end

                if op == MirOp.Add do
                    fused = false
                    if mir_opnd_type(s1) == MirOperandType.VReg do
                        mul_ins = mir_arm64_trace_vreg_def(instrs, i, mir_opnd_vreg_id(s1))
                        if mir_instr_op(mul_ins) == MirOp.Mul do
                            ma = mir_instr_src1(mul_ins)
                            mb = mir_instr_src2(mul_ins)
                            vec_set_rt(instrs, i, mir_instr_new(MirOp.Fma, dst, ma, mb, s2))
                            mir_opt_note_change()
                            fused = true
                        end
                    end
                    if not fused and mir_opnd_type(s2) == MirOperandType.VReg do
                        mul_ins2 = mir_arm64_trace_vreg_def(instrs, i, mir_opnd_vreg_id(s2))
                        if mir_instr_op(mul_ins2) == MirOp.Mul do
                            ma2 = mir_instr_src1(mul_ins2)
                            mb2 = mir_instr_src2(mul_ins2)
                            vec_set_rt(instrs, i, mir_instr_new(MirOp.Fma, dst, ma2, mb2, s1))
                            mir_opt_note_change()
                        end
                    end
                end

                i = i + 1
            end
        end
        b_idx = b_idx + 1
    end
    out blocks
end.

##
 * mir_opt_zero_cost_abi_and_semantics_tuning — Leaf stripping, unboxed primitives, BCE.
 ##
func mir_opt_zero_cost_abi_and_semantics_tuning(blocks: i64):
    n_blocks = vec_len_rt(blocks)
    var b_idx = 0
    when b_idx < n_blocks loop
        b = vec_get_rt(blocks, b_idx)
        instrs = mir_block_head(b)
        if instrs >= 0 do
            n_ins = vec_len_rt(instrs)
            var i = 0
            when i < n_ins loop
                ins = vec_get_rt(instrs, i)
                op = mir_instr_op(ins)
                dst = mir_instr_dst(ins)
                s1 = mir_instr_src1(ins)
                s2 = mir_instr_src2(ins)
                s1_t = mir_opnd_type(s1)
                s2_t = mir_opnd_type(s2)

                if op == MirOp.Move do
                    if mir_opnd_is_same(dst, s1) do
                        vec_set_rt(instrs, i, mir_instr_new(MirOp.Nop, mir_opnd_none(), mir_opnd_none(), mir_opnd_none()))
                        mir_opt_note_change()
                    end
                end

                if op == MirOp.Add or op == MirOp.Sub do
                    if s2_t == MirOperandType.Imm and mir_opnd_imm_val(s2) == 0 do
                        vec_set_rt(instrs, i, mir_instr_new(MirOp.Move, dst, s1, mir_opnd_none()))
                        mir_opt_note_change()
                    eif s1_t == MirOperandType.Imm and mir_opnd_imm_val(s1) == 0 and op == MirOp.Add do
                        vec_set_rt(instrs, i, mir_instr_new(MirOp.Move, dst, s2, mir_opnd_none()))
                        mir_opt_note_change()
                    end
                end

                if op == MirOp.Mul do
                    if (s2_t == MirOperandType.Imm and mir_opnd_imm_val(s2) == 1) or (s1_t == MirOperandType.Imm and mir_opnd_imm_val(s1) == 1) do
                        mv_src = s1
                        if s2_t == MirOperandType.Imm and mir_opnd_imm_val(s2) == 1 do mv_src = s1 end
                        if s1_t == MirOperandType.Imm and mir_opnd_imm_val(s1) == 1 do mv_src = s2 end
                        vec_set_rt(instrs, i, mir_instr_new(MirOp.Move, dst, mv_src, mir_opnd_none()))
                        mir_opt_note_change()
                    end
                end

                if op == MirOp.Div or op == MirOp.Mod do
                    if s2_t == MirOperandType.Imm and mir_opnd_imm_val(s2) == 1 do
                        vec_set_rt(instrs, i, mir_instr_new(MirOp.Move, dst, s1, mir_opnd_none()))
                        mir_opt_note_change()
                    end
                end

                if op == MirOp.Shl or op == MirOp.Shr do
                    if s2_t == MirOperandType.Imm and mir_opnd_imm_val(s2) == 0 do
                        vec_set_rt(instrs, i, mir_instr_new(MirOp.Move, dst, s1, mir_opnd_none()))
                        mir_opt_note_change()
                    end
                end

                i = i + 1
            end
        end
        b_idx = b_idx + 1
    end
    out blocks
end.

##
 * mir_opt_inline_bump_arena_fastpath — Pre-aligns constant allocations to 16 bytes.
 ##
func mir_opt_inline_bump_arena_fastpath(blocks: i64):
    n_blocks = vec_len_rt(blocks)
    var b_idx = 0
    when b_idx < n_blocks loop
        b = vec_get_rt(blocks, b_idx)
        instrs = mir_block_head(b)
        if instrs >= 0 do
            n_ins = vec_len_rt(instrs)
            var i = 0
            when i < n_ins loop
                ins = vec_get_rt(instrs, i)
                op = mir_instr_op(ins)
                if op == MirOp.Intrinsic do
                    s2 = mir_instr_src2(ins)
                    if mir_opnd_type(s2) == MirOperandType.Imm and mir_opnd_imm_val(s2) == MIR_INTR_BUILTIN do
                        s1 = mir_instr_src1(ins)
                        if mir_opnd_type(s1) == MirOperandType.Imm do
                            bid = mir_opnd_imm_val(s1)
                            if bid == 3 or bid == 50 do
                                if i > 0 do
                                    p_ins = vec_get_rt(instrs, i - 1)
                                    if mir_instr_op(p_ins) == MirOp.SetArg do
                                        arg_val = mir_instr_src2(p_ins)
                                        if mir_opnd_type(arg_val) == MirOperandType.Imm do
                                            raw_sz = mir_opnd_imm_val(arg_val)
                                            aligned_sz = ((raw_sz + 15) / 16) * 16
                                            vec_set_rt(instrs, i - 1, mir_instr_new(MirOp.SetArg, mir_instr_dst(p_ins), mir_instr_src1(p_ins), mir_opnd_imm(aligned_sz)))
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
                i = i + 1
            end
        end
        b_idx = b_idx + 1
    end
    out blocks
end.

##
 * mir_opt_arm64_addressing_modes_and_register_induction — Base-register offset folding.
 ##
func mir_opt_arm64_addressing_modes_and_register_induction(blocks: i64):
    n_blocks = vec_len_rt(blocks)
    var b_idx = 0
    when b_idx < n_blocks loop
        b = vec_get_rt(blocks, b_idx)
        instrs = mir_block_head(b)
        if instrs >= 0 do
            n_ins = vec_len_rt(instrs)
            var i = 0
            when i < n_ins loop
                ins = vec_get_rt(instrs, i)
                op = mir_instr_op(ins)
                if op == MirOp.Load or op == MirOp.Store do
                    dst = mir_instr_dst(ins)
                    ptr = mir_instr_src1(ins)
                    off = mir_instr_src2(ins)
                    if mir_opnd_type(off) == MirOperandType.Imm and mir_opnd_imm_val(off) == 0 and i > 0 do
                        prev = vec_get_rt(instrs, i - 1)
                        if mir_instr_op(prev) == MirOp.Add do
                            add_dst = mir_instr_dst(prev)
                            if mir_opnd_is_same(add_dst, ptr) do
                                base = mir_instr_src1(prev)
                                imm = mir_instr_src2(prev)
                                if mir_opnd_type(imm) == MirOperandType.Imm do
                                    if op == MirOp.Load do
                                        new_ins = mir_instr_new(MirOp.Load, dst, base, imm)
                                        mir_instr_set_aux(new_ins, mir_instr_aux(ins))
                                        mir_instr_set_type(new_ins, mir_instr_type(ins))
                                        vec_set_rt(instrs, i, new_ins)
                                    else
                                        st_val = mir_instr_src2(ins)
                                        new_ins = mir_instr_new(MirOp.Store, base, imm, st_val)
                                        mir_instr_set_aux(new_ins, mir_instr_aux(ins))
                                        mir_instr_set_type(new_ins, mir_instr_type(ins))
                                        vec_set_rt(instrs, i, new_ins)
                                    end
                                    vec_set_rt(instrs, i - 1, mir_instr_new(MirOp.Nop, mir_opnd_none(), mir_opnd_none(), mir_opnd_none()))
                                    mir_opt_note_change()
                                end
                            end
                        end
                    end
                end
                i = i + 1
            end
        end
        b_idx = b_idx + 1
    end
    out blocks
end.

func mir_trace_source_opnd(instrs: i64, limit_idx: i64, opnd: MirOperand):
    var cur = opnd
    var keep_going = true
    when keep_going loop
        keep_going = false
        if mir_opnd_type(cur) == MirOperandType.VReg do
            v = mir_opnd_vreg_id(cur)
            var k = limit_idx - 1
            when k >= 0 and not keep_going loop
                ins = vec_get_rt(instrs, k)
                if mir_instr_op(ins) == MirOp.Move do
                    dst = mir_instr_dst(ins)
                    if mir_opnd_type(dst) == MirOperandType.VReg and mir_opnd_vreg_id(dst) == v do
                        cur = mir_instr_src1(ins)
                        keep_going = true
                    end
                end
                k = k - 1
            end
        end
    end
    out cur
end.

##
 * mir_opt_loop_idiom_recognizer — Pattern match hot loop idioms and rewrite to optimized kernels.
 ##
func mir_opt_loop_idiom_recognizer(blocks: i64):
    n_blocks = vec_len_rt(blocks)
    var i = 0
    when i < (n_blocks - 1) loop
        cond_b = vec_get_rt(blocks, i)
        cond_id = mir_block_id(cond_b)
        cond_instrs = mir_block_head(cond_b)
        if cond_instrs >= 0 do
            n_cond_ins = vec_len_rt(cond_instrs)
            if n_cond_ins >= 3 do
                ins_jump = vec_get_rt(cond_instrs, n_cond_ins - 1)
                ins_jin = vec_get_rt(cond_instrs, n_cond_ins - 2)
                ins_cmp = vec_get_rt(cond_instrs, n_cond_ins - 3)
                if mir_instr_op(ins_jump) == MirOp.Jump and mir_instr_op(ins_jin) == MirOp.JumpIfNot do
                    exit_opnd = mir_instr_src2(ins_jin)
                    body_opnd = mir_instr_src1(ins_jump)
                    body_id = mir_opnd_imm_val(body_opnd)
                    op_cmp = mir_instr_op(ins_cmp)
                    if (op_cmp == MirOp.CmpLe or op_cmp == MirOp.CmpLt) do
                        s1_cmp = mir_instr_src1(ins_cmp)
                        s2_cmp = mir_instr_src2(ins_cmp)
                        body_b = vec_get_rt(blocks, i + 1)
                        if mir_block_id(body_b) == body_id do
                            body_instrs = mir_block_head(body_b)
                            if body_instrs >= 0 do
                                n_body_ins = vec_len_rt(body_instrs)
                                if n_body_ins >= 4 do
                                    ins_body_jump = vec_get_rt(body_instrs, n_body_ins - 1)
                                    if mir_instr_op(ins_body_jump) == MirOp.Jump and mir_opnd_imm_val(mir_instr_src1(ins_body_jump)) == cond_id do
                                        var has_write_byte = 0
                                        var buf_opnd = mir_opnd_none()
                                        var val_opnd = mir_opnd_none()
                                        var bi_idx = 0
                                        when bi_idx < (n_body_ins - 1) loop
                                            b_ins = vec_get_rt(body_instrs, bi_idx)
                                            if mir_instr_op(b_ins) == MirOp.Intrinsic do
                                                s1_intr = mir_instr_src1(b_ins)
                                                s2_intr = mir_instr_src2(b_ins)
                                                if mir_opnd_type(s2_intr) == MirOperandType.Imm and mir_opnd_imm_val(s2_intr) == 8 do
                                                    if mir_opnd_type(s1_intr) == MirOperandType.Imm and mir_opnd_imm_val(s1_intr) == 6 do
                                                        if bi_idx >= 3 do
                                                            sa0 = vec_get_rt(body_instrs, bi_idx - 3)
                                                            sa1 = vec_get_rt(body_instrs, bi_idx - 2)
                                                            sa2 = vec_get_rt(body_instrs, bi_idx - 1)
                                                            if mir_instr_op(sa0) == MirOp.SetArg and mir_instr_op(sa1) == MirOp.SetArg and mir_instr_op(sa2) == MirOp.SetArg do
                                                                buf_opnd = mir_trace_source_opnd(body_instrs, bi_idx - 3, mir_instr_src2(sa0))
                                                                val_opnd = mir_trace_source_opnd(body_instrs, bi_idx - 1, mir_instr_src2(sa2))
                                                                has_write_byte = 1
                                                            end
                                                        end
                                                    end
                                                end
                                            end
                                            bi_idx = bi_idx + 1
                                        end
                                        var is_step_one = 0
                                        var step_k = 0
                                        when step_k < n_body_ins loop
                                            ins_step = vec_get_rt(body_instrs, step_k)
                                            if mir_instr_op(ins_step) == MirOp.Add do
                                                s1_add = mir_trace_source_opnd(body_instrs, step_k, mir_instr_src1(ins_step))
                                                s2_add = mir_trace_source_opnd(body_instrs, step_k, mir_instr_src2(ins_step))
                                                if (mir_opnd_type(s1_add) == MirOperandType.Imm and mir_opnd_imm_val(s1_add) == 1) or (mir_opnd_type(s2_add) == MirOperandType.Imm and mir_opnd_imm_val(s2_add) == 1) do
                                                    is_step_one = 1
                                                end
                                            end
                                            step_k = step_k + 1
                                        end
                                        var val_is_invariant = 0
                                        if mir_opnd_type(val_opnd) == MirOperandType.Imm do
                                            val_is_invariant = 1
                                        eif mir_opnd_type(val_opnd) == MirOperandType.VReg do
                                            var v_def_in_body = 0
                                            var vi = 0
                                            let target_v = mir_opnd_vreg_id(val_opnd)
                                            when vi < n_body_ins loop
                                                let b_ins_chk = vec_get_rt(body_instrs, vi)
                                                let dst_chk = mir_instr_dst(b_ins_chk)
                                                if mir_opnd_type(dst_chk) == MirOperandType.VReg and mir_opnd_vreg_id(dst_chk) == target_v do
                                                    v_def_in_body = 1
                                                end
                                                vi = vi + 1
                                            end
                                            if v_def_in_body == 0 do
                                                val_is_invariant = 1
                                            end
                                        end
                                        # Check that the buffer pointer is also loop-invariant
                                        # (i.e. not defined inside the loop body). If buf_opnd is a VReg
                                        # whose definition is inside body_instrs, the buffer changes every
                                        # iteration (e.g. `let p = alloc(64)`) and must NOT be rewritten.
                                        var buf_is_invariant = 0
                                        if mir_opnd_type(buf_opnd) == MirOperandType.Imm do
                                            buf_is_invariant = 1
                                        eif mir_opnd_type(buf_opnd) == MirOperandType.VReg do
                                            var buf_def_in_body = 0
                                            let buf_vreg_id = mir_opnd_vreg_id(buf_opnd)
                                            var bvi = 0
                                            when bvi < n_body_ins loop
                                                let b_chk2 = vec_get_rt(body_instrs, bvi)
                                                let dst_b2 = mir_instr_dst(b_chk2)
                                                if mir_opnd_type(dst_b2) == MirOperandType.VReg and mir_opnd_vreg_id(dst_b2) == buf_vreg_id do
                                                    buf_def_in_body = 1
                                                end
                                                bvi = bvi + 1
                                            end
                                            if buf_def_in_body == 0 do
                                                buf_is_invariant = 1
                                            end
                                        end
                                        if has_write_byte == 1 and is_step_one == 1 and val_is_invariant == 1 and buf_is_invariant == 1 do
                                            real_limit = mir_trace_source_opnd(cond_instrs, n_cond_ins - 3, s2_cmp)
                                            len_opnd = real_limit
                                            if op_cmp == MirOp.CmpLe do
                                                if mir_opnd_type(real_limit) == MirOperandType.Imm do
                                                    len_opnd = mir_opnd_imm(mir_opnd_imm_val(real_limit) + 1)
                                                end
                                            end
                                            ins_sa0 = mir_instr_new(MirOp.SetArg, mir_opnd_none(), mir_opnd_imm(0), buf_opnd)
                                            ins_sa1 = mir_instr_new(MirOp.SetArg, mir_opnd_none(), mir_opnd_imm(1), val_opnd)
                                            ins_sa2 = mir_instr_new(MirOp.SetArg, mir_opnd_none(), mir_opnd_imm(2), len_opnd)
                                            ins_memset = mir_instr_new(MirOp.Intrinsic, mir_opnd_none(), mir_opnd_imm(32), mir_opnd_imm(8))
                                            ins_exit_jump = mir_instr_new(MirOp.Jump, mir_opnd_none(), exit_opnd, mir_opnd_none())
                                            var ck = 0
                                            when ck < (n_cond_ins - 3) loop
                                                vec_set_rt(cond_instrs, ck, mir_instr_new(MirOp.Nop, mir_opnd_none(), mir_opnd_none(), mir_opnd_none()))
                                                ck = ck + 1
                                            end
                                            vec_set_rt(cond_instrs, n_cond_ins - 3, ins_sa0)
                                            vec_set_rt(cond_instrs, n_cond_ins - 2, ins_sa1)
                                            vec_set_rt(cond_instrs, n_cond_ins - 1, ins_sa2)
                                            cond_instrs = vec_push_rt(cond_instrs, ins_memset)
                                            cond_instrs = vec_push_rt(cond_instrs, ins_exit_jump)
                                            var bk = 0
                                            when bk < n_body_ins loop
                                                vec_set_rt(body_instrs, bk, mir_instr_new(MirOp.Nop, mir_opnd_none(), mir_opnd_none(), mir_opnd_none()))
                                                bk = bk + 1
                                            end
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
        i = i + 1
    end
    out blocks
end.

##
 * vir/compiler/mir_opt_advanced.vri — Spec §1.2.1 advanced MIR passes
 * Included by mir_opt.vri (shares its imports and helpers).
 ##

func mir_strings_get(strings: i64, idx: i64):
    if strings < 0 do out "" end
    if idx < 0 or idx >= vec_len_rt(strings) do out "" end
    out vec_get_rt(strings, idx)
end.

func mir_program_find_func(program: i64, name: string):
    if program < 0 do out 0 end
    var fi = 0
    when fi < vec_len_rt(program) loop
        f = vec_get_rt(program, fi)
        if rt_streq(mir_func_name(f), name) do out f end
        fi = fi + 1
    end
    out 0
end.

func mir_count_all_instrs(blocks: i64):
    total = 0
    var bi = 0
    when bi < vec_len_rt(blocks) loop
        instrs = mir_block_head(vec_get_rt(blocks, bi))
        if instrs >= 0 do total = total + vec_len_rt(instrs) end
        bi = bi + 1
    end
    out total
end.

func mir_blocks_contain_call(blocks: i64):
    var bi = 0
    when bi < vec_len_rt(blocks) loop
        instrs = mir_block_head(vec_get_rt(blocks, bi))
        if instrs >= 0 do
            var ii = 0
            when ii < vec_len_rt(instrs) loop
                if mir_instr_op(vec_get_rt(instrs, ii)) == MirOp.Call do out true end
                ii = ii + 1
            end
        end
        bi = bi + 1
    end
    out false
end.

func mir_vreg_is_induction_step(blocks: i64, body_idx: i64, v: i64):
    instrs = mir_block_head(vec_get_rt(blocks, body_idx))
    if instrs < 0 do out (false, 0) end
    var ii = 0
    when ii < vec_len_rt(instrs) loop
        ins = vec_get_rt(instrs, ii)
        if mir_instr_op(ins) == MirOp.Add do
            dst = mir_instr_dst(ins)
            if mir_opnd_type(dst) == MirOperandType.VReg and mir_opnd_vreg_id(dst) == v do
                s1 = mir_instr_src1(ins)
                s2 = mir_instr_src2(ins)
                if mir_opnd_type(s2) == MirOperandType.Imm and mir_opnd_imm_val(s2) == 1 do
                    if mir_opnd_type(s1) == MirOperandType.VReg and mir_opnd_vreg_id(s1) == v do
                        out (true, 1)
                    end
                end
                if mir_opnd_type(s1) == MirOperandType.Imm and mir_opnd_imm_val(s1) == 1 do
                    if mir_opnd_type(s2) == MirOperandType.VReg and mir_opnd_vreg_id(s2) == v do
                        out (true, 1)
                    end
                end
            end
        end
        ii = ii + 1
    end
    out (false, 0)
end.

func mir_inline_remap_opnd(opnd: MirOperand, param_vregs: i64, arg_vals: i64, vreg_base: i64):
    if mir_opnd_type(opnd) != MirOperandType.VReg do out opnd end
    vid = mir_opnd_vreg_id(opnd)
    if param_vregs >= 0 do
        var pi = 0
        when pi < vec_len_rt(param_vregs) loop
            if vec_get_rt(param_vregs, pi) == vid do
                out vec_get_rt(arg_vals, pi)
            end
            pi = pi + 1
        end
    end
    out mir_opnd_vreg(vreg_base + vid)
end.

func mir_inline_clone_instr(ins: MirInstr, param_vregs: i64, arg_vals: i64, vreg_base: i64):
    op = mir_instr_op(ins)
    dst = mir_inline_remap_opnd(mir_instr_dst(ins), param_vregs, arg_vals, vreg_base)
    s1 = mir_inline_remap_opnd(mir_instr_src1(ins), param_vregs, arg_vals, vreg_base)
    s2 = mir_inline_remap_opnd(mir_instr_src2(ins), param_vregs, arg_vals, vreg_base)
    if op == MirOp.Return do
        out mir_instr_new(MirOp.Move, dst, s1, mir_opnd_none())
    end
    if op == MirOp.Intrinsic do
        s2k = mir_instr_src2(ins)
        if mir_opnd_type(s2k) == MirOperandType.Imm and mir_opnd_imm_val(s2k) == MIR_INTR_PARAM do
            out mir_instr_new(MirOp.Nop, mir_opnd_none(), mir_opnd_none(), mir_opnd_none())
        end
    end
    out mir_instr_new(op, dst, s1, s2)
end.

func mir_opt_collect_call_args(instrs: i64, call_idx: i64, nargs: i64):
    args = vec_new_rt()
    var ai = 0
    when ai < nargs loop
        args = vec_push_rt(args, mir_opnd_none())
        ai = ai + 1
    end
    ci = call_idx - 1
    when ci >= 0 loop
        ins = vec_get_rt(instrs, ci)
        if mir_instr_op(ins) != MirOp.SetArg do
            ci = 0 - 1
        else
            slot = mir_opnd_imm_val(mir_instr_src1(ins))
            if slot >= 0 and slot < nargs do
                vec_set_rt(args, slot, mir_instr_src2(ins))
            end
            ci = ci - 1
        end
    end
    out args
end.

func mir_callee_param_vregs(callee_blocks: i64):
    pmap = vec_new_rt()
    var bi = 0
    when bi < vec_len_rt(callee_blocks) loop
        instrs = mir_block_head(vec_get_rt(callee_blocks, bi))
        if instrs >= 0 do
            var ii = 0
            when ii < vec_len_rt(instrs) loop
                ins = vec_get_rt(instrs, ii)
                if mir_instr_op(ins) == MirOp.Intrinsic do
                    s2 = mir_instr_src2(ins)
                    if mir_opnd_type(s2) == MirOperandType.Imm and mir_opnd_imm_val(s2) == MIR_INTR_PARAM do
                        idx = mir_opnd_imm_val(mir_instr_src1(ins))
                        dst = mir_instr_dst(ins)
                        if mir_opnd_type(dst) == MirOperandType.VReg do
                            var grow = vec_len_rt(pmap)
                            when grow <= idx loop
                                pmap = vec_push_rt(pmap, 0 - 1)
                                grow = grow + 1
                            end
                            vec_set_rt(pmap, idx, mir_opnd_vreg_id(dst))
                        end
                    end
                end
                ii = ii + 1
            end
        end
        bi = bi + 1
    end
    out pmap
end.

##
 * IVSR — pointer induction: Load(base, Mul(iv, es)) + iv++  =>  running pointer.
 ##
func mir_opt_ivsr(blocks: i64):
    n_blocks = vec_len_rt(blocks)
    var hdr_idx = 0
    when hdr_idx < n_blocks loop
        hdr = vec_get_rt(blocks, hdr_idx)
        hdr_id = mir_block_id(hdr)
        succs = mir_block_successors(hdr)
        if succs >= 0 do
            var si = 0
            when si < vec_len_rt(succs) loop
                body_id = vec_get_rt(succs, si)
                body_idx = mir_find_block_index(blocks, body_id)
                if body_idx >= 0 do
                    preds = mir_block_preds(vec_get_rt(blocks, body_idx))
                    var back = 0
                    if preds >= 0 do
                        var pi = 0
                        when pi < vec_len_rt(preds) loop
                            if vec_get_rt(preds, pi) == hdr_id do back = 1 end
                            pi = pi + 1
                        end
                    end
                    if back == 1 do
                        body_instrs = mir_block_head(vec_get_rt(blocks, body_idx))
                        if body_instrs >= 0 do
                            var ii = 0
                            when ii < vec_len_rt(body_instrs) loop
                                ins = vec_get_rt(body_instrs, ii)
                                if mir_instr_op(ins) == MirOp.Load or mir_instr_op(ins) == MirOp.Store do
                                    off = mir_instr_src2(ins)
                                    if mir_opnd_type(off) == MirOperandType.VReg do
                                        ov = mir_opnd_vreg_id(off)
                                        def_ins = mir_arm64_trace_vreg_def(body_instrs, ii, ov)
                                        if mir_instr_op(def_ins) == MirOp.Mul do
                                            ms1 = mir_instr_src1(def_ins)
                                            ms2 = mir_instr_src2(def_ins)
                                            iv = 0 - 1
                                            es = 0
                                            if mir_opnd_type(ms2) == MirOperandType.Imm do
                                                iv = mir_opnd_vreg_id(ms1)
                                                es = mir_opnd_imm_val(ms2)
                                            eif mir_opnd_type(ms1) == MirOperandType.Imm do
                                                iv = mir_opnd_vreg_id(ms2)
                                                es = mir_opnd_imm_val(ms1)
                                            end
                                            var (is_iv, step) = mir_vreg_is_induction_step(blocks, body_idx, iv)
                                            if is_iv and es > 0 do
                                                ptr = mir_instr_src1(ins)
                                                run = mir_instr_dst(def_ins)
                                                if mir_instr_op(ins) == MirOp.Load do
                                                    new_ins = mir_instr_new(MirOp.Load, mir_instr_dst(ins), run, mir_opnd_imm(0))
                                                    mir_instr_set_aux(new_ins, mir_instr_aux(ins))
                                                    mir_instr_set_type(new_ins, mir_instr_type(ins))
                                                    vec_set_rt(body_instrs, ii, new_ins)
                                                else
                                                    new_ins = mir_instr_new(MirOp.Store, run, mir_opnd_imm(0), mir_instr_src2(ins))
                                                    mir_instr_set_aux(new_ins, mir_instr_aux(ins))
                                                    mir_instr_set_type(new_ins, mir_instr_type(ins))
                                                    vec_set_rt(body_instrs, ii, new_ins)
                                                end
                                                vec_set_rt(body_instrs, ii + 1, mir_instr_new(MirOp.Add, run, run, mir_opnd_imm(es)))
                                                mir_opt_note_change()
                                            end
                                        end
                                    end
                                end
                                ii = ii + 1
                            end
                            vec_set_rt(blocks, body_idx, mir_block_replace_head(vec_get_rt(blocks, body_idx), body_instrs))
                        end
                    end
                end
                si = si + 1
            end
        end
        hdr_idx = hdr_idx + 1
    end
    out blocks
end.

##
 * Symbolic loop collapse — sum(0..n-1) via Gauss formula.
 ##
func mir_opt_symbolic_loop_collapse(blocks: i64):
    n_blocks = vec_len_rt(blocks)
    var i = 0
    when i < (n_blocks - 1) loop
        cond_b = vec_get_rt(blocks, i)
        cond_instrs = mir_block_head(cond_b)
        if cond_instrs >= 0 do
            n_cond = vec_len_rt(cond_instrs)
            if n_cond >= 3 do
                ins_jump = vec_get_rt(cond_instrs, n_cond - 1)
                ins_jin = vec_get_rt(cond_instrs, n_cond - 2)
                ins_cmp = vec_get_rt(cond_instrs, n_cond - 3)
                if mir_instr_op(ins_jump) == MirOp.Jump and mir_instr_op(ins_jin) == MirOp.JumpIfNot do
                    exit_opnd = mir_instr_src2(ins_jin)
                    body_id = mir_opnd_imm_val(mir_instr_src1(ins_jump))
                    body_b = vec_get_rt(blocks, i + 1)
                    if mir_block_id(body_b) == body_id do
                        body_instrs = mir_block_head(body_b)
                        if body_instrs >= 0 do
                            n_body = vec_len_rt(body_instrs)
                            cond_id = mir_block_id(cond_b)
                            last_body = vec_get_rt(body_instrs, n_body - 1)
                            # Skip counted loops with a separate step block (body -> step -> cond).
                            if n_body >= 1 and mir_instr_op(last_body) == MirOp.Jump and mir_opnd_imm_val(mir_instr_src1(last_body)) == cond_id do
                            op_cmp = mir_instr_op(ins_cmp)
                            if op_cmp == MirOp.CmpLe or op_cmp == MirOp.CmpLt do
                                limit_op = mir_instr_src2(ins_cmp)
                                iv_op = mir_instr_src1(ins_cmp)
                                var has_sum = 0
                                sum_dst = mir_opnd_none()
                                var bi = 0
                                when bi < (vec_len_rt(body_instrs) - 1) loop
                                    b_ins = vec_get_rt(body_instrs, bi)
                                    if mir_instr_op(b_ins) == MirOp.Add do
                                        s1a = mir_instr_src1(b_ins)
                                        s2a = mir_instr_src2(b_ins)
                                        if mir_opnd_is_same(s1a, iv_op) do
                                            has_sum = 1
                                            sum_dst = mir_instr_dst(b_ins)
                                        eif mir_opnd_is_same(s2a, iv_op) do
                                            has_sum = 1
                                            sum_dst = mir_instr_dst(b_ins)
                                        end
                                    end
                                    bi = bi + 1
                                end
                                if has_sum == 1 and mir_opnd_type(limit_op) == MirOperandType.Imm do
                                    n = mir_opnd_imm_val(limit_op)
                                    if op_cmp == MirOp.CmpLe do n = n + 1 end
                                    gauss = (n * (n - 1)) / 2
                                    ins_mv = mir_instr_new(MirOp.Move, sum_dst, mir_opnd_imm(gauss), mir_opnd_none())
                                    ins_exit = mir_instr_new(MirOp.Jump, mir_opnd_none(), exit_opnd, mir_opnd_none())
                                    var ck = 0
                                    when ck < (n_cond - 3) loop
                                        vec_set_rt(cond_instrs, ck, mir_instr_new(MirOp.Nop, mir_opnd_none(), mir_opnd_none(), mir_opnd_none()))
                                        ck = ck + 1
                                    end
                                    vec_set_rt(cond_instrs, n_cond - 3, ins_mv)
                                    vec_set_rt(cond_instrs, n_cond - 2, ins_exit)
                                    vec_set_rt(cond_instrs, n_cond - 1, mir_instr_new(MirOp.Nop, mir_opnd_none(), mir_opnd_none(), mir_opnd_none()))
                                    var bk = 0
                                    when bk < vec_len_rt(body_instrs) loop
                                        vec_set_rt(body_instrs, bk, mir_instr_new(MirOp.Nop, mir_opnd_none(), mir_opnd_none(), mir_opnd_none()))
                                        bk = bk + 1
                                    end
                                    mir_opt_note_change()
                                end
                            end
                            end
                        end
                    end
                end
            end
        end
        i = i + 1
    end
    out blocks
end.

##
 * BCE — eliminate redundant bounds compares and downgrade SAFE_ACCESS.
 ##
func mir_opt_bce(blocks: i64):
    n_blocks = vec_len_rt(blocks)
    var b_idx = 0
    when b_idx < n_blocks loop
        instrs = mir_block_head(vec_get_rt(blocks, b_idx))
        if instrs >= 0 do
            var i = 0
            when i < vec_len_rt(instrs) loop
                ins = vec_get_rt(instrs, i)
                op = mir_instr_op(ins)
                if op == MirOp.CmpLt or op == MirOp.CmpLe or op == MirOp.CmpGt or op == MirOp.CmpGe do
                    if i > 0 do
                        prev = vec_get_rt(instrs, i - 1)
                        if mir_instr_op(prev) == op do
                            if mir_opnd_is_same(mir_instr_src1(prev), mir_instr_src1(ins)) and mir_opnd_is_same(mir_instr_src2(prev), mir_instr_src2(ins)) do
                                vec_set_rt(instrs, i, mir_instr_new(MirOp.Move, mir_instr_dst(ins), mir_opnd_imm(1), mir_opnd_none()))
                                mir_opt_note_change()
                            end
                        end
                    end
                end
                if op == MirOp.Intrinsic do
                    s2k = mir_instr_src2(ins)
                    if mir_opnd_type(s2k) == MirOperandType.Imm and mir_opnd_imm_val(s2k) == MIR_INTR_SAFE_ACCESS do
                        if i > 0 do
                            prev = vec_get_rt(instrs, i - 1)
                            if mir_instr_op(prev) == MirOp.CmpLt or mir_instr_op(prev) == MirOp.CmpLe do
                                vec_set_rt(instrs, i, mir_instr_new(MirOp.Intrinsic, mir_instr_dst(ins), mir_instr_src1(ins), mir_opnd_imm(MIR_INTR_INDEX)))
                                mir_opt_note_change()
                            end
                        end
                    end
                end
                i = i + 1
            end
        end
        b_idx = b_idx + 1
    end
    out blocks
end.

##
 * PRE — hoist partially-redundant pure exprs into dominating predecessor.
 ##
func mir_opt_pre(blocks: i64):
    n_blocks = vec_len_rt(blocks)
    var b_idx = 0
    when b_idx < n_blocks loop
        b = vec_get_rt(blocks, b_idx)
        succs = mir_block_successors(b)
        if succs >= 0 and vec_len_rt(succs) == 1 do
            succ_id = vec_get_rt(succs, 0)
            succ_idx = mir_find_block_index(blocks, succ_id)
            if succ_idx >= 0 do
                hdr_instrs = mir_block_head(b)
                succ_instrs = mir_block_head(vec_get_rt(blocks, succ_idx))
                if hdr_instrs >= 0 and succ_instrs >= 0 do
                    var si = 0
                    when si < vec_len_rt(succ_instrs) and si < 4 loop
                        sins = vec_get_rt(succ_instrs, si)
                        sop = mir_instr_op(sins)
                        if mir_gvn_candidate(sop) do
                            ss1 = mir_instr_src1(sins)
                            ss2 = mir_instr_src2(sins)
                            if mir_opnd_type(ss1) != MirOperandType.VReg or count_vreg_defs_mir(blocks, mir_opnd_vreg_id(ss1)) == 1 do
                                hdr_instrs = mir_block_insert_before_terminator(hdr_instrs, sins)
                                vec_set_rt(succ_instrs, si, mir_instr_new(MirOp.Move, mir_instr_dst(sins), mir_instr_dst(sins), mir_opnd_none()))
                                mir_opt_note_change()
                            end
                        end
                        si = si + 1
                    end
                    vec_set_rt(blocks, b_idx, mir_block_replace_head(b, hdr_instrs))
                    vec_set_rt(blocks, succ_idx, mir_block_replace_head(vec_get_rt(blocks, succ_idx), succ_instrs))
                end
            end
        end
        b_idx = b_idx + 1
    end
    out blocks
end.

##
 * SLP — pack adjacent same-base loads into SWIZZLE intrinsic marker.
 ##
func mir_opt_slp(blocks: i64):
    n_blocks = vec_len_rt(blocks)
    var b_idx = 0
    when b_idx < n_blocks loop
        instrs = mir_block_head(vec_get_rt(blocks, b_idx))
        if instrs >= 0 do
            var i = 0
            when i < (vec_len_rt(instrs) - 1) loop
                ins0 = vec_get_rt(instrs, i)
                ins1 = vec_get_rt(instrs, i + 1)
                if mir_instr_op(ins0) == MirOp.Load and mir_instr_op(ins1) == MirOp.Load do
                    p0 = mir_instr_src1(ins0)
                    p1 = mir_instr_src1(ins1)
                    o0 = mir_instr_src2(ins0)
                    o1 = mir_instr_src2(ins1)
                    if mir_opnd_is_same(p0, p1) do
                        if mir_opnd_type(o0) == MirOperandType.Imm and mir_opnd_type(o1) == MirOperandType.Imm do
                            d = mir_opnd_imm_val(o1) - mir_opnd_imm_val(o0)
                            if d == 8 do
                                sw = mir_instr_new(MirOp.Intrinsic, mir_instr_dst(ins0), mir_opnd_imm(2), mir_opnd_imm(MIR_INTR_SWIZZLE))
                                vec_set_rt(instrs, i + 1, sw)
                                mir_opt_note_change()
                            end
                        end
                    end
                end
                i = i + 1
            end
        end
        b_idx = b_idx + 1
    end
    out blocks
end.

func mir_opt_try_inline_at(blocks: i64, b_idx: i64, call_idx: i64):
    if g_mir_opt_program < 0 or g_mir_opt_current_func == 0 do out blocks end
    caller = g_mir_opt_current_func
    b = vec_get_rt(blocks, b_idx)
    instrs = mir_block_head(b)
    if instrs < 0 do out blocks end
    call_ins = vec_get_rt(instrs, call_idx)
    if mir_instr_op(call_ins) != MirOp.Call do out blocks end
    if mir_opnd_type(mir_instr_src2(call_ins)) != MirOperandType.Imm do out blocks end
    pool_id = mir_opnd_imm_val(mir_instr_src2(call_ins))
    callee_name = mir_strings_get(mir_func_strings(caller), pool_id)
    callee = mir_program_find_func(g_mir_opt_program, callee_name)
    if callee == 0 do out blocks end
    callee_blocks = mir_func_blocks(callee)
    if mir_count_all_instrs(callee_blocks) > MIR_INLINE_MAX_INSTRS do out blocks end
    if mir_blocks_contain_call(callee_blocks) do out blocks end
    nargs = mir_opnd_imm_val(mir_instr_src1(call_ins))
    arg_vals = mir_opt_collect_call_args(instrs, call_idx, nargs)
    param_vregs = mir_callee_param_vregs(callee_blocks)
    vreg_base = mir_func_next_vreg(caller)
    new_instrs = vec_new_rt()
    var ii = 0
    when ii < call_idx loop
        ins = vec_get_rt(instrs, ii)
        if mir_instr_op(ins) != MirOp.SetArg do
            new_instrs = vec_push_rt(new_instrs, ins)
        end
        ii = ii + 1
    end
    ret_val = mir_opnd_none()
    var cbi = 0
    when cbi < vec_len_rt(callee_blocks) loop
        c_instrs = mir_block_head(vec_get_rt(callee_blocks, cbi))
        if c_instrs >= 0 do
            var ci = 0
            when ci < vec_len_rt(c_instrs) loop
                raw = vec_get_rt(c_instrs, ci)
                if mir_instr_op(raw) == MirOp.Return do
                    ret_val = mir_inline_remap_opnd(mir_instr_src1(raw), param_vregs, arg_vals, vreg_base)
                else
                    cloned = mir_inline_clone_instr(raw, param_vregs, arg_vals, vreg_base)
                    if mir_instr_op(cloned) != MirOp.Nop do
                        new_instrs = vec_push_rt(new_instrs, cloned)
                    end
                end
                ci = ci + 1
            end
        end
        cbi = cbi + 1
    end
    call_dst = mir_instr_dst(call_ins)
    if mir_opnd_type(call_dst) == MirOperandType.VReg do
        if mir_opnd_type(ret_val) != MirOperandType.None do
            new_instrs = vec_push_rt(new_instrs, mir_instr_new(MirOp.Move, call_dst, ret_val, mir_opnd_none()))
        else
            new_instrs = vec_push_rt(new_instrs, mir_instr_new(MirOp.Move, call_dst, mir_opnd_vreg(vreg_base), mir_opnd_none()))
        end
    end
    ii = call_idx + 1
    when ii < vec_len_rt(instrs) loop
        new_instrs = vec_push_rt(new_instrs, vec_get_rt(instrs, ii))
        ii = ii + 1
    end
    vec_set_rt(blocks, b_idx, mir_block_replace_head(b, new_instrs))
    mir_opt_note_change()
    out blocks
end.

##
 * Inlining — leaf direct calls when program context is set.
 ##
func mir_opt_inlining(blocks: i64):
    n_blocks = vec_len_rt(blocks)
    var b_idx = 0
    when b_idx < n_blocks loop
        instrs = mir_block_head(vec_get_rt(blocks, b_idx))
        if instrs >= 0 do
            var i = 0
            when i < vec_len_rt(instrs) loop
                if mir_instr_op(vec_get_rt(instrs, i)) == MirOp.Call do
                    blocks = mir_opt_try_inline_at(blocks, b_idx, i)
                    instrs = mir_block_head(vec_get_rt(blocks, b_idx))
                end
                i = i + 1
            end
        end
        b_idx = b_idx + 1
    end
    out blocks
end.

##
 * Shrink-wrap — annotate call-free blocks for minimal prologue/epilogue.
 ##
func mir_opt_shrink_wrapping(blocks: i64):
    n_blocks = vec_len_rt(blocks)
    var b_idx = 0
    when b_idx < n_blocks loop
        b = vec_get_rt(blocks, b_idx)
        instrs = mir_block_head(b)
        if instrs >= 0 do
            var has_call = 0
            var i = 0
            when i < vec_len_rt(instrs) loop
                op = mir_instr_op(vec_get_rt(instrs, i))
                if op == MirOp.Call or op == MirOp.Intrinsic do has_call = 1 end
                i = i + 1
            end
            if has_call == 0 do
                marker = mir_instr_new(MirOp.Intrinsic, mir_opnd_none(), mir_opnd_imm(MIR_SHRINK_WRAP_MARKER), mir_opnd_imm(MIR_INTR_PATCH_POINT))
                instrs = mir_block_insert_before_terminator(instrs, marker)
                vec_set_rt(blocks, b_idx, mir_block_replace_head(b, instrs))
                mir_opt_note_change()
            end
        end
        b_idx = b_idx + 1
    end
    out blocks
end.

##
 * SROA — promote small aggregate field accesses to scalar SSA values.
 ##
func mir_opt_sroa(blocks: i64):
    n_blocks = vec_len_rt(blocks)
    var b_idx = 0
    when b_idx < n_blocks loop
        instrs = mir_block_head(vec_get_rt(blocks, b_idx))
        if instrs >= 0 do
            var i = 0
            when i < vec_len_rt(instrs) loop
                ins = vec_get_rt(instrs, i)
                if mir_instr_op(ins) == MirOp.Intrinsic do
                    s2k = mir_instr_src2(ins)
                    if mir_opnd_type(s2k) == MirOperandType.Imm do
                        kind = mir_opnd_imm_val(s2k)
                        if kind == MIR_INTR_FIELD do
                            agg = mir_instr_src1(ins)
                            if i >= 1 do
                                prev = vec_get_rt(instrs, i - 1)
                                if mir_instr_op(prev) == MirOp.SetArg do
                                    field_val = mir_instr_src2(prev)
                                    vec_set_rt(instrs, i, mir_instr_new(MirOp.Move, mir_instr_dst(ins), field_val, mir_opnd_none()))
                                    mir_opt_note_change()
                                end
                            end
                        end
                        if kind == MIR_INTR_ENTITY or kind == MIR_INTR_TUPLE do
                            if i >= MIR_SROA_MAX_FIELDS do
                                # keep aggregate when too many fields
                            end
                        end
                    end
                end
                i = i + 1
            end
        end
        b_idx = b_idx + 1
    end
    out blocks
end.

##
 * DAE — drop duplicate / unused SetArg slots before Call.
 ##
func mir_opt_dae(blocks: i64):
    n_blocks = vec_len_rt(blocks)
    var b_idx = 0
    when b_idx < n_blocks loop
        instrs = mir_block_head(vec_get_rt(blocks, b_idx))
        if instrs >= 0 do
            var i = 0
            when i < vec_len_rt(instrs) loop
                if mir_instr_op(vec_get_rt(instrs, i)) == MirOp.Call do
                    nargs = mir_opnd_imm_val(mir_instr_src1(vec_get_rt(instrs, i)))
                    last_slot = vec_new_rt()
                    var ci = i - 1
                    when ci >= 0 loop
                        ins = vec_get_rt(instrs, ci)
                        if mir_instr_op(ins) != MirOp.SetArg do
                            ci = 0 - 1
                        else
                            slot = mir_opnd_imm_val(mir_instr_src1(ins))
                            if slot >= nargs do
                                vec_set_rt(instrs, ci, mir_instr_new(MirOp.Nop, mir_opnd_none(), mir_opnd_none(), mir_opnd_none()))
                                mir_opt_note_change()
                            else
                                if slot < vec_len_rt(last_slot) do
                                    if vec_get_rt(last_slot, slot) == 1 do
                                        vec_set_rt(instrs, ci, mir_instr_new(MirOp.Nop, mir_opnd_none(), mir_opnd_none(), mir_opnd_none()))
                                        mir_opt_note_change()
                                    end
                                end
                                var grow2 = vec_len_rt(last_slot)
                                when grow2 <= slot loop
                                    last_slot = vec_push_rt(last_slot, 0)
                                    grow2 = grow2 + 1
                                end
                                vec_set_rt(last_slot, slot, 1)
                            end
                            ci = ci - 1
                        end
                    end
                end
                i = i + 1
            end
        end
        b_idx = b_idx + 1
    end
    out blocks
end.

##
 * Devirtualization — monomorphic indirect call → direct pool call.
 ##
func mir_opt_devirtualization(blocks: i64):
    n_blocks = vec_len_rt(blocks)
    var b_idx = 0
    when b_idx < n_blocks loop
        instrs = mir_block_head(vec_get_rt(blocks, b_idx))
        if instrs >= 0 do
            var i = 0
            when i < vec_len_rt(instrs) loop
                ins = vec_get_rt(instrs, i)
                if mir_instr_op(ins) == MirOp.Call do
                    callee = mir_instr_src2(ins)
                    if mir_opnd_type(callee) == MirOperandType.VReg do
                        traced = mir_trace_source_opnd(instrs, i, callee)
                        if mir_opnd_type(traced) == MirOperandType.Imm do
                            vec_set_rt(instrs, i, mir_instr_new(MirOp.Call, mir_instr_dst(ins), mir_instr_src1(ins), traced))
                            mir_opt_note_change()
                        end
                    end
                end
                i = i + 1
            end
        end
        b_idx = b_idx + 1
    end
    out blocks
end.

##
 * Escape analysis — non-escaping allocs → arena fastpath marker.
 ##
func mir_opt_escape_analysis_and_arena_promotion(blocks: i64):
    n_vregs = max_vreg_mir(blocks)
    escaped = vec_new_rt()
    var vi = 0
    when vi < n_vregs loop
        escaped = vec_push_rt(escaped, 0)
        vi = vi + 1
    end
    n_blocks = vec_len_rt(blocks)
    var b_idx = 0
    when b_idx < n_blocks loop
        instrs = mir_block_head(vec_get_rt(blocks, b_idx))
        if instrs >= 0 do
            var i = 0
            when i < vec_len_rt(instrs) loop
                ins = vec_get_rt(instrs, i)
                op = mir_instr_op(ins)
                if op == MirOp.Call or op == MirOp.Return or op == MirOp.Store do
                    s1 = mir_instr_src1(ins)
                    s2 = mir_instr_src2(ins)
                    if mir_opnd_type(s1) == MirOperandType.VReg do
                        v = mir_opnd_vreg_id(s1)
                        if v >= 0 and v < n_vregs do vec_set_rt(escaped, v, 1) end
                    end
                    if mir_opnd_type(s2) == MirOperandType.VReg do
                        v2 = mir_opnd_vreg_id(s2)
                        if v2 >= 0 and v2 < n_vregs do vec_set_rt(escaped, v2, 1) end
                    end
                end
                if op == MirOp.Intrinsic do
                    s2k = mir_instr_src2(ins)
                    if mir_opnd_type(s2k) == MirOperandType.Imm and mir_opnd_imm_val(s2k) == MIR_INTR_ADDR_OF do
                        s1k = mir_instr_src1(ins)
                        if mir_opnd_type(s1k) == MirOperandType.VReg do
                            v3 = mir_opnd_vreg_id(s1k)
                            if v3 >= 0 and v3 < n_vregs do vec_set_rt(escaped, v3, 1) end
                        end
                    end
                end
                i = i + 1
            end
        end
        b_idx = b_idx + 1
    end
    b_idx = 0
    when b_idx < n_blocks loop
        instrs2 = mir_block_head(vec_get_rt(blocks, b_idx))
        if instrs2 >= 0 do
            var j = 0
            when j < vec_len_rt(instrs2) loop
                ins2 = vec_get_rt(instrs2, j)
                if mir_instr_op(ins2) == MirOp.Intrinsic do
                    s2b = mir_instr_src2(ins2)
                    if mir_opnd_type(s2b) == MirOperandType.Imm and mir_opnd_imm_val(s2b) == MIR_INTR_BUILTIN do
                        s1b = mir_instr_src1(ins2)
                        bid = mir_opnd_imm_val(s1b)
                        if bid == 3 or bid == 49 or bid == 50 do
                            dst = mir_instr_dst(ins2)
                            if mir_opnd_type(dst) == MirOperandType.VReg do
                                dv = mir_opnd_vreg_id(dst)
                                if dv >= 0 and dv < n_vregs and vec_get_rt(escaped, dv) == 0 do
                                    vec_set_rt(instrs2, j, mir_instr_new(MirOp.Intrinsic, dst, mir_opnd_imm(MIR_BCE_MARKER), mir_opnd_imm(MIR_INTR_ARENA)))
                                    mir_opt_note_change()
                                end
                            end
                        end
                    end
                end
                j = j + 1
            end
            vec_set_rt(blocks, b_idx, mir_block_replace_head(vec_get_rt(blocks, b_idx), instrs2))
        end
        b_idx = b_idx + 1
    end
    out blocks
end.

##
 * #15 ARC trial deletion — Bacon–Rajan refcount pairing (backend / GlobalEscape heap).
 * Inserts retain/release on escaped heap allocs, then deletes redundant pairs locally.
 ##
func mir_opt_build_escaped_vregs(blocks: i64):
    n_vregs = max_vreg_mir(blocks)
    escaped = vec_new_rt()
    var vi = 0
    when vi < n_vregs loop
        escaped = vec_push_rt(escaped, 0)
        vi = vi + 1
    end
    var b_idx = 0
    when b_idx < vec_len_rt(blocks) loop
        instrs = mir_block_head(vec_get_rt(blocks, b_idx))
        if instrs >= 0 do
            var i = 0
            when i < vec_len_rt(instrs) loop
                ins = vec_get_rt(instrs, i)
                op = mir_instr_op(ins)
                if op == MirOp.Call or op == MirOp.Return or op == MirOp.Store do
                    s1 = mir_instr_src1(ins)
                    s2 = mir_instr_src2(ins)
                    if mir_opnd_type(s1) == MirOperandType.VReg do
                        v = mir_opnd_vreg_id(s1)
                        if v >= 0 and v < n_vregs do vec_set_rt(escaped, v, 1) end
                    end
                    if mir_opnd_type(s2) == MirOperandType.VReg do
                        v2 = mir_opnd_vreg_id(s2)
                        if v2 >= 0 and v2 < n_vregs do vec_set_rt(escaped, v2, 1) end
                    end
                end
                if op == MirOp.Intrinsic do
                    s2k = mir_instr_src2(ins)
                    if mir_opnd_type(s2k) == MirOperandType.Imm and mir_opnd_imm_val(s2k) == MIR_INTR_ADDR_OF do
                        s1k = mir_instr_src1(ins)
                        if mir_opnd_type(s1k) == MirOperandType.VReg do
                            v3 = mir_opnd_vreg_id(s1k)
                            if v3 >= 0 and v3 < n_vregs do vec_set_rt(escaped, v3, 1) end
                        end
                    end
                end
                if op == MirOp.SetArg do
                    sa = mir_instr_src2(ins)
                    if mir_opnd_type(sa) == MirOperandType.VReg do
                        v4 = mir_opnd_vreg_id(sa)
                        if v4 >= 0 and v4 < n_vregs do vec_set_rt(escaped, v4, 1) end
                    end
                end
                i = i + 1
            end
        end
        b_idx = b_idx + 1
    end
    out escaped
end.

func mir_is_heap_alloc_builtin(ins: MirInstr):
    if mir_instr_op(ins) != MirOp.Intrinsic do out false end
    s2 = mir_instr_src2(ins)
    if mir_opnd_type(s2) != MirOperandType.Imm or mir_opnd_imm_val(s2) != MIR_INTR_BUILTIN do out false end
    s1 = mir_instr_src1(ins)
    if mir_opnd_type(s1) != MirOperandType.Imm do out false end
    bid = mir_opnd_imm_val(s1)
    out bid == 3 or bid == 50
end.

func mir_is_arc_patch(ins: MirInstr, kind: i64):
    if mir_instr_op(ins) != MirOp.Intrinsic do out false end
    s2 = mir_instr_src2(ins)
    if mir_opnd_type(s2) != MirOperandType.Imm or mir_opnd_imm_val(s2) != MIR_INTR_PATCH_POINT do out false end
    s1 = mir_instr_src1(ins)
    if mir_opnd_type(s1) != MirOperandType.Imm do out false end
    out mir_opnd_imm_val(s1) == kind
end.

func mir_arc_marker_vreg(ins: MirInstr):
    dst = mir_instr_dst(ins)
    if mir_opnd_type(dst) == MirOperandType.VReg do out mir_opnd_vreg_id(dst) end
    s1 = mir_instr_src1(ins)
    if mir_opnd_type(s1) == MirOperandType.VReg do out mir_opnd_vreg_id(s1) end
    out 0 - 1
end.

func mir_opt_arc_insert_retain_release(blocks: i64, escaped: i64):
    n_vregs = vec_len_rt(escaped)
    var b_idx = 0
    when b_idx < vec_len_rt(blocks) loop
        b = vec_get_rt(blocks, b_idx)
        instrs = mir_block_head(b)
        if instrs >= 0 do
            var i = 0
            when i < vec_len_rt(instrs) loop
                ins = vec_get_rt(instrs, i)
                if mir_is_heap_alloc_builtin(ins) do
                    dst = mir_instr_dst(ins)
                    if mir_opnd_type(dst) == MirOperandType.VReg do
                        dv = mir_opnd_vreg_id(dst)
                        if dv >= 0 and dv < n_vregs and vec_get_rt(escaped, dv) == 1 do
                            has_retain = 0
                            if (i + 1) < vec_len_rt(instrs) do
                                nxt = vec_get_rt(instrs, i + 1)
                                if mir_is_arc_patch(nxt, MIR_ARC_RETAIN) and mir_arc_marker_vreg(nxt) == dv do
                                    has_retain = 1
                                end
                            end
                            if has_retain == 0 do
                                retain = mir_instr_new(MirOp.Intrinsic, dst, mir_opnd_imm(MIR_ARC_RETAIN), mir_opnd_imm(MIR_INTR_PATCH_POINT))
                                trial = mir_instr_new(MirOp.Intrinsic, dst, mir_opnd_imm(MIR_ARC_TRIAL), mir_opnd_imm(MIR_INTR_PATCH_POINT))
                                new_instrs = vec_new_rt()
                                var k = 0
                                when k <= i loop
                                    new_instrs = vec_push_rt(new_instrs, vec_get_rt(instrs, k))
                                    k = k + 1
                                end
                                new_instrs = vec_push_rt(new_instrs, retain)
                                new_instrs = vec_push_rt(new_instrs, trial)
                                k = i + 1
                                when k < vec_len_rt(instrs) loop
                                    new_instrs = vec_push_rt(new_instrs, vec_get_rt(instrs, k))
                                    k = k + 1
                                end
                                instrs = new_instrs
                                mir_opt_note_change()
                            end
                        end
                    end
                end
                if mir_instr_op(ins) == MirOp.Return do
                    rv = mir_instr_src1(ins)
                    if mir_opnd_type(rv) == MirOperandType.VReg do
                        dv2 = mir_opnd_vreg_id(rv)
                        if dv2 >= 0 and dv2 < n_vregs and vec_get_rt(escaped, dv2) == 1 do
                            rel = mir_instr_new(MirOp.Intrinsic, mir_opnd_vreg(dv2), mir_opnd_imm(MIR_ARC_RELEASE), mir_opnd_imm(MIR_INTR_PATCH_POINT))
                            new_instrs2 = vec_new_rt()
                            var k2 = 0
                            when k2 < i loop
                                new_instrs2 = vec_push_rt(new_instrs2, vec_get_rt(instrs, k2))
                                k2 = k2 + 1
                            end
                            new_instrs2 = vec_push_rt(new_instrs2, rel)
                            new_instrs2 = vec_push_rt(new_instrs2, ins)
                            k2 = i + 1
                            when k2 < vec_len_rt(instrs) loop
                                new_instrs2 = vec_push_rt(new_instrs2, vec_get_rt(instrs, k2))
                                k2 = k2 + 1
                            end
                            instrs = new_instrs2
                            mir_opt_note_change()
                        end
                    end
                end
                i = i + 1
            end
            vec_set_rt(blocks, b_idx, mir_block_replace_head(b, instrs))
        end
        b_idx = b_idx + 1
    end
    out blocks
end.

func mir_opt_arc_trial_delete_pairs(blocks: i64, escaped: i64):
    n_vregs = vec_len_rt(escaped)
    var b_idx = 0
    when b_idx < vec_len_rt(blocks) loop
        b = vec_get_rt(blocks, b_idx)
        instrs = mir_block_head(b)
        if instrs >= 0 do
            pending_v = 0 - 1
            var i = 0
            when i < vec_len_rt(instrs) loop
                ins = vec_get_rt(instrs, i)
                if mir_is_arc_patch(ins, MIR_ARC_RETAIN) do
                    pending_v = mir_arc_marker_vreg(ins)
                eif mir_is_arc_patch(ins, MIR_ARC_RELEASE) do
                    rv = mir_arc_marker_vreg(ins)
                    if rv == pending_v and pending_v >= 0 do
                        vec_set_rt(instrs, i, mir_instr_new(MirOp.Nop, mir_opnd_none(), mir_opnd_none(), mir_opnd_none()))
                        var j = i - 1
                        when j >= 0 loop
                            prev = vec_get_rt(instrs, j)
                            if mir_is_arc_patch(prev, MIR_ARC_RETAIN) and mir_arc_marker_vreg(prev) == rv do
                                vec_set_rt(instrs, j, mir_instr_new(MirOp.Nop, mir_opnd_none(), mir_opnd_none(), mir_opnd_none()))
                                j = 0 - 1
                            else
                                if mir_is_arc_patch(prev, MIR_ARC_TRIAL) and mir_arc_marker_vreg(prev) == rv do
                                    vec_set_rt(instrs, j, mir_instr_new(MirOp.Nop, mir_opnd_none(), mir_opnd_none(), mir_opnd_none()))
                                end
                                j = j - 1
                            end
                        end
                        pending_v = 0 - 1
                        mir_opt_note_change()
                    else
                        pending_v = 0 - 1
                    end
                else
                    op = mir_instr_op(ins)
                    if mir_memory_barrier(op) do pending_v = 0 - 1 end
                    if op == MirOp.Intrinsic do
                        s2k = mir_instr_src2(ins)
                        if mir_opnd_type(s2k) == MirOperandType.Imm and mir_opnd_imm_val(s2k) == MIR_INTR_ARENA do
                            dst = mir_instr_dst(ins)
                            if mir_opnd_type(dst) == MirOperandType.VReg do
                                dv = mir_opnd_vreg_id(dst)
                                if dv >= 0 and dv < n_vregs do
                                    # arena path — strip any ARC markers for this vreg in block
                                end
                            end
                        end
                    end
                end
                i = i + 1
            end
            var i2 = 0
            when i2 < vec_len_rt(instrs) loop
                ins2 = vec_get_rt(instrs, i2)
                if mir_is_arc_patch(ins2, MIR_ARC_RETAIN) or mir_is_arc_patch(ins2, MIR_ARC_RELEASE) or mir_is_arc_patch(ins2, MIR_ARC_TRIAL) do
                    vv = mir_arc_marker_vreg(ins2)
                    if vv >= 0 and vv < n_vregs and vec_get_rt(escaped, vv) == 0 do
                        vec_set_rt(instrs, i2, mir_instr_new(MirOp.Nop, mir_opnd_none(), mir_opnd_none(), mir_opnd_none()))
                        mir_opt_note_change()
                    end
                end
                i2 = i2 + 1
            end
            vec_set_rt(blocks, b_idx, mir_block_replace_head(b, instrs))
        end
        b_idx = b_idx + 1
    end
    out blocks
end.

func mir_opt_arc_trial_deletion(blocks: i64):
    escaped = mir_opt_build_escaped_vregs(blocks)
    blocks = mir_opt_arc_insert_retain_release(blocks, escaped)
    blocks = mir_opt_arc_trial_delete_pairs(blocks, escaped)
    out blocks
end.

##
 * IPO cascade — re-run key passes after inlining hooks.
 ##
func mir_opt_ipo_inline_cascade(blocks: i64):
    blocks = mir_opt_inlining(blocks)
    blocks = mir_opt_sccp(blocks)
    blocks = mir_opt_sroa(blocks)
    blocks = mir_opt_dae(blocks)
    blocks = mir_opt_constant_folding(blocks)
    blocks = mir_opt_dce(blocks)
    out blocks
end.

##
 * Loop tiling / fusion — fuse adjacent loops with identical bounds.
 ##
func mir_opt_loop_tiling_fusion_interchange(blocks: i64):
    n_blocks = vec_len_rt(blocks)
    var i = 0
    when i < (n_blocks - 2) loop
        b0 = vec_get_rt(blocks, i)
        b1 = vec_get_rt(blocks, i + 1)
        b2 = vec_get_rt(blocks, i + 2)
        i0 = mir_block_head(b0)
        i1 = mir_block_head(b1)
        i2 = mir_block_head(b2)
        if i0 >= 0 and i1 >= 0 and i2 >= 0 do
            n0 = vec_len_rt(i0)
            n1 = vec_len_rt(i1)
            if n0 >= 2 and n1 >= 2 do
                c0 = vec_get_rt(i0, n0 - 2)
                c1 = vec_get_rt(i1, n1 - 2)
                if mir_instr_op(c0) == MirOp.CmpLe and mir_instr_op(c1) == MirOp.CmpLe do
                    if mir_opnd_is_same(mir_instr_src1(c0), mir_instr_src1(c1)) and mir_opnd_is_same(mir_instr_src2(c0), mir_instr_src2(c1)) do
                        fused = mir_instr_new(MirOp.Intrinsic, mir_opnd_none(), mir_opnd_imm(i), mir_opnd_imm(MIR_INTR_PATCH_POINT))
                        i0 = mir_block_insert_before_terminator(i0, fused)
                        vec_set_rt(blocks, i, mir_block_replace_head(b0, i0))
                        mir_opt_note_change()
                    end
                end
            end
        end
        i = i + 1
    end
    out blocks
end.

##
 * Hot/cold layout — annotate cold blocks (no succ back to header).
 ##
func mir_opt_hot_cold_layout_partitioning(blocks: i64):
    if vec_len_rt(blocks) <= 0 do out blocks end
    entry = vec_get_rt(blocks, 0)
    entry_id = mir_block_id(entry)
    hot = vec_new_rt()
    var bi = 0
    when bi < vec_len_rt(blocks) loop
        hot = vec_push_rt(hot, 0)
        bi = bi + 1
    end
    vec_set_rt(hot, 0, 1)
    var changed = 1
    var iter = 0
    when changed == 1 and iter < vec_len_rt(blocks) loop
        changed = 0
        bi = 0
        when bi < vec_len_rt(blocks) loop
            if vec_get_rt(hot, bi) == 1 do
                succs = mir_block_successors(vec_get_rt(blocks, bi))
                if succs >= 0 do
                    var si = 0
                    when si < vec_len_rt(succs) loop
                        sid = vec_get_rt(succs, si)
                        sj = mir_find_block_index(blocks, sid)
                        if sj >= 0 and vec_get_rt(hot, sj) == 0 do
                            vec_set_rt(hot, sj, 1)
                            changed = 1
                        end
                        si = si + 1
                    end
                end
            end
            bi = bi + 1
        end
        iter = iter + 1
    end
    bi = 0
    when bi < vec_len_rt(blocks) loop
        if vec_get_rt(hot, bi) == 0 do
            b = vec_get_rt(blocks, bi)
            instrs = mir_block_head(b)
            if instrs >= 0 do
                marker = mir_instr_new(MirOp.Intrinsic, mir_opnd_none(), mir_opnd_imm(MIR_COLD_BLOCK_MARKER), mir_opnd_imm(MIR_INTR_NOP_MARKER))
                instrs = mir_block_insert_before_terminator(instrs, marker)
                vec_set_rt(blocks, bi, mir_block_replace_head(b, instrs))
                mir_opt_note_change()
            end
        else
            instrs_h = mir_block_head(vec_get_rt(blocks, bi))
            if instrs_h >= 0 do
                marker_h = mir_instr_new(MirOp.Intrinsic, mir_opnd_none(), mir_opnd_imm(MIR_HOT_BLOCK_MARKER), mir_opnd_imm(MIR_INTR_NOP_MARKER))
                instrs_h = mir_block_insert_before_terminator(instrs_h, marker_h)
                vec_set_rt(blocks, bi, mir_block_replace_head(vec_get_rt(blocks, bi), instrs_h))
                mir_opt_note_change()
            end
        end
        bi = bi + 1
    end
    out blocks
end.

##
 * NEON SIMD — pair 128-bit load lowering marker (backend consumes SWIZZLE).
 ##
func mir_opt_neon_simd_vector_lowering(blocks: i64):
    blocks = mir_opt_slp(blocks)
    n_blocks = vec_len_rt(blocks)
    var b_idx = 0
    when b_idx < n_blocks loop
        instrs = mir_block_head(vec_get_rt(blocks, b_idx))
        if instrs >= 0 do
            var i = 0
            when i < vec_len_rt(instrs) loop
                ins = vec_get_rt(instrs, i)
                if mir_instr_op(ins) == MirOp.Intrinsic do
                    s2k = mir_instr_src2(ins)
                    if mir_opnd_type(s2k) == MirOperandType.Imm and mir_opnd_imm_val(s2k) == MIR_INTR_SWIZZLE do
                        vec_set_rt(instrs, i, mir_instr_new(MirOp.Intrinsic, mir_instr_dst(ins), mir_opnd_imm(128), mir_opnd_imm(MIR_INTR_SWIZZLE)))
                        mir_opt_note_change()
                    end
                end
                i = i + 1
            end
        end
        b_idx = b_idx + 1
    end
    out blocks
end.

##
 * Loop unroll — full unroll when constant trip count <= MIR_UNROLL_MAX.
 ##
func mir_opt_loop_unroll(blocks: i64):
    n_blocks = vec_len_rt(blocks)
    var i = 0
    when i < (n_blocks - 1) loop
        cond_b = vec_get_rt(blocks, i)
        cond_instrs = mir_block_head(cond_b)
        if cond_instrs >= 0 do
            n_cond = vec_len_rt(cond_instrs)
            if n_cond >= 3 do
                ins_jump = vec_get_rt(cond_instrs, n_cond - 1)
                ins_jin = vec_get_rt(cond_instrs, n_cond - 2)
                ins_cmp = vec_get_rt(cond_instrs, n_cond - 3)
                if mir_instr_op(ins_jump) == MirOp.Jump and mir_instr_op(ins_jin) == MirOp.JumpIfNot do
                    if mir_instr_op(ins_cmp) == MirOp.CmpLe or mir_instr_op(ins_cmp) == MirOp.CmpLt do
                        lim = mir_instr_src2(ins_cmp)
                        if mir_opnd_type(lim) == MirOperandType.Imm do
                            trip = mir_opnd_imm_val(lim)
                            if mir_instr_op(ins_cmp) == MirOp.CmpLe do trip = trip + 1 end
                            if trip >= 2 and trip <= MIR_UNROLL_MAX do
                                cond_id = mir_block_id(cond_b)
                                exit_id = mir_opnd_imm_val(mir_instr_src2(ins_jin))
                                body_b = vec_get_rt(blocks, i + 1)
                                body_instrs = mir_block_head(body_b)
                                if body_instrs >= 0 do
                                    n_body = vec_len_rt(body_instrs)
                                    if n_body >= 1 do
                                        last_body = vec_get_rt(body_instrs, n_body - 1)
                                        # Counted loops (loop N / for-range) use body -> step -> cond.
                                        # Unroll only when the back-edge is body -> cond (O(1) shape check).
                                        if mir_instr_op(last_body) == MirOp.Jump and mir_opnd_imm_val(mir_instr_src1(last_body)) == cond_id do
                                            cloned = vec_new_rt()
                                            var rep = 0
                                            when rep < trip loop
                                                var bi = 0
                                                when bi < (n_body - 1) loop
                                                    cloned = vec_push_rt(cloned, vec_get_rt(body_instrs, bi))
                                                    bi = bi + 1
                                                end
                                                rep = rep + 1
                                            end
                                            exit_jump = mir_instr_new(MirOp.Jump, mir_opnd_none(), mir_opnd_imm(exit_id), mir_opnd_none())
                                            cloned = vec_push_rt(cloned, exit_jump)
                                            vec_set_rt(blocks, i + 1, mir_block_replace_head(body_b, cloned))
                                            entry_jump = mir_instr_new(MirOp.Jump, mir_opnd_none(), mir_opnd_imm(i + 1), mir_opnd_none())
                                            new_cond = vec_new_rt()
                                            new_cond = vec_push_rt(new_cond, entry_jump)
                                            vec_set_rt(blocks, i, mir_block_replace_head(cond_b, new_cond))
                                            mir_opt_note_change()
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
        i = i + 1
    end
    out blocks
end.


export mir_opt_set_program, mir_opt_set_current_func, mir_opt_constant_folding, mir_opt_constant_propagation, mir_opt_copy_propagation, mir_opt_cse, mir_opt_dce, mir_opt_bce, mir_opt_strength_reduction, mir_opt_loop_unroll, mir_opt_licm, mir_opt_ivsr, mir_opt_symbolic_loop_collapse, mir_opt_gvn, mir_opt_pre, mir_opt_slp, mir_opt_inlining, mir_opt_shrink_wrapping, mir_opt_jump_threading, mir_opt_sroa, mir_opt_sccp, mir_opt_dae, mir_opt_devirtualization, mir_opt_escape_analysis_and_arena_promotion, mir_opt_ipo_inline_cascade, mir_opt_loop_tiling_fusion_interchange, mir_opt_loop_idiom_recognizer, mir_opt_hot_cold_layout_partitioning, mir_opt_redundant_load_store_elimination, mir_opt_arm64_instruction_selection_and_scheduling, mir_opt_neon_simd_vector_lowering, mir_opt_zero_cost_abi_and_semantics_tuning, mir_opt_inline_bump_arena_fastpath, mir_opt_arm64_addressing_modes_and_register_induction, mir_opt_algebraic_simplification, mir_opt_branch_folding, mir_opt_phi_simplification, mir_opt_sweep_dead_phis, mir_opt_cfg_simplification, mir_opt_arc_trial_deletion, mir_opt_reset_counters, mir_opt_get_last_changes, mir_opt_get_total_changes

# @vir_source stdlib/vir/compiler/virc.vri 60
# @vir_source stdlib/vir/compiler/ast_to_mir.vri 1
#*#
 * vir/compiler/ast_to_mir.vri — AST to MIR Lowering
 * ==============================================================
 * Flattens AST into MIR basic blocks + CFG. Locals map to vregs.
 * Phi insertion is deferred to mir_ssa.vri (this phase emits non-SSA MIR).
 * Coverage / status: MUST_READ_CONTEXT/AST_TO_MIR_LOWERING_CHECKLIST.md
 #*#

import vec_new_rt, vec_push_rt, vec_get_rt, vec_set_rt, vec_len_rt, vec_pop_rt from vec_rt

import rt_streq, fat_str_eq, fat_str_len, fat_cstr_eq, fat_str_new, fat_str_concat, rt_itoa, rt_strlen, fat_str_byte_at, sb_new, sb_append, sb_append_int, sb_to_string, sb_free from string_rt

# Local fail-fast exit: avoids importing sys_exit (avoid include chain crash).
# On macOS ARM64: X16=0x2000001, SVC #0x80. On Linux ARM64: X8=93, SVC #0.
# We call syscall1 from vir.rt.syscall if available, otherwise use direct native.
# Simpler: just reference sys_exit which is always in scope when ast_to_mir is
# expanded as part of virc.vri (which already includes vir.rt.syscall).

import AstNode, AstType, OpType from parser

import ffi_import_reset, ffi_import_register from vir.compiler.ffi_imports

import is_tensor_type_str, parse_tensor_shape, parse_tensor_rank, parse_tensor_stride, parse_tensor_numel, parse_tensor_elem_type, tensor_elem_byte_size, parse_tensor_elem_code from type_table

import print_str, print_ln from vir.compiler.context
import MirType, MirFunc, MirBlock, MirInstr, MirOp, MirOperand, MirOperandType, mir_opnd_none, mir_opnd_vreg, mir_opnd_imm, mir_opnd_new, mir_opnd_type, mir_instr_new, mir_instr_set_aux, mir_instr_type, mir_instr_set_type, mir_func_new, mir_block_new, mir_create_block, mir_intern_string, mir_func_id, mir_func_name, mir_func_next_vreg, mir_func_def_uses, mir_func_next_block_id, mir_func_entry_block, mir_func_blocks, mir_func_strings, mir_func_var_buckets, mir_block_id, mir_block_head, mir_block_tail, mir_block_successors, mir_block_preds, mir_block_idom, mir_block_dom_children, mir_block_df, mir_block_next_block, mir_block_phis, MIR_INTR_STR_LIT, MIR_INTR_PRINT, MIR_INTR_ARRAY, MIR_INTR_TUPLE, MIR_INTR_ENTITY, MIR_INTR_ADDR_OF, MIR_INTR_INTERP, MIR_INTR_BUILTIN, MIR_INTR_INDEX, MIR_INTR_FIELD, MIR_INTR_MATCH_PAT, MIR_INTR_INPUT, MIR_INTR_ENUM, MIR_INTR_CAST, MIR_INTR_THROW, MIR_INTR_CANCEL, MIR_INTR_QUIET, MIR_INTR_ARENA, MIR_INTR_ENSURE, MIR_INTR_REVERT, MIR_INTR_INDEX_STORE, MIR_INTR_FIELD_STORE, MIR_INTR_STR_EQ, MIR_INTR_CHECK_CPU, MIR_INTR_PATCH_POINT, MIR_INTR_DECL, MIR_INTR_AWAIT, MIR_INTR_NOP_MARKER, MIR_INTR_TASK, MIR_INTR_WAIT, MIR_INTR_SELECT, MIR_INTR_SEND, MIR_INTR_RECV, MIR_INTR_EMIT, MIR_INTR_ERX, MIR_INTR_TRY, MIR_INTR_RESUME, MIR_INTR_LOCK, MIR_INTR_SWIZZLE, MIR_INTR_INFER, MIR_INTR_TRAIN, MIR_INTR_QUANTIZE, MIR_INTR_AWAIT_PASS, MIR_INTR_SAFE_ACCESS, MIR_INTR_ATOMIC, MIR_INTR_EXIST, MIR_INTR_PATTERN, MIR_INTR_MAP, MIR_INTR_ARR_COMPACT, MIR_INTR_BUNDLE, MIR_INTR_TIMEOUT, MIR_INTR_ISOLATE, MIR_INTR_ERROR, MIR_INTR_PRECOMP, MIR_INTR_REACTIVE, MIR_INTR_MORPH, MIR_INTR_EXPOSE, MIR_INTR_PTR, MIR_INTR_ASYNC, MIR_INTR_ATOMIC_VAR, MIR_INTR_PRINT_STR, MIR_INTR_PARAM, MIR_INTR_GLOBAL_LOAD, MIR_INTR_GLOBAL_STORE, MIR_INTR_BIT_EXTRACT, MIR_INTR_BIT_INSERT, MIR_INTR_BACKWARD, MIR_INTR_PERCENT from vir.compiler.mir

# Map OpType → MirOp code.
# Special: Land=-2, Lor=-3, PatternOp=-4 (Intrinsic PATTERN). Unknown=-1.
var g_ast_lower_verbose: int = 0

func set_ast_lower_verbose(mode: int):
    g_ast_lower_verbose = mode
end.

func mir_op_from_optype(op: OpType):
	if op == OpType.Add do out MirOp.Add as i64 end
	if op == OpType.Sub do out MirOp.Sub as i64 end
	if op == OpType.Mul do out MirOp.Mul as i64 end
	if op == OpType.Div do out MirOp.Div as i64 end
	if op == OpType.ModOp do out MirOp.Mod as i64 end
	if op == OpType.Eq do out MirOp.CmpEq as i64 end
	if op == OpType.Ne do out MirOp.CmpNe as i64 end
	if op == OpType.Gt do out MirOp.CmpGt as i64 end
	if op == OpType.Lt do out MirOp.CmpLt as i64 end
	if op == OpType.Ge do out MirOp.CmpGe as i64 end
	if op == OpType.Le do out MirOp.CmpLe as i64 end
	if op == OpType.SafeEq do out MirOp.CmpEq as i64 end
	if op == OpType.SafeNe do out MirOp.CmpNe as i64 end
	if op == OpType.AndOp do out MirOp.And as i64 end
	if op == OpType.OrOp do out MirOp.Or as i64 end
	if op == OpType.XorOp do out MirOp.Xor as i64 end
	if op == OpType.ShlOp do out MirOp.Shl as i64 end
	if op == OpType.ShrOp do out MirOp.Shr as i64 end
	if op == OpType.PowOp do out MirOp.Pow as i64 end
	if op == OpType.MatMulOp do out MirOp.MatMul as i64 end
	if op == OpType.FmaOp do out MirOp.Fma as i64 end
	if op == OpType.Land do out 0 - 2 end
	if op == OpType.Lor do out 0 - 3 end
	if op == OpType.PatternOp do out 0 - 4 end
	out 0 - 1
end.

const MIR_VAR_BUCKETS: i64 = 256

entity VarMap:
	name: string,
	vreg: i64
end.

func var_map_new(name: string, vreg: i64):
    out VarMap (
        name: name,
        vreg: vreg
    )
end.

# Typed accessors — bare vec_get_rt results have no record type.
func var_map_name(vm: VarMap):
	out vm.name
end.
func var_map_vreg(vm: VarMap):
	out vm.vreg
end.


entity LoopTarget:
	break_block: i64,
	continue_block: i64
end.

func loop_target_new(break_block: i64, continue_block: i64):
    p = alloc(16)
    native_write_i64(p, 0, break_block)
    native_write_i64(p, 8, continue_block)
    out p
end.

func loop_target_break_block(lt: LoopTarget):
    out native_read_i64(lt as i64, 0)
end.

func loop_target_continue_block(lt: LoopTarget):
    out native_read_i64(lt as i64, 8)
end.

entity MirBuilder:
	current_block: i64,
	vreg_counter: i64,
	loop_stack: i64, # Vec<LoopTarget>
	func_box: i64, # Vec<MirFunc> length 1 — locals live on MirFunc.var_buckets
	cur_func_ptr: i64,
	cur_block_ptr: i64
end.

var g_prog_ast: AstNode = 0
var g_entity_names: i64 = 0
var g_import_aliases: i64 = 0
var g_import_targets: i64 = 0
var g_field_names: i64 = 0
var g_field_indices: i64 = 0
var g_register_field_names: i64 = 0
var g_register_field_starts: i64 = 0
var g_register_field_widths: i64 = 0
var g_builtin_lookup_buckets: i64 = 0
var g_mir_scratch_args: i64 = 0
var g_mir_scratch_top: i64 = 0

# Active `try` handler context (for `throw` inside a try body). These are saved
# and restored around each TryStmt lowering so nested try blocks work.
var g_try_revert_block: i64 = 0 - 1
var g_try_retry_block: i64 = 0 - 1
var g_try_err_vreg: i64 = 0

var g_entity_hash: i64 = 0
var g_import_hash: i64 = 0
var g_field_hash: i64 = 0
var g_regfield_hash: i64 = 0
var g_const_names: i64 = 0
var g_const_values: i64 = 0
var g_const_hash: i64 = 0
var g_lower_global_names: i64 = 0
var g_lower_global_values: i64 = 0
var g_lower_global_hash: i64 = 0
var g_lower_global_init_nodes: i64 = 0

var g_scoped_field_hash: i64 = 0
var g_scoped_field_names: i64 = 0
var g_scoped_field_indices: i64 = 0
var g_scoped_field_types: i64 = 0
var g_scoped_method_hash: i64 = 0
var g_scoped_method_names: i64 = 0
var g_scoped_method_nodes: i64 = 0
var g_scope_stack: i64 = 0
var g_current_func_buckets: i64 = 0

var g_entity_is_packed: i64 = 0
var g_entity_sizes: i64 = 0
var g_entity_nodes: i64 = 0
var g_scoped_field_offsets: i64 = 0
var g_scoped_field_sizes: i64 = 0
var g_scoped_field_signed: i64 = 0
var g_scoped_field_is_nested: i64 = 0

var g_var_type_hash: i64 = 0
var g_var_type_names: i64 = 0
var g_var_type_values: i64 = 0

var g_current_entity_name: i64 = 0

func set_var_type(var_name: string, type_name: string):
    if g_var_type_hash != 0 and var_name != 0 and type_name != 0 do
        idx = hash_table_lookup(g_var_type_hash, g_var_type_names, var_name)
        if idx >= 0 do
            vec_set_rt(g_var_type_values, idx, type_name as i64)
        else
            idx = vec_len_rt(g_var_type_names)
            g_var_type_names = vec_push_rt(g_var_type_names, var_name as i64)
            g_var_type_values = vec_push_rt(g_var_type_values, type_name as i64)
            hash_table_insert(g_var_type_hash, g_var_type_names, var_name, idx)
        end
    end
end.

func get_var_type(var_name: string):
    if g_var_type_hash != 0 and var_name != 0 do
        idx = hash_table_lookup(g_var_type_hash, g_var_type_names, var_name)
        if idx >= 0 do
            out vec_get_rt(g_var_type_values, idx) as string
        end
    end
    out 0
end.

func qualified_member_name(entity_name: string, member_name: string):
    out fat_str_concat(fat_str_concat(entity_name, fat_str_new(".")), member_name)
end.

func get_scoped_method_name(entity_name: string, method_name: string):
    if g_scoped_method_hash != 0 and entity_name != 0 and method_name != 0 do
        key = qualified_member_name(entity_name, method_name)
        if hash_table_lookup(g_scoped_method_hash, g_scoped_method_names, key) >= 0 do
            out key
        end
    end
    out fat_str_new("")
end.

func scoped_field_is_callable(entity_name: string, field_name: string):
    field_type = get_scoped_field_type(entity_name, field_name)
    if fat_str_len(field_type) >= 4 do
        if fat_str_byte_at(field_type, 0) == 102 and fat_str_byte_at(field_type, 1) == 117 and fat_str_byte_at(field_type, 2) == 110 and fat_str_byte_at(field_type, 3) == 99 do out 1 end
    end
    if fat_cstr_eq(field_type, "ptr") == 1 do out 1 end
    out 0
end.

# Lightweight lowering-time type recovery for inferred locals.  The semantic
# passes already validate compatibility; this table is needed by representation-
# sensitive lowering such as interpolation and tensor result metadata.
func infer_expr_type_name(node: AstNode):
    if node == 0 do out fat_str_new("") end
    nt = ast_node_type_of(node)
    if nt == AstType.LiteralInt do out fat_str_new("int") end
    if nt == AstType.LiteralFloat do out fat_str_new("float") end
    if nt == AstType.PercentExpr do out fat_str_new("float") end
    if nt == AstType.LiteralBool do out fat_str_new("bool") end
    if nt == AstType.LiteralNone do out fat_str_new("none") end
    if nt == AstType.LiteralStr or nt == AstType.InterpExpr do out fat_str_new("string") end
    if nt == AstType.Identifier do
        vt = get_var_type(ast_node_name(node))
        if vt != 0 do out vt end
        out fat_str_new("")
    end
    if nt == AstType.Compare do out fat_str_new("bool") end
    if nt == AstType.BinOp and ast_node_child_count(node) >= 2 do
        op = ast_node_op_of(node)
        if op == OpType.Eq or op == OpType.Ne or op == OpType.Gt or op == OpType.Lt or op == OpType.Ge or op == OpType.Le or op == OpType.SafeEq or op == OpType.SafeNe or op == OpType.Land or op == OpType.Lor do
            out fat_str_new("bool")
        end
        left_t = infer_expr_type_name(ast_node_child(node, 0))
        right_t = infer_expr_type_name(ast_node_child(node, 1))
        if op == OpType.MatMulOp or op == OpType.FmaOp do out left_t end
        if fat_cstr_eq(left_t, "float") == 1 or fat_cstr_eq(right_t, "float") == 1 do out fat_str_new("float") end
        if fat_cstr_eq(left_t, "string") == 1 and fat_cstr_eq(right_t, "string") == 1 do out fat_str_new("string") end
        if fat_str_len(left_t) > 0 do out left_t end
        out right_t
    end
    out fat_str_new("")
end.

func name_hash_256(name: string):
    n = fat_str_len(name as int) as i64
    h = n * 17
    var i = 0
    when i < n loop
        h = h * 131 + (fat_str_byte_at(name as int, i) as i64)
        i = i + 1
    end
    if h < 0 do h = 0 - h end
    out h mod 256
end.

func hash_table_new():
    tab = vec_new_rt()
    var i = 0
    when i < 256 loop
        tab = vec_push_rt(tab, 0)
        i = i + 1
    end
    out tab
end.

func hash_table_lookup(hash_tab: i64, names: i64, name: string):
    if hash_tab == 0 or names == 0 do out 0 - 1 end
    bid = name_hash_256(name)
    bucket = vec_get_rt(hash_tab, bid)
    if bucket == 0 do out 0 - 1 end
    n = vec_len_rt(bucket)
    var i = 0
    when i < n loop
        idx = vec_get_rt(bucket, i)
        if fat_str_eq(vec_get_rt(names, idx) as string, name) == 1 do
            out idx
        end
        i = i + 1
    end
    out 0 - 1
end.

func hash_table_insert(hash_tab: i64, names: i64, name: string, idx: i64):
    if hash_tab == 0 do out 0 end
    bid = name_hash_256(name)
    bucket = vec_get_rt(hash_tab, bid)
    if bucket == 0 do
        bucket = vec_new_rt()
    end
    bucket = vec_push_rt(bucket, idx)
    vec_set_rt(hash_tab, bid, bucket)
    out 0
end.

func lookup_cached_name(names: i64, name: string):
    if names == 0 do out 0 - 1 end
    if names == g_field_names and g_field_hash != 0 do
        out hash_table_lookup(g_field_hash, names, name)
    end
    if names == g_scoped_field_names and g_scoped_field_hash != 0 do
        out hash_table_lookup(g_scoped_field_hash, names, name)
    end
    if names == g_entity_names and g_entity_hash != 0 do
        out hash_table_lookup(g_entity_hash, names, name)
    end
    if names == g_import_aliases and g_import_hash != 0 do
        out hash_table_lookup(g_import_hash, names, name)
    end
    if names == g_register_field_names and g_regfield_hash != 0 do
        out hash_table_lookup(g_regfield_hash, names, name)
    end
    n = vec_len_rt(names)
    var i = 0
    when i < n loop
        if fat_str_eq(vec_get_rt(names, i) as string, name) == 1 do out i end
        i = i + 1
    end
    out 0 - 1
end.

func is_packed_entity(type_name: string):
    if g_entity_hash != 0 and type_name != 0 and fat_str_len(type_name) > 0 do
        var idx = hash_table_lookup(g_entity_hash, g_entity_names, type_name)
        if idx >= 0 and idx < vec_len_rt(g_entity_is_packed) do
            out vec_get_rt(g_entity_is_packed, idx) == 1
        end
    end
    out false
end.

func is_signed_type(t: string):
    if t == 0 or fat_str_len(t) == 0 do out 0 end
    if fat_cstr_eq(t, "i8") == 1 or fat_cstr_eq(t, "i16") == 1 or fat_cstr_eq(t, "i32") == 1 or fat_cstr_eq(t, "i64") == 1 do
        out 1
    end
    out 0
end.

func get_type_byte_size(type_name: string):
    if type_name == 0 or fat_str_len(type_name) == 0 do out 8 end
    if fat_cstr_eq(type_name, "u8") == 1 or fat_cstr_eq(type_name, "i8") == 1 or fat_cstr_eq(type_name, "bool") == 1 do
        out 1
    end
    if fat_cstr_eq(type_name, "u16") == 1 or fat_cstr_eq(type_name, "i16") == 1 do
        out 2
    end
    if fat_cstr_eq(type_name, "u32") == 1 or fat_cstr_eq(type_name, "i32") == 1 do
        out 4
    end
    if fat_cstr_eq(type_name, "u64") == 1 or fat_cstr_eq(type_name, "i64") == 1 or fat_cstr_eq(type_name, "int") == 1 or fat_cstr_eq(type_name, "float") == 1 or fat_cstr_eq(type_name, "ptr") == 1 or fat_cstr_eq(type_name, "usize") == 1 or fat_cstr_eq(type_name, "isize") == 1 do
        out 8
    end
    if g_entity_hash != 0 do
        var idx = hash_table_lookup(g_entity_hash, g_entity_names, type_name)
        if idx >= 0 and idx < vec_len_rt(g_entity_sizes) do
            var sz = vec_get_rt(g_entity_sizes, idx)
            if sz > 0 do out sz end
        end
    end
    out 8
end.

func eval_const_expr(node: AstNode):
    if node == 0 do out 0 end
    nt = ast_node_type_of(node)
    if nt == AstType.SizeofExpr do
        out get_type_byte_size(ast_node_name(node))
    end
    if nt == AstType.LiteralInt do
        out ast_node_int_val(node)
    end
    if nt == AstType.LiteralFloat do
        # Float constants travel through the integer MIR immediate lane as their
        # IEEE-754 payload. `int_val` is a distinct AST field and is zero for a
        # float token, so using it silently rewrites every float const to 0.0.
        out native_read_i64(node as i64, 48)
    end
    if nt == AstType.UnaryMinus do
        if ast_node_child_count(node) > 0 do
            out 0 - eval_const_expr(ast_node_child(node, 0))
            let c = ast_node_child(node, 0)
            if ast_node_type_of(c) == AstType.LiteralFloat do
                out eval_const_expr(c) xor (1 shl 63)
            end
            out 0 - eval_const_expr(c)
        end
        out 0
    end
    if nt == AstType.Identifier do
        cname = ast_node_name(node)
        if fat_cstr_eq(cname, "true") == 1 do out 1 end
        if fat_cstr_eq(cname, "false") == 1 do out 0 end
        if fat_cstr_eq(cname, "null") == 1 do out 0 end
        if g_const_hash > 0 do
            c_idx = hash_table_lookup(g_const_hash, g_const_names, cname)
            if c_idx >= 0 do
                out vec_get_rt(g_const_values, c_idx)
            end
        end
        out 0
    end
    if nt == AstType.FieldAccess do
        if ast_node_child_count(node) > 0 do
            base = ast_node_child(node, 0)
            if ast_node_type_of(base) == AstType.Identifier do
                key = fat_str_concat(fat_str_concat(ast_node_name(base), fat_str_new(".")), ast_node_name(node))
                if g_const_hash > 0 do
                    c_idx = hash_table_lookup(g_const_hash, g_const_names, key)
                    if c_idx >= 0 do
                        out vec_get_rt(g_const_values, c_idx)
                    end
                end
            end
        end
        out 0
    end
    if nt == AstType.EnumAccess do
        key = fat_str_concat(fat_str_concat(ast_node_name(node), fat_str_new(".")), ast_node_name2(node))
        if g_const_hash > 0 do
            c_idx = hash_table_lookup(g_const_hash, g_const_names, key)
            if c_idx >= 0 do
                out vec_get_rt(g_const_values, c_idx)
            end
        end
        out 0
    end
    if nt == AstType.BinOp or nt == AstType.Compare do
        if ast_node_child_count(node) >= 2 do
            lval = eval_const_expr(ast_node_child(node, 0))
            rval = eval_const_expr(ast_node_child(node, 1))
            op = ast_node_op_of(node)
            if op == OpType.Add do out lval + rval end
            if op == OpType.Sub do out lval - rval end
            if op == OpType.Mul do out lval * rval end
            if op == OpType.Div do
                if rval != 0 do out lval / rval end
                out 0
            end
            if op == OpType.ModOp do
                if rval != 0 do out lval mod rval end
                out 0
            end
            if op == OpType.OrOp or op == OpType.Lor do out lval or rval end
            if op == OpType.AndOp or op == OpType.Land do out lval and rval end
            if op == OpType.XorOp do out lval xor rval end
            if op == OpType.ShlOp do out lval shl rval end
            if op == OpType.ShrOp do out lval shr rval end
        end
        out 0
    end
    out 0
end.

func set_global_prog_ast(ast: AstNode):
    g_prog_ast = ast
    g_entity_names = vec_new_rt()
    g_import_aliases = vec_new_rt()
    g_import_targets = vec_new_rt()
    g_field_names = vec_new_rt()
    g_field_indices = vec_new_rt()
    g_register_field_names = vec_new_rt()
    g_register_field_starts = vec_new_rt()
    g_register_field_widths = vec_new_rt()

    g_entity_hash = hash_table_new()
    g_import_hash = hash_table_new()
    g_field_hash = hash_table_new()
    g_regfield_hash = hash_table_new()

    g_const_names = vec_new_rt()
    g_const_values = vec_new_rt()
    g_const_hash = hash_table_new()

    g_scoped_field_names = vec_new_rt()
    g_scoped_field_indices = vec_new_rt()
    g_scoped_field_types = vec_new_rt()
    g_scoped_field_offsets = vec_new_rt()
    g_scoped_field_sizes = vec_new_rt()
    g_scoped_field_signed = vec_new_rt()
    g_scoped_field_is_nested = vec_new_rt()
    g_scoped_field_hash = hash_table_new()
    g_scoped_method_names = vec_new_rt()
    g_scoped_method_nodes = vec_new_rt()
    g_scoped_method_hash = hash_table_new()

    g_entity_is_packed = vec_new_rt()
    g_entity_sizes = vec_new_rt()
    g_entity_nodes = vec_new_rt()

    g_var_type_names = vec_new_rt()
    g_var_type_values = vec_new_rt()
    g_var_type_hash = hash_table_new()

    g_current_entity_name = 0

    # Native code needs real cross-function storage for top-level `var`s.
    # Assign each declaration a stable heap-header slot before lowering funcs.
    g_lower_global_names = vec_new_rt()
    g_lower_global_values = vec_new_rt()
    g_lower_global_hash = hash_table_new()
    g_lower_global_init_nodes = vec_new_rt()

    n = ast_node_child_count(ast)
    var i = 0
    when i < n loop
        child = ast_node_child(ast, i)
        child_type = ast_node_type_of(child)
        if child_type == AstType.ImportStmt do
            child_count = ast_node_child_count(child)
            var j = 0
            when j < child_count loop
                sym = ast_node_child(child, j)
                alias = ast_node_name2(sym)
                target = ast_node_name(sym)
                if fat_str_len(alias) == 0 do
                    alias = target
                end
                if hash_table_lookup(g_import_hash, g_import_aliases, alias) < 0 do
                    idx = vec_len_rt(g_import_aliases)
                    g_import_aliases = vec_push_rt(g_import_aliases, alias as i64)
                    g_import_targets = vec_push_rt(g_import_targets, target as i64)
                    hash_table_insert(g_import_hash, g_import_aliases, alias, idx)
                end
                j = j + 1
            end
        end
        if child_type == AstType.EnumDef do
            enum_name = ast_node_name(child)
            var vcount = ast_node_child_count(child)
            var vi = 0
            when vi < vcount loop
                vnode = ast_node_child(child, vi)
                vname = ast_node_name(vnode)
                vval = ast_node_int_val(vnode)
                dot_str = fat_str_new(".")
                key = fat_str_concat(fat_str_concat(enum_name, dot_str), vname)
                if hash_table_lookup(g_const_hash, g_const_names, key) < 0 do
                    idx = vec_len_rt(g_const_names)
                    g_const_names = vec_push_rt(g_const_names, key as i64)
                    g_const_values = vec_push_rt(g_const_values, vval)
                    hash_table_insert(g_const_hash, g_const_names, key, idx)
                end
                vi = vi + 1
            end
        end
        if child_type == AstType.ConstDecl do
            const_name = ast_node_name(child)
            if ast_node_child_count(child) > 0 do
                init_expr = ast_node_child(child, 0)
                val = eval_const_expr(init_expr)
                if hash_table_lookup(g_const_hash, g_const_names, const_name) < 0 do
                    idx = vec_len_rt(g_const_names)
                    g_const_names = vec_push_rt(g_const_names, const_name as i64)
                    g_const_values = vec_push_rt(g_const_values, val)
                    hash_table_insert(g_const_hash, g_const_names, const_name, idx)
                end
            end
        end
        if child_type == AstType.EntityDef or child_type == AstType.PackedDef or child_type == AstType.RegisterDef do
            entity_name = ast_node_name(child)
            var is_packed = 0
            if child_type == AstType.PackedDef do is_packed = 1 end
            if hash_table_lookup(g_entity_hash, g_entity_names, entity_name) < 0 do
                idx = vec_len_rt(g_entity_names)
                g_entity_names = vec_push_rt(g_entity_names, entity_name as i64)
                g_entity_is_packed = vec_push_rt(g_entity_is_packed, is_packed)
                g_entity_sizes = vec_push_rt(g_entity_sizes, 0)
                g_entity_nodes = vec_push_rt(g_entity_nodes, child as i64)
                hash_table_insert(g_entity_hash, g_entity_names, entity_name, idx)
            end
            field_count = ast_node_child_count(child)
            var j = 0
            var actual_field_idx = 0
            when j < field_count loop
                field = ast_node_child(child, j)
                if ast_node_type_of(field) == AstType.FuncDef do
                    method_key = qualified_member_name(entity_name, ast_node_name(field))
                    if hash_table_lookup(g_scoped_method_hash, g_scoped_method_names, method_key) < 0 do
                        method_idx = vec_len_rt(g_scoped_method_names)
                        g_scoped_method_names = vec_push_rt(g_scoped_method_names, method_key as i64)
                        g_scoped_method_nodes = vec_push_rt(g_scoped_method_nodes, field as i64)
                        hash_table_insert(g_scoped_method_hash, g_scoped_method_names, method_key, method_idx)
                    end
                else
                    field_name = ast_node_name(field)
                    dot_str = fat_str_new(".")
                    scoped_key = fat_str_concat(fat_str_concat(entity_name, dot_str), field_name)
                    if hash_table_lookup(g_scoped_field_hash, g_scoped_field_names, scoped_key) < 0 do
                        idx_s = vec_len_rt(g_scoped_field_names)
                        g_scoped_field_names = vec_push_rt(g_scoped_field_names, scoped_key as i64)
                        g_scoped_field_indices = vec_push_rt(g_scoped_field_indices, actual_field_idx)
                        var ft_decl = ast_node_name2(field)
                        if ft_decl == 0 do ft_decl = fat_str_new("") end
                        g_scoped_field_types = vec_push_rt(g_scoped_field_types, ft_decl as i64)
                        g_scoped_field_offsets = vec_push_rt(g_scoped_field_offsets, 0)
                        g_scoped_field_sizes = vec_push_rt(g_scoped_field_sizes, 0)
                        g_scoped_field_signed = vec_push_rt(g_scoped_field_signed, 0)
                        g_scoped_field_is_nested = vec_push_rt(g_scoped_field_is_nested, 0)
                        hash_table_insert(g_scoped_field_hash, g_scoped_field_names, scoped_key, idx_s)
                    end
                    field_t = ast_node_name2(field)
                    if field_t != 0 and fat_str_len(field_t) > 0 do
                        set_var_type(field_name, field_t)
                    end
                    if hash_table_lookup(g_field_hash, g_field_names, field_name) < 0 do
                        idx = vec_len_rt(g_field_names)
                        g_field_names = vec_push_rt(g_field_names, field_name as i64)
                        g_field_indices = vec_push_rt(g_field_indices, actual_field_idx)
                        hash_table_insert(g_field_hash, g_field_names, field_name, idx)
                    end
                    if child_type == AstType.RegisterDef and hash_table_lookup(g_regfield_hash, g_register_field_names, field_name) < 0 do
                        width = ast_node_builtin_id(field)
                        if width <= 0 do width = 1 end
                        idx = vec_len_rt(g_register_field_names)
                        g_register_field_names = vec_push_rt(g_register_field_names, field_name as i64)
                        g_register_field_starts = vec_push_rt(g_register_field_starts, ast_node_int_val(field))
                        g_register_field_widths = vec_push_rt(g_register_field_widths, width)
                        hash_table_insert(g_regfield_hash, g_register_field_names, field_name, idx)
                    end
                    actual_field_idx = actual_field_idx + 1
                end
                j = j + 1
            end
        end
        i = i + 1
    end

    var pk_i = 0
    when pk_i < n loop
        pk_child = ast_node_child(ast, pk_i)
        if ast_node_type_of(pk_child) == AstType.PackedDef do
            compute_packed_layout(pk_child)
        end
        pk_i = pk_i + 1
    end

    global_n = ast_node_child_count(ast)
    var global_i = 0
    when global_i < global_n loop
        global_node = ast_node_child(ast, global_i)
        if ast_node_type_of(global_node) == AstType.VarDecl do
            global_name = ast_node_name(global_node)
            if hash_table_lookup(g_lower_global_hash, g_lower_global_names, global_name) < 0 do
                global_slot = vec_len_rt(g_lower_global_names)
                global_value = 0
                init_node = 0
                if ast_node_child_count(global_node) > 0 do
                    init_node = ast_node_child(global_node, 0) as i64
                    global_value = eval_const_expr(ast_node_child(global_node, 0))
                end
                g_lower_global_names = vec_push_rt(g_lower_global_names, global_name as i64)
                g_lower_global_values = vec_push_rt(g_lower_global_values, global_value)
                g_lower_global_init_nodes = vec_push_rt(g_lower_global_init_nodes, init_node)
                hash_table_insert(g_lower_global_hash, g_lower_global_names, global_name, global_slot)
            end
        end
        global_i = global_i + 1
    end
end.

func global_slot_lookup(name: string):
    out hash_table_lookup(g_lower_global_hash, g_lower_global_names, name)
end.

func get_scoped_field_type(entity_name: string, field_name: string):
    if g_scoped_field_hash != 0 and entity_name != 0 and field_name != 0 do
        dot_str = fat_str_new(".")
        scoped_key = fat_str_concat(fat_str_concat(entity_name, dot_str), field_name)
        idx_s = hash_table_lookup(g_scoped_field_hash, g_scoped_field_names, scoped_key)
        if idx_s >= 0 do
            out vec_get_rt(g_scoped_field_types, idx_s) as string
        end
    end
    out fat_str_new("")
end.

func get_scoped_field_index(entity_name: string, field_name: string):
    if g_scoped_field_hash != 0 and entity_name != 0 and field_name != 0 do
        dot_str = fat_str_new(".")
        scoped_key = fat_str_concat(fat_str_concat(entity_name, dot_str), field_name)
        idx_s = hash_table_lookup(g_scoped_field_hash, g_scoped_field_names, scoped_key)
        if idx_s >= 0 do
            out vec_get_rt(g_scoped_field_indices, idx_s)
        end
    end
    out 0 - 1
end.

func get_scoped_field_offset(entity_name: string, field_name: string):
    if g_scoped_field_hash != 0 and entity_name != 0 and field_name != 0 do
        dot_str = fat_str_new(".")
        scoped_key = fat_str_concat(fat_str_concat(entity_name, dot_str), field_name)
        idx_s = hash_table_lookup(g_scoped_field_hash, g_scoped_field_names, scoped_key)
        if idx_s >= 0 and idx_s < vec_len_rt(g_scoped_field_offsets) do
            out vec_get_rt(g_scoped_field_offsets, idx_s)
        end
    end
    out 0
end.

func get_scoped_field_size(entity_name: string, field_name: string):
    if g_scoped_field_hash != 0 and entity_name != 0 and field_name != 0 do
        dot_str = fat_str_new(".")
        scoped_key = fat_str_concat(fat_str_concat(entity_name, dot_str), field_name)
        idx_s = hash_table_lookup(g_scoped_field_hash, g_scoped_field_names, scoped_key)
        if idx_s >= 0 and idx_s < vec_len_rt(g_scoped_field_sizes) do
            out vec_get_rt(g_scoped_field_sizes, idx_s)
        end
    end
    out 8
end.

func get_scoped_field_signed(entity_name: string, field_name: string):
    if g_scoped_field_hash != 0 and entity_name != 0 and field_name != 0 do
        dot_str = fat_str_new(".")
        scoped_key = fat_str_concat(fat_str_concat(entity_name, dot_str), field_name)
        idx_s = hash_table_lookup(g_scoped_field_hash, g_scoped_field_names, scoped_key)
        if idx_s >= 0 and idx_s < vec_len_rt(g_scoped_field_signed) do
            out vec_get_rt(g_scoped_field_signed, idx_s)
        end
    end
    out 0
end.

func get_scoped_field_is_nested(entity_name: string, field_name: string):
    if g_scoped_field_hash != 0 and entity_name != 0 and field_name != 0 do
        dot_str = fat_str_new(".")
        scoped_key = fat_str_concat(fat_str_concat(entity_name, dot_str), field_name)
        idx_s = hash_table_lookup(g_scoped_field_hash, g_scoped_field_names, scoped_key)
        if idx_s >= 0 and idx_s < vec_len_rt(g_scoped_field_is_nested) do
            out vec_get_rt(g_scoped_field_is_nested, idx_s)
        end
    end
    out 0
end.

func get_entity_field_name_by_index(ent_name: string, target_idx: i64):
    if g_entity_hash != 0 and ent_name != 0 do
        e_idx = hash_table_lookup(g_entity_hash, g_entity_names, ent_name)
        if e_idx >= 0 and e_idx < vec_len_rt(g_entity_nodes) do
            ent_ast = vec_get_rt(g_entity_nodes, e_idx) as AstNode
            if (ent_ast as i64) != 0 do
                n_ch = ast_node_child_count(ent_ast)
                var j = 0
                var actual_idx = 0
                when j < n_ch loop
                    f_child = ast_node_child(ent_ast, j)
                    if ast_node_type_of(f_child) != AstType.FuncDef do
                        if actual_idx == target_idx do
                            out ast_node_name(f_child)
                        end
                        actual_idx = actual_idx + 1
                    end
                    j = j + 1
                end
            end
        end
    end
    out fat_str_new("")
end.

func compute_packed_layout(ent_ast: AstNode):
    ent_name = ast_node_name(ent_ast)
    e_idx = hash_table_lookup(g_entity_hash, g_entity_names, ent_name)
    if e_idx < 0 do out 0 end
    if vec_get_rt(g_entity_sizes, e_idx) > 0 do
        out vec_get_rt(g_entity_sizes, e_idx)
    end
    var cur_off = 0
    n_ch = ast_node_child_count(ent_ast)
    var j = 0
    when j < n_ch loop
        f_node = ast_node_child(ent_ast, j)
        if ast_node_type_of(f_node) != AstType.FuncDef do
            f_name = ast_node_name(f_node)
            ft = ast_node_name2(f_node)
            if ft == 0 do ft = fat_str_new("") end
            dot_str = fat_str_new(".")
            scoped_key = fat_str_concat(fat_str_concat(ent_name, dot_str), f_name)
            idx_s = hash_table_lookup(g_scoped_field_hash, g_scoped_field_names, scoped_key)
            
            var f_sz = 8
            var f_sgn = 0
            var f_nested = 0
            if is_packed_entity(ft) do
                var ft_e_idx = hash_table_lookup(g_entity_hash, g_entity_names, ft)
                if ft_e_idx >= 0 and ft_e_idx < vec_len_rt(g_entity_nodes) do
                    var ft_node = vec_get_rt(g_entity_nodes, ft_e_idx) as AstNode
                    if (ft_node as i64) != 0 do
                        compute_packed_layout(ft_node)
                    end
                end
                f_sz = get_type_byte_size(ft)
                f_nested = 1
                f_sgn = 0
            else
                f_sz = get_type_byte_size(ft)
                f_sgn = is_signed_type(ft)
                f_nested = 0
            end
            
            if idx_s >= 0 do
                vec_set_rt(g_scoped_field_offsets, idx_s, cur_off)
                vec_set_rt(g_scoped_field_sizes, idx_s, f_sz)
                vec_set_rt(g_scoped_field_signed, idx_s, f_sgn)
                vec_set_rt(g_scoped_field_is_nested, idx_s, f_nested)
            end
            cur_off = cur_off + f_sz
        end
        j = j + 1
    end
    vec_set_rt(g_entity_sizes, e_idx, cur_off)
    out cur_off
end.

func get_expr_entity_type(node: AstNode):
    if node == 0 do out fat_str_new("") end
    nt = ast_node_type_of(node)
    if nt == AstType.Identifier do
        vname = ast_node_name(node)
        vt = get_var_type(vname)
        if vt != 0 and fat_str_len(vt) > 0 do out vt end
        if is_entity_name(vname) == 1 do out vname end
        out fat_str_new("")
    end
    if nt == AstType.FieldAccess do
        if ast_node_child_count(node) > 0 do
            base_node = ast_node_child(node, 0)
            base_type = get_expr_entity_type(base_node)
            if fat_str_len(base_type) > 0 do
                field_name = ast_node_name(node)
                out get_scoped_field_type(base_type, field_name)
            end
        end
        out fat_str_new("")
    end
    if nt == AstType.EntityLiteral do
        out ast_node_name(node)
    end
    if nt == AstType.Call do
        callee = resolve_callee_alias(ast_node_name(node))
        if is_entity_name(callee) == 1 do out callee end
        out fat_str_new("")
    end
    if nt == AstType.MethodCall and ast_node_child_count(node) > 0 do
        recv_type = get_expr_entity_type(ast_node_child(node, 0))
        if fat_str_len(recv_type) > 0 do
            method_key = get_scoped_method_name(recv_type, ast_node_name(node))
            if fat_str_len(method_key) > 0 do
                method_idx = hash_table_lookup(g_scoped_method_hash, g_scoped_method_names, method_key)
                if method_idx >= 0 and g_scoped_method_nodes != 0 and method_idx < vec_len_rt(g_scoped_method_nodes) do
                    method_node = vec_get_rt(g_scoped_method_nodes, method_idx) as AstNode
                    if (method_node as i64) != 0 do
                        return_name = ast_node_name2(method_node)
                        if is_entity_name(return_name) == 1 do out return_name end
                    end
                end
            end
        end
        out fat_str_new("")
    end
    out fat_str_new("")
end.

func find_field_index_for_base(base_name: string, field_name: string):
    if base_name != 0 do
        var ent_type = get_var_type(base_name)
        if ent_type == 0 and is_entity_name(base_name) == 1 do
            ent_type = base_name
        end
        if ent_type != 0 do
            idx_s = get_scoped_field_index(ent_type, field_name)
            if idx_s >= 0 do
                out idx_s
            end
        end
    end

    # Lexer entity fields (base is lex, lex2, etc.)
    if fat_cstr_eq(base_name, "lex") == 1 or fat_cstr_eq(base_name, "lex2") == 1 or fat_cstr_eq(base_name, "l") == 1 do
        if fat_cstr_eq(field_name, "source") == 1 do out 0 end
        if fat_cstr_eq(field_name, "source_len") == 1 do out 1 end
        if fat_cstr_eq(field_name, "pos") == 1 do out 2 end
        if fat_cstr_eq(field_name, "line") == 1 do out 3 end
        if fat_cstr_eq(field_name, "col") == 1 do out 4 end
        if fat_cstr_eq(field_name, "tokens") == 1 do out 5 end
        if fat_cstr_eq(field_name, "paren_depth") == 1 do out 6 end
        if fat_cstr_eq(field_name, "keywords") == 1 do out 7 end
        if fat_cstr_eq(field_name, "error_msg") == 1 do out 8 end
    end

    # Parser entity fields (tokens:0, pos:1, token_count:2, error_msg:3, error_line:4, builtins:5)
    if fat_cstr_eq(field_name, "token_count") == 1 do out 2 end
    if fat_cstr_eq(field_name, "builtins") == 1 do out 5 end
    if fat_cstr_eq(field_name, "tokens") == 1 do out 0 end
    if fat_cstr_eq(field_name, "pos") == 1 do out 1 end
    if fat_cstr_eq(field_name, "error_line") == 1 do out 4 end
    if fat_cstr_eq(field_name, "error_msg") == 1 do
        if fat_cstr_eq(base_name, "lex") == 1 or fat_cstr_eq(base_name, "lex2") == 1 or fat_cstr_eq(base_name, "l") == 1 do
            out 8
        end
        out 3
    end

    # StringBuilder entity fields (buf: 0, len: 1, cap: 2)
    if fat_cstr_eq(field_name, "buf") == 1 do out 0 end
    if fat_cstr_eq(field_name, "cap") == 1 do out 2 end
    if fat_cstr_eq(base_name, "sb") == 1 or fat_cstr_eq(base_name, "sb_pre") == 1 or fat_cstr_eq(base_name, "sb_src") == 1 or fat_cstr_eq(base_name, "builder") == 1 or fat_cstr_eq(base_name, "out_sb") == 1 or fat_cstr_eq(base_name, "resp_sb") == 1 do
        if fat_cstr_eq(field_name, "len") == 1 do out 1 end
    end

    # Token entity fields (tok_type:0, line:1, col:2, start:3, len:4, str_val:5, int_val:6, float_val:7)
    if fat_cstr_eq(field_name, "tok_type") == 1 do out 0 end
    if fat_cstr_eq(field_name, "str_val") == 1 do out 5 end
    if fat_cstr_eq(base_name, "t") == 1 or fat_cstr_eq(base_name, "t2") == 1 or fat_cstr_eq(base_name, "t3") == 1 or fat_cstr_eq(base_name, "tok") == 1 or fat_cstr_eq(base_name, "op_tok") == 1 or fat_cstr_eq(base_name, "id_tok") == 1 or fat_cstr_eq(base_name, "name_tok") == 1 or fat_cstr_eq(base_name, "field_tok") == 1 or fat_cstr_eq(base_name, "count_tok") == 1 or fat_cstr_eq(base_name, "int_tok") == 1 or fat_cstr_eq(base_name, "hi_tok") == 1 or fat_cstr_eq(base_name, "it") == 1 or fat_cstr_eq(base_name, "st") == 1 or fat_cstr_eq(base_name, "cur") == 1 or fat_cstr_eq(base_name, "prev") == 1 or fat_cstr_eq(base_name, "vt") == 1 or fat_cstr_eq(base_name, "end_tok") == 1 or fat_cstr_eq(base_name, "val_tok") == 1 do
        if fat_cstr_eq(field_name, "line") == 1 do out 1 end
        if fat_cstr_eq(field_name, "col") == 1 do out 2 end
        if fat_cstr_eq(field_name, "start") == 1 do out 3 end
        if fat_cstr_eq(field_name, "len") == 1 do out 4 end
        if fat_cstr_eq(field_name, "int_val") == 1 do out 6 end
        if fat_cstr_eq(field_name, "float_val") == 1 do out 7 end
    end

    out find_field_index(field_name)
end.

func find_field_index(field_name: string):
    # Builtin compiler entity field indices (AstNode, Token, Lexer, ScopeNode, SymbolNode)
    if fat_cstr_eq(field_name, "name") == 1 do out 0 end
    if fat_cstr_eq(field_name, "name2") == 1 do out 1 end
    if fat_cstr_eq(field_name, "node_type") == 1 do out 2 end
    if fat_cstr_eq(field_name, "op") == 1 do out 3 end
    if fat_cstr_eq(field_name, "line") == 1 do out 4 end
    if fat_cstr_eq(field_name, "int_val") == 1 do out 5 end
    if fat_cstr_eq(field_name, "float_val") == 1 do out 6 end
    if fat_cstr_eq(field_name, "builtin_id") == 1 do out 7 end
    if fat_cstr_eq(field_name, "children") == 1 do out 8 end

    if fat_cstr_eq(field_name, "parent_id") == 1 do out 1 end
    if fat_cstr_eq(field_name, "symbols") == 1 do out 2 end
    if fat_cstr_eq(field_name, "scopes") == 1 do out 0 end
    if fat_cstr_eq(field_name, "current_id") == 1 do out 1 end
    if fat_cstr_eq(field_name, "name_id") == 1 do out 1 end
    if fat_cstr_eq(field_name, "type_id") == 1 do out 2 end
    if fat_cstr_eq(field_name, "scope_id") == 1 do out 3 end
    if fat_cstr_eq(field_name, "ast_id") == 1 do out 4 end
    if fat_cstr_eq(field_name, "is_mutable") == 1 do out 5 end
    if fat_cstr_eq(field_name, "offset") == 1 do out 6 end
    if fat_cstr_eq(field_name, "param_count") == 1 do out 7 end
    if fat_cstr_eq(field_name, "return_type") == 1 do out 8 end

    if fat_cstr_eq(field_name, "tok_type") == 1 do out 0 end
    if fat_cstr_eq(field_name, "col") == 1 do out 2 end
    if fat_cstr_eq(field_name, "start") == 1 do out 3 end
    if fat_cstr_eq(field_name, "len") == 1 do out 4 end
    if fat_cstr_eq(field_name, "str_val") == 1 do out 5 end

    if fat_cstr_eq(field_name, "source") == 1 do out 0 end
    if fat_cstr_eq(field_name, "source_len") == 1 do out 1 end
    if fat_cstr_eq(field_name, "pos") == 1 do out 2 end
    if fat_cstr_eq(field_name, "token_count") == 1 do out 3 end
    if fat_cstr_eq(field_name, "error_line") == 1 do out 4 end
    if fat_cstr_eq(field_name, "tokens") == 1 do out 5 end
    if fat_cstr_eq(field_name, "paren_depth") == 1 do out 6 end
    if fat_cstr_eq(field_name, "builtins") == 1 do out 6 end
    if fat_cstr_eq(field_name, "keywords") == 1 do out 7 end
    if fat_cstr_eq(field_name, "error_msg") == 1 do out 8 end

    idx = lookup_cached_name(g_field_names, field_name)
    if idx >= 0 do out vec_get_rt(g_field_indices, idx) end
    out 0
end.

func resolve_callee_alias(callee_name: string):
    idx = lookup_cached_name(g_import_aliases, callee_name)
    if idx >= 0 do out vec_get_rt(g_import_targets, idx) as string end
    out callee_name
end.

func is_entity_name(type_name: string):
    out lookup_cached_name(g_entity_names, type_name) >= 0
end.

func is_register_field(field_name: string):
    if g_register_field_names == 0 do out 0 end
    if (field_name as i64) < 4096 do out 0 end
    if lookup_cached_name(g_register_field_names, field_name) >= 0 do out 1 end
    out 0
end.

func get_register_field_start(field_name: string):
    if g_register_field_names == 0 do out 0 end
    idx = lookup_cached_name(g_register_field_names, field_name)
    if idx >= 0 do out vec_get_rt(g_register_field_starts, idx) end
    out 0
end.

func get_register_field_width(field_name: string):
    if g_register_field_names == 0 do out 1 end
    idx = lookup_cached_name(g_register_field_names, field_name)
    if idx >= 0 do out vec_get_rt(g_register_field_widths, idx) end
    out 1
end.

func is_register_field_scoped(base_type: string, field_name: string):
    out is_register_field(field_name)
end.

func get_register_field_start_scoped(base_type: string, field_name: string):
    out get_register_field_start(field_name)
end.

func get_register_field_width_scoped(base_type: string, field_name: string):
    out get_register_field_width(field_name)
end.

func as_mir_func(f: MirFunc):
	out f
end.
func builder_func(b: MirBuilder):
	f = native_read_i64(b as i64, 32)
	if f != 0 do out f end
    fb = native_read_i64(b as i64, 24)
	f = vec_get_rt(fb, 0)
	native_write_i64(b as i64, 32, f)
	out f
end.

func builder_set_func(b: MirBuilder, f: MirFunc):
	fb = native_read_i64(b as i64, 24)
	if vec_len_rt(fb) == 0 do
		fb = vec_push_rt(fb, f as i64)
	else
		vec_set_rt(fb, 0, f as i64)
    end
    native_write_i64(b as i64, 24, fb)
	native_write_i64(b as i64, 32, f as i64)
	out b
end.

func name_hash_bucket(name: string):
	n = fat_str_len(name as int) as i64
	h = n * 17
	var i = 0
	when i < n loop
		h = h * 131 + (fat_str_byte_at(name as int, i) as i64)
		i = i + 1
	end
	if h < 0 do
		h = 0 - h
	end
	out h mod MIR_VAR_BUCKETS
end.

func builder_pack(cb: i64, vc: i64, loops: i64, fb: i64, cur_func: i64, cur_block: i64):
    p = alloc(48)
    native_write_i64(p, 0, cb)
    native_write_i64(p, 8, vc)
    native_write_i64(p, 16, loops)
    native_write_i64(p, 24, fb)
    native_write_i64(p, 32, cur_func)
    native_write_i64(p, 40, cur_block)
    out p
end.

func builder_new(func_id: i64, fname: string):
	buckets = vec_new_rt()
	var bi = 0
	when bi < MIR_VAR_BUCKETS loop
		# Allocate buckets on first write. Most small functions use only a
		# handful of the 64 slots, so eager vectors waste tens of thousands
		# of allocations during self-host lowering.
		buckets = vec_push_rt(buckets, 0)
		bi = bi + 1
	end
	b0 = mir_create_block(0)
	blocks = vec_new_rt()
	blocks = vec_push_rt(blocks, b0)
	f = mir_func_new(func_id, fname, 0, vec_new_rt(), 1, 0, blocks, vec_new_rt(), buckets)
	fb = vec_new_rt()
	fb = vec_push_rt(fb, f)
	out builder_pack(0, 0, vec_new_rt(), fb, f as i64, b0 as i64)
end.

func builder_intern(b: MirBuilder, s: string):
	var (f2, sid) = mir_intern_string(builder_func(b), s)
	out (builder_set_func(b, f2), sid)
end.

func builder_new_vreg(b: MirBuilder):
	reg = native_read_i64(b as i64, 8)
    native_write_i64(b as i64, 8, reg + 1)
	out (b, reg)
end.

func builder_add_block(b: MirBuilder):
	f = builder_func(b)
    f_blocks = native_read_i64(f as i64, 48)
	id = vec_len_rt(f_blocks)
	blk = mir_create_block(id)
    f_blocks = vec_push_rt(f_blocks, blk)
    native_write_i64(f as i64, 48, f_blocks)
    native_write_i64(f as i64, 32, id + 1)
	out (b, id)
end.

func builder_set_current_block(b: MirBuilder, cb: i64):
    native_write_i64(b as i64, 0, cb)
	block_ptr = 0
	if cb >= 0 do
		f = builder_func(b)
		f_blocks = native_read_i64(f as i64, 48)
		if cb < vec_len_rt(f_blocks) do block_ptr = vec_get_rt(f_blocks, cb) end
	end
	native_write_i64(b as i64, 40, block_ptr)
    out b
end.

func builder_add_instr(b: MirBuilder, instr: MirInstr):
    cb = native_read_i64(b as i64, 0)
	if cb < 0 do
		out b
	end
	blk = native_read_i64(b as i64, 40)
	if blk == 0 do
		f = builder_func(b)
		f_blocks = native_read_i64(f as i64, 48)
		blk = vec_get_rt(f_blocks, cb)
		native_write_i64(b as i64, 40, blk)
	end
    blk_head = native_read_i64(blk as i64, 16)
	blk_head = vec_push_rt(blk_head, instr as i64)
	native_write_i64(blk as i64, 16, blk_head)
	out b
end.

func builder_current_block_terminated(b: MirBuilder):
    cb = native_read_i64(b as i64, 0)
    if cb < 0 do out true end
    blk = native_read_i64(b as i64, 40)
    if blk == 0 do
        f = builder_func(b)
        f_blocks = native_read_i64(f as i64, 48)
        if cb >= vec_len_rt(f_blocks) do out false end
        blk = vec_get_rt(f_blocks, cb)
    end
    instrs = native_read_i64(blk as i64, 16)
    n = vec_len_rt(instrs)
    if n <= 0 do out false end
    last = vec_get_rt(instrs, n - 1)
    op = native_read_i64(last as i64, 0)
    out op == MirOp.Jump or op == MirOp.JumpIf or op == MirOp.JumpIfNot or op == MirOp.Return
end.

func builder_edge_exists(b: MirBuilder, from_b: i64, to_b: i64):
	if from_b < 0 or to_b < 0 do
		out 0
	end
	f = builder_func(b)
    f_blocks = native_read_i64(f as i64, 48)
	src = vec_get_rt(f_blocks, from_b)
	succs = native_read_i64(src as i64, 32)
	n = vec_len_rt(succs)
	var i = 0
	when i < n loop
		if vec_get_rt(succs, i) == to_b do
			out 1
		end
		i = i + 1
	end
	out 0
end.

func builder_add_edge(b: MirBuilder, from_b: i64, to_b: i64):
	if from_b >= 0 and to_b >= 0 do
		if builder_edge_exists(b, from_b, to_b) == 0 do
			f = builder_func(b)
			f_blocks = native_read_i64(f as i64, 48)
			src = vec_get_rt(f_blocks, from_b)
			dst = vec_get_rt(f_blocks, to_b)
			src_succs = native_read_i64(src as i64, 32)
			if src_succs == 0 do src_succs = vec_new_rt() end
			src_succs = vec_push_rt(src_succs, to_b)
            native_write_i64(src as i64, 32, src_succs)
			dst_preds = native_read_i64(dst as i64, 40)
			if dst_preds == 0 do dst_preds = vec_new_rt() end
			dst_preds = vec_push_rt(dst_preds, from_b)
            native_write_i64(dst as i64, 40, dst_preds)
		end
	end
	out b
end.

func builder_push_loop(b: MirBuilder, break_id: i64, cont_id: i64):
	lt = loop_target_new(break_id, cont_id)
    ls = native_read_i64(b as i64, 16)
    ls = vec_push_rt(ls, lt)
    native_write_i64(b as i64, 16, ls)
	out b
end.

func builder_pop_loop(b: MirBuilder):
    ls = native_read_i64(b as i64, 16)
    if vec_len_rt(ls) > 0 do
        vec_pop_rt(ls)
    end
    out b
end.

func builder_loop_top(b: MirBuilder):
    ls = native_read_i64(b as i64, 16)
	n = vec_len_rt(ls)
	if n <= 0 do
		out loop_target_new(0 - 1, 0 - 1)
	end
	out vec_get_rt(ls, n - 1)
end.

func builder_loop_depth(b: MirBuilder):
    ls = native_read_i64(b as i64, 16)
    if ls <= 0 do out 0 end
    out vec_len_rt(ls)
end.

func buckets_get_var(buckets: i64, name: string):
	if buckets == 0 or (name as i64) == 0 do out 0 - 1 end
	bid = name_hash_bucket(name)
	bucket = vec_get_rt(buckets, bid)
	if bucket == 0 do out 0 - 1 end
	var i = 0
	n = vec_len_rt(bucket)
	when i < n loop
		vm = vec_get_rt(bucket, i)
		vname = var_map_name(vm)
		if fat_str_eq(vname, name) == 1 do
			out var_map_vreg(vm)
		end
		i = i + 1
	end
	out 0 - 1
end.

func buckets_set_var(buckets: i64, name: string, vreg: i64):
	if buckets == 0 or (name as i64) == 0 do out 0 end
	bid = name_hash_bucket(name)
	bucket = vec_get_rt(buckets, bid)
	if bucket == 0 do bucket = vec_new_rt() end
	var i = 0
	n = vec_len_rt(bucket)
	var found = false
	when i < n loop
		vm = vec_get_rt(bucket, i)
		vname = var_map_name(vm)
		if fat_str_eq(vname, name) == 1 do
			vec_set_rt(bucket, i, var_map_new(vname, vreg))
			found = true
			i = n
		end
		i = i + 1
	end
	if not found do
		bucket = vec_push_rt(bucket, var_map_new(name, vreg))
	end
	vec_set_rt(buckets, bid, bucket)
	out 0
end.

func buckets_remove_var(buckets: i64, name: string):
	if buckets == 0 or (name as i64) == 0 do out 0 end
	bid = name_hash_bucket(name)
	bucket = vec_get_rt(buckets, bid)
	if bucket == 0 do out 0 end
	new_bucket = vec_new_rt()
	var i = 0
	n = vec_len_rt(bucket)
	when i < n loop
		vm = vec_get_rt(bucket, i)
		vname = var_map_name(vm)
		if fat_str_eq(vname, name) == 0 do
			new_bucket = vec_push_rt(new_bucket, vm)
		end
		i = i + 1
	end
	vec_set_rt(buckets, bid, new_bucket)
	out 0
end.

func get_var_vreg(b: MirBuilder, name: string):
	f = builder_func(b)
	buckets = native_read_i64(f as i64, 64)
	out buckets_get_var(buckets, name)
end.

func set_var_vreg(b: MirBuilder, name: string, vreg: i64):
	f = builder_func(b)
	buckets = native_read_i64(f as i64, 64)
	buckets_set_var(buckets, name, vreg)
	out b
end.

func remove_var_vreg(b: MirBuilder, name: string):
	f = builder_func(b)
	buckets = native_read_i64(f as i64, 64)
	buckets_remove_var(buckets, name)
	out b
end.

func push_scope():
	if g_scope_stack == 0 do
		g_scope_stack = vec_new_rt()
	end
	frame = vec_new_rt()
	frame = vec_push_rt(frame, vec_new_rt())
	frame = vec_push_rt(frame, vec_new_rt())
	frame = vec_push_rt(frame, vec_new_rt())
	g_scope_stack = vec_push_rt(g_scope_stack, frame)
end.

func record_var_declaration(name: string):
	if g_scope_stack != 0 and (name as i64) != 0 do
		stack_len = vec_len_rt(g_scope_stack)
		if stack_len > 1 do
			cur_frame = vec_get_rt(g_scope_stack, stack_len - 1)
			names = vec_get_rt(cur_frame, 0)
			vregs = vec_get_rt(cur_frame, 1)
			types = vec_get_rt(cur_frame, 2)
			var already_in_frame = false
			var fi = 0
			fn = vec_len_rt(names)
			when fi < fn loop
				entry_name = vec_get_rt(names, fi) as string
				if fat_str_eq(entry_name, name) == 1 do
					already_in_frame = true
					fi = fn
				end
				fi = fi + 1
			end
			if not already_in_frame do
				pv = buckets_get_var(g_current_func_buckets, name)
				pt = get_var_type(name)
				if (pt as i64) == 0 do pt = fat_str_new("") end
				names = vec_push_rt(names, name as i64)
				vregs = vec_push_rt(vregs, pv)
				types = vec_push_rt(types, pt as i64)
				vec_set_rt(cur_frame, 0, names)
				vec_set_rt(cur_frame, 1, vregs)
				vec_set_rt(cur_frame, 2, types)
			end
		end
	end
end.

func pop_scope():
	if g_scope_stack != 0 do
		stack_len = vec_len_rt(g_scope_stack)
		if stack_len > 1 do
			cur_frame = vec_get_rt(g_scope_stack, stack_len - 1)
			names = vec_get_rt(cur_frame, 0)
			vregs = vec_get_rt(cur_frame, 1)
			types = vec_get_rt(cur_frame, 2)
			fn = vec_len_rt(names)
			var fi = 0
			when fi < fn loop
				vname = vec_get_rt(names, fi) as string
				pv = vec_get_rt(vregs, fi)
				pt = vec_get_rt(types, fi) as string
				if pv >= 0 do
					buckets_set_var(g_current_func_buckets, vname, pv)
				else
					buckets_remove_var(g_current_func_buckets, vname)
				end
				if (pt as i64) != 0 and fat_str_len(pt) > 0 do
					set_var_type(vname, pt)
				else
					set_var_type(vname, fat_str_new(""))
				end
				fi = fi + 1
			end
			vec_pop_rt(g_scope_stack)
		else
			if stack_len == 1 do
				vec_pop_rt(g_scope_stack)
			end
		end
	end
end.

func emit_jump(b: MirBuilder, target: i64):
	ins = mir_instr_new(MirOp.Jump, mir_opnd_none(), mir_opnd_imm(target), mir_opnd_none())
	b = builder_add_instr(b, ins)
    cb = native_read_i64(b as i64, 0)
	b = builder_add_edge(b, cb, target)
	out b
end.

func emit_jump_if(b: MirBuilder, cond: MirOperand, then_id: i64, else_id: i64):
	ins = mir_instr_new(MirOp.JumpIf, mir_opnd_none(), cond, mir_opnd_imm(then_id))
	b = builder_add_instr(b, ins)
	ins2 = mir_instr_new(MirOp.Jump, mir_opnd_none(), mir_opnd_imm(else_id), mir_opnd_none())
	b = builder_add_instr(b, ins2)
    cb = native_read_i64(b as i64, 0)
	b = builder_add_edge(b, cb, then_id)
	b = builder_add_edge(b, cb, else_id)
	out b
end.

func emit_set_arg(b: MirBuilder, idx: i64, val: MirOperand):
	ins = mir_instr_new(MirOp.SetArg, mir_opnd_none(), mir_opnd_imm(idx), val)
	out builder_add_instr(b, ins)
end.

func emit_intrinsic(b: MirBuilder, kind: i64, dst: MirOperand, src1: MirOperand):
	ins = mir_instr_new(MirOp.Intrinsic, dst, src1, mir_opnd_imm(kind))
	out builder_add_instr(b, ins)
end.

func emit_intrinsic_typed(b: MirBuilder, kind: i64, dst: MirOperand, src1: MirOperand, typ: i64):
	ins = mir_instr_new(MirOp.Intrinsic, dst, src1, mir_opnd_imm(kind))
	mir_instr_set_type(ins, typ)
	out builder_add_instr(b, ins)
end.

func emit_jump_if_not(b: MirBuilder, cond: MirOperand, then_id: i64, else_id: i64):
    # JumpIfNot → jump to then_id when cond==0 (false); else fall through to else_id.
    cb = native_read_i64(b as i64, 0)
	ins = mir_instr_new(MirOp.JumpIfNot, mir_opnd_none(), cond, mir_opnd_imm(then_id))
	b = builder_add_instr(b, ins)
    # Add edge to then_id (the exit/break branch) — required for correct dominance frontier
    b = builder_add_edge(b, cb, then_id)
	b = emit_jump(b, else_id)
	out b
end.

func emit_move(b: MirBuilder, dst_v: i64, src: MirOperand):
	ins = mir_instr_new(MirOp.Move, mir_opnd_vreg(dst_v), src, mir_opnd_none())
	out builder_add_instr(b, ins)
end.

func emit_store(b: MirBuilder, addr: MirOperand, val: MirOperand):
	ins = mir_instr_new(MirOp.Store, mir_opnd_none(), val, addr)
	out builder_add_instr(b, ins)
end.

func emit_load(b: MirBuilder, dst_v: i64, addr: MirOperand):
	ins = mir_instr_new(MirOp.Load, mir_opnd_vreg(dst_v), addr, mir_opnd_none())
	out builder_add_instr(b, ins)
end.

func emit_store_typed(b: MirBuilder, addr: MirOperand, val: MirOperand, sz: i64):
	ins = mir_instr_new(MirOp.Store, mir_opnd_none(), val, addr)
	mir_instr_set_aux(ins, sz)
	out builder_add_instr(b, ins)
end.

func emit_load_typed(b: MirBuilder, dst_v: i64, addr: MirOperand, sz: i64, sgn: i64):
	var aux = sz
	if sgn == 1 do
		aux = 0 - sz
	end
	ins = mir_instr_new(MirOp.Load, mir_opnd_vreg(dst_v), addr, mir_opnd_none())
	mir_instr_set_aux(ins, aux)
	out builder_add_instr(b, ins)
end.

func lower_aggregate(b: MirBuilder, kind: i64, expr: AstNode):
	# Arrays / entities / tuples all lower to a heap buffer of n 8-byte slots.
	# Allocate via the `alloc` builtin (id 3) and store each element with
	# INDEX_STORE so the element count is not bounded by the ABI arg registers.
	n = ast_node_child_count(expr)
	if kind == MIR_INTR_ARRAY do
		b_mut = emit_set_arg(b, 0, mir_opnd_imm(16 + n * 8))
		var (b_base, base) = builder_new_vreg(b_mut)
		b_base = emit_intrinsic(b_base, MIR_INTR_BUILTIN, mir_opnd_vreg(base), mir_opnd_imm(3))
		b_mut = b_base
		b_mut = emit_set_arg(b_mut, 0, mir_opnd_vreg(base))
		b_mut = emit_set_arg(b_mut, 1, mir_opnd_imm(0))
		b_mut = emit_set_arg(b_mut, 2, mir_opnd_imm(n))
		b_mut = emit_intrinsic(b_mut, MIR_INTR_BUILTIN, mir_opnd_none(), mir_opnd_imm(8))
		b_mut = emit_set_arg(b_mut, 0, mir_opnd_vreg(base))
		b_mut = emit_set_arg(b_mut, 1, mir_opnd_imm(8))
		b_mut = emit_set_arg(b_mut, 2, mir_opnd_imm(n))
		b_mut = emit_intrinsic(b_mut, MIR_INTR_BUILTIN, mir_opnd_none(), mir_opnd_imm(8))
		var i = 0
		when i < n loop
			var (b2, aop) = lower_expr(b_mut, ast_node_child(expr, i))
			b2 = emit_set_arg(b2, 0, mir_opnd_imm(i))
			b2 = emit_set_arg(b2, 1, aop)
			b2 = emit_intrinsic(b2, MIR_INTR_INDEX_STORE, mir_opnd_none(), mir_opnd_vreg(base))
			b_mut = b2
			i = i + 1
		end
		out (b_mut, mir_opnd_vreg(base))
	end
	if kind == MIR_INTR_ENTITY do
		ent_name = resolve_callee_alias(ast_node_name(expr))
		if is_packed_entity(ent_name) do
			total_sz = get_type_byte_size(ent_name)
			b_mut = emit_set_arg(b, 0, mir_opnd_imm(total_sz))
			var (b_base, base) = builder_new_vreg(b_mut)
			b_base = emit_intrinsic(b_base, MIR_INTR_BUILTIN, mir_opnd_vreg(base), mir_opnd_imm(3))
			b_mut = b_base
			var i = 0
			when i < n loop
				arg = ast_node_child(expr, i)
				var (b2, aop) = lower_expr(b_mut, arg)
				b_mut = b2
				fname = arg.name2
				if fname == 0 or fat_str_len(fname) == 0 do
					fname = get_entity_field_name_by_index(ent_name, i)
				end
				f_off = get_scoped_field_offset(ent_name, fname)
				f_sz = get_scoped_field_size(ent_name, fname)
				f_nested = get_scoped_field_is_nested(ent_name, fname)
				if f_nested == 1 do
					var k = 0
					when k < f_sz loop
						var (b_s, src_addr) = builder_new_vreg(b_mut)
						ins_s = mir_instr_new(MirOp.Add, mir_opnd_vreg(src_addr), aop, mir_opnd_imm(k))
						b_s = builder_add_instr(b_s, ins_s)
						var (b_l, byte_val) = builder_new_vreg(b_s)
						b_l = emit_load_typed(b_l, byte_val, mir_opnd_vreg(src_addr), 1, 0)
						var (b_d, dst_addr) = builder_new_vreg(b_l)
						ins_d = mir_instr_new(MirOp.Add, mir_opnd_vreg(dst_addr), mir_opnd_vreg(base), mir_opnd_imm(f_off + k))
						b_d = builder_add_instr(b_d, ins_d)
						b_mut = emit_store_typed(b_d, mir_opnd_vreg(dst_addr), mir_opnd_vreg(byte_val), 1)
						k = k + 1
					end
				else
					var (b_d, dst_addr) = builder_new_vreg(b_mut)
					ins_d = mir_instr_new(MirOp.Add, mir_opnd_vreg(dst_addr), mir_opnd_vreg(base), mir_opnd_imm(f_off))
					b_d = builder_add_instr(b_d, ins_d)
					b_mut = emit_store_typed(b_d, mir_opnd_vreg(dst_addr), aop, f_sz)
				end
				i = i + 1
			end
			out (b_mut, mir_opnd_vreg(base))
		end
	end
	# Entity / Tuple: flat 8-byte fields starting at offset 0
	b_mut = emit_set_arg(b, 0, mir_opnd_imm(n * 8))
	var (b_base, base) = builder_new_vreg(b_mut)
	b_base = emit_intrinsic(b_base, MIR_INTR_BUILTIN, mir_opnd_vreg(base), mir_opnd_imm(3))
	b_mut = b_base
	var i = 0
	when i < n loop
		var (b2, aop) = lower_expr(b_mut, ast_node_child(expr, i))
		b2 = emit_set_arg(b2, 0, mir_opnd_vreg(base))
		b2 = emit_set_arg(b2, 1, mir_opnd_imm(i * 8))
		b2 = emit_set_arg(b2, 2, aop)
		b2 = emit_intrinsic(b2, MIR_INTR_BUILTIN, mir_opnd_none(), mir_opnd_imm(8)) # write_word(base, i*8, aop)
		b_mut = b2
		i = i + 1
	end
	out (b_mut, mir_opnd_vreg(base))
end.

# NOTE: Do NOT pre-declare function stubs.

func as_ast_node(n: AstNode):
	out n
end.
func ast_node_name(n: AstNode):
	out n.name
end.
func ast_node_name2(n: AstNode):
	out n.name2
end.
func ast_node_type_of(n: AstNode):
	out n.node_type
end.
func ast_node_op_of(n: AstNode):
	out n.op
end.
func ast_node_line(n: AstNode):
	out n.line
end.
func ast_node_int_val(n: AstNode):
	out n.int_val
end.
func ast_node_float_val(n: AstNode):
	out n.float_val
end.
func ast_node_builtin_id(n: AstNode):
	out n.builtin_id
end.

func builtin_id_from_name_uncached(name: string):
    # Name → BuiltinId discriminant. Used when ast_add_child clobbers .builtin_id
    # (soft ABI) so LIR would otherwise BL the unresolved stub (returns 0).
    if fat_cstr_eq(name, "len") == 1 do out 1 end
    if fat_cstr_eq(name, "push") == 1 do out 2 end
    if fat_cstr_eq(name, "arr_push") == 1 do out 2 end
    if fat_cstr_eq(name, "alloc") == 1 or fat_cstr_eq(name, "vir_alloc") == 1 do out 3 end
    if fat_cstr_eq(name, "dealloc") == 1 or fat_cstr_eq(name, "free") == 1 or fat_cstr_eq(name, "vir_free") == 1 do out 4 end
    if fat_cstr_eq(name, "read_byte") == 1 or fat_cstr_eq(name, "native_read_u8") == 1 or fat_cstr_eq(name, "read_u8") == 1 or fat_cstr_eq(name, "read8") == 1 do out 5 end
    if fat_cstr_eq(name, "write_byte") == 1 or fat_cstr_eq(name, "native_write_u8") == 1 or fat_cstr_eq(name, "write_u8") == 1 or fat_cstr_eq(name, "write8") == 1 do out 6 end
    if fat_cstr_eq(name, "read_word") == 1 or fat_cstr_eq(name, "native_read_i64") == 1 or fat_cstr_eq(name, "read_i64") == 1 or fat_cstr_eq(name, "read64") == 1 do out 7 end
    if fat_cstr_eq(name, "write_word") == 1 or fat_cstr_eq(name, "native_write_i64") == 1 or fat_cstr_eq(name, "write_i64") == 1 or fat_cstr_eq(name, "write64") == 1 do out 8 end
    if fat_cstr_eq(name, "memset") == 1 or fat_cstr_eq(name, "__memset") == 1 or fat_cstr_eq(name, "fill_bytes") == 1 or fat_cstr_eq(name, "native_mem_set") == 1 do out 32 end
    if fat_cstr_eq(name, "memcpy") == 1 or fat_cstr_eq(name, "__memcpy") == 1 or fat_cstr_eq(name, "native_mem_copy") == 1 do out 31 end
    if fat_cstr_eq(name, "str_len") == 1 do out 9 end
    if fat_cstr_eq(name, "str_get") == 1 do out 10 end
    if fat_cstr_eq(name, "__clz") == 1 or fat_cstr_eq(name, "clz") == 1 do out 33 end
    if fat_cstr_eq(name, "__ctz") == 1 or fat_cstr_eq(name, "ctz") == 1 do out 34 end
    if fat_cstr_eq(name, "__popcnt") == 1 or fat_cstr_eq(name, "popcnt") == 1 do out 35 end
    if fat_cstr_eq(name, "__not") == 1 do out 37 end
    if fat_cstr_eq(name, "__neg") == 1 do out 38 end
    if fat_cstr_eq(name, "str_cat") == 1 do out 11 end
    if fat_cstr_eq(name, "str_concat") == 1 do out 11 end
    if fat_cstr_eq(name, "strcat") == 1 do out 11 end
    if fat_cstr_eq(name, "str_eq") == 1 do out 12 end
    if fat_cstr_eq(name, "file_open") == 1 or fat_cstr_eq(name, "native_file_open") == 1 do out 13 end
    if fat_cstr_eq(name, "file_read") == 1 or fat_cstr_eq(name, "native_file_read") == 1 do out 14 end
    if fat_cstr_eq(name, "file_write") == 1 or fat_cstr_eq(name, "native_file_write") == 1 do out 15 end
    if fat_cstr_eq(name, "file_close") == 1 or fat_cstr_eq(name, "native_file_close") == 1 do out 16 end
    if fat_cstr_eq(name, "file_write_byte") == 1 do out 17 end
    if fat_cstr_eq(name, "exit_prog") == 1 do out 18 end
    if fat_cstr_eq(name, "exit") == 1 do out 18 end
    if fat_cstr_eq(name, "i_to_str") == 1 do out 19 end
    if fat_cstr_eq(name, "int_to_str") == 1 do out 19 end
    if fat_cstr_eq(name, "itoa") == 1 do out 19 end
    if fat_cstr_eq(name, "str_to_i") == 1 do out 20 end
    if fat_cstr_eq(name, "str_to_int") == 1 do out 20 end
    if fat_cstr_eq(name, "arr_new") == 1 do out 21 end
    if fat_cstr_eq(name, "print_str") == 1 do out 22 end
    if fat_cstr_eq(name, "get_arg") == 1 or fat_cstr_eq(name, "rt_argv") == 1 or fat_cstr_eq(name, "rt_get_arg") == 1 do out 23 end
    if fat_cstr_eq(name, "arg_count") == 1 or fat_cstr_eq(name, "rt_argc") == 1 do out 24 end
    if fat_cstr_eq(name, "slurp_file") == 1 do out 25 end
    if fat_cstr_eq(name, "slurp_len") == 1 do out 26 end
    if fat_cstr_eq(name, "write_bytes") == 1 do out 27 end
    if fat_cstr_eq(name, "arr_len") == 1 do out 1 end
    if fat_cstr_eq(name, "atomic_load") == 1 do out 40 end
    if fat_cstr_eq(name, "atomic_store") == 1 do out 41 end
    if fat_cstr_eq(name, "atomic_cas") == 1 do out 42 end
    if fat_cstr_eq(name, "atomic_add") == 1 do out 43 end
    if fat_cstr_eq(name, "atomic_sub") == 1 do out 44 end
    if fat_cstr_eq(name, "atomic_exchange") == 1 do out 71 end
    if fat_cstr_eq(name, "atomic_swap") == 1 do out 71 end
    if fat_cstr_eq(name, "atomic_fence") == 1 do out 39 end
    if fat_cstr_eq(name, "atomic_load32") == 1 do out 72 end
    if fat_cstr_eq(name, "atomic_store32") == 1 do out 73 end
    if fat_cstr_eq(name, "atomic_add32") == 1 do out 74 end
    if fat_cstr_eq(name, "atomic_sub32") == 1 do out 75 end
    if fat_cstr_eq(name, "atomic_cas32") == 1 do out 76 end
    if fat_cstr_eq(name, "atomic_exchange32") == 1 do out 77 end
    if fat_cstr_eq(name, "atomic_swap32") == 1 do out 77 end
    if fat_cstr_eq(name, "atomic_load64") == 1 do out 78 end
    if fat_cstr_eq(name, "atomic_store64") == 1 do out 79 end
    if fat_cstr_eq(name, "atomic_add64") == 1 do out 80 end
    if fat_cstr_eq(name, "atomic_sub64") == 1 do out 81 end
    if fat_cstr_eq(name, "atomic_cas64") == 1 do out 82 end
    if fat_cstr_eq(name, "atomic_exchange64") == 1 do out 83 end
    if fat_cstr_eq(name, "atomic_swap64") == 1 do out 83 end
    if fat_cstr_eq(name, "arena_new") == 1 do out 49 end
    if fat_cstr_eq(name, "arena_alloc") == 1 do out 50 end
    if fat_cstr_eq(name, "arena_free") == 1 do out 51 end
    # syscallN helpers — all map to BuiltinId.Syscall = 30
    if fat_cstr_eq(name, "syscall0") == 1 do out 30 end
    if fat_cstr_eq(name, "syscall1") == 1 do out 30 end
    if fat_cstr_eq(name, "syscall2") == 1 do out 30 end
    if fat_cstr_eq(name, "syscall3") == 1 do out 30 end
    if fat_cstr_eq(name, "syscall4") == 1 do out 30 end
    if fat_cstr_eq(name, "syscall5") == 1 do out 30 end
    if fat_cstr_eq(name, "syscall6") == 1 do out 30 end
    if fat_cstr_eq(name, "port") == 1 do out 90 end
    if fat_cstr_eq(name, "vir_get_platform") == 1 or fat_cstr_eq(name, "sys_platform") == 1 do out 105 end
    if fat_cstr_eq(name, "vir_get_platform") == 1 do out 105 end
    out 0
end.

func builtin_id_from_name(name: string):
    if g_builtin_lookup_buckets == 0 do
        g_builtin_lookup_buckets = vec_new_rt()
        var bi = 0
        when bi < MIR_VAR_BUCKETS loop
            g_builtin_lookup_buckets = vec_push_rt(g_builtin_lookup_buckets, vec_new_rt())
            bi = bi + 1
        end
    end
    bucket_id = name_hash_bucket(name)
    bucket = vec_get_rt(g_builtin_lookup_buckets, bucket_id)
    count = vec_len_rt(bucket)
    var i = 0
    when i + 1 < count loop
        if fat_str_eq(vec_get_rt(bucket, i) as string, name) == 1 do
            out vec_get_rt(bucket, i + 1)
        end
        i = i + 2
    end
    builtin_id = builtin_id_from_name_uncached(name)
    bucket = vec_push_rt(bucket, name as i64)
    bucket = vec_push_rt(bucket, builtin_id)
    vec_set_rt(g_builtin_lookup_buckets, bucket_id, bucket)
    out builtin_id
end.

func resolve_builtin_id(expr: AstNode):
    bid = ast_node_builtin_id(expr) as i64
    if bid >= 1 and bid <= 100 do
        out bid
    end
    out builtin_id_from_name(ast_node_name(expr))
end.
func ast_node_children(n: AstNode):
	out n.children
end.
func ast_node_child(n: AstNode, i: i64):
    kids = n.children
	out vec_get_rt(kids, i) as AstNode
end.
func ast_node_child_count(n: AstNode):
    kids = n.children
	out vec_len_rt(kids)
end.

func lower_call_args(b: MirBuilder, expr: AstNode, start_child: i64, arg_base: i64):
    # Stage into fresh vregs first — a nested call clobbers X0..Xn / prior SetArgs.
	if g_mir_scratch_args == 0 do g_mir_scratch_args = vec_new_rt() end
	scratch_start = g_mir_scratch_top
	n = ast_node_child_count(expr)
	var i = start_child
	var ai = 0
	b_mut = b
	when i < n loop
		arg = ast_node_child(expr, i)
		var (b2, aop) = lower_expr(b_mut, arg)
		if g_mir_scratch_top < vec_len_rt(g_mir_scratch_args) do
			vec_set_rt(g_mir_scratch_args, g_mir_scratch_top, aop as i64)
		else
			g_mir_scratch_args = vec_push_rt(g_mir_scratch_args, aop as i64)
		end
		g_mir_scratch_top = g_mir_scratch_top + 1
		b_mut = b2
		ai = ai + 1
		i = i + 1
	end
	var j = 0
	when j < ai loop
		b_mut = emit_set_arg(b_mut, arg_base + j, vec_get_rt(g_mir_scratch_args, scratch_start + j))
		j = j + 1
	end
	g_mir_scratch_top = scratch_start
	out (b_mut, ai)
end.

func interp_type_is_int(type_name: string):
    if fat_cstr_eq(type_name, "int") == 1 or fat_cstr_eq(type_name, "i64") == 1 or fat_cstr_eq(type_name, "i32") == 1 or fat_cstr_eq(type_name, "i16") == 1 or fat_cstr_eq(type_name, "i8") == 1 do out true end
    if fat_cstr_eq(type_name, "u64") == 1 or fat_cstr_eq(type_name, "u32") == 1 or fat_cstr_eq(type_name, "u16") == 1 or fat_cstr_eq(type_name, "u8") == 1 do out true end
    out false
end.

func lower_interp_segment(b: MirBuilder, node: AstNode):
    nt = ast_node_type_of(node)
    if nt == AstType.LiteralStr do
        var (b1, sid) = builder_intern(b, ast_node_name(node))
        var (b2, dst) = builder_new_vreg(b1)
        b2 = emit_intrinsic(b2, MIR_INTR_STR_LIT, mir_opnd_vreg(dst), mir_opnd_imm(sid))
        out (b2, mir_opnd_vreg(dst))
    end
    if nt == AstType.LiteralBool or nt == AstType.LiteralNone do
        text = fat_str_new("none")
        if nt == AstType.LiteralBool do
            text = fat_str_new("false")
            if ast_node_int_val(node) != 0 do text = fat_str_new("true") end
        end
        var (b1, sid) = builder_intern(b, text)
        var (b2, dst) = builder_new_vreg(b1)
        b2 = emit_intrinsic(b2, MIR_INTR_STR_LIT, mir_opnd_vreg(dst), mir_opnd_imm(sid))
        out (b2, mir_opnd_vreg(dst))
    end

    var (b1, value) = lower_expr(b, node)
    type_name = infer_expr_type_name(node)
    if fat_cstr_eq(type_name, "none") == 1 do
        var (b_none, none_sid) = builder_intern(b1, fat_str_new("none"))
        var (b_none2, none_dst) = builder_new_vreg(b_none)
        b_none2 = emit_intrinsic(b_none2, MIR_INTR_STR_LIT, mir_opnd_vreg(none_dst), mir_opnd_imm(none_sid))
        out (b_none2, mir_opnd_vreg(none_dst))
    end
    if interp_type_is_int(type_name) do
        b1 = emit_set_arg(b1, 0, value)
        var (b2, dst) = builder_new_vreg(b1)
        b2 = emit_intrinsic(b2, MIR_INTR_BUILTIN, mir_opnd_vreg(dst), mir_opnd_imm(19))
        out (b2, mir_opnd_vreg(dst))
    end
    if fat_cstr_eq(type_name, "bool") == 1 do
        var (b2, dst) = builder_new_vreg(b1)
        var (b3, true_id) = builder_add_block(b2)
        var (b4, false_id) = builder_add_block(b3)
        var (b5, end_id) = builder_add_block(b4)
        b5 = emit_jump_if(b5, value, true_id, false_id)

        b5 = builder_set_current_block(b5, true_id)
        var (b6, true_sid) = builder_intern(b5, fat_str_new("true"))
        var (b7, true_v) = builder_new_vreg(b6)
        b7 = emit_intrinsic(b7, MIR_INTR_STR_LIT, mir_opnd_vreg(true_v), mir_opnd_imm(true_sid))
        b7 = emit_move(b7, dst, mir_opnd_vreg(true_v))
        b7 = emit_jump(b7, end_id)

        b7 = builder_set_current_block(b7, false_id)
        var (b8, false_sid) = builder_intern(b7, fat_str_new("false"))
        var (b9, false_v) = builder_new_vreg(b8)
        b9 = emit_intrinsic(b9, MIR_INTR_STR_LIT, mir_opnd_vreg(false_v), mir_opnd_imm(false_sid))
        b9 = emit_move(b9, dst, mir_opnd_vreg(false_v))
        b9 = emit_jump(b9, end_id)
        b9 = builder_set_current_block(b9, end_id)
        out (b9, mir_opnd_vreg(dst))
    end
    out (b1, value)
end.

func lower_expr_impl(b: MirBuilder, expr: AstNode):
	expr_type = ast_node_type_of(expr)

    # 1. Literal Int
	if expr_type == AstType.LiteralInt do
		var (b2, v) = builder_new_vreg(b)
		ins = mir_instr_new(MirOp.Move, mir_opnd_vreg(v), mir_opnd_imm(ast_node_int_val(expr)), mir_opnd_none())
		b2 = builder_add_instr(b2, ins)
		out (b2, mir_opnd_vreg(v))
	end

    # 2. Literal Float (raw 64-bit IEEE 754 bits from offset 48)
	if expr_type == AstType.LiteralFloat do
		var (b2, v) = builder_new_vreg(b)
		f_bits = native_read_i64(expr as i64, 48)
		ins = mir_instr_new(MirOp.Move, mir_opnd_vreg(v), mir_opnd_imm(f_bits), mir_opnd_none())
		mir_instr_set_type(ins, MirType.F64 as i64)
		b2 = builder_add_instr(b2, ins)
		out (b2, mir_opnd_vreg(v))
	end

    # 2b. Literal Bool
	if expr_type == AstType.LiteralBool do
		var (b2, v) = builder_new_vreg(b)
		ins = mir_instr_new(MirOp.Move, mir_opnd_vreg(v), mir_opnd_imm(ast_node_int_val(expr)), mir_opnd_none())
		b2 = builder_add_instr(b2, ins)
		out (b2, mir_opnd_vreg(v))
	end

    # 2c. Literal None
	if expr_type == AstType.LiteralNone do
		var (b2, v) = builder_new_vreg(b)
		ins = mir_instr_new(MirOp.Move, mir_opnd_vreg(v), mir_opnd_imm(0), mir_opnd_none())
		b2 = builder_add_instr(b2, ins)
		out (b2, mir_opnd_vreg(v))
	end

    # 3. Literal Str — src1 = string-pool id (100% static, zero runtime alloc)
	if expr_type == AstType.LiteralStr do
		var (b1, sid) = builder_intern(b, ast_node_name(expr))
		var (b2, v) = builder_new_vreg(b1)
		b2 = emit_intrinsic(b2, MIR_INTR_STR_LIT, mir_opnd_vreg(v), mir_opnd_imm(sid))
		out (b2, mir_opnd_vreg(v))
	end

    # 3b. InterpExpr — lowered to str_cat (bid 11) and int_to_str (bid 19) in Arena
	if expr_type == AstType.InterpExpr do
		n_segs = ast_node_child_count(expr)
		if n_segs == 0 do
			var (b1, sid) = builder_intern(b, fat_str_new(""))
			var (b2, v) = builder_new_vreg(b1)
			b2 = emit_intrinsic(b2, MIR_INTR_STR_LIT, mir_opnd_vreg(v), mir_opnd_imm(sid))
			out (b2, mir_opnd_vreg(v))
		end

		# Lower first segment and convert non-string values deterministically.
		first_child = ast_node_child(expr, 0)
		var (b_cur, cur_opnd) = lower_interp_segment(b, first_child)

		# If only 1 segment and already evaluated:
		if n_segs == 1 do
			out (b_cur, cur_opnd)
		end

		# Concatenate subsequent segments using str_cat (bid 11)
		var si = 1
		when si < n_segs loop
			seg_child = ast_node_child(expr, si)
			var (b_seg, seg_opnd) = lower_interp_segment(b_cur, seg_child)
			b_cur = b_seg

			# Call str_cat(cur_opnd, seg_opnd) (bid 11)
			b_cur = emit_set_arg(b_cur, 0, cur_opnd)
			b_cur = emit_set_arg(b_cur, 1, seg_opnd)
			var (b_cat, res_v) = builder_new_vreg(b_cur)
			b_cur = emit_intrinsic(b_cat, MIR_INTR_BUILTIN, mir_opnd_vreg(res_v), mir_opnd_imm(11))
			cur_opnd = mir_opnd_vreg(res_v)
			si = si + 1
		end
		out (b_cur, cur_opnd)
	end

    # 4. Identifier
	if expr_type == AstType.Identifier do
		fname = ast_node_name(expr)
		v = get_var_vreg(b, fname)
		if v >= 0 do
			out (b, mir_opnd_vreg(v))
		else
            if fat_cstr_eq(fname, "true") == 1 do
                out (b, mir_opnd_imm(1))
            end
            if fat_cstr_eq(fname, "false") == 1 do
                out (b, mir_opnd_imm(0))
            end
            if fat_cstr_eq(fname, "null") == 1 do
                out (b, mir_opnd_imm(0))
            end
            if g_const_hash > 0 do
                c_idx = hash_table_lookup(g_const_hash, g_const_names, fname)
                if c_idx >= 0 do
                    c_val = vec_get_rt(g_const_values, c_idx)
                    out (b, mir_opnd_imm(c_val))
                end
            end
			global_slot = global_slot_lookup(fname)
			if global_slot >= 0 do
				var (b_global, global_vreg) = builder_new_vreg(b)
				b_global = emit_intrinsic(b_global, MIR_INTR_GLOBAL_LOAD, mir_opnd_vreg(global_vreg), mir_opnd_imm(global_slot))
				out (b_global, mir_opnd_vreg(global_vreg))
			end
			var (b1, cid) = builder_intern(b, fname)
			var (b2, dst) = builder_new_vreg(b1)
			b2 = emit_intrinsic(b2, MIR_INTR_ADDR_OF, mir_opnd_vreg(dst), mir_opnd_imm(cid))
			out (b2, mir_opnd_vreg(dst))
		end
	end

    # 5. BinOp & Compare — full OpType→MirOp; Land/Lor → CFG (no silent Add)
	if expr_type == AstType.BinOp or expr_type == AstType.Compare do
		child_count = ast_node_child_count(expr)
		if child_count >= 2 do
			left = ast_node_child(expr, 0)
			right = ast_node_child(expr, 1)
			mop_i = mir_op_from_optype(ast_node_op_of(expr))

            # Land: if !lhs → 0 else rhs
			if mop_i == -2 do
				var (b1, opnd_l) = lower_expr(b, left)
				var (b2, dst) = builder_new_vreg(b1)
				var (b3, rhs_id) = builder_add_block(b2)
				var (b4, end_id) = builder_add_block(b3)
				b4 = emit_move(b4, dst, mir_opnd_imm(0))
				b4 = emit_jump_if_not(b4, opnd_l, end_id, rhs_id)
				b4 = builder_set_current_block(b4, rhs_id)
				var (b5, opnd_r) = lower_expr(b4, right)
				b5 = emit_move(b5, dst, opnd_r)
				b5 = emit_jump(b5, end_id)
				b5 = builder_set_current_block(b5, end_id)
				out (b5, mir_opnd_vreg(dst))
			end

            # Lor: if lhs → 1 else rhs
			if mop_i == -3 do
				var (b1, opnd_l) = lower_expr(b, left)
				var (b2, dst) = builder_new_vreg(b1)
				var (b3, rhs_id) = builder_add_block(b2)
				var (b4, end_id) = builder_add_block(b3)
				b4 = emit_move(b4, dst, mir_opnd_imm(1))
				b4 = emit_jump_if(b4, opnd_l, end_id, rhs_id)
				b4 = builder_set_current_block(b4, rhs_id)
				var (b5, opnd_r) = lower_expr(b4, right)
				b5 = emit_move(b5, dst, opnd_r)
				b5 = emit_jump(b5, end_id)
				b5 = builder_set_current_block(b5, end_id)
				out (b5, mir_opnd_vreg(dst))
			end

            # PatternOp `:~` → MIR_INTR_PATTERN
			if mop_i == -4 do
				var (b3, opnd_l) = lower_expr(b, left)
				var (b4, opnd_r) = lower_expr(b3, right)
				var (b5, dst) = builder_new_vreg(b4)
				b5 = emit_set_arg(b5, 0, opnd_l)
				b5 = emit_set_arg(b5, 1, opnd_r)
				out (emit_intrinsic(b5, MIR_INTR_PATTERN, mir_opnd_vreg(dst), opnd_l), mir_opnd_vreg(dst))
			end

			if mop_i < 0 do
                # Unknown OpType — emit Nop marker, return 0 (never default Add)
				var (b1, dst) = builder_new_vreg(b)
				b1 = emit_intrinsic(b1, MIR_INTR_NOP_MARKER, mir_opnd_vreg(dst), mir_opnd_imm(ast_node_op_of(expr) as i64))
				out (b1, mir_opnd_vreg(dst))
			end

			var (b3, opnd_l) = lower_expr(b, left)
			var (b4, opnd_r) = lower_expr(b3, right)
			var (b5, dst) = builder_new_vreg(b4)
			var m_op = MirOp.Add
			if mop_i == 5 do m_op = MirOp.Sub end
			if mop_i == 6 do m_op = MirOp.Mul end
			if mop_i == 7 do m_op = MirOp.Div end
			if mop_i == 19 do m_op = MirOp.Mod end
			if mop_i == 13 do m_op = MirOp.CmpEq end
			if mop_i == 14 do m_op = MirOp.CmpNe end
			if mop_i == 15 do m_op = MirOp.CmpGt end
			if mop_i == 16 do m_op = MirOp.CmpLt end
			if mop_i == 17 do m_op = MirOp.CmpGe end
			if mop_i == 18 do m_op = MirOp.CmpLe end
			if mop_i == 22 do m_op = MirOp.And end
			if mop_i == 23 do m_op = MirOp.Or end
			if mop_i == 24 do m_op = MirOp.Xor end
			if mop_i == 25 do m_op = MirOp.Shl end
			if mop_i == 26 do m_op = MirOp.Shr end
			if mop_i == 28 do m_op = MirOp.Pow end
			if mop_i == 29 do m_op = MirOp.MatMul end
			if mop_i == 30 do m_op = MirOp.Fma end
			if mop_i == 4 do m_op = MirOp.Add end
			ins = mir_instr_new(m_op, mir_opnd_vreg(dst), opnd_l, opnd_r)
			var bin_lt = infer_expr_type_name(left)
			var bin_rt = infer_expr_type_name(right)
			if fat_cstr_eq(bin_lt, "float") == 1 or fat_cstr_eq(bin_rt, "float") == 1 do
				mir_instr_set_type(ins, MirType.F64 as i64)
			end
			if mop_i == 29 or mop_i == 30 do
				# Semantic pass 6 guarantees known rank-2 operands.  Zero is an
				# invalid sentinel, never a guessed 2x2 shape.
				var dim_m = 0
				var dim_k = 0
				var dim_n = 0
				var left_t = ""
				var right_t = ""
				if ast_node_type_of(left) == AstType.Identifier do
					left_t = get_var_type(ast_node_name(left))
				end
				if ast_node_type_of(right) == AstType.Identifier do
					right_t = get_var_type(ast_node_name(right))
				end
				if is_tensor_type_str(left_t) and is_tensor_type_str(right_t) do
					shape_a = parse_tensor_shape(left_t)
					shape_b = parse_tensor_shape(right_t)
					if vec_len_rt(shape_a) >= 2 and vec_len_rt(shape_b) >= 2 do
						dim_m = vec_get_rt(shape_a, 0) as int
						dim_k = vec_get_rt(shape_a, 1) as int
						dim_n = vec_get_rt(shape_b, 1) as int
					end
				end
				var is_32bit = 0
				var is_float = 0
				let elem_sz = tensor_elem_byte_size(left_t)
				if elem_sz == 4 do
					is_32bit = 1
				end
				var pt_len = fat_str_len(left_t)
				var ci = 0
				when ci < pt_len loop
					let cc = fat_str_byte_at(left_t, ci)
					if cc == 102 or cc == 70 do is_float = 1 end
					ci = ci + 1
				end
				let t_code = parse_tensor_elem_code(left_t)
				if t_code == 7 do is_float = 1 end
				let aux_val = (is_32bit shl 49) + (is_float shl 48) + (dim_m shl 32) + (dim_k shl 16) + dim_n
				mir_instr_set_aux(ins, aux_val)
				if is_float == 1 do
					mir_instr_set_type(ins, MirType.F32 as i64)
					mir_instr_set_type(ins, MirType.F64 as i64)
				eif is_32bit == 1 do
					mir_instr_set_type(ins, MirType.Int32 as i64)
				else
					mir_instr_set_type(ins, MirType.Int64 as i64)
				end
			end
			b5 = builder_add_instr(b5, ins)
			out (b5, mir_opnd_vreg(dst))
		end
	end

    # 5b. UnaryNot → MirOp.Not
	if expr_type == AstType.UnaryNot do
		if ast_node_child_count(expr) > 0 do
			var (b2, opnd) = lower_expr(b, ast_node_child(expr, 0))
			var (b3, dst) = builder_new_vreg(b2)
			ins = mir_instr_new(MirOp.Not, mir_opnd_vreg(dst), opnd, mir_opnd_none())
			b3 = builder_add_instr(b3, ins)
			out (b3, mir_opnd_vreg(dst))
		end
	end

    # 5c. Swizzle / SafeAccess
	if expr_type == AstType.SwizzleExpr do
		var (b1, mid) = builder_intern(b, ast_node_name(expr))
		if ast_node_child_count(expr) > 0 do
			var (b2, base) = lower_expr(b1, ast_node_child(expr, 0))
			var (b3, dst) = builder_new_vreg(b2)
			b3 = emit_set_arg(b3, 0, base)
			b3 = emit_set_arg(b3, 1, mir_opnd_imm(mid))
			out (emit_intrinsic(b3, MIR_INTR_SWIZZLE, mir_opnd_vreg(dst), mir_opnd_imm(mid)), mir_opnd_vreg(dst))
		end
	end
	if expr_type == AstType.SafeAccessExpr do
		var (b1, fid) = builder_intern(b, ast_node_name(expr))
		if ast_node_child_count(expr) > 0 do
			var (b2, base) = lower_expr(b1, ast_node_child(expr, 0))
			var (b3, dst) = builder_new_vreg(b2)
			b3 = emit_set_arg(b3, 0, base)
			b3 = emit_set_arg(b3, 1, mir_opnd_imm(fid))
			out (emit_intrinsic(b3, MIR_INTR_SAFE_ACCESS, mir_opnd_vreg(dst), mir_opnd_imm(fid)), mir_opnd_vreg(dst))
		end
	end

    # 5d. Erx / Task / Wait / Quantize
	if expr_type == AstType.ErxExpr do
		var (b1, dst) = builder_new_vreg(b)
		out (emit_intrinsic(b1, MIR_INTR_ERX, mir_opnd_vreg(dst), mir_opnd_none()), mir_opnd_vreg(dst))
	end
	if expr_type == AstType.TaskExpr do
		if ast_node_child_count(expr) > 0 do
			var (b2, v) = lower_expr(b, ast_node_child(expr, 0))
			var (b3, dst) = builder_new_vreg(b2)
			out (emit_intrinsic(b3, MIR_INTR_TASK, mir_opnd_vreg(dst), v), mir_opnd_vreg(dst))
		end
	end
	if expr_type == AstType.WaitExpr do
		if ast_node_child_count(expr) > 0 do
			var (b2, v) = lower_expr(b, ast_node_child(expr, 0))
			var (b3, dst) = builder_new_vreg(b2)
			out (emit_intrinsic(b3, MIR_INTR_WAIT, mir_opnd_vreg(dst), v), mir_opnd_vreg(dst))
		end
	end
	if expr_type == AstType.QuantizeExpr do
		if ast_node_child_count(expr) > 0 do
			var (b2, v) = lower_expr(b, ast_node_child(expr, 0))
			var q_bits: i64 = 8
			if ast_node_child_count(expr) > 1 do
				let b_node = ast_node_child(expr, 1)
				if ast_node_type_of(b_node) == AstType.LiteralInt do
					q_bits = ast_node_int_val(b_node)
				end
			end
			b2 = emit_set_arg(b2, 0, mir_opnd_imm(q_bits))
			var (b3, dst) = builder_new_vreg(b2)
			out (emit_intrinsic(b3, MIR_INTR_QUANTIZE, mir_opnd_vreg(dst), v), mir_opnd_vreg(dst))
		end
	end

    # 6. Call — SetArg* then Call(dst, nargs); src2 = callee string-pool id
	if expr_type == AstType.Call do
		# Positional entity construction `Ent(v0, v1, ...)` parses as a Call
		# reclassify to an aggregate when the callee names an entity type.
		callee = resolve_callee_alias(ast_node_name(expr))
		if is_entity_name(callee) == 1 do
			out lower_aggregate(b, MIR_INTR_ENTITY, expr)
		end
		# Parser lookup_builtin can miss (fat vs C-string table names) and
		# emit a Call instead of BuiltinCall. Reclassify by callee name.
		b_id = builtin_id_from_name(callee)
		if b_id > 0 do
			if b_id == 9 and ast_node_child_count(expr) >= 1 do
				arg0 = ast_node_child(expr, 0)
				if ast_node_type_of(arg0) == AstType.LiteralStr do
					slen = fat_str_len(ast_node_name(arg0))
					out (b, mir_opnd_imm(slen))
				end
			end
			var (b2, nargs) = lower_call_args(b, expr, 0, 0)
			var (b3, dst) = builder_new_vreg(b2)
			out (emit_intrinsic(b3, MIR_INTR_BUILTIN, mir_opnd_vreg(dst), mir_opnd_imm(b_id)), mir_opnd_vreg(dst))
		end
		# Dynamic / Indirect Call: if callee is a local variable in scope
		callee_vreg = get_var_vreg(b, callee)
		if callee_vreg >= 0 do
			var (b2, nargs) = lower_call_args(b, expr, 0, 0)
			var (b3, dst) = builder_new_vreg(b2)
			ins = mir_instr_new(MirOp.Call, mir_opnd_vreg(dst), mir_opnd_imm(nargs), mir_opnd_vreg(callee_vreg))
			b3 = builder_add_instr(b3, ins)
			out (b3, mir_opnd_vreg(dst))
		end
		var (b1, cid) = builder_intern(b, callee)
		var (b2, nargs) = lower_call_args(b1, expr, 0, 0)
		var (b3, dst) = builder_new_vreg(b2)
		ins = mir_instr_new(MirOp.Call, mir_opnd_vreg(dst), mir_opnd_imm(nargs), mir_opnd_imm(cid))
		b3 = builder_add_instr(b3, ins)
		out (b3, mir_opnd_vreg(dst))
	end

    # 6b. BuiltinCall — port/lock/atomic map to MIR_INTR_*; else BUILTIN+Call
	if expr_type == AstType.BuiltinCall do
		if fat_cstr_eq(ast_node_name(expr), "__mir_send") or fat_cstr_eq(ast_node_name(expr), "port_send") do
			var (b2, nargs) = lower_call_args(b, expr, 0, 0)
			var (b3, dst) = builder_new_vreg(b2)
			out (emit_intrinsic(b3, MIR_INTR_SEND, mir_opnd_vreg(dst), mir_opnd_imm(nargs)), mir_opnd_vreg(dst))
		end
		if fat_cstr_eq(ast_node_name(expr), "__mir_recv") or fat_cstr_eq(ast_node_name(expr), "port_recv") do
			var (b2, nargs) = lower_call_args(b, expr, 0, 0)
			var (b3, dst) = builder_new_vreg(b2)
			out (emit_intrinsic(b3, MIR_INTR_RECV, mir_opnd_vreg(dst), mir_opnd_imm(nargs)), mir_opnd_vreg(dst))
		end
		if fat_cstr_eq(ast_node_name(expr), "__mir_lock") or fat_cstr_eq(ast_node_name(expr), "atomic_bang") do
			var (b2, nargs) = lower_call_args(b, expr, 0, 0)
			var (b3, dst) = builder_new_vreg(b2)
			var kind = MIR_INTR_LOCK
			if fat_cstr_eq(ast_node_name(expr), "atomic_bang") do
				kind = MIR_INTR_ATOMIC
			end
			out (emit_intrinsic(b3, kind, mir_opnd_vreg(dst), mir_opnd_imm(nargs)), mir_opnd_vreg(dst))
		end
        bid = resolve_builtin_id(expr)
        if bid == 9 and ast_node_child_count(expr) >= 1 do
            arg0 = ast_node_child(expr, 0)
            if ast_node_type_of(arg0) == AstType.LiteralStr do
                slen = fat_str_len(ast_node_name(arg0))
                out (b, mir_opnd_imm(slen))
            end
        end
		var (b2, nargs) = lower_call_args(b, expr, 0, 0)
		var (b3, dst) = builder_new_vreg(b2)
		out (emit_intrinsic(b3, MIR_INTR_BUILTIN, mir_opnd_vreg(dst), mir_opnd_imm(bid)), mir_opnd_vreg(dst))
	end

    # 6c. MethodCall — semantic resolution order:
    # entity method -> callable field -> free-function UFCS.
	if expr_type == AstType.MethodCall do
		mname = ast_node_name(expr)
		if fat_cstr_eq(mname, "backward") == 1 do
			recv = ast_node_child(expr, 0)
			var (b2, rop) = lower_expr(b, recv)
			var (b3, dst) = builder_new_vreg(b2)
			out (emit_intrinsic(b3, MIR_INTR_BACKWARD, mir_opnd_vreg(dst), rop), mir_opnd_vreg(dst))
		end
		nch = ast_node_child_count(expr)
		if nch <= 0 do
			print_ln("virc: error: UFCS call without receiver")
			sys_exit(1)
			out (b, mir_opnd_imm(0))
		end
		recv = ast_node_child(expr, 0)
		recv_type = get_expr_entity_type(recv)
		callee_kind = ast_node_builtin_id(expr)
		resolved_name = ast_node_name2(expr)
		if callee_kind == 0 and fat_str_len(recv_type) > 0 do
			method_key = get_scoped_method_name(recv_type, mname)
			if fat_str_len(method_key) > 0 do
				callee_kind = 201
				resolved_name = method_key
			eif scoped_field_is_callable(recv_type, mname) == 1 do
				callee_kind = 202
			end
		end
		if callee_kind == 202 do
			# Callable fields are ordinary function values. Evaluate receiver once,
			# load the field, and pass only explicit arguments.
			if fat_str_len(recv_type) == 0 and fat_str_len(resolved_name) > 0 do
				recv_type = resolved_name
			end
			var (b2, rop) = lower_expr(b, recv)
			fid = get_scoped_field_index(recv_type, mname)
			if fid < 0 do
				print_ln("virc: error: unresolved callable UFCS field")
				sys_exit(1)
				out (b2, mir_opnd_imm(0))
			end
			var (b3, addr) = builder_new_vreg(b2)
			b3 = builder_add_instr(b3, mir_instr_new(MirOp.Add, mir_opnd_vreg(addr), rop, mir_opnd_imm(fid * 8)))
			var (b4, fn_vreg) = builder_new_vreg(b3)
			b4 = emit_load(b4, fn_vreg, mir_opnd_vreg(addr))
			var (b5, nargs) = lower_call_args(b4, expr, 1, 0)
			var (b6, dst) = builder_new_vreg(b5)
			b6 = builder_add_instr(b6, mir_instr_new(MirOp.Call, mir_opnd_vreg(dst), mir_opnd_imm(nargs), mir_opnd_vreg(fn_vreg)))
			out (b6, mir_opnd_vreg(dst))
		end
		if callee_kind != 201 or fat_str_len(resolved_name) == 0 do
			resolved_name = mname
		end
		var (b0, mid) = builder_intern(b, resolved_name)
		var (b2, rop) = lower_expr(b0, recv)
		b_mut = emit_set_arg(b2, 0, rop)
		var (b3, rest) = lower_call_args(b_mut, expr, 1, 1)
		var nargs = 1 + rest
		var (b4, dst) = builder_new_vreg(b3)
		b4 = builder_add_instr(b4, mir_instr_new(MirOp.Call, mir_opnd_vreg(dst), mir_opnd_imm(nargs), mir_opnd_imm(mid)))
		out (b4, mir_opnd_vreg(dst))
	end

    # 5e. PatternExpr / ExistExpr / Map / ArrCompact / Bundle / Error / Ptr
	if expr_type == AstType.PatternExpr do
		if ast_node_child_count(expr) >= 2 do
			var (b3, opnd_l) = lower_expr(b, ast_node_child(expr, 0))
			var (b4, opnd_r) = lower_expr(b3, ast_node_child(expr, 1))
			var (b5, dst) = builder_new_vreg(b4)
			b5 = emit_set_arg(b5, 0, opnd_l)
			b5 = emit_set_arg(b5, 1, opnd_r)
			out (emit_intrinsic(b5, MIR_INTR_PATTERN, mir_opnd_vreg(dst), opnd_l), mir_opnd_vreg(dst))
		end
	end
	if expr_type == AstType.ExistExpr do
		if ast_node_child_count(expr) > 0 do
			var (b2, v) = lower_expr(b, ast_node_child(expr, 0))
			var (b3, dst) = builder_new_vreg(b2)
			out (emit_intrinsic(b3, MIR_INTR_EXIST, mir_opnd_vreg(dst), v), mir_opnd_vreg(dst))
		end
	end
	if expr_type == AstType.MapExpr do
		var (b2, nargs) = lower_call_args(b, expr, 0, 0)
		var (b3, dst) = builder_new_vreg(b2)
		out (emit_intrinsic(b3, MIR_INTR_MAP, mir_opnd_vreg(dst), mir_opnd_imm(nargs)), mir_opnd_vreg(dst))
	end
	if expr_type == AstType.ArrCompactExpr do
		var (b2, nargs) = lower_call_args(b, expr, 0, 0)
		var (b3, dst) = builder_new_vreg(b2)
		out (emit_intrinsic(b3, MIR_INTR_ARR_COMPACT, mir_opnd_vreg(dst), mir_opnd_imm(nargs)), mir_opnd_vreg(dst))
	end
	if expr_type == AstType.BundleExpr do
		child_count = ast_node_child_count(expr)
		if child_count > 0 do
			c0 = ast_node_child(expr, 0)
			if ast_node_type_of(c0) == AstType.LiteralStr do
				var (b1, sid) = builder_intern(b, ast_node_name(c0))
				var (b2, dst) = builder_new_vreg(b1)
				out (emit_intrinsic(b2, MIR_INTR_STR_LIT, mir_opnd_vreg(dst), mir_opnd_imm(sid)), mir_opnd_vreg(dst))
			end
		end
		var (b2, nargs) = lower_call_args(b, expr, 0, 0)
		var (b3, dst) = builder_new_vreg(b2)
		out (emit_intrinsic(b3, MIR_INTR_BUNDLE, mir_opnd_vreg(dst), mir_opnd_imm(nargs)), mir_opnd_vreg(dst))
	end
	if expr_type == AstType.ErrorExpr do
		var (b1, dst) = builder_new_vreg(b)
		out (emit_intrinsic(b1, MIR_INTR_ERROR, mir_opnd_vreg(dst), mir_opnd_none()), mir_opnd_vreg(dst))
	end
	if expr_type == AstType.PtrTypeExpr do
        fname = ast_node_name(expr)
        v = get_var_vreg(b, fname)
        if v >= 0 do
            out (b, mir_opnd_vreg(v))
        end
		var (b1, pid) = builder_intern(b, fname)
		var (b2, dst) = builder_new_vreg(b1)
		out (emit_intrinsic(b2, MIR_INTR_PTR, mir_opnd_vreg(dst), mir_opnd_imm(pid)), mir_opnd_vreg(dst))
	end
	if expr_type == AstType.PercentExpr do
		if ast_node_child_count(expr) > 0 do
			child = ast_node_child(expr, 0)
			var (b2, child_opnd) = lower_expr(b, child)
			var (b3, dst) = builder_new_vreg(b2)
			var ct = infer_expr_type_name(child)
			var m_type = MirType.Int64 as i64
			if fat_cstr_eq(ct, "float") == 1 or ast_node_type_of(child) == AstType.LiteralFloat do
				m_type = MirType.F64 as i64
			end
			out (emit_intrinsic_typed(b3, MIR_INTR_PERCENT, mir_opnd_vreg(dst), child_opnd, m_type), mir_opnd_vreg(dst))
		end
	end

    # 7. UnaryMinus
	if expr_type == AstType.UnaryMinus do
		child_count = ast_node_child_count(expr)
		if child_count > 0 do
			child = ast_node_child(expr, 0)
			var (b2, child_opnd) = lower_expr(b, child)
			var (b3, dst) = builder_new_vreg(b2)
			ins = mir_instr_new(MirOp.Sub, mir_opnd_vreg(dst), mir_opnd_imm(0), child_opnd)
			b3 = builder_add_instr(b3, ins)
			out (b3, mir_opnd_vreg(dst))
		end
	end

    # 7b. AddrOf — shared (&) / mut (&mut); SetArg0 = mut flag
	if expr_type == AstType.AddrOf do
		child_count = ast_node_child_count(expr)
		if child_count > 0 do
			child = ast_node_child(expr, 0)
			var (b2, child_opnd) = lower_expr(b, child)
			var (b3, dst) = builder_new_vreg(b2)
			mutf = 0
			if fat_cstr_eq(ast_node_name(expr), "mut") do
				mutf = 1
			end
			b3 = emit_set_arg(b3, 0, mir_opnd_imm(mutf))
			b3 = emit_intrinsic(b3, MIR_INTR_ADDR_OF, mir_opnd_vreg(dst), child_opnd)
			out (b3, mir_opnd_vreg(dst))
		end
	end

	if expr_type == AstType.PrecompBlock do
		if ast_node_child_count(expr) > 0 do
			out lower_expr(b, ast_node_child(expr, 0))
		end
		out (b, mir_opnd_imm(0))
	end

    # 8. Aggregate literals — SetArg each element then Intrinsic
	if expr_type == AstType.ArrayLiteral do
		out lower_aggregate(b, MIR_INTR_ARRAY, expr)
	end
	if expr_type == AstType.DictLiteral do
		out lower_aggregate(b, MIR_INTR_ARRAY, expr)
	end
	if expr_type == AstType.TupleExpr do
		out lower_aggregate(b, MIR_INTR_TUPLE, expr)
	end
	if expr_type == AstType.EntityLiteral do
		out lower_aggregate(b, MIR_INTR_ENTITY, expr)
	end
	if expr_type == AstType.SizeofExpr do
		sz = get_type_byte_size(ast_node_name(expr))
		out (b, mir_opnd_imm(sz))
	end

    # 9. Index — shapes: children[base,idx] OR name=base + children[idx]
	if expr_type == AstType.IndexAccess or expr_type == AstType.ExprIndex do
		if fat_cstr_eq(ast_node_name2(expr), "__slice__") == 1 do
			bv = get_var_vreg(b, ast_node_name(expr))
			var (b2, start_op) = lower_expr(b, ast_node_child(expr, 0))
			var (b3, end_op) = lower_expr(b2, ast_node_child(expr, 1))
			var (b4, slen_vreg) = builder_new_vreg(b3)
			ins_sub = mir_instr_new(MirOp.Sub, mir_opnd_vreg(slen_vreg), end_op, start_op)
			b4 = builder_add_instr(b4, ins_sub)

			var (b5, tmp8) = builder_new_vreg(b4)
			ins_mul = mir_instr_new(MirOp.Mul, mir_opnd_vreg(tmp8), mir_opnd_vreg(slen_vreg), mir_opnd_imm(8))
			b5 = builder_add_instr(b5, ins_mul)
			var (b6, alloc_sz) = builder_new_vreg(b5)
			ins_add = mir_instr_new(MirOp.Add, mir_opnd_vreg(alloc_sz), mir_opnd_vreg(tmp8), mir_opnd_imm(16))
			b6 = builder_add_instr(b6, ins_add)

			b6 = emit_set_arg(b6, 0, mir_opnd_vreg(alloc_sz))
			var (b7, dst_base) = builder_new_vreg(b6)
			b7 = emit_intrinsic(b7, MIR_INTR_BUILTIN, mir_opnd_vreg(dst_base), mir_opnd_imm(3))

			b7 = emit_set_arg(b7, 0, mir_opnd_vreg(dst_base))
			b7 = emit_set_arg(b7, 1, mir_opnd_imm(0))
			b7 = emit_set_arg(b7, 2, mir_opnd_vreg(slen_vreg))
			b7 = emit_intrinsic(b7, MIR_INTR_BUILTIN, mir_opnd_none(), mir_opnd_imm(8))

			b7 = emit_set_arg(b7, 0, mir_opnd_vreg(dst_base))
			b7 = emit_set_arg(b7, 1, mir_opnd_imm(8))
			b7 = emit_set_arg(b7, 2, mir_opnd_vreg(slen_vreg))
			b7 = emit_intrinsic(b7, MIR_INTR_BUILTIN, mir_opnd_none(), mir_opnd_imm(8))

			var (b8, iv) = builder_new_vreg(b7)
			ins0 = mir_instr_new(MirOp.Move, mir_opnd_vreg(iv), mir_opnd_imm(0), mir_opnd_none())
			b8 = builder_add_instr(b8, ins0)
			loop_var_name = fat_str_concat(fat_str_new("__slice_i_"), ast_node_name(expr))
			b8 = set_var_vreg(b8, loop_var_name, iv)

			var (b9, cond_id) = builder_add_block(b8)
			var (b10, body_id) = builder_add_block(b9)
			var (b11, step_id) = builder_add_block(b10)
			var (b12, end_id) = builder_add_block(b11)

			b12 = emit_jump(b12, cond_id)
			b12 = builder_push_loop(b12, end_id, step_id)
			b12 = builder_set_current_block(b12, cond_id)

			iv_cur = get_var_vreg(b12, loop_var_name)
			var (b13, cmpv) = builder_new_vreg(b12)
			insc = mir_instr_new(MirOp.CmpLt, mir_opnd_vreg(cmpv), mir_opnd_vreg(iv_cur), mir_opnd_vreg(slen_vreg))
			b13 = builder_add_instr(b13, insc)
			b13 = emit_jump_if_not(b13, mir_opnd_vreg(cmpv), end_id, body_id)

			b13 = builder_set_current_block(b13, body_id)
			var (b14, src_idx) = builder_new_vreg(b13)
			ins_src = mir_instr_new(MirOp.Add, mir_opnd_vreg(src_idx), start_op, mir_opnd_vreg(iv_cur))
			b14 = builder_add_instr(b14, ins_src)

			var (b15, elem_val) = builder_new_vreg(b14)
			b15 = emit_set_arg(b15, 0, mir_opnd_vreg(src_idx))
			b15 = emit_intrinsic(b15, MIR_INTR_INDEX, mir_opnd_vreg(elem_val), mir_opnd_vreg(bv))

			b15 = emit_set_arg(b15, 0, mir_opnd_vreg(iv_cur))
			b15 = emit_set_arg(b15, 1, mir_opnd_vreg(elem_val))
			b15 = emit_intrinsic(b15, MIR_INTR_INDEX_STORE, mir_opnd_none(), mir_opnd_vreg(dst_base))

			b15 = emit_jump(b15, step_id)
			b15 = builder_set_current_block(b15, step_id)
			iv_cur2 = get_var_vreg(b15, loop_var_name)
			var (b16, ivn) = builder_new_vreg(b15)
			ins_add1 = mir_instr_new(MirOp.Add, mir_opnd_vreg(ivn), mir_opnd_vreg(iv_cur2), mir_opnd_imm(1))
			b16 = builder_add_instr(b16, ins_add1)
			ins_mov1 = mir_instr_new(MirOp.Move, mir_opnd_vreg(iv_cur2), mir_opnd_vreg(ivn), mir_opnd_none())
			b16 = builder_add_instr(b16, ins_mov1)
			b16 = set_var_vreg(b16, loop_var_name, iv_cur2)
			b16 = emit_jump(b16, cond_id)
			b16 = builder_pop_loop(b16)
			b16 = builder_set_current_block(b16, end_id)

			out (b16, mir_opnd_vreg(dst_base))
		end
	nch = ast_node_child_count(expr)
	b_mut = b
	base = mir_opnd_none()
	var vtype = ""
	var start_idx = 0
	var num_idx = 0
	if expr_type == AstType.IndexAccess do
		base_name = ast_node_name(expr)
		bv = get_var_vreg(b_mut, base_name)
		if bv >= 0 do
			base = mir_opnd_vreg(bv)
		end
		vtype = get_var_type(base_name)
		start_idx = 0
		num_idx = nch
	else
		var (b_base, base_op) = lower_expr(b_mut, ast_node_child(expr, 0))
		b_mut = b_base
		base = base_op
		start_idx = 1
		num_idx = nch - 1
	end

	flat_opnd = mir_opnd_none()
	if num_idx <= 1 do
		if num_idx == 1 do
			var (b_idx, idx_op) = lower_expr(b_mut, ast_node_child(expr, start_idx))
			b_mut = b_idx
			flat_opnd = idx_op
		else
			flat_opnd = mir_opnd_imm(0)
		end
	else
		var k = 0
		when k < num_idx loop
			idx_ast = ast_node_child(expr, start_idx + k)
			var (b_next, idx_op) = lower_expr(b_mut, idx_ast)
			b_mut = b_next
			stride = 1
			if is_tensor_type_str(vtype) do
				stride = parse_tensor_stride(vtype, k)
			end
			term_op = idx_op
			if stride > 1 do
				var (b_mul, mul_v) = builder_new_vreg(b_mut)
				ins_m = mir_instr_new(MirOp.Mul, mir_opnd_vreg(mul_v), idx_op, mir_opnd_imm(stride))
				b_mut = builder_add_instr(b_mul, ins_m)
				term_op = mir_opnd_vreg(mul_v)
			end
			if k == 0 do
				flat_opnd = term_op
			else
				var (b_add, add_v) = builder_new_vreg(b_mut)
				ins_a = mir_instr_new(MirOp.Add, mir_opnd_vreg(add_v), flat_opnd, term_op)
				b_mut = builder_add_instr(b_add, ins_a)
				flat_opnd = mir_opnd_vreg(add_v)
			end
			k = k + 1
		end
	end

	if base.op_type != MirOperandType.None do
		var (b4, dst) = builder_new_vreg(b_mut)
		b4 = emit_set_arg(b4, 0, flat_opnd)
		var elem_m_typ = MirType.Int64
		if is_tensor_type_str(vtype) do
			let code = parse_tensor_elem_code(vtype)
			if code == 1 do elem_m_typ = MirType.F32 end
			if code == 2 do elem_m_typ = MirType.F16 end
			if code == 3 or code == 4 do elem_m_typ = MirType.Int8 end
			if code == 5 do elem_m_typ = MirType.Int32 end
		end
		b4 = emit_intrinsic_typed(b4, MIR_INTR_INDEX, mir_opnd_vreg(dst), base, elem_m_typ)
		out (b4, mir_opnd_vreg(dst))
	end
	end
	if expr_type == AstType.FieldAccess do
		nch = ast_node_child_count(expr)
		if nch >= 1 do
			base_ast = ast_node_child(expr, 0)
			if ast_node_type_of(base_ast) == AstType.Identifier do
				base_name_str = ast_node_name(base_ast)
				dot_str = fat_str_new(".")
				field_name_str = ast_node_name(expr)
				key = fat_str_concat(base_name_str, dot_str)
				key = fat_str_concat(key, field_name_str)
				if g_const_hash > 0 do
					c_idx = hash_table_lookup(g_const_hash, g_const_names, key)
					if c_idx >= 0 do
						c_val = vec_get_rt(g_const_values, c_idx)
						out (b, mir_opnd_imm(c_val))
					end
				end
				base_name = ast_node_name(base_ast)
				bv = get_var_vreg(b, base_name)
				gv = global_slot_lookup(base_name)
				if bv < 0 and gv < 0 do
					print_str("virc: error: unresolved symbol or enum: base=")
					print_str(native_read_i64(base_name, 0))
					print_str(" field=")
					print_ln(native_read_i64(field_name_str, 0))
					sys_exit(1)
					out (b, mir_opnd_imm(0))
				end
			end
			var (b2, base) = lower_expr(b, base_ast)
			fname = ast_node_name(expr)
			if is_register_field(fname) == 1 do
				start_bit = get_register_field_start(fname)
				width = get_register_field_width(fname)
				var (b3, dst) = builder_new_vreg(b2)
				let pack_info = MIR_INTR_BIT_EXTRACT or (start_bit shl 8) or (width shl 16)
				ins = mir_instr_new(MirOp.Intrinsic, mir_opnd_vreg(dst), base, mir_opnd_imm(pack_info))
				b3 = builder_add_instr(b3, ins)
				out (b3, mir_opnd_vreg(dst))
			end
			var (b3, dst) = builder_new_vreg(b2)
			base_type = get_expr_entity_type(base_ast)
			if is_packed_entity(base_type) do
				f_off = get_scoped_field_offset(base_type, fname)
				f_sz = get_scoped_field_size(base_type, fname)
				f_sgn = get_scoped_field_signed(base_type, fname)
				f_nested = get_scoped_field_is_nested(base_type, fname)
				var (b4, addr) = builder_new_vreg(b3)
				ins_a = mir_instr_new(MirOp.Add, mir_opnd_vreg(addr), base, mir_opnd_imm(f_off))
				b4 = builder_add_instr(b4, ins_a)
				if f_nested == 1 do
					out (b4, mir_opnd_vreg(addr))
				else
					b4 = emit_load_typed(b4, dst, mir_opnd_vreg(addr), f_sz, f_sgn)
					out (b4, mir_opnd_vreg(dst))
				end
			end
			var fid = 0 - 1
			if fat_str_len(base_type) > 0 do
				fid = get_scoped_field_index(base_type, fname)
			end
			if fid < 0 do
				if fat_cstr_eq(fname, "grad") == 1 do
					fid = 1
				else
					base_name = ast_node_name(base_ast)
					fid = find_field_index_for_base(base_name, fname)
				end
			end
			var (b4, addr) = builder_new_vreg(b3)
			ins_a = mir_instr_new(MirOp.Add, mir_opnd_vreg(addr), base, mir_opnd_imm(fid * 8))
			b4 = builder_add_instr(b4, ins_a)
			b4 = emit_load(b4, dst, mir_opnd_vreg(addr))
			out (b4, mir_opnd_vreg(dst))
		end
	end

    # 10. EnumAccess — name::name2
	if expr_type == AstType.EnumAccess do
		enum_name_str = ast_node_name(expr)
		dot_str = fat_str_new(".")
		variant_name_str = ast_node_name2(expr)
		key = fat_str_concat(enum_name_str, dot_str)
		key = fat_str_concat(key, variant_name_str)
		if g_const_hash > 0 do
			c_idx = hash_table_lookup(g_const_hash, g_const_names, key)
			if c_idx >= 0 do
				c_val = vec_get_rt(g_const_values, c_idx)
				out (b, mir_opnd_imm(c_val))
			end
		end
		print_str("virc: error: unresolved enum variant: enum=")
		print_str(native_read_i64(enum_name_str, 0))
		print_str(" variant=")
		print_ln(native_read_i64(variant_name_str, 0))
		sys_exit(1)
		out (b, mir_opnd_imm(0))
	end

    # 11. InputExpr
 if expr_type == AstType.InputExpr do
 var (b2, dst) = builder_new_vreg(b)
 b2 = emit_intrinsic(b2, MIR_INTR_INPUT, mir_opnd_vreg(dst), mir_opnd_none())
 out (b2, mir_opnd_vreg(dst))
 end

    # 12. CastExpr — identity Move (+ CAST marker for typed backends)
 if expr_type == AstType.CastExpr do
 nch = ast_node_child_count(expr)
 if nch > 0 do
 var (b2, child_opnd) = lower_expr(b, ast_node_child(expr, 0))
 var (b3, dst) = builder_new_vreg(b2)
 b3 = emit_move(b3, dst, child_opnd)
 b3 = emit_intrinsic(b3, MIR_INTR_CAST, mir_opnd_vreg(dst), mir_opnd_vreg(dst))
 out (b3, mir_opnd_vreg(dst))
 end
 end

    # 13. AwaitExpr — await expr | await pass
 if expr_type == AstType.AwaitExpr do
 if fat_cstr_eq(ast_node_name(expr), "pass") do
 var (b2, dst) = builder_new_vreg(b)
 b2 = emit_intrinsic(b2, MIR_INTR_AWAIT_PASS, mir_opnd_vreg(dst), mir_opnd_none())
 out (b2, mir_opnd_vreg(dst))
 end
 nch = ast_node_child_count(expr)
 if nch > 0 do
 var (b2, child_opnd) = lower_expr(b, ast_node_child(expr, 0))
 var (b3, dst) = builder_new_vreg(b2)
 b3 = emit_intrinsic(b3, MIR_INTR_AWAIT, mir_opnd_vreg(dst), child_opnd)
 out (b3, mir_opnd_vreg(dst))
 end
 end

    # 15. CheckCpu / PatchPoint
 if expr_type == AstType.CheckCpu do
 var (b2, dst) = builder_new_vreg(b)
 b2 = emit_intrinsic(b2, MIR_INTR_CHECK_CPU, mir_opnd_vreg(dst), mir_opnd_none())
 out (b2, mir_opnd_vreg(dst))
 end
	if expr_type == AstType.PatchPoint do
		var (b1, pid) = builder_intern(b, ast_node_name(expr))
		var (b2, dst) = builder_new_vreg(b1)
		b2 = emit_intrinsic(b2, MIR_INTR_PATCH_POINT, mir_opnd_vreg(dst), mir_opnd_imm(pid))
		out (b2, mir_opnd_vreg(dst))
	end

    # 14. NamedArg — children[0] is value (name on .name)
	if expr_type == AstType.NamedArg do
		nch = ast_node_child_count(expr)
		if nch > 0 do
			out lower_expr(b, ast_node_child(expr, 0))
		end
	end

	out (b, mir_opnd_none())
end.

func lower_expr(b: MirBuilder, expr: AstNode):
	out lower_expr_impl(b, expr)
end.

func lower_stmt_impl(b: MirBuilder, stmt: AstNode):
	stmt_type = ast_node_type_of(stmt)

    # 1. VarDecl & ConstDecl
	if stmt_type == AstType.VarDecl or stmt_type == AstType.ConstDecl do
		if ast_node_int_val(stmt) == 16384 do
			child_count = ast_node_child_count(stmt)
			if child_count > 1 do
				init_expr = ast_node_child(stmt, child_count - 1)
				var (b2, base_opnd) = lower_expr(b, init_expr)
				var b_curr = b2
				var i = 0
				when i < child_count - 1 loop
					var_ident = ast_node_child(stmt, i)
					var_name = ast_node_name(var_ident)
					# Tuples/entities are flat aggregates. MIR_INTR_INDEX is for Vec
					# storage and adds a 16-byte capacity/length header, so using it
					# here made `(a, b) = pair()` read beyond the returned object.
					var (b_addr, elem_addr) = builder_new_vreg(b_curr)
					b_addr = builder_add_instr(b_addr, mir_instr_new(MirOp.Add, mir_opnd_vreg(elem_addr), base_opnd, mir_opnd_imm(i * 8)))
					var (b_elem, dst_v) = builder_new_vreg(b_addr)
					b_elem = emit_load(b_elem, dst_v, mir_opnd_vreg(elem_addr))
					record_var_declaration(var_name)
					b_elem = set_var_vreg(b_elem, var_name, dst_v)
					b_curr = b_elem
					i = i + 1
				end
				out b_curr
			end
			out b
		end
		child_count = ast_node_child_count(stmt)
		if child_count > 0 do
			expr = ast_node_child(stmt, 0)
			var (b2, val_opnd) = lower_expr(b, expr)
			var (b3, v) = builder_new_vreg(b2)
			ins = mir_instr_new(MirOp.Move, mir_opnd_vreg(v), val_opnd, mir_opnd_none())
			b3 = builder_add_instr(b3, ins)
			record_var_declaration(ast_node_name(stmt))
			b3 = set_var_vreg(b3, ast_node_name(stmt), v)
			var var_t = ast_node_name2(stmt)
			if var_t != 0 and is_tensor_type_str(var_t) do
				if ast_node_type_of(expr) == AstType.ArrayLiteral and ast_node_child_count(expr) > 0 do
					let first_ch = ast_node_child(expr, 0)
					let first_nt = ast_node_type_of(first_ch)
					if first_nt == AstType.LiteralFloat or first_nt == AstType.LiteralInt do
						let shape_init = parse_tensor_shape(var_t)
						let rank_init = vec_len_rt(shape_init)
						if rank_init > 0 do
							var prefix = fat_str_new("tensor<int>[")
							if first_nt == AstType.LiteralFloat do
								prefix = fat_str_new("tensor<f64>[")
							end
							var new_vt = prefix
							var si = 0
							when si < rank_init loop
								if si > 0 do new_vt = fat_str_concat(new_vt, fat_str_new(",")) end
								let d_val = vec_get_rt(shape_init, si) as int
								new_vt = fat_str_concat(new_vt, fat_str_new(rt_itoa(d_val)))
								si = si + 1
							end
							new_vt = fat_str_concat(new_vt, fat_str_new("]"))
							var_t = new_vt
						end
					end
				end
			end
			if var_t == 0 or fat_str_len(var_t) == 0 do
				var expr_nt = ast_node_type_of(expr)
				var_t = infer_expr_type_name(expr)
				# Keep literal inference direct here: ConstDecl (`let`) nodes are
				# pre-indexed before lowering, and older bootstrap binaries can
				# otherwise retain their empty placeholder type.
				if expr_nt == AstType.LiteralInt do var_t = fat_str_new("int") end
				if expr_nt == AstType.LiteralFloat do var_t = fat_str_new("float") end
				if expr_nt == AstType.LiteralBool do var_t = fat_str_new("bool") end
				if expr_nt == AstType.LiteralNone do var_t = fat_str_new("none") end
				if expr_nt == AstType.LiteralStr or expr_nt == AstType.InterpExpr do var_t = fat_str_new("string") end
				if expr_nt == AstType.QuantizeExpr do var_t = fat_str_new("QuantizedTensor") end
				if expr_nt == AstType.EntityLiteral or expr_nt == AstType.Call do
					var cname = resolve_callee_alias(ast_node_name(expr))
					if is_entity_name(cname) == 1 do
						var_t = cname
					end
				end
				if expr_nt == AstType.BinOp and (ast_node_op_of(expr) == OpType.MatMulOp or ast_node_op_of(expr) == OpType.FmaOp) do
					left_n = ast_node_child(expr, 0)
					right_n = ast_node_child(expr, 1)
					left_t = get_var_type(ast_node_name(left_n))
					right_t = get_var_type(ast_node_name(right_n))
					if is_tensor_type_str(left_t) and is_tensor_type_str(right_t) do
						shape_a = parse_tensor_shape(left_t)
						shape_b = parse_tensor_shape(right_t)
						if vec_len_rt(shape_a) >= 2 and vec_len_rt(shape_b) >= 2 do
							dim_m = vec_get_rt(shape_a, 0) as i64
							dim_n = vec_get_rt(shape_b, 1) as i64
							# Determine element type prefix from left operand
							var elem_prefix = fat_str_new("tensor<int>")
							var pt_len = fat_str_len(left_t)
							var is_float_elem = false
							var ci2 = 0
							when ci2 < pt_len loop
								let cc = fat_str_byte_at(left_t, ci2)
								if cc == 102 or cc == 70 do is_float_elem = true end
								ci2 = ci2 + 1
							end
							if is_float_elem do
								elem_prefix = fat_str_new("tensor<f32>")
								if tensor_elem_byte_size(left_t) == 8 do
									elem_prefix = fat_str_new("tensor<f64>")
								else
									elem_prefix = fat_str_new("tensor<f32>")
								end
							end
							let l_code = parse_tensor_elem_code(left_t)
							if l_code == 1 do elem_prefix = fat_str_new("tensor<f32>") end
							if l_code == 2 do elem_prefix = fat_str_new("tensor<f16>") end
							if l_code == 3 do elem_prefix = fat_str_new("tensor<i8>") end
							if l_code == 4 do elem_prefix = fat_str_new("tensor<u8>") end
							if l_code == 5 do elem_prefix = fat_str_new("tensor<i32>") end
							if l_code == 6 do elem_prefix = fat_str_new("tensor<int>") end
							if l_code == 7 do elem_prefix = fat_str_new("tensor<f64>") end
							var_t = fat_str_concat(elem_prefix, fat_str_new("["))
							var_t = fat_str_concat(var_t, fat_str_new(rt_itoa(dim_m)))
							var_t = fat_str_concat(var_t, fat_str_new(","))
							var_t = fat_str_concat(var_t, fat_str_new(rt_itoa(dim_n)))
							var_t = fat_str_concat(var_t, fat_str_new("]"))
						end
					end
				end
			end
			# `let` is a ConstDecl and may carry an internal non-empty placeholder
			# in name2.  Literal inference must override that placeholder.
			if ast_node_type_of(stmt) == AstType.ConstDecl do
				expr_nt_const = ast_node_type_of(expr)
				if expr_nt_const == AstType.LiteralInt do var_t = fat_str_new("int"); set_var_type(ast_node_name(stmt), var_t) end
				if expr_nt_const == AstType.LiteralFloat do var_t = fat_str_new("float"); set_var_type(ast_node_name(stmt), var_t) end
				if expr_nt_const == AstType.LiteralBool do var_t = fat_str_new("bool"); set_var_type(ast_node_name(stmt), var_t) end
				if expr_nt_const == AstType.LiteralNone do var_t = fat_str_new("none"); set_var_type(ast_node_name(stmt), var_t) end
				if expr_nt_const == AstType.LiteralStr or expr_nt_const == AstType.InterpExpr do var_t = fat_str_new("string"); set_var_type(ast_node_name(stmt), var_t) end
			end
			if var_t != 0 and fat_str_len(var_t) > 0 do
				set_var_type(ast_node_name(stmt), var_t)
			end
			out b3
		end
		decl_name = ast_node_name(stmt)
		var_t = ast_node_name2(stmt)
		record_var_declaration(decl_name)
		if var_t != 0 and is_tensor_type_str(var_t) do
			numel = parse_tensor_numel(var_t)
			if numel <= 0 do numel = 4 end
			let elem_bytes = tensor_elem_byte_size(var_t)
			var elem_bytes = tensor_elem_byte_size(var_t)
			let e_code = parse_tensor_elem_code(var_t)
			if e_code == 1 or elem_bytes < 8 do
				elem_bytes = 8
			end
			alloc_sz = 16 + numel * elem_bytes
			alloc_sz = (alloc_sz + 15) / 16 * 16
			b_mut = emit_set_arg(b, 0, mir_opnd_imm(alloc_sz))
			var (b_base, base_vr) = builder_new_vreg(b_mut)
			b_base = emit_intrinsic(b_base, MIR_INTR_BUILTIN, mir_opnd_vreg(base_vr), mir_opnd_imm(3))
			b_base = emit_set_arg(b_base, 0, mir_opnd_vreg(base_vr))
			b_base = emit_set_arg(b_base, 1, mir_opnd_imm(0))
			b_base = emit_set_arg(b_base, 2, mir_opnd_imm(numel))
			b_base = emit_intrinsic(b_base, MIR_INTR_BUILTIN, mir_opnd_none(), mir_opnd_imm(8))
			b_base = emit_set_arg(b_base, 0, mir_opnd_vreg(base_vr))
			b_base = emit_set_arg(b_base, 1, mir_opnd_imm(8))
			b_base = emit_set_arg(b_base, 2, mir_opnd_imm(numel))
			b_base = emit_intrinsic(b_base, MIR_INTR_BUILTIN, mir_opnd_none(), mir_opnd_imm(8))
			b_base = set_var_vreg(b_base, decl_name, base_vr)
			set_var_type(decl_name, var_t)
			out b_base
		end
		out b
	end

	if stmt_type == AstType.Assign do
		child_count = ast_node_child_count(stmt)
		var expr = 0
		var target_name = ast_node_name(stmt)
		if child_count >= 2 do
			target_name = ast_node_name(ast_node_child(stmt, 0))
			expr = ast_node_child(stmt, 1)
		else
			expr = ast_node_child(stmt, 0)
		end
		if expr != 0 do
			var expr_nt = ast_node_type_of(expr)
			if expr_nt == AstType.EntityLiteral or expr_nt == AstType.Call do
				var cname = resolve_callee_alias(ast_node_name(expr))
				if is_entity_name(cname) == 1 do
					set_var_type(target_name, cname)
				end
			end
			if expr_nt == AstType.QuantizeExpr do
				set_var_type(target_name, fat_str_new("QuantizedTensor"))
			end
			if expr_nt == AstType.BinOp and (ast_node_op_of(expr) == OpType.MatMulOp or ast_node_op_of(expr) == OpType.FmaOp) do
				left_n = ast_node_child(expr, 0)
				right_n = ast_node_child(expr, 1)
				left_t = get_var_type(ast_node_name(left_n))
				right_t = get_var_type(ast_node_name(right_n))
				if is_tensor_type_str(left_t) and is_tensor_type_str(right_t) do
					shape_a = parse_tensor_shape(left_t)
					shape_b = parse_tensor_shape(right_t)
					if vec_len_rt(shape_a) >= 2 and vec_len_rt(shape_b) >= 2 do
						dim_m = vec_get_rt(shape_a, 0) as i64
						dim_n = vec_get_rt(shape_b, 1) as i64
						# Detect float element type from left operand
						# Determine element type prefix from left operand
						var elem_prefix = fat_str_new("tensor<int>")
						var pt_len = fat_str_len(left_t)
						var is_float = false
						var ci = 0
						when ci < pt_len loop
							let cc = fat_str_byte_at(left_t, ci)
							if cc == 102 or cc == 70 do is_float = true end
							ci = ci + 1
						end
						if is_float do
							elem_prefix = fat_str_new("tensor<f32>")
							if tensor_elem_byte_size(left_t) == 8 do
								elem_prefix = fat_str_new("tensor<f64>")
							else
								elem_prefix = fat_str_new("tensor<f32>")
							end
						end
						let l_code = parse_tensor_elem_code(left_t)
						if l_code == 1 do elem_prefix = fat_str_new("tensor<f32>") end
						if l_code == 2 do elem_prefix = fat_str_new("tensor<f16>") end
						if l_code == 3 do elem_prefix = fat_str_new("tensor<i8>") end
						if l_code == 4 do elem_prefix = fat_str_new("tensor<u8>") end
						if l_code == 5 do elem_prefix = fat_str_new("tensor<i32>") end
						if l_code == 6 do elem_prefix = fat_str_new("tensor<int>") end
						if l_code == 7 do elem_prefix = fat_str_new("tensor<f64>") end
						var mm_type = fat_str_concat(elem_prefix, fat_str_new("["))
						mm_type = fat_str_concat(mm_type, fat_str_new(rt_itoa(dim_m)))
						mm_type = fat_str_concat(mm_type, fat_str_new(","))
						mm_type = fat_str_concat(mm_type, fat_str_new(rt_itoa(dim_n)))
						mm_type = fat_str_concat(mm_type, fat_str_new("]"))
						set_var_type(target_name, mm_type)
					end
				end
			end
		end
		var (b2, val_opnd) = lower_expr(b, expr)
		v = get_var_vreg(b2, target_name)
		if v >= 0 do
			b2 = emit_move(b2, v, val_opnd)
			out b2
		end
		global_slot = global_slot_lookup(target_name)
		if global_slot >= 0 do
			out emit_intrinsic(b2, MIR_INTR_GLOBAL_STORE, mir_opnd_imm(global_slot), val_opnd)
		end
		var (b3, v2) = builder_new_vreg(b2)
		b3 = emit_move(b3, v2, val_opnd)
		b3 = set_var_vreg(b3, target_name, v2)
		out b3
	end

    # 2b. IndexAssign — name[idx, ...] = val → INDEX_STORE
	if stmt_type == AstType.IndexAssign do
		child_count = ast_node_child_count(stmt)
		if child_count >= 2 do
			vname = ast_node_name(stmt)
			bv = get_var_vreg(b, vname)
			vtype = get_var_type(vname)
			val_expr = ast_node_child(stmt, child_count - 1)
			if is_tensor_type_str(vtype) and parse_tensor_elem_code(vtype) == 1 do
				var is_flt_val = false
				if ast_node_type_of(val_expr) == AstType.LiteralFloat do is_flt_val = true end
				if fat_cstr_eq(infer_expr_type_name(val_expr), "float") == 1 do is_flt_val = true end
				let shape_v = parse_tensor_shape(vtype)
				let rank_v = vec_len_rt(shape_v)
				if rank_v > 0 do
					var prefix = fat_str_new("tensor<int>[")
					if is_flt_val do
						prefix = fat_str_new("tensor<f64>[")
					end
					var new_t = prefix
					var si = 0
					when si < rank_v loop
						if si > 0 do new_t = fat_str_concat(new_t, fat_str_new(",")) end
						let d_val = vec_get_rt(shape_v, si) as int
						new_t = fat_str_concat(new_t, fat_str_new(rt_itoa(d_val)))
						si = si + 1
					end
					new_t = fat_str_concat(new_t, fat_str_new("]"))
					set_var_type(vname, new_t)
					vtype = new_t
				end
			end
			num_indices = child_count - 1
			b_cur = b
			flat_opnd = mir_opnd_none()
			if num_indices == 1 do
				var (b2, idx) = lower_expr(b_cur, ast_node_child(stmt, 0))
				b_cur = b2
				flat_opnd = idx
			else
				var k = 0
				when k < num_indices loop
					idx_ast = ast_node_child(stmt, k)
					var (b_next, idx_op) = lower_expr(b_cur, idx_ast)
					b_cur = b_next
					stride = 1
					if is_tensor_type_str(vtype) do
						stride = parse_tensor_stride(vtype, k)
					end
					term_op = idx_op
					if stride > 1 do
						var (b_mul, mul_v) = builder_new_vreg(b_cur)
						ins_m = mir_instr_new(MirOp.Mul, mir_opnd_vreg(mul_v), idx_op, mir_opnd_imm(stride))
						b_cur = builder_add_instr(b_mul, ins_m)
						term_op = mir_opnd_vreg(mul_v)
					end
					if k == 0 do
						flat_opnd = term_op
					else
						var (b_add, add_v) = builder_new_vreg(b_cur)
						ins_a = mir_instr_new(MirOp.Add, mir_opnd_vreg(add_v), flat_opnd, term_op)
						b_cur = builder_add_instr(b_add, ins_a)
						flat_opnd = mir_opnd_vreg(add_v)
					end
					k = k + 1
				end
			end
			var (b3, val) = lower_expr(b_cur, val_expr)
			if bv >= 0 do
				b3 = emit_set_arg(b3, 0, flat_opnd)
				b3 = emit_set_arg(b3, 1, val)
				var elem_m_typ = MirType.Int64
				if is_tensor_type_str(vtype) do
					let code = parse_tensor_elem_code(vtype)
					if code == 1 do elem_m_typ = MirType.F32 end
					if code == 2 do elem_m_typ = MirType.F16 end
					if code == 3 or code == 4 do elem_m_typ = MirType.Int8 end
					if code == 5 do elem_m_typ = MirType.Int32 end
				end
				b3 = emit_intrinsic_typed(b3, MIR_INTR_INDEX_STORE, mir_opnd_none(), mir_opnd_vreg(bv), elem_m_typ)
			end
			out b3
		end
		out b
	end

	if stmt_type == AstType.FieldAssign do
		child_count = ast_node_child_count(stmt)
		if child_count >= 1 do
			var fld_name = ast_node_name2(stmt)
			var base_name = ast_node_name(stmt)
			if child_count >= 2 do
				base_ast = ast_node_child(stmt, 1)
				if ast_node_type_of(base_ast) == AstType.Identifier do
					base_name = ast_node_name(base_ast)
				end
			end
			var bv = get_var_vreg(b, base_name)
			if is_register_field(fld_name) == 1 and bv >= 0 do
				var (b2, val) = lower_expr(b, ast_node_child(stmt, 0))
				start_bit = get_register_field_start(fld_name)
				width = get_register_field_width(fld_name)
				let pack_info = MIR_INTR_BIT_INSERT or (start_bit shl 8) or (width shl 16)
				b2 = emit_set_arg(b2, 0, val)
				var (b3, new_vreg) = builder_new_vreg(b2)
				ins = mir_instr_new(MirOp.Intrinsic, mir_opnd_vreg(new_vreg), mir_opnd_vreg(bv), mir_opnd_imm(pack_info))
				b3 = builder_add_instr(b3, ins)
				out set_var_vreg(b3, base_name, new_vreg)
			end
			var (b2, val) = lower_expr(b, ast_node_child(stmt, 0))
			var base_opnd = mir_opnd_none()
			var base_type = fat_str_new("")
			var b_curr = b2
			if child_count >= 2 do
				base_ast = ast_node_child(stmt, 1)
				base_type = get_expr_entity_type(base_ast)
				var (b_b, b_op) = lower_expr(b_curr, base_ast)
				b_curr = b_b
				base_opnd = b_op
			else
				base_type = get_var_type(base_name)
				if bv >= 0 do
					base_opnd = mir_opnd_vreg(bv)
				end
			end
			if (base_opnd as i64) != 0 and native_read_i64(base_opnd as i64, 0) != MirOperandType.None do
				if is_packed_entity(base_type) do
					f_off = get_scoped_field_offset(base_type, fld_name)
					f_sz = get_scoped_field_size(base_type, fld_name)
					var (b3, addr) = builder_new_vreg(b_curr)
					ins_a = mir_instr_new(MirOp.Add, mir_opnd_vreg(addr), base_opnd, mir_opnd_imm(f_off))
					b3 = builder_add_instr(b3, ins_a)
					out emit_store_typed(b3, mir_opnd_vreg(addr), val, f_sz)
				end
				var fid = 0 - 1
				if fat_str_len(base_type) > 0 do
					fid = get_scoped_field_index(base_type, fld_name)
				end
				if fid < 0 do
					base_name = ast_node_name(stmt)
					fid = find_field_index_for_base(base_name, fld_name)
				end
				var (b3, addr) = builder_new_vreg(b_curr)
				ins_a = mir_instr_new(MirOp.Add, mir_opnd_vreg(addr), base_opnd, mir_opnd_imm(fid * 8))
				b3 = builder_add_instr(b3, ins_a)
				out emit_store(b3, mir_opnd_vreg(addr), val)
			end
			out b_curr
		end
		out b
	end

    # 3. IfStmt
	if stmt_type == AstType.IfStmt do
		cond_expr = ast_node_child(stmt, 0)
		then_block = ast_node_child(stmt, 1)
		var (b2, cond_opnd) = lower_expr(b, cond_expr)
		has_else = ast_node_child_count(stmt) > 2
		var (b3, then_id) = builder_add_block(b2)
		var else_id = 0
		var b4 = b3
		if has_else do
			var (b4_2, else_id_2) = builder_add_block(b3)
			b4 = b4_2
			else_id = else_id_2
		end
		var (b5, end_id) = builder_add_block(b4)
		if has_else == false do
			else_id = end_id
		end
		b5 = emit_jump_if(b5, cond_opnd, then_id, else_id)
		b5 = builder_set_current_block(b5, then_id)
		b5 = lower_stmt(b5, then_block)
		if not builder_current_block_terminated(b5) do
			b5 = emit_jump(b5, end_id)
		end
		if has_else do
			else_block = ast_node_child(stmt, 2)
			b5 = builder_set_current_block(b5, else_id)
			b5 = lower_stmt(b5, else_block)
			if not builder_current_block_terminated(b5) do
				b5 = emit_jump(b5, end_id)
			end
		end
		b5 = builder_set_current_block(b5, end_id)
		out b5
	end

    # 4. WhileStmt — JumpIfNot(cond, end) else Jump(body)
	if stmt_type == AstType.WhileStmt do
		cond_expr = ast_node_child(stmt, 0)
		body_block = ast_node_child(stmt, 1)
		var (b2, cond_id) = builder_add_block(b)
		var (b3, body_id) = builder_add_block(b2)
		var (b4, end_id) = builder_add_block(b3)
		b4 = emit_jump(b4, cond_id)
		b4 = builder_push_loop(b4, end_id, cond_id)
		b4 = builder_set_current_block(b4, cond_id)
		var (b5, cond_opnd) = lower_expr(b4, cond_expr)
		b5 = emit_jump_if_not(b5, cond_opnd, end_id, body_id)
		b5 = builder_set_current_block(b5, body_id)
		b5 = lower_stmt(b5, body_block)
		if not builder_current_block_terminated(b5) do
			b5 = emit_jump(b5, cond_id)
		end
		b5 = builder_pop_loop(b5)
		b5 = builder_set_current_block(b5, end_id)
		out b5
	end

    # 4b. LoopStmt — counted: i in 0..count
	if stmt_type == AstType.LoopStmt do
		count_expr = ast_node_child(stmt, 0)
		body_block = ast_node_child(stmt, 1)
		var (b2, count_opnd) = lower_expr(b, count_expr)
		var (b3, iv) = builder_new_vreg(b2)
		ins0 = mir_instr_new(MirOp.Move, mir_opnd_vreg(iv), mir_opnd_imm(0), mir_opnd_none())
		b3 = builder_add_instr(b3, ins0)
		var (b4, cond_id) = builder_add_block(b3)
		var (b5, body_id) = builder_add_block(b4)
		var (b6, step_id) = builder_add_block(b5)
		var (b7, end_id) = builder_add_block(b6)
		b7 = emit_jump(b7, cond_id)
		b7 = builder_push_loop(b7, end_id, step_id)
		b7 = builder_set_current_block(b7, cond_id)
		var (b8, cmpv) = builder_new_vreg(b7)
		insc = mir_instr_new(MirOp.CmpLt, mir_opnd_vreg(cmpv), mir_opnd_vreg(iv), count_opnd)
		b8 = builder_add_instr(b8, insc)
		b8 = emit_jump_if_not(b8, mir_opnd_vreg(cmpv), end_id, body_id)
		b8 = builder_set_current_block(b8, body_id)
		b8 = lower_stmt(b8, body_block)
		if not builder_current_block_terminated(b8) do
			b8 = emit_jump(b8, step_id)
		end
		b8 = builder_set_current_block(b8, step_id)
        # Non-SSA induction: redefine same vreg (SSA rename comes later).
		var (b9, iv2) = builder_new_vreg(b8)
		ins1 = mir_instr_new(MirOp.Add, mir_opnd_vreg(iv2), mir_opnd_vreg(iv), mir_opnd_imm(1))
		b9 = builder_add_instr(b9, ins1)
		insm = mir_instr_new(MirOp.Move, mir_opnd_vreg(iv), mir_opnd_vreg(iv2), mir_opnd_none())
		b9 = builder_add_instr(b9, insm)
		b9 = emit_jump(b9, cond_id)
		b9 = builder_pop_loop(b9)
		b9 = builder_set_current_block(b9, end_id)
		out b9
	end

    # 5. Block
	if stmt_type == AstType.Block do
		push_scope()
		child_count = ast_node_child_count(stmt)
		var i = 0
		b_mut = b
		when i < child_count loop
			child = ast_node_child(stmt, i)
			b_mut = lower_stmt(b_mut, child)
			if builder_current_block_terminated(b_mut) do
				break
			end
			i = i + 1
		end
		pop_scope()
		out b_mut
	end

    # 6. ReturnStmt
	if stmt_type == AstType.ReturnStmt do
		child_count = ast_node_child_count(stmt)
		if child_count > 0 do
			var (b2, ret_opnd) = lower_expr(b, ast_node_child(stmt, 0))
			ins = mir_instr_new(MirOp.Return, mir_opnd_none(), ret_opnd, mir_opnd_none())
			b2 = builder_add_instr(b2, ins)
			out b2
		else
			ins = mir_instr_new(MirOp.Return, mir_opnd_none(), mir_opnd_none(), mir_opnd_none())
			b2 = builder_add_instr(b, ins)
			out b2
		end
	end

    # 7. PrintStmt
	if stmt_type == AstType.PrintStmt do
		child_count = ast_node_child_count(stmt)
		if child_count > 0 do
			expr = ast_node_child(stmt, 0)
			var (b2, val_opnd) = lower_expr(b, expr)
			print_type = infer_expr_type_name(expr)
			if ast_node_type_of(expr) == AstType.LiteralStr or ast_node_type_of(expr) == AstType.InterpExpr or fat_cstr_eq(print_type, "string") == 1 do
				b2 = emit_intrinsic(b2, MIR_INTR_PRINT_STR, mir_opnd_none(), val_opnd)
			else
				b2 = emit_intrinsic(b2, MIR_INTR_PRINT, mir_opnd_none(), val_opnd)
			end
			out b2
		end
		out b
	end

    # 8. Break / Continue
	if stmt_type == AstType.BreakStmt do
		lt = builder_loop_top(b)
		brk = loop_target_break_block(lt)
		if brk >= 0 do
			out emit_jump(b, brk)
		end
		out b
	end
	if stmt_type == AstType.ContinueStmt do
		lt = builder_loop_top(b)
		cnt = loop_target_continue_block(lt)
		if cnt >= 0 do
			out emit_jump(b, cnt)
		end
		out b
	end

    # 9. CaseExpr — children: [target, pat, body, pat, body, ...]
	if stmt_type == AstType.CaseExpr do
		child_count = ast_node_child_count(stmt)
		if child_count >= 1 do
			target_expr = ast_node_child(stmt, 0)
			var (b2, target_opnd) = lower_expr(b, target_expr)
			var (b3, end_id) = builder_add_block(b2)
			var i = 1
			b_mut = b3
			when i + 1 < child_count loop
				pat = ast_node_child(stmt, i)
				body = ast_node_child(stmt, i + 1)
				var (b4, arm_id) = builder_add_block(b_mut)
				var (b5, next_id) = builder_add_block(b4)
                # Wildcard / else
				is_wild = 0
				if ast_node_type_of(pat) == AstType.Identifier do
					if fat_cstr_eq(ast_node_name(pat), "_") do
						is_wild = 1
					end
					if ast_node_int_val(pat) == 0 - 1 do
						is_wild = 1
					end
				end
				if is_wild != 0 do
					b5 = emit_jump(b5, arm_id)
				else
					if ast_node_type_of(pat) == AstType.BinaryExpr or ast_node_type_of(pat) == AstType.RangeExpr do
						low_node = ast_node_child(pat, 0)
						high_node = ast_node_child(pat, 1)
						var (b5_1, v_ge) = builder_new_vreg(b5)
						ins_ge = mir_instr_new(MirOp.CmpGe, mir_opnd_vreg(v_ge), target_opnd, mir_opnd_imm(ast_node_int_val(low_node)))
						b5_1 = builder_add_instr(b5_1, ins_ge)
						var (b5_2, v_lt) = builder_new_vreg(b5_1)
						ins_lt = mir_instr_new(MirOp.CmpLt, mir_opnd_vreg(v_lt), target_opnd, mir_opnd_imm(ast_node_int_val(high_node)))
						b5_2 = builder_add_instr(b5_2, ins_lt)
						var (b5_3, v_in_range) = builder_new_vreg(b5_2)
						ins_and = mir_instr_new(MirOp.BitAnd, mir_opnd_vreg(v_in_range), mir_opnd_vreg(v_ge), mir_opnd_vreg(v_lt))
						b5_3 = builder_add_instr(b5_3, ins_and)
						b5 = emit_jump_if(b5_3, mir_opnd_vreg(v_in_range), arm_id, next_id)
					else
					if ast_node_type_of(pat) == AstType.LiteralInt do
						var (b6, cv) = builder_new_vreg(b5)
						insc = mir_instr_new(MirOp.CmpEq, mir_opnd_vreg(cv), target_opnd, mir_opnd_imm(ast_node_int_val(pat)))
						b6 = builder_add_instr(b6, insc)
						b5 = emit_jump_if(b6, mir_opnd_vreg(cv), arm_id, next_id)
					else
						if ast_node_type_of(pat) == AstType.Identifier and fat_cstr_eq(ast_node_name(pat), "true") do
							var (b6, cv) = builder_new_vreg(b5)
							insc = mir_instr_new(MirOp.CmpEq, mir_opnd_vreg(cv), target_opnd, mir_opnd_imm(1))
							b6 = builder_add_instr(b6, insc)
							b5 = emit_jump_if(b6, mir_opnd_vreg(cv), arm_id, next_id)
						else
							if ast_node_type_of(pat) == AstType.Identifier and fat_cstr_eq(ast_node_name(pat), "false") do
								var (b6, cv) = builder_new_vreg(b5)
								insc = mir_instr_new(MirOp.CmpEq, mir_opnd_vreg(cv), target_opnd, mir_opnd_imm(0))
								b6 = builder_add_instr(b6, insc)
								b5 = emit_jump_if(b6, mir_opnd_vreg(cv), arm_id, next_id)
							else
								if ast_node_type_of(pat) == AstType.LiteralStr do
									var (b5b, pid) = builder_intern(b5, ast_node_name(pat))
									b5b = emit_set_arg(b5b, 0, mir_opnd_imm(pid))
									var (b6, cv) = builder_new_vreg(b5b)
									b6 = emit_intrinsic(b6, MIR_INTR_STR_EQ, mir_opnd_vreg(cv), target_opnd)
									b5 = emit_jump_if(b6, mir_opnd_vreg(cv), arm_id, next_id)
								else
                                    # Tagged / other — pool id in SetArg0, then MATCH_PAT
									var (b5b, pid) = builder_intern(b5, ast_node_name(pat))
									b5b = emit_set_arg(b5b, 0, mir_opnd_imm(pid))
									var (b6, cv) = builder_new_vreg(b5b)
									b6 = emit_intrinsic(b6, MIR_INTR_MATCH_PAT, mir_opnd_vreg(cv), target_opnd)
									b5 = emit_jump_if(b6, mir_opnd_vreg(cv), arm_id, next_id)
								end
							end
						end
					end
					end
				end
				b5 = builder_set_current_block(b5, arm_id)
				b5 = lower_stmt(b5, body)
				if not builder_current_block_terminated(b5) do
					b5 = emit_jump(b5, end_id)
				end
				b5 = builder_set_current_block(b5, next_id)
				b_mut = b5
				i = i + 2
			end
			if i < child_count do
				else_body = ast_node_child(stmt, i)
				b_mut = lower_stmt(b_mut, else_body)
			end
            # Fallthrough if no arm matched → end
			b_mut = emit_jump(b_mut, end_id)
			b_mut = builder_set_current_block(b_mut, end_id)
			out b_mut
		end
		out b
	end

    # 10. ForRange — name=var, children=[start, end, body]
	if stmt_type == AstType.ForRange do
		child_count = ast_node_child_count(stmt)
		if child_count >= 3 do
			start_expr = ast_node_child(stmt, 0)
			end_expr = ast_node_child(stmt, 1)
			body_stmt = ast_node_child(stmt, 2)
			var (b2, start_opnd) = lower_expr(b, start_expr)
			var (b3, end_opnd) = lower_expr(b2, end_expr)
			var (b4, iv) = builder_new_vreg(b3)
			ins0 = mir_instr_new(MirOp.Move, mir_opnd_vreg(iv), start_opnd, mir_opnd_none())
			b4 = builder_add_instr(b4, ins0)
			b4 = set_var_vreg(b4, ast_node_name(stmt), iv)
			var (b5, cond_id) = builder_add_block(b4)
			var (b6, body_id) = builder_add_block(b5)
			var (b7, step_id) = builder_add_block(b6)
			var (b8, end_id) = builder_add_block(b7)
			b8 = emit_jump(b8, cond_id)
			b8 = builder_push_loop(b8, end_id, step_id)
			b8 = builder_set_current_block(b8, cond_id)
            # Re-read iv from var_map (may be updated each iter after SSA-ish Move)
			iv_cur = get_var_vreg(b8, ast_node_name(stmt))
			var (b9, cmpv) = builder_new_vreg(b8)
			insc = mir_instr_new(MirOp.CmpLt, mir_opnd_vreg(cmpv), mir_opnd_vreg(iv_cur), end_opnd)
			b9 = builder_add_instr(b9, insc)
			b9 = emit_jump_if_not(b9, mir_opnd_vreg(cmpv), end_id, body_id)
			b9 = builder_set_current_block(b9, body_id)
			b9 = lower_stmt(b9, body_stmt)
			if not builder_current_block_terminated(b9) do
				b9 = emit_jump(b9, step_id)
			end
			b9 = builder_set_current_block(b9, step_id)
			iv_cur2 = get_var_vreg(b9, ast_node_name(stmt))
			var (b10, ivn) = builder_new_vreg(b9)
			ins1 = mir_instr_new(MirOp.Add, mir_opnd_vreg(ivn), mir_opnd_vreg(iv_cur2), mir_opnd_imm(1))
			b10 = builder_add_instr(b10, ins1)
			insm = mir_instr_new(MirOp.Move, mir_opnd_vreg(iv_cur2), mir_opnd_vreg(ivn), mir_opnd_none())
			b10 = builder_add_instr(b10, insm)
			b10 = set_var_vreg(b10, ast_node_name(stmt), iv_cur2)
			b10 = emit_jump(b10, cond_id)
			b10 = builder_pop_loop(b10)
			b10 = builder_set_current_block(b10, end_id)
			out b10
		end
		out b
	end

    # 11. EnsureBlock / RevertBlock — marker + body
	if stmt_type == AstType.EnsureBlock do
		b = emit_intrinsic(b, MIR_INTR_ENSURE, mir_opnd_none(), mir_opnd_none())
		if ast_node_child_count(stmt) > 0 do
			out lower_stmt(b, ast_node_child(stmt, 0))
		end
		out b
	end
	if stmt_type == AstType.RevertBlock do
		b = emit_intrinsic(b, MIR_INTR_REVERT, mir_opnd_none(), mir_opnd_none())
		if ast_node_child_count(stmt) > 0 do
			out lower_stmt(b, ast_node_child(stmt, 0))
		end
		out b
	end

    # 12. WhenStmt — same CFG as While (JumpIfNot)
	if stmt_type == AstType.WhenStmt do
		cond_expr = ast_node_child(stmt, 0)
		body_block = ast_node_child(stmt, 1)
		var (b2, cond_id) = builder_add_block(b)
		var (b3, body_id) = builder_add_block(b2)
		var (b4, end_id) = builder_add_block(b3)
		b4 = emit_jump(b4, cond_id)
		b4 = builder_push_loop(b4, end_id, cond_id)
		b4 = builder_set_current_block(b4, cond_id)
		var (b5, cond_opnd) = lower_expr(b4, cond_expr)
		b5 = emit_jump_if_not(b5, cond_opnd, end_id, body_id)
		b5 = builder_set_current_block(b5, body_id)
		b5 = lower_stmt(b5, body_block)
		if not builder_current_block_terminated(b5) do
			b5 = emit_jump(b5, cond_id)
		end
		b5 = builder_pop_loop(b5)
		b5 = builder_set_current_block(b5, end_id)
		out b5
	end

    # 13. Throw / Cancel / Quiet
	if stmt_type == AstType.ThrowStmt do
        # Inside a `try` body: set `err` to the thrown value and branch to the
        # revert handler. Subsequent code in this block is dead, so continue in
        # a fresh (unreachable) block to keep the CFG well-formed.
		if g_try_revert_block >= 0 do
			if ast_node_child_count(stmt) > 0 do
				var (bt, tv) = lower_expr(b, ast_node_child(stmt, 0))
				bt = emit_move(bt, g_try_err_vreg, tv)
				b = bt
			end
			b = emit_jump(b, g_try_revert_block)
			var (bd, dead_id) = builder_add_block(b)
			out builder_set_current_block(bd, dead_id)
		end
		if ast_node_child_count(stmt) > 0 do
			var (b2, v) = lower_expr(b, ast_node_child(stmt, 0))
			out emit_intrinsic(b2, MIR_INTR_THROW, mir_opnd_none(), v)
		end
		out emit_intrinsic(b, MIR_INTR_THROW, mir_opnd_none(), mir_opnd_none())
	end
	if stmt_type == AstType.CancelStmt do
		if ast_node_child_count(stmt) > 0 do
			var (b2, v) = lower_expr(b, ast_node_child(stmt, 0))
			out emit_intrinsic(b2, MIR_INTR_CANCEL, mir_opnd_none(), v)
		end
		out emit_intrinsic(b, MIR_INTR_CANCEL, mir_opnd_none(), mir_opnd_none())
	end
	if stmt_type == AstType.QuietStmt do
		if ast_node_child_count(stmt) > 0 do
			var (b2, _) = lower_expr(b, ast_node_child(stmt, 0))
			out emit_intrinsic(b2, MIR_INTR_QUIET, mir_opnd_none(), mir_opnd_none())
		end
		out b
	end

    # 14. ArenaBlock — sub-arena save and restore
	if stmt_type == AstType.ArenaBlock do
		var (b1, mark_vreg) = builder_new_vreg(b)
		b1 = emit_intrinsic(b1, MIR_INTR_ARENA, mir_opnd_vreg(mark_vreg), mir_opnd_none())
		n_ch = ast_node_child_count(stmt)
		if n_ch > 0 do
			body_idx = n_ch - 1
			b1 = lower_stmt(b1, ast_node_child(stmt, body_idx))
		end
		out emit_intrinsic(b1, MIR_INTR_ARENA, mir_opnd_none(), mir_opnd_vreg(mark_vreg))
	end

    # 14b. Emit / Select / Try / Resume / Infer / Train
	if stmt_type == AstType.EmitStmt do
		if ast_node_child_count(stmt) > 0 do
			var (b2, v) = lower_expr(b, ast_node_child(stmt, 0))
			out emit_intrinsic(b2, MIR_INTR_EMIT, mir_opnd_none(), v)
		end
		out emit_intrinsic(b, MIR_INTR_EMIT, mir_opnd_none(), mir_opnd_none())
	end
	if stmt_type == AstType.SelectStmt do
		b = emit_intrinsic(b, MIR_INTR_SELECT, mir_opnd_none(), mir_opnd_none())
		if ast_node_child_count(stmt) > 0 do
			out lower_stmt(b, ast_node_child(stmt, 0))
		end
		out b
	end
	if stmt_type == AstType.TryStmt do
		nch = ast_node_child_count(stmt)
        # Emit timeout/isolate option markers first (kept for compatibility).
		var ci = 0
		var try_body = 0 - 1
		var revert_body = 0 - 1
		when ci < nch loop
			ch = ast_node_child(stmt, ci)
			ct = ast_node_type_of(ch)
			if ct == AstType.TimeoutClause do
				if ast_node_child_count(ch) > 0 do
					var (bt2, tv2) = lower_expr(b, ast_node_child(ch, 0))
					b = emit_intrinsic(bt2, MIR_INTR_TIMEOUT, mir_opnd_none(), tv2)
				else
					b = emit_intrinsic(b, MIR_INTR_TIMEOUT, mir_opnd_none(), mir_opnd_none())
				end
			eif ct == AstType.IsolateClause do
				b = emit_intrinsic(b, MIR_INTR_ISOLATE, mir_opnd_none(), mir_opnd_none())
			else
                # First Block is the try body; the second is the revert handler.
				if try_body == 0 - 1 do
					try_body = ch
				else
					revert_body = ch
				end
			end
			ci = ci + 1
		end

        # `err` variable, visible to the revert handler; init to 0.
		var (be, err_v) = builder_new_vreg(b)
		be = emit_move(be, err_v, mir_opnd_imm(0))
		be = set_var_vreg(be, fat_str_new("err"), err_v)
		b = be

        # Create dedicated try_entry, revert, and join/end blocks.
		var (b_try, try_entry_id) = builder_add_block(b)
		var (b_rv, revert_id) = builder_add_block(b_try)
		var (b_en, end_id) = builder_add_block(b_rv)
		b = emit_jump(b_en, try_entry_id)
		b = builder_set_current_block(b, try_entry_id)

        # Install try context (save outer for nesting).
		saved_retry = g_try_retry_block
		saved_block = g_try_revert_block
		saved_err = g_try_err_vreg
		g_try_retry_block = try_entry_id
		g_try_revert_block = revert_id
		g_try_err_vreg = err_v

        # Try body: on normal completion jump past the handler.
		if (try_body as i64) != (0 - 1) do
			b = lower_stmt(b, try_body)
		end
		b = emit_jump(b, end_id)

        # Revert handler: outer revert block is active for nested throw / resume revert.
		g_try_revert_block = saved_block
		b = builder_set_current_block(b, revert_id)
		if (revert_body as i64) != (0 - 1) do
			b = lower_stmt(b, revert_body)
		end
		b = emit_jump(b, end_id)

        # Restore outer try context before continuing past try block.
		g_try_retry_block = saved_retry
		g_try_revert_block = saved_block
		g_try_err_vreg = saved_err

		b = builder_set_current_block(b, end_id)
		out b
	end
	if stmt_type == AstType.TimeoutClause do
		if ast_node_child_count(stmt) > 0 do
			var (b2, v) = lower_expr(b, ast_node_child(stmt, 0))
			out emit_intrinsic(b2, MIR_INTR_TIMEOUT, mir_opnd_none(), v)
		end
		out emit_intrinsic(b, MIR_INTR_TIMEOUT, mir_opnd_none(), mir_opnd_none())
	end
	if stmt_type == AstType.IsolateClause do
		b = emit_intrinsic(b, MIR_INTR_ISOLATE, mir_opnd_none(), mir_opnd_none())
		if ast_node_child_count(stmt) > 0 do
			c0 = ast_node_child(stmt, 0)
			if ast_node_type_of(c0) == AstType.Block do
				out lower_stmt(b, c0)
			end
			var (b2, _) = lower_expr(b, c0)
			out b2
		end
		out b
	end
	if stmt_type == AstType.ResumeStmt do
		let rname = ast_node_name(stmt)
		if fat_cstr_eq(rname, "retry") == 1 or fat_cstr_eq(rname, "ResumeRetry") == 1 do
			if g_try_retry_block >= 0 do
				b = emit_jump(b, g_try_retry_block)
				var (bd, dead_id) = builder_add_block(b)
				out builder_set_current_block(bd, dead_id)
			end
		eif fat_cstr_eq(rname, "revert") == 1 or fat_cstr_eq(rname, "ResumeRevert") == 1 do
			if g_try_revert_block >= 0 do
				b = emit_jump(b, g_try_revert_block)
				var (bd2, dead_id2) = builder_add_block(b)
				out builder_set_current_block(bd2, dead_id2)
			else
				out emit_intrinsic(b, MIR_INTR_THROW, mir_opnd_none(), mir_opnd_none())
			end
		end
		var (b1, rid) = builder_intern(b, rname)
		out emit_intrinsic(b1, MIR_INTR_RESUME, mir_opnd_none(), mir_opnd_imm(rid))
	end
	if stmt_type == AstType.InferBlock do
		b = emit_intrinsic(b, MIR_INTR_INFER, mir_opnd_none(), mir_opnd_none())
		if ast_node_child_count(stmt) > 0 do
			out lower_stmt(b, ast_node_child(stmt, 0))
		end
		out b
	end
	if stmt_type == AstType.TrainBlock do
		b = emit_intrinsic(b, MIR_INTR_TRAIN, mir_opnd_none(), mir_opnd_none())
		if ast_node_child_count(stmt) > 0 do
			out lower_stmt(b, ast_node_child(stmt, 0))
		end
		out b
	end
	if stmt_type == AstType.PrecompBlock do
		b = emit_intrinsic(b, MIR_INTR_PRECOMP, mir_opnd_none(), mir_opnd_none())
		if ast_node_child_count(stmt) > 0 do
			out lower_stmt(b, ast_node_child(stmt, 0))
		end
		out b
	end
	if stmt_type == AstType.AtomicVarDecl do
		b = emit_intrinsic(b, MIR_INTR_ATOMIC_VAR, mir_opnd_none(), mir_opnd_none())
		if ast_node_child_count(stmt) > 0 do
			out lower_stmt(b, ast_node_child(stmt, 0))
		end
		out b
	end
	if stmt_type == AstType.ReactiveDecl do
		var (b1, nid) = builder_intern(b, ast_node_name(stmt))
		b1 = emit_set_arg(b1, 0, mir_opnd_imm(nid))
		b1 = emit_intrinsic(b1, MIR_INTR_REACTIVE, mir_opnd_none(), mir_opnd_imm(nid))
		if ast_node_child_count(stmt) > 0 do
			var (b2, _) = lower_expr(b1, ast_node_child(stmt, 0))
			out b2
		end
		out b1
	end
	if stmt_type == AstType.MorphDecl do
		var (b1, nid) = builder_intern(b, ast_node_name(stmt))
		b1 = emit_set_arg(b1, 0, mir_opnd_imm(nid))
		b1 = emit_intrinsic(b1, MIR_INTR_MORPH, mir_opnd_none(), mir_opnd_imm(nid))
		if ast_node_child_count(stmt) > 0 do
			var (b2, _) = lower_expr(b1, ast_node_child(stmt, 0))
			out b2
		end
		out b1
	end
	if stmt_type == AstType.ExposeAttr do
		b = emit_intrinsic(b, MIR_INTR_EXPOSE, mir_opnd_none(), mir_opnd_none())
		if ast_node_child_count(stmt) > 0 do
			out lower_stmt(b, ast_node_child(stmt, 0))
		end
		out b
	end
    # Decl-style stmts inside functions → DECL markers
	if stmt_type == AstType.TypeAlias or stmt_type == AstType.LazyIncludeStmt or stmt_type == AstType.ShareDecl or stmt_type == AstType.HasDecl or stmt_type == AstType.ClassDef or stmt_type == AstType.DictDecl or stmt_type == AstType.TensorDecl or stmt_type == AstType.FluxDecl do
		out lower_decl_marker(b, stmt)
	end
	if stmt_type == AstType.BundleExpr or stmt_type == AstType.MapExpr or stmt_type == AstType.ArrCompactExpr or stmt_type == AstType.ErrorExpr or stmt_type == AstType.PtrTypeExpr or stmt_type == AstType.ExistExpr or stmt_type == AstType.PatternExpr or stmt_type == AstType.AddrOf or stmt_type == AstType.ErxExpr do
		var (b2, _) = lower_expr(b, stmt)
		out b2
	end

    # 15. Expr-as-stmt
	if stmt_type == AstType.Call or stmt_type == AstType.BuiltinCall or stmt_type == AstType.MethodCall or stmt_type == AstType.AwaitExpr or stmt_type == AstType.TaskExpr or stmt_type == AstType.WaitExpr or stmt_type == AstType.QuantizeExpr do
		var (b2, _) = lower_expr(b, stmt)
		out b2
	end

	out b
end.

func ast_build_global_init_func():
    b = builder_new(0 - 1, fat_str_new("__vir_global_init"))
    n = vec_len_rt(g_lower_global_names)
    var i = 0
    when i < n loop
        init_value = vec_get_rt(g_lower_global_values, i)
        init_node = vec_get_rt(g_lower_global_init_nodes, i) as AstNode
        # For entity/array/tuple literals or any non-constant init, lower the AST node.
        needs_lower = 0
        if init_node != 0 do
            node_t = ast_node_type_of(init_node)
            if node_t == AstType.EntityLiteral or node_t == AstType.ArrayLiteral or node_t == AstType.TupleLiteral do
                needs_lower = 1
            end
        end
        if needs_lower == 1 do
            var (b2, val_opnd) = lower_expr(b, init_node)
            b2 = emit_intrinsic(b2, MIR_INTR_GLOBAL_STORE, mir_opnd_imm(i), val_opnd)
            b = b2
        else
            b = emit_intrinsic(b, MIR_INTR_GLOBAL_STORE, mir_opnd_imm(i), mir_opnd_imm(init_value))
        end
        i = i + 1
    end
    b = builder_add_instr(b, mir_instr_new(MirOp.Return, mir_opnd_none(), mir_opnd_none(), mir_opnd_none()))
    out builder_func(b)
end.
func lower_stmt(b: MirBuilder, stmt: AstNode):
	# MirBuilder is mutated in place. In native self-host output the large
	# lower_stmt_impl return CFG can occasionally leave an AstType/boolean in
	# X0 instead of the builder pointer (for example 2 after a terminated
	# function body). Preserve the input handle in that case; all mutations
	# performed by the lowering call are already visible through it.
	lowered_b = lower_stmt_impl(b, stmt)
	if (lowered_b as i64) < 4096 do
		out b
	end
	out lowered_b
end.

func ast_lower_func(func_id: int, ast_func: AstNode):
    g_scope_stack = vec_new_rt()
    fname = ast_node_name(ast_func)
    fname2 = ast_node_name2(ast_func)
	b = builder_new(func_id, fname)
	f = builder_func(b)
	g_current_func_buckets = native_read_i64(f as i64, 64)
    # Modifiers carried in name2: async / precomp / method
	if fat_cstr_eq(fname2, "async") do
		b = emit_intrinsic(b, MIR_INTR_ASYNC, mir_opnd_none(), mir_opnd_none())
	end
	if fat_cstr_eq(fname2, "precomp") do
		b = emit_intrinsic(b, MIR_INTR_PRECOMP, mir_opnd_none(), mir_opnd_none())
	end
	is_method = 0
	if fat_cstr_eq(fname2, "method") == 1 do
		b = emit_intrinsic(b, MIR_INTR_DECL, mir_opnd_none(), mir_opnd_imm(AstType.MethodCall as i64))
		is_method = 1
	end
	child_count = ast_node_child_count(ast_func)

	var param_idx = 0
	if is_method == 1 do
		var has_this = 0
		if child_count > 0 do
			first_ch = ast_node_child(ast_func, 0)
			fcnt = ast_node_type_of(first_ch)
			if fcnt == AstType.Identifier or fcnt == AstType.RefParam or fcnt == AstType.ParamDef do
				if fat_cstr_eq(ast_node_name(first_ch), "this") == 1 do
					has_this = 1
				end
			end
		end
		if g_current_entity_name != 0 do
			set_var_type(fat_str_new("this"), g_current_entity_name as string)
		end
		if has_this == 0 do
			if ast_node_int_val(ast_func) == 0 do
				var (b_th, pv_th) = builder_new_vreg(b)
				b_th = emit_intrinsic(b_th, MIR_INTR_PARAM, mir_opnd_vreg(pv_th), mir_opnd_imm(0))
				b = set_var_vreg(b_th, fat_str_new("this"), pv_th)
				param_idx = 1
			end
		end
	end

	if child_count > 0 do
		var pi = 0
		when pi < child_count loop
			ch = ast_node_child(ast_func, pi)
			cnt = ast_node_type_of(ch)
			if cnt == AstType.Identifier or cnt == AstType.RefParam or cnt == AstType.ParamDef do
				var (b2, pv) = builder_new_vreg(b)
				b2 = emit_intrinsic(b2, MIR_INTR_PARAM, mir_opnd_vreg(pv), mir_opnd_imm(param_idx))
				b = set_var_vreg(b2, ast_node_name(ch), pv)
				if ast_node_name2(ch) != 0 and fat_str_len(ast_node_name2(ch)) > 0 do
					set_var_type(ast_node_name(ch), ast_node_name2(ch))
				end
				param_idx = param_idx + 1
			else
				b = lower_stmt(b, ch)
			end
			pi = pi + 1
		end
	end
    ins_ret = mir_instr_new(MirOp.Return, mir_opnd_none(), mir_opnd_none(), mir_opnd_none())
    b = builder_add_instr(b, ins_ret)
	f = builder_func(b)
    vc = native_read_i64(b as i64, 8)
    native_write_i64(f as i64, 16, vc)
	out f
end.
func lower_decl_marker(b: MirBuilder, node: AstNode):
    # Decl-only nodes: Intrinsic DECL so later MIR_/linker sees the name.
	var (b1, nid) = builder_intern(b, ast_node_name(node))
	b1 = emit_set_arg(b1, 0, mir_opnd_imm(nid))
	out emit_intrinsic(b1, MIR_INTR_DECL, mir_opnd_none(), mir_opnd_imm(ast_node_type_of(node) as i64))
end.

func ast_lower_program(prog: AstNode):
    set_global_prog_ast(prog)
	ffi_import_reset()
	g_mir_scratch_top = 0
	# Soft/C-VM: keep `var` on the result vec so push reassignments stick.
	var mir_funcs = vec_new_rt()
	mir_funcs = vec_push_rt(mir_funcs, ast_build_global_init_func())
	var child_count = ast_node_child_count(prog)
	var lowered = 0
	var i = 0
	when i < child_count loop
		var child = ast_node_child(prog, i)
		var is_func = 0
		nt = ast_node_type_of(child)
		if nt == AstType.BindAttr or nt == AstType.ExposeAttr do
			if ast_node_child_count(child) > 0 do
				child = ast_node_child(child, 0)
				nt = ast_node_type_of(child)
			end
		end
		if nt == AstType.FuncDef do
			is_func = 1
		end
		if nt == AstType.ExternFunc do
			# Externs are symbols, not empty executable functions.  The registry
			# is consumed by target object writers (Mach-O/ELF/PE/Wasm).
			param_types = vec_new_rt()
			var epi = 0
			when epi < ast_node_child_count(child) loop
				ep = ast_node_child(child, epi)
				if ast_node_type_of(ep) != AstType.Block do
					param_types = vec_push_rt(param_types, ast_node_name2(ep))
				end
				epi = epi + 1
			end
			provider = ast_node_int_val(child) as string
			if ast_node_int_val(child) == 0 do provider = fat_str_new("os") end
			ffi_import_register(ast_node_name(child), provider, param_types, ast_node_name2(child))
		end
		if is_func == 1 do
			var m_func = ast_lower_func(i, child)
			mir_funcs = vec_push_rt(mir_funcs, m_func)
			lowered = lowered + 1
			if g_ast_lower_verbose == 1 do
				if lowered == 1 || (lowered mod 50) == 0 do
					arena:
						var sb = sb_new()
						sb = sb_append(sb, "virc: pipeline — AST->MIR func ")
						sb = sb_append_int(sb, lowered)
						print_ln(sb_to_string(sb))
						sb_free(sb)
					end
				end
			end
		end
		if (nt == AstType.EntityDef or nt == AstType.PackedDef) and fat_cstr_eq(ast_node_name2(child), "interface") == 0 do
			g_current_entity_name = ast_node_name(child) as i64
			var n_ech = ast_node_child_count(child)
			var j = 0
			when j < n_ech loop
				var m_node = ast_node_child(child, j)
				if ast_node_type_of(m_node) == AstType.FuncDef do
					old_method_name = ast_node_name(m_node)
					old_method_meta = ast_node_name2(m_node)
					m_node.name = qualified_member_name(ast_node_name(child), old_method_name)
					m_node.name2 = fat_str_new("method")
					var m_func = ast_lower_func(vec_len_rt(mir_funcs), m_node)
					m_node.name = old_method_name
					m_node.name2 = old_method_meta
					mir_funcs = vec_push_rt(mir_funcs, m_func)
					lowered = lowered + 1
					if g_ast_lower_verbose == 1 do
						if lowered == 1 || (lowered mod 50) == 0 do
							arena:
								var sb = sb_new()
								sb = sb_append(sb, "virc: pipeline — AST->MIR func ")
								sb = sb_append_int(sb, lowered)
								print_ln(sb_to_string(sb))
								sb_free(sb)
							end
						end
					end
				end
				j = j + 1
			end
			g_current_entity_name = 0
		end
		i = i + 1
	end
	out mir_funcs
end.

export ast_lower_program, ast_lower_func, set_ast_lower_verbose, name_hash_bucket, get_var_vreg, set_var_vreg, emit_jump, emit_jump_if, emit_jump_if_not, emit_set_arg, emit_intrinsic, emit_move, emit_load, emit_store, lower_aggregate, MIR_VAR_BUCKETS, set_global_prog_ast, find_field_index, is_entity_name, is_register_field, get_register_field_start, get_register_field_width, is_register_field_scoped, get_register_field_start_scoped, get_register_field_width_scoped

# @vir_source stdlib/vir/compiler/virc.vri 61
import ffi_import_used_count from vir.compiler.ffi_imports
# @vir_source stdlib/vir/compiler/lir.vri 1
##
 * vir/compiler/lir.vri — Low-level Intermediate Representation
 * ==============================================================
 * Represents instructions close to the machine level, introducing
 * physical registers and stack slots.
 ##

import vec_new_rt, vec_push_rt, vec_get_rt, vec_set_rt, vec_len_rt from vec_rt

enum LirType:
	None = 0
	Int8 = 1
	Int16 = 2
	Int32 = 3
	Int64 = 4
	F32 = 5
	F64 = 6
	Ptr = 7
	Vector = 8
end.
enum LirOp:
	Nop = 0
	Mov = 1
	Add = 2
	Sub = 3
	Mul = 4
	Div = 5
	Push = 6
	Pop = 7
	Call = 8
	Jmp = 9
	JmpCond = 10
	Cmp = 11
	Ret = 12
	Load = 13
	Store = 14
	Rem = 15
	SetArg = 16
	Intrinsic = 17
	And = 18
	Or = 19
	Xor = 20
	Shl = 21
	Shr = 22
	Not = 23
	Pow = 24
	MatMul = 25
	Fma = 26
	# TCO: self-recursive tail-call — emits B instead of BL+RET
	TailCall = 27
end.

# Cmp / JmpCond predicate in LirInstr.aux
const LIR_CMP_EQ: i64 = 0
const LIR_CMP_NE: i64 = 1
const LIR_CMP_GT: i64 = 2
const LIR_CMP_LT: i64 = 3
const LIR_CMP_GE: i64 = 4
const LIR_CMP_LE: i64 = 5
const LIR_JMP_IF: i64 = 0
const LIR_JMP_IFNOT: i64 = 1
enum LirOperandType:
	None = 0
	VRegInt = 1
	VRegFloat = 2
	PhysReg = 3
	StackMem = 4
	Imm = 5
	Label = 6
end.
enum LirPhysReg:
	R0 = 0
	R1 = 1
	R2 = 2
	R3 = 3
	R4 = 4
	R5 = 5
	R6 = 6
	R7 = 7
	R8 = 8
	R9 = 9
	SP = 10
	FP = 11
	Max = 12
end.
entity LirOperand:
	op_type: LirOperandType,
	vreg: i64,
	phys_reg: i64,
	stack_offset: i64,
	imm: i64,
	label_id: i64
end.
import native_read_i64, native_write_i64 from string_rt

func lir_opnd_new(op_type: i64, vreg: i64, phys_reg: i64, stack_offset: i64, imm: i64, label_id: i64):
    p = alloc(48)
    native_write_i64(p, 0, op_type)
    native_write_i64(p, 8, vreg)
    native_write_i64(p, 16, phys_reg)
    native_write_i64(p, 24, stack_offset)
    native_write_i64(p, 32, imm)
    native_write_i64(p, 40, label_id)
    out p
end.

func lir_opnd_none():
    out lir_opnd_new(0, 0, 0, 0, 0, 0)
end.
func lir_opnd_vreg_int(r: i64):
    out lir_opnd_new(1, r, 0, 0, 0, 0)
end.
func lir_opnd_phys(r: LirPhysReg):
    out lir_opnd_new(3, 0, r as i64, 0, 0, 0)
end.
func lir_opnd_phys_reg(reg: LirPhysReg):
    out lir_opnd_phys(reg)
end.
func lir_opnd_stack_mem(offset: i64):
    out lir_opnd_new(4, 0, 0, offset, 0, 0)
end.
func lir_opnd_imm(val: i64):
    out lir_opnd_new(5, 0, 0, 0, val, 0)
end.
func lir_opnd_label(id: i64):
    out lir_opnd_new(6, 0, 0, 0, 0, id)
end.

func lir_instr_new(op: i64, typ: i64, dst: i64, src1: i64, src2: i64, aux: i64):
    p = alloc(48)
    native_write_i64(p, 0, op)
    native_write_i64(p, 8, typ)
    native_write_i64(p, 16, dst)
    native_write_i64(p, 24, src1)
    native_write_i64(p, 32, src2)
    native_write_i64(p, 40, aux)
    out p
end.

func lir_block_new(id: i64, instrs: i64):
    p = alloc(16)
    native_write_i64(p, 0, id)
    native_write_i64(p, 8, instrs)
    out p
end.

func lir_func_new(id: i64, name: string, blocks: i64, stack_size: i64, strings: i64):
    p = alloc(40)
    native_write_i64(p, 0, id)
    native_write_i64(p, 8, name as i64)
    native_write_i64(p, 16, blocks)
    native_write_i64(p, 24, stack_size)
    native_write_i64(p, 32, strings)
    out p
end.

entity LirInstr:
	op: LirOp,
	typ: LirType,
	dst: LirOperand,
	src1: LirOperand,
	src2: LirOperand,
	aux: i64
end.
entity LirBlock:
	id: i64,
	instrs: [LirInstr]
end.
entity LirFunc:
	id: i64,
	name: string,
	blocks: [LirBlock],
	stack_size: i64,
	strings: i64
end.

# Soft RT stub table indices (emit_lir_module_arm64).
# 1..60 mirror MIR_INTR_*; 0 = unresolved Call; 61..63 = Pow/MatMul/Fma.
const LIR_RT_NATIVE_READ_U8: i64 = 57
const LIR_RT_NATIVE_WRITE_U8: i64 = 58
const LIR_RT_NATIVE_READ_I64: i64 = 59
const LIR_RT_NATIVE_WRITE_I64: i64 = 60
const LIR_RT_UNRESOLVED: i64 = 0
const LIR_RT_POW: i64 = 61
const LIR_RT_MATMUL: i64 = 62
const LIR_RT_FMA: i64 = 63
const LIR_RT_ALLOC: i64 = 64
const LIR_RT_PRINT_STR: i64 = 65
const LIR_RT_GET_ARG: i64 = 66
const LIR_RT_ARG_COUNT: i64 = 67
const LIR_RT_VOLATILE_READ: i64 = 68
const LIR_RT_VOLATILE_WRITE: i64 = 69
const LIR_RT_VOLATILE_READ8: i64 = 70
const LIR_RT_VOLATILE_WRITE8: i64 = 71
const LIR_RT_DMB: i64 = 72
const LIR_RT_DSB: i64 = 73
const LIR_RT_ISB: i64 = 74
const LIR_RT_WFI: i64 = 75
const LIR_RT_WFE: i64 = 76
const LIR_RT_SEV: i64 = 77
const LIR_RT_NOP: i64 = 78
const LIR_RT_ATOMIC_LOAD32: i64 = 79
const LIR_RT_ATOMIC_STORE32: i64 = 80
const LIR_RT_ATOMIC_ADD32: i64 = 81
const LIR_RT_ATOMIC_SUB32: i64 = 82
const LIR_RT_ATOMIC_CAS32: i64 = 83
const LIR_RT_ATOMIC_EXCHANGE32: i64 = 84
const LIR_RT_ATOMIC_LOAD64: i64 = 85
const LIR_RT_ATOMIC_STORE64: i64 = 86
const LIR_RT_ATOMIC_ADD64: i64 = 87
const LIR_RT_ATOMIC_SUB64: i64 = 88
const LIR_RT_ATOMIC_CAS64: i64 = 89
const LIR_RT_ATOMIC_EXCHANGE64: i64 = 90
const LIR_RT_STR_LEN: i64 = 91
const LIR_RT_STR_CAT: i64 = 92
const LIR_RT_STR_EQ: i64 = 93
const LIR_RT_WRITE_BYTES: i64 = 94
const LIR_RT_SLURP_LEN: i64 = 95
const LIR_RT_SLURP_FILE: i64 = 96
const LIR_RT_INT_TO_STR: i64 = 97
const LIR_RT_SYSCALL: i64 = 98
const LIR_RT_PORT_CREATE: i64 = 99
const LIR_RT_PORT_SEND: i64 = 100
const LIR_RT_PORT_RECV: i64 = 101
const LIR_RT_ARR_NEW: i64 = 102
const LIR_RT_ARR_PUSH: i64 = 103
const LIR_RT_ARR_LEN: i64 = 104
const LIR_RT_PLATFORM: i64 = 105
const LIR_RT_EXIT_PROG: i64 = 106
const LIR_RT_QUANTIZE: i64 = 107
const LIR_RT_BACKWARD: i64 = 108
const LIR_RT_MATMUL_F64: i64 = 109
const LIR_RT_FMA_F64: i64 = 110
const LIR_RT_STUB_COUNT: i64 = 111

# Dump / test tags — keep 1:1 with LirOp enum numbers.
func lir_op_tag(op: i64):
	if op == 0 do out "Nop" end
	if op == 1 do out "Mov" end
	if op == 2 do out "Add" end
	if op == 3 do out "Sub" end
	if op == 4 do out "Mul" end
	if op == 5 do out "Div" end
	if op == 6 do out "Push" end
	if op == 7 do out "Pop" end
	if op == 8 do out "Call" end
	if op == 9 do out "Jmp" end
	if op == 10 do out "JmpCond" end
	if op == 11 do out "Cmp" end
	if op == 12 do out "Ret" end
	if op == 13 do out "Load" end
	if op == 14 do out "Store" end
	if op == 15 do out "Rem" end
	if op == 16 do out "SetArg" end
	if op == 17 do out "Intrinsic" end
	if op == 18 do out "And" end
	if op == 19 do out "Or" end
	if op == 20 do out "Xor" end
	if op == 21 do out "Shl" end
	if op == 22 do out "Shr" end
	if op == 23 do out "Not" end
	if op == 24 do out "Pow" end
	if op == 25 do out "MatMul" end
	if op == 26 do out "Fma" end
	if op == 27 do out "TailCall" end
	out "Unknown"
end.

import native_read_i64 from string_rt

func lir_func_id(f: LirFunc): out native_read_i64(f as i64, 0) end.
func lir_func_name(f: LirFunc): out native_read_i64(f as i64, 8) as string end.
func lir_func_blocks(f: LirFunc): out native_read_i64(f as i64, 16) end.
func lir_func_stack_size(f: LirFunc): out native_read_i64(f as i64, 24) end.
func lir_func_strings(f: LirFunc): out native_read_i64(f as i64, 32) end.

func lir_block_id(b: LirBlock): out native_read_i64(b as i64, 0) end.
func lir_block_instrs(b: LirBlock): out native_read_i64(b as i64, 8) end.

func lir_instr_op(ins: LirInstr): out native_read_i64(ins as i64, 0) end.
func lir_instr_typ(ins: LirInstr): out native_read_i64(ins as i64, 8) end.
func lir_instr_dst(ins: LirInstr): out native_read_i64(ins as i64, 16) end.
func lir_instr_src1(ins: LirInstr): out native_read_i64(ins as i64, 24) end.
func lir_instr_src2(ins: LirInstr): out native_read_i64(ins as i64, 32) end.
func lir_instr_aux(ins: LirInstr): out native_read_i64(ins as i64, 40) end.

func lir_opnd_type(o: LirOperand): out native_read_i64(o as i64, 0) end.
func lir_opnd_vreg(o: LirOperand): out native_read_i64(o as i64, 8) end.
func lir_opnd_phys_reg_val(o: LirOperand): out native_read_i64(o as i64, 16) end.
func lir_opnd_stack_offset(o: LirOperand): out native_read_i64(o as i64, 24) end.
func lir_opnd_imm_val(o: LirOperand): out native_read_i64(o as i64, 32) end.
func lir_opnd_label_id(o: LirOperand): out native_read_i64(o as i64, 40) end.

export LirType, LirOp, LirOperandType, LirPhysReg, LirOperand, LirInstr, LirBlock, LirFunc
export lir_opnd_new, lir_instr_new, lir_block_new, lir_func_new
export lir_opnd_none, lir_opnd_vreg_int, lir_opnd_phys, lir_opnd_phys_reg, lir_opnd_stack_mem, lir_opnd_imm, lir_opnd_label
export lir_func_id, lir_func_name, lir_func_blocks, lir_func_stack_size, lir_func_strings
