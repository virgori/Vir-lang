    ld s0, 8(sp)
    ld s1, 16(sp)
    ld s2, 24(sp)
    ld s3, 32(sp)
    ld s4, 40(sp)
    ld s5, 48(sp)
    ld s6, 56(sp)
    ld s7, 64(sp)
    addi sp, sp, 80
    ret
.size rt_quantize, .-rt_quantize

.globl rt_backward
.type rt_backward, %function
.p2align 2
rt_backward:
    addi sp, sp, -48
    sd ra, 0(sp)
    sd s0, 8(sp)
    sd s1, 16(sp)
    sd s2, 24(sp)
    sd s3, 32(sp)

    la t0, _vir_train_w
    ld s0, 0(t0)
    la t0, _vir_train_x
    ld s1, 0(t0)
    beqz s0, .Lback_exit
    beqz s1, .Lback_exit

    li a0, 48
    call rt_alloc
    mv s2, a0
    li t0, 4
    sd t0, 0(s2)
    sd t0, 8(s2)

    li a0, 48
    call rt_alloc
    mv s3, a0
    li t0, 4
    sd t0, 0(s3)
    sd t0, 8(s3)

    fld fa0, 16(s1)
    fld fa1, 24(s1)
    fld fa2, 32(s1)
    fld fa3, 40(s1)

    fadd.d ft0, fa0, fa1
    fadd.d ft1, fa2, fa3
    fsd ft0, 16(s2)
    fsd ft1, 24(s2)
    fsd ft0, 32(s2)
    fsd ft1, 40(s2)

    fld fa0, 16(s0)
    fld fa1, 24(s0)
    fld fa2, 32(s0)
    fld fa3, 40(s0)

    fadd.d ft0, fa0, fa2
    fadd.d ft1, fa1, fa3
    fsd ft0, 16(s3)
    fsd ft0, 24(s3)
    fsd ft1, 32(s3)
    fsd ft1, 40(s3)

    sd s2, 8(s0)
    sd s3, 8(s1)

.Lback_exit:
    ld ra, 0(sp)
    ld s0, 8(sp)
    ld s1, 16(sp)
    ld s2, 24(sp)
    ld s3, 32(sp)
    addi sp, sp, 48
    ret
.size rt_backward, .-rt_backward

.globl _start
.type _start, %function
.p2align 2
_start:
    jal ra, __vir_global_init
    jal ra, main
    li a7, 93
    ecall
.size _start, .-_start

.section .bss
.p2align 3
_vir_heap_start:
    .space 1048576
_vir_heap_curr:
    .quad 0
_vir_train_active:
    .quad 0
_vir_train_w:
    .quad 0
_vir_train_x:
    .quad 0
")
    else
        b = bvec_emit_cstr(b, ".globl rt_exit
.type rt_exit, %function
.p2align 2
rt_exit:
")
        b = bvec_emit_cstr(b, "    mov x8, #93
    svc #0
    ret
.size rt_exit, .-rt_exit

")

        b = bvec_emit_cstr(b, ".globl rt_print_int
.type rt_print_int, %function
.p2align 2
rt_print_int:
")
        b = bvec_emit_cstr(b, "    sub sp, sp, #128
")
        b = bvec_emit_cstr(b, "    str x1, [sp, #0]
    str x2, [sp, #8]
    str x3, [sp, #16]
")
        b = bvec_emit_cstr(b, "    str x4, [sp, #24]
    str x5, [sp, #32]
    str x6, [sp, #40]
")
        b = bvec_emit_cstr(b, "    mov x2, #10
    mov x3, #10
    strb w2, [sp, #127]
")
        b = bvec_emit_cstr(b, "    cmp x0, #0
    b.ne .L_print_nz
")
        b = bvec_emit_cstr(b, "    mov x2, #48
    strb w2, [sp, #126]
")
        b = bvec_emit_cstr(b, "    mov x0, #1
    add x1, sp, #126
    mov x2, #2
    b .L_print_sc
")
        b = bvec_emit_cstr(b, ".L_print_nz:
    add x1, sp, #127
    cmp x0, #0
    cset x4, lt
    cmp x4, #0
    b.eq .L_print_lp
    neg x0, x0
")
        b = bvec_emit_cstr(b, ".L_print_lp:
    sdiv x5, x0, x3
    msub x6, x5, x3, x0
    add x6, x6, #48
    sub x1, x1, #1
    strb w6, [x1]
")
        b = bvec_emit_cstr(b, "    mov x0, x5
    cmp x0, #0
    b.ne .L_print_lp
")
        b = bvec_emit_cstr(b, "    cmp x4, #0
    b.eq .L_print_fn
    mov x6, #45
    sub x1, x1, #1
    strb w6, [x1]
")
        b = bvec_emit_cstr(b, ".L_print_fn:
    mov x2, x1
    add x5, sp, #128
    sub x3, x5, x1
    mov x0, #1
    mov x1, x2
    mov x2, x3
")
        b = bvec_emit_cstr(b, ".L_print_sc:
    mov x8, #64
    svc #0
")
        b = bvec_emit_cstr(b, "    ldr x1, [sp, #0]
    ldr x2, [sp, #8]
    ldr x3, [sp, #16]
")
        b = bvec_emit_cstr(b, "    ldr x4, [sp, #24]
    ldr x5, [sp, #32]
    ldr x6, [sp, #40]
")
        b = bvec_emit_cstr(b, "    add sp, sp, #128
    ret
.size rt_print_int, .-rt_print_int

")

        b = bvec_emit_cstr(b, ".globl rt_print_str
.type rt_print_str, %function
.p2align 2
rt_print_str:
")
        b = bvec_emit_cstr(b, "    stp fp, lr, [sp, #-16]!
    mov fp, sp
    sub sp, sp, #32
")
        b = bvec_emit_cstr(b, "    str x19, [sp, #0]
    str x20, [sp, #8]
    mov x19, x0
    mov x20, #0
")
        b = bvec_emit_cstr(b, ".L_pstr_1:
    ldrb w1, [x19, x20]
    cbz w1, .L_pstr_2
    add x20, x20, #1
    b .L_pstr_1
")
        b = bvec_emit_cstr(b, ".L_pstr_2:
    mov x0, #1
    mov x1, x19
    mov x2, x20
    mov x8, #64
    svc #0
    mov w3, #10
    strb w3, [sp, #16]
    mov x0, #1
    add x1, sp, #16
    mov x2, #1
    mov x8, #64
    svc #0
")
        b = bvec_emit_cstr(b, "    ldr x19, [sp, #0]
    ldr x20, [sp, #8]
    add sp, sp, #32
    ldp fp, lr, [sp], #16
    ret
.size rt_print_str, .-rt_print_str
")
        b = bvec_emit_cstr(b, ".globl rt_str_cat
.type rt_str_cat, %function
.p2align 2
rt_str_cat:
    mov x9, x0
.L_gelf_ca1:
    ldrb w13, [x9]
    cbz w13, .L_gelf_ca2
    add x9, x9, #1
    b .L_gelf_ca1
.L_gelf_ca2:
    sub x2, x9, x0
    mov x10, x1
.L_gelf_cb1:
    ldrb w13, [x10]
    cbz w13, .L_gelf_cb2
    add x10, x10, #1
    b .L_gelf_cb1
.L_gelf_cb2:
    sub x3, x10, x1
    add x4, x2, x3
    add x4, x4, #8
    and x4, x4, #-8
    adrp x14, _vir_heap_curr
    add x14, x14, :lo12:_vir_heap_curr
    ldr x11, [x14]
    cbnz x11, .L_gelf_ch1
    adrp x11, _vir_heap_start
    add x11, x11, :lo12:_vir_heap_start
.L_gelf_ch1:
    add x12, x11, x4
    str x12, [x14]
    mov x12, x11
    mov x9, x0
.L_gelf_cca:
    ldrb w13, [x9]
    cbz w13, .L_gelf_ccb
    strb w13, [x12]
    add x9, x9, #1
    add x12, x12, #1
    b .L_gelf_cca
.L_gelf_ccb:
    mov x10, x1
.L_gelf_ccb1:
    ldrb w13, [x10]
    cbz w13, .L_gelf_cce
    strb w13, [x12]
    add x10, x10, #1
    add x12, x12, #1
    b .L_gelf_ccb1
.L_gelf_cce:
    strb wzr, [x12]
    mov x0, x11
    ret
.size rt_str_cat, .-rt_str_cat

.globl rt_int_to_str
.type rt_int_to_str, %function
.p2align 2
rt_int_to_str:
    adrp x14, _vir_heap_curr
    add x14, x14, :lo12:_vir_heap_curr
    ldr x11, [x14]
    cbnz x11, .L_gelf_ih1
    adrp x11, _vir_heap_start
    add x11, x11, :lo12:_vir_heap_start
.L_gelf_ih1:
    add x12, x11, #32
    str x12, [x14]
    add x10, x11, #31
    strb wzr, [x10]
    mov x9, x0
    mov x12, #0
    cmp x9, #0
    b.ge .L_gelf_ipos
    mov x12, #1
    neg x9, x9
.L_gelf_ipos:
    mov x15, #10
.L_gelf_iloop:
    udiv x13, x9, x15
    msub x14, x13, x15, x9
    add x14, x14, #48
    sub x10, x10, #1
    strb w14, [x10]
    mov x9, x13
    cbnz x9, .L_gelf_iloop
    cbz x12, .L_gelf_idone
    mov x15, #45
    sub x10, x10, #1
    strb w15, [x10]
.L_gelf_idone:
    mov x0, x10
    ret
.size rt_int_to_str, .-rt_int_to_str

.globl _start
.type _start, %function
.p2align 2
_start:
    bl __vir_global_init
    bl main
    mov x8, #93
    svc #0
.size _start, .-_start

.section .bss
.p2align 3
