    pass2_register_builtin_one(symbols, scopes, fat_str_new("syscall6"), 7)
end.
func pass2_register_builtin_one(symbols: SymbolTable, scopes: ScopeTree, name: string, param_count: int):
    # Builtin list is fixed and unique — skip redef scan (was O(B²)).
    sym = SymbolNode (
        kind: SymbolKind.Builtin,
        name_id: name as i64,
        type_id: 0,
        scope_id: 0,
        ast_id: 0,
        is_mutable: false,
        offset: 0,
        param_count: param_count,
        return_type: 0,
        parent_id: -1
    )
    sym_id = symbol_alloc(symbols, sym)
    scope_add_symbol(scopes, 0, sym_id)
    pass2_index_symbol(0, name, sym_id)
    out sym_id
end.
func pass2_walk_node(symbols: SymbolTable, scopes: ScopeTree, diag: DiagnosticEngine, node: AstNode):
    var child = node
    var child_count = 0

    if node.node_type == AstType.BindAttr do
        child_count = vec_len_rt(node.children)
        if child_count > 0 do
            child = vec_get_rt(node.children, 0)
            pass2_walk_node(symbols, scopes, diag, child)
        end
        out 0
    end

    if node.node_type == AstType.FuncDef do
        # Children: params*, body Block, optional Ensure/Revert.
        child_count = vec_len_rt(node.children)
        body_idx = child_count - 1
        if body_idx < 0 do
            body_idx = 0
        end
        var bi = 0
        when bi < child_count loop
            ch = vec_get_rt(node.children, bi)
            if ch.node_type == AstType.Block do
                body_idx = bi
                bi = child_count
            else
                bi = bi + 1
            end
        end
        pc = body_idx
        if pc < 0 do
            pc = 0
        end
        sym_id = pass2_register(symbols, scopes, diag, node.name, SymbolKind.Func, node.line)
        if sym_id > 0 do
            syms_vec = native_read_i64(symbols as i64, 0)
            sym = vec_get_rt(syms_vec, sym_id)
            native_write_i64(sym as i64, 32, node as i64)
            native_write_i64(sym as i64, 56, pc as i64)
        end
        # Only harvest nested `extern func` (do not promote body locals to globals).
        var j = body_idx
        when j < child_count loop
            pass2_collect_nested_extern(symbols, scopes, diag, vec_get_rt(node.children, j))
            j = j + 1
        end
        out 0
    end

    if node.node_type == AstType.EntityDef or node.node_type == AstType.PackedDef or node.node_type == AstType.RegisterDef do
        pass2_register(symbols, scopes, diag, node.name, SymbolKind.Entity, node.line)
        ent_id = pass2_register(symbols, scopes, diag, node.name, SymbolKind.Entity, node.line)
        if ent_id > 0 do
            syms_vec = native_read_i64(symbols as i64, 0)
            ent_sym = vec_get_rt(syms_vec, ent_id)
            native_write_i64(ent_sym as i64, 32, node as i64)
        end
        scope_push(scopes, ScopeKind.Entity)
        child_count = vec_len_rt(node.children)
        var i = 0
        when i < child_count loop
            child = vec_get_rt(node.children, i)
            if child.node_type == AstType.VarDecl or child.node_type == AstType.Identifier do
                f_id = pass2_register(symbols, scopes, diag, child.name, SymbolKind.Variable, child.line)
                if f_id > 0 do
                    syms_vec2 = native_read_i64(symbols as i64, 0)
                    f_sym = vec_get_rt(syms_vec2, f_id)
                    native_write_i64(f_sym as i64, 32, child as i64)
                    native_write_i64(f_sym as i64, 72, ent_id as i64)
                end
            end
            if child.node_type == AstType.FuncDef do
                m_count = vec_len_rt(child.children)
                m_pc = m_count - 1
                if m_pc < 0 do
                    m_pc = 0
                end
                m_id = pass2_register(symbols, scopes, diag, child.name, SymbolKind.Method, child.line)
                if m_id > 0 do
                    syms_vec2 = native_read_i64(symbols as i64, 0)
                    m_sym = vec_get_rt(syms_vec2, m_id)
                    native_write_i64(m_sym as i64, 32, child as i64)
                    native_write_i64(m_sym as i64, 56, m_pc as i64)
                    native_write_i64(m_sym as i64, 72, ent_id as i64)
                end
            end
            i = i + 1
        end
        scope_pop(scopes)
        out 0
    end

    if node.node_type == AstType.EnumDef do
        pass2_register(symbols, scopes, diag, node.name, SymbolKind.Enum, node.line)
        # Variants are qualified (`Enum.Variant`) and must not occupy the
        # global namespace, where names such as String/Error may be entities.
        out 0
    end

    if node.node_type == AstType.VarDecl do
        if node.int_val == 16384 do
            child_count = vec_len_rt(node.children)
            if child_count > 1 do
                var i = 0
                when i < child_count - 1 loop
                    var_ident = vec_get_rt(node.children, i)
                    pass2_register(symbols, scopes, diag, var_ident.name, SymbolKind.Variable, var_ident.line)
                    i = i + 1
                end
            end
        else
            pass2_register(symbols, scopes, diag, node.name, SymbolKind.Variable, node.line)
            sid = pass2_register(symbols, scopes, diag, node.name, SymbolKind.Variable, node.line)
            if sid != -1 do
                syms_vec = native_read_i64(symbols as i64, 0)
                sym = vec_get_rt(syms_vec, sid)
                native_write_i64(sym as i64, 32, node as i64)
            end
        end
        out 0
    end

    if node.node_type == AstType.ReactiveDecl do
        if fat_str_len(node.name) > 0 do
            pass2_register(symbols, scopes, diag, node.name, SymbolKind.Variable, node.line)
        end
        out 0
    end

    if node.node_type == AstType.BundleExpr do
        if fat_str_len(node.name) > 0 do
            pass2_register(symbols, scopes, diag, node.name, SymbolKind.Const, node.line)
        end
        out 0
    end

    if node.node_type == AstType.ExposeAttr do
        child_count = vec_len_rt(node.children)
        if child_count > 0 do
            child = vec_get_rt(node.children, 0)
            pass2_walk_node(symbols, scopes, diag, child)
        end
        out 0
    end

    if node.node_type == AstType.ConstDecl do
        if node.int_val == 16384 do
            child_count = vec_len_rt(node.children)
            if child_count > 1 do
                var i = 0
                when i < child_count - 1 loop
                    var_ident = vec_get_rt(node.children, i)
                    pass2_register(symbols, scopes, diag, var_ident.name, SymbolKind.Const, var_ident.line)
                    i = i + 1
                end
            end
        else
            pass2_register(symbols, scopes, diag, node.name, SymbolKind.Const, node.line)
        end
        out 0
    end

    if node.node_type == AstType.ExternFunc do
        if fat_str_len(node.name) > 0 do
            # Extern declarations carry a complete signature.  Count only
            # parameter children; parse_func_def_mode appends an empty Block.
            ex_pc = 0
            ex_children = vec_len_rt(node.children)
            var ex_i = 0
            when ex_i < ex_children loop
                ex_child = vec_get_rt(node.children, ex_i)
                if ex_child.node_type != AstType.Block do ex_pc = ex_pc + 1 end
                ex_i = ex_i + 1
            end
            curr_ex = scope_current_id(scopes)
            existed = pass2_lookup_name_in_scope(symbols, scopes, curr_ex, node.name)
            sym_id = pass2_register(symbols, scopes, diag, node.name, SymbolKind.Func, node.line)
            if existed == -1 and sym_id > 0 do
                syms_ex = native_read_i64(symbols as i64, 0)
                ex_sym = vec_get_rt(syms_ex, sym_id)
                native_write_i64(ex_sym as i64, 32, node as i64)
                native_write_i64(ex_sym as i64, 56, ex_pc)
            end
        end
        out 0
    end

    if node.node_type == AstType.ShareDecl or node.node_type == AstType.HasDecl do
        if fat_str_len(node.name) > 0 do
            pass2_register(symbols, scopes, diag, node.name, SymbolKind.Variable, node.line)
        end
        out 0
    end

    # Recurse into block/program children
    child_count = vec_len_rt(node.children)
    var i = 0
    when i < child_count loop
        child = vec_get_rt(node.children, i)
        pass2_walk_node(symbols, scopes, diag, child)
        i = i + 1
    end
    out 0
end.

# Walk a function body solely for nested `extern func` declarations.
func pass2_collect_nested_extern(symbols: SymbolTable, scopes: ScopeTree, diag: DiagnosticEngine, node: AstNode):
    if node.node_type == AstType.ExternFunc do
        if fat_str_len(node.name) > 0 do
            ex_pc = 0
            ex_children = vec_len_rt(node.children)
            var ex_i = 0
            when ex_i < ex_children loop
                ex_child = vec_get_rt(node.children, ex_i)
                if ex_child.node_type != AstType.Block do ex_pc = ex_pc + 1 end
                ex_i = ex_i + 1
            end
            curr_ex = scope_current_id(scopes)
            existed = pass2_lookup_name_in_scope(symbols, scopes, curr_ex, node.name)
            sym_id = pass2_register(symbols, scopes, diag, node.name, SymbolKind.Func, node.line)
            if existed == -1 and sym_id > 0 do
                syms_ex = native_read_i64(symbols as i64, 0)
                ex_sym = vec_get_rt(syms_ex, sym_id)
                native_write_i64(ex_sym as i64, 32, node as i64)
                native_write_i64(ex_sym as i64, 56, ex_pc)
            end
        end
        out 0
    end
    child_count = vec_len_rt(node.children)
    var i = 0
    when i < child_count loop
        child = vec_get_rt(node.children, i)
        pass2_collect_nested_extern(symbols, scopes, diag, child)
        i = i + 1
    end
    out 0
end.

func pass2_register(symbols: SymbolTable, scopes: ScopeTree, diag: DiagnosticEngine, name: string, kind: SymbolKind, line: int):
    if fat_str_len(name) == 0 do
        out 0
    end
    curr_scope = scope_current_id(scopes)
    # Check redefinition in current scope (hash bucket — avg O(1))
    found = pass2_lookup_name_in_scope(symbols, scopes, curr_scope, name)
    if found != -1 do
        syms_vec = native_read_i64(symbols as i64, 0)
        old_sym = vec_get_rt(syms_vec, found)
        old_kind = native_read_i64(old_sym as i64, 0)
        if old_kind == SymbolKind.Builtin do
            # User/extern definition replaces builtin kind; keep arity.
            native_write_i64(old_sym as i64, 0, kind as i64)
            out found
        end
        # Expanded/multi-include: identical redeclare is idempotent (extern+func,
        # duplicate consts across modules). Keep the first symbol.
        if old_kind == kind do
            out found
        end
        if old_kind == SymbolKind.Func and kind == SymbolKind.Func do
            out found
        end
        report_error(diag, 1001, line, 0)
        out found
    end
    # Create and register symbol
    sym = SymbolNode (
        kind: kind,
        name_id: name as i64,
        type_id: 0,
        scope_id: curr_scope,
        ast_id: 0,
        is_mutable: kind == SymbolKind.Variable,
        offset: 0,
        param_count: 0,
        return_type: 0,
        parent_id: -1
    )
    sym_id = symbol_alloc(symbols, sym)
    scope_add_symbol(scopes, curr_scope, sym_id)
    pass2_index_symbol(curr_scope, name, sym_id)
    out sym_id
end.
func pass2_lookup_name_in_scope(symbols: SymbolTable, scopes: ScopeTree, scope_id: int, name: string):
    if fat_str_len(name) == 0 do
        out -1
    end
    pass2_ensure_scope_map(scope_id)
    buckets = vec_get_rt(g_pass2_scope_maps, scope_id)
    bid = pass2_hash_name(name)
    bucket = vec_get_rt(buckets, bid)
    count = vec_len_rt(bucket)
    syms_vec = native_read_i64(symbols as i64, 0)
    var i = 0
    when i < count loop
        sym_id = vec_get_rt(bucket, i)
        sym = vec_get_rt(syms_vec, sym_id)
        sym_name = native_read_i64(sym as i64, 8) as string
        if fat_str_eq(sym_name, name) == 1 do
            out sym_id
        end
        i = i + 1
    end
    out -1
end.

export pass2_register_symbols

# @vir_source stdlib/vir/compiler/semantic.vri 40
import pass2_register_symbols from compiler.sem_pass2_symbols

# @vir_source stdlib/vir/compiler/sem_pass3_names.vri 1
##
 * vir/compiler/sem_pass3_names.vri
 * ==============================================================
 * Pass 3: Name Resolution (Vir v2.0 Complete).
 * Resolves identifier references, function calls, method calls,
 * builtin calls, and enum access to their declaring symbols.
 ##

import vec_new_rt, vec_push_rt, vec_get_rt, vec_len_rt from vec_rt

import rt_streq, fat_str_eq, fat_str_len, fat_cstr_eq, fat_str_new, rt_strcat, rt_itoa, rt_strlen from string_rt

import AstNode, AstType from parser

import SymbolTable, SymbolKind, SymbolNode, symbol_alloc from symbol_table

import ScopeTree, ScopeKind, ScopeNode, scope_push, scope_pop, scope_add_symbol, scope_current_id from scope_tree

import DiagnosticEngine, report_error from context

import print_str, print_int, print_newline from io

import vir_alloc from alloc

# Name resolution used to scan every symbol in the global scope for every
# identifier.  A self-host build has thousands of globals and tens of
# thousands of references, making pass 3 effectively O(refs * globals).
# Keep scope-local lookup linear (local scopes are small), but index the
# global scope once before walking the AST.
const PASS3_GLOBAL_BUCKETS: int = 4096
const PASS3_GLOBAL_BUCKET_MASK: int = 4095
var g_pass3_global_heads: i64 = 0
var g_pass3_global_next: i64 = 0
var g_pass3_global_indexed_count: i64 = 0

func pass3_name_bucket(name: string):
    n = fat_str_len(name)
    if n <= 0 do
        out 0
    end
    data = native_read_i64(name as i64, 0)
    h = n and PASS3_GLOBAL_BUCKET_MASK
    var i = 0
    when i < n loop
        h = (h * 131 + native_read_u8(data, i)) and PASS3_GLOBAL_BUCKET_MASK
        i = i + 1
    end
    out h
end.

func pass3_build_global_index(symbols: SymbolTable, scopes: ScopeTree):
    if g_pass3_global_heads == 0 do
        g_pass3_global_heads = vir_alloc(PASS3_GLOBAL_BUCKETS * 8)
    end

    var i = 0
    when i < PASS3_GLOBAL_BUCKETS loop
        native_write_i64(g_pass3_global_heads, i * 8, 0)
        i = i + 1
    end

    scopes_vec = native_read_i64(scopes as i64, 0)
    global_scope = vec_get_rt(scopes_vec, 0)
    global_syms = native_read_i64(global_scope as i64, 16)
    count = vec_len_rt(global_syms)
    # semantic_run invokes pass 3 once.  Allocate the exact chain array for
    # that snapshot; symbols added later use the small linear tail fallback.
    if count > 0 do
        g_pass3_global_next = vir_alloc(count * 8)
    else
        g_pass3_global_next = 0
    end
    g_pass3_global_indexed_count = count

    syms_vec = native_read_i64(symbols as i64, 0)
    i = 0
    when i < count loop
        sym_id = vec_get_rt(global_syms, i)
        sym = vec_get_rt(syms_vec, sym_id)
        sym_name = native_read_i64(sym as i64, 8) as string
        bucket = pass3_name_bucket(sym_name)
        head = native_read_i64(g_pass3_global_heads, bucket * 8)
        native_write_i64(g_pass3_global_next, i * 8, head)
        native_write_i64(g_pass3_global_heads, bucket * 8, i + 1)
        i = i + 1
    end
end.

func pass3_lookup_global(symbols: SymbolTable, scopes: ScopeTree, name: string):
    if fat_str_len(name) == 0 do
        out -1
    end
    scopes_vec = native_read_i64(scopes as i64, 0)
    global_scope = vec_get_rt(scopes_vec, 0)
    global_syms = native_read_i64(global_scope as i64, 16)
    syms_vec = native_read_i64(symbols as i64, 0)

    if g_pass3_global_heads != 0 and g_pass3_global_next != 0 do
        bucket = pass3_name_bucket(name)
        link = native_read_i64(g_pass3_global_heads, bucket * 8)
        when link > 0 loop
            pos = link - 1
            sym_id = vec_get_rt(global_syms, pos)
            sym = vec_get_rt(syms_vec, sym_id)
            sym_name = native_read_i64(sym as i64, 8) as string
            if fat_str_eq(sym_name, name) == 1 do
                out sym_id
            end
            link = native_read_i64(g_pass3_global_next, pos * 8)
        end
    end

    # Normally empty: declarations handled by pass 2 are already indexed.
    # Preserve correctness for a declaration kind added by pass 3 itself.
    count = vec_len_rt(global_syms)
    var i = g_pass3_global_indexed_count
    when i < count loop
        sym_id = vec_get_rt(global_syms, i)
        sym = vec_get_rt(syms_vec, sym_id)
        sym_name = native_read_i64(sym as i64, 8) as string
        if fat_str_eq(sym_name, name) == 1 do
            out sym_id
        end
        i = i + 1
    end
    out -1
end.

func is_builtin_method_name(name: i64):
    if name == 0 do out 0 end
    if fat_cstr_eq(name, "send") or fat_cstr_eq(name, "recv") or fat_cstr_eq(name, "push") or fat_cstr_eq(name, "pop") or fat_cstr_eq(name, "len") do out 1 end
    if rt_streq(name as int, "send") or rt_streq(name as int, "recv") or rt_streq(name as int, "push") or rt_streq(name as int, "pop") or rt_streq(name as int, "len") do out 1 end
    out 0
end.

func pass3_is_soft_call_name(name: string):
    if fat_str_len(name) == 0 do
        out 0
    end
    nm = name as i64
    if fat_str_len(name) >= 7 do
        data = native_read_i64(nm, 0)
        if native_read_u8(data, 0) == 110 and native_read_u8(data, 1) == 97 and native_read_u8(data, 2) == 116 and native_read_u8(data, 3) == 105 and native_read_u8(data, 4) == 118 and native_read_u8(data, 5) == 101 and native_read_u8(data, 6) == 95 do
            out 1
        end
    end
    if fat_cstr_eq(nm, "panic") or fat_cstr_eq(nm, "free") or fat_cstr_eq(nm, "realloc") or fat_cstr_eq(nm, "size_of") or fat_cstr_eq(nm, "alloc") or fat_cstr_eq(nm, "min") or fat_cstr_eq(nm, "max") or fat_cstr_eq(nm, "to_string") or fat_cstr_eq(nm, "utf8_decode_char") or fat_cstr_eq(nm, "vec_set_at") or fat_cstr_eq(nm, "str_from_i64") or fat_cstr_eq(nm, "codebuf_get_data") or fat_cstr_eq(nm, "read_u32") or fat_cstr_eq(nm, "patch_u32") or fat_cstr_eq(nm, "patch_i32") or fat_cstr_eq(nm, "eprintln") or fat_cstr_eq(nm, "read") or fat_cstr_eq(nm, "write") or fat_cstr_eq(nm, "_next_pow2") or fat_cstr_eq(nm, "alloc_zeroed") or fat_cstr_eq(nm, "float_to_bits") or fat_cstr_eq(nm, "wf_emit_sleb128") or fat_cstr_eq(nm, "map_set") or fat_cstr_eq(nm, "write_bytes_to_file") do
        out 1
    end
    out 0
end.

func pass3_register_pattern_binders(symbols: SymbolTable, scopes: ScopeTree, diag: DiagnosticEngine, pat: AstNode):
    if pat.node_type == AstType.Identifier do
        child_count = vec_len_rt(pat.children)
        if child_count > 0 do
            # Tagged patterns are encoded as an Identifier constructor with
            # binder identifiers as children: Some(p), Ok(v), Err(e).
            var i = 0
            when i < child_count loop
                child = vec_get_rt(pat.children, i)
                pass3_register_pattern_binders(symbols, scopes, diag, child)
                i = i + 1
            end
            out 0
        end
        if not fat_str_eq(pat.name, fat_str_new("_")) and not fat_str_eq(pat.name, fat_str_new("true")) and not fat_str_eq(pat.name, fat_str_new("false")) and not fat_str_eq(pat.name, fat_str_new("None")) and not fat_str_eq(pat.name, fat_str_new("null")) do
            found = pass3_lookup_chain(symbols, scopes, 0, pat.name)
            if found == -1 do
                pass3_register_local(symbols, scopes, pat.name, SymbolKind.Variable, pat.line)
            end
        end
        out 0
    end
    if pat.node_type == AstType.Call or pat.node_type == AstType.TupleExpr or pat.node_type == AstType.ArrayLiteral do
        child_count = vec_len_rt(pat.children)
        var i = 0
        when i < child_count loop
            child = vec_get_rt(pat.children, i)
            pass3_register_pattern_binders(symbols, scopes, diag, child)
            i = i + 1
        end
    end
    out 0
end.

func pass3_resolve_names(symbols: SymbolTable, scopes: ScopeTree, diag: DiagnosticEngine, node: AstNode):
    pass3_build_global_index(symbols, scopes)
    pass3_walk(symbols, scopes, diag, node)
end.
func pass3_walk(symbols: SymbolTable, scopes: ScopeTree, diag: DiagnosticEngine, node: AstNode):

    if node.node_type == AstType.Identifier do
        nm = node.name as i64
        if fat_cstr_eq(nm, "null") or fat_cstr_eq(nm, "void") or fat_cstr_eq(nm, "true") or fat_cstr_eq(nm, "false") or fat_cstr_eq(nm, "None") do
            out 0
        end
        found = pass3_lookup_chain(symbols, scopes, scope_current_id(scopes), node.name)
        if found == -1 do
            # `this` in a method body: register if the parser used ThisKw.
            if fat_cstr_eq(nm, "this") == 1 do
                pass3_register_local(symbols, scopes, fat_str_new("this"), SymbolKind.Param, node.line)
            else
                report_error(diag, 2001, node.line, 0)
            end
        end
        out 0
    end

    if node.node_type == AstType.BuiltinCall do
        # Parser already bound builtin_id; do not require a symbol name
        # (ast_add_child can clobber .name on the soft ABI).
        child_count = vec_len_rt(node.children)
        var i = 0
        when i < child_count loop
            child = vec_get_rt(node.children, i)
            pass3_walk(symbols, scopes, diag, child)
            i = i + 1
        end
        out 0
    end

    if node.node_type == AstType.Call do
        found = pass3_lookup_chain(symbols, scopes, scope_current_id(scopes), node.name)
        if found == -1 and pass3_is_soft_call_name(node.name) == 0 do
            report_error(diag, 1003, node.line, 0)
        end
        # Resolve arguments
        child_count = vec_len_rt(node.children)
        var i = 0
        when i < child_count loop
            child = vec_get_rt(node.children, i)
            pass3_walk(symbols, scopes, diag, child)
            i = i + 1
        end
        out 0
    end

    if node.node_type == AstType.MethodCall do
        # UFCS / Callable field: receiver is children[0]. Missing free function
        # is allowed because callable record fields lower dynamically.
        found = pass3_lookup_chain(symbols, scopes, scope_current_id(scopes), node.name)
        if found == -1 do
            found = pass3_lookup_chain(symbols, scopes, 0, node.name)
        end
        child_count = vec_len_rt(node.children)
        if child_count > 0 do
            receiver = vec_get_rt(node.children, 0)
            pass3_walk(symbols, scopes, diag, receiver)
        end
        # Resolve method arguments
        var i = 1
        when i < child_count loop
            child = vec_get_rt(node.children, i)
            pass3_walk(symbols, scopes, diag, child)
            i = i + 1
        end
        out 0
    end

    if node.node_type == AstType.BindAttr do
        child_count = vec_len_rt(node.children)
        if child_count > 0 do
            child = vec_get_rt(node.children, 0)
            pass3_walk(symbols, scopes, diag, child)
        end
        out 0
    end

    if node.node_type == AstType.EntityDef or node.node_type == AstType.PackedDef or node.node_type == AstType.RegisterDef or node.node_type == AstType.EnumDef or node.node_type == AstType.ExternFunc do
        out 0
    end

    if node.node_type == AstType.EntityLiteral do
        child_count = vec_len_rt(node.children)
        var i = 0
        when i < child_count loop
            child = vec_get_rt(node.children, i)
            pass3_walk(symbols, scopes, diag, child)
            i = i + 1
        end
        out 0
    end

    if node.node_type == AstType.FieldAccess do
        child_count = vec_len_rt(node.children)
        var i = 0
        when i < child_count loop
            child = vec_get_rt(node.children, i)
            pass3_walk(symbols, scopes, diag, child)
            i = i + 1
        end
        out 0
    end

    if node.node_type == AstType.EnumAccess do
        found = pass3_lookup_chain(symbols, scopes, scope_current_id(scopes), node.name)
        if found == -1 do
            # Could be a qualified lookup, we try to resolve parts if needed
            # But for simplicity, logging it if totally not found globally
            report_error(diag, 1005, node.line, 0)
        end
        out 0
    end

    if node.node_type == AstType.CaseExpr do
        child_count = vec_len_rt(node.children)
        if child_count > 0 do
            # 1. Walk target expression
            target = vec_get_rt(node.children, 0)
            pass3_walk(symbols, scopes, diag, target)

            # 2. Walk each arm: [pat, body, pat, body, ...]
            var i = 1
            when i + 1 < child_count loop
                pat = vec_get_rt(node.children, i)
                body = vec_get_rt(node.children, i + 1)

                old_scope = scope_current_id(scopes)
                scope_id = scope_push(scopes, ScopeKind.Block)

                pass3_register_pattern_binders(symbols, scopes, diag, pat)
                pass3_walk(symbols, scopes, diag, body)
                scope_pop(scopes)
                i = i + 2
            end
        end
        out 0
    end
    
    if node.node_type == AstType.WhenStmt do
        old_scope = scope_current_id(scopes)
        scope_id = scope_push(scopes, ScopeKind.Block)
        if fat_str_len(node.name) > 0 do
            pass3_register_local(symbols, scopes, node.name, SymbolKind.Variable, node.line)
        end
        child_count = vec_len_rt(node.children)
        var i = 0
        when i < child_count loop
            child = vec_get_rt(node.children, i)
            pass3_walk(symbols, scopes, diag, child)
            i = i + 1
        end
        scope_pop(scopes)
        out 0
    end

    if node.node_type == AstType.FuncDef do
        # Push function scope for body
        old_scope = scope_current_id(scopes)
        scope_id = scope_push(scopes, ScopeKind.Func)
        # Children: params*, body Block, optional Ensure/Revert.
        child_count = vec_len_rt(node.children)
        body_idx = child_count - 1
        if body_idx < 0 do
            body_idx = 0
        end
        var bi = 0
        when bi < child_count loop
            ch = vec_get_rt(node.children, bi)
            if ch.node_type == AstType.Block do
                body_idx = bi
                bi = child_count
            else
                bi = bi + 1
            end
        end
        var i = 0
        when i < body_idx loop
            param = vec_get_rt(node.children, i)
            pass3_register_local(symbols, scopes, param.name, SymbolKind.Param, param.line)
            i = i + 1
        end
        var j = body_idx
        when j < child_count loop
            child = vec_get_rt(node.children, j)
            pass3_walk(symbols, scopes, diag, child)
            j = j + 1
        end
        scope_pop(scopes)
        out 0
    end

    if node.node_type == AstType.Block do
        old_scope = scope_current_id(scopes)
        scope_id = scope_push(scopes, ScopeKind.Block)
        child_count = vec_len_rt(node.children)
        var i = 0
        when i < child_count loop
            child = vec_get_rt(node.children, i)
            pass3_walk(symbols, scopes, diag, child)
            i = i + 1
        end
        scope_pop(scopes)
        out 0
    end

    if node.node_type == AstType.TryStmt do
        # `err` is an implicit variable bound to the thrown value inside the
        # revert handler. Register it for the whole try/revert scope.
        old_scope = scope_current_id(scopes)
        scope_id = scope_push(scopes, ScopeKind.Block)
        pass3_register_local(symbols, scopes, fat_str_new("err"), SymbolKind.Variable, node.line)
        child_count = vec_len_rt(node.children)
        var i = 0
        when i < child_count loop
            child = vec_get_rt(node.children, i)
            pass3_walk(symbols, scopes, diag, child)
            i = i + 1
        end
        scope_pop(scopes)
        out 0
    end

    if node.node_type == AstType.VarDecl or node.node_type == AstType.ConstDecl or node.node_type == AstType.ReactiveDecl do
        is_mut = node.node_type == AstType.VarDecl or node.node_type == AstType.ReactiveDecl
        if node.int_val == 16384 do
            child_count = vec_len_rt(node.children)
            if child_count > 0 do
                # 1. Resolve initializer (last child)
                init_child = vec_get_rt(node.children, child_count - 1)
                pass3_walk(symbols, scopes, diag, init_child)
                # 2. Register destructure variable names (first child_count - 1 children)
                var i = 0
                when i < child_count - 1 loop
                    var_ident = vec_get_rt(node.children, i)
                    if is_mut do
                        pass3_register_local(symbols, scopes, var_ident.name, SymbolKind.Variable, var_ident.line)
                    else
                        pass3_register_local(symbols, scopes, var_ident.name, SymbolKind.Const, var_ident.line)
                    end
                    i = i + 1
                end
            end
        else
            # First resolve initializer, then register the name
            child_count = vec_len_rt(node.children)
            var i = 0
            when i < child_count loop
                child = vec_get_rt(node.children, i)
                pass3_walk(symbols, scopes, diag, child)
                i = i + 1
            end
            if is_mut do
                pass3_register_local(symbols, scopes, node.name, SymbolKind.Variable, node.line)
            else
                pass3_register_local(symbols, scopes, node.name, SymbolKind.Const, node.line)
            end
        end
        out 0
    end

    if node.node_type == AstType.BundleExpr do
        child_count = vec_len_rt(node.children)
        var i = 0
        when i < child_count loop
            child = vec_get_rt(node.children, i)
            pass3_walk(symbols, scopes, diag, child)
            i = i + 1
        end
        if fat_str_len(node.name) > 0 do
            pass3_register_local(symbols, scopes, node.name, SymbolKind.Const, node.line)
        end
        out 0
    end

    if node.node_type == AstType.ExposeAttr do
        child_count = vec_len_rt(node.children)
        if child_count > 0 do
            child = vec_get_rt(node.children, 0)
            pass3_walk(symbols, scopes, diag, child)
        end
        out 0
    end

    if node.node_type == AstType.ShareDecl or node.node_type == AstType.HasDecl do
        if fat_str_len(node.name) > 0 do
            pass3_register_local(symbols, scopes, node.name, SymbolKind.Variable, node.line)
        end
        out 0
    end

    # Implicit locals: Vir allows `x = expr` without prior `var`/`let`.
    # LHS lives on node.name; children are RHS only (see parse_stmt Assign).
    if node.node_type == AstType.Assign do
        if fat_str_len(node.name) > 0 do
            found = pass3_lookup_chain(symbols, scopes, scope_current_id(scopes), node.name)
            if found == -1 do
                pass3_register_implicit_local(symbols, scopes, node.name, SymbolKind.Variable, node.line)
            end
        end
        child_count = vec_len_rt(node.children)
        if child_count >= 2 do
            lhs = vec_get_rt(node.children, 0)
            if lhs.node_type == AstType.TupleExpr do
                pass3_register_pattern_binders(symbols, scopes, diag, lhs)
            end
        end
        var i = 0
        when i < child_count loop
            child = vec_get_rt(node.children, i)
            pass3_walk(symbols, scopes, diag, child)
            i = i + 1
        end
        out 0
    end

    # for i in lo..hi: register loop binder before walking the body.
    if node.node_type == AstType.ForRange do
        child_count = vec_len_rt(node.children)
        if child_count >= 1 do
            pass3_walk(symbols, scopes, diag, vec_get_rt(node.children, 0))
        end
        if child_count >= 2 do
            pass3_walk(symbols, scopes, diag, vec_get_rt(node.children, 1))
        end
        scope_push(scopes, ScopeKind.Loop)
        if fat_str_len(node.name) > 0 do
            pass3_register_local(symbols, scopes, node.name, SymbolKind.Variable, node.line)
        end
        if child_count >= 3 do
            pass3_walk(symbols, scopes, diag, vec_get_rt(node.children, 2))
        end
        scope_pop(scopes)
        out 0
    end

    # Default: recurse into children
    child_count = vec_len_rt(node.children)
    var i = 0
    when i < child_count loop
        child = vec_get_rt(node.children, i)
        pass3_walk(symbols, scopes, diag, child)
        i = i + 1
    end
    out 0
end.
func pass3_lookup_chain(symbols: SymbolTable, scopes: ScopeTree, start_scope: int, name: string):
    if fat_str_len(name) == 0 do
        out -1
    end
    curr = start_scope
    scopes_vec = native_read_i64(scopes as i64, 0)
    syms_vec = native_read_i64(symbols as i64, 0)
    when curr >= 0 loop
        if curr == 0 do
            out pass3_lookup_global(symbols, scopes, name)
        end
        scope_node = vec_get_rt(scopes_vec, curr)
        sym_list = native_read_i64(scope_node as i64, 16)
        count = vec_len_rt(sym_list)
        var i = 0
        when i < count loop
            sym_id = vec_get_rt(sym_list, i)
            sym = vec_get_rt(syms_vec, sym_id)
            sym_name = native_read_i64(sym as i64, 8) as string
            if fat_str_eq(sym_name, name) == 1 do
                out sym_id
            end
            i = i + 1
        end
        curr = native_read_i64(scope_node as i64, 8)
    end
    out -1
end.
func pass3_enclosing_func_scope(scopes: ScopeTree, curr_scope: int):
    if curr_scope <= 0 do
        out curr_scope
    end
    scopes_vec = native_read_i64(scopes as i64, 0)
    var s = curr_scope
    when s > 0 loop
        scope_node = vec_get_rt(scopes_vec, s)
        skind = native_read_i64(scope_node as i64, 0)
        if skind == ScopeKind.Func do
            out s
        end
        s = native_read_i64(scope_node as i64, 8)
    end
    out curr_scope
end.

func pass3_register_local(symbols: SymbolTable, scopes: ScopeTree, name: string, kind: SymbolKind, line: int):
    if fat_str_len(name) == 0 do
        out 0
    end
    curr_scope = scope_current_id(scopes)
    # Pass 2 already registered top-level declarations.  Registering them a
    # second time here both changed shadowing behaviour and enlarged the hot
    # global lookup set while pass 3 was running.
    if curr_scope == 0 do
        found = pass3_lookup_global(symbols, scopes, name)
        if found != -1 do
            out found
        end
    end
    sym = SymbolNode (
        kind: kind,
        name_id: name as i64,
        type_id: 0,
        scope_id: curr_scope,
        ast_id: 0,
        is_mutable: kind == SymbolKind.Variable or kind == SymbolKind.Param,
        offset: 0,
        param_count: 0,
        return_type: 0,
        parent_id: -1
    )
    sym_id = symbol_alloc(symbols, sym)
    scope_add_symbol(scopes, curr_scope, sym_id)
    out sym_id
end.

func pass3_register_implicit_local(symbols: SymbolTable, scopes: ScopeTree, name: string, kind: SymbolKind, line: int):
    curr_scope = scope_current_id(scopes)
    sym_id = pass3_register_local(symbols, scopes, name, kind, line)
    func_scope = pass3_enclosing_func_scope(scopes, curr_scope)
    if sym_id > 0 and func_scope != curr_scope do
        scope_add_symbol(scopes, func_scope, sym_id)
    end
    out sym_id
end.

export pass3_resolve_names

# @vir_source stdlib/vir/compiler/semantic.vri 43
import pass3_resolve_names from compiler.sem_pass3_names

# @vir_source stdlib/vir/compiler/sem_pass4_types.vri 1
##
 * vir/compiler/sem_pass4_types.vri
 * ==============================================================
 * Pass 4: Type Resolution (Vir v2.0 Complete).
 * Resolves all primitive and compound type annotation strings (name2)
 * to TypeKind IDs and updates symbol type_id in SymbolTable.
 ##

import vec_new_rt, vec_push_rt, vec_get_rt, vec_len_rt from vec_rt

import rt_streq, fat_str_eq, fat_str_len, fat_cstr_eq, fat_str_eq, fat_str_len, fat_cstr_eq, rt_strcat, rt_itoa, rt_strlen from string_rt

import AstNode, AstType from parser

import SymbolTable, SymbolKind, SymbolNode, symbol_alloc from symbol_table

import ScopeTree, ScopeKind, ScopeNode, scope_push, scope_pop, scope_add_symbol from scope_tree

import TypeKind, TYPE_VOID, TYPE_INT, TYPE_FLOAT, TYPE_BOOL, TYPE_STRING, is_tensor_type_str from type_table

import print_str, print_int, print_newline from io

func pass4_resolve_types(symbols: SymbolTable, scopes: ScopeTree, node: AstNode):
    pass4_walk(symbols, scopes, node)
end.
func pass4_resolve_type_name(name: string):
    if fat_str_len(name) == 0 do
        out TypeKind.Void
    end
    # Primitive types
    if fat_cstr_eq(name, "int") == 1 do out TypeKind.Int end
    if fat_cstr_eq(name, "i8") == 1 do out TypeKind.Int end
    if fat_cstr_eq(name, "i16") == 1 do out TypeKind.Int end
    if fat_cstr_eq(name, "i32") == 1 do out TypeKind.Int end
    if fat_cstr_eq(name, "i64") == 1 do out TypeKind.Int end
    if fat_cstr_eq(name, "uint") == 1 do out TypeKind.Int end
    if fat_cstr_eq(name, "u8") == 1 do out TypeKind.Int end
    if fat_cstr_eq(name, "u16") == 1 do out TypeKind.Int end
    if fat_cstr_eq(name, "u32") == 1 do out TypeKind.Int end
    if fat_cstr_eq(name, "u64") == 1 do out TypeKind.Int end
    if fat_cstr_eq(name, "float") == 1 do out TypeKind.Float end
    if fat_cstr_eq(name, "f32") == 1 do out TypeKind.Float end
    if fat_cstr_eq(name, "f64") == 1 do out TypeKind.Float end
    if fat_cstr_eq(name, "bool") == 1 do out TypeKind.Bool end
    if fat_cstr_eq(name, "string") == 1 do out TypeKind.String end
    if fat_cstr_eq(name, "ptr") == 1 do out TypeKind.Pointer end
    if fat_cstr_eq(name, "any") == 1 do out TypeKind.Void end

    # Compound & Advanced Vir Types (§4.1 - §4.5, §26.1)
    if is_tensor_type_str(name) do out TypeKind.Tensor end
    if fat_cstr_eq(name, "tensor") == 1 do out TypeKind.Tensor end
    if fat_cstr_eq(name, "array") == 1 do out TypeKind.Array end
    if fat_cstr_eq(name, "dict") == 1 do out TypeKind.Dict end
    if fat_cstr_eq(name, "tuple") == 1 do out TypeKind.Tuple end
    if fat_cstr_eq(name, "ref") == 1 or fat_cstr_eq(name, "&") == 1 do out TypeKind.Ref end
    if fat_cstr_eq(name, "mutref") == 1 or fat_cstr_eq(name, "&mut") == 1 do out TypeKind.MutRef end
    if fat_cstr_eq(name, "register") == 1 do out TypeKind.Register end
    if fat_cstr_eq(name, "mold") == 1 do out TypeKind.Mold end
    if fat_cstr_eq(name, "packed") == 1 do out TypeKind.Packed end
    if fat_cstr_eq(name, "flux") == 1 do out TypeKind.Flux end
    if fat_cstr_eq(name, "deck") == 1 do out TypeKind.Deck end
    if fat_cstr_eq(name, "optional") == 1 or fat_cstr_eq(name, "option") == 1 do out TypeKind.Optional end

    out TypeKind.Entity
end.
func pass4_walk(symbols: SymbolTable, scopes: ScopeTree, node: AstNode):
    if node as i64 == 0 do
        out 0
    end

    if node.node_type == AstType.VarDecl or node.node_type == AstType.ConstDecl do
        if fat_str_len(node.name2) > 0 do
            resolved = pass4_resolve_type_name(node.name2)
            pass4_update_symbol_type(symbols, scopes, node.name, resolved, node)
        end
        child_count = vec_len_rt(node.children)
        var i = 0
        when i < child_count loop
            child = vec_get_rt(node.children, i)
            pass4_walk(symbols, scopes, child)
            i = i + 1
        end
        out 0
    end

    if node.node_type == AstType.FuncDef do
        if fat_str_len(node.name2) > 0 do
            ret_type = pass4_resolve_type_name(node.name2)
            pass4_update_func_return(symbols, scopes, node.name, ret_type)
        end
        scope_push(scopes, ScopeKind.Func)
        child_count = vec_len_rt(node.children)
        body_idx = child_count - 1
        if body_idx < 0 do
            body_idx = 0
        end
        var bi = 0
        when bi < child_count loop
            ch = vec_get_rt(node.children, bi)
            if ch.node_type == AstType.Block do
                body_idx = bi
                bi = child_count
            else
                bi = bi + 1
            end
        end
        var i = 0
        when i < body_idx loop
            param = vec_get_rt(node.children, i)
            if fat_str_len(param.name2) > 0 do
                param_type = pass4_resolve_type_name(param.name2)
                pass4_update_symbol_type(symbols, scopes, param.name, param_type, param)
            end
            i = i + 1
        end
        var j = body_idx
        when j < child_count loop
            child = vec_get_rt(node.children, j)
            pass4_walk(symbols, scopes, child)
            j = j + 1
        end
        scope_pop(scopes)
        out 0
    end

    if node.node_type == AstType.ExternFunc do
        ret_type = pass4_resolve_type_name(node.name2)
        pass4_update_func_return(symbols, scopes, node.name, ret_type)
        pass4_update_func_ast(symbols, scopes, node.name, node)
        out 0
    end

    if node.node_type == AstType.EntityDef or node.node_type == AstType.PackedDef or node.node_type == AstType.RegisterDef do
        child_count = vec_len_rt(node.children)
        var i = 0
        when i < child_count loop
            field = vec_get_rt(node.children, i)
            if fat_str_len(field.name2) > 0 do
                field_type = pass4_resolve_type_name(field.name2)
            end
            i = i + 1
        end
        out 0
    end

    if node.node_type == AstType.Block do
        scope_push(scopes, ScopeKind.Block)
        child_count = vec_len_rt(node.children)
        var i = 0
        when i < child_count loop
            child = vec_get_rt(node.children, i)
            pass4_walk(symbols, scopes, child)
            i = i + 1
        end
        scope_pop(scopes)
        out 0
    end

    # Default: recurse
    child_count = vec_len_rt(node.children)
    var i = 0
    when i < child_count loop
        child = vec_get_rt(node.children, i)
        pass4_walk(symbols, scopes, child)
        i = i + 1
    end
    out 0
end.
func pass4_update_symbol_type(symbols: SymbolTable, scopes: ScopeTree, name: string, type_kind: TypeKind, ast_node: AstNode):
    if fat_str_len(name) == 0 do
        out 0
    end
    curr = scopes.current_id
    tbl_syms = native_read_i64(symbols as i64, 0)
    when curr >= 0 loop
        scope_node = vec_get_rt(scopes.scopes, curr)
        count = vec_len_rt(scope_node.symbols)
        var i = 0
        when i < count loop
            sym_id = vec_get_rt(scope_node.symbols, i)
            sym = vec_get_rt(tbl_syms, sym_id)
            sym_name = native_read_i64(sym as i64, 8) as string
            if fat_str_eq(sym_name, name) do
                native_write_i64(sym as i64, 16, type_kind as i64)
                native_write_i64(sym as i64, 32, ast_node as i64)
                sym.type_id = type_kind as i64
                sym.ast_id = ast_node as i64
                out 0
            end
            i = i + 1
        end
        curr = scope_node.parent_id
    end
    out 0
end.
func pass4_update_func_return(symbols: SymbolTable, scopes: ScopeTree, name: string, ret_type: TypeKind):
    if fat_str_len(name) == 0 do
        out 0
    end
    curr = scopes.current_id
    tbl_syms = native_read_i64(symbols as i64, 0)
    when curr >= 0 loop
        scope_node = vec_get_rt(scopes.scopes, curr)
        count = vec_len_rt(scope_node.symbols)
        var i = 0
        when i < count loop
            sym_id = vec_get_rt(scope_node.symbols, i)
            sym = vec_get_rt(tbl_syms, sym_id)
            sym_name = native_read_i64(sym as i64, 8) as string
            if fat_str_eq(sym_name, name) do
                native_write_i64(sym as i64, 64, ret_type as i64)
                sym.return_type = ret_type as i64
                out 0
            end
            i = i + 1
        end
        curr = scope_node.parent_id
    end
    out 0
end.

func pass4_update_func_ast(symbols: SymbolTable, scopes: ScopeTree, name: string, ast_node: AstNode):
    if fat_str_len(name) == 0 do out 0 end
    curr = scopes.current_id
    tbl_syms = native_read_i64(symbols as i64, 0)
    when curr >= 0 loop
        scope_node = vec_get_rt(scopes.scopes, curr)
        count = vec_len_rt(scope_node.symbols)
        var i = 0
        when i < count loop
            sym_id = vec_get_rt(scope_node.symbols, i)
            sym = vec_get_rt(tbl_syms, sym_id)
            sym_name = native_read_i64(sym as i64, 8) as string
            if fat_str_eq(sym_name, name) do
                native_write_i64(sym as i64, 32, ast_node as i64)
                sym.ast_id = ast_node as i64
                out 0
            end
            i = i + 1
        end
        curr = scope_node.parent_id
    end
    out 0
end.

export pass4_resolve_types, pass4_resolve_type_name

# @vir_source stdlib/vir/compiler/semantic.vri 46
import pass4_resolve_types from compiler.sem_pass4_types

# @vir_source stdlib/vir/compiler/sem_pass5_infer.vri 1
##
 * vir/compiler/sem_pass5_infer.vri
 * ==============================================================
 * Pass 5: Type Inference (Vir v2.0 Complete).
 * Infers types for variables without explicit annotations,
 * array/tuple literals, interpolated strings, method calls, and references.
 ##

import vec_new_rt, vec_push_rt, vec_get_rt, vec_len_rt, vec_set_rt from vec_rt

import rt_streq, fat_str_eq, fat_str_len, fat_str_byte_at, fat_cstr_eq, fat_str_new, rt_strcat, rt_itoa, rt_strlen from string_rt

import AstNode, AstType, OpType from parser

import SymbolTable, SymbolKind, SymbolNode, symbol_alloc from symbol_table

import ScopeTree, ScopeKind, ScopeNode, scope_push, scope_pop, scope_add_symbol, scope_current_id from scope_tree

import TypeKind, TYPE_VOID, TYPE_INT, TYPE_FLOAT, TYPE_BOOL, TYPE_STRING from type_table

# Hash ONLY global scope (id 0).  Prior passes leave thousands of orphan
# Func/Block ScopeNodes in scopes.scopes; allocating 256 buckets per id
# made rebuild O(scopes×256) vec_new — the real pass-5 hang.
const PASS5_BUCKETS: int = 256
var g_pass5_global_buckets: i64 = 0

func pass5_hash_name(name: string):
    n = fat_str_len(name)
    if n <= 0 do
        out 0
    end
    # Mix pointer + length — avoids O(len) byte reads on every lookup.
    h = (name as i64) * 131 + n * 17
    if h < 0 do
        h = 0 - h
    end
    out h mod PASS5_BUCKETS
end.

func pass5_global_map_new():
    buckets = vec_new_rt()
    var bi = 0
    when bi < PASS5_BUCKETS loop
        buckets = vec_push_rt(buckets, vec_new_rt())
        bi = bi + 1
    end
    out buckets
end.

func pass5_index_global(name: string, sym_id: int):
    if fat_str_len(name) == 0 do
        out 0
    end
    if g_pass5_global_buckets == 0 do
        g_pass5_global_buckets = pass5_global_map_new()
    end
    bid = pass5_hash_name(name)
    bucket = vec_get_rt(g_pass5_global_buckets, bid)
    bucket = vec_push_rt(bucket, sym_id)
    vec_set_rt(g_pass5_global_buckets, bid, bucket)
    out 0
end.

func pass5_rebuild_index(symbols: SymbolTable, scopes: ScopeTree):
    g_pass5_global_buckets = pass5_global_map_new()
    scopes_vec = native_read_i64(scopes as i64, 0)
    syms_vec = native_read_i64(symbols as i64, 0)
    if vec_len_rt(scopes_vec) == 0 do
        out 0
    end
    # Scope 0 only — holds builtins + top-level decls (the O(n²) hotspot).
    scope_node = vec_get_rt(scopes_vec, 0)
    sym_list = native_read_i64(scope_node as i64, 16)
    count = vec_len_rt(sym_list)
    var i = 0
    when i < count loop
        sym_id = vec_get_rt(sym_list, i)
        sym = vec_get_rt(syms_vec, sym_id)
        sym_name = native_read_i64(sym as i64, 8) as string
        pass5_index_global(sym_name, sym_id)
        i = i + 1
    end
end.

func pass5_infer_types(symbols: SymbolTable, scopes: ScopeTree, node: AstNode):
    pass5_rebuild_index(symbols, scopes)
    pass5_walk(symbols, scopes, node)
end.

func pass5_call_returns_first_arg(name: i64):
    if fat_cstr_eq(name, "ast_add_child") == 1 do out 1 end
    if fat_cstr_eq(name, "vec_push_rt") == 1 do out 1 end
    if fat_cstr_eq(name, "vec_set_rt") == 1 do out 1 end
    if fat_cstr_eq(name, "vec_push") == 1 do out 1 end
    if fat_cstr_eq(name, "ast_vec_push") == 1 do out 1 end
    if fat_cstr_eq(name, "ast_vec_bump_new") == 1 do out 1 end
    if fat_cstr_eq(name, "codebuf_emit_byte") == 1 do out 1 end
    if fat_cstr_eq(name, "codebuf_emit_u32") == 1 do out 1 end
    if fat_cstr_eq(name, "codebuf_emit_u64") == 1 do out 1 end
    if fat_cstr_eq(name, "codebuf_emit_i32") == 1 do out 1 end
    if fat_cstr_eq(name, "buf_write_u8") == 1 do out 1 end
    if fat_cstr_eq(name, "buf_align") == 1 do out 1 end
    if fat_cstr_eq(name, "bvec_push") == 1 do out 1 end
    if fat_cstr_eq(name, "text_splice_at") == 1 do out 1 end
    out 0
end.

func pass5_infer_call_return(symbols: SymbolTable, scopes: ScopeTree, node: AstNode):
    if node.node_type != AstType.Call and node.node_type != AstType.MethodCall do
        out TypeKind.Void
    end
    found = pass5_lookup(symbols, scopes, scope_current_id(scopes), node.name)
    if found != -1 do
        # Read SymbolTable through its physical layout. Native self-host field
        # lowering can confuse the nested `symbols.symbols` access with a
        # same-named field from another entity and load offset 16.
        call_syms = native_read_i64(symbols as i64, 0)
        sym = vec_get_rt(call_syms, found)
        if sym.return_type != 0 do
            out sym.return_type as TypeKind
        end
    end
    if pass5_call_returns_first_arg(node.name as i64) == 1 do
        child_count = vec_len_rt(node.children)
        if child_count > 0 do
            arg0 = vec_get_rt(node.children, 0)
            arg0_ty = pass5_infer_expr(symbols, scopes, arg0)
            if arg0_ty != TypeKind.Void do
                out arg0_ty
            end
        end
    end
    out TypeKind.Int
end.

func pass5_tuple_binder_type(symbols: SymbolTable, scopes: ScopeTree, init: AstNode, index: int):
    if init.node_type == AstType.TupleExpr do
        child_count = vec_len_rt(init.children)
        if index < child_count do
            elem = vec_get_rt(init.children, index)
            out pass5_infer_expr(symbols, scopes, elem)
        end
        out TypeKind.Int
    end
    if init.node_type == AstType.Call or init.node_type == AstType.MethodCall do
        if index == 0 do
            child_count = vec_len_rt(init.children)
            if child_count > 0 do
                arg0 = vec_get_rt(init.children, 0)
                arg0_ty = pass5_infer_expr(symbols, scopes, arg0)
                if arg0_ty != TypeKind.Void do
                    out arg0_ty
                end
            end
            out TypeKind.Entity
        end
        nm = init.name as i64
        if fat_cstr_eq(nm, "lex_advance") == 1 do
            out TypeKind.Int
        end
        if fat_cstr_eq(nm, "expect_tok") == 1 do
            if index == 2 do
                out TypeKind.Bool
            end
            out TypeKind.Entity
        end
        out TypeKind.Entity
    end
    out TypeKind.Int
end.

func pass5_infer_expr(symbols: SymbolTable, scopes: ScopeTree, node: AstNode):
    if node.node_type == AstType.LiteralInt do
        out TypeKind.Int
    end
    if node.node_type == AstType.LiteralFloat do
        out TypeKind.Float
    end
    if node.node_type == AstType.PercentExpr do
        out TypeKind.Float
    end
    if node.node_type == AstType.LiteralBool do
        out TypeKind.Bool
    end
    if node.node_type == AstType.LiteralNone do
        out TypeKind.None
    end
    if node.node_type == AstType.LiteralStr or node.node_type == AstType.InterpExpr do
        out TypeKind.String
    end
    if node.node_type == AstType.Identifier do
        found = pass5_lookup(symbols, scopes, scope_current_id(scopes), node.name)
        if found != -1 do
            ident_syms = native_read_i64(symbols as i64, 0)
            sym = vec_get_rt(ident_syms, found)
            out sym.type_id as TypeKind
        end
        out TypeKind.Void
    end
    if node.node_type == AstType.BinOp do
        child_count = vec_len_rt(node.children)
        if child_count >= 2 do
            left = vec_get_rt(node.children, 0)
            right = vec_get_rt(node.children, 1)
            lt = pass5_infer_expr(symbols, scopes, left)
            rt_type = pass5_infer_expr(symbols, scopes, right)
            if node.op == OpType.MatMulOp do
                out TypeKind.Tensor
            end
            if node.op == OpType.Eq or node.op == OpType.Ne or node.op == OpType.Gt or node.op == OpType.Lt or node.op == OpType.Ge or node.op == OpType.Le do
                out TypeKind.Bool
            end
            if node.op == OpType.Land or node.op == OpType.Lor do
                out TypeKind.Bool
            end
            if node.op == OpType.AndOp or node.op == OpType.OrOp or node.op == OpType.XorOp do
                if lt == TypeKind.Bool and rt_type == TypeKind.Bool do
                    out TypeKind.Bool
                end
                out TypeKind.Int
            end
            if node.op == OpType.ShlOp or node.op == OpType.ShrOp do
                out TypeKind.Int
            end
            if lt == TypeKind.Float or rt_type == TypeKind.Float do
                out TypeKind.Float
            end
            if lt == TypeKind.String and rt_type == TypeKind.String do
                out TypeKind.String
            end
            if lt == TypeKind.Bool or rt_type == TypeKind.Bool do
                out TypeKind.Bool
            end
            if lt != TypeKind.Void do
                out lt
            end
            out rt_type
        end
        out TypeKind.Void
    end
    if node.node_type == AstType.Compare do
        out TypeKind.Bool
    end
    if node.node_type == AstType.Call or node.node_type == AstType.MethodCall do
        out pass5_infer_call_return(symbols, scopes, node)
    end
    if node.node_type == AstType.ArrayLiteral do
        child_count = vec_len_rt(node.children)
        var i = 0
        var array_elem_type = TypeKind.Void
        when i < child_count loop
            elem = vec_get_rt(node.children, i)
            elem_t = pass5_infer_expr(symbols, scopes, elem)
            if elem_t != TypeKind.Void do
                array_elem_type = elem_t
            end
            i = i + 1
        end
        out TypeKind.Array
    end
    if node.node_type == AstType.TupleExpr do
        out TypeKind.Tuple
    end
    if node.node_type == AstType.DictLiteral do
        out TypeKind.Dict
    end
    if node.node_type == AstType.EntityLiteral do
        out TypeKind.Entity
    end
    if node.node_type == AstType.EnumAccess do
        out TypeKind.Enum
    end
    if node.node_type == AstType.AddrOf do
        out TypeKind.Ref
    end
    if node.node_type == AstType.CastExpr do
        out TypeKind.Void
    end
    if node.node_type == AstType.UnaryMinus do
        child_count = vec_len_rt(node.children)
        if child_count > 0 do
            child = vec_get_rt(node.children, 0)
            out pass5_infer_expr(symbols, scopes, child)
        end
        out TypeKind.Int
    end
    if node.node_type == AstType.IndexAccess or node.node_type == AstType.ExprIndex do
        out TypeKind.Int
    end
    out TypeKind.Void
end.
func pass5_walk(symbols: SymbolTable, scopes: ScopeTree, node: AstNode):

    if node.node_type == AstType.VarDecl or node.node_type == AstType.ConstDecl do
        child_count = vec_len_rt(node.children)
        var i = 0
        when i < child_count loop
            child = vec_get_rt(node.children, i)
            pass5_walk(symbols, scopes, child)
            i = i + 1
        end
        if node.int_val == 16384 do
            # Tuple destructure: binders are children[0..n-2], init last.
            if child_count > 1 do
                init = vec_get_rt(node.children, child_count - 1)
                var di = 0
                when di < child_count - 1 loop
                    var_ident = vec_get_rt(node.children, di)
                    if fat_str_len(var_ident.name) > 0 do
                        binder_ty = pass5_tuple_binder_type(symbols, scopes, init, di)
                        if binder_ty == TypeKind.Void do
                            binder_ty = TypeKind.Int
                        end
                        pass5_register_local(symbols, scopes, var_ident.name, binder_ty)
                    end
                    di = di + 1
                end
            end
        else
            inferred = TypeKind.Void
            if child_count > 0 do
                init = vec_get_rt(node.children, 0)
                inferred = pass5_infer_expr(symbols, scopes, init)
            end
            if inferred == TypeKind.Void do
                inferred = TypeKind.Int
            end
            pass5_register_local(symbols, scopes, node.name, inferred)
        end
        out 0
    end

    # Implicit locals from `x = expr` — same inference as VarDecl.
    if node.node_type == AstType.Assign do
        inferred = TypeKind.Void
        child_count = vec_len_rt(node.children)
        if child_count > 0 do
            init = vec_get_rt(node.children, 0)
            inferred = pass5_infer_expr(symbols, scopes, init)
            pass5_walk(symbols, scopes, init)
        end
        if fat_str_len(node.name) > 0 do
            if inferred == TypeKind.Void do
                inferred = TypeKind.Int
            end
            found = pass5_lookup(symbols, scopes, scope_current_id(scopes), node.name)
            if found != -1 do
                assign_syms = native_read_i64(symbols as i64, 0)
                sym = vec_get_rt(assign_syms, found)
                if sym.type_id == 0 do
                    native_write_i64(sym as i64, 16, inferred as i64)
                end
            else
                pass5_register_local(symbols, scopes, node.name, inferred)
            end
        end
        out 0
    end

    if node.node_type == AstType.FuncDef do
        scope_push(scopes, ScopeKind.Func)
        child_count = vec_len_rt(node.children)
        body_idx = child_count - 1
        if body_idx < 0 do
            body_idx = 0
        end
        var bi = 0
        when bi < child_count loop
            ch = vec_get_rt(node.children, bi)
            if ch.node_type == AstType.Block do
                body_idx = bi
                bi = child_count
            else
                bi = bi + 1
            end
        end
        var pi = 0
        when pi < body_idx loop
            param = vec_get_rt(node.children, pi)
            if fat_str_len(param.name) > 0 do
                pass5_register_local(symbols, scopes, param.name, TypeKind.Int)
            end
            pi = pi + 1
        end
        var j = body_idx
        when j < child_count loop
            child = vec_get_rt(node.children, j)
            pass5_walk(symbols, scopes, child)
            j = j + 1
        end
        scope_pop(scopes)
        out 0
    end

    if node.node_type == AstType.ForRange do
        child_count = vec_len_rt(node.children)
        if child_count >= 1 do
            pass5_walk(symbols, scopes, vec_get_rt(node.children, 0))
        end
        if child_count >= 2 do
            pass5_walk(symbols, scopes, vec_get_rt(node.children, 1))
        end
        scope_push(scopes, ScopeKind.Loop)
        if fat_str_len(node.name) > 0 do
            pass5_register_local(symbols, scopes, node.name, TypeKind.Int)
        end
        if child_count >= 3 do
            pass5_walk(symbols, scopes, vec_get_rt(node.children, 2))
        end
        scope_pop(scopes)
        out 0
    end

    if node.node_type == AstType.Block do
        scope_push(scopes, ScopeKind.Block)
        child_count = vec_len_rt(node.children)
        var i = 0
        when i < child_count loop
            child = vec_get_rt(node.children, i)
            pass5_walk(symbols, scopes, child)
            i = i + 1
        end
        scope_pop(scopes)
        out 0
    end

    # Default recurse
    child_count = vec_len_rt(node.children)
    var i = 0
    when i < child_count loop
        child = vec_get_rt(node.children, i)
        pass5_walk(symbols, scopes, child)
        i = i + 1
    end
    out 0
end.

func pass5_register_local(symbols: SymbolTable, scopes: ScopeTree, name: string, ty: TypeKind):
    if fat_str_len(name) == 0 do
        out 0
    end
    curr = scope_current_id(scopes)
    found = pass5_lookup(symbols, scopes, curr, name)
    if found != -1 do
        local_syms = native_read_i64(symbols as i64, 0)
        sym = vec_get_rt(local_syms, found)
        if sym.type_id == 0 and ty != TypeKind.Void do
            native_write_i64(sym as i64, 16, ty as i64)
        end
        out found
    end
    sym = SymbolNode (
        kind: SymbolKind.Variable,
        name_id: name as i64,
        type_id: ty as i64,
        scope_id: curr,
        ast_id: 0,
        is_mutable: true,
        offset: 0,
        param_count: 0,
        return_type: 0,
        parent_id: -1
    )
    sym_id = symbol_alloc(symbols, sym)
    scope_add_symbol(scopes, curr, sym_id)
    if curr == 0 do
        pass5_index_global(name, sym_id)
    end
    out sym_id
end.

func pass5_lookup_global(symbols: SymbolTable, name: string):
    if g_pass5_global_buckets == 0 do
        out -1
    end
    bid = pass5_hash_name(name)
    bucket = vec_get_rt(g_pass5_global_buckets, bid)
    count = vec_len_rt(bucket)
    syms_vec = native_read_i64(symbols as i64, 0)
    name_ptr = name as i64
    var i = 0
    when i < count loop
        sym_id = vec_get_rt(bucket, i)
        sym = vec_get_rt(syms_vec, sym_id)
        sym_name_ptr = native_read_i64(sym as i64, 8)
        # Pointer identity first (same AST / register handle).
        if sym_name_ptr == name_ptr do
            out sym_id
        end
        if fat_str_eq(sym_name_ptr as string, name) == 1 do
            out sym_id
        end
        i = i + 1
    end
    out -1
end.

func pass5_lookup_scope_linear(symbols: SymbolTable, scopes: ScopeTree, scope_id: int, name: string):
    if scope_id <= 0 do
        out -1
    end
    scopes_vec = native_read_i64(scopes as i64, 0)
    if scope_id >= vec_len_rt(scopes_vec) do
        out -1
    end
    scope_node = vec_get_rt(scopes_vec, scope_id)
    sym_list = native_read_i64(scope_node as i64, 16)
    count = vec_len_rt(sym_list)
    if count == 0 do
        out -1
    end
    syms_vec = native_read_i64(symbols as i64, 0)
    name_ptr = name as i64
    var i = 0
    when i < count loop
        sym_id = vec_get_rt(sym_list, i)
        sym = vec_get_rt(syms_vec, sym_id)
        sym_name_ptr = native_read_i64(sym as i64, 8)
        if sym_name_ptr == name_ptr do
            out sym_id
        end
        if fat_str_eq(sym_name_ptr as string, name) == 1 do
            out sym_id
        end
        i = i + 1
    end
    out -1
end.

func pass5_lookup(symbols: SymbolTable, scopes: ScopeTree, start_scope: int, name: string):
    if fat_str_len(name) == 0 do
        out -1
    end
    # Inner scopes shadow globals (match pass 3 name resolution).
    curr = start_scope
    scopes_vec = native_read_i64(scopes as i64, 0)
    when curr >= 0 loop
        if curr == 0 do
            out pass5_lookup_global(symbols, name)
        end
        found2 = pass5_lookup_scope_linear(symbols, scopes, curr, name)
        if found2 != -1 do
            out found2
        end
        scope_node = vec_get_rt(scopes_vec, curr)
        curr = native_read_i64(scope_node as i64, 8)
    end
    out -1
end.

export pass5_infer_types, pass5_infer_expr

# @vir_source stdlib/vir/compiler/semantic.vri 49
import pass5_infer_types from compiler.sem_pass5_infer

# @vir_source stdlib/vir/compiler/sem_pass6_typecheck.vri 1
##
 * vir/compiler/sem_pass6_typecheck.vri
 * ==============================================================
 * Pass 6: Complete Type Checking for Vir v2.0
 * Validates type compatibility for operators, assignments, calls,
 * returns, entity field accesses, and array indexing.
 ##

import vec_new_rt, vec_push_rt, vec_get_rt, vec_len_rt, vec_set_rt from vec_rt

import rt_streq, fat_str_eq, fat_str_len, fat_str_byte_at, fat_cstr_eq, fat_str_new, fat_str_slice, rt_strcat, rt_itoa, rt_strlen from string_rt

import AstNode, AstType, OpType from parser

import SymbolTable, SymbolKind, SymbolNode, symbol_alloc from symbol_table

import ScopeTree, ScopeKind, ScopeNode, scope_push, scope_pop, scope_add_symbol, scope_current_id from scope_tree

import DiagnosticEngine, report_error from context

import TypeKind, TYPE_VOID, TYPE_INT, TYPE_FLOAT, TYPE_BOOL, TYPE_STRING, is_tensor_type_str, tensor_type_is_well_formed, parse_tensor_elem_type, parse_tensor_shape, parse_tensor_rank from type_table

# Hash ONLY global scope.  Orphan Func/Block nodes from prior passes would
# make a dense per-scope 256-bucket table allocate millions of vecs.
const PASS6_BUCKETS: int = 256
var g_pass6_global_buckets: i64 = 0
var g_pass6_extern_names: i64 = 0
var g_pass6_extern_nodes: i64 = 0
var g_pass6_ai_mode: int = 0 # 0=normal, 1=infer, 2=train
var g_pass6_infer_values: i64 = 0
var g_pass6_train_values: i64 = 0
var g_pass6_entity_names: i64 = 0
var g_pass6_entity_nodes: i64 = 0
var g_pass6_func_names: i64 = 0
var g_pass6_func_nodes: i64 = 0
var g_pass6_current_entity_name: i64 = 0
var g_pass6_var_names: i64 = 0
var g_pass6_var_types: i64 = 0


func pass6_hash_name(name: string):
    n = fat_str_len(name)
    if n <= 0 do
        out 0
    end
    h = n * 17
    var i = 0
    when i < n loop
        h = h * 131 + fat_str_byte_at(name, i)
        i = i + 1
    end
    if h < 0 do
        h = 0 - h
    end
    out h mod PASS6_BUCKETS
end.

func pass6_global_map_new():
    buckets = vec_new_rt()
    var bi = 0
    when bi < PASS6_BUCKETS loop
        buckets = vec_push_rt(buckets, vec_new_rt())
        bi = bi + 1
    end
    out buckets
end.

func pass6_index_global(name: string, sym_id: int):
    if fat_str_len(name) == 0 do
        out 0
    end
    if g_pass6_global_buckets == 0 do
        g_pass6_global_buckets = pass6_global_map_new()
    end
    bid = pass6_hash_name(name)
    bucket = vec_get_rt(g_pass6_global_buckets, bid)
    bucket = vec_push_rt(bucket, sym_id)
    vec_set_rt(g_pass6_global_buckets, bid, bucket)
    out 0
end.

func pass6_rebuild_index(symbols: SymbolTable, scopes: ScopeTree):
    g_pass6_global_buckets = pass6_global_map_new()
    scopes_vec = native_read_i64(scopes as i64, 0)
    syms_vec = native_read_i64(symbols as i64, 0)
    if vec_len_rt(scopes_vec) == 0 do
        out 0
    end
    scope_node = vec_get_rt(scopes_vec, 0)
    sym_list = native_read_i64(scope_node as i64, 16)
    count = vec_len_rt(sym_list)
    var i = 0
    when i < count loop
        sym_id = vec_get_rt(sym_list, i)
        sym = vec_get_rt(syms_vec, sym_id)
        sym_name = native_read_i64(sym as i64, 8) as string
        pass6_index_global(sym_name, sym_id)
        i = i + 1
    end
end.

func pass6_typecheck(symbols: SymbolTable, scopes: ScopeTree, diag: DiagnosticEngine, node: AstNode):
    pass6_rebuild_index(symbols, scopes)
    g_pass6_extern_names = vec_new_rt()
    g_pass6_extern_nodes = vec_new_rt()
    g_pass6_entity_names = vec_new_rt()
    g_pass6_entity_nodes = vec_new_rt()
    g_pass6_func_names = vec_new_rt()
    g_pass6_func_nodes = vec_new_rt()
    g_pass6_var_names = vec_new_rt()
    g_pass6_var_types = vec_new_rt()
    g_pass6_current_entity_name = 0
    g_pass6_ai_mode = 0
    g_pass6_infer_values = vec_new_rt()
    g_pass6_train_values = vec_new_rt()
    pass6_collect_externs(node)
    pass6_collect_entities(node)
    pass6_collect_free_functions(node)
    pass6_walk(symbols, scopes, diag, node)
end.

func pass6_collect_free_functions(node: AstNode):
    child_count = vec_len_rt(node.children)
    var i = 0
    when i < child_count loop
        candidate = vec_get_rt(node.children, i)
        if candidate.node_type == AstType.BindAttr and vec_len_rt(candidate.children) > 0 do
            candidate = vec_get_rt(candidate.children, 0)
        end
        if candidate.node_type == AstType.FuncDef and fat_str_len(candidate.name) > 0 do
            g_pass6_func_names = vec_push_rt(g_pass6_func_names, candidate.name)
            g_pass6_func_nodes = vec_push_rt(g_pass6_func_nodes, candidate)
        end
        i = i + 1
    end
    out 0
end.

func pass6_find_free_function(name: string):
    if g_pass6_func_names == 0 do out 0 as AstNode end
    var i = 0
    when i < vec_len_rt(g_pass6_func_names) loop
        if fat_str_eq(vec_get_rt(g_pass6_func_names, i) as string, name) == 1 do
            out vec_get_rt(g_pass6_func_nodes, i) as AstNode
        end
        i = i + 1
    end
    out 0 as AstNode
end.

func pass6_collect_externs(node: AstNode):
    if node as i64 == 0 do out 0 end
    if node.node_type == AstType.ExternFunc and fat_str_len(node.name) > 0 do
        g_pass6_extern_names = vec_push_rt(g_pass6_extern_names, node.name)
        g_pass6_extern_nodes = vec_push_rt(g_pass6_extern_nodes, node)
        out 0
    end
    child_count = vec_len_rt(node.children)
    var i = 0
    when i < child_count loop
        pass6_collect_externs(vec_get_rt(node.children, i))
        i = i + 1
    end
    out 0
end.

func pass6_find_extern(name: string):
    if g_pass6_extern_names == 0 do out 0 end
    var i = 0
    when i < vec_len_rt(g_pass6_extern_names) loop
        if fat_str_eq(vec_get_rt(g_pass6_extern_names, i) as string, name) do
            out vec_get_rt(g_pass6_extern_nodes, i)
        end
        i = i + 1
    end
    out 0
end.

func pass6_symbol_at(symbols: SymbolTable, id: int):
    # Avoid ambiguous nested entity-field lowering in native self-host code.
    syms_vec = native_read_i64(symbols as i64, 0)
    out vec_get_rt(syms_vec, id)
end.

func pass6_call_returns_first_arg(name: i64):
    if fat_cstr_eq(name, "ast_add_child") == 1 do out 1 end
    if fat_cstr_eq(name, "vec_push_rt") == 1 do out 1 end
    if fat_cstr_eq(name, "vec_set_rt") == 1 do out 1 end
    if fat_cstr_eq(name, "vec_push") == 1 do out 1 end
    if fat_cstr_eq(name, "ast_vec_push") == 1 do out 1 end
    if fat_cstr_eq(name, "ast_vec_bump_new") == 1 do out 1 end
    if fat_cstr_eq(name, "codebuf_emit_byte") == 1 do out 1 end
    if fat_cstr_eq(name, "codebuf_emit_u32") == 1 do out 1 end
    if fat_cstr_eq(name, "codebuf_emit_u64") == 1 do out 1 end
    if fat_cstr_eq(name, "codebuf_emit_i32") == 1 do out 1 end
    if fat_cstr_eq(name, "buf_write_u8") == 1 do out 1 end
    if fat_cstr_eq(name, "buf_align") == 1 do out 1 end
    if fat_cstr_eq(name, "bvec_push") == 1 do out 1 end
    if fat_cstr_eq(name, "text_splice_at") == 1 do out 1 end
    out 0
end.

func pass6_infer_call_return(symbols: SymbolTable, scopes: ScopeTree, node: AstNode):
    if node.node_type != AstType.Call and node.node_type != AstType.MethodCall do
        out TypeKind.Void
    end
    found = pass6_lookup_chain(symbols, scopes, scope_current_id(scopes), node.name)
    if found != -1 do
        sym = pass6_symbol_at(symbols, found)
        if sym.return_type != 0 do
            out sym.return_type as TypeKind
        end
    end
    if pass6_call_returns_first_arg(node.name as i64) == 1 do
        child_count = vec_len_rt(node.children)
        if child_count > 0 do
            arg0 = vec_get_rt(node.children, 0)
            arg0_ty = pass6_infer_type(symbols, scopes, arg0)
            if arg0_ty != TypeKind.Void do
                out arg0_ty
            end
        end
    end
    out TypeKind.Int
end.

func pass6_infer_type(symbols: SymbolTable, scopes: ScopeTree, node: AstNode):
    if node.node_type == AstType.LiteralInt do
        out TypeKind.Int
    end
    if node.node_type == AstType.LiteralFloat do
        out TypeKind.Float
    end
    if node.node_type == AstType.PercentExpr do
        out TypeKind.Float
    end
    if node.node_type == AstType.LiteralBool do
        out TypeKind.Bool
    end
    if node.node_type == AstType.LiteralNone do
        out TypeKind.None
    end
    if node.node_type == AstType.DictLiteral do
        out TypeKind.Dict
    end
    if node.node_type == AstType.LiteralStr or node.node_type == AstType.InterpExpr do
        out TypeKind.String
    end
    if node.node_type == AstType.Identifier do
        found = pass6_lookup_chain(symbols, scopes, scope_current_id(scopes), node.name)
        if found != -1 do
            sym = pass6_symbol_at(symbols, found)
            out sym.type_id as TypeKind
        end
        out TypeKind.Void
    end
    if node.node_type == AstType.BinOp do
        child_count = vec_len_rt(node.children)
        if child_count >= 2 do
            left = vec_get_rt(node.children, 0)
            right = vec_get_rt(node.children, 1)
            lt = pass6_infer_type(symbols, scopes, left)
            rt_type = pass6_infer_type(symbols, scopes, right)
            if node.op == OpType.MatMulOp or node.op == OpType.FmaOp do
                out TypeKind.Tensor
            end
            if node.op == OpType.Eq or node.op == OpType.Ne or node.op == OpType.Gt or node.op == OpType.Lt or node.op == OpType.Ge or node.op == OpType.Le do
                out TypeKind.Bool
            end
            if node.op == OpType.Land or node.op == OpType.Lor do
                out TypeKind.Bool
            end
            if node.op == OpType.AndOp or node.op == OpType.OrOp or node.op == OpType.XorOp do
                if lt == TypeKind.Bool and rt_type == TypeKind.Bool do
                    out TypeKind.Bool
                end
                out TypeKind.Int
            end
            if node.op == OpType.ShlOp or node.op == OpType.ShrOp do
                out TypeKind.Int
            end
            if lt == TypeKind.Float or rt_type == TypeKind.Float do
                out TypeKind.Float
            end
            if lt == TypeKind.String and rt_type == TypeKind.String do
                out TypeKind.String
            end
            if lt == TypeKind.Bool or rt_type == TypeKind.Bool do
                out TypeKind.Bool
            end
            if lt != TypeKind.Void do
                out lt
            end
            out rt_type
        end
    end
    if node.node_type == AstType.Compare do
        out TypeKind.Bool
    end
    if node.node_type == AstType.Call or node.node_type == AstType.MethodCall do
        out pass6_infer_call_return(symbols, scopes, node)
    end
    if node.node_type == AstType.BuiltinCall do
        out TypeKind.Int
    end
    if node.node_type == AstType.QuantizeExpr do
        out TypeKind.QuantizedTensor
    end
    if node.node_type == AstType.IndexAccess or node.node_type == AstType.FieldAccess or node.node_type == AstType.CastExpr or node.node_type == AstType.UnaryMinus do
        out TypeKind.Int
    end
    if node.node_type == AstType.UnaryNot do
        out TypeKind.Bool
    end
    out TypeKind.Void
end.

func pass6_resolve_ffi_type(name: string):
    if fat_str_len(name) == 0 do out TypeKind.Void end
    if fat_cstr_eq(name, "int") == 1 or fat_cstr_eq(name, "i8") == 1 or fat_cstr_eq(name, "i16") == 1 or fat_cstr_eq(name, "i32") == 1 or fat_cstr_eq(name, "i64") == 1 or fat_cstr_eq(name, "uint") == 1 or fat_cstr_eq(name, "u8") == 1 or fat_cstr_eq(name, "u16") == 1 or fat_cstr_eq(name, "u32") == 1 or fat_cstr_eq(name, "u64") == 1 do out TypeKind.Int end
    if fat_cstr_eq(name, "float") == 1 or fat_cstr_eq(name, "f32") == 1 or fat_cstr_eq(name, "f64") == 1 do out TypeKind.Float end
    if fat_cstr_eq(name, "bool") == 1 do out TypeKind.Bool end
    if fat_cstr_eq(name, "string") == 1 do out TypeKind.String end
    if fat_cstr_eq(name, "ptr") == 1 do out TypeKind.Pointer end
    if fat_cstr_eq(name, "none") == 1 or fat_cstr_eq(name, "void") == 1 do out TypeKind.None end
    out TypeKind.Void
end.

func pass6_is_integer_like(k: TypeKind):
    if k == TypeKind.Float or k == TypeKind.String do
        out 0
    end
    out 1
end.

# `and`/`or`/`xor` are Tok→AndOp/OrOp/XorOp (not only pure bitwise).
# Codebase mixes Compare/UnaryNot (Bool) with Call (inferred Int) in one expr
# (`not has_sep or check(...)`). Allow Bool ∪ integer-like on both sides.
func pass6_types_compatible(declared: i64, actual: TypeKind):
    if declared == actual as i64 do
        out 1
    end
    if actual == TypeKind.Void do
        out 1
    end
    if declared == 0 do
        out 1
    end
    if pass6_is_integer_like(declared as TypeKind) == 1 and pass6_is_integer_like(actual) == 1 do
        out 1
    end
    # Vir bool literals are 0/1; comparisons infer Bool but runtime is int-like.
    if declared == TypeKind.Bool as i64 and pass6_is_integer_like(actual) == 1 do
        out 1
    end
    if actual == TypeKind.Bool and pass6_is_integer_like(declared as TypeKind) == 1 do
        out 1
    end
    if declared == TypeKind.Array as i64 and actual == TypeKind.Entity do
        out 1
    end
    if declared == TypeKind.Entity as i64 and actual == TypeKind.Array do
        out 1
    end
    # Fat-pointer ABI: many `string` / entity handles are i64 at runtime.
    if declared == TypeKind.String as i64 and pass6_is_integer_like(actual) == 1 do
        out 1
    end
    if declared == TypeKind.Entity as i64 and pass6_is_integer_like(actual) == 1 do
        out 1
    end
    out 0
end.

func pass6_ufcs_types_compatible(declared: i64, actual: TypeKind):
    if declared == actual as i64 do out 1 end
    if declared == 0 || actual == TypeKind.Void do out 1 end
    if pass6_is_integer_like(declared as TypeKind) == 1 & pass6_is_integer_like(actual) == 1 do
        out 1
    end
    if declared == TypeKind.Bool as i64 & pass6_is_integer_like(actual) == 1 do out 1 end
    if actual == TypeKind.Bool & pass6_is_integer_like(declared as TypeKind) == 1 do out 1 end
    if declared == TypeKind.Array as i64 & actual == TypeKind.Entity do out 1 end
    if declared == TypeKind.Entity as i64 & actual == TypeKind.Array do out 1 end
    out 0
end.

func pass6_is_logic_bit_operand(k: TypeKind):
    if k == TypeKind.Bool do
        out 1
    end
    out pass6_is_integer_like(k)
end.

func pass6_name_in_vec(names: i64, name: string):
    if names == 0 do out 0 end
    var i = 0
    when i < vec_len_rt(names) loop
        if fat_str_eq(vec_get_rt(names, i) as string, name) do out 1 end
        i = i + 1
    end
    out 0
end.

# Recover the declared tensor annotation through identifiers and quantize
# wrappers.  TypeKind alone intentionally does not erase element/shape data.
func pass6_tensor_type_name(symbols: SymbolTable, scopes: ScopeTree, node: AstNode):
    if node.node_type == AstType.Identifier do
        found = pass6_lookup_chain(symbols, scopes, scope_current_id(scopes), node.name)
        if found != -1 do
            sym = pass6_symbol_at(symbols, found)
            if sym.ast_id != 0 do
                decl = sym.ast_id as AstNode
                if is_tensor_type_str(decl.name2) do out decl.name2 end
                if vec_len_rt(decl.children) > 0 do
                    out pass6_tensor_type_name(symbols, scopes, vec_get_rt(decl.children, 0))
                end
            end
        end
    eif node.node_type == AstType.QuantizeExpr and vec_len_rt(node.children) > 0 do
        out pass6_tensor_type_name(symbols, scopes, vec_get_rt(node.children, 0))
    end
    out fat_str_new("")
end.

func pass6_collect_entities(node: AstNode):
    if node as i64 == 0 do out 0 end
    if (node.node_type == AstType.EntityDef or node.node_type == AstType.PackedDef or node.node_type == AstType.RegisterDef) and fat_str_len(node.name) > 0 do
        g_pass6_entity_names = vec_push_rt(g_pass6_entity_names, node.name as i64)
        g_pass6_entity_nodes = vec_push_rt(g_pass6_entity_nodes, node as i64)
    end
    child_count = vec_len_rt(node.children)
    var i = 0
    when i < child_count loop
        pass6_collect_entities(vec_get_rt(node.children, i))
        i = i + 1
    end
    out 0
end.

func pass6_find_entity_ast(symbols: SymbolTable, scopes: ScopeTree, entity_name: string):
    if fat_str_len(entity_name) == 0 do out 0 as AstNode end
    if g_pass6_entity_names != 0 do
        n_ents = vec_len_rt(g_pass6_entity_names)
        var i = 0
        when i < n_ents loop
            ename = vec_get_rt(g_pass6_entity_names, i) as string
            if fat_str_eq(ename, entity_name) == 1 do
                out vec_get_rt(g_pass6_entity_nodes, i) as AstNode
            end
            i = i + 1
        end
    end
    sid = pass6_lookup_chain(symbols, scopes, 0, entity_name)
    if sid != -1 do
        sym = pass6_symbol_at(symbols, sid)
        if sym.kind == SymbolKind.Entity and sym.ast_id != 0 do
            out sym.ast_id as AstNode
        end
    end
    out 0 as AstNode
end.

func pass6_is_valid_packed_primitive(name: string):
    if fat_cstr_eq(name, "u8") == 1 or fat_cstr_eq(name, "i8") == 1 or fat_cstr_eq(name, "bool") == 1 do out 1 end
    if fat_cstr_eq(name, "u16") == 1 or fat_cstr_eq(name, "i16") == 1 do out 1 end
    if fat_cstr_eq(name, "u32") == 1 or fat_cstr_eq(name, "i32") == 1 do out 1 end
    if fat_cstr_eq(name, "u64") == 1 or fat_cstr_eq(name, "i64") == 1 or fat_cstr_eq(name, "int") == 1 or fat_cstr_eq(name, "uint") == 1 do out 1 end
    if fat_cstr_eq(name, "ptr") == 1 or fat_cstr_eq(name, "float") == 1 or fat_cstr_eq(name, "f32") == 1 or fat_cstr_eq(name, "f64") == 1 do out 1 end
    out 0
end.

func pass6_packed_has_cycle(symbols: SymbolTable, scopes: ScopeTree, current_name: string, root_name: string, depth: i64):
    if depth > 16 do out 1 end
    if fat_str_eq(current_name, root_name) == 1 do out 1 end
    ent = pass6_find_entity_ast(symbols, scopes, current_name)
    if (ent as i64) == 0 do out 0 end
    if ent.node_type != AstType.PackedDef do out 0 end
    var k = 0
    var nk = vec_len_rt(ent.children)
    when k < nk loop
        f_k = vec_get_rt(ent.children, k) as AstNode
        if f_k.node_type != AstType.FuncDef do
            fk_ty = f_k.name2
            if pass6_is_valid_packed_primitive(fk_ty) == 0 do
                if pass6_packed_has_cycle(symbols, scopes, fk_ty, root_name, depth + 1) == 1 do
                    out 1
                end
            end
        end
        k = k + 1
    end
    out 0
end.

func pass6_check_packed_def(symbols: SymbolTable, scopes: ScopeTree, diag: DiagnosticEngine, node: AstNode):
    n_ch = vec_len_rt(node.children)
    var i = 0
    when i < n_ch loop
        fld = vec_get_rt(node.children, i) as AstNode
        if fld.node_type != AstType.FuncDef do
            if fat_str_len(fld.name2) == 0 do
                report_error(diag, 3025, fld.line, 0)
            else
                var prev_i = 0
                when prev_i < i loop
                    prev_fld = vec_get_rt(node.children, prev_i) as AstNode
                    if prev_fld.node_type != AstType.FuncDef and fat_str_eq(prev_fld.name, fld.name) == 1 do
                        report_error(diag, 2004, fld.line, 0)
                    end
                    prev_i = prev_i + 1
                end
                fty = fld.name2
                if pass6_is_valid_packed_primitive(fty) == 0 do
                    if fat_cstr_eq(fty, "string") == 1 or fat_cstr_eq(fty, "array") == 1 or fat_cstr_eq(fty, "dict") == 1 or is_tensor_type_str(fty) do
                        report_error(diag, 3026, fld.line, 0)
                    else
                        target_ast = pass6_find_entity_ast(symbols, scopes, fty)
                        if (target_ast as i64) == 0 do
                            report_error(diag, 3026, fld.line, 0)
                        eif target_ast.node_type == AstType.EntityDef do
                            report_error(diag, 3028, fld.line, 0)
                        eif target_ast.node_type == AstType.PackedDef do
                            if pass6_packed_has_cycle(symbols, scopes, fty, node.name, 1) == 1 do
                                report_error(diag, 3027, fld.line, 0)
                            end
                        end
                    end
                end
            end
        end
        i = i + 1
    end
    out 0
end.

func pass6_check_packed_literal(symbols: SymbolTable, scopes: ScopeTree, diag: DiagnosticEngine, lit: AstNode):
    if fat_str_len(lit.name) == 0 do out 0 end
    ent_ast = pass6_find_entity_ast(symbols, scopes, lit.name)
    if (ent_ast as i64) == 0 do out 0 end
    if ent_ast.node_type != AstType.PackedDef do out 0 end

    n_fields = vec_len_rt(ent_ast.children)
    n_args = vec_len_rt(lit.children)

    exp_names = vec_new_rt()
    exp_types = vec_new_rt()
    var fi = 0
    when fi < n_fields loop
        f_node = vec_get_rt(ent_ast.children, fi) as AstNode
        if f_node.node_type != AstType.FuncDef do
            exp_names = vec_push_rt(exp_names, f_node.name as i64)
            exp_types = vec_push_rt(exp_types, f_node.name2 as i64)
        end
        fi = fi + 1
    end
    n_exp = vec_len_rt(exp_names)

    var ai = 0
    when ai < n_args loop
        arg = vec_get_rt(lit.children, ai) as AstNode
        aname = arg.name2
        var prev_ai = 0
        when prev_ai < ai loop
            prev_arg = vec_get_rt(lit.children, prev_ai) as AstNode
            if fat_str_eq(prev_arg.name2, aname) == 1 do
                report_error(diag, 3010, lit.line, 0)
            end
            prev_ai = prev_ai + 1
        end
        var matched_idx = 0 - 1
        var k = 0
        when k < n_exp loop
            if fat_str_eq(vec_get_rt(exp_names, k) as string, aname) == 1 do
                matched_idx = k
            end
            k = k + 1
        end
        if matched_idx < 0 do
            report_error(diag, 3008, lit.line, 0)
        else
            ftype = vec_get_rt(exp_types, matched_idx) as string
            var int_val = 0
            var has_int = false
            if arg.node_type == AstType.LiteralInt do
                int_val = arg.int_val
                has_int = true
            eif arg.node_type == AstType.UnaryMinus and vec_len_rt(arg.children) > 0 do
                child0 = vec_get_rt(arg.children, 0) as AstNode
                if child0.node_type == AstType.LiteralInt do
                    int_val = 0 - child0.int_val
                    has_int = true
                end
            end
            if has_int do
                if fat_cstr_eq(ftype, "u8") == 1 do
                    if int_val < 0 or int_val > 255 do
                        report_error(diag, 3030, arg.line, 0)
                    end
                eif fat_cstr_eq(ftype, "i8") == 1 do
                    if int_val < (0 - 128) or int_val > 127 do
                        report_error(diag, 3030, arg.line, 0)
                    end
                eif fat_cstr_eq(ftype, "u16") == 1 do
                    if int_val < 0 or int_val > 65535 do
                        report_error(diag, 3030, arg.line, 0)
                    end
                eif fat_cstr_eq(ftype, "i16") == 1 do
                    if int_val < (0 - 32768) or int_val > 32767 do
                        report_error(diag, 3030, arg.line, 0)
                    end
                eif fat_cstr_eq(ftype, "u32") == 1 do
                    if int_val < 0 or int_val > 4294967295 do
                        report_error(diag, 3030, arg.line, 0)
                    end
                eif fat_cstr_eq(ftype, "i32") == 1 do
                    if int_val < (0 - 2147483648) or int_val > 2147483647 do
                        report_error(diag, 3030, arg.line, 0)
                    end
                end
            end
        end
        ai = ai + 1
    end

    var ei = 0
    when ei < n_exp loop
        exp_name = vec_get_rt(exp_names, ei) as string
        var found = false
        var chk_ai = 0
        when chk_ai < n_args loop
            a = vec_get_rt(lit.children, chk_ai) as AstNode
            if fat_str_eq(a.name2, exp_name) == 1 do
                found = true
            end
            chk_ai = chk_ai + 1
        end
        if not found do
            report_error(diag, 3029, lit.line, 0)
        end
        ei = ei + 1
    end
    out 0
end.

func pass6_set_var_type(name: string, type_name: string):
    if fat_str_len(name) == 0 or fat_str_len(type_name) == 0 do out 0 end
    if g_pass6_var_names == 0 do
        g_pass6_var_names = vec_new_rt()
        g_pass6_var_types = vec_new_rt()
    end
    var i = 0
    n = vec_len_rt(g_pass6_var_names)
    when i < n loop
        vn = vec_get_rt(g_pass6_var_names, i) as string
        if fat_str_eq(vn, name) == 1 do
            vec_set_rt(g_pass6_var_types, i, type_name as i64)
            out 0
        end
        i = i + 1
    end
    g_pass6_var_names = vec_push_rt(g_pass6_var_names, name as i64)
    g_pass6_var_types = vec_push_rt(g_pass6_var_types, type_name as i64)
    out 0
end.

func pass6_get_var_type(name: string):
    if g_pass6_var_names == 0 or fat_str_len(name) == 0 do out fat_str_new("") end
    var i = 0
    n = vec_len_rt(g_pass6_var_names)
    when i < n loop
        vn = vec_get_rt(g_pass6_var_names, i) as string
        if fat_str_eq(vn, name) == 1 do
            out vec_get_rt(g_pass6_var_types, i) as string
        end
        i = i + 1
    end
    out fat_str_new("")
end.

func pass6_count_callable_params(type_str: string):
    slen = fat_str_len(type_str)
    if slen <= 0 do out 0 - 1 end
    var lparen = 0 - 1
    var rparen = 0 - 1
    var i = 0
    when i < slen loop
        b = fat_str_byte_at(type_str, i)
        if b == 40 and lparen < 0 do
            lparen = i
        eif b == 41 and rparen < 0 do
            rparen = i
            i = slen
        end
        i = i + 1
    end
    if lparen < 0 or rparen < 0 or rparen <= lparen do
        out 0 - 1
    end
    var has_content = 0
    var commas = 0
    var j = lparen + 1
    when j < rparen loop
        cb = fat_str_byte_at(type_str, j)
        if cb != 32 and cb != 9 and cb != 10 and cb != 13 do
            has_content = 1
        end
        if cb == 44 do
            commas = commas + 1
        end
        j = j + 1
    end
    if has_content == 0 do
        out 0
    end
    out commas + 1
end.

func pass6_callable_param_type(type_str: string, wanted: int):
    slen = fat_str_len(type_str)
    var lparen = 0 - 1
    var i = 0
    when i < slen loop
        if fat_str_byte_at(type_str, i) == 40 do
            lparen = i
            i = slen
        else
            i = i + 1
        end
    end
    if lparen < 0 do out fat_str_new("") end

    var current = 0
    var start = lparen + 1
    var pos = start
    when pos < slen loop
        ch = fat_str_byte_at(type_str, pos)
        if ch == 44 or ch == 41 do
            if current == wanted do
                var trim_start = start
                var trim_end = pos
                when trim_start < trim_end & (fat_str_byte_at(type_str, trim_start) == 32 || fat_str_byte_at(type_str, trim_start) == 9) loop
                    trim_start = trim_start + 1
                end
                when trim_end > trim_start & (fat_str_byte_at(type_str, trim_end - 1) == 32 || fat_str_byte_at(type_str, trim_end - 1) == 9) loop
                    trim_end = trim_end - 1
                end
                out fat_str_slice(type_str as i64, trim_start, trim_end - trim_start) as string
            end
            if ch == 41 do out fat_str_new("") end
            current = current + 1
            start = pos + 1
        end
        pos = pos + 1
    end
    out fat_str_new("")
end.

func pass6_get_receiver_entity_name(symbols: SymbolTable, scopes: ScopeTree, recv: AstNode):
    if recv == 0 do out fat_str_new("") end
    nt = recv.node_type
    if nt == AstType.Identifier do
        if fat_cstr_eq(recv.name, "this") == 1 do
            if g_pass6_current_entity_name != 0 do
                out g_pass6_current_entity_name as string
            end
        end
        vt = pass6_get_var_type(recv.name)
        if fat_str_len(vt) > 0 do out vt end
        sid = pass6_lookup_chain(symbols, scopes, scope_current_id(scopes), recv.name)
        if sid != -1 do
            sym = pass6_symbol_at(symbols, sid)
            if sym.ast_id != 0 do
                decl = sym.ast_id as AstNode
                if decl.node_type == AstType.VarDecl do
                    if fat_str_len(decl.name2) > 0 do
                        out decl.name2
                    end
                    if vec_len_rt(decl.children) > 0 do
                        init = vec_get_rt(decl.children, 0)
                        if init.node_type == AstType.EntityLiteral do
                            out init.name
                        end
                        if init.node_type == AstType.Call do
                            ent_chk = pass6_find_entity_ast(symbols, scopes, init.name)
                            if ent_chk != 0 do out init.name end
                        end
                    end
                end
                if decl.node_type == AstType.ParamDef or decl.node_type == AstType.RefParam or decl.node_type == AstType.Identifier do
                    if fat_str_len(decl.name2) > 0 do out decl.name2 end
                end
            end
        end
        ent_chk2 = pass6_find_entity_ast(symbols, scopes, recv.name)
        if ent_chk2 != 0 do out recv.name end
        out fat_str_new("")
    end
    if nt == AstType.EntityLiteral do
        out recv.name
    end
    if nt == AstType.BuiltinCall & fat_cstr_eq(recv.name, "port") == 1 do
        out fat_str_new("Port")
    end
    if nt == AstType.Call do
        ent_chk3 = pass6_find_entity_ast(symbols, scopes, recv.name)
        if ent_chk3 != 0 do out recv.name end
        call_ast = pass6_find_free_function(recv.name)
        if call_ast != 0 do
            call_ret = call_ast.name2
            if fat_str_len(call_ret) > 0 do
                call_ret_ent = pass6_find_entity_ast(symbols, scopes, call_ret)
                if call_ret_ent != 0 do out call_ret end
            end
        end
        out fat_str_new("")
    end
    if nt == AstType.FieldAccess and vec_len_rt(recv.children) > 0 do
        base_node = vec_get_rt(recv.children, 0)
        base_ent = pass6_get_receiver_entity_name(symbols, scopes, base_node)
        if fat_str_len(base_ent) > 0 do
            base_ast = pass6_find_entity_ast(symbols, scopes, base_ent)
            if base_ast != 0 do
                n_f = vec_len_rt(base_ast.children)
                var fi = 0
                when fi < n_f loop
                    fch = vec_get_rt(base_ast.children, fi)
                    if (fch.node_type == AstType.Identifier or fch.node_type == AstType.VarDecl) and fat_str_eq(fch.name, recv.name) == 1 do
                        out fch.name2
                    end
                    fi = fi + 1
                end
            end
        end
        out fat_str_new("")
    end
    if nt == AstType.MethodCall and vec_len_rt(recv.children) > 0 do
        m_recv = vec_get_rt(recv.children, 0)
        m_recv_ent = pass6_get_receiver_entity_name(symbols, scopes, m_recv)
        if fat_str_len(m_recv_ent) > 0 do
            m_base_ast = pass6_find_entity_ast(symbols, scopes, m_recv_ent)
            if m_base_ast != 0 do
                n_m = vec_len_rt(m_base_ast.children)
                var mi = 0
                when mi < n_m loop
                    mch = vec_get_rt(m_base_ast.children, mi)
                    if mch.node_type == AstType.FuncDef and fat_str_eq(mch.name, recv.name) == 1 do
                        out mch.name2
                    end
                    mi = mi + 1
                end
            end
        end
        out fat_str_new("")
    end
    out fat_str_new("")
end.

func pass6_check_method_call(symbols: SymbolTable, scopes: ScopeTree, diag: DiagnosticEngine, node: AstNode):
    child_count = vec_len_rt(node.children)
    if child_count <= 0 do
        report_error(diag, 3021, node.line, 0)
        out 0
    end
    var ci = 0
    when ci < child_count loop
        pass6_walk(symbols, scopes, diag, vec_get_rt(node.children, ci))
        ci = ci + 1
    end

    recv = vec_get_rt(node.children, 0)
    nargs = child_count - 1
    mname = node.name
    recv_ent_name = pass6_get_receiver_entity_name(symbols, scopes, recv)

    # Priority 1: Entity Method
    if fat_str_len(recv_ent_name) > 0 do
        ent_ast = pass6_find_entity_ast(symbols, scopes, recv_ent_name)
        if ent_ast != 0 do
            n_ech = vec_len_rt(ent_ast.children)
            var mi = 0
            var found_method: AstNode = 0
            when mi < n_ech loop
                m_child = vec_get_rt(ent_ast.children, mi)
                if m_child.node_type == AstType.FuncDef and fat_str_eq(m_child.name, mname) == 1 do
                    found_method = m_child
                    mi = n_ech
                else
                    mi = mi + 1
                end
            end
            if found_method != 0 do
                m_children = vec_len_rt(found_method.children)
                var m_body_idx = m_children - 1
                var bi = 0
                when bi < m_children loop
                    ch = vec_get_rt(found_method.children, bi)
                    if ch.node_type == AstType.Block do
                        m_body_idx = bi
                        bi = m_children
                    else
                        bi = bi + 1
                    end
                end
                m_param_count = m_body_idx
                var has_this = 0
                if m_param_count > 0 do
                    p0 = vec_get_rt(found_method.children, 0)
                    if fat_cstr_eq(p0.name, "this") == 1 do
                        has_this = 1
                    end
                end
                expected_nargs = m_param_count
                if has_this == 1 do
                    expected_nargs = expected_nargs - 1
                end
                if nargs != expected_nargs do
                    report_error(diag, 3022, node.line, 0)
                    out 0
                end
                var ai = 0
                when ai < nargs loop
                    param_pos = ai
                    if has_this == 1 do
                        param_pos = param_pos + 1
                    end
                    param_node = vec_get_rt(found_method.children, param_pos)
                    expected_ty = pass6_resolve_ffi_type(param_node.name2)
                    arg_node = vec_get_rt(node.children, 1 + ai)
                    actual_ty = pass6_infer_type(symbols, scopes, arg_node)
                    if expected_ty != TypeKind.Void & actual_ty != TypeKind.Void & pass6_ufcs_types_compatible(expected_ty, actual_ty) == 0 do
                        report_error(diag, 3001, node.line, 0)
                        out 0
                    end
                    ai = ai + 1
                end
                node.builtin_id = 201
                node.name2 = fat_str_concat(fat_str_concat(recv_ent_name, fat_str_new(".")), mname)
                out 0
            end

            # Priority 2: Callable Field
            var fi = 0
            var found_field: AstNode = 0
            when fi < n_ech loop
                f_child = vec_get_rt(ent_ast.children, fi)
                if (f_child.node_type == AstType.Identifier or f_child.node_type == AstType.VarDecl) and fat_str_eq(f_child.name, mname) == 1 do
                    found_field = f_child
                    fi = n_ech
                else
                    fi = fi + 1
                end
            end
            if found_field != 0 do
                ft_str = found_field.name2
                var is_callable = 0
                if fat_str_len(ft_str) >= 4 do
                    if fat_str_byte_at(ft_str, 0) == 102 and fat_str_byte_at(ft_str, 1) == 117 and fat_str_byte_at(ft_str, 2) == 110 and fat_str_byte_at(ft_str, 3) == 99 do
                        is_callable = 1
                    end
                end
                if is_callable == 1 do
                    expected_params = pass6_count_callable_params(ft_str)
                    if expected_params >= 0 and nargs != expected_params do
                        report_error(diag, 3022, node.line, 0)
                        out 0
                    end
                    var field_ai = 0
                    when field_ai < nargs loop
                        field_param_name = pass6_callable_param_type(ft_str, field_ai)
                        field_expected = pass6_resolve_ffi_type(field_param_name)
                        field_arg = vec_get_rt(node.children, 1 + field_ai)
                        field_actual = pass6_infer_type(symbols, scopes, field_arg)
                        if field_expected != TypeKind.Void & field_actual != TypeKind.Void & pass6_ufcs_types_compatible(field_expected, field_actual) == 0 do
                            report_error(diag, 3001, node.line, 0)
                            out 0
                        end
                        field_ai = field_ai + 1
                    end
                    node.builtin_id = 202
                    node.name2 = recv_ent_name
                    out 0
                end
            end
        end
    end

    # Builtin Port UFCS is intentionally narrow: only values produced by
    # `port(...)` receive the send/recv surface.  Opaque pointers never do.
    if fat_cstr_eq(recv_ent_name, "Port") == 1 do
        if fat_cstr_eq(mname, "send") == 1 do
            if nargs != 1 do
                report_error(diag, 3022, node.line, 0)
                out 0
            end
            send_arg = vec_get_rt(node.children, 1)
            send_ty = pass6_infer_type(symbols, scopes, send_arg)
            if send_ty != TypeKind.Void & send_ty != TypeKind.Int do
                report_error(diag, 3001, node.line, 0)
                out 0
            end
            node.builtin_id = 203
            node.name2 = fat_str_new("send")
            out 0
        end
        if fat_cstr_eq(mname, "recv") == 1 do
            if nargs != 0 do
                report_error(diag, 3022, node.line, 0)
                out 0
            end
            node.builtin_id = 203
            node.name2 = fat_str_new("recv")
            out 0
        end
    end

    # Priority 3: Free Function / Builtin UFCS
    free_sym_id = pass6_lookup_chain(symbols, scopes, 0, mname)
    if free_sym_id != -1 do
        free_sym = pass6_symbol_at(symbols, free_sym_id)
        if free_sym.kind == SymbolKind.Func or free_sym.kind == SymbolKind.Builtin do
            total_args = 1 + nargs
            if free_sym.param_count >= 0 and total_args != free_sym.param_count do
                report_error(diag, 3022, node.line, 0)
                out 0
            end
            if free_sym.ast_id != 0 do
                fn_ast = free_sym.ast_id as AstNode
                if vec_len_rt(fn_ast.children) > 0 do
                    p0_node = vec_get_rt(fn_ast.children, 0)
                    if p0_node.node_type != AstType.Block and fat_str_len(p0_node.name2) > 0 do
                        p0_expected = pass6_resolve_ffi_type(p0_node.name2)
                        recv_actual = pass6_infer_type(symbols, scopes, recv)
                        if p0_expected != TypeKind.Void and recv_actual != TypeKind.Void and pass6_ufcs_types_compatible(p0_expected, recv_actual) == 0 do
                            report_error(diag, 3001, node.line, 0)
                            out 0
                        end
                        if p0_expected == TypeKind.Void do
                            p0_entity = pass6_find_entity_ast(symbols, scopes, p0_node.name2)
                            if p0_entity != 0 do
                                recv_entity = pass6_get_receiver_entity_name(symbols, scopes, recv)
                                if fat_str_len(recv_entity) == 0 or fat_str_eq(recv_entity, p0_node.name2) == 0 do
                                    report_error(diag, 3001, node.line, 0)
                                    out 0
                                end
                            end
                        end
                    end
                end
                var ai2 = 0
                when ai2 < nargs loop
                    if 1 + ai2 < vec_len_rt(fn_ast.children) do
                        pi_node = vec_get_rt(fn_ast.children, 1 + ai2)
                        if pi_node.node_type != AstType.Block and fat_str_len(pi_node.name2) > 0 do
                            pi_expected = pass6_resolve_ffi_type(pi_node.name2)
                            arg_node2 = vec_get_rt(node.children, 1 + ai2)
                            arg_actual2 = pass6_infer_type(symbols, scopes, arg_node2)
                            if pi_expected != TypeKind.Void and arg_actual2 != TypeKind.Void and pass6_ufcs_types_compatible(pi_expected, arg_actual2) == 0 do
                                report_error(diag, 3001, node.line, 0)
                                out 0
                            end
                            if pi_expected == TypeKind.Void do
                                pi_entity = pass6_find_entity_ast(symbols, scopes, pi_node.name2)
                                if pi_entity != 0 do
                                    arg_entity = pass6_get_receiver_entity_name(symbols, scopes, arg_node2)
                                    if fat_str_len(arg_entity) == 0 or fat_str_eq(arg_entity, pi_node.name2) == 0 do
                                        report_error(diag, 3001, node.line, 0)
                                        out 0
                                    end
                                end
                            end
                        end
                    end
                    ai2 = ai2 + 1
                end
            end
            node.builtin_id = 203
            node.name2 = mname
            out 0
        end
    end

    # Priority 4: No candidate found
    report_error(diag, 3021, node.line, 0)
    out 0
end.

func pass6_walk(symbols: SymbolTable, scopes: ScopeTree, diag: DiagnosticEngine, node: AstNode):

    if fat_str_len(node.name2) > 0 and is_tensor_type_str(node.name2) and not tensor_type_is_well_formed(node.name2) do
        report_error(diag, 3024, node.line, 0)
    end

    if node.node_type == AstType.EntityLiteral do
        pass6_check_packed_literal(symbols, scopes, diag, node)
    end

    if node.node_type == AstType.EntityDef or node.node_type == AstType.PackedDef do
        if node.node_type == AstType.PackedDef do
            pass6_check_packed_def(symbols, scopes, diag, node)
        end
        old_ent = g_pass6_current_entity_name
        g_pass6_current_entity_name = node.name as i64
        pass6_set_var_type(fat_str_new("this"), node.name)
        scope_push(scopes, ScopeKind.Entity)
        child_count = vec_len_rt(node.children)
        var i = 0
        when i < child_count loop
            child = vec_get_rt(node.children, i)
            pass6_walk(symbols, scopes, diag, child)
            i = i + 1
        end
        scope_pop(scopes)
        g_pass6_current_entity_name = old_ent
        if old_ent != 0 do
            pass6_set_var_type(fat_str_new("this"), old_ent as string)
        end
        out 0
    end

    if node.node_type == AstType.MethodCall do
        if fat_cstr_eq(node.name, "backward") == 1 do
            if g_pass6_ai_mode == 1 do
                report_error(diag, 3009, node.line, 0)
            eif g_pass6_ai_mode != 2 do
                report_error(diag, 3017, node.line, 0)
            else
                backward_ok = false
                if vec_len_rt(node.children) > 0 do
                    recv = vec_get_rt(node.children, 0)
                    recv_ty = pass6_infer_type(symbols, scopes, recv)
                    if recv.node_type == AstType.Identifier and pass6_name_in_vec(g_pass6_train_values, recv.name) == 1 and (recv_ty == TypeKind.Float or recv_ty == TypeKind.Tensor) do
                        backward_ok = true
                    end
                end
                if not backward_ok do report_error(diag, 3020, node.line, 0) end
            end
            out 0
        end
        pass6_check_method_call(symbols, scopes, diag, node)
        out 0
    end

    if node.node_type == AstType.QuantizeExpr do
        q_count = vec_len_rt(node.children)
        if q_count != 2 do
            report_error(diag, 3019, node.line, 0)
        else
            q_value = vec_get_rt(node.children, 0)
            q_bits_expr = vec_get_rt(node.children, 1)
            q_value_type = pass6_infer_type(symbols, scopes, q_value)
            if q_value_type != TypeKind.Tensor do
                report_error(diag, 3018, node.line, 0)
            else
                q_tensor_name = pass6_tensor_type_name(symbols, scopes, q_value)
                if not is_tensor_type_str(q_tensor_name) or parse_tensor_elem_type(q_tensor_name) != TypeKind.Float do
                    report_error(diag, 3018, node.line, 0)
                end
            end
            if q_bits_expr.node_type != AstType.LiteralInt do
                report_error(diag, 3019, q_bits_expr.line, 0)
            else
                q_bits = q_bits_expr.int_val
                if q_bits != 4 and q_bits != 8 and q_bits != 16 and q_bits != 32 do
                    report_error(diag, 3019, q_bits_expr.line, 0)
                end
            end
            pass6_walk(symbols, scopes, diag, q_value)
            pass6_walk(symbols, scopes, diag, q_bits_expr)
        end
        out 0
    end

    # String Interpolation Type Check & Node Binding
    if node.node_type == AstType.InterpExpr do
        child_count = vec_len_rt(node.children)
        var i = 0
        when i < child_count loop
            child = vec_get_rt(node.children, i)
            pass6_walk(symbols, scopes, diag, child)
            if child.node_type != AstType.LiteralStr do
                ct = pass6_infer_type(symbols, scopes, child)
                child.builtin_id = ct as int
                if ct != TypeKind.Void and ct != TypeKind.String and pass6_is_integer_like(ct) == 0 and ct != TypeKind.Bool and ct != TypeKind.Float do
                    report_error(diag, 3001, child.line, 0)
                end
            end
            i = i + 1
        end
        out 0
    end

    # Spec §10.1: postfix percent accepts exactly one numeric operand and
    # always produces Float. Keep this separate from binary `mod` checking.
    if node.node_type == AstType.PercentExpr do
        percent_child_count = vec_len_rt(node.children)
        if percent_child_count != 1 do
            report_error(diag, 3002, node.line, 0)
        else
            percent_value = vec_get_rt(node.children, 0)
            percent_type = pass6_infer_type(symbols, scopes, percent_value)
            if percent_type != TypeKind.Void and percent_type != TypeKind.Int and percent_type != TypeKind.Float do
                report_error(diag, 3002, node.line, 0)
            end
            pass6_walk(symbols, scopes, diag, percent_value)
        end
        out 0
    end

    # 1. Binary Operator Type Check
    if node.node_type == AstType.BinOp do
        child_count = vec_len_rt(node.children)
        if child_count >= 2 do
            left = vec_get_rt(node.children, 0)
            right = vec_get_rt(node.children, 1)
            lt = pass6_infer_type(symbols, scopes, left)
            rt_type = pass6_infer_type(symbols, scopes, right)
            if lt != TypeKind.Void and rt_type != TypeKind.Void do
                # String concatenation rules (`+` only).
                if node.op == OpType.Add do
                    if lt == TypeKind.String and rt_type != TypeKind.String and pass6_is_integer_like(rt_type) == 0 do
                        report_error(diag, 3001, node.line, 0)
                    eif lt != TypeKind.String and rt_type == TypeKind.String and pass6_is_integer_like(lt) == 0 do
                        report_error(diag, 3001, node.line, 0)
                    end
                end
                # Bool arithmetic prohibition (allow logical & comparison ops).
                # Vir bool is 0/1 at runtime — allow arithmetic with integer-like other side.
                if lt == TypeKind.Bool or rt_type == TypeKind.Bool do
                    if node.op != OpType.Eq and node.op != OpType.Ne and node.op != OpType.Land and node.op != OpType.Lor and node.op != OpType.AndOp and node.op != OpType.OrOp and node.op != OpType.XorOp do
                        other = rt_type
                        if lt == TypeKind.Bool do
                            other = rt_type
                        else
                            other = lt
                        end
                        if pass6_is_integer_like(other) == 0 do
                            report_error(diag, 3002, node.line, 0)
                        end
                    end
                end
                # Bitwise shifts require integers.  And/Or/Xor are also used as
                # boolean logical ops — allow Int×Int or Bool×Bool; Enum~Int OK.
                if node.op == OpType.ShlOp or node.op == OpType.ShrOp do
                    if pass6_is_integer_like(lt) == 0 or pass6_is_integer_like(rt_type) == 0 do
                        report_error(diag, 3006, node.line, 0)
                    end
                end
                if node.op == OpType.AndOp or node.op == OpType.OrOp or node.op == OpType.XorOp or node.op == OpType.Land or node.op == OpType.Lor do
                    if pass6_is_logic_bit_operand(lt) == 0 or pass6_is_logic_bit_operand(rt_type) == 0 do
                        report_error(diag, 3006, node.line, 0)
                    end
                end
                if node.op == OpType.MatMulOp or node.op == OpType.FmaOp do
                    if lt != TypeKind.Void and lt != TypeKind.Tensor do
                        report_error(diag, 3002, node.line, 0)
                    end
                    if rt_type != TypeKind.Void and rt_type != TypeKind.Tensor do
                        report_error(diag, 3002, node.line, 0)
                    end
                    var type_a_str = fat_str_new("")
                    var type_b_str = fat_str_new("")
                    if left.node_type == AstType.Identifier do
                        found_a = pass6_lookup_chain(symbols, scopes, scope_current_id(scopes), left.name)
                        if found_a != -1 do
                            sym_a = pass6_symbol_at(symbols, found_a)
                            if sym_a.ast_id != 0 do
                                ast_a = sym_a.ast_id as AstNode
                                type_a_str = ast_a.name2
                            end
                        end
                    end
                    if right.node_type == AstType.Identifier do
                        found_b = pass6_lookup_chain(symbols, scopes, scope_current_id(scopes), right.name)
                        if found_b != -1 do
                            sym_b = pass6_symbol_at(symbols, found_b)
                            if sym_b.ast_id != 0 do
                                ast_b = sym_b.ast_id as AstNode
                                type_b_str = ast_b.name2
                            end
                        end
                    end
                    if not is_tensor_type_str(type_a_str) or not is_tensor_type_str(type_b_str) do
                        # Matmul/FMA dimensions must be known statically.  Do not
                        # let lowering invent the historical 2x2 fallback.
                        report_error(diag, 3014, node.line, 0)
                    else
                        shape_a = parse_tensor_shape(type_a_str)
                        shape_b = parse_tensor_shape(type_b_str)
                        elem_a = parse_tensor_elem_type(type_a_str)
                        elem_b = parse_tensor_elem_type(type_b_str)
                        if elem_a != elem_b do
                            report_error(diag, 3007, node.line, 0)
                        end
                        rank_a = vec_len_rt(shape_a)
                        rank_b = vec_len_rt(shape_b)
                        if rank_a != 2 or rank_b != 2 do
                            report_error(diag, 3014, node.line, 0)
                        else
                            k_a = vec_get_rt(shape_a, 1) as i64
                            k_b = vec_get_rt(shape_b, 0) as i64
                            if k_a != k_b do
                                report_error(diag, 3014, node.line, 0)
                            end
                        end
                    end
                end
            end
        end
        child_count2 = vec_len_rt(node.children)
        var i = 0
        when i < child_count2 loop
            child = vec_get_rt(node.children, i)
            pass6_walk(symbols, scopes, diag, child)
            i = i + 1
        end
        out 0
    end

    # 2. Assignment & L-Value Check
    # Parser shape: Assign.name = LHS ident; children[0] = RHS (not lhs child).
    if node.node_type == AstType.Assign do
        child_count = vec_len_rt(node.children)
        if fat_str_len(node.name) > 0 do
            found = pass6_lookup_chain(symbols, scopes, scope_current_id(scopes), node.name)
            if found == -1 do
                pass6_register_local(symbols, scopes, node.name, true)
                found = pass6_lookup_chain(symbols, scopes, scope_current_id(scopes), node.name)
            end
            if found != -1 do
                sym = pass6_symbol_at(symbols, found)
                if sym.kind != SymbolKind.Variable and sym.kind != SymbolKind.Param do
                    pass6_register_local(symbols, scopes, node.name, true)
                    found = pass6_lookup_chain(symbols, scopes, scope_current_id(scopes), node.name)
                    sym = pass6_symbol_at(symbols, found)
                end
                if not sym.is_mutable do
                    report_error(diag, 3003, node.line, 0)
                end
                if child_count >= 1 do
                    rhs = vec_get_rt(node.children, 0)
                    rhs_type = pass6_infer_type(symbols, scopes, rhs)
                    if sym.type_id != 0 and rhs_type != TypeKind.Void and pass6_types_compatible(sym.type_id, rhs_type) == 0 do
                        report_error(diag, 3007, node.line, 0)
                    end
                    if sym.type_id == 0 and rhs_type != TypeKind.Void do
                        native_write_i64(sym as i64, 16, rhs_type as i64)
                    end
                    if rhs.node_type == AstType.EntityLiteral and fat_str_len(rhs.name) > 0 do
                        pass6_set_var_type(node.name, rhs.name)
                    eif rhs.node_type == AstType.Identifier and fat_str_len(rhs.name) > 0 do
                        r_ty = pass6_get_var_type(rhs.name)
                        if fat_str_len(r_ty) > 0 do
                            pass6_set_var_type(node.name, r_ty)
                        end
                    eif rhs.node_type == AstType.QuantizeExpr do
                        pass6_set_var_type(node.name, fat_str_new("QuantizedTensor"))
                    eif rhs.node_type == AstType.Call || rhs.node_type == AstType.MethodCall || rhs.node_type == AstType.BuiltinCall do
                        rhs_entity_type = pass6_get_receiver_entity_name(symbols, scopes, rhs)
                        if fat_str_len(rhs_entity_type) > 0 do
                            pass6_set_var_type(node.name, rhs_entity_type)
                        end
                    end
                end
            end
        eif child_count >= 2 do
            lhs = vec_get_rt(node.children, 0)
            rhs = vec_get_rt(node.children, 1)
            if lhs.node_type != AstType.Identifier and lhs.node_type != AstType.FieldAccess and lhs.node_type != AstType.IndexAccess do
                report_error(diag, 3012, node.line, 0)
            end
            if lhs.node_type == AstType.Identifier do
                found = pass6_lookup_chain(symbols, scopes, scope_current_id(scopes), lhs.name)
                if found != -1 do
                    sym = pass6_symbol_at(symbols, found)
                    if sym.kind != SymbolKind.Variable and sym.kind != SymbolKind.Param do
                        pass6_register_local(symbols, scopes, lhs.name, true)
                        found = pass6_lookup_chain(symbols, scopes, scope_current_id(scopes), lhs.name)
                        sym = pass6_symbol_at(symbols, found)
                    end
                    if not sym.is_mutable do
                        report_error(diag, 3003, node.line, 0)
                    end
                    rhs_type = pass6_infer_type(symbols, scopes, rhs)
                    if sym.type_id != 0 and rhs_type != TypeKind.Void and pass6_types_compatible(sym.type_id, rhs_type) == 0 do
                        report_error(diag, 3007, node.line, 0)
                    end
                end
            end
        end
        var i = 0
        when i < child_count loop
            child = vec_get_rt(node.children, i)
            pass6_walk(symbols, scopes, diag, child)
            i = i + 1
        end
        out 0
    end

    # 3. Call Resolution & Argument Count Check
    if node.node_type == AstType.Call do
        child_count = vec_len_rt(node.children)
        found = pass6_lookup_chain(symbols, scopes, scope_current_id(scopes), node.name)
        if found != -1 do
            sym = pass6_symbol_at(symbols, found)
            arg_count = child_count
            # param_count < 0 means unknown (fresh extern stub) — skip arity check.
            if sym.kind == SymbolKind.Func and sym.param_count >= 0 and sym.param_count != arg_count do
                report_error(diag, 3004, node.line, 0)
            end
        end
        extern_decl_raw = pass6_find_extern(node.name)
        if extern_decl_raw != 0 do
            decl = extern_decl_raw as AstNode
            var ai = 0
            var pi = 0
            when ai < child_count and pi < vec_len_rt(decl.children) loop
                    param = vec_get_rt(decl.children, pi)
                    if param.node_type != AstType.Block do
                        expected = pass6_resolve_ffi_type(param.name2)
                        actual = pass6_infer_type(symbols, scopes, vec_get_rt(node.children, ai))
                    # FFI boundaries require exact semantic categories.  The
                    # general assignment checker intentionally treats several
                    # pointer-sized values as compatible, which is unsafe for
                    # a foreign ABI declaration.
                    if expected != TypeKind.Void and actual != TypeKind.Void and expected != actual do
                        report_error(diag, 3007, node.line, 0)
                    end
                    ai = ai + 1
                end
                pi = pi + 1
            end
        end
        var i = 0
        when i < child_count loop
            child = vec_get_rt(node.children, i)
            pass6_walk(symbols, scopes, diag, child)
            i = i + 1
        end
        out 0
    end

    # 4. Index Access Check (Index must be Int, rank matching for tensor)
    if node.node_type == AstType.IndexAccess or node.node_type == AstType.ExprIndex do
        child_count = vec_len_rt(node.children)
        var start_idx = 0
        var is_tensor_base = false
        var expected_rank = 0
        var is_quantized = false
        if node.node_type == AstType.IndexAccess do
            var q_vty = pass6_get_var_type(node.name)
            if fat_cstr_eq(q_vty, "QuantizedTensor") == 1 do
                is_quantized = true
            end
            start_idx = 0
            found_base = pass6_lookup_chain(symbols, scopes, scope_current_id(scopes), node.name)
            if found_base != -1 do
                sym_base = pass6_symbol_at(symbols, found_base)
                if (sym_base.type_id as TypeKind) == TypeKind.Tensor do
                    is_tensor_base = true
                    if sym_base.ast_id != 0 do
                        base_ast = sym_base.ast_id as AstNode
                        if is_tensor_type_str(base_ast.name2) do
                            expected_rank = parse_tensor_rank(base_ast.name2)
                        end
                    end
                end
            end
        else
            start_idx = 1
            if child_count > 0 do
                base_expr = vec_get_rt(node.children, 0)
                if base_expr.node_type == AstType.Identifier do
                    var q_vty2 = pass6_get_var_type(base_expr.name)
                    if fat_cstr_eq(q_vty2, "QuantizedTensor") == 1 do
                        is_quantized = true
                    end
                end
                base_ty = pass6_infer_type(symbols, scopes, base_expr)
                if base_ty == TypeKind.Tensor do
                    is_tensor_base = true
                    if base_expr.node_type == AstType.Identifier do
                        found_expr_base = pass6_lookup_chain(symbols, scopes, scope_current_id(scopes), base_expr.name)
                        if found_expr_base != -1 do
                            expr_sym = pass6_symbol_at(symbols, found_expr_base)
                            if expr_sym.ast_id != 0 do
                                expr_ast = expr_sym.ast_id as AstNode
                                if is_tensor_type_str(expr_ast.name2) do expected_rank = parse_tensor_rank(expr_ast.name2) end
                            end
                        end
                    end
                end
            end
        end
        if is_quantized do
            if g_pass6_ai_mode != 1 do
                report_error(diag, 3023, node.line, 0)
                out 0
            end
        end
        # Check rank if tensor
        if is_tensor_base and expected_rank > 0 do
            given_indices = child_count - start_idx
            if given_indices != expected_rank do
                report_error(diag, 3013, node.line, 0)
            end
        end
        # Check all index expressions are Int
        var ii = start_idx
        when ii < child_count loop
            idx_node = vec_get_rt(node.children, ii)
            idx_type = pass6_infer_type(symbols, scopes, idx_node)
            if idx_type != TypeKind.Void and idx_type != TypeKind.Int do
                report_error(diag, 3015, node.line, 0)
            end
            ii = ii + 1
        end
        var i = 0
        when i < child_count loop
            child = vec_get_rt(node.children, i)
            pass6_walk(symbols, scopes, diag, child)
            i = i + 1
        end
        out 0
    end

    # 4b. Index Assign Check (Index must be Int, rank matching for tensor)
    if node.node_type == AstType.IndexAssign do
        child_count = vec_len_rt(node.children)
        if child_count >= 2 do
            found_base = pass6_lookup_chain(symbols, scopes, scope_current_id(scopes), node.name)
            if found_base != -1 do
                sym_base = pass6_symbol_at(symbols, found_base)
                if (sym_base.type_id as TypeKind) == TypeKind.Tensor and sym_base.ast_id != 0 do
                    base_ast = sym_base.ast_id as AstNode
                    if is_tensor_type_str(base_ast.name2) do
                        expected_rank = parse_tensor_rank(base_ast.name2)
                        num_indices = child_count - 1
                        if expected_rank > 0 and num_indices != expected_rank do
                            report_error(diag, 3013, node.line, 0)
                        end
                        value_node = vec_get_rt(node.children, child_count - 1)
                        value_type = pass6_infer_type(symbols, scopes, value_node)
                        elem_type = parse_tensor_elem_type(base_ast.name2)
                        if value_type != TypeKind.Void and value_type != elem_type and not (elem_type == TypeKind.Float and (value_type == TypeKind.Int or pass6_is_integer_like(value_type) == 1)) do
                            report_error(diag, 3007, node.line, 0)
                        end
                    end
                end
            end
            var ii = 0
            when ii < child_count - 1 loop
                idx_node = vec_get_rt(node.children, ii)
                idx_type = pass6_infer_type(symbols, scopes, idx_node)
                if idx_type != TypeKind.Void and idx_type != TypeKind.Int do
                    report_error(diag, 3015, node.line, 0)
                end
                ii = ii + 1
            end
        end
        var i = 0
        when i < child_count loop
            child = vec_get_rt(node.children, i)
            pass6_walk(symbols, scopes, diag, child)
            i = i + 1
        end
        out 0
    end
    if node.node_type == AstType.BindAttr do
        child_count = vec_len_rt(node.children)
        if child_count > 0 do
            child = vec_get_rt(node.children, 0)
            pass6_walk(symbols, scopes, diag, child)
        end
        out 0
    end

    if node.node_type == AstType.InferBlock do
        old_ai_mode = g_pass6_ai_mode
        if old_ai_mode != 0 do
            report_error(diag, 3016, node.line, 0)
        end
        g_pass6_ai_mode = 1
        child_count = vec_len_rt(node.children)
        var i = 0
        when i < child_count loop
            child = vec_get_rt(node.children, i)
            pass6_walk(symbols, scopes, diag, child)
            i = i + 1
        end
        g_pass6_ai_mode = old_ai_mode
        out 0
    end

    if node.node_type == AstType.TrainBlock do
        old_ai_mode = g_pass6_ai_mode
        if old_ai_mode != 0 do
            report_error(diag, 3016, node.line, 0)
        end
        g_pass6_ai_mode = 2
        child_count = vec_len_rt(node.children)
        var i = 0
        when i < child_count loop
            child = vec_get_rt(node.children, i)
            pass6_walk(symbols, scopes, diag, child)
            i = i + 1
        end
        g_pass6_ai_mode = old_ai_mode
        out 0
    end

    if node.node_type == AstType.ReactiveDecl or node.node_type == AstType.BundleExpr or node.node_type == AstType.ExposeAttr do
        child_count = vec_len_rt(node.children)
        var i = 0
        when i < child_count loop
            child = vec_get_rt(node.children, i)
            pass6_walk(symbols, scopes, diag, child)
            i = i + 1
        end
        out 0
    end

    # 5. FuncDef Scope & Local Parameter Registration
    if node.node_type == AstType.FuncDef do
        scope_push(scopes, ScopeKind.Func)
        child_count = vec_len_rt(node.children)
        body_idx = child_count - 1
        if body_idx < 0 do
            body_idx = 0
        end
        var bi = 0
        when bi < child_count loop
            ch = vec_get_rt(node.children, bi)
            if ch.node_type == AstType.Block do
                body_idx = bi
                bi = child_count
            else
                bi = bi + 1
            end
        end
        var i = 0
        when i < body_idx loop
            param = vec_get_rt(node.children, i)
            sid = pass6_register_local(symbols, scopes, param.name, true)
            if sid != -1 do
                psym = pass6_symbol_at(symbols, sid)
                native_write_i64(psym as i64, 32, param as i64)
                if fat_str_len(param.name2) > 0 and is_tensor_type_str(param.name2) do
                    native_write_i64(psym as i64, 16, TypeKind.Tensor as i64)
                eif psym.type_id == 0 do
                    native_write_i64(psym as i64, 16, TypeKind.Int as i64)
                end
            end
            if fat_str_len(param.name2) > 0 do
                pass6_set_var_type(param.name, param.name2)
            end
            i = i + 1
        end
        var j = body_idx
        when j < child_count loop
            child = vec_get_rt(node.children, j)
            pass6_walk(symbols, scopes, diag, child)
            j = j + 1
        end
        scope_pop(scopes)
        out 0
    end

    if node.node_type == AstType.Block do
        scope_push(scopes, ScopeKind.Block)
        child_count = vec_len_rt(node.children)
        var i = 0
        when i < child_count loop
            child = vec_get_rt(node.children, i)
            pass6_walk(symbols, scopes, diag, child)
            i = i + 1
        end
        scope_pop(scopes)
        out 0
    end

    if node.node_type == AstType.ExternFunc do
        out 0
    end

    if node.node_type == AstType.VarDecl do
        child_count = vec_len_rt(node.children)
        var i = 0
        when i < child_count loop
            child = vec_get_rt(node.children, i)
            pass6_walk(symbols, scopes, diag, child)
            i = i + 1
        end
        sid = pass6_register_local(symbols, scopes, node.name, true)
        if sid != -1 do
            syms_vec = native_read_i64(symbols as i64, 0)
            sym = vec_get_rt(syms_vec, sid)
            native_write_i64(sym as i64, 32, node as i64)
            if fat_str_len(node.name2) > 0 and is_tensor_type_str(node.name2) do
                native_write_i64(sym as i64, 16, TypeKind.Tensor as i64)
            eif child_count > 0 do
                child0 = vec_get_rt(node.children, 0)
                inferred = pass6_infer_type(symbols, scopes, child0)
                if inferred != TypeKind.Void do
                    native_write_i64(sym as i64, 16, inferred as i64)
                end
            end
        end
        var initializer_type = fat_str_new("")
        if child_count > 0 do
            child0 = vec_get_rt(node.children, 0)
            initializer_type = pass6_get_receiver_entity_name(symbols, scopes, child0)
            if child0.node_type == AstType.QuantizeExpr do
                initializer_type = fat_str_new("QuantizedTensor")
            end
        end
        if fat_str_len(initializer_type) > 0 do
            node.name2 = initializer_type
            pass6_set_var_type(node.name, initializer_type)
        eif fat_str_len(node.name2) > 0 do
            pass6_set_var_type(node.name, node.name2)
        end
        if g_pass6_ai_mode == 1 do
            g_pass6_infer_values = vec_push_rt(g_pass6_infer_values, node.name)
        eif g_pass6_ai_mode == 2 do
            g_pass6_train_values = vec_push_rt(g_pass6_train_values, node.name)
        end
        out 0
    end

    if node.node_type == AstType.ConstDecl do
        child_count = vec_len_rt(node.children)
        var i = 0
        when i < child_count loop
            child = vec_get_rt(node.children, i)
            pass6_walk(symbols, scopes, diag, child)
            i = i + 1
        end
        sid = pass6_register_local(symbols, scopes, node.name, false)
        if sid != -1 do
            syms_vec = native_read_i64(symbols as i64, 0)
            sym = vec_get_rt(syms_vec, sid)
            native_write_i64(sym as i64, 32, node as i64)
            if fat_str_len(node.name2) > 0 and is_tensor_type_str(node.name2) do
                native_write_i64(sym as i64, 16, TypeKind.Tensor as i64)
            end
        end
        var initializer_type = fat_str_new("")
        if child_count > 0 do
            child0 = vec_get_rt(node.children, 0)
            initializer_type = pass6_get_receiver_entity_name(symbols, scopes, child0)
        end
        if fat_str_len(initializer_type) > 0 do
            node.name2 = initializer_type
            pass6_set_var_type(node.name, initializer_type)
        eif fat_str_len(node.name2) > 0 do
            pass6_set_var_type(node.name, node.name2)
        end
        out 0
    end

    # Default recurse
    child_count = vec_len_rt(node.children)
    var i = 0
    when i < child_count loop
        child = vec_get_rt(node.children, i)
        pass6_walk(symbols, scopes, diag, child)
        i = i + 1
    end
    out 0
end.

func pass6_lookup_global(symbols: SymbolTable, name: string):
    if g_pass6_global_buckets == 0 do
        out -1
    end
    bid = pass6_hash_name(name)
    bucket = vec_get_rt(g_pass6_global_buckets, bid)
    count = vec_len_rt(bucket)
    syms_vec = native_read_i64(symbols as i64, 0)
    var i = 0
    when i < count loop
        sym_id = vec_get_rt(bucket, i)
        sym = vec_get_rt(syms_vec, sym_id)
        sym_name_ptr = native_read_i64(sym as i64, 8)
        if fat_str_eq(sym_name_ptr as string, name) == 1 do
            out sym_id
        end
        i = i + 1
    end
    out -1
end.

func pass6_lookup_scope_linear(symbols: SymbolTable, scopes: ScopeTree, scope_id: int, name: string):
    if scope_id <= 0 do
        out -1
    end
    scopes_vec = native_read_i64(scopes as i64, 0)
    if scope_id >= vec_len_rt(scopes_vec) do
        out -1
    end
    scope_node = vec_get_rt(scopes_vec, scope_id)
    sym_list = native_read_i64(scope_node as i64, 16)
    count = vec_len_rt(sym_list)
    if count == 0 do
        out -1
    end
    syms_vec = native_read_i64(symbols as i64, 0)
    var i = 0
    when i < count loop
        sym_id = vec_get_rt(sym_list, i)
        sym = vec_get_rt(syms_vec, sym_id)
        sym_name_ptr = native_read_i64(sym as i64, 8)
        if fat_str_eq(sym_name_ptr as string, name) == 1 do
            out sym_id
        end
        i = i + 1
    end
    out -1
end.

func pass6_lookup_chain(symbols: SymbolTable, scopes: ScopeTree, start_scope: int, name: string):
    if fat_str_len(name) == 0 do
        out -1
    end
    # Inner scopes shadow globals (match pass 3 name resolution).
    curr = start_scope
    scopes_vec = native_read_i64(scopes as i64, 0)
    when curr >= 0 loop
        if curr == 0 do
            out pass6_lookup_global(symbols, name)
        end
        found2 = pass6_lookup_scope_linear(symbols, scopes, curr, name)
        if found2 != -1 do
            out found2
        end
        scope_node = vec_get_rt(scopes_vec, curr)
        curr = native_read_i64(scope_node as i64, 8)
    end
    out -1
end.

func pass6_enclosing_func_scope(scopes: ScopeTree, curr_scope: int):
    if curr_scope <= 0 do
        out curr_scope
    end
    scopes_vec = native_read_i64(scopes as i64, 0)
    var s = curr_scope
    when s > 0 loop
        scope_node = vec_get_rt(scopes_vec, s)
        skind = native_read_i64(scope_node as i64, 0)
        if skind == ScopeKind.Func do
            out s
        end
        s = native_read_i64(scope_node as i64, 8)
    end
    out curr_scope
end.

func pass6_register_local(symbols: SymbolTable, scopes: ScopeTree, name: string, is_mutable: bool):
    if fat_str_len(name) == 0 do
        out 0
    end
    curr = scope_current_id(scopes)
    sym = SymbolNode (
        kind: SymbolKind.Variable,
        name_id: name as i64,
        type_id: 0,
        scope_id: curr,
        ast_id: 0,
        is_mutable: is_mutable,
        offset: 0,
        param_count: 0,
        return_type: 0,
        parent_id: -1
    )
    sym_id = symbol_alloc(symbols, sym)
    func_scope = pass6_enclosing_func_scope(scopes, curr)
    scope_add_symbol(scopes, func_scope, sym_id)
    if func_scope != curr do
        scope_add_symbol(scopes, curr, sym_id)
    end
    # Locals live in tiny scopes — found via linear scan.  Only global is hashed.
    if curr == 0 do
        pass6_index_global(name, sym_id)
    end
    out sym_id
end.

export pass6_typecheck

# @vir_source stdlib/vir/compiler/semantic.vri 52
import pass6_typecheck from compiler.sem_pass6_typecheck

# @vir_source stdlib/vir/compiler/sem_pass7_cfa.vri 1
##
 * vir/compiler/sem_pass7_cfa.vri
 * ==============================================================
 * Pass 7: Control Flow Analysis.
 * Checks for break/skip outside loops, unreachable code,
 * and missing return statements.
 ##

import vec_new_rt, vec_push_rt, vec_get_rt, vec_len_rt from vec_rt

import rt_streq, fat_str_eq, fat_str_len, fat_cstr_eq, fat_str_eq, fat_str_len, fat_cstr_eq, rt_strcat, rt_itoa, rt_strlen from string_rt

import AstNode, AstType from parser

import SymbolTable, SymbolKind, SymbolNode from symbol_table

import ScopeTree, ScopeKind, ScopeNode, scope_push, scope_pop from scope_tree

import DiagnosticEngine, report_error, report_warning from context

func pass7_analyze_cfa(symbols: SymbolTable, scopes: ScopeTree, diag: DiagnosticEngine, node: AstNode):
    # Start with loop_depth=0, in_func=0
    pass7_walk(symbols, scopes, diag, node, 0, 0)
end.
func pass7_walk(symbols: SymbolTable, scopes: ScopeTree, diag: DiagnosticEngine, node: AstNode, loop_depth: int, in_func: int):

    if node.node_type == AstType.FuncDef do
        # Check if function has a return type annotation (name2)
        has_return_type = fat_str_len(node.name2) > 0

        scope_push(scopes, ScopeKind.Func)
        child_count = vec_len_rt(node.children)
        body_idx = child_count - 1
        if body_idx < 0 do
            body_idx = 0
        end
        var bi = 0
        when bi < child_count loop
            ch = vec_get_rt(node.children, bi)
            if ch.node_type == AstType.Block do
                body_idx = bi
                bi = child_count
            else
                bi = bi + 1
            end
        end
        has_out = 0
        if child_count > 0 and body_idx < child_count do
            body = vec_get_rt(node.children, body_idx)
            has_out = pass7_walk_block_check_return(symbols, scopes, diag, body, 0)
        end
        var j = body_idx + 1
        when j < child_count loop
            child = vec_get_rt(node.children, j)
            pass7_walk(symbols, scopes, diag, child, 0, 1)
            j = j + 1
        end

        if has_return_type and not has_out do
            report_warning(diag, 4001, node.line, 0)
        end
        scope_pop(scopes)
        out 0
    end

    if node.node_type == AstType.BreakStmt do
        if loop_depth == 0 do
            report_error(diag, 4004, node.line, 0)
        end
        out 0
    end

    if node.node_type == AstType.ContinueStmt do
        if loop_depth == 0 do
            report_error(diag, 4004, node.line, 0)
        end
        out 0
    end

    if node.node_type == AstType.ThrowStmt do
        # Check if throw is inside an ensure block — Error 4005
        # (Not tracked yet, will be added when ensure handling is more complete)
        out 0
    end

    if node.node_type == AstType.LoopStmt or node.node_type == AstType.WhileStmt or node.node_type == AstType.ForRange do
        # Increase loop depth for children
        scope_push(scopes, ScopeKind.Loop)
        child_count = vec_len_rt(node.children)
        var i = 0
        when i < child_count loop
            child = vec_get_rt(node.children, i)
            pass7_walk(symbols, scopes, diag, child, loop_depth + 1, in_func)
            i = i + 1
        end
        scope_pop(scopes)
        out 0
    end

    if node.node_type == AstType.Block do
        # Check for unreachable code
        scope_push(scopes, ScopeKind.Block)
        child_count = vec_len_rt(node.children)
        var found_terminator = 0
        var i = 0
        when i < child_count loop
            child = vec_get_rt(node.children, i)
            if found_terminator == 1 do
                # Code after terminator is unreachable
                report_warning(diag, 4002, child.line, 0)
                # Don't walk unreachable code
                i = child_count
            else
                pass7_walk(symbols, scopes, diag, child, loop_depth, in_func)
                # Check if this child is a terminator
                if child.node_type == AstType.ReturnStmt or child.node_type == AstType.ThrowStmt or child.node_type == AstType.BreakStmt do
                    found_terminator = 1
                end
            end
            i = i + 1
        end
        scope_pop(scopes)
        out 0
    end

    # Default recurse
    child_count = vec_len_rt(node.children)
    var i = 0
    when i < child_count loop
        child = vec_get_rt(node.children, i)
        pass7_walk(symbols, scopes, diag, child, loop_depth, in_func)
        i = i + 1
    end
    out 0
end.
func pass7_walk_block_check_return(symbols: SymbolTable, scopes: ScopeTree, diag: DiagnosticEngine, node: AstNode, loop_depth: int):
    # Returns 1 if this block always has a return/out statement, 0 otherwise
    # Walk children and check the last statement
    if node.node_type == AstType.ReturnStmt do
        out 1
    end
    if node.node_type == AstType.ThrowStmt do
        out 1
    end

    if node.node_type == AstType.Block do
        child_count = vec_len_rt(node.children)
        if child_count == 0 do
            out 0
        end
        # Check if last child always returns
        last = vec_get_rt(node.children, child_count - 1)
        out pass7_walk_block_check_return(symbols, scopes, diag, last, loop_depth)
    end

    if node.node_type == AstType.IfStmt do
        # If-else: both branches must return
        child_count = vec_len_rt(node.children)
        # IfStmt children: [condition, then_block, (optional) else_block]
        if child_count >= 3 do
            then_branch = vec_get_rt(node.children, 1)
            else_branch = vec_get_rt(node.children, 2)
            then_returns = pass7_walk_block_check_return(symbols, scopes, diag, then_branch, loop_depth)
            else_returns = pass7_walk_block_check_return(symbols, scopes, diag, else_branch, loop_depth)
            out then_returns and else_returns
        end
        # If without else doesn't always return
        out 0
    end

    # Default: doesn't return
    out 0
end.

export pass7_analyze_cfa

# @vir_source stdlib/vir/compiler/semantic.vri 55
import pass7_analyze_cfa from compiler.sem_pass7_cfa

# @vir_source stdlib/vir/compiler/sem_pass8_borrow.vri 1
##
 * vir/compiler/sem_pass8_borrow.vri
 * ==============================================================
 * Pass 8: Borrow / Ownership / Lifetime Analysis (Pure Vir AST).
 * Implements rigorous CS affine ownership rules & borrow checking:
 *   - Move semantics for non-copy types (Array, String, Entity, Dict, etc.)
 *   - Use-after-move / Double move detection (E5001)
 *   - Re-assignment / Re-initialization reviving moved variables
 *   - Ownership transfer on by-value function call arguments
 *   - Aliasing XOR Mutability exclusivity (& vs &mut) (E5002, E5003, E5006)
 *   - Moving values while borrowed prevention (E5008)
 *   - Borrow of moved value prevention (E5004)
 *   - Function-local reference escape detection (E5007)
 *   - Region / Arena-allocated lifetime escape detection (E5005)
 ##

import vec_new_rt, vec_push_rt, vec_get_rt, vec_len_rt, vec_set_rt, vec_pop_rt from vec_rt

import rt_streq, fat_str_eq, fat_str_len, fat_str_byte_at, fat_cstr_eq, rt_strcat, rt_itoa, rt_strlen from string_rt

import AstNode, AstType from parser

import SymbolTable, SymbolKind, SymbolNode from symbol_table

import ScopeTree, ScopeKind, ScopeNode, scope_push, scope_pop from scope_tree

import DiagnosticEngine, report_error, report_warning from context

import TypeKind, type_is_move, type_is_copy from type_table

import vir_alloc, vir_free from alloc

# ═══════════════════════════════════════════════════════
# Boxed Vector Helpers (Pointer-safe across recursive walks)
# Box layout: [0]=vec, [8]=lazy name→item hash (256 chain heads).
# Avoids O(n²) linear scans on var_types / moved / locals / borrows.
# ═══════════════════════════════════════════════════════

const PASS8_BUCKETS: int = 256

func pass8_hash_name(name: string):
    let n = fat_str_len(name)
    if n <= 0 do
        out 0
    end
    var h = n * 17
    var i = 0
    when i < n loop
        h = h * 131 + fat_str_byte_at(name, i)
        i = i + 1
    end
    if h < 0 do
        h = 0 - h
    end
    out h mod PASS8_BUCKETS
end.

func pass8_map_new():
    let heads = vir_alloc(PASS8_BUCKETS * 8)
    var i = 0
    when i < PASS8_BUCKETS loop
        native_write_i64(heads, i * 8, 0)
        i = i + 1
    end
    out heads
end.

func pass8_box_new():
    let p = vir_alloc(16)
    native_write_i64(p, 0, vec_new_rt())
    native_write_i64(p, 8, 0)
    out p
end.

func pass8_box_map(b: int):
    out native_read_i64(b, 8)
end.

func pass8_box_ensure_map(b: int):
    var ht = native_read_i64(b, 8)
    if ht == 0 do
        ht = pass8_map_new()
        native_write_i64(b, 8, ht)
    end
    out ht
end.

# Chain node: [0]=next, [8]=item ptr
func pass8_map_index(ht: int, name: string, item: int):
    if fat_str_len(name) == 0 do
        out 0
    end
    if ht == 0 do
        out 0
    end
    let bid = pass8_hash_name(name)
    let node = vir_alloc(16)
    native_write_i64(node, 0, native_read_i64(ht, bid * 8))
    native_write_i64(node, 8, item as i64)
    native_write_i64(ht, bid * 8, node)
    out 0
end.

func pass8_map_unindex_one(ht: int, name: string, item: int):
    if ht == 0 or fat_str_len(name) == 0 do
        out 0
    end
    let bid = pass8_hash_name(name)
    var prev = 0
    var node = native_read_i64(ht, bid * 8)
    var nxt = 0
    var it = 0
    when node != 0 loop
        nxt = native_read_i64(node, 0)
        it = native_read_i64(node, 8)
        if it == item as i64 do
            if prev == 0 do
                native_write_i64(ht, bid * 8, nxt)
            else
                native_write_i64(prev, 0, nxt)
            end
            out 0
        end
        prev = node
        node = nxt
    end
    out 0
end.

func pass8_map_find(ht: int, name: string):
    if ht == 0 or fat_str_len(name) == 0 do
        out 0
    end
    let bid = pass8_hash_name(name)
    let name_ptr = name as i64
    var node = native_read_i64(ht, bid * 8)
    var it = 0
    var nm_ptr = 0
    when node != 0 loop
        it = native_read_i64(node, 8)
        if it >= 4096 do
            nm_ptr = native_read_i64(it, 0)
            if nm_ptr == name_ptr do
                out it
            end
            if fat_str_eq(nm_ptr as string, name) == 1 do
                out it
            end
        end
        node = native_read_i64(node, 0)
    end
    out 0
end.

func pass8_map_count(ht: int, name: string):
    if ht == 0 or fat_str_len(name) == 0 do
        out 0
    end
    let bid = pass8_hash_name(name)
    let name_ptr = name as i64
    var total = 0
    var node = native_read_i64(ht, bid * 8)
    var it = 0
    var nm_ptr = 0
    when node != 0 loop
        it = native_read_i64(node, 8)
        if it >= 4096 do
            nm_ptr = native_read_i64(it, 0)
            if nm_ptr == name_ptr or fat_str_eq(nm_ptr as string, name) == 1 do
                total = total + 1
            end
        end
        node = native_read_i64(node, 0)
    end
    out total
end.

func pass8_box_len(b: int):
    let v = native_read_i64(b, 0)
    out vec_len_rt(v)
end.

func pass8_box_get(b: int, i: int):
    let v = native_read_i64(b, 0)
    out vec_get_rt(v, i)
end.

func pass8_box_set(b: int, i: int, val: int):
    let v = native_read_i64(b, 0)
    vec_set_rt(v, i, val)
end.

func pass8_box_push(b: int, val: int):
    var v = native_read_i64(b, 0)
    v = vec_push_rt(v, val)
    native_write_i64(b, 0, v)
    # Index by name@0 (VarItem and BorrowBinding both store a string there).
    if val >= 4096 do
        let nm = native_read_i64(val, 0) as string
        if fat_str_len(nm) > 0 do
            pass8_map_index(pass8_box_ensure_map(b), nm, val)
        end
    end
end.

func pass8_box_pop(b: int):
    let v = native_read_i64(b, 0)
    out vec_pop_rt(v)
end.

func pass8_box_truncate_to(b: int, watermark: int):
    let v = native_read_i64(b, 0)
    let ht = native_read_i64(b, 8)
    var popped = 0
    var nm = fat_str_new("")
    when vec_len_rt(v) > watermark loop
        popped = vec_pop_rt(v)
        if ht != 0 and popped >= 4096 do
            nm = native_read_i64(popped, 0) as string
            pass8_map_unindex_one(ht, nm, popped)
        end
    end
end.

# ═══════════════════════════════════════════════════════
# VarItem and BorrowBinding Layouts
# ═══════════════════════════════════════════════════════

func pass8_streq(a: string, b: string):
    out fat_str_eq(a, b) == 1
end.

func pass8_strlen(s: string):
    out fat_str_len(s)
end.

func var_item_new(name: string, val: int):
    let p = vir_alloc(16)
    native_write_i64(p, 0, name as i64)
    native_write_i64(p, 8, val as i64)
    out p
end.

func var_item_name(item: int):
    if item < 4096 do
        out fat_str_new("")
    end
    out native_read_i64(item, 0) as string
end.

func var_item_val(item: int):
    if item < 4096 do
        out 0
    end
    out native_read_i64(item, 8)
end.

func var_item_set_val(item: int, val: int):
    if item >= 4096 do
        native_write_i64(item, 8, val as i64)
    end
end.

func borrow_binding_new(lhs: string, target: string, kind: int):
    let p = vir_alloc(24)
    native_write_i64(p, 0, lhs as i64)
    native_write_i64(p, 8, target as i64)
    native_write_i64(p, 16, kind as i64)
    out p
end.

func borrow_binding_lhs(b: int):
    if b < 4096 do
        out fat_str_new("")
    end
    out native_read_i64(b, 0) as string
end.

func borrow_binding_target(b: int):
    if b < 4096 do
        out fat_str_new("")
    end
    out native_read_i64(b, 8) as string
end.

func borrow_binding_kind(b: int):
    if b < 4096 do
        out 0
    end
    out native_read_i64(b, 16)
end.

func pass8_analyze_borrow(symbols: SymbolTable, scopes: ScopeTree, diag: DiagnosticEngine, node: AstNode):
    let moved_vars = pass8_box_new()
    let shared_borrows = pass8_box_new()
    let mut_borrows = pass8_box_new()
    let bound_borrows = pass8_box_new()
    let arena_locals = pass8_box_new()
    let pre_arena_names = pass8_box_new()
    let var_types = pass8_box_new()
    let func_locals = pass8_box_new()
    pass8_walk(symbols, scopes, diag, node, moved_vars, shared_borrows, mut_borrows,
               bound_borrows, arena_locals, pre_arena_names, 0, var_types, func_locals)
end.

func pass8_is_moved(moved_vars: int, name: string):
    if pass8_strlen(name) == 0 do
        out 0
    end
    if pass8_map_find(pass8_box_map(moved_vars), name) != 0 do
        out 1
    end
    out 0
end.

func pass8_mark_moved(moved_vars: int, name: string):
    if pass8_strlen(name) == 0 do
        out 0
    end
    if pass8_is_moved(moved_vars, name) == 0 do
        pass8_box_push(moved_vars, var_item_new(name, 0) as i64)
    end
    out 0
end.

func pass8_unmark_moved(moved_vars: int, name: string):
    if pass8_strlen(name) == 0 do
        out 0
    end
    let item = pass8_map_find(pass8_box_map(moved_vars), name)
    if item == 0 do
        out 0
    end
    let count = pass8_box_len(moved_vars)
    var i = 0
    var v = 0
    when i < count loop
        if pass8_box_get(moved_vars, i) == item do
            pass8_map_unindex_one(pass8_box_map(moved_vars), name, item)
            if i < count - 1 do
                pass8_box_set(moved_vars, i, pass8_box_get(moved_vars, count - 1))
            end
            # Truncate without re-unindexing the swapped tail: pop raw.
            v = native_read_i64(moved_vars, 0)
            vec_pop_rt(v)
            out 0
        end
        i = i + 1
    end
    out 0
end.

# Capture the moves introduced after a watermark.  The snapshot only lives
# while an if-statement is joined; merging creates fresh entries in the
# destination set, so the branch state itself never escapes.
func pass8_snapshot_moved_since(moved_vars: int, watermark: int):
    let snapshot = pass8_box_new()
    let count = pass8_box_len(moved_vars)
    var i = watermark
    when i < count loop
        pass8_box_push(snapshot, pass8_box_get(moved_vars, i))
        i = i + 1
    end
    out snapshot
end.

func pass8_merge_moved(moved_vars: int, snapshot: int):
    let count = pass8_box_len(snapshot)
    var i = 0
    when i < count loop
        let item = pass8_box_get(snapshot, i)
        let name = var_item_name(item)
        if pass8_strlen(name) > 0 do
            pass8_mark_moved(moved_vars, name)
        end
        i = i + 1
    end
    out 0
end.

func pass8_vec_contains(names: int, name: string):
    if pass8_strlen(name) == 0 do
        out 0
    end
    if pass8_map_find(pass8_box_map(names), name) != 0 do
        out 1
    end
    out 0
end.

func pass8_borrow_count(borrows: int, name: string):
    if pass8_strlen(name) == 0 do
        out 0
    end
    out pass8_map_count(pass8_box_map(borrows), name)
end.

func pass8_truncate_to(lst: int, watermark: int):
    pass8_box_truncate_to(lst, watermark)
end.

func pass8_remove_one_borrow(borrows: int, name: string):
    if pass8_strlen(name) == 0 do
        out 0
    end
    let item = pass8_map_find(pass8_box_map(borrows), name)
    if item == 0 do
        out 0
    end
    let len = pass8_box_len(borrows)
    var i = len - 1
    var v = 0
    when i >= 0 loop
        if pass8_box_get(borrows, i) == item do
            pass8_map_unindex_one(pass8_box_map(borrows), name, item)
            if i < len - 1 do
                pass8_box_set(borrows, i, pass8_box_get(borrows, len - 1))
            end
            v = native_read_i64(borrows, 0)
            vec_pop_rt(v)
            out 0
        end
        i = i - 1
    end
    out 0
end.

func pass8_release_borrower(bound_borrows: int, shared_borrows: int, mut_borrows: int, borrower: string):
    if pass8_strlen(borrower) == 0 do
        out 0
    end
    let b = pass8_map_find(pass8_box_map(bound_borrows), borrower)
    if b == 0 do
        out 0
    end
    if borrow_binding_kind(b) == 2 do
        pass8_remove_one_borrow(mut_borrows, borrow_binding_target(b))
    else
        pass8_remove_one_borrow(shared_borrows, borrow_binding_target(b))
    end
    let len = pass8_box_len(bound_borrows)
    var i = 0
    var v = 0
    when i < len loop
        if pass8_box_get(bound_borrows, i) == b do
            pass8_map_unindex_one(pass8_box_map(bound_borrows), borrower, b)
            if i < len - 1 do
                pass8_box_set(bound_borrows, i, pass8_box_get(bound_borrows, len - 1))
            end
            v = native_read_i64(bound_borrows, 0)
            vec_pop_rt(v)
            out 0
        end
        i = i + 1
    end
    out 0
end.

func pass8_claim_borrow(bound_borrows: int, borrower: string, target: string, kind: int):
    pass8_box_push(bound_borrows, borrow_binding_new(borrower, target, kind) as i64)
end.

func pass8_register_var_type(var_types: int, name: string, kind: TypeKind):
    if pass8_strlen(name) == 0 do
        out 0
    end
    let item = pass8_map_find(pass8_box_map(var_types), name)
    if item != 0 do
        var_item_set_val(item, kind as int)
        out 0
    end
    pass8_box_push(var_types, var_item_new(name, kind as int) as i64)
    out 0
end.

func pass8_get_var_type(var_types: int, name: string):
    if pass8_strlen(name) == 0 do
        out TypeKind.Void
    end
    let item = pass8_map_find(pass8_box_map(var_types), name)
    if item != 0 do
        out var_item_val(item) as TypeKind
    end
    out TypeKind.Void
end.

func pass8_infer_expr_type(var_types: int, expr: AstNode):
    if (expr as i64) == 0 do
        out TypeKind.Void
    end
    let t = expr.node_type
    if t == AstType.ArrayLiteral do
        out TypeKind.Array
    end
    if t == AstType.DictLiteral do
        out TypeKind.Dict
    end
    if t == AstType.LiteralStr or t == AstType.InterpExpr do
        out TypeKind.String
    end
    if t == AstType.EntityLiteral do
        out TypeKind.Entity
    end
    if t == AstType.LiteralInt do
        out TypeKind.Int
    end
    if t == AstType.LiteralFloat do
        out TypeKind.Float
    end
    if t == AstType.LiteralBool do
        out TypeKind.Bool
    end
    if t == AstType.LiteralNone do
        out TypeKind.None
    end
    if t == AstType.Identifier do
        out pass8_get_var_type(var_types, expr.name)
    end
    if t == AstType.AddrOf do
        if fat_cstr_eq(expr.name, "mut") == 1 do
            out TypeKind.MutRef
        else
            out TypeKind.Ref
        end
    end
    out TypeKind.Void
end.

func pass8_expr_has_arena_local(expr: AstNode, arena_locals: int, in_arena: int):
    if (expr as i64) == 0 do
        out 0
    end
    if expr.node_type == AstType.Identifier do
        if pass8_vec_contains(arena_locals, expr.name) == 1 do
            out 1
        end
        out 0
    end
    let child_count = vec_len_rt(expr.children)
    var i = 0
    when i < child_count loop
        let child = vec_get_rt(expr.children, i)
        if pass8_expr_has_arena_local(child, arena_locals, in_arena) == 1 do
            out 1
        end
        i = i + 1
    end
    out 0
end.

func pass8_check_arena_escape_assign(diag: DiagnosticEngine, lhs: string, rhs: AstNode,
                                     arena_locals: int, pre_arena_names: int, in_arena: int, line: int):
    if in_arena == 0 do
        out 0
    end
    if pass8_strlen(lhs) == 0 do
        out 0
    end
    if pass8_vec_contains(pre_arena_names, lhs) == 0 do
        out 0
    end
    if pass8_expr_has_arena_local(rhs, arena_locals, in_arena) == 1 do
        report_error(diag, 5005, line, 0)
        out 1
    end
    out 0
end.

func pass8_register_arena_local(arena_locals: int, pre_arena_names: int, name: string, in_arena: int):
    if pass8_strlen(name) == 0 do
        out 0
    end
    if in_arena == 0 do
        if pass8_vec_contains(pre_arena_names, name) == 0 do
            pass8_box_push(pre_arena_names, var_item_new(name, 0) as i64)
        end
        out 0
    end
    if pass8_vec_contains(pre_arena_names, name) == 1 do
        out 0
    end
    if pass8_vec_contains(arena_locals, name) == 0 do
        pass8_box_push(arena_locals, var_item_new(name, 0) as i64)
    end
    out 0
end.

func pass8_check_arena_borrow_escape(diag: DiagnosticEngine, arena_locals: int, pre_arena_names: int,
                                     bound_borrows: int, line: int):
    let count = pass8_box_len(bound_borrows)
    var i = 0
    when i < count loop
        let b = pass8_box_get(bound_borrows, i)
        let tgt = borrow_binding_target(b)
        let lhs = borrow_binding_lhs(b)
        if pass8_vec_contains(arena_locals, tgt) == 1 do
            if pass8_vec_contains(pre_arena_names, lhs) == 1 do
                report_error(diag, 5005, line, 0)
            end
        end
        i = i + 1
    end
    out 0
end.

func pass8_end_stmt(shared_borrows: int, mut_borrows: int, shared_wm: int, mut_wm: int, claimed: int):
    if claimed == 0 do
        pass8_truncate_to(shared_borrows, shared_wm)
        pass8_truncate_to(mut_borrows, mut_wm)
    end
    out 0
end.

func pass8_get_addr_target(node: AstNode):
    if (node as i64) == 0 do
        out fat_str_new("")
    end
    if node.node_type != AstType.AddrOf do
        out fat_str_new("")
    end
    let child_count = vec_len_rt(node.children)
    if child_count < 1 do
        out fat_str_new("")
    end
    let child = vec_get_rt(node.children, 0)
    if child.node_type == AstType.Identifier do
        out child.name
    end
    out fat_str_new("")
end.

func pass8_handle_addr_of(symbols: SymbolTable, scopes: ScopeTree, diag: DiagnosticEngine,
                          node: AstNode, moved_vars: int, shared_borrows: int, mut_borrows: int,
                          bound_borrows: int, arena_locals: int, pre_arena_names: int, in_arena: int,
                          var_types: int, func_locals: int):
    let child_count = vec_len_rt(node.children)
    if child_count < 1 do
        out fat_str_new("")
    end
    let child = vec_get_rt(node.children, 0)
    if child.node_type != AstType.Identifier do
        pass8_walk(symbols, scopes, diag, child, moved_vars, shared_borrows, mut_borrows,
                   bound_borrows, arena_locals, pre_arena_names, in_arena, var_types, func_locals)
        out fat_str_new("")
    end
    let tgt = child.name
    if pass8_strlen(tgt) == 0 do
        out fat_str_new("")
    end
    if pass8_is_moved(moved_vars, tgt) == 1 do
        report_error(diag, 5004, node.line, 0)
        out fat_str_new("")
    end
    var is_mut = 0
    if fat_cstr_eq(node.name, "mut") == 1 do
        is_mut = 1
    end
    if is_mut == 1 do
        if pass8_borrow_count(shared_borrows, tgt) > 0 do
            report_error(diag, 5002, node.line, 0)
        end
        if pass8_borrow_count(mut_borrows, tgt) > 0 do
            report_error(diag, 5003, node.line, 0)
        end
        pass8_box_push(mut_borrows, var_item_new(tgt, 0) as i64)
    else
        if pass8_borrow_count(mut_borrows, tgt) > 0 do
            report_error(diag, 5006, node.line, 0)
        end
        pass8_box_push(shared_borrows, var_item_new(tgt, 0) as i64)
    end
    out tgt
end.

func pass8_process_binding_rhs(symbols: SymbolTable, scopes: ScopeTree, diag: DiagnosticEngine,
                               rhs: AstNode, moved_vars: int, shared_borrows: int, mut_borrows: int,
                               bound_borrows: int, lhs: string, arena_locals: int, pre_arena_names: int, in_arena: int,
                               var_types: int, func_locals: int):
    var claimed = 0
    var borrow_tgt = fat_str_new("")
    var borrow_kind = 0

    if rhs.node_type == AstType.AddrOf do
        borrow_tgt = pass8_handle_addr_of(symbols, scopes, diag, rhs, moved_vars,
                                          shared_borrows, mut_borrows, bound_borrows,
                                          arena_locals, pre_arena_names, in_arena, var_types, func_locals)
        if pass8_strlen(borrow_tgt) > 0 do
            if fat_cstr_eq(rhs.name, "mut") == 1 do
                borrow_kind = 2
            else
                borrow_kind = 1
            end
            pass8_claim_borrow(bound_borrows, lhs, borrow_tgt, borrow_kind)
            claimed = 1
        end
    else
        pass8_walk(symbols, scopes, diag, rhs, moved_vars, shared_borrows, mut_borrows,
                   bound_borrows, arena_locals, pre_arena_names, in_arena, var_types, func_locals)
        if rhs.node_type == AstType.Identifier do
            let rhs_name = rhs.name
            if pass8_is_moved(moved_vars, rhs_name) == 1 do
                report_error(diag, 5001, rhs.line, 0)
            else
                if pass8_borrow_count(shared_borrows, rhs_name) > 0 or pass8_borrow_count(mut_borrows, rhs_name) > 0 do
                    report_error(diag, 5008, rhs.line, 0)
                end
                let rhs_type = pass8_get_var_type(var_types, rhs_name)
                if type_is_move(rhs_type) do
                    pass8_mark_moved(moved_vars, rhs_name)
                end
            end
        end
    end
    out claimed
end.

func pass8_walk_children_stmts(symbols: SymbolTable, scopes: ScopeTree, diag: DiagnosticEngine,
                               node: AstNode, moved_vars: int, shared_borrows: int, mut_borrows: int,
                               bound_borrows: int, arena_locals: int, pre_arena_names: int, in_arena: int,
                               var_types: int, func_locals: int):
    let child_count = vec_len_rt(node.children)
    var i = 0
    var claimed_any = 0
    when i < child_count loop
        let shared_wm = pass8_box_len(shared_borrows)
        let mut_wm = pass8_box_len(mut_borrows)
        let child = vec_get_rt(node.children, i)
        let claimed = pass8_walk(symbols, scopes, diag, child, moved_vars, shared_borrows, mut_borrows,
                                 bound_borrows, arena_locals, pre_arena_names, in_arena, var_types, func_locals)
        if claimed == 1 do
            claimed_any = 1
        end
        pass8_end_stmt(shared_borrows, mut_borrows, shared_wm, mut_wm, claimed)
        i = i + 1
    end
    out claimed_any
end.

func pass8_walk(symbols: SymbolTable, scopes: ScopeTree, diag: DiagnosticEngine, node: AstNode,
                moved_vars: int, shared_borrows: int, mut_borrows: int,
                bound_borrows: int, arena_locals: int, pre_arena_names: int, in_arena: int,
                var_types: int, func_locals: int):
    if (node as i64) == 0 do
        out 0
    end

    # 1. Identifier — check use of moved value
    if node.node_type == AstType.Identifier do
        if pass8_strlen(node.name) > 0 do
            if pass8_is_moved(moved_vars, node.name) == 1 do
                report_error(diag, 5001, node.line, 0)
            end
        end
    end

    # 2. AddrOf
    if node.node_type == AstType.AddrOf do
        pass8_handle_addr_of(symbols, scopes, diag, node, moved_vars, shared_borrows, mut_borrows,
                             bound_borrows, arena_locals, pre_arena_names, in_arena, var_types, func_locals)
        out 0
    end

    # 3. Variable Assignment (x = rhs)
    if node.node_type == AstType.Assign do
        let assign_name = node.name
        if pass8_strlen(assign_name) > 0 do
            # Cannot mutate variable while shared borrow is active
            if pass8_borrow_count(shared_borrows, assign_name) > 0 do
                report_error(diag, 5002, node.line, 0)
            end
            # Cannot mutate variable while mutable borrow is held by another reference
            if pass8_borrow_count(mut_borrows, assign_name) > 0 do
                report_error(diag, 5003, node.line, 0)
            end
        end

        var claimed = 0
        let child_count = vec_len_rt(node.children)
        if child_count > 0 do
            let rhs = vec_get_rt(node.children, 0)
            let rhs_type = pass8_infer_expr_type(var_types, rhs)
            if pass8_strlen(assign_name) > 0 do
                pass8_register_var_type(var_types, assign_name, rhs_type)
                pass8_register_arena_local(arena_locals, pre_arena_names, assign_name, in_arena)
                pass8_check_arena_escape_assign(diag, assign_name, rhs, arena_locals, pre_arena_names, in_arena, node.line)
            end
            if rhs.node_type == AstType.AddrOf do
                # Validate a rebind while the old borrow is still active.
                # Releasing it first would hide &x -> &mut x conflicts.
                let borrow_tgt = pass8_handle_addr_of(symbols, scopes, diag, rhs, moved_vars,
                                                      shared_borrows, mut_borrows, bound_borrows,
                                                      arena_locals, pre_arena_names, in_arena, var_types, func_locals)
                if pass8_strlen(assign_name) > 0 do
                    pass8_release_borrower(bound_borrows, shared_borrows, mut_borrows, assign_name)
                    pass8_unmark_moved(moved_vars, assign_name)
                end
                if pass8_strlen(borrow_tgt) > 0 do
                    var borrow_kind = 1
                    if fat_cstr_eq(rhs.name, "mut") == 1 do
                        borrow_kind = 2
                    end
                    pass8_claim_borrow(bound_borrows, assign_name, borrow_tgt, borrow_kind)
                    claimed = 1
                end
            else
                claimed = pass8_process_binding_rhs(symbols, scopes, diag, rhs, moved_vars,
                                                      shared_borrows, mut_borrows, bound_borrows,
                                                      assign_name, arena_locals, pre_arena_names, in_arena, var_types, func_locals)
                if pass8_strlen(assign_name) > 0 do
                    pass8_release_borrower(bound_borrows, shared_borrows, mut_borrows, assign_name)
                    pass8_unmark_moved(moved_vars, assign_name)
                end
            end
        end
        out claimed
    end

    # 4. Variable / Constant Declaration (let x = init / var x = init)
    if node.node_type == AstType.VarDecl or node.node_type == AstType.ConstDecl do
        var claimed = 0
        let child_count = vec_len_rt(node.children)
        if node.int_val == 16384 do
            var ti = 0
            when ti < child_count loop
                let tuple_child = vec_get_rt(node.children, ti)
                if tuple_child.node_type == AstType.Identifier do
                    pass8_register_arena_local(arena_locals, pre_arena_names, tuple_child.name, in_arena)
                    if pass8_vec_contains(func_locals, tuple_child.name) == 0 do
                        pass8_box_push(func_locals, var_item_new(tuple_child.name, 0) as i64)
                    end
                end
                ti = ti + 1
            end
        else
            pass8_register_arena_local(arena_locals, pre_arena_names, node.name, in_arena)
            if pass8_strlen(node.name) > 0 and pass8_vec_contains(func_locals, node.name) == 0 do
                pass8_box_push(func_locals, var_item_new(node.name, 0) as i64)
            end
        end
        if child_count > 0 do
            let init = vec_get_rt(node.children, child_count - 1)
            var bind_name = node.name
            if node.int_val == 16384 do
                bind_name = fat_str_new("")
            end
            if pass8_strlen(bind_name) > 0 do
                let init_type = pass8_infer_expr_type(var_types, init)
                pass8_register_var_type(var_types, bind_name, init_type)
                pass8_check_arena_escape_assign(diag, bind_name, init, arena_locals, pre_arena_names, in_arena, node.line)
                claimed = pass8_process_binding_rhs(symbols, scopes, diag, init, moved_vars,
                                                      shared_borrows, mut_borrows, bound_borrows,
                                                      bind_name, arena_locals, pre_arena_names, in_arena, var_types, func_locals)
            else
                pass8_walk(symbols, scopes, diag, init, moved_vars, shared_borrows, mut_borrows,
                           bound_borrows, arena_locals, pre_arena_names, in_arena, var_types, func_locals)
            end
        end
        out claimed
    end

    # 5. Function & Method Calls — by-value arguments transfer ownership.
    if node.node_type == AstType.Call or node.node_type == AstType.MethodCall do
        let child_count = vec_len_rt(node.children)
        var i = 0
        when i < child_count loop
            let arg = vec_get_rt(node.children, i)
            # Method-call child 0 is the receiver.  It is an implicit `this`
            # borrow, not a by-value argument, so repeated mutating method
            # calls must not consume the receiver.
            if node.node_type == AstType.MethodCall and i == 0 do
                pass8_walk(symbols, scopes, diag, arg, moved_vars, shared_borrows, mut_borrows,
                           bound_borrows, arena_locals, pre_arena_names, in_arena, var_types, func_locals)
            eif arg.node_type == AstType.AddrOf do
                pass8_handle_addr_of(symbols, scopes, diag, arg, moved_vars, shared_borrows, mut_borrows,
                                     bound_borrows, arena_locals, pre_arena_names, in_arena, var_types, func_locals)
            eif arg.node_type == AstType.Identifier do
                # Do this here instead of delegating to the generic identifier
                # visitor so a repeated call argument produces one E5001.
                let arg_name = arg.name
                if pass8_is_moved(moved_vars, arg_name) == 1 do
                    report_error(diag, 5001, arg.line, 0)
                else
                    let arg_type = pass8_get_var_type(var_types, arg_name)
                    if arg_type == TypeKind.Array do
                        pass8_mark_moved(moved_vars, arg_name)
                    end
                end
            else
                pass8_walk(symbols, scopes, diag, arg, moved_vars, shared_borrows, mut_borrows,
                           bound_borrows, arena_locals, pre_arena_names, in_arena, var_types, func_locals)
            end
            i = i + 1
        end
        out 0
    end

    # 6. Return Statement — verify no local reference / arena reference escape
    if node.node_type == AstType.ReturnStmt do
        let child_count = vec_len_rt(node.children)
        if child_count > 0 do
            let val = vec_get_rt(node.children, 0)
            # Check local reference escape
            if val.node_type == AstType.AddrOf do
                let tgt = pass8_get_addr_target(val)
                if pass8_strlen(tgt) > 0 and pass8_vec_contains(func_locals, tgt) == 1 do
                    report_error(diag, 5007, node.line, 0)
                end
            end
            if val.node_type == AstType.Identifier do
                let binding = pass8_map_find(pass8_box_map(bound_borrows), val.name)
                if binding != 0 do
                    let tgt = borrow_binding_target(binding)
                    if in_arena == 1 and pass8_vec_contains(arena_locals, tgt) == 1 do
                        report_error(diag, 5005, node.line, 0)
                    end
                    if pass8_vec_contains(func_locals, tgt) == 1 do
                        report_error(diag, 5007, node.line, 0)
                    end
                end
            end
            if in_arena == 1 and pass8_expr_has_arena_local(val, arena_locals, in_arena) == 1 do
                report_error(diag, 5005, node.line, 0)
            end
            pass8_walk(symbols, scopes, diag, val, moved_vars, shared_borrows, mut_borrows,
                       bound_borrows, arena_locals, pre_arena_names, in_arena, var_types, func_locals)
        end
        out 0
    end

    # 7. Print / Throw Statements
    if node.node_type == AstType.PrintStmt or node.node_type == AstType.ThrowStmt do
        let child_count = vec_len_rt(node.children)
        var i = 0
        when i < child_count loop
            let child = vec_get_rt(node.children, i)
            pass8_walk(symbols, scopes, diag, child, moved_vars, shared_borrows, mut_borrows,
                       bound_borrows, arena_locals, pre_arena_names, in_arena, var_types, func_locals)
            i = i + 1
        end
        out 0
    end

    # 8. Attribute bindings
    if node.node_type == AstType.BindAttr do
        let child_count = vec_len_rt(node.children)
        if child_count > 0 do
            let child = vec_get_rt(node.children, 0)
            out pass8_walk(symbols, scopes, diag, child, moved_vars, shared_borrows, mut_borrows,
                           bound_borrows, arena_locals, pre_arena_names, in_arena, var_types, func_locals)
        end
        out 0
    end

    if node.node_type == AstType.ExternFunc do
        out 0
    end

    # 9. Function Definition — fresh function-level ownership tracking context
    if node.node_type == AstType.FuncDef do
        scope_push(scopes, ScopeKind.Func)
        let func_moved = pass8_box_new()
        let func_shared = pass8_box_new()
        let func_mut = pass8_box_new()
        let func_bound_borrows = pass8_box_new()
        let func_arena_locals = pass8_box_new()
        let func_pre_arena = pass8_box_new()
        let func_var_types = pass8_box_new()
        let fn_locals = pass8_box_new()

        let child_count = vec_len_rt(node.children)
        var i = 0
        when i < child_count loop
            let child = vec_get_rt(node.children, i)
            if child.node_type == AstType.Identifier or child.node_type == AstType.ParamDef or child.node_type == AstType.RefParam do
                if pass8_strlen(child.name) > 0 do
                    pass8_box_push(fn_locals, var_item_new(child.name, 0) as i64)
                    if child.node_type == AstType.RefParam do
                        pass8_register_var_type(func_var_types, child.name, TypeKind.Ref)
                    else
                        pass8_register_var_type(func_var_types, child.name, TypeKind.Int)
                    end
                end
            end
            pass8_walk(symbols, scopes, diag, child, func_moved, func_shared, func_mut,
                       func_bound_borrows, func_arena_locals, func_pre_arena, 0, func_var_types, fn_locals)
            i = i + 1
        end
        scope_pop(scopes)
        out 0
    end

    # 10. Generic Block — lexical borrow lifetime scope
    if node.node_type == AstType.Block do
        scope_push(scopes, ScopeKind.Block)
        let bound_wm = pass8_box_len(bound_borrows)
        let shared_wm = pass8_box_len(shared_borrows)
        let mut_wm = pass8_box_len(mut_borrows)
        let claimed = pass8_walk_children_stmts(symbols, scopes, diag, node, moved_vars, shared_borrows, mut_borrows,
                                                bound_borrows, arena_locals, pre_arena_names, in_arena, var_types, func_locals)
        # Release block-scoped borrows
        pass8_truncate_to(bound_borrows, bound_wm)
        pass8_truncate_to(shared_borrows, shared_wm)
        pass8_truncate_to(mut_borrows, mut_wm)
        scope_pop(scopes)
        out claimed
    end

    # 11. Arena Block — region lifetime validation
    if node.node_type == AstType.ArenaBlock do
        scope_push(scopes, ScopeKind.Block)
        let moved_wm = pass8_box_len(moved_vars)
        let shared_wm = pass8_box_len(shared_borrows)
        let mut_wm = pass8_box_len(mut_borrows)
        let bound_wm = pass8_box_len(bound_borrows)
        let arena_wm = pass8_box_len(arena_locals)
        pass8_walk_children_stmts(symbols, scopes, diag, node, moved_vars, shared_borrows, mut_borrows,
                                  bound_borrows, arena_locals, pre_arena_names, 1, var_types, func_locals)
        pass8_check_arena_borrow_escape(diag, arena_locals, pre_arena_names, bound_borrows, node.line)
        pass8_truncate_to(moved_vars, moved_wm)
        pass8_truncate_to(shared_borrows, shared_wm)
        pass8_truncate_to(mut_borrows, mut_wm)
        pass8_truncate_to(bound_borrows, bound_wm)
        pass8_truncate_to(arena_locals, arena_wm)
        scope_pop(scopes)
        out 0
    end

    # 12. If joins branch move sets conservatively.  Each branch starts from
    # the condition state; moves from either branch remain moved after merge.
    if node.node_type == AstType.IfStmt do
        scope_push(scopes, ScopeKind.Block)
        let shared_wm = pass8_box_len(shared_borrows)
        let mut_wm = pass8_box_len(mut_borrows)
        let bound_wm = pass8_box_len(bound_borrows)
        let child_count = vec_len_rt(node.children)
        if child_count > 0 do
            let cond = vec_get_rt(node.children, 0)
            pass8_walk(symbols, scopes, diag, cond, moved_vars, shared_borrows, mut_borrows,
                       bound_borrows, arena_locals, pre_arena_names, in_arena, var_types, func_locals)
        end
        let moved_branch_wm = pass8_box_len(moved_vars)
        let shared_branch_wm = pass8_box_len(shared_borrows)
        let mut_branch_wm = pass8_box_len(mut_borrows)
        let bound_branch_wm = pass8_box_len(bound_borrows)
        if child_count > 1 do
            let then_branch = vec_get_rt(node.children, 1)
            let claimed = pass8_walk(symbols, scopes, diag, then_branch, moved_vars, shared_borrows, mut_borrows,
                                     bound_borrows, arena_locals, pre_arena_names, in_arena, var_types, func_locals)
            pass8_end_stmt(shared_borrows, mut_borrows, shared_branch_wm, mut_branch_wm, claimed)
        end
        let moved_then = pass8_snapshot_moved_since(moved_vars, moved_branch_wm)
        pass8_truncate_to(moved_vars, moved_branch_wm)
        pass8_truncate_to(shared_borrows, shared_branch_wm)
        pass8_truncate_to(mut_borrows, mut_branch_wm)
        pass8_truncate_to(bound_borrows, bound_branch_wm)
        if child_count > 2 do
            let else_branch = vec_get_rt(node.children, 2)
            let claimed = pass8_walk(symbols, scopes, diag, else_branch, moved_vars, shared_borrows, mut_borrows,
                                     bound_borrows, arena_locals, pre_arena_names, in_arena, var_types, func_locals)
            pass8_end_stmt(shared_borrows, mut_borrows, shared_branch_wm, mut_branch_wm, claimed)
        end
        pass8_merge_moved(moved_vars, moved_then)
        pass8_truncate_to(shared_borrows, shared_wm)
        pass8_truncate_to(mut_borrows, mut_wm)
        pass8_truncate_to(bound_borrows, bound_wm)
        scope_pop(scopes)
        out 0
    end

    # 13. Control Flow: LoopStmt, WhileStmt, ForRange
    if node.node_type == AstType.LoopStmt or node.node_type == AstType.WhileStmt or node.node_type == AstType.ForRange do
        scope_push(scopes, ScopeKind.Block)
        let moved_wm = pass8_box_len(moved_vars)
        let shared_wm = pass8_box_len(shared_borrows)
        let mut_wm = pass8_box_len(mut_borrows)
        let bound_wm = pass8_box_len(bound_borrows)
        let child_count = vec_len_rt(node.children)
        if child_count > 0 do
            let cond = vec_get_rt(node.children, 0)
            pass8_walk(symbols, scopes, diag, cond, moved_vars, shared_borrows, mut_borrows,
                       bound_borrows, arena_locals, pre_arena_names, in_arena, var_types, func_locals)
        end
        var i = 1
        when i < child_count loop
            let shared_stmt_wm = pass8_box_len(shared_borrows)
            let mut_stmt_wm = pass8_box_len(mut_borrows)
            let child = vec_get_rt(node.children, i)
            let claimed = pass8_walk(symbols, scopes, diag, child, moved_vars, shared_borrows, mut_borrows,
                                     bound_borrows, arena_locals, pre_arena_names, in_arena, var_types, func_locals)
            pass8_end_stmt(shared_borrows, mut_borrows, shared_stmt_wm, mut_stmt_wm, claimed)
            i = i + 1
        end
        pass8_truncate_to(shared_borrows, shared_wm)
        pass8_truncate_to(mut_borrows, mut_wm)
        pass8_truncate_to(bound_borrows, bound_wm)
        scope_pop(scopes)
        out 0
    end

    # 14. Default: walk all child AST nodes
    let child_count = vec_len_rt(node.children)
    var i = 0
    when i < child_count loop
        let child = vec_get_rt(node.children, i)
        pass8_walk(symbols, scopes, diag, child, moved_vars, shared_borrows, mut_borrows,
                   bound_borrows, arena_locals, pre_arena_names, in_arena, var_types, func_locals)
        i = i + 1
    end
    out 0
end.

export pass8_analyze_borrow

# @vir_source stdlib/vir/compiler/semantic.vri 58
import pass8_analyze_borrow from compiler.sem_pass8_borrow

# @vir_source stdlib/vir/compiler/sem_pass9_constfold.vri 1
##
 * vir/compiler/sem_pass9_constfold.vri
 * ==============================================================
 * Pass 9: Constant Folding Analysis.
 * Detects compile-time evaluable expressions and constant propagation.
 * Reports warnings for always-true/false conditions (dead code).
 * Actual folding is deferred to MIR optimizer.
 ##

import vec_new_rt, vec_push_rt, vec_get_rt, vec_len_rt from vec_rt

import rt_streq, fat_str_eq, fat_str_len, fat_cstr_eq, rt_strcat, rt_itoa, rt_strlen from string_rt

import AstNode, AstType, OpType from parser

import SymbolTable, SymbolKind, SymbolNode from symbol_table

import ScopeTree, ScopeKind, ScopeNode, scope_push, scope_pop from scope_tree

import DiagnosticEngine, report_warning from context

import vir_alloc from alloc

func pass9_const_fold(symbols: SymbolTable, scopes: ScopeTree, diag: DiagnosticEngine, node: AstNode):
    # const_map_box: 1-word cell holding vec of (name, value) pairs
    let const_map_box = vir_alloc(8)
    native_write_i64(const_map_box, 0, vec_new_rt())
    pass9_walk(symbols, scopes, diag, node, const_map_box)
end.

func pass9_is_known_const(const_map_box: int, name: string):
    let const_map = native_read_i64(const_map_box, 0)
    let count = vec_len_rt(const_map)
    var i = 0
    when i < count loop
        let cname = vec_get_rt(const_map, i) as string
        if fat_str_eq(cname, name) do
            out 1
        end
        i = i + 2
    end
    out 0
end.

func pass9_get_const_val(const_map_box: int, name: string):
    let const_map = native_read_i64(const_map_box, 0)
    let count = vec_len_rt(const_map)
    var i = 0
    when i < count loop
        let cname = vec_get_rt(const_map, i) as string
        if fat_str_eq(cname, name) do
            out vec_get_rt(const_map, i + 1)
        end
        i = i + 2
    end
    out 0 - 999999
end.

func pass9_add_const(const_map_box: int, name: string, value: int):
    var m = native_read_i64(const_map_box, 0)
    m = vec_push_rt(m, name as i64)
    m = vec_push_rt(m, value as i64)
    native_write_i64(const_map_box, 0, m)
end.

func pass9_is_const_expr(node: AstNode, const_map_box: int):
    if node.node_type == AstType.LiteralInt or node.node_type == AstType.LiteralBool or node.node_type == AstType.LiteralNone do
        out 1
    end
    if node.node_type == AstType.LiteralFloat do
        out 1
    end
    if node.node_type == AstType.LiteralStr do
        out 1
    end
    if node.node_type == AstType.Identifier do
        out pass9_is_known_const(const_map_box, node.name)
    end
    if node.node_type == AstType.BinOp or node.node_type == AstType.Compare do
        let child_count = vec_len_rt(node.children)
        if child_count >= 2 do
            let left = vec_get_rt(node.children, 0)
            let right = vec_get_rt(node.children, 1)
            let left_const = pass9_is_const_expr(left, const_map_box)
            let right_const = pass9_is_const_expr(right, const_map_box)
            out left_const and right_const
        end
    end
    if node.node_type == AstType.UnaryMinus do
        let child_count = vec_len_rt(node.children)
        if child_count > 0 do
            let child = vec_get_rt(node.children, 0)
            out pass9_is_const_expr(child, const_map_box)
        end
    end
    if node.node_type == AstType.PrecompBlock do
        let child_count = vec_len_rt(node.children)
        if child_count > 0 do
            let child = vec_get_rt(node.children, 0)
            out pass9_is_const_expr(child, const_map_box)
        end
    end
    out 0
end.

func pass9_eval_int(node: AstNode, const_map_box: int):
    if node.node_type == AstType.LiteralInt or node.node_type == AstType.LiteralBool or node.node_type == AstType.LiteralNone do
        out node.int_val
    end
    if node.node_type == AstType.Identifier do
        out pass9_get_const_val(const_map_box, node.name)
    end
    if node.node_type == AstType.BinOp do
        let child_count = vec_len_rt(node.children)
        if child_count >= 2 do
            let left = vec_get_rt(node.children, 0)
            let right = vec_get_rt(node.children, 1)
            let lv = pass9_eval_int(left, const_map_box)
            let rv = pass9_eval_int(right, const_map_box)
            if lv == (0 - 999999) or rv == (0 - 999999) do
                out 0 - 999999
            end
            if node.op == OpType.Add do out lv + rv end
            if node.op == OpType.Sub do out lv - rv end
            if node.op == OpType.Mul do out lv * rv end
            if node.op == OpType.Div do
                if rv != 0 do
                    out lv / rv
                end
                out 0 - 999999
            end
            if node.op == OpType.ModOp do
                if rv != 0 do
                    out lv mod rv
                end
                out 0 - 999999
            end
            if node.op == OpType.ShlOp do out lv shl rv end
            if node.op == OpType.ShrOp do out lv shr rv end
            if node.op == OpType.AndOp or node.op == OpType.Land do out lv and rv end
            if node.op == OpType.OrOp or node.op == OpType.Lor do out lv or rv end
            if node.op == OpType.XorOp do out lv xor rv end
        end
    end
    if node.node_type == AstType.PrecompBlock do
        let child_count = vec_len_rt(node.children)
        if child_count > 0 do
            let child = vec_get_rt(node.children, 0)
            out pass9_eval_int(child, const_map_box)
        end
    end
    if node.node_type == AstType.UnaryMinus do
        let child_count = vec_len_rt(node.children)
        if child_count > 0 do
            let child = vec_get_rt(node.children, 0)
            let v = pass9_eval_int(child, const_map_box)
            if v != (0 - 999999) do
                out 0 - v
            end
        end
    end
    out 0 - 999999
end.

func pass9_eval_bool_condition(node: AstNode, const_map_box: int):
    if node.node_type == AstType.Compare do
        let child_count = vec_len_rt(node.children)
        if child_count >= 2 do
            let left = vec_get_rt(node.children, 0)
            let right = vec_get_rt(node.children, 1)
            if pass9_is_const_expr(left, const_map_box) and pass9_is_const_expr(right, const_map_box) do
                let lv = pass9_eval_int(left, const_map_box)
                let rv = pass9_eval_int(right, const_map_box)
                if lv != (0 - 999999) and rv != (0 - 999999) do
                    if node.op == OpType.Eq do
                        if lv == rv do out 1 else out 0 end
                    end
                    if node.op == OpType.Ne do
                        if lv != rv do out 1 else out 0 end
                    end
                    if node.op == OpType.Gt do
                        if lv > rv do out 1 else out 0 end
                    end
                    if node.op == OpType.Lt do
                        if lv < rv do out 1 else out 0 end
                    end
                    if node.op == OpType.Ge do
                        if lv >= rv do out 1 else out 0 end
                    end
                    if node.op == OpType.Le do
                        if lv <= rv do out 1 else out 0 end
                    end
                end
            end
        end
    end
    out 0 - 1
end.

func pass9_walk(symbols: SymbolTable, scopes: ScopeTree, diag: DiagnosticEngine, node: AstNode, const_map_box: int):
    if (node as i64) == 0 do
        out 0
    end

    # Register const declarations for propagation
    if node.node_type == AstType.ConstDecl do
        let child_count = vec_len_rt(node.children)
        if child_count > 0 do
            let init = vec_get_rt(node.children, 0)
            if pass9_is_const_expr(init, const_map_box) do
                let val = pass9_eval_int(init, const_map_box)
                if val != (0 - 999999) do
                    pass9_add_const(const_map_box, node.name, val)
                end
            end
        end
        out 0
    end

    # Check if-conditions for always-true/false
    if node.node_type == AstType.IfStmt do
        let child_count = vec_len_rt(node.children)
        if child_count >= 1 do
            let cond = vec_get_rt(node.children, 0)
            let result = pass9_eval_bool_condition(cond, const_map_box)
            if result == 1 do
                # Condition is always true — warning: else branch is dead code
                if child_count >= 3 do
                    report_warning(diag, 6001, node.line, 0)
                end
            end
            if result == 0 do
                # Condition is always false — warning: if branch is dead code
                report_warning(diag, 6002, node.line, 0)
            end
        end
        # Walk children
        var i = 0
        when i < child_count loop
            let child = vec_get_rt(node.children, i)
            pass9_walk(symbols, scopes, diag, child, const_map_box)
            i = i + 1
        end
        out 0
    end

    # Check while-conditions for always-false
    if node.node_type == AstType.WhileStmt do
        let child_count = vec_len_rt(node.children)
        if child_count >= 1 do
            let cond = vec_get_rt(node.children, 0)
            let result = pass9_eval_bool_condition(cond, const_map_box)
            if result == 0 do
                # While condition is always false — loop body never executes
                report_warning(diag, 6003, node.line, 0)
            end
        end
        var i = 0
        when i < child_count loop
            let child = vec_get_rt(node.children, i)
            pass9_walk(symbols, scopes, diag, child, const_map_box)
            i = i + 1
        end
        out 0
    end

    if node.node_type == AstType.ExternFunc do
        out 0
    end

    # Scoping for blocks / functions
    if node.node_type == AstType.FuncDef do
        scope_push(scopes, ScopeKind.Func)
        let child_count = vec_len_rt(node.children)
        var i = 0
        when i < child_count loop
            let child = vec_get_rt(node.children, i)
            pass9_walk(symbols, scopes, diag, child, const_map_box)
            i = i + 1
        end
        scope_pop(scopes)
        out 0
    end

    if node.node_type == AstType.Block do
        scope_push(scopes, ScopeKind.Block)
        let child_count = vec_len_rt(node.children)
        var i = 0
        when i < child_count loop
            let child = vec_get_rt(node.children, i)
            pass9_walk(symbols, scopes, diag, child, const_map_box)
            i = i + 1
        end
        scope_pop(scopes)
        out 0
    end

    # Default: walk all children
    let child_count = vec_len_rt(node.children)
    var i = 0
    when i < child_count loop
        let child = vec_get_rt(node.children, i)
        pass9_walk(symbols, scopes, diag, child, const_map_box)
        i = i + 1
    end
    out 0
end.

export pass9_const_fold

# @vir_source stdlib/vir/compiler/semantic.vri 61
import pass9_const_fold from compiler.sem_pass9_constfold

# @vir_source stdlib/vir/compiler/sem_pass10_diagnostics.vri 1
##
 * vir/compiler/sem_pass10_diagnostics.vri
 * ==============================================================
 * Pass 10: Diagnostics Emission.
 * Formats and prints all collected diagnostics, returns error count.
 ##

import vec_new_rt, vec_push_rt, vec_get_rt, vec_len_rt from vec_rt

import rt_streq, fat_str_eq, fat_str_len, fat_cstr_eq, fat_str_eq, fat_str_len, fat_cstr_eq, rt_strcat, rt_itoa, rt_strlen from string_rt

import DiagnosticEngine, DiagnosticLevel, Diagnostic from context

func pass10_emit_diagnostics(diag: DiagnosticEngine, source_path: string):
    count = vec_len_rt(diag.diagnostics)
    if count == 0 do
        out 0
    end

    var i = 0
    when i < count loop
        d = vec_get_rt(diag.diagnostics, i)
        pass10_print_one(d, source_path)
        i = i + 1
    end

    # Print summary
    arena:
        let sb = sb_new()
        sb = sb_append(sb, "virc: ")
        sb = sb_append_int(sb, diag.error_count)
        sb = sb_append(sb, " error(s), ")
        var warn_count = count - diag.error_count
        sb = sb_append_int(sb, warn_count)
        sb = sb_append(sb, " warning(s)")
        print_ln(sb_to_string(sb))
        sb_free(sb)
    end

    out diag.error_count
end.
func pass10_code_to_prefix(level: DiagnosticLevel):
    if level == DiagnosticLevel.Warning do
        out "W"
    eif level == DiagnosticLevel.Info do
        out "I"
    end
    out "E"
end.

func pass10_code_to_result(level: DiagnosticLevel):
    if level == DiagnosticLevel.Warning do
        out "WARNING"
    eif level == DiagnosticLevel.Info do
        out "INFO"
    end
    out "FAILED"
end.

func pass10_code_to_phase(code: int):
    if code < 1000 do out "Lexer" end
    if code < 2000 do out "Parser" end
    if code < 4000 do out "Semantic" end
    if code < 5000 do out "ControlFlow" end
    if code < 6000 or (code >= 8000 and code < 9000) do out "BorrowChecker" end
    if code >= 7000 and code < 8000 do out "ModuleResolver" end
    out "Compiler"
end.

func pass10_code_to_msg(code: int):
    # Lexer errors (E0xxx)
    if code == 1 or code == 101 do out "Invalid character in source" end
    if code == 2 or code == 102 do out "Unterminated string literal" end
    if code == 3 or code == 103 do out "Invalid numeric literal format" end

    # Parser errors (E1xxx)
    if code == 1001 do out "Unexpected token in syntax rule" end
    if code == 1002 do out "Missing block delimiter 'end' or 'end.'" end
    if code == 1003 do out "Missing colon ':' after condition or signature" end
    if code == 1004 do out "Invalid expression syntax" end
    if code == 1005 do out "Unexpected end of file (EOF)" end
    if code == 1006 do out "Invalid function signature" end
    if code == 1007 do out "Mismatched parentheses or brackets" end

    # Semantic & Type errors (E2xxx / E3xxx)
    if code == 2001 or code == 1002 do out "Undefined variable in current scope" end
    if code == 2002 or code == 1003 do out "Undefined function or symbol" end
    if code == 2003 or code == 3001 do out "Type mismatch in expression or operation" end
    if code == 2004 or code == 1001 do out "Duplicate symbol definition in current scope" end
    if code == 2005 or code == 3012 do out "Invalid assignment target (not an l-value)" end
    if code == 3002 do out "Invalid operator for operand type" end
    if code == 3003 do out "Assignment to immutable variable (declared with 'let')" end
    if code == 3004 do out "Type mismatch in variable assignment" end
    if code == 3005 do out "Wrong argument count in function invocation" end
    if code == 3006 do out "Invalid operand types for and/or/xor/shl/shr" end
    if code == 3007 do out "Assignment or return value type does not match declared type" end
    if code == 3008 or code == 1004 do out "Unknown entity field access" end
    if code == 3009 do out "Operation prohibited in 'infer:' block (e.g. calling .backward())" end
    if code == 3010 do out "Duplicate field in entity initialization" end
    if code == 3011 do out "Field type mismatch in entity instantiation" end
    if code == 3013 do out "Tensor indexing rank mismatch" end
    if code == 3014 do out "Matrix multiplication dimension mismatch" end
    if code == 3015 do out "Tensor index must be integer" end
    if code == 3016 do out "infer/train blocks cannot be nested" end
    if code == 3017 do out ".backward() is only valid inside a train block" end
    if code == 3018 do out "quantize input must be a floating-point tensor" end
    if code == 3019 do out "quantize bits must be a compile-time constant in {4, 8, 16, 32}" end
    if code == 3020 do out ".backward() receiver must be a floating-point train value with gradient state" end
    if code == 3021 do out "Unresolved UFCS member: no entity method, callable field, or free function" end
    if code == 3022 do out "Wrong argument count in UFCS invocation" end
    if code == 3023 do out "Quantized tensor operations are only supported inside an 'infer:' block" end
    if code == 3024 do out "Invalid tensor type; expected tensor<T>[S...] with T in {f32, f16, i8, u8, i32} and positive compile-time dimensions" end
    if code == 3025 do out "Packed entity field missing type annotation" end
    if code == 3026 do out "Invalid packed entity field type; must be compile-time fixed-size primitive or packed entity" end
    if code == 3027 do out "Recursive packed entity layout cycle detected" end
    if code == 3028 do out "Normal entity cannot be embedded inline in packed entity" end
    if code == 3029 do out "Missing required field in packed entity initialization" end
    if code == 3030 do out "Integer literal value out of range for packed field type" end

    # Control Flow errors (E4xxx)
    if code == 4001 do out "Missing return statement on some code paths" end
    if code == 4002 do out "Unreachable code detected" end
    if code == 4003 do out "Dead code — condition is always constant" end
    if code == 4004 do out "Loop control statement 'break' or 'skip' outside loop body" end

    # Borrow Checker errors (E5xxx / E8xxx)
    if code == 5001 or code == 8001 do out "Use of moved value" end
    if code == 5002 or code == 8002 do out "Cannot borrow as mutable while shared borrow is active" end
    if code == 5003 do out "Cannot borrow as mutable more than once (aliasing violation)" end
    if code == 5004 do out "Borrow of moved value" end
    if code == 5005 or code == 8004 do out "Arena-allocated value escapes its block scope" end
    if code == 5006 do out "Cannot borrow as shared while mutable borrow is active" end
    if code == 5007 do out "Reference to local variable escapes function scope" end
    if code == 5008 do out "Cannot move value while active borrow exists" end
    if code == 5009 do out "Cannot mutate variable while shared borrow is active" end

    # Fallback
    let sb = sb_new()
    sb = sb_append(sb, "Compiler diagnostic code ")
    sb = sb_append_int(sb, code)
    out sb_to_string(sb)
end.

func pass10_code_to_causes(code: int):
    if code == 2001 or code == 1002 do
        out "• Variable was not declared in current or outer scope\n• Typo in variable identifier name"
    end
    if code == 2002 or code == 1003 do
        out "• Function name was misspelled\n• Missing 'import' statement from module"
    end
    if code == 3003 do
        out "• Variable was declared with 'let' (immutable binding)\n• Reassignment is only allowed for 'var' variables"
    end
    if code == 3009 do
        out "• Automatic differentiation (.backward()) was invoked inside 'infer:'\n• 'infer:' disables gradient tape recording for forward inference"
    end
    if code == 3021 do
        out "• Receiver type has no matching method or callable field\n• No visible free function accepts the receiver as its first argument"
    end
    if code == 3022 do
        out "• Explicit argument count does not match the resolved method\n• Free-function UFCS counts the receiver as argument zero"
    end
    if code == 3023 do
        out "• Quantized tensor indexed or used outside 'infer:' block\n• Spec §26.5 requires quantized operations to reside in 'infer:' blocks"
    end
    if code == 5001 or code == 8001 do
        out "• Value ownership was transferred to another variable or function\n• Attempted to read from an invalidated source"
    end
    if code == 5005 or code == 8004 do
        out "• Reference allocated in 'arena:' block assigned to longer-lived variable\n• Pointer would dangle after arena destruction"
    end
    if code == 5007 do
        out "• Reference to stack-allocated local variable was returned from function\n• Stack frame is deallocated upon return, causing dangling pointer"
    end
    if code == 5008 do
        out "• Variable ownership transfer attempted while an active reference (& or &mut) is held\n• Moving would invalidate the memory location referenced by the borrow"
    end
    if code == 5009 do
        out "• Assignment or modification attempted while shared reference (&) is held\n• Violates shared borrow immutability guarantee"
    end
    if code == 4004 do
        out "• 'break' or 'skip' placed outside 'loop' or 'when ... loop'"
    end
    out "• Violation of Vir language specification semantic constraints"
end.

func pass10_code_to_actions(code: int):
    if code == 2001 or code == 1002 do
        out "• Declare variable with 'var <name> = <val>' before use\n• Check identifier spelling"
    end
    if code == 2002 or code == 1003 do
        out "• Verify function definition exists or add import statement"
    end
    if code == 3003 do
        out "• Change 'let' to 'var' at variable declaration site"
    end
    if code == 3009 do
        out "• Move .backward() call into a 'train:' block"
    end
    if code == 3021 do
        out "• Define the method/callable field/free function or correct its name"
    end
    if code == 3022 do
        out "• Pass exactly the parameters required by the resolved UFCS callee"
    end
    if code == 3023 do
        out "• Move quantized tensor indexing or inference into an 'infer:' block"
    end
    if code == 5001 or code == 8001 do
        out "• Borrow reference with '&' or clone value before move"
    end
    if code == 5005 or code == 8004 do
        out "• Copy data out of arena or expand arena block lifetime"
    end
    if code == 5007 do
        out "• Return value by ownership (move) or allocate in heap/arena"
    end
    if code == 5008 do
        out "• Release or scope-limit the borrow before moving the owner value"
    end
    if code == 5009 do
        out "• Complete reading through shared reference before mutating the owner"
    end
    if code == 4004 do
        out "• Enclose statement within an active loop construct"
    end
    out "• Review source code against Vir language specification"
end.

func pass10_print_one(d: Diagnostic, source_path: string):
    arena:
        print_ln("═══════════════════════════════════════════════")
        print_ln("EXECUTION REPORT")
        print_ln("═══════════════════════════════════════════════")
        print_ln("")

        let sb = sb_new()
        sb = sb_append(sb, "Result      : ")
        sb = sb_append(sb, pass10_code_to_result(d.level))
        print_ln(sb_to_string(sb))
        sb_free(sb)

        let sb_code = sb_new()
        sb_code = sb_append(sb_code, "Code        : [")
        sb_code = sb_append(sb_code, pass10_code_to_prefix(d.level))
        if d.message < 1000 do
            sb_code = sb_append(sb_code, "0")
        end
        if d.message < 100 do
            sb_code = sb_append(sb_code, "0")
        end
        if d.message < 10 do
            sb_code = sb_append(sb_code, "0")
        end
        sb_code = sb_append_int(sb_code, d.message)
        sb_code = sb_append(sb_code, "] ")
        sb_code = sb_append(sb_code, pass10_code_to_phase(d.message))
        print_ln(sb_to_string(sb_code))
        sb_free(sb_code)

        print_ln("Subsystem   : Compiler")
        print_ln("Stage       : Stage 1 (Vir Native)")
        print_ln("")

        print_ln("Location")
        print_ln("───────────────────────────────────────────────")
        let sb_loc = sb_new()
        sb_loc = sb_append(sb_loc, "File        : ")
        sb_loc = sb_append(sb_loc, source_path)
        print_ln(sb_to_string(sb_loc))
        sb_free(sb_loc)

        let sb_line = sb_new()
        sb_line = sb_append(sb_line, "Line        : ")
        sb_line = sb_append_int(sb_line, d.line)
        print_ln(sb_to_string(sb_line))
        sb_free(sb_line)

        if d.col > 0 do
            let sb_col = sb_new()
            sb_col = sb_append(sb_col, "Column      : ")
            sb_col = sb_append_int(sb_col, d.col)
            print_ln(sb_to_string(sb_col))
            sb_free(sb_col)
        end
        print_ln("")

        print_ln("Analysis")
        print_ln("───────────────────────────────────────────────")
        print_ln(pass10_code_to_msg(d.message))
        print_ln("")

        print_ln("Possible Causes")
        print_ln("───────────────────────────────────────────────")
        print_ln(pass10_code_to_causes(d.message))
        print_ln("")

        print_ln("Action")
        print_ln("───────────────────────────────────────────────")
        print_ln(pass10_code_to_actions(d.message))
        print_ln("")

        print_ln("═══════════════════════════════════════════════")
    end
end.

export pass10_emit_diagnostics

# @vir_source stdlib/vir/compiler/semantic.vri 64
import pass10_emit_diagnostics from compiler.sem_pass10_diagnostics

var g_semantic_err_count: int = 0

func semantic_run(ast: AstNode, source_path: string, verbose: int):
    arena:
        # Initialize subsystems
        let types = type_table_new()
        let symbols = symbol_table_new()
        let scopes = scope_tree_new()
        let diag = diagnostic_engine_new()

        # ── Pass 1: Module & Import Resolution ──
        if verbose == 1 do
            print_ln("virc: semantic pass 1 — module & import resolution")
        end
        pass1_collect_modules(symbols, scopes, diag, ast)

        # ── Pass 2: Symbol Registration ──
        if verbose == 1 do
            print_ln("virc: semantic pass 2 — symbol registration")
        end
        scope_reset(scopes)
        pass2_register_symbols(symbols, scopes, diag, ast)

        # ── Pass 3: Name Resolution ──
        if verbose == 1 do
            print_ln("virc: semantic pass 3 — name resolution")
        end
        scope_reset(scopes)
        pass3_resolve_names(symbols, scopes, diag, ast)

        # ── Pass 4: Type Resolution ──
        if verbose == 1 do
            print_ln("virc: semantic pass 4 — type resolution")
        end
        scope_reset(scopes)
        pass4_resolve_types(symbols, scopes, ast)

        # ── Pass 5: Type Inference ──
        if verbose == 1 do
            print_ln("virc: semantic pass 5 — type inference")
        end
        scope_reset(scopes)
        pass5_infer_types(symbols, scopes, ast)

        # ── Pass 6: Type Checking ──
        if verbose == 1 do
            print_ln("virc: semantic pass 6 — type checking")
        end
        scope_reset(scopes)
        pass6_typecheck(symbols, scopes, diag, ast)

        # ── Pass 7: Control Flow Analysis ──
        if verbose == 1 do
            print_ln("virc: semantic pass 7 — control flow analysis")
        end
        scope_reset(scopes)
        pass7_analyze_cfa(symbols, scopes, diag, ast)

        # ── Pass 8: Borrow / Ref Analysis ──
        if verbose == 1 do
            print_ln("virc: semantic pass 8 — borrow analysis")
        end
        scope_reset(scopes)
        pass8_analyze_borrow(symbols, scopes, diag, ast)

        # ── Pass 9: Constant Folding Analysis ──
        if verbose == 1 do
            print_ln("virc: semantic pass 9 — constant folding")
        end
        scope_reset(scopes)
        pass9_const_fold(symbols, scopes, diag, ast)

        # ── Pass 10: Diagnostics Emission ──
        let err_count = pass10_emit_diagnostics(diag, source_path)
        g_semantic_err_count = err_count

        if verbose == 1 do
            if err_count == 0 do
                print_ln("virc: semantic analysis 100% complete (10 passes)")
            else
                let sb = sb_new()
                sb = sb_append(sb, "virc: semantic analysis found ")
                sb = sb_append_int(sb, err_count)
                sb = sb_append(sb, " error(s)")
                print_ln(sb_to_string(sb))
                sb_free(sb)
            end
        end
    end

    out g_semantic_err_count
end.

export semantic_run

# @vir_source stdlib/vir/compiler/virc.vri 55
import semantic_run from vir.compiler.semantic
# @vir_source stdlib/vir/compiler/mir.vri 1
##
 * vir/compiler/mir.vri — Mid-level Intermediate Representation
 * ==============================================================
 * Converted from C (core/include/mir.h) for self-hosting.
 * Implements SSA (Static Single Assignment) form and CFG.
 * Unified block edges: successors/preds Vec (matches ast_to_mir).
 ##

import vec_new_rt, vec_push_rt, vec_get_rt, vec_len_rt, vec_set_rt from vec_rt
import rt_streq, fat_str_eq, fat_str_len, fat_str_byte_at, native_read_i64 from string_rt

enum MirType:
	None = 0
	Int8 = 1
	Int16 = 2
	Int32 = 3
	Int64 = 4
	F16 = 5
	F32 = 6
	F64 = 7
	Ptr = 8
	Vector = 9
	Tensor = 10
end.

enum MirOp:
 Nop = 0
 Move = 1
 Load = 2
 Store = 3
 Add = 4
 Sub = 5
 Mul = 6
 Div = 7
 Call = 8
 Intrinsic = 9
 Jump = 10
 JumpIf = 11
 Return = 12
 CmpEq = 13
 CmpNe = 14
 CmpGt = 15
 CmpLt = 16
 CmpGe = 17
 CmpLe = 18
 Mod = 19
    # Call ABI: SetArg(index, value)* then Call(dst, nargs).
 SetArg = 20
 JumpIfNot = 21
    # Bitwise / logic ISA (Spec §30)
 And = 22
 BitAnd = 22
 Or = 23
 Xor = 24
 Shl = 25
 Shr = 26
 Not = 27
    # Power + ML (§26 / §30 prec 30 & 22)
 Pow = 28
 MatMul = 29
 Fma = 30
end.

# Intrinsic kind codes (MirInstr.src2.imm when op == Intrinsic).
# Keep in sync with MUST_READ_CONTEXT/AST_TO_MIR_LOWERING_CHECKLIST.md
const MIR_INTR_STR_LIT: i64 = 1
const MIR_INTR_PRINT: i64 = 2
const MIR_INTR_ARRAY: i64 = 3
const MIR_INTR_TUPLE: i64 = 4
const MIR_INTR_ENTITY: i64 = 5
const MIR_INTR_ADDR_OF: i64 = 6
const MIR_INTR_INTERP: i64 = 7
const MIR_INTR_BUILTIN: i64 = 8
const MIR_INTR_INDEX: i64 = 9
const MIR_INTR_FIELD: i64 = 10
const MIR_INTR_MATCH_PAT: i64 = 11
const MIR_INTR_INPUT: i64 = 12
const MIR_INTR_ENUM: i64 = 13
const MIR_INTR_CAST: i64 = 14
const MIR_INTR_THROW: i64 = 15
const MIR_INTR_CANCEL: i64 = 16
const MIR_INTR_QUIET: i64 = 17
const MIR_INTR_ARENA: i64 = 18
const MIR_INTR_ENSURE: i64 = 19
const MIR_INTR_REVERT: i64 = 20
const MIR_INTR_INDEX_STORE: i64 = 21
const MIR_INTR_FIELD_STORE: i64 = 22
const MIR_INTR_STR_EQ: i64 = 23
const MIR_INTR_CHECK_CPU: i64 = 24
const MIR_INTR_PATCH_POINT: i64 = 25
const MIR_INTR_DECL: i64 = 26; # src1=AstType#; SetArg0=name pool id
const MIR_INTR_AWAIT: i64 = 27
const MIR_INTR_NOP_MARKER: i64 = 28; # reserved / debug
const MIR_INTR_TASK: i64 = 29
const MIR_INTR_WAIT: i64 = 30
const MIR_INTR_SELECT: i64 = 31
const MIR_INTR_SEND: i64 = 32
const MIR_INTR_RECV: i64 = 33
const MIR_INTR_EMIT: i64 = 34
const MIR_INTR_ERX: i64 = 35
const MIR_INTR_TRY: i64 = 36
const MIR_INTR_RESUME: i64 = 37
const MIR_INTR_LOCK: i64 = 38
const MIR_INTR_SWIZZLE: i64 = 39
const MIR_INTR_INFER: i64 = 40
const MIR_INTR_TRAIN: i64 = 41
const MIR_INTR_QUANTIZE: i64 = 42
const MIR_INTR_AWAIT_PASS: i64 = 43
const MIR_INTR_SAFE_ACCESS: i64 = 44
const MIR_INTR_ATOMIC: i64 = 45
const MIR_INTR_EXIST: i64 = 46; # postfix `?`
const MIR_INTR_PATTERN: i64 = 47; # `a :~ b`
const MIR_INTR_MAP: i64 = 48
const MIR_INTR_ARR_COMPACT: i64 = 49
const MIR_INTR_BUNDLE: i64 = 50
const MIR_INTR_TIMEOUT: i64 = 51
const MIR_INTR_ISOLATE: i64 = 52
const MIR_INTR_ERROR: i64 = 53; # `error` keyword expr
const MIR_INTR_PRECOMP: i64 = 54
const MIR_INTR_REACTIVE: i64 = 55
const MIR_INTR_MORPH: i64 = 56
const MIR_INTR_EXPOSE: i64 = 57
const MIR_INTR_PTR: i64 = 58
const MIR_INTR_ASYNC: i64 = 59; # async func marker (name2)
const MIR_INTR_ATOMIC_VAR: i64 = 60
const MIR_INTR_PRINT_STR: i64 = 61
const MIR_INTR_TENSOR_ALLOC: i64 = 62
const MIR_INTR_TENSOR_GET: i64 = 63
const MIR_INTR_TENSOR_SET: i64 = 64
const MIR_INTR_BIT_EXTRACT: i64 = 65
const MIR_INTR_BIT_INSERT: i64 = 66
const MIR_INTR_BACKWARD: i64 = 67
const MIR_INTR_PERCENT: i64 = 68
# ABI param bind: dst ← physical arg register src1.imm (0=X0…). Not an RT stub id.
const MIR_INTR_PARAM: i64 = 100
# Native module globals live in reserved slots at the base of the arena heap.
# GLOBAL_LOAD:  dst <- global[src1.imm]
# GLOBAL_STORE: global[dst.imm] <- src1
const MIR_INTR_GLOBAL_LOAD: i64 = 101
const MIR_INTR_GLOBAL_STORE: i64 = 102
enum MirOperandType:
 None = 0
 VReg = 1
 Imm = 2
 Block = 3
end.
entity MirOperand:
 op_type: MirOperandType,
 vreg: i64,
 imm: i64,
 block_id: i64
end.
func mir_opnd_new(op_type: i64, vreg: i64, imm: i64, block_id: i64):
    p = alloc(32)
    native_write_i64(p, 0, op_type)
    native_write_i64(p, 8, vreg)
    native_write_i64(p, 16, imm)
    native_write_i64(p, 24, block_id)
    out p
end.

func mir_instr_new(op: i64, dst: i64, src1: i64, src2: i64):
    p = alloc(40)
    p = alloc(48)
    native_write_i64(p, 0, op)
    native_write_i64(p, 8, dst)
    native_write_i64(p, 16, src1)
    native_write_i64(p, 24, src2)
    native_write_i64(p, 32, 0)
    native_write_i64(p, 40, 0)
    out p
end.

func mir_opnd_none():
    out mir_opnd_new(0, 0, 0, 0)
end.
func mir_opnd_vreg(r: i64):
    out mir_opnd_new(1, r, 0, 0)
end.
func mir_opnd_imm(val: i64):
    out mir_opnd_new(2, 0, val, 0)
end.
func mir_opnd_block(id: i64):
    out mir_opnd_new(3, 0, 0, id)
end.
entity MirInstr:
 op: MirOp,
 dst: MirOperand,
 src1: MirOperand,
 src2: MirOperand,
 next: i64
end.
entity MirPhi:
 dst_vreg: i64,
 orig_vreg: i64,
 incoming_values: i64,
 incoming_blocks: i64,
 next: i64
end.
entity MirUse:
 instr_idx: i64,
 phi_idx: i64,
 opnd_idx: i64,
 next: i64
end.
entity MirBlock:
 id: i64,
 phis: i64,
 head: i64,
 tail: i64,
 successors: i64,
 preds: i64,
 idom: i64,
 dom_children: i64,
 df: i64,
 next_block: i64
end.
entity MirFunc:
 id: i64,
 name: string,
 next_vreg: i64,
 def_uses: i64,
 next_block_id: i64,
 entry_block: i64,
 blocks: i64,
 strings: i64, # Vec<string> — LiteralStr / Call callee / Field names
 var_buckets: i64 # Vec<Vec<VarMap>> — locals live with the func, not MirBuilder
end.

func mir_str_hash_64(s: string):
    n = fat_str_len(s as int) as i64
    h = n * 17
    var i = 0
    when i < n loop
        h = h * 131 + (fat_str_byte_at(s as int, i) as i64)
        i = i + 1
    end
    if h < 0 do h = 0 - h end
    out h mod 64
end.

func mir_func_new(id: i64, name: string, next_vreg: i64, def_uses: i64, next_block_id: i64, entry_block: i64, blocks: i64, strings: i64, var_buckets: i64):
    p = alloc(80)
    native_write_i64(p, 0, id)
    native_write_i64(p, 8, name as i64)
    native_write_i64(p, 16, next_vreg)
    native_write_i64(p, 24, def_uses)
    native_write_i64(p, 32, next_block_id)
    native_write_i64(p, 40, entry_block)
    native_write_i64(p, 48, blocks)
    native_write_i64(p, 56, strings)
    native_write_i64(p, 64, var_buckets)
    native_write_i64(p, 72, 0)
    out p
end.

func mir_create_func(id: i64):
    out mir_func_new(id, "", 0, vec_new_rt(), 0, 0 - 1, 0 - 1, vec_new_rt(), vec_new_rt())
end.

func mir_intern_string(f: MirFunc, s: string):
    f_strings = native_read_i64(f as i64, 56)
    var buckets = native_read_i64(f as i64, 72)
    if buckets == 0 do
        buckets = vec_new_rt()
        var bi = 0
        when bi < 64 loop
            buckets = vec_push_rt(buckets, 0)
            bi = bi + 1
        end
        native_write_i64(f as i64, 72, buckets)
    end
    bid = mir_str_hash_64(s)
    bucket = vec_get_rt(buckets, bid)
    slen = fat_str_len(s as int)
    if bucket != 0 do
        bn = vec_len_rt(bucket)
        var j = 0
        when j < bn loop
            idx = vec_get_rt(bucket, j)
            curr = vec_get_rt(f_strings, idx)
            if fat_str_len(curr as int) == slen do
                if fat_str_eq(curr, s) == 1 do
                    out (f, idx)
                end
            end
            j = j + 1
        end
    else
        bucket = vec_new_rt()
    end
    n = vec_len_rt(f_strings)
    f_strings = vec_push_rt(f_strings, s)
    native_write_i64(f as i64, 56, f_strings)
    bucket = vec_push_rt(bucket, n)
    vec_set_rt(buckets, bid, bucket)
    out (f, n)
end.

func mir_block_new(id: i64, phis: i64, head: i64, tail: i64, successors: i64, preds: i64, idom: i64, dom_children: i64, df: i64, next_block: i64):
    p = alloc(80)
    native_write_i64(p, 0, id)
    native_write_i64(p, 8, phis)
    native_write_i64(p, 16, head)
    native_write_i64(p, 24, tail)
    native_write_i64(p, 32, successors)
    native_write_i64(p, 40, preds)
    native_write_i64(p, 48, idom)
    native_write_i64(p, 56, dom_children)
    native_write_i64(p, 64, df)
    native_write_i64(p, 72, next_block)
    out p
end.

func mir_create_block(id: i64):
    out mir_block_new(id, vec_new_rt(), vec_new_rt(), 0, vec_new_rt(), vec_new_rt(), 0 - 1, vec_new_rt(), vec_new_rt(), 0 - 1)
end.

# Exact tags for MIR_/LIR — keep in sync with MUST_READ_CONTEXT/MIR_OPCODE_REGISTRY.md
func mir_op_tag(op: i64):
 if op == 0 do out "Nop" end
 if op == 1 do out "Move" end
 if op == 2 do out "Load" end
 if op == 3 do out "Store" end
 if op == 4 do out "Add" end
 if op == 5 do out "Sub" end
 if op == 6 do out "Mul" end
 if op == 7 do out "Div" end
 if op == 8 do out "Call" end
 if op == 9 do out "Intrinsic" end
 if op == 10 do out "Jump" end
 if op == 11 do out "JumpIf" end
 if op == 12 do out "Return" end
 if op == 13 do out "CmpEq" end
 if op == 14 do out "CmpNe" end
 if op == 15 do out "CmpGt" end
 if op == 16 do out "CmpLt" end
 if op == 17 do out "CmpGe" end
 if op == 18 do out "CmpLe" end
 if op == 19 do out "Mod" end
 if op == 20 do out "SetArg" end
 if op == 21 do out "JumpIfNot" end
 if op == 22 do out "And" end
 if op == 23 do out "Or" end
 if op == 24 do out "Xor" end
 if op == 25 do out "Shl" end
 if op == 26 do out "Shr" end
 if op == 27 do out "Not" end
 if op == 28 do out "Pow" end
 if op == 29 do out "MatMul" end
 if op == 30 do out "Fma" end
 out "Unknown"
end.
func mir_intr_tag(kind: i64):
 if kind == 1 do out "STR_LIT" end
 if kind == 2 do out "PRINT" end
 if kind == 3 do out "ARRAY" end
 if kind == 4 do out "TUPLE" end
 if kind == 5 do out "ENTITY" end
 if kind == 6 do out "ADDR_OF" end
 if kind == 7 do out "INTERP" end
 if kind == 8 do out "BUILTIN" end
 if kind == 9 do out "INDEX" end
 if kind == 10 do out "FIELD" end
 if kind == 11 do out "MATCH_PAT" end
 if kind == 12 do out "INPUT" end
 if kind == 13 do out "ENUM" end
 if kind == 14 do out "CAST" end
 if kind == 15 do out "THROW" end
 if kind == 16 do out "CANCEL" end
 if kind == 17 do out "QUIET" end
 if kind == 18 do out "ARENA" end
 if kind == 19 do out "ENSURE" end
 if kind == 20 do out "REVERT" end
 if kind == 21 do out "INDEX_STORE" end
 if kind == 22 do out "FIELD_STORE" end
 if kind == 23 do out "STR_EQ" end
 if kind == 24 do out "CHECK_CPU" end
 if kind == 25 do out "PATCH_POINT" end
 if kind == 26 do out "DECL" end
 if kind == 27 do out "AWAIT" end
 if kind == 28 do out "NOP_MARKER" end
 if kind == 29 do out "TASK" end
 if kind == 30 do out "WAIT" end
 if kind == 31 do out "SELECT" end
 if kind == 32 do out "SEND" end
 if kind == 33 do out "RECV" end
 if kind == 34 do out "EMIT" end
 if kind == 35 do out "ERX" end
 if kind == 36 do out "TRY" end
 if kind == 37 do out "RESUME" end
 if kind == 38 do out "LOCK" end
 if kind == 39 do out "SWIZZLE" end
 if kind == 40 do out "INFER" end
 if kind == 41 do out "TRAIN" end
 if kind == 42 do out "QUANTIZE" end
 if kind == 43 do out "AWAIT_PASS" end
 if kind == 44 do out "SAFE_ACCESS" end
 if kind == 45 do out "ATOMIC" end
 if kind == 46 do out "EXIST" end
 if kind == 47 do out "PATTERN" end
 if kind == 48 do out "MAP" end
 if kind == 49 do out "ARR_COMPACT" end
 if kind == 50 do out "BUNDLE" end
 if kind == 51 do out "TIMEOUT" end
 if kind == 52 do out "ISOLATE" end
 if kind == 53 do out "ERROR" end
 if kind == 54 do out "PRECOMP" end
 if kind == 55 do out "REACTIVE" end
 if kind == 56 do out "MORPH" end
 if kind == 57 do out "EXPOSE" end
 if kind == 58 do out "PTR" end
 if kind == 59 do out "ASYNC" end
 if kind == 60 do out "ATOMIC_VAR" end
 if kind == 68 do out "PERCENT" end
 if kind == 100 do out "PARAM" end
 out "UNKNOWN_INTR"
end.

func mir_instr_op(ins: MirInstr):
    out native_read_i64(ins as i64, 0)
end.
func mir_instr_dst(ins: MirInstr):
    out native_read_i64(ins as i64, 8)
end.
func mir_instr_src1(ins: MirInstr):
    out native_read_i64(ins as i64, 16)
end.
func mir_instr_src2(ins: MirInstr):
    out native_read_i64(ins as i64, 24)
end.
func mir_instr_aux(ins: MirInstr):
    out native_read_i64(ins as i64, 32)
end.
func mir_instr_set_aux(ins: MirInstr, val: i64):
    native_write_i64(ins as i64, 32, val)
end.
func mir_instr_type(ins: MirInstr):
    out native_read_i64(ins as i64, 40)
end.
func mir_instr_set_type(ins: MirInstr, val: i64):
    native_write_i64(ins as i64, 40, val)
end.
func mir_block_id(b: MirBlock):
    out native_read_i64(b as i64, 0)
end.
func mir_block_phis(b: MirBlock):
    out native_read_i64(b as i64, 8)
end.
func mir_block_head(b: MirBlock):
    out native_read_i64(b as i64, 16)
end.
func mir_block_replace_head(b: MirBlock, head: i64):
    native_write_i64(b as i64, 16, head)
    out b
end.
func mir_block_tail(b: MirBlock):
    out native_read_i64(b as i64, 24)
end.
func mir_block_successors(b: MirBlock):
    out native_read_i64(b as i64, 32)
end.
func mir_block_preds(b: MirBlock):
    out native_read_i64(b as i64, 40)
end.
func mir_block_replace_preds(b: MirBlock, preds: i64):
    native_write_i64(b as i64, 40, preds)
    out b
end.
func mir_block_idom(b: MirBlock):
    out native_read_i64(b as i64, 48)
end.
func mir_block_replace_idom(b: MirBlock, idom: i64):
    native_write_i64(b as i64, 48, idom)
    out b
end.
func mir_block_dom_children(b: MirBlock):
    out native_read_i64(b as i64, 56)
end.
func mir_block_replace_dom_children(b: MirBlock, children: i64):
    native_write_i64(b as i64, 56, children)
    out b
end.
func mir_block_df(b: MirBlock):
    out native_read_i64(b as i64, 64)
end.
func mir_block_replace_df(b: MirBlock, df: i64):
    native_write_i64(b as i64, 64, df)
    out b
end.
func mir_block_next_block(b: MirBlock):
    out native_read_i64(b as i64, 72)
end.
func mir_block_reset_cfg(b: MirBlock):
    vec_clear_rt(mir_block_preds(b))
    native_write_i64(b as i64, 48, 0 - 1)
    vec_clear_rt(mir_block_dom_children(b))
    vec_clear_rt(mir_block_df(b))
    out b
end.
func mir_phi_dst(p: MirPhi):
    out native_read_i64(p as i64, 0)
end.
func mir_phi_orig_vreg(p: MirPhi):
    out native_read_i64(p as i64, 8)
end.
func mir_phi_incoming_values(p: MirPhi):
    out native_read_i64(p as i64, 16)
end.
func mir_phi_incoming_blocks(p: MirPhi):
    out native_read_i64(p as i64, 24)
end.
func mir_opnd_type(o: MirOperand):
    out native_read_i64(o as i64, 0)
end.
func mir_opnd_vreg_id(o: MirOperand):
    out native_read_i64(o as i64, 8)
end.
func mir_opnd_imm_val(o: MirOperand):
    out native_read_i64(o as i64, 16)
end.
func mir_opnd_block_id(o: MirOperand):
    out native_read_i64(o as i64, 24)
end.
func mir_func_id(f: MirFunc):
    out native_read_i64(f as i64, 0)
end.
func mir_func_name(f: MirFunc):
    out native_read_i64(f as i64, 8) as string
end.
func mir_func_next_vreg(f: MirFunc):
    out native_read_i64(f as i64, 16)
end.
func mir_func_def_uses(f: MirFunc):
    out native_read_i64(f as i64, 24)
end.
func mir_func_next_block_id(f: MirFunc):
    out native_read_i64(f as i64, 32)
end.
func mir_func_entry_block(f: MirFunc):
    out native_read_i64(f as i64, 40)
end.
func mir_func_blocks(f: MirFunc):
    out native_read_i64(f as i64, 48)
end.
func mir_func_strings(f: MirFunc):
    out native_read_i64(f as i64, 56)
end.
func mir_func_var_buckets(f: MirFunc):
    out native_read_i64(f as i64, 64)
end.
func mir_phi_new(dst_vreg: i64, orig_vreg: i64, incoming_values: i64, incoming_blocks: i64, next: i64):
    p = alloc(40)
    native_write_i64(p, 0, dst_vreg)
    native_write_i64(p, 8, orig_vreg)
    native_write_i64(p, 16, incoming_values)
    native_write_i64(p, 24, incoming_blocks)
    native_write_i64(p, 32, next)
    out p
end.

