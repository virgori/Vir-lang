# @vir_source stdlib/vir/compiler/virc.vri 1
# vir/compiler/virc.vri — Pure Vir Compiler Driver (Zero C/Python)
# =================================================================
# The self-hosting Vir compiler entry point. Uses ONLY the vir/rt/*
# modules (direct syscalls, mmap allocator, raw I/O). No Python,
# no C runtime, no libc, no external linker.
#
# Pipeline
#   source.vri → lex → parse → lower → regalloc → codegen → Mach-O/ELF
#
# This is the file that gets compiled by the Python compiler (Stage 0),
# then the resulting binary compiles itself (Stage 1), completing bootstrap.
#
# Usage
#   ./virc <input.vri> [-o output] [--target <target>] [--format macho|elf|wasm]

module vir.compiler.virc

# ── Runtime layer (pure Vir, no C) ──
# @vir_source stdlib/vir/rt/syscall.vri 1
##
 * vir/rt/syscall.vri — Raw System Call Interface
 * ================================================
 * Direct BSD (macOS) and Linux syscalls.
 * ZERO C library dependency. ZERO libc dependency.
 * This is the absolute foundation — Vir talks to the kernel directly.
 *
 * On macOS ARM64: syscall number in X16, args in X0-X5, SVC #0x80
 * On Linux  ARM64: syscall number in X8,  args in X0-X5, SVC #0
 * On Linux  x86_64: syscall number in RAX, args in RDI,RSI,RDX,R10,R8,R9
 *
 * BSD syscall numbers are offset by 0x2000000 on macOS.
 ##

module vir.rt.syscall

# @vir_source stdlib/vir/compiler/types_prelude.vri 1
##
 * vir/core/types.vri — Primitive types & limits
 * ===================================================
 * Inspired by C23: <stdint.h>, <stddef.h>, <limits.h>, <float.h>
 * Inspired by Python: builtins (int, float, bool, None)
 *
 * This is the foundation: all other modules depend on vir/core/types.
 * Compiler uses internally: i64 for registers, u8 for byte buffer, bool for flags.
 ##

# ═══════════════════════════════════════════════════════
# Signed integer types
# ═══════════════════════════════════════════════════════

type i8;      # 8-bit signed:  -128 .. 127
type i16;     # 16-bit signed: -32768 .. 32767
type i32;     # 32-bit signed: -2^31 .. 2^31 - 1
type i64;     # 64-bit signed: -2^63 .. 2^63 - 1  (default for integers)

# ═══════════════════════════════════════════════════════
# Unsigned integer types
# ═══════════════════════════════════════════════════════

type u8;      # 8-bit unsigned: 0 .. 255
type u16;     # 16-bit unsigned: 0 .. 65535
type u32;     # 32-bit unsigned: 0 .. 2^32 - 1
type u64;     # 64-bit unsigned: 0 .. 2^64 - 1

# ═══════════════════════════════════════════════════════
# Floating point types (IEEE 754)
# ═══════════════════════════════════════════════════════

type f32;     # 32-bit float (single precision)
type f64;     # 64-bit float (double precision, default for floats)

# ═══════════════════════════════════════════════════════
# Other fundamental types
# ═══════════════════════════════════════════════════════

type bool;    # true / false
type byte;    # alias for u8 — use for binary data
type ptr;     # raw pointer — address-as-integer (u64 internally)
type void;    # void type — func returns nothing

# ═══════════════════════════════════════════════════════
# Size types (from C23 <stddef.h>)
# ═══════════════════════════════════════════════════════

type usize;   # unsigned, pointer-sized (u64 on 64-bit)
type isize;   # signed, pointer-sized (i64 on 64-bit)

# ═══════════════════════════════════════════════════════
# Type limits (from C23 <limits.h> + <float.h>)
# ═══════════════════════════════════════════════════════

const I8_MIN: -128
const I8_MAX: 127
const I16_MIN: -32768
const I16_MAX: 32767
const I32_MIN: -2147483648
const I32_MAX: 2147483647
const I64_MIN: -9223372036854775808
const I64_MAX: 9223372036854775807

const U8_MAX: 255
const U16_MAX: 65535
const U32_MAX: 4294967295
const U64_MAX: 18446744073709551615

const F32_EPSILON: 1.1920929e-7
const F32_MIN: 1.17549435e-38
const F32_MAX: 3.40282347e+38

const F64_EPSILON: 2.2204460492503131e-16
const F64_MIN: 2.2250738585072014e-308
const F64_MAX: 1.7976931348623157e+308

# ═══════════════════════════════════════════════════════
# Type conversion functions
# ═══════════════════════════════════════════════════════

func to_u64(x: i64):
    out x
end.

func to_i64(x: i64):
    out x
end.

func parse_int(s: string) -> int:
    var n = native_read_i64(s as i64, 8)
    if n == 0 do out 0 end
    var i = 0
    var neg = 0
    var c0 = native_read_u8(native_read_i64(s as i64, 0), 0)
    if c0 == 45 do
        neg = 1
        i = 1
    eif c0 == 43 do
        i = 1
    end
    var val = 0
    let data = native_read_i64(s as i64, 0)
    when i < n loop
        let c = native_read_u8(data, i)
        if c >= 48 and c <= 57 do
            val = val * 10 + (c - 48)
        end
        i = i + 1
    end
    if neg == 1 do
        out 0 - val
    end
    out val
end.

func parse_float(s: string) -> int:
    out 0
end.

# @vir_source stdlib/vir/rt/syscall.vri 18

# ═══════════════════════════════════════════════════════
# Platform Detection
# ═══════════════════════════════════════════════════════

enum Platform:
    MacOS_ARM64    = 0
    MacOS_x86_64   = 1
    Linux_ARM64    = 2
    Linux_x86_64   = 3
    Linux_RISCV64  = 4
    Wasm32_WASI_P1 = 5
end.
# Compile-time constant — set by the compiler based on target
const HOST_PLATFORM = Platform.MacOS_ARM64

var g_platform_override: int = -1

func set_platform_override(p: int):
    g_platform_override = p
end.

func sys_platform():
    if g_platform_override >= 0 do
        out g_platform_override
    end
    out HOST_PLATFORM
end.

# ═══════════════════════════════════════════════════════
# macOS BSD Syscall Numbers (ARM64)
# ═══════════════════════════════════════════════════════
# All BSD syscalls are offset by 0x2000000

const SYS_EXIT:         0x2000001
const SYS_FORK:         0x2000002
const SYS_READ:         0x2000003
const SYS_WRITE:        0x2000004
const SYS_OPEN:         0x2000005
const SYS_CLOSE:        0x2000006
const SYS_WAIT4:        0x2000007
const SYS_UNLINK:       0x200000A
const SYS_CHDIR:        0x200000C
const SYS_FCHMOD:       0x200007C
const SYS_CHMOD:        0x200000F
const SYS_GETPID:       0x2000014
const SYS_KILL:         0x2000025
const SYS_DUP:          0x2000029
const SYS_PIPE:         0x200002A
const SYS_GETUID:       0x2000018
const SYS_GETGID:       0x200002F
const SYS_STAT64:       0x2000152
const SYS_LSEEK:        0x20000C7
const SYS_MMAP:         0x20000C5
const SYS_MUNMAP:       0x2000049
const SYS_MPROTECT:     0x200004A
const SYS_IOCTL:        0x2000036
const SYS_FCNTL:        0x200005C
const SYS_FSTAT64:      0x2000153
const SYS_MKDIR:        0x2000088
const SYS_RMDIR:        0x2000089
const SYS_RENAME:       0x2000080
const SYS_FTRUNCATE:    0x20000C9
const SYS_EXECVE:       0x200003B
const SYS_GETCWD:       0x2000128
const SYS_SOCKET:       0x2000061
const SYS_CONNECT:      0x2000062
const SYS_BIND:         0x2000068
const SYS_LISTEN:       0x200006A
const SYS_ACCEPT:       0x200001E
const SYS_SENDTO:       0x2000085
const SYS_RECVFROM:     0x200001D
const SYS_KQUEUE:       0x200016A
const SYS_KEVENT:       0x200016B
const SYS_CLOCK_GETTIME: 0x20001A0

# ═══════════════════════════════════════════════════════
# Linux Syscall Numbers (ARM64)
# ═══════════════════════════════════════════════════════

const LINUX_SYS_READ:       63
const LINUX_SYS_WRITE:      64
const LINUX_SYS_OPENAT:     56
const LINUX_SYS_CLOSE:      57
const LINUX_SYS_FSTAT:      80
const LINUX_SYS_LSEEK:      62
const LINUX_SYS_MMAP:       222
const LINUX_SYS_MUNMAP:     215
const LINUX_SYS_MPROTECT:   226
const LINUX_SYS_EXIT:       93
const LINUX_SYS_EXIT_GROUP: 94
const LINUX_SYS_FORK:       220;   # actually clone
const LINUX_SYS_EXECVE:     221
const LINUX_SYS_WAIT4:      260
const LINUX_SYS_GETPID:     172
const LINUX_SYS_KILL:       129
const LINUX_SYS_PIPE2:      59
const LINUX_SYS_GETCWD:     17
const LINUX_SYS_MKDIR:      34
const LINUX_SYS_RMDIR:      84;  # actually unlinkat
const LINUX_SYS_RENAME:     38;  # actually renameat
const LINUX_SYS_FCHMOD:     52
const LINUX_SYS_SOCKET:     198
const LINUX_SYS_CONNECT:    203
const LINUX_SYS_BIND:       200
const LINUX_SYS_LISTEN:     201
const LINUX_SYS_ACCEPT:     202
const LINUX_SYS_SENDTO:     206
const LINUX_SYS_RECVFROM:   207
const LINUX_SYS_EPOLL_CREATE1: 20
const LINUX_SYS_EPOLL_CTL:    21
const LINUX_SYS_EPOLL_WAIT:   22

# ═══════════════════════════════════════════════════════
# Canonical Vir Open Flags (Platform Independent)
# ═══════════════════════════════════════════════════════

const VIR_O_RDONLY:   0x0000
const VIR_O_WRONLY:   0x0001
const VIR_O_RDWR:     0x0002
const VIR_O_CREAT:    0x0008
const VIR_O_TRUNC:    0x0010
const VIR_O_APPEND:   0x0020
const VIR_O_EXCL:     0x0040
const VIR_O_CLOEXEC:  0x0080

# Aliases for backward compatibility
const O_RDONLY:       0x0000
const O_WRONLY:       0x0001
const O_RDWR:         0x0002
const O_CREAT:        0x0008
const O_TRUNC:        0x0010
const O_APPEND:       0x0020
const O_EXCL:         0x0040

const LINUX_O_CREAT:  0x0040
const LINUX_O_TRUNC:  0x0200
const LINUX_O_APPEND: 0x0400

const AT_FDCWD:       -100

func darwin_open_flags(flags: int):
    var df = 0
    if (flags bit_and 0x03) == VIR_O_WRONLY do
        df = df bit_or 0x0001
    eif (flags bit_and 0x03) == VIR_O_RDWR do
        df = df bit_or 0x0002
    end
    if (flags bit_and VIR_O_CREAT) != 0 or (flags bit_and 0x0200) != 0 do
        df = df bit_or 0x0200
    end
    if (flags bit_and VIR_O_TRUNC) != 0 or (flags bit_and 0x0400) != 0 do
        df = df bit_or 0x0400
    end
    if (flags bit_and VIR_O_APPEND) != 0 or (flags bit_and 0x0008) != 0 do
        df = df bit_or 0x0008
    end
    if (flags bit_and VIR_O_EXCL) != 0 or (flags bit_and 0x0800) != 0 do
        df = df bit_or 0x0800
    end
    out df
end.

func linux_open_flags(flags: int):
    var lf = 0
    if (flags bit_and 0x03) == VIR_O_WRONLY do
        lf = lf bit_or 0x0001
    eif (flags bit_and 0x03) == VIR_O_RDWR do
        lf = lf bit_or 0x0002
    end
    if (flags bit_and VIR_O_CREAT) != 0 or (flags bit_and 0x0200) != 0 do
        lf = lf bit_or 0x0040
    end
    if (flags bit_and VIR_O_TRUNC) != 0 or (flags bit_and 0x0400) != 0 do
        lf = lf bit_or 0x0200
    end
    if (flags bit_and VIR_O_APPEND) != 0 or (flags bit_and 0x0008) != 0 do
        lf = lf bit_or 0x0400
    end
    if (flags bit_and VIR_O_EXCL) != 0 or (flags bit_and 0x0800) != 0 do
        lf = lf bit_or 0x0080
    end
    out lf
end.

# ═══════════════════════════════════════════════════════
# Memory Protection Flags
# ═══════════════════════════════════════════════════════

const PROT_NONE:   0x0
const PROT_READ:   0x1
const PROT_WRITE:  0x2
const PROT_EXEC:   0x4

const MAP_PRIVATE:   0x02
const MAP_ANONYMOUS: 0x1000;    # macOS MAP_ANON
const MAP_FIXED:     0x10

const LINUX_MAP_ANONYMOUS: 0x20

# ═══════════════════════════════════════════════════════
# Standard File Descriptors
# ═══════════════════════════════════════════════════════

const STDIN_FD:  0
const STDOUT_FD: 1
const STDERR_FD: 2

# ═══════════════════════════════════════════════════════
# Low-Level Syscall Wrappers
# ═══════════════════════════════════════════════════════
# These are implemented as inline assembly by the compiler.
# The compiler recognizes `extern func syscall*` and emits
# the appropriate SVC/SYSCALL instruction sequence.

extern func syscall0(num: int) -> int
extern func syscall1(num: int, a0: int) -> int
extern func syscall2(num: int, a0: int, a1: int) -> int
extern func syscall3(num: int, a0: int, a1: int, a2: int) -> int
extern func syscall4(num: int, a0: int, a1: int, a2: int, a3: int) -> int
extern func syscall5(num: int, a0: int, a1: int, a2: int, a3: int, a4: int) -> int
extern func syscall6(num: int, a0: int, a1: int, a2: int, a3: int, a4: int, a5: int) -> int

# ═══════════════════════════════════════════════════════
# Process Control
# ═══════════════════════════════════════════════════════

func sys_exit(code: int):
    let plat = sys_platform()
    if plat == Platform.Linux_ARM64 or plat == Platform.Linux_RISCV64 do
        syscall1(93, code)
    eif plat == Platform.Linux_x86_64 do
        syscall1(60, code)
    else
        syscall1(SYS_EXIT, code)
    end
end.
func sys_getpid:
    let plat = sys_platform()
    if plat == Platform.Linux_ARM64 or plat == Platform.Linux_RISCV64 do
        out syscall0(172)
    eif plat == Platform.Linux_x86_64 do
        out syscall0(39)
    else
        out syscall0(SYS_GETPID)
    end
end.
func sys_fork:
    out syscall0(SYS_FORK)
end.
func sys_kill(pid: int, sig: int):
    out syscall2(SYS_KILL, pid, sig)
end.
func sys_wait4:
    in  pid: int
        status_ptr: int
        options: int
    out syscall4(SYS_WAIT4, pid, status_ptr, options, 0)
end.
func sys_execve:
    in  path: int
        argv: int
        envp: int
    out syscall3(SYS_EXECVE, path, argv, envp)
end.
# ═══════════════════════════════════════════════════════
# File I/O — The building blocks
# ═══════════════════════════════════════════════════════

func sys_read:
    in  fd: int
        buf: int
        count: int
    let plat = sys_platform()
    if plat == Platform.Linux_ARM64 or plat == Platform.Linux_RISCV64 do
        out syscall3(63, fd, buf, count)
    eif plat == Platform.Linux_x86_64 do
        out syscall3(0, fd, buf, count)
    else
        out syscall3(SYS_READ, fd, buf, count)
    end
end.
func sys_write:
    in  fd: int
        buf: int
        count: int
    let plat = sys_platform()
    if plat == Platform.Linux_ARM64 or plat == Platform.Linux_RISCV64 do
        out syscall3(64, fd, buf, count)
    eif plat == Platform.Linux_x86_64 do
        out syscall3(1, fd, buf, count)
    else
        out syscall3(SYS_WRITE, fd, buf, count)
    end
end.
func sys_open:
    in  path: int
        flags: int
        mode: int
    let plat = sys_platform()
    if plat == Platform.Linux_ARM64 or plat == Platform.Linux_RISCV64 do
        let lf = linux_open_flags(flags)
        out syscall4(56, AT_FDCWD, path, lf, mode)
    eif plat == Platform.Linux_x86_64 do
        let lf = linux_open_flags(flags)
        out syscall4(257, AT_FDCWD, path, lf, mode)
    else
        let df = darwin_open_flags(flags)
        out syscall3(SYS_OPEN, path, df, mode)
    end
end.
func sys_close(fd: int):
    let plat = sys_platform()
    if plat == Platform.Linux_ARM64 or plat == Platform.Linux_RISCV64 do
        out syscall1(57, fd)
    eif plat == Platform.Linux_x86_64 do
        out syscall1(3, fd)
    else
        out syscall1(SYS_CLOSE, fd)
    end
end.
func sys_lseek:
    in  fd: int
        offset: int
        whence: int
    let plat = sys_platform()
    if plat == Platform.Linux_ARM64 or plat == Platform.Linux_RISCV64 do
        out syscall3(62, fd, offset, whence)
    eif plat == Platform.Linux_x86_64 do
        out syscall3(8, fd, offset, whence)
    else
        out syscall3(SYS_LSEEK, fd, offset, whence)
    end
end.
func sys_fstat(fd: int, buf: int):
    let plat = sys_platform()
    if plat == Platform.Linux_ARM64 or plat == Platform.Linux_RISCV64 do
        out syscall2(80, fd, buf)
    eif plat == Platform.Linux_x86_64 do
        out syscall2(5, fd, buf)
    else
        out syscall2(SYS_FSTAT64, fd, buf)
    end
end.
func sys_ftruncate(fd: int, length: int):
    out syscall2(SYS_FTRUNCATE, fd, length)
end.
func sys_unlink(path: int):
    out syscall1(SYS_UNLINK, path)
end.
func sys_rename(old_path: int, new_path: int):
    out syscall2(SYS_RENAME, old_path, new_path)
end.
func sys_mkdir(path: int, mode: int):
    out syscall2(SYS_MKDIR, path, mode)
end.
func sys_rmdir(path: int):
    out syscall1(SYS_RMDIR, path)
end.
func sys_getcwd(buf: int, size: int):
    out syscall2(SYS_GETCWD, buf, size)
end.
func sys_chmod(path: int, mode: int):
    out syscall2(SYS_CHMOD, path, mode)
end.
# ═══════════════════════════════════════════════════════
# Memory Management — mmap/munmap (replaces malloc/free)
# ═══════════════════════════════════════════════════════

func sys_mmap:
    in  addr: int
        length: int
        prot: int
        flags: int
        fd: int
        offset: int
    let plat = sys_platform()
    if plat == Platform.Linux_ARM64 or plat == Platform.Linux_RISCV64 do
        out syscall6(222, addr, length, prot, flags, fd, offset)
    eif plat == Platform.Linux_x86_64 do
        out syscall6(9, addr, length, prot, flags, fd, offset)
    else
        out syscall6(SYS_MMAP, addr, length, prot, flags, fd, offset)
    end
end.
func sys_munmap(addr: int, length: int):
    let plat = sys_platform()
    if plat == Platform.Linux_ARM64 or plat == Platform.Linux_RISCV64 do
        out syscall2(215, addr, length)
    eif plat == Platform.Linux_x86_64 do
        out syscall2(11, addr, length)
    else
        out syscall2(SYS_MUNMAP, addr, length)
    end
end.
func sys_mprotect:
    in  addr: int
        length: int
        prot: int
    out syscall3(SYS_MPROTECT, addr, length, prot)
end.
# ═══════════════════════════════════════════════════════
# Pipe & Dup
# ═══════════════════════════════════════════════════════

func sys_pipe(fds: int):
    out syscall1(SYS_PIPE, fds)
end.
func sys_dup(fd: int):
    out syscall1(SYS_DUP, fd)
end.
# ═══════════════════════════════════════════════════════
# Socket Operations
# ═══════════════════════════════════════════════════════

func sys_socket:
    in  domain: int
        sock_type: int
        protocol: int
    let plat = sys_platform()
    if plat == Platform.Linux_ARM64 or plat == Platform.Linux_RISCV64 do
        out syscall3(LINUX_SYS_SOCKET, domain, sock_type, protocol)
    eif plat == Platform.Linux_x86_64 do
        out syscall3(41, domain, sock_type, protocol)
    else
        out syscall3(SYS_SOCKET, domain, sock_type, protocol)
    end
end.
func sys_connect:
    in  fd: int
        addr: int
        addr_len: int
    let plat = sys_platform()
    if plat == Platform.Linux_ARM64 or plat == Platform.Linux_RISCV64 do
        out syscall3(LINUX_SYS_CONNECT, fd, addr, addr_len)
    eif plat == Platform.Linux_x86_64 do
        out syscall3(42, fd, addr, addr_len)
    else
        out syscall3(SYS_CONNECT, fd, addr, addr_len)
    end
end.
func sys_bind:
    in  fd: int
        addr: int
        addr_len: int
    let plat = sys_platform()
    if plat == Platform.Linux_ARM64 or plat == Platform.Linux_RISCV64 do
        out syscall3(LINUX_SYS_BIND, fd, addr, addr_len)
    eif plat == Platform.Linux_x86_64 do
        out syscall3(49, fd, addr, addr_len)
    else
        out syscall3(SYS_BIND, fd, addr, addr_len)
    end
end.
func sys_listen(fd: int, backlog: int):
    let plat = sys_platform()
    if plat == Platform.Linux_ARM64 or plat == Platform.Linux_RISCV64 do
        out syscall2(LINUX_SYS_LISTEN, fd, backlog)
    eif plat == Platform.Linux_x86_64 do
        out syscall2(50, fd, backlog)
    else
        out syscall2(SYS_LISTEN, fd, backlog)
    end
end.
func sys_accept:
    in  fd: int
        addr: int
        addr_len: int
    let plat = sys_platform()
    if plat == Platform.Linux_ARM64 or plat == Platform.Linux_RISCV64 do
        out syscall3(LINUX_SYS_ACCEPT, fd, addr, addr_len)
    eif plat == Platform.Linux_x86_64 do
        out syscall3(43, fd, addr, addr_len)
    else
        out syscall3(SYS_ACCEPT, fd, addr, addr_len)
    end
end.
func sys_sendto:
    in  fd: int
        buf: int
        len: int
        flags: int
        addr: int
        addr_len: int
    out syscall6(SYS_SENDTO, fd, buf, len, flags, addr, addr_len)
end.
func sys_recvfrom:
    in  fd: int
        buf: int
        len: int
        flags: int
        addr: int
        addr_len_ptr: int
    out syscall6(SYS_RECVFROM, fd, buf, len, flags, addr, addr_len_ptr)
end.
# ═══════════════════════════════════════════════════════
# Event Queue (kqueue / epoll)
# ═══════════════════════════════════════════════════════

func sys_kqueue:
    out syscall0(SYS_KQUEUE)
end.
func sys_kevent:
    in  kq: int
        changelist: int
        nchanges: int
        eventlist: int
        nevents: int
        timeout: int
    out syscall6(SYS_KEVENT, kq, changelist, nchanges, eventlist, nevents, timeout)
end.
# ═══════════════════════════════════════════════════════
# Time
# ═══════════════════════════════════════════════════════

func sys_clock_gettime(clock_id: int, tp: int):
    out syscall2(SYS_CLOCK_GETTIME, clock_id, tp)
end.
# ═══════════════════════════════════════════════════════
# Convenience: Write to stdout / stderr
# ═══════════════════════════════════════════════════════

func write_stdout(data: int, len: int):
    sys_write(STDOUT_FD, data, len)
end.
func write_stderr(data: int, len: int):
    sys_write(STDERR_FD, data, len)
end.
# ═══════════════════════════════════════════════════════
# Convenience: Read entire file into memory
# ═══════════════════════════════════════════════════════

func read_file_raw(path: int):
    # Open
    let fd = sys_open(path, O_RDONLY, 0)
    if fd < 0 do
        out 0   # error
    end

    # Get file size via lseek
    let end_pos = sys_lseek(fd, 0, 2);    # SEEK_END = 2
    sys_lseek(fd, 0, 0);                   # SEEK_SET = 0

    # Allocate buffer via mmap
    let buf = sys_mmap(0, end_pos + 1,
                       PROT_READ or PROT_WRITE,
                       MAP_PRIVATE or MAP_ANONYMOUS, -1, 0)
    if buf < 0 do
        sys_close(fd)
        out 0
    end

    # Read
    let total = 0
    when total < end_pos loop
        let n = sys_read(fd, buf + total, end_pos - total)
        if n <= 0 do
            out skip
        end
        total = total + n
    end

    native_write_u8(buf, end_pos, 0)

    sys_close(fd)
    out buf   # returns pointer to mmap'd buffer
end.
# ═══════════════════════════════════════════════════════
# Convenience: Write buffer to file
# ═══════════════════════════════════════════════════════

func write_file_raw:
    in  path: int
        data: int
        len: int
        mode: int
    let fd = sys_open(path, O_WRONLY or O_CREAT or O_TRUNC, mode)
    if fd < 0 do
        out -1
    end

    let written = 0
    when written < len loop
        let n = sys_write(fd, data + written, len - written)
        if n <= 0 do
            out skip
        end
        written = written + n
    end

    sys_close(fd)
    out 0
end.

# @vir_source stdlib/vir/compiler/virc.vri 20
import sys_exit, sys_write, SYS_EXIT, SYS_WRITE from vir.rt.syscall
# @vir_source stdlib/vir/rt/alloc.vri 1
##
 * vir/rt/alloc.vri — Memory Allocator (Pure Vir, No libc)
 * ========================================================
 * Bump allocator + free-list allocator built on raw mmap syscalls.
 * Zero C library. Zero malloc. Zero free. Pure kernel syscalls.
 *
 * Strategy
 *   - Arena (bump) allocator for fast sequential allocation
 *   - Free-list allocator for general-purpose alloc/dealloc
 *   - Page allocator (mmap/munmap) as the backing layer
 *
 * Memory block layout
 *   [size:i64] [flags:i64] [user data...]
 *   ^-- block_ptr         ^-- returned to user (block_ptr + 16)
 ##

module vir.rt.alloc


# @vir_source stdlib/vir/rt/alloc.vri 21
import sys_mmap, sys_munmap, sys_platform, Platform, PROT_READ, PROT_WRITE, MAP_PRIVATE, MAP_ANONYMOUS from syscall

# ═══════════════════════════════════════════════════════
# Constants
# ═══════════════════════════════════════════════════════

const PAGE_SIZE:        16384;        # 16KB (macOS ARM64)
const MIN_ARENA_SIZE:   1048576;      # 1MB
const BLOCK_HEADER:     16;           # 8 bytes size + 8 bytes flags
const BLOCK_FREE:       0x0
const BLOCK_USED:       0x1
const ALIGNMENT:        16;           # 16-byte alignment for ARM64

# ═══════════════════════════════════════════════════════
# Portable Virtual Memory Layer (vm_alloc/vm_free)
# ═══════════════════════════════════════════════════════

func vm_alloc(size: int, prot: int):
    let plat = sys_platform()
    var map_anon = 0x1000;  # macOS MAP_ANON
    if plat == Platform.Linux_ARM64 or plat == Platform.Linux_x86_64 or plat == Platform.Linux_RISCV64 do
        map_anon = 0x0020;  # Linux MAP_ANONYMOUS
    end
    out sys_mmap(0, size, prot, 0x02 bit_or map_anon, -1, 0)
end.

func vm_free(ptr: int, size: int):
    out sys_munmap(ptr, size)
end.

func rt_page_size() -> int:
    let plat = sys_platform()
    if plat == Platform.Linux_x86_64 do
        out 4096
    eif plat == Platform.Linux_ARM64 or plat == Platform.Linux_RISCV64 do
        out 65536
    else
        out 16384
    end
end.

# ═══════════════════════════════════════════════════════
# Low-Level Page Allocation (mmap/munmap)
# ═══════════════════════════════════════════════════════

func page_alloc(size: int):

    let ps = rt_page_size()
    # Round up to page boundary
    let pages = (size + PAGE_SIZE - 1) / PAGE_SIZE
    let actual = pages * PAGE_SIZE
    let pages = (size + ps - 1) / ps
    let actual = pages * ps

    let ptr = vm_alloc(actual, PROT_READ or PROT_WRITE)
    if ptr < 0 do
        out 0   # allocation failed
    end
    out ptr
end.
func page_free(ptr: int, size: int):

    let pages = (size + PAGE_SIZE - 1) / PAGE_SIZE
    let actual = pages * PAGE_SIZE
    let ps = rt_page_size()
    let pages = (size + ps - 1) / ps
    let actual = pages * ps
    vm_free(ptr, actual)
end.
# ═══════════════════════════════════════════════════════
# Arena Allocator — Fast Bump Allocation
# ═══════════════════════════════════════════════════════
# Allocates by bumping a pointer forward.
# Entire arena freed at once (no individual free).
# Perfect for compiler phases (lex, parse, IR).

entity Arena:
    base:       int;      # mmap'd base address
    capacity:   int;      # total bytes
    offset:     int      # current bump position
end.
func arena_new(size: int):

    let actual = size
    if actual < MIN_ARENA_SIZE do
        actual = MIN_ARENA_SIZE
    end
    let base = page_alloc(actual)
    if base == 0 do
        out Arena ( base: 0, capacity: 0, offset: 0 )
    end
    out Arena ( base: base, capacity: actual, offset: 0 )
end.
func arena_alloc(arena: Arena, size: int):

    # Align to ALIGNMENT boundary
    let aligned = (size + ALIGNMENT - 1) & ~(ALIGNMENT - 1)

    if arena.offset + aligned > arena.capacity do
        out 0   # out of space
    end

    let ptr = arena.base + arena.offset
    arena.offset = arena.offset + aligned
    out ptr
end.
func arena_reset(arena: Arena):

    arena.offset = 0
    out arena
end.
func arena_destroy(arena: Arena):

    if arena.base != 0 do
        page_free(arena.base, arena.capacity)
    end
end.
# ═══════════════════════════════════════════════════════
# Free-List Allocator — General Purpose
# ═══════════════════════════════════════════════════════
# Each block: [size:i64][flags:i64][user data...]
# Free list is a singly-linked list through free blocks.
# Coalescing on free to reduce fragmentation.

entity FreeNode:
    size:       int;      # total block size (including header)
    next_ptr:   int      # pointer to next FreeNode, or 0
end.
entity Heap:
    base:       int;      # mmap'd region base
    capacity:   int;      # total region size
    free_head:  int;      # pointer to first FreeNode
    used:       int      # bytes currently allocated
end.
# Heap state (module-level singleton)
var g_heap = Heap ( base: 0, capacity: 0, free_head: 0, used: 0 )

func heap_init(size: int):

    let actual = size
    if actual < MIN_ARENA_SIZE do
        actual = MIN_ARENA_SIZE
    end
    let base = page_alloc(actual)
    if base == 0 do
        out false
    end

    # Initialize entire region as one big free block
    extern func native_write_i64(addr: int, offset: int, val: int)
    native_write_i64(base, 0, actual);       # size
    native_write_i64(base, 8, 0);            # next = null (byte offset)

    g_heap = Heap ( base: base, capacity: actual, free_head: base, used: 0 )
    out true
end.
func heap_alloc(size: int):

    let needed = size + BLOCK_HEADER
    # Align
    needed = (needed + ALIGNMENT - 1) & ~(ALIGNMENT - 1)

    extern func native_read_i64(addr: int, offset: int) -> int
    extern func native_write_i64(addr: int, offset: int, val: int)

    # First-fit search through free list
    let prev_ptr = 0
    let cur = g_heap.free_head

    when cur != 0 loop
        let block_size = native_read_i64(cur, 0)
        let next = native_read_i64(cur, 8)

        if block_size >= needed do
            # Found a fit! Split if remainder is big enough
            let remainder = block_size - needed

            if remainder >= (BLOCK_HEADER + ALIGNMENT) do
                # Split: shrink this block, create new free block after
                native_write_i64(cur, 0, needed);    # resize current
                let new_free = cur + needed
                native_write_i64(new_free, 0, remainder);   # size
                native_write_i64(new_free, 8, next);         # next

                # Patch prev or head to point to new_free
                if prev_ptr == 0 do
                    g_heap.free_head = new_free
                else
                    native_write_i64(prev_ptr, 8, new_free)
                end
            else
                # Use whole block
                needed = block_size
                if prev_ptr == 0 do
                    g_heap.free_head = next
                else
                    native_write_i64(prev_ptr, 8, next)
                end
            end

            # Mark as used
            native_write_i64(cur, 0, needed)
            native_write_i64(cur, 8, BLOCK_USED)
            g_heap.used = g_heap.used + needed

            out cur + BLOCK_HEADER   # return user pointer
        end

        prev_ptr = cur
        cur = next
    end

    # No fit found — grow heap
    let grow = needed
    if grow < MIN_ARENA_SIZE do
        grow = MIN_ARENA_SIZE
    end
    let new_region = page_alloc(grow)
    if new_region == 0 do
        out 0   # OOM
    end

    # Set up new region as allocated block + remainder as free
    native_write_i64(new_region, 0, needed)
    native_write_i64(new_region, 8, BLOCK_USED)

    let remainder = grow - needed
    if remainder >= (BLOCK_HEADER + ALIGNMENT) do
        let new_free = new_region + needed
        native_write_i64(new_free, 0, remainder)
        native_write_i64(new_free, 8, g_heap.free_head)
        g_heap.free_head = new_free
    end

    g_heap.used = g_heap.used + needed
    g_heap.capacity = g_heap.capacity + grow
    out new_region + BLOCK_HEADER
end.

func heap_free(p: int):
    if p == 0 do
        out 0
    end

    extern func native_read_i64(addr: int, offset: int) -> int
    extern func native_write_i64(addr: int, offset: int, val: int)

    let block = p - BLOCK_HEADER
    let block_size = native_read_i64(block, 0)

    # Coalescing: merge with immediate next free block if contiguous
    let next_block = block + block_size
    if next_block == g_heap.free_head do
        let next_size = native_read_i64(next_block, 0)
        let next_next = native_read_i64(next_block, 8)
        block_size = block_size + next_size
        native_write_i64(block, 0, block_size)
        native_write_i64(block, 8, next_next)
        g_heap.free_head = block
        g_heap.used = g_heap.used - block_size
        out 0
    end

    # Mark as free, add to free list head
    native_write_i64(block, 0, block_size)
    native_write_i64(block, 8, g_heap.free_head)
    g_heap.free_head = block
    g_heap.used = g_heap.used - block_size
    out 0
end.

func heap_realloc(p: int, new_size: int):
    if p == 0 do
        out heap_alloc(new_size)
    end

    extern func native_read_i64(addr: int, offset: int) -> int
    extern func native_write_i64(addr: int, offset: int, val: int)

    let block = p - BLOCK_HEADER
    let old_size = native_read_i64(block, 0) - BLOCK_HEADER

    # In-place shrink / reuse: no reallocation or copy needed!
    if new_size <= old_size do
        out p
    end

    # Allocate new, copy words, free old
    let new_ptr = heap_alloc(new_size)
    if new_ptr == 0 do
        out 0
    end

    let copy_len = old_size
    if new_size < copy_len do
        copy_len = new_size
    end

    let ci = 0
    when ci + 8 <= copy_len loop
        let word = native_read_i64(p, ci)
        native_write_i64(new_ptr, ci, word)
        ci = ci + 8
    end
    when ci < copy_len loop
        extern func native_read_u8(addr: int, offset: int) -> int
        extern func native_write_u8(addr: int, offset: int, val: int)
        let byte_val = native_read_u8(p, ci)
        native_write_u8(new_ptr, ci, byte_val)
        ci = ci + 1
    end
    heap_free(p)
    out new_ptr
end.

# ═══════════════════════════════════════════════════════
# Global Allocator API (FFI heap — C-VM lowers vir_alloc/vir_free to Q_HEAP_ALLOC/Q_FREE)
# ═══════════════════════════════════════════════════════

var g_initialized = false

func vir_alloc(size: int):
    if g_initialized == false do
        heap_init(MIN_ARENA_SIZE * 4);   # 4MB initial heap
        g_initialized = true
    end
    out heap_alloc(size)
end.

func vir_free(p: int):
    heap_free(p)
end.

func vir_realloc(p: int, new_size: int):
    if g_initialized == false do
        heap_init(MIN_ARENA_SIZE * 4)
        g_initialized = true
    end
    out heap_realloc(p, new_size)
end.

# @vir_source stdlib/vir/compiler/virc.vri 22
import vir_alloc, vir_free, vir_realloc, heap_init from vir.rt.alloc
# @vir_source stdlib/vir/rt/string_rt.vri 1
##
 * vir/rt/string_rt.vri — String Runtime (Pure Vir, No libc)
 * ==========================================================
 * UTF-8 string operations built on vir_alloc/vir_free.
 * Replaces C strlen, strcpy, strcmp, strcat, snprintf, etc.
 *
 * String representation
 *   Pointer to null-terminated UTF-8 byte array.
 *   Length computed on demand via byte scan.
 *   For builder patterns, StringBuilder tracks length explicitly.
 ##

module vir.rt.string_rt


# @vir_source stdlib/vir/rt/string_rt.vri 17
import vir_alloc, vir_free, vir_realloc from alloc

# ═══════════════════════════════════════════════════════
# Low-level byte access (compiler intrinsics)
# ═══════════════════════════════════════════════════════

extern func native_read_u8(addr: int, offset: int) -> int
extern func native_write_u8(addr: int, offset: int, val: int)
extern func native_read_i64(addr: int, offset: int) -> int
extern func native_write_i64(addr: int, offset: int, val: int)
extern func native_mem_copy(dst: int, src: int, len: int)
extern func native_mem_set(dst: int, val: int, len: int)

# C-core does not bind native_mem_copy; copy bytes explicitly.
func rt_memcpy(dst: int, src: int, len: int):
    i = 0
    when i < len loop
        b = native_read_u8(src, i)
        native_write_u8(dst, i, b)
        i = i + 1
    end
end.

# ═══════════════════════════════════════════════════════
# String Length (replaces strlen)
# ═══════════════════════════════════════════════════════

func rt_strlen(s: int):

    if s == 0 do
        out 0
    end
    let i = 0
    when native_read_u8(s, i) != 0 loop
        i = i + 1
    end
    out i
end.
# ═══════════════════════════════════════════════════════
# String Copy (replaces strcpy)
# ═══════════════════════════════════════════════════════

func rt_strcpy(dst: int, src: int):

    let i = 0
    let ch = native_read_u8(src, i)
    when ch != 0 loop
        native_write_u8(dst, i, ch)
        i = i + 1
        ch = native_read_u8(src, i)
    end
    native_write_u8(dst, i, 0);    # null terminator
    out dst
end.
# ═══════════════════════════════════════════════════════
# String Compare (replaces strcmp)
# ═══════════════════════════════════════════════════════

func rt_strcmp(a: int, b: int):

    let i = 0
    when true loop
        let ca = native_read_u8(a, i)
        let cb = native_read_u8(b, i)
        if ca != cb do
            out ca - cb
        end
        if ca == 0 do
            out 0    # equal
        end
        i = i + 1
    end
    out 0
end.
func rt_streq(a: int, b: int):

    out rt_strcmp(a, b) == 0
end.
# Wrap a C string pointer as a string entity {data, byte_len, char_len}
# so stdlib APIs that expect `.data` / `.byte_len` work with get_arg().
# Layout matches String: word0=data, word1=byte_len, word2=char_len (byte ofs 0/8/16).
func str_from_cstr(p: int):
    n = 0
    if p != 0 do
        n = rt_strlen(p)
    end
    s = vir_alloc(24)
    native_write_i64(s, 0, p)
    native_write_i64(s, 8, n)
    native_write_i64(s, 16, n)
    out s
end.

# Fat-string accessors — MUST NOT be named str_len/str_byte_at/str_concat/str_eq:
# C-core parser maps those names to Q_STR_* builtins that strlen() raw C pointers.
func fat_str_len(s: int):
    if s == 0 or s < 4096 do
        out 0
    end
    out native_read_i64(s, 8)
end.

func fat_str_byte_at(s: int, index: int):
    if s == 0 do
        out 0
    end
    data = native_read_i64(s, 0)
    out native_read_u8(data, index)
end.

func fat_str_new(literal: int):
    out str_from_cstr(literal)
end.

func fat_str_concat(a: int, b: int):
    la = 0
    lb = 0
    da = 0
    db = 0
    if a != 0 do
        da = native_read_i64(a, 0)
        la = native_read_i64(a, 8)
    end
    if b != 0 do
        db = native_read_i64(b, 0)
        lb = native_read_i64(b, 8)
    end
    total = la + lb
    p = vir_alloc(total + 1)
    if la > 0 do
        rt_memcpy(p, da, la)
    end
    if lb > 0 do
        dst = p + la
        rt_memcpy(dst, db, lb)
    end
    native_write_u8(p, total, 0)
    s = vir_alloc(24)
    native_write_i64(s, 0, p)
    native_write_i64(s, 8, total)
    native_write_i64(s, 16, total)
    out s
end.

func fat_str_eq(a: int, b: int):
    if a == b do
        out 1
    end
    # Reject null / small non-pointers (corrupted soft fields often land as
    # OpType enums).  Also reject bare C-string literals mistakenly passed
    # where a fat header is required — those fail Q_LOAD_WORD at +8.
    if a < 4096 or b < 4096 do
        out 0
    end
    la = native_read_i64(a, 8)
    lb = native_read_i64(b, 8)
    if la != lb do
        out 0
    end
    if la < 0 or la > 268435456 do
        out 0
    end
    da = native_read_i64(a, 0)
    db = native_read_i64(b, 0)
    if da == db do
        out 1
    end
    if da == 0 or db == 0 do
        out 0
    end
    var i = 0
    when i < la loop
        ca = native_read_u8(da, i)
        cb = native_read_u8(db, i)
        if ca != cb do
            out 0
        end
        i = i + 1
    end
    out 1
end.

# Zero-copy lexeme compare: source[start..start+span_len) vs fat string `word`.
func fat_str_eq_span(source: int, start: int, span_len: int, word: int):
    if source == 0 or word == 0 do out 0 end
    if span_len < 0 do out 0 end
    src_len = fat_str_len(source)
    if start < 0 or (start + span_len) > src_len do out 0 end
    wlen = fat_str_len(word)
    if span_len != wlen do out 0 end
    if span_len == 0 do out 1 end
    sdata = native_read_i64(source, 0)
    wdata = native_read_i64(word, 0)
    var i = 0
    when i < span_len loop
        if native_read_u8(sdata, start + i) != native_read_u8(wdata, i) do out 0 end
        i = i + 1
    end
    out 1
end.

# Materialize a source span into a new fat string (one alloc; used for identifiers).
# Copy source into a NUL-terminated buffer (logical len unchanged; byte at [len] is 0).
func fat_str_sentinel_pad(source: int):
    if source == 0 do out fat_str_new("") end
    slen = fat_str_len(source)
    sdata = native_read_i64(source, 0)
    p = vir_alloc(slen + 2)
    rt_memcpy(p, sdata, slen)
    native_write_u8(p, slen, 0)
    s = vir_alloc(24)
    native_write_i64(s, 0, p)
    native_write_i64(s, 8, slen)
    native_write_i64(s, 16, slen + 1)
    out s
end.

func fat_str_slice(source: int, start: int, span_len: int):
    if source == 0 or span_len <= 0 do out fat_str_new("") end
    src_len = fat_str_len(source)
    if start < 0 or (start + span_len) > src_len do out fat_str_new("") end
    sdata = native_read_i64(source, 0)
    p = vir_alloc(span_len + 1)
    rt_memcpy(p, sdata + start, span_len)
    native_write_u8(p, span_len, 0)
    s = vir_alloc(24)
    native_write_i64(s, 0, p)
    native_write_i64(s, 8, span_len)
    native_write_i64(s, 16, span_len)
    out s
end.

func fat_char_to_str(ch: int):
    p = vir_alloc(2)
    native_write_u8(p, 0, ch)
    native_write_u8(p, 1, 0)
    s = vir_alloc(24)
    native_write_i64(s, 0, p)
    native_write_i64(s, 8, 1)
    native_write_i64(s, 16, 1)
    out s
end.

# Compare fat-string to a raw C string (for rt_streq-style checks under C-core).
func fat_cstr_eq(fat: int, cstr: int):
    if fat == 0 do
        out rt_streq(cstr, "")
    end
    data = native_read_i64(fat, 0)
    out rt_streq(data, cstr)
end.
# ═══════════════════════════════════════════════════════
# String Concatenation (replaces strcat pattern)
# ═══════════════════════════════════════════════════════

func rt_strcat(a: int, b: int):

    let la = rt_strlen(a)
    let lb = rt_strlen(b)
    let result = vir_alloc(la + lb + 1)
    rt_memcpy(result, a, la)
    dst = result + la
    rt_memcpy(dst, b, lb)
    native_write_u8(result, la + lb, 0)
    out result
end.
# ═══════════════════════════════════════════════════════
# String Duplicate
# ═══════════════════════════════════════════════════════

func rt_strdup(s: int):

    let len = rt_strlen(s)
    let result = vir_alloc(len + 1)
    rt_memcpy(result, s, len + 1);   # includes null terminator
    out result
end.
# ═══════════════════════════════════════════════════════
# String Substring
# ═══════════════════════════════════════════════════════

func rt_substr:
    in  s: int
        start: int
        len: int

    let slen = rt_strlen(s)
    if start >= slen do
        let empty = vir_alloc(1)
        native_write_u8(empty, 0, 0)
        out empty
    end
    let actual = len
    if start + actual > slen do
        actual = slen - start
    end
    let result = vir_alloc(actual + 1)
    src = s + start
    rt_memcpy(result, src, actual)
    native_write_u8(result, actual, 0)
    out result
end.
# ═══════════════════════════════════════════════════════
# String Contains
# ═══════════════════════════════════════════════════════

func rt_strcontains(haystack: int, needle: int):

    let hlen = rt_strlen(haystack)
    let nlen = rt_strlen(needle)
    if nlen == 0 do
        out true
    end
    if nlen > hlen do
        out false
    end
    let i = 0
    when i <= hlen - nlen loop
        let j = 0
        let match = true
        when j < nlen loop
            if native_read_u8(haystack, i + j) != native_read_u8(needle, j) do
                match = false
                out skip
            end
            j = j + 1
        end
        if match do
            out true
        end
        i = i + 1
    end
    out false
end.
# ═══════════════════════════════════════════════════════
# String from Literal
# ═══════════════════════════════════════════════════════

func rt_str_from_cstr(cstr: int):

    out rt_strdup(cstr)
end.
# ═══════════════════════════════════════════════════════
# Integer to String (replaces snprintf %d)
# ═══════════════════════════════════════════════════════

func rt_itoa(n: int):

    let buf = vir_alloc(24);    # max i64 digits + sign + null
    let pos = 0
    let val = n

    if val < 0 do
        native_write_u8(buf, 0, 45);   # '-'
        pos = 1
        val = 0 - val
    end

    if val == 0 do
        native_write_u8(buf, pos, 48);   # '0'
        pos = pos + 1
        native_write_u8(buf, pos, 0)
        out buf
    end

    # Write digits in reverse to temp buffer
    let tmp = vir_alloc(24)
    let tlen = 0
    when val > 0 loop
        let digit = val mod 10
        native_write_u8(tmp, tlen, 48 + digit)
        tlen = tlen + 1
        val = val / 10
    end

    # Reverse into output
    let i = tlen - 1
    when i >= 0 loop
        native_write_u8(buf, pos, native_read_u8(tmp, i))
        pos = pos + 1
        i = i - 1
    end
    native_write_u8(buf, pos, 0)
    # Bootstrap allocations are arena-backed.  Do not emit a `vir_free`
    # intrinsic here: older stable seeds map builtin id 4 to the unresolved
    # runtime slot while linking the compiler itself.
    out buf
end.
# ═══════════════════════════════════════════════════════
# String to Integer (replaces atoi/strtol)
# ═══════════════════════════════════════════════════════

func rt_atoi(s: int):

    let i = 0
    let sign = 1
    let result = 0

    # Skip whitespace
    when native_read_u8(s, i) == 32 or native_read_u8(s, i) == 9 loop
        i = i + 1
    end

    # Sign
    if native_read_u8(s, i) == 45 do # '-'
        sign = -1
        i = i + 1
    eif native_read_u8(s, i) == 43 do # '+'
        i = i + 1
    end

    # Digits
    let ch = native_read_u8(s, i)
    when ch >= 48 and ch <= 57 loop
        result = result * 10 + (ch - 48)
        i = i + 1
        ch = native_read_u8(s, i)
    end

    out result * sign
end.
# ═══════════════════════════════════════════════════════
# Hex Integer to String
# ═══════════════════════════════════════════════════════

func rt_itoa_hex(n: int, width: int):

    let hex_chars = "0123456789abcdef"
    let buf = vir_alloc(width + 3)
    native_write_u8(buf, 0, 48);    # '0'
    native_write_u8(buf, 1, 120);   # 'x'
    let pos = 2
    let i = width - 1
    when i >= 0 loop
        let nibble = (n shr (i * 4)) & 0xF
        native_write_u8(buf, pos, native_read_u8(hex_chars, nibble))
        pos = pos + 1
        i = i - 1
    end
    native_write_u8(buf, pos, 0)
    out buf
end.
# ═══════════════════════════════════════════════════════
# StringBuilder — Efficient String Building
# ═══════════════════════════════════════════════════════

entity StringBuilder:
    buf:     int;     # allocated buffer
    len:     int;     # current length
    cap:     int     # capacity
end.
func sb_new:
    let cap = 256
    let buf = vir_alloc(cap)
    out StringBuilder ( buf: buf, len: 0, cap: cap )
end.
func sb_grow(sb: StringBuilder, needed: int):

    if sb.len + needed <= sb.cap do
        out sb
    end
    var new_cap = sb.cap * 2
    when new_cap < sb.len + needed loop
        new_cap = new_cap * 2
    end
    let new_buf = vir_alloc(new_cap)
    if sb.buf != 0 and sb.len > 0 do
        rt_memcpy(new_buf, sb.buf, sb.len)
    end
    sb.buf = new_buf
    sb.cap = new_cap
    out sb
end.
func sb_append(sb: StringBuilder, s: int):

    let slen = rt_strlen(s)
    sb = sb_grow(sb, slen)
    dst = sb.buf + sb.len
    rt_memcpy(dst, s, slen)
    sb.len = sb.len + slen
    out sb
end.
func sb_append_char(sb: StringBuilder, ch: int):

    sb = sb_grow(sb, 1)
    native_write_u8(sb.buf, sb.len, ch)
    sb.len = sb.len + 1
    out sb
end.
func sb_append_int(sb: StringBuilder, n: int):

    let s = rt_itoa(n)
    sb = sb_append(sb, s)
    out sb
end.
func sb_to_string(sb: StringBuilder):

    native_write_u8(sb.buf, sb.len, 0)
    out sb.buf
end.
func sb_len(sb: StringBuilder):

    out sb.len
end.
func sb_clear(sb: StringBuilder):

    sb.len = 0
    out sb
end.
func sb_free(sb: StringBuilder):
    # The self-host runtime is arena-backed; individual frees are no-ops.
    out 0
end.

# @vir_source stdlib/vir/compiler/virc.vri 24
