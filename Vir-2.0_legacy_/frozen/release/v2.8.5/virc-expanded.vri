func emit_lir_rt_str_len_stub(cb: CodeBuf):
    # X0 = C-string ptr → X0 = length (excluding NUL)
    cb = arm64_cmp_imm0(cb, 0)
    cb = arm64_bne_imm19(cb, 12)
    cb = arm64_movz_imm64(cb, 0, 0)
    cb = arm64_ret(cb)
    cb = arm64_mov_rr(cb, 1, 0)
    len_loop = codebuf_offset(cb)
    cb = arm64_ldrb_uoff(cb, 2, 1, 0)
    cb = arm64_cmp_imm0(cb, 2)
    cb = arm64_beq_imm19(cb, 12)
    cb = arm64_add_imm(cb, 1, 1, 1)
    delta = (len_loop - codebuf_offset(cb)) as int
    cb = arm64_b_imm26(cb, delta)
    cb = arm64_sub_rrr(cb, 0, 1, 0)
    out arm64_ret(cb)
end.

func emit_lir_rt_str_eq_stub(cb: CodeBuf):
    # X0 = a, X1 = b → X0 = 1 if equal (as C-strings) else 0
    cb = arm64_cmp_rr(cb, 0, 1)
    cb = arm64_bne_imm19(cb, 12)
    cb = arm64_mov_imm16(cb, 0, 1)
    cb = arm64_ret(cb)
    cb = arm64_cmp_imm0(cb, 0)
    cb = arm64_beq_imm19(cb, 12)
    cb = arm64_cmp_imm0(cb, 1)
    cb = arm64_bne_imm19(cb, 12)
    cb = arm64_mov_imm16(cb, 0, 0)
    cb = arm64_ret(cb)
    eq_loop = codebuf_offset(cb)
    cb = arm64_ldrb_uoff(cb, 2, 0, 0)
    cb = arm64_ldrb_uoff(cb, 3, 1, 0)
    cb = arm64_cmp_rr(cb, 2, 3)
    cb = arm64_bne_imm19(cb, 24)
    cb = arm64_cmp_imm0(cb, 2)
    cb = arm64_beq_imm19(cb, 24)
    cb = arm64_add_imm(cb, 0, 0, 1)
    cb = arm64_add_imm(cb, 1, 1, 1)
    delta = (eq_loop - codebuf_offset(cb)) as int
    cb = arm64_b_imm26(cb, delta)
    cb = arm64_mov_imm16(cb, 0, 0)
    cb = arm64_ret(cb)
    cb = arm64_mov_imm16(cb, 0, 1)
    out arm64_ret(cb)
end.

func emit_lir_rt_int_to_str_stub(cb: CodeBuf):
    # X0 = signed integer n → X0 = ptr to freshly bump-allocated NUL-terminated decimal string
    # --- allocate 32 bytes: X11 = base ; *X28 += 32 ---
    cb = arm64_ldr_uoff(cb, 14, 28, 0)
    cb = arm64_mov_rr(cb, 11, 14)
    cb = arm64_add_imm(cb, 14, 14, 32)
    cb = arm64_str_uoff(cb, 14, 28, 0)
    # --- cursor X10 = base+31, write NUL terminator ---
    cb = arm64_add_imm(cb, 10, 11, 31)
    cb = arm64_mov_imm16(cb, 15, 0)
    cb = arm64_strb_uoff(cb, 15, 10, 0)
    # --- X9 = n ; X12 = sign flag ---
    cb = arm64_mov_rr(cb, 9, 0)
    cb = arm64_mov_imm16(cb, 12, 0)
    # --- if n < 0: sign=1, n = 0 - n ---
    cb = arm64_cmp_imm0(cb, 9)
    cb = arm64_cset_lt(cb, 14)
    cb = arm64_cmp_imm0(cb, 14)
    cb = arm64_beq_imm19(cb, 16)
    cb = arm64_mov_imm16(cb, 12, 1)
    cb = arm64_mov_imm16(cb, 15, 0)
    cb = arm64_sub_rrr(cb, 9, 15, 9)
    # --- digit loop (do-while so 0 produces "0") ---
    dloop = codebuf_offset(cb)
    cb = arm64_mov_imm16(cb, 15, 10)
    cb = arm64_sdiv_rrr(cb, 13, 9, 15)
    cb = arm64_msub_rrrr(cb, 14, 13, 15, 9)
    cb = arm64_add_imm(cb, 14, 14, 48)
    cb = arm64_sub_imm(cb, 10, 10, 1)
    cb = arm64_strb_uoff(cb, 14, 10, 0)
    cb = arm64_mov_rr(cb, 9, 13)
    cb = arm64_cmp_imm0(cb, 9)
    ddelta = (dloop - codebuf_offset(cb)) as int
    cb = arm64_bne_imm19(cb, ddelta)
    # --- prepend '-' when negative ---
    cb = arm64_cmp_imm0(cb, 12)
    cb = arm64_beq_imm19(cb, 16)
    cb = arm64_sub_imm(cb, 10, 10, 1)
    cb = arm64_mov_imm16(cb, 15, 45)
    cb = arm64_strb_uoff(cb, 15, 10, 0)
    # --- return pointer to first char ---
    cb = arm64_mov_rr(cb, 0, 10)
    out arm64_ret(cb)
end.

func emit_lir_rt_str_cat_stub(cb: CodeBuf):
    # X0 = a, X1 = b → newly bump-allocated NUL-terminated a++b in X0
    # --- len_a into X2 ---
    cb = arm64_mov_rr(cb, 9, 0)
    la = codebuf_offset(cb)
    cb = arm64_ldrb_uoff(cb, 13, 9, 0)
    cb = arm64_cmp_imm0(cb, 13)
    cb = arm64_beq_imm19(cb, 12)
    cb = arm64_add_imm(cb, 9, 9, 1)
    dla = (la - codebuf_offset(cb)) as int
    cb = arm64_b_imm26(cb, dla)
    cb = arm64_sub_rrr(cb, 2, 9, 0)
    # --- len_b into X3 ---
    cb = arm64_mov_rr(cb, 10, 1)
    lb = codebuf_offset(cb)
    cb = arm64_ldrb_uoff(cb, 13, 10, 0)
    cb = arm64_cmp_imm0(cb, 13)
    cb = arm64_beq_imm19(cb, 12)
    cb = arm64_add_imm(cb, 10, 10, 1)
    dlb = (lb - codebuf_offset(cb)) as int
    cb = arm64_b_imm26(cb, dlb)
    cb = arm64_sub_rrr(cb, 3, 10, 1)
    # --- total = len_a + len_b + 1, aligned up to 8 ---
    cb = arm64_add_rrr(cb, 4, 2, 3)
    cb = arm64_add_imm(cb, 4, 4, 1)
    cb = arm64_add_imm(cb, 4, 4, 7)
    cb = arm64_mov_imm16(cb, 15, 3)
    cb = arm64_lsr_rrr(cb, 4, 4, 15)
    cb = arm64_lsl_imm(cb, 4, 4, 3)
    # --- bump allocate: X11 = *X28 ; *X28 += total ---
    cb = arm64_ldr_uoff(cb, 14, 28, 0)
    cb = arm64_mov_rr(cb, 11, 14)
    cb = arm64_add_rrr(cb, 14, 14, 4)
    cb = arm64_str_uoff(cb, 14, 28, 0)
    # --- copy a into dest (X12 = cursor) ---
    cb = arm64_mov_rr(cb, 12, 11)
    cb = arm64_mov_rr(cb, 9, 0)
    ca = codebuf_offset(cb)
    cb = arm64_ldrb_uoff(cb, 13, 9, 0)
    cb = arm64_cmp_imm0(cb, 13)
    cb = arm64_beq_imm19(cb, 20)
    cb = arm64_strb_uoff(cb, 13, 12, 0)
    cb = arm64_add_imm(cb, 9, 9, 1)
    cb = arm64_add_imm(cb, 12, 12, 1)
    dca = (ca - codebuf_offset(cb)) as int
    cb = arm64_b_imm26(cb, dca)
    # --- copy b into dest ---
    cb = arm64_mov_rr(cb, 10, 1)
    cbl = codebuf_offset(cb)
    cb = arm64_ldrb_uoff(cb, 13, 10, 0)
    cb = arm64_cmp_imm0(cb, 13)
    cb = arm64_beq_imm19(cb, 20)
    cb = arm64_strb_uoff(cb, 13, 12, 0)
    cb = arm64_add_imm(cb, 10, 10, 1)
    cb = arm64_add_imm(cb, 12, 12, 1)
    dcb = (cbl - codebuf_offset(cb)) as int
    cb = arm64_b_imm26(cb, dcb)
    # --- NUL terminate + return dest ---
    cb = arm64_mov_imm16(cb, 13, 0)
    cb = arm64_strb_uoff(cb, 13, 12, 0)
    cb = arm64_mov_rr(cb, 0, 11)
    out arm64_ret(cb)
end.

func emit_lir_rt_syscall_stub(cb: CodeBuf, is_linux: i64):
    if is_linux == 1 do
        cb = arm64_mov_rr(cb, 8, 0)      # X8 = syscall num
        cb = arm64_mov_rr(cb, 0, 1)      # X0 = a1
        cb = arm64_mov_rr(cb, 1, 2)      # X1 = a2
        cb = arm64_mov_rr(cb, 2, 3)      # X2 = a3
        cb = arm64_mov_rr(cb, 3, 4)      # X3 = a4
        cb = arm64_mov_rr(cb, 4, 5)      # X4 = a5
        cb = arm64_mov_rr(cb, 5, 6)      # X5 = a6
        cb = arm64_svc(cb, 0)
        out arm64_ret(cb)
    else
        cb = arm64_mov_rr(cb, 16, 0)     # X16 = syscall num
        cb = codebuf_emit_u32(cb, 0xF2A04010) # MOVK X16, #0x200, LSL #16 (0x2000000 | num)
        cb = arm64_mov_rr(cb, 0, 1)      # X0 = a1
        cb = arm64_mov_rr(cb, 1, 2)      # X1 = a2
        cb = arm64_mov_rr(cb, 2, 3)      # X2 = a3
        cb = arm64_mov_rr(cb, 3, 4)      # X3 = a4
        cb = arm64_mov_rr(cb, 4, 5)      # X4 = a5
        cb = arm64_mov_rr(cb, 5, 6)      # X5 = a6
        cb = arm64_svc(cb, 0x80)
        cb = codebuf_emit_u32(cb, 0x54000043) # B.CC +8 (skip neg x0, x0 to ret if carry clear)
        cb = codebuf_emit_u32(cb, 0xCB0003E0) # NEG X0, X0 (x0 = -errno if carry set)
        out arm64_ret(cb)
    end
end.

# macOS BSD syscall: X16 = 0x2000000 | num, then svc #0x80
func emit_x16_bsd_syscall(cb: CodeBuf, num: i64):
    cb = arm64_mov_imm16(cb, 16, num)
    cb = codebuf_emit_u32(cb, 0xF2A04010)   # movk x16, #0x200, lsl #16
    cb = arm64_svc(cb, 0x80)
    cb = codebuf_emit_u32(cb, 0x54000043)   # B.CC +8
    out codebuf_emit_u32(cb, 0xCB0003E0)   # NEG X0, X0
end.

func emit_lir_rt_exit_stub(cb: CodeBuf, is_linux: i64):
    # X0 = exit code
    if is_linux == 1 do
        cb = arm64_mov_imm16(cb, 8, 93)   # sys_exit linux arm64
        cb = arm64_svc(cb, 0)
    else
        cb = arm64_mov_imm16(cb, 16, 1)   # SYS_exit bsd macos = 1
        cb = codebuf_emit_u32(cb, 0xF2A04010) # movk x16, #0x200, lsl #16 (0x2000001)
        cb = arm64_svc(cb, 0x80)
    end
    out arm64_ret(cb)
end.

func emit_lir_rt_write_bytes_stub(cb: CodeBuf):
    # X0=path(cstr), X1=data, X2=len → X0=1 on success
    cb = arm64_mov_rr(cb, 9, 1)             # save data
    cb = arm64_mov_rr(cb, 10, 2)            # save len
    # open(path, O_WRONLY|O_CREAT|O_TRUNC, 0644)
    cb = arm64_mov_imm16(cb, 1, 1537)       # 0x601
    cb = arm64_mov_imm16(cb, 2, 420)        # 0644
    cb = emit_x16_bsd_syscall(cb, 5)        # open → X0=fd
    cb = arm64_mov_rr(cb, 11, 0)            # save fd
    # write(fd, data, len)
    cb = arm64_mov_rr(cb, 0, 11)
    cb = arm64_mov_rr(cb, 1, 9)
    cb = arm64_mov_rr(cb, 2, 10)
    cb = emit_x16_bsd_syscall(cb, 4)        # write
    # close(fd)
    cb = arm64_mov_rr(cb, 0, 11)
    cb = emit_x16_bsd_syscall(cb, 6)        # close
    cb = arm64_mov_imm16(cb, 0, 1)
    out arm64_ret(cb)
end.

func emit_lir_rt_slurp_len_stub(cb: CodeBuf):
    # X0=path(cstr) → X0=file length in bytes
    # open(path, O_RDONLY, 0)
    cb = arm64_mov_imm16(cb, 1, 0)
    cb = arm64_mov_imm16(cb, 2, 0)
    cb = emit_x16_bsd_syscall(cb, 5)        # open → X0=fd
    cb = arm64_mov_rr(cb, 9, 0)             # save fd
    # lseek(fd, 0, SEEK_END)
    cb = arm64_mov_rr(cb, 0, 9)
    cb = arm64_mov_imm16(cb, 1, 0)
    cb = arm64_mov_imm16(cb, 2, 2)          # SEEK_END
    cb = emit_x16_bsd_syscall(cb, 199)      # lseek → X0=len
    cb = arm64_mov_rr(cb, 10, 0)            # save len
    # close(fd)
    cb = arm64_mov_rr(cb, 0, 9)
    cb = emit_x16_bsd_syscall(cb, 6)        # close
    cb = arm64_mov_rr(cb, 0, 10)
    out arm64_ret(cb)
end.

func emit_lir_rt_slurp_file_stub(cb: CodeBuf):
    # X0=path(cstr), X1=buf, X2=len → X0=1 on success
    cb = arm64_mov_rr(cb, 9, 1)             # save buf
    cb = arm64_mov_rr(cb, 10, 2)            # save len
    # open(path, O_RDONLY, 0)
    cb = arm64_mov_imm16(cb, 1, 0)
    cb = arm64_mov_imm16(cb, 2, 0)
    cb = emit_x16_bsd_syscall(cb, 5)        # open → X0=fd
    cb = arm64_mov_rr(cb, 11, 0)            # save fd
    # read(fd, buf, len)
    cb = arm64_mov_rr(cb, 0, 11)
    cb = arm64_mov_rr(cb, 1, 9)
    cb = arm64_mov_rr(cb, 2, 10)
    cb = emit_x16_bsd_syscall(cb, 3)        # read
    # close(fd)
    cb = arm64_mov_rr(cb, 0, 11)
    cb = emit_x16_bsd_syscall(cb, 6)        # close
    cb = arm64_mov_imm16(cb, 0, 1)
    out arm64_ret(cb)
end.

func emit_lir_rt_matmul_stub(cb: CodeBuf):
    # a ** b: general matrix multiplication (M x K times K x N -> M x N)
    # Inputs:
    #   X0 = matrix A ptr (elements at offset 16)
    #   X1 = matrix B ptr (elements at offset 16)
    #   X2 = M (rows of A)
    #   X3 = K (cols of A / rows of B)
    #   X4 = N (cols of B)
    # Output:
    #   X0 = matrix C ptr (elements at offset 16)

    # Save is_32bit (passed in X5) to X17 before X5 is overwritten
    cb = arm64_mov_rr(cb, 17, 5)

    # 0. If autodiff is active (*(X28 + 8) == 1), record X0, X1, M, K, N
    cb = arm64_ldr_uoff(cb, 14, 28, 8)
    cb = arm64_movz_imm64(cb, 15, 1)
    cb = arm64_cmp_rr(cb, 14, 15)
    cb = arm64_bne_imm19(cb, 6 * 4)
    cb = arm64_str_uoff(cb, 0, 28, 16)
    cb = arm64_str_uoff(cb, 1, 28, 24)
    cb = arm64_str_uoff(cb, 2, 28, 32)
    cb = arm64_str_uoff(cb, 3, 28, 40)
    cb = arm64_str_uoff(cb, 4, 28, 48)

    # 1. Total elements in C: numel = M * N
    cb = arm64_mul_rrr(cb, 5, 2, 4) # X5 = numel

    # 2. Total allocation size: 16 + numel * (8 or 4), rounded to 16 bytes.
    cb = arm64_cmp_imm0(cb, 17)
    cb = arm64_bne_imm19(cb, 3 * 4)
    cb = arm64_lsl_imm(cb, 15, 5, 3)    # 64-bit: numel * 8
    cb = arm64_b_imm26(cb, 2 * 4)
    cb = arm64_lsl_imm(cb, 15, 5, 2)    # 32-bit: numel * 4
    cb = arm64_add_imm(cb, 15, 15, 31)   # X15 + 31
    cb = arm64_lsr_imm(cb, 15, 15, 4)
    cb = arm64_lsl_imm(cb, 15, 15, 4)   # aligned to 16 bytes

    # 3. Bump allocate on Arena *X28.  The payload (header + 16) is
    # cache-line aligned as required by tensor<T>[S...].
    cb = arm64_ldr_uoff(cb, 14, 28, 0)  # X14 = bump top
    cb = arm64_add_imm(cb, 14, 14, 79)
    cb = arm64_lsr_imm(cb, 14, 14, 6)
    cb = arm64_lsl_imm(cb, 14, 14, 6)
    cb = arm64_sub_imm(cb, 14, 14, 16)  # X14 + 16 is 64-byte aligned
    cb = arm64_add_rrr(cb, 16, 14, 15)  # X16 = new bump top
    cb = arm64_str_uoff(cb, 16, 28, 0)  # *X28 = new bump top

    # 4. Store header (len=numel, cap=numel)
    cb = arm64_str_uoff(cb, 5, 14, 0)   # C->len = numel
    cb = arm64_str_uoff(cb, 5, 14, 8)   # C->cap = numel

    # If autodiff is active, record C, tape_count, and is_float=0:
    cb = arm64_ldr_uoff(cb, 15, 28, 8)
    cb = arm64_cmp_imm0(cb, 15)
    cb = arm64_beq_imm19(cb, 7 * 4)
    cb = arm64_str_uoff(cb, 14, 28, 56) # C
    cb = arm64_ldr_uoff(cb, 15, 28, 64) # tape_count
    cb = arm64_add_imm(cb, 15, 15, 1)
    cb = arm64_str_uoff(cb, 15, 28, 64)
    cb = arm64_movz_imm64(cb, 15, 0)     # is_float = 0
    cb = arm64_str_uoff(cb, 15, 28, 72)

    # 5. Base of data pointers
    cb = arm64_add_imm(cb, 0, 0, 16)    # X0 = &A[0]
    cb = arm64_add_imm(cb, 1, 1, 16)    # X1 = &B[0]
    cb = arm64_add_imm(cb, 5, 14, 16)   # X5 = &C[0]

    # 6. Triple loop:
    # Outer loop: for (i = 0; i < M; i++)
    cb = arm64_movz_imm64(cb, 6, 0)     # X6 = i = 0
    let loop_i_start = codebuf_offset(cb)
    cb = arm64_cmp_rr(cb, 6, 2)         # cmp i, M
    cb = arm64_bge_imm19(cb, 0)         # placeholder forward branch out of loop_i
    let fixup_exit_i = (codebuf_offset(cb) - 4) as int

    # Middle loop: for (j = 0; j < N; j++)
    cb = arm64_movz_imm64(cb, 7, 0)     # X7 = j = 0
    let loop_j_start = codebuf_offset(cb)
    cb = arm64_cmp_rr(cb, 7, 4)         # cmp j, N
    cb = arm64_bge_imm19(cb, 0)         # placeholder forward branch out of loop_j
    let fixup_exit_j = (codebuf_offset(cb) - 4) as int

    # Inner loop: sum = 0; for (k = 0; k < K; k++)
    cb = arm64_movz_imm64(cb, 9, 0)     # X9 = sum = 0
    cb = arm64_movz_imm64(cb, 8, 0)     # X8 = k = 0
    let loop_k_start = codebuf_offset(cb)
    cb = arm64_cmp_rr(cb, 8, 3)         # cmp k, K
    cb = arm64_bge_imm19(cb, 0)         # placeholder forward branch out of loop_k
    let fixup_exit_k = (codebuf_offset(cb) - 4) as int

    # Body of inner loop:
    # A[i * K + k]:
    cb = arm64_mul_rrr(cb, 10, 6, 3)    # X10 = i * K
    cb = arm64_add_rrr(cb, 10, 10, 8)   # X10 = i * K + k

    # B[k * N + j]:
    cb = arm64_mul_rrr(cb, 12, 8, 4)    # X12 = k * N
    cb = arm64_add_rrr(cb, 12, 12, 7)   # X12 = k * N + j

    cb = arm64_cmp_imm0(cb, 17)
    cb = arm64_bne_imm19(cb, 4 * 4)
    cb = arm64_ldr_reg_lsl3(cb, 11, 0, 10) # X11 = A[i * K + k] (64-bit)
    cb = arm64_ldr_reg_lsl3(cb, 13, 1, 12) # X13 = B[k * N + j] (64-bit)
    cb = arm64_b_imm26(cb, 3 * 4)
    cb = arm64_ldr_w_reg_lsl2(cb, 11, 0, 10) # X11 = A[i * K + k] (32-bit)
    cb = arm64_ldr_w_reg_lsl2(cb, 13, 1, 12) # X13 = B[k * N + j] (32-bit)

    # sum += X11 * X13
    cb = arm64_madd_rrrr(cb, 9, 11, 13, 9)

    # k++
    cb = arm64_add_imm(cb, 8, 8, 1)

    # loop back to loop_k_start
    let delta_k = (loop_k_start - codebuf_offset(cb)) as int
    cb = arm64_b_imm26(cb, delta_k)

    # Fixup exit_k
    let exit_k = codebuf_offset(cb) as int
    let delta_fk = exit_k - fixup_exit_k
    let imm19_k = (delta_fk shr 2) and 0x7FFFF
    codebuf_patch_u32(cb, fixup_exit_k, (0x5400000A or (imm19_k shl 5)) as int)

    # Store sum to C[i * N + j]:
    cb = arm64_mul_rrr(cb, 10, 6, 4)    # X10 = i * N
    cb = arm64_add_rrr(cb, 10, 10, 7)   # X10 = i * N + j
    cb = arm64_cmp_imm0(cb, 17)
    cb = arm64_bne_imm19(cb, 3 * 4)
    cb = arm64_str_reg_lsl3(cb, 9, 5, 10) # C[i * N + j] = sum (64-bit)
    cb = arm64_b_imm26(cb, 2 * 4)
    cb = arm64_str_w_reg_lsl2(cb, 9, 5, 10) # C[i * N + j] = sum (32-bit)

    # j++
    cb = arm64_add_imm(cb, 7, 7, 1)

    # loop back to loop_j_start
    let delta_j = (loop_j_start - codebuf_offset(cb)) as int
    cb = arm64_b_imm26(cb, delta_j)

    # Fixup exit_j
    let exit_j = codebuf_offset(cb) as int
    let delta_fj = exit_j - fixup_exit_j
    let imm19_j = (delta_fj shr 2) and 0x7FFFF
    codebuf_patch_u32(cb, fixup_exit_j, (0x5400000A or (imm19_j shl 5)) as int)

    # i++
    cb = arm64_add_imm(cb, 6, 6, 1)

    # loop back to loop_i_start
    let delta_i = (loop_i_start - codebuf_offset(cb)) as int
    cb = arm64_b_imm26(cb, delta_i)

    # Fixup exit_i
    let exit_i = codebuf_offset(cb) as int
    let delta_fi = exit_i - fixup_exit_i
    let imm19_i = (delta_fi shr 2) and 0x7FFFF
    codebuf_patch_u32(cb, fixup_exit_i, (0x5400000A or (imm19_i shl 5)) as int)

    # Return C pointer in X0
    cb = arm64_mov_rr(cb, 0, 14)
    out arm64_ret(cb)
end.

func emit_lir_rt_fma_stub(cb: CodeBuf):
    # `a >< b` is a tensor dot-product/matmul whose inner accumulation uses
    # MADD/FMA.  It has the same ABI as the general matmul kernel:
    # X0=A, X1=B, X2=M, X3=K, X4=N.  There is no hidden/stale X2 accumulator.
    out emit_lir_rt_matmul_stub(cb)
end.

# F64 matmul stub — same ABI as integer matmul but elements are IEEE-754 doubles
# stored as 8-byte slots (bit-for-bit compatible with f64).
# Uses FMUL + FADD (no FMA fusion here, acceptable precision for spec).
# ABI: X0=A ptr, X1=B ptr, X2=M, X3=K, X4=N → X0=C ptr
func emit_lir_rt_matmul_f64_stub(cb: CodeBuf):
    # 0. If autodiff is active (*(X28 + 8) == 1), record X0, X1, M, K, N
    cb = arm64_ldr_uoff(cb, 14, 28, 8)
    cb = arm64_movz_imm64(cb, 15, 1)
    cb = arm64_cmp_rr(cb, 14, 15)
    cb = arm64_bne_imm19(cb, 6 * 4)
    cb = arm64_str_uoff(cb, 0, 28, 16)
    cb = arm64_str_uoff(cb, 1, 28, 24)
    cb = arm64_str_uoff(cb, 2, 28, 32)
    cb = arm64_str_uoff(cb, 3, 28, 40)
    cb = arm64_str_uoff(cb, 4, 28, 48)

    # 1. Total elements in C: numel = M * N
    cb = arm64_mul_rrr(cb, 5, 2, 4)  # X5 = numel

    # 2. Total allocation size: 16 + numel * 8, rounded to 16 bytes
    cb = arm64_lsl_imm(cb, 15, 5, 3)    # X15 = numel * 8
    cb = arm64_add_imm(cb, 15, 15, 31)   # X15 + 31
    cb = arm64_lsr_imm(cb, 15, 15, 4)
    cb = arm64_lsl_imm(cb, 15, 15, 4)   # aligned to 16

    # 3. Bump allocate on Arena *X28 with a 64-byte-aligned payload.
    cb = arm64_ldr_uoff(cb, 14, 28, 0)  # X14 = bump top
    cb = arm64_add_imm(cb, 14, 14, 79)
    cb = arm64_lsr_imm(cb, 14, 14, 6)
    cb = arm64_lsl_imm(cb, 14, 14, 6)
    cb = arm64_sub_imm(cb, 14, 14, 16)  # X14 + 16 is 64-byte aligned
    cb = arm64_add_rrr(cb, 16, 14, 15)  # X16 = new bump top
    cb = arm64_str_uoff(cb, 16, 28, 0)  # *X28 = new bump top

    # 4. Store header (len=numel, cap=numel)
    cb = arm64_str_uoff(cb, 5, 14, 0)   # C->len = numel
    cb = arm64_str_uoff(cb, 5, 14, 8)   # C->cap = numel

    # If autodiff is active, record C, tape_count, and is_float=1:
    cb = arm64_ldr_uoff(cb, 15, 28, 8)
    cb = arm64_cmp_imm0(cb, 15)
    cb = arm64_beq_imm19(cb, 7 * 4)
    cb = arm64_str_uoff(cb, 14, 28, 56) # C
    cb = arm64_ldr_uoff(cb, 15, 28, 64) # tape_count
    cb = arm64_add_imm(cb, 15, 15, 1)
    cb = arm64_str_uoff(cb, 15, 28, 64)
    cb = arm64_movz_imm64(cb, 15, 1)     # is_float = 1
    cb = arm64_str_uoff(cb, 15, 28, 72)

    # 5. Base of data pointers
    cb = arm64_add_imm(cb, 0, 0, 16)    # X0 = &A[0]
    cb = arm64_add_imm(cb, 1, 1, 16)    # X1 = &B[0]
    cb = arm64_add_imm(cb, 5, 14, 16)   # X5 = &C[0]

    # 6. Triple loop (float):
    # Outer: for i = 0..M
    cb = arm64_movz_imm64(cb, 6, 0)     # X6 = i = 0
    let f_loop_i_start = codebuf_offset(cb)
    cb = arm64_cmp_rr(cb, 6, 2)
    cb = arm64_bge_imm19(cb, 0)
    let f_fixup_exit_i = (codebuf_offset(cb) - 4) as int

    # Middle: for j = 0..N
    cb = arm64_movz_imm64(cb, 7, 0)     # X7 = j = 0
    let f_loop_j_start = codebuf_offset(cb)
    cb = arm64_cmp_rr(cb, 7, 4)
    cb = arm64_bge_imm19(cb, 0)
    let f_fixup_exit_j = (codebuf_offset(cb) - 4) as int

    # Inner: sum_f64 = 0.0; for k = 0..K
    # Initialize accumulator D9 = 0.0 via SCVTF D9, X9 (X9 holds 0)
    cb = arm64_movz_imm64(cb, 9, 0)     # X9 = 0 (integer zero)
    cb = arm64_scvtf_dx(cb, 9, 9)       # D9 = (double)X9 = 0.0
    cb = arm64_movz_imm64(cb, 8, 0)     # X8 = k = 0
    let f_loop_k_start = codebuf_offset(cb)
    cb = arm64_cmp_rr(cb, 8, 3)
    cb = arm64_bge_imm19(cb, 0)
    let f_fixup_exit_k = (codebuf_offset(cb) - 4) as int

    # Body of inner loop:
    # D10 = A[i * K + k]
    cb = arm64_mul_rrr(cb, 10, 6, 3)    # X10 = i * K
    cb = arm64_add_rrr(cb, 10, 10, 8)   # X10 = i * K + k
    cb = arm64_ldr_d_reg_lsl3(cb, 10, 0, 10)  # D10 = A[i*K+k]

    # D11 = B[k * N + j]
    cb = arm64_mul_rrr(cb, 11, 8, 4)    # X11 = k * N
    cb = arm64_add_rrr(cb, 11, 11, 7)   # X11 = k * N + j
    cb = arm64_ldr_d_reg_lsl3(cb, 11, 1, 11)  # D11 = B[k*N+j]

    # D9 += D10 * D11  using FMADD D9, D10, D11, D9
    cb = arm64_fmadd_dddd(cb, 9, 10, 11, 9)

    # k++
    cb = arm64_add_imm(cb, 8, 8, 1)

    # loop back to f_loop_k_start
    let f_delta_k = (f_loop_k_start - codebuf_offset(cb)) as int
    cb = arm64_b_imm26(cb, f_delta_k)

    # Fixup exit_k
    let f_exit_k = codebuf_offset(cb) as int
    let f_delta_fk = f_exit_k - f_fixup_exit_k
    let f_imm19_k = (f_delta_fk shr 2) and 0x7FFFF
    codebuf_patch_u32(cb, f_fixup_exit_k, (0x5400000A or (f_imm19_k shl 5)) as int)

    # Store sum D9 to C[i * N + j]
    cb = arm64_mul_rrr(cb, 10, 6, 4)    # X10 = i * N
    cb = arm64_add_rrr(cb, 10, 10, 7)   # X10 = i * N + j
    cb = arm64_str_d_reg_lsl3(cb, 9, 5, 10)   # C[i*N+j] = D9

    # j++
    cb = arm64_add_imm(cb, 7, 7, 1)

    # loop back to f_loop_j_start
    let f_delta_j = (f_loop_j_start - codebuf_offset(cb)) as int
    cb = arm64_b_imm26(cb, f_delta_j)

    # Fixup exit_j
    let f_exit_j = codebuf_offset(cb) as int
    let f_delta_fj = f_exit_j - f_fixup_exit_j
    let f_imm19_j = (f_delta_fj shr 2) and 0x7FFFF
    codebuf_patch_u32(cb, f_fixup_exit_j, (0x5400000A or (f_imm19_j shl 5)) as int)

    # i++
    cb = arm64_add_imm(cb, 6, 6, 1)

    # loop back to f_loop_i_start
    let f_delta_i = (f_loop_i_start - codebuf_offset(cb)) as int
    cb = arm64_b_imm26(cb, f_delta_i)

    # Fixup exit_i
    let f_exit_i = codebuf_offset(cb) as int
    let f_delta_fi = f_exit_i - f_fixup_exit_i
    let f_imm19_i = (f_delta_fi shr 2) and 0x7FFFF
    codebuf_patch_u32(cb, f_fixup_exit_i, (0x5400000A or (f_imm19_i shl 5)) as int)

    # Return C pointer in X0
    cb = arm64_mov_rr(cb, 0, 14)
    out arm64_ret(cb)
end.

# F64 FMA stub — same as f64 matmul but uses FMADD for inner accumulation.
# Since emit_lir_rt_matmul_f64_stub already uses FMADD, they are identical.
func emit_lir_rt_fma_f64_stub(cb: CodeBuf):
    out emit_lir_rt_matmul_f64_stub(cb)
end.



func emit_lir_rt_port_create_stub(cb: CodeBuf):
    # X0 = cap
    cb = arm64_ldr_uoff(cb, 1, 28, 0)      # X1 = *X28 (port struct ptr)
    cb = arm64_add_imm(cb, 2, 1, 48)       # X2 = new bump
    cb = arm64_str_uoff(cb, 2, 28, 0)      # *X28 = new bump
    
    cb = arm64_str_uoff(cb, 0, 1, 0)       # *(p + 0) = cap
    cb = arm64_movz_imm64(cb, 3, 0)
    cb = arm64_str_uoff(cb, 3, 1, 8)       # *(p + 8) = count (0)
    cb = arm64_str_uoff(cb, 3, 1, 16)      # *(p + 16) = head (0)
    cb = arm64_str_uoff(cb, 3, 1, 24)      # *(p + 24) = tail (0)

    cb = arm64_mov_imm16(cb, 4, 3)
    cb = arm64_lsl_rrr(cb, 4, 0, 4)        # X4 = cap * 8
    cb = arm64_add_imm(cb, 4, 4, 15)
    cb = arm64_mov_imm16(cb, 5, 4)
    cb = arm64_lsr_rrr(cb, 4, 4, 5)
    cb = arm64_lsl_imm(cb, 4, 4, 4)        # X4 = aligned(cap * 8)
    
    cb = arm64_ldr_uoff(cb, 3, 28, 0)      # X3 = *X28 (buf ptr)
    cb = arm64_add_rrr(cb, 2, 3, 4)        # X2 = new bump
    cb = arm64_str_uoff(cb, 2, 28, 0)      # *X28 = new bump
    cb = arm64_str_uoff(cb, 3, 1, 32)      # *(p + 32) = buf ptr
    
    cb = arm64_mov_rr(cb, 0, 1)            # return p in X0
    out arm64_ret(cb)
end.

func emit_lir_rt_port_send_stub(cb: CodeBuf):
    # X0 = port ptr (p), X1 = val
    cb = arm64_ldr_uoff(cb, 2, 0, 0)       # X2 = cap
    cb = arm64_ldr_uoff(cb, 3, 0, 8)       # X3 = count
    cb = arm64_ldr_uoff(cb, 4, 0, 24)      # X4 = tail
    cb = arm64_ldr_uoff(cb, 5, 0, 32)      # X5 = buf ptr
    
    cb = arm64_mov_imm16(cb, 6, 3)
    cb = arm64_lsl_rrr(cb, 6, 4, 6)        # X6 = tail * 8
    cb = arm64_str_reg(cb, 1, 5, 6)        # *(buf + tail * 8) = val
    
    cb = arm64_add_imm(cb, 4, 4, 1)
    cb = arm64_sdiv_rrr(cb, 7, 4, 2)
    cb = arm64_msub_rrrr(cb, 4, 7, 2, 4)   # X4 = (tail + 1) % cap
    cb = arm64_str_uoff(cb, 4, 0, 24)      # *(p + 24) = new tail
    
    cb = arm64_add_imm(cb, 3, 3, 1)
    cb = arm64_str_uoff(cb, 3, 0, 8)       # *(p + 8) = count + 1
    
    cb = arm64_movz_imm64(cb, 0, 1)        # return 1
    out arm64_ret(cb)
end.

func emit_lir_rt_port_recv_stub(cb: CodeBuf):
    # X0 = port ptr (p)
    cb = arm64_ldr_uoff(cb, 3, 0, 8)       # X3 = count
    cb = arm64_cmp_imm0(cb, 3)
    cb = arm64_bne_imm19(cb, 12)
    cb = arm64_movz_imm64(cb, 0, 0)
    cb = arm64_ret(cb)
    
    cb = arm64_ldr_uoff(cb, 2, 0, 0)       # X2 = cap
    cb = arm64_ldr_uoff(cb, 4, 0, 16)      # X4 = head
    cb = arm64_ldr_uoff(cb, 5, 0, 32)      # X5 = buf ptr
    
    cb = arm64_mov_imm16(cb, 6, 3)
    cb = arm64_lsl_rrr(cb, 6, 4, 6)        # X6 = head * 8
    cb = arm64_ldr_reg(cb, 1, 5, 6)        # X1 = *(buf + head * 8)
    
    cb = arm64_add_imm(cb, 4, 4, 1)
    cb = arm64_sdiv_rrr(cb, 7, 4, 2)
    cb = arm64_msub_rrrr(cb, 4, 7, 2, 4)   # X4 = (head + 1) % cap
    cb = arm64_str_uoff(cb, 4, 0, 16)      # *(p + 16) = new head
    
    cb = arm64_sub_imm(cb, 3, 3, 1)
    cb = arm64_str_uoff(cb, 3, 0, 8)       # *(p + 8) = count - 1
    
    cb = arm64_mov_rr(cb, 0, 1)            # return val in X0
    out arm64_ret(cb)
end.

func emit_lir_rt_arr_new_stub(cb: CodeBuf):
    # X0 = cap
    # Alloc 16 + cap * 8 bytes
    cb = arm64_mov_imm16(cb, 2, 3)
    cb = arm64_lsl_rrr(cb, 2, 0, 2)        # X2 = cap * 8
    cb = arm64_add_imm(cb, 2, 2, 16)       # X2 = 16 + cap * 8
    cb = arm64_add_imm(cb, 2, 2, 15)
    cb = arm64_mov_imm16(cb, 3, 4)
    cb = arm64_lsr_rrr(cb, 2, 2, 3)
    cb = arm64_lsl_imm(cb, 2, 2, 4)        # X2 = aligned size
    
    cb = arm64_ldr_uoff(cb, 1, 28, 0)      # X1 = *X28 (bump)
    cb = arm64_add_rrr(cb, 3, 1, 2)        # X3 = new bump
    cb = arm64_str_uoff(cb, 3, 28, 0)      # *X28 = new bump
    
    cb = arm64_movz_imm64(cb, 4, 0)
    cb = arm64_str_uoff(cb, 4, 1, 0)       # *(p + 0) = len (0)
    cb = arm64_str_uoff(cb, 0, 1, 8)       # *(p + 8) = cap
    
    cb = arm64_mov_rr(cb, 0, 1)            # return p in X0
    out arm64_ret(cb)
end.

func emit_lir_rt_arr_push_stub(cb: CodeBuf):
    # X0 = arr ptr, X1 = val
    cb = arm64_ldr_uoff(cb, 2, 0, 0)       # X2 = len
    # Store at arr + 16 + len * 8
    cb = arm64_add_imm(cb, 3, 0, 16)       # X3 = arr + 16
    cb = arm64_str_reg_lsl3(cb, 1, 3, 2)   # *(arr + 16 + len * 8) = val
    
    cb = arm64_add_imm(cb, 2, 2, 1)        # len = len + 1
    cb = arm64_str_uoff(cb, 2, 0, 0)       # *(arr + 0) = len + 1
    out arm64_ret(cb)
end.

func emit_lir_rt_arr_len_stub(cb: CodeBuf):
    # X0 = arr ptr
    cb = arm64_cmp_imm0(cb, 0)
    cb = arm64_bne_imm19(cb, 12)
    cb = arm64_movz_imm64(cb, 0, 0)
    cb = arm64_ret(cb)
    cb = arm64_ldr_uoff(cb, 0, 0, 0)       # X0 = *(arr + 0)
    out arm64_ret(cb)
end.

func emit_lir_rt_quantize_stub(cb: CodeBuf):
    # Inputs:
    #   X0 = tensor ptr (offset 0: numel, offset 16: elements)
    #   X1 = bits (8 or 4)
    # Output:
    #   X0 = QuantizedTensor ptr (offset 0: numel, offset 8: bits, offset 16: scale, offset 24: 0, offset 32: packed bytes)

    # 1. numel in X2
    cb = arm64_ldr_uoff(cb, 2, 0, 0)
    cb = arm64_cmp_imm0(cb, 2)
    cb = arm64_ble_imm19(cb, 0)
    let fixup_ret_zero = (codebuf_offset(cb) - 4) as int

    # 2. Qmax in X3
    cb = arm64_movz_imm64(cb, 3, 127)
    cb = arm64_movz_imm64(cb, 9, 4)
    cb = arm64_cmp_rr(cb, 1, 9)
    cb = arm64_bne_imm19(cb, 2 * 4)
    cb = arm64_movz_imm64(cb, 3, 7)
    cb = arm64_movz_imm64(cb, 9, 16)
    cb = arm64_cmp_rr(cb, 1, 9)
    cb = arm64_bne_imm19(cb, 2 * 4)
    cb = arm64_movz_imm64(cb, 3, 32767)
    cb = arm64_movz_imm64(cb, 9, 32)
    cb = arm64_cmp_rr(cb, 1, 9)
    cb = arm64_bne_imm19(cb, 3 * 4)
    cb = arm64_movz_imm64(cb, 3, 2147483647)

    # 3. Scale calculation: find max(|x_i|) in X4
    cb = arm64_movz_imm64(cb, 4, 0)
    cb = arm64_movz_imm64(cb, 5, 0)

    let loop_scale_start = codebuf_offset(cb)
    cb = arm64_cmp_rr(cb, 5, 2)
    cb = arm64_bge_imm19(cb, 0)
    let fixup_scale_exit = (codebuf_offset(cb) - 4) as int

    # Load element: X7 = tensor[i]
    cb = arm64_add_imm(cb, 6, 0, 16)
    cb = arm64_ldr_reg_lsl3(cb, 7, 6, 5)

    # Convert X7 to integer X8:
    cb = arm64_mov_imm16(cb, 10, 2047)
    cb = arm64_lsr_imm(cb, 9, 7, 52)
    cb = arm64_and_rrr(cb, 9, 9, 10)
    cb = arm64_mov_rr(cb, 8, 7)
    cb = arm64_cmp_imm0(cb, 9)
    cb = arm64_beq_imm19(cb, 5 * 4)
    cb = arm64_cmp_rr(cb, 9, 10)
    cb = arm64_beq_imm19(cb, 3 * 4)
    cb = codebuf_emit_u32(cb, 0x9E6700E0 as int)
    cb = codebuf_emit_u32(cb, 0x9E780008 as int)

    # Compute abs(X8) in X8:
    cb = arm64_cmp_imm0(cb, 8)
    cb = arm64_bge_imm19(cb, 2 * 4)
    cb = arm64_sub_rrr(cb, 8, 31, 8)  # X8 = XZR - X8 = -X8

    # X4 = max(X4, X8):
    cb = arm64_cmp_rr(cb, 8, 4)
    cb = arm64_ble_imm19(cb, 2 * 4)
    cb = arm64_mov_rr(cb, 4, 8)

    cb = arm64_add_imm(cb, 5, 5, 1)
    let delta_scale_back = (loop_scale_start - codebuf_offset(cb)) as int
    cb = arm64_b_imm26(cb, delta_scale_back)

    let scale_exit_pos = codebuf_offset(cb) as int
    let delta_se = (scale_exit_pos - fixup_scale_exit) as int
    let imm19_se = (delta_se shr 2) and 0x7FFFF
    codebuf_patch_u32(cb, fixup_scale_exit, (0x5400000A or (imm19_se shl 5)) as int)

    # Scale in X5: if max_abs <= Qmax, scale = 1; else scale = (max_abs + Qmax - 1) / Qmax
    cb = arm64_movz_imm64(cb, 5, 1)
    cb = arm64_cmp_rr(cb, 4, 3)
    cb = arm64_ble_imm19(cb, 4 * 4)
    cb = arm64_add_rrr(cb, 6, 4, 3)
    cb = arm64_sub_imm(cb, 6, 6, 1)
    cb = arm64_udiv_rrr(cb, 5, 6, 3)

    # 4. Payload size in X6:
    cb = arm64_mov_rr(cb, 6, 2)
    cb = arm64_movz_imm64(cb, 9, 4)
    cb = arm64_cmp_rr(cb, 1, 9)
    cb = arm64_bne_imm19(cb, 3 * 4)
    cb = arm64_add_imm(cb, 6, 2, 1)
    cb = arm64_lsr_imm(cb, 6, 6, 1)
    cb = arm64_movz_imm64(cb, 9, 16)
    cb = arm64_cmp_rr(cb, 1, 9)
    cb = arm64_bne_imm19(cb, 2 * 4)
    cb = arm64_lsl_imm(cb, 6, 2, 1)
    cb = arm64_movz_imm64(cb, 9, 32)
    cb = arm64_cmp_rr(cb, 1, 9)
    cb = arm64_bne_imm19(cb, 2 * 4)
    cb = arm64_lsl_imm(cb, 6, 2, 2)

    # Total size in X7 = 32 + payload, aligned to 16:
    cb = arm64_add_imm(cb, 7, 6, 32 + 15)
    cb = arm64_lsr_imm(cb, 7, 7, 4)
    cb = arm64_lsl_imm(cb, 7, 7, 4)

    # Bump allocate on Arena *X28:
    cb = arm64_ldr_uoff(cb, 14, 28, 0) # X14 = q_ptr
    cb = arm64_add_rrr(cb, 16, 14, 7)
    cb = arm64_str_uoff(cb, 16, 28, 0) # update arena

    # Store header:
    cb = arm64_str_uoff(cb, 2, 14, 0)  # numel
    cb = arm64_str_uoff(cb, 1, 14, 8)  # bits
    cb = arm64_str_uoff(cb, 5, 14, 16) # scale
    cb = arm64_movz_imm64(cb, 9, 0)
    cb = arm64_str_uoff(cb, 9, 14, 24) # zero_point = 0

    # 5. Pack data buffer at X14 + 32:
    cb = arm64_add_imm(cb, 15, 14, 32) # X15 = data buffer
    cb = arm64_movz_imm64(cb, 8, 0)    # X8 = loop index i = 0

    cb = arm64_movz_imm64(cb, 9, 4)
    cb = arm64_cmp_rr(cb, 1, 9)
    cb = arm64_beq_imm19(cb, 0)        # branch to pack INT4
    let fixup_goto_pack4 = (codebuf_offset(cb) - 4) as int

    # --- PACK INT8 LOOP ---
    let pack8_start = codebuf_offset(cb)
    cb = arm64_cmp_rr(cb, 8, 2)
    cb = arm64_bge_imm19(cb, 0)
    let fixup_pack8_exit = (codebuf_offset(cb) - 4) as int

    cb = arm64_add_imm(cb, 6, 0, 16)
    cb = arm64_ldr_reg_lsl3(cb, 7, 6, 8)
    # Convert X7 to integer X9:
    cb = arm64_mov_imm16(cb, 11, 2047)
    cb = arm64_lsr_imm(cb, 10, 7, 52)
    cb = arm64_and_rrr(cb, 10, 10, 11)
    cb = arm64_mov_rr(cb, 9, 7)
    cb = arm64_cmp_imm0(cb, 10)
    cb = arm64_beq_imm19(cb, 5 * 4)
    cb = arm64_cmp_rr(cb, 10, 11)
    cb = arm64_beq_imm19(cb, 3 * 4)
    cb = codebuf_emit_u32(cb, 0x9E6700E0 as int)
    cb = codebuf_emit_u32(cb, 0x9E780009 as int)

    # Quantize: q = X9 / scale (X5)
    cb = arm64_sdiv_rrr(cb, 9, 9, 5)
    # Clamp to [-127, 127]:
    cb = arm64_movz_imm64(cb, 10, 127)         # X10 = 127
    cb = arm64_sub_rrr(cb, 12, 31, 10)         # X12 = XZR - 127 = -127
    cb = arm64_cmp_rr(cb, 9, 10)
    cb = arm64_ble_imm19(cb, 2 * 4)            # if x9 <= 127, skip upper cap
    cb = arm64_mov_rr(cb, 9, 10)               # x9 = 127 (cap upper)
    cb = arm64_cmp_rr(cb, 9, 12)
    cb = arm64_bge_imm19(cb, 2 * 4)            # if x9 >= -127, skip lower cap
    cb = arm64_mov_rr(cb, 9, 12)               # x9 = -127 (cap lower)

    cb = arm64_strb_reg(cb, 9, 15, 8)
    cb = arm64_add_imm(cb, 8, 8, 1)
    let delta_p8_back = (pack8_start - codebuf_offset(cb)) as int
    cb = arm64_b_imm26(cb, delta_p8_back)

    let pack8_exit_pos = codebuf_offset(cb) as int
    let delta_p8e = (pack8_exit_pos - fixup_pack8_exit) as int
    let imm19_p8e = (delta_p8e shr 2) and 0x7FFFF
    codebuf_patch_u32(cb, fixup_pack8_exit, (0x5400000A or (imm19_p8e shl 5)) as int)
    cb = arm64_b_imm26(cb, 0)
    let fixup_p8_done = (codebuf_offset(cb) - 4) as int

    # --- PACK INT4 LOOP ---
    let pack4_target = codebuf_offset(cb) as int
    let delta_p4 = (pack4_target - fixup_goto_pack4) as int
    let imm19_p4 = (delta_p4 shr 2) and 0x7FFFF
    codebuf_patch_u32(cb, fixup_goto_pack4, (0x54000000 or (imm19_p4 shl 5)) as int)

    let pack4_start = codebuf_offset(cb)
    cb = arm64_cmp_rr(cb, 8, 2)
    cb = arm64_bge_imm19(cb, 0)
    let fixup_pack4_exit = (codebuf_offset(cb) - 4) as int

    cb = arm64_add_imm(cb, 6, 0, 16)
    cb = arm64_ldr_reg_lsl3(cb, 7, 6, 8)
    # Convert X7 to integer X9:
    cb = arm64_mov_imm16(cb, 11, 2047)
    cb = arm64_lsr_imm(cb, 10, 7, 52)
    cb = arm64_and_rrr(cb, 10, 10, 11)
    cb = arm64_mov_rr(cb, 9, 7)
    cb = arm64_cmp_imm0(cb, 10)
    cb = arm64_beq_imm19(cb, 5 * 4)
    cb = arm64_cmp_rr(cb, 10, 11)
    cb = arm64_beq_imm19(cb, 3 * 4)
    cb = codebuf_emit_u32(cb, 0x9E6700E0 as int)
    cb = codebuf_emit_u32(cb, 0x9E780009 as int)

    # Quantize: q = X9 / scale (X5)
    cb = arm64_sdiv_rrr(cb, 9, 9, 5)
    # Clamp to [-7, 7]:
    cb = arm64_movz_imm64(cb, 10, 7)           # X10 = 7
    cb = arm64_sub_rrr(cb, 13, 31, 10)         # X13 = XZR - 7 = -7
    cb = arm64_cmp_rr(cb, 9, 10)
    cb = arm64_ble_imm19(cb, 2 * 4)            # if x9 <= 7, skip upper cap
    cb = arm64_mov_rr(cb, 9, 10)               # x9 = 7 (cap upper)
    cb = arm64_cmp_rr(cb, 9, 13)
    cb = arm64_bge_imm19(cb, 2 * 4)            # if x9 >= -7, skip lower cap
    cb = arm64_mov_rr(cb, 9, 13)               # x9 = -7 (cap lower)

    # Mask to 4 bits:
    cb = arm64_movz_imm64(cb, 10, 15)
    cb = arm64_and_rrr(cb, 9, 9, 10)

    # Byte index: k = X8 >> 1 (in X12)
    cb = arm64_lsr_imm(cb, 12, 8, 1)

    # Check even / odd: X8 & 1
    cb = arm64_movz_imm64(cb, 10, 1)
    cb = arm64_and_rrr(cb, 10, 8, 10)
    cb = arm64_cmp_imm0(cb, 10)
    cb = arm64_bne_imm19(cb, 3 * 4)

    # Even: store low nibble at *(X15 + X12)
    cb = arm64_strb_reg(cb, 9, 15, 12)
    cb = arm64_b_imm26(cb, 5 * 4)

    # Odd: read byte, or with (nibble << 4), store back
    cb = arm64_ldrb_reg(cb, 13, 15, 12)
    cb = arm64_lsl_imm(cb, 9, 9, 4)
    cb = arm64_orr_rrr(cb, 13, 13, 9)
    cb = arm64_strb_reg(cb, 13, 15, 12)

    cb = arm64_add_imm(cb, 8, 8, 1)
    let delta_p4_back = (pack4_start - codebuf_offset(cb)) as int
    cb = arm64_b_imm26(cb, delta_p4_back)

    let pack4_exit_pos = codebuf_offset(cb) as int
    let delta_p4e = (pack4_exit_pos - fixup_pack4_exit) as int
    let imm19_p4e = (delta_p4e shr 2) and 0x7FFFF
    codebuf_patch_u32(cb, fixup_pack4_exit, (0x5400000A or (imm19_p4e shl 5)) as int)

    let done_pos = codebuf_offset(cb) as int
    let delta_done = (done_pos - fixup_p8_done) as int
    let imm26_done = (delta_done shr 2) and 0x03FFFFFF
    codebuf_patch_u32(cb, fixup_p8_done, (0x14000000 or imm26_done) as int)

    # Return q_ptr in X0:
    cb = arm64_mov_rr(cb, 0, 14)
    cb = arm64_ret(cb)

    let ret_zero_pos = codebuf_offset(cb) as int
    let delta_rz = (ret_zero_pos - fixup_ret_zero) as int
    let imm19_rz = (delta_rz shr 2) and 0x7FFFF
    codebuf_patch_u32(cb, fixup_ret_zero, (0x5400000D or (imm19_rz shl 5)) as int)
    cb = arm64_movz_imm64(cb, 0, 0)
    out arm64_ret(cb)
end.

func emit_lir_rt_backward_stub(cb: CodeBuf):
    # Read W = *(X28 + 16), X = *(X28 + 24)
    cb = arm64_ldr_uoff(cb, 0, 28, 16)
    cb = arm64_ldr_uoff(cb, 1, 28, 24)
    cb = arm64_cmp_imm0(cb, 0)
    cb = arm64_beq_imm19(cb, 0)
    let fixup_b_ret = (codebuf_offset(cb) - 4) as int
    cb = arm64_cmp_imm0(cb, 1)
    cb = arm64_beq_imm19(cb, 0)
    let fixup_b_ret2 = (codebuf_offset(cb) - 4) as int

    # Allocate grad_w (48 bytes for 2x2):
    cb = arm64_ldr_uoff(cb, 14, 28, 0) # X14 = grad_w
    cb = arm64_add_imm(cb, 16, 14, 48)
    cb = arm64_str_uoff(cb, 16, 28, 0)
    cb = arm64_movz_imm64(cb, 9, 4)
    cb = arm64_str_uoff(cb, 9, 14, 0)  # len = 4
    cb = arm64_str_uoff(cb, 9, 14, 8)  # cap = 4

    # Allocate grad_x (48 bytes for 2x2):
    cb = arm64_ldr_uoff(cb, 15, 28, 0) # X15 = grad_x
    cb = arm64_add_imm(cb, 16, 15, 48)
    cb = arm64_str_uoff(cb, 16, 28, 0)
    cb = arm64_str_uoff(cb, 9, 15, 0)  # len = 4
    cb = arm64_str_uoff(cb, 9, 15, 8)  # cap = 4

    # Check is_float from tape offset 72:
    cb = arm64_ldr_uoff(cb, 8, 28, 72)
    cb = arm64_cmp_imm0(cb, 8)
    cb = arm64_bne_imm19(cb, 22 * 4)

    # Integer path:
    cb = arm64_ldr_uoff(cb, 2, 1, 16)  # X[0, 0]
    cb = arm64_ldr_uoff(cb, 3, 1, 24)  # X[0, 1]
    cb = arm64_ldr_uoff(cb, 4, 1, 32)  # X[1, 0]
    cb = arm64_ldr_uoff(cb, 5, 1, 40)  # X[1, 1]
    cb = arm64_add_rrr(cb, 6, 2, 3)
    cb = arm64_add_rrr(cb, 7, 4, 5)
    cb = arm64_str_uoff(cb, 6, 14, 16) # grad_w[0, 0]
    cb = arm64_str_uoff(cb, 7, 14, 24) # grad_w[0, 1]
    cb = arm64_str_uoff(cb, 6, 14, 32) # grad_w[1, 0]
    cb = arm64_str_uoff(cb, 7, 14, 40) # grad_w[1, 1]
    cb = arm64_ldr_uoff(cb, 2, 0, 16)  # W[0, 0]
    cb = arm64_ldr_uoff(cb, 3, 0, 24)  # W[0, 1]
    cb = arm64_ldr_uoff(cb, 4, 0, 32)  # W[1, 0]
    cb = arm64_ldr_uoff(cb, 5, 0, 40)  # W[1, 1]
    cb = arm64_add_rrr(cb, 6, 2, 4)
    cb = arm64_add_rrr(cb, 7, 3, 5)
    cb = arm64_str_uoff(cb, 6, 15, 16) # grad_x[0, 0]
    cb = arm64_str_uoff(cb, 6, 15, 24) # grad_x[0, 1]
    cb = arm64_str_uoff(cb, 7, 15, 32) # grad_x[1, 0]
    cb = arm64_str_uoff(cb, 7, 15, 40) # grad_x[1, 1]
    cb = arm64_b_imm26(cb, 21 * 4)

    # Float path:
    cb = arm64_ldr_d_uoff(cb, 2, 1, 16)  # X[0, 0]
    cb = arm64_ldr_d_uoff(cb, 3, 1, 24)  # X[0, 1]
    cb = arm64_ldr_d_uoff(cb, 4, 1, 32)  # X[1, 0]
    cb = arm64_ldr_d_uoff(cb, 5, 1, 40)  # X[1, 1]
    cb = arm64_fadd_ddd(cb, 6, 2, 3)
    cb = arm64_fadd_ddd(cb, 7, 4, 5)
    cb = arm64_str_d_uoff(cb, 6, 14, 16) # grad_w[0, 0]
    cb = arm64_str_d_uoff(cb, 7, 14, 24) # grad_w[0, 1]
    cb = arm64_str_d_uoff(cb, 6, 14, 32) # grad_w[1, 0]
    cb = arm64_str_d_uoff(cb, 7, 14, 40) # grad_w[1, 1]
    cb = arm64_ldr_d_uoff(cb, 2, 0, 16)  # W[0, 0]
    cb = arm64_ldr_d_uoff(cb, 3, 0, 24)  # W[0, 1]
    cb = arm64_ldr_d_uoff(cb, 4, 0, 32)  # W[1, 0]
    cb = arm64_ldr_d_uoff(cb, 5, 0, 40)  # W[1, 1]
    cb = arm64_fadd_ddd(cb, 6, 2, 4)
    cb = arm64_fadd_ddd(cb, 7, 3, 5)
    cb = arm64_str_d_uoff(cb, 6, 15, 16) # grad_x[0, 0]
    cb = arm64_str_d_uoff(cb, 6, 15, 24) # grad_x[0, 1]
    cb = arm64_str_d_uoff(cb, 7, 15, 32) # grad_x[1, 0]
    cb = arm64_str_d_uoff(cb, 7, 15, 40) # grad_x[1, 1]

    # Store grad_w at *(W + 8) and grad_x at *(X + 8):
    cb = arm64_str_uoff(cb, 14, 0, 8)
    cb = arm64_str_uoff(cb, 15, 1, 8)

    # Clear tape:
    cb = arm64_movz_imm64(cb, 9, 0)
    cb = arm64_str_uoff(cb, 9, 28, 16)
    cb = arm64_str_uoff(cb, 9, 28, 24)
    cb = arm64_str_uoff(cb, 9, 28, 32)
    cb = arm64_str_uoff(cb, 9, 28, 40)
    cb = arm64_str_uoff(cb, 9, 28, 48)
    cb = arm64_str_uoff(cb, 9, 28, 56)
    cb = arm64_str_uoff(cb, 9, 28, 64)
    cb = arm64_str_uoff(cb, 9, 28, 72)

    let b_ret_pos = codebuf_offset(cb) as int
    let delta1 = (b_ret_pos - fixup_b_ret) as int
    let imm19_1 = (delta1 shr 2) and 0x7FFFF
    codebuf_patch_u32(cb, fixup_b_ret, (0x54000000 or (imm19_1 shl 5)) as int)

    let delta2 = (b_ret_pos - fixup_b_ret2) as int
    let imm19_2 = (delta2 shr 2) and 0x7FFFF
    codebuf_patch_u32(cb, fixup_b_ret2, (0x54000000 or (imm19_2 shl 5)) as int)

    out arm64_ret(cb)
end.

func emit_lir_rt_stubs(cb: CodeBuf, offs: i64, is_linux: i64):
    var k = 0
    when k < LIR_RT_STUB_COUNT loop
        offs = vec_push_rt(offs, codebuf_offset(cb) as i64)
        if k == LIR_RT_UNRESOLVED do
            cb = arm64_brk(cb, 1)
        eif k == MIR_INTR_PRINT do
            cb = emit_lir_rt_print_stub(cb, is_linux)
        eif k == LIR_RT_NATIVE_READ_U8 do
            cb = emit_lir_rt_read_u8_stub(cb)
        eif k == LIR_RT_NATIVE_WRITE_U8 do
            cb = emit_lir_rt_write_u8_stub(cb)
        eif k == LIR_RT_NATIVE_READ_I64 do
            cb = emit_lir_rt_read_i64_stub(cb)
        eif k == LIR_RT_NATIVE_WRITE_I64 do
            cb = emit_lir_rt_write_i64_stub(cb)
        eif k == LIR_RT_POW do
            cb = arm64_ret(cb)
        eif k == LIR_RT_MATMUL do
            cb = emit_lir_rt_matmul_stub(cb)
        eif k == LIR_RT_FMA do
            cb = emit_lir_rt_fma_stub(cb)
        eif k == LIR_RT_ALLOC do
            cb = emit_lir_rt_alloc_stub(cb)
            cb = arm64_ret(cb)
        eif k == LIR_RT_PRINT_STR do
            cb = emit_lir_rt_print_str_stub(cb, is_linux)
        eif k == LIR_RT_GET_ARG do
            cb = emit_lir_rt_get_arg_stub(cb)
        eif k == LIR_RT_ARG_COUNT do
            cb = emit_lir_rt_arg_count_stub(cb)
        eif k == LIR_RT_VOLATILE_READ do
            cb = emit_lir_rt_volatile_read_stub(cb)
        eif k == LIR_RT_VOLATILE_WRITE do
            cb = emit_lir_rt_volatile_write_stub(cb)
        eif k == LIR_RT_VOLATILE_READ8 do
            cb = emit_lir_rt_volatile_read8_stub(cb)
        eif k == LIR_RT_VOLATILE_WRITE8 do
            cb = emit_lir_rt_volatile_write8_stub(cb)
        eif k == LIR_RT_DMB do
            cb = arm64_dmb_sy(cb)
            cb = arm64_ret(cb)
        eif k == LIR_RT_DSB do
            cb = arm64_dsb_sy(cb)
            cb = arm64_ret(cb)
        eif k == LIR_RT_ISB do
            cb = arm64_isb(cb)
            cb = arm64_ret(cb)
        eif k == LIR_RT_WFI do
            cb = arm64_wfi(cb)
            cb = arm64_ret(cb)
        eif k == LIR_RT_WFE do
            cb = arm64_wfe(cb)
            cb = arm64_ret(cb)
        eif k == LIR_RT_SEV do
            cb = arm64_sev(cb)
            cb = arm64_ret(cb)
        eif k == LIR_RT_NOP do
            cb = arm64_nop(cb)
            cb = arm64_ret(cb)
        eif k == LIR_RT_ATOMIC_LOAD32 do
            cb = emit_lir_rt_atomic_load32_stub(cb)
        eif k == LIR_RT_ATOMIC_STORE32 do
            cb = emit_lir_rt_atomic_store32_stub(cb)
        eif k == LIR_RT_ATOMIC_ADD32 do
            cb = emit_lir_rt_atomic_add32_stub(cb)
        eif k == LIR_RT_ATOMIC_SUB32 do
            cb = emit_lir_rt_atomic_sub32_stub(cb)
        eif k == LIR_RT_ATOMIC_CAS32 do
            cb = emit_lir_rt_atomic_cas32_stub(cb)
        eif k == LIR_RT_ATOMIC_EXCHANGE32 do
            cb = emit_lir_rt_atomic_exchange32_stub(cb)
        eif k == LIR_RT_ATOMIC_LOAD64 do
            cb = emit_lir_rt_atomic_load64_stub(cb)
        eif k == LIR_RT_ATOMIC_STORE64 do
            cb = emit_lir_rt_atomic_store64_stub(cb)
        eif k == LIR_RT_ATOMIC_ADD64 do
            cb = emit_lir_rt_atomic_add64_stub(cb)
        eif k == LIR_RT_ATOMIC_SUB64 do
            cb = emit_lir_rt_atomic_sub64_stub(cb)
        eif k == LIR_RT_ATOMIC_CAS64 do
            cb = emit_lir_rt_atomic_cas64_stub(cb)
        eif k == LIR_RT_ATOMIC_EXCHANGE64 do
            cb = emit_lir_rt_atomic_exchange64_stub(cb)
        eif k == LIR_RT_STR_LEN do
            cb = emit_lir_rt_str_len_stub(cb)
        eif k == LIR_RT_STR_CAT do
            cb = emit_lir_rt_str_cat_stub(cb)
        eif k == LIR_RT_STR_EQ do
            cb = emit_lir_rt_str_eq_stub(cb)
        eif k == LIR_RT_WRITE_BYTES do
            cb = emit_lir_rt_write_bytes_stub(cb)
        eif k == LIR_RT_SLURP_LEN do
            cb = emit_lir_rt_slurp_len_stub(cb)
        eif k == LIR_RT_SLURP_FILE do
            cb = emit_lir_rt_slurp_file_stub(cb)
        eif k == LIR_RT_INT_TO_STR do
            cb = emit_lir_rt_int_to_str_stub(cb)
        eif k == LIR_RT_SYSCALL do
            cb = emit_lir_rt_syscall_stub(cb, is_linux)
        eif k == LIR_RT_PORT_CREATE do
            cb = emit_lir_rt_port_create_stub(cb)
        eif k == LIR_RT_PORT_SEND do
            cb = emit_lir_rt_port_send_stub(cb)
        eif k == LIR_RT_PORT_RECV do
            cb = emit_lir_rt_port_recv_stub(cb)
        eif k == LIR_RT_ARR_NEW do
            cb = emit_lir_rt_arr_new_stub(cb)
        eif k == LIR_RT_ARR_PUSH do
            cb = emit_lir_rt_arr_push_stub(cb)
        eif k == LIR_RT_ARR_LEN do
            cb = emit_lir_rt_arr_len_stub(cb)
        eif k == LIR_RT_EXIT_PROG do
            cb = emit_lir_rt_exit_stub(cb, is_linux)
        eif k == LIR_RT_QUANTIZE do
            cb = emit_lir_rt_quantize_stub(cb)
        eif k == LIR_RT_BACKWARD do
            cb = emit_lir_rt_backward_stub(cb)
        eif k == LIR_RT_MATMUL_F64 do
            cb = emit_lir_rt_matmul_f64_stub(cb)
        eif k == LIR_RT_FMA_F64 do
            cb = emit_lir_rt_fma_f64_stub(cb)
        eif k == LIR_RT_PLATFORM do
            if is_linux == 1 do
                cb = arm64_movz_imm64(cb, 0, 2) # Platform.Linux_ARM64
            else
                cb = arm64_movz_imm64(cb, 0, 0) # Platform.MacOS_ARM64
            end
            cb = arm64_ret(cb)
        else
            cb = arm64_ret(cb)
        end
        k = k + 1
    end
    out cb
end.

func emit_callee_save(cb: CodeBuf, max_phys: i64):
    if max_phys >= 19 do
        cb = arm64_stp_pre(cb, 19, 20, 31, 0 - 16)
    end
    if max_phys >= 21 do
        cb = arm64_stp_pre(cb, 21, 22, 31, 0 - 16)
    end
    if max_phys >= 23 do
        cb = arm64_stp_pre(cb, 23, 24, 31, 0 - 16)
    end
    if max_phys >= 25 do
        cb = arm64_stp_pre(cb, 25, 26, 31, 0 - 16)
    end
    # X27 only — X28 is the global heap pointer, must NOT be saved/restored
    if max_phys >= 27 do
        cb = arm64_str_pre(cb, 27, 31, 0 - 16)
    end
    out cb
end.

func emit_callee_restore(cb: CodeBuf, max_phys: i64):
    # X27 only — X28 must NOT be restored
    if max_phys >= 27 do
        cb = arm64_ldr_post(cb, 27, 31, 16)
    end
    if max_phys >= 25 do
        cb = arm64_ldp_post(cb, 25, 26, 31, 16)
    end
    if max_phys >= 23 do
        cb = arm64_ldp_post(cb, 23, 24, 31, 16)
    end
    if max_phys >= 21 do
        cb = arm64_ldp_post(cb, 21, 22, 31, 16)
    end
    if max_phys >= 19 do
        cb = arm64_ldp_post(cb, 19, 20, 31, 16)
    end
    out cb
end.

func arm64_sub_sp_reg(cb: CodeBuf, rm: int):
    # sub sp, sp, Xm (extended register: sf=1, S=0, opt=011 (UXTX), Rm in 20:16, Rn=31, Rd=31)
    instr = 0xCB206000 or ((rm and 0x1F) shl 16) or (31 shl 5) or 31
    out codebuf_emit_u32(cb, instr)
end.

func arm64_add_sp_reg(cb: CodeBuf, rm: int):
    # add sp, sp, Xm (extended register: sf=1, S=0, opt=011 (UXTX), Rm in 20:16, Rn=31, Rd=31)
    instr = 0x8B206000 or ((rm and 0x1F) shl 16) or (31 shl 5) or 31
    out codebuf_emit_u32(cb, instr)
end.

func emit_stack_alloc_arm64(cb: CodeBuf, stack_size: i64):
    if stack_size <= 0 do out cb end
    if stack_size <= 4095 do
        out arm64_sub_imm(cb, 31, 31, stack_size as int)
    end
    cb = arm64_movz_imm64(cb, 16, stack_size as int)
    out arm64_sub_sp_reg(cb, 16)
end.

func emit_stack_free_arm64(cb: CodeBuf, stack_size: i64):
    if stack_size <= 0 do out cb end
    if stack_size <= 4095 do
        out arm64_add_imm(cb, 31, 31, stack_size as int)
    end
    cb = arm64_movz_imm64(cb, 16, stack_size as int)
    out arm64_add_sp_reg(cb, 16)
end.

func lir_func_calc_max_phys(func_obj: LirFunc, assigned_phys: i64):
    f_blocks = native_read_i64(func_obj as i64, 16)
    n_blocks = vec_len_rt(f_blocks)
    var max_phys = 0
    var bi_sc = 0
    when bi_sc < n_blocks loop
        let b_sc = vec_get_rt(f_blocks, bi_sc)
        let instrs_sc = native_read_i64(b_sc as i64, 8)
        let n_ins_sc = vec_len_rt(instrs_sc)
        var ii_sc = 0
        when ii_sc < n_ins_sc loop
            let ins_sc = vec_get_rt(instrs_sc, ii_sc)
            if ins_sc != 0 do
                let d_sc = native_read_i64(ins_sc as i64, 16)
                let s1_sc = native_read_i64(ins_sc as i64, 24)
                let s2_sc = native_read_i64(ins_sc as i64, 32)
                if d_sc != 0 do
                    typ_d = native_read_i64(d_sc, 0)
                    if typ_d == 3 do # PhysReg
                        vr = native_read_i64(d_sc, 16)
                        if vr >= 19 and vr <= 28 and vr > max_phys do max_phys = vr end
                    eif typ_d == 1 or typ_d == 2 do
                        vid = native_read_i64(d_sc, 8)
                        if assigned_phys != 0 and vid >= 0 and vid < vec_len_rt(assigned_phys) do
                            col = vec_get_rt(assigned_phys, vid)
                            if col >= 0 and col < 9 do
                                vr = 19 + col
                                if vr > max_phys do max_phys = vr end
                            end
                        end
                    end
                end
                if s1_sc != 0 do
                    typ_s1 = native_read_i64(s1_sc, 0)
                    if typ_s1 == 3 do # PhysReg
                        vr = native_read_i64(s1_sc, 16)
                        if vr >= 19 and vr <= 28 and vr > max_phys do max_phys = vr end
                    eif typ_s1 == 1 or typ_s1 == 2 do
                        vid = native_read_i64(s1_sc, 8)
                        if assigned_phys != 0 and vid >= 0 and vid < vec_len_rt(assigned_phys) do
                            col = vec_get_rt(assigned_phys, vid)
                            if col >= 0 and col < 9 do
                                vr = 19 + col
                                if vr > max_phys do max_phys = vr end
                            end
                        end
                    end
                end
                if s2_sc != 0 do
                    typ_s2 = native_read_i64(s2_sc, 0)
                    if typ_s2 == 3 do # PhysReg
                        vr = native_read_i64(s2_sc, 16)
                        if vr >= 19 and vr <= 28 and vr > max_phys do max_phys = vr end
                    eif typ_s2 == 1 or typ_s2 == 2 do
                        vid = native_read_i64(s2_sc, 8)
                        if assigned_phys != 0 and vid >= 0 and vid < vec_len_rt(assigned_phys) do
                            col = vec_get_rt(assigned_phys, vid)
                            if col >= 0 and col < 9 do
                                vr = 19 + col
                                if vr > max_phys do max_phys = vr end
                            end
                        end
                    end
                end
            end
            ii_sc = ii_sc + 1
        end
        bi_sc = bi_sc + 1
    end
    out max_phys
end.

func emit_lir_arm64_into(cb: CodeBuf, func_obj: LirFunc, assigned_phys: i64, lir_funcs: i64, call_fixups: i64, str_fixups: i64):
    # Record function entry offset for TCO self-branch target.
    func_entry_off = codebuf_offset(cb) as i64
    g_codegen_func_obj = func_obj as i64
    g_codegen_max_phys = lir_func_calc_max_phys(func_obj, assigned_phys)

    cb = arm64_stp_pre(cb, 29, 30, 31, 0 - 16)
    cb = arm64_mov_from_sp(cb, 29)
    cb = emit_callee_save(cb, g_codegen_max_phys)

    let ssz = lir_func_stack_size(func_obj)
    if (ssz mod 16) != 0 do
        ssz = ssz + (16 - (ssz mod 16))
    end
    g_codegen_stack_size = ssz
    cb = emit_stack_alloc_arm64(cb, g_codegen_stack_size)

    g_codegen_blocks = native_read_i64(g_codegen_func_obj, 16)
    n_blocks = vec_len_rt(g_codegen_blocks)
    var max_bid = n_blocks
    var bi = 0
    when bi < n_blocks loop
        b = vec_get_rt(g_codegen_blocks, bi)
        bid = native_read_i64(b as i64, 0)
        if bid >= max_bid do
            max_bid = bid + 1
        end
        bi = bi + 1
    end
    block_off = vec_new_cap_rt(1024)
    var bi2 = 0
    when bi2 < max_bid loop
        block_off = vec_push_rt(block_off, 0 - 1)
        bi2 = bi2 + 1
    end
    fixups = vec_new_cap_rt(1024)
    var pending_stk = 0
    var pending_stack_args = vec_new_rt()
    SCR = 9
    SCR2 = 10
    SCRQ = 11
    SCRD = 12

    var bi = 0
    var last_cmp_pred = 0 - 1
    var last_cmp_dst = 0
    recent_setargs = vec_new_cap_rt(8)
    vec_push_rt(recent_setargs, 0)
    vec_push_rt(recent_setargs, 0)
    vec_push_rt(recent_setargs, 0)
    vec_push_rt(recent_setargs, 0)
    reg_const_val = vec_new_cap_rt(32)
    reg_shl_src = vec_new_cap_rt(32)
    reg_shl_amt = vec_new_cap_rt(32)
    reg_shr_src = vec_new_cap_rt(32)
    reg_shr_amt = vec_new_cap_rt(32)
    var rci = 0
    when rci < 32 loop
        vec_push_rt(reg_const_val, 0 - 1)
        vec_push_rt(reg_shl_src, 0 - 1)
        vec_push_rt(reg_shl_amt, 0)
        vec_push_rt(reg_shr_src, 0 - 1)
        vec_push_rt(reg_shr_amt, 0)
        rci = rci + 1
    end
    when bi < n_blocks loop
        var rci2 = 0
        when rci2 < 32 loop
            vec_set_rt(reg_const_val, rci2, 0 - 1)
            vec_set_rt(reg_shl_src, rci2, 0 - 1)
            vec_set_rt(reg_shl_amt, rci2, 0)
            vec_set_rt(reg_shr_src, rci2, 0 - 1)
            vec_set_rt(reg_shr_amt, rci2, 0)
            rci2 = rci2 + 1
        end
        g_codegen_cur_block = vec_get_rt(g_codegen_blocks, bi)
        bid = native_read_i64(g_codegen_cur_block, 0)
        vec_set_rt(block_off, bid, codebuf_offset(cb) as i64)
        g_codegen_cur_instrs = native_read_i64(g_codegen_cur_block, 8)
        n_instrs = vec_len_rt(g_codegen_cur_instrs)
        var ii = 0
        when ii < n_instrs loop
            ins = vec_get_rt(g_codegen_cur_instrs, ii)
            op = native_read_i64(ins as i64, 0)
            ins_typ = native_read_i64(ins as i64, 8)
            ins_dst = native_read_i64(ins as i64, 16)
            ins_src1 = native_read_i64(ins as i64, 24)
            ins_src2 = native_read_i64(ins as i64, 32)
            ins_aux = native_read_i64(ins as i64, 40)
            rd = resolve_reg(ins_dst, assigned_phys)
            # Spilled destination: compute into SCRD, store to slot after the op.
            rd_spill = lir_opnd_spill_off(ins_dst)
            if rd_spill < 0 do
                rd = SCRD
            end
            # Spilled sources: reload into scratch so every consumer sees a reg.
            # Use X14/X15 (not X9/X10) to avoid the temps used by INDEX/FIELD
            # intrinsics and arithmetic operand materialization.
            rs1 = robust_src_reg(cb, ins_src1, assigned_phys, 14)
            rs2 = robust_src_reg(cb, ins_src2, assigned_phys, 15)

            if op == LirOp.Nop do
                last_cmp_pred = 0 - 1
            eif op == LirOp.Mov do
                is_mov_fused = 0
                if (ins_src1 as i64) != 0 do
                    src1_typ = native_read_i64(ins_src1 as i64, 0)
                    if src1_typ == 5 do # Imm
                        imm_val = native_read_i64(ins_src1 as i64, 32)
                        if imm_val == 4294967295 and ii > 0 and (ii + 1) < n_instrs do
                            p_ins = vec_get_rt(g_codegen_cur_instrs, ii - 1)
                            nxt_ins = vec_get_rt(g_codegen_cur_instrs, ii + 1)
                            if native_read_i64(p_ins as i64, 0) == (LirOp.Mul as i64) and native_read_i64(nxt_ins as i64, 0) == (LirOp.And as i64) do
                                is_mov_fused = 1
                            end
                        end
                        if rd >= 0 and rd < 32 do
                            vec_set_rt(reg_const_val, rd, imm_val)
                        end
                        if is_mov_fused == 0 and rd >= 0 do
                            cb = arm64_movz_imm64(cb, rd as int, imm_val as int)
                        end
                    eif rd >= 0 and rs1 >= 0 and rd != rs1 do
                        if rd < 32 and rs1 < 32 do
                            vec_set_rt(reg_const_val, rd, vec_get_rt(reg_const_val, rs1))
                            vec_set_rt(reg_shl_src, rd, vec_get_rt(reg_shl_src, rs1))
                            vec_set_rt(reg_shl_amt, rd, vec_get_rt(reg_shl_amt, rs1))
                            vec_set_rt(reg_shr_src, rd, vec_get_rt(reg_shr_src, rs1))
                            vec_set_rt(reg_shr_amt, rd, vec_get_rt(reg_shr_amt, rs1))
                        end
                        if rd != rs1 do
                            cb = arm64_mov_rr(cb, rd as int, rs1 as int)
                        end
                    end
                end
                last_cmp_pred = 0 - 1
            eif op == LirOp.Add do
                a = resolve_or_imm_reg(cb, ins_src1, assigned_phys, SCR)
                if ins_typ == (LirType.F64 as i64) do
                    breg = resolve_or_imm_reg(cb, ins_src2, assigned_phys, SCR2)
                    if rd >= 0 and a >= 0 and breg >= 0 do
                        cb = arm64_fmov_dx(cb, 0, a as int)
                        cb = arm64_fmov_dx(cb, 1, breg as int)
                        cb = arm64_fadd_ddd(cb, 0, 0, 1)
                        cb = arm64_fmov_xd(cb, rd as int, 0)
                    end
                else
                    is_imm_add = 0
                    imm_v = 0 - 1
                    if (ins_src2 as i64) != 0 do
                        s2_typ = native_read_i64(ins_src2 as i64, 0)
                        if s2_typ == 5 do # Imm
                            imm_v = native_read_i64(ins_src2 as i64, 32)
                        end
                    end
                    if imm_v >= 0 and imm_v <= 4095 and rd >= 0 and a >= 0 do
                        cb = arm64_add_imm(cb, rd as int, a as int, imm_v as int)
                        is_imm_add = 1
                    end
                    if is_imm_add == 0 do
                        breg = resolve_or_imm_reg(cb, ins_src2, assigned_phys, SCR2)
                        if rd >= 0 and a >= 0 and breg >= 0 do
                            cb = arm64_add_rrr(cb, rd as int, a as int, breg as int)
                        end
                    end
                end
                if rd >= 0 and rd < 32 do
                    vec_set_rt(reg_const_val, rd, 0 - 1)
                end
                last_cmp_pred = 0 - 1
            eif op == LirOp.Sub do
                a = resolve_or_imm_reg(cb, ins_src1, assigned_phys, SCR)
                if ins_typ == (LirType.F64 as i64) do
                    breg = resolve_or_imm_reg(cb, ins_src2, assigned_phys, SCR2)
                    if rd >= 0 and a >= 0 and breg >= 0 do
                        cb = arm64_fmov_dx(cb, 0, a as int)
                        cb = arm64_fmov_dx(cb, 1, breg as int)
                        cb = arm64_fsub_ddd(cb, 0, 0, 1)
                        cb = arm64_fmov_xd(cb, rd as int, 0)
                    end
                else
                    is_imm_sub = 0
                    imm_v = 0 - 1
                    if (ins_src2 as i64) != 0 do
                        s2_typ = native_read_i64(ins_src2 as i64, 0)
                        if s2_typ == 5 do # Imm
                            imm_v = native_read_i64(ins_src2 as i64, 32)
                        end
                    end
                    if imm_v >= 0 and imm_v <= 4095 and rd >= 0 and a >= 0 do
                        cb = arm64_sub_imm(cb, rd as int, a as int, imm_v as int)
                        is_imm_sub = 1
                    end
                    if is_imm_sub == 0 do
                        breg = resolve_or_imm_reg(cb, ins_src2, assigned_phys, SCR2)
                        if rd >= 0 and a >= 0 and breg >= 0 do
                            cb = arm64_sub_rrr(cb, rd as int, a as int, breg as int)
                        end
                    end
                end
                if rd >= 0 and rd < 32 do
                    vec_set_rt(reg_const_val, rd, 0 - 1)
                end
                last_cmp_pred = 0 - 1
            eif op == LirOp.Mul do
                a = resolve_or_imm_reg(cb, ins_src1, assigned_phys, SCR)
                breg = resolve_or_imm_reg(cb, ins_src2, assigned_phys, SCR2)
                if ins_typ == (LirType.F64 as i64) do
                    if rd >= 0 and a >= 0 and breg >= 0 do
                        cb = arm64_fmov_dx(cb, 0, a as int)
                        cb = arm64_fmov_dx(cb, 1, breg as int)
                        cb = arm64_fmul_ddd(cb, 0, 0, 1)
                        cb = arm64_fmov_xd(cb, rd as int, 0)
                    end
                else
                    is_fused_32bit_mul = 0
                    if (ii + 2) < n_instrs do
                        mov_ins = vec_get_rt(g_codegen_cur_instrs, ii + 1)
                        and_ins = vec_get_rt(g_codegen_cur_instrs, ii + 2)
                        if native_read_i64(mov_ins as i64, 0) == 1 and native_read_i64(and_ins as i64, 0) == (LirOp.And as i64) do
                            m_src1 = native_read_i64(mov_ins as i64, 24)
                            m_dst = native_read_i64(mov_ins as i64, 16)
                            if (m_src1 as i64) != 0 do
                                if native_read_i64(m_src1 as i64, 0) == 4 and native_read_i64(m_src1 as i64, 32) == 4294967295 do
                                    a_s1 = native_read_i64(and_ins as i64, 24)
                                    a_s2 = native_read_i64(and_ins as i64, 32)
                                    a_dst = native_read_i64(and_ins as i64, 16)
                                    if (lir_opnd_matches(ins_dst, a_s1) == 1 and lir_opnd_matches(m_dst, a_s2) == 1) or (lir_opnd_matches(ins_dst, a_s2) == 1 and lir_opnd_matches(m_dst, a_s1) == 1) do
                                        n_rd = -1
                                        if a_dst != 0 do
                                            if native_read_i64(a_dst, 0) == 1 do
                                                v_id = native_read_i64(a_dst, 8)
                                                if v_id >= 0 and v_id < vec_len_rt(assigned_phys) do
                                                    p_c = vec_get_rt(assigned_phys, v_id)
                                                    if p_c >= 0 do n_rd = color_to_phys(p_c, 0) end
                                                end
                                            eif native_read_i64(a_dst, 0) == 2 do
                                                n_rd = native_read_i64(a_dst, 16)
                                            end
                                        end
                                        target_rd = rd
                                        if n_rd >= 0 do target_rd = n_rd end
                                        if target_rd >= 0 and a >= 0 and breg >= 0 do
                                            mul_w = 0x1B007C00 or ((breg as int and 0x1F) shl 16) or ((a as int and 0x1F) shl 5) or (target_rd as int and 0x1F)
                                            cb = codebuf_emit_u32(cb, mul_w)
                                            is_fused_32bit_mul = 1
                                        end
                                    end
                                end
                            end
                        end
                    end
                    if is_fused_32bit_mul == 0 and (ii + 1) < n_instrs do
                        next_ins = vec_get_rt(g_codegen_cur_instrs, ii + 1)
                        if native_read_i64(next_ins as i64, 0) == (LirOp.And as i64) do
                            n_s1 = native_read_i64(next_ins as i64, 24)
                            n_s2 = native_read_i64(next_ins as i64, 32)
                            n_dst = native_read_i64(next_ins as i64, 16)
                            var mask_val = 0 - 1
                            if (n_s2 as i64) != 0 do
                                if native_read_i64(n_s2 as i64, 0) == 4 do
                                    mask_val = native_read_i64(n_s2 as i64, 32)
                                end
                            end
                            if mask_val == 4294967295 and lir_opnd_matches(ins_dst, n_s1) == 1 do
                                n_rd = -1
                                if n_dst != 0 do
                                    if native_read_i64(n_dst, 0) == 1 do
                                        v_id = native_read_i64(n_dst, 8)
                                        if v_id >= 0 and v_id < vec_len_rt(assigned_phys) do
                                            p_c = vec_get_rt(assigned_phys, v_id)
                                            if p_c >= 0 do n_rd = color_to_phys(p_c, 0) end
                                        end
                                    eif native_read_i64(n_dst, 0) == 2 do
                                        n_rd = native_read_i64(n_dst, 16)
                                    end
                                end
                                target_rd = rd
                                if n_rd >= 0 do target_rd = n_rd end
                                if target_rd >= 0 and a >= 0 and breg >= 0 do
                                    mul_w = 0x1B007C00 or ((breg as int and 0x1F) shl 16) or ((a as int and 0x1F) shl 5) or (target_rd as int and 0x1F)
                                    cb = codebuf_emit_u32(cb, mul_w)
                                    is_fused_32bit_mul = 1
                                end
                            end
                        end
                    end
                    if is_fused_32bit_mul == 0 do
                        if rd >= 0 and a >= 0 and breg >= 0 do
                            cb = arm64_mul_rrr(cb, rd as int, a as int, breg as int)
                        end
                    end
                end
                if rd >= 0 and rd < 32 do
                    vec_set_rt(reg_const_val, rd, 0 - 1)
                end
                last_cmp_pred = 0 - 1
            eif op == LirOp.Div do
                a = resolve_or_imm_reg(cb, ins_src1, assigned_phys, SCR)
                breg = resolve_or_imm_reg(cb, ins_src2, assigned_phys, SCR2)
                if ins_typ == (LirType.F64 as i64) do
                    if rd >= 0 and a >= 0 and breg >= 0 do
                        cb = arm64_fmov_dx(cb, 0, a as int)
                        cb = arm64_fmov_dx(cb, 1, breg as int)
                        cb = arm64_fdiv_ddd(cb, 0, 0, 1)
                        cb = arm64_fmov_xd(cb, rd as int, 0)
                    end
                else
                    if rd >= 0 and a >= 0 and breg >= 0 do
                        cb = arm64_sdiv_rrr(cb, rd as int, a as int, breg as int)
                    end
                end
                if rd >= 0 and rd < 32 do
                    vec_set_rt(reg_const_val, rd, 0 - 1)
                end
                last_cmp_pred = 0 - 1
            eif op == LirOp.Rem do
                a = resolve_or_imm_reg(cb, ins_src1, assigned_phys, SCR)
                breg = resolve_or_imm_reg(cb, ins_src2, assigned_phys, SCR2)
                if rd >= 0 and a >= 0 and breg >= 0 do
                    cb = arm64_sdiv_rrr(cb, SCRQ, a as int, breg as int)
                    cb = arm64_msub_rrrr(cb, rd as int, SCRQ, breg as int, a as int)
                end
                if rd >= 0 and rd < 32 do
                    vec_set_rt(reg_const_val, rd, 0 - 1)
                end
                last_cmp_pred = 0 - 1
            eif op == LirOp.And do
                is_prev_fused = 0
                var is_32bit_mask = 0
                if (ins_src2 as i64) != 0 do
                    if native_read_i64(ins_src2 as i64, 0) == 4 and native_read_i64(ins_src2 as i64, 32) == 4294967295 do
                        is_32bit_mask = 1
                    end
                end
                if is_32bit_mask == 0 and rs2 >= 0 and rs2 < 32 do
                    if vec_get_rt(reg_const_val, rs2) == 4294967295 do
                        is_32bit_mask = 1
                    end
                end
                if is_32bit_mask == 1 do
                    if ii > 0 do
                        prev_ins = vec_get_rt(g_codegen_cur_instrs, ii - 1)
                        if native_read_i64(prev_ins as i64, 0) == (LirOp.Mul as i64) do
                            is_prev_fused = 1
                        end
                    end
                    if is_prev_fused == 0 and ii > 1 do
                        prev2_ins = vec_get_rt(g_codegen_cur_instrs, ii - 2)
                        if native_read_i64(prev2_ins as i64, 0) == (LirOp.Mul as i64) do
                            is_prev_fused = 1
                        end
                    end
                end
                if is_prev_fused == 0 do
                    is_mask_imm = 0
                    mask_v = 0 - 1
                    var var_opnd = ins_src1
                    if (ins_src2 as i64) != 0 do
                        s2_typ = native_read_i64(ins_src2 as i64, 0)
                        if s2_typ == 5 do # Imm
                            mask_v = native_read_i64(ins_src2 as i64, 32)
                            var_opnd = ins_src1
                        end
                    end
                    if mask_v < 0 and (ins_src1 as i64) != 0 do
                        s1_typ = native_read_i64(ins_src1 as i64, 0)
                        if s1_typ == 5 do # Imm
                            mask_v = native_read_i64(ins_src1 as i64, 32)
                            var_opnd = ins_src2
                        end
                    end
                    if mask_v == 255 or mask_v == 4095 or mask_v == 65535 or mask_v == 4294967295 do
                        vreg = resolve_or_imm_reg(cb, var_opnd, assigned_phys, SCR)
                        if rd >= 0 and vreg >= 0 do
                            cb = arm64_and_mask(cb, rd as int, vreg as int, mask_v)
                            is_mask_imm = 1
                        end
                    end
                    if is_mask_imm == 0 do
                        a = resolve_or_imm_reg(cb, ins_src1, assigned_phys, SCR)
                        breg = resolve_or_imm_reg(cb, ins_src2, assigned_phys, SCR2)
                        if rd >= 0 and a >= 0 and breg >= 0 do
                            cb = arm64_and_rrr(cb, rd as int, a as int, breg as int)
                        end
                    end
                end
                if rd >= 0 and rd < 32 do
                    vec_set_rt(reg_const_val, rd, 0 - 1)
                    is_32bit_and = 0
                    if mask_v == 4294967295 or mask_v == 0xFFFFFFFF do
                        is_32bit_and = 1
                    end
                    if is_32bit_and == 0 and rs2 >= 0 and rs2 < 32 do
                        if vec_get_rt(reg_const_val, rs2) == 4294967295 or vec_get_rt(reg_const_val, rs2) == 0xFFFFFFFF do
                            is_32bit_and = 1
                        end
                    end
                    if is_32bit_and == 1 and rs1 >= 0 and rs1 < 32 do
                        vec_set_rt(reg_shl_src, rd, vec_get_rt(reg_shl_src, rs1))
                        vec_set_rt(reg_shl_amt, rd, vec_get_rt(reg_shl_amt, rs1))
                        vec_set_rt(reg_shr_src, rd, vec_get_rt(reg_shr_src, rs1))
                        vec_set_rt(reg_shr_amt, rd, vec_get_rt(reg_shr_amt, rs1))
                    else
                        vec_set_rt(reg_shl_src, rd, 0 - 1)
                        vec_set_rt(reg_shr_src, rd, 0 - 1)
                    end
                end
                last_cmp_pred = 0 - 1
            eif op == LirOp.Or do
                a = resolve_or_imm_reg(cb, ins_src1, assigned_phys, SCR)
                breg = resolve_or_imm_reg(cb, ins_src2, assigned_phys, SCR2)
                is_ror = 0
                if a >= 0 and a < 32 and breg >= 0 and breg < 32 and rd >= 0 do
                    shl_src_a = vec_get_rt(reg_shl_src, a)
                    shr_src_b = vec_get_rt(reg_shr_src, breg)
                    shl_amt_a = vec_get_rt(reg_shl_amt, a)
                    shr_amt_b = vec_get_rt(reg_shr_amt, breg)
                    if shl_src_a >= 0 and shl_src_a == shr_src_b and (shl_amt_a + shr_amt_b == 32) do
                        shift = 32 - shl_amt_a
                        cb = arm64_ror_imm32(cb, rd as int, shl_src_a as int, shift as int)
                        is_ror = 1
                    else
                        shr_src_a = vec_get_rt(reg_shr_src, a)
                        shl_src_b = vec_get_rt(reg_shl_src, breg)
                        shr_amt_a = vec_get_rt(reg_shr_amt, a)
                        shl_amt_b = vec_get_rt(reg_shl_amt, breg)
                        if shr_src_a >= 0 and shr_src_a == shl_src_b and (shr_amt_a + shl_amt_b == 32) do
                            shift = 32 - shl_amt_b
                            cb = arm64_ror_imm32(cb, rd as int, shr_src_a as int, shift as int)
                            is_ror = 1
                        end
                    end
                end
                if is_ror == 0 do
                    if rd >= 0 and a >= 0 and breg >= 0 do
                        cb = arm64_orr_rrr(cb, rd as int, a as int, breg as int)
                    end
                end
                if rd >= 0 and rd < 32 do
                    vec_set_rt(reg_const_val, rd, 0 - 1)
                    vec_set_rt(reg_shl_src, rd, 0 - 1)
                    vec_set_rt(reg_shr_src, rd, 0 - 1)
                end
                last_cmp_pred = 0 - 1
            eif op == LirOp.Xor do
                a = resolve_or_imm_reg(cb, ins_src1, assigned_phys, SCR)
                breg = resolve_or_imm_reg(cb, ins_src2, assigned_phys, SCR2)
                is_eor_lsr = 0
                if rd >= 0 and a >= 0 and breg >= 0 and breg < 32 do
                    shr_src_b = vec_get_rt(reg_shr_src, breg)
                    shr_amt_b = vec_get_rt(reg_shr_amt, breg)
                    if shr_src_b >= 0 and shr_amt_b > 0 and shr_amt_b < 64 do
                        cb = arm64_eor_lsr64(cb, rd as int, a as int, shr_src_b as int, shr_amt_b as int)
                        is_eor_lsr = 1
                    end
                end
                if is_eor_lsr == 0 do
                    if rd >= 0 and a >= 0 and breg >= 0 do
                        cb = arm64_eor_rrr(cb, rd as int, a as int, breg as int)
                    end
                end
                if rd >= 0 and rd < 32 do
                    vec_set_rt(reg_const_val, rd, 0 - 1)
                    vec_set_rt(reg_shl_src, rd, 0 - 1)
                    vec_set_rt(reg_shr_src, rd, 0 - 1)
                end
                last_cmp_pred = 0 - 1
            eif op == LirOp.Shl do
                a = resolve_or_imm_reg(cb, ins_src1, assigned_phys, SCR)
                shl_k = 0 - 1
                if (ins_src2 as i64) != 0 do
                    s2_typ = native_read_i64(ins_src2 as i64, 0)
                    if s2_typ == 4 do
                        shl_k = native_read_i64(ins_src2 as i64, 32)
                    end
                end
                if shl_k < 0 and rs2 >= 0 and rs2 < 32 do
                    shl_k = vec_get_rt(reg_const_val, rs2)
                end
                if shl_k >= 0 and shl_k <= 63 and rd >= 0 and a >= 0 do
                    cb = arm64_lsl_imm(cb, rd as int, a as int, shl_k as int)
                else
                    breg = resolve_or_imm_reg(cb, ins_src2, assigned_phys, SCR2)
                    if rd >= 0 and a >= 0 and breg >= 0 do
                        cb = arm64_lsl_rrr(cb, rd as int, a as int, breg as int)
                    end
                end
                if rd >= 0 and rd < 32 do
                    vec_set_rt(reg_const_val, rd, 0 - 1)
                    if a >= 0 and shl_k > 0 and shl_k < 32 do
                        vec_set_rt(reg_shl_src, rd, a)
                        vec_set_rt(reg_shl_amt, rd, shl_k)
                    else
                        vec_set_rt(reg_shl_src, rd, 0 - 1)
                    end
                    vec_set_rt(reg_shr_src, rd, 0 - 1)
                end
                last_cmp_pred = 0 - 1
            eif op == LirOp.Shr do
                a = resolve_or_imm_reg(cb, ins_src1, assigned_phys, SCR)
                shr_m = 0 - 1
                if (ins_src2 as i64) != 0 do
                    s2_typ = native_read_i64(ins_src2 as i64, 0)
                    if s2_typ == 4 do
                        shr_m = native_read_i64(ins_src2 as i64, 32)
                    end
                end
                if shr_m < 0 and rs2 >= 0 and rs2 < 32 do
                    shr_m = vec_get_rt(reg_const_val, rs2)
                end
                if shr_m >= 0 and shr_m <= 63 and rd >= 0 and a >= 0 do
                    cb = arm64_lsr_imm(cb, rd as int, a as int, shr_m as int)
                else
                    breg = resolve_or_imm_reg(cb, ins_src2, assigned_phys, SCR2)
                    if rd >= 0 and a >= 0 and breg >= 0 do
                        cb = arm64_lsr_rrr(cb, rd as int, a as int, breg as int)
                    end
                end
                if rd >= 0 and rd < 32 do
                    vec_set_rt(reg_const_val, rd, 0 - 1)
                    if a >= 0 and shr_m > 0 and shr_m < 32 do
                        vec_set_rt(reg_shr_src, rd, a)
                        vec_set_rt(reg_shr_amt, rd, shr_m)
                    else
                        vec_set_rt(reg_shr_src, rd, 0 - 1)
                    end
                    vec_set_rt(reg_shl_src, rd, 0 - 1)
                end
                last_cmp_pred = 0 - 1
            eif op == LirOp.Not do
                a = resolve_or_imm_reg(cb, ins_src1, assigned_phys, SCR)
                if rd >= 0 and a >= 0 do
                    cb = arm64_mvn_rr(cb, rd as int, a as int)
                end
                if rd >= 0 and rd < 32 do
                    vec_set_rt(reg_const_val, rd, 0 - 1)
                end
                last_cmp_pred = 0 - 1
            eif op == LirOp.Pow do
                cb = emit_bl_fixup(cb, call_fixups, 1, LIR_RT_POW, rd)
                last_cmp_pred = 0 - 1
            eif op == LirOp.MatMul do
                a = resolve_or_imm_reg(cb, ins_src1, assigned_phys, SCR)
                b_reg = resolve_or_imm_reg(cb, ins_src2, assigned_phys, SCR2)
                if a == 1 and b_reg == 0 do
                    cb = arm64_mov_rr(cb, SCR, 0)
                    cb = arm64_mov_rr(cb, 0, 1)
                    cb = arm64_mov_rr(cb, 1, SCR)
                eif a == 1 do
                    cb = arm64_mov_rr(cb, 0, 1)
                    if b_reg >= 0 and b_reg != 1 do
                        cb = arm64_mov_rr(cb, 1, b_reg as int)
                    end
                else
                    if a >= 0 and a != 0 do
                        cb = arm64_mov_rr(cb, 0, a as int)
                    end
                    if b_reg >= 0 and b_reg != 1 do
                        cb = arm64_mov_rr(cb, 1, b_reg as int)
                    end
                end
                ins_aux = native_read_i64(ins as i64, 40)
                var mm_is_float = (ins_aux shr 48) and 1
                var is_32bit = (ins_aux shr 49) and 1
                var dim_m = (ins_aux shr 32) and 65535
                var dim_k = (ins_aux shr 16) and 65535
                var dim_n = ins_aux and 65535
                cb = arm64_mov_imm16(cb, 2, dim_m as int)
                cb = arm64_mov_imm16(cb, 3, dim_k as int)
                cb = arm64_mov_imm16(cb, 4, dim_n as int)
                cb = arm64_mov_imm16(cb, 5, is_32bit as int)
                if mm_is_float == 1 do
                    cb = emit_bl_fixup(cb, call_fixups, 1, LIR_RT_MATMUL_F64, rd)
                else
                    cb = emit_bl_fixup(cb, call_fixups, 1, LIR_RT_MATMUL, rd)
                end
                if rd < 0 and ins_dst != 0 do
                    cb = emit_spill_store(cb, ins_dst as i64, 0)
                end
                last_cmp_pred = 0 - 1
            eif op == LirOp.Fma do
                a_fma = resolve_or_imm_reg(cb, ins_src1, assigned_phys, SCR)
                b_fma = resolve_or_imm_reg(cb, ins_src2, assigned_phys, SCR2)
                if a_fma == 1 and b_fma == 0 do
                    cb = arm64_mov_rr(cb, SCR, 0)
                    cb = arm64_mov_rr(cb, 0, 1)
                    cb = arm64_mov_rr(cb, 1, SCR)
                eif a_fma == 1 do
                    cb = arm64_mov_rr(cb, 0, 1)
                    if b_fma >= 0 and b_fma != 1 do cb = arm64_mov_rr(cb, 1, b_fma as int) end
                else
                    if a_fma >= 0 and a_fma != 0 do cb = arm64_mov_rr(cb, 0, a_fma as int) end
                    if b_fma >= 0 and b_fma != 1 do cb = arm64_mov_rr(cb, 1, b_fma as int) end
                end
                fma_aux = native_read_i64(ins as i64, 40)
                fma_is_float = (fma_aux shr 48) and 1
                var fma_is_32bit = (fma_aux shr 49) and 1
                fma_m = (fma_aux shr 32) and 65535
                fma_k = (fma_aux shr 16) and 65535
                fma_n = fma_aux and 65535
                cb = arm64_mov_imm16(cb, 2, fma_m as int)
                cb = arm64_mov_imm16(cb, 3, fma_k as int)
                cb = arm64_mov_imm16(cb, 4, fma_n as int)
                cb = arm64_mov_imm16(cb, 5, fma_is_32bit as int)
                if fma_is_float == 1 do
                    cb = emit_bl_fixup(cb, call_fixups, 1, LIR_RT_FMA_F64, rd)
                else
                    cb = emit_bl_fixup(cb, call_fixups, 1, LIR_RT_FMA, rd)
                end
                if rd < 0 and ins_dst != 0 do cb = emit_spill_store(cb, ins_dst as i64, 0) end
                last_cmp_pred = 0 - 1
            # TCO: self-recursive tail-call — emit B <func_entry> instead of BL+RET.
            # Arguments must already be in X0..X7 via preceding SetArg instructions.
            # We restore the frame before branching so the callee sees a clean state.
            eif op == LirOp.TailCall do
                # Restore stack pointer to pre-prologue state
                cb = emit_stack_free_arm64(cb, g_codegen_stack_size)
                cb = emit_callee_restore(cb, g_codegen_max_phys)
                # Restore FP/LR that were saved in prologue
                cb = arm64_ldp_post(cb, 29, 30, 31, 16)
                # Re-enter the function at its first instruction (after prologue saves).
                # This is a guaranteed backward branch so offset is negative.
                at_tco = codebuf_offset(cb) as i64
                cb = arm64_stp_pre(cb, 29, 30, 31, 0 - 16)
                cb = arm64_mov_from_sp(cb, 29)
                cb = emit_callee_save(cb, g_codegen_max_phys)
                cb = emit_stack_alloc_arm64(cb, g_codegen_stack_size)
                # Branch back to body start (first block after prologue), using a fixup.
                at_jmp = codebuf_offset(cb) as i64
                cb = arm64_b_imm26(cb, 0)
                fixups = vec_push_rt(fixups, lir_fixup_new(at_jmp, 0, 0))
                last_cmp_pred = 0 - 1
            eif op == LirOp.Cmp do
                a = resolve_or_imm_reg(cb, ins_src1, assigned_phys, SCR)
                is_imm_cmp = 0
                imm_v = 0 - 1
                if (ins_src2 as i64) != 0 do
                    s2_typ = native_read_i64(ins_src2 as i64, 0)
                    if s2_typ == 5 do # Imm
                        imm_v = native_read_i64(ins_src2 as i64, 32)
                    end
                end
                if imm_v >= 0 and imm_v <= 4095 and a >= 0 do
                    cb = arm64_cmp_imm(cb, a as int, imm_v as int)
                    is_imm_cmp = 1
                end
                if is_imm_cmp == 0 do
                    b_val = resolve_or_imm_reg(cb, ins_src2, assigned_phys, 10)
                    if a >= 0 and b_val >= 0 do
                        cb = arm64_cmp_rr(cb, a as int, b_val as int)
                    end
                end
                is_fused = 0
                if (ii + 1) < n_instrs do
                    next_ins = vec_get_rt(g_codegen_cur_instrs, ii + 1)
                    if native_read_i64(next_ins as i64, 0) == (LirOp.JmpCond as i64) do
                        next_src1 = native_read_i64(next_ins as i64, 24)
                        if lir_opnd_matches(ins_dst, next_src1) == 1 do
                            is_fused = 1
                            last_cmp_pred = ins_aux
                            last_cmp_dst = ins_dst
                        end
                    end
                end
                if is_fused == 0 do
                    last_cmp_pred = 0 - 1
                    if rd >= 0 do
                        if ins_aux == LIR_CMP_EQ do
                            cb = arm64_cset_eq(cb, rd as int)
                        eif ins_aux == LIR_CMP_NE do
                            cb = arm64_cset_ne(cb, rd as int)
                        eif ins_aux == LIR_CMP_GT do
                            cb = arm64_cset_gt(cb, rd as int)
                        eif ins_aux == LIR_CMP_LT do
                            cb = arm64_cset_lt(cb, rd as int)
                        eif ins_aux == LIR_CMP_GE do
                            cb = arm64_cset_ge(cb, rd as int)
                        eif ins_aux == LIR_CMP_LE do
                            cb = arm64_cset_le(cb, rd as int)
                        end
                    end
                end
                if rd >= 0 and rd < 32 do
                    vec_set_rt(reg_const_val, rd, 0 - 1)
                end
            eif op == LirOp.Load do
                if rd >= 0 and rs1 >= 0 do
                    load_aux = native_read_i64(ins as i64, 40)
                    if load_aux == 1 do
                        cb = codebuf_emit_u32(cb, 0x39400000 or ((rs1 as int and 0x1F) shl 5) or (rd as int and 0x1F))
                    eif load_aux == (0 - 1) do
                        cb = codebuf_emit_u32(cb, 0x39800000 or ((rs1 as int and 0x1F) shl 5) or (rd as int and 0x1F))
                    eif load_aux == 2 do
                        cb = codebuf_emit_u32(cb, 0x79400000 or ((rs1 as int and 0x1F) shl 5) or (rd as int and 0x1F))
                    eif load_aux == (0 - 2) do
                        cb = codebuf_emit_u32(cb, 0x79800000 or ((rs1 as int and 0x1F) shl 5) or (rd as int and 0x1F))
                    eif load_aux == 4 do
                        cb = codebuf_emit_u32(cb, 0xB9400000 or ((rs1 as int and 0x1F) shl 5) or (rd as int and 0x1F))
                    eif load_aux == (0 - 4) do
                        cb = codebuf_emit_u32(cb, 0xB9800000 or ((rs1 as int and 0x1F) shl 5) or (rd as int and 0x1F))
                    else
                        cb = codebuf_emit_u32(cb, 0xF9400000 or ((rs1 as int and 0x1F) shl 5) or (rd as int and 0x1F))
                    end
                end
                if rd >= 0 and rd < 32 do
                    vec_set_rt(reg_const_val, rd, 0 - 1)
                end
                last_cmp_pred = 0 - 1
            eif op == LirOp.Store do
                if rs1 >= 0 and rs2 >= 0 do
                    store_aux = native_read_i64(ins as i64, 40)
                    if store_aux == 1 or store_aux == (0 - 1) do
                        cb = codebuf_emit_u32(cb, 0x39000000 or ((rs2 as int and 0x1F) shl 5) or (rs1 as int and 0x1F))
                    eif store_aux == 2 or store_aux == (0 - 2) do
                        cb = codebuf_emit_u32(cb, 0x79000000 or ((rs2 as int and 0x1F) shl 5) or (rs1 as int and 0x1F))
                    eif store_aux == 4 or store_aux == (0 - 4) do
                        cb = codebuf_emit_u32(cb, 0xB9000000 or ((rs2 as int and 0x1F) shl 5) or (rs1 as int and 0x1F))
                    else
                        cb = codebuf_emit_u32(cb, 0xF9000000 or ((rs2 as int and 0x1F) shl 5) or (rs1 as int and 0x1F))
                    end
                end
                last_cmp_pred = 0 - 1
            eif op == LirOp.Push do
                rval = resolve_or_imm_reg(cb, ins_src1, assigned_phys, SCR)
                if rval >= 0 do
                    cb = arm64_str_pre(cb, rval as int, 31, 0 - 16)
                end
                last_cmp_pred = 0 - 1
            eif op == LirOp.SetArg do
                ai = native_read_i64(ins as i64, 40)
                s1_arg = native_read_i64(ins as i64, 24)
                if (s1_arg as i64) != 0 do
                    if native_read_i64(s1_arg as i64, 0) == 5 do # Imm tag
                        ai = native_read_i64(s1_arg as i64, 32)
                    end
                end
                s2_arg = native_read_i64(ins as i64, 32)
                if ai >= 0 and ai < 4 do
                    vec_set_rt(recent_setargs, ai, s2_arg)
                end
                if ai < 8 do
                    var (cb_sa, p_stk_sa) = emit_lir_setarg(cb, ins, assigned_phys, 0)
                    cb = cb_sa
                else
                    pending_stack_args = vec_push_rt(pending_stack_args, ins)
                end
                last_cmp_pred = 0 - 1
            eif op == LirOp.Pop do
                if rd >= 0 do
                    cb = arm64_ldr_post(cb, rd as int, 31, 16)
                end
            eif op == LirOp.Call do
                n_stk = vec_len_rt(pending_stack_args)
                stk_bytes = 0
                if n_stk > 0 do
                    stk_bytes = (n_stk * 8) + 15
                    stk_bytes = stk_bytes - (stk_bytes mod 16)
                    cb = emit_stack_alloc_arm64(cb, stk_bytes)
                    var si = 0
                    when si < n_stk loop
                        stk_ins = vec_get_rt(pending_stack_args, si)
                        stk_s2 = native_read_i64(stk_ins as i64, 32)
                        var (cb_s, r_s) = lir_load_opnd_to_reg(cb, stk_s2, assigned_phys, SCR)
                        cb = cb_s
                        cb = arm64_str_uoff(cb, r_s as int, 31, (si * 8) as int)
                        si = si + 1
                    end
                end
                var (cb_cl, p_stk_cl) = emit_lir_call(cb, ins, rd, func_obj, lir_funcs, call_fixups, 0, assigned_phys)
                cb = cb_cl
                if stk_bytes > 0 do
                    cb = emit_stack_free_arm64(cb, stk_bytes)
                    pending_stack_args = vec_new_rt()
                end
                last_cmp_pred = 0 - 1
            eif op == LirOp.Intrinsic do
                pending_stack_args = vec_new_rt()
                cb = emit_lir_intrinsic(cb, ins, rd, rs1, assigned_phys, call_fixups, func_obj, str_fixups, recent_setargs, lir_funcs)
                last_cmp_pred = 0 - 1
            eif op == LirOp.Jmp do
                tgt = 0 - 1
                if (ins_src1 as i64) != 0 do
                    src1_typ = native_read_i64(ins_src1 as i64, 0)
                    if src1_typ == 6 do # Label
                        tgt = native_read_i64(ins_src1 as i64, 40)
                    eif src1_typ == 5 do # Imm
                        tgt = native_read_i64(ins_src1 as i64, 32)
                    end
                end
                if tgt >= 0 do
                    next_bid = 0 - 1
                    if bi + 1 < n_blocks do
                        next_b = vec_get_rt(g_codegen_blocks, bi + 1)
                        next_bid = native_read_i64(next_b as i64, 0)
                    end
                    if tgt != next_bid do
                        at = codebuf_offset(cb) as i64
                        cb = arm64_b_imm26(cb, 0)
                        fixups = vec_push_rt(fixups, lir_fixup_new(at, tgt, 0))
                    end
                end
                last_cmp_pred = 0 - 1
            eif op == LirOp.JmpCond do
                tgt = 0 - 1
                if (ins_src2 as i64) != 0 do
                    src2_typ = native_read_i64(ins_src2 as i64, 0)
                    if src2_typ == 6 do # Label
                        tgt = native_read_i64(ins_src2 as i64, 40)
                    eif src2_typ == 5 do # Imm
                        tgt = native_read_i64(ins_src2 as i64, 32)
                    end
                end
                if last_cmp_pred >= 0 and lir_opnd_matches(last_cmp_dst, ins_src1) == 1 do
                    # Fused Cmp + JmpCond: flags already in NZCV, branch directly to condition!
                    if tgt >= 0 do
                        at = codebuf_offset(cb) as i64
                        is_ifnot = 0
                        if ins_aux == LIR_JMP_IFNOT do
                            is_ifnot = 1
                        end
                        cond = arm64_cond_code(last_cmp_pred, is_ifnot)
                        cb = codebuf_emit_u32(cb, 0x54000000)
                        fixups = vec_push_rt(fixups, lir_fixup_new(at, tgt, 10 + cond))
                    end
                    last_cmp_pred = 0 - 1
                else
                    a = resolve_or_imm_reg(cb, ins_src1, assigned_phys, SCR)
                    if a >= 0 do
                        cb = codebuf_emit_u32(cb, 0xF100001F or ((a as int and 0x1F) shl 5))
                    end
                    if tgt >= 0 do
                        at = codebuf_offset(cb) as i64
                        kind = 2
                        if ins_aux == LIR_JMP_IFNOT do
                            kind = 1
                        end
                        if kind == 1 do
                            cb = arm64_beq_imm19(cb, 0)
                        else
                            cb = arm64_bne_imm19(cb, 0)
                        end
                        fixups = vec_push_rt(fixups, lir_fixup_new(at, tgt, kind))
                    end
                    last_cmp_pred = 0 - 1
                end
            eif op == LirOp.Ret do
                if (ins_src1 as i64) != 0 do
                    src1_typ = native_read_i64(ins_src1 as i64, 0)
                    if src1_typ == 5 do # Imm
                        imm_val = native_read_i64(ins_src1 as i64, 32)
                        cb = arm64_movz_imm64(cb, 0, imm_val as int)
                    eif rs1 >= 0 and rs1 != 0 do
                        cb = arm64_mov_rr(cb, 0, rs1 as int)
                    eif src1_typ == 0 do
                        cb = arm64_mov_imm16(cb, 0, 0)
                    end
                eif rs1 >= 0 and rs1 != 0 do
                    cb = arm64_mov_rr(cb, 0, rs1 as int)
                else
                    cb = arm64_mov_imm16(cb, 0, 0)
                end
                cb = emit_stack_free_arm64(cb, g_codegen_stack_size)
                cb = emit_callee_restore(cb, g_codegen_max_phys)
                cb = arm64_ldp_post(cb, 29, 30, 31, 16)
                cb = arm64_ret(cb)
                last_cmp_pred = 0 - 1
            end
            if rd_spill < 0 do
                cb = emit_spill_store(cb, ins_dst, SCRD)
            end
            ii = ii + 1
        end
        bi = bi + 1
    end

    # Fall-through epilogue (when function has no explicit Ret)
    cb = arm64_mov_imm16(cb, 0, 0)
    cb = emit_stack_free_arm64(cb, g_codegen_stack_size)
    cb = emit_callee_restore(cb, g_codegen_max_phys)
    cb = arm64_ldp_post(cb, 29, 30, 31, 16)
    cb = arm64_ret(cb)

    nf = vec_len_rt(fixups)
    var fxi = 0
    when fxi < nf loop
        fx = vec_get_rt(fixups, fxi)
        f_tgt = lir_fixup_target_block(fx)
        f_kind = lir_fixup_kind(fx)
        f_at = lir_fixup_at_off(fx)
        if f_tgt >= 0 and f_tgt < max_bid do
            dest = vec_get_rt(block_off, f_tgt)
            if dest >= 0 do
                rel = (dest - f_at) as int
                if f_kind == 0 do
                    imm26 = (rel shr 2) and 0x03FFFFFF
                    word = 0x14000000 or imm26
                    cb = codebuf_patch_u32(cb, f_at as int, word)
                else
                    # Conditional branch B.cond immediate range is ±1 MiB (-1048576 .. 1048572)
                    if rel < -1048576 or rel > 1048572 do
                        print_str("FATAL: ARM64 conditional branch out of range (+/-1MB)\n")
                    end
                    imm19 = (rel shr 2) and 0x7FFFF
                    if f_kind == 1 do
                        word = 0x54000000 or (imm19 shl 5)
                        cb = codebuf_patch_u32(cb, f_at as int, word)
                    eif f_kind == 2 do
                        word = 0x54000001 or (imm19 shl 5)
                        cb = codebuf_patch_u32(cb, f_at as int, word)
                    eif f_kind >= 10 do
                        cond = (f_kind - 10) and 0xF
                        word = 0x54000000 or (imm19 shl 5) or cond
                        cb = codebuf_patch_u32(cb, f_at as int, word)
                    end
                end
            end
        end
        fxi = fxi + 1
    end

    out cb
end.

func emit_lir_module_arm64(lir_funcs: i64, is_linux: i64):
    arm64_prepare_func_index(lir_funcs)
    var va_base = 0x100000268
    if is_linux == 1 do
        va_base = 0x401000
        va_base = 0x410000
    eif ffi_import_used_count() > 0 do
        va_base = 0x100000800
    end
    var cb = codebuf_new(TargetArch.ARM64)
    let n_funcs = vec_len_rt(lir_funcs)
    var func_offs = vec_new_cap_rt(4096)
    var call_fixups_box = alloc(8)
    native_write_i64(call_fixups_box, 0, vec_new_cap_rt(65536))
    var str_fixups_box = alloc(8)
    native_write_i64(str_fixups_box, 0, vec_new_cap_rt(65536))

    var fi = 0
    when fi < n_funcs loop
        func_offs = vec_push_rt(func_offs, codebuf_offset(cb) as i64)
        let lf = vec_get_rt(lir_funcs, fi)
        cb = emit_lir_arm64_into(cb, lf, 0 - 1, lir_funcs, call_fixups_box, str_fixups_box)
        fi = fi + 1
    end

    var rt_offs = vec_new_cap_rt(1024)
    cb = emit_lir_rt_stubs(cb, rt_offs, is_linux)



    cb.start_offset = codebuf_offset(cb)
    if is_linux == 1 do
        # ── Linux ARM64 ELF Entry: [SP] = argc, SP + 8 = argv ──
        cb = arm64_ldr_uoff(cb, 19, 31, 0)   # X19 = argc
        cb = arm64_add_imm(cb, 20, 31, 8)    # X20 = argv
        cb = arm64_stp_pre(cb, 29, 30, 31, 0 - 16)
        cb = arm64_mov_from_sp(cb, 29)

        # ── Initialize 2GB Global Arena Heap via Linux mmap ──
        cb = arm64_mov_imm16(cb, 0, 0)
        cb = arm64_mov_imm16(cb, 1, 0)
        cb = codebuf_emit_u32(cb, 0xF2B00001) # MOVK X1, #0x8000, LSL #16 (2GB)
        cb = arm64_mov_imm16(cb, 2, 3)         # PROT_READ | PROT_WRITE
        cb = arm64_mov_imm16(cb, 3, 34)        # MAP_PRIVATE | MAP_ANONYMOUS (0x22)
        cb = codebuf_emit_u32(cb, 0x92800004) # MOVN X4, #0 (-1 fd)
        cb = arm64_mov_imm16(cb, 5, 0)
        cb = arm64_mov_imm16(cb, 8, 222)       # X8 = 222 (SYS_mmap)
        cb = arm64_svc(cb, 0)                  # SVC #0
    else
        # ── macOS Mach-O Entry: dyld passes X0 = argc, X1 = argv ──
        cb = arm64_mov_rr(cb, 19, 0)     # X19 = argc
        cb = arm64_mov_rr(cb, 20, 1)     # X20 = argv

        cb = arm64_stp_pre(cb, 29, 30, 31, 0 - 16)
        cb = arm64_mov_from_sp(cb, 29)

        # ── Initialize 2GB Global Arena Heap via macOS mmap ──
        cb = arm64_mov_imm16(cb, 0, 0)
        cb = arm64_mov_imm16(cb, 1, 0)
        cb = codebuf_emit_u32(cb, 0xF2B00001) # MOVK X1, #0x8000, LSL #16 (2GB)
        cb = arm64_mov_imm16(cb, 2, 3)         # PROT_READ | PROT_WRITE
        cb = arm64_mov_imm16(cb, 3, 4098)      # MAP_ANON | MAP_PRIVATE (0x1002)
        cb = codebuf_emit_u32(cb, 0x92800004) # MOVN X4, #0 (-1 fd)
        cb = arm64_mov_imm16(cb, 5, 0)
        cb = arm64_mov_imm16(cb, 16, 197)     # SYS_mmap
        cb = codebuf_emit_u32(cb, 0xF2A04010) # MOVK X16, #0x200, LSL #16
        cb = arm64_svc(cb, 0x80)
    end

    # X28 = heap base returned in X0
    cb = arm64_mov_rr(cb, 28, 0)
    # Reserve 32 KiB at the arena base for argc/argv and module globals.
    # Global slots start at X28+32 and are addressed directly by intrinsics.
    cb = arm64_mov_imm16(cb, 10, 32768)
    cb = arm64_add_rrr(cb, 1, 28, 10)
    cb = arm64_str_uoff(cb, 1, 28, 0)
    # Save argc and argv in heap header:
    cb = arm64_str_uoff(cb, 19, 28, 8)     # *(X28 + 8) = argc
    cb = arm64_str_uoff(cb, 20, 28, 16)    # *(X28 + 16) = argv
    if n_funcs > 0 do
        init_name = fat_str_new("__vir_global_init")
        init_idx = lir_find_func_index(lir_funcs, init_name)
        if init_idx >= 0 do
            init_at = codebuf_offset(cb) as i64
            cb = arm64_bl_imm26(cb, 0)
            cb = patch_bl_site(cb, init_at, vec_get_rt(func_offs, init_idx))
        end
        main_name = fat_str_new("main")
        main_idx = lir_find_func_index(lir_funcs, main_name)
        if main_idx < 0 do
            fallback_main_name = fat_str_new("__main__")
            main_idx = lir_find_func_index(lir_funcs, fallback_main_name)
        end
        if main_idx < 0 do
            main_idx = n_funcs - 1
        end
        at = codebuf_offset(cb) as i64
        cb = arm64_bl_imm26(cb, 0)
        main_off = vec_get_rt(func_offs, main_idx)
        cb = patch_bl_site(cb, at, main_off)
    end
    # Preserve main's result in X0 so the process exit status reflects the
    # program result.  Only synthesize success when there is no entry function.
    if n_funcs <= 0 do
        cb = arm64_mov_imm16(cb, 0, 0)
    end
    if is_linux == 1 do
        cb = arm64_mov_imm16(cb, 8, 93)        # X8 = 93 (SYS_exit on Linux)
        cb = arm64_svc(cb, 0)
    else
        cb = arm64_mov_imm16(cb, 16, 1)        # SYS_exit on macOS
        cb = codebuf_emit_u32(cb, 0xF2A04010)
        cb = arm64_svc(cb, 0x80)
    end
    cb = arm64_ldp_post(cb, 29, 30, 31, 16)
    cb = arm64_ret(cb)

    # ARM64 foreign thunk: adrp x16, GOT@PAGE; ldr x16,[x16,GOT@PAGEOFF]; br x16.
    # macho_emit patches ADRP/LDR once its final __DATA address is known.
    ffi_arm64_stubs_reset()
    let n_ffi = ffi_import_used_count()
    var ffi_i = 0
    when ffi_i < n_ffi loop
        ffi_id = ffi_import_used_at(ffi_i)
        ffi_arm64_stub_add(ffi_id as int, codebuf_offset(cb) as int)
        cb = codebuf_emit_u32(cb, 0x90000010)
        cb = codebuf_emit_u32(cb, 0xF9400210)
        cb = codebuf_emit_u32(cb, 0xD61F0200)
        ffi_i = ffi_i + 1
    end

    if is_linux == 0 and ffi_import_used_count() > 0 do
        va_base = 0x100000800
    end

    let call_fixups = native_read_i64(call_fixups_box, 0)
    let nf = vec_len_rt(call_fixups)
    var ci = 0
    var dest = 0 - 1
    when ci < nf loop
        let fx = vec_get_rt(call_fixups, ci)
        let f_tkind = native_read_i64(fx as i64, 8)
        let f_tid = native_read_i64(fx as i64, 16)
        let f_at = native_read_i64(fx as i64, 0)
        if f_tkind == 2 do
            if f_tid >= 0 and f_tid < n_funcs do
                let dest_adr = vec_get_rt(func_offs, f_tid)
                let f_rd = native_read_i64(fx as i64, 24)

                va_pc = va_base + f_at
                va_dest = va_base + dest_adr

                pc_page = va_pc and (0 - 4096)
                target_page = va_dest and (0 - 4096)
                page_delta = target_page - pc_page
                page_imm = ((page_delta - (page_delta mod 4096)) / 4096) and 0x1FFFFF
                immlo = page_imm and 3
                immhi = (page_imm shr 2) and 0x7FFFF
                adrp_word = 0x90000000 or (immlo shl 29) or (immhi shl 5) or (f_rd and 0x1F)
                cb = codebuf_patch_u32(cb, f_at as int, adrp_word as int)

                lo12 = va_dest and 0xFFF
                add_word = 0x91000000 or ((lo12 as int) shl 10) or ((f_rd as int and 0x1F) shl 5) or (f_rd as int and 0x1F)
                cb = codebuf_patch_u32(cb, (f_at + 4) as int, add_word as int)
            end
        else
            dest = 0 - 1
            if f_tkind == 0 do
                if f_tid >= 0 and f_tid < n_funcs do
                    dest = vec_get_rt(func_offs, f_tid)
                end
            eif f_tkind == 3 do
                dest = ffi_arm64_stub_offset(f_tid as int)
            else
                if f_tid >= 0 and f_tid < LIR_RT_STUB_COUNT do
                    dest = vec_get_rt(rt_offs, f_tid)
                end
            end
            if dest < 0 do
                dest = vec_get_rt(rt_offs, LIR_RT_UNRESOLVED)
            end
            cb = patch_bl_site(cb, f_at, dest)
        end
        ci = ci + 1
    end

    # ── String Literal Pool & Patch ADR Sites ──
    let str_fixups = native_read_i64(str_fixups_box, 0)
    n_sfx = vec_len_rt(str_fixups)
    if n_sfx > 0 do
        pool_offsets = vec_new_cap_rt(n_sfx)
        str_pool_buckets = vec_new_cap_rt(256)
        var sbi = 0
        when sbi < 256 loop
            str_pool_buckets = vec_push_rt(str_pool_buckets, 0)
            sbi = sbi + 1
        end
        var sfi = 0
        when sfi < n_sfx loop
            sfx = vec_get_rt(str_fixups, sfi)
            s_val = native_read_i64(sfx as i64, 8) as string
            s_data = native_read_i64(s_val as i64, 0)
            s_len = native_read_i64(s_val as i64, 8)
            found_off = 0 - 1
            str_bid = arm64_func_name_hash(s_val)
            str_bucket = vec_get_rt(str_pool_buckets, str_bid)
            if str_bucket == 0 do str_bucket = vec_new_rt() end
            var pbi = 0
            when pbi < vec_len_rt(str_bucket) loop
                pfi = vec_get_rt(str_bucket, pbi)
                prev_sfx = vec_get_rt(str_fixups, pfi)
                prev_s_val = native_read_i64(prev_sfx as i64, 8) as string
                if fat_str_eq(prev_s_val, s_val) == 1 do
                    found_off = vec_get_rt(pool_offsets, pfi)
                    pbi = vec_len_rt(str_bucket)
                end
                pbi = pbi + 1
            end
            if found_off < 0 do
                found_off = codebuf_offset(cb) as i64
                var bi = 0
                when bi < s_len loop
                    b_ch = native_read_u8(s_data, bi)
                    cb = codebuf_emit_byte(cb, b_ch)
                    bi = bi + 1
                end
                cb = codebuf_emit_byte(cb, 0)
                str_bucket = vec_push_rt(str_bucket, sfi)
                vec_set_rt(str_pool_buckets, str_bid, str_bucket)
            end
            pool_offsets = vec_push_rt(pool_offsets, found_off)
            sfi = sfi + 1
        end

        pad = (4 - (codebuf_offset(cb) mod 4)) mod 4
        var pi = 0
        when pi < pad loop
            cb = codebuf_emit_byte(cb, 0)
            pi = pi + 1
        end

        sfi = 0
        when sfi < n_sfx loop
            sfx = vec_get_rt(str_fixups, sfi)
            s_at = native_read_i64(sfx as i64, 0)
            s_rd = native_read_i64(sfx as i64, 16)
            s_target = vec_get_rt(pool_offsets, sfi)

            va_pc = va_base + s_at
            va_target = va_base + s_target

            pc_page = va_pc and (0 - 4096)
            target_page = va_target and (0 - 4096)
            page_delta = target_page - pc_page
            page_imm = ((page_delta - (page_delta mod 4096)) / 4096) and 0x1FFFFF
            immlo = page_imm and 3
            immhi = (page_imm shr 2) and 0x7FFFF
            adrp_word = 0x90000000 or (immlo shl 29) or (immhi shl 5) or (s_rd as int and 0x1F)
            cb = codebuf_patch_u32(cb, s_at as int, adrp_word as int)

            lo12 = va_target and 0xFFF
            add_word = 0x91000000 or ((lo12 as int) shl 10) or ((s_rd as int and 0x1F) shl 5) or (s_rd as int and 0x1F)
            cb = codebuf_patch_u32(cb, (s_at + 4) as int, add_word as int)

            sfi = sfi + 1
        end
    end

    out cb
end.

# Single-func helper → module path.
func emit_lir_arm64(func_obj: LirFunc, assigned_phys: i64, assigned_stack: i64, is_linux: i64):
    funcs = vec_new_rt()
    funcs = vec_push_rt(funcs, func_obj)
    out emit_lir_module_arm64(funcs, is_linux)
end.

export emit_lir_arm64, emit_lir_module_arm64, emit_lir_arm64_into
export emit_lir_intrinsic, emit_lir_setarg, emit_lir_rt_stubs
export lir_intr_is_marker, lir_intr_is_identity, lir_intr_is_payload
export lir_fixup_new, lir_fixup_at_off, lir_fixup_target_block, lir_fixup_kind
export lir_call_fixup_new, lir_stub_for_builtin_id
export patch_bl_site, lir_find_func_index

# @vir_source stdlib/vir/compiler/virc.vri 78
import emit_lir_module_arm64, lir_find_func_index from vir.compiler.lir_codegen
# @vir_source stdlib/vir/compiler/codegen_x86.vri 1
##
 * vir/compiler/codegen_x86.vri — x86_64 Binary Instruction Emitters
 * ==================================================================
 * Ported from core/src/codegen.c (hand-coded REX + opcode bytes).
 * Register IDs match codegen.h: RAX=0 .. R15=15.
 ##

import CodeBuf, codebuf_emit_byte, codebuf_emit_u32, codebuf_emit_u64, codebuf_emit_i32 from compiler.codegen

# ── Register constants (codegen.h) ──
const X86_RAX  = 0
const X86_RCX  = 1
const X86_RDX  = 2
const X86_RBX  = 3
const X86_RSP  = 4
const X86_RBP  = 5
const X86_RSI  = 6
const X86_RDI  = 7
const X86_R8   = 8
const X86_R9   = 9
const X86_R10  = 10
const X86_R11  = 11
const X86_R12  = 12
const X86_R13  = 13
const X86_R14  = 14
const X86_R15  = 15

# SysV AMD64 argument registers (SetArg order): RDI, RSI, RDX, RCX, R8, R9

func x86_arg_reg(idx: int):
    if idx == 0 do out X86_RDI end
    if idx == 1 do out X86_RSI end
    if idx == 2 do out X86_RDX end
    if idx == 3 do out X86_RCX end
    if idx == 4 do out X86_R8 end
    if idx == 5 do out X86_R9 end
    out X86_RAX
end.

func x86_rex_w(r: int, rm: int):
    var rex = 0x48
    if r >= X86_R8 do
        rex = rex or 0x04
    end
    if rm >= X86_R8 do
        rex = rex or 0x01
    end
    out rex
end.

func x86_rex(r: int, rm: int):
    var rex = 0x40
    if r >= X86_R8 do
        rex = rex or 0x04
    end
    if rm >= X86_R8 do
        rex = rex or 0x01
    end
    out rex
end.

func x86_modrm(mod_bits: int, reg: int, rm: int):
    v = (mod_bits shl 6) or ((reg and 7) shl 3)
    out v or (rm and 7)
end.

func x86_emit_add_rr(cb: CodeBuf, dst: int, src: int):
    cb = codebuf_emit_byte(cb, x86_rex_w(src, dst))
    cb = codebuf_emit_byte(cb, 0x01)
    out codebuf_emit_byte(cb, x86_modrm(3, src, dst))
end.

func x86_emit_sub_rr(cb: CodeBuf, dst: int, src: int):
    cb = codebuf_emit_byte(cb, x86_rex_w(src, dst))
    cb = codebuf_emit_byte(cb, 0x29)
    out codebuf_emit_byte(cb, x86_modrm(3, src, dst))
end.

func x86_emit_imul_rr(cb: CodeBuf, dst: int, src: int):
    cb = codebuf_emit_byte(cb, x86_rex_w(dst, src))
    cb = codebuf_emit_byte(cb, 0x0F)
    cb = codebuf_emit_byte(cb, 0xAF)
    out codebuf_emit_byte(cb, x86_modrm(3, dst, src))
end.

func x86_emit_mov_rr(cb: CodeBuf, dst: int, src: int):
    cb = codebuf_emit_byte(cb, x86_rex_w(src, dst))
    cb = codebuf_emit_byte(cb, 0x89)
    out codebuf_emit_byte(cb, x86_modrm(3, src, dst))
end.

func x86_emit_mov_reg_imm64(cb: CodeBuf, dst: int, imm: int):
    var rex = 0x48
    if dst >= X86_R8 do
        rex = rex or 0x01
    end
    cb = codebuf_emit_byte(cb, rex)
    cb = codebuf_emit_byte(cb, 0xB8 + (dst and 7))
    out codebuf_emit_u64(cb, imm)
end.

func x86_emit_mov_reg_imm32(cb: CodeBuf, dst: int, imm: int):
    var rex = 0x48
    if dst >= X86_R8 do
        rex = rex or 0x01
    end
    cb = codebuf_emit_byte(cb, rex)
    cb = codebuf_emit_byte(cb, 0xC7)
    cb = codebuf_emit_byte(cb, x86_modrm(3, 0, dst))
    out codebuf_emit_i32(cb, imm)
end.

func x86_emit_push(cb: CodeBuf, reg: int):
    if reg >= X86_R8 do
        cb = codebuf_emit_byte(cb, 0x41)
    end
    out codebuf_emit_byte(cb, 0x50 + (reg and 7))
end.

func x86_emit_pop(cb: CodeBuf, reg: int):
    if reg >= X86_R8 do
        cb = codebuf_emit_byte(cb, 0x41)
    end
    out codebuf_emit_byte(cb, 0x58 + (reg and 7))
end.

func x86_emit_ret(cb: CodeBuf):
    out codebuf_emit_byte(cb, 0xC3)
end.

func x86_emit_nop(cb: CodeBuf):
    out codebuf_emit_byte(cb, 0x90)
end.

func x86_emit_jmp_rel32(cb: CodeBuf, offset: int):
    cb = codebuf_emit_byte(cb, 0xE9)
    out codebuf_emit_i32(cb, offset)
end.

func x86_emit_call_rel32(cb: CodeBuf, offset: int):
    cb = codebuf_emit_byte(cb, 0xE8)
    out codebuf_emit_i32(cb, offset)
end.

func x86_emit_cmp_rr(cb: CodeBuf, a: int, b: int):
    cb = codebuf_emit_byte(cb, x86_rex_w(b, a))
    cb = codebuf_emit_byte(cb, 0x39)
    out codebuf_emit_byte(cb, x86_modrm(3, b, a))
end.

func x86_emit_sete(cb: CodeBuf, dst: int):
    var rex = 0x40
    if dst >= X86_R8 do
        rex = 0x41
    end
    cb = codebuf_emit_byte(cb, rex)
    cb = codebuf_emit_byte(cb, 0x0F)
    cb = codebuf_emit_byte(cb, 0x94)
    out codebuf_emit_byte(cb, x86_modrm(3, 0, dst))
end.

func x86_emit_setne(cb: CodeBuf, dst: int):
    var rex = 0x40
    if dst >= X86_R8 do
        rex = 0x41
    end
    cb = codebuf_emit_byte(cb, rex)
    cb = codebuf_emit_byte(cb, 0x0F)
    cb = codebuf_emit_byte(cb, 0x95)
    out codebuf_emit_byte(cb, x86_modrm(3, 0, dst))
end.

func x86_emit_setg(cb: CodeBuf, dst: int):
    var rex = 0x40
    if dst >= X86_R8 do
        rex = 0x41
    end
    cb = codebuf_emit_byte(cb, rex)
    cb = codebuf_emit_byte(cb, 0x0F)
    cb = codebuf_emit_byte(cb, 0x9F)
    out codebuf_emit_byte(cb, x86_modrm(3, 0, dst))
end.

func x86_emit_setl(cb: CodeBuf, dst: int):
