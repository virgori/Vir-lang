# Vir AI Spec — basics
# Compile/run with native Vir toolchain when available.

func greet(name: string):
    print("Hello, $name")
end.

func add(a: int, b: int) -> int:
    out a + b
end.

func main:
    var name = "Vir"
    greet(name)

    var sum = add(2, 3)
    print("2 + 3 = $sum")

    if sum > 4 do
        print("sum is large")
    eif sum == 4 do
        print("sum is four")
    else
        print("sum is small")
    end

    out 0
end.
