{
  "comments": {
    "lineComment": "//",
    "blockComment": [
      "/*",
      "*/"
    ]
  },
  "brackets": [
    [
      "{",
      "}"
    ],
    [
      "[",
      "]"
    ],
    [
      "(",
      ")"
    ],
    [
      "<",
      ">"
    ]
  ],
  "autoClosingPairs": [
    {
      "open": "{",
      "close": "}"
    },
    {
      "open": "[",
      "close": "]"
    },
    {
      "open": "(",
      "close": ")"
    },
    {
      "open": "\"",
      "close": "\""
    },
    {
      "open": "<",
      "close": ">"
    }
  ],
  "surroundingPairs": [
    [
      "{",
      "}"
    ],
    [
      "[",
      "]"
    ],
    [
      "(",
      ")"
    ],
    [
      "\"",
      "\""
    ],
    [
      "<",
      ">"
    ]
  ],
  "wordPattern": "(-?\\d*\\.\\d\\w*)|([^`~!@#$%^&*()=+[\\]{}\\\\|;:'\",.<>/?\\s]+)",
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(?:entity|func)\\b.*$|^\\s*(?:if|elif|else|for|while)\\b.*(?:\\bthen\\b)?\\s*$|^.*\\{[^}]*$",
    "decreaseIndentPattern": "^\\s*(?:end\\b|[}]).*$"
  },
  "onEnterRules": [
    {
      "beforeText": "^\\s*(?:entity|func)\\b.*$",
      "action": {
        "indent": "indent"
      }
    },
    {
      "beforeText": "^\\s*(?:if|elif|else|for|while)\\b.*(?:\\bthen\\b)?\\s*$",
      "action": {
        "indent": "indent"
      }
    },
    {
      "beforeText": "^\\s*end\\b.*$",
      "action": {
        "indent": "outdent"
      }
    }
  ]
}
