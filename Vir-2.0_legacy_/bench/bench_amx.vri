##
 * bench_amx.vri — AMX/Accelerate DGEMM benchmark via Vir FFI
 * ============================================================
 * Calls cblas_dgemm through libvir_amx_bench.dylib to measure
 * Apple AMX coprocessor GFLOP/s directly from Vir.
 *
 * Build the shared lib first:
 *   cc -O2 -shared -fPIC -framework Accelerate \
 *      -o lib/libvir_amx_bench.dylib benchmarks/bench_amx_dgemm.c
 *
 * Then: ./core/build/vir run benchmarks/bench_amx.vri
 ##

# FFI declarations — link to libvir_amx_bench.dylib
extern func vir_amx_bench_dgemm:
    in(n:int; iters:int)
    out int
end

extern func vir_amx_bench_sgemm:
    in(n:int; iters:int)
    out int
end

# Main benchmark
print "=== Vir AMX Benchmark (via FFI to Apple Accelerate) ==="
print ""

print "--- DGEMM f64 ---"
d256  = vir_amx_bench_dgemm(256, 20)
d512  = vir_amx_bench_dgemm(512, 10)
d1024 = vir_amx_bench_dgemm(1024, 5)
d2048 = vir_amx_bench_dgemm(2048, 3)

print ""
print "--- SGEMM f32 ---"
s256  = vir_amx_bench_sgemm(256, 20)
s512  = vir_amx_bench_sgemm(512, 10)
s1024 = vir_amx_bench_sgemm(1024, 5)
s2048 = vir_amx_bench_sgemm(2048, 3)

print ""
print "Target: ~300 GFLOP/s (f64), ~600 GFLOP/s (f32) on M-series"
