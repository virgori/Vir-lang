func run_kahan_dot(n):
    let sz = n * 8
    let a = alloc(sz)
    let b = alloc(sz)

    var i = 0
    when i < n loop
        let off = i * 8
        write_word(a, off, (i mod 100) + 1)
        write_word(b, off, (i mod 50) + 1)
        i = i + 1
    end

    var sum = 0
    var comp = 0
    var j = 0
    when j < n loop
        let off2 = j * 8
        let term = read_word(a, off2) * read_word(b, off2)
        let y = term - comp
        let t = sum + y
        comp = (t - sum) - y
        sum = t
        j = j + 1
    end

    out sum
end.

func main:
    var iter = 0
    var res = 0
    when iter < 5 loop
        res = run_kahan_dot(1000000)
        iter = iter + 1
    end
    print_str("Kahan Dot Sum: ")
    print(res)
end.
