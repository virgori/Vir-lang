func main() -> int:
    # 1. Rank-1 tensor test
    var t1: tensor<int>[4]
    t1[0] = 10
    t1[1] = 20
    t1[2] = 30
    t1[3] = 40
    if t1[0] != 10 do out 1 end
    if t1[1] != 20 do out 2 end
    if t1[2] != 30 do out 3 end
    if t1[3] != 40 do out 4 end

    # Dynamic index expression for rank-1
    var idx1 = 1
    if t1[idx1 + 1] != 30 do out 5 end

    # 2. Rank-2 tensor test
    var t2: tensor<int>[2, 3]
    var r = 0
    when r < 2 loop
        var c = 0
        when c < 3 loop
            t2[r, c] = (r + 1) * 10 + (c + 1)
            c = c + 1
        end
        r = r + 1
    end

    if t2[0, 0] != 11 do out 11 end
    if t2[0, 1] != 12 do out 12 end
    if t2[0, 2] != 13 do out 13 end
    if t2[1, 0] != 21 do out 21 end
    if t2[1, 1] != 22 do out 22 end
    if t2[1, 2] != 23 do out 23 end

    # Dynamic index expression: t2[row + 1, col]
    var row = 0
    var col = 1
    if t2[row + 1, col] != 22 do out 24 end

    # 3. Rank-3 tensor test
    var t3: tensor<int>[2, 2, 2]
    t3[0, 0, 0] = 100
    t3[0, 0, 1] = 101
    t3[0, 1, 0] = 110
    t3[0, 1, 1] = 111
    t3[1, 0, 0] = 200
    t3[1, 0, 1] = 201
    t3[1, 1, 0] = 210
    t3[1, 1, 1] = 211

    if t3[0, 0, 0] != 100 do out 31 end
    if t3[0, 0, 1] != 101 do out 32 end
    if t3[0, 1, 0] != 110 do out 33 end
    if t3[0, 1, 1] != 111 do out 34 end
    if t3[1, 0, 0] != 200 do out 35 end
    if t3[1, 0, 1] != 201 do out 36 end
    if t3[1, 1, 0] != 210 do out 37 end
    if t3[1, 1, 1] != 211 do out 38 end

    # Dynamic index for rank-3: t3[row, col + 1, 0]
    if t3[0, 0 + 1, 0] != 110 do out 39 end

    # 4. End-to-end 2x2 MatMul with runtime assertion
    var ma: tensor<i32>[2, 2] = [1, 2, 3, 4]
    var mb: tensor<i32>[2, 2] = [5, 6, 7, 8]
    var mc = ma ** mb

    if mc[0, 0] != 19 do out 41 end
    if mc[0, 1] != 22 do out 42 end
    if mc[1, 0] != 43 do out 43 end
    if mc[1, 1] != 50 do out 44 end

    print "PASS: tensor v2.0 suite verified"
    out 0
end.
