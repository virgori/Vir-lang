entity Point:
    x
    y
end.
entity Rect:
    width
    height
    area
end.
func area:
    in(w, h)
    out w * h
end.
func main:
    var p = Point(x: 3, y: 7)
    print p.x
    print p.y

    var r = Rect(width: 10, height: 5, area: 0)
    r.area = area(r.width, r.height)
    print r.width
    print r.height
    print r.area

    p.x = p.x + p.y
    print p.x
end.
