# EXPECT_START
# Pattern: | @0!4 $- @0!2 $- @0!2 |
# MATCH: 2026-05-16
# MATCH: 1990-01-01
# NO: 26-05-16
# NO: 2026/05/16
# NO: 2026-5-16
# EXPECT_END
##
# virgex_date.vri -- Genuine VPS date pattern test calling virgex.virgex
##

include virgex.virgex

func main:
    let pattern = "| @0!4 $- @0!2 $- @0!2 |"
    print "Pattern: $pattern"

    var dates = [
        "2026-05-16",
        "1990-01-01",
        "26-05-16",
        "2026/05/16",
        "2026-5-16"
    ]

    var i = 0
    let count = len(dates)
    when i < count loop
        let d = dates[i]
        if virgex_fullmatch(pattern, d) do
            print "MATCH: $d"
        else
            print "NO: $d"
        end
        i = i + 1
    end
end.
