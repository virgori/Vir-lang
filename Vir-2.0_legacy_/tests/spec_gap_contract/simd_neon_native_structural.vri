func main:
    var a: flux<int, 4> = flux(10, 20, 30, 40)
    var b: flux<int, 4> = flux(1, 2, 3, 4)
    var c = a + b
    print c[0]
    print c[1]
    print c[2]
    print c[3]

    var s: flux<int, 2> = flux_splat(2, 2)
    var p: flux<int, 2> = flux(11, 22)
    var m = p * s
    print m[0]
    print m[1]

    var fa: flux<float, 2> = flux(1.5, 3.0)
    var fb: flux<float, 2> = flux(2.0, 4.0)
    var fc = fa + fb
    print fc[0]
    print fc[1]
    out 0
end.
