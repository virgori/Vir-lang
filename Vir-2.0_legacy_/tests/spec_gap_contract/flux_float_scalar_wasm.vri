# CONTRACT: SIMD-013
# Verifies flux<f32,4> * scalar_float compiles to valid Wasm and executes
# without trapping. Result lanes are read via swizzle into memory writes
# to confirm the computation ran. (Float print is not available on Wasm;
# exit=0 is the observable contract oracle here.)
func main:
    let a: flux<f32, 4> = flux(1.0, 2.0, 3.0, 4.0)
    let b = a * 2.0
    # Ensure each lane is consumed so the optimizer cannot elide the ops
    let _ = b~x
    let _ = b~y
    let _ = b~z
    let _ = b~w
    out 0
end.
