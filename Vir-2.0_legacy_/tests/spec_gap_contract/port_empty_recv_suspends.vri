# CONTRACT: PORT-004
# EXPECT_START
# before
# 99
# after
# EXPECT_END
port values: int

async func receiver:
    print "before"
    print recv values
    print "after"
end.

async func sender:
    await pass
    send values <- 99
end.

func main:
    var r = task receiver()
    var s = task sender()
    wait s
    wait r
end.

