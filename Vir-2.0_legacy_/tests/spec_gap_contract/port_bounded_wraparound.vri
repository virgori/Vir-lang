# CONTRACT: PORT-003
# EXPECT_START
# 1
# 2
# 3
# 4
# 5
# EXPECT_END
port(cap: 2) values: int

async func producer:
    send values <- 1
    send values <- 2
    send values <- 3
    send values <- 4
    send values <- 5
end.

async func consumer:
    print recv values
    print recv values
    print recv values
    print recv values
    print recv values
end.

func main:
    var p = task producer()
    var c = task consumer()
    wait p
    wait c
end.

