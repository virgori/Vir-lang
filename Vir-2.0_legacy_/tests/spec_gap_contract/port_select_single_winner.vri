# CONTRACT: PORT-006
# EXPECT: 20
port first: int
port second: int

async func producer:
    send second <- 20
    await pass
    send first <- 10
end.

async func receiver:
    select:
        on recv(first) as value:
            print value
        end
        on recv(second) as value:
            print value
        end
    end
end.

func main:
    var r = task receiver()
    var p = task producer()
    wait p
    wait r
end.

