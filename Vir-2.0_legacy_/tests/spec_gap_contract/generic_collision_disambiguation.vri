entity A_C_:
    v: int
end.

entity B:
    v: int
end.

entity A:
    v: int
end.

entity _C_B:
    v: int
end.

func check_two<X, Y>(x: X, y: Y) -> int:
    out x.v + y.v
end.

func main:
    var e1 = A_C_(v: 10)
    var e2 = B(v: 20)
    var e3 = A(v: 100)
    var e4 = _C_B(v: 200)

    r1 = check_two<A_C_, B>(e1, e2)
    r2 = check_two<A, _C_B>(e3, e4)
    print r1
    print r2
end.
