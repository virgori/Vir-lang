# VIRC_FLAGS: -O2
func main:
    let a = [10, 20, 30, 40, 50]
    let b = [1, 2, 3, 4, 5]
    var dst = [0, 0, 0, 0, 0]
    var i = 0
    when i < 5 loop
        dst[i] = a[i] + b[i]
        i = i + 1
    end
    print dst[0]
    print dst[1]
    print dst[2]
    print dst[3]
    print dst[4]
    out 0
end.
