precomp func fact(n: int) -> int:
    if n <= 1 do out 1 end
    out n * fact(n - 1)
end.

precomp func fib(n: int) -> int:
    if n <= 1 do out n end
    out fib(n - 1) + fib(n - 2)
end.

const BASE = precomp fact(0)
const FACT_5 = precomp fact(5)
const FIB_10 = precomp fib(10)

func main:
    print BASE
    print FACT_5
    print FIB_10
end.

