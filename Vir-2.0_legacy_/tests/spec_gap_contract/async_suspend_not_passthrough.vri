# CONTRACT: ASYNC-001
# The harness must link the official deterministic serial executor provider.
# EXPECT: 7
var witness: int = 0

async func suspended_probe() -> int:
    await pass
    if witness != 1 do
        out 71
    end
    out 7
end.

func main:
    var pending = task suspended_probe()
    witness = 1
    print wait pending
end.

