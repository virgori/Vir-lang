module test_val
include alloc; import vir_alloc from alloc
include io; import print_ln from io

func main:
    let val = 51
    let b = val
    let buf = vir_alloc(10)
    extern func native_write_u8(addr: int, offset: int, val: int)
    native_write_u8(buf, 0, b)
    native_write_u8(buf, 1, 0)
    print_ln(buf)
    out 0
end
