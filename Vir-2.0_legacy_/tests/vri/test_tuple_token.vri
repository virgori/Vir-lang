enum TokType:
    Ident = 1
end.

entity Token:
    tok_type:   TokType
    line:       int
    col:        int
    str_val:    string
    int_val:    int
    float_val:  float
end.

func expect_tok():
    var t = Token(tok_type: TokType.Ident, line: 1, col: 2, str_val: "hello_token", int_val: 0, float_val: 0.0)
    out (99, t, true)
end.

func main:
    var (p2, name_tok, ok) = expect_tok()
    
    print p2
    print name_tok.str_val
    print ok as int
    out 0
end.
