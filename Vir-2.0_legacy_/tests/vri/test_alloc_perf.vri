module test_alloc_perf

include alloc; import vir_alloc, vir_free, vir_realloc from alloc
include io; import print_ln from io

func main:
    print_ln("Starting memory allocator stress test...")
    
    let p1 = vir_alloc(32)
    let p2 = vir_alloc(64)
    let p3 = vir_alloc(128)
    let p4 = vir_alloc(256)
    
    extern func native_write_u8(addr: int, offset: int, val: int)
    
    native_write_u8(p1, 0, 65)
    native_write_u8(p1, 1, 0)
    print_ln(p1)
    
    native_write_u8(p2, 0, 66)
    native_write_u8(p2, 1, 0)
    print_ln(p2)
    
    let p1_shrink = vir_realloc(p1, 16)
    print_ln(p1_shrink)
    
    vir_free(p1_shrink)
    vir_free(p2)
    vir_free(p3)
    vir_free(p4)
    
    let p5 = vir_alloc(512)
    native_write_u8(p5, 0, 67)
    native_write_u8(p5, 1, 0)
    print_ln(p5)
    vir_free(p5)
    
    print_ln("Memory allocator test PASSED!")
    out 0
end
