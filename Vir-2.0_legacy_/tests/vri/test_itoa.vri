module test_itoa
include string_rt; import rt_itoa from string_rt
include io; import print_int, print_ln from io

func main:
    let s = rt_itoa(51)
    extern func native_read_u8(addr: int, offset: int) -> int
    let b0 = native_read_u8(s, 0)
    let b1 = native_read_u8(s, 1)
    let b2 = native_read_u8(s, 2)
    
    # We can't use print_int safely since it uses rt_itoa!
    # But let's just print the raw string!
    print_ln(s)
    out 0
end
