include rt.io
include rt.vec_rt
include rt.string_rt

import print_ln from rt.string_rt
import bvec_new, bvec_push_u32_le, bvec_len from rt.vec_rt

entity TestEntity:
    buf: int
end

func mutate_entity:
    in(b: TestEntity)
    let buf = b.buf
    buf = bvec_push_u32_le(buf, 0x12345678)
    b.buf = buf
    out b
end

func main:
    let b = TestEntity(buf: bvec_new())
    b = mutate_entity(b)
    let len = bvec_len(b.buf)
    if len == 4 do
        print_ln("MUTATION WORKED!")
    else
        print_ln("MUTATION FAILED!")
    end
end
