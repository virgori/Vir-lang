# EXPECT:
# deploy_service
# 200
# us-east-1 production
# 1
# Regression Test: Struct layout string before int alignment
# Protection: Bug 3 in COMPILER_BUGS_AND_LIMITATIONS.md
# Expected behavior: Declaring string fields before primitive int fields
#   must calculate field offsets accurately without adjacent metadata corruption.

entity TaskItem:
    title: string
    code: int
    detail: string
    priority: int
end.

func main:
    var t: TaskItem = TaskItem(title: "deploy_service", code: 200, detail: "us-east-1 production", priority: 1)
    print_str(t.title)
    print t.code
    print_str(t.detail)
    print t.priority
    out 0
end.

