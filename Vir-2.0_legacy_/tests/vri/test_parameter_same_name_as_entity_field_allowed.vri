# EXPECT:
# 42
# 99
# 100
# 200
# Regression Test: Parameter shadowing entity field names is permitted
# Protection: Section 3 (Keyword Collision vs Symbol Shadowing) in COMPILER_BUGS_AND_LIMITATIONS.md
# Expected behavior: Normal identifiers matching entity field names (e.g. 'value', 'status')
#   are fully valid function parameters without symbol collisions.

entity Container:
    value: int
    status: int
end.

func identity_val(value: int) -> int:
    out value
end.

func identity_status(status: int) -> int:
    out status
end.

func main:
    let c = Container(value: 100, status: 200)
    print identity_val(42)
    print identity_status(99)
    print c.value
    print c.status
    out 0
end.

