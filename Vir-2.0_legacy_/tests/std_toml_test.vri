include vir.data.toml

extern func native_read_u8(addr: int, offset: int) -> int

func test_str_eq(a: string, b: string) -> bool:
    let pa = a as int
    let pb = b as int
    if pa == pb do out true end
    if pa == 0 or pb == 0 do out false end
    var i = 0
    loop
        let ca = native_read_u8(pa, i)
        let cb = native_read_u8(pb, i)
        if ca != cb do out false end
        if ca == 0 do out true end
        i = i + 1
    end
    out true
end.

func main:
    # 1. Primitives at root
    let toml_src = "title = \"Vir Language\"\nversion = 2\nenabled = true\ndebug = false\n"
    let r1 = toml_parse(toml_src)
    case r1
        Ok(tbl):
            let opt_t = toml_table_get(tbl, "title")
            case opt_t
                Some(t_val):
                    if toml_get_tag(t_val) == TomlType.Str and test_str_eq(toml_get_str(t_val), "Vir Language") do
                        let opt_v = toml_table_get(tbl, "version")
                        case opt_v
                            Some(v_val):
                                if toml_get_tag(v_val) == TomlType.Integer and toml_get_int(v_val) == 2 do
                                    let opt_e = toml_table_get(tbl, "enabled")
                                    case opt_e
                                        Some(e_val):
                                            if toml_get_tag(e_val) == TomlType.Bool and toml_get_int(e_val) == 1 do
                                                let opt_d = toml_table_get(tbl, "debug")
                                                case opt_d
                                                    Some(d_val):
                                                        if toml_get_tag(d_val) == TomlType.Bool and toml_get_int(d_val) == 0 do
                                                            print 1
                                                        end
                                                    None: print 0
                                                end
                                            end
                                        None: print 0
                                    end
                                end
                            None: print 0
                        end
                    end
                None: print 0
            end
        Err(_): print 0
    end

    # 2. Comments ignored
    let toml_comm = "# Top comment\nname = \"Vir\" # inline comment\n"
    let r2 = toml_parse(toml_comm)
    case r2
        Ok(tbl):
            let opt_n = toml_table_get(tbl, "name")
            case opt_n
                Some(n_val):
                    if test_str_eq(toml_get_str(n_val), "Vir") do
                        print 2
                    end
                None: print 0
            end
        Err(_): print 0
    end

    # 3. Table header: [server]
    let toml_tbl = "[server]\nhost = \"127.0.0.1\"\nport = 8080\n"
    let r3 = toml_parse(toml_tbl)
    case r3
        Ok(tbl):
            let opt_srv = toml_table_get(tbl, "server")
            case opt_srv
                Some(srv):
                    if toml_get_tag(srv) == TomlType.Table do
                        let opt_host = toml_table_get(srv, "host")
                        let opt_port = toml_table_get(srv, "port")
                        var ok_3 = 0
                        case opt_host
                            Some(h):
                                if test_str_eq(toml_get_str(h), "127.0.0.1") do ok_3 = ok_3 + 1 end
                            None: ok_3 = 0
                        end
                        case opt_port
                            Some(p):
                                if toml_get_int(p) == 8080 do ok_3 = ok_3 + 1 end
                            None: ok_3 = 0
                        end
                        if ok_3 == 2 do print 3 end
                    end
                None: print 0
            end
        Err(_): print 0
    end

    # 4. Dotted key: database.max_conn = 100
    let toml_dot = "database.max_conn = 100\n"
    let r4 = toml_parse(toml_dot)
    case r4
        Ok(tbl):
            let opt_db = toml_table_get(tbl, "database")
            case opt_db
                Some(db):
                    let opt_mc = toml_table_get(db, "max_conn")
                    case opt_mc
                        Some(mc):
                            if toml_get_int(mc) == 100 do print 4 end
                        None: print 0
                    end
                None: print 0
            end
        Err(_): print 0
    end

    # 5. Nested tables: [app] and [app.db]
    let toml_nest = "[app]\nname = \"my_app\"\n\n[app.db]\nport = 5432\n"
    let r5 = toml_parse(toml_nest)
    case r5
        Ok(tbl):
            let opt_app = toml_table_get(tbl, "app")
            case opt_app
                Some(app):
                    let opt_db = toml_table_get(app, "db")
                    case opt_db
                        Some(db):
                            let opt_p = toml_table_get(db, "port")
                            case opt_p
                                Some(p):
                                    if toml_get_int(p) == 5432 do print 5 end
                                None: print 0
                            end
                        None: print 0
                    end
                None: print 0
            end
        Err(_): print 0
    end

    # 6. Negative integers
    let toml_neg = "delta = -42\n"
    let r6 = toml_parse(toml_neg)
    case r6
        Ok(tbl):
            let opt_d = toml_table_get(tbl, "delta")
            case opt_d
                Some(d):
                    if toml_get_int(d) == -42 do print 6 end
                None: print 0
            end
        Err(_): print 0
    end

    # 7. Strict error: missing value
    let r7 = toml_parse("key = \n")
    case r7
        Ok(_): print 0
        Err(_): print 7
    end

    # 8. Strict error: unclosed table header
    let r8 = toml_parse("[unclosed_table\n")
    case r8
        Ok(_): print 0
        Err(_): print 8
    end

    # 9. Round-trip serialization
    var root = toml_table()
    toml_table_set(root, "app", toml_str("Vir"))
    toml_table_set(root, "count", toml_int(10))

    var srv_tbl = toml_table()
    toml_table_set(srv_tbl, "port", toml_int(9000))
    toml_table_set(root, "server", srv_tbl)

    let serialized = toml_stringify(root)
    let r9 = toml_parse(serialized)
    case r9
        Ok(parsed):
            let opt_app = toml_table_get(parsed, "app")
            case opt_app
                Some(app):
                    if test_str_eq(toml_get_str(app), "Vir") do
                        let opt_srv = toml_table_get(parsed, "server")
                        case opt_srv
                            Some(srv):
                                let opt_port = toml_table_get(srv, "port")
                                case opt_port
                                    Some(p):
                                        if toml_get_int(p) == 9000 do print 9 end
                                    None: print 0
                                end
                            None: print 0
                        end
                    end
                None: print 0
            end
        Err(_): print 0
    end

    # 10. Dot-style ABI
    let r10 = toml.parse("title = \"DotStyle\"\ncount = 42\nflag = true\n")
    case r10
        Ok(raw10):
            var t10: TomlValue = raw10 as TomlValue
            let opt_title = t10.get("title")
            case opt_title
                Some(raw_title):
                    var title_v: TomlValue = raw_title as TomlValue
                    if title_v.isString() and test_str_eq(title_v.asString(), "DotStyle") do
                        let opt_cnt = t10.get("count")
                        case opt_cnt
                            Some(raw_cnt):
                                var cnt_v: TomlValue = raw_cnt as TomlValue
                                if cnt_v.isInt() and cnt_v.asInt() == 42 do
                                    let opt_flg = t10.get("flag")
                                    case opt_flg
                                        Some(raw_flg):
                                            var flg_v: TomlValue = raw_flg as TomlValue
                                            if flg_v.isBool() and flg_v.asBool() do
                                                var build_tbl = toml.table()
                                                build_tbl.set("custom", toml.strVal("works"))
                                                if build_tbl.count() == 1 and test_str_eq(build_tbl.key(0), "custom") do
                                                    if test_str_eq(build_tbl.val(0).asString(), "works") do
                                                        let out_str = build_tbl.stringify()
                                                        let r_rep = toml.parse(out_str)
                                                        case r_rep
                                                            Ok(raw_rep):
                                                                var rep_v: TomlValue = raw_rep as TomlValue
                                                                let opt_c = rep_v.get("custom")
                                                                case opt_c
                                                                    Some(raw_cv):
                                                                        var cv: TomlValue = raw_cv as TomlValue
                                                                        if test_str_eq(cv.asString(), "works") do
                                                                            print 10
                                                                        end
                                                                    None: print 0
                                                                end
                                                            Err(_): print 0
                                                        end
                                                    end
                                                end
                                            end
                                        None: print 0
                                    end
                                end
                            None: print 0
                        end
                    end
                None: print 0
            end
        Err(_): print 0
    end

    print 777
    out 0
end.
