# test_adv_031: Syscall write raw bytes to stdout
# Expected: HELLO

func main:
    var buf = alloc(16)
    write_byte(buf, 0, 72)     # H
    write_byte(buf, 1, 69)     # E
    write_byte(buf, 2, 76)     # L
    write_byte(buf, 3, 76)     # L
    write_byte(buf, 4, 79)     # O
    write_byte(buf, 5, 10)     # \n
    var ret = __syscall(0x2000004, 1, buf, 6)
end.
