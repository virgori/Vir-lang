# Suite 3: Arena Zero-Growth & High-Iteration Watermark Reset (50,000 Iterations = 500MB Allocations)
func main:
    var cycle = 0
    var total_verified = 0
    var p = 0
    var v1 = 0
    var v2 = 0
    
    # 50,000 iterations * 10KB = 500MB virtual allocations
    when cycle < 50000 loop
        arena:
            p = alloc(10240)
            write_word(p, 0, cycle + 100)
            write_word(p, 10232, cycle + 200)
            
            v1 = read_word(p, 0)
            v2 = read_word(p, 10232)
            
            if v1 == (cycle + 100) do
                if v2 == (cycle + 200) do
                    total_verified = total_verified + 1
                end
            end
        end
        cycle = cycle + 1
    end
    
    if total_verified != 50000 do
        print "ARENA VERIFICATION MISMATCH"
        out 1
    end
    
    print "PASS: stress_03_arena_growth (50,000 iterations / 500MB allocations)"
    out 0
end.
