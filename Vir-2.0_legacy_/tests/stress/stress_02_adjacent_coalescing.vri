# Suite 2: Adjacent-Block Coalescing & Memory Integrity
func main:
    # 1. Allocate 4 sequential blocks: [A: 256B] [B: 512B] [C: 512B] [D: 256B]
    let pA = alloc(256)
    let pB = alloc(512)
    let pC = alloc(512)
    let pD = alloc(256)
    
    if pA == 0 do print "ALLOCATION FAILED" out 1 end
    if pB == 0 do print "ALLOCATION FAILED" out 1 end
    if pC == 0 do print "ALLOCATION FAILED" out 1 end
    if pD == 0 do print "ALLOCATION FAILED" out 1 end
    
    # 2. Write unique marker patterns
    write_word(pA, 0, 0x11111111)
    write_word(pA, 248, 0x11111111)
    
    write_word(pB, 0, 0x22222222)
    write_word(pB, 504, 0x22222222)
    
    write_word(pC, 0, 0x33333333)
    write_word(pC, 504, 0x33333333)
    
    write_word(pD, 0, 0x44444444)
    write_word(pD, 248, 0x44444444)
    
    # 3. Verify non-overlap & boundary separation
    if read_word(pA, 0) != 0x11111111 do print "CORRUPTION IN BLOCK A" out 1 end
    if read_word(pA, 248) != 0x11111111 do print "CORRUPTION IN BLOCK A" out 1 end
    
    if read_word(pB, 0) != 0x22222222 do print "CORRUPTION IN BLOCK B" out 1 end
    if read_word(pB, 504) != 0x22222222 do print "CORRUPTION IN BLOCK B" out 1 end
    
    if read_word(pC, 0) != 0x33333333 do print "CORRUPTION IN BLOCK C" out 1 end
    if read_word(pC, 504) != 0x33333333 do print "CORRUPTION IN BLOCK C" out 1 end
    
    if read_word(pD, 0) != 0x44444444 do print "CORRUPTION IN BLOCK D" out 1 end
    if read_word(pD, 248) != 0x44444444 do print "CORRUPTION IN BLOCK D" out 1 end
    
    # 4. Allocate large combined block E (768 bytes)
    let pE = alloc(768)
    if pE == 0 do
        print "ALLOCATION E FAILED"
        out 1
    end
    
    write_word(pE, 0, 0x55555555)
    write_word(pE, 760, 0x55555555)
    
    if read_word(pE, 0) != 0x55555555 do print "CORRUPTION IN BLOCK E" out 1 end
    if read_word(pE, 760) != 0x55555555 do print "CORRUPTION IN BLOCK E" out 1 end
    
    print "PASS: stress_02_adjacent_coalescing"
    out 0
end.
