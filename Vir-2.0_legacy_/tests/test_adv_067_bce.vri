# test_adv_067: Array bounds check in loop
# Expected: 0, 1, 4, 9, 16, 25, 36, 49, 64, 81

func main:
    var arr = arr_new(16)
    var i = 0
    when i < 10 loop
        push(arr, i * i)
        i = i + 1
    end.

    # Access all elements — BCE should optimize this
    i = 0
    when i < len(arr) loop
        print arr[i]
        i = i + 1
    end.
end.
