# EXPECT_START
# 1920
# 1080
# 2073600
# 4147200
# 320
# 7680
# 60
# 3
# 10
# 20
# 30
# 6
# 3
# 99
# 88
# 77
# 300
# EXPECT_END

# Module-level grouped declarations (§5.3)
var
    g_w = 1920
    g_h = 1080

func test_nested_scope:
    if true do
        var
            inner_a = 100
            inner_b = 200
        print inner_a + inner_b
    end
end.

func main:
    # 1. Newline grouped var with inferred and explicit types
    print g_w
    print g_h

    # 2. Newline grouped let referencing previous members
    let
        area = g_w * g_h
        doubled = area * 2
    print area
    print doubled

    # 3. Newline grouped const
    const
        MIN_WIDTH = 320
        MAX_WIDTH = 7680
    print MIN_WIDTH
    print MAX_WIDTH

    # 4. Same-line semicolon grouped var
    var x = 10; y: int = 20; z = 30
    print x + y + z

    # 5. Same-line semicolon grouped let
    let first = 1; second = first + 1
    print first + second

    # 6. Trailing semicolon before newline
    var
        t1 = 10;
        t2 = 20;
        t3 = 30;
    print t1
    print t2
    print t3

    # 7. Member referencing previous member in group
    let
        m1 = 1
        m2 = m1 + 2
        m3 = m2 + 3
    print m3

    # 8. All bindings visible in scope after group
    var
        v1 = 1
        v2 = 2
    print v1 + v2

    # 9. Reassignment to grouped var members
    x = 99
    y = 88
    z = 77
    print x
    print y
    print z

    # 10. Nested control flow scope
    test_nested_scope()
end.
