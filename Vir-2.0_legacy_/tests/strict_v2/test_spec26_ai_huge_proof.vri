# EXPECT_START
# PASS: Stage 1 - Multi-D Tensor Mutation & Layout
# PASS: Stage 2 - 2D Rectangular MatMul 3x2x3 and 2x3x2
# PASS: Stage 3 - First-Class FMA Operator ><
# PASS: Stage 4 - Scoped Arena Block Zero-Leakage
# PASS: Stage 5 - Infer Block Zero-Tape Execution
# PASS: Stage 6 - Reverse-Mode Autodiff Gradients
# PASS: Stage 7 - Quantization Pipeline (INT8/INT4/Scale/Signed)
# OVERALL PASS: Spec 26 AI/ML End-to-End Mathematical Proof Complete
# EXPECT_END

##
 * test_spec26_ai_huge_proof.vri — Spec v2.0 §26 Exhaustive AI/ML Verification Suite
 *
 * This test strictly validates all core AI/ML requirements end-to-end:
 *   1. Multi-dimensional tensors with multi-index mutation & physical memory layout.
 *   2. First-class 2D Square and Rectangular MatMul (**) with verified mathematical output.
 *   3. First-class Tensor FMA operator (><).
 *   4. Scoped arena blocks (arena: ... end) with verified zero-heap-leakage rollback.
 *   5. Inference blocks (infer: ... end) with verified zero-tape autodiff overhead.
 *   6. Reverse-mode automatic differentiation (train: ... end + .backward()) with exact analytical gradients.
 *   7. Transparent quantization pipeline (quantize) for INT8, INT4 packing, scale calculation, and signed values.
 *
 * Zero mock numbers. Every operation executes compiled ARM64 machine instructions.
 ##

extern func alloc(sz: int) -> ptr
extern func native_read_i64(addr: int, offset: int) -> int
extern func native_read_u8(addr: int, offset: int) -> int

func test_stage1_tensor_mutation() -> int:
    var m: tensor<i32>[3, 3]
    m[0, 0] = 11
    m[0, 1] = 12
    m[0, 2] = 13
    m[1, 0] = 21
    m[1, 1] = 22
    m[1, 2] = 23
    m[2, 0] = 31
    m[2, 1] = 32
    m[2, 2] = 33

    m[0, 0] = 99
    m[1, 1] = 88
    m[2, 2] = 77

    if m[0, 0] != 99 do out 101 end
    if m[0, 1] != 12 do out 102 end
    if m[0, 2] != 13 do out 103 end
    if m[1, 0] != 21 do out 104 end
    if m[1, 1] != 88 do out 105 end
    if m[1, 2] != 23 do out 106 end
    if m[2, 0] != 31 do out 107 end
    if m[2, 1] != 32 do out 108 end
    if m[2, 2] != 77 do out 109 end

    var m_addr = m as int
    if native_read_i64(m_addr, 0) != 9 do out 110 end
    if native_read_i64(m_addr, 8) != 9 do out 111 end

    print "PASS: Stage 1 - Multi-D Tensor Mutation & Layout"
    out 0
end.

func test_stage2_rect_matmul() -> int:
    var a32: tensor<i32>[3, 2]
    a32[0, 0] = 2
    a32[0, 1] = 5
    a32[1, 0] = 3
    a32[1, 1] = 7
    a32[2, 0] = 4
    a32[2, 1] = 6

    var b23: tensor<i32>[2, 3]
    b23[0, 0] = 8
    b23[0, 1] = 1
    b23[0, 2] = 9
    b23[1, 0] = 4
    b23[1, 1] = 3
    b23[1, 2] = 2

    var c33 = a32 ** b23

    if c33[0, 0] != 36 do out 201 end
    if c33[0, 1] != 17 do out 202 end
    if c33[0, 2] != 28 do out 203 end
    if c33[1, 0] != 52 do out 204 end
    if c33[1, 1] != 24 do out 205 end
    if c33[1, 2] != 41 do out 206 end
    if c33[2, 0] != 56 do out 207 end
    if c33[2, 1] != 22 do out 208 end
    if c33[2, 2] != 48 do out 209 end

    var d23: tensor<int>[2, 3] = [1, 2, 3, 4, 5, 6]
    var e32: tensor<int>[3, 2] = [7, 8, 9, 10, 11, 12]
    var f22 = d23 ** e32

    if f22[0, 0] != 58 do out 210 end
    if f22[0, 1] != 64 do out 211 end
    if f22[1, 0] != 139 do out 212 end
    if f22[1, 1] != 154 do out 213 end

    print "PASS: Stage 2 - 2D Rectangular MatMul 3x2x3 and 2x3x2"
    out 0
end.

func test_stage3_fma_operator() -> int:
    var d23: tensor<int>[2, 3] = [1, 2, 3, 4, 5, 6]
    var e32: tensor<int>[3, 2] = [7, 8, 9, 10, 11, 12]
    var fma_rect = d23 >< e32
    if fma_rect[0, 0] != 58 do out 301 end
    if fma_rect[0, 1] != 64 do out 302 end
    if fma_rect[1, 0] != 139 do out 303 end
    if fma_rect[1, 1] != 154 do out 304 end

    var sa: tensor<int>[2, 2] = [1, 2, 3, 4]
    var sb: tensor<int>[2, 2] = [5, 6, 7, 8]
    var fma_sq = sa >< sb
    if fma_sq[0, 0] != 19 do out 305 end
    if fma_sq[0, 1] != 22 do out 306 end
    if fma_sq[1, 0] != 43 do out 307 end
    if fma_sq[1, 1] != 50 do out 308 end

    print "PASS: Stage 3 - First-Class FMA Operator ><"
    out 0
end.

func test_stage4_scoped_arena() -> int:
    var top_before = alloc(0) as int
    arena:
        var arena_a: tensor<int>[2, 2] = [2, 0, 0, 2]
        var arena_b: tensor<int>[2, 2] = [10, 20, 30, 40]
        var arena_c = arena_a ** arena_b

        if arena_c[0, 0] != 20 do out 401 end
        if arena_c[0, 1] != 40 do out 402 end
        if arena_c[1, 0] != 60 do out 403 end
        if arena_c[1, 1] != 80 do out 404 end

        var top_inside = alloc(0) as int
        if top_inside <= top_before do out 405 end
    end
    var top_after = alloc(0) as int
    if top_after != top_before do out 406 end

    print "PASS: Stage 4 - Scoped Arena Block Zero-Leakage"
    out 0
end.

func test_stage5_infer_zero_tape() -> int:
    infer:
        var wi: tensor<f32>[2, 2] = [1.0, 2.0, 3.0, 4.0]
        var xi: tensor<f32>[2, 2] = [1.0, 0.0, 0.0, 1.0]
        var yi = wi ** xi

        var y_ptr = yi as int
        if native_read_i64(y_ptr, 16) != 4607182418800017408 do out 501 end
        if native_read_i64(y_ptr, 24) != 4611686018427387904 do out 502 end
        if native_read_i64(y_ptr, 32) != 4613937818241073152 do out 503 end
        if native_read_i64(y_ptr, 40) != 4616189618054758400 do out 504 end

        # In infer mode, cap remains 4 (no gradient pointer written to *(wi + 8))
        if native_read_i64(wi as int, 8) != 4 do out 505 end
        if native_read_i64(xi as int, 8) != 4 do out 506 end
    end

    print "PASS: Stage 5 - Infer Block Zero-Tape Execution"
    out 0
end.

func test_stage6_reverse_autodiff() -> int:
    train:
        var wt: tensor<f32>[2, 2] = [1.0, 2.0, 3.0, 4.0]
        var xt: tensor<f32>[2, 2] = [1.0, 0.0, 0.0, 1.0]
        var out_t = wt ** xt
        out_t.backward()

        var gwt = native_read_i64(wt as int, 8)
        if gwt == 0 do out 601 end
        if native_read_i64(gwt, 0) != 4 do out 602 end
        if native_read_i64(gwt, 8) != 4 do out 603 end
        if native_read_i64(gwt, 16) != 4607182418800017408 do out 604 end
        if native_read_i64(gwt, 24) != 4607182418800017408 do out 605 end
        if native_read_i64(gwt, 32) != 4607182418800017408 do out 606 end
        if native_read_i64(gwt, 40) != 4607182418800017408 do out 607 end

        var gxt = native_read_i64(xt as int, 8)
        if gxt == 0 do out 608 end
        if native_read_i64(gxt, 0) != 4 do out 609 end
        if native_read_i64(gxt, 8) != 4 do out 610 end
        if native_read_i64(gxt, 16) != 4616189618054758400 do out 611 end
        if native_read_i64(gxt, 24) != 4616189618054758400 do out 612 end
        if native_read_i64(gxt, 32) != 4618441417868443648 do out 613 end
        if native_read_i64(gxt, 40) != 4618441417868443648 do out 614 end
    end

    print "PASS: Stage 6 - Reverse-Mode Autodiff Gradients"
    out 0
end.

func test_stage7_quantization() -> int:
    var qw: tensor<f32>[2, 2] = [1.0, 2.0, 3.0, 4.0]
    var q8 = quantize(qw, bits: 8)
    var p8 = q8 as int
    if native_read_i64(p8, 0) != 4 do out 701 end
    if native_read_i64(p8, 8) != 8 do out 702 end
    if native_read_i64(p8, 16) != 1 do out 703 end
    if native_read_i64(p8, 24) != 0 do out 704 end
    if native_read_u8(p8, 32) != 1 do out 705 end
    if native_read_u8(p8, 33) != 2 do out 706 end
    if native_read_u8(p8, 34) != 3 do out 707 end
    if native_read_u8(p8, 35) != 4 do out 708 end

    var q_neg: tensor<f32>[2, 1] = [-5.0, 10.0]
    var qn = quantize(q_neg, bits: 8)
    var pn = qn as int
    if native_read_i64(pn, 16) != 1 do out 710 end
    if native_read_u8(pn, 32) != 251 do out 711 end
    if native_read_u8(pn, 33) != 10 do out 712 end

    var q_big: tensor<f32>[2, 1] = [127.0, 254.0]
    var qb = quantize(q_big, bits: 8)
    var pb = qb as int
    if native_read_i64(pb, 16) != 2 do out 720 end
    if native_read_u8(pb, 32) != 63 do out 721 end
    if native_read_u8(pb, 33) != 127 do out 722 end

    var q4 = quantize(qw, bits: 4)
    var p4 = q4 as int
    if native_read_i64(p4, 0) != 4 do out 730 end
    if native_read_i64(p4, 8) != 4 do out 731 end
    if native_read_i64(p4, 16) != 1 do out 732 end
    if native_read_u8(p4, 32) != 33 do out 733 end
    if native_read_u8(p4, 33) != 67 do out 734 end

    print "PASS: Stage 7 - Quantization Pipeline (INT8/INT4/Scale/Signed)"
    out 0
end.

func main() -> int:
    var s1 = test_stage1_tensor_mutation()
    if s1 != 0 do out s1 end
    var s2 = test_stage2_rect_matmul()
    if s2 != 0 do out s2 end
    var s3 = test_stage3_fma_operator()
    if s3 != 0 do out s3 end
    var s4 = test_stage4_scoped_arena()
    if s4 != 0 do out s4 end
    var s5 = test_stage5_infer_zero_tape()
    if s5 != 0 do out s5 end
    var s6 = test_stage6_reverse_autodiff()
    if s6 != 0 do out s6 end
    var s7 = test_stage7_quantization()
    if s7 != 0 do out s7 end

    print "OVERALL PASS: Spec 26 AI/ML End-to-End Mathematical Proof Complete"
    out 0
end.

