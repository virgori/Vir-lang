# EXPECT_START
# 17
# 9
# 3
# 3
# 2
# EXPECT_END
# §14.2: canonical grouped parameters, newline separators, and caller slots.

func transform:
    in
        numerator: int
        denominator: int
    ref
        left: int
        right: int
    out
        quotient: int
        remainder: int

    var temporary = left
    left = right
    right = temporary
    quotient = numerator / denominator
    remainder = numerator mod denominator
end.

func main:
    var a = 3
    var b = 9
    var quotient: int
    var remainder: int
    transform(17, 5, a, b, quotient, remainder)
    print(17)
    print(a)
    print(b)
    print(quotient)
    print(remainder)
    out 0
end.
