# §14 backend edge: ref/out arguments beyond native register banks.

func pressure:
    in a0: int; a1: int; a2: int; a3: int; a4: int; a5: int; a6: int; a7: int
    ref target: int
    out result: int

    target = target + a0 + a7
    result = a1 + a2 + a3 + a4 + a5 + a6
end.

func main:
    var target = 7
    var result: int
    pressure(1, 2, 3, 4, 5, 1, 3, 8, target, result)
    print(target)
    print(result)
    out 0
end.
