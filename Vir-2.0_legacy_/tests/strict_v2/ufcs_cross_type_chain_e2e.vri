# EXPECT_START
# 10
# 12
# 14
# 16
# EXPECT_END

entity Box:
    value: int

    method score() -> int:
        out this.value + 1
    end.
end.

entity Wrapper:
    value: int

    method to_box() -> Box:
        out Box(value: this.value)
    end.
end.

entity Factory:
    make: func(int) -> Box
end.

func to_box(this: int) -> Box:
    out Box(value: this)
end.

func make_box(value: int) -> Box:
    out Box(value: value)
end.

func main:
    print(9.to_box().score())
    print(to_box(11).score())
    var wrapper = Wrapper(value: 13)
    print(wrapper.to_box().score())
    var factory = Factory(make: make_box)
    print(factory.make(15).score())
    out 0
end.
