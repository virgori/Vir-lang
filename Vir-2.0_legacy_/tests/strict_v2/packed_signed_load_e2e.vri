# EXPECT_START
# -1
# -2
# -3
# 255
# 254
# 255
# 253
# 255
# 255
# 255
# EXPECT_END
extern func native_read_u8(addr: int, offset: int) -> int

packed entity SignedWire:
    tiny: i8
    short: i16
    word: i32
end.

func main:
    var value: SignedWire = SignedWire(tiny: -1, short: -2, word: -3)
    print(value.tiny)
    print(value.short)
    print(value.word)
    print(native_read_u8(value as int, 0))
    print(native_read_u8(value as int, 1))
    print(native_read_u8(value as int, 2))
    print(native_read_u8(value as int, 3))
    print(native_read_u8(value as int, 4))
    print(native_read_u8(value as int, 5))
    print(native_read_u8(value as int, 6))
    out 0
end.
