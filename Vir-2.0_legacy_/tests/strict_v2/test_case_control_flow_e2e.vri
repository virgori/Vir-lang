# EXPECT_START
# 200
# 1
# 2
# 77
# EXPECT_END

var target_calls = 0

func next_target() -> int:
    target_calls = target_calls + 1
    out 2
end.

func classify(value: int) -> int:
    case value
        1: out 100
        2:
            case "inner"
                "inner": out 200
                else out 201
            end
        else out 300
    end
    out -1
end.

func main:
    print(classify(next_target()))
    print(target_calls)

    var sum = 0
    for i in 0..5 do
        case i
            1: skip
            3: break
            else sum = sum + i
        end
    end
    print(sum)

    case 999
        1: print(1)
        _: print(77)
    end

    out 0
end.
