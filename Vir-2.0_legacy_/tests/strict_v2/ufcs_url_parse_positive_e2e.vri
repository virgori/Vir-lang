# EXPECT: 1
# Positive control for url parsing with net.url included

include net.url

extern func native_read_u8(addr: int, offset: int) -> int

func test_str_eq(a: string, b: string) -> bool:
    let pa = a as int
    let pb = b as int
    if pa == pb do out true end
    if pa == 0 or pb == 0 do out false end
    var i = 0
    loop
        let ca = native_read_u8(pa, i)
        let cb = native_read_u8(pb, i)
        if ca != cb do out false end
        if ca == 0 do out true end
        i = i + 1
    end
    out true
end.

func parse(raw_uri: string) -> int:
    let res = url_parse(raw_uri)
    case res
        Ok(u):
            let p = url_get_path(u)
            if test_str_eq(p, "/health") do
                out 1
            else
                out 0
            end
        Err(_):
            out 0
    end
end.

func main:
    let raw_uri = "/health?ready=1"
    let ok = parse(raw_uri)
    print(ok)
    out 0
end.
