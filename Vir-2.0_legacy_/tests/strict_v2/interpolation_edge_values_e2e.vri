# EXPECT_START
# field=7; nested=9; index=20; call=42; method=7
# label=box; bool=true; dollar=$100; expr=11
# EXPECT_END

entity InterpInner:
    value: int
end.

entity InterpBox:
    value: int
    label_text: string
    inner: InterpInner

    method number() -> int:
        out this.value
    end.

    method label() -> string:
        out this.label_text
    end.

    method yes() -> bool:
        out true
    end.
end.

func interp_answer() -> int:
    out 42
end.

func main:
    var box = InterpBox(value: 7, label_text: "box", inner: InterpInner(value: 9))
    var values = [10, 20]
    var x = 5
    print("field=$box.value; nested=$box.inner.value; index=$(values[1]); call=$(interp_answer()); method=$(box.number())")
    print("label=$(box.label()); bool=$(box.yes()); dollar=$$100; expr=$((x + 1) + 5)")
    out 0
end.
