# EXPECT_END

include virgex.virgex
include pattern.string

func main:
    # -------------------------------------------------------
    # 1. Compiler Atoms (6 tests)
    # -------------------------------------------------------
    # Test 1: @Az
    var p1 = virgex_compile("| @Az |")
    if p1.match("a") & p1.match("Z") & !p1.match("1") do print(1) else print(0) end

    # Test 2: @AZ
    var p2 = virgex_compile("| @AZ |")
    if p2.match("A") & p2.match("Z") & !p2.match("a") do print(1) else print(0) end

    # Test 3: @az
    var p3 = virgex_compile("| @az |")
    if p3.match("a") & p3.match("z") & !p3.match("A") do print(1) else print(0) end

    # Test 4: @0
    var p4 = virgex_compile("| @0 |")
    if p4.match("0") & p4.match("9") & !p4.match("a") do print(1) else print(0) end

    # Test 5: @06
    var p5 = virgex_compile("| @06 |")
    if p5.match("0") & p5.match("6") & !p5.match("7") & !p5.match("9") do print(1) else print(0) end

    # Test 6: @Az0
    var p6 = virgex_compile("| @Az0 |")
    if p6.match("a") & p6.match("Z") & p6.match("0") & !p6.match("_") do print(1) else print(0) end

    # -------------------------------------------------------
    # 2. Compiler Quantifiers (5 tests)
    # -------------------------------------------------------
    # Test 7: @0!3
    var p7 = virgex_compile("| @0!3 |")
    if p7.match("123") & !p7.match("12") & !p7.match("1234") do print(1) else print(0) end

    # Test 8: @Az!1~5
    var p8 = virgex_compile("| @Az!1~5 |")
    if p8.match("a") & p8.match("abc") & p8.match("abcde") & !p8.match("") & !p8.match("abcdef") do print(1) else print(0) end

    # Test 9: @0!2~
    var p9 = virgex_compile("| @0!2~ |")
    if p9.match("12") & p9.match("12345") & !p9.match("1") do print(1) else print(0) end

    # Test 10: @0!~
    var p10 = virgex_compile("| @0!~ |")
    if p10.match("") & p10.match("1") & p10.match("1234") & !p10.match("a") do print(1) else print(0) end

    # Test 11: @0!1
    var p11 = virgex_compile("| @0!1 |")
    if p11.match("5") & !p11.match("") & !p11.match("55") do print(1) else print(0) end

    # -------------------------------------------------------
    # 3. Compiler Anchors (3 tests)
    # -------------------------------------------------------
    # Test 12: both anchors: | @0!3 |
    var p12 = virgex_compile("| @0!3 |")
    if p12.match("123") & !p12.match("a123") & !p12.match("123b") do print(1) else print(0) end

    # Test 13: start only: | @0!3
    var p13 = virgex_compile("| @0!3")
    var f13_1 = p13.find("123abc")
    var f13_2 = p13.find("a123")
    if str_eq(f13_1, "123") & str_byte_len(f13_2) == 0 do print(1) else print(0) end

    # Test 14: end only: @0!3 |
    var p14 = virgex_compile("@0!3 |")
    var f14_1 = p14.find("abc123")
    var f14_2 = p14.find("123a")
    if str_eq(f14_1, "123") & str_byte_len(f14_2) == 0 do print(1) else print(0) end

    # -------------------------------------------------------
    # 4. Compiler Optional (3 tests)
    # -------------------------------------------------------
    # Test 15: optional atom ?@0
    var p15 = virgex_compile("| ?@0 |")
    if p15.match("") & p15.match("5") & !p15.match("a") & !p15.match("55") do print(1) else print(0) end

    # Test 16: optional quantified ?@AZ!2
    var p16 = virgex_compile("| ?@AZ!2 |")
    if p16.match("") & p16.match("HN") & !p16.match("H") & !p16.match("HNA") do print(1) else print(0) end

    # Test 17: optional group ?:( $- @0!5 :)
    var p17 = virgex_compile("| ?:( $- @0!5 :) |")
    if p17.match("") & p17.match("-12345") & !p17.match("-") & !p17.match("-123") do print(1) else print(0) end

    # -------------------------------------------------------
    # 5. Compiler Groups & Alternation (4 tests)
    # -------------------------------------------------------
    # Test 18: simple group :( - @0 :)
    var p18 = virgex_compile("| :( - @0 :) |")
    if p18.match(" 5") & !p18.match("5") do print(1) else print(0) end

    # Test 19: or :( A | B :)
    var p19 = virgex_compile("| :( A | B :) |")
    if p19.match("A") & p19.match("B") & !p19.match("C") do print(1) else print(0) end

    # Test 20: complex or :( @AZ!2 | @0!3 :)
    var p20 = virgex_compile("| :( @AZ!2 | @0!3 :) |")
    if p20.match("HN") & p20.match("123") & !p20.match("H") & !p20.match("12") do print(1) else print(0) end

    # Test 21: group quantified :( - @0 :)!3
    var p21 = virgex_compile("| :( - @0 :)!3 |")
    if p21.match(" 1 2 3") & !p21.match(" 1 2") do print(1) else print(0) end

    # -------------------------------------------------------
    # 6. Compiler Escape (4 tests)
    # -------------------------------------------------------
    # Test 22: escape dash $-
    var p22 = virgex_compile("| $- |")
    if p22.match("-") & !p22.match(" ") do print(1) else print(0) end

    # Test 23: escape pipe $|
    var p23 = virgex_compile("| $| |")
    if p23.match("|") & !p23.match("a") do print(1) else print(0) end

    # Test 24: escape question $?
    var p24 = virgex_compile("| $? |")
    if p24.match("?") & !p24.match("a") do print(1) else print(0) end

    # Test 25: escape block $. |@!~ .$
    var p25 = virgex_compile("$. |@!~ .$")
    var f25 = p25.find("hello |@!~ world")
    if str_eq(f25, " |@!~ ") do print(1) else print(0) end

    # -------------------------------------------------------
    # 7. Compiler Literals (2 tests)
    # -------------------------------------------------------
    # Test 26: plain literal ABC
    var p26 = virgex_compile("| ABC |")
    if p26.match("ABC") & !p26.match("abd") do print(1) else print(0) end

    # Test 27: literal HN
    var p27 = virgex_compile("| HN |")
    if p27.match("HN") & !p27.match("hn") do print(1) else print(0) end

    # -------------------------------------------------------
    # 8. Compiler Space Token (1 test)
    # -------------------------------------------------------
    # Test 28: @AZ!2 - @0!5
    var p28 = virgex_compile("| @AZ!2 - @0!5 |")
    if p28.match("HN 12345") & !p28.match("HN12345") do print(1) else print(0) end

    # -------------------------------------------------------
    # 9. Compiler Spec Examples (5 tests)
    # -------------------------------------------------------
    # Test 29: exact 3 digits
    var p29 = virgex_compile("| @0!3 |")
    if p29.match("123") & !p29.match("12") do print(1) else print(0) end

    # Test 30: id code
    var p30 = virgex_compile("| @AZ!2 $- @0!5 $? |")
    if p30.match("HN-12345?") & !p30.match("HN-12345") do print(1) else print(0) end

    # Test 31: optional suffix
    var p31 = virgex_compile("| @AZ!2 ?:( $- @0!5 :) |")
    if p31.match("HN") & p31.match("HN-12345") & !p31.match("HN-123") do print(1) else print(0) end

    # Test 32: a or b
    var p32 = virgex_compile("| :( A | B :) |")
    if p32.match("A") & p32.match("B") & !p32.match("C") do print(1) else print(0) end

    # Test 33: username
    var p33 = virgex_compile("| @Az0!3~12 |")
    if p33.match("user123") & !p33.match("ab") & p33.match("abcdefghijkl") do print(1) else print(0) end

    # -------------------------------------------------------
    # 10. E2E Exact3Digits (4 tests)
    # -------------------------------------------------------
    var p_exact = "| @0!3 |"
    # Test 34: match
    if virgex_fullmatch(p_exact, "123") do print(1) else print(0) end
    # Test 35: reject short
    if !virgex_fullmatch(p_exact, "12") do print(1) else print(0) end
    # Test 36: reject long
    if !virgex_fullmatch(p_exact, "1234") do print(1) else print(0) end
    # Test 37: reject alpha
    if !virgex_fullmatch(p_exact, "abc") do print(1) else print(0) end

    # -------------------------------------------------------
    # 11. E2E IdCode (3 tests)
    # -------------------------------------------------------
    var p_id = "| @AZ!2 $- @0!5 $? |"
    # Test 38: match
    if virgex_fullmatch(p_id, "HN-12345?") do print(1) else print(0) end
    # Test 39: reject no question
    if !virgex_fullmatch(p_id, "HN-12345") do print(1) else print(0) end
    # Test 40: reject lowercase
    if !virgex_fullmatch(p_id, "hn-12345?") do print(1) else print(0) end

    # -------------------------------------------------------
    # 12. E2E OptionalSuffix (3 tests)
    # -------------------------------------------------------
    var p_opt = "| @AZ!2 ?:( $- @0!5 :) |"
    # Test 41: match with suffix
    if virgex_fullmatch(p_opt, "HN-12345") do print(1) else print(0) end
    # Test 42: match without suffix
    if virgex_fullmatch(p_opt, "HN") do print(1) else print(0) end
    # Test 43: reject partial
    if !virgex_fullmatch(p_opt, "HN-123") do print(1) else print(0) end

    # -------------------------------------------------------
    # 13. E2E AorB (3 tests)
    # -------------------------------------------------------
    var p_ab = "| :( A | B :) |"
    # Test 44: match A
    if virgex_fullmatch(p_ab, "A") do print(1) else print(0) end
    # Test 45: match B
    if virgex_fullmatch(p_ab, "B") do print(1) else print(0) end
    # Test 46: reject C
    if !virgex_fullmatch(p_ab, "C") do print(1) else print(0) end

    # -------------------------------------------------------
    # 14. E2E Username (5 tests)
    # -------------------------------------------------------
    var p_user = "| @Az0!3~12 |"
    # Test 47: min
    if virgex_fullmatch(p_user, "abc") do print(1) else print(0) end
    # Test 48: max
    if virgex_fullmatch(p_user, "abcdefghijkl") do print(1) else print(0) end
    # Test 49: reject short
    if !virgex_fullmatch(p_user, "ab") do print(1) else print(0) end
    # Test 50: reject long
    if !virgex_fullmatch(p_user, "abcdefghijklm") do print(1) else print(0) end
    # Test 51: reject special
    if !virgex_fullmatch(p_user, "abc@def") do print(1) else print(0) end

    # -------------------------------------------------------
    # 15. E2E SpacePattern (2 tests)
    # -------------------------------------------------------
    var p_sp = "| @AZ!2 - @0!5 |"
    # Test 52: match
    if virgex_fullmatch(p_sp, "HN 12345") do print(1) else print(0) end
    # Test 53: reject no space
    if !virgex_fullmatch(p_sp, "HN12345") do print(1) else print(0) end

    # -------------------------------------------------------
    # 16. E2E RepeatedGroup (2 tests)
    # -------------------------------------------------------
    var p_rep = "| :( - @0 :)!3 |"
    # Test 54: match
    if virgex_fullmatch(p_rep, " 1 2 3") do print(1) else print(0) end
    # Test 55: reject
    if !virgex_fullmatch(p_rep, " 1 2") do print(1) else print(0) end

    # -------------------------------------------------------
    # 17. E2E Search (2 tests)
    # -------------------------------------------------------
    # Test 56: find digits
    var f56 = virgex_find("@0!3", "abc123def")
    if str_eq(f56, "123") do print(1) else print(0) end

    # Test 57: find all
    var list57 = virgex_find_all("@0!3", "abc123def456ghi789")
    var c57_len = len(list57) == 3
    var c57_items = str_eq(list57[0], "123") & str_eq(list57[1], "456") & str_eq(list57[2], "789")
    if c57_len & c57_items do print(1) else print(0) end

    # -------------------------------------------------------
    # 18. E2E DigitRange (1 test)
    # -------------------------------------------------------
    # Test 58: 06 range
    var p58 = "| @06 |"
    var m58_0 = virgex_fullmatch(p58, "0")
    var m58_6 = virgex_fullmatch(p58, "6")
    var m58_7 = !virgex_fullmatch(p58, "7")
    var m58_9 = !virgex_fullmatch(p58, "9")
    if m58_0 & m58_6 & m58_7 & m58_9 do print(1) else print(0) end

    # -------------------------------------------------------
    # 19. E2E EscapeBlock (1 test)
    # -------------------------------------------------------
    # Test 59: escape block
    var f59 = virgex_find("$.|@!~.$", "hello |@!~ world")
    if str_eq(f59, "|@!~") do print(1) else print(0) end

    # -------------------------------------------------------
    # 20. E2E NestedGroups (1 test)
    # -------------------------------------------------------
    # Test 60: nested or
    var p60 = "| :( A | :( B | C :) :) |"
    var m60_a = virgex_fullmatch(p60, "A")
    var m60_b = virgex_fullmatch(p60, "B")
    var m60_c = virgex_fullmatch(p60, "C")
    var m60_d = !virgex_fullmatch(p60, "D")
    if m60_a & m60_b & m60_c & m60_d do print(1) else print(0) end

    # -------------------------------------------------------
    # 21. Retired Python Wrapper Contracts / Native API Smoke (3 tests)
    # Ba contract Python (regex property, repr() string, và prefix-match()) không
    # có tương đương 1:1 trong native Vir vì wrapper Python đã bị loại bỏ (retired).
    # Tại đây kiểm tra các API native độc lập của Pattern: Pattern.source,
    # Pattern.match (full-match) và Pattern.is_match (search).
    # -------------------------------------------------------
    var p61 = virgex_compile("| @0!3 |")
    # Test 61: Pattern.source (kiểm tra trường source của Pattern)
    if str_eq(p61.source, "| @0!3 |") do print(1) else print(0) end
    # Test 62: Pattern.match (native full-match)
    if p61.match("123") & !p61.match("12") do print(1) else print(0) end
    # Test 63: Pattern.is_match (native search/prefix check)
    if p61.is_match("123") & !p61.is_match("abc") do print(1) else print(0) end

    # -------------------------------------------------------
    # 22. E2E ZeroOrMoreSpaces (3 tests)
    # -------------------------------------------------------
    var p_spaces = "| @AZ!2 -!~ @0!3 |"
    # Test 64: no spaces
    if virgex_fullmatch(p_spaces, "HN123") do print(1) else print(0) end
    # Test 65: one space
    if virgex_fullmatch(p_spaces, "HN 123") do print(1) else print(0) end
    # Test 66: many spaces
    if virgex_fullmatch(p_spaces, "HN   123") do print(1) else print(0) end
end.
