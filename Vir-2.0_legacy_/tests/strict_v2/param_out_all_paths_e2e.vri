# EXPECT_START
# 10
# 20
# EXPECT_END
# §14.4: all normal-return branches initialize the caller's out slot.

func choose:
    in condition: bool
    out value: int

    if condition do
        value = 10
    else
        value = 20
    end
end.

func main:
    var first: int
    var second: int
    choose(true, first)
    choose(false, second)
    print(first)
    print(second)
    out 0
end.
