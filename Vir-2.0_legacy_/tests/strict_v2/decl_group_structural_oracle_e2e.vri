# EXPECT_START
# 121
# 123
# 1
# 2
# 3
# 1540
# 15
# 25
# EXPECT_END

enum AstType:
    VarDecl = 3
    ConstDecl = 4
    VarDeclGroup = 121
end.

var g_order = 0

func record_step(val: int) -> int:
    g_order = g_order * 10 + val
    out val
end.

func main:
    # 0. Structural Oracle: AstType.VarDeclGroup is 121
    print AstType.VarDeclGroup as int

    # 1. Structural Oracle: Initializer evaluation order is strictly left-to-right
    var
        s1 = record_step(1)
        s2 = record_step(2)
        s3 = record_step(3)
    print g_order

    # 2. Structural Oracle: Bindings are visible in enclosing scope and preserve values
    print s1
    print s2
    print s3

    # 3. Structural Oracle: No hidden lexical scope, enclosing scope access
    let outer_base = 500
    let
        l1 = outer_base + 10
        l2 = l1 + 20
    let total = outer_base + l1 + l2
    print total

    # 4. Structural Oracle: Grouped var mutability preserved
    var
        m1 = 10
        m2 = 20
    m1 = m1 + 5
    m2 = m2 + 5
    print m1
    print m2
end.
