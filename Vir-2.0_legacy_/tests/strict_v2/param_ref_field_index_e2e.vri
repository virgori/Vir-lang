# §14: entity fields and array elements are addressable mutable lvalues.

entity Cell:
    value: int
end.

func add(ref target: int, delta: int):
    target = target + delta
end.

func main:
    var cell = Cell(value: 7)
    var values = [10, 20, 30]
    add(cell.value, 5)
    add(values[1], 1)
    print(cell.value)
    print(values[1])
    out 0
end.
