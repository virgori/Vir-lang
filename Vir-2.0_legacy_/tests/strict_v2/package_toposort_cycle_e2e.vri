# EXPECT_START
# 3
# 0
# 1
# 2
# -1
# EXPECT_END
# Package-manager regression: recursive DAG ordering must not corrupt the
# call frame, and a two-node cycle must return -1 instead of crashing.
func pkg_node(deps, dep_count):
    let p = alloc(24)
    write_word(p, 0, dep_count)
    write_word(p, 8, deps)
    write_word(p, 16, 0)
    out p
end.

func visit(pkgs, node_idx, out_order, order_idx):
    let node = read_word(pkgs, node_idx * 8)
    let status = read_word(node, 16)
    if status == 2 do out order_idx end
    if status == 1 do out 0 - 1 end
    write_word(node, 16, 1)

    let dep_count = read_word(node, 0)
    let deps = read_word(node, 8)
    var i = 0
    when i < dep_count loop
        let dep_idx = read_word(deps, i * 8)
        order_idx = visit(pkgs, dep_idx, out_order, order_idx)
        if order_idx < 0 do out 0 - 1 end
        i = i + 1
    end

    write_word(node, 16, 2)
    write_word(out_order, order_idx * 8, node_idx)
    out order_idx + 1
end.

func sort_packages(pkgs, count, out_order):
    var order_idx = 0
    var i = 0
    when i < count loop
        let node = read_word(pkgs, i * 8)
        if read_word(node, 16) == 0 do
            order_idx = visit(pkgs, i, out_order, order_idx)
            if order_idx < 0 do out 0 - 1 end
        end
        i = i + 1
    end
    out order_idx
end.

func main:
    let pkgs = alloc(24)
    let no_deps = alloc(8)
    let mid_deps = alloc(8)
    let top_deps = alloc(8)
    write_word(mid_deps, 0, 0)
    write_word(top_deps, 0, 1)
    write_word(pkgs, 0, pkg_node(no_deps, 0))
    write_word(pkgs, 8, pkg_node(mid_deps, 1))
    write_word(pkgs, 16, pkg_node(top_deps, 1))
    let order = alloc(24)
    print sort_packages(pkgs, 3, order)
    print read_word(order, 0)
    print read_word(order, 8)
    print read_word(order, 16)

    let cyclic = alloc(16)
    let deps_a = alloc(8)
    let deps_b = alloc(8)
    write_word(deps_a, 0, 1)
    write_word(deps_b, 0, 0)
    write_word(cyclic, 0, pkg_node(deps_a, 1))
    write_word(cyclic, 8, pkg_node(deps_b, 1))
    let cycle_order = alloc(16)
    print sort_packages(cyclic, 2, cycle_order)
end.
