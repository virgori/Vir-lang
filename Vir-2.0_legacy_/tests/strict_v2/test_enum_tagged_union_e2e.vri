# EXPECT_START
# 11
# 0
# 22
# 33
# 44
# 55
# 66
# payload
# 88
# 89
# 90
# EXPECT_END

enum Option<T>:
    Some(value: T)
    None
end.

enum Result<T, E>:
    Ok(value: T)
    Err(error: E)
end.

enum Multi:
    Empty
    Pair(left: int, right: int)
    Text(value: string)
end.

enum Color:
    Red
    Green
end.

enum First:
    Value(value: int)
end.

enum Second:
    Value(value: int)
end.

func option_value(opt: Option<int>) -> int:
    case opt
        Some(value): out value
        None: out 0
    end
end.

func result_value(result: Result<int, int>) -> int:
    case result
        Ok(value): out value
        Err(err): out err
    end
end.

func pair_sum(value: Multi) -> int:
    case value
        Pair(left, right): out left + right
        Empty: out 0
        Text(_): out 0
    end
end.

func main:
    print(option_value(Some(11)))
    print(option_value(None))
    print(result_value(Ok(22)))
    print(result_value(Err(33)))
    print(pair_sum(Pair(20, 24)))

    var nested = Some(Ok(55))
    case nested
        Some(inner):
            print(result_value(inner))
        None: print(0)
    end

    case Color.Green
        Color.Red: print(0)
        Color.Green: print(66)
    end

    var text = Text("payload")
    case text
        Text(value):
            print(value)
        Empty: print(0)
        Pair(_, _): print(0)
    end

    print(option_value(Option.Some(88)))

    let first = First.Value(89)
    case first
        First.Value(value): print(value)
    end
    let second = Second.Value(90)
    case second
        Second.Value(value): print(value)
    end

    out 0
end.
