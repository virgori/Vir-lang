# 1
# 1
# 1
# 1
# 1
# 1
# 1
# 1
# EXPECT_END

include virgex.virgex
include pattern.string

func main:
    # -------------------------------------------------------
    # 1. Lexer Atoms (8 tests)
    # -------------------------------------------------------
    # Test 1: @Az
    var r1 = vps_tokenize("@Az")
    var toks1 = _vps_tokens_or_panic(r1)
    let t1: VpsToken = vec_get<VpsToken>(toks1, 0)
    var c1_tag = t1.tag == VpsTok.Atom
    var c1_name = str_eq(t1.atom_name, "Az")
    var c1_neg = !t1.is_negated
    if c1_tag & c1_name & c1_neg do print(1) else print(0) end

    # Test 2: @AZ
    var r2 = vps_tokenize("@AZ")
    var toks2 = _vps_tokens_or_panic(r2)
    let t2: VpsToken = vec_get<VpsToken>(toks2, 0)
    if str_eq(t2.atom_name, "AZ") do print(1) else print(0) end

    # Test 3: @az
    var r3 = vps_tokenize("@az")
    var toks3 = _vps_tokens_or_panic(r3)
    let t3: VpsToken = vec_get<VpsToken>(toks3, 0)
    if str_eq(t3.atom_name, "az") do print(1) else print(0) end

    # Test 4: @0
    var r4 = vps_tokenize("@0")
    var toks4 = _vps_tokens_or_panic(r4)
    let t4: VpsToken = vec_get<VpsToken>(toks4, 0)
    if str_eq(t4.atom_name, "0") do print(1) else print(0) end

    # Test 5: @06
    var r5 = vps_tokenize("@06")
    var toks5 = _vps_tokens_or_panic(r5)
    let t5: VpsToken = vec_get<VpsToken>(toks5, 0)
    if str_eq(t5.atom_name, "06") do print(1) else print(0) end

    # Test 6: @Az0
    var r6 = vps_tokenize("@Az0")
    var toks6 = _vps_tokens_or_panic(r6)
    let t6: VpsToken = vec_get<VpsToken>(toks6, 0)
    if str_eq(t6.atom_name, "Az0") do print(1) else print(0) end

    # Test 7: @96 (invalid digit range: 9 > 6)
    var r7 = vps_tokenize("@96")
    if is_err(r7) do print(1) else print(0) end

    # Test 8: @ (empty atom name)
    var r8 = vps_tokenize("@ ")
    if is_err(r8) do print(1) else print(0) end

    # -------------------------------------------------------
    # 2. Lexer Quantifiers (6 tests)
    # -------------------------------------------------------
    # Test 9: @0!3
    var r9 = vps_tokenize("@0!3")
    var toks9 = _vps_tokens_or_panic(r9)
    let t9: VpsToken = vec_get<VpsToken>(toks9, 1)
    if t9.tag == VpsTok.Quantifier & t9.qmin == 3 & t9.qmax == 3 do print(1) else print(0) end

    # Test 10: @Az!1~5
    var r10 = vps_tokenize("@Az!1~5")
    var toks10 = _vps_tokens_or_panic(r10)
    let t10: VpsToken = vec_get<VpsToken>(toks10, 1)
    if t10.tag == VpsTok.Quantifier & t10.qmin == 1 & t10.qmax == 5 do print(1) else print(0) end

    # Test 11: @0!2~
    var r11 = vps_tokenize("@0!2~")
    var toks11 = _vps_tokens_or_panic(r11)
    let t11: VpsToken = vec_get<VpsToken>(toks11, 1)
    if t11.tag == VpsTok.Quantifier & t11.qmin == 2 & t11.qmax < 0 do print(1) else print(0) end

    # Test 12: -!~
    var r12 = vps_tokenize("-!~")
    var toks12 = _vps_tokens_or_panic(r12)
    let t12: VpsToken = vec_get<VpsToken>(toks12, 1)
    if t12.tag == VpsTok.Quantifier & t12.qmin == 0 & t12.qmax < 0 do print(1) else print(0) end

    # Test 13: @0 !3 (whitespace in quantifier)
    var r13 = vps_tokenize("@0 !3")
    var toks13 = _vps_tokens_or_panic(r13)
    let t13: VpsToken = vec_get<VpsToken>(toks13, 1)
    if t13.tag == VpsTok.Quantifier & t13.qmin == 3 & t13.qmax == 3 do print(1) else print(0) end

    # Test 14: @0!5~2 (invalid quantifier: max < min)
    var r14 = vps_tokenize("@0!5~2")
    if is_err(r14) do print(1) else print(0) end

    # -------------------------------------------------------
    # 3. Lexer Groups and Pipes (3 tests)
    # -------------------------------------------------------
    # Test 15: :( A :)
    var r15 = vps_tokenize(":( A :)")
    var toks15 = _vps_tokens_or_panic(r15)
    let t15_0: VpsToken = vec_get<VpsToken>(toks15, 0)
    let t15_1: VpsToken = vec_get<VpsToken>(toks15, 1)
    let t15_2: VpsToken = vec_get<VpsToken>(toks15, 2)
    let t15_3: VpsToken = vec_get<VpsToken>(toks15, 3)
    var c15_open = t15_0.tag == VpsTok.GroupOpen
    var c15_lit = t15_1.tag == VpsTok.Literal
    var c15_close = t15_2.tag == VpsTok.GroupClose
    var c15_eof = t15_3.tag == VpsTok.Eof
    if c15_open & c15_lit & c15_close & c15_eof do print(1) else print(0) end

    # Test 16: :( A | B :)
    var r16 = vps_tokenize(":( A | B :)")
    var toks16 = _vps_tokens_or_panic(r16)
    let t16_pipe: VpsToken = vec_get<VpsToken>(toks16, 2)
    if t16_pipe.tag == VpsTok.Pipe do print(1) else print(0) end

    # Test 17: | @0!3 |
    var r17 = vps_tokenize("| @0!3 |")
    var toks17 = _vps_tokens_or_panic(r17)
    let t17_start: VpsToken = vec_get<VpsToken>(toks17, 0)
    let t17_end: VpsToken = vec_get<VpsToken>(toks17, 3)
    if t17_start.tag == VpsTok.Pipe & t17_end.tag == VpsTok.Pipe do print(1) else print(0) end

    # -------------------------------------------------------
    # 4. Lexer Escapes (4 tests)
    # -------------------------------------------------------
    # Test 18: $-
    var r18 = vps_tokenize("$-")
    var toks18 = _vps_tokens_or_panic(r18)
    let t18: VpsToken = vec_get<VpsToken>(toks18, 0)
    if t18.tag == VpsTok.EscapeChar & str_eq(t18.value, "-") do print(1) else print(0) end

    # Test 19: $|
    var r19 = vps_tokenize("$|")
    var toks19 = _vps_tokens_or_panic(r19)
    let t19: VpsToken = vec_get<VpsToken>(toks19, 0)
    if t19.tag == VpsTok.EscapeChar & str_eq(t19.value, "|") do print(1) else print(0) end

    # Test 20: $. |@!~ .$
    var r20 = vps_tokenize("$. |@!~ .$")
    var toks20 = _vps_tokens_or_panic(r20)
    let t20: VpsToken = vec_get<VpsToken>(toks20, 0)
    if t20.tag == VpsTok.EscapeBlock & str_eq(t20.value, " |@!~ ") do print(1) else print(0) end

    # Test 21: $. hello (unterminated block escape)
    var r21 = vps_tokenize("$. hello")
    if is_err(r21) do print(1) else print(0) end

    # -------------------------------------------------------
    # 5. Lexer Space and Literals (5 tests)
    # -------------------------------------------------------
    # Test 22: -
    var r22 = vps_tokenize("-")
    var toks22 = _vps_tokens_or_panic(r22)
    let t22: VpsToken = vec_get<VpsToken>(toks22, 0)
    if t22.tag == VpsTok.SpaceToken do print(1) else print(0) end

    # Test 23: ABC
    var r23 = vps_tokenize("ABC")
    var toks23 = _vps_tokens_or_panic(r23)
    let t23_0: VpsToken = vec_get<VpsToken>(toks23, 0)
    let t23_1: VpsToken = vec_get<VpsToken>(toks23, 1)
    let t23_2: VpsToken = vec_get<VpsToken>(toks23, 2)
    if str_eq(t23_0.value, "A") & str_eq(t23_1.value, "B") & str_eq(t23_2.value, "C") do print(1) else print(0) end

    # Test 24: ?@0
    var r24 = vps_tokenize("?@0")
    var toks24 = _vps_tokens_or_panic(r24)
    let t24_0: VpsToken = vec_get<VpsToken>(toks24, 0)
    let t24_1: VpsToken = vec_get<VpsToken>(toks24, 1)
    if t24_0.tag == VpsTok.Question & t24_1.tag == VpsTok.Atom do print(1) else print(0) end

    # Test 25: whitespace ignored
    var r25_a = vps_tokenize("@0!3")
    var r25_b = vps_tokenize("@0 !3")
    var toks25_a = _vps_tokens_or_panic(r25_a)
    var toks25_b = _vps_tokens_or_panic(r25_b)
    if vec_len<VpsToken>(toks25_a) == vec_len<VpsToken>(toks25_b) do print(1) else print(0) end

    # Test 26: Full ID pattern tokens: | @AZ!2 $- @0!5 $? |
    var r26 = vps_tokenize("| @AZ!2 $- @0!5 $? |")
    var toks26 = _vps_tokens_or_panic(r26)
    let t26_first: VpsToken = vec_get<VpsToken>(toks26, 0)
    let t26_last: VpsToken = vec_get<VpsToken>(toks26, 7)
    if t26_first.tag == VpsTok.Pipe & t26_last.tag == VpsTok.Pipe do print(1) else print(0) end

    # -------------------------------------------------------
    # 6. Parser Anchors (4 tests)
    # -------------------------------------------------------
    # Test 27: Both anchors: | @0!3 |
    var p27 = virgex_compile("| @0!3 |")
    var m27_1 = p27.match("123")
    var m27_2 = !p27.match("12")
    var m27_3 = !p27.match("1234")
    if m27_1 & m27_2 & m27_3 do print(1) else print(0) end

    # Test 28: Start anchor only: | @0!3
    var p28 = virgex_compile("| @0!3")
    var m28_1 = p28.match("123")
    var f28_1 = p28.find("123abc")
    var f28_2 = p28.find("a123")
    if m28_1 & str_eq(f28_1, "123") & str_byte_len(f28_2) == 0 do print(1) else print(0) end

    # Test 29: End anchor only: @0!3 |
    var p29 = virgex_compile("@0!3 |")
    var m29_1 = p29.match("123")
    var f29_1 = p29.find("abc123")
    var f29_2 = p29.find("123a")
    if m29_1 & str_eq(f29_1, "123") & str_byte_len(f29_2) == 0 do print(1) else print(0) end

    # Test 30: No anchors: @0!3
    var p30 = virgex_compile("@0!3")
    var f30 = p30.find("abc123def")
    if str_eq(f30, "123") do print(1) else print(0) end

    # -------------------------------------------------------
    # 7. Parser Atoms & Quantifiers (4 tests)
    # -------------------------------------------------------
    # Test 31: Single atom: @AZ
    var p31 = virgex_compile("| @AZ |")
    if p31.match("A") & p31.match("Z") & !p31.match("a") & !p31.match("1") do print(1) else print(0) end

    # Test 32: Atom quantified: @0!3
    var p32 = virgex_compile("| @0!3 |")
    if p32.match("999") & !p32.match("99") & !p32.match("9999") do print(1) else print(0) end

    # Test 33: Range quantifier: @Az!1~5
    var p33 = virgex_compile("| @Az!1~5 |")
    if p33.match("a") & p33.match("abcde") & !p33.match("") & !p33.match("abcdef") do print(1) else print(0) end

    # Test 34: Unbounded quantifier: @0!2~
    var p34 = virgex_compile("| @0!2~ |")
    if !p34.match("1") & p34.match("12") & p34.match("123456") do print(1) else print(0) end

    # -------------------------------------------------------
    # 8. Parser Optional (3 tests)
    # -------------------------------------------------------
    # Test 35: Optional atom: ?@0
    var p35 = virgex_compile("| ?@0 |")
    if p35.match("") & p35.match("5") & !p35.match("a") & !p35.match("55") do print(1) else print(0) end

    # Test 36: Optional quantified: ?@AZ!2
    var p36 = virgex_compile("| ?@AZ!2 |")
    if p36.match("") & p36.match("HN") & !p36.match("H") & !p36.match("HNA") do print(1) else print(0) end

    # Test 37: Optional group: ?:( $- @0!5 :)
    var p37 = virgex_compile("| ?:( $- @0!5 :) |")
    if p37.match("") & p37.match("-12345") & !p37.match("-") & !p37.match("-123") do print(1) else print(0) end

    # -------------------------------------------------------
    # 9. Parser Groups & Alternation (5 tests)
    # -------------------------------------------------------
    # Test 38: Simple group: :( - @0 :)
    var p38 = virgex_compile("| :( - @0 :) |")
    if p38.match(" 5") & !p38.match("5") & !p38.match("  5") do print(1) else print(0) end

    # Test 39: Alternation: :( A | B :)
    var p39 = virgex_compile("| :( A | B :) |")
    if p39.match("A") & p39.match("B") & !p39.match("C") do print(1) else print(0) end

    # Test 40: Multi-alternation: :( A | B | C :)
    var p40 = virgex_compile("| :( A | B | C :) |")
    if p40.match("A") & p40.match("B") & p40.match("C") & !p40.match("D") do print(1) else print(0) end

    # Test 41: Group quantified: :( - @0 :)!3
    var p41 = virgex_compile("| :( - @0 :)!3 |")
    if p41.match(" 1 2 3") & !p41.match(" 1 2") & !p41.match(" 1 2 3 4") do print(1) else print(0) end

    # Test 42: Nested group: :( A | :( B | C :) :)
    var p42 = virgex_compile("| :( A | :( B | C :) :) |")
    if p42.match("A") & p42.match("B") & p42.match("C") & !p42.match("D") do print(1) else print(0) end

    # -------------------------------------------------------
    # 10. Parser Literals & Escapes (3 tests)
    # -------------------------------------------------------
    # Test 43: Literal string: ABC
    var p43 = virgex_compile("| ABC |")
    if p43.match("ABC") & !p43.match("AB") & !p43.match("ABCD") do print(1) else print(0) end

    # Test 44: Escaped char: $-
    var p44 = virgex_compile("| $- |")
    if p44.match("-") & !p44.match(" ") do print(1) else print(0) end

    # Test 45: Space token: -
    var p45 = virgex_compile("| - |")
    if p45.match(" ") & !p45.match("-") do print(1) else print(0) end

    # -------------------------------------------------------
    # 11. Complex Parser Patterns (2 tests)
    # -------------------------------------------------------
    # Test 46: ID pattern: | @AZ!2 $- @0!5 $? |
    var p46 = virgex_compile("| @AZ!2 $- @0!5 $? |")
    if p46.match("HN-12345?") & !p46.match("HN-12345") & !p46.match("hn-12345?") do print(1) else print(0) end

    # Test 47: Optional suffix: | @AZ!2 ?:( $- @0!5 :) |
    var p47 = virgex_compile("| @AZ!2 ?:( $- @0!5 :) |")
    if p47.match("HN") & p47.match("HN-12345") & !p47.match("HN-123") do print(1) else print(0) end

    # -------------------------------------------------------
    # 12. Error Handling (3 tests)
    # -------------------------------------------------------
    # Test 48: Unterminated group
    var r48 = vps_tokenize(":( abc")
    if is_err(r48) do print(1) else print(0) end

    # Test 49: Invalid quantifier range (max < min)
    var r49 = vps_tokenize("@0!5~3")
    if is_err(r49) do print(1) else print(0) end

    # Test 50: Unterminated escape block
    var r50 = vps_tokenize("$.abc")
    if is_err(r50) do print(1) else print(0) end
end.
