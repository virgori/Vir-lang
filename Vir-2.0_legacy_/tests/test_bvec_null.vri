func main:
    let b: bvec; # Initialized to 0 (null)
    # The length of a null bvec should be 0, and should not crash
    let n = bvec_len(b)
    if n != 0 do
        print_str("FAIL: bvec_len on null")
        out 1
    end

    # Pushing to a null bvec should allocate it
    b = bvec_push(b, 42)
    if bvec_len(b) != 1 do
        print_str("FAIL: bvec_push on null failed to set length")
        out 1
    end
    print_str("OK")
    out 0
end.
