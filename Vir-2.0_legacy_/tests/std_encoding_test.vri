include vir.encoding.base64
include vir.encoding.hex

extern func native_read_u8(addr: int, offset: int) -> int

func test_str_eq(a: string, b: string) -> bool:
    let pa = a as int
    let pb = b as int
    if pa == pb do out true end
    if pa == 0 or pb == 0 do out false end
    var i = 0
    loop
        let ca = native_read_u8(pa, i)
        let cb = native_read_u8(pb, i)
        if ca != cb do out false end
        if ca == 0 do out true end
        i = i + 1
    end
    out true
end.

func main:
    # 1. Base64 RFC 4648 standard encode vectors
    let e1 = base64_encode("f")
    let e2 = base64_encode("fo")
    let e3 = base64_encode("foo")
    let e4 = base64_encode("foobar")
    if test_str_eq(e1, "Zg==") and test_str_eq(e2, "Zm8=") and test_str_eq(e3, "Zm9v") and test_str_eq(e4, "Zm9vYmFy") do
        print 1
    end

    # 2. Base64 decode vectors
    let r_d1 = base64_decode("Zg==")
    let r_d2 = base64_decode("Zm8=")
    let r_d3 = base64_decode("Zm9v")
    let r_d4 = base64_decode("Zm9vYmFy")
    case r_d1
        Ok(s1):
            if test_str_eq(s1, "f") do
                case r_d2
                    Ok(s2):
                        if test_str_eq(s2, "fo") do
                            case r_d3
                                Ok(s3):
                                    if test_str_eq(s3, "foo") do
                                        case r_d4
                                            Ok(s4):
                                                if test_str_eq(s4, "foobar") do print 2 end
                                            Err(_): print 0
                                        end
                                    end
                                Err(_): print 0
                            end
                        end
                    Err(_): print 0
                end
            end
        Err(_): print 0
    end

    # 3. Base64 URL-safe encoding & decoding
    # "\xfb\xff" in standard is "+/8=" -> in url-safe is "-_8"
    let raw_buf = vir_alloc(3)
    native_write_u8(raw_buf, 0, 251) # 0xFB
    native_write_u8(raw_buf, 1, 255) # 0xFF
    native_write_u8(raw_buf, 2, 0)
    let url_enc = base64_url_encode(raw_buf as string)
    if test_str_eq(url_enc, "-_8") do
        let r_urldec = base64_url_decode("-_8")
        case r_urldec
            Ok(dec_str):
                let dp = dec_str as int
                if native_read_u8(dp, 0) == 251 and native_read_u8(dp, 1) == 255 do
                    print 3
                end
            Err(_): print 0
        end
    end

    # 4. Base64 strict errors
    let r_bad_char = base64_decode("Zm9!YmFy")
    case r_bad_char
        Ok(_): print 0
        Err(_): print 4
    end

    let r_bad_len = base64_decode("Zm9vY")
    case r_bad_len
        Ok(_): print 0
        Err(_): print 5
    end

    # 5. Hex encoding
    let h1 = hex_encode("hello")
    let h2 = hex_encode_upper("hello")
    if test_str_eq(h1, "68656c6c6f") and test_str_eq(h2, "68656C6C6F") do
        print 6
    end

    # 6. Hex decoding (both lowercase and uppercase)
    let r_hdec1 = hex_decode("68656c6c6f")
    let r_hdec2 = hex_decode("68656C6C6F")
    case r_hdec1
        Ok(s1):
            if test_str_eq(s1, "hello") do
                case r_hdec2
                    Ok(s2):
                        if test_str_eq(s2, "hello") do print 7 end
                    Err(_): print 0
                end
            end
        Err(_): print 0
    end

    # 7. Hex strict errors
    let r_hex_odd = hex_decode("68656c6c6")
    case r_hex_odd
        Ok(_): print 0
        Err(_): print 8
    end

    let r_hex_bad = hex_decode("68656c6c6g")
    case r_hex_bad
        Ok(_): print 0
        Err(_): print 9
    end

    print 999
    out 0
end.
