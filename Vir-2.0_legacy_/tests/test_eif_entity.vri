var total_errors = 0

entity Config:
    verbose: int
end.
func process(cfg: Config, input: int) -> int:
    var result = 0
    if input > 100 do
        result = input - 100
    eif input > 50 do
        result = input - 50
    eif input > 0 do
        result = input
    else
        result = 0
        total_errors = total_errors + 1
    end
    out result
end
func main:
    var cfg = Config( verbose: 1 )
    var r1 = process(cfg, 200)
    print r1
    var r2 = process(cfg, 75)
    print r2
    var r3 = process(cfg, 30)
    print r3
    var r4 = process(cfg, 0)
    print r4
    print total_errors
end
