# Test: Viron CLI Package Manager Router, SemVer & DAG Engine (Spec §9, stdlib/vir/viron)

func cstr_len(s):
    if s == 0 do out 0 end
    var i = 0
    when read_byte(s, i) != 0 loop
        i = i + 1
    end
    out i
end.

func cstr_eq(a, b):
    if a == 0 and b == 0 do out 1 end
    if a == 0 or b == 0 do out 0 end
    let la = cstr_len(a)
    let lb = cstr_len(b)
    if la != lb do out 0 end
    var i = 0
    when i < la loop
        if read_byte(a, i) != read_byte(b, i) do
            out 0
        end
        i = i + 1
    end
    out 1
end.

func append_cstr(dst, dst_idx, src):
    let sl = cstr_len(src)
    var i = 0
    when i < sl loop
        write_byte(dst, dst_idx, read_byte(src, i))
        dst_idx = dst_idx + 1
        i = i + 1
    end
    write_byte(dst, dst_idx, 0)
    out dst_idx
end.

func semver_create:
    let sv = alloc(24)
    write_word(sv, 0, 0)
    write_word(sv, 8, 0)
    write_word(sv, 16, 0)
    out sv
end.

func semver_parse(src, sv):
    let slen = cstr_len(src)
    var p = 0

    var maj = 0
    when (p < slen) and (read_byte(src, p) >= 48) and (read_byte(src, p) <= 57) loop
        maj = maj * 10 + (read_byte(src, p) - 48)
        p = p + 1
    end
    write_word(sv, 0, maj)

    if p >= slen do out 0 end
    if read_byte(src, p) != 46 do out 0 end
    p = p + 1

    var min = 0
    when (p < slen) and (read_byte(src, p) >= 48) and (read_byte(src, p) <= 57) loop
        min = min * 10 + (read_byte(src, p) - 48)
        p = p + 1
    end
    write_word(sv, 8, min)

    if p >= slen do out 0 end
    if read_byte(src, p) != 46 do out 0 end
    p = p + 1

    var pat = 0
    when (p < slen) and (read_byte(src, p) >= 48) and (read_byte(src, p) <= 57) loop
        pat = pat * 10 + (read_byte(src, p) - 48)
        p = p + 1
    end
    write_word(sv, 16, pat)

    out 1
end.

func semver_cmp(a, b):
    let maj_a = read_word(a, 0)
    let maj_b = read_word(b, 0)
    if maj_a > maj_b do out 1 end
    if maj_a < maj_b do out 0 - 1 end

    let min_a = read_word(a, 8)
    let min_b = read_word(b, 8)
    if min_a > min_b do out 1 end
    if min_a < min_b do out 0 - 1 end

    let pat_a = read_word(a, 16)
    let pat_b = read_word(b, 16)
    if pat_a > pat_b do out 1 end
    if pat_a < pat_b do out 0 - 1 end

    out 0
end.

func semver_satisfies_caret(ver, base):
    let maj_v = read_word(ver, 0)
    let maj_b = read_word(base, 0)
    if maj_v != maj_b do out 0 end
    if semver_cmp(ver, base) >= 0 do
        out 1
    end
    out 0
end.

func pkg_create(name, version, deps_array, dep_count):
    let p = alloc(40)
    write_word(p, 0, name)
    write_word(p, 8, version)
    write_word(p, 16, dep_count)
    write_word(p, 24, deps_array)
    write_word(p, 32, 0)
    out p
end.

func topo_sort_visit(pkgs, node_idx, out_order, order_idx):
    let node = read_word(pkgs, node_idx * 8)
    let status = read_word(node, 32)
    if status == 2 do
        out order_idx
    end
    if status == 1 do
        out 0 - 1
    end

    write_word(node, 32, 1)

    let dep_cnt = read_word(node, 16)
    let deps = read_word(node, 24)
    var i = 0
    when i < dep_cnt loop
        let dep_idx = read_word(deps, i * 8)
        order_idx = topo_sort_visit(pkgs, dep_idx, out_order, order_idx)
        if order_idx < 0 do
            out 0 - 1
        end
        i = i + 1
    end

    write_word(node, 32, 2)
    write_word(out_order, order_idx * 8, node_idx)
    out order_idx + 1
end.

func assert(cond):
    if cond == 0 do
        exit_prog(1)
    end
end.

func main:
    # 1. Test SemVer matching
    let v_base = semver_create()
    let v_curr = semver_create()
    let v_next = semver_create()

    assert(semver_parse("1.2.3", v_base) == 1)
    assert(read_word(v_base, 0) == 1)
    assert(read_word(v_base, 8) == 2)
    assert(read_word(v_base, 16) == 3)

    assert(semver_parse("1.4.0", v_curr) == 1)
    assert(semver_parse("2.0.0", v_next) == 1)

    assert(semver_cmp(v_curr, v_base) > 0)
    assert(semver_satisfies_caret(v_curr, v_base) == 1)
    assert(semver_satisfies_caret(v_next, v_base) == 0)

    # 2. Test Package DAG Resolution
    let pkgs = alloc(3 * 8)
    write_word(pkgs, 0 * 8, pkg_create("lib_core", "1.0.0", 0, 0))

    let d1 = alloc(1 * 8)
    write_word(d1, 0, 0)
    write_word(pkgs, 1 * 8, pkg_create("lib_http", "1.1.0", d1, 1))

    let d2 = alloc(1 * 8)
    write_word(d2, 0, 1)
    write_word(pkgs, 2 * 8, pkg_create("my_service", "0.1.0", d2, 1))

    let order = alloc(3 * 8)
    var res_cnt = 0
    var k = 0
    when k < 3 loop
        res_cnt = topo_sort_visit(pkgs, k, order, res_cnt)
        k = k + 1
    end

    assert(res_cnt == 3)
    assert(read_word(order, 0 * 8) == 0) # lib_core built first
    assert(read_word(order, 1 * 8) == 1) # lib_http built second
    assert(read_word(order, 2 * 8) == 2) # my_service built third

    out 0
end.
