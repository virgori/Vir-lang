# Test: WebAssembly (WASM) LEB128 & Bytecode Instruction Encoding Engine (Spec §9, stdlib/vir/compiler/codegen_wasm)

# WASM Type Constants:
# i32 = 0x7F, i64 = 0x7E, f32 = 0x7D, f64 = 0x7C, functype = 0x60

# WASM Opcodes:
# 0x20 = local.get, 0x21 = local.set, 0x41 = i32.const, 0x42 = i64.const
# 0x6A = i32.add, 0x6B = i32.sub, 0x6C = i32.mul, 0x6D = i32.div_s
# 0x0B = end, 0x0F = return, 0x10 = call

func wasm_emit_uleb128(buf, pos, val):
    var v = val
    var done = 0
    when done == 0 loop
        var b = v bit_and 0x7F
        v = v shr 7
        if v != 0 do
            b = b bit_or 0x80
            write_byte(buf, pos, b)
            pos = pos + 1
        else
            write_byte(buf, pos, b)
            pos = pos + 1
            done = 1
        end
    end
    out pos
end.

func wasm_emit_sleb128(buf, pos, val):
    var v = val
    var done = 0
    when done == 0 loop
        var b = v bit_and 0x7F
        v = v shr 7
        let sign_bit = (b bit_and 0x40) != 0
        if ((v == 0) and (sign_bit == 0)) or ((v == (0 - 1)) and (sign_bit == 1)) do
            write_byte(buf, pos, b)
            pos = pos + 1
            done = 1
        else
            b = b bit_or 0x80
            write_byte(buf, pos, b)
            pos = pos + 1
        end
    end
    out pos
end.

func wasm_emit_i32_const(buf, pos, val):
    write_byte(buf, pos, 0x41) # i32.const
    out wasm_emit_sleb128(buf, pos + 1, val)
end.

func wasm_emit_local_get(buf, pos, idx):
    write_byte(buf, pos, 0x20) # local.get
    out wasm_emit_uleb128(buf, pos + 1, idx)
end.

func wasm_emit_local_set(buf, pos, idx):
    write_byte(buf, pos, 0x21) # local.set
    out wasm_emit_uleb128(buf, pos + 1, idx)
end.

func wasm_emit_i32_add(buf, pos):
    write_byte(buf, pos, 0x6A) # i32.add
    out pos + 1
end.

func wasm_emit_end(buf, pos):
    write_byte(buf, pos, 0x0B) # end
    out pos + 1
end.

func assert(cond):
    if cond == 0 do
        exit_prog(1)
    end
end.

func main:
    let buf = alloc(256)

    # 1. ULEB128 tests
    # 0 -> [0x00]
    var p = wasm_emit_uleb128(buf, 0, 0)
    assert(p == 1)
    assert(read_byte(buf, 0) == 0x00)

    # 127 -> [0x7F]
    p = wasm_emit_uleb128(buf, 0, 127)
    assert(p == 1)
    assert(read_byte(buf, 0) == 0x7F)

    # 128 -> [0x80, 0x01]
    p = wasm_emit_uleb128(buf, 0, 128)
    assert(p == 2)
    assert(read_byte(buf, 0) == 0x80)
    assert(read_byte(buf, 1) == 0x01)

    # 624485 -> [0xE5, 0x8E, 0x26]
    p = wasm_emit_uleb128(buf, 0, 624485)
    assert(p == 3)
    assert(read_byte(buf, 0) == 0xE5)
    assert(read_byte(buf, 1) == 0x8E)
    assert(read_byte(buf, 2) == 0x26)

    # 2. SLEB128 tests
    # 0 -> [0x00]
    p = wasm_emit_sleb128(buf, 0, 0)
    assert(p == 1)
    assert(read_byte(buf, 0) == 0x00)

    # 42 -> [0x2A]
    p = wasm_emit_sleb128(buf, 0, 42)
    assert(p == 1)
    assert(read_byte(buf, 0) == 0x2A)

    # -1 -> [0x7F]
    p = wasm_emit_sleb128(buf, 0, 0 - 1)
    assert(p == 1)
    assert(read_byte(buf, 0) == 0x7F)

    # -64 -> [0x40]
    p = wasm_emit_sleb128(buf, 0, 0 - 64)
    assert(p == 1)
    assert(read_byte(buf, 0) == 0x40)

    # 3. WASM Bytecode Sequence:
    # local.get 0 (20 00)
    # local.get 1 (20 01)
    # i32.add     (6A)
    # end         (0B)
    p = 0
    p = wasm_emit_local_get(buf, p, 0)
    assert(p == 2)
    assert(read_byte(buf, 0) == 0x20)
    assert(read_byte(buf, 1) == 0x00)

    p = wasm_emit_local_get(buf, p, 1)
    assert(p == 4)
    assert(read_byte(buf, 2) == 0x20)
    assert(read_byte(buf, 3) == 0x01)

    p = wasm_emit_i32_add(buf, p)
    assert(p == 5)
    assert(read_byte(buf, 4) == 0x6A)

    p = wasm_emit_end(buf, p)
    assert(p == 6)
    assert(read_byte(buf, 5) == 0x0B)

    out 0
end.
