# Phase C4: Test std/collections/btree — Binary Search Tree with In-Order Traversal (Spec §9, stdlib/vir/collections)

# Node layout at ptr:
# word 0: key (i64)
# word 8: left child ptr (i64, 0 if none)
# word 16: right child ptr (i64, 0 if none)

func bst_node_new(key):
    let n = alloc(24)
    write_word(n, 0, key)
    write_word(n, 8, 0)
    write_word(n, 16, 0)
    out n
end.

func bst_insert(root, key):
    if root == 0 do
        out bst_node_new(key)
    end
    let cur_key = read_word(root, 0)
    if key < cur_key do
        let left = read_word(root, 8)
        write_word(root, 8, bst_insert(left, key))
    else
        if key > cur_key do
            let right = read_word(root, 16)
            write_word(root, 16, bst_insert(right, key))
        end
    end
    out root
end.

func bst_search(root, key):
    if root == 0 do out 0 end
    let cur_key = read_word(root, 0)
    if key == cur_key do out 1 end
    if key < cur_key do
        out bst_search(read_word(root, 8), key)
    end
    out bst_search(read_word(root, 16), key)
end.

func bst_min(root):
    if root == 0 do out 0 - 1 end
    var cur = root
    when read_word(cur, 8) != 0 loop
        cur = read_word(cur, 8)
    end
    out read_word(cur, 0)
end.

func bst_max(root):
    if root == 0 do out 0 - 1 end
    var cur = root
    when read_word(cur, 16) != 0 loop
        cur = read_word(cur, 16)
    end
    out read_word(cur, 0)
end.

func bst_count(root):
    if root == 0 do out 0 end
    let l_cnt = bst_count(read_word(root, 8))
    let r_cnt = bst_count(read_word(root, 16))
    out 1 + l_cnt + r_cnt
end.

func bst_height(root):
    if root == 0 do out 0 end
    let lh = bst_height(read_word(root, 8))
    let rh = bst_height(read_word(root, 16))
    if lh > rh do
        out 1 + lh
    end
    out 1 + rh
end.

# In-order traversal: stores keys into arr at [idx_box], increments *idx_box
func bst_inorder(root, arr, idx_box):
    if root == 0 do out end
    bst_inorder(read_word(root, 8), arr, idx_box)
    let idx = read_word(idx_box, 0)
    write_word(arr, idx * 8, read_word(root, 0))
    write_word(idx_box, 0, idx + 1)
    bst_inorder(read_word(root, 16), arr, idx_box)
end.

func assert(cond):
    if cond == 0 do
        exit_prog(1)
    end
end.

func main:
    var root = 0
    assert(bst_count(root) == 0)
    assert(bst_height(root) == 0)
    assert(bst_search(root, 50) == 0)
    assert(bst_min(root) == (0 - 1))
    assert(bst_max(root) == (0 - 1))

    # Insert sequence
    root = bst_insert(root, 50)
    root = bst_insert(root, 30)
    root = bst_insert(root, 70)
    root = bst_insert(root, 20)
    root = bst_insert(root, 40)
    root = bst_insert(root, 60)
    root = bst_insert(root, 80)
    root = bst_insert(root, 10)
    root = bst_insert(root, 25)
    root = bst_insert(root, 35)
    root = bst_insert(root, 65)

    assert(bst_count(root) == 11)
    assert(bst_height(root) == 4)
    assert(bst_min(root) == 10)
    assert(bst_max(root) == 80)

    # Search tests
    assert(bst_search(root, 50) == 1)
    assert(bst_search(root, 30) == 1)
    assert(bst_search(root, 70) == 1)
    assert(bst_search(root, 10) == 1)
    assert(bst_search(root, 25) == 1)
    assert(bst_search(root, 65) == 1)
    assert(bst_search(root, 80) == 1)

    # Non-existent search tests
    assert(bst_search(root, 5) == 0)
    assert(bst_search(root, 45) == 0)
    assert(bst_search(root, 99) == 0)
    assert(bst_search(root, 0) == 0)

    # In-order traversal output validation (must be sorted)
    let out_arr = alloc(16 * 8)
    let idx_box = alloc(8)
    write_word(idx_box, 0, 0)

    bst_inorder(root, out_arr, idx_box)
    assert(read_word(idx_box, 0) == 11)

    assert(read_word(out_arr, 0 * 8) == 10)
    assert(read_word(out_arr, 1 * 8) == 20)
    assert(read_word(out_arr, 2 * 8) == 25)
    assert(read_word(out_arr, 3 * 8) == 30)
    assert(read_word(out_arr, 4 * 8) == 35)
    assert(read_word(out_arr, 5 * 8) == 40)
    assert(read_word(out_arr, 6 * 8) == 50)
    assert(read_word(out_arr, 7 * 8) == 60)
    assert(read_word(out_arr, 8 * 8) == 65)
    assert(read_word(out_arr, 9 * 8) == 70)
    assert(read_word(out_arr, 10 * 8) == 80)

    out 0
end.
