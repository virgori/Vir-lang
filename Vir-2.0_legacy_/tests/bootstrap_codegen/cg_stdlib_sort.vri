# Phase B4: Test std/sort — Introsort + Binary Search (Spec §9, stdlib/vir/sort)

# Insertion sort for small arrays (base of introsort)
func insertion_sort(arr, n):
    var i = 1
    when i < n loop
        let key = read_word(arr, i * 8)
        var j = i - 1
        when (j >= 0) and (read_word(arr, j * 8) > key) loop
            write_word(arr, (j + 1) * 8, read_word(arr, j * 8))
            j = j - 1
        end
        write_word(arr, (j + 1) * 8, key)
        i = i + 1
    end
end.

# Partition for quicksort
func partition(arr, lo, hi):
    let pivot = read_word(arr, hi * 8)
    var i = lo - 1
    var j = lo
    when j < hi loop
        if read_word(arr, j * 8) <= pivot do
            i = i + 1
            let tmp = read_word(arr, i * 8)
            write_word(arr, i * 8, read_word(arr, j * 8))
            write_word(arr, j * 8, tmp)
        end
        j = j + 1
    end
    let tmp2 = read_word(arr, (i + 1) * 8)
    write_word(arr, (i + 1) * 8, read_word(arr, hi * 8))
    write_word(arr, hi * 8, tmp2)
    out i + 1
end.

func quicksort(arr, lo, hi):
    if lo >= hi do out end
    if (hi - lo) < 10 do
        # Inline insertion sort for small subarrays
        var ii = lo + 1
        when ii <= hi loop
            let key = read_word(arr, ii * 8)
            var jj = ii - 1
            when (jj >= lo) and (read_word(arr, jj * 8) > key) loop
                write_word(arr, (jj + 1) * 8, read_word(arr, jj * 8))
                jj = jj - 1
            end
            write_word(arr, (jj + 1) * 8, key)
            ii = ii + 1
        end
        out
    end
    let p = partition(arr, lo, hi)
    quicksort(arr, lo, p - 1)
    quicksort(arr, p + 1, hi)
end.

func is_sorted_arr(arr, n):
    if n <= 1 do out 1 end
    var i = 0
    when i < n - 1 loop
        if read_word(arr, i * 8) > read_word(arr, (i + 1) * 8) do out 0 end
        i = i + 1
    end
    out 1
end.

func binary_search_arr(arr, n, target):
    var lo = 0
    var hi = n - 1
    when lo <= hi loop
        let mid = lo + (hi - lo) / 2
        let v = read_word(arr, mid * 8)
        if v == target do out mid end
        if v < target do
            lo = mid + 1
        else
            if mid == 0 do out (0 - 1) end
            hi = mid - 1
        end
    end
    out (0 - 1)
end.

func main:
    # 1. Empty / single element
    let arr1 = alloc(1 * 8)
    write_word(arr1, 0, 42)
    insertion_sort(arr1, 1)
    if read_word(arr1, 0) != 42 do out 1 end

    # 2. Already sorted
    let arr2 = alloc(5 * 8)
    write_word(arr2, 0 * 8, 10)
    write_word(arr2, 1 * 8, 20)
    write_word(arr2, 2 * 8, 30)
    write_word(arr2, 3 * 8, 40)
    write_word(arr2, 4 * 8, 50)
    insertion_sort(arr2, 5)
    if is_sorted_arr(arr2, 5) != 1 do out 2 end

    # 3. Reverse sorted -> insertion_sort
    let arr3 = alloc(5 * 8)
    write_word(arr3, 0 * 8, 50)
    write_word(arr3, 1 * 8, 40)
    write_word(arr3, 2 * 8, 30)
    write_word(arr3, 3 * 8, 20)
    write_word(arr3, 4 * 8, 10)
    insertion_sort(arr3, 5)
    if is_sorted_arr(arr3, 5) != 1 do out 3 end
    if read_word(arr3, 0) != 10 do out 4 end
    if read_word(arr3, 4 * 8) != 50 do out 5 end

    # 4. Random order (larger array) -> quicksort
    let n = 20
    let arr4 = alloc(n * 8)
    let seeds = [97, 31, 83, 7, 61, 53, 11, 73, 43, 19, 89, 37, 67, 5, 79, 23, 71, 41, 59, 13]
    var si = 0
    when si < n loop
        write_word(arr4, si * 8, seeds[si])
        si = si + 1
    end
    quicksort(arr4, 0, n - 1)
    if is_sorted_arr(arr4, n) != 1 do out 6 end
    # First element should be 5, last 97
    if read_word(arr4, 0) != 5 do out 7 end
    if read_word(arr4, (n - 1) * 8) != 97 do out 8 end

    # 5. Duplicates
    let arr5 = alloc(6 * 8)
    write_word(arr5, 0 * 8, 5)
    write_word(arr5, 1 * 8, 3)
    write_word(arr5, 2 * 8, 5)
    write_word(arr5, 3 * 8, 1)
    write_word(arr5, 4 * 8, 3)
    write_word(arr5, 5 * 8, 5)
    insertion_sort(arr5, 6)
    if is_sorted_arr(arr5, 6) != 1 do out 9 end

    # 6. Binary search — found
    let arr6 = alloc(7 * 8)
    write_word(arr6, 0 * 8, 2)
    write_word(arr6, 1 * 8, 5)
    write_word(arr6, 2 * 8, 11)
    write_word(arr6, 3 * 8, 17)
    write_word(arr6, 4 * 8, 23)
    write_word(arr6, 5 * 8, 31)
    write_word(arr6, 6 * 8, 37)
    let idx = binary_search_arr(arr6, 7, 17)
    if idx != 3 do out 10 end

    # 7. Binary search — not found
    let idx2 = binary_search_arr(arr6, 7, 99)
    if idx2 != (0 - 1) do out 11 end

    # 8. Binary search — first element
    let idx3 = binary_search_arr(arr6, 7, 2)
    if idx3 != 0 do out 12 end

    # 9. Binary search — last element
    let idx4 = binary_search_arr(arr6, 7, 37)
    if idx4 != 6 do out 13 end

    out 0
end.
