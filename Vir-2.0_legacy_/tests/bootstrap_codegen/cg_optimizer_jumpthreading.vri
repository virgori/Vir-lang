# Bootstrap Native Test: CFG Simplification & Jump Threading Pass
# ==============================================================================
# Spec §1.2.1 / Pillar 6 / Tier-5: Jump Threading redirects multi-hop jumps
# directly to their ultimate target block (Jump L1 -> L1: Jump L2 ==> Jump L2),
# removes empty trampoline blocks, and merges consecutive linear basic blocks.

func assert(cond):
    if cond == 0 do
        exit_prog(1)
    end
end.

# Multi-Hop Control Flow Function
func jump_thread_eval(mode, x):
    var res = 0
    if mode == 1 do
        # Trampoline path: jumps to intermediate then to target
        if x > 10 do
            res = x * 2
        else
            res = x + 100
        end
    else
        if x > 10 do
            res = x * 3
        else
            res = x + 200
        end
    end
    out res
end.

# Jump Threading Transformation Engine (Proof of Algorithm in Pure Vir)
# Table of 8 labels: label_target[i] = next_target
# Threading iterates until reaching a non-trampoline target
func jump_thread_resolve(jump_table, label_id):
    var curr = label_id
    var hops = 0
    when hops < 8 loop
        let next_tgt = read_word(jump_table, curr * 8)
        if next_tgt == curr or next_tgt == 0 - 1 do
            out curr # Reached ultimate target
        end
        curr = next_tgt
        hops = hops + 1
    end
    out curr
end.

func main:
    # TEST 1: Direct Execution of Multi-Hop Branching
    let r1 = jump_thread_eval(1, 15) # 15 * 2 = 30
    assert(r1 == 30)

    let r2 = jump_thread_eval(1, 5)  # 5 + 100 = 105
    assert(r2 == 105)

    let r3 = jump_thread_eval(2, 15) # 15 * 3 = 45
    assert(r3 == 45)

    let r4 = jump_thread_eval(2, 5)  # 5 + 200 = 205
    assert(r4 == 205)

    # TEST 2: Jump Threading Multi-Hop Chain Resolution
    # Chain: Label 0 -> Label 1 -> Label 2 -> Label 3 (Terminal: 3 -> -1)
    let tbl = alloc(8 * 8)
    write_word(tbl, 0 * 8, 1) # L0 -> L1
    write_word(tbl, 1 * 8, 2) # L1 -> L2
    write_word(tbl, 2 * 8, 3) # L2 -> L3
    write_word(tbl, 3 * 8, 0 - 1) # L3 is terminal

    # Threading L0 should resolve directly to L3 in 1 lookup
    let final_target_0 = jump_thread_resolve(tbl, 0)
    assert(final_target_0 == 3)

    # Threading L1 should resolve directly to L3
    let final_target_1 = jump_thread_resolve(tbl, 1)
    assert(final_target_1 == 3)

    # Threading L3 directly returns L3
    let final_target_3 = jump_thread_resolve(tbl, 3)
    assert(final_target_3 == 3)

    out 0
end.
