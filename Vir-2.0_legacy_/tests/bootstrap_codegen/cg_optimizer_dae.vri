# Bootstrap Native Test: Dead Argument Elimination & Arg Promotion (DAE)
# ==============================================================================
# Spec §1.2.1 / Pillar 6 / Tier-6: DAE removes unused function parameters from
# ABI calling conventions, while Argument Promotion transforms aggregate pointer
# arguments (&Struct) into direct scalar register values (X0..X7).

func assert(cond):
    if cond == 0 do
        exit_prog(1)
    end
end.

# Function with Unused Parameters (a used, dead1 unused, b used, dead2 unused)
# DAE strips dead1 & dead2 from the calling ABI convention
func dae_callee_4args(a, dead1, b, dead2):
    out a * 10 + b
end.

# Argument Promoted Callee: receives scalar fields (px, py) directly in registers
func arg_promoted_dist_sq(px, py, qx, qy):
    let dx = px - qx
    let dy = py - qy
    out (dx * dx) + (dy * dy)
end.

# DAE Analysis Engine (Proof of Algorithm in Pure Vir)
# Parameter liveness bitmask: arg_mask has bit 1 if parameter is used, 0 if dead
func dae_filter_used_args(arg_count, usage_bitmask):
    var used_count = 0
    var i = 0
    when i < arg_count loop
        let bit = (usage_bitmask shr i) bit_and 1
        if bit == 1 do
            used_count = used_count + 1
        end
        i = i + 1
    end
    out used_count
end.

func main:
    # TEST 1: Execution with Dead Arguments
    # a = 5, dead1 = 999, b = 7, dead2 = 888 -> 5 * 10 + 7 = 57
    let r1 = dae_callee_4args(5, 999, 7, 888)
    assert(r1 == 57)

    # TEST 2: Argument Promoted Point Math (P=(10, 20), Q=(6, 17))
    # dx = 10 - 6 = 4 -> dx^2 = 16
    # dy = 20 - 17 = 3 -> dy^2 = 9
    # dist_sq = 16 + 9 = 25
    let d_sq = arg_promoted_dist_sq(10, 20, 6, 17)
    assert(d_sq == 25)

    # TEST 3: DAE Parameter Filter Verification
    # 4 args: [used, dead, used, dead] -> binary 0101 (5 decimal)
    let used = dae_filter_used_args(4, 5)
    assert(used == 2) # Exactly 2 arguments kept in ABI!

    out 0
end.
