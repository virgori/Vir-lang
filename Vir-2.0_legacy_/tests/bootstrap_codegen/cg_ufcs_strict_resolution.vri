# Strict Vir v2.0 UFCS resolution regression.
# Covers typed method identity, declaration-order independence, method/free
# priority, callable-field priority, free UFCS, chaining, and field access.
# EXPECT_START
# 11
# 22
# 15
# 36
# 10
# 47
# EXPECT_END

func score(this: int):
    out 900
end.

func callback(this: int, value: int):
    out 999
end.

func add_ten(value: int):
    out value + 10
end.

func triple(this: int):
    out this * 3
end.

func label(this: HasLabel):
    out this.label + 7
end.

func main:
    var left: Left = Left(value: 10)
    var right: Right = Right(value: 20)
    var handler: Handler = Handler(callback: add_ten)
    var labeled: HasLabel = HasLabel(label: 40)

    print(left.score())
    print(right.score())
    print(handler.callback(5))
    print(4.triple().triple())
    print(left.value)
    print(labeled.label())
    out 0
end.

entity Right:
    value: int

    method score:
        out this.value + 2
    end.
end.

entity Handler:
    callback: func(int) -> int
end.

entity HasLabel:
    label: int
end.

entity Left:
    value: int

    method score:
        out this.value + 1
    end.
end.
