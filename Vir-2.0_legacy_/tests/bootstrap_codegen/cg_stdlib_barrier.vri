# Phase E5: Test std/sync/barrier — Countdown Latch & Cyclic Barrier (Spec §9, stdlib/vir/sync)

# Countdown Latch layout at ptr:
# word 0: current_count (atomic)

func latch_create(count):
    let l = alloc(8)
    write_word(l, 0, count)
    out l
end.

func latch_get_count(l):
    out atomic_load(l)
end.

func latch_is_ready(l):
    if atomic_load(l) <= 0 do out 1 end
    out 0
end.

func latch_count_down(l):
    var done = 0
    var res = 0
    when done == 0 loop
        let cur = atomic_load(l)
        if cur <= 0 do
            done = 1
            res = 0
        else
            if atomic_cas(l, cur, cur - 1) == 1 do
                done = 1
                res = cur - 1
            end
        end
    end
    out res
end.

# Cyclic Barrier layout at ptr:
# word 0: parties (total participants)
# word 8: remaining (atomic)
# word 16: generation (atomic)

func barrier_create(parties):
    let b = alloc(24)
    write_word(b, 0, parties)
    write_word(b, 8, parties)
    write_word(b, 16, 0) # gen = 0
    out b
end.

func barrier_arrive(b):
    let parties = read_word(b, 0)
    let rem_ptr = b + 8
    let gen_ptr = b + 16

    let old_rem = atomic_add(rem_ptr, 0 - 1)
    if old_rem == 1 do
        # Last participant arrived: reset barrier for next cycle
        atomic_store(rem_ptr, parties)
        atomic_add(gen_ptr, 1) # Advance generation
        out 1 # Leader / last arrival
    end
    out 0 # Follower
end.

func barrier_generation(b):
    out atomic_load(b + 16)
end.

func assert(cond):
    if cond == 0 do
        exit_prog(1)
    end
end.

func main:
    # 1. Countdown Latch tests
    let latch = latch_create(3)
    assert(latch_get_count(latch) == 3)
    assert(latch_is_ready(latch) == 0)

    assert(latch_count_down(latch) == 2)
    assert(latch_get_count(latch) == 2)
    assert(latch_is_ready(latch) == 0)

    assert(latch_count_down(latch) == 1)
    assert(latch_get_count(latch) == 1)
    assert(latch_is_ready(latch) == 0)

    assert(latch_count_down(latch) == 0)
    assert(latch_get_count(latch) == 0)
    assert(latch_is_ready(latch) == 1)

    # Extra count down does not underflow
    assert(latch_count_down(latch) == 0)
    assert(latch_get_count(latch) == 0)
    assert(latch_is_ready(latch) == 1)

    # 2. Cyclic Barrier tests (3 parties)
    let bar = barrier_create(3)
    assert(barrier_generation(bar) == 0)

    # Cycle 1:
    assert(barrier_arrive(bar) == 0) # Party 1
    assert(barrier_generation(bar) == 0)

    assert(barrier_arrive(bar) == 0) # Party 2
    assert(barrier_generation(bar) == 0)

    assert(barrier_arrive(bar) == 1) # Party 3 -> completes cycle!
    assert(barrier_generation(bar) == 1)

    # Cycle 2 (reuses reset barrier):
    assert(barrier_arrive(bar) == 0)
    assert(barrier_arrive(bar) == 0)
    assert(barrier_arrive(bar) == 1) # completes cycle 2!
    assert(barrier_generation(bar) == 2)

    out 0
end.
