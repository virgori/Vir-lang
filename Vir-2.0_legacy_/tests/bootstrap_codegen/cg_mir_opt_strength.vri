func test_mod_pow2(v):
    out v mod 256
end.

func test_mul_pow2(v):
    out v * 64
end.

func test_div_pow2(v):
    out v / 16
end.

func main:
    let r1 = test_mod_pow2(300)
    let r2 = test_mul_pow2(10)
    let r3 = test_div_pow2(160)
    if r1 != 44 or r2 != 640 or r3 != 10 do
        exit_prog(1)
    end
    out 0
end.
