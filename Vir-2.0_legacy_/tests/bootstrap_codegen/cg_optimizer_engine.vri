# Test: Full Multi-Pass IR Optimizer Engine (Spec §10/§18, stdlib/vir/compiler/optimizer)
# Implements complete suite of optimization algorithms in pure Vir:
# 1. Constant Folding & Propagation (Algebraic identities: x+0, x*1, x*0, x^x, x&0)
# 2. Strength Reduction (Peephole: * 2^k -> << k, / 2^k -> >> k, % 2^k -> & mask)
# 3. Common Subexpression Elimination (CSE - Value Numbering)
# 4. Dead Code Elimination (DCE - Live variable analysis & unused store removal)
# 5. Loop-Invariant Code Motion (LICM - Preheader hoisting)
# 6. Loop Induction Variable Strength Reduction (IVSR - MUL in loop -> ADD chain)
# 7. Function Inlining (IPO - Small function inlining & parameter substitution)
# 8. Bounds Check Elimination (BCE - Static range propagation)
# 9. Escape Analysis (Heap to Stack/Arena Promotion)
# 10. Multi-Pass Pipeline Orchestrator (O1, O2, O3 Fixed-Point Driver)

func assert(cond):
    if cond == 0 do
        exit_prog(1)
    end
end.

# ═══════════════════════════════════════════════════════
# IR Data Structures (Word-based in memory)
# ═══════════════════════════════════════════════════════
# Opcode constants:
# 0=Nop, 1=Move, 2=Add, 3=Sub, 4=Mul, 5=Div, 6=Mod, 7=And, 8=Or, 9=Xor, 10=Shl, 11=Shr
# 20=CmpEq, 21=CmpLt, 30=Jump, 31=JumpIfNot, 32=Label, 33=Call, 35=Ret
# 50=Alloc, 51=StackAlloc, 52=BoundsCheck

# Instruction memory layout (6 words = 48 bytes):
# [0]: Opcode
# [8]: Dst (VReg ID)
# [16]: Src1_Kind (0=None, 1=VReg, 2=Imm)
# [24]: Src1_Val
# [32]: Src2_Kind (0=None, 1=VReg, 2=Imm)
# [40]: Src2_Val

func ir_instr_new(op, dst, s1_kind, s1_val, s2_kind, s2_val):
    let ins = alloc(48)
    write_word(ins, 0, op)
    write_word(ins, 8, dst)
    write_word(ins, 16, s1_kind)
    write_word(ins, 24, s1_val)
    write_word(ins, 32, s2_kind)
    write_word(ins, 40, s2_val)
    out ins
end.

func ir_get_op(ins): out read_word(ins, 0) end.
func ir_get_dst(ins): out read_word(ins, 8) end.
func ir_get_s1_kind(ins): out read_word(ins, 16) end.
func ir_get_s1_val(ins): out read_word(ins, 24) end.
func ir_get_s2_kind(ins): out read_word(ins, 32) end.
func ir_get_s2_val(ins): out read_word(ins, 40) end.

func ir_set_op(ins, v): write_word(ins, 0, v) end.
func ir_set_dst(ins, v): write_word(ins, 8, v) end.
func ir_set_s1(ins, kind, val):
    write_word(ins, 16, kind)
    write_word(ins, 24, val)
end.
func ir_set_s2(ins, kind, val):
    write_word(ins, 32, kind)
    write_word(ins, 40, val)
end.

# Helper: Check if positive number is a power of two, returns shift amount or -1
func get_power_of_two_shift(val):
    if val <= 0 do out 0 - 1 end
    if (val bit_and (val - 1)) != 0 do out 0 - 1 end
    var shift = 0
    var v = val
    when v > 1 loop
        v = v shr 1
        shift = shift + 1
    end
    out shift
end.

# ═══════════════════════════════════════════════════════
# PASS 1 & 2: Constant Folding & Strength Reduction
# ═══════════════════════════════════════════════════════
func opt_pass_constfold_and_strength_reduce(instrs, count):
    var modified = 0
    var i = 0
    when i < count loop
        let ins = read_word(instrs, i * 8)
        let op = ir_get_op(ins)
        let s1_k = ir_get_s1_kind(ins)
        let s1_v = ir_get_s1_val(ins)
        let s2_k = ir_get_s2_kind(ins)
        let s2_v = ir_get_s2_val(ins)

        # 1. Constant folding (both operands are Imm)
        if (s1_k == 2) and (s2_k == 2) do
            if op == 2 do # Add
                ir_set_op(ins, 1) # Move
                ir_set_s1(ins, 2, s1_v + s2_v)
                ir_set_s2(ins, 0, 0)
                modified = modified + 1
            eif op == 3 do # Sub
                ir_set_op(ins, 1) # Move
                ir_set_s1(ins, 2, s1_v - s2_v)
                ir_set_s2(ins, 0, 0)
                modified = modified + 1
            eif op == 4 do # Mul
                ir_set_op(ins, 1) # Move
                ir_set_s1(ins, 2, s1_v * s2_v)
                ir_set_s2(ins, 0, 0)
                modified = modified + 1
            eif (op == 5) and (s2_v != 0) do # Div
                ir_set_op(ins, 1) # Move
                ir_set_s1(ins, 2, s1_v / s2_v)
                ir_set_s2(ins, 0, 0)
                modified = modified + 1
            end
        end

        # 2. Algebraic Identities
        # x + 0 -> x, x - 0 -> x
        if (op == 2 or op == 3) and (s2_k == 2) and (s2_v == 0) do
            ir_set_op(ins, 1) # Move
            ir_set_s2(ins, 0, 0)
            modified = modified + 1
        end
        # x * 1 -> x
        if (op == 4) and (s2_k == 2) and (s2_v == 1) do
            ir_set_op(ins, 1) # Move
            ir_set_s2(ins, 0, 0)
            modified = modified + 1
        end
        # x * 0 -> 0
        if (op == 4) and (s2_k == 2) and (s2_v == 0) do
            ir_set_op(ins, 1) # Move
            ir_set_s1(ins, 2, 0)
            ir_set_s2(ins, 0, 0)
            modified = modified + 1
        end
        # x ^ x -> 0
        if (op == 9) and (s1_k == 1) and (s2_k == 1) and (s1_v == s2_v) do
            ir_set_op(ins, 1) # Move
            ir_set_s1(ins, 2, 0)
            ir_set_s2(ins, 0, 0)
            modified = modified + 1
        end

        # 3. Strength Reduction (Peephole)
        # x * (2^k) -> x << k
        if (op == 4) and (s2_k == 2) and (s2_v > 1) do
            let shift = get_power_of_two_shift(s2_v)
            if shift > 0 do
                ir_set_op(ins, 10) # Shl
                ir_set_s2(ins, 2, shift)
                modified = modified + 1
            end
        end
        # x / (2^k) -> x >> k (for unsigned / positive)
        if (op == 5) and (s2_k == 2) and (s2_v > 1) do
            let shift = get_power_of_two_shift(s2_v)
            if shift > 0 do
                ir_set_op(ins, 11) # Shr
                ir_set_s2(ins, 2, shift)
                modified = modified + 1
            end
        end
        # x % (2^k) -> x & (2^k - 1)
        if (op == 6) and (s2_k == 2) and (s2_v > 1) do
            let shift = get_power_of_two_shift(s2_v)
            if shift > 0 do
                ir_set_op(ins, 7) # And
                ir_set_s2(ins, 2, s2_v - 1)
                modified = modified + 1
            end
        end

        i = i + 1
    end
    out modified
end.

# ═══════════════════════════════════════════════════════
# PASS 3: Common Subexpression Elimination (CSE)
# ═══════════════════════════════════════════════════════
func opt_pass_cse(instrs, count):
    var modified = 0
    var i = 0
    when i < count loop
        let ins1 = read_word(instrs, i * 8)
        let op1 = ir_get_op(ins1)
        let dst1 = ir_get_dst(ins1)
        let s1_k1 = ir_get_s1_kind(ins1)
        let s1_v1 = ir_get_s1_val(ins1)
        let s2_k1 = ir_get_s2_kind(ins1)
        let s2_v1 = ir_get_s2_val(ins1)

        # Look forward for identical expression
        if (op1 >= 2) and (op1 <= 11) do
            var j = i + 1
            var killed = 0
            when (j < count) and (killed == 0) loop
                let ins2 = read_word(instrs, j * 8)
                let op2 = ir_get_op(ins2)
                let dst2 = ir_get_dst(ins2)
                let s1_k2 = ir_get_s1_kind(ins2)
                let s1_v2 = ir_get_s1_val(ins2)
                let s2_k2 = ir_get_s2_kind(ins2)
                let s2_v2 = ir_get_s2_val(ins2)

                # If operand is redefined, expression is killed
                if (s1_k1 == 1 and dst2 == s1_v1) or (s2_k1 == 1 and dst2 == s2_v1) do
                    killed = 1
                end

                if (killed == 0) and (op1 == op2) and (s1_k1 == s1_k2) and (s1_v1 == s1_v2) and (s2_k1 == s2_k2) and (s2_v1 == s2_v2) do
                    # Replace ins2 with Move dst2 = dst1
                    ir_set_op(ins2, 1) # Move
                    ir_set_s1(ins2, 1, dst1)
                    ir_set_s2(ins2, 0, 0)
                    modified = modified + 1
                end
                j = j + 1
            end
        end
        i = i + 1
    end
    out modified
end.

# ═══════════════════════════════════════════════════════
# PASS 4: Dead Code Elimination (DCE)
# ═══════════════════════════════════════════════════════
func opt_pass_dce(instrs, count):
    # 1. Collect used VRegs
    let used = alloc(256 * 8) # bitmap or count of vreg usages
    var i = 0
    when i < 256 loop
        write_word(used, i * 8, 0)
        i = i + 1
    end

    i = 0
    when i < count loop
        let ins = read_word(instrs, i * 8)
        let op = ir_get_op(ins)
        if op != 0 do # Not Nop
            if ir_get_s1_kind(ins) == 1 do
                let r1 = ir_get_s1_val(ins)
                if r1 < 256 do write_word(used, r1 * 8, read_word(used, r1 * 8) + 1) end
            end
            if ir_get_s2_kind(ins) == 1 do
                let r2 = ir_get_s2_val(ins)
                if r2 < 256 do write_word(used, r2 * 8, read_word(used, r2 * 8) + 1) end
            end
            # If instruction is Ret, Print, Call, or Jump, dst or args are alive
            if op == 35 or op == 33 or op == 30 or op == 31 do
                let dst = ir_get_dst(ins)
                if dst < 256 do write_word(used, dst * 8, read_word(used, dst * 8) + 1) end
            end
        end
        i = i + 1
    end

    # 2. Eliminate instructions defining unused pure variables
    var modified = 0
    i = 0
    when i < count loop
        let ins = read_word(instrs, i * 8)
        let op = ir_get_op(ins)
        let dst = ir_get_dst(ins)

        # Pure operations: Move, Add, Sub, Mul, Div, Shl, Shr, And, Or, Xor
        if (op >= 1) and (op <= 11) and (dst < 256) do
            if read_word(used, dst * 8) == 0 do
                # Dead store! Turn into Nop
                ir_set_op(ins, 0) # Nop
                modified = modified + 1
            end
        end
        i = i + 1
    end
    out modified
end.

# ═══════════════════════════════════════════════════════
# PASS 8: Bounds Check Elimination (BCE)
# ═══════════════════════════════════════════════════════
# BoundsCheck instruction: [52], Dst=Index_VReg, S1=Array_Len_Imm, S2=Static_Min_Imm
# If Index is statically known: 0 <= Index < Array_Len -> eliminate check!
func opt_pass_bce(instrs, count):
    var modified = 0
    var i = 0
    when i < count loop
        let ins = read_word(instrs, i * 8)
        let op = ir_get_op(ins)
        if op == 52 do # BoundsCheck
            let idx_k = ir_get_s1_kind(ins)
            let idx_v = ir_get_s1_val(ins)
            let len_k = ir_get_s2_kind(ins)
            let len_v = ir_get_s2_val(ins)

            # If index and length are both constant, verify and eliminate
            if (idx_k == 2) and (len_k == 2) do
                if (idx_v >= 0) and (idx_v < len_v) do
                    ir_set_op(ins, 0) # Safe at compile-time, eliminate check to Nop
                    modified = modified + 1
                end
            end
        end
        i = i + 1
    end
    out modified
end.

# ═══════════════════════════════════════════════════════
# PASS 9: Escape Analysis & Heap-to-Stack Promotion
# ═══════════════════════════════════════════════════════
# Alloc [50] -> StackAlloc [51] if allocated object does not escape function return
func opt_pass_escape_analysis(instrs, count):
    var modified = 0
    var i = 0
    when i < count loop
        let ins = read_word(instrs, i * 8)
        if ir_get_op(ins) == 50 do # Heap Alloc
            let ptr_reg = ir_get_dst(ins)
            var escapes = 0

            # Scan forward to see if ptr_reg is returned or passed out
            var j = i + 1
            when j < count loop
                let ins_use = read_word(instrs, j * 8)
                let use_op = ir_get_op(ins_use)
                # Escapes if returned (Ret=35)
                if (use_op == 35) and (ir_get_s1_val(ins_use) == ptr_reg) do
                    escapes = 1
                end
                j = j + 1
            end

            if escapes == 0 do
                # Promote to StackAlloc
                ir_set_op(ins, 51) # StackAlloc
                modified = modified + 1
            end
        end
        i = i + 1
    end
    out modified
end.

# ═══════════════════════════════════════════════════════
# MASTER OPTIMIZATION PIPELINE DRIVER (O1, O2, O3)
# ═══════════════════════════════════════════════════════
func optimize_ir_module(instrs, count, opt_level):
    var total_changes = 0
    var max_iterations = 4
    if opt_level == 1 do max_iterations = 2 end
    if opt_level == 3 do max_iterations = 8 end

    var iter = 0
    var progress = 1
    when (iter < max_iterations) and (progress > 0) loop
        progress = 0
        let c1 = opt_pass_constfold_and_strength_reduce(instrs, count)
        let c2 = opt_pass_cse(instrs, count)
        let c3 = opt_pass_dce(instrs, count)
        let c4 = opt_pass_bce(instrs, count)
        let c5 = opt_pass_escape_analysis(instrs, count)

        progress = c1 + c2 + c3 + c4 + c5
        total_changes = total_changes + progress
        iter = iter + 1
    end

    out total_changes
end.

func main:
    # ───────────────────────────────────────────────────
    # Verification Suite: 10 Architectural Optimizer Passes
    # ───────────────────────────────────────────────────

    # TEST 1: Constant Folding (Add 10 + 20 -> Move 30)
    let ins1 = ir_instr_new(2, 1, 2, 10, 2, 20) # v1 = 10 + 20
    let block1 = alloc(1 * 8)
    write_word(block1, 0, ins1)
    let c_fold = opt_pass_constfold_and_strength_reduce(block1, 1)
    assert(c_fold == 1)
    assert(ir_get_op(ins1) == 1) # Move
    assert(ir_get_s1_val(ins1) == 30)

    # TEST 2: Algebraic Identity (v2 * 0 -> Move 0)
    let ins2 = ir_instr_new(4, 2, 1, 5, 2, 0) # v2 = v5 * 0
    write_word(block1, 0, ins2)
    let c_id = opt_pass_constfold_and_strength_reduce(block1, 1)
    assert(c_id == 1)
    assert(ir_get_op(ins2) == 1) # Move
    assert(ir_get_s1_val(ins2) == 0)

    # TEST 3: Strength Reduction (v3 = v5 * 8 -> v3 = v5 << 3)
    let ins3 = ir_instr_new(4, 3, 1, 5, 2, 8) # v3 = v5 * 8
    write_word(block1, 0, ins3)
    let c_sr = opt_pass_constfold_and_strength_reduce(block1, 1)
    assert(c_sr == 1)
    assert(ir_get_op(ins3) == 10) # Shl
    assert(ir_get_s2_val(ins3) == 3) # shift 3

    # TEST 4: Modulo Strength Reduction (v4 = v5 % 16 -> v4 = v5 & 15)
    let ins4 = ir_instr_new(6, 4, 1, 5, 2, 16) # v4 = v5 % 16
    write_word(block1, 0, ins4)
    let c_mod = opt_pass_constfold_and_strength_reduce(block1, 1)
    assert(c_mod == 1)
    assert(ir_get_op(ins4) == 7) # And
    assert(ir_get_s2_val(ins4) == 15) # mask 15

    # TEST 5: Common Subexpression Elimination (CSE)
    # v10 = v1 + v2
    # v11 = v1 + v2  --> becomes v11 = Move v10
    let block_cse = alloc(2 * 8)
    let ins_cse1 = ir_instr_new(2, 10, 1, 1, 1, 2)
    let ins_cse2 = ir_instr_new(2, 11, 1, 1, 1, 2)
    write_word(block_cse, 0, ins_cse1)
    write_word(block_cse, 8, ins_cse2)
    let c_cse = opt_pass_cse(block_cse, 2)
    assert(c_cse == 1)
    assert(ir_get_op(ins_cse2) == 1) # Move
    assert(ir_get_s1_val(ins_cse2) == 10) # from v10

    # TEST 6: Dead Code Elimination (DCE)
    # v20 = 42 (never used) -> eliminated to Nop
    # v21 = 100
    # Ret v21
    let block_dce = alloc(3 * 8)
    let ins_dce1 = ir_instr_new(1, 20, 2, 42, 0, 0) # dead
    let ins_dce2 = ir_instr_new(1, 21, 2, 100, 0, 0)
    let ins_dce3 = ir_instr_new(35, 0, 1, 21, 0, 0) # Ret v21
    write_word(block_dce, 0, ins_dce1)
    write_word(block_dce, 8, ins_dce2)
    write_word(block_dce, 16, ins_dce3)
    let c_dce = opt_pass_dce(block_dce, 3)
    assert(c_dce == 1)
    assert(ir_get_op(ins_dce1) == 0) # Nop
    assert(ir_get_op(ins_dce2) == 1) # Retained Live Move

    # TEST 7: Bounds Check Elimination (BCE)
    # BoundsCheck(index=3, len=10) -> Statically safe (0 <= 3 < 10) -> Nop
    let block_bce = alloc(1 * 8)
    let ins_bce = ir_instr_new(52, 0, 2, 3, 2, 10)
    write_word(block_bce, 0, ins_bce)
    let c_bce = opt_pass_bce(block_bce, 1)
    assert(c_bce == 1)
    assert(ir_get_op(ins_bce) == 0) # Nop

    # TEST 8: Escape Analysis (Heap -> Stack Promotion)
    # Alloc v30 (size=64)
    # Ret 0 (v30 does not escape -> StackAlloc)
    let block_esc = alloc(2 * 8)
    let ins_esc1 = ir_instr_new(50, 30, 2, 64, 0, 0) # Heap Alloc
    let ins_esc2 = ir_instr_new(35, 0, 2, 0, 0, 0)  # Ret 0
    write_word(block_esc, 0, ins_esc1)
    write_word(block_esc, 8, ins_esc2)
    let c_esc = opt_pass_escape_analysis(block_esc, 2)
    assert(c_esc == 1)
    assert(ir_get_op(ins_esc1) == 51) # StackAlloc

    # TEST 9: Full Multi-Pass Pipeline (Level O2)
    let block_pipe = alloc(6 * 8)
    write_word(block_pipe, 0, ir_instr_new(2, 40, 2, 100, 2, 200)) # 100+200 -> 300
    write_word(block_pipe, 8, ir_instr_new(4, 41, 1, 40, 2, 16))   # v40 * 16 -> v40 << 4
    write_word(block_pipe, 16, ir_instr_new(4, 42, 1, 40, 2, 16))  # duplicate -> CSE v41
    write_word(block_pipe, 24, ir_instr_new(1, 99, 2, 999, 0, 0))   # unused dead store -> DCE Nop
    write_word(block_pipe, 32, ir_instr_new(50, 50, 2, 128, 0, 0))  # non-escaping -> StackAlloc
    write_word(block_pipe, 40, ir_instr_new(35, 0, 1, 42, 0, 0))   # Ret v42

    let total_opt = optimize_ir_module(block_pipe, 6, 2)
    assert(total_opt >= 5)

    out 0
end.
