# Test std/collections: Vector, RingBuffer, BitSet (Spec §4.4, stdlib/vir/collections)

entity Vec:
    data: ptr,
    len: int,
    cap: int
end.

func vec_create(initial_cap):
    let d = alloc(initial_cap * 8)
    out Vec(d, 0, initial_cap)
end.

func vec_push(v, val):
    if v.len >= v.cap do
        let new_cap = v.cap * 2
        let new_data = alloc(new_cap * 8)
        var i = 0
        when i < v.len loop
            write_word(new_data, i * 8, read_word(v.data, i * 8))
            i = i + 1
        end
        v.data = new_data
        v.cap = new_cap
    end
    write_word(v.data, v.len * 8, val)
    v.len = v.len + 1
end.

func vec_pop(v):
    if v.len == 0 do out 0 end
    v.len = v.len - 1
    out read_word(v.data, v.len * 8)
end.

func vec_get(v, idx):
    if (idx < 0) or (idx >= v.len) do out 0 end
    out read_word(v.data, idx * 8)
end.

entity RingQueue:
    data: ptr,
    head: int,
    tail: int,
    count: int,
    cap: int
end.

func ring_create(capacity):
    let d = alloc(capacity * 8)
    out RingQueue(d, 0, 0, 0, capacity)
end.

func ring_push(r, val):
    if r.count >= r.cap do out 0 end # full
    write_word(r.data, r.tail * 8, val)
    r.tail = (r.tail + 1) mod r.cap
    r.count = r.count + 1
    out 1
end.

func ring_pop(r):
    if r.count == 0 do out 0 end # empty
    let val = read_word(r.data, r.head * 8)
    r.head = (r.head + 1) mod r.cap
    r.count = r.count - 1
    out val
end.

entity BitSet:
    words: ptr,
    n_bits: int
end.

func bitset_create(num_bits):
    let num_words = (num_bits + 63) / 64
    let w = alloc(num_words * 8)
    var i = 0
    when i < num_words loop
        write_word(w, i * 8, 0)
        i = i + 1
    end
    out BitSet(w, num_bits)
end.

func bitset_set(bs, bit_idx):
    if (bit_idx < 0) or (bit_idx >= bs.n_bits) do out end
    let word_idx = bit_idx / 64
    let bit_offset = bit_idx mod 64
    let cur = read_word(bs.words, word_idx * 8)
    write_word(bs.words, word_idx * 8, cur bit_or (1 shl bit_offset))
end.

func bitset_get(bs, bit_idx):
    if (bit_idx < 0) or (bit_idx >= bs.n_bits) do out 0 end
    let word_idx = bit_idx / 64
    let bit_offset = bit_idx mod 64
    let cur = read_word(bs.words, word_idx * 8)
    if (cur bit_and (1 shl bit_offset)) != 0 do out 1 end
    out 0
end.

func main:
    # 1. Test Vector
    var v = vec_create(2)
    vec_push(v, 10)
    vec_push(v, 20)
    vec_push(v, 30) # Triggers resize to cap 4
    vec_push(v, 40)
    vec_push(v, 50) # Triggers resize to cap 8

    if v.len != 5 do out 1 end
    if v.cap != 8 do out 2 end
    if vec_get(v, 0) != 10 do out 3 end
    if vec_get(v, 2) != 30 do out 4 end
    if vec_get(v, 4) != 50 do out 5 end

    let p1 = vec_pop(v)
    if p1 != 50 do out 6 end
    if v.len != 4 do out 7 end

    # 2. Test RingQueue
    var rq = ring_create(3)
    ring_push(rq, 100)
    ring_push(rq, 200)
    ring_push(rq, 300)
    # Queue is full, next push fails
    if ring_push(rq, 400) != 0 do out 8 end

    if ring_pop(rq) != 100 do out 9 end
    if ring_pop(rq) != 200 do out 10 end

    ring_push(rq, 400) # Enqueue after pop (wraps around)
    if ring_pop(rq) != 300 do out 11 end
    if ring_pop(rq) != 400 do out 12 end
    if ring_pop(rq) != 0 do out 13 end # Empty

    # 3. Test BitSet
    var bs = bitset_create(128)
    bitset_set(bs, 0)
    bitset_set(bs, 63)
    bitset_set(bs, 64)
    bitset_set(bs, 127)

    if bitset_get(bs, 0) != 1 do out 14 end
    if bitset_get(bs, 1) != 0 do out 15 end
    if bitset_get(bs, 63) != 1 do out 16 end
    if bitset_get(bs, 64) != 1 do out 17 end
    if bitset_get(bs, 65) != 0 do out 18 end
    if bitset_get(bs, 127) != 1 do out 19 end

    out 0
end.
