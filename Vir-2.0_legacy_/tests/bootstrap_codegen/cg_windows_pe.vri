# Test: Windows PE32+ (64-bit Portable Executable) Generator & Structural Validator (Spec §9, stdlib/vir/rt/pe)

func u16_le(buf, off, val):
    write_byte(buf, off, val bit_and 255)
    write_byte(buf, off + 1, (val shr 8) bit_and 255)
end.

func u32_le(buf, off, val):
    write_byte(buf, off, val bit_and 255)
    write_byte(buf, off + 1, (val shr 8) bit_and 255)
    write_byte(buf, off + 2, (val shr 16) bit_and 255)
    write_byte(buf, off + 3, (val shr 24) bit_and 255)
end.

func u64_le(buf, off, lo, hi):
    u32_le(buf, off, lo)
    u32_le(buf, off + 4, hi)
end.

func read_u16_le(buf, off):
    let b0 = read_byte(buf, off)
    let b1 = read_byte(buf, off + 1)
    out (b1 shl 8) bit_or b0
end.

func read_u32_le(buf, off):
    let b0 = read_byte(buf, off)
    let b1 = read_byte(buf, off + 1)
    let b2 = read_byte(buf, off + 2)
    let b3 = read_byte(buf, off + 3)
    out (b3 shl 24) bit_or (b2 shl 16) bit_or (b1 shl 8) bit_or b0
end.

# PE32+ (64-bit) Executable Layout:
# 0x000..0x03F: DOS Header (64 bytes, MZ at 0, e_lfanew = 0x80 at 0x3C)
# 0x040..0x07F: DOS Stub (64 bytes)
# 0x080..0x083: PE Signature ("PE\0\0" = 0x00004550)
# 0x084..0x097: COFF File Header (20 bytes)
# 0x098..0x187: PE32+ Optional Header (240 bytes)
# 0x188..0x1AF: Section Header .text (40 bytes)
# 0x1B0..0x1FF: Header Padding (80 bytes to 512-byte FileAlignment)
# 0x200..0x3FF: .text Section Data (Machine Code)

func pe32plus_create(code_ptr, code_len, entry_offset, machine_type, out_buf):
    let file_align = 512
    let sec_align = 4096
    let total_file_size = 512 + 512 # 512 bytes headers + 512 bytes code section

    var i = 0
    when i < total_file_size loop
        write_byte(out_buf, i, 0)
        i = i + 1
    end

    # ── 1. DOS Header (64 bytes) ──
    write_byte(out_buf, 0, 0x4D) # 'M'
    write_byte(out_buf, 1, 0x5A) # 'Z'
    u32_le(out_buf, 0x3C, 0x80)  # e_lfanew = 0x80 (PE Header offset)

    # ── 2. PE Signature (4 bytes at 0x80) ──
    u32_le(out_buf, 0x80, 0x00004550) # "PE\0\0"

    # ── 3. COFF File Header (20 bytes at 0x84) ──
    u16_le(out_buf, 0x84, machine_type) # Machine: 0x8664 (x86_64) or 0xAA64 (ARM64)
    u16_le(out_buf, 0x86, 1)            # NumberOfSections = 1 (.text)
    u32_le(out_buf, 0x88, 0)            # TimeDateStamp
    u32_le(out_buf, 0x8C, 0)            # PointerToSymbolTable
    u32_le(out_buf, 0x90, 0)            # NumberOfSymbols
    u16_le(out_buf, 0x94, 240)          # SizeOfOptionalHeader = 240 (PE32+)
    u16_le(out_buf, 0x96, 0x0022)       # Characteristics: EXECUTABLE | LARGE_ADDRESS_AWARE

    # ── 4. PE32+ Optional Header (240 bytes at 0x98) ──
    u16_le(out_buf, 0x98, 0x020B)       # Magic: 0x020B (PE32+ 64-bit)
    write_byte(out_buf, 0x9A, 1)        # MajorLinkerVersion
    write_byte(out_buf, 0x9B, 0)        # MinorLinkerVersion
    u32_le(out_buf, 0x9C, 512)          # SizeOfCode
    u32_le(out_buf, 0xA0, 0)            # SizeOfInitializedData
    u32_le(out_buf, 0xA4, 0)            # SizeOfUninitializedData
    u32_le(out_buf, 0xA8, 0x1000 + entry_offset) # AddressOfEntryPoint (RVA = 0x1000)
    u32_le(out_buf, 0xAC, 0x1000)       # BaseOfCode (RVA = 0x1000)

    # Windows-Specific Fields
    u64_le(out_buf, 0xB0, 0x00400000, 0) # ImageBase = 0x00400000
    u32_le(out_buf, 0xB8, sec_align)     # SectionAlignment = 4096 (4KB)
    u32_le(out_buf, 0xBC, file_align)    # FileAlignment = 512
    u16_le(out_buf, 0xC0, 6)             # MajorOperatingSystemVersion
    u16_le(out_buf, 0xC2, 0)             # MinorOperatingSystemVersion
    u16_le(out_buf, 0xC4, 0)             # MajorImageVersion
    u16_le(out_buf, 0xC6, 0)             # MinorImageVersion
    u16_le(out_buf, 0xC8, 6)             # MajorSubsystemVersion
    u16_le(out_buf, 0xCA, 0)             # MinorSubsystemVersion
    u32_le(out_buf, 0xCC, 0)             # Win32VersionValue
    u32_le(out_buf, 0xD0, 0x2000)        # SizeOfImage = 8192 (headers 4KB + .text 4KB)
    u32_le(out_buf, 0xD4, 512)           # SizeOfHeaders = 512
    u32_le(out_buf, 0xD8, 0)             # CheckSum
    u16_le(out_buf, 0xDC, 3)             # Subsystem = 3 (IMAGE_SUBSYSTEM_WINDOWS_CUI)
    u16_le(out_buf, 0xDE, 0x8160)        # DllCharacteristics: DYNAMIC_BASE | NX_COMPAT | TERMINAL_SERVER

    u64_le(out_buf, 0xE0, 0x100000, 0)   # SizeOfStackReserve = 1MB
    u64_le(out_buf, 0xE8, 0x1000, 0)     # SizeOfStackCommit = 4KB
    u64_le(out_buf, 0xF0, 0x100000, 0)   # SizeOfHeapReserve = 1MB
    u64_le(out_buf, 0xF8, 0x1000, 0)     # SizeOfHeapCommit = 4KB
    u32_le(out_buf, 0x100, 0)            # LoaderFlags
    u32_le(out_buf, 0x104, 16)           # NumberOfRvaAndSizes = 16

    # ── 5. Section Header .text (40 bytes at 0x188) ──
    # Name: ".text\0\0\0"
    write_byte(out_buf, 0x188, 46) # '.'
    write_byte(out_buf, 0x189, 116)# 't'
    write_byte(out_buf, 0x18A, 101)# 'e'
    write_byte(out_buf, 0x18B, 120)# 'x'
    write_byte(out_buf, 0x18C, 116)# 't'

    u32_le(out_buf, 0x190, code_len)    # VirtualSize
    u32_le(out_buf, 0x194, 0x1000)      # VirtualAddress (RVA = 0x1000)
    u32_le(out_buf, 0x198, 512)         # SizeOfRawData (aligned to 512)
    u32_le(out_buf, 0x19C, 512)         # PointerToRawData (file offset 0x200 = 512)
    u32_le(out_buf, 0x1A0, 0)           # PointerToRelocations
    u32_le(out_buf, 0x1A4, 0)           # PointerToLinenumbers
    u16_le(out_buf, 0x1A8, 0)           # NumberOfRelocations
    u16_le(out_buf, 0x1AA, 0)           # NumberOfLinenumbers
    u32_le(out_buf, 0x1AC, 0x60000020)  # Characteristics: CODE | EXECUTE | READ

    # ── 6. Copy Machine Code at offset 512 (0x200) ──
    i = 0
    when i < code_len loop
        write_byte(out_buf, 512 + i, read_byte(code_ptr, i))
        i = i + 1
    end

    out total_file_size
end.

func assert(cond):
    if cond == 0 do
        exit_prog(1)
    end
end.

func main:
    # 1. Test PE32+ for Windows x86_64 (Machine = 0x8664)
    let code_x86 = alloc(16)
    write_byte(code_x86, 0, 0x48)
    write_byte(code_x86, 1, 0x31)
    write_byte(code_x86, 2, 0xC9) # XOR RCX, RCX (ExitCode = 0)
    write_byte(code_x86, 3, 0xC3) # RET

    let pe_buf = alloc(1024)
    let total_sz = pe32plus_create(code_x86, 4, 0, 0x8664, pe_buf)
    assert(total_sz == 1024)

    # 2. Structural Validation
    # DOS Header
    assert(read_byte(pe_buf, 0) == 0x4D) # 'M'
    assert(read_byte(pe_buf, 1) == 0x5A) # 'Z'
    assert(read_u32_le(pe_buf, 0x3C) == 0x80) # e_lfanew

    # PE Signature
    assert(read_u32_le(pe_buf, 0x80) == 0x00004550) # "PE\0\0"

    # COFF File Header
    assert(read_u16_le(pe_buf, 0x84) == 0x8664)     # IMAGE_FILE_MACHINE_AMD64
    assert(read_u16_le(pe_buf, 0x86) == 1)          # NumberOfSections = 1
    assert(read_u16_le(pe_buf, 0x94) == 240)        # SizeOfOptionalHeader = 240
    assert(read_u16_le(pe_buf, 0x96) == 0x0022)     # Characteristics

    # PE32+ Optional Header
    assert(read_u16_le(pe_buf, 0x98) == 0x020B)     # Magic PE32+
    assert(read_u32_le(pe_buf, 0xA8) == 0x1000)     # EntryPoint RVA = 0x1000
    assert(read_u32_le(pe_buf, 0xAC) == 0x1000)     # BaseOfCode RVA = 0x1000
    assert(read_u32_le(pe_buf, 0xB0) == 0x00400000) # ImageBase
    assert(read_u32_le(pe_buf, 0xB8) == 4096)       # SectionAlignment
    assert(read_u32_le(pe_buf, 0xBC) == 512)        # FileAlignment
    assert(read_u16_le(pe_buf, 0xDC) == 3)          # Subsystem = Console (3)

    # Section Header .text
    assert(read_byte(pe_buf, 0x188) == 46)          # '.'
    assert(read_byte(pe_buf, 0x189) == 116)         # 't'
    assert(read_u32_le(pe_buf, 0x194) == 0x1000)    # VirtualAddress
    assert(read_u32_le(pe_buf, 0x198) == 512)       # SizeOfRawData
    assert(read_u32_le(pe_buf, 0x19C) == 512)       # PointerToRawData
    assert(read_u32_le(pe_buf, 0x1AC) == 0x60000020)# CODE | EXECUTE | READ

    # Machine Code in .text
    assert(read_byte(pe_buf, 512) == 0x48)
    assert(read_byte(pe_buf, 513) == 0x31)
    assert(read_byte(pe_buf, 514) == 0xC9)
    assert(read_byte(pe_buf, 515) == 0xC3)

    # 3. Test Windows ARM64 (Machine = 0xAA64)
    let total_arm64 = pe32plus_create(code_x86, 4, 0, 0xAA64, pe_buf)
    assert(total_arm64 == 1024)
    assert(read_u16_le(pe_buf, 0x84) == 0xAA64)     # IMAGE_FILE_MACHINE_ARM64

    out 0
end.
