# EXPECT_END
# Same bytes from different string expressions must identify the same key.
func main:
    var m = ["alice": 10, "alice": 20]
    var lookup: string = str_concat("ali", "ce")
    print m[lookup]
    print len(m)
    m[lookup] = 30
    print m["alice"]
    print len(m)
end.
