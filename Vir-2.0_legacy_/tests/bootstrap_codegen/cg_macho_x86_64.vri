# Test: macOS x86_64 Mach-O 64-bit Binary Header Generator & Validator (Spec §9, stdlib/vir/compiler/macho)

# Mach-O Constants:
# MH_MAGIC_64 = 0xFEEDFACF
# CPU_TYPE_X86_64 = 0x01000007
# CPU_SUBTYPE_X86_64_ALL = 3
# MH_EXECUTE = 2

func u32_le(buf, off, val):
    write_byte(buf, off, val bit_and 255)
    write_byte(buf, off + 1, (val shr 8) bit_and 255)
    write_byte(buf, off + 2, (val shr 16) bit_and 255)
    write_byte(buf, off + 3, (val shr 24) bit_and 255)
end.

func read_u32_le(buf, off):
    let b0 = read_byte(buf, off)
    let b1 = read_byte(buf, off + 1)
    let b2 = read_byte(buf, off + 2)
    let b3 = read_byte(buf, off + 3)
    out (b3 shl 24) bit_or (b2 shl 16) bit_or (b1 shl 8) bit_or b0
end.

func macho_x86_64_header_init(buf, ncmds, sizeofcmds):
    # 1. Header (32 bytes)
    u32_le(buf, 0, 0xFEEDFACF)  # magic
    u32_le(buf, 4, 0x01000007)  # cputype = CPU_TYPE_X86_64
    u32_le(buf, 8, 3)           # cpusubtype = CPU_SUBTYPE_X86_64_ALL
    u32_le(buf, 12, 2)          # filetype = MH_EXECUTE
    u32_le(buf, 16, ncmds)      # ncmds
    u32_le(buf, 20, sizeofcmds) # sizeofcmds
    u32_le(buf, 24, 0x00200085) # flags = NOUNDEFS | DYLDLINK | TWOLEVEL | PIE
    u32_le(buf, 28, 0)          # reserved
end.

func assert(cond):
    if cond == 0 do
        exit_prog(1)
    end
end.

func main:
    let hdr_buf = alloc(32)
    macho_x86_64_header_init(hdr_buf, 10, 552)

    # Validate Mach-O 64-bit magic
    assert(read_u32_le(hdr_buf, 0) == 0xFEEDFACF)

    # Validate CPU_TYPE_X86_64 (0x01000007)
    assert(read_u32_le(hdr_buf, 4) == 0x01000007)

    # Validate CPU_SUBTYPE_X86_64_ALL (3)
    assert(read_u32_le(hdr_buf, 8) == 3)

    # Validate MH_EXECUTE (2)
    assert(read_u32_le(hdr_buf, 12) == 2)

    # Validate ncmds (10) and sizeofcmds (552)
    assert(read_u32_le(hdr_buf, 16) == 10)
    assert(read_u32_le(hdr_buf, 20) == 552)

    out 0
end.
