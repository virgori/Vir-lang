# EXPECT_START
# 8388608
# 0
# 1
# EXPECT_END
include "../../stdlib/vir/compiler/codegen.vri"
import codebuf_new, codebuf_emit_byte, codebuf_offset, codebuf_get_data, TargetArch from codegen

func main:
    var cb = codebuf_new(TargetArch.ARM64)
    var i = 0
    when i < 8388608 loop
        cb = codebuf_emit_byte(cb, i & 255)
        i = i + 1
    end
    print codebuf_offset(cb)
    print codebuf_get_data(cb, 0)
    print codebuf_get_data(cb, 1048577)
end.
