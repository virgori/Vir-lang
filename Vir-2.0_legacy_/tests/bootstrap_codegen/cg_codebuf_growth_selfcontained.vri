# EXPECT_START
# 8388608
# 0
# 1
# EXPECT_END
include "../../stdlib/vir/compiler/vec_rt.vri"
import bvec_new, bvec_push, bvec_len, bvec_get from vec_rt

extern func native_read_i64(addr: int, offset: int) -> int
extern func native_write_i64(addr: int, offset: int, val: int)

entity CodeBufProbe:
    arch: int,
    data: int,
    len: int,
    start_offset: int
end.

func codebuf_new_probe:
    out CodeBufProbe(arch: 2, data: bvec_new(), len: 0, start_offset: 0)
end.

func codebuf_emit_byte_probe(cb: CodeBufProbe, byte: int):
    var data = native_read_i64(cb as i64, 8)
    data = bvec_push(data, byte & 255)
    native_write_i64(cb as i64, 8, data)
    native_write_i64(cb as i64, 16, bvec_len(data))
    out cb
end.

func codebuf_offset_probe(cb: CodeBufProbe):
    var data = native_read_i64(cb as i64, 8)
    out bvec_len(data)
end.

func codebuf_get_data_probe(cb: CodeBufProbe, idx: int):
    var data = native_read_i64(cb as i64, 8)
    out bvec_get(data, idx)
end.

func main:
    var cb = codebuf_new_probe()
    var i = 0
    when i < 8388608 loop
        cb = codebuf_emit_byte_probe(cb, i & 255)
        i = i + 1
    end
    print codebuf_offset_probe(cb)
    print codebuf_get_data_probe(cb, 0)
    print codebuf_get_data_probe(cb, 1048577)
end.
