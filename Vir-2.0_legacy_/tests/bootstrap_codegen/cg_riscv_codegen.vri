# Test: RISC-V 64-bit (RV64I) Instruction Encoding Engine (Spec §9, stdlib/vir/compiler/codegen_riscv)

# RISC-V Register IDs:
# x0=zero, x1=ra, x2=sp, x3=gp, x4=tp, x5=t0, x6=t1, x7=t2
# x8=s0/fp, x9=s1, x10=a0, x11=a1, x12=a2, x13=a3, x14=a4, x15=a5, x16=a6, x17=a7
# x18..x27 = s2..s11, x28..x31 = t3..t6

# R-Type: funct7[31:25] | rs2[24:20] | rs1[19:15] | funct3[14:12] | rd[11:7] | opcode[6:0]
func rv_encode_r(opcode, funct3, funct7, rd, rs1, rs2):
    let op = opcode bit_and 0x7F
    let f3 = (funct3 bit_and 0x7) shl 12
    let f7 = (funct7 bit_and 0x7F) shl 25
    let d = (rd bit_and 0x1F) shl 7
    let s1 = (rs1 bit_and 0x1F) shl 15
    let s2 = (rs2 bit_and 0x1F) shl 20
    out f7 bit_or s2 bit_or s1 bit_or f3 bit_or d bit_or op
end.

# I-Type: imm[31:20] | rs1[19:15] | funct3[14:12] | rd[11:7] | opcode[6:0]
func rv_encode_i(opcode, funct3, rd, rs1, imm):
    let op = opcode bit_and 0x7F
    let f3 = (funct3 bit_and 0x7) shl 12
    let d = (rd bit_and 0x1F) shl 7
    let s1 = (rs1 bit_and 0x1F) shl 15
    let im = (imm bit_and 0xFFF) shl 20
    out im bit_or s1 bit_or f3 bit_or d bit_or op
end.

# U-Type: imm[31:12] | rd[11:7] | opcode[6:0]
func rv_encode_u(opcode, rd, imm20):
    let op = opcode bit_and 0x7F
    let d = (rd bit_and 0x1F) shl 7
    let im = (imm20 bit_and 0xFFFFF) shl 12
    out im bit_or d bit_or op
end.

# Common RISC-V Instructions
func rv_add(rd, rs1, rs2):
    out rv_encode_r(0x33, 0, 0, rd, rs1, rs2)
end.

func rv_sub(rd, rs1, rs2):
    out rv_encode_r(0x33, 0, 0x20, rd, rs1, rs2)
end.

func rv_xor(rd, rs1, rs2):
    out rv_encode_r(0x33, 4, 0, rd, rs1, rs2)
end.

func rv_or(rd, rs1, rs2):
    out rv_encode_r(0x33, 6, 0, rd, rs1, rs2)
end.

func rv_and(rd, rs1, rs2):
    out rv_encode_r(0x33, 7, 0, rd, rs1, rs2)
end.

func rv_addi(rd, rs1, imm):
    out rv_encode_i(0x13, 0, rd, rs1, imm)
end.

func rv_lui(rd, imm20):
    out rv_encode_u(0x37, rd, imm20)
end.

func rv_auipc(rd, imm20):
    out rv_encode_u(0x17, rd, imm20)
end.

func rv_jalr(rd, rs1, imm):
    out rv_encode_i(0x67, 0, rd, rs1, imm)
end.

func rv_ret:
    # RET is pseudo for JALR x0, x1, 0 (JALR zero, ra, 0)
    out rv_jalr(0, 1, 0)
end.

func rv_ecall:
    out 0x00000073
end.

func assert(cond):
    if cond == 0 do
        exit_prog(1)
    end
end.

func main:
    # 1. ADD a0 (x10), a1 (x11), a2 (x12)
    # funct7=0, rs2=12 (0x0C), rs1=11 (0x0B), funct3=0, rd=10 (0x0A), opcode=0x33
    # (0 << 25) | (12 << 20) | (11 << 15) | (0 << 12) | (10 << 7) | 0x33 = 0x00C58533
    let ins_add = rv_add(10, 11, 12)
    assert(ins_add == 0x00C58533)

    # 2. SUB a0 (x10), a1 (x11), a2 (x12)
    # funct7=0x20 -> (0x20 << 25) | ... = 0x40C58533
    let ins_sub = rv_sub(10, 11, 12)
    assert(ins_sub == 0x40C58533)

    # 3. ADDI a0 (x10), zero (x0), 42
    # imm=42 (0x02A), rs1=0, funct3=0, rd=10 (0x0A), opcode=0x13
    # (42 << 20) | (0 << 15) | (0 << 12) | (10 << 7) | 0x13 = 0x02A00513
    let ins_addi_42 = rv_addi(10, 0, 42)
    assert(ins_addi_42 == 0x02A00513)

    # 4. ADDI a7 (x17), zero (x0), 93 (Linux sys_exit)
    # imm=93 (0x05D), rs1=0, funct3=0, rd=17 (0x11), opcode=0x13
    # (93 << 20) | (0 << 15) | (0 << 12) | (17 << 7) | 0x13 = 0x05D00893
    let ins_addi_93 = rv_addi(17, 0, 93)
    assert(ins_addi_93 == 0x05D00893)

    # 5. ECALL (0x00000073)
    assert(rv_ecall() == 0x00000073)

    # 6. RET (JALR x0, x1, 0)
    # imm=0, rs1=1 (ra), funct3=0, rd=0 (zero), opcode=0x67 -> 0x00008067
    assert(rv_ret() == 0x00008067)

    # 7. LUI a0 (x10), 0x12345
    let ins_lui = rv_lui(10, 0x12345)
    assert(ins_lui == 0x12345537)

    out 0
end.
