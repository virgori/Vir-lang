# Phase F1: Test std/net/url — URL Parser & Decomposition (Spec §9, stdlib/vir/net)

func cstr_len(s):
    if s == 0 do out 0 end
    var i = 0
    when read_byte(s, i) != 0 loop
        i = i + 1
    end
    out i
end.

func cstr_eq(a, b):
    let la = cstr_len(a)
    let lb = cstr_len(b)
    if la != lb do out 0 end
    var i = 0
    when i < la loop
        if read_byte(a, i) != read_byte(b, i) do
            out 0
        end
        i = i + 1
    end
    out 1
end.

# URL struct layout at ptr:
# word 0: scheme (string ptr)
# word 8: host (string ptr)
# word 16: port (i64)
# word 24: path (string ptr)
# word 32: query (string ptr)
# word 40: fragment (string ptr)

func url_create:
    let u = alloc(48)
    write_word(u, 0, alloc(64))  # scheme
    write_word(u, 8, alloc(128)) # host
    write_word(u, 16, 80)        # default port
    write_word(u, 24, alloc(256)) # path
    write_word(u, 32, alloc(256)) # query
    write_word(u, 40, alloc(64))  # fragment
    out u
end.

func copy_slice(src, start, end_pos, dst):
    var dst_idx = 0
    var i = start
    when i < end_pos loop
        write_byte(dst, dst_idx, read_byte(src, i))
        dst_idx = dst_idx + 1
        i = i + 1
    end
    write_byte(dst, dst_idx, 0)
end.

func parse_int_sub(s, start, end_pos):
    var res = 0
    var i = start
    when i < end_pos loop
        let b = read_byte(s, i)
        if (b >= 48) and (b <= 57) do
            res = res * 10 + (b - 48)
        end
        i = i + 1
    end
    out res
end.

func url_parse(raw, u):
    let l = cstr_len(raw)
    var pos = 0

    # 1. Scheme (up to "://")
    var scheme_end = 0 - 1
    var i = 0
    when (i + 2 < l) and (scheme_end == (0 - 1)) loop
        if (read_byte(raw, i) == 58) and (read_byte(raw, i + 1) == 47) and (read_byte(raw, i + 2) == 47) do
            scheme_end = i
        end
        i = i + 1
    end

    let scheme_buf = read_word(u, 0)
    let host_buf = read_word(u, 8)
    let path_buf = read_word(u, 24)
    let query_buf = read_word(u, 32)
    let frag_buf = read_word(u, 40)

    if scheme_end != (0 - 1) do
        copy_slice(raw, 0, scheme_end, scheme_buf)
        pos = scheme_end + 3
        # Set default port based on scheme
        if cstr_eq(scheme_buf, "https") == 1 do
            write_word(u, 16, 443)
        else
            if cstr_eq(scheme_buf, "http") == 1 do
                write_word(u, 16, 80)
            else
                if cstr_eq(scheme_buf, "ftp") == 1 do
                    write_word(u, 16, 21)
                end
            end
        end
    else
        write_byte(scheme_buf, 0, 0)
    end

    # 2. Host and Port (up to '/', '?', '#', or EOF)
    var host_start = pos
    var host_end = l
    var port_start = 0 - 1
    i = pos
    var done_host = 0
    when (i < l) and (done_host == 0) loop
        let b = read_byte(raw, i)
        if (b == 47) or (b == 63) or (b == 35) do # '/', '?', '#'
            host_end = i
            done_host = 1
        else
            if (b == 58) and (port_start == (0 - 1)) do # ':'
                port_start = i
            end
        end
        i = i + 1
    end
    if done_host == 0 do
        host_end = l
    end

    if port_start != (0 - 1) do
        copy_slice(raw, host_start, port_start, host_buf)
        let custom_port = parse_int_sub(raw, port_start + 1, host_end)
        write_word(u, 16, custom_port)
    else
        copy_slice(raw, host_start, host_end, host_buf)
    end

    pos = host_end

    # 3. Path (up to '?' or '#')
    var path_start = pos
    var path_end = l
    var query_start = 0 - 1
    var frag_start = 0 - 1
    i = pos
    var done_path = 0
    when (i < l) and (done_path == 0) loop
        let b = read_byte(raw, i)
        if b == 63 do # '?'
            path_end = i
            query_start = i + 1
            done_path = 1
        else
            if b == 35 do # '#'
                path_end = i
                frag_start = i + 1
                done_path = 1
            end
        end
        i = i + 1
    end
    if done_path == 0 do
        path_end = l
    end

    if path_start == path_end do
        # Default path "/"
        write_byte(path_buf, 0, 47)
        write_byte(path_buf, 1, 0)
    else
        copy_slice(raw, path_start, path_end, path_buf)
    end

    pos = path_end

    # 4. Query and Fragment
    if query_start != (0 - 1) do
        var q_end = l
        i = query_start
        when i < l loop
            if read_byte(raw, i) == 35 do # '#'
                q_end = i
                frag_start = i + 1
            end
            i = i + 1
        end
        copy_slice(raw, query_start, q_end, query_buf)
    else
        write_byte(query_buf, 0, 0)
    end

    if frag_start != (0 - 1) do
        copy_slice(raw, frag_start, l, frag_buf)
    else
        write_byte(frag_buf, 0, 0)
    end

    out 1
end.

func assert(cond):
    if cond == 0 do
        exit_prog(1)
    end
end.

func main:
    let u = url_create()

    # 1. Full URL with custom port, query, fragment
    url_parse("https://vir-lang.org:8443/docs/spec.html?lang=vi&v=2#intro", u)
    assert(cstr_eq(read_word(u, 0), "https") == 1)
    assert(cstr_eq(read_word(u, 8), "vir-lang.org") == 1)
    assert(read_word(u, 16) == 8443)
    assert(cstr_eq(read_word(u, 24), "/docs/spec.html") == 1)
    assert(cstr_eq(read_word(u, 32), "lang=vi&v=2") == 1)
    assert(cstr_eq(read_word(u, 40), "intro") == 1)

    # 2. Simple HTTP URL with default port 80
    url_parse("http://localhost/api/v1/health", u)
    assert(cstr_eq(read_word(u, 0), "http") == 1)
    assert(cstr_eq(read_word(u, 8), "localhost") == 1)
    assert(read_word(u, 16) == 80)
    assert(cstr_eq(read_word(u, 24), "/api/v1/health") == 1)
    assert(cstr_eq(read_word(u, 32), "") == 1)
    assert(cstr_eq(read_word(u, 40), "") == 1)

    # 3. FTP URL without explicit path
    url_parse("ftp://files.example.com", u)
    assert(cstr_eq(read_word(u, 0), "ftp") == 1)
    assert(cstr_eq(read_word(u, 8), "files.example.com") == 1)
    assert(read_word(u, 16) == 21)
    assert(cstr_eq(read_word(u, 24), "/") == 1)

    out 0
end.
