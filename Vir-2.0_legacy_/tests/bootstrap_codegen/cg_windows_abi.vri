# Test: Windows Microsoft x64 ABI & Shadow Space Frame Engine (Spec §9, stdlib/vir/compiler/codegen_x86)

# Register IDs:
# RAX=0, RCX=1, RDX=2, RBX=3, RSP=4, RBP=5, RSI=6, RDI=7
# R8=8, R9=9, R10=10, R11=11, R12=12, R13=13, R14=14, R15=15

func win64_arg_reg(idx):
    if idx == 0 do out 1 end # RCX
    if idx == 1 do out 2 end # RDX
    if idx == 2 do out 8 end # R8
    if idx == 3 do out 9 end # R9
    out 0 # RAX (fallback)
end.

# Checks if register is non-volatile in Win64 ABI (must be preserved across calls)
func win64_is_callee_saved(reg):
    if reg == 3 do out 1 end  # RBX
    if reg == 5 do out 1 end  # RBP
    if reg == 6 do out 1 end  # RSI
    if reg == 7 do out 1 end  # RDI
    if reg == 12 do out 1 end # R12
    if reg == 13 do out 1 end # R13
    if reg == 14 do out 1 end # R14
    if reg == 15 do out 1 end # R15
    out 0
end.

# Checks if register is volatile/scratch in Win64 ABI
func win64_is_volatile(reg):
    if win64_is_callee_saved(reg) == 1 do
        out 0
    end
    out 1
end.

# Calculates aligned Win64 stack allocation including 32-byte shadow space
# Total stack allocation must ensure (RSP % 16 == 0) prior to CALL
func win64_calc_stack_alloc(local_vars_size):
    let shadow_space = 32
    var total = local_vars_size + shadow_space
    # Round up to multiple of 16 + 8 (so after PUSH RBP, RSP - total is 16-byte aligned)
    let aligned = ((total + 15) / 16) * 16
    out aligned
end.

func emit_sub_rsp_imm32(buf, pos, imm):
    write_byte(buf, pos, 0x48)
    write_byte(buf, pos + 1, 0x81)
    write_byte(buf, pos + 2, 0xEC)
    write_byte(buf, pos + 3, imm bit_and 255)
    write_byte(buf, pos + 4, (imm shr 8) bit_and 255)
    write_byte(buf, pos + 5, (imm shr 16) bit_and 255)
    write_byte(buf, pos + 6, (imm shr 24) bit_and 255)
    out pos + 7
end.

func emit_add_rsp_imm32(buf, pos, imm):
    write_byte(buf, pos, 0x48)
    write_byte(buf, pos + 1, 0x81)
    write_byte(buf, pos + 2, 0xC4)
    write_byte(buf, pos + 3, imm bit_and 255)
    write_byte(buf, pos + 4, (imm shr 8) bit_and 255)
    write_byte(buf, pos + 5, (imm shr 16) bit_and 255)
    write_byte(buf, pos + 6, (imm shr 24) bit_and 255)
    out pos + 7
end.

func assert(cond):
    if cond == 0 do
        exit_prog(1)
    end
end.

func main:
    # 1. Argument Register Mapping (RCX, RDX, R8, R9)
    assert(win64_arg_reg(0) == 1) # Arg 0 -> RCX
    assert(win64_arg_reg(1) == 2) # Arg 1 -> RDX
    assert(win64_arg_reg(2) == 8) # Arg 2 -> R8
    assert(win64_arg_reg(3) == 9) # Arg 3 -> R9

    # 2. Callee-saved vs Volatile Registers
    assert(win64_is_callee_saved(3) == 1)  # RBX is saved
    assert(win64_is_callee_saved(5) == 1)  # RBP is saved
    assert(win64_is_callee_saved(6) == 1)  # RSI is saved
    assert(win64_is_callee_saved(7) == 1)  # RDI is saved
    assert(win64_is_callee_saved(12) == 1) # R12 is saved
    assert(win64_is_callee_saved(15) == 1) # R15 is saved

    assert(win64_is_volatile(0) == 1)  # RAX is volatile (scratch / return value)
    assert(win64_is_volatile(1) == 1)  # RCX is volatile
    assert(win64_is_volatile(2) == 1)  # RDX is volatile
    assert(win64_is_volatile(8) == 1)  # R8 is volatile
    assert(win64_is_volatile(9) == 1)  # R9 is volatile
    assert(win64_is_volatile(10) == 1) # R10 is volatile
    assert(win64_is_volatile(11) == 1) # R11 is volatile

    # 3. Stack Shadow Space & Frame Alignment
    # With 0 bytes of local vars: 32 shadow -> 32 bytes aligned
    assert(win64_calc_stack_alloc(0) == 32)
    # With 8 bytes of local vars: 8 + 32 = 40 -> 48 bytes aligned
    assert(win64_calc_stack_alloc(8) == 48)
    # With 32 bytes of local vars: 32 + 32 = 64 -> 64 bytes aligned
    assert(win64_calc_stack_alloc(32) == 64)

    # 4. Instruction emission for SUB RSP, 48 & ADD RSP, 48
    let buf = alloc(64)
    var p = 0
    p = emit_sub_rsp_imm32(buf, p, 48) # 48 81 EC 30 00 00 00
    assert(p == 7)
    assert(read_byte(buf, 0) == 0x48)
    assert(read_byte(buf, 1) == 0x81)
    assert(read_byte(buf, 2) == 0xEC)
    assert(read_byte(buf, 3) == 48)

    p = emit_add_rsp_imm32(buf, p, 48) # 48 81 C4 30 00 00 00
    assert(p == 14)
    assert(read_byte(buf, 7) == 0x48)
    assert(read_byte(buf, 8) == 0x81)
    assert(read_byte(buf, 9) == 0xC4)
    assert(read_byte(buf, 10) == 48)

    out 0
end.
