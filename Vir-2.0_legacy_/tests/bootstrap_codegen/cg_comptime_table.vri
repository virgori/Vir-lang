# Test comptime tables and bit shifting (Spec §15)
func power_of_two_table(idx):
    let table = [
        comptime (1 shl 0),
        comptime (1 shl 1),
        comptime (1 shl 2),
        comptime (1 shl 3),
        comptime (1 shl 4),
        comptime (1 shl 5),
        comptime (1 shl 6),
        comptime (1 shl 7)
    ]
    out table[idx]
end.

func main:
    if power_of_two_table(0) != 1 do out 1 end
    if power_of_two_table(1) != 2 do out 2 end
    if power_of_two_table(2) != 4 do out 3 end
    if power_of_two_table(3) != 8 do out 4 end
    if power_of_two_table(4) != 16 do out 5 end
    if power_of_two_table(5) != 32 do out 6 end
    if power_of_two_table(6) != 64 do out 7 end
    if power_of_two_table(7) != 128 do out 8 end
    out 0
end.
