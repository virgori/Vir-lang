# Test: x86_64 Instruction Encoding Engine (Spec §9, stdlib/vir/compiler/codegen_x86)

# Register IDs:
# RAX=0, RCX=1, RDX=2, RBX=3, RSP=4, RBP=5, RSI=6, RDI=7
# R8=8, R9=9, R10=10, R11=11, R12=12, R13=13, R14=14, R15=15

func x86_rex_w(r, rm):
    var rex = 0x48
    if r >= 8 do
        rex = rex bit_or 0x04 # REX.R
    end
    if rm >= 8 do
        rex = rex bit_or 0x01 # REX.B
    end
    out rex
end.

func x86_modrm(mod_bits, reg, rm):
    let v = (mod_bits shl 6) bit_or ((reg bit_and 7) shl 3)
    out v bit_or (rm bit_and 7)
end.

func emit_add_rr(buf, pos, dst, src):
    write_byte(buf, pos, x86_rex_w(src, dst))
    write_byte(buf, pos + 1, 0x01)
    write_byte(buf, pos + 2, x86_modrm(3, src, dst))
    out pos + 3
end.

func emit_sub_rr(buf, pos, dst, src):
    write_byte(buf, pos, x86_rex_w(src, dst))
    write_byte(buf, pos + 1, 0x29)
    write_byte(buf, pos + 2, x86_modrm(3, src, dst))
    out pos + 3
end.

func emit_mov_rr(buf, pos, dst, src):
    write_byte(buf, pos, x86_rex_w(src, dst))
    write_byte(buf, pos + 1, 0x89)
    write_byte(buf, pos + 2, x86_modrm(3, src, dst))
    out pos + 3
end.

func emit_syscall(buf, pos):
    write_byte(buf, pos, 0x0F)
    write_byte(buf, pos + 1, 0x05)
    out pos + 2
end.

func emit_ret(buf, pos):
    write_byte(buf, pos, 0xC3)
    out pos + 1
end.

func emit_push(buf, pos, reg):
    if reg >= 8 do
        write_byte(buf, pos, 0x41)
        pos = pos + 1
    end
    write_byte(buf, pos, 0x50 + (reg bit_and 7))
    out pos + 1
end.

func emit_pop(buf, pos, reg):
    if reg >= 8 do
        write_byte(buf, pos, 0x41)
        pos = pos + 1
    end
    write_byte(buf, pos, 0x58 + (reg bit_and 7))
    out pos + 1
end.

func assert(cond):
    if cond == 0 do
        exit_prog(1)
    end
end.

func main:
    let buf = alloc(128)

    # 1. REX.W prefix tests
    # RAX (0) to RDX (2): no extended regs -> REX.W = 0x48
    assert(x86_rex_w(0, 2) == 0x48)
    # R8 (8) to RAX (0): src is R8 -> REX.R = 0x4C
    assert(x86_rex_w(8, 0) == 0x4C)
    # RAX (0) to R10 (10): dst is R10 -> REX.B = 0x49
    assert(x86_rex_w(0, 10) == 0x49)
    # R9 (9) to R11 (11): both extended -> REX.R | REX.B = 0x4D
    assert(x86_rex_w(9, 11) == 0x4D)

    # 2. ModR/M byte tests
    # mod=3 (register direct), reg=RAX (0), rm=RCX (1) -> (3<<6) | (0<<3) | 1 = 0xC1
    assert(x86_modrm(3, 0, 1) == 0xC1)
    # mod=3, reg=RDI (7), rm=RSI (6) -> (3<<6) | (7<<3) | 6 = 0xFE
    assert(x86_modrm(3, 7, 6) == 0xFE)

    # 3. ADD RAX, RCX: 48 01 C8 (mod=3, src=RCX(1), dst=RAX(0))
    var p = 0
    p = emit_add_rr(buf, p, 0, 1)
    assert(p == 3)
    assert(read_byte(buf, 0) == 0x48)
    assert(read_byte(buf, 1) == 0x01)
    assert(read_byte(buf, 2) == 0xC8)

    # 4. SUB RDX, RBX: 48 29 DA (mod=3, src=RBX(3), dst=RDX(2))
    p = emit_sub_rr(buf, p, 2, 3)
    assert(p == 6)
    assert(read_byte(buf, 3) == 0x48)
    assert(read_byte(buf, 4) == 0x29)
    assert(read_byte(buf, 5) == 0xDA)

    # 5. MOV R8, R9: 4D 89 C8 (mod=3, src=R9(9), dst=R8(8))
    p = emit_mov_rr(buf, p, 8, 9)
    assert(p == 9)
    assert(read_byte(buf, 6) == 0x4D)
    assert(read_byte(buf, 7) == 0x89)
    assert(read_byte(buf, 8) == 0xC8)

    # 6. SYSCALL & RET
    p = emit_syscall(buf, p)
    assert(read_byte(buf, 9) == 0x0F)
    assert(read_byte(buf, 10) == 0x05)

    p = emit_ret(buf, p)
    assert(read_byte(buf, 11) == 0xC3)

    # 7. PUSH/POP standard and extended registers
    p = emit_push(buf, p, 0) # PUSH RAX -> 50
    assert(read_byte(buf, 12) == 0x50)

    p = emit_push(buf, p, 12) # PUSH R12 -> 41 54
    assert(read_byte(buf, 13) == 0x41)
    assert(read_byte(buf, 14) == 0x54)

    p = emit_pop(buf, p, 12) # POP R12 -> 41 5C
    assert(read_byte(buf, 15) == 0x41)
    assert(read_byte(buf, 16) == 0x5C)

    p = emit_pop(buf, p, 0) # POP RAX -> 58
    assert(read_byte(buf, 17) == 0x58)

    out 0
end.
