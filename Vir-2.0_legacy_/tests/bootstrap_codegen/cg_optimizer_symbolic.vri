# Bootstrap Native Test: Symbolic Loop Collapse (Gauss Closed-Form Induction)
# ==============================================================================
# Spec §18 / Pillar 6: Symbolic loop analysis detects linear arithmetic
# progressions in loops and collapses O(N) loop executions into O(1) closed-form formulas:
# Sum = A * (N * (N - 1) / 2) + B * N

func assert(cond):
    if cond == 0 do
        exit_prog(1)
    end
end.

# Closed-Form Gauss Formula Evaluator: O(1)
# Computes: sum_{i=0}^{n-1} (a * i + b)
func opt_symbolic_eval_linear_progression(a, b, n):
    if n <= 0 do
        out 0
    end
    let n_minus_1 = n - 1
    let sum_i = (n * n_minus_1) / 2 # Gauss sum for 0..N-1
    let total_a = a * sum_i
    let total_b = b * n
    out total_a + total_b
end.

# Generalized Closed-Form with Boundary [start, end) and Stride: O(1)
func opt_symbolic_eval_bounded(start_val, end_val, stride, a_coeff, b_const):
    if end_val <= start_val do
        out 0
    end
    let diff = end_val - start_val
    let n = (diff + (stride - 1)) / stride
    let sum_k = (n * (n - 1)) / 2
    let term1 = a_coeff * start_val * n
    let term2 = a_coeff * stride * sum_k
    let term3 = b_const * n
    out term1 + term2 + term3
end.

# O(N) Reference Loop Simulation for Verification
func sim_loop_linear(a, b, n):
    var sum = 0
    var i = 0
    when i < n loop
        sum = sum + (a * i + b)
        i = i + 1
    end
    out sum
end.

func sim_loop_bounded(start_val, end_val, stride, a_coeff, b_const):
    var sum = 0
    var x = start_val
    when x < end_val loop
        sum = sum + (a_coeff * x + b_const)
        x = x + stride
    end
    out sum
end.

func main:
    # TEST 1: Basic Gauss Sum (a = 1, b = 0, N = 100) -> sum(0..99) = 99 * 100 / 2 = 4950
    let s_fast_100 = opt_symbolic_eval_linear_progression(1, 0, 100)
    let s_slow_100 = sim_loop_linear(1, 0, 100)
    assert(s_fast_100 == 4950)
    assert(s_fast_100 == s_slow_100)

    # TEST 2: Linear Progression (a = 7, b = 13, N = 50000)
    let s_fast_50k = opt_symbolic_eval_linear_progression(7, 13, 50000)
    let s_slow_50k = sim_loop_linear(7, 13, 50000)
    assert(s_fast_50k == s_slow_50k)

    # TEST 3: Bounded & Strided Loop ([start=10, end=1000, stride=4], a = 3, b = 5)
    let s_b_fast = opt_symbolic_eval_bounded(10, 1000, 4, 3, 5)
    let s_b_slow = sim_loop_bounded(10, 1000, 4, 3, 5)
    assert(s_b_fast == s_b_slow)

    # TEST 4: Massive Scale O(1) Evaluation (N = 10^9 elements)
    # Evaluates in < 1 microsecond without spinning a 1-billion iteration loop!
    let massive_fast = opt_symbolic_eval_linear_progression(1, 0, 1000000000)
    # Expected = 1,000,000,000 * 999,999,999 / 2 = 499,999,999,500,000,000
    assert(massive_fast == 499999999500000000)

    out 0
end.
