# Negative test: Forwarding an entity parameter by value moves it,
# invalidating caller's binding and causing E5001 on subsequent use.
# EXPECT_COMPILE_FAIL: E5001
# EXPECT_DIAGNOSTIC: E5001

entity Item:
    val: int
end.

func take(it: Item):
    print it.val
end.

func forward(it: Item):
    take(it)
    print it.val
end.

func main:
    forward(Item(val: 42))
end.
