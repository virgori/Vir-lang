# CONTRACT: MEM-HEAP-007
# EXPECT: 1
include rt.alloc
import heap_init, heap_destroy, tlsf_direct_hash_insert,
       tlsf_direct_hash_find, tlsf_direct_hash_remove from rt.alloc

func main:
    heap_init(16777216)

    # All three bases hash to slot 1: (base >> 20) & 511.
    let base1 = 1048576
    let base2 = 537919488
    let base3 = 1074790400

    tlsf_direct_hash_insert(base1, 7)
    tlsf_direct_hash_insert(base2, 8)
    tlsf_direct_hash_insert(base3, 9)
    tlsf_direct_hash_remove(base1)

    var ok = 1
    if tlsf_direct_hash_find(base1) != 0 - 1 do ok = 0 end
    if tlsf_direct_hash_find(base2) != 8 do ok = 0 end
    if tlsf_direct_hash_find(base3) != 9 do ok = 0 end

    heap_destroy()
    print(ok)
end.
