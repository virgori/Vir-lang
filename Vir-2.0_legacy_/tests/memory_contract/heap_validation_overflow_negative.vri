# CONTRACT: MEM-HEAP-004
# EXPECT: 1
include rt.alloc
import heap_alloc, heap_verify from rt.alloc

func main:
    var ok = 1

    # Negative size must return 0
    let p1 = heap_alloc(-1)
    if p1 != 0 do
        ok = 0
    end

    # Zero size must return 0
    let p2 = heap_alloc(0)
    if p2 != 0 do
        ok = 0
    end

    # INT64_MAX overflow must return 0
    let p3 = heap_alloc(9223372036854775807)
    if p3 != 0 do
        ok = 0
    end

    # Over 1GB limit must return 0
    let p4 = heap_alloc(1073741825)
    if p4 != 0 do
        ok = 0
    end

    if ok == 1 and heap_verify() == 1 do
        print 1
    else
        print 0
    end
end.
