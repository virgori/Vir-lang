# CONTRACT: MEM-HEAP-002
# EXPECT: 10000
include rt.alloc
include rt.syscall
import vir_alloc, vir_free, heap_verify from rt.alloc
import Platform, sys_platform, sys_mmap, sys_getrusage from rt.syscall

func get_rss_kb() -> int:
    let plat = sys_platform()
    let buf = sys_mmap(0, 4096, 3, 0x1002, -1, 0)
    if buf <= 0 do
        out 0
    end
    let res = sys_getrusage(0, buf)
    if res != 0 do
        out 0
    end
    extern func native_read_i64(addr: int, offset: int) -> int
    let maxrss = native_read_i64(buf, 32)
    if plat == Platform.MacOS_ARM64 or plat == Platform.MacOS_x86_64 do
        out maxrss / 1024
    else
        out maxrss
    end
end.

func main:
    let rss_start = get_rss_kb()
    var i = 0
    var ok = 0
    when i < 10000 loop
        var p = vir_alloc(4096)
        if p != 0 do
            ok = ok + 1
        end
        vir_free(p)
        i = i + 1
    end
    let rss_end = get_rss_kb()
    var delta = rss_end - rss_start
    if delta < 0 do
        delta = 0 - delta
    end
    # Ensure kernel RSS is strictly bounded (<= 128 KB for 10k x 4KB allocs) and heap invariant holds
    if delta <= 128 and heap_verify() == 1 do
        print ok
    else
        print 0
    end
end.
