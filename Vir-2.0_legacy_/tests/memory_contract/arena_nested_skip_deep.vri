# CONTRACT: MEM-DEEP-003
# EXPECT: 3
func main:
    var result = [0]
    var iteration = 0
    when iteration < 3 loop
        arena:
            arena:
                arena:
                    arena:
                        iteration = iteration + 1
                        var local = [iteration]
                        result = local
                        if iteration < 3 do
                            skip
                        end
                    end
                end
            end
        end
    end
    print result[0]
end.
