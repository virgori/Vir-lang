# CONTRACT: MEM-HEAP-006
# EXPECT: 1
include rt.alloc
import heap_alloc, heap_free, heap_realloc, heap_verify from rt.alloc

func main:
    var ok = 1

    # 1. realloc(0, 128) == alloc(128)
    let p = heap_realloc(0, 128)
    if p == 0 do
        ok = 0
    end

    # 2. In-place shrink from 128 to 32 (splits tail of 96 bytes into bins)
    let p_shrink = heap_realloc(p, 32)
    if p_shrink != p do
        ok = 0
    end
    if heap_verify() != 1 do
        ok = 0
    end

    # 3. realloc(p, 0) frees the block and returns 0
    let p_zero = heap_realloc(p_shrink, 0)
    if p_zero != 0 do
        ok = 0
    end
    if heap_verify() != 1 do
        ok = 0
    end

    if ok == 1 do
        print 1
    else
        print 0
    end
end.
