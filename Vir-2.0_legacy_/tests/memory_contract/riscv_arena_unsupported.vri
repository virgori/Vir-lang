# MEM-RISCV-001: Arena programs must return E-RISCV-UNSUPPORTED on linux-riscv64.
# The RISC-V backend has not implemented arena watermark/persistent promotion;
# it must reject rather than silently compile broken code.
# VIRC_FLAGS: --target linux-riscv64
func main:
    var result = 0
    arena:
        var tmp = [1, 2, 3, 4]
        result = tmp[0]
    end
    print result
end.
