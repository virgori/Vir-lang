# CONTRACT: MEM-REGION-001
# EXPECT: 10000
func main:
    var iteration = 0
    var verified = 0
    when iteration < 10000 loop
        arena:
            var p = alloc(65536)
            if p == 0 do out 91 end
            write_word(p, 0, iteration)
            if read_word(p, 0) == iteration do
                verified = verified + 1
            end
        end
        iteration = iteration + 1
    end
    print verified
end.
