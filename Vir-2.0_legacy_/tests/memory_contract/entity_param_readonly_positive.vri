# Positive test: Passing an entity by `ref` does NOT move it.
# The caller retains ownership and can use `it` after the call.
# EXPECT: 10\n10
entity Item:
    val: int
end.

func inspect(ref it: Item):
    print it.val
end.

func main:
    var it = Item(val: 10)
    inspect(it)
    print it.val
end.
