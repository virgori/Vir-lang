# CONTRACT: MEM-ARENA-BULK-001
# EXPECT: 42
include types
include alloc
include mem.arena
import Arena, arena_new, arena_alloc, arena_alloc_aligned, arena_alloc_zeroed, arena_reserve, arena_bulk_zero, arena_bulk_fill, arena_bulk_copy, arena_reset, arena_free, arena_used, arena_remaining, arena_save, arena_restore from mem.arena
include mem.copy
import mem_copy, mem_set, mem_zero, mem_move, mem_cmp, mem_copy_scalar, mem_set_scalar, mem_move_scalar from mem.copy

func verify_slice_byte(p: ptr, len: int, expected: int):
    var i = 0
    when i < len loop
        let b = native_read_u8(p as int, i)
        if b != (expected and 255) do
            print 991
            out 0
        end
        i = i + 1
    end
    out 1
end.

func main:
    let a = arena_new(4096)

    # 1. Zero-sized allocation contract
    let off_before = arena_used(a)
    let p_zero = arena_reserve(a, 0, 8)
    if p_zero == null or arena_used(a) != off_before do
        print 100
        out 1
    end
    let p_zero_16 = arena_reserve(a, 0, 16)
    if p_zero_16 == null or arena_used(a) != off_before or ((p_zero_16 as int) and 15) != 0 do
        print 101
        out 1
    end

    # 2. Alignment rejection for non-power-of-two, zero, and negative alignments
    if arena_reserve(a, 16, 7) != null do
        print 102
        out 1
    end
    if arena_reserve(a, 16, 0) != null do
        print 103
        out 1
    end
    if arena_reserve(a, 16, 0 - 8) != null do
        print 104
        out 1
    end
    if arena_reserve(a, 16, 12) != null do
        print 105
        out 1
    end

    # 3. Edge-case and boundary sizes with guard bytes
    let sizes = [1, 7, 8, 15, 16, 17, 31, 32, 33, 64, 128]
    var si = 0
    when si < 11 loop
        let sz = sizes[si]
        let total_sz = 16 + sz + 16
        let raw = arena_alloc(a, total_sz)
        let guard_before = raw
        let payload = raw + 16
        let guard_after = raw + 16 + sz

        # Set guards
        mem_set(guard_before, 0xAA, 16)
        mem_set(guard_after, 0xBB, 16)

        # Zero and fill payload
        arena_bulk_zero(a, payload, sz)
        if verify_slice_byte(payload, sz, 0) == 0 do
            print 106
            out 1
        end

        arena_bulk_fill(a, payload, 0x5A, sz)
        if verify_slice_byte(payload, sz, 0x5A) == 0 do
            print 107
            out 1
        end

        # Verify guards untouched
        if verify_slice_byte(guard_before, 16, 0xAA) == 0 or verify_slice_byte(guard_after, 16, 0xBB) == 0 do
            print 108
            out 1
        end

        # Guarded copy
        let dst_raw = arena_alloc(a, total_sz)
        let dst_guard_before = dst_raw
        let dst_payload = dst_raw + 16
        let dst_guard_after = dst_raw + 16 + sz
        mem_set(dst_guard_before, 0xCC, 16)
        mem_set(dst_guard_after, 0xDD, 16)

        arena_bulk_copy(dst_payload, payload, sz)
        if mem_cmp(dst_payload, payload, sz) != 0 do
            print 109
            out 1
        end
        if verify_slice_byte(dst_guard_before, 16, 0xCC) == 0 or verify_slice_byte(dst_guard_after, 16, 0xDD) == 0 do
            print 110
            out 1
        end

        si = si + 1
    end

    # 4. Bidirectional Overlapping copy: forward and backward
    let buf = arena_alloc(a, 64)
    # Initialize with 0, 1, 2, ..., 63
    var bi = 0
    when bi < 64 loop
        native_write_u8(buf as int, bi, bi)
        bi = bi + 1
    end

    # Forward overlap: copy buf[0..32] to buf[8..40]
    mem_move(buf + 8, buf, 32)
    var fi = 0
    when fi < 32 loop
        if native_read_u8(buf as int, 8 + fi) != fi do
            print 111
            out 1
        end
        fi = fi + 1
    end

    # Backward overlap: re-init and copy buf[8..40] to buf[0..32]
    bi = 0
    when bi < 64 loop
        native_write_u8(buf as int, bi, bi)
        bi = bi + 1
    end
    mem_move(buf, buf + 8, 32)
    var bki = 0
    when bki < 32 loop
        if native_read_u8(buf as int, bki) != (8 + bki) do
            print 112
            out 1
        end
        bki = bki + 1
    end

    # 5. Overaligned allocation
    let p_aligned32 = arena_alloc_aligned(a, 64, 32)
    if ((p_aligned32 as int) and 31) != 0 do
        print 113
        out 1
    end

    # 6. Negative and overflow rejection
    let prev_offset = arena_used(a)
    let p_neg = arena_reserve(a, 0 - 5, 8)
    if p_neg != null or arena_used(a) != prev_offset do
        print 114
        out 1
    end

    # 7. Reset and restore
    let cp = arena_save(a)
    let p_temp = arena_alloc(a, 128)
    arena_restore(a, cp)
    if arena_used(a) != cp do
        print 115
        out 1
    end

    arena_reset(a)
    if arena_used(a) != 0 do
        print 116
        out 1
    end

    arena_free(a)

    print 42
    out 0
end.
