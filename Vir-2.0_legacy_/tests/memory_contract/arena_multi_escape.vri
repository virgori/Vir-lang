func main:
    var arr1: int = 0
    var arr2: int = 0
    arena:
        var a = [1, 2, 3]
        var b = [7, 8, 9]
        arr1 = a
        arr2 = b
    end
    # After arena reset, both a and b should be independently accessible
    # arr1[1] must be 2 (not 8), arr2[1] must be 8
    print arr1[1]
    print arr2[1]
end.
