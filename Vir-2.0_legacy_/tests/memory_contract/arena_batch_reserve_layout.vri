include types
include alloc
include mem.arena
import Arena, ArenaBatchLayout, arena_new, arena_batch_reserve2, arena_free from mem.arena

func main:
    var a = arena_new(256)
    let layout = arena_batch_reserve2(a, 12, 8, 24, 16)
    if layout.valid == 0 do
        print -1
        out 1
    end
    let base = layout.base as int
    native_write_i64(base + layout.off0, 0, 10)
    native_write_i64(base + layout.off1, 0, 20)
    native_write_i64(base + layout.off1, 8, 30)
    native_write_i64(base + layout.off1, 16, 40)

    print native_read_i64(base + layout.off0, 0)
    print native_read_i64(base + layout.off1, 0)
    print native_read_i64(base + layout.off1, 8)
    print native_read_i64(base + layout.off1, 16)

    let saved_off = a.offset
    let bad1 = arena_batch_reserve2(a, 9223372036854771700, 16, 100, 16)
    let bad2 = arena_batch_reserve2(a, 16, 12, 16, 16)
    if bad1.valid != 0 or bad2.valid != 0 or a.offset != saved_off do
        print 999
    else
        print 0
    end
    arena_free(a)
    out 0
end.
