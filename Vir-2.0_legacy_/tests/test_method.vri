entity Counter:
    val: int

    method inc:
        this.val = this.val + 1
    end.
    method add(n: int):
        this.val = this.val + n
    end.
    method get_val: int
        out this.val
    end.
end.
func main:
    var c = Counter(val: 10)
    c.inc()
    print c.get_val()
    c.add(5)
    print c.get_val()
    c.add(10)
    print c.get_val()
end.
