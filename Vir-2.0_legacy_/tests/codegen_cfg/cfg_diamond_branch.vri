# Diamond CFG branching
func test_diamond(x, y):
    var z = 0
    if x > y do
        z = x - y
    else
        z = y - x
    end
    if z > 10 do
        z = z * 2
    else
        z = z + 100
    end
    out z
end.

func main:
    print test_diamond(20, 5)
    print test_diamond(5, 20)
    print test_diamond(8, 5)
    out 0
end.
