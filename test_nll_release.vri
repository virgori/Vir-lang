# §4.8 NLL — reassigning the borrower releases the borrow (good program)
func take(p):
    out p[0]
end

func main:
    var a = [1, 2, 3]
    var b = &a          # b borrows a (shared)
    print a[0]          # OK — shared borrow still live but read is fine
    b = 0               # reassign b to non-borrow → release a's shared count
    var r = take(a)     # OK — no active borrow on 'a' anymore; a is moved
    print r
end.
