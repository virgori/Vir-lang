// PTX Kernel: ReLU Activation (element-wise)
// Target: sm_70+
// C[i] = max(0, A[i])

.version 7.8
.target sm_70
.address_size 64

.visible .entry vir_relu_f32(
    .param .u64 param_A,
    .param .u64 param_C,
    .param .u32 param_N
) {
    .reg .u32   %tid, %n;
    .reg .u64   %addr_a, %addr_c, %off;
    .reg .f32   %a, %zero, %c;
    .reg .pred  %p;

    mov.u32     %tid, %ctaid.x;
    mul.lo.u32  %tid, %tid, %ntid.x;
    mov.u32     %n, %tid.x;
    add.u32     %tid, %tid, %n;

    ld.param.u32 %n, [param_N];
    setp.ge.u32  %p, %tid, %n;
    @%p bra      $L_exit;

    cvt.u64.u32  %off, %tid;
    shl.b64      %off, %off, 2;

    ld.param.u64 %addr_a, [param_A];
    add.u64      %addr_a, %addr_a, %off;
    ld.global.f32 %a, [%addr_a];

    mov.f32      %zero, 0f00000000;
    max.f32      %c, %a, %zero;

    ld.param.u64 %addr_c, [param_C];
    add.u64      %addr_c, %addr_c, %off;
    st.global.f32 [%addr_c], %c;

$L_exit:
    ret;
}
