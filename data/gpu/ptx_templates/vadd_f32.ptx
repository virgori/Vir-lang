// PTX Kernel: Vector Addition (CUDA)
// Target: sm_70+ (Volta and newer)
// Usage: vir_gpu_cuda_load_ptx(ptx_source, ptx_len, &module)

.version 7.8
.target sm_70
.address_size 64

.visible .entry vir_vadd_f32(
    .param .u64 param_A,
    .param .u64 param_B,
    .param .u64 param_C,
    .param .u32 param_N
) {
    .reg .u32   %tid, %n;
    .reg .u64   %addr_a, %addr_b, %addr_c, %off;
    .reg .f32   %a, %b, %c;
    .reg .pred  %p;

    // tid = blockIdx.x * blockDim.x + threadIdx.x
    mov.u32     %tid, %ctaid.x;
    mul.lo.u32  %tid, %tid, %ntid.x;
    mov.u32     %n, %tid.x;
    add.u32     %tid, %tid, %n;

    // Bounds check
    ld.param.u32 %n, [param_N];
    setp.ge.u32  %p, %tid, %n;
    @%p bra      $L_exit;

    // Compute byte offset
    cvt.u64.u32  %off, %tid;
    shl.b64      %off, %off, 2;

    // Load A[tid]
    ld.param.u64 %addr_a, [param_A];
    add.u64      %addr_a, %addr_a, %off;
    ld.global.f32 %a, [%addr_a];

    // Load B[tid]
    ld.param.u64 %addr_b, [param_B];
    add.u64      %addr_b, %addr_b, %off;
    ld.global.f32 %b, [%addr_b];

    // C[tid] = A[tid] + B[tid]
    add.f32      %c, %a, %b;

    // Store C[tid]
    ld.param.u64 %addr_c, [param_C];
    add.u64      %addr_c, %addr_c, %off;
    st.global.f32 [%addr_c], %c;

$L_exit:
    ret;
}
