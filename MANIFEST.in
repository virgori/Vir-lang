include README.md
include LICENSE

# Native shared libraries (bundled per-platform)
recursive-include src/native/lib *.dylib *.so *.dll *.a

# Compiled stdlib
recursive-include stdlib *.vsib *.sri

# Core C/ASM source (for source distribution)
recursive-include core/src *.c *.h
recursive-include core/asm *.S
recursive-include core/include *.h
include core/Makefile
