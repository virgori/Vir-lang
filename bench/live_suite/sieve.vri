func run_sieve(limit):
    let is_prime = alloc(limit + 1)
    var i = 0
    when i <= limit loop
        write_byte(is_prime, i, 1)
        i = i + 1
    end
    write_byte(is_prime, 0, 0)
    write_byte(is_prime, 1, 0)

    var p = 2
    when p * p <= limit loop
        if read_byte(is_prime, p) == 1 do
            var k = p * p
            when k <= limit loop
                write_byte(is_prime, k, 0)
                k = k + p
            end
        end
        p = p + 1
    end

    var count = 0
    var c = 0
    when c <= limit loop
        if read_byte(is_prime, c) == 1 do
            count = count + 1
        end
        c = c + 1
    end
    out count
end.

func main:
    var iter = 0
    var total_primes = 0
    when iter < 10 loop
        total_primes = run_sieve(1000000)
        iter = iter + 1
    end
    print_str("Primes count: ")
    print(total_primes)
end.
