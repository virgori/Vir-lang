func qsort(arr, low, high):
    if low < high do
        let pivot = read_word(arr, high * 8)
        var i = low
        var j = low
        when j < high loop
            if read_word(arr, j * 8) <= pivot do
                # Swap arr[i] and arr[j]
                let temp = read_word(arr, i * 8)
                write_word(arr, i * 8, read_word(arr, j * 8))
                write_word(arr, j * 8, temp)
                i = i + 1
            end
            j = j + 1
        end
        let temp2 = read_word(arr, i * 8)
        write_word(arr, i * 8, read_word(arr, high * 8))
        write_word(arr, high * 8, temp2)

        let pi = i
        if pi > 0 do
            qsort(arr, low, pi - 1)
        end
        qsort(arr, pi + 1, high)
    end
end.

func main:
    let n = 100000
    let arr = alloc(n * 8)
    var i = 0
    when i < n loop
        # Simple pseudo-random LCG
        write_word(arr, i * 8, (i * 1664525 + 1013904223) mod 1000000)
        i = i + 1
    end

    qsort(arr, 0, n - 1)

    print_str("Qsort Checksum: ")
    print(read_word(arr, (n / 2) * 8))
end.
