func scale(this, n):
    out this * n
end.

func clamp(this, lo, hi):
    if this < lo: do
        out lo
    end
    if this > hi: do
        out hi
    end
    out this
end.

func main:
    var x = 7
    var a = x.scale(3)
    var b = x.clamp(0, 10)
    var c = 15.clamp(0, 10)
    print a
    print b
    print c
end.
