var total = 0
var multiplier = 3

func accumulate(x: int):
    total = total + x * multiplier
end.

func set_mult(m: int):
    multiplier = m
end.

func main():
    accumulate(10)
    print total
    accumulate(5)
    print total
    set_mult(2)
    accumulate(7)
    print total
    print multiplier
end.
