# ═══════════════════════════════════════════════════════════════════════════════
# Vir → Swift Transpilation Demo
# ═══════════════════════════════════════════════════════════════════════════════
# 
# This file demonstrates Vir syntax and its Swift equivalent.
# Run: vir transpile examples/swift_demo/demo.vir
#
# Expected output: .build/swift/demo.swift
# ═══════════════════════════════════════════════════════════════════════════════

import Foundation

# ─────────────────────────────────────────────────────────────────────────────
# 1. Entity Definition (Vir) → Struct (Swift)
# ─────────────────────────────────────────────────────────────────────────────

entity Point
    x: f64
    y: f64
end

entity Rectangle
    origin: Point
    width: f64
    height: f64
end

# ─────────────────────────────────────────────────────────────────────────────
# 2. Enum Definition
# ─────────────────────────────────────────────────────────────────────────────

enum Color
    Red = 0
    Green = 1
    Blue = 2
end

enum Shape
    Circle
    Square
    Triangle
end

# ─────────────────────────────────────────────────────────────────────────────
# 3. Function Definitions
# ─────────────────────────────────────────────────────────────────────────────

func add(a: i32, b: i32) -> i32
    out a + b
end

func distance(p1: Point, p2: Point) -> f64
    var dx = p2.x - p1.x
    var dy = p2.y - p1.y
    out sqrt(dx * dx + dy * dy)
end

func area(rect: Rectangle) -> f64
    out rect.width * rect.height
end

# ─────────────────────────────────────────────────────────────────────────────
# 4. Control Flow
# ─────────────────────────────────────────────────────────────────────────────

func fibonacci(n: i32) -> i32
    if n <= 1 then
        out n
    end
    out fibonacci(n - 1) + fibonacci(n - 2)
end

func factorial(n: i32) -> i32
    var result = 1
    var i = 1
    while i <= n
        result = result * i
        i = i + 1
    end
    out result
end

func sum_range(start: i32, end_val: i32) -> i32
    var total = 0
    for i in start..end_val
        total = total + i
    end
    out total
end

# ─────────────────────────────────────────────────────────────────────────────
# 5. Collections
# ─────────────────────────────────────────────────────────────────────────────

func make_points() -> Vec<Point>
    var points = vec_new<Point>()
    vec_push(points, Point { x: 0.0, y: 0.0 })
    vec_push(points, Point { x: 1.0, y: 1.0 })
    vec_push(points, Point { x: 2.0, y: 4.0 })
    out points
end

func find_max(numbers: Vec<i32>) -> i32
    var max_val = numbers[0]
    for i in 1..len(numbers)
        if numbers[i] > max_val then
            max_val = numbers[i]
        end
    end
    out max_val
end

# ─────────────────────────────────────────────────────────────────────────────
# 6. String Operations
# ─────────────────────────────────────────────────────────────────────────────

func greet(name: String) -> String
    var greeting = str_cat("Hello, ", name)
    out str_cat(greeting, "!")
end

func is_palindrome(s: String) -> bool
    var left = 0
    var right = len(s) - 1
    while left < right
        if s[left] != s[right] then
            out false
        end
        left = left + 1
        right = right - 1
    end
    out true
end

# ─────────────────────────────────────────────────────────────────────────────
# 7. Main Entry Point
# ─────────────────────────────────────────────────────────────────────────────

func main() -> i32
    # Test basic arithmetic
    print("Testing arithmetic...")
    var result = add(10, 20)
    print(result)
    
    # Test entity creation
    print("Testing entities...")
    var p1 = Point { x: 0.0, y: 0.0 }
    var p2 = Point { x: 3.0, y: 4.0 }
    var dist = distance(p1, p2)
    print(dist)
    
    # Test recursion
    print("Testing fibonacci...")
    var fib10 = fibonacci(10)
    print(fib10)
    
    # Test loops
    print("Testing factorial...")
    var fact5 = factorial(5)
    print(fact5)
    
    # Test collections
    print("Testing collections...")
    var numbers = [1, 5, 3, 9, 2]
    var max_num = find_max(numbers)
    print(max_num)
    
    # Test strings
    print("Testing strings...")
    var greeting = greet("World")
    print(greeting)
    
    print("All tests completed!")
    out 0
end
