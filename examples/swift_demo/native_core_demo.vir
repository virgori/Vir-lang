# ═══════════════════════════════════════════════════════════════════════════════
# Vir Native Core Example — High Performance Math Operations
# ═══════════════════════════════════════════════════════════════════════════════
# 
# This file demonstrates how Vir code calls native C/Rust libraries
# for performance-critical operations.
#
# Architecture:
#   Vir → Swift → Native Bridge → C/Rust Static Library
#
# The heavy computation (SIMD, matrix ops) runs in optimized native code,
# while Vir provides the clean high-level syntax.
# ═══════════════════════════════════════════════════════════════════════════════

import Foundation
import VirNativeCore  # Our C/Rust static library

# ─────────────────────────────────────────────────────────────────────────────
# Native Function Declarations
# ─────────────────────────────────────────────────────────────────────────────
# These declarations tell Vir how to call the native library.
# The actual implementation is in libvir_native.a (C/Rust).

@native("vir_simd_dot_f32")
func native_dot_product(a: ptr, b: ptr, len: i64) -> f32

@native("vir_simd_matmul_f32")
func native_matmul(a: ptr, b: ptr, out: ptr, m: i64, n: i64, k: i64)

@native("vir_simd_relu_f32")
func native_relu(data: ptr, len: i64)

# ─────────────────────────────────────────────────────────────────────────────
# High-Level Vir Wrappers
# ─────────────────────────────────────────────────────────────────────────────
# These provide a clean Vir API that internally calls native code.

entity Vector
    data: Vec<f32>
    len: i64
end

entity Matrix
    data: Vec<f32>
    rows: i64
    cols: i64
end

func vec_new(size: i64) -> Vector
    var data = vec_new<f32>()
    for i in 0..size
        vec_push(data, 0.0)
    end
    out Vector { data: data, len: size }
end

func mat_new(rows: i64, cols: i64) -> Matrix
    var data = vec_new<f32>()
    for i in 0..(rows * cols)
        vec_push(data, 0.0)
    end
    out Matrix { data: data, rows: rows, cols: cols }
end

# Dot product using native SIMD
func dot(a: Vector, b: Vector) -> f32
    # Get raw pointers to the data
    var a_ptr = vec_data_ptr(a.data)
    var b_ptr = vec_data_ptr(b.data)
    
    # Call native SIMD implementation
    out native_dot_product(a_ptr, b_ptr, a.len)
end

# Matrix multiplication using native SIMD/AVX
func matmul(a: Matrix, b: Matrix) -> Matrix
    var out_mat = mat_new(a.rows, b.cols)
    
    var a_ptr = vec_data_ptr(a.data)
    var b_ptr = vec_data_ptr(b.data)
    var out_ptr = vec_data_ptr(out_mat.data)
    
    # Call native implementation (uses AVX-512 on supported hardware)
    native_matmul(a_ptr, b_ptr, out_ptr, a.rows, b.cols, a.cols)
    
    out out_mat
end

# ReLU activation using native SIMD
func relu_inplace(v: Vector)
    var data_ptr = vec_data_ptr(v.data)
    native_relu(data_ptr, v.len)
end

# ─────────────────────────────────────────────────────────────────────────────
# Pure Vir Implementations (for comparison)
# ─────────────────────────────────────────────────────────────────────────────

func dot_pure_vir(a: Vector, b: Vector) -> f32
    var sum = 0.0
    for i in 0..a.len
        sum = sum + a.data[i] * b.data[i]
    end
    out sum
end

func relu_pure_vir(v: Vector)
    for i in 0..v.len
        if v.data[i] < 0.0 then
            v.data[i] = 0.0
        end
    end
end

# ─────────────────────────────────────────────────────────────────────────────
# Benchmark
# ─────────────────────────────────────────────────────────────────────────────

func benchmark_dot(size: i64, iterations: i64)
    print("Benchmarking dot product...")
    
    var a = vec_new(size)
    var b = vec_new(size)
    
    # Fill with random data
    for i in 0..size
        a.data[i] = random_f32()
        b.data[i] = random_f32()
    end
    
    # Benchmark native
    var start = timestamp_ns()
    for _ in 0..iterations
        var _ = dot(a, b)
    end
    var native_time = timestamp_ns() - start
    
    # Benchmark pure Vir
    start = timestamp_ns()
    for _ in 0..iterations
        var _ = dot_pure_vir(a, b)
    end
    var vir_time = timestamp_ns() - start
    
    print("Native SIMD: ")
    print(native_time / iterations)
    print(" ns/op")
    
    print("Pure Vir: ")
    print(vir_time / iterations)
    print(" ns/op")
    
    print("Speedup: ")
    print(vir_time / native_time)
    print("x")
end

# ─────────────────────────────────────────────────────────────────────────────
# Main
# ─────────────────────────────────────────────────────────────────────────────

func main() -> i32
    print("Vir Native Core Demo")
    print("====================")
    
    # Test dot product
    var a = Vector { data: [1.0, 2.0, 3.0, 4.0], len: 4 }
    var b = Vector { data: [5.0, 6.0, 7.0, 8.0], len: 4 }
    
    var result = dot(a, b)
    print("Dot product: ")
    print(result)  # Should be 70.0
    
    # Test matrix multiplication
    print("\nMatrix multiplication:")
    var m1 = Matrix { 
        data: [1.0, 2.0, 3.0, 4.0], 
        rows: 2, 
        cols: 2 
    }
    var m2 = Matrix { 
        data: [5.0, 6.0, 7.0, 8.0], 
        rows: 2, 
        cols: 2 
    }
    
    var m3 = matmul(m1, m2)
    print("Result: ")
    for i in 0..4
        print(m3.data[i])
    end
    
    # Benchmark
    print("\n--- Benchmark ---")
    benchmark_dot(10000, 1000)
    
    out 0
end
