# =====================================================================
# Vir-Todo: Fast Standalone Native CLI Task Manager
# Written in 100% Pure Vir (Zero-Libc, Direct Syscalls)
# =====================================================================

# ---------------------------------------------------------------------
# String & Buffer Utilities (Canonical Contract: 0 = Null)
# ---------------------------------------------------------------------

func cstr_len(s):
    if s == 0 do out 0 end
    var i = 0
    when read_byte(s, i) != 0 loop
        i = i + 1
    end
    out i
end.

func cstr_eq(a, b):
    if a == 0 do
        if b == 0 do out 1 end
        out 0
    end
    if b == 0 do out 0 end
    let la = cstr_len(a)
    let lb = cstr_len(b)
    if la != lb do out 0 end
    var i = 0
    when i < la loop
        if read_byte(a, i) != read_byte(b, i) do
            out 0
        end
        i = i + 1
    end
    out 1
end.

func append_cstr(dst, dst_idx, src):
    if src == 0 do out dst_idx end
    let sl = cstr_len(src)
    var i = 0
    when i < sl loop
        write_byte(dst, dst_idx, read_byte(src, i))
        dst_idx = dst_idx + 1
        i = i + 1
    end
    write_byte(dst, dst_idx, 0)
    out dst_idx
end.

func append_int(dst, dst_idx, num):
    let s = int_to_str(num)
    out append_cstr(dst, dst_idx, s)
end.

func parse_int(s):
    let sl = cstr_len(s)
    if sl == 0 do out 0 end
    var res = 0
    var i = 0
    when i < sl loop
        let b = read_byte(s, i)
        if b >= 48 do
            if b <= 57 do
                res = res * 10 + (b - 48)
            end
        end
        i = i + 1
    end
    out res
end.

# ---------------------------------------------------------------------
# Database & File Store Operations (todos.txt)
# ---------------------------------------------------------------------

func get_db_path:
    out "todos.txt"
end.

func load_db_content:
    let path = get_db_path()
    let buf = slurp_file(path)
    if buf == 0 do out 0 end
    out buf
end.

func add_task(title):
    let path = get_db_path()
    let prev_content = load_db_content()
    let new_buf = alloc(65536)
    var idx = 0

    if prev_content != 0 do
        idx = append_cstr(new_buf, idx, prev_content)
    end

    # Append: "0|<title>\n"
    idx = append_cstr(new_buf, idx, "0|")
    idx = append_cstr(new_buf, idx, title)
    write_byte(new_buf, idx, 10) # '\n'
    idx = idx + 1
    write_byte(new_buf, idx, 0)

    write_bytes(path, new_buf, idx)

    let msg = alloc(256)
    var m = 0
    m = append_cstr(msg, m, "  [+] Added task: \"")
    m = append_cstr(msg, m, title)
    m = append_cstr(msg, m, "\"")
    print_str(msg)
end.

func list_tasks:
    let content = load_db_content()

    if content == 0 do
        print_str("  (No tasks found. Use 'vir-todo add \"...\"' to create one!)")
        out 0
    end

    let clen = cstr_len(content)
    if clen == 0 do
        print_str("  (No tasks found. Use 'vir-todo add \"...\"' to create one!)")
        out 0
    end

    print_str("--------------------------------------------------")
    print_str("  ID     STATUS       TASK DESCRIPTION")
    print_str("--------------------------------------------------")

    var p = 0
    var task_id = 1
    var total_tasks = 0
    var done_tasks = 0

    when p < clen loop
        let status_byte = read_byte(content, p)
        var is_done = 0
        if status_byte == 49 do # '1'
            is_done = 1
            done_tasks = done_tasks + 1
        end

        var title_start = p + 2
        if title_start > clen do title_start = clen end

        # Search for newline '\n'
        var line_end = title_start
        var scanning = 1
        when scanning != 0 loop
            if line_end >= clen do
                scanning = 0
            else
                if read_byte(content, line_end) == 10 do
                    scanning = 0
                else
                    line_end = line_end + 1
                end
            end
        end

        let title_len = line_end - title_start
        let title_buf = alloc(title_len + 1)
        var t = 0
        when t < title_len loop
            write_byte(title_buf, t, read_byte(content, title_start + t))
            t = t + 1
        end
        write_byte(title_buf, t, 0)

        # Format row
        let row = alloc(512)
        var r = 0
        r = append_cstr(row, r, "  [")
        r = append_int(row, r, task_id)
        r = append_cstr(row, r, "]   ")
        if is_done != 0 do
            r = append_cstr(row, r, "[DONE]    ")
        else
            r = append_cstr(row, r, "[TODO]    ")
        end
        r = append_cstr(row, r, title_buf)
        print_str(row)

        total_tasks = total_tasks + 1
        task_id = task_id + 1
        p = line_end + 1
    end

    print_str("--------------------------------------------------")
    let summary = alloc(128)
    var s = 0
    s = append_cstr(summary, s, "  Summary: ")
    s = append_int(summary, s, done_tasks)
    s = append_cstr(summary, s, " of ")
    s = append_int(summary, s, total_tasks)
    s = append_cstr(summary, s, " tasks completed.")
    print_str(summary)
    print_str("--------------------------------------------------")
    out total_tasks
end.

func mark_done(target_id):
    let path = get_db_path()
    let content = load_db_content()
    if content == 0 do
        print_str("vir-todo: error: no tasks file found")
        out 0
    end

    let clen = cstr_len(content)
    let new_buf = alloc(65536)
    var out_p = 0
    var p = 0
    var current_id = 1
    var found = 0

    when p < clen loop
        var line_end = p
        var scanning = 1
        when scanning != 0 loop
            if line_end >= clen do
                scanning = 0
            else
                if read_byte(content, line_end) == 10 do
                    scanning = 0
                else
                    line_end = line_end + 1
                end
            end
        end

        if current_id == target_id do
            # Mark status as '1' (Done)
            write_byte(new_buf, out_p, 49) # '1'
            out_p = out_p + 1

            # Copy remaining line starting from p + 1 up to line_end
            var k = p + 1
            when k <= line_end loop
                write_byte(new_buf, out_p, read_byte(content, k))
                out_p = out_p + 1
                k = k + 1
            end
            found = 1
        else
            # Copy untouched line
            var k2 = p
            when k2 <= line_end loop
                write_byte(new_buf, out_p, read_byte(content, k2))
                out_p = out_p + 1
                k2 = k2 + 1
            end
        end

        current_id = current_id + 1
        p = line_end + 1
    end

    if found != 0 do
        write_bytes(path, new_buf, out_p)
        let msg = alloc(128)
        var m = 0
        m = append_cstr(msg, m, "  [+] Marked task #")
        m = append_int(msg, m, target_id)
        m = append_cstr(msg, m, " as completed!")
        print_str(msg)
    else
        let msg2 = alloc(128)
        var m2 = 0
        m2 = append_cstr(msg2, m2, "vir-todo: task #")
        m2 = append_int(msg2, m2, target_id)
        m2 = append_cstr(msg2, m2, " not found")
        print_str(msg2)
    end
    out found
end.

func clear_tasks:
    let path = get_db_path()
    write_bytes(path, "", 0)
    print_str("  [+] Cleared all tasks.")
end.

# ---------------------------------------------------------------------
# CLI Presentation
# ---------------------------------------------------------------------

func print_banner:
    print_str("============================================")
    print_str("          V I R - T O D O   v1.0            ")
    print_str("     High-Speed Native CLI Task Manager     ")
    print_str("============================================")
end.

func print_help:
    print_banner()
    print_str("Usage: vir-todo <command> [arguments]")
    print_str("")
    print_str("Commands:")
    print_str("  add \"<text>\"   Add a new task")
    print_str("  list (ls)      List all tasks with status")
    print_str("  done <id>      Mark task as completed")
    print_str("  clear          Remove all tasks")
    print_str("  version (-v)   Show version")
    print_str("  help (-h)      Show this help menu")
    print_str("")
    print_str("Examples:")
    print_str("  vir-todo add \"Design Vir Web Framework\"")
    print_str("  vir-todo list")
    print_str("  vir-todo done 1")
end.

func main:
    let argc = arg_count()
    if argc <= 1 do
        print_help()
        exit_prog(0)
    end

    let cmd = get_arg(1)

    if cstr_eq(cmd, "help") != 0 do
        print_help()
        exit_prog(0)
    end
    if cstr_eq(cmd, "-h") != 0 do
        print_help()
        exit_prog(0)
    end
    if cstr_eq(cmd, "--help") != 0 do
        print_help()
        exit_prog(0)
    end

    if cstr_eq(cmd, "version") != 0 do
        print_str("vir-todo 1.0.0 (Native ARM64 standalone binary - Pure Vir)")
        exit_prog(0)
    end
    if cstr_eq(cmd, "-v") != 0 do
        print_str("vir-todo 1.0.0 (Native ARM64 standalone binary - Pure Vir)")
        exit_prog(0)
    end
    if cstr_eq(cmd, "--version") != 0 do
        print_str("vir-todo 1.0.0 (Native ARM64 standalone binary - Pure Vir)")
        exit_prog(0)
    end

    if cstr_eq(cmd, "add") != 0 do
        if argc <= 2 do
            print_str("vir-todo: error: 'add' requires a task description")
            print_str("Usage: vir-todo add \"Your task description\"")
            exit_prog(1)
        end
        let title = get_arg(2)
        add_task(title)
        exit_prog(0)
    end

    if cstr_eq(cmd, "list") != 0 do
        list_tasks()
        exit_prog(0)
    end
    if cstr_eq(cmd, "ls") != 0 do
        list_tasks()
        exit_prog(0)
    end

    if cstr_eq(cmd, "done") != 0 do
        if argc <= 2 do
            print_str("vir-todo: error: 'done' requires a task ID number")
            print_str("Usage: vir-todo done <id>")
            exit_prog(1)
        end
        let id_str = get_arg(2)
        let target_id = parse_int(id_str)
        if target_id <= 0 do
            print_str("vir-todo: error: invalid task ID number")
            exit_prog(1)
        end
        mark_done(target_id)
        exit_prog(0)
    end

    if cstr_eq(cmd, "clear") != 0 do
        clear_tasks()
        exit_prog(0)
    end

    let err_msg = alloc(128)
    var e = 0
    e = append_cstr(err_msg, e, "vir-todo: unknown command '")
    e = append_cstr(err_msg, e, cmd)
    e = append_cstr(err_msg, e, "'. Run 'vir-todo help' for usage.")
    print_str(err_msg)
    exit_prog(1)
end.
