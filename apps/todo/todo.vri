##
 * apps/todo/todo.vri — Module quản lý công việc
 * ================================================
 * Showcase các cú pháp Vir:
 *   const · enum · entity · func · out · var · let
 *   if/eif/else · when loop · for range · break · skip
 *   arr_new / push / indexing · str_cat · str_len
 ##


# ══════════════════════════════════════════════
# CONST — hằng số toàn cục
# ══════════════════════════════════════════════

const MAX_TASKS:  64;
const APP_NAME:   "VirTask";
const VERSION:    "1.0.0";


# ══════════════════════════════════════════════
# ENUM — trạng thái công việc
# ══════════════════════════════════════════════

enum Status:
    Pending   = 0
    Done      = 1
    Cancelled = 2
end


# ══════════════════════════════════════════════
# ENUM — độ ưu tiên
# ══════════════════════════════════════════════

enum Priority:
    Low    = 0
    Medium = 1
    High   = 2
end


# ══════════════════════════════════════════════
# ENTITY — một công việc
# ══════════════════════════════════════════════

entity TodoItem:
    id:       int;
    title:    string;
    status:   int;     # dùng enum Status
    priority: int;     # dùng enum Priority
    score:    int;     # điểm ưu tiên tính toán
end


# ══════════════════════════════════════════════
# GLOBAL VAR — bộ đếm tự tăng cho id
# ══════════════════════════════════════════════

var _next_id = 1;


# ──────────────────────────────────────────────
# Tạo mới một TodoItem — func với typed params,
# entity literal, out
# ──────────────────────────────────────────────

func todo_new(title: string, priority: int) -> TodoItem:
    var id = _next_id
    _next_id = _next_id + 1
    out TodoItem ( id: id, title: title, status: Status.Pending, priority: priority, score: 0 )
end


# ──────────────────────────────────────────────
# Tính điểm: if / eif / else
# ──────────────────────────────────────────────

func calc_score(priority: int, status: int) -> int:
    if status == Status.Done:
        out 0                           # việc xong không còn điểm
    eif priority == Priority.High:
        out 30
    eif priority == Priority.Medium:
        out 20
    else
        out 10
    end
end


# ──────────────────────────────────────────────
# Cập nhật score — gán lại trường entity
# ──────────────────────────────────────────────

func todo_refresh_score(item: TodoItem) -> TodoItem:
    item.score = calc_score(item.priority, item.status)
    out item
end


# ──────────────────────────────────────────────
# Đánh dấu hoàn thành
# ──────────────────────────────────────────────

func todo_complete(item: TodoItem) -> TodoItem:
    item.status = Status.Done
    item = todo_refresh_score(item)
    out item
end


# ──────────────────────────────────────────────
# Huỷ bỏ
# ──────────────────────────────────────────────

func todo_cancel(item: TodoItem) -> TodoItem:
    item.status = Status.Cancelled
    item.score  = 0
    out item
end


# ──────────────────────────────────────────────
# Label trạng thái — func trả string
# ──────────────────────────────────────────────

func status_label(status: int) -> string:
    if status == Status.Done:
        out "[DONE]  "
    eif status == Status.Cancelled:
        out "[SKIP]  "
    else
        out "[TODO]  "
    end
end


# ──────────────────────────────────────────────
# Label ưu tiên
# ──────────────────────────────────────────────

func priority_label(p: int) -> string:
    if p == Priority.High:
        out "!!! "
    eif p == Priority.Medium:
        out "!!  "
    else
        out ".   "
    end
end


# ──────────────────────────────────────────────
# In một TodoItem — str_cat ghép chuỗi
# ──────────────────────────────────────────────

func todo_print(item: TodoItem):
    var line = priority_label(item.priority)
    line = str_cat(line, status_label(item.status))
    line = str_cat(line, item.title)
    print_str(line)
end


# ──────────────────────────────────────────────
# Thêm vào danh sách (arr push)
# ──────────────────────────────────────────────

func list_add(list, item: TodoItem):
    push(list, item)
end


# ──────────────────────────────────────────────
# In toàn bộ list — for range loop
# ──────────────────────────────────────────────

func list_print_all(list):
    let n = len(list)
    for i in 0..n:
        var item = list[i]
        item = todo_refresh_score(item)
        todo_print(item)
    end
end


# ──────────────────────────────────────────────
# Đếm số task theo status — when loop + break
# ──────────────────────────────────────────────

func list_count_by_status(list, target_status: int) -> int:
    var total = len(list)
    var i     = 0
    var count = 0
    when i < total loop
        var item = list[i]
        if item.status == target_status:
            count = count + 1
        end
        i = i + 1
    end
    out count
end


# ──────────────────────────────────────────────
# Tổng điểm còn lại — when loop + skip (bỏ qua Done/Cancelled)
# ──────────────────────────────────────────────

func list_total_score(list) -> int:
    var n     = len(list)
    var i     = 0
    var total = 0
    when i < n loop
        var item = list[i]
        i = i + 1
        if item.status != Status.Pending:
            skip                        # chỉ tính task đang chờ
        end
        total = total + calc_score(item.priority, item.status)
    end
    out total
end


# ──────────────────────────────────────────────
# Lọc các task High priority còn pending vào list mới
# (minh hoạ dùng arr_new + push + for range)
# ──────────────────────────────────────────────

func list_high_priority(list):
    var result = arr_new(MAX_TASKS)
    let n      = len(list)
    for i in 0..n:
        var item = list[i]
        if item.priority == Priority.High:
            if item.status == Status.Pending:
                push(result, item)
            end
        end
    end
    out result
end


# ──────────────────────────────────────────────
# Đệ quy — tính tổng score cộng dồn theo chỉ số
# (minh hoạ recursion)
# ──────────────────────────────────────────────

func sum_scores(list, idx: int) -> int:
    if idx < 0:
        out 0
    end
    var item = list[idx]
    var rest = sum_scores(list, idx - 1)
    out calc_score(item.priority, item.status) + rest
end
