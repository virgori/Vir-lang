##
 * apps/todo/main.vri — VirTask: App To-Do List
 * =============================================
 * Showcase TOÀN BỘ cú pháp Vir trong một app thực tế:
 *
 *   include / import          — hệ thống module
 *   const / var / let         — khai báo biến & hằng
 *   entity / enum             — kiểu dữ liệu
 *   func ... -> T / out       — hàm có kiểu trả về
 *   if / eif / else           — rẽ nhánh
 *   for i in 0..n             — vòng for range
 *   when ... loop             — vòng while
 *   break / skip              — kiểm soát vòng lặp
 *   arr_new / push / arr[i]   — mảng động
 *   str_cat / str_len         — thao tác chuỗi
 *   recursion                 — đệ quy
 *   higher-order func         — hàm bậc cao
 *
 * Chạy:  vir jit apps/todo/main.vri
 ##


# ═══════════════════════════════════════════════════════
# MODULE IMPORT
# ═══════════════════════════════════════════════════════

include todo
import TodoItem, Status, Priority          from todo
    todo_new, todo_complete, todo_cancel,
    todo_print, todo_refresh_score,
    calc_score, status_label, priority_label,
    list_add, list_print_all,
    list_count_by_status, list_total_score,
    list_high_priority, sum_scores


# ═══════════════════════════════════════════════════════
# CONST — hằng giao diện
# ═══════════════════════════════════════════════════════

const SEP: "────────────────────────────────"
const BANNER: "  ██╗   ██╗██╗██████╗ ████████╗ █████╗ ███████╗██╗  ██╗"


# ═══════════════════════════════════════════════════════
# HELPER — in tiêu đề (func đơn giản, không return)
# ═══════════════════════════════════════════════════════

func section(title: string):
    print_str(SEP)
    print_str(title)
    print_str(SEP)
end


# ═══════════════════════════════════════════════════════
# HELPER — đếm chữ số của số nguyên (đệ quy)
# ═══════════════════════════════════════════════════════

func digit_count(n: int) -> int:
    if n < 10:
        out 1
    end
    out 1 + digit_count(n / 10)
end


# ═══════════════════════════════════════════════════════
# HELPER — in số + nhãn cạnh nhau bằng str_cat
# ═══════════════════════════════════════════════════════

func print_kv(key: string, val: int):
    # dùng str_cat ghép chuỗi trực tiếp
    let label = str_cat("  ", key)
    print_str(label)
    print val
end


# ═══════════════════════════════════════════════════════
# HELPER — in thống kê (dùng let + str_cat + str_len)
# ═══════════════════════════════════════════════════════

func print_stats(list):
    let total     = len(list)
    let done      = list_count_by_status(list, Status.Done)
    let cancelled = list_count_by_status(list, Status.Cancelled)
    let pending   = list_count_by_status(list, Status.Pending)
    let score     = list_total_score(list)

    section("THỐNG KÊ")
    print_kv("Tổng task  :", total)
    print_kv("Hoàn thành :", done)
    print_kv("Huỷ bỏ     :", cancelled)
    print_kv("Còn lại    :", pending)
    print_kv("Tổng điểm  :", score)
    print_kv("Chữ số đếm :", digit_count(score))
end


# ═══════════════════════════════════════════════════════
# HELPER — higher-order: áp dụng một action function
#          lên tất cả task trong mảng index
#          (minh hoạ truyền func như giá trị)
# ═══════════════════════════════════════════════════════

func apply_to_all(list, indices, action: int):
    let n = len(indices)
    for i in 0..n:
        let idx  = indices[i]
        var item = list[idx]
        item     = action(item)
        list[idx] = item
    end
end


# ═══════════════════════════════════════════════════════
# DATA — tạo danh sách ban đầu
# ═══════════════════════════════════════════════════════

func make_backlog():
    var list = arr_new(64)

    # Priority.High — task quan trọng
    list_add(list, todo_new("Viết JIT codegen ARM64",    Priority.High))
    list_add(list, todo_new("Hoàn thiện stdlib string",  Priority.High))
    list_add(list, todo_new("Bootstrap self-hosted virc",Priority.High))

    # Priority.Medium
    list_add(list, todo_new("Viết unit test parser",     Priority.Medium))
    list_add(list, todo_new("Tối ưu regalloc spill",     Priority.Medium))
    list_add(list, todo_new("Tài liệu hoá syntax Vir",   Priority.Medium))

    # Priority.Low
    list_add(list, todo_new("Thêm màu terminal",         Priority.Low))
    list_add(list, todo_new("Port sang Linux x86-64",    Priority.Low))
    list_add(list, todo_new("Publish npm package",       Priority.Low))

    out list
end


# ═══════════════════════════════════════════════════════
# MAIN — điểm vào chương trình
# ═══════════════════════════════════════════════════════

func main():

    # ── 1. BANNER ──────────────────────────────────────
    print_str(BANNER)
    print_str("  VirTask — To-Do App viết thuần Vir")
    print_str(SEP)


    # ── 2. TẠO BACKLOG ─────────────────────────────────
    var tasks = make_backlog()

    section("BACKLOG BAN ĐẦU")
    list_print_all(tasks)


    # ── 3. HOÀN THÀNH TASK BẰNG HIGHER-ORDER FUNC ──────
    # Tập hợp index cần complete vào mảng inline
    var to_complete = arr_new(8)
    push(to_complete, 0)    # JIT codegen
    push(to_complete, 1)    # stdlib string
    push(to_complete, 3)    # unit test

    apply_to_all(tasks, to_complete, todo_complete)

    section("SAU KHI COMPLETE (dùng higher-order func)")
    list_print_all(tasks)


    # ── 4. HUỶ BỎ MỘT SỐ TASK ─────────────────────────
    var to_cancel = arr_new(4)
    push(to_cancel, 7)      # port linux
    push(to_cancel, 8)      # npm

    apply_to_all(tasks, to_cancel, todo_cancel)

    section("SAU KHI CANCEL")
    list_print_all(tasks)


    # ── 5. LỌC HIGH-PRIORITY CÒN PENDING ───────────────
    section("DANH SÁCH ƯU TIÊN CAO CÒN LẠI")
    var urgent = list_high_priority(tasks)
    list_print_all(urgent)


    # ── 6. THÊM TASK MỚI ĐỘNG ─────────────────────────
    section("THÊM TASK MỚI (for range + push)")
    var new_titles = arr_new(4)
    push(new_titles, "Viết benchmark so C")
    push(new_titles, "Hỗ trợ WASM target")

    let cnt = len(new_titles)
    for i in 0..cnt:
        var t = todo_new(new_titles[i], Priority.Medium)
        list_add(tasks, t)
        todo_print(t)
    end


    # ── 7. ĐỆ QUY — tổng điểm bằng recursion ──────────
    let last_idx = len(tasks) - 1
    let rec_sum  = sum_scores(tasks, last_idx)

    section("ĐỆ QUY — sum_scores(tasks, last)")
    print_kv("Tổng điểm đệ quy:", rec_sum)


    # ── 8. BREAK — tìm task High đầu tiên còn pending ──
    section("BREAK — tìm task High đầu tiên còn pending")
    var n   = len(tasks)
    var i   = 0
    var found_idx = -1
    when i < n loop
        var item = tasks[i]
        if item.priority == Priority.High:
            if item.status == Status.Pending:
                found_idx = i
                break
            end
        end
        i = i + 1
    end

    if found_idx >= 0:
        var first_high = tasks[found_idx]
        print_str("  Tìm thấy tại index:")
        print found_idx
        todo_print(first_high)
    else
        print_str("  Không còn task High pending!")
    end


    # ── 9. SKIP — in task có điểm lẻ (% 2 != 0) ───────
    section("SKIP — in task score lẻ (bỏ qua chẵn)")
    var j = 0
    when j < n loop
        j = j + 1
        var item  = tasks[j - 1]
        item      = todo_refresh_score(item)
        let sc    = item.score
        if sc % 2 == 0:
            skip
        end
        todo_print(item)
    end


    # ── 10. THỐNG KÊ CUỐI ──────────────────────────────
    print_stats(tasks)

    print_str(SEP)
    print_str("  Done. Powered by Vir.")
    print_str(SEP)
end
