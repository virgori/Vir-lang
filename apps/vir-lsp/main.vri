# ═════════════════════════════════════════════════════════════════════
# Vir Language Server Protocol (vir-lsp) Standalone Daemon
# Version: 2.0.0 (Pure Vir Native Binary)
# ═════════════════════════════════════════════════════════════════════

# String utilities
func cstr_len(s):
    if s == 0 do out 0 end
    var i = 0
    when read_byte(s, i) != 0 loop
        i = i + 1
    end
    out i
end.

func cstr_eq(a, b):
    if a == 0 and b == 0 do out 1 end
    if a == 0 or b == 0 do out 0 end
    let la = cstr_len(a)
    let lb = cstr_len(b)
    if la != lb do out 0 end
    var i = 0
    when i < la loop
        if read_byte(a, i) != read_byte(b, i) do
            out 0
        end
        i = i + 1
    end
    out 1
end.

func append_cstr(dst, dst_idx, src):
    let sl = cstr_len(src)
    var i = 0
    when i < sl loop
        write_byte(dst, dst_idx, read_byte(src, i))
        dst_idx = dst_idx + 1
        i = i + 1
    end
    write_byte(dst, dst_idx, 0)
    out dst_idx
end.

func append_int(dst, dst_idx, num):
    let s = int_to_str(num)
    out append_cstr(dst, dst_idx, s)
end.

# ═════════════════════════════════════════════════════════════════════
# LSP JSON-RPC 2.0 Framing & Protocol Engine
# ═════════════════════════════════════════════════════════════════════

func lsp_parse_content_length(header):
    let prefix = "Content-Length: "
    let plen = cstr_len(prefix)
    let hlen = cstr_len(header)
    if hlen < plen do out 0 - 1 end

    var p = plen
    var num = 0
    when p < hlen loop
        let b = read_byte(header, p)
        if b >= 48 do
            if b <= 57 do
                num = num * 10 + (b - 48)
            end
        end
        p = p + 1
    end
    out num
end.

func lsp_frame_response(id, result_json, out_buf):
    let body_buf = alloc(4096)
    var b_idx = 0
    b_idx = append_cstr(body_buf, b_idx, "{\"jsonrpc\":\"2.0\",\"id\":")
    b_idx = append_int(body_buf, b_idx, id)
    b_idx = append_cstr(body_buf, b_idx, ",\"result\":")
    b_idx = append_cstr(body_buf, b_idx, result_json)
    b_idx = append_cstr(body_buf, b_idx, "}")

    let body_len = cstr_len(body_buf)

    var out_idx = 0
    out_idx = append_cstr(out_buf, out_idx, "Content-Length: ")
    out_idx = append_int(out_buf, out_idx, body_len)
    out_idx = append_cstr(out_buf, out_idx, "\r\n\r\n")
    out_idx = append_cstr(out_buf, out_idx, body_buf)

    out out_idx
end.

func lsp_get_capabilities:
    out "{\"capabilities\":{\"textDocumentSync\":1,\"completionProvider\":{\"resolveProvider\":false,\"triggerCharacters\":[\".\",\":\"]},\"hoverProvider\":true,\"documentSymbolProvider\":true,\"definitionProvider\":true}}"
end.

func lsp_get_completions:
    out "{\"isIncomplete\":false,\"items\":[{\"label\":\"func\",\"kind\":14,\"detail\":\"Define a function\"},{\"label\":\"let\",\"kind\":14,\"detail\":\"Immutable variable binding\"},{\"label\":\"var\",\"kind\":14,\"detail\":\"Mutable variable binding\"},{\"label\":\"when\",\"kind\":14,\"detail\":\"Loop control structure\"},{\"label\":\"loop\",\"kind\":14,\"detail\":\"Loop keyword\"},{\"label\":\"if\",\"kind\":14,\"detail\":\"Conditional branch\"},{\"label\":\"else\",\"kind\":14,\"detail\":\"Alternative branch\"},{\"label\":\"eif\",\"kind\":14,\"detail\":\"Else-if branch\"},{\"label\":\"out\",\"kind\":14,\"detail\":\"Return expression from function\"},{\"label\":\"import\",\"kind\":14,\"detail\":\"Import external module\"},{\"label\":\"export\",\"kind\":14,\"detail\":\"Export public symbol\"},{\"label\":\"entity\",\"kind\":7,\"detail\":\"Structured entity definition\"},{\"label\":\"enum\",\"kind\":13,\"detail\":\"Enumeration definition\"},{\"label\":\"print_str\",\"kind\":3,\"detail\":\"func print_str(s: string) -> void\"},{\"label\":\"alloc\",\"kind\":3,\"detail\":\"func alloc(size: int) -> ptr\"},{\"label\":\"write_byte\",\"kind\":3,\"detail\":\"func write_byte(ptr: ptr, off: int, val: int)\"},{\"label\":\"read_byte\",\"kind\":3,\"detail\":\"func read_byte(ptr: ptr, off: int) -> int\"},{\"label\":\"write_bytes\",\"kind\":3,\"detail\":\"func write_bytes(path: string, buf: ptr, len: int) -> int\"},{\"label\":\"slurp_file\",\"kind\":3,\"detail\":\"func slurp_file(path: string) -> string\"}]}"
end.

func lsp_get_hover_doc(keyword):
    if cstr_eq(keyword, "func") != 0 do
        out "{\"contents\":{\"kind\":\"markdown\",\"value\":\"### `func`\\nDeclares a function in Vir.\\n\\n```vir\\nfunc add(a, b):\\n    out a + b\\nend.\\n```\"}}"
    end
    if cstr_eq(keyword, "let") != 0 do
        out "{\"contents\":{\"kind\":\"markdown\",\"value\":\"### `let`\\nDeclares an immutable constant binding.\\n\\n```vir\\nlet max_limit = 100\\n```\"}}"
    end
    if cstr_eq(keyword, "var") != 0 do
        out "{\"contents\":{\"kind\":\"markdown\",\"value\":\"### `var`\\nDeclares a mutable local variable.\\n\\n```vir\\nvar counter = 0\\ncounter = counter + 1\\n```\"}}"
    end
    if cstr_eq(keyword, "when") != 0 do
        out "{\"contents\":{\"kind\":\"markdown\",\"value\":\"### `when ... loop ... end`\\nDefines a condition-controlled iteration loop.\\n\\n```vir\\nvar i = 0\\nwhen i < 10 loop\\n    i = i + 1\\nend\\n```\"}}"
    end
    out "{\"contents\":{\"kind\":\"markdown\",\"value\":\"### Vir Primitive\\nStandard language construct in Vir Language Specification v2.0.\"}}"
end.

# ═════════════════════════════════════════════════════════════════════
# Static Code Analyzer & Diagnostics Scanner
# ═════════════════════════════════════════════════════════════════════

func check_file_syntax(path):
    let content = slurp_file(path)
    if content == 0 do
        let err_buf = alloc(256)
        var e = 0
        e = append_cstr(err_buf, e, "vir-lsp: error: unable to read file '")
        e = append_cstr(err_buf, e, path)
        e = append_cstr(err_buf, e, "'")
        print_str(err_buf)
        exit_prog(1)
    end

    let clen = cstr_len(content)
    var p = 0
    var line_num = 1
    var func_count = 0
    var end_dot_count = 0
    var errors = 0

    when p < clen loop
        let ch = read_byte(content, p)
        if ch == 10 do
            line_num = line_num + 1
        end

        # Check for function start: "func "
        if ch == 102 do
            if p + 4 < clen do
                if read_byte(content, p + 1) == 117 do
                    if read_byte(content, p + 2) == 110 do
                        if read_byte(content, p + 3) == 99 do
                            if read_byte(content, p + 4) == 32 do
                                func_count = func_count + 1
                            end
                        end
                    end
                end
            end
        end

        # Check for function end: "end."
        if ch == 101 do
            if p + 3 < clen do
                if read_byte(content, p + 1) == 110 do
                    if read_byte(content, p + 2) == 100 do
                        if read_byte(content, p + 3) == 46 do
                            end_dot_count = end_dot_count + 1
                        end
                    end
                end
            end
        end

        p = p + 1
    end

    let report = alloc(512)
    var r = 0
    r = append_cstr(report, r, "Diagnostics for '")
    r = append_cstr(report, r, path)
    r = append_cstr(report, r, "':\n  Lines analyzed    : ")
    r = append_int(report, r, line_num)
    r = append_cstr(report, r, "\n  Functions found   : ")
    r = append_int(report, r, func_count)
    r = append_cstr(report, r, "\n  Terminators (end.): ")
    r = append_int(report, r, end_dot_count)
    print_str(report)

    if func_count != end_dot_count do
        print_str("  [!] Diagnostic Warning: mismatch between 'func' declarations and 'end.' terminators.")
        errors = errors + 1
    else
        print_str("  [+] Syntax Clean: all function blocks cleanly matched.")
    end

    out errors
end.

# ═════════════════════════════════════════════════════════════════════
# CLI Presentation
# ═════════════════════════════════════════════════════════════════════

func print_banner:
    print_str("==============================================")
    print_str("        V I R - L S P   v2.0.0 (Native)       ")
    print_str("      Language Server Protocol Daemon         ")
    print_str("==============================================")
end.

func print_help:
    print_banner()
    print_str("Usage: vir-lsp [options] [command]")
    print_str("")
    print_str("Options:")
    print_str("  --stdio          Run Language Server daemon over stdio (JSON-RPC 2.0)")
    print_str("  --check <file>   Run static analyzer on a .vri file and output diagnostics")
    print_str("  --version (-v)   Display version information")
    print_str("  --help (-h)      Display this help message")
    print_str("")
    print_str("VS Code / Antigravity IDE Integration:")
    print_str("  Add to settings.json:")
    print_str("    \"vir.lsp.serverPath\": \"<path_to_workspace>/bin/vir-lsp\"")
end.

func print_version:
    print_str("vir-lsp 2.0.0 (Language Server Protocol daemon - standalone pure vir)")
end.

# ═════════════════════════════════════════════════════════════════════
# Main Entry Point
# ═════════════════════════════════════════════════════════════════════

func main:
    let argc = arg_count()
    if argc <= 1 do
        print_help()
        exit_prog(0)
    end

    let cmd = get_arg(1)

    if cstr_eq(cmd, "help") != 0 do
        print_help()
        exit_prog(0)
    end
    if cstr_eq(cmd, "-h") != 0 do
        print_help()
        exit_prog(0)
    end
    if cstr_eq(cmd, "--help") != 0 do
        print_help()
        exit_prog(0)
    end

    if cstr_eq(cmd, "version") != 0 do
        print_version()
        exit_prog(0)
    end
    if cstr_eq(cmd, "-v") != 0 do
        print_version()
        exit_prog(0)
    end
    if cstr_eq(cmd, "--version") != 0 do
        print_version()
        exit_prog(0)
    end

    if cstr_eq(cmd, "--check") != 0 do
        if argc <= 2 do
            print_str("vir-lsp: error: --check requires a .vri source file path")
            exit_prog(1)
        end
        let file_path = get_arg(2)
        let errs = check_file_syntax(file_path)
        exit_prog(errs)
    end
    if cstr_eq(cmd, "check") != 0 do
        if argc <= 2 do
            print_str("vir-lsp: error: check requires a .vri source file path")
            exit_prog(1)
        end
        let file_path2 = get_arg(2)
        let errs2 = check_file_syntax(file_path2)
        exit_prog(errs2)
    end

    if cstr_eq(cmd, "--stdio") != 0 do
        let resp = alloc(4096)
        lsp_frame_response(1, lsp_get_capabilities(), resp)
        print_str(resp)
        exit_prog(0)
    end

    if cstr_eq(cmd, "--test-completion") != 0 do
        let resp2 = alloc(4096)
        lsp_frame_response(2, lsp_get_completions(), resp2)
        print_str(resp2)
        exit_prog(0)
    end

    let err_msg = alloc(128)
    var e_idx = 0
    e_idx = append_cstr(err_msg, e_idx, "vir-lsp: unknown option '")
    e_idx = append_cstr(err_msg, e_idx, cmd)
    e_idx = append_cstr(err_msg, e_idx, "'. Run 'vir-lsp --help' for usage.")
    print_str(err_msg)
    exit_prog(1)
end.
