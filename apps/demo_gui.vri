##
 * demo_gui.vri — Demo Vir Native GUI Application
 * =================================================
 * A simple calculator app demonstrating Vir's native GUI framework.
 *
 * Build:   ./core/build/vir run stdlib/vir/compiler/virc.vri apps/demo_gui.vri
 * Run:     ./a.out
 ##

include gui

func main:
    # Create application
    var app = gui_app("Vir Calculator")

    # Create main window
    var win = gui_window(app, "Vir Calculator — Native GUI Demo", 400, 500)
    gui_window_center(win)
    gui_window_set_bg(win, color_rgb(240, 240, 245))

    # Title label
    var title = gui_label(win, "Vir Calculator", 20, 20, 360, 30)
    gui_label_set_font(title, font_bold("Helvetica Neue", 22))
    gui_label_set_color(title, COLOR_BLUE)

    # Display panel
    var display = gui_panel(win, 20, 60, 360, 60)
    gui_panel_set_bg(display, COLOR_WHITE)

    var display_text = gui_label(win, "0", 30, 70, 340, 40)
    gui_label_set_font(display_text, font("Menlo", 28))
    gui_label_set_align(display_text, 2);  # right-aligned

    # Number buttons (4x3 grid)
    var btn_y = 140
    var btn_w = 80
    var btn_h = 50
    var spacing = 10

    # Row 1: 7 8 9 ÷
    var b7 = gui_button(win, "7", 20, btn_y, btn_w, btn_h)
    var b8 = gui_button(win, "8", 110, btn_y, btn_w, btn_h)
    var b9 = gui_button(win, "9", 200, btn_y, btn_w, btn_h)
    var bdiv = gui_button(win, "/", 290, btn_y, btn_w, btn_h)

    # Row 2: 4 5 6 ×
    btn_y = 200
    var b4 = gui_button(win, "4", 20, btn_y, btn_w, btn_h)
    var b5 = gui_button(win, "5", 110, btn_y, btn_w, btn_h)
    var b6 = gui_button(win, "6", 200, btn_y, btn_w, btn_h)
    var bmul = gui_button(win, "*", 290, btn_y, btn_w, btn_h)

    # Row 3: 1 2 3 -
    btn_y = 260
    var b1 = gui_button(win, "1", 20, btn_y, btn_w, btn_h)
    var b2 = gui_button(win, "2", 110, btn_y, btn_w, btn_h)
    var b3 = gui_button(win, "3", 200, btn_y, btn_w, btn_h)
    var bsub = gui_button(win, "-", 290, btn_y, btn_w, btn_h)

    # Row 4: C 0 = +
    btn_y = 320
    var bc = gui_button(win, "C", 20, btn_y, btn_w, btn_h)
    var b0 = gui_button(win, "0", 110, btn_y, btn_w, btn_h)
    var beq = gui_button(win, "=", 200, btn_y, btn_w, btn_h)
    var badd = gui_button(win, "+", 290, btn_y, btn_w, btn_h)

    # Status bar
    var status = gui_label(win, "Ready — Vir Native GUI v0.1", 20, 460, 360, 20)
    gui_label_set_font(status, font("Helvetica", 11))
    gui_label_set_color(status, COLOR_GRAY)

    # Run the application event loop
    gui_run(app)
end
