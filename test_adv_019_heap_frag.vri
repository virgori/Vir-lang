# test_adv_019: Heap fragmentation - many small allocs
# Expected: 100

func main:
    # Allocate 100 small chunks and write pattern
    var i = 0
    var count = 0
    when i < 100 loop
        var chunk = alloc(64)
        write_word(chunk, 0, i)
        var val = read_word(chunk, 0)
        if val == i do
            count = count + 1
        end
        i = i + 1
    end
    print count
end.
