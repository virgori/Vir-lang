# test_adv_004: Comprehensive bitwise operations
# Expected: 8, 14, 6, 0, 255

func main:
    # AND: 12 & 10 = 1100 & 1010 = 1000 = 8
    var a = 12
    var b = 10
    var r1 = a & b
    print r1

    # OR: 12 | 10 = 1100 | 1010 = 1110 = 14
    var r2 = a | b
    print r2

    # XOR: 12 xor 10 = 1100 xor 1010 = 0110 = 6
    var r3 = a xor b
    print r3

    # XOR self = 0
    var r4 = a xor a
    print r4

    # AND with mask: 0xFF & 0xFF = 255
    var mask = 255
    var val = 255
    var r5 = val & mask
    print r5
end.
