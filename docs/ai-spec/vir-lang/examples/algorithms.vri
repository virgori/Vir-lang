# Vir AI Spec — algorithms (idiomatic control flow)

func factorial(n: int) -> int:
    if n <= 1 do
        out 1
    end
    out n * factorial(n - 1)
end.

func sum_to(n: int) -> int:
    var total = 0
    for i in 1..(n + 1) do
        total = total + i
    end
    out total
end.

func sum_odds_until(limit: int) -> int:
    var total = 0
    var x = 0
    when x < limit loop
        x = x + 1
        if x mod 2 == 0 do
            skip
        end
        total = total + x
        if total > 100 do
            break
        end
    end
    out total
end.

func main:
    print(factorial(5))
    print(sum_to(10))
    print(sum_odds_until(20))
    out 0
end.
