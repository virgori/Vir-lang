# Vir AI Spec — common patterns

entity Point:
    x: int
    y: int
end.

enum Status:
    Ok
    Fail
end.

func distance_sq(p: Point) -> int:
    out p.x * p.x + p.y * p.y
end.

func safe_div(a: int, b: int) -> int:
    if b == 0 do
        throw 1
    end
    out a / b
end.

func with_cleanup(flag: int) -> int:
    var result = 0
    if flag == 0 do
        throw 2
    end
    result = safe_div(10, flag)
    out result
ensure
    print("cleanup always")
revert
    print("failed with erx=$erx")
end.

func demo_ensure:
    var n = 1
    print(n)
ensure
    print("ensure ran")
end.

func main:
    var p = Point(x: 3, y: 4)
    print(distance_sq(p))

    var st = Status.Ok
    if st == Status.Ok do
        print("ok")
    end

    demo_ensure()
    out 0
end.
