# test_adv_049: Global array initialization in loop
# Expected: 0, 1, 4, 9, 16

func main:
    var arr = arr_new(16)
    var i = 0
    when i < 5 loop
        push(arr, i * i)
        i = i + 1
    end

    # Static-like access
    print arr[0]
    print arr[1]
    print arr[2]
    print arr[3]
    print arr[4]
end.
