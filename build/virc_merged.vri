# ═══════════════════════════════════════════════════════
# Convenience: Write to stdout / stderr
# ═══════════════════════════════════════════════════════

func write_stdout:
    in(data: int, len: int)
    sys_write(STDOUT_FD, data, len);
end

func write_stderr:
    in(data: int, len: int)
    sys_write(STDERR_FD, data, len);
end

# ═══════════════════════════════════════════════════════
# Convenience: Read entire file into memory
# ═══════════════════════════════════════════════════════

func read_file_raw:
    in(path: int)
    # Open
    let fd = sys_open(path, O_RDONLY, 0);
    if fd < 0:
        out 0;   # error
    end

    # Get file size via lseek
    let end_pos = sys_lseek(fd, 0, 2);    # SEEK_END = 2
    sys_lseek(fd, 0, 0);                   # SEEK_SET = 0

    # Allocate buffer via mmap
    let buf = sys_mmap(0, end_pos + 1,
                       PROT_READ | PROT_WRITE,
                       MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
    if buf < 0:
        sys_close(fd);
        out 0;
    end

    # Read
    let total = 0;
    when total < end_pos loop
        let n = sys_read(fd, buf + total, end_pos - total);
        if n <= 0:
            out skip;
        end
        total = total + n;
    end

    # Null-terminate
    extern func native_write_byte(addr: int, offset: int, val: int);
    native_write_byte(buf, end_pos, 0);

    sys_close(fd);
    out buf;   # returns pointer to mmap'd buffer
end

# ═══════════════════════════════════════════════════════
# Convenience: Write buffer to file
# ═══════════════════════════════════════════════════════

func write_file_raw:
    in(path: int, data: int, len: int, mode: int)
    let fd = sys_open(path, O_WRONLY | O_CREAT | O_TRUNC, mode);
    if fd < 0:
        out -1;
    end

    let written = 0;
    when written < len loop
        let n = sys_write(fd, data + written, len - written);
        if n <= 0:
            out skip;
        end
        written = written + n;
    end

    sys_close(fd);
    out 0;
end

