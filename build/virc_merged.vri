##
 * vir/mem/buffer.vri — Growable Byte Buffer (sở hữu dữ liệu)
 * ============================================================
 * Buffer = Vec<u8> chuyên biệt — use cho machine code emit, binary I/O.
 * Tự grow khi cần, deallocate khi free.
 *
 * Compiler uses internally: code buffer cho codegen, output binary.
 ##

# [merged] include types;
# [merged] include alloc;
# [merged] import alloc, realloc, free from alloc;
