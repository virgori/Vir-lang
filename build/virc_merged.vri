# [merged] include vir::rt::alloc;
# ═══ BEGIN: stdlib/vir/rt/alloc.vri ═══
##
 * vir/rt/alloc.vri — Memory Allocator (Pure Vir, No libc)
 * ========================================================
 * Bump allocator + free-list allocator built on raw mmap syscalls.
 * Zero C library. Zero malloc. Zero free. Pure kernel syscalls.
 *
 * Strategy:
 *   - Arena (bump) allocator for fast sequential allocation
 *   - Free-list allocator for general-purpose alloc/dealloc
 *   - Page allocator (mmap/munmap) as the backing layer
 *
 * Memory block layout:
 *   [size:i64] [flags:i64] [user data...]
 *   ^-- block_ptr         ^-- returned to user (block_ptr + 16)
 ##

# [merged] module vir::rt::alloc;

# [merged] include types;
# [merged] include syscall;
# [merged] import sys_mmap, sys_munmap, PROT_READ, PROT_WRITE, MAP_PRIVATE, MAP_ANONYMOUS from syscall;

# ═══════════════════════════════════════════════════════
# Constants
# ═══════════════════════════════════════════════════════

const PAGE_SIZE:        16384;        # 16KB (macOS ARM64)
const MIN_ARENA_SIZE:   1048576;      # 1MB
const BLOCK_HEADER:     16;           # 8 bytes size + 8 bytes flags
const BLOCK_FREE:       0x0;
const BLOCK_USED:       0x1;
const ALIGNMENT:        16;           # 16-byte alignment for ARM64

# ═══════════════════════════════════════════════════════
# Low-Level Page Allocation (mmap/munmap)
# ═══════════════════════════════════════════════════════

func page_alloc:
    in(size: int)
    # Round up to page boundary
    let pages = (size + PAGE_SIZE - 1) / PAGE_SIZE;
    let actual = pages * PAGE_SIZE;

    let ptr = sys_mmap(0, actual,
                       PROT_READ | PROT_WRITE,
                       MAP_PRIVATE | MAP_ANONYMOUS,
                       -1, 0);
    if ptr < 0:
        out 0;   # allocation failed
    end
    out ptr;
end

func page_free:
    in(ptr: int, size: int)
    let pages = (size + PAGE_SIZE - 1) / PAGE_SIZE;
    let actual = pages * PAGE_SIZE;
    sys_munmap(ptr, actual);
end

# ═══════════════════════════════════════════════════════
# Arena Allocator — Fast Bump Allocation
# ═══════════════════════════════════════════════════════
# Allocates by bumping a pointer forward.
# Entire arena freed at once (no individual free).
# Perfect for compiler phases (lex, parse, IR).

entity Arena:
    base:       int;      # mmap'd base address
    capacity:   int;      # total bytes
    offset:     int;      # current bump position
end

func arena_new:
    in(size: int)
    let actual = size;
    if actual < MIN_ARENA_SIZE:
        actual = MIN_ARENA_SIZE;
    end
    let base = page_alloc(actual);
    if base == 0:
        out Arena { base: 0, capacity: 0, offset: 0 };
    end
    out Arena { base: base, capacity: actual, offset: 0 };
end

func arena_alloc:
    in(arena: Arena, size: int)
    # Align to ALIGNMENT boundary
    let aligned = (size + ALIGNMENT - 1) & ~(ALIGNMENT - 1);

    if arena.offset + aligned > arena.capacity:
        out 0;   # out of space
    end

    let ptr = arena.base + arena.offset;
    arena.offset = arena.offset + aligned;
    out ptr;
end

func arena_reset:
    in(arena: Arena)
    arena.offset = 0;
    out arena;
end

func arena_destroy:
    in(arena: Arena)
    if arena.base != 0:
        page_free(arena.base, arena.capacity);
    end
end

# ═══════════════════════════════════════════════════════
# Free-List Allocator — General Purpose
# ═══════════════════════════════════════════════════════
# Each block: [size:i64][flags:i64][user data...]
# Free list is a singly-linked list through free blocks.
# Coalescing on free to reduce fragmentation.

entity FreeNode:
    size:       int;      # total block size (including header)
    next_ptr:   int;      # pointer to next FreeNode, or 0
end

entity Heap:
    base:       int;      # mmap'd region base
    capacity:   int;      # total region size
    free_head:  int;      # pointer to first FreeNode
    used:       int;      # bytes currently allocated
end

# Heap state (module-level singleton)
var g_heap = Heap { base: 0, capacity: 0, free_head: 0, used: 0 };

func heap_init:
    in(size: int)
    let actual = size;
    if actual < MIN_ARENA_SIZE:
        actual = MIN_ARENA_SIZE;
    end
    let base = page_alloc(actual);
    if base == 0:
        out false;
    end

    # Initialize entire region as one big free block
    extern func native_write_i64(addr: int, offset: int, val: int);
    native_write_i64(base, 0, actual);       # size
    native_write_i64(base, 1, 0);            # next = null

    g_heap = Heap { base: base, capacity: actual, free_head: base, used: 0 };
    out true;
end

func heap_alloc:
    in(size: int)
    let needed = size + BLOCK_HEADER;
    # Align
    needed = (needed + ALIGNMENT - 1) & ~(ALIGNMENT - 1);

    extern func native_read_i64(addr: int, offset: int) -> int;
    extern func native_write_i64(addr: int, offset: int, val: int);

    # First-fit search through free list
    let prev_ptr = 0;
    let cur = g_heap.free_head;

    when cur != 0 loop
        let block_size = native_read_i64(cur, 0);
        let next = native_read_i64(cur, 1);

        if block_size >= needed:
            # Found a fit! Split if remainder is big enough
            let remainder = block_size - needed;

            if remainder >= (BLOCK_HEADER + ALIGNMENT):
                # Split: shrink this block, create new free block after
                native_write_i64(cur, 0, needed);    # resize current
                let new_free = cur + needed;
                native_write_i64(new_free, 0, remainder);   # size
                native_write_i64(new_free, 1, next);         # next

                # Patch prev or head to point to new_free
                if prev_ptr == 0:
                    g_heap.free_head = new_free;
                else
                    native_write_i64(prev_ptr, 1, new_free);
                end
            else
                # Use whole block
                needed = block_size;
                if prev_ptr == 0:
                    g_heap.free_head = next;
                else
                    native_write_i64(prev_ptr, 1, next);
                end
            end

            # Mark as used
            native_write_i64(cur, 0, needed);
            native_write_i64(cur, 1, BLOCK_USED);
            g_heap.used = g_heap.used + needed;

            out cur + BLOCK_HEADER;   # return user pointer
        end

        prev_ptr = cur;
        cur = next;
    end

    # No fit found — grow heap
    let grow = needed;
    if grow < MIN_ARENA_SIZE:
        grow = MIN_ARENA_SIZE;
    end
    let new_region = page_alloc(grow);
    if new_region == 0:
        out 0;   # OOM
    end

    # Set up new region as allocated block + remainder as free
    native_write_i64(new_region, 0, needed);
    native_write_i64(new_region, 1, BLOCK_USED);

    let remainder = grow - needed;
    if remainder >= (BLOCK_HEADER + ALIGNMENT):
        let new_free = new_region + needed;
        native_write_i64(new_free, 0, remainder);
        native_write_i64(new_free, 1, g_heap.free_head);
        g_heap.free_head = new_free;
    end

    g_heap.used = g_heap.used + needed;
    g_heap.capacity = g_heap.capacity + grow;
    out new_region + BLOCK_HEADER;
end

func heap_free:
    in(ptr: int)
    if ptr == 0:
        out;
    end

    extern func native_read_i64(addr: int, offset: int) -> int;
    extern func native_write_i64(addr: int, offset: int, val: int);

    let block = ptr - BLOCK_HEADER;
    let block_size = native_read_i64(block, 0);

    # Mark as free, add to free list head
    native_write_i64(block, 0, block_size);
    native_write_i64(block, 1, g_heap.free_head);
    g_heap.free_head = block;
    g_heap.used = g_heap.used - block_size;
end

func heap_realloc:
    in(ptr: int, new_size: int)
    if ptr == 0:
        out heap_alloc(new_size);
    end

    extern func native_read_i64(addr: int, offset: int) -> int;
    extern func native_mem_copy(dst: int, src: int, len: int);

    let block = ptr - BLOCK_HEADER;
    let old_size = native_read_i64(block, 0) - BLOCK_HEADER;

    if new_size <= old_size:
        out ptr;   # shrink = no-op for now
    end

    # Allocate new, copy, free old
    let new_ptr = heap_alloc(new_size);
    if new_ptr == 0:
        out 0;
    end

    let copy_len = old_size;
    if new_size < copy_len:
        copy_len = new_size;
    end
    native_mem_copy(new_ptr, ptr, copy_len);
    heap_free(ptr);
    out new_ptr;
end

# ═══════════════════════════════════════════════════════
# Global Allocator API (drop-in replacement for malloc)
# ═══════════════════════════════════════════════════════

var g_initialized = false;

func vir_alloc:
    in(size: int)
    if g_initialized == false:
        heap_init(MIN_ARENA_SIZE * 4);   # 4MB initial heap
        g_initialized = true;
    end
    out heap_alloc(size);
end

func vir_free:
    in(ptr: int)
    heap_free(ptr);
end

func vir_realloc:
    in(ptr: int, new_size: int)
    if g_initialized == false:
        heap_init(MIN_ARENA_SIZE * 4);
        g_initialized = true;
    end
    out heap_realloc(ptr, new_size);
end

# ═══ END: stdlib/vir/rt/alloc.vri ═══

# [merged] import vir_alloc, vir_free, vir_realloc, heap_init from alloc;
# [merged] include vir::rt::string_rt;
# ═══ BEGIN: stdlib/vir/rt/string_rt.vri ═══
##
 * vir/rt/string_rt.vri — String Runtime (Pure Vir, No libc)
 * ==========================================================
 * UTF-8 string operations built on vir_alloc/vir_free.
 * Replaces C strlen, strcpy, strcmp, strcat, snprintf, etc.
 *
 * String representation:
 *   Pointer to null-terminated UTF-8 byte array.
 *   Length computed on demand via byte scan.
 *   For builder patterns, StringBuilder tracks length explicitly.
 ##

# [merged] module vir::rt::string_rt;

# [merged] include types;
# [merged] include alloc;
# [merged] import vir_alloc, vir_free, vir_realloc from alloc;

# ═══════════════════════════════════════════════════════
# Low-level byte access (compiler intrinsics)
# ═══════════════════════════════════════════════════════

extern func native_read_u8(addr: int, offset: int) -> int;
extern func native_write_u8(addr: int, offset: int, val: int);
extern func native_mem_copy(dst: int, src: int, len: int);
extern func native_mem_set(dst: int, val: int, len: int);

# ═══════════════════════════════════════════════════════
# String Length (replaces strlen)
# ═══════════════════════════════════════════════════════

func rt_strlen:
    in(s: int)
    if s == 0:
        out 0;
    end
    let i = 0;
    when native_read_u8(s, i) != 0 loop
        i = i + 1;
    end
    out i;
end

# ═══════════════════════════════════════════════════════
# String Copy (replaces strcpy)
# ═══════════════════════════════════════════════════════

func rt_strcpy:
    in(dst: int, src: int)
    let i = 0;
    let ch = native_read_u8(src, i);
    when ch != 0 loop
        native_write_u8(dst, i, ch);
        i = i + 1;
        ch = native_read_u8(src, i);
    end
    native_write_u8(dst, i, 0);    # null terminator
    out dst;
end

# ═══════════════════════════════════════════════════════
# String Compare (replaces strcmp)
# ═══════════════════════════════════════════════════════

func rt_strcmp:
    in(a: int, b: int)
    let i = 0;
    when true loop
        let ca = native_read_u8(a, i);
        let cb = native_read_u8(b, i);
        if ca != cb:
            out ca - cb;
        end
        if ca == 0:
            out 0;    # equal
        end
        i = i + 1;
    end
    out 0;
end

func rt_streq:
    in(a: int, b: int)
    out rt_strcmp(a, b) == 0;
end

# ═══════════════════════════════════════════════════════
# String Concatenation (replaces strcat pattern)
# ═══════════════════════════════════════════════════════

func rt_strcat:
    in(a: int, b: int)
    let la = rt_strlen(a);
    let lb = rt_strlen(b);
    let result = vir_alloc(la + lb + 1);
    native_mem_copy(result, a, la);
    native_mem_copy(result + la, b, lb);
    native_write_u8(result, la + lb, 0);
    out result;
end

# ═══════════════════════════════════════════════════════
# String Duplicate
# ═══════════════════════════════════════════════════════

func rt_strdup:
    in(s: int)
    let len = rt_strlen(s);
    let result = vir_alloc(len + 1);
    native_mem_copy(result, s, len + 1);   # includes null terminator
    out result;
end

# ═══════════════════════════════════════════════════════
# String Substring
# ═══════════════════════════════════════════════════════

func rt_substr:
    in(s: int, start: int, len: int)
    let slen = rt_strlen(s);
    if start >= slen:
        let empty = vir_alloc(1);
        native_write_u8(empty, 0, 0);
        out empty;
    end
    let actual = len;
    if start + actual > slen:
        actual = slen - start;
    end
    let result = vir_alloc(actual + 1);
    native_mem_copy(result, s + start, actual);
    native_write_u8(result, actual, 0);
    out result;
end

# ═══════════════════════════════════════════════════════
# String Contains
# ═══════════════════════════════════════════════════════

func rt_strcontains:
    in(haystack: int, needle: int)
    let hlen = rt_strlen(haystack);
    let nlen = rt_strlen(needle);
    if nlen == 0:
        out true;
    end
    if nlen > hlen:
        out false;
    end
    let i = 0;
    when i <= hlen - nlen loop
        let j = 0;
        let match = true;
        when j < nlen loop
            if native_read_u8(haystack, i + j) != native_read_u8(needle, j):
                match = false;
                out skip;
            end
            j = j + 1;
        end
        if match:
            out true;
        end
        i = i + 1;
    end
    out false;
end

# ═══════════════════════════════════════════════════════
# String from Literal
# ═══════════════════════════════════════════════════════

func rt_str_from_cstr:
    in(cstr: int)
    out rt_strdup(cstr);
end

# ═══════════════════════════════════════════════════════
# Integer to String (replaces snprintf %d)
# ═══════════════════════════════════════════════════════

func rt_itoa:
    in(n: int)
    let buf = vir_alloc(24);    # max i64 digits + sign + null
    let pos = 0;
    let val = n;

    if val < 0:
        native_write_u8(buf, 0, 45);   # '-'
        pos = 1;
        val = 0 - val;
    end

    if val == 0:
        native_write_u8(buf, pos, 48);   # '0'
        pos = pos + 1;
        native_write_u8(buf, pos, 0);
        out buf;
    end

    # Write digits in reverse to temp buffer
    let tmp = vir_alloc(24);
    let tlen = 0;
    when val > 0 loop
        let digit = val % 10;
        native_write_u8(tmp, tlen, 48 + digit);
        tlen = tlen + 1;
        val = val / 10;
    end

    # Reverse into output
    let i = tlen - 1;
    when i >= 0 loop
        native_write_u8(buf, pos, native_read_u8(tmp, i));
        pos = pos + 1;
        i = i - 1;
    end
    native_write_u8(buf, pos, 0);
    vir_free(tmp);
    out buf;
end

# ═══════════════════════════════════════════════════════
# String to Integer (replaces atoi/strtol)
# ═══════════════════════════════════════════════════════

func rt_atoi:
    in(s: int)
    let i = 0;
    let sign = 1;
    let result = 0;

    # Skip whitespace
    when native_read_u8(s, i) == 32 or native_read_u8(s, i) == 9 loop
        i = i + 1;
    end

    # Sign
    if native_read_u8(s, i) == 45:   # '-'
        sign = -1;
        i = i + 1;
    eif native_read_u8(s, i) == 43:  # '+'
        i = i + 1;
    end

    # Digits
    let ch = native_read_u8(s, i);
    when ch >= 48 and ch <= 57 loop
        result = result * 10 + (ch - 48);
        i = i + 1;
        ch = native_read_u8(s, i);
    end

    out result * sign;
end

# ═══════════════════════════════════════════════════════
# Hex Integer to String
# ═══════════════════════════════════════════════════════

func rt_itoa_hex:
    in(n: int, width: int)
    let hex_chars = "0123456789abcdef";
    let buf = vir_alloc(width + 3);
    native_write_u8(buf, 0, 48);    # '0'
    native_write_u8(buf, 1, 120);   # 'x'
    let pos = 2;
    let i = width - 1;
    when i >= 0 loop
        let nibble = (n >> (i * 4)) & 0xF;
        native_write_u8(buf, pos, native_read_u8(hex_chars, nibble));
        pos = pos + 1;
        i = i - 1;
    end
    native_write_u8(buf, pos, 0);
    out buf;
end

# ═══════════════════════════════════════════════════════
# StringBuilder — Efficient String Building
# ═══════════════════════════════════════════════════════

entity StringBuilder:
    buf:     int;     # allocated buffer
    len:     int;     # current length
    cap:     int;     # capacity
end

func sb_new:
    let cap = 256;
    let buf = vir_alloc(cap);
    out StringBuilder { buf: buf, len: 0, cap: cap };
end

func sb_grow:
    in(sb: StringBuilder, needed: int)
    if sb.len + needed <= sb.cap:
        out sb;
    end
    let new_cap = sb.cap * 2;
    when new_cap < sb.len + needed loop
        new_cap = new_cap * 2;
    end
    sb.buf = vir_realloc(sb.buf, new_cap);
    sb.cap = new_cap;
    out sb;
end

func sb_append:
    in(sb: StringBuilder, s: int)
    let slen = rt_strlen(s);
    sb = sb_grow(sb, slen);
    native_mem_copy(sb.buf + sb.len, s, slen);
    sb.len = sb.len + slen;
    out sb;
end

func sb_append_char:
    in(sb: StringBuilder, ch: int)
    sb = sb_grow(sb, 1);
    native_write_u8(sb.buf, sb.len, ch);
    sb.len = sb.len + 1;
    out sb;
end

func sb_append_int:
    in(sb: StringBuilder, n: int)
    let s = rt_itoa(n);
    sb = sb_append(sb, s);
    vir_free(s);
    out sb;
end

func sb_to_string:
    in(sb: StringBuilder)
    native_write_u8(sb.buf, sb.len, 0);
    out sb.buf;
end

func sb_len:
    in(sb: StringBuilder)
    out sb.len;
end

func sb_clear:
    in(sb: StringBuilder)
    sb.len = 0;
    out sb;
end

func sb_free:
    in(sb: StringBuilder)
    vir_free(sb.buf);
end

# ═══ END: stdlib/vir/rt/string_rt.vri ═══

import rt_strlen, rt_strcmp, rt_streq, rt_strcat, rt_strdup,
       rt_itoa, rt_atoi, StringBuilder, sb_new, sb_append,
       sb_append_char, sb_append_int, sb_to_string, sb_free from string_rt;
# [merged] include vir::rt::io;
# ═══ BEGIN: stdlib/vir/rt/io.vri ═══
##
 * vir/rt/io.vri — I/O Runtime (Pure Vir, No libc)
 * ==================================================
 * File and console I/O built on raw syscalls.
 * Replaces C stdio (printf, fopen, fread, fwrite, fclose).
 *
 * Buffered I/O for performance.
 * UTF-8 native throughout.
 ##

# [merged] module vir::rt::io;

# [merged] include types;
# [merged] include syscall;
import sys_read, sys_write, sys_open, sys_close, sys_lseek,
    sys_fstat, STDIN_FD, STDOUT_FD, STDERR_FD,
    O_RDONLY, O_WRONLY, O_RDWR, O_CREAT, O_TRUNC, O_APPEND from syscall;
# [merged] include alloc;
# [merged] import vir_alloc, vir_free from alloc;
# [merged] include string_rt;
import rt_strlen, rt_itoa, sb_new, sb_append, sb_append_char,
    sb_append_int, sb_to_string, sb_free, StringBuilder from string_rt;

# ═══════════════════════════════════════════════════════
# Console Write — replaces printf/fputs
# ═══════════════════════════════════════════════════════

func print_str:
    in(s: int)
    let len = rt_strlen(s);
    sys_write(STDOUT_FD, s, len);
end

func print_int:
    in(n: int)
    let s = rt_itoa(n);
    print_str(s);
    vir_free(s);
end

func print_ln:
    in(s: int)
    print_str(s);
    print_str("\n");
end

func print_newline:
    let nl = "\n";
    sys_write(STDOUT_FD, nl, 1);
end

func eprint_str:
    in(s: int)
    let len = rt_strlen(s);
    sys_write(STDERR_FD, s, len);
end

func eprint_ln:
    in(s: int)
    eprint_str(s);
    let nl = "\n";
    sys_write(STDERR_FD, nl, 1);
end

# ═══════════════════════════════════════════════════════
# Console Read — replaces scanf/fgets
# ═══════════════════════════════════════════════════════

func read_line:
    let buf = vir_alloc(4096);
    let pos = 0;
    let byte_buf = vir_alloc(1);

    when true loop
        let n = sys_read(STDIN_FD, byte_buf, 1);
        if n <= 0:
            out skip;
        end

        extern func native_read_u8(addr: int, offset: int) -> int;
        extern func native_write_u8(addr: int, offset: int, val: int);

        let ch = native_read_u8(byte_buf, 0);
        if ch == 10:   # '\n'
            out skip;
        end
        native_write_u8(buf, pos, ch);
        pos = pos + 1;

        if pos >= 4095:
            out skip;
        end
    end

    extern func native_write_u8(addr: int, offset: int, val: int);
    native_write_u8(buf, pos, 0);
    vir_free(byte_buf);
    out buf;
end

# ═══════════════════════════════════════════════════════
# File Handle
# ═══════════════════════════════════════════════════════

entity VirFile:
    fd:       int;
    is_open:  bool;
    mode:     int;     # O_RDONLY / O_WRONLY / O_RDWR
end

const FILE_NONE = VirFile { fd: -1, is_open: false, mode: 0 };

# ═══════════════════════════════════════════════════════
# File Open / Close
# ═══════════════════════════════════════════════════════

func file_open_read:
    in(path: int)
    let fd = sys_open(path, O_RDONLY, 0);
    if fd < 0:
        out FILE_NONE;
    end
    out VirFile { fd: fd, is_open: true, mode: O_RDONLY };
end

func file_open_write:
    in(path: int, mode: int)
    let fd = sys_open(path, O_WRONLY | O_CREAT | O_TRUNC, mode);
    if fd < 0:
        out FILE_NONE;
    end
    out VirFile { fd: fd, is_open: true, mode: O_WRONLY };
end

func file_open_append:
    in(path: int, mode: int)
    let fd = sys_open(path, O_WRONLY | O_CREAT | O_APPEND, mode);
    if fd < 0:
        out FILE_NONE;
    end
    out VirFile { fd: fd, is_open: true, mode: O_WRONLY };
end

func file_close:
    in(f: VirFile)
    if f.is_open:
        sys_close(f.fd);
    end
end

# ═══════════════════════════════════════════════════════
# File Read
# ═══════════════════════════════════════════════════════

func file_read_all:
    in(f: VirFile)
    if f.is_open == false:
        out 0;
    end

    # Get file size
    let end_pos = sys_lseek(f.fd, 0, 2);    # SEEK_END
    sys_lseek(f.fd, 0, 0);                   # SEEK_SET

    if end_pos <= 0:
        let empty = vir_alloc(1);
        extern func native_write_u8(addr: int, offset: int, val: int);
        native_write_u8(empty, 0, 0);
        out empty;
    end

    let buf = vir_alloc(end_pos + 1);
    let total = 0;
    when total < end_pos loop
        let n = sys_read(f.fd, buf + total, end_pos - total);
        if n <= 0:
            out skip;
        end
        total = total + n;
    end

    extern func native_write_u8(addr: int, offset: int, val: int);
    native_write_u8(buf, total, 0);    # null-terminate
    out buf;
end

func file_read_bytes:
    in(f: VirFile, buf: int, count: int)
    if f.is_open == false:
        out -1;
    end
    out sys_read(f.fd, buf, count);
end

# ═══════════════════════════════════════════════════════
# File Write
# ═══════════════════════════════════════════════════════

func file_write_str:
    in(f: VirFile, s: int)
    if f.is_open == false:
        out -1;
    end
    let len = rt_strlen(s);
    out sys_write(f.fd, s, len);
end

func file_write_bytes:
    in(f: VirFile, data: int, len: int)
    if f.is_open == false:
        out -1;
    end
    let written = 0;
    when written < len loop
        let n = sys_write(f.fd, data + written, len - written);
        if n <= 0:
            out skip;
        end
        written = written + n;
    end
    out written;
end

# ═══════════════════════════════════════════════════════
# File Size
# ═══════════════════════════════════════════════════════

func file_size:
    in(f: VirFile)
    let cur = sys_lseek(f.fd, 0, 1);      # SEEK_CUR
    let end_pos = sys_lseek(f.fd, 0, 2);  # SEEK_END
    sys_lseek(f.fd, cur, 0);              # restore position
    out end_pos;
end

# ═══════════════════════════════════════════════════════
# Convenience: Read file by path
# ═══════════════════════════════════════════════════════

func read_file_str:
    in(path: int)
    let f = file_open_read(path);
    if f.is_open == false:
        out 0;
    end
    let content = file_read_all(f);
    file_close(f);
    out content;
end

# ═══════════════════════════════════════════════════════
# Convenience: Write string to file by path
# ═══════════════════════════════════════════════════════

func write_file_str:
    in(path: int, content: int)
    let f = file_open_write(path, 0o644);
    if f.is_open == false:
        out false;
    end
    file_write_str(f, content);
    file_close(f);
    out true;
end

# ═══════════════════════════════════════════════════════
# Convenience: Write bytes to file by path
# ═══════════════════════════════════════════════════════

func write_file_bytes:
    in(path: int, data: int, len: int, mode: int)
    let f = file_open_write(path, mode);
    if f.is_open == false:
        out false;
    end
    file_write_bytes(f, data, len);
    sys_close(f.fd);
    out true;
end

# ═══ END: stdlib/vir/rt/io.vri ═══

import print_str, print_int, print_ln, print_newline, eprint_ln,
       file_open_read, file_read_all, file_close,
       write_file_bytes, read_file_str from io;
# [merged] include vir::rt::vec_rt;
# ═══ BEGIN: stdlib/vir/rt/vec_rt.vri ═══
##
 * vir/rt/vec_rt.vri — Dynamic Array Runtime (Pure Vir)
 * =====================================================
 * Growable vector (dynamic array) built on vir_alloc/realloc.
 * Core data structure for the self-hosting compiler.
 *
 * Layout: [cap:i64][len:i64][data[0]][data[1]]...
 *                            ^-- returned pointer
 ##

# [merged] module vir::rt::vec_rt;

# [merged] include types;
# [merged] include alloc;
# [merged] import vir_alloc, vir_free, vir_realloc from alloc;

extern func native_read_i64(addr: int, offset: int) -> int;
extern func native_write_i64(addr: int, offset: int, val: int);
extern func native_mem_copy(dst: int, src: int, len: int);

# ═══════════════════════════════════════════════════════
# Vec operations (i64 element array)
# ═══════════════════════════════════════════════════════
# Header: ptr[-2] = capacity, ptr[-1] = length
# Data starts at ptr[0]

const VEC_INIT_CAP = 16;
const ELEM_SIZE = 8;          # i64 = 8 bytes
const HEADER_SIZE = 16;       # 2 * 8 bytes

func vec_new_rt:
    let base = vir_alloc(HEADER_SIZE + VEC_INIT_CAP * ELEM_SIZE);
    let data = base + HEADER_SIZE;
    native_write_i64(base, 0, VEC_INIT_CAP);   # capacity
    native_write_i64(base, 1, 0);               # length
    out data;
end

func vec_len_rt:
    in(v: int)
    if v == 0:
        out 0;
    end
    out native_read_i64(v - 8, 0);    # ptr[-1]
end

func vec_cap_rt:
    in(v: int)
    out native_read_i64(v - 16, 0);   # ptr[-2]
end

func vec_push_rt:
    in(v: int, val: int)
    let len = vec_len_rt(v);
    let cap = vec_cap_rt(v);

    if len >= cap:
        # Grow: double capacity
        let new_cap = cap * 2;
        if new_cap < VEC_INIT_CAP:
            new_cap = VEC_INIT_CAP;
        end
        let base = v - HEADER_SIZE;
        let new_base = vir_realloc(base, HEADER_SIZE + new_cap * ELEM_SIZE);
        let new_data = new_base + HEADER_SIZE;
        native_write_i64(new_base, 0, new_cap);
        v = new_data;
    end

    native_write_i64(v, len, val);
    native_write_i64(v - 8, 0, len + 1);
    out v;
end

func vec_get_rt:
    in(v: int, index: int)
    if v == 0:
        out 0;
    end
    out native_read_i64(v, index);
end

func vec_set_rt:
    in(v: int, index: int, val: int)
    native_write_i64(v, index, val);
end

func vec_pop_rt:
    in(v: int)
    let len = vec_len_rt(v);
    if len == 0:
        out 0;
    end
    let val = vec_get_rt(v, len - 1);
    native_write_i64(v - 8, 0, len - 1);
    out val;
end

func vec_last_rt:
    in(v: int)
    let len = vec_len_rt(v);
    if len == 0:
        out 0;
    end
    out vec_get_rt(v, len - 1);
end

func vec_clear_rt:
    in(v: int)
    native_write_i64(v - 8, 0, 0);
end

func vec_free_rt:
    in(v: int)
    vir_free(v - HEADER_SIZE);
end

func vec_copy_rt:
    in(v: int)
    let len = vec_len_rt(v);
    let new_v = vec_new_rt();
    let i = 0;
    when i < len loop
        new_v = vec_push_rt(new_v, vec_get_rt(v, i));
        i = i + 1;
    end
    out new_v;
end

func vec_contains_rt:
    in(v: int, val: int)
    let len = vec_len_rt(v);
    let i = 0;
    when i < len loop
        if vec_get_rt(v, i) == val:
            out true;
        end
        i = i + 1;
    end
    out false;
end

func vec_index_of_rt:
    in(v: int, val: int)
    let len = vec_len_rt(v);
    let i = 0;
    when i < len loop
        if vec_get_rt(v, i) == val:
            out i;
        end
        i = i + 1;
    end
    out -1;
end

# ═══════════════════════════════════════════════════════
# Byte Vec — for code buffers (u8 elements)
# ═══════════════════════════════════════════════════════

extern func native_read_u8(addr: int, offset: int) -> int;
extern func native_write_u8(addr: int, offset: int, val: int);

const BVEC_INIT_CAP = 4096;

func bvec_new:
    let base = vir_alloc(HEADER_SIZE + BVEC_INIT_CAP);
    let data = base + HEADER_SIZE;
    native_write_i64(base, 0, BVEC_INIT_CAP);
    native_write_i64(base, 1, 0);
    out data;
end

func bvec_len:
    in(v: int)
    out native_read_i64(v - 8, 0);
end

func bvec_push:
    in(v: int, byte: int)
    let len = bvec_len(v);
    let cap = native_read_i64(v - 16, 0);

    if len >= cap:
        let new_cap = cap * 2;
        let base = v - HEADER_SIZE;
        let new_base = vir_realloc(base, HEADER_SIZE + new_cap);
        let new_data = new_base + HEADER_SIZE;
        native_write_i64(new_base, 0, new_cap);
        v = new_data;
    end

    native_write_u8(v, len, byte & 0xFF);
    native_write_i64(v - 8, 0, len + 1);
    out v;
end

func bvec_push_u16_le:
    in(v: int, val: int)
    v = bvec_push(v, val & 0xFF);
    v = bvec_push(v, (val >> 8) & 0xFF);
    out v;
end

func bvec_push_u32_le:
    in(v: int, val: int)
    v = bvec_push(v, val & 0xFF);
    v = bvec_push(v, (val >> 8) & 0xFF);
    v = bvec_push(v, (val >> 16) & 0xFF);
    v = bvec_push(v, (val >> 24) & 0xFF);
    out v;
end

func bvec_push_u64_le:
    in(v: int, val: int)
    v = bvec_push_u32_le(v, val & 0xFFFFFFFF);
    v = bvec_push_u32_le(v, (val >> 32) & 0xFFFFFFFF);
    out v;
end

func bvec_get:
    in(v: int, index: int)
    out native_read_u8(v, index);
end

func bvec_set:
    in(v: int, index: int, byte: int)
    native_write_u8(v, index, byte & 0xFF);
end

func bvec_patch_u32_le:
    in(v: int, offset: int, val: int)
    native_write_u8(v, offset, val & 0xFF);
    native_write_u8(v, offset + 1, (val >> 8) & 0xFF);
    native_write_u8(v, offset + 2, (val >> 16) & 0xFF);
    native_write_u8(v, offset + 3, (val >> 24) & 0xFF);
end

func bvec_data_ptr:
    in(v: int)
    out v;   # data pointer is v itself
end

func bvec_free:
    in(v: int)
    vir_free(v - HEADER_SIZE);
end

# ═══ END: stdlib/vir/rt/vec_rt.vri ═══

import vec_new_rt, vec_push_rt, vec_get_rt, vec_set_rt, vec_len_rt,
       vec_free_rt, bvec_new, bvec_push, bvec_push_u32_le,
       bvec_push_u64_le, bvec_len, bvec_get, bvec_data_ptr,
       bvec_free from vec_rt;
# [merged] include vir::rt::start;
# ═══ BEGIN: stdlib/vir/rt/start.vri ═══
##
 * vir/rt/start.vri — Program Entry Point (Pure Vir, No C)
 * =========================================================
 * This replaces runtime.c entirely.
 *
 * On macOS ARM64 (Mach-O), the kernel jumps to _start.
 * The stack contains:
 *   [SP]     → argc (i64)
 *   [SP+8]   → argv[0] pointer
 *   [SP+16]  → argv[1] pointer
 *   ...
 *   [SP+8*(argc+1)] → NULL
 *   then envp[]
 *
 * On Linux ARM64 (ELF), identical stack layout.
 *
 * This module:
 *   1. Extracts argc/argv from stack
 *   2. Initializes the heap allocator
 *   3. Calls user's main() function
 *   4. Calls sys_exit with return code
 ##

# [merged] module vir::rt::start;

# [merged] include types;
# [merged] include syscall;
# [merged] import sys_exit from syscall;
# [merged] include alloc;
# [merged] import heap_init, MIN_ARENA_SIZE from alloc;

# ═══════════════════════════════════════════════════════
# Global argc/argv (set by _start)
# ═══════════════════════════════════════════════════════

var g_argc = 0;
var g_argv = 0;     # pointer to argv array

func rt_argc:
    out g_argc;
end

func rt_argv:
    in(index: int)
    if index < 0 or index >= g_argc:
        out 0;
    end
    extern func native_read_i64(addr: int, offset: int) -> int;
    out native_read_i64(g_argv, index * 8);
end

# ═══════════════════════════════════════════════════════
# Forward declaration: user's main function
# ═══════════════════════════════════════════════════════
# The compiler will resolve this to the user's main() function.

extern func vir_main() -> int;

# ═══════════════════════════════════════════════════════
# _start — The TRUE entry point (no C involved)
# ═══════════════════════════════════════════════════════
# The compiler emits this as bare assembly.
# On ARM64 macOS:
#   _start:
#       ldr  x0, [sp]          // argc
#       add  x1, sp, #8        // argv
#       bl   _vir_start
#       mov  x16, #1           // SYS_exit
#       svc  #0x80
#
# This function is called by that assembly stub.

func _vir_start:
    in(argc: int, argv: int)

    # Store globals
    g_argc = argc;
    g_argv = argv;

    # Initialize heap (4MB)
    heap_init(MIN_ARENA_SIZE * 4);

    # Call user's main()
    let exit_code = vir_main();

    # Exit
    sys_exit(exit_code);
end

# ═══════════════════════════════════════════════════════
# Compiler-emitted intrinsics
# ═══════════════════════════════════════════════════════
# The following are emitted as inline machine code by the
# Vir compiler. They do NOT call libc.

# Memory intrinsics (compiled to plain load/store instructions)
# native_read_u8(addr, offset)   → ldrb w0, [x0, x1]
# native_write_u8(addr, ofs, v)  → strb w2, [x0, x1]
# native_read_i64(addr, offset)  → ldr  x0, [x0, x1]
# native_write_i64(addr, ofs, v) → str  x2, [x0, x1]
# native_mem_copy(dst, src, len) → loop of ldrb/strb
# native_mem_set(dst, val, len)  → loop of strb

# Syscall intrinsics (compiled to SVC / SYSCALL instructions)
# syscall0..6 → mov args to regs, mov sysnum to x16/x8/rax, svc/syscall

# ═══ END: stdlib/vir/rt/start.vri ═══

# [merged] import rt_argc, rt_argv from start;
# [merged] include vir::str::string;
# ═══ BEGIN: stdlib/vir/str/string.vri ═══
##
 * vir/str/string.vri — Immutable UTF-8 String
 * =============================================
 * String default của Vir là UTF-8 immutable.
 * Biến đổi string -> tạo string mới (use StringBuilder cho hiệu suất).
 *
 * Inspired by C23: <string.h> strlen, strcmp, strstr
 * Inspired by Python: str type methods
 * Vượt cả hai: Unicode-first, không null-terminated.
 ##

# [merged] include types;
# [merged] include option;
# ═══ BEGIN: stdlib/vir/core/option.vri ═══
##
 * vir/core/option.vri — Option<T> = Some(T) | None
 * ==================================================
 * Replaces NULL pointer. All values that may be absent
 * must be wrapped in Option.
 *
 * Compiler uses internally: result lookup symbol table, find token, etc.
 ##

# [merged] include types;

# ═══════════════════════════════════════════════════════
# Option type — tagged union
# ═══════════════════════════════════════════════════════

enum Option:
    Some(value)     # Has value;
    None              # No value;
end

# ═══════════════════════════════════════════════════════
# State check
# ═══════════════════════════════════════════════════════

func is_some:
    in(opt:Option)
    case opt;
        case Some(_) out true
        case None out false
    end
end

func is_none:
    in(opt:Option)
    out not is_some(opt);
end

# ═══════════════════════════════════════════════════════
# Get value
# ═══════════════════════════════════════════════════════

func unwrap:
    in(opt:Option)
    # Get value from Some. Panic if None.
    case opt;
        case Some(v) out v
        case None panic("unwrap() called on None")
    end
end

func unwrap_or:
    in(opt:Option; default)
    # Get value internally Some, or out default if None.
    case opt;
        case Some(v) out v
        case None out default
    end
end

func unwrap_or_else:
    in(opt:Option; f:func)
    # Get value from Some, or call f() if None.
    case opt;
        case Some(v) out v
        case None out f()
    end
end

func expect:
    in(opt:Option; msg:string)
    # Like unwrap but with custom error message.
    case opt;
        case Some(v) out v
        case None panic(msg)
    end
end

# ═══════════════════════════════════════════════════════
# Transformations
# ═══════════════════════════════════════════════════════

func map:
    in(opt:Option; f:func)
    # Apply f to value if Some, keep None.
    # Some(x).map(f) -> Some(f(x))
    # None.map(f) -> None
    case opt;
        case Some(v) out Some(f(v))
        case None out None
    end
end

func flat_map:
    in(opt:Option; f:func)
    # f must return Option. Flatten result.
    # Some(x).flat_map(f) -> f(x)
    # None.flat_map(f) -> None
    case opt;
        case Some(v) out f(v)
        case None out None
    end
end

func filter:
    in(opt:Option; predicate:func)
    # Keep Some if predicate(value) returns true, otherwise None.
    case opt;
        case Some(v)
            if predicate(v):
                out Some(v);
            else
                out None;
            end
        case None out None
    end
end

func or_else:
    in(opt:Option; alternative:Option)
    # Returns opt if Some, otherwise return alternative.
    case opt;
        case Some(_) out opt
        case None out alternative
    end
end

func zip:
    in(a:Option; b:Option)
    # Combine two Options into Option<(a, b)>.
    # Both must be Some for result to be Some.
    if is_some(a) and is_some(b):
        out Some((unwrap(a), unwrap(b)));
    end
    out None;
end

# ═══════════════════════════════════════════════════════
# Conversions
# ═══════════════════════════════════════════════════════

func option_to_result:
    in(opt:Option; err)
    # Some(v) -> Ok(v), None -> Err(err)
    case opt;
        case Some(v) out Ok(v)
        case None out Err(err)
    end
end

# ═══ END: stdlib/vir/core/option.vri ═══

# [merged] import Option, Some, None from option;
# [merged] include result;
# ═══ BEGIN: stdlib/vir/core/result.vri ═══
##
 * vir/core/result.vri — Result<T, E> = Ok(T) | Err(E)
 * =====================================================
 * Explicit error handling, no exceptions.
 * Inspired by Rust Result type, replaces C errno + Python try/except.
 *
 * Compiler uses internally: parse result, codegen result, file I/O result.
 ##

# [merged] include types;
# [merged] include option;
# [merged] import Option, Some, None from option;

# ═══════════════════════════════════════════════════════
# Result type — tagged union
# ═══════════════════════════════════════════════════════

enum Result:
    Ok(value)       # Success;
    Err(error)          # Failure;
end

# ═══════════════════════════════════════════════════════
# State check
# ═══════════════════════════════════════════════════════

func is_ok:
    in(r:Result)
    case r;
        case Ok(_) out true
        case Err(_) out false
    end
end

func is_err:
    in(r:Result)
    out not is_ok(r);
end

# ═══════════════════════════════════════════════════════
# Get value
# ═══════════════════════════════════════════════════════

func unwrap:
    in(r:Result)
    # Get Ok value. Panic if Err.
    case r;
        case Ok(v) out v
        case Err(e) panic("unwrap() called on Err: " + to_string(e))
    end
end

func unwrap_err:
    in(r:Result)
    # Get Err value. Panic if Ok.
    case r;
        case Ok(_) panic("unwrap_err() called on Ok")
        case Err(e) out e
    end
end

func unwrap_or:
    in(r:Result; default)
    case r;
        case Ok(v) out v
        case Err(_) out default
    end
end

func unwrap_or_else:
    in(r:Result; f:func)
    case r;
        case Ok(v) out v
        case Err(e) out f(e)
    end
end

func expect:
    in(r:Result; msg:string)
    case r;
        case Ok(v) out v
        case Err(_) panic(msg)
    end
end

# ═══════════════════════════════════════════════════════
# Transformations
# ═══════════════════════════════════════════════════════

func map:
    in(r:Result; f:func)
    # Ok(x).map(f) -> Ok(f(x))
    # Err(e).map(f) -> Err(e)
    case r;
        case Ok(v) out Ok(f(v))
        case Err(e) out Err(e)
    end
end

func map_err:
    in(r:Result; f:func)
    # Ok(x).map_err(f) -> Ok(x)
    # Err(e).map_err(f) -> Err(f(e))
    case r;
        case Ok(v) out Ok(v)
        case Err(e) out Err(f(e))
    end
end

func flat_map:
    in(r:Result; f:func)
    # Ok(x).flat_map(f) -> f(x)   (f must return Result)
    # Err(e).flat_map(f) -> Err(e)
    case r;
        case Ok(v) out f(v)
        case Err(e) out Err(e)
    end
end

func and_then:
    in(r:Result; f:func)
    # Alias cho flat_map — string Result
    out flat_map(r, f);
end

func or_else:
    in(r:Result; f:func)
    # Ok(x).or_else(f) -> Ok(x)
    # Err(e).or_else(f) -> f(e)
    case r;
        case Ok(v) out Ok(v)
        case Err(e) out f(e)
    end
end

# ═══════════════════════════════════════════════════════
# Conversions
# ═══════════════════════════════════════════════════════

func result_to_option:
    in(r:Result)
    # Ok(v) -> Some(v), Err(_) -> None
    case r;
        case Ok(v) out Some(v)
        case Err(_) out None
    end
end

func ok:
    in(r:Result)
    # Alias cho result_to_option
    out result_to_option(r);
end

func err:
    in(r:Result)
    # Ok(_) -> None, Err(e) -> Some(e)
    case r;
        case Ok(_) out None
        case Err(e) out Some(e)
    end
end

# ═══════════════════════════════════════════════════════
# Result utilities (Result chaining)
# ═══════════════════════════════════════════════════════

func try_all:
    in(results:Vec<Result>)
    # If all Ok -> Ok(Vec values)
    # If any Err -> return first Err
    values = vec_new();
    for each r in results;
        case r;
            case Ok(v) vec_push(values, v)
            case Err(e) out Err(e)
        end
    end
    out Ok(values);
end

# ═══ END: stdlib/vir/core/result.vri ═══

# [merged] import Result, Ok, Err from result;
# [merged] include alloc;
# ═══ BEGIN: stdlib/vir/mem/alloc.vri ═══
##
 * vir/mem/alloc.vri — Memory Allocator Interface
 * ================================================
 * Inspired by C23: <stdlib.h> malloc/calloc/realloc/free
 * Vir use quản lý memory thủ công (manual) + arena cho bulk allocation.
 *
 * Compiler uses internally: AST node alloc, instruction buffer, symbol table.
 ##

# [merged] include types;
# [merged] include result;
# [merged] import Result, Ok, Err from result;

entity AllocError:
    msg: string;
    requested_size: int;
end

# ═══════════════════════════════════════════════════════
# Global allocator (wraps OS malloc/free)
# ═══════════════════════════════════════════════════════

func alloc:
    in(size:int)
    # Cấp phát `size` bytes trên heap. Panic if end memory.
    if size == 0 out null end:
    p = native_malloc(size);
    if p == null:
        panic("out of memory: alloc(" + to_string(size) + ")");
    end
    out p;
end

func alloc_zeroed:
    in(size:int)
    # Cấp phát `size` bytes, khởi tạo toàn bộ = 0.
    if size == 0 out null end:
    p = native_calloc(1, size);
    if p == null:
        panic("out of memory: alloc_zeroed(" + to_string(size) + ")");
    end
    out p;
end

func try_alloc:
    in(size:int)
    # Cấp phát không panic — trả Result.
    if size == 0 out Ok(null) end:
    p = native_malloc(size);
    if p == null:
        out Err(AllocError { msg: "allocation failed", requested_size: size });
    end
    out Ok(p);
end

func realloc:
    in(p:ptr; new_size:int)
    # Thay đổi size vùng nhớ. Panic if failed.
    new_p = native_realloc(p, new_size);
    if new_p == null and new_size > 0:
        panic("out of memory: realloc(" + to_string(new_size) + ")");
    end
    out new_p;
end

func free:
    in(p:ptr)
    # Giải phóng vùng nhớ. Safe to call với null.
    if p != null:
        native_free(p);
    end
end

# ═══════════════════════════════════════════════════════
# Kích thước type
# ═══════════════════════════════════════════════════════

func size_of_i8:
func size_of_i16:
func size_of_i32:
func size_of_i64:
func size_of_u8:
func size_of_u16:
func size_of_u32:
func size_of_u64:
func size_of_f32:
func size_of_f64:
func size_of_ptr:

# ═══ END: stdlib/vir/mem/alloc.vri ═══

# [merged] import alloc, free from alloc;
# [merged] include copy;
# ═══ BEGIN: stdlib/vir/mem/copy.vri ═══
##
 * vir/mem/copy.vri — Memory Operations
 * ======================================
 * Inspired by C23: <string.h> memcpy, memset, memmove, memcmp
 ##

# [merged] include types;

func mem_copy:
    in(dst:ptr; src:ptr; n:int)
    # Copy n bytes từ src sang dst. Hành vi không xác định if overlap.
    native_memcpy(dst, src, n);
end

func mem_move:
    in(dst:ptr; src:ptr; n:int)
    # Copy n bytes từ src sang dst. An toàn khi overlap.
    native_memmove(dst, src, n);
end

func mem_set:
    in(dst:ptr; val:int; n:int)
    # Đặt n bytes tại dst thành val.
    native_memset(dst, val, n);
end

func mem_zero:
    in(dst:ptr; n:int)
    # Đặt n bytes = 0.
    mem_set(dst, 0, n);
end

func mem_cmp:
    in(a:ptr; b:ptr; n:int)
    # So sánh n bytes. Returns 0 if giống, < 0 if a < b, > 0 if a > b
    out native_memcmp(a, b, n);
end

func mem_eq:
    in(a:ptr; b:ptr; n:int)
    out mem_cmp(a, b, n) == 0;
end

# ═══ END: stdlib/vir/mem/copy.vri ═══

# [merged] import mem_copy, mem_cmp from copy;

entity String:
    data: ptr       # UTF-8 encoded bytes (owned, NOT null-terminated inside);
    byte_len: int   # Số bytes;
    char_len: int   # Số Unicode codepoints (cached, tính lần đầu);
end

# ═══════════════════════════════════════════════════════
# Tạo string
# ═══════════════════════════════════════════════════════

func str_new:
    in(literal:string)
    # Tạo String từ string literal. Copy dữ liệu.
    blen = native_str_byte_len(literal);
    p = alloc(blen);
    mem_copy(p, native_str_ptr(literal), blen);
    out string { data: p, byte_len: blen, char_len: utf8_count_chars(p, blen) };
end

func str_empty:
    out string { data: null, byte_len: 0, char_len: 0 };
end

func str_from_bytes:
    in(data:ptr; len:int)
    p = alloc(len);
    mem_copy(p, data, len);
    out string { data: p, byte_len: len, char_len: utf8_count_chars(p, len) };
end

# ═══════════════════════════════════════════════════════
# Thông tin cơ bản
# ═══════════════════════════════════════════════════════

func str_len:
    in(s:string)
    # Returns số codepoints (character Unicode)
    out s.char_len;
end

func str_byte_len:
    in(s:string)
    # Returns số bytes
    out s.byte_len;
end

func str_is_empty:
    in(s:string)
    out s.byte_len == 0;
end

# ═══════════════════════════════════════════════════════
# Truy cập character
# ═══════════════════════════════════════════════════════

func str_char_at:
    in(s:string; index:int)
    # Returns Unicode codepoint tại vị trí index (theo codepoint, O(n))
    if index >= s.char_len:
        panic("str_char_at: index out of bounds");
    end
    out utf8_char_at(s.data, s.byte_len, index);
end

func str_byte_at:
    in(s:string; index:int)
    # Returns byte tại vị trí index (O(1))
    if index >= s.byte_len:
        panic("str_byte_at: index out of bounds");
    end
    out native_read_u8(s.data, index);
end

# ═══════════════════════════════════════════════════════
# So sánh
# ═══════════════════════════════════════════════════════

func str_eq:
    in(a:string; b:string)
    if a.byte_len != b.byte_len out false end:
    out mem_cmp(a.data, b.data, a.byte_len) == 0;
end

func str_cmp:
    in(a:string; b:string)
    min_len = if a.byte_len < b.byte_len a.byte_len else b.byte_len end;
    r = mem_cmp(a.data, b.data, min_len);
    if r != 0 out r end:
    if a.byte_len < b.byte_len out -1 end:
    if a.byte_len > b.byte_len out 1 end:
    out 0;
end

# ═══════════════════════════════════════════════════════
# Cắt string (Slicing)
# ═══════════════════════════════════════════════════════

func str_slice:
    in(s:string; from:int; to:int)
    # Cắt theo vị trí codepoint [from, to)
    if from > to or to > s.char_len:
        panic("str_slice: invalid range");
    end
    byte_start = utf8_offset_of(s.data, s.byte_len, from);
    byte_end = utf8_offset_of(s.data, s.byte_len, to);
    out str_from_bytes(s.data + byte_start, byte_end - byte_start);
end

func str_slice_bytes:
    in(s:string; from:int; to:int)
    # Cắt theo byte offset [from, to) — nhanh hơn, phải đảm bảo valid UTF-8
    if from > to or to > s.byte_len:
        panic("str_slice_bytes: invalid range");
    end
    out str_from_bytes(s.data + from, to - from);
end

# ═══════════════════════════════════════════════════════
# Nối string (Concatenation)
# ═══════════════════════════════════════════════════════

func str_concat:
    in(a:string; b:string)
    total = a.byte_len + b.byte_len;
    p = alloc(total);
    mem_copy(p, a.data, a.byte_len);
    mem_copy(p + a.byte_len, b.data, b.byte_len);
    out string { data: p, byte_len: total, char_len: a.char_len + b.char_len };
end

# ═══════════════════════════════════════════════════════
# Tìm kiếm
# ═══════════════════════════════════════════════════════

func str_contains:
    in(haystack:string; needle:string)
    out is_some(str_find(haystack, needle));
end

func str_find:
    in(haystack:string; needle:string)
    # Two-Way algorithm — O(n) worst-case, O(1) space (same as glibc strstr)
    n = haystack.byte_len;
    m = needle.byte_len;
    if m == 0 out Some(0) end:
    if m > n out None end:
    if m == 1:
        # Single byte fast path
        b = native_read_u8(needle.data, 0);
        i = 0;
        when i < n loop
            if native_read_u8(haystack.data, i) == b:
                out Some(i);
            end
            i = i + 1;
        end
        out None;
    end

    # Compute maximal suffix (Two-Way critical factorization)
    ms = _two_way_maxsuf(needle.data, m, false);
    ms2 = _two_way_maxsuf(needle.data, m, true);
    if ms > ms2: period_pos = ms; else: period_pos = ms2; end

    # Check if needle has a periodic structure
    period = period_pos + 1;  # simplified period for Two-Way
    memory = 0;
    i = 0;
    when i <= n - m loop
        # Right half
        j = if memory > period_pos: memory; else: period_pos; end;
        found_right = true;
        when j < m loop
            if native_read_u8(haystack.data, i + j) != native_read_u8(needle.data, j):
                i = i + (j - period_pos);
                memory = 0;
                found_right = false;
                thoát;
            end
            j = j + 1;
        end
        if found_right:
            # Left half
            j = period_pos;
            matched = true;
            when j > memory loop
                j = j - 1;
                if native_read_u8(haystack.data, i + j) != native_read_u8(needle.data, j):
                    i = i + period;
                    memory = m - period;
                    matched = false;
                    thoát;
                end
            end
            if matched:
                out Some(i);
            end
        end
    end
    out None;
end

func _two_way_maxsuf:
    in(pat:ptr; m:int; reversed:bool)
    # Compute maximal suffix position for Two-Way algorithm
    ms = -1;
    j = 0;
    p = 1;
    k = 1;
    when j + k < m loop
        a = native_read_u8(pat, j + k);
        b = native_read_u8(pat, ms + k);
        if reversed: tmp = a; a = b; b = tmp; end
        if a < b:
            j = j + k;
            k = 1;
            p = j - ms;
        eif a == b:
            if k == p:
                j = j + p;
                k = 1;
            else
                k = k + 1;
            end
        else
            ms = j;
            j = ms + 1;
            k = 1;
            p = 1;
        end
    end
    out ms;
end

func str_starts_with:
    in(s:string; prefix:string)
    if prefix.byte_len > s.byte_len out false end:
    out mem_cmp(s.data, prefix.data, prefix.byte_len) == 0;
end

func str_ends_with:
    in(s:string; suffix:string)
    if suffix.byte_len > s.byte_len out false end:
    offset = s.byte_len - suffix.byte_len;
    out mem_cmp(s.data + offset, suffix.data, suffix.byte_len) == 0;
end

# ═══════════════════════════════════════════════════════
# Biến đổi
# ═══════════════════════════════════════════════════════

func str_to_upper:
    in(s:string)
    # ASCII to_upper (Unicode full case mapping cần bảng tra)
    p = alloc(s.byte_len);
    mem_copy(p, s.data, s.byte_len);
    với mỗi i in 0..s.byte_len;
        b = native_read_u8(p, i);
        if b >= 0x61 and b <= 0x7A:
            native_write_u8(p, i, b - 32);
        end
    end
    out string { data: p, byte_len: s.byte_len, char_len: s.char_len };
end

func str_to_lower:
    in(s:string)
    p = alloc(s.byte_len);
    mem_copy(p, s.data, s.byte_len);
    với mỗi i in 0..s.byte_len;
        b = native_read_u8(p, i);
        if b >= 0x41 and b <= 0x5A:
            native_write_u8(p, i, b + 32);
        end
    end
    out string { data: p, byte_len: s.byte_len, char_len: s.char_len };
end

func str_trim:
    in(s:string)
    start = 0;
    when start < s.byte_len and is_ascii_whitespace(native_read_u8(s.data, start)) loop
        start = start + 1;
    end
    end = s.byte_len;
    when end > start and is_ascii_whitespace(native_read_u8(s.data, end - 1)) loop
        end = end - 1;
    end
    out str_slice_bytes(s, start, end);
end

func str_trim_start:
    in(s:string)
    start = 0;
    when start < s.byte_len and is_ascii_whitespace(native_read_u8(s.data, start)) loop
        start = start + 1;
    end
    out str_slice_bytes(s, start, s.byte_len);
end

func str_trim_end:
    in(s:string)
    end = s.byte_len;
    when end > 0 and is_ascii_whitespace(native_read_u8(s.data, end - 1)) loop
        end = end - 1;
    end
    out str_slice_bytes(s, 0, end);
end

func str_replace:
    in(s:string; old:string; new:string)
    # Thay thế tất cả occurrence của `old` bằng `new`
    # TODO: implement using StringBuilder for efficiency
    out native_str_replace(s, old, new);
end

func str_repeat:
    in(s:string; count:int)
    total = s.byte_len * count;
    p = alloc(total);
    với mỗi i in 0..count;
        mem_copy(p + i * s.byte_len, s.data, s.byte_len);
    end
    out string { data: p, byte_len: total, char_len: s.char_len * count };
end

# ═══════════════════════════════════════════════════════
# Tách / Nối
# ═══════════════════════════════════════════════════════

func str_split:
    in(s:string; delim:string)
    # Tách string theo delimiter
    out native_str_split(s, delim);
end

func str_join:
    in(parts:Vec<string>; sep:string)
    # Nối các string với separator
    out native_str_join(parts, sep);
end

# ═══════════════════════════════════════════════════════
# Conversions
# ═══════════════════════════════════════════════════════

func str_to_i64:
    in(s:string)
    out parse_int(s);
end

func str_to_f64:
    in(s:string)
    out parse_float(s);
end

func i64_to_str:
    in(n:int)
    out native_i64_to_str(n);
end

func str_from_i64:
    in(n:int)
    out i64_to_str(n);
end

func f64_to_str:
    in(f:float)
    out native_f64_to_str(f);
end

func str_free:
    in(s:string)
    free(s.data);
end

# ═══════════════════════════════════════════════════════
# UTF-8 helpers (internal)
# ═══════════════════════════════════════════════════════

func is_ascii_whitespace:
    in(b:int)
    out b == 0x20 or b == 0x09 or b == 0x0A or b == 0x0D;
end

func utf8_count_chars:
    in(data:ptr; byte_len:int)
    # Đếm số codepoints in UTF-8 data
    count = 0;
    i = 0;
    when i < byte_len loop
        b = native_read_u8(data, i);
        if (b & 0x80) == 0:
            i = i + 1           # 1-byte (ASCII);
        eif (b & 0xE0) == 0xC0:
            i = i + 2           # 2-byte;
        eif (b & 0xF0) == 0xE0:
            i = i + 3           # 3-byte;
        eif (b & 0xF8) == 0xF0:
            i = i + 4           # 4-byte;
        else
            i = i + 1           # invalid, skip byte;
        end
        count = count + 1;
    end
    out count;
end

func utf8_char_at:
    in(data:ptr; byte_len:int; char_index:int)
    # Lấy codepoint tại vị trí char_index (O(n) scan)
    count = 0;
    i = 0;
    when i < byte_len loop
        b = native_read_u8(data, i);
        if count == char_index:
            out utf8_decode_char(data, i, byte_len);
        end
        if (b & 0x80) == 0 i = i + 1:
        eif (b & 0xE0) == 0xC0 i = i + 2:
        eif (b & 0xF0) == 0xE0 i = i + 3:
        eif (b & 0xF8) == 0xF0 i = i + 4:
        else i = i + 1;
        end
        count = count + 1;
    end
    panic("utf8_char_at: index out of bounds");
end

func utf8_offset_of:
    in(data:ptr; byte_len:int; char_index:int)
    count = 0;
    i = 0;
    when i < byte_len and count < char_index loop
        b = native_read_u8(data, i);
        if (b & 0x80) == 0 i = i + 1:
        eif (b & 0xE0) == 0xC0 i = i + 2:
        eif (b & 0xF0) == 0xE0 i = i + 3:
        eif (b & 0xF8) == 0xF0 i = i + 4:
        else i = i + 1;
        end
        count = count + 1;
    end
    out i;
end

# ═══ END: stdlib/vir/str/string.vri ═══


# ── Mach-O/ELF emitters — MUST be BEFORE compiler/main (which includes
#    binary.vri) so that these definitions win under "first compiled wins" ──
# [merged] include vir::rt::macho;
# ═══ BEGIN: stdlib/vir/rt/macho.vri ═══
##
 * vir/rt/macho.vri — Mach-O Executable Emitter (Pure Vir)
 * =========================================================
 * Emits a complete Mach-O 64-bit executable for macOS ARM64
 * and x86-64. No external assembler (as) or linker (ld) needed.
 *
 * Produces a standalone binary that the kernel can exec directly:
 *   Mach-O Header → Load Commands → __TEXT → __DATA → LC_MAIN
 *
 * The binary uses direct BSD syscalls — no dyld, no libSystem
 * unless linking is explicitly requested.
 ##

# [merged] module vir::rt::macho;

# [merged] include types;
# [merged] include vec_rt;
import bvec_new, bvec_push, bvec_push_u32_le, bvec_push_u64_le,
    bvec_len, bvec_get, bvec_set, bvec_patch_u32_le, bvec_data_ptr, bvec_free from vec_rt;
# [merged] include io;
# [merged] import write_file_bytes from io;
# [merged] include string_rt;
# [merged] import rt_strlen from string_rt;

# ═══════════════════════════════════════════════════════
# Mach-O Constants
# ═══════════════════════════════════════════════════════

# Magic numbers
const MH_MAGIC_64:      0xFEEDFACF;

# CPU types
const CPU_TYPE_X86_64:  0x01000007;
const CPU_TYPE_ARM64:   0x0100000C;
const CPU_SUB_ALL:      0x00000000;
const CPU_SUB_ARM64_ALL: 0x00000000;

# File types
const MH_EXECUTE:       2;

# Flags
const MH_NOUNDEFS:      0x00000001;
const MH_DYLDLINK:      0x00000004;
const MH_TWOLEVEL:      0x00000080;
const MH_PIE:           0x00200000;

# Load command types
const LC_SEGMENT_64:    0x19;
const LC_MAIN:          0x80000028;
const LC_SYMTAB:        0x02;
const LC_DYSYMTAB:      0x0B;
const LC_UUID:          0x1B;
const LC_BUILD_VERSION: 0x32;
const LC_SOURCE_VERSION: 0x2A;
const LC_LOAD_DYLIB:    0x0C;
const LC_LOAD_DYLINKER: 0x0E;
const LC_DYLD_INFO_ONLY: 0x80000022;
const LC_DYLD_CHAINED_FIXUPS: 0x80000034;

# Segment/section constants
const VM_PROT_READ:     1;
const VM_PROT_WRITE:    2;
const VM_PROT_EXECUTE:  4;

const S_ATTR_PURE_INSTRUCTIONS: 0x80000000;
const S_ATTR_SOME_INSTRUCTIONS: 0x00000400;
const S_REGULAR:        0x00000000;
const S_ZEROFILL:       0x00000001;

# Page sizes
const PAGE_SIZE_ARM64:  0x4000;     # 16KB
const PAGE_SIZE_X86:    0x1000;     # 4KB
const TEXT_BASE:        0x100000000;

# ═══════════════════════════════════════════════════════
# Mach-O Builder
# ═══════════════════════════════════════════════════════

entity MachOBuilder:
    buf:            int;        # bvec byte buffer
    arch:           int;        # 0=ARM64, 1=x86_64
    page_size:      int;
    text_code:      int;        # bvec with machine code
    data_bytes:     int;        # bvec with data section
    entry_offset:   int;        # offset of _start in __text
end

func macho_new:
    in(arch: int)
    let page = PAGE_SIZE_ARM64;
    if arch == 1:
        page = PAGE_SIZE_X86;
    end
    out MachOBuilder {
        buf: bvec_new(),
        arch: arch,
        page_size: page,
        text_code: bvec_new(),
        data_bytes: bvec_new(),
        entry_offset: 0
    };
end

# ═══════════════════════════════════════════════════════
# Write Header
# ═══════════════════════════════════════════════════════

func macho_write_header:
    in(b: MachOBuilder, ncmds: int, sizeofcmds: int)
    let buf = b.buf;

    # MH_MAGIC_64
    buf = bvec_push_u32_le(buf, MH_MAGIC_64);

    # CPU type
    if b.arch == 0:
        buf = bvec_push_u32_le(buf, CPU_TYPE_ARM64);
        buf = bvec_push_u32_le(buf, CPU_SUB_ARM64_ALL);
    else
        buf = bvec_push_u32_le(buf, CPU_TYPE_X86_64);
        buf = bvec_push_u32_le(buf, CPU_SUB_ALL);
    end

    # File type
    buf = bvec_push_u32_le(buf, MH_EXECUTE);

    # Number of load commands
    buf = bvec_push_u32_le(buf, ncmds);

    # Size of load commands
    buf = bvec_push_u32_le(buf, sizeofcmds);

    # Flags: PIE + NOUNDEFS + DYLDLINK + TWOLEVEL (required for dynamic linking)
    buf = bvec_push_u32_le(buf, MH_PIE | MH_NOUNDEFS | MH_DYLDLINK | MH_TWOLEVEL);

    # Reserved (64-bit header)
    buf = bvec_push_u32_le(buf, 0);

    b.buf = buf;
    out b;
end

# ═══════════════════════════════════════════════════════
# Write LC_SEGMENT_64
# ═══════════════════════════════════════════════════════

func macho_write_segment:
    in(b: MachOBuilder, name: int, vmaddr: int, vmsize: int,
       fileoff: int, filesize: int, maxprot: int, initprot: int,
       nsects: int)
    let buf = b.buf;

    # cmd
    buf = bvec_push_u32_le(buf, LC_SEGMENT_64);

    # cmdsize (72 + 80 * nsects)
    let cmdsize = 72 + 80 * nsects;
    buf = bvec_push_u32_le(buf, cmdsize);

    # segname (16 bytes, padded)
    let name_len = rt_strlen(name);
    let i = 0;
    extern func native_read_u8(addr: int, offset: int) -> int;
    when i < 16 loop
        if i < name_len:
            buf = bvec_push(buf, native_read_u8(name, i));
        else
            buf = bvec_push(buf, 0);
        end
        i = i + 1;
    end

    # vmaddr, vmsize
    buf = bvec_push_u64_le(buf, vmaddr);
    buf = bvec_push_u64_le(buf, vmsize);

    # fileoff, filesize
    buf = bvec_push_u64_le(buf, fileoff);
    buf = bvec_push_u64_le(buf, filesize);

    # maxprot, initprot
    buf = bvec_push_u32_le(buf, maxprot);
    buf = bvec_push_u32_le(buf, initprot);

    # nsects, flags
    buf = bvec_push_u32_le(buf, nsects);
    buf = bvec_push_u32_le(buf, 0);

    b.buf = buf;
    out b;
end

# ═══════════════════════════════════════════════════════
# Write Section Header (within a segment)
# ═══════════════════════════════════════════════════════

func macho_write_section:
    in(b: MachOBuilder, sectname: int, segname: int,
       addr: int, size: int, offset: int, align: int,
       flags: int)
    let buf = b.buf;

    extern func native_read_u8(addr: int, offset: int) -> int;

    # sectname (16 bytes)
    let sn_len = rt_strlen(sectname);
    let i = 0;
    when i < 16 loop
        if i < sn_len:
            buf = bvec_push(buf, native_read_u8(sectname, i));
        else
            buf = bvec_push(buf, 0);
        end
        i = i + 1;
    end

    # segname (16 bytes)
    let sg_len = rt_strlen(segname);
    i = 0;
    when i < 16 loop
        if i < sg_len:
            buf = bvec_push(buf, native_read_u8(segname, i));
        else
            buf = bvec_push(buf, 0);
        end
        i = i + 1;
    end

    # addr, size
    buf = bvec_push_u64_le(buf, addr);
    buf = bvec_push_u64_le(buf, size);

    # offset, align
    buf = bvec_push_u32_le(buf, offset);
    buf = bvec_push_u32_le(buf, align);

    # reloff, nreloc
    buf = bvec_push_u32_le(buf, 0);
    buf = bvec_push_u32_le(buf, 0);

    # flags, reserved1, reserved2
    buf = bvec_push_u32_le(buf, flags);
    buf = bvec_push_u32_le(buf, 0);
    buf = bvec_push_u32_le(buf, 0);
    buf = bvec_push_u32_le(buf, 0);

    b.buf = buf;
    out b;
end

# ═══════════════════════════════════════════════════════
# Write LC_MAIN
# ═══════════════════════════════════════════════════════

func macho_write_lc_main:
    in(b: MachOBuilder, entryoff: int)
    let buf = b.buf;

    buf = bvec_push_u32_le(buf, LC_MAIN);
    buf = bvec_push_u32_le(buf, 24);           # cmdsize
    buf = bvec_push_u64_le(buf, entryoff);      # entryoff (file offset of entry)
    buf = bvec_push_u64_le(buf, 0);             # stacksize (0 = default)

    b.buf = buf;
    out b;
end

# ═══════════════════════════════════════════════════════
# Emit Complete Mach-O Executable
# ═══════════════════════════════════════════════════════

func macho_emit:
    in(b: MachOBuilder, entry_off_param: int)

    let page = b.page_size;
    let code_size = bvec_len(b.text_code);

    # ── Layout: code INLINE on page 0+, LINKEDIT on next page ──
    # 10 load commands:
    #   __PAGEZERO(72) + __TEXT+__text(152) + __LINKEDIT(72)
    #   + CHAINED_FIXUPS(16) + SYMTAB(24) + DYSYMTAB(80)
    #   + LOAD_DYLINKER(32) + UUID(24) + MAIN(24) + LOAD_DYLIB(56)
    let ncmds = 10;
    let sizeofcmds = 552;
    let header_end = 32 + sizeofcmds;

    # 32 bytes padding after LCs — codesign inserts LC_CODE_SIGNATURE here
    let code_offset = header_end + 32;

    # Entry point = file offset of _start within the code
    let entry_file_offset = code_offset + entry_off_param;

    # Calculate __TEXT segment size: must contain header + LCs + pad + code
    # Calculate __TEXT segment size: must contain header + LCs + pad + code
    # Round up to page boundary
    let text_raw_size = code_offset + code_size;
    let text_segment_size = ((text_raw_size + page - 1) / page) * page;

    # LINKEDIT: chained fixups (48 bytes) + string table (4 bytes) = 52 bytes
    let chained_fixups_size = 48;
    let string_table_size = 4;
    let linkedit_data_size = chained_fixups_size + string_table_size;
    let linkedit_fileoff = text_segment_size;
    let linkedit_vmaddr = TEXT_BASE + text_segment_size;
    let strtab_off = linkedit_fileoff + chained_fixups_size;

    # ── Write Mach-O header ──
    b = macho_write_header(b, ncmds, sizeofcmds);

    # ── 1. __PAGEZERO ──
    b = macho_write_segment(b, "__PAGEZERO", 0, TEXT_BASE, 0, 0, 0, 0, 0);

    # ── 2. __TEXT (header + LCs + code, page-aligned) ──
    b = macho_write_segment(b, "__TEXT",
                            TEXT_BASE, text_segment_size,
                            0, text_segment_size,
                            VM_PROT_READ | VM_PROT_WRITE | VM_PROT_EXECUTE,
                            VM_PROT_READ | VM_PROT_EXECUTE,
                            1);
    b = macho_write_section(b, "__text", "__TEXT",
                            TEXT_BASE + code_offset, code_size, code_offset,
                            2,
                            S_ATTR_PURE_INSTRUCTIONS | S_ATTR_SOME_INSTRUCTIONS);

    # ── 3. __LINKEDIT ──
    b = macho_write_segment(b, "__LINKEDIT",
                            linkedit_vmaddr, page,
                            linkedit_fileoff, linkedit_data_size,
                            VM_PROT_READ,
                            VM_PROT_READ,
                            0);

    # ── 4. LC_DYLD_CHAINED_FIXUPS ──
    b.buf = bvec_push_u32_le(b.buf, LC_DYLD_CHAINED_FIXUPS);
    b.buf = bvec_push_u32_le(b.buf, 16);
    b.buf = bvec_push_u32_le(b.buf, linkedit_fileoff);
    b.buf = bvec_push_u32_le(b.buf, chained_fixups_size);

    # ── 5. LC_SYMTAB ──
    b.buf = bvec_push_u32_le(b.buf, LC_SYMTAB);
    b.buf = bvec_push_u32_le(b.buf, 24);
    b.buf = bvec_push_u32_le(b.buf, strtab_off);
    b.buf = bvec_push_u32_le(b.buf, 0);
    b.buf = bvec_push_u32_le(b.buf, strtab_off);
    b.buf = bvec_push_u32_le(b.buf, string_table_size);

    # ── 6. LC_DYSYMTAB (80 bytes, all zeros after cmd/cmdsize) ──
    b.buf = bvec_push_u32_le(b.buf, LC_DYSYMTAB);
    b.buf = bvec_push_u32_le(b.buf, 80);
    let dsi = 0;
    when dsi < 18 loop
        b.buf = bvec_push_u32_le(b.buf, 0);
        dsi = dsi + 1;
    end

    # ── 7. LC_LOAD_DYLINKER ──
    b.buf = bvec_push_u32_le(b.buf, LC_LOAD_DYLINKER);
    b.buf = bvec_push_u32_le(b.buf, 32);
    b.buf = bvec_push_u32_le(b.buf, 12);
    extern func native_read_u8(addr: int, offset: int) -> int;
    let dyld_path = "/usr/lib/dyld";
    let dyld_len = 13;
    let di = 0;
    when di < 20 loop
        if di < dyld_len:
            b.buf = bvec_push(b.buf, native_read_u8(dyld_path, di));
        else
            b.buf = bvec_push(b.buf, 0);
        end
        di = di + 1;
    end

    # ── 8. LC_UUID (24 bytes) ──
    b.buf = bvec_push_u32_le(b.buf, LC_UUID);
    b.buf = bvec_push_u32_le(b.buf, 24);
    let ui = 1;
    when ui <= 16 loop
        b.buf = bvec_push(b.buf, ui);
        ui = ui + 1;
    end

    # ── 9. LC_MAIN ──
    b = macho_write_lc_main(b, entry_file_offset);

    # ── 10. LC_LOAD_DYLIB ──
    b.buf = bvec_push_u32_le(b.buf, LC_LOAD_DYLIB);
    b.buf = bvec_push_u32_le(b.buf, 56);
    b.buf = bvec_push_u32_le(b.buf, 24);
    b.buf = bvec_push_u32_le(b.buf, 0);
    b.buf = bvec_push_u32_le(b.buf, 0x00010000);
    b.buf = bvec_push_u32_le(b.buf, 0x00010000);
    let dylib_path = "/usr/lib/libSystem.B.dylib";
    let dylib_len = 26;
    let dli = 0;
    when dli < 32 loop
        if dli < dylib_len:
            b.buf = bvec_push(b.buf, native_read_u8(dylib_path, dli));
        else
            b.buf = bvec_push(b.buf, 0);
        end
        dli = dli + 1;
    end

    # ── Pad to code_offset ──
    let current = bvec_len(b.buf);
    when current < code_offset loop
        b.buf = bvec_push(b.buf, 0);
        current = current + 1;
    end

    # ── Write machine code (inline on page 0) ──
    let i = 0;
    when i < code_size loop
        b.buf = bvec_push(b.buf, bvec_get(b.text_code, i));
        i = i + 1;
    end

    # ── Pad to __TEXT segment boundary ──
    current = bvec_len(b.buf);
    when current < text_segment_size loop
        b.buf = bvec_push(b.buf, 0);
        current = current + 1;
    end

    # ── Write LINKEDIT data ──
    # Chained fixups header (28 bytes)
    b.buf = bvec_push_u32_le(b.buf, 0);     # fixups_version
    b.buf = bvec_push_u32_le(b.buf, 28);    # starts_offset
    b.buf = bvec_push_u32_le(b.buf, 44);    # imports_offset
    b.buf = bvec_push_u32_le(b.buf, 44);    # symbols_offset
    b.buf = bvec_push_u32_le(b.buf, 0);     # imports_count
    b.buf = bvec_push_u32_le(b.buf, 1);     # imports_format (DYLD_CHAINED_IMPORT)
    b.buf = bvec_push_u32_le(b.buf, 0);     # symbols_format

    # dyld_chained_starts_in_image (16 bytes)
    b.buf = bvec_push_u32_le(b.buf, 3);     # seg_count = 3
    b.buf = bvec_push_u32_le(b.buf, 0);     # seg_info_offset[0] (PAGEZERO)
    b.buf = bvec_push_u32_le(b.buf, 0);     # seg_info_offset[1] (TEXT)
    b.buf = bvec_push_u32_le(b.buf, 0);     # seg_info_offset[2] (LINKEDIT)

    # Padding to 48 bytes (44 actual + 4 pad)
    b.buf = bvec_push_u32_le(b.buf, 0);

    # String table (4 NUL bytes for LC_SYMTAB)
    b.buf = bvec_push_u32_le(b.buf, 0);

    out b;
end

# ═══════════════════════════════════════════════════════
# Write to disk
# ═══════════════════════════════════════════════════════

func macho_write_to_file:
    in(b: MachOBuilder, path: int)
    let eo = b.entry_offset;
    b = macho_emit(b, eo);
    let data = bvec_data_ptr(b.buf);
    let size = bvec_len(b.buf);
    write_file_bytes(path, data, size, 0o755);
    out true;
end
# ═══ END: stdlib/vir/rt/macho.vri ═══

# [merged] import MachOBuilder, macho_new, macho_write_to_file from macho;
# [merged] include vir::rt::elf;
# ═══ BEGIN: stdlib/vir/rt/elf.vri ═══
##
 * vir/rt/elf.vri — ELF Executable Emitter (Pure Vir)
 * ====================================================
 * Emits a complete ELF 64-bit executable for Linux ARM64
 * and x86-64. No external assembler or linker needed.
 *
 * Produces a statically-linked, no-libc binary that the
 * kernel can exec directly via _start + raw syscalls.
 *
 * Layout: ELF Header → Program Headers → .text → .data
 ##

# [merged] module vir::rt::elf;

# [merged] include types;
# [merged] include vec_rt;
import bvec_new, bvec_push, bvec_push_u16_le, bvec_push_u32_le,
       bvec_push_u64_le, bvec_len, bvec_get, bvec_data_ptr, bvec_free from vec_rt;
# [merged] include io;
# [merged] import write_file_bytes from io;

# ═══════════════════════════════════════════════════════
# ELF Constants
# ═══════════════════════════════════════════════════════

# ELF identification
const ELFMAG0:      0x7F;
const ELFMAG1:      0x45;      # 'E'
const ELFMAG2:      0x4C;      # 'L'
const ELFMAG3:      0x46;      # 'F'
const ELFCLASS64:   2;
const ELFDATA2LSB:  1;         # Little-endian
const EV_CURRENT:   1;
const ELFOSABI_NONE: 0;

# ELF type
const ET_EXEC:      2;

# Machine types
const EM_X86_64:    62;
const EM_AARCH64:   183;

# Program header types
const PT_LOAD:      1;
const PT_NOTE:      4;

# Flags
const PF_R:         4;
const PF_W:         2;
const PF_X:         1;

# Section header types
const SHT_NULL:     0;
const SHT_PROGBITS: 1;
const SHT_STRTAB:   3;

const SHF_ALLOC:    2;
const SHF_EXECINSTR: 4;
const SHF_WRITE:    1;

# Standard addresses
const ELF_BASE:     0x400000;
const ELF_PAGE:     0x1000;    # 4KB pages for x86_64

# Header sizes
const ELF_HEADER_SIZE: 64;
const PHDR_SIZE:    56;
const SHDR_SIZE:    64;

# ═══════════════════════════════════════════════════════
# ELF Builder
# ═══════════════════════════════════════════════════════

entity ElfBuilder:
    buf:            int;        # bvec byte buffer
    arch:           int;        # 0=ARM64, 1=x86_64
    text_code:      int;        # bvec with machine code
    data_bytes:     int;        # bvec with data section
    entry_offset:   int;        # offset of _start in .text
end

func elf_new:
    in(arch: int)
    out ElfBuilder {
        buf: bvec_new(),
        arch: arch,
        text_code: bvec_new(),
        data_bytes: bvec_new(),
        entry_offset: 0
    };
end

# ═══════════════════════════════════════════════════════
# Write ELF Header (64 bytes)
# ═══════════════════════════════════════════════════════

func elf_write_header:
    in(b: ElfBuilder, entry: int, phoff: int, shoff: int,
       phnum: int, shnum: int, shstrndx: int)
    let buf = b.buf;

    # e_ident (16 bytes)
    buf = bvec_push(buf, ELFMAG0);
    buf = bvec_push(buf, ELFMAG1);
    buf = bvec_push(buf, ELFMAG2);
    buf = bvec_push(buf, ELFMAG3);
    buf = bvec_push(buf, ELFCLASS64);
    buf = bvec_push(buf, ELFDATA2LSB);
    buf = bvec_push(buf, EV_CURRENT);
    buf = bvec_push(buf, ELFOSABI_NONE);
    # 8 bytes padding
    let i = 0;
    when i < 8 loop
        buf = bvec_push(buf, 0);
        i = i + 1;
    end

    # e_type
    buf = bvec_push_u16_le(buf, ET_EXEC);

    # e_machine
    if b.arch == 0:
        buf = bvec_push_u16_le(buf, EM_AARCH64);
    else
        buf = bvec_push_u16_le(buf, EM_X86_64);
    end

    # e_version
    buf = bvec_push_u32_le(buf, EV_CURRENT);

    # e_entry
    buf = bvec_push_u64_le(buf, entry);

    # e_phoff
    buf = bvec_push_u64_le(buf, phoff);

    # e_shoff
    buf = bvec_push_u64_le(buf, shoff);

    # e_flags
    buf = bvec_push_u32_le(buf, 0);

    # e_ehsize
    buf = bvec_push_u16_le(buf, ELF_HEADER_SIZE);

    # e_phentsize
    buf = bvec_push_u16_le(buf, PHDR_SIZE);

    # e_phnum
    buf = bvec_push_u16_le(buf, phnum);

    # e_shentsize
    buf = bvec_push_u16_le(buf, SHDR_SIZE);

    # e_shnum
    buf = bvec_push_u16_le(buf, shnum);

    # e_shstrndx
    buf = bvec_push_u16_le(buf, shstrndx);

    b.buf = buf;
    out b;
end

# ═══════════════════════════════════════════════════════
# Write Program Header (56 bytes)
# ═══════════════════════════════════════════════════════

func elf_write_phdr:
    in(b: ElfBuilder, p_type: int, p_flags: int,
       p_offset: int, p_vaddr: int, p_paddr: int,
       p_filesz: int, p_memsz: int, p_align: int)
    let buf = b.buf;

    buf = bvec_push_u32_le(buf, p_type);
    buf = bvec_push_u32_le(buf, p_flags);
    buf = bvec_push_u64_le(buf, p_offset);
    buf = bvec_push_u64_le(buf, p_vaddr);
    buf = bvec_push_u64_le(buf, p_paddr);
    buf = bvec_push_u64_le(buf, p_filesz);
    buf = bvec_push_u64_le(buf, p_memsz);
    buf = bvec_push_u64_le(buf, p_align);

    b.buf = buf;
    out b;
end

# ═══════════════════════════════════════════════════════
# Write Section Header (64 bytes)
# ═══════════════════════════════════════════════════════

func elf_write_shdr:
    in(b: ElfBuilder, sh_name: int, sh_type: int, sh_flags: int,
       sh_addr: int, sh_offset: int, sh_size: int,
       sh_link: int, sh_info: int, sh_addralign: int, sh_entsize: int)
    let buf = b.buf;

    buf = bvec_push_u32_le(buf, sh_name);
    buf = bvec_push_u32_le(buf, sh_type);
    buf = bvec_push_u64_le(buf, sh_flags);
    buf = bvec_push_u64_le(buf, sh_addr);
    buf = bvec_push_u64_le(buf, sh_offset);
    buf = bvec_push_u64_le(buf, sh_size);
    buf = bvec_push_u32_le(buf, sh_link);
    buf = bvec_push_u32_le(buf, sh_info);
    buf = bvec_push_u64_le(buf, sh_addralign);
    buf = bvec_push_u64_le(buf, sh_entsize);

    b.buf = buf;
    out b;
end

# ═══════════════════════════════════════════════════════
# Emit Complete ELF Executable
# ═══════════════════════════════════════════════════════

func elf_emit:
    in(b: ElfBuilder)

    let code_size = bvec_len(b.text_code);
    let data_size = bvec_len(b.data_bytes);
    let page = ELF_PAGE;

    let has_data = 0;
    if data_size > 0:
        has_data = 1;
    end

    # Program headers: PT_LOAD for .text, PT_LOAD for .data (if any)
    let phnum = 1 + has_data;

    # Section headers: NULL + .text + .data (opt) + .shstrtab
    let shnum = 2 + has_data + 1;
    let shstrndx = 1 + has_data + 1;    # last section = .shstrtab

    # Layout calculation
    let headers_size = ELF_HEADER_SIZE + phnum * PHDR_SIZE;

    # Text starts at next page
    let text_offset = page;
    let text_vaddr = ELF_BASE + text_offset;

    # Align text size to page
    let text_pad_size = ((code_size + page - 1) / page) * page;

    # Data follows text
    let data_offset = text_offset + text_pad_size;
    let data_vaddr = ELF_BASE + data_offset;
    let data_pad_size = 0;
    if has_data == 1:
        data_pad_size = ((data_size + page - 1) / page) * page;
    end

    # Section headers at end
    let shoff = data_offset + data_pad_size;

    # Shstrtab content:  \0 .text \0 .data \0 .shstrtab \0
    let strtab_offset = shoff + shnum * SHDR_SIZE;

    # Entry point
    let entry = text_vaddr + b.entry_offset;

    # ── ELF Header ──
    b = elf_write_header(b, entry, ELF_HEADER_SIZE, shoff, phnum, shnum, shstrndx);

    # ── Program Headers ──

    # PT_LOAD: .text (RX)
    b = elf_write_phdr(b, PT_LOAD, PF_R | PF_X,
                       text_offset, text_vaddr, text_vaddr,
                       code_size, code_size, page);

    # PT_LOAD: .data (RW)
    if has_data == 1:
        b = elf_write_phdr(b, PT_LOAD, PF_R | PF_W,
                           data_offset, data_vaddr, data_vaddr,
                           data_size, data_size, page);
    end

    # ── Pad to text_offset ──
    let current = bvec_len(b.buf);
    when current < text_offset loop
        b.buf = bvec_push(b.buf, 0);
        current = current + 1;
    end

    # ── Write .text ──
    let i = 0;
    when i < code_size loop
        b.buf = bvec_push(b.buf, bvec_get(b.text_code, i));
        i = i + 1;
    end

    # ── Pad to page ──
    current = bvec_len(b.buf);
    let text_end = text_offset + text_pad_size;
    when current < text_end loop
        b.buf = bvec_push(b.buf, 0);
        current = current + 1;
    end

    # ── Write .data ──
    if has_data == 1:
        i = 0;
        when i < data_size loop
            b.buf = bvec_push(b.buf, bvec_get(b.data_bytes, i));
            i = i + 1;
        end

        current = bvec_len(b.buf);
        let data_end = data_offset + data_pad_size;
        when current < data_end loop
            b.buf = bvec_push(b.buf, 0);
            current = current + 1;
        end
    end

    # ── Section Headers ──

    # SHT_NULL (index 0)
    b = elf_write_shdr(b, 0, SHT_NULL, 0, 0, 0, 0, 0, 0, 0, 0);

    # .text (index 1) — name offset 1 in shstrtab
    b = elf_write_shdr(b, 1, SHT_PROGBITS,
                       SHF_ALLOC | SHF_EXECINSTR,
                       text_vaddr, text_offset, code_size,
                       0, 0, 16, 0);

    # .data (index 2, if present) — name offset 7 in shstrtab
    if has_data == 1:
        b = elf_write_shdr(b, 7, SHT_PROGBITS,
                           SHF_ALLOC | SHF_WRITE,
                           data_vaddr, data_offset, data_size,
                           0, 0, 8, 0);
    end

    # .shstrtab (last section)
    let shstrtab_name_off = 7;
    if has_data == 1:
        shstrtab_name_off = 13;
    end
    # Build shstrtab: \0.text\0.data\0.shstrtab\0
    let strtab_start = bvec_len(b.buf);
    let strtab_size = 0;
    if has_data == 1:
        # \0 .text \0 .data \0 .shstrtab \0
        strtab_size = 1 + 5 + 1 + 5 + 1 + 10 + 1;
    else
        # \0 .text \0 .shstrtab \0
        strtab_size = 1 + 5 + 1 + 10 + 1;
    end

    b = elf_write_shdr(b, shstrtab_name_off, SHT_STRTAB,
                       0, 0, strtab_start + SHDR_SIZE, strtab_size,
                       0, 0, 1, 0);

    # ── Write .shstrtab content ──
    # \0
    b.buf = bvec_push(b.buf, 0);

    # .text
    b.buf = bvec_push(b.buf, 0x2E);   # '.'
    b.buf = bvec_push(b.buf, 0x74);   # 't'
    b.buf = bvec_push(b.buf, 0x65);   # 'e'
    b.buf = bvec_push(b.buf, 0x78);   # 'x'
    b.buf = bvec_push(b.buf, 0x74);   # 't'
    b.buf = bvec_push(b.buf, 0);

    if has_data == 1:
        # .data
        b.buf = bvec_push(b.buf, 0x2E);   # '.'
        b.buf = bvec_push(b.buf, 0x64);   # 'd'
        b.buf = bvec_push(b.buf, 0x61);   # 'a'
        b.buf = bvec_push(b.buf, 0x74);   # 't'
        b.buf = bvec_push(b.buf, 0x61);   # 'a'
        b.buf = bvec_push(b.buf, 0);
    end

    # .shstrtab
    b.buf = bvec_push(b.buf, 0x2E);   # '.'
    b.buf = bvec_push(b.buf, 0x73);   # 's'
    b.buf = bvec_push(b.buf, 0x68);   # 'h'
    b.buf = bvec_push(b.buf, 0x73);   # 's'
    b.buf = bvec_push(b.buf, 0x74);   # 't'
    b.buf = bvec_push(b.buf, 0x72);   # 'r'
    b.buf = bvec_push(b.buf, 0x74);   # 't'
    b.buf = bvec_push(b.buf, 0x61);   # 'a'
    b.buf = bvec_push(b.buf, 0x62);   # 'b'
    b.buf = bvec_push(b.buf, 0);

    out b;
end

# ═══════════════════════════════════════════════════════
# Write to disk
# ═══════════════════════════════════════════════════════

func elf_write_to_file:
    in(b: ElfBuilder, path: int)
    b = elf_emit(b);
    let data = bvec_data_ptr(b.buf);
    let size = bvec_len(b.buf);
    write_file_bytes(path, data, size, 0o755);
    out true;
end

# ═══ END: stdlib/vir/rt/elf.vri ═══

# [merged] import ElfBuilder, elf_new, elf_write_to_file from elf;

# ── Compiler modules (self-hosting, pure Vir) ──
# [merged] include vir::compiler::lexer;
# ═══ BEGIN: stdlib/vir/compiler/lexer.vri ═══
##
 * vir/compiler/lexer.vri — Vir Source Lexer (Pure Vir)
 * =====================================================
 * UTF-8 tokenizer for Vir v1.2 standard syntax.
 * Converted from C (core/src/lexer.c) for self-hosting.
 *
 * Features:
 *   - Full v1.2 keyword set (English standard)
 *   - Multi-char operators (?=, ?., :~, >>, ||, ->, ..)
 *   - Block comments (double-hash delimited)
 *   - Hex literal support (0x...)
 *   - Paren-depth tracking (suppress newlines inside parens)
 *   - String escape sequences (\n, \t, \\, \", \')
 ##

# [merged] include types;
# [merged] include result;
# ═══ BEGIN: stdlib/vir/compiler/result.vri ═══
##
 * vir/core/result.vri — Result<T, E> = Ok(T) | Err(E)
 * =====================================================
 * Explicit error handling, no exceptions.
 * Inspired by Rust Result type, replaces C errno + Python try/except.
 *
 * Compiler uses internally: parse result, codegen result, file I/O result.
 ##

# [merged] include types;
# [merged] include option;
# ═══ BEGIN: stdlib/vir/compiler/option.vri ═══
##
 * vir/core/option.vri — Option<T> = Some(T) | None
 * ==================================================
 * Replaces NULL pointer. All values that may be absent
 * must be wrapped in Option.
 *
 * Compiler uses internally: result lookup symbol table, find token, etc.
 ##

# [merged] include types;

# ═══════════════════════════════════════════════════════
# Option type — tagged union
# ═══════════════════════════════════════════════════════

enum Option:
    Some(value)     # Has value;
    None              # No value;
end.

# ═══════════════════════════════════════════════════════
# State check
# ═══════════════════════════════════════════════════════

func is_some:
    in(opt:Option)
    case opt;
        case Some(_) out true
        case None out false
    end
end.

func is_none:
    in(opt:Option)
    out not is_some(opt);
end.

# ═══════════════════════════════════════════════════════
# Get value
# ═══════════════════════════════════════════════════════

func unwrap:
    in(opt:Option)
    # Get value from Some. Panic if None.
    case opt;
        case Some(v) out v
        case None panic("unwrap() called on None")
    end
end.

func unwrap_or:
    in(opt:Option; default)
    # Get value internally Some, or out default if None.
    case opt;
        case Some(v) out v
        case None out default
    end
end.

func unwrap_or_else:
    in(opt:Option; f:func)
    # Get value from Some, or call f() if None.
    case opt;
        case Some(v) out v
        case None out f()
    end
end.

func expect:
    in(opt:Option; msg:string)
    # Like unwrap but with custom error message.
    case opt;
        case Some(v) out v
        case None panic(msg)
    end
end.

# ═══════════════════════════════════════════════════════
# Transformations
# ═══════════════════════════════════════════════════════

func map:
    in(opt:Option; f:func)
    # Apply f to value if Some, keep None.
    # Some(x).map(f) -> Some(f(x))
    # None.map(f) -> None
    case opt;
        case Some(v) out Some(f(v))
        case None out None
    end
end.

func flat_map:
    in(opt:Option; f:func)
    # f must return Option. Flatten result.
    # Some(x).flat_map(f) -> f(x)
    # None.flat_map(f) -> None
    case opt;
        case Some(v) out f(v)
        case None out None
    end
end.

func filter:
    in(opt:Option; predicate:func)
    # Keep Some if predicate(value) returns true, otherwise None.
    case opt;
        case Some(v)
            if predicate(v):
                out Some(v);
            else
                out None;
            end
        case None out None
    end
end.

func or_else:
    in(opt:Option; alternative:Option)
    # Returns opt if Some, otherwise return alternative.
    case opt;
        case Some(_) out opt
        case None out alternative
    end
end.

func zip:
    in(a:Option; b:Option)
    # Combine two Options into Option<(a, b)>.
    # Both must be Some for result to be Some.
    if is_some(a) and is_some(b):
        out Some((unwrap(a), unwrap(b)));
    end
    out None;
end.

# ═══════════════════════════════════════════════════════
# Conversions
# ═══════════════════════════════════════════════════════

func option_to_result:
    in(opt:Option; err)
    # Some(v) -> Ok(v), None -> Err(err)
    case opt;
        case Some(v) out Ok(v)
        case None out Err(err)
    end
end.

# ═══ END: stdlib/vir/compiler/option.vri ═══

# [merged] import Option, Some, None from option;

# ═══════════════════════════════════════════════════════
# Result type — tagged union
# ═══════════════════════════════════════════════════════

enum Result:
    Ok(value)       # Success;
    Err(error)          # Failure;
end.

# ═══════════════════════════════════════════════════════
# State check
# ═══════════════════════════════════════════════════════

func is_ok:
    in(r:Result)
    case r;
        case Ok(_) out true
        case Err(_) out false
    end
end.

func is_err:
    in(r:Result)
    out not is_ok(r);
end.

# ═══════════════════════════════════════════════════════
# Get value
# ═══════════════════════════════════════════════════════

func unwrap:
    in(r:Result)
    # Get Ok value. Panic if Err.
    case r;
        case Ok(v) out v
        case Err(e) panic("unwrap() called on Err: " + to_string(e))
    end
end.

func unwrap_err:
    in(r:Result)
    # Get Err value. Panic if Ok.
    case r;
        case Ok(_) panic("unwrap_err() called on Ok")
        case Err(e) out e
    end
end.

func unwrap_or:
    in(r:Result; default)
    case r;
        case Ok(v) out v
        case Err(_) out default
    end
end.

func unwrap_or_else:
    in(r:Result; f:func)
    case r;
        case Ok(v) out v
        case Err(e) out f(e)
    end
end.

func expect:
    in(r:Result; msg:string)
    case r;
        case Ok(v) out v
        case Err(_) panic(msg)
    end
end.

# ═══════════════════════════════════════════════════════
# Transformations
# ═══════════════════════════════════════════════════════

func map:
    in(r:Result; f:func)
    # Ok(x).map(f) -> Ok(f(x))
    # Err(e).map(f) -> Err(e)
    case r;
        case Ok(v) out Ok(f(v))
        case Err(e) out Err(e)
    end
end.

func map_err:
    in(r:Result; f:func)
    # Ok(x).map_err(f) -> Ok(x)
    # Err(e).map_err(f) -> Err(f(e))
    case r;
        case Ok(v) out Ok(v)
        case Err(e) out Err(f(e))
    end
end.

func flat_map:
    in(r:Result; f:func)
    # Ok(x).flat_map(f) -> f(x)   (f must return Result)
    # Err(e).flat_map(f) -> Err(e)
    case r;
        case Ok(v) out f(v)
        case Err(e) out Err(e)
    end
end.

func and_then:
    in(r:Result; f:func)
    # Alias cho flat_map — string Result
    out flat_map(r, f);
end.

func or_else:
    in(r:Result; f:func)
    # Ok(x).or_else(f) -> Ok(x)
    # Err(e).or_else(f) -> f(e)
    case r;
        case Ok(v) out Ok(v)
        case Err(e) out f(e)
    end
end.

# ═══════════════════════════════════════════════════════
# Conversions
# ═══════════════════════════════════════════════════════

func result_to_option:
    in(r:Result)
    # Ok(v) -> Some(v), Err(_) -> None
    case r;
        case Ok(v) out Some(v)
        case Err(_) out None
    end
end.

func ok:
    in(r:Result)
    # Alias cho result_to_option
    out result_to_option(r);
end.

func err:
    in(r:Result)
    # Ok(_) -> None, Err(e) -> Some(e)
    case r;
        case Ok(_) out None
        case Err(e) out Some(e)
    end
end.

# ═══════════════════════════════════════════════════════
# Result utilities (Result chaining)
# ═══════════════════════════════════════════════════════

func try_all:
    in(results:Vec<Result>)
    # If all Ok -> Ok(Vec values)
    # If any Err -> return first Err
    values = vec_new();
    for each r in results;
        case r;
            case Ok(v) vec_push(values, v)
            case Err(e) out Err(e)
        end
    end
    out Ok(values);
end.

# ═══ END: stdlib/vir/compiler/result.vri ═══

# [merged] import Result, Ok, Err from result;
# [merged] include string;
# [merged] import String, str_new, str_concat, str_len, str_byte_at, str_eq from string;
# [merged] include vec;
# ═══ BEGIN: stdlib/vir/collections/vec.vri ═══
##
 * vir/collections/vec.vri — Dynamic Array (Vector)
 * ===================================================
 * Inspired by C: dynamic array pattern (malloc/realloc)
 * Inspired by Python: list, Rust Vec<T>
 *
 * ĐÂY LÀ MODULE QUAN TRỌNG NHẤT cho self-hosting:
 *   - Compiler cần Vec<Token> cho lexer output
 *   - Compiler cần Vec<Instruction> cho codegen
 *   - Compiler cần Vec<Symbol> cho symbol table
 *   - Compiler cần Vec<u8> cho binary output
 ##

# [merged] include types;
# [merged] include option;
# [merged] import Option, Some, None from option;
# [merged] include result;
# [merged] import Result, Ok, Err from result;
# [merged] include alloc;
# [merged] import alloc, realloc, free from alloc;
# [merged] include copy;
# [merged] import mem_copy, mem_move, mem_set from copy;

# ═══════════════════════════════════════════════════════
# Vec<T> — Growable Array
# ═══════════════════════════════════════════════════════
#
# Bố cục memory:
#   [data: ptr] [len: usize] [cap: usize]
#   data trỏ tới khối memory liên tục chứa T*cap element
#   len = số element đang use, cap = số slot allocate
#
# Growth strategy: nhân đôi khi full (giống std::vector C++)
#
# Invariant: 0 <= len <= cap; cap > 0 khi data != null

entity Vec<T>:
    data: ptr       # pointer tới array T;
    len:  int     # số element hiện tại;
    cap:  int     # capacity allocate;
end

# ─── Constructor ──────────────────────────────────────

func vec_new<T>:
    # Tạo vector empty, chưa allocate memory.
    out Vec<T> { data = null, len = 0, cap = 0 };
end

func vec_with_cap<T>:
    in(cap:int)
    # Tạo vector với capacity cho trước.
    size = cap * size_of<T>();
    data = alloc(size);
    out Vec<T> { data = data, len = 0, cap = cap };
end

func vec_from_slice<T>:
    in(src:ptr; count:int)
    # Tạo vector từ array có sẵn.
    v = vec_with_cap<T>(count);
    mem_copy(v.data, src, count * size_of<T>());
    v.len = count;
    out v;
end

func vec_filled<T>:
    in(val:T; count:int)
    # Tạo vector với count element giống nhau.
    v = vec_with_cap<T>(count);
    i = 0;
    when i < count loop
        native_store<T>(v.data, i, val);
        i = i + 1;
    end
    v.len = count;
    out v;
end

# ─── Capacity Management ─────────────────────────────

func vec_len<T>:
    in(v:Vec<T>)
    out v.len;
end

func vec_cap<T>:
    in(v:Vec<T>)
    out v.cap;
end

func vec_is_empty<T>:
    in(v:Vec<T>)
    out v.len == 0;
end

func vec_reserve<T>:
    in(v:Vec<T>; additional:int)
    # Đảm bảo có đủ chỗ cho thêm additional element.
    new_cap = v.len + additional;
    if new_cap <= v.cap out end:
    
    # Tăng gấp đôi if cần, nhưng ít nhất new_cap
    target = v.cap * 2;
    if target < new_cap target = new_cap end:
    if target < 8 target = 8 end   # minimum 8 slots:
    
    new_size = target * size_of<T>();
    if v.data == null:
        v.data = alloc(new_size);
    else
        v.data = realloc(v.data, new_size);
    end
    v.cap = target;
end

func vec_shrink_to_fit<T>:
    in(v:Vec<T>)
    # Thu gọn memory vừa đủ data.
    if v.len == v.cap out end:
    if v.len == 0:
        free(v.data);
        v.data = null;
        v.cap = 0;
        out;
    end
    v.data = realloc(v.data, v.len * size_of<T>());
    v.cap = v.len;
end

# ─── Access ───────────────────────────────────────────

func vec_get<T>:
    in(v:Vec<T>; idx:int)
    # Returns element tại vị trí idx. Panic if ngoài phạm vi.
    if idx >= v.len:
        panic(str_new("vec_get: index out of bounds"));
    end
    out native_load<T>(v.data, idx);
end

func vec_try_get<T>:
    in(v:Vec<T>; idx:int)
    # An toàn — out None if ngoài phạm vi.
    if idx >= v.len out None end:
    out Some(native_load<T>(v.data, idx));
end

func vec_set<T>:
    in(v:Vec<T>; idx:int; val:T)
    if idx >= v.len:
        panic(str_new("vec_set: index out of bounds"));
    end
    native_store<T>(v.data, idx, val);
end

func vec_set_at<T>:
    in(v:Vec<T>; idx:int; val:T)
    vec_set<T>(v, idx, val);
    out v;
end

func vec_first<T>:
    in(v:Vec<T>)
    if v.len == 0 out None end:
    out Some(native_load<T>(v.data, 0));
end

func vec_last<T>:
    in(v:Vec<T>)
    if v.len == 0 out None end:
    out Some(native_load<T>(v.data, v.len - 1));
end

# ─── Mutation ─────────────────────────────────────────

func vec_push<T>:
    in(v:Vec<T>; val:T)
    # Thêm element vào cuối. Tự mở rộng if cần.
    vec_reserve<T>(v, 1);
    native_store<T>(v.data, v.len, val);
    v.len = v.len + 1;
end

func vec_pop<T>:
    in(v:Vec<T>)
    # Lấy and xoá element cuối.
    if v.len == 0 out None end:
    v.len = v.len - 1;
    out Some(native_load<T>(v.data, v.len));
end

func vec_insert<T>:
    in(v:Vec<T>; idx:int; val:T)
    # Chèn element tại vị trí idx, đẩy element sau về phía phải.
    if idx > v.len:
        panic(str_new("vec_insert: index out of bounds"));
    end
    vec_reserve<T>(v, 1);
    # Dịch chuyển [idx..len) sang phải 1 slot
    if idx < v.len:
        src = v.data + idx * size_of<T>();
        dst = src + size_of<T>();
        mem_move(dst, src, (v.len - idx) * size_of<T>());
    end
    native_store<T>(v.data, idx, val);
    v.len = v.len + 1;
end

func vec_remove<T>:
    in(v:Vec<T>; idx:int)
    # Xoá element tại idx, kéo element sau sang trái.
    if idx >= v.len:
        panic(str_new("vec_remove: index out of bounds"));
    end
    val = native_load<T>(v.data, idx);
    remaining = v.len - idx - 1;
    if remaining > 0:
        dst = v.data + idx * size_of<T>();
        src = dst + size_of<T>();
        mem_move(dst, src, remaining * size_of<T>());
    end
    v.len = v.len - 1;
    out val;
end

func vec_swap_remove<T>:
    in(v:Vec<T>; idx:int)
    # Xoá nhanh O(1) — swap với element cuối rồi pop.
    if idx >= v.len:
        panic(str_new("vec_swap_remove: index out of bounds"));
    end
    val = native_load<T>(v.data, idx);
    v.len = v.len - 1;
    if idx < v.len:
        last = native_load<T>(v.data, v.len);
        native_store<T>(v.data, idx, last);
    end
    out val;
end

func vec_clear<T>:
    in(v:Vec<T>)
    v.len = 0;
end

func vec_truncate<T>:
    in(v:Vec<T>; new_len:int)
    if new_len < v.len:
        v.len = new_len;
    end
end

# ─── Extend & Append ─────────────────────────────────

func vec_extend<T>:
    in(v:Vec<T>; other:Vec<T>)
    # Nối toàn bộ element từ other vào cuối v.
    if other.len == 0 out end:
    vec_reserve<T>(v, other.len);
    mem_copy(;
        v.data + v.len * size_of<T>(),;
        other.data,;
        other.len * size_of<T>();
    );
    v.len = v.len + other.len;
end

func vec_extend_from_slice<T>:
    in(v:Vec<T>; src:ptr; count:int)
    if count == 0 out end:
    vec_reserve<T>(v, count);
    mem_copy(;
        v.data + v.len * size_of<T>(),;
        src,;
        count * size_of<T>();
    );
    v.len = v.len + count;
end

# ─── Search ───────────────────────────────────────────

func vec_contains<T>:
    in(v:Vec<T>; val:T)
    i = 0;
    when i < v.len loop
        if native_load<T>(v.data, i) == val:
            out true;
        end
        i = i + 1;
    end
    out false;
end

func vec_find<T>:
    in(v:Vec<T>; val:T)
    # Tìm index đầu tiên == val.
    i = 0;
    when i < v.len loop
        if native_load<T>(v.data, i) == val:
            out Some(i);
        end
        i = i + 1;
    end
    out None;
end

func vec_count<T>:
    in(v:Vec<T>; val:T)
    count = 0;
    i = 0;
    when i < v.len loop
        if native_load<T>(v.data, i) == val:
            count = count + 1;
        end
        i = i + 1;
    end
    out count;
end

# ─── Transform ────────────────────────────────────────

func vec_reverse<T>:
    in(v:Vec<T>)
    if v.len <= 1 out end:
    lo = 0;
    hi = v.len - 1;
    when lo < hi loop
        tmp = native_load<T>(v.data, lo);
        native_store<T>(v.data, lo, native_load<T>(v.data, hi));
        native_store<T>(v.data, hi, tmp);
        lo = lo + 1;
        hi = hi - 1;
    end
end

func vec_clone<T>:
    in(v:Vec<T>)
    # Deep copy.
    if v.len == 0 out vec_new<T>() end:
    nv = vec_with_cap<T>(v.len);
    mem_copy(nv.data, v.data, v.len * size_of<T>());
    nv.len = v.len;
    out nv;
end

func vec_slice<T>:
    in(v:Vec<T>; start:int; end:int)
    # Returns bản sao của [start..end).
    if start > end or end > v.len:
        panic(str_new("vec_slice: range out of bounds"));
    end
    count = end - start;
    nv = vec_with_cap<T>(count);
    mem_copy(nv.data, v.data + start * size_of<T>(), count * size_of<T>());
    nv.len = count;
    out nv;
end

# ─── Equality ─────────────────────────────────────────

func vec_eq<T>:
    in(a:Vec<T>; b:Vec<T>)
    if a.len != b.len out false end:
    i = 0;
    when i < a.len loop
        if native_load<T>(a.data, i) != native_load<T>(b.data, i):
            out false;
        end
        i = i + 1;
    end
    out true;
end

# ─── Memory ───────────────────────────────────────────

func vec_free<T>:
    in(v:Vec<T>)
    if v.data != null:
        free(v.data);
        v.data = null;
    end
    v.len = 0;
    v.cap = 0;
end

func vec_as_ptr<T>:
    in(v:Vec<T>)
    out v.data;
end

func vec_as_slice<T>:
    in(v:Vec<T>)
    out Slice { data = v.data, len = v.len * size_of<T>() };
end

# ─── Iteration Helpers ────────────────────────────────

func vec_for_each<T>(v: Vec<T>, f: func(T))
    i = 0;
    when i < v.len loop
        f(native_load<T>(v.data, i));
        i = i + 1;
    end
end

func vec_map<T, U>(v: Vec<T>, f: func(T) -> U) -> Vec<U>
    out = vec_with_cap<U>(v.len);
    i = 0;
    when i < v.len loop
        vec_push<U>(&out, f(native_load<T>(v.data, i)));
        i = i + 1;
    end
    out out;
end

func vec_filter<T>:
    in(v:Vec<T>; pred:func(T))
    out = vec_new<T>();
    i = 0;
    when i < v.len loop
        elem = native_load<T>(v.data, i);
        if pred(elem):
            vec_push<T>(&out, elem);
        end
        i = i + 1;
    end
    out out;
end

func vec_any<T>:
    in(v:Vec<T>; pred:func(T))
    i = 0;
    when i < v.len loop
        if pred(native_load<T>(v.data, i)) out true end:
        i = i + 1;
    end
    out false;
end

func vec_all<T>:
    in(v:Vec<T>; pred:func(T))
    i = 0;
    when i < v.len loop
        if !pred(native_load<T>(v.data, i)) out false end:
        i = i + 1;
    end
    out true;
end

func vec_fold<T, U>(v: Vec<T>, init: U, f: func(U, T) -> U) -> U
    acc = init;
    i = 0;
    when i < v.len loop
        acc = f(acc, native_load<T>(v.data, i));
        i = i + 1;
    end
    out acc;
end

entity Pair<A, B>:
    first: A;
    second: B;
end

func vec_zip<A, B>(a: Vec<A>, b: Vec<B>) -> Vec<Pair<A, B>>
    n = if a.len < b.len: a.len; else: b.len; end;
    result = vec_with_cap<Pair<A, B>>(n);
    i = 0;
    when i < n loop
        vec_push<Pair<A, B>>(&result, Pair<A, B> { first: native_load<A>(a.data, i), second: native_load<B>(b.data, i) });
        i = i + 1;
    end
    out result;
end

func vec_enumerate<T>(v: Vec<T>) -> Vec<Pair<int, T>>
    result = vec_with_cap<Pair<int, T>>(v.len);
    i = 0;
    when i < v.len loop
        vec_push<Pair<int, T>>(&result, Pair<int, T> { first: i, second: native_load<T>(v.data, i) });
        i = i + 1;
    end
    out result;
end

func vec_flatten<T>(nested: Vec<Vec<T>>) -> Vec<T>
    result = vec_new<T>();
    i = 0;
    when i < nested.len loop
        inner = native_load<Vec<T>>(nested.data, i);
        j = 0;
        when j < inner.len loop
            vec_push<T>(&result, native_load<T>(inner.data, j));
            j = j + 1;
        end
        i = i + 1;
    end
    out result;
end

func vec_dedup<T>(v: Vec<T>, eq: func(T, T) -> bool) -> Vec<T>
    result = vec_new<T>();
    if v.len == 0 out result end:
    vec_push<T>(&result, native_load<T>(v.data, 0));
    i = 1;
    when i < v.len loop
        cur = native_load<T>(v.data, i);
        prev = native_load<T>(v.data, i - 1);
        if !eq(cur, prev):
            vec_push<T>(&result, cur);
        end
        i = i + 1;
    end
    out result;
end

# ═══ END: stdlib/vir/collections/vec.vri ═══

# [merged] import Vec, vec_new, vec_push, vec_len, vec_get from vec;

# ═══════════════════════════════════════════════════════
# Token Types (v1.2 Standard)
# ═══════════════════════════════════════════════════════

enum TokType:
    # Literals
    Eof         = 0;
    Error       = 1;
    Int         = 2;
    Float       = 3;
    Str         = 4;
    Ident       = 5;
    Newline     = 6;

    # Definitions
    Func        = 10;
    Var         = 11;
    Const       = 12;
    Entity      = 13;
    Enum        = 14;
    Method      = 15;
    Class       = 16;
    Has         = 17;
    Share       = 18;
    Async       = 19;
    Task        = 20;
    Wait        = 21;
    Extern      = 22;

    # Control flow
    If          = 30;
    Else        = 31;
    Eif         = 32;
    Loop        = 33;
    While       = 34;
    When        = 35;
    For         = 36;
    Break       = 37;
    Skip        = 38;
    Out         = 39;
    Case        = 40;
    End         = 41;
    In          = 42;

    # Arithmetic operators
    Plus        = 50;
    Minus       = 51;
    Star        = 52;
    Slash       = 53;
    Percent     = 54;
    Power       = 55;
    Mod         = 56;

    # Comparison operators
    Eq          = 60;
    Ne          = 61;
    Gt          = 62;
    Lt          = 63;
    Ge          = 64;
    Le          = 65;
    SafeEq      = 66;
    SafeNe      = 67;

    # Logical operators
    And         = 70;
    Or          = 71;
    Not         = 72;

    # Bitwise operators
    BitXor      = 75;
    BitShl      = 76;
    BitShr      = 77;
    BitAnd      = 78;
    BitOr       = 79;
    BitNot      = 80;

    # Access / transform
    SafeAccess  = 85;
    Exist       = 86;
    Cast        = 87;
    Pattern     = 88;

    # Assignment
    Assign      = 90;

    # Delimiters
    LParen      = 100;
    RParen      = 101;
    LBracket    = 102;
    RBracket    = 103;
    LBrace      = 104;
    RBrace      = 105;
    Comma       = 106;
    Dot         = 107;
    DotDot      = 108;
    Colon       = 109;
    Semicolon   = 110;
    Arrow       = 111;
    DoubleColon = 112;
    StarStar    = 113;
    FusedMA     = 114;

    # I/O
    Print       = 120;
    Input       = 121;
    CheckCpu    = 122;
    Patch       = 123;

    # Module
    Import      = 130;
    From        = 131;
    Module      = 132;
    Export      = 133;
    As          = 134;
    Include     = 135;
    Get         = 136;

    # Boolean / None
    True        = 140;
    False       = 141;
    NoneLit     = 142;

    # Error handling
    Try         = 150;
    ErrorKw     = 151;
    MapKw       = 152;
end


# ═══════════════════════════════════════════════════════
# Token
# ═══════════════════════════════════════════════════════

entity Token:
    tok_type:   TokType;
    line:       int;
    col:        int;
    str_val:    string;
    int_val:    int;
    float_val:  float;
end

func token_new:
    in(t:TokType; line:int; col:int)
    out Token {;
        tok_type: t,;
        line: line,;
        col: col,;
        str_val: str_new(""),;
        int_val: 0,;
        float_val: 0.0;
    };
end


# ═══════════════════════════════════════════════════════
# Keyword Lookup Table
# ═══════════════════════════════════════════════════════

entity KeywordEntry:
    word:   string;
    tok:    TokType;
end

func build_keyword_table:
    table = vec_new<KeywordEntry>();

    # Definition keywords
    vec_push(table, KeywordEntry { word: str_new("func"), tok: TokType::Func });
    vec_push(table, KeywordEntry { word: str_new("function"), tok: TokType::Func });
    vec_push(table, KeywordEntry { word: str_new("var"), tok: TokType::Var });
    vec_push(table, KeywordEntry { word: str_new("let"), tok: TokType::Var });
    vec_push(table, KeywordEntry { word: str_new("const"), tok: TokType::Const });
    vec_push(table, KeywordEntry { word: str_new("entity"), tok: TokType::Entity });
    vec_push(table, KeywordEntry { word: str_new("enum"), tok: TokType::Enum });
    vec_push(table, KeywordEntry { word: str_new("method"), tok: TokType::Method });
    vec_push(table, KeywordEntry { word: str_new("class"), tok: TokType::Class });
    vec_push(table, KeywordEntry { word: str_new("has"), tok: TokType::Has });
    vec_push(table, KeywordEntry { word: str_new("share"), tok: TokType::Share });
    vec_push(table, KeywordEntry { word: str_new("async"), tok: TokType::Async });
    vec_push(table, KeywordEntry { word: str_new("task"), tok: TokType::Task });
    vec_push(table, KeywordEntry { word: str_new("wait"), tok: TokType::Wait });
    vec_push(table, KeywordEntry { word: str_new("extern"), tok: TokType::Extern });

    # Control flow keywords
    vec_push(table, KeywordEntry { word: str_new("if"), tok: TokType::If });
    vec_push(table, KeywordEntry { word: str_new("else"), tok: TokType::Else });
    vec_push(table, KeywordEntry { word: str_new("eif"), tok: TokType::Eif });
    vec_push(table, KeywordEntry { word: str_new("loop"), tok: TokType::Loop });
    vec_push(table, KeywordEntry { word: str_new("while"), tok: TokType::While });
    vec_push(table, KeywordEntry { word: str_new("when"), tok: TokType::When });
    vec_push(table, KeywordEntry { word: str_new("for"), tok: TokType::For });
    vec_push(table, KeywordEntry { word: str_new("break"), tok: TokType::Break });
    vec_push(table, KeywordEntry { word: str_new("skip"), tok: TokType::Skip });
    vec_push(table, KeywordEntry { word: str_new("continue"), tok: TokType::Skip });
    vec_push(table, KeywordEntry { word: str_new("out"), tok: TokType::Out });
    vec_push(table, KeywordEntry { word: str_new("return"), tok: TokType::Out });
    vec_push(table, KeywordEntry { word: str_new("case"), tok: TokType::Case });
    vec_push(table, KeywordEntry { word: str_new("end"), tok: TokType::End });
    vec_push(table, KeywordEntry { word: str_new("in"), tok: TokType::In });

    # I/O keywords
    vec_push(table, KeywordEntry { word: str_new("print"), tok: TokType::Print });
    vec_push(table, KeywordEntry { word: str_new("input"), tok: TokType::Input });
    vec_push(table, KeywordEntry { word: str_new("check_cpu"), tok: TokType::CheckCpu });
    vec_push(table, KeywordEntry { word: str_new("patch"), tok: TokType::Patch });

    # Boolean / None
    vec_push(table, KeywordEntry { word: str_new("true"), tok: TokType::True });
    vec_push(table, KeywordEntry { word: str_new("false"), tok: TokType::False });
    vec_push(table, KeywordEntry { word: str_new("none"), tok: TokType::NoneLit });

    # Logical
    vec_push(table, KeywordEntry { word: str_new("and"), tok: TokType::And });
    vec_push(table, KeywordEntry { word: str_new("or"), tok: TokType::Or });
    vec_push(table, KeywordEntry { word: str_new("not"), tok: TokType::Not });

    # Bitwise keywords
    vec_push(table, KeywordEntry { word: str_new("xor"), tok: TokType::BitXor });
    vec_push(table, KeywordEntry { word: str_new("shl"), tok: TokType::BitShl });
    vec_push(table, KeywordEntry { word: str_new("shr"), tok: TokType::BitShr });
    vec_push(table, KeywordEntry { word: str_new("mod"), tok: TokType::Mod });

    # Module keywords
    vec_push(table, KeywordEntry { word: str_new("import"), tok: TokType::Import });
    vec_push(table, KeywordEntry { word: str_new("from"), tok: TokType::From });
    vec_push(table, KeywordEntry { word: str_new("module"), tok: TokType::Module });
    vec_push(table, KeywordEntry { word: str_new("export"), tok: TokType::Export });
    vec_push(table, KeywordEntry { word: str_new("as"), tok: TokType::As });
    vec_push(table, KeywordEntry { word: str_new("include"), tok: TokType::Include });
    vec_push(table, KeywordEntry { word: str_new("get"), tok: TokType::Get });

    # Error handling
    vec_push(table, KeywordEntry { word: str_new("try"), tok: TokType::Try });
    vec_push(table, KeywordEntry { word: str_new("error"), tok: TokType::ErrorKw });
    vec_push(table, KeywordEntry { word: str_new("map"), tok: TokType::MapKw });

    # Legacy compatibility
    vec_push(table, KeywordEntry { word: str_new("struct"), tok: TokType::Entity });
    vec_push(table, KeywordEntry { word: str_new("record"), tok: TokType::Entity });
    vec_push(table, KeywordEntry { word: str_new("elif"), tok: TokType::Eif });
    vec_push(table, KeywordEntry { word: str_new("then"), tok: TokType::End });

    out table;
end

func lookup_keyword:
    in(table:Vec<KeywordEntry>; word:string)
    i = 0;
    when i < vec_len(table) loop
        entry = vec_get(table, i);
        if str_eq(entry.word, word):
            out entry.tok;
        end
        i = i + 1;
    end
    out TokType::Eof  # not found;
end


# ═══════════════════════════════════════════════════════
# Lexer State
# ═══════════════════════════════════════════════════════

entity Lexer:
    source:         string;
    source_len:     int;
    pos:            int;
    line:           int;
    col:            int;
    tokens:         Vec<Token>;
    paren_depth:    int;
    keywords:       Vec<KeywordEntry>;
    error:          string;
end

func lexer_new:
    in(source:string)
    out Lexer {;
        source: source,;
        source_len: str_len(source),;
        pos: 0,;
        line: 1,;
        col: 1,;
        tokens: vec_new(),;
        paren_depth: 0,;
        keywords: build_keyword_table(),;
        error: str_new("");
    };
end


# ═══════════════════════════════════════════════════════
# Character Helpers
# ═══════════════════════════════════════════════════════

func is_eof:
    in(lex:Lexer)
    out lex.pos >= lex.source_len;
end

func lex_peek:
    in(lex:Lexer)
    if lex.pos < lex.source_len:
        out str_byte_at(lex.source, lex.pos);
    end
    out 0;
end

func lex_peek_at:
    in(lex:Lexer; offset:int)
    p = lex.pos + offset;
    if p < lex.source_len:
        out str_byte_at(lex.source, p);
    end
    out 0;
end

func lex_advance:
    in(lex:Lexer)
    c = lex_peek(lex);
    if c == 10  # '\n':
        lex.line = lex.line + 1;
        lex.col = 1;
    else
        lex.col = lex.col + 1;
    end
    lex.pos = lex.pos + 1;
    out (lex, c);
end

func is_alpha:
    in(c:int)
    out (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or c == 95;
end

func is_digit:
    in(c:int)
    out c >= 48 and c <= 57;
end

func is_hex_digit:
    in(c:int)
    out is_digit(c) or (c >= 65 and c <= 70) or (c >= 97 and c <= 102);
end

func is_word_char:
    in(c:int)
    out is_alpha(c) or is_digit(c) or c >= 128;
end


# ═══════════════════════════════════════════════════════
# Skip Whitespace & Comments
# ═══════════════════════════════════════════════════════

func skip_whitespace:
    in(lex:Lexer)
    when not is_eof(lex) loop
        c = lex_peek(lex);
        if c == 32 or c == 9 or c == 13   # space, tab, CR:
            var (lex2, _) = lex_advance(lex);
            lex = lex2;
        else
            out lex;
        end
    end
    out lex;
end

func skip_comment:
    in(lex:Lexer)
    # Single-line comment: # ... until \n
    when not is_eof(lex) and lex_peek(lex) != 10 loop
        var (lex2, _) = lex_advance(lex);
        lex = lex2;
    end
    out lex;
end

func skip_block_comment:
    in(lex:Lexer)
    # Block comment: ## ... ##
    var (lex2, _) = lex_advance(lex)  # skip first #;
    var (lex3, _) = lex_advance(lex2)  # skip second #;
    lex = lex3;
    when not is_eof(lex) loop
        if lex_peek(lex) == 35 and lex_peek_at(lex, 1) == 35:
            var (lex4, _) = lex_advance(lex);
            var (lex5, _) = lex_advance(lex4);
            out lex5;
        end
        var (lex6, _) = lex_advance(lex);
        lex = lex6;
    end
    out lex;
end


# ═══════════════════════════════════════════════════════
# Number Lexing
# ═══════════════════════════════════════════════════════

func lex_number:
    in(lex:Lexer)
    tok = token_new(TokType::Int, lex.line, lex.col);
    num = 0;
    is_float = false;

    # Hex literal
    if lex_peek(lex) == 48 and (lex_peek_at(lex, 1) == 120 or lex_peek_at(lex, 1) == 88):
        var (lex2, _) = lex_advance(lex)    # 0;
        var (lex3, _) = lex_advance(lex2)   # x;
        lex = lex3;
        when not is_eof(lex) and is_hex_digit(lex_peek(lex)) loop
            c = lex_peek(lex);
            digit = 0;
            if c >= 48 and c <= 57:
                digit = (c - 48) >> int;
            end
            if c >= 65 and c <= 70:
                digit = (c - 55) >> int;
            end
            if c >= 97 and c <= 102:
                digit = (c - 87) >> int;
            end
            num = num * 16 + digit;
            var (lex4, _) = lex_advance(lex);
            lex = lex4;
        end
        tok.int_val = num;
        out (lex, tok);
    end

    # Decimal literal (integer or float)
    when not is_eof(lex) and (is_digit(lex_peek(lex)) or lex_peek(lex) == 46) loop
        c = lex_peek(lex);
        if c == 46  # '.':
            if is_float:
                # Second dot — stop
                out (lex, tok);
            end
            # Check for .. range operator
            if lex_peek_at(lex, 1) == 46:
                out (lex, tok);
            end
            is_float = true;
        end
        var (lex2, _) = lex_advance(lex);
        lex = lex2;
    end

    # Parse value from the accumulated string range
    # (In a real implementation, accumulate digits into a buffer)
    if is_float:
        tok.tok_type = TokType::Float;
    end

    out (lex, tok);
end


# ═══════════════════════════════════════════════════════
# String Lexing
# ═══════════════════════════════════════════════════════

func lex_string:
    in(lex:Lexer)
    tok = token_new(TokType::Str, lex.line, lex.col);
    var (lex2, quote) = lex_advance(lex)  # consume opening quote;
    lex = lex2;
    buf = str_new("");

    when not is_eof(lex) and lex_peek(lex) != quote loop
        if lex_peek(lex) == 92  # backslash:
            var (lex3, _) = lex_advance(lex);
            lex = lex3;
            if is_eof(lex):
                out (lex, tok);
            end
            var (lex4, esc) = lex_advance(lex);
            lex = lex4;
            if esc == 110      # \n:
                buf = str_concat(buf, str_new("\n"));
            end
            if esc == 116      # \t:
                buf = str_concat(buf, str_new("\t"));
            end
            if esc == 92       # \\:
                buf = str_concat(buf, str_new("\\"));
            end
            if esc == 34       # \":
                buf = str_concat(buf, str_new("\""));
            end
            if esc == 39       # \':
                buf = str_concat(buf, str_new("'"));
            end
        else
            var (lex5, ch) = lex_advance(lex);
            lex = lex5;
            buf = str_concat(buf, char_to_str(ch));
        end
    end

    # Consume closing quote
    if not is_eof(lex):
        var (lex6, _) = lex_advance(lex);
        lex = lex6;
    end

    tok.str_val = buf;
    out (lex, tok);
end


# ═══════════════════════════════════════════════════════
# Word / Keyword Lexing
# ═══════════════════════════════════════════════════════

func lex_word:
    in(lex:Lexer)
    start_line = lex.line;
    start_col = lex.col;
    buf = str_new("");

    when not is_eof(lex) and is_word_char(lex_peek(lex)) loop
        var (lex2, ch) = lex_advance(lex);
        lex = lex2;
        buf = str_concat(buf, char_to_str(ch));
    end

    # Lookup keyword
    kw_type = lookup_keyword(lex.keywords, buf);
    if kw_type != TokType::Eof:
        tok = token_new(kw_type, start_line, start_col);
        out (lex, tok);
    end

    # Identifier
    tok = token_new(TokType::Ident, start_line, start_col);
    tok.str_val = buf;
    out (lex, tok);
end


# ═══════════════════════════════════════════════════════
# Main Tokenize Loop
# ═══════════════════════════════════════════════════════

func tokenize:
    in(lex:Lexer)
    prev_was_newline = true;

    when not is_eof(lex) loop
        lex = skip_whitespace(lex);
        if is_eof(lex):
            out lex;
        end

        c = lex_peek(lex);

        # Newline (statement separator)
        if c == 10:
            var (lex2, _) = lex_advance(lex);
            lex = lex2;
            if not prev_was_newline and lex.paren_depth == 0:
                vec_push(lex.tokens, token_new(TokType::Newline, lex.line, lex.col));
                prev_was_newline = true;
            end
            skip  # continue;
        end

        prev_was_newline = false;

        # Comment
        if c == 35  # '#':
            if lex_peek_at(lex, 1) == 35:
                lex = skip_block_comment(lex);
            else
                lex = skip_comment(lex);
            end
            skip;
        end

        # String literal
        if c == 34 or c == 39  # " or ':
            var (lex2, tok) = lex_string(lex);
            lex = lex2;
            vec_push(lex.tokens, tok);
            skip;
        end

        # Number literal
        if is_digit(c):
            var (lex2, tok) = lex_number(lex);
            lex = lex2;
            vec_push(lex.tokens, tok);
            skip;
        end

        # Multi-char operators
        c2 = lex_peek_at(lex, 1);

        if c == 61 and c2 == 61  # ==:
            tok = token_new(TokType::Eq, lex.line, lex.col);
            var (l1, _) = lex_advance(lex);
            var (l2, _) = lex_advance(l1);
            lex = l2;
            vec_push(lex.tokens, tok);
            skip;
        end

        if c == 33 and c2 == 61  # !=:
            tok = token_new(TokType::Ne, lex.line, lex.col);
            var (l1, _) = lex_advance(lex);
            var (l2, _) = lex_advance(l1);
            lex = l2;
            vec_push(lex.tokens, tok);
            skip;
        end

        if c == 62 and c2 == 61  # >=:
            tok = token_new(TokType::Ge, lex.line, lex.col);
            var (l1, _) = lex_advance(lex);
            var (l2, _) = lex_advance(l1);
            lex = l2;
            vec_push(lex.tokens, tok);
            skip;
        end

        if c == 60 and c2 == 61  # <=:
            tok = token_new(TokType::Le, lex.line, lex.col);
            var (l1, _) = lex_advance(lex);
            var (l2, _) = lex_advance(l1);
            lex = l2;
            vec_push(lex.tokens, tok);
            skip;
        end

        # ?=/= (safe not-equal — 4 chars)
        if c == 63 and c2 == 61 and lex_peek_at(lex, 2) == 47 and lex_peek_at(lex, 3) == 61:
            tok = token_new(TokType::SafeNe, lex.line, lex.col);
            var (l1, _) = lex_advance(lex);
            var (l2, _) = lex_advance(l1);
            var (l3, _) = lex_advance(l2);
            var (l4, _) = lex_advance(l3);
            lex = l4;
            vec_push(lex.tokens, tok);
            skip;
        end

        # ?= (safe equal)
        if c == 63 and c2 == 61:
            tok = token_new(TokType::SafeEq, lex.line, lex.col);
            var (l1, _) = lex_advance(lex);
            var (l2, _) = lex_advance(l1);
            lex = l2;
            vec_push(lex.tokens, tok);
            skip;
        end

        # ?. (safe member access)
        if c == 63 and c2 == 46:
            tok = token_new(TokType::SafeAccess, lex.line, lex.col);
            var (l1, _) = lex_advance(lex);
            var (l2, _) = lex_advance(l1);
            lex = l2;
            vec_push(lex.tokens, tok);
            skip;
        end

        # :~ (pattern match)
        if c == 58 and c2 == 126:
            tok = token_new(TokType::Pattern, lex.line, lex.col);
            var (l1, _) = lex_advance(lex);
            var (l2, _) = lex_advance(l1);
            lex = l2;
            vec_push(lex.tokens, tok);
            skip;
        end

        # || (logical OR)
        if c == 124 and c2 == 124:
            tok = token_new(TokType::Or, lex.line, lex.col);
            var (l1, _) = lex_advance(lex);
            var (l2, _) = lex_advance(l1);
            lex = l2;
            vec_push(lex.tokens, tok);
            skip;
        end

        # -> (arrow)
        if c == 45 and c2 == 62:
            tok = token_new(TokType::Arrow, lex.line, lex.col);
            var (l1, _) = lex_advance(lex);
            var (l2, _) = lex_advance(l1);
            lex = l2;
            vec_push(lex.tokens, tok);
            skip;
        end

        # << (bit shift left)
        if c == 60 and c2 == 60:
            tok = token_new(TokType::BitShl, lex.line, lex.col);
            var (l1, _) = lex_advance(lex);
            var (l2, _) = lex_advance(l1);
            lex = l2;
            vec_push(lex.tokens, tok);
            skip;
        end

        # >> (cast in v1.2)
        if c == 62 and c2 == 62:
            tok = token_new(TokType::Cast, lex.line, lex.col);
            var (l1, _) = lex_advance(lex);
            var (l2, _) = lex_advance(l1);
            lex = l2;
            vec_push(lex.tokens, tok);
            skip;
        end

        # .. (range)
        if c == 46 and c2 == 46:
            tok = token_new(TokType::DotDot, lex.line, lex.col);
            var (l1, _) = lex_advance(lex);
            var (l2, _) = lex_advance(l1);
            lex = l2;
            vec_push(lex.tokens, tok);
            skip;
        end

        # ** (matmul / StarStar)
        if c == 42 and c2 == 42:
            tok = token_new(TokType::StarStar, lex.line, lex.col);
            var (l1, _) = lex_advance(lex);
            var (l2, _) = lex_advance(l1);
            lex = l2;
            vec_push(lex.tokens, tok);
            skip;
        end

        # >< (fused multiply-accumulate)
        if c == 62 and c2 == 60:
            tok = token_new(TokType::FusedMA, lex.line, lex.col);
            var (l1, _) = lex_advance(lex);
            var (l2, _) = lex_advance(l1);
            lex = l2;
            vec_push(lex.tokens, tok);
            skip;
        end

        # :: (double colon)
        if c == 58 and c2 == 58:
            tok = token_new(TokType::DoubleColon, lex.line, lex.col);
            var (l1, _) = lex_advance(lex);
            var (l2, _) = lex_advance(l1);
            lex = l2;
            vec_push(lex.tokens, tok);
            skip;
        end

        # Single-char operators
        single_tok = TokType::Eof;
        if c == 43:
            single_tok = TokType::Plus;
        end
        if c == 45 and single_tok == TokType::Eof:
            single_tok = TokType::Minus;
        end
        if c == 42:
            single_tok = TokType::Star;
        end
        if c == 47:
            single_tok = TokType::Slash;
        end
        if c == 37:
            single_tok = TokType::Percent;
        end
        if c == 94:
            single_tok = TokType::Power;
        end
        if c == 61 and single_tok == TokType::Eof:
            single_tok = TokType::Assign;
        end
        if c == 62 and single_tok == TokType::Eof:
            single_tok = TokType::Gt;
        end
        if c == 60 and single_tok == TokType::Eof:
            single_tok = TokType::Lt;
        end
        if c == 33 and single_tok == TokType::Eof:
            single_tok = TokType::Not;
        end
        if c == 63 and single_tok == TokType::Eof:
            single_tok = TokType::Exist;
        end
        if c == 38:
            single_tok = TokType::And;
        end
        if c == 124 and single_tok == TokType::Eof:
            single_tok = TokType::BitOr;
        end
        if c == 126:
            single_tok = TokType::BitNot;
        end

        # Delimiters
        if c == 40:
            single_tok = TokType::LParen;
            lex.paren_depth = lex.paren_depth + 1;
        end
        if c == 41:
            single_tok = TokType::RParen;
            if lex.paren_depth > 0:
                lex.paren_depth = lex.paren_depth - 1;
            end
        end
        if c == 91:
            single_tok = TokType::LBracket;
            lex.paren_depth = lex.paren_depth + 1;
        end
        if c == 93:
            single_tok = TokType::RBracket;
            if lex.paren_depth > 0:
                lex.paren_depth = lex.paren_depth - 1;
            end
        end
        if c == 123:
            single_tok = TokType::LBrace;
            lex.paren_depth = lex.paren_depth + 1;
        end
        if c == 125:
            single_tok = TokType::RBrace;
            if lex.paren_depth > 0:
                lex.paren_depth = lex.paren_depth - 1;
            end
        end
        if c == 44:
            single_tok = TokType::Comma;
        end
        if c == 46 and single_tok == TokType::Eof:
            single_tok = TokType::Dot;
        end
        if c == 58 and single_tok == TokType::Eof:
            single_tok = TokType::Colon;
        end
        if c == 59:
            single_tok = TokType::Semicolon;
        end

        if single_tok != TokType::Eof:
            tok = token_new(single_tok, lex.line, lex.col);
            var (lex2, _) = lex_advance(lex);
            lex = lex2;
            vec_push(lex.tokens, tok);
            skip;
        end

        # Word (keyword / identifier)
        if is_word_char(c):
            var (lex2, tok) = lex_word(lex);
            lex = lex2;
            vec_push(lex.tokens, tok);
            skip;
        end

        # Unknown character — skip
        var (lex2, _) = lex_advance(lex);
        lex = lex2;
    end

    # Push sentinel EOF token
    vec_push(lex.tokens, token_new(TokType::Eof, lex.line, lex.col));
    out lex;
end


# ═══════════════════════════════════════════════════════
# Token Name (for debug / error messages)
# ═══════════════════════════════════════════════════════

func token_name:
    in(t:TokType)
    if t == TokType::Eof:
        out str_new("EOF");
    end
    if t == TokType::Int:
        out str_new("INT");
    end
    if t == TokType::Float:
        out str_new("FLOAT");
    end
    if t == TokType::Str:
        out str_new("STRING");
    end
    if t == TokType::Ident:
        out str_new("IDENT");
    end
    if t == TokType::Newline:
        out str_new("NEWLINE");
    end
    if t == TokType::Func:
        out str_new("FUNC");
    end
    if t == TokType::Var:
        out str_new("VAR");
    end
    if t == TokType::Const:
        out str_new("CONST");
    end
    if t == TokType::Entity:
        out str_new("ENTITY");
    end
    if t == TokType::Enum:
        out str_new("ENUM");
    end
    if t == TokType::If:
        out str_new("IF");
    end
    if t == TokType::Else:
        out str_new("ELSE");
    end
    if t == TokType::End:
        out str_new("END");
    end
    if t == TokType::Out:
        out str_new("OUT");
    end
    if t == TokType::While:
        out str_new("WHILE");
    end
    if t == TokType::Break:
        out str_new("BREAK");
    end
    if t == TokType::Skip:
        out str_new("SKIP");
    end
    if t == TokType::Extern:
        out str_new("EXTERN");
    end
    if t == TokType::StarStar:
        out str_new("STARSTAR");
    end
    if t == TokType::FusedMA:
        out str_new("FUSEDMA");
    end
    if t == TokType::DoubleColon:
        out str_new("DOUBLECOLON");
    end
    out str_new("???");
end

# ═══ END: stdlib/vir/compiler/lexer.vri ═══

# [merged] import Lexer, TokType, Token, lexer_new, tokenize from lexer;
# [merged] include vir::compiler::parser;
# ═══ BEGIN: stdlib/vir/compiler/parser.vri ═══
##
 * vir/compiler/parser.vri — Recursive-Descent Parser (Pure Vir)
 * ==============================================================
 * Produces AST trees from a token stream.
 * Converted from C (core/src/parser.c) for self-hosting.
 *
 * Grammar (keyword-delimited blocks):
 *
 *   program     → (func_def | statement)* EOF
 *   func_def    → FUNC IDENT '(' params ')' block END
 *   params      → (IDENT (',' IDENT)*)?
 *   block       → statement*
 *   statement   → var_decl | const_decl | if_stmt | loop_stmt
 *               | while_stmt | return_stmt | print_stmt
 *               | for_range | enum_def | entity_def
 *               | assign_or_expr | NEWLINE
 *   expr        → or_expr
 *   or_expr     → and_expr (OR and_expr)*
 *   and_expr    → compare (AND compare)*
 *   compare     → bitwise ((EQ|NE|GT|LT|GE|LE) bitwise)?
 *   bitwise     → addition ((SHL|SHR|XOR|BIT_AND|BIT_OR) addition)*
 *   addition    → mult ((PLUS|MINUS) mult)*
 *   mult        → unary ((STAR|SLASH|PERCENT) unary)*
 *   unary       → (MINUS|NOT) unary | postfix
 *   postfix     → primary ('.' IDENT | '[' expr ']' | '(' args ')')*
 *   primary     → INT | FLOAT | STRING | TRUE | FALSE | NONE
 *               | IDENT | '(' expr ')' | '[' elems ']' | INPUT
 ##

# [merged] include types;
# [merged] include result;
# [merged] import Result, Ok, Err from result;
# [merged] include string;
# [merged] import String, str_new, str_concat, str_len, str_eq, str_copy from string;
# [merged] include vec;
# [merged] import Vec, vec_new, vec_push, vec_len, vec_get from vec;
# [merged] include lexer;
# [merged] import Token, TokType, token_name from lexer;


# ═══════════════════════════════════════════════════════
# AST Node Types
# ═══════════════════════════════════════════════════════

enum AstType:
    Program         = 0;
    Block           = 1;
    FuncDef         = 2;
    VarDecl         = 3;
    ConstDecl       = 4;
    Assign          = 5;
    IndexAssign     = 6;
    FieldAssign     = 7;
    IfStmt          = 8;
    LoopStmt        = 9;
    WhileStmt       = 10;
    ForRange        = 11;
    ReturnStmt      = 12;
    PrintStmt       = 13;
    BreakStmt       = 14;
    ContinueStmt    = 15;
    EnumDef         = 16;
    EntityDef       = 17;
    ImportStmt      = 18;
    ModuleStmt      = 19;
    ExportStmt      = 20;
    IncludeStmt     = 21;
    LiteralInt      = 30;
    LiteralFloat    = 31;
    LiteralStr      = 32;
    Identifier      = 33;
    BinOp           = 34;
    Compare         = 35;
    Call            = 36;
    BuiltinCall     = 37;
    InputExpr       = 38;
    ArrayLiteral    = 39;
    IndexAccess     = 40;
    FieldAccess     = 41;
    EnumAccess      = 42;
    EntityLiteral   = 43;
    CheckCpu        = 50;
    PatchPoint      = 51;
end


# ═══════════════════════════════════════════════════════
# Operator Types
# ═══════════════════════════════════════════════════════

enum OpType:
    Add     = 0;
    Sub     = 1;
    Mul     = 2;
    Div     = 3;
    ModOp   = 4;
    Eq      = 10;
    Ne      = 11;
    Gt      = 12;
    Lt      = 13;
    Ge      = 14;
    Le      = 15;
    AndOp   = 20;
    OrOp    = 21;
    XorOp   = 22;
    ShlOp   = 23;
    ShrOp   = 24;
end


# ═══════════════════════════════════════════════════════
# AST Node
# ═══════════════════════════════════════════════════════

entity AstNode:
    node_type:      AstType;
    op:             OpType;
    line:           int;
    name:           string;
    name2:          string;
    int_val:        int;
    float_val:      float;
    builtin_id:     int;
    children:       Vec<AstNode>;
end

func ast_new:
    in(typ:AstType)
    out AstNode {;
        node_type:  typ,;
        op:         OpType::Add,;
        line:       0,;
        name:       str_new(""),;
        name2:      str_new(""),;
        int_val:    0,;
        float_val:  0.0,;
        builtin_id: 0,;
        children:   vec_new<AstNode>();
    };
end

func ast_add_child:
    in(parent:AstNode; child:AstNode)
    vec_push(parent.children, child);
    out parent;
end


# ═══════════════════════════════════════════════════════
# Builtin Function Lookup
# ═══════════════════════════════════════════════════════

enum BuiltinId:
    None            = 0;
    Len             = 1;
    Push            = 2;
    Alloc           = 3;
    FreeMem         = 4;
    Read8           = 5;
    Write8          = 6;
    Read64          = 7;
    Write64         = 8;
    StrLen          = 9;
    StrGet          = 10;
    StrCat          = 11;
    StrEq           = 12;
    FileOpen        = 13;
    FileRead        = 14;
    FileWrite       = 15;
    FileClose       = 16;
    FileWriteByte   = 17;
    Exit            = 18;
    IToStr          = 19;
    StrToI          = 20;
    ArrNew          = 21;
    PrintStr        = 22;
    GetArg          = 23;
    ArgCount        = 24;
end

entity BuiltinEntry:
    name:   string;
    bid:    BuiltinId;
end

func build_builtins:
    table = vec_new<BuiltinEntry>();
    vec_push(table, BuiltinEntry { name: str_new("len"), bid: BuiltinId::Len });
    vec_push(table, BuiltinEntry { name: str_new("push"), bid: BuiltinId::Push });
    vec_push(table, BuiltinEntry { name: str_new("alloc"), bid: BuiltinId::Alloc });
    vec_push(table, BuiltinEntry { name: str_new("dealloc"), bid: BuiltinId::FreeMem });
    vec_push(table, BuiltinEntry { name: str_new("read_byte"), bid: BuiltinId::Read8 });
    vec_push(table, BuiltinEntry { name: str_new("write_byte"), bid: BuiltinId::Write8 });
    vec_push(table, BuiltinEntry { name: str_new("read_word"), bid: BuiltinId::Read64 });
    vec_push(table, BuiltinEntry { name: str_new("write_word"), bid: BuiltinId::Write64 });
    vec_push(table, BuiltinEntry { name: str_new("str_len"), bid: BuiltinId::StrLen });
    vec_push(table, BuiltinEntry { name: str_new("str_get"), bid: BuiltinId::StrGet });
    vec_push(table, BuiltinEntry { name: str_new("str_cat"), bid: BuiltinId::StrCat });
    vec_push(table, BuiltinEntry { name: str_new("str_eq"), bid: BuiltinId::StrEq });
    vec_push(table, BuiltinEntry { name: str_new("file_open"), bid: BuiltinId::FileOpen });
    vec_push(table, BuiltinEntry { name: str_new("file_read"), bid: BuiltinId::FileRead });
    vec_push(table, BuiltinEntry { name: str_new("file_write"), bid: BuiltinId::FileWrite });
    vec_push(table, BuiltinEntry { name: str_new("file_close"), bid: BuiltinId::FileClose });
    vec_push(table, BuiltinEntry { name: str_new("file_write_byte"), bid: BuiltinId::FileWriteByte });
    vec_push(table, BuiltinEntry { name: str_new("exit_prog"), bid: BuiltinId::Exit });
    vec_push(table, BuiltinEntry { name: str_new("i_to_str"), bid: BuiltinId::IToStr });
    vec_push(table, BuiltinEntry { name: str_new("int_to_str"), bid: BuiltinId::IToStr });
    vec_push(table, BuiltinEntry { name: str_new("str_to_i"), bid: BuiltinId::StrToI });
    vec_push(table, BuiltinEntry { name: str_new("str_to_int"), bid: BuiltinId::StrToI });
    vec_push(table, BuiltinEntry { name: str_new("arr_new"), bid: BuiltinId::ArrNew });
    vec_push(table, BuiltinEntry { name: str_new("print_str"), bid: BuiltinId::PrintStr });
    vec_push(table, BuiltinEntry { name: str_new("get_arg"), bid: BuiltinId::GetArg });
    vec_push(table, BuiltinEntry { name: str_new("arg_count"), bid: BuiltinId::ArgCount });
    out table;
end

func lookup_builtin:
    in(table:Vec<BuiltinEntry>; name:string)
    i = 0;
    when i < vec_len(table) loop
        entry = vec_get(table, i);
        if str_eq(entry.name, name):
            out entry.bid;
        end
        i = i + 1;
    end
    out BuiltinId::None;
end


# ═══════════════════════════════════════════════════════
# Parser State
# ═══════════════════════════════════════════════════════

entity Parser:
    tokens:         Vec<Token>;
    pos:            int;
    token_count:    int;
    error:          string;
    error_line:     int;
    builtins:       Vec<BuiltinEntry>;
end

func parser_new:
    in(tokens:Vec<Token>)
    out Parser {;
        tokens:      tokens,;
        pos:         0,;
        token_count: vec_len(tokens) >> int,;
        error:       str_new(""),;
        error_line:  0,;
        builtins:    build_builtins();
    };
end


# ═══════════════════════════════════════════════════════
# Parser Helpers
# ═══════════════════════════════════════════════════════

func parse_error:
    in(p:Parser; msg:string)
    if str_len(p.error) == 0:
        t = peek(p);
        p.error = str_concat(str_concat(str_new("line "), int_to_str(t.line >> int)), str_concat(str_new(": "), msg));
        p.error_line = t.line;
    end
    out p;
end

func peek:
    in(p:Parser)
    idx = p.pos;
    if idx >= p.token_count:
        idx = p.token_count - 1;
    end
    out vec_get(p.tokens, idx >> int);
end

func advance:
    in(p:Parser)
    t = peek(p);
    if p.pos < p.token_count:
        p.pos = p.pos + 1;
    end
    out (p, t);
end

func check:
    in(p:Parser; tok_type:TokType)
    out peek(p).tok_type == tok_type;
end

func match_tok:
    in(p:Parser; tok_type:TokType)
    if check(p, tok_type):
        var (p2, _) = advance(p);
        out (p2, true);
    end
    out (p, false);
end

func expect:
    in(p:Parser; tok_type:TokType; msg:string)
    if check(p, tok_type):
        var (p2, t) = advance(p);
        out (p2, t, true);
    end
    p = parse_error(p, msg);
    out (p, peek(p), false);
end

func skip_newlines:
    in(p:Parser)
    when check(p, TokType::Newline) loop
        var (p2, _) = advance(p);
        p = p2;
    end
    out p;
end

func is_stmt_start:
    in(t:TokType)
    out t == TokType::Var or t == TokType::Const or t == TokType::If or;
        t == TokType::Loop or t == TokType::While or t == TokType::For or;
        t == TokType::Out or t == TokType::Print or t == TokType::Input or;
        t == TokType::Ident or t == TokType::Int or t == TokType::Float or;
        t == TokType::Str or t == TokType::LParen or t == TokType::Minus or;
        t == TokType::Not or t == TokType::CheckCpu or t == TokType::Patch or;
        t == TokType::Func or t == TokType::Break or t == TokType::Skip or;
        t == TokType::True or t == TokType::False or t == TokType::LBracket or;
        t == TokType::Enum or t == TokType::Entity or;
        t == TokType::Import or t == TokType::From or t == TokType::Module or;
        t == TokType::Export or t == TokType::Include or;
        t == TokType::Extern;
end


# ═══════════════════════════════════════════════════════
# Expression Parsing (precedence climbing)
# ═══════════════════════════════════════════════════════

func parse_primary:
    in(p:Parser)
    t = peek(p);

    # Integer literal
    if t.tok_type == TokType::Int:
        var (p2, t2) = advance(p);
        n = ast_new(AstType::LiteralInt);
        n.int_val = t2.int_val;
        n.line = t2.line;
        out (p2, n);
    end

    # Float literal
    if t.tok_type == TokType::Float:
        var (p2, t2) = advance(p);
        n = ast_new(AstType::LiteralFloat);
        n.float_val = t2.float_val;
        n.line = t2.line;
        out (p2, n);
    end

    # String literal
    if t.tok_type == TokType::Str:
        var (p2, t2) = advance(p);
        n = ast_new(AstType::LiteralStr);
        n.name = t2.str_val;
        n.line = t2.line;
        out (p2, n);
    end

    # Boolean true
    if t.tok_type == TokType::True:
        var (p2, _) = advance(p);
        n = ast_new(AstType::LiteralInt);
        n.int_val = 1;
        n.line = t.line;
        out (p2, n);
    end

    # Boolean false / none
    if t.tok_type == TokType::False or t.tok_type == TokType::NoneLit:
        var (p2, _) = advance(p);
        n = ast_new(AstType::LiteralInt);
        n.int_val = 0;
        n.line = t.line;
        out (p2, n);
    end

    # Identifier (may be call, index, entity literal...)
    if t.tok_type == TokType::Ident:
        var (p2, id_tok) = advance(p);

        # Check for entity literal: IDENT '{' field: val, ... '}'
        if check(p2, TokType::LBrace) and check_entity_literal(p2):
            var (p3, _) = advance(p2)  # consume '{';
            el = ast_new(AstType::EntityLiteral);
            el.name = id_tok.str_val;
            el.line = id_tok.line;
            when not check(p3, TokType::RBrace) and not check(p3, TokType::Eof) loop
                var (p4, fname, ok) = expect(p3, TokType::Ident, str_new("expected field name"));
                p3 = p4;
                if not ok:
                    out (p3, el);
                end
                var (p5, _, _) = expect(p3, TokType::Colon, str_new("expected ':' after field"));
                p3 = p5;
                var (p6, val) = parse_expr(p3);
                p3 = p6;
                val.name2 = fname.str_val;
                el = ast_add_child(el, val);
                var (p7, _) = match_tok(p3, TokType::Comma);
                p3 = p7;
                p3 = skip_newlines(p3);
            end
            var (p8, _, _) = expect(p3, TokType::RBrace, str_new("expected '}' after entity literal"));
            out (p8, el);
        end

        # Check for function call: IDENT '('
        if check(p2, TokType::LParen):
            bid = lookup_builtin(p2.builtins, id_tok.str_val);
            if bid != BuiltinId::None:
                # Builtin call
                call = ast_new(AstType::BuiltinCall);
                call.builtin_id = bid >> int;
                call.name = id_tok.str_val;
                call.line = id_tok.line;
                var (p3, _) = advance(p2)  # consume '(';
                if not check(p3, TokType::RParen):
                    var (p4, arg) = parse_expr(p3);
                    p3 = p4;
                    call = ast_add_child(call, arg);
                    should_loop = true;
                    when should_loop loop
                        var (p5, matched) = match_tok(p3, TokType::Comma);
                        p3 = p5;
                        if not matched:
                            should_loop = false;
                        else
                            var (p6, arg2) = parse_expr(p3);
                            p3 = p6;
                            call = ast_add_child(call, arg2);
                        end
                    end
                end
                var (p7, _, _) = expect(p3, TokType::RParen, str_new("expected ')' after builtin args"));
                out (p7, call);
            end

            # Regular function call
            call = ast_new(AstType::Call);
            call.name = id_tok.str_val;
            call.line = id_tok.line;
            var (p3, _) = advance(p2)  # consume '(';
            if not check(p3, TokType::RParen):
                var (p4, arg) = parse_expr(p3);
                p3 = p4;
                call = ast_add_child(call, arg);
                should_loop = true;
                when should_loop loop
                    var (p5, matched) = match_tok(p3, TokType::Comma);
                    p3 = p5;
                    if not matched:
                        should_loop = false;
                    else
                        var (p6, arg2) = parse_expr(p3);
                        p3 = p6;
                        call = ast_add_child(call, arg2);
                    end
                end
            end
            var (p7, _, _) = expect(p3, TokType::RParen, str_new("expected ')' after arguments"));
            out (p7, call);
        end

        # Check for index access: IDENT '['
        if check(p2, TokType::LBracket):
            var (p3, _) = advance(p2)  # consume '[';
            var (p4, idx_expr) = parse_expr(p3);
            var (p5, _, _) = expect(p4, TokType::RBracket, str_new("expected ']' after index"));
            access = ast_new(AstType::IndexAccess);
            access.name = id_tok.str_val;
            access.line = id_tok.line;
            access = ast_add_child(access, idx_expr);
            out (p5, access);
        end

        # Plain identifier
        n = ast_new(AstType::Identifier);
        n.name = id_tok.str_val;
        n.line = id_tok.line;
        out (p2, n);
    end

    # Input expression
    if t.tok_type == TokType::Input:
        var (p2, _) = advance(p);
        n = ast_new(AstType::InputExpr);
        n.line = t.line;
        out (p2, n);
    end

    # Parenthesised expression
    if t.tok_type == TokType::LParen:
        var (p2, _) = advance(p);
        var (p3, inner) = parse_expr(p2);
        var (p4, _, _) = expect(p3, TokType::RParen, str_new("expected ')'"));
        out (p4, inner);
    end

    # Array literal: [elem, ...]
    if t.tok_type == TokType::LBracket:
        var (p2, _) = advance(p);
        arr = ast_new(AstType::ArrayLiteral);
        arr.line = t.line;
        if not check(p2, TokType::RBracket):
            var (p3, elem) = parse_expr(p2);
            p2 = p3;
            arr = ast_add_child(arr, elem);
            should_loop = true;
            when should_loop loop
                var (p4, matched) = match_tok(p2, TokType::Comma);
                p2 = p4;
                if not matched:
                    should_loop = false;
                else
                    var (p5, elem2) = parse_expr(p2);
                    p2 = p5;
                    arr = ast_add_child(arr, elem2);
                end
            end
        end
        var (p6, _, _) = expect(p2, TokType::RBracket, str_new("expected ']' after array literal"));
        out (p6, arr);
    end

    # Error — expected expression
    p = parse_error(p, str_new("expected expression"));
    out (p, ast_new(AstType::LiteralInt));
end


func check_entity_literal:
    in(p:Parser)
    # Check if '{' starts an entity literal (lookahead for '{' IDENT ':' or '{' '}')
    if not check(p, TokType::LBrace):
        out false;
    end
    next_idx = p.pos + 1;
    if next_idx < p.token_count:
        t1 = vec_get(p.tokens, next_idx >> int);
        if t1.tok_type == TokType::RBrace:
            out true;
        end
        if next_idx + 1 < p.token_count:
            t2 = vec_get(p.tokens, (next_idx + 1) >> int);
            if t1.tok_type == TokType::Ident and t2.tok_type == TokType::Colon:
                out true;
            end
        end
    end
    out false;
end


func parse_unary:
    in(p:Parser)
    # Unary minus
    if check(p, TokType::Minus):
        var (p2, t) = advance(p);
        var (p3, operand) = parse_unary(p2);
        zero = ast_new(AstType::LiteralInt);
        zero.int_val = 0;
        zero.line = t.line;
        n = ast_new(AstType::BinOp);
        n.op = OpType::Sub;
        n.line = t.line;
        n = ast_add_child(n, zero);
        n = ast_add_child(n, operand);
        out (p3, n);
    end

    # Unary NOT
    if check(p, TokType::Not):
        var (p2, t) = advance(p);
        var (p3, operand) = parse_unary(p2);
        zero = ast_new(AstType::LiteralInt);
        zero.int_val = 0;
        zero.line = t.line;
        n = ast_new(AstType::Compare);
        n.op = OpType::Eq;
        n.line = t.line;
        n = ast_add_child(n, operand);
        n = ast_add_child(n, zero);
        out (p3, n);
    end

    # Primary with optional postfix '.' field access
    var (p2, left) = parse_primary(p);
    when check(p2, TokType::Dot) loop
        var (p3, _) = advance(p2);
        var (p4, field, ok) = expect(p3, TokType::Ident, str_new("expected field name after '.'"));
        if not ok:
            out (p4, left);
        end
        fa = ast_new(AstType::FieldAccess);
        fa.name = field.str_val;
        fa.line = field.line;
        fa = ast_add_child(fa, left);
        left = fa;
        p2 = p4;
    end
    out (p2, left);
end


func parse_mult:
    in(p:Parser)
    var (p2, left) = parse_unary(p);

    when check(p2, TokType::Star) or check(p2, TokType::Slash) or check(p2, TokType::Percent) loop
        var (p3, op_tok) = advance(p2);
        op = OpType::Mul;
        if op_tok.tok_type == TokType::Slash:
            op = OpType::Div;
        end
        if op_tok.tok_type == TokType::Percent:
            op = OpType::ModOp;
        end
        var (p4, right) = parse_unary(p3);
        bin = ast_new(AstType::BinOp);
        bin.op = op;
        bin.line = op_tok.line;
        bin = ast_add_child(bin, left);
        bin = ast_add_child(bin, right);
        left = bin;
        p2 = p4;
    end
    out (p2, left);
end


func parse_matmul:
    in(p:Parser)
    var (p2, left) = parse_mult(p);

    when check(p2, TokType::StarStar) or check(p2, TokType::FusedMA) loop
        var (p3, op_tok) = advance(p2);
        var (p4, right) = parse_mult(p3);
        call = ast_new(AstType::Call);
        if op_tok.tok_type == TokType::StarStar:
            call.name = str_new("tensor_matmul");
        else
            call.name = str_new("tensor_fma");
        end
        call.line = op_tok.line;
        call = ast_add_child(call, left);
        call = ast_add_child(call, right);
        left = call;
        p2 = p4;
    end
    out (p2, left);
end


func parse_addition:
    in(p:Parser)
    var (p2, left) = parse_matmul(p);

    when check(p2, TokType::Plus) or check(p2, TokType::Minus) loop
        var (p3, op_tok) = advance(p2);
        op = OpType::Add;
        if op_tok.tok_type == TokType::Minus:
            op = OpType::Sub;
        end
        var (p4, right) = parse_matmul(p3);
        bin = ast_new(AstType::BinOp);
        bin.op = op;
        bin.line = op_tok.line;
        bin = ast_add_child(bin, left);
        bin = ast_add_child(bin, right);
        left = bin;
        p2 = p4;
    end
    out (p2, left);
end


func parse_bitwise:
    in(p:Parser)
    var (p2, left) = parse_addition(p);

    when check(p2, TokType::BitAnd) or check(p2, TokType::BitOr) or loop
          check(p2, TokType::BitXor) or check(p2, TokType::BitShl) or;
          check(p2, TokType::BitShr);
        var (p3, op_tok) = advance(p2);
        op = OpType::AndOp;
        if op_tok.tok_type == TokType::BitOr:
            op = OpType::OrOp;
        end
        if op_tok.tok_type == TokType::BitXor:
            op = OpType::XorOp;
        end
        if op_tok.tok_type == TokType::BitShl:
            op = OpType::ShlOp;
        end
        if op_tok.tok_type == TokType::BitShr:
            op = OpType::ShrOp;
        end
        var (p4, right) = parse_addition(p3);
        bin = ast_new(AstType::BinOp);
        bin.op = op;
        bin.line = op_tok.line;
        bin = ast_add_child(bin, left);
        bin = ast_add_child(bin, right);
        left = bin;
        p2 = p4;
    end
    out (p2, left);
end


func parse_compare:
    in(p:Parser)
    var (p2, left) = parse_bitwise(p);

    if check(p2, TokType::Eq) or check(p2, TokType::Ne) or:
       check(p2, TokType::Gt) or check(p2, TokType::Lt) or;
       check(p2, TokType::Ge) or check(p2, TokType::Le);
        var (p3, op_tok) = advance(p2);
        op = OpType::Eq;
        if op_tok.tok_type == TokType::Ne:
            op = OpType::Ne;
        end
        if op_tok.tok_type == TokType::Gt:
            op = OpType::Gt;
        end
        if op_tok.tok_type == TokType::Lt:
            op = OpType::Lt;
        end
        if op_tok.tok_type == TokType::Ge:
            op = OpType::Ge;
        end
        if op_tok.tok_type == TokType::Le:
            op = OpType::Le;
        end
        var (p4, right) = parse_bitwise(p3);
        cmp = ast_new(AstType::Compare);
        cmp.op = op;
        cmp.line = op_tok.line;
        cmp = ast_add_child(cmp, left);
        cmp = ast_add_child(cmp, right);
        out (p4, cmp);
    end
    out (p2, left);
end


func parse_and_expr:
    in(p:Parser)
    var (p2, left) = parse_compare(p);

    when check(p2, TokType::And) loop
        var (p3, _) = advance(p2);
        var (p4, right) = parse_compare(p3);
        bin = ast_new(AstType::BinOp);
        bin.op = OpType::AndOp;
        bin = ast_add_child(bin, left);
        bin = ast_add_child(bin, right);
        left = bin;
        p2 = p4;
    end
    out (p2, left);
end


func parse_or_expr:
    in(p:Parser)
    var (p2, left) = parse_and_expr(p);

    when check(p2, TokType::Or) loop
        var (p3, _) = advance(p2);
        var (p4, right) = parse_and_expr(p3);
        bin = ast_new(AstType::BinOp);
        bin.op = OpType::OrOp;
        bin = ast_add_child(bin, left);
        bin = ast_add_child(bin, right);
        left = bin;
        p2 = p4;
    end
    out (p2, left);
end


func parse_expr:
    in(p:Parser)
    out parse_or_expr(p);
end


# ═══════════════════════════════════════════════════════
# Statement Parsing
# ═══════════════════════════════════════════════════════

func parse_block:
    in(p:Parser)
    block = ast_new(AstType::Block);
    p = skip_newlines(p);

    keep_parsing = true;
    when keep_parsing loop
        if check(p, TokType::End) or check(p, TokType::Else) or check(p, TokType::Eif) or check(p, TokType::Eof):
            keep_parsing = false;
        else
            var (p2, stmt) = parse_statement(p);
            p = p2;
            block = ast_add_child(block, stmt);
            if str_len(p.error) > 0:
                out (p, block);
            end
            p = skip_newlines(p);
        end
    end
    out (p, block);
end


func parse_var_decl:
    in(p:Parser; is_const:bool)
    var (p2, name_tok, ok) = expect(p, TokType::Ident, str_new("expected variable name"));
    if not ok:
        out (p2, ast_new(AstType::VarDecl));
    end

    decl_type = AstType::VarDecl;
    if is_const:
        decl_type = AstType::ConstDecl;
    end
    decl = ast_new(decl_type);
    decl.name = name_tok.str_val;
    decl.line = name_tok.line;

    # Skip optional type annotation `: type`
    if check(p2, TokType::Colon):
        var (p_tc, _) = advance(p2);
        p2 = p_tc;
        if check(p2, TokType::Ident):
            var (p_tn, _) = advance(p2);
            p2 = p_tn;
        end
    end

    var (p3, matched) = match_tok(p2, TokType::Assign);
    if matched:
        var (p4, init) = parse_expr(p3);
        decl = ast_add_child(decl, init);
        out (p4, decl);
    end
    out (p3, decl);
end


func parse_if_stmt:
    in(p:Parser)
    line = peek(p).line;
    var (p2, cond) = parse_expr(p);

    # Implicit block opening (v1.2: no 'then' keyword needed)
    p2 = skip_newlines(p2);

    var (p3, then_block) = parse_block(p2);

    if_node = ast_new(AstType::IfStmt);
    if_node.line = line;
    if_node = ast_add_child(if_node, cond);
    if_node = ast_add_child(if_node, then_block);

    # Handle eif (elif)
    if check(p3, TokType::Eif):
        var (p4, _) = advance(p3);
        var (p5, elif_as_if) = parse_if_stmt(p4);
        else_block = ast_new(AstType::Block);
        else_block = ast_add_child(else_block, elif_as_if);
        if_node = ast_add_child(if_node, else_block);
        out (p5, if_node);
    end

    # Handle else
    var (p4, has_else) = match_tok(p3, TokType::Else);
    if has_else:
        p4 = skip_newlines(p4);
        var (p5, else_block) = parse_block(p4);
        if_node = ast_add_child(if_node, else_block);
        p4 = p5;
    end

    var (p5, _, _) = expect(p4, TokType::End, str_new("expected 'end' after if block"));
    out (p5, if_node);
end


func parse_loop_stmt:
    in(p:Parser)
    line = peek(p).line;
    var (p2, count) = parse_expr(p);
    p2 = skip_newlines(p2);
    var (p3, body) = parse_block(p2);
    var (p4, _, _) = expect(p3, TokType::End, str_new("expected 'end' after loop block"));
    n = ast_new(AstType::LoopStmt);
    n.line = line;
    n = ast_add_child(n, count);
    n = ast_add_child(n, body);
    out (p4, n);
end


func parse_while_stmt:
    in(p:Parser)
    line = peek(p).line;
    var (p2, cond) = parse_expr(p);
    p2 = skip_newlines(p2);
    var (p3, body) = parse_block(p2);
    var (p4, _, _) = expect(p3, TokType::End, str_new("expected 'end' after while block"));
    n = ast_new(AstType::WhileStmt);
    n.line = line;
    n = ast_add_child(n, cond);
    n = ast_add_child(n, body);
    out (p4, n);
end


func parse_return_stmt:
    in(p:Parser)
    line = peek(p).line;
    n = ast_new(AstType::ReturnStmt);
    n.line = line;
    if not check(p, TokType::Newline) and not check(p, TokType::End) and:
       not check(p, TokType::Eof) and not check(p, TokType::Else);
        var (p2, val) = parse_expr(p);
        n = ast_add_child(n, val);
        out (p2, n);
    end
    out (p, n);
end


func parse_print_stmt:
    in(p:Parser)
    line = peek(p).line;
    n = ast_new(AstType::PrintStmt);
    n.line = line;
    var (p2, val) = parse_expr(p);
    n = ast_add_child(n, val);
    out (p2, n);
end


func parse_func_def:
    in(p:Parser)
    var (p2, name_tok, ok) = expect(p, TokType::Ident, str_new("expected function name"));
    if not ok:
        out (p2, ast_new(AstType::FuncDef));
    end

    fn_node = ast_new(AstType::FuncDef);
    fn_node.name = name_tok.str_val;
    fn_node.line = name_tok.line;

    # Parse parameters (optional parens - `func name` and `func name(...)` both valid)
    if check(p2, TokType::LParen):
        var (p3, _) = advance(p2);

        if not check(p3, TokType::RParen):
            var (p4, param_tok, ok2) = expect(p3, TokType::Ident, str_new("expected parameter name"));
            p3 = p4;
            if ok2:
                param = ast_new(AstType::Identifier);
                param.name = param_tok.str_val;
                fn_node = ast_add_child(fn_node, param);
            end
            if check(p3, TokType::Colon):
                var (p_skip, _) = advance(p3);
                p3 = p_skip;
                if check(p3, TokType::Ident):
                    var (p_skip2, _) = advance(p3);
                    p3 = p_skip2;
                end
            end
            should_loop = true;
            when should_loop loop
                has_sep = false;
                var (p5, matched_comma) = match_tok(p3, TokType::Comma);
                p3 = p5;
                if matched_comma:
                    has_sep = true;
                end
                if not has_sep:
                    var (p5b, matched_semi) = match_tok(p3, TokType::Semicolon);
                    p3 = p5b;
                    if matched_semi:
                        has_sep = true;
                    end
                end
                if not has_sep:
                    should_loop = false;
                else
                    var (p6, pt, ok3) = expect(p3, TokType::Ident, str_new("expected parameter name"));
                    p3 = p6;
                    if ok3:
                        param2 = ast_new(AstType::Identifier);
                        param2.name = pt.str_val;
                        fn_node = ast_add_child(fn_node, param2);
                    end
                    if check(p3, TokType::Colon):
                        var (p_skip3, _) = advance(p3);
                        p3 = p_skip3;
                        if check(p3, TokType::Ident):
                            var (p_skip4, _) = advance(p3);
                            p3 = p_skip4;
                        end
                    end
                end
            end
        end

        var (p4, _, _) = expect(p3, TokType::RParen, str_new("expected ')' after parameters"));
        p2 = p4;
    end

    if check(p2, TokType::Arrow):
        var (p_arr, _) = advance(p2);
        p2 = p_arr;
        if check(p2, TokType::Ident):
            var (p_rt, _) = advance(p2);
            p2 = p_rt;
        end
    end

    var (p_colon, _) = match_tok(p2, TokType::Colon);
    p2 = p_colon;
    p2 = skip_newlines(p2);

    var (p5, body) = parse_block(p2);
    fn_node = ast_add_child(fn_node, body);

    var (p6, _, _) = expect(p5, TokType::End, str_new("expected 'end' to close function"));
    out (p6, fn_node);
end


func parse_for_range_stmt:
    in(p:Parser)
    line = peek(p).line;
    var (p2, var_tok, ok) = expect(p, TokType::Ident, str_new("expected loop variable"));
    if not ok:
        out (p2, ast_new(AstType::ForRange));
    end

    var (p3, _, ok2) = expect(p2, TokType::In, str_new("expected 'in' after for variable"));
    if not ok2:
        out (p3, ast_new(AstType::ForRange));
    end

    var (p4, start_expr) = parse_expr(p3);
    var (p5, _, ok3) = expect(p4, TokType::DotDot, str_new("expected '..' in range"));
    if not ok3:
        out (p5, ast_new(AstType::ForRange));
    end

    var (p6, end_expr) = parse_expr(p5);
    p6 = skip_newlines(p6);

    var (p7, body) = parse_block(p6);
    var (p8, _, _) = expect(p7, TokType::End, str_new("expected 'end' after for block"));

    n = ast_new(AstType::ForRange);
    n.name = var_tok.str_val;
    n.line = line;
    n = ast_add_child(n, start_expr);
    n = ast_add_child(n, end_expr);
    n = ast_add_child(n, body);
    out (p8, n);
end


func parse_enum_def:
    in(p:Parser)
    line = peek(p).line;
    var (p2, name_tok, ok) = expect(p, TokType::Ident, str_new("expected enum name"));
    if not ok:
        out (p2, ast_new(AstType::EnumDef));
    end

    p2 = skip_newlines(p2);

    en = ast_new(AstType::EnumDef);
    en.name = name_tok.str_val;
    en.line = line;

    next_val = 0;
    when not check(p2, TokType::End) and not check(p2, TokType::Eof) loop
        var (p3, vname, ok2) = expect(p2, TokType::Ident, str_new("expected enum variant"));
        p2 = p3;
        if not ok2:
            out (p2, en);
        end

        val = next_val;
        var (p4, has_val) = match_tok(p2, TokType::Assign);
        if has_val:
            var (p5, vt, _) = expect(p4, TokType::Int, str_new("expected integer value"));
            p2 = p5;
            val = vt.int_val;
        else
            p2 = p4;
        end
        next_val = val + 1;

        variant = ast_new(AstType::LiteralInt);
        variant.name = vname.str_val;
        variant.int_val = val;
        variant.line = vname.line;
        en = ast_add_child(en, variant);
        p2 = skip_newlines(p2);
    end

    var (p3, _, _) = expect(p2, TokType::End, str_new("expected 'end' after enum"));
    out (p3, en);
end


func parse_entity_def:
    in(p:Parser)
    line = peek(p).line;
    var (p2, name_tok, ok) = expect(p, TokType::Ident, str_new("expected entity name"));
    if not ok:
        out (p2, ast_new(AstType::EntityDef));
    end

    p2 = skip_newlines(p2);

    ed = ast_new(AstType::EntityDef);
    ed.name = name_tok.str_val;
    ed.line = line;

    when not check(p2, TokType::End) and not check(p2, TokType::Eof) loop
        var (p3, fname, ok2) = expect(p2, TokType::Ident, str_new("expected field name"));
        p2 = p3;
        if not ok2:
            out (p2, ed);
        end

        field = ast_new(AstType::Identifier);
        field.name = fname.str_val;
        field.line = fname.line;

        # Optional type hint
        var (p4, has_colon) = match_tok(p2, TokType::Colon);
        if has_colon:
            if check(p4, TokType::Ident):
                var (p5, type_tok) = advance(p4);
                field.name2 = type_tok.str_val;
                p2 = p5;
            else
                p2 = p4;
            end
        else
            p2 = p4;
        end

        ed = ast_add_child(ed, field);
        p2 = skip_newlines(p2);
    end

    var (p3, _, _) = expect(p2, TokType::End, str_new("expected 'end' after entity"));
    out (p3, ed);
end


func parse_statement:
    in(p:Parser)
    p = skip_newlines(p);
    t = peek(p);

    if t.tok_type == TokType::Func:
        var (p2, _) = advance(p);
        out parse_func_def(p2);
    end

    # extern func — parse as func_def (body may be empty)
    if t.tok_type == TokType::Extern:
        var (p2, _) = advance(p);
        if check(p2, TokType::Func):
            var (p3, _) = advance(p2);
            out parse_func_def(p3);
        end
    end

    if t.tok_type == TokType::Var:
        var (p2, _) = advance(p);
        # Grouped var block: `var` alone on a line, followed by indented declarations
        if check(p2, TokType::Newline):
            p2 = skip_newlines(p2);
            group = ast_new(AstType::Block);
            group.line = t.line;
            # Parse first declaration in group
            var (p3, first_decl) = parse_var_decl(p2, false);
            group = ast_add_child(group, first_decl);
            # If line ends with `;`, continue parsing more declarations
            when check(p3, TokType::Semicolon) loop
                var (p4, _) = advance(p3);
                p3 = skip_newlines(p4);
                var (p5, next_decl) = parse_var_decl(p3, false);
                group = ast_add_child(group, next_decl);
                p3 = p5;
            end
            out (p3, group);
        end
        out parse_var_decl(p2, false);
    end

    if t.tok_type == TokType::Const:
        var (p2, _) = advance(p);
        out parse_var_decl(p2, true);
    end

    if t.tok_type == TokType::If:
        var (p2, _) = advance(p);
        out parse_if_stmt(p2);
    end

    if t.tok_type == TokType::Loop:
        var (p2, _) = advance(p);
        out parse_loop_stmt(p2);
    end

    if t.tok_type == TokType::While:
        var (p2, _) = advance(p);
        out parse_while_stmt(p2);
    end

    if t.tok_type == TokType::For:
        var (p2, _) = advance(p);
        out parse_for_range_stmt(p2);
    end

    if t.tok_type == TokType::Enum:
        var (p2, _) = advance(p);
        out parse_enum_def(p2);
    end

    if t.tok_type == TokType::Entity:
        var (p2, _) = advance(p);
        out parse_entity_def(p2);
    end

    if t.tok_type == TokType::Out:
        var (p2, _) = advance(p);
        out parse_return_stmt(p2);
    end

    if t.tok_type == TokType::Print:
        var (p2, _) = advance(p);
        out parse_print_stmt(p2);
    end

    if t.tok_type == TokType::Break:
        var (p2, _) = advance(p);
        n = ast_new(AstType::BreakStmt);
        n.line = t.line;
        out (p2, n);
    end

    if t.tok_type == TokType::Skip:
        var (p2, _) = advance(p);
        n = ast_new(AstType::ContinueStmt);
        n.line = t.line;
        out (p2, n);
    end

    if t.tok_type == TokType::Import:
        var (p2, _) = advance(p);
        var (p3, mod_tok, ok) = expect(p2, TokType::Ident, str_new("expected module name"));
        if not ok:
            out (p3, ast_new(AstType::ImportStmt));
        end
        n = ast_new(AstType::ImportStmt);
        n.name = mod_tok.str_val;
        n.line = t.line;
        var (p4, has_as) = match_tok(p3, TokType::As);
        if has_as:
            var (p5, alias, _) = expect(p4, TokType::Ident, str_new("expected alias"));
            n.name2 = alias.str_val;
            out (p5, n);
        end
        out (p4, n);
    end

    if t.tok_type == TokType::From:
        var (p2, _) = advance(p);
        var (p3, mod_tok, ok) = expect(p2, TokType::Ident, str_new("expected module name"));
        if not ok:
            out (p3, ast_new(AstType::ImportStmt));
        end
        var (p4, _, _) = expect(p3, TokType::Import, str_new("expected 'import'"));
        n = ast_new(AstType::ImportStmt);
        n.name = mod_tok.str_val;
        n.line = t.line;
        should_loop = true;
        when should_loop loop
            var (p5, sym, _) = expect(p4, TokType::Ident, str_new("expected symbol name"));
            p4 = p5;
            s = ast_new(AstType::Identifier);
            s.name = sym.str_val;
            s.line = sym.line;
            n = ast_add_child(n, s);
            var (p6, matched) = match_tok(p4, TokType::Comma);
            p4 = p6;
            if not matched:
                should_loop = false;
            end
        end
        out (p4, n);
    end

    if t.tok_type == TokType::Module:
        var (p2, _) = advance(p);
        var (p3, mod_tok, _) = expect(p2, TokType::Ident, str_new("expected module name"));
        n = ast_new(AstType::ModuleStmt);
        n.name = mod_tok.str_val;
        n.line = t.line;
        out (p3, n);
    end

    if t.tok_type == TokType::Export:
        var (p2, _) = advance(p);
        var (p3, fn_tok, _) = expect(p2, TokType::Ident, str_new("expected function name after export"));
        n = ast_new(AstType::ExportStmt);
        n.name = fn_tok.str_val;
        n.line = t.line;
        out (p3, n);
    end

    if t.tok_type == TokType::Include:
        var (p2, _) = advance(p);
        var (p3, file_tok, _) = expect(p2, TokType::Str, str_new("expected filename after include"));
        n = ast_new(AstType::IncludeStmt);
        n.name = file_tok.str_val;
        n.line = t.line;
        out (p3, n);
    end

    if t.tok_type == TokType::CheckCpu:
        var (p2, _) = advance(p);
        n = ast_new(AstType::CheckCpu);
        n.line = t.line;
        out (p2, n);
    end

    if t.tok_type == TokType::Patch:
        var (p2, _) = advance(p);
        n = ast_new(AstType::PatchPoint);
        n.line = t.line;
        out (p2, n);
    end

    # Identifier (may be assignment, field/index assign, or expression)
    if t.tok_type == TokType::Ident:
        var (p2, id_tok) = advance(p);

        # Simple assignment: IDENT = expr
        if check(p2, TokType::Assign):
            var (p3, _) = advance(p2);
            var (p4, val) = parse_expr(p3);
            assign = ast_new(AstType::Assign);
            assign.name = id_tok.str_val;
            assign.line = id_tok.line;
            assign = ast_add_child(assign, val);
            out (p4, assign);
        end

        # Field assignment: IDENT.FIELD = expr
        if check(p2, TokType::Dot):
            var (p3, _) = advance(p2);
            var (p4, field_tok, ok) = expect(p3, TokType::Ident, str_new("expected field name"));
            if ok and check(p4, TokType::Assign):
                var (p5, _) = advance(p4);
                var (p6, val) = parse_expr(p5);
                fa = ast_new(AstType::FieldAssign);
                fa.name = id_tok.str_val;
                fa.name2 = field_tok.str_val;
                fa.line = id_tok.line;
                fa = ast_add_child(fa, val);
                out (p6, fa);
            end
            # Not field assign — back up and parse as expression
            p2 = p;
            var (p5, expr) = parse_expr(p2);
            out (p5, expr);
        end

        # Index assignment: IDENT[expr] = expr
        if check(p2, TokType::LBracket):
            var (p3, _) = advance(p2);
            var (p4, idx_expr) = parse_expr(p3);
            var (p5, _, _) = expect(p4, TokType::RBracket, str_new("expected ']'"));
            if check(p5, TokType::Assign):
                var (p6, _) = advance(p5);
                var (p7, val) = parse_expr(p6);
                ia = ast_new(AstType::IndexAssign);
                ia.name = id_tok.str_val;
                ia.line = id_tok.line;
                ia = ast_add_child(ia, idx_expr);
                ia = ast_add_child(ia, val);
                out (p7, ia);
            end
            # Not assignment — it's an index access expression
            acc = ast_new(AstType::IndexAccess);
            acc.name = id_tok.str_val;
            acc.line = id_tok.line;
            acc = ast_add_child(acc, idx_expr);
            out (p5, acc);
        end

        # Back up and parse as expression
        p.pos = p.pos - 1;
        var (p3, expr) = parse_expr(p);
        out (p3, expr);
    end

    # EOF / END / ELSE / EIF — no statement
    if t.tok_type == TokType::Eof or t.tok_type == TokType::End or:
       t.tok_type == TokType::Else or t.tok_type == TokType::Eif;
        out (p, ast_new(AstType::LiteralInt));
    end

    # Default: try as expression statement
    out parse_expr(p);
end


# ═══════════════════════════════════════════════════════
# Top-Level Entry Point
# ═══════════════════════════════════════════════════════

func parse_program:
    in(p:Parser)
    prog = ast_new(AstType::Program);
    p = skip_newlines(p);

    when not check(p, TokType::Eof) loop
        var (p2, stmt) = parse_statement(p);
        p = p2;
        prog = ast_add_child(prog, stmt);
        if str_len(p.error) > 0:
            out (p, prog);
        end
        p = skip_newlines(p);
    end

    out (p, prog);
end

# ═══ END: stdlib/vir/compiler/parser.vri ═══

# [merged] import Parser, AstNode, AstType, parser_new, parse_program from parser;
# [merged] include vir::compiler::ir_optimizer;
# ═══ BEGIN: stdlib/vir/compiler/ir_optimizer.vri ═══
##
 * vir/compiler/ir_optimizer.vri — AST→Q-IR Lowering + Linear-Scan RegAlloc
 * =========================================================================
 * Pure Vir implementation. Transforms AST into Q-IR instructions,
 * performs liveness analysis, linear-scan register allocation,
 * spill code insertion, and tail-call optimization.
 *
 * Converted from C (core/src/ir_lower.c) for self-hosting.
 ##

# [merged] include types;
# [merged] include string;
# [merged] import String, str_new, str_concat, str_len, str_eq from string;
# [merged] include vec;
# [merged] import Vec, vec_new, vec_push, vec_len, vec_get, vec_set from vec;
# [merged] include lexer;
# [merged] import TokType from lexer;
# [merged] include parser;
# [merged] import AstNode, AstType, OpType, BuiltinId from parser;


# ═══════════════════════════════════════════════════════
# Q-IR Opcode Set
# ═══════════════════════════════════════════════════════

enum QOp:
    Nop             = 0;
    Load            = 1;
    Move            = 2;
    Add             = 3;
    Sub             = 4;
    Mul             = 5;
    Div             = 6;
    Mod             = 7;
    And             = 8;
    Or              = 9;
    Xor             = 10;
    Shl             = 11;
    Shr             = 12;
    CmpEq           = 20;
    CmpNe           = 21;
    CmpGt           = 22;
    CmpLt           = 23;
    CmpGe           = 24;
    CmpLe           = 25;
    Jump            = 30;
    JumpIf          = 31;
    JumpIfNot       = 32;
    Label           = 33;
    Call            = 34;
    CallFunc        = 35;
    Ret             = 36;
    Print           = 40;
    PrintStr        = 41;
    Input           = 42;
    Alloc           = 50;
    Free            = 51;
    LoadByte        = 52;
    StoreByte       = 53;
    LoadWord        = 54;
    StoreWord       = 55;
    ArrNew          = 60;
    ArrPush         = 61;
    ArrGet          = 62;
    ArrSet          = 63;
    ArrLen          = 64;
    StrLenOp        = 70;
    StrGet          = 71;
    StrCat          = 72;
    StrEq           = 73;
    IToStr          = 74;
    StrToI          = 75;
    FileOpen        = 80;
    FileRead        = 81;
    FileWrite       = 82;
    FileClose       = 83;
    FileWriteByte   = 84;
    Exit            = 90;
    PatchPoint      = 91;
    LoadGlobal      = 92;
    StoreGlobal     = 93;
    GetArg          = 94;
    ArgCount        = 95;
    Syscall         = 96;
    MemLoad         = 97;
    MemLoad8        = 98;
    MemStore        = 99;
    MemStore8       = 100;
    PatchFunc       = 101;
    RegPin          = 102;
    SignVsib        = 103;
    ReflectIR       = 104;
    BoundsCheck     = 105;
    StackAlloc      = 106;
    VLoad           = 107;
    VStore          = 108;
    VAdd            = 109;
    VSub            = 110;
    VMul            = 111;
    VDiv            = 112;
    VFma            = 113;
    VMin            = 114;
    VMax            = 115;
    VReduce         = 116;
    VSplat          = 117;
    VPerm           = 118;
    VCmpEq          = 119;
    VAbs            = 120;
    VSqrt           = 121;
    VMla            = 122;
    MemCopy         = 123;
    MemSet          = 124;
    CLZ             = 125;
    CTZ             = 126;
    PopCnt          = 127;
    BSwap           = 128;
    Not             = 129;
    Neg             = 130;
    Fence           = 131;
    AtomicLoad      = 132;
    AtomicStore     = 133;
    AtomicCas       = 134;
    AtomicAdd       = 135;
    AtomicSub       = 136;
    Trap            = 137;
    Unreachable     = 138;
    AlignPtr        = 139;
    Store           = 140;
    LoadString      = 141;
    SetArg          = 142;
    FAdd            = 143;
    FSub            = 144;
    FMul            = 145;
    FDiv            = 146;
    FCvtF2I         = 147;
    FCvtI2F         = 148;
    Halt            = 255;
end


# ═══════════════════════════════════════════════════════
# Q-IR Operand
# ═══════════════════════════════════════════════════════

enum OperandType:
    None        = 0;
    VReg        = 1;
    Immediate   = 2;
    LabelRef    = 3;
    StringRef   = 4;
    FuncIdx     = 5;
end

entity QOperand:
    op_type:    OperandType;
    vreg:       int;
    imm_val:    int;
end

func q_none:
    out QOperand { op_type: OperandType::None, vreg: 0, imm_val: 0 };
end

func q_vreg:
    in(r:int)
    out QOperand { op_type: OperandType::VReg, vreg: r, imm_val: 0 };
end

func q_imm:
    in(val:int)
    out QOperand { op_type: OperandType::Immediate, vreg: 0, imm_val: val };
end

func q_label:
    in(id:int)
    out QOperand { op_type: OperandType::LabelRef, vreg: id, imm_val: 0 };
end

func q_str_ref:
    in(idx:int)
    out QOperand { op_type: OperandType::StringRef, vreg: idx, imm_val: 0 };
end

func q_func_idx:
    in(idx:int)
    out QOperand { op_type: OperandType::FuncIdx, vreg: idx, imm_val: 0 };
end


# ═══════════════════════════════════════════════════════
# Q-IR Instruction
# ═══════════════════════════════════════════════════════

entity QInstr:
    opcode:     QOp;
    dest:       QOperand;
    src1:       QOperand;
    src2:       QOperand;
    patch_id:   int;
    label_name: string;
    string_idx: int;
end

func q_instr:
    in(op:QOp; d:QOperand; s1:QOperand; s2:QOperand)
    out QInstr { opcode: op, dest: d, src1: s1, src2: s2, patch_id: 0, label_name: "", string_idx: 0 };
end


# ═══════════════════════════════════════════════════════
# Q-IR Function & Module
# ═══════════════════════════════════════════════════════

entity QFunction:
    name:           string;
    body:           Vec<QInstr>;
    param_count:    int;
    param_vregs:    Vec<int>;
end

func q_func_new:
    in(name:string)
    out QFunction {;
        name:        str_concat(str_new(""), name),;
        body:        vec_new<QInstr>(),;
        param_count: 0,;
        param_vregs: vec_new<int>();
    };
end

func q_func_emit:
    in(f:QFunction; instr:QInstr)
    vec_push(f.body, instr);
    out f;
end


entity QModule:
    name:       string;
    functions:  Vec<QFunction>;
    strings:    Vec<string>;
end

func q_module_new:
    in(name:string)
    out QModule {;
        name:       name,;
        functions:  vec_new<QFunction>(),;
        strings:    vec_new<string>();
    };
end

func q_module_add_func:
    in(m:QModule; name:string)
    i = 0;
    when i < vec_len(m.functions) loop
        if rt_streq(vec_get(m.functions, i).name, name):
            out (m, i >> int);
        end
        i = i + 1;
    end
    f = q_func_new(name);
    vec_push(m.functions, f);
    idx = vec_len(m.functions) - 1;
    out (m, idx >> int);
end

func q_module_add_string:
    in(m:QModule; s:string)
    # Check if string already exists
    i = 0;
    when i < vec_len(m.strings) loop
        if str_eq(vec_get(m.strings, i), s):
            out (m, i >> int);
        end
        i = i + 1;
    end
    vec_push(m.strings, s);
    out (m, (vec_len(m.strings) - 1) >> int);
end


# ═══════════════════════════════════════════════════════
# Symbol Table
# ═══════════════════════════════════════════════════════

entity SymEntry:
    name:       string;
    vreg:       int;
end

entity SymTable:
    entries:    Vec<SymEntry>;
end

func sym_new:
    out SymTable { entries: vec_new<SymEntry>() };
end

func sym_define:
    in(st:SymTable; name:string; vreg:int)
    # Overwrite if exists
    i = 0;
    when i < vec_len(st.entries) loop
        entry = vec_get(st.entries, i);
        if str_eq(entry.name, name):
            entry.vreg = vreg;
            vec_set(st.entries, i, entry);
            out st;
        end
        i = i + 1;
    end
    vec_push(st.entries, SymEntry { name: name, vreg: vreg });
    out st;
end

func sym_lookup:
    in(st:SymTable; name:string)
    i = 0;
    when i < vec_len(st.entries) loop
        entry = vec_get(st.entries, i);
        if str_eq(entry.name, name):
            out (true, entry.vreg);
        end
        i = i + 1;
    end
    out (false, 0);
end


# ═══════════════════════════════════════════════════════
# Enum / Entity Type Registry
# ═══════════════════════════════════════════════════════

entity EnumVariant:
    name:   string;
    value:  int;
end

entity EnumType:
    name:       string;
    variants:   Vec<EnumVariant>;
end

entity EntityField:
    name:   string;
    offset: int;
end

entity EntityType:
    name:       string;
    fields:     Vec<EntityField>;
end

func find_enum_type:
    in(types:Vec<EnumType>; name:string)
    i = 0;
    when i < vec_len(types) loop
        et = vec_get(types, i);
        if str_eq(et.name, name):
            out (true, i);
        end
        i = i + 1;
    end
    out (false, -1);
end

func enum_lookup_variant:
    in(et:EnumType; variant:string)
    i = 0;
    when i < vec_len(et.variants) loop
        v = vec_get(et.variants, i);
        if str_eq(v.name, variant):
            out (true, v.value);
        end
        i = i + 1;
    end
    out (false, 0);
end

func find_entity_type:
    in(types:Vec<EntityType>; name:string)
    i = 0;
    when i < vec_len(types) loop
        et = vec_get(types, i);
        if str_eq(et.name, name):
            out (true, i);
        end
        i = i + 1;
    end
    out (false, -1);
end

func entity_field_offset:
    in(et:EntityType; field:string)
    i = 0;
    when i < vec_len(et.fields) loop
        f = vec_get(et.fields, i);
        if str_eq(f.name, field):
            out (true, f.offset >> int);
        end
        i = i + 1;
    end
    out (false, -1);
end


# ═══════════════════════════════════════════════════════
# Lowering Context
# ═══════════════════════════════════════════════════════

entity LowerCtx:
    module:             QModule;
    next_vreg:          int;
    label_counter:      int;
    symbols:            SymTable;
    global_symbols:     SymTable;
    global_idx_counter: int;
    enum_types:         Vec<EnumType>;
    entity_types:       Vec<EntityType>;
    current_func_idx:   int;
    loop_depth:         int;
    loop_start_labels:  Vec<int>;
    loop_end_labels:    Vec<int>;
    error_count:        int;
    last_error:         string;
    patch_counter:      int;
end

func lower_ctx_new:
    in(mod_name:string)
    out LowerCtx {;
        module:             q_module_new(mod_name),;
        next_vreg:          0,;
        label_counter:      0,;
        symbols:            sym_new(),;
        global_symbols:     sym_new(),;
        global_idx_counter: 0,;
        enum_types:         vec_new<EnumType>(),;
        entity_types:       vec_new<EntityType>(),;
        current_func_idx:   -1,;
        loop_depth:         0,;
        loop_start_labels:  vec_new<int>(),;
        loop_end_labels:    vec_new<int>(),;
        error_count:        0,;
        last_error:         str_new(""),;
        patch_counter:      0;
    };
end

func fresh_vreg:
    in(ctx:LowerCtx)
    r = ctx.next_vreg;
    ctx.next_vreg = ctx.next_vreg + 1;
    out (ctx, r);
end

func fresh_label:
    in(ctx:LowerCtx)
    l = ctx.label_counter;
    ctx.label_counter = ctx.label_counter + 1;
    out (ctx, l);
end

func lower_error:
    in(ctx:LowerCtx; msg:string)
    ctx.last_error = msg;
    ctx.error_count = ctx.error_count + 1;
    out ctx;
end

func emit:
    in(ctx:LowerCtx; instr:QInstr)
    if ctx.current_func_idx >= 0:
        f = vec_get(ctx.module.functions, ctx.current_func_idx);
        f = q_func_emit(f, instr);
        vec_set(ctx.module.functions, ctx.current_func_idx, f);
    end
    out ctx;
end

func sym_lookup_both:
    in(ctx:LowerCtx; name:string)
    # Returns: 0=local, 1=global, -1=not found; and the vreg/index
    var (found, vreg) = sym_lookup(ctx.symbols, name);
    if found:
        out (0, vreg);
    end
    var (found2, idx) = sym_lookup(ctx.global_symbols, name);
    if found2:
        out (1, idx);
    end
    out (-1, 0);
end

func find_func_index:
    in(ctx:LowerCtx; name:string)
    i = 0;
    when i < vec_len(ctx.module.functions) loop
        f = vec_get(ctx.module.functions, i);
        if str_eq(f.name, name):
            out i >> int;
        end
        i = i + 1;
    end
    out -1;
end


# ═══════════════════════════════════════════════════════
# Expression Lowering
# ═══════════════════════════════════════════════════════

func lower_expr:
    in(ctx:LowerCtx; expr:AstNode)
    if expr.node_type == AstType::LiteralInt:
        var (ctx2, r) = fresh_vreg(ctx);
        ctx2 = emit(ctx2, q_instr(QOp::Load, q_vreg(r), q_imm(expr.int_val), q_none()));
        out (ctx2, r >> int);
    end

    if expr.node_type == AstType::LiteralFloat:
        var (ctx2, r) = fresh_vreg(ctx);
        ctx2 = emit(ctx2, q_instr(QOp::Load, q_vreg(r), q_imm(expr.float_val >> int), q_none()));
        out (ctx2, r >> int);
    end

    if expr.node_type == AstType::LiteralStr:
        var (ctx2, str_idx) = q_module_add_string(ctx.module, expr.name);
        ctx.module = ctx2;
        var (ctx3, r) = fresh_vreg(ctx);
        ctx3 = emit(ctx3, q_instr(QOp::Load, q_vreg(r), q_str_ref(str_idx), q_none()));
        out (ctx3, r >> int);
    end

    if expr.node_type == AstType::Identifier:
        var (scope, idx) = sym_lookup_both(ctx, expr.name);
        if scope < 0:
            ctx = lower_error(ctx, str_concat(str_new("undefined variable: "), expr.name));
            out (ctx, -1);
        end
        if scope == 1:
            var (ctx2, rd) = fresh_vreg(ctx);
            ctx2 = emit(ctx2, q_instr(QOp::LoadGlobal, q_vreg(rd), q_imm(idx >> int), q_none()));
            out (ctx2, rd >> int);
        end
        out (ctx, idx >> int);
    end

    if expr.node_type == AstType::BinOp:
        var (ctx2, lhs) = lower_expr(ctx, vec_get(expr.children, 0));
        if lhs < 0:
            out (ctx2, -1);
        end
        var (ctx3, rhs) = lower_expr(ctx2, vec_get(expr.children, 1));
        if rhs < 0:
            out (ctx3, -1);
        end
        var (ctx4, rd) = fresh_vreg(ctx3);
        op = QOp::Add;
        if expr.op == OpType::Sub:
            op = QOp::Sub;
        end
        if expr.op == OpType::Mul:
            op = QOp::Mul;
        end
        if expr.op == OpType::Div:
            op = QOp::Div;
        end
        if expr.op == OpType::ModOp:
            op = QOp::Mod;
        end
        if expr.op == OpType::AndOp:
            op = QOp::And;
        end
        if expr.op == OpType::OrOp:
            op = QOp::Or;
        end
        if expr.op == OpType::XorOp:
            op = QOp::Xor;
        end
        if expr.op == OpType::ShlOp:
            op = QOp::Shl;
        end
        if expr.op == OpType::ShrOp:
            op = QOp::Shr;
        end
        ctx4 = emit(ctx4, q_instr(op, q_vreg(rd), q_vreg(lhs >> int), q_vreg(rhs >> int)));
        out (ctx4, rd >> int);
    end

    if expr.node_type == AstType::Compare:
        var (ctx2, lhs) = lower_expr(ctx, vec_get(expr.children, 0));
        if lhs < 0:
            out (ctx2, -1);
        end
        var (ctx3, rhs) = lower_expr(ctx2, vec_get(expr.children, 1));
        if rhs < 0:
            out (ctx3, -1);
        end
        var (ctx4, rd) = fresh_vreg(ctx3);

        if expr.op == OpType::Ne:
            # NE = XOR(EQ(lhs, rhs), 1)
            var (ctx5, eq_r) = fresh_vreg(ctx4);
            var (ctx6, one_r) = fresh_vreg(ctx5);
            ctx6 = emit(ctx6, q_instr(QOp::CmpEq, q_vreg(eq_r), q_vreg(lhs >> int), q_vreg(rhs >> int)));
            ctx6 = emit(ctx6, q_instr(QOp::Load, q_vreg(one_r), q_imm(1), q_none()));
            ctx6 = emit(ctx6, q_instr(QOp::Xor, q_vreg(rd), q_vreg(eq_r), q_vreg(one_r)));
            out (ctx6, rd >> int);
        end

        cmp_op = QOp::CmpEq;
        if expr.op == OpType::Gt:
            cmp_op = QOp::CmpGt;
        end
        if expr.op == OpType::Lt:
            cmp_op = QOp::CmpLt;
        end
        if expr.op == OpType::Ge:
            cmp_op = QOp::CmpGe;
        end
        if expr.op == OpType::Le:
            cmp_op = QOp::CmpLe;
        end
        ctx4 = emit(ctx4, q_instr(cmp_op, q_vreg(rd), q_vreg(lhs >> int), q_vreg(rhs >> int)));
        out (ctx4, rd >> int);
    end

    if expr.node_type == AstType::Call:
        fidx = find_func_index(ctx, expr.name);
        if fidx < 0:
            ctx = lower_error(ctx, str_concat(str_new("undefined function: "), expr.name));
            var (ctx2, rd) = fresh_vreg(ctx);
            ctx2 = emit(ctx2, q_instr(QOp::Load, q_vreg(rd), q_imm(0), q_none()));
            out (ctx2, rd >> int);
        end

        # Evaluate arguments
        arg_vregs = vec_new<int>();
        i = 0;
        when i < vec_len(expr.children) loop
            var (ctx2, av) = lower_expr(ctx, vec_get(expr.children, i));
            ctx = ctx2;
            if av < 0:
                out (ctx, -1);
            end
            vec_push(arg_vregs, av);
            i = i + 1;
        end

        # Move to R0..Rn
        i = 0;
        when i < vec_len(arg_vregs) loop
            av = vec_get(arg_vregs, i);
            ctx = emit(ctx, q_instr(QOp::Move, q_vreg(i >> int), q_vreg(av >> int), q_none()));
            i = i + 1;
        end

        # Emit call
        ctx = emit(ctx, q_instr(QOp::CallFunc, q_none(), q_func_idx(fidx >> int), q_none()));

        # Result in R0
        var (ctx3, rd) = fresh_vreg(ctx);
        ctx3 = emit(ctx3, q_instr(QOp::Move, q_vreg(rd), q_vreg(0), q_none()));
        out (ctx3, rd >> int);
    end

    if expr.node_type == AstType::InputExpr:
        var (ctx2, rd) = fresh_vreg(ctx);
        ctx2 = emit(ctx2, q_instr(QOp::Input, q_vreg(rd), q_none(), q_none()));
        out (ctx2, rd >> int);
    end

    if expr.node_type == AstType::ArrayLiteral:
        var (ctx2, cap_r) = fresh_vreg(ctx);
        var (ctx3, arr_r) = fresh_vreg(ctx2);
        n = vec_len(expr.children) >> int;
        cap = n;
        if cap < 16:
            cap = 16;
        end
        ctx3 = emit(ctx3, q_instr(QOp::Load, q_vreg(cap_r), q_imm(cap), q_none()));
        ctx3 = emit(ctx3, q_instr(QOp::ArrNew, q_vreg(arr_r), q_vreg(cap_r), q_none()));
        i = 0;
        when i < vec_len(expr.children) loop
            var (ctx4, elem) = lower_expr(ctx3, vec_get(expr.children, i));
            ctx3 = ctx4;
            if elem >= 0:
                ctx3 = emit(ctx3, q_instr(QOp::ArrPush, q_none(), q_vreg(arr_r), q_vreg(elem >> int)));
            end
            i = i + 1;
        end
        out (ctx3, arr_r >> int);
    end

    if expr.node_type == AstType::IndexAccess:
        var (scope, arr_idx) = sym_lookup_both(ctx, expr.name);
        if scope < 0:
            ctx = lower_error(ctx, str_new("undefined variable for index"));
            out (ctx, -1);
        end
        arr_vreg = arr_idx;
        if scope == 1:
            var (ctx2, gv) = fresh_vreg(ctx);
            ctx = ctx2;
            ctx = emit(ctx, q_instr(QOp::LoadGlobal, q_vreg(gv), q_imm(arr_idx >> int), q_none()));
            arr_vreg = gv;
        end
        var (ctx3, idx_v) = lower_expr(ctx, vec_get(expr.children, 0));
        if idx_v < 0:
            out (ctx3, -1);
        end
        var (ctx4, rd) = fresh_vreg(ctx3);
        ctx4 = emit(ctx4, q_instr(QOp::ArrGet, q_vreg(rd), q_vreg(arr_vreg), q_vreg(idx_v >> int)));
        out (ctx4, rd >> int);
    end

    if expr.node_type == AstType::FieldAccess:
        # Check for enum access first
        base = vec_get(expr.children, 0);
        if base.node_type == AstType::Identifier:
            var (found, eidx) = find_enum_type(ctx.enum_types, base.name);
            if found:
                et = vec_get(ctx.enum_types, eidx);
                var (ok, val) = enum_lookup_variant(et, expr.name);
                if ok:
                    var (ctx2, r) = fresh_vreg(ctx);
                    ctx2 = emit(ctx2, q_instr(QOp::Load, q_vreg(r), q_imm(val), q_none()));
                    out (ctx2, r >> int);
                end
                ctx = lower_error(ctx, str_concat(str_new("unknown variant: "), expr.name));
                out (ctx, -1);
            end
        end

        # Entity field access
        var (ctx2, base_r) = lower_expr(ctx, vec_get(expr.children, 0));
        if base_r < 0:
            out (ctx2, -1);
        end

        # Search entity types for field offset
        offset = -1;
        j = 0;
        when j < vec_len(ctx2.entity_types) and offset < 0 loop
            et = vec_get(ctx2.entity_types, j);
            var (ok, off) = entity_field_offset(et, expr.name);
            if ok:
                offset = off;
            end
            j = j + 1;
        end

        if offset < 0:
            ctx2 = lower_error(ctx2, str_concat(str_new("unknown field: "), expr.name));
            out (ctx2, -1);
        end

        var (ctx3, off_r) = fresh_vreg(ctx2);
        var (ctx4, rd) = fresh_vreg(ctx3);
        ctx4 = emit(ctx4, q_instr(QOp::Load, q_vreg(off_r), q_imm(offset >> int), q_none()));
        ctx4 = emit(ctx4, q_instr(QOp::LoadWord, q_vreg(rd), q_vreg(base_r >> int), q_vreg(off_r)));
        out (ctx4, rd >> int);
    end

    if expr.node_type == AstType::EntityLiteral:
        var (found, eidx) = find_entity_type(ctx.entity_types, expr.name);
        if not found:
            ctx = lower_error(ctx, str_concat(str_new("undefined entity: "), expr.name));
            out (ctx, -1);
        end
        et = vec_get(ctx.entity_types, eidx);
        var (ctx2, sz_r) = fresh_vreg(ctx);
        var (ctx3, ptr_r) = fresh_vreg(ctx2);
        sz = vec_len(et.fields) >> int * 8;
        ctx3 = emit(ctx3, q_instr(QOp::Load, q_vreg(sz_r), q_imm(sz), q_none()));
        ctx3 = emit(ctx3, q_instr(QOp::Alloc, q_vreg(ptr_r), q_vreg(sz_r), q_none()));

        i = 0;
        when i < vec_len(expr.children) loop
            child = vec_get(expr.children, i);
            var (ok, foff) = entity_field_offset(et, child.name2);
            if ok:
                var (ctx4, val_r) = lower_expr(ctx3, child);
                ctx3 = ctx4;
                if val_r >= 0:
                    var (ctx5, off_r) = fresh_vreg(ctx3);
                    ctx3 = ctx5;
                    ctx3 = emit(ctx3, q_instr(QOp::Load, q_vreg(off_r), q_imm(foff >> int), q_none()));
                    ctx3 = emit(ctx3, q_instr(QOp::StoreWord, q_vreg(val_r >> int), q_vreg(ptr_r), q_vreg(off_r)));
                end
            end
            i = i + 1;
        end
        out (ctx3, ptr_r >> int);
    end

    ctx = lower_error(ctx, str_new("unsupported expression type"));
    out (ctx, -1);
end


# ═══════════════════════════════════════════════════════
# Statement Lowering
# ═══════════════════════════════════════════════════════

func lower_stmt:
    in(ctx:LowerCtx; stmt:AstNode)

    if stmt.node_type == AstType::VarDecl or stmt.node_type == AstType::ConstDecl:
        var (ctx2, r) = fresh_vreg(ctx);
        ctx2.symbols = sym_define(ctx2.symbols, stmt.name, r);
        if vec_len(stmt.children) > 0:
            var (ctx3, val) = lower_expr(ctx2, vec_get(stmt.children, 0));
            if val >= 0 and (val as u32) != r:
                ctx3 = emit(ctx3, q_instr(QOp::Move, q_vreg(r), q_vreg(val >> int), q_none()));
            end
            out ctx3;
        else
            ctx2 = emit(ctx2, q_instr(QOp::Load, q_vreg(r), q_imm(0), q_none()));
            out ctx2;
        end
    end

    if stmt.node_type == AstType::Assign:
        var (scope, idx) = sym_lookup_both(ctx, stmt.name);
        if scope < 0:
            out lower_error(ctx, str_concat(str_new("assign to undefined: "), stmt.name));
        end
        var (ctx2, val) = lower_expr(ctx, vec_get(stmt.children, 0));
        if val < 0:
            out ctx2;
        end
        if scope == 1:
            ctx2 = emit(ctx2, q_instr(QOp::StoreGlobal, q_none(), q_imm(idx >> int), q_vreg(val >> int)));
        else
            if (val as u32) != idx:
                ctx2 = emit(ctx2, q_instr(QOp::Move, q_vreg(idx), q_vreg(val >> int), q_none()));
            end
        end
        out ctx2;
    end

    if stmt.node_type == AstType::IndexAssign:
        var (scope, arr_idx) = sym_lookup_both(ctx, stmt.name);
        if scope < 0:
            out lower_error(ctx, str_new("index assign to undefined variable"));
        end
        arr_vreg = arr_idx;
        if scope == 1:
            var (ctx2, gv) = fresh_vreg(ctx);
            ctx = ctx2;
            ctx = emit(ctx, q_instr(QOp::LoadGlobal, q_vreg(gv), q_imm(arr_idx >> int), q_none()));
            arr_vreg = gv;
        end
        var (ctx3, idx_v) = lower_expr(ctx, vec_get(stmt.children, 0));
        var (ctx4, val_v) = lower_expr(ctx3, vec_get(stmt.children, 1));
        if idx_v >= 0 and val_v >= 0:
            ctx4 = emit(ctx4, q_instr(QOp::ArrSet, q_vreg(val_v >> int), q_vreg(arr_vreg), q_vreg(idx_v >> int)));
        end
        out ctx4;
    end

    if stmt.node_type == AstType::PrintStmt:
        var (ctx2, val) = lower_expr(ctx, vec_get(stmt.children, 0));
        if val >= 0:
            ctx2 = emit(ctx2, q_instr(QOp::Print, q_none(), q_vreg(val >> int), q_none()));
        end
        out ctx2;
    end

    if stmt.node_type == AstType::ReturnStmt:
        if vec_len(stmt.children) > 0:
            var (ctx2, val) = lower_expr(ctx, vec_get(stmt.children, 0));
            if val >= 0:
                ctx2 = emit(ctx2, q_instr(QOp::Ret, q_none(), q_vreg(val >> int), q_none()));
            end
            out ctx2;
        else
            ctx = emit(ctx, q_instr(QOp::Ret, q_none(), q_none(), q_none()));
            out ctx;
        end
    end

    if stmt.node_type == AstType::IfStmt:
        var (ctx2, cond_r) = lower_expr(ctx, vec_get(stmt.children, 0));
        if cond_r < 0:
            out ctx2;
        end
        var (ctx3, else_lbl) = fresh_label(ctx2);
        var (ctx4, end_lbl) = fresh_label(ctx3);

        ctx4 = emit(ctx4, q_instr(QOp::JumpIfNot, q_none(), q_vreg(cond_r >> int), q_label(else_lbl)));

        # Then block
        ctx4 = lower_stmt(ctx4, vec_get(stmt.children, 1));

        if vec_len(stmt.children) > 2:
            ctx4 = emit(ctx4, q_instr(QOp::Jump, q_none(), q_label(end_lbl), q_none()));
        end

        # Else label
        lbl = q_instr(QOp::Label, q_none(), q_none(), q_none());
        lbl.patch_id = else_lbl;
        ctx4 = emit(ctx4, lbl);

        # Else block
        if vec_len(stmt.children) > 2:
            ctx4 = lower_stmt(ctx4, vec_get(stmt.children, 2));
            lbl.patch_id = end_lbl;
            ctx4 = emit(ctx4, lbl);
        end
        out ctx4;
    end

    if stmt.node_type == AstType::WhileStmt:
        var (ctx2, loop_lbl) = fresh_label(ctx);
        var (ctx3, end_lbl) = fresh_label(ctx2);

        lbl = q_instr(QOp::Label, q_none(), q_none(), q_none());
        lbl.patch_id = loop_lbl;
        ctx3 = emit(ctx3, lbl);

        var (ctx4, cond_r) = lower_expr(ctx3, vec_get(stmt.children, 0));
        if cond_r < 0:
            out ctx4;
        end
        ctx4 = emit(ctx4, q_instr(QOp::JumpIfNot, q_none(), q_vreg(cond_r >> int), q_label(end_lbl)));

        # Push loop labels
        vec_push(ctx4.loop_start_labels, loop_lbl);
        vec_push(ctx4.loop_end_labels, end_lbl);
        ctx4.loop_depth = ctx4.loop_depth + 1;

        ctx4 = lower_stmt(ctx4, vec_get(stmt.children, 1));

        ctx4.loop_depth = ctx4.loop_depth - 1;

        ctx4 = emit(ctx4, q_instr(QOp::Jump, q_none(), q_label(loop_lbl), q_none()));

        lbl.patch_id = end_lbl;
        ctx4 = emit(ctx4, lbl);
        out ctx4;
    end

    if stmt.node_type == AstType::LoopStmt:
        # Counter-based loop
        var (ctx2, counter) = fresh_vreg(ctx);
        ctx2 = emit(ctx2, q_instr(QOp::Load, q_vreg(counter), q_imm(0), q_none()));

        var (ctx3, limit_r) = lower_expr(ctx2, vec_get(stmt.children, 0));
        if limit_r < 0:
            out ctx3;
        end

        var (ctx4, loop_lbl) = fresh_label(ctx3);
        var (ctx5, cont_lbl) = fresh_label(ctx4);
        var (ctx6, end_lbl) = fresh_label(ctx5);

        lbl = q_instr(QOp::Label, q_none(), q_none(), q_none());
        lbl.patch_id = loop_lbl;
        ctx6 = emit(ctx6, lbl);

        var (ctx7, cmp_r) = fresh_vreg(ctx6);
        ctx7 = emit(ctx7, q_instr(QOp::CmpLt, q_vreg(cmp_r), q_vreg(counter), q_vreg(limit_r >> int)));
        ctx7 = emit(ctx7, q_instr(QOp::JumpIfNot, q_none(), q_vreg(cmp_r), q_label(end_lbl)));

        vec_push(ctx7.loop_start_labels, cont_lbl);
        vec_push(ctx7.loop_end_labels, end_lbl);
        ctx7.loop_depth = ctx7.loop_depth + 1;

        ctx7 = lower_stmt(ctx7, vec_get(stmt.children, 1));

        ctx7.loop_depth = ctx7.loop_depth - 1;

        lbl.patch_id = cont_lbl;
        ctx7 = emit(ctx7, lbl);
        var (ctx8, one_r) = fresh_vreg(ctx7);
        ctx8 = emit(ctx8, q_instr(QOp::Load, q_vreg(one_r), q_imm(1), q_none()));
        ctx8 = emit(ctx8, q_instr(QOp::Add, q_vreg(counter), q_vreg(counter), q_vreg(one_r)));
        ctx8 = emit(ctx8, q_instr(QOp::Jump, q_none(), q_label(loop_lbl), q_none()));

        lbl.patch_id = end_lbl;
        ctx8 = emit(ctx8, lbl);
        out ctx8;
    end

    if stmt.node_type == AstType::ForRange:
        var (ctx2, start_v) = lower_expr(ctx, vec_get(stmt.children, 0));
        if start_v < 0:
            out ctx2;
        end
        var (ctx3, end_v) = lower_expr(ctx2, vec_get(stmt.children, 1));
        if end_v < 0:
            out ctx3;
        end

        var (ctx4, loop_var) = fresh_vreg(ctx3);
        ctx4.symbols = sym_define(ctx4.symbols, stmt.name, loop_var);
        ctx4 = emit(ctx4, q_instr(QOp::Move, q_vreg(loop_var), q_vreg(start_v >> int), q_none()));

        var (ctx5, loop_lbl) = fresh_label(ctx4);
        var (ctx6, end_lbl) = fresh_label(ctx5);
        var (ctx7, cont_lbl) = fresh_label(ctx6);

        lbl = q_instr(QOp::Label, q_none(), q_none(), q_none());
        lbl.patch_id = loop_lbl;
        ctx7 = emit(ctx7, lbl);

        var (ctx8, cmp_r) = fresh_vreg(ctx7);
        ctx8 = emit(ctx8, q_instr(QOp::CmpLt, q_vreg(cmp_r), q_vreg(loop_var), q_vreg(end_v >> int)));
        ctx8 = emit(ctx8, q_instr(QOp::JumpIfNot, q_none(), q_vreg(cmp_r), q_label(end_lbl)));

        vec_push(ctx8.loop_start_labels, cont_lbl);
        vec_push(ctx8.loop_end_labels, end_lbl);
        ctx8.loop_depth = ctx8.loop_depth + 1;

        ctx8 = lower_stmt(ctx8, vec_get(stmt.children, 2));

        ctx8.loop_depth = ctx8.loop_depth - 1;

        lbl.patch_id = cont_lbl;
        ctx8 = emit(ctx8, lbl);
        var (ctx9, one_r) = fresh_vreg(ctx8);
        ctx9 = emit(ctx9, q_instr(QOp::Load, q_vreg(one_r), q_imm(1), q_none()));
        ctx9 = emit(ctx9, q_instr(QOp::Add, q_vreg(loop_var), q_vreg(loop_var), q_vreg(one_r)));
        ctx9 = emit(ctx9, q_instr(QOp::Jump, q_none(), q_label(loop_lbl), q_none()));

        lbl.patch_id = end_lbl;
        ctx9 = emit(ctx9, lbl);
        out ctx9;
    end

    if stmt.node_type == AstType::Block:
        i = 0;
        when i < vec_len(stmt.children) loop
            ctx = lower_stmt(ctx, vec_get(stmt.children, i));
            i = i + 1;
        end
        out ctx;
    end

    if stmt.node_type == AstType::BreakStmt:
        if ctx.loop_depth == 0:
            out lower_error(ctx, str_new("break outside of loop"));
        end
        end_lbl = vec_get(ctx.loop_end_labels, (ctx.loop_depth - 1) >> int);
        ctx = emit(ctx, q_instr(QOp::Jump, q_none(), q_label(end_lbl), q_none()));
        out ctx;
    end

    if stmt.node_type == AstType::ContinueStmt:
        if ctx.loop_depth == 0:
            out lower_error(ctx, str_new("continue outside of loop"));
        end
        start_lbl = vec_get(ctx.loop_start_labels, (ctx.loop_depth - 1) >> int);
        ctx = emit(ctx, q_instr(QOp::Jump, q_none(), q_label(start_lbl), q_none()));
        out ctx;
    end

    if stmt.node_type == AstType::EnumDef:
        et = EnumType { name: stmt.name, variants: vec_new<EnumVariant>() };
        i = 0;
        when i < vec_len(stmt.children) loop
            v = vec_get(stmt.children, i);
            vec_push(et.variants, EnumVariant { name: v.name, value: v.int_val });
            i = i + 1;
        end
        vec_push(ctx.enum_types, et);
        out ctx;
    end

    if stmt.node_type == AstType::EntityDef:
        et = EntityType { name: stmt.name, fields: vec_new<EntityField>() };
        i = 0;
        when i < vec_len(stmt.children) loop
            f = vec_get(stmt.children, i);
            vec_push(et.fields, EntityField { name: f.name, offset: i >> int });
            i = i + 1;
        end
        vec_push(ctx.entity_types, et);
        out ctx;
    end

    if stmt.node_type == AstType::FieldAssign:
        var (scope, idx) = sym_lookup_both(ctx, stmt.name);
        if scope < 0:
            out lower_error(ctx, str_concat(str_new("field assign to undefined: "), stmt.name));
        end
        base_vreg = idx;
        if scope == 1:
            var (ctx2, gv) = fresh_vreg(ctx);
            ctx = ctx2;
            ctx = emit(ctx, q_instr(QOp::LoadGlobal, q_vreg(gv), q_imm(idx >> int), q_none()));
            base_vreg = gv;
        end

        # Find field offset across all entity types
        offset = -1;
        j = 0;
        when j < vec_len(ctx.entity_types) and offset < 0 loop
            et = vec_get(ctx.entity_types, j);
            var (ok, off) = entity_field_offset(et, stmt.name2);
            if ok:
                offset = off;
            end
            j = j + 1;
        end
        if offset < 0:
            out lower_error(ctx, str_concat(str_new("unknown field: "), stmt.name2));
        end

        var (ctx3, val_r) = lower_expr(ctx, vec_get(stmt.children, 0));
        if val_r < 0:
            out ctx3;
        end
        var (ctx4, off_r) = fresh_vreg(ctx3);
        ctx4 = emit(ctx4, q_instr(QOp::Load, q_vreg(off_r), q_imm(offset >> int), q_none()));
        ctx4 = emit(ctx4, q_instr(QOp::StoreWord, q_vreg(val_r >> int), q_vreg(base_vreg), q_vreg(off_r)));
        out ctx4;
    end

    if stmt.node_type == AstType::CheckCpu or stmt.node_type == AstType::PatchPoint:
        ctx.patch_counter = ctx.patch_counter + 1;
        pp = q_instr(QOp::PatchPoint, q_none(), q_none(), q_none());
        pp.patch_id = ctx.patch_counter;
        ctx = emit(ctx, pp);
        out ctx;
    end

    # Module system (compile-time only)
    if stmt.node_type == AstType::ImportStmt or:
       stmt.node_type == AstType::ModuleStmt or;
       stmt.node_type == AstType::ExportStmt or;
       stmt.node_type == AstType::IncludeStmt;
        out ctx;
    end

    # Default: try as expression statement
    var (ctx2, _) = lower_expr(ctx, stmt);
    out ctx2;
end


# ═══════════════════════════════════════════════════════
# Function Lowering
# ═══════════════════════════════════════════════════════

func lower_func_def:
    in(ctx:LowerCtx; func_def:AstNode)
    var (ctx2, fidx) = q_module_add_func(ctx.module, func_def.name);
    ctx.module = ctx2;
    ctx.current_func_idx = fidx;

    # Save local scope
    saved_syms = ctx.symbols;
    ctx.symbols = sym_new();

    # Register parameters
    body_idx = vec_len(func_def.children) - 1;
    i = 0;
    when i < body_idx loop
        param = vec_get(func_def.children, i);
        if param.node_type == AstType::Identifier:
            var (ctx3, pr) = fresh_vreg(ctx);
            ctx = ctx3;
            ctx.symbols = sym_define(ctx.symbols, param.name, pr);
        end
        i = i + 1;
    end

    # Lower body
    if vec_len(func_def.children) > 0:
        ctx = lower_stmt(ctx, vec_get(func_def.children, body_idx));
    end

    # Restore scope
    ctx.symbols = saved_syms;
    ctx.current_func_idx = -1;
    out ctx;
end


# ═══════════════════════════════════════════════════════
# Program Lowering
# ═══════════════════════════════════════════════════════

func lower_program:
    in(ctx:LowerCtx; program:AstNode)
    # Pass 0: register enum/entity types
    i = 0;
    when i < vec_len(program.children) loop
        child = vec_get(program.children, i);
        if child.node_type == AstType::EnumDef or child.node_type == AstType::EntityDef:
            ctx = lower_stmt(ctx, child);
        end
        i = i + 1;
    end

    # Pass 1: register function names for forward references
    has_main = false;
    has_top_stmt = false;
    i = 0;
    when i < vec_len(program.children) loop
        child = vec_get(program.children, i);
        if child.node_type == AstType::FuncDef:
            var (mod2, _) = q_module_add_func(ctx.module, child.name);
            ctx.module = mod2;
            if rt_streq(child.name, "main"):
                has_main = true;
            end
        else
            if not is_metadata(child.node_type):
                has_top_stmt = true;
            end
        end
        i = i + 1;
    end

    # Pass 2: lower function bodies and top-level code
    if not has_main and has_top_stmt:
        var (mod3, main_idx) = q_module_add_func(ctx.module, str_new("__main__"));
        ctx.module = mod3;
        ctx.current_func_idx = main_idx;

        i = 0;
        when i < vec_len(program.children) loop
            child = vec_get(program.children, i);
            if child.node_type != AstType::FuncDef:
                ctx = lower_stmt(ctx, child);
            end
            i = i + 1;
        end

        # Implicit return 0
        var (ctx2, rz) = fresh_vreg(ctx);
        ctx = ctx2;
        ctx = emit(ctx, q_instr(QOp::Load, q_vreg(rz), q_imm(0), q_none()));
        ctx = emit(ctx, q_instr(QOp::Ret, q_none(), q_vreg(rz), q_none()));
        ctx.current_func_idx = -1;
    end

    # Lower all function definitions
    i = 0;
    when i < vec_len(program.children) loop
        child = vec_get(program.children, i);
        if child.node_type == AstType::FuncDef:
            ctx = lower_func_def(ctx, child);
        end
        i = i + 1;
    end

    out ctx;
end


func is_metadata:
    in(t:AstType)
    out t == AstType::EnumDef or t == AstType::EntityDef or;
        t == AstType::ModuleStmt or t == AstType::ImportStmt or;
        t == AstType::ExportStmt or t == AstType::IncludeStmt;
end


# ═══════════════════════════════════════════════════════
# Liveness Analysis
# ═══════════════════════════════════════════════════════

entity LiveInterval:
    vreg:       int;
    start:      int;
    end_pos:    int;
    phys_reg:   int;
    spill_slot: int;
end

func compute_liveness:
    in(func:QFunction)
    intervals = vec_new<LiveInterval>();

    i = 0;
    when i < vec_len(func.body) loop
        instr = vec_get(func.body, i);

        # Definition (dest)
        if instr.dest.op_type == OperandType::VReg:
            iv = find_or_create_interval(intervals, instr.dest.vreg);
            intervals = iv.0;
            idx = iv.1;
            interval = vec_get(intervals, idx);
            if (i as u32) < interval.start:
                interval.start = i >> int;
            end
            if (i as u32) > interval.end_pos:
                interval.end_pos = i >> int;
            end
            vec_set(intervals, idx, interval);
        end

        # Use (src1)
        if instr.src1.op_type == OperandType::VReg:
            iv = find_or_create_interval(intervals, instr.src1.vreg);
            intervals = iv.0;
            idx = iv.1;
            interval = vec_get(intervals, idx);
            if (i as u32) < interval.start:
                interval.start = i >> int;
            end
            if (i as u32) > interval.end_pos:
                interval.end_pos = i >> int;
            end
            vec_set(intervals, idx, interval);
        end

        # Use (src2)
        if instr.src2.op_type == OperandType::VReg:
            iv = find_or_create_interval(intervals, instr.src2.vreg);
            intervals = iv.0;
            idx = iv.1;
            interval = vec_get(intervals, idx);
            if (i as u32) < interval.start:
                interval.start = i >> int;
            end
            if (i as u32) > interval.end_pos:
                interval.end_pos = i >> int;
            end
            vec_set(intervals, idx, interval);
        end

        i = i + 1;
    end
    out intervals;
end


func find_or_create_interval:
    in(intervals:Vec<LiveInterval>; vreg:int)
    i = 0;
    when i < vec_len(intervals) loop
        iv = vec_get(intervals, i);
        if iv.vreg == vreg:
            out (intervals, i);
        end
        i = i + 1;
    end
    vec_push(intervals, LiveInterval {;
        vreg:       vreg,;
        start:      0xFFFFFFFF >> int,;
        end_pos:    0,;
        phys_reg:   -1,;
        spill_slot: -1;
    });
    out (intervals, vec_len(intervals) - 1);
end


# ═══════════════════════════════════════════════════════
# Linear-Scan Register Allocation
# ═══════════════════════════════════════════════════════

func regalloc_linear_scan:
    in(intervals:Vec<LiveInterval>; num_phys_regs:int)
    if num_phys_regs == 0 or vec_len(intervals) == 0:
        out intervals;
    end

    # Sort by start position (bubble sort — simple for correctness)
    n = vec_len(intervals);
    s = 0;
    when s < n - 1 loop
        t = 0;
        when t < n - s - 1 loop
            a = vec_get(intervals, t);
            b = vec_get(intervals, t + 1);
            if a.start > b.start:
                vec_set(intervals, t, b);
                vec_set(intervals, t + 1, a);
            end
            t = t + 1;
        end
        s = s + 1;
    end

    # Free register pool (bit-set, max 32 regs)
    max_regs = num_phys_regs;
    if max_regs > 32:
        max_regs = 32;
    end
    free_mask = (1 << max_regs) - 1;

    # Active list (indices into intervals)
    active = vec_new<int>();
    next_spill = 0;

    i = 0;
    when i < n loop
        cur = vec_get(intervals, i);

        # Expire finished intervals
        new_active = vec_new<int>();
        a = 0;
        when a < vec_len(active) loop
            aidx = vec_get(active, a);
            act = vec_get(intervals, aidx);
            if act.end_pos < cur.start:
                # Release register
                if act.phys_reg >= 0:
                    free_mask = free_mask or (1 << (act.phys_reg >> int));
                end
            else
                vec_push(new_active, aidx);
            end
            a = a + 1;
        end
        active = new_active;

        # Try to allocate a free register
        if free_mask != 0:
            # Find lowest set bit
            bit = 0;
            tmp = free_mask;
            when (tmp and 1) == 0 loop
                bit = bit + 1;
                tmp = tmp >> 1;
            end

            cur.phys_reg = bit >> int;
            free_mask = free_mask and (not (1 << bit));
            vec_set(intervals, i, cur);

            # Insert into active (sorted by end)
            pos = vec_len(active);
            k = 0;
            when k < vec_len(active) loop
                aidx = vec_get(active, k);
                act = vec_get(intervals, aidx);
                if act.end_pos > cur.end_pos:
                    pos = k;
                    k = vec_len(active)  # break;
                end
                k = k + 1;
            end
            # Insert at pos
            vec_push(active, i)  # placeholder;
            j = vec_len(active) - 1;
            when j > pos loop
                vec_set(active, j, vec_get(active, j - 1));
                j = j - 1;
            end
            vec_set(active, pos, i);
        else
            # Spill
            if vec_len(active) > 0:
                last_idx = vec_get(active, vec_len(active) - 1);
                spill_cand = vec_get(intervals, last_idx);
                if spill_cand.end_pos > cur.end_pos:
                    cur.phys_reg = spill_cand.phys_reg;
                    spill_cand.phys_reg = -1;
                    spill_cand.spill_slot = next_spill;
                    next_spill = next_spill + 1;
                    vec_set(intervals, last_idx, spill_cand);
                    vec_set(intervals, i, cur);
                    # Remove last from active
                    new_active2 = vec_new<int>();
                    k = 0;
                    when k < vec_len(active) - 1 loop
                        vec_push(new_active2, vec_get(active, k));
                        k = k + 1;
                    end
                    active = new_active2;
                    # Insert current
                    vec_push(active, i);
                else
                    cur.phys_reg = -1;
                    cur.spill_slot = next_spill;
                    next_spill = next_spill + 1;
                    vec_set(intervals, i, cur);
                end
            else
                cur.phys_reg = -1;
                cur.spill_slot = next_spill;
                next_spill = next_spill + 1;
                vec_set(intervals, i, cur);
            end
        end

        i = i + 1;
    end

    out intervals;
end


# ═══════════════════════════════════════════════════════
# Tail-Call Optimization
# ═══════════════════════════════════════════════════════

func tco_pass:
    in(func:QFunction)
    tco_count = 0;
    body_len = vec_len(func.body);
    if body_len < 2:
        out (func, 0);
    end

    i = 0;
    when i + 1 < body_len loop
        cur = vec_get(func.body, i);
        next_instr = vec_get(func.body, i + 1);

        # Pattern: CALL followed by RET
        if cur.opcode == QOp::Call and next_instr.opcode == QOp::Ret:
            cur.opcode = QOp::Jump;
            cur.dest = q_none();
            cur.src2 = q_none();
            vec_set(func.body, i, cur);

            next_instr.opcode = QOp::Nop;
            next_instr.dest = q_none();
            next_instr.src1 = q_none();
            next_instr.src2 = q_none();
            vec_set(func.body, i + 1, next_instr);

            tco_count = tco_count + 1;
            i = i + 2;
        else
            i = i + 1;
        end
    end
    out (func, tco_count);
end


# ═══════════════════════════════════════════════════════
# Get Physical Register for a VReg
# ═══════════════════════════════════════════════════════

func get_phys_reg:
    in(intervals:Vec<LiveInterval>; vreg:int)
    i = 0;
    when i < vec_len(intervals) loop
        iv = vec_get(intervals, i);
        if iv.vreg == vreg:
            out iv.phys_reg;
        end
        i = i + 1;
    end
    out -1;
end

func optimize_module:
    in(m:QModule)
    # Temporary no-op optimizer for self-host bootstrap.
    out m, 0, 0, 0;
end

# ═══ END: stdlib/vir/compiler/ir_optimizer.vri ═══

# [merged] import LowerCtx, QModule, QOp, lower_ctx_new, lower_program, optimize_module from ir_optimizer;
# [merged] include vir::compiler::codegen;
# ═══ BEGIN: stdlib/vir/compiler/codegen.vri ═══
##
 * vir/compiler/codegen.vri — Machine Code Generator (Pure Vir)
 * =============================================================
 * Translated from core/src/codegen.c (3408 lines).
 *
 * Emits real machine code bytes into a code buffer.
 * Supports x86_64 and ARM64 targets with:
 *   - Code buffer (growable byte array)
 *   - x86_64 instruction encoding (REX, ModR/M, VEX)
 *   - ARM64 instruction encoding (32-bit fixed-width)
 *   - NEON / AVX SIMD emitters
 *   - Back-patching for branch offsets
 *   - Safe (stack-based), Fast (register-direct), Full generators
 *   - Intrinsic call dispatch
 ##

# [merged] module vir::compiler::codegen;

# [merged] include types;

# ═══════════════════════════════════════════════════════
# Architecture Detection
# ═══════════════════════════════════════════════════════

enum TargetArch:
    Unknown = 0;
    X86_64  = 1;
    ARM64   = 2;
    Wasm32  = 3;
end

func detect_arch:
    # Compile-time constant based on host
    # On ARM64 macOS, this returns ARM64
    out TargetArch::ARM64;
end

# ═══════════════════════════════════════════════════════
# x86_64 Register IDs
# ═══════════════════════════════════════════════════════

enum X86Reg:
    RAX = 0;
    RCX = 1;
    RDX = 2;
    RBX = 3;
    RSP = 4;
    RBP = 5;
    RSI = 6;
    RDI = 7;
    R8  = 8;
    R9  = 9;
    R10 = 10;
    R11 = 11;
    R12 = 12;
    R13 = 13;
    R14 = 14;
    R15 = 15;
end

# ═══════════════════════════════════════════════════════
# ARM64 Register IDs
# ═══════════════════════════════════════════════════════

enum ArmReg:
    X0  = 0;
    X1  = 1;
    X2  = 2;
    X3  = 3;
    X4  = 4;
    X5  = 5;
    X6  = 6;
    X7  = 7;
    X8  = 8;
    X9  = 9;
    X10 = 10;
    X11 = 11;
    X12 = 12;
    X13 = 13;
    X14 = 14;
    X15 = 15;
    X16 = 16;
    X17 = 17;
    X29 = 29   # FP;
    X30 = 30   # LR;
    SP  = 31;
end

# ═══════════════════════════════════════════════════════
# Code Buffer — growable byte array
# ═══════════════════════════════════════════════════════

const CODEBUF_INIT_CAP = 4096;

entity CodeBuf:
    data:         [int]    # byte values stored as int (0-255);
    len:          int;
    cap:          int;
    arch:         TargetArch;
    start_offset: int;
end

func codebuf_new:
    in(arch:TargetArch)
    buf = CodeBuf {;
        data: [],;
        len:  0,;
        cap:  CODEBUF_INIT_CAP,;
        arch: arch,;
        start_offset: 0;
    };
    out buf;
end

func codebuf_emit_byte:
    in(buf:CodeBuf; byte:int)
    buf.data = buf.data + [byte & 0xFF];
    buf.len = buf.len + 1;
    out buf;
end

func codebuf_emit_u32:
    in(buf:CodeBuf; val:int)
    buf = codebuf_emit_byte(buf, val & 0xFF);
    buf = codebuf_emit_byte(buf, (val >> 8) & 0xFF);
    buf = codebuf_emit_byte(buf, (val >> 16) & 0xFF);
    buf = codebuf_emit_byte(buf, (val >> 24) & 0xFF);
    out buf;
end

func codebuf_emit_u64:
    in(buf:CodeBuf; val:int)
    buf = codebuf_emit_u32(buf, val & 0xFFFFFFFF);
    buf = codebuf_emit_u32(buf, (val >> 32) & 0xFFFFFFFF);
    out buf;
end

func codebuf_emit_i32:
    in(buf:CodeBuf; val:int)
    out codebuf_emit_u32(buf, val);
end

func codebuf_offset:
    in(buf:CodeBuf)
    out buf.len;
end

func codebuf_get_data:
    in(buf:CodeBuf; idx:int)
    if idx < 0 or idx >= buf.len:
        out 0;
    end
    out buf.data[idx];
end

func codebuf_patch_i32:
    in(buf:CodeBuf; offset:int; val:int)
    if offset + 4 <= buf.len:
        buf.data[offset]     = val & 0xFF;
        buf.data[offset + 1] = (val >> 8) & 0xFF;
        buf.data[offset + 2] = (val >> 16) & 0xFF;
        buf.data[offset + 3] = (val >> 24) & 0xFF;
    end
    out buf;
end

func codebuf_patch_u32:
    in(buf:CodeBuf; offset:int; val:int)
    out codebuf_patch_i32(buf, offset, val);
end

# ═══════════════════════════════════════════════════════
# x86_64 Encoding Helpers
# ═══════════════════════════════════════════════════════

func rex_w:
    in(r:int; rm:int)
    rex = 0x48;
    if r >= 8:
        rex = rex | 0x04;
    end
    if rm >= 8:
        rex = rex | 0x01;
    end
    out rex;
end

func modrm:
    in(mod_:int; reg:int; rm:int)
    out (mod_ << 6) | ((reg & 7) << 3) | (rm & 7);
end

# ═══════════════════════════════════════════════════════
# x86_64 Instruction Emitters
# ═══════════════════════════════════════════════════════

func x86_add_rr:
    in(cb:CodeBuf; dst:int; src:int)
    # ADD dst, src -> REX.W 01 /r
    cb = codebuf_emit_byte(cb, rex_w(src, dst));
    cb = codebuf_emit_byte(cb, 0x01);
    cb = codebuf_emit_byte(cb, modrm(0x03, src, dst));
    out cb;
end

func x86_sub_rr:
    in(cb:CodeBuf; dst:int; src:int)
    # SUB dst, src -> REX.W 29 /r
    cb = codebuf_emit_byte(cb, rex_w(src, dst));
    cb = codebuf_emit_byte(cb, 0x29);
    cb = codebuf_emit_byte(cb, modrm(0x03, src, dst));
    out cb;
end

func x86_imul_rr:
    in(cb:CodeBuf; dst:int; src:int)
    # IMUL dst, src -> REX.W 0F AF /r
    cb = codebuf_emit_byte(cb, rex_w(dst, src));
    cb = codebuf_emit_byte(cb, 0x0F);
    cb = codebuf_emit_byte(cb, 0xAF);
    cb = codebuf_emit_byte(cb, modrm(0x03, dst, src));
    out cb;
end

func x86_mov_reg_imm64:
    in(cb:CodeBuf; dst:int; imm:int)
    # MOV dst, imm64 -> REX.W B8+rd [8 bytes]
    rex = 0x48;
    if dst >= 8:
        rex = rex | 0x01;
    end
    cb = codebuf_emit_byte(cb, rex);
    cb = codebuf_emit_byte(cb, 0xB8 + (dst & 7));
    cb = codebuf_emit_u64(cb, imm);
    out cb;
end

func x86_mov_reg_imm32:
    in(cb:CodeBuf; dst:int; imm:int)
    # MOV dst, imm32 -> REX.W C7 /0 [4 bytes]
    rex = 0x48;
    if dst >= 8:
        rex = rex | 0x01;
    end
    cb = codebuf_emit_byte(cb, rex);
    cb = codebuf_emit_byte(cb, 0xC7);
    cb = codebuf_emit_byte(cb, modrm(0x03, 0, dst));
    cb = codebuf_emit_i32(cb, imm);
    out cb;
end

func x86_mov_rr:
    in(cb:CodeBuf; dst:int; src:int)
    # MOV dst, src -> REX.W 89 /r
    cb = codebuf_emit_byte(cb, rex_w(src, dst));
    cb = codebuf_emit_byte(cb, 0x89);
    cb = codebuf_emit_byte(cb, modrm(0x03, src, dst));
    out cb;
end

func x86_push:
    in(cb:CodeBuf; reg:int)
    if reg >= 8:
        cb = codebuf_emit_byte(cb, 0x41);
    end
    cb = codebuf_emit_byte(cb, 0x50 + (reg & 7));
    out cb;
end

func x86_pop:
    in(cb:CodeBuf; reg:int)
    if reg >= 8:
        cb = codebuf_emit_byte(cb, 0x41);
    end
    cb = codebuf_emit_byte(cb, 0x58 + (reg & 7));
    out cb;
end

func x86_ret:
    in(cb:CodeBuf)
    out codebuf_emit_byte(cb, 0xC3);
end

func x86_nop:
    in(cb:CodeBuf)
    out codebuf_emit_byte(cb, 0x90);
end

func x86_jmp_rel32:
    in(cb:CodeBuf; offset:int)
    cb = codebuf_emit_byte(cb, 0xE9);
    cb = codebuf_emit_i32(cb, offset);
    out cb;
end

func x86_call_rel32:
    in(cb:CodeBuf; offset:int)
    cb = codebuf_emit_byte(cb, 0xE8);
    cb = codebuf_emit_i32(cb, offset);
    out cb;
end

func x86_cmp_rr:
    in(cb:CodeBuf; a:int; b:int)
    # CMP a, b -> REX.W 39 /r
    cb = codebuf_emit_byte(cb, rex_w(b, a));
    cb = codebuf_emit_byte(cb, 0x39);
    cb = codebuf_emit_byte(cb, modrm(0x03, b, a));
    out cb;
end

func x86_sete:
    in(cb:CodeBuf; dst:int)
    if dst >= 8:
        cb = codebuf_emit_byte(cb, 0x41);
    end
    cb = codebuf_emit_byte(cb, 0x0F);
    cb = codebuf_emit_byte(cb, 0x94);
    cb = codebuf_emit_byte(cb, modrm(0x03, 0, dst));
    out cb;
end

func x86_setg:
    in(cb:CodeBuf; dst:int)
    if dst >= 8:
        cb = codebuf_emit_byte(cb, 0x41);
    end
    cb = codebuf_emit_byte(cb, 0x0F);
    cb = codebuf_emit_byte(cb, 0x9F);
    cb = codebuf_emit_byte(cb, modrm(0x03, 0, dst));
    out cb;
end

func x86_setl:
    in(cb:CodeBuf; dst:int)
    if dst >= 8:
        cb = codebuf_emit_byte(cb, 0x41);
    end
    cb = codebuf_emit_byte(cb, 0x0F);
    cb = codebuf_emit_byte(cb, 0x9C);
    cb = codebuf_emit_byte(cb, modrm(0x03, 0, dst));
    out cb;
end

func x86_setge:
    in(cb:CodeBuf; dst:int)
    if dst >= 8:
        cb = codebuf_emit_byte(cb, 0x41);
    end
    cb = codebuf_emit_byte(cb, 0x0F);
    cb = codebuf_emit_byte(cb, 0x9D);
    cb = codebuf_emit_byte(cb, modrm(0x03, 0, dst));
    out cb;
end

func x86_setle:
    in(cb:CodeBuf; dst:int)
    if dst >= 8:
        cb = codebuf_emit_byte(cb, 0x41);
    end
    cb = codebuf_emit_byte(cb, 0x0F);
    cb = codebuf_emit_byte(cb, 0x9E);
    cb = codebuf_emit_byte(cb, modrm(0x03, 0, dst));
    out cb;
end

func x86_je_rel32:
    in(cb:CodeBuf; offset:int)
    cb = codebuf_emit_byte(cb, 0x0F);
    cb = codebuf_emit_byte(cb, 0x84);
    cb = codebuf_emit_i32(cb, offset);
    out cb;
end

func x86_jne_rel32:
    in(cb:CodeBuf; offset:int)
    cb = codebuf_emit_byte(cb, 0x0F);
    cb = codebuf_emit_byte(cb, 0x85);
    cb = codebuf_emit_i32(cb, offset);
    out cb;
end

func x86_xor_rr:
    in(cb:CodeBuf; dst:int; src:int)
    cb = codebuf_emit_byte(cb, rex_w(src, dst));
    cb = codebuf_emit_byte(cb, 0x31);
    cb = codebuf_emit_byte(cb, modrm(0x03, src, dst));
    out cb;
end

func x86_and_rr:
    in(cb:CodeBuf; dst:int; src:int)
    # AND dst, src -> REX.W 21 /r
    cb = codebuf_emit_byte(cb, rex_w(src, dst));
    cb = codebuf_emit_byte(cb, 0x21);
    cb = codebuf_emit_byte(cb, modrm(0x03, src, dst));
    out cb;
end

func x86_or_rr:
    in(cb:CodeBuf; dst:int; src:int)
    # OR dst, src -> REX.W 09 /r
    cb = codebuf_emit_byte(cb, rex_w(src, dst));
    cb = codebuf_emit_byte(cb, 0x09);
    cb = codebuf_emit_byte(cb, modrm(0x03, src, dst));
    out cb;
end

func x86_shl_cl:
    in(cb:CodeBuf; dst:int)
    # SHL dst, CL -> REX.W D3 /4
    r = 0x48;
    if dst >= 8:
        r = r | 0x01;
    end
    cb = codebuf_emit_byte(cb, r);
    cb = codebuf_emit_byte(cb, 0xD3);
    cb = codebuf_emit_byte(cb, modrm(0x03, 4, dst));
    out cb;
end

func x86_sar_cl:
    in(cb:CodeBuf; dst:int)
    # SAR dst, CL -> REX.W D3 /7
    r = 0x48;
    if dst >= 8:
        r = r | 0x01;
    end
    cb = codebuf_emit_byte(cb, r);
    cb = codebuf_emit_byte(cb, 0xD3);
    cb = codebuf_emit_byte(cb, modrm(0x03, 7, dst));
    out cb;
end

func x86_idiv:
    in(cb:CodeBuf; divisor:int)
    # IDIV divisor -> REX.W F7 /7
    rex = 0x48;
    if divisor >= 8:
        rex = rex | 0x01;
    end
    cb = codebuf_emit_byte(cb, rex);
    cb = codebuf_emit_byte(cb, 0xF7);
    cb = codebuf_emit_byte(cb, modrm(0x03, 7, divisor));
    out cb;
end

func x86_cqo:
    in(cb:CodeBuf)
    # CQO -> 48 99
    cb = codebuf_emit_byte(cb, 0x48);
    cb = codebuf_emit_byte(cb, 0x99);
    out cb;
end

func x86_syscall:
    in(cb:CodeBuf)
    cb = codebuf_emit_byte(cb, 0x0F);
    cb = codebuf_emit_byte(cb, 0x05);
    out cb;
end

func x86_test_rr:
    in(cb:CodeBuf; r:int)
    # TEST r, r -> REX.W 85 /r (same reg)
    cb = codebuf_emit_byte(cb, rex_w(r, r));
    cb = codebuf_emit_byte(cb, 0x85);
    cb = codebuf_emit_byte(cb, modrm(0x03, r, r));
    out cb;
end

# ═══════════════════════════════════════════════════════
# x86_64 VEX prefix (2-byte form for AVX)
# ═══════════════════════════════════════════════════════

func x86_vex2:
    in(cb:CodeBuf; vvvv:int; l:int; pp:int)
    # C5 [R/vvvv/L/pp] — R=1 for XMM0-7
    byte2 = 0x80 | (((~vvvv) & 0x0F) << 3) | ((l & 1) << 2) | (pp & 3);
    cb = codebuf_emit_byte(cb, 0xC5);
    cb = codebuf_emit_byte(cb, byte2);
    out cb;
end

func avx_vaddps:
    in(cb:CodeBuf; dst:int; s1:int; s2:int)
    cb = x86_vex2(cb, s1, 0, 0);
    cb = codebuf_emit_byte(cb, 0x58);
    cb = codebuf_emit_byte(cb, 0xC0 | ((dst & 7) << 3) | (s2 & 7));
    out cb;
end

func avx_vsubps:
    in(cb:CodeBuf; dst:int; s1:int; s2:int)
    cb = x86_vex2(cb, s1, 0, 0);
    cb = codebuf_emit_byte(cb, 0x5C);
    cb = codebuf_emit_byte(cb, 0xC0 | ((dst & 7) << 3) | (s2 & 7));
    out cb;
end

func avx_vmulps:
    in(cb:CodeBuf; dst:int; s1:int; s2:int)
    cb = x86_vex2(cb, s1, 0, 0);
    cb = codebuf_emit_byte(cb, 0x59);
    cb = codebuf_emit_byte(cb, 0xC0 | ((dst & 7) << 3) | (s2 & 7));
    out cb;
end

func avx_vdivps:
    in(cb:CodeBuf; dst:int; s1:int; s2:int)
    cb = x86_vex2(cb, s1, 0, 0);
    cb = codebuf_emit_byte(cb, 0x5E);
    cb = codebuf_emit_byte(cb, 0xC0 | ((dst & 7) << 3) | (s2 & 7));
    out cb;
end

func avx_vminps:
    in(cb:CodeBuf; dst:int; s1:int; s2:int)
    cb = x86_vex2(cb, s1, 0, 0);
    cb = codebuf_emit_byte(cb, 0x5D);
    cb = codebuf_emit_byte(cb, 0xC0 | ((dst & 7) << 3) | (s2 & 7));
    out cb;
end

func avx_vmaxps:
    in(cb:CodeBuf; dst:int; s1:int; s2:int)
    cb = x86_vex2(cb, s1, 0, 0);
    cb = codebuf_emit_byte(cb, 0x5F);
    cb = codebuf_emit_byte(cb, 0xC0 | ((dst & 7) << 3) | (s2 & 7));
    out cb;
end

func avx_vmovaps_load:
    in(cb:CodeBuf; xmm_dst:int; base:int)
    cb = x86_vex2(cb, 0, 0, 0);
    cb = codebuf_emit_byte(cb, 0x28);
    cb = codebuf_emit_byte(cb, ((xmm_dst & 7) << 3) | (base & 7));
    out cb;
end

func avx_vmovaps_store:
    in(cb:CodeBuf; base:int; xmm_src:int)
    cb = x86_vex2(cb, 0, 0, 0);
    cb = codebuf_emit_byte(cb, 0x29);
    cb = codebuf_emit_byte(cb, ((xmm_src & 7) << 3) | (base & 7));
    out cb;
end

func avx_vbroadcastss:
    in(cb:CodeBuf; dst:int; src:int)
    # VEX.128.66.0F38 18 /r — 3-byte VEX
    cb = codebuf_emit_byte(cb, 0xC4);
    cb = codebuf_emit_byte(cb, 0xE2);
    cb = codebuf_emit_byte(cb, 0x79);
    cb = codebuf_emit_byte(cb, 0x18);
    cb = codebuf_emit_byte(cb, 0xC0 | ((dst & 7) << 3) | (src & 7));
    out cb;
end

func avx_vhaddps:
    in(cb:CodeBuf; dst:int; s1:int; s2:int)
    # VHADDPS: VEX.128.F2.0F 7C /r  (pp=11 for F2)
    cb = x86_vex2(cb, s1, 0, 3);
    cb = codebuf_emit_byte(cb, 0x7C);
    cb = codebuf_emit_byte(cb, 0xC0 | ((dst & 7) << 3) | (s2 & 7));
    out cb;
end

# ═══════════════════════════════════════════════════════
# ARM64 Instruction Emitters
# ═══════════════════════════════════════════════════════

func arm64_add_rrr:
    in(cb:CodeBuf; rd:int; rn:int; rm:int)
    # ADD Xd, Xn, Xm -> 0x8B000000
    instr = 0x8B000000 | ((rm & 0x1F) << 16) | ((rn & 0x1F) << 5) | (rd & 0x1F);
    out codebuf_emit_u32(cb, instr);
end

func arm64_sub_rrr:
    in(cb:CodeBuf; rd:int; rn:int; rm:int)
    # SUB Xd, Xn, Xm -> 0xCB000000
    instr = 0xCB000000 | ((rm & 0x1F) << 16) | ((rn & 0x1F) << 5) | (rd & 0x1F);
    out codebuf_emit_u32(cb, instr);
end

func arm64_mul_rrr:
    in(cb:CodeBuf; rd:int; rn:int; rm:int)
    # MUL = MADD Xd, Xn, Xm, XZR -> 0x9B007C00
    instr = 0x9B007C00 | ((rm & 0x1F) << 16) | ((rn & 0x1F) << 5) | (rd & 0x1F);
    out codebuf_emit_u32(cb, instr);
end

func arm64_sdiv_rrr:
    in(cb:CodeBuf; rd:int; rn:int; rm:int)
    # SDIV Xd, Xn, Xm -> 0x9AC00C00
    instr = 0x9AC00C00 | ((rm & 0x1F) << 16) | ((rn & 0x1F) << 5) | (rd & 0x1F);
    out codebuf_emit_u32(cb, instr);
end

func arm64_mov_imm16:
    in(cb:CodeBuf; rd:int; imm:int)
    # MOVZ Xd, #imm16 -> 0xD2800000
    instr = 0xD2800000 | ((imm & 0xFFFF) << 5) | (rd & 0x1F);
    out codebuf_emit_u32(cb, instr);
end

func arm64_movz_imm64:
    in(cb:CodeBuf; rd:int; imm:int)
    # Full 64-bit load: MOVZ + up to 3 MOVK
    uimm = imm;

    # MOVZ Xd, #imm16, LSL #0
    instr = 0xD2800000 | ((uimm & 0xFFFF) << 5) | (rd & 0x1F);
    cb = codebuf_emit_u32(cb, instr);

    # MOVK for bits [31:16]
    if (uimm >> 16) != 0:
        instr = 0xF2A00000 | (((uimm >> 16) & 0xFFFF) << 5) | (rd & 0x1F);
        cb = codebuf_emit_u32(cb, instr);
    end

    # MOVK for bits [47:32]
    if (uimm >> 32) != 0:
        instr = 0xF2C00000 | (((uimm >> 32) & 0xFFFF) << 5) | (rd & 0x1F);
        cb = codebuf_emit_u32(cb, instr);
    end

    # MOVK for bits [63:48]
    if (uimm >> 48) != 0:
        instr = 0xF2E00000 | (((uimm >> 48) & 0xFFFF) << 5) | (rd & 0x1F);
        cb = codebuf_emit_u32(cb, instr);
    end

    out cb;
end

func arm64_mov_rr:
    in(cb:CodeBuf; rd:int; rm:int)
    # MOV = ORR Xd, XZR, Xm -> 0xAA0003E0
    instr = 0xAA0003E0 | ((rm & 0x1F) << 16) | (rd & 0x1F);
    out codebuf_emit_u32(cb, instr);
end

func arm64_cmp_rr:
    in(cb:CodeBuf; rn:int; rm:int)
    # CMP = SUBS XZR, Xn, Xm -> 0xEB00001F
    instr = 0xEB00001F | ((rm & 0x1F) << 16) | ((rn & 0x1F) << 5);
    out codebuf_emit_u32(cb, instr);
end

func arm64_cset_eq:
    in(cb:CodeBuf; rd:int)
    # CSET EQ = CSINC Xd, XZR, XZR, NE
    out codebuf_emit_u32(cb, 0x9A9F17E0 | (rd & 0x1F));
end

func arm64_cset_gt:
    in(cb:CodeBuf; rd:int)
    # CSET GT = CSINC Xd, XZR, XZR, LE
    out codebuf_emit_u32(cb, 0x9A9FD7E0 | (rd & 0x1F));
end

func arm64_cset_lt:
    in(cb:CodeBuf; rd:int)
    # CSET LT = CSINC Xd, XZR, XZR, GE
    out codebuf_emit_u32(cb, 0x9A9FA7E0 | (rd & 0x1F));
end

func arm64_cset_ge:
    in(cb:CodeBuf; rd:int)
    # CSET GE = CSINC Xd, XZR, XZR, LT
    out codebuf_emit_u32(cb, 0x9A9FB7E0 | (rd & 0x1F));
end

func arm64_cset_le:
    in(cb:CodeBuf; rd:int)
    # CSET LE = CSINC Xd, XZR, XZR, GT
    out codebuf_emit_u32(cb, 0x9A9FC7E0 | (rd & 0x1F));
end

func arm64_b_imm26:
    in(cb:CodeBuf; offset:int)
    # B offset -> 0x14000000
    imm26 = (offset >> 2) & 0x03FFFFFF;
    out codebuf_emit_u32(cb, 0x14000000 | imm26);
end

func arm64_beq_imm19:
    in(cb:CodeBuf; offset:int)
    # B.EQ -> 0x54000000
    imm19 = (offset >> 2) & 0x7FFFF;
    out codebuf_emit_u32(cb, 0x54000000 | (imm19 << 5));
end

func arm64_bne_imm19:
    in(cb:CodeBuf; offset:int)
    # B.NE -> 0x54000001
    imm19 = (offset >> 2) & 0x7FFFF;
    out codebuf_emit_u32(cb, 0x54000001 | (imm19 << 5));
end

func arm64_bl_imm26:
    in(cb:CodeBuf; offset:int)
    imm26 = (offset >> 2) & 0x03FFFFFF;
    out codebuf_emit_u32(cb, 0x94000000 | imm26);
end

func arm64_ret:
    in(cb:CodeBuf)
    out codebuf_emit_u32(cb, 0xD65F03C0);
end

func arm64_nop:
    in(cb:CodeBuf)
    out codebuf_emit_u32(cb, 0xD503201F);
end

func arm64_stp_pre:
    in(cb:CodeBuf; rt:int; rt2:int; rn:int; imm:int)
    # STP Xt, Xt2, [Xn, #imm]!
    simm7 = (imm / 8) & 0x7F;
    instr = 0xA9800000 | (simm7 << 15) | ((rt2 & 0x1F) << 10) | ((rn & 0x1F) << 5) | (rt & 0x1F);
    out codebuf_emit_u32(cb, instr);
end

func arm64_ldp_post:
    in(cb:CodeBuf; rt:int; rt2:int; rn:int; imm:int)
    # LDP Xt, Xt2, [Xn], #imm
    simm7 = (imm / 8) & 0x7F;
    instr = 0xA8C00000 | (simm7 << 15) | ((rt2 & 0x1F) << 10) | ((rn & 0x1F) << 5) | (rt & 0x1F);
    out codebuf_emit_u32(cb, instr);
end

func arm64_str_pre:
    in(cb:CodeBuf; rt:int; rn:int; imm:int)
    # STR Xt, [Xn, #imm]!
    simm9 = imm & 0x1FF;
    instr = 0xF8000C00 | (simm9 << 12) | ((rn & 0x1F) << 5) | (rt & 0x1F);
    out codebuf_emit_u32(cb, instr);
end

func arm64_ldr_post:
    in(cb:CodeBuf; rt:int; rn:int; imm:int)
    # LDR Xt, [Xn], #imm
    simm9 = imm & 0x1FF;
    instr = 0xF8400400 | (simm9 << 12) | ((rn & 0x1F) << 5) | (rt & 0x1F);
    out codebuf_emit_u32(cb, instr);
end

func arm64_svc:
    in(cb:CodeBuf; imm:int)
    out codebuf_emit_u32(cb, 0xD4000001 | ((imm & 0xFFFF) << 5));
end

func arm64_cmp_imm0:
    in(cb:CodeBuf; rn:int)
    # CMP Xn, #0 = SUBS XZR, Xn, #0
    out codebuf_emit_u32(cb, 0xF100001F | ((rn & 0x1F) << 5));
end

func arm64_blr_x16:
    in(cb:CodeBuf)
    # BLR X16 -> 0xD63F0200
    out codebuf_emit_u32(cb, 0xD63F0200);
end

# ── ARM64 bitwise ──

func arm64_and_rrr:
    in(cb:CodeBuf; rd:int; rn:int; rm:int)
    instr = 0x8A000000 | ((rm & 0x1F) << 16) | ((rn & 0x1F) << 5) | (rd & 0x1F);
    out codebuf_emit_u32(cb, instr);
end

func arm64_orr_rrr:
    in(cb:CodeBuf; rd:int; rn:int; rm:int)
    instr = 0xAA000000 | ((rm & 0x1F) << 16) | ((rn & 0x1F) << 5) | (rd & 0x1F);
    out codebuf_emit_u32(cb, instr);
end

func arm64_eor_rrr:
    in(cb:CodeBuf; rd:int; rn:int; rm:int)
    instr = 0xCA000000 | ((rm & 0x1F) << 16) | ((rn & 0x1F) << 5) | (rd & 0x1F);
    out codebuf_emit_u32(cb, instr);
end

func arm64_lsl_rrr:
    in(cb:CodeBuf; rd:int; rn:int; rm:int)
    instr = 0x9AC02000 | ((rm & 0x1F) << 16) | ((rn & 0x1F) << 5) | (rd & 0x1F);
    out codebuf_emit_u32(cb, instr);
end

func arm64_asr_rrr:
    in(cb:CodeBuf; rd:int; rn:int; rm:int)
    instr = 0x9AC02800 | ((rm & 0x1F) << 16) | ((rn & 0x1F) << 5) | (rd & 0x1F);
    out codebuf_emit_u32(cb, instr);
end

# ── ARM64 memory ──

func arm64_ldrb_reg:
    in(cb:CodeBuf; rt:int; rn:int; rm:int)
    instr = 0x38606800 | ((rm & 0x1F) << 16) | ((rn & 0x1F) << 5) | (rt & 0x1F);
    out codebuf_emit_u32(cb, instr);
end

func arm64_strb_reg:
    in(cb:CodeBuf; rt:int; rn:int; rm:int)
    instr = 0x38206800 | ((rm & 0x1F) << 16) | ((rn & 0x1F) << 5) | (rt & 0x1F);
    out codebuf_emit_u32(cb, instr);
end

func arm64_ldr_reg:
    in(cb:CodeBuf; rt:int; rn:int; rm:int)
    # LDR Xt, [Xn, Xm, LSL #3]
    instr = 0xF8607800 | ((rm & 0x1F) << 16) | ((rn & 0x1F) << 5) | (rt & 0x1F);
    out codebuf_emit_u32(cb, instr);
end

func arm64_str_reg:
    in(cb:CodeBuf; rt:int; rn:int; rm:int)
    # STR Xt, [Xn, Xm, LSL #3]
    instr = 0xF8207800 | ((rm & 0x1F) << 16) | ((rn & 0x1F) << 5) | (rt & 0x1F);
    out codebuf_emit_u32(cb, instr);
end

# ═══════════════════════════════════════════════════════
# NEON (ARM64 SIMD) Instruction Emitters
# ═══════════════════════════════════════════════════════

func neon_ld1_4s:
    in(cb:CodeBuf; vt:int; xn:int)
    out codebuf_emit_u32(cb, 0x4C40A800 | ((xn & 0x1F) << 5) | (vt & 0x1F));
end

func neon_st1_4s:
    in(cb:CodeBuf; vt:int; xn:int)
    out codebuf_emit_u32(cb, 0x4C00A800 | ((xn & 0x1F) << 5) | (vt & 0x1F));
end

func neon_add_4s:
    in(cb:CodeBuf; vd:int; vn:int; vm:int)
    enc = 0x4EA08400 | ((vm & 0x1F) << 16) | ((vn & 0x1F) << 5) | (vd & 0x1F);
    out codebuf_emit_u32(cb, enc);
end

func neon_sub_4s:
    in(cb:CodeBuf; vd:int; vn:int; vm:int)
    enc = 0x6EA08400 | ((vm & 0x1F) << 16) | ((vn & 0x1F) << 5) | (vd & 0x1F);
    out codebuf_emit_u32(cb, enc);
end

func neon_mul_4s:
    in(cb:CodeBuf; vd:int; vn:int; vm:int)
    enc = 0x4EA09C00 | ((vm & 0x1F) << 16) | ((vn & 0x1F) << 5) | (vd & 0x1F);
    out codebuf_emit_u32(cb, enc);
end

func neon_fadd_4s:
    in(cb:CodeBuf; vd:int; vn:int; vm:int)
    enc = 0x4E20D400 | ((vm & 0x1F) << 16) | ((vn & 0x1F) << 5) | (vd & 0x1F);
    out codebuf_emit_u32(cb, enc);
end

func neon_fmul_4s:
    in(cb:CodeBuf; vd:int; vn:int; vm:int)
    enc = 0x6E20DC00 | ((vm & 0x1F) << 16) | ((vn & 0x1F) << 5) | (vd & 0x1F);
    out codebuf_emit_u32(cb, enc);
end

func neon_fdiv_4s:
    in(cb:CodeBuf; vd:int; vn:int; vm:int)
    enc = 0x6E20FC00 | ((vm & 0x1F) << 16) | ((vn & 0x1F) << 5) | (vd & 0x1F);
    out codebuf_emit_u32(cb, enc);
end

func neon_fmla_4s:
    in(cb:CodeBuf; vd:int; vn:int; vm:int)
    enc = 0x4E20CC00 | ((vm & 0x1F) << 16) | ((vn & 0x1F) << 5) | (vd & 0x1F);
    out codebuf_emit_u32(cb, enc);
end

func neon_smin_4s:
    in(cb:CodeBuf; vd:int; vn:int; vm:int)
    enc = 0x4EA06C00 | ((vm & 0x1F) << 16) | ((vn & 0x1F) << 5) | (vd & 0x1F);
    out codebuf_emit_u32(cb, enc);
end

func neon_smax_4s:
    in(cb:CodeBuf; vd:int; vn:int; vm:int)
    enc = 0x4EA06400 | ((vm & 0x1F) << 16) | ((vn & 0x1F) << 5) | (vd & 0x1F);
    out codebuf_emit_u32(cb, enc);
end

func neon_addv_4s:
    in(cb:CodeBuf; vd:int; vn:int)
    out codebuf_emit_u32(cb, 0x4EB1B800 | ((vn & 0x1F) << 5) | (vd & 0x1F));
end

func neon_dup_4s_gpr:
    in(cb:CodeBuf; vd:int; xn:int)
    out codebuf_emit_u32(cb, 0x4E040C00 | ((xn & 0x1F) << 5) | (vd & 0x1F));
end

func neon_tbl_16b:
    in(cb:CodeBuf; vd:int; vn:int; vm:int)
    enc = 0x4E000000 | ((vm & 0x1F) << 16) | ((vn & 0x1F) << 5) | (vd & 0x1F);
    out codebuf_emit_u32(cb, enc);
end

# ═══════════════════════════════════════════════════════
# Virtual Register -> Physical Register Mapping
# ═══════════════════════════════════════════════════════

func vreg_to_x86:
    in(vreg:int)
    # RAX=0, RCX=1, RDX=2, RSI=6, RDI=7, R8-R11, RBX=3, R12-R15
    map = [0, 1, 2, 6, 7, 8, 9, 10, 11, 3, 12, 13, 14, 15];
    if vreg >= 0 and vreg < 14:
        out map[vreg];
    end
    out 0  # spill to RAX;
end

func vreg_to_arm:
    in(vreg:int)
    if vreg >= 0 and vreg < 16:
        out vreg;
    end
    out 0  # spill to X0;
end

func vreg_to_neon:
    in(vreg:int)
    if vreg >= 0 and vreg < 16:
        out vreg;
    end
    out 0;
end

func vreg_to_xmm:
    in(vreg:int)
    if vreg >= 0 and vreg < 8:
        out vreg;
    end
    out 0;
end

# ═══════════════════════════════════════════════════════
# Back-Patching Infrastructure
# ═══════════════════════════════════════════════════════

const CG_MAX_LABELS = 1024;
const CG_MAX_FIXUPS = 4096;

entity CgLabel:
    label_id:   int;
    offset:     int;
end

entity CgFixup:
    patch_offset:   int;
    target_label:   int;
    is_cond:        int;
end

entity PatchState:
    labels:         [CgLabel];
    fixups:         [CgFixup];
    label_count:    int;
    fixup_count:    int;
end

func patch_new:
    out PatchState {;
        labels: [],;
        fixups: [],;
        label_count: 0,;
        fixup_count: 0;
    };
end

func patch_add_label:
    in(ps:PatchState; label_id:int; offset:int)
    if ps.label_count < CG_MAX_LABELS:
        ps.labels = ps.labels + [CgLabel { label_id: label_id, offset: offset }];
        ps.label_count = ps.label_count + 1;
    end
    out ps;
end

func patch_add_fixup:
    in(ps:PatchState; patch_offset:int; target_label:int; is_cond:int)
    if ps.fixup_count < CG_MAX_FIXUPS:
        ps.fixups = ps.fixups + [CgFixup { patch_offset: patch_offset, target_label: target_label, is_cond: is_cond }];
        ps.fixup_count = ps.fixup_count + 1;
    end
    out ps;
end

func patch_find_label:
    in(ps:PatchState; label_id:int)
    i = 0;
    when i < ps.label_count loop
        if ps.labels[i].label_id == label_id:
            out ps.labels[i].offset;
        end
        i = i + 1;
    end
    out -1  # not found;
end

func backpatch_x86:
    in(cb:CodeBuf; ps:PatchState)
    f = 0;
    when f < ps.fixup_count loop
        target = patch_find_label(ps, ps.fixups[f].target_label);
        if target >= 0:
            patch_at = ps.fixups[f].patch_offset;
            instr_end = patch_at + 4;
            rel = target - instr_end;
            cb = codebuf_patch_i32(cb, patch_at, rel);
        end
        f = f + 1;
    end
    out cb;
end

func backpatch_arm64:
    in(cb:CodeBuf; ps:PatchState)
    f = 0;
    when f < ps.fixup_count loop
        target = patch_find_label(ps, ps.fixups[f].target_label);
        if target >= 0:
            patch_at = ps.fixups[f].patch_offset;
            byte_offset = target - patch_at;
            # Read original instruction (little-endian)
            orig = cb.data[patch_at] | (cb.data[patch_at + 1] << 8) | (cb.data[patch_at + 2] << 16) | (cb.data[patch_at + 3] << 24);
            if ps.fixups[f].is_cond == 1:
                # B.cond: imm19 at bits [23:5]
                imm19 = (byte_offset >> 2) & 0x7FFFF;
                orig = (orig & (~(0x7FFFF << 5))) | (imm19 << 5);
            else
                # B / BL: imm26 at bits [25:0]
                imm26 = (byte_offset >> 2) & 0x03FFFFFF;
                orig = (orig & (~0x03FFFFFF)) | imm26;
            end
            cb = codebuf_patch_u32(cb, patch_at, orig);
        end
        f = f + 1;
    end
    out cb;
end

func backpatch:
    in(cb:CodeBuf; ps:PatchState)
    if cb.arch == TargetArch::ARM64:
        out backpatch_arm64(cb, ps);
    else
        out backpatch_x86(cb, ps);
    end
end

# ═══════════════════════════════════════════════════════
# Q-IR Opcodes (matching ir_optimizer.vri)
# ═══════════════════════════════════════════════════════

enum QOp:
    Nop             = 0;
    Load            = 1;
    Store           = 2;
    Move            = 3;
    Add             = 4;
    Sub             = 5;
    Mul             = 6;
    Div             = 7;
    Mod             = 8;
    CmpEq           = 9;
    CmpGt           = 10;
    CmpLt           = 11;
    CmpGe           = 12;
    CmpLe           = 13;
    And             = 14;
    Or              = 15;
    Xor             = 16;
    Shl             = 17;
    Shr             = 18;
    Label           = 19;
    Jump            = 20;
    JumpIf          = 21;
    JumpIfNot       = 22;
    Call            = 23;
    CallFunc        = 24;
    Ret             = 25;
    Halt            = 26;
    Print           = 27;
    Input           = 28;
    PrintStr        = 29;
    Alloc           = 30;
    Free            = 31;
    LoadByte        = 32;
    StoreByte       = 33;
    LoadWord        = 34;
    StoreWord       = 35;
    StrLen          = 36;
    StrGet          = 37;
    StrCat          = 38;
    StrEq           = 39;
    IToStr          = 40;
    StrToI          = 41;
    FileOpen        = 42;
    FileRead        = 43;
    FileWrite       = 44;
    FileClose       = 45;
    FileWriteByte   = 46;
    ArrNew          = 47;
    ArrLen          = 48;
    ArrGet          = 49;
    ArrSet          = 50;
    ArrPush         = 51;
    Exit            = 52;
    LoadGlobal      = 53;
    StoreGlobal     = 54;
    GetArg          = 55;
    ArgCount        = 56;
    PatchPoint      = 57;
    VLoad           = 58;
    VStore          = 59;
    VAdd            = 60;
    VSub            = 61;
    VMul            = 62;
    VFma            = 63;
    VDiv            = 64;
    VMin            = 65;
    VMax            = 66;
    VReduce         = 67;
    VSplat          = 68;
    VPerm           = 69;
end

# ═══════════════════════════════════════════════════════
# Operand Types
# ═══════════════════════════════════════════════════════

enum OpndType:
    None    = 0;
    VReg    = 1;
    Imm     = 2;
    Label   = 3;
    StrRef  = 4;
    FuncIdx = 5;
end

entity Operand:
    kind:       OpndType;
    vreg:       int;
    imm:        int;
    label:      int;
    str_idx:    int;
    func_idx:   int;
end

func opnd_none:
    out Operand { kind: OpndType::None, vreg: 0, imm: 0, label: 0, str_idx: 0, func_idx: 0 };
end

func opnd_vreg:
    in(v:int)
    out Operand { kind: OpndType::VReg, vreg: v, imm: 0, label: 0, str_idx: 0, func_idx: 0 };
end

func opnd_imm:
    in(v:int)
    out Operand { kind: OpndType::Imm, vreg: 0, imm: v, label: 0, str_idx: 0, func_idx: 0 };
end

func opnd_label:
    in(v:int)
    out Operand { kind: OpndType::Label, vreg: 0, imm: 0, label: v, str_idx: 0, func_idx: 0 };
end

# ═══════════════════════════════════════════════════════
# Instruction
# ═══════════════════════════════════════════════════════

entity QInstr:
    opcode:     QOp;
    dest:       Operand;
    src1:       Operand;
    src2:       Operand;
    patch_id:   int;
    label_name: string;
    string_idx: int;
end

# ═══════════════════════════════════════════════════════
# codegen_emit_fast — Register-Direct Code Generation
# ═══════════════════════════════════════════════════════
# This is the main code-generation dispatch.
# Takes a list of Q-IR instructions and emits machine code.

func emit_fast_x86:
    in(cb:CodeBuf; instrs:[QInstr]; count:int)
    ps = patch_new();

    # Check if stack frame needed
    needs_frame = 0;
    check = 0;
    when check < count loop
        op = instrs[check].opcode;
        if op == QOp::Call or op == QOp::CallFunc or op == QOp::Print:
            needs_frame = 1;
        end
        check = check + 1;
    end

    # Prologue
    if needs_frame == 1:
        cb = x86_push(cb, 5)       # PUSH RBP;
        cb = x86_mov_rr(cb, 5, 4)  # MOV RBP, RSP;
    end

    i = 0;
    when i < count loop
        ins = instrs[i];
        rd = 0;
        rs1 = 0;
        rs2 = 1;

        if ins.dest.kind == OpndType::VReg:
            rd = vreg_to_x86(ins.dest.vreg);
        end
        if ins.src1.kind == OpndType::VReg:
            rs1 = vreg_to_x86(ins.src1.vreg);
        end
        if ins.src2.kind == OpndType::VReg:
            rs2 = vreg_to_x86(ins.src2.vreg);
        end

        if ins.opcode == QOp::Nop:
            cb = x86_nop(cb);

        eif ins.opcode == QOp::Load:
            if ins.src1.kind == OpndType::Imm:
                cb = x86_mov_reg_imm64(cb, rd, ins.src1.imm);
            end

        eif ins.opcode == QOp::Store or ins.opcode == QOp::Move:
            cb = x86_mov_rr(cb, rd, rs1);

        eif ins.opcode == QOp::Add:
            if rd != rs1:
                cb = x86_mov_rr(cb, rd, rs1);
            end
            cb = x86_add_rr(cb, rd, rs2);

        eif ins.opcode == QOp::Sub:
            if rd != rs1:
                cb = x86_mov_rr(cb, rd, rs1);
            end
            cb = x86_sub_rr(cb, rd, rs2);

        eif ins.opcode == QOp::Mul:
            if rd != rs1:
                cb = x86_mov_rr(cb, rd, rs1);
            end
            cb = x86_imul_rr(cb, rd, rs2);

        eif ins.opcode == QOp::Div:
            if rs1 != 0  # RAX:
                cb = x86_mov_rr(cb, 0, rs1);
            end
            cb = x86_cqo(cb);
            cb = x86_idiv(cb, rs2);
            if rd != 0:
                cb = x86_mov_rr(cb, rd, 0);
            end

        eif ins.opcode == QOp::Mod:
            if rs1 != 0:
                cb = x86_mov_rr(cb, 0, rs1);
            end
            cb = x86_cqo(cb);
            cb = x86_idiv(cb, rs2);
            if rd != 2  # RDX:
                cb = x86_mov_rr(cb, rd, 2);
            end

        eif ins.opcode == QOp::CmpEq:
            cb = x86_cmp_rr(cb, rs1, rs2);
            cb = x86_xor_rr(cb, rd, rd);
            cb = x86_sete(cb, rd);

        eif ins.opcode == QOp::CmpGt:
            cb = x86_cmp_rr(cb, rs1, rs2);
            cb = x86_xor_rr(cb, rd, rd);
            cb = x86_setg(cb, rd);

        eif ins.opcode == QOp::CmpLt:
            cb = x86_cmp_rr(cb, rs1, rs2);
            cb = x86_xor_rr(cb, rd, rd);
            cb = x86_setl(cb, rd);

        eif ins.opcode == QOp::CmpGe:
            cb = x86_cmp_rr(cb, rs1, rs2);
            cb = x86_xor_rr(cb, rd, rd);
            cb = x86_setge(cb, rd);

        eif ins.opcode == QOp::CmpLe:
            cb = x86_cmp_rr(cb, rs1, rs2);
            cb = x86_xor_rr(cb, rd, rd);
            cb = x86_setle(cb, rd);

        eif ins.opcode == QOp::And:
            if rd != rs1:
                cb = x86_mov_rr(cb, rd, rs1);
            end
            cb = x86_and_rr(cb, rd, rs2);

        eif ins.opcode == QOp::Or:
            if rd != rs1:
                cb = x86_mov_rr(cb, rd, rs1);
            end
            cb = x86_or_rr(cb, rd, rs2);

        eif ins.opcode == QOp::Xor:
            if rd != rs1:
                cb = x86_mov_rr(cb, rd, rs1);
            end
            cb = x86_xor_rr(cb, rd, rs2);

        eif ins.opcode == QOp::Shl:
            if rd != rs1:
                cb = x86_mov_rr(cb, rd, rs1);
            end
            if rs2 != 1  # RCX:
                cb = x86_mov_rr(cb, 1, rs2);
            end
            cb = x86_shl_cl(cb, rd);

        eif ins.opcode == QOp::Shr:
            if rd != rs1:
                cb = x86_mov_rr(cb, rd, rs1);
            end
            if rs2 != 1  # RCX:
                cb = x86_mov_rr(cb, 1, rs2);
            end
            cb = x86_sar_cl(cb, rd);

        eif ins.opcode == QOp::Label:
            ps = patch_add_label(ps, ins.patch_id, codebuf_offset(cb));

        eif ins.opcode == QOp::Jump:
            if ins.src1.kind == OpndType::Label:
                ps = patch_add_fixup(ps, codebuf_offset(cb) + 1, ins.src1.label, 0);
            end
            cb = x86_jmp_rel32(cb, 0);

        eif ins.opcode == QOp::JumpIf:
            if ins.src1.kind == OpndType::VReg:
                cb = x86_test_rr(cb, rs1);
            end
            if ins.src2.kind == OpndType::Label:
                ps = patch_add_fixup(ps, codebuf_offset(cb) + 2, ins.src2.label, 1);
            end
            cb = x86_jne_rel32(cb, 0);

        eif ins.opcode == QOp::JumpIfNot:
            if ins.src1.kind == OpndType::VReg:
                cb = x86_test_rr(cb, rs1);
            end
            if ins.src2.kind == OpndType::Label:
                ps = patch_add_fixup(ps, codebuf_offset(cb) + 2, ins.src2.label, 1);
            end
            cb = x86_je_rel32(cb, 0);

        eif ins.opcode == QOp::Call or ins.opcode == QOp::CallFunc:
            if ins.src1.kind == OpndType::Label:
                ps = patch_add_fixup(ps, codebuf_offset(cb) + 1, ins.src1.label, 0);
            eif ins.src1.kind == OpndType::FuncIdx:
                ps = patch_add_fixup(ps, codebuf_offset(cb) + 1, ins.src1.func_idx, 0);
            end
            cb = x86_call_rel32(cb, 0);

        eif ins.opcode == QOp::Ret:
            if ins.src1.kind == OpndType::VReg and rs1 != 0:
                cb = x86_mov_rr(cb, 0, rs1);
            end
            if needs_frame == 1:
                cb = x86_mov_rr(cb, 4, 5)  # MOV RSP, RBP;
                cb = x86_pop(cb, 5)         # POP RBP;
            end
            cb = x86_ret(cb);

        eif ins.opcode == QOp::Halt:
            cb = x86_xor_rr(cb, 0, 0);
            cb = x86_ret(cb);

        eif ins.opcode == QOp::PatchPoint:
            cb = x86_nop(cb);

        # SIMD (AVX)
        eif ins.opcode == QOp::VLoad:
            xd = vreg_to_xmm(ins.dest.vreg);
            base = 0;
            if ins.src1.kind == OpndType::VReg:
                base = vreg_to_x86(ins.src1.vreg);
            end
            cb = avx_vmovaps_load(cb, xd, base);

        eif ins.opcode == QOp::VStore:
            xs = vreg_to_xmm(ins.src1.vreg);
            base = 0;
            if ins.dest.kind == OpndType::VReg:
                base = vreg_to_x86(ins.dest.vreg);
            end
            cb = avx_vmovaps_store(cb, base, xs);

        eif ins.opcode == QOp::VAdd:
            cb = avx_vaddps(cb, vreg_to_xmm(ins.dest.vreg), vreg_to_xmm(ins.src1.vreg), vreg_to_xmm(ins.src2.vreg));

        eif ins.opcode == QOp::VSub:
            cb = avx_vsubps(cb, vreg_to_xmm(ins.dest.vreg), vreg_to_xmm(ins.src1.vreg), vreg_to_xmm(ins.src2.vreg));

        eif ins.opcode == QOp::VMul:
            cb = avx_vmulps(cb, vreg_to_xmm(ins.dest.vreg), vreg_to_xmm(ins.src1.vreg), vreg_to_xmm(ins.src2.vreg));

        eif ins.opcode == QOp::VFma:
            d = vreg_to_xmm(ins.dest.vreg);
            s1 = vreg_to_xmm(ins.src1.vreg);
            s2 = vreg_to_xmm(ins.src2.vreg);
            cb = avx_vmulps(cb, d, s1, s2);
            cb = avx_vaddps(cb, d, d, d);

        eif ins.opcode == QOp::VDiv:
            cb = avx_vdivps(cb, vreg_to_xmm(ins.dest.vreg), vreg_to_xmm(ins.src1.vreg), vreg_to_xmm(ins.src2.vreg));

        eif ins.opcode == QOp::VMin:
            cb = avx_vminps(cb, vreg_to_xmm(ins.dest.vreg), vreg_to_xmm(ins.src1.vreg), vreg_to_xmm(ins.src2.vreg));

        eif ins.opcode == QOp::VMax:
            cb = avx_vmaxps(cb, vreg_to_xmm(ins.dest.vreg), vreg_to_xmm(ins.src1.vreg), vreg_to_xmm(ins.src2.vreg));

        eif ins.opcode == QOp::VReduce:
            d = vreg_to_xmm(ins.dest.vreg);
            s = vreg_to_xmm(ins.src1.vreg);
            cb = avx_vhaddps(cb, d, s, s);
            cb = avx_vhaddps(cb, d, d, d);

        eif ins.opcode == QOp::VSplat:
            cb = avx_vbroadcastss(cb, vreg_to_xmm(ins.dest.vreg), vreg_to_xmm(ins.src1.vreg));

        else
            cb = x86_nop(cb);
        end

        i = i + 1;
    end

    # Back-patch
    cb = backpatch_x86(cb, ps);
    out cb;
end

func emit_fast_arm64:
    in(cb:CodeBuf; instrs:[QInstr]; count:int)
    ps = patch_new();

    # Check if stack frame needed
    needs_frame = 0;
    check = 0;
    when check < count loop
        op = instrs[check].opcode;
        if op == QOp::Call or op == QOp::CallFunc or op == QOp::Print:
            needs_frame = 1;
        end
        check = check + 1;
    end

    # Prologue
    if needs_frame == 1:
        cb = arm64_stp_pre(cb, 29, 30, 31, -16)  # STP X29, X30, [SP, #-16]!;
    end

    i = 0;
    when i < count loop
        ins = instrs[i];
        rd = 0;
        rs1 = 0;
        rs2 = 1;

        if ins.dest.kind == OpndType::VReg:
            rd = vreg_to_arm(ins.dest.vreg);
        end
        if ins.src1.kind == OpndType::VReg:
            rs1 = vreg_to_arm(ins.src1.vreg);
        end
        if ins.src2.kind == OpndType::VReg:
            rs2 = vreg_to_arm(ins.src2.vreg);
        end

        if ins.opcode == QOp::Nop:
            cb = arm64_nop(cb);

        eif ins.opcode == QOp::Load:
            if ins.src1.kind == OpndType::Imm:
                cb = arm64_movz_imm64(cb, rd, ins.src1.imm);
            end

        eif ins.opcode == QOp::Store or ins.opcode == QOp::Move:
            cb = arm64_mov_rr(cb, rd, rs1);

        eif ins.opcode == QOp::Add:
            cb = arm64_add_rrr(cb, rd, rs1, rs2);

        eif ins.opcode == QOp::Sub:
            cb = arm64_sub_rrr(cb, rd, rs1, rs2);

        eif ins.opcode == QOp::Mul:
            cb = arm64_mul_rrr(cb, rd, rs1, rs2);

        eif ins.opcode == QOp::Div:
            cb = arm64_sdiv_rrr(cb, rd, rs1, rs2);

        eif ins.opcode == QOp::Mod:
            # X16 = SDIV(rs1, rs2); rd = rs1 - X16 * rs2
            cb = arm64_sdiv_rrr(cb, 16, rs1, rs2);
            cb = arm64_mul_rrr(cb, 16, 16, rs2);
            cb = arm64_sub_rrr(cb, rd, rs1, 16);

        eif ins.opcode == QOp::CmpEq:
            cb = arm64_cmp_rr(cb, rs1, rs2);
            cb = arm64_cset_eq(cb, rd);

        eif ins.opcode == QOp::CmpGt:
            cb = arm64_cmp_rr(cb, rs1, rs2);
            cb = arm64_cset_gt(cb, rd);

        eif ins.opcode == QOp::CmpLt:
            cb = arm64_cmp_rr(cb, rs1, rs2);
            cb = arm64_cset_lt(cb, rd);

        eif ins.opcode == QOp::CmpGe:
            cb = arm64_cmp_rr(cb, rs1, rs2);
            cb = arm64_cset_ge(cb, rd);

        eif ins.opcode == QOp::CmpLe:
            cb = arm64_cmp_rr(cb, rs1, rs2);
            cb = arm64_cset_le(cb, rd);

        eif ins.opcode == QOp::And:
            cb = arm64_and_rrr(cb, rd, rs1, rs2);

        eif ins.opcode == QOp::Or:
            cb = arm64_orr_rrr(cb, rd, rs1, rs2);

        eif ins.opcode == QOp::Xor:
            cb = arm64_eor_rrr(cb, rd, rs1, rs2);

        eif ins.opcode == QOp::Shl:
            cb = arm64_lsl_rrr(cb, rd, rs1, rs2);

        eif ins.opcode == QOp::Shr:
            cb = arm64_asr_rrr(cb, rd, rs1, rs2);

        eif ins.opcode == QOp::Label:
            ps = patch_add_label(ps, ins.patch_id, codebuf_offset(cb));

        eif ins.opcode == QOp::Jump:
            if ins.src1.kind == OpndType::Label:
                ps = patch_add_fixup(ps, codebuf_offset(cb), ins.src1.label, 0);
            end
            cb = arm64_b_imm26(cb, 0);

        eif ins.opcode == QOp::JumpIf:
            if ins.src1.kind == OpndType::VReg:
                cb = arm64_cmp_imm0(cb, rs1);
            end
            if ins.src2.kind == OpndType::Label:
                ps = patch_add_fixup(ps, codebuf_offset(cb), ins.src2.label, 1);
            end
            cb = arm64_bne_imm19(cb, 0);

        eif ins.opcode == QOp::JumpIfNot:
            if ins.src1.kind == OpndType::VReg:
                cb = arm64_cmp_imm0(cb, rs1);
            end
            if ins.src2.kind == OpndType::Label:
                ps = patch_add_fixup(ps, codebuf_offset(cb), ins.src2.label, 1);
            end
            cb = arm64_beq_imm19(cb, 0);

        eif ins.opcode == QOp::Call or ins.opcode == QOp::CallFunc:
            if ins.src1.kind == OpndType::Label:
                ps = patch_add_fixup(ps, codebuf_offset(cb), ins.src1.label, 0);
            eif ins.src1.kind == OpndType::FuncIdx:
                ps = patch_add_fixup(ps, codebuf_offset(cb), ins.src1.func_idx, 0);
            end
            cb = arm64_bl_imm26(cb, 0);

        eif ins.opcode == QOp::Ret:
            if ins.src1.kind == OpndType::VReg and rs1 != 0:
                cb = arm64_mov_rr(cb, 0, rs1);
            end
            if needs_frame == 1:
                cb = arm64_ldp_post(cb, 29, 30, 31, 16);
            end
            cb = arm64_ret(cb);

        eif ins.opcode == QOp::Halt:
            cb = arm64_mov_imm16(cb, 0, 0);
            cb = arm64_ret(cb);

        eif ins.opcode == QOp::PatchPoint:
            cb = arm64_nop(cb);

        # Memory
        eif ins.opcode == QOp::LoadByte:
            cb = arm64_ldrb_reg(cb, rd, rs1, rs2);

        eif ins.opcode == QOp::StoreByte:
            val = 0;
            if ins.dest.kind == OpndType::VReg:
                val = vreg_to_arm(ins.dest.vreg);
            end
            cb = arm64_strb_reg(cb, val, rs1, rs2);

        eif ins.opcode == QOp::LoadWord:
            cb = arm64_ldr_reg(cb, rd, rs1, rs2);

        eif ins.opcode == QOp::StoreWord:
            val = 0;
            if ins.dest.kind == OpndType::VReg:
                val = vreg_to_arm(ins.dest.vreg);
            end
            cb = arm64_str_reg(cb, val, rs1, rs2);

        # SIMD (NEON)
        eif ins.opcode == QOp::VLoad:
            cb = neon_ld1_4s(cb, vreg_to_neon(ins.dest.vreg), rs1);

        eif ins.opcode == QOp::VStore:
            base = 0;
            if ins.dest.kind == OpndType::VReg:
                base = vreg_to_arm(ins.dest.vreg);
            end
            cb = neon_st1_4s(cb, vreg_to_neon(ins.src1.vreg), base);

        eif ins.opcode == QOp::VAdd:
            cb = neon_add_4s(cb, vreg_to_neon(ins.dest.vreg), vreg_to_neon(ins.src1.vreg), vreg_to_neon(ins.src2.vreg));

        eif ins.opcode == QOp::VSub:
            cb = neon_sub_4s(cb, vreg_to_neon(ins.dest.vreg), vreg_to_neon(ins.src1.vreg), vreg_to_neon(ins.src2.vreg));

        eif ins.opcode == QOp::VMul:
            cb = neon_mul_4s(cb, vreg_to_neon(ins.dest.vreg), vreg_to_neon(ins.src1.vreg), vreg_to_neon(ins.src2.vreg));

        eif ins.opcode == QOp::VFma:
            cb = neon_fmla_4s(cb, vreg_to_neon(ins.dest.vreg), vreg_to_neon(ins.src1.vreg), vreg_to_neon(ins.src2.vreg));

        eif ins.opcode == QOp::VDiv:
            cb = neon_fdiv_4s(cb, vreg_to_neon(ins.dest.vreg), vreg_to_neon(ins.src1.vreg), vreg_to_neon(ins.src2.vreg));

        eif ins.opcode == QOp::VMin:
            cb = neon_smin_4s(cb, vreg_to_neon(ins.dest.vreg), vreg_to_neon(ins.src1.vreg), vreg_to_neon(ins.src2.vreg));

        eif ins.opcode == QOp::VMax:
            cb = neon_smax_4s(cb, vreg_to_neon(ins.dest.vreg), vreg_to_neon(ins.src1.vreg), vreg_to_neon(ins.src2.vreg));

        eif ins.opcode == QOp::VReduce:
            cb = neon_addv_4s(cb, vreg_to_neon(ins.dest.vreg), vreg_to_neon(ins.src1.vreg));

        eif ins.opcode == QOp::VSplat:
            cb = neon_dup_4s_gpr(cb, vreg_to_neon(ins.dest.vreg), rs1);

        eif ins.opcode == QOp::VPerm:
            cb = neon_tbl_16b(cb, vreg_to_neon(ins.dest.vreg), vreg_to_neon(ins.src1.vreg), vreg_to_neon(ins.src2.vreg));

        else
            cb = arm64_nop(cb);
        end

        i = i + 1;
    end

    # Back-patch
    cb = backpatch_arm64(cb, ps);
    out cb;
end

# ═══════════════════════════════════════════════════════
# Top-Level Code Generation Entry Points
# ═══════════════════════════════════════════════════════

func codegen_emit:
    in(instrs:[QInstr]; count:int; arch:TargetArch)
    cb = codebuf_new(arch);
    if arch == TargetArch::ARM64:
        cb = emit_fast_arm64(cb, instrs, count);
    else
        cb = emit_fast_x86(cb, instrs, count);
    end
    out cb;
end

func codegen_emit_for_host:
    in(instrs:[QInstr]; count:int)
    out codegen_emit(instrs, count, detect_arch());
end

func codegen_emit_module_stub:
    in(m:QModule; arch:TargetArch)
    cb = codebuf_new(arch);
    if vec_len(m.functions) == 0:
        out cb;
    end
    mainf = vec_get(m.functions, 0);
    cb = codegen_emit(mainf.body, vec_len(mainf.body), arch);
    cb.start_offset = 0;
    out cb;
end

# ═══════════════════════════════════════════════════════
# Multi-Variant Code Generation
# ═══════════════════════════════════════════════════════

entity CodeVariant:
    patch_id:       int;
    safe_code:      CodeBuf;
    fast_code:      CodeBuf;
end

entity CodegenResult:
    arch:       TargetArch;
    variants:   [CodeVariant];
    count:      int;
end

func codegen_result_new:
    in(arch:TargetArch)
    out CodegenResult {;
        arch: arch,;
        variants: [],;
        count: 0;
    };
end

# ═══════════════════════════════════════════════════════
# Hexdump Utility
# ═══════════════════════════════════════════════════════

func codebuf_hexdump:
    in(cb:CodeBuf)
    # Returns a list of hex byte values for inspection
    result = [];
    i = 0;
    when i < cb.len loop
        result = result + [cb.data[i]];
        i = i + 1;
    end
    out result;
end

