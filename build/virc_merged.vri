# ═══ BEGIN: stdlib/vir/compiler/main.vri ═══
##
 * vir/compiler/main.vri — Vir Self-Hosting Compiler Driver
 * =========================================================
 * Phase 5: Bootstrap — Vir compiles itself to a standalone binary.
 *
 * Pipeline:
 *   source.vri → lex → parse → lower → regalloc → codegen → link → Mach-O
 *
 * Produces a standalone Mach-O ARM64 executable that uses direct
 * BSD syscalls — no Python, no C library, no external linker needed.
 *
 * Usage (Stage 1 — bootstrapped via C runtime):
 *   vir jit stdlib/vir/compiler/main.vri <input.vri> [-o output]
 *
 * Usage (Stage 2 — self-hosted):
 *   ./virc <input.vri> [-o output]
 *
 * Date: 9/3/2026
 ##

# [merged] include lexer;
# [merged] include parser;
# [merged] include ir_optimizer;
# [merged] include codegen;
# [merged] include binary;
# ═══ BEGIN: stdlib/vir/compiler/binary.vri ═══
##
 * vir/codegen/binary.vri — Binary Object Format Emitter
 * ======================================================
 * Step 3: Cut the umbilical cord — emit Mach-O/ELF objects directly
 *
 * This module constructs binary object files in memory,
 * bypassing the need for an external assembler (as) or linker (ld).
 *
 * Mach-O 64-bit format (macOS ARM64 & x86-64):
 *   Header -> Load Commands -> Segments -> Sections -> Relocations -> SymTab
 *
 * ELF 64-bit format (Linux):
 *   ELF Header -> Section Headers -> .text -> .data -> .symtab -> .strtab
 ##

# [merged] include types;
# [merged] include result;
# [merged] import Result, Ok, Err from result;
# [merged] include string;
# [merged] import String, str_new, str_concat, str_len from string;
# [merged] include vec;
# [merged] import Vec, vec_new, vec_push, vec_len, vec_get from vec;


# ═══════════════════════════════════════════════════════
# Target Format
# ═══════════════════════════════════════════════════════

enum ObjFormat:
    MachO64  = 0;
    ELF64    = 1;
end.

enum Arch:
    ARM64    = 0;
    X86_64   = 1;
end.


# ═══════════════════════════════════════════════════════
# Raw byte buffer
# ═══════════════════════════════════════════════════════

entity ByteBuffer:
    data:   Vec<int>;
    pos:    int;
end.

func buf_new:
    out ByteBuffer { data: vec_new(), pos: 0 };
end.

func buf_write_u8:
    in(buf:ByteBuffer; val:int)
    vec_push(buf.data, val);
    buf.pos = buf.pos + 1;
    out buf;
end.

func buf_write_u16_le:
    in(buf:ByteBuffer; val:int)
    buf = buf_write_u8(buf, (val & 0xFF) >> int);
    buf = buf_write_u8(buf, ((val >> 8) & 0xFF) >> int);
    out buf;
end.

func buf_write_u32_le:
    in(buf:ByteBuffer; val:int)
    buf = buf_write_u8(buf, (val & 0xFF) >> int);
    buf = buf_write_u8(buf, ((val >> 8) & 0xFF) >> int);
    buf = buf_write_u8(buf, ((val >> 16) & 0xFF) >> int);
    buf = buf_write_u8(buf, ((val >> 24) & 0xFF) >> int);
    out buf;
end.

func buf_write_u64_le:
    in(buf:ByteBuffer; val:int)
    buf = buf_write_u32_le(buf, (val & 0xFFFFFFFF) >> int);
    buf = buf_write_u32_le(buf, ((val >> 32) & 0xFFFFFFFF) >> int);
    out buf;
end.

func buf_write_zeros:
    in(buf:ByteBuffer; count:int)
    i = 0;
    when i < count loop
        buf = buf_write_u8(buf, 0);
        i = i + 1;
    end
    out buf;
end.

func buf_write_bytes:
    in(buf:ByteBuffer; bytes:Vec<int>)
    i = 0;
    when i < vec_len(bytes) loop
        buf = buf_write_u8(buf, vec_get(bytes, i));
        i = i + 1;
    end
    out buf;
end.

func buf_write_string_padded:
    in(buf:ByteBuffer; s:string; pad_to:int)
    slen = str_len(s);
    i = 0;
    when i < slen and i < pad_to loop
        buf = buf_write_u8(buf, str_byte_at(s, i));
        i = i + 1;
    end
    # Pad with zeros
    when i < pad_to loop
        buf = buf_write_u8(buf, 0);
        i = i + 1;
    end
    out buf;
end.

func buf_align:
    in(buf:ByteBuffer; alignment:int)
    when (buf.pos % alignment as i64) != 0 loop
        buf = buf_write_u8(buf, 0);
    end
    out buf;
end.

func buf_size:
    in(buf:ByteBuffer)
    out buf.pos;
end.


# ═══════════════════════════════════════════════════════
# Symbol Table Entry
# ═══════════════════════════════════════════════════════

enum SymbolType:
    Function   = 0;
    Data       = 1;
    External   = 2;
end.

entity Symbol:
    name:       string;
    sym_type:   SymbolType;
    section:    int        # section index (1-based);
    offset:     int        # offset within section;
    size:       int;
    is_global:  bool;
end.


# ═══════════════════════════════════════════════════════
# Relocation Entry
# ═══════════════════════════════════════════════════════

enum RelocType:
    Branch26       = 0   # ARM64: B/BL (26-bit offset);
    Page21         = 1   # ARM64: ADRP (21-bit page);
    PageOff12      = 2   # ARM64: ADD/LDR (12-bit page offset);
    PLT32          = 3   # x86-64: PLT call;
    PC32           = 4   # x86-64: RIP-relative;
    GOTLoad        = 5   # GOT entry load;
end.

entity Relocation:
    offset:     int;
    sym_idx:    int;
    reloc_type: RelocType;
    addend:     int;
end.


# ═══════════════════════════════════════════════════════
# Section
# ═══════════════════════════════════════════════════════

entity Section:
    name:       string;
    seg_name:   string       # Mach-O segment name;
    data:       ByteBuffer;
    alignment:  int;
    relocs:     Vec<Relocation>;
end.

func section_text:
    out Section {;
        name: str_new("__text"),;
        seg_name: str_new("__TEXT"),;
        data: buf_new(),;
        alignment: 4,;
        relocs: vec_new();
    };
end.

func section_data:
    out Section {;
        name: str_new("__data"),;
        seg_name: str_new("__DATA"),;
        data: buf_new(),;
        alignment: 8,;
        relocs: vec_new();
    };
end.

func section_const:
    out Section {;
        name: str_new("__const"),;
        seg_name: str_new("__TEXT"),;
        data: buf_new(),;
        alignment: 16,;
        relocs: vec_new();
    };
end.


# ═══════════════════════════════════════════════════════
# Mach-O Constants
# ═══════════════════════════════════════════════════════

# Magic numbers
const MH_MAGIC_64: 0xFEEDFACF;
const MH_OBJECT: 1     # relocatable object file;

# CPU types
const CPU_TYPE_ARM64: 0x0100000C   # CPU_TYPE_ARM | CPU_ARCH_ABI64;
const CPU_TYPE_X86_64: 0x01000007   # CPU_TYPE_X86 | CPU_ARCH_ABI64;
const CPU_SUBTYPE_ALL: 0;

# Load command types
const LC_SEGMENT_64: 0x19;
const LC_SYMTAB: 0x02;
const LC_BUILD_VERSION: 0x32;

# Section types
const S_REGULAR: 0x00;
const S_ATTR_PURE_INSTRUCTIONS: 0x80000000;
const S_ATTR_SOME_INSTRUCTIONS: 0x00000400;


# ═══════════════════════════════════════════════════════
# Mach-O Object Builder
# ═══════════════════════════════════════════════════════

entity MachOBuilder:
    arch:       Arch;
    sections:   Vec<Section>;
    symbols:    Vec<Symbol>;
    strtab:     ByteBuffer;
end.

func macho_new:
    in(arch:Arch)
    builder = MachOBuilder {;
        arch: arch,;
        sections: vec_new(),;
        symbols: vec_new(),;
        strtab: buf_new();
    };
    # strtab starts with a null byte
    builder.strtab = buf_write_u8(builder.strtab, 0);
    out builder;
end.

func macho_add_section:
    in(builder:MachOBuilder; sec:Section)
    vec_push(builder.sections, sec);
    out builder;
end.

func macho_add_symbol:
    in(builder:MachOBuilder; sym:Symbol)
    vec_push(builder.symbols, sym);
    out builder;
end.

func macho_strtab_add:
    in(builder:MachOBuilder; name:string)
    offset = buf_size(builder.strtab) >> int;
    # Write string bytes + null terminator
    i = 0;
    when i < str_len(name) loop
        builder.strtab = buf_write_u8(builder.strtab, str_byte_at(name, i));
        i = i + 1;
    end
    builder.strtab = buf_write_u8(builder.strtab, 0);
    out (builder, offset);
end.


# ═══════════════════════════════════════════════════════
# Emit Mach-O Header
# ═══════════════════════════════════════════════════════

func macho_emit_header:
    in(buf:ByteBuffer; arch:Arch; ncmds:int; sizeofcmds:int)
    # Mach-O 64-bit header = 32 bytes
    buf = buf_write_u32_le(buf, MH_MAGIC_64);

    if arch == Arch::ARM64:
        buf = buf_write_u32_le(buf, CPU_TYPE_ARM64);
    else
        buf = buf_write_u32_le(buf, CPU_TYPE_X86_64);
    end

    buf = buf_write_u32_le(buf, CPU_SUBTYPE_ALL)   # cpusubtype;
    buf = buf_write_u32_le(buf, MH_OBJECT)         # filetype;
    buf = buf_write_u32_le(buf, ncmds)             # ncmds;
    buf = buf_write_u32_le(buf, sizeofcmds)        # sizeofcmds;
    buf = buf_write_u32_le(buf, 0)                 # flags;
    buf = buf_write_u32_le(buf, 0)                 # reserved (64-bit);
    out buf;
end.


# ═══════════════════════════════════════════════════════
# Emit LC_SEGMENT_64
# ═══════════════════════════════════════════════════════

func macho_emit_segment_cmd:
    in(buf:ByteBuffer; seg_name:string; nsects:int; sect_data_offset:int; sect_data_size: int)
    # LC_SEGMENT_64 = 72 bytes + 80 bytes per section
    cmdsize = 72 + nsects * 80 >> int;

    buf = buf_write_u32_le(buf, LC_SEGMENT_64);
    buf = buf_write_u32_le(buf, cmdsize);
    buf = buf_write_string_padded(buf, seg_name, 16)      # segname[16];
    buf = buf_write_u64_le(buf, 0)                        # vmaddr;
    buf = buf_write_u64_le(buf, sect_data_size >> int)  # vmsize;
    buf = buf_write_u64_le(buf, sect_data_offset >> int) # fileoff;
    buf = buf_write_u64_le(buf, sect_data_size >> int)   # filesize;
    buf = buf_write_u32_le(buf, 7)                        # maxprot (rwx);
    buf = buf_write_u32_le(buf, 7)                        # initprot (rwx);
    buf = buf_write_u32_le(buf, nsects);
    buf = buf_write_u32_le(buf, 0)                        # flags;

    out buf;
end.


# ═══════════════════════════════════════════════════════
# Emit Section Header (within LC_SEGMENT_64)
# ═══════════════════════════════════════════════════════

func macho_emit_section_hdr:
    in(buf:ByteBuffer; sec:Section; file_offset:int; reloc_offset:int)
    # Section header = 80 bytes
    buf = buf_write_string_padded(buf, sec.name, 16)      # sectname[16];
    buf = buf_write_string_padded(buf, sec.seg_name, 16)  # segname[16];
    buf = buf_write_u64_le(buf, 0)                        # addr;
    buf = buf_write_u64_le(buf, buf_size(sec.data) >> int)  # size;
    buf = buf_write_u32_le(buf, file_offset >> int)        # offset;
    buf = buf_write_u32_le(buf, sec.alignment >> int)      # align (2^n);
    buf = buf_write_u32_le(buf, reloc_offset >> int)       # reloff;
    buf = buf_write_u32_le(buf, vec_len(sec.relocs) >> int) # nreloc;
    buf = buf_write_u32_le(buf, S_REGULAR)                 # flags;
    buf = buf_write_u32_le(buf, 0)                         # reserved1;
    buf = buf_write_u32_le(buf, 0)                         # reserved2;
    buf = buf_write_u32_le(buf, 0)                         # reserved3 (64-bit);

    out buf;
end.


# ═══════════════════════════════════════════════════════
# Emit LC_SYMTAB
# ═══════════════════════════════════════════════════════

func macho_emit_symtab_cmd:
    in(buf:ByteBuffer; symoff:int; nsyms:int; stroff:int; strsize:int)
    buf = buf_write_u32_le(buf, LC_SYMTAB);
    buf = buf_write_u32_le(buf, 24)        # cmdsize;
    buf = buf_write_u32_le(buf, symoff);
    buf = buf_write_u32_le(buf, nsyms);
    buf = buf_write_u32_le(buf, stroff);
    buf = buf_write_u32_le(buf, strsize);
    out buf;
end.


# ═══════════════════════════════════════════════════════
# Build Complete Object File
# ═══════════════════════════════════════════════════════

func macho_build:
    in(builder:MachOBuilder)
    out = buf_new();

    nsections = vec_len(builder.sections) >> int;
    if nsections == 0:
        out Err(str_new("No sections to emit"));
    end

    # Calculate layout
    header_size = 32 >> int;
    segment_cmd_size = (72 + nsections * 80) >> int;
    symtab_cmd_size = 24 >> int;
    total_cmd_size = segment_cmd_size + symtab_cmd_size;
    data_offset = header_size + total_cmd_size;

    # Calculate total section data size
    total_data_size = 0;
    i = 0;
    when i < nsections as i32 loop
        total_data_size = total_data_size + buf_size(vec_get(builder.sections, i).data);
        i = i + 1;
    end

    # Emit header (2 load commands: LC_SEGMENT_64, LC_SYMTAB)
    out = macho_emit_header(out, builder.arch, 2, total_cmd_size >> int);

    # Emit LC_SEGMENT_64 command
    out = macho_emit_segment_cmd(out, str_new(""), nsections,;
                                  data_offset, total_data_size);

    # Emit section headers
    sec_offset = data_offset;
    i = 0;
    when i < nsections as i32 loop
        sec = vec_get(builder.sections, i);
        out = macho_emit_section_hdr(out, sec, sec_offset, 0);
        sec_offset = sec_offset + buf_size(sec.data);
        i = i + 1;
    end

    # Emit LC_SYMTAB command
    symoff = (data_offset + total_data_size) >> int;
    nsyms = vec_len(builder.symbols) >> int;
    stroff = symoff + nsyms * 16   # nlist_64 = 16 bytes each;
    strsize = buf_size(builder.strtab) >> int;
    out = macho_emit_symtab_cmd(out, symoff, nsyms, stroff, strsize);

    # Emit section data
    i = 0;
    when i < nsections as i32 loop
        sec = vec_get(builder.sections, i);
        out = buf_write_bytes(out, sec.data.data);
        i = i + 1;
    end

    # Emit symbol table (nlist_64 entries)
    i = 0;
    when i < vec_len(builder.symbols) loop
        sym = vec_get(builder.symbols, i);
        var (builder2, str_idx) = macho_strtab_add(builder, sym.name);
        builder = builder2;

        out = buf_write_u32_le(out, str_idx >> int)     # n_strx;
        if sym.is_global:
            out = buf_write_u8(out, 0x0F)                       # n_type: N_EXT | N_SECT;
        else
            out = buf_write_u8(out, 0x0E)                       # n_type: N_SECT;
        end
        out = buf_write_u8(out, sym.section >> int)       # n_sect;
        out = buf_write_u16_le(out, 0)                          # n_desc;
        out = buf_write_u64_le(out, sym.offset >> int)   # n_value;

        i = i + 1;
    end

    # Emit string table
    out = buf_write_bytes(out, builder.strtab.data);

    out Ok(out);
end.


# ═══════════════════════════════════════════════════════
# High-Level API
# ═══════════════════════════════════════════════════════

func emit_object_file:
    in(code:Vec<int>; arch:Arch)
    builder = macho_new(arch);

    # Create __text section with the machine code
    text = section_text();
    text.data = buf_new();
    text.data = buf_write_bytes(text.data, code);

    builder = macho_add_section(builder, text);

    out macho_build(builder);
end.

func emit_kernel_object:
    in(kernel_name:string; code:Vec<int>; arch:Arch)
    builder = macho_new(arch);

    # Text section
    text = section_text();
    text.data = buf_new();
    text.data = buf_write_bytes(text.data, code);
    builder = macho_add_section(builder, text);

    # Add kernel as global symbol
    builder = macho_add_symbol(builder, Symbol {;
        name: format("_vir_{}", kernel_name),;
        sym_type: SymbolType::Function,;
        section: 1,;
        offset: 0,;
        size: vec_len(code) >> int,;
        is_global: true;
    });

    out macho_build(builder);
end.

# ═══ END: stdlib/vir/compiler/binary.vri ═══

# [merged] import Arch, ByteBuffer, buf_new, buf_write_u8 from binary;
# [merged-cont] buf_write_u32_le, buf_write_u64_le, buf_write_zeros,;
# [merged-cont] buf_write_string_padded, buf_write_bytes, buf_size, buf_align;
# [merged] include linker;
# ═══ BEGIN: stdlib/vir/compiler/linker.vri ═══
##
 * vir/codegen/linker.vri — Self-Hosting Linker
 * ==============================================
 * Step 3: Cut the umbilical cord — Vir links its own binaries
 *
 * Resolves symbols, applies relocations, and produces
 * a final executable Mach-O binary without external ld.
 *
 * Pipeline:
 *   Object files -> Symbol resolution -> Relocation -> Executable
 ##

# [merged] include types;
# [merged] include result;
# [merged] import Result, Ok, Err from result;
# [merged] include option;
# [merged] import Option, Some, None from option;
# [merged] include string;
# [merged] import String, str_new, str_concat, str_eq, str_len from string;
# [merged] include vec;
# [merged] import Vec, vec_new, vec_push, vec_len, vec_get from vec;
# [merged] include map;
# [merged] import Map, map_new, map_set, map_get, map_contains from map;
# [merged] include binary;

# ═══════════════════════════════════════════════════════
# Mach-O Executable Constants
# ═══════════════════════════════════════════════════════

const MH_EXECUTE: 2     # Executable file;
const LC_MAIN: 0x80000028;
const LC_LOAD_DYLIB: 0x0C;
const LC_DYLD_INFO_ONLY: 0x80000022;

# Base addresses (macOS ARM64)
const TEXT_BASE: 0x100000000;
const DATA_BASE: 0x100004000;
const PAGE_SIZE: 0x4000;


# ═══════════════════════════════════════════════════════
# Object File Input
# ═══════════════════════════════════════════════════════

entity ObjectFile:
    name:       string;
    sections:   Vec<Section>;
    symbols:    Vec<Symbol>;
    relocs:     Vec<Relocation>;
end.


# ═══════════════════════════════════════════════════════
# Resolved Symbol
# ═══════════════════════════════════════════════════════

entity ResolvedSymbol:
    name:           string;
    final_address:  int;
    obj_idx:        int;
    sec_idx:        int;
    is_external:    bool;
end.


# ═══════════════════════════════════════════════════════
# Linker State
# ═══════════════════════════════════════════════════════

entity Linker:
    objects:        Vec<ObjectFile>;
    symtab:         Map<string, ResolvedSymbol>;
    text_buf:       ByteBuffer;
    data_buf:       ByteBuffer;
    entry_point:    int;
    errors:         Vec<string>;
end.

func linker_new:
    out Linker {;
        objects: vec_new(),;
        symtab: map_new(),;
        text_buf: buf_new(),;
        data_buf: buf_new(),;
        entry_point: TEXT_BASE,;
        errors: vec_new();
    };
end.


# ═══════════════════════════════════════════════════════
# Step 1: Add Object Files
# ═══════════════════════════════════════════════════════

func linker_add_object:
    in(lnk:Linker; obj:ObjectFile)
    vec_push(lnk.objects, obj);
    out lnk;
end.


# ═══════════════════════════════════════════════════════
# Step 2: Symbol Resolution
# ═══════════════════════════════════════════════════════

func linker_resolve_symbols:
    in(lnk:Linker)
    # First pass: collect all global symbols with their offsets
    text_offset = 0;

    obj_i = 0;
    when obj_i < vec_len(lnk.objects) loop
        obj = vec_get(lnk.objects, obj_i);

        sym_i = 0;
        when sym_i < vec_len(obj.symbols) loop
            sym = vec_get(obj.symbols, sym_i);

            if sym.is_global:
                if map_contains(lnk.symtab, sym.name):
                    vec_push(lnk.errors, format(;
                        "Duplicate symbol: {} (in {} and previous object)",;
                        sym.name, obj.name));
                else
                    resolved = ResolvedSymbol {;
                        name: sym.name,;
                        final_address: TEXT_BASE + text_offset + (sym.offset >> int),;
                        obj_idx: obj_i,;
                        sec_idx: sym.section,;
                        is_external: false;
                    };
                    map_set(lnk.symtab, sym.name, resolved);
                end
            end

            sym_i = sym_i + 1;
        end

        # Accumulate text section sizes
        sec_i = 0;
        when sec_i < vec_len(obj.sections) loop
            sec = vec_get(obj.sections, sec_i);
            if str_eq(sec.name, str_new("__text")):
                text_offset = text_offset + (buf_size(sec.data) >> int);
            end
            sec_i = sec_i + 1;
        end

        obj_i = obj_i + 1;
    end

    # Find _main entry point
    main_sym = map_get(lnk.symtab, str_new("_main"));
    if main_sym != None:
        lnk.entry_point = main_sym.final_address;
    end

    out lnk;
end.


# ═══════════════════════════════════════════════════════
# Step 3: Apply Relocations
# ═══════════════════════════════════════════════════════

func linker_apply_relocations:
    in(lnk:Linker)
    obj_i = 0;
    when obj_i < vec_len(lnk.objects) loop
        obj = vec_get(lnk.objects, obj_i);

        sec_i = 0;
        when sec_i < vec_len(obj.sections) loop
            sec = vec_get(obj.sections, sec_i);

            rel_i = 0;
            when rel_i < vec_len(sec.relocs) loop
                reloc = vec_get(sec.relocs, rel_i);
                target_sym = vec_get(obj.symbols, reloc.sym_idx);
                resolved = map_get(lnk.symtab, target_sym.name);

                if resolved == None:
                    vec_push(lnk.errors, format(;
                        "Undefined symbol: {} (referenced in {})",;
                        target_sym.name, obj.name));
                else
                    # Apply relocation based on type
                    if reloc.reloc_type == RelocType::Branch26:
                        # ARM64 B/BL: 26-bit signed offset (in 4-byte units)
                        pc = TEXT_BASE + (reloc.offset >> int);
                        delta = (resolved.final_address - pc) >> int;
                        imm26 = ((delta >> 2) & 0x03FFFFFF) >> int;
                        # Patch instruction: BL = 0x94000000 | imm26
                        patch_u32(sec.data, reloc.offset >> int,;
                                  0x94000000 | imm26);
                    end

                    if reloc.reloc_type == RelocType::Page21:
                        # ARM64 ADRP: 21-bit page offset
                        pc_page = (TEXT_BASE + (reloc.offset >> int)) & ~0xFFF_u64;
                        sym_page = resolved.final_address & ~0xFFF_u64;
                        page_delta = ((sym_page - pc_page) >> 12) >> int;
                        # Encode immhi:immlo into ADRP instruction
                        immlo = (page_delta & 0x3) >> int;
                        immhi = ((page_delta >> 2) & 0x7FFFF) >> int;
                        insn = 0x90000000_u32 | (immlo << 29) | (immhi << 5);
                        patch_u32(sec.data, reloc.offset >> int, insn);
                    end

                    if reloc.reloc_type == RelocType::PageOff12:
                        # ARM64 ADD: 12-bit page offset
                        page_off = (resolved.final_address & 0xFFF) >> int;
                        insn = read_u32(sec.data, reloc.offset >> int);
                        insn = (insn & 0xFFC003FF_u32) | (page_off << 10);
                        patch_u32(sec.data, reloc.offset >> int, insn);
                    end

                    if reloc.reloc_type == RelocType::PC32:
                        # x86-64: 32-bit PC-relative
                        pc = TEXT_BASE + (reloc.offset >> int) + 4;
                        delta = (resolved.final_address - pc) >> int;
                        patch_i32(sec.data, reloc.offset >> int, delta);
                    end
                end

                rel_i = rel_i + 1;
            end

            sec_i = sec_i + 1;
        end

        obj_i = obj_i + 1;
    end
    out lnk;
end.


# ═══════════════════════════════════════════════════════
# Step 4: Merge Sections
# ═══════════════════════════════════════════════════════

func linker_merge_sections:
    in(lnk:Linker)
    obj_i = 0;
    when obj_i < vec_len(lnk.objects) loop
        obj = vec_get(lnk.objects, obj_i);

        sec_i = 0;
        when sec_i < vec_len(obj.sections) loop
            sec = vec_get(obj.sections, sec_i);

            if str_eq(sec.seg_name, str_new("__TEXT")):
                lnk.text_buf = buf_write_bytes(lnk.text_buf, sec.data.data);
                # Align to 4 bytes for ARM64 instructions
                lnk.text_buf = buf_align(lnk.text_buf, 4);
            end

            if str_eq(sec.seg_name, str_new("__DATA")):
                lnk.data_buf = buf_write_bytes(lnk.data_buf, sec.data.data);
                lnk.data_buf = buf_align(lnk.data_buf, 8);
            end

            sec_i = sec_i + 1;
        end

        obj_i = obj_i + 1;
    end
    out lnk;
end.


# ═══════════════════════════════════════════════════════
# Step 5: Emit Final Executable
# ═══════════════════════════════════════════════════════

func linker_emit_executable:
    in(lnk:Linker; arch:Arch)
    # Check for errors
    if vec_len(lnk.errors) > 0:
        msg = str_new("Linker errors:\n");
        i = 0;
        when i < vec_len(lnk.errors) loop
            msg = str_concat(msg, format("  - {}\n", vec_get(lnk.errors, i)));
            i = i + 1;
        end
        out Err(msg);
    end

    out = buf_new();

    text_size = buf_size(lnk.text_buf) >> int;
    data_size = buf_size(lnk.data_buf) >> int;

    # Align sizes to page boundaries
    text_filesize = ((text_size + PAGE_SIZE - 1) / PAGE_SIZE) * PAGE_SIZE;
    data_filesize = ((data_size + PAGE_SIZE - 1) / PAGE_SIZE) * PAGE_SIZE;

    # Load commands: __PAGEZERO + __TEXT + __DATA + LC_MAIN + LC_SYMTAB = 5
    ncmds = 5_u32;
    header_and_cmds_size = 32 + 72 + (72 + 80) + (72 + 80) + 24 + 24;

    # ── Mach-O Header ──
    out = buf_write_u32_le(out, MH_MAGIC_64);
    if arch == Arch::ARM64:
        out = buf_write_u32_le(out, CPU_TYPE_ARM64);
    else
        out = buf_write_u32_le(out, CPU_TYPE_X86_64);
    end
    out = buf_write_u32_le(out, CPU_SUBTYPE_ALL);
    out = buf_write_u32_le(out, MH_EXECUTE);
    out = buf_write_u32_le(out, ncmds);
    out = buf_write_u32_le(out, (header_and_cmds_size - 32) >> int);
    out = buf_write_u32_le(out, 0x00200085_u32)  # MH_PIE | MH_TWOLEVEL | MH_DYLDLINK;
    out = buf_write_u32_le(out, 0)               # reserved;

    # ── LC_SEGMENT_64: __PAGEZERO ──
    out = buf_write_u32_le(out, LC_SEGMENT_64);
    out = buf_write_u32_le(out, 72)         # cmdsize (no sections);
    out = buf_write_string_padded(out, str_new("__PAGEZERO"), 16);
    out = buf_write_u64_le(out, 0)          # vmaddr;
    out = buf_write_u64_le(out, TEXT_BASE)   # vmsize = 4GB;
    out = buf_write_u64_le(out, 0)          # fileoff;
    out = buf_write_u64_le(out, 0)          # filesize;
    out = buf_write_u32_le(out, 0)          # maxprot;
    out = buf_write_u32_le(out, 0)          # initprot;
    out = buf_write_u32_le(out, 0)          # nsects;
    out = buf_write_u32_le(out, 0)          # flags;

    # ── LC_SEGMENT_64: __TEXT ──
    out = macho_emit_segment_cmd(out, str_new("__TEXT"), 1,;
                                  0, text_filesize >> int);
    text_sec = section_text();
    text_sec.data = lnk.text_buf;
    out = macho_emit_section_hdr(out, text_sec,;
                                  header_and_cmds_size >> int, 0);

    # ── LC_SEGMENT_64: __DATA ──
    out = macho_emit_segment_cmd(out, str_new("__DATA"), 1,;
                                  text_filesize >> int, data_filesize >> int);
    data_sec = section_data();
    data_sec.data = lnk.data_buf;
    out = macho_emit_section_hdr(out, data_sec,;
                                  (header_and_cmds_size >> int + text_filesize) >> int, 0);

    # ── LC_MAIN ──
    out = buf_write_u32_le(out, LC_MAIN);
    out = buf_write_u32_le(out, 24)                        # cmdsize;
    out = buf_write_u64_le(out, lnk.entry_point - TEXT_BASE)  # entryoff;
    out = buf_write_u64_le(out, 0)                         # stacksize (default);

    # ── LC_SYMTAB (empty for minimal executable) ──
    out = macho_emit_symtab_cmd(out, 0, 0, 0, 0);

    # Pad header to page boundary
    pad_needed = (text_filesize >> int) - (buf_size(out));
    if pad_needed > 0:
        out = buf_write_zeros(out, pad_needed >> int);
    end

    # Write __TEXT data
    out = buf_write_bytes(out, lnk.text_buf.data);
    # Pad to page
    text_pad = (text_filesize >> int) - (buf_size(lnk.text_buf));
    if text_pad > 0:
        out = buf_write_zeros(out, text_pad >> int);
    end

    # Write __DATA data
    out = buf_write_bytes(out, lnk.data_buf.data);
    data_pad = (data_filesize >> int) - (buf_size(lnk.data_buf));
    if data_pad > 0:
        out = buf_write_zeros(out, data_pad >> int);
    end

    out Ok(out);
end.


# ═══════════════════════════════════════════════════════
# High-Level API — Link and Produce Executable
# ═══════════════════════════════════════════════════════

func link_objects:
    in(objects:Vec<ObjectFile>; arch:Arch)
    lnk = linker_new();

    # Add all objects
    i = 0;
    when i < vec_len(objects) loop
        lnk = linker_add_object(lnk, vec_get(objects, i));
        i = i + 1;
    end

    # Pipeline: resolve -> relocate -> merge -> emit
    lnk = linker_resolve_symbols(lnk);
    lnk = linker_apply_relocations(lnk);
    lnk = linker_merge_sections(lnk);

    out linker_emit_executable(lnk, arch);
end.


func link_single_kernel:
    in(kernel_name:string; code:Vec<int>; arch:Arch)
    # Convenience: wrap raw machine code into an object and link
    obj = ObjectFile {;
        name: format("{}.o", kernel_name),;
        sections: vec_new(),;
        symbols: vec_new(),;
        relocs: vec_new();
    };

    text = section_text();
    text.data = buf_new();
    text.data = buf_write_bytes(text.data, code);
    vec_push(obj.sections, text);

    vec_push(obj.symbols, Symbol {;
        name: format("_main"),;
        sym_type: SymbolType::Function,;
        section: 1,;
        offset: 0,;
        size: vec_len(code) >> int,;
        is_global: true;
    });

    objects = vec_new();
    vec_push(objects, obj);
    out link_objects(objects, arch);
end.

# ═══ END: stdlib/vir/compiler/linker.vri ═══

# [merged] import link_single_kernel from linker;
# [merged] include file;
# ═══ BEGIN: stdlib/vir/compiler/file.vri ═══
##
 * vir/io/file.vri — File I/O
 * ============================
 * Inspired by C23: <stdio.h> fopen, fread, fwrite, fclose, fseek, ftell
 * Inspired by Python: open(), file.read(), file.write(), pathlib
 *
 * Compiler uses internally: đọc source file, ghi binary output.
 ##

# [merged] include types;
# [merged] include result;
# [merged] import Result, Ok, Err from result;
# [merged] include option;
# [merged] import Option, Some, None from option;
# [merged] include string;
