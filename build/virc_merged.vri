##
 * vir/io/traits.vri — Reader / Writer Interfaces
 * ================================================
 * Inspired by C23: FILE* + fread/fwrite
 * Inspired by Python: io.RawIOBase, io.BufferedIOBase
 *
 * Mọi I/O in Vir đều thông qua Reader/Writer interface.
 ##

# [merged] include types;
# [merged] include result;
# [merged] import Result, Ok, Err from result;
# [merged] include slice;
# [merged] import Slice from slice;
# [merged] include error;
# ═══ BEGIN: stdlib/vir/error/error.vri ═══
##
 * vir/error/error.vri — Error Types & Handling
 * ===============================================
 * Inspired by Python: BaseException hierarchy
 * Inspired by Rust: Error trait, thiserror
 * Inspired by C23: errno.h
 *
 * Vir sử dụng Result<T,E> thay vì exception — nhưng cần hierarchy
 * error types để phân biệt loại lỗi.
 ##

# [merged] include types;
# [merged] include result;
# [merged] import Result, Ok, Err from result;
# [merged] include option;
# [merged] import Option, Some, None from option;
# [merged] include string;
# [merged] import String, str_new, str_concat from string;

# ═══════════════════════════════════════════════════════
# Error Kinds — Các loại lỗi cơ bản
# ═══════════════════════════════════════════════════════

enum ErrorKind:
    # I/O
    NotFound        = 1;
    PermissionDenied = 2;
    AlreadyExists   = 3;
    BrokenPipe      = 4;
    WouldBlock      = 5;
    TimedOut        = 6;
    ConnectionRefused = 7;
    ConnectionReset = 8;
    Interrupted     = 9;
    UnexpectedEof   = 10;
    
    # Parse
    InvalidInput    = 20;
    InvalidData     = 21;
    InvalidEncoding = 22;
    ParseIntError   = 23;
    ParseFloatError = 24;
    SyntaxError     = 25;
    
    # Runtime
    OutOfMemory     = 40;
    Overflow        = 41;
    DivisionByZero  = 42;
    IndexOutOfBounds = 43;
    NullPointer     = 44;
    StackOverflow   = 45;
    
    # Logic
    Unimplemented   = 60;
    Unreachable     = 61;
    AssertionFailed = 62;
    
    # Generic
    Other           = 99;
end

enum IoErrorKind:
    NotFound           = 1;
    PermissionDenied   = 2;
    AlreadyExists      = 3;
    BrokenPipe         = 4;
    WouldBlock         = 5;
    TimedOut           = 6;
    ConnectionRefused  = 7;
    ConnectionReset    = 8;
    Interrupted        = 9;
    UnexpectedEof      = 10;
    InvalidInput       = 20;
    InvalidData        = 21;
    InvalidEncoding    = 22;
    ParseIntError      = 23;
    ParseFloatError    = 24;
    SyntaxError        = 25;
    OutOfMemory        = 40;
    Overflow           = 41;
    DivisionByZero     = 42;
    IndexOutOfBounds   = 43;
    NullPointer        = 44;
    StackOverflow      = 45;
    Unimplemented      = 60;
    Unreachable        = 61;
    AssertionFailed    = 62;
    Other              = 99;
end

# ═══════════════════════════════════════════════════════
# Error — Generic error type
# ═══════════════════════════════════════════════════════

entity Error:
    kind:    ErrorKind;
    message: string;
    source:  Option<ptr>   # chain to cause (optional);
end

entity IoError:
    kind: IoErrorKind;
    msg:  string;
end

entity ParseError:
    msg: string;
end

# ─── Constructors ─────────────────────────────────────

func error_new:
    in(kind:ErrorKind; msg:string)
    out Error { kind = kind, message = msg, source = None };
end

func error_with_source:
    in(kind:ErrorKind; msg:string; src:Error)
    # Chuỗi lỗi: error này gây ra bởi src.
    src_ptr = native_box(src)   # heap-allocate cause;
    out Error { kind = kind, message = msg, source = Some(src_ptr) };
end

# ─── Access ───────────────────────────────────────────

func error_kind:
    in(e:Error)
    out e.kind;
end

func error_message:
    in(e:Error)
    out e.message;
end

func error_source:
    in(e:Error)
    case e.source;
        case Some(p) out Some(native_unbox<Error>(p))
        case None out None
    end
end

# ─── Display ──────────────────────────────────────────

func error_to_string:
    in(e:Error)
    prefix = error_kind_name(e.kind);
    out str_concat(str_concat(prefix, str_new(": ")), e.message);
end

func error_chain:
    in(e:Error)
    # In toàn bộ string lỗi: "kind: msg\n caused by: ..."
    s = error_to_string(e);
    cause = error_source(e);
    when is_some(cause) loop
        c = unwrap(cause);
        s = str_concat(s, str_new("\n  caused by: "));
        s = str_concat(s, error_to_string(c));
        cause = error_source(c);
    end
    out s;
end

func error_kind_name:
    in(kind:ErrorKind)
    case kind;
        case ErrorKind.NotFound out str_new("NotFound")
        case ErrorKind.PermissionDenied out str_new("PermissionDenied")
        case ErrorKind.AlreadyExists out str_new("AlreadyExists")
        case ErrorKind.BrokenPipe out str_new("BrokenPipe")
        case ErrorKind.InvalidInput out str_new("InvalidInput")
        case ErrorKind.InvalidData out str_new("InvalidData")
        case ErrorKind.ParseIntError out str_new("ParseIntError")
        case ErrorKind.ParseFloatError out str_new("ParseFloatError")
        case ErrorKind.SyntaxError out str_new("SyntaxError")
        case ErrorKind.OutOfMemory out str_new("OutOfMemory")
        case ErrorKind.Overflow out str_new("Overflow")
        case ErrorKind.DivisionByZero out str_new("DivisionByZero")
        case ErrorKind.IndexOutOfBounds out str_new("IndexOutOfBounds")
        case ErrorKind.NullPointer out str_new("NullPointer")
        case ErrorKind.Unimplemented out str_new("Unimplemented")
        case ErrorKind.AssertionFailed out str_new("AssertionFailed")
        default out str_new("Error");
    end
end

# ═══════════════════════════════════════════════════════
# Convenience Constructors
# ═══════════════════════════════════════════════════════

func io_error:
    in(msg:string)
    out error_new(ErrorKind.NotFound, msg);
end

func parse_error:
    in(msg:string)
    out error_new(ErrorKind.InvalidInput, msg);
end

func overflow_error:
    in(msg:string)
    out error_new(ErrorKind.Overflow, msg);
end

func index_error:
    in(msg:string)
    out error_new(ErrorKind.IndexOutOfBounds, msg);
end

func null_error:
    out error_new(ErrorKind.NullPointer, str_new("null pointer dereference"));
end

func todo_error:
    in(msg:string)
    out error_new(ErrorKind.Unimplemented, msg);
end

# ═══════════════════════════════════════════════════════
# IoError — Specialized cho I/O
# ═══════════════════════════════════════════════════════

entity IoError:
    kind:    ErrorKind;
    message: string;
    errno:   int           # POSIX errno;
end

func io_error_from_errno:
    in(errno:int)
    var kind:ErrorKind;
    var msg:string;
    
    case errno;
        case 2 # ENOENT
            kind = ErrorKind.NotFound;
            msg = str_new("file not found");
        case 13 # EACCES
            kind = ErrorKind.PermissionDenied;
            msg = str_new("permission denied");
        case 17 # EEXIST
            kind = ErrorKind.AlreadyExists;
            msg = str_new("already exists");
        case 12 # ENOMEM
            kind = ErrorKind.OutOfMemory;
            msg = str_new("out of memory");
        default;
            kind = ErrorKind.Other;
            msg = str_new("I/O error");
    end
    
    out IoError { kind = kind, message = msg, errno = errno };
end

func io_error_to_error:
    in(e:IoError)
    out error_new(e.kind, e.message);
end

# ═══════════════════════════════════════════════════════
# Panic — Unrecoverable error
# ═══════════════════════════════════════════════════════

func panic_msg:
    in(msg:string)
    # Ghi lỗi ra stderr, dump trace, abort.
    eprintln(str_concat(str_new("PANIC: "), msg));
    native_abort();
end

func unreachable:
    panic_msg(str_new("entered unreachable code"));
end

func unimplemented:
    in(feature:string)
    panic_msg(str_concat(str_new("not yet implemented: "), feature));
end

func todo:
    in(what:string)
    panic_msg(str_concat(str_new("TODO: "), what));
end

# ═══ END: stdlib/vir/error/error.vri ═══

# [merged] import IoError from error;

# ═══════════════════════════════════════════════════════
# Reader — đọc dữ liệu
# ═══════════════════════════════════════════════════════

giao_diện Reader;
    func read:
        in(buf:Slice)
    # Đọc tối đa buf.len bytes vào buf.
    # Returns số bytes đọc được (có thể < buf.len).
    # Returns Ok(0) khi EOF.
end

# ═══════════════════════════════════════════════════════
# Writer — ghi dữ liệu
# ═══════════════════════════════════════════════════════

giao_diện Writer;
    func write:
        in(data:Slice)
    # Ghi tối đa data.len bytes từ data.
    # Returns số bytes ghi được.

    func flush:
    # Đẩy buffer ra output thực tế.
end

# ═══════════════════════════════════════════════════════
# Seeker — di chuyển vị trí đọc/ghi
# ═══════════════════════════════════════════════════════

enum SeekFrom:
    Start = 0       # Từ đầu file;
    Current = 1     # Từ vị trí hiện tại;
    End = 2         # Từ cuối file;
end

giao_diện Seeker;
    func seek:
        in(offset:int; whence:SeekFrom)
    # Di chuyển vị trí. Returns vị trí mới.
end

# ═══════════════════════════════════════════════════════
# ReadWriter — kết hợp Reader + Writer
# ═══════════════════════════════════════════════════════

giao_diện ReadWriter;
    thực_hiện Reader;
    thực_hiện Writer;
end

# ═══════════════════════════════════════════════════════
# Helper functions
# ═══════════════════════════════════════════════════════

func read_all:
    in(reader:Reader)
    # Đọc tất cả dữ liệu từ reader cho đến EOF.
    result = buffer_new(4096);
    buf = alloc(4096);
    slice = slice_new(buf, 4096);

    loop_running = true;
    when loop_running loop
        n = reader.read(slice);
        case n;
            case Ok(0) loop_running = false
            case Ok(count) buffer_write_bytes(result, buf, count)
            case Err(e)
                free(buf);
                buffer_free(result);
                out Err(e);
        end
    end

    free(buf);
    out Ok(result);
end

func write_all:
    in(writer:Writer; data:Slice)
    # Ghi toàn bộ data, retry if ghi chưa end.
    written = 0;
    when written < data.len loop
        remaining = slice_sub(data, written, data.len);
        n = writer.write(remaining);
        case n;
            case Ok(count) written = written + count
            case Err(e) out Err(e)
        end
    end
    out Ok(void);
end

func copy:
    in(reader:Reader; writer:Writer)
    # Copy tất cả từ reader sang writer. Returns tổng bytes copied.
    total = 0;
    buf = alloc(8192);
    slice = slice_new(buf, 8192);

    loop_running = true;
    when loop_running loop
        n = reader.read(slice);
        case n;
            case Ok(0) loop_running = false
            case Ok(count)
                w = writer.write(slice_new(buf, count));
                case w;
                    case Ok(_) total = total + count
                    case Err(e) free(buf); out Err(e)
                end
            case Err(e) free(buf); out Err(e)
        end
    end

    free(buf);
    out Ok(total);
end

# ═══ END: stdlib/vir/io/traits.vri ═══

# [merged] import Reader, Writer, Seeker, SeekFrom from traits;
# [merged] include error;
# [merged] import IoError, IoErrorKind from error;

enum FileMode:
    Read      = 1     # Mở để đọc (file phải tồn tại);
    Write     = 2     # Mở để ghi (tạo mới or truncate);
    Append    = 4     # Mở để ghi thêm cuối file;
    ReadWrite = 3     # Mở để đọc + ghi;
end.

entity File:
    fd: int           # Native file descriptor / handle;
    path: string;
    mode: FileMode;
    closed: bool;
end.

# ═══════════════════════════════════════════════════════
# Mở / Đóng file
# ═══════════════════════════════════════════════════════

func file_open:
    in(path:string; mode:FileMode)
    fd = native_file_open(path.data, path.byte_len, mode);
    if fd < 0:
        out Err(IoError {;
            kind: io_error_from_errno(native_errno()),;
            msg: "cannot open file: " + path;
        });
    end
    out Ok(File { fd: fd, path: path, mode: mode, closed: false });
end.

func file_create:
    in(path:string)
    out file_open(path, FileMode.Write);
end.

func file_close:
    in(f:File)
    if f.closed out Ok(void) end:
    r = native_file_close(f.fd);
    f.closed = true;
    if r < 0:
        out Err(IoError { kind: IoErrorKind.Other, msg: "close failed" });
    end
    out Ok(void);
end.

# ═══════════════════════════════════════════════════════
# Đọc file
# ═══════════════════════════════════════════════════════

func file_read:
    in(f:File; buf:Slice)
    # Đọc tối đa buf.len bytes. Returns số bytes đọc được.
    if f.closed:
        out Err(IoError { kind: IoErrorKind.Other, msg: "file is closed" });
    end
    n = native_file_read(f.fd, buf.data, buf.len);
    if n < 0:
        out Err(IoError { kind: io_error_from_errno(native_errno()), msg: "read failed" });
    end
    out Ok(to_u64(n));
end.

func file_read_all:
    in(f:File)
    # Đọc toàn bộ nội dung file thành String.
    buf = buffer_new(4096);
    tmp = alloc(4096);
    slice = slice_new(tmp, 4096);

    running = true;
    when running loop
        r = file_read(f, slice);
        case r;
            case Ok(0) running = false
            case Ok(n) buffer_write_bytes(buf, tmp, n)
            case Err(e)
                free(tmp);
                buffer_free(buf);
                out Err(e);
        end
    end

    s = str_from_bytes(buf.data, buffer_len(buf));
    free(tmp);
    buffer_free(buf);
    out Ok(s);
end.

func file_read_bytes:
    in(f:File)
    # Đọc toàn bộ nội dung file thành Buffer (binary).
    result = buffer_new(4096);
    tmp = alloc(4096);
    slice = slice_new(tmp, 4096);

    running = true;
    when running loop
        r = file_read(f, slice);
        case r;
            case Ok(0) running = false
            case Ok(n) buffer_write_bytes(result, tmp, n)
            case Err(e)
                free(tmp);
                buffer_free(result);
                out Err(e);
        end
    end

    free(tmp);
    out Ok(result);
end.

# ═══════════════════════════════════════════════════════
# Ghi file
# ═══════════════════════════════════════════════════════

func file_write:
    in(f:File; data:Slice)
    if f.closed:
        out Err(IoError { kind: IoErrorKind.Other, msg: "file is closed" });
    end
    n = native_file_write(f.fd, data.data, data.len);
    if n < 0:
        out Err(IoError { kind: io_error_from_errno(native_errno()), msg: "write failed" });
    end
    out Ok(to_u64(n));
end.

func file_write_str:
    in(f:File; s:string)
    out file_write(f, slice_new(s.data, s.byte_len));
end.

func file_write_all:
    in(f:File; data:Slice)
    written = 0;
    when written < data.len loop
        r = file_write(f, slice_sub(data, written, data.len));
        case r;
            case Ok(n) written = written + n
            case Err(e) out Err(e)
        end
    end
    out Ok(void);
end.

# ═══════════════════════════════════════════════════════
# Seek & Position
# ═══════════════════════════════════════════════════════

func file_seek:
    in(f:File; offset:int; whence:SeekFrom)
    if f.closed:
        out Err(IoError { kind: IoErrorKind.Other, msg: "file is closed" });
    end
    pos = native_file_seek(f.fd, offset, whence);
    if pos < 0:
        out Err(IoError { kind: io_error_from_errno(native_errno()), msg: "seek failed" });
    end
    out Ok(to_u64(pos));
end.

func file_size:
    in(f:File)
    # Lưu vị trí hiện tại, seek đến cuối, lấy size, quay lại.
    current = file_seek(f, 0, SeekFrom.Current);
    if is_err(current) out current end:
    end = file_seek(f, 0, SeekFrom.End);
    if is_err(end) out end end:
    file_seek(f, unwrap(current), SeekFrom.Start);
    out end;
end.

# ═══════════════════════════════════════════════════════
# Tiện ích đọc/ghi nhanh (one-shot)
# ═══════════════════════════════════════════════════════

func read_file:
    in(path:string)
    # Mở, đọc toàn bộ, đóng. Tiện cho source files nhỏ.
    f = file_open(path, FileMode.Read);
    if is_err(f) out Err(unwrap_err(f)) end:
    content = file_read_all(unwrap(f));
    file_close(unwrap(f));
    out content;
end.

func write_file:
    in(path:string; content:string)
    # Tạo/truncate file, ghi toàn bộ, đóng.
    f = file_open(path, FileMode.Write);
    if is_err(f) out Err(unwrap_err(f)) end:
    r = file_write_str(unwrap(f), content);
    file_close(unwrap(f));
    if is_err(r) out Err(unwrap_err(r)) end:
    out Ok(void);
end.

# ═══════════════════════════════════════════════════════
# Internal helpers
# ═══════════════════════════════════════════════════════

func io_error_from_errno:
    in(errno:int)
    case errno;
        case 2  out IoErrorKind.NotFound          # ENOENT
        case 13 out IoErrorKind.PermissionDenied  # EACCES
        case 17 out IoErrorKind.AlreadyExists     # EEXIST
        case 22 out IoErrorKind.InvalidInput      # EINVAL
        default out IoErrorKind.Other;
    end
end.

# ═══ END: stdlib/vir/compiler/file.vri ═══

# [merged] import File, FileMode, file_open, file_read_all from file;
# [merged-cont] file_create, file_write_all, file_close;
# [merged] include slice;
# [merged] import Slice, slice_new from slice;
# [merged] include string;
# [merged] import String, str_new, str_eq, str_len, str_byte_at from string;
# [merged-cont] str_concat;


# ═══════════════════════════════════════════════════════
# Mach-O Constants (macOS ARM64)
# ═══════════════════════════════════════════════════════

const MACHO_MAGIC: 0xFEEDFACF;
const CPU_ARM64: 0x0100000C;
const CPU_SUB_ALL: 0x00000000;
const MH_EXECUTE: 2;
const MH_FLAGS: 0x00200085    # PIE | TWOLEVEL | DYLDLINK;
const LC_SEGMENT_64: 0x19;
const LC_MAIN: 0x80000028;
const LC_SYMTAB: 0x02;
const TEXT_BASE: 0x100000000;
const PAGE_SIZE: 0x4000;

# macOS BSD syscall numbers (add 0x2000000 for BSD layer)
const SYS_EXIT: 0x2000001;
const SYS_WRITE: 0x2000004;
const SYS_CHMOD: 0x200000F;


# ═══════════════════════════════════════════════════════
# Module-Level Code Emission
# ═══════════════════════════════════════════════════════
# Emits all functions from a Q-IR module into a single
# code buffer with cross-function call resolution.

entity FuncLayout:
    name:       string;
    code_off:   int    # byte offset in the code buffer;
    fsize:      int;
end

# Emit the ARM64 runtime stubs that compiled programs need:
#   offset 0: _rt_print_i64  — print integer to stdout + newline
#   offset N: _rt_exit       — exit process
# Returns (cb, print_offset, exit_offset, total_runtime_size)

func emit_runtime_arm64:
    in(cb:CodeBuf)
    print_offset = codebuf_offset(cb);

    # ── _rt_print_i64: X0 = value to print ──
    cb = arm64_stp_pre(cb, 29, 30, 31, -160);
    cb = codebuf_emit_u32(cb, 0x910003FD);      # ADD X29, SP, #0;
    cb = codebuf_emit_u32(cb, 0xA90153F3);      # STP X19, X20, [SP, #16];
    cb = codebuf_emit_u32(cb, 0xA9025BF5);      # STP X21, X22, [SP, #32];
    cb = codebuf_emit_u32(cb, 0xA90363F7);      # STP X23, X24, [SP, #48];
    cb = codebuf_emit_u32(cb, 0xA9046BF9);      # STP X25, X26, [SP, #64];
    cb = codebuf_emit_u32(cb, 0xA90573FB);      # STP X27, X28, [SP, #80];
    cb = arm64_mov_rr(cb, 19, 0);
    cb = arm64_mov_rr(cb, 27, 0);

    # Buffer at SP+96, X20 = buffer base, X21 = position
    cb = codebuf_emit_u32(cb, 0x910183F4);      # ADD X20, SP, #96;
    cb = arm64_mov_imm16(cb, 21, 0);
    cb = arm64_mov_imm16(cb, 22, 0);

    cb = arm64_cmp_imm0(cb, 19);
    cb = codebuf_emit_u32(cb, 0x5400006A);
    cb = codebuf_emit_u32(cb, 0xCB1303F3);      # NEG X19 via SUB X19, XZR, X19;
    cb = arm64_mov_imm16(cb, 22, 1);

    zero_check_patch = codebuf_offset(cb);
    cb = codebuf_emit_u32(cb, 0xB4000013);

    cb = arm64_mov_imm16(cb, 23, 10);
    digit_loop = codebuf_offset(cb);
    digits_done_patch = codebuf_offset(cb);
    cb = codebuf_emit_u32(cb, 0xB4000013);

    cb = codebuf_emit_u32(cb, 0x9AD70A78);      # UDIV X24, X19, X23;
    cb = codebuf_emit_u32(cb, 0x9B17CF19);      # MSUB X25, X24, X23, X19;
    cb = codebuf_emit_u32(cb, 0x9100C339);      # ADD X25, X25, #48;
    cb = codebuf_emit_u32(cb, 0x38356A99);      # STRB W25, [X20, X21];
    cb = codebuf_emit_u32(cb, 0x910006B5);      # ADD X21, X21, #1;
    cb = arm64_mov_rr(cb, 19, 24);
    back = (digit_loop - codebuf_offset(cb)) / 4;
    cb = codebuf_emit_u32(cb, 0x14000000 | (back & 0x03FFFFFF));
    skip_zero_patch = codebuf_offset(cb);
    cb = codebuf_emit_u32(cb, 0x14000000);

    is_zero = codebuf_offset(cb);
    cb = arm64_mov_imm16(cb, 25, 48);
    cb = codebuf_emit_u32(cb, 0x38356A99);
    cb = codebuf_emit_u32(cb, 0x910006B5);

    reverse_start = codebuf_offset(cb);
    zc_off = (is_zero - zero_check_patch) / 4;
    cb = codebuf_patch_u32(cb, zero_check_patch,;
        0xB4000013 | ((zc_off & 0x7FFFF) << 5));
    dd_off = (reverse_start - digits_done_patch) / 4;
    cb = codebuf_patch_u32(cb, digits_done_patch,;
        0xB4000013 | ((dd_off & 0x7FFFF) << 5));
    sz_off = (reverse_start - skip_zero_patch) / 4;
    cb = codebuf_patch_u32(cb, skip_zero_patch,;
        0x14000000 | (sz_off & 0x03FFFFFF));

    skip_minus_patch = codebuf_offset(cb);
    cb = codebuf_emit_u32(cb, 0xB4000016);
    cb = arm64_mov_imm16(cb, 25, 45);
    cb = codebuf_emit_u32(cb, 0x38356A99);
    cb = codebuf_emit_u32(cb, 0x910006B5);
    skip_minus = codebuf_offset(cb);
    sm_off = (skip_minus - skip_minus_patch) / 4;
    cb = codebuf_patch_u32(cb, skip_minus_patch,;
        0xB4000016 | ((sm_off & 0x7FFFF) << 5));

    cb = arm64_mov_imm16(cb, 23, 0);
    cb = arm64_mov_rr(cb, 24, 21);
    cb = codebuf_emit_u32(cb, 0xD1000718);

    rev_loop = codebuf_offset(cb);
    cb = codebuf_emit_u32(cb, 0xEB1802FF);      # CMP X23, X24;
    rev_done_patch = codebuf_offset(cb);
    cb = codebuf_emit_u32(cb, 0x5400000A);
    cb = codebuf_emit_u32(cb, 0x38776A99);      # LDRB W25, [X20, X23];
    cb = codebuf_emit_u32(cb, 0x38786A9A);      # LDRB W26, [X20, X24];
    cb = codebuf_emit_u32(cb, 0x38376A9A);      # STRB W26, [X20, X23];
    cb = codebuf_emit_u32(cb, 0x38386A99);      # STRB W25, [X20, X24];
    cb = codebuf_emit_u32(cb, 0x910006F7);
    cb = codebuf_emit_u32(cb, 0xD1000718);
    rv_off = (rev_loop - codebuf_offset(cb)) / 4;
    cb = codebuf_emit_u32(cb, 0x14000000 | (rv_off & 0x03FFFFFF));

    rev_done = codebuf_offset(cb);
    rd_off = (rev_done - rev_done_patch) / 4;
    cb = codebuf_patch_u32(cb, rev_done_patch,;
        0x5400000A | ((rd_off & 0x7FFFF) << 5));

    cb = arm64_mov_imm16(cb, 25, 10);
    cb = codebuf_emit_u32(cb, 0x38356A99);
    cb = codebuf_emit_u32(cb, 0x910006B5);

    cb = arm64_mov_imm16(cb, 0, 1);
    cb = arm64_mov_rr(cb, 1, 20);
    cb = arm64_mov_rr(cb, 2, 21);
    cb = arm64_mov_imm16(cb, 16, 4);
    cb = codebuf_emit_u32(cb, 0xF2A04010);
    cb = arm64_svc(cb, 128);

    cb = arm64_mov_rr(cb, 0, 27);
    cb = codebuf_emit_u32(cb, 0xA94153F3);
    cb = codebuf_emit_u32(cb, 0xA9425BF5);
    cb = codebuf_emit_u32(cb, 0xA94363F7);
    cb = codebuf_emit_u32(cb, 0xA9446BF9);
    cb = codebuf_emit_u32(cb, 0xA94573FB);
    cb = arm64_ldp_post(cb, 29, 30, 31, 160);
    cb = arm64_ret(cb);

    exit_offset = codebuf_offset(cb);
    cb = arm64_mov_imm16(cb, 16, 1);
    cb = codebuf_emit_u32(cb, 0xF2A04010);
    cb = arm64_svc(cb, 128);

    out (cb, print_offset, exit_offset);
end


# ═══════════════════════════════════════════════════════
# Module Codegen
# ═══════════════════════════════════════════════════════
# Emits all functions in a QModule into a single CodeBuf.
# Cross-function calls are resolved via the FuncLayout table.

func codegen_emit_module:
    in(module:QModule; arch:TargetArch)
    # Phase 1: Emit runtime stubs + all functions
    cb = codebuf_new(arch);
    layouts = []       # [FuncLayout];
    layout_count = 0;
    fixups = []        # [(patch_offset, func_idx)] for cross-func calls;
    fixup_count = 0;
    main_idx = -1;
    fallback_main_idx = -1;

    # Emit runtime stubs first
    var (cb2, rt_print_off, rt_exit_off) = emit_runtime_arm64(cb);
    cb = cb2;
    runtime_size = codebuf_offset(cb);

    # Emit each function
    fi = 0;
    when fi < vec_len(module.functions) loop
        func = vec_get(module.functions, fi);
        func_start = codebuf_offset(cb);

        # Track main function
        if rt_streq(func.name, "main") or rt_streq(func.name, "__main__"):
            main_idx = fi;
        end

        if vec_len(func.body) > 0:
            fallback_main_idx = fi;
        end

        # Detect if function needs a stack frame
        needs_frame = 0;
        ii = 0;
        when ii < vec_len(func.body) loop
            ins = vec_get(func.body, ii);
            op = ins.opcode;
            if op == QOp::Call or op == QOp::CallFunc or op == QOp::Print:
                needs_frame = 1;
            end
            ii = ii + 1;
        end

        # Emit prologue
        if needs_frame == 1:
            cb = arm64_stp_pre(cb, 29, 30, 31, -16);
            cb = arm64_mov_rr(cb, 29, 31);
        end

        # Emit instructions
        ps = patch_new();
        j = 0;
        when j < vec_len(func.body) loop
            ins = vec_get(func.body, j);

            if ins.opcode == QOp::Nop:
                cb = arm64_nop(cb);

            eif ins.opcode == QOp::Load:
                rd = vreg_to_arm(ins.dest.vreg);
                if ins.src1.kind == OpndType::Imm:
                    cb = arm64_movz_imm64(cb, rd, ins.src1.imm >> int);
                end

            eif ins.opcode == QOp::Move:
                cb = arm64_mov_rr(cb, vreg_to_arm(ins.dest.vreg), vreg_to_arm(ins.src1.vreg));

            eif ins.opcode == QOp::Add:
                cb = arm64_add_rrr(cb, vreg_to_arm(ins.dest.vreg), vreg_to_arm(ins.src1.vreg), vreg_to_arm(ins.src2.vreg));

            eif ins.opcode == QOp::Sub:
                cb = arm64_sub_rrr(cb, vreg_to_arm(ins.dest.vreg), vreg_to_arm(ins.src1.vreg), vreg_to_arm(ins.src2.vreg));

            eif ins.opcode == QOp::Mul:
                cb = arm64_mul_rrr(cb, vreg_to_arm(ins.dest.vreg), vreg_to_arm(ins.src1.vreg), vreg_to_arm(ins.src2.vreg));

            eif ins.opcode == QOp::Div:
                cb = arm64_sdiv_rrr(cb, vreg_to_arm(ins.dest.vreg), vreg_to_arm(ins.src1.vreg), vreg_to_arm(ins.src2.vreg));

            eif ins.opcode == QOp::Mod:
                # ARM64: dest = src1 - (src1/src2)*src2
                rd = vreg_to_arm(ins.dest.vreg);
                rs1 = vreg_to_arm(ins.src1.vreg);
                rs2 = vreg_to_arm(ins.src2.vreg);
                cb = arm64_sdiv_rrr(cb, 17, rs1, rs2)           # X17 = X_s1 / X_s2;
                cb = codebuf_emit_u32(cb, 0x9B118000 | (rs1 << 10) | (17 << 5) | rd)  # MSUB rd, X17, rs2, rs1 → approximate;
                # Correct MSUB: 0x9B_Rm_1_Ra_Rn_Rd
                # MSUB Xd, Xn, Xm, Xa = Xa - Xn*Xm
                # We want: rd = rs1 - X17 * rs2
                # MSUB rd, X17, rs2, rs1 → rd = rs1 - X17*rs2
                # Encoding: 0x9B008000 | (Rm << 16) | (Ra << 10) | (Rn << 5) | Rd
                # Where: Rn=X17, Rm=rs2, Ra=rs1, Rd=rd
                # Recalculate:
                msub = 0x9B008000 | (rs2 << 16) | (rs1 << 10) | (17 << 5) | rd;
                # Actually rewrite: emit SDIV + MSUB properly
                # We already emitted a wrong instruction. Let me fix by patching.
                cb.len = cb.len - 4   # remove the wrong MSUB;
                cb = codebuf_emit_u32(cb, msub);

            eif ins.opcode == QOp::CmpEq:
                cb = arm64_cmp_rr(cb, vreg_to_arm(ins.src1.vreg), vreg_to_arm(ins.src2.vreg));
                cb = arm64_cset_eq(cb, vreg_to_arm(ins.dest.vreg));

            eif ins.opcode == QOp::CmpGt:
                cb = arm64_cmp_rr(cb, vreg_to_arm(ins.src1.vreg), vreg_to_arm(ins.src2.vreg));
                cb = arm64_cset_gt(cb, vreg_to_arm(ins.dest.vreg));

            eif ins.opcode == QOp::CmpLt:
                cb = arm64_cmp_rr(cb, vreg_to_arm(ins.src1.vreg), vreg_to_arm(ins.src2.vreg));
                cb = arm64_cset_lt(cb, vreg_to_arm(ins.dest.vreg));

            eif ins.opcode == QOp::CmpGe:
                cb = arm64_cmp_rr(cb, vreg_to_arm(ins.src1.vreg), vreg_to_arm(ins.src2.vreg));
                cb = arm64_cset_ge(cb, vreg_to_arm(ins.dest.vreg));

            eif ins.opcode == QOp::CmpLe:
                cb = arm64_cmp_rr(cb, vreg_to_arm(ins.src1.vreg), vreg_to_arm(ins.src2.vreg));
                cb = arm64_cset_le(cb, vreg_to_arm(ins.dest.vreg));

            eif ins.opcode == QOp::And:
                cb = arm64_and_rrr(cb, vreg_to_arm(ins.dest.vreg), vreg_to_arm(ins.src1.vreg), vreg_to_arm(ins.src2.vreg));

            eif ins.opcode == QOp::Or:
                cb = arm64_orr_rrr(cb, vreg_to_arm(ins.dest.vreg), vreg_to_arm(ins.src1.vreg), vreg_to_arm(ins.src2.vreg));

            eif ins.opcode == QOp::Xor:
                cb = arm64_eor_rrr(cb, vreg_to_arm(ins.dest.vreg), vreg_to_arm(ins.src1.vreg), vreg_to_arm(ins.src2.vreg));

            eif ins.opcode == QOp::Shl:
                cb = arm64_lsl_rrr(cb, vreg_to_arm(ins.dest.vreg), vreg_to_arm(ins.src1.vreg), vreg_to_arm(ins.src2.vreg));

            eif ins.opcode == QOp::Shr:
                cb = arm64_asr_rrr(cb, vreg_to_arm(ins.dest.vreg), vreg_to_arm(ins.src1.vreg), vreg_to_arm(ins.src2.vreg));

            eif ins.opcode == QOp::Label:
                ps = patch_add_label(ps, ins.dest.label, codebuf_offset(cb));

            eif ins.opcode == QOp::Jump:
                if ins.dest.kind == OpndType::Label:
                    ps = patch_add_fixup(ps, codebuf_offset(cb), ins.dest.label, 0);
                end
                cb = arm64_b_imm26(cb, 0);

            eif ins.opcode == QOp::JumpIf:
                if ins.src1.kind == OpndType::VReg:
                    cb = arm64_cmp_imm0(cb, vreg_to_arm(ins.src1.vreg));
                end
                if ins.src2.kind == OpndType::Label:
                    ps = patch_add_fixup(ps, codebuf_offset(cb), ins.src2.label, 1);
                end
                cb = arm64_bne_imm19(cb, 0);

            eif ins.opcode == QOp::JumpIfNot:
                if ins.src1.kind == OpndType::VReg:
                    cb = arm64_cmp_imm0(cb, vreg_to_arm(ins.src1.vreg));
                end
                if ins.src2.kind == OpndType::Label:
                    ps = patch_add_fixup(ps, codebuf_offset(cb), ins.src2.label, 1);
                end
                cb = arm64_beq_imm19(cb, 0);

            eif ins.opcode == QOp::Call or ins.opcode == QOp::CallFunc:
                if ins.src1.kind == OpndType::Label:
                    ps = patch_add_fixup(ps, codebuf_offset(cb), ins.src1.label, 0);
                eif ins.src1.kind == OpndType::FuncIdx:
                    # Record for module-level fixup (Phase 2)
                    fixups = fixups + [(codebuf_offset(cb), ins.src1.func_idx)];
                    fixup_count = fixup_count + 1;
                end
                cb = arm64_bl_imm26(cb, 0);

            eif ins.opcode == QOp::Ret:
                if ins.src1.kind == OpndType::VReg and vreg_to_arm(ins.src1.vreg) != 0:
                    cb = arm64_mov_rr(cb, 0, vreg_to_arm(ins.src1.vreg));
                end
                if needs_frame == 1:
                    cb = arm64_ldp_post(cb, 29, 30, 31, 16);
                end
                cb = arm64_ret(cb);

            eif ins.opcode == QOp::Print:
                # Move value to X0, then BL to _rt_print_i64
                if ins.src1.kind == OpndType::VReg:
                    cb = arm64_mov_rr(cb, 0, vreg_to_arm(ins.src1.vreg));
                end
                print_bl_off = codebuf_offset(cb);
                delta = (rt_print_off - print_bl_off) / 4;
                cb = codebuf_emit_u32(cb, 0x94000000 | (delta & 0x03FFFFFF));

            eif ins.opcode == QOp::Exit:
                if ins.src1.kind == OpndType::VReg:
                    cb = arm64_mov_rr(cb, 0, vreg_to_arm(ins.src1.vreg));
                end
                exit_bl_off = codebuf_offset(cb);
                delta = (rt_exit_off - exit_bl_off) / 4;
                cb = codebuf_emit_u32(cb, 0x94000000 | (delta & 0x03FFFFFF));

            eif ins.opcode == QOp::Halt:
                cb = arm64_mov_imm16(cb, 0, 0);
                cb = arm64_ret(cb);

            eif ins.opcode == QOp::LoadByte:
                cb = arm64_ldrb_reg(cb, vreg_to_arm(ins.dest.vreg), vreg_to_arm(ins.src1.vreg), vreg_to_arm(ins.src2.vreg));

            eif ins.opcode == QOp::StoreByte:
                cb = arm64_strb_reg(cb, vreg_to_arm(ins.dest.vreg), vreg_to_arm(ins.src1.vreg), vreg_to_arm(ins.src2.vreg));

            eif ins.opcode == QOp::LoadWord:
                cb = arm64_ldr_reg(cb, vreg_to_arm(ins.dest.vreg), vreg_to_arm(ins.src1.vreg), vreg_to_arm(ins.src2.vreg));

            eif ins.opcode == QOp::StoreWord:
                cb = arm64_str_reg(cb, vreg_to_arm(ins.dest.vreg), vreg_to_arm(ins.src1.vreg), vreg_to_arm(ins.src2.vreg));

            eif ins.opcode == QOp::PatchPoint:
                cb = arm64_nop(cb);

            else
                cb = arm64_nop(cb);
            end

            j = j + 1;
        end

        # If function has no explicit RET, add one
        if vec_len(func.body) == 0 or vec_get(func.body, vec_len(func.body) - 1).opcode != QOp::Ret:
            if needs_frame == 1:
                cb = arm64_ldp_post(cb, 29, 30, 31, 16);
            end
            cb = arm64_ret(cb);
        end

        # Back-patch intra-function jumps
        cb = backpatch_arm64(cb, ps);

        func_size = codebuf_offset(cb) - func_start;
        layouts = layouts + [FuncLayout {;
            name:     func.name,;
            code_off: func_start,;
            fsize:    func_size;
        }];
        layout_count = layout_count + 1;

        fi = fi + 1;
    end

    if main_idx < 0:
        main_idx = fallback_main_idx;
    end

    # Phase 2: Resolve cross-function calls
    fxi = 0;
    when fxi < fixup_count loop
        var (patch_at, target_idx) = fixups[fxi];
        if target_idx >= 0 and target_idx < layout_count:
            target_off = layouts[target_idx].code_off;
            byte_offset = target_off - patch_at;
            imm26 = (byte_offset / 4) & 0x03FFFFFF;
            cb = codebuf_patch_u32(cb, patch_at, 0x94000000 | imm26);
        end
        fxi = fxi + 1;
    end

    # Phase 3: Emit _start entry point
    # _start calls main(), then exits with return value
    start_offset = codebuf_offset(cb);
    cb.start_offset = start_offset;
    # STP X29, X30, [SP, #-16]!
    cb = arm64_stp_pre(cb, 29, 30, 31, -16);
    cb = arm64_mov_rr(cb, 29, 31);

    if main_idx >= 0:
        # BL to main function
        main_off = layouts[main_idx].code_off;
        main_bl = codebuf_offset(cb);
        delta = (main_off - main_bl) / 4;
        cb = codebuf_emit_u32(cb, 0x94000000 | (delta & 0x03FFFFFF));
    else
        # No main found — return 0
        cb = arm64_mov_imm16(cb, 0, 0);
    end

    # Exit: BL _rt_exit
    exit_bl = codebuf_offset(cb);
    exit_delta = (rt_exit_off - exit_bl) / 4;
    cb = codebuf_emit_u32(cb, 0x94000000 | (exit_delta & 0x03FFFFFF));

    # LDP + RET (fallback, shouldn't reach)
    cb = arm64_ldp_post(cb, 29, 30, 31, 16);
    cb = arm64_ret(cb);

    out cb;
end


# ═══════════════════════════════════════════════════════
# Mach-O Executable Emitter
# ═══════════════════════════════════════════════════════
# Produces a minimal Mach-O ARM64 executable:
#   __PAGEZERO + __TEXT (code) + LC_MAIN + LC_SYMTAB

func emit_macho_executable:
    in(code:CodeBuf)
    out = buf_new();
    code_size = codebuf_offset(code);

    # Match the fuller Mach-O runtime layout so macOS accepts the binary.
    ncmds = 10;
    sizeofcmds = 552;
    header_end = 32 + sizeofcmds;
    code_offset = header_end + 32;   # spare padding for codesign growth

    text_raw_size = code_offset + code_size;
    text_segment_size = ((text_raw_size + PAGE_SIZE - 1) / PAGE_SIZE) * PAGE_SIZE;

    chained_fixups_size = 48;
    string_table_size = 4;
    linkedit_data_size = chained_fixups_size + string_table_size;
    linkedit_fileoff = text_segment_size;
    linkedit_vmaddr = TEXT_BASE + text_segment_size;
    strtab_off = linkedit_fileoff + chained_fixups_size;
    entry_file_offset = code_offset + code.start_offset;

    # ── Mach-O Header (32 bytes) ──
    out = buf_write_u32_le(out, MACHO_MAGIC);
    out = buf_write_u32_le(out, CPU_ARM64);
    out = buf_write_u32_le(out, CPU_SUB_ALL);
    out = buf_write_u32_le(out, MH_EXECUTE);
    out = buf_write_u32_le(out, ncmds);
    out = buf_write_u32_le(out, sizeofcmds);
    out = buf_write_u32_le(out, MH_FLAGS);
    out = buf_write_u32_le(out, 0);

    # ── 1. __PAGEZERO ──
    out = buf_write_u32_le(out, LC_SEGMENT_64);
    out = buf_write_u32_le(out, 72);
    out = buf_write_string_padded(out, str_new("__PAGEZERO"), 16);
    out = buf_write_u64_le(out, 0);
    out = buf_write_u64_le(out, TEXT_BASE);
    out = buf_write_u64_le(out, 0);
    out = buf_write_u64_le(out, 0);
    out = buf_write_u32_le(out, 0);
    out = buf_write_u32_le(out, 0);
    out = buf_write_u32_le(out, 0);
    out = buf_write_u32_le(out, 0);

    # ── 2. __TEXT + __text ──
    out = buf_write_u32_le(out, LC_SEGMENT_64);
    out = buf_write_u32_le(out, 152);
    out = buf_write_string_padded(out, str_new("__TEXT"), 16);
    out = buf_write_u64_le(out, TEXT_BASE);
    out = buf_write_u64_le(out, text_segment_size);
    out = buf_write_u64_le(out, 0);
    out = buf_write_u64_le(out, text_segment_size);
    out = buf_write_u32_le(out, 7);
    out = buf_write_u32_le(out, 5);
    out = buf_write_u32_le(out, 1);
    out = buf_write_u32_le(out, 0);

    out = buf_write_string_padded(out, str_new("__text"), 16);
    out = buf_write_string_padded(out, str_new("__TEXT"), 16);
    out = buf_write_u64_le(out, TEXT_BASE + code_offset);
    out = buf_write_u64_le(out, code_size);
    out = buf_write_u32_le(out, code_offset);
    out = buf_write_u32_le(out, 2);
    out = buf_write_u32_le(out, 0);
    out = buf_write_u32_le(out, 0);
    out = buf_write_u32_le(out, 0x80000400);
    out = buf_write_u32_le(out, 0);
    out = buf_write_u32_le(out, 0);
    out = buf_write_u32_le(out, 0);

    # ── 3. __LINKEDIT ──
    out = buf_write_u32_le(out, LC_SEGMENT_64);
    out = buf_write_u32_le(out, 72);
    out = buf_write_string_padded(out, str_new("__LINKEDIT"), 16);
    out = buf_write_u64_le(out, linkedit_vmaddr);
    out = buf_write_u64_le(out, PAGE_SIZE);
    out = buf_write_u64_le(out, linkedit_fileoff);
    out = buf_write_u64_le(out, linkedit_data_size);
    out = buf_write_u32_le(out, 1);
    out = buf_write_u32_le(out, 1);
    out = buf_write_u32_le(out, 0);
    out = buf_write_u32_le(out, 0);

    # ── 4. LC_DYLD_CHAINED_FIXUPS ──
    out = buf_write_u32_le(out, LC_DYLD_CHAINED_FIXUPS);
    out = buf_write_u32_le(out, 16);
    out = buf_write_u32_le(out, linkedit_fileoff);
    out = buf_write_u32_le(out, chained_fixups_size);

    # ── 5. LC_SYMTAB ──
    out = buf_write_u32_le(out, LC_SYMTAB);
    out = buf_write_u32_le(out, 24);
    out = buf_write_u32_le(out, strtab_off);
    out = buf_write_u32_le(out, 0);
    out = buf_write_u32_le(out, strtab_off);
    out = buf_write_u32_le(out, string_table_size);

    # ── 6. LC_DYSYMTAB ──
    out = buf_write_u32_le(out, LC_DYSYMTAB);
    out = buf_write_u32_le(out, 80);
    di = 0;
    when di < 18 loop
        out = buf_write_u32_le(out, 0);
        di = di + 1;
    end

    # ── 7. LC_LOAD_DYLINKER ──
    out = buf_write_u32_le(out, LC_LOAD_DYLINKER);
    out = buf_write_u32_le(out, 32);
    out = buf_write_u32_le(out, 12);
    out = buf_write_string_padded(out, str_new("/usr/lib/dyld"), 20);

    # ── 8. LC_UUID ──
    out = buf_write_u32_le(out, LC_UUID);
    out = buf_write_u32_le(out, 24);
    ui = 1;
    when ui <= 16 loop
        out = buf_write_u8(out, ui);
        ui = ui + 1;
    end

    # ── 9. LC_MAIN ──
    out = buf_write_u32_le(out, LC_MAIN);
    out = buf_write_u32_le(out, 24);
    out = buf_write_u64_le(out, entry_file_offset);
    out = buf_write_u64_le(out, 0);

    # ── 10. LC_LOAD_DYLIB ──
    out = buf_write_u32_le(out, LC_LOAD_DYLIB);
    out = buf_write_u32_le(out, 56);
    out = buf_write_u32_le(out, 24);
    out = buf_write_u32_le(out, 0);
    out = buf_write_u32_le(out, 0x00010000);
    out = buf_write_u32_le(out, 0x00010000);
    out = buf_write_string_padded(out, str_new("/usr/lib/libSystem.B.dylib"), 32);

    # ── Pad to code offset ──
    current = buf_size(out);
    if current < code_offset:
        out = buf_write_zeros(out, code_offset - current);
    end

    # ── Write machine code ──
    ci = 0;
    when ci < code.len loop
        out = buf_write_u8(out, code.data[ci]);
        ci = ci + 1;
    end

    # ── Pad to __TEXT segment boundary ──
    current = buf_size(out);
    if current < text_segment_size:
        out = buf_write_zeros(out, text_segment_size - current);
    end

    # ── Write LINKEDIT data ──
    out = buf_write_u32_le(out, 0);
    out = buf_write_u32_le(out, 28);
    out = buf_write_u32_le(out, 44);
    out = buf_write_u32_le(out, 44);
    out = buf_write_u32_le(out, 0);
    out = buf_write_u32_le(out, 1);
    out = buf_write_u32_le(out, 0);

    out = buf_write_u32_le(out, 3);
    out = buf_write_u32_le(out, 0);
    out = buf_write_u32_le(out, 0);
    out = buf_write_u32_le(out, 0);
    out = buf_write_u32_le(out, 0);
    out = buf_write_u32_le(out, 0);

    out out;
end

# Emit with known _start offset
func emit_macho_with_entry:
    in(code:CodeBuf; start_offset:int)
    out = emit_macho_executable(code);

    # Patch LC_MAIN entryoff
    # LC_MAIN is at offset: 32 (header) + 72 (PAGEZERO) + 152 (TEXT+sect) + 8 (cmd+cmdsize)
    # = 264
    lc_main_entryoff = 264 >> int;
    # Entry offset in file = header_plus_cmds + start_offset
    header_plus_cmds = 304 >> int       # 32 + 72 + 152 + 24 + 24 = 304;

    # The entryoff field is at byte 264 (after cmd and cmdsize)
    # Entryoff = file offset relative to __TEXT vmaddr mapping
    # Since __TEXT maps from file offset 0 with vmaddr TEXT_BASE,
    # entryoff = header_plus_cmds + start_offset
    # No — LC_MAIN.entryoff is relative to __TEXT file offset which is 0
    # So entryoff = offset of _start code in the file = header_plus_cmds + start_offset

    # Actually looking at Apple docs: LC_MAIN.entryoff is the file offset
    # of the entry point from the start of the __TEXT segment.
    # __TEXT segment starts at file offset 0, so entryoff = header_plus_cmds + start_offset

    # Patch the entry offset in the output buffer
    # LC_MAIN starts at offset 256 (32+72+152), entryoff is at +8
    entry_patch_off = 32 + 72 + 152 + 8;
    entryoff_val = header_plus_cmds + start_offset;

    # Write little-endian u64 at entry_patch_off
    out.data = vec_set_at(out.data, entry_patch_off, (entryoff_val & 0xFF) >> int);
    out.data = vec_set_at(out.data, entry_patch_off + 1, ((entryoff_val >> 8) & 0xFF) >> int);
    out.data = vec_set_at(out.data, entry_patch_off + 2, ((entryoff_val >> 16) & 0xFF) >> int);
    out.data = vec_set_at(out.data, entry_patch_off + 3, ((entryoff_val >> 24) & 0xFF) >> int);
    out.data = vec_set_at(out.data, entry_patch_off + 4, 0);
    out.data = vec_set_at(out.data, entry_patch_off + 5, 0);
    out.data = vec_set_at(out.data, entry_patch_off + 6, 0);
    out.data = vec_set_at(out.data, entry_patch_off + 7, 0);

    out out;
end


# ═══════════════════════════════════════════════════════
# Compile Pipeline
# ═══════════════════════════════════════════════════════

func compile:
    in(source:string; output_path:string)
    # Step 1: Tokenize
    print "virc: tokenizing...";
    dv = vec_new<int>();
    vec_push(dv, 11);
    vec_push(dv, 22);
    print "virc: debug vec_len=" + str_from_i64(vec_len(dv));
    print "virc: debug vec0=" + str_from_i64(vec_get(dv, 0));
    kws = build_keyword_table();
    print "virc: debug kw_len=" + str_from_i64(vec_len(kws));
    print "virc: debug kw_func=" + str_from_i64(lookup_keyword(kws, str_new("func")));
    sbuf = str_new("");
    sbuf = str_concat(sbuf, char_to_str(102));
    sbuf = str_concat(sbuf, char_to_str(117));
    sbuf = str_concat(sbuf, char_to_str(110));
    sbuf = str_concat(sbuf, char_to_str(99));
    print "virc: debug sbuf_eq=" + str_from_i64(str_eq(sbuf, str_new("func")));
    lex = lexer_new(source);
    print "virc: debug source_len=" + str_from_i64(lex.source_len);
    print "virc: debug first_byte=" + str_from_i64(str_byte_at(lex.source, 0));
    probe = lexer_new(source);
    var (probe2, probe_tok) = lex_word(probe);
    print "virc: debug probe_pos=" + str_from_i64(probe2.pos);
    print "virc: debug probe_tok=" + str_from_i64(probe_tok.tok_type);
    lex = tokenize(lex);
    print "virc: debug raw_pos";
    print lex.pos;
    print "virc: debug end_pos=" + str_from_i64(lex.pos);

    if str_len(lex.error) > 0:
        print "virc: lex error: " + lex.error;
        out 1;
    end

    tok_count = vec_len(lex.tokens);
    print "virc: " + str_from_i64(tok_count) + " tokens";

    # Step 2: Parse
    print "virc: parsing...";
    parser = parser_new(lex.tokens);
    var (parser2, ast) = parse_program(parser);
    print "virc: ast children=" + str_from_i64(vec_len(ast.children));
    if str_len(parser2.error) > 0:
        print "virc: parser2.error=" + parser2.error;
    end
    if vec_len(ast.children) > 0:
        ast0 = vec_get(ast.children, 0);
        print "virc: ast0.type=" + str_from_i64(ast0.node_type);
        print "virc: ast0.children=" + str_from_i64(vec_len(ast0.children));
        if vec_len(ast0.children) > 0:
            ab = vec_get(ast0.children, vec_len(ast0.children) - 1);
            print "virc: ast0.body.type=" + str_from_i64(ab.node_type);
            print "virc: ast0.body.children=" + str_from_i64(vec_len(ab.children));
        end
    end

    if ast.node_type == AstType::Program and vec_len(ast.children) == 0:
        print "virc: parse error: empty program";
        out 1;
    end

    # Step 3: Lower to Q-IR
    print "virc: lowering to Q-IR...";
    ctx = lower_ctx_new(str_new("main"));
    ctx = lower_program(ctx, ast);

    if ctx.error_count > 0:
        print "virc: lower error: " + ctx.last_error;
        out 1;
    end

    func_count = vec_len(ctx.module.functions);
    print "virc: " + str_from_i64(func_count) + " functions";
    dfi = 0;
    when dfi < func_count loop
        fdbg = vec_get(ctx.module.functions, dfi);
        print "virc: func[" + str_from_i64(dfi) + "] name=" + fdbg.name + " body=" + str_from_i64(vec_len(fdbg.body));
        dfi = dfi + 1;
    end

    # Step 4: Optimize — TCO + register allocation per function
    print "virc: optimizing...";
    fi = 0;
    when fi < func_count loop
        func = vec_get(ctx.module.functions, fi);

        # Tail-call optimization
        var (func2, tco_count) = tco_pass(func);
        func = func2

        # Liveness analysis + register allocation
        intervals = compute_liveness(func);
        allocated = regalloc_linear_scan(intervals, 14)    # 14 GPRs;

        vec_set(ctx.module.functions, fi, func);
        fi = fi + 1;
    end

    # Step 5: Code generation (ARM64)
    print "virc: generating ARM64 machine code...";
    code = codegen_emit_module(ctx.module, TargetArch::ARM64);
    code_size = codebuf_offset(code);
    print "virc: " + str_from_i64(code_size) + " bytes of machine code";

    # The _start entry point is at the known offset
    # (it's the last thing emitted by codegen_emit_module)
    # We need to find it... _start is after all functions + runtime
    # For now, record it as a return value from codegen_emit_module or calculate

    # Step 6: Link into Mach-O executable
    print "virc: linking Mach-O ARM64 executable...";
    binary = emit_macho_executable(code);

    # Step 7: Write output
    print "virc: writing " + output_path + "...";
    out_fd = native_file_open(output_path.data, output_path.byte_len, FileMode.Write);
    if out_fd < 0:
        print "virc: error: cannot create output file";
        out 1;
    end

    bytes_to_write = vec_len(binary.data);
    wrote = native_file_write(out_fd, binary.data.data, bytes_to_write);
    native_file_close(out_fd);
    if wrote < 0:
        print "virc: error: cannot write output file";
        out 1;
    end

    file_size = vec_len(binary.data);
    print "virc: done! " + output_path + " (" + str_from_i64(file_size) + " bytes)";
    out 0;
end


# ═══════════════════════════════════════════════════════
# Main Entry Point
# ═══════════════════════════════════════════════════════

func main:
    print "╔══════════════════════════════════════════════╗";
    print "║  virc — Vir Self-Hosting Compiler v1.2      ║";
    print "║  Phase 5: Bootstrap Binary                   ║";
    print "╚══════════════════════════════════════════════╝";

    if arg_count() < 1:
        print "Usage: virc <input.vri> [-o output]";
        print "";
        print "Compiles a Vir source file to a standalone";
        print "Mach-O ARM64 binary. No Python, no C runtime.";
        out 1;
    end

    input_path = get_arg(0);
    output_path = str_new("a.out");

    # Parse -o flag
    if arg_count() >= 3:
        if str_eq(get_arg(1), str_new("-o")):
            output_path = get_arg(2);
        end
    end

    # Read source file
    print "virc: reading " + input_path + "...";
    in_fd = native_file_open(input_path.data, input_path.byte_len, FileMode.Read);
    if in_fd < 0:
        print "virc: error: cannot open " + input_path;
        out 1;
    end
    src_size = native_file_seek(in_fd, 0, 2);
    native_file_seek(in_fd, 0, 0);
    if src_size < 0:
        native_file_close(in_fd);
        print "virc: error: cannot stat " + input_path;
        out 1;
    end
    src_buf = alloc(src_size + 1);
    read_n = native_file_read(in_fd, src_buf, src_size);
    native_file_close(in_fd);
    if read_n < 0:
        free(src_buf);
        print "virc: error: cannot read " + input_path;
        out 1;
    end
    source = str_from_bytes(src_buf, read_n);
    free(src_buf);
    print "virc: " + str_from_i64(str_len(source)) + " bytes source";

    # Compile!
    result = compile(source, output_path);
    out result;
end

# [merged] export compile, main, codegen_emit_module;
# [merged] export emit_runtime_arm64, emit_macho_executable, emit_macho_with_entry;
# [merged] export FuncLayout;

# ═══ END: stdlib/vir/compiler/main.vri ═══

# [merged] import codegen_emit_module, emit_macho_executable, emit_macho_with_entry, FuncLayout from main;


# ═══════════════════════════════════════════════════════
# Configuration
# ═══════════════════════════════════════════════════════

const VERSION: "virc 1.2.0 (self-hosted)";

entity CompilerConfig:
    input_path:     int;    # string pointer
    output_path:    int;    # string pointer
    target:         int;    # 0=ARM64, 1=x86_64
    format:         int;    # 0=Mach-O, 1=ELF
    verbose:        int;    # 0=quiet, 1=verbose
end.

func default_config:
    out CompilerConfig {
        input_path:  0,
        output_path: 0,
        target:      0,        # ARM64 (default on macOS)
        format:      0,        # Mach-O (default on macOS)
        verbose:     1
    };
end.


# ═══════════════════════════════════════════════════════
# CLI Argument Parsing
# ═══════════════════════════════════════════════════════

func parse_args:
    let argc = arg_count();
    let cfg = default_config();

    if argc < 1:
        print_ln("virc: error: no input file");
        print_ln("Usage: virc <input.vri> [-o output] [--target arm64|x86_64] [--format macho|elf]");
        exit_prog(1);
    end

    # First positional argument is the input file
    cfg.input_path = get_arg(0);

    # Default output: a.out
    cfg.output_path = "a.out";

    let i = 1;
    when i < argc loop
        let arg = get_arg(i);

        if rt_streq(arg, "-o"):
            if i + 1 < argc:
                i = i + 1;
                cfg.output_path = get_arg(i);
            else
                print_ln("virc: error: -o requires an argument");
                exit_prog(1);
            end

        eif rt_streq(arg, "--target"):
            if i + 1 < argc:
                i = i + 1;
                let tgt = get_arg(i);
                if rt_streq(tgt, "arm64") or rt_streq(tgt, "aarch64"):
                    cfg.target = 0;
                eif rt_streq(tgt, "x86_64") or rt_streq(tgt, "x86-64"):
                    cfg.target = 1;
                eif rt_streq(tgt, "wasm32") or rt_streq(tgt, "wasm"):
                    cfg.target = 2;
                else
                    print_ln("virc: error: unknown target (use arm64, x86_64 or wasm32)");
                    exit_prog(1);
                end
            end

        eif rt_streq(arg, "--format"):
            if i + 1 < argc:
                i = i + 1;
                let fmt = get_arg(i);
                if rt_streq(fmt, "macho"):
                    cfg.format = 0;
                eif rt_streq(fmt, "elf"):
                    cfg.format = 1;
                else
                    print_ln("virc: error: unknown format (use macho or elf)");
                    exit_prog(1);
                end
            end

        eif rt_streq(arg, "-q") or rt_streq(arg, "--quiet"):
            cfg.verbose = 0;

        eif rt_streq(arg, "-v") or rt_streq(arg, "--version"):
            print_ln(VERSION);
            exit_prog(0);

        eif rt_streq(arg, "-h") or rt_streq(arg, "--help"):
            print_ln("virc — Vir Self-Hosting Compiler");
            print_ln("");
            print_ln("Usage: virc <input.vri> [-o output] [options]");
            print_ln("");
            print_ln("Options:");
            print_ln("  -o <file>           Output file (default: a.out)");
            print_ln("  --target <arch>     arm64, x86_64 or wasm32 (default: arm64)");
            print_ln("  --format <fmt>      macho, elf or wasm (default: macho)");
            print_ln("  -q, --quiet         Suppress progress messages");
            print_ln("  -v, --version       Print version");
            print_ln("  -h, --help          Print this help");
            exit_prog(0);
        end

        i = i + 1;
    end

    out cfg;
end.


# ═══════════════════════════════════════════════════════
# Compiler Pipeline
# ═══════════════════════════════════════════════════════

func virc_compile:
    in(cfg: CompilerConfig)

    let verbose = cfg.verbose;

    # ── Read source file ──
    if verbose == 1:
        let sb = sb_new();
        sb = sb_append(sb, "virc: reading ");
        sb = sb_append(sb, cfg.input_path);
        sb = sb_append(sb, "...");
        print_ln(sb_to_string(sb));
        sb_free(sb);
    end

    let source_raw = read_file_str(cfg.input_path);
    if source_raw == 0:
        print_ln("virc: error: cannot read input file");
        exit_prog(1);
    end

    let src_len = rt_strlen(source_raw);
    if verbose == 1:
        let sb = sb_new();
        sb = sb_append(sb, "virc: ");
        sb = sb_append_int(sb, src_len);
        sb = sb_append(sb, " bytes source");
        print_ln(sb_to_string(sb));
        sb_free(sb);
    end

    # ── Step 1: Tokenize ──
    if verbose == 1:
        print_ln("virc: tokenizing...");
    end

    # Use lexer_new directly with raw string pointer
    let lex = lexer_new(source_raw);
    lex = tokenize(lex);

    if rt_strlen(lex.error) > 0:
        let sb = sb_new();
        sb = sb_append(sb, "virc: lex error: ");
        sb = sb_append(sb, lex.error);
        print_ln(sb_to_string(sb));
        sb_free(sb);
        exit_prog(1);
    end

    let tok_count = vec_len_rt(lex.tokens);
    if verbose == 1:
        let sb = sb_new();
        sb = sb_append(sb, "virc: ");
        sb = sb_append_int(sb, tok_count);
        sb = sb_append(sb, " tokens");
        print_ln(sb_to_string(sb));
        sb_free(sb);
    end

    # ── Step 2: Parse ──
    if verbose == 1:
        print_ln("virc: parsing...");
    end

    let parser = parser_new(lex.tokens);
    var (parser2, ast) = parse_program(parser);

    if verbose == 1:
        let sb_ast = sb_new();
        sb_ast = sb_append(sb_ast, "virc: ast children ");
        sb_ast = sb_append_int(sb_ast, vec_len_rt(ast.children));
        print_ln(sb_to_string(sb_ast));
        sb_free(sb_ast);
    end

    # Report parse errors
    if rt_strlen(parser2.error) > 0:
        let sb_pe = sb_new();
        sb_pe = sb_append(sb_pe, "virc: parse error (line ");
        sb_pe = sb_append_int(sb_pe, parser2.error_line);
        sb_pe = sb_append(sb_pe, "): ");
        sb_pe = sb_append(sb_pe, parser2.error);
        print_ln(sb_to_string(sb_pe));
        sb_free(sb_pe);
    end

    # ── Step 3: Lower to Q-IR ──
    if verbose == 1:
        print_ln("virc: lowering to Q-IR...");
    end

    let ctx = lower_ctx_new("main");

    ctx = lower_program(ctx, ast);

    if ctx.error_count > 0:
        let sb = sb_new();
        sb = sb_append(sb, "virc: lower errors=");
        sb = sb_append_int(sb, ctx.error_count);
        sb = sb_append(sb, " last_error=");
        sb = sb_append(sb, ctx.last_error);
        print_ln(sb_to_string(sb));
        sb_free(sb);
        # Don't exit — may still generate partial code
    end

    let func_count = vec_len_rt(ctx.module.functions);

    if verbose == 1:
        let sb = sb_new();
        sb = sb_append(sb, "virc: ");
        sb = sb_append_int(sb, func_count);
        sb = sb_append(sb, " functions");
        print_ln(sb_to_string(sb));
        sb_free(sb);
    end

    # ── Step 4: Optimization passes ──
    if verbose == 1:
        print_ln("virc: running optimization passes...");
    end

    let opt_result = optimize_module(ctx.module);
    let opt_fused = opt_result.1;
    let opt_bce = opt_result.2;
    let opt_vec = opt_result.3;

    if verbose == 1:
        let sb = sb_new();
        sb = sb_append(sb, "virc: fusion=");
        sb = sb_append_int(sb, opt_fused);
        sb = sb_append(sb, " bce=");
        sb = sb_append_int(sb, opt_bce);
        sb = sb_append(sb, " autovec=");
        sb = sb_append_int(sb, opt_vec);
        print_ln(sb_to_string(sb));
        sb_free(sb);
    end

    # ── Step 5: Code Generation ──
    let target_arch = TargetArch::ARM64;
    let target_name = "ARM64";
    if cfg.target == 1:
        target_arch = TargetArch::X86_64;
        target_name = "x86_64";
    eif cfg.target == 2:
        target_arch = TargetArch::Wasm32;
        target_name = "wasm32";
    end

    if verbose == 1:
        let sb = sb_new();
        sb = sb_append(sb, "virc: generating ");
        sb = sb_append(sb, target_name);
        sb = sb_append(sb, " machine code...");
        print_ln(sb_to_string(sb));
        sb_free(sb);
    end

    let code = codegen_emit_module(ctx.module, target_arch);
    let code_size = codebuf_offset(code);

    if verbose == 1:
        let sb = sb_new();
        sb = sb_append(sb, "virc: ");
        sb = sb_append_int(sb, code_size);
        sb = sb_append(sb, " bytes machine code");
        print_ln(sb_to_string(sb));
        sb_free(sb);
    end

    # ── Step 6: Extract machine code into byte vector ──
    let code_bytes = bvec_new();
    let ci = 0;
    when ci < code_size loop
        code_bytes = bvec_push(code_bytes, codebuf_get_data(code, ci));
        ci = ci + 1;
    end

    # ── Step 7: Emit executable ──
    if verbose == 1:
        let fmt_name = "Mach-O";
        if cfg.format == 1:
            fmt_name = "ELF";
        eif cfg.format == 2 or cfg.target == 2:
            fmt_name = "WASM";
        end
        let sb = sb_new();
        sb = sb_append(sb, "virc: linking ");
        sb = sb_append(sb, fmt_name);
        sb = sb_append(sb, " ");
        sb = sb_append(sb, target_name);
        sb = sb_append(sb, " executable...");
        print_ln(sb_to_string(sb));
        sb_free(sb);
    end

    if cfg.target == 2 or cfg.format == 2:
        # WASM output: build QIRFunc list from QModule, emit .wasm
        let wasm_funcs = vec_new<QIRFunc>();
        let wfi = 0;
        let wfn = vec_len_rt(ctx.module.functions);
        when wfi < wfn loop
            let qf = vec_get_rt(ctx.module.functions, wfi);
            wasm_funcs = vec_push<QIRFunc>(wasm_funcs, QIRFunc {
                name: qf.name,
                param_count: qf.param_count,
                body: qf.body
            });
            wfi = wfi + 1;
        end
        wasm_write_module(wasm_funcs, cfg.output_path);
    eif cfg.format == 0:
        # Mach-O
        let mb = macho_new(cfg.target);
        mb.text_code = code_bytes;
        mb.entry_offset = code.start_offset;
        macho_write_to_file(mb, cfg.output_path);
    else
        # ELF
        let eb = elf_new(cfg.target);
        eb.text_code = code_bytes;
        eb.entry_offset = code.start_offset;
        elf_write_to_file(eb, cfg.output_path);
    end

    if verbose == 1:
        let sb = sb_new();
        sb = sb_append(sb, "virc: done! ");
        sb = sb_append(sb, cfg.output_path);
        sb = sb_append(sb, " (");
        sb = sb_append_int(sb, code_size);
        sb = sb_append(sb, " bytes code)");
        print_ln(sb_to_string(sb));
        sb_free(sb);
    end

    out 0;
end.


# ═══════════════════════════════════════════════════════
# Entry Point (called from _start via rt/start.vri)
# ═══════════════════════════════════════════════════════

func main:
    print_ln("====================================");
    print_ln("  virc — Vir Self-Hosting Compiler");
    print_ln("  v1.2.0 — Zero Python, Zero C");
    print_ln("====================================");

    let cfg = parse_args();
    let result = virc_compile(cfg);
    out result;
end.

# [merged] export vir_main, virc_compile, parse_args, CompilerConfig;

# ═══ END: stdlib/vir/compiler/virc.vri ═══
