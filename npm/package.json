  "repository": {
    "type": "git",
    "url": "https://github.com/virgori/vir"
  },
  "homepage": "https://github.com/virgori/vir",
  "keywords": [
    "programming-language",
    "vietnamese",
    "compiler",
    "jit",
    "vm",
    "vir",
    "virgori"
  ],
  "bin": {
    "vir": "./bin/vir.js",
    "viron": "./bin/viron.js"
  },
  "scripts": {
    "postinstall": "node scripts/postinstall.js"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "engines": {
    "node": ">=16"
  },
  "files": [
    "bin/",
    "scripts/",
    "README.md",
    "LICENSE"
