entity Token:
    kind
    value
end.

func classify(t):
    var k = t.kind
    var v = t.value
    var result = 0
    if k == 1 do
        result = v + 100
    eif k == 2 do
        result = v + 200
    else
        result = v
    end
    out result
end.

func main:
    var t1 = Token(kind: 1, value: 10)
    var t2 = Token(kind: 2, value: 20)
    var t3 = Token(kind: 3, value: 30)
    print classify(t1)
    print classify(t2)
    print classify(t3)
end.
