#!/usr/bin/env bash
# ═════════════════════════════════════════════════════════════════════
# virc — Official Vir Self-Hosted Soft Modular Compiler Driver
# Version: 2.1.0
# Pipeline: HIR → MIR (CFG/SSA) → LIR (Chaitin-Briggs IRC) → Direct AOT Codegen
# Optimizations: 26 passes active (-O0 .. -O3)
# ═════════════════════════════════════════════════════════════════════
set -euo pipefail

BIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(cd "${BIN_DIR}/.." && pwd)"
VIR_HOME="${VIR_HOME:-$HOME/.vir}"

# Locate vir-core native execution engine
ENGINE=""
if [ -f "${BIN_DIR}/vir-core" ]; then
    ENGINE="${BIN_DIR}/vir-core"
elif [ -f "${VIR_HOME}/bin/vir-core" ]; then
    ENGINE="${VIR_HOME}/bin/vir-core"
elif [ -f "${ROOT_DIR}/core/build/vir" ]; then
    ENGINE="${ROOT_DIR}/core/build/vir"
elif command -v vir-core >/dev/null 2>&1; then
    ENGINE="$(command -v vir-core)"
else
    echo "virc: error: vir-core native engine not found. Please install via 'curl -fsSL https://raw.githubusercontent.com/virgori/Vir-lang/main/install.sh | bash'" >&2
    exit 1
fi

# Locate stdlib/vir/compiler/virc.vri
COMPILER=""
if [ -f "${ROOT_DIR}/stdlib/vir/compiler/virc.vri" ]; then
    COMPILER="${ROOT_DIR}/stdlib/vir/compiler/virc.vri"
elif [ -f "${VIR_HOME}/stdlib/vir/compiler/virc.vri" ]; then
    COMPILER="${VIR_HOME}/stdlib/vir/compiler/virc.vri"
elif [ -f "${VIR_HOME}/stdlib/compiler/virc.vri" ]; then
    COMPILER="${VIR_HOME}/stdlib/compiler/virc.vri"
else
    echo "virc: error: stdlib/vir/compiler/virc.vri not found in ${VIR_HOME}/stdlib" >&2
    exit 1
fi

if [ "$#" -eq 0 ]; then
    echo "virc (Vir Self-Hosted Modular Soft Compiler) 2.1.0"
    echo "Usage: virc <input.vri> [-o output] [--target arm64|x86_64|wasm32] [--format macho|elf]"
    echo ""
    echo "Pipeline:"
    echo "  Lexer & Parser → 10 Semantic Passes → HIR → MIR (CFG/SSA) → LIR (Chaitin-Briggs IRC) → Direct Linkerless AOT Codegen"
    echo ""
    echo "Optimizations (26 passes):"
    echo "  TCO, DCE, CSE, LICM, GVN, SCCP, Devirt, DAE, Inlining, SROA, EscapeArena, Pre, SLP, JumpThreading, LoopTiling, HotCold, Arm64Tune, ZeroCostABI"
    exit 0
fi

if [ "$#" -eq 1 ] && { [ "$1" = "--version" ] || [ "$1" = "-v" ]; }; then
    echo "virc (Vir Self-Hosted Modular Soft Compiler) 2.1.0"
    echo "Architecture: Self-Hosted Modular Pipeline (HIR -> MIR -> LIR -> Codegen)"
    echo "RegAlloc: Chaitin-Briggs Graph Coloring + George-Appel Iterated Coalescing (31 registers)"
    echo "Optimizations: 26 passes active (-O0 .. -O3)"
    echo "Targets: ARM64 (Mach-O, ELF), x86_64 (ELF, Mach-O), WASM32, RISC-V 64"
    exit 0
fi

if [ "$#" -eq 1 ] && { [ "$1" = "--help" ] || [ "$1" = "-h" ]; }; then
    echo "virc (Vir Self-Hosted Modular Soft Compiler) 2.1.0"
    echo "Usage: virc <input.vri> [-o output] [options]"
    echo ""
    echo "Options:"
    echo "  -o <path>             Specify output binary path (default: ./a.out)"
    echo "  --target=<arch>       Target architecture: arm64, x86_64, wasm32, riscv64"
    echo "  --format=<fmt>        Binary container format: macho, elf, wasm"
    echo "  -O0, -O1, -O2, -O3    Set optimization tier level"
    echo "  -v, --verbose         Enable verbose compilation diagnostics"
    echo "  --version             Show compiler version & pipeline info"
    echo "  --help                Display this manual"
    exit 0
fi

# Execute the Full Soft Compiler
exec "${ENGINE}" run "${COMPILER}" -- "$@"
