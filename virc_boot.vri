func boot_macho_copy_range:
    in(start: int, stop: int)
    let ci = start;
    when ci < stop loop
        if ci < g_mach_code_size do
            native_write_u8(g_mach_buf, g_mach_code_offset + ci, codebuf_get_byte(ci));
        end
        ci = ci + 1;
    end
end.

func boot_macho_copy_code:
    boot_macho_copy_range(0, 256);
    boot_macho_copy_range(256, 512);
    boot_macho_copy_range(512, 768);
    boot_macho_copy_range(768, 1024);
end.

func boot_macho_mb:
    out MachOBuilder {
        buf:          g_mach_buf,
        arch:         0,
        page_size:    PAGE_SIZE_ARM64,
        text_code:    0,
        data_bytes:   0,
        entry_offset: g_code_start_offset
    };
end.

func boot_macho_calc_layout:
    g_mach_code_size = codebuf_len();
    if g_mach_code_size > 8192 do
        g_mach_code_size = 8192;
    end
    let raw = g_mach_code_offset + g_mach_code_size;
    g_mach_text_seg_size = 16384;
    if raw > 16384 do
        g_mach_text_seg_size = ((raw + 16383) / 16384) * 16384;
    end
    g_mach_entry_file_off = g_mach_code_offset + g_snap_entry_off;
    g_mach_linkedit_off = g_mach_text_seg_size;
    g_mach_linkedit_vm = TEXT_BASE + g_mach_text_seg_size;
    g_mach_strtab_off = g_mach_linkedit_off + 48;
end.

func boot_macho_write_hdr:
    if g_mach_buf == 0 do
        g_mach_buf = bvec_new();
    end
    native_write_u8(g_mach_buf, 0, 0xCF);
    native_write_u8(g_mach_buf, 1, 0xFA);
    native_write_u8(g_mach_buf, 2, 0xED);
    native_write_u8(g_mach_buf, 3, 0xFE);
    native_write_u8(g_mach_buf, 4, 0x0C);
    native_write_u8(g_mach_buf, 5, 0x00);
    native_write_u8(g_mach_buf, 6, 0x00);
    native_write_u8(g_mach_buf, 7, 0x01);
    native_write_u8(g_mach_buf, 8, 0x00);
    native_write_u8(g_mach_buf, 9, 0x00);
    native_write_u8(g_mach_buf, 10, 0x00);
    native_write_u8(g_mach_buf, 11, 0x00);
    native_write_u8(g_mach_buf, 12, 0x02);
    native_write_u8(g_mach_buf, 13, 0x00);
    native_write_u8(g_mach_buf, 14, 0x00);
    native_write_u8(g_mach_buf, 15, 0x00);
    native_write_u8(g_mach_buf, 16, 0x0A);
    native_write_u8(g_mach_buf, 17, 0x00);
    native_write_u8(g_mach_buf, 18, 0x00);
    native_write_u8(g_mach_buf, 19, 0x00);
    native_write_u8(g_mach_buf, 20, 0x28);
    native_write_u8(g_mach_buf, 21, 0x02);
    native_write_u8(g_mach_buf, 22, 0x00);
    native_write_u8(g_mach_buf, 23, 0x00);
    native_write_u8(g_mach_buf, 24, 0x85);
    native_write_u8(g_mach_buf, 25, 0x00);
    native_write_u8(g_mach_buf, 26, 0x20);
    native_write_u8(g_mach_buf, 27, 0x00);
    native_write_u8(g_mach_buf, 28, 0x00);
    native_write_u8(g_mach_buf, 29, 0x00);
    native_write_u8(g_mach_buf, 30, 0x00);
    native_write_u8(g_mach_buf, 31, 0x00);
end.

func boot_macho_seg_pagezero:
    boot_macho_write_segment_n("__PAGEZERO", 10, 0, TEXT_BASE, 0, 0, 0, 0, 0);
end.

func boot_macho_seg_text:
    boot_macho_write_segment_n("__TEXT", 6,
        TEXT_BASE, g_mach_text_seg_size,
        0, g_mach_text_seg_size, 7, 5, 1);
end.

func boot_macho_sect_text:
    boot_macho_write_section_n("__text", 6, "__TEXT", 6,
        TEXT_BASE + g_mach_code_offset, g_mach_code_size, g_mach_code_offset,
        2, 0x80000400);
end.

func boot_macho_seg_linkedit:
    boot_macho_write_segment_n("__LINKEDIT", 10,
        g_mach_linkedit_vm, PAGE_SIZE_ARM64,
        g_mach_linkedit_off, 52, 1, 1, 0);
end.

func boot_macho_lc_fixups:
    g_mach_buf = bvec_push_u32_le(g_mach_buf, LC_DYLD_CHAINED_FIXUPS);
    g_mach_buf = bvec_push_u32_le(g_mach_buf, 16);
    g_mach_buf = bvec_push_u32_le(g_mach_buf, g_mach_linkedit_off);
    g_mach_buf = bvec_push_u32_le(g_mach_buf, 48);
end.

func boot_macho_lc_symtab:
    g_mach_buf = bvec_push_u32_le(g_mach_buf, LC_SYMTAB);
    g_mach_buf = bvec_push_u32_le(g_mach_buf, 24);
    g_mach_buf = bvec_push_u32_le(g_mach_buf, g_mach_strtab_off);
    g_mach_buf = bvec_push_u32_le(g_mach_buf, 0);
    g_mach_buf = bvec_push_u32_le(g_mach_buf, g_mach_strtab_off);
    g_mach_buf = bvec_push_u32_le(g_mach_buf, 4);
end.

func boot_macho_lc_dysymtab:
    g_mach_buf = bvec_push_u32_le(g_mach_buf, LC_DYSYMTAB);
    g_mach_buf = bvec_push_u32_le(g_mach_buf, 80);
    g_mach_buf = bvec_push_u32_le(g_mach_buf, 0);
    g_mach_buf = bvec_push_u32_le(g_mach_buf, 0);
    g_mach_buf = bvec_push_u32_le(g_mach_buf, 0);
    g_mach_buf = bvec_push_u32_le(g_mach_buf, 0);
    g_mach_buf = bvec_push_u32_le(g_mach_buf, 0);
    g_mach_buf = bvec_push_u32_le(g_mach_buf, 0);
    g_mach_buf = bvec_push_u32_le(g_mach_buf, 0);
    g_mach_buf = bvec_push_u32_le(g_mach_buf, 0);
    g_mach_buf = bvec_push_u32_le(g_mach_buf, 0);
    g_mach_buf = bvec_push_u32_le(g_mach_buf, 0);
    g_mach_buf = bvec_push_u32_le(g_mach_buf, 0);
    g_mach_buf = bvec_push_u32_le(g_mach_buf, 0);
    g_mach_buf = bvec_push_u32_le(g_mach_buf, 0);
    g_mach_buf = bvec_push_u32_le(g_mach_buf, 0);
    g_mach_buf = bvec_push_u32_le(g_mach_buf, 0);
    g_mach_buf = bvec_push_u32_le(g_mach_buf, 0);
    g_mach_buf = bvec_push_u32_le(g_mach_buf, 0);
    g_mach_buf = bvec_push_u32_le(g_mach_buf, 0);
    g_mach_buf = bvec_push_u32_le(g_mach_buf, 0);
end.

func boot_macho_lc_dyld:
    extern func native_read_u8(addr: int, offset: int) -> int;
    g_mach_buf = bvec_push_u32_le(g_mach_buf, LC_LOAD_DYLINKER);
    g_mach_buf = bvec_push_u32_le(g_mach_buf, 32);
    g_mach_buf = bvec_push_u32_le(g_mach_buf, 12);
    let dyld_path = "/usr/lib/dyld";
    let di = 0;
    when di < 20 loop
        if di < 13 do
            g_mach_buf = bvec_push(g_mach_buf, native_read_u8(dyld_path, di));
        else
            g_mach_buf = bvec_push(g_mach_buf, 0);
        end
        di = di + 1;
    end
end.

func boot_macho_lc_uuid:
    g_mach_buf = bvec_push_u32_le(g_mach_buf, LC_UUID);
    g_mach_buf = bvec_push_u32_le(g_mach_buf, 24);
    g_mach_buf = bvec_push(g_mach_buf, 1);
    g_mach_buf = bvec_push(g_mach_buf, 2);
    g_mach_buf = bvec_push(g_mach_buf, 3);
    g_mach_buf = bvec_push(g_mach_buf, 4);
    g_mach_buf = bvec_push(g_mach_buf, 5);
    g_mach_buf = bvec_push(g_mach_buf, 6);
    g_mach_buf = bvec_push(g_mach_buf, 7);
    g_mach_buf = bvec_push(g_mach_buf, 8);
    g_mach_buf = bvec_push(g_mach_buf, 9);
    g_mach_buf = bvec_push(g_mach_buf, 10);
    g_mach_buf = bvec_push(g_mach_buf, 11);
    g_mach_buf = bvec_push(g_mach_buf, 12);
    g_mach_buf = bvec_push(g_mach_buf, 13);
    g_mach_buf = bvec_push(g_mach_buf, 14);
    g_mach_buf = bvec_push(g_mach_buf, 15);
    g_mach_buf = bvec_push(g_mach_buf, 16);
end.

func boot_macho_lc_main:
    g_mach_buf = bvec_push_u32_le(g_mach_buf, LC_MAIN);
    g_mach_buf = bvec_push_u32_le(g_mach_buf, 24);
    g_mach_buf = bvec_push_u64_le(g_mach_buf, g_mach_entry_file_off);
    g_mach_buf = bvec_push_u64_le(g_mach_buf, 0);
end.

func boot_macho_lc_dylib:
    extern func native_read_u8(addr: int, offset: int) -> int;
    g_mach_buf = bvec_push_u32_le(g_mach_buf, LC_LOAD_DYLIB);
    g_mach_buf = bvec_push_u32_le(g_mach_buf, 56);
    g_mach_buf = bvec_push_u32_le(g_mach_buf, 24);
    g_mach_buf = bvec_push_u32_le(g_mach_buf, 0);
    g_mach_buf = bvec_push_u32_le(g_mach_buf, 0x00010000);
    g_mach_buf = bvec_push_u32_le(g_mach_buf, 0x00010000);
    let dylib_path = "/usr/lib/libSystem.B.dylib";
    let dli = 0;
    when dli < 32 loop
        if dli < 26 do
            g_mach_buf = bvec_push(g_mach_buf, native_read_u8(dylib_path, dli));
        else
            g_mach_buf = bvec_push(g_mach_buf, 0);
        end
        dli = dli + 1;
    end
end.

func boot_macho_pad_to_code:
    let cur = bvec_len(g_mach_buf);
    if cur < g_mach_code_offset do
        g_mach_buf = bvec_pad_zeros(g_mach_buf, g_mach_code_offset - cur);
    end
end.

func boot_macho_copy_code:
    let ci = 0;
    when ci < g_mach_code_size loop
        g_mach_buf = bvec_push(g_mach_buf, codebuf_get_byte(ci));
        ci = ci + 1;
    end
end.

func boot_macho_pad_text:
    let cur = bvec_len(g_mach_buf);
    if cur < g_mach_text_seg_size do
        g_mach_buf = bvec_pad_zeros(g_mach_buf, g_mach_text_seg_size - cur);
    end
end.

func boot_macho_write_linkedit:
    g_mach_buf = bvec_push_u32_le(g_mach_buf, 0);
    g_mach_buf = bvec_push_u32_le(g_mach_buf, 28);
    g_mach_buf = bvec_push_u32_le(g_mach_buf, 44);
    g_mach_buf = bvec_push_u32_le(g_mach_buf, 44);
    g_mach_buf = bvec_push_u32_le(g_mach_buf, 0);
    g_mach_buf = bvec_push_u32_le(g_mach_buf, 1);
    g_mach_buf = bvec_push_u32_le(g_mach_buf, 0);
    g_mach_buf = bvec_push_u32_le(g_mach_buf, 3);
    g_mach_buf = bvec_push_u32_le(g_mach_buf, 0);
    g_mach_buf = bvec_push_u32_le(g_mach_buf, 0);
    g_mach_buf = bvec_push_u32_le(g_mach_buf, 0);
    g_mach_buf = bvec_push_u32_le(g_mach_buf, 0);
    g_mach_buf = bvec_push_u32_le(g_mach_buf, 0);
    g_mach_buf = bvec_push_u32_le(g_mach_buf, 0);
end.

func boot_macho_flush:
    let data = bvec_data_ptr(g_mach_buf);
    write_file_bytes("a.out", data, 16436, 0o755);
end.

func boot_macho_write_linkedit_data:
    # dyld_chained_fixups_header + empty imports (matches known-good layout)
    boot_macho_gbuf_u32(16384, 0);
    boot_macho_gbuf_u32(16388, 28);
    boot_macho_gbuf_u32(16392, 44);
    boot_macho_gbuf_u32(16396, 44);
    boot_macho_gbuf_u32(16400, 0);
    boot_macho_gbuf_u32(16404, 1);
    boot_macho_gbuf_u32(16408, 0);
    boot_macho_gbuf_u32(16412, 3);
    boot_macho_gbuf_u32(16416, 0);
    boot_macho_gbuf_u32(16420, 0);
    boot_macho_gbuf_u32(16424, 0);
    boot_macho_gbuf_u32(16428, 0);
    boot_macho_gbuf_u32(16432, 0);
end.

func boot_macho_write_exit_stub:
    let eo = g_mach_entry_file_off;
    # MOV X0, #42 = D2 80 05 40
    native_write_u8(g_mach_buf, eo, 0x40);
    native_write_u8(g_mach_buf, eo + 1, 0x05);
    native_write_u8(g_mach_buf, eo + 2, 0x80);
    native_write_u8(g_mach_buf, eo + 3, 0xD2);
    # MOV X16, #1 = D2 80 00 30
    native_write_u8(g_mach_buf, eo + 4, 0x30);
    native_write_u8(g_mach_buf, eo + 5, 0x00);
    native_write_u8(g_mach_buf, eo + 6, 0x80);
    native_write_u8(g_mach_buf, eo + 7, 0xD2);
    # SVC #0x80 = D4 00 10 01
    native_write_u8(g_mach_buf, eo + 8, 0x01);
    native_write_u8(g_mach_buf, eo + 9, 0x10);
    native_write_u8(g_mach_buf, eo + 10, 0x00);
    native_write_u8(g_mach_buf, eo + 11, 0xD4);
end.

func boot_dump_code:
    # Debug: dump raw codegen bytes to code.bin for disassembly
    let n = codebuf_len();
    if n <= 0 do
        print_ln("virc: dump: no code");
        out 0;
    end
    let b = bvec_reserve(n);
    if b == 0 do
        print_ln("virc: dump: alloc failed");
        out 0;
    end
    let i = 0;
    when i < n loop
        native_write_u8(b, i, codebuf_get_byte(i));
        i = i + 1;
    end
    print_ln("virc: dump: copied");
    write_file_bytes("code.bin", b, n, 0o644);
    print_ln("virc: dump: written");
    out n;
end.

func boot_macho_copy_code_all:
    # Copy real generated code into the __text region at g_mach_code_offset
    let n = codebuf_len();
    if n > g_mach_code_size do
        n = g_mach_code_size;
    end
    let i = 0;
    when i < n loop
        native_write_u8(g_mach_buf, g_mach_code_offset + i, codebuf_get_byte(i));
        i = i + 1;
    end
end.

func boot_macho_page_buf:
    # 32KB anonymous mmap for Mach-O output (no heap freelist).
    let ptr = sys_mmap(0, 32768,
                       PROT_READ | PROT_WRITE,
                       MAP_PRIVATE | MAP_ANONYMOUS,
                       -1, 0);
    if ptr < 0 do
        out 0;
    end
    out ptr;
end.

func boot_macho_link_basic42:
    g_mach_text_code = 0;
    g_mach_code_size = codebuf_len();
    if g_mach_code_size > 8192 do
        g_mach_code_size = 8192;
    end
    g_mach_text_seg_size = 16384;
    g_mach_entry_file_off = g_mach_code_offset + g_snap_entry_off;
    g_mach_linkedit_off = 16384;
    g_mach_linkedit_vm = TEXT_BASE + 16384;
    g_mach_strtab_off = 16432;
    # Fresh mmap page — heap freelist can be corrupt after long self-host.
    g_mach_buf = boot_macho_page_buf();
    if g_mach_buf == 0 do
        print_ln("virc: link: alloc failed");
        sys_exit(1);
    end
    print_ln("virc: link: buf ok");
    boot_macho_w_part1();
    print_ln("virc: link: p1");
    boot_macho_w_part2();
    boot_macho_w_part3();
    boot_macho_w_part3b();
    print_ln("virc: link: p3");
    boot_macho_w_part4();
    boot_macho_w_part4b();
    print_ln("virc: link: p4");
    boot_macho_copy_code_all();
    print_ln("virc: link: code copied");
    boot_macho_write_linkedit_data();
    print_ln("virc: link: linkedit");
    boot_macho_flush();
    print_ln("virc: link: flushed");
end.

func boot_do_lower:
    print_ln("virc: lowering to Q-IR...");
    boot_q_stage_reset();
    g_boot_fn_progress = 0;
    g_cur_func_body = 0;
    let ast_for_lower = AstNode {
        name:       "",
        name2:      "",
        node_type:  AstType.Program,
        op:         OpType::Add,
        line:       0,
        int_val:    0,
        float_val:  0.0,
        builtin_id: 0,
        children:   g_ast_children_acc
    };
    let ctx = lower_ctx_new("main");
    lower_program(ctx, ast_for_lower);
    if g_boot_emit_count == 0 do
        if vec_len_rt(g_mod_funcs_acc) == 0 do
            boot_lower_test_main(ctx);
        end
    end
    g_snap_mod_funcs = g_mod_funcs_acc;
    g_snap_mod_strings = g_mod_strings_acc;
    g_snap_func_count = vec_len_rt(g_snap_mod_funcs);
    g_dbg_nfunc = g_snap_func_count;
    if g_snap_func_count == 0 and g_boot_emit_count == 0 do
        print_ln("virc: error_msg: lower produced no functions");
        sys_exit(1);
    end
    print_ln("virc: lower done");

    print_ln("virc: generating ARM64 machine code...");
    # Prefer real codegen when the lowered bodies are non-empty. Fall back to
    # the flat-staging mini-codegen (const-fold path) otherwise.
    let body0_n = 0;
    if g_snap_func_count > 0 do
        let f0 = vec_get_rt(g_snap_mod_funcs, 0);
        body0_n = vec_len_rt(f0.body);
    end
    if g_bd_total > 0 do
        print_ln("virc: codegen via body-dump");
    end
    # Body-dump codegen (small_multi or self-host dump). Else flat / stub.
    if g_boot_small_multi != 0 or g_bd_total > 0 do
        let real_mod = QModule {
            name:       "main",
            functions:  g_snap_mod_funcs,
            strings:    g_snap_mod_strings
        };
        boot_codegen_emit_mod_min(real_mod);
        g_snap_entry_off = g_code_start_offset;
    else
        if g_boot_emit_count > 0 do
            boot_codegen_flat_min();
        else
            if body0_n > 0 do
                let real_mod2 = QModule {
                    name:       "main",
                    functions:  g_snap_mod_funcs,
                    strings:    g_snap_mod_strings
                };
                boot_codegen_emit_mod_min(real_mod2);
                g_snap_entry_off = g_code_start_offset;
            else
                boot_codegen_basic42();
            end
        end
    end
    print_ln("virc: linking Mach-O executable...");
    let code_size = codebuf_len();
    if code_size == 0 do
        print_ln("virc: error_msg: codegen produced no machine code");
        sys_exit(1);
    end
    # Avoid print_int(code_size): return value / globals clobber across Calls
    # and has SIGSEGV'd self-host right after "code_size=".
    print_ln("virc: code_size ok");
    boot_macho_link_basic42();
    print_ln("virc: done! wrote a.out");
end.


# ═══════════════════════════════════════════════════════
# Compiler Pipeline
# ═══════════════════════════════════════════════════════

func virc_compile:

    comp_arena_begin();

    let src = read_file_str(g_input_path);
    g_read_src = src;
    g_source_raw = src;
    if src == 0 do
        print_ln("virc: error_msg: cannot read input file");
        sys_exit(1);
    end
    g_snap_src_len = boot_file_size(g_input_path);
    if g_snap_src_len <= 0 do
        g_snap_src_len = g_source_len;
    end
    g_source_len = g_snap_src_len;
    g_dbg_src_len = g_snap_src_len;

    print_ln("virc: tokenizing...");
    let lex = lexer_new(src);
    lex = boot_tokenize_scan(lex);
    g_compile_tokens = g_lx_tokens;
    if g_compile_tokens == 0 do
        g_compile_tokens = g_boot_tokens;
    end
    g_snap_tok_count = g_boot_tok_count;
    if g_snap_tok_count == 0 do
        print_ln("virc: error_msg: tokenize produced no tokens");
        sys_exit(1);
    end

    print_ln("virc: parsing...");
    let parser = parser_new(g_compile_tokens);
    var (parser2, ast) = parse_program(parser);
    if g_snap_ast_kids == 0 do
        print_ln("virc: error_msg: parse produced empty AST");
        sys_exit(1);
    end
    print_ln("virc: parse done");

    boot_do_lower();
    out 0;
end.


# ═══════════════════════════════════════════════════════
# Entry Point (called from _start via rt/start.vri)
# ═══════════════════════════════════════════════════════

func boot_selftest:
    # T1: plain loop, no calls in body except literal write
    let a = 0;
    when a < 5 loop
        sys_write(2, ".", 1);
        a = a + 1;
    end
    sys_write(2, "E", 1);
    # T2: two sequential allocs, no loop
    let p1 = vir_alloc(4);
    if p1 == 0 do
        sys_write(2, "Z", 1);
    else
        sys_write(2, "P", 1);
    end
    let p2 = vir_alloc(4);
    if p2 == 0 do
        sys_write(2, "Z", 1);
    else
        sys_write(2, "P", 1);
    end
    # T3: loop with alloc in body
    let i = 0;
    when i < 10 loop
        let buf = vir_alloc(1);
        if buf == 0 do
            sys_write(2, "N", 1);
        else
            native_write_u8(buf, 0, 48 + i);
            let r = sys_write(2, buf, 1);
            if r <= 0 do
                sys_write(2, "!", 1);
            end
        end
        i = i + 1;
        if i > 12 do
            sys_write(2, "O", 1);
            out;
        end
    end
    sys_write(2, "\n", 1);
end.

func main:
    boot_selftest();
    print_ln("====================================");
    print_ln("  virc — Vir Self-Hosting Compiler");
    print_ln("  v1.2.0 — Zero Python, Zero C");
    print_ln("====================================");

    g_verbose = 1;
    g_target = 0;
    g_format = 0;
    g_output_path = "a.out";
    g_input_path = get_arg(0);
    init_keywords();
    out virc_compile();
end.

export vir_main, virc_compile, parse_args, CompilerConfig;
# ══ END vir/compiler/virc ══
