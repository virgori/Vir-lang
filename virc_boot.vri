end.

func boot_set_s2v:
    in(v: int)
    extern func native_write_i64(addr: int, offset: int, val: int);
    if g_boot_name_cell == 0 do
        boot_name_cell_init();
    end
    native_write_i64(g_boot_name_cell, 48, v);
end.

func boot_get_s2v:
    extern func native_read_i64(addr: int, offset: int) -> int;
    if g_boot_name_cell == 0 do
        out 0;
