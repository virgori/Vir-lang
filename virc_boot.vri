        boot_name_cell_init();
    end
    native_write_i64(g_boot_name_cell, 32, v);
end.

func boot_get_dv:
    extern func native_read_i64(addr: int, offset: int) -> int;
    if g_boot_name_cell == 0 do
        out 0;
    end
    out native_read_i64(g_boot_name_cell, 32);
end.

func boot_set_s1v:
    in(v: int)
