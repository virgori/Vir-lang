func boot_set_imm:
    in(imm: int)
    extern func native_write_i64(addr: int, offset: int, val: int);
    g_cg_imm = imm;
    if g_boot_name_cell == 0 do
        boot_name_cell_init();
    end
    native_write_i64(g_boot_name_cell, 24, imm);
end.

func boot_get_imm:
    extern func native_read_i64(addr: int, offset: int) -> int;
    if g_boot_name_cell == 0 do
        out g_cg_imm;
    end
    out native_read_i64(g_boot_name_cell, 24);
end.

func boot_set_dv:
