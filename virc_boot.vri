func boot_set_init_const:
    in(v: int)
    extern func native_write_i64(addr: int, offset: int, val: int);
    if g_boot_name_cell == 0 do
        boot_name_cell_init();
    end
    native_write_i64(g_boot_name_cell, 56, v);
    g_boot_init_const = v;
end.

func boot_get_init_const:
    extern func native_read_i64(addr: int, offset: int) -> int;
    if g_boot_name_cell == 0 do
        out g_boot_init_const;
    end
    out native_read_i64(g_boot_name_cell, 56);
end.

func boot_flat_push:
    # Push one op from cells: opc/flags in g_st_*; dest/src/imm from native cells.
    # Capture Vir staging locals first — helper calls can clobber globals.
    extern func native_write_i64(addr: int, offset: int, val: int);
    extern func native_read_i64(addr: int, offset: int) -> int;
    if g_boot_flat_active == 0 do
        out;
    end
    let opc = g_st_opc;
    let s1f = g_st_s1f;
    let s2f = g_st_s2f;
    let s2i = g_st_s2i;
    if g_boot_q_opc == 0 do
        boot_q_stage_reset();
    end
    let idx = 0;
    if g_boot_q_meta != 0 do
        idx = native_read_i64(g_boot_q_meta, 0);
    end
    # Cap: 4096-byte arrays hold 512 slots; stop before overflow (self-host).
    if idx >= 500 do
        out;
    end
    let dv = boot_get_dv();
    let immv = boot_get_imm();
    let s1v = boot_get_s1v();
    let s2v = boot_get_s2v();
    native_write_i64(g_boot_q_dst, idx * 8, dv);
    native_write_i64(g_boot_q_s1f, idx * 8, s1f);
    native_write_i64(g_boot_q_s1i, idx * 8, immv);
    native_write_i64(g_boot_q_s1v, idx * 8, s1v);
    native_write_i64(g_boot_q_s2f, idx * 8, s2f);
    native_write_i64(g_boot_q_s2i, idx * 8, s2i);
    native_write_i64(g_boot_q_s2v, idx * 8, s2v);
    native_write_i64(g_boot_q_opc, idx * 8, opc);
    g_boot_emit_count = idx + 1;
    if g_boot_q_meta != 0 do
        native_write_i64(g_boot_q_meta, 0, idx + 1);
    end
end.

func boot_set_last_vreg:
    in(r: int)
    extern func native_write_i64(addr: int, offset: int, val: int);
    g_boot_last_vreg = r;
    if g_boot_name_cell == 0 do
        boot_name_cell_init();
    end
    native_write_i64(g_boot_name_cell, 16, r);
end.

func boot_get_last_vreg:
    extern func native_read_i64(addr: int, offset: int) -> int;
    if g_boot_name_cell == 0 do
        out g_boot_last_vreg;
    end
    out native_read_i64(g_boot_name_cell, 16);
end.
var g_boot_print_vreg = 0 - 1;
var g_boot_var_name = 0;
var g_boot_print_name = 0;
var g_boot_init_const = -1;
var g_pending_stmt_type = 0;
var g_pending_stmt_name = 0;

func ast_add_child:
    in(parent: AstNode, child: AstNode)
    kids = parent.children;
    if kids == 0 do
        kids = vec_new_rt();
    end
    kids = vec_push_rt(kids, child);
    g_ast_children_acc = kids;
    # Do NOT push to g_ast_node_types here — nested children would
    # pollute top-level type indexing used by lower_program.
    out AstNode {
        name:       parent.name,
        name2:      parent.name2,
        node_type:  parent.node_type,
        op:         parent.op,
        line:       parent.line,
        int_val:    parent.int_val,
        float_val:  parent.float_val,
        builtin_id: parent.builtin_id,
        children:   kids
    };
end.


# ═══════════════════════════════════════════════════════
# Builtin Function Lookup
# ═══════════════════════════════════════════════════════

enum BuiltinId:
    None            = 0;
    Len             = 1;
    Push            = 2;
    Alloc           = 3;
    FreeMem         = 4;
    Read8           = 5;
    Write8          = 6;
    Read64          = 7;
    Write64         = 8;
    StrLen          = 9;
    StrGet          = 10;
    StrCat          = 11;
    StrEq           = 12;
    FileOpen        = 13;
    FileRead        = 14;
    FileWrite       = 15;
    FileClose       = 16;
    FileWriteByte   = 17;
    Exit            = 18;
    IToStr          = 19;
    StrToI          = 20;
    ArrNew          = 21;
    PrintStr        = 22;
    GetArg          = 23;
    ArgCount        = 24;
end.

entity BuiltinEntry:
    name:   string;
    bid:    BuiltinId;
end.

func build_builtins:
    table = vec_new_rt();
    table = vec_push_rt(table, BuiltinEntry ( name: "len", bid: BuiltinId::Len ));
    table = vec_push_rt(table, BuiltinEntry ( name: "push", bid: BuiltinId::Push ));
    table = vec_push_rt(table, BuiltinEntry ( name: "alloc", bid: BuiltinId::Alloc ));
    table = vec_push_rt(table, BuiltinEntry ( name: "dealloc", bid: BuiltinId::FreeMem ));
    table = vec_push_rt(table, BuiltinEntry ( name: "read_byte", bid: BuiltinId::Read8 ));
    table = vec_push_rt(table, BuiltinEntry ( name: "write_byte", bid: BuiltinId::Write8 ));
    table = vec_push_rt(table, BuiltinEntry ( name: "read_word", bid: BuiltinId::Read64 ));
    table = vec_push_rt(table, BuiltinEntry ( name: "write_word", bid: BuiltinId::Write64 ));
    table = vec_push_rt(table, BuiltinEntry ( name: "str_len", bid: BuiltinId::StrLen ));
    table = vec_push_rt(table, BuiltinEntry ( name: "str_get", bid: BuiltinId::StrGet ));
    table = vec_push_rt(table, BuiltinEntry ( name: "str_cat", bid: BuiltinId::StrCat ));
    table = vec_push_rt(table, BuiltinEntry ( name: "str_eq", bid: BuiltinId::StrEq ));
    table = vec_push_rt(table, BuiltinEntry ( name: "file_open", bid: BuiltinId::FileOpen ));
    table = vec_push_rt(table, BuiltinEntry ( name: "file_read", bid: BuiltinId::FileRead ));
    table = vec_push_rt(table, BuiltinEntry ( name: "file_write", bid: BuiltinId::FileWrite ));
    table = vec_push_rt(table, BuiltinEntry ( name: "file_close", bid: BuiltinId::FileClose ));
    table = vec_push_rt(table, BuiltinEntry ( name: "file_write_byte", bid: BuiltinId::FileWriteByte ));
    table = vec_push_rt(table, BuiltinEntry ( name: "exit_prog", bid: BuiltinId::Exit ));
    table = vec_push_rt(table, BuiltinEntry ( name: "i_to_str", bid: BuiltinId::IToStr ));
    table = vec_push_rt(table, BuiltinEntry ( name: "int_to_str", bid: BuiltinId::IToStr ));
    table = vec_push_rt(table, BuiltinEntry ( name: "str_to_i", bid: BuiltinId::StrToI ));
    table = vec_push_rt(table, BuiltinEntry ( name: "str_to_int", bid: BuiltinId::StrToI ));
    table = vec_push_rt(table, BuiltinEntry ( name: "arr_new", bid: BuiltinId::ArrNew ));
    table = vec_push_rt(table, BuiltinEntry ( name: "arr_push", bid: BuiltinId::Push ));
    table = vec_push_rt(table, BuiltinEntry ( name: "arr_len", bid: BuiltinId::Len ));
    table = vec_push_rt(table, BuiltinEntry ( name: "print_str", bid: BuiltinId::PrintStr ));
    table = vec_push_rt(table, BuiltinEntry ( name: "get_arg", bid: BuiltinId::GetArg ));
    table = vec_push_rt(table, BuiltinEntry ( name: "arg_count", bid: BuiltinId::ArgCount ));
    out table;
end.

func lookup_builtin:
    in(table: int, name: string)
    i = 0;
    when i < vec_len_rt(table) loop
        entry = vec_get_rt(table, i);
        if rt_streq(entry.name, name) do
            out entry.bid;
        end
        i = i + 1;
    end
    out BuiltinId::None;
end.


# ═══════════════════════════════════════════════════════
# Parser State
# ═══════════════════════════════════════════════════════

entity Parser:
    tokens:         int;
    pos:            int;
    token_count:    int;
    error_msg:          string;
    error_line:     int;
    builtins:       int;
end.

func parser_new:
    in(tokens: int)
    tc = vec_len_rt(tokens);
    if tc == 0 do
        tc = g_boot_tok_count;
    end
    bi = build_builtins();
    p = Parser {
        tokens:      tokens,
        pos:         0,
        token_count: tc,
        error_msg:       "",
        error_line:  0,
        builtins:    bi
    };
    out p;
end.


# ═══════════════════════════════════════════════════════
# Parser Helpers
# ═══════════════════════════════════════════════════════

func parse_error:
    in(p: Parser, msg: string)
    if rt_strlen(p.error_msg) == 0 do
        t = peek(p);
        p.error_msg = rt_strcat(rt_strcat("line ", rt_itoa(t.line as int)), rt_strcat(": ", msg));
        p.error_line = t.line;
    end
    out p;
end.

func peek:
    in(p: Parser)
    idx = p.pos;
    if idx >= p.token_count do
        idx = p.token_count - 1;
    end
    if g_boot_tok_types != 0 and idx < vec_len_rt(g_boot_tok_types) do
        tt = vec_get_rt(g_boot_tok_types, idx as int);
        ln = vec_get_rt(g_boot_tok_lines, idx as int);
        cl = vec_get_rt(g_boot_tok_cols, idx as int);
        sv = vec_get_rt(g_boot_tok_strs, idx as int);
        iv = vec_get_rt(g_boot_tok_ivals, idx as int);
        out Token {
            tok_type:   tt,
            line:       ln,
            col:        cl,
            str_val:    sv,
            tok_ival:   iv,
            tok_fval:   0.0
        };
    end
    out vec_get_rt(p.tokens, idx as int);
end.

func advance:
    in(p: Parser)
    t = peek(p);
    if p.pos < p.token_count do
        p.pos = p.pos + 1;
    end
    out (p, t);
end.

func check:
    in(p: Parser, tok_type: TokType)
    out peek(p).tok_type == tok_type;
end.

func match_tok:
    in(p: Parser, tok_type: TokType)
    if check(p, tok_type) do
        var (p2, _) = advance(p);
        out (p2, true);
    end
    out (p, false);
end.

func expect_tok:
    in(p: Parser, tok_type: TokType, msg: string)
    if check(p, tok_type) do
        var (p2, t) = advance(p);
        out (p2, t, true);
    end
    p = parse_error(p, msg);
    out (p, peek(p), false);
end.

# Soft names: Ident + keywords usable as identifiers (C-core is_name_token).
# Needed so `func map:` / `func get:` etc. parse — keywords still carry str_val.
func is_name_tok:
    in(t: TokType)
    if t == TokType.Ident do
        out true;
    end
    if t >= TokType.Func and t <= TokType.TypeKw do
        out true;
    end
    if t >= TokType.If and t <= TokType.In do
        out true;
    end
    if t >= TokType.Print and t <= TokType.Patch do
        out true;
    end
    if t >= TokType.Import and t <= TokType.Get do
        out true;
    end
    if t >= TokType.True and t <= TokType.NoneLit do
        out true;
    end
    if t >= TokType.Try and t <= TokType.MapKw do
        out true;
    end
    out false;
end.

func expect_name:
    in(p: Parser, msg: string)
    t = peek(p);
    if is_name_tok(t.tok_type) do
        var (p2, t2) = advance(p);
        out (p2, t2, true);
    end
    p = parse_error(p, msg);
    out (p, peek(p), false);
end.

# Match optional block opener ':' | 'then' | 'do'
func match_block_open:
    in(p: Parser)
    var (p2, m1) = match_tok(p, TokType.Colon);
    if m1 do
        out p2;
    end
    var (p3, m2) = match_tok(p, TokType.Then);
    if m2 do
        out p3;
    end
    out p;
end.

# Skip a type annotation:
#   Ident [ < balanced > ] [ array brackets ... ]
#   [T] / [Ident] array types (e.g. instrs:[QInstr])
func skip_type_annot:
    in(p: Parser)
    # Leading array type: [T]
    if check(p, TokType.LBracket) do
        var (p2, _) = advance(p);
        p = p2;
        depth = 1;
        when depth > 0 and not check(p, TokType.Eof) loop
            if check(p, TokType.LBracket) do
                depth = depth + 1;
            end
            if check(p, TokType.RBracket) do
                depth = depth - 1;
            end
            var (p3, _) = advance(p);
            p = p3;
        end
        out p;
    end

    if is_name_tok(peek(p).tok_type) do
        var (p2, _) = advance(p);
        p = p2;
    end
    var (p3, has_lt) = match_tok(p, TokType.Lt);
    if has_lt do
        p = p3;
        depth = 1;
        when depth > 0 and not check(p, TokType.Eof) loop
            if check(p, TokType.Lt) do
                depth = depth + 1;
            end
            if check(p, TokType.Gt) do
                depth = depth - 1;
            end
            var (p4, _) = advance(p);
            p = p4;
        end
    end
    # Trailing array brackets: T[] / T[N]
    when check(p, TokType.LBracket) loop
        var (p5, _) = advance(p);
        p = p5;
        depth = 1;
        when depth > 0 and not check(p, TokType.Eof) loop
            if check(p, TokType.LBracket) do
                depth = depth + 1;
            end
            if check(p, TokType.RBracket) do
                depth = depth - 1;
            end
            var (p6, _) = advance(p);
            p = p6;
        end
    end
    out p;
end.

func skip_newlines:
    in(p: Parser)
    when check(p, TokType.Newline) loop
        var (p2, _) = advance(p);
        p = p2;
    end
    out p;
end.

func is_stmt_start:
    in(t: TokType)
    out t == TokType.Var or t == TokType.Const or t == TokType.If or t == TokType.Loop or t == TokType.While or t == TokType.When or t == TokType.For or t == TokType.Out or t == TokType.Print or t == TokType.Input or t == TokType.Ident or t == TokType.Int or t == TokType.Float or t == TokType.Str or t == TokType.LParen or t == TokType.Minus or t == TokType.Not or t == TokType.CheckCpu or t == TokType.Patch or t == TokType.Func or t == TokType.Break or t == TokType.Skip or t == TokType.True or t == TokType.False or t == TokType.LBracket or t == TokType.Enum or t == TokType.Entity or t == TokType.Import or t == TokType.From or t == TokType.Module or t == TokType.Export or t == TokType.Include;
end.

# Parse one call argument, accepting named form `IDENT: expr` / `IDENT = expr`.
func parse_call_arg:
    in(p: Parser)
    if check(p, TokType.Ident) do
        let nt = boot_parser_tok_type_at(p, p.pos + 1);
        let nt2 = boot_parser_tok_type_at(p, p.pos + 2);
        let is_named = (nt == TokType.Assign) or (nt == TokType.Colon and nt2 != TokType.Colon);
        if is_named do
            var (p1, nm) = advance(p);
            var (p1b, _) = advance(p1);
            var (p1c, val) = parse_expr(p1b);
            val.name2 = nm.str_val;
            out (p1c, val);
        end
    end
    out parse_expr(p);
end.


# ═══════════════════════════════════════════════════════
# Expression Parsing (precedence climbing)
# ═══════════════════════════════════════════════════════

func parse_primary:
    in(p: Parser)
    t = peek(p);

    # Integer literal
    if t.tok_type == TokType.Int do
        var (p2, t2) = advance(p);
        n = ast_new(AstType.LiteralInt);
        n.int_val = t2.tok_ival;
        n.line = t2.line;
        out (p2, n);
    end

    # Float literal
    if t.tok_type == TokType.Float do
        var (p2, t2) = advance(p);
        n = ast_new(AstType.LiteralFloat);
        n.float_val = t2.tok_fval;
        n.line = t2.line;
        out (p2, n);
    end

    # String literal
    if t.tok_type == TokType.Str do
        var (p2, t2) = advance(p);
        n = ast_new(AstType.LiteralStr);
        n.name = t2.str_val;
        n.line = t2.line;
        out (p2, n);
    end

    # Boolean true
    if t.tok_type == TokType.True do
        var (p2, _) = advance(p);
        n = ast_new(AstType.LiteralInt);
        n.int_val = 1;
        n.line = t.line;
        out (p2, n);
    end

    # Boolean false / none
    if t.tok_type == TokType.False or t.tok_type == TokType.NoneLit do
        var (p2, _) = advance(p);
        n = ast_new(AstType.LiteralInt);
        n.int_val = 0;
        n.line = t.line;
        out (p2, n);
    end

    # Identifier (may be call, index, entity literal...)
    if t.tok_type == TokType.Ident do
        var (p2, id_tok) = advance(p);

        # Check for enum access: IDENT '::' variant
        if check(p, TokType.DoubleColon) do
            var (p3, _) = advance(p);  # consume ::
            # The variant name might be a keyword (e.g. TokType.Func)
            # Accept any token that has a str_val
            vt = peek(p3);
            var (p4, _) = advance(p3);
            ea = ast_new(AstType.EnumAccess);
            ea.name = id_tok.str_val;
            ea.name2 = vt.str_val;
            ea.line = id_tok.line;
            out (p4, ea);
        end

        # Check for entity literal: IDENT '{' field: val, ... '}'
        if check(p, TokType.LBrace) and check_entity_literal(p) do
            var (p3, _) = advance(p)  # consume '{';
            p3 = skip_newlines(p3);
            el = ast_new(AstType.EntityLiteral);
            el.name = id_tok.str_val;
            el.line = id_tok.line;
            when not check(p3, TokType.RBrace) and not check(p3, TokType.Eof) loop
                var (p4, fname, ok) = expect_tok(p3, TokType.Ident, "expected field name");
                p3 = p4;
                if not ok do
                    out (p3, el);
                end
                var (p5, has_sep) = match_tok(p3, TokType.Colon);
                if not has_sep do
                    var (p5b, has_eq) = match_tok(p3, TokType.Assign);
                    p3 = p5b;
                    if not has_eq do
                        out (p3, el);
                    end
                else
                    p3 = p5;
                end
                var (p6, val) = parse_expr(p3);
                p3 = p6;
                val.name2 = fname.str_val;
                el = ast_add_child(el, val);
                var (p7, _) = match_tok(p3, TokType.Comma);
                p3 = p7;
                var (p7b, _) = match_tok(p3, TokType.Semicolon);
                p3 = p7b;
                p3 = skip_newlines(p3);
            end
            var (p8, _, _) = expect_tok(p3, TokType.RBrace, "expected '}' after entity literal");
            out (p8, el);
        end

        # Check for generic call: IDENT '<' Type '>' '(' ... ')'
        # Only when '>' appears before '(' — otherwise '<' is comparison.
        if check(p, TokType.Lt) do
            save_pos = p.pos;
            scan_i = p.pos + 1;
            found_gt = false;
            guard = 0;
            when guard < 12 and scan_i < p.token_count loop
                stt = boot_parser_tok_type_at(p, scan_i);
                if stt == TokType.Gt do
                    found_gt = true;
                    scan_i = scan_i + 1;
                    guard = 12;
                else
                    if stt == TokType.LParen or stt == TokType.Comma or stt == TokType.Semicolon or stt == TokType.End do
                        guard = 12;
                    else
                        scan_i = scan_i + 1;
                        guard = guard + 1;
                    end
                end
            end
            if found_gt and scan_i < p.token_count and boot_parser_tok_type_at(p, scan_i) == TokType.LParen do
                var (p_g1, _) = advance(p);
                depth = 1;
                when depth > 0 and not check(p_g1, TokType.Eof) loop
                    g_tok = peek(p_g1);
                    if g_tok.tok_type == TokType.Lt do
                        depth = depth + 1;
                    end
                    if g_tok.tok_type == TokType.Gt do
                        depth = depth - 1;
                    end
                    var (p_g2, _) = advance(p_g1);
                    p_g1 = p_g2;
                end
                if depth == 0 do
                    p = p_g1;
                else
                    p.pos = save_pos;
                end
            end
        end

        # Check for function call: IDENT '('
        if check(p, TokType.LParen) do
            bid = lookup_builtin(p.builtins, id_tok.str_val);
            if bid != BuiltinId::None do
                # Builtin call
                call = ast_new(AstType.BuiltinCall);
                call.builtin_id = bid as int;
                call.name = id_tok.str_val;
                call.line = id_tok.line;
                var (p3, _) = advance(p)  # consume '(';
                if not check(p3, TokType.RParen) do
                    var (p4, arg) = parse_expr(p3);
                    p3 = p4;
                    call = ast_add_child(call, arg);
                    should_loop = true;
                    when should_loop loop
                        var (p5, matched) = match_tok(p3, TokType.Comma);
                        p3 = p5;
                        if not matched do
                            should_loop = false;
                        else
                            var (p6, arg2) = parse_expr(p3);
                            p3 = p6;
                            call = ast_add_child(call, arg2);
                        end
                    end
                end
                var (p7, _, _) = expect_tok(p3, TokType.RParen, "expected ')' after builtin args");
                out (p7, call);
            end

            # Regular function call
            call = ast_new(AstType.Call);
            call.name = id_tok.str_val;
            call.line = id_tok.line;
            var (p3, _) = advance(p)  # consume '(';
            if not check(p3, TokType.RParen) do
                var (p4, arg) = parse_call_arg(p3);
                p3 = p4;
                call = ast_add_child(call, arg);
                should_loop = true;
                when should_loop loop
                    var (p5, matched) = match_tok(p3, TokType.Comma);
                    p3 = p5;
                    if not matched do
                        var (p5b, matched2) = match_tok(p3, TokType.Semicolon);
                        p3 = p5b;
                        if not matched2 do
                            should_loop = false;
                        else
                            var (p6b, arg3) = parse_call_arg(p3);
                            p3 = p6b;
                            call = ast_add_child(call, arg3);
                        end
                    else
                        var (p6, arg2) = parse_call_arg(p3);
                        p3 = p6;
                        call = ast_add_child(call, arg2);
                    end
                end
            end
            var (p7, _, _) = expect_tok(p3, TokType.RParen, "expected ')' after arguments");
            out (p7, call);
        end

        # Check for index access: IDENT '['
        if check(p, TokType.LBracket) do
            var (p3, _) = advance(p)  # consume '[';
            var (p4, idx_expr) = parse_expr(p3);
            var (p5, _, _) = expect_tok(p4, TokType.RBracket, "expected ']' after index");
            access = ast_new(AstType.IndexAccess);
            access.name = id_tok.str_val;
            access.line = id_tok.line;
            access = ast_add_child(access, idx_expr);
            out (p5, access);
        end

        # Plain identifier
        n = ast_new(AstType.Identifier);
        n.name = id_tok.str_val;
        n.line = id_tok.line;
        out (p, n);
    end

    # Input expression
    if t.tok_type == TokType.Input do
        var (p2, _) = advance(p);
        n = ast_new(AstType.InputExpr);
        n.line = t.line;
        out (p2, n);
    end

    # Parenthesised expression or tuple (a, b, ...)
    if t.tok_type == TokType.LParen do
        var (p2, _) = advance(p);
        if check(p2, TokType.RParen) do
            var (p_empty, _) = advance(p2);
            tup = ast_new(AstType.TupleExpr);
            tup.line = t.line;
            out (p_empty, tup);
        end
        var (p3, inner) = parse_expr(p2);
        if check(p3, TokType.Comma) do
            tup = ast_new(AstType.TupleExpr);
            tup.line = t.line;
            tup = ast_add_child(tup, inner);
            should_loop = true;
            when should_loop loop
                var (p4, matched) = match_tok(p3, TokType.Comma);
                p3 = p4;
                if not matched do
                    should_loop = false;
                eif check(p3, TokType.RParen) do
                    should_loop = false;
                else
                    var (p5, elem) = parse_expr(p3);
                    p3 = p5;
                    tup = ast_add_child(tup, elem);
                end
            end
            var (p6, _, _) = expect_tok(p3, TokType.RParen, "expected ')' to close tuple");
            out (p6, tup);
        end
        var (p4, _, _) = expect_tok(p3, TokType.RParen, "expected ')'");
        out (p4, inner);
    end

    # Array literal: [elem, ...]
    if t.tok_type == TokType.LBracket do
        var (p2, _) = advance(p);
        arr = ast_new(AstType.ArrayLiteral);
        arr.line = t.line;
        if not check(p2, TokType.RBracket) do
            var (p3, elem) = parse_expr(p2);
            p2 = p3;
            arr = ast_add_child(arr, elem);
            should_loop = true;
            when should_loop loop
                var (p4, matched) = match_tok(p2, TokType.Comma);
                p2 = p4;
                if not matched do
                    should_loop = false;
                else
                    var (p5, elem2) = parse_expr(p2);
                    p2 = p5;
                    arr = ast_add_child(arr, elem2);
                end
            end
        end
        var (p6, _, _) = expect_tok(p2, TokType.RBracket, "expected ']' after array literal");
        out (p6, arr);
    end

    # Error — expected expression
    p = parse_error(p, "expected expression");
    out (p, ast_new(AstType.LiteralInt));
end.


func check_entity_literal:
    in(p: Parser)
    # Lookahead for entity literal: '{' [newline]* ( IDENT ':' | '}' )
    if not check(p, TokType.LBrace) do
        out false;
    end
    next_idx = p.pos + 1;
    when next_idx < p.token_count and boot_parser_tok_type_at(p, next_idx) == TokType.Newline loop
        next_idx = next_idx + 1;
    end
    if next_idx < p.token_count do
        t1 = boot_parser_tok_type_at(p, next_idx);
        if t1 == TokType.RBrace do
            out true;
        end
        if next_idx + 1 < p.token_count do
            t2 = boot_parser_tok_type_at(p, next_idx + 1);
            if t1 == TokType.Ident and t2 == TokType.Colon do
                out true;
            end
            if t1 == TokType.Ident and t2 == TokType.Assign do
                out true;
            end
        end
    end
    out false;
end.


func parse_unary:
    in(p: Parser)
    # Unary minus
    if check(p, TokType.Minus) do
        var (p2, t) = advance(p);
        var (p3, operand) = parse_unary(p2);
        zero = ast_new(AstType.LiteralInt);
        zero.int_val = 0;
        zero.line = t.line;
        n = ast_new(AstType.BinOp);
        n.op = OpType::Sub;
        n.line = t.line;
        n = ast_add_child(n, zero);
        n = ast_add_child(n, operand);
        out (p3, n);
    end

    # Unary NOT
    if check(p, TokType.Not) do
        var (p2, t) = advance(p);
        var (p3, operand) = parse_unary(p2);
        zero = ast_new(AstType.LiteralInt);
        zero.int_val = 0;
        zero.line = t.line;
        n = ast_new(AstType.Compare);
        n.op = OpType::Eq;
        n.line = t.line;
        n = ast_add_child(n, operand);
        n = ast_add_child(n, zero);
        out (p3, n);
    end

    # Unary bitwise NOT (~x == x xor -1)
    if check(p, TokType.BitNot) do
        var (p2, t) = advance(p);
        var (p3, operand) = parse_unary(p2);
        neg1 = ast_new(AstType.LiteralInt);
        neg1.int_val = 0 - 1;
        neg1.line = t.line;
        n = ast_new(AstType.BinOp);
        n.op = OpType::XorOp;
        n.line = t.line;
        n = ast_add_child(n, operand);
        n = ast_add_child(n, neg1);
        out (p3, n);
    end

    # Primary with optional postfix '.' field access and 'as' cast
    var (p2, left) = parse_primary(p);
    when check(p2, TokType.Dot) loop
        var (p3, _) = advance(p2);
        # Tuple index: expr.0 / expr.1 → FieldAccess name="0"/"1"
        if check(p3, TokType.Int) do
            var (p4, idx_tok) = advance(p3);
            fa = ast_new(AstType.FieldAccess);
            fa.name = rt_itoa(idx_tok.tok_ival);
            fa.line = idx_tok.line;
            fa = ast_add_child(fa, left);
            left = fa;
            p2 = p4;
        else
            var (p4, field, ok) = expect_name(p3, "expected field name after '.'");
            if not ok do
                out (p4, left);
            end
            fa = ast_new(AstType.FieldAccess);
            fa.name = field.str_val;
            fa.line = field.line;
            fa = ast_add_child(fa, left);
            left = fa;
            p2 = p4;
        end
    end
    if check(p2, TokType.As) do
        var (p3, _) = advance(p2);
        var (p4, type_tok, ok) = expect_name(p3, "expected type after 'as'");
        if ok do
            cast = ast_new(AstType.CastExpr);
            cast.name = type_tok.str_val;
            cast.line = type_tok.line;
            cast = ast_add_child(cast, left);
            left = cast;
            p2 = p4;
        end
    end
    out (p2, left);
end.


func parse_mult:
    in(p: Parser)
    var (p2, left) = parse_unary(p);

    when check(p2, TokType.Star) or check(p2, TokType.Slash) or check(p2, TokType.Percent) loop
        var (p3, op_tok) = advance(p2);
        op = OpType::Mul;
        if op_tok.tok_type == TokType.Slash do
            op = OpType::Div;
        end
        if op_tok.tok_type == TokType.Percent do
            op = OpType::ModOp;
        end
        var (p4, right) = parse_unary(p3);
        bin = ast_new(AstType.BinOp);
        bin.op = op;
        bin.int_val = op as int;
        bin.line = op_tok.line;
        bin = ast_add_child(bin, left);
        bin = ast_add_child(bin, right);
        left = bin;
        p2 = p4;
    end
    out (p2, left);
end.


func parse_addition:
    in(p: Parser)
    var (p2, left) = parse_mult(p);

    when check(p2, TokType.Plus) or check(p2, TokType.Minus) loop
        var (p3, op_tok) = advance(p2);
        op = OpType::Add;
        let op_i = 0;
        if op_tok.tok_type == TokType.Minus do
            op = OpType::Sub;
            op_i = 1;
        end
        var (p4, right) = parse_mult(p3);
        bin = ast_new(AstType.BinOp);
        bin.op = op;
        bin.int_val = op_i;  # literal 0/1 — avoid `op as int` local clobber
        bin.line = op_tok.line;
        bin = ast_add_child(bin, left);
        bin = ast_add_child(bin, right);
        left = bin;
        p2 = p4;
    end
    out (p2, left);
end.


func parse_bitwise:
    in(p: Parser)
    var (p2, left) = parse_addition(p);

    is_bitwise = check(p2, TokType.BitAnd) or check(p2, TokType.BitOr) or check(p2, TokType.BitXor) or check(p2, TokType.BitShl) or check(p2, TokType.BitShr);
    when is_bitwise loop
        var (p3, op_tok) = advance(p2);
        op = OpType::AndOp;
        if op_tok.tok_type == TokType.BitOr do
            op = OpType::OrOp;
        end
        if op_tok.tok_type == TokType.BitXor do
            op = OpType::XorOp;
        end
        if op_tok.tok_type == TokType.BitShl do
            op = OpType::ShlOp;
        end
        if op_tok.tok_type == TokType.BitShr do
            op = OpType::ShrOp;
        end
        var (p4, right) = parse_addition(p3);
        bin = ast_new(AstType.BinOp);
        bin.op = op;
        bin.int_val = op as int;
        bin.line = op_tok.line;
        bin = ast_add_child(bin, left);
        bin = ast_add_child(bin, right);
        left = bin;
        p2 = p4;
        is_bitwise = check(p2, TokType.BitAnd) or check(p2, TokType.BitOr) or check(p2, TokType.BitXor) or check(p2, TokType.BitShl) or check(p2, TokType.BitShr);
    end
    out (p2, left);
end.


func parse_compare:
    in(p: Parser)
    var (p2, left) = parse_bitwise(p);

    has_cmp = check(p2, TokType.Eq) or check(p2, TokType.Ne) or check(p2, TokType.Gt) or check(p2, TokType.Lt) or check(p2, TokType.Ge) or check(p2, TokType.Le);
    if has_cmp do
        var (p3, op_tok) = advance(p2);
        op = OpType::Eq;
        if op_tok.tok_type == TokType.Ne do
            op = OpType::Ne;
        end
        if op_tok.tok_type == TokType.Gt do
            op = OpType::Gt;
        end
        if op_tok.tok_type == TokType.Lt do
            op = OpType::Lt;
        end
        if op_tok.tok_type == TokType.Ge do
            op = OpType::Ge;
        end
        if op_tok.tok_type == TokType.Le do
            op = OpType::Le;
        end
        var (p4, right) = parse_bitwise(p3);
        cmp = ast_new(AstType.Compare);
        cmp.op = op;
        cmp.line = op_tok.line;
        cmp = ast_add_child(cmp, left);
        cmp = ast_add_child(cmp, right);
        out (p4, cmp);
    end
    out (p2, left);
end.


func parse_and_expr:
    in(p: Parser)
    var (p2, left) = parse_compare(p);

    when check(p2, TokType.And) loop
        var (p3, _) = advance(p2);
        var (p4, right) = parse_compare(p3);
        bin = ast_new(AstType.BinOp);
        bin.op = OpType::AndOp;
        bin = ast_add_child(bin, left);
        bin = ast_add_child(bin, right);
        left = bin;
        p2 = p4;
    end
    out (p2, left);
end.


func parse_or_expr:
    in(p: Parser)
    var (p2, left) = parse_and_expr(p);

    when check(p2, TokType.Or) loop
        var (p3, _) = advance(p2);
        var (p4, right) = parse_and_expr(p3);
        bin = ast_new(AstType.BinOp);
        bin.op = OpType::OrOp;
        bin = ast_add_child(bin, left);
        bin = ast_add_child(bin, right);
        left = bin;
        p2 = p4;
    end
    out (p2, left);
end.


func parse_expr:
    in(p: Parser)
    out parse_or_expr(p);
end.


# ═══════════════════════════════════════════════════════
# Statement Parsing
# ═══════════════════════════════════════════════════════

var g_boot_blk_types = 0;
var g_boot_blk_names = 0;
var g_boot_blk_inits = 0;
var g_boot_blk_lhs = 0;    # BinOp lhs Ident name (parse-time, survives C VM)
var g_boot_blk_rhs = 0;    # BinOp rhs Ident name
var g_boot_blk_count = 0;
var g_snap_blk_types = 0;
var g_snap_blk_names = 0;
var g_snap_blk_inits = 0;
var g_snap_blk_inits_copy = 0;
var g_snap_blk_types_copy = 0;
var g_snap_blk_names_copy = 0;
var g_boot_var_vregs = 0;
var g_boot_vconst = 0;
var g_parse_vconst = 0;
var g_pending_var_ic = -1;
var g_parse_var_slot = 0;

func boot_lit_int_val:
    in(parent: AstNode, idx: int)
    out vec_get_rt(parent.children, idx).int_val;
end.

func boot_lit_int_val_from:
    in(n: AstNode)
    if n.node_type == AstType.LiteralInt do
        out n.int_val;
    end
    if n.node_type == AstType.Identifier do
        if g_parse_var_slot > 0 do
            out boot_parse_vconst_get(g_parse_var_slot - 1);
        end
    end
    if n.node_type == AstType.BinOp do
        out boot_parse_fold_init_fast(n, g_parse_var_slot);
    end
    out 0 - 1;
end.

func boot_parse_fold_init_fast:
    in(init: AstNode, var_slot: int)
    if init.node_type == AstType.LiteralInt do
        out init.int_val;
    end
    if vec_len_rt(init.children) < 2 do
        out 0 - 1;
    end
    let av = boot_lit_int_val(init, 0);
    let bv = boot_lit_int_val(init, 1);
    if av > 0 and bv > 0 do
        out boot_apply_binop(init.op, av, bv);
    end
    let lv = av;
    if lv <= 0 and var_slot > 0 do
        lv = boot_parse_vconst_get(var_slot - 1);
    end
    if lv < 0 do
        out 0 - 1;
    end
    if bv <= 0 do
        out 0 - 1;
    end
    out boot_apply_binop(init.op, lv, bv);
end.

func boot_parse_vconst_reset:
    if g_parse_vconst == 0 do
        g_parse_vconst = heap_alloc(256);
    end
    let k = 0;
    when k < 32 loop
        native_write_i64(g_parse_vconst, k * 8, 0);
        k = k + 1;
    end
end.

func boot_parse_vconst_set:
    in(slot: int, val: int)
    extern func native_write_i64(addr: int, offset: int, val: int);
    if g_parse_vconst == 0 do
        g_parse_vconst = heap_alloc(256);
    end
    native_write_i64(g_parse_vconst, slot * 8, val + 1);
end.

func boot_parse_vconst_get:
    in(slot: int)
    if g_parse_vconst == 0 do
        out 0 - 1;
    end
    let raw = native_read_i64(g_parse_vconst, slot * 8);
    if raw == 0 do
        out 0 - 1;
    end
    out raw - 1;
end.

func boot_parse_operand_val:
    in(opnd: AstNode, var_slot: int)
    if opnd.node_type == AstType.LiteralInt do
        out opnd.int_val;
    end
    if opnd.node_type == AstType.Identifier do
        if var_slot > 0 do
            out boot_parse_vconst_get(var_slot - 1);
        end
    end
    out 0 - 1;
end.

func boot_parse_fold_init:
    in(init: AstNode, var_slot: int)
    let lit = boot_parse_fold_binop(init);
    if lit >= 0 do
        out lit;
    end
    if vec_len_rt(init.children) < 2 do
        out 0 - 1;
    end
    let lch = vec_get_rt(init.children, 0);
    let rch = vec_get_rt(init.children, 1);
    let lv = lch.int_val;
    let rv = rch.int_val;
    if lv <= 0 and var_slot > 0 do
        lv = boot_parse_vconst_get(var_slot - 1);
    end
    if lv < 0 do
        out 0 - 1;
    end
    if rv <= 0 do
        out 0 - 1;
    end
    out boot_apply_binop(init.op, lv, rv);
end.

func boot_vconst_reset:
    if g_boot_vconst == 0 do
        g_boot_vconst = heap_alloc(256);
    end
    let k = 0;
    when k < 32 loop
        native_write_i64(g_boot_vconst, k * 8, 0);
        k = k + 1;
    end
end.

func boot_vconst_set:
    in(slot: int, val: int)
    extern func native_write_i64(addr: int, offset: int, val: int);
    if g_boot_vconst == 0 do
        g_boot_vconst = heap_alloc(256);
    end
    native_write_i64(g_boot_vconst, slot * 8, val + 1);
end.

func boot_vconst_get:
    in(slot: int)
    if g_boot_vconst == 0 do
        out 0 - 1;
    end
    let raw = native_read_i64(g_boot_vconst, slot * 8);
    if raw == 0 do
        out 0 - 1;
    end
    out raw - 1;
end.

func boot_vslot_of_name:
    in(name: int, before_i: int)
    let j = 0;
    when j < before_i loop
        if (j bit_and 1) == 0 do
            let btp = boot_blk_types_base();
            let bnp = boot_blk_names_base();
            let bt = native_read_i64(btp, j * 8);
            if bt == AstType.VarDecl or bt == AstType.ConstDecl or bt == 0 do
                if rt_streq(native_read_i64(bnp, j * 8), name) do
                    out j shr 1;
                end
            end
        end
        j = j + 1;
    end
    out 0 - 1;
end.

func boot_snap_vslot_ic:
    in(vs: int)
    if g_snap_blk_inits_copy == 0 do
        out 0 - 1;
    end
    let slot = 0;
    let j = 0;
    when j < g_boot_blk_count loop
        let bt = native_read_i64(g_snap_blk_types_copy, j * 8);
        if bt == AstType.VarDecl or bt == AstType.ConstDecl do
            if slot == vs do
                out native_read_i64(g_snap_blk_inits_copy, j * 8);
            end
            slot = slot + 1;
        end
        j = j + 1;
    end
    out 0 - 1;
end.

func boot_operand_const_val:
    in(opnd: AstNode, before_i: int)
    if opnd.node_type == AstType.LiteralInt do
        out opnd.int_val;
    end
    if opnd.node_type == AstType.Identifier do
        let vs = boot_vslot_of_name(opnd.name, before_i);
        if vs >= 0 do
            let cv = boot_vconst_get(vs);
            if cv >= 0 do
                out cv;
            end
            let snap = boot_snap_vslot_ic(vs);
            if snap >= 0 do
                out snap;
            end
        end
    end
    out 0 - 1;
end.

func boot_apply_binop:
    in(op: int, av: int, bv: int)
    if op == OpType::Add do
        out av + bv;
    end
    if op == OpType::Sub do
        out av - bv;
    end
    if op == OpType::Mul do
        out av * bv;
    end
    if op == OpType::Div do
        if bv == 0 do
            out 0 - 1;
        end
        out av / bv;
    end
    if op == OpType::ModOp do
        if bv == 0 do
            out 0 - 1;
        end
        out av - (av / bv) * bv;
    end
    out 0 - 1;
end.

func boot_fold_init_at:
    in(init: AstNode, before_i: int)
    if init.node_type != AstType.BinOp do
        out 0 - 1;
    end
    if vec_len_rt(init.children) < 2 do
        out 0 - 1;
    end
    let lch = vec_get_rt(init.children, 0);
    let rch = vec_get_rt(init.children, 1);
    let lv = boot_operand_const_val(lch, before_i);
    if lv < 0 do
        out 0 - 1;
    end
    let rv = boot_operand_const_val(rch, before_i);
    if rv < 0 do
        out 0 - 1;
    end
    out boot_apply_binop(init.op, lv, rv);
end.

func boot_blk_reset:
    if g_boot_blk_types == 0 do
        g_boot_blk_types = heap_alloc(4096);
        g_boot_blk_names = heap_alloc(4096);
        g_boot_blk_inits = heap_alloc(4096);
        g_boot_blk_lhs = heap_alloc(4096);
        g_boot_blk_rhs = heap_alloc(4096);
    end
    g_boot_blk_count = 0;
end.

func boot_blk_push:
    in(stype: int, sname: int, iconst: int)
    extern func native_write_i64(addr: int, offset: int, val: int);
    let idx = g_boot_blk_count;
    native_write_i64(g_boot_blk_types, idx * 8, stype);
    native_write_i64(g_boot_blk_names, idx * 8, sname);
    native_write_i64(g_boot_blk_inits, idx * 8, iconst);
    native_write_i64(g_boot_blk_lhs, idx * 8, 0);
    native_write_i64(g_boot_blk_rhs, idx * 8, 0);
    g_boot_blk_count = idx + 1;
end.

func boot_blk_set_binop_ops:
    in(idx: int, lhs: int, rhs: int)
    extern func native_write_i64(addr: int, offset: int, val: int);
    if g_boot_blk_lhs == 0 do
        out;
    end
    native_write_i64(g_boot_blk_lhs, idx * 8, lhs);
    native_write_i64(g_boot_blk_rhs, idx * 8, rhs);
end.

func boot_blk_types_base:
    if g_boot_blk_types != 0 do
        out g_boot_blk_types;
    end
    out g_snap_blk_types;
end.

func boot_blk_names_base:
    if g_boot_blk_names != 0 do
        out g_boot_blk_names;
    end
    out g_snap_blk_names;
end.

func boot_blk_inits_base:
    if g_boot_blk_inits != 0 do
        out g_boot_blk_inits;
    end
    out g_snap_blk_inits;
end.

func boot_vreg_for_name:
    in(vname: int)
    let vr = 0;
    let i = 0;
    when i < g_boot_blk_count loop
        let bt = native_read_i64(g_boot_blk_types, i * 8);
        if bt == AstType.VarDecl or bt == AstType.ConstDecl do
            if rt_streq(native_read_i64(g_boot_blk_names, i * 8), vname) do
                out vr;
            end
            vr = vr + 1;
        end
        i = i + 1;
    end
    out -1;
end.

func boot_vreg_before_idx:
    in(pidx: int)
    let vr = 0;
    let j = 0;
    let btp = boot_blk_types_base();
    when j < pidx loop
        let bt = native_read_i64(btp, j * 8);
        if bt == AstType.VarDecl or bt == AstType.ConstDecl do
            vr = vr + 1;
        end
        j = j + 1;
    end
    if vr > 0 do
        let rv = vr - 1;
        out rv;
    end
    out 0 - 1;
end.

func boot_var_slot:
    in(pidx: int)
    out pidx shr 1;
end.

func boot_var_vreg_get:
    in(slot: int)
    if g_boot_var_vregs == 0 do
        out 0 - 1;
    end
    out native_read_i64(g_boot_var_vregs, slot * 8);
end.

func boot_var_vreg_set:
    in(slot: int, vr: int)
    extern func native_write_i64(addr: int, offset: int, val: int);
    if g_boot_var_vregs == 0 do
        g_boot_var_vregs = heap_alloc(256);
    end
    native_write_i64(g_boot_var_vregs, slot * 8, vr);
end.

func boot_parse_fold_binop:
    in(init: AstNode)
    if vec_len_rt(init.children) < 2 do
        out -1;
    end
    let lch = vec_get_rt(init.children, 0);
    let rch = vec_get_rt(init.children, 1);
    let av = lch.int_val;
    let bv = rch.int_val;
    if av == 0 and bv == 0 do
        out -1;
    end
    if init.op == OpType::Add do
        out av + bv;
    end
    if init.op == OpType::Sub do
        out av - bv;
    end
    if init.op == OpType::Mul do
        out av * bv;
    end
    if init.op == OpType::Div do
        if bv == 0 do
            out -1;
        end
        out av / bv;
    end
    if init.op == OpType::ModOp do
        if bv == 0 do
            out -1;
        end
        out av - (av / bv) * bv;
    end
    out -1;
end.

func parse_block:
    in(p: Parser)
    block = ast_new(AstType.Block);
    boot_blk_reset();
    boot_parse_vconst_reset();
    p = skip_newlines(p);
    let var_slot = 0;

    should_continue = true;
    when should_continue loop
        if check(p, TokType.End) or check(p, TokType.Else) or check(p, TokType.Eif) or check(p, TokType.Eof) do
            should_continue = false;
        else
            g_parse_var_slot = var_slot;
            g_pending_var_ic = -1;
            var (p2, stmt) = parse_statement(p);
            p = p2;
            let aux_name = g_pending_stmt_name;
            if aux_name == 0 do
                aux_name = stmt.name;
            end
            g_pending_stmt_name = 0;
            if stmt.node_type == AstType.PrintStmt do
                if aux_name == 0 do
                    if vec_len_rt(stmt.children) > 0 do
                        let pch = vec_get_rt(stmt.children, 0);
                        if pch.node_type == AstType.Identifier do
                            aux_name = pch.name;
                        end
                    end
                end
            end
            let ic = g_pending_var_ic;
            g_pending_var_ic = -1;
            if stmt.node_type == AstType.VarDecl or stmt.node_type == AstType.ConstDecl do
                if ic >= 0 do
                    boot_parse_vconst_set(var_slot, ic);
                    var_slot = var_slot + 1;
                end
            end
            boot_blk_push(stmt.node_type, aux_name, ic);
            # Capture BinOp Ident operands while names are still valid (parse-time).
            if stmt.node_type == AstType.VarDecl or stmt.node_type == AstType.ConstDecl do
                if vec_len_rt(stmt.children) > 0 do
                    let init_n = vec_get_rt(stmt.children, 0);
                    if init_n.node_type == AstType.BinOp do
                        if vec_len_rt(init_n.children) >= 2 do
                            let lc = vec_get_rt(init_n.children, 0);
                            let rc = vec_get_rt(init_n.children, 1);
                            let ln = 0;
                            let rn = 0;
                            if lc.node_type == AstType.Identifier do
                                ln = lc.name;
                            end
                            if rc.node_type == AstType.Identifier do
                                rn = rc.name;
                            end
                            if ln != 0 or rn != 0 do
                                boot_blk_set_binop_ops(g_boot_blk_count - 1, ln, rn);
                            end
                        end
                    end
                end
            end
            block = ast_add_child(block, stmt);
            if rt_strlen(p.error_msg) > 0 do
                out (p, block);
            end
            var (p_semi, _) = match_tok(p, TokType.Semicolon);
            p = p_semi;
            p = skip_newlines(p);
        end
    end
    g_snap_blk_types = g_boot_blk_types;
    g_snap_blk_names = g_boot_blk_names;
    g_snap_blk_inits = g_boot_blk_inits;
    boot_blk_snap_copy();
    out (p, block);
end.


func boot_var_slot_at_idx:
    in(pidx: int)
    let slot = 0;
    let j = 0;
    let btp = boot_blk_types_base();
    when j < pidx loop
        let bt = native_read_i64(btp, j * 8);
        if bt == AstType.VarDecl or bt == AstType.ConstDecl do
            slot = slot + 1;
        end
        j = j + 1;
    end
    out slot;
end.

func boot_parse_vslot_ic:
    in(vs: int)
    let slot = 0;
    let j = 0;
    when j < g_boot_blk_count loop
        let bt = native_read_i64(g_boot_blk_types, j * 8);
        if bt == AstType.VarDecl or bt == AstType.ConstDecl do
            if slot == vs do
                out native_read_i64(g_boot_blk_inits, j * 8);
            end
            slot = slot + 1;
        end
        j = j + 1;
    end
    out 0 - 1;
end.

func boot_blk_snap_copy:
    extern func native_write_i64(addr: int, offset: int, val: int);
    let n = g_boot_blk_count;
    if g_snap_blk_inits_copy == 0 do
        g_snap_blk_inits_copy = heap_alloc(4096);
        g_snap_blk_types_copy = heap_alloc(4096);
        g_snap_blk_names_copy = heap_alloc(4096);
    end
    let i = 0;
    when i < n loop
        native_write_i64(g_snap_blk_inits_copy, i * 8, native_read_i64(g_boot_blk_inits, i * 8));
        native_write_i64(g_snap_blk_types_copy, i * 8, native_read_i64(g_boot_blk_types, i * 8));
        native_write_i64(g_snap_blk_names_copy, i * 8, native_read_i64(g_boot_blk_names, i * 8));
        i = i + 1;
    end
    g_snap_blk_types = g_snap_blk_types_copy;
    g_snap_blk_names = g_snap_blk_names_copy;
    g_snap_blk_inits = g_snap_blk_inits_copy;
end.

func boot_parser_tok_str:
    in(p: Parser)
    if g_boot_tok_strs != 0 and p.pos < g_boot_tok_count do
        out vec_get_rt(g_boot_tok_strs, p.pos);
    end
    out peek(p).str_val;
end.

func boot_parser_tok_type:
    in(p: Parser)
    if g_boot_tok_types != 0 and p.pos < g_boot_tok_count do
        out vec_get_rt(g_boot_tok_types, p.pos);
    end
    out peek(p).tok_type;
end.

func boot_parser_tok_type_at:
    in(p: Parser, idx: int)
    if g_boot_tok_types != 0 and idx < g_boot_tok_count do
        out vec_get_rt(g_boot_tok_types, idx);
    end
    if idx < p.token_count do
        out vec_get_rt(p.tokens, idx as int).tok_type;
    end
    out TokType.Eof;
end.

func boot_parser_tok_ival:
    in(p: Parser)
    if g_boot_tok_ivals != 0 and p.pos < g_boot_tok_count do
        out vec_get_rt(g_boot_tok_ivals, p.pos);
    end
    out peek(p).tok_ival;
end.

func boot_pvi_read_int:
    in(p: Parser)
    let tp = boot_parser_tok_type(p);
    if tp == TokType.Int do
        let iv = boot_parser_tok_ival(p);
        var (p2, _) = advance(p);
        out (p2, iv, true);
    end
    out (p, 0 - 1, false);
end.

func boot_pvi_primary:
    in(p: Parser)
    let tp = boot_parser_tok_type(p);
    if tp == TokType.Int do
        let iv = boot_parser_tok_ival(p);
        var (p2, _) = advance(p);
        out (p2, iv, true);
    end
    if tp == TokType.Ident do
        let id_name = boot_parser_tok_str(p);
        let vs = boot_vslot_of_name(id_name, g_boot_blk_count);
        if vs >= 0 do
            let cv = boot_parse_vslot_ic(vs);
            if cv >= 0 do
                var (p2, _) = advance(p);
                out (p2, cv, true);
            end
            let cv2 = boot_parse_vconst_get(vs);
            if cv2 >= 0 do
                var (p3, _) = advance(p);
                out (p3, cv2, true);
            end
        end
        out (p, 0 - 1, false);
    end
    out (p, 0 - 1, false);
end.

func boot_pvi_try_binop:
    in(p: Parser, acc: int, tok: int, op: int)
    if acc < 0 do
        out (p, acc, false);
    end
    let tp = boot_parser_tok_type(p);
    if tp != tok do
        out (p, acc, false);
    end
    var (p2, _) = advance(p);
    var (p3, rv, rok) = boot_pvi_read_int(p2);
    if not rok or rv < 0 do
        out (p, acc, false);
    end
    let rv2 = boot_apply_binop(op, acc, rv);
    if rv2 < 0 do
        out (p, acc, false);
    end
    out (p3, rv2, true);
end.

func boot_pvi_binops:
    in(p: Parser, acc: int)
    var (p2, acc2, ok) = boot_pvi_try_binop(p, acc, TokType.Plus, OpType::Add);
    if ok do
        out (p2, acc2);
    end
    var (p3, acc3, ok2) = boot_pvi_try_binop(p, acc, TokType.Minus, OpType::Sub);
    if ok2 do
        out (p3, acc3);
    end
    var (p4, acc4, ok3) = boot_pvi_try_binop(p, acc, TokType.Star, OpType::Mul);
    if ok3 do
        out (p4, acc4);
    end
    var (p5, acc5, ok4) = boot_pvi_try_binop(p, acc, TokType.Slash, OpType::Div);
    if ok4 do
        out (p5, acc5);
    end
    var (p6, acc6, ok5) = boot_pvi_try_binop(p, acc, TokType.Percent, OpType::ModOp);
    if ok5 do
        out (p6, acc6);
    end
    out (p, acc);
end.

# True if the next token cannot continue an expression (fold fully consumed).
func boot_pvi_expr_done:
    in(p: Parser)
    let tp = boot_parser_tok_type(p);
    if tp == TokType.Semicolon or tp == TokType.Newline or tp == TokType.End or tp == TokType.Eof do
        out true;
    end
    if tp == TokType.Else or tp == TokType.Eif or tp == TokType.Comma do
        out true;
    end
    if tp == TokType.RParen or tp == TokType.RBracket or tp == TokType.RBrace do
        out true;
    end
    out false;
end.

func boot_parse_var_init_const:
    in(p: Parser)
    let saved = p.pos;
    var (p2, acc, ok) = boot_pvi_primary(p);
    if not ok do
        p.pos = saved;
        out (p, 0 - 1, ast_new(AstType.LiteralInt));
    end
    var (p3, acc2) = boot_pvi_binops(p2, acc);
    # Reject partial fold like `72 + 80 * n` (stopped after 80, leftover *).
    if not boot_pvi_expr_done(p3) do
        p.pos = saved;
        out (p, 0 - 1, ast_new(AstType.LiteralInt));
    end
    let init = ast_new(AstType.LiteralInt);
    init.int_val = acc2;
    out (p3, acc2, init);
end.


func parse_var_decl:
    in(p: Parser, is_const: bool)
    decl_type = AstType.VarDecl;
    if is_const do
        decl_type = AstType.ConstDecl;
    end

    # Tuple destructuring: var (a, b) = expr  /  var (a, _) = expr
    if check(p, TokType.LParen) do
        var (p2, _) = advance(p);
        decl = ast_new(decl_type);
        decl.int_val = 16384;   # 0x4000 = is_tuple_destruct
        decl.line = peek(p2).line;
        when not check(p2, TokType.RParen) and not check(p2, TokType.Eof) loop
            var (p3, name_tok, ok) = expect_name(p2, "expected tuple variable name");
            if not ok do
                out (p3, decl);
            end
            idn = ast_new(AstType.Identifier);
            idn.name = name_tok.str_val;
            idn.line = name_tok.line;
            decl = ast_add_child(decl, idn);
            var (p4, has_comma) = match_tok(p3, TokType.Comma);
            if has_comma do
                p2 = p4;
            else
                p2 = p3;
                break;
            end
        end
        var (p5, _, _) = expect_tok(p2, TokType.RParen, "expected ')' to close tuple assignment");
        var (p6, matched) = match_tok(p5, TokType.Assign);
        if matched do
            var (p7, init) = parse_expr(p6);
            decl = ast_add_child(decl, init);
            var (p8, _) = match_tok(p7, TokType.Semicolon);
            out (p8, decl);
        end
        var (p6b, _) = match_tok(p5, TokType.Semicolon);
        out (p6b, decl);
    end

    var (p2, name_tok, ok) = expect_name(p, "expected variable name");
    if not ok do
        out (p2, ast_new(AstType.VarDecl));
    end

    decl = ast_new(decl_type);
    decl.name = name_tok.str_val;
    decl.line = name_tok.line;
    g_pending_stmt_name = name_tok.str_val;

    var (p3, matched) = match_tok(p2, TokType.Assign);
    if matched do
        var (p4, ic_acc, init) = boot_parse_var_init_const(p3);
        if ic_acc < 0 do
            var (p4b, init2) = parse_expr(p3);
            init = init2;
            p4 = p4b;
            ic_acc = 0 - 1;
            if init.node_type == AstType.LiteralInt do
                ic_acc = init.int_val;
            end
            if init.node_type == AstType.BinOp do
                ic_acc = boot_parse_fold_init_fast(init, g_parse_var_slot);
            end
        end
        g_pending_var_ic = ic_acc;
        decl = ast_add_child(decl, init);
        var (p4c, _) = match_tok(p4, TokType.Semicolon);
        out (p4c, decl);
    end
    var (p3b, has_colon) = match_tok(p2, TokType.Colon);
    if has_colon and is_const do
        var (p4, ic_acc, init) = boot_parse_var_init_const(p3b);
        if ic_acc < 0 do
            var (p4b, init2) = parse_expr(p3b);
            init = init2;
            p4 = p4b;
            ic_acc = 0 - 1;
            if init.node_type == AstType.LiteralInt do
                ic_acc = init.int_val;
            end
        end
        g_pending_var_ic = ic_acc;
        decl = ast_add_child(decl, init);
        var (p5, _) = match_tok(p4, TokType.Semicolon);
        out (p5, decl);
    end
    out (p3, decl);
end.


func parse_if_stmt:
    in(p: Parser)
    line = peek(p).line;
    var (p2, cond) = parse_expr(p);

    # Optional block opener: ':' | 'then' | 'do'
    p2 = match_block_open(p2);
    p2 = skip_newlines(p2);

    var (p3, then_block) = parse_block(p2);

    if_node = ast_new(AstType.IfStmt);
    if_node.line = line;
    if_node = ast_add_child(if_node, cond);
    if_node = ast_add_child(if_node, then_block);

    # Handle eif (elif)
    if check(p3, TokType.Eif) do
        var (p4, _) = advance(p3);
        var (p5, elif_as_if) = parse_if_stmt(p4);
        else_block = ast_new(AstType.Block);
        else_block = ast_add_child(else_block, elif_as_if);
        if_node = ast_add_child(if_node, else_block);
        out (p5, if_node);
    end

    # Handle else
    var (p4, has_else) = match_tok(p3, TokType.Else);
    if has_else do
        p4 = match_block_open(p4);
        p4 = skip_newlines(p4);
        var (p5, else_block) = parse_block(p4);
        if_node = ast_add_child(if_node, else_block);
        p4 = p5;
    end

    var (p5, _, _) = expect_tok(p4, TokType.End, "expected 'end' after if block");
    out (p5, if_node);
end.


func parse_loop_stmt:
    in(p: Parser)
    line = peek(p).line;
    var (p2, count) = parse_expr(p);
    p2 = match_block_open(p2);
    p2 = skip_newlines(p2);
    var (p3, body) = parse_block(p2);
    var (p4, _, _) = expect_tok(p3, TokType.End, "expected 'end' after loop block");
    n = ast_new(AstType.LoopStmt);
    n.line = line;
    n = ast_add_child(n, count);
    n = ast_add_child(n, body);
    out (p4, n);
end.


func parse_while_stmt:
    in(p: Parser)
    line = peek(p).line;
    var (_, cond) = parse_expr(p);
    # C VM note: p is modified in-place by parse_expr; p2 from tuple is corrupted
    # Consume optional 'loop' keyword (when...loop syntax)
    var (_, _) = match_tok(p, TokType.Loop);
    p = match_block_open(p);
    p = skip_newlines(p);
    var (_, body) = parse_block(p);
    var (_, _, _) = expect_tok(p, TokType.End, "expected 'end' after while block");
    n = ast_new(AstType.WhileStmt);
    n.line = line;
    n = ast_add_child(n, cond);
    n = ast_add_child(n, body);
    out (p, n);
end.


func parse_return_stmt:
    in(p: Parser)
    line = peek(p).line;
    # Idiom: `out skip;` / `out break;` desugars to break/continue.
    if check(p, TokType.Skip) do
        var (p2, _) = advance(p);
        cf = ast_new(AstType.ContinueStmt);
        cf.line = line;
        var (p3, _) = match_tok(p2, TokType.Semicolon);
        out (p3, cf);
    end
    if check(p, TokType.Break) do
        var (p2, _) = advance(p);
        cf = ast_new(AstType.BreakStmt);
        cf.line = line;
        var (p3, _) = match_tok(p2, TokType.Semicolon);
        out (p3, cf);
    end
    n = ast_new(AstType.ReturnStmt);
    n.line = line;
    has_val = not check(p, TokType.Newline) and not check(p, TokType.End) and not check(p, TokType.Eof) and not check(p, TokType.Else) and not check(p, TokType.Semicolon);
    if has_val do
        var (p2, val) = parse_expr(p);
        n = ast_add_child(n, val);
        var (p4, _) = match_tok(p2, TokType.Semicolon);
        out (p4, n);
    end
    out (p, n);
end.


func parse_print_stmt:
    in(p: Parser)
    line = peek(p).line;
    n = ast_new(AstType.PrintStmt);
    n.line = line;
    # Capture bare-ident name from the token BEFORE parse_expr/entity returns
    # can clobber AstNode.name (needed for `print x`).
    g_pending_stmt_name = 0;
    if check(p, TokType.Ident) do
        g_pending_stmt_name = peek(p).str_val;
    end
    var (p2, val) = parse_expr(p);
    n = ast_add_child(n, val);
    out (p2, n);
end.


# Does the token stream at p look like the start of a new case arm?
func boot_case_arm_starts:
    in(p: Parser)
    let t0 = boot_parser_tok_type_at(p, p.pos);
    if t0 == TokType.Case or t0 == TokType.Else do
        out true;
    end
    let t1 = boot_parser_tok_type_at(p, p.pos + 1);
    if (t0 == TokType.Int or t0 == TokType.Str) and t1 == TokType.Colon do
        out true;
    end
    if t0 == TokType.Ident do
        if t1 == TokType.Colon do
            out true;
        end
        if t1 == TokType.LParen do
            let j = p.pos + 2;
            let d = 1;
            when d > 0 and j < g_boot_tok_count loop
                let tj = boot_parser_tok_type_at(p, j);
                if tj == TokType.LParen do
                    d = d + 1;
                end
                if tj == TokType.RParen do
                    d = d - 1;
                end
                j = j + 1;
            end
            if boot_parser_tok_type_at(p, j) == TokType.Colon do
                out true;
            end
        end
    end
    out false;
end.


func parse_case_stmt:
    in(p: Parser)
    line = peek(p).line;
    var (p2, subject) = parse_expr(p);

    # Optional ':~' pattern token / ':' block opener.
    var (p2p, _) = match_tok(p2, TokType.Pattern);
    p2 = p2p;
    var (p2b, _) = match_tok(p2, TokType.Colon);
    p2 = p2b;
    p2 = skip_newlines(p2);

    cnode = ast_new(AstType.CaseStmt);
    cnode.line = line;
    cnode = ast_add_child(cnode, subject);

    when not check(p2, TokType.End) and not check(p2, TokType.Eof) loop
        # Optional leading 'case' keyword before an arm.
        var (pa, _) = match_tok(p2, TokType.Case);
        p2 = pa;

        arm = ast_new(AstType.PatternMatch);
        arm.line = peek(p2).line;

        if check(p2, TokType.Else) do
            var (pb, _) = advance(p2);
            p2 = pb;
            arm.name = "_";
            arm.int_val = 0 - 1;
        eif check(p2, TokType.Int) do
            var (pc, it) = advance(p2);
            p2 = pc;
            arm.int_val = it.tok_ival;
        eif check(p2, TokType.Str) do
            var (pd, st) = advance(p2);
            p2 = pd;
            arm.name = st.str_val;
            arm.int_val = 0 - 2;
        eif check(p2, TokType.Ident) do
            var (pe, nt) = advance(p2);
            p2 = pe;
            arm.name = nt.str_val;
            arm.int_val = 0 - 3;
            var (pf, hp) = match_tok(p2, TokType.LParen);
            if hp do
                p2 = pf;
                if check(p2, TokType.Ident) do
                    var (pg, bt) = advance(p2);
                    p2 = pg;
                    arm.name2 = bt.str_val;
                end
                when not check(p2, TokType.RParen) and not check(p2, TokType.Eof) loop
                    var (ph, _) = advance(p2);
                    p2 = ph;
                end
                var (pi, _) = match_tok(p2, TokType.RParen);
                p2 = pi;
            end
        else
            out (p2, cnode);
        end

        var (pj, _, _) = expect_tok(p2, TokType.Colon, "expected ':' after pattern");
        p2 = pj;
        p2 = skip_newlines(p2);

        armloop = true;
        when armloop loop
            if check(p2, TokType.End) or check(p2, TokType.Eof) do
                armloop = false;
            eif boot_case_arm_starts(p2) do
                armloop = false;
            else
                var (pk, bstmt) = parse_statement(p2);
                p2 = pk;
                arm = ast_add_child(arm, bstmt);
                if rt_strlen(p2.error_msg) > 0 do
                    out (p2, cnode);
                end
                var (pl, _) = match_tok(p2, TokType.Semicolon);
                p2 = pl;
                p2 = skip_newlines(p2);
            end
        end

        cnode = ast_add_child(cnode, arm);
    end

    var (pm, _, _) = expect_tok(p2, TokType.End, "expected 'end' after case");
    var (pn, _) = match_tok(pm, TokType.Dot);
    out (pn, cnode);
end.


func parse_func_def:
    in(p: Parser)
    var (p2, name_tok, ok) = expect_name(p, "expected function name");
    if not ok do
        out (p2, ast_new(AstType.FuncDef));
    end

    fn_node = ast_new(AstType.FuncDef);
    fn_node.name = name_tok.str_val;
    fn_node.line = name_tok.line;

    # Parse parameters (optional parens — `func name` and `func name(...)` both valid)
    if check(p2, TokType.LParen) do
        var (p3, _) = advance(p2);

        # Parse parameters
        if not check(p3, TokType.RParen) do
            var (p4, param_tok, ok2) = expect_tok(p3, TokType.Ident, "expected parameter name");
            p3 = p4;
            if ok2 do
                param = ast_new(AstType.Identifier);
                param.name = param_tok.str_val;
                fn_node = ast_add_child(fn_node, param);
            end
            # Skip optional type annotation `: type` (incl. Vec<T>)
            if check(p3, TokType.Colon) do
                var (p_skip, _) = advance(p3);
                p3 = skip_type_annot(p_skip);
            end
            # Handle semicolon-separated params (VIR style: `a:int; b:int`)
            should_loop = true;
            when should_loop loop
                has_sep = false;
                var (p5, matched_comma) = match_tok(p3, TokType.Comma);
                p3 = p5;
                if matched_comma do
                    has_sep = true;
                end
                if not has_sep do
                    var (p5b, matched_semi) = match_tok(p3, TokType.Semicolon);
                    p3 = p5b;
                    if matched_semi do
                        has_sep = true;
                    end
                end
                if not has_sep do
                    should_loop = false;
                else
                    var (p6, pt, ok3) = expect_tok(p3, TokType.Ident, "expected parameter name");
                    p3 = p6;
                    if ok3 do
                        param2 = ast_new(AstType.Identifier);
                        param2.name = pt.str_val;
                        fn_node = ast_add_child(fn_node, param2);
                    end
                    # Skip optional type annotation `: type` (incl. Vec<T>)
                    if check(p3, TokType.Colon) do
                        var (p_skip3, _) = advance(p3);
                        p3 = skip_type_annot(p_skip3);
                    end
                end
            end
        end

        var (p4, _, _) = expect_tok(p3, TokType.RParen, "expected ')' after parameters");
        p2 = p4;
    end

    # Skip optional return type `-> type`
    if check(p2, TokType.Arrow) do
        var (p_arr, _) = advance(p2);
        p2 = skip_type_annot(p_arr);
    end

    # Skip optional trailing colon `:`
    var (p_colon, _) = match_tok(p2, TokType.Colon);
    p2 = p_colon;

    p2 = skip_newlines(p2);

    if check(p2, TokType.In) do
        var (p_in, _) = advance(p2);
        p2 = p_in;
        if check(p2, TokType.LParen) do
            var (p_lp, _) = advance(p2);
            p2 = p_lp;
            if not check(p2, TokType.RParen) do
                var (p_p1, param_tok, okp) = expect_tok(p2, TokType.Ident, "expected parameter name");
                p2 = p_p1;
                if okp do
                    param = ast_new(AstType.Identifier);
                    param.name = param_tok.str_val;
                    fn_node = ast_add_child(fn_node, param);
                end
                if check(p2, TokType.Colon) do
                    var (p_sk, _) = advance(p2);
                    p2 = skip_type_annot(p_sk);
                end
                when check(p2, TokType.Comma) or check(p2, TokType.Semicolon) loop
                    var (p_sep, _) = advance(p2);
                    p2 = p_sep;
                    p2 = skip_newlines(p2);
                    var (p_p2, pt2, okp2) = expect_tok(p2, TokType.Ident, "expected parameter name");
                    p2 = p_p2;
                    if okp2 do
                        param2 = ast_new(AstType.Identifier);
                        param2.name = pt2.str_val;
                        fn_node = ast_add_child(fn_node, param2);
                    end
                    if check(p2, TokType.Colon) do
                        var (p_sk3, _) = advance(p2);
                        p2 = skip_type_annot(p_sk3);
                    end
                end
            end
            var (p_rp, _, _) = expect_tok(p2, TokType.RParen, "expected ')' after parameters");
            p2 = p_rp;
            p2 = skip_newlines(p2);
        end
    end

    var (p5, body) = parse_block(p2);
    fn_node = ast_add_child(fn_node, body);

    var (p6, _, _) = expect_tok(p5, TokType.End, "expected 'end' to close function");
    var (p7, _) = match_tok(p6, TokType.Dot);
    g_pending_stmt_type = AstType.FuncDef;
    g_pending_stmt_name = name_tok.str_val;
    out (p7, fn_node);
end.


func parse_for_range_stmt:
    in(p: Parser)
    line = peek(p).line;
    var (p2, var_tok, ok) = expect_tok(p, TokType.Ident, "expected loop variable");
    if not ok do
        out (p2, ast_new(AstType.ForRange));
    end

    var (p3, _, ok2) = expect_tok(p2, TokType.In, "expected 'in' after for variable");
    if not ok2 do
        out (p3, ast_new(AstType.ForRange));
    end

    var (p4, start_expr) = parse_expr(p3);
    var (p5, _, ok3) = expect_tok(p4, TokType.DotDot, "expected '..' in range");
    if not ok3 do
        out (p5, ast_new(AstType.ForRange));
    end

    var (p6, end_expr) = parse_expr(p5);
    # Opener: ':' | 'then' | 'do' (do lexes as TokType.Then)
    p6 = match_block_open(p6);
    p6 = skip_newlines(p6);

    var (p7, body) = parse_block(p6);
    var (p8, _, _) = expect_tok(p7, TokType.End, "expected 'end' after for block");

    n = ast_new(AstType.ForRange);
    n.name = var_tok.str_val;
    n.line = line;
    n = ast_add_child(n, start_expr);
    n = ast_add_child(n, end_expr);
    n = ast_add_child(n, body);
    out (p8, n);
end.


func parse_enum_def:
    in(p: Parser)
    line = peek(p).line;
    var (p2, name_tok, ok) = expect_tok(p, TokType.Ident, "expected enum name");
    if not ok do
        out (p2, ast_new(AstType.EnumDef));
    end

    p2 = skip_newlines(p2);

    en = ast_new(AstType.EnumDef);
    en.name = name_tok.str_val;
    en.line = line;

    # Consume optional ':' after enum name
    var (p2b, _) = match_tok(p2, TokType.Colon);
    p2 = p2b;
    p2 = skip_newlines(p2);

    next_val = 0;
    when not check(p2, TokType.End) and not check(p2, TokType.Eof) loop
        var (p3, vname, ok2) = expect_tok(p2, TokType.Ident, "expected enum variant");
        p2 = p3;
        if not ok2 do
            out (p2, en);
        end

        # Tagged variant payload: `Ok(value)` — consume and discard parens.
        var (p3p, has_paren) = match_tok(p2, TokType.LParen);
        if has_paren do
            p2 = p3p;
            edepth = 1;
            when edepth > 0 and not check(p2, TokType.Eof) loop
                if check(p2, TokType.LParen) do
                    edepth = edepth + 1;
                end
                if check(p2, TokType.RParen) do
                    edepth = edepth - 1;
                end
                var (p3q, _) = advance(p2);
                p2 = p3q;
            end
        end

        val = next_val;
        var (p4, has_val) = match_tok(p2, TokType.Assign);
        if has_val do
            var (p5, vt, _) = expect_tok(p4, TokType.Int, "expected integer value");
            p2 = p5;
            val = vt.tok_ival;
            var (p5b, _) = match_tok(p2, TokType.Semicolon);
            p2 = p5b;
        else
            p2 = p4;
            var (p4b, _) = match_tok(p2, TokType.Semicolon);
            p2 = p4b;
        end
        next_val = val + 1;

        variant = ast_new(AstType.LiteralInt);
        variant.name = vname.str_val;
        variant.int_val = val;
        variant.line = vname.line;
        en = ast_add_child(en, variant);
        p2 = skip_newlines(p2);
    end

    var (p3, _, _) = expect_tok(p2, TokType.End, "expected 'end' after enum");
    var (p4, _) = match_tok(p3, TokType.Dot);
    out (p4, en);
end.


func parse_entity_def:
    in(p: Parser)
    line = peek(p).line;
    var (p2, name_tok, ok) = expect_tok(p, TokType.Ident, "expected entity name");
    if not ok do
        out (p2, ast_new(AstType.EntityDef));
    end

    p2 = skip_newlines(p2);

    # Consume optional ':' after entity name
    var (p2b, _) = match_tok(p2, TokType.Colon);
    p2 = p2b;
    p2 = skip_newlines(p2);

    ed = ast_new(AstType.EntityDef);
    ed.name = name_tok.str_val;
    ed.line = line;

    when not check(p2, TokType.End) and not check(p2, TokType.Eof) loop
        var (p3, fname, ok2) = expect_tok(p2, TokType.Ident, "expected field name");
        p2 = p3;
        if not ok2 do
            out (p2, ed);
        end

        field = ast_new(AstType.Identifier);
        field.name = fname.str_val;
        field.line = fname.line;

        # Optional type hint (may include generics: Vec<QInstr>, Vec<int>, ...)
        var (p4, has_colon) = match_tok(p2, TokType.Colon);
        if has_colon do
            if is_name_tok(peek(p4).tok_type) do
                field.name2 = peek(p4).str_val;
            end
            p2 = skip_type_annot(p4);
        else
            p2 = p4;
        end

        ed = ast_add_child(ed, field);
        var (p2s, _) = match_tok(p2, TokType.Semicolon);
        p2 = p2s;
        p2 = skip_newlines(p2);
    end

    var (p3, _, _) = expect_tok(p2, TokType.End, "expected 'end' after entity");
    var (p4, _) = match_tok(p3, TokType.Dot);
    out (p4, ed);
end.


func parse_statement:
    in(p: Parser)
    p = skip_newlines(p);
    t = peek(p);

    if t.tok_type == TokType.Extern do
        var (p2, _) = advance(p);
        # extern func name(params) -> type;
        if check(p2, TokType.Func) do
            var (p3, _) = advance(p2);
            var (p4, name_tok, ok) = expect_name(p3, "expected function name after extern func");
            n = ast_new(AstType.ExternFunc);
            n.name = name_tok.str_val;
            n.line = t.line;
            # Skip signature; only treat ';' / newline as terminator outside parens
            # (params may use ';' separators: `a: int; b: int`).
            edepth = 0;
            when not check(p4, TokType.Eof) loop
                if check(p4, TokType.LParen) or check(p4, TokType.LBracket) or check(p4, TokType.LBrace) do
                    edepth = edepth + 1;
                end
                if check(p4, TokType.RParen) or check(p4, TokType.RBracket) or check(p4, TokType.RBrace) do
                    if edepth > 0 do
                        edepth = edepth - 1;
                    end
                end
                if edepth == 0 and (check(p4, TokType.Semicolon) or check(p4, TokType.Newline)) do
                    break;
                end
                var (p5, _) = advance(p4);
                p4 = p5;
            end
            var (p5, _) = match_tok(p4, TokType.Semicolon);
            out (p5, n);
        end
        # Unknown extern declaration — skip the line
        when not check(p2, TokType.Newline) and not check(p2, TokType.Eof) loop
            var (p3, _) = advance(p2);
            p2 = p3;
        end
        out (p2, ast_new(AstType.ExternFunc));
    end

    if t.tok_type == TokType.TypeKw do
        var (p2, _) = advance(p);
        var (p3, name_tok, ok) = expect_name(p2, "expected type name after 'type'");
        n = ast_new(AstType.TypeDecl);
        n.line = t.line;
        if ok do
            n.name = name_tok.str_val;
        end
        var (p4, _) = match_tok(p3, TokType.Semicolon);
        out (p4, n);
    end

    if t.tok_type == TokType.Func do
        var (p2, _) = advance(p);
        out parse_func_def(p2);
    end

    if t.tok_type == TokType.Var do
        var (p2, _) = advance(p);
        out parse_var_decl(p2, false);
    end

    if t.tok_type == TokType.Const do
        var (p2, _) = advance(p);
        out parse_var_decl(p2, true);
    end

    if t.tok_type == TokType.If do
        var (p2, _) = advance(p);
        out parse_if_stmt(p2);
    end

    if t.tok_type == TokType.Loop do
        var (p2, _) = advance(p);
        out parse_loop_stmt(p2);
    end

    if t.tok_type == TokType.While or t.tok_type == TokType.When do
        var (p2, _) = advance(p);
        out parse_while_stmt(p2);
    end

    if t.tok_type == TokType.For do
        var (p2, _) = advance(p);
        out parse_for_range_stmt(p2);
    end

    if t.tok_type == TokType.Enum do
        var (p2, _) = advance(p);
        out parse_enum_def(p2);
    end

    if t.tok_type == TokType.Entity do
        var (p2, _) = advance(p);
        out parse_entity_def(p2);
    end

    if t.tok_type == TokType.Case do
        var (p2, _) = advance(p);
        out parse_case_stmt(p2);
    end

    if t.tok_type == TokType.Out do
        var (p2, _) = advance(p);
        out parse_return_stmt(p2);
    end

    if t.tok_type == TokType.Print do
        var (p2, _) = advance(p);
        out parse_print_stmt(p2);
    end

    if t.tok_type == TokType.Break do
        var (p2, _) = advance(p);
        n = ast_new(AstType.BreakStmt);
        n.line = t.line;
        out (p2, n);
    end

    if t.tok_type == TokType.Skip do
        var (p2, _) = advance(p);
        n = ast_new(AstType.ContinueStmt);
        n.line = t.line;
        out (p2, n);
    end

    if t.tok_type == TokType.Import do
        var (p2, _) = advance(p);
        var (p3, first_tok, ok) = expect_tok(p2, TokType.Ident, "expected name after import");
        if not ok do
            out (p3, ast_new(AstType.ImportStmt));
        end
        # Check if this is "import X, Y, Z from MODULE;" pattern
        # Collect all identifiers before 'from'
        names = vec_new_rt();
        names = vec_push_rt(names, first_tok.str_val);
        p4 = p3;
        when check(p4, TokType.Comma) loop
            var (p5, _) = advance(p4);
            p5 = skip_newlines(p5);
            var (p6, sym, _) = expect_tok(p5, TokType.Ident, "expected symbol name");
            names = vec_push_rt(names, sym.str_val);
            p4 = p6;
        end
        if check(p4, TokType.From) do
            # "import X, Y from MOD;" syntax
            var (p5, _) = advance(p4);
            var (p6, mod_tok, _) = expect_tok(p5, TokType.Ident, "expected module name after 'from'");
            n = ast_new(AstType.ImportStmt);
            n.name = mod_tok.str_val;
            n.line = t.line;
            ni = 0;
            when ni < vec_len_rt(names) loop
                s = ast_new(AstType.Identifier);
                s.name = vec_get_rt(names, ni);
                n = ast_add_child(n, s);
                ni = ni + 1;
            end
            var (p7, _) = match_tok(p6, TokType.Semicolon);
            out (p7, n);
        end
        # Simple "import MOD" or "import MOD as ALIAS"
        n = ast_new(AstType.ImportStmt);
        n.name = first_tok.str_val;
        n.line = t.line;
        var (p5, has_as) = match_tok(p4, TokType.As);
        if has_as do
            var (p6, alias, _) = expect_tok(p5, TokType.Ident, "expected alias");
            n.name2 = alias.str_val;
            out (p6, n);
        end
        out (p5, n);
    end

    if t.tok_type == TokType.From do
        var (p2, _) = advance(p);
        var (p3, mod_tok, ok) = expect_tok(p2, TokType.Ident, "expected module name");
        if not ok do
            out (p3, ast_new(AstType.ImportStmt));
        end
        var (p4, _, _) = expect_tok(p3, TokType.Import, "expected 'import'");
        n = ast_new(AstType.ImportStmt);
        n.name = mod_tok.str_val;
        n.line = t.line;
        should_loop = true;
        when should_loop loop
            var (p5, sym, _) = expect_tok(p4, TokType.Ident, "expected symbol name");
            p4 = p5;
            s = ast_new(AstType.Identifier);
            s.name = sym.str_val;
            s.line = sym.line;
            n = ast_add_child(n, s);
            var (p6, matched) = match_tok(p4, TokType.Comma);
            p4 = p6;
            if not matched do
                should_loop = false;
            end
        end
        out (p4, n);
    end

    if t.tok_type == TokType.Module do
        var (p2, _) = advance(p);
        var (p3, mod_tok, _) = expect_tok(p2, TokType.Ident, "expected module name");
        mod_path = mod_tok.str_val;
        when check(p3, TokType.DoubleColon) loop
            var (p4, _) = advance(p3);
            var (p5, seg, _) = expect_tok(p4, TokType.Ident, "expected name after '::'");
            mod_path = mod_path + "::" + seg.str_val;
            p3 = p5;
        end
        n = ast_new(AstType.ModuleStmt);
        n.name = mod_path;
        n.line = t.line;
        var (p4, _) = match_tok(p3, TokType.Semicolon);
        out (p4, n);
    end

    if t.tok_type == TokType.Export do
        var (p2, _) = advance(p);
        # export a, b, c;  — one or more names, optional trailing semicolon
        n = ast_new(AstType.Block);
        n.line = t.line;
        keep_exp = true;
        when keep_exp loop
            var (p3, fn_tok, ok) = expect_name(p2, "expected name after export");
            if not ok do
                out (p3, n);
            end
            item = ast_new(AstType.ExportStmt);
            item.name = fn_tok.str_val;
            item.line = t.line;
            n = ast_add_child(n, item);
            var (p4, has_comma) = match_tok(p3, TokType.Comma);
            if has_comma do
                p2 = p4;
            else
                keep_exp = false;
                var (p5, _) = match_tok(p3, TokType.Semicolon);
                out (p5, n);
            end
        end
    end

    if t.tok_type == TokType.Include do
        var (p2, _) = advance(p);
        n = ast_new(AstType.IncludeStmt);
        n.line = t.line;
        # Accept both string literal and identifier for include
        if check(p2, TokType.Str) do
            var (p3, file_tok, _) = expect_tok(p2, TokType.Str, "expected filename after include");
            n.name = file_tok.str_val;
            p2 = p3;
        else
            # Identifier path: include types; or include vir::rt::syscall;
            var (p3, id_tok, _) = expect_tok(p2, TokType.Ident, "expected module name after include");
            path = id_tok.str_val;
            p2 = p3;
            when check(p2, TokType.DoubleColon) loop
                var (p4, _) = advance(p2);
                var (p5, seg, _) = expect_tok(p4, TokType.Ident, "expected name after '::'");
                path = path + "::" + seg.str_val;
                p2 = p5;
            end
            n.name = path;
        end
        var (p3, _) = match_tok(p2, TokType.Semicolon);
        out (p3, n);
    end

    if t.tok_type == TokType.CheckCpu do
        var (p2, _) = advance(p);
        n = ast_new(AstType.CheckCpu);
        n.line = t.line;
        out (p2, n);
    end

    if t.tok_type == TokType.Patch do
        var (p2, _) = advance(p);
        n = ast_new(AstType.PatchPoint);
        n.line = t.line;
        out (p2, n);
    end

    # Identifier (may be assignment, field/index assign, or expression)
    if t.tok_type == TokType.Ident do
        # Peek ahead: if IDENT followed by '(' → expression statement (function call)
        # Do NOT advance first — let parse_expr handle it directly
        save_pos = p.pos;
        p.pos = p.pos + 1;
        next_type = peek(p).tok_type;
        p.pos = save_pos;
        if next_type == TokType.LParen do
            out parse_expr(p);
        end

        var (p2, id_tok) = advance(p);

        # Simple assignment: IDENT = expr
        if check(p, TokType.Assign) do
            var (p3, _) = advance(p);
            var (p4, val) = parse_expr(p3);
            assign = ast_new(AstType.Assign);
            assign.name = id_tok.str_val;
            assign.line = id_tok.line;
            assign = ast_add_child(assign, val);
            out (p4, assign);
        end

        # Field assignment: IDENT.FIELD = expr
        if check(p, TokType.Dot) do
            var (p3, _) = advance(p);
            var (p4, field_tok, ok) = expect_tok(p3, TokType.Ident, "expected field name");
            if ok and check(p4, TokType.Assign) do
                var (p5, _) = advance(p4);
                var (p6, val) = parse_expr(p5);
                fa = ast_new(AstType.FieldAssign);
                fa.name = id_tok.str_val;
                fa.line = id_tok.line;
                fa = ast_add_child(fa, val);
                # Set name2 AFTER ast_add_child since vec_push_rt corrupts name2
                fa.name2 = field_tok.str_val;
                out (p6, fa);
            end
            # Not field assign — back up and parse as expression
            p2 = p;
            var (p5, expr) = parse_expr(p2);
            out (p5, expr);
        end

        # Index assignment: IDENT[expr] = expr
        if check(p, TokType.LBracket) do
            var (p3, _) = advance(p);
            var (p4, idx_expr) = parse_expr(p3);
            var (p5, _, _) = expect_tok(p4, TokType.RBracket, "expected ']'");
            if check(p5, TokType.Assign) do
                var (p6, _) = advance(p5);
                var (p7, val) = parse_expr(p6);
                ia = ast_new(AstType.IndexAssign);
                ia.name = id_tok.str_val;
                ia.line = id_tok.line;
                ia = ast_add_child(ia, idx_expr);
                ia = ast_add_child(ia, val);
                out (p7, ia);
            end
            # Not assignment — it's an index access expression
            acc = ast_new(AstType.IndexAccess);
            acc.name = id_tok.str_val;
            acc.line = id_tok.line;
            acc = ast_add_child(acc, idx_expr);
            out (p5, acc);
        end

        # Back up and parse as expression
        p.pos = p.pos - 1;
        var (p3, expr) = parse_expr(p);
        out (p3, expr);
    end

    # EOF / END / ELSE / EIF — no statement
    is_terminator = (t.tok_type == TokType.Eof or t.tok_type == TokType.End or t.tok_type == TokType.Else or t.tok_type == TokType.EifEif);
    if is_terminator do
        out (p, ast_new(AstType.LiteralInt));
    end

    # Default: try as expression statement
    out parse_expr(p);
end.


# ═══════════════════════════════════════════════════════
# Top-Level Entry Point
# ═══════════════════════════════════════════════════════

func parse_program:
    in(p: Parser)
    prog = ast_new(AstType.Program);
    g_ast_node_types = vec_new_rt();
    g_ast_child_names = vec_new_rt();
    g_ast_children_acc = prog.children;
    g_boot_prog_count = 0;
    p = skip_newlines(p);

    when not check(p, TokType.Eof) loop
        var (p2, stmt) = parse_statement(p);
        p = p2;
        # Capture top-level type/name before nested ast_add_child noise.
        let ty = g_pending_stmt_type;
        let nm = g_pending_stmt_name;
        if ty == 0 do
            ty = stmt.node_type;
            nm = stmt.name;
        end
        g_pending_stmt_type = 0;
        g_pending_stmt_name = 0;
        prog = ast_add_child(prog, stmt);
        g_ast_node_types = vec_push_rt(g_ast_node_types, ty);
        g_ast_child_names = vec_push_rt(g_ast_child_names, nm);
        g_boot_prog_count = g_boot_prog_count + 1;
        if rt_strlen(p.error_msg) > 0 do
            out (p, prog);
        end
        p = skip_newlines(p);
    end

    g_ast_children_acc = prog.children;
    g_snap_ast_kids = g_boot_prog_count;
    if g_snap_ast_kids == 0 do
        g_snap_ast_kids = vec_len_rt(g_ast_children_acc);
    end

    out (p, prog);
end.
# ══ END vir/compiler/parser ══

# ══ BEGIN vir/compiler/ir_optimizer ══
##
 * vir/compiler/ir_optimizer.vri — AST→Q-IR Lowering + Linear-Scan RegAlloc
 * =========================================================================
 * Pure Vir implementation. Transforms AST into Q-IR instructions,
 * performs liveness analysis, linear-scan register allocation,
 * spill code insertion, and tail-call optimization.
 *
 * Converted from C (core/src/ir_lower.c) for self-hosting.
 ##



# ═══════════════════════════════════════════════════════
# Q-IR Opcode Set
# ═══════════════════════════════════════════════════════

enum QOp:
    Nop             = 0;
    Load            = 1;
    Move            = 2;
    Add             = 3;
    Sub             = 4;
    Mul             = 5;
    Div             = 6;
    Mod             = 7;
    And             = 8;
    Or              = 9;
    Xor             = 10;
    Shl             = 11;
    Shr             = 12;
    CmpEq           = 20;
    CmpNe           = 21;
    CmpGt           = 22;
    CmpLt           = 23;
    CmpGe           = 24;
    CmpLe           = 25;
    Jump            = 30;
    JumpIfNot       = 31;
    Label           = 32;
    Call            = 33;
    CallFunc        = 34;
    Ret             = 35;
    Print           = 40;
    PrintStr        = 41;
    Input           = 42;
    Alloc           = 50;
    Free            = 51;
    LoadByte        = 52;
    StoreByte       = 53;
    LoadWord        = 54;
    StoreWord       = 55;
    ArrNew          = 60;
    ArrPush         = 61;
    ArrGet          = 62;
    ArrSet          = 63;
    ArrLen          = 64;
    StrLenOp        = 70;
    StrGet          = 71;
    StrCat          = 72;
    StrEq           = 73;
    IToStr          = 74;
    StrToI          = 75;
    FileOpen        = 80;
    FileRead        = 81;
    FileWrite       = 82;
    FileClose       = 83;
    FileWriteByte   = 84;
    Exit            = 90;
    PatchPoint      = 91;
    LoadGlobal      = 92;
    StoreGlobal     = 93;
    GetArg          = 94;
    ArgCount        = 95;
    SetArg          = 96;
    LoadFuncAddr    = 97;
end.


# ═══════════════════════════════════════════════════════
# Q-IR Operand
# ═══════════════════════════════════════════════════════

enum OperandType:
    None        = 0;
    VReg        = 1;
    Immediate   = 2;
    LabelRef    = 3;
    StringRef   = 4;
    FuncIdx     = 5;
end.

entity QOperand:
    op_type:    OperandType;
    vreg:       int;
    imm_val:    int;
end.

func q_none:
    out QOperand ( op_type: OperandType.None, vreg: 0, imm_val: 0 );
end.

func q_vreg:
    in(r: int)
    out QOperand ( op_type: OperandType.VReg, vreg: r, imm_val: 0 );
end.

func q_imm:
    in(val: int)
    out QOperand ( op_type: OperandType.Immediate, vreg: 0, imm_val: val );
end.

func q_label:
    in(id: int)
    out QOperand ( op_type: OperandType.LabelRef, vreg: id, imm_val: 0 );
end.

func q_str_ref:
    in(idx: int)
    out QOperand ( op_type: OperandType.StringRef, vreg: idx, imm_val: 0 );
end.

func q_func_idx:
    in(idx: int)
    out QOperand ( op_type: OperandType.FuncIdx, vreg: idx, imm_val: 0 );
end.


# ═══════════════════════════════════════════════════════
# Q-IR Instruction
# ═══════════════════════════════════════════════════════

entity QInstr:
    opcode:     QOp;
    dest:       QOperand
    src1:       QOperand
    src2:       QOperand
    patch_id:   int;
end.

func q_instr:
    in(op: QOp, d: QOperand, s1: QOperand, s2: QOperand)
    out QInstr { opcode: op, dest: d, src1: s1, src2: s2, patch_id: 0 };
end.


# ═══════════════════════════════════════════════════════
# Q-IR Function bit_and Module
# ═══════════════════════════════════════════════════════

entity QFunction:
    name:           string;
    body:           Vec<QInstr>;
    param_count:    int;
    param_vregs:    Vec<int>;
end.

func q_func_new:
    in(name: string)
    out QFunction {
        name:        name,
        body:        vec_new_rt(),
        param_count: 0,
        param_vregs: vec_new_rt()
    };
end.

var g_cur_func_body = 0;
var g_boot_emit_count = 0;
var g_snap_emit_count = 0;
var g_boot_flat_active = 0;
var g_boot_fn_progress = 0;
var g_boot_small_multi = 0;   # mirror; authoritative flag in name-cell offset 64
var g_boot_nfuncs_reg = 0;    # FuncDef count from pass 1

func boot_set_small_multi:
    in(v: int)
    extern func native_write_i64(addr: int, offset: int, val: int);
    g_boot_small_multi = v;
    if g_boot_name_cell == 0 do
        boot_name_cell_init();
    end
    # reuse end of name cell — expand if needed
    native_write_i64(g_boot_name_cell, 64, v);
    if v != 0 do
        boot_set_bd_dump(1);
        boot_set_bd_cap(1000);
    end
end.

func boot_get_small_multi:
    extern func native_read_i64(addr: int, offset: int) -> int;
    if g_boot_name_cell == 0 do
        out g_boot_small_multi;
    end
    out native_read_i64(g_boot_name_cell, 64);
end.


func boot_set_bd_dump:
    in(v: int)
    extern func native_write_i64(addr: int, offset: int, val: int);
    if g_boot_name_cell == 0 do
        boot_name_cell_init();
    end
    # name-cell 72: body-dump active (self-host or small_multi). No new Vir globals.
    native_write_i64(g_boot_name_cell, 72, v);
end.

func boot_bd_dump_on:
    extern func native_read_i64(addr: int, offset: int) -> int;
    if boot_get_small_multi() != 0 do
        out 1;
    end
    if g_boot_name_cell == 0 do
        out 0;
    end
    out native_read_i64(g_boot_name_cell, 72);
end.

func boot_set_bd_cap:
    in(v: int)
    extern func native_write_i64(addr: int, offset: int, val: int);
    if g_boot_name_cell == 0 do
        boot_name_cell_init();
    end
    native_write_i64(g_boot_name_cell, 80, v);
end.

func boot_bd_cap:
    extern func native_read_i64(addr: int, offset: int) -> int;
    if g_boot_name_cell == 0 do
        out 1000;
    end
    let c = native_read_i64(g_boot_name_cell, 80);
    if c <= 0 do
        out 1000;
    end
    out c;
end.
var g_boot_q_meta = 0;
var g_boot_q_opc = 0;
var g_boot_q_dst = 0;
var g_boot_q_s1v = 0;
var g_boot_q_s2v = 0;
var g_boot_q_s1i = 0;
var g_boot_q_s2i = 0;
var g_boot_q_s1f = 0;
var g_boot_q_s2f = 0;
var g_boot_func_tab = 0;   # native i64[n]: code offset per function index
var g_bd_opc = 0;
var g_bd_dv = 0;
var g_bd_di = 0;
var g_bd_s1t = 0;
var g_bd_s1v = 0;
var g_bd_s1i = 0;
var g_bd_s2v = 0;
var g_bd_fstart = 0;
var g_bd_flen = 0;
var g_bd_fnpc = 0;
var g_bd_fmain = 0;
var g_bd_total = 0;
var g_bd_nfuncs = 0;

func boot_body_dump_init:
    # 262144 bytes ≈ 32768 i64 slots — enough for self-host capped lower.
    # Func tables: 8192 bytes ≈ 1024 function metadata entries.
    if g_bd_opc == 0 do
        g_bd_opc = heap_alloc(262144);
        g_bd_dv = heap_alloc(262144);
        g_bd_di = heap_alloc(262144);
        g_bd_s1t = heap_alloc(262144);
        g_bd_s1v = heap_alloc(262144);
        g_bd_s1i = heap_alloc(262144);
        g_bd_s2v = heap_alloc(262144);
        g_bd_fstart = heap_alloc(8192);
        g_bd_flen = heap_alloc(8192);
        g_bd_fnpc = heap_alloc(8192);
        g_bd_fmain = heap_alloc(8192);
    end
end.

func boot_bd_push_load:
    in(dv: int, imm: int)
    extern func native_write_i64(addr: int, offset: int, val: int);
    if boot_bd_dump_on() == 0 do
        out;
    end
    boot_body_dump_init();
    let ix = g_bd_total;
    if ix >= boot_bd_cap() do
        out;
    end
    native_write_i64(g_bd_opc, ix * 8, 1);
    native_write_i64(g_bd_dv, ix * 8, dv);
    native_write_i64(g_bd_di, ix * 8, 0);
    native_write_i64(g_bd_s1t, ix * 8, 2);
    native_write_i64(g_bd_s1v, ix * 8, 0);
    native_write_i64(g_bd_s1i, ix * 8, imm);
    native_write_i64(g_bd_s2v, ix * 8, 0);
    g_bd_total = ix + 1;
end.

func boot_bd_push_print:
    in(sv: int)
    extern func native_write_i64(addr: int, offset: int, val: int);
    if boot_bd_dump_on() == 0 do
        out;
    end
    boot_body_dump_init();
    let ix = g_bd_total;
    if ix >= boot_bd_cap() do
        out;
    end
    native_write_i64(g_bd_opc, ix * 8, 40);
    native_write_i64(g_bd_dv, ix * 8, 0);
    native_write_i64(g_bd_di, ix * 8, 0);
    native_write_i64(g_bd_s1t, ix * 8, 1);
    native_write_i64(g_bd_s1v, ix * 8, sv);
    native_write_i64(g_bd_s1i, ix * 8, 0);
    native_write_i64(g_bd_s2v, ix * 8, 0);
    g_bd_total = ix + 1;
end.

func boot_bd_push_ret:
    in(sv: int)
    extern func native_write_i64(addr: int, offset: int, val: int);
    if boot_bd_dump_on() == 0 do
        out;
    end
    boot_body_dump_init();
    let ix = g_bd_total;
    if ix >= boot_bd_cap() do
        out;
    end
    native_write_i64(g_bd_opc, ix * 8, 35);
    native_write_i64(g_bd_dv, ix * 8, 0);
    native_write_i64(g_bd_di, ix * 8, 0);
    native_write_i64(g_bd_s1t, ix * 8, 1);
    native_write_i64(g_bd_s1v, ix * 8, sv);
    native_write_i64(g_bd_s1i, ix * 8, 0);
    native_write_i64(g_bd_s2v, ix * 8, 0);
    g_bd_total = ix + 1;
end.

func boot_bd_push_ret_imm:
    in(imm: int)
    extern func native_write_i64(addr: int, offset: int, val: int);
    if boot_bd_dump_on() == 0 do
        out;
    end
    boot_body_dump_init();
    let ix = g_bd_total;
    if ix >= boot_bd_cap() do
        out;
    end
    native_write_i64(g_bd_opc, ix * 8, 35);
    native_write_i64(g_bd_dv, ix * 8, 0);
    native_write_i64(g_bd_di, ix * 8, 0);
    native_write_i64(g_bd_s1t, ix * 8, 2);
    native_write_i64(g_bd_s1v, ix * 8, 0);
    native_write_i64(g_bd_s1i, ix * 8, imm);
    native_write_i64(g_bd_s2v, ix * 8, 0);
    g_bd_total = ix + 1;
end.

func boot_bd_push_move:
    in(dv: int, sv: int)
    extern func native_write_i64(addr: int, offset: int, val: int);
    if boot_bd_dump_on() == 0 do
        out;
    end
    boot_body_dump_init();
    let ix = g_bd_total;
    if ix >= boot_bd_cap() do
        out;
    end
    native_write_i64(g_bd_opc, ix * 8, 2);
    native_write_i64(g_bd_dv, ix * 8, dv);
    native_write_i64(g_bd_di, ix * 8, 0);
    native_write_i64(g_bd_s1t, ix * 8, 1);
    native_write_i64(g_bd_s1v, ix * 8, sv);
    native_write_i64(g_bd_s1i, ix * 8, 0);
    native_write_i64(g_bd_s2v, ix * 8, 0);
    g_bd_total = ix + 1;
end.

func boot_bd_push_binop:
    in(dv: int, a: int, b: int)
    # Opcode from name-cell 128 — g_st_opc / multi-arg params get clobbered on C VM.
    extern func native_write_i64(addr: int, offset: int, val: int);
    extern func native_read_i64(addr: int, offset: int) -> int;
    if boot_bd_dump_on() == 0 do
        out;
    end
    boot_body_dump_init();
    let ix = g_bd_total;
    if ix >= boot_bd_cap() do
        out;
    end
    let opc = native_read_i64(g_boot_name_cell, 128);
    native_write_i64(g_bd_opc, ix * 8, opc);
    native_write_i64(g_bd_dv, ix * 8, dv);
    native_write_i64(g_bd_di, ix * 8, 0);
    native_write_i64(g_bd_s1t, ix * 8, 1);
    native_write_i64(g_bd_s1v, ix * 8, a);
    native_write_i64(g_bd_s1i, ix * 8, 0);
    native_write_i64(g_bd_s2v, ix * 8, b);
    g_bd_total = ix + 1;
end.

func boot_bd_push_setarg:
    in(ai: int, sv: int)
    extern func native_write_i64(addr: int, offset: int, val: int);
    if boot_bd_dump_on() == 0 do
        out;
    end
    boot_body_dump_init();
    let ix = g_bd_total;
    if ix >= boot_bd_cap() do
        out;
    end
    native_write_i64(g_bd_opc, ix * 8, 96);
    native_write_i64(g_bd_dv, ix * 8, 0);
    native_write_i64(g_bd_di, ix * 8, ai);
    native_write_i64(g_bd_s1t, ix * 8, 1);
    native_write_i64(g_bd_s1v, ix * 8, sv);
    native_write_i64(g_bd_s1i, ix * 8, 0);
    native_write_i64(g_bd_s2v, ix * 8, 0);
    g_bd_total = ix + 1;
end.

func boot_bd_push_call:
    in(dv: int, fidx: int)
    extern func native_write_i64(addr: int, offset: int, val: int);
    if boot_bd_dump_on() == 0 do
        out;
    end
    boot_body_dump_init();
    let ix = g_bd_total;
    if ix >= boot_bd_cap() do
        out;
    end
    native_write_i64(g_bd_opc, ix * 8, 34);
    native_write_i64(g_bd_dv, ix * 8, dv);
    native_write_i64(g_bd_di, ix * 8, 0);
    native_write_i64(g_bd_s1t, ix * 8, 5);
    native_write_i64(g_bd_s1v, ix * 8, fidx);
    native_write_i64(g_bd_s1i, ix * 8, 0);
    native_write_i64(g_bd_s2v, ix * 8, 0);
    g_bd_total = ix + 1;
end.

func boot_q_stage_reset:
    if g_boot_q_opc == 0 do
        g_boot_q_opc = heap_alloc(4096);
        g_boot_q_dst = heap_alloc(4096);
        g_boot_q_s1v = heap_alloc(4096);
        g_boot_q_s2v = heap_alloc(4096);
        g_boot_q_s1i = heap_alloc(4096);
        g_boot_q_s2i = heap_alloc(4096);
        g_boot_q_s1f = heap_alloc(4096);
        g_boot_q_s2f = heap_alloc(4096);
        g_boot_q_meta = heap_alloc(8);
    end
    g_boot_emit_count = 0;
    if g_boot_q_meta != 0 do
        native_write_i64(g_boot_q_meta, 0, 0);
    end
    let k = 0;
    when k < 64 loop
        native_write_i64(g_boot_q_opc, k * 8, 0);
        k = k + 1;
    end
end.

func boot_q_stage_push:
    in(instr: QInstr)
    extern func native_write_i64(addr: int, offset: int, val: int);
    let idx = 0;
    if g_boot_q_meta != 0 do
        idx = native_read_i64(g_boot_q_meta, 0);
    end
    native_write_i64(g_boot_q_opc, idx * 8, instr.opcode as int);
    native_write_i64(g_boot_q_dst, idx * 8, instr.dest.vreg);
    native_write_i64(g_boot_q_s1v, idx * 8, instr.src1.vreg);
    native_write_i64(g_boot_q_s2v, idx * 8, instr.src2.vreg);
    if instr.src1.op_type == OperandType.Immediate do
        native_write_i64(g_boot_q_s1f, idx * 8, 1);
        native_write_i64(g_boot_q_s1i, idx * 8, instr.src1.imm_val);
    else
        native_write_i64(g_boot_q_s1f, idx * 8, 0);
    end
    if instr.src2.op_type == OperandType.Immediate do
        native_write_i64(g_boot_q_s2f, idx * 8, 1);
        native_write_i64(g_boot_q_s2i, idx * 8, instr.src2.imm_val);
    else
        native_write_i64(g_boot_q_s2f, idx * 8, 0);
    end
    g_boot_emit_count = idx + 1;
    if g_boot_q_meta != 0 do
        native_write_i64(g_boot_q_meta, 0, idx + 1);
    end
end.

var g_st_opc = 0;
var g_st_dv = 0;
var g_st_s1f = 0;
var g_st_s1v = 0;
var g_st_s1i = 0;
var g_st_s2f = 0;
var g_st_s2v = 0;
var g_st_s2i = 0;
# Scratch for staging helper args (VM clobbers multi-arg params).
var g_cg_cb = 0;
var g_cg_rd = 0;
var g_cg_rn = 0;
var g_cg_rm = 0;
var g_cg_imm = 0;
var g_cg_off = 0;
var g_cg_target = 0;
var g_cg_bl_tgt = 0;
var g_boot_main_off = 0;
var g_boot_rt_print = 0;
var g_boot_rt_exit = 0;
var g_boot_param_nlocal = 0;
var g_boot_param_v0 = 0;
# Index of the QFunction currently being lowered. boot_q_stage_commit
# dual-writes staged ops into this function's body so codegen_emit_module
# (which reads QFunction.body, not the flat staging arrays) sees them.
var g_boot_cur_func_idx = 0 - 1;

func boot_q_stage_commit:
    extern func native_write_i64(addr: int, offset: int, val: int);
    if g_boot_q_opc == 0 do
        boot_q_stage_reset();
    end
    let idx = 0;
    if g_boot_q_meta != 0 do
        idx = native_read_i64(g_boot_q_meta, 0);
    end
    # Write dst first so opc overwrite bug is detectable
    native_write_i64(g_boot_q_dst, idx * 8, g_st_dv);
    native_write_i64(g_boot_q_s1f, idx * 8, g_st_s1f);
    native_write_i64(g_boot_q_s1i, idx * 8, g_st_s1i);
    native_write_i64(g_boot_q_s1v, idx * 8, g_st_s1v);
    native_write_i64(g_boot_q_s2f, idx * 8, g_st_s2f);
    native_write_i64(g_boot_q_s2i, idx * 8, g_st_s2i);
    native_write_i64(g_boot_q_s2v, idx * 8, g_st_s2v);
    native_write_i64(g_boot_q_opc, idx * 8, g_st_opc);
    g_boot_emit_count = idx + 1;
    if g_boot_q_meta != 0 do
        native_write_i64(g_boot_q_meta, 0, idx + 1);
    end

    # Dual-write into the current QFunction.body (entity path).
    if g_boot_cur_func_idx >= 0 and g_mod_funcs_acc != 0 do
        let d_op = q_none();
        if g_st_opc == 1 or g_st_opc == 2 or g_st_opc == 3 or g_st_opc == 4 or g_st_opc == 5 or g_st_opc == 6 or g_st_opc == 7 do
            d_op = q_vreg(g_st_dv);
        end
        let s1_op = q_none();
        if g_st_s1f != 0 do
            s1_op = q_imm(g_st_s1i);
        else
            if g_st_opc == 40 or g_st_opc == 35 or g_st_opc == 2 or g_st_opc == 3 or g_st_opc == 4 or g_st_opc == 5 or g_st_opc == 6 or g_st_opc == 7 do
                s1_op = q_vreg(g_st_s1v);
            end
        end
        let s2_op = q_none();
        if g_st_s2f != 0 do
            s2_op = q_imm(g_st_s2i);
        else
            if g_st_opc == 3 or g_st_opc == 4 or g_st_opc == 5 or g_st_opc == 6 or g_st_opc == 7 do
                s2_op = q_vreg(g_st_s2v);
            end
        end
        # Print-imm: expand to Load temp + Print so codegen_emit_module
        # (which only handles Print-of-VReg) can emit correctly.
        if g_st_opc == 40 and g_st_s1f != 0 do
            let tmp = 28;
            let f = vec_get_rt(g_mod_funcs_acc, g_boot_cur_func_idx);
            f = q_func_emit(f, q_instr(QOp.Load, q_vreg(tmp), q_imm(g_st_s1i), q_none()));
            f = q_func_emit(f, q_instr(QOp.Print, q_none(), q_vreg(tmp), q_none()));
            vec_set_rt(g_mod_funcs_acc, g_boot_cur_func_idx, f);
        else
            let f2 = vec_get_rt(g_mod_funcs_acc, g_boot_cur_func_idx);
            f2 = q_func_emit(f2, q_instr(g_st_opc as QOp, d_op, s1_op, s2_op));
            vec_set_rt(g_mod_funcs_acc, g_boot_cur_func_idx, f2);
        end
    end
end.

var g_boot_local_vreg = 0;

func boot_ir_load_imm0:
    g_st_opc = 1;
    g_st_s1f = 1;
    g_st_s1v = 0;
    g_st_s2f = 0;
    g_st_s2v = 0;
    g_st_s2i = 0;
    boot_q_stage_commit();
end.

func boot_ir_load_imm:
    in(d_v: int)
    if g_boot_flat_active == 0 do
        out;
    end
    # Imm pre-staged via boot_set_imm. Single arg only (VM clobbers multi-arg).
    boot_set_dv(d_v);
    boot_set_s1v(0);
    boot_set_s2v(0);
    g_st_opc = 1;
    g_st_s1f = 1;
    g_st_s2f = 0;
    g_st_s2i = 0;
    boot_flat_push();
end.

func boot_ir_print0:
    boot_set_dv(0);
    boot_set_s2v(0);
    g_st_opc = 40;
    g_st_s1f = 0;
    g_st_s2f = 0;
    g_st_s2i = 0;
    boot_flat_push();
end.

func boot_ir_print_imm0:
    boot_set_dv(0);
    boot_set_s1v(0);
    boot_set_s2v(0);
    g_st_opc = 40;
    g_st_s1f = 1;
    g_st_s2f = 0;
    g_st_s2i = 0;
    boot_flat_push();
end.

func boot_ir_move:
    if g_boot_flat_active == 0 do
        out;
    end
    boot_set_s2v(0);
    g_st_opc = 2;
    g_st_s1f = 0;
    g_st_s2f = 0;
    g_st_s2i = 0;
    boot_flat_push();
end.

func boot_ir_print:
    if g_boot_flat_active == 0 do
        out;
    end
    boot_set_dv(0);
    boot_set_s2v(0);
    g_st_opc = 40;
    g_st_s1f = 0;
    g_st_s2f = 0;
    g_st_s2i = 0;
    boot_flat_push();
end.

func boot_ir_print_imm:
    in(imm: int)
    if g_boot_flat_active == 0 do
        out;
    end
    boot_set_imm(imm);
    boot_set_dv(0);
    boot_set_s1v(0);
    boot_set_s2v(0);
    g_st_opc = 40;
    g_st_s1f = 1;
    g_st_s2f = 0;
    g_st_s2i = 0;
    boot_flat_push();
end.

func boot_ir_binop:
    if g_boot_flat_active == 0 do
        out;
    end
    g_st_s1f = 0;
    g_st_s2f = 0;
    g_st_s2i = 0;
    boot_flat_push();
end.

func boot_ir_ret:
    if g_boot_flat_active == 0 do
        out;
    end
    boot_set_dv(0);
    boot_set_s2v(0);
    g_st_opc = 35;
    g_st_s1f = 0;
    g_st_s2f = 0;
    g_st_s2i = 0;
    boot_flat_push();
end.

func boot_ir_ret_imm:
    in(imm: int)
    if g_boot_flat_active == 0 do
        out;
    end
    boot_set_imm(imm);
    boot_set_dv(0);
    boot_set_s1v(0);
    boot_set_s2v(0);
    g_st_opc = 35;
    g_st_s1f = 1;
    g_st_s2f = 0;
    g_st_s2i = 0;
    boot_flat_push();
end.

func q_func_emit:
    in(f: QFunction, instr: QInstr)
    if g_cur_func_body == 0 do
        g_cur_func_body = f.body;
    end
    if g_cur_func_body == 0 do
        g_cur_func_body = vec_new_rt();
    end
    g_cur_func_body = vec_push_rt(g_cur_func_body, instr);
    # Rebuild with ALL fields in declared order so .body reads back correctly.
    out QFunction {
        name:        f.name,
        body:        g_cur_func_body,
        param_count: f.param_count,
        param_vregs: f.param_vregs
    };
end.


entity QModule:
    name:       string;
    functions:  Vec<QFunction>;
    strings:    Vec<string>;
end.

func q_module_new:
    in(name: string)
    funcs = vec_new_rt();
    strs = vec_new_rt();
    g_mod_funcs_acc = funcs;
    g_mod_strings_acc = strs;
    out QModule {
        name:       name,
        functions:  funcs,
        strings:    strs
    };
end.

func q_module_add_func:
    in(m: QModule, name: string)
    f = q_func_new(name);
    m.functions = vec_push_rt(m.functions, f);
    g_mod_funcs_acc = m.functions;
    idx = vec_len_rt(m.functions) - 1;
    out (m, idx as int);
end.

func q_module_add_string:
    in(m: QModule, s: string)
    # Check if string already exists
    i = 0;
    when i < vec_len_rt(m.strings) loop
        if str_eq(vec_get_rt(m.strings, i), s) do
            out (m, i as int);
        end
        i = i + 1;
    end
    m.strings = vec_push_rt(m.strings, s);
    g_mod_strings_acc = m.strings;
    out (m, (vec_len_rt(m.strings) - 1) as int);
end.


# ═══════════════════════════════════════════════════════
# Symbol Table
# ═══════════════════════════════════════════════════════

entity SymEntry:
    name:       string;
    vreg:       int;
end.

entity SymTable:
    entries:    Vec<SymEntry>;
end.

func sym_new:
    out SymTable ( entries: vec_new_rt() );
end.

func sym_define:
    in(st: SymTable, name: string, vreg: int)
    # Overwrite if exists
    i = 0;
    when i < vec_len_rt(st.entries) loop
        entry = vec_get_rt(st.entries, i);
        if str_eq(entry.name, name) do
            entry.vreg = vreg;
            vec_set_rt(st.entries, i, entry);
            out st;
        end
        i = i + 1;
    end
    st.entries = vec_push_rt(st.entries, SymEntry ( name: name, vreg: vreg ));
    out st;
end.

func sym_lookup:
    in(st: SymTable, name: string)
    i = 0;
    when i < vec_len_rt(st.entries) loop
        entry = vec_get_rt(st.entries, i);
        if str_eq(entry.name, name) do
            out (true, entry.vreg);
        end
        i = i + 1;
    end
    out (false, 0);
end.


# ═══════════════════════════════════════════════════════
# Enum / Entity Type Registry
# ═══════════════════════════════════════════════════════

entity EnumVariant:
    name:   string;
    value:  int;
end.

entity EnumType:
    name:       string;
    variants:   Vec<EnumVariant>;
end.

entity EntityField:
    name:   string;
    offset: int;
end.

entity EntityType:
    name:       string;
    fields:     Vec<EntityField>;
end.

func find_enum_type:
    in(types: Vec<EnumType>, name: string)
    i = 0;
    when i < vec_len_rt(types) loop
        et = vec_get_rt(types, i);
        if str_eq(et.name, name) do
            out (true, i);
        end
        i = i + 1;
    end
    out (false, -1);
end.

func enum_lookup_variant:
    in(et: EnumType, variant: string)
    i = 0;
    when i < vec_len_rt(et.variants) loop
        v = vec_get_rt(et.variants, i);
        if str_eq(v.name, variant) do
            out (true, v.value);
        end
        i = i + 1;
    end
    out (false, 0);
end.

func find_entity_type:
    in(types: Vec<EntityType>, name: string)
    i = 0;
    when i < vec_len_rt(types) loop
        et = vec_get_rt(types, i);
        if str_eq(et.name, name) do
            out (true, i);
        end
        i = i + 1;
    end
    out (false, -1);
end.

func entity_field_offset:
    in(et: EntityType, field: string)
    i = 0;
    when i < vec_len_rt(et.fields) loop
        f = vec_get_rt(et.fields, i);
        if str_eq(f.name, field) do
            out (true, f.offset as int);
        end
        i = i + 1;
    end
    out (false, -1);
end.

# Flat-vector entity lookup (avoids C VM nested Vec corruption)
func find_ent_flat:
    in(names: Vec<string>, name: string)
    i = 0;
    when i < vec_len_rt(names) loop
        n = vec_get_rt(names, i);
        if str_eq(n, name) do
            out (true, i);
        end
        i = i + 1;
    end
    out (false, -1);
end.

func ent_field_offset_flat:
    in(field_names: Vec<string>, field_offsets: Vec<int>, field_counts: Vec<int>, eidx: int, field: string)
    # Compute start index into flat field arrays.
    # C VM clobbers Vec headers under deep calls — clamp everything.
    let nnames = vec_len_rt(field_names);
    if nnames < 0 or nnames > 4096 do
        out (false, -1);
    end
    start = 0;
    j = 0;
    when j < eidx loop
        let cj = vec_get_rt(field_counts, j);
        if cj < 0 or cj > 256 do
            out (false, -1);
        end
        start = start + cj;
        j = j + 1;
    end
    count = vec_get_rt(field_counts, eidx);
    if count < 0 or count > 256 do
        # Fallback: linear scan of all flat field names (ignore broken counts).
        i = 0;
        when i < nnames loop
            fn = vec_get_rt(field_names, i);
            if str_eq(fn, field) do
                let off = vec_get_rt(field_offsets, i);
                if off >= 0 and off < 65536 do
                    out (true, off);
                end
                out (true, i * 8);
            end
            i = i + 1;
        end
        out (false, -1);
    end
    if start + count > nnames do
        count = nnames - start;
        if count < 0 do
            out (false, -1);
        end
    end
    i = 0;
    when i < count loop
        fn = vec_get_rt(field_names, start + i);
        if str_eq(fn, field) do
            let off = vec_get_rt(field_offsets, start + i);
            if off >= 0 and off < 65536 do
                out (true, off);
            end
            out (true, (start + i) * 8);
        end
        i = i + 1;
    end
    out (false, -1);
end.

func ent_field_count_flat:
    in(field_counts: Vec<int>, eidx: int)
    out vec_get_rt(field_counts, eidx);
end.


# ═══════════════════════════════════════════════════════
# Lowering Context
# ═══════════════════════════════════════════════════════

entity LowerCtx:
    mod_obj:            QModule;
    next_vreg:          int;
    label_counter:      int;
    symbols:            SymTable;
    global_symbols:     SymTable;
    global_idx_counter: int;
    enum_types:         Vec<EnumType>;
    entity_types:       Vec<EntityType>;
    ent_names:          Vec<string>;
    ent_field_names:    Vec<string>;
    ent_field_offsets:  Vec<int>;
    ent_field_counts:   Vec<int>;
    current_func_idx:   int;
    loop_depth:         int;
    loop_start_labels:  Vec<int>;
    loop_end_labels:    Vec<int>;
    error_count:        int;
    last_error:         string;
    patch_counter:      int;
end.

func lower_ctx_new:
    in(mod_name: string)
    out LowerCtx {
        mod_obj:            q_module_new(mod_name),
        next_vreg:          0,
        label_counter:      0,
        symbols:            sym_new(),
        global_symbols:     sym_new(),
        global_idx_counter: 0,
        enum_types:         vec_new_rt(),
        entity_types:       vec_new_rt(),
        ent_names:          vec_new_rt(),
        ent_field_names:    vec_new_rt(),
        ent_field_offsets:  vec_new_rt(),
        ent_field_counts:   vec_new_rt(),
        current_func_idx:   -1,
        loop_depth:         0,
        loop_start_labels:  vec_new_rt(),
        loop_end_labels:    vec_new_rt(),
        error_count:        0,
        last_error:         str_new(""),
        patch_counter:      0
    };
end.

func fresh_vreg:
    in(ctx: LowerCtx)
    # Do NOT read/write ctx.next_vreg — entity field offsets for LowerCtx are
    # unreliable on the C VM. Use native cell only.
    extern func native_read_i64(addr: int, offset: int) -> int;
    extern func native_write_i64(addr: int, offset: int, val: int);
    if g_boot_nvreg_cell == 0 do
        g_boot_nvreg_cell = heap_alloc(8);
        native_write_i64(g_boot_nvreg_cell, 0, 16);
    end
    let r = native_read_i64(g_boot_nvreg_cell, 0);
    native_write_i64(g_boot_nvreg_cell, 0, r + 1);
    out r;
end.

func boot_reset_vregs:
    extern func native_write_i64(addr: int, offset: int, val: int);
    if g_boot_nvreg_cell == 0 do
        g_boot_nvreg_cell = heap_alloc(8);
    end
    native_write_i64(g_boot_nvreg_cell, 0, 16);
end.

func fresh_label:
    in(ctx: LowerCtx)
    l = ctx.label_counter;
    ctx.label_counter = ctx.label_counter + 1;
    out l;
end.

func lower_error:
    in(ctx: LowerCtx, msg: string)
    ctx.last_error = msg;
    ctx.error_count = ctx.error_count + 1;
    out 0;
end.

func ir_emit:
    in(ctx: LowerCtx, instr: QInstr)
    # LowerCtx is a heap pointer mutated in place. Do not reassign
    # `ctx = ir_emit(...)` — entity return/assign is unreliable on the
    # C-core VM for large call frames (corrupts caller locals).
    let fidx = g_boot_cur_func_idx;
    if fidx < 0 do
        fidx = ctx.current_func_idx;
    end
    if fidx >= 0 do
        let funcs = g_mod_funcs_acc;
        if funcs == 0 do
            funcs = ctx.mod_obj.functions;
        end
        f = vec_get_rt(funcs, fidx);
        f = q_func_emit(f, instr);
        vec_set_rt(funcs, fidx, f);
        g_mod_funcs_acc = funcs;
    end
    out 0;
end.

func find_func_index:
    in(ctx: LowerCtx, name: string)
    let funcs = g_mod_funcs_acc;
    if funcs == 0 do
        funcs = ctx.mod_obj.functions;
    end
    i = 0;
    when i < vec_len_rt(funcs) loop
        f = vec_get_rt(funcs, i);
        if str_eq(f.name, name) do
            out i as int;
        end
        i = i + 1;
    end
    out -1;
end.

func sym_lookup_both:
    in(ctx: LowerCtx, name: string)
    # Returns: 0=local, 1=global, -1=not found; and the vreg/index
    var (found, vreg) = sym_lookup(ctx.symbols, name);
    if found do
        out (0, vreg);
    end
    var (found2, idx) = sym_lookup(ctx.global_symbols, name);
    if found2 do
        out (1, idx);
    end
    out (-1, 0);
end.


# ═══════════════════════════════════════════════════════
# Expression Lowering
# ═══════════════════════════════════════════════════════

func lower_expr:
    in(ctx: LowerCtx, expr: AstNode)
    if expr.node_type == AstType.LiteralInt do
        r = fresh_vreg(ctx);
        if g_boot_flat_active != 0 do
            boot_set_imm(expr.int_val);
            boot_ir_load_imm(r);
        end
        if boot_bd_dump_on() != 0 do
            boot_bd_push_load(r, expr.int_val);
        end
        out r as int;
    end

    if expr.node_type == AstType.LiteralFloat do
        r = fresh_vreg(ctx);
        ir_emit(ctx, q_instr(QOp.Load, q_vreg(r), q_imm(expr.float_val as int), q_none()));
        out r as int;
    end

    if expr.node_type == AstType.LiteralStr do
        strings = g_mod_strings_acc;
        if strings == 0 do
            strings = ctx.mod_obj.strings;
        end
        str_idx = -1;
        si = 0;
        when si < vec_len_rt(strings) and str_idx < 0 loop
            if str_eq(vec_get_rt(strings, si), expr.name) do
                str_idx = si;
            end
            si = si + 1;
        end
        if str_idx < 0 do
            strings = vec_push_rt(strings, expr.name);
            g_mod_strings_acc = strings;
            str_idx = vec_len_rt(strings) - 1;
        end
        r = fresh_vreg(ctx);
        ir_emit(ctx, q_instr(QOp.Load, q_vreg(r), q_str_ref(str_idx), q_none()));
        out r as int;
    end

    if expr.node_type == AstType.Identifier do
        var (scope, idx) = sym_lookup_both(ctx, expr.name);
        if scope < 0 do
            # AstNode.name reads are unreliable on C VM — single-param fallback
            # for small multi-fn smoke (e.g. bump(v) → out v + 1).
            if g_boot_small_multi != 0 and g_boot_param_nlocal == 1 do
                out g_boot_param_v0;
            end
            # Check if it's a function name used as a value
            fidx = find_func_index(ctx, expr.name);
            if fidx >= 0 do
                rd = fresh_vreg(ctx);
                ir_emit(ctx, q_instr(QOp.LoadFuncAddr, q_vreg(rd), q_func_idx(fidx as int), q_none()));
                out rd as int;
            end
            lower_error(ctx, str_concat(str_new("undefined variable: "), expr.name));
            out -1;
        end
        if scope == 1 do
            rd = fresh_vreg(ctx);
            ir_emit(ctx, q_instr(QOp.LoadGlobal, q_vreg(rd), q_imm(idx as int), q_none()));
            out rd as int;
        end
        out idx as int;
    end

    if expr.node_type == AstType.BinOp do
        lhs = 0 - 1;
        rhs = 0 - 1;
        let bln0 = boot_get_binop_lhs();
        let brn0 = boot_get_binop_rhs();
        if bln0 != 0 do
            let pv0 = boot_vmap_get(bln0);
            if pv0 < 0 do
                var (bs0, bi0) = sym_lookup_both(ctx, bln0);
                if bs0 >= 0 do
                    pv0 = bi0 as int;
                end
            end
            if pv0 >= 0 do
                lhs = pv0;
            end
        end
        if brn0 != 0 do
            let pv1 = boot_vmap_get(brn0);
            if pv1 < 0 do
                var (bs1, bi1) = sym_lookup_both(ctx, brn0);
                if bs1 >= 0 do
                    pv1 = bi1 as int;
                end
            end
            if pv1 >= 0 do
                rhs = pv1;
            end
        end
        if lhs < 0 do
            lhs = lower_expr(ctx, vec_get_rt(expr.children, 0));
        end
        if rhs < 0 do
            rhs = lower_expr(ctx, vec_get_rt(expr.children, 1));
        end
        if lhs < 0 do
            out -1;
        end
        if rhs < 0 do
            out -1;
        end
        rd = fresh_vreg(ctx);
        # Prefer int_val stash (set at parse); AstNode.op is unreliable on C VM.
        # Write QOp codes via g_st_opc — local `op` enum gets clobbered on C VM.
        let raw_op = expr.int_val;
        g_st_opc = 3;
        if raw_op == 1 do
            g_st_opc = 4;
        end
        if raw_op == 2 do
            g_st_opc = 5;
        end
        if raw_op == 3 do
            g_st_opc = 6;
        end
        if raw_op == 4 do
            g_st_opc = 7;
        end
        op = QOp.Add;
        if g_st_opc == 4 do
            op = QOp.Sub;
        end
        if g_st_opc == 5 do
            op = QOp.Mul;
        end
        if g_st_opc == 6 do
            op = QOp.Div;
        end
        if g_st_opc == 7 do
            op = QOp.Mod;
        end
        if g_boot_flat_active != 0 do
            if g_st_opc >= 3 and g_st_opc <= 7 do
                boot_set_dv(rd);
                boot_set_s1v(lhs as int);
                boot_set_s2v(rhs as int);
                boot_ir_binop();
            end
        end
        if boot_bd_dump_on() != 0 do
            if g_st_opc >= 3 and g_st_opc <= 7 do
                extern func native_write_i64(addr: int, offset: int, val: int);
                if g_boot_name_cell == 0 do
                    boot_name_cell_init();
                end
                native_write_i64(g_boot_name_cell, 128, g_st_opc);
                boot_bd_push_binop(rd, lhs as int, rhs as int);
            end
        end
        ir_emit(ctx, q_instr(op, q_vreg(rd), q_vreg(lhs as int), q_vreg(rhs as int)));
        out rd as int;
    end

    if expr.node_type == AstType.Compare do
        lhs = lower_expr(ctx, vec_get_rt(expr.children, 0));
        if lhs < 0 do
            out -1;
        end
        rhs = lower_expr(ctx, vec_get_rt(expr.children, 1));
        if rhs < 0 do
            out -1;
        end
        rd = fresh_vreg(ctx);

        if expr.op == OpType::Ne do
            # NE = XOR(EQ(lhs, rhs), 1)
            eq_r = fresh_vreg(ctx);
            one_r = fresh_vreg(ctx);
            ir_emit(ctx, q_instr(QOp.CmpEq, q_vreg(eq_r), q_vreg(lhs as int), q_vreg(rhs as int)));
            ir_emit(ctx, q_instr(QOp.Load, q_vreg(one_r), q_imm(1), q_none()));
            ir_emit(ctx, q_instr(QOp.Xor, q_vreg(rd), q_vreg(eq_r), q_vreg(one_r)));
            out rd as int;
        end

        cmp_op = QOp.CmpEq;
        if expr.op == OpType::Gt do
            cmp_op = QOp.CmpGt;
        end
        if expr.op == OpType::Lt do
            cmp_op = QOp.CmpLt;
        end
        if expr.op == OpType::Ge do
            cmp_op = QOp.CmpGe;
        end
        if expr.op == OpType::Le do
            cmp_op = QOp.CmpLe;
        end
        ir_emit(ctx, q_instr(cmp_op, q_vreg(rd), q_vreg(lhs as int), q_vreg(rhs as int)));
        out rd as int;
    end

    if expr.node_type == AstType.Call do
        # Native memory intrinsics can appear as inline externs inside funcs;
        # they are not always present in the top-level function table during
        # bootstrap lowering. Lower them directly to Q-IR memory ops.
        if str_eq(expr.name, "native_read_u8") do
            a0 = lower_expr(ctx, vec_get_rt(expr.children, 0));
            a1 = lower_expr(ctx, vec_get_rt(expr.children, 1));
            if a0 < 0 or a1 < 0 do
                out -1;
            end
            rd = fresh_vreg(ctx);
            ir_emit(ctx, q_instr(QOp.LoadByte, q_vreg(rd), q_vreg(a0 as int), q_vreg(a1 as int)));
            out rd as int;
        end
        if str_eq(expr.name, "native_write_u8") do
            a0 = lower_expr(ctx, vec_get_rt(expr.children, 0));
            a1 = lower_expr(ctx, vec_get_rt(expr.children, 1));
            a2 = lower_expr(ctx, vec_get_rt(expr.children, 2));
            if a0 < 0 or a1 < 0 or a2 < 0 do
                out -1;
            end
            ir_emit(ctx, q_instr(QOp.StoreByte, q_vreg(a2 as int), q_vreg(a0 as int), q_vreg(a1 as int)));
            out 0;
        end
        if str_eq(expr.name, "native_read_i64") do
            a0 = lower_expr(ctx, vec_get_rt(expr.children, 0));
            a1 = lower_expr(ctx, vec_get_rt(expr.children, 1));
            if a0 < 0 or a1 < 0 do
                out -1;
            end
            rd = fresh_vreg(ctx);
            ir_emit(ctx, q_instr(QOp.LoadWord, q_vreg(rd), q_vreg(a0 as int), q_vreg(a1 as int)));
            out rd as int;
        end
        if str_eq(expr.name, "native_write_i64") do
            a0 = lower_expr(ctx, vec_get_rt(expr.children, 0));
            a1 = lower_expr(ctx, vec_get_rt(expr.children, 1));
            a2 = lower_expr(ctx, vec_get_rt(expr.children, 2));
            if a0 < 0 or a1 < 0 or a2 < 0 do
                out -1;
            end
            ir_emit(ctx, q_instr(QOp.StoreWord, q_vreg(a2 as int), q_vreg(a0 as int), q_vreg(a1 as int)));
            out 0;
        end
        fidx = find_func_index(ctx, expr.name);
        is_indirect = 0;
        indirect_vreg = -1;
        if fidx < 0 do
            # Check if it's an indirect call through a variable
            var (scope, varvreg) = sym_lookup_both(ctx, expr.name);
            if scope < 0 do
                lower_error(ctx, str_concat(str_new("undefined function: "), expr.name));
                rd = fresh_vreg(ctx);
                ir_emit(ctx, q_instr(QOp.Load, q_vreg(rd), q_imm(0), q_none()));
                out rd as int;
            end
            is_indirect = 1;
            indirect_vreg = varvreg as int;
            if scope == 1 do
                grd = fresh_vreg(ctx);
                ir_emit(ctx, q_instr(QOp.LoadGlobal, q_vreg(grd), q_imm(varvreg as int), q_none()));
                # (in-place ctx)
                indirect_vreg = grd as int;
            end
        end

        # Evaluate arguments
        arg_vregs = vec_new_rt();
        i = 0;
        when i < vec_len_rt(expr.children) loop
            av = lower_expr(ctx, vec_get_rt(expr.children, i));
            # (in-place ctx)
            if av < 0 do
                out -1;
            end
            arg_vregs = vec_push_rt(arg_vregs, av);
            i = i + 1;
        end

        # Move arguments to ABI registers x0..x7
        i = 0;
        when i < vec_len_rt(arg_vregs) loop
            av = vec_get_rt(arg_vregs, i);
            ir_emit(ctx, q_instr(QOp.SetArg, q_imm(i as int), q_vreg(av as int), q_none()));
            if boot_bd_dump_on() != 0 do
                boot_bd_push_setarg(i as int, av as int);
            end
            i = i + 1;
        end

        # Emit call with dest = result vreg
        rd = fresh_vreg(ctx);
        if is_indirect == 1 do
            ir_emit(ctx, q_instr(QOp.CallFunc, q_vreg(rd), q_vreg(indirect_vreg), q_none()));
            out rd as int;
        end
        ir_emit(ctx, q_instr(QOp.CallFunc, q_vreg(rd), q_func_idx(fidx as int), q_none()));
        if boot_bd_dump_on() != 0 do
            boot_bd_push_call(rd, fidx as int);
        end
        out rd as int;
    end

    if expr.node_type == AstType.BuiltinCall do
        bid = expr.builtin_id;
        # Evaluate arguments
        arg_vregs = vec_new_rt();
        i = 0;
        when i < vec_len_rt(expr.children) loop
            av = lower_expr(ctx, vec_get_rt(expr.children, i));
            # (in-place ctx)
            arg_vregs = vec_push_rt(arg_vregs, av);
            i = i + 1;
        end

        nargs = vec_len_rt(expr.children);
        a0 = -1;
        a1 = -1;
        a2 = -1;
        if nargs > 0 do
            a0 = vec_get_rt(arg_vregs, 0);
        end
        if nargs > 1 do
            a1 = vec_get_rt(arg_vregs, 1);
        end
        if nargs > 2 do
            a2 = vec_get_rt(arg_vregs, 2);
        end

        # BuiltinId values: None=0 Len=1 Push=2 Alloc=3 FreeMem=4
        # Read8=5 Write8=6 Read64=7 Write64=8 StrLen=9 StrGet=10
        # StrCat=11 StrEq=12 FileOpen=13 FileRead=14 FileWrite=15
        # FileClose=16 FileWriteByte=17 Exit=18 IToStr=19 StrToI=20
        # ArrNew=21 PrintStr=22 GetArg=23 ArgCount=24

        # ArrNew(21): 0-1 args → new array with capacity
        if bid == 21 do
            if nargs == 0 do
                cr = fresh_vreg(ctx);
                # (in-place ctx)
                ir_emit(ctx, q_instr(QOp.Load, q_vreg(cr), q_imm(16), q_none()));
                a0 = cr;
            end
            rd = fresh_vreg(ctx);
            ir_emit(ctx, q_instr(QOp.ArrNew, q_vreg(rd), q_vreg(a0 as int), q_none()));
            out rd as int;
        end

        # Push(2): 2 args → arr_push(arr, elem)
        if bid == 2 do
            ir_emit(ctx, q_instr(QOp.ArrPush, q_none(), q_vreg(a0 as int), q_vreg(a1 as int)));
            out a0;
        end

        # Len(1): 1 arg → arr_len(arr)
        if bid == 1 do
            rd = fresh_vreg(ctx);
            ir_emit(ctx, q_instr(QOp.ArrLen, q_vreg(rd), q_vreg(a0 as int), q_none()));
            out rd as int;
        end

        # Alloc(3): 1 arg → bump alloc
        if bid == 3 do
            rd = fresh_vreg(ctx);
            ir_emit(ctx, q_instr(QOp.Alloc, q_vreg(rd), q_vreg(a0 as int), q_none()));
            out rd as int;
        end

        # Read64(7): 2 args → load_word(ptr, off)
        if bid == 7 do
            rd = fresh_vreg(ctx);
            ir_emit(ctx, q_instr(QOp.LoadWord, q_vreg(rd), q_vreg(a0 as int), q_vreg(a1 as int)));
            out rd as int;
        end

        # Write64(8): 3 args → store_word(ptr, off, val)
        if bid == 8 do
            ir_emit(ctx, q_instr(QOp.StoreWord, q_vreg(a2 as int), q_vreg(a0 as int), q_vreg(a1 as int)));
            out 0;
        end

        # Read8(5): 2 args → load_byte(ptr, off)
        if bid == 5 do
            rd = fresh_vreg(ctx);
            ir_emit(ctx, q_instr(QOp.LoadByte, q_vreg(rd), q_vreg(a0 as int), q_vreg(a1 as int)));
            out rd as int;
        end

        # Write8(6): 3 args → store_byte(ptr, off, val)
        if bid == 6 do
            ir_emit(ctx, q_instr(QOp.StoreByte, q_vreg(a2 as int), q_vreg(a0 as int), q_vreg(a1 as int)));
            out 0;
        end

        # StrCat(11): 2 args → str_cat(s1, s2)
        if bid == 11 do
            rd = fresh_vreg(ctx);
            ir_emit(ctx, q_instr(QOp.StrCat, q_vreg(rd), q_vreg(a0 as int), q_vreg(a1 as int)));
            out rd as int;
        end

        # StrLen(9): 1 arg → str_len(s)
        if bid == 9 do
            rd = fresh_vreg(ctx);
            ir_emit(ctx, q_instr(QOp.StrLenOp, q_vreg(rd), q_vreg(a0 as int), q_none()));
            out rd as int;
        end

        # StrEq(12): 2 args → str_eq(s1, s2)
        if bid == 12 do
            rd = fresh_vreg(ctx);
            ir_emit(ctx, q_instr(QOp.StrEq, q_vreg(rd), q_vreg(a0 as int), q_vreg(a1 as int)));
            out rd as int;
        end

        # StrGet(10): 2 args → str_get(s, idx)
        if bid == 10 do
            rd = fresh_vreg(ctx);
            ir_emit(ctx, q_instr(QOp.StrGet, q_vreg(rd), q_vreg(a0 as int), q_vreg(a1 as int)));
            out rd as int;
        end

        # PrintStr(22): 1 arg → print string
        if bid == 22 do
            ir_emit(ctx, q_instr(QOp.PrintStr, q_vreg(a0 as int), q_none(), q_none()));
            out 0;
        end

        # Exit(18): 1 arg → exit(code)
        if bid == 18 do
            ir_emit(ctx, q_instr(QOp.Exit, q_none(), q_vreg(a0 as int), q_none()));
            out 0;
        end

        # IToStr(19): 1 arg → int_to_str(n)
        if bid == 19 do
            rd = fresh_vreg(ctx);
            ir_emit(ctx, q_instr(QOp.IToStr, q_vreg(rd), q_vreg(a0 as int), q_none()));
            out rd as int;
        end

        # StrToI(20): 1 arg → str_to_int(s)
        if bid == 20 do
            rd = fresh_vreg(ctx);
            ir_emit(ctx, q_instr(QOp.StrToI, q_vreg(rd), q_vreg(a0 as int), q_none()));
            out rd as int;
        end

        # FreeMem(4): 1 arg → dealloc(ptr)
        if bid == 4 do
            ir_emit(ctx, q_instr(QOp.Free, q_none(), q_vreg(a0 as int), q_none()));
            out 0;
        end

        # GetArg(23): 1 arg → get_arg(idx)
        if bid == 23 do
            rd = fresh_vreg(ctx);
            ir_emit(ctx, q_instr(QOp.GetArg, q_vreg(rd), q_vreg(a0 as int), q_none()));
            out rd as int;
        end

        # ArgCount(24): 0 args → arg_count()
        if bid == 24 do
            rd = fresh_vreg(ctx);
            ir_emit(ctx, q_instr(QOp.ArgCount, q_vreg(rd), q_none(), q_none()));
            out rd as int;
        end

        # File I/O
        if bid == 13 do
            rd = fresh_vreg(ctx);
            ir_emit(ctx, q_instr(QOp.FileOpen, q_vreg(rd), q_vreg(a0 as int), q_vreg(a1 as int)));
            out rd as int;
        end
        if bid == 14 do
            rd = fresh_vreg(ctx);
            ir_emit(ctx, q_instr(QOp.FileRead, q_vreg(rd), q_vreg(a0 as int), q_vreg(a1 as int)));
            out rd as int;
        end
        if bid == 15 do
            rd = fresh_vreg(ctx);
            ir_emit(ctx, q_instr(QOp.FileWrite, q_vreg(rd), q_vreg(a0 as int), q_vreg(a1 as int)));
            out rd as int;
        end
        if bid == 16 do
            ir_emit(ctx, q_instr(QOp.FileClose, q_none(), q_vreg(a0 as int), q_none()));
            out 0;
        end
        if bid == 17 do
            ir_emit(ctx, q_instr(QOp.FileWriteByte, q_none(), q_vreg(a0 as int), q_vreg(a1 as int)));
            out 0;
        end

        lower_error(ctx, str_new("unknown builtin"));
        out -1;
    end

    if expr.node_type == AstType.InputExpr do
        rd = fresh_vreg(ctx);
        ir_emit(ctx, q_instr(QOp.Input, q_vreg(rd), q_none(), q_none()));
        out rd as int;
    end

    if expr.node_type == AstType.ArrayLiteral do
        cap_r = fresh_vreg(ctx);
        arr_r = fresh_vreg(ctx);
        n = vec_len_rt(expr.children) as int;
        cap = n;
        if cap < 16 do
            cap = 16;
        end
        ir_emit(ctx, q_instr(QOp.Load, q_vreg(cap_r), q_imm(cap), q_none()));
        ir_emit(ctx, q_instr(QOp.ArrNew, q_vreg(arr_r), q_vreg(cap_r), q_none()));
        i = 0;
        when i < vec_len_rt(expr.children) loop
            elem = lower_expr(ctx, vec_get_rt(expr.children, i));
            # (in-place ctx)
            if elem >= 0 do
                ir_emit(ctx, q_instr(QOp.ArrPush, q_none(), q_vreg(arr_r), q_vreg(elem as int)));
            end
            i = i + 1;
        end
        out arr_r as int;
    end

    if expr.node_type == AstType.IndexAccess do
        var (scope, arr_idx) = sym_lookup_both(ctx, expr.name);
        if scope < 0 do
            lower_error(ctx, str_new("undefined variable for index"));
            out -1;
        end
        arr_vreg = arr_idx;
        if scope == 1 do
            gv = fresh_vreg(ctx);
            # (in-place ctx)
            ir_emit(ctx, q_instr(QOp.LoadGlobal, q_vreg(gv), q_imm(arr_idx as int), q_none()));
            arr_vreg = gv;
        end
        idx_v = lower_expr(ctx, vec_get_rt(expr.children, 0));
        if idx_v < 0 do
            out -1;
        end
        rd = fresh_vreg(ctx);
        ir_emit(ctx, q_instr(QOp.ArrGet, q_vreg(rd), q_vreg(arr_vreg), q_vreg(idx_v as int)));
        out rd as int;
    end

    if expr.node_type == AstType.FieldAccess do
        # Check for enum access first
        base = vec_get_rt(expr.children, 0);
        if base.node_type == AstType.Identifier do
            var (found, eidx) = find_enum_type(ctx.enum_types, base.name);
            if found do
                et = vec_get_rt(ctx.enum_types, eidx);
                var (ok, val) = enum_lookup_variant(et, expr.name);
                if ok do
                    r = fresh_vreg(ctx);
                    ir_emit(ctx, q_instr(QOp.Load, q_vreg(r), q_imm(val), q_none()));
                    out r as int;
                end
                lower_error(ctx, str_concat(str_new("unknown variant: "), expr.name));
                out -1;
            end
        end

        # Entity field access
        base_r = lower_expr(ctx, vec_get_rt(expr.children, 0));
        if base_r < 0 do
            out -1;
        end

        # Tuple numeric field: .0 / .1 → byte offset index*8
        offset = -1;
        if rt_strlen(expr.name) > 0 do
            let c0 = str_get(expr.name, 0);
            if c0 >= 48 and c0 <= 57 do
                offset = str_to_i64(expr.name) * 8;
            end
        end

        # Search entity types for field offset
        j = 0;
        when j < vec_len_rt(ctx.ent_names) and offset < 0 loop
            var (ok, off) = ent_field_offset_flat(ctx.ent_field_names, ctx.ent_field_offsets, ctx.ent_field_counts, j, expr.name);
            if ok do
                offset = off;
            end
            j = j + 1;
        end

        if offset < 0 do
            lower_error(ctx, str_concat(str_new("unknown field: "), expr.name));
            out -1;
        end

        off_r = fresh_vreg(ctx);
        rd = fresh_vreg(ctx);
        ir_emit(ctx, q_instr(QOp.Load, q_vreg(off_r), q_imm(offset as int), q_none()));
        ir_emit(ctx, q_instr(QOp.LoadWord, q_vreg(rd), q_vreg(base_r as int), q_vreg(off_r)));
        out rd as int;
    end

    if expr.node_type == AstType.EntityLiteral do
        var (found, eidx) = find_ent_flat(ctx.ent_names, expr.name);
        if not found do
            lower_error(ctx, str_concat(str_new("undefined entity: "), expr.name));
            out -1;
        end
        sz_r = fresh_vreg(ctx);
        ptr_r = fresh_vreg(ctx);
        sz = ent_field_count_flat(ctx.ent_field_counts, eidx) * 8;
        ir_emit(ctx, q_instr(QOp.Load, q_vreg(sz_r), q_imm(sz), q_none()));
        ir_emit(ctx, q_instr(QOp.Alloc, q_vreg(ptr_r), q_vreg(sz_r), q_none()));

        i = 0;
        when i < vec_len_rt(expr.children) loop
            child = vec_get_rt(expr.children, i);
            var (ok, foff) = ent_field_offset_flat(ctx.ent_field_names, ctx.ent_field_offsets, ctx.ent_field_counts, eidx, child.name2);
            if ok do
                val_r = lower_expr(ctx, child);
                # (in-place ctx)
                if val_r >= 0 do
                    off_r = fresh_vreg(ctx);
                    # (in-place ctx)
                    ir_emit(ctx, q_instr(QOp.Load, q_vreg(off_r), q_imm(foff), q_none()));
                    ir_emit(ctx, q_instr(QOp.StoreWord, q_vreg(val_r as int), q_vreg(ptr_r), q_vreg(off_r)));
                end
            end
            i = i + 1;
        end
        out ptr_r as int;
    end

    lower_error(ctx, str_new("unsupported expression type"));
    out -1;end.


# ═══════════════════════════════════════════════════════
# Statement Lowering
# ═══════════════════════════════════════════════════════

func lower_stmt:
    in(ctx: LowerCtx, stmt: AstNode)

    let ls_type = stmt.node_type as int;
    # Guard: corrupted AST node (entity field clobber) often yields huge/negative types
    if ls_type < 0 or ls_type > 200 do
        print_str("lower_stmt: BAD node_type=");
        print_int(ls_type);
        print_ln("");
        sys_exit(1);
    end

    # Standalone function call (expression statement) — must be FIRST
    # because later handlers (find_func_index etc.) can corrupt stmt via C VM
    if ls_type == 36 do
        _ = lower_expr(ctx, stmt);
        out 0;
    end

    # Handle BuiltinCall as expression statement
    if stmt.node_type == 37 do
        if ls_type == 36 do
            print(1037);
        end
        _ = lower_expr(ctx, stmt);
        out 0;
    end

    if stmt.node_type == AstType.VarDecl or stmt.node_type == AstType.ConstDecl do
        # Tuple destructuring: children = [Ident, Ident, ..., init]
        # Flagled by int_val bit 0x4000 (16384).
        if (stmt.int_val & 16384) != 0 do
            nch = vec_len_rt(stmt.children);
            if nch < 1 do
                out 0;
            end
            init = vec_get_rt(stmt.children, nch - 1);
            expr_v = lower_expr(ctx, init);
            if expr_v < 0 do
                out 0;
            end
            i = 0;
            when i < nch - 1 loop
                ident = vec_get_rt(stmt.children, i);
                if not str_eq(ident.name, "_") do
                    r = fresh_vreg(ctx);
                    # (in-place ctx)
                    ctx.symbols = sym_define(ctx.symbols, ident.name, r);
                    idx_r = fresh_vreg(ctx);
                    # (in-place ctx)
                    boot_set_imm(i);
                    boot_ir_load_imm(idx_r);
                    ir_emit(ctx, q_instr(QOp.ArrGet, q_vreg(r), q_vreg(expr_v as int), q_vreg(idx_r)));
                end
                i = i + 1;
            end
            out 0;
        end
        r = fresh_vreg(ctx);
        let vname = stmt.name;
        let vn2 = boot_get_var_name();
        if vn2 != 0 do
            vname = vn2;
        end
        ctx.symbols = sym_define(ctx.symbols, vname, r);
        boot_set_last_vreg(r);
        if vname != 0 do
            boot_vmap_put(vname, r);
        end
        let icur = boot_get_init_const();
        if icur >= 0 do
            boot_set_imm(icur);
            boot_ir_load_imm(r);
            if boot_bd_dump_on() != 0 do
                boot_bd_push_load(r, icur);
            end
            boot_set_init_const(0 - 1);
            out 0;
        end
        if vec_len_rt(stmt.children) > 0 do
            val = lower_expr(ctx, vec_get_rt(stmt.children, 0));
            if val >= 0 and (val as u32) != r do
                boot_set_dv(r);
                boot_set_s1v(val as int);
                boot_ir_move();
                if boot_bd_dump_on() != 0 do
                    boot_bd_push_move(r, val as int);
                end
            else
                if val >= 0 do
                    boot_set_last_vreg(val as int);
                    if vname != 0 do
                        boot_vmap_put(vname, val as int);
                    end
                end
            end
            out 0;
        else
            boot_set_imm(0);
            boot_ir_load_imm(r);
            if boot_bd_dump_on() != 0 do
                boot_bd_push_load(r, 0);
            end
            out 0;
        end
        out 0;
    end

    if stmt.node_type == AstType.Assign do
        var (scope, idx) = sym_lookup_both(ctx, stmt.name);
        if scope < 0 do
            lower_error(ctx, str_concat(str_new("assign to undefined: "), stmt.name));
            out 0;
        end
        val = lower_expr(ctx, vec_get_rt(stmt.children, 0));
        if val < 0 do
            out 0;
        end
        if scope == 1 do
            ir_emit(ctx, q_instr(QOp.StoreGlobal, q_none(), q_imm(idx as int), q_vreg(val as int)));
        else
            if (val as u32) != idx do
                ir_emit(ctx, q_instr(QOp.Move, q_vreg(idx), q_vreg(val as int), q_none()));
            end
        end
        out 0;
    end

    if stmt.node_type == AstType.IndexAssign do
        var (scope, arr_idx) = sym_lookup_both(ctx, stmt.name);
        if scope < 0 do
            lower_error(ctx, str_new("index assign to undefined variable"));
            out 0;
        end
        arr_vreg = arr_idx;
        if scope == 1 do
            gv = fresh_vreg(ctx);
            # (in-place ctx)
            ir_emit(ctx, q_instr(QOp.LoadGlobal, q_vreg(gv), q_imm(arr_idx as int), q_none()));
            arr_vreg = gv;
        end
        idx_v = lower_expr(ctx, vec_get_rt(stmt.children, 0));
        val_v = lower_expr(ctx, vec_get_rt(stmt.children, 1));
        if idx_v >= 0 and val_v >= 0 do
            ir_emit(ctx, q_instr(QOp.ArrSet, q_vreg(val_v as int), q_vreg(arr_vreg), q_vreg(idx_v as int)));
        end
        out 0;
    end

    if stmt.node_type == AstType.PrintStmt or ls_type == 13 do
        child = vec_get_rt(stmt.children, 0);
        if child.node_type == AstType.LiteralStr do
            var (mod2, str_idx) = q_module_add_string(ctx.mod_obj, child.name);
            ctx.mod_obj = mod2;
            ir_emit(ctx, q_instr(QOp.PrintStr, q_none(), q_str_ref(str_idx), q_none()));
            out 0;
        end
        if child.node_type == AstType.LiteralInt do
            boot_ir_print_imm(child.int_val);
            if boot_bd_dump_on() != 0 do
                let pr = fresh_vreg(ctx);
                boot_bd_push_load(pr, child.int_val);
                boot_bd_push_print(pr);
            end
            out 0;
        end
        let pn = boot_get_print_name();
        if pn != 0 do
            let pv = boot_vmap_get(pn);
            if pv < 0 do
                var (pscope, pidx) = sym_lookup_both(ctx, pn);
                if pscope >= 0 do
                    pv = pidx as int;
                end
            end
            if pv >= 0 do
                boot_set_s1v(pv);
                boot_ir_print();
                if boot_bd_dump_on() != 0 do
                    boot_bd_push_print(pv);
                end
                out 0;
            end
        end
        if boot_bd_dump_on() != 0 do
            val = lower_expr(ctx, child);
            if val < 0 and pn != 0 do
                var (pscope2, pidx2) = sym_lookup_both(ctx, pn);
                if pscope2 >= 0 do
                    val = pidx2 as int;
                end
            end
            if val >= 0 do
                boot_bd_push_print(val as int);
            end
            out 0;
        end
        let lv = boot_get_last_vreg();
        if lv >= 0 do
            boot_set_s1v(lv);
            boot_ir_print();
            out 0;
        end
        val = lower_expr(ctx, child);
        if val >= 0 do
            boot_set_s1v(val as int);
            boot_ir_print();
        end
        out 0;
    end

    if stmt.node_type == AstType.ReturnStmt do
        if vec_len_rt(stmt.children) > 0 do
            val = lower_expr(ctx, vec_get_rt(stmt.children, 0));
            if val >= 0 do
                boot_set_s1v(val as int);
                boot_ir_ret();
                if boot_bd_dump_on() != 0 do
                    boot_bd_push_ret(val as int);
                end
            end
            out 0;
        else
            boot_ir_ret_imm(0);
            if boot_bd_dump_on() != 0 do
                boot_bd_push_ret_imm(0);
            end
            out 0;
        end
    end

    if stmt.node_type == AstType.IfStmt do
        cond_r = lower_expr(ctx, vec_get_rt(stmt.children, 0));
        if cond_r < 0 do
            out 0;
        end
        else_lbl = fresh_label(ctx);
        end_lbl = fresh_label(ctx);

        ir_emit(ctx, q_instr(QOp.JumpIfNot, q_none(), q_vreg(cond_r as int), q_label(else_lbl)));

        # Then block
        lower_stmt(ctx, vec_get_rt(stmt.children, 1));

        if vec_len_rt(stmt.children) > 2 do
            ir_emit(ctx, q_instr(QOp.Jump, q_none(), q_label(end_lbl), q_none()));
        end

        # Else label
        ir_emit(ctx, q_instr(QOp.Label, q_label(else_lbl), q_none(), q_none()));

        # Else block
        if vec_len_rt(stmt.children) > 2 do
            lower_stmt(ctx, vec_get_rt(stmt.children, 2));
            ir_emit(ctx, q_instr(QOp.Label, q_label(end_lbl), q_none(), q_none()));
        end
        out 0;
    end

    if stmt.node_type == AstType.WhileStmt do
        loop_lbl = fresh_label(ctx);
        end_lbl = fresh_label(ctx);

        ir_emit(ctx, q_instr(QOp.Label, q_label(loop_lbl), q_none(), q_none()));

        cond_r = lower_expr(ctx, vec_get_rt(stmt.children, 0));
        if cond_r < 0 do
            out 0;
        end
        ir_emit(ctx, q_instr(QOp.JumpIfNot, q_none(), q_vreg(cond_r as int), q_label(end_lbl)));

        # Push loop labels
        ctx.loop_start_labels = vec_push_rt(ctx.loop_start_labels, loop_lbl);
        ctx.loop_end_labels = vec_push_rt(ctx.loop_end_labels, end_lbl);
        ctx.loop_depth = ctx.loop_depth + 1;

        lower_stmt(ctx, vec_get_rt(stmt.children, 1));

        ctx.loop_depth = ctx.loop_depth - 1;

        ir_emit(ctx, q_instr(QOp.Jump, q_none(), q_label(loop_lbl), q_none()));

        ir_emit(ctx, q_instr(QOp.Label, q_label(end_lbl), q_none(), q_none()));
        out 0;
    end

    if stmt.node_type == AstType.LoopStmt do
        # Counter-based loop
        counter = fresh_vreg(ctx);
        ir_emit(ctx, q_instr(QOp.Load, q_vreg(counter), q_imm(0), q_none()));

        limit_r = lower_expr(ctx, vec_get_rt(stmt.children, 0));
        if limit_r < 0 do
            out 0;
        end

        loop_lbl = fresh_label(ctx);
        cont_lbl = fresh_label(ctx);
        end_lbl = fresh_label(ctx);

        ir_emit(ctx, q_instr(QOp.Label, q_label(loop_lbl), q_none(), q_none()));

        cmp_r = fresh_vreg(ctx);
        ir_emit(ctx, q_instr(QOp.CmpLt, q_vreg(cmp_r), q_vreg(counter), q_vreg(limit_r as int)));
        ir_emit(ctx, q_instr(QOp.JumpIfNot, q_none(), q_vreg(cmp_r), q_label(end_lbl)));

        ctx.loop_start_labels = vec_push_rt(ctx.loop_start_labels, cont_lbl);
        ctx.loop_end_labels = vec_push_rt(ctx.loop_end_labels, end_lbl);
        ctx.loop_depth = ctx.loop_depth + 1;

        lower_stmt(ctx, vec_get_rt(stmt.children, 1));

        ctx.loop_depth = ctx.loop_depth - 1;

        ir_emit(ctx, q_instr(QOp.Label, q_label(cont_lbl), q_none(), q_none()));
        one_r = fresh_vreg(ctx);
        ir_emit(ctx, q_instr(QOp.Load, q_vreg(one_r), q_imm(1), q_none()));
        ir_emit(ctx, q_instr(QOp.Add, q_vreg(counter), q_vreg(counter), q_vreg(one_r)));
        ir_emit(ctx, q_instr(QOp.Jump, q_none(), q_label(loop_lbl), q_none()));

        ir_emit(ctx, q_instr(QOp.Label, q_label(end_lbl), q_none(), q_none()));
        out 0;
    end

    if stmt.node_type == AstType.ForRange do
        start_v = lower_expr(ctx, vec_get_rt(stmt.children, 0));
        if start_v < 0 do
            out 0;
        end
        end_v = lower_expr(ctx, vec_get_rt(stmt.children, 1));
        if end_v < 0 do
            out 0;
        end

        loop_var = fresh_vreg(ctx);
        ctx.symbols = sym_define(ctx.symbols, stmt.name, loop_var);
        ir_emit(ctx, q_instr(QOp.Move, q_vreg(loop_var), q_vreg(start_v as int), q_none()));

        loop_lbl = fresh_label(ctx);
        end_lbl = fresh_label(ctx);
        cont_lbl = fresh_label(ctx);

        ir_emit(ctx, q_instr(QOp.Label, q_label(loop_lbl), q_none(), q_none()));

        cmp_r = fresh_vreg(ctx);
        ir_emit(ctx, q_instr(QOp.CmpLt, q_vreg(cmp_r), q_vreg(loop_var), q_vreg(end_v as int)));
        ir_emit(ctx, q_instr(QOp.JumpIfNot, q_none(), q_vreg(cmp_r), q_label(end_lbl)));

        ctx.loop_start_labels = vec_push_rt(ctx.loop_start_labels, cont_lbl);
        ctx.loop_end_labels = vec_push_rt(ctx.loop_end_labels, end_lbl);
        ctx.loop_depth = ctx.loop_depth + 1;

        lower_stmt(ctx, vec_get_rt(stmt.children, 2));

        ctx.loop_depth = ctx.loop_depth - 1;

        ir_emit(ctx, q_instr(QOp.Label, q_label(cont_lbl), q_none(), q_none()));
        one_r = fresh_vreg(ctx);
        ir_emit(ctx, q_instr(QOp.Load, q_vreg(one_r), q_imm(1), q_none()));
        ir_emit(ctx, q_instr(QOp.Add, q_vreg(loop_var), q_vreg(loop_var), q_vreg(one_r)));
        ir_emit(ctx, q_instr(QOp.Jump, q_none(), q_label(loop_lbl), q_none()));

        ir_emit(ctx, q_instr(QOp.Label, q_label(end_lbl), q_none(), q_none()));
        out 0;
    end

    if stmt.node_type == AstType.Block do
        # Prefer AST children. Optionally overlay parse-time name scratch
        # (g_boot_blk_*) when its count matches — needed because AstNode.name
        # reads are still unreliable for Identifier/VarDecl on the C VM, which
        # makes `print x` fail sym_lookup. Safe when this block is the last
        # one parsed (true for single-function programs; self-host still uses
        # children-only when counts diverge).
        extern func native_read_i64(addr: int, offset: int) -> int;
        i = 0;
        let nch = vec_len_rt(stmt.children);
        let use_blk = 0;
        if g_boot_blk_count == nch and g_boot_blk_names != 0 do
            use_blk = 1;
        end
        when i < nch loop
            boot_set_var_name(0);
            boot_set_print_name(0);
            boot_set_init_const(0 - 1);
            boot_set_binop_lhs(0);
            boot_set_binop_rhs(0);
            if use_blk == 1 do
                let bty = native_read_i64(g_boot_blk_types, i * 8);
                let bnm = native_read_i64(g_boot_blk_names, i * 8);
                let bic = native_read_i64(g_boot_blk_inits, i * 8);
                if bty == AstType.VarDecl or bty == AstType.ConstDecl do
                    boot_set_var_name(bnm);
                    boot_set_init_const(bic);
                    if g_boot_blk_lhs != 0 do
                        boot_set_binop_lhs(native_read_i64(g_boot_blk_lhs, i * 8));
                        boot_set_binop_rhs(native_read_i64(g_boot_blk_rhs, i * 8));
                    end
                end
                if bty == AstType.PrintStmt do
                    boot_set_print_name(bnm);
                end
            end
            lower_stmt(ctx, vec_get_rt(stmt.children, i));
            boot_set_var_name(0);
            boot_set_print_name(0);
            boot_set_init_const(0 - 1);
            boot_set_binop_lhs(0);
            boot_set_binop_rhs(0);
            i = i + 1;
        end
        out 0;
    end

    if stmt.node_type == AstType.BreakStmt do
        if ctx.loop_depth == 0 do
            lower_error(ctx, str_new("break outside of loop"));
            out 0;
        end
        end_lbl = vec_get_rt(ctx.loop_end_labels, (ctx.loop_depth - 1) as int);
        ir_emit(ctx, q_instr(QOp.Jump, q_none(), q_label(end_lbl), q_none()));
        out 0;
    end

    if stmt.node_type == AstType.ContinueStmt do
        if ctx.loop_depth == 0 do
            lower_error(ctx, str_new("continue outside of loop"));
            out 0;
        end
        start_lbl = vec_get_rt(ctx.loop_start_labels, (ctx.loop_depth - 1) as int);
        ir_emit(ctx, q_instr(QOp.Jump, q_none(), q_label(start_lbl), q_none()));
        out 0;
    end

    if stmt.node_type == AstType.EnumDef do
        et = EnumType ( name: stmt.name, variants: vec_new_rt() );
        i = 0;
        when i < vec_len_rt(stmt.children) loop
            v = vec_get_rt(stmt.children, i);
            et.variants = vec_push_rt(et.variants, EnumVariant ( name: v.name, value: v.int_val ));
            i = i + 1;
        end
        ctx.enum_types = vec_push_rt(ctx.enum_types, et);
        out 0;
    end

    if stmt.node_type == AstType.EntityDef do
        et = EntityType ( name: stmt.name, fields: vec_new_rt() );
        ctx.ent_names = vec_push_rt(ctx.ent_names, stmt.name);
        field_count = 0;
        i = 0;
        when i < vec_len_rt(stmt.children) loop
            f = vec_get_rt(stmt.children, i);
            et.fields = vec_push_rt(et.fields, EntityField ( name: f.name, offset: (i as int) * 8 ));
            ctx.ent_field_names = vec_push_rt(ctx.ent_field_names, f.name);
            ctx.ent_field_offsets = vec_push_rt(ctx.ent_field_offsets, (i as int) * 8);
            field_count = field_count + 1;
            i = i + 1;
        end
        ctx.ent_field_counts = vec_push_rt(ctx.ent_field_counts, field_count);
        ctx.entity_types = vec_push_rt(ctx.entity_types, et);
        out 0;
    end

    if stmt.node_type == AstType.FieldAssign do
        # Snapshot names first — later calls clobber AstNode fields on C VM.
        let fa_var = stmt.name;
        let fa_field = stmt.name2;
        offset = -1;
        j = 0;
        var fa_nent2 = vec_len_rt(ctx.ent_names);
        if fa_nent2 < 0 or fa_nent2 > 4096 do
            fa_nent2 = 0;
        end
        when j < fa_nent2 and offset < 0 loop
            var (ok, off) = ent_field_offset_flat(ctx.ent_field_names, ctx.ent_field_offsets, ctx.ent_field_counts, j, fa_field);
            if ok do
                offset = off;
            end
            j = j + 1;
        end
        # Last-resort name scan if counts were clobbered after VarDecl.
        if offset < 0 do
            let nfn = vec_len_rt(ctx.ent_field_names);
            if nfn > 0 and nfn <= 4096 do
                let fi = 0;
                when fi < nfn and offset < 0 loop
                    if str_eq(vec_get_rt(ctx.ent_field_names, fi), fa_field) do
                        let off2 = vec_get_rt(ctx.ent_field_offsets, fi);
                        if off2 >= 0 and off2 < 65536 do
                            offset = off2;
                        else
                            offset = fi * 8;
                        end
                    end
                    fi = fi + 1;
                end
            end
        end

        var (scope, idx) = sym_lookup_both(ctx, fa_var);
        if scope < 0 do
            lower_error(ctx, str_concat(str_new("field assign to undefined var"), str_new("")));
            out 0;
        end
        base_vreg = idx;
        if scope == 1 do
            gv = fresh_vreg(ctx);
            ir_emit(ctx, q_instr(QOp.LoadGlobal, q_vreg(gv), q_imm(idx as int), q_none()));
            base_vreg = gv;
        end

        if offset < 0 do
            lower_error(ctx, str_concat(str_new("unknown field in assign"), str_new("")));
            out 0;
        end

        val_r = lower_expr(ctx, vec_get_rt(stmt.children, 0));
        if val_r < 0 do
            out 0;
        end
        off_r = fresh_vreg(ctx);
        ir_emit(ctx, q_instr(QOp.Load, q_vreg(off_r), q_imm(offset as int), q_none()));
        ir_emit(ctx, q_instr(QOp.StoreWord, q_vreg(val_r as int), q_vreg(base_vreg), q_vreg(off_r)));
        out 0;
    end

    if stmt.node_type == AstType.CheckCpu or stmt.node_type == AstType.PatchPoint do
        ctx.patch_counter = ctx.patch_counter + 1;
        pp = q_instr(QOp.PatchPoint, q_none(), q_none(), q_none());
        pp.patch_id = ctx.patch_counter;
        ir_emit(ctx, pp);
        out 0;
    end

    # Module system (compile-time only)
    if stmt.node_type == AstType.ImportStmt or stmt.node_type == AstType.ModuleStmt or stmt.node_type == AstType.ExportStmt or stmt.node_type == AstType.IncludeStmt do
        out 0;
    end

    # when-cond loop (while): same shape as LoopStmt children [cond, body]
    if stmt.node_type == AstType.WhenStmt do
        cond_r = lower_expr(ctx, vec_get_rt(stmt.children, 0));
        if cond_r < 0 do
            out 0;
        end
        loop_lbl = fresh_label(ctx);
        end_lbl = fresh_label(ctx);
        ir_emit(ctx, q_instr(QOp.Label, q_label(loop_lbl), q_none(), q_none()));
        # re-eval condition each iteration — use JumpIfNot on first cond then body then jump back
        # Standard while: label; cond; jump_if_not end; body; jump loop; end
        ir_emit(ctx, q_instr(QOp.JumpIfNot, q_none(), q_vreg(cond_r as int), q_label(end_lbl)));
        if vec_len_rt(stmt.children) > 1 do
            lower_stmt(ctx, vec_get_rt(stmt.children, 1));
        end
        # recompute condition for next iteration
        cond2 = lower_expr(ctx, vec_get_rt(stmt.children, 0));
        if cond2 >= 0 do
            ir_emit(ctx, q_instr(QOp.JumpIf, q_none(), q_vreg(cond2 as int), q_label(loop_lbl)));
        end
        ir_emit(ctx, q_instr(QOp.Label, q_label(end_lbl), q_none(), q_none()));
        out 0;
    end

    # Default: expression statement (do NOT assign into ctx — lower_expr returns a vreg int)
    lower_expr(ctx, stmt);
    out 0;
end.


# ═══════════════════════════════════════════════════════
# Function Lowering
# ═══════════════════════════════════════════════════════

func lower_func_def:
    in(ctx: LowerCtx, func_def: AstNode)
    g_cur_func_body = 0;
    # Prefer parallel-array name (entity field often clobbered on VM)
    let fname = g_boot_var_name;
    g_boot_var_name = 0;
    if fname == 0 do
        fname = func_def.name;
    end
    # Find existing function from Pass 1 (do NOT create duplicate)
    fidx = find_func_index(ctx, fname);
    if fidx < 0 do
        # Fallback: should not happen if Pass 1 registered it
        var (mod2, fidx2) = q_module_add_func(ctx.mod_obj, fname);
        ctx.mod_obj = mod2;
        fidx = fidx2;
    end
    ctx.current_func_idx = fidx;
    g_boot_cur_func_idx = fidx;

    # Reset vreg counter for each function
    ctx.next_vreg = 16;
    boot_reset_vregs();
    # Flat staging only for single-fn small mains. Multi-fn smoke uses body dump.
    g_boot_flat_active = 0;
    let bd_start = g_bd_total;
    if boot_bd_dump_on() != 0 do
        boot_body_dump_init();
        boot_vmap_reset();
    end
    if str_eq(fname, "main") and boot_bd_dump_on() == 0 do
        let nk = 0;
        if g_ast_children_acc != 0 do
            nk = vec_len_rt(g_ast_children_acc);
        end
        if nk > 0 and nk < 40 do
            boot_q_stage_reset();
            g_boot_flat_active = 1;
            boot_vmap_reset();
        end
    end

    # Save local scope
    saved_syms = ctx.symbols;
    ctx.symbols = sym_new();

    # Register parameters and set param_count
    body_idx = vec_len_rt(func_def.children) - 1;
    param_count = 0;
    g_boot_param_nlocal = 0;
    g_boot_param_v0 = 0;
    i = 0;
    when i < body_idx loop
        param = vec_get_rt(func_def.children, i);
        if param.node_type == AstType.Identifier do
            pr = fresh_vreg(ctx);
            # (in-place ctx)
            ctx.symbols = sym_define(ctx.symbols, param.name, pr);
            if param_count == 0 do
                g_boot_param_v0 = pr;
            end
            param_count = param_count + 1;
            g_boot_param_nlocal = param_count;
        end
        i = i + 1;
    end

    # Set param_count on the function — use flat accumulator (entity field unreliable)
    let funcs = g_mod_funcs_acc;
    if funcs == 0 do
        funcs = ctx.mod_obj.functions;
    end
    f = vec_get_rt(funcs, fidx);
    f.param_count = param_count;
    vec_set_rt(funcs, fidx, f);
    g_mod_funcs_acc = funcs;

    # Self-host: dump-safe stub main (real AST Calls unlowered helpers).
    extern func native_read_i64(addr: int, offset: int) -> int;
    let stub_main = 0;
    if g_boot_name_cell != 0 do
        stub_main = native_read_i64(g_boot_name_cell, 216);
    end
    if stub_main != 0 and boot_bd_dump_on() != 0 do
        print_ln("virc: lower stub main body (self-host dump-safe)");
        let sr = fresh_vreg(ctx);
        boot_bd_push_load(sr, 42);
        boot_bd_push_print(sr);
        boot_bd_push_ret_imm(0);
    else
        # Lower body
        if vec_len_rt(func_def.children) > 0 do
            lower_stmt(ctx, vec_get_rt(func_def.children, body_idx));
        end
    end

    if boot_bd_dump_on() != 0 do
        extern func native_write_i64(addr: int, offset: int, val: int);
        let fi = fidx;
        if fi < 0 do
            fi = 0;
        end
        # Prefer Pass-1 main index when find_func_index missed due to name clobber.
        if g_boot_name_cell != 0 do
            let main_fi0 = native_read_i64(g_boot_name_cell, 208);
            if stub_main != 0 and main_fi0 >= 0 do
                fi = main_fi0;
            end
        end
        native_write_i64(g_bd_fstart, fi * 8, bd_start);
        native_write_i64(g_bd_flen, fi * 8, g_bd_total - bd_start);
        native_write_i64(g_bd_fnpc, fi * 8, param_count);
        let is_main = 0;
        if str_eq(fname, "main") do
            is_main = 1;
        end
        if stub_main != 0 do
            is_main = 1;
        end
        if g_boot_name_cell != 0 do
            let main_fi = native_read_i64(g_boot_name_cell, 208);
            if main_fi >= 0 and fi == main_fi do
                is_main = 1;
            end
        end
        native_write_i64(g_bd_fmain, fi * 8, is_main);
        if fi + 1 > g_bd_nfuncs do
            g_bd_nfuncs = fi + 1;
        end
    end

    # Restore scope
    ctx.symbols = saved_syms;
    ctx.current_func_idx = -1;
    g_boot_cur_func_idx = 0 - 1;
    out 0;
end.


# ═══════════════════════════════════════════════════════
# Program Lowering
# ═══════════════════════════════════════════════════════

func lower_program:
    in(ctx: LowerCtx, program: AstNode)
    prog_kids = g_ast_children_acc;
    if prog_kids == 0 do
        prog_kids = program.children;
    end
    # Pass 0: register enum/entity types
    i = 0;
    when i < vec_len_rt(prog_kids) loop
        child = vec_get_rt(prog_kids, i);
        child_type = vec_get_rt(g_ast_node_types, i);
        if child_type == AstType.EnumDef or child_type == AstType.EntityDef do
            lower_stmt(ctx, child);
        end
        i = i + 1;
    end

    # Pass 1: register function names for forward references
    has_main = false;
    has_top_stmt = false;
    g_boot_nfuncs_reg = 0;
    i = 0;
    when i < vec_len_rt(prog_kids) loop
        child = vec_get_rt(prog_kids, i);
        child_type = vec_get_rt(g_ast_node_types, i);
        child_name = vec_get_rt(g_ast_child_names, i);
        if child_type == AstType.FuncDef or child_type == AstType.ExternFunc do
            var (mod2, _) = q_module_add_func(ctx.mod_obj, child_name);
            ctx.mod_obj = mod2;
            g_boot_nfuncs_reg = g_boot_nfuncs_reg + 1;
            if str_eq(child_name, "main") do
                has_main = true;
                # Persist main's func index — AstNode.name/`fname` unreliable later.
                extern func native_write_i64(addr: int, offset: int, val: int);
                if g_boot_name_cell == 0 do
                    boot_name_cell_init();
                end
                native_write_i64(g_boot_name_cell, 208, g_boot_nfuncs_reg - 1);
            end
        else
            if not is_metadata(child_type) do
                has_top_stmt = true;
            end
        end
        i = i + 1;
    end
    # Small multi-fn programs (Call smoke): dual-emit into QFunction.body and
    # codegen via native body dump. Gate ONLY on func count — g_snap_ast_kids
    # / vec_len_rt can be clobbered on C VM to a small value and falsely enable
    # small_multi on self-host (~600 funcs) → multi-minute lower hang.
    boot_set_small_multi(0);
    boot_set_bd_dump(0);
    boot_set_bd_cap(1000);
    if g_boot_nfuncs_reg > 1 and g_boot_nfuncs_reg < 8 do
        boot_set_small_multi(1);
        boot_body_dump_init();
        g_bd_total = 0;
        g_bd_nfuncs = 0;
    end
    # Persist func count in native cell — Vir globals clobber under deep calls.
    extern func native_write_i64(addr: int, offset: int, val: int);
    if g_boot_name_cell == 0 do
        boot_name_cell_init();
    end
    native_write_i64(g_boot_name_cell, 144, g_boot_nfuncs_reg);
    native_write_i64(g_boot_name_cell, 136, 0);
    if g_boot_nfuncs_reg > 64 do
        # Self-host: dump lowered bodies (name-cell flag, not small_multi) so
        # boot_codegen_emit_mod_min can emit real ARM64 instead of basic42 stub.
        boot_set_bd_dump(1);
        boot_set_bd_cap(30000);
        boot_body_dump_init();
        g_bd_total = 0;
        g_bd_nfuncs = 0;
        extern func native_write_i64(addr: int, offset: int, val: int);
        native_write_i64(g_boot_name_cell, 216, 0);
        native_write_i64(g_boot_name_cell, 224, 0);
        print_ln("virc: self-host lower mode (cap + body-dump)");
    end

    # Pass 2: lower function bodies and top-level code
    if has_main do
        # Register global variables and create init function
        has_globals = false;
        i = 0;
        when i < vec_len_rt(prog_kids) loop
            child = vec_get_rt(prog_kids, i);
            child_type = vec_get_rt(g_ast_node_types, i);
            if child_type == AstType.VarDecl or child_type == AstType.ConstDecl do
                has_globals = true;
            end
            i = i + 1;
        end

        if has_globals do
            var (mod3, ginit_idx) = q_module_add_func(ctx.mod_obj, "__ginit");
            ctx.mod_obj = mod3;
            ctx.current_func_idx = ginit_idx;
            ctx.next_vreg = 16;
            boot_reset_vregs();

            i = 0;
            when i < vec_len_rt(prog_kids) loop
                child = vec_get_rt(prog_kids, i);
                child_type = vec_get_rt(g_ast_node_types, i);
                if child_type == AstType.VarDecl or child_type == AstType.ConstDecl do
                    gidx = ctx.global_idx_counter;
                    ctx.global_idx_counter = gidx + 1;
                    ctx.global_symbols = sym_define(ctx.global_symbols, child.name, gidx);
                    if vec_len_rt(child.children) > 0 do
                        let expr0 = vec_get_rt(child.children, 0);
                        val = lower_expr(ctx, expr0);

                        if val >= 0 do
                            ir_emit(ctx, q_instr(QOp.StoreGlobal, q_none(), q_imm(gidx as int), q_vreg(val as int)));
                        end
                    end
                end
                i = i + 1;
            end

            # Return from __ginit
            rz = fresh_vreg(ctx);
            # (in-place ctx)
            ir_emit(ctx, q_instr(QOp.Load, q_vreg(rz), q_imm(0), q_none()));
            ir_emit(ctx, q_instr(QOp.Ret, q_none(), q_vreg(rz), q_none()));
            ctx.current_func_idx = -1;
        end
    end

    if not has_main do
        var (mod3, main_idx) = q_module_add_func(ctx.mod_obj, "main");
        ctx.mod_obj = mod3;
        ctx.current_func_idx = main_idx;

        i = 0;
        when i < vec_len_rt(prog_kids) loop
            child = vec_get_rt(prog_kids, i);
            child_type = vec_get_rt(g_ast_node_types, i);
            if child_type != AstType.FuncDef do
                lower_stmt(ctx, child);
            end
            i = i + 1;
        end

        # Implicit return 0
        rz = fresh_vreg(ctx);
        # (in-place ctx)
        ir_emit(ctx, q_instr(QOp.Load, q_vreg(rz), q_imm(0), q_none()));
        ir_emit(ctx, q_instr(QOp.Ret, q_none(), q_vreg(rz), q_none()));
        ctx.current_func_idx = -1;
    end

    # Lower all function definitions
    i = 0;
    let nkids = vec_len_rt(prog_kids);
    when i < nkids loop
        child = vec_get_rt(prog_kids, i);
        child_type = vec_get_rt(g_ast_node_types, i);
        if child_type == AstType.FuncDef do
            let fname_dbg = vec_get_rt(g_ast_child_names, i);
            # Legacy `compile` still uses old `print "..."` / concat forms that
            # SIGSEGV the bootstrap lowerer. Active pipeline is virc_compile.
            skip_fn = 0;
            if str_eq(fname_dbg, "compile") do
                skip_fn = 1;
            end
            if str_eq(fname_dbg, "virc_legacy_main") do
                skip_fn = 1;
            end
            # Huge bodies — lowering each on C VM can take many minutes.
            if str_eq(fname_dbg, "lower_expr") do
                skip_fn = 1;
            end
            if str_eq(fname_dbg, "lower_stmt") do
                skip_fn = 1;
            end
            if str_eq(fname_dbg, "lower_func_def") do
                skip_fn = 1;
            end
            if str_eq(fname_dbg, "lower_program") do
                skip_fn = 1;
            end
            if str_eq(fname_dbg, "codegen_emit_module") do
                skip_fn = 1;
            end
            if str_eq(fname_dbg, "codegen_emit_instr") do
                skip_fn = 1;
            end
            if str_eq(fname_dbg, "virc_compile") do
                skip_fn = 1;
            end
            if str_eq(fname_dbg, "boot_tokenize_scan") do
                skip_fn = 1;
            end
            if str_eq(fname_dbg, "parse_statement") do
                skip_fn = 1;
            end
            if str_eq(fname_dbg, "tokenize_full") do
                skip_fn = 1;
            end
            if str_eq(fname_dbg, "parse_primary") do
                skip_fn = 1;
            end
            if str_eq(fname_dbg, "emit_fast_x86") do
                skip_fn = 1;
            end
            if str_eq(fname_dbg, "emit_runtime_arm64") do
                skip_fn = 1;
            end
            if str_eq(fname_dbg, "emit_fast_arm64") do
                skip_fn = 1;
            end
            if str_eq(fname_dbg, "macho_emit") do
                skip_fn = 1;
            end
            if str_eq(fname_dbg, "macho_write_to_file") do
                skip_fn = 1;
            end
            if str_eq(fname_dbg, "emit_macho_executable") do
                skip_fn = 1;
            end
            if str_eq(fname_dbg, "boot_codegen_flat_min") do
                skip_fn = 1;
            end
            if str_eq(fname_dbg, "boot_codegen_emit_mod_min") do
                skip_fn = 1;
            end
            if str_eq(fname_dbg, "borrow_check_function") do
                skip_fn = 1;
            end
            if str_eq(fname_dbg, "regalloc_linear_scan") do
                skip_fn = 1;
            end
            if str_eq(fname_dbg, "parse_program") do
                skip_fn = 1;
            end
            if str_eq(fname_dbg, "parse_func_def") do
                skip_fn = 1;
            end
            if str_eq(fname_dbg, "token_name") do
                skip_fn = 1;
            end
            if str_eq(fname_dbg, "boot_do_lower") do
                skip_fn = 1;
            end
            # Safety net: after many lowered funcs on self-host, skip remainder
            # EXCEPT `main` — always lower it with a dump-safe stub body so
            # Stage-1 has a real is_main entry (not a codegen-only patch).
            extern func native_read_i64(addr: int, offset: int) -> int;
            extern func native_write_i64(addr: int, offset: int, val: int);
            if g_boot_name_cell == 0 do
                boot_name_cell_init();
            end
            let nf_cell = native_read_i64(g_boot_name_cell, 144);
            let p_cell = native_read_i64(g_boot_name_cell, 136);
            if nf_cell > 64 and p_cell >= 400 do
                skip_fn = 1;
            end
            if str_eq(fname_dbg, "main") do
                skip_fn = 0;
                # Only stub when main would have been cap-skipped (not scale70).
                if nf_cell > 64 and p_cell >= 400 do
                    native_write_i64(g_boot_name_cell, 216, 1);
                    native_write_i64(g_boot_name_cell, 224, 1);
                end
            end
            if skip_fn == 0 do
                g_boot_var_name = fname_dbg;
                lower_func_def(ctx, child);
                g_boot_var_name = 0;
                native_write_i64(g_boot_name_cell, 216, 0);
                g_boot_fn_progress = g_boot_fn_progress + 1;
                extern func native_write_i64(addr: int, offset: int, val: int);
                if g_boot_name_cell == 0 do
                    boot_name_cell_init();
                end
                native_write_i64(g_boot_name_cell, 136, g_boot_fn_progress);
                if native_read_i64(g_boot_name_cell, 136) == 1 do
                    print_ln("virc: lower #1");
                end
                if native_read_i64(g_boot_name_cell, 136) == 10 do
                    print_ln("virc: lower #10");
                end
                if native_read_i64(g_boot_name_cell, 136) == 25 do
                    print_ln("virc: lower #25");
                end
                if native_read_i64(g_boot_name_cell, 136) == 50 do
                    print_ln("virc: lower #50");
                end
                if native_read_i64(g_boot_name_cell, 136) == 100 do
                    print_ln("virc: lower #100");
                end
                if native_read_i64(g_boot_name_cell, 136) == 200 do
                    print_ln("virc: lower #200");
                end
                if native_read_i64(g_boot_name_cell, 136) == 300 do
                    print_ln("virc: lower #300");
                end
                if native_read_i64(g_boot_name_cell, 136) == 400 do
                    print_ln("virc: lower #400 (self-host cap)");
                end
            end
        end
        i = i + 1;
    end

    # Prefer accumulator — entity field read of mod_obj.functions can be 0 on VM.
    if g_mod_funcs_acc == 0 do
        g_mod_funcs_acc = ctx.mod_obj.functions;
    end
    if g_mod_strings_acc == 0 do
        g_mod_strings_acc = ctx.mod_obj.strings;
    end
    out 0;
end.


func is_metadata:
    in(t: AstType)
    out t == AstType.EnumDef or t == AstType.EntityDef or t == AstType.ModuleStmt or t == AstType.ImportStmt or t == AstType.ExportStmt or t == AstType.IncludeStmt;
end.


# ═══════════════════════════════════════════════════════
# Liveness Analysis
# ═══════════════════════════════════════════════════════

entity LiveInterval:
    vreg:       int;
    start:      int;
    end_pos:    int;
    phys_reg:   int;
    spill_slot: int;
end.

func compute_liveness:
    in(f: QFunction)
    intervals = vec_new_rt();

    i = 0;
    when i < vec_len_rt(f.body) loop
        instr = vec_get_rt(f.body, i);

        # Definition (dest)
        if instr.dest.op_type == OperandType.VReg do
            iv = find_or_create_interval(intervals, instr.dest.vreg);
            intervals = iv.0;
            idx = iv.1;
            interval = vec_get_rt(intervals, idx);
            if (i as u32) < interval.start do
                interval.start = i as int;
            end
            if (i as u32) > interval.end_pos do
                interval.end_pos = i as int;
            end
            vec_set_rt(intervals, idx, interval);
        end

        # Use (src1)
        if instr.src1.op_type == OperandType.VReg do
            iv = find_or_create_interval(intervals, instr.src1.vreg);
            intervals = iv.0;
            idx = iv.1;
            interval = vec_get_rt(intervals, idx);
            if (i as u32) < interval.start do
                interval.start = i as int;
            end
            if (i as u32) > interval.end_pos do
                interval.end_pos = i as int;
            end
            vec_set_rt(intervals, idx, interval);
        end

        # Use (src2)
        if instr.src2.op_type == OperandType.VReg do
            iv = find_or_create_interval(intervals, instr.src2.vreg);
            intervals = iv.0;
            idx = iv.1;
            interval = vec_get_rt(intervals, idx);
            if (i as u32) < interval.start do
                interval.start = i as int;
            end
            if (i as u32) > interval.end_pos do
                interval.end_pos = i as int;
            end
            vec_set_rt(intervals, idx, interval);
        end

        i = i + 1;
    end
    out intervals;
end.


func find_or_create_interval:
    in(intervals: Vec<LiveInterval>, vreg: int)
    i = 0;
    when i < vec_len_rt(intervals) loop
        iv = vec_get_rt(intervals, i);
        if iv.vreg == vreg do
            out (intervals, i);
        end
        i = i + 1;
    end
    intervals = vec_push_rt(intervals, LiveInterval {
        vreg:       vreg,
        start:      0xFFFFFFFF as int,
        end_pos:    0,
        phys_reg:   -1,
        spill_slot: -1
    });
    out (intervals, vec_len_rt(intervals) - 1);
end.


# ═══════════════════════════════════════════════════════
# Linear-Scan Register Allocation
# ═══════════════════════════════════════════════════════

func regalloc_linear_scan:
    in(intervals: Vec<LiveInterval>, num_phys_regs: int)
    if num_phys_regs == 0 or vec_len_rt(intervals) == 0 do
        out intervals;
    end

    # Sort by start position (bubble sort — simple for correctness)
    n = vec_len_rt(intervals);
    s = 0;
    when s < n - 1 loop
        t = 0;
        when t < n - s - 1 loop
            a = vec_get_rt(intervals, t);
            b = vec_get_rt(intervals, t + 1);
            if a.start > b.start do
                vec_set_rt(intervals, t, b);
                vec_set_rt(intervals, t + 1, a);
            end
            t = t + 1;
        end
        s = s + 1;
    end

    # Free register pool (bit-set, max 32 regs)
    max_regs = num_phys_regs;
    if max_regs > 32 do
        max_regs = 32;
    end
    free_mask = (1 shl max_regs) - 1;

    # Active list (indices into intervals)
    active = vec_new_rt();
    next_spill = 0;

    i = 0;
    when i < n loop
        cur = vec_get_rt(intervals, i);

        # Expire finished intervals
        new_active = vec_new_rt();
        a = 0;
        when a < vec_len_rt(active) loop
            aidx = vec_get_rt(active, a);
            act = vec_get_rt(intervals, aidx);
            if act.end_pos < cur.start do
                # Release register
                if act.phys_reg >= 0 do
                    free_mask = free_mask or (1 shl (act.phys_reg as int));
                end
            else
                new_active = vec_push_rt(new_active, aidx);
            end
            a = a + 1;
        end
        active = new_active;

        # Try to allocate a free register
        if free_mask != 0 do
            # Find lowest set bit
            bit = 0;
            tmp = free_mask;
            when (tmp and 1) == 0 loop
                bit = bit + 1;
                tmp = tmp shr 1;
            end

            cur.phys_reg = bit as int;
            free_mask = free_mask and (not (1 shl bit));
            vec_set_rt(intervals, i, cur);

            # Insert into active (sorted by end)
            pos = vec_len_rt(active);
            k = 0;
            when k < vec_len_rt(active) loop
                aidx = vec_get_rt(active, k);
                act = vec_get_rt(intervals, aidx);
                if act.end_pos > cur.end_pos do
                    pos = k;
                    k = vec_len_rt(active)  # break;
                end
                k = k + 1;
            end
            # Insert at pos
            active = vec_push_rt(active, i)  # placeholder;
            j = vec_len_rt(active) - 1;
            when j > pos loop
                vec_set_rt(active, j, vec_get_rt(active, j - 1));
                j = j - 1;
            end
            vec_set_rt(active, pos, i);
        else
            # Spill
            if vec_len_rt(active) > 0 do
                last_idx = vec_get_rt(active, vec_len_rt(active) - 1);
                spill_cand = vec_get_rt(intervals, last_idx);
                if spill_cand.end_pos > cur.end_pos do
                    cur.phys_reg = spill_cand.phys_reg;
                    spill_cand.phys_reg = -1;
                    spill_cand.spill_slot = next_spill;
                    next_spill = next_spill + 1;
                    vec_set_rt(intervals, last_idx, spill_cand);
                    vec_set_rt(intervals, i, cur);
                    # Remove last from active
                    new_active2 = vec_new_rt();
                    k = 0;
                    when k < vec_len_rt(active) - 1 loop
                        new_active2 = vec_push_rt(new_active2, vec_get_rt(active, k));
                        k = k + 1;
                    end
                    active = new_active2;
                    # Insert current
                    active = vec_push_rt(active, i);
                else
                    cur.phys_reg = -1;
                    cur.spill_slot = next_spill;
                    next_spill = next_spill + 1;
                    vec_set_rt(intervals, i, cur);
                end
            else
                cur.phys_reg = -1;
                cur.spill_slot = next_spill;
                next_spill = next_spill + 1;
                vec_set_rt(intervals, i, cur);
            end
        end

        i = i + 1;
    end

    out intervals;
end.


# ═══════════════════════════════════════════════════════
# Apply Register Allocation — rewrite vregs to phys regs
# ═══════════════════════════════════════════════════════

func apply_regalloc:
    in(f: QFunction, intervals: Vec<LiveInterval>)
    niv = vec_len_rt(intervals);
    print niv;
    k = 0;
    when k < niv loop
        iv = vec_get_rt(intervals, k);
        print iv.vreg;
        print iv.phys_reg;
        k = k + 1;
    end
    i = 0;
    when i < vec_len_rt(f.body) loop
        ins = vec_get_rt(f.body, i);
        changed = 0;
        if ins.dest.op_type == OperandType.VReg do
            pr = get_phys_reg(intervals, ins.dest.vreg);
            if pr >= 0 and (pr as u32) != ins.dest.vreg do
                var temp_dest = ins.dest;
                temp_dest.vreg = pr;
                ins.dest = temp_dest;
                changed = 1;
            end
        end
        if ins.src1.op_type == OperandType.VReg do
            pr = get_phys_reg(intervals, ins.src1.vreg);
            if pr >= 0 and (pr as u32) != ins.src1.vreg do
                var temp_src1 = ins.src1;
                temp_src1.vreg = pr;
                ins.src1 = temp_src1;
                changed = 1;
            end
        end
        if ins.src2.op_type == OperandType.VReg do
            pr = get_phys_reg(intervals, ins.src2.vreg);
            if pr >= 0 and (pr as u32) != ins.src2.vreg do
                var temp_src2 = ins.src2;
                temp_src2.vreg = pr;
                ins.src2 = temp_src2;
                changed = 1;
            end
        end
        if changed == 1 do
            vec_set_rt(f.body, i, ins);
        end
        i = i + 1;
    end
    out f;
end.


# ═══════════════════════════════════════════════════════
# Tail-Call Optimization
# ═══════════════════════════════════════════════════════

func tco_pass:
    in(f: QFunction)
    tco_count = 0;
    body_len = vec_len_rt(f.body);
    if body_len < 2 do
        out (f, 0);
    end

    i = 0;
    when i + 1 < body_len loop
        cur = vec_get_rt(f.body, i);
        next_instr = vec_get_rt(f.body, i + 1);

        # Pattern: CALL followed by RET
        if cur.opcode == QOp.Call and next_instr.opcode == QOp.Ret do
            cur.opcode = QOp.Jump;
            cur.dest = q_none();
            cur.src2 = q_none();
            vec_set_rt(f.body, i, cur);

            next_instr.opcode = QOp.Nop;
            next_instr.dest = q_none();
            next_instr.src1 = q_none();
            next_instr.src2 = q_none();
            vec_set_rt(f.body, i + 1, next_instr);

            tco_count = tco_count + 1;
            i = i + 2;
        else
            i = i + 1;
        end
    end
    out (f, tco_count);
end.


# ═══════════════════════════════════════════════════════
# Get Physical Register for a VReg
# ═══════════════════════════════════════════════════════

func get_phys_reg:
    in(intervals: Vec<LiveInterval>, vreg: int)
    i = 0;
    when i < vec_len_rt(intervals) loop
        iv = vec_get_rt(intervals, i);
        if iv.vreg == vreg do
            out iv.phys_reg;
        end
        i = i + 1;
    end
    out -1;
end.
# ══ END vir/compiler/ir_optimizer ══

# ══ BEGIN vir/compiler/borrow_check ══
const OWN_UNINIT: 0;
const OWN_OWNED: 1;
const OWN_MOVED: 2;
const OWN_BORROWED: 3;
const OWN_MUT_BORROWED: 4;
const OWN_COPY: 5;
const OWN_STATIC: 6;

entity VarInfo:
    vreg: int;
    state: int;
    birth_ip: int;
    death_ip: int;
    is_alloc: bool;
    is_alive: bool;
    escapes: bool;
end.

func bc_get_var:
    in(vars: Vec<VarInfo>, vreg: int)
    let i = 0;
    let n = vec_len_rt(vars);
    let found = -1;
    when i < n loop
        let v = vec_get_rt(vars, i);
        if v.vreg == vreg do
            found = i;
            i = n;
        else
            i = i + 1;
        end
    end
    
    if found != -1 do
        let v = vec_get_rt(vars, found);
        out v;
    end
    
    # New var
    let v = VarInfo(vreg: vreg, state: OWN_UNINIT, birth_ip: 999999, death_ip: 0, is_alloc: false, is_alive: false, escapes: false);
    vec_push_rt(vars, v);
    out v;
end.

func bc_update_var:
    in(vars: Vec<VarInfo>, v: VarInfo)
    let i = 0;
    let n = vec_len_rt(vars);
    when i < n loop
        let curr = vec_get_rt(vars, i);
        if curr.vreg == v.vreg do
            vec_set_rt(vars, i, v);
            i = n;
        else
            i = i + 1;
        end
    end
end.

func bc_touch:
    in(vars: Vec<VarInfo>, vreg: int, ip: int)
    let v = bc_get_var(vars, vreg);
    if v.death_ip < ip do
        v.death_ip = ip;
        bc_update_var(vars, v);
    end
end.

func borrow_check_function:
    in(f: QFunction)
    
    let vars = vec_new_rt();
    
    # Pass 1: Scan
    let ip = 0;
    let n_instr = vec_len_rt(f.body);
    when ip < n_instr loop
        let instr = vec_get_rt(f.body, ip);
        
        if instr.dest.op_type == OperandType.VReg do
            let v = bc_get_var(vars, instr.dest.vreg);
            if v.is_alive == false do
                v.birth_ip = ip;
                v.is_alive = true;
            end
            if v.death_ip < ip do
                v.death_ip = ip;
            end
            bc_update_var(vars, v);
        end
        
        if instr.src1.op_type == OperandType.VReg do
            bc_touch(vars, instr.src1.vreg, ip);
        end
        if instr.src2.op_type == OperandType.VReg do
            bc_touch(vars, instr.src2.vreg, ip);
        end
        
        ip = ip + 1;
    end
    
    # Pass 2: Classify bit_and Escape
    ip = 0;
    when ip < n_instr loop
        let instr = vec_get_rt(f.body, ip);
        
        if instr.dest.op_type == OperandType.VReg do
            let v = bc_get_var(vars, instr.dest.vreg);
            let op = instr.opcode;
            if op == QOp.Alloc or op == QOp.ArrNew or op == QOp.StrCat or op == QOp.IToStr do
                v.is_alloc = true;
                v.state = OWN_OWNED;
                bc_update_var(vars, v);
            end
        end
        
        # Mark escape if returned or passed to CallFunc
        if instr.opcode == QOp.Ret do
            if instr.src1.op_type == OperandType.VReg do
                let v = bc_get_var(vars, instr.src1.vreg);
                v.escapes = true;
                bc_update_var(vars, v);
            end
        end
        if instr.opcode == QOp.CallFunc do
            if instr.src1.op_type == OperandType.VReg do
                let v = bc_get_var(vars, instr.src1.vreg);
                v.escapes = true;
                bc_update_var(vars, v);
            end
            if instr.src2.op_type == OperandType.VReg do
                let v = bc_get_var(vars, instr.src2.vreg);
                v.escapes = true;
                bc_update_var(vars, v);
            end
        end
        if instr.opcode == QOp.ArrSet or instr.opcode == QOp.StoreWord do
            if instr.src2.op_type == OperandType.VReg do
                let v = bc_get_var(vars, instr.src2.vreg);
                v.escapes = true;
                bc_update_var(vars, v);
            end
        end
        
        ip = ip + 1;
    end
    
    # Pass 3: Insert Drops (Q_FREE)
    let new_body = vec_new_rt();
    ip = 0;
    when ip < n_instr loop
        let instr = vec_get_rt(f.body, ip);
        vec_push_rt(new_body, instr);
        
        # Check if any OWNED var dies at this ip and didn't escape
        let vi = 0;
        let vn = vec_len_rt(vars);
        when vi < vn loop
            let v = vec_get_rt(vars, vi);
            if v.state == OWN_OWNED and v.escapes == false and v.death_ip == ip do
                # Insert Q_FREE
                let free_op = QOperand(op_type: OperandType.VReg, vreg: v.vreg, imm_val: 0);
                let dummy_dest = QOperand(op_type: OperandType.None, vreg: 0, imm_val: 0);
                let free_instr = q_instr(QOp.Free, dummy_dest, free_op, dummy_dest);
                vec_push_rt(new_body, free_instr);
            end
            vi = vi + 1;
        end
        
        ip = ip + 1;
    end
    
    f.body = new_body;
    out f;
end.
# ══ END vir/compiler/borrow_check ══

# ══ BEGIN vir/compiler/codegen ══
##
 * vir/compiler/codegen.vri — Machine Code Generator (Pure Vir)
 * =============================================================
 * Translated from core/src/codegen.c (3408 lines).
 *
 * Emits real machine code bytes into a code buffer.
 * Supports x86_64 and ARM64 targets with:
 *   - Code buffer (growable byte array)
 *   - x86_64 instruction encoding (REX, ModR/M, VEX)
 *   - ARM64 instruction encoding (32-bit fixed-width)
 *   - NEON / AVX SIMD emitters
 *   - Back-patching for branch offsets
 *   - Safe (stack-based), Fast (register-direct), Full generators
 *   - Intrinsic call dispatch
 ##



# ═══════════════════════════════════════════════════════
# Architecture Detection
# ═══════════════════════════════════════════════════════

enum TargetArch:
    Unknown = 0;
    X86_64  = 1;
    ARM64   = 2;
end.

func detect_arch:
    # Compile-time constant based on host
    # On ARM64 macOS, this returns ARM64
    out TargetArch.ARM64;
end.

# ═══════════════════════════════════════════════════════
# x86_64 Register IDs
# ═══════════════════════════════════════════════════════

enum X86Reg:
    RAX = 0;
    RCX = 1;
    RDX = 2;
    RBX = 3;
    RSP = 4;
    RBP = 5;
    RSI = 6;
    RDI = 7;
    R8  = 8;
    R9  = 9;
    R10 = 10;
    R11 = 11;
    R12 = 12;
    R13 = 13;
    R14 = 14;
    R15 = 15;
end.

# ═══════════════════════════════════════════════════════
# ARM64 Register IDs
# ═══════════════════════════════════════════════════════

enum ArmReg:
    X0  = 0;
    X1  = 1;
    X2  = 2;
    X3  = 3;
    X4  = 4;
    X5  = 5;
    X6  = 6;
    X7  = 7;
    X8  = 8;
    X9  = 9;
    X10 = 10;
    X11 = 11;
    X12 = 12;
    X13 = 13;
    X14 = 14;
    X15 = 15;
    X16 = 16;
    X17 = 17;
    X29 = 29   # FP;
    X30 = 30   # LR;
    SP  = 31;
end.

# ═══════════════════════════════════════════════════════
# Code Buffer — growable byte array
# ═══════════════════════════════════════════════════════

const CODEBUF_INIT_CAP = 4096;

var g_codebuf_data = 0;   # bvec handle (u8 bytes)
var g_emit_word = 0;
var g_emit_b0 = 0;
var g_emit_b1 = 0;
var g_emit_b2 = 0;
var g_emit_b3 = 0;
var g_rt_print_off = 0;
var g_rt_printstr_off = 0;
var g_rt_exit_off = 0;
var g_code_start_offset = 0;
var g_main_start_off = 0;
var g_snap_entry_off = 0;
var g_runtime_min = 0;
var g_mask_val = 0;

func boot_mask19:
    in(x: int)
    out x - ((x shr 19) shl 19);
end.

func boot_mask26:
    in(x: int)
    out x - ((x shr 26) shl 26);
end.

entity CodeBuf:
    data:   int      # bvec handle for machine-code bytes;
    len:    int;
    cap:    int;
    arch:   TargetArch;
end.

func codebuf_len:
    if g_codebuf_data != 0 do
        out bvec_len(g_codebuf_data);
    end
    out 0;
end.

func codebuf_get_byte:
    in(index: int)
    out native_read_u8(g_codebuf_data, index) bit_and 0xFF;
end.

func codebuf_new:
    in(arch: TargetArch)
    g_codebuf_data = bvec_new();
    buf = CodeBuf {
        data: g_codebuf_data,
        len:  0,
        cap:  CODEBUF_INIT_CAP,
        arch: arch
    };
    out buf;
end.

func codebuf_emit_byte:
    in(buf: CodeBuf, byte: int)
    if g_codebuf_data == 0 do
        if buf.data != 0 do
            g_codebuf_data = buf.data;
        else
            g_codebuf_data = bvec_new();
        end
    end
    g_codebuf_data = bvec_push(g_codebuf_data, byte);
    out CodeBuf {
        data: g_codebuf_data,
        len:  bvec_len(g_codebuf_data),
        cap:  buf.cap,
        arch: buf.arch
    };
end.

func codebuf_emit_u32:
    in(buf: CodeBuf, val: int)
    g_emit_b0 = val;
    g_emit_b1 = val shr 8;
    g_emit_b2 = val shr 16;
    g_emit_b3 = val shr 24;
    buf = codebuf_emit_byte(buf, g_emit_b0);
    buf = codebuf_emit_byte(buf, g_emit_b1);
    buf = codebuf_emit_byte(buf, g_emit_b2);
    buf = codebuf_emit_byte(buf, g_emit_b3);
    out buf;
end.

func codebuf_emit_u64:
    in(buf: CodeBuf, val: int)
    g_emit_word = val;
    buf = codebuf_emit_u32(buf, g_emit_word);
    g_emit_word = val shr 32;
    buf = codebuf_emit_u32(buf, g_emit_word);
    out buf;
end.

func codebuf_emit_i32:
    in(buf: CodeBuf, val: int)
    out codebuf_emit_u32(buf, val);
end.

func codebuf_offset:
    in(buf: CodeBuf)
    if g_codebuf_data != 0 do
        out bvec_len(g_codebuf_data);
    end
    if buf.data != 0 do
        out bvec_len(buf.data);
    end
    out buf.len;
end.

func codebuf_get_data:
    in(buf: CodeBuf, index: int)
    data = buf.data;
    if data == 0 do
        data = g_codebuf_data;
    end
    out native_read_u8(data, index) bit_and 0xFF;
end.

func codebuf_patch_i32:
    in(buf: CodeBuf, offset: int, val: int)
    if g_codebuf_data == 0 do
        g_codebuf_data = buf.data;
    end
    if g_codebuf_data != 0 and offset + 4 <= bvec_len(g_codebuf_data) do
        g_emit_b0 = val;
        g_emit_b1 = val shr 8;
        g_emit_b2 = val shr 16;
        g_emit_b3 = val shr 24;
        native_write_u8(g_codebuf_data, offset, g_emit_b0);
        native_write_u8(g_codebuf_data, offset + 1, g_emit_b1);
        native_write_u8(g_codebuf_data, offset + 2, g_emit_b2);
        native_write_u8(g_codebuf_data, offset + 3, g_emit_b3);
    end
    out CodeBuf {
        data: g_codebuf_data,
        len:  bvec_len(g_codebuf_data),
        cap:  buf.cap,
        arch: buf.arch
    };
end.

func codebuf_patch_u32:
    in(buf: CodeBuf, offset: int, val: int)
    out codebuf_patch_i32(buf, offset, val);
end.

# ═══════════════════════════════════════════════════════
# x86_64 Encoding Helpers
# ═══════════════════════════════════════════════════════

func rex_w:
    in(r: int, rm: int)
    rex = 0x48;
    if r >= 8 do
        rex = rex | 0x04;
    end
    if rm >= 8 do
        rex = rex | 0x01;
    end
    out rex;
end.

func modrm:
    in(mod_: int, reg: int, rm: int)
    out (mod_ shl 6) | ((reg bit_and 7) shl 3) | (rm bit_and 7);
end.

# ═══════════════════════════════════════════════════════
# x86_64 Instruction Emitters
# ═══════════════════════════════════════════════════════

func x86_add_rr:
    in(cb: CodeBuf, dst: int, src: int)
    # ADD dst, src -> REX.W 01 /r
    cb = codebuf_emit_byte(cb, rex_w(src, dst));
    cb = codebuf_emit_byte(cb, 0x01);
    cb = codebuf_emit_byte(cb, modrm(0x03, src, dst));
    out cb;
end.

func x86_sub_rr:
    in(cb: CodeBuf, dst: int, src: int)
    # SUB dst, src -> REX.W 29 /r
    cb = codebuf_emit_byte(cb, rex_w(src, dst));
    cb = codebuf_emit_byte(cb, 0x29);
    cb = codebuf_emit_byte(cb, modrm(0x03, src, dst));
    out cb;
end.

func x86_imul_rr:
    in(cb: CodeBuf, dst: int, src: int)
    # IMUL dst, src -> REX.W 0F AF /r
    cb = codebuf_emit_byte(cb, rex_w(dst, src));
    cb = codebuf_emit_byte(cb, 0x0F);
    cb = codebuf_emit_byte(cb, 0xAF);
    cb = codebuf_emit_byte(cb, modrm(0x03, dst, src));
    out cb;
end.

func x86_mov_reg_imm64:
    in(cb: CodeBuf, dst: int, imm: int)
    # MOV dst, imm64 -> REX.W B8+rd [8 bytes]
    rex = 0x48;
    if dst >= 8 do
        rex = rex | 0x01;
    end
    cb = codebuf_emit_byte(cb, rex);
    cb = codebuf_emit_byte(cb, 0xB8 + (dst bit_and 7));
    cb = codebuf_emit_u64(cb, imm);
    out cb;
end.

func x86_mov_reg_imm32:
    in(cb: CodeBuf, dst: int, imm: int)
    # MOV dst, imm32 -> REX.W C7 /0 [4 bytes]
    rex = 0x48;
    if dst >= 8 do
        rex = rex | 0x01;
    end
    cb = codebuf_emit_byte(cb, rex);
    cb = codebuf_emit_byte(cb, 0xC7);
    cb = codebuf_emit_byte(cb, modrm(0x03, 0, dst));
    cb = codebuf_emit_i32(cb, imm);
    out cb;
end.

func x86_mov_rr:
    in(cb: CodeBuf, dst: int, src: int)
    # MOV dst, src -> REX.W 89 /r
    cb = codebuf_emit_byte(cb, rex_w(src, dst));
    cb = codebuf_emit_byte(cb, 0x89);
    cb = codebuf_emit_byte(cb, modrm(0x03, src, dst));
    out cb;
end.

func x86_push:
    in(cb: CodeBuf, reg: int)
    if reg >= 8 do
        cb = codebuf_emit_byte(cb, 0x41);
    end
    cb = codebuf_emit_byte(cb, 0x50 + (reg bit_and 7));
    out cb;
end.

func x86_pop:
    in(cb: CodeBuf, reg: int)
    if reg >= 8 do
        cb = codebuf_emit_byte(cb, 0x41);
    end
    cb = codebuf_emit_byte(cb, 0x58 + (reg bit_and 7));
    out cb;
end.

func x86_ret:
    in(cb: CodeBuf)
    out codebuf_emit_byte(cb, 0xC3);
end.

func x86_nop:
    in(cb: CodeBuf)
    out codebuf_emit_byte(cb, 0x90);
end.

func x86_jmp_rel32:
    in(cb: CodeBuf, offset: int)
    cb = codebuf_emit_byte(cb, 0xE9);
    cb = codebuf_emit_i32(cb, offset);
    out cb;
end.

func x86_call_rel32:
    in(cb: CodeBuf, offset: int)
    cb = codebuf_emit_byte(cb, 0xE8);
    cb = codebuf_emit_i32(cb, offset);
    out cb;
end.

func x86_cmp_rr:
    in(cb: CodeBuf, a: int, b: int)
    # CMP a, b -> REX.W 39 /r
    cb = codebuf_emit_byte(cb, rex_w(b, a));
    cb = codebuf_emit_byte(cb, 0x39);
    cb = codebuf_emit_byte(cb, modrm(0x03, b, a));
    out cb;
end.

func x86_sete:
    in(cb: CodeBuf, dst: int)
    if dst >= 8 do
        cb = codebuf_emit_byte(cb, 0x41);
    end
    cb = codebuf_emit_byte(cb, 0x0F);
    cb = codebuf_emit_byte(cb, 0x94);
    cb = codebuf_emit_byte(cb, modrm(0x03, 0, dst));
    out cb;
end.

func x86_setg:
    in(cb: CodeBuf, dst: int)
    if dst >= 8 do
        cb = codebuf_emit_byte(cb, 0x41);
    end
    cb = codebuf_emit_byte(cb, 0x0F);
    cb = codebuf_emit_byte(cb, 0x9F);
    cb = codebuf_emit_byte(cb, modrm(0x03, 0, dst));
    out cb;
end.

func x86_setl:
    in(cb: CodeBuf, dst: int)
    if dst >= 8 do
        cb = codebuf_emit_byte(cb, 0x41);
    end
    cb = codebuf_emit_byte(cb, 0x0F);
    cb = codebuf_emit_byte(cb, 0x9C);
    cb = codebuf_emit_byte(cb, modrm(0x03, 0, dst));
    out cb;
end.

func x86_setge:
    in(cb: CodeBuf, dst: int)
    if dst >= 8 do
        cb = codebuf_emit_byte(cb, 0x41);
    end
    cb = codebuf_emit_byte(cb, 0x0F);
    cb = codebuf_emit_byte(cb, 0x9D);
    cb = codebuf_emit_byte(cb, modrm(0x03, 0, dst));
    out cb;
end.

func x86_setle:
    in(cb: CodeBuf, dst: int)
    if dst >= 8 do
        cb = codebuf_emit_byte(cb, 0x41);
    end
    cb = codebuf_emit_byte(cb, 0x0F);
    cb = codebuf_emit_byte(cb, 0x9E);
    cb = codebuf_emit_byte(cb, modrm(0x03, 0, dst));
    out cb;
end.

func x86_je_rel32:
    in(cb: CodeBuf, offset: int)
    cb = codebuf_emit_byte(cb, 0x0F);
    cb = codebuf_emit_byte(cb, 0x84);
    cb = codebuf_emit_i32(cb, offset);
    out cb;
end.

func x86_jne_rel32:
    in(cb: CodeBuf, offset: int)
    cb = codebuf_emit_byte(cb, 0x0F);
    cb = codebuf_emit_byte(cb, 0x85);
    cb = codebuf_emit_i32(cb, offset);
    out cb;
end.

func x86_xor_rr:
    in(cb: CodeBuf, dst: int, src: int)
    cb = codebuf_emit_byte(cb, rex_w(src, dst));
    cb = codebuf_emit_byte(cb, 0x31);
    cb = codebuf_emit_byte(cb, modrm(0x03, src, dst));
    out cb;
end.

func x86_and_rr:
    in(cb: CodeBuf, dst: int, src: int)
    # AND dst, src -> REX.W 21 /r
    cb = codebuf_emit_byte(cb, rex_w(src, dst));
    cb = codebuf_emit_byte(cb, 0x21);
    cb = codebuf_emit_byte(cb, modrm(0x03, src, dst));
    out cb;
end.

func x86_or_rr:
    in(cb: CodeBuf, dst: int, src: int)
    # OR dst, src -> REX.W 09 /r
    cb = codebuf_emit_byte(cb, rex_w(src, dst));
    cb = codebuf_emit_byte(cb, 0x09);
    cb = codebuf_emit_byte(cb, modrm(0x03, src, dst));
    out cb;
end.

func x86_shl_cl:
    in(cb: CodeBuf, dst: int)
    # SHL dst, CL -> REX.W D3 /4
    r = 0x48;
    if dst >= 8 do
        r = r | 0x01;
    end
    cb = codebuf_emit_byte(cb, r);
    cb = codebuf_emit_byte(cb, 0xD3);
    cb = codebuf_emit_byte(cb, modrm(0x03, 4, dst));
    out cb;
end.

func x86_sar_cl:
    in(cb: CodeBuf, dst: int)
    # SAR dst, CL -> REX.W D3 /7
    r = 0x48;
    if dst >= 8 do
        r = r | 0x01;
    end
    cb = codebuf_emit_byte(cb, r);
    cb = codebuf_emit_byte(cb, 0xD3);
    cb = codebuf_emit_byte(cb, modrm(0x03, 7, dst));
    out cb;
end.

func x86_idiv:
    in(cb: CodeBuf, divisor: int)
    # IDIV divisor -> REX.W F7 /7
    rex = 0x48;
    if divisor >= 8 do
        rex = rex | 0x01;
    end
    cb = codebuf_emit_byte(cb, rex);
    cb = codebuf_emit_byte(cb, 0xF7);
    cb = codebuf_emit_byte(cb, modrm(0x03, 7, divisor));
    out cb;
end.

func x86_cqo:
    in(cb: CodeBuf)
    # CQO -> 48 99
    cb = codebuf_emit_byte(cb, 0x48);
    cb = codebuf_emit_byte(cb, 0x99);
    out cb;
end.

func x86_syscall:
    in(cb: CodeBuf)
    cb = codebuf_emit_byte(cb, 0x0F);
    cb = codebuf_emit_byte(cb, 0x05);
    out cb;
end.

func x86_test_rr:
    in(cb: CodeBuf, r: int)
    # TEST r, r -> REX.W 85 /r (same reg)
    cb = codebuf_emit_byte(cb, rex_w(r, r));
    cb = codebuf_emit_byte(cb, 0x85);
    cb = codebuf_emit_byte(cb, modrm(0x03, r, r));
    out cb;
end.

# ═══════════════════════════════════════════════════════
# x86_64 VEX prefix (2-byte form for AVX)
# ═══════════════════════════════════════════════════════

func x86_vex2:
    in(cb: CodeBuf, vvvv: int, l: int, pp: int)
    # C5 [R/vvvv/L/pp] — R=1 for XMM0-7
    byte2 = 0x80 | (((~vvvv) bit_and 0x0F) shl 3) | ((l bit_and 1) shl 2) | (pp bit_and 3);
    cb = codebuf_emit_byte(cb, 0xC5);
    cb = codebuf_emit_byte(cb, byte2);
    out cb;
end.

func avx_vaddps:
    in(cb: CodeBuf, dst: int, s1: int, s2: int)
    cb = x86_vex2(cb, s1, 0, 0);
    cb = codebuf_emit_byte(cb, 0x58);
    cb = codebuf_emit_byte(cb, 0xC0 | ((dst bit_and 7) shl 3) | (s2 bit_and 7));
    out cb;
end.

func avx_vsubps:
    in(cb: CodeBuf, dst: int, s1: int, s2: int)
    cb = x86_vex2(cb, s1, 0, 0);
    cb = codebuf_emit_byte(cb, 0x5C);
    cb = codebuf_emit_byte(cb, 0xC0 | ((dst bit_and 7) shl 3) | (s2 bit_and 7));
    out cb;
end.

func avx_vmulps:
    in(cb: CodeBuf, dst: int, s1: int, s2: int)
    cb = x86_vex2(cb, s1, 0, 0);
    cb = codebuf_emit_byte(cb, 0x59);
    cb = codebuf_emit_byte(cb, 0xC0 | ((dst bit_and 7) shl 3) | (s2 bit_and 7));
    out cb;
end.

func avx_vdivps:
    in(cb: CodeBuf, dst: int, s1: int, s2: int)
    cb = x86_vex2(cb, s1, 0, 0);
    cb = codebuf_emit_byte(cb, 0x5E);
    cb = codebuf_emit_byte(cb, 0xC0 | ((dst bit_and 7) shl 3) | (s2 bit_and 7));
    out cb;
end.

func avx_vminps:
    in(cb: CodeBuf, dst: int, s1: int, s2: int)
    cb = x86_vex2(cb, s1, 0, 0);
    cb = codebuf_emit_byte(cb, 0x5D);
    cb = codebuf_emit_byte(cb, 0xC0 | ((dst bit_and 7) shl 3) | (s2 bit_and 7));
    out cb;
end.

func avx_vmaxps:
    in(cb: CodeBuf, dst: int, s1: int, s2: int)
    cb = x86_vex2(cb, s1, 0, 0);
    cb = codebuf_emit_byte(cb, 0x5F);
    cb = codebuf_emit_byte(cb, 0xC0 | ((dst bit_and 7) shl 3) | (s2 bit_and 7));
    out cb;
end.

func avx_vmovaps_load:
    in(cb: CodeBuf, xmm_dst: int, base: int)
    cb = x86_vex2(cb, 0, 0, 0);
    cb = codebuf_emit_byte(cb, 0x28);
    cb = codebuf_emit_byte(cb, ((xmm_dst bit_and 7) shl 3) | (base bit_and 7));
    out cb;
end.

func avx_vmovaps_store:
    in(cb: CodeBuf, base: int, xmm_src: int)
    cb = x86_vex2(cb, 0, 0, 0);
    cb = codebuf_emit_byte(cb, 0x29);
    cb = codebuf_emit_byte(cb, ((xmm_src bit_and 7) shl 3) | (base bit_and 7));
    out cb;
end.

func avx_vbroadcastss:
    in(cb: CodeBuf, dst: int, src: int)
    # VEX.128.66.0F38 18 /r — 3-byte VEX
    cb = codebuf_emit_byte(cb, 0xC4);
    cb = codebuf_emit_byte(cb, 0xE2);
    cb = codebuf_emit_byte(cb, 0x79);
    cb = codebuf_emit_byte(cb, 0x18);
    cb = codebuf_emit_byte(cb, 0xC0 | ((dst bit_and 7) shl 3) | (src bit_and 7));
    out cb;
end.

func avx_vhaddps:
    in(cb: CodeBuf, dst: int, s1: int, s2: int)
    # VHADDPS: VEX.128.F2.0F 7C /r  (pp=11 for F2)
    cb = x86_vex2(cb, s1, 0, 3);
    cb = codebuf_emit_byte(cb, 0x7C);
    cb = codebuf_emit_byte(cb, 0xC0 | ((dst bit_and 7) shl 3) | (s2 bit_and 7));
    out cb;
end.

# ═══════════════════════════════════════════════════════
# ARM64 Instruction Emitters
# ═══════════════════════════════════════════════════════

func arm64_add_rrr:
    in(cb: CodeBuf, rd: int, rn: int, rm: int)
    # ADD Xd, Xn, Xm -> 0x8B000000
    instr = 0x8B000000 | (((rm bit_and 0x1F)) shl 16) | (((rn bit_and 0x1F)) shl 5) | (rd bit_and 0x1F);
    out codebuf_emit_u32(cb, instr);
end.

func arm64_sub_rrr:
    in(cb: CodeBuf, rd: int, rn: int, rm: int)
    # SUB Xd, Xn, Xm -> 0xCB000000
    instr = 0xCB000000 | (((rm bit_and 0x1F)) shl 16) | (((rn bit_and 0x1F)) shl 5) | (rd bit_and 0x1F);
    out codebuf_emit_u32(cb, instr);
end.

func arm64_mul_rrr:
    in(cb: CodeBuf, rd: int, rn: int, rm: int)
    # MUL = MADD Xd, Xn, Xm, XZR -> 0x9B007C00
    instr = 0x9B007C00 | (((rm bit_and 0x1F)) shl 16) | (((rn bit_and 0x1F)) shl 5) | (rd bit_and 0x1F);
    out codebuf_emit_u32(cb, instr);
end.

func arm64_sdiv_rrr:
    in(cb: CodeBuf, rd: int, rn: int, rm: int)
    # SDIV Xd, Xn, Xm -> 0x9AC00C00
    instr = 0x9AC00C00 | (((rm bit_and 0x1F)) shl 16) | (((rn bit_and 0x1F)) shl 5) | (rd bit_and 0x1F);
    out codebuf_emit_u32(cb, instr);
end.

func arm64_mov_imm16:
    in(cb: CodeBuf, rd: int, imm: int)
    # MOVZ Xd, #imm16 -> 0xD2800000
    instr = 0xD2800000 | (((imm bit_and 0xFFFF)) shl 5) | (rd bit_and 0x1F);
    out codebuf_emit_u32(cb, instr);
end.

func arm64_movz_imm64:
    in(cb: CodeBuf, rd: int, imm: int)
    # Full 64-bit load: MOVZ + up to 3 MOVK
    uimm = imm;

    # MOVZ Xd, #imm16, LSL #0
    instr = 0xD2800000 | (((uimm bit_and 0xFFFF)) shl 5) | (rd bit_and 0x1F);
    cb = codebuf_emit_u32(cb, instr);

    # MOVK for bits [31:16]
    if (uimm shr 16) != 0 do
        instr = 0xF2A00000 | ((((uimm shr 16) bit_and 0xFFFF)) shl 5) | (rd bit_and 0x1F);
        cb = codebuf_emit_u32(cb, instr);
    end

    # MOVK for bits [47:32]
    if (uimm shr 32) != 0 do
        instr = 0xF2C00000 | ((((uimm shr 32) bit_and 0xFFFF)) shl 5) | (rd bit_and 0x1F);
        cb = codebuf_emit_u32(cb, instr);
    end

    # MOVK for bits [63:48]
    if (uimm shr 48) != 0 do
        instr = 0xF2E00000 | ((((uimm shr 48) bit_and 0xFFFF)) shl 5) | (rd bit_and 0x1F);
        cb = codebuf_emit_u32(cb, instr);
    end

    out cb;
end.

func arm64_mov_rr:
    in(cb: CodeBuf, rd: int, rm: int)
    # MOV = ORR Xd, XZR, Xm -> 0xAA0003E0
    instr = 0xAA0003E0 | (((rm bit_and 0x1F)) shl 16) | (rd bit_and 0x1F);
    out codebuf_emit_u32(cb, instr);
end.

func arm64_cmp_rr:
    in(cb: CodeBuf, rn: int, rm: int)
    # CMP = SUBS XZR, Xn, Xm -> 0xEB00001F
    instr = 0xEB00001F | (((rm bit_and 0x1F)) shl 16) | (((rn bit_and 0x1F)) shl 5);
    out codebuf_emit_u32(cb, instr);
end.

func arm64_cset_eq:
    in(cb: CodeBuf, rd: int)
    # CSET EQ = CSINC Xd, XZR, XZR, NE
    out codebuf_emit_u32(cb, 0x9A9F17E0 | (rd bit_and 0x1F));
end.

func arm64_cset_gt:
    in(cb: CodeBuf, rd: int)
    # CSET GT = CSINC Xd, XZR, XZR, LE
    out codebuf_emit_u32(cb, 0x9A9FD7E0 | (rd bit_and 0x1F));
end.

func arm64_cset_lt:
    in(cb: CodeBuf, rd: int)
    # CSET LT = CSINC Xd, XZR, XZR, GE
    out codebuf_emit_u32(cb, 0x9A9FA7E0 | (rd bit_and 0x1F));
end.

func arm64_cset_ge:
    in(cb: CodeBuf, rd: int)
    # CSET GE = CSINC Xd, XZR, XZR, LT
    out codebuf_emit_u32(cb, 0x9A9FB7E0 | (rd bit_and 0x1F));
end.

func arm64_cset_le:
    in(cb: CodeBuf, rd: int)
    # CSET LE = CSINC Xd, XZR, XZR, GT
    out codebuf_emit_u32(cb, 0x9A9FC7E0 | (rd bit_and 0x1F));
end.

func arm64_b_imm26:
    in(cb: CodeBuf, offset: int)
    # B offset -> 0x14000000
    imm26 = (offset shr 2) bit_and 0x03FFFFFF;
    out codebuf_emit_u32(cb, 0x14000000 | imm26);
end.

func arm64_beq_imm19:
    in(cb: CodeBuf, offset: int)
    # B.EQ -> 0x54000000
    imm19 = (offset shr 2) bit_and 0x7FFFF;
    out codebuf_emit_u32(cb, 0x54000000 | (imm19 shl 5));
end.

func arm64_bne_imm19:
    in(cb: CodeBuf, offset: int)
    # B.NE -> 0x54000001
    imm19 = (offset shr 2) bit_and 0x7FFFF;
    out codebuf_emit_u32(cb, 0x54000001 | (imm19 shl 5));
end.

func arm64_bl_imm26:
    in(cb: CodeBuf, offset: int)
    imm26 = (offset shr 2) bit_and 0x03FFFFFF;
    out codebuf_emit_u32(cb, 0x94000000 | imm26);
end.

func arm64_ret:
    in(cb: CodeBuf)
    out codebuf_emit_u32(cb, 0xD65F03C0);
end.

func arm64_nop:
    in(cb: CodeBuf)
    out codebuf_emit_u32(cb, 0xD503201F);
end.

func arm64_stp_pre:
    in(cb: CodeBuf, rt: int, rt2: int, rn: int, imm: int)
    # STP Xt, Xt2, [Xn, #imm]!
    simm7 = (imm / 8) bit_and 0x7F;
    instr = 0xA9800000 | ((simm7) shl 15) | (((rt2 bit_and 0x1F)) shl 10) | (((rn bit_and 0x1F)) shl 5) | (rt bit_and 0x1F);
    out codebuf_emit_u32(cb, instr);
end.

func arm64_ldp_post:
    in(cb: CodeBuf, rt: int, rt2: int, rn: int, imm: int)
    # LDP Xt, Xt2, [Xn], #imm
    simm7 = (imm / 8) bit_and 0x7F;
    instr = 0xA8C00000 | ((simm7) shl 15) | (((rt2 bit_and 0x1F)) shl 10) | (((rn bit_and 0x1F)) shl 5) | (rt bit_and 0x1F);
    out codebuf_emit_u32(cb, instr);
end.

func arm64_str_pre:
    in(cb: CodeBuf, rt: int, rn: int, imm: int)
    # STR Xt, [Xn, #imm]!
    simm9 = imm bit_and 0x1FF;
    instr = 0xF8000C00 | (simm9 shl 12) | (((rn bit_and 0x1F)) shl 5) | (rt bit_and 0x1F);
    out codebuf_emit_u32(cb, instr);
end.

func arm64_ldr_post:
    in(cb: CodeBuf, rt: int, rn: int, imm: int)
    # LDR Xt, [Xn], #imm
    simm9 = imm bit_and 0x1FF;
    instr = 0xF8400400 | (simm9 shl 12) | (((rn bit_and 0x1F)) shl 5) | (rt bit_and 0x1F);
    out codebuf_emit_u32(cb, instr);
end.

func arm64_svc:
    in(cb: CodeBuf, imm: int)
    g_emit_word = 0xD4000001 | (imm shl 5);
    out codebuf_emit_u32(cb, g_emit_word);
end.

func arm64_cmp_imm0:
    in(cb: CodeBuf, rn: int)
    # CMP Xn, #0 = SUBS XZR, Xn, #0
    out codebuf_emit_u32(cb, 0xF100001F | (((rn bit_and 0x1F)) shl 5));
end.

func arm64_blr_x16:
    in(cb: CodeBuf)
    # BLR X16 -> 0xD63F0200
    out codebuf_emit_u32(cb, 0xD63F0200);
end.

# ── ARM64 bitwise ──

func arm64_and_rrr:
    in(cb: CodeBuf, rd: int, rn: int, rm: int)
    instr = 0x8A000000 | (((rm bit_and 0x1F)) shl 16) | (((rn bit_and 0x1F)) shl 5) | (rd bit_and 0x1F);
    out codebuf_emit_u32(cb, instr);
end.

func arm64_orr_rrr:
    in(cb: CodeBuf, rd: int, rn: int, rm: int)
    instr = 0xAA000000 | (((rm bit_and 0x1F)) shl 16) | (((rn bit_and 0x1F)) shl 5) | (rd bit_and 0x1F);
    out codebuf_emit_u32(cb, instr);
end.

func arm64_eor_rrr:
    in(cb: CodeBuf, rd: int, rn: int, rm: int)
    instr = 0xCA000000 | (((rm bit_and 0x1F)) shl 16) | (((rn bit_and 0x1F)) shl 5) | (rd bit_and 0x1F);
    out codebuf_emit_u32(cb, instr);
end.

func arm64_lsl_rrr:
    in(cb: CodeBuf, rd: int, rn: int, rm: int)
    instr = 0x9AC02000 | (((rm bit_and 0x1F)) shl 16) | (((rn bit_and 0x1F)) shl 5) | (rd bit_and 0x1F);
    out codebuf_emit_u32(cb, instr);
end.

func arm64_asr_rrr:
    in(cb: CodeBuf, rd: int, rn: int, rm: int)
    instr = 0x9AC02800 | (((rm bit_and 0x1F)) shl 16) | (((rn bit_and 0x1F)) shl 5) | (rd bit_and 0x1F);
    out codebuf_emit_u32(cb, instr);
end.

# ── ARM64 memory ──

func arm64_ldrb_reg:
    in(cb: CodeBuf, rt: int, rn: int, rm: int)
    instr = 0x38606800 | (((rm bit_and 0x1F)) shl 16) | (((rn bit_and 0x1F)) shl 5) | (rt bit_and 0x1F);
    out codebuf_emit_u32(cb, instr);
end.

func arm64_strb_reg:
    in(cb: CodeBuf, rt: int, rn: int, rm: int)
    instr = 0x38206800 | (((rm bit_and 0x1F)) shl 16) | (((rn bit_and 0x1F)) shl 5) | (rt bit_and 0x1F);
    out codebuf_emit_u32(cb, instr);
end.

func arm64_ldr_reg:
    in(cb: CodeBuf, rt: int, rn: int, rm: int)
    # LDR Xt, [Xn, Xm, LSL #3]
    instr = 0xF8607800 | (((rm bit_and 0x1F)) shl 16) | (((rn bit_and 0x1F)) shl 5) | (rt bit_and 0x1F);
    out codebuf_emit_u32(cb, instr);
end.

func arm64_str_reg:
    in(cb: CodeBuf, rt: int, rn: int, rm: int)
    # STR Xt, [Xn, Xm, LSL #3]
    instr = 0xF8207800 | (((rm bit_and 0x1F)) shl 16) | (((rn bit_and 0x1F)) shl 5) | (rt bit_and 0x1F);
    out codebuf_emit_u32(cb, instr);
end.

func arm64_mov_sp_to:
    in(cb: CodeBuf, rd: int)
    # MOV Xd, SP → ADD Xd, SP, #0
    instr = 0x910003E0 | (rd bit_and 0x1F);
    out codebuf_emit_u32(cb, instr);
end.

func arm64_add_imm:
    in(cb: CodeBuf, rd: int, rn: int, imm12: int)
    # ADD Xd, Xn, #imm12
    instr = 0x91000000 | (((imm12 bit_and 0xFFF)) shl 10) | (((rn bit_and 0x1F)) shl 5) | (rd bit_and 0x1F);
    out codebuf_emit_u32(cb, instr);
end.

func arm64_ldr_imm:
    in(cb: CodeBuf, rt: int, rn: int, imm12: int)
    # LDR Xt, [Xn, #imm12] (unsigned offset, scaled by 8)
    # imm12 is byte offset, divide by 8 for encoding
    off = (imm12 / 8) bit_and 0xFFF;
    instr = 0xF9400000 | (off shl 10) | (((rn bit_and 0x1F)) shl 5) | (rt bit_and 0x1F);
    out codebuf_emit_u32(cb, instr);
end.

func arm64_str_imm:
    in(cb: CodeBuf, rt: int, rn: int, imm12: int)
    # STR Xt, [Xn, #imm12] (unsigned offset, scaled by 8)
    # imm12 is byte offset, divide by 8 for encoding
    off = (imm12 / 8) bit_and 0xFFF;
    instr = 0xF9000000 | (off shl 10) | (((rn bit_and 0x1F)) shl 5) | (rt bit_and 0x1F);
    out codebuf_emit_u32(cb, instr);
end.

# ═══════════════════════════════════════════════════════
# NEON (ARM64 SIMD) Instruction Emitters
# ═══════════════════════════════════════════════════════

func neon_ld1_4s:
    in(cb: CodeBuf, vt: int, xn: int)
    out codebuf_emit_u32(cb, 0x4C40A800 | ((xn bit_and 0x1F) shl 5) | (vt bit_and 0x1F));
end.

func neon_st1_4s:
    in(cb: CodeBuf, vt: int, xn: int)
    out codebuf_emit_u32(cb, 0x4C00A800 | ((xn bit_and 0x1F) shl 5) | (vt bit_and 0x1F));
end.

func neon_add_4s:
    in(cb: CodeBuf, vd: int, vn: int, vm: int)
    enc = 0x4EA08400 | ((vm bit_and 0x1F) shl 16) | ((vn bit_and 0x1F) shl 5) | (vd bit_and 0x1F);
    out codebuf_emit_u32(cb, enc);
end.

func neon_sub_4s:
    in(cb: CodeBuf, vd: int, vn: int, vm: int)
    enc = 0x6EA08400 | ((vm bit_and 0x1F) shl 16) | ((vn bit_and 0x1F) shl 5) | (vd bit_and 0x1F);
    out codebuf_emit_u32(cb, enc);
end.

func neon_mul_4s:
    in(cb: CodeBuf, vd: int, vn: int, vm: int)
    enc = 0x4EA09C00 | ((vm bit_and 0x1F) shl 16) | ((vn bit_and 0x1F) shl 5) | (vd bit_and 0x1F);
    out codebuf_emit_u32(cb, enc);
end.

func neon_fadd_4s:
    in(cb: CodeBuf, vd: int, vn: int, vm: int)
    enc = 0x4E20D400 | ((vm bit_and 0x1F) shl 16) | ((vn bit_and 0x1F) shl 5) | (vd bit_and 0x1F);
    out codebuf_emit_u32(cb, enc);
end.

func neon_fmul_4s:
    in(cb: CodeBuf, vd: int, vn: int, vm: int)
    enc = 0x6E20DC00 | ((vm bit_and 0x1F) shl 16) | ((vn bit_and 0x1F) shl 5) | (vd bit_and 0x1F);
    out codebuf_emit_u32(cb, enc);
end.

func neon_fdiv_4s:
    in(cb: CodeBuf, vd: int, vn: int, vm: int)
    enc = 0x6E20FC00 | ((vm bit_and 0x1F) shl 16) | ((vn bit_and 0x1F) shl 5) | (vd bit_and 0x1F);
    out codebuf_emit_u32(cb, enc);
end.

func neon_fmla_4s:
    in(cb: CodeBuf, vd: int, vn: int, vm: int)
    enc = 0x4E20CC00 | ((vm bit_and 0x1F) shl 16) | ((vn bit_and 0x1F) shl 5) | (vd bit_and 0x1F);
    out codebuf_emit_u32(cb, enc);
end.

func neon_smin_4s:
    in(cb: CodeBuf, vd: int, vn: int, vm: int)
    enc = 0x4EA06C00 | ((vm bit_and 0x1F) shl 16) | ((vn bit_and 0x1F) shl 5) | (vd bit_and 0x1F);
    out codebuf_emit_u32(cb, enc);
end.

func neon_smax_4s:
    in(cb: CodeBuf, vd: int, vn: int, vm: int)
    enc = 0x4EA06400 | ((vm bit_and 0x1F) shl 16) | ((vn bit_and 0x1F) shl 5) | (vd bit_and 0x1F);
    out codebuf_emit_u32(cb, enc);
end.

func neon_addv_4s:
    in(cb: CodeBuf, vd: int, vn: int)
    out codebuf_emit_u32(cb, 0x4EB1B800 | ((vn bit_and 0x1F) shl 5) | (vd bit_and 0x1F));
end.

func neon_dup_4s_gpr:
    in(cb: CodeBuf, vd: int, xn: int)
    out codebuf_emit_u32(cb, 0x4E040C00 | ((xn bit_and 0x1F) shl 5) | (vd bit_and 0x1F));
end.

func neon_tbl_16b:
    in(cb: CodeBuf, vd: int, vn: int, vm: int)
    enc = 0x4E000000 | ((vm bit_and 0x1F) shl 16) | ((vn bit_and 0x1F) shl 5) | (vd bit_and 0x1F);
    out codebuf_emit_u32(cb, enc);
end.

# ═══════════════════════════════════════════════════════
# Virtual Register -> Physical Register Mapping
# ═══════════════════════════════════════════════════════

func vreg_to_x86:
    in(vreg: int)
    # RAX=0, RCX=1, RDX=2, RSI=6, RDI=7, R8-R11, RBX=3, R12-R15
    reg_map = [0, 1, 2, 6, 7, 8, 9, 10, 11, 3, 12, 13, 14, 15];
    if vreg >= 0 and vreg < 14 do
        out reg_map[vreg];
    end
    out 0  # spill to RAX;
end.

func vreg_to_arm:
    in(vreg: int)
    # vreg 0-9  → X19-X28 (callee-saved)
    # vreg 10-15 → X9-X14 (caller-saved, spilled around calls)
    # vreg >= 16 → X8 (spilled to stack, loaded/stored around each instruction)
    if vreg >= 0 and vreg <= 9 do
        out vreg + 19;
    end
    if vreg >= 10 and vreg <= 15 do
        out vreg - 1  # vreg10→X9, vreg11→X10, ..., vreg15→X14;
    end
    out 8  # spill to X8;
end.

func vreg_to_neon:
    in(vreg: int)
    if vreg >= 0 and vreg < 16 do
        out vreg;
    end
    out 0;
end.

func vreg_to_xmm:
    in(vreg: int)
    if vreg >= 0 and vreg < 8 do
        out vreg;
    end
    out 0;
end.

# ═══════════════════════════════════════════════════════
# Back-Patching Infrastructure
# ═══════════════════════════════════════════════════════

const CG_MAX_LABELS = 1024;
const CG_MAX_FIXUPS = 4096;

entity CgLabel:
    label_id:   int;
    offset:     int;
end.

entity CgFixup:
    patch_offset:   int;
    target_label:   int;
    is_cond:        int;
end.

entity PatchState:
    # Use vec_rt for all arrays (arr_push on entity fields broken in C VM)
    label_ids:      int;
    label_offsets:  int;
    fixup_offsets:  int;
    fixup_targets:  int;
    fixup_conds:    int;
    label_count:    int;
    fixup_count:    int;
end.

func patch_new:
    out PatchState {
        label_ids: vec_new_rt(),
        label_offsets: vec_new_rt(),
        fixup_offsets: vec_new_rt(),
        fixup_targets: vec_new_rt(),
        fixup_conds: vec_new_rt(),
        label_count: 0,
        fixup_count: 0
    };
end.

func patch_add_label:
    in(ps: PatchState, label_id: int, offset: int)
    if ps.label_count < CG_MAX_LABELS do
        vec_push_rt(ps.label_ids, label_id);
        vec_push_rt(ps.label_offsets, offset);
        ps.label_count = ps.label_count + 1;
    end
    out ps;
end.

func patch_add_fixup:
    in(ps: PatchState, patch_offset: int, target_label: int, is_cond: int)
    if ps.fixup_count < CG_MAX_FIXUPS do
        vec_push_rt(ps.fixup_offsets, patch_offset);
        vec_push_rt(ps.fixup_targets, target_label);
        vec_push_rt(ps.fixup_conds, is_cond);
        ps.fixup_count = ps.fixup_count + 1;
    end
    out ps;
end.

func patch_find_label:
    in(ps: PatchState, label_id: int)
    i = 0;
    when i < ps.label_count loop
        if vec_get_rt(ps.label_ids, i) == label_id do
            out vec_get_rt(ps.label_offsets, i);
        end
        i = i + 1;
    end
    out -1  # not found;
end.

func backpatch_x86:
    in(cb: CodeBuf, ps: PatchState)
    f = 0;
    when f < ps.fixup_count loop
        target = patch_find_label(ps, vec_get_rt(ps.fixup_targets, f));
        if target >= 0 do
            patch_at = vec_get_rt(ps.fixup_offsets, f);
            instr_end = patch_at + 4;
            rel = target - instr_end;
            cb = codebuf_patch_i32(cb, patch_at, rel);
        end
        f = f + 1;
    end
    out cb;
end.

func backpatch_arm64:
    in(cb: CodeBuf, ps: PatchState)
    f = 0;
    when f < ps.fixup_count loop
        target = patch_find_label(ps, vec_get_rt(ps.fixup_targets, f));
        if target >= 0 do
            patch_at = vec_get_rt(ps.fixup_offsets, f);
            byte_offset = target - patch_at;
            # Read original instruction (little-endian)
            orig = vec_get_rt(cb.data, patch_at) | (vec_get_rt(cb.data, patch_at + 1) shl 8) | (vec_get_rt(cb.data, patch_at + 2) shl 16) | (vec_get_rt(cb.data, patch_at + 3) shl 24);
            if vec_get_rt(ps.fixup_conds, f) == 1 do
                # B.cond: imm19 at bits [23:5]
                imm19 = (byte_offset shr 2) bit_and 0x7FFFF;
                orig = (orig bit_and (~(0x7FFFF shl 5))) | (imm19 shl 5);
            else
                # B / BL: imm26 at bits [25:0]
                imm26 = (byte_offset shr 2) bit_and 0x03FFFFFF;
                orig = (orig bit_and (~0x03FFFFFF)) | imm26;
            end
            cb = codebuf_patch_u32(cb, patch_at, orig);
        end
        f = f + 1;
    end
    out cb;
end.

func backpatch:
    in(cb: CodeBuf, ps: PatchState)
    if cb.arch == TargetArch.ARM64 do
        out backpatch_arm64(cb, ps);
    else
        out backpatch_x86(cb, ps);
    end
end.

# ═══════════════════════════════════════════════════════
# Q-IR Opcodes — MUST match ir_optimizer enum above
# ═══════════════════════════════════════════════════════

enum QOp:
    Nop             = 0;
    Load            = 1;
    Move            = 2;
    Add             = 3;
    Sub             = 4;
    Mul             = 5;
    Div             = 6;
    Mod             = 7;
    And             = 8;
    Or              = 9;
    Xor             = 10;
    Shl             = 11;
    Shr             = 12;
    CmpEq           = 20;
    CmpNe           = 21;
    CmpGt           = 22;
    CmpLt           = 23;
    CmpGe           = 24;
    CmpLe           = 25;
    Jump            = 30;
    JumpIfNot       = 31;
    Label           = 32;
    Call            = 33;
    CallFunc        = 34;
    Ret             = 35;
    Print           = 40;
    PrintStr        = 41;
    Input           = 42;
    Alloc           = 50;
    Free            = 51;
    LoadByte        = 52;
    StoreByte       = 53;
    LoadWord        = 54;
    StoreWord       = 55;
    ArrNew          = 60;
    ArrPush         = 61;
    ArrGet          = 62;
    ArrSet          = 63;
    ArrLen          = 64;
    StrLenOp        = 70;
    StrGet          = 71;
    StrCat          = 72;
    StrEq           = 73;
    IToStr          = 74;
    StrToI          = 75;
    FileOpen        = 80;
    FileRead        = 81;
    FileWrite       = 82;
    FileClose       = 83;
    FileWriteByte   = 84;
    Exit            = 90;
    PatchPoint      = 91;
    LoadGlobal      = 92;
    StoreGlobal     = 93;
    GetArg          = 94;
    ArgCount        = 95;
    SetArg          = 96;
    LoadFuncAddr    = 97;
end.

# ═══════════════════════════════════════════════════════
# Operand Types
# ═══════════════════════════════════════════════════════

enum OpndType:
    None    = 0;
    VReg    = 1;
    Imm     = 2;
    Label   = 3;
    StrRef  = 4;
    FuncIdx = 5;
end.

entity Operand:
    kind:       OpndType;
    vreg:       int;
    imm:        int;
    label:      int;
    str_idx:    int;
    func_idx:   int;
end.

func opnd_none:
    out Operand ( kind: OpndType::None, vreg: 0, imm: 0, label: 0, str_idx: 0, func_idx: 0 );
end.

func opnd_vreg:
    in(v: int)
    out Operand ( kind: OpndType::VReg, vreg: v, imm: 0, label: 0, str_idx: 0, func_idx: 0 );
end.

func opnd_imm:
    in(v: int)
    out Operand ( kind: OpndType::Imm, vreg: 0, imm: v, label: 0, str_idx: 0, func_idx: 0 );
end.

func opnd_label:
    in(v: int)
    out Operand ( kind: OpndType::Label, vreg: 0, imm: 0, label: v, str_idx: 0, func_idx: 0 );
end.

# ═══════════════════════════════════════════════════════
# Instruction
# ═══════════════════════════════════════════════════════

entity QInstr:
    opcode:     QOp;
    dest:       Operand
    src1:       Operand
    src2:       Operand
    patch_id:   int;
end.

# ═══════════════════════════════════════════════════════
# codegen_emit_fast — Register-Direct Code Generation
# ═══════════════════════════════════════════════════════
# This is the main code-generation dispatch.
# Takes a list of Q-IR instructions and emits machine code.

func emit_fast_x86:
    in(cb: CodeBuf, instrs:[QInstr], count: int)
    ps = patch_new();

    # Check if stack frame needed
    needs_frame = 0;
    check = 0;
    when check < count loop
        op = instrs[check].opcode;
        if op == QOp.Call or op == QOp.CallFunc or op == QOp.Print do
            needs_frame = 1;
        end
        check = check + 1;
    end

    # Prologue
    if needs_frame == 1 do
        cb = x86_push(cb, 5)       # PUSH RBP;
        cb = x86_mov_rr(cb, 5, 4)  # MOV RBP, RSP;
    end

    i = 0;
    when i < count loop
        ins = instrs[i];
        rd = 0;
        rs1 = 0;
        rs2 = 1;

        if ins.dest.kind == OpndType::VReg do
            rd = vreg_to_x86(ins.dest.vreg);
        end
        if ins.src1.kind == OpndType::VReg do
            rs1 = vreg_to_x86(ins.src1.vreg);
        end
        if ins.src2.kind == OpndType::VReg do
            rs2 = vreg_to_x86(ins.src2.vreg);
        end

        if ins.opcode == QOp.Nop do
            cb = x86_nop(cb);

        eif ins.opcode == QOp.Load do
            if ins.src1.kind == OpndType::Imm do
                cb = x86_mov_reg_imm64(cb, rd, ins.src1.imm);
            end

        eif ins.opcode == QOp.Store or ins.opcode == QOp.Move do
            cb = x86_mov_rr(cb, rd, rs1);

        eif ins.opcode == QOp.Add do
            if rd != rs1 do
                cb = x86_mov_rr(cb, rd, rs1);
            end
            cb = x86_add_rr(cb, rd, rs2);

        eif ins.opcode == QOp.Sub do
            if rd != rs1 do
                cb = x86_mov_rr(cb, rd, rs1);
            end
            cb = x86_sub_rr(cb, rd, rs2);

        eif ins.opcode == QOp.Mul do
            if rd != rs1 do
                cb = x86_mov_rr(cb, rd, rs1);
            end
            cb = x86_imul_rr(cb, rd, rs2);

        eif ins.opcode == QOp.Div do
            if rs1 != 0 do # RAX do
                cb = x86_mov_rr(cb, 0, rs1);
            end
            cb = x86_cqo(cb);
            cb = x86_idiv(cb, rs2);
            if rd != 0 do
                cb = x86_mov_rr(cb, rd, 0);
            end

        eif ins.opcode == QOp.Mod do
            if rs1 != 0 do
                cb = x86_mov_rr(cb, 0, rs1);
            end
            cb = x86_cqo(cb);
            cb = x86_idiv(cb, rs2);
            if rd != 2 do # RDX do
                cb = x86_mov_rr(cb, rd, 2);
            end

        eif ins.opcode == QOp.CmpEq do
            cb = x86_cmp_rr(cb, rs1, rs2);
            cb = x86_xor_rr(cb, rd, rd);
            cb = x86_sete(cb, rd);

        eif ins.opcode == QOp.CmpGt do
            cb = x86_cmp_rr(cb, rs1, rs2);
            cb = x86_xor_rr(cb, rd, rd);
            cb = x86_setg(cb, rd);

        eif ins.opcode == QOp.CmpLt do
            cb = x86_cmp_rr(cb, rs1, rs2);
            cb = x86_xor_rr(cb, rd, rd);
            cb = x86_setl(cb, rd);

        eif ins.opcode == QOp.CmpGe do
            cb = x86_cmp_rr(cb, rs1, rs2);
            cb = x86_xor_rr(cb, rd, rd);
            cb = x86_setge(cb, rd);

        eif ins.opcode == QOp.CmpLe do
            cb = x86_cmp_rr(cb, rs1, rs2);
            cb = x86_xor_rr(cb, rd, rd);
            cb = x86_setle(cb, rd);

        eif ins.opcode == QOp.And do
            if rd != rs1 do
                cb = x86_mov_rr(cb, rd, rs1);
            end
            cb = x86_and_rr(cb, rd, rs2);

        eif ins.opcode == QOp.Or do
            if rd != rs1 do
                cb = x86_mov_rr(cb, rd, rs1);
            end
            cb = x86_or_rr(cb, rd, rs2);

        eif ins.opcode == QOp.Xor do
            if rd != rs1 do
                cb = x86_mov_rr(cb, rd, rs1);
            end
            cb = x86_xor_rr(cb, rd, rs2);

        eif ins.opcode == QOp.Shl do
            if rd != rs1 do
                cb = x86_mov_rr(cb, rd, rs1);
            end
            if rs2 != 1 do # RCX do
                cb = x86_mov_rr(cb, 1, rs2);
            end
            cb = x86_shl_cl(cb, rd);

        eif ins.opcode == QOp.Shr do
            if rd != rs1 do
                cb = x86_mov_rr(cb, rd, rs1);
            end
            if rs2 != 1 do # RCX do
                cb = x86_mov_rr(cb, 1, rs2);
            end
            cb = x86_sar_cl(cb, rd);

        eif ins.opcode == QOp.Label do
            ps = patch_add_label(ps, ins.patch_id, codebuf_offset(cb));

        eif ins.opcode == QOp.Jump do
            if ins.src1.kind == OpndType::Label do
                ps = patch_add_fixup(ps, codebuf_offset(cb) + 1, ins.src1.label, 0);
            end
            cb = x86_jmp_rel32(cb, 0);

        eif ins.opcode == QOp.JumpIf do
            if ins.src1.kind == OpndType::VReg do
                cb = x86_test_rr(cb, rs1);
            end
            if ins.src2.kind == OpndType::Label do
                ps = patch_add_fixup(ps, codebuf_offset(cb) + 2, ins.src2.label, 1);
            end
            cb = x86_jne_rel32(cb, 0);

        eif ins.opcode == QOp.JumpIfNot do
            if ins.src1.kind == OpndType::VReg do
                cb = x86_test_rr(cb, rs1);
            end
            if ins.src2.kind == OpndType::Label do
                ps = patch_add_fixup(ps, codebuf_offset(cb) + 2, ins.src2.label, 1);
            end
            cb = x86_je_rel32(cb, 0);

        eif ins.opcode == QOp.Call or ins.opcode == QOp.CallFunc do
            if ins.src1.kind == OpndType::Label do
                ps = patch_add_fixup(ps, codebuf_offset(cb) + 1, ins.src1.label, 0);
            eif ins.src1.kind == OpndType::FuncIdx do
                ps = patch_add_fixup(ps, codebuf_offset(cb) + 1, ins.src1.func_idx, 0);
            end
            cb = x86_call_rel32(cb, 0);

        eif ins.opcode == QOp.Ret do
            if ins.src1.kind == OpndType::VReg and rs1 != 0 do
                cb = x86_mov_rr(cb, 0, rs1);
            end
            if needs_frame == 1 do
                cb = x86_mov_rr(cb, 4, 5)  # MOV RSP, RBP;
                cb = x86_pop(cb, 5)         # POP RBP;
            end
            cb = x86_ret(cb);

        eif ins.opcode == QOp.Halt do
            cb = x86_xor_rr(cb, 0, 0);
            cb = x86_ret(cb);

        eif ins.opcode == QOp.PatchPoint do
            cb = x86_nop(cb);

        # SIMD (AVX)
        eif ins.opcode == QOp.VLoad do
            xd = vreg_to_xmm(ins.dest.vreg);
            base = 0;
            if ins.src1.kind == OpndType::VReg do
                base = vreg_to_x86(ins.src1.vreg);
            end
            cb = avx_vmovaps_load(cb, xd, base);

        eif ins.opcode == QOp.VStore do
            xs = vreg_to_xmm(ins.src1.vreg);
            base = 0;
            if ins.dest.kind == OpndType::VReg do
                base = vreg_to_x86(ins.dest.vreg);
            end
            cb = avx_vmovaps_store(cb, base, xs);

        eif ins.opcode == QOp.VAdd do
            cb = avx_vaddps(cb, vreg_to_xmm(ins.dest.vreg), vreg_to_xmm(ins.src1.vreg), vreg_to_xmm(ins.src2.vreg));

        eif ins.opcode == QOp.VSub do
            cb = avx_vsubps(cb, vreg_to_xmm(ins.dest.vreg), vreg_to_xmm(ins.src1.vreg), vreg_to_xmm(ins.src2.vreg));

        eif ins.opcode == QOp.VMul do
            cb = avx_vmulps(cb, vreg_to_xmm(ins.dest.vreg), vreg_to_xmm(ins.src1.vreg), vreg_to_xmm(ins.src2.vreg));

        eif ins.opcode == QOp.VFma do
            d = vreg_to_xmm(ins.dest.vreg);
            s1 = vreg_to_xmm(ins.src1.vreg);
            s2 = vreg_to_xmm(ins.src2.vreg);
            cb = avx_vmulps(cb, d, s1, s2);
            cb = avx_vaddps(cb, d, d, d);

        eif ins.opcode == QOp.VDiv do
            cb = avx_vdivps(cb, vreg_to_xmm(ins.dest.vreg), vreg_to_xmm(ins.src1.vreg), vreg_to_xmm(ins.src2.vreg));

        eif ins.opcode == QOp.VMin do
            cb = avx_vminps(cb, vreg_to_xmm(ins.dest.vreg), vreg_to_xmm(ins.src1.vreg), vreg_to_xmm(ins.src2.vreg));

        eif ins.opcode == QOp.VMax do
            cb = avx_vmaxps(cb, vreg_to_xmm(ins.dest.vreg), vreg_to_xmm(ins.src1.vreg), vreg_to_xmm(ins.src2.vreg));

        eif ins.opcode == QOp.VReduce do
            d = vreg_to_xmm(ins.dest.vreg);
            s = vreg_to_xmm(ins.src1.vreg);
            cb = avx_vhaddps(cb, d, s, s);
            cb = avx_vhaddps(cb, d, d, d);

        eif ins.opcode == QOp.VSplat do
            cb = avx_vbroadcastss(cb, vreg_to_xmm(ins.dest.vreg), vreg_to_xmm(ins.src1.vreg));

        else
            cb = x86_nop(cb);
        end

        i = i + 1;
    end

    # Back-patch
    cb = backpatch_x86(cb, ps);
    out cb;
end.

func emit_fast_arm64:
    in(cb: CodeBuf, instrs:[QInstr], count: int)
    ps = patch_new();

    # Check if stack frame needed
    needs_frame = 0;
    check = 0;
    when check < count loop
        op = instrs[check].opcode;
        if op == QOp.Call or op == QOp.CallFunc or op == QOp.Print do
            needs_frame = 1;
        end
        check = check + 1;
    end

    # Prologue
    if needs_frame == 1 do
        cb = arm64_stp_pre(cb, 29, 30, 31, -16)  # STP X29, X30, [SP, #-16]!;
    end

    i = 0;
    when i < count loop
        ins = instrs[i];
        rd = 0;
        rs1 = 0;
        rs2 = 1;

        if ins.dest.kind == OpndType::VReg do
            rd = vreg_to_arm(ins.dest.vreg);
        end
        if ins.src1.kind == OpndType::VReg do
            rs1 = vreg_to_arm(ins.src1.vreg);
        end
        if ins.src2.kind == OpndType::VReg do
            rs2 = vreg_to_arm(ins.src2.vreg);
        end

        if ins.opcode == QOp.Nop do
            cb = arm64_nop(cb);

        eif ins.opcode == QOp.Load do
            if ins.src1.kind == OpndType::Imm do
                cb = arm64_movz_imm64(cb, rd, ins.src1.imm);
            end

        eif ins.opcode == QOp.Store or ins.opcode == QOp.Move do
            cb = arm64_mov_rr(cb, rd, rs1);

        eif ins.opcode == QOp.Add do
            cb = arm64_add_rrr(cb, rd, rs1, rs2);

        eif ins.opcode == QOp.Sub do
            cb = arm64_sub_rrr(cb, rd, rs1, rs2);

        eif ins.opcode == QOp.Mul do
            cb = arm64_mul_rrr(cb, rd, rs1, rs2);

        eif ins.opcode == QOp.Div do
            cb = arm64_sdiv_rrr(cb, rd, rs1, rs2);

        eif ins.opcode == QOp.Mod do
            # X16 = SDIV(rs1, rs2); rd = rs1 - X16 * rs2
            cb = arm64_sdiv_rrr(cb, 16, rs1, rs2);
            cb = arm64_mul_rrr(cb, 16, 16, rs2);
            cb = arm64_sub_rrr(cb, rd, rs1, 16);

        eif ins.opcode == QOp.CmpEq do
            cb = arm64_cmp_rr(cb, rs1, rs2);
            cb = arm64_cset_eq(cb, rd);

        eif ins.opcode == QOp.CmpGt do
            cb = arm64_cmp_rr(cb, rs1, rs2);
            cb = arm64_cset_gt(cb, rd);

        eif ins.opcode == QOp.CmpLt do
            cb = arm64_cmp_rr(cb, rs1, rs2);
            cb = arm64_cset_lt(cb, rd);

        eif ins.opcode == QOp.CmpGe do
            cb = arm64_cmp_rr(cb, rs1, rs2);
            cb = arm64_cset_ge(cb, rd);

        eif ins.opcode == QOp.CmpLe do
            cb = arm64_cmp_rr(cb, rs1, rs2);
            cb = arm64_cset_le(cb, rd);

        eif ins.opcode == QOp.And do
            cb = arm64_and_rrr(cb, rd, rs1, rs2);

        eif ins.opcode == QOp.Or do
            cb = arm64_orr_rrr(cb, rd, rs1, rs2);

        eif ins.opcode == QOp.Xor do
            cb = arm64_eor_rrr(cb, rd, rs1, rs2);

        eif ins.opcode == QOp.Shl do
            cb = arm64_lsl_rrr(cb, rd, rs1, rs2);

        eif ins.opcode == QOp.Shr do
            cb = arm64_asr_rrr(cb, rd, rs1, rs2);

        eif ins.opcode == QOp.Label do
            ps = patch_add_label(ps, ins.patch_id, codebuf_offset(cb));

        eif ins.opcode == QOp.Jump do
            if ins.src1.kind == OpndType::Label do
                ps = patch_add_fixup(ps, codebuf_offset(cb), ins.src1.label, 0);
            end
            cb = arm64_b_imm26(cb, 0);

        eif ins.opcode == QOp.JumpIf do
            if ins.src1.kind == OpndType::VReg do
                cb = arm64_cmp_imm0(cb, rs1);
            end
            if ins.src2.kind == OpndType::Label do
                ps = patch_add_fixup(ps, codebuf_offset(cb), ins.src2.label, 1);
            end
            cb = arm64_bne_imm19(cb, 0);

        eif ins.opcode == QOp.JumpIfNot do
            if ins.src1.kind == OpndType::VReg do
                cb = arm64_cmp_imm0(cb, rs1);
            end
            if ins.src2.kind == OpndType::Label do
                ps = patch_add_fixup(ps, codebuf_offset(cb), ins.src2.label, 1);
            end
            cb = arm64_beq_imm19(cb, 0);

        eif ins.opcode == QOp.Call or ins.opcode == QOp.CallFunc do
            if ins.src1.kind == OpndType::Label do
                ps = patch_add_fixup(ps, codebuf_offset(cb), ins.src1.label, 0);
            eif ins.src1.kind == OpndType::FuncIdx do
                ps = patch_add_fixup(ps, codebuf_offset(cb), ins.src1.func_idx, 0);
            end
            cb = arm64_bl_imm26(cb, 0);

        eif ins.opcode == QOp.Ret do
            if ins.src1.kind == OpndType::VReg and rs1 != 0 do
                cb = arm64_mov_rr(cb, 0, rs1);
            end
            if needs_frame == 1 do
                cb = arm64_ldp_post(cb, 29, 30, 31, 16);
            end
            cb = arm64_ret(cb);

        eif ins.opcode == QOp.Halt do
            cb = arm64_mov_imm16(cb, 0, 0);
            cb = arm64_ret(cb);

        eif ins.opcode == QOp.PatchPoint do
            cb = arm64_nop(cb);

        # Memory
        eif ins.opcode == QOp.LoadByte do
            cb = arm64_ldrb_reg(cb, rd, rs1, rs2);

        eif ins.opcode == QOp.StoreByte do
            val = 0;
            if ins.dest.kind == OpndType::VReg do
                val = vreg_to_arm(ins.dest.vreg);
            end
            cb = arm64_strb_reg(cb, val, rs1, rs2);

        eif ins.opcode == QOp.LoadWord do
            cb = arm64_ldr_reg(cb, rd, rs1, rs2);

        eif ins.opcode == QOp.StoreWord do
            val = 0;
            if ins.dest.kind == OpndType::VReg do
                val = vreg_to_arm(ins.dest.vreg);
            end
            cb = arm64_str_reg(cb, val, rs1, rs2);

        # SIMD (NEON)
        eif ins.opcode == QOp.VLoad do
            cb = neon_ld1_4s(cb, vreg_to_neon(ins.dest.vreg), rs1);

        eif ins.opcode == QOp.VStore do
            base = 0;
            if ins.dest.kind == OpndType::VReg do
                base = vreg_to_arm(ins.dest.vreg);
            end
            cb = neon_st1_4s(cb, vreg_to_neon(ins.src1.vreg), base);

        eif ins.opcode == QOp.VAdd do
            cb = neon_add_4s(cb, vreg_to_neon(ins.dest.vreg), vreg_to_neon(ins.src1.vreg), vreg_to_neon(ins.src2.vreg));

        eif ins.opcode == QOp.VSub do
            cb = neon_sub_4s(cb, vreg_to_neon(ins.dest.vreg), vreg_to_neon(ins.src1.vreg), vreg_to_neon(ins.src2.vreg));

        eif ins.opcode == QOp.VMul do
            cb = neon_mul_4s(cb, vreg_to_neon(ins.dest.vreg), vreg_to_neon(ins.src1.vreg), vreg_to_neon(ins.src2.vreg));

        eif ins.opcode == QOp.VFma do
            cb = neon_fmla_4s(cb, vreg_to_neon(ins.dest.vreg), vreg_to_neon(ins.src1.vreg), vreg_to_neon(ins.src2.vreg));

        eif ins.opcode == QOp.VDiv do
            cb = neon_fdiv_4s(cb, vreg_to_neon(ins.dest.vreg), vreg_to_neon(ins.src1.vreg), vreg_to_neon(ins.src2.vreg));

        eif ins.opcode == QOp.VMin do
            cb = neon_smin_4s(cb, vreg_to_neon(ins.dest.vreg), vreg_to_neon(ins.src1.vreg), vreg_to_neon(ins.src2.vreg));

        eif ins.opcode == QOp.VMax do
            cb = neon_smax_4s(cb, vreg_to_neon(ins.dest.vreg), vreg_to_neon(ins.src1.vreg), vreg_to_neon(ins.src2.vreg));

        eif ins.opcode == QOp.VReduce do
            cb = neon_addv_4s(cb, vreg_to_neon(ins.dest.vreg), vreg_to_neon(ins.src1.vreg));

        eif ins.opcode == QOp.VSplat do
            cb = neon_dup_4s_gpr(cb, vreg_to_neon(ins.dest.vreg), rs1);

        eif ins.opcode == QOp.VPerm do
            cb = neon_tbl_16b(cb, vreg_to_neon(ins.dest.vreg), vreg_to_neon(ins.src1.vreg), vreg_to_neon(ins.src2.vreg));

        else
            cb = arm64_nop(cb);
        end

        i = i + 1;
    end

    # Back-patch
    cb = backpatch_arm64(cb, ps);
    out cb;
end.

# ═══════════════════════════════════════════════════════
# Top-Level Code Generation Entry Points
# ═══════════════════════════════════════════════════════

func codegen_emit:
    in(instrs:[QInstr], count: int, arch: TargetArch)
    cb = codebuf_new(arch);
    if arch == TargetArch.ARM64 do
        cb = emit_fast_arm64(cb, instrs, count);
    else
        cb = emit_fast_x86(cb, instrs, count);
    end
    out cb;
end.

func codegen_emit_for_host:
    in(instrs:[QInstr], count: int)
    out codegen_emit(instrs, count, detect_arch());
end.

# ═══════════════════════════════════════════════════════
# Multi-Variant Code Generation
# ═══════════════════════════════════════════════════════

entity CodeVariant:
    patch_id:       int;
    safe_code:      CodeBuf;
    fast_code:      CodeBuf;
end.

entity CodegenResult:
    arch:       TargetArch;
    variants:   [CodeVariant];
    count:      int;
end.

func codegen_result_new:
    in(arch: TargetArch)
    out CodegenResult {
        arch: arch,
        variants: [],
        count: 0
    };
end.

# ═══════════════════════════════════════════════════════
# Hexdump Utility
# ═══════════════════════════════════════════════════════

func codebuf_hexdump:
    in(cb: CodeBuf)
    # Returns a list of hex byte values for inspection
    result = [];
    i = 0;
    when i < cb.len loop
        result = result + [vec_get_rt(cb.data, i)];
        i = i + 1;
    end
    out result;
end.

export codebuf_new, codebuf_emit_byte, codebuf_emit_u32, codebuf_emit_u64;
export codebuf_emit_i32, codebuf_offset, codebuf_patch_i32, codebuf_hexdump;
export CodeBuf, TargetArch, QOp, QInstr, Operand, OpndType;
export opnd_none, opnd_vreg, opnd_imm, opnd_label;
export codegen_emit, codegen_emit_for_host, detect_arch;
export emit_fast_x86, emit_fast_arm64;
export backpatch, backpatch_x86, backpatch_arm64;
export PatchState, patch_new, patch_add_label, patch_add_fixup;
export CodeVariant, CodegenResult, codegen_result_new;

# x86 emitters
export x86_add_rr, x86_sub_rr, x86_imul_rr, x86_mov_reg_imm64, x86_mov_reg_imm32;
export x86_mov_rr, x86_push, x86_pop, x86_ret, x86_nop, x86_jmp_rel32;
export x86_call_rel32, x86_cmp_rr, x86_sete, x86_setg, x86_setl, x86_setge, x86_setle;
export x86_je_rel32, x86_jne_rel32, x86_xor_rr, x86_and_rr, x86_or_rr;
export x86_shl_cl, x86_sar_cl, x86_idiv, x86_cqo, x86_syscall, x86_test_rr;
export rex_w, modrm;

# AVX emitters
export avx_vaddps, avx_vsubps, avx_vmulps, avx_vdivps;
export avx_vminps, avx_vmaxps, avx_vmovaps_load, avx_vmovaps_store;
export avx_vbroadcastss, avx_vhaddps, x86_vex2;

# ARM64 emitters
export arm64_add_rrr, arm64_sub_rrr, arm64_mul_rrr, arm64_sdiv_rrr;
export arm64_mov_imm16, arm64_movz_imm64, arm64_mov_rr;
export arm64_cmp_rr, arm64_cmp_imm0;
export arm64_cset_eq, arm64_cset_gt, arm64_cset_lt, arm64_cset_ge, arm64_cset_le;
export arm64_b_imm26, arm64_beq_imm19, arm64_bne_imm19, arm64_bl_imm26;
export arm64_ret, arm64_nop, arm64_stp_pre, arm64_ldp_post;
export arm64_str_pre, arm64_ldr_post, arm64_svc, arm64_blr_x16;
export arm64_and_rrr, arm64_orr_rrr, arm64_eor_rrr, arm64_lsl_rrr, arm64_asr_rrr;
export arm64_ldrb_reg, arm64_strb_reg, arm64_ldr_reg, arm64_str_reg;

# NEON emitters
export neon_ld1_4s, neon_st1_4s, neon_add_4s, neon_sub_4s, neon_mul_4s;
export neon_fadd_4s, neon_fmul_4s, neon_fdiv_4s, neon_fmla_4s;
export neon_smin_4s, neon_smax_4s, neon_addv_4s, neon_dup_4s_gpr, neon_tbl_16b;

# Register mapping
export vreg_to_x86, vreg_to_arm, vreg_to_neon, vreg_to_xmm;
export X86Reg, ArmReg;
# ══ END vir/compiler/codegen ══

# ══ BEGIN vir/compiler/main ══
##
 * vir/compiler/main.vri — Vir Self-Hosting Compiler Driver
 * =========================================================
 * Phase 5: Bootstrap — Vir compiles itself to a standalone binary.
 *
 * Pipeline:
 *   source.vri → lex → parse → lower → regalloc → codegen → link → Mach-O
 *
 * Produces a standalone Mach-O ARM64 executable that uses direct
 * BSD syscalls — no Python, no C library, no external linker needed.
 *
 * Usage (Stage 1 — bootstrapped via C runtime):
 *   vir jit stdlib/vir/compiler/main.vri <input.vri> [-o output]
 *
 * Usage (Stage 2 — self-hosted):
 *   ./virc <input.vri> [-o output]
 *
 * Date: 9/3/2026
 ##

extern func buf_write_u32_le();
extern func buf_write_u64_le();
extern func buf_write_zeros();
extern func buf_write_string_padded();
extern func buf_write_bytes();
extern func buf_size();
extern func buf_align();
extern func file_create();
extern func file_write_all();
extern func file_close();
extern func buf_new();
extern func buf_write_u8();
extern func slice_new();



# ═══════════════════════════════════════════════════════
# Mach-O Constants (macOS ARM64)
# ═══════════════════════════════════════════════════════

const MACHO_MAGIC: 0xFEEDFACF;
const CPU_ARM64: 0x0100000C;
const CPU_SUB_ALL: 0x00000000;
const MH_EXECUTE: 2;
const MH_FLAGS: 0x00200085    # PIE | TWOLEVEL | DYLDLINK;
const LC_SEGMENT_64: 0x19;
const LC_MAIN: 0x80000028;
const LC_SYMTAB: 0x02;
const TEXT_BASE: 0x100000000;
const PAGE_SIZE: 0x4000;

# macOS BSD syscall numbers (add 0x2000000 for BSD layer)
const SYS_EXIT: 0x2000001;
const SYS_WRITE: 0x2000004;
const SYS_CHMOD: 0x200000F;


# ═══════════════════════════════════════════════════════
# Module-Level Code Emission
# ═══════════════════════════════════════════════════════
# Emits all functions from a Q-IR module into a single
# code buffer with cross-function call resolution.

entity FuncLayout:
    name:       string;
    code_off:   int    # byte offset in the code buffer;
    fsize:      int;
end.

# Emit the ARM64 runtime stubs that compiled programs need:
#   offset 0: _rt_print_i64  — print integer to stdout + newline
#   offset N: _rt_exit       — exit process
# Returns (cb, print_offset, exit_offset, total_runtime_size)

func emit_runtime_arm64:
    in(cb: CodeBuf)
    g_rt_print_off = codebuf_offset(cb);

    # ── _rt_print_i64: all opcodes hardcoded (bootstrap VM clobbers arm64_* args) ──
    g_emit_word = 0xA9BA7BFD;
    cb = codebuf_emit_u32(cb, g_emit_word);
    g_emit_word = 0x910003FD;
    cb = codebuf_emit_u32(cb, g_emit_word);
    g_emit_word = 0xAA0003F3;
    cb = codebuf_emit_u32(cb, g_emit_word);
    g_emit_word = 0x910043F4;
    cb = codebuf_emit_u32(cb, g_emit_word);
    g_emit_word = 0xD2800015;
    cb = codebuf_emit_u32(cb, g_emit_word);
    g_emit_word = 0xD2800016;
    cb = codebuf_emit_u32(cb, g_emit_word);
    g_emit_word = 0xF100027F;
    cb = codebuf_emit_u32(cb, g_emit_word);
    cb = codebuf_emit_u32(cb, 0x5400006A);
    cb = codebuf_emit_u32(cb, 0xCB1303F3);
    g_emit_word = 0xD2800036;
    cb = codebuf_emit_u32(cb, g_emit_word);

    zero_check_patch = codebuf_offset(cb);
    cb = codebuf_emit_u32(cb, 0xB4000013);

    g_emit_word = 0xD2800157;
    cb = codebuf_emit_u32(cb, g_emit_word);
    digit_loop = codebuf_offset(cb);
    digits_done_patch = codebuf_offset(cb);
    cb = codebuf_emit_u32(cb, 0xB4000013);

    cb = codebuf_emit_u32(cb, 0x9AD70A78);
    cb = codebuf_emit_u32(cb, 0x9B17CF19);
    cb = codebuf_emit_u32(cb, 0x9100C339);
    cb = codebuf_emit_u32(cb, 0x38356A99);
    cb = codebuf_emit_u32(cb, 0x910006B5);
    g_emit_word = 0xAA1803F3;
    cb = codebuf_emit_u32(cb, g_emit_word);

    back = (digit_loop - codebuf_offset(cb)) / 4;
    g_mask_val = back - ((back shr 26) shl 26);
    cb = codebuf_emit_u32(cb, 0x14000000 | g_mask_val);
    skip_zero_patch = codebuf_offset(cb);
    cb = codebuf_emit_u32(cb, 0x14000000);

    is_zero = codebuf_offset(cb);
    g_emit_word = 0xD2800619;
    cb = codebuf_emit_u32(cb, g_emit_word);
    cb = codebuf_emit_u32(cb, 0x38356A99);
    cb = codebuf_emit_u32(cb, 0x910006B5);

    reverse_start = codebuf_offset(cb);

    zc_off = (is_zero - zero_check_patch) / 4;
    g_mask_val = zc_off - ((zc_off shr 19) shl 19);
    cb = codebuf_patch_u32(cb, zero_check_patch,
        0xB4000013 | (g_mask_val shl 5));

    dd_off = (reverse_start - digits_done_patch) / 4;
    g_mask_val = dd_off - ((dd_off shr 19) shl 19);
    cb = codebuf_patch_u32(cb, digits_done_patch,
        0xB4000013 | (g_mask_val shl 5));

    sz_off = (reverse_start - skip_zero_patch) / 4;
    g_mask_val = sz_off - ((sz_off shr 26) shl 26);
    cb = codebuf_patch_u32(cb, skip_zero_patch,
        0x14000000 | g_mask_val);

    skip_minus_patch = codebuf_offset(cb);
    cb = codebuf_emit_u32(cb, 0xB4000016);
    g_emit_word = 0xD28005B9;
    cb = codebuf_emit_u32(cb, g_emit_word);
    cb = codebuf_emit_u32(cb, 0x38356A99);
    cb = codebuf_emit_u32(cb, 0x910006B5);
    skip_minus = codebuf_offset(cb);
    sm_off = (skip_minus - skip_minus_patch) / 4;
    g_mask_val = sm_off - ((sm_off shr 19) shl 19);
    cb = codebuf_patch_u32(cb, skip_minus_patch,
        0xB4000016 | (g_mask_val shl 5));

    g_emit_word = 0xD2800017;
    cb = codebuf_emit_u32(cb, g_emit_word);
    g_emit_word = 0xAA1503F8;
    cb = codebuf_emit_u32(cb, g_emit_word);
    cb = codebuf_emit_u32(cb, 0xD1000718);

    rev_loop = codebuf_offset(cb);
    cb = codebuf_emit_u32(cb, 0xEB1802FF);
    rev_done_patch = codebuf_offset(cb);
    cb = codebuf_emit_u32(cb, 0x5400000A);

    cb = codebuf_emit_u32(cb, 0x38776A99);
    cb = codebuf_emit_u32(cb, 0x38786A9A);
    cb = codebuf_emit_u32(cb, 0x38376A9A);
    cb = codebuf_emit_u32(cb, 0x38386A99);
    cb = codebuf_emit_u32(cb, 0x910006F7);
    cb = codebuf_emit_u32(cb, 0xD1000718);

    rv_off = (rev_loop - codebuf_offset(cb)) / 4;
    g_mask_val = rv_off - ((rv_off shr 26) shl 26);
    cb = codebuf_emit_u32(cb, 0x14000000 | g_mask_val);

    rev_done = codebuf_offset(cb);
    rd_off = (rev_done - rev_done_patch) / 4;
    g_mask_val = rd_off - ((rd_off shr 19) shl 19);
    cb = codebuf_patch_u32(cb, rev_done_patch,
        0x5400000A | (g_mask_val shl 5));

    g_emit_word = 0xD2800159;
    cb = codebuf_emit_u32(cb, g_emit_word);
    cb = codebuf_emit_u32(cb, 0x38356A99);
    cb = codebuf_emit_u32(cb, 0x910006B5);

    g_emit_word = 0xD2800020;
    cb = codebuf_emit_u32(cb, g_emit_word);
    g_emit_word = 0xAA1403E1;
    cb = codebuf_emit_u32(cb, g_emit_word);
    g_emit_word = 0xAA1503E2;
    cb = codebuf_emit_u32(cb, g_emit_word);
    g_emit_word = 0xD2800090;
    cb = codebuf_emit_u32(cb, g_emit_word);
    cb = codebuf_emit_u32(cb, 0xF2A04010);
    g_emit_word = 0xD4001001;
    cb = codebuf_emit_u32(cb, g_emit_word);

    g_emit_word = 0xA8C67BFD;
    cb = codebuf_emit_u32(cb, g_emit_word);
    g_emit_word = 0xD65F03C0;
    cb = codebuf_emit_u32(cb, g_emit_word);

    if g_runtime_min != 0 do
        g_rt_exit_off = codebuf_offset(cb);
        g_emit_word = 0xD2800030;
        cb = codebuf_emit_u32(cb, g_emit_word);
        g_emit_word = 0xD4001001;
        cb = codebuf_emit_u32(cb, g_emit_word);
        out cb;
    end

    print_size = codebuf_offset(cb) - g_rt_print_off;

    # ── _rt_print_str: X0 = char ptr, X1 = length ──
    g_rt_printstr_off = codebuf_offset(cb);
    # STP X29, X30, [SP, #-16]!
    cb = arm64_stp_pre(cb, 29, 30, 31, -16);
    # MOV buffer and length to syscall args
    # write(1, buf, len) → X0=fd, X1=buf, X2=len
    cb = arm64_mov_rr(cb, 2, 1);               # X2 = len;
    cb = arm64_mov_rr(cb, 1, 0);               # X1 = buf;
    cb = arm64_mov_imm16(cb, 0, 1);            # X0 = 1 (stdout);
    cb = arm64_mov_imm16(cb, 16, 4);           # X16 = SYS_WRITE;
    cb = codebuf_emit_u32(cb, 0xF2A04010);     # MOVK X16, #0x200, LSL#16;
    cb = arm64_svc(cb, 128);
    # Print newline: write(1, "\n", 1)
    # Store '\n' on stack: MOV W17, #10; STRB W17, [SP, #-1]!
    cb = arm64_mov_imm16(cb, 17, 10);
    # STR byte on stack: SUB SP, SP, #16; STRB W17, [SP]
    cb = codebuf_emit_u32(cb, 0xD10043FF);     # SUB SP, SP, #16;
    cb = codebuf_emit_u32(cb, 0x390003F1);     # STRB W17, [SP];
    cb = arm64_mov_imm16(cb, 0, 1);            # fd = stdout;
    cb = arm64_mov_sp_to(cb, 1);               # buf = SP;
    cb = arm64_mov_imm16(cb, 2, 1);            # len = 1;
    cb = arm64_mov_imm16(cb, 16, 4);
    cb = codebuf_emit_u32(cb, 0xF2A04010);
    cb = arm64_svc(cb, 128);
    cb = codebuf_emit_u32(cb, 0x910043FF);     # ADD SP, SP, #16;
    cb = arm64_ldp_post(cb, 29, 30, 31, 16);
    cb = arm64_ret(cb);

    # ── _rt_strlen: X0 = ptr to null-terminated string → X0 = length ──
    local_strlen_off = codebuf_offset(cb);
    cb = arm64_mov_rr(cb, 1, 0);                # MOV X1, X0 (save base);
    # .loop: LDRB W2, [X0], #1
    cb = codebuf_emit_u32(cb, 0x38401402);      # LDRB W2, [X0], #1;
    # CBNZ W2, .loop (-1 instruction)
    cb = codebuf_emit_u32(cb, 0x35FFFFE2);      # CBNZ W2, -4;
    cb = arm64_sub_rrr(cb, 0, 0, 1);            # SUB X0, X0, X1 (end-base);
    cb = codebuf_emit_u32(cb, 0xD1000400);      # SUB X0, X0, #1 (exclude null);
    cb = arm64_ret(cb);

    # ── _rt_strcat: X0 = s1, X1 = s2 → X0 = new concatenated string ptr ──
    # Uses bump allocator at globals[0] (accessible via X15)
    local_strcat_off = codebuf_offset(cb);
    # Prologue: save frame + callee-saved regs we use
    cb = arm64_stp_pre(cb, 29, 30, 31, -48);    # STP X29, X30, [SP, #-48]!;
    cb = codebuf_emit_u32(cb, 0xA90153F3);      # STP X19, X20, [SP, #16];
    cb = codebuf_emit_u32(cb, 0xA9025BF5);      # STP X21, X22, [SP, #32];
    cb = arm64_mov_rr(cb, 19, 0);               # MOV X19, X0 (save s1);
    cb = arm64_mov_rr(cb, 20, 1);               # MOV X20, X1 (save s2);
    # strlen(s1): BL _rt_strlen
    strlen_bl1 = codebuf_offset(cb);
    strlen_delta1 = (local_strlen_off - strlen_bl1) / 4;
    cb = codebuf_emit_u32(cb, 0x94000000 | (strlen_delta1 bit_and 0x03FFFFFF));
    cb = arm64_mov_rr(cb, 21, 0);               # MOV X21, X0 (len1);
    # strlen(s2)
    cb = arm64_mov_rr(cb, 0, 20);               # MOV X0, X20 (s2);
    strlen_bl2 = codebuf_offset(cb);
    strlen_delta2 = (local_strlen_off - strlen_bl2) / 4;
    cb = codebuf_emit_u32(cb, 0x94000000 | (strlen_delta2 bit_and 0x03FFFFFF));
    cb = arm64_mov_rr(cb, 22, 0);               # MOV X22, X0 (len2);
    # Bump alloc: total = len1 + len2 + 1
    cb = arm64_add_rrr(cb, 2, 21, 22);          # ADD X2, X21, X22;
    cb = codebuf_emit_u32(cb, 0x91000442);      # ADD X2, X2, #1 (null terminator);
    cb = arm64_ldr_imm(cb, 3, 15, 0);           # LDR X3, [X15, #0] (heap ptr);
    cb = arm64_mov_rr(cb, 4, 3);                # MOV X4, X3 (save new string start);
    cb = arm64_add_rrr(cb, 3, 3, 2);            # ADD X3, X3, X2 (advance heap);
    cb = arm64_str_imm(cb, 3, 15, 0);           # STR X3, [X15, #0];
    # Copy s1 bytes: dst=X4→X0, src=X19→X1, len=X21→X2
    cb = arm64_mov_rr(cb, 0, 4);                # MOV X0, X4 (dst);
    cb = arm64_mov_rr(cb, 1, 19);               # MOV X1, X19 (src=s1);
    cb = arm64_mov_rr(cb, 2, 21);               # MOV X2, X21 (len=len1);
    # CBZ X2, +4 (skip copy1 loop = 4 instrs ahead)
    cb = codebuf_emit_u32(cb, 0xB4000082);      # CBZ X2, +4;
    # .copy1:
    cb = codebuf_emit_u32(cb, 0x38401423);      # LDRB W3, [X1], #1;
    cb = codebuf_emit_u32(cb, 0x38001403);      # STRB W3, [X0], #1;
    cb = codebuf_emit_u32(cb, 0xD1000442);      # SUB X2, X2, #1;
    cb = codebuf_emit_u32(cb, 0xB5FFFFA2);      # CBNZ X2, -3 (.copy1);
    # Copy s2 bytes
    cb = arm64_mov_rr(cb, 1, 20);               # MOV X1, X20 (src=s2);
    cb = arm64_mov_rr(cb, 2, 22);               # MOV X2, X22 (len=len2);
    # CBZ X2, +4 (skip copy2 loop)
    cb = codebuf_emit_u32(cb, 0xB4000082);      # CBZ X2, +4;
    # .copy2:
    cb = codebuf_emit_u32(cb, 0x38401423);      # LDRB W3, [X1], #1;
    cb = codebuf_emit_u32(cb, 0x38001403);      # STRB W3, [X0], #1;
    cb = codebuf_emit_u32(cb, 0xD1000442);      # SUB X2, X2, #1;
    cb = codebuf_emit_u32(cb, 0xB5FFFFA2);      # CBNZ X2, -3 (.copy2);
    # Null terminate: STRB WZR, [X0]
    cb = codebuf_emit_u32(cb, 0x3900001F);      # STRB WZR, [X0, #0];
    # Return new string ptr
    cb = arm64_mov_rr(cb, 0, 4);                # MOV X0, X4;
    # Epilogue: restore callee-saved regs
    cb = codebuf_emit_u32(cb, 0xA9425BF5);      # LDP X21, X22, [SP, #32];
    cb = codebuf_emit_u32(cb, 0xA94153F3);      # LDP X19, X20, [SP, #16];
    cb = arm64_ldp_post(cb, 29, 30, 31, 48);    # LDP X29, X30, [SP], #48;
    cb = arm64_ret(cb);

    # ── _rt_exit: X0 = exit code (already in X0) ──
    g_rt_exit_off = codebuf_offset(cb);
    # MOV X16, #0x2000001 (SYS_EXIT with BSD offset)
    cb = arm64_mov_imm16(cb, 16, 1)             # low bits;
    cb = codebuf_emit_u32(cb, 0xF2A04010)       # MOVK X16, #0x200, LSL#16;
    cb = arm64_svc(cb, 128)                      # SVC #0x80;

    out cb;
end.


# ═══════════════════════════════════════════════════════
# Module Codegen
# ═══════════════════════════════════════════════════════
# Emits all functions in a QModule into a single CodeBuf.
# Cross-function calls are resolved via the FuncLayout table.

func codegen_emit_module:
    in(mod_obj: QModule, arch: TargetArch)
    # Phase 1: Emit runtime stubs + all functions
    cb = codebuf_new(arch);
    layouts = vec_new_rt();
    layout_count = 0;
    fixup_offsets = vec_new_rt();
    fixup_targets = vec_new_rt();
    fixup_count = 0;
    func_adr_patches = vec_new_rt();
    func_adr_targets = vec_new_rt();
    func_adr_dregs = vec_new_rt();
    main_idx = -1;
    ginit_idx = -1;

    # Scan all functions to find max global index used
    max_gidx = -1;
    gi = 0;
    nfuncs_scan = vec_len_rt(mod_obj.functions);
    when gi < nfuncs_scan loop
        gfn = vec_get_rt(mod_obj.functions, gi);
        gj = 0;
        gbodylen = vec_len_rt(gfn.body);
        when gj < gbodylen loop
            gins = vec_get_rt(gfn.body, gj);
            if gins.opcode == QOp.LoadGlobal or gins.opcode == QOp.StoreGlobal do
                gval = gins.src1.imm_val;
                if gval > max_gidx do
                    max_gidx = gval;
                end
            end
            gj = gj + 1;
        end
        gi = gi + 1;
    end
    num_globals = max_gidx + 1;

    # Reserve globals slots for string data pointers
    # Each string needs 2 slots: [ptr, len]
    # Start after globals[0] (heap ptr)
    str_count = vec_len_rt(mod_obj.strings);
    str_globals_base = 1 + num_globals;  # globals[0] = heap, then global vars, then strings
    str_adr_patches = vec_new_rt();   # offsets of ADR instructions to patch
    str_adr_indices = vec_new_rt();   # corresponding string index

    # Emit runtime stubs first
    rt_print_off = codebuf_offset(cb);
    cb = emit_runtime_arm64(cb);
    rt_exit_off = g_rt_exit_off;
    rt_printstr_off = g_rt_printstr_off;
    rt_strlen_off = rt_exit_off - 172;
    rt_strcat_off = rt_exit_off - 148;
    runtime_size = codebuf_offset(cb);

    # Emit each function
    fi = 0;
    nfuncs = vec_len_rt(mod_obj.functions);
    when fi < nfuncs loop
        qfn = vec_get_rt(mod_obj.functions, fi);
        bodylen = vec_len_rt(qfn.body);
        func_start = codebuf_offset(cb);

        # Track main function
        if rt_streq(qfn.name, "main") or rt_streq(qfn.name, "__main__") do
            main_idx = fi;
        end
        if rt_streq(qfn.name, "__ginit") do
            ginit_idx = fi;
        end

        # All user functions need a stack frame since vregs map to callee-saved x19+
        needs_frame = 1;

        # Scan max vreg for stack spilling
        max_vreg = 0;
        vi = 0;
        when vi < bodylen loop
            vins = vec_get_rt(qfn.body, vi);
            if vins.dest.op_type == OperandType.VReg and vins.dest.vreg > max_vreg do
                max_vreg = vins.dest.vreg;
            end
            if vins.src1.op_type == OperandType.VReg and vins.src1.vreg > max_vreg do
                max_vreg = vins.src1.vreg;
            end
            if vins.src2.op_type == OperandType.VReg and vins.src2.vreg > max_vreg do
                max_vreg = vins.src2.vreg;
            end
            vi = vi + 1;
        end
        spill_count = 0;
        if max_vreg >= 16 do
            spill_count = max_vreg - 15;
        end
        spill_extra = ((spill_count + 1) / 2) * 16;
        frame_size = 160 + spill_extra;

        # Emit prologue
        if needs_frame == 1 do
            # Save frame pointer, link register, and callee-saved x19-x28
            # Frame = frame_size bytes: 16(fp/lr) + 80(x19-x28) + 64(call spill) + spill_extra
            cb = arm64_stp_pre(cb, 29, 30, 31, 0 - frame_size);
            cb = arm64_mov_sp_to(cb, 29);
            # Save x19-x28 (callee-saved regs used for vregs)
            cb = codebuf_emit_u32(cb, 0xA90153F3);   # STP X19, X20, [SP, #16];
            cb = codebuf_emit_u32(cb, 0xA9025BF5);   # STP X21, X22, [SP, #32];
            cb = codebuf_emit_u32(cb, 0xA90363F7);   # STP X23, X24, [SP, #48];
            cb = codebuf_emit_u32(cb, 0xA9046BF9);   # STP X25, X26, [SP, #64];
            cb = codebuf_emit_u32(cb, 0xA90573FB);   # STP X27, X28, [SP, #80];
        end

        # Move function arguments from x0-x7 to callee-saved registers
        # vreg0=x19, vreg1=x20, etc.
        nparams = qfn.param_count;
        if nparams > 0 do
            cb = arm64_mov_rr(cb, 19, 0);
        end
        if nparams > 1 do
            cb = arm64_mov_rr(cb, 20, 1);
        end
        if nparams > 2 do
            cb = arm64_mov_rr(cb, 21, 2);
        end
        if nparams > 3 do
            cb = arm64_mov_rr(cb, 22, 3);
        end
        if nparams > 4 do
            cb = arm64_mov_rr(cb, 23, 4);
        end
        if nparams > 5 do
            cb = arm64_mov_rr(cb, 24, 5);
        end
        if nparams > 6 do
            cb = arm64_mov_rr(cb, 25, 6);
        end
        if nparams > 7 do
            cb = arm64_mov_rr(cb, 26, 7);
        end

        # If this is __syscall, emit the native BSD syscall sequence before epilogue
        if rt_streq(qfn.name, "__syscall") do
            cb = arm64_mov_rr(cb, 16, 19);               # MOV X16, X19 (syscall num was in x0, moved to x19)
            cb = codebuf_emit_u32(cb, 0xF2A04010);       # MOVK X16, #0x200, LSL #16
            cb = arm64_mov_rr(cb, 0, 20);                # MOV X0, X20 (arg1)
            cb = arm64_mov_rr(cb, 1, 21);
            cb = arm64_mov_rr(cb, 2, 22);
            cb = arm64_mov_rr(cb, 3, 23);
            cb = arm64_mov_rr(cb, 4, 24);
            cb = arm64_mov_rr(cb, 5, 25);
            cb = codebuf_emit_u32(cb, 0xD4001001);       # SVC #0x80
        end

        # Emit instructions
        ps = patch_new();
        j = 0;
        when j < vec_len_rt(qfn.body) loop
            ins = vec_get_rt(qfn.body, j);

            # Handle critical opcodes separately to avoid deep if/eif nesting
            handled = 0;
            if ins.opcode == QOp.Print do
                if ins.src1.op_type == OperandType.VReg do
                    if ins.src1.vreg >= 16 do
                        cb = arm64_ldr_imm(cb, 8, 29, 160 + (ins.src1.vreg - 16) * 8);
                    end
                    cb = arm64_mov_rr(cb, 0, vreg_to_arm(ins.src1.vreg));
                end
                # Save caller-saved vregs x9-x14 before print call
                cb = codebuf_emit_u32(cb, 0xA9062BE9);   # STP X9, X10, [SP, #96];
                cb = codebuf_emit_u32(cb, 0xA90733EB);   # STP X11, X12, [SP, #112];
                cb = codebuf_emit_u32(cb, 0xA9083BED);   # STP X13, X14, [SP, #128];
                print_bl_off = codebuf_offset(cb);
                delta = (rt_print_off - print_bl_off) / 4;
                cb = codebuf_emit_u32(cb, 0x94000000 | (delta bit_and 0x03FFFFFF));
                # Restore caller-saved vregs x9-x14 after print call
                cb = codebuf_emit_u32(cb, 0xA9462BE9);   # LDP X9, X10, [SP, #96];
                cb = codebuf_emit_u32(cb, 0xA94733EB);   # LDP X11, X12, [SP, #112];
                cb = codebuf_emit_u32(cb, 0xA9483BED);   # LDP X13, X14, [SP, #128];
                handled = 1;
            end
            if ins.opcode == QOp.Ret do
                if ins.src1.op_type == OperandType.VReg do
                    if ins.src1.vreg >= 16 do
                        cb = arm64_ldr_imm(cb, 8, 29, 160 + (ins.src1.vreg - 16) * 8);
                    end
                    if vreg_to_arm(ins.src1.vreg) != 0 do
                        cb = arm64_mov_rr(cb, 0, vreg_to_arm(ins.src1.vreg));
                    end
                end
                if needs_frame == 1 do
                    cb = codebuf_emit_u32(cb, 0xA94153F3);   # LDP X19, X20, [SP, #16];
                    cb = codebuf_emit_u32(cb, 0xA9425BF5);   # LDP X21, X22, [SP, #32];
                    cb = codebuf_emit_u32(cb, 0xA94363F7);   # LDP X23, X24, [SP, #48];
                    cb = codebuf_emit_u32(cb, 0xA9446BF9);   # LDP X25, X26, [SP, #64];
                    cb = codebuf_emit_u32(cb, 0xA94573FB);   # LDP X27, X28, [SP, #80];
                    cb = arm64_ldp_post(cb, 29, 30, 31, frame_size);
                end
                cb = arm64_ret(cb);
                handled = 1;
            end
            if ins.opcode == QOp.Exit do
                if ins.src1.op_type == OperandType.VReg do
                    cb = arm64_mov_rr(cb, 0, vreg_to_arm(ins.src1.vreg));
                end
                exit_bl_off = codebuf_offset(cb);
                delta = (rt_exit_off - exit_bl_off) / 4;
                cb = codebuf_emit_u32(cb, 0x94000000 | (delta bit_and 0x03FFFFFF));
                handled = 1;
            end
            if ins.opcode == QOp.Halt do
                cb = arm64_mov_imm16(cb, 0, 0);
                cb = arm64_ret(cb);
                handled = 1;
            end
            if ins.opcode == QOp.Label do
                ps = patch_add_label(ps, ins.dest.vreg, codebuf_offset(cb));
                handled = 1;
            end
            if ins.opcode == QOp.Jump do
                if ins.src1.op_type == OperandType.LabelRef do
                    ps = patch_add_fixup(ps, codebuf_offset(cb), ins.src1.vreg, 0);
                end
                cb = arm64_b_imm26(cb, 0);
                handled = 1;
            end
            if ins.opcode == QOp.JumpIfNot do
                if ins.src1.op_type == OperandType.VReg do
                    cb = arm64_cmp_imm0(cb, vreg_to_arm(ins.src1.vreg));
                end
                if ins.src2.op_type == OperandType.LabelRef do
                    ps = patch_add_fixup(ps, codebuf_offset(cb), ins.src2.vreg, 1);
                end
                cb = arm64_beq_imm19(cb, 0);
                handled = 1;
            end
            if ins.opcode == QOp.JumpIf do
                if ins.src1.op_type == OperandType.VReg do
                    cb = arm64_cmp_imm0(cb, vreg_to_arm(ins.src1.vreg));
                end
                if ins.src2.op_type == OperandType.LabelRef do
                    ps = patch_add_fixup(ps, codebuf_offset(cb), ins.src2.vreg, 1);
                end
                cb = arm64_bne_imm19(cb, 0);
                handled = 1;
            end
            if ins.opcode == QOp.SetArg do
                # SetArg: dest.imm = ABI arg index (0..3), src1.vreg = value vreg
                cb = arm64_mov_rr(cb, ins.dest.imm_val, vreg_to_arm(ins.src1.vreg));
                handled = 1;
            end
            if ins.opcode == QOp.LoadFuncAddr do
                # LoadFuncAddr: dest = address of function src1.vreg (func index)
                dreg = vreg_to_arm(ins.dest.vreg);
                func_adr_patches = vec_push_rt(func_adr_patches, codebuf_offset(cb));
                func_adr_targets = vec_push_rt(func_adr_targets, ins.src1.vreg);
                func_adr_dregs = vec_push_rt(func_adr_dregs, dreg);
                cb = codebuf_emit_u32(cb, 0x10000000 | dreg);   # ADR Xdreg, #0 placeholder;
                handled = 1;
            end
            if ins.opcode == QOp.Call or ins.opcode == QOp.CallFunc do
                # Save caller-saved vregs x9-x14 before call
                cb = codebuf_emit_u32(cb, 0xA9062BE9);   # STP X9, X10, [SP, #96];
                cb = codebuf_emit_u32(cb, 0xA90733EB);   # STP X11, X12, [SP, #112];
                cb = codebuf_emit_u32(cb, 0xA9083BED);   # STP X13, X14, [SP, #128];
                if ins.src1.op_type == OperandType.VReg do
                    # Indirect call: MOV X16, src_vreg; BLR X16
                    cb = arm64_mov_rr(cb, 16, vreg_to_arm(ins.src1.vreg));
                    cb = arm64_blr_x16(cb);
                eif ins.src1.op_type == OperandType.LabelRef do
                    ps = patch_add_fixup(ps, codebuf_offset(cb), ins.src1.vreg, 0);
                    cb = arm64_bl_imm26(cb, 0);
                eif ins.src1.op_type == OperandType.FuncIdx do
                    fixup_offsets = vec_push_rt(fixup_offsets, codebuf_offset(cb));
                    fixup_targets = vec_push_rt(fixup_targets, ins.src1.vreg);
                    fixup_count = fixup_count + 1;
                    cb = arm64_bl_imm26(cb, 0);
                end
                # Restore caller-saved vregs x9-x14 after call
                cb = codebuf_emit_u32(cb, 0xA9462BE9);   # LDP X9, X10, [SP, #96];
                cb = codebuf_emit_u32(cb, 0xA94733EB);   # LDP X11, X12, [SP, #112];
                cb = codebuf_emit_u32(cb, 0xA9483BED);   # LDP X13, X14, [SP, #128];
                # Move return value from x0 directly into dest vreg
                if ins.dest.op_type == OperandType.VReg do
                    cb = arm64_mov_rr(cb, vreg_to_arm(ins.dest.vreg), 0);
                end
                handled = 1;
            end
            if ins.opcode == QOp.LoadGlobal do
                # LoadGlobal: dest = globals[src1.imm]
                # X15 = globals base, globals[0] reserved for heap ptr, user globals at idx+1
                gidx = ins.src1.imm_val + 1;
                cb = arm64_movz_imm64(cb, 17, gidx as int);
                cb = arm64_ldr_reg(cb, vreg_to_arm(ins.dest.vreg), 15, 17);
                handled = 1;
            end
            if ins.opcode == QOp.StoreGlobal do
                # StoreGlobal: globals[src1.imm] = src2.vreg
                gidx = ins.src1.imm_val + 1;
                cb = arm64_movz_imm64(cb, 17, gidx as int);
                cb = arm64_str_reg(cb, vreg_to_arm(ins.src2.vreg), 15, 17);
                handled = 1;
            end
            if ins.opcode == QOp.Alloc do
                # Alloc: dest = bump_alloc(src1.vreg bytes)
                # globals[0] = heap pointer (in X15)
                cb = arm64_ldr_imm(cb, 17, 15, 0);               # LDR X17, [X15, #0] — heap ptr;
                cb = arm64_mov_rr(cb, vreg_to_arm(ins.dest.vreg), 17);  # dest = current heap ptr;
                cb = arm64_add_rrr(cb, 17, 17, vreg_to_arm(ins.src1.vreg));  # X17 += size;
                cb = arm64_str_imm(cb, 17, 15, 0);               # STR X17, [X15, #0] — update heap ptr;
                handled = 1;
            end
            if ins.opcode == QOp.ArrNew do
                # ArrNew: dest = new array with capacity src1.vreg
                # Layout: [cap, len, data...] — (cap+2)*8 bytes
                # Use X17 for temp calculations
                cb = arm64_add_imm(cb, 17, vreg_to_arm(ins.src1.vreg), 2);  # X17 = cap + 2;
                # Multiply by 8: LSL X17, X17, #3
                cb = codebuf_emit_u32(cb, 0xD37DF231);           # LSL X17, X17, #3 → UBFM X17,X17,#61,#60;
                # Bump alloc
                rd = vreg_to_arm(ins.dest.vreg);
                cb = arm64_ldr_imm(cb, rd, 15, 0);               # LDR Xd, [X15] — heap ptr;
                cb = arm64_add_rrr(cb, 17, rd, 17);              # X17 = heap + total_bytes;
                cb = arm64_str_imm(cb, 17, 15, 0);               # STR X17, [X15] — update heap;
                # Store capacity at [arr+0], length 0 at [arr+8]
                cb = arm64_str_imm(cb, vreg_to_arm(ins.src1.vreg), rd, 0);  # [arr] = cap;
                cb = arm64_mov_imm16(cb, 17, 0);                 # X17 = 0;
                cb = arm64_str_imm(cb, 17, rd, 8);               # [arr+8] = 0 (len=0);
                handled = 1;
            end
            if ins.opcode == QOp.ArrPush do
                # ArrPush: src1=arr, src2=element — arr[len++] = elem
                arr_reg = vreg_to_arm(ins.src1.vreg);
                elem_reg = vreg_to_arm(ins.src2.vreg);
                cb = arm64_ldr_imm(cb, 17, arr_reg, 8);          # X17 = len;
                cb = arm64_add_imm(cb, 17, 17, 2);               # X17 = len + 2 (skip header);
                cb = arm64_str_reg(cb, elem_reg, arr_reg, 17);   # [arr + X17*8] = elem;
                cb = arm64_ldr_imm(cb, 17, arr_reg, 8);          # reload len;
                cb = arm64_add_imm(cb, 17, 17, 1);               # len++;
                cb = arm64_str_imm(cb, 17, arr_reg, 8);          # [arr+8] = new len;
                handled = 1;
            end
            if ins.opcode == QOp.ArrGet do
                # ArrGet: dest = arr[idx] — dest.vreg = src1.vreg[src2.vreg]
                arr_reg = vreg_to_arm(ins.src1.vreg);
                idx_reg = vreg_to_arm(ins.src2.vreg);
                cb = arm64_add_imm(cb, 17, idx_reg, 2);          # X17 = idx + 2;
                cb = arm64_ldr_reg(cb, vreg_to_arm(ins.dest.vreg), arr_reg, 17);  # dest = [arr + X17*8];
                handled = 1;
            end
            if ins.opcode == QOp.ArrSet do
                # ArrSet: arr[idx] = val — src1.vreg[src2.vreg] = dest.vreg
                arr_reg = vreg_to_arm(ins.src1.vreg);
                idx_reg = vreg_to_arm(ins.src2.vreg);
                cb = arm64_add_imm(cb, 17, idx_reg, 2);          # X17 = idx + 2;
                cb = arm64_str_reg(cb, vreg_to_arm(ins.dest.vreg), arr_reg, 17);  # [arr + X17*8] = val;
                handled = 1;
            end
            if ins.opcode == QOp.PrintStr do
                # Save caller-saved vregs x9-x14 before any call
                cb = codebuf_emit_u32(cb, 0xA9062BE9);
                cb = codebuf_emit_u32(cb, 0xA90733EB);
                cb = codebuf_emit_u32(cb, 0xA9083BED);
                if ins.src1.op_type == OperandType.StringRef do
                    # StringRef: literal string — load ptr and len from globals
                    str_idx = ins.src1.vreg;
                    slot = str_globals_base + str_idx * 2;
                    cb = arm64_movz_imm64(cb, 17, slot);
                    cb = arm64_ldr_reg(cb, 0, 15, 17);     # X0 = globals[slot] = str ptr;
                    slot_len = slot + 1;
                    cb = arm64_movz_imm64(cb, 17, slot_len);
                    cb = arm64_ldr_reg(cb, 1, 15, 17);     # X1 = globals[slot+1] = str len;
                else
                    # Variable string (null-terminated ptr in vreg)
                    cb = arm64_mov_rr(cb, 0, vreg_to_arm(ins.dest.vreg));  # X0 = string ptr;
                    # BL _rt_strlen to get length
                    ps_bl_off = codebuf_offset(cb);
                    ps_delta = (rt_strlen_off - ps_bl_off) / 4;
                    cb = codebuf_emit_u32(cb, 0x94000000 | (ps_delta bit_and 0x03FFFFFF));
                    cb = arm64_mov_rr(cb, 1, 0);            # X1 = len;
                    cb = arm64_mov_rr(cb, 0, vreg_to_arm(ins.dest.vreg));  # X0 = string ptr again;
                end
                ps_bl_off = codebuf_offset(cb);
                ps_delta = (rt_printstr_off - ps_bl_off) / 4;
                cb = codebuf_emit_u32(cb, 0x94000000 | (ps_delta bit_and 0x03FFFFFF));
                # Restore caller-saved vregs
                cb = codebuf_emit_u32(cb, 0xA9462BE9);
                cb = codebuf_emit_u32(cb, 0xA94733EB);
                cb = codebuf_emit_u32(cb, 0xA9483BED);
                handled = 1;
            end
            if ins.opcode == QOp.ArrLen do
                # ArrLen: dest = length of array src1
                # Array layout: [cap, len, data...] — len is at offset 8
                cb = arm64_ldr_imm(cb, vreg_to_arm(ins.dest.vreg), vreg_to_arm(ins.src1.vreg), 8);
                handled = 1;
            end
            if ins.opcode == QOp.StrCat do
                # StrCat: dest = str_cat(src1, src2)
                # src1, src2 are vregs holding null-terminated string ptrs
                # Call _rt_strcat(X0=s1, X1=s2) → X0=new ptr
                cb = arm64_mov_rr(cb, 0, vreg_to_arm(ins.src1.vreg));  # X0 = s1;
                cb = arm64_mov_rr(cb, 1, vreg_to_arm(ins.src2.vreg));  # X1 = s2;
                # Save caller-saved vregs X9-X14
                cb = codebuf_emit_u32(cb, 0xA9062BE9);
                cb = codebuf_emit_u32(cb, 0xA90733EB);
                cb = codebuf_emit_u32(cb, 0xA9083BED);
                # Save callee-saved vregs X19-X22 (clobbered by _rt_strcat internally but it restores them)
                # Actually _rt_strcat saves/restores X19-X22 itself, so caller doesn't need to
                sc_bl_off = codebuf_offset(cb);
                sc_delta = (rt_strcat_off - sc_bl_off) / 4;
                cb = codebuf_emit_u32(cb, 0x94000000 | (sc_delta bit_and 0x03FFFFFF));
                # Result in X0 → dest vreg
                cb = arm64_mov_rr(cb, vreg_to_arm(ins.dest.vreg), 0);
                # Restore caller-saved vregs
                cb = codebuf_emit_u32(cb, 0xA9462BE9);
                cb = codebuf_emit_u32(cb, 0xA94733EB);
                cb = codebuf_emit_u32(cb, 0xA9483BED);
                handled = 1;
            end
            if ins.opcode == QOp.StrLenOp do
                # StrLenOp: dest = strlen(src1)
                # src1 is a vreg holding a null-terminated string ptr
                cb = arm64_mov_rr(cb, 0, vreg_to_arm(ins.src1.vreg));  # X0 = str ptr;
                cb = codebuf_emit_u32(cb, 0xA9062BE9);  # save X9-X14;
                cb = codebuf_emit_u32(cb, 0xA90733EB);
                cb = codebuf_emit_u32(cb, 0xA9083BED);
                sl_bl_off = codebuf_offset(cb);
                sl_delta = (rt_strlen_off - sl_bl_off) / 4;
                cb = codebuf_emit_u32(cb, 0x94000000 | (sl_delta bit_and 0x03FFFFFF));
                cb = arm64_mov_rr(cb, vreg_to_arm(ins.dest.vreg), 0);  # dest = X0 = length;
                cb = codebuf_emit_u32(cb, 0xA9462BE9);  # restore X9-X14;
                cb = codebuf_emit_u32(cb, 0xA94733EB);
                cb = codebuf_emit_u32(cb, 0xA9483BED);
                handled = 1;
            end

            if handled == 0 do

            # Spill pre-load: load spilled source operands from stack
            # src1 spilled → load to X8 (vreg_to_arm returns X8 for ≥16)
            # src2 spilled → load to X16 to avoid collision with src1 in X8
            s1_reg = 0;
            s2_reg = 0;
            d_reg = 0;
            if ins.src1.op_type == OperandType.VReg do
                s1_reg = vreg_to_arm(ins.src1.vreg);
                if spill_count > 0 and ins.src1.vreg >= 16 do
                    cb = arm64_ldr_imm(cb, 8, 29, 160 + (ins.src1.vreg - 16) * 8);
                end
            end
            if ins.src2.op_type == OperandType.VReg do
                s2_reg = vreg_to_arm(ins.src2.vreg);
                if spill_count > 0 and ins.src2.vreg >= 16 do
                    # Use X16 for second spilled operand to avoid X8 collision
                    cb = arm64_ldr_imm(cb, 16, 29, 160 + (ins.src2.vreg - 16) * 8);
                    s2_reg = 16;
                end
            end
            if ins.dest.op_type == OperandType.VReg do
                d_reg = vreg_to_arm(ins.dest.vreg);
            end

            if ins.opcode == QOp.Nop do
                cb = arm64_nop(cb);

            eif ins.opcode == QOp.Load do
                if ins.src1.op_type == OperandType.Immediate do
                    cb = arm64_movz_imm64(cb, d_reg, ins.src1.imm_val as int);
                eif ins.src1.op_type == OperandType.StringRef do
                    # Load string pointer from globals table
                    slot = str_globals_base + ins.src1.vreg * 2;
                    cb = arm64_movz_imm64(cb, 17, slot);
                    cb = arm64_ldr_reg(cb, d_reg, 15, 17);
                end

            eif ins.opcode == QOp.Move do
                cb = arm64_mov_rr(cb, d_reg, s1_reg);

            eif ins.opcode == QOp.Add do
                cb = arm64_add_rrr(cb, d_reg, s1_reg, s2_reg);

            eif ins.opcode == QOp.Sub do
                cb = arm64_sub_rrr(cb, d_reg, s1_reg, s2_reg);

            eif ins.opcode == QOp.Mul do
                cb = arm64_mul_rrr(cb, d_reg, s1_reg, s2_reg);

            eif ins.opcode == QOp.Div do
                cb = arm64_sdiv_rrr(cb, d_reg, s1_reg, s2_reg);

            eif ins.opcode == QOp.Mod do
                # ARM64: dest = src1 - (src1/src2)*src2
                # SDIV X17, Xs1, Xs2
                # MSUB Xd, X17, Xs2, Xs1 → Xd = Xs1 - X17*Xs2
                cb = arm64_sdiv_rrr(cb, 17, s1_reg, s2_reg);
                msub = 0x9B008000 | (s2_reg shl 16) | (s1_reg shl 10) | (17 shl 5) | d_reg;
                cb = codebuf_emit_u32(cb, msub);

            eif ins.opcode == QOp.CmpEq do
                cb = arm64_cmp_rr(cb, s1_reg, s2_reg);
                cb = arm64_cset_eq(cb, d_reg);

            eif ins.opcode == QOp.CmpNe do
                cb = arm64_cmp_rr(cb, s1_reg, s2_reg);
                # CSET NE = CSINC Xd, XZR, XZR, EQ  → 0x9A9F07E0
                cb = codebuf_emit_u32(cb, 0x9A9F07E0 | (d_reg bit_and 0x1F));

            eif ins.opcode == QOp.CmpGt do
                cb = arm64_cmp_rr(cb, s1_reg, s2_reg);
                cb = arm64_cset_gt(cb, d_reg);

            eif ins.opcode == QOp.CmpLt do
                cb = arm64_cmp_rr(cb, s1_reg, s2_reg);
                cb = arm64_cset_lt(cb, d_reg);

            eif ins.opcode == QOp.CmpGe do
                cb = arm64_cmp_rr(cb, s1_reg, s2_reg);
                cb = arm64_cset_ge(cb, d_reg);

            eif ins.opcode == QOp.CmpLe do
                cb = arm64_cmp_rr(cb, s1_reg, s2_reg);
                cb = arm64_cset_le(cb, d_reg);

            eif ins.opcode == QOp.And do
                cb = arm64_and_rrr(cb, d_reg, s1_reg, s2_reg);

            eif ins.opcode == QOp.Or do
                cb = arm64_orr_rrr(cb, d_reg, s1_reg, s2_reg);

            eif ins.opcode == QOp.Xor do
                cb = arm64_eor_rrr(cb, d_reg, s1_reg, s2_reg);

            eif ins.opcode == QOp.Shl do
                cb = arm64_lsl_rrr(cb, d_reg, s1_reg, s2_reg);

            eif ins.opcode == QOp.Shr do
                cb = arm64_asr_rrr(cb, d_reg, s1_reg, s2_reg);

            eif ins.opcode == QOp.LoadByte do
                cb = arm64_ldrb_reg(cb, d_reg, s1_reg, s2_reg);

            eif ins.opcode == QOp.StoreByte do
                cb = arm64_strb_reg(cb, d_reg, s1_reg, s2_reg);

            eif ins.opcode == QOp.LoadWord do
                cb = arm64_ldr_reg(cb, d_reg, s1_reg, s2_reg);

            eif ins.opcode == QOp.StoreWord do
                cb = arm64_str_reg(cb, d_reg, s1_reg, s2_reg);

            eif ins.opcode == QOp.PatchPoint do
                cb = arm64_nop(cb);

            else
                cb = arm64_nop(cb);
            end

            end # if handled == 0

            # Spill post-store: if dest vreg is spilled, store from d_reg to stack
            if spill_count > 0 and ins.dest.op_type == OperandType.VReg and ins.dest.vreg >= 16 do
                cb = arm64_str_imm(cb, d_reg, 29, 160 + (ins.dest.vreg - 16) * 8);
            end

            j = j + 1;
        end

        # If function has no explicit RET, add one
        if vec_len_rt(qfn.body) == 0 or vec_get_rt(qfn.body, vec_len_rt(qfn.body) - 1).opcode != QOp.Ret do
            if needs_frame == 1 do
                cb = codebuf_emit_u32(cb, 0xA94153F3);   # LDP X19, X20, [SP, #16];
                cb = codebuf_emit_u32(cb, 0xA9425BF5);   # LDP X21, X22, [SP, #32];
                cb = codebuf_emit_u32(cb, 0xA94363F7);   # LDP X23, X24, [SP, #48];
                cb = codebuf_emit_u32(cb, 0xA9446BF9);   # LDP X25, X26, [SP, #64];
                cb = codebuf_emit_u32(cb, 0xA94573FB);   # LDP X27, X28, [SP, #80];
                cb = arm64_ldp_post(cb, 29, 30, 31, frame_size);
            end
            cb = arm64_ret(cb);
        end

        # Back-patch intra-function jumps
        cb = backpatch_arm64(cb, ps);

        func_size = codebuf_offset(cb) - func_start;
        fl = FuncLayout {
            name:   qfn.name,
            code_off: func_start,
            fsize:   func_size
        };
        layouts = vec_push_rt(layouts, fl);
        layout_count = layout_count + 1;

        fi = fi + 1;
    end

    # Phase 2: Resolve cross-function calls
    fxi = 0;
    when fxi < fixup_count loop
        patch_at = vec_get_rt(fixup_offsets, fxi);
        target_idx = vec_get_rt(fixup_targets, fxi);
        if target_idx >= 0 and target_idx < layout_count do
            target_layout = vec_get_rt(layouts, target_idx);
            target_off = target_layout.code_off;
            byte_offset = target_off - patch_at;
            imm26 = (byte_offset / 4) bit_and 0x03FFFFFF;
            cb = codebuf_patch_u32(cb, patch_at, 0x94000000 | imm26);
        end
        fxi = fxi + 1;
    end

    # Phase 2b: Patch LoadFuncAddr ADR instructions
    fai = 0;
    when fai < vec_len_rt(func_adr_patches) loop
        adr_off = vec_get_rt(func_adr_patches, fai);
        target_fi = vec_get_rt(func_adr_targets, fai);
        adr_rd = vec_get_rt(func_adr_dregs, fai);
        if target_fi >= 0 and target_fi < layout_count do
            target_layout = vec_get_rt(layouts, target_fi);
            target_off = target_layout.code_off;
            adr_imm = target_off - adr_off;
            immlo = adr_imm bit_and 3;
            immhi = (adr_imm shr 2) bit_and 0x7FFFF;
            adr_enc = 0x10000000 | (immlo shl 29) | (immhi shl 5) | adr_rd;
            cb = codebuf_patch_u32(cb, adr_off, adr_enc);
        end
        fai = fai + 1;
    end

    # Phase 3: Emit _start entry point
    # _start calls main(), then exits with return value
    start_offset = codebuf_offset(cb);
    # STP X29, X30, [SP, #-16]!
    cb = arm64_stp_pre(cb, 29, 30, 31, -16);
    cb = arm64_mov_sp_to(cb, 29);

    # ── Allocate globals area via mmap (result → X15) ──
    cb = arm64_mov_imm16(cb, 0, 0);              # x0 = 0 (any address);
    cb = codebuf_emit_u32(cb, 0xD2A00021);        # MOVZ X1, #1, LSL#16 (= 64KB);
    cb = arm64_mov_imm16(cb, 2, 3);              # x2 = PROT_READ|PROT_WRITE;
    cb = arm64_mov_imm16(cb, 3, 4098);           # x3 = MAP_ANON|MAP_PRIVATE (0x1002);
    cb = codebuf_emit_u32(cb, 0xAA3F03E4);        # MVN X4, XZR (fd = -1);
    cb = arm64_mov_imm16(cb, 5, 0);              # x5 = 0 (offset);
    cb = arm64_mov_imm16(cb, 16, 197);            # x16 = SYS_mmap (197);
    cb = codebuf_emit_u32(cb, 0xF2A04010);        # MOVK X16, #0x200, LSL#16;
    cb = arm64_svc(cb, 128);
    cb = arm64_mov_rr(cb, 15, 0);                # x15 = mmap result (globals base);

    # ── Allocate heap area via mmap (result → globals[0]) ──
    cb = arm64_mov_imm16(cb, 0, 0);              # x0 = 0;
    cb = codebuf_emit_u32(cb, 0xD2A00201);        # MOVZ X1, #0x10, LSL#16 (= 1MB);
    cb = arm64_mov_imm16(cb, 2, 3);              # x2 = PROT_READ|PROT_WRITE;
    cb = arm64_mov_imm16(cb, 3, 4098);           # x3 = MAP_ANON|MAP_PRIVATE;
    cb = codebuf_emit_u32(cb, 0xAA3F03E4);        # MVN X4, XZR;
    cb = arm64_mov_imm16(cb, 5, 0);              # x5 = 0;
    cb = arm64_mov_imm16(cb, 16, 197);            # x16 = SYS_mmap;
    cb = codebuf_emit_u32(cb, 0xF2A04010);        # MOVK X16, #0x200, LSL#16;
    cb = arm64_svc(cb, 128);
    cb = arm64_str_imm(cb, 0, 15, 0);            # STR X0, [X15, #0] — globals[0] = heap ptr;

    # ── Initialize string data pointers in globals ──
    # For each string in the module, we embedded its bytes after _start/exit.
    # Use ADR to compute runtime address of each string data block.
    si = 0;
    when si < str_count loop
        str_val = vec_get_rt(mod_obj.strings, si);
        slen = rt_strlen(str_val);
        slot = str_globals_base + si * 2;
        slot_len = slot + 1;

        # ADR X17, string_data_offset — will be patched later
        str_adr_patches = vec_push_rt(str_adr_patches, codebuf_offset(cb));
        str_adr_indices = vec_push_rt(str_adr_indices, si);
        cb = codebuf_emit_u32(cb, 0x10000011);   # ADR X17, #0 (placeholder);

        # Store ptr in globals[slot]
        cb = arm64_movz_imm64(cb, 16, slot);
        cb = arm64_str_reg(cb, 17, 15, 16);      # globals[slot] = str ptr;

        # Store length in globals[slot+1]
        cb = arm64_movz_imm64(cb, 17, slen);
        cb = arm64_movz_imm64(cb, 16, slot_len);
        cb = arm64_str_reg(cb, 17, 15, 16);      # globals[slot+1] = strlen;

        si = si + 1;
    end

    # Call __ginit if present (global variable initialization)
    if ginit_idx >= 0 do
        ginit_layout = vec_get_rt(layouts, ginit_idx);
        ginit_off = ginit_layout.code_off;
        ginit_bl = codebuf_offset(cb);
        delta_gi = (ginit_off - ginit_bl) / 4;
        cb = codebuf_emit_u32(cb, 0x94000000 | (delta_gi bit_and 0x03FFFFFF));
    end

    if main_idx >= 0 do
        # BL to main function
        main_layout = vec_get_rt(layouts, main_idx);
        main_off = main_layout.code_off;
        main_bl = codebuf_offset(cb);
        delta = (main_off - main_bl) / 4;
        cb = codebuf_emit_u32(cb, 0x94000000 | (delta bit_and 0x03FFFFFF));
    else
        # No main found — return 0
        cb = arm64_mov_imm16(cb, 0, 0);
    end

    # Exit with code 0
    cb = arm64_mov_imm16(cb, 0, 0);
    exit_bl = codebuf_offset(cb);
    exit_delta = (rt_exit_off - exit_bl) / 4;
    cb = codebuf_emit_u32(cb, 0x94000000 | (exit_delta bit_and 0x03FFFFFF));

    # LDP + RET (fallback, shouldn't reach)
    cb = arm64_ldp_post(cb, 29, 30, 31, 16);
    cb = arm64_ret(cb);

    # ── Phase 4: Embed string data after code ──
    # Store offset of each string's data bytes, then emit the bytes
    str_data_offsets = vec_new_rt();
    si = 0;
    when si < str_count loop
        str_val = vec_get_rt(mod_obj.strings, si);
        slen = rt_strlen(str_val);
        # Record the byte offset where this string's data starts
        str_data_offsets = vec_push_rt(str_data_offsets, codebuf_offset(cb));
        # Emit string bytes
        ci = 0;
        when ci < slen loop
            ch = str_get(str_val, ci);
            cb = codebuf_emit_byte(cb, ch);
            ci = ci + 1;
        end
        # Always null-terminate
        cb = codebuf_emit_byte(cb, 0);
        # Align to 4 bytes (ARM64 instruction alignment)
        when (codebuf_offset(cb) % 4) != 0 loop
            cb = codebuf_emit_byte(cb, 0);
        end
        si = si + 1;
    end

    # ── Phase 5: Patch ADR instructions for string pointers ──
    pi = 0;
    when pi < vec_len_rt(str_adr_patches) loop
        adr_off = vec_get_rt(str_adr_patches, pi);
        sidx = vec_get_rt(str_adr_indices, pi);
        data_off = vec_get_rt(str_data_offsets, sidx);
        # ADR Xd, offset: encodes PC-relative offset
        # ADR X17: opcode = 0x10000011
        # imm = data_off - adr_off
        adr_imm = data_off - adr_off;
        # ADR encoding: immlo = imm[1:0] at bits [30:29], immhi = imm[20:2] at bits [23:5]
        immlo = adr_imm bit_and 3;
        immhi = (adr_imm shr 2) bit_and 0x7FFFF;
        adr_enc = 0x10000011 | (immlo shl 29) | (immhi shl 5);
        cb = codebuf_patch_u32(cb, adr_off, adr_enc);
        pi = pi + 1;
    end

    g_code_start_offset = start_offset;
    out CodeBuf {
        data: g_codebuf_data,
        len:  codebuf_offset(cb),
        cap:  cb.cap,
        arch: cb.arch
    };
end.
# Produces a minimal Mach-O ARM64 executable:
#   __PAGEZERO + __TEXT (code) + LC_MAIN + LC_SYMTAB

func emit_macho_executable:
    in(code: CodeBuf)
    obuf = buf_new();
    code_size = codebuf_offset(code) as int;

    # Page-align the code segment
    if PAGE_SIZE == 0 do
        text_filesize = code_size;
    else
        text_filesize = ((code_size + PAGE_SIZE - 1) / PAGE_SIZE) * PAGE_SIZE;
    end

    # Layout: [header 32B] [PAGEZERO 72B] [TEXT seg 72+80B] [LC_MAIN 24B] [LC_SYMTAB 24B]
    ncmds = 4 as int;
    cmds_size = (72 + 72 + 80 + 24 + 24) as int   # 272 bytes;
    header_plus_cmds = 32 + cmds_size as int;

    # Entry point = start of code (_start is at end of module, but we want
    # the _start function which is the last thing emitted in codegen_emit_module)
    # Actually the entry offset is relative to __TEXT segment start
    # Since code starts right after header+cmds, entry = offset of _start in code
    # For simplicity, entry at offset 0 (runtime stubs are first, _start is last)
    # We need to pass the _start offset... for now, use the code layout

    # ── Mach-O Header (32 bytes) ──
    obuf = buf_write_u32_le(obuf, MACHO_MAGIC);
    obuf = buf_write_u32_le(obuf, CPU_ARM64);
    obuf = buf_write_u32_le(obuf, CPU_SUB_ALL);
    obuf = buf_write_u32_le(obuf, MH_EXECUTE);
    obuf = buf_write_u32_le(obuf, ncmds);
    obuf = buf_write_u32_le(obuf, cmds_size);
    obuf = buf_write_u32_le(obuf, MH_FLAGS);
    obuf = buf_write_u32_le(obuf, 0)               # reserved;

    # ── LC_SEGMENT_64: __PAGEZERO (72 bytes) ──
    obuf = buf_write_u32_le(obuf, LC_SEGMENT_64);
    obuf = buf_write_u32_le(obuf, 72);
    obuf = buf_write_string_padded(obuf, "__PAGEZERO", 16);
    obuf = buf_write_u64_le(obuf, 0)               # vmaddr;
    obuf = buf_write_u64_le(obuf, TEXT_BASE)        # vmsize = 4GB;
    obuf = buf_write_u64_le(obuf, 0)               # fileoff;
    obuf = buf_write_u64_le(obuf, 0)               # filesize;
    obuf = buf_write_u32_le(obuf, 0)               # maxprot;
    obuf = buf_write_u32_le(obuf, 0)               # initprot;
    obuf = buf_write_u32_le(obuf, 0)               # nsects;
    obuf = buf_write_u32_le(obuf, 0)               # flags;

    # ── LC_SEGMENT_64: __TEXT (72 + 80 = 152 bytes) ──
    obuf = buf_write_u32_le(obuf, LC_SEGMENT_64);
    obuf = buf_write_u32_le(obuf, 152)             # 72 + 1 section * 80;
    obuf = buf_write_string_padded(obuf, "__TEXT", 16);
    obuf = buf_write_u64_le(obuf, TEXT_BASE)        # vmaddr;
    obuf = buf_write_u64_le(obuf, text_filesize)   # vmsize;
    obuf = buf_write_u64_le(obuf, 0)               # fileoff;
    obuf = buf_write_u64_le(obuf, header_plus_cmds + text_filesize)  # filesize;
    obuf = buf_write_u32_le(obuf, 5)               # maxprot (r-x);
    obuf = buf_write_u32_le(obuf, 5)               # initprot (r-x);
    obuf = buf_write_u32_le(obuf, 1)               # nsects;
    obuf = buf_write_u32_le(obuf, 0)               # flags;

    # __text section header (80 bytes)
    obuf = buf_write_string_padded(obuf, "__text", 16)       # sectname;
    obuf = buf_write_string_padded(obuf, "__TEXT", 16)       # segname;
    obuf = buf_write_u64_le(obuf, TEXT_BASE + header_plus_cmds)       # addr;
    obuf = buf_write_u64_le(obuf, code_size)                          # size;
    obuf = buf_write_u32_le(obuf, header_plus_cmds as int)            # offset;
    obuf = buf_write_u32_le(obuf, 2)               # align = 2^2 = 4 bytes;
    obuf = buf_write_u32_le(obuf, 0)               # reloff;
    obuf = buf_write_u32_le(obuf, 0)               # nreloc;
    obuf = buf_write_u32_le(obuf, 0x80000400)      # flags: S_ATTR_PURE_INSTRUCTIONS | S_ATTR_SOME_INSTRUCTIONS;
    obuf = buf_write_u32_le(obuf, 0)               # reserved1;
    obuf = buf_write_u32_le(obuf, 0)               # reserved2;
    obuf = buf_write_u32_le(obuf, 0)               # reserved3;

    # ── LC_MAIN (24 bytes) ──
    obuf = buf_write_u32_le(obuf, LC_MAIN);
    obuf = buf_write_u32_le(obuf, 24);
    # Entry offset = code starts at header_plus_cmds, _start is a known offset
    # For now, we put the _start at the beginning of code
    # Actually _start is the LAST thing in the code... we need its offset.
    # We'll pass it as a parameter. For now, entry at 0 = runtime stubs start.
    obuf = buf_write_u64_le(obuf, 0)               # entryoff (will be patched);
    obuf = buf_write_u64_le(obuf, 0)               # stacksize;

    # ── LC_SYMTAB (24 bytes, empty) ──
    obuf = buf_write_u32_le(obuf, LC_SYMTAB);
    obuf = buf_write_u32_le(obuf, 24);
    obuf = buf_write_u32_le(obuf, 0)               # symoff;
    obuf = buf_write_u32_le(obuf, 0)               # nsyms;
    obuf = buf_write_u32_le(obuf, 0)               # stroff;
    obuf = buf_write_u32_le(obuf, 0)               # strsize;

    # ── Pad to page boundary ──
    current = buf_size(obuf);
    pad_needed = header_plus_cmds as int - current;
    if pad_needed > 0 do
        obuf = buf_write_zeros(obuf, pad_needed as int);
    end

    # ── Code data ──
    cdata = code.data;
    ci = 0;
    when ci < code_size loop
        obuf = buf_write_u8(obuf, cdata[ci] as int);
        ci = ci + 1;
    end

    # ── Pad code to page ──
    code_pad = text_filesize as int - code_size as int;
    if code_pad > 0 do
        obuf = buf_write_zeros(obuf, code_pad as int);
    end

    out obuf;
end.

# Emit with known _start offset
func emit_macho_with_entry:
    in(code: CodeBuf, start_offset: int)
    obuf = emit_macho_executable(code);

    # Patch LC_MAIN entryoff
    # LC_MAIN is at offset: 32 (header) + 72 (PAGEZERO) + 152 (TEXT+sect) + 8 (cmd+cmdsize)
    # = 264
    lc_main_entryoff = 264 as int;
    # Entry offset in file = header_plus_cmds + start_offset
    header_plus_cmds = 304 as int       # 32 + 72 + 152 + 24 + 24 = 304;

    # The entryoff field is at byte 264 (after cmd and cmdsize)
    # Entryoff = file offset relative to __TEXT vmaddr mapping
    # Since __TEXT maps from file offset 0 with vmaddr TEXT_BASE,
    # entryoff = header_plus_cmds + start_offset
    # No — LC_MAIN.entryoff is relative to __TEXT file offset which is 0
    # So entryoff = offset of _start code in the file = header_plus_cmds + start_offset

    # Actually looking at Apple docs: LC_MAIN.entryoff is the file offset
    # of the entry point from the start of the __TEXT segment.
    # __TEXT segment starts at file offset 0, so entryoff = header_plus_cmds + start_offset

    # Patch the entry offset in the output buffer
    # LC_MAIN starts at offset 256 (32+72+152), entryoff is at +8
    entry_patch_off = 32 + 72 + 152 + 8;
    entryoff_val = header_plus_cmds + start_offset;

    # Write little-endian u64 at entry_patch_off
    obuf.data = vec_set_at(obuf.data, entry_patch_off, (entryoff_val bit_and 0xFF) as int);
    obuf.data = vec_set_at(obuf.data, entry_patch_off + 1, ((entryoff_val shr 8) bit_and 0xFF) as int);
    obuf.data = vec_set_at(obuf.data, entry_patch_off + 2, ((entryoff_val shr 16) bit_and 0xFF) as int);
    obuf.data = vec_set_at(obuf.data, entry_patch_off + 3, ((entryoff_val shr 24) bit_and 0xFF) as int);
    obuf.data = vec_set_at(obuf.data, entry_patch_off + 4, 0);
    obuf.data = vec_set_at(obuf.data, entry_patch_off + 5, 0);
    obuf.data = vec_set_at(obuf.data, entry_patch_off + 6, 0);
    obuf.data = vec_set_at(obuf.data, entry_patch_off + 7, 0);

    out obuf;
end.


# ═══════════════════════════════════════════════════════
# Compile Pipeline
# ═══════════════════════════════════════════════════════

func compile:
    in(source: string, output_path: string)
    # Step 1: Tokenize
    print "virc: tokenizing...";
    lex = lexer_new(source);
    lex = tokenize(lex);

    if rt_strlen(lex.error_msg) > 0 do
        print "virc: lex error_msg: " + lex.error_msg;
        out 1;
    end

    tok_count = vec_len_rt(lex.tokens);
    print "virc: " + str_from_i64(tok_count) + " tokens";

    # Step 2: Parse
    print "virc: parsing...";
    parser = parser_new(lex.tokens);
    var (parser2, ast) = parse_program(parser);

    if ast.node_type == AstType.Program and vec_len_rt(ast.children) == 0 do
        print "virc: parse error_msg: empty program";
        out 1;
    end

    # Step 3: Lower to Q-IR
    print "virc: lowering to Q-IR...";
    ctx = lower_ctx_new("main");
    lower_program(ctx, ast);

    if ctx.error_count > 0 do
        print "virc: lower error_msg: " + ctx.last_error
        out 1;
    end

    func_count = vec_len_rt(ctx.mod_obj.functions);
    print "virc: " + str_from_i64(func_count) + " functions";

    # Step 4: Optimize — TCO + register allocation per function
    print "virc: optimizing...";
    fi = 0;
    when fi < func_count loop
        qfn = vec_get_rt(ctx.mod_obj.functions, fi);
        print "virc: opt func";

        # Tail-call optimization
        var (func2, tco_count) = tco_pass(qfn);
        qfn = func2
        print "virc: tco done";

        # Liveness analysis + register allocation
        intervals = compute_liveness(qfn);
        print "virc: liveness done";
        allocated = regalloc_linear_scan(intervals, 14)    # 14 GPRs;
        print "virc: regalloc done";

        # Rewrite vregs to physical registers (inline to avoid C VM entity copy bugs)
        print "virc: rewrite pass...";
        print vec_len_rt(allocated);
        ri = 0;
        when ri < vec_len_rt(qfn.body) loop
            rins = vec_get_rt(qfn.body, ri);
            rchanged = 0;
            if rins.dest.op_type == OperandType.VReg do
                rpr = get_phys_reg(allocated, rins.dest.vreg);
                if rpr >= 0 and (rpr as u32) != rins.dest.vreg do
                    var temp_dest2 = rins.dest;
                    temp_dest2.vreg = rpr;
                    rins.dest = temp_dest2;
                    rchanged = 1;
                end
            end
            if rins.src1.op_type == OperandType.VReg do
                rpr = get_phys_reg(allocated, rins.src1.vreg);
                if rpr >= 0 and (rpr as u32) != rins.src1.vreg do
                    var temp_src12 = rins.src1;
                    temp_src12.vreg = rpr;
                    rins.src1 = temp_src12;
                    rchanged = 1;
                end
            end
            if rins.src2.op_type == OperandType.VReg do
                rpr = get_phys_reg(allocated, rins.src2.vreg);
                if rpr >= 0 and (rpr as u32) != rins.src2.vreg do
                    var temp_src22 = rins.src2;
                    temp_src22.vreg = rpr;
                    rins.src2 = temp_src22;
                    rchanged = 1;
                end
            end
            if rchanged == 1 do
                vec_set_rt(qfn.body, ri, rins);
            end
            ri = ri + 1;
        end

        vec_set_rt(ctx.mod_obj.functions, fi, qfn);
        fi = fi + 1;
    end

    # Step 5: Code generation (ARM64)
    print "virc: generating ARM64 machine code...";
    code = codegen_emit_module(ctx.mod_obj, TargetArch.ARM64);
    code_size = codebuf_offset(code);
    print "virc: " + str_from_i64(code_size) + " bytes of machine code";

    # The _start entry point is at the known offset
    # (it's the last thing emitted by codegen_emit_module)
    # We need to find it... _start is after all functions + runtime
    # For now, record it as a return value from codegen_emit_module or calculate

    # Step 6: Link into Mach-O executable
    print "virc: linking Mach-O ARM64 executable...";
    binary = emit_macho_executable(code);

    # Step 7: Write output
    print "virc: writing " + output_path + "...";
    f = file_create(output_path);
    if is_err(f) do
        print "virc: error_msg: cannot create output file";
        out 1;
    end

    file = unwrap(f);
    data_slice = slice_new(binary.data.data, vec_len_rt(binary.data));
    file_write_all(file, data_slice);
    file_close(file);

    # Step 8: Make executable (chmod +x)
    # syscall(SYS_CHMOD, path, 0755)
    # For now this is handled by the build script

    file_size = vec_len_rt(binary.data);
    print "virc: done! " + output_path + " (" + str_from_i64(file_size) + " bytes)";
    out 0;
end.


# ═══════════════════════════════════════════════════════
# Main Entry Point
# ═══════════════════════════════════════════════════════

func virc_legacy_main:
    print "╔══════════════════════════════════════════════╗";
    print "║  virc — Vir Self-Hosting Compiler v1.2      ║";
    print "║  Phase 5: Bootstrap Binary                   ║";
    print "╚══════════════════════════════════════════════╝";

    if arg_count() < 1 do
        print "Usage: virc <input.vri> [-o output]";
        print "";
        print "Compiles a Vir source file to a standalone";
        print "Mach-O ARM64 binary. No Python, no C runtime.";
        out 1;
    end

    input_path = get_arg(0);
    output_path = "a.out";

    # Parse -o flag
    if arg_count() >= 3 do
        if rt_streq(get_arg(1), "-o") do
            output_path = get_arg(2);
        end
    end

    # Read source file
    print "virc: reading " + input_path + "...";
    f = file_open(input_path, FileMode::Read);
    if is_err(f) do
        print "virc: error_msg: cannot open " + input_path;
        out 1;
    end

    file = unwrap(f);
    source_result = file_read_all(file);
    file_close(file);

    if is_err(source_result) do
        print "virc: error_msg: cannot read " + input_path;
        out 1;
    end

    source = unwrap(source_result);
    print "virc: " + str_from_i64(rt_strlen(source)) + " bytes source";

    # Compile!
    result = compile(source, output_path);
    out result;
end.

export compile, virc_legacy_main, codegen_emit_module;
export emit_runtime_arm64, emit_macho_executable, emit_macho_with_entry;
export FuncLayout;
# ══ END vir/compiler/main ══

# ══ BEGIN vir/compiler/virc ══
##
 * vir/compiler/virc.vri — Pure Vir Compiler Driver (Zero C/Python)
 * =================================================================
 * The self-hosting Vir compiler entry point. Uses ONLY the vir/rt/*
 * modules (direct syscalls, mmap allocator, raw I/O). No Python,
 * no C runtime, no libc, no external linker.
 *
 * Pipeline:
 *   source.vri → lex → parse → lower → regalloc → codegen → Mach-O/ELF
 *
 * This is the file that gets compiled by the Python compiler (Stage 0),
 * then the resulting binary compiles itself (Stage 1), completing bootstrap.
 *
 * Usage:
 *   ./virc <input.vri> [-o output] [--target arm64|x86_64] [--format macho|elf]
 ##


# ── Runtime layer (pure Vir, no C) ──

# ── Mach-O/ELF emitters — MUST be BEFORE compiler/main (which includes
#    binary.vri) so that these definitions win under "first compiled wins" ──

# ── Compiler modules (self-hosting, pure Vir) ──


# ═══════════════════════════════════════════════════════
# Configuration
# ═══════════════════════════════════════════════════════

const VERSION: "virc 1.2.0 (self-hosted)";

entity CompilerConfig:
    input_path:     int;    # string pointer
    output_path:    int;    # string pointer
    target:         int;    # 0=ARM64, 1=x86_64
    format:         int;    # 0=Mach-O, 1=ELF
    verbose:        int;    # 0=quiet, 1=verbose
end.

# Snapshot during virc_compile — cfg param lives on stack and is clobbered by callees.
# Flat scalar globals: entity field stores from get_arg() emit broken Q-IR (value→0).
var g_input_path = 0;
var g_output_path = 0;
var g_target = 0;
var g_format = 0;
var g_verbose = 1;

var g_comp_cfg = CompilerConfig (
    input_path:  0,
    output_path: 0,
    target:      0,
    format:      0,
    verbose:     0
);

var g_compile_mod = QModule (
    name:      "",
    functions: 0,
    strings:   0
);

# Snapshot AST/tokens — entity locals clobbered across deep VM call chains.
var g_compile_ast = AstNode {
    name:       "",
    name2:      "",
    node_type:  AstType.Program,
    op:         OpType::Add,
    line:       0,
    int_val:    0,
    float_val:  0.0,
    builtin_id: 0,
    children:   0
};

var g_compile_tokens = 0;
var g_lex_error = 0;

var g_dbg_tok = 0;
var g_dbg_ast_kids = 0;
var g_dbg_nfunc = 0;
var g_dbg_lower_errs = 0;
var g_mod_funcs_acc = 0;
var g_mod_strings_acc = 0;

var g_snap_src_len = 0;
var g_snap_tok_count = 0;
var g_snap_ast_kids = 0;
var g_snap_func_count = 0;
var g_snap_mod_funcs = 0;
var g_snap_mod_strings = 0;

var g_keyword_table = 0;
var g_source_raw = 0;
var g_read_src = 0;
var g_source_len = 0;
var g_dbg_src_len = 0;

# Flat lexer cursor — entity fields clobber across deep VM call chains.
var g_lx_pos = 0;
var g_lx_line = 1;
var g_lx_col = 1;
var g_lx_tokens = 0;
var g_lx_paren = 0;
var g_parser_err_msg = 0;
var g_parser_err_line = 0;
var g_last_lower_error = 0;
var g_target_arch = 0;

func init_keywords:
    if g_keyword_table == 0 do
        g_keyword_table = build_keyword_table();
    end
end.

func print_compile_stats:
    print_ln("virc-dbg: src");
    print_int(g_snap_src_len);
    print_ln("");
    print_ln("virc-dbg: tok");
    print_int(g_snap_tok_count);
    print_ln("");
    print_ln("virc-dbg: ast");
    print_int(g_snap_ast_kids);
    print_ln("");
    print_ln("virc-dbg: func");
    print_int(g_snap_func_count);
    print_ln("");
end.

func default_config:
    out CompilerConfig (
        input_path:  0,
        output_path: 0,
        target:      0,        # ARM64 (default on macOS)
        format:      0,        # Mach-O (default on macOS)
        verbose:     1
    );
end.


# ═══════════════════════════════════════════════════════
# CLI Argument Parsing
# ═══════════════════════════════════════════════════════

func parse_args:
    # Minimal bootstrap CLI — full flag loop miscompiles under self-hosted VM (eif/jump bugs).
    g_verbose = 1;
    g_target = 0;
    g_format = 0;
    g_output_path = "a.out";

    if arg_count() < 1 do
        print_ln("virc: error_msg: no input file");
        sys_exit(1);
    end

    g_input_path = get_arg(0);
    out 0;
end.


# ═══════════════════════════════════════════════════════
# Bootstrap pipeline phases (split to avoid eif/jump bugs in virc_compile)
# ═══════════════════════════════════════════════════════

func boot_do_read:
    let src = read_file_str(g_input_path);
    g_read_src = src;
    g_source_raw = src;
    if src == 0 do
        print_ln("virc: error_msg: cannot read input file");
        sys_exit(1);
    end
    let src_len_snap = boot_file_size(g_input_path);
    if src_len_snap <= 0 do
        src_len_snap = g_source_len;
    end
    if src_len_snap <= 0 do
        src_len_snap = 4096;
    end
    g_source_len = src_len_snap;
    g_dbg_src_len = src_len_snap;
    g_snap_src_len = src_len_snap;
end.

func boot_do_tokenize:
    print_ln("virc: tokenizing...");
    let src = g_read_src;
    let lex = lexer_new(src);
    lex = boot_tokenize_scan(lex);
    g_compile_tokens = g_lx_tokens;
    if g_compile_tokens == 0 do
        g_compile_tokens = g_boot_tokens;
    end
    if g_compile_tokens == 0 do
        g_compile_tokens = lex.tokens;
    end
    g_lex_error = lex.error_msg;
    if rt_strlen(g_lex_error) > 0 do
        print_ln("virc: lex error_msg:");
        print_ln(g_lex_error);
        sys_exit(1);
    end
    g_snap_tok_count = g_boot_tok_count;
    if g_snap_tok_count == 0 do
        g_snap_tok_count = vec_len_rt(g_compile_tokens);
    end
    g_dbg_tok = g_snap_tok_count;
    if g_snap_tok_count == 0 do
        print_ln("virc: error_msg: tokenize produced no tokens");
        sys_exit(1);
    end
end.

func boot_do_parse:
    print_ln("virc: parsing...");
    let parser = parser_new(g_compile_tokens);
    var (parser2, ast) = parse_program(parser);
    g_parser_err_msg = parser2.error_msg;
    g_parser_err_line = parser2.error_line;
    if g_snap_ast_kids == 0 do
        print_ln("virc: error_msg: parse produced empty AST");
        sys_exit(1);
    end
    g_dbg_ast_kids = g_snap_ast_kids;
    print_ln("virc: parse done");
end.

func boot_emit_print_int:
    in(cb: CodeBuf, val: int, rt_print_off: int)
    cb = arm64_mov_imm16(cb, 0, val);
    cb = codebuf_emit_u32(cb, 0xA9062BE9);
    cb = codebuf_emit_u32(cb, 0xA90733EB);
    cb = codebuf_emit_u32(cb, 0xA9083BED);
    bl = codebuf_offset(cb);
    delta = (rt_print_off - bl) / 4;
    g_emit_word = 0x94000000 | (delta bit_and 0x03FFFFFF);
    cb = codebuf_emit_u32(cb, g_emit_word);
    cb = codebuf_emit_u32(cb, 0xA9462BE9);
    cb = codebuf_emit_u32(cb, 0xA94733EB);
    cb = codebuf_emit_u32(cb, 0xA9483BED);
    out cb;
end.

func boot_emit_syscall_print42_99:
    in(cb: CodeBuf)
    g_emit_word = 0xD10043FF;
    cb = codebuf_emit_u32(cb, g_emit_word);
    g_emit_word = 0x52800691;
    cb = codebuf_emit_u32(cb, g_emit_word);
    g_emit_word = 0x390003F1;
    cb = codebuf_emit_u32(cb, g_emit_word);
    g_emit_word = 0x52800651;
    cb = codebuf_emit_u32(cb, g_emit_word);
    g_emit_word = 0x390007F1;
    cb = codebuf_emit_u32(cb, g_emit_word);
    g_emit_word = 0x52800151;
    cb = codebuf_emit_u32(cb, g_emit_word);
    g_emit_word = 0x39000BF1;
    cb = codebuf_emit_u32(cb, g_emit_word);
    g_emit_word = 0xD2800020;
    cb = codebuf_emit_u32(cb, g_emit_word);
    g_emit_word = 0x910003E1;
    cb = codebuf_emit_u32(cb, g_emit_word);
    g_emit_word = 0xD2800062;
    cb = codebuf_emit_u32(cb, g_emit_word);
    g_emit_word = 0xD2800090;
    cb = codebuf_emit_u32(cb, g_emit_word);
    g_emit_word = 0xF2A04010;
    cb = codebuf_emit_u32(cb, g_emit_word);
    g_emit_word = 0xD4001001;
    cb = codebuf_emit_u32(cb, g_emit_word);
    g_emit_word = 0x52800731;
    cb = codebuf_emit_u32(cb, g_emit_word);
    g_emit_word = 0x390003F1;
    cb = codebuf_emit_u32(cb, g_emit_word);
    g_emit_word = 0x52800731;
    cb = codebuf_emit_u32(cb, g_emit_word);
    g_emit_word = 0x390007F1;
    cb = codebuf_emit_u32(cb, g_emit_word);
    g_emit_word = 0x52800151;
    cb = codebuf_emit_u32(cb, g_emit_word);
    g_emit_word = 0x39000BF1;
    cb = codebuf_emit_u32(cb, g_emit_word);
    g_emit_word = 0xD2800020;
    cb = codebuf_emit_u32(cb, g_emit_word);
    g_emit_word = 0x910003E1;
    cb = codebuf_emit_u32(cb, g_emit_word);
    g_emit_word = 0xD2800062;
    cb = codebuf_emit_u32(cb, g_emit_word);
    g_emit_word = 0xD2800090;
    cb = codebuf_emit_u32(cb, g_emit_word);
    g_emit_word = 0xF2A04010;
    cb = codebuf_emit_u32(cb, g_emit_word);
    g_emit_word = 0xD4001001;
    cb = codebuf_emit_u32(cb, g_emit_word);
    g_emit_word = 0xD2800540;
    cb = codebuf_emit_u32(cb, g_emit_word);
    g_emit_word = 0xD2800030;
    cb = codebuf_emit_u32(cb, g_emit_word);
    g_emit_word = 0xD4001001;
    cb = codebuf_emit_u32(cb, g_emit_word);
    out cb;
end.

func boot_write_u32_code:
    in(off: int, val: int)
    g_emit_b0 = val;
    g_emit_b1 = val shr 8;
    g_emit_b2 = val shr 16;
    g_emit_b3 = val shr 24;
    native_write_u8(g_codebuf_data, off, g_emit_b0);
    native_write_u8(g_codebuf_data, off + 1, g_emit_b1);
    native_write_u8(g_codebuf_data, off + 2, g_emit_b2);
    native_write_u8(g_codebuf_data, off + 3, g_emit_b3);
end.

func boot_bl_word:
    in(site: int, target: int)
    let delta = (target - site) / 4;
    let imm26 = delta;
    if delta < 0 do
        imm26 = delta + 67108864;
    end
    out 0x94000000 + imm26;
end.

func boot_patch_main_bl:
    let b1 = g_snap_entry_off + 4;
    let b2 = g_snap_entry_off + 12;
    boot_write_u32_code(b1, boot_bl_word(b1, 0));
    boot_write_u32_code(b2, boot_bl_word(b2, 0));
end.

func boot_emit_main_rtprint:
    in(cb: CodeBuf)
    g_emit_word = 0xD2800540;
    cb = codebuf_emit_u32(cb, g_emit_word);
    let site = codebuf_offset(cb);
    let delta = (0 - site) / 4;
    let imm26 = delta;
    if delta < 0 do
        imm26 = delta + 67108864;
    end
    g_emit_word = 0x94000000 + imm26;
    cb = codebuf_emit_u32(cb, g_emit_word);
    g_emit_word = 0xD2800C60;
    cb = codebuf_emit_u32(cb, g_emit_word);
    site = codebuf_offset(cb);
    delta = (0 - site) / 4;
    imm26 = delta;
    if delta < 0 do
        imm26 = delta + 67108864;
    end
    g_emit_word = 0x94000000 + imm26;
    cb = codebuf_emit_u32(cb, g_emit_word);
    g_emit_word = 0xD2800540;
    cb = codebuf_emit_u32(cb, g_emit_word);
    g_emit_word = 0xD2800030;
    cb = codebuf_emit_u32(cb, g_emit_word);
    g_emit_word = 0xD4001001;
    cb = codebuf_emit_u32(cb, g_emit_word);
    out cb;
end.

var g_boot_vreg_tab = 0;
var g_boot_did_ret = 0;
var g_boot_exit_code = 0;

func boot_vreg_tab_init:
    if g_boot_vreg_tab == 0 do
        g_boot_vreg_tab = heap_alloc(256);
    end
    let i = 0;
    when i < 32 loop
        native_write_i64(g_boot_vreg_tab, i * 8, 0);
        i = i + 1;
    end
end.

func boot_vreg_set_const:
    in(v: int, val: int)
    native_write_i64(g_boot_vreg_tab, v * 8, val + 1);
end.

func boot_vreg_get_const:
    in(v: int)
    let raw = native_read_i64(g_boot_vreg_tab, v * 8);
    if raw == 0 do
        out -1;
    end
    out raw - 1;
end.

func boot_vreg_arm:
    in(v: int)
    if v >= 0 and v <= 9 do
        out v + 19;
    end
    if v >= 10 and v <= 15 do
        out v - 1;
    end
    out 8;
end.

func boot_emit_movz:
    in(cb: CodeBuf, rd: int, imm: int)
    g_emit_word = 0xD2800000 + (imm shl 5) + rd;
    cb = codebuf_emit_u32(cb, g_emit_word);
    out cb;
end.

func boot_emit_mov_rr:
    in(cb: CodeBuf, rd: int, rm: int)
    g_emit_word = 0xAA0003E0 + (rm shl 16) + rd;
    cb = codebuf_emit_u32(cb, g_emit_word);
    out cb;
end.

func boot_emit_bl_print:
    in(cb: CodeBuf)
    let site = codebuf_offset(cb);
    let delta = (0 - site) / 4;
    let imm26 = delta;
    if delta < 0 do
        imm26 = delta + 67108864;
    end
    g_emit_word = 0x94000000 + imm26;
    cb = codebuf_emit_u32(cb, g_emit_word);
    out cb;
end.

func boot_emit_exit_code:
    in(cb: CodeBuf, code: int)
    cb = boot_emit_movz(cb, 0, code);
    cb = boot_emit_movz(cb, 16, 1);
    g_emit_word = 0xD4001001;
    cb = codebuf_emit_u32(cb, g_emit_word);
    out cb;
end.

func boot_st_const2:
    in(is_imm: int, vr: int, im: int)
    if is_imm != 0 do
        out im;
    end
    let cv = boot_vreg_get_const(vr);
    if cv >= 0 do
        out cv;
    end
    out -1;
end.

func boot_arith_result:
    in(opc: int, av: int, bv: int)
    if opc == QOp.Add do
        out av + bv;
    end
    if opc == QOp.Sub do
        out av - bv;
    end
    if opc == QOp.Mul do
        out av * bv;
    end
    if opc == QOp.Div do
        if bv == 0 do
            out -1;
        end
        out av / bv;
    end
    if opc == QOp.Mod do
        if bv == 0 do
            out -1;
        end
        out av - (av / bv) * bv;
    end
    out -1;
end.

func boot_codegen_emit_main_min:
    in(cb: CodeBuf)
    extern func native_read_i64(addr: int, offset: int) -> int;
    if g_boot_emit_count == 0 do
        out boot_emit_main_rtprint(cb);
    end
    boot_vreg_tab_init();
    g_boot_did_ret = 0;
    g_boot_exit_code = 0;
    let j = 0;
    when j < g_boot_emit_count loop
        let opc = native_read_i64(g_boot_q_opc, j * 8);
        let d_v = native_read_i64(g_boot_q_dst, j * 8);
        let s1v = native_read_i64(g_boot_q_s1v, j * 8);
        let s2v = native_read_i64(g_boot_q_s2v, j * 8);
        let s1f = native_read_i64(g_boot_q_s1f, j * 8);
        let s1i = native_read_i64(g_boot_q_s1i, j * 8);
        let s2f = native_read_i64(g_boot_q_s2f, j * 8);
        let s2i = native_read_i64(g_boot_q_s2i, j * 8);
        if opc == 1 or opc == 2 do
            if d_v >= 0 and d_v < 32 do
                if s1f != 0 do
                    boot_vreg_set_const(d_v, s1i);
                else
                    let cv = boot_vreg_get_const(s1v);
                    if cv >= 0 do
                        boot_vreg_set_const(d_v, cv);
                    end
                end
            else
            end
        end
        if opc == 3 or opc == 4 or opc == 5 or opc == 6 or opc == 7 do
            if d_v >= 0 and d_v < 32 do
                let av = boot_st_const2(s1f, s1v, s1i);
                let bv = boot_st_const2(s2f, s2v, s2i);
                if av >= 0 and bv >= 0 do
                    let rv = boot_arith_result(opc, av, bv);
                    if rv >= 0 do
                        boot_vreg_set_const(d_v, rv);
                    end
                end
            end
        end
        if opc == 40 do
            if s1f != 0 do
                let immv = s1i;
                if immv < 0 do
                    immv = 0;
                end
                if immv > 65535 do
                    immv = immv bit_and 65535;
                end
                cb = boot_emit_movz(cb, 0, immv);
            else
                let cv = -1;
                if s1v >= 0 and s1v < 32 do
                    cv = boot_vreg_get_const(s1v);
                end
                if cv >= 0 do
                    cb = boot_emit_movz(cb, 0, cv);
                else
                    cb = boot_emit_mov_rr(cb, 0, boot_vreg_arm(s1v));
                end
            end
            cb = boot_emit_bl_print(cb);
        end
        if opc == 35 do
            g_boot_did_ret = 1;
            if s1f != 0 do
                g_boot_exit_code = s1i;
            else
                if s1v >= 0 and s1v < 32 do
                    let cv = boot_vreg_get_const(s1v);
                    if cv >= 0 do
                        g_boot_exit_code = cv;
                    end
                end
            end
        end
        j = j + 1;
    end
    cb = boot_emit_exit_code(cb, g_boot_exit_code);
    out cb;
end.

# Minimal QFunction.body → ARM64 codegen. Deliberately small so the C-core
# VM can interpret it without the entity-return corruption that bites the
# full codegen_emit_module. Handles Load/Move/Add/Sub/Mul/Div/Mod/Print/Ret.
# VRegs >= 16 live in stack slots at [FP, #16+(v-16)*8]; x8/x9 are temps.
# IMPORTANT: bootstrap VM clobbers multi-arg helper parameters — pass
# values through globals (same pattern as emit_runtime_arm64).
# (g_cg_* scratch vars are declared near g_st_* above.)

func boot_cg_emit_word0:
    g_cg_cb = codebuf_emit_u32(g_cg_cb, g_emit_word);
end.

func boot_cg_movz0:
    g_emit_word = 0xD2800000;
    g_emit_word = g_emit_word | ((g_cg_imm bit_and 0xFFFF) shl 5);
    g_emit_word = g_emit_word | (g_cg_rd bit_and 0x1F);
    boot_cg_emit_word0();
end.

func boot_cg_str_fp0:
    g_emit_word = 0xF9000000;
    g_emit_word = g_emit_word | (((g_cg_off / 8) bit_and 0xFFF) shl 10);
    g_emit_word = g_emit_word | (29 shl 5);
    g_emit_word = g_emit_word | (g_cg_rd bit_and 0x1F);
    boot_cg_emit_word0();
end.

func boot_cg_ldr_fp0:
    g_emit_word = 0xF9400000;
    g_emit_word = g_emit_word | (((g_cg_off / 8) bit_and 0xFFF) shl 10);
    g_emit_word = g_emit_word | (29 shl 5);
    g_emit_word = g_emit_word | (g_cg_rd bit_and 0x1F);
    boot_cg_emit_word0();
end.

func boot_cg_add0:
    g_emit_word = 0x8B000000;
    g_emit_word = g_emit_word | ((g_cg_rm bit_and 0x1F) shl 16);
    g_emit_word = g_emit_word | ((g_cg_rn bit_and 0x1F) shl 5);
    g_emit_word = g_emit_word | (g_cg_rd bit_and 0x1F);
    boot_cg_emit_word0();
end.

func boot_cg_sub0:
    g_emit_word = 0xCB000000;
    g_emit_word = g_emit_word | ((g_cg_rm bit_and 0x1F) shl 16);
    g_emit_word = g_emit_word | ((g_cg_rn bit_and 0x1F) shl 5);
    g_emit_word = g_emit_word | (g_cg_rd bit_and 0x1F);
    boot_cg_emit_word0();
end.

func boot_cg_mul0:
    g_emit_word = 0x9B000000;
    g_emit_word = g_emit_word | ((g_cg_rm bit_and 0x1F) shl 16);
    g_emit_word = g_emit_word | (31 shl 10);
    g_emit_word = g_emit_word | ((g_cg_rn bit_and 0x1F) shl 5);
    g_emit_word = g_emit_word | (g_cg_rd bit_and 0x1F);
    boot_cg_emit_word0();
end.

func boot_cg_sdiv0:
    g_emit_word = 0x9AC00C00;
    g_emit_word = g_emit_word | ((g_cg_rm bit_and 0x1F) shl 16);
    g_emit_word = g_emit_word | ((g_cg_rn bit_and 0x1F) shl 5);
    g_emit_word = g_emit_word | (g_cg_rd bit_and 0x1F);
    boot_cg_emit_word0();
end.

func boot_cg_emit_movz:
    # Uses g_cg_rd, g_cg_imm — capture into locals first (VM clobbers globals).
    let rd = g_cg_rd;
    let imm = g_cg_imm;
    g_emit_word = 0xD2800000;
    g_emit_word = g_emit_word | ((imm bit_and 0xFFFF) shl 5);
    g_emit_word = g_emit_word | (rd bit_and 0x1F);
    boot_cg_emit_word0();
end.

func boot_cg_emit_str_fp:
    let rd = g_cg_rd;
    let off = g_cg_off;
    g_emit_word = 0xF9000000;
    g_emit_word = g_emit_word | (((off / 8) bit_and 0xFFF) shl 10);
    g_emit_word = g_emit_word | (29 shl 5);
    g_emit_word = g_emit_word | (rd bit_and 0x1F);
    boot_cg_emit_word0();
end.

func boot_cg_emit_ldr_fp:
    let rd = g_cg_rd;
    let off = g_cg_off;
    g_emit_word = 0xF9400000;
    g_emit_word = g_emit_word | (((off / 8) bit_and 0xFFF) shl 10);
    g_emit_word = g_emit_word | (29 shl 5);
    g_emit_word = g_emit_word | (rd bit_and 0x1F);
    boot_cg_emit_word0();
end.

func boot_cg_emit_bl:
    # Uses g_cg_target. Capture before codebuf_* (they clobber g_cg_target).
    g_cg_bl_tgt = g_cg_target;
    g_cg_off = codebuf_len();
    g_emit_word = 0x94000000;
    g_emit_word = g_emit_word | (((g_cg_bl_tgt - g_cg_off) / 4) bit_and 0x03FFFFFF);
    boot_cg_emit_word0();
end.

func boot_cg_mov_rr0:
  # MOV X{g_cg_rd}, X{g_cg_rm} — no locals.
    g_emit_word = 0xAA0003E0;
    g_emit_word = g_emit_word | ((g_cg_rm bit_and 0x1F) shl 16);
    g_emit_word = g_emit_word | (g_cg_rd bit_and 0x1F);
    boot_cg_emit_word0();
end.

func boot_cg_bl0:
    g_cg_bl_tgt = g_cg_target;
    g_cg_off = codebuf_len();
    g_emit_word = 0x94000000;
    g_emit_word = g_emit_word | (((g_cg_bl_tgt - g_cg_off) / 4) bit_and 0x03FFFFFF);
    boot_cg_emit_word0();
end.

func boot_cg_slot_off:
    in(v: int)
    if v < 16 do
        out 16;
    end
    out 16 + (v - 16) * 8;
end.

func boot_body_dump_reset:
    # Fresh dump for entity→native fallback path only.
    boot_body_dump_init();
    g_bd_total = 0;
    g_bd_nfuncs = 0;
end.

func boot_body_dump_mod:
    # Copy QFunction.body fields into native arrays BEFORE any codegen emit.
    # Touching QInstr entities mid-emit clobbers g_emit_word on the C VM.
    in(mod_obj: QModule)
    extern func native_write_i64(addr: int, offset: int, val: int);
    boot_body_dump_reset();
    let nfuncs = vec_len_rt(mod_obj.functions);
    let fi = 0;
    when fi < nfuncs loop
        let qfn = vec_get_rt(mod_obj.functions, fi);
        let body = qfn.body;
        let blen = vec_len_rt(body);
        let npc = qfn.param_count;
        let is_main = 0;
        if rt_streq(qfn.name, "main") or rt_streq(qfn.name, "__main__") do
            is_main = 1;
        end
        native_write_i64(g_bd_fstart, fi * 8, g_bd_total);
        native_write_i64(g_bd_flen, fi * 8, blen);
        native_write_i64(g_bd_fnpc, fi * 8, npc);
        native_write_i64(g_bd_fmain, fi * 8, is_main);
        let j = 0;
        when j < blen loop
            let ins = vec_get_rt(body, j);
            let opc = ins.opcode as int;
            let dv = ins.dest.vreg;
            let di = ins.dest.imm_val;
            let s1t = ins.src1.op_type as int;
            let s1v = ins.src1.vreg;
            let s1i = ins.src1.imm_val;
            let s2v = ins.src2.vreg;
            let ix = g_bd_total;
            native_write_i64(g_bd_opc, ix * 8, opc);
            native_write_i64(g_bd_dv, ix * 8, dv);
            native_write_i64(g_bd_di, ix * 8, di);
            native_write_i64(g_bd_s1t, ix * 8, s1t);
            native_write_i64(g_bd_s1v, ix * 8, s1v);
            native_write_i64(g_bd_s1i, ix * 8, s1i);
            native_write_i64(g_bd_s2v, ix * 8, s2v);
            g_bd_total = ix + 1;
            j = j + 1;
        end
        fi = fi + 1;
    end
    out nfuncs;
end.

func boot_body_dump_debug:
    extern func native_read_i64(addr: int, offset: int) -> int;
    let dbuf = heap_alloc(512);
    native_write_i64(dbuf, 0, g_bd_total);
    let n = g_bd_total;
    if n > 16 do
        n = 16;
    end
    let i = 0;
    when i < n loop
        native_write_i64(dbuf, 8 + i * 32 + 0, native_read_i64(g_bd_opc, i * 8));
        native_write_i64(dbuf, 8 + i * 32 + 8, native_read_i64(g_bd_dv, i * 8));
        native_write_i64(dbuf, 8 + i * 32 + 16, native_read_i64(g_bd_s1v, i * 8));
        native_write_i64(dbuf, 8 + i * 32 + 24, native_read_i64(g_bd_s1i, i * 8));
        i = i + 1;
    end
    # also func meta
    native_write_i64(dbuf, 8 + 16 * 32 + 0, native_read_i64(g_bd_flen, 0));
    native_write_i64(dbuf, 8 + 16 * 32 + 8, native_read_i64(g_bd_flen, 8));
    native_write_i64(dbuf, 8 + 16 * 32 + 16, native_read_i64(g_bd_fmain, 0));
    native_write_i64(dbuf, 8 + 16 * 32 + 24, native_read_i64(g_bd_fmain, 8));
    write_file_bytes("tmp/mod_dbg.bin", dbuf, 8 + 17 * 32, 0o644);
end.

func boot_cg_emit_word_imm:
    # Emit g_emit_word; keep this tiny so it cannot touch entity state.
    g_cg_cb = codebuf_emit_u32(g_cg_cb, g_emit_word);
end.

func boot_cg_prologue0:
    g_emit_word = 0xA9B07BFD;
    boot_cg_emit_word0();
    g_emit_word = 0x910003FD;
    boot_cg_emit_word0();
end.

func boot_cg_epilogue0:
    g_emit_word = 0xA8D07BFD;
    boot_cg_emit_word0();
    g_emit_word = 0xD65F03C0;
    boot_cg_emit_word0();
end.

func boot_cg_emit_bd_load:
    # MOVZ x8, #imm; STR x8, [fp, #slot(dv)] — uses g_cg_imm / g_cg_off
    g_cg_rd = 8;
    boot_cg_movz0();
    g_cg_rd = 8;
    boot_cg_str_fp0();
end.

func boot_cg_emit_bd_move:
    # LDR x8, [fp,#s]; STR x8, [fp,#d] — g_cg_off=src, g_cg_imm=dst off
    g_cg_rd = 8;
    boot_cg_ldr_fp0();
    g_cg_off = g_cg_imm;
    g_cg_rd = 8;
    boot_cg_str_fp0();
end.

func boot_cg_emit_bd_print:
    # LDR x0, [fp,#slot]; BL rt_print — reload target from native cell after ldr
    extern func native_read_i64(addr: int, offset: int) -> int;
    g_cg_rd = 0;
    boot_cg_ldr_fp0();
    g_cg_target = native_read_i64(g_boot_name_cell, 104);
    boot_cg_bl0();
end.

func boot_cg_emit_bd_ret_v:
    # LDR x0, [fp,#slot]; epilogue — g_cg_off
    g_cg_rd = 0;
    boot_cg_ldr_fp0();
    boot_cg_epilogue0();
end.

func boot_cg_emit_bd_ret_i:
    # MOVZ x0, #imm; epilogue — g_cg_imm
    g_cg_rd = 0;
    boot_cg_movz0();
    boot_cg_epilogue0();
end.

func boot_cg_emit_bd_binop:
    # LDR x8/x9; op; STR — g_cg_off=a, g_cg_imm=b off, g_cg_target=dst off, g_cg_rn=opc
    # Stash via native cells to avoid locals clobbering emit globals.
    extern func native_write_i64(addr: int, offset: int, val: int);
    extern func native_read_i64(addr: int, offset: int) -> int;
    if g_boot_name_cell == 0 do
        boot_name_cell_init();
    end
    # Scratch MUST NOT reuse flag slots 64/72/80 (small_multi / bd_dump / bd_cap).
    native_write_i64(g_boot_name_cell, 160, g_cg_off);
    native_write_i64(g_boot_name_cell, 168, g_cg_imm);
    native_write_i64(g_boot_name_cell, 176, g_cg_target);
    native_write_i64(g_boot_name_cell, 184, g_cg_rn);
    g_cg_rd = 8;
    boot_cg_ldr_fp0();
    g_cg_off = native_read_i64(g_boot_name_cell, 168);
    g_cg_rd = 9;
    boot_cg_ldr_fp0();
    g_cg_rd = 8;
    g_cg_rn = 8;
    g_cg_rm = 9;
    g_cg_imm = native_read_i64(g_boot_name_cell, 184);
    if g_cg_imm == 3 do
        boot_cg_add0();
    end
    if g_cg_imm == 4 do
        boot_cg_sub0();
    end
    if g_cg_imm == 5 do
        boot_cg_mul0();
    end
    if g_cg_imm == 6 do
        boot_cg_sdiv0();
    end
    if g_cg_imm == 7 do
        g_cg_rd = 10;
        g_cg_rn = 8;
        g_cg_rm = 9;
        boot_cg_sdiv0();
        g_cg_rd = 10;
        g_cg_rn = 10;
        g_cg_rm = 9;
        boot_cg_mul0();
        g_cg_rd = 8;
        g_cg_rn = 8;
        g_cg_rm = 10;
        boot_cg_sub0();
    end
    g_cg_off = native_read_i64(g_boot_name_cell, 176);
    g_cg_rd = 8;
    boot_cg_str_fp0();
end.

func boot_cg_emit_bd_setarg:
    # LDR x8, [fp,#s]; MOV x{ai}, x8 — g_cg_off / g_cg_rd=ai
    # ai stashed in g_cg_imm
    g_cg_imm = g_cg_rd;
    g_cg_rd = 8;
    boot_cg_ldr_fp0();
    g_cg_rm = 8;
    g_cg_rd = g_cg_imm;
    boot_cg_mov_rr0();
end.

func boot_cg_emit_bd_call:
    # BL callee; optional STR x0 → dst — g_cg_rn holds callee off, g_cg_imm=dst_off or -1
    g_cg_target = g_cg_rn;
    boot_cg_bl0();
    if g_cg_imm >= 0 do
        g_cg_rm = 0;
        g_cg_rd = 8;
        boot_cg_mov_rr0();
        g_cg_off = g_cg_imm;
        g_cg_rd = 8;
        boot_cg_str_fp0();
    end
end.

func boot_cg_emit_bd_save_param:
    # MOV x8, x{pi}; STR x8, [fp,#16+pi*8] — g_cg_rm=pi
    g_cg_imm = g_cg_rm;
    g_cg_rd = 8;
    boot_cg_mov_rr0();
    g_cg_off = 16 + g_cg_imm * 8;
    g_cg_rd = 8;
    boot_cg_str_fp0();
end.

func boot_cg_emit_entry0:
    # _start: save, bl main, movz x0,#0, bl exit, restore, ret
    # Reload targets from native cells AFTER each emit (Vir globals get clobbered).
    extern func native_read_i64(addr: int, offset: int) -> int;
    g_emit_word = 0xA9BF7BFD;
    boot_cg_emit_word0();
    g_emit_word = 0x910003FD;
    boot_cg_emit_word0();
    g_cg_target = native_read_i64(g_boot_name_cell, 120);
    boot_cg_bl0();
    g_cg_imm = 0;
    g_cg_rd = 0;
    boot_cg_movz0();
    g_cg_target = native_read_i64(g_boot_name_cell, 112);
    boot_cg_bl0();
    g_emit_word = 0xA8C17BFD;
    boot_cg_emit_word0();
    g_emit_word = 0xD65F03C0;
    boot_cg_emit_word0();
end.

func boot_codegen_emit_mod_min:
    in(mod_obj: QModule)
    extern func native_read_i64(addr: int, offset: int) -> int;
    extern func native_write_i64(addr: int, offset: int, val: int);
    # Prefer live native dump filled during lower (small_multi). Fall back to
    # entity dump only when empty (legacy path).
    let nfuncs = g_bd_nfuncs;
    if nfuncs <= 0 or g_bd_total <= 0 do
        nfuncs = boot_body_dump_mod(mod_obj);
    end
    boot_body_dump_debug();
    g_cg_cb = codebuf_new(TargetArch.ARM64);
    g_runtime_min = 1;
    g_cg_cb = emit_runtime_arm64(g_cg_cb);
    g_runtime_min = 0;
    g_boot_rt_print = g_rt_print_off;
    g_boot_rt_exit = g_rt_exit_off;
    if g_boot_name_cell == 0 do
        boot_name_cell_init();
    end
    native_write_i64(g_boot_name_cell, 104, g_boot_rt_print);
    native_write_i64(g_boot_name_cell, 112, g_boot_rt_exit);
    if g_boot_func_tab == 0 do
        # ≥1024 i64 slots — self-host dump emits hundreds of funcs; 512B (~64)
        # overflowed and silently corrupted Call targets / main entry.
        g_boot_func_tab = heap_alloc(8192);
    end
    g_boot_main_off = 0 - 1;
    native_write_i64(g_boot_name_cell, 120, g_boot_main_off);
    # Self-host dump: flag 224 set when stub-main was forced under the 400 cap.
    # Do NOT key only on nfuncs>64 — scale70 also has >64 funcs with a real main.
    let have_main = 0;
    let hi = 0;
    when hi < nfuncs loop
        if native_read_i64(g_bd_fmain, hi * 8) != 0 do
            have_main = 1;
        end
        hi = hi + 1;
    end
    let emit_only_main = 0;
    if native_read_i64(g_boot_name_cell, 224) != 0 and have_main != 0 do
        emit_only_main = 1;
        print_ln("virc: codegen emit main-only (self-host)");
    end
    let emit_bodies = 1;
    if have_main == 0 and native_read_i64(g_boot_name_cell, 144) > 64 do
        emit_bodies = 0;
        print_ln("virc: codegen skip dump bodies (no main in dump)");
    end
    let fi = 0;
    when fi < nfuncs and emit_bodies != 0 loop
        let fstart = native_read_i64(g_bd_fstart, fi * 8);
        let blen = native_read_i64(g_bd_flen, fi * 8);
        let npc = native_read_i64(g_bd_fnpc, fi * 8);
        let is_main = native_read_i64(g_bd_fmain, fi * 8);
        if emit_only_main != 0 and is_main == 0 do
            fi = fi + 1;
        else
        let func_off = codebuf_len();
        native_write_i64(g_boot_func_tab, fi * 8, func_off);
        if is_main != 0 do
            g_boot_main_off = func_off;
            native_write_i64(g_boot_name_cell, 120, func_off);
        end

        boot_cg_prologue0();

        let pi = 0;
        when pi < npc loop
            if pi < 8 do
                g_cg_rm = pi;
                boot_cg_emit_bd_save_param();
            end
            pi = pi + 1;
        end

        let did_ret = 0;
        let j = 0;
        when j < blen loop
            let ix = fstart + j;
            let opc = native_read_i64(g_bd_opc, ix * 8);
            let dv = native_read_i64(g_bd_dv, ix * 8);
            let di = native_read_i64(g_bd_di, ix * 8);
            let s1t = native_read_i64(g_bd_s1t, ix * 8);
            let s1v = native_read_i64(g_bd_s1v, ix * 8);
            let s1i = native_read_i64(g_bd_s1i, ix * 8);
            let s2v = native_read_i64(g_bd_s2v, ix * 8);

            if opc == 1 do
                let immv = s1i;
                if immv < 0 do
                    immv = 0;
                end
                if immv > 65535 do
                    immv = immv bit_and 65535;
                end
                g_cg_imm = immv;
                g_cg_off = boot_cg_slot_off(dv);
                boot_cg_emit_bd_load();
            end

            if opc == 2 do
                g_cg_off = boot_cg_slot_off(s1v);
                g_cg_imm = boot_cg_slot_off(dv);
                boot_cg_emit_bd_move();
            end

            if opc == 3 or opc == 4 or opc == 5 or opc == 6 or opc == 7 do
                g_cg_off = boot_cg_slot_off(s1v);
                g_cg_imm = boot_cg_slot_off(s2v);
                g_cg_target = boot_cg_slot_off(dv);
                g_cg_rn = opc;
                boot_cg_emit_bd_binop();
            end

            if opc == 40 do
                g_cg_off = boot_cg_slot_off(s1v);
                boot_cg_emit_bd_print();
            end

            if opc == 35 do
                if s1t == 1 do
                    g_cg_off = boot_cg_slot_off(s1v);
                    boot_cg_emit_bd_ret_v();
                else
                    g_cg_imm = s1i bit_and 65535;
                    boot_cg_emit_bd_ret_i();
                end
                did_ret = 1;
            end

            if opc == 96 do
                g_cg_off = boot_cg_slot_off(s1v);
                g_cg_rd = di bit_and 0x1F;
                boot_cg_emit_bd_setarg();
            end

            if opc == 34 do
                g_cg_rn = native_read_i64(g_boot_func_tab, s1v * 8);
                if dv >= 0 do
                    g_cg_imm = boot_cg_slot_off(dv);
                else
                    g_cg_imm = 0 - 1;
                end
                boot_cg_emit_bd_call();
            end

            j = j + 1;
        end

        if did_ret == 0 do
            g_cg_imm = 0;
            g_cg_rd = 0;
            boot_cg_movz0();
            boot_cg_epilogue0();
        end
        fi = fi + 1;
        end
    end

    # Fallback stub if main still missing from dump.
    if g_boot_main_off < 0 do
        print_ln("virc: codegen stub main (real main missing from dump)");
        let stub_off = codebuf_len();
        native_write_i64(g_boot_name_cell, 104, g_boot_rt_print);
        native_write_i64(g_boot_name_cell, 112, g_boot_rt_exit);
        g_boot_main_off = stub_off;
        native_write_i64(g_boot_name_cell, 120, stub_off);
        boot_cg_prologue0();
        g_cg_imm = 42;
        g_cg_off = 16;
        boot_cg_emit_bd_load();
        g_cg_off = 16;
        boot_cg_emit_bd_print();
        g_cg_imm = 0;
        boot_cg_emit_bd_ret_i();
        native_write_i64(g_boot_name_cell, 120, stub_off);
        native_write_i64(g_boot_name_cell, 112, g_boot_rt_exit);
    end

    g_snap_entry_off = codebuf_len();
    g_code_start_offset = g_snap_entry_off;
    native_write_i64(g_boot_name_cell, 120, g_boot_main_off);
    native_write_i64(g_boot_name_cell, 112, g_boot_rt_exit);
    boot_cg_emit_entry0();
    out 0;
end.

func boot_codegen_flat_min:
    # Walk g_boot_q_* flat staging and emit ARM64 using only g_emit_word.
    # Const-fold Load/arith into a small table; Print emits movz+bl to rt_print
    # (at code offset 0). Avoid multi-arg helpers — VM clobbers them.
    extern func native_read_i64(addr: int, offset: int) -> int;
    extern func native_write_i64(addr: int, offset: int, val: int);
    g_cg_cb = codebuf_new(TargetArch.ARM64);
    g_runtime_min = 1;
    g_cg_cb = emit_runtime_arm64(g_cg_cb);
    g_runtime_min = 0;
    g_snap_entry_off = codebuf_len();
    g_code_start_offset = g_snap_entry_off;

    if g_boot_vreg_tab == 0 do
        g_boot_vreg_tab = heap_alloc(256);
    end
    let zi = 0;
    when zi < 32 loop
        native_write_i64(g_boot_vreg_tab, zi * 8, 0);
        zi = zi + 1;
    end

    let exit_code = 0;
    let j = 0;
    when j < g_boot_emit_count loop
        let opc = native_read_i64(g_boot_q_opc, j * 8);
        let d_v = native_read_i64(g_boot_q_dst, j * 8);
        let s1f = native_read_i64(g_boot_q_s1f, j * 8);
        let s1v = native_read_i64(g_boot_q_s1v, j * 8);
        let s1i = native_read_i64(g_boot_q_s1i, j * 8);
        let s2f = native_read_i64(g_boot_q_s2f, j * 8);
        let s2v = native_read_i64(g_boot_q_s2v, j * 8);
        let s2i = native_read_i64(g_boot_q_s2i, j * 8);

        if opc == 1 or opc == 2 do
            if d_v >= 0 and d_v < 32 do
                if s1f != 0 do
                    native_write_i64(g_boot_vreg_tab, d_v * 8, s1i + 1);
                else
                    if s1v >= 0 and s1v < 32 do
                        let raw = native_read_i64(g_boot_vreg_tab, s1v * 8);
                        if raw != 0 do
                            native_write_i64(g_boot_vreg_tab, d_v * 8, raw);
                        end
                    end
                end
            end
        end

        if opc == 3 or opc == 4 or opc == 5 or opc == 6 or opc == 7 do
            if d_v >= 0 and d_v < 32 do
                let av = 0 - 1;
                let bv = 0 - 1;
                if s1f != 0 do
                    av = s1i;
                else
                    if s1v >= 0 and s1v < 32 do
                        let ra = native_read_i64(g_boot_vreg_tab, s1v * 8);
                        if ra != 0 do
                            av = ra - 1;
                        end
                    end
                end
                if s2f != 0 do
                    bv = s2i;
                else
                    if s2v >= 0 and s2v < 32 do
                        let rb = native_read_i64(g_boot_vreg_tab, s2v * 8);
                        if rb != 0 do
                            bv = rb - 1;
                        end
                    end
                end
                if av >= 0 and bv >= 0 do
                    let rv = 0 - 1;
                    if opc == 3 do
                        rv = av + bv;
                    end
                    if opc == 4 do
                        rv = av - bv;
                    end
                    if opc == 5 do
                        rv = av * bv;
                    end
                    if opc == 6 do
                        if bv != 0 do
                            rv = av / bv;
                        end
                    end
                    if opc == 7 do
                        if bv != 0 do
                            rv = av - (av / bv) * bv;
                        end
                    end
                    if rv >= 0 do
                        native_write_i64(g_boot_vreg_tab, d_v * 8, rv + 1);
                    end
                end
            end
        end

        if opc == 40 do
            let pv = 0;
            if s1f != 0 do
                pv = s1i;
            else
                if s1v >= 0 and s1v < 32 do
                    let rp = native_read_i64(g_boot_vreg_tab, s1v * 8);
                    if rp != 0 do
                        pv = rp - 1;
                    end
                end
            end
            if pv < 0 do
                pv = 0;
            end
            if pv > 65535 do
                pv = pv bit_and 65535;
            end
            # MOVZ X0, #pv
            g_emit_word = 0xD2800000;
            g_emit_word = g_emit_word | ((pv bit_and 0xFFFF) shl 5);
            boot_cg_emit_word0();
            # BL rt_print at offset 0
            let site = codebuf_len();
            let delta = (0 - site) / 4;
            let imm26 = delta;
            if delta < 0 do
                imm26 = delta + 67108864;
            end
            g_emit_word = 0x94000000;
            g_emit_word = g_emit_word | (imm26 bit_and 0x03FFFFFF);
            boot_cg_emit_word0();
        end

        if opc == 35 do
            if s1f != 0 do
                exit_code = s1i;
            else
                if s1v >= 0 and s1v < 32 do
                    let re = native_read_i64(g_boot_vreg_tab, s1v * 8);
                    if re != 0 do
                        exit_code = re - 1;
                    end
                end
            end
        end
        j = j + 1;
    end

    # exit(exit_code) via SVC
    if exit_code < 0 do
        exit_code = 0;
    end
    if exit_code > 65535 do
        exit_code = exit_code bit_and 65535;
    end
    g_emit_word = 0xD2800000;
    g_emit_word = g_emit_word | ((exit_code bit_and 0xFFFF) shl 5);
    boot_cg_emit_word0();
    # MOVZ X16, #1
    g_emit_word = 0xD2800030;
    boot_cg_emit_word0();
    g_emit_word = 0xD4001001;
    boot_cg_emit_word0();
    out 0;
end.

func boot_codegen_basic42:
    cb = codebuf_new(TargetArch.ARM64);
    g_runtime_min = 1;
    cb = emit_runtime_arm64(cb);
    g_runtime_min = 0;
    g_snap_entry_off = codebuf_offset(cb);
    g_code_start_offset = g_snap_entry_off;
    cb = boot_codegen_emit_main_min(cb);
    out cb;
end.

func boot_test_runtime_emit:
    cb = codebuf_new(TargetArch.ARM64);
    cb = emit_runtime_arm64(cb);
    out cb;
end.

func boot_lower_min_main:
    in(ctx: LowerCtx)
    var (mod1, fidx) = q_module_add_func(ctx.mod_obj, "main");
    ctx.mod_obj = mod1;
    g_mod_funcs_acc = ctx.mod_obj.functions;
    out 0;
end.

func boot_lower_test_main:
    in(ctx: LowerCtx)
    var (mod1, fidx) = q_module_add_func(ctx.mod_obj, "main");
    ctx.mod_obj = mod1;
    ctx.current_func_idx = fidx;
    ctx.next_vreg = 16;
    boot_reset_vregs();
    ctx.symbols = sym_new();
    v42 = fresh_vreg(ctx);
    # (in-place ctx)
    ir_emit(ctx, q_instr(QOp.Load, q_vreg(v42), q_imm(42), q_none()));
    ir_emit(ctx, q_instr(QOp.Print, q_none(), q_vreg(v42), q_none()));
    v99 = fresh_vreg(ctx);
    # (in-place ctx)
    ir_emit(ctx, q_instr(QOp.Load, q_vreg(v99), q_imm(99), q_none()));
    ir_emit(ctx, q_instr(QOp.Print, q_none(), q_vreg(v99), q_none()));
    rz = fresh_vreg(ctx);
    # (in-place ctx)
    ir_emit(ctx, q_instr(QOp.Load, q_vreg(rz), q_imm(0), q_none()));
    ir_emit(ctx, q_instr(QOp.Ret, q_none(), q_vreg(rz), q_none()));
    ctx.current_func_idx = -1;
    g_mod_funcs_acc = ctx.mod_obj.functions;
    out 0;end.

# ── Phased Mach-O link (avoids large-function control-flow bugs) ──

func boot_macho_push_name16:
    in(name: int, name_len: int)
    extern func native_read_u8(addr: int, offset: int) -> int;
    let i = 0;
    when i < 16 loop
        if i < name_len do
            g_mach_buf = bvec_push(g_mach_buf, native_read_u8(name, i));
        else
            g_mach_buf = bvec_push(g_mach_buf, 0);
        end
        i = i + 1;
    end
end.

func boot_macho_write_segment_n:
    in(name: int, name_len: int, vmaddr: int, vmsize: int,
       fileoff: int, filesize: int, maxprot: int, initprot: int, nsects: int)
    g_mach_buf = bvec_push_u32_le(g_mach_buf, LC_SEGMENT_64);
    g_mach_buf = bvec_push_u32_le(g_mach_buf, 72 + 80 * nsects);
    boot_macho_push_name16(name, name_len);
    g_mach_buf = bvec_push_u64_le(g_mach_buf, vmaddr);
    g_mach_buf = bvec_push_u64_le(g_mach_buf, vmsize);
    g_mach_buf = bvec_push_u64_le(g_mach_buf, fileoff);
    g_mach_buf = bvec_push_u64_le(g_mach_buf, filesize);
    g_mach_buf = bvec_push_u32_le(g_mach_buf, maxprot);
    g_mach_buf = bvec_push_u32_le(g_mach_buf, initprot);
    g_mach_buf = bvec_push_u32_le(g_mach_buf, nsects);
    g_mach_buf = bvec_push_u32_le(g_mach_buf, 0);
end.

func boot_macho_write_section_n:
    in(sectname: int, sect_len: int, segname: int, seg_len: int,
       addr: int, size: int, offset: int, align: int, flags: int)
    boot_macho_push_name16(sectname, sect_len);
    boot_macho_push_name16(segname, seg_len);
    g_mach_buf = bvec_push_u64_le(g_mach_buf, addr);
    g_mach_buf = bvec_push_u64_le(g_mach_buf, size);
    g_mach_buf = bvec_push_u32_le(g_mach_buf, offset);
    g_mach_buf = bvec_push_u32_le(g_mach_buf, align);
    g_mach_buf = bvec_push_u32_le(g_mach_buf, 0);
    g_mach_buf = bvec_push_u32_le(g_mach_buf, 0);
    g_mach_buf = bvec_push_u32_le(g_mach_buf, flags);
    g_mach_buf = bvec_push_u32_le(g_mach_buf, 0);
    g_mach_buf = bvec_push_u32_le(g_mach_buf, 0);
    g_mach_buf = bvec_push_u32_le(g_mach_buf, 0);
end.

func boot_macho_gbuf_u32:
    in(off: int, val: int)
    native_write_u8(g_mach_buf, off, val bit_and 0xFF);
    native_write_u8(g_mach_buf, off + 1, (val shr 8) bit_and 0xFF);
    native_write_u8(g_mach_buf, off + 2, (val shr 16) bit_and 0xFF);
    native_write_u8(g_mach_buf, off + 3, (val shr 24) bit_and 0xFF);
end.

func boot_macho_gbuf_u64:
    in(off: int, val: int)
    boot_macho_gbuf_u32(off, val bit_and 0xFFFFFFFF);
    boot_macho_gbuf_u32(off + 4, (val shr 32) bit_and 0xFFFFFFFF);
end.

func boot_macho_gbuf_name16:
    in(off: int, name: int, name_len: int)
    let i = 0;
    when i < 16 loop
        if i < name_len do
            native_write_u8(g_mach_buf, off + i, native_read_u8(name, i));
        else
            native_write_u8(g_mach_buf, off + i, 0);
        end
        i = i + 1;
    end
end.

func boot_macho_gbuf_u64_hi_lo:
    in(off: int, hi: int, lo: int)
    boot_macho_gbuf_u32(off, lo);
    boot_macho_gbuf_u32(off + 4, hi);
end.

