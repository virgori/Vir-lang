enum FileMode:
    Read
    Write
    Append
end.

func char_to_digit:
    in(ch: byte, base: int)
    if ch >= 48 and ch <= 57 do
        val = (ch - 48) as int;
        if val < base do out Ok(val); end
    end
    if ch >= 97 and ch <= 102 do
        val = 10 + (ch - 97) as int;
        if val < base do out Ok(val); end
    end
    if ch >= 65 and ch <= 70 do
        val = 10 + (ch - 65) as int;
        if val < base do out Ok(val); end
    end
    out Err(0);
end.

entity QIRFunc: end.
extern func wasm_write_module();
extern func elf_new();
extern func elf_write_to_file();
extern func file_open();

# virc_flat.vri — Concatenated self-hosting compiler for bootstrap

# ══ BEGIN vir/rt/syscall ══
##
 * vir/rt/syscall.vri — Raw System Call Interface
 * ================================================
 * Direct BSD (macOS) and Linux syscalls.
 * ZERO C library dependency. ZERO libc dependency.
 * This is the absolute foundation — Vir talks to the kernel directly.
 *
 * On macOS ARM64: syscall number in X16, args in X0-X5, SVC #0x80
 * On Linux  ARM64: syscall number in X8,  args in X0-X5, SVC #0
 * On Linux  x86_64: syscall number in RAX, args in RDI,RSI,RDX,R10,R8,R9
 *
 * BSD syscall numbers are offset by 0x2000000 on macOS.
 ##



# ═══════════════════════════════════════════════════════
# Platform Detection
# ═══════════════════════════════════════════════════════

enum Platform:
    MacOS_ARM64    = 0;
    MacOS_x86_64   = 1;
    Linux_ARM64    = 2;
    Linux_x86_64   = 3;
end.

# Compile-time constant — set by the compiler based on target
const HOST_PLATFORM = Platform::MacOS_ARM64;

# ═══════════════════════════════════════════════════════
# macOS BSD Syscall Numbers (ARM64)
# ═══════════════════════════════════════════════════════
# All BSD syscalls are offset by 0x2000000

const SYS_EXIT:         0x2000001;
const SYS_FORK:         0x2000002;
const SYS_READ:         0x2000003;
const SYS_WRITE:        0x2000004;
const SYS_OPEN:         0x2000005;
const SYS_CLOSE:        0x2000006;
const SYS_WAIT4:        0x2000007;
const SYS_UNLINK:       0x200000A;
const SYS_CHDIR:        0x200000C;
const SYS_FCHMOD:       0x200007C;
const SYS_CHMOD:        0x200000F;
const SYS_GETPID:       0x2000014;
const SYS_KILL:         0x2000025;
const SYS_DUP:          0x2000029;
const SYS_PIPE:         0x200002A;
const SYS_GETUID:       0x2000018;
const SYS_GETGID:       0x200002F;
const SYS_STAT64:       0x2000152;
const SYS_LSEEK:        0x20000C7;
const SYS_MMAP:         0x20000C5;
const SYS_MUNMAP:       0x2000049;
const SYS_MPROTECT:     0x200004A;
const SYS_IOCTL:        0x2000036;
const SYS_FCNTL:        0x200005C;
const SYS_FSTAT64:      0x2000153;
const SYS_MKDIR:        0x2000088;
const SYS_RMDIR:        0x2000089;
const SYS_RENAME:       0x2000080;
const SYS_FTRUNCATE:    0x20000C9;
const SYS_EXECVE:       0x200003B;
const SYS_GETCWD:       0x2000128;
const SYS_SOCKET:       0x2000061;
const SYS_CONNECT:      0x2000062;
const SYS_BIND:         0x2000068;
const SYS_LISTEN:       0x200006A;
const SYS_ACCEPT:       0x200001E;
const SYS_SENDTO:       0x2000085;
const SYS_RECVFROM:     0x200001D;
const SYS_KQUEUE:       0x200016A;
const SYS_KEVENT:       0x200016B;
const SYS_CLOCK_GETTIME: 0x20001A0;

# ═══════════════════════════════════════════════════════
# Linux Syscall Numbers (ARM64)
# ═══════════════════════════════════════════════════════

const LINUX_SYS_READ:       63;
const LINUX_SYS_WRITE:      64;
const LINUX_SYS_OPENAT:     56;
const LINUX_SYS_CLOSE:      57;
const LINUX_SYS_FSTAT:      80;
const LINUX_SYS_LSEEK:      62;
const LINUX_SYS_MMAP:       222;
const LINUX_SYS_MUNMAP:     215;
const LINUX_SYS_MPROTECT:   226;
const LINUX_SYS_EXIT:       93;
const LINUX_SYS_EXIT_GROUP: 94;
const LINUX_SYS_FORK:       220;   # actually clone
const LINUX_SYS_EXECVE:     221;
const LINUX_SYS_WAIT4:      260;
const LINUX_SYS_GETPID:     172;
const LINUX_SYS_KILL:       129;
const LINUX_SYS_PIPE2:      59;
const LINUX_SYS_GETCWD:     17;
const LINUX_SYS_MKDIR:      34;
const LINUX_SYS_RMDIR:      84;  # actually unlinkat
const LINUX_SYS_RENAME:     38;  # actually renameat
const LINUX_SYS_FCHMOD:     52;
const LINUX_SYS_SOCKET:     198;
const LINUX_SYS_CONNECT:    203;
const LINUX_SYS_BIND:       200;
const LINUX_SYS_LISTEN:     201;
const LINUX_SYS_ACCEPT:     202;
const LINUX_SYS_SENDTO:     206;
const LINUX_SYS_RECVFROM:   207;
const LINUX_SYS_EPOLL_CREATE1: 20;
const LINUX_SYS_EPOLL_CTL:    21;
const LINUX_SYS_EPOLL_WAIT:   22;

# ═══════════════════════════════════════════════════════
# File Open Flags
# ═══════════════════════════════════════════════════════

const O_RDONLY:    0x0000;
const O_WRONLY:    0x0001;
const O_RDWR:      0x0002;
const O_CREAT:     0x0200;    # macOS
const O_TRUNC:     0x0400;
const O_APPEND:    0x0008;    # macOS
const O_EXCL:      0x0800;

const LINUX_O_CREAT:  0x0040;
const LINUX_O_TRUNC:  0x0200;
const LINUX_O_APPEND: 0x0400;

# ═══════════════════════════════════════════════════════
# Memory Protection Flags
# ═══════════════════════════════════════════════════════

const PROT_NONE:   0x0;
const PROT_READ:   0x1;
const PROT_WRITE:  0x2;
const PROT_EXEC:   0x4;

const MAP_PRIVATE:   0x02;
const MAP_ANONYMOUS: 0x1000;    # macOS MAP_ANON
const MAP_FIXED:     0x10;

const LINUX_MAP_ANONYMOUS: 0x20;

# ═══════════════════════════════════════════════════════
# Standard File Descriptors
# ═══════════════════════════════════════════════════════

const STDIN_FD:  0;
const STDOUT_FD: 1;
const STDERR_FD: 2;

# ═══════════════════════════════════════════════════════
# Low-Level Syscall Wrappers
# ═══════════════════════════════════════════════════════
# These are implemented as inline assembly by the compiler.
# The compiler recognizes `extern func syscall*` and emits
# the appropriate SVC/SYSCALL instruction sequence.

extern func syscall0(num: int) -> int;
extern func syscall1(num: int, a0: int) -> int;
extern func syscall2(num: int, a0: int, a1: int) -> int;
extern func syscall3(num: int, a0: int, a1: int, a2: int) -> int;
extern func syscall4(num: int, a0: int, a1: int, a2: int, a3: int) -> int;
extern func syscall5(num: int, a0: int, a1: int, a2: int, a3: int, a4: int) -> int;
extern func syscall6(num: int, a0: int, a1: int, a2: int, a3: int, a4: int, a5: int) -> int;

# ═══════════════════════════════════════════════════════
# Process Control
# ═══════════════════════════════════════════════════════

func sys_exit:
    in(code: int)
    syscall1(SYS_EXIT, code);
end.

func sys_getpid:
    out syscall0(SYS_GETPID);
end.

func sys_fork:
    out syscall0(SYS_FORK);
end.

func sys_kill:
    in(pid: int, sig: int)
    out syscall2(SYS_KILL, pid, sig);
end.

func sys_wait4:
    in(pid: int, status_ptr: int, options: int)
    out syscall4(SYS_WAIT4, pid, status_ptr, options, 0);
end.

func sys_execve:
    in(path: int, argv: int, envp: int)
    out syscall3(SYS_EXECVE, path, argv, envp);
end.

# ═══════════════════════════════════════════════════════
# File I/O — The building blocks
# ═══════════════════════════════════════════════════════

func sys_read:
    in(fd: int, buf: int, count: int)
    out syscall3(SYS_READ, fd, buf, count);
end.

func sys_write:
    in(fd: int, buf: int, count: int)
    out syscall3(SYS_WRITE, fd, buf, count);
end.

func sys_open:
    in(path: int, flags: int, mode: int)
    out syscall3(SYS_OPEN, path, flags, mode);
end.

func sys_close:
    in(fd: int)
    out syscall1(SYS_CLOSE, fd);
end.

func sys_lseek:
    in(fd: int, offset: int, whence: int)
    out syscall3(SYS_LSEEK, fd, offset, whence);
end.

func sys_fstat:
    in(fd: int, buf: int)
    out syscall2(SYS_FSTAT64, fd, buf);
end.

func sys_ftruncate:
    in(fd: int, length: int)
    out syscall2(SYS_FTRUNCATE, fd, length);
end.

func sys_unlink:
    in(path: int)
    out syscall1(SYS_UNLINK, path);
end.

func sys_rename:
    in(old_path: int, new_path: int)
    out syscall2(SYS_RENAME, old_path, new_path);
end.

func sys_mkdir:
    in(path: int, mode: int)
    out syscall2(SYS_MKDIR, path, mode);
end.

func sys_rmdir:
    in(path: int)
    out syscall1(SYS_RMDIR, path);
end.

func sys_getcwd:
    in(buf: int, size: int)
    out syscall2(SYS_GETCWD, buf, size);
end.

func sys_chmod:
    in(path: int, mode: int)
    out syscall2(SYS_CHMOD, path, mode);
end.

# ═══════════════════════════════════════════════════════
# Memory Management — mmap/munmap (replaces malloc/free)
# ═══════════════════════════════════════════════════════

func sys_mmap:
    in(addr: int, length: int, prot: int, flags: int, fd: int, offset: int)
    out syscall6(SYS_MMAP, addr, length, prot, flags, fd, offset);
end.

func sys_munmap:
    in(addr: int, length: int)
    out syscall2(SYS_MUNMAP, addr, length);
end.

func sys_mprotect:
    in(addr: int, length: int, prot: int)
    out syscall3(SYS_MPROTECT, addr, length, prot);
end.

# ═══════════════════════════════════════════════════════
# Pipe bit_and Dup
# ═══════════════════════════════════════════════════════

func sys_pipe:
    in(fds: int)   # pointer to two-int array
    out syscall1(SYS_PIPE, fds);
end.

func sys_dup:
    in(fd: int)
    out syscall1(SYS_DUP, fd);
end.

# ═══════════════════════════════════════════════════════
# Socket Operations
# ═══════════════════════════════════════════════════════

func sys_socket:
    in(domain: int, sock_type: int, protocol: int)
    out syscall3(SYS_SOCKET, domain, sock_type, protocol);
end.

func sys_connect:
    in(fd: int, addr: int, addr_len: int)
    out syscall3(SYS_CONNECT, fd, addr, addr_len);
end.

func sys_bind:
    in(fd: int, addr: int, addr_len: int)
    out syscall3(SYS_BIND, fd, addr, addr_len);
end.

func sys_listen:
    in(fd: int, backlog: int)
    out syscall2(SYS_LISTEN, fd, backlog);
end.

func sys_accept:
    in(fd: int, addr: int, addr_len: int)
    out syscall3(SYS_ACCEPT, fd, addr, addr_len);
end.

func sys_sendto:
    in(fd: int, buf: int, len: int, flags: int, addr: int, addr_len: int)
    out syscall6(SYS_SENDTO, fd, buf, len, flags, addr, addr_len);
end.

func sys_recvfrom:
    in(fd: int, buf: int, len: int, flags: int, addr: int, addr_len_ptr: int)
    out syscall6(SYS_RECVFROM, fd, buf, len, flags, addr, addr_len_ptr);
end.

# ═══════════════════════════════════════════════════════
# Event Queue (kqueue / epoll)
# ═══════════════════════════════════════════════════════

func sys_kqueue:
    out syscall0(SYS_KQUEUE);
end.

func sys_kevent:
    in(kq: int, changelist: int, nchanges: int, eventlist: int, nevents: int, timeout: int)
    out syscall6(SYS_KEVENT, kq, changelist, nchanges, eventlist, nevents, timeout);
end.

# ═══════════════════════════════════════════════════════
# Time
# ═══════════════════════════════════════════════════════

func sys_clock_gettime:
    in(clock_id: int, tp: int)
    out syscall2(SYS_CLOCK_GETTIME, clock_id, tp);
end.

# ═══════════════════════════════════════════════════════
# Convenience: Write to stdout / stderr
# ═══════════════════════════════════════════════════════

func write_stdout:
    in(data: int, len: int)
    sys_write(STDOUT_FD, data, len);
end.

func write_stderr:
    in(data: int, len: int)
    sys_write(STDERR_FD, data, len);
end.

# ═══════════════════════════════════════════════════════
# Convenience: Read entire file into memory
# ═══════════════════════════════════════════════════════

func read_file_raw:
    in(path: int)
    # Open
    let fd = sys_open(path, O_RDONLY, 0);
    if fd < 0 do
        out 0;   # error
    end

    # Get file size via lseek
    let end_pos = sys_lseek(fd, 0, 2);    # SEEK_END = 2
    sys_lseek(fd, 0, 0);                   # SEEK_SET = 0

    # Allocate buffer via mmap
    let buf = sys_mmap(0, end_pos + 1,
                       PROT_READ | PROT_WRITE,
                       MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
    if buf < 0 do
        sys_close(fd);
        out 0;
    end

    # Read
    let total = 0;
    when total < end_pos loop
        let n = sys_read(fd, buf + total, end_pos - total);
        if n <= 0 do
            break;
        end
        total = total + n;
    end

    # Null-terminate
    extern func native_write_byte(addr: int, offset: int, val: int);
    native_write_byte(buf, end_pos, 0);

    sys_close(fd);
    out buf;   # returns pointer to mmap'd buffer
end.

# ═══════════════════════════════════════════════════════
# Convenience: Write buffer to file
# ═══════════════════════════════════════════════════════

func write_file_raw:
    in(path: int, data: int, len: int, mode: int)
    let fd = sys_open(path, O_WRONLY | O_CREAT | O_TRUNC, mode);
    if fd < 0 do
        out -1;
    end

    let written = 0;
    when written < len loop
        let n = sys_write(fd, data + written, len - written);
        if n <= 0 do
            out skip;
        end
        written = written + n;
    end

    sys_close(fd);
    out 0;
end.
# ══ END vir/rt/syscall ══

# ══ BEGIN vir/rt/alloc ══
##
 * vir/rt/alloc.vri — Memory Allocator (Pure Vir, No libc)
 * ========================================================
 * Bump allocator + free-list allocator built on raw mmap syscalls.
 * Zero C library. Zero malloc. Zero free. Pure kernel syscalls.
 *
 * Strategy:
 *   - Arena (bump) allocator for fast sequential allocation
 *   - Free-list allocator for general-purpose alloc/dealloc
 *   - Page allocator (mmap/munmap) as the backing layer
 *
 * Memory block layout:
 *   [size:i64] [flags:i64] [user data...]
 *   ^-- block_ptr         ^-- returned to user (block_ptr + 16)
 ##



# ═══════════════════════════════════════════════════════
# Constants
# ═══════════════════════════════════════════════════════

const PAGE_SIZE:        16384;        # 16KB (macOS ARM64)
const MIN_ARENA_SIZE:   1048576;      # 1MB
const BLOCK_HEADER:     16;           # 8 bytes size + 8 bytes flags
const BLOCK_FREE:       0x0;
const BLOCK_USED:       0x1;
const ALIGNMENT:        16;           # 16-byte alignment for ARM64

# ═══════════════════════════════════════════════════════
# Low-Level Page Allocation (mmap/munmap)
# ═══════════════════════════════════════════════════════

func page_alloc:
    in(size: int)
    # Round up to page boundary
    let pages = (size + PAGE_SIZE - 1) / PAGE_SIZE;
    let actual = pages * PAGE_SIZE;

    let ptr = sys_mmap(0, actual,
                       PROT_READ | PROT_WRITE,
                       MAP_PRIVATE | MAP_ANONYMOUS,
                       -1, 0);
    if ptr < 0 do
        out 0;   # allocation failed
    end
    out ptr;
end.

func page_free:
    in(ptr: int, size: int)
    let pages = (size + PAGE_SIZE - 1) / PAGE_SIZE;
    let actual = pages * PAGE_SIZE;
    sys_munmap(ptr, actual);
end.

# ═══════════════════════════════════════════════════════
# Arena Allocator — Fast Bump Allocation
# ═══════════════════════════════════════════════════════
# Allocates by bumping a pointer forward.
# Entire arena freed at once (no individual free).
# Perfect for compiler phases (lex, parse, IR).

entity Arena:
    base:       int;      # mmap'd base address
    capacity:   int;      # total bytes
    offset:     int;      # current bump position
end.

func arena_new:
    in(size: int)
    let actual = size;
    if actual < MIN_ARENA_SIZE do
        actual = MIN_ARENA_SIZE;
    end
    let base = page_alloc(actual);
    if base == 0 do
        out Arena ( base: 0, capacity: 0, offset: 0 );
    end
    out Arena ( base: base, capacity: actual, offset: 0 );
end.

func arena_alloc:
    in(arena: Arena, size: int)
    # Align to ALIGNMENT boundary
    let aligned = (size + ALIGNMENT - 1) bit_and ~(ALIGNMENT - 1);

    if arena.offset + aligned > arena.capacity do
        out 0;   # out of space
    end

    let ptr = arena.base + arena.offset;
    arena.offset = arena.offset + aligned;
    out ptr;
end.

func arena_reset:
    in(arena: Arena)
    arena.offset = 0;
    out arena;
end.

func arena_destroy:
    in(arena: Arena)
    if arena.base != 0 do
        page_free(arena.base, arena.capacity);
    end
end.

# ═══════════════════════════════════════════════════════
# Free-List Allocator — General Purpose
# ═══════════════════════════════════════════════════════
# Each block: [size:i64][flags:i64][user data...]
# Free list is a singly-linked list through free blocks.
# Coalescing on free to reduce fragmentation.

entity FreeNode:
    size:       int;      # total block size (including header)
    next_ptr:   int;      # pointer to next FreeNode, or 0
end.

# Heap state — flat scalars (entity field/global assign breaks in self-hosted VM).
var g_heap_base = 0;
var g_heap_capacity = 0;
var g_heap_free_head = 0;
var g_heap_used = 0;

# Compiler bump arena — fast phase-local alloc (lex/parse/lower).
var g_comp_arena_base = 0;
var g_comp_arena_cap = 0;
var g_comp_arena_off = 0;

func comp_arena_begin:
    if g_comp_arena_base != 0 do
        g_comp_arena_off = 0;
        out;
    end
    let sz = MIN_ARENA_SIZE * 8;
    let base = page_alloc(sz);
    if base == 0 do
        out;
    end
    g_comp_arena_base = base;
    g_comp_arena_cap = sz;
    g_comp_arena_off = 0;
end.

func comp_arena_alloc:
    in(size: int)
    if g_comp_arena_base == 0 do
        out 0;
    end
    let aligned = (size + ALIGNMENT - 1) bit_and ~(ALIGNMENT - 1);
    if g_comp_arena_off + aligned > g_comp_arena_cap do
        out 0;
    end
    let ptr = g_comp_arena_base + g_comp_arena_off;
    g_comp_arena_off = g_comp_arena_off + aligned;
    out ptr;
end.

func heap_init:
    in(size: int)
    let actual = size;
    if actual < MIN_ARENA_SIZE do
        actual = MIN_ARENA_SIZE;
    end
    let base = page_alloc(actual);
    if base == 0 do
        out false;
    end

    # Initialize entire region as one big free block
    extern func native_write_i64(addr: int, offset: int, val: int);
    native_write_i64(base, 0, actual);       # size
    native_write_i64(base, 8, 0);            # next = null

    g_heap_base = base;
    g_heap_capacity = actual;
    g_heap_free_head = base;
    g_heap_used = 0;
    out true;
end.

func heap_alloc:
    in(size: int)
    let needed = size + BLOCK_HEADER;
    # Align
    needed = (needed + ALIGNMENT - 1) bit_and ~(ALIGNMENT - 1);

    extern func native_read_i64(addr: int, offset: int) -> int;
    extern func native_write_i64(addr: int, offset: int, val: int);

    # First-fit search through free list
    let prev_ptr = 0;
    let cur = g_heap_free_head;

    when cur != 0 loop
        let block_size = native_read_i64(cur, 0);
        let next = native_read_i64(cur, 8);

        if block_size >= needed do
            # Found a fit! Split if remainder is big enough
            let remainder = block_size - needed;

            if remainder >= (BLOCK_HEADER + ALIGNMENT) do
                # Split: shrink this block, create new free block after
                native_write_i64(cur, 0, needed);    # resize current
                let new_free = cur + needed;
                native_write_i64(new_free, 0, remainder);   # size
                native_write_i64(new_free, 8, next);         # next

                # Patch prev or head to point to new_free
                if prev_ptr == 0 do
                    g_heap_free_head = new_free;
                else
                    native_write_i64(prev_ptr, 8, new_free);
                end
            else
                # Use whole block
                needed = block_size;
                if prev_ptr == 0 do
                    g_heap_free_head = next;
                else
                    native_write_i64(prev_ptr, 8, next);
                end
            end

            # Mark as used
            native_write_i64(cur, 0, needed);
            native_write_i64(cur, 8, BLOCK_USED);
            g_heap_used = g_heap_used + needed;

            out cur + BLOCK_HEADER;   # return user pointer
        end

        prev_ptr = cur;
        cur = next;
    end

    # No fit found — grow heap
    let grow = needed;
    if grow < MIN_ARENA_SIZE do
        grow = MIN_ARENA_SIZE;
    end
    let new_region = page_alloc(grow);
    if new_region == 0 do
        out 0;   # OOM
    end

    # Set up new region as allocated block + remainder as free
    native_write_i64(new_region, 0, needed);
    native_write_i64(new_region, 8, BLOCK_USED);

    let remainder = grow - needed;
    if remainder >= (BLOCK_HEADER + ALIGNMENT) do
        let new_free = new_region + needed;
        native_write_i64(new_free, 0, remainder);
        native_write_i64(new_free, 8, g_heap_free_head);
        g_heap_free_head = new_free;
    end

    g_heap_used = g_heap_used + needed;
    g_heap_capacity = g_heap_capacity + grow;
    out new_region + BLOCK_HEADER;
end.

func heap_free:
    in(ptr: int)
    if ptr == 0 do
        out;
    end

    extern func native_read_i64(addr: int, offset: int) -> int;
    extern func native_write_i64(addr: int, offset: int, val: int);

    let block = ptr - BLOCK_HEADER;
    let block_size = native_read_i64(block, 0);

    # Mark as free, add to free list head
    native_write_i64(block, 0, block_size);
    native_write_i64(block, 8, g_heap_free_head);
    g_heap_free_head = block;
    g_heap_used = g_heap_used - block_size;
end.

func heap_realloc:
    in(ptr: int, new_size: int)
    if ptr == 0 do
        out heap_alloc(new_size);
    end

    extern func native_read_i64(addr: int, offset: int) -> int;
    

    let block = ptr - BLOCK_HEADER;
    let old_size = native_read_i64(block, 0) - BLOCK_HEADER;

    if new_size <= old_size do
        out ptr;   # shrink = no-op for now
    end

    # Allocate new, copy, free old
    let new_ptr = heap_alloc(new_size);
    if new_ptr == 0 do
        out 0;
    end

    let copy_len = old_size;
    if new_size < copy_len do
        copy_len = new_size;
    end
    native_mem_copy(new_ptr, ptr, copy_len);
    heap_free(ptr);
    out new_ptr;
end.

# ═══════════════════════════════════════════════════════
# Global Allocator API (drop-in replacement for malloc)
# ═══════════════════════════════════════════════════════

var g_initialized = false;

func vir_alloc:
    in(size: int)
    if g_initialized == false do
        heap_init(MIN_ARENA_SIZE * 4);   # 4MB initial heap
        g_initialized = true;
    end
    out heap_alloc(size);
end.

func vir_free:
    in(ptr: int)
    if ptr == 0 do
        out;
    end
    # Bump-arena pointers must not enter heap_free (no block header).
    if g_comp_arena_base != 0 do
        if ptr >= g_comp_arena_base and ptr < g_comp_arena_base + g_comp_arena_cap do
            out;
        end
    end
    heap_free(ptr);
end.

func vir_realloc:
    in(ptr: int, new_size: int)
    if ptr != 0 and g_comp_arena_base != 0 do
        if ptr >= g_comp_arena_base and ptr < g_comp_arena_base + g_comp_arena_cap do
            let np = heap_alloc(new_size);
            if np == 0 do
                out 0;
            end
            native_mem_copy(np, ptr, new_size);
            out np;
        end
    end
    if g_initialized == false do
        heap_init(MIN_ARENA_SIZE * 4);
        g_initialized = true;
    end
    out heap_realloc(ptr, new_size);
end.
# ══ END vir/rt/alloc ══

# ══ BEGIN vir/rt/string_rt ══
##
 * vir/rt/string_rt.vri — String Runtime (Pure Vir, No libc)
 * ==========================================================
 * UTF-8 string operations built on vir_alloc/vir_free.
 * Replaces C strlen, strcpy, strcmp, strcat, snprintf, etc.
 *
 * String representation:
 *   Pointer to null-terminated UTF-8 byte array.
 *   Length computed on demand via byte scan.
 *   For builder patterns, StringBuilder tracks length explicitly.
 ##



# ═══════════════════════════════════════════════════════
# Low-level byte access (compiler intrinsics)
# ═══════════════════════════════════════════════════════

extern func native_read_u8(addr: int, offset: int) -> int;
extern func native_write_u8(addr: int, offset: int, val: int);
func native_mem_copy:
    in(dst: int, src: int, len: int)
    let i = 0;
    when i < len loop
        native_write_u8(dst, i, native_read_u8(src, i));
        i = i + 1;
    end
end.

func native_mem_set:
    in(dst: int, val: int, len: int)
    let i = 0;
    when i < len loop
        native_write_u8(dst, i, val);
        i = i + 1;
    end
end.
# ═══════════════════════════════════════════════════════
# String Length (replaces strlen)
# ═══════════════════════════════════════════════════════

func rt_strlen:
    in(s: int)
    if s == 0 do
        out 0;
    end
    let i = 0;
    when native_read_u8(s, i) != 0 loop
        i = i + 1;
    end
    out i;
end.

# ═══════════════════════════════════════════════════════
# String Copy (replaces strcpy)
# ═══════════════════════════════════════════════════════

func rt_strcpy:
    in(dst: int, src: int)
    let i = 0;
    let ch = native_read_u8(src, i);
    when ch != 0 loop
        native_write_u8(dst, i, ch);
        i = i + 1;
        ch = native_read_u8(src, i);
    end
    native_write_u8(dst, i, 0);    # null terminator
    out dst;
end.

# ═══════════════════════════════════════════════════════
# String Compare (replaces strcmp)
# ═══════════════════════════════════════════════════════

func rt_strcmp:
    in(a: int, b: int)
    let i = 0;
    when true loop
        let ca = native_read_u8(a, i);
        let cb = native_read_u8(b, i);
        if ca != cb do
            out ca - cb;
        end
        if ca == 0 do
            out 0;    # equal
        end
        i = i + 1;
    end
    out 0;
end.

func rt_streq:
    in(a: int, b: int)
    out rt_strcmp(a, b) == 0;
end.

# ═══════════════════════════════════════════════════════
# String Concatenation (replaces strcat pattern)
# ═══════════════════════════════════════════════════════

func rt_strcat:
    in(a: int, b: int)
    let la = rt_strlen(a);
    let lb = rt_strlen(b);
    let result = vir_alloc(la + lb + 1);
    native_mem_copy(result, a, la);
    native_mem_copy(result + la, b, lb);
    native_write_u8(result, la + lb, 0);
    out result;
end.

# ═══════════════════════════════════════════════════════
# String Duplicate
# ═══════════════════════════════════════════════════════

func rt_strdup:
    in(s: int)
    let len = rt_strlen(s);
    let result = vir_alloc(len + 1);
    native_mem_copy(result, s, len + 1);   # includes null terminator
    out result;
end.

# ═══════════════════════════════════════════════════════
# String Substring
# ═══════════════════════════════════════════════════════

func rt_substr:
    in(s: int, start: int, len: int)
    let slen = rt_strlen(s);
    if start >= slen do
        let empty = vir_alloc(1);
        native_write_u8(empty, 0, 0);
        out empty;
    end
    let actual = len;
    if start + actual > slen do
        actual = slen - start;
    end
    let result = vir_alloc(actual + 1);
    native_mem_copy(result, s + start, actual);
    native_write_u8(result, actual, 0);
    out result;
end.

# ═══════════════════════════════════════════════════════
# String Contains
# ═══════════════════════════════════════════════════════

func rt_strcontains:
    in(haystack: int, needle: int)
    let hlen = rt_strlen(haystack);
    let nlen = rt_strlen(needle);
    if nlen == 0 do
        out true;
    end
    if nlen > hlen do
        out false;
    end
    let i = 0;
    when i <= hlen - nlen loop
        let j = 0;
        let match = true;
        when j < nlen loop
            if native_read_u8(haystack, i + j) != native_read_u8(needle, j) do
                match = false;
                out skip;
            end
            j = j + 1;
        end
        if match do
            out true;
        end
        i = i + 1;
    end
    out false;
end.

# ═══════════════════════════════════════════════════════
# String from Literal
# ═══════════════════════════════════════════════════════

func rt_str_from_cstr:
    in(cstr: int)
    out rt_strdup(cstr);
end.

# ═══════════════════════════════════════════════════════
# Integer to String (replaces snprintf %d)
# ═══════════════════════════════════════════════════════

func rt_itoa:
    in(n: int)
    let buf = vir_alloc(24);    # max i64 digits + sign + null
    let pos = 0;
    let val = n;

    if val < 0 do
        native_write_u8(buf, 0, 45);   # '-'
        pos = 1;
        val = 0 - val;
    end

    if val == 0 do
        native_write_u8(buf, pos, 48);   # '0'
        pos = pos + 1;
        native_write_u8(buf, pos, 0);
        out buf;
    end

    # Write digits in reverse to temp buffer
    let tmp = vir_alloc(24);
    let tlen = 0;
    when val > 0 loop
        let digit = val % 10;
        native_write_u8(tmp, tlen, 48 + digit);
        tlen = tlen + 1;
        val = val / 10;
    end

    # Reverse into output
    let i = tlen - 1;
    when i >= 0 loop
        native_write_u8(buf, pos, native_read_u8(tmp, i));
        pos = pos + 1;
        i = i - 1;
    end
    native_write_u8(buf, pos, 0);
    vir_free(tmp);
    out buf;
end.

# ═══════════════════════════════════════════════════════
# String to Integer (replaces atoi/strtol)
# ═══════════════════════════════════════════════════════

func rt_atoi:
    in(s: int)
    let i = 0;
    let sign = 1;
    let result = 0;

    # Skip whitespace
    when native_read_u8(s, i) == 32 or native_read_u8(s, i) == 9 loop
        i = i + 1;
    end

    # Sign
    if native_read_u8(s, i) == 45 do # '-'
        sign = -1;
        i = i + 1;
    eif native_read_u8(s, i) == 43 do # '+'
        i = i + 1;
    end

    # Digits
    let ch = native_read_u8(s, i);
    when ch >= 48 and ch <= 57 loop
        result = result * 10 + (ch - 48);
        i = i + 1;
        ch = native_read_u8(s, i);
    end

    out result * sign;
end.

# ═══════════════════════════════════════════════════════
# Hex Integer to String
# ═══════════════════════════════════════════════════════

func rt_itoa_hex:
    in(n: int, width: int)
    let hex_chars = "0123456789abcdef";
    let buf = vir_alloc(width + 3);
    native_write_u8(buf, 0, 48);    # '0'
    native_write_u8(buf, 1, 120);   # 'x'
    let pos = 2;
    let i = width - 1;
    when i >= 0 loop
        let nibble = (n shr (i * 4)) bit_and 0xF;
        native_write_u8(buf, pos, native_read_u8(hex_chars, nibble));
        pos = pos + 1;
        i = i - 1;
    end
    native_write_u8(buf, pos, 0);
    out buf;
end.

# ═══════════════════════════════════════════════════════
# StringBuilder — Efficient String Building
# ═══════════════════════════════════════════════════════

entity StringBuilder:
    buf:     int;     # allocated buffer
    len:     int;     # current length
    cap:     int;     # capacity
end.

func sb_new:
    let cap = 256;
    let buf = vir_alloc(cap);
    out StringBuilder ( buf: buf, len: 0, cap: cap );
end.

func sb_grow:
    in(sb: StringBuilder, needed: int)
    if sb.len + needed <= sb.cap do
        out sb;
    end
    let new_cap = sb.cap * 2;
    when new_cap < sb.len + needed loop
        new_cap = new_cap * 2;
    end
    sb.buf = vir_realloc(sb.buf, new_cap);
    sb.cap = new_cap;
    out sb;
end.

func sb_append:
    in(sb: StringBuilder, s: int)
    let slen = rt_strlen(s);
    sb = sb_grow(sb, slen);
    native_mem_copy(sb.buf + sb.len, s, slen);
    sb.len = sb.len + slen;
    out sb;
end.

func sb_append_char:
    in(sb: StringBuilder, ch: int)
    sb = sb_grow(sb, 1);
    native_write_u8(sb.buf, sb.len, ch);
    sb.len = sb.len + 1;
    out sb;
end.

func sb_append_int:
    in(sb: StringBuilder, n: int)
    let s = rt_itoa(n);
    sb = sb_append(sb, s);
    vir_free(s);
    out sb;
end.

func sb_to_string:
    in(sb: StringBuilder)
    native_write_u8(sb.buf, sb.len, 0);
    out sb.buf;
end.

func sb_len:
    in(sb: StringBuilder)
    out sb.len;
end.

func sb_clear:
    in(sb: StringBuilder)
    sb.len = 0;
    out sb;
end.

func sb_free:
    in(sb: StringBuilder)
    vir_free(sb.buf);
end.
# ══ END vir/rt/string_rt ══

# ══ BEGIN vir/rt/io ══
##
 * vir/rt/io.vri — I/O Runtime (Pure Vir, No libc)
 * ==================================================
 * File and console I/O built on raw syscalls.
 * Replaces C stdio (printf, fopen, fread, fwrite, fclose).
 *
 * Buffered I/O for performance.
 * UTF-8 native throughout.
 ##



# ═══════════════════════════════════════════════════════
# Console Write — replaces printf/fputs
# ═══════════════════════════════════════════════════════

func print_str:
    in(s: int)
    let len = rt_strlen(s);
    sys_write(STDOUT_FD, s, len);
end.

func print_int:
    in(n: int)
    let s = rt_itoa(n);
    print_str(s);
    vir_free(s);
end.

func print_ln:
    in(s: int)
    print_str(s);
    print_str("\n");
end.

func print_newline:
    let nl = "\n";
    sys_write(STDOUT_FD, nl, 1);
end.

func eprint_str:
    in(s: int)
    let len = rt_strlen(s);
    sys_write(STDERR_FD, s, len);
end.

func eprint_ln:
    in(s: int)
    eprint_str(s);
    let nl = "\n";
    sys_write(STDERR_FD, nl, 1);
end.

# ═══════════════════════════════════════════════════════
# Console Read — replaces scanf/fgets
# ═══════════════════════════════════════════════════════

func read_line:
    let buf = vir_alloc(4096);
    let pos = 0;
    let byte_buf = vir_alloc(1);

    when true loop
        let n = sys_read(STDIN_FD, byte_buf, 1);
        if n <= 0 do
            out skip;
        end

        extern func native_read_u8(addr: int, offset: int) -> int;
        extern func native_write_u8(addr: int, offset: int, val: int);

        let ch = native_read_u8(byte_buf, 0);
        if ch == 10 do # '\n'
            out skip;
        end
        native_write_u8(buf, pos, ch);
        pos = pos + 1;

        if pos >= 4095 do
            out skip;
        end
    end

    extern func native_write_u8(addr: int, offset: int, val: int);
    native_write_u8(buf, pos, 0);
    vir_free(byte_buf);
    out buf;
end.

# ═══════════════════════════════════════════════════════
# File Handle
# ═══════════════════════════════════════════════════════

entity VirFile:
    fd:       int;
    is_open:  bool;
    mode:     int;     # O_RDONLY / O_WRONLY / O_RDWR
end.

const FILE_NONE = VirFile ( fd: -1, is_open: false, mode: 0 );

# ═══════════════════════════════════════════════════════
# File Open / Close
# ═══════════════════════════════════════════════════════

func file_open_read:
    in(path: int)
    let fd = sys_open(path, O_RDONLY, 0);
    if fd < 0 do
        out FILE_NONE;
    end
    out VirFile ( fd: fd, is_open: true, mode: O_RDONLY );
end.

func file_open_write:
    in(path: int, mode: int)
    let fd = sys_open(path, O_WRONLY | O_CREAT | O_TRUNC, mode);
    if fd < 0 do
        out FILE_NONE;
    end
    out VirFile ( fd: fd, is_open: true, mode: O_WRONLY );
end.

func file_open_append:
    in(path: int, mode: int)
    let fd = sys_open(path, O_WRONLY | O_CREAT | O_APPEND, mode);
    if fd < 0 do
        out FILE_NONE;
    end
    out VirFile ( fd: fd, is_open: true, mode: O_WRONLY );
end.

func file_close:
    in(f: VirFile)
    if f.is_open do
        sys_close(f.fd);
    end
end.

# ═══════════════════════════════════════════════════════
# File Read
# ═══════════════════════════════════════════════════════

func file_read_all:
    in(f: VirFile)
    if f.is_open == false do
        out 0;
    end

    # Get file size
    let end_pos = sys_lseek(f.fd, 0, 2);    # SEEK_END
    sys_lseek(f.fd, 0, 0);                   # SEEK_SET

    if end_pos <= 0 do
        let empty = vir_alloc(1);
        extern func native_write_u8(addr: int, offset: int, val: int);
        native_write_u8(empty, 0, 0);
        out empty;
    end

    let buf = vir_alloc(end_pos + 1);
    let total = 0;
    when total < end_pos loop
        let n = sys_read(f.fd, buf + total, end_pos - total);
        if n <= 0 do
            break;
        end
        total = total + n;
    end

    extern func native_write_u8(addr: int, offset: int, val: int);
    native_write_u8(buf, total, 0);    # null-terminate
    out buf;
end.

func file_read_bytes:
    in(f: VirFile, buf: int, count: int)
    if f.is_open == false do
        out -1;
    end
    out sys_read(f.fd, buf, count);
end.

# ═══════════════════════════════════════════════════════
# File Write
# ═══════════════════════════════════════════════════════

func file_write_str:
    in(f: VirFile, s: int)
    if f.is_open == false do
        out -1;
    end
    let len = rt_strlen(s);
    out sys_write(f.fd, s, len);
end.

func file_write_bytes:
    in(f: VirFile, data: int, len: int)
    if f.is_open == false do
        out -1;
    end
    let written = 0;
    when written < len loop
        let n = sys_write(f.fd, data + written, len - written);
        if n <= 0 do
            break;
        end
        written = written + n;
    end
    out written;
end.

# ═══════════════════════════════════════════════════════
# File Size
# ═══════════════════════════════════════════════════════

func file_size:
    in(f: VirFile)
    let cur = sys_lseek(f.fd, 0, 1);      # SEEK_CUR
    let end_pos = sys_lseek(f.fd, 0, 2);  # SEEK_END
    sys_lseek(f.fd, cur, 0);              # restore position
    out end_pos;
end.

# ═══════════════════════════════════════════════════════
# Convenience: Read file by path
# ═══════════════════════════════════════════════════════

func read_file_str:
    in(path: int)
    let fd = sys_open(path, O_RDONLY, 0);
    if fd < 0 do
        out 0;
    end
    let end_pos = sys_lseek(fd, 0, 2);
    sys_lseek(fd, 0, 0);
    if end_pos <= 0 do
        sys_close(fd);
        out 0;
    end
    let buf = sys_mmap(0, end_pos + 1,
        PROT_READ | PROT_WRITE,
        MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
    if buf < 0 do
        sys_close(fd);
        out 0;
    end
    let n = sys_read(fd, buf, end_pos);
    sys_close(fd);
    if n <= 0 do
        out 0;
    end
    native_write_u8(buf, n, 0);
    g_source_len = n;
    out buf;
end.

# ═══════════════════════════════════════════════════════
# Convenience: Write string to file by path
# ═══════════════════════════════════════════════════════

func write_file_str:
    in(path: int, content: int)
    let f = file_open_write(path, 0o644);
    if f.is_open == false do
        out false;
    end
    file_write_str(f, content);
    file_close(f);
    out true;
end.

# ═══════════════════════════════════════════════════════
# Convenience: Write bytes to file by path
# ═══════════════════════════════════════════════════════

func write_file_bytes:
    in(path: int, data: int, len: int, mode: int)
    let f = file_open_write(path, mode);
    if f.is_open == false do
        out false;
    end
    file_write_bytes(f, data, len);
    sys_close(f.fd);
    out true;
end.
# ══ END vir/rt/io ══

# ══ BEGIN vir/rt/vec_rt ══
##
 * vir/rt/vec_rt.vri — Dynamic Array Runtime (Pure Vir)
 * =====================================================
 * Growable vector (dynamic array) built on vir_alloc/realloc.
 * Core data structure for the self-hosting compiler.
 *
 * Layout: [cap:i64][len:i64][data[0]][data[1]]...
 *                            ^-- returned pointer
 ##



extern func native_read_i64(addr: int, offset: int) -> int;
extern func native_write_i64(addr: int, offset: int, val: int);


# ═══════════════════════════════════════════════════════
# Vec operations (i64 element array)
# ═══════════════════════════════════════════════════════
# Header: ptr[-2] = capacity, ptr[-1] = length
# Data starts at ptr[0]

const VEC_INIT_CAP = 16;
const ELEM_SIZE = 8;          # i64 = 8 bytes
const HEADER_SIZE = 16;       # 2 * 8 bytes

func vec_new_rt:
    let base = vir_alloc(HEADER_SIZE + VEC_INIT_CAP * ELEM_SIZE);
    let data = base + HEADER_SIZE;
    native_write_i64(base, 0, VEC_INIT_CAP);   # capacity
    native_write_i64(base, 8, 0);               # length (byte offset 8)
    out data;
end.

func vec_len_rt:
    in(v: int)
    if v == 0 do
        out 0;
    end
    out native_read_i64(v - 8, 0);    # ptr[-1]
end.

func vec_cap_rt:
    in(v: int)
    if v == 0 do
        out 0;
    end
    out native_read_i64(v - 16, 0);   # ptr[-2]
end.

func vec_push_rt:
    in(v: int, val: int)
    if v == 0 do
        v = vec_new_rt();
    end
    if v == 0 do
        out 0;
    end
    let len = vec_len_rt(v);
    let cap = vec_cap_rt(v);

    if len >= cap do
        # Grow: double capacity
        let new_cap = cap * 2;
        if new_cap < VEC_INIT_CAP do
            new_cap = VEC_INIT_CAP;
        end
        let base = v - HEADER_SIZE;
        let new_base = vir_realloc(base, HEADER_SIZE + new_cap * ELEM_SIZE);
        let new_data = new_base + HEADER_SIZE;
        native_write_i64(new_base, 0, new_cap);
        v = new_data;
    end

    native_write_i64(v, len * 8, val);
    native_write_i64(v - 8, 0, len + 1);
    out v;
end.

func vec_get_rt:
    in(v: int, index: int)
    if v == 0 do
        out 0;
    end
    out native_read_i64(v, index * 8);
end.

func vec_set_rt:
    in(v: int, index: int, val: int)
    native_write_i64(v, index * 8, val);
end.

func vec_pop_rt:
    in(v: int)
    let len = vec_len_rt(v);
    if len == 0 do
        out 0;
    end
    let val = vec_get_rt(v, len - 1);
    native_write_i64(v - 8, 0, len - 1);
    out val;
end.

func vec_last_rt:
    in(v: int)
    let len = vec_len_rt(v);
    if len == 0 do
        out 0;
    end
    out vec_get_rt(v, len - 1);
end.

func vec_clear_rt:
    in(v: int)
    native_write_i64(v - 8, 0, 0);
end.

func vec_free_rt:
    in(v: int)
    vir_free(v - HEADER_SIZE);
end.

func vec_copy_rt:
    in(v: int)
    let len = vec_len_rt(v);
    let new_v = vec_new_rt();
    let i = 0;
    when i < len loop
        new_v = vec_push_rt(new_v, vec_get_rt(v, i));
        i = i + 1;
    end
    out new_v;
end.

func vec_contains_rt:
    in(v: int, val: int)
    let len = vec_len_rt(v);
    let i = 0;
    when i < len loop
        if vec_get_rt(v, i) == val do
            out true;
        end
        i = i + 1;
    end
    out false;
end.

func vec_index_of_rt:
    in(v: int, val: int)
    let len = vec_len_rt(v);
    let i = 0;
    when i < len loop
        if vec_get_rt(v, i) == val do
            out i;
        end
        i = i + 1;
    end
    out -1;
end.

# ═══════════════════════════════════════════════════════
# Byte Vec — for code buffers (u8 elements)
# ═══════════════════════════════════════════════════════

extern func native_read_u8(addr: int, offset: int) -> int;
extern func native_write_u8(addr: int, offset: int, val: int);

const BVEC_INIT_CAP = 4096;

func bvec_new:
    let base = vir_alloc(HEADER_SIZE + BVEC_INIT_CAP);
    let data = base + HEADER_SIZE;
    native_write_i64(base, 0, BVEC_INIT_CAP);
    native_write_i64(base, 1, 0);
    out data;
end.

func bvec_len:
    in(v: int)
    if v == 0 do
        out 0;
    end
    out native_read_i64(v - 8, 0);
end.

func bvec_push:
    in(v: int, byte: int)
    if v == 0 do
        v = bvec_new();
    end
    let len = bvec_len(v);
    let cap = native_read_i64(v - 16, 0);

    if len >= cap do
        let new_cap = cap * 2;
        let base = v - HEADER_SIZE;
        let new_base = vir_realloc(base, HEADER_SIZE + new_cap);
        let new_data = new_base + HEADER_SIZE;
        native_write_i64(new_base, 0, new_cap);
        v = new_data;
    end

    native_write_u8(v, len, byte);
    native_write_i64(v - 8, 0, len + 1);
    out v;
end.

func bvec_push_u16_le:
    in(v: int, val: int)
    v = bvec_push(v, val);
    v = bvec_push(v, val shr 8);
    out v;
end.

func bvec_push_u32_le:
    in(v: int, val: int)
    v = bvec_push(v, val);
    v = bvec_push(v, val shr 8);
    v = bvec_push(v, val shr 16);
    v = bvec_push(v, val shr 24);
    out v;
end.

func bvec_push_u64_le:
    in(v: int, val: int)
    v = bvec_push_u32_le(v, val);
    v = bvec_push_u32_le(v, val shr 32);
    out v;
end.

func bvec_pad_zeros:
    in(v: int, count: int)
    if count <= 0 do
        out v;
    end
    let len = bvec_len(v);
    let need = len + count;
    let cap = native_read_i64(v - 16, 0);
    if need > cap do
        let base = v - HEADER_SIZE;
        let new_cap = cap;
        when new_cap < need loop
            new_cap = new_cap * 2;
        end
        base = vir_realloc(base, HEADER_SIZE + new_cap);
        v = base + HEADER_SIZE;
        native_write_i64(base, 0, new_cap);
    end
    let i = len;
    when i < need loop
        native_write_u8(v, i, 0);
        i = i + 1;
    end
    native_write_i64(v - 8, 0, need);
    out v;
end.

func bvec_reserve:
    in(total: int)
    if total <= 0 do
        out bvec_new();
    end
    let base = vir_alloc(HEADER_SIZE + total);
    let data = base + HEADER_SIZE;
    native_write_i64(base, 0, total);   # capacity
    native_write_i64(base, 8, total);   # length (byte offset 8)
    out data;
end.

func bvec_get:
    in(v: int, index: int)
    out native_read_u8(v, index);
end.

func bvec_set:
    in(v: int, index: int, byte: int)
    native_write_u8(v, index, byte bit_and 0xFF);
end.

func bvec_patch_u32_le:
    in(v: int, offset: int, val: int)
    native_write_u8(v, offset, val bit_and 0xFF);
    native_write_u8(v, offset + 1, (val shr 8) bit_and 0xFF);
    native_write_u8(v, offset + 2, (val shr 16) bit_and 0xFF);
    native_write_u8(v, offset + 3, (val shr 24) bit_and 0xFF);
end.

func bvec_data_ptr:
    in(v: int)
    out v;   # data pointer is v itself
end.

func bvec_free:
    in(v: int)
    vir_free(v - HEADER_SIZE);
end.
# ══ END vir/rt/vec_rt ══

# ══ BEGIN vir/rt/start ══
##
 * vir/rt/start.vri — Program Entry Point (Pure Vir, No C)
 * =========================================================
 * This replaces runtime.c entirely.
 *
 * On macOS ARM64 (Mach-O), the kernel jumps to _start.
 * The stack contains:
 *   [SP]     → argc (i64)
 *   [SP+8]   → argv[0] pointer
 *   [SP+16]  → argv[1] pointer
 *   ...
 *   [SP+8*(argc+1)] → NULL
 *   then envp[]
 *
 * On Linux ARM64 (ELF), identical stack layout.
 *
 * This module:
 *   1. Extracts argc/argv from stack
 *   2. Initializes the heap allocator
 *   3. Calls user's main() function
 *   4. Calls sys_exit with return code
 ##



# ═══════════════════════════════════════════════════════
# Global argc/argv (set by _start)
# ═══════════════════════════════════════════════════════

var g_argc = 0;
var g_argv = 0;     # pointer to argv array

func rt_argc:
    out g_argc;
end.

func rt_argv:
    in(index: int)
    if index < 0 or index >= g_argc do
        out 0;
    end
    extern func native_read_i64(addr: int, offset: int) -> int;
    out native_read_i64(g_argv, index * 8);
end.

# ═══════════════════════════════════════════════════════
# Forward declaration: user's main function
# ═══════════════════════════════════════════════════════
# The compiler will resolve this to the user's main() function.

extern func vir_main() -> int;

# ═══════════════════════════════════════════════════════
# _start — The TRUE entry point (no C involved)
# ═══════════════════════════════════════════════════════
# The compiler emits this as bare assembly.
# On ARM64 macOS:
#   _start:
#       ldr  x0, [sp]          // argc
#       add  x1, sp, #8        // argv
#       bl   _vir_start
#       mov  x16, #1           // SYS_exit
#       svc  #0x80
#
# This function is called by that assembly stub.

func _vir_start:
    in(argc: int, argv: int)

    # Store globals
    g_argc = argc;
    g_argv = argv;

    # Initialize heap (4MB)
    heap_init(MIN_ARENA_SIZE * 4);

    # Call user's main()
    let exit_code = vir_main();

    # Exit
    sys_exit(exit_code);
end.

# ═══════════════════════════════════════════════════════
# Compiler-emitted intrinsics
# ═══════════════════════════════════════════════════════
# The following are emitted as inline machine code by the
# Vir compiler. They do NOT call libc.

# Memory intrinsics (compiled to plain load/store instructions)
# native_read_u8(addr, offset)   → ldrb w0, [x0, x1]
# native_write_u8(addr, ofs, v)  → strb w2, [x0, x1]
# native_read_i64(addr, offset)  → ldr  x0, [x0, x1]
# native_write_i64(addr, ofs, v) → str  x2, [x0, x1]
# native_mem_copy(dst, src, len) → loop of ldrb/strb
# native_mem_set(dst, val, len)  → loop of strb

# Syscall intrinsics (compiled to SVC / SYSCALL instructions)
# syscall0..6 → mov args to regs, mov sysnum to x16/x8/rax, svc/syscall
# ══ END vir/rt/start ══

# ══ BEGIN vir/core/result ══
##
 * vir/core/result.vri — Result<T, E> = Ok(T) | Err(E)
 * =====================================================
 * Explicit error handling, no exceptions.
 * Inspired by Rust Result type, replaces C errno + Python try/except.
 *
 * Compiler uses internally: parse result, codegen result, file I/O result.
 ##


# ═══════════════════════════════════════════════════════
# Result type — tagged union
# ═══════════════════════════════════════════════════════

enum Result:
    Ok(value)       # Success;
    Err(error)          # Failure;
end.

# ═══════════════════════════════════════════════════════
# State check
# ═══════════════════════════════════════════════════════

func is_ok:
    in(r: Result)
    case r
        Ok(_): out true;
        Err(_): out false;
    end
end.

func is_err:
    in(r: Result)
    out not is_ok(r);
end.

# ═══════════════════════════════════════════════════════
# Get value
# ═══════════════════════════════════════════════════════

func unwrap:
    in(r: Result)
    # Get Ok value. Panic if Err.
    case r
        Ok(v): out v;
        Err(e): panic("unwrap() called on Err: " + to_string(e));
    end
end.

func unwrap_err:
    in(r: Result)
    # Get Err value. Panic if Ok.
    case r
        Ok(_): panic("unwrap_err() called on Ok");
        Err(e): out e;
    end
end.

func unwrap_or:
    in(r: Result, default)
    case r
        Ok(v): out v;
        Err(_): out default
    end
end.

func unwrap_or_else:
    in(r: Result, f: Func)
    case r
        Ok(v): out v;
        Err(e): out f(e);
    end
end.

func expect:
    in(r: Result, msg: string)
    case r
        Ok(v): out v;
        Err(_): panic(msg);
    end
end.

# ═══════════════════════════════════════════════════════
# Transformations
# ═══════════════════════════════════════════════════════

func map:
    in(r: Result, f: Func)
    # Ok(x).map(f) -> Ok(f(x))
    # Err(e).map(f) -> Err(e)
    case r
        Ok(v): out Ok(f(v));
        Err(e): out Err(e);
    end
end.

func map_err:
    in(r: Result, f: Func)
    # Ok(x).map_err(f) -> Ok(x)
    # Err(e).map_err(f) -> Err(f(e))
    case r
        Ok(v): out Ok(v);
        Err(e): out Err(f(e));
    end
end.

func flat_map:
    in(r: Result, f: Func)
    # Ok(x).flat_map(f) -> f(x)   (f must return Result)
    # Err(e).flat_map(f) -> Err(e)
    case r
        Ok(v): out f(v);
        Err(e): out Err(e);
    end
end.

func and_then:
    in(r: Result, f: Func)
    # Alias cho flat_map — string Result
    out flat_map(r, f);
end.

func or_else:
    in(r: Result, f: Func)
    # Ok(x).or_else(f) -> Ok(x)
    # Err(e).or_else(f) -> f(e)
    case r
        Ok(v): out Ok(v);
        Err(e): out f(e);
    end
end.

# ═══════════════════════════════════════════════════════
# Conversions
# ═══════════════════════════════════════════════════════

func result_to_option:
    in(r: Result)
    # Ok(v) -> Some(v), Err(_) -> None
    case r
        Ok(v): out Some(v);
        Err(_): out None;
    end
end.

func ok:
    in(r: Result)
    # Alias cho result_to_option
    out result_to_option(r);
end.

func err:
    in(r: Result)
    # Ok(_) -> None, Err(e) -> Some(e)
    case r
        Ok(_): out None;
        Err(e): out Some(e);
    end
end.

# ═══════════════════════════════════════════════════════
# Result utilities (Result chaining)
# ═══════════════════════════════════════════════════════
# ══ END vir/core/result ══

# ══ BEGIN vir/core/option ══
##
 * vir/core/option.vri — Option<T> = Some(T) | None
 * ==================================================
 * Replaces NULL pointer. All values that may be absent
 * must be wrapped in Option.
 *
 * Compiler uses internally: result lookup symbol table, find token, etc.
 ##


# ═══════════════════════════════════════════════════════
# Option type — tagged union
# ═══════════════════════════════════════════════════════

enum Option:
    Some(value)     # Has value;
    None              # No value;
end.

# ═══════════════════════════════════════════════════════
# State check
# ═══════════════════════════════════════════════════════

func is_some:
    in(opt: Option)
    case opt
        Some(_): out true;
        None: out false;
    end
end.

func is_none:
    in(opt: Option)
    out not is_some(opt);
end.

# ═══════════════════════════════════════════════════════
# Get value
# ═══════════════════════════════════════════════════════

func unwrap:
    in(opt: Option)
    # Get value from Some. Panic if None.
    case opt
        Some(v): out v;
        None: panic("unwrap() called on None");
    end
end.

func unwrap_or:
    in(opt: Option, default)
    # Get value internally Some, or out default if None.
    case opt
        Some(v): out v;
        None: out default
    end
end.

func unwrap_or_else:
    in(opt: Option, f: Func)
    # Get value from Some, or call f() if None.
    case opt
        Some(v): out v;
        None: out f();
    end
end.

func expect:
    in(opt: Option, msg: string)
    # Like unwrap but with custom error message.
    case opt
        Some(v): out v;
        None: panic(msg)
    end
end.

# ═══════════════════════════════════════════════════════
# Transformations
# ═══════════════════════════════════════════════════════

func map:
    in(opt: Option, f: Func)
    # Apply f to value if Some, keep None.
    # Some(x).map(f) -> Some(f(x))
    # None.map(f) -> None
    case opt
        Some(v): out Some(f(v));
        None: out None;
    end
end.

func flat_map:
    in(opt: Option, f: Func)
    # f must return Option. Flatten result.
    # Some(x).flat_map(f) -> f(x)
    # None.flat_map(f) -> None
    case opt
        Some(v): out f(v);
        None: out None;
    end
end.

func filter:
    in(opt: Option, predicate: Func)
    # Keep Some if predicate(value) returns true, otherwise None.
    case opt
        Some(v):
            if predicate(v) do
                out Some(v);
            else
                out None;
            end
        None: out None;
    end
end.

func or_else:
    in(opt: Option, alternative: Option)
    # Returns opt if Some, otherwise return alternative.
    case opt
        Some(_): out opt;
        None: out alternative;
    end
end.

func zip:
    in(a: Option, b: Option)
    # Combine two Options into Option<(a, b)>.
    # Both must be Some for result to be Some.
    if is_some(a) and is_some(b) do
        out Some((unwrap(a), unwrap(b)));
    end
    out None;
end.

# ═══════════════════════════════════════════════════════
# Conversions
# ═══════════════════════════════════════════════════════
# ══ END vir/core/option ══

# ══ BEGIN vir/core/types ══
##
 * vir/core/types.vri — Primitive types bit_and limits
 * ===================================================
 * Inspired by C23: <stdint.h>, <stddef.h>, <limits.h>, <float.h>
 * Inspired by Python: builtins (int, float, bool, None)
 *
 * This is the foundation: all other modules depend on vir/core/types.
 * Compiler uses internally: i64 for registers, u8 for byte buffer, bool for flags.
 ##

# ═══════════════════════════════════════════════════════
# Signed integer types
# ═══════════════════════════════════════════════════════

type i8;      # 8-bit signed:  -128 .. 127
type i16;     # 16-bit signed: -32768 .. 32767
type i32;     # 32-bit signed: -2^31 .. 2^31 - 1
type i64;     # 64-bit signed: -2^63 .. 2^63 - 1  (default for integers)

# ═══════════════════════════════════════════════════════
# Unsigned integer types
# ═══════════════════════════════════════════════════════

type u8;      # 8-bit unsigned: 0 .. 255
type u16;     # 16-bit unsigned: 0 .. 65535
type u32;     # 32-bit unsigned: 0 .. 2^32 - 1
type u64;     # 64-bit unsigned: 0 .. 2^64 - 1

# ═══════════════════════════════════════════════════════
# Floating point types (IEEE 754)
# ═══════════════════════════════════════════════════════

type f32;     # 32-bit float (single precision)
type f64;     # 64-bit float (double precision, default for floats)

# ═══════════════════════════════════════════════════════
# Other fundamental types
# ═══════════════════════════════════════════════════════

type bool;    # true / false
type byte;    # alias for u8 — use for binary data
type ptr;     # raw pointer — address-as-integer (u64 internally)
type void;    # void type — func returns nothing

# ═══════════════════════════════════════════════════════
# Size types (from C23 <stddef.h>)
# ═══════════════════════════════════════════════════════

type usize;   # unsigned, pointer-sized (u64 on 64-bit)
type isize;   # signed, pointer-sized (i64 on 64-bit)

# ═══════════════════════════════════════════════════════
# Type limits (from C23 <limits.h> + <float.h>)
# ═══════════════════════════════════════════════════════

const I8_MIN: -128;
const I8_MAX: 127;
const I16_MIN: -32768;
const I16_MAX: 32767;
const I32_MIN: -2147483648;
const I32_MAX: 2147483647;
const I64_MIN: -9223372036854775808;
const I64_MAX: 9223372036854775807;

const U8_MAX: 255;
const U16_MAX: 65535;
const U32_MAX: 4294967295;
const U64_MAX: 18446744073709551615;

const F32_EPSILON: 1.1920929e-7;
const F32_MIN: 1.17549435e-38;
const F32_MAX: 3.40282347e+38;

const F64_EPSILON: 2.2204460492503131e-16;
const F64_MIN: 2.2250738585072014e-308;
const F64_MAX: 1.7976931348623157e+308;

# ═══════════════════════════════════════════════════════
# Type conversion functions
# ═══════════════════════════════════════════════════════

func to_i8:
    in(x: i64)
    # Truncate to 8-bit signed, panic if overflow
    if x < I8_MIN or x > I8_MAX do
        panic("overflow: i64 -> i8")
    end
    out x as i8
end.

func to_i16:
    in(x: i64)
    if x < I16_MIN or x > I16_MAX do
        panic("overflow: i64 -> i16")
    end
    out x as i16
end.

func to_i32:
    in(x: i64)
    if x < I32_MIN or x > I32_MAX do
        panic("overflow: i64 -> i32")
    end
    out x as i32
end.

func to_u8:
    in(x: i64)
    if x < 0 or x > U8_MAX do
        panic("overflow: i64 -> u8")
    end
    out x as u8
end.

func to_u16:
    in(x: i64)
    if x < 0 or x > U16_MAX do
        panic("overflow: i64 -> u16")
    end
    out x as u16
end.

func to_u32:
    in(x: i64)
    if x < 0 or x > U32_MAX do
        panic("overflow: i64 -> u32")
    end
    out x as u32
end.

func to_u64:
    in(x: i64)
    if x < 0 do
        panic("overflow: i64 -> u64 (negative)")
    end
    out x as u64
end.

func to_f32:
    in(x: f64)
    out x as f32
end.

func to_f64:
    in(x: i64)
    out x as f64
end.

func to_bool:
    in(x: int)
    out x != 0
end.

# ═══════════════════════════════════════════════════════
# String parse functions
# ═══════════════════════════════════════════════════════

func parse_int:
    in(s: string)
    # Parse decimal string -> i64
    # Supports prefix: "0x" (hex), "0b" (binary), "0o" (octal)
    result = 0;
    negative = false;
    pos = 0;
    base = 10;

    if len(s) == 0 do
        out Err(ParseError ( msg: "empty string" ))
    end

    # Check negative sign
    if s[0] == '-' do
        negative = true;
        pos = 1
    end

    # Check prefix
    if pos + 1 < len(s) do
        if s[pos] == '0' do
            case s[pos + 1]
                case 'x': base = 16; pos = pos + 2;
                case 'b': base = 2;  pos = pos + 2;
                case 'o': base = 8;  pos = pos + 2;
            end
        end
    end

    # Parse digits
    when pos < len(s) loop
        ch = s[pos];
        digit = char_to_digit(ch, base);
        if is_err(digit) do
            out Err(ParseError ( msg: "invalid digit" ))
        end
        result = result * base + unwrap(digit);
        pos = pos + 1
    end

    if negative do result = -result end
    out Ok(result)
end.

func parse_float:
    in(s: string)
    # Parse decimal string -> f64
    # Delegate to native implementation
    out native_parse_float(s)
end.
# ══ END vir/core/types ══

# ══ BEGIN vir/mem/copy ══
##
 * vir/mem/copy.vri — Memory Operations
 * ======================================
 * Inspired by C23: <string.h> memcpy, memset, memmove, memcmp
 ##


func mem_copy:
    in(dst: ptr, src: ptr, n: int)
    # Copy n bytes từ src sang dst. Hành vi không xác định if overlap.
    native_memcpy(dst, src, n);
end.

func mem_move:
    in(dst: ptr, src: ptr, n: int)
    # Copy n bytes từ src sang dst. An toàn khi overlap.
    native_memmove(dst, src, n);
end.

func mem_set:
    in(dst: ptr, val: int, n: int)
    # Đặt n bytes tại dst thành val.
    native_memset(dst, val, n);
end.

func mem_zero:
    in(dst: ptr, n: int)
    # Đặt n bytes = 0.
    mem_set(dst, 0, n);
end.

func mem_cmp:
    in(a: ptr, b: ptr, n: int)
    # So sánh n bytes. Returns 0 if giống, < 0 if a < b, > 0 if a > b
    out native_memcmp(a, b, n);
end.

func mem_eq:
    in(a: ptr, b: ptr, n: int)
    out mem_cmp(a, b, n) == 0;
end.
# ══ END vir/mem/copy ══

# ══ BEGIN vir/str/string ══
##
 * vir/str/string.vri — Immutable UTF-8 String
 * =============================================
 * String default của Vir là UTF-8 immutable.
 * Biến đổi string -> tạo string mới (use StringBuilder cho hiệu suất).
 *
 * Inspired by C23: <string.h> strlen, strcmp, strstr
 * Inspired by Python: str type methods
 * Vượt cả hai: Unicode-first, không null-terminated.
 ##


entity String:
    data: ptr       # UTF-8 encoded bytes (owned, NOT null-terminated inside);
    byte_len: int   # Số bytes;
    char_len: int   # Số Unicode codepoints (cached, tính lần đầu);
end.

# ═══════════════════════════════════════════════════════
# Tạo string
# ═══════════════════════════════════════════════════════

func str_new:
    in(literal: string)
    # Tạo String từ string literal. Copy dữ liệu.
    blen = native_str_byte_len(literal);
    p = alloc(blen);
    mem_copy(p, native_str_ptr(literal), blen);
    out String { data: p, byte_len: blen, char_len: utf8_count_chars(p, blen) };
end.

func str_empty:
    out String { data: null, byte_len: 0, char_len: 0 };
end.

func str_from_bytes:
    in(data: ptr, len: int)
    p = alloc(len);
    mem_copy(p, data, len);
    out String { data: p, byte_len: len, char_len: utf8_count_chars(p, len) };
end.

# ═══════════════════════════════════════════════════════
# Thông tin cơ bản
# ═══════════════════════════════════════════════════════

func str_len:
    in(s: string)
    # Returns số codepoints (character Unicode)
    out s.char_len;
end.

func str_byte_len:
    in(s: string)
    # Returns số bytes
    out s.byte_len;
end.

func str_is_empty:
    in(s: string)
    out s.byte_len == 0;
end.

# ═══════════════════════════════════════════════════════
# Truy cập character
# ═══════════════════════════════════════════════════════

func str_char_at:
    in(s: string, index: int)
    # Returns Unicode codepoint tại vị trí index (theo codepoint, O(n))
    if index >= s.char_len do
        panic("str_char_at: index out of bounds");
    end
    out utf8_char_at(s.data, s.byte_len, index);
end.

func str_byte_at:
    in(s: string, index: int)
    # Returns byte tại vị trí index (O(1))
    if index >= s.byte_len do
        panic("str_byte_at: index out of bounds");
    end
    out native_read_u8(s.data, index);
end.

# ═══════════════════════════════════════════════════════
# So sánh
# ═══════════════════════════════════════════════════════

func str_eq:
    in(a: string, b: string)
    if a.byte_len != b.byte_len do out false; end
    out mem_cmp(a.data, b.data, a.byte_len) == 0;
end.

func str_cmp:
    in(a: string, b: string)
    if a.byte_len < b.byte_len do min_len = a.byte_len; else min_len = b.byte_len; end
    r = mem_cmp(a.data, b.data, min_len);
    if r != 0 do out r; end
    if a.byte_len < b.byte_len do out -1; end
    if a.byte_len > b.byte_len do out 1; end
    out 0;
end.

# ═══════════════════════════════════════════════════════
# Cắt string (Slicing)
# ═══════════════════════════════════════════════════════

func str_slice:
    in(s: string, idx_from: int, to: int)
    # Cắt theo vị trí codepoint [from, to)
    if idx_from > to or to > s.char_len do
        panic("str_slice: invalid range");
    end
    byte_start = utf8_offset_of(s.data, s.byte_len, idx_from);
    byte_idx_end = utf8_offset_of(s.data, s.byte_len, to);
    out str_from_bytes(s.data + byte_start, byte_idx_end - byte_start);
end.

func str_slice_bytes:
    in(s: string, idx_from: int, to: int)
    # Cắt theo byte offset [from, to) — nhanh hơn, phải đảm bảo valid UTF-8
    if idx_from > to or to > s.byte_len do
        panic("str_slice_bytes: invalid range");
    end
    out str_from_bytes(s.data + idx_from, to - idx_from);
end.

# ═══════════════════════════════════════════════════════
# Nối string (Concatenation)
# ═══════════════════════════════════════════════════════

func str_concat:
    in(a: string, b: string)
    total = a.byte_len + b.byte_len;
    p = alloc(total);
    mem_copy(p, a.data, a.byte_len);
    mem_copy(p + a.byte_len, b.data, b.byte_len);
    out String { data: p, byte_len: total, char_len: a.char_len + b.char_len };
end.

# ═══════════════════════════════════════════════════════
# Tìm kiếm
# ═══════════════════════════════════════════════════════

func str_contains:
    in(haystack: string, needle: string)
    out is_some(str_find(haystack, needle));
end.

func str_find:
    in(haystack: string, needle: string)
    # Two-Way algorithm — O(n) worst-case, O(1) space (same as glibc strstr)
    n = haystack.byte_len;
    m = needle.byte_len;
    if m == 0 do out Some(0); end
    if m > n do out None; end
    if m == 1 do
        # Single byte fast path
        b = native_read_u8(needle.data, 0);
        i = 0;
        when i < n loop
            if native_read_u8(haystack.data, i) == b do
                out Some(i);
            end
            i = i + 1;
        end
        out None;
    end

    # Compute maximal suffix (Two-Way critical factorization)
    ms = _two_way_maxsuf(needle.data, m, false);
    ms2 = _two_way_maxsuf(needle.data, m, true);
    if ms > ms2 do period_pos = ms; else period_pos = ms2; end

    # Check if needle has a periodic structure
    period = period_pos + 1;  # simplified period for Two-Way
    memory = 0;
    i = 0;
    when i <= n - m loop
        # Right half
        if memory > period_pos do j = memory; else j = period_pos; end
        found_right = true;
        when j < m loop
            if native_read_u8(haystack.data, i + j) != native_read_u8(needle.data, j) do
                i = i + (j - period_pos);
                memory = 0;
                found_right = false;
                break;
            end
            j = j + 1;
        end
        if found_right do
            # Left half
            j = period_pos;
            matched = true;
            when j > memory loop
                j = j - 1;
                if native_read_u8(haystack.data, i + j) != native_read_u8(needle.data, j) do
                    i = i + period;
                    memory = m - period;
                    matched = false;
                    break;
                end
            end
            if matched do
                out Some(i);
            end
        end
    end
    out None;
end.

func _two_way_maxsuf:
    in(pat: ptr, m: int, reversed: bool)
    # Compute maximal suffix position for Two-Way algorithm
    ms = -1;
    j = 0;
    p = 1;
    k = 1;
    when j + k < m loop
        a = native_read_u8(pat, j + k);
        b = native_read_u8(pat, ms + k);
        if reversed do tmp = a; a = b; b = tmp; end
        if a < b do
            j = j + k;
            k = 1;
            p = j - ms;
        eif a == b do
            if k == p do
                j = j + p;
                k = 1;
            else
                k = k + 1;
            end
        else
            ms = j;
            j = ms + 1;
            k = 1;
            p = 1;
        end
    end
    out ms;
end.

func str_starts_with:
    in(s: string, prefix: string)
    if prefix.byte_len > s.byte_len do out false; end
    out mem_cmp(s.data, prefix.data, prefix.byte_len) == 0;
end.

func str_ends_with:
    in(s: string, suffix: string)
    if suffix.byte_len > s.byte_len do out false; end
    offset = s.byte_len - suffix.byte_len;
    out mem_cmp(s.data + offset, suffix.data, suffix.byte_len) == 0;
end.

# ═══════════════════════════════════════════════════════
# Biến đổi
# ═══════════════════════════════════════════════════════

func str_to_upper:
    in(s: string)
    # ASCII to_upper (Unicode full case mapping cần bảng tra)
    p = alloc(s.byte_len);
    mem_copy(p, s.data, s.byte_len);
    for i in 0..s.byte_len do
        b = native_read_u8(p, i);
        if b >= 0x61 and b <= 0x7A do
            native_write_u8(p, i, b - 32);
        end
    end
    out String { data: p, byte_len: s.byte_len, char_len: s.char_len };
end.

func str_to_lower:
    in(s: string)
    p = alloc(s.byte_len);
    mem_copy(p, s.data, s.byte_len);
    for i in 0..s.byte_len do
        b = native_read_u8(p, i);
        if b >= 0x41 and b <= 0x5A do
            native_write_u8(p, i, b + 32);
        end
    end
    out String { data: p, byte_len: s.byte_len, char_len: s.char_len };
end.

func str_trim:
    in(s: string)
    start = 0;
    when start < s.byte_len and is_ascii_whitespace(native_read_u8(s.data, start)) loop
        start = start + 1;
    end
    idx_end = s.byte_len;
    when idx_end > start and is_ascii_whitespace(native_read_u8(s.data, idx_end - 1)) loop
        idx_idx_end = idx_idx_end - 1;
    end
    out str_slice_bytes(s, start, idx_end);
end.

func str_trim_start:
    in(s: string)
    start = 0;
    when start < s.byte_len and is_ascii_whitespace(native_read_u8(s.data, start)) loop
        start = start + 1;
    end
    out str_slice_bytes(s, start, s.byte_len);
end.

func str_trim_end:
    in(s: string)
    idx_end = s.byte_len;
    when idx_end > 0 and is_ascii_whitespace(native_read_u8(s.data, idx_end - 1)) loop
        idx_idx_end = idx_idx_end - 1;
    end
    out str_slice_bytes(s, 0, idx_end);
end.

func str_replace:
    in(s: string, old: string, new: string)
    # Thay thế tất cả occurrence của `old` bằng `new`
    # TODO: implement using StringBuilder for efficiency
    out native_str_replace(s, old, new);
end.

func str_repeat:
    in(s: string, count: int)
    total = s.byte_len * count;
    p = alloc(total);
    for i in 0..count do
        mem_copy(p + i * s.byte_len, s.data, s.byte_len);
    end
    out String { data: p, byte_len: total, char_len: s.char_len * count };
end.

# ═══════════════════════════════════════════════════════
# Tách / Nối
# ═══════════════════════════════════════════════════════

func str_split:
    in(s: string, delim: string)
    # Tách string theo delimiter
    out native_str_split(s, delim);
end.

func str_join:
    in(parts: Vec<string>, sep: string)
    # Nối các string với separator
    out native_str_join(parts, sep);
end.

# ═══════════════════════════════════════════════════════
# Conversions
# ═══════════════════════════════════════════════════════

func str_to_i64:
    in(s: string)
    out parse_int(s);
end.

func str_to_f64:
    in(s: string)
    out parse_float(s);
end.

func i64_to_str:
    in(n: int)
    out native_i64_to_str(n);
end.

func f64_to_str:
    in(f: float)
    out native_f64_to_str(f);
end.

func str_free:
    in(s: string)
    free(s.data);
end.

# ═══════════════════════════════════════════════════════
# UTF-8 helpers (internal)
# ═══════════════════════════════════════════════════════

func is_ascii_whitespace:
    in(b: int)
    out b == 0x20 or b == 0x09 or b == 0x0A or b == 0x0D;
end.

func utf8_count_chars:
    in(data: ptr, byte_len: int)
    # Đếm số codepoints in UTF-8 data
    count = 0;
    i = 0;
    when i < byte_len loop
        b = native_read_u8(data, i);
        if (b bit_and 0x80) == 0 do
            i = i + 1           # 1-byte (ASCII);
        eif (b bit_and 0xE0) == 0xC0 do
            i = i + 2           # 2-byte;
        eif (b bit_and 0xF0) == 0xE0 do
            i = i + 3           # 3-byte;
        eif (b bit_and 0xF8) == 0xF0 do
            i = i + 4           # 4-byte;
        else
            i = i + 1           # invalid, skip byte;
        end
        count = count + 1;
    end
    out count;
end.

func utf8_char_at:
    in(data: ptr, byte_len: int, char_index: int)
    # Lấy codepoint tại vị trí char_index (O(n) scan)
    count = 0;
    i = 0;
    when i < byte_len loop
        b = native_read_u8(data, i);
        if count == char_index do
            out utf8_decode_char(data, i, byte_len);
        end
        if (b bit_and 0x80) == 0 do i = i + 1;
        eif (b bit_and 0xE0) == 0xC0 do i = i + 2;
        eif (b bit_and 0xF0) == 0xE0 do i = i + 3;
        eif (b bit_and 0xF8) == 0xF0 do i = i + 4;
        else i = i + 1;
        end
        count = count + 1;
    end
    panic("utf8_char_at: index out of bounds");
end.

func utf8_offset_of:
    in(data: ptr, byte_len: int, char_index: int)
    count = 0;
    i = 0;
    when i < byte_len and count < char_index loop
        b = native_read_u8(data, i);
        if (b bit_and 0x80) == 0 do i = i + 1;
        eif (b bit_and 0xE0) == 0xC0 do i = i + 2;
        eif (b bit_and 0xF0) == 0xE0 do i = i + 3;
        eif (b bit_and 0xF8) == 0xF0 do i = i + 4;
        else i = i + 1;
        end
        count = count + 1;
    end
    out i;
end.
# ══ END vir/str/string ══

# ══ BEGIN vir/rt/macho ══
##
 * vir/rt/macho.vri — Mach-O Executable Emitter (Pure Vir)
 * =========================================================
 * Emits a complete Mach-O 64-bit executable for macOS ARM64
 * and x86-64. No external assembler (as) or linker (ld) needed.
 *
 * Produces a standalone binary that the kernel can exec directly:
 *   Mach-O Header → Load Commands → __TEXT → __DATA → LC_MAIN
 *
 * The binary uses direct BSD syscalls — no dyld, no libSystem
 * unless linking is explicitly requested.
 ##



# ═══════════════════════════════════════════════════════
# Mach-O Constants
# ═══════════════════════════════════════════════════════

# Magic numbers
const MH_MAGIC_64:      0xFEEDFACF;

# CPU types
const CPU_TYPE_X86_64:  0x01000007;
const CPU_TYPE_ARM64:   0x0100000C;
const CPU_SUB_ALL:      0x00000000;
const CPU_SUB_ARM64_ALL: 0x00000000;

# File types
const MH_EXECUTE:       2;

# Flags
const MH_NOUNDEFS:      0x00000001;
const MH_DYLDLINK:      0x00000004;
const MH_TWOLEVEL:      0x00000080;
const MH_PIE:           0x00200000;

# Load command types
const LC_SEGMENT_64:    0x19;
const LC_MAIN:          0x80000028;
const LC_SYMTAB:        0x02;
const LC_DYSYMTAB:      0x0B;
const LC_UUID:          0x1B;
const LC_BUILD_VERSION: 0x32;
const LC_SOURCE_VERSION: 0x2A;
const LC_LOAD_DYLIB:    0x0C;
const LC_LOAD_DYLINKER: 0x0E;
const LC_DYLD_INFO_ONLY: 0x80000022;
const LC_DYLD_CHAINED_FIXUPS: 0x80000034;

# Segment/section constants
const VM_PROT_READ:     1;
const VM_PROT_WRITE:    2;
const VM_PROT_EXECUTE:  4;

const S_ATTR_PURE_INSTRUCTIONS: 0x80000000;
const S_ATTR_SOME_INSTRUCTIONS: 0x00000400;
const S_REGULAR:        0x00000000;
const S_ZEROFILL:       0x00000001;

# Page sizes
const PAGE_SIZE_ARM64:  0x4000;     # 16KB
const PAGE_SIZE_X86:    0x1000;     # 4KB
const TEXT_BASE:        0x100000000;

# ═══════════════════════════════════════════════════════
# Mach-O Builder
# ═══════════════════════════════════════════════════════

entity MachOBuilder:
    buf:            int;        # bvec byte buffer
    arch:           int;        # 0=ARM64, 1=x86_64
    page_size:      int;
    text_code:      int;        # bvec with machine code
    data_bytes:     int;        # bvec with data section
    entry_offset:   int;        # offset of _start in __text
end.

func macho_new:
    in(arch: int)
    let page = PAGE_SIZE_ARM64;
    if arch == 1 do
        page = PAGE_SIZE_X86;
    end
    out MachOBuilder (
        buf: bvec_new(),
        arch: arch,
        page_size: page,
        text_code: bvec_new(),
        data_bytes: bvec_new(),
        entry_offset: 0
    );
end.

# ═══════════════════════════════════════════════════════
# Write Header
# ═══════════════════════════════════════════════════════

var g_mach_buf = 0;
var g_mach_text_code = 0;
var g_mach_code_size = 0;
var g_mach_code_offset = 616;
var g_mach_text_seg_size = 0;
var g_mach_entry_file_off = 0;
var g_mach_linkedit_off = 0;
var g_mach_linkedit_vm = 0;
var g_mach_strtab_off = 0;

func macho_builder_out:
    in(b: MachOBuilder)
    out MachOBuilder {
        buf:          g_mach_buf,
        arch:         b.arch,
        page_size:    b.page_size,
        text_code:    g_mach_text_code,
        data_bytes:   b.data_bytes,
        entry_offset: b.entry_offset
    };
end.

func macho_write_header:
    in(b: MachOBuilder, ncmds: int, sizeofcmds: int)
    let buf = g_mach_buf;
    if buf == 0 do
        buf = b.buf;
    end

    # MH_MAGIC_64
    buf = bvec_push_u32_le(buf, MH_MAGIC_64);

    # CPU type
    if b.arch == 0 do
        buf = bvec_push_u32_le(buf, CPU_TYPE_ARM64);
        buf = bvec_push_u32_le(buf, CPU_SUB_ARM64_ALL);
    else
        buf = bvec_push_u32_le(buf, CPU_TYPE_X86_64);
        buf = bvec_push_u32_le(buf, CPU_SUB_ALL);
    end

    # File type
    buf = bvec_push_u32_le(buf, MH_EXECUTE);

    # Number of load commands
    buf = bvec_push_u32_le(buf, ncmds);

    # Size of load commands
    buf = bvec_push_u32_le(buf, sizeofcmds);

    # Flags: PIE + NOUNDEFS + DYLDLINK + TWOLEVEL (required for dynamic linking)
    buf = bvec_push_u32_le(buf, MH_PIE | MH_NOUNDEFS | MH_DYLDLINK | MH_TWOLEVEL);

    # Reserved (64-bit header)
    buf = bvec_push_u32_le(buf, 0);

    g_mach_buf = buf;
    out macho_builder_out(b);
end.

func macho_write_segment:
    in(b: MachOBuilder, name: int, vmaddr: int, vmsize: int,
       fileoff: int, filesize: int, maxprot: int, initprot: int,
       nsects: int)
    let buf = g_mach_buf;
    if buf == 0 do
        buf = b.buf;
    end

    # cmd
    buf = bvec_push_u32_le(buf, LC_SEGMENT_64);

    # cmdsize (72 + 80 * nsects)
    let cmdsize = 72 + 80 * nsects;
    buf = bvec_push_u32_le(buf, cmdsize);

    # segname (16 bytes, padded)
    let name_len = rt_strlen(name);
    let i = 0;
    extern func native_read_u8(addr: int, offset: int) -> int;
    when i < 16 loop
        if i < name_len do
            buf = bvec_push(buf, native_read_u8(name, i));
        else
            buf = bvec_push(buf, 0);
        end
        i = i + 1;
    end

    # vmaddr, vmsize
    buf = bvec_push_u64_le(buf, vmaddr);
    buf = bvec_push_u64_le(buf, vmsize);

    # fileoff, filesize
    buf = bvec_push_u64_le(buf, fileoff);
    buf = bvec_push_u64_le(buf, filesize);

    # maxprot, initprot
    buf = bvec_push_u32_le(buf, maxprot);
    buf = bvec_push_u32_le(buf, initprot);

    # nsects, flags
    buf = bvec_push_u32_le(buf, nsects);
    buf = bvec_push_u32_le(buf, 0);

    g_mach_buf = buf;
    out macho_builder_out(b);
end.

# ═══════════════════════════════════════════════════════
# Write Section Header (within a segment)
# ═══════════════════════════════════════════════════════

func macho_write_section:
    in(b: MachOBuilder, sectname: int, segname: int,
       addr: int, size: int, offset: int, align: int,
       flags: int)
    let buf = g_mach_buf;
    if buf == 0 do
        buf = b.buf;
    end

    extern func native_read_u8(addr: int, offset: int) -> int;

    # sectname (16 bytes)
    let sn_len = rt_strlen(sectname);
    let i = 0;
    when i < 16 loop
        if i < sn_len do
            buf = bvec_push(buf, native_read_u8(sectname, i));
        else
            buf = bvec_push(buf, 0);
        end
        i = i + 1;
    end

    # segname (16 bytes)
    let sg_len = rt_strlen(segname);
    i = 0;
    when i < 16 loop
        if i < sg_len do
            buf = bvec_push(buf, native_read_u8(segname, i));
        else
            buf = bvec_push(buf, 0);
        end
        i = i + 1;
    end

    # addr, size
    buf = bvec_push_u64_le(buf, addr);
    buf = bvec_push_u64_le(buf, size);

    # offset, align
    buf = bvec_push_u32_le(buf, offset);
    buf = bvec_push_u32_le(buf, align);

    # reloff, nreloc
    buf = bvec_push_u32_le(buf, 0);
    buf = bvec_push_u32_le(buf, 0);

    # flags, reserved1, reserved2
    buf = bvec_push_u32_le(buf, flags);
    buf = bvec_push_u32_le(buf, 0);
    buf = bvec_push_u32_le(buf, 0);
    buf = bvec_push_u32_le(buf, 0);

    g_mach_buf = buf;
    out macho_builder_out(b);
end.

# ═══════════════════════════════════════════════════════
# Write LC_MAIN
# ═══════════════════════════════════════════════════════

func macho_write_lc_main:
    in(b: MachOBuilder, entryoff: int)
    let buf = g_mach_buf;
    if buf == 0 do
        buf = b.buf;
    end

    buf = bvec_push_u32_le(buf, LC_MAIN);
    buf = bvec_push_u32_le(buf, 24);
    buf = bvec_push_u64_le(buf, entryoff);
    buf = bvec_push_u64_le(buf, 0);

    g_mach_buf = buf;
    out macho_builder_out(b);
end.

# ═══════════════════════════════════════════════════════
# Emit Complete Mach-O Executable
# ═══════════════════════════════════════════════════════

func macho_emit:
    in(b: MachOBuilder, entry_off_param: int)

    g_mach_buf = b.buf;
    g_mach_text_code = b.text_code;
    if g_mach_buf == 0 do
        g_mach_buf = bvec_new();
    end

    let page = PAGE_SIZE_ARM64;
    let code_size = bvec_len(g_mach_text_code);
    if code_size == 0 do
        code_size = bvec_len(b.text_code);
    end
    if code_size == 0 do
        code_size = codebuf_len();
    end

    # ── Layout: code INLINE on page 0+, LINKEDIT on next page ──
    # 10 load commands:
    #   __PAGEZERO(72) + __TEXT+__text(152) + __LINKEDIT(72)
    #   + CHAINED_FIXUPS(16) + SYMTAB(24) + DYSYMTAB(80)
    #   + LOAD_DYLINKER(32) + UUID(24) + MAIN(24) + LOAD_DYLIB(56)
    let ncmds = 10;
    let sizeofcmds = 552;
    let header_end = 32 + sizeofcmds;

    # 32 bytes padding after LCs — codesign inserts LC_CODE_SIGNATURE here
    let code_offset = header_end + 32;

    # Entry point = file offset of _start within the code
    let entry_file_offset = code_offset + entry_off_param;

    # Calculate __TEXT segment size: must contain header + LCs + pad + code
    # Calculate __TEXT segment size: must contain header + LCs + pad + code
    # Round up to page boundary
    let text_raw_size = code_offset + code_size;
    let text_segment_size = ((text_raw_size + page - 1) / page) * page;

    # LINKEDIT: chained fixups (48 bytes) + string table (4 bytes) = 52 bytes
    let chained_fixups_size = 48;
    let string_table_size = 4;
    let linkedit_data_size = chained_fixups_size + string_table_size;
    let linkedit_fileoff = text_segment_size;
    let linkedit_vmaddr = TEXT_BASE + text_segment_size;
    let strtab_off = linkedit_fileoff + chained_fixups_size;

    if code_size > 65536 do
        code_size = 65536;
    end

    # ── Write Mach-O header ──
    b = macho_write_header(b, ncmds, sizeofcmds);

    # ── 1. __PAGEZERO ──
    b = macho_write_segment(b, "__PAGEZERO", 0, TEXT_BASE, 0, 0, 0, 0, 0);

    # ── 2. __TEXT (header + LCs + code, page-aligned) ──
    b = macho_write_segment(b, "__TEXT",
                            TEXT_BASE, text_segment_size,
                            0, text_segment_size,
                            VM_PROT_READ | VM_PROT_WRITE | VM_PROT_EXECUTE,
                            VM_PROT_READ | VM_PROT_EXECUTE,
                            1);
    b = macho_write_section(b, "__text", "__TEXT",
                            TEXT_BASE + code_offset, code_size, code_offset,
                            2,
                            S_ATTR_PURE_INSTRUCTIONS | S_ATTR_SOME_INSTRUCTIONS);

    # ── 3. __LINKEDIT ──
    b = macho_write_segment(b, "__LINKEDIT",
                            linkedit_vmaddr, page,
                            linkedit_fileoff, linkedit_data_size,
                            VM_PROT_READ,
                            VM_PROT_READ,
                            0);

    # ── 4. LC_DYLD_CHAINED_FIXUPS ──
    g_mach_buf = bvec_push_u32_le(g_mach_buf, LC_DYLD_CHAINED_FIXUPS);
    g_mach_buf = bvec_push_u32_le(g_mach_buf, 16);
    g_mach_buf = bvec_push_u32_le(g_mach_buf, linkedit_fileoff);
    g_mach_buf = bvec_push_u32_le(g_mach_buf, chained_fixups_size);

    # ── 5. LC_SYMTAB ──
    g_mach_buf = bvec_push_u32_le(g_mach_buf, LC_SYMTAB);
    g_mach_buf = bvec_push_u32_le(g_mach_buf, 24);
    g_mach_buf = bvec_push_u32_le(g_mach_buf, strtab_off);
    g_mach_buf = bvec_push_u32_le(g_mach_buf, 0);
    g_mach_buf = bvec_push_u32_le(g_mach_buf, strtab_off);
    g_mach_buf = bvec_push_u32_le(g_mach_buf, string_table_size);

    # ── 6. LC_DYSYMTAB (80 bytes, all zeros after cmd/cmdsize) ──
    g_mach_buf = bvec_push_u32_le(g_mach_buf, LC_DYSYMTAB);
    g_mach_buf = bvec_push_u32_le(g_mach_buf, 80);
    let dsi = 0;
    when dsi < 18 loop
        g_mach_buf = bvec_push_u32_le(g_mach_buf, 0);
        dsi = dsi + 1;
    end

    # ── 7. LC_LOAD_DYLINKER ──
    g_mach_buf = bvec_push_u32_le(g_mach_buf, LC_LOAD_DYLINKER);
    g_mach_buf = bvec_push_u32_le(g_mach_buf, 32);
    g_mach_buf = bvec_push_u32_le(g_mach_buf, 12);
    extern func native_read_u8(addr: int, offset: int) -> int;
    let dyld_path = "/usr/lib/dyld";
    let dyld_len = 13;
    let di = 0;
    when di < 20 loop
        if di < dyld_len do
            g_mach_buf = bvec_push(g_mach_buf, native_read_u8(dyld_path, di));
        else
            g_mach_buf = bvec_push(g_mach_buf, 0);
        end
        di = di + 1;
    end

    # ── 8. LC_UUID (24 bytes) ──
    g_mach_buf = bvec_push_u32_le(g_mach_buf, LC_UUID);
    g_mach_buf = bvec_push_u32_le(g_mach_buf, 24);
    let ui = 1;
    when ui <= 16 loop
        g_mach_buf = bvec_push(g_mach_buf, ui);
        ui = ui + 1;
    end

    # ── 9. LC_MAIN ──
    b = macho_write_lc_main(b, entry_file_offset);

    # ── 10. LC_LOAD_DYLIB ──
    g_mach_buf = bvec_push_u32_le(g_mach_buf, LC_LOAD_DYLIB);
    g_mach_buf = bvec_push_u32_le(g_mach_buf, 56);
    g_mach_buf = bvec_push_u32_le(g_mach_buf, 24);
    g_mach_buf = bvec_push_u32_le(g_mach_buf, 0);
    g_mach_buf = bvec_push_u32_le(g_mach_buf, 0x00010000);
    g_mach_buf = bvec_push_u32_le(g_mach_buf, 0x00010000);
    let dylib_path = "/usr/lib/libSystem.B.dylib";
    let dylib_len = 26;
    let dli = 0;
    when dli < 32 loop
        if dli < dylib_len do
            g_mach_buf = bvec_push(g_mach_buf, native_read_u8(dylib_path, dli));
        else
            g_mach_buf = bvec_push(g_mach_buf, 0);
        end
        dli = dli + 1;
    end

    # ── Pad to code_offset ──
    let current = bvec_len(g_mach_buf);
    when current < code_offset loop
        g_mach_buf = bvec_push(g_mach_buf, 0);
        current = current + 1;
    end

    # ── Write machine code (inline on page 0) ──
    let i = 0;
    when i < code_size loop
        let byte = 0;
        if bvec_len(g_mach_text_code) > 0 do
            byte = bvec_get(g_mach_text_code, i);
        else
            byte = codebuf_get_byte(i);
        end
        g_mach_buf = bvec_push(g_mach_buf, byte);
        i = i + 1;
    end

    # ── Pad to __TEXT segment boundary ──
    current = bvec_len(g_mach_buf);
    when current < text_segment_size loop
        g_mach_buf = bvec_push(g_mach_buf, 0);
        current = current + 1;
    end

    # ── Write LINKEDIT data ──
    g_mach_buf = bvec_push_u32_le(g_mach_buf, 0);
    g_mach_buf = bvec_push_u32_le(g_mach_buf, 28);
    g_mach_buf = bvec_push_u32_le(g_mach_buf, 44);
    g_mach_buf = bvec_push_u32_le(g_mach_buf, 44);
    g_mach_buf = bvec_push_u32_le(g_mach_buf, 0);
    g_mach_buf = bvec_push_u32_le(g_mach_buf, 1);
    g_mach_buf = bvec_push_u32_le(g_mach_buf, 0);
    g_mach_buf = bvec_push_u32_le(g_mach_buf, 3);
    g_mach_buf = bvec_push_u32_le(g_mach_buf, 0);
    g_mach_buf = bvec_push_u32_le(g_mach_buf, 0);
    g_mach_buf = bvec_push_u32_le(g_mach_buf, 0);
    g_mach_buf = bvec_push_u32_le(g_mach_buf, 0);
    g_mach_buf = bvec_push_u32_le(g_mach_buf, 0);

    out macho_builder_out(b);
end.

# ═══════════════════════════════════════════════════════
# Write to disk
# ═══════════════════════════════════════════════════════

func macho_write_to_file:
    in(b: MachOBuilder, path: int)
    let eo = b.entry_offset;
    if eo == 0 do
        eo = g_code_start_offset;
    end
    b = macho_emit(b, eo);
    let data = bvec_data_ptr(g_mach_buf);
    let size = bvec_len(g_mach_buf);
    write_file_bytes(path, data, size, 0o755);
    out true;
end.
# ══ END vir/rt/macho ══

# ══ BEGIN vir/compiler/lexer ══
##
 * vir/compiler/lexer.vri — Vir Source Lexer (Pure Vir)
 * =====================================================
 * UTF-8 tokenizer for Vir v1.2 standard syntax.
 * Converted from C (core/src/lexer.c) for self-hosting.
 *
 * Features:
 *   - Full v1.2 keyword set (English standard)
 *   - Multi-char operators (?=, ?., :~, shr , ||, ->, ..)
 *   - Block comments
 *   - Hex literal support (0x...)
 *   - Paren-depth tracking (suppress newlines inside parens)
 *   - String escape sequences (\n, \t, \\, \", \')
 ##

extern func rt_strlen(s: int) -> int;
extern func rt_streq(a: int; b: int) -> int;

# ═══════════════════════════════════════════════════════
# Token Types (v1.2 Standard)
# ═══════════════════════════════════════════════════════

enum TokType:
    # Literals
    Eof         = 0;
    Error       = 1;
    Int         = 2;
    Float       = 3;
    Str         = 4;
    Ident       = 5;
    Newline     = 6;

    # Definitions
    Func        = 10;
    Var         = 11;
    Const       = 12;
    Entity      = 13;
    Enum        = 14;
    Method      = 15;
    Class       = 16;
    Has         = 17;
    Share       = 18;
    Async       = 19;
    Task        = 20;
    Wait        = 21;
    Extern      = 22;
    TypeKw      = 23;

    # Control flow
    If          = 30;
    Else        = 31;
    Eif         = 32;
    Loop        = 33;
    While       = 34;
    When        = 35;
    For         = 36;
    Break       = 37;
    Skip        = 38;
    Out         = 39;
    Case        = 40;
    End         = 41;
    In          = 42;
    Then        = 43;   # then / do — block opener (C maps both to TOK_THEN)

    # Arithmetic operators
    Plus        = 50;
    Minus       = 51;
    Star        = 52;
    Slash       = 53;
    Percent     = 54;
    Power       = 55;
    Mod         = 56;

    # Comparison operators
    Eq          = 60;
    Ne          = 61;
    Gt          = 62;
    Lt          = 63;
    Ge          = 64;
    Le          = 65;
    SafeEq      = 66;
    SafeNe      = 67;

    # Logical operators
    And         = 70;
    Or          = 71;
    Not         = 72;

    # Bitwise operators
    BitXor      = 75;
    BitShl      = 76;
    BitShr      = 77;
    BitAnd      = 78;
    BitOr       = 79;
    BitNot      = 80;

    # Access / transform
    SafeAccess  = 85;
    Exist       = 86;
    Cast        = 87;
    Pattern     = 88;

    # Assignment
    Assign      = 90;

    # Delimiters
    LParen      = 100;
    RParen      = 101;
    LBracket    = 102;
    RBracket    = 103;
    LBrace      = 104;
    RBrace      = 105;
    Comma       = 106;
    Dot         = 107;
    DotDot      = 108;
    Colon       = 109;
    Semicolon   = 110;
    Arrow       = 111;
    DoubleColon = 112;
    Let         = 113;

    # I/O
    Print       = 120;
    Input       = 121;
    CheckCpu    = 122;
    Patch       = 123;

    # Module
    Import      = 130;
    From        = 131;
    Module      = 132;
    Export      = 133;
    As          = 134;
    Include     = 135;
    Get         = 136;

    # Boolean / None
    True        = 140;
    False       = 141;
    NoneLit     = 142;

    # Error handling
    Try         = 150;
    ErrorKw     = 151;
    MapKw       = 152;
end.


# ═══════════════════════════════════════════════════════
# Token
# ═══════════════════════════════════════════════════════

entity Token:
    tok_type:   TokType;
    line:       int;
    col:        int;
    str_val:    string;
    tok_ival:   int;
    tok_fval:   float;
end.

func token_new_int:
    in(t: TokType, line: int, col: int, val: int)
    out Token {
        tok_type: t,
        line: line,
        col: col,
        str_val: "",
        tok_ival: val,
        tok_fval: 0.0
    };
end.

func token_new_str:
    in(t: TokType, line: int, col: int, s: int)
    out Token {
        tok_type: t,
        line: line,
        col: col,
        str_val: s,
        tok_ival: 0,
        tok_fval: 0.0
    };
end.

func boot_slice:
    in(source: int, start: int, wlen: int)
    if wlen <= 0 do
        let empty = vir_alloc(1);
        native_write_u8(empty, 0, 0);
        out empty;
    end
    result = vir_alloc(wlen + 1);
    native_mem_copy(result, source + start, wlen);
    native_write_u8(result, wlen, 0);
    out result;
end.

func boot_file_size:
    in(path: int)
    fd = sys_open(path, O_RDONLY, 0);
    if fd < 0 do
        out 0;
    end
    end_pos = sys_lseek(fd, 0, 2);
    sys_close(fd);
    out end_pos;
end.

func boot_buf_len:
    in(buf: int)
    if buf == 0 do
        out 0;
    end
    i = 0;
    when i < 1048576 loop
        if native_read_u8(buf, i) == 0 do
            out i;
        end
        i = i + 1;
    end
    out i;
end.

func token_new:
    in(t: TokType, line: int, col: int)
    out Token {
        tok_type: t,
        line: line,
        col: col,
        str_val: "",
        tok_ival: 0,
        tok_fval: 0
    };
end.

# ═══════════════════════════════════════════════════════
# Keyword Lookup Table
# ═══════════════════════════════════════════════════════

entity KeywordEntry:
    word:   string;
    tok:    TokType;
end.

func build_keyword_table:
    table = vec_new_rt();

    # Definition keywords
    table = vec_push_rt(table, KeywordEntry { word: "func", tok: TokType.Func });
    table = vec_push_rt(table, KeywordEntry { word: "function", tok: TokType.Func });
    table = vec_push_rt(table, KeywordEntry { word: "var", tok: TokType.Var });
    table = vec_push_rt(table, KeywordEntry { word: "let", tok: TokType.Var });
    table = vec_push_rt(table, KeywordEntry { word: "const", tok: TokType.Const });
    table = vec_push_rt(table, KeywordEntry { word: "entity", tok: TokType.Entity });
    table = vec_push_rt(table, KeywordEntry { word: "enum", tok: TokType.Enum });
    table = vec_push_rt(table, KeywordEntry { word: "method", tok: TokType.Method });
    table = vec_push_rt(table, KeywordEntry { word: "class", tok: TokType.Class });
    table = vec_push_rt(table, KeywordEntry { word: "has", tok: TokType.Has });
    table = vec_push_rt(table, KeywordEntry { word: "share", tok: TokType.Share });
    table = vec_push_rt(table, KeywordEntry { word: "async", tok: TokType.Async });
    table = vec_push_rt(table, KeywordEntry { word: "task", tok: TokType.Task });
    table = vec_push_rt(table, KeywordEntry { word: "wait", tok: TokType.Wait });
    table = vec_push_rt(table, KeywordEntry { word: "extern", tok: TokType.Extern });
    table = vec_push_rt(table, KeywordEntry { word: "type", tok: TokType.TypeKw });

    # Control flow keywords
    table = vec_push_rt(table, KeywordEntry { word: "if", tok: TokType.If });
    table = vec_push_rt(table, KeywordEntry { word: "else", tok: TokType.Else });
    table = vec_push_rt(table, KeywordEntry { word: "eif", tok: TokType.Eif });
    table = vec_push_rt(table, KeywordEntry { word: "loop", tok: TokType.Loop });
    table = vec_push_rt(table, KeywordEntry { word: "while", tok: TokType.While });
    table = vec_push_rt(table, KeywordEntry { word: "when", tok: TokType.When });
    table = vec_push_rt(table, KeywordEntry { word: "for", tok: TokType.For });
    table = vec_push_rt(table, KeywordEntry { word: "break", tok: TokType.Break });
    table = vec_push_rt(table, KeywordEntry { word: "skip", tok: TokType.Skip });
    table = vec_push_rt(table, KeywordEntry { word: "continue", tok: TokType.Skip });
    table = vec_push_rt(table, KeywordEntry { word: "out", tok: TokType.Out });
    table = vec_push_rt(table, KeywordEntry { word: "return", tok: TokType.Out });
    table = vec_push_rt(table, KeywordEntry { word: "case", tok: TokType.Case });
    table = vec_push_rt(table, KeywordEntry { word: "end", tok: TokType.End });
    table = vec_push_rt(table, KeywordEntry { word: "in", tok: TokType.In });
    table = vec_push_rt(table, KeywordEntry { word: "then", tok: TokType.Then });
    table = vec_push_rt(table, KeywordEntry { word: "do", tok: TokType.Then });

    # I/O keywords
    table = vec_push_rt(table, KeywordEntry { word: "print", tok: TokType.Print });
    table = vec_push_rt(table, KeywordEntry { word: "input", tok: TokType.Input });
    table = vec_push_rt(table, KeywordEntry { word: "check_cpu", tok: TokType.CheckCpu });
    table = vec_push_rt(table, KeywordEntry { word: "patch", tok: TokType.Patch });

    # Boolean / None
    table = vec_push_rt(table, KeywordEntry { word: "true", tok: TokType.True });
    table = vec_push_rt(table, KeywordEntry { word: "false", tok: TokType.False });
    table = vec_push_rt(table, KeywordEntry { word: "none", tok: TokType.NoneLit });

    # Logical
    table = vec_push_rt(table, KeywordEntry { word: "and", tok: TokType.And });
    table = vec_push_rt(table, KeywordEntry { word: "or", tok: TokType.Or });
    table = vec_push_rt(table, KeywordEntry { word: "not", tok: TokType.Not });

    # Bitwise keywords
    table = vec_push_rt(table, KeywordEntry { word: "xor", tok: TokType.BitXor });
    table = vec_push_rt(table, KeywordEntry { word: "shl", tok: TokType.BitShl });
    table = vec_push_rt(table, KeywordEntry { word: "shr", tok: TokType.BitShr });
    table = vec_push_rt(table, KeywordEntry { word: "bit_and", tok: TokType.BitAnd });
    table = vec_push_rt(table, KeywordEntry { word: "bit_or", tok: TokType.BitOr });
    table = vec_push_rt(table, KeywordEntry { word: "mod", tok: TokType.Mod });

    # Module keywords
    table = vec_push_rt(table, KeywordEntry { word: "import", tok: TokType.Import });
    table = vec_push_rt(table, KeywordEntry { word: "from", tok: TokType.From });
    table = vec_push_rt(table, KeywordEntry { word: "module", tok: TokType.Module });
    table = vec_push_rt(table, KeywordEntry { word: "export", tok: TokType.Export });
    table = vec_push_rt(table, KeywordEntry { word: "as", tok: TokType.As });
    table = vec_push_rt(table, KeywordEntry { word: "include", tok: TokType.Include });
    table = vec_push_rt(table, KeywordEntry { word: "get", tok: TokType.Get });

    # Error handling
    table = vec_push_rt(table, KeywordEntry { word: "try", tok: TokType.Try });
    table = vec_push_rt(table, KeywordEntry { word: "error", tok: TokType.ErrorKw });
    table = vec_push_rt(table, KeywordEntry { word: "map", tok: TokType.MapKw });

    # Legacy compatibility
    table = vec_push_rt(table, KeywordEntry { word: "struct", tok: TokType.Entity });
    table = vec_push_rt(table, KeywordEntry { word: "record", tok: TokType.Entity });
    table = vec_push_rt(table, KeywordEntry { word: "elif", tok: TokType.Eif });
    table = vec_push_rt(table, KeywordEntry { word: "then", tok: TokType.End });

    out table;
end.

func lookup_keyword:
    in(table: int, word: string)
    i = 0;
    if table == 0 do
        out TokType.Eof;
    end
    kw_count = vec_len_rt(table);
    when i < kw_count loop
        entry = vec_get_rt(table, i);
        if entry != 0 do
            eq_result = rt_streq(entry.word, word);
            if eq_result do
                out entry.tok;
            end
        end
        i = i + 1;
    end
    out TokType.Eof  # not found;
end.


# ═══════════════════════════════════════════════════════
# Lexer State
# ═══════════════════════════════════════════════════════

entity Lexer:
    source:         string;
    source_len:     int;
    pos:            int;
    line:           int;
    col:            int;
    tokens:         int;
    paren_depth:    int;
    keywords:       int;
    error_msg:          string;
end.

func lexer_new:
    in(source: string)
    init_keywords();
    let slen = g_source_len;
    if slen == 0 do
        slen = rt_strlen(source);
    end
    g_lx_pos = 0;
    g_lx_line = 1;
    g_lx_col = 1;
    g_lx_paren = 0;
    g_lx_tokens = vec_new_rt();
    out Lexer {
        source: source,
        source_len: slen,
        pos: g_lx_pos,
        line: g_lx_line,
        col: g_lx_col,
        tokens: g_lx_tokens,
        paren_depth: g_lx_paren,
        keywords: g_keyword_table,
        error_msg: ""
    };
end.

# ═══════════════════════════════════════════════════════
# Character Helpers
# ═══════════════════════════════════════════════════════

func is_eof:
    in(lex: Lexer)
    slen = g_source_len;
    if slen == 0 do
        slen = lex.source_len;
    end
    out g_lx_pos >= slen;
end.

func lex_peek:
    in(lex: Lexer)
    slen = g_source_len;
    if slen == 0 do
        slen = lex.source_len;
    end
    if g_lx_pos < slen do
        out native_read_u8(lex.source, g_lx_pos);
    end
    out 0;
end.

func lex_peek_at:
    in(lex: Lexer, offset: int)
    p = g_lx_pos + offset;
    slen = g_source_len;
    if slen == 0 do
        slen = lex.source_len;
    end
    if p < slen do
        out native_read_u8(lex.source, p);
    end
    out 0;
end.

func lex_advance:
    in(lex: Lexer)
    c = lex_peek(lex);
    if c == 10 do # '\n' do
        g_lx_line = g_lx_line + 1;
        g_lx_col = 1;
    else
        g_lx_col = g_lx_col + 1;
    end
    g_lx_pos = g_lx_pos + 1;
    out (lex, c);
end.

func is_alpha:
    in(c: int)
    out (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or c == 95;
end.

func is_digit:
    in(c: int)
    out c >= 48 and c <= 57;
end.

func is_hex_digit:
    in(c: int)
    out is_digit(c) or (c >= 65 and c <= 70) or (c >= 97 and c <= 102);
end.

func is_word_char:
    in(c: int)
    out is_alpha(c) or is_digit(c) or c >= 128;
end.


# ═══════════════════════════════════════════════════════
# Skip Whitespace bit_and Comments
# ═══════════════════════════════════════════════════════

func skip_whitespace:
    in(lex: Lexer)
    when not is_eof(lex) loop
        c = lex_peek(lex);
        if c == 32 or c == 9 or c == 13 do # space, tab, CR do
            var (lex2, _) = lex_advance(lex);
            lex = lex2;
        else
            out lex;
        end
    end
    out lex;
end.

func skip_comment:
    in(lex: Lexer)
    # Single-line comment: # ... until \n
    when not is_eof(lex) and lex_peek(lex) != 10 loop
        var (lex2, _) = lex_advance(lex);
        lex = lex2;
    end
    out lex;
end.

func skip_block_comment:
    in(lex: Lexer)
    # Block comment: ## ... ##
    var (lex2, _) = lex_advance(lex)  # skip first #;
    var (lex3, _) = lex_advance(lex2)  # skip second #;
    lex = lex3;
    when not is_eof(lex) loop
        if lex_peek(lex) == 35 and lex_peek_at(lex, 1) == 35 do
            var (lex4, _) = lex_advance(lex);
            var (lex5, _) = lex_advance(lex4);
            out lex5;
        end
        var (lex6, _) = lex_advance(lex);
        lex = lex6;
    end
    out lex;
end.


# ═══════════════════════════════════════════════════════
# Number Lexing
# ═══════════════════════════════════════════════════════

func lex_number:
    in(lex: Lexer)
    tok = token_new(TokType.Int, g_lx_line, g_lx_col);
    num = 0;
    is_float = false;

    # Hex literal
    if lex_peek(lex) == 48 and (lex_peek_at(lex, 1) == 120 or lex_peek_at(lex, 1) == 88) do
        var (lex2, _) = lex_advance(lex)    # 0;
        var (lex3, _) = lex_advance(lex2)   # x;
        lex = lex3;
        when not is_eof(lex) and is_hex_digit(lex_peek(lex)) loop
            c = lex_peek(lex);
            digit = 0;
            if c >= 48 and c <= 57 do
                digit = (c - 48) as int;
            end
            if c >= 65 and c <= 70 do
                digit = (c - 55) as int;
            end
            if c >= 97 and c <= 102 do
                digit = (c - 87) as int;
            end
            num = num * 16 + digit;
            var (lex4, _) = lex_advance(lex);
            lex = lex4;
        end
        tok.tok_ival = num;
        out (lex, tok);
    end

    # Decimal literal (integer or float)
    when not is_eof(lex) and (is_digit(lex_peek(lex)) or lex_peek(lex) == 46) loop
        c = lex_peek(lex);
        if c == 46 do # '.' do
            if is_float do
                # Second dot — stop
                out (lex, tok);
            end
            # Check for .. range operator
            if lex_peek_at(lex, 1) == 46 do
                out (lex, tok);
            end
            is_float = true;
        else
            if not is_float do
                num = num * 10 + (c - 48);
            end
        end
        var (lex2, _) = lex_advance(lex);
        lex = lex2;
    end

    # Parse value from the accumulated string range
    if is_float do
        tok.tok_type = TokType.Float;
    else
        tok.tok_ival = num;
    end

    out (lex, tok);
end.


# ═══════════════════════════════════════════════════════
# String Lexing
# ═══════════════════════════════════════════════════════

func lex_string:
    in(lex: Lexer)
    tok = token_new(TokType.Str, g_lx_line, g_lx_col);
    var (lex2, quote) = lex_advance(lex)  # consume opening quote;
    lex = lex2;
    sb = sb_new();

    when not is_eof(lex) and lex_peek(lex) != quote loop
        if lex_peek(lex) == 92 do # backslash do
            var (lex3, _) = lex_advance(lex);
            lex = lex3;
            if is_eof(lex) do
                tok.str_val = sb_to_string(sb);
                out (lex, tok);
            end
            var (lex4, esc) = lex_advance(lex);
            lex = lex4;
            if esc == 110 do # \n do
                sb = sb_append_char(sb, 10);
            end
            if esc == 116 do # \t do
                sb = sb_append_char(sb, 9);
            end
            if esc == 92 do # \\ do
                sb = sb_append_char(sb, 92);
            end
            if esc == 34 do # \" do
                sb = sb_append_char(sb, 34);
            end
            if esc == 39 do # \' do
                sb = sb_append_char(sb, 39);
            end
        else
            var (lex5, ch) = lex_advance(lex);
            lex = lex5;
            sb = sb_append_char(sb, ch);
        end
    end

    # Consume closing quote
    if not is_eof(lex) do
        var (lex6, _) = lex_advance(lex);
        lex = lex6;
    end

    tok.str_val = sb_to_string(sb);
    out (lex, tok);
end.


# ═══════════════════════════════════════════════════════
# Word / Keyword Lexing
# ═══════════════════════════════════════════════════════

func lex_word:
    in(lex: Lexer)
    start_line = g_lx_line;
    start_col = g_lx_col;
    sb = sb_new();

    when not is_eof(lex) and is_word_char(lex_peek(lex)) loop
        var (lex2, ch) = lex_advance(lex);
        lex = lex2;
        sb = sb_append_char(sb, ch);
    end

    buf = sb_to_string(sb);

    kw_type = lookup_keyword(lex.keywords, buf);
    if kw_type != TokType.Eof do
        tok = token_new(kw_type, start_line, start_col);
        out (lex, tok);
    end

    # Identifier
    tok = token_new(TokType.Ident, start_line, start_col);
    tok.str_val = buf;
    out (lex, tok);
end.


# ═══════════════════════════════════════════════════════
# Bootstrap Tokenizer (flat state, minimal call depth)
# ═══════════════════════════════════════════════════════

func boot_word_str:
    in(source: int, start: int, wlen: int)
    if wlen <= 0 do
        out "";
    end
    out boot_slice(source, start, wlen);
end.

func boot_word_tok:
    in(source: int, start: int, wlen: int)
    let wstr = boot_slice(source, start, wlen);
    let kw = lookup_keyword(g_keyword_table, wstr);
    if kw != TokType.Eof do
        out kw;
    end
    out TokType.Ident;
end.

var g_boot_tokens = 0;
var g_boot_tok_count = 0;
var g_boot_tok_types = 0;
var g_boot_tok_strs = 0;
var g_boot_tok_ivals = 0;
var g_boot_tok_lines = 0;
var g_boot_tok_cols = 0;

func boot_tok_record:
    in(tt: int, line: int, col: int, s: int, ival: int)
    g_boot_tok_types = vec_push_rt(g_boot_tok_types, tt);
    g_boot_tok_strs = vec_push_rt(g_boot_tok_strs, s);
    g_boot_tok_ivals = vec_push_rt(g_boot_tok_ivals, ival);
    g_boot_tok_lines = vec_push_rt(g_boot_tok_lines, line);
    g_boot_tok_cols = vec_push_rt(g_boot_tok_cols, col);
end.

func boot_hex_val:
    in(ch: int)
    if ch >= 48 and ch <= 57 do
        out ch - 48;
    end
    if ch >= 97 and ch <= 102 do
        out ch - 87;
    end
    if ch >= 65 and ch <= 70 do
        out ch - 55;
    end
    out 0 - 1;
end.

func boot_sync_tok_cache:
    g_boot_tok_types = vec_new_rt();
    g_boot_tok_strs = vec_new_rt();
    g_boot_tok_ivals = vec_new_rt();
    g_boot_tok_lines = vec_new_rt();
    g_boot_tok_cols = vec_new_rt();
    let i = 0;
    let n = vec_len_rt(g_compile_tokens);
    when i < n loop
        let t = vec_get_rt(g_compile_tokens, i);
        boot_tok_record(t.tok_type as int, t.line, t.col, t.str_val, t.tok_ival);
        i = i + 1;
    end
    g_boot_tok_count = n;
end.

func boot_tokenize_scan:
    in(lex: Lexer)
    src_ptr = g_read_src;
    if src_ptr == 0 do
        src_ptr = g_source_raw;
    end
    if src_ptr == 0 do
        src_ptr = lex.source;
    end
    slen = g_snap_src_len;
    if slen <= 0 do
        slen = boot_file_size(g_input_path);
    end
    if slen > 1048576 do
        slen = 1048576;
    end
    g_source_len = slen;

    tokens = vec_new_rt();
    g_boot_tok_types = vec_new_rt();
    g_boot_tok_strs = vec_new_rt();
    g_boot_tok_ivals = vec_new_rt();
    g_boot_tok_lines = vec_new_rt();
    g_boot_tok_cols = vec_new_rt();
    if tokens == 0 do
        out Lexer {
            source: src_ptr,
            source_len: slen,
            pos: 0,
            line: 1,
            col: 1,
            tokens: 0,
            paren_depth: 0,
            keywords: g_keyword_table,
            error_msg: "vec_new failed"
        };
    end

    i = 0;
    g_lx_paren = 0;
    when i < slen loop
        c = native_read_u8(src_ptr, i);
        line = g_lx_line;
        col = g_lx_col;

        if c == 32 or c == 9 or c == 13 do
            i = i + 1;
            g_lx_col = g_lx_col + 1;
        eif c == 10 do
            if g_lx_paren == 0 do
                tokens = vec_push_rt(tokens, token_new(TokType.Newline, line, col));
                boot_tok_record(TokType.Newline, line, col, 0, 0);
            end
            i = i + 1;
            g_lx_line = g_lx_line + 1;
            g_lx_col = 1;
        eif c == 58 do # ':'
            if (i + 1) < slen and native_read_u8(src_ptr, i + 1) == 58 do
                tokens = vec_push_rt(tokens, token_new(TokType.DoubleColon, line, col));
                boot_tok_record(TokType.DoubleColon, line, col, 0, 0);
                i = i + 2;
                g_lx_col = g_lx_col + 2;
            else
                tokens = vec_push_rt(tokens, token_new(TokType.Colon, line, col));
                boot_tok_record(TokType.Colon, line, col, 0, 0);
                i = i + 1;
                g_lx_col = g_lx_col + 1;
            end
        eif c == 46 do # '.'
            if (i + 1) < slen and native_read_u8(src_ptr, i + 1) == 46 do
                tokens = vec_push_rt(tokens, token_new(TokType.DotDot, line, col));
                boot_tok_record(TokType.DotDot, line, col, 0, 0);
                i = i + 2;
                g_lx_col = g_lx_col + 2;
            else
                tokens = vec_push_rt(tokens, token_new(TokType.Dot, line, col));
                boot_tok_record(TokType.Dot, line, col, 0, 0);
                i = i + 1;
                g_lx_col = g_lx_col + 1;
            end
        eif c >= 48 and c <= 57 do
            if c == 48 and (i + 1) < slen and native_read_u8(src_ptr, i + 1) == 120 do
                i = i + 2;
                g_lx_col = g_lx_col + 2;
                num = 0;
                when i < slen loop
                    ch = native_read_u8(src_ptr, i);
                    let d = boot_hex_val(ch);
                    if d < 0 do
                        break;
                    end
                    num = num * 16 + d;
                    i = i + 1;
                    g_lx_col = g_lx_col + 1;
                end
                tokens = vec_push_rt(tokens, token_new_int(TokType.Int, line, col, num));
                boot_tok_record(TokType.Int, line, col, 0, num);
            eif c == 48 and (i + 1) < slen and native_read_u8(src_ptr, i + 1) == 111 do
                i = i + 2;
                g_lx_col = g_lx_col + 2;
                num = 0;
                when i < slen loop
                    ch = native_read_u8(src_ptr, i);
                    if ch >= 48 and ch <= 55 do
                        num = num * 8 + (ch - 48);
                        i = i + 1;
                        g_lx_col = g_lx_col + 1;
                    else
                        break;
                    end
                end
                tokens = vec_push_rt(tokens, token_new_int(TokType.Int, line, col, num));
                boot_tok_record(TokType.Int, line, col, 0, num);
            else
                num = 0;
                overflowed = false;
                when i < slen loop
                    ch = native_read_u8(src_ptr, i);
                    if ch >= 48 and ch <= 57 do
                        let dig = ch - 48;
                        # Stop multiplying if next digit would overflow signed i64.
                        if num > 922337203685477580 or (num == 922337203685477580 and dig > 7) do
                            overflowed = true;
                            break;
                        end
                        num = num * 10 + dig;
                        i = i + 1;
                        g_lx_col = g_lx_col + 1;
                    else
                        break;
                    end
                end
                # Float? digit '.' digit [e/E [+/-] digit]
                if (not overflowed) and i < slen and native_read_u8(src_ptr, i) == 46 do
                    let n2 = i + 1;
                    if n2 < slen do
                        let c2 = native_read_u8(src_ptr, n2);
                        if c2 >= 48 and c2 <= 57 do
                            i = i + 1;
                            g_lx_col = g_lx_col + 1;
                            when i < slen loop
                                ch = native_read_u8(src_ptr, i);
                                if ch >= 48 and ch <= 57 do
                                    i = i + 1;
                                    g_lx_col = g_lx_col + 1;
                                else
                                    break;
                                end
                            end
                            # optional exponent
                            if i < slen do
                                let ce = native_read_u8(src_ptr, i);
                                if ce == 101 or ce == 69 do
                                    i = i + 1;
                                    g_lx_col = g_lx_col + 1;
                                    if i < slen do
                                        let cs = native_read_u8(src_ptr, i);
                                        if cs == 43 or cs == 45 do
                                            i = i + 1;
                                            g_lx_col = g_lx_col + 1;
                                        end
                                    end
                                    when i < slen loop
                                        ch = native_read_u8(src_ptr, i);
                                        if ch >= 48 and ch <= 57 do
                                            i = i + 1;
                                            g_lx_col = g_lx_col + 1;
                                        else
                                            break;
                                        end
                                    end
                                end
                            end
                            # Soft float: emit Int 0 (exact float value unused by boot).
                            tokens = vec_push_rt(tokens, token_new_int(TokType.Float, line, col, 0));
                            boot_tok_record(TokType.Float, line, col, 0, 0);
                        else
                            tokens = vec_push_rt(tokens, token_new_int(TokType.Int, line, col, num));
                            boot_tok_record(TokType.Int, line, col, 0, num);
                        end
                    else
                        tokens = vec_push_rt(tokens, token_new_int(TokType.Int, line, col, num));
                        boot_tok_record(TokType.Int, line, col, 0, num);
                    end
                else
                    # Consume remaining digits after overflow (keep truncated value).
                    when overflowed and i < slen loop
                        ch = native_read_u8(src_ptr, i);
                        if ch >= 48 and ch <= 57 do
                            i = i + 1;
                            g_lx_col = g_lx_col + 1;
                        else
                            break;
                        end
                    end
                    tokens = vec_push_rt(tokens, token_new_int(TokType.Int, line, col, num));
                    boot_tok_record(TokType.Int, line, col, 0, num);
                end
            end
        eif (c >= 97 and c <= 122) or (c >= 65 and c <= 90) or c == 95 do
            start = i;
            wlen = 0;
            when i < slen loop
                ch = native_read_u8(src_ptr, i);
                if (ch >= 97 and ch <= 122) or (ch >= 65 and ch <= 90) or (ch >= 48 and ch <= 57) or ch == 95 do
                    wlen = wlen + 1;
                    i = i + 1;
                    g_lx_col = g_lx_col + 1;
                else
                    break;
                end
            end
            tt = boot_word_tok(src_ptr, start, wlen);
            wstr = boot_word_str(src_ptr, start, wlen);
            tokens = vec_push_rt(tokens, token_new_str(tt, line, col, wstr));
            boot_tok_record(tt, line, col, wstr, 0);
        eif c == 43 do # '+'
            tokens = vec_push_rt(tokens, token_new(TokType.Plus, line, col));
            boot_tok_record(TokType.Plus, line, col, 0, 0);
            i = i + 1;
            g_lx_col = g_lx_col + 1;
        eif c == 45 do # '-'
            if (i + 1) < slen and native_read_u8(src_ptr, i + 1) == 62 do
                tokens = vec_push_rt(tokens, token_new(TokType.Arrow, line, col));
                boot_tok_record(TokType.Arrow, line, col, 0, 0);
                i = i + 2;
                g_lx_col = g_lx_col + 2;
            else
                tokens = vec_push_rt(tokens, token_new(TokType.Minus, line, col));
                boot_tok_record(TokType.Minus, line, col, 0, 0);
                i = i + 1;
                g_lx_col = g_lx_col + 1;
            end
        eif c == 42 do # '*'
            tokens = vec_push_rt(tokens, token_new(TokType.Star, line, col));
            boot_tok_record(TokType.Star, line, col, 0, 0);
            i = i + 1;
            g_lx_col = g_lx_col + 1;
        eif c == 47 do # '/'
            tokens = vec_push_rt(tokens, token_new(TokType.Slash, line, col));
            boot_tok_record(TokType.Slash, line, col, 0, 0);
            i = i + 1;
            g_lx_col = g_lx_col + 1;
        eif c == 37 do # '%'
            tokens = vec_push_rt(tokens, token_new(TokType.Percent, line, col));
            boot_tok_record(TokType.Percent, line, col, 0, 0);
            i = i + 1;
            g_lx_col = g_lx_col + 1;
        eif c == 61 do # '='
            if (i + 1) < slen and native_read_u8(src_ptr, i + 1) == 61 do
                tokens = vec_push_rt(tokens, token_new(TokType.Eq, line, col));
                boot_tok_record(TokType.Eq, line, col, 0, 0);
                i = i + 2;
                g_lx_col = g_lx_col + 2;
            else
                tokens = vec_push_rt(tokens, token_new(TokType.Assign, line, col));
                boot_tok_record(TokType.Assign, line, col, 0, 0);
                i = i + 1;
                g_lx_col = g_lx_col + 1;
            end
        eif c == 35 do # '#'
            if (i + 1) < slen and native_read_u8(src_ptr, i + 1) == 35 do
                i = i + 2;
                when i < slen loop
                    if (i + 1) < slen and native_read_u8(src_ptr, i) == 35 and native_read_u8(src_ptr, i + 1) == 35 do
                        i = i + 2;
                        break;
                    end
                    i = i + 1;
                end
            else
                when i < slen loop
                    let ch = native_read_u8(src_ptr, i);
                    if ch == 10 do
                        break;
                    end
                    i = i + 1;
                end
            end
        eif c == 40 do
            tokens = vec_push_rt(tokens, token_new(TokType.LParen, line, col));
            boot_tok_record(TokType.LParen, line, col, 0, 0);
            g_lx_paren = g_lx_paren + 1;
            i = i + 1;
            g_lx_col = g_lx_col + 1;
        eif c == 41 do
            tokens = vec_push_rt(tokens, token_new(TokType.RParen, line, col));
            boot_tok_record(TokType.RParen, line, col, 0, 0);
            if g_lx_paren > 0 do
                g_lx_paren = g_lx_paren - 1;
            end
            i = i + 1;
            g_lx_col = g_lx_col + 1;
        eif c == 123 do
            tokens = vec_push_rt(tokens, token_new(TokType.LBrace, line, col));
            boot_tok_record(TokType.LBrace, line, col, 0, 0);
            i = i + 1;
            g_lx_col = g_lx_col + 1;
        eif c == 125 do
            tokens = vec_push_rt(tokens, token_new(TokType.RBrace, line, col));
            boot_tok_record(TokType.RBrace, line, col, 0, 0);
            i = i + 1;
            g_lx_col = g_lx_col + 1;
        eif c == 91 do
            tokens = vec_push_rt(tokens, token_new(TokType.LBracket, line, col));
            boot_tok_record(TokType.LBracket, line, col, 0, 0);
            g_lx_paren = g_lx_paren + 1;
            i = i + 1;
            g_lx_col = g_lx_col + 1;
        eif c == 93 do
            tokens = vec_push_rt(tokens, token_new(TokType.RBracket, line, col));
            boot_tok_record(TokType.RBracket, line, col, 0, 0);
            if g_lx_paren > 0 do
                g_lx_paren = g_lx_paren - 1;
            end
            i = i + 1;
            g_lx_col = g_lx_col + 1;
        eif c == 59 do
            tokens = vec_push_rt(tokens, token_new(TokType.Semicolon, line, col));
            boot_tok_record(TokType.Semicolon, line, col, 0, 0);
            i = i + 1;
            g_lx_col = g_lx_col + 1;
        eif c == 44 do
            tokens = vec_push_rt(tokens, token_new(TokType.Comma, line, col));
            boot_tok_record(TokType.Comma, line, col, 0, 0);
            i = i + 1;
            g_lx_col = g_lx_col + 1;
        eif c == 34 do
            let ss = i + 1;
            i = i + 1;
            when i < slen loop
                let ch = native_read_u8(src_ptr, i);
                if ch == 34 do
                    break;
                end
                i = i + 1;
            end
            let sl = i - ss;
            let sval = boot_slice(src_ptr, ss, sl);
            tokens = vec_push_rt(tokens, token_new_str(TokType.Str, line, col, sval));
            boot_tok_record(TokType.Str, line, col, sval, 0);
            if i < slen do
                i = i + 1;
            end
            g_lx_col = g_lx_col + 1;
        eif c == 39 do # char literal 'x' -> Int (char code)
            i = i + 1;
            g_lx_col = g_lx_col + 1;
            cval = 0;
            if i < slen do
                let c0 = native_read_u8(src_ptr, i);
                if c0 == 92 do
                    i = i + 1;
                    g_lx_col = g_lx_col + 1;
                    let ce = native_read_u8(src_ptr, i);
                    if ce == 110 do
                        cval = 10;
                    eif ce == 116 do
                        cval = 9;
                    eif ce == 114 do
                        cval = 13;
                    eif ce == 48 do
                        cval = 0;
                    else
                        cval = ce;
                    end
                    i = i + 1;
                    g_lx_col = g_lx_col + 1;
                else
                    cval = c0;
                    i = i + 1;
                    g_lx_col = g_lx_col + 1;
                end
            end
            if i < slen and native_read_u8(src_ptr, i) == 39 do
                i = i + 1;
                g_lx_col = g_lx_col + 1;
            end
            tokens = vec_push_rt(tokens, token_new_int(TokType.Int, line, col, cval));
            boot_tok_record(TokType.Int, line, col, 0, cval);
        eif c == 62 do
            if (i + 1) < slen and native_read_u8(src_ptr, i + 1) == 61 do
                tokens = vec_push_rt(tokens, token_new(TokType.Ge, line, col));
                boot_tok_record(TokType.Ge, line, col, 0, 0);
                i = i + 2;
                g_lx_col = g_lx_col + 2;
            else
                tokens = vec_push_rt(tokens, token_new(TokType.Gt, line, col));
                boot_tok_record(TokType.Gt, line, col, 0, 0);
                i = i + 1;
                g_lx_col = g_lx_col + 1;
            end
        eif c == 60 do
            if (i + 1) < slen and native_read_u8(src_ptr, i + 1) == 61 do
                tokens = vec_push_rt(tokens, token_new(TokType.Le, line, col));
                boot_tok_record(TokType.Le, line, col, 0, 0);
                i = i + 2;
                g_lx_col = g_lx_col + 2;
            else
                tokens = vec_push_rt(tokens, token_new(TokType.Lt, line, col));
                boot_tok_record(TokType.Lt, line, col, 0, 0);
                i = i + 1;
                g_lx_col = g_lx_col + 1;
            end
        eif c == 33 do
            if (i + 1) < slen and native_read_u8(src_ptr, i + 1) == 61 do
                tokens = vec_push_rt(tokens, token_new(TokType.Ne, line, col));
                boot_tok_record(TokType.Ne, line, col, 0, 0);
                i = i + 2;
                g_lx_col = g_lx_col + 2;
            else
                tokens = vec_push_rt(tokens, token_new(TokType.Not, line, col));
                boot_tok_record(TokType.Not, line, col, 0, 0);
                i = i + 1;
                g_lx_col = g_lx_col + 1;
            end
        eif c == 124 do # '|'
            if (i + 1) < slen and native_read_u8(src_ptr, i + 1) == 124 do
                tokens = vec_push_rt(tokens, token_new(TokType.Or, line, col));
                boot_tok_record(TokType.Or, line, col, 0, 0);
                i = i + 2;
                g_lx_col = g_lx_col + 2;
            else
                tokens = vec_push_rt(tokens, token_new(TokType.BitOr, line, col));
                boot_tok_record(TokType.BitOr, line, col, 0, 0);
                i = i + 1;
                g_lx_col = g_lx_col + 1;
            end
        eif c == 38 do # '&'
            if (i + 1) < slen and native_read_u8(src_ptr, i + 1) == 38 do
                tokens = vec_push_rt(tokens, token_new(TokType.And, line, col));
                boot_tok_record(TokType.And, line, col, 0, 0);
                i = i + 2;
                g_lx_col = g_lx_col + 2;
            else
                tokens = vec_push_rt(tokens, token_new(TokType.BitAnd, line, col));
                boot_tok_record(TokType.BitAnd, line, col, 0, 0);
                i = i + 1;
                g_lx_col = g_lx_col + 1;
            end
        eif c == 94 do # '^'
            tokens = vec_push_rt(tokens, token_new(TokType.BitXor, line, col));
            boot_tok_record(TokType.BitXor, line, col, 0, 0);
            i = i + 1;
            g_lx_col = g_lx_col + 1;
        eif c == 126 do # '~'
            tokens = vec_push_rt(tokens, token_new(TokType.BitNot, line, col));
            boot_tok_record(TokType.BitNot, line, col, 0, 0);
            i = i + 1;
            g_lx_col = g_lx_col + 1;
        else
            i = i + 1;
            g_lx_col = g_lx_col + 1;
        end
    end

    g_lx_pos = i;
    tokens = vec_push_rt(tokens, token_new(TokType.Eof, g_lx_line, g_lx_col));
    boot_tok_record(TokType.Eof, g_lx_line, g_lx_col, 0, 0);
    g_boot_tok_count = vec_len_rt(tokens);
    g_lx_tokens = tokens;
    g_boot_tokens = tokens;
    out Lexer {
        source: src_ptr,
        source_len: slen,
        pos: g_lx_pos,
        line: g_lx_line,
        col: g_lx_col,
        tokens: tokens,
        paren_depth: g_lx_paren,
        keywords: g_keyword_table,
        error_msg: ""
    };
end.

# ═══════════════════════════════════════════════════════
# Main Tokenize Loop
# ═══════════════════════════════════════════════════════

func tokenize:
    in(lex: Lexer)
    out boot_tokenize_scan(lex);
end.

func tokenize_full:
    in(lex: Lexer)
    prev_was_newline = true;

    when not is_eof(lex) loop
        lex = skip_whitespace(lex);
        if is_eof(lex) do
            out lex;
        end

        c = lex_peek(lex);

        # Newline (statement separator)
        if c == 10 do
            var (lex2, _) = lex_advance(lex);
            lex = lex2;
            if not prev_was_newline and g_lx_paren == 0 do
                g_lx_tokens = vec_push_rt(g_lx_tokens, token_new(TokType.Newline, g_lx_line, g_lx_col));
                prev_was_newline = true;
            end
            skip  # continue;
        end

        prev_was_newline = false;

        # Comment
        if c == 35 do # '#' do
            if lex_peek_at(lex, 1) == 35 do
                lex = skip_block_comment(lex);
            else
                lex = skip_comment(lex);
            end
            skip;
        end

        # String literal
        if c == 34 or c == 39 do # " or ' do
            var (lex2, tok) = lex_string(lex);
            lex = lex2;
            g_lx_tokens = vec_push_rt(g_lx_tokens, tok);
            skip;
        end

        # Number literal
        if is_digit(c) do
            var (lex2, tok) = lex_number(lex);
            lex = lex2;
            g_lx_tokens = vec_push_rt(g_lx_tokens, tok);
            skip;
        end

        # Multi-char operators
        c2 = lex_peek_at(lex, 1);

        if c == 61 and c2 == 61 do # == do
            tok = token_new(TokType.Eq, g_lx_line, g_lx_col);
            var (l1, _) = lex_advance(lex);
            var (l2, _) = lex_advance(l1);
            lex = l2;
            g_lx_tokens = vec_push_rt(g_lx_tokens, tok);
            skip;
        end

        if c == 33 and c2 == 61 do # != do
            tok = token_new(TokType.Ne, g_lx_line, g_lx_col);
            var (l1, _) = lex_advance(lex);
            var (l2, _) = lex_advance(l1);
            lex = l2;
            g_lx_tokens = vec_push_rt(g_lx_tokens, tok);
            skip;
        end

        if c == 62 and c2 == 61 do # >= do
            tok = token_new(TokType.Ge, g_lx_line, g_lx_col);
            var (l1, _) = lex_advance(lex);
            var (l2, _) = lex_advance(l1);
            lex = l2;
            g_lx_tokens = vec_push_rt(g_lx_tokens, tok);
            skip;
        end

        if c == 60 and c2 == 61 do # <= do
            tok = token_new(TokType.Le, g_lx_line, g_lx_col);
            var (l1, _) = lex_advance(lex);
            var (l2, _) = lex_advance(l1);
            lex = l2;
            g_lx_tokens = vec_push_rt(g_lx_tokens, tok);
            skip;
        end

        # ?=/= (safe not-equal — 4 chars)
        if c == 63 and c2 == 61 and lex_peek_at(lex, 2) == 47 and lex_peek_at(lex, 3) == 61 do
            tok = token_new(TokType.SafeNe, g_lx_line, g_lx_col);
            var (l1, _) = lex_advance(lex);
            var (l2, _) = lex_advance(l1);
            var (l3, _) = lex_advance(l2);
            var (l4, _) = lex_advance(l3);
            lex = l4;
            g_lx_tokens = vec_push_rt(g_lx_tokens, tok);
            skip;
        end

        # ?= (safe equal)
        if c == 63 and c2 == 61 do
            tok = token_new(TokType.SafeEq, g_lx_line, g_lx_col);
            var (l1, _) = lex_advance(lex);
            var (l2, _) = lex_advance(l1);
            lex = l2;
            g_lx_tokens = vec_push_rt(g_lx_tokens, tok);
            skip;
        end

        # ?. (safe member access)
        if c == 63 and c2 == 46 do
            tok = token_new(TokType.SafeAccess, g_lx_line, g_lx_col);
            var (l1, _) = lex_advance(lex);
            var (l2, _) = lex_advance(l1);
            lex = l2;
            g_lx_tokens = vec_push_rt(g_lx_tokens, tok);
            skip;
        end

        # :~ (pattern match)
        if c == 58 and c2 == 126 do
            tok = token_new(TokType.Pattern, g_lx_line, g_lx_col);
            var (l1, _) = lex_advance(lex);
            var (l2, _) = lex_advance(l1);
            lex = l2;
            g_lx_tokens = vec_push_rt(g_lx_tokens, tok);
            skip;
        end

        # || (logical OR)
        if c == 124 and c2 == 124 do
            tok = token_new(TokType.Or, g_lx_line, g_lx_col);
            var (l1, _) = lex_advance(lex);
            var (l2, _) = lex_advance(l1);
            lex = l2;
            g_lx_tokens = vec_push_rt(g_lx_tokens, tok);
            skip;
        end

        # -> (arrow)
        if c == 45 and c2 == 62 do
            tok = token_new(TokType.Arrow, g_lx_line, g_lx_col);
            var (l1, _) = lex_advance(lex);
            var (l2, _) = lex_advance(l1);
            lex = l2;
            g_lx_tokens = vec_push_rt(g_lx_tokens, tok);
            skip;
        end

        # shl (bit shift left)
        if c == 60 and c2 == 60 do
            tok = token_new(TokType.BitShl, g_lx_line, g_lx_col);
            var (l1, _) = lex_advance(lex);
            var (l2, _) = lex_advance(l1);
            lex = l2;
            g_lx_tokens = vec_push_rt(g_lx_tokens, tok);
            skip;
        end

        # shr (cast in v1.2)
        if c == 62 and c2 == 62 do
            tok = token_new(TokType.Cast, g_lx_line, g_lx_col);
            var (l1, _) = lex_advance(lex);
            var (l2, _) = lex_advance(l1);
            lex = l2;
            g_lx_tokens = vec_push_rt(g_lx_tokens, tok);
            skip;
        end

        # :: (qualified path)
        if c == 58 and c2 == 58 do
            tok = token_new(TokType.DoubleColon, g_lx_line, g_lx_col);
            var (l1, _) = lex_advance(lex);
            var (l2, _) = lex_advance(l1);
            lex = l2;
            g_lx_tokens = vec_push_rt(g_lx_tokens, tok);
            skip;
        end

        # .. (range)
        if c == 46 and c2 == 46 do
            tok = token_new(TokType.DotDot, g_lx_line, g_lx_col);
            var (l1, _) = lex_advance(lex);
            var (l2, _) = lex_advance(l1);
            lex = l2;
            g_lx_tokens = vec_push_rt(g_lx_tokens, tok);
            skip;
        end

        # Single-char operators
        single_tok = TokType.Eof;
        if c == 43 do
            single_tok = TokType.Plus;
        end
        if c == 45 and single_tok == TokType.Eof do
            single_tok = TokType.Minus;
        end
        if c == 42 do
            single_tok = TokType.Star;
        end
        if c == 47 do
            single_tok = TokType.Slash;
        end
        if c == 37 do
            single_tok = TokType.Percent;
        end
        if c == 94 do
            single_tok = TokType.Power;
        end
        if c == 61 and single_tok == TokType.Eof do
            single_tok = TokType.Assign;
        end
        if c == 62 and single_tok == TokType.Eof do
            single_tok = TokType.Gt;
        end
        if c == 60 and single_tok == TokType.Eof do
            single_tok = TokType.Lt;
        end
        if c == 33 and single_tok == TokType.Eof do
            single_tok = TokType.Not;
        end
        if c == 63 and single_tok == TokType.Eof do
            single_tok = TokType.Exist;
        end
        if c == 38 do
            single_tok = TokType.And;
        end
        if c == 124 and single_tok == TokType.Eof do
            single_tok = TokType.BitOr;
        end
        if c == 126 do
            single_tok = TokType.BitNot;
        end

        # Delimiters
        if c == 40 do
            single_tok = TokType.LParen;
            g_lx_paren = g_lx_paren + 1;
        end
        if c == 41 do
            single_tok = TokType.RParen;
            if g_lx_paren > 0 do
                g_lx_paren = g_lx_paren - 1;
            end
        end
        if c == 91 do
            single_tok = TokType.LBracket;
            g_lx_paren = g_lx_paren + 1;
        end
        if c == 93 do
            single_tok = TokType.RBracket;
            if g_lx_paren > 0 do
                g_lx_paren = g_lx_paren - 1;
            end
        end
        if c == 123 do
            single_tok = TokType.LBrace;
            g_lx_paren = g_lx_paren + 1;
        end
        if c == 125 do
            single_tok = TokType.RBrace;
            if g_lx_paren > 0 do
                g_lx_paren = g_lx_paren - 1;
            end
        end
        if c == 44 do
            single_tok = TokType.Comma;
        end
        if c == 46 and single_tok == TokType.Eof do
            single_tok = TokType.Dot;
        end
        if c == 58 and single_tok == TokType.Eof do
            single_tok = TokType.Colon;
        end
        if c == 59 do
            single_tok = TokType.Semicolon;
        end

        if single_tok != TokType.Eof do
            tok = token_new(single_tok, g_lx_line, g_lx_col);
            var (lex2, _) = lex_advance(lex);
            lex = lex2;
            g_lx_tokens = vec_push_rt(g_lx_tokens, tok);
            skip;
        end

        # Word (keyword / identifier)
        if is_word_char(c) do
            var (lex2, tok) = lex_word(lex);
            lex = lex2;
            g_lx_tokens = vec_push_rt(g_lx_tokens, tok);
            skip;
        end

        # Unknown character — skip
        var (lex2, _) = lex_advance(lex);
        lex = lex2;
    end

    # Push sentinel EOF token
    g_lx_tokens = vec_push_rt(g_lx_tokens, token_new(TokType.Eof, g_lx_line, g_lx_col));
    out Lexer {
        source: g_source_raw,
        source_len: g_source_len,
        pos: g_lx_pos,
        line: g_lx_line,
        col: g_lx_col,
        tokens: g_lx_tokens,
        paren_depth: g_lx_paren,
        keywords: g_keyword_table,
        error_msg: ""
    };
end.


# ═══════════════════════════════════════════════════════
# Token Name (for debug / error messages)
# ═══════════════════════════════════════════════════════

func token_name:
    in(t: TokType)
    if t == TokType.Eof do
        out "EOF";
    end
    if t == TokType.Int do
        out "INT";
    end
    if t == TokType.Float do
        out "FLOAT";
    end
    if t == TokType.Str do
        out "STRING";
    end
    if t == TokType.Ident do
        out "IDENT";
    end
    if t == TokType.Newline do
        out "NEWLINE";
    end
    if t == TokType.Func do
        out "FUNC";
    end
    if t == TokType.Var do
        out "VAR";
    end
    if t == TokType.Const do
        out "CONST";
    end
    if t == TokType.Entity do
        out "ENTITY";
    end
    if t == TokType.Enum do
        out "ENUM";
    end
    if t == TokType.If do
        out "IF";
    end
    if t == TokType.Else do
        out "ELSE";
    end
    if t == TokType.End do
        out "END";
    end
    if t == TokType.Out do
        out "OUT";
    end
    if t == TokType.While do
        out "WHILE";
    end
    if t == TokType.Break do
        out "BREAK";
    end
    if t == TokType.Skip do
        out "SKIP";
    end
    out "???";
end.
# ══ END vir/compiler/lexer ══

# ══ BEGIN vir/compiler/parser ══
##
 * vir/compiler/parser.vri — Recursive-Descent Parser (Pure Vir)
 * ==============================================================
 * Produces AST trees from a token stream.
 * Converted from C (core/src/parser.c) for self-hosting.
 *
 * Grammar (keyword-delimited blocks):
 *
 *   program     → (func_def | statement)* EOF
 *   func_def    → FUNC IDENT '(' params ')' block END
 *   params      → (IDENT (',' IDENT)*)?
 *   block       → statement*
 *   statement   → var_decl | const_decl | if_stmt | loop_stmt
 *               | while_stmt | return_stmt | print_stmt
 *               | for_range | enum_def | entity_def
 *               | assign_or_expr | NEWLINE
 *   expr        → or_expr
 *   or_expr     → and_expr (OR and_expr)*
 *   and_expr    → compare (AND compare)*
 *   compare     → bitwise ((EQ|NE|GT|LT|GE|LE) bitwise)?
 *   bitwise     → addition ((SHL|SHR|XOR|BIT_AND|BIT_OR) addition)*
 *   addition    → mult ((PLUS|MINUS) mult)*
 *   mult        → unary ((STAR|SLASH|PERCENT) unary)*
 *   unary       → (MINUS|NOT) unary | postfix
 *   postfix     → primary ('.' IDENT | '[' expr ']' | '(' args ')')*
 *   primary     → INT | FLOAT | STRING | TRUE | FALSE | NONE
 *               | IDENT | '(' expr ')' | '[' elems ']' | INPUT
 ##




# ═══════════════════════════════════════════════════════
# AST Node Types
# ═══════════════════════════════════════════════════════

enum AstType:
    Program         = 0;
    Block           = 1;
    FuncDef         = 2;
    VarDecl         = 3;
    ConstDecl       = 4;
    Assign          = 5;
    IndexAssign     = 6;
    FieldAssign     = 7;
    IfStmt          = 8;
    LoopStmt        = 9;
    WhileStmt       = 10;
    ForRange        = 11;
    ReturnStmt      = 12;
    PrintStmt       = 13;
    BreakStmt       = 14;
    ContinueStmt    = 15;
    EnumDef         = 16;
    EntityDef       = 17;
    ImportStmt      = 18;
    ModuleStmt      = 19;
    ExportStmt      = 20;
    IncludeStmt     = 21;
    LiteralInt      = 30;
    LiteralFloat    = 31;
    LiteralStr      = 32;
    Identifier      = 33;
    BinOp           = 34;
    Compare         = 35;
    Call            = 36;
    BuiltinCall     = 37;
    InputExpr       = 38;
    ArrayLiteral    = 39;
    IndexAccess     = 40;
    FieldAccess     = 41;
    EnumAccess      = 42;
    EntityLiteral   = 43;
    CheckCpu        = 50;
    PatchPoint      = 51;
    ExternFunc      = 52;
    WhenStmt        = 53;
    CastExpr        = 54;
    UnaryMinus      = 55;
    ExprIndex       = 56;
    TupleExpr       = 57;
    CaseStmt        = 58;
    PatternMatch    = 59;
    TypeDecl        = 60;
end.


# ═══════════════════════════════════════════════════════
# Operator Types
# ═══════════════════════════════════════════════════════

enum OpType:
    Add     = 0;
    Sub     = 1;
    Mul     = 2;
    Div     = 3;
    ModOp   = 4;
    Eq      = 10;
    Ne      = 11;
    Gt      = 12;
    Lt      = 13;
    Ge      = 14;
    Le      = 15;
    AndOp   = 20;
    OrOp    = 21;
    XorOp   = 22;
    ShlOp   = 23;
    ShrOp   = 24;
end.


# ═══════════════════════════════════════════════════════
# AST Node
# ═══════════════════════════════════════════════════════

entity AstNode:
    name:           string;
    name2:          string;
    node_type:      AstType;
    op:             OpType;
    line:           int;
    int_val:        int;
    float_val:      float;
    builtin_id:     int;
    children:       int;
end.

func ast_new:
    in(typ: AstType)
    out AstNode {
        name:       "",
        name2:      "",
        node_type:  typ,
        op:         OpType::Add,
        line:       0,
        int_val:    0,
        float_val:  0.0,
        builtin_id: 0,
        children:   vec_new_rt()
    };
end.

var g_ast_children_acc = 0;
var g_boot_prog_count = 0;
var g_ast_node_types = 0;
var g_ast_child_names = 0;
var g_block_child_types = 0;
var g_block_child_names = 0;
var g_block_init_const = 0;
var g_boot_last_vreg = 0 - 1;
var g_boot_name_cell = 0;   # heap i64[2]: [0]=var_name, [1]=print_name (native)
var g_boot_nvreg_cell = 0;  # native next-vreg counter (LowerCtx.next_vreg unreliable)

func boot_name_cell_init:
    extern func native_write_i64(addr: int, offset: int, val: int);
    if g_boot_name_cell == 0 do
        g_boot_name_cell = heap_alloc(256);
    end
    native_write_i64(g_boot_name_cell, 0, 0);
    native_write_i64(g_boot_name_cell, 8, 0);
    native_write_i64(g_boot_name_cell, 16, 0 - 1);
    native_write_i64(g_boot_name_cell, 24, 0);
    native_write_i64(g_boot_name_cell, 32, 0);
    native_write_i64(g_boot_name_cell, 40, 0);
    native_write_i64(g_boot_name_cell, 48, 0);
    native_write_i64(g_boot_name_cell, 56, 0 - 1);
    native_write_i64(g_boot_name_cell, 64, 0);
end.

func boot_set_var_name:
    in(nm: int)
    extern func native_write_i64(addr: int, offset: int, val: int);
    if g_boot_name_cell == 0 do
        boot_name_cell_init();
    end
    native_write_i64(g_boot_name_cell, 0, nm);
    g_boot_var_name = nm;
end.

func boot_get_var_name:
    extern func native_read_i64(addr: int, offset: int) -> int;
    if g_boot_name_cell == 0 do
        out g_boot_var_name;
    end
    out native_read_i64(g_boot_name_cell, 0);
end.

func boot_set_print_name:
    in(nm: int)
    extern func native_write_i64(addr: int, offset: int, val: int);
    if g_boot_name_cell == 0 do
        boot_name_cell_init();
    end
    native_write_i64(g_boot_name_cell, 8, nm);
    g_boot_print_name = nm;
end.

func boot_get_print_name:
    extern func native_read_i64(addr: int, offset: int) -> int;
    if g_boot_name_cell == 0 do
        out g_boot_print_name;
    end
    out native_read_i64(g_boot_name_cell, 8);
end.

var g_boot_vmap_names = 0;
var g_boot_vmap_vregs = 0;
var g_boot_vmap_count = 0;

func boot_vmap_reset:
    extern func native_write_i64(addr: int, offset: int, val: int);
    if g_boot_vmap_names == 0 do
        g_boot_vmap_names = heap_alloc(256);
        g_boot_vmap_vregs = heap_alloc(256);
    end
    g_boot_vmap_count = 0;
end.

func boot_vmap_put:
    in(nm: int, vr: int)
    extern func native_write_i64(addr: int, offset: int, val: int);
    extern func native_read_i64(addr: int, offset: int) -> int;
    # Needed for print-of-local under body-dump (self-host dump has
    # small_multi=0; AstNode.name is unreliable on C VM so vmap is the
    # reliable Ident→vreg path when parse scratch sets print/var names).
    if g_boot_flat_active == 0 and g_boot_small_multi == 0 and boot_bd_dump_on() == 0 do
        out;
    end
    if g_boot_vmap_names == 0 do
        boot_vmap_reset();
    end
    if nm == 0 do
        out;
    end
    let n = g_boot_vmap_count;
    if n < 0 or n > 32 do
        n = 0;
        g_boot_vmap_count = 0;
    end
    let i = 0;
    when i < n loop
        if native_read_i64(g_boot_vmap_names, i * 8) == nm do
            native_write_i64(g_boot_vmap_vregs, i * 8, vr);
            out;
        end
        i = i + 1;
    end
    if n < 32 do
        native_write_i64(g_boot_vmap_names, n * 8, nm);
        native_write_i64(g_boot_vmap_vregs, n * 8, vr);
        g_boot_vmap_count = n + 1;
    end
end.

func boot_vmap_get:
    in(nm: int)
    extern func native_read_i64(addr: int, offset: int) -> int;
    if nm == 0 or g_boot_vmap_names == 0 do
        out 0 - 1;
    end
    let n = g_boot_vmap_count;
    if n < 0 or n > 32 do
        out 0 - 1;
    end
    let i = 0;
    when i < n loop
        let en = native_read_i64(g_boot_vmap_names, i * 8);
        if en == nm do
            out native_read_i64(g_boot_vmap_vregs, i * 8);
        end
        if rt_streq(en, nm) do
            out native_read_i64(g_boot_vmap_vregs, i * 8);
        end
        i = i + 1;
    end
    out 0 - 1;
end.

func boot_set_binop_lhs:
    in(nm: int)
    extern func native_write_i64(addr: int, offset: int, val: int);
    if g_boot_name_cell == 0 do
        boot_name_cell_init();
    end
    native_write_i64(g_boot_name_cell, 192, nm);
end.

func boot_get_binop_lhs:
    extern func native_read_i64(addr: int, offset: int) -> int;
    if g_boot_name_cell == 0 do
        out 0;
    end
    out native_read_i64(g_boot_name_cell, 192);
end.

