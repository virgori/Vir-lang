# Minimal tokenizer test

var src = ""
var src_len = 0
var pos = 0

var T_EOF = 0
var T_INT = 1
var T_IDENT = 2
var T_PLUS = 13
var T_EQ = 24

var toks = []
var tok_count = 0

func is_alpha(c) then
    if c >= 65 then
        if c <= 90 then
            return 1
        end
    end
    if c >= 97 then
        if c <= 122 then
            return 1
        end
    end
    if c == 95 then
        return 1
    end
    return 0
end

func is_digit(c) then
    if c >= 48 then
        if c <= 57 then
            return 1
        end
    end
    return 0
end

func skip_ws() then
    while pos < src_len then
        var c = str_get(src, pos)
        if c == 32 then
            pos = pos + 1
        else
            if c == 10 then
                pos = pos + 1
            else
                return 0
            end
        end
    end
    return 0
end

func lex_num() then
    var n = 0
    while pos < src_len then
        var d = str_get(src, pos)
        if is_digit(d) == 0 then
            return n
        end
        n = n * 10 + d - 48
        pos = pos + 1
    end
    return n
end

func char_to_str(c) then
    var buf = alloc(2)
    write_byte(buf, 0, c)
    write_byte(buf, 1, 0)
    var s = str_cat("", buf)
    dealloc(buf)
    return s
end

func lex_id() then
    var w = ""
    while pos < src_len then
        var d = str_get(src, pos)
        var ok = is_alpha(d)
        if ok == 0 then
            ok = is_digit(d)
        end
        if ok == 0 then
            return w
        end
        w = str_cat(w, char_to_str(d))
        pos = pos + 1
    end
    return w
end

func lex_one() then
    skip_ws()
    if pos >= src_len then
        push(toks, T_EOF)
        tok_count = tok_count + 1
        return 0
    end
    var c = str_get(src, pos)
    if is_digit(c) == 1 then
        var n = lex_num()
        print_str("INT ")
        print n
        push(toks, T_INT)
        tok_count = tok_count + 1
        return 1
    end
    if is_alpha(c) == 1 then
        var w = lex_id()
        print_str("ID ")
        print_str(w)
        print_str("\n")
        push(toks, T_IDENT)
        tok_count = tok_count + 1
        return 1
    end
    if c == 43 then
        pos = pos + 1
        print_str("PLUS\n")
        push(toks, T_PLUS)
        tok_count = tok_count + 1
        return 1
    end
    if c == 61 then
        pos = pos + 1
        print_str("EQ\n")
        push(toks, T_EQ)
        tok_count = tok_count + 1
        return 1
    end
    print_str("SKIP ")
    print c
    pos = pos + 1
    return 1
end

func tokenize() then
    var more = 1
    while more == 1 then
        more = lex_one()
    end
    return 0
end

func main() then
    print_str("main started\n")
    src = "x = 10 + y"
    src_len = len(src)
    print_str("src: ")
    print_str(src)
    print_str("\n")
    tokenize()
    print_str("tokens: ")
    print tok_count
    return 0
end
