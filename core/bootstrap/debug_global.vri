var src = ""
var src_len = 0
var pos = 0
var tk_count = 0

func test_globals() then
    print_str("inside func: src_len=")
    print src_len
    print_str("inside func: pos=")
    print pos
    if pos < src_len then
        print_str("pos < src_len is TRUE\n")
    else
        print_str("pos < src_len is FALSE\n")
    end
    return 0
end

func main() then
    src = "hello"
    src_len = len(src)
    pos = 0
    print_str("main: src_len=")
    print src_len
    print_str("main: pos=")
    print pos
    test_globals()
    return 0
end
