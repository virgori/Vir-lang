# ============================================================
# Vir Standard Library: I/O Functions
# ============================================================

# Print string (no newline)
func print(s) then
    print_str(s)
    return 0
end

# Print string with newline
func println(s) then
    print_str(s)
    print_str("\n")
    return 0
end

# Print integer
func printInt(n) then
    print_str(i_to_str(n))
    return 0
end

# Print integer with newline
func printlnInt(n) then
    print_str(i_to_str(n))
    print_str("\n")
    return 0
end

# Print newline
func newline() then
    print_str("\n")
    return 0
end

# Print character
func printChar(c) then
    var buf = alloc(2)
    write_byte(buf, 0, c)
    write_byte(buf, 1, 0)
    print_str(buf)
    dealloc(buf)
    return 0
end

# Print n spaces
func printSpaces(n) then
    var i = 0
    while i < n then
        print_str(" ")
        i = i + 1
    end
    return 0
end

# Print with padding (right-aligned number)
func printPadded(n, width) then
    var s = i_to_str(n)
    var slen = len(s)
    var padding = width - slen
    if padding > 0 then
        printSpaces(padding)
    end
    print_str(s)
    return 0
end

# Print with left padding zeros
func printZeroPadded(n, width) then
    var s = i_to_str(n)
    var slen = len(s)
    var padding = width - slen
    var i = 0
    while i < padding then
        print_str("0")
        i = i + 1
    end
    print_str(s)
    return 0
end

# Print hexadecimal
func printHex(n) then
    var digits = "0123456789ABCDEF"
    if n == 0 then
        print_str("0")
        return 0
    end
    var buf = alloc(20)
    var pos = 18
    var x = n
    if x < 0 then
        x = 0 - x
    end
    while x > 0 then
        var d = x & 15
        write_byte(buf, pos, str_get(digits, d))
        pos = pos - 1
        x = x >> 4
    end
    if n < 0 then
        write_byte(buf, pos, 45)
        pos = pos - 1
    end
    write_byte(buf, 19, 0)
    var i = pos + 1
    while i < 19 then
        printChar(str_get(buf, i))
        i = i + 1
    end
    dealloc(buf)
    return 0
end

# Print binary
func printBin(n, bits) then
    var i = bits - 1
    while i >= 0 then
        if ((n >> i) & 1) == 1 then
            print_str("1")
        else
            print_str("0")
        end
        i = i - 1
    end
    return 0
end

# Read entire file into string
func readFile(path) then
    var fd = file_open(path, "r")
    if fd == 0 then
        return ""
    end
    var content = file_read(fd)
    file_close(fd)
    return content
end

# Write string to file
func writeFile(path, content) then
    var fd = file_open(path, "w")
    if fd == 0 then
        return 0
    end
    var i = 0
    var n = len(content)
    while i < n then
        write_byte(fd, 0, str_get(content, i))
        i = i + 1
    end
    file_close(fd)
    return 1
end

# Check if file exists (try to open)
func fileExists(path) then
    var fd = file_open(path, "r")
    if fd == 0 then
        return 0
    end
    file_close(fd)
    return 1
end

# Print a horizontal line
func printLine(width, c) then
    var i = 0
    while i < width then
        printChar(c)
        i = i + 1
    end
    newline()
    return 0
end

# Print error message
func error(msg) then
    print_str("Error: ")
    print_str(msg)
    print_str("\n")
    return 0
end

# Print warning message
func warning(msg) then
    print_str("Warning: ")
    print_str(msg)
    print_str("\n")
    return 0
end

# Print info message
func info(msg) then
    print_str("Info: ")
    print_str(msg)
    print_str("\n")
    return 0
end

# Print debug message
func debug(msg) then
    print_str("[DEBUG] ")
    print_str(msg)
    print_str("\n")
    return 0
end
