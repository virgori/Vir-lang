# ============================================================
# Vir Standard Library: vps - VPS Pattern Engine (Bootstrap)
# Virgex/VPS pattern matching for the bootstrap compiler
# Adapted from virgex.vri VPS specification
# ============================================================
# VPS (Vir Pattern Syntax) - literal by default, concise symbols
#
# Core symbols:
#   @   atom (data type)        |   anchor/OR (context)
#   !   quantifier (postfix)    $   escape
#   ~   range quantifier        -   literal space
#   ?   optional (prefix)       :( :) group
#
# Atoms:
#   @0    digit [0-9]
#   @az   lowercase [a-z]
#   @AZ   uppercase [A-Z]
#   @Az   letter [a-zA-Z]
#   @Az0  alphanumeric [a-zA-Z0-9]
#   @.    any character
#   @w    whitespace
#
# Quantifiers:
#   !n      exactly n
#   !n~m    n to m
#   !n~     n or more
#   !~      zero or more
#   !+      one or more
#
# Anchors:
#   | pattern |    fullmatch (anchored both ends)
#   | pattern      starts-with anchor
#   pattern |      ends-with anchor
#
# Examples:
#   | @0!3 |              → exactly 3 digits
#   | @AZ!2 $- @0!5 |    → 2 uppercase + dash + 5 digits
#   | @Az0!3~12 |        → 3-12 alphanumeric chars
#   :( hello | world :)  → "hello" or "world"
# ============================================================
module vps
export vps_match
export vps_fullmatch
export vps_search
export vps_test

# ---- Pattern token types ----
var VPS_T_LITERAL = 1
var VPS_T_ATOM = 2
var VPS_T_QUANT = 3
var VPS_T_OPTIONAL = 4
var VPS_T_GROUP_OPEN = 5
var VPS_T_GROUP_CLOSE = 6
var VPS_T_PIPE = 7
var VPS_T_SPACE = 8
var VPS_T_ESCAPE = 9
var VPS_T_EOF = 10

# ---- Token storage ----
var MAX_TOKENS = 256
var tok_types = []
var tok_chars = []
var tok_atom = []
var tok_qmin = []
var tok_qmax = []
var tok_count = 0

# ---- AST node storage ----
var MAX_NODES = 256
var nd_type = []
var nd_char = []
var nd_atom = []
var nd_qmin = []
var nd_qmax = []
var nd_left = []
var nd_right = []
var nd_next = []
var nd_count = 0

# AST node types
var N_LIT = 1
var N_ATOM = 2
var N_SEQ = 3
var N_ALT = 4
var N_OPT = 5
var N_QUANT = 6
var N_SPACE = 7
var N_GROUP = 8

func _init_arrays() then
    tok_types = []
    tok_chars = []
    tok_atom = []
    tok_qmin = []
    tok_qmax = []
    tok_count = 0
    nd_type = []
    nd_char = []
    nd_atom = []
    nd_qmin = []
    nd_qmax = []
    nd_left = []
    nd_right = []
    nd_next = []
    nd_count = 0
    var i = 0
    while i < MAX_TOKENS then
        push(tok_types, 0)
        push(tok_chars, 0)
        push(tok_atom, 0)
        push(tok_qmin, 0)
        push(tok_qmax, 0)
        i = i + 1
    end
    i = 0
    while i < MAX_NODES then
        push(nd_type, 0)
        push(nd_char, 0)
        push(nd_atom, 0)
        push(nd_qmin, 0)
        push(nd_qmax, 0)
        push(nd_left, 0 - 1)
        push(nd_right, 0 - 1)
        push(nd_next, 0 - 1)
        i = i + 1
    end
end

func _add_token(ttype, ch, atom, qmin, qmax) then
    if tok_count >= MAX_TOKENS then return end
    tok_types[tok_count] = ttype
    tok_chars[tok_count] = ch
    tok_atom[tok_count] = atom
    tok_qmin[tok_count] = qmin
    tok_qmax[tok_count] = qmax
    tok_count = tok_count + 1
end

func _new_node(ntype, ch, atom, qmin, qmax) then
    var idx = nd_count
    nd_type[idx] = ntype
    nd_char[idx] = ch
    nd_atom[idx] = atom
    nd_qmin[idx] = qmin
    nd_qmax[idx] = qmax
    nd_left[idx] = 0 - 1
    nd_right[idx] = 0 - 1
    nd_next[idx] = 0 - 1
    nd_count = nd_count + 1
    return idx
end

# ---- Tokenizer ----
func _tokenize(pat) then
    var n = len(pat)
    var i = 0
    tok_count = 0
    while i < n then
        var c = str_get(pat, i)
        
        if c == 64 then
            # @ atom
            i = i + 1
            var atom_code = 0
            if i < n then
                var a = str_get(pat, i)
                if a == 48 then
                    atom_code = 1
                    i = i + 1
                    if i < n then
                        if str_get(pat, i) == 54 then
                            atom_code = 12
                            i = i + 1
                        end
                    end
                end
                if a == 97 then
                    if i + 1 < n then
                        if str_get(pat, i + 1) == 122 then
                            atom_code = 2
                            i = i + 2
                        end
                    end
                end
                if a == 65 then
                    if i + 1 < n then
                        var a2 = str_get(pat, i + 1)
                        if a2 == 90 then
                            atom_code = 3
                            i = i + 2
                        end
                        if a2 == 122 then
                            atom_code = 4
                            i = i + 2
                            if i < n then
                                if str_get(pat, i) == 48 then
                                    atom_code = 5
                                    i = i + 1
                                end
                            end
                        end
                    end
                end
                if a == 46 then
                    atom_code = 6
                    i = i + 1
                end
                if a == 119 then
                    atom_code = 7
                    i = i + 1
                end
                if atom_code == 0 then
                    atom_code = 6
                    i = i + 1
                end
            end
            _add_token(VPS_T_ATOM, 0, atom_code, 0, 0)
        else
            if c == 33 then
                # ! quantifier
                i = i + 1
                var qmin = 0
                var qmax = 0
                # Check for !~ (zero or more)
                if i < n then
                    if str_get(pat, i) == 126 then
                        qmin = 0
                        qmax = 0 - 1
                        i = i + 1
                        _add_token(VPS_T_QUANT, 0, 0, 0, 0 - 1)
                    else
                        if str_get(pat, i) == 43 then
                            qmin = 1
                            qmax = 0 - 1
                            i = i + 1
                            _add_token(VPS_T_QUANT, 0, 0, 1, 0 - 1)
                        else
                            # Parse number
                            while i < n then
                                var d = str_get(pat, i)
                                if d >= 48 then
                                    if d <= 57 then
                                        qmin = qmin * 10 + (d - 48)
                                        i = i + 1
                                    else
                                        i = n + 1
                                    end
                                else
                                    i = n + 1
                                end
                            end
                            if i > n then i = i - 1 end
                            qmax = qmin
                            # Check for ~
                            if i < n then
                                if str_get(pat, i) == 126 then
                                    i = i + 1
                                    # Parse max or unbounded
                                    if i < n then
                                        var d = str_get(pat, i)
                                        if d >= 48 then
                                            if d <= 57 then
                                                qmax = 0
                                                while i < n then
                                                    d = str_get(pat, i)
                                                    if d >= 48 then
                                                        if d <= 57 then
                                                            qmax = qmax * 10 + (d - 48)
                                                            i = i + 1
                                                        else
                                                            i = n + 1
                                                        end
                                                    else
                                                        i = n + 1
                                                    end
                                                end
                                                if i > n then i = i - 1 end
                                            else
                                                qmax = 0 - 1
                                            end
                                        else
                                            qmax = 0 - 1
                                        end
                                    else
                                        qmax = 0 - 1
                                    end
                                end
                            end
                            _add_token(VPS_T_QUANT, 0, 0, qmin, qmax)
                        end
                    end
                end
            else
                if c == 63 then
                    # ? optional
                    _add_token(VPS_T_OPTIONAL, 0, 0, 0, 1)
                    i = i + 1
                else
                    if c == 58 then
                        # : group
                        i = i + 1
                        if i < n then
                            if str_get(pat, i) == 40 then
                                _add_token(VPS_T_GROUP_OPEN, 0, 0, 0, 0)
                                i = i + 1
                            end
                            if str_get(pat, i) == 41 then
                                _add_token(VPS_T_GROUP_CLOSE, 0, 0, 0, 0)
                                i = i + 1
                            end
                        end
                    else
                        if c == 124 then
                            # | anchor/pipe
                            _add_token(VPS_T_PIPE, 0, 0, 0, 0)
                            i = i + 1
                        else
                            if c == 45 then
                                # - space
                                _add_token(VPS_T_SPACE, 32, 0, 0, 0)
                                i = i + 1
                            else
                                if c == 36 then
                                    # $ escape
                                    i = i + 1
                                    if i < n then
                                        _add_token(VPS_T_ESCAPE, str_get(pat, i), 0, 0, 0)
                                        i = i + 1
                                    end
                                else
                                    if c != 32 then
                                        # Literal (skip raw spaces)
                                        _add_token(VPS_T_LITERAL, c, 0, 0, 0)
                                    end
                                    i = i + 1
                                end
                            end
                        end
                    end
                end
            end
        end
    end
    _add_token(VPS_T_EOF, 0, 0, 0, 0)
end

# ---- Atom Matching ----
# atom_code: 1=digit, 2=lowercase, 3=uppercase, 4=letter, 5=alnum, 6=any, 7=whitespace, 12=hex
func _match_atom(atom_code, c) then
    if atom_code == 1 then
        if c >= 48 then
            if c <= 57 then return 1 end
        end
        return 0
    end
    if atom_code == 2 then
        if c >= 97 then
            if c <= 122 then return 1 end
        end
        return 0
    end
    if atom_code == 3 then
        if c >= 65 then
            if c <= 90 then return 1 end
        end
        return 0
    end
    if atom_code == 4 then
        if c >= 65 then
            if c <= 90 then return 1 end
        end
        if c >= 97 then
            if c <= 122 then return 1 end
        end
        return 0
    end
    if atom_code == 5 then
        if c >= 48 then
            if c <= 57 then return 1 end
        end
        if c >= 65 then
            if c <= 90 then return 1 end
        end
        if c >= 97 then
            if c <= 122 then return 1 end
        end
        return 0
    end
    if atom_code == 6 then
        return 1
    end
    if atom_code == 7 then
        if c == 32 then return 1 end
        if c == 9 then return 1 end
        if c == 10 then return 1 end
        if c == 13 then return 1 end
        return 0
    end
    if atom_code == 12 then
        if c >= 48 then
            if c <= 57 then return 1 end
        end
        if c >= 65 then
            if c <= 70 then return 1 end
        end
        if c >= 97 then
            if c <= 102 then return 1 end
        end
        return 0
    end
    return 0
end

# ---- Token-based pattern matcher ----
# Direct token-based matching (simpler than full AST)

# Match a single token element against string at position
# Returns: number of chars consumed, or -1 if no match
func _match_element(tidx, s, pos) then
    var slen = len(s)
    var ttype = tok_types[tidx]
    
    if ttype == VPS_T_LITERAL then
        if pos >= slen then return 0 - 1 end
        if str_get(s, pos) == tok_chars[tidx] then
            return 1
        end
        return 0 - 1
    end
    
    if ttype == VPS_T_ESCAPE then
        if pos >= slen then return 0 - 1 end
        if str_get(s, pos) == tok_chars[tidx] then
            return 1
        end
        return 0 - 1
    end
    
    if ttype == VPS_T_SPACE then
        if pos >= slen then return 0 - 1 end
        if str_get(s, pos) == 32 then return 1 end
        return 0 - 1
    end
    
    if ttype == VPS_T_ATOM then
        # Check if next token is a quantifier
        var atom = tok_atom[tidx]
        var next_t = tidx + 1
        var qmin = 1
        var qmax = 1
        if next_t < tok_count then
            if tok_types[next_t] == VPS_T_QUANT then
                qmin = tok_qmin[next_t]
                qmax = tok_qmax[next_t]
            end
        end
        # Match atom qmin..qmax times
        var matched = 0
        var p = pos
        if qmax == 0 - 1 then
            # Greedy: match as many as possible
            while p < slen then
                if _match_atom(atom, str_get(s, p)) == 1 then
                    matched = matched + 1
                    p = p + 1
                else
                    p = slen + 1
                end
            end
            if p > slen then p = p - 1 end
        else
            while matched < qmax then
                if p >= slen then
                    matched = qmax + 1
                else
                    if _match_atom(atom, str_get(s, p)) == 1 then
                        matched = matched + 1
                        p = p + 1
                    else
                        matched = qmax + 1
                    end
                end
            end
            if matched > qmax then matched = matched - 1 end
        end
        if matched < qmin then return 0 - 1 end
        return matched
    end
    
    return 0 - 1
end

# Main pattern matching engine
# Matches tokens[tidx..] against s[pos..]
# Returns: number of chars consumed, or -1 if no match
func _match_tokens(tidx, s, pos) then
    var slen = len(s)
    var cur_pos = pos
    var ti = tidx
    
    while ti < tok_count then
        var ttype = tok_types[ti]
        
        if ttype == VPS_T_EOF then
            return cur_pos - pos
        end
        
        if ttype == VPS_T_PIPE then
            # End of this alternative or anchor marker
            return cur_pos - pos
        end
        
        if ttype == VPS_T_GROUP_CLOSE then
            return cur_pos - pos
        end
        
        if ttype == VPS_T_OPTIONAL then
            # ? prefix: next element is optional
            ti = ti + 1
            if ti < tok_count then
                var result = _match_element(ti, s, cur_pos)
                if result >= 0 then
                    cur_pos = cur_pos + result
                end
                # Skip quantifier if present
                if ti + 1 < tok_count then
                    if tok_types[ti + 1] == VPS_T_QUANT then
                        ti = ti + 1
                    end
                end
            end
            ti = ti + 1
        else
            if ttype == VPS_T_GROUP_OPEN then
                # :( ... | ... :) group with alternation
                ti = ti + 1
                var best = 0 - 1
                var alt_start = ti
                
                # Try each alternative
                var found_close = 0
                while found_close == 0 then
                    var result = _match_tokens(alt_start, s, cur_pos)
                    if result > best then
                        best = result
                    end
                    
                    # Skip to next | or :)
                    var depth = 0
                    while alt_start < tok_count then
                        if tok_types[alt_start] == VPS_T_GROUP_OPEN then
                            depth = depth + 1
                        end
                        if tok_types[alt_start] == VPS_T_GROUP_CLOSE then
                            if depth == 0 then
                                found_close = 1
                                alt_start = tok_count
                            else
                                depth = depth - 1
                            end
                        end
                        if tok_types[alt_start] == VPS_T_PIPE then
                            if depth == 0 then
                                alt_start = alt_start + 1
                                found_close = 0
                                alt_start = tok_count + 1
                            end
                        end
                        if alt_start <= tok_count then
                            alt_start = alt_start + 1
                        end
                    end
                    if alt_start > tok_count then
                        alt_start = alt_start - 1
                        found_close = 0
                    end
                end
                
                if best < 0 then return 0 - 1 end
                cur_pos = cur_pos + best
                
                # Find matching :) and skip past it
                var skip_ti = ti
                var d2 = 0
                while skip_ti < tok_count then
                    if tok_types[skip_ti] == VPS_T_GROUP_OPEN then d2 = d2 + 1 end
                    if tok_types[skip_ti] == VPS_T_GROUP_CLOSE then
                        if d2 == 0 then
                            ti = skip_ti + 1
                            skip_ti = tok_count
                        else
                            d2 = d2 - 1
                        end
                    end
                    skip_ti = skip_ti + 1
                end
            else
                # Regular element
                var result = _match_element(ti, s, cur_pos)
                if result < 0 then return 0 - 1 end
                cur_pos = cur_pos + result
                
                # Skip quantifier token if we already consumed it in atom match
                if ttype == VPS_T_ATOM then
                    if ti + 1 < tok_count then
                        if tok_types[ti + 1] == VPS_T_QUANT then
                            ti = ti + 1
                        end
                    end
                end
                ti = ti + 1
            end
        end
    end
    return cur_pos - pos
end

# ---- Public API ----

# vps_fullmatch: like | pattern |
# Returns 1 if entire string matches, 0 otherwise
func vps_fullmatch(pattern, s) then
    _init_arrays()
    _tokenize(pattern)
    
    # Check for anchor pipes
    var start_ti = 0
    var end_anchored = 0
    
    if tok_count > 1 then
        if tok_types[0] == VPS_T_PIPE then
            start_ti = 1
        end
        # Check if last non-EOF token is pipe
        var last = tok_count - 2
        if last >= 0 then
            if tok_types[last] == VPS_T_PIPE then
                end_anchored = 1
            end
        end
    end
    
    var result = _match_tokens(start_ti, s, 0)
    if result < 0 then return 0 end
    if result == len(s) then return 1 end
    return 0
end

# vps_match: try to match pattern at start of string
# Returns number of chars matched, or -1
func vps_match(pattern, s) then
    _init_arrays()
    _tokenize(pattern)
    
    var start_ti = 0
    if tok_count > 0 then
        if tok_types[0] == VPS_T_PIPE then
            start_ti = 1
        end
    end
    
    return _match_tokens(start_ti, s, 0)
end

# vps_search: find first occurrence of pattern in string
# Returns position of first match, or -1
func vps_search(pattern, s) then
    _init_arrays()
    _tokenize(pattern)
    
    var start_ti = 0
    if tok_count > 0 then
        if tok_types[0] == VPS_T_PIPE then
            start_ti = 1
        end
    end
    
    var slen = len(s)
    var pos = 0
    while pos < slen then
        var result = _match_tokens(start_ti, s, pos)
        if result > 0 then return pos end
        pos = pos + 1
    end
    return 0 - 1
end

# vps_test: user-friendly test function
# Prints PASS/FAIL for pattern against string
func vps_test(label, pattern, s, expected) then
    var result = vps_fullmatch(pattern, s)
    if result == expected then
        print("  PASS: ")
    else
        print("  FAIL: ")
    end
    print(label)
    print(" | pattern='")
    print(pattern)
    print("' input='")
    print(s)
    print("' expected=")
    print_i(expected)
    print(" got=")
    print_i(result)
    println("")
    return result == expected
end
