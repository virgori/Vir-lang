# --------------------------------------------------------
# Sorting
# --------------------------------------------------------

func sort_partition(arr, lo, hi) then
    var pivot = arr[hi]
    var i = lo - 1
    var j = lo
    while j < hi then
        if arr[j] <= pivot then
            i = i + 1
            var tmp = arr[i]
            arr[i] = arr[j]
            arr[j] = tmp
        end
        j = j + 1
    end
    var tmp = arr[i + 1]
    arr[i + 1] = arr[hi]
    arr[hi] = tmp
    return i + 1
end

func sort_helper(arr, lo, hi) then
    if lo < hi then
        var p = sort_partition(arr, lo, hi)
        sort_helper(arr, lo, p - 1)
        sort_helper(arr, p + 1, hi)
    end
end

func sort(arr, n) then
    if n <= 1 then return end
    sort_helper(arr, 0, n - 1)
end

func sort_desc(arr, n) then
    sort(arr, n)
    # Reverse in-place
    var i = 0
    var j = n - 1
    while i < j then
        var tmp = arr[i]
        arr[i] = arr[j]
        arr[j] = tmp
        i = i + 1
        j = j - 1
    end
end

# --------------------------------------------------------
# Searching
# --------------------------------------------------------

func binary_search(arr, n, target) then
    var lo = 0
    var hi = n - 1
    while lo <= hi then
        var mid = lo + (hi - lo) / 2
        if arr[mid] == target then return mid end
        if arr[mid] < target then
            lo = mid + 1
        else
            hi = mid - 1
        end
    end
    return 0 - 1
end

func linear_search(arr, n, target) then
    var i = 0
    while i < n then
        if arr[i] == target then return i end
        i = i + 1
    end
    return 0 - 1
end

# --------------------------------------------------------
# Array utilities
# --------------------------------------------------------

func arr_reverse(arr, n) then
    var i = 0
    var j = n - 1
    while i < j then
        var tmp = arr[i]
        arr[i] = arr[j]
        arr[j] = tmp
        i = i + 1
        j = j - 1
    end
end

func arr_copy(dest, src, n) then
    var i = 0
    while i < n then
        dest[i] = src[i]
        i = i + 1
    end
end

func arr_fill(arr, n, val) then
    var i = 0
    while i < n then
        arr[i] = val
        i = i + 1
    end
end

func arr_sum(arr, n) then
    var total = 0
    var i = 0
    while i < n then
        total = total + arr[i]
        i = i + 1
    end
    return total
end

func arr_min(arr, n) then
    if n == 0 then return 0 end
    var m = arr[0]
    var i = 1
    while i < n then
        if arr[i] < m then
            m = arr[i]
        end
        i = i + 1
    end
    return m
end

func arr_max(arr, n) then
    if n == 0 then return 0 end
    var m = arr[0]
    var i = 1
    while i < n then
        if arr[i] > m then
            m = arr[i]
        end
        i = i + 1
    end
    return m
end

func arr_map_scale(arr, n, factor) then
    var i = 0
    while i < n then
        arr[i] = arr[i] * factor
        i = i + 1
    end
end

func arr_filter_gt(src, n, threshold, dest) then
    var count = 0
    var i = 0
    while i < n then
        if src[i] > threshold then
            dest[count] = src[i]
            count = count + 1
        end
        i = i + 1
    end
    return count
end

func arr_unique(src, n, dest) then
    var count = 0
    var i = 0
    while i < n then
        var found = 0
        var j = 0
        while j < count then
            if dest[j] == src[i] then
                found = 1
                j = count
            end
            j = j + 1
        end
        if found == 0 then
            dest[count] = src[i]
            count = count + 1
        end
        i = i + 1
    end
    return count
end

func arr_merge(a, an, b, bn, dest) then
    var i = 0
    var j = 0
    var k = 0
    while i < an then
        if j < bn then
            if a[i] <= b[j] then
                dest[k] = a[i]
                i = i + 1
            else
                dest[k] = b[j]
                j = j + 1
            end
        else
            dest[k] = a[i]
            i = i + 1
        end
        k = k + 1
    end
    while j < bn then
        dest[k] = b[j]
        j = j + 1
        k = k + 1
    end
    return k
end

func arr_slice(src, start, end_idx, dest) then
    var i = start
    var k = 0
    while i < end_idx then
        dest[k] = src[i]
        k = k + 1
        i = i + 1
    end
    return k
end

func arr_contains(arr, n, val) then
    var i = 0
    while i < n then
        if arr[i] == val then return 1 end
        i = i + 1
    end
    return 0
end

func arr_index_of(arr, n, val) then
    return linear_search(arr, n, val)
end

func arr_count_val(arr, n, val) then
    var c = 0
    var i = 0
    while i < n then
        if arr[i] == val then
            c = c + 1
        end
        i = i + 1
    end
    return c
end

func arr_swap(arr, i, j) then
    var tmp = arr[i]
    arr[i] = arr[j]
    arr[j] = tmp
end

func arr_rotate_left(arr, n, k) then
    if n == 0 then return end
    k = k % n
    if k == 0 then return end
    arr_reverse(arr, k)
    # Reverse second part
    var i = k
    var j = n - 1
    while i < j then
        var tmp = arr[i]
        arr[i] = arr[j]
        arr[j] = tmp
        i = i + 1
        j = j - 1
    end
    arr_reverse(arr, n)
end

# --------------------------------------------------------
# Stack (array-based)
# --------------------------------------------------------

var _stack_data = []
var _stack_top = 0

func stack_new() then
    _stack_data = []
    _stack_top = 0
end

func stack_push(val) then
    push(_stack_data, val)
    _stack_top = _stack_top + 1
end

func stack_pop() then
    if _stack_top == 0 then return 0 - 1 end
    _stack_top = _stack_top - 1
    var val = _stack_data[_stack_top]
    return val
end

func stack_peek() then
    if _stack_top == 0 then return 0 - 1 end
    return _stack_data[_stack_top - 1]
end

func stack_empty() then
    if _stack_top == 0 then return 1 end
    return 0
end

# --------------------------------------------------------
# Queue (circular buffer, fixed capacity)
# --------------------------------------------------------

var Q_CAP = 1024
var _queue_data = []
var _queue_head = 0
var _queue_tail = 0
var _queue_size = 0

func queue_new() then
    _queue_data = []
    _queue_head = 0
    _queue_tail = 0
    _queue_size = 0
    var i = 0
    while i < Q_CAP then
        push(_queue_data, 0)
        i = i + 1
    end
end

func queue_enqueue(val) then
    if _queue_size >= Q_CAP then return 0 end
    _queue_data[_queue_tail] = val
    _queue_tail = (_queue_tail + 1) % Q_CAP
    _queue_size = _queue_size + 1
    return 1
end

func queue_dequeue() then
    if _queue_size == 0 then return 0 - 1 end
    var val = _queue_data[_queue_head]
    _queue_head = (_queue_head + 1) % Q_CAP
    _queue_size = _queue_size - 1
    return val
end

func queue_front() then
    if _queue_size == 0 then return 0 - 1 end
    return _queue_data[_queue_head]
end

func queue_empty() then
    if _queue_size == 0 then return 1 end
    return 0
end
