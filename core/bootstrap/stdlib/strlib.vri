# ============================================================
# Vir Standard Library: strlib (Extended string operations)
# Equivalent to C's <string.h> + extras
# ============================================================
module strlib
export strlen_c
export strcmp_c
export strncmp_c
export strcpy_c
export strncpy_c
export strcat_c
export strncat_c
export strchr_c
export strrchr_c
export strstr_c
export strtok
export strdup_c
export strrev_c
export strtrim
export strsplit
export strjoin
export strreplace
export strupper
export strlower
export strcount
export strpad_left
export strpad_right
export str_startswith
export str_endswith
export str_contains
export str_repeat

func strlen_c(s) then
    return len(s)
end

func strcmp_c(s1, s2) then
    var i = 0
    while 1 == 1 then
        var c1 = str_get(s1, i)
        var c2 = str_get(s2, i)
        if c1 == 0 then
            if c2 == 0 then return 0 end
            return 0 - 1
        end
        if c2 == 0 then return 1 end
        if c1 < c2 then return 0 - 1 end
        if c1 > c2 then return 1 end
        i = i + 1
    end
    return 0
end

func strncmp_c(s1, s2, n) then
    var i = 0
    while i < n then
        var c1 = str_get(s1, i)
        var c2 = str_get(s2, i)
        if c1 == 0 then
            if c2 == 0 then return 0 end
            return 0 - 1
        end
        if c2 == 0 then return 1 end
        if c1 < c2 then return 0 - 1 end
        if c1 > c2 then return 1 end
        i = i + 1
    end
    return 0
end

func strcpy_c(dest, src_s) then
    var i = 0
    var n = len(src_s)
    while i <= n then
        write_byte(dest, i, str_get(src_s, i))
        i = i + 1
    end
    return dest
end

func strncpy_c(dest, src_s, n) then
    var i = 0
    var slen = len(src_s)
    while i < n then
        if i < slen then
            write_byte(dest, i, str_get(src_s, i))
        else
            write_byte(dest, i, 0)
        end
        i = i + 1
    end
    return dest
end

func strcat_c(dest, src_s) then
    return str_cat(dest, src_s)
end

func strncat_c(dest, src_s, n) then
    var src_len = len(src_s)
    if n < src_len then
        src_len = n
    end
    var sub = ""
    var i = 0
    while i < src_len then
        sub = str_cat(sub, char_to_str(str_get(src_s, i)))
        i = i + 1
    end
    return str_cat(dest, sub)
end

func strchr_c(s, c) then
    var i = 0
    var n = len(s)
    while i < n then
        if str_get(s, i) == c then
            return i
        end
        i = i + 1
    end
    return 0 - 1
end

func strrchr_c(s, c) then
    var n = len(s)
    var i = n - 1
    while i >= 0 then
        if str_get(s, i) == c then
            return i
        end
        i = i - 1
    end
    return 0 - 1
end

func strstr_c(haystack, needle) then
    var hlen = len(haystack)
    var nlen = len(needle)
    if nlen == 0 then return 0 end
    if nlen > hlen then return 0 - 1 end
    var i = 0
    while i <= hlen - nlen then
        var j = 0
        var match = 1
        while j < nlen then
            if str_get(haystack, i + j) != str_get(needle, j) then
                match = 0
                j = nlen
            end
            j = j + 1
        end
        if match == 1 then
            return i
        end
        i = i + 1
    end
    return 0 - 1
end

# strtok - split string by delimiter character
func strtok(s, delim) then
    var result = []
    var current = ""
    var i = 0
    var n = len(s)
    while i < n then
        var c = str_get(s, i)
        if c == delim then
            if len(current) > 0 then
                push(result, current)
                current = ""
            end
        else
            current = str_cat(current, char_to_str(c))
        end
        i = i + 1
    end
    if len(current) > 0 then
        push(result, current)
    end
    return result
end

func strdup_c(s) then
    var n = len(s)
    var copy = alloc(n + 1)
    var i = 0
    while i <= n then
        write_byte(copy, i, str_get(s, i))
        i = i + 1
    end
    return copy
end

func strrev_c(s) then
    var n = len(s)
    var result = ""
    var i = n - 1
    while i >= 0 then
        result = str_cat(result, char_to_str(str_get(s, i)))
        i = i - 1
    end
    return result
end

func strtrim(s) then
    var n = len(s)
    var start = 0
    while start < n then
        var c = str_get(s, start)
        if c != 32 then
            if c != 9 then
                if c != 10 then
                    if c != 13 then
                        start = n + 1
                    end
                end
            end
        end
        if start <= n then
            start = start + 1
        end
    end
    if start > n then
        start = start - 1
    end
    var end_idx = n - 1
    while end_idx >= start then
        var c = str_get(s, end_idx)
        if c != 32 then
            if c != 9 then
                if c != 10 then
                    if c != 13 then
                        end_idx = 0 - 1
                    end
                end
            end
        end
        if end_idx >= 0 then
            end_idx = end_idx - 1
        end
    end
    if end_idx < 0 then
        end_idx = end_idx + 1
    end
    var result = ""
    var i = start
    while i <= end_idx then
        result = str_cat(result, char_to_str(str_get(s, i)))
        i = i + 1
    end
    return result
end

func strsplit(s, sep) then
    return strtok(s, sep)
end

func strjoin(arr, sep, count) then
    var result = ""
    var i = 0
    while i < count then
        if i > 0 then
            result = str_cat(result, char_to_str(sep))
        end
        result = str_cat(result, arr[i])
        i = i + 1
    end
    return result
end

func strreplace(s, old_s, new_s) then
    var result = ""
    var slen = len(s)
    var olen = len(old_s)
    var i = 0
    while i < slen then
        if i + olen <= slen then
            var match = 1
            var j = 0
            while j < olen then
                if str_get(s, i + j) != str_get(old_s, j) then
                    match = 0
                    j = olen
                end
                j = j + 1
            end
            if match == 1 then
                result = str_cat(result, new_s)
                i = i + olen
            else
                result = str_cat(result, char_to_str(str_get(s, i)))
                i = i + 1
            end
        else
            result = str_cat(result, char_to_str(str_get(s, i)))
            i = i + 1
        end
    end
    return result
end

func strupper(s) then
    var result = ""
    var i = 0
    var n = len(s)
    while i < n then
        var c = str_get(s, i)
        if c >= 97 then
            if c <= 122 then
                c = c - 32
            end
        end
        result = str_cat(result, char_to_str(c))
        i = i + 1
    end
    return result
end

func strlower(s) then
    var result = ""
    var i = 0
    var n = len(s)
    while i < n then
        var c = str_get(s, i)
        if c >= 65 then
            if c <= 90 then
                c = c + 32
            end
        end
        result = str_cat(result, char_to_str(c))
        i = i + 1
    end
    return result
end

func strcount(s, c) then
    var count = 0
    var i = 0
    var n = len(s)
    while i < n then
        if str_get(s, i) == c then
            count = count + 1
        end
        i = i + 1
    end
    return count
end

func strpad_left(s, width, pad_char) then
    var n = len(s)
    if n >= width then return s end
    var result = ""
    var i = 0
    while i < width - n then
        result = str_cat(result, char_to_str(pad_char))
        i = i + 1
    end
    return str_cat(result, s)
end

func strpad_right(s, width, pad_char) then
    var n = len(s)
    if n >= width then return s end
    var result = s
    var i = n
    while i < width then
        result = str_cat(result, char_to_str(pad_char))
        i = i + 1
    end
    return result
end

func str_startswith(s, prefix) then
    var sl = len(s)
    var pl = len(prefix)
    if pl > sl then return 0 end
    var i = 0
    while i < pl then
        if str_get(s, i) != str_get(prefix, i) then
            return 0
        end
        i = i + 1
    end
    return 1
end

func str_endswith(s, suffix) then
    var sl = len(s)
    var sufl = len(suffix)
    if sufl > sl then return 0 end
    var offset = sl - sufl
    var i = 0
    while i < sufl then
        if str_get(s, offset + i) != str_get(suffix, i) then
            return 0
        end
        i = i + 1
    end
    return 1
end

func str_contains(haystack, needle) then
    if strstr_c(haystack, needle) >= 0 then
        return 1
    end
    return 0
end

func str_repeat(s, count) then
    var result = ""
    var i = 0
    while i < count then
        result = str_cat(result, s)
        i = i + 1
    end
    return result
end
