# ============================================================
# Vir Standard Library: stdio (C-like I/O operations)
# Equivalent to C's <stdio.h>
# ============================================================
module stdio
export printf
export fprintf
export sprintf
export puts
export putchar
export getchar
export fopen
export fclose
export fread
export fwrite
export fgets
export fputs
export feof
export ftell
export fseek
export rewind
export fflush

# File descriptor constants
var STDIN_FD = 0
var STDOUT_FD = 1
var STDERR_FD = 2

# printf - formatted output to stdout
# Supports: %d (int), %s (string), %x (hex), %c (char), %% (literal %)
func printf(fmt) then
    var result = format_string(fmt, 0, 0, 0, 0, 0, 0, 0)
    print_str(result)
    return len(result)
end

func printf1(fmt, a1) then
    var result = format_string(fmt, a1, 0, 0, 0, 0, 0, 0)
    print_str(result)
    return len(result)
end

func printf2(fmt, a1, a2) then
    var result = format_string(fmt, a1, a2, 0, 0, 0, 0, 0)
    print_str(result)
    return len(result)
end

func printf3(fmt, a1, a2, a3) then
    var result = format_string(fmt, a1, a2, a3, 0, 0, 0, 0)
    print_str(result)
    return len(result)
end

# format_string - core formatting engine
func format_string(fmt, a1, a2, a3, a4, a5, a6, a7) then
    var args = [a1, a2, a3, a4, a5, a6, a7]
    var arg_idx = 0
    var result = ""
    var i = 0
    var n = len(fmt)
    while i < n then
        var c = str_get(fmt, i)
        if c == 37 then
            # % format specifier
            i = i + 1
            if i < n then
                var spec = str_get(fmt, i)
                if spec == 100 then
                    # %d - integer
                    result = str_cat(result, i_to_str(args[arg_idx]))
                    arg_idx = arg_idx + 1
                end
                if spec == 115 then
                    # %s - string
                    result = str_cat(result, args[arg_idx])
                    arg_idx = arg_idx + 1
                end
                if spec == 120 then
                    # %x - hex
                    result = str_cat(result, int_to_hex(args[arg_idx]))
                    arg_idx = arg_idx + 1
                end
                if spec == 99 then
                    # %c - character
                    result = str_cat(result, char_to_str(args[arg_idx]))
                    arg_idx = arg_idx + 1
                end
                if spec == 37 then
                    # %% - literal %
                    result = str_cat(result, "%")
                end
            end
        else
            result = str_cat(result, char_to_str(c))
        end
        i = i + 1
    end
    return result
end

func int_to_hex(n) then
    if n == 0 then
        return "0"
    end
    var hex_chars = "0123456789abcdef"
    var result = ""
    var neg = 0
    if n < 0 then
        neg = 1
        n = 0 - n
    end
    while n > 0 then
        var digit = n & 15
        result = str_cat(char_to_str(str_get(hex_chars, digit)), result)
        n = n >> 4
    end
    if neg == 1 then
        result = str_cat("-", result)
    end
    return result
end

func puts(s) then
    print_str(s)
    print_str("\n")
    return 0
end

func putchar(c) then
    var buf = alloc(2)
    write_byte(buf, 0, c)
    write_byte(buf, 1, 0)
    print_str(buf)
    dealloc(buf)
    return c
end

func getchar() then
    var buf = alloc(2)
    write_byte(buf, 0, 0)
    write_byte(buf, 1, 0)
    var n = syscall(3, 0, buf, 1)
    var c = 0
    if n > 0 then
        c = read_byte(buf, 0)
    else
        c = 0 - 1
    end
    dealloc(buf)
    return c
end

func fopen(path, mode) then
    return file_open(path, mode)
end

func fclose(fd) then
    file_close(fd)
    return 0
end

func fread(buf, size, count, fd) then
    var total = size * count
    var result = syscall(3, fd, buf, total)
    if result <= 0 then
        return 0
    end
    return result / size
end

func fwrite(buf, size, count, fd) then
    var total = size * count
    var result = syscall(4, fd, buf, total)
    if result <= 0 then
        return 0
    end
    return result / size
end

func fgets(buf, size, fd) then
    var i = 0
    while i < size - 1 then
        var c = 0
        var nbuf = alloc(1)
        var n = syscall(3, fd, nbuf, 1)
        if n <= 0 then
            write_byte(buf, i, 0)
            dealloc(nbuf)
            if i == 0 then
                return 0
            end
            return buf
        end
        c = read_byte(nbuf, 0)
        dealloc(nbuf)
        write_byte(buf, i, c)
        i = i + 1
        if c == 10 then
            write_byte(buf, i, 0)
            return buf
        end
    end
    write_byte(buf, i, 0)
    return buf
end

func fputs(s, fd) then
    var n = len(s)
    syscall(4, fd, s, n)
    return 0
end

func feof(fd) then
    var buf = alloc(1)
    var n = syscall(3, fd, buf, 1)
    dealloc(buf)
    if n <= 0 then
        return 1
    end
    return 0
end

# Simplified ftell/fseek using lseek syscall
func ftell(fd) then
    return syscall(199, fd, 0, 1)
end

func fseek(fd, offset, whence) then
    return syscall(199, fd, offset, whence)
end

func rewind_file(fd) then
    syscall(199, fd, 0, 0)
    return 0
end

func fflush(fd) then
    return 0
end
