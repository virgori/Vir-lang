# ============================================================
# Vir Standard Library: assert - Assertion and testing
# Equivalent to C's <assert.h> + testing utilities
# ============================================================
module assert
export assert
export assert_eq
export assert_neq
export assert_gt
export assert_lt
export assert_ge
export assert_le
export assert_str_eq
export assert_true
export assert_false
export test_suite_begin
export test_suite_end
export test_case

var _test_total = 0
var _test_passed = 0
var _test_failed = 0
var _suite_name = ""

func assert(condition, msg) then
    if condition == 0 then
        print("ASSERTION FAILED: ")
        println(msg)
        exit(1)
    end
end

func assert_eq(a, b, msg) then
    _test_total = _test_total + 1
    if a != b then
        _test_failed = _test_failed + 1
        print("  FAIL: ")
        print(msg)
        print(" (expected=")
        print_i(b)
        print(", got=")
        print_i(a)
        println(")")
        return 0
    end
    _test_passed = _test_passed + 1
    print("  PASS: ")
    println(msg)
    return 1
end

func assert_neq(a, b, msg) then
    _test_total = _test_total + 1
    if a == b then
        _test_failed = _test_failed + 1
        print("  FAIL: ")
        print(msg)
        print(" (should not equal ")
        print_i(b)
        println(")")
        return 0
    end
    _test_passed = _test_passed + 1
    print("  PASS: ")
    println(msg)
    return 1
end

func assert_gt(a, b, msg) then
    _test_total = _test_total + 1
    if a <= b then
        _test_failed = _test_failed + 1
        print("  FAIL: ")
        print(msg)
        print(" (")
        print_i(a)
        print(" not > ")
        print_i(b)
        println(")")
        return 0
    end
    _test_passed = _test_passed + 1
    print("  PASS: ")
    println(msg)
    return 1
end

func assert_lt(a, b, msg) then
    _test_total = _test_total + 1
    if a >= b then
        _test_failed = _test_failed + 1
        print("  FAIL: ")
        print(msg)
        print(" (")
        print_i(a)
        print(" not < ")
        print_i(b)
        println(")")
        return 0
    end
    _test_passed = _test_passed + 1
    print("  PASS: ")
    println(msg)
    return 1
end

func assert_ge(a, b, msg) then
    _test_total = _test_total + 1
    if a < b then
        _test_failed = _test_failed + 1
        print("  FAIL: ")
        print(msg)
        print(" (")
        print_i(a)
        print(" not >= ")
        print_i(b)
        println(")")
        return 0
    end
    _test_passed = _test_passed + 1
    print("  PASS: ")
    println(msg)
    return 1
end

func assert_le(a, b, msg) then
    _test_total = _test_total + 1
    if a > b then
        _test_failed = _test_failed + 1
        print("  FAIL: ")
        print(msg)
        print(" (")
        print_i(a)
        print(" not <= ")
        print_i(b)
        println(")")
        return 0
    end
    _test_passed = _test_passed + 1
    print("  PASS: ")
    println(msg)
    return 1
end

func assert_str_eq(a, b, msg) then
    _test_total = _test_total + 1
    var la = len(a)
    var lb = len(b)
    if la != lb then
        _test_failed = _test_failed + 1
        print("  FAIL: ")
        print(msg)
        print(" (len mismatch: ")
        print_i(la)
        print(" vs ")
        print_i(lb)
        println(")")
        return 0
    end
    var i = 0
    while i < la then
        if str_get(a, i) != str_get(b, i) then
            _test_failed = _test_failed + 1
            print("  FAIL: ")
            print(msg)
            print(" (differ at pos ")
            print_i(i)
            println(")")
            return 0
        end
        i = i + 1
    end
    _test_passed = _test_passed + 1
    print("  PASS: ")
    println(msg)
    return 1
end

func assert_true(condition, msg) then
    return assert_eq(condition, 1, msg)
end

func assert_false(condition, msg) then
    return assert_eq(condition, 0, msg)
end

func test_suite_begin(name) then
    _suite_name = name
    _test_total = 0
    _test_passed = 0
    _test_failed = 0
    println("========================================")
    print("Test Suite: ")
    println(name)
    println("========================================")
end

func test_suite_end() then
    println("----------------------------------------")
    print("Results for: ")
    println(_suite_name)
    print("  Total:  ")
    print_i(_test_total)
    println("")
    print("  Passed: ")
    print_i(_test_passed)
    println("")
    print("  Failed: ")
    print_i(_test_failed)
    println("")
    println("========================================")
    return _test_failed
end

func test_case(name) then
    print("[Test] ")
    println(name)
end
