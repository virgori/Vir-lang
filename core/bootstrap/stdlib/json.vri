# ============================================================
# Vir Standard Library: json - JSON parser and serializer
# Minimal JSON support for structured data
# ============================================================
module json
export json_parse_int
export json_parse_string
export json_parse_array_ints
export json_serialize_int
export json_serialize_string
export json_serialize_array
export json_skip_whitespace
export json_expect_char
export json_type_at
export json_escape_string

# JSON type constants
var JSON_NULL = 0
var JSON_INT = 1
var JSON_STRING = 2
var JSON_ARRAY = 3
var JSON_OBJECT = 4
var JSON_BOOL = 5

# Parse position (global state for parser)
var _json_pos = 0
var _json_src = ""

func json_skip_whitespace() then
    var n = len(_json_src)
    while _json_pos < n then
        var c = str_get(_json_src, _json_pos)
        if c != 32 then
            if c != 9 then
                if c != 10 then
                    if c != 13 then
                        return
                    end
                end
            end
        end
        _json_pos = _json_pos + 1
    end
end

func json_expect_char(expected) then
    if _json_pos < len(_json_src) then
        if str_get(_json_src, _json_pos) == expected then
            _json_pos = _json_pos + 1
            return 1
        end
    end
    return 0
end

func json_type_at() then
    json_skip_whitespace()
    if _json_pos >= len(_json_src) then return JSON_NULL end
    var c = str_get(_json_src, _json_pos)
    if c == 34 then return JSON_STRING end
    if c >= 48 then
        if c <= 57 then return JSON_INT end
    end
    if c == 45 then return JSON_INT end
    if c == 91 then return JSON_ARRAY end
    if c == 123 then return JSON_OBJECT end
    if c == 116 then return JSON_BOOL end
    if c == 102 then return JSON_BOOL end
    if c == 110 then return JSON_NULL end
    return JSON_NULL
end

func json_parse_int() then
    json_skip_whitespace()
    var n = len(_json_src)
    var neg = 0
    if _json_pos < n then
        if str_get(_json_src, _json_pos) == 45 then
            neg = 1
            _json_pos = _json_pos + 1
        end
    end
    var result = 0
    while _json_pos < n then
        var c = str_get(_json_src, _json_pos)
        if c < 48 then
            _json_pos = n + 1
        else
            if c > 57 then
                _json_pos = n + 1
            else
                result = result * 10 + (c - 48)
                _json_pos = _json_pos + 1
            end
        end
    end
    if _json_pos > n then _json_pos = _json_pos - 1 end
    if neg == 1 then return 0 - result end
    return result
end

func json_parse_string() then
    json_skip_whitespace()
    var n = len(_json_src)
    if _json_pos >= n then return "" end
    if str_get(_json_src, _json_pos) != 34 then return "" end
    _json_pos = _json_pos + 1
    var result = ""
    while _json_pos < n then
        var c = str_get(_json_src, _json_pos)
        if c == 34 then
            _json_pos = _json_pos + 1
            return result
        end
        if c == 92 then
            # Escape sequence
            _json_pos = _json_pos + 1
            if _json_pos < n then
                var ec = str_get(_json_src, _json_pos)
                if ec == 110 then
                    result = str_cat(result, char_to_str(10))
                end
                if ec == 116 then
                    result = str_cat(result, char_to_str(9))
                end
                if ec == 34 then
                    result = str_cat(result, char_to_str(34))
                end
                if ec == 92 then
                    result = str_cat(result, char_to_str(92))
                end
                if ec == 114 then
                    result = str_cat(result, char_to_str(13))
                end
            end
        else
            result = str_cat(result, char_to_str(c))
        end
        _json_pos = _json_pos + 1
    end
    return result
end

func json_parse_array_ints(dest) then
    json_skip_whitespace()
    if json_expect_char(91) == 0 then return 0 end
    var count = 0
    json_skip_whitespace()
    if _json_pos < len(_json_src) then
        if str_get(_json_src, _json_pos) == 93 then
            _json_pos = _json_pos + 1
            return 0
        end
    end
    # Parse first element
    dest[count] = json_parse_int()
    count = count + 1
    json_skip_whitespace()
    while _json_pos < len(_json_src) then
        if str_get(_json_src, _json_pos) == 93 then
            _json_pos = _json_pos + 1
            return count
        end
        if str_get(_json_src, _json_pos) == 44 then
            _json_pos = _json_pos + 1
            dest[count] = json_parse_int()
            count = count + 1
            json_skip_whitespace()
        else
            _json_pos = _json_pos + 1
        end
    end
    return count
end

func _int_to_str(n) then
    if n == 0 then return "0" end
    var neg = 0
    if n < 0 then
        neg = 1
        n = 0 - n
    end
    var buf = ""
    while n > 0 then
        buf = str_cat(char_to_str(48 + n % 10), buf)
        n = n / 10
    end
    if neg == 1 then
        buf = str_cat("-", buf)
    end
    return buf
end

func json_serialize_int(n) then
    return _int_to_str(n)
end

func json_escape_string(s) then
    var result = ""
    var i = 0
    var n = len(s)
    while i < n then
        var c = str_get(s, i)
        if c == 34 then
            result = str_cat(result, "\\")
            result = str_cat(result, char_to_str(34))
        else
            if c == 92 then
                result = str_cat(result, "\\\\")
            else
                if c == 10 then
                    result = str_cat(result, "\\n")
                else
                    if c == 9 then
                        result = str_cat(result, "\\t")
                    else
                        result = str_cat(result, char_to_str(c))
                    end
                end
            end
        end
        i = i + 1
    end
    return result
end

func json_serialize_string(s) then
    var result = char_to_str(34)
    result = str_cat(result, json_escape_string(s))
    result = str_cat(result, char_to_str(34))
    return result
end

func json_serialize_array(arr, n) then
    var result = "["
    var i = 0
    while i < n then
        if i > 0 then
            result = str_cat(result, ", ")
        end
        result = str_cat(result, _int_to_str(arr[i]))
        i = i + 1
    end
    result = str_cat(result, "]")
    return result
end

# Initialize parser with source string
func json_init(src) then
    _json_src = src
    _json_pos = 0
end
