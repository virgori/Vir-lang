# ============================================================
# Vir Standard Library: pymath - Python-like math operations
# Equivalent to Python's math module
# ============================================================
module pymath
export py_abs
export py_pow
export py_sqrt_int
export py_factorial
export py_gcd
export py_lcm
export py_fib
export py_is_prime
export py_comb
export py_perm
export py_ceil_div
export py_floor_div
export py_log2_int
export py_log10_int
export py_isqrt
export py_copysign
export py_divmod
export py_sum_range
export py_max3
export py_min3
export py_median3

func py_abs(x) then
    if x < 0 then return 0 - x end
    return x
end

func py_pow(base, exp) then
    if exp == 0 then return 1 end
    if exp < 0 then return 0 end
    var result = 1
    var b = base
    var e = exp
    while e > 0 then
        if e % 2 == 1 then
            result = result * b
        end
        b = b * b
        e = e / 2
    end
    return result
end

func py_sqrt_int(n) then
    if n <= 0 then return 0 end
    if n == 1 then return 1 end
    var x = n
    var y = (x + 1) / 2
    while y < x then
        x = y
        y = (x + n / x) / 2
    end
    return x
end

func py_factorial(n) then
    if n <= 1 then return 1 end
    var result = 1
    var i = 2
    while i <= n then
        result = result * i
        i = i + 1
    end
    return result
end

func py_gcd(a, b) then
    if a < 0 then a = 0 - a end
    if b < 0 then b = 0 - b end
    while b != 0 then
        var t = b
        b = a % b
        a = t
    end
    return a
end

func py_lcm(a, b) then
    if a == 0 then return 0 end
    if b == 0 then return 0 end
    var g = py_gcd(a, b)
    return py_abs(a / g * b)
end

func py_fib(n) then
    if n <= 0 then return 0 end
    if n == 1 then return 1 end
    var a = 0
    var b = 1
    var i = 2
    while i <= n then
        var c = a + b
        a = b
        b = c
        i = i + 1
    end
    return b
end

func py_is_prime(n) then
    if n < 2 then return 0 end
    if n == 2 then return 1 end
    if n % 2 == 0 then return 0 end
    if n == 3 then return 1 end
    if n % 3 == 0 then return 0 end
    var i = 5
    while i * i <= n then
        if n % i == 0 then return 0 end
        if n % (i + 2) == 0 then return 0 end
        i = i + 6
    end
    return 1
end

func py_comb(n, k) then
    if k < 0 then return 0 end
    if k > n then return 0 end
    if k == 0 then return 1 end
    if k == n then return 1 end
    if k > n - k then
        k = n - k
    end
    var result = 1
    var i = 0
    while i < k then
        result = result * (n - i)
        result = result / (i + 1)
        i = i + 1
    end
    return result
end

func py_perm(n, k) then
    if k < 0 then return 0 end
    if k > n then return 0 end
    var result = 1
    var i = 0
    while i < k then
        result = result * (n - i)
        i = i + 1
    end
    return result
end

func py_ceil_div(a, b) then
    if b == 0 then return 0 end
    var d = a / b
    if a % b != 0 then
        if (a > 0) == (b > 0) then
            d = d + 1
        end
    end
    return d
end

func py_floor_div(a, b) then
    if b == 0 then return 0 end
    return a / b
end

func py_log2_int(n) then
    if n <= 0 then return 0 - 1 end
    var count = 0
    while n > 1 then
        n = n / 2
        count = count + 1
    end
    return count
end

func py_log10_int(n) then
    if n <= 0 then return 0 - 1 end
    var count = 0
    while n >= 10 then
        n = n / 10
        count = count + 1
    end
    return count
end

func py_isqrt(n) then
    return py_sqrt_int(n)
end

func py_copysign(x, y) then
    var ax = py_abs(x)
    if y < 0 then return 0 - ax end
    return ax
end

func py_divmod(a, b) then
    # Returns quotient * 1000000 + remainder (packed)
    if b == 0 then return 0 end
    var q = a / b
    var r = a - q * b
    return q * 1000000 + r
end

func py_sum_range(start, end_val) then
    # Sum of integers from start to end_val-1
    var total = 0
    var i = start
    while i < end_val then
        total = total + i
        i = i + 1
    end
    return total
end

func py_max3(a, b, c) then
    var m = a
    if b > m then m = b end
    if c > m then m = c end
    return m
end

func py_min3(a, b, c) then
    var m = a
    if b < m then m = b end
    if c < m then m = c end
    return m
end

func py_median3(a, b, c) then
    if a <= b then
        if b <= c then return b end
        if a <= c then return c end
        return a
    end
    if a <= c then return a end
    if b <= c then return c end
    return b
end
