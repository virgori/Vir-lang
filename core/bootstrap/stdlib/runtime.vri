# ============================================================
# Vir Pure Runtime - No C Dependencies
# ============================================================
# This runtime provides all functionality needed by compiler.vri
# using only syscalls, eliminating the need for C runtime.
# ============================================================

# macOS ARM64 syscall numbers (BSD layer 0x2000000 offset handled by syscall)
var SYS_EXIT = 1
var SYS_READ = 3
var SYS_WRITE = 4
var SYS_OPEN = 5
var SYS_CLOSE = 6
var SYS_MMAP = 197

# File descriptors
var FD_STDIN = 0
var FD_STDOUT = 1
var FD_STDERR = 2

# Open flags
var O_RDONLY = 0
var O_WRONLY = 1
var O_RDWR = 2
var O_CREAT = 512
var O_TRUNC = 1024

# mmap flags
var PROT_READ = 1
var PROT_WRITE = 2
var MAP_PRIVATE = 2
var MAP_ANON = 4096

# ============================================================
# Memory Management
# ============================================================

# Simple bump allocator state
var heap_base = 0
var heap_ptr = 0
var heap_size = 0
var HEAP_INIT_SIZE = 67108864  # 64MB

# Initialize heap using mmap
func rt_init_heap() then
    var prot = PROT_READ | PROT_WRITE
    var flags = MAP_PRIVATE | MAP_ANON
    heap_base = syscall(SYS_MMAP, 0, HEAP_INIT_SIZE, prot, flags, 0 - 1, 0)
    heap_ptr = heap_base
    heap_size = HEAP_INIT_SIZE
    return 0
end

# Allocate memory (bump allocator - no free)
func rt_alloc(size) then
    if heap_base == 0 then
        rt_init_heap()
    end
    # Align to 8 bytes
    var aligned = (size + 7) & (0 - 8)
    var result = heap_ptr
    heap_ptr = heap_ptr + aligned
    return result
end

# Read byte from memory address
func rt_read_byte(addr, offset) then
    var ptr = addr + offset
    # Use inline memory read
    return read_byte(ptr, 0)
end

# Write byte to memory address
func rt_write_byte(addr, offset, val) then
    var ptr = addr + offset
    write_byte(ptr, 0, val)
    return 0
end

# ============================================================
# Output Functions
# ============================================================

# Print string to stdout using syscall
func rt_print_str(s) then
    var n = len(s)
    syscall(SYS_WRITE, FD_STDOUT, s, n)
    return 0
end

# Print single character
func rt_print_char(c) then
    var buf = rt_alloc(2)
    rt_write_byte(buf, 0, c)
    rt_write_byte(buf, 1, 0)
    syscall(SYS_WRITE, FD_STDOUT, buf, 1)
    return 0
end

# Print integer
func rt_print_int(n) then
    var s = rt_int_to_str(n)
    rt_print_str(s)
    return 0
end

# ============================================================
# String Functions (using syscalls and memory ops)
# ============================================================

# Integer to string conversion
func rt_int_to_str(n) then
    var buf = rt_alloc(24)
    var neg = 0
    var val = n
    
    if val < 0 then
        neg = 1
        val = 0 - val
    end
    
    var pos = 22
    rt_write_byte(buf, 23, 0)
    
    if val == 0 then
        rt_write_byte(buf, pos, 48)
        pos = pos - 1
    else
        while val > 0 then
            var digit = val % 10
            rt_write_byte(buf, pos, 48 + digit)
            pos = pos - 1
            val = val / 10
        end
    end
    
    if neg == 1 then
        rt_write_byte(buf, pos, 45)
        pos = pos - 1
    end
    
    return buf + pos + 1
end

# String concatenation
func rt_str_cat(s1, s2) then
    var len1 = len(s1)
    var len2 = len(s2)
    var result = rt_alloc(len1 + len2 + 1)
    
    var i = 0
    while i < len1 then
        rt_write_byte(result, i, str_get(s1, i))
        i = i + 1
    end
    
    var j = 0
    while j < len2 then
        rt_write_byte(result, len1 + j, str_get(s2, j))
        j = j + 1
    end
    
    rt_write_byte(result, len1 + len2, 0)
    return result
end

# Character to string
func rt_char_to_str(c) then
    var buf = rt_alloc(2)
    rt_write_byte(buf, 0, c)
    rt_write_byte(buf, 1, 0)
    return buf
end

# String equality
func rt_str_eq(s1, s2) then
    var len1 = len(s1)
    var len2 = len(s2)
    if len1 != len2 then
        return 0
    end
    var i = 0
    while i < len1 then
        if str_get(s1, i) != str_get(s2, i) then
            return 0
        end
        i = i + 1
    end
    return 1
end

# ============================================================
# File I/O Functions
# ============================================================

# Open file for reading
func rt_file_open(path, mode) then
    var flags = O_RDONLY
    # Check mode: "r" = read, "w" = write
    if str_get(mode, 0) == 119 then
        flags = O_WRONLY | O_CREAT | O_TRUNC
    end
    return syscall(SYS_OPEN, path, flags, 420)  # 420 = 0644 octal
end

# Read entire file into string
func rt_file_read(fd) then
    # First, find file size by reading in chunks
    var chunk_size = 65536
    var total_buf = rt_alloc(1048576)  # 1MB max
    var total_len = 0
    var temp_buf = rt_alloc(chunk_size)
    
    var n = syscall(SYS_READ, fd, temp_buf, chunk_size)
    while n > 0 then
        var i = 0
        while i < n then
            rt_write_byte(total_buf, total_len + i, rt_read_byte(temp_buf, i))
            i = i + 1
        end
        total_len = total_len + n
        n = syscall(SYS_READ, fd, temp_buf, chunk_size)
    end
    
    rt_write_byte(total_buf, total_len, 0)
    return total_buf
end

# Close file
func rt_file_close(fd) then
    syscall(SYS_CLOSE, fd)
    return 0
end

# ============================================================
# Array Functions (dynamic arrays with header)
# ============================================================
# Array layout: [capacity:8][length:8][data...]

func rt_array_new() then
    var cap = 16
    var arr = rt_alloc(16 + cap * 8)
    # Write capacity at offset 0
    rt_write_word(arr, 0, cap)
    # Write length at offset 8
    rt_write_word(arr, 8, 0)
    return arr + 16  # Return pointer to data
end

func rt_write_word(addr, offset, val) then
    var ptr = addr + offset
    # Write 64-bit value (little endian)
    rt_write_byte(ptr, 0, val & 255)
    rt_write_byte(ptr, 1, (val >> 8) & 255)
    rt_write_byte(ptr, 2, (val >> 16) & 255)
    rt_write_byte(ptr, 3, (val >> 24) & 255)
    rt_write_byte(ptr, 4, (val >> 32) & 255)
    rt_write_byte(ptr, 5, (val >> 40) & 255)
    rt_write_byte(ptr, 6, (val >> 48) & 255)
    rt_write_byte(ptr, 7, (val >> 56) & 255)
    return 0
end

func rt_read_word(addr, offset) then
    var ptr = addr + offset
    var b0 = rt_read_byte(ptr, 0)
    var b1 = rt_read_byte(ptr, 1)
    var b2 = rt_read_byte(ptr, 2)
    var b3 = rt_read_byte(ptr, 3)
    var b4 = rt_read_byte(ptr, 4)
    var b5 = rt_read_byte(ptr, 5)
    var b6 = rt_read_byte(ptr, 6)
    var b7 = rt_read_byte(ptr, 7)
    return b0 | (b1 << 8) | (b2 << 16) | (b3 << 24) | (b4 << 32) | (b5 << 40) | (b6 << 48) | (b7 << 56)
end

func rt_array_get_cap(arr) then
    return rt_read_word(arr - 16, 0)
end

func rt_array_get_len(arr) then
    return rt_read_word(arr - 16, 8)
end

func rt_array_set_len(arr, newlen) then
    rt_write_word(arr - 16, 8, newlen)
    return 0
end

func rt_array_push(arr, val) then
    var oldlen = rt_array_get_len(arr)
    var cap = rt_array_get_cap(arr)
    
    # Need to grow?
    if oldlen >= cap then
        # Double capacity
        var newcap = cap * 2
        var newarr = rt_alloc(16 + newcap * 8)
        rt_write_word(newarr, 0, newcap)
        rt_write_word(newarr, 8, oldlen)
        
        # Copy old data
        var i = 0
        while i < oldlen then
            rt_write_word(newarr + 16, i * 8, rt_read_word(arr, i * 8))
            i = i + 1
        end
        
        arr = newarr + 16
    end
    
    # Write new element
    rt_write_word(arr, oldlen * 8, val)
    rt_array_set_len(arr, oldlen + 1)
    
    return arr
end

func rt_array_get(arr, idx) then
    return rt_read_word(arr, idx * 8)
end

func rt_array_set(arr, idx, val) then
    rt_write_word(arr, idx * 8, val)
    return 0
end

# ============================================================
# Exit function
# ============================================================

func rt_exit(code) then
    syscall(SYS_EXIT, code)
    return 0
end
