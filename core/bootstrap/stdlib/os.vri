# ============================================================
# Vir Standard Library: os - Operating system interface
# File operations, process control, environment (macOS ARM64)
# ============================================================
module os
export os_open
export os_close
export os_read
export os_write
export os_lseek
export os_mkdir
export os_unlink
export os_rename
export os_stat_size
export os_getcwd
export os_chdir
export os_getpid
export os_exit
export os_fork
export os_execve
export os_waitpid
export os_mmap
export os_munmap
export os_dup2
export os_pipe
export os_isatty
export os_sleep_ms

# macOS ARM64 syscall numbers (BSD + 0x2000000)
var SYS_EXIT = 1
var SYS_FORK = 2
var SYS_READ = 3
var SYS_WRITE = 4
var SYS_OPEN = 5
var SYS_CLOSE = 6
var SYS_WAITPID = 7
var SYS_UNLINK = 10
var SYS_CHDIR = 12
var SYS_MMAP = 197
var SYS_MUNMAP = 73
var SYS_LSEEK = 199
var SYS_GETPID = 20
var SYS_DUP2 = 90
var SYS_PIPE = 42
var SYS_MKDIR = 136
var SYS_RENAME = 128
var SYS_STAT = 188
var SYS_ISATTY = 0

# File open flags
var O_RDONLY = 0
var O_WRONLY = 1
var O_RDWR = 2
var O_CREAT = 512
var O_TRUNC = 1024
var O_APPEND = 8

# File modes
var MODE_DEFAULT = 420

func os_open(path, flags, mode) then
    return syscall3(SYS_OPEN, path, flags, mode)
end

func os_close(fd) then
    return syscall1(SYS_CLOSE, fd)
end

func os_read(fd, buf, count) then
    return syscall3(SYS_READ, fd, buf, count)
end

func os_write(fd, buf, count) then
    return syscall3(SYS_WRITE, fd, buf, count)
end

func os_lseek(fd, offset, whence) then
    return syscall3(SYS_LSEEK, fd, offset, whence)
end

func os_mkdir(path, mode) then
    return syscall2(SYS_MKDIR, path, mode)
end

func os_unlink(path) then
    return syscall1(SYS_UNLINK, path)
end

func os_rename(old_path, new_path) then
    return syscall2(SYS_RENAME, old_path, new_path)
end

func os_stat_size(path) then
    # Simplified: returns file size using open+lseek
    var fd = os_open(path, O_RDONLY, 0)
    if fd < 0 then return 0 - 1 end
    var size = os_lseek(fd, 0, 2)
    os_close(fd)
    return size
end

func os_getcwd(buf, size) then
    # macOS doesn't have a simple getcwd syscall
    # Use /proc/self/cwd or fallback
    return 0
end

func os_chdir(path) then
    return syscall1(SYS_CHDIR, path)
end

func os_getpid() then
    return syscall0(SYS_GETPID)
end

func os_exit(code) then
    exit(code)
end

func os_fork() then
    return syscall0(SYS_FORK)
end

func os_execve(path, argv, envp) then
    return syscall3(59, path, argv, envp)
end

func os_waitpid(pid, status, options) then
    return syscall3(SYS_WAITPID, pid, status, options)
end

func os_mmap(addr, length, prot, flags, fd, offset) then
    # mmap uses 6 args, handled specially
    return syscall6(SYS_MMAP, addr, length, prot, flags, fd, offset)
end

func os_munmap(addr, length) then
    return syscall2(SYS_MUNMAP, addr, length)
end

func os_dup2(oldfd, newfd) then
    return syscall2(SYS_DUP2, oldfd, newfd)
end

func os_pipe(fildes) then
    return syscall1(SYS_PIPE, fildes)
end

func os_isatty(fd) then
    # Simplified check: try ioctl TIOCGETA
    # For now just check if fd is 0, 1, or 2
    if fd >= 0 then
        if fd <= 2 then
            return 1
        end
    end
    return 0
end

func os_sleep_ms(ms) then
    # Busy-wait sleep (no nanosleep syscall wrapper yet)
    var count = ms * 1000
    var i = 0
    while i < count then
        i = i + 1
    end
end
