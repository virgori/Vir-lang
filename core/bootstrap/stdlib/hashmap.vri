# ============================================================
# Vir Standard Library: hashmap - Hash table implementation
# Equivalent to C hash tables / Python dict
# ============================================================
module hashmap
export hm_create
export hm_set
export hm_get
export hm_has
export hm_delete
export hm_size
export hm_keys
export hm_values
export hm_clear

# Hash map structure:
# Stored as parallel arrays:
#   keys[CAPACITY]   - string keys
#   vals[CAPACITY]   - integer values
#   used[CAPACITY]   - 0=empty, 1=occupied, 2=deleted (tombstone)
#   count            - number of active entries
#   capacity         - total capacity

var HM_CAP = 256
var hm_keys = []
var hm_vals = []
var hm_used = []
var hm_count = 0

func hm_hash(key) then
    # djb2 hash function
    var hash = 5381
    var i = 0
    var n = len(key)
    while i < n then
        var c = str_get(key, i)
        hash = hash * 33 + c
        # Keep positive
        if hash < 0 then
            hash = hash * (0 - 1)
        end
        i = i + 1
    end
    return hash
end

func hm_create() then
    hm_keys = []
    hm_vals = []
    hm_used = []
    hm_count = 0
    var i = 0
    while i < HM_CAP then
        push(hm_keys, "")
        push(hm_vals, 0)
        push(hm_used, 0)
        i = i + 1
    end
end

func hm_str_eq(a, b) then
    var la = len(a)
    var lb = len(b)
    if la != lb then return 0 end
    var i = 0
    while i < la then
        if str_get(a, i) != str_get(b, i) then
            return 0
        end
        i = i + 1
    end
    return 1
end

func hm_set(key, value) then
    var h = hm_hash(key) % HM_CAP
    var probe = 0
    while probe < HM_CAP then
        var idx = (h + probe) % HM_CAP
        if hm_used[idx] == 0 then
            # Empty slot, insert
            hm_keys[idx] = key
            hm_vals[idx] = value
            hm_used[idx] = 1
            hm_count = hm_count + 1
            return 1
        end
        if hm_used[idx] == 2 then
            # Tombstone, can reuse
            hm_keys[idx] = key
            hm_vals[idx] = value
            hm_used[idx] = 1
            hm_count = hm_count + 1
            return 1
        end
        # Occupied, check if same key
        if hm_str_eq(hm_keys[idx], key) == 1 then
            hm_vals[idx] = value
            return 1
        end
        probe = probe + 1
    end
    # Table full
    return 0
end

func hm_get(key) then
    var h = hm_hash(key) % HM_CAP
    var probe = 0
    while probe < HM_CAP then
        var idx = (h + probe) % HM_CAP
        if hm_used[idx] == 0 then
            return 0 - 1
        end
        if hm_used[idx] == 1 then
            if hm_str_eq(hm_keys[idx], key) == 1 then
                return hm_vals[idx]
            end
        end
        probe = probe + 1
    end
    return 0 - 1
end

func hm_has(key) then
    var h = hm_hash(key) % HM_CAP
    var probe = 0
    while probe < HM_CAP then
        var idx = (h + probe) % HM_CAP
        if hm_used[idx] == 0 then
            return 0
        end
        if hm_used[idx] == 1 then
            if hm_str_eq(hm_keys[idx], key) == 1 then
                return 1
            end
        end
        probe = probe + 1
    end
    return 0
end

func hm_delete(key) then
    var h = hm_hash(key) % HM_CAP
    var probe = 0
    while probe < HM_CAP then
        var idx = (h + probe) % HM_CAP
        if hm_used[idx] == 0 then
            return 0
        end
        if hm_used[idx] == 1 then
            if hm_str_eq(hm_keys[idx], key) == 1 then
                hm_used[idx] = 2
                hm_count = hm_count - 1
                return 1
            end
        end
        probe = probe + 1
    end
    return 0
end

func hm_size() then
    return hm_count
end

func hm_keys_list(out_arr) then
    var i = 0
    var count = 0
    while i < HM_CAP then
        if hm_used[i] == 1 then
            out_arr[count] = hm_keys[i]
            count = count + 1
        end
        i = i + 1
    end
    return count
end

func hm_values(out_arr) then
    var i = 0
    var count = 0
    while i < HM_CAP then
        if hm_used[i] == 1 then
            out_arr[count] = hm_vals[i]
            count = count + 1
        end
        i = i + 1
    end
    return count
end

func hm_clear() then
    var i = 0
    while i < HM_CAP then
        hm_keys[i] = ""
        hm_vals[i] = 0
        hm_used[i] = 0
        i = i + 1
    end
    hm_count = 0
end

# Convenience aliases
func hm_keys(out_arr) then
    return hm_keys_list(out_arr)
end
