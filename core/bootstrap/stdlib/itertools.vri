# ============================================================
# Vir Standard Library: itertools - Python-like iteration tools
# Equivalent to Python's itertools module
# ============================================================
module itertools
export irange
export irange_step
export irepeat
export icycle
export ichain
export imap_double
export ifilter_even
export ifilter_odd
export itakewhile_lt
export idropwhile_lt
export iaccumulate
export iproduct
export ipermutations2
export icombinations2
export igroupby_sorted
export izip_longest
export islice
export ienumerate
export istarmap_add
export icompress

# Generate range into dest array, return count
func irange(dest, start, stop) then
    var i = 0
    var v = start
    while v < stop then
        dest[i] = v
        v = v + 1
        i = i + 1
    end
    return i
end

func irange_step(dest, start, stop, step) then
    var i = 0
    var v = start
    if step > 0 then
        while v < stop then
            dest[i] = v
            v = v + step
            i = i + 1
        end
    else
        while v > stop then
            dest[i] = v
            v = v + step
            i = i + 1
        end
    end
    return i
end

func irepeat(dest, val, count) then
    var i = 0
    while i < count then
        dest[i] = val
        i = i + 1
    end
    return count
end

func icycle(src, src_n, dest, dest_n) then
    # Fill dest with cycling values from src
    var i = 0
    while i < dest_n then
        dest[i] = src[i % src_n]
        i = i + 1
    end
    return dest_n
end

func ichain(a, an, b, bn, dest) then
    var i = 0
    while i < an then
        dest[i] = a[i]
        i = i + 1
    end
    var j = 0
    while j < bn then
        dest[an + j] = b[j]
        j = j + 1
    end
    return an + bn
end

# map: double each element
func imap_double(src, n, dest) then
    var i = 0
    while i < n then
        dest[i] = src[i] * 2
        i = i + 1
    end
    return n
end

# filter: keep even numbers
func ifilter_even(src, n, dest) then
    var count = 0
    var i = 0
    while i < n then
        if src[i] % 2 == 0 then
            dest[count] = src[i]
            count = count + 1
        end
        i = i + 1
    end
    return count
end

# filter: keep odd numbers
func ifilter_odd(src, n, dest) then
    var count = 0
    var i = 0
    while i < n then
        if src[i] % 2 != 0 then
            dest[count] = src[i]
            count = count + 1
        end
        i = i + 1
    end
    return count
end

# takewhile: take elements while < threshold
func itakewhile_lt(src, n, threshold, dest) then
    var count = 0
    var i = 0
    while i < n then
        if src[i] >= threshold then
            return count
        end
        dest[count] = src[i]
        count = count + 1
        i = i + 1
    end
    return count
end

# dropwhile: skip elements while < threshold
func idropwhile_lt(src, n, threshold, dest) then
    var i = 0
    while i < n then
        if src[i] >= threshold then
            i = n + 1
        else
            i = i + 1
        end
    end
    if i > n then i = i - 1 end
    var count = 0
    while i < n then
        dest[count] = src[i]
        count = count + 1
        i = i + 1
    end
    return count
end

# accumulate: running sum
func iaccumulate(src, n, dest) then
    if n == 0 then return 0 end
    dest[0] = src[0]
    var i = 1
    while i < n then
        dest[i] = dest[i - 1] + src[i]
        i = i + 1
    end
    return n
end

# product: cartesian product of two arrays
# dest stores pairs as (dest[k*2], dest[k*2+1])
func iproduct(a, an, b, bn, dest) then
    var k = 0
    var i = 0
    while i < an then
        var j = 0
        while j < bn then
            dest[k * 2] = a[i]
            dest[k * 2 + 1] = b[j]
            k = k + 1
            j = j + 1
        end
        i = i + 1
    end
    return k
end

# permutations of 2 elements from array
# dest stores pairs as (dest[k*2], dest[k*2+1])
func ipermutations2(src, n, dest) then
    var k = 0
    var i = 0
    while i < n then
        var j = 0
        while j < n then
            if i != j then
                dest[k * 2] = src[i]
                dest[k * 2 + 1] = src[j]
                k = k + 1
            end
            j = j + 1
        end
        i = i + 1
    end
    return k
end

# combinations of 2 elements from array
func icombinations2(src, n, dest) then
    var k = 0
    var i = 0
    while i < n then
        var j = i + 1
        while j < n then
            dest[k * 2] = src[i]
            dest[k * 2 + 1] = src[j]
            k = k + 1
            j = j + 1
        end
        i = i + 1
    end
    return k
end

# groupby for sorted array: count consecutive equal elements
# keys[i] = value, counts[i] = count
func igroupby_sorted(src, n, keys, counts) then
    if n == 0 then return 0 end
    var groups = 0
    keys[0] = src[0]
    counts[0] = 1
    var i = 1
    while i < n then
        if src[i] == keys[groups] then
            counts[groups] = counts[groups] + 1
        else
            groups = groups + 1
            keys[groups] = src[i]
            counts[groups] = 1
        end
        i = i + 1
    end
    return groups + 1
end

# zip_longest: zip two arrays, padding shorter with fill_value
func izip_longest(a, an, b, bn, dest_a, dest_b, fill_value) then
    var n = an
    if bn > n then n = bn end
    var i = 0
    while i < n then
        if i < an then
            dest_a[i] = a[i]
        else
            dest_a[i] = fill_value
        end
        if i < bn then
            dest_b[i] = b[i]
        else
            dest_b[i] = fill_value
        end
        i = i + 1
    end
    return n
end

# islice: slice from start to stop
func islice(src, n, start, stop, dest) then
    if stop > n then stop = n end
    var count = 0
    var i = start
    while i < stop then
        dest[count] = src[i]
        count = count + 1
        i = i + 1
    end
    return count
end

# enumerate: fill index and value arrays
func ienumerate(src, n, idx_out, val_out) then
    var i = 0
    while i < n then
        idx_out[i] = i
        val_out[i] = src[i]
        i = i + 1
    end
    return n
end

# starmap: apply addition to pairs
func istarmap_add(pairs, n, dest) then
    var i = 0
    while i < n then
        dest[i] = pairs[i * 2] + pairs[i * 2 + 1]
        i = i + 1
    end
    return n
end

# compress: select elements where selector is nonzero
func icompress(data, selectors, n, dest) then
    var count = 0
    var i = 0
    while i < n then
        if selectors[i] != 0 then
            dest[count] = data[i]
            count = count + 1
        end
        i = i + 1
    end
    return count
end
