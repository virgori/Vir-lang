# ============================================================
# Vir Standard Library: String Functions
# NOTE: Function names are prefixed to avoid C library conflicts
# ============================================================

# Get string length (wrapper around builtin len for strings)
func strLen(s) then
    return len(s)
end

# Compare two strings: returns 0 if equal, <0 if s1 < s2, >0 if s1 > s2
func strCmp(s1, s2) then
    var i = 0
    var len1 = len(s1)
    var len2 = len(s2)
    while i < len1 then
        if i >= len2 then
            return 1
        end
        var c1 = str_get(s1, i)
        var c2 = str_get(s2, i)
        if c1 < c2 then
            return 0 - 1
        end
        if c1 > c2 then
            return 1
        end
        i = i + 1
    end
    if len1 < len2 then
        return 0 - 1
    end
    return 0
end

# Check if two strings are equal
func strEq(s1, s2) then
    return str_eq(s1, s2)
end

# Copy string (allocate new string)
func strCopy(s) then
    return str_cat("", s)
end

# Concatenate two strings
func strConcat(s1, s2) then
    return str_cat(s1, s2)
end

# Get character at index (returns ASCII value)
func charAt(s, idx) then
    return str_get(s, idx)
end

# Check if string starts with prefix
func startsWith(s, prefix) then
    var plen = len(prefix)
    var slen = len(s)
    if plen > slen then
        return 0
    end
    var i = 0
    while i < plen then
        if str_get(s, i) != str_get(prefix, i) then
            return 0
        end
        i = i + 1
    end
    return 1
end

# Check if string ends with suffix
func endsWith(s, suffix) then
    var slen = len(s)
    var suflen = len(suffix)
    if suflen > slen then
        return 0
    end
    var i = 0
    var offset = slen - suflen
    while i < suflen then
        if str_get(s, offset + i) != str_get(suffix, i) then
            return 0
        end
        i = i + 1
    end
    return 1
end

# Get substring from start to end (exclusive)
func substring(s, start, endpos) then
    var result = ""
    var i = start
    while i < endpos then
        if i >= len(s) then
            return result
        end
        var c = str_get(s, i)
        var buf = alloc(2)
        write_byte(buf, 0, c)
        write_byte(buf, 1, 0)
        result = str_cat(result, buf)
        dealloc(buf)
        i = i + 1
    end
    return result
end

# Find first occurrence of char in string, returns -1 if not found
func indexOf(s, ch) then
    var i = 0
    var n = len(s)
    while i < n then
        if str_get(s, i) == ch then
            return i
        end
        i = i + 1
    end
    return 0 - 1
end

# Find last occurrence of char in string, returns -1 if not found
func lastIndexOf(s, ch) then
    var n = len(s)
    var i = n - 1
    while i >= 0 then
        if str_get(s, i) == ch then
            return i
        end
        i = i - 1
    end
    return 0 - 1
end

# Check if character is a digit (0-9)
func charIsDigit(c) then
    if c >= 48 then
        if c <= 57 then
            return 1
        end
    end
    return 0
end

# Check if character is alphabetic (A-Z, a-z)
func charIsAlpha(c) then
    if c >= 65 then
        if c <= 90 then
            return 1
        end
    end
    if c >= 97 then
        if c <= 122 then
            return 1
        end
    end
    return 0
end

# Check if character is alphanumeric
func charIsAlnum(c) then
    if charIsAlpha(c) == 1 then
        return 1
    end
    return charIsDigit(c)
end

# Check if character is whitespace
func charIsSpace(c) then
    if c == 32 then return 1 end
    if c == 9 then return 1 end
    if c == 10 then return 1 end
    if c == 13 then return 1 end
    return 0
end

# Convert character to uppercase
func charToUpper(c) then
    if c >= 97 then
        if c <= 122 then
            return c - 32
        end
    end
    return c
end

# Convert character to lowercase
func charToLower(c) then
    if c >= 65 then
        if c <= 90 then
            return c + 32
        end
    end
    return c
end

# Convert integer to string
func intToStr(n) then
    return i_to_str(n)
end

# Repeat string n times
func repeat(s, n) then
    var result = ""
    var i = 0
    while i < n then
        result = str_cat(result, s)
        i = i + 1
    end
    return result
end

# Trim leading whitespace
func trimLeft(s) then
    var i = 0
    var n = len(s)
    while i < n then
        if charIsSpace(str_get(s, i)) == 0 then
            return substring(s, i, n)
        end
        i = i + 1
    end
    return ""
end

# Trim trailing whitespace
func trimRight(s) then
    var n = len(s)
    var i = n - 1
    while i >= 0 then
        if charIsSpace(str_get(s, i)) == 0 then
            return substring(s, 0, i + 1)
        end
        i = i - 1
    end
    return ""
end

# Trim both leading and trailing whitespace
func trim(s) then
    return trimRight(trimLeft(s))
end
