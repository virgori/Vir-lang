# ============================================================
# Vir Standard Library: pystr - Python-like string operations
# Equivalent to Python's str methods
# ============================================================
module pystr
export str_upper
export str_lower
export str_strip
export str_lstrip
export str_rstrip
export str_split
export str_join
export str_replace
export str_find
export str_rfind
export str_count
export str_startswith
export str_endswith
export str_center
export str_ljust
export str_rjust
export str_zfill
export str_isdigit
export str_isalpha
export str_isalnum
export str_isspace
export str_isupper
export str_islower
export str_title
export str_capitalize
export str_swapcase
export str_expandtabs
export str_slice
export str_multiply
export str_ord
export str_chr
export str_repr_int
export str_format_simple

func str_upper(s) then
    var result = ""
    var i = 0
    var n = len(s)
    while i < n then
        var c = str_get(s, i)
        if c >= 97 then
            if c <= 122 then
                c = c - 32
            end
        end
        result = str_cat(result, char_to_str(c))
        i = i + 1
    end
    return result
end

func str_lower(s) then
    var result = ""
    var i = 0
    var n = len(s)
    while i < n then
        var c = str_get(s, i)
        if c >= 65 then
            if c <= 90 then
                c = c + 32
            end
        end
        result = str_cat(result, char_to_str(c))
        i = i + 1
    end
    return result
end

func _is_whitespace(c) then
    if c == 32 then return 1 end
    if c == 9 then return 1 end
    if c == 10 then return 1 end
    if c == 13 then return 1 end
    return 0
end

func str_strip(s) then
    var n = len(s)
    var start = 0
    while start < n then
        if _is_whitespace(str_get(s, start)) == 0 then
            start = n + 1
        else
            start = start + 1
        end
    end
    if start > n then start = start - 1 end
    if start >= n then return "" end
    
    var end_i = n - 1
    while end_i >= start then
        if _is_whitespace(str_get(s, end_i)) == 0 then
            end_i = 0 - 2
        else
            end_i = end_i - 1
        end
    end
    if end_i < 0 then end_i = end_i + 1 end
    
    var result = ""
    var i = start
    while i <= end_i then
        result = str_cat(result, char_to_str(str_get(s, i)))
        i = i + 1
    end
    return result
end

func str_lstrip(s) then
    var n = len(s)
    var start = 0
    while start < n then
        if _is_whitespace(str_get(s, start)) == 0 then
            start = n + 1
        else
            start = start + 1
        end
    end
    if start > n then start = start - 1 end
    var result = ""
    var i = start
    while i < n then
        result = str_cat(result, char_to_str(str_get(s, i)))
        i = i + 1
    end
    return result
end

func str_rstrip(s) then
    var n = len(s)
    var end_i = n - 1
    while end_i >= 0 then
        if _is_whitespace(str_get(s, end_i)) == 0 then
            end_i = 0 - 2
        else
            end_i = end_i - 1
        end
    end
    if end_i < 0 then end_i = end_i + 1 end
    var result = ""
    var i = 0
    while i <= end_i then
        result = str_cat(result, char_to_str(str_get(s, i)))
        i = i + 1
    end
    return result
end

func str_split(s, sep) then
    # Returns items in split_results array, returns count
    var result = []
    var current = ""
    var i = 0
    var n = len(s)
    while i < n then
        var c = str_get(s, i)
        if c == sep then
            push(result, current)
            current = ""
        else
            current = str_cat(current, char_to_str(c))
        end
        i = i + 1
    end
    push(result, current)
    return result
end

func str_join(sep, arr, count) then
    var result = ""
    var i = 0
    while i < count then
        if i > 0 then
            result = str_cat(result, sep)
        end
        result = str_cat(result, arr[i])
        i = i + 1
    end
    return result
end

func str_replace(s, old_s, new_s) then
    var result = ""
    var slen = len(s)
    var olen = len(old_s)
    var i = 0
    while i < slen then
        if i + olen <= slen then
            var match = 1
            var j = 0
            while j < olen then
                if str_get(s, i + j) != str_get(old_s, j) then
                    match = 0
                    j = olen
                end
                j = j + 1
            end
            if match == 1 then
                result = str_cat(result, new_s)
                i = i + olen
            else
                result = str_cat(result, char_to_str(str_get(s, i)))
                i = i + 1
            end
        else
            result = str_cat(result, char_to_str(str_get(s, i)))
            i = i + 1
        end
    end
    return result
end

func str_find(s, sub) then
    var slen = len(s)
    var sublen = len(sub)
    if sublen == 0 then return 0 end
    if sublen > slen then return 0 - 1 end
    var i = 0
    while i <= slen - sublen then
        var match = 1
        var j = 0
        while j < sublen then
            if str_get(s, i + j) != str_get(sub, j) then
                match = 0
                j = sublen
            end
            j = j + 1
        end
        if match == 1 then return i end
        i = i + 1
    end
    return 0 - 1
end

func str_rfind(s, sub) then
    var slen = len(s)
    var sublen = len(sub)
    if sublen == 0 then return slen end
    if sublen > slen then return 0 - 1 end
    var i = slen - sublen
    while i >= 0 then
        var match = 1
        var j = 0
        while j < sublen then
            if str_get(s, i + j) != str_get(sub, j) then
                match = 0
                j = sublen
            end
            j = j + 1
        end
        if match == 1 then return i end
        i = i - 1
    end
    return 0 - 1
end

func str_count(s, sub) then
    var slen = len(s)
    var sublen = len(sub)
    if sublen == 0 then return 0 end
    var count = 0
    var i = 0
    while i <= slen - sublen then
        var match = 1
        var j = 0
        while j < sublen then
            if str_get(s, i + j) != str_get(sub, j) then
                match = 0
                j = sublen
            end
            j = j + 1
        end
        if match == 1 then
            count = count + 1
            i = i + sublen
        else
            i = i + 1
        end
    end
    return count
end

func str_startswith(s, prefix) then
    var sl = len(s)
    var pl = len(prefix)
    if pl > sl then return 0 end
    var i = 0
    while i < pl then
        if str_get(s, i) != str_get(prefix, i) then return 0 end
        i = i + 1
    end
    return 1
end

func str_endswith(s, suffix) then
    var sl = len(s)
    var sufl = len(suffix)
    if sufl > sl then return 0 end
    var off = sl - sufl
    var i = 0
    while i < sufl then
        if str_get(s, off + i) != str_get(suffix, i) then return 0 end
        i = i + 1
    end
    return 1
end

func str_center(s, width, pad_c) then
    var n = len(s)
    if n >= width then return s end
    var total_pad = width - n
    var left = total_pad / 2
    var right = total_pad - left
    var result = ""
    var i = 0
    while i < left then
        result = str_cat(result, char_to_str(pad_c))
        i = i + 1
    end
    result = str_cat(result, s)
    i = 0
    while i < right then
        result = str_cat(result, char_to_str(pad_c))
        i = i + 1
    end
    return result
end

func str_ljust(s, width, pad_c) then
    var n = len(s)
    if n >= width then return s end
    var result = s
    var i = n
    while i < width then
        result = str_cat(result, char_to_str(pad_c))
        i = i + 1
    end
    return result
end

func str_rjust(s, width, pad_c) then
    var n = len(s)
    if n >= width then return s end
    var result = ""
    var i = 0
    while i < width - n then
        result = str_cat(result, char_to_str(pad_c))
        i = i + 1
    end
    return str_cat(result, s)
end

func str_zfill(s, width) then
    return str_rjust(s, width, 48)
end

func str_isdigit(s) then
    var n = len(s)
    if n == 0 then return 0 end
    var i = 0
    while i < n then
        var c = str_get(s, i)
        if c < 48 then return 0 end
        if c > 57 then return 0 end
        i = i + 1
    end
    return 1
end

func str_isalpha(s) then
    var n = len(s)
    if n == 0 then return 0 end
    var i = 0
    while i < n then
        var c = str_get(s, i)
        var ok = 0
        if c >= 65 then
            if c <= 90 then ok = 1 end
        end
        if c >= 97 then
            if c <= 122 then ok = 1 end
        end
        if ok == 0 then return 0 end
        i = i + 1
    end
    return 1
end

func str_isalnum(s) then
    var n = len(s)
    if n == 0 then return 0 end
    var i = 0
    while i < n then
        var c = str_get(s, i)
        var ok = 0
        if c >= 48 then
            if c <= 57 then ok = 1 end
        end
        if c >= 65 then
            if c <= 90 then ok = 1 end
        end
        if c >= 97 then
            if c <= 122 then ok = 1 end
        end
        if ok == 0 then return 0 end
        i = i + 1
    end
    return 1
end

func str_isspace(s) then
    var n = len(s)
    if n == 0 then return 0 end
    var i = 0
    while i < n then
        if _is_whitespace(str_get(s, i)) == 0 then return 0 end
        i = i + 1
    end
    return 1
end

func str_isupper(s) then
    var n = len(s)
    if n == 0 then return 0 end
    var has_alpha = 0
    var i = 0
    while i < n then
        var c = str_get(s, i)
        if c >= 97 then
            if c <= 122 then return 0 end
        end
        if c >= 65 then
            if c <= 90 then has_alpha = 1 end
        end
        i = i + 1
    end
    return has_alpha
end

func str_islower(s) then
    var n = len(s)
    if n == 0 then return 0 end
    var has_alpha = 0
    var i = 0
    while i < n then
        var c = str_get(s, i)
        if c >= 65 then
            if c <= 90 then return 0 end
        end
        if c >= 97 then
            if c <= 122 then has_alpha = 1 end
        end
        i = i + 1
    end
    return has_alpha
end

func str_title(s) then
    var result = ""
    var n = len(s)
    var capitalize_next = 1
    var i = 0
    while i < n then
        var c = str_get(s, i)
        if _is_whitespace(c) == 1 then
            result = str_cat(result, char_to_str(c))
            capitalize_next = 1
        else
            if capitalize_next == 1 then
                if c >= 97 then
                    if c <= 122 then
                        c = c - 32
                    end
                end
                capitalize_next = 0
            else
                if c >= 65 then
                    if c <= 90 then
                        c = c + 32
                    end
                end
            end
            result = str_cat(result, char_to_str(c))
        end
        i = i + 1
    end
    return result
end

func str_capitalize(s) then
    var n = len(s)
    if n == 0 then return "" end
    var c = str_get(s, 0)
    if c >= 97 then
        if c <= 122 then
            c = c - 32
        end
    end
    var result = char_to_str(c)
    var i = 1
    while i < n then
        var ch = str_get(s, i)
        if ch >= 65 then
            if ch <= 90 then
                ch = ch + 32
            end
        end
        result = str_cat(result, char_to_str(ch))
        i = i + 1
    end
    return result
end

func str_swapcase(s) then
    var result = ""
    var i = 0
    var n = len(s)
    while i < n then
        var c = str_get(s, i)
        if c >= 65 then
            if c <= 90 then
                c = c + 32
            end
        else
            if c >= 97 then
                if c <= 122 then
                    c = c - 32
                end
            end
        end
        result = str_cat(result, char_to_str(c))
        i = i + 1
    end
    return result
end

func str_expandtabs(s, tabsize) then
    var result = ""
    var i = 0
    var n = len(s)
    while i < n then
        var c = str_get(s, i)
        if c == 9 then
            var j = 0
            while j < tabsize then
                result = str_cat(result, " ")
                j = j + 1
            end
        else
            result = str_cat(result, char_to_str(c))
        end
        i = i + 1
    end
    return result
end

func str_slice(s, start, end_val) then
    var n = len(s)
    if start < 0 then start = n + start end
    if end_val < 0 then end_val = n + end_val end
    if start < 0 then start = 0 end
    if end_val > n then end_val = n end
    var result = ""
    var i = start
    while i < end_val then
        result = str_cat(result, char_to_str(str_get(s, i)))
        i = i + 1
    end
    return result
end

func str_multiply(s, count) then
    var result = ""
    var i = 0
    while i < count then
        result = str_cat(result, s)
        i = i + 1
    end
    return result
end

func str_ord(s) then
    if len(s) == 0 then return 0 end
    return str_get(s, 0)
end

func str_chr(code) then
    return char_to_str(code)
end

func str_repr_int(n) then
    if n == 0 then return "0" end
    var neg = 0
    if n < 0 then
        neg = 1
        n = 0 - n
    end
    var buf = ""
    while n > 0 then
        buf = str_cat(char_to_str(48 + n % 10), buf)
        n = n / 10
    end
    if neg == 1 then
        buf = str_cat("-", buf)
    end
    return buf
end

func str_format_simple(template, arg1, arg2, arg3) then
    # Replace {} placeholders with arguments (up to 3)
    var result = ""
    var n = len(template)
    var arg_idx = 0
    var i = 0
    while i < n then
        var c = str_get(template, i)
        if c == 123 then
            # Check for }
            if i + 1 < n then
                if str_get(template, i + 1) == 125 then
                    if arg_idx == 0 then
                        result = str_cat(result, str_repr_int(arg1))
                    end
                    if arg_idx == 1 then
                        result = str_cat(result, str_repr_int(arg2))
                    end
                    if arg_idx == 2 then
                        result = str_cat(result, str_repr_int(arg3))
                    end
                    arg_idx = arg_idx + 1
                    i = i + 2
                else
                    result = str_cat(result, char_to_str(c))
                    i = i + 1
                end
            else
                result = str_cat(result, char_to_str(c))
                i = i + 1
            end
        else
            result = str_cat(result, char_to_str(c))
            i = i + 1
        end
    end
    return result
end
