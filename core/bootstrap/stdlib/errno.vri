# ============================================================
# Vir Standard Library: errno - Error codes and handling
# Equivalent to C's <errno.h>
# ============================================================
module errno
export E_OK
export E_PERM
export E_NOENT
export E_IO
export E_BADF
export E_NOMEM
export E_ACCES
export E_EXIST
export E_NOTDIR
export E_ISDIR
export E_INVAL
export E_NFILE
export E_MFILE
export E_NOSPC
export E_RANGE
export E_NAMETOOLONG
export E_OVERFLOW
export errno_val
export set_errno
export get_errno
export strerror

var errno_val = 0

var E_OK = 0
var E_PERM = 1
var E_NOENT = 2
var E_IO = 5
var E_BADF = 9
var E_NOMEM = 12
var E_ACCES = 13
var E_EXIST = 17
var E_NOTDIR = 20
var E_ISDIR = 21
var E_INVAL = 22
var E_NFILE = 23
var E_MFILE = 24
var E_NOSPC = 28
var E_RANGE = 34
var E_NAMETOOLONG = 63
var E_OVERFLOW = 84

func set_errno(code) then
    errno_val = code
end

func get_errno() then
    return errno_val
end

func strerror(code) then
    if code == 0 then return "Success" end
    if code == 1 then return "Operation not permitted" end
    if code == 2 then return "No such file or directory" end
    if code == 5 then return "Input/output error" end
    if code == 9 then return "Bad file descriptor" end
    if code == 12 then return "Cannot allocate memory" end
    if code == 13 then return "Permission denied" end
    if code == 17 then return "File exists" end
    if code == 20 then return "Not a directory" end
    if code == 21 then return "Is a directory" end
    if code == 22 then return "Invalid argument" end
    if code == 23 then return "Too many open files in system" end
    if code == 24 then return "Too many open files" end
    if code == 28 then return "No space left on device" end
    if code == 34 then return "Numerical result out of range" end
    if code == 63 then return "File name too long" end
    if code == 84 then return "Value too large for defined data type" end
    return "Unknown error"
end
