# ============================================================
# Vir Standard Library: format - Advanced formatting utilities
# Equivalent to C's sprintf / Python's str.format
# ============================================================
module format
export fmt_int
export fmt_hex
export fmt_oct
export fmt_bin
export fmt_pad
export fmt_center
export fmt_left
export fmt_right
export fmt_table_row
export fmt_separator
export fmt_bar
export fmt_progress
export fmt_human_size
export fmt_duration

func fmt_int(n) then
    if n == 0 then return "0" end
    var neg = 0
    if n < 0 then
        neg = 1
        n = 0 - n
    end
    var result = ""
    while n > 0 then
        var d = n % 10
        result = str_cat(char_to_str(d + 48), result)
        n = n / 10
    end
    if neg == 1 then
        result = str_cat("-", result)
    end
    return result
end

func fmt_hex(n) then
    if n == 0 then return "0x0" end
    var hex_chars = "0123456789abcdef"
    var result = ""
    var val = n
    if val < 0 then val = 0 - val end
    while val > 0 then
        var d = val % 16
        result = str_cat(char_to_str(str_get(hex_chars, d)), result)
        val = val / 16
    end
    return str_cat("0x", result)
end

func fmt_oct(n) then
    if n == 0 then return "0o0" end
    var result = ""
    var val = n
    if val < 0 then val = 0 - val end
    while val > 0 then
        var d = val % 8
        result = str_cat(char_to_str(d + 48), result)
        val = val / 8
    end
    return str_cat("0o", result)
end

func fmt_bin(n) then
    if n == 0 then return "0b0" end
    var result = ""
    var val = n
    if val < 0 then val = 0 - val end
    while val > 0 then
        var d = val % 2
        result = str_cat(char_to_str(d + 48), result)
        val = val / 2
    end
    return str_cat("0b", result)
end

func fmt_pad(s, width, pad_char, align) then
    # align: 0=right, 1=left, 2=center
    var n = len(s)
    if n >= width then return s end
    var pads = width - n
    if align == 1 then
        # Left align: pad on right
        var result = s
        var i = 0
        while i < pads then
            result = str_cat(result, char_to_str(pad_char))
            i = i + 1
        end
        return result
    end
    if align == 2 then
        # Center
        var left_p = pads / 2
        var right_p = pads - left_p
        var result = ""
        var i = 0
        while i < left_p then
            result = str_cat(result, char_to_str(pad_char))
            i = i + 1
        end
        result = str_cat(result, s)
        i = 0
        while i < right_p then
            result = str_cat(result, char_to_str(pad_char))
            i = i + 1
        end
        return result
    end
    # Right align (default)
    var result = ""
    var i = 0
    while i < pads then
        result = str_cat(result, char_to_str(pad_char))
        i = i + 1
    end
    return str_cat(result, s)
end

func fmt_center(s, width) then
    return fmt_pad(s, width, 32, 2)
end

func fmt_left(s, width) then
    return fmt_pad(s, width, 32, 1)
end

func fmt_right(s, width) then
    return fmt_pad(s, width, 32, 0)
end

func fmt_table_row(col1, w1, col2, w2, col3, w3) then
    var row = "| "
    row = str_cat(row, fmt_left(col1, w1))
    row = str_cat(row, " | ")
    row = str_cat(row, fmt_left(col2, w2))
    row = str_cat(row, " | ")
    row = str_cat(row, fmt_left(col3, w3))
    row = str_cat(row, " |")
    return row
end

func fmt_separator(width) then
    var result = "+"
    var i = 0
    while i < width then
        result = str_cat(result, "-")
        i = i + 1
    end
    result = str_cat(result, "+")
    return result
end

func fmt_bar(value, max_val, width) then
    var filled = 0
    if max_val > 0 then
        filled = value * width / max_val
    end
    if filled > width then filled = width end
    var result = "["
    var i = 0
    while i < filled then
        result = str_cat(result, "#")
        i = i + 1
    end
    while i < width then
        result = str_cat(result, ".")
        i = i + 1
    end
    result = str_cat(result, "]")
    return result
end

func fmt_progress(current, total, width) then
    var pct = 0
    if total > 0 then
        pct = current * 100 / total
    end
    var bar = fmt_bar(current, total, width)
    var pct_str = fmt_int(pct)
    return str_cat(str_cat(bar, " "), str_cat(pct_str, "%"))
end

func fmt_human_size(bytes) then
    if bytes < 1024 then
        return str_cat(fmt_int(bytes), " B")
    end
    if bytes < 1048576 then
        return str_cat(fmt_int(bytes / 1024), " KB")
    end
    if bytes < 1073741824 then
        return str_cat(fmt_int(bytes / 1048576), " MB")
    end
    return str_cat(fmt_int(bytes / 1073741824), " GB")
end

func fmt_duration(ms) then
    if ms < 1000 then
        return str_cat(fmt_int(ms), "ms")
    end
    if ms < 60000 then
        var secs = ms / 1000
        var rem = (ms % 1000) / 100
        return str_cat(str_cat(str_cat(fmt_int(secs), "."), fmt_int(rem)), "s")
    end
    var mins = ms / 60000
    var secs = (ms % 60000) / 1000
    return str_cat(str_cat(str_cat(fmt_int(mins), "m"), fmt_int(secs)), "s")
end
