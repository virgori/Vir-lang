# ============================================================
# Vir Standard Library: pylist - Python-like list operations
# Equivalent to Python's list methods + builtins
# ============================================================
module pylist
export list_append
export list_extend
export list_insert
export list_remove
export list_pop
export list_clear
export list_index
export list_count
export list_reverse
export list_sort
export list_copy
export list_len
export list_map
export list_filter_positive
export list_reduce_sum
export list_reduce_product
export list_any_positive
export list_all_positive
export list_zip
export list_enumerate
export list_range
export list_range_step
export list_min
export list_max
export list_sum
export list_slice
export list_flatten
export list_repeat
export list_print

# We use arrays with a separate size tracker
# Convention: arr[0..size-1] are valid elements

func list_append(arr, size, val) then
    arr[size] = val
    return size + 1
end

func list_extend(arr, size, src, src_size) then
    var i = 0
    while i < src_size then
        arr[size + i] = src[i]
        i = i + 1
    end
    return size + src_size
end

func list_insert(arr, size, idx, val) then
    # Shift elements right
    var i = size
    while i > idx then
        arr[i] = arr[i - 1]
        i = i - 1
    end
    arr[idx] = val
    return size + 1
end

func list_remove(arr, size, val) then
    # Remove first occurrence
    var i = 0
    while i < size then
        if arr[i] == val then
            # Shift left
            var j = i
            while j < size - 1 then
                arr[j] = arr[j + 1]
                j = j + 1
            end
            return size - 1
        end
        i = i + 1
    end
    return size
end

func list_pop(arr, size) then
    if size == 0 then return 0 end
    return arr[size - 1]
end

func list_pop_size(size) then
    if size == 0 then return 0 end
    return size - 1
end

func list_clear(arr, size) then
    var i = 0
    while i < size then
        arr[i] = 0
        i = i + 1
    end
    return 0
end

func list_index(arr, size, val) then
    var i = 0
    while i < size then
        if arr[i] == val then return i end
        i = i + 1
    end
    return 0 - 1
end

func list_count(arr, size, val) then
    var c = 0
    var i = 0
    while i < size then
        if arr[i] == val then
            c = c + 1
        end
        i = i + 1
    end
    return c
end

func list_reverse(arr, size) then
    var i = 0
    var j = size - 1
    while i < j then
        var tmp = arr[i]
        arr[i] = arr[j]
        arr[j] = tmp
        i = i + 1
        j = j - 1
    end
end

func _qs_part(arr, lo, hi) then
    var pivot = arr[hi]
    var i = lo - 1
    var j = lo
    while j < hi then
        if arr[j] <= pivot then
            i = i + 1
            var tmp = arr[i]
            arr[i] = arr[j]
            arr[j] = tmp
        end
        j = j + 1
    end
    var tmp = arr[i + 1]
    arr[i + 1] = arr[hi]
    arr[hi] = tmp
    return i + 1
end

func _qs(arr, lo, hi) then
    if lo < hi then
        var p = _qs_part(arr, lo, hi)
        _qs(arr, lo, p - 1)
        _qs(arr, p + 1, hi)
    end
end

func list_sort(arr, size) then
    if size <= 1 then return end
    _qs(arr, 0, size - 1)
end

func list_copy(src, size, dest) then
    var i = 0
    while i < size then
        dest[i] = src[i]
        i = i + 1
    end
    return size
end

func list_len(size) then
    return size
end

# map: multiply each element by factor (generic map)
func list_map(arr, size, factor) then
    var i = 0
    while i < size then
        arr[i] = arr[i] * factor
        i = i + 1
    end
end

# filter: keep only positive values
func list_filter_positive(src, size, dest) then
    var count = 0
    var i = 0
    while i < size then
        if src[i] > 0 then
            dest[count] = src[i]
            count = count + 1
        end
        i = i + 1
    end
    return count
end

func list_reduce_sum(arr, size) then
    var total = 0
    var i = 0
    while i < size then
        total = total + arr[i]
        i = i + 1
    end
    return total
end

func list_reduce_product(arr, size) then
    if size == 0 then return 0 end
    var total = 1
    var i = 0
    while i < size then
        total = total * arr[i]
        i = i + 1
    end
    return total
end

func list_any_positive(arr, size) then
    var i = 0
    while i < size then
        if arr[i] > 0 then return 1 end
        i = i + 1
    end
    return 0
end

func list_all_positive(arr, size) then
    var i = 0
    while i < size then
        if arr[i] <= 0 then return 0 end
        i = i + 1
    end
    return 1
end

func list_zip(a, an, b, bn, dest_a, dest_b) then
    var n = an
    if bn < n then n = bn end
    var i = 0
    while i < n then
        dest_a[i] = a[i]
        dest_b[i] = b[i]
        i = i + 1
    end
    return n
end

func list_enumerate(arr, size, idx_out, val_out) then
    var i = 0
    while i < size then
        idx_out[i] = i
        val_out[i] = arr[i]
        i = i + 1
    end
    return size
end

func list_range(dest, start, end_val) then
    var i = 0
    var v = start
    while v < end_val then
        dest[i] = v
        v = v + 1
        i = i + 1
    end
    return i
end

func list_range_step(dest, start, end_val, step) then
    var i = 0
    var v = start
    if step > 0 then
        while v < end_val then
            dest[i] = v
            v = v + step
            i = i + 1
        end
    else
        while v > end_val then
            dest[i] = v
            v = v + step
            i = i + 1
        end
    end
    return i
end

func list_min(arr, size) then
    if size == 0 then return 0 end
    var m = arr[0]
    var i = 1
    while i < size then
        if arr[i] < m then m = arr[i] end
        i = i + 1
    end
    return m
end

func list_max(arr, size) then
    if size == 0 then return 0 end
    var m = arr[0]
    var i = 1
    while i < size then
        if arr[i] > m then m = arr[i] end
        i = i + 1
    end
    return m
end

func list_sum(arr, size) then
    return list_reduce_sum(arr, size)
end

func list_slice(src, size, start, end_val, dest) then
    if start < 0 then start = size + start end
    if end_val < 0 then end_val = size + end_val end
    if start < 0 then start = 0 end
    if end_val > size then end_val = size end
    var count = 0
    var i = start
    while i < end_val then
        dest[count] = src[i]
        count = count + 1
        i = i + 1
    end
    return count
end

func list_flatten(src_arrs, sizes, num_arrs, dest) then
    var count = 0
    var i = 0
    while i < num_arrs then
        var j = 0
        while j < sizes[i] then
            dest[count] = src_arrs[i * 100 + j]
            count = count + 1
            j = j + 1
        end
        i = i + 1
    end
    return count
end

func list_repeat(dest, val, count) then
    var i = 0
    while i < count then
        dest[i] = val
        i = i + 1
    end
    return count
end

func list_print(arr, size) then
    print("[")
    var i = 0
    while i < size then
        if i > 0 then print(", ") end
        print_i(arr[i])
        i = i + 1
    end
    println("]")
end
