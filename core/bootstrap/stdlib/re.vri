# ============================================================
# Vir Standard Library: re - Regex-like utilities using VPS
# Higher-level pattern matching built on top of vps.vri
# ============================================================
module re
export re_match_digits
export re_match_alpha
export re_match_alnum
export re_match_email_simple
export re_match_ipv4_simple
export re_match_date
export re_match_hex
export re_is_identifier
export re_is_integer
export re_is_phone_us
export re_extract_digits
export re_count_matches
export re_split_by_char
export re_replace_char

# Pre-built VPS patterns for common use cases

# Match a string that is all digits
func re_match_digits(s) then
    var n = len(s)
    if n == 0 then return 0 end
    var i = 0
    while i < n then
        var c = str_get(s, i)
        if c < 48 then return 0 end
        if c > 57 then return 0 end
        i = i + 1
    end
    return 1
end

# Match a string that is all letters
func re_match_alpha(s) then
    var n = len(s)
    if n == 0 then return 0 end
    var i = 0
    while i < n then
        var c = str_get(s, i)
        var ok = 0
        if c >= 65 then
            if c <= 90 then ok = 1 end
        end
        if c >= 97 then
            if c <= 122 then ok = 1 end
        end
        if ok == 0 then return 0 end
        i = i + 1
    end
    return 1
end

# Match alphanumeric string
func re_match_alnum(s) then
    var n = len(s)
    if n == 0 then return 0 end
    var i = 0
    while i < n then
        var c = str_get(s, i)
        var ok = 0
        if c >= 48 then
            if c <= 57 then ok = 1 end
        end
        if c >= 65 then
            if c <= 90 then ok = 1 end
        end
        if c >= 97 then
            if c <= 122 then ok = 1 end
        end
        if ok == 0 then return 0 end
        i = i + 1
    end
    return 1
end

# Simple email check: has @ with text on both sides, dot after @
func re_match_email_simple(s) then
    var n = len(s)
    var at_pos = 0 - 1
    var i = 0
    while i < n then
        if str_get(s, i) == 64 then
            at_pos = i
            i = n
        end
        i = i + 1
    end
    if at_pos <= 0 then return 0 end
    if at_pos >= n - 1 then return 0 end
    # Check for dot after @
    var dot_found = 0
    i = at_pos + 1
    while i < n then
        if str_get(s, i) == 46 then
            dot_found = 1
        end
        i = i + 1
    end
    return dot_found
end

# Simple IPv4: 4 groups of digits separated by dots
func re_match_ipv4_simple(s) then
    var n = len(s)
    var groups = 1
    var digit_count = 0
    var i = 0
    while i < n then
        var c = str_get(s, i)
        if c == 46 then
            if digit_count == 0 then return 0 end
            if digit_count > 3 then return 0 end
            groups = groups + 1
            digit_count = 0
        else
            if c >= 48 then
                if c <= 57 then
                    digit_count = digit_count + 1
                else
                    return 0
                end
            else
                return 0
            end
        end
        i = i + 1
    end
    if digit_count == 0 then return 0 end
    if digit_count > 3 then return 0 end
    if groups == 4 then return 1 end
    return 0
end

# Date format: YYYY-MM-DD
func re_match_date(s) then
    if len(s) != 10 then return 0 end
    var i = 0
    while i < 4 then
        var c = str_get(s, i)
        if c < 48 then return 0 end
        if c > 57 then return 0 end
        i = i + 1
    end
    if str_get(s, 4) != 45 then return 0 end
    i = 5
    while i < 7 then
        var c = str_get(s, i)
        if c < 48 then return 0 end
        if c > 57 then return 0 end
        i = i + 1
    end
    if str_get(s, 7) != 45 then return 0 end
    i = 8
    while i < 10 then
        var c = str_get(s, i)
        if c < 48 then return 0 end
        if c > 57 then return 0 end
        i = i + 1
    end
    return 1
end

# Hex string (0-9, a-f, A-F only)
func re_match_hex(s) then
    var n = len(s)
    if n == 0 then return 0 end
    var i = 0
    while i < n then
        var c = str_get(s, i)
        var ok = 0
        if c >= 48 then
            if c <= 57 then ok = 1 end
        end
        if c >= 65 then
            if c <= 70 then ok = 1 end
        end
        if c >= 97 then
            if c <= 102 then ok = 1 end
        end
        if ok == 0 then return 0 end
        i = i + 1
    end
    return 1
end

# Valid identifier: starts with letter/_, contains letters/digits/_
func re_is_identifier(s) then
    var n = len(s)
    if n == 0 then return 0 end
    var c = str_get(s, 0)
    var ok = 0
    if c == 95 then ok = 1 end
    if c >= 65 then
        if c <= 90 then ok = 1 end
    end
    if c >= 97 then
        if c <= 122 then ok = 1 end
    end
    if ok == 0 then return 0 end
    var i = 1
    while i < n then
        c = str_get(s, i)
        ok = 0
        if c == 95 then ok = 1 end
        if c >= 48 then
            if c <= 57 then ok = 1 end
        end
        if c >= 65 then
            if c <= 90 then ok = 1 end
        end
        if c >= 97 then
            if c <= 122 then ok = 1 end
        end
        if ok == 0 then return 0 end
        i = i + 1
    end
    return 1
end

# Integer (optional minus, followed by digits)
func re_is_integer(s) then
    var n = len(s)
    if n == 0 then return 0 end
    var start = 0
    if str_get(s, 0) == 45 then
        start = 1
        if n == 1 then return 0 end
    end
    var i = start
    while i < n then
        var c = str_get(s, i)
        if c < 48 then return 0 end
        if c > 57 then return 0 end
        i = i + 1
    end
    return 1
end

# US phone: XXX-XXX-XXXX
func re_is_phone_us(s) then
    if len(s) != 12 then return 0 end
    var i = 0
    while i < 3 then
        var c = str_get(s, i)
        if c < 48 then return 0 end
        if c > 57 then return 0 end
        i = i + 1
    end
    if str_get(s, 3) != 45 then return 0 end
    i = 4
    while i < 7 then
        var c = str_get(s, i)
        if c < 48 then return 0 end
        if c > 57 then return 0 end
        i = i + 1
    end
    if str_get(s, 7) != 45 then return 0 end
    i = 8
    while i < 12 then
        var c = str_get(s, i)
        if c < 48 then return 0 end
        if c > 57 then return 0 end
        i = i + 1
    end
    return 1
end

# Extract all digit sequences from a string into dest array
func re_extract_digits(s, dest) then
    var n = len(s)
    var count = 0
    var current = 0
    var in_num = 0
    var i = 0
    while i < n then
        var c = str_get(s, i)
        if c >= 48 then
            if c <= 57 then
                current = current * 10 + (c - 48)
                in_num = 1
            else
                if in_num == 1 then
                    dest[count] = current
                    count = count + 1
                    current = 0
                    in_num = 0
                end
            end
        else
            if in_num == 1 then
                dest[count] = current
                count = count + 1
                current = 0
                in_num = 0
            end
        end
        i = i + 1
    end
    if in_num == 1 then
        dest[count] = current
        count = count + 1
    end
    return count
end

# Count non-overlapping occurrences of a char in string
func re_count_matches(s, c) then
    var count = 0
    var n = len(s)
    var i = 0
    while i < n then
        if str_get(s, i) == c then
            count = count + 1
        end
        i = i + 1
    end
    return count
end

# Split string by character into result array (returns count)
func re_split_by_char(s, delim, result) then
    var n = len(s)
    var count = 0
    var current = ""
    var i = 0
    while i < n then
        var c = str_get(s, i)
        if c == delim then
            result[count] = current
            count = count + 1
            current = ""
        else
            current = str_cat(current, char_to_str(c))
        end
        i = i + 1
    end
    result[count] = current
    count = count + 1
    return count
end

# Replace all occurrences of a character
func re_replace_char(s, old_c, new_c) then
    var result = ""
    var n = len(s)
    var i = 0
    while i < n then
        var c = str_get(s, i)
        if c == old_c then
            result = str_cat(result, char_to_str(new_c))
        else
            result = str_cat(result, char_to_str(c))
        end
        i = i + 1
    end
    return result
end
