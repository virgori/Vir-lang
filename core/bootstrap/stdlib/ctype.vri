# ============================================================
# Vir Standard Library: ctype (Character classification)
# Equivalent to C's <ctype.h>
# ============================================================
module ctype
export isalpha
export isdigit
export isalnum
export isspace
export isupper
export islower
export isprint
export iscntrl
export ispunct
export isxdigit
export toupper_c
export tolower_c
export isascii_c

func isalpha(c) then
    if c >= 65 then
        if c <= 90 then return 1 end
    end
    if c >= 97 then
        if c <= 122 then return 1 end
    end
    return 0
end

func isdigit(c) then
    if c >= 48 then
        if c <= 57 then return 1 end
    end
    return 0
end

func isalnum(c) then
    if isalpha(c) == 1 then return 1 end
    if isdigit(c) == 1 then return 1 end
    return 0
end

func isspace(c) then
    if c == 32 then return 1 end
    if c == 9 then return 1 end
    if c == 10 then return 1 end
    if c == 13 then return 1 end
    if c == 11 then return 1 end
    if c == 12 then return 1 end
    return 0
end

func isupper(c) then
    if c >= 65 then
        if c <= 90 then return 1 end
    end
    return 0
end

func islower(c) then
    if c >= 97 then
        if c <= 122 then return 1 end
    end
    return 0
end

func isprint(c) then
    if c >= 32 then
        if c <= 126 then return 1 end
    end
    return 0
end

func iscntrl(c) then
    if c < 32 then return 1 end
    if c == 127 then return 1 end
    return 0
end

func ispunct(c) then
    if isprint(c) == 1 then
        if isalnum(c) == 0 then
            if c != 32 then
                return 1
            end
        end
    end
    return 0
end

func isxdigit(c) then
    if isdigit(c) == 1 then return 1 end
    if c >= 65 then
        if c <= 70 then return 1 end
    end
    if c >= 97 then
        if c <= 102 then return 1 end
    end
    return 0
end

func toupper_c(c) then
    if islower(c) == 1 then
        return c - 32
    end
    return c
end

func tolower_c(c) then
    if isupper(c) == 1 then
        return c + 32
    end
    return c
end

func isascii_c(c) then
    if c >= 0 then
        if c <= 127 then return 1 end
    end
    return 0
end
