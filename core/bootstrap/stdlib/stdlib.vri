# ============================================================
# Vir Standard Library: stdlib (C-like general utilities)
# Equivalent to C's <stdlib.h>
# ============================================================
module stdlib
export malloc_c
export calloc_c
export free_c
export realloc_c
export atoi
export atol
export itoa
export abs_c
export rand_c
export srand_c
export qsort
export bsearch_arr
export exit_c
export getenv_c
export memset_c
export memcpy_c
export memmove_c

# ---- Memory allocation ----
func malloc_c(size) then
    return alloc(size)
end

func calloc_c(count, size) then
    var total = count * size
    var ptr = alloc(total)
    var i = 0
    while i < total then
        write_byte(ptr, i, 0)
        i = i + 1
    end
    return ptr
end

func free_c(ptr) then
    dealloc(ptr)
    return 0
end

func realloc_c(ptr, old_size, new_size) then
    var new_ptr = alloc(new_size)
    var copy_size = old_size
    if new_size < copy_size then
        copy_size = new_size
    end
    var i = 0
    while i < copy_size then
        write_byte(new_ptr, i, read_byte(ptr, i))
        i = i + 1
    end
    dealloc(ptr)
    return new_ptr
end

# ---- Conversion functions ----
func atoi(s) then
    var result = 0
    var sign = 1
    var i = 0
    var n = len(s)
    # Skip whitespace
    while i < n then
        var c = str_get(s, i)
        if c != 32 then
            if c != 9 then
                if c != 10 then
                    i = n
                end
            end
        end
        if i < n then
            i = i + 1
        end
    end
    # Handle sign
    if i < n then
        if str_get(s, i) == 45 then
            sign = 0 - 1
            i = i + 1
        else
            if str_get(s, i) == 43 then
                i = i + 1
            end
        end
    end
    # Parse digits
    while i < n then
        var c = str_get(s, i)
        if c < 48 then
            return result * sign
        end
        if c > 57 then
            return result * sign
        end
        result = result * 10 + (c - 48)
        i = i + 1
    end
    return result * sign
end

func atol(s) then
    return atoi(s)
end

func itoa(n) then
    return i_to_str(n)
end

# ---- Math utilities ----
func abs_c(n) then
    if n < 0 then
        return 0 - n
    end
    return n
end

# ---- Pseudo-random number generator (LCG) ----
var rand_state = 12345

func srand_c(seed) then
    rand_state = seed
    return 0
end

func rand_c() then
    # Linear Congruential Generator
    rand_state = rand_state * 1103515245 + 12345
    var result = (rand_state >> 16) & 32767
    return result
end

func rand_range(min_val, max_val) then
    var r = rand_c()
    return min_val + (r % (max_val - min_val + 1))
end

# ---- Sorting (quicksort on arrays) ----
func qsort(arr, low, high) then
    if low < high then
        var pivot = arr[high]
        var i = low - 1
        var j = low
        while j < high then
            if arr[j] <= pivot then
                i = i + 1
                var tmp = arr[i]
                arr[i] = arr[j]
                arr[j] = tmp
            end
            j = j + 1
        end
        i = i + 1
        var tmp = arr[i]
        arr[i] = arr[high]
        arr[high] = tmp
        qsort(arr, low, i - 1)
        qsort(arr, i + 1, high)
    end
    return 0
end

# ---- Binary search ----
func bsearch_arr(arr, n, target) then
    var low = 0
    var high = n - 1
    while low <= high then
        var mid = (low + high) / 2
        if arr[mid] == target then
            return mid
        end
        if arr[mid] < target then
            low = mid + 1
        else
            high = mid - 1
        end
    end
    return 0 - 1
end

# ---- Memory operations ----
func memset_c(ptr, value, n) then
    var i = 0
    while i < n then
        write_byte(ptr, i, value)
        i = i + 1
    end
    return ptr
end

func memcpy_c(dest, src_ptr, n) then
    var i = 0
    while i < n then
        write_byte(dest, i, read_byte(src_ptr, i))
        i = i + 1
    end
    return dest
end

func memmove_c(dest, src_ptr, n) then
    if dest == src_ptr then
        return dest
    end
    # Copy to temp buffer first to handle overlapping
    var tmp = alloc(n)
    var i = 0
    while i < n then
        write_byte(tmp, i, read_byte(src_ptr, i))
        i = i + 1
    end
    i = 0
    while i < n then
        write_byte(dest, i, read_byte(tmp, i))
        i = i + 1
    end
    dealloc(tmp)
    return dest
end

func memcmp_c(a, b, n) then
    var i = 0
    while i < n then
        var ca = read_byte(a, i)
        var cb = read_byte(b, i)
        if ca != cb then
            return ca - cb
        end
        i = i + 1
    end
    return 0
end

# ---- Exit ----
func exit_c(code) then
    syscall(1, code)
    return 0
end
