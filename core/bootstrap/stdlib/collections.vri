# ========================================
# Counter - count occurrences (int values 0-255)
# ========================================

var COUNTER_SIZE = 256
var _counter = []

func counter_create() then
    _counter = []
    var i = 0
    while i < COUNTER_SIZE then
        push(_counter, 0)
        i = i + 1
    end
end

func counter_add(val) then
    if val >= 0 then
        if val < COUNTER_SIZE then
            _counter[val] = _counter[val] + 1
        end
    end
end

func counter_get(val) then
    if val >= 0 then
        if val < COUNTER_SIZE then
            return _counter[val]
        end
    end
    return 0
end

func counter_most_common() then
    # Find value with highest count
    var best_val = 0
    var best_count = 0
    var i = 0
    while i < COUNTER_SIZE then
        if _counter[i] > best_count then
            best_count = _counter[i]
            best_val = i
        end
        i = i + 1
    end
    return best_val
end

func counter_total() then
    var total = 0
    var i = 0
    while i < COUNTER_SIZE then
        total = total + _counter[i]
        i = i + 1
    end
    return total
end

# ========================================
# Deque (double-ended queue, circular buffer)
# ========================================

var DEQUE_CAP = 1024
var _deque_data = []
var _deque_head = 0
var _deque_tail = 0
var _deque_sz = 0

func deque_create() then
    _deque_data = []
    _deque_head = 0
    _deque_tail = 0
    _deque_sz = 0
    var i = 0
    while i < DEQUE_CAP then
        push(_deque_data, 0)
        i = i + 1
    end
end

func deque_append(val) then
    if _deque_sz >= DEQUE_CAP then return 0 end
    _deque_data[_deque_tail] = val
    _deque_tail = (_deque_tail + 1) % DEQUE_CAP
    _deque_sz = _deque_sz + 1
    return 1
end

func deque_appendleft(val) then
    if _deque_sz >= DEQUE_CAP then return 0 end
    _deque_head = (_deque_head - 1 + DEQUE_CAP) % DEQUE_CAP
    _deque_data[_deque_head] = val
    _deque_sz = _deque_sz + 1
    return 1
end

func deque_pop() then
    if _deque_sz == 0 then return 0 - 1 end
    _deque_tail = (_deque_tail - 1 + DEQUE_CAP) % DEQUE_CAP
    var val = _deque_data[_deque_tail]
    _deque_sz = _deque_sz - 1
    return val
end

func deque_popleft() then
    if _deque_sz == 0 then return 0 - 1 end
    var val = _deque_data[_deque_head]
    _deque_head = (_deque_head + 1) % DEQUE_CAP
    _deque_sz = _deque_sz - 1
    return val
end

func deque_peek() then
    if _deque_sz == 0 then return 0 - 1 end
    return _deque_data[(_deque_tail - 1 + DEQUE_CAP) % DEQUE_CAP]
end

func deque_peekleft() then
    if _deque_sz == 0 then return 0 - 1 end
    return _deque_data[_deque_head]
end

func deque_size() then
    return _deque_sz
end

func deque_clear() then
    _deque_head = 0
    _deque_tail = 0
    _deque_sz = 0
end

# ========================================
# Bitset (compact boolean array, up to 64*16 = 1024 bits)
# ========================================

var BITSET_WORDS = 16
var _bitset = []

func bitset_create() then
    _bitset = []
    var i = 0
    while i < BITSET_WORDS then
        push(_bitset, 0)
        i = i + 1
    end
end

func bitset_set(bit) then
    var word = bit / 64
    var pos = bit % 64
    if word < BITSET_WORDS then
        var mask = 1
        var i = 0
        while i < pos then
            mask = mask * 2
            i = i + 1
        end
        _bitset[word] = _bitset[word] | mask
    end
end

func bitset_clear_bit(bit) then
    var word = bit / 64
    var pos = bit % 64
    if word < BITSET_WORDS then
        var mask = 1
        var i = 0
        while i < pos then
            mask = mask * 2
            i = i + 1
        end
        # Invert mask and AND
        _bitset[word] = _bitset[word] & (0 - 1 - mask)
    end
end

func bitset_test(bit) then
    var word = bit / 64
    var pos = bit % 64
    if word >= BITSET_WORDS then return 0 end
    var mask = 1
    var i = 0
    while i < pos then
        mask = mask * 2
        i = i + 1
    end
    if (_bitset[word] & mask) != 0 then return 1 end
    return 0
end

func bitset_and(other) then
    var i = 0
    while i < BITSET_WORDS then
        _bitset[i] = _bitset[i] & other[i]
        i = i + 1
    end
end

func bitset_or(other) then
    var i = 0
    while i < BITSET_WORDS then
        _bitset[i] = _bitset[i] | other[i]
        i = i + 1
    end
end

func bitset_xor(other) then
    var i = 0
    while i < BITSET_WORDS then
        _bitset[i] = _bitset[i] ^ other[i]
        i = i + 1
    end
end

func bitset_count() then
    var total = 0
    var i = 0
    while i < BITSET_WORDS then
        var v = _bitset[i]
        while v != 0 then
            total = total + (v & 1)
            # Logical right shift (unsigned)
            v = v / 2
            if v < 0 then v = 0 end
        end
        i = i + 1
    end
    return total
end

# ========================================
# Matrix (2D array stored as flat array)
# ========================================

var _mat_data = []
var _mat_rows = 0
var _mat_cols = 0

func matrix_create(rows, cols) then
    _mat_rows = rows
    _mat_cols = cols
    _mat_data = []
    var total = rows * cols
    var i = 0
    while i < total then
        push(_mat_data, 0)
        i = i + 1
    end
end

func matrix_get(r, c) then
    return _mat_data[r * _mat_cols + c]
end

func matrix_set(r, c, val) then
    _mat_data[r * _mat_cols + c] = val
end

func matrix_add(other_data) then
    var total = _mat_rows * _mat_cols
    var i = 0
    while i < total then
        _mat_data[i] = _mat_data[i] + other_data[i]
        i = i + 1
    end
end

func matrix_mul_scalar(s) then
    var total = _mat_rows * _mat_cols
    var i = 0
    while i < total then
        _mat_data[i] = _mat_data[i] * s
        i = i + 1
    end
end

func matrix_transpose(dest) then
    var r = 0
    while r < _mat_rows then
        var c = 0
        while c < _mat_cols then
            dest[c * _mat_rows + r] = _mat_data[r * _mat_cols + c]
            c = c + 1
        end
        r = r + 1
    end
end

func matrix_print() then
    var r = 0
    while r < _mat_rows then
        var c = 0
        while c < _mat_cols then
            if c > 0 then print("\t") end
            print_i(_mat_data[r * _mat_cols + c])
            c = c + 1
        end
        println("")
        r = r + 1
    end
end
