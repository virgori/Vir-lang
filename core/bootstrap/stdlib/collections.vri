# ============================================================
# Vir Standard Library: collections - Python-like collections
# Equivalent to Python's collections module
# Provides: Counter, Deque, OrderedDict-like, defaultdict-like
# ============================================================
module collections
export counter_create
export counter_add
export counter_get
export counter_most_common
export counter_total
export deque_create
export deque_append
export deque_appendleft
export deque_pop
export deque_popleft
export deque_peek
export deque_peekleft
export deque_size
export deque_clear
export bitset_create
export bitset_set
