# ============================================================
# Vir Standard Library: Math Functions
# ============================================================

# Absolute value
func abs(n) then
    if n < 0 then
        return 0 - n
    end
    return n
end

# Minimum of two numbers
func min(a, b) then
    if a < b then
        return a
    end
    return b
end

# Maximum of two numbers
func max(a, b) then
    if a > b then
        return a
    end
    return b
end

# Clamp value between min and max
func clamp(val, minval, maxval) then
    if val < minval then
        return minval
    end
    if val > maxval then
        return maxval
    end
    return val
end

# Sign of number: -1, 0, or 1
func sign(n) then
    if n < 0 then
        return 0 - 1
    end
    if n > 0 then
        return 1
    end
    return 0
end

# Integer power: base^exp (exp >= 0)
func pow(base, exp) then
    if exp == 0 then
        return 1
    end
    if exp < 0 then
        return 0
    end
    var result = 1
    var i = 0
    while i < exp then
        result = result * base
        i = i + 1
    end
    return result
end

# Fast exponentiation using binary method
func fastPow(base, exp) then
    if exp == 0 then
        return 1
    end
    if exp < 0 then
        return 0
    end
    var result = 1
    var b = base
    var e = exp
    while e > 0 then
        if (e & 1) == 1 then
            result = result * b
        end
        b = b * b
        e = e >> 1
    end
    return result
end

# Integer square root (floor)
func sqrt(n) then
    if n < 0 then
        return 0 - 1
    end
    if n == 0 then
        return 0
    end
    if n == 1 then
        return 1
    end
    var x = n
    var y = (x + 1) / 2
    while y < x then
        x = y
        y = (x + n / x) / 2
    end
    return x
end

# Greatest common divisor (Euclidean algorithm)
func gcd(a, b) then
    var x = abs(a)
    var y = abs(b)
    while y != 0 then
        var temp = y
        y = x % y
        x = temp
    end
    return x
end

# Least common multiple
func lcm(a, b) then
    if a == 0 then
        return 0
    end
    if b == 0 then
        return 0
    end
    var g = gcd(a, b)
    return abs(a / g * b)
end

# Check if number is even
func isEven(n) then
    return (n & 1) == 0
end

# Check if number is odd
func isOdd(n) then
    return (n & 1) == 1
end

# Check if number is prime (simple trial division)
func isPrime(n) then
    if n < 2 then
        return 0
    end
    if n == 2 then
        return 1
    end
    if (n & 1) == 0 then
        return 0
    end
    var i = 3
    var sqrtn = sqrt(n)
    while i <= sqrtn then
        if n % i == 0 then
            return 0
        end
        i = i + 2
    end
    return 1
end

# Factorial (n!)
func factorial(n) then
    if n < 0 then
        return 0
    end
    if n <= 1 then
        return 1
    end
    var result = 1
    var i = 2
    while i <= n then
        result = result * i
        i = i + 1
    end
    return result
end

# Fibonacci number
func fib(n) then
    if n < 0 then
        return 0
    end
    if n <= 1 then
        return n
    end
    var a = 0
    var b = 1
    var i = 2
    while i <= n then
        var temp = a + b
        a = b
        b = temp
        i = i + 1
    end
    return b
end

# Integer division (floor)
func divFloor(a, b) then
    var q = a / b
    var r = a % b
    if r != 0 then
        if (a < 0) != (b < 0) then
            q = q - 1
        end
    end
    return q
end

# Modulo (always non-negative)
func mod(a, b) then
    var r = a % b
    if r < 0 then
        r = r + abs(b)
    end
    return r
end

# Check if n is power of 2
func isPowerOf2(n) then
    if n <= 0 then
        return 0
    end
    return (n & (n - 1)) == 0
end

# Next power of 2 >= n
func nextPowerOf2(n) then
    if n <= 1 then
        return 1
    end
    var p = 1
    while p < n then
        p = p << 1
    end
    return p
end

# Log base 2 (floor)
func log2(n) then
    if n <= 0 then
        return 0 - 1
    end
    var result = 0
    var x = n
    while x > 1 then
        x = x >> 1
        result = result + 1
    end
    return result
end

# Count number of set bits (popcount)
func popcount(n) then
    var count = 0
    var x = n
    while x != 0 then
        count = count + (x & 1)
        x = x >> 1
    end
    return count
end

# Rotate bits left
func rotateLeft(n, bits, width) then
    var mask = (1 << width) - 1
    var b = bits % width
    return ((n << b) | (n >> (width - b))) & mask
end

# Rotate bits right
func rotateRight(n, bits, width) then
    var mask = (1 << width) - 1
    var b = bits % width
    return ((n >> b) | (n << (width - b))) & mask
end
