# ============================================================
# Vir Standard Library: System Calls (macOS ARM64)
# ============================================================
# macOS ARM64 syscall convention:
# - x16: syscall number
# - x0-x5: arguments
# - x0: return value
# - svc #0x80: invoke kernel
# ============================================================

# macOS syscall numbers (BSD layer uses 0x2000000 offset)
var SYS_exit = 1
var SYS_read = 3
var SYS_write = 4
var SYS_open = 5
var SYS_close = 6
var SYS_mmap = 197

# File descriptors
var STDIN = 0
var STDOUT = 1
var STDERR = 2

# Open flags
var O_RDONLY = 0
var O_WRONLY = 1
var O_RDWR = 2
var O_CREAT = 512
var O_TRUNC = 1024

# mmap protection flags
var PROT_NONE = 0
var PROT_READ = 1
var PROT_WRITE = 2
var PROT_EXEC = 4

# mmap flags
var MAP_SHARED = 1
var MAP_PRIVATE = 2
var MAP_ANON = 4096

# Exit the program with given status code
func sys_exit(code) then
    syscall(SYS_exit, code)
    return 0
end

# Write bytes to file descriptor
# Returns number of bytes written or -1 on error
func sys_write(fd, buf, count) then
    return syscall(SYS_write, fd, buf, count)
end

# Read bytes from file descriptor
# Returns number of bytes read or -1 on error
func sys_read(fd, buf, count) then
    return syscall(SYS_read, fd, buf, count)
end

# Open a file
# Returns file descriptor or -1 on error
func sys_open(path, flags, mode) then
    return syscall(SYS_open, path, flags, mode)
end

# Close a file descriptor
func sys_close(fd) then
    return syscall(SYS_close, fd)
end

# Map memory
func sys_mmap(addr, length, prot, flags, fd, offset) then
    return syscall(SYS_mmap, addr, length, prot, flags, fd, offset)
end

# Allocate memory using mmap (anonymous mapping)
func mem_alloc(size) then
    var prot = PROT_READ | PROT_WRITE
    var flags = MAP_PRIVATE | MAP_ANON
    return sys_mmap(0, size, prot, flags, 0 - 1, 0)
end

# Print string to stdout
func sys_print(s) then
    sys_write(STDOUT, s, len(s))
    return 0
end

# Print string to stderr
func sys_error(s) then
    sys_write(STDERR, s, len(s))
    return 0
end

# Print newline
func sys_newline() then
    sys_write(STDOUT, "\n", 1)
    return 0
end
