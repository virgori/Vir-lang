# ============================================================
# Vir Standard Library: Array Functions
# ============================================================

# Get array length
# Note: For bootstrap compiler, arrays have header at ptr[-2] (cap) and ptr[-1] (len)
# But for simplicity and compatibility, we track length separately

# Create new empty array
func newArray() then
    return []
end

# Append element to array (returns new array pointer)
func append(arr, val) then
    return push(arr, val)
end

# Get first element
func first(arr) then
    return arr[0]
end

# Get last element (requires knowing length)
func last(arr, length) then
    if length == 0 then
        return 0
    end
    return arr[length - 1]
end

# Check if array contains value
func contains(arr, val, length) then
    var i = 0
    while i < length then
        if arr[i] == val then
            return 1
        end
        i = i + 1
    end
    return 0
end

# Find index of value in array, returns -1 if not found
func find(arr, val, length) then
    var i = 0
    while i < length then
        if arr[i] == val then
            return i
        end
        i = i + 1
    end
    return 0 - 1
end

# Count occurrences of value in array
func count(arr, val, length) then
    var c = 0
    var i = 0
    while i < length then
        if arr[i] == val then
            c = c + 1
        end
        i = i + 1
    end
    return c
end

# Sum all elements in array
func sum(arr, length) then
    var s = 0
    var i = 0
    while i < length then
        s = s + arr[i]
        i = i + 1
    end
    return s
end

# Product of all elements in array
func product(arr, length) then
    if length == 0 then
        return 0
    end
    var p = 1
    var i = 0
    while i < length then
        p = p * arr[i]
        i = i + 1
    end
    return p
end

# Find minimum value in array
func minArr(arr, length) then
    if length == 0 then
        return 0
    end
    var m = arr[0]
    var i = 1
    while i < length then
        if arr[i] < m then
            m = arr[i]
        end
        i = i + 1
    end
    return m
end

# Find maximum value in array
func maxArr(arr, length) then
    if length == 0 then
        return 0
    end
    var m = arr[0]
    var i = 1
    while i < length then
        if arr[i] > m then
            m = arr[i]
        end
        i = i + 1
    end
    return m
end

# Reverse array in place
func reverse(arr, length) then
    var i = 0
    var j = length - 1
    while i < j then
        var temp = arr[i]
        arr[i] = arr[j]
        arr[j] = temp
        i = i + 1
        j = j - 1
    end
    return arr
end

# Fill array with value
func fill(arr, val, length) then
    var i = 0
    while i < length then
        arr[i] = val
        i = i + 1
    end
    return arr
end

# Copy array
func copyArray(src, dest, length) then
    var i = 0
    while i < length then
        dest[i] = src[i]
        i = i + 1
    end
    return dest
end

# Swap two elements in array
func swap(arr, i, j) then
    var temp = arr[i]
    arr[i] = arr[j]
    arr[j] = temp
    return arr
end

# Simple bubble sort
func bubbleSort(arr, length) then
    var i = 0
    while i < length - 1 then
        var j = 0
        while j < length - i - 1 then
            if arr[j] > arr[j + 1] then
                var temp = arr[j]
                arr[j] = arr[j + 1]
                arr[j + 1] = temp
            end
            j = j + 1
        end
        i = i + 1
    end
    return arr
end

# Insertion sort
func insertionSort(arr, length) then
    var i = 1
    while i < length then
        var key = arr[i]
        var j = i - 1
        while j >= 0 then
            if arr[j] > key then
                arr[j + 1] = arr[j]
                j = j - 1
            else
                j = 0 - 1
            end
        end
        arr[j + 1] = key
        i = i + 1
    end
    return arr
end

# Check if array is sorted
func isSorted(arr, length) then
    var i = 1
    while i < length then
        if arr[i] < arr[i - 1] then
            return 0
        end
        i = i + 1
    end
    return 1
end

# Binary search (array must be sorted)
# Returns index if found, -1 if not found
func binarySearch(arr, val, length) then
    var low = 0
    var high = length - 1
    while low <= high then
        var mid = (low + high) / 2
        if arr[mid] == val then
            return mid
        end
        if arr[mid] < val then
            low = mid + 1
        else
            high = mid - 1
        end
    end
    return 0 - 1
end

# Create range [start, end) as array
func range(start, endval) then
    var arr = []
    var i = start
    while i < endval then
        arr = push(arr, i)
        i = i + 1
    end
    return arr
end

# Calculate average (integer division)
func average(arr, length) then
    if length == 0 then
        return 0
    end
    return sum(arr, length) / length
end

# Remove duplicates (modifies array, returns new length)
# Array should be sorted first for efficiency
func removeDuplicates(arr, length) then
    if length <= 1 then
        return length
    end
    var writeIdx = 1
    var i = 1
    while i < length then
        if arr[i] != arr[writeIdx - 1] then
            arr[writeIdx] = arr[i]
            writeIdx = writeIdx + 1
        end
        i = i + 1
    end
    return writeIdx
end

# Rotate array left by k positions
func arrRotateLeft(arr, length, k) then
    if length == 0 then
        return arr
    end
    var rot = k % length
    var i = 0
    while i < rot then
        var first = arr[0]
        var j = 0
        while j < length - 1 then
            arr[j] = arr[j + 1]
            j = j + 1
        end
        arr[length - 1] = first
        i = i + 1
    end
    return arr
end

# Rotate array right by k positions
func arrRotateRight(arr, length, k) then
    if length == 0 then
        return arr
    end
    var rot = k % length
    var i = 0
    while i < rot then
        var last = arr[length - 1]
        var j = length - 1
        while j > 0 then
            arr[j] = arr[j - 1]
            j = j - 1
        end
        arr[0] = last
        i = i + 1
    end
    return arr
end
