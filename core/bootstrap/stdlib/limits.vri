# ============================================================
# Vir Standard Library: limits - Type limits and constants
# Equivalent to C's <limits.h> + <float.h> constants
# ============================================================
module limits
export INT_MAX
export INT_MIN
export UINT_MAX
export CHAR_MAX
export CHAR_MIN
export SHORT_MAX
export SHORT_MIN
export LONG_MAX
export LONG_MIN
export WORD_SIZE
export PATH_MAX
export NAME_MAX
export BUF_SIZE
export LINE_MAX
export PI_APPROX
export E_APPROX
export get_int_max
export get_int_min
export get_word_size
export clamp
export min_val
export max_val
export in_range

# 64-bit signed integer limits (Vir uses int64)
var INT_MAX = 9223372036854775807
var INT_MIN = 0 - 9223372036854775807
var UINT_MAX = 0 - 1

# 8-bit char limits
var CHAR_MAX = 127
var CHAR_MIN = 0 - 128

# 16-bit short limits
var SHORT_MAX = 32767
var SHORT_MIN = 0 - 32768

# 64-bit long limits (same as INT for Vir)
var LONG_MAX = 9223372036854775807
var LONG_MIN = 0 - 9223372036854775807

# Platform constants
var WORD_SIZE = 8
var PATH_MAX = 1024
var NAME_MAX = 255
var BUF_SIZE = 4096
var LINE_MAX = 2048

# Math constants (integer approximations scaled by 1000)
var PI_APPROX = 3141
var E_APPROX = 2718

func get_int_max() then
    return INT_MAX
end

func get_int_min() then
    return INT_MIN
end

func get_word_size() then
    return WORD_SIZE
end

func clamp(val, lo, hi) then
    if val < lo then return lo end
    if val > hi then return hi end
    return val
end

func min_val(a, b) then
    if a < b then return a end
    return b
end

func max_val(a, b) then
    if a > b then return a end
    return b
end

func in_range(val, lo, hi) then
    if val >= lo then
        if val <= hi then
            return 1
        end
    end
    return 0
end
