# ============================================================
# Vir Standard Library: functools - Python-like functional tools
# Equivalent to Python's functools module
# ============================================================
module functools
export reduce_sum
export reduce_product
export reduce_max
export reduce_min
export partial_add
export partial_mul
export memoize_fib
export lru_get
export lru_set
export compose_double_inc
export pipe_inc_double
export identity
export constant
export negate
export flip_sub

# reduce: fold array with sum
func reduce_sum(arr, n, initial) then
    var acc = initial
    var i = 0
    while i < n then
        acc = acc + arr[i]
        i = i + 1
    end
    return acc
end

# reduce: fold array with product
func reduce_product(arr, n, initial) then
    var acc = initial
    var i = 0
    while i < n then
        acc = acc * arr[i]
        i = i + 1
    end
    return acc
end

# reduce: fold array with max
func reduce_max(arr, n) then
    if n == 0 then return 0 end
    var acc = arr[0]
    var i = 1
    while i < n then
        if arr[i] > acc then acc = arr[i] end
        i = i + 1
    end
    return acc
end

# reduce: fold array with min
func reduce_min(arr, n) then
    if n == 0 then return 0 end
    var acc = arr[0]
    var i = 1
    while i < n then
        if arr[i] < acc then acc = arr[i] end
        i = i + 1
    end
    return acc
end

# partial: create function that adds a fixed value
func partial_add(x, fixed) then
    return x + fixed
end

# partial: create function that multiplies by fixed value
func partial_mul(x, fixed) then
    return x * fixed
end

# ========================================
# Memoized Fibonacci (table-based)
# ========================================
var FIB_CACHE_SIZE = 100
var _fib_cache = []
var _fib_computed = []

func _fib_init() then
    _fib_cache = []
    _fib_computed = []
    var i = 0
    while i < FIB_CACHE_SIZE then
        push(_fib_cache, 0)
        push(_fib_computed, 0)
        i = i + 1
    end
    _fib_cache[0] = 0
    _fib_cache[1] = 1
    _fib_computed[0] = 1
    _fib_computed[1] = 1
end

func memoize_fib(n) then
    if n < 0 then return 0 end
    if n >= FIB_CACHE_SIZE then
        # Fall back to iterative
        var a = 0
        var b = 1
        var i = 2
        while i <= n then
            var c = a + b
            a = b
            b = c
            i = i + 1
        end
        return b
    end
    if _fib_computed[n] == 1 then
        return _fib_cache[n]
    end
    # Fill up to n iteratively
    var i = 2
    while i <= n then
        if _fib_computed[i] == 0 then
            _fib_cache[i] = _fib_cache[i - 1] + _fib_cache[i - 2]
            _fib_computed[i] = 1
        end
        i = i + 1
    end
    return _fib_cache[n]
end

# ========================================
# Simple LRU Cache (fixed-size key-value)
# ========================================
var LRU_SIZE = 64
var _lru_keys = []
var _lru_vals = []
var _lru_ages = []
var _lru_count = 0
var _lru_clock = 0

func _lru_init() then
    _lru_keys = []
    _lru_vals = []
    _lru_ages = []
    _lru_count = 0
    _lru_clock = 0
    var i = 0
    while i < LRU_SIZE then
        push(_lru_keys, 0 - 1)
        push(_lru_vals, 0)
        push(_lru_ages, 0)
        i = i + 1
    end
end

func lru_get(key) then
    var i = 0
    while i < _lru_count then
        if _lru_keys[i] == key then
            _lru_clock = _lru_clock + 1
            _lru_ages[i] = _lru_clock
            return _lru_vals[i]
        end
        i = i + 1
    end
    return 0 - 999999
end

func lru_set(key, val) then
    # Check if already exists
    var i = 0
    while i < _lru_count then
        if _lru_keys[i] == key then
            _lru_vals[i] = val
            _lru_clock = _lru_clock + 1
            _lru_ages[i] = _lru_clock
            return
        end
        i = i + 1
    end
    # If space available
    if _lru_count < LRU_SIZE then
        _lru_keys[_lru_count] = key
        _lru_vals[_lru_count] = val
        _lru_clock = _lru_clock + 1
        _lru_ages[_lru_count] = _lru_clock
        _lru_count = _lru_count + 1
        return
    end
    # Evict LRU entry
    var oldest_idx = 0
    var oldest_age = _lru_ages[0]
    i = 1
    while i < LRU_SIZE then
        if _lru_ages[i] < oldest_age then
            oldest_age = _lru_ages[i]
            oldest_idx = i
        end
        i = i + 1
    end
    _lru_keys[oldest_idx] = key
    _lru_vals[oldest_idx] = val
    _lru_clock = _lru_clock + 1
    _lru_ages[oldest_idx] = _lru_clock
end

# ========================================
# Composition / Pipe
# ========================================

# compose(f, g)(x) = f(g(x))
# Here: double then increment
func compose_double_inc(x) then
    return x * 2 + 1
end

# pipe(f, g)(x) = g(f(x))
# Here: increment then double
func pipe_inc_double(x) then
    return (x + 1) * 2
end

func identity(x) then
    return x
end

func constant(x, ignored) then
    return x
end

func negate(x) then
    return 0 - x
end

# flip(f)(a, b) = f(b, a) for subtraction
func flip_sub(a, b) then
    return b - a
end
