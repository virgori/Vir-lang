# ============================================================
# Vir Standard Library: Arena Allocator
# ============================================================
# Region-based memory management: allocate many objects in a
# contiguous region, then free the entire region at once.
# Eliminates the need for per-object garbage collection.
#
# Usage:
#   var a = arena_create(1048576)   # 1MB arena
#   var p1 = arena_alloc(a, 64)    # allocate 64 bytes
#   var p2 = arena_alloc(a, 128)   # allocate 128 bytes
#   arena_reset(a)                 # free all allocations (reuse arena)
#   arena_destroy(a)               # release arena memory to OS
# ============================================================

include "sys.vri"

# Arena header layout (in bytes):
#   offset  0: base    — mmap'd region start
#   offset  8: ptr     — current bump pointer
#   offset 16: end_ptr — base + capacity
#   offset 24: cap     — total capacity in bytes
var ARENA_HEADER_SIZE = 32

# Create a new arena with given capacity (bytes).
# Returns a handle (pointer to arena header).
func arena_create(capacity) then
    # Align capacity to page boundary (16KB on M-series)
    var page_size = 16384
    var aligned_cap = ((capacity + page_size - 1) / page_size) * page_size

    # Allocate the backing region via mmap
    var prot = PROT_READ | PROT_WRITE
    var flags = MAP_PRIVATE | MAP_ANON
    var region = syscall(SYS_mmap, 0, aligned_cap, prot, flags, 0 - 1, 0)
    if region < 0 then
        return 0 - 1
    end

    # Allocate a small header (use the region itself, header at front)
    # Layout: [header 32 bytes | ... usable space ...]
    var arena = region
    write_word(arena, 0, region + ARENA_HEADER_SIZE)   # base (after header)
    write_word(arena, 8, region + ARENA_HEADER_SIZE)   # ptr = base (empty)
    write_word(arena, 16, region + aligned_cap)        # end_ptr
    write_word(arena, 24, aligned_cap - ARENA_HEADER_SIZE) # usable capacity

    return arena
end

# Allocate `size` bytes from the arena.
# Returns pointer to allocated memory, or -1 if arena is full.
func arena_alloc(arena, size) then
    # 8-byte alignment
    var aligned = (size + 7) & (0 - 8)

    var ptr = read_word(arena, 8)
    var end_ptr = read_word(arena, 16)

    if ptr + aligned > end_ptr then
        return 0 - 1
    end

    # Bump the pointer
    write_word(arena, 8, ptr + aligned)
    return ptr
end

# Reset arena: free all allocations (O(1), no per-object cost).
# The memory is not returned to the OS — it's reused.
func arena_reset(arena) then
    var base = read_word(arena, 0)
    write_word(arena, 8, base)
    return 0
end

# Destroy arena: release all memory back to the OS.
# After this, the arena handle is invalid.
func arena_destroy(arena) then
    var end_ptr = read_word(arena, 16)
    var total_size = end_ptr - arena
    # munmap (SYS_munmap = 73 on macOS)
    syscall(73, arena, total_size)
    return 0
end

# Query: how many bytes have been allocated from the arena.
func arena_used(arena) then
    var base = read_word(arena, 0)
    var ptr = read_word(arena, 8)
    return ptr - base
end

# Query: how many bytes are free in the arena.
func arena_free_space(arena) then
    var ptr = read_word(arena, 8)
    var end_ptr = read_word(arena, 16)
    return end_ptr - ptr
end

# Query: total usable capacity.
func arena_capacity(arena) then
    return read_word(arena, 24)
end
