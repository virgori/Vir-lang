    end
    if t == TK_DOT:
        out "DOT";
    end
    if t == TK_NEWLINE:
        out "NL";
    end
    if t == TK_IMPORT:
        out "IMPORT";
    end
    if t == TK_FROM:
        out "FROM";
    end
    if t == TK_MODULE:
        out "MODULE";
    end
    if t == TK_EXPORT:
        out "EXPORT";
    end
    if t == TK_ENTITY:
        out "ENTITY";
    end
    if t == TK_METHOD:
        out "METHOD";
    end
    if t == TK_CLASS:
        out "CLASS";
    end
    if t == TK_ASYNC:
        out "ASYNC";
    end
    if t == TK_TASK:
        out "TASK";
    end
    if t == TK_WAIT:
        out "WAIT";
    end
    if t == TK_NOT:
        out "NOT";
    end
    if t == TK_PERCENT:
        out "PERCENT";
    end
    if t == TK_LBRACE:
        out "LBRACE";
    end
    if t == TK_RBRACE:
        out "RBRACE";
    end
    if t == TK_HAS:
        out "HAS";
    end
    if t == TK_SHARE:
        out "SHARE";
    end
    if t == TK_TRY:
        out "TRY";
    end
    if t == TK_ERROR:
        out "ERROR";
    end
    if t == TK_RECORD:
        out "RECORD";
    end
    out "?";
end

# ═══════════════════════════════════════════════════════
# Parser state
# ═══════════════════════════════════════════════════════
var p_pos = 0

# AST output (parallel arrays — flat tree)
# Each node: [type, val, parent, child_start, child_count]
var ast_types = []
var ast_vals  = []
var ast_parents = []
var node_count = 0

func p_peek:
    if p_pos >= tok_count:
        out TK_EOF;
    end
    out tok_types[p_pos];
end

func p_peek_val:
    if p_pos >= tok_count:
        out 0;
    end
    out tok_vals[p_pos];
end

func p_advance:
    var t = tok_types[p_pos]
    p_pos = p_pos + 1
    out t;
end

func p_advance_val:
    var v = tok_vals[p_pos]
    p_pos = p_pos + 1
    out v;
end

func p_expect:
    in(expected)
    var t = p_peek()
    if t == expected:
        p_advance()
        out 1;
    end
    print_str("Parse error: expected ")
    print_str(tok_name(expected))
    print_str(" got ")
    print_str(tok_name(t))
    print_str(" at token #")
    print_str(i_to_str(p_pos))
    print_str("\n")
    out 0;
end

func p_skip_newlines:
    when p_peek() == TK_NEWLINE loop
        p_advance()
    end
    out 0;
end

# Accept ':' or 'then' as block opener (v1.2 + legacy)
func p_expect_block_open:
    var t = p_peek()
    if t == TK_COLON:
        p_advance()
        out 1;
    end
    if t == TK_THEN:
        p_advance()
        out 1;
    end
    print_str("Parse error: expected ':' or 'then', got ")
    print_str(tok_name(t))
    print_str(" at token #")
    print_str(i_to_str(p_pos))
    print_str("\n")
    out 0;
end

func emit_node:
    in(ntype, nval)
    push(ast_types, ntype)
    push(ast_vals, nval)
    push(ast_parents, 0)
    var id = node_count
    node_count = node_count + 1
    out id;
end

# ═══════════════════════════════════════════════════════
# Parser — Recursive Descent
# ═══════════════════════════════════════════════════════

func parse_expr:
    # Simple expression: just primary for now
    var left = parse_primary()
    
    # Binary operators
    var t = p_peek()
    when t == TK_PLUS loop
        p_advance()
        var right = parse_primary()
        var n = emit_node(ND_BINOP, TK_PLUS)
        left = n
        t = p_peek()
    end
    when t == TK_MINUS loop
        p_advance()
        var right = parse_primary()
        var n = emit_node(ND_BINOP, TK_MINUS)
        left = n
        t = p_peek()
    end
    when t == TK_STAR loop
        p_advance()
        var right = parse_primary()
        var n = emit_node(ND_BINOP, TK_STAR)
        left = n
        t = p_peek()
    end
    when t == TK_SLASH loop
        p_advance()
        var right = parse_primary()
        var n = emit_node(ND_BINOP, TK_SLASH)
        left = n
        t = p_peek()
    end
    # Comparison
    if t == TK_EQ:
        p_advance()
        var right = parse_primary()
        left = emit_node(ND_BINOP, TK_EQ)
    end
    if t == TK_NE:
        p_advance()
        var right = parse_primary()
        left = emit_node(ND_BINOP, TK_NE)
    end
    if t == TK_GT:
        p_advance()
        var right = parse_primary()
        left = emit_node(ND_BINOP, TK_GT)
    end
    if t == TK_LT:
        p_advance()
        var right = parse_primary()
        left = emit_node(ND_BINOP, TK_LT)
    end
    if t == TK_GE:
        p_advance()
        var right = parse_primary()
        left = emit_node(ND_BINOP, TK_GE)
    end
    if t == TK_LE:
        p_advance()
        var right = parse_primary()
        left = emit_node(ND_BINOP, TK_LE)
    end
    
    out left;
end

func parse_primary:
    var t = p_peek()
    
    if t == TK_INT:
        var val = p_peek_val()
        p_advance()
        out emit_node(ND_LITERAL, val);
    end
    
    if t == TK_STRING:
        var val = p_peek_val()
        p_advance()
        out emit_node(ND_LITERAL, val);
    end
    
    if t == TK_TRUE:
        p_advance()
        out emit_node(ND_LITERAL, 1);
    end
    
    if t == TK_FALSE:
        p_advance()
        out emit_node(ND_LITERAL, 0);
    end
    
    if t == TK_NONE:
        p_advance()
        out emit_node(ND_LITERAL, 0);
    end
    
    if t == TK_IDENT:
        var name = p_peek_val()
        p_advance()
        # Check for function call
        if p_peek() == TK_LPAREN:
            p_advance()
            var arg_count = 0
            when p_peek() != TK_RPAREN loop
                if arg_count > 0:
                    p_expect(TK_COMMA)
                end
                parse_expr()
                arg_count = arg_count + 1
            end
            p_expect(TK_RPAREN)
            out emit_node(ND_CALL, name);
        end
        # Check for index access
        if p_peek() == TK_LBRACKET:
            p_advance()
            parse_expr()
            p_expect(TK_RBRACKET)
            out emit_node(ND_IDENT, name);
        end
        out emit_node(ND_IDENT, name);
    end
    
    if t == TK_LPAREN:
        p_advance()
        var inner = parse_expr()
        p_expect(TK_RPAREN)
        out inner;
    end
    
    if t == TK_LBRACKET:
        # Array literal []
        p_advance()
        p_expect(TK_RBRACKET)
        out emit_node(ND_LITERAL, 0);
    end
    
    if t == TK_MINUS:
        # Unary minus
        p_advance()
        var inner = parse_primary()
        out emit_node(ND_BINOP, TK_MINUS);
    end
    
    # Fallback
    print_str("Parse error: unexpected token ")
    print_str(tok_name(t))
    print_str(" at #")
    print_str(i_to_str(p_pos))
    print_str("\n")
    p_advance()
    out emit_node(ND_LITERAL, 0);
end

func parse_statement:
    p_skip_newlines()
    var t = p_peek()
    
    if t == TK_EOF:
        out 0;
    end
    
    if t == TK_FUNC:
        p_advance()
        var name = p_peek_val()
        p_advance()
        var param_count = 0
        
        if p_peek() == TK_COLON:
            # v1.2 syntax: func name: [in(params)] body end
            p_advance()
            p_skip_newlines()
            if p_peek() == TK_IN:
                p_advance()
                p_expect(TK_LPAREN)
                when p_peek() != TK_RPAREN loop
                    if param_count > 0:
                        # Accept ; or , as separator
                        if p_peek() == TK_SEMI:
                            p_advance()
                        else
                            if p_peek() == TK_COMMA:
                                p_advance()
                            end
                        end
                    end
                    var pname = p_peek_val()
                    p_advance()
                    # Skip optional type hint :type
                    if p_peek() == TK_COLON:
                        p_advance()
                        p_advance()
                    end
                    emit_node(ND_PARAM, pname)
                    param_count = param_count + 1
                end
                p_expect(TK_RPAREN)
                p_skip_newlines()
            end
        else
            # Legacy syntax: func name(params) then
            p_expect(TK_LPAREN)
            when p_peek() != TK_RPAREN loop
                if param_count > 0:
                    p_expect(TK_COMMA)
                end
                var pname = p_peek_val()
                p_advance()
                emit_node(ND_PARAM, pname)
                param_count = param_count + 1
            end
            p_expect(TK_RPAREN)
            p_expect_block_open()
        end
        
        # Parse body
        var body_count = 0
        p_skip_newlines()
        when p_peek() != TK_END loop
            if p_peek() == TK_EOF:
                break
            end
            parse_statement()
            body_count = body_count + 1
            p_skip_newlines()
        end
        p_expect(TK_END)
        out emit_node(ND_FUNC, name);
    end
    
    if t == TK_VAR:
        p_advance()
        var name = p_peek_val()
        p_advance()
        if p_peek() == TK_ASSIGN:
            p_advance()
            parse_expr()
        end
        out emit_node(ND_VAR, name);
    end
    
    if t == TK_CONST:
        p_advance()
        var name = p_peek_val()
        p_advance()
        if p_peek() == TK_ASSIGN:
            p_advance()
            parse_expr()
        end
        out emit_node(ND_CONST, name);
    end
    
    if t == TK_TYPE:
        p_advance()
        var name = p_peek_val()
        p_advance()
        # Optional ;
        if p_peek() == TK_SEMI:
            p_advance()
        end
        out emit_node(ND_TYPE, name);
    end
    
    if t == TK_IF:
        p_advance()
        parse_expr()
        p_expect_block_open()
        # Then block
        var body_count = 0
        p_skip_newlines()
        when p_peek() != TK_END loop
            if p_peek() == TK_ELSE:
                break
            end
            if p_peek() == TK_ELIF:
                break
            end
            if p_peek() == TK_EIF:
                break
            end
            if p_peek() == TK_EOF:
                break
            end
            parse_statement()
            body_count = body_count + 1
            p_skip_newlines()
        end
        # Else branch
        if p_peek() == TK_ELSE:
            p_advance()
            p_skip_newlines()
            when p_peek() != TK_END loop
                if p_peek() == TK_EOF:
                    break
                end
                parse_statement()
                p_skip_newlines()
            end
        end
        # Handle eif or elif (both accepted)
        if p_peek() == TK_ELIF:
            p_advance()
            parse_expr()
            p_expect_block_open()
            p_skip_newlines()
            when p_peek() != TK_END loop
                if p_peek() == TK_EOF:
                    break
                end
                if p_peek() == TK_ELSE:
                    break
                end
                if p_peek() == TK_ELIF:
                    break
                end
                if p_peek() == TK_EIF:
                    break
                end
                parse_statement()
                p_skip_newlines()
            end
        end
        if p_peek() == TK_EIF:
            p_advance()
            parse_expr()
            p_expect_block_open()
            p_skip_newlines()
            when p_peek() != TK_END loop
                if p_peek() == TK_EOF:
                    break
                end
                if p_peek() == TK_ELSE:
                    break
                end
                if p_peek() == TK_ELIF:
                    break
                end
                if p_peek() == TK_EIF:
                    break
                end
                parse_statement()
                p_skip_newlines()
            end
        end
        # Handle else after eif/elif
        if p_peek() == TK_ELSE:
            p_advance()
            p_skip_newlines()
            when p_peek() != TK_END loop
                if p_peek() == TK_EOF:
                    break
                end
                parse_statement()
                p_skip_newlines()
            end
        end
        p_expect(TK_END)
        out emit_node(ND_IF, 0);
    end
    
    if t == TK_WHILE:
        p_advance()
        parse_expr()
        p_expect_block_open()
        p_skip_newlines()
        when p_peek() != TK_END loop
            if p_peek() == TK_EOF:
                break
            end
            parse_statement()
            p_skip_newlines()
        end
        p_expect(TK_END)
        out emit_node(ND_WHILE, 0);
    end
    
    # v1.2: when COND loop BODY end
    if t == TK_WHEN:
        p_advance()
        parse_expr()
        p_expect(TK_LOOP)
        p_skip_newlines()
        when p_peek() != TK_END loop
            if p_peek() == TK_EOF:
                break
            end
            parse_statement()
            p_skip_newlines()
        end
        p_expect(TK_END)
        out emit_node(ND_WHILE, 0);
    end
    
    if t == TK_LOOP:
        p_advance()
        # v1.2 infinite loop: loop NL body end (no expr)
        # legacy: loop expr then body end
        if p_peek() == TK_NEWLINE:
            # Infinite loop
            p_skip_newlines()
        else
            if p_peek() == TK_COLON:
                p_advance()
                p_skip_newlines()
            else
                parse_expr()
                p_expect_block_open()
            end
        end
        p_skip_newlines()
        when p_peek() != TK_END loop
            if p_peek() == TK_EOF:
                break
            end
            parse_statement()
            p_skip_newlines()
        end
        p_expect(TK_END)
        out emit_node(ND_LOOP, 0);
    end
    
    if t == TK_RETURN:
        p_advance()
        if p_peek() != TK_NEWLINE:
            if p_peek() != TK_END:
                if p_peek() != TK_EOF:
                    if p_peek() != TK_SEMI:
                        parse_expr()
                    end
                end
            end
        end
        # Optional ;
        if p_peek() == TK_SEMI:
            p_advance()
        end
        out emit_node(ND_RETURN, 0);
    end
    
    # v1.2: out expr;
    if t == TK_OUT:
        p_advance()
        if p_peek() != TK_NEWLINE:
            if p_peek() != TK_END:
                if p_peek() != TK_EOF:
                    if p_peek() != TK_SEMI:
                        parse_expr()
                    end
                end
            end
        end
        # Optional ;
        if p_peek() == TK_SEMI:
            p_advance()
        end
        out emit_node(ND_RETURN, 0);
    end
    
    if t == TK_PRINT:
        p_advance()
        parse_expr()
        out emit_node(ND_PRINT, 0);
    end
    
    if t == TK_BREAK:
        p_advance()
        # Optional ;
        if p_peek() == TK_SEMI:
            p_advance()
        end
        out emit_node(ND_RETURN, 0);
    end
    
    # v1.2: skip; (same as continue)
    if t == TK_SKIP:
        p_advance()
        # Optional ;
        if p_peek() == TK_SEMI:
            p_advance()
        end
        out emit_node(ND_RETURN, 0);
    end
    
    if t == TK_INCLUDE:
        p_advance()
        var name = p_peek_val()
        p_advance()
        if p_peek() == TK_SEMI:
            p_advance()
        end
        out emit_node(ND_INCLUDE, name);
    end
    
    if t == TK_ENUM:
        p_advance()
        var name = p_peek_val()
        p_advance()
        # Skip to end
        when p_peek() != TK_END loop
            if p_peek() == TK_EOF:
                break
            end
            p_advance()
        end
        p_expect(TK_END)
        out emit_node(ND_ENUM, name);
    end
    
    # Assignment or expression statement
    if t == TK_IDENT:
        var name = p_peek_val()
        p_advance()
        if p_peek() == TK_ASSIGN:
            p_advance()
            parse_expr()
            out emit_node(ND_ASSIGN, name);
        end
        # Function call as statement
        if p_peek() == TK_LPAREN:
            p_advance()
            var ac = 0
            when p_peek() != TK_RPAREN loop
                if ac > 0:
                    p_expect(TK_COMMA)
                end
                parse_expr()
                ac = ac + 1
            end
            p_expect(TK_RPAREN)
            out emit_node(ND_CALL, name);
        end
        # Index assignment: name[i] = val
        if p_peek() == TK_LBRACKET:
            p_advance()
            parse_expr()
            p_expect(TK_RBRACKET)
            if p_peek() == TK_ASSIGN:
                p_advance()
                parse_expr()
            end
            out emit_node(ND_ASSIGN, name);
        end
        out emit_node(ND_IDENT, name);
    end
    
    # Skip unknown
    p_advance()
    out 0;
end

func parse_program:
    var stmt_count = 0
    p_skip_newlines()
    when p_peek() != TK_EOF loop
        parse_statement()
        stmt_count = stmt_count + 1
        p_skip_newlines()
    end
    out emit_node(ND_PROGRAM, stmt_count);
end

# ═══════════════════════════════════════════════════════
# AST node name
# ═══════════════════════════════════════════════════════

func node_name:
    in(t)
    if t == ND_PROGRAM:
        out "Program";
    end
    if t == ND_FUNC:
        out "FuncDef";
    end
    if t == ND_VAR:
        out "VarDecl";
    end
    if t == ND_CONST:
        out "ConstDecl";
    end
    if t == ND_IF:
        out "If";
    end
    if t == ND_WHILE:
        out "While";
    end
    if t == ND_LOOP:
        out "Loop";
    end
    if t == ND_RETURN:
        out "Return";
    end
    if t == ND_PRINT:
        out "Print";
    end
    if t == ND_ASSIGN:
        out "Assign";
    end
    if t == ND_BINOP:
        out "BinOp";
    end
    if t == ND_CALL:
        out "Call";
    end
    if t == ND_IDENT:
        out "Ident";
    end
    if t == ND_LITERAL:
        out "Literal";
    end
    if t == ND_BLOCK:
        out "Block";
    end
    if t == ND_INCLUDE:
        out "Include";
    end
    if t == ND_TYPE:
        out "TypeDecl";
    end
    if t == ND_ENUM:
        out "EnumDef";
    end
    if t == ND_PARAM:
        out "Param";
    end
    out "?";
end

# ═══════════════════════════════════════════════════════
# Main entry point
# ═══════════════════════════════════════════════════════

func main:
    print_str("╔══════════════════════════════════════════════════╗\n")
    print_str("║  Vir-in-Vir Parser — Self-hosting Bootstrap     ║\n")
    print_str("║  Written in Vir, compiled by Vir C Engine       ║\n")
    print_str("╚══════════════════════════════════════════════════╝\n\n")
    
    # Check command line args
    if arg_count() < 1:
        print_str("Usage: vir run vir_parser.vri <input.vri>\n")
        out 1;
    end
    
    # Read input file
    var filename = get_arg(0)
    print_str("Reading: ")
    print_str(filename)
    print_str("\n")
    
    var fd = file_open(filename, "r")
    if fd == 0:
        print_str("Error: cannot open file\n")
        out 1;
    end
    
    src = file_read(fd)
    file_close(fd)
    src_len = len(src)
    
    print_str("Source: ")
    print_str(i_to_str(src_len))
    print_str(" bytes\n\n")
    
    # Phase 1: Tokenize
    print_str("=== Phase 1: Tokenize ===\n")
    tokenize()
    print_str("Tokens: ")
    print_str(i_to_str(tok_count))
    print_str("\n")
    
    # Print token stream
    var i = 0
    when i < tok_count loop
        var tt = tok_types[i]
        if tt != TK_NEWLINE:
            print_str("  ")
            print_str(tok_name(tt))
            if tt == TK_IDENT:
                print_str(" [")
                print_str(tok_vals[i])
                print_str("]")
            end
            if tt == TK_INT:
                print_str(" [")
                print_str(i_to_str(tok_vals[i]))
                print_str("]")
            end
            if tt == TK_STRING:
                print_str(" [\"")
                print_str(tok_vals[i])
                print_str("\"]")
            end
            print_str("\n")
        end
        i = i + 1
    end
    
    # Phase 2: Parse
    print_str("\n=== Phase 2: Parse ===\n")
    parse_program()
    print_str("AST nodes: ")
    print_str(i_to_str(node_count))
    print_str("\n")
    
    # Print AST nodes
    var j = 0
    when j < node_count loop
        var nt = ast_types[j]
        var nv = ast_vals[j]
        print_str("  [")
        print_str(i_to_str(j))
        print_str("] ")
        print_str(node_name(nt))
        if nt == ND_FUNC:
            print_str(" name=")
            print_str(nv)
        end
        if nt == ND_VAR:
            print_str(" name=")
            print_str(nv)
        end
        if nt == ND_CONST:
            print_str(" name=")
            print_str(nv)
        end
        if nt == ND_ASSIGN:
            print_str(" target=")
            print_str(nv)
        end
        if nt == ND_CALL:
            print_str(" func=")
            print_str(nv)
        end
        if nt == ND_IDENT:
            print_str(" name=")
            print_str(nv)
        end
        if nt == ND_INCLUDE:
            print_str(" module=")
            print_str(nv)
        end
        if nt == ND_TYPE:
            print_str(" name=")
            print_str(nv)
        end
        if nt == ND_ENUM:
            print_str(" name=")
            print_str(nv)
        end
        if nt == ND_PARAM:
            print_str(" name=")
            print_str(nv)
        end
        if nt == ND_LITERAL:
            print_str(" val=")
            print_str(i_to_str(nv))
        end
        if nt == ND_BINOP:
            print_str(" op=")
            print_str(tok_name(nv))
        end
        if nt == ND_PROGRAM:
            print_str(" stmts=")
            print_str(i_to_str(nv))
        end
        print_str("\n")
        j = j + 1
    end
    
    print_str("\n=== Vir-in-Vir: Parse complete! ===\n")
    out 0;
end
