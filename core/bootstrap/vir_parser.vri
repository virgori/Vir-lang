    end
    if c == 119:
        out "w";
    end
    if c == 120:
        out "x";
    end
    if c == 121:
        out "y";
    end
    if c == 122:
        out "z";
    end
    if c == 123:
        out "{";
    end
    if c == 124:
        out "|";
    end
    if c == 125:
        out "}";
    end
    if c == 126:
        out "~";
    end
    if c == 9:
        out "\t";
    end
    out "?";
end

func is_alpha:
    in(c)
    if c >= 65:
        if c <= 90:
            out 1;
        end
    end
    if c >= 97:
        if c <= 122:
            out 1;
        end
    end
    if c == 95:
        out 1;
    end
    out 0;
end

func is_digit:
    in(c)
    if c >= 48:
        if c <= 57:
            out 1;
        end
    end
    out 0;
end

func is_alnum:
    in(c)
    if is_alpha(c) == 1:
        out 1;
    end
    if is_digit(c) == 1:
        out 1;
    end
    out 0;
end

func is_space:
    in(c)
    if c == 32:
        out 1;
    end
    if c == 9:
        out 1;
    end
    if c == 13:
        out 1;
    end
    out 0;
end

# ═══════════════════════════════════════════════════════
# Lexer helpers
# ═══════════════════════════════════════════════════════

func peek_char:
    if pos >= src_len:
        out 0;
    end
    out str_get(src, pos);
end

func advance_char:
    var c = str_get(src, pos)
    pos = pos + 1
    if c == 10:
        cur_line = cur_line + 1
    end
    out c;
end

func emit_token:
    in(ttype, tval)
    push(tok_types, ttype)
    push(tok_vals, tval)
    push(tok_lines, cur_line)
    tok_count = tok_count + 1
    out 0;
end

# ═══════════════════════════════════════════════════════
# Keyword lookup
# ═══════════════════════════════════════════════════════

func keyword_type:
    in(word)
    if str_eq(word, "func") == 1:
        out TK_FUNC;
    end
    if str_eq(word, "var") == 1:
        out TK_VAR;
    end
    if str_eq(word, "const") == 1:
        out TK_CONST;
    end
    if str_eq(word, "if") == 1:
        out TK_IF;
    end
    if str_eq(word, "else") == 1:
        out TK_ELSE;
    end
    if str_eq(word, "elif") == 1:
        out TK_ELIF;
    end
    if str_eq(word, "eif") == 1:
        out TK_EIF;
    end
    if str_eq(word, "then") == 1:
        out TK_THEN;
    end
    if str_eq(word, "end") == 1:
        out TK_END;
    end
    if str_eq(word, "loop") == 1:
        out TK_LOOP;
    end
    if str_eq(word, "while") == 1:
        out TK_WHILE;
    end
    if str_eq(word, "when") == 1:
        out TK_WHEN;
    end
    if str_eq(word, "for") == 1:
        out TK_FOR;
    end
    if str_eq(word, "break") == 1:
        out TK_BREAK;
    end
    if str_eq(word, "return") == 1:
        out TK_RETURN;
    end
    if str_eq(word, "out") == 1:
        out TK_OUT;
    end
    if str_eq(word, "skip") == 1:
        out TK_SKIP;
    end
    if str_eq(word, "print") == 1:
        out TK_PRINT;
    end
    if str_eq(word, "and") == 1:
        out TK_AND;
    end
    if str_eq(word, "or") == 1:
        out TK_OR;
    end
    if str_eq(word, "not") == 1:
        out TK_NOT;
    end
    if str_eq(word, "true") == 1:
        out TK_TRUE;
    end
    if str_eq(word, "false") == 1:
        out TK_FALSE;
    end
    if str_eq(word, "none") == 1:
        out TK_NONE;
    end
    if str_eq(word, "include") == 1:
        out TK_INCLUDE;
    end
    if str_eq(word, "import") == 1:
        out TK_IMPORT;
    end
    if str_eq(word, "from") == 1:
        out TK_FROM;
    end
    if str_eq(word, "module") == 1:
        out TK_MODULE;
    end
    if str_eq(word, "export") == 1:
        out TK_EXPORT;
    end
    if str_eq(word, "enum") == 1:
        out TK_ENUM;
    end
    if str_eq(word, "record") == 1:
        out TK_RECORD;
    end
    if str_eq(word, "entity") == 1:
        out TK_ENTITY;
    end
    if str_eq(word, "method") == 1:
        out TK_METHOD;
    end
    if str_eq(word, "class") == 1:
        out TK_CLASS;
    end
    if str_eq(word, "case") == 1:
        out TK_CASE;
    end
    if str_eq(word, "in") == 1:
        out TK_IN;
    end
    if str_eq(word, "type") == 1:
        out TK_TYPE;
    end
    if str_eq(word, "has") == 1:
        out TK_HAS;
    end
    if str_eq(word, "share") == 1:
        out TK_SHARE;
    end
    if str_eq(word, "async") == 1:
        out TK_ASYNC;
    end
    if str_eq(word, "task") == 1:
        out TK_TASK;
    end
    if str_eq(word, "wait") == 1:
        out TK_WAIT;
    end
    if str_eq(word, "try") == 1:
        out TK_TRY;
    end
    if str_eq(word, "error") == 1:
        out TK_ERROR;
    end
    out 0;
end

# ═══════════════════════════════════════════════════════
# Lexer — main tokenize loop
# ═══════════════════════════════════════════════════════

func lex_string:
    # Opening quote already consumed
    var result = ""
    when pos < src_len loop
        var c = advance_char()
        if c == 34:
            # closing quote
            emit_token(TK_STRING, result)
            out 0;
        end
        if c == 92:
            # Backslash escape
            if pos < src_len:
                var esc = advance_char()
                if esc == 110:
                    result = str_cat(result, "\n")
                end
                if esc == 116:
                    result = str_cat(result, "\t")
                end
                if esc == 34:
                    result = str_cat(result, "\"")
                end
                if esc == 92:
                    result = str_cat(result, "\\")
                end
            end
        else
            result = str_cat(result, chr(c))
        end
    end
    out 0;
end

func lex_number:
    var start = pos - 1
    when pos < src_len loop
        var c = peek_char()
        if is_digit(c) == 0:
            break
        end
        advance_char()
    end
    # Extract number value
    var val = 0
    var i = start
    when i < pos loop
        var d = str_get(src, i) - 48
        val = val * 10 + d
        i = i + 1
    end
    emit_token(TK_INT, val)
    out 0;
end

func lex_word:
    var start = pos - 1
    when pos < src_len loop
        var c = peek_char()
        if is_alnum(c) == 0:
            break
        end
        advance_char()
    end
    # Extract the word by accumulating chars from source
    var word = ""
    var i = start
    when i < pos loop
        var c = str_get(src, i)
        word = str_cat(word, chr(c))
        i = i + 1
    end
    
    # Check if keyword
    var kw = keyword_type(word)
    if kw > 0:
        emit_token(kw, word)
    else
        emit_token(TK_IDENT, word)
    end
    out 0;
end

func tokenize:
    when pos < src_len loop
        var c = peek_char()
        
        # Skip whitespace (not newline)
        if is_space(c) == 1:
            advance_char()
        else
            if c == 10:
                # Newline
                advance_char()
                emit_token(TK_NEWLINE, 0)
            else
                if c == 35:
                    # # comment — skip to EOL
                    advance_char()
                    if pos < src_len:
                        var c2 = peek_char()
                        if c2 == 35:
                            # ## block comment ## — skip until ##
                            advance_char()
                            when pos < src_len loop
                                var bc = advance_char()
                                if bc == 35:
                                    if pos < src_len:
                                        if peek_char() == 35:
                                            advance_char()
                                            break
                                        end
                                    end
                                end
                            end
                        else
                            # Line comment
                            when pos < src_len loop
                                if peek_char() == 10:
                                    break
                                end
                                advance_char()
                            end
                        end
                    end
                else
                    if c == 34:
                        # String literal
                        advance_char()
                        lex_string()
                    else
                        if is_digit(c) == 1:
                            advance_char()
                            lex_number()
                        else
                            if is_alpha(c) == 1:
                                advance_char()
                                lex_word()
                            else
                                # Operators and punctuation
                                advance_char()
                                if c == 43:
                                    emit_token(TK_PLUS, 0)
                                end
                                if c == 45:
                                    emit_token(TK_MINUS, 0)
                                end
                                if c == 42:
                                    emit_token(TK_STAR, 0)
                                end
                                if c == 47:
                                    emit_token(TK_SLASH, 0)
                                end
                                if c == 37:
                                    emit_token(TK_PERCENT, 0)
                                end
                                if c == 40:
                                    emit_token(TK_LPAREN, 0)
                                end
                                if c == 41:
                                    emit_token(TK_RPAREN, 0)
                                end
                                if c == 91:
                                    emit_token(TK_LBRACKET, 0)
                                end
                                if c == 93:
                                    emit_token(TK_RBRACKET, 0)
                                end
                                if c == 123:
                                    emit_token(TK_LBRACE, 0)
                                end
                                if c == 125:
                                    emit_token(TK_RBRACE, 0)
                                end
                                if c == 44:
                                    emit_token(TK_COMMA, 0)
                                end
                                if c == 46:
                                    emit_token(TK_DOT, 0)
                                end
                                if c == 58:
                                    emit_token(TK_COLON, 0)
                                end
                                if c == 59:
                                    emit_token(TK_SEMI, 0)
                                end
                                if c == 61:
                                    # = or ==
                                    if pos < src_len:
                                        if peek_char() == 61:
                                            advance_char()
                                            emit_token(TK_EQ, 0)
                                        else
                                            emit_token(TK_ASSIGN, 0)
                                        end
                                    else
                                        emit_token(TK_ASSIGN, 0)
                                    end
                                end
                                if c == 33:
                                    # ! or !=
                                    if pos < src_len:
                                        if peek_char() == 61:
                                            advance_char()
                                            emit_token(TK_NE, 0)
                                        else
                                            emit_token(TK_NOT, 0)
                                        end
                                    end
                                end
                                if c == 62:
                                    # > or >=
                                    if pos < src_len:
                                        if peek_char() == 61:
                                            advance_char()
                                            emit_token(TK_GE, 0)
                                        else
                                            emit_token(TK_GT, 0)
                                        end
                                    else
                                        emit_token(TK_GT, 0)
                                    end
                                end
                                if c == 60:
                                    # < or <=
                                    if pos < src_len:
                                        if peek_char() == 61:
                                            advance_char()
                                            emit_token(TK_LE, 0)
                                        else
                                            emit_token(TK_LT, 0)
                                        end
                                    else
                                        emit_token(TK_LT, 0)
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
    end
    emit_token(TK_EOF, 0)
    out 0;
end

