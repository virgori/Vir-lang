##
 * vir_parser.vri — Vir-in-Vir: A Vir Language Parser written in Vir
 * ====================================================================
 * Self-hosting bootstrap: this file IS a valid Vir program that
 * can tokenize and parse other Vir programs.
 *
 * Compiled and run by the existing Vir C engine.
 * First step toward full Vir self-hosting (Vir-in-Vir).
 *
 * Usage:
 *   ./core/build/vir run core/bootstrap/vir_parser.vri <input.vri>
 ##

# ═══════════════════════════════════════════════════════
# Token types (encoded as integers)
# ═══════════════════════════════════════════════════════
var TK_EOF      = 0
var TK_INT      = 1
var TK_STRING   = 2
var TK_IDENT    = 3
var TK_FUNC     = 10
var TK_VAR      = 11
var TK_CONST    = 12
var TK_IF       = 13
var TK_ELSE     = 14
var TK_ELIF     = 15
var TK_THEN     = 16
var TK_END      = 17
var TK_LOOP     = 18
var TK_WHILE    = 19
var TK_FOR      = 20
var TK_BREAK    = 21
var TK_RETURN   = 22
var TK_PRINT    = 23
var TK_AND      = 24
var TK_OR       = 25
var TK_NOT      = 26
var TK_TRUE     = 27
var TK_FALSE    = 28
var TK_NONE     = 29
var TK_INCLUDE  = 30
var TK_IMPORT   = 31
var TK_FROM     = 32
var TK_MODULE   = 33
var TK_EXPORT   = 34
var TK_ENUM     = 35
var TK_RECORD   = 36
var TK_ENTITY   = 37
var TK_METHOD   = 38
var TK_CLASS    = 39
var TK_WHEN     = 40
var TK_CASE     = 41
var TK_OUT      = 42
var TK_SKIP     = 43
var TK_EIF      = 44
var TK_IN       = 45
var TK_TYPE     = 46
var TK_HAS      = 47
var TK_SHARE    = 48
var TK_ASYNC    = 49
var TK_TASK     = 50
var TK_WAIT     = 51
var TK_TRY      = 52
var TK_ERROR    = 53

# Operators & punctuation
var TK_PLUS     = 60
var TK_MINUS    = 61
var TK_STAR     = 62
var TK_SLASH    = 63
var TK_PERCENT  = 64
var TK_ASSIGN   = 65
var TK_EQ       = 66
var TK_NE       = 67
var TK_GT       = 68
var TK_LT       = 69
var TK_GE       = 70
var TK_LE       = 71
var TK_LPAREN   = 72
var TK_RPAREN   = 73
var TK_LBRACKET = 74
var TK_RBRACKET = 75
var TK_LBRACE   = 76
var TK_RBRACE   = 77
var TK_COMMA    = 78
var TK_DOT      = 79
var TK_COLON    = 80
var TK_SEMI     = 81
var TK_HASH     = 82
var TK_NEWLINE  = 83

# AST node types
var ND_PROGRAM  = 100
var ND_FUNC     = 101
var ND_VAR      = 102
var ND_CONST    = 103
var ND_IF       = 104
var ND_WHILE    = 105
var ND_LOOP     = 106
var ND_RETURN   = 107
var ND_PRINT    = 108
var ND_ASSIGN   = 109
var ND_BINOP    = 110
var ND_CALL     = 111
var ND_IDENT    = 112
var ND_LITERAL  = 113
var ND_BLOCK    = 114
var ND_INCLUDE  = 115
var ND_TYPE     = 116
var ND_ENUM     = 117
var ND_PARAM    = 118

# ═══════════════════════════════════════════════════════
# Lexer state (globals)
# ═══════════════════════════════════════════════════════
var src = ""
var src_len = 0
var pos = 0
var cur_line = 1

# Token output arrays (parallel arrays)
var tok_types = []
var tok_vals  = []
var tok_lines = []
var tok_count = 0

# ═══════════════════════════════════════════════════════
# Character classification
# ═══════════════════════════════════════════════════════

func chr:
    in(c)
    # Convert ASCII code to 1-char string
    if c == 10:
        out "\n";
    end
    if c == 13:
        out "";
    end
    if c == 32:
        out " ";
    end
    if c == 33:
        out "!";
    end
    if c == 34:
        out "\"";
    end
    if c == 35:
        out "#";
    end
    if c == 36:
        out "$";
    end
    if c == 37:
        out "%";
    end
    if c == 38:
        out "&";
    end
    if c == 39:
        out "'";
    end
    if c == 40:
        out "(";
    end
    if c == 41:
        out ")";
    end
    if c == 42:
        out "*";
    end
    if c == 43:
        out "+";
    end
    if c == 44:
        out ",";
    end
    if c == 45:
        out "-";
    end
    if c == 46:
        out ".";
    end
    if c == 47:
        out "/";
    end
    if c == 48:
        out "0";
    end
    if c == 49:
        out "1";
    end
    if c == 50:
        out "2";
    end
    if c == 51:
        out "3";
    end
    if c == 52:
        out "4";
    end
    if c == 53:
        out "5";
    end
    if c == 54:
        out "6";
    end
    if c == 55:
        out "7";
    end
    if c == 56:
        out "8";
    end
    if c == 57:
        out "9";
    end
    if c == 58:
        out ":";
    end
    if c == 59:
        out ";";
    end
    if c == 60:
        out "<";
    end
    if c == 61:
        out "=";
    end
    if c == 62:
        out ">";
    end
    if c == 63:
        out "?";
    end
    if c == 64:
        out "@";
    end
    if c == 65:
        out "A";
    end
    if c == 66:
        out "B";
    end
    if c == 67:
        out "C";
    end
    if c == 68:
        out "D";
    end
    if c == 69:
        out "E";
    end
    if c == 70:
        out "F";
    end
    if c == 71:
        out "G";
    end
    if c == 72:
        out "H";
    end
    if c == 73:
        out "I";
    end
    if c == 74:
        out "J";
    end
    if c == 75:
        out "K";
    end
    if c == 76:
        out "L";
    end
    if c == 77:
        out "M";
    end
    if c == 78:
        out "N";
    end
    if c == 79:
        out "O";
    end
    if c == 80:
        out "P";
    end
    if c == 81:
        out "Q";
    end
    if c == 82:
        out "R";
    end
    if c == 83:
        out "S";
    end
    if c == 84:
        out "T";
    end
    if c == 85:
        out "U";
    end
    if c == 86:
        out "V";
    end
    if c == 87:
        out "W";
    end
    if c == 88:
        out "X";
    end
    if c == 89:
        out "Y";
    end
    if c == 90:
        out "Z";
    end
    if c == 91:
        out "[";
    end
    if c == 92:
        out "\\";
    end
    if c == 93:
        out "]";
    end
    if c == 94:
        out "^";
    end
    if c == 95:
        out "_";
    end
    if c == 96:
        out "`";
    end
    if c == 97:
        out "a";
    end
    if c == 98:
        out "b";
    end
    if c == 99:
        out "c";
    end
    if c == 100:
        out "d";
    end
    if c == 101:
        out "e";
    end
    if c == 102:
        out "f";
    end
    if c == 103:
        out "g";
    end
    if c == 104:
        out "h";
    end
    if c == 105:
        out "i";
    end
    if c == 106:
        out "j";
    end
    if c == 107:
        out "k";
    end
    if c == 108:
        out "l";
    end
    if c == 109:
        out "m";
    end
    if c == 110:
        out "n";
    end
    if c == 111:
        out "o";
    end
    if c == 112:
        out "p";
    end
    if c == 113:
        out "q";
    end
    if c == 114:
        out "r";
    end
    if c == 115:
        out "s";
    end
    if c == 116:
        out "t";
    end
    if c == 117:
        out "u";
    end
    if c == 118:
