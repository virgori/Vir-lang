var src = ""
var src_len = 0
var pos = 0

var T_EOF = 0
var T_INT = 1
var T_IDENT = 2
var T_PLUS = 13
var T_ASSIGN = 24

var tk_type = []
var tk_count = 0

func is_alpha(c) then
    if c >= 65 then
        if c <= 90 then
            return 1
        end
    end
    if c >= 97 then
        if c <= 122 then
            return 1
        end
    end
    if c == 95 then
        return 1
    end
    return 0
end

func is_digit(c) then
    if c >= 48 then
        if c <= 57 then
            return 1
        end
    end
    return 0
end

func skip_ws() then
    while pos < src_len then
        var c = str_get(src, pos)
        if c == 32 then
            pos = pos + 1
        else
            if c == 10 then
                pos = pos + 1
            else
                return 0
            end
        end
    end
    return 0
end

func lex_number() then
    var num = 0
    while pos < src_len then
        var d = str_get(src, pos)
        if is_digit(d) == 0 then
            return num
        end
        num = num * 10 + d - 48
        pos = pos + 1
    end
    return num
end

func char_to_str(c) then
    var buf = alloc(2)
    write_byte(buf, 0, c)
    write_byte(buf, 1, 0)
    var s = str_cat("", buf)
    dealloc(buf)
    return s
end

func lex_ident() then
    var word = ""
    while pos < src_len then
        var d = str_get(src, pos)
        var ok = is_alpha(d)
        if ok == 0 then
            ok = is_digit(d)
        end
        if ok == 0 then
            return word
        end
        word = str_cat(word, char_to_str(d))
        pos = pos + 1
    end
    return word
end

func lex_one() then
    print_str("lex_one: src_len=")
    print src_len
    print_str("lex_one: pos=")
    print pos
    var c = str_get(src, pos)
    print_str("lex_one: char=")
    print c
    return 1
end

func main() then
    src = "x = 10 + 20"
    src_len = len(src)
    print_str("main: src_len=")
    print src_len
    print_str("main: char 0=")
    var c0 = str_get(src, 0)
    print c0
    var more = lex_one()
    print more
    return 0
end
