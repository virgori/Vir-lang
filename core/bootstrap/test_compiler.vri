# Test basic compiler flow
func main() then
    print_str("main start\n")
    if arg_count() < 1 then
        print_str("Usage: vir run test_compiler.vri <input.vri>\n")
        return 1
    end
    print_str("opening file\n")
    var input_file = get_arg(0)
    var fd = file_open(input_file, "r")
    if fd == 0 then
        print_str("Error: cannot open\n")
        return 1
    end
    print_str("reading file\n")
    var content = file_read(fd)
    file_close(fd)
    print_str("file content:\n")
    print_str(content)
    print_str("\n---done---\n")
    return 0
end
