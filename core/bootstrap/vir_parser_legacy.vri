# ═══════════════════════════════════════════════════════
# Lexer state (globals)
# ═══════════════════════════════════════════════════════
var src = ""
var src_len = 0
var pos = 0
var cur_line = 1

# Token output arrays (parallel arrays)
var tok_types = []
var tok_vals  = []
var tok_lines = []
var tok_count = 0

# ═══════════════════════════════════════════════════════
# Character classification
# ═══════════════════════════════════════════════════════

func chr(c) then
    # Convert ASCII code to 1-char string
    if c == 10 then
        return "\n"
    end
    if c == 13 then
        return ""
    end
    if c == 32 then
        return " "
    end
    if c == 33 then
        return "!"
    end
    if c == 34 then
        return "\""
    end
    if c == 35 then
        return "#"
    end
    if c == 36 then
        return "$"
    end
    if c == 37 then
        return "%"
    end
    if c == 38 then
        return "&"
    end
    if c == 39 then
        return "'"
    end
    if c == 40 then
        return "("
    end
    if c == 41 then
        return ")"
    end
    if c == 42 then
        return "*"
    end
    if c == 43 then
        return "+"
    end
    if c == 44 then
        return ","
    end
    if c == 45 then
        return "-"
    end
    if c == 46 then
        return "."
    end
    if c == 47 then
        return "/"
    end
    if c == 48 then
        return "0"
