##
 * vir_parser.vri — Vir-in-Vir: A Vir Language Parser written in Vir
 * ====================================================================
 * Self-hosting bootstrap: this file IS a valid Vir program that
 * can tokenize and parse other Vir programs.
 *
 * Compiled and run by the existing Vir C engine.
 * First step toward full Vir self-hosting (Vir-in-Vir).
 *
 * Usage:
 *   ./core/build/vir run core/bootstrap/vir_parser.vri <input.vri>
 ##

# ═══════════════════════════════════════════════════════
# Token types (encoded as integers)
# ═══════════════════════════════════════════════════════
var TK_EOF      = 0
var TK_INT      = 1
var TK_STRING   = 2
var TK_IDENT    = 3
var TK_FUNC     = 10
var TK_VAR      = 11
var TK_CONST    = 12
var TK_IF       = 13
var TK_ELSE     = 14
var TK_ELIF     = 15
var TK_THEN     = 16
var TK_END      = 17
var TK_LOOP     = 18
var TK_WHILE    = 19
var TK_FOR      = 20
var TK_BREAK    = 21
var TK_RETURN   = 22
var TK_PRINT    = 23
var TK_AND      = 24
var TK_OR       = 25
var TK_NOT      = 26
var TK_TRUE     = 27
var TK_FALSE    = 28
var TK_NONE     = 29
var TK_INCLUDE  = 30
var TK_IMPORT   = 31
var TK_FROM     = 32
var TK_MODULE   = 33
var TK_EXPORT   = 34
var TK_ENUM     = 35
var TK_RECORD   = 36
var TK_ENTITY   = 37
var TK_METHOD   = 38
var TK_CLASS    = 39
var TK_WHEN     = 40
var TK_CASE     = 41
var TK_OUT      = 42
var TK_SKIP     = 43
var TK_EIF      = 44
var TK_IN       = 45
var TK_TYPE     = 46
var TK_HAS      = 47
var TK_SHARE    = 48
var TK_ASYNC    = 49
var TK_TASK     = 50
var TK_WAIT     = 51
var TK_TRY      = 52
var TK_ERROR    = 53

# Operators & punctuation
var TK_PLUS     = 60
var TK_MINUS    = 61
var TK_STAR     = 62
var TK_SLASH    = 63
var TK_PERCENT  = 64
var TK_ASSIGN   = 65
var TK_EQ       = 66
var TK_NE       = 67
var TK_GT       = 68
var TK_LT       = 69
var TK_GE       = 70
var TK_LE       = 71
var TK_LPAREN   = 72
var TK_RPAREN   = 73
var TK_LBRACKET = 74
var TK_RBRACKET = 75
var TK_LBRACE   = 76
var TK_RBRACE   = 77
var TK_COMMA    = 78
var TK_DOT      = 79
var TK_COLON    = 80
var TK_SEMI     = 81
var TK_HASH     = 82
var TK_NEWLINE  = 83

# AST node types
var ND_PROGRAM  = 100
var ND_FUNC     = 101
var ND_VAR      = 102
var ND_CONST    = 103
var ND_IF       = 104
var ND_WHILE    = 105
var ND_LOOP     = 106
