        return "MODULE"
    end
    if t == TK_EXPORT then
        return "EXPORT"
    end
    if t == TK_ENTITY then
        return "ENTITY"
    end
    if t == TK_METHOD then
        return "METHOD"
    end
    if t == TK_CLASS then
        return "CLASS"
    end
    if t == TK_ASYNC then
        return "ASYNC"
    end
    if t == TK_TASK then
        return "TASK"
    end
    if t == TK_WAIT then
        return "WAIT"
    end
    if t == TK_NOT then
        return "NOT"
    end
    if t == TK_PERCENT then
        return "PERCENT"
    end
    if t == TK_LBRACE then
        return "LBRACE"
    end
    if t == TK_RBRACE then
        return "RBRACE"
    end
    if t == TK_HAS then
        return "HAS"
    end
    if t == TK_SHARE then
        return "SHARE"
    end
    if t == TK_TRY then
        return "TRY"
    end
    if t == TK_ERROR then
        return "ERROR"
    end
    if t == TK_RECORD then
        return "RECORD"
    end
    return "?"
end

# ═══════════════════════════════════════════════════════
# Parser state
# ═══════════════════════════════════════════════════════
var p_pos = 0

# AST output (parallel arrays — flat tree)
# Each node: [type, val, parent, child_start, child_count]
var ast_types = []
var ast_vals  = []
var ast_parents = []
var node_count = 0

func p_peek() then
    if p_pos >= tok_count then
        return TK_EOF
    end
    return tok_types[p_pos]
end

func p_peek_val() then
    if p_pos >= tok_count then
        return 0
    end
    return tok_vals[p_pos]
end

func p_advance() then
    var t = tok_types[p_pos]
    p_pos = p_pos + 1
    return t
end

func p_advance_val() then
    var v = tok_vals[p_pos]
    p_pos = p_pos + 1
    return v
end

func p_expect(expected) then
    var t = p_peek()
    if t == expected then
        p_advance()
        return 1
    end
    print_str("Parse error: expected ")
    print_str(tok_name(expected))
    print_str(" got ")
    print_str(tok_name(t))
    print_str(" at token #")
    print_str(i_to_str(p_pos))
    print_str("\n")
    return 0
end

func p_skip_newlines() then
    while p_peek() == TK_NEWLINE then
        p_advance()
    end
    return 0
end

func emit_node(ntype, nval) then
    push(ast_types, ntype)
    push(ast_vals, nval)
    push(ast_parents, 0)
    var id = node_count
    node_count = node_count + 1
    return id
end

# ═══════════════════════════════════════════════════════
# Parser — Recursive Descent
# ═══════════════════════════════════════════════════════

func parse_expr() then
    # Simple expression: just primary for now
    var left = parse_primary()
    
    # Binary operators
    var t = p_peek()
    while t == TK_PLUS then
        p_advance()
        var right = parse_primary()
        var n = emit_node(ND_BINOP, TK_PLUS)
        left = n
        t = p_peek()
    end
    while t == TK_MINUS then
        p_advance()
        var right = parse_primary()
        var n = emit_node(ND_BINOP, TK_MINUS)
        left = n
        t = p_peek()
    end
    while t == TK_STAR then
        p_advance()
        var right = parse_primary()
        var n = emit_node(ND_BINOP, TK_STAR)
        left = n
        t = p_peek()
    end
    while t == TK_SLASH then
        p_advance()
        var right = parse_primary()
        var n = emit_node(ND_BINOP, TK_SLASH)
        left = n
        t = p_peek()
    end
    # Comparison
    if t == TK_EQ then
        p_advance()
        var right = parse_primary()
        left = emit_node(ND_BINOP, TK_EQ)
    end
    if t == TK_NE then
        p_advance()
        var right = parse_primary()
        left = emit_node(ND_BINOP, TK_NE)
    end
    if t == TK_GT then
        p_advance()
        var right = parse_primary()
        left = emit_node(ND_BINOP, TK_GT)
    end
    if t == TK_LT then
        p_advance()
        var right = parse_primary()
        left = emit_node(ND_BINOP, TK_LT)
    end
    if t == TK_GE then
        p_advance()
        var right = parse_primary()
        left = emit_node(ND_BINOP, TK_GE)
    end
    if t == TK_LE then
        p_advance()
        var right = parse_primary()
        left = emit_node(ND_BINOP, TK_LE)
    end
    
    return left
end

func parse_primary() then
    var t = p_peek()
    
    if t == TK_INT then
        var val = p_peek_val()
        p_advance()
        return emit_node(ND_LITERAL, val)
    end
    
    if t == TK_STRING then
        var val = p_peek_val()
        p_advance()
        return emit_node(ND_LITERAL, val)
    end
    
    if t == TK_TRUE then
        p_advance()
        return emit_node(ND_LITERAL, 1)
    end
    
    if t == TK_FALSE then
        p_advance()
        return emit_node(ND_LITERAL, 0)
    end
    
    if t == TK_NONE then
        p_advance()
        return emit_node(ND_LITERAL, 0)
    end
    
    if t == TK_IDENT then
        var name = p_peek_val()
        p_advance()
        # Check for function call
        if p_peek() == TK_LPAREN then
            p_advance()
            var arg_count = 0
            while p_peek() != TK_RPAREN then
                if arg_count > 0 then
                    p_expect(TK_COMMA)
                end
                parse_expr()
                arg_count = arg_count + 1
            end
            p_expect(TK_RPAREN)
            return emit_node(ND_CALL, name)
        end
        # Check for index access
        if p_peek() == TK_LBRACKET then
            p_advance()
            parse_expr()
            p_expect(TK_RBRACKET)
            return emit_node(ND_IDENT, name)
        end
        return emit_node(ND_IDENT, name)
    end
    
    if t == TK_LPAREN then
        p_advance()
        var inner = parse_expr()
        p_expect(TK_RPAREN)
        return inner
    end
    
    if t == TK_LBRACKET then
        # Array literal []
        p_advance()
        p_expect(TK_RBRACKET)
        return emit_node(ND_LITERAL, 0)
    end
    
    if t == TK_MINUS then
        # Unary minus
        p_advance()
        var inner = parse_primary()
        return emit_node(ND_BINOP, TK_MINUS)
    end
    
    # Fallback
    print_str("Parse error: unexpected token ")
    print_str(tok_name(t))
    print_str(" at #")
    print_str(i_to_str(p_pos))
    print_str("\n")
    p_advance()
    return emit_node(ND_LITERAL, 0)
end

func parse_statement() then
    p_skip_newlines()
    var t = p_peek()
    
    if t == TK_EOF then
        return 0
    end
    
    if t == TK_FUNC then
        p_advance()
        var name = p_peek_val()
        p_advance()
        # Parse params
        p_expect(TK_LPAREN)
        var param_count = 0
        while p_peek() != TK_RPAREN then
            if param_count > 0 then
                p_expect(TK_COMMA)
            end
            var pname = p_peek_val()
            p_advance()
            emit_node(ND_PARAM, pname)
            param_count = param_count + 1
        end
        p_expect(TK_RPAREN)
        p_expect(TK_THEN)
        # Parse body
        var body_count = 0
        p_skip_newlines()
        while p_peek() != TK_END then
            if p_peek() == TK_EOF then
                break
            end
            parse_statement()
            body_count = body_count + 1
            p_skip_newlines()
        end
        p_expect(TK_END)
        return emit_node(ND_FUNC, name)
    end
    
    if t == TK_VAR then
        p_advance()
        var name = p_peek_val()
        p_advance()
        if p_peek() == TK_ASSIGN then
            p_advance()
            parse_expr()
        end
        return emit_node(ND_VAR, name)
    end
    
    if t == TK_CONST then
        p_advance()
        var name = p_peek_val()
        p_advance()
        if p_peek() == TK_ASSIGN then
            p_advance()
            parse_expr()
        end
        return emit_node(ND_CONST, name)
    end
    
    if t == TK_TYPE then
        p_advance()
        var name = p_peek_val()
        p_advance()
        # Optional ;
        if p_peek() == TK_SEMI then
            p_advance()
        end
        return emit_node(ND_TYPE, name)
    end
    
    if t == TK_IF then
        p_advance()
        parse_expr()
        p_expect(TK_THEN)
        # Then block
        var body_count = 0
        p_skip_newlines()
        while p_peek() != TK_END then
            if p_peek() == TK_ELSE then
                break
            end
            if p_peek() == TK_ELIF then
                break
            end
            if p_peek() == TK_EIF then
                break
            end
            if p_peek() == TK_EOF then
                break
            end
            parse_statement()
            body_count = body_count + 1
            p_skip_newlines()
        end
        # Else branch
        if p_peek() == TK_ELSE then
            p_advance()
            p_skip_newlines()
            while p_peek() != TK_END then
                if p_peek() == TK_EOF then
                    break
                end
                parse_statement()
                p_skip_newlines()
            end
        end
        if p_peek() == TK_ELIF then
            p_advance()
            # Recurse as nested if
            parse_expr()
            p_expect(TK_THEN)
            p_skip_newlines()
            while p_peek() != TK_END then
                if p_peek() == TK_EOF then
                    break
                end
                parse_statement()
                p_skip_newlines()
            end
        end
        p_expect(TK_END)
        return emit_node(ND_IF, 0)
    end
    
    if t == TK_WHILE then
        p_advance()
        parse_expr()
        p_expect(TK_THEN)
        p_skip_newlines()
        while p_peek() != TK_END then
            if p_peek() == TK_EOF then
                break
            end
            parse_statement()
            p_skip_newlines()
        end
        p_expect(TK_END)
        return emit_node(ND_WHILE, 0)
    end
    
    if t == TK_LOOP then
        p_advance()
        parse_expr()
        p_expect(TK_THEN)
        p_skip_newlines()
        while p_peek() != TK_END then
            if p_peek() == TK_EOF then
                break
            end
            parse_statement()
            p_skip_newlines()
        end
        p_expect(TK_END)
        return emit_node(ND_LOOP, 0)
    end
    
    if t == TK_RETURN then
        p_advance()
        if p_peek() != TK_NEWLINE then
            if p_peek() != TK_END then
                if p_peek() != TK_EOF then
                    parse_expr()
                end
            end
        end
        return emit_node(ND_RETURN, 0)
    end
    
    if t == TK_PRINT then
        p_advance()
        parse_expr()
        return emit_node(ND_PRINT, 0)
    end
    
    if t == TK_BREAK then
        p_advance()
        return emit_node(ND_RETURN, 0)
    end
    
    if t == TK_INCLUDE then
        p_advance()
        var name = p_peek_val()
        p_advance()
        if p_peek() == TK_SEMI then
            p_advance()
        end
        return emit_node(ND_INCLUDE, name)
    end
    
    if t == TK_ENUM then
        p_advance()
        var name = p_peek_val()
        p_advance()
        # Skip to end
        while p_peek() != TK_END then
            if p_peek() == TK_EOF then
                break
            end
            p_advance()
        end
        p_expect(TK_END)
        return emit_node(ND_ENUM, name)
    end
    
    # Assignment or expression statement
    if t == TK_IDENT then
        var name = p_peek_val()
        p_advance()
        if p_peek() == TK_ASSIGN then
            p_advance()
            parse_expr()
            return emit_node(ND_ASSIGN, name)
        end
        # Function call as statement
        if p_peek() == TK_LPAREN then
            p_advance()
            var ac = 0
            while p_peek() != TK_RPAREN then
                if ac > 0 then
                    p_expect(TK_COMMA)
                end
                parse_expr()
                ac = ac + 1
            end
            p_expect(TK_RPAREN)
            return emit_node(ND_CALL, name)
        end
        # Index assignment: name[i] = val
        if p_peek() == TK_LBRACKET then
            p_advance()
            parse_expr()
            p_expect(TK_RBRACKET)
            if p_peek() == TK_ASSIGN then
                p_advance()
                parse_expr()
            end
            return emit_node(ND_ASSIGN, name)
        end
        return emit_node(ND_IDENT, name)
    end
    
    # Skip unknown
    p_advance()
    return 0
end

func parse_program() then
    var stmt_count = 0
    p_skip_newlines()
    while p_peek() != TK_EOF then
        parse_statement()
        stmt_count = stmt_count + 1
        p_skip_newlines()
    end
    return emit_node(ND_PROGRAM, stmt_count)
end

# ═══════════════════════════════════════════════════════
# AST node name
# ═══════════════════════════════════════════════════════

func node_name(t) then
    if t == ND_PROGRAM then
        return "Program"
    end
    if t == ND_FUNC then
        return "FuncDef"
    end
    if t == ND_VAR then
        return "VarDecl"
    end
    if t == ND_CONST then
        return "ConstDecl"
    end
    if t == ND_IF then
        return "If"
    end
    if t == ND_WHILE then
        return "While"
    end
    if t == ND_LOOP then
        return "Loop"
    end
    if t == ND_RETURN then
        return "Return"
    end
    if t == ND_PRINT then
        return "Print"
    end
    if t == ND_ASSIGN then
        return "Assign"
    end
    if t == ND_BINOP then
        return "BinOp"
    end
    if t == ND_CALL then
        return "Call"
    end
    if t == ND_IDENT then
        return "Ident"
    end
    if t == ND_LITERAL then
        return "Literal"
    end
    if t == ND_BLOCK then
        return "Block"
    end
    if t == ND_INCLUDE then
        return "Include"
    end
    if t == ND_TYPE then
        return "TypeDecl"
    end
    if t == ND_ENUM then
        return "EnumDef"
    end
    if t == ND_PARAM then
        return "Param"
    end
    return "?"
end

# ═══════════════════════════════════════════════════════
# Main entry point
# ═══════════════════════════════════════════════════════

func main() then
    print_str("╔══════════════════════════════════════════════════╗\n")
    print_str("║  Vir-in-Vir Parser — Self-hosting Bootstrap     ║\n")
    print_str("║  Written in Vir, compiled by Vir C Engine       ║\n")
    print_str("╚══════════════════════════════════════════════════╝\n\n")
    
    # Check command line args
    if arg_count() < 1 then
        print_str("Usage: vir run vir_parser.vri <input.vri>\n")
        return 1
    end
    
    # Read input file
    var filename = get_arg(0)
    print_str("Reading: ")
    print_str(filename)
    print_str("\n")
    
    var fd = file_open(filename, "r")
    if fd == 0 then
        print_str("Error: cannot open file\n")
        return 1
    end
    
    src = file_read(fd)
    file_close(fd)
    src_len = len(src)
    
    print_str("Source: ")
    print_str(i_to_str(src_len))
    print_str(" bytes\n\n")
    
    # Phase 1: Tokenize
    print_str("=== Phase 1: Tokenize ===\n")
    tokenize()
    print_str("Tokens: ")
    print_str(i_to_str(tok_count))
    print_str("\n")
    
    # Print token stream
    var i = 0
    while i < tok_count then
        var tt = tok_types[i]
        if tt != TK_NEWLINE then
            print_str("  ")
            print_str(tok_name(tt))
            if tt == TK_IDENT then
                print_str(" [")
                print_str(tok_vals[i])
                print_str("]")
            end
            if tt == TK_INT then
                print_str(" [")
                print_str(i_to_str(tok_vals[i]))
                print_str("]")
            end
            if tt == TK_STRING then
                print_str(" [\"")
                print_str(tok_vals[i])
                print_str("\"]")
            end
            print_str("\n")
        end
        i = i + 1
    end
    
    # Phase 2: Parse
    print_str("\n=== Phase 2: Parse ===\n")
    parse_program()
    print_str("AST nodes: ")
    print_str(i_to_str(node_count))
    print_str("\n")
    
    # Print AST nodes
    var j = 0
    while j < node_count then
        var nt = ast_types[j]
        var nv = ast_vals[j]
        print_str("  [")
        print_str(i_to_str(j))
        print_str("] ")
        print_str(node_name(nt))
        if nt == ND_FUNC then
            print_str(" name=")
            print_str(nv)
        end
        if nt == ND_VAR then
            print_str(" name=")
            print_str(nv)
        end
        if nt == ND_CONST then
            print_str(" name=")
            print_str(nv)
        end
        if nt == ND_ASSIGN then
            print_str(" target=")
            print_str(nv)
        end
        if nt == ND_CALL then
            print_str(" func=")
            print_str(nv)
        end
        if nt == ND_IDENT then
            print_str(" name=")
            print_str(nv)
        end
        if nt == ND_INCLUDE then
            print_str(" module=")
            print_str(nv)
        end
        if nt == ND_TYPE then
            print_str(" name=")
            print_str(nv)
        end
        if nt == ND_ENUM then
            print_str(" name=")
            print_str(nv)
        end
        if nt == ND_PARAM then
            print_str(" name=")
            print_str(nv)
        end
        if nt == ND_LITERAL then
            print_str(" val=")
            print_str(i_to_str(nv))
        end
        if nt == ND_BINOP then
            print_str(" op=")
            print_str(tok_name(nv))
        end
        if nt == ND_PROGRAM then
            print_str(" stmts=")
            print_str(i_to_str(nv))
        end
        print_str("\n")
        j = j + 1
    end
    
    print_str("\n=== Vir-in-Vir: Parse complete! ===\n")
    return 0
end
