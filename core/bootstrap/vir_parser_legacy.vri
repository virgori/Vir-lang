    end
    return "?"
end

func is_alpha(c) then
    if c >= 65 then
        if c <= 90 then
            return 1
        end
    end
    if c >= 97 then
        if c <= 122 then
            return 1
        end
    end
    if c == 95 then
        return 1
    end
    return 0
end

func is_digit(c) then
    if c >= 48 then
        if c <= 57 then
            return 1
        end
    end
    return 0
end

func is_alnum(c) then
    if is_alpha(c) == 1 then
        return 1
    end
    if is_digit(c) == 1 then
        return 1
    end
    return 0
end

func is_space(c) then
    if c == 32 then
        return 1
    end
    if c == 9 then
        return 1
    end
    if c == 13 then
        return 1
    end
    return 0
end

# ═══════════════════════════════════════════════════════
# Lexer helpers
# ═══════════════════════════════════════════════════════

func peek_char() then
    if pos >= src_len then
        return 0
    end
    return str_get(src, pos)
end

func advance_char() then
    var c = str_get(src, pos)
    pos = pos + 1
    if c == 10 then
        cur_line = cur_line + 1
    end
    return c
end

func emit_token(ttype, tval) then
    push(tok_types, ttype)
    push(tok_vals, tval)
    push(tok_lines, cur_line)
    tok_count = tok_count + 1
    return 0
end

# ═══════════════════════════════════════════════════════
# Keyword lookup
# ═══════════════════════════════════════════════════════

func keyword_type(word) then
    if str_eq(word, "func") == 1 then
        return TK_FUNC
    end
    if str_eq(word, "var") == 1 then
        return TK_VAR
    end
    if str_eq(word, "const") == 1 then
        return TK_CONST
    end
    if str_eq(word, "if") == 1 then
        return TK_IF
    end
    if str_eq(word, "else") == 1 then
        return TK_ELSE
    end
    if str_eq(word, "elif") == 1 then
        return TK_ELIF
    end
    if str_eq(word, "eif") == 1 then
        return TK_EIF
    end
    if str_eq(word, "then") == 1 then
        return TK_THEN
    end
    if str_eq(word, "end") == 1 then
        return TK_END
    end
    if str_eq(word, "loop") == 1 then
        return TK_LOOP
    end
    if str_eq(word, "while") == 1 then
        return TK_WHILE
    end
    if str_eq(word, "when") == 1 then
        return TK_WHEN
    end
    if str_eq(word, "for") == 1 then
        return TK_FOR
    end
    if str_eq(word, "break") == 1 then
        return TK_BREAK
    end
    if str_eq(word, "return") == 1 then
        return TK_RETURN
    end
    if str_eq(word, "out") == 1 then
        return TK_OUT
    end
    if str_eq(word, "skip") == 1 then
        return TK_SKIP
    end
    if str_eq(word, "print") == 1 then
        return TK_PRINT
    end
    if str_eq(word, "and") == 1 then
        return TK_AND
    end
    if str_eq(word, "or") == 1 then
        return TK_OR
    end
    if str_eq(word, "not") == 1 then
        return TK_NOT
    end
    if str_eq(word, "true") == 1 then
        return TK_TRUE
    end
    if str_eq(word, "false") == 1 then
        return TK_FALSE
    end
    if str_eq(word, "none") == 1 then
        return TK_NONE
    end
    if str_eq(word, "include") == 1 then
        return TK_INCLUDE
    end
    if str_eq(word, "import") == 1 then
        return TK_IMPORT
    end
    if str_eq(word, "from") == 1 then
        return TK_FROM
    end
    if str_eq(word, "module") == 1 then
        return TK_MODULE
    end
    if str_eq(word, "export") == 1 then
        return TK_EXPORT
    end
    if str_eq(word, "enum") == 1 then
        return TK_ENUM
    end
    if str_eq(word, "record") == 1 then
        return TK_RECORD
    end
    if str_eq(word, "entity") == 1 then
        return TK_ENTITY
    end
    if str_eq(word, "method") == 1 then
        return TK_METHOD
    end
    if str_eq(word, "class") == 1 then
        return TK_CLASS
    end
    if str_eq(word, "case") == 1 then
        return TK_CASE
    end
    if str_eq(word, "in") == 1 then
        return TK_IN
    end
    if str_eq(word, "type") == 1 then
        return TK_TYPE
    end
    if str_eq(word, "has") == 1 then
        return TK_HAS
    end
    if str_eq(word, "share") == 1 then
        return TK_SHARE
    end
    if str_eq(word, "async") == 1 then
        return TK_ASYNC
    end
    if str_eq(word, "task") == 1 then
        return TK_TASK
    end
    if str_eq(word, "wait") == 1 then
        return TK_WAIT
    end
    if str_eq(word, "try") == 1 then
        return TK_TRY
    end
    if str_eq(word, "error") == 1 then
        return TK_ERROR
    end
    return 0
end

# ═══════════════════════════════════════════════════════
# Lexer — main tokenize loop
# ═══════════════════════════════════════════════════════

func lex_string() then
    # Opening quote already consumed
    var result = ""
    while pos < src_len then
        var c = advance_char()
        if c == 34 then
            # closing quote
            emit_token(TK_STRING, result)
            return 0
        end
        if c == 92 then
            # Backslash escape
            if pos < src_len then
                var esc = advance_char()
                if esc == 110 then
                    result = str_cat(result, "\n")
                end
                if esc == 116 then
                    result = str_cat(result, "\t")
                end
                if esc == 34 then
                    result = str_cat(result, "\"")
                end
                if esc == 92 then
                    result = str_cat(result, "\\")
                end
            end
        else
            result = str_cat(result, chr(c))
        end
    end
    return 0
end

func lex_number() then
    var start = pos - 1
    while pos < src_len then
        var c = peek_char()
        if is_digit(c) == 0 then
            break
        end
        advance_char()
    end
    # Extract number value
    var val = 0
    var i = start
    while i < pos then
        var d = str_get(src, i) - 48
        val = val * 10 + d
        i = i + 1
    end
    emit_token(TK_INT, val)
    return 0
end

func lex_word() then
    var start = pos - 1
    while pos < src_len then
        var c = peek_char()
        if is_alnum(c) == 0 then
            break
        end
        advance_char()
    end
    # Extract the word by accumulating chars from source
    var word = ""
    var i = start
    while i < pos then
        var c = str_get(src, i)
        word = str_cat(word, chr(c))
        i = i + 1
    end
    
    # Check if keyword
    var kw = keyword_type(word)
    if kw > 0 then
        emit_token(kw, word)
    else
        emit_token(TK_IDENT, word)
    end
    return 0
end

func tokenize() then
    while pos < src_len then
        var c = peek_char()
        
        # Skip whitespace (not newline)
        if is_space(c) == 1 then
            advance_char()
        else
            if c == 10 then
                # Newline
                advance_char()
                emit_token(TK_NEWLINE, 0)
            else
                if c == 35 then
                    # # comment — skip to EOL
                    advance_char()
                    if pos < src_len then
                        var c2 = peek_char()
                        if c2 == 35 then
                            # ## block comment ## — skip until ##
                            advance_char()
                            while pos < src_len then
                                var bc = advance_char()
                                if bc == 35 then
                                    if pos < src_len then
                                        if peek_char() == 35 then
                                            advance_char()
                                            break
                                        end
                                    end
                                end
                            end
                        else
                            # Line comment
                            while pos < src_len then
                                if peek_char() == 10 then
                                    break
                                end
                                advance_char()
                            end
                        end
                    end
                else
                    if c == 34 then
                        # String literal
                        advance_char()
                        lex_string()
                    else
                        if is_digit(c) == 1 then
                            advance_char()
                            lex_number()
                        else
                            if is_alpha(c) == 1 then
                                advance_char()
                                lex_word()
                            else
                                # Operators and punctuation
                                advance_char()
                                if c == 43 then
                                    emit_token(TK_PLUS, 0)
                                end
                                if c == 45 then
                                    emit_token(TK_MINUS, 0)
                                end
                                if c == 42 then
                                    emit_token(TK_STAR, 0)
                                end
                                if c == 47 then
                                    emit_token(TK_SLASH, 0)
                                end
                                if c == 37 then
                                    emit_token(TK_PERCENT, 0)
                                end
                                if c == 40 then
                                    emit_token(TK_LPAREN, 0)
                                end
                                if c == 41 then
                                    emit_token(TK_RPAREN, 0)
                                end
                                if c == 91 then
                                    emit_token(TK_LBRACKET, 0)
                                end
                                if c == 93 then
                                    emit_token(TK_RBRACKET, 0)
                                end
                                if c == 123 then
                                    emit_token(TK_LBRACE, 0)
                                end
                                if c == 125 then
                                    emit_token(TK_RBRACE, 0)
                                end
                                if c == 44 then
                                    emit_token(TK_COMMA, 0)
                                end
                                if c == 46 then
                                    emit_token(TK_DOT, 0)
                                end
                                if c == 58 then
                                    emit_token(TK_COLON, 0)
                                end
                                if c == 59 then
                                    emit_token(TK_SEMI, 0)
                                end
                                if c == 61 then
                                    # = or ==
                                    if pos < src_len then
                                        if peek_char() == 61 then
                                            advance_char()
                                            emit_token(TK_EQ, 0)
                                        else
                                            emit_token(TK_ASSIGN, 0)
                                        end
                                    else
                                        emit_token(TK_ASSIGN, 0)
                                    end
                                end
                                if c == 33 then
                                    # ! or !=
                                    if pos < src_len then
                                        if peek_char() == 61 then
                                            advance_char()
                                            emit_token(TK_NE, 0)
                                        else
                                            emit_token(TK_NOT, 0)
                                        end
                                    end
                                end
                                if c == 62 then
                                    # > or >=
                                    if pos < src_len then
                                        if peek_char() == 61 then
                                            advance_char()
                                            emit_token(TK_GE, 0)
                                        else
                                            emit_token(TK_GT, 0)
                                        end
                                    else
                                        emit_token(TK_GT, 0)
                                    end
                                end
                                if c == 60 then
                                    # < or <=
                                    if pos < src_len then
                                        if peek_char() == 61 then
                                            advance_char()
                                            emit_token(TK_LE, 0)
                                        else
                                            emit_token(TK_LT, 0)
                                        end
                                    else
                                        emit_token(TK_LT, 0)
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
    end
    emit_token(TK_EOF, 0)
    return 0
end

