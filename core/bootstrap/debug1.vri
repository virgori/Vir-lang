func main() then
    print_str("main started\n")
    var n = arg_count()
    print n
    if n < 1 then
        print_str("no args\n")
        return 1
    end
    var f = get_arg(0)
    print_str("file: ")
    print_str(f)
    print_str("\n")
    var fd = file_open(f, "r")
    print fd
    if fd == 0 then
        print_str("cannot open\n")
        return 1
    end
    var data = file_read(fd)
    file_close(fd)
    var dlen = len(data)
    print_str("len: ")
    print dlen
    print_str("first 20 chars:\n")
    var i = 0
    while i < 20 then
        if i < dlen then
            var c = str_get(data, i)
            print c
        end
        i = i + 1
    end
    return 0
end
