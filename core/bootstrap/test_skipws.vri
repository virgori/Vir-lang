# Test str_get after skip_ws

var src = ""
var src_len = 0
var pos = 0

func skip_ws() then
    print_str("skip_ws: pos=")
    print pos
    print_str("skip_ws: src_len=")
    print src_len
    while pos < src_len then
        var c = str_get(src, pos)
        print_str("skip_ws loop: c=")
        print c
        if c == 32 then
            pos = pos + 1
        else
            print_str("skip_ws returning\n")
            return 0
        end
    end
    return 0
end

func main() then
    print_str("main\n")
    src = "x = 10"
    src_len = len(src)
    print_str("assigned src\n")
    print_str("src_len=")
    print src_len
    print_str("pos=")
    print pos
    print_str("calling skip_ws\n")
    skip_ws()
    print_str("after skip_ws pos=")
    print pos
    print_str("src check: len=")
    print len(src)
    var c = str_get(src, pos)
    print_str("char at pos: ")
    print c
    return 0
end
