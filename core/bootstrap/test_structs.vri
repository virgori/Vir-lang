# Test: Structs and Pointers

struct Point(x, y)
struct Rect(x1, y1, x2, y2)

func make_point(x, y) then
    return new Point(x, y)
end

func point_sum(p) then
    return p.x + p.y
end

func main() then
    # Test struct creation
    var p = new Point(10, 20)
    print p.x
    print p.y
    
    # Test field assignment
    p.x = 42
    print p.x
    
    # Test struct in function
    var p2 = make_point(100, 200)
    print point_sum(p2)
    
    # Test rect
    var r = new Rect(0, 0, 640, 480)
    print r.x2
    print r.y2
    
    # Test pointer operations
    var a = 99
    var ptr = addr(a)
    var val = deref(ptr)
    print val
    
    return 0
end
