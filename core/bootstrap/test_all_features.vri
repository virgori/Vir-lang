# Test Suite: All new Vir features

struct Point(x, y)
struct Rect(x1, y1, x2, y2)
struct Vec3(x, y, z)

func point_sum(pt) then
    return pt.x + pt.y
end

func vec3_mag_sq(v) then
    return v.x * v.x + v.y * v.y + v.z * v.z
end

func main() then
    # Test 1: Struct basics
    var p = new Point(10, 20)
    print p.x
    print p.y

    # Test 2: Field assignment
    p.x = 42
    print p.x

    # Test 3: Struct in function
    var p2 = new Point(100, 200)
    print point_sum(p2)

    # Test 4: Multiple structs
    var r = new Rect(0, 0, 640, 480)
    print r.x2
    print r.y2

    # Test 5: Addr/Deref
    var myval = 99
    var ptr = addr(myval)
    print deref(ptr)

    # Test 6: For loop (sum 1..10)
    var total = 0
    for i in range(1, 11) then
        total = total + i
    end
    print total

    # Test 7: Break
    var count = 0
    for j in range(0, 100) then
        if j == 5 then
            break
        end
        count = count + 1
    end
    print count

    # Test 8: Vec3 magnitude squared
    var v = new Vec3(3, 4, 0)
    print vec3_mag_sq(v)

    # Test 9: Array + for loop
    var arr = [10, 20, 30, 40, 50]
    var sum = 0
    for k in range(0, 5) then
        sum = sum + arr[k]
    end
    print sum
end
