# Vir v1.2 Syntax Test
# Tests: ':' block opener, when...loop, out, eif, skip, in(params)

func add:
    in(a:int; b:int)
    out a + b;
end

func greet:
    in(name:string)
    print_str("Hello, ")
    print_str(name)
    print_str("!\n")
    out 0;
end

func main:
    # Variable declarations
    var x = 42
    var i = 0
    
    # when...loop (v1.2 conditional loop)
    when i < 5 loop
        i = i + 1
    end
    print i
    
    # Function calls
    var result = add(10, 20)
    print result
    
    # if with ':' block opener and eif
    if x > 100:
        print 100
    eif x > 10:
        print x
    else
        print 0
    end
    
    # Infinite loop with break
    var count = 0
    loop
        count = count + 1
        if count > 3:
            break;
        end
    end
    print count
    
    # skip test in when...loop
    var sum = 0
    var j = 0
    when j < 10 loop
        j = j + 1
        if j == 5:
            skip;
        end
        sum = sum + j
    end
    print sum
    
    out 0;
end
