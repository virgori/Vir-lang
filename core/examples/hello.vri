# ───────────────────────────────────────────
# Vir – Ví dụ chương trình Tiếng Việt
# ───────────────────────────────────────────
# Chạy: vir run examples/hello.vri
# JIT:  vir jit examples/hello.vri

hàm chính() thì
  biến x = 10
  biến y = 20
  biến tổng = x + y
  in ra tổng

  nếu tổng > 25 thì
    in ra 1
  ngược lại
    in ra 0
  hết

  biến đếm = 0
  biến i = 1
  trong khi i < 6 thì
    đếm = đếm + i
    i = i + 1
  hết
  in ra đếm

  trả về tổng
hết
