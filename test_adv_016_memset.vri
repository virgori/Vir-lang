# test_adv_016: Memory byte-level manipulation (memset pattern)
# Expected: 170, 170, 170, 170

func main:
    var ptr = alloc(16)
    # Write pattern 0xAA (170) to 4 bytes
    write_byte(ptr, 0, 170)
    write_byte(ptr, 1, 170)
    write_byte(ptr, 2, 170)
    write_byte(ptr, 3, 170)

    var word = read_word(ptr, 0)
    var b0 = word & 255
    var b1 = (word >> 8) & 255
    var b2 = (word >> 16) & 255
    var b3 = (word >> 24) & 255
    print b0
    print b1
    print b2
    print b3
end.
