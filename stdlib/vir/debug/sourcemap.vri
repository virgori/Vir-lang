##
 * vir/debug/sourcemap.vri — Source Maps
 * ========================================
 * Inspired by: Source Map v3 (JavaScript)
 *
 * Maps generated code positions back to original Vir
 * source positions for debugging.
 ##

include types;
include vec;
import Vec, vec_new, vec_push, vec_len, vec_get from vec;
include string_builder;
import StringBuilder, sb_new, sb_append, sb_append_byte, sb_build from string_builder;

# ═══════════════════════════════════════════════════════
# Source map mapping entry
# ═══════════════════════════════════════════════════════

entity SourceMapping:
    gen_line:   int;     # generated line (0-based)
    gen_col:    int;     # generated column (0-based)
    src_idx:    int;     # source file index
    src_line:   int;     # original line (0-based)
    src_col:    int;     # original column (0-based)
    name_idx:   int;     # name index, -1 if none
end

# ═══════════════════════════════════════════════════════
# Source Map
# ═══════════════════════════════════════════════════════

entity SourceMap:
    version:   int;       # always 3
    file:      string;    # generated file name
    sources:   Vec;       # Vec<string> source file names
    names:     Vec;       # Vec<string> symbol names
    mappings:  Vec;       # Vec<SourceMapping>
end

func sourcemap_new:
    in(file: string)
    out SourceMap {
        version: 3, file: file,
        sources: vec_new(), names: vec_new(),
        mappings: vec_new()
    };
end

func sm_add_source:
    in(sm: SourceMap; source: string)
    vec_push(sm.sources, source);
    out vec_len(sm.sources) - 1;
end

func sm_add_name:
    in(sm: SourceMap; name: string)
    vec_push(sm.names, name);
    out vec_len(sm.names) - 1;
end

func sm_add_mapping:
    in(sm: SourceMap; gen_line: int; gen_col: int; src_idx: int; src_line: int; src_col: int; name_idx: int)
    vec_push(sm.mappings, SourceMapping {
        gen_line: gen_line, gen_col: gen_col,
        src_idx: src_idx, src_line: src_line,
        src_col: src_col, name_idx: name_idx
    });
end

# ═══════════════════════════════════════════════════════
# Base64 VLQ encoding (Source Map v3 format)
# ═══════════════════════════════════════════════════════

const B64_CHARS = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";

func _vlq_encode:
    in(value: int)
    sb = sb_new();
    vlq = value;
    if vlq < 0:
        vlq = ((-vlq) << 1) | 1;
    else:
        vlq = vlq << 1;
    end

    done = false;
    when !done loop
        digit = vlq & 0x1F;
        vlq = vlq >> 5;
        if vlq > 0:
            digit = digit | 0x20;   # continuation bit
        else:
            done = true;
        end
        sb_append(sb, str_substr(B64_CHARS, digit, digit + 1));
    end

    out sb_build(sb);
end

# ═══════════════════════════════════════════════════════
# Generate mappings string
# ═══════════════════════════════════════════════════════

func sm_encode_mappings:
    in(sm: SourceMap)
    sb = sb_new();
    prev_gen_col = 0;
    prev_src_idx = 0;
    prev_src_line = 0;
    prev_src_col = 0;
    prev_name_idx = 0;
    prev_gen_line = 0;

    i = 0;
    when i < vec_len(sm.mappings) loop
        m = vec_get(sm.mappings, i);

        # Line separators
        when prev_gen_line < m.gen_line loop
            sb_append(sb, ";");
            prev_gen_line = prev_gen_line + 1;
            prev_gen_col = 0;
        end

        # Segment separator
        if i > 0 && m.gen_line == prev_gen_line:
            # Check if not first on this line
            need_comma = false;
            if i > 0:
                prev_m = vec_get(sm.mappings, i - 1);
                if prev_m.gen_line == m.gen_line:
                    need_comma = true;
                end
            end
            if need_comma:
                sb_append(sb, ",");
            end
        end

        # Column in generated
        sb_append(sb, _vlq_encode(m.gen_col - prev_gen_col));
        prev_gen_col = m.gen_col;

        # Source index
        sb_append(sb, _vlq_encode(m.src_idx - prev_src_idx));
        prev_src_idx = m.src_idx;

        # Source line
        sb_append(sb, _vlq_encode(m.src_line - prev_src_line));
        prev_src_line = m.src_line;

        # Source column
        sb_append(sb, _vlq_encode(m.src_col - prev_src_col));
        prev_src_col = m.src_col;

        # Name
        if m.name_idx >= 0:
            sb_append(sb, _vlq_encode(m.name_idx - prev_name_idx));
            prev_name_idx = m.name_idx;
        end

        i = i + 1;
    end

    out sb_build(sb);
end

# ═══════════════════════════════════════════════════════
# JSON output
# ═══════════════════════════════════════════════════════

func sm_to_json:
    in(sm: SourceMap)
    sb = sb_new();
    sb_append(sb, "{");
    sb_append(sb, "\"version\":3,");
    sb_append(sb, "\"file\":\"");
    sb_append(sb, sm.file);
    sb_append(sb, "\",");

    # Sources array
    sb_append(sb, "\"sources\":[");
    i = 0;
    when i < vec_len(sm.sources) loop
        if i > 0:
            sb_append(sb, ",");
        end
        sb_append(sb, "\"");
        sb_append(sb, vec_get(sm.sources, i));
        sb_append(sb, "\"");
        i = i + 1;
    end
    sb_append(sb, "],");

    # Names array
    sb_append(sb, "\"names\":[");
    i = 0;
    when i < vec_len(sm.names) loop
        if i > 0:
            sb_append(sb, ",");
        end
        sb_append(sb, "\"");
        sb_append(sb, vec_get(sm.names, i));
        sb_append(sb, "\"");
        i = i + 1;
    end
    sb_append(sb, "],");

    # Mappings
    sb_append(sb, "\"mappings\":\"");
    sb_append(sb, sm_encode_mappings(sm));
    sb_append(sb, "\"");

    sb_append(sb, "}");
    out sb_build(sb);
end

# ═══════════════════════════════════════════════════════
# Lookup: find original position from generated position
# ═══════════════════════════════════════════════════════

entity OriginalPosition:
    found:    bool;
    source:   string;
    line:     int;
    column:   int;
    name:     string;
end

func sm_lookup:
    in(sm: SourceMap; gen_line: int; gen_col: int)
    best_idx = -1;
    best_dist = 999999999;

    i = 0;
    when i < vec_len(sm.mappings) loop
        m = vec_get(sm.mappings, i);
        if m.gen_line == gen_line && m.gen_col <= gen_col:
            dist = gen_col - m.gen_col;
            if dist < best_dist:
                best_dist = dist;
                best_idx = i;
            end
        end
        i = i + 1;
    end

    if best_idx >= 0:
        m = vec_get(sm.mappings, best_idx);
        src = "";
        if m.src_idx >= 0 && m.src_idx < vec_len(sm.sources):
            src = vec_get(sm.sources, m.src_idx);
        end
        nm = "";
        if m.name_idx >= 0 && m.name_idx < vec_len(sm.names):
            nm = vec_get(sm.names, m.name_idx);
        end
        out OriginalPosition {
            found: true, source: src,
            line: m.src_line, column: m.src_col, name: nm
        };
    end

    out OriginalPosition { found: false, source: "", line: 0, column: 0, name: "" };
end
