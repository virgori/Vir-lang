##
 * vir/debug/assert.vri — Assertions & Debug Checks
 * ===================================================
 * Inspired by C23: assert.h, static_assert
 * Inspired by Python: assert, unittest assertions
 *
 * Compiler uses internally: validation in mỗi pass.
 ##

include types;
include string;
import String, str_new, str_concat, str_eq from string;
include stdio;
import eprintln from stdio;
include format;
import format_int from format;

# ═══════════════════════════════════════════════════════
# Basic Assertions
# ═══════════════════════════════════════════════════════

func assert:
    in(cond:bool; msg:string)
    # Panic if cond == false.
    if !cond:
        eprintln(str_concat(str_new("Assertion failed: "), msg));
        native_abort();
    end
end

func assert_true:
    in(cond:bool)
    assert(cond, str_new("expected true"));
end

func assert_false:
    in(cond:bool)
    assert(!cond, str_new("expected false"));
end

# ─── Equality ─────────────────────────────────────────

func assert_eq_i64:
    in(a:int; b:int)
    if a != b:
        msg = str_concat(;
            str_new("assert_eq failed: "),;
            str_concat(format_int(a, 10), str_concat(str_new(" != "), format_int(b, 10)));
        );
        eprintln(msg);
        native_abort();
    end
end

func assert_eq_str:
    in(a:string; b:string)
    if !str_eq(a, b):
        msg = str_concat(;
            str_new("assert_eq failed: \""),;
            str_concat(a, str_concat(str_new("\" != \""), str_concat(b, str_new("\""))));
        );
        eprintln(msg);
        native_abort();
    end
end

func assert_eq_bool:
    in(a:bool; b:bool)
    if a != b:
        eprintln(str_new("assert_eq failed: bool mismatch"));
        native_abort();
    end
end

func assert_eq_ptr:
    in(a:ptr; b:ptr)
    if a != b:
        eprintln(str_new("assert_eq failed: pointer mismatch"));
        native_abort();
    end
end

# ─── Inequality ───────────────────────────────────────

func assert_ne_i64:
    in(a:int; b:int)
    if a == b:
        msg = str_concat(;
            str_new("assert_ne failed: both equal "),;
            format_int(a, 10);
        );
        eprintln(msg);
        native_abort();
    end
end

func assert_ne_str:
    in(a:string; b:string)
    if str_eq(a, b):
        eprintln(str_concat(str_new("assert_ne failed: both equal \""),;
            str_concat(a, str_new("\""))));
        native_abort();
    end
end

# ─── Comparison ───────────────────────────────────────

func assert_lt:
    in(a:int; b:int)
    if !(a < b):
        eprintln(str_concat(;
            str_new("assert_lt failed: "),;
            str_concat(format_int(a, 10), str_concat(str_new(" >= "), format_int(b, 10)));
        ));
        native_abort();
    end
end

func assert_le:
    in(a:int; b:int)
    if !(a <= b):
        eprintln(str_concat(;
            str_new("assert_le failed: "),;
            str_concat(format_int(a, 10), str_concat(str_new(" > "), format_int(b, 10)));
        ));
        native_abort();
    end
end

func assert_gt:
    in(a:int; b:int)
    if !(a > b):
        eprintln(str_concat(;
            str_new("assert_gt failed: "),;
            str_concat(format_int(a, 10), str_concat(str_new(" <= "), format_int(b, 10)));
        ));
        native_abort();
    end
end

func assert_ge:
    in(a:int; b:int)
    if !(a >= b):
        eprintln(str_concat(;
            str_new("assert_ge failed: "),;
            str_concat(format_int(a, 10), str_concat(str_new(" < "), format_int(b, 10)));
        ));
        native_abort();
    end
end

# ─── Null Check ───────────────────────────────────────

func assert_not_null:
    in(p:ptr; msg:string)
    if p == null:
        eprintln(str_concat(str_new("assert_not_null failed: "), msg));
        native_abort();
    end
end

func assert_null:
    in(p:ptr; msg:string)
    if p != null:
        eprintln(str_concat(str_new("assert_null failed: "), msg));
        native_abort();
    end
end

# ─── Range Check ──────────────────────────────────────

func assert_in_range:
    in(val:int; lo:int; hi:int)
    # Kiểm tra lo <= val <= hi
    if val < lo or val > hi:
        msg = str_concat(;
            format_int(val, 10),;
            str_concat(str_new(" not in ["),;
                str_concat(format_int(lo, 10),;
                    str_concat(str_new(", "), str_concat(format_int(hi, 10), str_new("]")))));
        );
        eprintln(str_concat(str_new("assert_in_range failed: "), msg));
        native_abort();
    end
end

# ═══════════════════════════════════════════════════════
# Debug Assertions (chỉ active in debug build)
# ═══════════════════════════════════════════════════════
# Khi biên dịch với -O (optimize), các debug_assert được bỏ qua.

func debug_assert:
    in(cond:bool; msg:string)
    @if DEBUG;
        assert(cond, msg);
    @end;
end

func debug_assert_eq_i64:
    in(a:int; b:int)
    @if DEBUG;
        assert_eq_i64(a, b);
    @end;
end

func debug_assert_not_null:
    in(p:ptr; msg:string)
    @if DEBUG;
        assert_not_null(p, msg);
    @end;
end
