/*
 * vir/debug/assert.vri — Assertions & Debug Checks
 * ===================================================
 * Inspired by C23: assert.h, static_assert
 * Inspired by Python: assert, unittest assertions
 *
 * Compiler uses internally: validation in mỗi pass.
 */

import "vir/core/types" use all
import "vir/str/string" use String, str_new, str_concat, str_eq
import "vir/io/stdio" use eprintln
import "vir/io/format" use format_int

# ═══════════════════════════════════════════════════════
# Basic Assertions
# ═══════════════════════════════════════════════════════

func assert(cond: bool, msg: String)
    # Panic if cond == false.
    if !cond
        eprintln(str_concat(str_new("Assertion failed: "), msg))
        native_abort()
    end
end

func assert_true(cond: bool)
    assert(cond, str_new("expected true"))
end

func assert_false(cond: bool)
    assert(!cond, str_new("expected false"))
end

# ─── Equality ─────────────────────────────────────────

func assert_eq_i64(a: i64, b: i64)
    if a != b
        var msg = str_concat(
            str_new("assert_eq failed: "),
            str_concat(format_int(a, 10), str_concat(str_new(" != "), format_int(b, 10)))
        )
        eprintln(msg)
        native_abort()
    end
end

func assert_eq_str(a: String, b: String)
    if !str_eq(a, b)
        var msg = str_concat(
            str_new("assert_eq failed: \""),
            str_concat(a, str_concat(str_new("\" != \""), str_concat(b, str_new("\""))))
        )
        eprintln(msg)
        native_abort()
    end
end

func assert_eq_bool(a: bool, b: bool)
    if a != b
        eprintln(str_new("assert_eq failed: bool mismatch"))
        native_abort()
    end
end

func assert_eq_ptr(a: ptr, b: ptr)
    if a != b
        eprintln(str_new("assert_eq failed: pointer mismatch"))
        native_abort()
    end
end

# ─── Inequality ───────────────────────────────────────

func assert_ne_i64(a: i64, b: i64)
    if a == b
        var msg = str_concat(
            str_new("assert_ne failed: both equal "),
            format_int(a, 10)
        )
        eprintln(msg)
        native_abort()
    end
end

func assert_ne_str(a: String, b: String)
    if str_eq(a, b)
        eprintln(str_concat(str_new("assert_ne failed: both equal \""),
            str_concat(a, str_new("\""))))
        native_abort()
    end
end

# ─── Comparison ───────────────────────────────────────

func assert_lt(a: i64, b: i64)
    if !(a < b)
        eprintln(str_concat(
            str_new("assert_lt failed: "),
            str_concat(format_int(a, 10), str_concat(str_new(" >= "), format_int(b, 10)))
        ))
        native_abort()
    end
end

func assert_le(a: i64, b: i64)
    if !(a <= b)
        eprintln(str_concat(
            str_new("assert_le failed: "),
            str_concat(format_int(a, 10), str_concat(str_new(" > "), format_int(b, 10)))
        ))
        native_abort()
    end
end

func assert_gt(a: i64, b: i64)
    if !(a > b)
        eprintln(str_concat(
            str_new("assert_gt failed: "),
            str_concat(format_int(a, 10), str_concat(str_new(" <= "), format_int(b, 10)))
        ))
        native_abort()
    end
end

func assert_ge(a: i64, b: i64)
    if !(a >= b)
        eprintln(str_concat(
            str_new("assert_ge failed: "),
            str_concat(format_int(a, 10), str_concat(str_new(" < "), format_int(b, 10)))
        ))
        native_abort()
    end
end

# ─── Null Check ───────────────────────────────────────

func assert_not_null(p: ptr, msg: String)
    if p == null
        eprintln(str_concat(str_new("assert_not_null failed: "), msg))
        native_abort()
    end
end

func assert_null(p: ptr, msg: String)
    if p != null
        eprintln(str_concat(str_new("assert_null failed: "), msg))
        native_abort()
    end
end

# ─── Range Check ──────────────────────────────────────

func assert_in_range(val: i64, lo: i64, hi: i64)
    # Kiểm tra lo <= val <= hi
    if val < lo or val > hi
        var msg = str_concat(
            format_int(val, 10),
            str_concat(str_new(" not in ["),
                str_concat(format_int(lo, 10),
                    str_concat(str_new(", "), str_concat(format_int(hi, 10), str_new("]")))))
        )
        eprintln(str_concat(str_new("assert_in_range failed: "), msg))
        native_abort()
    end
end

# ═══════════════════════════════════════════════════════
# Debug Assertions (chỉ active in debug build)
# ═══════════════════════════════════════════════════════
# Khi biên dịch với -O (optimize), các debug_assert được bỏ qua.

func debug_assert(cond: bool, msg: String)
    @if DEBUG
        assert(cond, msg)
    @end
end

func debug_assert_eq_i64(a: i64, b: i64)
    @if DEBUG
        assert_eq_i64(a, b)
    @end
end

func debug_assert_not_null(p: ptr, msg: String)
    @if DEBUG
        assert_not_null(p, msg)
    @end
end
