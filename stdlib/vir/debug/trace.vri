##
 * vir/debug/trace.vri — Stack Trace & Debug Logging
 * ====================================================
 * Inspired by Python: traceback
 * Inspired by C: backtrace, addr2line
 *
 * Cung cấp stack trace and debug logging cho runtime.
 ##

include types;
include string;
import String, str_new, str_concat from string;
include builder;
import StringBuilder, sb_new, sb_append, sb_append_newline, sb_build from builder;
include stdio;
import eprintln from stdio;
include format;
import format_int, format_hex from format;
include vec;
import Vec, vec_new, vec_push, vec_len, vec_get from vec;

# ═══════════════════════════════════════════════════════
# Stack Frame
# ═══════════════════════════════════════════════════════

entity Frame:
    address:   int       # instruction pointer,
        func_name: string    # tên func (if có symbol),
        file:      string    # file nguồn (if có debug info),
        line:      int       # dòng (0 if not biết);
end

# ═══════════════════════════════════════════════════════
# Trace — Capture stack trace
# ═══════════════════════════════════════════════════════

entity Trace:
    frames: Vec<Frame>;
end.

func capture_trace:
    # Lấy stack trace hiện tại từ runtime.
    frames = vec_new<Frame>();
    depth = native_backtrace_depth();
    i = 0;
    when i < depth loop
        addr = native_backtrace_addr(i);
        name = native_backtrace_symbol(i);
        file = native_backtrace_file(i);
        line = native_backtrace_line(i);
        vec_push<Frame>(&frames, Frame (;
            address = addr,
            func_name = name,
            file = file,
            line = line
    ));
        i = i + 1;
    end
    out Trace ( frames = frames );
end.

func trace_to_string:
    in(t:Trace)
    sb = sb_new();
    sb_append(&sb, str_new("Stack trace:"));
    sb_append_newline(&sb);
    
    i = 0;
    when i < vec_len<Frame>(t.frames) loop
        f = vec_get<Frame>(t.frames, i);
        sb_append(&sb, str_new("  "));
        sb_append(&sb, format_int(i, 10));
        sb_append(&sb, str_new(": "));
        sb_append(&sb, f.func_name);
        sb_append(&sb, str_new(" at "));
        sb_append(&sb, f.file);
        sb_append(&sb, str_new(":"));
        sb_append(&sb, format_int(f.line, 10));
        sb_append(&sb, str_new(" [0x"));
        sb_append(&sb, format_hex(f.address));
        sb_append(&sb, str_new("]"));
        sb_append_newline(&sb);
        i = i + 1;
    end
    
    out sb_build(sb);
end.

func print_trace:
    t = capture_trace();
    eprintln(trace_to_string(t));
end

# ═══════════════════════════════════════════════════════
# Debug Logging
# ═══════════════════════════════════════════════════════

enum LogLevel:
    Trace = 0;
    Debug = 1;
    Info  = 2;
    Warn  = 3;
    Error = 4;
    Fatal = 5;
end

_log_level = LogLevel.Info;

func set_log_level:
    in(level:LogLevel)
    _log_level = level;
end.

func log_level:
    out _log_level;
end.

func _should_log:
    in(level:LogLevel)
    out level >= _log_level;
end.

func _log_prefix:
    in(level:LogLevel)
    case level;
        case LogLevel.Trace out str_new("[TRACE] ")
        case LogLevel.Debug out str_new("[DEBUG] ")
        case LogLevel.Info  out str_new("[INFO]  ")
        case LogLevel.Warn  out str_new("[WARN]  ")
        case LogLevel.Error out str_new("[ERROR] ")
        case LogLevel.Fatal out str_new("[FATAL] ")
        default out str_new("[???]   ");
    end
end.

func log:
    in(level:LogLevel; msg:string)
    if !_should_log(level) do out end
    eprintln(str_concat(_log_prefix(level), msg));
end.

func log_trace:
    in(msg:string)
    log(LogLevel.Trace, msg);
end.

func log_debug:
    in(msg:string)
    log(LogLevel.Debug, msg);
end.

func log_info:
    in(msg:string)
    log(LogLevel.Info, msg);
end.

func log_warn:
    in(msg:string)
    log(LogLevel.Warn, msg);
end.

func log_error:
    in(msg:string)
    log(LogLevel.Error, msg);
end.

func log_fatal:
    in(msg:string)
    log(LogLevel.Fatal, msg);
    print_trace();
    native_abort();
end

# ═══════════════════════════════════════════════════════
# Fault Handler
# ═══════════════════════════════════════════════════════

func install_fault_handler:
    # Cài đặt handler cho SIGSEGV, SIGBUS, SIGFPE
    # để in stack trace thay vì crash im lặng.
    native_install_fault_handler();
end
