/*
 * vir/debug/trace.vri — Stack Trace & Debug Logging
 * ====================================================
 * Inspired by Python: traceback
 * Inspired by C: backtrace, addr2line
 *
 * Cung cấp stack trace and debug logging cho runtime.
 */

import "vir/core/types" use all
import "vir/str/string" use String, str_new, str_concat
import "vir/str/builder" use StringBuilder, sb_new, sb_append, sb_append_newline, sb_build
import "vir/io/stdio" use eprintln
import "vir/io/format" use format_int, format_hex
import "vir/collections/vec" use Vec, vec_new, vec_push, vec_len, vec_get

# ═══════════════════════════════════════════════════════
# Stack Frame
# ═══════════════════════════════════════════════════════

entity Frame
    address:   u64       # instruction pointer
    func_name: String    # tên func (if có symbol)
    file:      String    # file nguồn (if có debug info)
    line:      u64       # dòng (0 if not biết)
end

# ═══════════════════════════════════════════════════════
# Trace — Capture stack trace
# ═══════════════════════════════════════════════════════

entity Trace
    frames: Vec<Frame>
end

func capture_trace() -> Trace
    # Lấy stack trace hiện tại từ runtime.
    var frames = vec_new<Frame>()
    var depth = native_backtrace_depth()
    var i: usize = 0
    lặp_khi i < depth
        var addr = native_backtrace_addr(i)
        var name = native_backtrace_symbol(i)
        var file = native_backtrace_file(i)
        var line = native_backtrace_line(i)
        vec_push<Frame>(&frames, Frame {
            address = addr,
            func_name = name,
            file = file,
            line = line
        })
        i = i + 1
    end
    out Trace { frames = frames }
end

func trace_to_string(t: Trace) -> String
    var sb = sb_new()
    sb_append(&sb, str_new("Stack trace:"))
    sb_append_newline(&sb)
    
    var i: usize = 0
    lặp_khi i < vec_len<Frame>(t.frames)
        var f = vec_get<Frame>(t.frames, i)
        sb_append(&sb, str_new("  "))
        sb_append(&sb, format_int(i, 10))
        sb_append(&sb, str_new(": "))
        sb_append(&sb, f.func_name)
        sb_append(&sb, str_new(" at "))
        sb_append(&sb, f.file)
        sb_append(&sb, str_new(":"))
        sb_append(&sb, format_int(f.line, 10))
        sb_append(&sb, str_new(" [0x"))
        sb_append(&sb, format_hex(f.address))
        sb_append(&sb, str_new("]"))
        sb_append_newline(&sb)
        i = i + 1
    end
    
    out sb_build(sb)
end

func print_trace()
    var t = capture_trace()
    eprintln(trace_to_string(t))
end

# ═══════════════════════════════════════════════════════
# Debug Logging
# ═══════════════════════════════════════════════════════

enum LogLevel
    Trace = 0
    Debug = 1
    Info  = 2
    Warn  = 3
    Error = 4
    Fatal = 5
end

var _log_level: LogLevel = LogLevel.Info

func set_log_level(level: LogLevel)
    _log_level = level
end

func log_level() -> LogLevel
    out _log_level
end

func _should_log(level: LogLevel) -> bool
    out level >= _log_level
end

func _log_prefix(level: LogLevel) -> String
    chọn level
        case LogLevel.Trace out str_new("[TRACE] ")
        case LogLevel.Debug out str_new("[DEBUG] ")
        case LogLevel.Info  out str_new("[INFO]  ")
        case LogLevel.Warn  out str_new("[WARN]  ")
        case LogLevel.Error out str_new("[ERROR] ")
        case LogLevel.Fatal out str_new("[FATAL] ")
        mặc_định out str_new("[???]   ")
    end
end

func log(level: LogLevel, msg: String)
    if !_should_log(level) out end
    eprintln(str_concat(_log_prefix(level), msg))
end

func log_trace(msg: String)
    log(LogLevel.Trace, msg)
end

func log_debug(msg: String)
    log(LogLevel.Debug, msg)
end

func log_info(msg: String)
    log(LogLevel.Info, msg)
end

func log_warn(msg: String)
    log(LogLevel.Warn, msg)
end

func log_error(msg: String)
    log(LogLevel.Error, msg)
end

func log_fatal(msg: String)
    log(LogLevel.Fatal, msg)
    print_trace()
    native_abort()
end

# ═══════════════════════════════════════════════════════
# Fault Handler
# ═══════════════════════════════════════════════════════

func install_fault_handler()
    # Cài đặt handler cho SIGSEGV, SIGBUS, SIGFPE
    # để in stack trace thay vì crash im lặng.
    native_install_fault_handler()
end
