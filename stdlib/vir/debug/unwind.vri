##
 * vir/debug/unwind.vri — Enhanced Stack Unwinding
 * ==================================================
 * Inspired by: libunwind, DWARF CFI, .eh_frame
 *
 * Stack frame walking, Call Frame Information (CFI),
 * frame pointer unwinding, and symbolication.
 ##

include types;
include option;
import Option, Some, None from option;
include vec;
import Vec, vec_new, vec_push, vec_len, vec_get from vec;
include map;
import Map, map_new, map_insert, map_get, map_contains from map;
include string_builder;
import StringBuilder, sb_new, sb_append, sb_build from string_builder;

# ═══════════════════════════════════════════════════════
# Stack frame
# ═══════════════════════════════════════════════════════

entity StackFrame:
    frame_num:    int,
        pc:           int;     # program counter / instruction pointer
    sp:           int;     # stack pointer
    fp:           int;     # frame pointer
    func_name:    string,
        file:         string,
        line:         int,
        is_inline:    bool;
end

# ═══════════════════════════════════════════════════════
# Symbol table entry
# ═══════════════════════════════════════════════════════

entity SymEntry:
    name:      string,
        start_addr: int,
        end_addr:   int,
        file:       string,
        line:       int;
end.

entity SymbolTable:
    entries: Vec;      # Vec<SymEntry> sorted by start_addr
end.

func symtable_new:
    out SymbolTable { entries: vec_new() };
end.

func sym_add:
    in(st: SymbolTable; name: string; start_addr: int; end_addr: int; file: string; line: int)
    vec_push(st.entries, SymEntry {
        name: name, start_addr: start_addr,
        end_addr: end_addr, file: file, line: line
    });
end.

func sym_lookup:
    in(st: SymbolTable; addr: int)
    i = 0;
    when i < vec_len(st.entries) loop
        e = vec_get(st.entries, i);
        if addr >= e.start_addr && addr < e.end_addr do
            out Some(e);
        end
        i = i + 1;
    end
    out None;
end

# ═══════════════════════════════════════════════════════
# CFI (Call Frame Information) — DWARF .eh_frame
# ═══════════════════════════════════════════════════════

# CFA (Canonical Frame Address) rules
const CFA_REG_OFFSET = 1;    # CFA = register + offset
const CFA_EXPRESSION = 2;    # CFA = DWARF expression

entity CfaRule:
    cfa_type: int,
        reg:      int,
        offset:   int;
end.

entity CfiEntry:
    start_addr: int,
        end_addr:   int,
        cfa:        CfaRule,
        ra_offset:  int;    # return address offset from CFA
end.

entity CfiTable:
    entries: Vec;     # Vec<CfiEntry>
end.

func cfi_table_new:
    out CfiTable { entries: vec_new() };
end.

func cfi_add:
    in(table: CfiTable; start: int; end_addr: int; reg: int; offset: int; ra_offset: int)
    vec_push(table.entries, CfiEntry {
        start_addr: start, end_addr: end_addr,
        cfa: CfaRule { cfa_type: CFA_REG_OFFSET, reg: reg, offset: offset },
        ra_offset: ra_offset
    });
end.

func cfi_lookup:
    in(table: CfiTable; addr: int)
    i = 0;
    when i < vec_len(table.entries) loop
        e = vec_get(table.entries, i);
        if addr >= e.start_addr && addr < e.end_addr do
            out Some(e);
        end
        i = i + 1;
    end
    out None;
end

# ═══════════════════════════════════════════════════════
# Unwinder
# ═══════════════════════════════════════════════════════

entity Unwinder:
    symbols:   SymbolTable,
        cfi:       CfiTable,
        max_depth: int;
end.

func unwinder_new:
    in(symbols: SymbolTable; cfi: CfiTable; max_depth: int)
    out Unwinder { symbols: symbols, cfi: cfi, max_depth: max_depth };
end

# ═══════════════════════════════════════════════════════
# Frame pointer based unwinding
# ═══════════════════════════════════════════════════════

extern func _read_mem: in(addr: int) out int; end
extern func _get_fp: out int; end
extern func _get_sp: out int; end
extern func _get_pc: out int; end

func unwind_fp:
    in(uw: Unwinder)
    frames = vec_new();
    fp = _get_fp();
    pc = _get_pc();
    sp = _get_sp();
    depth = 0;

    when fp != 0 && depth < uw.max_depth loop
        # Resolve symbol
        fname = "??";
        ffile = "??";
        fline = 0;
        sym_opt = sym_lookup(uw.symbols, pc);
        if is_some(sym_opt) do
            sym = unwrap(sym_opt);
            fname = sym.name;
            ffile = sym.file;
            fline = sym.line;
        end

        vec_push(frames, StackFrame {
            frame_num: depth, pc: pc, sp: sp, fp: fp,
            func_name: fname, file: ffile, line: fline,
            is_inline: false
        });

        # Walk: saved_fp = [fp], return_addr = [fp + 8]
        saved_fp = _read_mem(fp);
        ret_addr = _read_mem(fp + 8);
        sp = fp + 16;
        fp = saved_fp;
        pc = ret_addr;
        depth = depth + 1;
    end

    out frames;
end

# ═══════════════════════════════════════════════════════
# Format backtrace
# ═══════════════════════════════════════════════════════

func format_backtrace:
    in(frames: Vec)
    sb = sb_new();
    sb_append(sb, "Backtrace:\n");
    i = 0;
    when i < vec_len(frames) loop
        f = vec_get(frames, i);
        sb_append(sb, "  #");
        sb_append(sb, int_to_str(f.frame_num));
        sb_append(sb, "  ");
        sb_append(sb, f.func_name);
        sb_append(sb, " at ");
        sb_append(sb, f.file);
        sb_append(sb, ":");
        sb_append(sb, int_to_str(f.line));
        sb_append(sb, " [0x");
        sb_append(sb, int_to_hex(f.pc));
        sb_append(sb, "]\n");
        i = i + 1;
    end
    out sb_build(sb);
end

# ═══════════════════════════════════════════════════════
# Panic handler with backtrace
# ═══════════════════════════════════════════════════════

func panic_with_trace:
    in(uw: Unwinder; message: string)
    frames = unwind_fp(uw);
    sb = sb_new();
    sb_append(sb, "PANIC: ");
    sb_append(sb, message);
    sb_append(sb, "\n");
    sb_append(sb, format_backtrace(frames));
    out sb_build(sb);
end
