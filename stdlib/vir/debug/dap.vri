## dap.vri — Debug Adapter Protocol types for Vir
## =================================================
## DAP 1.65 type definitions for debug adapter integration.

include types;
include option;
import Option, Some, None from option;
include result;
import Result, Ok, Err from result;

## ── DAP Events ────────────────────────────────────────

enum StopReason:
    Entry
    Breakpoint
    Step
    Pause
    Exception
    Exit
end

## ── Breakpoint ────────────────────────────────────────

entity DapBreakpoint:
    id: int
    line: int
    column: int
    verified: bool
    source_path: string
end.

func breakpoint_new: in(line: int, path: string) -> DapBreakpoint
    out DapBreakpoint {
        id: 0,
        line: line,
        column: 0,
        verified: false,
        source_path: path
    };
end

## ── Stack Frame ───────────────────────────────────────

entity DapStackFrame:
    id: int
    name: string
    source_path: string
    line: int
    column: int
end

## ── Scope ─────────────────────────────────────────────

entity DapScope:
    name: string
    variables_ref: int
    expensive: bool
end

## ── Variable ──────────────────────────────────────────

entity DapVariable:
    name: string
    value: string
    type_name: string
    variables_ref: int
end

## ── Source ─────────────────────────────────────────────

entity DapSource:
    name: string
    path: string
end

## ── Request / Response (JSON-RPC like) ────────────────

entity DapRequest:
    seq: int
    command: string
    arguments: string       ## JSON string
end.

entity DapResponse:
    seq: int
    request_seq: int
    command: string
    success: bool
    body: string            ## JSON string
end.

entity DapEvent:
    seq: int
    event: string
    body: string            ## JSON string
end

## ── Capabilities ──────────────────────────────────────

func dap_capabilities: in() -> string
    out "{\"supportsConfigurationDoneRequest\":true,\"supportsEvaluateForHovers\":true,\"supportsSteppingGranularity\":true}";
end

## ── Protocol helpers ──────────────────────────────────

extern func dap_server_start: in(port: int) -> int;
extern func dap_server_stop: in() -> int;
extern func dap_send_event: in(event: string, body: string) -> int;
extern func dap_send_response: in(req_seq: int, command: string, body: string) -> int;
