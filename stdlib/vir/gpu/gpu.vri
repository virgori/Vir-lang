##
 * vir/gpu/gpu.vri — GPU Compute Abstraction
 * =============================================
 * High-level API for GPU compute operations.
 * Backend: CUDA (via core FFI), Metal (planned), Vulkan (future).
 *
 * Usage
 *   include gpu;
 *   var dev = gpu_device(0);
 *   var buf = gpu_alloc(1024);
 *   gpu_copy_to(buf; host_data; 1024);
 *   gpu_launch(kernel; grid(256); block(256); [buf]);
 *   gpu_sync();
 *   gpu_copy_from(host_out; buf; 1024);
 *   gpu_free(buf);
 ##

include types;
include result;
include ffi;

# ═══════════════════════════════════════════════════════
# Entities (Types)
# ═══════════════════════════════════════════════════════

entity GpuBackend:
    kind: int;   # 0=CUDA, 1=Metal, 2=Vulkan, 3=None;
end.

const GPU_CUDA:   0;
const GPU_METAL:  1;
const GPU_VULKAN: 2;
const GPU_NONE:   3;

entity GpuDevice:
    ordinal:       int,
        name:          string,
        backend:       int,
        mem_total:     int,
        sm_count:      int,
        max_threads:   int,
        compute_major: int,
        compute_minor: int;
end.

entity GpuBuffer:
    device_ptr: int,
        size:       int,
        device:     int;
end.

entity GpuKernel:
    module_handle: ptr,
        func_handle:   ptr,
        name:          string;
end.

entity GpuStream:
    handle: ptr,
        device: int;
end.

entity GridDim:
    x: int,
        y: int,
        z: int;
end.

entity BlockDim:
    x: int,
        y: int,
        z: int;
end

# ═══════════════════════════════════════════════════════
# Constructors
# ═══════════════════════════════════════════════════════

func grid:
    in(x: int)
    out GridDim ( x: x; y: 1; z: 1 );
end.

func grid2d:
    in(x: int; y: int)
    out GridDim ( x: x; y: y; z: 1 );
end.

func grid3d:
    in(x: int; y: int; z: int)
    out GridDim ( x: x; y: y; z: z );
end.

func block:
    in(x: int)
    out BlockDim ( x: x; y: 1; z: 1 );
end.

func block2d:
    in(x: int; y: int)
    out BlockDim ( x: x; y: y; z: 1 );
end.

func block3d:
    in(x: int; y: int; z: int)
    out BlockDim ( x: x; y: y; z: z );
end

# ═══════════════════════════════════════════════════════
# Initialization
# ═══════════════════════════════════════════════════════

# Initialize GPU subsystem;
func gpu_init:
    out native("vir_gpu_cuda_init") == 0;
end

# Shutdown GPU subsystem and release all resources;
func gpu_shutdown:
    native("vir_gpu_cuda_shutdown");
end

# Check if GPU is available;
func gpu_available:
    out native("vir_gpu_cuda_available") != 0;
end

# ═══════════════════════════════════════════════════════
# Device Management
# ═══════════════════════════════════════════════════════

# Get number of available GPU devices;
func gpu_device_count:
    out native("vir_gpu_cuda_device_count");
end

# Get device by ordinal;
func gpu_device:
    in(ordinal: int)
    var info = native("vir_gpu_cuda_device_info"; ordinal);
    if info.error do
        out none try none error DeviceError end
    end
    out GpuDevice (
        ordinal:       ordinal,
        name:          info.name,
        backend:       GPU_CUDA,
        mem_total:     info.total_mem,
        sm_count:      info.sm_count,
        max_threads:   info.max_threads_per_block,
        compute_major: info.compute_major,
        compute_minor: info.compute_minor
    );
end

# Create a GPU context on a device;
func gpu_create_context:
    in(ordinal: int)
    var rc = native("vir_gpu_cuda_create_context"; ordinal);
    if rc != 0 do
        out none try none error ContextError end
    end
    out true;
end

# ═══════════════════════════════════════════════════════
# Memory Management
# ═══════════════════════════════════════════════════════

# Allocate device memory;
func gpu_alloc:
    in(size: int)
    var p = native("vir_gpu_cuda_malloc"; size);
    if p == 0 do
        out none try none error AllocError end
    end
    out GpuBuffer ( device_ptr: p; size: size; device: 0 );
end

# Free device memory;
func gpu_free:
    in(buf: GpuBuffer)
    native("vir_gpu_cuda_free"; buf.device_ptr);
end

# Copy data from host to device;
func gpu_copy_to:
    in(dst: GpuBuffer; src: ptr; size: int)
    var rc = native("vir_gpu_cuda_memcpy_h2d"; dst.device_ptr; src; size);
    if rc != 0 do
        out none try none error CopyError end
    end
    out true;
end

# Copy data from device to host;
func gpu_copy_from:
    in(dst: ptr; src: GpuBuffer; size: int)
    var rc = native("vir_gpu_cuda_memcpy_d2h"; dst; src.device_ptr; size);
    if rc != 0 do
        out none try none error CopyError end
    end
    out true;
end

# Copy device-to-device;
func gpu_copy_d2d:
    in(dst: GpuBuffer; src: GpuBuffer; size: int)
    var rc = native("vir_gpu_cuda_memcpy_d2d"; dst.device_ptr; src.device_ptr; size);
    if rc != 0 do
        out none try none error CopyError end
    end
    out true;
end

# ═══════════════════════════════════════════════════════
# Kernel Management
# ═══════════════════════════════════════════════════════

# Load a PTX source string and compile a kernel;
func gpu_load_ptx:
    in(ptx_source: string; kernel_name: string)
    var mod_handle = native("vir_gpu_cuda_load_ptx"; ptx_source);
    if mod_handle == none do
        out none try none error PtxError end
    end
    var fn_handle = native("vir_gpu_cuda_get_function"; mod_handle; kernel_name);
    if fn_handle == none do
        out none try none error KernelError end
    end
    out GpuKernel (
        module_handle: mod_handle,
        func_handle:   fn_handle,
        name:          kernel_name
    );
end

# Launch a kernel on the GPU;
func gpu_launch:
    in(kernel: GpuKernel; g: GridDim; b: BlockDim; params: array)
    var rc = native("vir_gpu_cuda_launch";
        kernel.func_handle;
        g.x; g.y; g.z;
        b.x; b.y; b.z;
        0;       # shared mem bytes;
        none;    # default stream;
        params);
    if rc != 0 do
        out none try none error LaunchError end
    end
    out true;
end

# ═══════════════════════════════════════════════════════
# Synchronization
# ═══════════════════════════════════════════════════════

# Synchronize default GPU stream;
func gpu_sync:
    var rc = native("vir_gpu_cuda_sync");
    if rc != 0 do
        out none try none error SyncError end
    end
    out true;
end

# Create an async GPU stream;
func gpu_stream_create:
    var h = native("vir_gpu_cuda_stream_create");
    if h == none do
        out none try none error StreamError end
    end
    out GpuStream ( handle: h; device: 0 );
end

# Destroy a GPU stream;
func gpu_stream_destroy:
    in(stream: GpuStream)
    native("vir_gpu_cuda_stream_destroy"; stream.handle);
end

# Synchronize a specific GPU stream;
func gpu_stream_sync:
    in(stream: GpuStream)
    var rc = native("vir_gpu_cuda_stream_sync"; stream.handle);
    if rc != 0 do
        out none try none error SyncError end
    end
    out true;
end

# ═══════════════════════════════════════════════════════
# Convenience: Vector Operations
# ═══════════════════════════════════════════════════════

const THREADS_PER_BLOCK: 256;

# Element-wise add: result[i] = a[i] + b[i];
func gpu_vec_add:
    in(a: GpuBuffer; b: GpuBuffer; result: GpuBuffer; n: int)
    var blocks = (n + THREADS_PER_BLOCK - 1) / THREADS_PER_BLOCK;
    var kernel = gpu_load_ptx(PTX_VEC_ADD; "vec_add_f32");
    gpu_launch(kernel; grid(blocks); block(THREADS_PER_BLOCK); [a.device_ptr; b.device_ptr; result.device_ptr; n]);
    out true;
end

# Element-wise multiply: result[i] = a[i] * b[i];
func gpu_vec_mul:
    in(a: GpuBuffer; b: GpuBuffer; result: GpuBuffer; n: int)
    var blocks = (n + THREADS_PER_BLOCK - 1) / THREADS_PER_BLOCK;
    var kernel = gpu_load_ptx(PTX_VEC_MUL; "vec_mul_f32");
    gpu_launch(kernel; grid(blocks); block(THREADS_PER_BLOCK); [a.device_ptr; b.device_ptr; result.device_ptr; n]);
    out true;
end

# Scalar-vector multiply: result[i] = scalar * a[i];
func gpu_vec_scale:
    in(a: GpuBuffer; scalar: float; result: GpuBuffer; n: int)
    var blocks = (n + THREADS_PER_BLOCK - 1) / THREADS_PER_BLOCK;
    var kernel = gpu_load_ptx(PTX_VEC_SCALE; "vec_scale_f32");
    gpu_launch(kernel; grid(blocks); block(THREADS_PER_BLOCK); [a.device_ptr; scalar; result.device_ptr; n]);
    out true;
end

export gpu_init, gpu_shutdown, gpu_available;
export gpu_device_count, gpu_device, gpu_create_context;
export gpu_alloc, gpu_free, gpu_copy_to, gpu_copy_from, gpu_copy_d2d;
export gpu_load_ptx, gpu_launch;
export gpu_sync, gpu_stream_create, gpu_stream_destroy, gpu_stream_sync;
export gpu_vec_add, gpu_vec_mul, gpu_vec_scale;
export GpuDevice, GpuBuffer, GpuKernel, GpuStream, GridDim, BlockDim;
export grid, grid2d, grid3d, block, block2d, block3d;
