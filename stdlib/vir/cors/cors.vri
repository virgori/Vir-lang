##
 * vir/cors/cors.vri — CORS (Cross-Origin Resource Sharing)
 * Public: include cors — namespace cors.*
 ##

include types
include option
include result
include alloc
import vir_alloc from alloc
include vec_rt
import vec_new_rt, vec_push_rt, vec_get_rt, vec_len_rt from vec_rt
include string
import i64_to_str from string

extern func native_read_u8(addr: int, offset: int) -> int
extern func native_write_u8(addr: int, offset: int, val: int)
extern func native_read_i64(addr: int, offset: int) -> int

func _cors_str_len(p: int) -> int:
    if p == 0 do out 0 end
    var i = 0
    loop
        if native_read_u8(p, i) == 0 do out i end
        i = i + 1
    end
    out 0
end.

func _cors_str_eq(a: string, b: string) -> bool:
    out _cors_str_eq_ptr(a as int, b as int)
end.

func _cors_str_eq_ptr(pa: int, pb: int) -> bool:
    if pa == pb do out true end
    if pa == 0 or pb == 0 do out false end
    var i = 0
    loop
        let ca = native_read_u8(pa, i)
        let cb = native_read_u8(pb, i)
        if ca != cb do out false end
        if ca == 0 do out true end
        i = i + 1
    end
    out false
end.

func _cors_vec_push_str(v: int, s: string) -> int:
    if v == 0 do v = vec_new_rt() end
    out vec_push_rt(v, s as int)
end.

func _cors_vec_get_str(v: int, idx: int) -> string:
    if v == 0 do out "" end
    if idx < 0 or idx >= vec_len_rt(v) do out "" end
    out vec_get_rt(v, idx) as string
end.

func _cors_vec_len(v: int) -> int:
    if v == 0 do out 0 end
    out vec_len_rt(v)
end.

entity CorsConfig:
    allow_origins: int
    allow_methods: int
    allow_headers: int
    expose_headers: int
    allow_credentials: bool
    max_age: int
end.

entity CorsHeaders:
    keys: int
    vals: int
end.

func _cors_headers_new() -> CorsHeaders:
    out CorsHeaders ( keys: vec_new_rt(), vals: vec_new_rt() )
end.

func _cors_headers_set(h: CorsHeaders, key: string, val: string) -> CorsHeaders:
    var out_h = h
    out_h.keys = vec_push_rt(out_h.keys, key as int)
    out_h.vals = vec_push_rt(out_h.vals, val as int)
    out out_h
end.

func _cors_headers_has_key(h: CorsHeaders, key: string) -> bool:
    let keys = h.keys
    let kp = key as int
    let n = vec_len_rt(keys)
    var i = 0
    when i < n loop
        p = vec_get_rt(keys, i) as int
        if _cors_str_eq_ptr(p, kp) do out true end
        i = i + 1
    end
    out false
end.

func _cors_push_substr(v: int, base: int, start: int, end_pos: int) -> int:
    if end_pos <= start do
        out v
    end
    n = end_pos - start
    buf = vir_alloc(n + 1)
    j = 0
    when j < n loop
        native_write_u8(buf, j, native_read_u8(base, start + j))
        j = j + 1
    end
    native_write_u8(buf, n, 0)
    out _cors_vec_push_str(v, buf as string)
end.

func _cors_split_csv_push(v: int, text: string) -> int:
    out_v = v
    base = text as int
    n = _cors_str_len(base)
    if n == 0 do
        out out_v
    end
    start = 0
    i = 0
    when i <= n loop
        ch = 44
        if i < n do
            ch = native_read_u8(base, i)
        end
        if ch == 44 or i == n do
            if i > start do
                out_v = _cors_push_substr(out_v, base, start, i)
            end
            start = i + 1
        end
        i = i + 1
    end
    out out_v
end.

func _cors_defaults() -> CorsConfig:
    var cfg = CorsConfig (
        allow_origins: 0,
        allow_methods: 0,
        allow_headers: 0,
        expose_headers: 0,
        allow_credentials: false,
        max_age: 86400
    )
    cfg.allow_methods = _cors_vec_push_str(cfg.allow_methods, "GET")
    cfg.allow_methods = _cors_vec_push_str(cfg.allow_methods, "POST")
    cfg.allow_methods = _cors_vec_push_str(cfg.allow_methods, "PUT")
    cfg.allow_methods = _cors_vec_push_str(cfg.allow_methods, "DELETE")
    cfg.allow_methods = _cors_vec_push_str(cfg.allow_methods, "PATCH")
    cfg.allow_methods = _cors_vec_push_str(cfg.allow_methods, "OPTIONS")
    cfg.allow_headers = _cors_vec_push_str(cfg.allow_headers, "Content-Type")
    cfg.allow_headers = _cors_vec_push_str(cfg.allow_headers, "Authorization")
    cfg.allow_headers = _cors_vec_push_str(cfg.allow_headers, "Accept")
    cfg.allow_origins = _cors_vec_push_str(cfg.allow_origins, "*")
    out cfg
end.

func _cors_create(origins: string, methods: string, headers: string) -> CorsConfig:
    out CorsConfig (
        allow_origins: _cors_split_csv_push(0, origins),
        allow_methods: _cors_split_csv_push(0, methods),
        allow_headers: _cors_split_csv_push(0, headers),
        expose_headers: 0,
        allow_credentials: false,
        max_age: 86400
    )
end.

func _cors_allow_origin(ref cfg: CorsConfig, origin: string):
    cfg.allow_origins = _cors_vec_push_str(cfg.allow_origins, origin)
end.

func _cors_allow_methods(ref cfg: CorsConfig, method: string):
    cfg.allow_methods = _cors_vec_push_str(cfg.allow_methods, method)
end.

func _cors_credentials(ref cfg: CorsConfig, on: bool):
    cfg.allow_credentials = on
end.

func _cors_is_origin_allowed_list(origins: int, origin_ptr: int) -> bool:
    let n = _cors_vec_len(origins)
    var i = 0
    when i < n loop
        p = vec_get_rt(origins, i) as int
        if native_read_u8(p, 0) == 42 and native_read_u8(p, 1) == 0 do out true end
        if _cors_str_eq_ptr(p, origin_ptr) do out true end
        i = i + 1
    end
    out false
end.

func _cors_is_origin_allowed(cfg: CorsConfig, origin: string) -> bool:
    out _cors_is_origin_allowed_list(cfg.allow_origins, origin as int)
end.

func _cors_is_method_allowed(cfg: CorsConfig, method: string) -> bool:
    let methods = cfg.allow_methods
    let meth = method
    let mp = meth as int
    let n = _cors_vec_len(methods)
    var i = 0
    when i < n loop
        p = vec_get_rt(methods, i) as int
        if _cors_str_eq_ptr(p, mp) do out true end
        i = i + 1
    end
    out false
end.

func _cors_headers_build(cfg: CorsConfig, origin: string) -> CorsHeaders:
    var hdrs = _cors_headers_new()
    let orig = origin
    let op = orig as int
    let origins = cfg.allow_origins
    let cred = cfg.allow_credentials
    let exposed = cfg.expose_headers
    if !_cors_is_origin_allowed_list(origins, op) do out hdrs end

    let olen = _cors_vec_len(origins)
    let first = _cors_vec_get_str(origins, 0)
    let fp = first as int
    if olen == 1 and native_read_u8(fp, 0) == 42 and native_read_u8(fp, 1) == 0 and !cred do
        hdrs = _cors_headers_set(hdrs, "Access-Control-Allow-Origin", "*")
    else
        var h1 = _cors_headers_set(hdrs, "Access-Control-Allow-Origin", orig)
        hdrs = _cors_headers_set(h1, "Vary", "Origin")
    end

    if cred do
        hdrs = _cors_headers_set(hdrs, "Access-Control-Allow-Credentials", "true")
    end

    if _cors_vec_len(exposed) > 0 do
        hdrs = _cors_headers_set(hdrs, "Access-Control-Expose-Headers", "X-Custom")
    end

    out hdrs
end.

func _cors_preflight_headers_build(cfg: CorsConfig, origin: string, request_method: string, request_headers: string) -> CorsHeaders:
    let origins = cfg.allow_origins
    let max_age = cfg.max_age
    let op = origin as int
    var hdrs = _cors_headers_build(cfg, origin)
    if !_cors_is_origin_allowed_list(origins, op) do out hdrs end
    hdrs = _cors_headers_set(hdrs, "Access-Control-Allow-Methods", "GET, POST, PUT, DELETE, PATCH, OPTIONS")
    hdrs = _cors_headers_set(hdrs, "Access-Control-Allow-Headers", "Content-Type, Authorization, Accept")
    hdrs = _cors_headers_set(hdrs, "Access-Control-Max-Age", i64_to_str(max_age))
    out hdrs
end.

func _cors_is_preflight(method: string, hdrs: CorsHeaders) -> bool:
    if !_cors_str_eq(method, "OPTIONS") do out false end
    let keys = hdrs.keys
    let kp1 = "Access-Control-Request-Method" as int
    let kp2 = "Origin" as int
    let n = vec_len_rt(keys)
    var i = 0
    when i < n loop
        p = vec_get_rt(keys, i) as int
        if _cors_str_eq_ptr(p, kp1) do out true end
        if _cors_str_eq_ptr(p, kp2) do out true end
        i = i + 1
    end
    out false
end.

entity CorsNamespace:
    method defaults():
        out _cors_defaults()
    end.
    method create(origins: string, methods: string, headers: string):
        out _cors_create(origins, methods, headers)
    end.
    method allowOrigin(ref cfg: CorsConfig, origin: string):
        _cors_allow_origin(cfg, origin)
    end.
    method allowMethods(ref cfg: CorsConfig, method: string):
        _cors_allow_methods(cfg, method)
    end.
    method credentials(ref cfg: CorsConfig, on: bool):
        _cors_credentials(cfg, on)
    end.
    method isOriginAllowed(cfg: CorsConfig, origin: string) -> bool:
        out _cors_is_origin_allowed(cfg, origin)
    end.
    method isMethodAllowed(cfg: CorsConfig, method: string) -> bool:
        out _cors_is_method_allowed(cfg, method)
    end.
    method headers(cfg: CorsConfig, origin: string) -> CorsHeaders:
        out _cors_headers_build(cfg, origin)
    end.
    method preflightHeaders(cfg: CorsConfig, origin: string, request_method: string, request_headers: string) -> CorsHeaders:
        out _cors_preflight_headers_build(cfg, origin, request_method, request_headers)
    end.
    method isPreflight(method: string, hdrs: CorsHeaders) -> bool:
        out _cors_is_preflight(method, hdrs)
    end.
end.

var cors: CorsNamespace

export CorsConfig, CorsHeaders, CorsNamespace, cors
