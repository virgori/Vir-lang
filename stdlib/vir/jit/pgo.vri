##
 * vir/jit/pgo.vri — Profile-Guided Optimization Feedback Loop
 * ==============================================================
 * Bridges runtime profiler data (vir/profile/profile.vri) to the
 * optimizer (vir/compiler/ir_optimizer) and tiered compilation engine.
 *
 * PGO Loop:
 *   1. Profiler collects call counts & timing per function
 *   2. PGO module harvests profile data → builds PGOProfile
 *   3. Identifies hot functions (inline candidates), cold functions
 *   4. Generates PGOHint annotations for optimizer passes
 *   5. Feeds hints into Tier 2 recompilation decisions
 ##

module vir.jit.pgo;

include types;
include vec;
import Vec, vec_new, vec_push, vec_len, vec_get, vec_set from vec;
include map;
import Map, map_new, map_set, map_get, map_keys from map;
include string;
import String, str_new, str_eq from string;
include option;
import Option, Some, None from option;
include result;
import Result, Ok, Err from result;
include vir.profile.profile;
import ProfileEntry, Profiler, profiler_report, _global_profiler from profile;


# ═══════════════════════════════════════════════════════
# Constants & Thresholds
# ═══════════════════════════════════════════════════════

const HOT_CALL_THRESHOLD:    100;       # calls ≥ this → hot function
const COLD_CALL_THRESHOLD:   2;         # calls ≤ this → cold function
const INLINE_MAX_BODY_SIZE:  64;        # max QIR instructions for auto-inline hint
const UNROLL_LOOP_MIN_CALLS: 50;        # min loop call frequency for unroll hint
const HOT_TIME_PERCENT:      20;        # top 20% by total_ns → hot


# ═══════════════════════════════════════════════════════
# PGO Hint Types
# ═══════════════════════════════════════════════════════

enum HintKind:
    InlineCandidate  = 0;    # function should be inlined
    HotFunction      = 1;    # function is hot — prioritize optimization
    ColdFunction     = 2;    # function is cold — skip heavy optimization
    UnrollLoop       = 3;    # loop in this function should be unrolled
    BranchWeight     = 4;    # branch prediction hint
    Devirtualize     = 5;    # call target is monomorphic
end

entity PGOHint:
    kind:       HintKind;
    func_name:  string;
    weight:     int;         # frequency / call count
    extra:      int;         # branch_id for BranchWeight, body_size for Inline, etc.
end

func pgo_hint_new:
    in(kind: HintKind; func_name: string; weight: int; extra: int) -> PGOHint
    out PGOHint {
        kind:      kind,
        func_name: func_name,
        weight:    weight,
        extra:     extra
    };
end


# ═══════════════════════════════════════════════════════
# PGO Profile (harvested from profiler)
# ═══════════════════════════════════════════════════════

entity PGOProfile:
    entries:        Vec<PGOEntry>;
    total_calls:    int;
    total_time_ns:  int;
    hot_threshold:  int;       # calls threshold for "hot"
end

entity PGOEntry:
    name:       string;
    calls:      int;
    total_ns:   int;
    self_ns:    int;
    avg_ns:     int;
    is_hot:     bool;
    is_cold:    bool;
end

func pgo_profile_new:
    out PGOProfile {
        entries:       vec_new<PGOEntry>(),
        total_calls:   0,
        total_time_ns: 0,
        hot_threshold: HOT_CALL_THRESHOLD
    };
end


# ═══════════════════════════════════════════════════════
# Harvest: Profiler → PGOProfile
# ═══════════════════════════════════════════════════════

func pgo_harvest:
    in() -> PGOProfile
    let prof = pgo_profile_new();

    let keys = map_keys(_global_profiler.entries);
    let i = 0;
    let n = vec_len<string>(keys);

    # First pass: collect all entries and totals
    when i < n loop
        let key = vec_get<string>(keys, i);
        let found = map_get(_global_profiler.entries, key);
        case found;
            case Some(pe)
                let avg = if pe.calls > 0: pe.total_ns / pe.calls; else: 0; end;
                let entry = PGOEntry {
                    name:    pe.name,
                    calls:   pe.calls,
                    total_ns: pe.total_ns,
                    self_ns: pe.self_ns,
                    avg_ns:  avg,
                    is_hot:  false,
                    is_cold: false
                };
                prof.total_calls = prof.total_calls + pe.calls;
                prof.total_time_ns = prof.total_time_ns + pe.total_ns;
                prof.entries = vec_push<PGOEntry>(prof.entries, entry);
            case None: {}
        end
        i = i + 1;
    end

    # Second pass: classify hot/cold
    let j = 0;
    let m = vec_len<PGOEntry>(prof.entries);
    when j < m loop
        let e = vec_get<PGOEntry>(prof.entries, j);
        if e.calls >= HOT_CALL_THRESHOLD:
            e.is_hot = true;
        eif e.calls <= COLD_CALL_THRESHOLD:
            e.is_cold = true;
        end
        vec_set<PGOEntry>(prof.entries, j, e);
        j = j + 1;
    end

    out prof;
end


# ═══════════════════════════════════════════════════════
# Generate Optimizer Hints from Profile
# ═══════════════════════════════════════════════════════

entity PGOHintSet:
    hints:          Vec<PGOHint>;
    hot_funcs:      Vec<string>;
    cold_funcs:     Vec<string>;
    inline_cands:   Vec<string>;
end

func pgo_generate_hints:
    in(prof: PGOProfile; func_sizes: Map<string, int>) -> PGOHintSet
    let hs = PGOHintSet {
        hints:        vec_new<PGOHint>(),
        hot_funcs:    vec_new<string>(),
        cold_funcs:   vec_new<string>(),
        inline_cands: vec_new<string>()
    };

    let i = 0;
    let n = vec_len<PGOEntry>(prof.entries);
    when i < n loop
        let e = vec_get<PGOEntry>(prof.entries, i);

        # Hot function → HotFunction hint
        if e.is_hot:
            hs.hot_funcs = vec_push<string>(hs.hot_funcs, e.name);
            hs.hints = vec_push<PGOHint>(hs.hints, pgo_hint_new(
                HintKind::HotFunction, e.name, e.calls, e.total_ns
            ));

            # Hot + small body → inline candidate
            let body_size_opt = map_get(func_sizes, e.name);
            case body_size_opt;
                case Some(sz)
                    if sz <= INLINE_MAX_BODY_SIZE:
                        hs.inline_cands = vec_push<string>(hs.inline_cands, e.name);
                        hs.hints = vec_push<PGOHint>(hs.hints, pgo_hint_new(
                            HintKind::InlineCandidate, e.name, e.calls, sz
                        ));
                    end
                case None: {}
            end

            # Hot → unroll hint if above loop threshold
            if e.calls >= UNROLL_LOOP_MIN_CALLS:
                hs.hints = vec_push<PGOHint>(hs.hints, pgo_hint_new(
                    HintKind::UnrollLoop, e.name, e.calls, 0
                ));
            end
        end

        # Cold function → ColdFunction hint
        if e.is_cold:
            hs.cold_funcs = vec_push<string>(hs.cold_funcs, e.name);
            hs.hints = vec_push<PGOHint>(hs.hints, pgo_hint_new(
                HintKind::ColdFunction, e.name, e.calls, 0
            ));
        end

        i = i + 1;
    end

    out hs;
end


# ═══════════════════════════════════════════════════════
# Query Helpers
# ═══════════════════════════════════════════════════════

func pgo_is_hot:
    in(hs: PGOHintSet; name: string) -> bool
    let i = 0;
    let n = vec_len<string>(hs.hot_funcs);
    when i < n loop
        if str_eq(vec_get<string>(hs.hot_funcs, i), name):
            out true;
        end
        i = i + 1;
    end
    out false;
end

func pgo_is_inline_candidate:
    in(hs: PGOHintSet; name: string) -> bool
    let i = 0;
    let n = vec_len<string>(hs.inline_cands);
    when i < n loop
        if str_eq(vec_get<string>(hs.inline_cands, i), name):
            out true;
        end
        i = i + 1;
    end
    out false;
end

func pgo_is_cold:
    in(hs: PGOHintSet; name: string) -> bool
    let i = 0;
    let n = vec_len<string>(hs.cold_funcs);
    when i < n loop
        if str_eq(vec_get<string>(hs.cold_funcs, i), name):
            out true;
        end
        i = i + 1;
    end
    out false;
end

func pgo_hint_count:
    in(hs: PGOHintSet) -> int
    out vec_len<PGOHint>(hs.hints);
end

func pgo_get_hint:
    in(hs: PGOHintSet; idx: int) -> PGOHint
    out vec_get<PGOHint>(hs.hints, idx);
end


# ═══════════════════════════════════════════════════════
# PGO-Guided Tier Promotion Decision
# ═══════════════════════════════════════════════════════

## Returns list of function names that should be promoted to Tier 2.
func pgo_recommend_tier2:
    in(prof: PGOProfile) -> Vec<string>
    let candidates = vec_new<string>();
    let i = 0;
    let n = vec_len<PGOEntry>(prof.entries);
    when i < n loop
        let e = vec_get<PGOEntry>(prof.entries, i);
        if e.is_hot:
            candidates = vec_push<string>(candidates, e.name);
        end
        i = i + 1;
    end
    out candidates;
end

## Returns list of function names that should be deprioritized.
func pgo_recommend_skip:
    in(prof: PGOProfile) -> Vec<string>
    let skip = vec_new<string>();
    let i = 0;
    let n = vec_len<PGOEntry>(prof.entries);
    when i < n loop
        let e = vec_get<PGOEntry>(prof.entries, i);
        if e.is_cold:
            skip = vec_push<string>(skip, e.name);
        end
        i = i + 1;
    end
    out skip;
end


# ═══════════════════════════════════════════════════════
# Exports
# ═══════════════════════════════════════════════════════

export HintKind, PGOHint, PGOProfile, PGOEntry, PGOHintSet;
export pgo_hint_new, pgo_profile_new;
export pgo_harvest, pgo_generate_hints;
export pgo_is_hot, pgo_is_inline_candidate, pgo_is_cold;
export pgo_hint_count, pgo_get_hint;
export pgo_recommend_tier2, pgo_recommend_skip;
export HOT_CALL_THRESHOLD, COLD_CALL_THRESHOLD;
export INLINE_MAX_BODY_SIZE, UNROLL_LOOP_MIN_CALLS;
