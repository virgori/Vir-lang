##
 * vir/jit/bridge.vri — JIT Bridge (Vir-native)
 * ===============================================
 * Self-hosted JIT bridge that replaces the C implementation in core/src/jit_bridge.c
 * and the Python implementation in src/runtime/jit/jit_engine.py.
 *
 * Architecture
 *   1. mmap an anonymous region with RW permissions (via vir/os/mmap)
 *   2. Emit machine code into a Buffer (via vir/mem/buffer)
 *   3. Flip the region to RX (PROT_READ|PROT_EXEC) via mmap_protect
 *   4. Maintain a callback table for indirect calls from JIT code
 *   5. Patch / rollback individual code blocks
 *
 * Supported architectures: x86_64, ARM64 (AArch64).
 ##

include types;
include string;
import String, str_new, str_eq from string;
include result;
import Result, Ok, Err from result;
include alloc;
import alloc, alloc_zeroed, free from alloc;
include copy;
import mem_copy, mem_set, mem_zero from copy;
include vec;
import Vec, vec_new, vec_push, vec_len, vec_get, vec_set from vec;
include mem/buffer;
import Buffer, buffer_new, buffer_push, buffer_push_u32, buffer_push_u64,
       buffer_write_bytes from mem/buffer;
include os/mmap;
import Mmap, mmap_anonymous, mmap_protect, mmap_close,
       PROT_READ, PROT_WRITE, PROT_EXEC from os/mmap;
include hw/cpu;
import cpu_arch, ARCH_X86_64, ARCH_AARCH64 from hw/cpu;


# ═══════════════════════════════════════════════════════
# Constants
# ═══════════════════════════════════════════════════════

const JIT_MAX_CALLBACKS: 64;
const JIT_MAX_BLOCKS:    256;
const JIT_DEFAULT_REGION: 1048576;     # 1 MB


# ═══════════════════════════════════════════════════════
# JIT Callback Entry
# ═══════════════════════════════════════════════════════

entity JitCallback:
    name:       String,
        addr:       ptr,
        arg_count:  int;
end.


# ═══════════════════════════════════════════════════════
# JIT Code Block  (one per function/patch-point)
# ═══════════════════════════════════════════════════════

entity JitBlock:
    id:              int,
        offset:          int;        # byte offset inside region
    size:            int,
        safe_offset:     int,
        safe_size:       int,
        fast_offset:     int,
        fast_size:       int,
        is_fast:         bool;       # currently running fast variant?
    exec_count:      int,
        rollback_count:  int,
        permanent_safe:  bool;       # blacklisted
end.


# ═══════════════════════════════════════════════════════
# JIT Bridge
# ═══════════════════════════════════════════════════════

entity JitBridge:
    arch:           int;         # ARCH_X86_64 | ARCH_AARCH64
    region:         Mmap;        # executable memory region
    region_used:    int,
        is_executable:  bool;        # current protection state

    callbacks:      Vec<JitCallback>,
        callback_table: ptr;         # contiguous void*[JIT_MAX_CALLBACKS]

    blocks:         Vec<JitBlock>,
        blacklist_threshold: int;    # rollback limit → permanent safe
end.


# ═══════════════════════════════════════════════════════
# Lifecycle
# ═══════════════════════════════════════════════════════

func jit_bridge_new(region_size: int):
    arch = cpu_arch();
    sz = if region_size > 0 do region_size; else JIT_DEFAULT_REGION; end;

    # Map an anonymous RW region
    res = mmap_anonymous(sz, PROT_READ | PROT_WRITE);
    if res.is_err do
        panic("jit_bridge_new: cannot mmap executable region");
    end
    region = res.value;

    # Callback table: 64 × 8 bytes = 512 bytes
    cb_table = alloc_zeroed(JIT_MAX_CALLBACKS * 8);

    out JitBridge (
        arch:           arch,
        region:         region,
        region_used:    0,
        is_executable:  false,
        callbacks:      vec_new<JitCallback>(),
        callback_table: cb_table,
        blocks:         vec_new<JitBlock>(),
        blacklist_threshold: 5
    );
end.
func jit_bridge_free(jb: JitBridge):
    mmap_close(jb.region);
    free(jb.callback_table);
end.
# ═══════════════════════════════════════════════════════
# Callback Registration
# ═══════════════════════════════════════════════════════

func jit_register_callback:
    in  jb: JitBridge;
        name: String;
        addr: ptr;
        arg_count: int
    slot = vec_len(jb.callbacks);
    if slot >= JIT_MAX_CALLBACKS do
        out Err(str_new("callback table full"));
    end
    vec_push(jb.callbacks, JitCallback ( name: name, addr: addr, arg_count: arg_count ));
    # Write absolute address into contiguous table
    native_store<ptr>(jb.callback_table; slot; addr);
    out Ok(slot);
end.
func jit_lookup_callback(jb: JitBridge, name: String):
    i = 0;
    n = vec_len(jb.callbacks);
    when i < n loop
        cb = vec_get(jb.callbacks, i);
        if str_eq(cb.name, name) do
            out Ok(cb.addr);
        end
        i = i + 1;
    end
    out Err(str_new("callback not found"));
end.
# ═══════════════════════════════════════════════════════
# Code Emission
# ═══════════════════════════════════════════════════════

## Copy raw machine code bytes into the JIT region.  Returns block index.
func jit_emit_code:
    in  jb: JitBridge;
        block_id: int;
        code: ptr;
        code_len: int
    if jb.is_executable do
        out Err(str_new("region is RX — call jit_begin_patch first"));
    end
    if jb.region_used + code_len > jb.region.length do
        out Err(str_new("region exhausted"));
    end

    dst = ptr_add(jb.region.addr, jb.region_used);
    mem_copy(dst, code, code_len);

    blk = JitBlock (
        id:             block_id,
        offset:         jb.region_used,
        size:           code_len,
        safe_offset:    jb.region_used,
        safe_size:      code_len,
        fast_offset:    0,
        fast_size:      0,
        is_fast:        false,
        exec_count:     0,
        rollback_count: 0,
        permanent_safe: false
    );
    vec_push(jb.blocks, blk);
    jb.region_used = jb.region_used + ((code_len + 7) & ~7);   # align 8
    out Ok(vec_len(jb.blocks) - 1);
end.
# ═══════════════════════════════════════════════════════
# Memory Protection Toggle
# ═══════════════════════════════════════════════════════

## Finalise: switch region from RW → RX (after emitting all code).
func jit_finalise(jb: JitBridge):
    res = mmap_protect(jb.region, PROT_READ | PROT_EXEC);
    if res.is_err do
        out Err(str_new("mprotect RX failed"));
    end
    jb.is_executable = true;
    out Ok(());
end.
## Begin patch: switch region from RX → RW.
func jit_begin_patch(jb: JitBridge):
    res = mmap_protect(jb.region, PROT_READ | PROT_WRITE);
    if res.is_err do
        out Err(str_new("mprotect RW failed"));
    end
    jb.is_executable = false;
    out Ok(());
end.
## End patch: switch region back to RX.
func jit_end_patch(jb: JitBridge):
    out jit_finalise(jb);
end.
# ═══════════════════════════════════════════════════════
# Code Block Patching (Safe → Fast / Fast → Safe)
# ═══════════════════════════════════════════════════════

func jit_emit_fast_variant:
    in  jb: JitBridge;
        block_idx: int;
        fast_code: ptr;
        fast_len: int
    if block_idx >= vec_len(jb.blocks) do
        out Err(str_new("invalid block index"));
    end
    blk = vec_get(jb.blocks, block_idx);
    if blk.permanent_safe do
        out Err(str_new("block is permanently safe-locked"));
    end
    # Emit fast variant at end of region
    off = jb.region_used;
    if off + fast_len > jb.region.length do
        out Err(str_new("region exhausted for fast variant"));
    end
    dst = ptr_add(jb.region.addr, off);
    mem_copy(dst, fast_code, fast_len);
    blk.fast_offset = off;
    blk.fast_size = fast_len;
    vec_set(jb.blocks, block_idx, blk);
    jb.region_used = jb.region_used + ((fast_len + 7) & ~7);
    out Ok(());
end.
func jit_patch_to_fast(jb: JitBridge, block_idx: int):
    blk = vec_get(jb.blocks, block_idx);
    if blk.permanent_safe or blk.fast_size == 0 do
        out Err(str_new("cannot patch to fast"));
    end
    blk.is_fast = true;
    vec_set(jb.blocks, block_idx, blk);
    out Ok(());
end.
func jit_patch_to_safe(jb: JitBridge, block_idx: int):
    blk = vec_get(jb.blocks, block_idx);
    blk.is_fast = false;
    blk.rollback_count = blk.rollback_count + 1;
    if jb.blacklist_threshold > 0 and blk.rollback_count >= jb.blacklist_threshold do
        blk.permanent_safe = true;
    end
    vec_set(jb.blocks, block_idx, blk);
    out Ok(());
end.
# ═══════════════════════════════════════════════════════
# Call Thunk Emission
# ═══════════════════════════════════════════════════════

## Emit a machine-code thunk into `buf` that calls callback[slot].
## x86_64: MOV RAX, imm64; CALL RAX     (12 bytes)
## ARM64:  MOVZ/MOVK X16; BLR X16       (20 bytes max)
func jit_emit_call_thunk:
    in  jb: JitBridge;
        buf: Buffer;
        callback_slot: int
    if callback_slot >= vec_len(jb.callbacks) do
        out Err(str_new("invalid callback slot"));
    end
    addr_ptr = native_load<ptr>(jb.callback_table; callback_slot);
    addr = ptr_to_int(addr_ptr);

    if jb.arch == ARCH_X86_64 do
        # REX.W MOV RAX, imm64
        buffer_push(buf, 0x48);
        buffer_push(buf, 0xB8);
        buffer_push_u64(buf, addr);
        # CALL RAX
        buffer_push(buf, 0xFF);
        buffer_push(buf, 0xD0);
    end

    if jb.arch == ARCH_AARCH64 do
        rd = 16;    # X16 = scratch
        # MOVZ X16, #low16
        ins0 = 0xD2800000 | (((addr & 0xFFFF) << 5) & 0x1FFFE0) | (rd & 0x1F);
        buffer_push_u32(buf, ins0);
        # MOVK X16, #[31:16], LSL #16
        ins1 = 0xF2A00000 | ((((addr >> 16) & 0xFFFF) << 5) & 0x1FFFE0) | (rd & 0x1F);
        buffer_push_u32(buf, ins1);
        # MOVK X16, #[47:32], LSL #32
        ins2 = 0xF2C00000 | ((((addr >> 32) & 0xFFFF) << 5) & 0x1FFFE0) | (rd & 0x1F);
        buffer_push_u32(buf, ins2);
        # MOVK X16, #[63:48], LSL #48
        ins3 = 0xF2E00000 | ((((addr >> 48) & 0xFFFF) << 5) & 0x1FFFE0) | (rd & 0x1F);
        buffer_push_u32(buf, ins3);
        # BLR X16
        buffer_push_u32(buf, 0xD63F0200);
    end

    out Ok(());
end.
# ═══════════════════════════════════════════════════════
# Query Helpers
# ═══════════════════════════════════════════════════════

func jit_block_count(jb: JitBridge):
    out vec_len(jb.blocks);
end.
func jit_callback_count(jb: JitBridge):
    out vec_len(jb.callbacks);
end.
func jit_region_used(jb: JitBridge):
    out jb.region_used;
end.
func jit_get_entry(jb: JitBridge, block_idx: int):
    if block_idx >= vec_len(jb.blocks) do
        out Err(str_new("invalid block index"));
    end
    blk = vec_get(jb.blocks, block_idx);
    off = if blk.is_fast do blk.fast_offset; else blk.offset; end;
    out Ok(ptr_add(jb.region.addr, off));
end.
# ═══════════════════════════════════════════════════════
# Exports
# ═══════════════════════════════════════════════════════

export JitBridge, JitCallback, JitBlock;
export jit_bridge_new, jit_bridge_free;
export jit_register_callback, jit_lookup_callback;
export jit_emit_code, jit_emit_fast_variant;
export jit_finalise, jit_begin_patch, jit_end_patch;
export jit_patch_to_fast, jit_patch_to_safe;
export jit_emit_call_thunk;
export jit_block_count, jit_callback_count, jit_region_used, jit_get_entry;
