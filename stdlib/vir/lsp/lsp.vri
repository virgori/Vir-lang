##
 * vir/lsp/lsp.vri — Language Server Protocol (stub)
 * ====================================================
 * Phase D — IDE support for Vir
 *
 * Implements LSP JSON-RPC over stdio
 ##

include types;
include option;
import Option, Some, None from option;
include result;
import Result, Ok, Err from result;
include string;
import String, str_new, str_concat from string;
include vec;
import Vec, vec_new, vec_push from vec;
include map;
import Map, map_new, map_set from map;
include json;
import JsonValue, json_object, json_string, json_number, json_array, json_null, json_to_string from json;
include stdio;
import read_line, eprint from stdio;

# ═══════════════════════════════════════════════════════
# LSP Types
# ═══════════════════════════════════════════════════════

entity Position:
    line:      int,
        character: int;
end.

entity Range:
    start: Position,
        end:   Position;
end.

entity Location:
    uri:   string,
        range: Range;
end.

enum DiagnosticSeverity:
    Error       = 1;
    Warning     = 2;
    Information = 3;
    Hint        = 4;
end.

entity Diagnostic:
    range:    Range,
        severity: DiagnosticSeverity,
        message:  string,
        source:   string;
end.

entity CompletionItem:
    label:  string,
        kind:   int       # 1=Text, 2=Method, 3=Function, 6=Variable, 7=Class, ...,
        detail: string;
end

# ═══════════════════════════════════════════════════════
# JSON-RPC Message
# ═══════════════════════════════════════════════════════

entity RpcMessage:
    jsonrpc: string    # "2.0",
        id:      Option<int>,
        method:  Option<string>,
        params:  JsonValue;
end.

func rpc_response:
    in(id:int; result:JsonValue)
    obj = map_new<string, JsonValue>();
    map_set(&obj, str_new("jsonrpc"), json_string(str_new("2.0")));
    map_set(&obj, str_new("id"), json_number(id));
    map_set(&obj, str_new("result"), result);
    out json_object(obj);
end.

func rpc_error:
    in(id:int; code:int; message:string)
    err = map_new<string, JsonValue>();
    map_set(&err, str_new("code"), json_number(code));
    map_set(&err, str_new("message"), json_string(message));
    
    obj = map_new<string, JsonValue>();
    map_set(&obj, str_new("jsonrpc"), json_string(str_new("2.0")));
    map_set(&obj, str_new("id"), json_number(id));
    map_set(&obj, str_new("error"), json_object(err));
    out json_object(obj);
end.

func rpc_notification:
    in(method:string; params:JsonValue)
    obj = map_new<string, JsonValue>();
    map_set(&obj, str_new("jsonrpc"), json_string(str_new("2.0")));
    map_set(&obj, str_new("method"), json_string(method));
    map_set(&obj, str_new("params"), params);
    out json_object(obj);
end

# ═══════════════════════════════════════════════════════
# Server Capabilities
# ═══════════════════════════════════════════════════════

func server_capabilities:
    caps = map_new<string, JsonValue>();
    
    # Text document sync
    map_set(&caps, str_new("textDocumentSync"), json_number(1))   # Full sync;
    
    # Completion
    comp = map_new<string, JsonValue>();
    triggers = json_array(vec_new<JsonValue>());
    vec_push(&triggers, json_string(str_new(".")));
    map_set(&comp, str_new("triggerCharacters"), triggers);
    map_set(&caps, str_new("completionProvider"), json_object(comp));
    
    # Hover
    map_set(&caps, str_new("hoverProvider"), json_bool(true));
    
    # Definition
    map_set(&caps, str_new("definitionProvider"), json_bool(true));
    
    # Diagnostics (push)
    map_set(&caps, str_new("diagnosticProvider"), json_bool(true));
    
    out json_object(caps);
end

# ═══════════════════════════════════════════════════════
# LSP Server (stub — main loop)
# ═══════════════════════════════════════════════════════

entity LspServer:
    running:     bool,
        initialized: bool,
        documents:   Map<string, string>   # uri -> content;
end.

func lsp_server_new:
    out LspServer {;
        running = true,
        initialized = false,
        documents = map_new<string, string>()
    };
end.

func lsp_handle_initialize:
    in(server:LspServer; id:int)
    server.initialized = true;
    
    result = map_new<string, JsonValue>();
    map_set(&result, str_new("capabilities"), server_capabilities());
    
    info = map_new<string, JsonValue>();
    map_set(&info, str_new("name"), json_string(str_new("vir-lsp")));
    map_set(&info, str_new("version"), json_string(str_new("0.1.0")));
    map_set(&result, str_new("serverInfo"), json_object(info));
    
    out rpc_response(id, json_object(result));
end.

func lsp_handle_shutdown:
    in(server:LspServer; id:int)
    server.running = false;
    out rpc_response(id, json_null());
end.

func lsp_diagnostic:
    in(uri:string; diags:Vec<Diagnostic>)
    arr = vec_new<JsonValue>();
    i = 0;
    when i < vec_len<Diagnostic>(diags) loop
        d = vec_get<Diagnostic>(diags, i);
        dobj = map_new<string, JsonValue>();
        
        range_obj = map_new<string, JsonValue>();
        start_obj = map_new<string, JsonValue>();
        map_set(&start_obj, str_new("line"), json_number(d.range.start.line));
        map_set(&start_obj, str_new("character"), json_number(d.range.start.character));
        end_obj = map_new<string, JsonValue>();
        map_set(&end_obj, str_new("line"), json_number(d.range.endline));
        map_set(&end_obj, str_new("character"), json_number(d.range.endcharacter));
        map_set(&range_obj, str_new("start"), json_object(start_obj));
        map_set(&range_obj, str_new("end"), json_object(end_obj));
        
        map_set(&dobj, str_new("range"), json_object(range_obj));
        map_set(&dobj, str_new("severity"), json_number(d.severity));
        map_set(&dobj, str_new("message"), json_string(d.message));
        map_set(&dobj, str_new("source"), json_string(d.source));
        vec_push<JsonValue>(&arr, json_object(dobj));
        i = i + 1;
    end
    
    params = map_new<string, JsonValue>();
    map_set(&params, str_new("uri"), json_string(uri));
    map_set(&params, str_new("diagnostics"), json_array(arr));
    out rpc_notification(str_new("textDocument/publishDiagnostics"), json_object(params));
end
