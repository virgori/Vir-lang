##
 * vir/lsp/lsp.vri — Language Server Protocol (stub)
 * ====================================================
 * Phase D — IDE support for Vir
 *
 * Implements LSP JSON-RPC over stdio
 ##

include types
include option
import Option, Some, None from option
include result
import Result, Ok, Err from result
include string
import String, str_new, str_concat from string
include vec
import Vec, vec_new, vec_push, vec_len, vec_get from vec
include map
import Map, map_new from map
include json
import JsonValue from json
include stdio
import read_line, eprint from stdio

# ═══════════════════════════════════════════════════════
# LSP Types
# ═══════════════════════════════════════════════════════

entity Position:
    line: int
    character: int
end.
entity Range:
    start_pos: Position
    end_pos: Position
end.
entity Location:
    uri: string
    range: Range
end.
enum DiagnosticSeverity:
    Error       = 1
    Warning     = 2
    Information = 3
    Hint        = 4
end.
entity Diagnostic:
    range: Range
    severity: DiagnosticSeverity
    message: string
    source: string
end.
entity CompletionItem:
    label: string
    kind: int       # 1=Text, 2=Method, 3=Function, 6=Variable, 7=Class, ...
    detail: string
end.

# ═══════════════════════════════════════════════════════
# JSON-RPC Message
# ═══════════════════════════════════════════════════════

entity RpcMessage:
    jsonrpc: string    # "2.0"
    msg_id: Option of (int)
    msg_method: Option of (string)
    params: JsonValue
end.
func rpc_response(id: int, result: JsonValue):
    let obj = json_object()
    json_obj_set(obj, "jsonrpc", json_string("2.0"))
    json_obj_set(obj, "id", json_number(id))
    json_obj_set(obj, "result", result)
    out obj
end.
func rpc_error:
    in  id: int
        code: int
        message: string
    let err = json_object()
    json_obj_set(err, "code", json_number(code))
    json_obj_set(err, "message", json_string(message))
    
    let obj = json_object()
    json_obj_set(obj, "jsonrpc", json_string("2.0"))
    json_obj_set(obj, "id", json_number(id))
    json_obj_set(obj, "error", err)
    out obj
end.
func rpc_notification(method: string, params: JsonValue):
    let obj = json_object()
    json_obj_set(obj, "jsonrpc", json_string("2.0"))
    json_obj_set(obj, "method", json_string(method))
    json_obj_set(obj, "params", params)
    out obj
end.
# ═══════════════════════════════════════════════════════
# Server Capabilities
# ═══════════════════════════════════════════════════════

func server_capabilities:
    let caps = json_object()
    
    # Text document sync
    json_obj_set(caps, "textDocumentSync", json_number(1))   # Full sync
    
    # Completion
    let comp = json_object()
    let triggers = json_array()
    json_arr_push(triggers, json_string("."))
    json_obj_set(comp, "triggerCharacters", triggers)
    json_obj_set(caps, "completionProvider", comp)
    
    # Hover
    json_obj_set(caps, "hoverProvider", json_bool(true))
    
    # Definition
    json_obj_set(caps, "definitionProvider", json_bool(true))
    
    # Diagnostics (push)
    json_obj_set(caps, "diagnosticProvider", json_bool(true))
    
    out caps
end.
# ═══════════════════════════════════════════════════════
# LSP Server (stub — main loop)
# ═══════════════════════════════════════════════════════

entity LspServer:
    running: bool
    initialized: bool
    documents: Map of (string, string)   # uri -> content
end.
func lsp_server_new:
    out LspServer (
        running: true,
        initialized: false,
        documents: map_new of (string, string)()
    )
end.
func lsp_handle_initialize(server: LspServer, id: int):
    server.initialized = true
    
    let result = json.object()
    json_obj_set(result, "capabilities", server_capabilities())
    
    let info = json_object()
    json_obj_set(info, "name", json_string("vir-lsp"))
    json_obj_set(info, "version", json_string("0.1.0"))
    json_obj_set(result, "serverInfo", info)
    
    out rpc_response(id, result)
end.
func lsp_handle_shutdown(server: LspServer, id: int):
    server.running = false
    out rpc_response(id, json_null())
end.
func lsp_diagnostic(uri: string, diags: Vec of (Diagnostic)):
    let arr = json_array()
    var i = 0
    when i < vec_len of (Diagnostic)(diags) loop
        let d = vec_get of (Diagnostic)(diags, i)
        let start_line = d.range.start_pos.line
        let start_character = d.range.start_pos.character
        let end_line = d.range.end_pos.line
        let end_character = d.range.end_pos.character
        let severity = d.severity
        let message = d.message
        let source = d.source
        let dobj = json_object()
        
        let range_obj = json_object()
        let start_obj = json_object()
        json_obj_set(start_obj, "line", json_number(start_line))
        json_obj_set(start_obj, "character", json_number(start_character))
        let end_obj = json_object()
        json_obj_set(end_obj, "line", json_number(end_line))
        json_obj_set(end_obj, "character", json_number(end_character))
        json_obj_set(range_obj, "start", start_obj)
        json_obj_set(range_obj, "end", end_obj)
        
        json_obj_set(dobj, "range", range_obj)
        json_obj_set(dobj, "severity", json_number(severity))
        json_obj_set(dobj, "message", json_string(message))
        json_obj_set(dobj, "source", json_string(source))
        json_arr_push(arr, dobj)
        i = i + 1
    end
    
    let params = json_object()
    json_obj_set(params, "uri", json_string(uri))
    json_obj_set(params, "diagnostics", arr)
    out rpc_notification("textDocument/publishDiagnostics", params)
end.
