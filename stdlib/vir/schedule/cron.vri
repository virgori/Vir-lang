##
 * vir/schedule/cron.vri — Cron Scheduler
 * =========================================
 * Inspired by Python: apscheduler, schedule
 * Inspired by Rust: tokio-cron-scheduler
 * Inspired by cron(5) expression format
 *
 * Schedule recurring and one-shot tasks with cron expressions
 * or interval-based timing.
 ##

include types;
include result;
import Result, Ok, Err from result;
include option;
import Option, Some, None from option;
include string;
import String, str_new, str_byte_len, str_ptr, str_eq,
       str_find, str_substr from string;
include vec;
import Vec, vec_new, vec_push, vec_len, vec_get, vec_remove from vec;
include thread;
import thread_sleep_ms from thread;
include time;
import time_now from time;

# ═══════════════════════════════════════════════════════
# Cron Schedule
# ═══════════════════════════════════════════════════════

entity CronExpr:
    minute:      Vec<int>;    # 0-59
    hour:        Vec<int>;    # 0-23
    day_of_month: Vec<int>;   # 1-31
    month:       Vec<int>;    # 1-12
    day_of_week: Vec<int>;    # 0-6 (Sun=0)
end
entity ScheduledJob:
    id:          int,
        name:        string,
        schedule:    CronExpr,
        callback:    func(),
        next_run:    int;          # epoch seconds
    enabled:     bool;
end
entity IntervalJob:
    id:          int,
        name:        string,
        interval_ms: int,
        callback:    func(),
        next_run:    int,
        enabled:     bool,
        repeat:      int;          # -1 = infinite
    _count:      int;
end
entity Scheduler:
    cron_jobs:     Vec<ScheduledJob>,
        interval_jobs: Vec<IntervalJob>,
        next_id:       int,
        running:       bool;
end

# ═══════════════════════════════════════════════════════
# Scheduler Creation
# ═══════════════════════════════════════════════════════

func scheduler_new:
    out Scheduler (
        cron_jobs = vec_new<ScheduledJob>(),
        interval_jobs = vec_new<IntervalJob>(),
        next_id = 1,
        running = false
    );
end
# ═══════════════════════════════════════════════════════
# Interval-based Scheduling (simple API)
# ═══════════════════════════════════════════════════════

## Schedule a job to run every N milliseconds.
func schedule_every:
    in(sched: Scheduler; name: string; interval_ms: int; callback: func())
    id = sched.next_id;
    sched.next_id = sched.next_id + 1;
    now = time_now();
    vec_push<IntervalJob>(&sched.interval_jobs, IntervalJob (
        id = id, name = name, interval_ms = interval_ms,
        callback = callback, next_run = now + interval_ms,
        enabled = true, repeat = -1, _count = 0
    ));
    out id;
end
## Schedule every N seconds.
func schedule_every_seconds:
    in(sched: Scheduler; name: string; seconds: int; callback: func())
    out schedule_every(sched, name, seconds * 1000, callback);
end
## Schedule every N minutes.
func schedule_every_minutes:
    in(sched: Scheduler; name: string; minutes: int; callback: func())
    out schedule_every(sched, name, minutes * 60000, callback);
end
## Schedule every N hours.
func schedule_every_hours:
    in(sched: Scheduler; name: string; hours: int; callback: func())
    out schedule_every(sched, name, hours * 3600000, callback);
end
## Schedule to run once after delay_ms.
func schedule_once:
    in(sched: Scheduler; name: string; delay_ms: int; callback: func())
    id = sched.next_id;
    sched.next_id = sched.next_id + 1;
    now = time_now();
    vec_push<IntervalJob>(&sched.interval_jobs, IntervalJob (
        id = id, name = name, interval_ms = delay_ms,
        callback = callback, next_run = now + delay_ms,
        enabled = true, repeat = 1, _count = 0
    ));
    out id;
end
# ═══════════════════════════════════════════════════════
# Cron Expression Parsing
# ═══════════════════════════════════════════════════════

## Parse a cron expression: "min hour dom month dow"
## Supports: *, N, N-M, */N, N,M,O
func cron_parse:
    in(expr: string)
    parts = _split_spaces(expr);
    if vec_len<string>(parts) != 5 do
        out Err(str_new("cron: expected 5 fields"));
    end

    minute = _parse_cron_field(vec_get<string>(parts, 0), 0, 59);
    hour = _parse_cron_field(vec_get<string>(parts, 1), 0, 23);
    dom = _parse_cron_field(vec_get<string>(parts, 2), 1, 31);
    month = _parse_cron_field(vec_get<string>(parts, 3), 1, 12);
    dow = _parse_cron_field(vec_get<string>(parts, 4), 0, 6);

    out Ok(CronExpr (
        minute = minute, hour = hour,
        day_of_month = dom, month = month,
        day_of_week = dow
    ));
end
## Schedule a job with a cron expression.
func schedule_cron:
    in(sched: Scheduler; name: string; expr: string; callback: func())
    cron_r = cron_parse(expr);
    if is_err(cron_r) do
        out Err(str_new("cron: invalid expression"));
    end
    cron = unwrap_ok(cron_r);

    id = sched.next_id;
    sched.next_id = sched.next_id + 1;
    vec_push<ScheduledJob>(&sched.cron_jobs, ScheduledJob (
        id = id, name = name, schedule = cron,
        callback = callback, next_run = 0,
        enabled = true
    ));
    out Ok(id);
end
# ═══════════════════════════════════════════════════════
# Scheduler Control
# ═══════════════════════════════════════════════════════

## Start the scheduler main loop (blocking).
func scheduler_run:
    in(sched: Scheduler)
    sched.running = true;
    when sched.running loop
        now = time_now();
        _scheduler_tick(sched, now);
        thread_sleep_ms(100);   # poll every 100ms
    end
end
## Stop the scheduler.
func scheduler_stop:
    in(sched: Scheduler)
    sched.running = false;
end
## Cancel a job by ID.
func schedule_cancel:
    in(sched: Scheduler; job_id: int)
    i = 0;
    when i < vec_len<IntervalJob>(sched.interval_jobs) loop
        job = vec_get<IntervalJob>(sched.interval_jobs, i);
        if job.id == job_id do
            vec_remove<IntervalJob>(&sched.interval_jobs, i);
            out;
        end
        i = i + 1;
    end
    i = 0;
    when i < vec_len<ScheduledJob>(sched.cron_jobs) loop
        job = vec_get<ScheduledJob>(sched.cron_jobs, i);
        if job.id == job_id do
            vec_remove<ScheduledJob>(&sched.cron_jobs, i);
            out;
        end
        i = i + 1;
    end
end
## Enable/disable a job by ID.
func schedule_set_enabled:
    in(sched: Scheduler; job_id: int; enabled: bool)
    i = 0;
    when i < vec_len<IntervalJob>(sched.interval_jobs) loop
        job = vec_get<IntervalJob>(sched.interval_jobs, i);
        if job.id == job_id do
            job.enabled = enabled;
            out;
        end
        i = i + 1;
    end
end
# ═══════════════════════════════════════════════════════
# Internal tick
# ═══════════════════════════════════════════════════════

func _scheduler_tick:
    in(sched: Scheduler; now: int)
    # Check interval jobs
    to_remove = vec_new<int>();
    i = 0;
    when i < vec_len<IntervalJob>(sched.interval_jobs) loop
        job = vec_get<IntervalJob>(sched.interval_jobs, i);
        if job.enabled & now >= job.next_run do
            job.callback();
            job._count = job._count + 1;
            job.next_run = now + job.interval_ms;
            if job.repeat > 0 & job._count >= job.repeat do
                vec_push<int>(&to_remove, i);
            end
        end
        i = i + 1;
    end
    # Remove completed one-shots (reverse)
    j = vec_len<int>(to_remove) - 1;
    when j >= 0 loop
        vec_remove<IntervalJob>(&sched.interval_jobs, vec_get<int>(to_remove, j));
        j = j - 1;
    end
end
# ═══════════════════════════════════════════════════════
# Cron field parser
# ═══════════════════════════════════════════════════════

func _parse_cron_field:
    in(field: string; min_val: int; max_val: int)
    values = vec_new<int>();
    flen = str_byte_len(field);

    # Wildcard *
    if flen == 1 & native_load_u8(str_ptr(field)) == 0x2A do
        v = min_val;
        when v <= max_val loop
            vec_push<int>(&values, v);
            v = v + 1;
        end
        out values;
    end

    # Step */N
    slash = str_find(field, str_new("/"));
    if slash >= 0 do
        step = str_to_int(str_substr(field, slash + 1, flen));
        v = min_val;
        when v <= max_val loop
            vec_push<int>(&values, v);
            v = v + step;
        end
        out values;
    end

    # Range N-M
    dash = str_find(field, str_new("-"));
    if dash >= 0 do
        lo = str_to_int(str_substr(field, 0, dash));
        hi = str_to_int(str_substr(field, dash + 1, flen));
        v = lo;
        when v <= hi loop
            vec_push<int>(&values, v);
            v = v + 1;
        end
        out values;
    end

    # List N,M,O or single value
    start = 0;
    k = 0;
    when k <= flen loop
        if k == flen | native_load_u8(ptr_add(str_ptr(field), k)) == 0x2C do
            num_str = str_substr(field, start, k);
            vec_push<int>(&values, str_to_int(num_str));
            start = k + 1;
        end
        k = k + 1;
    end
    out values;
end
func _split_spaces:
    in(s: string)
    parts = vec_new<string>();
    slen = str_byte_len(s);
    start = 0;
    in_word = false;
    i = 0;
    when i <= slen loop
        if i == slen | native_load_u8(ptr_add(str_ptr(s), i)) == 0x20 do
            if in_word do
                vec_push<string>(&parts, str_substr(s, start, i));
                in_word = false;
            end
        else
            if !in_word do
                start = i;
                in_word = true;
            end
        end
        i = i + 1;
    end
    out parts;
end