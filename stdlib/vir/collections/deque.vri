##
 * vir/collections/deque.vri — Double-Ended Queue (Ring Buffer)
 * ==============================================================
 * Inspired by Python: collections.deque
 * Triển khai dưới dạng ring buffer (circular array).
 *
 * Compiler use: BFS/DFS qua CFG, work queues.
 ##

include types;
include option;
import Option, Some, None from option;
include alloc;
import alloc, realloc, free from alloc;
include copy;
import mem_copy from copy;

# ═══════════════════════════════════════════════════════
# Deque<T> — Ring Buffer
# ═══════════════════════════════════════════════════════

entity Deque<T>:
    data:  ptr      # array T vòng,
        head:  int    # index đầu (front),
        len:   int    # số element hiện tại,
        cap:   int    # capacity array (luôn là lũy thừa 2);
end

# ─── Helpers nội bộ ───────────────────────────────────

func _deque_mask<T>:
    in(d:Deque<T>)
    # cap là lũy thừa 2 -> mask = cap - 1
    out d.cap - 1;
end
func _deque_idx<T>:
    in(d:Deque<T>; logical:int)
    out (d.head + logical) & _deque_mask<T>(d);
end
func _next_pow2:
    in(n:int)
    v = n;
    if v == 0 do out 1 end
    v = v - 1;
    v = v | (v >> 1);
    v = v | (v >> 2);
    v = v | (v >> 4);
    v = v | (v >> 8);
    v = v | (v >> 16);
    v = v | (v >> 32);
    out v + 1;
end
func _deque_grow<T>:
    in(d:Deque<T>)
    new_cap = _next_pow2(d.cap * 2);
    if new_cap < 8 do new_cap = 8 end
    new_data = alloc(new_cap * size_of<T>());
    
    # Copy dữ liệu vòng thành tuyến tính
    if d.len > 0 do
        first_run = d.cap - d.head;
        if first_run >= d.len do
            # Vùng dữ liệu liên tục
            mem_copy(new_data, d.data + d.head * size_of<T>(), d.len * size_of<T>());
        else
            # Wrap: [head..cap) + [0..remaining)
            mem_copy(new_data, d.data + d.head * size_of<T>(), first_run * size_of<T>());
            mem_copy(new_data + first_run * size_of<T>(), d.data, (d.len - first_run) * size_of<T>());
        end
    end
    
    free(d.data);
    d.data = new_data;
    d.head = 0;
    d.cap = new_cap;
end
# ─── Constructor ──────────────────────────────────────

func deque_new<T>:
    out Deque<T> ( data = null, head = 0, len = 0, cap = 0 );
end
func deque_with_cap<T>:
    in(cap:int)
    real_cap = _next_pow2(cap);
    if real_cap < 8 do real_cap = 8 end
    out Deque<T> (;
        data = alloc(real_cap * size_of<T>()),
        head = 0, len = 0, cap = real_cap
    );
end
# ─── Size ─────────────────────────────────────────────

func deque_len<T>:
    in(d:Deque<T>)
    out d.len;
end
func deque_is_empty<T>:
    in(d:Deque<T>)
    out d.len == 0;
end
# ─── Push / Pop ───────────────────────────────────────

func deque_push_back<T>:
    in(d:Deque<T>; val:T)
    if d.len == d.cap _deque_grow<T>(d) end do
    idx = _deque_idx<T>(*d, d.len);
    native_store<T>(d.data, idx, val);
    d.len = d.len + 1;
end
func deque_push_front<T>:
    in(d:Deque<T>; val:T)
    if d.len == d.cap _deque_grow<T>(d) end do
    d.head = (d.head - 1) & _deque_mask<T>(*d);
    native_store<T>(d.data, d.head, val);
    d.len = d.len + 1;
end
func deque_pop_back<T>:
    in(d:Deque<T>)
    if d.len == 0 do out None end
    d.len = d.len - 1;
    idx = _deque_idx<T>(*d, d.len);
    out Some(native_load<T>(d.data, idx));
end
func deque_pop_front<T>:
    in(d:Deque<T>)
    if d.len == 0 do out None end
    val = native_load<T>(d.data, d.head);
    d.head = (d.head + 1) & _deque_mask<T>(*d);
    d.len = d.len - 1;
    out Some(val);
end
# ─── Access ───────────────────────────────────────────

func deque_front<T>:
    in(d:Deque<T>)
    if d.len == 0 do out None end
    out Some(native_load<T>(d.data, d.head));
end
func deque_back<T>:
    in(d:Deque<T>)
    if d.len == 0 do out None end
    idx = _deque_idx<T>(d, d.len - 1);
    out Some(native_load<T>(d.data, idx));
end
func deque_get<T>:
    in(d:Deque<T>; idx:int)
    if idx >= d.len do out None end
    real = _deque_idx<T>(d, idx);
    out Some(native_load<T>(d.data, real));
end
# ─── Utility ──────────────────────────────────────────

func deque_clear<T>:
    in(d:Deque<T>)
    d.head = 0;
    d.len = 0;
end
func deque_free<T>:
    in(d:Deque<T>)
    if d.data != null do free(d.data) end
    d.data = null;
    d.head = 0;
    d.len = 0;
    d.cap = 0;
end
func deque_to_vec<T>:
    in(d:Deque<T>)
    v = vec_with_cap<T>(d.len);
    i = 0;
    when i < d.len loop
        real = _deque_idx<T>(d, i);
        vec_push<T>(&v, native_load<T>(d.data, real));
        i = i + 1;
    end
    out v;
end