##
 * vir/collections/deque.vri — Double-Ended Queue (Ring Buffer)
 * ==============================================================
 * Inspired by Python: collections.deque
 * Triển khai dưới dạng ring buffer (circular array).
 *
 * Compiler use: BFS/DFS qua CFG, work queues.
 ##

include types
include option
import Option, Some, None from option
include alloc
import alloc, realloc, free from alloc
include copy
import mem_copy from copy

# ═══════════════════════════════════════════════════════
# Deque of (T) — Ring Buffer
# ═══════════════════════════════════════════════════════

entity Deque of (T):
    data:  ptr      # array T vòng,
        head:  int    # index đầu (front),
        len:   int    # số element hiện tại,
        cap:   int    # capacity array (luôn là lũy thừa 2)
end.

# ─── Helpers nội bộ ───────────────────────────────────

func _deque_mask of (T)(d: Deque of (T)):
    # cap là lũy thừa 2 -> mask = cap - 1
    out d.cap - 1
end.
func _deque_idx of (T)(d: Deque of (T), logical: int):
    out (d.head + logical) & _deque_mask of (T)(d)
end.
func _next_pow2(n: int):
    v = n
    if v == 0 do out 1 end
    v = v - 1
    v = v | (v  shr  1)
    v = v | (v  shr  2)
    v = v | (v  shr  4)
    v = v | (v  shr  8)
    v = v | (v  shr  16)
    v = v | (v  shr  32)
    out v + 1
end.
func _deque_grow of (T)(d: Deque of (T)):
    new_cap = _next_pow2(d.cap * 2)
    if new_cap < 8 do new_cap = 8 end
    new_data = alloc(new_cap * size_of of (T)())
    
    # Copy dữ liệu vòng thành tuyến tính
    if d.len > 0 do
        first_run = d.cap - d.head
        if first_run >= d.len do
            # Vùng dữ liệu liên tục
            mem_copy(new_data, d.data + d.head * size_of of (T)(), d.len * size_of of (T)())
        else
            # Wrap: [head..cap) + [0..remaining)
            mem_copy(new_data, d.data + d.head * size_of of (T)(), first_run * size_of of (T)())
            mem_copy(new_data + first_run * size_of of (T)(), d.data, (d.len - first_run) * size_of of (T)())
        end
    end
    
    free(d.data)
    d.data = new_data
    d.head = 0
    d.cap = new_cap
end.
# ─── Constructor ──────────────────────────────────────

func deque_new of (T):
    out Deque of (T) ( data = null, head = 0, len = 0, cap = 0 )
end.
func deque_with_cap of (T)(cap: int):
    real_cap = _next_pow2(cap)
    if real_cap < 8 do real_cap = 8 end
    out Deque of (T) (
        data = alloc(real_cap * size_of of (T)()),
        head = 0, len = 0, cap = real_cap
    )
end.
# ─── Size ─────────────────────────────────────────────

func deque_len of (T)(d: Deque of (T)):
    out d.len
end.
func deque_is_empty of (T)(d: Deque of (T)):
    out d.len == 0
end.
# ─── Push / Pop ───────────────────────────────────────

func deque_push_back of (T)(d: Deque of (T), val: T):
    if d.len == d.cap _deque_grow of (T)(d) end do
    idx = _deque_idx of (T)(*d, d.len)
    native_store of (T)(d.data, idx, val)
    d.len = d.len + 1
end.
func deque_push_front of (T)(d: Deque of (T), val: T):
    if d.len == d.cap _deque_grow of (T)(d) end do
    d.head = (d.head - 1) & _deque_mask of (T)(*d)
    native_store of (T)(d.data, d.head, val)
    d.len = d.len + 1
end.
func deque_pop_back of (T)(d: Deque of (T)):
    if d.len == 0 do out None end
    d.len = d.len - 1
    idx = _deque_idx of (T)(*d, d.len)
    out Some(native_load of (T)(d.data, idx))
end.
func deque_pop_front of (T)(d: Deque of (T)):
    if d.len == 0 do out None end
    val = native_load of (T)(d.data, d.head)
    d.head = (d.head + 1) & _deque_mask of (T)(*d)
    d.len = d.len - 1
    out Some(val)
end.
# ─── Access ───────────────────────────────────────────

func deque_front of (T)(d: Deque of (T)):
    if d.len == 0 do out None end
    out Some(native_load of (T)(d.data, d.head))
end.
func deque_back of (T)(d: Deque of (T)):
    if d.len == 0 do out None end
    idx = _deque_idx of (T)(d, d.len - 1)
    out Some(native_load of (T)(d.data, idx))
end.
func deque_get of (T)(d: Deque of (T), idx: int):
    if idx >= d.len do out None end
    real = _deque_idx of (T)(d, idx)
    out Some(native_load of (T)(d.data, real))
end.
# ─── Utility ──────────────────────────────────────────

func deque_clear of (T)(d: Deque of (T)):
    d.head = 0
    d.len = 0
end.
func deque_free of (T)(d: Deque of (T)):
    if d.data != null do free(d.data) end
    d.data = null
    d.head = 0
    d.len = 0
    d.cap = 0
end.
func deque_to_vec of (T)(d: Deque of (T)):
    v = vec_with_cap of (T)(d.len)
    i = 0
    when i < d.len loop
        real = _deque_idx of (T)(d, i)
        vec_push of (T)(&v, native_load of (T)(d.data, real))
        i = i + 1
    end
    out v
end.