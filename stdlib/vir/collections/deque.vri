##
 * vir/collections/deque.vri — Double-ended queue (ring buffer, int elements)
 ##

include types
include option
import Option, Some, None from option
include alloc
import alloc, free from alloc
include copy
import mem_copy from copy

const INT_BYTES: 8

entity Deque:
    data: ptr,
    head: int,
    len: int,
    cap: int
end.

func _deque_mask(d: Deque) -> int:
    out d.cap - 1
end.

func _deque_idx(d: Deque, logical: int) -> int:
    out (d.head + logical) & _deque_mask(d)
end.

func _next_pow2_deque(n: int) -> int:
    v = n
    if v == 0 do out 1 end
    v = v - 1
    v = v | (v  shr  1)
    v = v | (v  shr  2)
    v = v | (v  shr  4)
    v = v | (v  shr  8)
    v = v | (v  shr  16)
    v = v | (v  shr  32)
    out v + 1
end.

func _deque_grow:
    ref d: Deque
    new_cap = _next_pow2_deque(d.cap * 2)
    if new_cap < 8 do new_cap = 8 end
    esz = INT_BYTES
    new_data = alloc(new_cap * esz)
    if d.len > 0 do
        first_run = d.cap - d.head
        if first_run >= d.len do
            mem_copy(new_data, d.data + d.head * esz, d.len * esz)
        else
            mem_copy(new_data, d.data + d.head * esz, first_run * esz)
            mem_copy(new_data + first_run * esz, d.data, (d.len - first_run) * esz)
        end
    end
    if d.data != 0 as ptr do free(d.data) end
    d.data = new_data
    d.head = 0
    d.cap = new_cap
end.

func deque_new():
    out Deque ( data: 0 as ptr, head: 0, len: 0, cap: 0 )
end.

func deque_with_cap(cap: int):
    real_cap = _next_pow2_deque(cap)
    if real_cap < 8 do real_cap = 8 end
    out Deque (
        data: alloc(real_cap * INT_BYTES),
        head: 0, len: 0, cap: real_cap
    )
end.

func deque_len(d: Deque):
    out d.len
end.

func deque_is_empty(d: Deque):
    out d.len == 0
end.

func _deque_store(data: ptr, idx: int, val: int):
    let _w = native_write_i64((data as int) + idx * INT_BYTES, 0, val)
end.

func _deque_load(data: ptr, idx: int) -> int:
    out native_read_i64((data as int) + idx * INT_BYTES, 0)
end.

func deque_push_back:
    ref d: Deque
    in val: int
    if d.len == d.cap do _deque_grow(d) end
    idx = _deque_idx(d, d.len)
    _deque_store(d.data, idx, val)
    d.len = d.len + 1
end.

func deque_push_front:
    ref d: Deque
    in val: int
    if d.len == d.cap do _deque_grow(d) end
    d.head = (d.head - 1) & _deque_mask(d)
    _deque_store(d.data, d.head, val)
    d.len = d.len + 1
end.

func deque_pop_back:
    ref d: Deque
    if d.len == 0 do out None end
    d.len = d.len - 1
    idx = _deque_idx(d, d.len)
    out Some(_deque_load(d.data, idx))
end.

func deque_pop_front:
    ref d: Deque
    if d.len == 0 do out None end
    val = _deque_load(d.data, d.head)
    d.head = (d.head + 1) & _deque_mask(d)
    d.len = d.len - 1
    out Some(val)
end.

func deque_clear:
    ref d: Deque
    d.head = 0
    d.len = 0
end.

func deque_free:
    ref d: Deque
    if d.data != 0 as ptr do free(d.data) end
    d.data = 0 as ptr
    d.head = 0
    d.len = 0
    d.cap = 0
end.

export Deque, deque_new, deque_with_cap, deque_len, deque_is_empty
export deque_push_back, deque_push_front, deque_pop_back, deque_pop_front
export deque_clear, deque_free
