##
 * vir/collections/skiplist.vri — Skip List
 * ==========================================
 * Inspired by Rust: skiplist crate
 * Inspired by Go: huandu/skiplist
 * Inspired by Java: ConcurrentSkipListMap
 *
 * Phase C — Tier 3: Probabilistic ordered data structure.
 * O(log n) insert/search/delete average case.
 * Max level 32, promotion probability 1/2.
 ##

include types;
include option;
import Option, Some, None, is_some, is_none, unwrap from option;
include vec;
import Vec, vec_new, vec_push, vec_get, vec_set, vec_len from vec;

# ═══════════════════════════════════════════════════════
# Constants
# ═══════════════════════════════════════════════════════

const SKIPLIST_MAX_LEVEL = 32;

# ═══════════════════════════════════════════════════════
# Skip list node
# ═══════════════════════════════════════════════════════

entity SkipNode:
    key:      int,
        value:    int,
        forward:  Vec;        # Vec<Option<SkipNode>>  (level 0..max)
    level:    int;
end.

func _skip_node_new:
    in(key: int; value: int; level: int)
    fwd = vec_new();
    i = 0;
    when i <= level loop
        vec_push(fwd, None);
        i = i + 1;
    end
    out SkipNode {
        key: key,
        value: value,
        forward: fwd,
        level: level
    };
end

# ═══════════════════════════════════════════════════════
# Skip list entity
# ═══════════════════════════════════════════════════════

entity SkipList:
    header:   SkipNode,
        level:    int;         # current max level
    size:     int,
        seed:     int;         # PRNG state for level generation
end.

func skiplist_new:
    in()
    header = _skip_node_new(-9999999999, 0, SKIPLIST_MAX_LEVEL);
    out SkipList {
        header: header,
        level: 0,
        size: 0,
        seed: 42
    };
end

# ─── PRNG for random level ──────────────────────────

func _sl_rand:
    in(sl: SkipList)
    # xorshift32-style: simple integer PRNG
    s = sl.seed;
    s = s * 1103515245 + 12345;
    if s < 0 do
        s = 0 - s;
    end
    sl.seed = s;
    out s;
end.

func _random_level:
    in(sl: SkipList)
    lvl = 0;
    r = _sl_rand(sl);
    # Promote with p=0.5 — check bottom bit via mod 2
    when lvl < SKIPLIST_MAX_LEVEL and r - (r / 2) * 2 == 0 loop
        lvl = lvl + 1;
        r = _sl_rand(sl);
    end
    out lvl;
end

# ─── Search ─────────────────────────────────────────

func skiplist_get:
    in(sl: SkipList; key: int)
    x = sl.header;
    i = sl.level;
    when i >= 0 loop
        done = false;
        when not done loop
            fwd = vec_get(x.forward, i);
            if is_some(fwd) do
                next = unwrap(fwd);
                if next.key < key do
                    x = next;
                else
                    done = true;
                end
            else
                done = true;
            end
        end
        i = i - 1;
    end
    # Check next node at level 0
    fwd0 = vec_get(x.forward, 0);
    if is_some(fwd0) do
        candidate = unwrap(fwd0);
        if candidate.key == key do
            out Some(candidate.value);
        end
    end
    out None;
end.

func skiplist_contains:
    in(sl: SkipList; key: int)
    out is_some(skiplist_get(sl, key));
end

# ─── Insert ─────────────────────────────────────────

func skiplist_insert:
    in(sl: SkipList; key: int; value: int)

    # Collect update path
    update = vec_new();
    i = 0;
    when i <= SKIPLIST_MAX_LEVEL loop
        vec_push(update, sl.header);
        i = i + 1;
    end

    x = sl.header;
    i = sl.level;
    when i >= 0 loop
        done = false;
        when not done loop
            fwd = vec_get(x.forward, i);
            if is_some(fwd) do
                next = unwrap(fwd);
                if next.key < key do
                    x = next;
                else
                    done = true;
                end
            else
                done = true;
            end
        end
        vec_set(update, i, x);
        i = i - 1;
    end

    # Check if key exists — update value
    fwd0 = vec_get(x.forward, 0);
    if is_some(fwd0) do
        candidate = unwrap(fwd0);
        if candidate.key == key do
            candidate.value = value;
            out;
        end
    end

    # New node
    new_level = _random_level(sl);
    if new_level > sl.level do
        j = sl.level + 1;
        when j <= new_level loop
            vec_set(update, j, sl.header);
            j = j + 1;
        end
        sl.level = new_level;
    end

    new_node = _skip_node_new(key, value, new_level);

    j = 0;
    when j <= new_level loop
        prev = vec_get(update, j);
        old_fwd = vec_get(prev.forward, j);
        vec_set(new_node.forward, j, old_fwd);
        vec_set(prev.forward, j, Some(new_node));
        j = j + 1;
    end

    sl.size = sl.size + 1;
end

# ─── Remove ─────────────────────────────────────────

func skiplist_remove:
    in(sl: SkipList; key: int)
    update = vec_new();
    i = 0;
    when i <= SKIPLIST_MAX_LEVEL loop
        vec_push(update, sl.header);
        i = i + 1;
    end

    x = sl.header;
    i = sl.level;
    when i >= 0 loop
        done = false;
        when not done loop
            fwd = vec_get(x.forward, i);
            if is_some(fwd) do
                next = unwrap(fwd);
                if next.key < key do
                    x = next;
                else
                    done = true;
                end
            else
                done = true;
            end
        end
        vec_set(update, i, x);
        i = i - 1;
    end

    fwd0 = vec_get(x.forward, 0);
    if is_none(fwd0) do out false end
    target = unwrap(fwd0);
    if target.key != key do out false end

    j = 0;
    when j <= sl.level loop
        prev = vec_get(update, j);
        pfwd = vec_get(prev.forward, j);
        if is_some(pfwd) do
            pn = unwrap(pfwd);
            if pn.key == key do
                vec_set(prev.forward, j, vec_get(target.forward, j));
            end
        end
        j = j + 1;
    end

    # Decrease level if needed
    when sl.level > 0 and is_none(vec_get(sl.header.forward, sl.level)) loop
        sl.level = sl.level - 1;
    end

    sl.size = sl.size - 1;
    out true;
end

# ─── Size / Empty ───────────────────────────────────

func skiplist_len:
    in(sl: SkipList)
    out sl.size;
end.

func skiplist_is_empty:
    in(sl: SkipList)
    out sl.size == 0;
end

# ─── Min / Max ──────────────────────────────────────

func skiplist_min:
    in(sl: SkipList)
    fwd0 = vec_get(sl.header.forward, 0);
    if is_none(fwd0) do out None end
    first = unwrap(fwd0);
    out Some(first.key);
end.

func skiplist_max:
    in(sl: SkipList)
    x = sl.header;
    done = false;
    last_key = None;
    # Walk level 0 to find last node
    when not done loop
        fwd = vec_get(x.forward, 0);
        if is_some(fwd) do
            x = unwrap(fwd);
            last_key = Some(x.key);
        else
            done = true;
        end
    end
    out last_key;
end

# ─── Range query: all keys in [lo, hi] ─────────────

func skiplist_range:
    in(sl: SkipList; lo: int; hi: int)
    result = vec_new();

    # Find first node >= lo
    x = sl.header;
    i = sl.level;
    when i >= 0 loop
        done = false;
        when not done loop
            fwd = vec_get(x.forward, i);
            if is_some(fwd) do
                next = unwrap(fwd);
                if next.key < lo do
                    x = next;
                else
                    done = true;
                end
            else
                done = true;
            end
        end
        i = i - 1;
    end

    # Scan level 0 from here
    fwd0 = vec_get(x.forward, 0);
    collecting = is_some(fwd0);
    when collecting loop
        node = unwrap(fwd0);
        if node.key > hi do
            collecting = false;
        else
            if node.key >= lo do
                vec_push(result, node.key);
            end
            fwd0 = vec_get(node.forward, 0);
            collecting = is_some(fwd0);
        end
    end
    out result;
end

# ─── To sorted vec of keys ─────────────────────────

func skiplist_keys:
    in(sl: SkipList)
    result = vec_new();
    fwd0 = vec_get(sl.header.forward, 0);
    when is_some(fwd0) loop
        node = unwrap(fwd0);
        vec_push(result, node.key);
        fwd0 = vec_get(node.forward, 0);
    end
    out result;
end
