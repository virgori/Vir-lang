##
 * vir/collections/map.vri — Hash Map
 * =====================================
 * Inspired by Python: dict
 * Inspired by Rust: HashMap
 * Triển khai: Open addressing + Linear probing + Tombstone deletion
 *
 * Compiler use: symbol table, type registry, string interning.
 ##

include types;
include option;
import Option, Some, None from option;
include alloc;
import alloc, alloc_zeroed, free from alloc;
include copy;
import mem_set from copy;
include vec;
import Vec, vec_new, vec_push from vec;

# ═══════════════════════════════════════════════════════
# Hash Function — SipHash-2-4 (HashDoS-resistant)
# ═══════════════════════════════════════════════════════
# FNV-1a is fast but trivially collision-attackable.
# SipHash-2-4 is the standard for hash tables (Rust, Python 3.4+).

# Per-process random seed — initialized once from OS entropy
var _sip_k0: int = 0;
var _sip_k1: int = 0;
var _sip_seeded: bool = false;

extern func native_random_u64() -> int;  # OS entropy (getrandom/getentropy)

func _sip_init_seed:
    if _sip_seeded do out; end
    _sip_k0 = native_random_u64();
    _sip_k1 = native_random_u64();
    _sip_seeded = true;
end
func _rotl64:
    in(x: int; n: int)
    var shift_l = x shl n; var shift_r = x shr (64 - n); var mask = (1 shl n) - 1; out shift_l | (shift_r & mask);
end
func _sip_round:
    in(v0: int; v1: int; v2: int; v3: int)
    v0 = v0 + v1;  v1 = _rotl64(v1, 13);  v1 = v1 ^ v0;  v0 = _rotl64(v0, 32);
    v2 = v2 + v3;  v3 = _rotl64(v3, 16);  v3 = v3 ^ v2;
    v0 = v0 + v3;  v3 = _rotl64(v3, 21);  v3 = v3 ^ v0;
    v2 = v2 + v1;  v1 = _rotl64(v1, 17);  v1 = v1 ^ v2;  v2 = _rotl64(v2, 32);
    out (v0, v1, v2, v3);
end
func hash_bytes:
    in(data:ptr; len:int)
    _sip_init_seed();
    v0 = _sip_k0 ^ 0x736f6d6570736575;
    v1 = _sip_k1 ^ 0x646f72616e646f6d;
    v2 = _sip_k0 ^ 0x6c7967656e657261;
    v3 = _sip_k1 ^ 0x7465646279746573;

    # Process 8-byte blocks
    nblocks = len / 8;
    i = 0;
    when i < nblocks loop
        m = native_load_u64_le(data, i * 8);
        v3 = v3 ^ m;
        var tup1 = _sip_round(v0, v1, v2, v3);
        v0 = tup1.0; v1 = tup1.1; v2 = tup1.2; v3 = tup1.3;
        var tup2 = _sip_round(v0, v1, v2, v3);
        v0 = tup2.0; v1 = tup2.1; v2 = tup2.2; v3 = tup2.3;
        v0 = v0 ^ m;
        i = i + 1;
    end

    # Tail bytes + length tag
    tail = 0;
    remaining = len & 7;
    off = nblocks * 8;
    j = 0;
    when j < remaining loop
        tail = tail | (native_load_u8(data, off + j) << (j * 8));
        j = j + 1;
    end
    tail = tail | (len << 56);
    v3 = v3 ^ tail;
    var tup1 = _sip_round(v0, v1, v2, v3);
    v0 = tup1.0; v1 = tup1.1; v2 = tup1.2; v3 = tup1.3;
    var tup2 = _sip_round(v0, v1, v2, v3);
    v0 = tup2.0; v1 = tup2.1; v2 = tup2.2; v3 = tup2.3;
    v0 = v0 ^ tail;

    # Finalization
    v2 = v2 ^ 0xFF;
    var tup_tmp = _sip_round(v0, v1, v2, v3);
    v0 = tup_tmp.0; v1 = tup_tmp.1; v2 = tup_tmp.2; v3 = tup_tmp.3;
    var tup_tmp = _sip_round(v0, v1, v2, v3);
    v0 = tup_tmp.0; v1 = tup_tmp.1; v2 = tup_tmp.2; v3 = tup_tmp.3;
    var tup_tmp = _sip_round(v0, v1, v2, v3);
    v0 = tup_tmp.0; v1 = tup_tmp.1; v2 = tup_tmp.2; v3 = tup_tmp.3;
    var tup_tmp = _sip_round(v0, v1, v2, v3);
    v0 = tup_tmp.0; v1 = tup_tmp.1; v2 = tup_tmp.2; v3 = tup_tmp.3;
    out v0 ^ v1 ^ v2 ^ v3;
end
func hash_i64:
    in(val:int)
    _sip_init_seed();
    # Inline SipHash for a single 8-byte word
    v0 = _sip_k0 ^ 0x736f6d6570736575;
    v1 = _sip_k1 ^ 0x646f72616e646f6d;
    v2 = _sip_k0 ^ 0x6c7967656e657261;
    v3 = _sip_k1 ^ 0x7465646279746573;
    v3 = v3 ^ val;
    var tup_tmp = _sip_round(v0, v1, v2, v3);
    v0 = tup_tmp.0; v1 = tup_tmp.1; v2 = tup_tmp.2; v3 = tup_tmp.3;
    var tup_tmp = _sip_round(v0, v1, v2, v3);
    v0 = tup_tmp.0; v1 = tup_tmp.1; v2 = tup_tmp.2; v3 = tup_tmp.3;
    v0 = v0 ^ val;
    # Length tag: 8 bytes
    tail = 8 << 56;
    v3 = v3 ^ tail;
    var tup_tmp = _sip_round(v0, v1, v2, v3);
    v0 = tup_tmp.0; v1 = tup_tmp.1; v2 = tup_tmp.2; v3 = tup_tmp.3;
    var tup_tmp = _sip_round(v0, v1, v2, v3);
    v0 = tup_tmp.0; v1 = tup_tmp.1; v2 = tup_tmp.2; v3 = tup_tmp.3;
    v0 = v0 ^ tail;
    v2 = v2 ^ 0xFF;
    var tup_tmp = _sip_round(v0, v1, v2, v3);
    v0 = tup_tmp.0; v1 = tup_tmp.1; v2 = tup_tmp.2; v3 = tup_tmp.3;
    var tup_tmp = _sip_round(v0, v1, v2, v3);
    v0 = tup_tmp.0; v1 = tup_tmp.1; v2 = tup_tmp.2; v3 = tup_tmp.3;
    var tup_tmp = _sip_round(v0, v1, v2, v3);
    v0 = tup_tmp.0; v1 = tup_tmp.1; v2 = tup_tmp.2; v3 = tup_tmp.3;
    var tup_tmp = _sip_round(v0, v1, v2, v3);
    v0 = tup_tmp.0; v1 = tup_tmp.1; v2 = tup_tmp.2; v3 = tup_tmp.3;
    out v0 ^ v1 ^ v2 ^ v3;
end
func hash_string:
    in(s:string)
    out hash_bytes(s.data, s.byte_len);
end
# ═══════════════════════════════════════════════════════
# Entry State
# ═══════════════════════════════════════════════════════

const ENTRY_EMPTY: 0;
const ENTRY_OCCUPIED: 1;
const ENTRY_TOMBSTONE: 2;

entity MapEntry<K, V>:
    state: int,
        hash:  int,
        key:   K,
        value: V;
end
# ═══════════════════════════════════════════════════════
# Map<K, V> — Open Addressing Hash Map
# ═══════════════════════════════════════════════════════

entity Map<K, V>:
    entries:   ptr         # MapEntry<K,V> array,
        cap:       int       # slot count (always power of 2),
        len:       int       # number of occupied entries,
        tombstones: int      # number of tombstones,
        hash_fn:   func(K) -> int,
        eq_fn:     func(K, K) -> bool;
end
const MAP_LOAD_FACTOR_NUM: 3;
const MAP_LOAD_FACTOR_DEN: 4   # 75%;

# ─── Constructor ──────────────────────────────────────

func map_new<K, V>: in(hash_fn: ptr; eq_fn: ptr) out(Map)
    out Map (
        entries = null,
        cap = 0, len = 0, tombstones = 0,
        hash_fn = hash_fn, eq_fn = eq_fn
    );
end
func map_with_cap<K, V>: in(cap: int; hash_fn: ptr; eq_fn: ptr) out(Map)
    real_cap = _next_pow2(cap);
    if real_cap < 16 do real_cap = 16 end
    entry_size = size_of<MapEntry<K, V>>();
    out Map (
        entries = alloc_zeroed(real_cap * entry_size),
        cap = real_cap, len = 0, tombstones = 0,
        hash_fn = hash_fn, eq_fn = eq_fn
    );
end
# ─── Internal ─────────────────────────────────────────

func _map_mask<K, V>(m: Map<K, V>) -> int
    out m.cap - 1;
end
func _map_needs_grow<K, V>(m: Map<K, V>) -> bool
    out (m.len + m.tombstones) * MAP_LOAD_FACTOR_DEN >= m.cap * MAP_LOAD_FACTOR_NUM;
end
func _map_entry_ptr<K, V>(m: Map<K, V>, idx: int) -> ptr
    out m.entries + idx * size_of<MapEntry<K, V>>();
end
func _map_grow<K, V>(m: &Map<K, V>)
    old_entries = m.entries;
    old_cap = m.cap;
    
    new_cap = m.cap * 2;
    if new_cap < 16 do new_cap = 16 end
    entry_size = size_of<MapEntry<K, V>>();
    m.entries = alloc_zeroed(new_cap * entry_size);
    m.cap = new_cap;
    m.len = 0;
    m.tombstones = 0;
    
    # Rehash tất cả entries
    if old_entries != null do
        i = 0;
        when i < old_cap loop
            e = native_load_struct<MapEntry<K, V>>(old_entries, i);
            if e.state == ENTRY_OCCUPIED do
                _map_insert_internal<K, V>(m, e.hash, e.key, e.value);
            end
            i = i + 1;
        end
        free(old_entries);
    end
end
func _map_insert_internal<K, V>: in(m: ptr; h: int; key: K; val: V)
    mask = m.cap - 1;
    idx = h & mask;
    probes = 0;
    
    when probes < m.cap loop
        e = native_load_struct<MapEntry<K, V>>(m.entries, idx);
        if e.state != ENTRY_OCCUPIED do
            native_store_struct<MapEntry<K, V>>(m.entries, idx, MapEntry<K, V> (
                state = ENTRY_OCCUPIED, hash = h, key = key, value = val
    ));
            m.len = m.len + 1;
            out;
        end
        idx = (idx + 1) & mask;
        probes = probes + 1;
    end
    # Should never reach here if load factor is maintained
    panic(str_new("map_insert_internal: table full"));
end
# ─── Public API ───────────────────────────────────────

func map_insert<K, V>: in(m: ptr; key: K; val: V) out(Option)
    # Chèn key-value pair. Returns value cũ if key already exists.
    if _map_needs_grow(*m) do _map_grow(m) end
    
    h = m.hash_fn(key);
    mask = m.cap - 1;
    idx = h & mask;
    probes = 0;
    
    when probes < m.cap loop
        e = native_load_struct<MapEntry<K, V>>(m.entries, idx);
        
        if e.state == ENTRY_EMPTY or e.state == ENTRY_TOMBSTONE do
            native_store_struct<MapEntry<K, V>>(m.entries, idx, MapEntry<K, V> (
                state = ENTRY_OCCUPIED, hash = h, key = key, value = val
    ));
            if e.state == ENTRY_TOMBSTONE do
                m.tombstones = m.tombstones - 1;
            end
            m.len = m.len + 1;
            out None;
        end
        
        if e.hash == h and m.eq_fn(e.key, key) do
            # Key already exists — thay thế value
            old_val = e.value;
            native_store_struct<MapEntry<K, V>>(m.entries, idx, MapEntry<K, V> (
                state = ENTRY_OCCUPIED, hash = h, key = key, value = val
    ));
            out Some(old_val);
        end
        
        idx = (idx + 1) & mask;
        probes = probes + 1;
    end
    out None;
end
func map_get<K, V>: in(m: Map; key: K) out(Option)
    if m.cap == 0 do out None end
    
    h = m.hash_fn(key);
    mask = m.cap - 1;
    idx = h & mask;
    probes = 0;
    
    when probes < m.cap loop
        e = native_load_struct<MapEntry<K, V>>(m.entries, idx);
        
        if e.state == ENTRY_EMPTY do out None end
        
        if e.state == ENTRY_OCCUPIED and e.hash == h and m.eq_fn(e.key, key) do
            out Some(e.value);
        end
        
        idx = (idx + 1) & mask;
        probes = probes + 1;
    end
    out None;
end
func map_contains<K, V>: in(m: Map; key: K) out(bool)
    out is_some(map_get<K, V>(m, key));
end
func map_remove<K, V>: in(m: ptr; key: K) out(Option)
    if m.cap == 0 do out None end
    
    h = m.hash_fn(key);
    mask = m.cap - 1;
    idx = h & mask;
    probes = 0;
    
    when probes < m.cap loop
        e = native_load_struct<MapEntry<K, V>>(m.entries, idx);
        
        if e.state == ENTRY_EMPTY do out None end
        
        if e.state == ENTRY_OCCUPIED and e.hash == h and m.eq_fn(e.key, key) do
            old_val = e.value;
            native_store_struct<MapEntry<K, V>>(m.entries, idx, MapEntry<K, V> (
                state = ENTRY_TOMBSTONE, hash = 0, key = e.key, value = e.value
    ));
            m.len = m.len - 1;
            m.tombstones = m.tombstones + 1;
            out Some(old_val);
        end
        
        idx = (idx + 1) & mask;
        probes = probes + 1;
    end
    out None;
end
# ─── Info ─────────────────────────────────────────────

func map_len<K, V>: in(m: Map) out(int)
    out m.len;
end
func map_is_empty<K, V>: in(m: Map) out(bool)
    out m.len == 0;
end
# ─── Iteration ────────────────────────────────────────

entity MapPair<K, V>:
    key: K,
        value: V;
end
func map_keys<K, V>: in(m: Map) out(Vec)
    keys = vec_new<K>();
    i = 0;
    when i < m.cap loop
        e = native_load_struct<MapEntry<K, V>>(m.entries, i);
        if e.state == ENTRY_OCCUPIED do
            vec_push<K>(&keys, e.key);
        end
        i = i + 1;
    end
    out keys;
end
func map_values<K, V>: in(m: Map) out(Vec)
    values = vec_new<V>();
    i = 0;
    when i < m.cap loop
        e = native_load_struct<MapEntry<K, V>>(m.entries, i);
        if e.state == ENTRY_OCCUPIED do
            vec_push<V>(&values, e.value);
        end
        i = i + 1;
    end
    out values;
end
func map_pairs<K, V>: in(m: Map) out(Vec)
    pairs = vec_new<MapPair<K, V>>();
    i = 0;
    when i < m.cap loop
        e = native_load_struct<MapEntry<K, V>>(m.entries, i);
        if e.state == ENTRY_OCCUPIED do
            vec_push<MapPair<K, V>>(&pairs, MapPair ( key: e.key, value: e.value ));
        end
        i = i + 1;
    end
    out pairs;
end
# ─── Utility ──────────────────────────────────────────

func map_clear<K, V>: in(m: ptr)
    if m.entries != null do
        mem_set(m.entries, 0, m.cap * size_of<MapEntry<K, V>>());
    end
    m.len = 0;
    m.tombstones = 0;
end
func map_free<K, V>(m: &Map<K, V>)
    if m.entries != null do free(m.entries) end
    m.entries = null;
    m.cap = 0;
    m.len = 0;
    m.tombstones = 0;
end
# ═══════════════════════════════════════════════════════
# Convenience: String->V map
# ═══════════════════════════════════════════════════════

func string_map_new<V>:
    out map_new<string, V>(hash_string, str_eq)
end