##
 * vir/collections/concurrent_map.vri — Lock-Striped Concurrent HashMap
 * ====================================================================
 * Inspired by Rust: dashmap crate
 * Inspired by Go: sync.Map
 * Inspired by Java: ConcurrentHashMap
 *
 * Phase D — Full coverage. Shard-based concurrency via stripe-locking.
 * 16 shards by default, each with independent Mutex + Map.
 ##

include types;
include option;
import Option, Some, None, is_some, is_none, unwrap from option;
include vec;
import Vec, vec_new, vec_push, vec_get, vec_set, vec_len from vec;
include collections/map;
import Map, map_new, map_insert, map_get, map_remove, map_contains,
       map_keys, native_hash_i64, native_hash_str from collections/map;
include thread/thread;
import Mutex, mutex_new, mutex_lock, mutex_unlock from thread/thread;

const SHARD_COUNT = 16;
const SHARD_MASK  = 15;   # SHARD_COUNT - 1

# ═══════════════════════════════════════════════════════
# Shard entity
# ═══════════════════════════════════════════════════════

entity Shard:
    mu:   Mutex,
        data: Map;
end.
entity ConcurrentMap:
    shards:  Vec;        # Vec<Shard>, length = SHARD_COUNT
    hash_fn: func,
        eq_fn:   func;
end.

# ═══════════════════════════════════════════════════════
# Constructor
# ═══════════════════════════════════════════════════════

func cmap_new(hash_fn: func, eq_fn: func):
    shards = vec_new();
    i = 0;
    when i < SHARD_COUNT loop
        shard = Shard (
            mu:   mutex_new(),
            data: map_new(hash_fn, eq_fn)
        );
        vec_push(shards, shard);
        i = i + 1;
    end
    out ConcurrentMap (
        shards:  shards,
        hash_fn: hash_fn,
        eq_fn:   eq_fn
    );
end.
func _cmap_shard_index(cm: ConcurrentMap, key: any_val):
    h = cm.hash_fn(key);
    if h < 0 do
        h = -h;
    end
    out h & SHARD_MASK;
end.
# ═══════════════════════════════════════════════════════
# Thread-safe operations
# ═══════════════════════════════════════════════════════

func cmap_insert:
    in  cm: ConcurrentMap;
        key: any_val;
        value: any_val
    idx = _cmap_shard_index(cm, key);
    shard = vec_get(cm.shards, idx);
    mutex_lock(shard.mu);
    map_insert(shard.data, key, value);
    mutex_unlock(shard.mu);
end.
func cmap_get(cm: ConcurrentMap, key: any_val):
    idx = _cmap_shard_index(cm, key);
    shard = vec_get(cm.shards, idx);
    mutex_lock(shard.mu);
    result = map_get(shard.data, key);
    mutex_unlock(shard.mu);
    out result;
end.
func cmap_remove(cm: ConcurrentMap, key: any_val):
    idx = _cmap_shard_index(cm, key);
    shard = vec_get(cm.shards, idx);
    mutex_lock(shard.mu);
    result = map_remove(shard.data, key);
    mutex_unlock(shard.mu);
    out result;
end.
func cmap_contains(cm: ConcurrentMap, key: any_val):
    idx = _cmap_shard_index(cm, key);
    shard = vec_get(cm.shards, idx);
    mutex_lock(shard.mu);
    result = map_contains(shard.data, key);
    mutex_unlock(shard.mu);
    out result;
end.
func cmap_get_or_insert:
    in  cm: ConcurrentMap;
        key: any_val;
        default_val: any_val
    idx = _cmap_shard_index(cm, key);
    shard = vec_get(cm.shards, idx);
    mutex_lock(shard.mu);
    existing = map_get(shard.data, key);
    if is_some(existing) do
        mutex_unlock(shard.mu);
        out unwrap(existing);
    end
    map_insert(shard.data, key, default_val);
    mutex_unlock(shard.mu);
    out default_val;
end.
# ═══════════════════════════════════════════════════════
# Bulk operations
# ═══════════════════════════════════════════════════════

func cmap_keys(cm: ConcurrentMap):
    result = vec_new();
    i = 0;
    when i < SHARD_COUNT loop
        shard = vec_get(cm.shards, i);
        mutex_lock(shard.mu);
        shard_keys = map_keys(shard.data);
        j = 0;
        when j < vec_len(shard_keys) loop
            vec_push(result, vec_get(shard_keys, j));
            j = j + 1;
        end
        mutex_unlock(shard.mu);
        i = i + 1;
    end
    out result;
end.
func cmap_size(cm: ConcurrentMap):
    total = 0;
    i = 0;
    when i < SHARD_COUNT loop
        shard = vec_get(cm.shards, i);
        mutex_lock(shard.mu);
        total = total + vec_len(map_keys(shard.data));
        mutex_unlock(shard.mu);
        i = i + 1;
    end
    out total;
end.