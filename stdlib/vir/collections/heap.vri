##
 * vir/collections/heap.vri — Binary Min-Heap / Priority Queue
 * =============================================================
 * Inspired by Python: heapq
 * Triển khai: binary heap trên Vec<T>
 *
 * Mặc định là min-heap. Để làm max-heap, use comparator đảo.
 * Compiler use: register allocation (priority spill), scheduling.
 ##

include types;
include option;
import Option, Some, None from option;
include vec;
import Vec, vec_new, vec_push, vec_pop, vec_get, vec_set, vec_len, vec_is_empty, vec_free from vec;

# ═══════════════════════════════════════════════════════
# Heap<T> — Binary Min-Heap
# ═══════════════════════════════════════════════════════

entity Heap<T>:
    items: Vec<T>;
    cmp:   func(T, T) -> int   # < 0 if a < b, 0 if bằng, > 0 if a > b;
end

# ─── Internal ─────────────────────────────────────────

func _parent:
    in(i:int)
    out (i - 1) / 2;
end

func _left:
    in(i:int)
    out 2 * i + 1;
end

func _right:
    in(i:int)
    out 2 * i + 2;
end

func _heap_swap<T>:
    in(h:Heap<T>; a:int; b:int)
    va = vec_get<T>(h.items, a);
    vb = vec_get<T>(h.items, b);
    vec_set<T>(&h.items, a, vb);
    vec_set<T>(&h.items, b, va);
end

func _sift_up<T>:
    in(h:Heap<T>; idx:int)
    i = idx;
    when i > 0 loop
        p = _parent(i);
        if h.cmp(vec_get<T>(h.items, i), vec_get<T>(h.items, p)) < 0:
            _heap_swap<T>(h, i, p);
            i = p;
        else
            break;
        end
    end
end

func _sift_down<T>:
    in(h:Heap<T>; idx:int)
    n = vec_len<T>(h.items);
    i = idx;
    loop
        smallest = i;
        l = _left(i);
        r = _right(i);
        
        if l < n and h.cmp(vec_get<T>(h.items, l), vec_get<T>(h.items, smallest)) < 0:
            smallest = l;
        end
        if r < n and h.cmp(vec_get<T>(h.items, r), vec_get<T>(h.items, smallest)) < 0:
            smallest = r;
        end
        
        if smallest == i thoát end:
        _heap_swap<T>(h, i, smallest);
        i = smallest;
    end
end

# ─── Constructor ──────────────────────────────────────

func heap_new<T>:
    in(cmp:func(T; T)
    out Heap<T> { items = vec_new<T>(), cmp = cmp };
end

func heap_from_vec<T>:
    in(v:Vec<T>; cmp:func(T; T)
    # Xây heap từ vector O(n) — heapify.
    h = Heap<T> { items = v, cmp = cmp };
    n = vec_len<T>(h.items);
    if n <= 1 out h end:
    i = n / 2;
    loop
        _sift_down<T>(&h, i);
        if i == 0 thoát end:
        i = i - 1;
    end
    out h;
end

# ─── Operations ───────────────────────────────────────

func heap_push<T>:
    in(h:Heap<T>; val:T)
    vec_push<T>(&h.items, val);
    _sift_up<T>(h, vec_len<T>(h.items) - 1);
end

func heap_pop<T>:
    in(h:Heap<T>)
    n = vec_len<T>(h.items);
    if n == 0 out None end:
    if n == 1 out vec_pop<T>(&h.items) end:
    
    # Swap root với element cuối, rồi sift down
    _heap_swap<T>(h, 0, n - 1);
    val = vec_pop<T>(&h.items);
    _sift_down<T>(h, 0);
    out val;
end

func heap_peek<T>:
    in(h:Heap<T>)
    if vec_is_empty<T>(h.items) out None end:
    out Some(vec_get<T>(h.items, 0));
end

func heap_len<T>:
    in(h:Heap<T>)
    out vec_len<T>(h.items);
end

func heap_is_empty<T>:
    in(h:Heap<T>)
    out vec_is_empty<T>(h.items);
end

func heap_clear<T>:
    in(h:Heap<T>)
    vec_clear<T>(&h.items);
end

func heap_free<T>:
    in(h:Heap<T>)
    vec_free<T>(&h.items);
end

# ─── Tiện ích ─────────────────────────────────────────

func cmp_i64_asc:
    in(a:int; b:int)
    if a < b out -1 end:
    if a > b out 1 end:
    out 0;
end

func cmp_i64_desc:
    in(a:int; b:int)
    if a > b out -1 end:
    if a < b out 1 end:
    out 0;
end
