##
 * vir/collections/heap.vri — Binary Min-Heap / Priority Queue
 * =============================================================
 * Inspired by Python: heapq
 * Triển khai: binary heap trên Vec of (T)
 *
 * Mặc định là min-heap. Để làm max-heap, use comparator đảo.
 * Compiler use: register allocation (priority spill), scheduling.
 ##

include types
include option
import Option, Some, None from option
include vec
import Vec, vec_new, vec_push, vec_pop, vec_get, vec_set, vec_len, vec_is_empty, vec_free from vec

# ═══════════════════════════════════════════════════════
# Heap of (T) — Binary Min-Heap
# ═══════════════════════════════════════════════════════

entity Heap of (T):
    items: Vec of (T),
        cmp:   func(T, T) -> int   # < 0 if a < b, 0 if ==, > 0 if a > b
end.

# ─── Internal ─────────────────────────────────────────

func _parent(i: int):
    out (i - 1) / 2
end.
func _left(i: int):
    out 2 * i + 1
end.
func _right(i: int):
    out 2 * i + 2
end.
func _heap_swap of (T):
    in  h: Heap of (T)
        a: int
        b: int
    va = vec_get of (T)(h.items, a)
    vb = vec_get of (T)(h.items, b)
    vec_set of (T)(&h.items, a, vb)
    vec_set of (T)(&h.items, b, va)
end.
func _sift_up of (T)(h: Heap of (T), idx: int):
    i = idx
    when i > 0 loop
        p = _parent(i)
        if h.cmp(vec_get of (T)(h.items, i), vec_get of (T)(h.items, p)) < 0 do
            _heap_swap of (T)(h, i, p)
            i = p
        else
            break
        end
    end
end.
func _sift_down of (T)(h: Heap of (T), idx: int):
    n = vec_len of (T)(h.items)
    i = idx
    loop
        smallest = i
        l = _left(i)
        r = _right(i)
        
        if l < n and h.cmp(vec_get of (T)(h.items, l), vec_get of (T)(h.items, smallest)) < 0 do
            smallest = l
        end
        if r < n and h.cmp(vec_get of (T)(h.items, r), vec_get of (T)(h.items, smallest)) < 0 do
            smallest = r
        end
        
        if smallest == i do break end
        _heap_swap of (T)(h, i, smallest)
        i = smallest
    end
end.
# ─── Constructor ──────────────────────────────────────

func heap_new of (T)(cmp: func(T, T) -> int):
    out Heap of (T) ( items = vec_new of (T)(), cmp = cmp )
end.
func heap_from_vec of (T)(v: Vec of (T), cmp: func(T, T) -> int):
    # Xây heap từ vector O(n) — heapify.
    h = Heap of (T) ( items = v, cmp = cmp )
    n = vec_len of (T)(h.items)
    if n <= 1 do out h end
    i = n / 2
    loop
        _sift_down of (T)(&h, i)
        if i == 0 do break end
        i = i - 1
    end
    out h
end.
# ─── Operations ───────────────────────────────────────

func heap_push of (T)(h: Heap of (T), val: T):
    vec_push of (T)(&h.items, val)
    _sift_up of (T)(h, vec_len of (T)(h.items) - 1)
end.
func heap_pop of (T)(h: Heap of (T)):
    n = vec_len of (T)(h.items)
    if n == 0 do out None end
    if n == 1 do out vec_pop of (T)(&h.items) end
    
    # Swap root với element cuối, rồi sift down
    _heap_swap of (T)(h, 0, n - 1)
    val = vec_pop of (T)(&h.items)
    _sift_down of (T)(h, 0)
    out val
end.
func heap_peek of (T)(h: Heap of (T)):
    if vec_is_empty of (T)(h.items) do out None end
    out Some(vec_get of (T)(h.items, 0))
end.
func heap_len of (T)(h: Heap of (T)):
    out vec_len of (T)(h.items)
end.
func heap_is_empty of (T)(h: Heap of (T)):
    out vec_is_empty of (T)(h.items)
end.
func heap_clear of (T)(h: Heap of (T)):
    vec_clear of (T)(&h.items)
end.
func heap_free of (T)(h: Heap of (T)):
    vec_free of (T)(&h.items)
end.
# ─── Tiện ích ─────────────────────────────────────────

func cmp_i64_asc(a: int, b: int):
    if a < b do out -1 end
    if a > b do out 1 end
    out 0
end.
func cmp_i64_desc(a: int, b: int):
    if a > b do out -1 end
    if a < b do out 1 end
    out 0
end.