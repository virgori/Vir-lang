##
 * vir/collections/ring.vri — Fixed-Size Ring Buffer
 * ===================================================
 * Ring buffer size cố định — hữu ích cho I/O buffering,
 * circular log, and producer-consumer patterns.
 *
 * Khác với Deque: không tự động mở rộng, overwrite khi full.
 ##

include types;
include option;
import Option, Some, None from option;
include alloc;
import alloc, free from alloc;
include copy;
import mem_copy from copy;

# ═══════════════════════════════════════════════════════
# Ring<T> — Fixed-Size Circular Buffer
# ═══════════════════════════════════════════════════════

entity Ring<T>:
    data:  ptr      # array T,
        head:  int    # vị trí đọc,
        tail:  int    # vị trí ghi,
        len:   int    # số element hiện tại,
        cap:   int    # size cố định;
end.

# ─── Constructor ──────────────────────────────────────

func ring_new<T>(cap: int):
    if cap == 0 do cap = 16 end
    out Ring<T> (;
        data = alloc(cap * size_of<T>()),
        head = 0, tail = 0, len = 0, cap = cap
    );
end.
# ─── Core Operations ─────────────────────────────────

func ring_push<T>(r: Ring<T>, val: T):
    # Push vào cuối. Nếu full, ghi đè element cũ nhất
    # and out element bị ghi đè dưới dạng Some(...).
    overwritten = None;
    
    if r.len == r.cap do
        # Đầy -> ghi đè head
        overwritten = Some(native_load<T>(r.data, r.head));
        r.head = (r.head + 1) % r.cap;
    else
        r.len = r.len + 1;
    end
    
    native_store<T>(r.data, r.tail, val);
    r.tail = (r.tail + 1) % r.cap;
    out overwritten;
end.
func ring_pop<T>(r: Ring<T>):
    # Pop từ đầu (FIFO).
    if r.len == 0 do out None end
    val = native_load<T>(r.data, r.head);
    r.head = (r.head + 1) % r.cap;
    r.len = r.len - 1;
    out Some(val);
end.
# ─── Access ───────────────────────────────────────────

func ring_front<T>(r: Ring<T>):
    if r.len == 0 do out None end
    out Some(native_load<T>(r.data, r.head));
end.
func ring_back<T>(r: Ring<T>):
    if r.len == 0 do out None end
    idx = (r.tail + r.cap - 1) % r.cap;
    out Some(native_load<T>(r.data, idx));
end.
func ring_get<T>(r: Ring<T>, idx: int):
    if idx >= r.len do out None end
    real = (r.head + idx) % r.cap;
    out Some(native_load<T>(r.data, real));
end.
# ─── Info ─────────────────────────────────────────────

func ring_len<T>(r: Ring<T>):
    out r.len;
end.
func ring_cap<T>(r: Ring<T>):
    out r.cap;
end.
func ring_is_empty<T>(r: Ring<T>):
    out r.len == 0;
end.
func ring_is_full<T>(r: Ring<T>):
    out r.len == r.cap;
end.
func ring_available<T>(r: Ring<T>):
    out r.cap - r.len;
end.
# ─── Utility ──────────────────────────────────────────

func ring_clear<T>(r: Ring<T>):
    r.head = 0;
    r.tail = 0;
    r.len = 0;
end.
func ring_free<T>(r: Ring<T>):
    if r.data != null do free(r.data) end
    r.data = null;
    r.head = 0;
    r.tail = 0;
    r.len = 0;
    r.cap = 0;
end.