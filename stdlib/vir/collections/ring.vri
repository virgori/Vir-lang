##
 * vir/collections/ring.vri — Fixed-Size Ring Buffer
 * ===================================================
 * Ring buffer size cố định — hữu ích cho I/O buffering,
 * circular log, and producer-consumer patterns.
 *
 * Khác với Deque: không tự động mở rộng, overwrite khi full.
 ##

include types
include option
import Option, Some, None from option
include alloc
import alloc, free from alloc
include copy
import mem_copy from copy

# ═══════════════════════════════════════════════════════
# Ring of (T) — Fixed-Size Circular Buffer
# ═══════════════════════════════════════════════════════

entity Ring of (T):
    data:  ptr      # array T,
        head:  int    # vị trí đọc,
        tail:  int    # vị trí ghi,
        len:   int    # số element hiện tại,
        cap:   int    # size cố định
end.

# ─── Constructor ──────────────────────────────────────

func ring_new of (T)(cap: int):
    if cap == 0 do cap = 16 end
    out Ring of (T) (
        data = alloc(cap * size_of of (T)()),
        head = 0, tail = 0, len = 0, cap = cap
    )
end.
# ─── Core Operations ─────────────────────────────────

func ring_push of (T)(r: Ring of (T), val: T):
    # Push vào cuối. Nếu full, ghi đè element cũ nhất
    # and out element bị ghi đè dưới dạng Some(...).
    overwritten = None
    
    if r.len == r.cap do
        # Đầy -> ghi đè head
        overwritten = Some(native_load of (T)(r.data, r.head))
        r.head = (r.head + 1) % r.cap
    else
        r.len = r.len + 1
    end
    
    native_store of (T)(r.data, r.tail, val)
    r.tail = (r.tail + 1) % r.cap
    out overwritten
end.
func ring_pop of (T)(r: Ring of (T)):
    # Pop từ đầu (FIFO).
    if r.len == 0 do out None end
    val = native_load of (T)(r.data, r.head)
    r.head = (r.head + 1) % r.cap
    r.len = r.len - 1
    out Some(val)
end.
# ─── Access ───────────────────────────────────────────

func ring_front of (T)(r: Ring of (T)):
    if r.len == 0 do out None end
    out Some(native_load of (T)(r.data, r.head))
end.
func ring_back of (T)(r: Ring of (T)):
    if r.len == 0 do out None end
    idx = (r.tail + r.cap - 1) % r.cap
    out Some(native_load of (T)(r.data, idx))
end.
func ring_get of (T)(r: Ring of (T), idx: int):
    if idx >= r.len do out None end
    real = (r.head + idx) % r.cap
    out Some(native_load of (T)(r.data, real))
end.
# ─── Info ─────────────────────────────────────────────

func ring_len of (T)(r: Ring of (T)):
    out r.len
end.
func ring_cap of (T)(r: Ring of (T)):
    out r.cap
end.
func ring_is_empty of (T)(r: Ring of (T)):
    out r.len == 0
end.
func ring_is_full of (T)(r: Ring of (T)):
    out r.len == r.cap
end.
func ring_available of (T)(r: Ring of (T)):
    out r.cap - r.len
end.
# ─── Utility ──────────────────────────────────────────

func ring_clear of (T)(r: Ring of (T)):
    r.head = 0
    r.tail = 0
    r.len = 0
end.
func ring_free of (T)(r: Ring of (T)):
    if r.data != null do free(r.data) end
    r.data = null
    r.head = 0
    r.tail = 0
    r.len = 0
    r.cap = 0
end.