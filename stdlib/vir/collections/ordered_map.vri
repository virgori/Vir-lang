##
 * vir/collections/ordered_map.vri — Insertion-Ordered Map
 * ========================================================
 * Inspired by Rust: indexmap crate
 * Inspired by Python: dict (3.7+ insertion ordered)
 * Inspired by Go: wk8/go-ordered-map
 *
 * Phase C — Tier 3: Map that preserves insertion order.
 * Backed by a hash map + Vec for ordering.
 * Supports iteration in insertion order.
 ##

include types;
include option;
import Option, Some, None, is_some, is_none, unwrap from option;
include vec;
import Vec, vec_new, vec_push, vec_get, vec_set, vec_len from vec;
include map;
import Map, map_new, map_insert, map_get, map_remove, map_keys,
       native_hash_i64, native_hash_str from map;

# ═══════════════════════════════════════════════════════
# KeyValue pair
# ═══════════════════════════════════════════════════════

entity OrdEntry:
    key:   int,
        value: int,
        alive: bool;     # tombstone for removal
end.

# ═══════════════════════════════════════════════════════
# Ordered Map (integer keys)
# ═══════════════════════════════════════════════════════

func _eq_int(a: int, b: int):
    out a == b;
end.
entity OrderedMap:
    index:    Map;        # key -> position in entries
    entries:  Vec;        # Vec<OrdEntry> in insertion order
    size:     int,
        dead:     int;        # tombstone count
end.
func ordered_map_new():
    out OrderedMap (
        index: map_new(native_hash_i64, _eq_int),
        entries: vec_new(),
        size: 0,
        dead: 0
    );
end.
# ─── Insert / Update ───────────────────────────────

func ordered_map_insert:
    in  m: OrderedMap;
        key: int;
        value: int
    opt = map_get(m.index, key);
    if is_some(opt) do
        # Update existing
        pos = unwrap(opt);
        entry = vec_get(m.entries, pos);
        entry.value = value;
        entry.alive = true;
    else
        # New entry at end
        pos = vec_len(m.entries);
        vec_push(m.entries, OrdEntry ( key: key, value: value, alive: true ));
        map_insert(m.index, key, pos);
        m.size = m.size + 1;
    end
end.
# ─── Get ────────────────────────────────────────────

func ordered_map_get(m: OrderedMap, key: int):
    opt = map_get(m.index, key);
    if is_none(opt) do out None end
    pos = unwrap(opt);
    entry = vec_get(m.entries, pos);
    if not entry.alive do out None end
    out Some(entry.value);
end.
func ordered_map_contains(m: OrderedMap, key: int):
    out is_some(ordered_map_get(m, key));
end.
# ─── Remove ─────────────────────────────────────────

func ordered_map_remove(m: OrderedMap, key: int):
    opt = map_get(m.index, key);
    if is_none(opt) do out false end
    pos = unwrap(opt);
    entry = vec_get(m.entries, pos);
    if not entry.alive do out false end
    entry.alive = false;
    map_remove(m.index, key);
    m.size = m.size - 1;
    m.dead = m.dead + 1;

    # Compact if more than half are dead
    if m.dead > m.size and m.dead > 16 do
        _ordered_map_compact(m);
    end
    out true;
end.
func _ordered_map_compact(m: OrderedMap):
    new_entries = vec_new();
    new_index = map_new(native_hash_i64, _eq_int);
    i = 0;
    when i < vec_len(m.entries) loop
        entry = vec_get(m.entries, i);
        if entry.alive do
            new_pos = vec_len(new_entries);
            vec_push(new_entries, entry);
            map_insert(new_index, entry.key, new_pos);
        end
        i = i + 1;
    end
    m.entries = new_entries;
    m.index = new_index;
    m.dead = 0;
end.
# ─── Size ───────────────────────────────────────────

func ordered_map_len(m: OrderedMap):
    out m.size;
end.
func ordered_map_is_empty(m: OrderedMap):
    out m.size == 0;
end.
# ─── Iteration (insertion order) ────────────────────

func ordered_map_keys(m: OrderedMap):
    result = vec_new();
    i = 0;
    when i < vec_len(m.entries) loop
        entry = vec_get(m.entries, i);
        if entry.alive do
            vec_push(result, entry.key);
        end
        i = i + 1;
    end
    out result;
end.
func ordered_map_values(m: OrderedMap):
    result = vec_new();
    i = 0;
    when i < vec_len(m.entries) loop
        entry = vec_get(m.entries, i);
        if entry.alive do
            vec_push(result, entry.value);
        end
        i = i + 1;
    end
    out result;
end.
# ─── Index-based access (by insertion position) ─────

func ordered_map_get_index(m: OrderedMap, idx: int):
    # Skip dead entries to find nth alive entry
    count = 0;
    i = 0;
    when i < vec_len(m.entries) loop
        entry = vec_get(m.entries, i);
        if entry.alive do
            if count == idx do
                out Some(entry.key);
            end
            count = count + 1;
        end
        i = i + 1;
    end
    out None;
end.
func ordered_map_first(m: OrderedMap):
    out ordered_map_get_index(m, 0);
end.
func ordered_map_last(m: OrderedMap):
    if m.size == 0 do out None end
    out ordered_map_get_index(m, m.size - 1);
end.
# ─── Clear ──────────────────────────────────────────

func ordered_map_clear(m: OrderedMap):
    m.entries = vec_new();
    m.index = map_new(native_hash_i64, _eq_int);
    m.size = 0;
    m.dead = 0;
end.
# ═══════════════════════════════════════════════════════
# String-keyed Ordered Map
# ═══════════════════════════════════════════════════════

entity OrdStrEntry:
    key:   string,
        value: int,
        alive: bool;
end.
func _str_eq(a: string, b: string):
    out a == b;
end.
entity OrderedStrMap:
    index:    Map,
        entries:  Vec,
        size:     int,
        dead:     int;
end.
func ordered_str_map_new():
    out OrderedStrMap (
        index: map_new(native_hash_str, _str_eq),
        entries: vec_new(),
        size: 0,
        dead: 0
    );
end.
func ordered_str_map_insert:
    in  m: OrderedStrMap;
        key: string;
        value: int
    opt = map_get(m.index, key);
    if is_some(opt) do
        pos = unwrap(opt);
        entry = vec_get(m.entries, pos);
        entry.value = value;
        entry.alive = true;
    else
        pos = vec_len(m.entries);
        vec_push(m.entries, OrdStrEntry ( key: key, value: value, alive: true ));
        map_insert(m.index, key, pos);
        m.size = m.size + 1;
    end
end.
func ordered_str_map_get(m: OrderedStrMap, key: string):
    opt = map_get(m.index, key);
    if is_none(opt) do out None end
    pos = unwrap(opt);
    entry = vec_get(m.entries, pos);
    if not entry.alive do out None end
    out Some(entry.value);
end.
func ordered_str_map_remove(m: OrderedStrMap, key: string):
    opt = map_get(m.index, key);
    if is_none(opt) do out false end
    pos = unwrap(opt);
    entry = vec_get(m.entries, pos);
    if not entry.alive do out false end
    entry.alive = false;
    map_remove(m.index, key);
    m.size = m.size - 1;
    m.dead = m.dead + 1;
    out true;
end.
func ordered_str_map_keys(m: OrderedStrMap):
    result = vec_new();
    i = 0;
    when i < vec_len(m.entries) loop
        entry = vec_get(m.entries, i);
        if entry.alive do
            vec_push(result, entry.key);
        end
        i = i + 1;
    end
    out result;
end.
func ordered_str_map_len(m: OrderedStrMap):
    out m.size;
end.