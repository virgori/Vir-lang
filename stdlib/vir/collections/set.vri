/*
 * vir/collections/set.vri — Hash Set
 * =====================================
 * Inspired by Python: set, frozenset
 * Triển khai: wrapper trên Map<K, void>
 *
 * Dùng cho: unique symbol tracking, keyword sets, visited nodes.
 */

import "vir/core/types" use all
import "vir/core/option" use Option, Some, None
import "vir/collections/map" use Map, map_new, map_with_cap, map_insert, map_contains, map_remove, map_keys, map_len, map_is_empty, map_clear, map_free
import "vir/collections/vec" use Vec, vec_new, vec_push, vec_len, vec_get

# ═══════════════════════════════════════════════════════
# Set<T> — Hash Set
# ═══════════════════════════════════════════════════════

entity Set<T>
    inner: Map<T, bool>   # value luôn là true
end

func set_new<T>(hash_fn: func(T) -> u64, eq_fn: func(T, T) -> bool) -> Set<T>
    out Set<T> { inner = map_new<T, bool>(hash_fn, eq_fn) }
end

func set_with_cap<T>(cap: usize, hash_fn: func(T) -> u64, eq_fn: func(T, T) -> bool) -> Set<T>
    out Set<T> { inner = map_with_cap<T, bool>(cap, hash_fn, eq_fn) }
end

# ─── Core Operations ─────────────────────────────────

func set_insert<T>(s: &Set<T>, val: T) -> bool
    # Returns true if val chưa có (mới thêm).
    var old = map_insert<T, bool>(&s.inner, val, true)
    out is_none(old)
end

func set_remove<T>(s: &Set<T>, val: T) -> bool
    var old = map_remove<T, bool>(&s.inner, val)
    out is_some(old)
end

func set_contains<T>(s: Set<T>, val: T) -> bool
    out map_contains<T, bool>(s.inner, val)
end

# ─── Info ─────────────────────────────────────────────

func set_len<T>(s: Set<T>) -> usize
    out map_len<T, bool>(s.inner)
end

func set_is_empty<T>(s: Set<T>) -> bool
    out map_is_empty<T, bool>(s.inner)
end

# ─── Iteration ────────────────────────────────────────

func set_to_vec<T>(s: Set<T>) -> Vec<T>
    out map_keys<T, bool>(s.inner)
end

# ─── Set Operations ───────────────────────────────────

func set_union<T>(a: Set<T>, b: Set<T>, hash_fn: func(T) -> u64, eq_fn: func(T, T) -> bool) -> Set<T>
    # A ∪ B
    var result = set_new<T>(hash_fn, eq_fn)
    var va = set_to_vec<T>(a)
    var i: usize = 0
    lặp_khi i < vec_len<T>(va)
        set_insert<T>(&result, vec_get<T>(va, i))
        i = i + 1
    end
    var vb = set_to_vec<T>(b)
    i = 0
    lặp_khi i < vec_len<T>(vb)
        set_insert<T>(&result, vec_get<T>(vb, i))
        i = i + 1
    end
    out result
end

func set_intersection<T>(a: Set<T>, b: Set<T>, hash_fn: func(T) -> u64, eq_fn: func(T, T) -> bool) -> Set<T>
    # A ∩ B
    var result = set_new<T>(hash_fn, eq_fn)
    var va = set_to_vec<T>(a)
    var i: usize = 0
    lặp_khi i < vec_len<T>(va)
        var elem = vec_get<T>(va, i)
        if set_contains<T>(b, elem)
            set_insert<T>(&result, elem)
        end
        i = i + 1
    end
    out result
end

func set_difference<T>(a: Set<T>, b: Set<T>, hash_fn: func(T) -> u64, eq_fn: func(T, T) -> bool) -> Set<T>
    # A \ B
    var result = set_new<T>(hash_fn, eq_fn)
    var va = set_to_vec<T>(a)
    var i: usize = 0
    lặp_khi i < vec_len<T>(va)
        var elem = vec_get<T>(va, i)
        if !set_contains<T>(b, elem)
            set_insert<T>(&result, elem)
        end
        i = i + 1
    end
    out result
end

func set_symmetric_difference<T>(a: Set<T>, b: Set<T>, hash_fn: func(T) -> u64, eq_fn: func(T, T) -> bool) -> Set<T>
    # A △ B = (A \ B) ∪ (B \ A)
    var result = set_new<T>(hash_fn, eq_fn)
    var va = set_to_vec<T>(a)
    var i: usize = 0
    lặp_khi i < vec_len<T>(va)
        var elem = vec_get<T>(va, i)
        if !set_contains<T>(b, elem)
            set_insert<T>(&result, elem)
        end
        i = i + 1
    end
    var vb = set_to_vec<T>(b)
    i = 0
    lặp_khi i < vec_len<T>(vb)
        var elem = vec_get<T>(vb, i)
        if !set_contains<T>(a, elem)
            set_insert<T>(&result, elem)
        end
        i = i + 1
    end
    out result
end

func set_is_subset<T>(a: Set<T>, b: Set<T>) -> bool
    var va = set_to_vec<T>(a)
    var i: usize = 0
    lặp_khi i < vec_len<T>(va)
        if !set_contains<T>(b, vec_get<T>(va, i)) out false end
        i = i + 1
    end
    out true
end

func set_is_superset<T>(a: Set<T>, b: Set<T>) -> bool
    out set_is_subset<T>(b, a)
end

# ─── Utility ──────────────────────────────────────────

func set_clear<T>(s: &Set<T>)
    map_clear<T, bool>(&s.inner)
end

func set_free<T>(s: &Set<T>)
    map_free<T, bool>(&s.inner)
end
