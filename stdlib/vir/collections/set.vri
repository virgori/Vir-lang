##
 * vir/collections/set.vri — Hash Set
 * =====================================
 * Inspired by Python: set, frozenset
 * Triển khai: wrapper trên Map of (K, void)
 *
 * Dùng cho: unique symbol tracking, keyword sets, visited nodes.
 ##

include types
include option
import Option, Some, None from option
include map
import Map, map_new, map_with_cap, map_insert, map_contains, map_remove, map_keys, map_len, map_is_empty, map_clear, map_free from map
include vec
import Vec, vec_new, vec_push, vec_len, vec_get from vec

# ═══════════════════════════════════════════════════════
# Set of (T) — Hash Set
# ═══════════════════════════════════════════════════════

entity Set of (T):
    inner: Map of (T, bool)   # value luôn là true
end.
func set_new of (T)(hash_fn: func(T) -> int, eq_fn: func(T, T) -> bool):
    out Set of (T) ( inner = map_new of (T, bool)(hash_fn, eq_fn) )
end.
func set_with_cap of (T)(cap: int, hash_fn: func(T) -> int, eq_fn: func(T, T) -> bool):
    out Set of (T) ( inner = map_with_cap of (T, bool)(cap, hash_fn, eq_fn) )
end.
# ─── Core Operations ─────────────────────────────────

func set_insert of (T)(s: Set of (T), val: T):
    # Returns true if val chưa có (mới thêm).
    old = map_insert of (T, bool)(&s.inner, val, true)
    out is_none(old)
end.
func set_remove of (T)(s: Set of (T), val: T):
    old = map_remove of (T, bool)(&s.inner, val)
    out is_some(old)
end.
func set_contains of (T)(s: Set of (T), val: T):
    out map_contains of (T, bool)(s.inner, val)
end.
# ─── Info ─────────────────────────────────────────────

func set_len of (T)(s: Set of (T)):
    out map_len of (T, bool)(s.inner)
end.
func set_is_empty of (T)(s: Set of (T)):
    out map_is_empty of (T, bool)(s.inner)
end.
# ─── Iteration ────────────────────────────────────────

func set_to_vec of (T)(s: Set of (T)):
    out map_keys of (T, bool)(s.inner)
end.
# ─── Set Operations ───────────────────────────────────

func set_union of (T):
    in  a: Set of (T)
        b: Set of (T)
        hash_fn: func(T) -> int
        eq_fn: func(T, T) -> bool
    # A ∪ B
    result = set_new of (T)(hash_fn, eq_fn)
    va = set_to_vec of (T)(a)
    i = 0
    when i < vec_len of (T)(va) loop
        set_insert of (T)(&result, vec_get of (T)(va, i))
        i = i + 1
    end
    vb = set_to_vec of (T)(b)
    i = 0
    when i < vec_len of (T)(vb) loop
        set_insert of (T)(&result, vec_get of (T)(vb, i))
        i = i + 1
    end
    out result
end.
func set_intersection of (T):
    in  a: Set of (T)
        b: Set of (T)
        hash_fn: func(T) -> int
        eq_fn: func(T, T) -> bool
    # A ∩ B
    result = set_new of (T)(hash_fn, eq_fn)
    va = set_to_vec of (T)(a)
    i = 0
    when i < vec_len of (T)(va) loop
        elem = vec_get of (T)(va, i)
        if set_contains of (T)(b, elem) do
            set_insert of (T)(&result, elem)
        end
        i = i + 1
    end
    out result
end.
func set_difference of (T):
    in  a: Set of (T)
        b: Set of (T)
        hash_fn: func(T) -> int
        eq_fn: func(T, T) -> bool
    # A \ B
    result = set_new of (T)(hash_fn, eq_fn)
    va = set_to_vec of (T)(a)
    i = 0
    when i < vec_len of (T)(va) loop
        elem = vec_get of (T)(va, i)
        if !set_contains of (T)(b, elem) do
            set_insert of (T)(&result, elem)
        end
        i = i + 1
    end
    out result
end.
func set_symmetric_difference of (T):
    in  a: Set of (T)
        b: Set of (T)
        hash_fn: func(T) -> int
        eq_fn: func(T, T) -> bool
    # A △ B = (A \ B) ∪ (B \ A)
    result = set_new of (T)(hash_fn, eq_fn)
    va = set_to_vec of (T)(a)
    i = 0
    when i < vec_len of (T)(va) loop
        elem = vec_get of (T)(va, i)
        if !set_contains of (T)(b, elem) do
            set_insert of (T)(&result, elem)
        end
        i = i + 1
    end
    vb = set_to_vec of (T)(b)
    i = 0
    when i < vec_len of (T)(vb) loop
        elem = vec_get of (T)(vb, i)
        if !set_contains of (T)(a, elem) do
            set_insert of (T)(&result, elem)
        end
        i = i + 1
    end
    out result
end.
func set_is_subset of (T)(a: Set of (T), b: Set of (T)):
    va = set_to_vec of (T)(a)
    i = 0
    when i < vec_len of (T)(va) loop
        if !set_contains of (T)(b, vec_get of (T)(va, i)) do out false end
        i = i + 1
    end
    out true
end.
func set_is_superset of (T)(a: Set of (T), b: Set of (T)):
    out set_is_subset of (T)(b, a)
end.
# ─── Utility ──────────────────────────────────────────

func set_clear of (T)(s: Set of (T)):
    map_clear of (T, bool)(&s.inner)
end.
func set_free of (T)(s: Set of (T)):
    map_free of (T, bool)(&s.inner)
end.