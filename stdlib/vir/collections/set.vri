##
 * vir/collections/set.vri — Hash Set
 * =====================================
 * Inspired by Python: set, frozenset
 * Triển khai: wrapper trên Map<K, void>
 *
 * Dùng cho: unique symbol tracking, keyword sets, visited nodes.
 ##

include types;
include option;
import Option, Some, None from option;
include map;
import Map, map_new, map_with_cap, map_insert, map_contains, map_remove, map_keys, map_len, map_is_empty, map_clear, map_free from map;
include vec;
import Vec, vec_new, vec_push, vec_len, vec_get from vec;

# ═══════════════════════════════════════════════════════
# Set<T> — Hash Set
# ═══════════════════════════════════════════════════════

entity Set<T>:
    inner: Map<T, bool>   # value luôn là true;
end
func set_new<T>:
    in(hash_fn:func(T)
    out Set<T> ( inner = map_new<T, bool>(hash_fn, eq_fn) );
end
func set_with_cap<T>:
    in(cap:int; hash_fn:func(T)
    out Set<T> ( inner = map_with_cap<T, bool>(cap, hash_fn, eq_fn) );
end
# ─── Core Operations ─────────────────────────────────

func set_insert<T>:
    in(s:Set<T>; val:T)
    # Returns true if val chưa có (mới thêm).
    old = map_insert<T, bool>(&s.inner, val, true);
    out is_none(old);
end
func set_remove<T>:
    in(s:Set<T>; val:T)
    old = map_remove<T, bool>(&s.inner, val);
    out is_some(old);
end
func set_contains<T>:
    in(s:Set<T>; val:T)
    out map_contains<T, bool>(s.inner, val);
end
# ─── Info ─────────────────────────────────────────────

func set_len<T>:
    in(s:Set<T>)
    out map_len<T, bool>(s.inner);
end
func set_is_empty<T>:
    in(s:Set<T>)
    out map_is_empty<T, bool>(s.inner);
end
# ─── Iteration ────────────────────────────────────────

func set_to_vec<T>:
    in(s:Set<T>)
    out map_keys<T, bool>(s.inner);
end
# ─── Set Operations ───────────────────────────────────

func set_union<T>:
    in(a:Set<T>; b:Set<T>; hash_fn:func(T)
    # A ∪ B
    result = set_new<T>(hash_fn, eq_fn);
    va = set_to_vec<T>(a);
    i = 0;
    when i < vec_len<T>(va) loop
        set_insert<T>(&result, vec_get<T>(va, i));
        i = i + 1;
    end
    vb = set_to_vec<T>(b);
    i = 0;
    when i < vec_len<T>(vb) loop
        set_insert<T>(&result, vec_get<T>(vb, i));
        i = i + 1;
    end
    out result;
end
func set_intersection<T>:
    in(a:Set<T>; b:Set<T>; hash_fn:func(T)
    # A ∩ B
    result = set_new<T>(hash_fn, eq_fn);
    va = set_to_vec<T>(a);
    i = 0;
    when i < vec_len<T>(va) loop
        elem = vec_get<T>(va, i);
        if set_contains<T>(b, elem) do
            set_insert<T>(&result, elem);
        end
        i = i + 1;
    end
    out result;
end
func set_difference<T>:
    in(a:Set<T>; b:Set<T>; hash_fn:func(T)
    # A \ B
    result = set_new<T>(hash_fn, eq_fn);
    va = set_to_vec<T>(a);
    i = 0;
    when i < vec_len<T>(va) loop
        elem = vec_get<T>(va, i);
        if !set_contains<T>(b, elem) do
            set_insert<T>(&result, elem);
        end
        i = i + 1;
    end
    out result;
end
func set_symmetric_difference<T>:
    in(a:Set<T>; b:Set<T>; hash_fn:func(T)
    # A △ B = (A \ B) ∪ (B \ A)
    result = set_new<T>(hash_fn, eq_fn);
    va = set_to_vec<T>(a);
    i = 0;
    when i < vec_len<T>(va) loop
        elem = vec_get<T>(va, i);
        if !set_contains<T>(b, elem) do
            set_insert<T>(&result, elem);
        end
        i = i + 1;
    end
    vb = set_to_vec<T>(b);
    i = 0;
    when i < vec_len<T>(vb) loop
        elem = vec_get<T>(vb, i);
        if !set_contains<T>(a, elem) do
            set_insert<T>(&result, elem);
        end
        i = i + 1;
    end
    out result;
end
func set_is_subset<T>:
    in(a:Set<T>; b:Set<T>)
    va = set_to_vec<T>(a);
    i = 0;
    when i < vec_len<T>(va) loop
        if !set_contains<T>(b, vec_get<T>(va, i)) do out false end
        i = i + 1;
    end
    out true;
end
func set_is_superset<T>:
    in(a:Set<T>; b:Set<T>)
    out set_is_subset<T>(b, a);
end
# ─── Utility ──────────────────────────────────────────

func set_clear<T>:
    in(s:Set<T>)
    map_clear<T, bool>(&s.inner);
end
func set_free<T>:
    in(s:Set<T>)
    map_free<T, bool>(&s.inner);
end