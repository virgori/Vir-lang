##
 * vir/collections/set.vri — Hash set (int keys via Map)
 ##

include types
include option
import Option, Some, None, is_none, is_some from option
include map
import Map, map_new, map_with_cap, map_insert, map_contains, map_remove, map_len, map_is_empty, map_clear, map_free, hash_i64, int_eq from map

entity Set:
    inner: Map
end.

func set_new(hash_fn: ptr, eq_fn: ptr):
    out Set ( inner: map_new(hash_fn, eq_fn) )
end.

func set_insert:
    ref s: Set
    in val: int
    old = map_insert(s.inner, val, 1)
    out is_none(old)
end.

func set_remove(s: Set, val: int):
    old = map_remove(s.inner, val)
    out is_some(old)
end.

func set_contains(s: Set, val: int):
    out map_contains(s.inner, val)
end.

func set_len(s: Set):
    out map_len(s.inner)
end.

func set_is_empty(s: Set):
    out map_is_empty(s.inner)
end.

func set_int():
    out Set ( inner: map_with_cap(16, hash_i64, int_eq) )
end.

func set_clear:
    ref s: Set
    map_clear(s.inner)
end.

func set_free:
    ref s: Set
    map_free(s.inner)
end.

export Set, set_new, set_insert, set_remove, set_contains, set_len, set_is_empty
export set_int, set_clear, set_free
