##
 * vir/collections/lru.vri — Least Recently Used Cache
 * ====================================================
 * Inspired by Rust: lru crate
 * Inspired by Python: functools.lru_cache
 *
 * Phase C — O(1) get/put LRU cache.
 * Backed by a Map and a doubly-linked list stored in parallel Vecs.
 ##

include types;
include option;
import Option, Some, None from option;
include map;
import Map, map_new, map_insert, map_get, map_remove, native_hash_i64 from map;
include vec;
import Vec, vec_new, vec_push, vec_get, vec_set, vec_len from vec;

# ═══════════════════════════════════════════════════════
# Internal doubly-linked list node (stored in Vec slots)
# ═══════════════════════════════════════════════════════

entity _LruEntry:
    key:    int,
        value:  int,
        prev:   int;     # index or -1 for sentinel
    next:   int;     # index or -1 for sentinel
end

# ═══════════════════════════════════════════════════════
# LRU Cache
# ═══════════════════════════════════════════════════════

entity LruCache:
    capacity: int,
        size:     int,
        entries:  Vec;       # Vec of _LruEntry
    index:    Map;       # key -> slot index
    head:     int;       # most-recently-used slot, -1 if empty
    tail:     int;       # least-recently-used slot, -1 if empty
end.

func _eq_int:
    in(a: int; b: int)
    out a == b;
end.

func lru_new:
    in(cap: int)
    out LruCache {
        capacity: cap,
        size: 0,
        entries: vec_new(),
        index: map_new(native_hash_i64, _eq_int),
        head: -1,
        tail: -1
    };
end

# ─── Internal: unlink a node from the DLL ────────────

func _lru_unlink:
    in(cache: LruCache; slot: int)
    entry = vec_get(cache.entries, slot);
    p = entry.prev;
    n = entry.next;

    if p >= 0 do
        prev_entry = vec_get(cache.entries, p);
        prev_entry.next = n;
    else
        cache.head = n;
    end

    if n >= 0 do
        next_entry = vec_get(cache.entries, n);
        next_entry.prev = p;
    else
        cache.tail = p;
    end
end

# ─── Internal: push node to front (MRU position) ─────

func _lru_push_front:
    in(cache: LruCache; slot: int)
    entry = vec_get(cache.entries, slot);
    entry.prev = -1;
    entry.next = cache.head;

    if cache.head >= 0 do
        old_head = vec_get(cache.entries, cache.head);
        old_head.prev = slot;
    end

    cache.head = slot;
    if cache.tail < 0 do
        cache.tail = slot;
    end
end

# ─── Get — returns Option ───────────────────────────

func lru_get:
    in(cache: LruCache; key: int)
    opt = map_get(cache.index, key);
    if is_none(opt) do out None end

    slot = unwrap(opt);
    # Move to front
    _lru_unlink(cache, slot);
    _lru_push_front(cache, slot);

    entry = vec_get(cache.entries, slot);
    out Some(entry.value);
end

# ─── Put — insert or update, evicts LRU if full ─────

func lru_put:
    in(cache: LruCache; key: int; value: int)

    opt = map_get(cache.index, key);
    if is_some(opt) do
        # Update existing entry
        slot = unwrap(opt);
        entry = vec_get(cache.entries, slot);
        entry.value = value;
        _lru_unlink(cache, slot);
        _lru_push_front(cache, slot);
        out;
    end

    # Evict LRU if at capacity
    if cache.size >= cache.capacity do
        evict_slot = cache.tail;
        evict_entry = vec_get(cache.entries, evict_slot);
        map_remove(cache.index, evict_entry.key);
        _lru_unlink(cache, evict_slot);

        # Reuse evict slot
        evict_entry.key = key;
        evict_entry.value = value;
        map_insert(cache.index, key, evict_slot);
        _lru_push_front(cache, evict_slot);
        out;
    end

    # Add new entry
    new_entry = _LruEntry {
        key: key,
        value: value,
        prev: -1,
        next: -1
    };
    slot = vec_len(cache.entries);
    vec_push(cache.entries, new_entry);
    map_insert(cache.index, key, slot);
    _lru_push_front(cache, slot);
    cache.size = cache.size + 1;
end

# ─── Remove ──────────────────────────────────────────

func lru_remove:
    in(cache: LruCache; key: int)
    opt = map_get(cache.index, key);
    if is_none(opt) do out None end

    slot = unwrap(opt);
    entry = vec_get(cache.entries, slot);
    val = entry.value;
    map_remove(cache.index, key);
    _lru_unlink(cache, slot);
    cache.size = cache.size - 1;
    out Some(val);
end

# ─── Contains ────────────────────────────────────────

func lru_contains:
    in(cache: LruCache; key: int)
    out is_some(map_get(cache.index, key));
end

# ─── Size / Capacity ────────────────────────────────

func lru_len:
    in(cache: LruCache)
    out cache.size;
end.

func lru_capacity:
    in(cache: LruCache)
    out cache.capacity;
end.

func lru_is_empty:
    in(cache: LruCache)
    out cache.size == 0;
end

# ─── Clear ───────────────────────────────────────────

func lru_clear:
    in(cache: LruCache)
    cache.size = 0;
    cache.head = -1;
    cache.tail = -1;
    cache.entries = vec_new();
    cache.index = map_new(native_hash_i64, _eq_int);
end

# ─── Peek (no promotion) ────────────────────────────

func lru_peek:
    in(cache: LruCache; key: int)
    opt = map_get(cache.index, key);
    if is_none(opt) do out None end
    slot = unwrap(opt);
    entry = vec_get(cache.entries, slot);
    out Some(entry.value);
end

# ─── Peek LRU (look at least recently used) ─────────

func lru_peek_lru:
    in(cache: LruCache)
    if cache.tail < 0 do out None end
    entry = vec_get(cache.entries, cache.tail);
    out Some(entry.key);
end
