##
 * vir/collections/trie.vri — Trie (Prefix Tree)
 * ================================================
 * Inspired by Rust: sequence_trie, prefix_tree crates
 * Inspired by Go: dghubble/trie
 * Inspired by Python: marisa-trie, pygtrie
 *
 * Phase C — Tier 2: String prefix tree for fast prefix lookups.
 * Supports insert, search, prefix match, autocomplete.
 * Backed by Map at each node for sparse child storage.
 ##

include types;
include option;
import Option, Some, None, is_some, is_none, unwrap from option;
include vec;
import Vec, vec_new, vec_push, vec_get, vec_len from vec;
include map;
import Map, map_new, map_insert, map_get, map_keys, native_hash_i64 from map;

# ═══════════════════════════════════════════════════════
# Trie Node
# ═══════════════════════════════════════════════════════

func _eq_int:
    in(a: int; b: int)
    out a == b;
end

entity TrieNode:
    children:  Map;       # byte -> TrieNode
    is_end:    bool;      # marks end of a word
    value:     Option;    # associated value (Option)
    depth:     int;
end

func _trie_node_new:
    in(d: int)
    out TrieNode {
        children: map_new(native_hash_i64, _eq_int),
        is_end: false,
        value: None,
        depth: d
    };
end

# ═══════════════════════════════════════════════════════
# Trie
# ═══════════════════════════════════════════════════════

entity Trie:
    root:  TrieNode;
    size:  int;
end

func trie_new:
    in()
    out Trie {
        root: _trie_node_new(0),
        size: 0
    };
end

# ─── Insert a word ──────────────────────────────────

func trie_insert:
    in(t: Trie; word: string)
    node = t.root;
    i = 0;
    when i < str_len(word) loop
        ch = str_byte_at(word, i);
        opt = map_get(node.children, ch);
        if is_none(opt):
            child = _trie_node_new(i + 1);
            map_insert(node.children, ch, child);
            node = child;
        else:
            node = unwrap(opt);
        end
        i = i + 1;
    end
    if not node.is_end:
        t.size = t.size + 1;
    end
    node.is_end = true;
end

# ─── Insert with associated value ───────────────────

func trie_insert_val:
    in(t: Trie; word: string; val: int)
    node = t.root;
    i = 0;
    when i < str_len(word) loop
        ch = str_byte_at(word, i);
        opt = map_get(node.children, ch);
        if is_none(opt):
            child = _trie_node_new(i + 1);
            map_insert(node.children, ch, child);
            node = child;
        else:
            node = unwrap(opt);
        end
        i = i + 1;
    end
    if not node.is_end:
        t.size = t.size + 1;
    end
    node.is_end = true;
    node.value = Some(val);
end

# ─── Search exact word ──────────────────────────────

func trie_contains:
    in(t: Trie; word: string)
    node = t.root;
    i = 0;
    found = true;
    when i < str_len(word) and found loop
        ch = str_byte_at(word, i);
        opt = map_get(node.children, ch);
        if is_none(opt):
            found = false;
        else:
            node = unwrap(opt);
        end
        i = i + 1;
    end
    if not found out false end:
    out node.is_end;
end

# ─── Get value for word ─────────────────────────────

func trie_get:
    in(t: Trie; word: string)
    node = t.root;
    i = 0;
    when i < str_len(word) loop
        ch = str_byte_at(word, i);
        opt = map_get(node.children, ch);
        if is_none(opt) out None end:
        node = unwrap(opt);
        i = i + 1;
    end
    if not node.is_end out None end:
    out node.value;
end

# ─── Check if any word starts with prefix ───────────

func trie_has_prefix:
    in(t: Trie; prefix: string)
    node = t.root;
    i = 0;
    when i < str_len(prefix) loop
        ch = str_byte_at(prefix, i);
        opt = map_get(node.children, ch);
        if is_none(opt) out false end:
        node = unwrap(opt);
        i = i + 1;
    end
    out true;
end

# ─── Find all words with given prefix ───────────────

include builder;
import StringBuilder, sb_new, sb_append, sb_append_byte, sb_build, sb_free from builder;

func trie_autocomplete:
    in(t: Trie; prefix: string; max_results: int)
    results = vec_new();

    # Navigate to prefix node
    node = t.root;
    i = 0;
    valid = true;
    when i < str_len(prefix) and valid loop
        ch = str_byte_at(prefix, i);
        opt = map_get(node.children, ch);
        if is_none(opt):
            valid = false;
        else:
            node = unwrap(opt);
        end
        i = i + 1;
    end

    if not valid out results end:

    # DFS to collect words
    _trie_collect(node, prefix, results, max_results);
    out results;
end

func _trie_collect:
    in(node: TrieNode; current: string; results: Vec; max_results: int)
    if vec_len(results) >= max_results out end:

    if node.is_end:
        vec_push(results, current);
    end

    keys = map_keys(node.children);
    i = 0;
    when i < vec_len(keys) and vec_len(results) < max_results loop
        ch = vec_get(keys, i);
        child = unwrap(map_get(node.children, ch));

        sb = sb_new();
        sb_append(sb, current);
        sb_append_byte(sb, ch);
        next_str = sb_build(sb);
        sb_free(sb);

        _trie_collect(child, next_str, results, max_results);
        i = i + 1;
    end
end

# ─── Count words with prefix ────────────────────────

func trie_count_prefix:
    in(t: Trie; prefix: string)
    node = t.root;
    i = 0;
    when i < str_len(prefix) loop
        ch = str_byte_at(prefix, i);
        opt = map_get(node.children, ch);
        if is_none(opt) out 0 end:
        node = unwrap(opt);
        i = i + 1;
    end
    out _trie_count_words(node);
end

func _trie_count_words:
    in(node: TrieNode)
    count = 0;
    if node.is_end:
        count = 1;
    end
    keys = map_keys(node.children);
    i = 0;
    when i < vec_len(keys) loop
        child = unwrap(map_get(node.children, vec_get(keys, i)));
        count = count + _trie_count_words(child);
        i = i + 1;
    end
    out count;
end

# ─── Longest prefix match ───────────────────────────

func trie_longest_prefix:
    in(t: Trie; word: string)
    node = t.root;
    last_match_len = -1;
    i = 0;
    when i < str_len(word) loop
        ch = str_byte_at(word, i);
        opt = map_get(node.children, ch);
        if is_none(opt):
            # Can't go further — use done flag
            i = str_len(word);
        else:
            node = unwrap(opt);
            if node.is_end:
                last_match_len = i + 1;
            end
            i = i + 1;
        end
    end

    if last_match_len < 0 out None end:

    sb = sb_new();
    j = 0;
    when j < last_match_len loop
        sb_append_byte(sb, str_byte_at(word, j));
        j = j + 1;
    end
    result = sb_build(sb);
    sb_free(sb);
    out Some(result);
end

# ─── Remove a word ──────────────────────────────────

func trie_remove:
    in(t: Trie; word: string)
    node = t.root;
    i = 0;
    when i < str_len(word) loop
        ch = str_byte_at(word, i);
        opt = map_get(node.children, ch);
        if is_none(opt) out false end:
        node = unwrap(opt);
        i = i + 1;
    end
    if not node.is_end out false end:
    node.is_end = false;
    node.value = None;
    t.size = t.size - 1;
    out true;
end

# ─── Size / Empty ───────────────────────────────────

func trie_len:
    in(t: Trie)
    out t.size;
end

func trie_is_empty:
    in(t: Trie)
    out t.size == 0;
end

# ─── Get all words ──────────────────────────────────

func trie_all_words:
    in(t: Trie)
    out trie_autocomplete(t, "", 1000000);
end
