##
 * vir/collections/bloom.vri — Bloom Filter
 * ==========================================
 * Inspired by Rust: bloomfilter, probabilistic-collections crates
 * Inspired by Go: willf/bloom
 * Inspired by Python: pybloom
 *
 * Phase C — Tier 2: Probabilistic set membership test.
 * Space-efficient data structure with configurable false positive rate.
 * No false negatives — if contains() returns false, the item is
 * definitely not in the set.
 ##

include types;
include vec;
import Vec, vec_new, vec_push, vec_get, vec_set, vec_len from vec;

# ═══════════════════════════════════════════════════════
# Bloom Filter
# ═══════════════════════════════════════════════════════

entity BloomFilter:
    bits:       Vec;     # Vec of int (bit array, packed in 64-bit words)
    num_bits:   int;     # total number of bits
    num_hashes: int;     # number of hash functions (k)
    count:      int;     # elements inserted
end

# ─── Create with explicit bit count & hash count ─────

func bloom_new:
    in(num_bits: int; num_hashes: int)
    # Allocate ceiling(num_bits / 64) words
    num_words = (num_bits + 63) / 64;
    bits = vec_new();
    i = 0;
    when i < num_words loop
        vec_push(bits, 0);
        i = i + 1;
    end
    out BloomFilter {
        bits: bits,
        num_bits: num_bits,
        num_hashes: num_hashes,
        count: 0
    };
end

# ─── Create from expected items & false positive rate ─

func bloom_optimal:
    in(expected_items: int; fp_rate_inv: int)
    # fp_rate = 1 / fp_rate_inv  (e.g. fp_rate_inv = 100 for 1%)
    # m = -n * ln(p) / (ln(2))^2
    # Approximation: m ≈ n * log2(fp_rate_inv) * 1.44
    # k ≈ (m / n) * ln(2) ≈ (m / n) * 0.693

    # Compute log2(fp_rate_inv) by repeated halving
    log2_fpr = 0;
    tmp = fp_rate_inv;
    when tmp > 1 loop
        tmp = tmp / 2;
        log2_fpr = log2_fpr + 1;
    end

    m = expected_items * log2_fpr * 144 / 100;
    if m < 64 do
        m = 64;
    end

    k = m * 693 / (expected_items * 1000);
    if k < 1 do
        k = 1;
    end
    if k > 20 do
        k = 20;
    end

    out bloom_new(m, k);
end

# ═══════════════════════════════════════════════════════
# Hash functions — double hashing scheme
# h_i(x) = h1(x) + i * h2(x)  mod m
# ═══════════════════════════════════════════════════════

func _bloom_hash1:
    in(key: int)
    # FNV-1a inspired
    h = 2166136261;
    h = h * 16777619;
    h = h + key;
    h = h * 16777619;
    h = h + key / 256;
    h = h * 16777619;
    h = h + key / 65536;
    if h < 0 do
        h = 0 - h;
    end
    out h;
end.

func _bloom_hash2:
    in(key: int)
    # Murmur-inspired
    h = key * 2654435761;
    h = h + 1013904223;
    h = h * 1103515245;
    if h < 0 do
        h = 0 - h;
    end
    out h;
end.

func _bloom_hash_str1:
    in(s: string)
    h = 2166136261;
    i = 0;
    when i < str_len(s) loop
        b = str_byte_at(s, i);
        h = h * 16777619;
        h = h + b;
        i = i + 1;
    end
    if h < 0 do
        h = 0 - h;
    end
    out h;
end.

func _bloom_hash_str2:
    in(s: string)
    h = 14695981039346656037;
    i = 0;
    when i < str_len(s) loop
        b = str_byte_at(s, i);
        h = h * 1099511628211;
        h = h + b;
        i = i + 1;
    end
    if h < 0 do
        h = 0 - h;
    end
    out h;
end

# ═══════════════════════════════════════════════════════
# Bit manipulation helpers
# ═══════════════════════════════════════════════════════

func _bloom_set_bit:
    in(bf: BloomFilter; bit_idx: int)
    word_idx = bit_idx / 64;
    bit_pos = bit_idx % 64;
    power = 1;
    j = 0;
    when j < bit_pos loop
        power = power * 2;
        j = j + 1;
    end
    old = vec_get(bf.bits, word_idx);
    # Set bit using OR (check if already set)
    # OR via: old | power = old + power - (old & power)
    # AND: old & power — check if bit is set
    has_bit = (old / power) % 2;
    if has_bit == 0 do
        vec_set(bf.bits, word_idx, old + power);
    end
end.

func _bloom_test_bit:
    in(bf: BloomFilter; bit_idx: int)
    word_idx = bit_idx / 64;
    bit_pos = bit_idx % 64;
    power = 1;
    j = 0;
    when j < bit_pos loop
        power = power * 2;
        j = j + 1;
    end
    val = vec_get(bf.bits, word_idx);
    out (val / power) % 2 == 1;
end

# ═══════════════════════════════════════════════════════
# Insert / Contains — integer keys
# ═══════════════════════════════════════════════════════

func bloom_insert:
    in(bf: BloomFilter; key: int)
    h1 = _bloom_hash1(key);
    h2 = _bloom_hash2(key);

    i = 0;
    when i < bf.num_hashes loop
        idx = (h1 + i * h2) % bf.num_bits;
        if idx < 0 do
            idx = 0 - idx;
        end
        _bloom_set_bit(bf, idx);
        i = i + 1;
    end
    bf.count = bf.count + 1;
end.

func bloom_contains:
    in(bf: BloomFilter; key: int)
    h1 = _bloom_hash1(key);
    h2 = _bloom_hash2(key);

    i = 0;
    when i < bf.num_hashes loop
        idx = (h1 + i * h2) % bf.num_bits;
        if idx < 0 do
            idx = 0 - idx;
        end
        if not _bloom_test_bit(bf, idx) do
            out false;
        end
        i = i + 1;
    end
    out true;
end

# ═══════════════════════════════════════════════════════
# Insert / Contains — string keys
# ═══════════════════════════════════════════════════════

func bloom_insert_str:
    in(bf: BloomFilter; key: string)
    h1 = _bloom_hash_str1(key);
    h2 = _bloom_hash_str2(key);

    i = 0;
    when i < bf.num_hashes loop
        idx = (h1 + i * h2) % bf.num_bits;
        if idx < 0 do
            idx = 0 - idx;
        end
        _bloom_set_bit(bf, idx);
        i = i + 1;
    end
    bf.count = bf.count + 1;
end.

func bloom_contains_str:
    in(bf: BloomFilter; key: string)
    h1 = _bloom_hash_str1(key);
    h2 = _bloom_hash_str2(key);

    i = 0;
    when i < bf.num_hashes loop
        idx = (h1 + i * h2) % bf.num_bits;
        if idx < 0 do
            idx = 0 - idx;
        end
        if not _bloom_test_bit(bf, idx) do
            out false;
        end
        i = i + 1;
    end
    out true;
end

# ═══════════════════════════════════════════════════════
# Utility
# ═══════════════════════════════════════════════════════

func bloom_count:
    in(bf: BloomFilter)
    out bf.count;
end.

func bloom_clear:
    in(bf: BloomFilter)
    i = 0;
    when i < vec_len(bf.bits) loop
        vec_set(bf.bits, i, 0);
        i = i + 1;
    end
    bf.count = 0;
end.

func bloom_union:
    in(a: BloomFilter; b: BloomFilter)
    # OR the bit arrays (a |= b)
    i = 0;
    when i < vec_len(a.bits) and i < vec_len(b.bits) loop
        va = vec_get(a.bits, i);
        vb = vec_get(b.bits, i);
        # OR = a + b - (a AND b)
        # Simplified: set each bit from b
        vec_set(a.bits, i, _or_word(va, vb));
        i = i + 1;
    end
end.

func _or_word:
    in(a: int; b: int)
    result = 0;
    power = 1;
    bit = 0;
    when bit < 64 loop
        ba = (a / power) % 2;
        bb = (b / power) % 2;
        if ba == 1 or bb == 1 do
            result = result + power;
        end
        power = power * 2;
        bit = bit + 1;
    end
    out result;
end

# ─── Estimated false positive rate ───────────────────

func bloom_fp_estimate:
    in(bf: BloomFilter)
    # p ≈ (1 - e^(-kn/m))^k
    # Approximate: count set bits / total bits
    set_count = 0;
    i = 0;
    when i < vec_len(bf.bits) loop
        w = vec_get(bf.bits, i);
        # Popcount
        bit = 0;
        when bit < 64 loop
            if (w / 1) % 2 == 1 do
                set_count = set_count + 1;
            end
            w = w / 2;
            bit = bit + 1;
        end
        i = i + 1;
    end
    # Return set_count * 1000 / num_bits (per-mille fill rate)
    out set_count * 1000 / bf.num_bits;
end
