##
 * vir/collections/linkedlist.vri — Doubly Linked List
 * ====================================================
 * Inspired by Rust: std::collections::LinkedList
 * Inspired by Go: container/list
 *
 * Phase D — Full coverage. O(1) insert/remove at both ends,
 * O(1) insert/remove at cursor position.
 ##

include types;
include option;
import Option, Some, None, is_some, is_none, unwrap from option;
include vec;
import Vec, vec_new, vec_push, vec_len, vec_get from vec;

# ═══════════════════════════════════════════════════════
# Node & List entities
# ═══════════════════════════════════════════════════════

entity LLNode:
    value: any_val,
        prev:  Option;    # Option<LLNode>
    next:  Option;    # Option<LLNode>
end.

entity LinkedList:
    head: Option;     # Option<LLNode>
    tail: Option;     # Option<LLNode>
    size: int;
end

# ═══════════════════════════════════════════════════════
# Constructor
# ═══════════════════════════════════════════════════════

func ll_new:
    in()
    out LinkedList {
        head: None,
        tail: None,
        size: 0
    };
end.

func ll_len:
    in(list: LinkedList)
    out list.size;
end.

func ll_is_empty:
    in(list: LinkedList)
    out list.size == 0;
end

# ═══════════════════════════════════════════════════════
# Push / Pop front
# ═══════════════════════════════════════════════════════

func ll_push_front:
    in(list: LinkedList; value: any_val)
    node = LLNode { value: value, prev: None, next: list.head };
    if is_some(list.head) do
        old_head = unwrap(list.head);
        old_head.prev = Some(node);
    else
        list.tail = Some(node);
    end
    list.head = Some(node);
    list.size = list.size + 1;
end.

func ll_push_back:
    in(list: LinkedList; value: any_val)
    node = LLNode { value: value, prev: list.tail, next: None };
    if is_some(list.tail) do
        old_tail = unwrap(list.tail);
        old_tail.next = Some(node);
    else
        list.head = Some(node);
    end
    list.tail = Some(node);
    list.size = list.size + 1;
end.

func ll_pop_front:
    in(list: LinkedList)
    if is_none(list.head) do
        out None;
    end
    node = unwrap(list.head);
    list.head = node.next;
    if is_some(list.head) do
        new_head = unwrap(list.head);
        new_head.prev = None;
    else
        list.tail = None;
    end
    list.size = list.size - 1;
    out Some(node.value);
end.

func ll_pop_back:
    in(list: LinkedList)
    if is_none(list.tail) do
        out None;
    end
    node = unwrap(list.tail);
    list.tail = node.prev;
    if is_some(list.tail) do
        new_tail = unwrap(list.tail);
        new_tail.next = None;
    else
        list.head = None;
    end
    list.size = list.size - 1;
    out Some(node.value);
end

# ═══════════════════════════════════════════════════════
# Peek
# ═══════════════════════════════════════════════════════

func ll_front:
    in(list: LinkedList)
    if is_none(list.head) do
        out None;
    end
    out Some(unwrap(list.head).value);
end.

func ll_back:
    in(list: LinkedList)
    if is_none(list.tail) do
        out None;
    end
    out Some(unwrap(list.tail).value);
end

# ═══════════════════════════════════════════════════════
# Indexed access (O(n))
# ═══════════════════════════════════════════════════════

func ll_get:
    in(list: LinkedList; index: int)
    if index < 0 do
        out None;
    end
    if index >= list.size do
        out None;
    end
    cur = list.head;
    i = 0;
    when i < index loop
        cur = unwrap(cur).next;
        i = i + 1;
    end
    out Some(unwrap(cur).value);
end

# ═══════════════════════════════════════════════════════
# Insert / Remove at node
# ═══════════════════════════════════════════════════════

func ll_insert_after:
    in(list: LinkedList; node: LLNode; value: any_val)
    new_node = LLNode { value: value, prev: Some(node), next: node.next };
    if is_some(node.next) do
        next_node = unwrap(node.next);
        next_node.prev = Some(new_node);
    else
        list.tail = Some(new_node);
    end
    node.next = Some(new_node);
    list.size = list.size + 1;
end.

func ll_remove_node:
    in(list: LinkedList; node: LLNode)
    if is_some(node.prev) do
        prev_node = unwrap(node.prev);
        prev_node.next = node.next;
    else
        list.head = node.next;
    end
    if is_some(node.next) do
        next_node = unwrap(node.next);
        next_node.prev = node.prev;
    else
        list.tail = node.prev;
    end
    list.size = list.size - 1;
    out node.value;
end

# ═══════════════════════════════════════════════════════
# Iteration / Collection
# ═══════════════════════════════════════════════════════

func ll_to_vec:
    in(list: LinkedList)
    result = vec_new();
    cur = list.head;
    when is_some(cur) loop
        n = unwrap(cur);
        vec_push(result, n.value);
        cur = n.next;
    end
    out result;
end.

func ll_contains:
    in(list: LinkedList; value: any_val; eq_fn: func)
    cur = list.head;
    when is_some(cur) loop
        n = unwrap(cur);
        if eq_fn(n.value, value) do
            out true;
        end
        cur = n.next;
    end
    out false;
end.

func ll_clear:
    in(list: LinkedList)
    list.head = None;
    list.tail = None;
    list.size = 0;
end.

func ll_reverse:
    in(list: LinkedList)
    cur = list.head;
    list.head = list.tail;
    list.tail = cur;
    when is_some(cur) loop
        n = unwrap(cur);
        tmp = n.next;
        n.next = n.prev;
        n.prev = tmp;
        cur = tmp;
    end
end
