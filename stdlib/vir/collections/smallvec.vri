##
 * vir/collections/smallvec.vri — Small Buffer Optimized Vector
 * =============================================================
 * Inspired by Rust: smallvec crate
 * Inspired by C++: boost::small_vector, llvm::SmallVector
 *
 * Phase D — Full coverage. Inline storage for up to N elements,
 * spills to heap allocation when exceeding inline capacity.
 * Avoids heap allocation for common small-collection cases.
 ##

include types;
include option;
import Option, Some, None, is_some, is_none, unwrap from option;
include vec;
import Vec, vec_new, vec_push, vec_get, vec_set, vec_len, vec_pop, vec_remove from vec;

const SMALLVEC_INLINE_CAP = 8;   # inline slots

# ═══════════════════════════════════════════════════════
# SmallVec entity
# ═══════════════════════════════════════════════════════

entity SmallVec:
    inline:    Vec;       # inline buffer (up to INLINE_CAP)
    heap:      Vec;       # heap spill (used when > INLINE_CAP)
    size:      int,
        on_heap:   bool;
end
func svec_new:
    in()
    out SmallVec (
        inline:  vec_new(),
        heap:    vec_new(),
        size:    0,
        on_heap: false
    );
end
func svec_with_capacity:
    in(cap: int)
    sv = svec_new();
    if cap > SMALLVEC_INLINE_CAP do
        sv.on_heap = true;
    end
    out sv;
end
func svec_len:
    in(sv: SmallVec)
    out sv.size;
end
func svec_is_empty:
    in(sv: SmallVec)
    out sv.size == 0;
end
func svec_is_inline:
    in(sv: SmallVec)
    out not sv.on_heap;
end
# ═══════════════════════════════════════════════════════
# Spill to heap
# ═══════════════════════════════════════════════════════

func _svec_spill:
    in(sv: SmallVec)
    if sv.on_heap do
        out;
    end
    sv.on_heap = true;
    sv.heap = vec_new();
    i = 0;
    when i < vec_len(sv.inline) loop
        vec_push(sv.heap, vec_get(sv.inline, i));
        i = i + 1;
    end
end
func _svec_buf:
    in(sv: SmallVec)
    if sv.on_heap do
        out sv.heap;
    end
    out sv.inline;
end
# ═══════════════════════════════════════════════════════
# Core operations
# ═══════════════════════════════════════════════════════

func svec_push:
    in(sv: SmallVec; value: any_val)
    if not sv.on_heap do
        if sv.size >= SMALLVEC_INLINE_CAP do
            _svec_spill(sv);
        end
    end
    buf = _svec_buf(sv);
    vec_push(buf, value);
    sv.size = sv.size + 1;
end
func svec_pop:
    in(sv: SmallVec)
    if sv.size == 0 do
        out None;
    end
    buf = _svec_buf(sv);
    val = vec_pop(buf);
    sv.size = sv.size - 1;
    out Some(val);
end
func svec_get:
    in(sv: SmallVec; index: int)
    if index < 0 do
        out None;
    end
    if index >= sv.size do
        out None;
    end
    buf = _svec_buf(sv);
    out Some(vec_get(buf, index));
end
func svec_set:
    in(sv: SmallVec; index: int; value: any_val)
    if index >= 0 do
        if index < sv.size do
            buf = _svec_buf(sv);
            vec_set(buf, index, value);
        end
    end
end
func svec_remove:
    in(sv: SmallVec; index: int)
    if index < 0 do
        out None;
    end
    if index >= sv.size do
        out None;
    end
    buf = _svec_buf(sv);
    val = vec_get(buf, index);
    vec_remove(buf, index);
    sv.size = sv.size - 1;
    out Some(val);
end
func svec_clear:
    in(sv: SmallVec)
    if sv.on_heap do
        sv.heap = vec_new();
        sv.on_heap = false;
    end
    sv.inline = vec_new();
    sv.size = 0;
end
func svec_to_vec:
    in(sv: SmallVec)
    result = vec_new();
    buf = _svec_buf(sv);
    i = 0;
    when i < sv.size loop
        vec_push(result, vec_get(buf, i));
        i = i + 1;
    end
    out result;
end
func svec_from_vec:
    in(v: Vec)
    sv = svec_new();
    i = 0;
    when i < vec_len(v) loop
        svec_push(sv, vec_get(v, i));
        i = i + 1;
    end
    out sv;
end