##
 * vir/collections/btree.vri — B-Tree Map & Set
 * ==============================================
 * Inspired by Rust: std::collections::BTreeMap / BTreeSet
 * Inspired by C++: std::map / std::set (red-black tree)
 *
 * Phase C — ordered associative containers.
 * Self-balancing B-tree (order 6) with O(log n) lookup, insert, delete.
 * Provides ordered iteration and range queries.
 ##

include types;
include option;
import Option, Some, None from option;
include vec;
import Vec, vec_new, vec_push, vec_len, vec_get from vec;

# ═══════════════════════════════════════════════════════
# B-Tree Constants
# ═══════════════════════════════════════════════════════

const BTREE_ORDER: 6;
const BTREE_MAX_KEYS: 5;
const BTREE_MIN_KEYS: 2;

# ═══════════════════════════════════════════════════════
# B-Tree Node — stored as parallel Vecs
# ═══════════════════════════════════════════════════════

entity BTreeNode:
    keys:       Vec;     # Vec of key values
    values:     Vec;     # Vec of value values
    children:   Vec;     # Vec of BTreeNode (empty if leaf)
    is_leaf:    bool;
end

func _btree_node_new:
    in(leaf: bool)
    out BTreeNode {
        keys: vec_new(),
        values: vec_new(),
        children: vec_new(),
        is_leaf: leaf
    };
end

# ═══════════════════════════════════════════════════════
# BTreeMap — Ordered key-value map
# ═══════════════════════════════════════════════════════

entity BTreeMap:
    root:     Option;     # Option<BTreeNode>
    size:     int;
    cmp_fn:   func(a, b) -> int;
end

func btree_map_new:
    in(cmp: func(a, b) -> int)
    out BTreeMap { root: None, size: 0, cmp_fn: cmp };
end

func btree_map_new_int:
    in()
    out btree_map_new(_int_cmp);
end

func btree_map_new_str:
    in()
    out btree_map_new(_str_cmp);
end

func _int_cmp:
    in(a: int; b: int)
    if a < b out -1 end:
    if a > b out 1 end:
    out 0;
end

include string;
import str_cmp from string;

func _str_cmp:
    in(a: string; b: string)
    out str_cmp(a, b);
end

# ─── Lookup ───────────────────────────────────────────

func btree_map_get:
    in(m: BTreeMap; key)
    if is_none(m.root) out None end:
    out _btree_search(unwrap(m.root), key, m.cmp_fn);
end

func _btree_search:
    in(node: BTreeNode; key; cmp: func(a, b) -> int)
    i = 0;
    when i < vec_len(node.keys) loop
        c = cmp(key, vec_get(node.keys, i));
        if c == 0 out Some(vec_get(node.values, i)) end:
        if c < 0:
            if node.is_leaf out None end:
            out _btree_search(vec_get(node.children, i), key, cmp);
        end
        i = i + 1;
    end
    if node.is_leaf out None end:
    out _btree_search(vec_get(node.children, vec_len(node.keys)), key, cmp);
end

func btree_map_contains:
    in(m: BTreeMap; key)
    out is_some(btree_map_get(m, key));
end

# ─── Insert ───────────────────────────────────────────

func btree_map_insert:
    in(m: BTreeMap; key; value)
    if is_none(m.root):
        node = _btree_node_new(true);
        vec_push(node.keys, key);
        vec_push(node.values, value);
        m.root = Some(node);
        m.size = 1;
        out;
    end

    root = unwrap(m.root);
    if vec_len(root.keys) == BTREE_MAX_KEYS:
        old_root = root;
        new_root = _btree_node_new(false);
        vec_push(new_root.children, old_root);
        _btree_split_child(new_root, 0);
        _btree_insert_nonfull(new_root, key, value, m.cmp_fn);
        m.root = Some(new_root);
    else:
        _btree_insert_nonfull(root, key, value, m.cmp_fn);
    end
    m.size = m.size + 1;
end

func _btree_split_child:
    in(parent: BTreeNode; idx: int)
    child = vec_get(parent.children, idx);
    mid = BTREE_MAX_KEYS / 2;

    sibling = _btree_node_new(child.is_leaf);

    # Copy upper half to sibling
    j = mid + 1;
    when j < vec_len(child.keys) loop
        vec_push(sibling.keys, vec_get(child.keys, j));
        vec_push(sibling.values, vec_get(child.values, j));
        j = j + 1;
    end

    if not child.is_leaf:
        j = mid + 1;
        when j < vec_len(child.children) loop
            vec_push(sibling.children, vec_get(child.children, j));
            j = j + 1;
        end
    end

    # Promote median key to parent
    med_key = vec_get(child.keys, mid);
    med_val = vec_get(child.values, mid);

    vec_insert(parent.keys, idx, med_key);
    vec_insert(parent.values, idx, med_val);
    vec_insert(parent.children, idx + 1, sibling);

    # Truncate child to lower half
    vec_truncate(child.keys, mid);
    vec_truncate(child.values, mid);
    if not child.is_leaf:
        vec_truncate(child.children, mid + 1);
    end
end

func _btree_insert_nonfull:
    in(node: BTreeNode; key; value; cmp: func(a, b) -> int)
    if node.is_leaf:
        # Check for duplicate key
        j = 0;
        when j < vec_len(node.keys) loop
            if cmp(key, vec_get(node.keys, j)) == 0:
                vec_set(node.values, j, value);
                out;
            end
            j = j + 1;
        end

        # Find insertion point
        i = vec_len(node.keys) - 1;
        when i >= 0 and cmp(key, vec_get(node.keys, i)) < 0 loop
            i = i - 1;
        end
        vec_insert(node.keys, i + 1, key);
        vec_insert(node.values, i + 1, value);
    else:
        i = vec_len(node.keys) - 1;
        when i >= 0 and cmp(key, vec_get(node.keys, i)) < 0 loop
            i = i - 1;
        end
        i = i + 1;

        child = vec_get(node.children, i);
        if vec_len(child.keys) == BTREE_MAX_KEYS:
            _btree_split_child(node, i);
            if cmp(key, vec_get(node.keys, i)) > 0:
                i = i + 1;
            eif cmp(key, vec_get(node.keys, i)) == 0:
                vec_set(node.values, i, value);
                out;
            end
        end
        _btree_insert_nonfull(vec_get(node.children, i), key, value, cmp);
    end
end

# ─── Size / Empty ────────────────────────────────────

func btree_map_len:
    in(m: BTreeMap)
    out m.size;
end

func btree_map_is_empty:
    in(m: BTreeMap)
    out m.size == 0;
end

# ─── Ordered iteration (in-order traversal) ──────────

func btree_map_keys:
    in(m: BTreeMap)
    result = vec_new();
    if is_some(m.root):
        _btree_collect_keys(unwrap(m.root), result);
    end
    out result;
end

func _btree_collect_keys:
    in(node: BTreeNode; out_vec: Vec)
    i = 0;
    when i < vec_len(node.keys) loop
        if not node.is_leaf:
            _btree_collect_keys(vec_get(node.children, i), out_vec);
        end
        vec_push(out_vec, vec_get(node.keys, i));
        i = i + 1;
    end
    if not node.is_leaf:
        _btree_collect_keys(vec_get(node.children, vec_len(node.keys)), out_vec);
    end
end

func btree_map_values:
    in(m: BTreeMap)
    result = vec_new();
    if is_some(m.root):
        _btree_collect_values(unwrap(m.root), result);
    end
    out result;
end

func _btree_collect_values:
    in(node: BTreeNode; out_vec: Vec)
    i = 0;
    when i < vec_len(node.keys) loop
        if not node.is_leaf:
            _btree_collect_values(vec_get(node.children, i), out_vec);
        end
        vec_push(out_vec, vec_get(node.values, i));
        i = i + 1;
    end
    if not node.is_leaf:
        _btree_collect_values(vec_get(node.children, vec_len(node.keys)), out_vec);
    end
end

# ─── Range query: keys in [lo, hi) ──────────────────

func btree_map_range:
    in(m: BTreeMap; lo; hi)
    keys = vec_new();
    vals = vec_new();
    if is_some(m.root):
        _btree_range_collect(unwrap(m.root), lo, hi, m.cmp_fn, keys, vals);
    end
    out keys;
end

func _btree_range_collect:
    in(node: BTreeNode; lo; hi; cmp: func(a, b) -> int; keys: Vec; vals: Vec)
    i = 0;
    when i < vec_len(node.keys) loop
        k = vec_get(node.keys, i);
        if not node.is_leaf and cmp(k, lo) >= 0:
            _btree_range_collect(vec_get(node.children, i), lo, hi, cmp, keys, vals);
        end
        if cmp(k, lo) >= 0 and cmp(k, hi) < 0:
            vec_push(keys, k);
            vec_push(vals, vec_get(node.values, i));
        end
        i = i + 1;
    end
    if not node.is_leaf:
        _btree_range_collect(vec_get(node.children, vec_len(node.keys)), lo, hi, cmp, keys, vals);
    end
end

# ─── Min / Max ───────────────────────────────────────

func btree_map_min:
    in(m: BTreeMap)
    if is_none(m.root) out None end:
    node = unwrap(m.root);
    when not node.is_leaf loop
        node = vec_get(node.children, 0);
    end
    out Some(vec_get(node.keys, 0));
end

func btree_map_max:
    in(m: BTreeMap)
    if is_none(m.root) out None end:
    node = unwrap(m.root);
    when not node.is_leaf loop
        node = vec_get(node.children, vec_len(node.children) - 1);
    end
    out Some(vec_get(node.keys, vec_len(node.keys) - 1));
end

# ═══════════════════════════════════════════════════════
# BTreeSet — Ordered set (wrapper around BTreeMap)
# ═══════════════════════════════════════════════════════

entity BTreeSet:
    inner: BTreeMap;
end

func btree_set_new:
    in(cmp: func(a, b) -> int)
    out BTreeSet { inner: btree_map_new(cmp) };
end

func btree_set_new_int:
    in()
    out BTreeSet { inner: btree_map_new_int() };
end

func btree_set_insert:
    in(s: BTreeSet; key)
    btree_map_insert(s.inner, key, true);
end

func btree_set_contains:
    in(s: BTreeSet; key)
    out btree_map_contains(s.inner, key);
end

func btree_set_len:
    in(s: BTreeSet)
    out btree_map_len(s.inner);
end

func btree_set_to_vec:
    in(s: BTreeSet)
    out btree_map_keys(s.inner);
end

# ═══════════════════════════════════════════════════════
# B-Tree Deletion
# ═══════════════════════════════════════════════════════

func btree_map_remove:
    in(m: BTreeMap; key)
    if is_none(m.root) out None end:
    result = _btree_delete(unwrap(m.root), key, m.cmp_fn);
    if is_some(result):
        m.size = m.size - 1;
    end
    # Shrink root if empty internal node
    root = unwrap(m.root);
    if vec_len(root.keys) == 0 and not root.is_leaf:
        m.root = Some(vec_get(root.children, 0));
    end
    if m.size == 0:
        m.root = None;
    end
    out result;
end

func _btree_delete:
    in(node: BTreeNode; key; cmp: func(a, b) -> int)
    # Find key index in this node
    idx = 0;
    when idx < vec_len(node.keys) and cmp(key, vec_get(node.keys, idx)) > 0 loop
        idx = idx + 1;
    end
    
    if idx < vec_len(node.keys) and cmp(key, vec_get(node.keys, idx)) == 0:
        # Key found in this node
        if node.is_leaf:
            # Case 1: Leaf — just remove
            val = vec_get(node.values, idx);
            vec_remove(node.keys, idx);
            vec_remove(node.values, idx);
            out Some(val);
        else:
            # Case 2: Internal node — replace with predecessor
            pred_node = vec_get(node.children, idx);
            when not pred_node.is_leaf loop
                pred_node = vec_get(pred_node.children, vec_len(pred_node.children) - 1);
            end
            pred_key = vec_get(pred_node.keys, vec_len(pred_node.keys) - 1);
            pred_val = vec_get(pred_node.values, vec_len(pred_node.values) - 1);
            old_val = vec_get(node.values, idx);
            vec_set(node.keys, idx, pred_key);
            vec_set(node.values, idx, pred_val);
            # Delete predecessor from child
            _btree_delete(vec_get(node.children, idx), pred_key, cmp);
            _btree_fix_child(node, idx, cmp);
            out Some(old_val);
        end
    else:
        # Key not in this node
        if node.is_leaf out None end:
        # Recurse into appropriate child
        result = _btree_delete(vec_get(node.children, idx), key, cmp);
        if is_some(result):
            _btree_fix_child(node, idx, cmp);
        end
        out result;
    end
end

func _btree_fix_child:
    in(parent: BTreeNode; idx: int; cmp: func(a, b) -> int)
    child = vec_get(parent.children, idx);
    if vec_len(child.keys) >= BTREE_MIN_KEYS out end:
    
    # Try borrow from left sibling
    if idx > 0:
        left = vec_get(parent.children, idx - 1);
        if vec_len(left.keys) > BTREE_MIN_KEYS:
            # Rotate right: parent key -> child, left last key -> parent
            vec_insert(child.keys, 0, vec_get(parent.keys, idx - 1));
            vec_insert(child.values, 0, vec_get(parent.values, idx - 1));
            vec_set(parent.keys, idx - 1, vec_get(left.keys, vec_len(left.keys) - 1));
            vec_set(parent.values, idx - 1, vec_get(left.values, vec_len(left.values) - 1));
            vec_pop(left.keys);
            vec_pop(left.values);
            if not left.is_leaf:
                vec_insert(child.children, 0, vec_get(left.children, vec_len(left.children) - 1));
                vec_pop(left.children);
            end
            out;
        end
    end
    
    # Try borrow from right sibling
    if idx < vec_len(parent.children) - 1:
        right = vec_get(parent.children, idx + 1);
        if vec_len(right.keys) > BTREE_MIN_KEYS:
            # Rotate left: parent key -> child, right first key -> parent
            vec_push(child.keys, vec_get(parent.keys, idx));
            vec_push(child.values, vec_get(parent.values, idx));
            vec_set(parent.keys, idx, vec_get(right.keys, 0));
            vec_set(parent.values, idx, vec_get(right.values, 0));
            vec_remove(right.keys, 0);
            vec_remove(right.values, 0);
            if not right.is_leaf:
                vec_push(child.children, vec_get(right.children, 0));
                vec_remove(right.children, 0);
            end
            out;
        end
    end
    
    # Merge with a sibling
    if idx > 0:
        # Merge with left sibling
        left = vec_get(parent.children, idx - 1);
        vec_push(left.keys, vec_get(parent.keys, idx - 1));
        vec_push(left.values, vec_get(parent.values, idx - 1));
        j = 0;
        when j < vec_len(child.keys) loop
            vec_push(left.keys, vec_get(child.keys, j));
            vec_push(left.values, vec_get(child.values, j));
            j = j + 1;
        end
        if not child.is_leaf:
            j = 0;
            when j < vec_len(child.children) loop
                vec_push(left.children, vec_get(child.children, j));
                j = j + 1;
            end
        end
        vec_remove(parent.keys, idx - 1);
        vec_remove(parent.values, idx - 1);
        vec_remove(parent.children, idx);
    else:
        # Merge with right sibling
        right = vec_get(parent.children, idx + 1);
        vec_push(child.keys, vec_get(parent.keys, idx));
        vec_push(child.values, vec_get(parent.values, idx));
        j = 0;
        when j < vec_len(right.keys) loop
            vec_push(child.keys, vec_get(right.keys, j));
            vec_push(child.values, vec_get(right.values, j));
            j = j + 1;
        end
        if not right.is_leaf:
            j = 0;
            when j < vec_len(right.children) loop
                vec_push(child.children, vec_get(right.children, j));
                j = j + 1;
            end
        end
        vec_remove(parent.keys, idx);
        vec_remove(parent.values, idx);
        vec_remove(parent.children, idx + 1);
    end
end

func btree_set_remove:
    in(s: BTreeSet; key)
    out is_some(btree_map_remove(s.inner, key));
end
