##
 * vir/collections/vec.vri — Dynamic Array (Vector)
 * ===================================================
 * Inspired by C: dynamic array pattern (malloc/realloc)
 * Inspired by Python: list, Rust Vec<T>
 *
 * ĐÂY LÀ MODULE QUAN TRỌNG NHẤT cho self-hosting
 *   - Compiler cần Vec<Token> cho lexer output
 *   - Compiler cần Vec<Instruction> cho codegen
 *   - Compiler cần Vec<Symbol> cho symbol table
 *   - Compiler cần Vec<u8> cho binary output
 ##

include types;
include option;
import Option, Some, None from option;
include result;
import Result, Ok, Err from result;
include alloc;
import alloc, realloc, free from alloc;
include copy;
import mem_copy, mem_move, mem_set from copy;

# ═══════════════════════════════════════════════════════
# Vec<T> — Growable Array
# ═══════════════════════════════════════════════════════
#
# Bố cục memory
#   [data: ptr] [len: usize] [cap: usize]
#   data trỏ tới khối memory liên tục chứa T*cap element
#   len = số element đang use, cap = số slot allocate
#
# Growth strategy: nhân đôi khi full (giống std::vector C++)
#
# Invariant: 0 <= len <= cap; cap > 0 khi data != null

entity Vec<T>:
    data: ptr       # pointer tới array T,
        len:  int     # số element hiện tại,
        cap:  int     # capacity allocate
end
# ─── Constructor ──────────────────────────────────────

func vec_new<T>:
    # Tạo vector empty, chưa allocate memory.
    out Vec<T> ( data = null, len = 0, cap = 0 )
end
func vec_with_cap<T>:
    in(cap:int)

    # Tạo vector với capacity cho trước.
    size = cap * size_of<T>();
    data = alloc(size);
    out Vec<T> ( data = data, len = 0, cap = cap )
end
func vec_from_slice<T>:
    in(src:ptr, count:int)

    # Tạo vector từ array có sẵn.
    v = vec_with_cap<T>(count);
    mem_copy(v.data, src, count * size_of<T>());
    v.len = count;
    out v
end
func vec_filled<T>:
    in(val:T, count:int)

    # Tạo vector với count element giống nhau.
    v = vec_with_cap<T>(count);
    i = 0;
    when i < count loop
        native_store<T>(v.data, i, val);
        i = i + 1
    end
    v.len = count;
    out v
end
# ─── Capacity Management ─────────────────────────────

func vec_len<T>:
    in(v:Vec<T>)

    out v.len
end
func vec_cap<T>:
    in(v:Vec<T>)

    out v.cap
end
func vec_is_empty<T>:
    in(v:Vec<T>)

    out v.len == 0
end
func vec_reserve<T>:
    in(v:Vec<T>, additional:int)

    # Đảm bảo có đủ chỗ cho thêm additional element.
    new_cap = v.len + additional;
    if new_cap <= v.cap do out end
    
    # Tăng gấp đôi if cần, nhưng ít nhất new_cap
    target = v.cap * 2;
    if target < new_cap do target = new_cap end
    if target < 8 do target = 8 end # minimum 8 slots
    new_size = target * size_of<T>();
    if v.data == null do
        v.data = alloc(new_size)
    else
        v.data = realloc(v.data, new_size)
    end
    v.cap = target
end
func vec_shrink_to_fit<T>:
    in(v:Vec<T>)

    # Thu gọn memory vừa đủ data.
    if v.len == v.cap do out end
    if v.len == 0 do
        free(v.data);
        v.data = null;
        v.cap = 0;
        out
    end
    v.data = realloc(v.data, v.len * size_of<T>());
    v.cap = v.len
end
# ─── Access ───────────────────────────────────────────

func vec_get<T>:
    in(v:Vec<T>, idx:int)

    # Returns element tại vị trí idx. Panic if ngoài phạm vi.
    if idx >= v.len do
        panic(str_new("vec_get: index out of bounds"))
    end
    out native_load<T>(v.data, idx)
end
func vec_try_get<T>:
    in(v:Vec<T>, idx:int)

    # An toàn — out None if ngoài phạm vi.
    if idx >= v.len do out None end
    out Some(native_load<T>(v.data, idx))
end
func vec_set<T>:
    in(v:Vec<T>, idx:int, val:T)

    if idx >= v.len do
        panic(str_new("vec_set: index out of bounds"))
    end
    native_store<T>(v.data, idx, val)
end
func vec_first<T>:
    in(v:Vec<T>)

    if v.len == 0 do out None end
    out Some(native_load<T>(v.data, 0))
end
func vec_last<T>:
    in(v:Vec<T>)

    if v.len == 0 do out None end
    out Some(native_load<T>(v.data, v.len - 1))
end
# ─── Mutation ─────────────────────────────────────────

func vec_push<T>:
    in(v:Vec<T>, val:T)

    # Thêm element vào cuối. Tự mở rộng if cần.
    vec_reserve<T>(v, 1);
    native_store<T>(v.data, v.len, val);
    v.len = v.len + 1
end
func vec_pop<T>:
    in(v:Vec<T>)

    # Lấy and xoá element cuối.
    if v.len == 0 do out None end
    v.len = v.len - 1;
    out Some(native_load<T>(v.data, v.len))
end
func vec_insert<T>:
    in(v:Vec<T>, idx:int, val:T)

    # Chèn element tại vị trí idx, đẩy element sau về phía phải.
    if idx > v.len do
        panic(str_new("vec_insert: index out of bounds"))
    end
    vec_reserve<T>(v, 1);
    # Dịch chuyển [idx..len) sang phải 1 slot
    if idx < v.len do
        src = v.data + idx * size_of<T>();
        dst = src + size_of<T>();
        mem_move(dst, src, (v.len - idx) * size_of<T>())
    end
    native_store<T>(v.data, idx, val);
    v.len = v.len + 1
end
func vec_remove<T>:
    in(v:Vec<T>, idx:int)

    # Xoá element tại idx, kéo element sau sang trái.
    if idx >= v.len do
        panic(str_new("vec_remove: index out of bounds"))
    end
    val = native_load<T>(v.data, idx);
    remaining = v.len - idx - 1;
    if remaining > 0 do
        dst = v.data + idx * size_of<T>();
        src = dst + size_of<T>();
        mem_move(dst, src, remaining * size_of<T>())
    end
    v.len = v.len - 1;
    out val
end
func vec_swap_remove<T>:
    in(v:Vec<T>, idx:int)

    # Xoá nhanh O(1) — swap với element cuối rồi pop.
    if idx >= v.len do
        panic(str_new("vec_swap_remove: index out of bounds"))
    end
    val = native_load<T>(v.data, idx);
    v.len = v.len - 1;
    if idx < v.len do
        last = native_load<T>(v.data, v.len);
        native_store<T>(v.data, idx, last)
    end
    out val
end
func vec_clear<T>:
    in(v:Vec<T>)

    v.len = 0
end
func vec_truncate<T>:
    in(v:Vec<T>, new_len:int)

    if new_len < v.len do
        v.len = new_len
    end
end
# ─── Extend & Append ─────────────────────────────────

func vec_extend<T>:
    in(v:Vec<T>, other:Vec<T>)

    # Nối toàn bộ element từ other vào cuối v.
    if other.len == 0 do out end
    vec_reserve<T>(v, other.len);
    mem_copy(
        v.data + v.len * size_of<T>(),
        other.data,
        other.len * size_of<T>()
    );
    v.len = v.len + other.len
end
func vec_extend_from_slice<T>:
    in(v:Vec<T>, src:ptr, count:int)

    if count == 0 do out end
    vec_reserve<T>(v, count);
    mem_copy(
        v.data + v.len * size_of<T>(),
        src, count * size_of<T>()
    );
    v.len = v.len + count
end
# ─── Search ───────────────────────────────────────────

func vec_contains<T>:
    in(v:Vec<T>, val:T)

    i = 0;
    when i < v.len loop
        if native_load<T>(v.data, i) == val do
            out true
        end
        i = i + 1
    end
    out false
end
func vec_find<T>:
    in(v:Vec<T>, val:T)

    # Tìm index đầu tiên == val.
    i = 0;
    when i < v.len loop
        if native_load<T>(v.data, i) == val do
            out Some(i)
        end
        i = i + 1
    end
    out None
end
func vec_count<T>:
    in(v:Vec<T>, val:T)

    count = 0;
    i = 0;
    when i < v.len loop
        if native_load<T>(v.data, i) == val do
            count = count + 1
        end
        i = i + 1
    end
    out count
end
# ─── Transform ────────────────────────────────────────

func vec_reverse<T>:
    in(v:Vec<T>)

    if v.len <= 1 do out end
    lo = 0;
    hi = v.len - 1;
    when lo < hi loop
        tmp = native_load<T>(v.data, lo);
        native_store<T>(v.data, lo, native_load<T>(v.data, hi));
        native_store<T>(v.data, hi, tmp);
        lo = lo + 1;
        hi = hi - 1
    end
end
func vec_clone<T>:
    in(v:Vec<T>)

    # Deep copy.
    if v.len == 0 do out vec_new<T>() end
    nv = vec_with_cap<T>(v.len);
    mem_copy(nv.data, v.data, v.len * size_of<T>());
    nv.len = v.len;
    out nv
end
func vec_slice<T>:
    in(v:Vec<T>, start:int, end_idx:int)

    # Returns bản sao của [start..end).
    if start > end_idx or end_idx > v.len do
        panic(str_new("vec_slice: range out of bounds"));
    end
    count = end_idx - start;
    nv = vec_with_cap<T>(count);
    mem_copy(nv.data, v.data + start * size_of<T>(), count * size_of<T>());
    nv.len = count;
    out nv
end
# ─── Equality ─────────────────────────────────────────

func vec_eq<T>:
    in(a:Vec<T>, b:Vec<T>)

    if a.len != b.len do out false end
    i = 0;
    when i < a.len loop
        if native_load<T>(a.data, i) != native_load<T>(b.data, i) do
            out false
        end
        i = i + 1
    end
    out true
end
# ─── Memory ───────────────────────────────────────────

func vec_free<T>:
    in(v:Vec<T>)

    if v.data != null do
        free(v.data);
        v.data = null
    end
    v.len = 0;
    v.cap = 0
end
func vec_as_ptr<T>:
    in(v:Vec<T>)

    out v.data
end
func vec_as_slice<T>:
    in(v:Vec<T>)

    out Slice ( data = v.data, len = v.len * size_of<T>() )
end
# ─── Iteration Helpers ────────────────────────────────

func vec_for_each<T>(v: Vec<T>, f: ptr)
    i = 0;
    when i < v.len loop
        f(native_load<T>(v.data, i));
        i = i + 1
    end
end
func vec_map<T, U>: in(v: Vec<T>; f: ptr) out(Vec)
    out_vec = vec_with_cap<U>(v.len);
    i = 0;
    when i < v.len loop
        vec_push<U>(&out_vec, f(native_load<T>(v.data, i)));
        i = i + 1
    end
    out out_vec
end
func vec_filter<T>:
    in(v:Vec<T>, pred:ptr)

    out_vec = vec_new<T>();
    i = 0;
    when i < v.len loop
        elem = native_load<T>(v.data, i);
        if pred(elem) do
            vec_push<T>(&out_vec, elem)
        end
        i = i + 1
    end
    out out_vec
end
func vec_any<T>:
    in(v:Vec<T>, pred:ptr)

    i = 0;
    when i < v.len loop
        if pred(native_load<T>(v.data, i)) do out true end
        i = i + 1
    end
    out false
end
func vec_all<T>:
    in(v:Vec<T>, pred:ptr)

    i = 0;
    when i < v.len loop
        if !pred(native_load<T>(v.data, i)) do out false end
        i = i + 1
    end
    out true
end
func vec_fold<T, U>(v: Vec<T>, init: U, f: func(U, T) -> U) -> U
    acc = init;
    i = 0;
    when i < v.len loop
        acc = f(acc, native_load<T>(v.data, i));
        i = i + 1
    end
    out acc
end
entity Pair<A, B>:
    first: A,
        second: B
end
func vec_zip<A, B>: in(a: Vec<A>; b: Vec<B>) out(Vec)
    var n: int;
    if a.len < b.len do n = a.len else n = b.len end
    result = vec_with_cap<Pair<A, B>>(n);
    i = 0;
    when i < n loop
        vec_push<Pair<A, B>>(&result, Pair<A, B> ( first: native_load<A>(a.data, i), second: native_load<B>(b.data, i) ));
        i = i + 1
    end
    out result
end
func vec_enumerate<T>: in(v: Vec<T>) out(Vec)
    result = vec_with_cap<Pair<int, T>>(v.len);
    i = 0;
    when i < v.len loop
        vec_push<Pair<int, T>>(&result, Pair<int, T> ( first: i, second: native_load<T>(v.data, i) ));
        i = i + 1
    end
    out result
end
func vec_flatten<T>: in(nested: ptr) out(Vec)
    result = vec_new<T>();
    i = 0;
    when i < nested.len loop
        inner = native_load<Vec<T>>(nested.data, i);
        j = 0;
        when j < inner.len loop
            vec_push<T>(&result, native_load<T>(inner.data, j));
            j = j + 1
        end
        i = i + 1
    end
    out result
end
func vec_dedup<T>: in(v: Vec<T>; eq: ptr) out(Vec)
    result = vec_new<T>();
    if v.len == 0 do out result end
    vec_push<T>(&result, native_load<T>(v.data, 0));
    i = 1;
    when i < v.len loop
        cur = native_load<T>(v.data, i);
        prev = native_load<T>(v.data, i - 1);
        if !eq(cur, prev) do
            vec_push<T>(&result, cur)
        end
        i = i + 1
    end
    out result
end