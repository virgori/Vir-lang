# ============================================================
# Vir Standard Library: hashmap - Hash table implementation
# Equivalent to C hash tables / Python dict
# ============================================================
module hashmap;
export hm_create;
export hm_set;
export hm_get;
export hm_has;
export hm_delete;
export hm_size;
export hm_keys;
export hm_values;
export hm_clear;

# Hash map structure
# Stored as parallel arrays
#   keys[CAPACITY]   - string keys
#   vals[CAPACITY]   - integer values
#   used[CAPACITY]   - 0=empty, 1=occupied, 2=deleted (tombstone)
#   count            - number of active entries
#   capacity         - total capacity

var HM_CAP = 256
var hm_keys = []
var hm_vals = []
var hm_used = []
var hm_count = 0

func hm_hash:
    in(key)
    # djb2 hash function
    var hash = 5381
    var i = 0
    var n = len(key)
    when i < n loop
        var c = str_get(key, i)
        hash = hash * 33 + c
        # Keep positive
        if hash < 0 do
            hash = hash * (0 - 1)
        end
        i = i + 1
    end
    out hash;
end
func hm_create:
    hm_keys = []
    hm_vals = []
    hm_used = []
    hm_count = 0
    var i = 0
    when i < HM_CAP loop
        push(hm_keys, "")
        push(hm_vals, 0)
        push(hm_used, 0)
        i = i + 1
    end
end
func hm_str_eq:
    in(a, b)
    var la = len(a)
    var lb = len(b)
    if la != lb do out 0 end
    var i = 0
    when i < la loop
        if str_get(a, i) != str_get(b, i) do
            out 0;
        end
        i = i + 1
    end
    out 1;
end
func hm_set:
    in(key, value)
    var h = hm_hash(key) % HM_CAP
    var probe = 0
    when probe < HM_CAP loop
        var idx = (h + probe) % HM_CAP
        if hm_used[idx] == 0 do
            # Empty slot, insert
            hm_keys[idx] = key
            hm_vals[idx] = value
            hm_used[idx] = 1
            hm_count = hm_count + 1
            out 1;
        end
        if hm_used[idx] == 2 do
            # Tombstone, can reuse
            hm_keys[idx] = key
            hm_vals[idx] = value
            hm_used[idx] = 1
            hm_count = hm_count + 1
            out 1;
        end
        # Occupied, check if same key
        if hm_str_eq(hm_keys[idx], key) == 1 do
            hm_vals[idx] = value
            out 1;
        end
        probe = probe + 1
    end
    # Table full
    out 0;
end
func hm_get:
    in(key)
    var h = hm_hash(key) % HM_CAP
    var probe = 0
    when probe < HM_CAP loop
        var idx = (h + probe) % HM_CAP
        if hm_used[idx] == 0 do
            out 0 - 1;
        end
        if hm_used[idx] == 1 do
            if hm_str_eq(hm_keys[idx], key) == 1 do
                out hm_vals[idx];
            end
        end
        probe = probe + 1
    end
    out 0 - 1;
end
func hm_has:
    in(key)
    var h = hm_hash(key) % HM_CAP
    var probe = 0
    when probe < HM_CAP loop
        var idx = (h + probe) % HM_CAP
        if hm_used[idx] == 0 do
            out 0;
        end
        if hm_used[idx] == 1 do
            if hm_str_eq(hm_keys[idx], key) == 1 do
                out 1;
            end
        end
        probe = probe + 1
    end
    out 0;
end
func hm_delete:
    in(key)
    var h = hm_hash(key) % HM_CAP
    var probe = 0
    when probe < HM_CAP loop
        var idx = (h + probe) % HM_CAP
        if hm_used[idx] == 0 do
            out 0;
        end
        if hm_used[idx] == 1 do
            if hm_str_eq(hm_keys[idx], key) == 1 do
                hm_used[idx] = 2
                hm_count = hm_count - 1
                out 1;
            end
        end
        probe = probe + 1
    end
    out 0;
end
func hm_size:
    out hm_count;
end
func hm_keys_list:
    in(out_arr)
    var i = 0
    var count = 0
    when i < HM_CAP loop
        if hm_used[i] == 1 do
            out_arr[count] = hm_keys[i]
            count = count + 1
        end
        i = i + 1
    end
    out count;
end
func hm_values:
    in(out_arr)
    var i = 0
    var count = 0
    when i < HM_CAP loop
        if hm_used[i] == 1 do
            out_arr[count] = hm_vals[i]
            count = count + 1
        end
        i = i + 1
    end
    out count;
end
func hm_clear:
    var i = 0
    when i < HM_CAP loop
        hm_keys[i] = ""
        hm_vals[i] = 0
        hm_used[i] = 0
        i = i + 1
    end
    hm_count = 0
end
# Convenience aliases
func hm_keys:
    in(out_arr)
    out hm_keys_list(out_arr);
end