##
 * vir/collections/bitset.vri — BitSet / BitVec
 * ==============================================
 * Inspired by Rust: bitvec, fixedbitset crates
 * Inspired by Java: java.util.BitSet
 * Inspired by C++: std::bitset, boost::dynamic_bitset
 *
 * Phase C — compact bit vector with set operations.
 * Each bit is stored in a 64-bit word for maximum density.
 * Provides O(1) random access, O(n/64) set operations.
 ##

include types;
include vec;
import Vec, vec_new, vec_push, vec_len, vec_get, vec_set from vec;

# ═══════════════════════════════════════════════════════
# BitSet — dynamic-size bit vector
# ═══════════════════════════════════════════════════════

const BITS_PER_WORD: 64;

entity BitSet:
    words: Vec;      # Vec of int (64-bit words)
    num_bits: int;   # logical size (number of bits)
end

# ═══════════════════════════════════════════════════════
# Constructors
# ═══════════════════════════════════════════════════════

func bitset_new:
    in(size: int)
    bs = BitSet ( words: vec_new(), num_bits: size );
    num_words = (size + BITS_PER_WORD - 1) / BITS_PER_WORD;
    i = 0;
    when i < num_words loop
        vec_push(bs.words, 0);
        i = i + 1;
    end
    out bs;
end
func bitset_new_empty:
    in()
    out bitset_new(0);
end
# ═══════════════════════════════════════════════════════
# Single-bit operations
# ═══════════════════════════════════════════════════════

func bitset_set:
    in(bs: BitSet; pos: int)
    _bitset_ensure_capacity(bs, pos + 1);
    word_idx = pos / BITS_PER_WORD;
    bit_idx = pos % BITS_PER_WORD;
    vec_set(bs.words, word_idx, vec_get(bs.words, word_idx) | (1 << bit_idx));
end
func bitset_clear:
    in(bs: BitSet; pos: int)
    if pos >= bs.num_bits do out end
    word_idx = pos / BITS_PER_WORD;
    bit_idx = pos % BITS_PER_WORD;
    vec_set(bs.words, word_idx, vec_get(bs.words, word_idx) & ~(1 << bit_idx));
end
func bitset_toggle:
    in(bs: BitSet; pos: int)
    _bitset_ensure_capacity(bs, pos + 1);
    word_idx = pos / BITS_PER_WORD;
    bit_idx = pos % BITS_PER_WORD;
    vec_set(bs.words, word_idx, vec_get(bs.words, word_idx) ^ (1 << bit_idx));
end
func bitset_test:
    in(bs: BitSet; pos: int)
    if pos >= bs.num_bits do out false end
    word_idx = pos / BITS_PER_WORD;
    bit_idx = pos % BITS_PER_WORD;
    out (vec_get(bs.words, word_idx) >> bit_idx) & 1 == 1;
end
func _bitset_ensure_capacity:
    in(bs: BitSet; min_bits: int)
    if min_bits <= bs.num_bits do out end
    needed = (min_bits + BITS_PER_WORD - 1) / BITS_PER_WORD;
    when vec_len(bs.words) < needed loop
        vec_push(bs.words, 0);
    end
    bs.num_bits = min_bits;
end
# ═══════════════════════════════════════════════════════
# Bulk operations
# ═══════════════════════════════════════════════════════

func bitset_set_all:
    in(bs: BitSet)
    i = 0;
    when i < vec_len(bs.words) loop
        vec_set(bs.words, i, -1);   # all bits set
        i = i + 1;
    end
end
func bitset_clear_all:
    in(bs: BitSet)
    i = 0;
    when i < vec_len(bs.words) loop
        vec_set(bs.words, i, 0);
        i = i + 1;
    end
end
# ═══════════════════════════════════════════════════════
# Set algebra — operate word-by-word
# ═══════════════════════════════════════════════════════

func bitset_and:
    in(a: BitSet; b: BitSet)
    result = bitset_new(if a.num_bits > b.num_bits a.num_bits else b.num_bits end);
    min_words = if vec_len(a.words) < vec_len(b.words) vec_len(a.words) else vec_len(b.words) end
    i = 0;
    when i < min_words loop
        vec_set(result.words, i, vec_get(a.words, i) & vec_get(b.words, i));
        i = i + 1;
    end
    out result;
end
func bitset_or:
    in(a: BitSet; b: BitSet)
    max_bits = if a.num_bits > b.num_bits a.num_bits else b.num_bits end
    result = bitset_new(max_bits);
    la = vec_len(a.words);
    lb = vec_len(b.words);
    max_words = if la > lb la else lb end
    i = 0;
    when i < max_words loop
        wa = if i < la vec_get(a.words, i) else 0 end
        wb = if i < lb vec_get(b.words, i) else 0 end
        vec_set(result.words, i, wa | wb);
        i = i + 1;
    end
    out result;
end
func bitset_xor:
    in(a: BitSet; b: BitSet)
    max_bits = if a.num_bits > b.num_bits a.num_bits else b.num_bits end
    result = bitset_new(max_bits);
    la = vec_len(a.words);
    lb = vec_len(b.words);
    max_words = if la > lb la else lb end
    i = 0;
    when i < max_words loop
        wa = if i < la vec_get(a.words, i) else 0 end
        wb = if i < lb vec_get(b.words, i) else 0 end
        vec_set(result.words, i, wa ^ wb);
        i = i + 1;
    end
    out result;
end
func bitset_not:
    in(bs: BitSet)
    result = bitset_new(bs.num_bits);
    i = 0;
    when i < vec_len(bs.words) loop
        vec_set(result.words, i, ~vec_get(bs.words, i));
        i = i + 1;
    end
    out result;
end
func bitset_difference:
    in(a: BitSet; b: BitSet)
    # a AND NOT b
    result = bitset_new(a.num_bits);
    la = vec_len(a.words);
    lb = vec_len(b.words);
    i = 0;
    when i < la loop
        wa = vec_get(a.words, i);
        wb = if i < lb vec_get(b.words, i) else 0 end
        vec_set(result.words, i, wa & ~wb);
        i = i + 1;
    end
    out result;
end
# ═══════════════════════════════════════════════════════
# Population count & queries
# ═══════════════════════════════════════════════════════

func bitset_count:
    in(bs: BitSet)
    # Population count (number of set bits)
    total = 0;
    i = 0;
    when i < vec_len(bs.words) loop
        total = total + _popcount64(vec_get(bs.words, i));
        i = i + 1;
    end
    out total;
end
func _popcount64:
    in(x: int)
    # Brian Kernighan's method
    count = 0;
    n = x;
    when n != 0 loop
        n = n & (n - 1);
        count = count + 1;
    end
    out count;
end
func bitset_is_empty:
    in(bs: BitSet)
    out bitset_count(bs) == 0;
end
func bitset_len:
    in(bs: BitSet)
    out bs.num_bits;
end
func bitset_is_subset:
    in(a: BitSet; b: BitSet)
    # a ⊆ b iff (a AND NOT b) == 0
    la = vec_len(a.words);
    lb = vec_len(b.words);
    i = 0;
    when i < la loop
        wa = vec_get(a.words, i);
        wb = if i < lb vec_get(b.words, i) else 0 end
        if (wa & ~wb) != 0 do out false end
        i = i + 1;
    end
    out true;
end
func bitset_intersects:
    in(a: BitSet; b: BitSet)
    min_words = if vec_len(a.words) < vec_len(b.words) vec_len(a.words) else vec_len(b.words) end
    i = 0;
    when i < min_words loop
        if (vec_get(a.words, i) & vec_get(b.words, i)) != 0 do out true end
        i = i + 1;
    end
    out false;
end
# ═══════════════════════════════════════════════════════
# Iteration helpers
# ═══════════════════════════════════════════════════════

func bitset_first_set:
    in(bs: BitSet)
    # Returns index of first set bit, or -1
    i = 0;
    when i < vec_len(bs.words) loop
        w = vec_get(bs.words, i);
        if w != 0 do
            bit = 0;
            when (w >> bit) & 1 == 0 loop bit = bit + 1 end
            out i * BITS_PER_WORD + bit;
        end
        i = i + 1;
    end
    out -1;
end
func bitset_next_set:
    in(bs: BitSet; after: int)
    # Returns next set bit after position 'after', or -1
    pos = after + 1;
    when pos < bs.num_bits loop
        if bitset_test(bs, pos) do out pos end
        pos = pos + 1;
    end
    out -1;
end
func bitset_to_vec:
    in(bs: BitSet)
    # Collect all set bit indices into a Vec
    result = vec_new();
    i = 0;
    when i < bs.num_bits loop
        if bitset_test(bs, i) do
            vec_push(result, i);
        end
        i = i + 1;
    end
    out result;
end