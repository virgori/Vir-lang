##
 * vir/compress/bzip2.vri — Bzip2 Compression (Core)
 * ====================================================
 * Inspired by: bzip2 format specification
 *
 * BWT (Burrows-Wheeler Transform), MTF (Move-to-Front),
 * RLE encoding, block framing.
 * (Full bzip2 also needs Huffman coding — see existing compress module.)
 ##

include types;
include vec;
import Vec, vec_new, vec_push, vec_len, vec_get, vec_set from vec;
include str;
import StringBuilder, sb_new, sb_append_byte, sb_build, sb_free from str;

# ═══════════════════════════════════════════════════════
# Constants
# ═══════════════════════════════════════════════════════

const BZ2_BLOCK_MAGIC = 0x314159265359;  # pi digits
const BZ2_MAX_BLOCK   = 900000;          # 900K block size

# ═══════════════════════════════════════════════════════
# Burrows-Wheeler Transform
# ═══════════════════════════════════════════════════════

entity BwtResult:
    output:     Vec;    # Vec<int> transformed bytes
    primary_idx: int;   # index of original string in sorted order
end.
func bwt_encode(data: Vec):
    n = vec_len(data);
    if n == 0 do
        out BwtResult ( output: vec_new(), primary_idx: 0 );
    end

    # Build suffix array (simple O(n²) for correctness)
    indices = vec_new();
    i = 0;
    when i < n loop
        vec_push(indices, i);
        i = i + 1;
    end

    # Insertion sort on rotations (sufficient for stdlib)
    i = 1;
    when i < n loop
        key = vec_get(indices, i);
        j = i - 1;
        done = false;
        when j >= 0 && done == false loop
            cmp = _bwt_compare(data, vec_get(indices, j), key, n);
            if cmp > 0 do
                vec_set(indices, j + 1, vec_get(indices, j));
                j = j - 1;
            else
                done = true;
            end
        end
        vec_set(indices, j + 1, key);
        i = i + 1;
    end

    # Extract last column and find primary index
    output = vec_new();
    primary = 0;
    i = 0;
    when i < n loop
        idx = vec_get(indices, i);
        if idx == 0 do
            primary = i;
        end
        last_col = (idx + n - 1) % n;
        vec_push(output, vec_get(data, last_col));
        i = i + 1;
    end

    out BwtResult ( output: output, primary_idx: primary );
end.
func _bwt_compare:
    in  data: Vec;
        a: int;
        b: int;
        n: int
    k = 0;
    when k < n loop
        ca = vec_get(data, (a + k) % n);
        cb = vec_get(data, (b + k) % n);
        if ca < cb do
            out -1;
        end
        if ca > cb do
            out 1;
        end
        k = k + 1;
    end
    out 0;
end.
func bwt_decode(bwt: BwtResult):
    n = vec_len(bwt.output);
    if n == 0 do
        out vec_new();
    end

    # Count occurrences
    counts = vec_new();
    i = 0;
    when i < 256 loop
        vec_push(counts, 0);
        i = i + 1;
    end
    i = 0;
    when i < n loop
        b = vec_get(bwt.output, i);
        vec_set(counts, b, vec_get(counts, b) + 1);
        i = i + 1;
    end

    # Cumulative counts
    cumul = vec_new();
    total = 0;
    i = 0;
    when i < 256 loop
        vec_push(cumul, total);
        total = total + vec_get(counts, i);
        i = i + 1;
    end

    # Build T[] (transformation vector)
    tvec = vec_new();
    i = 0;
    when i < n loop
        vec_push(tvec, 0);
        i = i + 1;
    end
    # Reset counts for building T
    i = 0;
    when i < 256 loop
        vec_set(counts, i, 0);
        i = i + 1;
    end
    i = 0;
    when i < n loop
        b = vec_get(bwt.output, i);
        pos = vec_get(cumul, b) + vec_get(counts, b);
        vec_set(tvec, pos, i);
        vec_set(counts, b, vec_get(counts, b) + 1);
        i = i + 1;
    end

    # Reconstruct
    result = vec_new();
    idx = bwt.primary_idx;
    i = 0;
    when i < n loop
        idx = vec_get(tvec, idx);
        vec_push(result, vec_get(bwt.output, idx));
        i = i + 1;
    end
    out result;
end.
# ═══════════════════════════════════════════════════════
# Move-to-Front Transform
# ═══════════════════════════════════════════════════════

func mtf_encode(data: Vec):
    # Initialize alphabet 0..255
    alphabet = vec_new();
    i = 0;
    when i < 256 loop
        vec_push(alphabet, i);
        i = i + 1;
    end

    output = vec_new();
    i = 0;
    when i < vec_len(data) loop
        b = vec_get(data, i);
        # Find position of b in alphabet
        pos = 0;
        when vec_get(alphabet, pos) != b loop
            pos = pos + 1;
        end
        vec_push(output, pos);
        # Move to front
        j = pos;
        when j > 0 loop
            vec_set(alphabet, j, vec_get(alphabet, j - 1));
            j = j - 1;
        end
        vec_set(alphabet, 0, b);
        i = i + 1;
    end
    out output;
end.
func mtf_decode(data: Vec):
    alphabet = vec_new();
    i = 0;
    when i < 256 loop
        vec_push(alphabet, i);
        i = i + 1;
    end

    output = vec_new();
    i = 0;
    when i < vec_len(data) loop
        pos = vec_get(data, i);
        b = vec_get(alphabet, pos);
        vec_push(output, b);
        # Move to front
        j = pos;
        when j > 0 loop
            vec_set(alphabet, j, vec_get(alphabet, j - 1));
            j = j - 1;
        end
        vec_set(alphabet, 0, b);
        i = i + 1;
    end
    out output;
end.
# ═══════════════════════════════════════════════════════
# Run-Length Encoding (bzip2 RLE1 — initial pass)
# ═══════════════════════════════════════════════════════

func bz2_rle_encode(data: Vec):
    output = vec_new();
    n = vec_len(data);
    i = 0;
    when i < n loop
        b = vec_get(data, i);
        run = 1;
        when i + run < n && run < 255 loop
            if vec_get(data, i + run) == b do
                run = run + 1;
            else
                run = run + 256;  # sentinel to exit
            end
        end
        if run > 255 do
            run = run - 256;
        end
        if run >= 4 do
            vec_push(output, b);
            vec_push(output, b);
            vec_push(output, b);
            vec_push(output, b);
            vec_push(output, run - 4);  # repeat count
            i = i + run;
        else
            k = 0;
            when k < run loop
                vec_push(output, b);
                k = k + 1;
            end
            i = i + run;
        end
    end
    out output;
end.
# ═══════════════════════════════════════════════════════
# Convenience: full BWT+MTF pipeline
# ═══════════════════════════════════════════════════════

func bz2_transform(data: string):
    # String to byte Vec
    bytes = vec_new();
    i = 0;
    when i < str_len(data) loop
        vec_push(bytes, str_byte_at(data, i));
        i = i + 1;
    end
    # RLE1
    rle = bz2_rle_encode(bytes);
    # BWT
    bwt = bwt_encode(rle);
    # MTF
    mtf = mtf_encode(bwt.output);
    out mtf;
end.