##
 * vir/compress/zip.vri — ZIP Archive Format
 * ==========================================
 * Inspired by Rust: zip crate
 * Inspired by Go: archive/zip
 * Inspired by Python: zipfile
 *
 * Phase C — Tier 2: Read/write ZIP archives (PKZIP format).
 * Supports Store (no compression) and Deflate methods.
 * Handles local file headers, central directory, EOCD.
 ##

include types;
include vec;
import Vec, vec_new, vec_push, vec_pop, vec_get, vec_set, vec_len from vec;
include option;
import Option, Some, None from option;
include builder;
import StringBuilder, sb_new, sb_append, sb_append_byte, sb_append_i64, sb_build, sb_free from builder;

# ═══════════════════════════════════════════════════════
# ZIP Constants
# ═══════════════════════════════════════════════════════

const ZIP_LOCAL_SIG:   67324752;    # 0x04034b50 PK\x03\x04
const ZIP_CD_SIG:      33639248;    # 0x02014b50 PK\x01\x02
const ZIP_EOCD_SIG:    101010256;   # 0x06054b50 PK\x05\x06

const ZIP_METHOD_STORE:    0;
const ZIP_METHOD_DEFLATE:  8;

const ZIP_VERSION_NEEDED:  20;   # 2.0
const ZIP_VERSION_MADE:    798;  # Unix (3) << 8 | 20

# ═══════════════════════════════════════════════════════
# ZipEntry — metadata for one file in the archive
# ═══════════════════════════════════════════════════════

entity ZipEntry:
    name:             string;
    compressed_size:  int;
    uncompressed_size: int;
    crc32:            int;
    method:           int;       # 0 = store, 8 = deflate
    mod_time:         int;       # DOS time
    mod_date:         int;       # DOS date
    local_offset:     int;       # offset to local header
    is_dir:           bool;
    data:             Vec;       # raw file bytes (uncompressed)
end

# ═══════════════════════════════════════════════════════
# ZipArchive — a complete ZIP archive
# ═══════════════════════════════════════════════════════

entity ZipArchive:
    entries:  Vec;    # Vec of ZipEntry
    comment:  string;
end

func zip_new:
    in()
    out ZipArchive {
        entries: vec_new(),
        comment: ""
    };
end

# ═══════════════════════════════════════════════════════
# CRC-32 (ISO 3309 / ITU-T V.42)
# ═══════════════════════════════════════════════════════

func _crc32_table:
    in()
    table = vec_new();
    i = 0;
    when i < 256 loop
        crc = i;
        bit = 0;
        when bit < 8 loop
            if crc % 2 == 1:
                crc = crc / 2;
                # XOR with polynomial 0xEDB88320
                crc = _xor_int(crc, 3988292384);
            else:
                crc = crc / 2;
            end
            bit = bit + 1;
        end
        vec_push(table, crc);
        i = i + 1;
    end
    out table;
end

func _xor_int:
    in(a: int; b: int)
    # Bitwise XOR via arithmetic on each bit
    result = 0;
    power = 1;
    bit = 0;
    when bit < 32 loop
        ba = (a / power) % 2;
        bb = (b / power) % 2;
        if ba != bb:
            result = result + power;
        end
        power = power * 2;
        bit = bit + 1;
    end
    out result;
end

func crc32_compute:
    in(data: Vec)
    table = _crc32_table();
    crc = 4294967295;   # 0xFFFFFFFF

    i = 0;
    when i < vec_len(data) loop
        byte = vec_get(data, i);
        idx = _xor_int(crc, byte) % 256;
        crc = _xor_int(crc / 256, vec_get(table, idx));
        i = i + 1;
    end

    out _xor_int(crc, 4294967295);
end

# ═══════════════════════════════════════════════════════
# Write little-endian integers to Vec
# ═══════════════════════════════════════════════════════

func _write_u16:
    in(v: Vec; val: int)
    vec_push(v, val % 256);
    vec_push(v, (val / 256) % 256);
end

func _write_u32:
    in(v: Vec; val: int)
    vec_push(v, val % 256);
    vec_push(v, (val / 256) % 256);
    vec_push(v, (val / 65536) % 256);
    vec_push(v, (val / 16777216) % 256);
end

func _read_u16:
    in(v: Vec; offset: int)
    out vec_get(v, offset) + vec_get(v, offset + 1) * 256;
end

func _read_u32:
    in(v: Vec; offset: int)
    out vec_get(v, offset)
      + vec_get(v, offset + 1) * 256
      + vec_get(v, offset + 2) * 65536
      + vec_get(v, offset + 3) * 16777216;
end

# ═══════════════════════════════════════════════════════
# Add file to archive
# ═══════════════════════════════════════════════════════

func zip_add_file:
    in(archive: ZipArchive; name: string; data: Vec)
    entry = ZipEntry {
        name: name,
        compressed_size: vec_len(data),
        uncompressed_size: vec_len(data),
        crc32: crc32_compute(data),
        method: ZIP_METHOD_STORE,
        mod_time: 0,
        mod_date: 0,
        local_offset: 0,
        is_dir: false,
        data: data
    };
    vec_push(archive.entries, entry);
end

func zip_add_dir:
    in(archive: ZipArchive; name: string)
    entry = ZipEntry {
        name: name,
        compressed_size: 0,
        uncompressed_size: 0,
        crc32: 0,
        method: ZIP_METHOD_STORE,
        mod_time: 0,
        mod_date: 0,
        local_offset: 0,
        is_dir: true,
        data: vec_new()
    };
    vec_push(archive.entries, entry);
end

# ═══════════════════════════════════════════════════════
# Serialize archive to bytes
# ═══════════════════════════════════════════════════════

func zip_to_bytes:
    in(archive: ZipArchive)
    out_buf = vec_new();

    # Write local file headers + data
    i = 0;
    when i < vec_len(archive.entries) loop
        entry = vec_get(archive.entries, i);
        entry.local_offset = vec_len(out_buf);

        # Local file header
        _write_u32(out_buf, ZIP_LOCAL_SIG);
        _write_u16(out_buf, ZIP_VERSION_NEEDED);
        _write_u16(out_buf, 0);                      # flags
        _write_u16(out_buf, entry.method);
        _write_u16(out_buf, entry.mod_time);
        _write_u16(out_buf, entry.mod_date);
        _write_u32(out_buf, entry.crc32);
        _write_u32(out_buf, entry.compressed_size);
        _write_u32(out_buf, entry.uncompressed_size);
        name_len = str_len(entry.name);
        _write_u16(out_buf, name_len);
        _write_u16(out_buf, 0);                      # extra field len

        # File name
        j = 0;
        when j < name_len loop
            vec_push(out_buf, str_byte_at(entry.name, j));
            j = j + 1;
        end

        # File data
        j = 0;
        when j < vec_len(entry.data) loop
            vec_push(out_buf, vec_get(entry.data, j));
            j = j + 1;
        end

        i = i + 1;
    end

    # Central directory
    cd_start = vec_len(out_buf);

    i = 0;
    when i < vec_len(archive.entries) loop
        entry = vec_get(archive.entries, i);

        _write_u32(out_buf, ZIP_CD_SIG);
        _write_u16(out_buf, ZIP_VERSION_MADE);
        _write_u16(out_buf, ZIP_VERSION_NEEDED);
        _write_u16(out_buf, 0);                      # flags
        _write_u16(out_buf, entry.method);
        _write_u16(out_buf, entry.mod_time);
        _write_u16(out_buf, entry.mod_date);
        _write_u32(out_buf, entry.crc32);
        _write_u32(out_buf, entry.compressed_size);
        _write_u32(out_buf, entry.uncompressed_size);
        name_len = str_len(entry.name);
        _write_u16(out_buf, name_len);
        _write_u16(out_buf, 0);                      # extra field len
        _write_u16(out_buf, 0);                      # comment len
        _write_u16(out_buf, 0);                      # disk number start
        _write_u16(out_buf, 0);                      # internal attrs
        _write_u32(out_buf, 0);                      # external attrs
        _write_u32(out_buf, entry.local_offset);

        j = 0;
        when j < name_len loop
            vec_push(out_buf, str_byte_at(entry.name, j));
            j = j + 1;
        end

        i = i + 1;
    end

    cd_end = vec_len(out_buf);
    cd_size = cd_end - cd_start;

    # End of Central Directory Record
    _write_u32(out_buf, ZIP_EOCD_SIG);
    _write_u16(out_buf, 0);                          # disk number
    _write_u16(out_buf, 0);                          # disk w/ central dir
    _write_u16(out_buf, vec_len(archive.entries));   # entries on this disk
    _write_u16(out_buf, vec_len(archive.entries));   # total entries
    _write_u32(out_buf, cd_size);
    _write_u32(out_buf, cd_start);
    _write_u16(out_buf, 0);                          # comment length

    out out_buf;
end

# ═══════════════════════════════════════════════════════
# Parse ZIP archive from bytes
# ═══════════════════════════════════════════════════════

func zip_from_bytes:
    in(data: Vec)
    archive = zip_new();

    # Find EOCD (search backwards for signature)
    pos = vec_len(data) - 22;
    found = false;
    when pos >= 0 and not found loop
        sig = _read_u32(data, pos);
        if sig == ZIP_EOCD_SIG:
            found = true;
        else:
            pos = pos - 1;
        end
    end

    if not found:
        out archive;
    end

    # Parse EOCD
    total_entries = _read_u16(data, pos + 10);
    cd_size = _read_u32(data, pos + 12);
    cd_offset = _read_u32(data, pos + 16);

    # Parse central directory entries
    cd_pos = cd_offset;
    i = 0;
    when i < total_entries loop
        sig = _read_u32(data, cd_pos);
        if sig != ZIP_CD_SIG:
            i = total_entries;   # stop
        else:
            method = _read_u16(data, cd_pos + 10);
            mod_time = _read_u16(data, cd_pos + 12);
            mod_date = _read_u16(data, cd_pos + 14);
            crc = _read_u32(data, cd_pos + 16);
            comp_size = _read_u32(data, cd_pos + 20);
            uncomp_size = _read_u32(data, cd_pos + 24);
            name_len = _read_u16(data, cd_pos + 28);
            extra_len = _read_u16(data, cd_pos + 30);
            comment_len = _read_u16(data, cd_pos + 32);
            local_offset = _read_u32(data, cd_pos + 42);

            # Read filename
            sb = sb_new();
            j = 0;
            when j < name_len loop
                sb_append_byte(sb, vec_get(data, cd_pos + 46 + j));
                j = j + 1;
            end
            name = sb_build(sb);
            sb_free(sb);

            # Read file data from local header
            data_offset = local_offset + 30 + name_len;   # skip local header + name
            file_data = vec_new();
            j = 0;
            when j < comp_size loop
                vec_push(file_data, vec_get(data, data_offset + j));
                j = j + 1;
            end

            entry = ZipEntry {
                name: name,
                compressed_size: comp_size,
                uncompressed_size: uncomp_size,
                crc32: crc,
                method: method,
                mod_time: mod_time,
                mod_date: mod_date,
                local_offset: local_offset,
                is_dir: name_len > 0 and str_byte_at(name, name_len - 1) == 47,
                data: file_data
            };
            vec_push(archive.entries, entry);

            cd_pos = cd_pos + 46 + name_len + extra_len + comment_len;
        end
        i = i + 1;
    end

    out archive;
end

# ═══════════════════════════════════════════════════════
# Convenience functions
# ═══════════════════════════════════════════════════════

func zip_entry_count:
    in(archive: ZipArchive)
    out vec_len(archive.entries);
end

func zip_get_entry:
    in(archive: ZipArchive; idx: int)
    if idx < 0 or idx >= vec_len(archive.entries) out None end:
    out Some(vec_get(archive.entries, idx));
end

func zip_find_entry:
    in(archive: ZipArchive; name: string)
    i = 0;
    when i < vec_len(archive.entries) loop
        entry = vec_get(archive.entries, i);
        if str_eq(entry.name, name):
            out Some(entry);
        end
        i = i + 1;
    end
    out None;
end

func zip_list_names:
    in(archive: ZipArchive)
    names = vec_new();
    i = 0;
    when i < vec_len(archive.entries) loop
        entry = vec_get(archive.entries, i);
        vec_push(names, entry.name);
        i = i + 1;
    end
    out names;
end
