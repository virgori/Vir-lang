##
 * vir/compress/snappy.vri — Snappy Compression
 * ===============================================
 * Inspired by: Google Snappy format specification
 *
 * Snappy frame/block format, literal and copy ops,
 * varint-encoded uncompressed length.
 * Optimized for speed over ratio.
 ##

include types;
include vec;
import Vec, vec_new, vec_push, vec_len, vec_get, vec_set from vec;
include str;
import StringBuilder, sb_new, sb_append_byte, sb_build, sb_free from str;

# ═══════════════════════════════════════════════════════
# Element types
# ═══════════════════════════════════════════════════════

const SNAPPY_LITERAL = 0;
const SNAPPY_COPY1   = 1;   # 1-byte offset
const SNAPPY_COPY2   = 2;   # 2-byte offset
const SNAPPY_COPY4   = 4;   # 4-byte offset

const SNAPPY_HASH_LOG  = 14;
const SNAPPY_HASH_SIZE = 16384;  # 1 << 14
const SNAPPY_INPUT_MARGIN = 15;

# ═══════════════════════════════════════════════════════
# Varint encoding (Snappy uses pvarint for uncomp length)
# ═══════════════════════════════════════════════════════

func _snappy_put_varint:
    in(sb: StringBuilder; value: int)
    v = value;
    when v >= 128 loop
        sb_append_byte(sb, (v % 128) + 128);
        v = v / 128;
    end
    sb_append_byte(sb, v);
end.

func _snappy_read_varint:
    in(data: string; offset: int)
    # Returns [value, bytes_consumed]
    result = 0;
    shift = 0;
    pos = offset;
    done = false;
    when done == false loop
        b = str_byte_at(data, pos);
        result = result + ((b % 128) * _snp_pow2(shift));
        pos = pos + 1;
        shift = shift + 7;
        if b < 128 do
            done = true;
        end
    end
    out result;
end.

func _snappy_varint_size:
    in(data: string; offset: int)
    pos = offset;
    when str_byte_at(data, pos) >= 128 loop
        pos = pos + 1;
    end
    out pos - offset + 1;
end.

func _snp_pow2:
    in(n: int)
    r = 1;
    i = 0;
    when i < n loop
        r = r * 2;
        i = i + 1;
    end
    out r;
end

# ═══════════════════════════════════════════════════════
# Hash function
# ═══════════════════════════════════════════════════════

func _snappy_hash:
    in(data: string; pos: int)
    v = str_byte_at(data, pos) +
        str_byte_at(data, pos + 1) * 256 +
        str_byte_at(data, pos + 2) * 65536 +
        str_byte_at(data, pos + 3) * 16777216;
    h = (v * 506832829) % 4294967296;
    out (h / 262144) % SNAPPY_HASH_SIZE;  # >> 18
end

# ═══════════════════════════════════════════════════════
# Emit literal
# ═══════════════════════════════════════════════════════

func _snappy_emit_literal:
    in(sb: StringBuilder; data: string; start: int; length: int)
    n = length - 1;
    if n < 60 do
        sb_append_byte(sb, n * 4);  # tag=00, len in upper 6 bits
    eif n < 256 do
        sb_append_byte(sb, 60 * 4);
        sb_append_byte(sb, n);
    else
        sb_append_byte(sb, 61 * 4);
        sb_append_byte(sb, n % 256);
        sb_append_byte(sb, (n / 256) % 256);
    end
    i = start;
    when i < start + length loop
        sb_append_byte(sb, str_byte_at(data, i));
        i = i + 1;
    end
end

# ═══════════════════════════════════════════════════════
# Emit copy
# ═══════════════════════════════════════════════════════

func _snappy_emit_copy:
    in(sb: StringBuilder; offset: int; length: int)
    remaining = length;
    when remaining > 0 loop
        if offset < 2048 && remaining >= 4 && remaining <= 11 do
            # Copy-1 (short)
            sb_append_byte(sb, ((offset / 256) * 32) + ((remaining - 4) * 4) + 1);
            sb_append_byte(sb, offset % 256);
            remaining = 0;
        else
            # Copy-2
            copy_len = remaining;
            if copy_len > 64 do
                copy_len = 64;
            end
            sb_append_byte(sb, ((copy_len - 1) * 4) + 2);
            sb_append_byte(sb, offset % 256);
            sb_append_byte(sb, (offset / 256) % 256);
            remaining = remaining - copy_len;
        end
    end
end

# ═══════════════════════════════════════════════════════
# Compress
# ═══════════════════════════════════════════════════════

func snappy_compress:
    in(data: string)
    n = str_len(data);
    sb = sb_new();
    _snappy_put_varint(sb, n);

    if n < SNAPPY_INPUT_MARGIN do
        _snappy_emit_literal(sb, data, 0, n);
        out sb_build(sb);
    end

    hash_table = vec_new();
    i = 0;
    when i < SNAPPY_HASH_SIZE loop
        vec_push(hash_table, 0);
        i = i + 1;
    end

    anchor = 0;
    pos = 0;
    limit = n - SNAPPY_INPUT_MARGIN;

    when pos < limit loop
        h = _snappy_hash(data, pos);
        candidate = vec_get(hash_table, h);
        vec_set(hash_table, h, pos);

        dist = pos - candidate;
        match_found = false;

        if dist > 0 && dist <= 65535 do
            if str_byte_at(data, candidate) == str_byte_at(data, pos) &&
               str_byte_at(data, candidate + 1) == str_byte_at(data, pos + 1) &&
               str_byte_at(data, candidate + 2) == str_byte_at(data, pos + 2) &&
               str_byte_at(data, candidate + 3) == str_byte_at(data, pos + 3) do
                match_found = true;
            end
        end

        if match_found do
            # Emit pending literals
            if pos > anchor do
                _snappy_emit_literal(sb, data, anchor, pos - anchor);
            end
            # Extend match
            match_len = 4;
            when pos + match_len < n && candidate + match_len < pos loop
                if str_byte_at(data, candidate + match_len) == str_byte_at(data, pos + match_len) do
                    match_len = match_len + 1;
                else
                    candidate = pos;  # exit
                end
            end
            _snappy_emit_copy(sb, dist, match_len);
            anchor = pos + match_len;
            pos = anchor;
        else
            pos = pos + 1;
        end
    end

    # Final literals
    if anchor < n do
        _snappy_emit_literal(sb, data, anchor, n - anchor);
    end

    out sb_build(sb);
end

# ═══════════════════════════════════════════════════════
# Decompress
# ═══════════════════════════════════════════════════════

func snappy_decompress:
    in(data: string)
    n = str_len(data);
    pos = 0;
    uncomp_len = _snappy_read_varint(data, 0);
    pos = pos + _snappy_varint_size(data, 0);

    out_buf = vec_new();

    when pos < n loop
        tag = str_byte_at(data, pos);
        elem_type = tag % 4;

        if elem_type == SNAPPY_LITERAL do
            lit_len = (tag / 4) + 1;
            pos = pos + 1;
            if (tag / 4) == 60 do
                lit_len = str_byte_at(data, pos) + 1;
                pos = pos + 1;
            eif (tag / 4) == 61 do
                lit_len = str_byte_at(data, pos) + str_byte_at(data, pos + 1) * 256 + 1;
                pos = pos + 2;
            end
            k = 0;
            when k < lit_len loop
                vec_push(out_buf, str_byte_at(data, pos));
                pos = pos + 1;
                k = k + 1;
            end
        eif elem_type == 1 do
            # Copy-1
            length = ((tag / 4) % 8) + 4;
            offset = ((tag / 32) * 256) + str_byte_at(data, pos + 1);
            pos = pos + 2;
            ref_start = vec_len(out_buf) - offset;
            k = 0;
            when k < length loop
                vec_push(out_buf, vec_get(out_buf, ref_start + k));
                k = k + 1;
            end
        eif elem_type == 2 do
            # Copy-2
            length = (tag / 4) + 1;
            offset = str_byte_at(data, pos + 1) + str_byte_at(data, pos + 2) * 256;
            pos = pos + 3;
            ref_start = vec_len(out_buf) - offset;
            k = 0;
            when k < length loop
                vec_push(out_buf, vec_get(out_buf, ref_start + k));
                k = k + 1;
            end
        else
            # Copy-4
            length = (tag / 4) + 1;
            pos = pos + 1;
            offset = str_byte_at(data, pos) + str_byte_at(data, pos + 1) * 256 +
                     str_byte_at(data, pos + 2) * 65536 + str_byte_at(data, pos + 3) * 16777216;
            pos = pos + 4;
            ref_start = vec_len(out_buf) - offset;
            k = 0;
            when k < length loop
                vec_push(out_buf, vec_get(out_buf, ref_start + k));
                k = k + 1;
            end
        end
    end

    sb = sb_new();
    i = 0;
    when i < vec_len(out_buf) loop
        sb_append_byte(sb, vec_get(out_buf, i));
        i = i + 1;
    end
    out sb_build(sb);
end
