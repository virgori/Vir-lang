##
 * vir/prelude.vri — Stdlib Prelude
 * ==================================
 * Tự động import cho mọi chương trình Vir.
 * (Auto-imported for every Vir program.)
 *
 * Gồm các type, func cơ bản nhất mà hầu end chương trình đều cần.
 * Giữ gọn — chỉ export những gì thực sự phổ var.
 ##

# ═══════════════════════════════════════════════════════
# Core primitives & type aliases
# ═══════════════════════════════════════════════════════
include types
#   -> bool, i8, i16, i32, i64, u8, u16, u32, u64,
#     f32, f64, usize, isize, char
#   -> I8_MIN..I64_MAX, U8_MAX..U64_MAX, F32_EPSILON, etc.

# ═══════════════════════════════════════════════════════
# Option of (T) & Result of (T, E)
# ═══════════════════════════════════════════════════════
import Option, Some, None from option
    is_some, is_none, unwrap, unwrap_or, map_option
import Result, Success, Failure from result
    isSuccess, isFailure, unwrapFailure, mapFailure

# ═══════════════════════════════════════════════════════
# Checked arithmetic
# ═══════════════════════════════════════════════════════
import checked_add, checked_sub, checked_mul, checked_div from ops

# ═══════════════════════════════════════════════════════
# Strings (UTF-8)
# ═══════════════════════════════════════════════════════
import String, str_new, str_len, str_concat from string
    str_eq, str_contains, str_starts_with, str_ends_with,
    str_split, str_trim, str_to_lower, str_to_upper,
    str_index_of, str_replace, str_slice
import StringBuilder, sb_new, sb_append, sb_build from builder

# ═══════════════════════════════════════════════════════
# I/O — stdin / stdout / stderr
# ═══════════════════════════════════════════════════════
import print, println, eprint, eprintln, read_line from stdio
import format from format

# ═══════════════════════════════════════════════════════
# Collections
# ═══════════════════════════════════════════════════════
import Vec, vec_new, vec_push, vec_pop from vec
    vec_len, vec_get, vec_set, vec_is_empty
import Map, map_new, map_set, map_get from map
    map_remove, map_contains, map_len
import Set, set_new, set_insert, set_contains from set
    set_remove, set_len

# ═══════════════════════════════════════════════════════
# Memory basics
# ═══════════════════════════════════════════════════════
import alloc, dealloc from alloc
import Slice, slice_new, slice_len, slice_get from slice

# ═══════════════════════════════════════════════════════
# Error handling
# ═══════════════════════════════════════════════════════
import Error, error_new, error_message from error

# ═══════════════════════════════════════════════════════
# Debug / assertions
# ═══════════════════════════════════════════════════════
import assert, assert_eq, assert_ne, assert_msg from assert

# ═══════════════════════════════════════════════════════
# Aliases tiếng Việt (Vietnamese convenience names)
# ═══════════════════════════════════════════════════════
#
# Không cần alias riêng — các API đã use từ khoá tiếng Việt
#   in()       -> print()      (English alias cũng OK)
#   in_dòng()  -> println()
#
# Nếu cần thêm alias, bổ sung ở đây
#   func in(s: String)      -> print(s)
#   func in_dòng(s: String) -> println(s)
#

##
 * Cách hoạt động
 *   Compiler tự động chèn `import "vir/prelude" use all`
 *   vào đầu mỗi file .vri if file không có `#![no_prelude]`.
 *
 * Nếu muốn tắt prelude cho một file cụ thể
 *   #![no_prelude]
 *   import "vir/core/types" use i32, bool   # import thủ công
 ##
