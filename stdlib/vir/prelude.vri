/*
 * vir/prelude.vri — Stdlib Prelude
 * ==================================
 * Tự động import cho mọi chương trình Vir.
 * (Auto-imported for every Vir program.)
 *
 * Gồm các type, func cơ bản nhất mà hầu end chương trình đều cần.
 * Giữ gọn — chỉ export những gì thực sự phổ var.
 */

# ═══════════════════════════════════════════════════════
# Core primitives & type aliases
# ═══════════════════════════════════════════════════════
import "vir/core/types" use all
#   -> bool, i8, i16, i32, i64, u8, u16, u32, u64,
#     f32, f64, usize, isize, char
#   -> I8_MIN..I64_MAX, U8_MAX..U64_MAX, F32_EPSILON, etc.

# ═══════════════════════════════════════════════════════
# Option<T> & Result<T, E>
# ═══════════════════════════════════════════════════════
import "vir/core/option" use Option, Some, None,
    is_some, is_none, unwrap, unwrap_or, map_option
import "vir/core/result" use Result, Ok, Err,
    is_ok, is_err, unwrap_result, unwrap_or_result, map_result, map_err

# ═══════════════════════════════════════════════════════
# Checked arithmetic
# ═══════════════════════════════════════════════════════
import "vir/core/ops" use checked_add, checked_sub, checked_mul, checked_div

# ═══════════════════════════════════════════════════════
# Strings (UTF-8)
# ═══════════════════════════════════════════════════════
import "vir/str/string" use String, str_new, str_len, str_concat,
    str_eq, str_contains, str_starts_with, str_ends_with,
    str_split, str_trim, str_to_lower, str_to_upper,
    str_index_of, str_replace, str_slice
import "vir/str/builder" use StringBuilder, sb_new, sb_append, sb_build

# ═══════════════════════════════════════════════════════
# I/O — stdin / stdout / stderr
# ═══════════════════════════════════════════════════════
import "vir/io/stdio" use print, println, eprint, eprintln, read_line
import "vir/io/format" use format

# ═══════════════════════════════════════════════════════
# Collections
# ═══════════════════════════════════════════════════════
import "vir/collections/vec" use Vec, vec_new, vec_push, vec_pop,
    vec_len, vec_get, vec_set, vec_is_empty
import "vir/collections/map" use Map, map_new, map_set, map_get,
    map_remove, map_contains, map_len
import "vir/collections/set" use Set, set_new, set_insert, set_contains,
    set_remove, set_len

# ═══════════════════════════════════════════════════════
# Memory basics
# ═══════════════════════════════════════════════════════
import "vir/mem/alloc" use alloc, dealloc
import "vir/mem/slice" use Slice, slice_new, slice_len, slice_get

# ═══════════════════════════════════════════════════════
# Error handling
# ═══════════════════════════════════════════════════════
import "vir/error/error" use Error, error_new, error_message

# ═══════════════════════════════════════════════════════
# Debug / assertions
# ═══════════════════════════════════════════════════════
import "vir/debug/assert" use assert, assert_eq, assert_ne, assert_msg

# ═══════════════════════════════════════════════════════
# Aliases tiếng Việt (Vietnamese convenience names)
# ═══════════════════════════════════════════════════════
#
# Không cần alias riêng — các API đã use từ khoá tiếng Việt:
#   in()       -> print()      (English alias cũng OK)
#   in_dòng()  -> println()
#
# Nếu cần thêm alias, bổ sung ở đây:
#   func in(s: String)      -> print(s)
#   func in_dòng(s: String) -> println(s)
#

/*
 * Cách hoạt động:
 *   Compiler tự động chèn `import "vir/prelude" use all`
 *   vào đầu mỗi file .vri if file không có `#![no_prelude]`.
 *
 * Nếu muốn tắt prelude cho một file cụ thể:
 *   #![no_prelude]
 *   import "vir/core/types" use i32, bool   # import thủ công
 */
