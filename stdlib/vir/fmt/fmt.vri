##
 * vir/fmt/fmt.vri — Runtime $ templates (registry fmt.md)
 * ==========================================================
 * Positional $0 / $(0:d) / $$ escape. Returns Result of (string).
 ##

include types
include string
import str_new, str_from_bytes, str_concat, str_to_upper, str_join from string
include vec
import Vec, vec_new, vec_push, vec_len, vec_get, vec_set from vec
include result
import Result, Ok, Err from result
include format
import format from format
include stdio
import print, println from stdio

enum FmtArgTag:
    FmtTagInt   = 1
    FmtTagFloat = 2
    FmtTagStr   = 3
    FmtTagBool  = 4
end.

entity FmtArg:
    tag:     FmtArgTag,
        int_val: int,
        flt_val: float,
        str_val: string,
        bool_val: bool
end.

func _cstrLen(data: int) -> int:
    if data == 0 do out 0 end
    n = 0
    when native_read_u8(data, n) != 0 loop
        n = n + 1
    end
    out n
end.

func _cstrAt(data: int, i: int) -> int:
    out native_read_u8(data, i)
end.

func _cstrSlice(data: int, start: int, stop: int) -> string:
    if start >= stop do out str_new("") end
    out str_from_bytes((data + start) as ptr, stop - start)
end.

func _fmtErr(msg: string):
    out Err(msg)
end.

func _fmtApplySpec(arg: FmtArg, spec: string) -> string:
    tag = arg.tag
    iv = arg.int_val
    fv = arg.flt_val
    sv = arg.str_val
    bv = arg.bool_val
    sp = (spec as ptr) as int
    slen = _cstrLen(sp)
    if slen == 0 do
        if tag == 1 do out format.int(iv) end
        if tag == 2 do out format.floatFixed(fv, 6) end
        if tag == 3 do out sv end
        if tag == 4 do out format.bool(bv) end
        out str_new("?")
    end
    fmt_char = _cstrAt(sp, slen - 1)
    if fmt_char == 0x64 do out format.int(iv) end
    if fmt_char == 0x78 do out format.intRadix(iv, 16) end
    if fmt_char == 0x58 do out str_to_upper(format.intRadix(iv, 16)) end
    if fmt_char == 0x62 do out format.intRadix(iv, 2) end
    if fmt_char == 0x6F do out format.intRadix(iv, 8) end
    if fmt_char == 0x66 do out format.floatFixed(fv, 6) end
    if fmt_char == 0x73 do out sv end
    out str_new("?")
end.

func _fmtRender(template: string, args: Vec of (FmtArg)):
    tpl = (template as ptr) as int
    tlen = _cstrLen(tpl)
    alen = vec_len of (FmtArg)(args)
    used = vec_new of (int)()
    k = 0
    when k < alen loop
        used = vec_push of (int)(used, 0)
        k = k + 1
    end
    max_idx = -1
    parts = vec_new of (string)()
    run_start = 0
    i = 0
    when i < tlen loop
        c = _cstrAt(tpl, i)
        if c != 0x24 do
            i = i + 1
            skip
        end
        if i > run_start do
            parts = vec_push of (string)(parts, _cstrSlice(tpl, run_start, i))
        end
        if i + 1 < tlen do
            if _cstrAt(tpl, i + 1) == 0x24 do
                parts = vec_push of (string)(parts, str_new("$"))
                i = i + 2
                run_start = i
                skip
            end
        end
        i = i + 1
        if i >= tlen do out _fmtErr(str_new("invalid placeholder syntax")) end
        spec = str_new("")
        idx = 0
        if _cstrAt(tpl, i) == 0x28 do
            i = i + 1
            idx = 0
            started = false
            when i < tlen loop
                ch = _cstrAt(tpl, i)
                if ch == 0x3A do skip end
                if ch < 48 or ch > 57 do out _fmtErr(str_new("invalid placeholder syntax")) end
                idx = idx * 10 + (ch - 48)
                started = true
                i = i + 1
            end
            if started == false do out _fmtErr(str_new("invalid placeholder syntax")) end
            if i >= tlen or _cstrAt(tpl, i) != 0x3A do out _fmtErr(str_new("invalid placeholder syntax")) end
            i = i + 1
            spec_start = i
            found_rparen = false
            when i < tlen loop
                if _cstrAt(tpl, i) == 0x29 do
                    spec = _cstrSlice(tpl, spec_start, i)
                    i = i + 1
                    found_rparen = true
                    skip
                end
                i = i + 1
            end
            if found_rparen == false do out _fmtErr(str_new("invalid placeholder syntax")) end
        else
            idx = 0
            started = false
            when i < tlen loop
                ch = _cstrAt(tpl, i)
                if ch < 48 or ch > 57 do skip end
                idx = idx * 10 + (ch - 48)
                started = true
                i = i + 1
            end
            if started == false do out _fmtErr(str_new("invalid placeholder syntax")) end
        end
        if idx >= alen do out _fmtErr(str_new("missing format argument")) end
        vec_set of (int)(used, idx, 1)
        if idx > max_idx do max_idx = idx end
        arg = vec_get of (FmtArg)(args, idx)
        piece = _fmtApplySpec(arg, spec)
        parts = vec_push of (string)(parts, piece)
        run_start = i
    end
    if run_start < tlen do
        parts = vec_push of (string)(parts, _cstrSlice(tpl, run_start, tlen))
    end
    if max_idx < 0 do
        if alen != 0 do out _fmtErr(str_new("extra format argument")) end
        out Ok(str_join(parts, str_new("")))
    end
    if alen != max_idx + 1 do out _fmtErr(str_new("extra format argument")) end
    u = 0
    when u <= max_idx loop
        if vec_get of (int)(used, u) == 0 do out _fmtErr(str_new("extra format argument")) end
        u = u + 1
    end
    out Ok(str_join(parts, str_new("")))
end.

func fmt_must(template: string, args: Vec of (FmtArg)) -> string:
    r = _fmtRender(template, args)
    case r
        Ok(s): out s
        Err(_): panic("fmt: format error")
    end
    panic("fmt: unreachable result variant")
end.

entity FmtNamespace:
    method int(n: int) -> FmtArg:
        out FmtArg ( tag: 1, int_val: n, flt_val: 0.0, str_val: str_new(""), bool_val: false )
    end.

    method str(s: string) -> FmtArg:
        out FmtArg ( tag: 3, int_val: 0, flt_val: 0.0, str_val: s, bool_val: false )
    end.

    method bool(value: bool) -> FmtArg:
        out FmtArg ( tag: 4, int_val: 0, flt_val: 0.0, str_val: str_new(""), bool_val: value )
    end.

    method format(template: string, args: Vec of (FmtArg)):
        out _fmtRender(template, args)
    end.

    method printf(template: string, args: Vec of (FmtArg)):
        print(fmt_must(template, args))
    end.

    method printfln(template: string, args: Vec of (FmtArg)):
        println(fmt_must(template, args))
    end.
end.

var fmt: FmtNamespace

func fmt_must1(template: string, a: FmtArg) -> string:
    args = vec_new of (FmtArg)()
    args = vec_push of (FmtArg)(args, a)
    out fmt_must(template, args)
end.

func fmt_must2(template: string, a: FmtArg, b: FmtArg) -> string:
    args = vec_new of (FmtArg)()
    args = vec_push of (FmtArg)(args, a)
    args = vec_push of (FmtArg)(args, b)
    out fmt_must(template, args)
end.

func fmt_must3(template: string, a: FmtArg, b: FmtArg, c: FmtArg) -> string:
    args = vec_new of (FmtArg)()
    args = vec_push of (FmtArg)(args, a)
    args = vec_push of (FmtArg)(args, b)
    args = vec_push of (FmtArg)(args, c)
    out fmt_must(template, args)
end.

func fmt_must4(template: string, a: FmtArg, b: FmtArg, c: FmtArg, d: FmtArg) -> string:
    args = vec_new of (FmtArg)()
    args = vec_push of (FmtArg)(args, a)
    args = vec_push of (FmtArg)(args, b)
    args = vec_push of (FmtArg)(args, c)
    args = vec_push of (FmtArg)(args, d)
    out fmt_must(template, args)
end.

export FmtNamespace, fmt, fmt_must, fmt_must1, fmt_must2, fmt_must3, fmt_must4, FmtArg, FmtArgTag
