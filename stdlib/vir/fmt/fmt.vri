##
 * vir/fmt/fmt.vri — String Formatting (printf-style)
 * ====================================================
 * Inspired by Python: f-strings, str.format()
 * Inspired by C23: printf family, <stdarg.h>
 *
 * Cung cấp format template engine cho Vir.
 * Format spec: "{}" cho auto, "{:d}" int, "{:x}" hex, "{:f}" float,
 *              "{:s}" string, "{:b}" bool, "{:05d}" padded.
 ##

include types;
include string;
import String, str_new, str_byte_at, str_byte_len, str_from_bytes, str_concat from string;
include builder;
import StringBuilder, sb_new, sb_append, sb_append_byte, sb_build, sb_len from builder;
include format;
import format_int, format_hex, format_bin, format_oct, format_float, format_bool, format_pad_left, format_pad_right, format_pad_center from format;

# ═══════════════════════════════════════════════════════
# Format Args — variadic-like via tagged union
# ═══════════════════════════════════════════════════════

enum FmtType:
    Int    = 1;
    Float  = 2;
    Str    = 3;
    Bool   = 4;
    Char   = 5;
    Ptr    = 6;
end

entity FmtArg:
    tag:     FmtType;
    int_val: int;
    flt_val: float;
    str_val: string;
    bool_val: bool;
end

func fmt_int:
    in(v:int)
    out FmtArg { tag = FmtType.Int, int_val = v, flt_val = 0.0, str_val = str_new(""), bool_val = false };
end

func fmt_float:
    in(v:float)
    out FmtArg { tag = FmtType.Float, int_val = 0, flt_val = v, str_val = str_new(""), bool_val = false };
end

func fmt_str:
    in(v:string)
    out FmtArg { tag = FmtType.Str, int_val = 0, flt_val = 0.0, str_val = v, bool_val = false };
end

func fmt_bool:
    in(v:bool)
    out FmtArg { tag = FmtType.Bool, int_val = 0, flt_val = 0.0, str_val = str_new(""), bool_val = v };
end

# ═══════════════════════════════════════════════════════
# format() — Main entry point
# ═══════════════════════════════════════════════════════

func format:
    in(template:string; args:Vec<FmtArg>)
    # Parse template, thay thế {} bằng args tuần tự.
    #
    # Example:
    #   format("Hello {}, bạn {} tuổi!", [fmt_str("Vir"), fmt_int(42)])
    #   -> "Hello Vir, bạn 42 tuổi!"
    #
    #   format("hex: {:x}, bin: {:b}", [fmt_int(255), fmt_int(10)])
    #   -> "hex: ff, bin: 1010"
    
    sb = sb_new();
    len = str_byte_len(template);
    arg_idx = 0;
    i = 0;
    
    when i < len loop
        ch = str_byte_at(template, i);
        
        if ch == 0x7B # '{':
            if i + 1 < len and str_byte_at(template, i + 1) == 0x7B:
                # Escaped {{ -> literal {
                sb_append_byte(&sb, 0x7B);
                i = i + 2;
                skip;
            end
            
            # Parse format spec
            spec_start = i + 1;
            spec_end = spec_start;
            when spec_end < len and str_byte_at(template, spec_end) != 0x7D loop
                spec_end = spec_end + 1;
            end
            
            # Lấy arg
            if arg_idx < vec_len<FmtArg>(args):
                arg = vec_get<FmtArg>(args, arg_idx);
                spec = str_slice_bytes(template, spec_start, spec_end);
                formatted = _format_arg(arg, spec);
                sb_append(&sb, formatted);
                arg_idx = arg_idx + 1;
            else
                sb_append(&sb, str_new("{?}"));
            end
            
            i = spec_end + 1   # skip '}';
            
        eif ch == 0x7D # '}':
            if i + 1 < len and str_byte_at(template, i + 1) == 0x7D:
                # Escaped }} -> literal }
                sb_append_byte(&sb, 0x7D);
                i = i + 2;
                skip;
            end
            sb_append_byte(&sb, ch);
            i = i + 1;
        else
            sb_append_byte(&sb, ch);
            i = i + 1;
        end
    end
    
    out sb_build(sb);
end

# ═══════════════════════════════════════════════════════
# Internal format dispatch
# ═══════════════════════════════════════════════════════

func _format_arg:
    in(arg:FmtArg; spec:string)
    spec_len = str_byte_len(spec);
    
    # Nếu spec empty -> auto format
    if spec_len == 0:
        case arg.tag;
            case FmtType.Int out format_int(arg.int_val, 10)
            case FmtType.Float out format_float(arg.flt_val, 6)
            case FmtType.Str out arg.str_val
            case FmtType.Bool out format_bool(arg.bool_val)
            default out str_new("?");
        end
    end
    
    # Parse spec: ":x", ":b", ":05d", ":>10s", etc.
    if str_byte_at(spec, 0) != 0x3A # not bắt đầu bằng ':':
        out _format_auto(arg);
    end
    
    # Bỏ ':'
    s = str_slice_bytes(spec, 1, spec_len);
    slen = str_byte_len(s);
    if slen == 0 out _format_auto(arg) end:
    
    # Xử lý format char cuối cùng
    fmt_char = str_byte_at(s, slen - 1);
    
    case fmt_char;
        case 0x64 # 'd' decimal
            out format_int(arg.int_val, 10);
        case 0x78 # 'x' hex
            out format_hex(arg.int_val);
        case 0x58 # 'X' HEX uppercase
            out str_to_upper(format_hex(arg.int_val));
        case 0x62 # 'b' binary
            out format_bin(arg.int_val);
        case 0x6F # 'o' octal
            out format_oct(arg.int_val);
        case 0x66 # 'f' float
            out format_float(arg.flt_val, 6);
        case 0x73 # 's' string
            out arg.str_val;
        default;
            out _format_auto(arg);
    end
end

func _format_auto:
    in(arg:FmtArg)
    case arg.tag;
        case FmtType.Int out format_int(arg.int_val, 10)
        case FmtType.Float out format_float(arg.flt_val, 6)
        case FmtType.Str out arg.str_val
        case FmtType.Bool out format_bool(arg.bool_val)
        default out str_new("?");
    end
end

# ═══════════════════════════════════════════════════════
# Convenience — format with 1, 2, 3 args
# ═══════════════════════════════════════════════════════

func format1:
    in(template:string; a:FmtArg)
    args = vec_new<FmtArg>();
    vec_push<FmtArg>(&args, a);
    out format(template, args);
end

func format2:
    in(template:string; a:FmtArg; b:FmtArg)
    args = vec_new<FmtArg>();
    vec_push<FmtArg>(&args, a);
    vec_push<FmtArg>(&args, b);
    out format(template, args);
end

func format3:
    in(template:string; a:FmtArg; b:FmtArg; c:FmtArg)
    args = vec_new<FmtArg>();
    vec_push<FmtArg>(&args, a);
    vec_push<FmtArg>(&args, b);
    vec_push<FmtArg>(&args, c);
    out format(template, args);
end

# ═══════════════════════════════════════════════════════
# println with format (print convenience)
# ═══════════════════════════════════════════════════════

func printf:
    in(template:string; args:Vec<FmtArg>)
    print(format(template, args));
end

func printfln:
    in(template:string; args:Vec<FmtArg>)
    println(format(template, args));
end
