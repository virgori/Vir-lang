##
 * vir/fs/fs.vri — Filesystem Operations
 * ========================================
 * Inspired by Python: os, shutil, pathlib
 * Inspired by C23: <stdio.h> remove/rename, <dirent.h>
 *
 * Thao tác trên filesystem: tạo/del directory, liệt kê, copy, rename...
 ##

include types;
include result;
import Result, Ok, Err from result;
include option;
import Option, Some, None from option;
include string;
import String, str_new, str_concat from string;
include vec;
import Vec, vec_new, vec_push from vec;
include path;
import Path, path_join, path_to_string from path;

# ═══════════════════════════════════════════════════════
# File Metadata
# ═══════════════════════════════════════════════════════

enum FileType:
    Regular    = 1;
    Directory  = 2;
    Symlink    = 3;
    Other      = 0;
end.

entity Metadata:
    size:       int        # bytes,
        file_type:  FileType,
        modified:   int        # unix timestamp (seconds),
        accessed:   int,
        created:    int,
        readonly:   bool;
end.

entity DirEntry:
    name:      string,
        path:      Path,
        file_type: FileType;
end

# ═══════════════════════════════════════════════════════
# Query
# ═══════════════════════════════════════════════════════

func exists:
    in(path:Path)
    out native_path_exists(path_to_string(path).data, path_to_string(path).byte_len);
end.

func is_file:
    in(path:Path)
    meta = metadata(path);
    case meta;
        Ok(m): out m.file_type == FileType.Regular;
        Err(_): out false;
    end
end.

func is_dir:
    in(path:Path)
    meta = metadata(path);
    case meta;
        Ok(m): out m.file_type == FileType.Directory;
        Err(_): out false;
    end
end.

func metadata:
    in(path:Path)
    p = path_to_string(path);
    size = 0;
    ftype = 0;
    mtime = 0;
    atime = 0;
    ctime = 0;
    ro = false;
    
    rc = native_stat(p.data, p.byte_len, &size, &ftype, &mtime, &atime, &ctime, &ro);
    if rc != 0 do out Err(str_new("stat failed")) end
    
    var ft:FileType;
    case ftype;
        case 1 ft = FileType.Regular
        case 2 ft = FileType.Directory
        case 3 ft = FileType.Symlink
        default ft = FileType.Other;
    end
    
    out Ok(Metadata (;
        size = size, file_type = ft,
        modified = mtime, accessed = atime, created = ctime,
        readonly = ro
    ));
end.

func file_size:
    in(path:Path)
    meta = metadata(path);
    case meta;
        Ok(m): out Ok(m.size);
        Err(e): out Err(e);
    end
end

# ═══════════════════════════════════════════════════════
# Directory Operations
# ═══════════════════════════════════════════════════════

func create_dir:
    in(path:Path)
    p = path_to_string(path);
    rc = native_mkdir(p.data, p.byte_len, 0o755);
    if rc != 0 do out Err(str_new("mkdir failed")) end
    out Ok(void);
end.

func create_dir_all:
    in(path:Path)
    # Tạo directory and tất cả directory cha (giống mkdir -p).
    p = path_to_string(path);
    rc = native_mkdir_p(p.data, p.byte_len, 0o755);
    if rc != 0 do out Err(str_new("mkdir -p failed")) end
    out Ok(void);
end.

func remove_dir:
    in(path:Path)
    p = path_to_string(path);
    rc = native_rmdir(p.data, p.byte_len);
    if rc != 0 do out Err(str_new("rmdir failed")) end
    out Ok(void);
end.

func remove_dir_all:
    in(path:Path)
    # Xóa directory đệ quy (giống rm -rf).
    entries = read_dir(path);
    case entries;
        Err(e): out Err(e);
        Ok(list):
            i = 0;
            when i < vec_len<DirEntry>(list) loop
                entry = vec_get<DirEntry>(list, i);
                case entry.file_type;
                    case FileType.Directory
                        result = remove_dir_all(entry.path);
                        if is_err(result) do out result end
                    default;
                        result = remove_file(entry.path);
                        if is_err(result) do out result end
                end
                i = i + 1;
            end
    end
    out remove_dir(path);
end.

func read_dir:
    in(path:Path)
    p = path_to_string(path);
    entries = vec_new<DirEntry>();
    
    dir_handle = native_opendir(p.data, p.byte_len);
    if dir_handle == null do out Err(str_new("opendir failed")) end
    
    loop
        name_ptr = null;
        name_len = 0;
        ftype = 0;
        rc = native_readdir(dir_handle, &name_ptr, &name_len, &ftype);
        if rc != 0 do break end
        
        name = str_from_bytes(name_ptr, name_len);
        # Bỏ qua . and ..
        if str_eq(name, str_new(".")) or str_eq(name, str_new("..")) do
            skip;
        end
        
        var ft:FileType;
        case ftype;
            case 1 ft = FileType.Regular
            case 2 ft = FileType.Directory
            case 3 ft = FileType.Symlink
            default ft = FileType.Other;
        end
        
        vec_push<DirEntry>(&entries, DirEntry (;
            name = name,
            path = path_join(path, name),
            file_type = ft
    ));
    end
    
    native_closedir(dir_handle);
    out Ok(entries);
end

# ═══════════════════════════════════════════════════════
# File Operations
# ═══════════════════════════════════════════════════════

func remove_file:
    in(path:Path)
    p = path_to_string(path);
    rc = native_unlink(p.data, p.byte_len);
    if rc != 0 do out Err(str_new("unlink failed")) end
    out Ok(void);
end.

func rename:
    in(from:Path; to:Path)
    sf = path_to_string(from);
    st = path_to_string(to);
    rc = native_rename(sf.data, sf.byte_len, st.data, st.byte_len);
    if rc != 0 do out Err(str_new("rename failed")) end
    out Ok(void);
end.

func copy_file:
    in(src:Path; dst:Path)
    # Copy file, out số bytes copied.
    sp = path_to_string(src);
    dp = path_to_string(dst);
    
    sf = native_open(sp.data, sp.byte_len, 0)   # O_RDONLY;
    if sf < 0 do out Err(str_new("open src failed")) end
    
    df = native_open(dp.data, dp.byte_len, 577)  # O_WRONLY|O_CREAT|O_TRUNC;
    if df < 0 do
        native_close(sf);
        out Err(str_new("open dst failed"));
    end
    
    buf = alloc(65536);
    total = 0;
    loop
        n = native_read(sf, buf, 65536);
        if n <= 0 do break end
        w = native_write(df, buf, n);
        if w != n do
            free(buf);
            native_close(sf);
            native_close(df);
            out Err(str_new("write failed"));
        end
        total = total + n;
    end
    
    free(buf);
    native_close(sf);
    native_close(df);
    out Ok(total);
end

# ═══════════════════════════════════════════════════════
# Symlinks
# ═══════════════════════════════════════════════════════

func symlink:
    in(target:Path; link:Path)
    t = path_to_string(target);
    l = path_to_string(link);
    rc = native_symlink(t.data, t.byte_len, l.data, l.byte_len);
    if rc != 0 do out Err(str_new("symlink failed")) end
    out Ok(void);
end.

func read_link:
    in(path:Path)
    p = path_to_string(path);
    target_ptr = null;
    target_len = 0;
    rc = native_readlink(p.data, p.byte_len, &target_ptr, &target_len);
    if rc != 0 do out Err(str_new("readlink failed")) end
    out Ok(path_from(str_from_bytes(target_ptr, target_len)));
end

# ═══════════════════════════════════════════════════════
# Temp Files
# ═══════════════════════════════════════════════════════

func temp_file:
    in(prefix:string)
    # Tạo tempfile in temp_dir().
    tmp = temp_dir();
    name = str_concat(prefix, str_concat(str_new("_"), i64_to_str(unix_timestamp_nanos())));
    p = path_join(path_from(tmp), name);
    out Ok(p);
end
