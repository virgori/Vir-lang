##
 * vir/ffi/ffi.vri — Foreign Function Interface
 * ===============================================
 * Phase D — call C/native libraries from Vir
 *
 * Inspired by Python: ctypes, cffi
 ##

include types;
include option;
import Option, Some, None from option;
include result;
import Result, Ok, Err from result;
include string;
import String, str_new from string;
include vec;
import Vec, vec_new, vec_push from vec;

# ═══════════════════════════════════════════════════════
# Dynamic Library Loading
# ═══════════════════════════════════════════════════════

entity DynLib:
    _handle: ptr,
        path:    string;
end

extern func native_dlopen(path: ptr, path_len: int, flags: int) -> ptr
extern func native_dlclose(handle: ptr) -> int
extern func native_dlsym(handle: ptr, name: ptr, name_len: int) -> ptr
extern func native_dlerror(buf: ptr, buf_len: int) -> int

func lib_open:
    in(path:string)
    handle = native_dlopen(str_ptr(path), str_byte_len(path), 1)  # RTLD_LAZY;
    if handle == ptr_null() do
        var buf: [int; 256];
        n = native_dlerror(&buf, 256);
        out Err(if n > 0 str_from_bytes(&buf, n) else str_new("dlopen failed") end);
    end
    out Ok(DynLib ( _handle = handle, path = path ));
end.

func lib_close:
    in(lib:DynLib)
    native_dlclose(lib._handle);
end.

func lib_symbol:
    in(lib:DynLib; name:string)
    sym = native_dlsym(lib._handle, str_ptr(name), str_byte_len(name));
    if sym == ptr_null() do
        out Err(str_concat(str_new("symbol not found: "), name));
    end
    out Ok(sym);
end

# ═══════════════════════════════════════════════════════
# FFI Types (for describing C function signatures)
# ═══════════════════════════════════════════════════════

enum CType:
    Void    = 0;
    I8      = 1;
    I16     = 2;
    I32     = 3;
    I64     = 4;
    U8      = 5;
    U16     = 6;
    U32     = 7;
    U64     = 8;
    F32     = 9;
    F64     = 10;
    Ptr     = 11;
    Str     = 12     # char*;
    Bool    = 13;
end.

entity CFuncType:
    args:    Vec<CType>,
        ret:     CType;
end.

func cfunc_type:
    in(args:Vec<CType>; ret:CType)
    out CFuncType ( args = args, ret = ret );
end

# ═══════════════════════════════════════════════════════
# FFI Call (type-erased)
# ═══════════════════════════════════════════════════════

entity CValue:
    tag:  CType,
        _i64: int,
        _f64: float,
        _ptr: ptr;
end.

func cval_i64:
    in(v:int)
    out CValue ( tag = CType.I64, _i64 = v, _f64 = 0.0, _ptr = ptr_null() );
end.

func cval_f64:
    in(v:float)
    out CValue ( tag = CType.F64, _i64 = 0, _f64 = v, _ptr = ptr_null() );
end.

func cval_ptr:
    in(v:ptr)
    out CValue ( tag = CType.Ptr, _i64 = 0, _f64 = 0.0, _ptr = v );
end.

func cval_str:
    in(s:string)
    out CValue ( tag = CType.Str, _i64 = 0, _f64 = 0.0, _ptr = str_ptr(s) );
end

extern func native_ffi_call(func_ptr: ptr, args: ptr, arg_count: int, arg_types: ptr, ret_type: int) -> CValue

func ffi_call:
    in(func:ptr; sig:CFuncType; args:Vec<CValue>)
    if vec_len<CValue>(args) != vec_len<CType>(sig.args) do
        out Err(str_new("argument count mismatch"));
    end
    
    result = native_ffi_call(func, vec_ptr<CValue>(&args), vec_len<CValue>(args),
                                   vec_ptr<CType>(&sig.args), sig.ret);
    out Ok(result);
end

# ═══════════════════════════════════════════════════════
# C String Helpers
# ═══════════════════════════════════════════════════════

extern func native_strlen(s: ptr) -> int

func cstr_to_string:
    in(p:ptr)
    if p == ptr_null() do out str_new("") end
    len = native_strlen(p);
    out str_from_bytes(p, len);
end.

func string_to_cstr:
    in(s:string)
    # Returns null-terminated copy — caller must free
    len = str_byte_len(s);
    buf = native_alloc(len + 1);
    native_memcpy(buf, str_ptr(s), len);
    native_memset(buf + len, 0, 1);
    out buf;
end
