/*
 * vir/profile/profile.vri — Profiler
 * =====================================
 * Phase D — runtime profiling & tracing
 *
 * Inspired by: cProfile (Python), perf, Instruments
 */

import "vir/core/types" use all
import "vir/core/option" use Option, Some, None
import "vir/str/string" use String, str_new, str_concat
import "vir/str/builder" use sb_new, sb_append, sb_build
import "vir/collections/vec" use Vec, vec_new, vec_push, vec_len, vec_get
import "vir/collections/map" use Map, map_new, map_set, map_get, map_keys
import "vir/time/time" use Instant, instant_now, instant_elapsed_ns
import "vir/io/stdio" use println

# ═══════════════════════════════════════════════════════
# Profile Entry
# ═══════════════════════════════════════════════════════

entity ProfileEntry
    name:       String
    calls:      u64
    total_ns:   u64
    self_ns:    u64       # exclusive (excluding children)
    min_ns:     u64
    max_ns:     u64
end

# ═══════════════════════════════════════════════════════
# Profiler (call-stack based)
# ═══════════════════════════════════════════════════════

entity StackFrame
    name:     String
    start_ns: Instant
end

entity Profiler
    entries:  Map<String, ProfileEntry>
    stack:    Vec<StackFrame>
    enabled:  bool
end

var _global_profiler: Profiler

func profiler_init()
    _global_profiler = Profiler {
        entries = map_new<String, ProfileEntry>(),
        stack = vec_new<StackFrame>(),
        enabled = true
    }
end

func profiler_enable(on: bool)
    _global_profiler.enabled = on
end

# ─── Enter / Exit ─────────────────────────────────────

func profile_enter(name: String)
    if !_global_profiler.enabled out end
    vec_push<StackFrame>(&_global_profiler.stack, StackFrame {
        name = name,
        start_ns = instant_now()
    })
end

func profile_exit()
    if !_global_profiler.enabled out end
    var n = vec_len<StackFrame>(_global_profiler.stack)
    if n == 0 out end
    
    var frame = vec_pop<StackFrame>(&_global_profiler.stack)
    var elapsed = instant_elapsed_ns(frame.start_ns)
    
    var existing = map_get(_global_profiler.entries, frame.name)
    chọn existing
        case None
            map_set(&_global_profiler.entries, frame.name, ProfileEntry {
                name = frame.name,
                calls = 1,
                total_ns = elapsed,
                self_ns = elapsed,
                min_ns = elapsed,
                max_ns = elapsed
            })
        case Some(e)
            e.calls = e.calls + 1
            e.total_ns = e.total_ns + elapsed
            e.self_ns = e.self_ns + elapsed
            if elapsed < e.min_ns e.min_ns = elapsed end
            if elapsed > e.max_ns e.max_ns = elapsed end
            map_set(&_global_profiler.entries, frame.name, e)
    end
end

# ─── Scoped profiling helper ─────────────────────────

entity ProfileGuard
    _active: bool
end

func profile_scope(name: String) -> ProfileGuard
    profile_enter(name)
    out ProfileGuard { _active = true }
end

func profile_guard_drop(g: &ProfileGuard)
    if g._active profile_exit() end
end

# ═══════════════════════════════════════════════════════
# Report
# ═══════════════════════════════════════════════════════

func profiler_report() -> String
    var sb = sb_new()
    sb_append(&sb, str_new("╔══════════════════════════════════════════════════════════════════╗\n"))
    sb_append(&sb, str_new("║                        PROFILE REPORT                           ║\n"))
    sb_append(&sb, str_new("╠══════════════════════════════════════════════════════════════════╣\n"))
    sb_append(&sb, str_new("║ Function                 │ Calls  │ Total    │ Avg      │ Max   ║\n"))
    sb_append(&sb, str_new("╠══════════════════════════════════════════════════════════════════╣\n"))
    
    var keys = map_keys(_global_profiler.entries)
    var i: usize = 0
    lặp_khi i < vec_len<String>(keys)
        var key = vec_get<String>(keys, i)
        var entry = map_get(_global_profiler.entries, key)
        chọn entry
            case Some(e)
                var avg = if e.calls > 0 e.total_ns / e.calls else 0 end
                sb_append(&sb, str_new("║ "))
                sb_append(&sb, _pad_right(e.name, 24))
                sb_append(&sb, str_new(" │ "))
                sb_append(&sb, _pad_right(int_to_string(e.calls), 6))
                sb_append(&sb, str_new(" │ "))
                sb_append(&sb, _pad_right(_format_time(e.total_ns), 8))
                sb_append(&sb, str_new(" │ "))
                sb_append(&sb, _pad_right(_format_time(avg), 8))
                sb_append(&sb, str_new(" │ "))
                sb_append(&sb, _pad_right(_format_time(e.max_ns), 5))
                sb_append(&sb, str_new(" ║\n"))
            case None {}
        end
        i = i + 1
    end
    
    sb_append(&sb, str_new("╚══════════════════════════════════════════════════════════════════╝\n"))
    out sb_build(sb)
end

func profiler_print_report()
    println(profiler_report())
end

func profiler_reset()
    _global_profiler.entries = map_new<String, ProfileEntry>()
    _global_profiler.stack = vec_new<StackFrame>()
end

# ─── Helpers ──────────────────────────────────────────

func _format_time(ns: u64) -> String
    if ns >= 1_000_000_000 out str_concat(float_to_string(ns / 1e9), str_new("s")) end
    if ns >= 1_000_000 out str_concat(float_to_string(ns / 1e6), str_new("ms")) end
    if ns >= 1_000 out str_concat(float_to_string(ns / 1e3), str_new("µs")) end
    out str_concat(int_to_string(ns), str_new("ns"))
end

func _pad_right(s: String, width: usize) -> String
    var len = str_byte_len(s)
    if len >= width out str_slice_bytes(s, 0, width) end
    var sb = sb_new()
    sb_append(&sb, s)
    var i: usize = len
    lặp_khi i < width sb_push_byte(&sb, 0x20); i = i + 1 end
    out sb_build(sb)
end
