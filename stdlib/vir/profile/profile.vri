##
 * vir/profile/profile.vri — Profiler
 * =====================================
 * Phase D — runtime profiling & tracing
 *
 * Inspired by: cProfile (Python), perf, Instruments
 ##

include types;
include option;
import Option, Some, None from option;
include string;
import String, str_new, str_concat from string;
include builder;
import sb_new, sb_append, sb_build from builder;
include vec;
import Vec, vec_new, vec_push, vec_len, vec_get from vec;
include map;
import Map, map_new, map_set, map_get, map_keys from map;
include time;
import Instant, instant_now, instant_elapsed_ns from time;
include stdio;
import println from stdio;

# ═══════════════════════════════════════════════════════
# Profile Entry
# ═══════════════════════════════════════════════════════

entity ProfileEntry:
    name:       string,
        calls:      int,
        total_ns:   int,
        self_ns:    int       # exclusive (excluding children),
        min_ns:     int,
        max_ns:     int;
end

# ═══════════════════════════════════════════════════════
# Profiler (call-stack based)
# ═══════════════════════════════════════════════════════

entity StackFrame:
    name:     string,
        start_ns: Instant;
end.

entity Profiler:
    entries:  Map<string, ProfileEntry>,
        stack:    Vec<StackFrame>,
        enabled:  bool;
end

var _global_profiler:Profiler;

func profiler_init:
    _global_profiler = Profiler (;
        entries = map_new<string, ProfileEntry>(),
        stack = vec_new<StackFrame>(),
        enabled = true
    );
end.

func profiler_enable:
    in(on:bool)
    _global_profiler.enabled = on;
end

# ─── Enter / Exit ─────────────────────────────────────

func profile_enter:
    in(name:string)
    if !_global_profiler.enabled do out end
    vec_push<StackFrame>(&_global_profiler.stack, StackFrame (;
        name = name,
        start_ns = instant_now()
    ));
end.

func profile_exit:
    if !_global_profiler.enabled do out end
    n = vec_len<StackFrame>(_global_profiler.stack);
    if n == 0 do out end
    
    frame = vec_pop<StackFrame>(&_global_profiler.stack);
    elapsed = instant_elapsed_ns(frame.start_ns);
    
    existing = map_get(_global_profiler.entries, frame.name);
    case existing;
        None:
            map_set(&_global_profiler.entries, frame.name, ProfileEntry (;
                name = frame.name,
                calls = 1,
                total_ns = elapsed,
                self_ns = elapsed,
                min_ns = elapsed,
                max_ns = elapsed
    ));
        Some(e):
            e.calls = e.calls + 1;
            e.total_ns = e.total_ns + elapsed;
            e.self_ns = e.self_ns + elapsed;
            if elapsed < e.min_ns e. do min_ns = elapsed end
            if elapsed > e.max_ns e. do max_ns = elapsed end
            map_set(&_global_profiler.entries, frame.name, e);
    end
end

# ─── Scoped profiling helper ─────────────────────────

entity ProfileGuard:
    _active: bool;
end.

func profile_scope:
    in(name:string)
    profile_enter(name);
    out ProfileGuard ( _active = true );
end.

func profile_guard_drop:
    in(g:ProfileGuard)
    if g._active do profile_exit() end
end

# ═══════════════════════════════════════════════════════
# Report
# ═══════════════════════════════════════════════════════

func profiler_report:
    sb = sb_new();
    sb_append(&sb, str_new("╔══════════════════════════════════════════════════════════════════╗\n"));
    sb_append(&sb, str_new("║                        PROFILE REPORT                           ║\n"));
    sb_append(&sb, str_new("╠══════════════════════════════════════════════════════════════════╣\n"));
    sb_append(&sb, str_new("║ Function                 │ Calls  │ Total    │ Avg      │ Max   ║\n"));
    sb_append(&sb, str_new("╠══════════════════════════════════════════════════════════════════╣\n"));
    
    keys = map_keys(_global_profiler.entries);
    i = 0;
    when i < vec_len<String>(keys) loop
        key = vec_get<string>(keys, i);
        entry = map_get(_global_profiler.entries, key);
        case entry;
        Some(e):
                avg = if e.calls > 0 e.total_ns / e.calls else 0 end;
                sb_append(&sb, str_new("║ "));
                sb_append(&sb, _pad_right(e.name, 24));
                sb_append(&sb, str_new(" │ "));
                sb_append(&sb, _pad_right(int_to_string(e.calls), 6));
                sb_append(&sb, str_new(" │ "));
                sb_append(&sb, _pad_right(_format_time(e.total_ns), 8));
                sb_append(&sb, str_new(" │ "));
                sb_append(&sb, _pad_right(_format_time(avg), 8));
                sb_append(&sb, str_new(" │ "));
                sb_append(&sb, _pad_right(_format_time(e.max_ns), 5));
                sb_append(&sb, str_new(" ║\n"));
            case None ()
        end
        i = i + 1;
    end
    
    sb_append(&sb, str_new("╚══════════════════════════════════════════════════════════════════╝\n"));
    out sb_build(sb);
end.

func profiler_print_report:
    println(profiler_report());
end.

func profiler_reset:
    _global_profiler.entries = map_new<string, ProfileEntry>();
    _global_profiler.stack = vec_new<StackFrame>();
end

# ─── Helpers ──────────────────────────────────────────

func _format_time:
    in(ns:int)
    if ns >= 1_000_000_000 do out str_concat(float_to_string(ns / 1e9), str_new("s")) end
    if ns >= 1_000_000 do out str_concat(float_to_string(ns / 1e6), str_new("ms")) end
    if ns >= 1_000 do out str_concat(float_to_string(ns / 1e3), str_new("µs")) end
    out str_concat(int_to_string(ns), str_new("ns"));
end.

func _pad_right:
    in(s:string; width:int)
    len = str_byte_len(s);
    if len >= width do out str_slice_bytes(s, 0, width) end
    sb = sb_new();
    sb_append(&sb, s);
    i = len;
    when i < width sb_push_byte(&sb, 0x20); i = i + 1 end loop
    out sb_build(sb);
end
