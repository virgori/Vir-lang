##
 * vir/iot/serial.vri — Serial / UART Communication
 * ====================================================
 * Inspired by C: termios.h
 * Inspired by Python: pyserial
 * Inspired by Rust: serialport crate
 *
 * Full serial port interface: baud rate, parity, stop bits,
 * flow control, timeout reads.
 ##

include types;
include result;
import Result, Ok, Err from result;
include option;
import Option, Some, None from option;
include string;
import String, str_new from string;

# ═══════════════════════════════════════════════════════
# Configuration enums
# ═══════════════════════════════════════════════════════

enum Parity:
    ParityNone = 0;
    ParityOdd  = 1;
    ParityEven = 2;
end.

enum StopBits:
    One = 1;
    Two = 2;
end.

enum FlowControl:
    FlowNone     = 0;
    FlowHardware = 1;    # RTS/CTS
    FlowSoftware = 2;    # XON/XOFF
end

# Common baud rates
const BAUD_9600:   9600;
const BAUD_19200:  19200;
const BAUD_38400:  38400;
const BAUD_57600:  57600;
const BAUD_115200: 115200;
const BAUD_230400: 230400;
const BAUD_460800: 460800;
const BAUD_921600: 921600;

# ═══════════════════════════════════════════════════════
# Serial Port Entity
# ═══════════════════════════════════════════════════════

entity SerialConfig:
    baud_rate:    int,
        data_bits:    int;         # 5, 6, 7, or 8
    parity:       Parity,
        stop_bits:    StopBits,
        flow_control: FlowControl,
        timeout_ms:   int;         # read timeout (0 = blocking)
end.

entity SerialPort:
    path:   string,
        config: SerialConfig,
        _fd:    int;
end

# ═══════════════════════════════════════════════════════
# Native bindings
# ═══════════════════════════════════════════════════════

extern func native_serial_open(path: ptr, path_len: int) -> int
extern func native_serial_close(fd: int)
extern func native_serial_configure(fd: int, baud: int, data_bits: int,
                                     parity: int, stop_bits: int,
                                     flow: int, timeout_ms: int) -> int
extern func native_serial_read(fd: int, buf: ptr, max_len: int) -> int
extern func native_serial_write(fd: int, buf: ptr, len: int) -> int
extern func native_serial_flush(fd: int) -> int
extern func native_serial_available(fd: int) -> int
extern func native_serial_set_dtr(fd: int, val: int) -> int
extern func native_serial_set_rts(fd: int, val: int) -> int

# ═══════════════════════════════════════════════════════
# API
# ═══════════════════════════════════════════════════════

func serial_config_default:
    out SerialConfig {
        baud_rate = BAUD_115200,
        data_bits = 8,
        parity = Parity.ParityNone,
        stop_bits = StopBits.One,
        flow_control = FlowControl.FlowNone,
        timeout_ms = 1000
    };
end

## Open a serial port (e.g. "/dev/ttyUSB0", "/dev/ttyACM0").
func serial_open:
    in(path: string; cfg: SerialConfig)
    fd = native_serial_open(str_ptr(path), str_byte_len(path));
    if fd < 0 do
        out Err(str_new("failed to open serial port"));
    end
    rc = native_serial_configure(fd, cfg.baud_rate, cfg.data_bits,
                                  cfg.parity, cfg.stop_bits,
                                  cfg.flow_control, cfg.timeout_ms);
    if rc < 0 do
        native_serial_close(fd);
        out Err(str_new("failed to configure serial port"));
    end
    out Ok(SerialPort { path = path, config = cfg, _fd = fd });
end

## Close the serial port.
func serial_close:
    in(port: SerialPort)
    native_serial_close(port._fd);
end

## Read bytes from serial port. Returns number of bytes read.
func serial_read:
    in(port: SerialPort; buf: ptr; max_len: int)
    n = native_serial_read(port._fd, buf, max_len);
    if n < 0 do out Err(str_new("serial read failed")) end
    out Ok(n);
end

## Write bytes to serial port. Returns number of bytes written.
func serial_write:
    in(port: SerialPort; buf: ptr; len: int)
    n = native_serial_write(port._fd, buf, len);
    if n < 0 do out Err(str_new("serial write failed")) end
    out Ok(n);
end

## Write a string to serial port.
func serial_write_str:
    in(port: SerialPort; s: string)
    out serial_write(port, str_ptr(s), str_byte_len(s));
end

## Read a line (until '\n'). Max 1024 bytes.
func serial_read_line:
    in(port: SerialPort)
    var buf: [int; 1024];
    pos = 0;
    loop
        rc = native_serial_read(port._fd, ptr_add(&buf, pos), 1);
        if rc <= 0 do break end
        if buf[pos] == 0x0A do
            out Ok(str_from_bytes(&buf, pos));
        end
        pos = pos + 1;
        if pos >= 1024 do break end
    end
    if pos > 0 do
        out Ok(str_from_bytes(&buf, pos));
    end
    out Err(str_new("serial read line timeout"));
end

## Flush output buffer.
func serial_flush:
    in(port: SerialPort)
    native_serial_flush(port._fd);
end

## Get number of bytes available to read.
func serial_available:
    in(port: SerialPort)
    out native_serial_available(port._fd);
end

## Set DTR (Data Terminal Ready) line.
func serial_set_dtr:
    in(port: SerialPort; val: bool)
    native_serial_set_dtr(port._fd, if val do 1; else 0; end);
end

## Set RTS (Request To Send) line.
func serial_set_rts:
    in(port: SerialPort; val: bool)
    native_serial_set_rts(port._fd, if val do 1; else 0; end);
end

## Change baud rate on the fly.
func serial_set_baud:
    in(port: SerialPort; baud: int)
    port.config.baud_rate = baud;
    native_serial_configure(port._fd, baud, port.config.data_bits,
                             port.config.parity, port.config.stop_bits,
                             port.config.flow_control, port.config.timeout_ms);
end
