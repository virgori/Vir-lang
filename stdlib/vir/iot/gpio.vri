##
 * vir/iot/gpio.vri — GPIO (General Purpose Input/Output)
 * ========================================================
 * Inspired by C: Linux GPIO sysfs / libgpiod
 * Inspired by Python: RPi.GPIO, gpiod
 * Inspired by Rust: gpio-cdev, rppal
 *
 * Abstraction over platform GPIO: Linux sysfs/chardev, direct register
 * access for bare-metal/RTOS targets.
 ##

include types;
include result;
import Result, Ok, Err from result;
include option;
import Option, Some, None from option;
include string;
import String, str_new from string;

# ═══════════════════════════════════════════════════════
# Direction & Value
# ═══════════════════════════════════════════════════════

enum GpioDirection:
    Input  = 0;
    Output = 1;
end
enum GpioEdge:
    None    = 0;
    Rising  = 1;
    Falling = 2;
    Both    = 3;
end
enum GpioPull:
    NoPull   = 0;
    PullUp   = 1;
    PullDown = 2;
end
const GPIO_LOW:  0;
const GPIO_HIGH: 1;

# ═══════════════════════════════════════════════════════
# GPIO Pin Entity
# ═══════════════════════════════════════════════════════

entity GpioChip:
    path:       string,
        num_lines:  int,
        _handle:    ptr;
end
entity GpioPin:
    chip:       GpioChip,
        line:       int,
        direction:  GpioDirection,
        _handle:    ptr;
end

# ═══════════════════════════════════════════════════════
# Native bindings (platform-specific)
# ═══════════════════════════════════════════════════════

extern func native_gpio_chip_open(path: ptr, path_len: int) -> ptr
extern func native_gpio_chip_close(handle: ptr)
extern func native_gpio_chip_lines(handle: ptr) -> int
extern func native_gpio_request_output(chip: ptr, line: int, default_val: int) -> ptr
extern func native_gpio_request_input(chip: ptr, line: int, pull: int) -> ptr
extern func native_gpio_set_value(pin: ptr, val: int) -> int
extern func native_gpio_get_value(pin: ptr) -> int
extern func native_gpio_set_edge(pin: ptr, edge: int) -> int
extern func native_gpio_wait_event(pin: ptr, timeout_ms: int) -> int
extern func native_gpio_release(pin: ptr)

# ═══════════════════════════════════════════════════════
# Chip API
# ═══════════════════════════════════════════════════════

## Open a GPIO chip by device path (e.g. "/dev/gpiochip0")
func gpio_chip_open:
    in(path: string)
    h = native_gpio_chip_open(str_ptr(path), str_byte_len(path));
    if h == ptr_null() do
        out Err(str_new("failed to open GPIO chip"));
    end
    n = native_gpio_chip_lines(h);
    out Ok(GpioChip ( path = path, num_lines = n, _handle = h ));
end
## Close the chip.
func gpio_chip_close:
    in(chip: GpioChip)
    native_gpio_chip_close(chip._handle);
end
# ═══════════════════════════════════════════════════════
# Pin API
# ═══════════════════════════════════════════════════════

## Request a pin as output with a default value.
func gpio_output:
    in(chip: GpioChip; line: int; default_val: int)
    h = native_gpio_request_output(chip._handle, line, default_val);
    if h == ptr_null() do
        out Err(str_new("failed to request GPIO output"));
    end
    out Ok(GpioPin (
        chip = chip, line = line,
        direction = GpioDirection.Output, _handle = h
    ));
end
## Request a pin as input with optional pull-up/down.
func gpio_input:
    in(chip: GpioChip; line: int; pull: GpioPull)
    h = native_gpio_request_input(chip._handle, line, pull);
    if h == ptr_null() do
        out Err(str_new("failed to request GPIO input"));
    end
    out Ok(GpioPin (
        chip = chip, line = line,
        direction = GpioDirection.Input, _handle = h
    ));
end
## Set output value (GPIO_HIGH or GPIO_LOW).
func gpio_write:
    in(pin: GpioPin; val: int)
    rc = native_gpio_set_value(pin._handle, val);
    if rc != 0 do out Err(str_new("gpio_write failed")) end
    out Ok(());
end
## Read input value. Returns GPIO_HIGH or GPIO_LOW.
func gpio_read:
    in(pin: GpioPin)
    out native_gpio_get_value(pin._handle);
end
## Toggle output pin.
func gpio_toggle:
    in(pin: GpioPin)
    current = native_gpio_get_value(pin._handle);
    if current == GPIO_LOW do
        native_gpio_set_value(pin._handle, GPIO_HIGH);
    else
        native_gpio_set_value(pin._handle, GPIO_LOW);
    end
end
## Configure edge detection for interrupts.
func gpio_set_edge:
    in(pin: GpioPin; edge: GpioEdge)
    rc = native_gpio_set_edge(pin._handle, edge);
    if rc != 0 do out Err(str_new("gpio_set_edge failed")) end
    out Ok(());
end
## Wait for an edge event with timeout (ms). Returns 1 on event, 0 on timeout.
func gpio_wait_event:
    in(pin: GpioPin; timeout_ms: int)
    out native_gpio_wait_event(pin._handle, timeout_ms);
end
## Release the pin.
func gpio_release:
    in(pin: GpioPin)
    native_gpio_release(pin._handle);
end