##
 * vir/iot/i2c.vri — I²C Bus Interface
 * =======================================
 * Inspired by C: Linux i2c-dev, i2c_smbus_*
 * Inspired by Python: smbus2
 * Inspired by Rust: linux-embedded-hal, i2cdev
 *
 * I²C master communication for sensors, displays, EEPROMs.
 ##

include types;
include result;
import Result, Ok, Err from result;
include string;
import String, str_new from string;
include vec;
import Vec, vec_new, vec_push from vec;

# ═══════════════════════════════════════════════════════
# I2C Bus Entity
# ═══════════════════════════════════════════════════════

entity I2cBus:
    path:    string;       # e.g. "/dev/i2c-1"
    _fd:     int;
end.

entity I2cDevice:
    bus:     I2cBus,
        addr:    int;          # 7-bit slave address
end

# ═══════════════════════════════════════════════════════
# Native bindings
# ═══════════════════════════════════════════════════════

extern func native_i2c_open(path: ptr, path_len: int) -> int
extern func native_i2c_close(fd: int)
extern func native_i2c_set_addr(fd: int, addr: int) -> int
extern func native_i2c_read(fd: int, buf: ptr, len: int) -> int
extern func native_i2c_write(fd: int, buf: ptr, len: int) -> int
extern func native_i2c_smbus_read_byte(fd: int, reg: int) -> int
extern func native_i2c_smbus_write_byte(fd: int, reg: int, val: int) -> int
extern func native_i2c_smbus_read_word(fd: int, reg: int) -> int
extern func native_i2c_smbus_write_word(fd: int, reg: int, val: int) -> int
extern func native_i2c_smbus_read_block(fd: int, reg: int, buf: ptr, len: int) -> int

# ═══════════════════════════════════════════════════════
# Bus API
# ═══════════════════════════════════════════════════════

## Open an I²C bus (e.g. "/dev/i2c-1" on Linux).
func i2c_open:
    in(path: string)
    fd = native_i2c_open(str_ptr(path), str_byte_len(path));
    if fd < 0 do
        out Err(str_new("failed to open I2C bus"));
    end
    out Ok(I2cBus ( path = path, _fd = fd ));
end

## Close the bus.
func i2c_close:
    in(bus: I2cBus)
    native_i2c_close(bus._fd);
end

## Get a device handle for a specific slave address.
func i2c_device:
    in(bus: I2cBus; addr: int)
    rc = native_i2c_set_addr(bus._fd, addr);
    if rc < 0 do
        out Err(str_new("failed to set I2C slave address"));
    end
    out Ok(I2cDevice ( bus = bus, addr = addr ));
end

# ═══════════════════════════════════════════════════════
# Raw read/write
# ═══════════════════════════════════════════════════════

## Raw read from the device.
func i2c_read:
    in(dev: I2cDevice; buf: ptr; len: int)
    native_i2c_set_addr(dev.bus._fd, dev.addr);
    n = native_i2c_read(dev.bus._fd, buf, len);
    if n < 0 do out Err(str_new("I2C read failed")) end
    out Ok(n);
end

## Raw write to the device.
func i2c_write:
    in(dev: I2cDevice; buf: ptr; len: int)
    native_i2c_set_addr(dev.bus._fd, dev.addr);
    n = native_i2c_write(dev.bus._fd, buf, len);
    if n < 0 do out Err(str_new("I2C write failed")) end
    out Ok(n);
end

# ═══════════════════════════════════════════════════════
# SMBus convenience (register-based access)
# ═══════════════════════════════════════════════════════

## Read a single byte from a register.
func i2c_read_byte:
    in(dev: I2cDevice; reg: int)
    native_i2c_set_addr(dev.bus._fd, dev.addr);
    val = native_i2c_smbus_read_byte(dev.bus._fd, reg);
    if val < 0 do out Err(str_new("I2C SMBus read byte failed")) end
    out Ok(val);
end

## Write a single byte to a register.
func i2c_write_byte:
    in(dev: I2cDevice; reg: int; val: int)
    native_i2c_set_addr(dev.bus._fd, dev.addr);
    rc = native_i2c_smbus_write_byte(dev.bus._fd, reg, val);
    if rc < 0 do out Err(str_new("I2C SMBus write byte failed")) end
    out Ok(());
end

## Read a 16-bit word from a register.
func i2c_read_word:
    in(dev: I2cDevice; reg: int)
    native_i2c_set_addr(dev.bus._fd, dev.addr);
    val = native_i2c_smbus_read_word(dev.bus._fd, reg);
    if val < 0 do out Err(str_new("I2C SMBus read word failed")) end
    out Ok(val);
end

## Write a 16-bit word to a register.
func i2c_write_word:
    in(dev: I2cDevice; reg: int; val: int)
    native_i2c_set_addr(dev.bus._fd, dev.addr);
    rc = native_i2c_smbus_write_word(dev.bus._fd, reg, val);
    if rc < 0 do out Err(str_new("I2C SMBus write word failed")) end
    out Ok(());
end

## Read a block of bytes from a register.
func i2c_read_block:
    in(dev: I2cDevice; reg: int; buf: ptr; max_len: int)
    native_i2c_set_addr(dev.bus._fd, dev.addr);
    n = native_i2c_smbus_read_block(dev.bus._fd, reg, buf, max_len);
    if n < 0 do out Err(str_new("I2C SMBus read block failed")) end
    out Ok(n);
end

## Write register + data bytes in one transaction.
func i2c_write_reg:
    in(dev: I2cDevice; reg: int; data: ptr; data_len: int)
    var buf: [int; 33];  # 1 reg + max 32 data
    buf[0] = reg;
    i = 0;
    when i < data_len loop
        buf[i + 1] = native_load_u8(ptr_add(data, i));
        i = i + 1;
    end
    out i2c_write(dev, &buf, 1 + data_len);
end
