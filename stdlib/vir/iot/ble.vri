##
 * vir/iot/ble.vri — Bluetooth Low Energy (BLE)
 * ================================================
 * Inspired by Python: bleak
 * Inspired by Rust: btleplug
 * Inspired by C: BlueZ D-Bus API
 *
 * BLE Central (client) mode: scan, connect, read/write GATT.
 ##

include types;
include result;
import Result, Ok, Err from result;
include option;
import Option, Some, None from option;
include string;
import String, str_new from string;
include vec;
import Vec, vec_new, vec_push from vec;

# ═══════════════════════════════════════════════════════
# BLE Address & UUIDs
# ═══════════════════════════════════════════════════════

entity BleAddr:
    bytes: [int; 6];     # 48-bit MAC address
end.

entity BleUuid:
    bytes: [int; 16];    # 128-bit UUID
end.

func ble_uuid_from_16:
    in(short: int)
    var b: [int; 16];
    # Bluetooth Base UUID: 00000000-0000-1000-8000-00805F9B34FB
    b[0] = 0; b[1] = 0; b[2] = (short >> 8) & 0xFF; b[3] = short & 0xFF;
    b[4] = 0; b[5] = 0; b[6] = 0x10; b[7] = 0;
    b[8] = 0x80; b[9] = 0; b[10] = 0; b[11] = 0x80;
    b[12] = 0x5F; b[13] = 0x9B; b[14] = 0x34; b[15] = 0xFB;
    out BleUuid ( bytes = b );
end

# ═══════════════════════════════════════════════════════
# Scan Results & GATT
# ═══════════════════════════════════════════════════════

entity BleScanResult:
    addr:     BleAddr,
        name:     Option<string>,
        rssi:     int;             # dBm
    services: Vec<BleUuid>;
end.

entity BleDevice:
    addr:    BleAddr,
        name:    Option<string>,
        _handle: ptr;
end.

entity BleService:
    uuid:            BleUuid,
        characteristics: Vec<BleCharacteristic>;
end.

entity BleCharacteristic:
    uuid:       BleUuid,
        properties: int;      # bitfield: READ|WRITE|NOTIFY|INDICATE
    _handle:    ptr;
end.

const BLE_PROP_READ:     0x02;
const BLE_PROP_WRITE:    0x08;
const BLE_PROP_NOTIFY:   0x10;
const BLE_PROP_INDICATE: 0x20;

# ═══════════════════════════════════════════════════════
# Native bindings
# ═══════════════════════════════════════════════════════

extern func native_ble_adapter_open() -> ptr
extern func native_ble_adapter_close(adapter: ptr)
extern func native_ble_scan_start(adapter: ptr, duration_ms: int) -> int
extern func native_ble_scan_results(adapter: ptr, out_buf: ptr, max: int) -> int
extern func native_ble_connect(adapter: ptr, addr: ptr) -> ptr
extern func native_ble_disconnect(device: ptr)
extern func native_ble_discover_services(device: ptr, out_buf: ptr, max: int) -> int
extern func native_ble_read_char(device: ptr, char_handle: ptr, buf: ptr, max: int) -> int
extern func native_ble_write_char(device: ptr, char_handle: ptr, buf: ptr, len: int) -> int
extern func native_ble_subscribe(device: ptr, char_handle: ptr, callback: ptr) -> int

# ═══════════════════════════════════════════════════════
# Adapter
# ═══════════════════════════════════════════════════════

entity BleAdapter:
    _handle: ptr;
end.

func ble_adapter_open:
    h = native_ble_adapter_open();
    if h == ptr_null() do
        out Err(str_new("failed to open BLE adapter"));
    end
    out Ok(BleAdapter ( _handle = h ));
end.

func ble_adapter_close:
    in(adapter: BleAdapter)
    native_ble_adapter_close(adapter._handle);
end

# ═══════════════════════════════════════════════════════
# Scanning
# ═══════════════════════════════════════════════════════

## Scan for BLE devices for duration_ms milliseconds.
func ble_scan:
    in(adapter: BleAdapter; duration_ms: int)
    rc = native_ble_scan_start(adapter._handle, duration_ms);
    if rc < 0 do
        out Err(str_new("BLE scan failed"));
    end
    # Collect results
    var buf: [int; 8192];
    count = native_ble_scan_results(adapter._handle, &buf, 64);
    results = vec_new<BleScanResult>();
    i = 0;
    when i < count loop
        result = _parse_scan_result(&buf, i);
        vec_push<BleScanResult>(&results, result);
        i = i + 1;
    end
    out Ok(results);
end

# ═══════════════════════════════════════════════════════
# Connection & GATT
# ═══════════════════════════════════════════════════════

## Connect to a BLE device by address.
func ble_connect:
    in(adapter: BleAdapter; addr: BleAddr)
    h = native_ble_connect(adapter._handle, &addr.bytes);
    if h == ptr_null() do
        out Err(str_new("BLE connect failed"));
    end
    out Ok(BleDevice ( addr = addr, name = None, _handle = h ));
end

## Disconnect from device.
func ble_disconnect:
    in(device: BleDevice)
    native_ble_disconnect(device._handle);
end

## Discover all services and characteristics on the device.
func ble_discover_services:
    in(device: BleDevice)
    var buf: [int; 4096];
    count = native_ble_discover_services(device._handle, &buf, 32);
    if count < 0 do
        out Err(str_new("BLE service discovery failed"));
    end
    services = vec_new<BleService>();
    i = 0;
    when i < count loop
        svc = _parse_service(&buf, i);
        vec_push<BleService>(&services, svc);
        i = i + 1;
    end
    out Ok(services);
end

## Read a characteristic value.
func ble_read:
    in(device: BleDevice; ch: BleCharacteristic; buf: ptr; max_len: int)
    n = native_ble_read_char(device._handle, ch._handle, buf, max_len);
    if n < 0 do out Err(str_new("BLE read failed")) end
    out Ok(n);
end

## Write a value to a characteristic.
func ble_write:
    in(device: BleDevice; ch: BleCharacteristic; buf: ptr; len: int)
    rc = native_ble_write_char(device._handle, ch._handle, buf, len);
    if rc < 0 do out Err(str_new("BLE write failed")) end
    out Ok(());
end

## Subscribe to notifications on a characteristic.
func ble_subscribe:
    in(device: BleDevice; ch: BleCharacteristic; callback: func(ptr, int))
    rc = native_ble_subscribe(device._handle, ch._handle, callback);
    if rc < 0 do out Err(str_new("BLE subscribe failed")) end
    out Ok(());
end
