##
 * vir/iot/spi.vri — SPI Bus Interface
 * ======================================
 * Inspired by C: Linux spidev
 * Inspired by Python: spidev
 * Inspired by Rust: linux-embedded-hal spidev
 *
 * SPI master communication for high-speed peripherals
 * displays, flash, ADCs, etc.
 ##

include types;
include result;
import Result, Ok, Err from result;
include string;
import String, str_new from string;

# ═══════════════════════════════════════════════════════
# SPI Mode
# ═══════════════════════════════════════════════════════

enum SpiMode:
    Mode0 = 0;    # CPOL=0, CPHA=0
    Mode1 = 1;    # CPOL=0, CPHA=1
    Mode2 = 2;    # CPOL=1, CPHA=0
    Mode3 = 3;    # CPOL=1, CPHA=1
end.

# ═══════════════════════════════════════════════════════
# SPI Entity
# ═══════════════════════════════════════════════════════

entity SpiConfig:
    mode:           SpiMode,
        bits_per_word:  int;       # usually 8
    max_speed_hz:   int;       # clock speed
    lsb_first:      bool;
end.
entity SpiBus:
    path:    string;       # e.g. "/dev/spidev0.0"
    config:  SpiConfig,
        _fd:     int;
end.

# ═══════════════════════════════════════════════════════
# Native bindings
# ═══════════════════════════════════════════════════════

extern func native_spi_open(path: ptr, path_len: int) -> int
extern func native_spi_close(fd: int)
extern func native_spi_set_mode(fd: int, mode: int) -> int
extern func native_spi_set_speed(fd: int, hz: int) -> int
extern func native_spi_set_bits(fd: int, bits: int) -> int
extern func native_spi_transfer(fd: int, tx: ptr, rx: ptr, len: int) -> int

# ═══════════════════════════════════════════════════════
# API
# ═══════════════════════════════════════════════════════

func spi_config_default:
    out SpiConfig (
        mode = SpiMode.Mode0,
        bits_per_word = 8,
        max_speed_hz = 1000000,
        lsb_first = false
    );
end.
## Open an SPI device.
func spi_open(path: string, cfg: SpiConfig):
    fd = native_spi_open(str_ptr(path), str_byte_len(path));
    if fd < 0 do
        out Err(str_new("failed to open SPI device"));
    end
    native_spi_set_mode(fd, cfg.mode);
    native_spi_set_speed(fd, cfg.max_speed_hz);
    native_spi_set_bits(fd, cfg.bits_per_word);
    out Ok(SpiBus ( path = path, config = cfg, _fd = fd ));
end.
## Close the SPI device.
func spi_close(bus: SpiBus):
    native_spi_close(bus._fd);
end.
## Full-duplex transfer: send tx_buf, receive into rx_buf simultaneously.
func spi_transfer:
    in  bus: SpiBus;
        tx_buf: ptr;
        rx_buf: ptr;
        len: int
    rc = native_spi_transfer(bus._fd, tx_buf, rx_buf, len);
    if rc < 0 do out Err(str_new("SPI transfer failed")) end
    out Ok(rc);
end.
## Write-only (ignore received data).
func spi_write:
    in  bus: SpiBus;
        buf: ptr;
        len: int
    var dummy: [int; 4096];
    actual = if len < 4096 do len; else 4096; end;
    out spi_transfer(bus, buf, &dummy, actual);
end.
## Read-only (send zeros).
func spi_read:
    in  bus: SpiBus;
        buf: ptr;
        len: int
    var zeros: [int; 4096];
    actual = if len < 4096 do len; else 4096; end;
    out spi_transfer(bus, &zeros, buf, actual);
end.
## Write a single byte, return the received byte.
func spi_transfer_byte(bus: SpiBus, val: int):
    var tx: [int; 1];
    var rx: [int; 1];
    tx[0] = val;
    rc = native_spi_transfer(bus._fd, &tx, &rx, 1);
    if rc < 0 do out Err(str_new("SPI transfer byte failed")) end
    out Ok(rx[0]);
end.
## Change SPI clock speed.
func spi_set_speed(bus: SpiBus, hz: int):
    native_spi_set_speed(bus._fd, hz);
    bus.config.max_speed_hz = hz;
end.