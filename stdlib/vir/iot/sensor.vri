##
 * vir/iot/sensor.vri — Sensor Abstraction Layer
 * =================================================
 * Inspired by Zephyr RTOS sensor API
 * Inspired by Arduino sensor libraries
 *
 * Unified interface for common sensor types
 * temperature, humidity, pressure, accelerometer, gyroscope, etc.
 ##

include types;
include result;
import Result, Ok, Err from result;
include option;
import Option, Some, None from option;
include string;
import String, str_new from string;
include vec;
import Vec, vec_new, vec_push from vec;

# ═══════════════════════════════════════════════════════
# Sensor Types
# ═══════════════════════════════════════════════════════

enum SensorType:
    Temperature   = 1;
    Humidity      = 2;
    Pressure      = 3;
    Accelerometer = 4;
    Gyroscope     = 5;
    Magnetometer  = 6;
    Light         = 7;
    Proximity     = 8;
    Gas           = 9;
    Voltage       = 10;
    Current       = 11;
end

# ═══════════════════════════════════════════════════════
# Sensor Reading
# ═══════════════════════════════════════════════════════

entity SensorReading:
    sensor_type: SensorType,
        timestamp:   int;          # microseconds since boot
    x:           float;        # primary value (or X axis)
    y:           float;        # Y axis (if applicable)
    z:           float;        # Z axis (if applicable)
    unit:        string;       # e.g. "°C", "hPa", "m/s²"
end
entity Vec3f:
    x: float,
        y: float,
        z: float;
end
func vec3f_new:
    in(x: float; y: float; z: float)
    out Vec3f ( x = x, y = y, z = z );
end
func vec3f_magnitude:
    in(v: Vec3f)
    out sqrt(v.x * v.x + v.y * v.y + v.z * v.z);
end
# ═══════════════════════════════════════════════════════
# Sensor Interface (driver abstraction)
# ═══════════════════════════════════════════════════════

entity SensorDriver:
    name:        string,
        sensor_type: SensorType,
        _init:       func(ptr) -> int,
        _read:       func(ptr) -> SensorReading,
        _calibrate:  func(ptr) -> int,
        _ctx:        ptr;
end
func sensor_new:
    in(name: string; sensor_type: SensorType,
        init_fn: func(ptr) -> int,
        read_fn: func(ptr) -> SensorReading,
        cal_fn: func(ptr) -> int,
        ctx: ptr)
    out SensorDriver (
        name = name, sensor_type = sensor_type,
        _init = init_fn, _read = read_fn,
        _calibrate = cal_fn, _ctx = ctx
    );
end
func sensor_init:
    in(drv: SensorDriver)
    rc = drv._init(drv._ctx);
    if rc != 0 do out Err(str_new("sensor init failed")) end
    out Ok(());
end
func sensor_read:
    in(drv: SensorDriver)
    out drv._read(drv._ctx);
end
func sensor_calibrate:
    in(drv: SensorDriver)
    rc = drv._calibrate(drv._ctx);
    if rc != 0 do out Err(str_new("sensor calibration failed")) end
    out Ok(());
end
# ═══════════════════════════════════════════════════════
# Common sensor helpers
# ═══════════════════════════════════════════════════════

## Temperature reading helper.
func reading_temperature:
    in(celsius: float; timestamp: int)
    out SensorReading (
        sensor_type = SensorType.Temperature,
        timestamp = timestamp,
        x = celsius, y = 0.0, z = 0.0,
        unit = str_new("°C")
    );
end
## Humidity reading helper.
func reading_humidity:
    in(percent: float; timestamp: int)
    out SensorReading (
        sensor_type = SensorType.Humidity,
        timestamp = timestamp,
        x = percent, y = 0.0, z = 0.0,
        unit = str_new("%RH")
    );
end
## Pressure reading helper.
func reading_pressure:
    in(hpa: float; timestamp: int)
    out SensorReading (
        sensor_type = SensorType.Pressure,
        timestamp = timestamp,
        x = hpa, y = 0.0, z = 0.0,
        unit = str_new("hPa")
    );
end
## Accelerometer reading helper (m/s²).
func reading_accel:
    in(x: float; y: float; z: float; timestamp: int)
    out SensorReading (
        sensor_type = SensorType.Accelerometer,
        timestamp = timestamp,
        x = x, y = y, z = z,
        unit = str_new("m/s²")
    );
end
## Gyroscope reading helper (rad/s).
func reading_gyro:
    in(x: float; y: float; z: float; timestamp: int)
    out SensorReading (
        sensor_type = SensorType.Gyroscope,
        timestamp = timestamp,
        x = x, y = y, z = z,
        unit = str_new("rad/s")
    );
end
## Convert Celsius to Fahrenheit.
func celsius_to_fahrenheit:
    in(c: float)
    out c * 1.8 + 32.0;
end
## Convert Fahrenheit to Celsius.
func fahrenheit_to_celsius:
    in(f: float)
    out (f - 32.0) / 1.8;
end
# ═══════════════════════════════════════════════════════
# Sensor Bus (multi-sensor manager)
# ═══════════════════════════════════════════════════════

entity SensorBus:
    sensors: Vec<SensorDriver>;
end
func sensor_bus_new:
    out SensorBus ( sensors = vec_new<SensorDriver>() );
end
func sensor_bus_add:
    in(bus: SensorBus; drv: SensorDriver)
    vec_push<SensorDriver>(&bus.sensors, drv);
end
## Initialize all sensors on the bus.
func sensor_bus_init_all:
    in(bus: SensorBus)
    i = 0;
    when i < vec_len<SensorDriver>(bus.sensors) loop
        drv = vec_get<SensorDriver>(bus.sensors, i);
        sensor_init(drv);
        i = i + 1;
    end
end
## Read all sensors and return readings.
func sensor_bus_read_all:
    in(bus: SensorBus)
    readings = vec_new<SensorReading>();
    i = 0;
    when i < vec_len<SensorDriver>(bus.sensors) loop
        drv = vec_get<SensorDriver>(bus.sensors, i);
        r = sensor_read(drv);
        vec_push<SensorReading>(&readings, r);
        i = i + 1;
    end
    out readings;
end