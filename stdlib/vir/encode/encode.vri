# vir/encode/encode.vri — base64, hex, url (wire codecs)

include types
include string
import String from string
include builder
import StringBuilder, sb_new, sb_append, sb_append_byte, sb_build, sb_free from builder
include result
import Result, Ok, Err from result
include vec
import Vec, vec_new, vec_push, vec_len, vec_get from vec

# ═══════════════════════════════════════════════════════
# Base64 — RFC 4648
# ═══════════════════════════════════════════════════════

const B64_PAD: 61

func _encodeCstrLen(data: int) -> int:
    if data == 0 do out 0 end
    len = 0
    when native_read_u8(data, len) != 0 loop
        len = len + 1
    end
    out len
end.

func _encodeStringByte(s: string, index: int) -> int:
    out native_read_u8((s as ptr) as int, index)
end.

func base64_encode(data: ptr, len: int):
    out _b64_encode_with_table(data, len, "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/", true)
end.
func base64_encode_url(data: ptr, len: int):
    out _b64_encode_with_table(data, len, "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_", false)
end.
func _b64_encode_with_table:
    in  data: ptr
        len: int
        table: string
        pad: bool
    sb = sb_new()
    table_data = (table as ptr) as int
    i = 0
    when i + 2 < len loop
        a = native_read_u8(data, i)
        b = native_read_u8(data, i + 1)
        c = native_read_u8(data, i + 2)
        sb_append_byte(sb, native_read_u8(table_data, (a  shr  2) & 0x3F))
        sb_append_byte(sb, native_read_u8(table_data, ((a & 0x03)  shl  4) | ((b  shr  4) & 0x0F)))
        sb_append_byte(sb, native_read_u8(table_data, ((b & 0x0F)  shl  2) | ((c  shr  6) & 0x03)))
        sb_append_byte(sb, native_read_u8(table_data, c & 0x3F))
        i = i + 3
    end

    remain = len - i
    if remain == 2 do
        a = native_read_u8(data, i)
        b = native_read_u8(data, i + 1)
        sb_append_byte(sb, native_read_u8(table_data, (a  shr  2) & 0x3F))
        sb_append_byte(sb, native_read_u8(table_data, ((a & 0x03)  shl  4) | ((b  shr  4) & 0x0F)))
        sb_append_byte(sb, native_read_u8(table_data, (b & 0x0F)  shl  2))
        if pad do sb_append_byte(sb, B64_PAD) end
    eif remain == 1 do
        a = native_read_u8(data, i)
        sb_append_byte(sb, native_read_u8(table_data, (a  shr  2) & 0x3F))
        sb_append_byte(sb, native_read_u8(table_data, (a & 0x03)  shl  4))
        if pad do
            sb_append_byte(sb, B64_PAD)
            sb_append_byte(sb, B64_PAD)
        end
    end

    result = sb_build(sb)
    sb_free(sb)
    out result
end.
# ─── Base64 Decode ────────────────────────────────────

func base64_decode(encoded: string):
    out _b64_decode_with_table(encoded, "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/")
end.
func base64_decode_url(encoded: string):
    out _b64_decode_with_table(encoded, "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_")
end.
func _b64_decode_char(ch: int, table_data: int):
    if ch == B64_PAD do out -2 end
    i = 0
    when i < 64 loop
        if native_read_u8(table_data, i) == ch do out i end
        i = i + 1
    end
    out -1
end.
func _b64_decode_with_table(encoded: string, table: string):
    encoded_data = (encoded as ptr) as int
    table_data = (table as ptr) as int
    slen = _encodeCstrLen(encoded_data)
    result = vec_new()
    i = 0
    done = false

    when i < slen and not done loop
        ch = native_read_u8(encoded_data, i)

        # Skip whitespace
        if ch == 0x20 or ch == 0x0A or ch == 0x0D or ch == 0x09 do
            i = i + 1
        else
            a = _b64_decode_char(ch, table_data)
            if a < 0 do
                done = true
            else
                i = i + 1
                if i >= slen do
                    done = true
                else
                    b = _b64_decode_char(native_read_u8(encoded_data, i), table_data)
                    if b < 0 do
                        done = true
                    else
                        i = i + 1
                        result = vec_push(result, (a  shl  2) | ((b  shr  4) & 0x03))

                        if i < slen and not done do
                            c = _b64_decode_char(native_read_u8(encoded_data, i), table_data)
                            i = i + 1
                            if c == -2 or c < 0 do
                                done = true
                            else
                                result = vec_push(result, ((b & 0x0F)  shl  4) | ((c  shr  2) & 0x0F))

                                if i < slen and not done do
                                    d = _b64_decode_char(native_read_u8(encoded_data, i), table_data)
                                    i = i + 1
                                    if d == -2 or d < 0 do
                                        done = true
                                    else
                                        result = vec_push(result, ((c & 0x03)  shl  6) | d)
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
    end

    out result
end.
func base64_encode_string(s: string):
    data = (s as ptr) as int
    out base64_encode(data as ptr, _encodeCstrLen(data))
end.
# ═══════════════════════════════════════════════════════
# Hex Encoding/Decoding
# ═══════════════════════════════════════════════════════

func hex_encode(data: ptr, len: int):
    sb = sb_new()
    i = 0
    when i < len loop
        byte = native_read_u8(data, i) & 0xFF
        sb_append_byte(sb, _encodeStringByte("0123456789abcdef", (byte  shr  4) & 0x0F))
        sb_append_byte(sb, _encodeStringByte("0123456789abcdef", byte & 0x0F))
        i = i + 1
    end
    result = sb_build(sb)
    sb_free(sb)
    out result
end.
func hex_encode_upper(data: ptr, len: int):
    sb = sb_new()
    i = 0
    when i < len loop
        byte = native_read_u8(data, i) & 0xFF
        sb_append_byte(sb, _encodeStringByte("0123456789ABCDEF", (byte  shr  4) & 0x0F))
        sb_append_byte(sb, _encodeStringByte("0123456789ABCDEF", byte & 0x0F))
        i = i + 1
    end
    result = sb_build(sb)
    sb_free(sb)
    out result
end.
func _hex_value(ch: int):
    if ch >= 48 and ch <= 57 do out ch - 48 end
    if ch >= 97 and ch <= 102 do out ch - 87 end
    if ch >= 65 and ch <= 70 do out ch - 55 end
    out -1
end.
func hex_decode(encoded: string):
    data = (encoded as ptr) as int
    slen = _encodeCstrLen(data)
    result = vec_new()
    i = 0
    when i + 1 < slen loop
        hi = _hex_value(native_read_u8(data, i))
        lo = _hex_value(native_read_u8(data, i + 1))
        if hi < 0 or lo < 0 do
            out Err("invalid hex character")
        end
        result = vec_push(result, (hi  shl  4) | lo)
        i = i + 2
    end
    out Ok(result)
end.
func hex_encode_string(s: string):
    data = (s as ptr) as int
    out hex_encode(data as ptr, _encodeCstrLen(data))
end.
# ═══════════════════════════════════════════════════════
# URL Percent-Encoding — RFC 3986
# ═══════════════════════════════════════════════════════

func _is_unreserved(ch: int):
    if ch >= 65 and ch <= 90 do out true end
    if ch >= 97 and ch <= 122 do out true end
    if ch >= 48 and ch <= 57 do out true end
    if ch == 45 or ch == 46 or ch == 95 or ch == 126 do out true end
    out false
end.
func url_encode(s: string):
    sb = sb_new()
    data = (s as ptr) as int
    slen = _encodeCstrLen(data)
    i = 0
    when i < slen loop
        ch = native_read_u8(data, i)
        if _is_unreserved(ch) do
            sb_append_byte(sb, ch)
        else
            sb_append_byte(sb, 0x25)
            sb_append_byte(sb, _encodeStringByte("0123456789ABCDEF", (ch  shr  4) & 0x0F))
            sb_append_byte(sb, _encodeStringByte("0123456789ABCDEF", ch & 0x0F))
        end
        i = i + 1
    end
    result = sb_build(sb)
    sb_free(sb)
    out result
end.
func url_decode(s: string):
    sb = sb_new()
    data = (s as ptr) as int
    slen = _encodeCstrLen(data)
    i = 0
    when i < slen loop
        ch = native_read_u8(data, i)
        if ch == 0x25 and i + 2 < slen do
            hi = _hex_value(native_read_u8(data, i + 1))
            lo = _hex_value(native_read_u8(data, i + 2))
            if hi >= 0 and lo >= 0 do
                sb_append_byte(sb, (hi  shl  4) | lo)
                i = i + 3
            else
                sb_append_byte(sb, ch)
                i = i + 1
            end
        eif ch == 0x2B do
            sb_append_byte(sb, 0x20)
            i = i + 1
        else
            sb_append_byte(sb, ch)
            i = i + 1
        end
    end
    result = sb_build(sb)
    sb_free(sb)
    out result
end.
func url_encode_component(s: string):
    out url_encode(s)
end.
func url_encode_query(pairs: Vec):
    sb = sb_new()
    i = 0
    when i < vec_len(pairs) loop
        p = vec_get(pairs, i)
        if i > 0 do sb_append_byte(sb, 0x26) end
        sb_append(sb, url_encode(p.key))
        sb_append_byte(sb, 0x3D)
        sb_append(sb, url_encode(p.value))
        i = i + 1
    end
    result = sb_build(sb)
    sb_free(sb)
    out result
end.

entity EncodeNamespace:
    method base64Encode(data: ptr, len: int):
        out base64_encode(data, len)
    end.

    method base64EncodeString(s: string):
        out base64_encode_string(s)
    end.

    method base64Decode(encoded: string):
        out base64_decode(encoded)
    end.

    method hexEncode(data: ptr, len: int):
        out hex_encode(data, len)
    end.

    method hexEncodeString(s: string):
        out hex_encode_string(s)
    end.

    method hexDecode(encoded: string):
        out hex_decode(encoded)
    end.

    method urlEncode(s: string):
        out url_encode(s)
    end.

    method urlDecode(s: string):
        out url_decode(s)
    end.
end.

var encode: EncodeNamespace

export EncodeNamespace, encode
export base64_encode, base64_encode_string, base64_decode
export hex_encode, hex_encode_string, hex_decode
export url_encode, url_decode