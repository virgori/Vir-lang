##
 * vir/encode/encode.vri — Base64, Hex, URL Encoding/Decoding
 * =============================================================
 * Inspired by Python: base64, binascii, urllib.parse
 * Inspired by Rust: base64, hex, urlencoding
 * Inspired by Go: encoding/base64, encoding/hex, net/url
 *
 * Phase C — essential encoding primitives for web, crypto, serialization.
 * Implements RFC 4648 (Base64), RFC 3986 (URL percent-encoding).
 ##

include types;
include string;
import String, str_byte_len from string;
include builder;
import StringBuilder, sb_new, sb_append, sb_append_byte, sb_build, sb_free from builder;
include result;
import Result, Ok, Err from result;
include vec;
import Vec, vec_new, vec_push, vec_len, vec_get from vec;

# ═══════════════════════════════════════════════════════
# Base64 — RFC 4648
# ═══════════════════════════════════════════════════════

const B64_TABLE: "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
const B64_URL_TABLE: "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_";
const B64_PAD: 61;

func base64_encode:
    in(data: ptr; len: int)
    out _b64_encode_with_table(data, len, B64_TABLE, true);
end
func base64_encode_url:
    in(data: ptr; len: int)
    out _b64_encode_with_table(data, len, B64_URL_TABLE, false);
end
func _b64_encode_with_table:
    in(data: ptr; len: int; table: string; pad: bool)
    sb = sb_new();
    i = 0;
    when i + 2 < len loop
        a = native_load_u8(data, i);
        b = native_load_u8(data, i + 1);
        c = native_load_u8(data, i + 2);
        sb_append_byte(sb, table[(a >> 2) & 0x3F]);
        sb_append_byte(sb, table[((a & 0x03) << 4) | ((b >> 4) & 0x0F)]);
        sb_append_byte(sb, table[((b & 0x0F) << 2) | ((c >> 6) & 0x03)]);
        sb_append_byte(sb, table[c & 0x3F]);
        i = i + 3;
    end

    remain = len - i;
    if remain == 2 do
        a = native_load_u8(data, i);
        b = native_load_u8(data, i + 1);
        sb_append_byte(sb, table[(a >> 2) & 0x3F]);
        sb_append_byte(sb, table[((a & 0x03) << 4) | ((b >> 4) & 0x0F)]);
        sb_append_byte(sb, table[(b & 0x0F) << 2]);
        if pad do sb_append_byte(sb, B64_PAD) end
    eif remain == 1 do
        a = native_load_u8(data, i);
        sb_append_byte(sb, table[(a >> 2) & 0x3F]);
        sb_append_byte(sb, table[(a & 0x03) << 4]);
        if pad do
            sb_append_byte(sb, B64_PAD);
            sb_append_byte(sb, B64_PAD);
        end
    end

    result = sb_build(sb);
    sb_free(sb);
    out result;
end
# ─── Base64 Decode ────────────────────────────────────

func base64_decode:
    in(encoded: string)
    out _b64_decode_with_table(encoded, B64_TABLE);
end
func base64_decode_url:
    in(encoded: string)
    out _b64_decode_with_table(encoded, B64_URL_TABLE);
end
func _b64_decode_char:
    in(ch: int; table: string)
    if ch == B64_PAD do out -2 end
    i = 0;
    when i < 64 loop
        if table[i] == ch do out i end
        i = i + 1;
    end
    out -1;
end
func _b64_decode_with_table:
    in(encoded: string; table: string)
    slen = str_byte_len(encoded);
    result = vec_new();
    i = 0;
    done = false;

    when i < slen and not done loop
        ch = native_load_u8(encoded.data, i);

        # Skip whitespace
        if ch == 0x20 or ch == 0x0A or ch == 0x0D or ch == 0x09 do
            i = i + 1;
        else
            a = _b64_decode_char(ch, table);
            if a < 0 do
                done = true;
            else
                i = i + 1;
                if i >= slen do
                    done = true;
                else
                    b = _b64_decode_char(native_load_u8(encoded.data, i), table);
                    if b < 0 do
                        done = true;
                    else
                        i = i + 1;
                        vec_push(result, (a << 2) | ((b >> 4) & 0x03));

                        if i < slen and not done do
                            c = _b64_decode_char(native_load_u8(encoded.data, i), table);
                            i = i + 1;
                            if c == -2 or c < 0 do
                                done = true;
                            else
                                vec_push(result, ((b & 0x0F) << 4) | ((c >> 2) & 0x0F));

                                if i < slen and not done do
                                    d = _b64_decode_char(native_load_u8(encoded.data, i), table);
                                    i = i + 1;
                                    if d == -2 or d < 0 do
                                        done = true;
                                    else
                                        vec_push(result, ((c & 0x03) << 6) | d);
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
    end

    out result;
end
func base64_encode_string:
    in(s: string)
    out base64_encode(s.data, str_byte_len(s));
end
# ═══════════════════════════════════════════════════════
# Hex Encoding/Decoding
# ═══════════════════════════════════════════════════════

const HEX_LOWER: "0123456789abcdef";
const HEX_UPPER: "0123456789ABCDEF";

func hex_encode:
    in(data: ptr; len: int)
    sb = sb_new();
    i = 0;
    when i < len loop
        byte = native_load_u8(data, i) & 0xFF;
        sb_append_byte(sb, HEX_LOWER[(byte >> 4) & 0x0F]);
        sb_append_byte(sb, HEX_LOWER[byte & 0x0F]);
        i = i + 1;
    end
    result = sb_build(sb);
    sb_free(sb);
    out result;
end
func hex_encode_upper:
    in(data: ptr; len: int)
    sb = sb_new();
    i = 0;
    when i < len loop
        byte = native_load_u8(data, i) & 0xFF;
        sb_append_byte(sb, HEX_UPPER[(byte >> 4) & 0x0F]);
        sb_append_byte(sb, HEX_UPPER[byte & 0x0F]);
        i = i + 1;
    end
    result = sb_build(sb);
    sb_free(sb);
    out result;
end
func _hex_value:
    in(ch: int)
    if ch >= 48 and ch <= 57 do out ch - 48 end
    if ch >= 97 and ch <= 102 do out ch - 87 end
    if ch >= 65 and ch <= 70 do out ch - 55 end
    out -1;
end
func hex_decode:
    in(encoded: string)
    slen = str_byte_len(encoded);
    result = vec_new();
    i = 0;
    when i + 1 < slen loop
        hi = _hex_value(native_load_u8(encoded.data, i));
        lo = _hex_value(native_load_u8(encoded.data, i + 1));
        if hi < 0 or lo < 0 do
            out Err("invalid hex character");
        end
        vec_push(result, (hi << 4) | lo);
        i = i + 2;
    end
    out Ok(result);
end
func hex_encode_string:
    in(s: string)
    out hex_encode(s.data, str_byte_len(s));
end
# ═══════════════════════════════════════════════════════
# URL Percent-Encoding — RFC 3986
# ═══════════════════════════════════════════════════════

func _is_unreserved:
    in(ch: int)
    if ch >= 65 and ch <= 90 do out true end
    if ch >= 97 and ch <= 122 do out true end
    if ch >= 48 and ch <= 57 do out true end
    if ch == 45 or ch == 46 or ch == 95 or ch == 126 do out true end
    out false;
end
func url_encode:
    in(s: string)
    sb = sb_new();
    slen = str_byte_len(s);
    i = 0;
    when i < slen loop
        ch = native_load_u8(s.data, i);
        if _is_unreserved(ch) do
            sb_append_byte(sb, ch);
        else
            sb_append_byte(sb, 0x25);
            sb_append_byte(sb, HEX_UPPER[(ch >> 4) & 0x0F]);
            sb_append_byte(sb, HEX_UPPER[ch & 0x0F]);
        end
        i = i + 1;
    end
    result = sb_build(sb);
    sb_free(sb);
    out result;
end
func url_decode:
    in(s: string)
    sb = sb_new();
    slen = str_byte_len(s);
    i = 0;
    when i < slen loop
        ch = native_load_u8(s.data, i);
        if ch == 0x25 and i + 2 < slen do
            hi = _hex_value(native_load_u8(s.data, i + 1));
            lo = _hex_value(native_load_u8(s.data, i + 2));
            if hi >= 0 and lo >= 0 do
                sb_append_byte(sb, (hi << 4) | lo);
                i = i + 3;
            else
                sb_append_byte(sb, ch);
                i = i + 1;
            end
        eif ch == 0x2B do
            sb_append_byte(sb, 0x20);
            i = i + 1;
        else
            sb_append_byte(sb, ch);
            i = i + 1;
        end
    end
    result = sb_build(sb);
    sb_free(sb);
    out result;
end
func url_encode_component:
    in(s: string)
    out url_encode(s);
end
func url_encode_query:
    in(pairs: Vec)
    sb = sb_new();
    i = 0;
    when i < vec_len(pairs) loop
        p = vec_get(pairs, i);
        if i > 0 do sb_append_byte(sb, 0x26) end
        sb_append(sb, url_encode(p.key));
        sb_append_byte(sb, 0x3D);
        sb_append(sb, url_encode(p.value));
        i = i + 1;
    end
    result = sb_build(sb);
    sb_free(sb);
    out result;
end