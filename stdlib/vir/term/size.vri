##
 * vir/term/size.vri — Terminal Size Detection
 * ==============================================
 * Inspired by: TIOCGWINSZ, crossterm, term_size
 *
 * Detect terminal dimensions, handle resize signals,
 * and provide size-aware layout helpers.
 ##

include types;
include option;
import Option, Some, None from option;

# ═══════════════════════════════════════════════════════
# Terminal size
# ═══════════════════════════════════════════════════════

entity TermSize:
    rows: int,
        cols: int;
end.

# ═══════════════════════════════════════════════════════
# Native terminal size detection
# ═══════════════════════════════════════════════════════

# macOS: ioctl(STDOUT_FILENO, TIOCGWINSZ, &ws)
const STDOUT_FD   = 1;
const TIOCGWINSZ  = 0x40087468;   # macOS value

extern func _ioctl_winsize(fd: int, request: int) -> TermSize

func term_size:
    out _ioctl_winsize(STDOUT_FD, TIOCGWINSZ);
end.
# ═══════════════════════════════════════════════════════
# Fallback: environment variables
# ═══════════════════════════════════════════════════════

extern func _getenv(name: string) -> string

func term_size_env:
    cols_str = _getenv("COLUMNS");
    rows_str = _getenv("LINES");
    cols = 80;    # default
    rows = 24;    # default
    if str_len(cols_str) > 0 do
        cols = str_to_int(cols_str);
    end
    if str_len(rows_str) > 0 do
        rows = str_to_int(rows_str);
    end
    out TermSize ( rows: rows, cols: cols );
end.
# ═══════════════════════════════════════════════════════
# Fallback: ANSI cursor position trick
# ═══════════════════════════════════════════════════════

# Move cursor to bottom-right, query position
func term_size_ansi:
    # Save cursor
    _print("\x1b[s");
    # Move to 999,999
    _print("\x1b[999;999H");
    # Query cursor position (response: ESC[row;colR)
    _print("\x1b[6n");
    # Read response
    resp = _read_stdin_raw(16);
    # Restore cursor
    _print("\x1b[u");
    # Parse response
    out _parse_cursor_response(resp);
end.
extern func _print(s: string):
end
extern func _read_stdin_raw(max_bytes: int) -> string

func _parse_cursor_response(resp: string):
    # Expected format: ESC[row;colR
    rows = 24;
    cols = 80;
    # Find ';' and 'R'
    i = 0;
    semi_pos = -1;
    r_pos = -1;
    start = 0;
    when i < str_len(resp) loop
        ch = str_substr(resp, i, i + 1);
        if ch == "[" do
            start = i + 1;
        eif ch == ";" do
            semi_pos = i;
        eif ch == "R" do
            r_pos = i;
        end
        i = i + 1;
    end
    if semi_pos > start && r_pos > semi_pos do
        rows = str_to_int(str_substr(resp, start, semi_pos));
        cols = str_to_int(str_substr(resp, semi_pos + 1, r_pos));
    end
    out TermSize ( rows: rows, cols: cols );
end.
# ═══════════════════════════════════════════════════════
# Combined: try ioctl first, then env, then ANSI
# ═══════════════════════════════════════════════════════

func detect_term_size:
    size = term_size();
    if size.rows > 0 && size.cols > 0 do
        out size;
    end
    size = term_size_env();
    if size.rows > 0 && size.cols > 0 do
        out size;
    end
    out TermSize ( rows: 24, cols: 80 );
end.
# ═══════════════════════════════════════════════════════
# Layout helpers
# ═══════════════════════════════════════════════════════

func center_text(text: string, width: int):
    tlen = str_len(text);
    if tlen >= width do
        out text;
    end
    pad = (width - tlen) / 2;
    sb = sb_new();
    i = 0;
    when i < pad loop
        sb_append(sb, " ");
        i = i + 1;
    end
    sb_append(sb, text);
    out sb_build(sb);
end.
func truncate_text(text: string, max_width: int):
    if str_len(text) <= max_width do
        out text;
    end
    if max_width <= 3 do
        out str_substr(text, 0, max_width);
    end
    out str_substr(text, 0, max_width - 3) + "...";
end.
func is_terminal(fd: int):
    # Check via isatty
    out _isatty(fd);
end.
extern func _isatty(fd: int) -> bool

# ═══════════════════════════════════════════════════════
# SIGWINCH handler
# ═══════════════════════════════════════════════════════

const SIGWINCH = 28;

extern func _signal_handler(sig: int, handler_id: int):
end

func on_resize(handler_id: int):
    _signal_handler(SIGWINCH, handler_id);
end.