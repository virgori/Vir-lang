##
 * vir/term/color.vri — Terminal Colors & Styles (ANSI)
 * =====================================================
 * Inspired by Rust: colored, termcolor crates
 * Inspired by Python: colorama, rich
 *
 * Phase C — ANSI escape sequences for terminal output.
 * Supports 4-bit, 8-bit, and 24-bit (truecolor) modes.
 ##

include types;
include builder;
import StringBuilder, sb_new, sb_append, sb_append_byte, sb_append_i64, sb_append_cstr, sb_build, sb_free from builder;

# ═══════════════════════════════════════════════════════
# Standard 4-bit color codes
# ═══════════════════════════════════════════════════════

const COLOR_BLACK:   30;
const COLOR_RED:     31;
const COLOR_GREEN:   32;
const COLOR_YELLOW:  33;
const COLOR_BLUE:    34;
const COLOR_MAGENTA: 35;
const COLOR_CYAN:    36;
const COLOR_WHITE:   37;

const COLOR_BRIGHT_BLACK:   90;
const COLOR_BRIGHT_RED:     91;
const COLOR_BRIGHT_GREEN:   92;
const COLOR_BRIGHT_YELLOW:  93;
const COLOR_BRIGHT_BLUE:    94;
const COLOR_BRIGHT_MAGENTA: 95;
const COLOR_BRIGHT_CYAN:    96;
const COLOR_BRIGHT_WHITE:   97;

# Background variants (+10)
const BG_BLACK:   40;
const BG_RED:     41;
const BG_GREEN:   42;
const BG_YELLOW:  43;
const BG_BLUE:    44;
const BG_MAGENTA: 45;
const BG_CYAN:    46;
const BG_WHITE:   47;

# ═══════════════════════════════════════════════════════
# Style codes
# ═══════════════════════════════════════════════════════

const STYLE_RESET:     0;
const STYLE_BOLD:      1;
const STYLE_DIM:       2;
const STYLE_ITALIC:    3;
const STYLE_UNDERLINE: 4;
const STYLE_BLINK:     5;
const STYLE_REVERSE:   7;
const STYLE_HIDDEN:    8;
const STYLE_STRIKE:    9;

# ESC byte = 27
const ESC_BYTE: 27;

# ═══════════════════════════════════════════════════════
# Build ANSI escape: ESC[<code>m
# ═══════════════════════════════════════════════════════

func _ansi_code:
    in(code: int)
    sb = sb_new();
    sb_append_byte(sb, ESC_BYTE);
    sb_append_cstr(sb, "[");
    sb_append_i64(sb, code);
    sb_append_cstr(sb, "m");
    result = sb_build(sb);
    sb_free(sb);
    out result;
end.

func _ansi_reset:
    in()
    out _ansi_code(STYLE_RESET);
end

# ═══════════════════════════════════════════════════════
# Colorize functions — wrap text with ANSI
# ═══════════════════════════════════════════════════════

func color:
    in(text: string; fg: int)
    sb = sb_new();
    sb_append_byte(sb, ESC_BYTE);
    sb_append_cstr(sb, "[");
    sb_append_i64(sb, fg);
    sb_append_cstr(sb, "m");
    sb_append(sb, text);
    sb_append_byte(sb, ESC_BYTE);
    sb_append_cstr(sb, "[0m");
    result = sb_build(sb);
    sb_free(sb);
    out result;
end.

func color_bg:
    in(text: string; fg: int; bg: int)
    sb = sb_new();
    sb_append_byte(sb, ESC_BYTE);
    sb_append_cstr(sb, "[");
    sb_append_i64(sb, fg);
    sb_append_cstr(sb, ";");
    sb_append_i64(sb, bg);
    sb_append_cstr(sb, "m");
    sb_append(sb, text);
    sb_append_byte(sb, ESC_BYTE);
    sb_append_cstr(sb, "[0m");
    result = sb_build(sb);
    sb_free(sb);
    out result;
end

# ─── Convenience wrappers for common colors ──────────

func red:
    in(text: string)
    out color(text, COLOR_RED);
end.

func green:
    in(text: string)
    out color(text, COLOR_GREEN);
end.

func yellow:
    in(text: string)
    out color(text, COLOR_YELLOW);
end.

func blue:
    in(text: string)
    out color(text, COLOR_BLUE);
end.

func magenta:
    in(text: string)
    out color(text, COLOR_MAGENTA);
end.

func cyan:
    in(text: string)
    out color(text, COLOR_CYAN);
end.

func white:
    in(text: string)
    out color(text, COLOR_WHITE);
end.

func bright_red:
    in(text: string)
    out color(text, COLOR_BRIGHT_RED);
end.

func bright_green:
    in(text: string)
    out color(text, COLOR_BRIGHT_GREEN);
end

# ─── Style wrappers ─────────────────────────────────

func bold:
    in(text: string)
    sb = sb_new();
    sb_append_byte(sb, ESC_BYTE);
    sb_append_cstr(sb, "[1m");
    sb_append(sb, text);
    sb_append_byte(sb, ESC_BYTE);
    sb_append_cstr(sb, "[0m");
    result = sb_build(sb);
    sb_free(sb);
    out result;
end.

func dim:
    in(text: string)
    sb = sb_new();
    sb_append_byte(sb, ESC_BYTE);
    sb_append_cstr(sb, "[2m");
    sb_append(sb, text);
    sb_append_byte(sb, ESC_BYTE);
    sb_append_cstr(sb, "[0m");
    result = sb_build(sb);
    sb_free(sb);
    out result;
end.

func italic:
    in(text: string)
    sb = sb_new();
    sb_append_byte(sb, ESC_BYTE);
    sb_append_cstr(sb, "[3m");
    sb_append(sb, text);
    sb_append_byte(sb, ESC_BYTE);
    sb_append_cstr(sb, "[0m");
    result = sb_build(sb);
    sb_free(sb);
    out result;
end.

func underline:
    in(text: string)
    sb = sb_new();
    sb_append_byte(sb, ESC_BYTE);
    sb_append_cstr(sb, "[4m");
    sb_append(sb, text);
    sb_append_byte(sb, ESC_BYTE);
    sb_append_cstr(sb, "[0m");
    result = sb_build(sb);
    sb_free(sb);
    out result;
end.

func strikethrough:
    in(text: string)
    sb = sb_new();
    sb_append_byte(sb, ESC_BYTE);
    sb_append_cstr(sb, "[9m");
    sb_append(sb, text);
    sb_append_byte(sb, ESC_BYTE);
    sb_append_cstr(sb, "[0m");
    result = sb_build(sb);
    sb_free(sb);
    out result;
end

# ═══════════════════════════════════════════════════════
# 8-bit color (256 palette): ESC[38;5;<n>m
# ═══════════════════════════════════════════════════════

func color_256:
    in(text: string; n: int)
    sb = sb_new();
    sb_append_byte(sb, ESC_BYTE);
    sb_append_cstr(sb, "[38;5;");
    sb_append_i64(sb, n);
    sb_append_cstr(sb, "m");
    sb_append(sb, text);
    sb_append_byte(sb, ESC_BYTE);
    sb_append_cstr(sb, "[0m");
    result = sb_build(sb);
    sb_free(sb);
    out result;
end.

func bg_256:
    in(text: string; n: int)
    sb = sb_new();
    sb_append_byte(sb, ESC_BYTE);
    sb_append_cstr(sb, "[48;5;");
    sb_append_i64(sb, n);
    sb_append_cstr(sb, "m");
    sb_append(sb, text);
    sb_append_byte(sb, ESC_BYTE);
    sb_append_cstr(sb, "[0m");
    result = sb_build(sb);
    sb_free(sb);
    out result;
end

# ═══════════════════════════════════════════════════════
# 24-bit truecolor: ESC[38;2;<r>;<g>;<b>m
# ═══════════════════════════════════════════════════════

func color_rgb:
    in(text: string; r: int; g: int; b: int)
    sb = sb_new();
    sb_append_byte(sb, ESC_BYTE);
    sb_append_cstr(sb, "[38;2;");
    sb_append_i64(sb, r);
    sb_append_cstr(sb, ";");
    sb_append_i64(sb, g);
    sb_append_cstr(sb, ";");
    sb_append_i64(sb, b);
    sb_append_cstr(sb, "m");
    sb_append(sb, text);
    sb_append_byte(sb, ESC_BYTE);
    sb_append_cstr(sb, "[0m");
    result = sb_build(sb);
    sb_free(sb);
    out result;
end.

func bg_rgb:
    in(text: string; r: int; g: int; b: int)
    sb = sb_new();
    sb_append_byte(sb, ESC_BYTE);
    sb_append_cstr(sb, "[48;2;");
    sb_append_i64(sb, r);
    sb_append_cstr(sb, ";");
    sb_append_i64(sb, g);
    sb_append_cstr(sb, ";");
    sb_append_i64(sb, b);
    sb_append_cstr(sb, "m");
    sb_append(sb, text);
    sb_append_byte(sb, ESC_BYTE);
    sb_append_cstr(sb, "[0m");
    result = sb_build(sb);
    sb_free(sb);
    out result;
end

# ═══════════════════════════════════════════════════════
# Styled text builder — combine fg + bg + styles
# ═══════════════════════════════════════════════════════

entity Style:
    fg:        int;     # -1 means unset
    bg:        int;     # -1 means unset
    is_bold:   bool,
        is_dim:    bool,
        is_italic: bool,
        is_uline:  bool,
        is_strike: bool;
end.

func style_new:
    in()
    out Style {
        fg: -1,
        bg: -1,
        is_bold: false,
        is_dim: false,
        is_italic: false,
        is_uline: false,
        is_strike: false
    };
end.

func style_fg:
    in(s: Style; code: int)
    s.fg = code;
    out s;
end.

func style_bg:
    in(s: Style; code: int)
    s.bg = code;
    out s;
end.

func style_bold:
    in(s: Style)
    s.is_bold = true;
    out s;
end.

func style_dim:
    in(s: Style)
    s.is_dim = true;
    out s;
end.

func style_italic:
    in(s: Style)
    s.is_italic = true;
    out s;
end.

func style_underline:
    in(s: Style)
    s.is_uline = true;
    out s;
end.

func style_apply:
    in(s: Style; text: string)
    sb = sb_new();
    has_any = false;

    if s.is_bold do
        sb_append_byte(sb, ESC_BYTE);
        sb_append_cstr(sb, "[1m");
        has_any = true;
    end

    if s.is_dim do
        sb_append_byte(sb, ESC_BYTE);
        sb_append_cstr(sb, "[2m");
        has_any = true;
    end

    if s.is_italic do
        sb_append_byte(sb, ESC_BYTE);
        sb_append_cstr(sb, "[3m");
        has_any = true;
    end

    if s.is_uline do
        sb_append_byte(sb, ESC_BYTE);
        sb_append_cstr(sb, "[4m");
        has_any = true;
    end

    if s.is_strike do
        sb_append_byte(sb, ESC_BYTE);
        sb_append_cstr(sb, "[9m");
        has_any = true;
    end

    if s.fg >= 0 do
        sb_append_byte(sb, ESC_BYTE);
        sb_append_cstr(sb, "[");
        sb_append_i64(sb, s.fg);
        sb_append_cstr(sb, "m");
        has_any = true;
    end

    if s.bg >= 0 do
        sb_append_byte(sb, ESC_BYTE);
        sb_append_cstr(sb, "[");
        sb_append_i64(sb, s.bg);
        sb_append_cstr(sb, "m");
        has_any = true;
    end

    sb_append(sb, text);

    if has_any do
        sb_append_byte(sb, ESC_BYTE);
        sb_append_cstr(sb, "[0m");
    end

    result = sb_build(sb);
    sb_free(sb);
    out result;
end

# ═══════════════════════════════════════════════════════
# Cursor / screen control
# ═══════════════════════════════════════════════════════

func cursor_up:
    in(n: int)
    sb = sb_new();
    sb_append_byte(sb, ESC_BYTE);
    sb_append_cstr(sb, "[");
    sb_append_i64(sb, n);
    sb_append_cstr(sb, "A");
    result = sb_build(sb);
    sb_free(sb);
    out result;
end.

func cursor_down:
    in(n: int)
    sb = sb_new();
    sb_append_byte(sb, ESC_BYTE);
    sb_append_cstr(sb, "[");
    sb_append_i64(sb, n);
    sb_append_cstr(sb, "B");
    result = sb_build(sb);
    sb_free(sb);
    out result;
end.

func cursor_forward:
    in(n: int)
    sb = sb_new();
    sb_append_byte(sb, ESC_BYTE);
    sb_append_cstr(sb, "[");
    sb_append_i64(sb, n);
    sb_append_cstr(sb, "C");
    result = sb_build(sb);
    sb_free(sb);
    out result;
end.

func cursor_back:
    in(n: int)
    sb = sb_new();
    sb_append_byte(sb, ESC_BYTE);
    sb_append_cstr(sb, "[");
    sb_append_i64(sb, n);
    sb_append_cstr(sb, "D");
    result = sb_build(sb);
    sb_free(sb);
    out result;
end.

func clear_screen:
    in()
    sb = sb_new();
    sb_append_byte(sb, ESC_BYTE);
    sb_append_cstr(sb, "[2J");
    sb_append_byte(sb, ESC_BYTE);
    sb_append_cstr(sb, "[H");
    result = sb_build(sb);
    sb_free(sb);
    out result;
end.

func clear_line:
    in()
    sb = sb_new();
    sb_append_byte(sb, ESC_BYTE);
    sb_append_cstr(sb, "[2K");
    result = sb_build(sb);
    sb_free(sb);
    out result;
end
