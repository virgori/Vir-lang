##
 * vir/term/tui.vri — Terminal UI Framework
 * ==========================================
 * Inspired by: tui-rs, bubbletea, crossterm
 *
 * Terminal rendering: cursor control, colors, boxes,
 * styled text, layout primitives, event handling.
 ##

include types;
include vec;
import Vec, vec_new, vec_push, vec_len, vec_get from vec;
include string_builder;
import StringBuilder, sb_new, sb_append, sb_build from string_builder;

# ═══════════════════════════════════════════════════════
# ANSI escape sequences
# ═══════════════════════════════════════════════════════

const ESC = "\x1b[";

# Cursor movement
func cursor_up:    in(n: int) out ESC + int_to_str(n) + "A"; end
func cursor_down:  in(n: int) out ESC + int_to_str(n) + "B"; end
func cursor_right: in(n: int) out ESC + int_to_str(n) + "C"; end
func cursor_left:  in(n: int) out ESC + int_to_str(n) + "D"; end
func cursor_goto:  in(row: int; col: int) out ESC + int_to_str(row) + ";" + int_to_str(col) + "H"; end
func cursor_hide:  out ESC + "?25l"; end
func cursor_show:  out ESC + "?25h"; end
func cursor_save:  out ESC + "s"; end
func cursor_restore: out ESC + "u"; end

# Screen control
func clear_screen:      out ESC + "2J"; end
func clear_line:        out ESC + "2K"; end
func clear_to_end:      out ESC + "0J"; end

# ═══════════════════════════════════════════════════════
# Colors (ANSI 256 / RGB)
# ═══════════════════════════════════════════════════════

entity Color:
    kind: int;     # 0=default, 1=ansi16, 2=ansi256, 3=rgb
    value: int;    # ansi code or packed rgb
end.

const COLOR_DEFAULT = 0;
const COLOR_16      = 1;
const COLOR_256     = 2;
const COLOR_RGB     = 3;

# Standard colors
func color_default: out Color { kind: COLOR_DEFAULT, value: 0 }; end
func color_black:   out Color { kind: COLOR_16, value: 30 }; end
func color_red:     out Color { kind: COLOR_16, value: 31 }; end
func color_green:   out Color { kind: COLOR_16, value: 32 }; end
func color_yellow:  out Color { kind: COLOR_16, value: 33 }; end
func color_blue:    out Color { kind: COLOR_16, value: 34 }; end
func color_magenta: out Color { kind: COLOR_16, value: 35 }; end
func color_cyan:    out Color { kind: COLOR_16, value: 36 }; end
func color_white:   out Color { kind: COLOR_16, value: 37 }; end

func color_256:
    in(code: int)
    out Color { kind: COLOR_256, value: code };
end.

func color_rgb:
    in(r: int; g: int; b: int)
    out Color { kind: COLOR_RGB, value: (r << 16) | (g << 8) | b };
end.

func _color_fg_code:
    in(c: Color)
    if c.kind == COLOR_DEFAULT do out ESC + "39m"; end
    if c.kind == COLOR_16 do out ESC + int_to_str(c.value) + "m"; end
    if c.kind == COLOR_256 do out ESC + "38;5;" + int_to_str(c.value) + "m"; end
    if c.kind == COLOR_RGB do
        r = (c.value >> 16) & 0xFF;
        g = (c.value >> 8) & 0xFF;
        b = c.value & 0xFF;
        out ESC + "38;2;" + int_to_str(r) + ";" + int_to_str(g) + ";" + int_to_str(b) + "m";
    end
    out "";
end.

func _color_bg_code:
    in(c: Color)
    if c.kind == COLOR_DEFAULT do out ESC + "49m"; end
    if c.kind == COLOR_16 do out ESC + int_to_str(c.value + 10) + "m"; end
    if c.kind == COLOR_256 do out ESC + "48;5;" + int_to_str(c.value) + "m"; end
    if c.kind == COLOR_RGB do
        r = (c.value >> 16) & 0xFF;
        g = (c.value >> 8) & 0xFF;
        b = c.value & 0xFF;
        out ESC + "48;2;" + int_to_str(r) + ";" + int_to_str(g) + ";" + int_to_str(b) + "m";
    end
    out "";
end.

func reset_style: out ESC + "0m"; end

# ═══════════════════════════════════════════════════════
# Style
# ═══════════════════════════════════════════════════════

entity Style:
    fg:        Color,
        bg:        Color,
        bold:      bool,
        italic:    bool,
        underline: bool,
        dim:       bool;
end.

func style_new:
    out Style {
        fg: color_default(), bg: color_default(),
        bold: false, italic: false,
        underline: false, dim: false
    };
end.

func style_apply:
    in(s: Style; text: string)
    sb = sb_new();
    sb_append(sb, _color_fg_code(s.fg));
    sb_append(sb, _color_bg_code(s.bg));
    if s.bold do sb_append(sb, ESC + "1m"); end
    if s.dim do sb_append(sb, ESC + "2m"); end
    if s.italic do sb_append(sb, ESC + "3m"); end
    if s.underline do sb_append(sb, ESC + "4m"); end
    sb_append(sb, text);
    sb_append(sb, reset_style());
    out sb_build(sb);
end

# ═══════════════════════════════════════════════════════
# Box drawing
# ═══════════════════════════════════════════════════════

entity BoxChars:
    tl: string;   # top-left
    tr: string;   # top-right
    bl: string;   # bottom-left
    br: string;   # bottom-right
    h:  string;   # horizontal
    v:  string;   # vertical
end.

func box_single:
    out BoxChars { tl: "┌", tr: "┐", bl: "└", br: "┘", h: "─", v: "│" };
end.

func box_double:
    out BoxChars { tl: "╔", tr: "╗", bl: "╚", br: "╝", h: "═", v: "║" };
end.

func box_rounded:
    out BoxChars { tl: "╭", tr: "╮", bl: "╰", br: "╯", h: "─", v: "│" };
end.

func draw_box:
    in(bc: BoxChars; width: int; height: int)
    sb = sb_new();
    # Top border
    sb_append(sb, bc.tl);
    i = 0;
    when i < width - 2 loop
        sb_append(sb, bc.h);
        i = i + 1;
    end
    sb_append(sb, bc.tr);
    sb_append(sb, "\n");

    # Middle
    row = 0;
    when row < height - 2 loop
        sb_append(sb, bc.v);
        j = 0;
        when j < width - 2 loop
            sb_append(sb, " ");
            j = j + 1;
        end
        sb_append(sb, bc.v);
        sb_append(sb, "\n");
        row = row + 1;
    end

    # Bottom border
    sb_append(sb, bc.bl);
    i = 0;
    when i < width - 2 loop
        sb_append(sb, bc.h);
        i = i + 1;
    end
    sb_append(sb, bc.br);
    sb_append(sb, "\n");

    out sb_build(sb);
end

# ═══════════════════════════════════════════════════════
# Progress bar
# ═══════════════════════════════════════════════════════

func progress_bar:
    in(current: int; total: int; width: int)
    sb = sb_new();
    sb_append(sb, "[");
    filled = 0;
    if total > 0 do
        filled = (current * (width - 2)) / total;
    end
    i = 0;
    when i < width - 2 loop
        if i < filled do
            sb_append(sb, "█");
        else
            sb_append(sb, "░");
        end
        i = i + 1;
    end
    sb_append(sb, "] ");
    pct = 0;
    if total > 0 do
        pct = (current * 100) / total;
    end
    sb_append(sb, int_to_str(pct));
    sb_append(sb, "%");
    out sb_build(sb);
end

# ═══════════════════════════════════════════════════════
# Spinner
# ═══════════════════════════════════════════════════════

func spinner_frame:
    in(tick: int)
    frames = vec_new();
    vec_push(frames, "⠋");
    vec_push(frames, "⠙");
    vec_push(frames, "⠹");
    vec_push(frames, "⠸");
    vec_push(frames, "⠼");
    vec_push(frames, "⠴");
    vec_push(frames, "⠦");
    vec_push(frames, "⠧");
    vec_push(frames, "⠇");
    vec_push(frames, "⠏");
    idx = tick % vec_len(frames);
    out vec_get(frames, idx);
end

# ═══════════════════════════════════════════════════════
# Table rendering
# ═══════════════════════════════════════════════════════

entity Table:
    headers:   Vec;     # Vec<string>
    rows:      Vec;     # Vec<Vec<string>>
    col_widths: Vec;    # Vec<int>
end.

func table_new:
    in(headers: Vec)
    widths = vec_new();
    i = 0;
    when i < vec_len(headers) loop
        vec_push(widths, str_len(vec_get(headers, i)));
        i = i + 1;
    end
    out Table { headers: headers, rows: vec_new(), col_widths: widths };
end.

func table_add_row:
    in(t: Table; row: Vec)
    vec_push(t.rows, row);
    i = 0;
    when i < vec_len(row) && i < vec_len(t.col_widths) loop
        w = str_len(vec_get(row, i));
        if w > vec_get(t.col_widths, i) do
            vec_set(t.col_widths, i, w);
        end
        i = i + 1;
    end
end.

func _pad_right:
    in(s: string; width: int)
    sb = sb_new();
    sb_append(sb, s);
    i = str_len(s);
    when i < width loop
        sb_append(sb, " ");
        i = i + 1;
    end
    out sb_build(sb);
end.

func table_render:
    in(t: Table)
    bc = box_single();
    sb = sb_new();

    # Header
    sb_append(sb, bc.v);
    i = 0;
    when i < vec_len(t.headers) loop
        sb_append(sb, " ");
        sb_append(sb, _pad_right(vec_get(t.headers, i), vec_get(t.col_widths, i)));
        sb_append(sb, " ");
        sb_append(sb, bc.v);
        i = i + 1;
    end
    sb_append(sb, "\n");

    # Separator
    sb_append(sb, "├");
    i = 0;
    when i < vec_len(t.col_widths) loop
        j = 0;
        when j < vec_get(t.col_widths, i) + 2 loop
            sb_append(sb, "─");
            j = j + 1;
        end
        if i < vec_len(t.col_widths) - 1 do
            sb_append(sb, "┼");
        else
            sb_append(sb, "┤");
        end
        i = i + 1;
    end
    sb_append(sb, "\n");

    # Rows
    r = 0;
    when r < vec_len(t.rows) loop
        row = vec_get(t.rows, r);
        sb_append(sb, bc.v);
        i = 0;
        when i < vec_len(row) loop
            sb_append(sb, " ");
            sb_append(sb, _pad_right(vec_get(row, i), vec_get(t.col_widths, i)));
            sb_append(sb, " ");
            sb_append(sb, bc.v);
            i = i + 1;
        end
        sb_append(sb, "\n");
        r = r + 1;
    end

    out sb_build(sb);
end
