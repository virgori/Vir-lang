##
 * vir/term/table.vri — Terminal Table Formatting
 * ================================================
 * Inspired by Rust: tabled, comfy-table crates
 * Inspired by Python: tabulate, prettytable
 * Inspired by Go: tablewriter
 *
 * Phase C — Tier 2: Pretty-print tables with borders, alignment,
 * column width auto-detection, and styles.
 ##

include types;
include vec;
import Vec, vec_new, vec_push, vec_get, vec_set, vec_len from vec;
include builder;
import StringBuilder, sb_new, sb_append, sb_append_byte, sb_append_i64, sb_build, sb_free from builder;

# ═══════════════════════════════════════════════════════
# Alignment constants
# ═══════════════════════════════════════════════════════

const ALIGN_LEFT   = 0;
const ALIGN_CENTER = 1;
const ALIGN_RIGHT  = 2;

# ═══════════════════════════════════════════════════════
# Table style constants
# ═══════════════════════════════════════════════════════

const STYLE_ASCII   = 0;   # +---+---+
const STYLE_SIMPLE  = 1;   # no borders, just spacing
const STYLE_COMPACT = 2;   # -------- header separator only

# ═══════════════════════════════════════════════════════
# Table entity
# ═══════════════════════════════════════════════════════

entity Table:
    headers:    Vec;       # Vec<string>
    rows:       Vec;       # Vec<Vec<string>>
    col_aligns: Vec;       # Vec<int> (ALIGN_*)
    col_widths: Vec;       # Vec<int> (computed)
    num_cols:   int,
        style:      int,
        padding:    int;       # spaces on each side of cell
end

# ─── Constructor ────────────────────────────────────

func table_new:
    in(headers: Vec)
    n = vec_len(headers);
    aligns = vec_new();
    widths = vec_new();
    i = 0;
    when i < n loop
        vec_push(aligns, ALIGN_LEFT);
        h = vec_get(headers, i);
        vec_push(widths, str_len(h));
        i = i + 1;
    end
    out Table (
        headers: headers,
        rows: vec_new(),
        col_aligns: aligns,
        col_widths: widths,
        num_cols: n,
        style: STYLE_ASCII,
        padding: 1
    );
end
# ─── Configuration ──────────────────────────────────

func table_set_style:
    in(t: Table; style: int)
    t.style = style;
end
func table_set_padding:
    in(t: Table; padding: int)
    t.padding = padding;
end
func table_set_align:
    in(t: Table; col: int; align: int)
    if col >= 0 and col < t.num_cols do
        vec_set(t.col_aligns, col, align);
    end
end
func table_set_all_align:
    in(t: Table; align: int)
    i = 0;
    when i < t.num_cols loop
        vec_set(t.col_aligns, i, align);
        i = i + 1;
    end
end
# ─── Add rows ──────────────────────────────────────

func table_add_row:
    in(t: Table; row: Vec)
    vec_push(t.rows, row);
    # Update column widths
    i = 0;
    when i < t.num_cols and i < vec_len(row) loop
        cell = vec_get(row, i);
        w = str_len(cell);
        if w > vec_get(t.col_widths, i) do
            vec_set(t.col_widths, i, w);
        end
        i = i + 1;
    end
end
# ─── Render ─────────────────────────────────────────

func table_render:
    in(t: Table)
    sb = sb_new();

    if t.style == STYLE_ASCII do
        _render_ascii(sb, t);
    eif t.style == STYLE_SIMPLE do
        _render_simple(sb, t);
    eif t.style == STYLE_COMPACT do
        _render_compact(sb, t);
    end

    result = sb_build(sb);
    sb_free(sb);
    out result;
end
# ─── ASCII style (borders) ─────────────────────────

func _render_ascii:
    in(sb: StringBuilder; t: Table)
    _render_separator(sb, t, 43, 45);    # '+' and '-'

    # Header row
    _render_row(sb, t, t.headers, 124);  # '|'
    _render_separator(sb, t, 43, 45);

    # Data rows
    i = 0;
    when i < vec_len(t.rows) loop
        _render_row(sb, t, vec_get(t.rows, i), 124);
        i = i + 1;
    end
    _render_separator(sb, t, 43, 45);
end
# ─── Simple style (no borders) ─────────────────────

func _render_simple:
    in(sb: StringBuilder; t: Table)
    # Header row
    _render_row_no_border(sb, t, t.headers);

    # Data rows
    i = 0;
    when i < vec_len(t.rows) loop
        _render_row_no_border(sb, t, vec_get(t.rows, i));
        i = i + 1;
    end
end
# ─── Compact style (header separator only) ─────────

func _render_compact:
    in(sb: StringBuilder; t: Table)
    # Header row
    _render_row_no_border(sb, t, t.headers);

    # Separator under header
    total_w = 0;
    i = 0;
    when i < t.num_cols loop
        total_w = total_w + vec_get(t.col_widths, i) + t.padding * 2;
        if i < t.num_cols - 1 do
            total_w = total_w + 1;
        end
        i = i + 1;
    end
    j = 0;
    when j < total_w loop
        sb_append_byte(sb, 45);   # '-'
        j = j + 1;
    end
    sb_append_byte(sb, 10);

    # Data rows
    i = 0;
    when i < vec_len(t.rows) loop
        _render_row_no_border(sb, t, vec_get(t.rows, i));
        i = i + 1;
    end
end
# ─── Row renderers ─────────────────────────────────

func _render_separator:
    in(sb: StringBuilder; t: Table; corner: int; fill: int)
    i = 0;
    when i < t.num_cols loop
        sb_append_byte(sb, corner);
        w = vec_get(t.col_widths, i) + t.padding * 2;
        j = 0;
        when j < w loop
            sb_append_byte(sb, fill);
            j = j + 1;
        end
        i = i + 1;
    end
    sb_append_byte(sb, corner);
    sb_append_byte(sb, 10);
end
func _render_row:
    in(sb: StringBuilder; t: Table; cells: Vec; border: int)
    i = 0;
    when i < t.num_cols loop
        sb_append_byte(sb, border);
        cell = "";
        if i < vec_len(cells) do
            cell = vec_get(cells, i);
        end
        w = vec_get(t.col_widths, i);
        align = vec_get(t.col_aligns, i);
        _render_cell(sb, cell, w, align, t.padding);
        i = i + 1;
    end
    sb_append_byte(sb, border);
    sb_append_byte(sb, 10);
end
func _render_row_no_border:
    in(sb: StringBuilder; t: Table; cells: Vec)
    i = 0;
    when i < t.num_cols loop
        if i > 0 do
            sb_append_byte(sb, 32);   # space separator
        end
        cell = "";
        if i < vec_len(cells) do
            cell = vec_get(cells, i);
        end
        w = vec_get(t.col_widths, i);
        align = vec_get(t.col_aligns, i);
        _render_cell(sb, cell, w, align, t.padding);
        i = i + 1;
    end
    sb_append_byte(sb, 10);
end
func _render_cell:
    in(sb: StringBuilder; text: string; width: int; align: int; padding: int)
    gap = width - str_len(text);
    if gap < 0 do
        gap = 0;
    end

    # padding before
    p = 0;
    when p < padding loop
        sb_append_byte(sb, 32);
        p = p + 1;
    end

    if align == ALIGN_LEFT do
        sb_append(sb, text);
        j = 0;
        when j < gap loop
            sb_append_byte(sb, 32);
            j = j + 1;
        end
    eif align == ALIGN_RIGHT do
        j = 0;
        when j < gap loop
            sb_append_byte(sb, 32);
            j = j + 1;
        end
        sb_append(sb, text);
    eif align == ALIGN_CENTER do
        left = gap / 2;
        right = gap - left;
        j = 0;
        when j < left loop
            sb_append_byte(sb, 32);
            j = j + 1;
        end
        sb_append(sb, text);
        j = 0;
        when j < right loop
            sb_append_byte(sb, 32);
            j = j + 1;
        end
    end

    # padding after
    p = 0;
    when p < padding loop
        sb_append_byte(sb, 32);
        p = p + 1;
    end
end
# ─── Convenience: int to string ─────────────────────

func table_int_to_str:
    in(v: int)
    sb = sb_new();
    sb_append_i64(sb, v);
    result = sb_build(sb);
    sb_free(sb);
    out result;
end
# ─── Convenience: build header vec from args ────────

func table_headers_2:
    in(a: string; b: string)
    v = vec_new();
    vec_push(v, a);
    vec_push(v, b);
    out v;
end
func table_headers_3:
    in(a: string; b: string; c: string)
    v = vec_new();
    vec_push(v, a);
    vec_push(v, b);
    vec_push(v, c);
    out v;
end
func table_headers_4:
    in(a: string; b: string; c: string; d: string)
    v = vec_new();
    vec_push(v, a);
    vec_push(v, b);
    vec_push(v, c);
    vec_push(v, d);
    out v;
end
func table_row_2:
    in(a: string; b: string)
    v = vec_new();
    vec_push(v, a);
    vec_push(v, b);
    out v;
end
func table_row_3:
    in(a: string; b: string; c: string)
    v = vec_new();
    vec_push(v, a);
    vec_push(v, b);
    vec_push(v, c);
    out v;
end
func table_row_4:
    in(a: string; b: string; c: string; d: string)
    v = vec_new();
    vec_push(v, a);
    vec_push(v, b);
    vec_push(v, c);
    vec_push(v, d);
    out v;
end