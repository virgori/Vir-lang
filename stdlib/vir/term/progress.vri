##
 * vir/term/progress.vri — Terminal Progress Bar
 * ===============================================
 * Inspired by Rust: indicatif crate
 * Inspired by Python: tqdm, rich.progress
 * Inspired by Go: schollz/progressbar
 *
 * Phase C — Tier 2: Progress bar with ETA, percentage,
 * custom format, and spinner support.
 ##

include types;
include vec;
import Vec, vec_new, vec_push, vec_get, vec_len from vec;
include builder;
import StringBuilder, sb_new, sb_append, sb_append_byte, sb_append_i64, sb_build, sb_free from builder;
include time;
import Instant, Duration, now, elapsed, sleep from time;

# ═══════════════════════════════════════════════════════
# Progress Bar entity
# ═══════════════════════════════════════════════════════

entity ProgressBar:
    total:      int;
    current:    int;
    width:      int;       # bar width in chars
    fill_char:  int;       # fill character byte (default '█' → use '#')
    empty_char: int;       # empty character byte (default '░' → use '-')
    prefix:     string;
    suffix:     string;
    started:    Instant;
    finished:   bool;
end

# ─── Constructor ────────────────────────────────────

func progress_new:
    in(total: int)
    out ProgressBar {
        total: total,
        current: 0,
        width: 40,
        fill_char: 35,     # '#'
        empty_char: 45,    # '-'
        prefix: "",
        suffix: "",
        started: now(),
        finished: false
    };
end

# ─── Configuration ──────────────────────────────────

func progress_set_width:
    in(pb: ProgressBar; width: int)
    pb.width = width;
end

func progress_set_fill:
    in(pb: ProgressBar; ch: int)
    pb.fill_char = ch;
end

func progress_set_empty:
    in(pb: ProgressBar; ch: int)
    pb.empty_char = ch;
end

func progress_set_prefix:
    in(pb: ProgressBar; prefix: string)
    pb.prefix = prefix;
end

func progress_set_suffix:
    in(pb: ProgressBar; suffix: string)
    pb.suffix = suffix;
end

# ─── Update ─────────────────────────────────────────

func progress_inc:
    in(pb: ProgressBar)
    pb.current = pb.current + 1;
    if pb.current >= pb.total:
        pb.finished = true;
    end
end

func progress_inc_by:
    in(pb: ProgressBar; n: int)
    pb.current = pb.current + n;
    if pb.current >= pb.total:
        pb.current = pb.total;
        pb.finished = true;
    end
end

func progress_set:
    in(pb: ProgressBar; pos: int)
    pb.current = pos;
    if pb.current >= pb.total:
        pb.current = pb.total;
        pb.finished = true;
    end
end

func progress_finish:
    in(pb: ProgressBar)
    pb.current = pb.total;
    pb.finished = true;
end

func progress_reset:
    in(pb: ProgressBar)
    pb.current = 0;
    pb.finished = false;
    pb.started = now();
end

# ─── Query ──────────────────────────────────────────

func progress_percentage:
    in(pb: ProgressBar)
    if pb.total == 0 out 100 end:
    out (pb.current * 100) / pb.total;
end

func progress_is_finished:
    in(pb: ProgressBar)
    out pb.finished;
end

func progress_position:
    in(pb: ProgressBar)
    out pb.current;
end

# ─── Render the progress bar string ─────────────────

func progress_render:
    in(pb: ProgressBar)
    sb = sb_new();

    # Carriage return for overwrite
    sb_append_byte(sb, 13);   # '\r'

    # Prefix
    if str_len(pb.prefix) > 0:
        sb_append(sb, pb.prefix);
        sb_append_byte(sb, 32);
    end

    # Percentage
    pct = progress_percentage(pb);
    if pct < 10:
        sb_append(sb, "  ");
    eif pct < 100:
        sb_append(sb, " ");
    end
    sb_append_i64(sb, pct);
    sb_append(sb, "% [");

    # Bar
    filled = 0;
    if pb.total > 0:
        filled = (pb.current * pb.width) / pb.total;
    end
    if filled > pb.width:
        filled = pb.width;
    end

    i = 0;
    when i < filled loop
        sb_append_byte(sb, pb.fill_char);
        i = i + 1;
    end
    when i < pb.width loop
        sb_append_byte(sb, pb.empty_char);
        i = i + 1;
    end

    sb_append(sb, "] ");

    # Position / Total
    sb_append_i64(sb, pb.current);
    sb_append(sb, "/");
    sb_append_i64(sb, pb.total);

    # ETA estimate
    el = elapsed(pb.started);
    if pb.current > 0 and not pb.finished:
        # Simple linear ETA
        elapsed_ms = el.secs * 1000 + el.nanos / 1000000;
        rate = elapsed_ms / pb.current;     # ms per item
        remaining = (pb.total - pb.current) * rate;
        eta_s = remaining / 1000;

        sb_append(sb, " ETA: ");
        if eta_s >= 3600:
            sb_append_i64(sb, eta_s / 3600);
            sb_append(sb, "h");
            sb_append_i64(sb, (eta_s / 60) - (eta_s / 3600) * 60);
            sb_append(sb, "m");
        eif eta_s >= 60:
            sb_append_i64(sb, eta_s / 60);
            sb_append(sb, "m");
            sb_append_i64(sb, eta_s - (eta_s / 60) * 60);
            sb_append(sb, "s");
        else:
            sb_append_i64(sb, eta_s);
            sb_append(sb, "s");
        end
    end

    if pb.finished:
        sb_append(sb, " Done!");
    end

    # Suffix
    if str_len(pb.suffix) > 0:
        sb_append(sb, " ");
        sb_append(sb, pb.suffix);
    end

    result = sb_build(sb);
    sb_free(sb);
    out result;
end

# ═══════════════════════════════════════════════════════
# Spinner entity
# ═══════════════════════════════════════════════════════

entity Spinner:
    frames:  Vec;        # Vec<string>
    index:   int;
    message: string;
end

func spinner_new:
    in()
    frames = vec_new();
    vec_push(frames, "|");
    vec_push(frames, "/");
    vec_push(frames, "-");
    vec_push(frames, "\\");
    out Spinner {
        frames: frames,
        index: 0,
        message: ""
    };
end

func spinner_dots:
    in()
    frames = vec_new();
    vec_push(frames, ".  ");
    vec_push(frames, ".. ");
    vec_push(frames, "...");
    vec_push(frames, " ..");
    vec_push(frames, "  .");
    vec_push(frames, "   ");
    out Spinner {
        frames: frames,
        index: 0,
        message: ""
    };
end

func spinner_set_message:
    in(s: Spinner; msg: string)
    s.message = msg;
end

func spinner_tick:
    in(s: Spinner)
    s.index = s.index + 1;
    if s.index >= vec_len(s.frames):
        s.index = 0;
    end
end

func spinner_render:
    in(s: Spinner)
    sb = sb_new();
    sb_append_byte(sb, 13);   # '\r'
    frame = vec_get(s.frames, s.index);
    sb_append(sb, frame);
    sb_append_byte(sb, 32);
    sb_append(sb, s.message);
    result = sb_build(sb);
    sb_free(sb);
    out result;
end

# ═══════════════════════════════════════════════════════
# Multi-progress (track multiple bars)
# ═══════════════════════════════════════════════════════

entity MultiProgress:
    bars: Vec;      # Vec<ProgressBar>
end

func multi_progress_new:
    in()
    out MultiProgress { bars: vec_new() };
end

func multi_progress_add:
    in(mp: MultiProgress; pb: ProgressBar)
    vec_push(mp.bars, pb);
end

func multi_progress_render:
    in(mp: MultiProgress)
    sb = sb_new();
    i = 0;
    when i < vec_len(mp.bars) loop
        pb = vec_get(mp.bars, i);
        line = progress_render(pb);
        # Skip the \r for multi-line
        j = 0;
        when j < str_len(line) loop
            ch = str_byte_at(line, j);
            if ch != 13:
                sb_append_byte(sb, ch);
            end
            j = j + 1;
        end
        sb_append_byte(sb, 10);
        i = i + 1;
    end
    result = sb_build(sb);
    sb_free(sb);
    out result;
end
