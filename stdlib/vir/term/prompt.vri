##
 * vir/term/prompt.vri — Interactive Terminal Prompts
 * ===================================================
 * Inspired by Rust: dialoguer, inquire crates
 * Inspired by Python: questionary, inquirer
 * Inspired by Go: AlecAivazis/survey
 *
 * Phase C — Tier 3: Interactive prompts for CLI apps.
 * Supports: text input, yes/no confirm, selection menu,
 * password input (masked), multi-select.
 * Uses ANSI escape codes for cursor control.
 ##

include types;
include option;
import Option, Some, None, is_some, is_none, unwrap from option;
include vec;
import Vec, vec_new, vec_push, vec_get, vec_set, vec_len from vec;
include builder;
import StringBuilder, sb_new, sb_append, sb_append_byte, sb_append_i64,
       sb_build, sb_free from builder;

# ═══════════════════════════════════════════════════════
# ANSI escape helpers
# ═══════════════════════════════════════════════════════

const ESC = 27;

func _ansi_reset:
    in()
    sb = sb_new();
    sb_append_byte(sb, ESC);
    sb_append(sb, "[0m");
    result = sb_build(sb);
    sb_free(sb);
    out result;
end.

func _ansi_bold:
    in()
    sb = sb_new();
    sb_append_byte(sb, ESC);
    sb_append(sb, "[1m");
    result = sb_build(sb);
    sb_free(sb);
    out result;
end.

func _ansi_green:
    in()
    sb = sb_new();
    sb_append_byte(sb, ESC);
    sb_append(sb, "[32m");
    result = sb_build(sb);
    sb_free(sb);
    out result;
end.

func _ansi_cyan:
    in()
    sb = sb_new();
    sb_append_byte(sb, ESC);
    sb_append(sb, "[36m");
    result = sb_build(sb);
    sb_free(sb);
    out result;
end.

func _ansi_dim:
    in()
    sb = sb_new();
    sb_append_byte(sb, ESC);
    sb_append(sb, "[2m");
    result = sb_build(sb);
    sb_free(sb);
    out result;
end.

func _ansi_clear_line:
    in()
    sb = sb_new();
    sb_append_byte(sb, ESC);
    sb_append(sb, "[2K");
    result = sb_build(sb);
    sb_free(sb);
    out result;
end.

func _ansi_cursor_up:
    in(n: int)
    sb = sb_new();
    sb_append_byte(sb, ESC);
    sb_append(sb, "[");
    sb_append_i64(sb, n);
    sb_append(sb, "A");
    result = sb_build(sb);
    sb_free(sb);
    out result;
end.

func _ansi_hide_cursor:
    in()
    sb = sb_new();
    sb_append_byte(sb, ESC);
    sb_append(sb, "[?25l");
    result = sb_build(sb);
    sb_free(sb);
    out result;
end.

func _ansi_show_cursor:
    in()
    sb = sb_new();
    sb_append_byte(sb, ESC);
    sb_append(sb, "[?25h");
    result = sb_build(sb);
    sb_free(sb);
    out result;
end

# ═══════════════════════════════════════════════════════
# Prompt types
# ═══════════════════════════════════════════════════════

const PROMPT_TEXT      = 0;
const PROMPT_CONFIRM   = 1;
const PROMPT_SELECT    = 2;
const PROMPT_PASSWORD  = 3;
const PROMPT_MULTI     = 4;

# ═══════════════════════════════════════════════════════
# Text prompt rendering
# ═══════════════════════════════════════════════════════

entity TextPrompt:
    message:     string,
        default_val: string,
        placeholder: string;
end.

func text_prompt_new:
    in(message: string)
    out TextPrompt {
        message: message,
        default_val: "",
        placeholder: ""
    };
end.

func text_prompt_default:
    in(p: TextPrompt; default_val: string)
    p.default_val = default_val;
end.

func text_prompt_placeholder:
    in(p: TextPrompt; placeholder: string)
    p.placeholder = placeholder;
end.

func text_prompt_render:
    in(p: TextPrompt)
    sb = sb_new();
    sb_append(sb, _ansi_green());
    sb_append(sb, "? ");
    sb_append(sb, _ansi_bold());
    sb_append(sb, p.message);
    sb_append(sb, _ansi_reset());

    if str_len(p.default_val) > 0 do
        sb_append(sb, _ansi_dim());
        sb_append(sb, " (");
        sb_append(sb, p.default_val);
        sb_append(sb, ")");
        sb_append(sb, _ansi_reset());
    end
    sb_append(sb, " ");

    if str_len(p.placeholder) > 0 do
        sb_append(sb, _ansi_dim());
        sb_append(sb, p.placeholder);
        sb_append(sb, _ansi_reset());
    end

    result = sb_build(sb);
    sb_free(sb);
    out result;
end

# ═══════════════════════════════════════════════════════
# Confirm prompt rendering
# ═══════════════════════════════════════════════════════

entity ConfirmPrompt:
    message:     string,
        default_yes: bool;
end.

func confirm_prompt_new:
    in(message: string)
    out ConfirmPrompt {
        message: message,
        default_yes: false
    };
end.

func confirm_prompt_default:
    in(p: ConfirmPrompt; yes: bool)
    p.default_yes = yes;
end.

func confirm_prompt_render:
    in(p: ConfirmPrompt)
    sb = sb_new();
    sb_append(sb, _ansi_green());
    sb_append(sb, "? ");
    sb_append(sb, _ansi_bold());
    sb_append(sb, p.message);
    sb_append(sb, _ansi_reset());
    sb_append(sb, _ansi_dim());

    if p.default_yes do
        sb_append(sb, " (Y/n)");
    else
        sb_append(sb, " (y/N)");
    end

    sb_append(sb, _ansi_reset());
    sb_append(sb, " ");

    result = sb_build(sb);
    sb_free(sb);
    out result;
end

# ═══════════════════════════════════════════════════════
# Select prompt rendering
# ═══════════════════════════════════════════════════════

entity SelectPrompt:
    message:  string,
        options:  Vec;       # Vec<string>
    selected: int;       # current selection index
end.

func select_prompt_new:
    in(message: string; options: Vec)
    out SelectPrompt {
        message: message,
        options: options,
        selected: 0
    };
end.

func select_prompt_move_up:
    in(p: SelectPrompt)
    if p.selected > 0 do
        p.selected = p.selected - 1;
    end
end.

func select_prompt_move_down:
    in(p: SelectPrompt)
    if p.selected < vec_len(p.options) - 1 do
        p.selected = p.selected + 1;
    end
end.

func select_prompt_get_selection:
    in(p: SelectPrompt)
    out p.selected;
end.

func select_prompt_get_value:
    in(p: SelectPrompt)
    out vec_get(p.options, p.selected);
end.

func select_prompt_render:
    in(p: SelectPrompt)
    sb = sb_new();
    sb_append(sb, _ansi_green());
    sb_append(sb, "? ");
    sb_append(sb, _ansi_bold());
    sb_append(sb, p.message);
    sb_append(sb, _ansi_reset());
    sb_append(sb, _ansi_dim());
    sb_append(sb, " (use arrows)");
    sb_append(sb, _ansi_reset());
    sb_append_byte(sb, 10);

    i = 0;
    when i < vec_len(p.options) loop
        option_text = vec_get(p.options, i);
        if i == p.selected do
            sb_append(sb, _ansi_cyan());
            sb_append(sb, "❯ ");
            sb_append(sb, option_text);
            sb_append(sb, _ansi_reset());
        else
            sb_append(sb, "  ");
            sb_append(sb, option_text);
        end
        sb_append_byte(sb, 10);
        i = i + 1;
    end

    result = sb_build(sb);
    sb_free(sb);
    out result;
end

# ═══════════════════════════════════════════════════════
# Password prompt rendering
# ═══════════════════════════════════════════════════════

entity PasswordPrompt:
    message:   string,
        mask_char: int;       # character to show instead of input
end.

func password_prompt_new:
    in(message: string)
    out PasswordPrompt {
        message: message,
        mask_char: 42       # '*'
    };
end.

func password_prompt_mask:
    in(p: PasswordPrompt; ch: int)
    p.mask_char = ch;
end.

func password_prompt_render:
    in(p: PasswordPrompt; input_len: int)
    sb = sb_new();
    sb_append(sb, _ansi_green());
    sb_append(sb, "? ");
    sb_append(sb, _ansi_bold());
    sb_append(sb, p.message);
    sb_append(sb, _ansi_reset());
    sb_append(sb, " ");

    i = 0;
    when i < input_len loop
        sb_append_byte(sb, p.mask_char);
        i = i + 1;
    end

    result = sb_build(sb);
    sb_free(sb);
    out result;
end

# ═══════════════════════════════════════════════════════
# Multi-select prompt rendering
# ═══════════════════════════════════════════════════════

entity MultiSelectPrompt:
    message:  string,
        options:  Vec;       # Vec<string>
    selected: Vec;       # Vec<bool>
    cursor:   int;
end.

func multi_select_new:
    in(message: string; options: Vec)
    sel = vec_new();
    i = 0;
    when i < vec_len(options) loop
        vec_push(sel, false);
        i = i + 1;
    end
    out MultiSelectPrompt {
        message: message,
        options: options,
        selected: sel,
        cursor: 0
    };
end.

func multi_select_toggle:
    in(p: MultiSelectPrompt)
    current = vec_get(p.selected, p.cursor);
    vec_set(p.selected, p.cursor, not current);
end.

func multi_select_move_up:
    in(p: MultiSelectPrompt)
    if p.cursor > 0 do
        p.cursor = p.cursor - 1;
    end
end.

func multi_select_move_down:
    in(p: MultiSelectPrompt)
    if p.cursor < vec_len(p.options) - 1 do
        p.cursor = p.cursor + 1;
    end
end.

func multi_select_get_selected:
    in(p: MultiSelectPrompt)
    result = vec_new();
    i = 0;
    when i < vec_len(p.options) loop
        if vec_get(p.selected, i) do
            vec_push(result, vec_get(p.options, i));
        end
        i = i + 1;
    end
    out result;
end.

func multi_select_render:
    in(p: MultiSelectPrompt)
    sb = sb_new();
    sb_append(sb, _ansi_green());
    sb_append(sb, "? ");
    sb_append(sb, _ansi_bold());
    sb_append(sb, p.message);
    sb_append(sb, _ansi_reset());
    sb_append(sb, _ansi_dim());
    sb_append(sb, " (space to toggle, enter to confirm)");
    sb_append(sb, _ansi_reset());
    sb_append_byte(sb, 10);

    i = 0;
    when i < vec_len(p.options) loop
        option_text = vec_get(p.options, i);

        if i == p.cursor do
            sb_append(sb, _ansi_cyan());
            sb_append(sb, "❯ ");
        else
            sb_append(sb, "  ");
        end

        if vec_get(p.selected, i) do
            sb_append(sb, "[x] ");
        else
            sb_append(sb, "[ ] ");
        end

        sb_append(sb, option_text);
        if i == p.cursor do
            sb_append(sb, _ansi_reset());
        end
        sb_append_byte(sb, 10);
        i = i + 1;
    end

    result = sb_build(sb);
    sb_free(sb);
    out result;
end
