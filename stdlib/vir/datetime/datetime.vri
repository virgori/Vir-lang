##
 * vir/datetime/datetime.vri — Date & Time Library
 * =================================================
 * Inspired by Python: datetime module
 * Inspired by Rust: chrono crate
 *
 * Calendar dates, wall-clock times, timestamps, durations,
 * formatting, and parsing.
 ##

include types;
include str;
import str_fmt, str_pad_left, str_len, str_substr,
       str_to_int, str_contains from str;
include option;
import Option, Some, None from option;
include time;
import time_now from time;
include math;
import math_floor, math_mod from math;

# ═══════════════════════════════════════════════════════
# TimeDelta — calendar-level duration (float seconds)
# Note: For nanosecond-precision Duration, use vir/time.
# ═══════════════════════════════════════════════════════

entity TimeDelta:
    total_seconds: float;
end

func timedelta_new:
    in(days: int; hours: int; minutes: int; seconds: int; millis: int)
    out TimeDelta {
        total_seconds: float(days) * 86400.0
                     + float(hours) * 3600.0
                     + float(minutes) * 60.0
                     + float(seconds)
                     + float(millis) * 0.001;
    };
end

func timedelta_seconds:  in(s: float)  out TimeDelta { total_seconds: s }; end
func timedelta_minutes:  in(m: float)  out TimeDelta { total_seconds: m * 60.0 }; end
func timedelta_hours:    in(h: float)  out TimeDelta { total_seconds: h * 3600.0 }; end
func timedelta_days:     in(d: float)  out TimeDelta { total_seconds: d * 86400.0 }; end

func td_to_days:    in(d: TimeDelta) out d.total_seconds / 86400.0; end
func td_to_hours:   in(d: TimeDelta) out d.total_seconds / 3600.0; end
func td_to_minutes: in(d: TimeDelta) out d.total_seconds / 60.0; end
func td_to_seconds: in(d: TimeDelta) out d.total_seconds; end
func td_to_millis:  in(d: TimeDelta) out d.total_seconds * 1000.0; end

func td_add: in(a: TimeDelta; b: TimeDelta) out TimeDelta { total_seconds: a.total_seconds + b.total_seconds }; end
func td_sub: in(a: TimeDelta; b: TimeDelta) out TimeDelta { total_seconds: a.total_seconds - b.total_seconds }; end
func td_mul: in(d: TimeDelta; factor: float) out TimeDelta { total_seconds: d.total_seconds * factor }; end
func td_abs: in(d: TimeDelta) out TimeDelta { total_seconds: if d.total_seconds < 0.0: -d.total_seconds; else: d.total_seconds; end }; end

# ═══════════════════════════════════════════════════════
# Date (calendar date)
# ═══════════════════════════════════════════════════════

entity Date:
    year: int;
    month: int;
    day: int;
end

func date_new:
    in(year: int; month: int; day: int)
    out Date { year: year; month: month; day: day };
end

func is_leap_year:
    in(year: int)
    out (year % 4 == 0 and year % 100 != 0) or (year % 400 == 0);
end

func days_in_month:
    in(year: int; month: int)
    let table = [0; 31; 28; 31; 30; 31; 30; 31; 31; 30; 31; 30; 31];
    if month == 2 and is_leap_year(year):
        out 29;
    end
    out table[month];
end

func days_in_year:
    in(year: int)
    if is_leap_year(year): out 366; end
    out 365;
end

## Day of year (1-based)
func day_of_year:
    in(date: Date)
    let total = 0;
    let m = 1;
    while m < date.month:
        total = total + days_in_month(date.year; m);
        m = m + 1;
    end
    out total + date.day;
end

## Day of week: 0=Monday, 6=Sunday (Tomohiko Sakamoto's algorithm)
func weekday:
    in(date: Date)
    let t = [0; 3; 2; 5; 0; 3; 5; 1; 4; 6; 2; 4];
    let y = date.year;
    if date.month < 3: y = y - 1; end
    out (y + y / 4 - y / 100 + y / 400 + t[date.month - 1] + date.day) % 7;
end

func weekday_name:
    in(wd: int)
    let names = ["Sunday"; "Monday"; "Tuesday"; "Wednesday"; "Thursday"; "Friday"; "Saturday"];
    out names[wd];
end

## Convert to Unix timestamp days (from 1970-01-01)
func date_to_epoch_days:
    in(date: Date)
    # Days from year 1 to year (Rata Die approach simplified)
    let y = date.year - 1;
    let days = y * 365 + y / 4 - y / 100 + y / 400;
    let m = 1;
    while m < date.month:
        days = days + days_in_month(date.year; m);
        m = m + 1;
    end
    days = days + date.day;
    # Epoch offset: 1970-01-01 = 719163 rata die
    out days - 719163;
end

func date_from_epoch_days:
    in(epoch_days: int)
    let z = epoch_days + 719468;
    let era = z / 146097;
    let doe = z - era * 146097;
    let yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365;
    let y = yoe + era * 400;
    let doy = doe - (365 * yoe + yoe / 4 - yoe / 100);
    let mp = (5 * doy + 2) / 153;
    let d = doy - (153 * mp + 2) / 5 + 1;
    let m = if mp < 10: mp + 3; else: mp - 9; end;
    if m <= 2: y = y + 1; end
    out Date { year: y; month: m; day: d };
end

## Add days to a date
func date_add_days:
    in(date: Date; n: int)
    out date_from_epoch_days(date_to_epoch_days(date) + n);
end

func date_diff:
    in(a: Date; b: Date)
    out date_to_epoch_days(a) - date_to_epoch_days(b);
end

func date_format:
    in(date: Date)
    out str_fmt("{}-{}-{}";
        str_pad_left(str(date.year); "0"; 4);
        str_pad_left(str(date.month); "0"; 2);
        str_pad_left(str(date.day); "0"; 2));
end

# ═══════════════════════════════════════════════════════
# Time (wall-clock time)
# ═══════════════════════════════════════════════════════

entity Time:
    hour: int;
    minute: int;
    second: int;
    microsecond: int;
end

func time_new:
    in(hour: int; minute: int; second: int)
    out Time { hour: hour; minute: minute; second: second; microsecond: 0 };
end

func time_with_us:
    in(hour: int; minute: int; second: int; microsecond: int)
    out Time { hour: hour; minute: minute; second: second; microsecond: microsecond };
end

func time_format:
    in(t: Time)
    out str_fmt("{}:{}:{}";
        str_pad_left(str(t.hour); "0"; 2);
        str_pad_left(str(t.minute); "0"; 2);
        str_pad_left(str(t.second); "0"; 2));
end

func time_to_seconds:
    in(t: Time)
    out t.hour * 3600 + t.minute * 60 + t.second;
end

func time_from_seconds:
    in(total: int)
    let h = total / 3600;
    let m = (total % 3600) / 60;
    let s = total % 60;
    out Time { hour: h; minute: m; second: s; microsecond: 0 };
end

# ═══════════════════════════════════════════════════════
# DateTime (date + time combined)
# ═══════════════════════════════════════════════════════

entity DateTime:
    date: Date;
    time: Time;
    tz_offset_minutes: int;  # UTC offset in minutes; 0 = UTC
end

func datetime_new:
    in(year: int; month: int; day: int; hour: int; minute: int; second: int)
    out DateTime {
        date: date_new(year; month; day);
        time: time_new(hour; minute; second);
        tz_offset_minutes: 0;
    };
end

func datetime_with_tz:
    in(year: int; month: int; day: int; hour: int; minute: int; second: int; tz_offset: int)
    out DateTime {
        date: date_new(year; month; day);
        time: time_new(hour; minute; second);
        tz_offset_minutes: tz_offset;
    };
end

## Current UTC datetime from Unix timestamp
func datetime_now_utc:
    in()
    let ts = time_now();
    out datetime_from_timestamp(ts);
end

## From Unix timestamp (seconds since 1970-01-01 UTC)
func datetime_from_timestamp:
    in(ts: float)
    let epoch_days = int(math_floor(ts / 86400.0));
    let remainder = ts - float(epoch_days) * 86400.0;
    let date = date_from_epoch_days(epoch_days);
    let h = int(remainder / 3600.0);
    let m = int(math_mod(remainder; 3600.0) / 60.0);
    let s = int(math_mod(remainder; 60.0));
    let us = int((remainder - math_floor(remainder)) * 1000000.0);
    out DateTime {
        date: date;
        time: Time { hour: h; minute: m; second: s; microsecond: us };
        tz_offset_minutes: 0;
    };
end

## To Unix timestamp
func datetime_to_timestamp:
    in(dt: DateTime)
    let days = date_to_epoch_days(dt.date);
    let secs = time_to_seconds(dt.time);
    out float(days) * 86400.0 + float(secs) - float(dt.tz_offset_minutes) * 60.0;
end

## Add duration
func datetime_add:
    in(dt: DateTime; dur: TimeDelta)
    let ts = datetime_to_timestamp(dt) + dur.total_seconds;
    let result = datetime_from_timestamp(ts);
    result.tz_offset_minutes = dt.tz_offset_minutes;
    out result;
end

## Difference between two datetimes
func datetime_diff:
    in(a: DateTime; b: DateTime)
    out TimeDelta { total_seconds: datetime_to_timestamp(a) - datetime_to_timestamp(b) };
end

## ISO 8601 format
func datetime_format:
    in(dt: DateTime)
    let ds = date_format(dt.date);
    let ts = time_format(dt.time);
    if dt.tz_offset_minutes == 0:
        out str_fmt("{}T{}Z"; ds; ts);
    end
    let sign = if dt.tz_offset_minutes >= 0: "+"; else: "-"; end;
    let abs_off = if dt.tz_offset_minutes < 0: -dt.tz_offset_minutes; else: dt.tz_offset_minutes; end;
    let oh = abs_off / 60;
    let om = abs_off % 60;
    out str_fmt("{}T{}{}{}:{}"; ds; ts; sign;
        str_pad_left(str(oh); "0"; 2);
        str_pad_left(str(om); "0"; 2));
end

## Custom format with strftime-style directives
func datetime_strftime:
    in(dt: DateTime; fmt: str)
    let result = fmt;
    result = str_replace(result; "%Y"; str_pad_left(str(dt.date.year); "0"; 4));
    result = str_replace(result; "%m"; str_pad_left(str(dt.date.month); "0"; 2));
    result = str_replace(result; "%d"; str_pad_left(str(dt.date.day); "0"; 2));
    result = str_replace(result; "%H"; str_pad_left(str(dt.time.hour); "0"; 2));
    result = str_replace(result; "%M"; str_pad_left(str(dt.time.minute); "0"; 2));
    result = str_replace(result; "%S"; str_pad_left(str(dt.time.second); "0"; 2));
    result = str_replace(result; "%A"; weekday_name(weekday(dt.date)));
    result = str_replace(result; "%j"; str_pad_left(str(day_of_year(dt.date)); "0"; 3));
    out result;
end

## Parse ISO 8601 (basic: "2024-01-15T10:30:00Z")
func datetime_parse_iso:
    in(s: str)
    # Expect: YYYY-MM-DDTHH:MM:SS[Z|+HH:MM|-HH:MM]
    if str_len(s) < 19: out None; end
    let year  = str_to_int(str_substr(s; 0; 4));
    let month = str_to_int(str_substr(s; 5; 7));
    let day   = str_to_int(str_substr(s; 8; 10));
    let hour  = str_to_int(str_substr(s; 11; 13));
    let min   = str_to_int(str_substr(s; 14; 16));
    let sec   = str_to_int(str_substr(s; 17; 19));
    let tz_off = 0;
    if str_len(s) > 19:
        let tz = str_substr(s; 19; str_len(s));
        if tz == "Z":
            tz_off = 0;
        elif str_len(tz) >= 6:
            let sign = if str_substr(tz; 0; 1) == "+": 1; else: -1; end;
            let th = str_to_int(str_substr(tz; 1; 3));
            let tm = str_to_int(str_substr(tz; 4; 6));
            tz_off = sign * (th * 60 + tm);
        end
    end
    out Some(DateTime {
        date: date_new(year; month; day);
        time: time_new(hour; min; sec);
        tz_offset_minutes: tz_off;
    });
end

# ═══════════════════════════════════════════════════════
# Comparison
# ═══════════════════════════════════════════════════════

func date_eq:  in(a: Date; b: Date) out a.year == b.year and a.month == b.month and a.day == b.day; end
func date_lt:  in(a: Date; b: Date) out date_to_epoch_days(a) < date_to_epoch_days(b); end
func date_lte: in(a: Date; b: Date) out date_to_epoch_days(a) <= date_to_epoch_days(b); end

func datetime_eq:   in(a: DateTime; b: DateTime) out datetime_to_timestamp(a) == datetime_to_timestamp(b); end
func datetime_lt:   in(a: DateTime; b: DateTime) out datetime_to_timestamp(a) < datetime_to_timestamp(b); end
func datetime_lte:  in(a: DateTime; b: DateTime) out datetime_to_timestamp(a) <= datetime_to_timestamp(b); end
