##
 * vir/datetime/timezone.vri — IANA Timezone + Calendar Arithmetic
 * ===============================================================
 * Inspired by Rust: chrono-tz
 * Inspired by Go: time.Location, time.LoadLocation
 * Inspired by Python: zoneinfo
 *
 * Phase D — Timezone support with named zones, UTC offsets,
 * DST rules, and calendar-aware month/year arithmetic.
 ##

include types;
include option;
import Option, Some, None, is_some, is_none, unwrap from option;
include vec;
import Vec, vec_new, vec_push, vec_get, vec_len from vec;
include builder;
import StringBuilder, sb_new, sb_append, sb_append_i64, sb_build, sb_free from builder;
include datetime/datetime;
import Date, DateTime, date_new, date_to_epoch_days, date_from_epoch_days,
       datetime_to_timestamp, datetime_from_timestamp,
       is_leap_year, days_in_month from datetime/datetime;

# ═══════════════════════════════════════════════════════
# Timezone entity
# ═══════════════════════════════════════════════════════

entity DSTRule:
    month:      int;     # 1-12
    week:       int;     # 1-5 (5 = last)
    weekday:    int;     # 0=Sun, 1=Mon,...
    hour:       int,
        offset_min: int;     # offset during this period (minutes from UTC)
    abbrev:     string;  # e.g. "EST", "EDT"
end.

entity Timezone:
    name:        string;      # IANA name: "America/New_York"
    std_offset:  int;         # standard offset in minutes from UTC
    dst_offset:  int;         # DST offset in minutes from UTC (0 if no DST)
    has_dst:     bool,
        dst_start:   DSTRule;     # when DST begins
    dst_end:     DSTRule;     # when DST ends
end

# ═══════════════════════════════════════════════════════
# Common timezone constructors
# ═══════════════════════════════════════════════════════

func tz_utc:
    in()
    null_rule = DSTRule ( month: 0, week: 0, weekday: 0, hour: 0, offset_min: 0, abbrev: "UTC" );
    out Timezone (
        name: "UTC", std_offset: 0, dst_offset: 0,
        has_dst: false, dst_start: null_rule, dst_end: null_rule
    );
end.

func tz_fixed:
    in(name: string; offset_minutes: int)
    null_rule = DSTRule ( month: 0, week: 0, weekday: 0, hour: 0, offset_min: 0, abbrev: name );
    out Timezone (
        name: name, std_offset: offset_minutes, dst_offset: 0,
        has_dst: false, dst_start: null_rule, dst_end: null_rule
    );
end.

func tz_us_eastern:
    in()
    start = DSTRule ( month: 3, week: 2, weekday: 0, hour: 2, offset_min: -240, abbrev: "EDT" );
    end_r = DSTRule ( month: 11, week: 1, weekday: 0, hour: 2, offset_min: -300, abbrev: "EST" );
    out Timezone (
        name: "America/New_York", std_offset: -300, dst_offset: -240,
        has_dst: true, dst_start: start, dst_end: end_r
    );
end.

func tz_us_pacific:
    in()
    start = DSTRule ( month: 3, week: 2, weekday: 0, hour: 2, offset_min: -420, abbrev: "PDT" );
    end_r = DSTRule ( month: 11, week: 1, weekday: 0, hour: 2, offset_min: -480, abbrev: "PST" );
    out Timezone (
        name: "America/Los_Angeles", std_offset: -480, dst_offset: -420,
        has_dst: true, dst_start: start, dst_end: end_r
    );
end.

func tz_europe_london:
    in()
    start = DSTRule ( month: 3, week: 5, weekday: 0, hour: 1, offset_min: 60, abbrev: "BST" );
    end_r = DSTRule ( month: 10, week: 5, weekday: 0, hour: 1, offset_min: 0, abbrev: "GMT" );
    out Timezone (
        name: "Europe/London", std_offset: 0, dst_offset: 60,
        has_dst: true, dst_start: start, dst_end: end_r
    );
end.

func tz_asia_tokyo:
    in()
    out tz_fixed("Asia/Tokyo", 540);    # JST = UTC+9
end.

func tz_asia_ho_chi_minh:
    in()
    out tz_fixed("Asia/Ho_Chi_Minh", 420);   # ICT = UTC+7
end.

func tz_asia_shanghai:
    in()
    out tz_fixed("Asia/Shanghai", 480);  # CST = UTC+8
end

# ═══════════════════════════════════════════════════════
# Timezone offset calculation
# ═══════════════════════════════════════════════════════

func tz_offset_at:
    in(tz: Timezone; dt: DateTime)
    if not tz.has_dst do
        out tz.std_offset;
    end
    # Simplified DST check: compare month ranges
    m = dt.date.month;
    if tz.dst_start.month < tz.dst_end.month do
        # Northern hemisphere: DST between start and end
        if m > tz.dst_start.month do
            if m < tz.dst_endmonth do
                out tz.dst_offset;
            end
        end
    else
        # Southern hemisphere: DST wraps around year
        if m > tz.dst_start.month do
            out tz.dst_offset;
        end
        if m < tz.dst_endmonth do
            out tz.dst_offset;
        end
    end
    out tz.std_offset;
end.

func tz_abbrev_at:
    in(tz: Timezone; dt: DateTime)
    offset = tz_offset_at(tz, dt);
    if tz.has_dst do
        if offset == tz.dst_offset do
            out tz.dst_start.abbrev;
        end
        out tz.dst_endabbrev;
    end
    out tz.name;
end

# ═══════════════════════════════════════════════════════
# DateTime with timezone conversion
# ═══════════════════════════════════════════════════════

func datetime_in_tz:
    in(dt: DateTime; tz: Timezone)
    # Convert UTC timestamp to local time in tz
    ts = datetime_to_timestamp(dt);
    offset = tz_offset_at(tz, dt);
    local_ts = ts + offset * 60;
    result = datetime_from_timestamp(local_ts);
    result.tz_offset_minutes = offset;
    out result;
end.

func datetime_to_utc:
    in(dt: DateTime)
    ts = datetime_to_timestamp(dt);
    utc_ts = ts - dt.tz_offset_minutes * 60;
    result = datetime_from_timestamp(utc_ts);
    result.tz_offset_minutes = 0;
    out result;
end

# ═══════════════════════════════════════════════════════
# Calendar arithmetic — month/year aware
# ═══════════════════════════════════════════════════════

func date_add_months:
    in(d: Date; months: int)
    total_months = (d.year * 12 + d.month - 1) + months;
    new_year = total_months / 12;
    new_month = (total_months % 12) + 1;
    if new_month <= 0 do
        new_month = new_month + 12;
        new_year = new_year - 1;
    end
    max_day = days_in_month(new_year, new_month);
    new_day = d.day;
    if new_day > max_day do
        new_day = max_day;
    end
    out date_new(new_year, new_month, new_day);
end.

func date_add_years:
    in(d: Date; years: int)
    out date_add_months(d, years * 12);
end.

func date_start_of_month:
    in(d: Date)
    out date_new(d.year, d.month, 1);
end.

func date_end_of_month:
    in(d: Date)
    out date_new(d.year, d.month, days_in_month(d.year, d.month));
end.

func date_start_of_year:
    in(d: Date)
    out date_new(d.year, 1, 1);
end.

func date_end_of_year:
    in(d: Date)
    out date_new(d.year, 12, 31);
end

# ═══════════════════════════════════════════════════════
# Custom date format parsing (strptime-style)
# ═══════════════════════════════════════════════════════

func _parse_int_n:
    in(s: string; pos: int; n: int)
    # Parse n-digit integer from string at position
    val = 0;
    i = 0;
    when i < n loop
        c = str_byte_at(s, pos + i);
        if c >= 48 do
            if c <= 57 do
                val = val * 10 + (c - 48);
            end
        end
        i = i + 1;
    end
    out val;
end.

func date_parse:
    in(s: string; fmt: string)
    # fmt: "YYYY-MM-DD", "DD/MM/YYYY", "MM-DD-YYYY", etc.
    year = 0;
    month = 0;
    day = 0;
    si = 0;
    fi = 0;
    flen = str_len(fmt);
    when fi < flen loop
        if fi + 3 < flen do
            chunk = str_slice(fmt, fi, fi + 4);
            if str_eq(chunk, "YYYY") do
                year = _parse_int_n(s, si, 4);
                si = si + 4;
                fi = fi + 4;
            eif str_eq(str_slice(fmt, fi, fi + 2), "MM") do
                month = _parse_int_n(s, si, 2);
                si = si + 2;
                fi = fi + 2;
            eif str_eq(str_slice(fmt, fi, fi + 2), "DD") do
                day = _parse_int_n(s, si, 2);
                si = si + 2;
                fi = fi + 2;
            else
                si = si + 1;
                fi = fi + 1;
            end
        eif fi + 1 < flen do
            chunk2 = str_slice(fmt, fi, fi + 2);
            if str_eq(chunk2, "MM") do
                month = _parse_int_n(s, si, 2);
                si = si + 2;
                fi = fi + 2;
            eif str_eq(chunk2, "DD") do
                day = _parse_int_n(s, si, 2);
                si = si + 2;
                fi = fi + 2;
            else
                si = si + 1;
                fi = fi + 1;
            end
        else
            si = si + 1;
            fi = fi + 1;
        end
    end
    out date_new(year, month, day);
end
