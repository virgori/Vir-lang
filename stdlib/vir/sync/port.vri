##
 * vir/sync/port.vri — MPSC Signal Coordination Port (Pure Vir)
 * ==============================================================
 * Spec §23: Typed signal passing between asynchronous workers.
 *
 * Multi-Producer Single-Consumer (MPSC) Ring Buffer Channel.
 * Features:
 *   - Non-blocking lock-free send
 *   - Cooperative recv polling / wait
 *   - Configurable bounded capacity (backpressure)
 *   - Timeout handling
 ##

include types
include ring_buffer
import RingBuffer, rb_new, rb_push, rb_pop, rb_is_empty, rb_is_full, rb_count, rb_free from ring_buffer

# ═══════════════════════════════════════════════════════
# Port Structure
# ═══════════════════════════════════════════════════════

entity Port:
    buf:        RingBuffer,
    cap:        int,
    is_closed:  bool,
    send_count: int,
    recv_count: int
end.

# ═══════════════════════════════════════════════════════
# Port Operations
# ═══════════════════════════════════════════════════════

func port_new(capacity: int):
    var actual_cap = capacity
    if actual_cap <= 0 do
        actual_cap = 64
    end
    out Port (
        buf = rb_new(actual_cap),
        cap = actual_cap,
        is_closed = false,
        send_count = 0,
        recv_count = 0
    )
end.

# Non-blocking send: returns true on success, false if full or closed
func port_send(p: Port, msg: int):
    if p.is_closed do
        out false
    end
    var ok = rb_push(p.buf, msg)
    if ok do
        p.send_count = p.send_count + 1
    end
    out ok
end.

# Cooperative receive: pops a message, returns (msg, ok)
func port_recv(p: Port):
    if rb_is_empty(p.buf) do
        out (0, false)
    end
    var msg = rb_pop(p.buf)
    p.recv_count = p.recv_count + 1
    out (msg, true)
end.

# Try receive without blocking
func port_try_recv(p: Port):
    out port_recv(p)
end.

# Number of messages currently buffered
func port_count(p: Port):
    out rb_count(p.buf)
end.

# Close the port
func port_close(p: Port):
    p.is_closed = true
end.

# Free port resources
func port_free(p: Port):
    rb_free(p.buf)
end.

export Port, port_new, port_send, port_recv, port_try_recv, port_count, port_close, port_free
