/*
 * vir/reflect/reflect.vri — Runtime Reflection
 * ===============================================
 * Phase D — type introspection at runtime
 *
 * Inspired by Python: inspect, typing
 * Dùng cho: serialization, debug printing, IDE tooling
 */

import "vir/core/types" use all
import "vir/core/option" use Option, Some, None
import "vir/str/string" use String, str_new
import "vir/collections/vec" use Vec, vec_new, vec_push, vec_len, vec_get

# ═══════════════════════════════════════════════════════
# Type Info
# ═══════════════════════════════════════════════════════

enum TypeKind
    Primitive  = 1
    Struct     = 2
    Enum       = 3
    Array      = 4
    Slice      = 5
    Pointer    = 6
    Function   = 7
    Generic    = 8
end

entity TypeInfo
    name:      String
    kind:      TypeKind
    size:      usize
    align:     usize
    fields:    Vec<FieldInfo>
    variants:  Vec<VariantInfo>
    elem_type: Option<ptr>    # for arrays/slices/pointers -> TypeInfo*
end

entity FieldInfo
    name:    String
    offset:  usize
    type_id: u64
end

entity VariantInfo
    name:          String
    discriminant:  i64
    field_count:   usize
end

# ═══════════════════════════════════════════════════════
# Runtime Type Registry
# ═══════════════════════════════════════════════════════

func ngoài native_type_registry_lookup(type_id: u64) -> ptr    # -> TypeInfo*
func ngoài native_type_registry_register(info: ptr) -> u64
func ngoài native_type_id_of(val: ptr) -> u64
func ngoài native_type_name_of(val: ptr, buf: ptr, buf_len: usize) -> i32

func type_of<T>(val: &T) -> Option<TypeInfo>
    var id = native_type_id_of(val)
    var info_ptr = native_type_registry_lookup(id)
    if info_ptr == ptr_null() out None end
    # Deserialize native TypeInfo (simplified)
    out Some(_read_type_info(info_ptr))
end

func type_name<T>(val: &T) -> String
    var buf: [u8; 256]
    var n = native_type_name_of(val, &buf, 256)
    if n > 0 out str_from_bytes(&buf, n) end
    out str_new("<unknown>")
end

func type_size<T>() -> usize
    out size_of<T>()
end

func type_align<T>() -> usize
    out align_of<T>()
end

func _read_type_info(p: ptr) -> TypeInfo
    # Native bridge reads from registered type info
    out TypeInfo {
        name = str_new("<pending>"),
        kind = TypeKind.Primitive,
        size = 0, align = 0,
        fields = vec_new<FieldInfo>(),
        variants = vec_new<VariantInfo>(),
        elem_type = None
    }
end

# ═══════════════════════════════════════════════════════
# Field Access (dynamic)
# ═══════════════════════════════════════════════════════

func field_count(info: TypeInfo) -> usize
    out vec_len<FieldInfo>(info.fields)
end

func field_by_name(info: TypeInfo, name: String) -> Option<FieldInfo>
    var i: usize = 0
    lặp_khi i < vec_len<FieldInfo>(info.fields)
        var f = vec_get<FieldInfo>(info.fields, i)
        if str_eq(f.name, name) out Some(f) end
        i = i + 1
    end
    out None
end

func field_by_index(info: TypeInfo, idx: usize) -> Option<FieldInfo>
    if idx >= vec_len<FieldInfo>(info.fields) out None end
    out Some(vec_get<FieldInfo>(info.fields, idx))
end

# ═══════════════════════════════════════════════════════
# Enum Introspection
# ═══════════════════════════════════════════════════════

func variant_count(info: TypeInfo) -> usize
    out vec_len<VariantInfo>(info.variants)
end

func variant_by_name(info: TypeInfo, name: String) -> Option<VariantInfo>
    var i: usize = 0
    lặp_khi i < vec_len<VariantInfo>(info.variants)
        var v = vec_get<VariantInfo>(info.variants, i)
        if str_eq(v.name, name) out Some(v) end
        i = i + 1
    end
    out None
end
