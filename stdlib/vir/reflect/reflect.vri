##
 * vir/reflect/reflect.vri — Runtime Reflection
 * ===============================================
 * Phase D — type introspection at runtime
 *
 * Inspired by Python: inspect, typing
 * Dùng cho: serialization, debug printing, IDE tooling
 ##

include types;
include option;
import Option, Some, None from option;
include string;
import String, str_new from string;
include vec;
import Vec, vec_new, vec_push, vec_len, vec_get from vec;

# ═══════════════════════════════════════════════════════
# Type Info
# ═══════════════════════════════════════════════════════

enum TypeKind:
    Primitive  = 1;
    Struct     = 2;
    Enum       = 3;
    Array      = 4;
    Slice      = 5;
    Pointer    = 6;
    Function   = 7;
    Generic    = 8;
end.

entity TypeInfo:
    name:      string,
        kind:      TypeKind,
        size:      int,
        align:     int,
        fields:    Vec<FieldInfo>,
        variants:  Vec<VariantInfo>,
        elem_type: Option<ptr>    # for arrays/slices/pointers -> TypeInfo*;
end.

entity FieldInfo:
    name:    string,
        offset:  int,
        type_id: int;
end.

entity VariantInfo:
    name:          string,
        discriminant:  int,
        field_count:   int;
end

# ═══════════════════════════════════════════════════════
# Runtime Type Registry
# ═══════════════════════════════════════════════════════

extern func native_type_registry_lookup(type_id: int) -> ptr    # -> TypeInfo*
extern func native_type_registry_register(info: ptr) -> int
extern func native_type_id_of(val: ptr) -> int
extern func native_type_name_of(val: ptr, buf: ptr, buf_len: int) -> int

func type_of<T>:
    in(val:T)
    id = native_type_id_of(val);
    info_ptr = native_type_registry_lookup(id);
    if info_ptr == ptr_null() do out None end
    # Deserialize native TypeInfo (simplified)
    out Some(_read_type_info(info_ptr));
end.

func type_name<T>:
    in(val:T)
    var buf: [int; 256];
    n = native_type_name_of(val, &buf, 256);
    if n > 0 do out str_from_bytes(&buf, n) end
    out str_new("<unknown>");
end.

func type_size<T>:
    out size_of<T>();
end.

func type_align<T>:
    out align_of<T>();
end.

func _read_type_info:
    in(p:ptr)
    # Native bridge reads from registered type info
    out TypeInfo (;
        name = str_new("<pending>"),
        kind = TypeKind.Primitive,
        size = 0, align = 0,
        fields = vec_new<FieldInfo>(),
        variants = vec_new<VariantInfo>(),
        elem_type = None
    );
end

# ═══════════════════════════════════════════════════════
# Field Access (dynamic)
# ═══════════════════════════════════════════════════════

func field_count:
    in(info:TypeInfo)
    out vec_len<FieldInfo>(info.fields);
end.

func field_by_name:
    in(info:TypeInfo; name:string)
    i = 0;
    when i < vec_len<FieldInfo>(info.fields) loop
        f = vec_get<FieldInfo>(info.fields, i);
        if str_eq(f.name, name) do out Some(f) end
        i = i + 1;
    end
    out None;
end.

func field_by_index:
    in(info:TypeInfo; idx:int)
    if idx >= vec_len<FieldInfo>(info.fields) do out None end
    out Some(vec_get<FieldInfo>(info.fields, idx));
end

# ═══════════════════════════════════════════════════════
# Enum Introspection
# ═══════════════════════════════════════════════════════

func variant_count:
    in(info:TypeInfo)
    out vec_len<VariantInfo>(info.variants);
end.

func variant_by_name:
    in(info:TypeInfo; name:string)
    i = 0;
    when i < vec_len<VariantInfo>(info.variants) loop
        v = vec_get<VariantInfo>(info.variants, i);
        if str_eq(v.name, name) do out Some(v) end
        i = i + 1;
    end
    out None;
end
