##
 * vir/vss/resolver.vri — VSS Theme & Mixin Resolution
 * =====================================================
 * Transforms a parsed VSSStylesheet by
 *   1. Resolving all VSSThemeRef values to concrete VSSLiteral values
 *   2. Expanding mixin applications into inline declarations
 ##

include types;
include string;
import String, str_new, str_eq from string;
include vec;
import Vec, vec_new, vec_push, vec_len, vec_get from vec;
include map;
import Map, map_new, map_set, map_get, map_has from map;
include vss/ast;
import VSSValueKind, VSSValue from vss/ast;
import vss_literal, vss_func_call, vss_value_list from vss/ast;
import VSSDeclaration, vss_decl_new from vss/ast;
import VSSNestedRule, vss_nested_rule_new from vss/ast;
import VSSTheme from vss/ast;
import VSSMixin from vss/ast;
import VSSKeyframes, VSSKeyframeStep, vss_keyframes_new, vss_kf_step_new from vss/ast;
import VSSStyleBlock, vss_style_block_new from vss/ast;
import VSSStylesheet, vss_stylesheet_new from vss/ast;


# ═══════════════════════════════════════════════════════
# Resolver State
# ═══════════════════════════════════════════════════════

entity VSSResolver:
    themes:         Map<string, Map<string, VSSValue>>,
        mixins:         Map<string, VSSMixin>,
        default_theme:  string;
end
func vss_resolver_new:
    out VSSResolver (
        themes:         map_new<string, Map<string, VSSValue>>(),
        mixins:         map_new<string, VSSMixin>(),
        default_theme:  ""
    );
end
# ═══════════════════════════════════════════════════════
# Main resolve function
# ═══════════════════════════════════════════════════════

func vss_resolve:
    in(sheet: VSSStylesheet) -> VSSStylesheet
    r = vss_resolver_new();

    # Index themes
    i = 0;
    when i < vec_len(sheet.themes) loop
        theme = vec_get(sheet.themes, i);
        tmap = map_new<string, VSSValue>();
        j = 0;
        when j < vec_len(theme.variables) loop
            d = vec_get(theme.variables, j);
            map_set(tmap, d.property, d.value);
            j = j + 1;
        end
        map_set(r.themes, theme.name, tmap);
        if str_eq(r.default_theme, "") do
            r.default_theme = theme.name;
        end
        i = i + 1;
    end

    # Index mixins
    i = 0;
    when i < vec_len(sheet.mixins) loop
        mix = vec_get(sheet.mixins, i);
        map_set(r.mixins, mix.name, mix);
        i = i + 1;
    end

    # Resolve style blocks
    resolved_styles = vec_new<VSSStyleBlock>();
    i = 0;
    when i < vec_len(sheet.styles) loop
        s = vec_get(sheet.styles, i);
        rs = _resolve_style(r, s);
        vec_push(resolved_styles, rs);
        i = i + 1;
    end

    # Resolve keyframes
    resolved_kf = vec_new<VSSKeyframes>();
    i = 0;
    when i < vec_len(sheet.keyframes) loop
        kf = vec_get(sheet.keyframes, i);
        rkf = _resolve_keyframes(r, kf);
        vec_push(resolved_kf, rkf);
        i = i + 1;
    end

    result = vss_stylesheet_new();
    result.themes = sheet.themes;
    result.styles = resolved_styles;
    result.mixins = sheet.mixins;
    result.keyframes = resolved_kf;
    result.imports = sheet.imports;
    out result;
end
# ═══════════════════════════════════════════════════════
# Style block resolution
# ═══════════════════════════════════════════════════════

func _resolve_style:
    in(r: VSSResolver; style: VSSStyleBlock) -> VSSStyleBlock
    result = vss_style_block_new(style.name);

    # Expand mixins first
    i = 0;
    when i < vec_len(style.mixins_applied) loop
        mname = vec_get(style.mixins_applied, i);
        if map_has(r.mixins, mname) do
            mix = map_get(r.mixins, mname);
            j = 0;
            when j < vec_len(mix.declarations) loop
                d = vec_get(mix.declarations, j);
                rd = _resolve_decl(r, d);
                vec_push(result.declarations, rd);
                j = j + 1;
            end
        end
        i = i + 1;
    end

    # Resolve own declarations
    i = 0;
    when i < vec_len(style.declarations) loop
        d = vec_get(style.declarations, i);
        rd = _resolve_decl(r, d);
        vec_push(result.declarations, rd);
        i = i + 1;
    end

    # Resolve nested rules
    i = 0;
    when i < vec_len(style.nested_rules) loop
        n = vec_get(style.nested_rules, i);
        rn = _resolve_nested(r, n);
        vec_push(result.nested_rules, rn);
        i = i + 1;
    end

    out result;
end
func _resolve_nested:
    in(r: VSSResolver; rule: VSSNestedRule) -> VSSNestedRule
    result = vss_nested_rule_new(rule.selector);
    result.has_condition = rule.has_condition;
    result.condition = rule.condition;

    i = 0;
    when i < vec_len(rule.declarations) loop
        d = vec_get(rule.declarations, i);
        vec_push(result.declarations, _resolve_decl(r, d));
        i = i + 1;
    end

    i = 0;
    when i < vec_len(rule.nested_rules) loop
        n = vec_get(rule.nested_rules, i);
        vec_push(result.nested_rules, _resolve_nested(r, n));
        i = i + 1;
    end

    out result;
end
func _resolve_decl:
    in(r: VSSResolver; decl: VSSDeclaration) -> VSSDeclaration
    rv = _resolve_value(r, decl.value);
    out vss_decl_new(decl.property, rv, decl.important);
end
func _resolve_keyframes:
    in(r: VSSResolver; kf: VSSKeyframes) -> VSSKeyframes
    result = vss_keyframes_new(kf.name);

    i = 0;
    when i < vec_len(kf.steps) loop
        step = vec_get(kf.steps, i);
        rstep = vss_kf_step_new(step.step_name);
        j = 0;
        when j < vec_len(step.declarations) loop
            d = vec_get(step.declarations, j);
            vec_push(rstep.declarations, _resolve_decl(r, d));
            j = j + 1;
        end
        vec_push(result.steps, rstep);
        i = i + 1;
    end

    out result;
end
# ═══════════════════════════════════════════════════════
# Value resolution
# ═══════════════════════════════════════════════════════

func _resolve_value:
    in(r: VSSResolver; val: VSSValue) -> VSSValue

    if val.kind == VSSValueKind::ThemeRef do
        out _resolve_theme_ref(r, val);
    end

    if val.kind == VSSValueKind::FuncCall do
        resolved_args = vec_new<VSSValue>();
        i = 0;
        when i < vec_len(val.args) loop
            a = vec_get(val.args, i);
            vec_push(resolved_args, _resolve_value(r, a));
            i = i + 1;
        end
        out vss_func_call(val.func_name, resolved_args);
    end

    if val.kind == VSSValueKind::ValueList do
        resolved_items = vec_new<VSSValue>();
        i = 0;
        when i < vec_len(val.items) loop
            v = vec_get(val.items, i);
            vec_push(resolved_items, _resolve_value(r, v));
            i = i + 1;
        end
        out vss_value_list(resolved_items);
    end

    # Literal — no resolution needed
    out val;
end
func _resolve_theme_ref:
    in(r: VSSResolver; ref: VSSValue) -> VSSValue
    tname = ref.theme_name;
    if str_eq(tname, "") do
        tname = r.default_theme;
    end
    if str_eq(tname, "") do
        # No theme defined — return as-is
        out ref;
    end

    # Try exact theme name
    if map_has(r.themes, tname) do
        tmap = map_get(r.themes, tname);
        if map_has(tmap, ref.var_name) do
            out map_get(tmap, ref.var_name);
        end
    end

    # Try as variable in default theme (theme_name used as var_name)
    if map_has(r.themes, r.default_theme) do
        tmap = map_get(r.themes, r.default_theme);
        if map_has(tmap, tname) do
            out map_get(tmap, tname);
        end
    end

    # Unresolved — return literal of var name
    out vss_literal(ref.var_name);
end
export VSSResolver, vss_resolver_new, vss_resolve;
