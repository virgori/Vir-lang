##
 * vir/vss/ast.vri — VSS AST Node Definitions
 * =============================================
 * Immutable AST nodes representing parsed `.vss` files.
 * Separate value types (literal, theme ref, func call, expression).
 * Recursive nesting for selectors and media queries.
 ##

include types
include string
import String, str_new from string
include vec
import Vec, vec_new, vec_push from vec


# ═══════════════════════════════════════════════════════
# VSS Value Types
# ═══════════════════════════════════════════════════════

enum VSSValueKind:
    Literal     = 1
    ThemeRef    = 2
    FuncCall    = 3
    Expr        = 4
    ValueList   = 5
end.
entity VSSValue:
    kind:       VSSValueKind
    # Literal fields
    raw:        string
    # ThemeRef fields
    theme_name: string,
        var_name:   string
    # FuncCall fields
    func_name:  string,
        args:       Vec of (VSSValue)
    # Expr fields
    expr_op:    string,
        left_idx:   int,
        right_idx:  int
    # ValueList fields
    items:      Vec of (VSSValue)
end.
func vss_literal(raw: string):
    out VSSValue (
        kind:       VSSValueKind.Literal,
        raw:        raw,
        theme_name: "",
        var_name:   "",
        func_name:  "",
        args:       vec_new of (VSSValue)(),
        expr_op:    "",
        left_idx:   0,
        right_idx:  0,
        items:      vec_new of (VSSValue)()
    )
end.
func vss_theme_ref(tname: string, vname: string):
    out VSSValue (
        kind:       VSSValueKind.ThemeRef,
        raw:        "",
        theme_name: tname,
        var_name:   vname,
        func_name:  "",
        args:       vec_new of (VSSValue)(),
        expr_op:    "",
        left_idx:   0,
        right_idx:  0,
        items:      vec_new of (VSSValue)()
    )
end.
func vss_func_call(fname: string, fargs: Vec of (VSSValue)):
    out VSSValue (
        kind:       VSSValueKind.FuncCall,
        raw:        "",
        theme_name: "",
        var_name:   "",
        func_name:  fname,
        args:       fargs,
        expr_op:    "",
        left_idx:   0,
        right_idx:  0,
        items:      vec_new of (VSSValue)()
    )
end.
func vss_expr:
    in  op: string
        l: int
        r: int
    out VSSValue (
        kind:       VSSValueKind.Expr,
        raw:        "",
        theme_name: "",
        var_name:   "",
        func_name:  "",
        args:       vec_new of (VSSValue)(),
        expr_op:    op,
        left_idx:   l,
        right_idx:  r,
        items:      vec_new of (VSSValue)()
    )
end.
func vss_value_list(vals: Vec of (VSSValue)):
    out VSSValue (
        kind:       VSSValueKind.ValueList,
        raw:        "",
        theme_name: "",
        var_name:   "",
        func_name:  "",
        args:       vec_new of (VSSValue)(),
        expr_op:    "",
        left_idx:   0,
        right_idx:  0,
        items:      vals
    )
end.
# ═══════════════════════════════════════════════════════
# VSS Condition — for `when` blocks (responsive)
# ═══════════════════════════════════════════════════════

entity VSSCondition:
    property:   string,
        operator:   string,
        value:      VSSValue
end.
func vss_condition_new:
    in  prop: string
        op: string
        val: VSSValue
    out VSSCondition ( property: prop, operator: op, value: val )
end.
# ═══════════════════════════════════════════════════════
# VSS Declaration
# ═══════════════════════════════════════════════════════

entity VSSDeclaration:
    property:   string,
        value:      VSSValue,
        important:  int
end.
func vss_decl_new:
    in  prop: string
        val: VSSValue
        imp: int
    out VSSDeclaration ( property: prop, value: val, important: imp )
end.
# ═══════════════════════════════════════════════════════
# VSS Nested Rule
# ═══════════════════════════════════════════════════════

entity VSSNestedRule:
    selector:       string,
        has_condition:  int,
        condition:      VSSCondition,
        declarations:   Vec of (VSSDeclaration),
        nested_rules:   Vec of (VSSNestedRule)
end.
func vss_nested_rule_new(sel: string):
    out VSSNestedRule (
        selector:       sel,
        has_condition:  0,
        condition:      vss_condition_new("", "", vss_literal("")),
        declarations:   vec_new of (VSSDeclaration)(),
        nested_rules:   vec_new of (VSSNestedRule)()
    )
end.
# ═══════════════════════════════════════════════════════
# Top-level VSS Constructs
# ═══════════════════════════════════════════════════════

## Theme definition: theme Light: ... end ##
entity VSSTheme:
    name:       string,
        variables:  Vec of (VSSDeclaration)
end.
func vss_theme_new(name: string):
    out VSSTheme ( name: name, variables: vec_new of (VSSDeclaration)() )
end.
## Reusable style fragment: mixin rounded(radius): ... end ##
entity VSSMixin:
    name:       string,
        params:     Vec of (VSSDeclaration),
        declarations: Vec of (VSSDeclaration)
end.
func vss_mixin_new(name: string):
    out VSSMixin (
        name:           name,
        params:         vec_new of (VSSDeclaration)(),
        declarations:   vec_new of (VSSDeclaration)()
    )
end.
## Keyframe step: (step_name, declarations) ##
entity VSSKeyframeStep:
    step_name:      string,
        declarations:   Vec of (VSSDeclaration)
end.
func vss_kf_step_new(name: string):
    out VSSKeyframeStep ( step_name: name, declarations: vec_new of (VSSDeclaration)() )
end.
## Keyframes: @keyframes name { ... } ##
entity VSSKeyframes:
    name:   string,
        steps:  Vec of (VSSKeyframeStep)
end.
func vss_keyframes_new(name: string):
    out VSSKeyframes ( name: name, steps: vec_new of (VSSKeyframeStep)() )
end.
## Style block: style card: ... end ##
entity VSSStyleBlock:
    name:               string,
        declarations:       Vec of (VSSDeclaration),
        nested_rules:       Vec of (VSSNestedRule),
        mixins_applied:     Vec of (string)
end.
func vss_style_block_new(name: string):
    out VSSStyleBlock (
        name:               name,
        declarations:       vec_new of (VSSDeclaration)(),
        nested_rules:       vec_new of (VSSNestedRule)(),
        mixins_applied:     vec_new of (string)()
    )
end.
## Full stylesheet ##
entity VSSStylesheet:
    themes:     Vec of (VSSTheme),
        styles:     Vec of (VSSStyleBlock),
        mixins:     Vec of (VSSMixin),
        keyframes:  Vec of (VSSKeyframes),
        imports:    Vec of (string)
end.
func vss_stylesheet_new:
    out VSSStylesheet (
        themes:     vec_new of (VSSTheme)(),
        styles:     vec_new of (VSSStyleBlock)(),
        mixins:     vec_new of (VSSMixin)(),
        keyframes:  vec_new of (VSSKeyframes)(),
        imports:    vec_new of (string)()
    )
end.
export VSSValueKind, VSSValue
export vss_literal, vss_theme_ref, vss_func_call, vss_expr, vss_value_list
export VSSCondition, vss_condition_new
export VSSDeclaration, vss_decl_new
export VSSNestedRule, vss_nested_rule_new
export VSSTheme, vss_theme_new
export VSSMixin, vss_mixin_new
export VSSKeyframeStep, vss_kf_step_new
export VSSKeyframes, vss_keyframes_new
export VSSStyleBlock, vss_style_block_new
export VSSStylesheet, vss_stylesheet_new
