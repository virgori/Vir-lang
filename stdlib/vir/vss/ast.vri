##
 * vir/vss/ast.vri — VSS AST Node Definitions
 * =============================================
 * Immutable AST nodes representing parsed `.vss` files.
 * Separate value types (literal, theme ref, func call, expression).
 * Recursive nesting for selectors and media queries.
 ##

include types;
include string;
import String, str_new from string;
include vec;
import Vec, vec_new, vec_push from vec;


# ═══════════════════════════════════════════════════════
# VSS Value Types
# ═══════════════════════════════════════════════════════

enum VSSValueKind:
    Literal     = 1;
    ThemeRef    = 2;
    FuncCall    = 3;
    Expr        = 4;
    ValueList   = 5;
end.

entity VSSValue:
    kind:       VSSValueKind;
    # Literal fields
    raw:        string;
    # ThemeRef fields
    theme_name: string,
        var_name:   string;
    # FuncCall fields
    func_name:  string,
        args:       Vec<VSSValue>;
    # Expr fields
    expr_op:    string,
        left_idx:   int,
        right_idx:  int;
    # ValueList fields
    items:      Vec<VSSValue>;
end.

func vss_literal:
    in(raw: string)
    out VSSValue (
        kind:       VSSValueKind::Literal,
        raw:        raw,
        theme_name: "",
        var_name:   "",
        func_name:  "",
        args:       vec_new<VSSValue>(),
        expr_op:    "",
        left_idx:   0,
        right_idx:  0,
        items:      vec_new<VSSValue>()
    );
end.

func vss_theme_ref:
    in(tname: string; vname: string)
    out VSSValue (
        kind:       VSSValueKind::ThemeRef,
        raw:        "",
        theme_name: tname,
        var_name:   vname,
        func_name:  "",
        args:       vec_new<VSSValue>(),
        expr_op:    "",
        left_idx:   0,
        right_idx:  0,
        items:      vec_new<VSSValue>()
    );
end.

func vss_func_call:
    in(fname: string; fargs: Vec<VSSValue>)
    out VSSValue (
        kind:       VSSValueKind::FuncCall,
        raw:        "",
        theme_name: "",
        var_name:   "",
        func_name:  fname,
        args:       fargs,
        expr_op:    "",
        left_idx:   0,
        right_idx:  0,
        items:      vec_new<VSSValue>()
    );
end.

func vss_expr:
    in(op: string; l: int; r: int)
    out VSSValue (
        kind:       VSSValueKind::Expr,
        raw:        "",
        theme_name: "",
        var_name:   "",
        func_name:  "",
        args:       vec_new<VSSValue>(),
        expr_op:    op,
        left_idx:   l,
        right_idx:  r,
        items:      vec_new<VSSValue>()
    );
end.

func vss_value_list:
    in(vals: Vec<VSSValue>)
    out VSSValue (
        kind:       VSSValueKind::ValueList,
        raw:        "",
        theme_name: "",
        var_name:   "",
        func_name:  "",
        args:       vec_new<VSSValue>(),
        expr_op:    "",
        left_idx:   0,
        right_idx:  0,
        items:      vals
    );
end


# ═══════════════════════════════════════════════════════
# VSS Condition — for `when` blocks (responsive)
# ═══════════════════════════════════════════════════════

entity VSSCondition:
    property:   string,
        operator:   string,
        value:      VSSValue;
end.

func vss_condition_new:
    in(prop: string; op: string; val: VSSValue)
    out VSSCondition ( property: prop, operator: op, value: val );
end


# ═══════════════════════════════════════════════════════
# VSS Declaration
# ═══════════════════════════════════════════════════════

entity VSSDeclaration:
    property:   string,
        value:      VSSValue,
        important:  int;
end.

func vss_decl_new:
    in(prop: string; val: VSSValue; imp: int)
    out VSSDeclaration ( property: prop, value: val, important: imp );
end


# ═══════════════════════════════════════════════════════
# VSS Nested Rule
# ═══════════════════════════════════════════════════════

entity VSSNestedRule:
    selector:       string,
        has_condition:  int,
        condition:      VSSCondition,
        declarations:   Vec<VSSDeclaration>,
        nested_rules:   Vec<VSSNestedRule>;
end.

func vss_nested_rule_new:
    in(sel: string)
    out VSSNestedRule (
        selector:       sel,
        has_condition:  0,
        condition:      vss_condition_new("", "", vss_literal("")),
        declarations:   vec_new<VSSDeclaration>(),
        nested_rules:   vec_new<VSSNestedRule>()
    );
end


# ═══════════════════════════════════════════════════════
# Top-level VSS Constructs
# ═══════════════════════════════════════════════════════

## Theme definition: theme Light: ... end ##
entity VSSTheme:
    name:       string,
        variables:  Vec<VSSDeclaration>;
end.

func vss_theme_new:
    in(name: string)
    out VSSTheme ( name: name, variables: vec_new<VSSDeclaration>() );
end


## Reusable style fragment: mixin rounded(radius): ... end ##
entity VSSMixin:
    name:       string,
        params:     Vec<VSSDeclaration>,
        declarations: Vec<VSSDeclaration>;
end.

func vss_mixin_new:
    in(name: string)
    out VSSMixin (
        name:           name,
        params:         vec_new<VSSDeclaration>(),
        declarations:   vec_new<VSSDeclaration>()
    );
end


## Keyframe step: (step_name, declarations) ##
entity VSSKeyframeStep:
    step_name:      string,
        declarations:   Vec<VSSDeclaration>;
end.

func vss_kf_step_new:
    in(name: string)
    out VSSKeyframeStep ( step_name: name, declarations: vec_new<VSSDeclaration>() );
end


## Keyframes: @keyframes name { ... } ##
entity VSSKeyframes:
    name:   string,
        steps:  Vec<VSSKeyframeStep>;
end.

func vss_keyframes_new:
    in(name: string)
    out VSSKeyframes ( name: name, steps: vec_new<VSSKeyframeStep>() );
end


## Style block: style card: ... end ##
entity VSSStyleBlock:
    name:               string,
        declarations:       Vec<VSSDeclaration>,
        nested_rules:       Vec<VSSNestedRule>,
        mixins_applied:     Vec<string>;
end.

func vss_style_block_new:
    in(name: string)
    out VSSStyleBlock (
        name:               name,
        declarations:       vec_new<VSSDeclaration>(),
        nested_rules:       vec_new<VSSNestedRule>(),
        mixins_applied:     vec_new<string>()
    );
end


## Full stylesheet ##
entity VSSStylesheet:
    themes:     Vec<VSSTheme>,
        styles:     Vec<VSSStyleBlock>,
        mixins:     Vec<VSSMixin>,
        keyframes:  Vec<VSSKeyframes>,
        imports:    Vec<string>;
end.

func vss_stylesheet_new:
    out VSSStylesheet (
        themes:     vec_new<VSSTheme>(),
        styles:     vec_new<VSSStyleBlock>(),
        mixins:     vec_new<VSSMixin>(),
        keyframes:  vec_new<VSSKeyframes>(),
        imports:    vec_new<string>()
    );
end


export VSSValueKind, VSSValue;
export vss_literal, vss_theme_ref, vss_func_call, vss_expr, vss_value_list;
export VSSCondition, vss_condition_new;
export VSSDeclaration, vss_decl_new;
export VSSNestedRule, vss_nested_rule_new;
export VSSTheme, vss_theme_new;
export VSSMixin, vss_mixin_new;
export VSSKeyframeStep, vss_kf_step_new;
export VSSKeyframes, vss_keyframes_new;
export VSSStyleBlock, vss_style_block_new;
export VSSStylesheet, vss_stylesheet_new;
