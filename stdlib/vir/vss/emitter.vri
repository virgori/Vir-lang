##
 * vir/vss/emitter.vri — VSS CSS Emitter
 * =======================================
 * Compiles resolved VSSStylesheet to CSS text.
 * Final stage of the VSS pipeline: VSSA → CSS string.
 *
 * Handles
 *   - Property normalization (underscore → hyphen)
 *   - Scoped class names (via VSSScoper mapping)
 *   - Nested rule flattening (&:hover → .card_a7f2:hover)
 *   - `when` condition → @media query translation
 *   - Keyframes emission
 *   - Value serialization (literals, func calls, value lists)
 ##

include types;
include string;
import String, str_new, str_eq, str_concat, str_len, str_char_at from string;
import str_replace from string;
include vec;
import Vec, vec_new, vec_push, vec_len, vec_get from vec;
include map;
import Map, map_new, map_set, map_get, map_has from map;
include vss/ast;
import VSSValueKind, VSSValue from vss/ast;
import VSSDeclaration from vss/ast;
import VSSNestedRule from vss/ast;
import VSSCondition from vss/ast;
import VSSKeyframes, VSSKeyframeStep from vss/ast;
import VSSStyleBlock from vss/ast;
import VSSStylesheet from vss/ast;
include vss/scoper;
import VSSScoper, vss_get_scoped_name from vss/scoper;


# ═══════════════════════════════════════════════════════
# Property normalization: underscore → hyphen
# ═══════════════════════════════════════════════════════

func _normalize_prop:
    in(prop: string) -> string
    out str_replace(prop, "_", "-");
end


# ═══════════════════════════════════════════════════════
# Shorthand transforms
# ═══════════════════════════════════════════════════════

func _is_shorthand_transform:
    in(prop: string) -> int
    if str_eq(prop, "scale") do
        out 1;
    end
    if str_eq(prop, "rotate") do
        out 1;
    end
    if str_eq(prop, "translate") do
        out 1;
    end
    out 0;
end.

func _transform_value:
    in(prop: string; val: string) -> string
    if str_eq(prop, "scale") do
        out str_concat("scale(", str_concat(val, ")"));
    end
    if str_eq(prop, "rotate") do
        out str_concat("rotate(", str_concat(val, ")"));
    end
    if str_eq(prop, "translate") do
        out str_concat("translate(", str_concat(val, ")"));
    end
    out val;
end


# ═══════════════════════════════════════════════════════
# Value serialization
# ═══════════════════════════════════════════════════════

func _emit_value:
    in(val: VSSValue) -> string

    if val.kind == VSSValueKind::Literal do
        out val.raw;
    end

    if val.kind == VSSValueKind::FuncCall do
        result = str_concat(val.func_name, "(");
        i = 0;
        when i < vec_len(val.args) loop
            if i > 0 do
                result = str_concat(result, ", ");
            end
            a = vec_get(val.args, i);
            result = str_concat(result, _emit_value(a));
            i = i + 1;
        end
        result = str_concat(result, ")");
        out result;
    end

    if val.kind == VSSValueKind::ValueList do
        result = "";
        i = 0;
        when i < vec_len(val.items) loop
            if i > 0 do
                result = str_concat(result, " ");
            end
            v = vec_get(val.items, i);
            result = str_concat(result, _emit_value(v));
            i = i + 1;
        end
        out result;
    end

    # ThemeRef should already be resolved
    out "";
end


# ═══════════════════════════════════════════════════════
# Declarations → CSS text
# ═══════════════════════════════════════════════════════

func _emit_declarations:
    in(decls: Vec<VSSDeclaration>; indent: string) -> string
    result = "";
    i = 0;
    when i < vec_len(decls) loop
        d = vec_get(decls, i);
        css_prop = _normalize_prop(d.property);
        css_val = _emit_value(d.value);

        # Handle shorthand transforms
        if _is_shorthand_transform(d.property) == 1 do
            css_prop = "transform";
            css_val = _transform_value(d.property, css_val);
        end

        imp = "";
        if d.important == 1 do
            imp = " !important";
        end

        line = str_concat(indent, str_concat("  ", str_concat(css_prop,
               str_concat(": ", str_concat(css_val, str_concat(imp, ";\n"))))));
        result = str_concat(result, line);
        i = i + 1;
    end
    out result;
end


# ═══════════════════════════════════════════════════════
# Condition → @media query
# ═══════════════════════════════════════════════════════

func _condition_to_media:
    in(cond: VSSCondition) -> string
    prop = cond.property;
    val = _emit_value(cond.value);

    media_prop = prop;
    if str_eq(prop, "width") do
        if str_eq(cond.operator, ">") do
            media_prop = "min-width";
        eif str_eq(cond.operator, ">=") do
            media_prop = "min-width";
        eif str_eq(cond.operator, "<") do
            media_prop = "max-width";
        eif str_eq(cond.operator, "<=") do
            media_prop = "max-width";
        end
    end
    if str_eq(prop, "height") do
        if str_eq(cond.operator, ">") do
            media_prop = "min-height";
        eif str_eq(cond.operator, ">=") do
            media_prop = "min-height";
        eif str_eq(cond.operator, "<") do
            media_prop = "max-height";
        eif str_eq(cond.operator, "<=") do
            media_prop = "max-height";
        end
    end

    out str_concat(media_prop, str_concat(": ", val));
end


# ═══════════════════════════════════════════════════════
# Nested rule emission
# ═══════════════════════════════════════════════════════

func _emit_nested_rule:
    in(sc: VSSScoper; parent_sel: string; rule: VSSNestedRule) -> string
    result = "";

    if rule.has_condition == 1 do
        # `when` block → @media query
        media = _condition_to_media(rule.condition);
        decls = _emit_declarations(rule.declarations, "    ");
        if str_len(decls) > 0 do
            result = str_concat(result, str_concat("@media (", str_concat(media,
                     str_concat(") {\n  ", str_concat(parent_sel,
                     str_concat(" {\n", str_concat(decls,
                     "  }\n}\n")))))));
        end
        out result;
    end

    # Check selector type
    sel = rule.selector;
    full_sel = "";

    # &:pseudo → parent_sel:pseudo
    if str_len(sel) > 0 do
        if str_char_at(sel, 0) == 38 do # &
            # Strip the &
            pseudo = "";
            j = 1;
            when j < str_len(sel) loop
                pseudo = str_concat(pseudo, _char_to_str(str_char_at(sel, j)));
                j = j + 1;
            end
            full_sel = str_concat(parent_sel, pseudo);
        eif str_char_at(sel, 0) == 62 do # >
            # Child combinator
            child = "";
            j = 2;   # skip "> "
            when j < str_len(sel) loop
                child = str_concat(child, _char_to_str(str_char_at(sel, j)));
                j = j + 1;
            end
            scoped_child = vss_get_scoped_name(sc, child);
            full_sel = str_concat(parent_sel, str_concat(" > .", scoped_child));
        eif
            full_sel = str_concat(parent_sel, str_concat(" ", sel));
        end
    end

    decls = _emit_declarations(rule.declarations, "");
    if str_len(decls) > 0 do
        result = str_concat(result, str_concat(full_sel,
                 str_concat(" {\n", str_concat(decls, "}\n"))));
    end

    # Recurse into deeper nesting
    i = 0;
    when i < vec_len(rule.nested_rules) loop
        nr = vec_get(rule.nested_rules, i);
        result = str_concat(result, _emit_nested_rule(sc, full_sel, nr));
        i = i + 1;
    end

    out result;
end.

func _char_to_str:
    in(ch: int) -> string
    # Simple ASCII char→string conversion
    # In practice this would use a builtin
    out str_from_char(ch);
end


# ═══════════════════════════════════════════════════════
# Style block emission
# ═══════════════════════════════════════════════════════

func _emit_style:
    in(sc: VSSScoper; style: VSSStyleBlock) -> string
    class_name = vss_get_scoped_name(sc, style.name);
    selector = str_concat(".", class_name);
    result = "";

    # Main declarations
    decls = _emit_declarations(style.declarations, "");
    if str_len(decls) > 0 do
        result = str_concat(result, str_concat(selector,
                 str_concat(" {\n", str_concat(decls, "}\n"))));
    end

    # Nested rules
    i = 0;
    when i < vec_len(style.nested_rules) loop
        nr = vec_get(style.nested_rules, i);
        result = str_concat(result, _emit_nested_rule(sc, selector, nr));
        i = i + 1;
    end

    out result;
end


# ═══════════════════════════════════════════════════════
# Keyframes emission
# ═══════════════════════════════════════════════════════

func _emit_keyframes:
    in(sc: VSSScoper; kf: VSSKeyframes) -> string
    name = vss_get_scoped_name(sc, kf.name);
    result = str_concat("@keyframes ", str_concat(name, " {\n"));

    i = 0;
    when i < vec_len(kf.steps) loop
        step = vec_get(kf.steps, i);
        decls = _emit_declarations(step.declarations, "  ");
        result = str_concat(result, str_concat("  ", str_concat(step.step_name,
                 str_concat(" {\n", str_concat(decls, "  }\n")))));
        i = i + 1;
    end

    result = str_concat(result, "}\n");
    out result;
end


# ═══════════════════════════════════════════════════════
# Full stylesheet emission
# ═══════════════════════════════════════════════════════

func vss_emit_css:
    in(sc: VSSScoper; sheet: VSSStylesheet) -> string
    result = "";

    # Keyframes first
    i = 0;
    when i < vec_len(sheet.keyframes) loop
        kf = vec_get(sheet.keyframes, i);
        result = str_concat(result, _emit_keyframes(sc, kf));
        i = i + 1;
    end

    # Style blocks
    i = 0;
    when i < vec_len(sheet.styles) loop
        style = vec_get(sheet.styles, i);
        result = str_concat(result, _emit_style(sc, style));
        i = i + 1;
    end

    out result;
end


export vss_emit_css;
