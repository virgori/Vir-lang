##
 * vir/vss/scoper.vri — VSS Scoped Class Name Mangling
 * =====================================================
 * Generates unique, scoped CSS class names to prevent
 * global style collisions. Each style block gets a
 * deterministic hash suffix based on component + name.
 *
 * Example: style "card" in component "App" → ".card_a7f2"
 ##

include types;
include string;
import String, str_new, str_eq, str_concat, str_len, str_char_at from string;
include vec;
import Vec, vec_new, vec_push, vec_len, vec_get from vec;
include map;
import Map, map_new, map_set, map_get, map_has from map;
include vss/ast;
import VSSStylesheet, VSSStyleBlock, VSSKeyframes from vss/ast;


# ═══════════════════════════════════════════════════════
# Scoper State
# ═══════════════════════════════════════════════════════

entity VSSScoper:
    prefix:     string,
        name_map:   Map<string, string>;
end.

func vss_scoper_new:
    in(prefix: string)
    out VSSScoper ( prefix: prefix, name_map: map_new<string, string>() );
end


# ═══════════════════════════════════════════════════════
# Simple hash — DJB2 to hex suffix (4 chars)
# ═══════════════════════════════════════════════════════

func _djb2_hash:
    in(s: string) -> int
    h = 5381;
    i = 0;
    when i < str_len(s) loop
        ch = str_char_at(s, i);
        h = ((h * 33) + ch) & 0xFFFFFFFF;
        i = i + 1;
    end
    out h;
end.

func _hex_char:
    in(n: int) -> string
    if n == 0 do out "0"; end
    if n == 1 do out "1"; end
    if n == 2 do out "2"; end
    if n == 3 do out "3"; end
    if n == 4 do out "4"; end
    if n == 5 do out "5"; end
    if n == 6 do out "6"; end
    if n == 7 do out "7"; end
    if n == 8 do out "8"; end
    if n == 9 do out "9"; end
    if n == 10 do out "a"; end
    if n == 11 do out "b"; end
    if n == 12 do out "c"; end
    if n == 13 do out "d"; end
    if n == 14 do out "e"; end
    if n == 15 do out "f"; end
    out "0";
end.

func _to_hex4:
    in(val: int) -> string
    h1 = (val >> 12) & 0xF;
    h2 = (val >> 8) & 0xF;
    h3 = (val >> 4) & 0xF;
    h4 = val & 0xF;
    out str_concat(_hex_char(h1), str_concat(_hex_char(h2),
        str_concat(_hex_char(h3), _hex_char(h4))));
end


# ═══════════════════════════════════════════════════════
# Scoped name generation
# ═══════════════════════════════════════════════════════

func _generate_scoped_name:
    in(sc: VSSScoper; name: string) -> string
    seed = str_concat(sc.prefix, str_concat(":", name));
    h = _djb2_hash(seed);
    suffix = _to_hex4(h);
    out str_concat(name, str_concat("_", suffix));
end


# ═══════════════════════════════════════════════════════
# Scope a stylesheet
# ═══════════════════════════════════════════════════════

func vss_scope_stylesheet:
    in(sc: VSSScoper; sheet: VSSStylesheet) -> VSSScoper
    # Scope style blocks
    i = 0;
    when i < vec_len(sheet.styles) loop
        style = vec_get(sheet.styles, i);
        scoped = _generate_scoped_name(sc, style.name);
        map_set(sc.name_map, style.name, scoped);
        i = i + 1;
    end

    # Scope keyframes
    i = 0;
    when i < vec_len(sheet.keyframes) loop
        kf = vec_get(sheet.keyframes, i);
        scoped = _generate_scoped_name(sc, kf.name);
        map_set(sc.name_map, kf.name, scoped);
        i = i + 1;
    end

    out sc;
end.

func vss_get_scoped_name:
    in(sc: VSSScoper; original: string) -> string
    if map_has(sc.name_map, original) do
        out map_get(sc.name_map, original);
    end
    out original;
end


export VSSScoper, vss_scoper_new;
export vss_scope_stylesheet, vss_get_scoped_name;
