##
 * vir/vss/tokenizer.vri — VSS Tokenizer (Lexer)
 * ================================================
 * Tokenizes `.vss` source into a stream of VSSToken entities.
 * Supports multilingual keywords via keyword configuration.
 *
 * Token types mirror CSS concepts plus VSS extensions:
 *   THEME, STYLE, MIXIN, KEYFRAMES, WHEN, END,
 *   IDENT, NUMBER, STRING, COLOR, COLON, SEMICOLON, etc.
 ##

include types;
include string;
import String, str_new, str_eq, str_len, str_concat, str_char_at from string;
import str_sub, str_find from string;
include vec;
import Vec, vec_new, vec_push, vec_len, vec_get from vec;


# ═══════════════════════════════════════════════════════
# Token Types
# ═══════════════════════════════════════════════════════

enum VSSTokenKind:
    # Keywords
    TK_THEME        = 1;
    TK_STYLE        = 2;
    TK_MIXIN        = 3;
    TK_KEYFRAMES    = 4;
    TK_END          = 5;
    TK_WHEN         = 6;
    TK_INCLUDE      = 7;
    TK_APPLY        = 8;
    TK_IMPORTANT    = 9;

    # Literals
    TK_IDENT        = 20;
    TK_NUMBER       = 21;
    TK_STRING       = 22;
    TK_COLOR        = 23;
    TK_UNIT_VALUE   = 24;

    # Delimiters
    TK_COLON        = 30;
    TK_SEMICOLON    = 31;
    TK_COMMA        = 32;
    TK_DOT          = 33;
    TK_AMPERSAND    = 34;
    TK_LPAREN       = 35;
    TK_RPAREN       = 36;
    TK_LBRACKET     = 37;
    TK_RBRACKET     = 38;
    TK_LBRACE       = 39;
    TK_RBRACE       = 40;

    # Operators
    TK_PLUS         = 50;
    TK_MINUS        = 51;
    TK_STAR         = 52;
    TK_SLASH        = 53;
    TK_GT           = 54;
    TK_LT           = 55;
    TK_GTE          = 56;
    TK_LTE          = 57;
    TK_EQ           = 58;
    TK_PERCENT      = 59;

    # Special
    TK_NEWLINE      = 90;
    TK_EOF          = 91;
    TK_INVALID      = 92;
end


# ═══════════════════════════════════════════════════════
# Token
# ═══════════════════════════════════════════════════════

entity VSSToken:
    kind:   VSSTokenKind;
    value:  string;
    line:   int;
    col:    int;
end

func vss_token_new:
    in(k: VSSTokenKind; v: string; ln: int; c: int)
    out VSSToken { kind: k, value: v, line: ln, col: c };
end


# ═══════════════════════════════════════════════════════
# Character classification helpers
# ═══════════════════════════════════════════════════════

func _is_alpha:
    in(ch: int) -> int
    if ch >= 65:
        if ch <= 90:
            out 1;
        end
    end
    if ch >= 97:
        if ch <= 122:
            out 1;
        end
    end
    if ch == 95:   # underscore
        out 1;
    end
    if ch > 127:   # Unicode (multilingual support)
        out 1;
    end
    out 0;
end

func _is_digit:
    in(ch: int) -> int
    if ch >= 48:
        if ch <= 57:
            out 1;
        end
    end
    out 0;
end

func _is_alnum:
    in(ch: int) -> int
    if _is_alpha(ch) == 1:
        out 1;
    end
    if _is_digit(ch) == 1:
        out 1;
    end
    out 0;
end

func _is_space:
    in(ch: int) -> int
    if ch == 32:    # space
        out 1;
    end
    if ch == 9:     # tab
        out 1;
    end
    out 0;
end

func _is_hex:
    in(ch: int) -> int
    if _is_digit(ch) == 1:
        out 1;
    end
    if ch >= 65:
        if ch <= 70:
            out 1;
        end
    end
    if ch >= 97:
        if ch <= 102:
            out 1;
        end
    end
    out 0;
end


# ═══════════════════════════════════════════════════════
# Keyword lookup
# ═══════════════════════════════════════════════════════

func _keyword_kind:
    in(word: string) -> VSSTokenKind
    if str_eq(word, "theme"):
        out VSSTokenKind::TK_THEME;
    end
    if str_eq(word, "style"):
        out VSSTokenKind::TK_STYLE;
    end
    if str_eq(word, "mixin"):
        out VSSTokenKind::TK_MIXIN;
    end
    if str_eq(word, "keyframes"):
        out VSSTokenKind::TK_KEYFRAMES;
    end
    if str_eq(word, "end"):
        out VSSTokenKind::TK_END;
    end
    if str_eq(word, "when"):
        out VSSTokenKind::TK_WHEN;
    end
    if str_eq(word, "include"):
        out VSSTokenKind::TK_INCLUDE;
    end
    if str_eq(word, "apply"):
        out VSSTokenKind::TK_APPLY;
    end
    if str_eq(word, "important"):
        out VSSTokenKind::TK_IMPORTANT;
    end
    # Vietnamese keywords
    if str_eq(word, "chủ_đề"):
        out VSSTokenKind::TK_THEME;
    end
    if str_eq(word, "phong_cách"):
        out VSSTokenKind::TK_STYLE;
    end
    if str_eq(word, "kiểu"):
        out VSSTokenKind::TK_STYLE;
    end
    if str_eq(word, "trộn"):
        out VSSTokenKind::TK_MIXIN;
    end
    if str_eq(word, "khung_hình"):
        out VSSTokenKind::TK_KEYFRAMES;
    end
    if str_eq(word, "hết"):
        out VSSTokenKind::TK_END;
    end
    if str_eq(word, "kết_thúc"):
        out VSSTokenKind::TK_END;
    end
    if str_eq(word, "khi"):
        out VSSTokenKind::TK_WHEN;
    end
    if str_eq(word, "bao_gồm"):
        out VSSTokenKind::TK_INCLUDE;
    end
    if str_eq(word, "áp_dụng"):
        out VSSTokenKind::TK_APPLY;
    end
    if str_eq(word, "quan_trọng"):
        out VSSTokenKind::TK_IMPORTANT;
    end
    out VSSTokenKind::TK_IDENT;
end


# ═══════════════════════════════════════════════════════
# Unit suffix detection
# ═══════════════════════════════════════════════════════

func _is_unit_suffix:
    in(s: string) -> int
    if str_eq(s, "px"):   out 1; end
    if str_eq(s, "em"):   out 1; end
    if str_eq(s, "rem"):  out 1; end
    if str_eq(s, "vw"):   out 1; end
    if str_eq(s, "vh"):   out 1; end
    if str_eq(s, "vmin"): out 1; end
    if str_eq(s, "vmax"): out 1; end
    if str_eq(s, "ch"):   out 1; end
    if str_eq(s, "ex"):   out 1; end
    if str_eq(s, "cm"):   out 1; end
    if str_eq(s, "mm"):   out 1; end
    if str_eq(s, "in"):   out 1; end
    if str_eq(s, "pt"):   out 1; end
    if str_eq(s, "pc"):   out 1; end
    if str_eq(s, "fr"):   out 1; end
    if str_eq(s, "s"):    out 1; end
    if str_eq(s, "ms"):   out 1; end
    if str_eq(s, "deg"):  out 1; end
    if str_eq(s, "rad"):  out 1; end
    if str_eq(s, "turn"): out 1; end
    out 0;
end


# ═══════════════════════════════════════════════════════
# Tokenizer
# ═══════════════════════════════════════════════════════

func vss_tokenize:
    in(source: string) -> Vec<VSSToken>
    tokens = vec_new<VSSToken>();
    slen = str_len(source);
    pos = 0;
    line = 1;
    col = 0;

    when pos < slen loop
        ch = str_char_at(source, pos);

        # Newline
        if ch == 10:
            line = line + 1;
            col = 0;
            pos = pos + 1;
            skip;
        end

        # Skip whitespace
        if _is_space(ch) == 1:
            pos = pos + 1;
            col = col + 1;
            skip;
        end

        # Single-line comment: // ...
        if ch == 47:
            if pos + 1 < slen:
                if str_char_at(source, pos + 1) == 47:
                    # Skip to end of line
                    when pos < slen loop
                        if str_char_at(source, pos) == 10:
                            skip;
                        end
                        pos = pos + 1;
                    end
                    skip;
                end
            end
        end

        # Block comment: /* ... */
        if ch == 47:
            if pos + 1 < slen:
                if str_char_at(source, pos + 1) == 42:
                    pos = pos + 2;
                    when pos + 1 < slen loop
                        if str_char_at(source, pos) == 42:
                            if str_char_at(source, pos + 1) == 47:
                                pos = pos + 2;
                                skip;
                            end
                        end
                        if str_char_at(source, pos) == 10:
                            line = line + 1;
                            col = 0;
                        end
                        pos = pos + 1;
                    end
                    skip;
                end
            end
        end

        # Single-char delimiters
        if ch == 58:    # :
            vec_push(tokens, vss_token_new(VSSTokenKind::TK_COLON, ":", line, col));
            pos = pos + 1; col = col + 1; skip;
        end
        if ch == 59:    # ;
            vec_push(tokens, vss_token_new(VSSTokenKind::TK_SEMICOLON, ";", line, col));
            pos = pos + 1; col = col + 1; skip;
        end
        if ch == 44:    # ,
            vec_push(tokens, vss_token_new(VSSTokenKind::TK_COMMA, ",", line, col));
            pos = pos + 1; col = col + 1; skip;
        end
        if ch == 46:    # .
            vec_push(tokens, vss_token_new(VSSTokenKind::TK_DOT, ".", line, col));
            pos = pos + 1; col = col + 1; skip;
        end
        if ch == 38:    # &
            vec_push(tokens, vss_token_new(VSSTokenKind::TK_AMPERSAND, "&", line, col));
            pos = pos + 1; col = col + 1; skip;
        end
        if ch == 123:   # {
            vec_push(tokens, vss_token_new(VSSTokenKind::TK_LBRACE, "{", line, col));
            pos = pos + 1; col = col + 1; skip;
        end
        if ch == 125:   # }
            vec_push(tokens, vss_token_new(VSSTokenKind::TK_RBRACE, "}", line, col));
            pos = pos + 1; col = col + 1; skip;
        end
        if ch == 40:    # (
            vec_push(tokens, vss_token_new(VSSTokenKind::TK_LPAREN, "(", line, col));
            pos = pos + 1; col = col + 1; skip;
        end
        if ch == 41:    # )
            vec_push(tokens, vss_token_new(VSSTokenKind::TK_RPAREN, ")", line, col));
            pos = pos + 1; col = col + 1; skip;
        end
        if ch == 91:    # [
            vec_push(tokens, vss_token_new(VSSTokenKind::TK_LBRACKET, "[", line, col));
            pos = pos + 1; col = col + 1; skip;
        end
        if ch == 93:    # ]
            vec_push(tokens, vss_token_new(VSSTokenKind::TK_RBRACKET, "]", line, col));
            pos = pos + 1; col = col + 1; skip;
        end
        if ch == 43:    # +
            vec_push(tokens, vss_token_new(VSSTokenKind::TK_PLUS, "+", line, col));
            pos = pos + 1; col = col + 1; skip;
        end
        if ch == 42:    # *
            vec_push(tokens, vss_token_new(VSSTokenKind::TK_STAR, "*", line, col));
            pos = pos + 1; col = col + 1; skip;
        end
        if ch == 47:    # /
            vec_push(tokens, vss_token_new(VSSTokenKind::TK_SLASH, "/", line, col));
            pos = pos + 1; col = col + 1; skip;
        end
        if ch == 37:    # %
            vec_push(tokens, vss_token_new(VSSTokenKind::TK_PERCENT, "%", line, col));
            pos = pos + 1; col = col + 1; skip;
        end

        # Multi-char operators
        if ch == 62:    # >
            if pos + 1 < slen:
                if str_char_at(source, pos + 1) == 61:  # >=
                    vec_push(tokens, vss_token_new(VSSTokenKind::TK_GTE, ">=", line, col));
                    pos = pos + 2; col = col + 2; skip;
                end
            end
            vec_push(tokens, vss_token_new(VSSTokenKind::TK_GT, ">", line, col));
            pos = pos + 1; col = col + 1; skip;
        end
        if ch == 60:    # <
            if pos + 1 < slen:
                if str_char_at(source, pos + 1) == 61:  # <=
                    vec_push(tokens, vss_token_new(VSSTokenKind::TK_LTE, "<=", line, col));
                    pos = pos + 2; col = col + 2; skip;
                end
            end
            vec_push(tokens, vss_token_new(VSSTokenKind::TK_LT, "<", line, col));
            pos = pos + 1; col = col + 1; skip;
        end
        if ch == 61:    # =
            if pos + 1 < slen:
                if str_char_at(source, pos + 1) == 61:  # ==
                    vec_push(tokens, vss_token_new(VSSTokenKind::TK_EQ, "==", line, col));
                    pos = pos + 2; col = col + 2; skip;
                end
            end
        end

        # String literals
        if ch == 34:    # "
            start = pos;
            pos = pos + 1;
            when pos < slen loop
                c = str_char_at(source, pos);
                if c == 92:     # backslash escape
                    pos = pos + 2;
                    skip;
                end
                if c == 34:
                    pos = pos + 1;
                    skip;
                end
                pos = pos + 1;
            end
            raw = str_sub(source, start, pos);
            vec_push(tokens, vss_token_new(VSSTokenKind::TK_STRING, raw, line, col));
            col = col + (pos - start);
            skip;
        end
        if ch == 39:    # '
            start = pos;
            pos = pos + 1;
            when pos < slen loop
                c = str_char_at(source, pos);
                if c == 92:
                    pos = pos + 2;
                    skip;
                end
                if c == 39:
                    pos = pos + 1;
                    skip;
                end
                pos = pos + 1;
            end
            raw = str_sub(source, start, pos);
            vec_push(tokens, vss_token_new(VSSTokenKind::TK_STRING, raw, line, col));
            col = col + (pos - start);
            skip;
        end

        # Color literals (#hex)
        if ch == 35:    # #
            start = pos;
            pos = pos + 1;
            when pos < slen loop
                if _is_hex(str_char_at(source, pos)) == 0:
                    skip;
                end
                pos = pos + 1;
            end
            raw = str_sub(source, start, pos);
            vec_push(tokens, vss_token_new(VSSTokenKind::TK_COLOR, raw, line, col));
            col = col + (pos - start);
            skip;
        end

        # Negative numbers: -123, -16px
        if ch == 45:    # -
            if pos + 1 < slen:
                if _is_digit(str_char_at(source, pos + 1)) == 1:
                    start = pos;
                    pos = pos + 1;
                    when pos < slen loop
                        c = str_char_at(source, pos);
                        if _is_digit(c) == 0:
                            if c != 46:     # not .
                                skip;
                            end
                        end
                        pos = pos + 1;
                    end
                    # Check for unit suffix
                    unit_start = pos;
                    when pos < slen loop
                        if _is_alpha(str_char_at(source, pos)) == 0:
                            if str_char_at(source, pos) != 37:   # not %
                                skip;
                            end
                        end
                        pos = pos + 1;
                    end
                    raw = str_sub(source, start, pos);
                    if pos > unit_start:
                        unit = str_sub(source, unit_start, pos);
                        if _is_unit_suffix(unit) == 1:
                            vec_push(tokens, vss_token_new(VSSTokenKind::TK_UNIT_VALUE, raw, line, col));
                        eif str_eq(unit, "%"):
                            vec_push(tokens, vss_token_new(VSSTokenKind::TK_UNIT_VALUE, raw, line, col));
                        eif:
                            num = str_sub(source, start, unit_start);
                            vec_push(tokens, vss_token_new(VSSTokenKind::TK_NUMBER, num, line, col));
                            pos = unit_start;
                        end
                    eif:
                        vec_push(tokens, vss_token_new(VSSTokenKind::TK_NUMBER, raw, line, col));
                    end
                    col = col + (pos - start);
                    skip;
                end
            end
            # Standalone minus
            vec_push(tokens, vss_token_new(VSSTokenKind::TK_MINUS, "-", line, col));
            pos = pos + 1; col = col + 1; skip;
        end

        # Numbers and unit values: 16px, 0.5em, 100%
        if _is_digit(ch) == 1:
            start = pos;
            when pos < slen loop
                c = str_char_at(source, pos);
                if _is_digit(c) == 0:
                    if c != 46:
                        skip;
                    end
                end
                pos = pos + 1;
            end
            # Check for unit suffix
            unit_start = pos;
            when pos < slen loop
                c = str_char_at(source, pos);
                if _is_alpha(c) == 0:
                    if c != 37:
                        skip;
                    end
                end
                pos = pos + 1;
            end
            raw = str_sub(source, start, pos);
            if pos > unit_start:
                unit = str_sub(source, unit_start, pos);
                if _is_unit_suffix(unit) == 1:
                    vec_push(tokens, vss_token_new(VSSTokenKind::TK_UNIT_VALUE, raw, line, col));
                eif str_eq(unit, "%"):
                    vec_push(tokens, vss_token_new(VSSTokenKind::TK_UNIT_VALUE, raw, line, col));
                eif:
                    num = str_sub(source, start, unit_start);
                    vec_push(tokens, vss_token_new(VSSTokenKind::TK_NUMBER, num, line, col));
                    pos = unit_start;
                end
            eif:
                vec_push(tokens, vss_token_new(VSSTokenKind::TK_NUMBER, raw, line, col));
            end
            col = col + (pos - start);
            skip;
        end

        # Identifiers and keywords
        if _is_alpha(ch) == 1:
            start = pos;
            when pos < slen loop
                if _is_alnum(str_char_at(source, pos)) == 0:
                    skip;
                end
                pos = pos + 1;
            end
            word = str_sub(source, start, pos);
            kind = _keyword_kind(word);
            vec_push(tokens, vss_token_new(kind, word, line, col));
            col = col + (pos - start);
            skip;
        end

        # Unknown character
        raw = str_sub(source, pos, pos + 1);
        vec_push(tokens, vss_token_new(VSSTokenKind::TK_INVALID, raw, line, col));
        pos = pos + 1;
        col = col + 1;
    end

    # Append EOF
    vec_push(tokens, vss_token_new(VSSTokenKind::TK_EOF, "", line, 0));
    out tokens;
end


export VSSTokenKind, VSSToken, vss_token_new, vss_tokenize;
