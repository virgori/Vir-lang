##
 * vir/vss/tokenizer.vri — VSS Tokenizer (Lexer)
 * ================================================
 * Tokenizes `.vss` source into a stream of VSSToken entities.
 * Supports multilingual keywords via keyword configuration.
 *
 * Token types mirror CSS concepts plus VSS extensions
 *   THEME, STYLE, MIXIN, KEYFRAMES, WHEN, END,
 *   IDENT, NUMBER, STRING, COLOR, COLON, SEMICOLON, etc.
 ##

include types;
include string;
import String, str_new, str_eq, str_len, str_concat, str_char_at from string;
import str_sub, str_find from string;
include vec;
import Vec, vec_new, vec_push, vec_len, vec_get from vec;


# ═══════════════════════════════════════════════════════
# Token Types
# ═══════════════════════════════════════════════════════

enum VSSTokenKind:
    # Keywords
    TK_THEME        = 1;
    TK_STYLE        = 2;
    TK_MIXIN        = 3;
    TK_KEYFRAMES    = 4;
    TK_END          = 5;
    TK_WHEN         = 6;
    TK_INCLUDE      = 7;
    TK_APPLY        = 8;
    TK_IMPORTANT    = 9;

    # Literals
    TK_IDENT        = 20;
    TK_NUMBER       = 21;
    TK_STRING       = 22;
    TK_COLOR        = 23;
    TK_UNIT_VALUE   = 24;

    # Delimiters
    TK_COLON        = 30;
    TK_SEMICOLON    = 31;
    TK_COMMA        = 32;
    TK_DOT          = 33;
    TK_AMPERSAND    = 34;
    TK_LPAREN       = 35;
    TK_RPAREN       = 36;
    TK_LBRACKET     = 37;
    TK_RBRACKET     = 38;
    TK_LBRACE       = 39;
    TK_RBRACE       = 40;

    # Operators
    TK_PLUS         = 50;
    TK_MINUS        = 51;
    TK_STAR         = 52;
    TK_SLASH        = 53;
    TK_GT           = 54;
    TK_LT           = 55;
    TK_GTE          = 56;
    TK_LTE          = 57;
    TK_EQ           = 58;
    TK_PERCENT      = 59;

    # Special
    TK_NEWLINE      = 90;
    TK_EOF          = 91;
    TK_INVALID      = 92;
end.


# ═══════════════════════════════════════════════════════
# Token
# ═══════════════════════════════════════════════════════

entity VSSToken:
    kind:   VSSTokenKind,
        value:  string,
        line:   int,
        col:    int;
end.
func vss_token_new:
    in  k: VSSTokenKind;
        v: string;
        ln: int;
        c: int
    out VSSToken ( kind: k, value: v, line: ln, col: c );
end.
# ═══════════════════════════════════════════════════════
# Character classification helpers
# ═══════════════════════════════════════════════════════

func _is_alpha(ch: int):
    if ch >= 65 do
        if ch <= 90 do
            out 1;
        end
    end
    if ch >= 97 do
        if ch <= 122 do
            out 1;
        end
    end
    if ch == 95 do # underscore
        out 1;
    end
    if ch > 127 do # Unicode (multilingual support)
        out 1;
    end
    out 0;
end.
func _is_digit(ch: int):
    if ch >= 48 do
        if ch <= 57 do
            out 1;
        end
    end
    out 0;
end.
func _is_alnum(ch: int):
    if _is_alpha(ch) == 1 do
        out 1;
    end
    if _is_digit(ch) == 1 do
        out 1;
    end
    out 0;
end.
func _is_space(ch: int):
    if ch == 32 do # space
        out 1;
    end
    if ch == 9 do # tab
        out 1;
    end
    out 0;
end.
func _is_hex(ch: int):
    if _is_digit(ch) == 1 do
        out 1;
    end
    if ch >= 65 do
        if ch <= 70 do
            out 1;
        end
    end
    if ch >= 97 do
        if ch <= 102 do
            out 1;
        end
    end
    out 0;
end.
# ═══════════════════════════════════════════════════════
# Keyword lookup
# ═══════════════════════════════════════════════════════

func _keyword_kind(word: string):
    if str_eq(word, "theme") do
        out VSSTokenKind::TK_THEME;
    end
    if str_eq(word, "style") do
        out VSSTokenKind::TK_STYLE;
    end
    if str_eq(word, "mixin") do
        out VSSTokenKind::TK_MIXIN;
    end
    if str_eq(word, "keyframes") do
        out VSSTokenKind::TK_KEYFRAMES;
    end
    if str_eq(word, "end") do
        out VSSTokenKind::TK_END;
    end
    if str_eq(word, "when") do
        out VSSTokenKind::TK_WHEN;
    end
    if str_eq(word, "include") do
        out VSSTokenKind::TK_INCLUDE;
    end
    if str_eq(word, "apply") do
        out VSSTokenKind::TK_APPLY;
    end
    if str_eq(word, "important") do
        out VSSTokenKind::TK_IMPORTANT;
    end
    # Vietnamese keywords
    if str_eq(word, "chủ_đề") do
        out VSSTokenKind::TK_THEME;
    end
    if str_eq(word, "phong_cách") do
        out VSSTokenKind::TK_STYLE;
    end
    if str_eq(word, "kiểu") do
        out VSSTokenKind::TK_STYLE;
    end
    if str_eq(word, "trộn") do
        out VSSTokenKind::TK_MIXIN;
    end
    if str_eq(word, "khung_hình") do
        out VSSTokenKind::TK_KEYFRAMES;
    end
    if str_eq(word, "end") do
        out VSSTokenKind::TK_END;
    end
    if str_eq(word, "kết_thúc") do
        out VSSTokenKind::TK_END;
    end
    if str_eq(word, "khi") do
        out VSSTokenKind::TK_WHEN;
    end
    if str_eq(word, "include") do
        out VSSTokenKind::TK_INCLUDE;
    end
    if str_eq(word, "áp_dụng") do
        out VSSTokenKind::TK_APPLY;
    end
    if str_eq(word, "quan_trọng") do
        out VSSTokenKind::TK_IMPORTANT;
    end
    out VSSTokenKind::TK_IDENT;
end.
# ═══════════════════════════════════════════════════════
# Unit suffix detection
# ═══════════════════════════════════════════════════════

func _is_unit_suffix(s: string):
    if str_eq(s, "px") do out 1; end
    if str_eq(s, "em") do out 1; end
    if str_eq(s, "rem") do out 1; end
    if str_eq(s, "vw") do out 1; end
    if str_eq(s, "vh") do out 1; end
    if str_eq(s, "vmin") do out 1; end
    if str_eq(s, "vmax") do out 1; end
    if str_eq(s, "ch") do out 1; end
    if str_eq(s, "ex") do out 1; end
    if str_eq(s, "cm") do out 1; end
    if str_eq(s, "mm") do out 1; end
    if str_eq(s, "in") do out 1; end
    if str_eq(s, "pt") do out 1; end
    if str_eq(s, "pc") do out 1; end
    if str_eq(s, "fr") do out 1; end
    if str_eq(s, "s") do out 1; end
    if str_eq(s, "ms") do out 1; end
    if str_eq(s, "deg") do out 1; end
    if str_eq(s, "rad") do out 1; end
    if str_eq(s, "turn") do out 1; end
    out 0;
end.
# ═══════════════════════════════════════════════════════
# Tokenizer
# ═══════════════════════════════════════════════════════

func vss_tokenize(source: string):
    tokens = vec_new<VSSToken>();
    slen = str_len(source);
    pos = 0;
    line = 1;
    col = 0;

    when pos < slen loop
        ch = str_char_at(source, pos);

        # Newline
        if ch == 10 do
            line = line + 1;
            col = 0;
            pos = pos + 1;
            skip;
        end

        # Skip whitespace
        if _is_space(ch) == 1 do
            pos = pos + 1;
            col = col + 1;
            skip;
        end

        # Single-line comment: // ...
        if ch == 47 do
            if pos + 1 < slen do
                if str_char_at(source, pos + 1) == 47 do
                    # Skip to end of line
                    when pos < slen loop
                        if str_char_at(source, pos) == 10 do
                            skip;
                        end
                        pos = pos + 1;
                    end
                    skip;
                end
            end
        end

        # Block comment: /* ... */
        if ch == 47 do
            if pos + 1 < slen do
                if str_char_at(source, pos + 1) == 42 do
                    pos = pos + 2;
                    when pos + 1 < slen loop
                        if str_char_at(source, pos) == 42 do
                            if str_char_at(source, pos + 1) == 47 do
                                pos = pos + 2;
                                skip;
                            end
                        end
                        if str_char_at(source, pos) == 10 do
                            line = line + 1;
                            col = 0;
                        end
                        pos = pos + 1;
                    end
                    skip;
                end
            end
        end

        # Single-char delimiters
        if ch == 58 do # 
            vec_push(tokens, vss_token_new(VSSTokenKind::TK_COLON, ":", line, col));
            pos = pos + 1; col = col + 1; skip;
        end
        if ch == 59 do # ;
            vec_push(tokens, vss_token_new(VSSTokenKind::TK_SEMICOLON, ";", line, col));
            pos = pos + 1; col = col + 1; skip;
        end
        if ch == 44 do # ,
            vec_push(tokens, vss_token_new(VSSTokenKind::TK_COMMA, ",", line, col));
            pos = pos + 1; col = col + 1; skip;
        end
        if ch == 46 do # .
            vec_push(tokens, vss_token_new(VSSTokenKind::TK_DOT, ".", line, col));
            pos = pos + 1; col = col + 1; skip;
        end
        if ch == 38 do # &
            vec_push(tokens, vss_token_new(VSSTokenKind::TK_AMPERSAND, "&", line, col));
            pos = pos + 1; col = col + 1; skip;
        end
        if ch == 123 do # {
            vec_push(tokens, vss_token_new(VSSTokenKind::TK_LBRACE, "{", line, col));
            pos = pos + 1; col = col + 1; skip;
        end
        if ch == 125 do # }
            vec_push(tokens, vss_token_new(VSSTokenKind::TK_RBRACE, "}", line, col));
            pos = pos + 1; col = col + 1; skip;
        end
        if ch == 40 do # (
            vec_push(tokens, vss_token_new(VSSTokenKind::TK_LPAREN, "(", line, col));
            pos = pos + 1; col = col + 1; skip;
        end
        if ch == 41 do # )
            vec_push(tokens, vss_token_new(VSSTokenKind::TK_RPAREN, ")", line, col));
            pos = pos + 1; col = col + 1; skip;
        end
        if ch == 91 do # [
            vec_push(tokens, vss_token_new(VSSTokenKind::TK_LBRACKET, "[", line, col));
            pos = pos + 1; col = col + 1; skip;
        end
        if ch == 93 do # ]
            vec_push(tokens, vss_token_new(VSSTokenKind::TK_RBRACKET, "]", line, col));
            pos = pos + 1; col = col + 1; skip;
        end
        if ch == 43 do # +
            vec_push(tokens, vss_token_new(VSSTokenKind::TK_PLUS, "+", line, col));
            pos = pos + 1; col = col + 1; skip;
        end
        if ch == 42 do # *
            vec_push(tokens, vss_token_new(VSSTokenKind::TK_STAR, "*", line, col));
            pos = pos + 1; col = col + 1; skip;
        end
        if ch == 47 do # /
            vec_push(tokens, vss_token_new(VSSTokenKind::TK_SLASH, "/", line, col));
            pos = pos + 1; col = col + 1; skip;
        end
        if ch == 37 do # %
            vec_push(tokens, vss_token_new(VSSTokenKind::TK_PERCENT, "%", line, col));
            pos = pos + 1; col = col + 1; skip;
        end

        # Multi-char operators
        if ch == 62 do # >
            if pos + 1 < slen do
                if str_char_at(source, pos + 1) == 61 do # >=
                    vec_push(tokens, vss_token_new(VSSTokenKind::TK_GTE, ">=", line, col));
                    pos = pos + 2; col = col + 2; skip;
                end
            end
            vec_push(tokens, vss_token_new(VSSTokenKind::TK_GT, ">", line, col));
            pos = pos + 1; col = col + 1; skip;
        end
        if ch == 60 do # <
            if pos + 1 < slen do
                if str_char_at(source, pos + 1) == 61 do # <=
                    vec_push(tokens, vss_token_new(VSSTokenKind::TK_LTE, "<=", line, col));
                    pos = pos + 2; col = col + 2; skip;
                end
            end
            vec_push(tokens, vss_token_new(VSSTokenKind::TK_LT, "<", line, col));
            pos = pos + 1; col = col + 1; skip;
        end
        if ch == 61 do # =
            if pos + 1 < slen do
                if str_char_at(source, pos + 1) == 61 do # ==
                    vec_push(tokens, vss_token_new(VSSTokenKind::TK_EQ, "==", line, col));
                    pos = pos + 2; col = col + 2; skip;
                end
            end
        end

        # String literals
        if ch == 34 do # "
            start = pos;
            pos = pos + 1;
            when pos < slen loop
                c = str_char_at(source, pos);
                if c == 92 do # backslash escape
                    pos = pos + 2;
                    skip;
                end
                if c == 34 do
                    pos = pos + 1;
                    skip;
                end
                pos = pos + 1;
            end
            raw = str_sub(source, start, pos);
            vec_push(tokens, vss_token_new(VSSTokenKind::TK_STRING, raw, line, col));
            col = col + (pos - start);
            skip;
        end
        if ch == 39 do # '
            start = pos;
            pos = pos + 1;
            when pos < slen loop
                c = str_char_at(source, pos);
                if c == 92 do
                    pos = pos + 2;
                    skip;
                end
                if c == 39 do
                    pos = pos + 1;
                    skip;
                end
                pos = pos + 1;
            end
            raw = str_sub(source, start, pos);
            vec_push(tokens, vss_token_new(VSSTokenKind::TK_STRING, raw, line, col));
            col = col + (pos - start);
            skip;
        end

        # Color literals (#hex)
        if ch == 35 do # #
            start = pos;
            pos = pos + 1;
            when pos < slen loop
                if _is_hex(str_char_at(source, pos)) == 0 do
                    skip;
                end
                pos = pos + 1;
            end
            raw = str_sub(source, start, pos);
            vec_push(tokens, vss_token_new(VSSTokenKind::TK_COLOR, raw, line, col));
            col = col + (pos - start);
            skip;
        end

        # Negative numbers: -123, -16px
        if ch == 45 do # -
            if pos + 1 < slen do
                if _is_digit(str_char_at(source, pos + 1)) == 1 do
                    start = pos;
                    pos = pos + 1;
                    when pos < slen loop
                        c = str_char_at(source, pos);
                        if _is_digit(c) == 0 do
                            if c != 46 do # not .
                                skip;
                            end
                        end
                        pos = pos + 1;
                    end
                    # Check for unit suffix
                    unit_start = pos;
                    when pos < slen loop
                        if _is_alpha(str_char_at(source, pos)) == 0 do
                            if str_char_at(source, pos) != 37 do # not %
                                skip;
                            end
                        end
                        pos = pos + 1;
                    end
                    raw = str_sub(source, start, pos);
                    if pos > unit_start do
                        unit = str_sub(source, unit_start, pos);
                        if _is_unit_suffix(unit) == 1 do
                            vec_push(tokens, vss_token_new(VSSTokenKind::TK_UNIT_VALUE, raw, line, col));
                        eif str_eq(unit, "%") do
                            vec_push(tokens, vss_token_new(VSSTokenKind::TK_UNIT_VALUE, raw, line, col));
                        else
                            num = str_sub(source, start, unit_start);
                            vec_push(tokens, vss_token_new(VSSTokenKind::TK_NUMBER, num, line, col));
                            pos = unit_start;
                        end
                    else
                        vec_push(tokens, vss_token_new(VSSTokenKind::TK_NUMBER, raw, line, col));
                    end
                    col = col + (pos - start);
                    skip;
                end
            end
            # Standalone minus
            vec_push(tokens, vss_token_new(VSSTokenKind::TK_MINUS, "-", line, col));
            pos = pos + 1; col = col + 1; skip;
        end

        # Numbers and unit values: 16px, 0.5em, 100%
        if _is_digit(ch) == 1 do
            start = pos;
            when pos < slen loop
                c = str_char_at(source, pos);
                if _is_digit(c) == 0 do
                    if c != 46 do
                        skip;
                    end
                end
                pos = pos + 1;
            end
            # Check for unit suffix
            unit_start = pos;
            when pos < slen loop
                c = str_char_at(source, pos);
                if _is_alpha(c) == 0 do
                    if c != 37 do
                        skip;
                    end
                end
                pos = pos + 1;
            end
            raw = str_sub(source, start, pos);
            if pos > unit_start do
                unit = str_sub(source, unit_start, pos);
                if _is_unit_suffix(unit) == 1 do
                    vec_push(tokens, vss_token_new(VSSTokenKind::TK_UNIT_VALUE, raw, line, col));
                eif str_eq(unit, "%") do
                    vec_push(tokens, vss_token_new(VSSTokenKind::TK_UNIT_VALUE, raw, line, col));
                else
                    num = str_sub(source, start, unit_start);
                    vec_push(tokens, vss_token_new(VSSTokenKind::TK_NUMBER, num, line, col));
                    pos = unit_start;
                end
            else
                vec_push(tokens, vss_token_new(VSSTokenKind::TK_NUMBER, raw, line, col));
            end
            col = col + (pos - start);
            skip;
        end

        # Identifiers and keywords
        if _is_alpha(ch) == 1 do
            start = pos;
            when pos < slen loop
                if _is_alnum(str_char_at(source, pos)) == 0 do
                    skip;
                end
                pos = pos + 1;
            end
            word = str_sub(source, start, pos);
            kind = _keyword_kind(word);
            vec_push(tokens, vss_token_new(kind, word, line, col));
            col = col + (pos - start);
            skip;
        end

        # Unknown character
        raw = str_sub(source, pos, pos + 1);
        vec_push(tokens, vss_token_new(VSSTokenKind::TK_INVALID, raw, line, col));
        pos = pos + 1;
        col = col + 1;
    end

    # Append EOF
    vec_push(tokens, vss_token_new(VSSTokenKind::TK_EOF, "", line, 0));
    out tokens;
end.
export VSSTokenKind, VSSToken, vss_token_new, vss_tokenize;
