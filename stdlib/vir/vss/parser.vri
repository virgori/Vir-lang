##
 * vir/vss/parser.vri — VSS Recursive-Descent Parser
 * ====================================================
 * Parses VSSToken stream into a VSSStylesheet AST.
 *
 * Grammar (simplified BNF)
 *   stylesheet  = (import | theme | style | mixin | keyframes)*
 *   theme       = THEME IDENT COLON (declaration)* END
 *   style       = STYLE IDENT COLON (decl | nested)* END
 *   mixin       = MIXIN IDENT (LPAREN params RPAREN)? COLON (decl)* END
 *   keyframes   = KEYFRAMES IDENT COLON (step)* END
 *   declaration = IDENT COLON value (IMPORTANT)?
 *   nested      = (& selector | WHEN cond | > selector) COLON body END
 *   value       = literal | theme_ref | func_call | expr
 ##

include types;
include string;
import String, str_new, str_eq, str_concat from string;
include vec;
import Vec, vec_new, vec_push, vec_len, vec_get from vec;
include vss/ast;
import VSSValueKind, VSSValue from vss/ast;
import vss_literal, vss_theme_ref, vss_func_call, vss_value_list from vss/ast;
import VSSCondition, vss_condition_new from vss/ast;
import VSSDeclaration, vss_decl_new from vss/ast;
import VSSNestedRule, vss_nested_rule_new from vss/ast;
import VSSTheme, vss_theme_new from vss/ast;
import VSSMixin, vss_mixin_new from vss/ast;
import VSSKeyframeStep, vss_kf_step_new from vss/ast;
import VSSKeyframes, vss_keyframes_new from vss/ast;
import VSSStyleBlock, vss_style_block_new from vss/ast;
import VSSStylesheet, vss_stylesheet_new from vss/ast;
include vss/tokenizer;
import VSSTokenKind, VSSToken from vss/tokenizer;


# ═══════════════════════════════════════════════════════
# Parser State
# ═══════════════════════════════════════════════════════

entity VSSParser:
    tokens:     Vec<VSSToken>,
        pos:        int;
end.

func vss_parser_new:
    in(tokens: Vec<VSSToken>)
    out VSSParser ( tokens: tokens, pos: 0 );
end


# ═══════════════════════════════════════════════════════
# Helpers
# ═══════════════════════════════════════════════════════

func _current:
    in(p: VSSParser) -> VSSToken
    if p.pos < vec_len(p.tokens) do
        out vec_get(p.tokens, p.pos);
    end
    out VSSToken ( kind: VSSTokenKind::TK_EOF, value: "", line: 0, col: 0 );
end.

func _peek:
    in(p: VSSParser; offset: int) -> VSSToken
    idx = p.pos + offset;
    if idx < vec_len(p.tokens) do
        out vec_get(p.tokens, idx);
    end
    out VSSToken ( kind: VSSTokenKind::TK_EOF, value: "", line: 0, col: 0 );
end.

func _advance:
    in(p: VSSParser) -> (VSSParser, VSSToken)
    tok = _current(p);
    p.pos = p.pos + 1;
    out (p, tok);
end.

func _expect:
    in(p: VSSParser; kind: VSSTokenKind) -> (VSSParser, VSSToken)
    tok = _current(p);
    # In production: should report error if tok.kind != kind
    p.pos = p.pos + 1;
    out (p, tok);
end.

func _match:
    in(p: VSSParser; kind: VSSTokenKind) -> (VSSParser, int)
    tok = _current(p);
    if tok.kind == kind do
        p.pos = p.pos + 1;
        out (p, 1);
    end
    out (p, 0);
end.

func _at:
    in(p: VSSParser; kind: VSSTokenKind) -> int
    tok = _current(p);
    if tok.kind == kind do
        out 1;
    end
    out 0;
end.

func _at_block_end:
    in(p: VSSParser) -> int
    tok = _current(p);
    if tok.kind == VSSTokenKind::TK_RBRACE do
        out 1;
    end
    if tok.kind == VSSTokenKind::TK_END do
        out 1;
    end
    if tok.kind == VSSTokenKind::TK_EOF do
        out 1;
    end
    out 0;
end.

func _expect_block_open:
    in(p: VSSParser) -> VSSParser
    tok = _current(p);
    if tok.kind == VSSTokenKind::TK_LBRACE do
        p.pos = p.pos + 1;
        out p;
    end
    if tok.kind == VSSTokenKind::TK_COLON do
        p.pos = p.pos + 1;
        out p;
    end
    # Error: expected { or 
    out p;
end.

func _expect_block_close:
    in(p: VSSParser) -> VSSParser
    tok = _current(p);
    if tok.kind == VSSTokenKind::TK_RBRACE do
        p.pos = p.pos + 1;
        out p;
    end
    if tok.kind == VSSTokenKind::TK_END do
        p.pos = p.pos + 1;
        out p;
    end
    out p;
end


# ═══════════════════════════════════════════════════════
# Top-level parse
# ═══════════════════════════════════════════════════════

func vss_parse:
    in(p: VSSParser) -> (VSSParser, VSSStylesheet)
    sheet = vss_stylesheet_new();

    when _at(p, VSSTokenKind::TK_EOF) == 0 loop
        tok = _current(p);

        if tok.kind == VSSTokenKind::TK_INCLUDE do
            (p, imp) = _parse_import(p);
            vec_push(sheet.imports, imp);
            skip;
        end

        if tok.kind == VSSTokenKind::TK_THEME do
            (p, theme) = _parse_theme(p);
            vec_push(sheet.themes, theme);
            skip;
        end

        if tok.kind == VSSTokenKind::TK_STYLE do
            (p, style) = _parse_style(p);
            vec_push(sheet.styles, style);
            skip;
        end

        if tok.kind == VSSTokenKind::TK_MIXIN do
            (p, mixin) = _parse_mixin(p);
            vec_push(sheet.mixins, mixin);
            skip;
        end

        if tok.kind == VSSTokenKind::TK_KEYFRAMES do
            (p, kf) = _parse_keyframes(p);
            vec_push(sheet.keyframes, kf);
            skip;
        end

        # Skip unknown tokens
        (p, _) = _advance(p);
    end

    out (p, sheet);
end


# ═══════════════════════════════════════════════════════
# Import
# ═══════════════════════════════════════════════════════

func _parse_import:
    in(p: VSSParser) -> (VSSParser, string)
    (p, _) = _expect(p, VSSTokenKind::TK_INCLUDE);
    (p, path_tok) = _expect(p, VSSTokenKind::TK_STRING);
    (p, _) = _match(p, VSSTokenKind::TK_SEMICOLON);
    # Strip quotes from path
    out (p, path_tok.value);
end


# ═══════════════════════════════════════════════════════
# Theme
# ═══════════════════════════════════════════════════════

func _parse_name:
    in(p: VSSParser) -> (VSSParser, string)
    tok = _current(p);
    if tok.kind == VSSTokenKind::TK_STRING do
        (p, t) = _advance(p);
        out (p, t.value);
    end
    (p, t) = _expect(p, VSSTokenKind::TK_IDENT);
    out (p, t.value);
end.

func _parse_theme:
    in(p: VSSParser) -> (VSSParser, VSSTheme)
    (p, _) = _expect(p, VSSTokenKind::TK_THEME);
    (p, name) = _parse_name(p);
    p = _expect_block_open(p);

    theme = vss_theme_new(name);
    when _at_block_end(p) == 0 loop
        (p, var_tok) = _expect(p, VSSTokenKind::TK_IDENT);
        (p, _) = _expect(p, VSSTokenKind::TK_COLON);
        (p, val) = _parse_value(p);
        (p, _) = _match(p, VSSTokenKind::TK_SEMICOLON);
        d = vss_decl_new(var_tok.value, val, 0);
        vec_push(theme.variables, d);
    end

    p = _expect_block_close(p);
    out (p, theme);
end


# ═══════════════════════════════════════════════════════
# Style block
# ═══════════════════════════════════════════════════════

func _parse_style:
    in(p: VSSParser) -> (VSSParser, VSSStyleBlock)
    (p, _) = _expect(p, VSSTokenKind::TK_STYLE);
    (p, name) = _parse_name(p);
    p = _expect_block_open(p);

    style = vss_style_block_new(name);

    when _at_block_end(p) == 0 loop
        tok = _current(p);

        if tok.kind == VSSTokenKind::TK_AMPERSAND do
            (p, rule) = _parse_nested_rule(p);
            vec_push(style.nested_rules, rule);
            skip;
        end

        if tok.kind == VSSTokenKind::TK_WHEN do
            (p, rule) = _parse_when_block(p);
            vec_push(style.nested_rules, rule);
            skip;
        end

        if tok.kind == VSSTokenKind::TK_GT do
            (p, rule) = _parse_child_rule(p);
            vec_push(style.nested_rules, rule);
            skip;
        end

        if tok.kind == VSSTokenKind::TK_APPLY do
            (p, _) = _advance(p);
            (p, mname) = _parse_name(p);
            (p, _) = _match(p, VSSTokenKind::TK_SEMICOLON);
            vec_push(style.mixins_applied, mname);
            skip;
        end

        # Default: declaration
        (p, decl) = _parse_declaration(p);
        vec_push(style.declarations, decl);
    end

    p = _expect_block_close(p);
    out (p, style);
end


# ═══════════════════════════════════════════════════════
# Mixin
# ═══════════════════════════════════════════════════════

func _parse_mixin:
    in(p: VSSParser) -> (VSSParser, VSSMixin)
    (p, _) = _expect(p, VSSTokenKind::TK_MIXIN);
    (p, name) = _parse_name(p);

    mix = vss_mixin_new(name);

    # Optional parameter list
    if _at(p, VSSTokenKind::TK_LPAREN) == 1 do
        (p, _) = _advance(p);
        when _at(p, VSSTokenKind::TK_RPAREN) == 0 loop
            if _at(p, VSSTokenKind::TK_EOF) == 1 do
                skip;
            end
            (p, pname_tok) = _expect(p, VSSTokenKind::TK_IDENT);
            default_val = vss_literal("");
            (p, has_default) = _match(p, VSSTokenKind::TK_COLON);
            if has_default == 1 do
                (p, default_val) = _parse_value(p);
            end
            pd = vss_decl_new(pname_tok.value, default_val, 0);
            vec_push(mix.params, pd);
            (p, _) = _match(p, VSSTokenKind::TK_COMMA);
            (p, _) = _match(p, VSSTokenKind::TK_SEMICOLON);
        end
        (p, _) = _expect(p, VSSTokenKind::TK_RPAREN);
    end

    p = _expect_block_open(p);

    when _at_block_end(p) == 0 loop
        (p, decl) = _parse_declaration(p);
        vec_push(mix.declarations, decl);
    end

    p = _expect_block_close(p);
    out (p, mix);
end


# ═══════════════════════════════════════════════════════
# Keyframes
# ═══════════════════════════════════════════════════════

func _parse_keyframes:
    in(p: VSSParser) -> (VSSParser, VSSKeyframes)
    (p, _) = _expect(p, VSSTokenKind::TK_KEYFRAMES);
    (p, name) = _parse_name(p);
    p = _expect_block_open(p);

    kf = vss_keyframes_new(name);

    when _at_block_end(p) == 0 loop
        # Step selector: 0%, 50%, 100%, from, to
        (p, step_tok) = _advance(p);
        step_name = step_tok.value;

        # Handle NUMBER + PERCENT
        if step_tok.kind == VSSTokenKind::TK_NUMBER do
            if _at(p, VSSTokenKind::TK_PERCENT) == 1 do
                (p, _) = _advance(p);
                step_name = str_concat(step_name, "%");
            end
        end

        p = _expect_block_open(p);

        step = vss_kf_step_new(step_name);
        when _at_block_end(p) == 0 loop
            (p, decl) = _parse_declaration(p);
            vec_push(step.declarations, decl);
        end

        p = _expect_block_close(p);
        vec_push(kf.steps, step);
    end

    p = _expect_block_close(p);
    out (p, kf);
end


# ═══════════════════════════════════════════════════════
# Declaration
# ═══════════════════════════════════════════════════════

func _parse_declaration:
    in(p: VSSParser) -> (VSSParser, VSSDeclaration)
    (p, prop_tok) = _expect(p, VSSTokenKind::TK_IDENT);
    (p, _) = _expect(p, VSSTokenKind::TK_COLON);
    (p, val) = _parse_value(p);

    imp = 0;
    if _at(p, VSSTokenKind::TK_IMPORTANT) == 1 do
        (p, _) = _advance(p);
        imp = 1;
    end
    (p, _) = _match(p, VSSTokenKind::TK_SEMICOLON);

    out (p, vss_decl_new(prop_tok.value, val, imp));
end


# ═══════════════════════════════════════════════════════
# Nested rules
# ═══════════════════════════════════════════════════════

func _parse_nested_rule:
    in(p: VSSParser) -> (VSSParser, VSSNestedRule)
    (p, _) = _expect(p, VSSTokenKind::TK_AMPERSAND);
    sel = "&";

    # Parse pseudo selector  (:hover, ::before)
    if _at(p, VSSTokenKind::TK_COLON) == 1 do
        (p, _) = _advance(p);
        sel = str_concat(sel, ":");
        if _at(p, VSSTokenKind::TK_COLON) == 1 do
            (p, _) = _advance(p);
            sel = str_concat(sel, ":");
        end
        if _at(p, VSSTokenKind::TK_IDENT) == 1 do
            (p, pseudo_tok) = _advance(p);
            sel = str_concat(sel, pseudo_tok.value);
        end
    end

    p = _expect_block_open(p);
    (p, decls, nested) = _parse_rule_body(p);
    p = _expect_block_close(p);

    rule = vss_nested_rule_new(sel);
    rule.declarations = decls;
    rule.nested_rules = nested;
    out (p, rule);
end.

func _parse_when_block:
    in(p: VSSParser) -> (VSSParser, VSSNestedRule)
    (p, _) = _expect(p, VSSTokenKind::TK_WHEN);
    (p, cond) = _parse_condition(p);
    p = _expect_block_open(p);
    (p, decls, nested) = _parse_rule_body(p);
    p = _expect_block_close(p);

    rule = vss_nested_rule_new("when");
    rule.has_condition = 1;
    rule.condition = cond;
    rule.declarations = decls;
    rule.nested_rules = nested;
    out (p, rule);
end.

func _parse_child_rule:
    in(p: VSSParser) -> (VSSParser, VSSNestedRule)
    (p, _) = _expect(p, VSSTokenKind::TK_GT);
    sel = "> ";
    if _at(p, VSSTokenKind::TK_IDENT) == 1 do
        (p, child_tok) = _advance(p);
        sel = str_concat(sel, child_tok.value);
    end

    p = _expect_block_open(p);
    (p, decls, nested) = _parse_rule_body(p);
    p = _expect_block_close(p);

    rule = vss_nested_rule_new(sel);
    rule.declarations = decls;
    rule.nested_rules = nested;
    out (p, rule);
end.

func _parse_rule_body:
    in(p: VSSParser) -> (VSSParser, Vec<VSSDeclaration>, Vec<VSSNestedRule>)
    decls  = vec_new<VSSDeclaration>();
    nested = vec_new<VSSNestedRule>();

    when _at_block_end(p) == 0 loop
        tok = _current(p);

        if tok.kind == VSSTokenKind::TK_AMPERSAND do
            (p, rule) = _parse_nested_rule(p);
            vec_push(nested, rule);
            skip;
        end

        if tok.kind == VSSTokenKind::TK_WHEN do
            (p, rule) = _parse_when_block(p);
            vec_push(nested, rule);
            skip;
        end

        if tok.kind == VSSTokenKind::TK_GT do
            (p, rule) = _parse_child_rule(p);
            vec_push(nested, rule);
            skip;
        end

        (p, decl) = _parse_declaration(p);
        vec_push(decls, decl);
    end

    out (p, decls, nested);
end


# ═══════════════════════════════════════════════════════
# Condition
# ═══════════════════════════════════════════════════════

func _parse_condition:
    in(p: VSSParser) -> (VSSParser, VSSCondition)
    (p, prop_tok) = _expect(p, VSSTokenKind::TK_IDENT);
    (p, op_tok) = _advance(p);

    op_str = ">";
    if op_tok.kind == VSSTokenKind::TK_GT do
        op_str = ">";
    end
    if op_tok.kind == VSSTokenKind::TK_LT do
        op_str = "<";
    end
    if op_tok.kind == VSSTokenKind::TK_GTE do
        op_str = ">=";
    end
    if op_tok.kind == VSSTokenKind::TK_LTE do
        op_str = "<=";
    end
    if op_tok.kind == VSSTokenKind::TK_EQ do
        op_str = "==";
    end

    (p, val) = _parse_single_value(p);
    out (p, vss_condition_new(prop_tok.value, op_str, val));
end


# ═══════════════════════════════════════════════════════
# Value parsing
# ═══════════════════════════════════════════════════════

func _parse_value:
    in(p: VSSParser) -> (VSSParser, VSSValue)
    (p, first) = _parse_single_value(p);

    # Check for space-separated values
    parts = vec_new<VSSValue>();
    vec_push(parts, first);

    has_more = 1;
    when has_more == 1 loop
        tok = _current(p);
        # Stop at terminators
        if tok.kind == VSSTokenKind::TK_SEMICOLON do
            has_more = 0; skip;
        end
        if tok.kind == VSSTokenKind::TK_END do
            has_more = 0; skip;
        end
        if tok.kind == VSSTokenKind::TK_EOF do
            has_more = 0; skip;
        end
        if tok.kind == VSSTokenKind::TK_IMPORTANT do
            has_more = 0; skip;
        end
        if tok.kind == VSSTokenKind::TK_RBRACE do
            has_more = 0; skip;
        end

        # Only continue for value tokens
        is_val = 0;
        if tok.kind == VSSTokenKind::TK_NUMBER do is_val = 1; end
        if tok.kind == VSSTokenKind::TK_UNIT_VALUE do is_val = 1; end
        if tok.kind == VSSTokenKind::TK_COLOR do is_val = 1; end
        if tok.kind == VSSTokenKind::TK_IDENT do is_val = 1; end
        if tok.kind == VSSTokenKind::TK_STRING do is_val = 1; end
        if tok.kind == VSSTokenKind::TK_MINUS do is_val = 1; end

        if is_val == 0 do
            has_more = 0; skip;
        end

        # Check if IDENT followed by COLON (new declaration)
        if tok.kind == VSSTokenKind::TK_IDENT do
            next = _peek(p, 1);
            if next.kind == VSSTokenKind::TK_COLON do
                has_more = 0; skip;
            end
        end

        (p, part) = _parse_single_value(p);
        vec_push(parts, part);
    end

    if vec_len(parts) == 1 do
        out (p, vec_get(parts, 0));
    end
    out (p, vss_value_list(parts));
end.

func _parse_single_value:
    in(p: VSSParser) -> (VSSParser, VSSValue)
    tok = _current(p);

    # Theme reference: IDENT DOT IDENT (theme.primary)
    if tok.kind == VSSTokenKind::TK_IDENT do
        next = _peek(p, 1);
        if next.kind == VSSTokenKind::TK_DOT do
            (p, tname_tok) = _advance(p);
            (p, _) = _advance(p);   # skip dot
            (p, vname_tok) = _expect(p, VSSTokenKind::TK_IDENT);
            out (p, vss_theme_ref(tname_tok.value, vname_tok.value));
        end
    end
    if tok.kind == VSSTokenKind::TK_THEME do
        next = _peek(p, 1);
        if next.kind == VSSTokenKind::TK_DOT do
            (p, tname_tok) = _advance(p);
            (p, _) = _advance(p);
            (p, vname_tok) = _expect(p, VSSTokenKind::TK_IDENT);
            out (p, vss_theme_ref(tname_tok.value, vname_tok.value));
        end
    end

    # Function call: IDENT LPAREN args RPAREN
    if tok.kind == VSSTokenKind::TK_IDENT do
        next = _peek(p, 1);
        if next.kind == VSSTokenKind::TK_LPAREN do
            (p, fname_tok) = _advance(p);
            (p, _) = _advance(p);    # skip (
            fargs = vec_new<VSSValue>();
            when _at(p, VSSTokenKind::TK_RPAREN) == 0 loop
                if _at(p, VSSTokenKind::TK_EOF) == 1 do
                    skip;
                end
                (p, arg) = _parse_value(p);
                vec_push(fargs, arg);
                (p, _) = _match(p, VSSTokenKind::TK_COMMA);
            end
            (p, _) = _expect(p, VSSTokenKind::TK_RPAREN);
            out (p, vss_func_call(fname_tok.value, fargs));
        end
    end

    # Literals
    if tok.kind == VSSTokenKind::TK_COLOR do
        (p, t) = _advance(p);
        out (p, vss_literal(t.value));
    end
    if tok.kind == VSSTokenKind::TK_NUMBER do
        (p, t) = _advance(p);
        out (p, vss_literal(t.value));
    end
    if tok.kind == VSSTokenKind::TK_UNIT_VALUE do
        (p, t) = _advance(p);
        out (p, vss_literal(t.value));
    end
    if tok.kind == VSSTokenKind::TK_STRING do
        (p, t) = _advance(p);
        out (p, vss_literal(t.value));
    end
    if tok.kind == VSSTokenKind::TK_IDENT do
        (p, t) = _advance(p);
        out (p, vss_literal(t.value));
    end

    # Negative number: MINUS + NUMBER/UNIT_VALUE
    if tok.kind == VSSTokenKind::TK_MINUS do
        (p, _) = _advance(p);
        next_tok = _current(p);
        if next_tok.kind == VSSTokenKind::TK_NUMBER do
            (p, nt) = _advance(p);
            out (p, vss_literal(str_concat("-", nt.value)));
        end
        if next_tok.kind == VSSTokenKind::TK_UNIT_VALUE do
            (p, nt) = _advance(p);
            out (p, vss_literal(str_concat("-", nt.value)));
        end
        out (p, vss_literal("-"));
    end

    # Fallback: consume and produce invalid literal
    (p, t) = _advance(p);
    out (p, vss_literal(t.value));
end


export VSSParser, vss_parser_new, vss_parse;
