##
 * vir/vss/test_vss.vir — VSS Test Suite
 * ========================================
 * Tests for VSS tokenizer, parser, resolver, scoper, and emitter.
 *
 * Run:  vir jit stdlib/vir/vss/test_vss.vir
 ##

include types;
include string;
import String, str_new, str_eq, str_concat, str_contains, str_len from string;
include vec;
import Vec, vec_new, vec_push, vec_len, vec_get from vec;
include map;
import Map, map_new, map_set, map_get, map_has from map;
include test;
import TestSuite, TestReport, suite_new, suite_add, suite_run,
       report_ok, pass, fail, expect_true, expect_eq_i64, expect_eq_str from test;
include stdio;
import println from stdio;

# ─── VSS modules ──────────────────────────────────────

import VSSValueKind, VSSValue from vss/ast;
import vss_literal, vss_theme_ref, vss_func_call, vss_expr, vss_value_list from vss/ast;
import VSSCondition, vss_condition_new from vss/ast;
import VSSDeclaration, vss_decl_new from vss/ast;
import VSSNestedRule, vss_nested_rule_new from vss/ast;
import VSSTheme, vss_theme_new from vss/ast;
import VSSMixin, vss_mixin_new from vss/ast;
import VSSKeyframeStep, vss_kf_step_new from vss/ast;
import VSSKeyframes, vss_keyframes_new from vss/ast;
import VSSStyleBlock, vss_style_block_new from vss/ast;
import VSSStylesheet, vss_stylesheet_new from vss/ast;

import VSSTokenKind, VSSToken, vss_token_new, vss_tokenize from vss/tokenizer;
import VSSParser, vss_parser_new, vss_parse from vss/parser;
import VSSResolver, vss_resolver_new, vss_resolve from vss/resolver;
import VSSScoper, vss_scoper_new from vss/scoper;
import vss_scope_stylesheet, vss_get_scoped_name from vss/scoper;
import vss_emit_css from vss/emitter;


# ═══════════════════════════════════════════════════════
# 1. AST construction tests
# ═══════════════════════════════════════════════════════

func test_vss_literal_value:
    in()
    v = vss_literal(str_new("16px"));
    r1 = expect_eq_i64(v.kind, VSSValueKind.Literal);
    if r1 != pass():
        out r1;
    end
    out expect_eq_str(v.literal, str_new("16px"));
end

func test_vss_theme_ref_value:
    in()
    v = vss_theme_ref(str_new("primary_color"));
    out expect_eq_i64(v.kind, VSSValueKind.ThemeRef);
end

func test_vss_func_call_value:
    in()
    args = vec_new<VSSValue>();
    vec_push<VSSValue>(&args, vss_literal(str_new("50%")));
    v = vss_func_call(str_new("darken"), args);
    r1 = expect_eq_i64(v.kind, VSSValueKind.FuncCall);
    if r1 != pass():
        out r1;
    end
    out expect_eq_str(v.func_name, str_new("darken"));
end

func test_vss_declaration:
    in()
    d = vss_decl_new(str_new("font_size"), vss_literal(str_new("16px")), 0);
    r1 = expect_eq_str(d.property, str_new("font_size"));
    if r1 != pass():
        out r1;
    end
    out expect_eq_i64(d.important, 0);
end

func test_vss_style_block:
    in()
    decls = vec_new<VSSDeclaration>();
    vec_push<VSSDeclaration>(&decls, vss_decl_new(;
        str_new("color"), vss_literal(str_new("red")), 0;
    ));
    nested = vec_new<VSSNestedRule>();
    sb = vss_style_block_new(str_new("card"), decls, nested);
    out expect_eq_str(sb.selector, str_new("card"));
end

func test_vss_theme:
    in()
    vars = vec_new<VSSDeclaration>();
    vec_push<VSSDeclaration>(&vars, vss_decl_new(;
        str_new("primary"), vss_literal(str_new("#3498db")), 0;
    ));
    t = vss_theme_new(str_new("light"), vars);
    out expect_eq_str(t.name, str_new("light"));
end

func test_vss_mixin:
    in()
    decls = vec_new<VSSDeclaration>();
    vec_push<VSSDeclaration>(&decls, vss_decl_new(;
        str_new("display"), vss_literal(str_new("flex")), 0;
    ));
    m = vss_mixin_new(str_new("center"), vec_new<string>(), decls);
    out expect_eq_str(m.name, str_new("center"));
end

func test_vss_keyframes:
    in()
    steps = vec_new<VSSKeyframeStep>();
    decls_0 = vec_new<VSSDeclaration>();
    vec_push<VSSDeclaration>(&decls_0, vss_decl_new(;
        str_new("opacity"), vss_literal(str_new("0")), 0;
    ));
    vec_push<VSSKeyframeStep>(&steps, vss_kf_step_new(str_new("0%"), decls_0));

    decls_100 = vec_new<VSSDeclaration>();
    vec_push<VSSDeclaration>(&decls_100, vss_decl_new(;
        str_new("opacity"), vss_literal(str_new("1")), 0;
    ));
    vec_push<VSSKeyframeStep>(&steps, vss_kf_step_new(str_new("100%"), decls_100));

    kf = vss_keyframes_new(str_new("fadeIn"), steps);
    r1 = expect_eq_str(kf.name, str_new("fadeIn"));
    if r1 != pass():
        out r1;
    end
    out expect_eq_i64(vec_len<VSSKeyframeStep>(kf.steps), 2);
end

func test_vss_stylesheet:
    in()
    sheet = vss_stylesheet_new();
    out expect_eq_i64(vec_len<VSSStyleBlock>(sheet.styles), 0);
end


# ═══════════════════════════════════════════════════════
# 2. Tokenizer tests
# ═══════════════════════════════════════════════════════

func test_tokenize_empty:
    in()
    tokens = vss_tokenize(str_new(""));
    # Should have at least EOF token
    out expect_true(vec_len<VSSToken>(tokens) >= 1);
end

func test_tokenize_simple_style:
    in()
    src = str_new("style card { color: red; }");
    tokens = vss_tokenize(src);
    # Should produce: STYLE, IDENT(card), LBRACE, IDENT(color), COLON, IDENT(red), SEMICOLON, RBRACE, EOF
    out expect_true(vec_len<VSSToken>(tokens) >= 8);
end

func test_tokenize_color_hex:
    in()
    src = str_new("#ff5500");
    tokens = vss_tokenize(src);
    # Should recognize as a color token
    t0 = vec_get<VSSToken>(tokens, 0);
    out expect_eq_i64(t0.kind, VSSTokenKind.Color);
end

func test_tokenize_number_with_unit:
    in()
    src = str_new("16px 1.5em 100%");
    tokens = vss_tokenize(src);
    t0 = vec_get<VSSToken>(tokens, 0);
    out expect_eq_i64(t0.kind, VSSTokenKind.Number);
end

func test_tokenize_string_literal:
    in()
    src = str_new("\"hello world\"");
    tokens = vss_tokenize(src);
    t0 = vec_get<VSSToken>(tokens, 0);
    out expect_eq_i64(t0.kind, VSSTokenKind.StringLit);
end

func test_tokenize_keywords:
    in()
    src = str_new("style theme mixin keyframes import when");
    tokens = vss_tokenize(src);
    t0 = vec_get<VSSToken>(tokens, 0);
    t1 = vec_get<VSSToken>(tokens, 1);
    t2 = vec_get<VSSToken>(tokens, 2);
    r1 = expect_eq_i64(t0.kind, VSSTokenKind.Style);
    if r1 != pass():
        out r1;
    end
    r2 = expect_eq_i64(t1.kind, VSSTokenKind.Theme);
    if r2 != pass():
        out r2;
    end
    out expect_eq_i64(t2.kind, VSSTokenKind.Mixin);
end

func test_tokenize_comment_skip:
    in()
    src = str_new("// this is a comment\nstyle card { }");
    tokens = vss_tokenize(src);
    # Comments should be stripped; first real token is "style"
    t0 = vec_get<VSSToken>(tokens, 0);
    out expect_eq_i64(t0.kind, VSSTokenKind.Style);
end

func test_tokenize_block_comment:
    in()
    src = str_new("/* block comment */ style test { }");
    tokens = vss_tokenize(src);
    t0 = vec_get<VSSToken>(tokens, 0);
    out expect_eq_i64(t0.kind, VSSTokenKind.Style);
end

func test_tokenize_operators:
    in()
    src = str_new("{ } ( ) : ; , . & > @");
    tokens = vss_tokenize(src);
    t0 = vec_get<VSSToken>(tokens, 0);
    t1 = vec_get<VSSToken>(tokens, 1);
    r1 = expect_eq_i64(t0.kind, VSSTokenKind.LBrace);
    if r1 != pass():
        out r1;
    end
    out expect_eq_i64(t1.kind, VSSTokenKind.RBrace);
end


# ═══════════════════════════════════════════════════════
# 3. Parser tests
# ═══════════════════════════════════════════════════════

func test_parse_empty_stylesheet:
    in()
    tokens = vss_tokenize(str_new(""));
    p = vss_parser_new(tokens);
    result = vss_parse(&p);
    out expect_eq_i64(vec_len<VSSStyleBlock>(result.styles), 0);
end

func test_parse_simple_style_block:
    in()
    src = str_new("style card { color: red; font_size: 16px; }");
    tokens = vss_tokenize(src);
    p = vss_parser_new(tokens);
    sheet = vss_parse(&p);

    out expect_eq_i64(vec_len<VSSStyleBlock>(sheet.styles), 1);
end

func test_parse_style_selector:
    in()
    src = str_new("style header { margin: 0; }");
    tokens = vss_tokenize(src);
    p = vss_parser_new(tokens);
    sheet = vss_parse(&p);

    if vec_len<VSSStyleBlock>(sheet.styles) < 1:
        out fail();
    end
    blk = vec_get<VSSStyleBlock>(sheet.styles, 0);
    out expect_eq_str(blk.selector, str_new("header"));
end

func test_parse_theme:
    in()
    src = str_new("theme light { primary: #3498db; secondary: #2ecc71; }");
    tokens = vss_tokenize(src);
    p = vss_parser_new(tokens);
    sheet = vss_parse(&p);
    out expect_eq_i64(vec_len<VSSTheme>(sheet.themes), 1);
end

func test_parse_mixin:
    in()
    src = str_new("mixin center { display: flex; justify_content: center; align_items: center; }");
    tokens = vss_tokenize(src);
    p = vss_parser_new(tokens);
    sheet = vss_parse(&p);
    out expect_eq_i64(vec_len<VSSMixin>(sheet.mixins), 1);
end

func test_parse_keyframes:
    in()
    src = str_new("keyframes fadeIn { 0% { opacity: 0; } 100% { opacity: 1; } }");
    tokens = vss_tokenize(src);
    p = vss_parser_new(tokens);
    sheet = vss_parse(&p);
    out expect_eq_i64(vec_len<VSSKeyframes>(sheet.keyframes), 1);
end

func test_parse_nested_rule:
    in()
    src = str_new("style card { color: blue; &:hover { color: red; } }");
    tokens = vss_tokenize(src);
    p = vss_parser_new(tokens);
    sheet = vss_parse(&p);

    if vec_len<VSSStyleBlock>(sheet.styles) < 1:
        out fail();
    end
    blk = vec_get<VSSStyleBlock>(sheet.styles, 0);
    # Should have 1 nested rule for &:hover
    out expect_eq_i64(vec_len<VSSNestedRule>(blk.nested), 1);
end

func test_parse_important:
    in()
    src = str_new("style alert { color: red !important; }");
    tokens = vss_tokenize(src);
    p = vss_parser_new(tokens);
    sheet = vss_parse(&p);

    blk = vec_get<VSSStyleBlock>(sheet.styles, 0);
    decl = vec_get<VSSDeclaration>(blk.declarations, 0);
    out expect_eq_i64(decl.important, 1);
end

func test_parse_theme_ref_value:
    in()
    src = str_new("style card { color: @primary; }");
    tokens = vss_tokenize(src);
    p = vss_parser_new(tokens);
    sheet = vss_parse(&p);

    blk = vec_get<VSSStyleBlock>(sheet.styles, 0);
    decl = vec_get<VSSDeclaration>(blk.declarations, 0);
    out expect_eq_i64(decl.value.kind, VSSValueKind.ThemeRef);
end


# ═══════════════════════════════════════════════════════
# 4. Resolver tests
# ═══════════════════════════════════════════════════════

func test_resolve_theme_ref:
    in()
    # Build a stylesheet with a theme and a style using @primary
    sheet = vss_stylesheet_new();

    # Add theme
    tvars = vec_new<VSSDeclaration>();
    vec_push<VSSDeclaration>(&tvars, vss_decl_new(;
        str_new("primary"), vss_literal(str_new("#3498db")), 0;
    ));
    vec_push<VSSTheme>(&sheet.themes, vss_theme_new(str_new("default"), tvars));

    # Add style that references @primary
    decls = vec_new<VSSDeclaration>();
    vec_push<VSSDeclaration>(&decls, vss_decl_new(;
        str_new("color"), vss_theme_ref(str_new("primary")), 0;
    ));
    nested = vec_new<VSSNestedRule>();
    vec_push<VSSStyleBlock>(&sheet.styles, vss_style_block_new(;
        str_new("card"), decls, nested;
    ));

    resolved = vss_resolve(sheet);

    # After resolution, the theme ref should become a literal
    rblk = vec_get<VSSStyleBlock>(resolved.styles, 0);
    rdecl = vec_get<VSSDeclaration>(rblk.declarations, 0);
    out expect_eq_i64(rdecl.value.kind, VSSValueKind.Literal);
end

func test_resolve_mixin_expansion:
    in()
    sheet = vss_stylesheet_new();

    # Add mixin "center"
    mixin_decls = vec_new<VSSDeclaration>();
    vec_push<VSSDeclaration>(&mixin_decls, vss_decl_new(;
        str_new("display"), vss_literal(str_new("flex")), 0;
    ));
    vec_push<VSSDeclaration>(&mixin_decls, vss_decl_new(;
        str_new("justify_content"), vss_literal(str_new("center")), 0;
    ));
    vec_push<VSSMixin>(&sheet.mixins, vss_mixin_new(;
        str_new("center"), vec_new<string>(), mixin_decls;
    ));

    # Style block that includes @apply center
    decls = vec_new<VSSDeclaration>();
    vec_push<VSSDeclaration>(&decls, vss_decl_new(;
        str_new("@apply"), vss_literal(str_new("center")), 0;
    ));
    vec_push<VSSDeclaration>(&decls, vss_decl_new(;
        str_new("padding"), vss_literal(str_new("8px")), 0;
    ));
    nested = vec_new<VSSNestedRule>();
    vec_push<VSSStyleBlock>(&sheet.styles, vss_style_block_new(;
        str_new("nav"), decls, nested;
    ));

    resolved = vss_resolve(sheet);

    # After resolution, mixin should be expanded; @apply removed
    rblk = vec_get<VSSStyleBlock>(resolved.styles, 0);
    # Should have display + justify_content + padding = 3 decls
    out expect_true(vec_len<VSSDeclaration>(rblk.declarations) >= 3);
end


# ═══════════════════════════════════════════════════════
# 5. Scoper tests
# ═══════════════════════════════════════════════════════

func test_scoper_name_mangling:
    in()
    sc = vss_scoper_new(str_new("app"));
    scoped = vss_get_scoped_name(&sc, str_new("card"));
    # Should be "card_XXXX" where XXXX is a 4-char hex hash
    out expect_true(str_len(scoped) > str_len(str_new("card")));
end

func test_scoper_deterministic:
    in()
    sc1 = vss_scoper_new(str_new("app"));
    sc2 = vss_scoper_new(str_new("app"));
    name1 = vss_get_scoped_name(&sc1, str_new("header"));
    name2 = vss_get_scoped_name(&sc2, str_new("header"));
    # Same prefix + same name → same scoped name
    out expect_eq_str(name1, name2);
end

func test_scoper_different_prefix:
    in()
    sc1 = vss_scoper_new(str_new("app"));
    sc2 = vss_scoper_new(str_new("widget"));
    name1 = vss_get_scoped_name(&sc1, str_new("card"));
    name2 = vss_get_scoped_name(&sc2, str_new("card"));
    # Different prefix → different scoped name
    if str_eq(name1, name2):
        out fail();
    end
    out pass();
end

func test_scope_stylesheet:
    in()
    sheet = vss_stylesheet_new();
    decls = vec_new<VSSDeclaration>();
    vec_push<VSSDeclaration>(&decls, vss_decl_new(;
        str_new("color"), vss_literal(str_new("blue")), 0;
    ));
    nested = vec_new<VSSNestedRule>();
    vec_push<VSSStyleBlock>(&sheet.styles, vss_style_block_new(;
        str_new("card"), decls, nested;
    ));

    sc = vss_scoper_new(str_new("my_comp"));
    scoped = vss_scope_stylesheet(&sc, sheet);

    blk = vec_get<VSSStyleBlock>(scoped.styles, 0);
    # Selector should now be scoped (not just "card")
    if str_eq(blk.selector, str_new("card")):
        out fail();
    end
    out pass();
end


# ═══════════════════════════════════════════════════════
# 6. Emitter tests
# ═══════════════════════════════════════════════════════

func test_emit_simple_style:
    in()
    sheet = vss_stylesheet_new();
    decls = vec_new<VSSDeclaration>();
    vec_push<VSSDeclaration>(&decls, vss_decl_new(;
        str_new("color"), vss_literal(str_new("red")), 0;
    ));
    vec_push<VSSDeclaration>(&decls, vss_decl_new(;
        str_new("font_size"), vss_literal(str_new("16px")), 0;
    ));
    nested = vec_new<VSSNestedRule>();
    vec_push<VSSStyleBlock>(&sheet.styles, vss_style_block_new(;
        str_new("card"), decls, nested;
    ));

    sc = vss_scoper_new(str_new("test"));
    css = vss_emit_css(sc, sheet);

    # Should contain "color: red"
    r1 = expect_true(str_contains(css, str_new("color: red")));
    if r1 != pass():
        out r1;
    end
    # font_size → font-size (underscore to hyphen)
    out expect_true(str_contains(css, str_new("font-size: 16px")));
end

func test_emit_important:
    in()
    sheet = vss_stylesheet_new();
    decls = vec_new<VSSDeclaration>();
    vec_push<VSSDeclaration>(&decls, vss_decl_new(;
        str_new("color"), vss_literal(str_new("red")), 1;
    ));
    nested = vec_new<VSSNestedRule>();
    vec_push<VSSStyleBlock>(&sheet.styles, vss_style_block_new(;
        str_new("alert"), decls, nested;
    ));

    sc = vss_scoper_new(str_new("test"));
    css = vss_emit_css(sc, sheet);
    out expect_true(str_contains(css, str_new("!important")));
end

func test_emit_keyframes:
    in()
    sheet = vss_stylesheet_new();
    steps = vec_new<VSSKeyframeStep>();

    decls_0 = vec_new<VSSDeclaration>();
    vec_push<VSSDeclaration>(&decls_0, vss_decl_new(;
        str_new("opacity"), vss_literal(str_new("0")), 0;
    ));
    vec_push<VSSKeyframeStep>(&steps, vss_kf_step_new(str_new("0%"), decls_0));

    decls_100 = vec_new<VSSDeclaration>();
    vec_push<VSSDeclaration>(&decls_100, vss_decl_new(;
        str_new("opacity"), vss_literal(str_new("1")), 0;
    ));
    vec_push<VSSKeyframeStep>(&steps, vss_kf_step_new(str_new("100%"), decls_100));

    vec_push<VSSKeyframes>(&sheet.keyframes, vss_keyframes_new(str_new("fadeIn"), steps));

    sc = vss_scoper_new(str_new("test"));
    css = vss_emit_css(sc, sheet);
    r1 = expect_true(str_contains(css, str_new("@keyframes")));
    if r1 != pass():
        out r1;
    end
    out expect_true(str_contains(css, str_new("fadeIn")));
end

func test_emit_full_pipeline:
    in()
    # Parse → Resolve → Scope → Emit
    src = str_new("theme default { primary: #3498db; } style card { color: @primary; padding: 8px; }");
    tokens = vss_tokenize(src);
    p = vss_parser_new(tokens);
    sheet = vss_parse(&p);

    # Resolve
    resolved = vss_resolve(sheet);

    # Scope
    sc = vss_scoper_new(str_new("app"));
    scoped = vss_scope_stylesheet(&sc, resolved);

    # Emit
    css = vss_emit_css(sc, scoped);

    # Should contain resolved color value
    r1 = expect_true(str_contains(css, str_new("#3498db")));
    if r1 != pass():
        out r1;
    end
    # Should contain padding
    out expect_true(str_contains(css, str_new("padding: 8px")));
end


# ═══════════════════════════════════════════════════════
# Main — run all suites
# ═══════════════════════════════════════════════════════

func main:
    in()
    # Suite 1: AST
    s1 = suite_new(str_new("VSS AST"));
    suite_add(&s1, str_new("literal value"),   test_vss_literal_value);
    suite_add(&s1, str_new("theme ref value"), test_vss_theme_ref_value);
    suite_add(&s1, str_new("func call value"), test_vss_func_call_value);
    suite_add(&s1, str_new("declaration"),     test_vss_declaration);
    suite_add(&s1, str_new("style block"),     test_vss_style_block);
    suite_add(&s1, str_new("theme"),           test_vss_theme);
    suite_add(&s1, str_new("mixin"),           test_vss_mixin);
    suite_add(&s1, str_new("keyframes"),       test_vss_keyframes);
    suite_add(&s1, str_new("stylesheet"),      test_vss_stylesheet);
    r1 = suite_run(&s1);

    # Suite 2: Tokenizer
    s2 = suite_new(str_new("VSS Tokenizer"));
    suite_add(&s2, str_new("tokenize empty"),     test_tokenize_empty);
    suite_add(&s2, str_new("tokenize style"),     test_tokenize_simple_style);
    suite_add(&s2, str_new("tokenize hex color"), test_tokenize_color_hex);
    suite_add(&s2, str_new("tokenize number+unit"), test_tokenize_number_with_unit);
    suite_add(&s2, str_new("tokenize string"),    test_tokenize_string_literal);
    suite_add(&s2, str_new("tokenize keywords"),  test_tokenize_keywords);
    suite_add(&s2, str_new("skip line comment"),  test_tokenize_comment_skip);
    suite_add(&s2, str_new("skip block comment"), test_tokenize_block_comment);
    suite_add(&s2, str_new("tokenize operators"), test_tokenize_operators);
    r2 = suite_run(&s2);

    # Suite 3: Parser
    s3 = suite_new(str_new("VSS Parser"));
    suite_add(&s3, str_new("parse empty"),       test_parse_empty_stylesheet);
    suite_add(&s3, str_new("parse style block"), test_parse_simple_style_block);
    suite_add(&s3, str_new("parse selector"),    test_parse_style_selector);
    suite_add(&s3, str_new("parse theme"),       test_parse_theme);
    suite_add(&s3, str_new("parse mixin"),       test_parse_mixin);
    suite_add(&s3, str_new("parse keyframes"),   test_parse_keyframes);
    suite_add(&s3, str_new("parse nested rule"), test_parse_nested_rule);
    suite_add(&s3, str_new("parse !important"),  test_parse_important);
    suite_add(&s3, str_new("parse @theme ref"),  test_parse_theme_ref_value);
    r3 = suite_run(&s3);

    # Suite 4: Resolver
    s4 = suite_new(str_new("VSS Resolver"));
    suite_add(&s4, str_new("resolve theme ref"),     test_resolve_theme_ref);
    suite_add(&s4, str_new("resolve mixin expansion"), test_resolve_mixin_expansion);
    r4 = suite_run(&s4);

    # Suite 5: Scoper
    s5 = suite_new(str_new("VSS Scoper"));
    suite_add(&s5, str_new("name mangling"),        test_scoper_name_mangling);
    suite_add(&s5, str_new("deterministic hash"),   test_scoper_deterministic);
    suite_add(&s5, str_new("different prefix"),     test_scoper_different_prefix);
    suite_add(&s5, str_new("scope stylesheet"),     test_scope_stylesheet);
    r5 = suite_run(&s5);

    # Suite 6: Emitter
    s6 = suite_new(str_new("VSS Emitter"));
    suite_add(&s6, str_new("emit simple style"),   test_emit_simple_style);
    suite_add(&s6, str_new("emit !important"),     test_emit_important);
    suite_add(&s6, str_new("emit keyframes"),      test_emit_keyframes);
    suite_add(&s6, str_new("emit full pipeline"),  test_emit_full_pipeline);
    r6 = suite_run(&s6);

    # Final summary
    println(str_new(""));
    println(str_new("═══════════════════════════════════"));
    total_ok = report_ok(r1) and report_ok(r2) and report_ok(r3)
               and report_ok(r4) and report_ok(r5) and report_ok(r6);
    if total_ok:
        println(str_new("✓ All VSS tests passed!"));
    else:
        println(str_new("✗ Some VSS tests FAILED."));
    end
end
