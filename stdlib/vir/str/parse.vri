##
 * vir/str/parse.vri — Strict string → Result parsing (registry parse.md)
 * ========================================================================
 * Soft ABI: scan NUL C-string via `as ptr` (same family as types.parse_int).
 ##

include types
include result
import Result, Ok, Err from result

const PARSE_INT64_MAX: 9223372036854775807

func _parseStrLen(s: string) -> int:
    data = (s as ptr) as int
    if data == 0 do out 0 end
    n = 0
    when native_read_u8(data, n) != 0 loop
        n = n + 1
    end
    out n
end.

func _parseIntFail():
    out Err("ParseIntError")
end.

func _digitValue(c: int) -> int:
    if c >= 48 and c <= 57 do out c - 48 end
    if c >= 65 and c <= 70 do out c - 65 + 10 end
    if c >= 97 and c <= 102 do out c - 97 + 10 end
    out -1
end.

func _parseIntBody(s: string, base: int, allow_prefix: bool):
    data = (s as ptr) as int
    n = 0
    if data != 0 do
        when native_read_u8(data, n) != 0 loop
            n = n + 1
        end
    end
    if n == 0 do out _parseIntFail() end

    i = 0
    neg = 0
    c0 = native_read_u8(data, 0)
    if c0 == 43 do
        i = 1
    eif c0 == 45 do
        neg = 1
        i = 1
    end
    if i >= n do out _parseIntFail() end

    if allow_prefix do
        if base == 16 & i + 1 < n do
            c1 = native_read_u8(data, i)
            c2 = native_read_u8(data, i + 1)
            if c1 == 48 & (c2 == 120 or c2 == 88) do
                i = i + 2
            end
        end
        if base == 2 & i + 1 < n do
            c1 = native_read_u8(data, i)
            c2 = native_read_u8(data, i + 1)
            if c1 == 48 & (c2 == 98 or c2 == 66) do
                i = i + 2
            end
        end
        if base == 8 & i + 1 < n do
            c1 = native_read_u8(data, i)
            c2 = native_read_u8(data, i + 1)
            if c1 == 48 & (c2 == 111 or c2 == 79) do
                i = i + 2
            end
        end
    end

    if base == 10 & i + 1 < n do
        c1 = native_read_u8(data, i)
        c2 = native_read_u8(data, i + 1)
        if c1 == 48 & (c2 == 120 or c2 == 88 or c2 == 98 or c2 == 66 or c2 == 111 or c2 == 79) do
            out _parseIntFail()
        end
    end

    if i >= n do out _parseIntFail() end

    if base == 10 do
        val = 0
        started = false
        when i < n loop
            c = native_read_u8(data, i)
            if c < 48 or c > 57 do out _parseIntFail() end
            d = c - 48
            if val > 922337203685477580 do out _parseIntFail() end
            if val == 922337203685477580 do
                if neg == 1 & d == 8 do
                    if i + 1 != n do out _parseIntFail() end
                    out Ok(0 - 9223372036854775807 - 1)
                end
                if neg == 0 & d > 7 do out _parseIntFail() end
                if neg == 1 & d > 8 do out _parseIntFail() end
            end
            val = val * 10 + d
            started = true
            i = i + 1
        end
        if started == false do out _parseIntFail() end
        if neg == 1 do out Ok(0 - val) end
        out Ok(val)
    end

    val = 0
    started = false
    when i < n loop
        c = native_read_u8(data, i)
        d = _digitValue(c)
        if d < 0 or d >= base do out _parseIntFail() end
        if val > PARSE_INT64_MAX / base do out _parseIntFail() end
        next = val * base + d
        if next < val do out _parseIntFail() end
        val = next
        started = true
        i = i + 1
    end
    if started == false do out _parseIntFail() end
    if neg == 1 do
        if val > PARSE_INT64_MAX do out _parseIntFail() end
        out Ok(0 - val)
    end
    if val > PARSE_INT64_MAX do out _parseIntFail() end
    out Ok(val)
end.

func _parseIntRadixImpl(s: string, base: int):
    if base == 2 or base == 8 or base == 10 or base == 16 do
        out _parseIntBody(s, base, true)
    end
    panic("parse.intRadix: base must be 2, 8, 10, or 16")
end.

entity ParseNamespace:
    method int(s: string):
        out _parseIntBody(s, 10, false)
    end.

    method intRadix(s: string, base: int):
        out _parseIntRadixImpl(s, base)
    end.
end.

var parse: ParseNamespace

export ParseNamespace, parse
