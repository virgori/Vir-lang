##
 * vir/str/collation.vri — Unicode Collation (UCA)
 * ==================================================
 * Inspired by: Unicode Collation Algorithm (UTS #10)
 *
 * DUCET-style sort key generation, collation levels
 * (primary/secondary/tertiary), locale-aware sort.
 ##

include types;
include vec;
import Vec, vec_new, vec_push, vec_len, vec_get from vec;
include str;
import StringBuilder, sb_new, sb_append_byte, sb_build, sb_free from str;
include map;
import Map, map_new, map_insert, map_get from map;
include option;
import Option, Some, None from option;

# ═══════════════════════════════════════════════════════
# Collation levels
# ═══════════════════════════════════════════════════════

const COLLATION_PRIMARY    = 1;   # base character
const COLLATION_SECONDARY  = 2;   # accents/diacritics
const COLLATION_TERTIARY   = 3;   # case

const COLLATION_LEVEL_SEP  = 0;   # separator between levels in sort key

# ═══════════════════════════════════════════════════════
# Collation element
# ═══════════════════════════════════════════════════════

entity CollationElement:
    primary:   int;
    secondary: int;
    tertiary:  int;
end

entity CollationTable:
    elements: Map;  # Map<int, CollationElement> codepoint → weights
end

# ═══════════════════════════════════════════════════════
# Default table (basic Latin subset of DUCET)
# ═══════════════════════════════════════════════════════

func collation_default_table:
    in()
    t = CollationTable { elements: map_new() };

    # Space/punct → low primary
    _ct_add(t, 32, 100, 20, 2);    # space
    _ct_add(t, 45, 110, 20, 2);    # -
    _ct_add(t, 46, 111, 20, 2);    # .

    # Digits 0-9 → primary 200+
    i = 0;
    when i < 10 loop
        _ct_add(t, 48 + i, 200 + i, 20, 2);
        i = i + 1;
    end

    # Uppercase A-Z → primary 300+, tertiary=8 (upper)
    i = 0;
    when i < 26 loop
        _ct_add(t, 65 + i, 300 + i, 20, 8);
        i = i + 1;
    end

    # Lowercase a-z → same primary, tertiary=2 (lower)
    i = 0;
    when i < 26 loop
        _ct_add(t, 97 + i, 300 + i, 20, 2);
        i = i + 1;
    end

    # Common accented chars (secondary weight differs)
    _ct_add(t, 224, 300, 32, 2);  # à
    _ct_add(t, 225, 300, 34, 2);  # á
    _ct_add(t, 226, 300, 36, 2);  # â
    _ct_add(t, 228, 300, 40, 2);  # ä
    _ct_add(t, 233, 304, 34, 2);  # é
    _ct_add(t, 234, 304, 36, 2);  # ê
    _ct_add(t, 241, 313, 38, 2);  # ñ
    _ct_add(t, 246, 314, 40, 2);  # ö
    _ct_add(t, 252, 320, 40, 2);  # ü

    out t;
end

func _ct_add:
    in(t: CollationTable; cp: int; p: int; s: int; ter: int)
    elem = CollationElement { primary: p, secondary: s, tertiary: ter };
    map_insert(t.elements, cp, elem);
end

# ═══════════════════════════════════════════════════════
# Generate sort key from string
# ═══════════════════════════════════════════════════════

func collation_sort_key:
    in(table: CollationTable; s: string)
    key = vec_new();
    n = str_len(s);

    # Collect primaries
    i = 0;
    when i < n loop
        cp = str_byte_at(s, i);
        elem = map_get(table.elements, cp);
        if is_some(elem):
            e = unwrap(elem);
            if e.primary > 0:
                vec_push(key, e.primary);
            end
        else:
            # Unknown char → use codepoint as primary
            vec_push(key, 0x8000 + cp);
        end
        i = i + 1;
    end

    # Level separator
    vec_push(key, COLLATION_LEVEL_SEP);

    # Collect secondaries
    i = 0;
    when i < n loop
        cp = str_byte_at(s, i);
        elem = map_get(table.elements, cp);
        if is_some(elem):
            e = unwrap(elem);
            if e.secondary > 0:
                vec_push(key, e.secondary);
            end
        end
        i = i + 1;
    end

    # Level separator
    vec_push(key, COLLATION_LEVEL_SEP);

    # Collect tertiaries
    i = 0;
    when i < n loop
        cp = str_byte_at(s, i);
        elem = map_get(table.elements, cp);
        if is_some(elem):
            e = unwrap(elem);
            vec_push(key, e.tertiary);
        end
        i = i + 1;
    end

    out key;
end

# ═══════════════════════════════════════════════════════
# Compare two sort keys
# ═══════════════════════════════════════════════════════

func collation_compare_keys:
    in(a: Vec; b: Vec)
    la = vec_len(a);
    lb = vec_len(b);
    min_len = la;
    if lb < min_len:
        min_len = lb;
    end
    i = 0;
    when i < min_len loop
        va = vec_get(a, i);
        vb = vec_get(b, i);
        if va < vb:
            out -1;
        end
        if va > vb:
            out 1;
        end
        i = i + 1;
    end
    if la < lb:
        out -1;
    end
    if la > lb:
        out 1;
    end
    out 0;
end

# ═══════════════════════════════════════════════════════
# High-level compare
# ═══════════════════════════════════════════════════════

func collation_compare:
    in(table: CollationTable; a: string; b: string)
    ka = collation_sort_key(table, a);
    kb = collation_sort_key(table, b);
    out collation_compare_keys(ka, kb);
end

# ═══════════════════════════════════════════════════════
# Case-insensitive compare (primary level only)
# ═══════════════════════════════════════════════════════

func collation_compare_ci:
    in(table: CollationTable; a: string; b: string)
    na = str_len(a);
    nb = str_len(b);
    min_len = na;
    if nb < min_len:
        min_len = nb;
    end
    i = 0;
    when i < min_len loop
        cpa = str_byte_at(a, i);
        cpb = str_byte_at(b, i);
        ea = map_get(table.elements, cpa);
        eb = map_get(table.elements, cpb);
        pa = cpa;
        pb = cpb;
        if is_some(ea):
            pa = unwrap(ea).primary;
        end
        if is_some(eb):
            pb = unwrap(eb).primary;
        end
        if pa < pb:
            out -1;
        end
        if pa > pb:
            out 1;
        end
        i = i + 1;
    end
    if na < nb:
        out -1;
    end
    if na > nb:
        out 1;
    end
    out 0;
end
