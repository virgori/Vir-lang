##
 * vir/str/grapheme.vri — Grapheme Cluster Segmentation
 * ======================================================
 * Inspired by: UAX #29 — Unicode Text Segmentation
 *
 * Grapheme cluster boundary detection, UTF-8 codepoint
 * decoding, grapheme iteration, grapheme count.
 ##

include types;
include vec;
import Vec, vec_new, vec_push, vec_len, vec_get from vec;
include option;
import Option, Some, None from option;
include str;

# ═══════════════════════════════════════════════════════
# Grapheme break properties (simplified UAX #29)
# ═══════════════════════════════════════════════════════

const GBP_OTHER       = 0;
const GBP_CR          = 1;
const GBP_LF          = 2;
const GBP_CONTROL     = 3;
const GBP_EXTEND      = 4;   # combining marks
const GBP_ZWJ         = 5;   # U+200D
const GBP_REGIONAL    = 6;   # regional indicators
const GBP_PREPEND     = 7;
const GBP_SPACING_MARK = 8;
const GBP_HANGUL_L    = 9;
const GBP_HANGUL_V    = 10;
const GBP_HANGUL_T    = 11;
const GBP_HANGUL_LV   = 12;
const GBP_HANGUL_LVT  = 13;

# ═══════════════════════════════════════════════════════
# UTF-8 codepoint decoding
# ═══════════════════════════════════════════════════════

entity Codepoint:
    value:     int;
    byte_len:  int;    # number of bytes consumed
end

func utf8_decode:
    in(data: string; offset: int)
    b0 = str_byte_at(data, offset);
    if b0 < 128:
        out Codepoint { value: b0, byte_len: 1 };
    end
    if b0 < 224:
        b1 = str_byte_at(data, offset + 1);
        cp = (b0 - 192) * 64 + (b1 - 128);
        out Codepoint { value: cp, byte_len: 2 };
    end
    if b0 < 240:
        b1 = str_byte_at(data, offset + 1);
        b2 = str_byte_at(data, offset + 2);
        cp = (b0 - 224) * 4096 + (b1 - 128) * 64 + (b2 - 128);
        out Codepoint { value: cp, byte_len: 3 };
    end
    b1 = str_byte_at(data, offset + 1);
    b2 = str_byte_at(data, offset + 2);
    b3 = str_byte_at(data, offset + 3);
    cp = (b0 - 240) * 262144 + (b1 - 128) * 4096 + (b2 - 128) * 64 + (b3 - 128);
    out Codepoint { value: cp, byte_len: 4 };
end

# ═══════════════════════════════════════════════════════
# Grapheme break property lookup (simplified)
# ═══════════════════════════════════════════════════════

func grapheme_break_property:
    in(cp: int)
    if cp == 13:
        out GBP_CR;
    end
    if cp == 10:
        out GBP_LF;
    end
    if cp < 32 || (cp >= 127 && cp < 160):
        out GBP_CONTROL;
    end
    if cp == 0x200D:
        out GBP_ZWJ;
    end
    # Combining marks (basic ranges)
    if cp >= 0x0300 && cp <= 0x036F:
        out GBP_EXTEND;
    end
    if cp >= 0x1AB0 && cp <= 0x1AFF:
        out GBP_EXTEND;
    end
    if cp >= 0x20D0 && cp <= 0x20FF:
        out GBP_EXTEND;
    end
    if cp >= 0xFE20 && cp <= 0xFE2F:
        out GBP_EXTEND;
    end
    # Variation selectors
    if cp >= 0xFE00 && cp <= 0xFE0F:
        out GBP_EXTEND;
    end
    if cp >= 0xE0100 && cp <= 0xE01EF:
        out GBP_EXTEND;
    end
    # Regional indicators
    if cp >= 0x1F1E6 && cp <= 0x1F1FF:
        out GBP_REGIONAL;
    end
    # Hangul Jamo
    if cp >= 0x1100 && cp <= 0x115F:
        out GBP_HANGUL_L;
    end
    if cp >= 0x1160 && cp <= 0x11A7:
        out GBP_HANGUL_V;
    end
    if cp >= 0x11A8 && cp <= 0x11FF:
        out GBP_HANGUL_T;
    end
    # SpacingMark (common Thai, Devanagari, etc.)
    if cp >= 0x0E30 && cp <= 0x0E3A:
        out GBP_SPACING_MARK;
    end
    out GBP_OTHER;
end

# ═══════════════════════════════════════════════════════
# Grapheme cluster boundary detection (UAX #29 rules)
# ═══════════════════════════════════════════════════════

func _is_grapheme_boundary:
    in(prev_prop: int; curr_prop: int; ri_count: int)
    # GB3: CR × LF
    if prev_prop == GBP_CR && curr_prop == GBP_LF:
        out false;
    end
    # GB4: (Control|CR|LF) ÷
    if prev_prop == GBP_CONTROL || prev_prop == GBP_CR || prev_prop == GBP_LF:
        out true;
    end
    # GB5: ÷ (Control|CR|LF)
    if curr_prop == GBP_CONTROL || curr_prop == GBP_CR || curr_prop == GBP_LF:
        out true;
    end
    # GB6-8: Hangul syllable rules
    if prev_prop == GBP_HANGUL_L:
        if curr_prop == GBP_HANGUL_L || curr_prop == GBP_HANGUL_V ||
           curr_prop == GBP_HANGUL_LV || curr_prop == GBP_HANGUL_LVT:
            out false;
        end
    end
    if prev_prop == GBP_HANGUL_LV || prev_prop == GBP_HANGUL_V:
        if curr_prop == GBP_HANGUL_V || curr_prop == GBP_HANGUL_T:
            out false;
        end
    end
    if prev_prop == GBP_HANGUL_LVT || prev_prop == GBP_HANGUL_T:
        if curr_prop == GBP_HANGUL_T:
            out false;
        end
    end
    # GB9: × (Extend | ZWJ)
    if curr_prop == GBP_EXTEND || curr_prop == GBP_ZWJ:
        out false;
    end
    # GB9a: × SpacingMark
    if curr_prop == GBP_SPACING_MARK:
        out false;
    end
    # GB9b: Prepend ×
    if prev_prop == GBP_PREPEND:
        out false;
    end
    # GB12/13: Regional indicator pairs
    if prev_prop == GBP_REGIONAL && curr_prop == GBP_REGIONAL:
        if ri_count % 2 == 1:
            out false;
        end
    end
    # GB999: ÷ Any
    out true;
end

# ═══════════════════════════════════════════════════════
# Grapheme cluster iteration
# ═══════════════════════════════════════════════════════

entity GraphemeCluster:
    start:    int;   # byte offset in source
    length:   int;   # byte length
    text:     string;
end

func grapheme_clusters:
    in(s: string)
    clusters = vec_new();
    n = str_len(s);
    if n == 0:
        out clusters;
    end

    pos = 0;
    cluster_start = 0;
    prev_prop = -1;
    ri_count = 0;

    when pos < n loop
        cp = utf8_decode(s, pos);
        prop = grapheme_break_property(cp.value);

        if prev_prop >= 0:
            if _is_grapheme_boundary(prev_prop, prop, ri_count):
                # Emit previous cluster
                gc = GraphemeCluster {
                    start: cluster_start,
                    length: pos - cluster_start,
                    text: str_slice(s, cluster_start, pos)
                };
                vec_push(clusters, gc);
                cluster_start = pos;
                ri_count = 0;
            end
        end

        if prop == GBP_REGIONAL:
            ri_count = ri_count + 1;
        end

        prev_prop = prop;
        pos = pos + cp.byte_len;
    end

    # Last cluster
    if cluster_start < n:
        gc = GraphemeCluster {
            start: cluster_start,
            length: n - cluster_start,
            text: str_slice(s, cluster_start, n)
        };
        vec_push(clusters, gc);
    end

    out clusters;
end

# ═══════════════════════════════════════════════════════
# Convenience functions
# ═══════════════════════════════════════════════════════

func grapheme_count:
    in(s: string)
    out vec_len(grapheme_clusters(s));
end

func grapheme_at:
    in(s: string; idx: int)
    clusters = grapheme_clusters(s);
    if idx >= 0 && idx < vec_len(clusters):
        out Some(vec_get(clusters, idx));
    end
    out None;
end

func grapheme_reverse:
    in(s: string)
    clusters = grapheme_clusters(s);
    sb = sb_new();
    i = vec_len(clusters) - 1;
    when i >= 0 loop
        gc = vec_get(clusters, i);
        sb_append(sb, gc.text);
        i = i - 1;
    end
    out sb_build(sb);
end
