# vir/str/encode.vri — UTF-8 / UTF-16LE / UTF-32LE bridges (registry encode.md)

include types
include result
import Result, Ok, Err from result
include unicode
import utf8_decode, utf8_encode, utf8_encode_len, utf8_is_valid, is_valid_codepoint, is_surrogate from unicode
include alloc
import alloc, free from alloc
include buffer
import Buffer, buffer_new, buffer_push, buffer_push_u16, buffer_push_u32, buffer_free from buffer

func utf8_to_utf16(src: ptr, byte_len: int) -> Result of (Buffer):
    if !utf8_is_valid(src, byte_len) do out Err(str_new("invalid UTF-8")) end
    buf = buffer_new(256)
    i = 0
    
    when i < byte_len loop
        cp_len = 0
        cp = utf8_decode(src, i, cp_len)
        
        if !is_valid_codepoint(cp) do
            buffer_free(buf)
            out Err(str_new("invalid codepoint in UTF-8"))
        end
        
        if cp <= 0xFFFF do
            # BMP: single u16
            buffer_push_u16(buf, cp)
        else
            # Supplementary: surrogate pair
            adjusted = cp - 0x10000
            high = 0xD800 + (adjusted  shr  10)
            low = 0xDC00 + (adjusted & 0x3FF)
            buffer_push_u16(buf, high)
            buffer_push_u16(buf, low)
        end
        
        i = i + cp_len
    end
    
    out Ok(buf)
end.
# ═══════════════════════════════════════════════════════
# UTF-16 -> UTF-8
# ═══════════════════════════════════════════════════════

func utf16_to_utf8(src: ptr, unit_count: int) -> Result of (Buffer):
    buf = buffer_new(256)
    i = 0
    var tmp: [int; 4] = [0, 0, 0, 0]
    
    when i < unit_count loop
        byte_offset = i * 2
        u = native_read_u8(src, byte_offset) bit_or
            (native_read_u8(src, byte_offset + 1) shl 8)
        cp = 0
        
        if u >= 0xD800 and u <= 0xDBFF do
            # High surrogate — cần low surrogate
            if i + 1 >= unit_count do
                buffer_free(buf)
                out Err(str_new("truncated surrogate pair"))
            end
            low_offset = (i + 1) * 2
            low = native_read_u8(src, low_offset) bit_or
                (native_read_u8(src, low_offset + 1) shl 8)
            if !(low >= 0xDC00 and low <= 0xDFFF) do
                buffer_free(buf)
                out Err(str_new("invalid low surrogate"))
            end
            cp = 0x10000 + ((u - 0xD800)  shl  10) + (low - 0xDC00)
            i = i + 2
        eif u >= 0xDC00 and u <= 0xDFFF do
            buffer_free(buf)
            out Err(str_new("unexpected low surrogate"))
        else
            cp = u
            i = i + 1
        end
        
        # Encode cp as UTF-8 vào buf
        enc_len = utf8_encode(cp, &tmp, 0)
        j = 0
        when j < enc_len loop
            buffer_push(buf, native_read_u8(&tmp, j))
            j = j + 1
        end
    end
    
    out Ok(buf)
end.

func utf8_to_utf32(src: ptr, byte_len: int) -> Result of (Buffer):
    if !utf8_is_valid(src, byte_len) do out Err(str_new("invalid UTF-8")) end
    buf = buffer_new(256)
    i = 0
    
    when i < byte_len loop
        cp_len = 0
        cp = utf8_decode(src, i, cp_len)
        if !is_valid_codepoint(cp) do
            buffer_free(buf)
            out Err(str_new("invalid codepoint in UTF-8"))
        end
        buffer_push_u32(buf, cp)
        i = i + cp_len
    end
    
    out Ok(buf)
end.
func utf32_to_utf8(src: ptr, count: int) -> Result of (Buffer):
    buf = buffer_new(256)
    var tmp: [int; 4] = [0, 0, 0, 0]
    i = 0
    
    when i < count loop
        byte_offset = i * 4
        cp = native_read_u8(src, byte_offset) bit_or
            (native_read_u8(src, byte_offset + 1) shl 8) bit_or
            (native_read_u8(src, byte_offset + 2) shl 16) bit_or
            (native_read_u8(src, byte_offset + 3) shl 24)
        if !is_valid_codepoint(cp) do
            buffer_free(buf)
            out Err(str_new("invalid codepoint"))
        end
        enc_len = utf8_encode(cp, &tmp, 0)
        j = 0
        when j < enc_len loop
            buffer_push(buf, native_read_u8(&tmp, j))
            j = j + 1
        end
        i = i + 1
    end
    
    out Ok(buf)
end.
# ═══════════════════════════════════════════════════════
# ASCII Conversion
# ═══════════════════════════════════════════════════════

func is_ascii_string(data: ptr, len: int):
    i = 0
    when i < len loop
        if native_read_u8(data, i) > 0x7F do out false end
        i = i + 1
    end
    out true
end.
func utf8_to_ascii_lossy(data: ptr, byte_len: int) -> Buffer:
    # Thay thế non-ASCII bytes bằng '?'
    buf = buffer_new(256)
    if !utf8_is_valid(data, byte_len) do
        buffer_push(buf, 0x3F)
        out buf
    end
    i = 0
    when i < byte_len loop
        cp_len = 0
        cp = utf8_decode(data, i, cp_len)
        if cp <= 0x7F do
            buffer_push(buf, cp)
        else
            buffer_push(buf, 0x3F)   # '?'
        end
        i = i + cp_len
    end
    out buf
end.

include slice
import Slice from slice

entity EncodeNamespace:
    method utf8ToUtf16(s: Slice) -> Result of (Buffer):
        out utf8_to_utf16(s.data, s.len)
    end.

    method utf16ToUtf8(s: Slice) -> Result of (Buffer):
        units = s.len / 2
        out utf16_to_utf8(s.data, units)
    end.

    method utf8ToUtf32(s: Slice) -> Result of (Buffer):
        out utf8_to_utf32(s.data, s.len)
    end.

    method utf32ToUtf8(s: Slice) -> Result of (Buffer):
        count = s.len / 4
        out utf32_to_utf8(s.data, count)
    end.

    method asciiLossy(s: Slice) -> Buffer:
        let result = utf8_to_ascii_lossy(s.data, s.len)
        out result
    end.
end.

var encode: EncodeNamespace

export EncodeNamespace, encode, utf8_to_utf16, utf16_to_utf8, utf8_to_utf32, utf32_to_utf8, utf8_to_ascii_lossy