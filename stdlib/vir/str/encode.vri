##
 * vir/str/encode.vri — String Encoding Conversion
 * ==================================================
 * Inspired by Python: codecs
 * Inspired by C23: <uchar.h> mbrtoc16/c32
 *
 * Chuyển đổi giữa UTF-8, UTF-16, UTF-32.
 * Vir default sử dụng UTF-8 nội bộ.
 ##

include types;
include result;
import Result, Ok, Err from result;
include unicode;
import utf8_decode, utf8_encode, utf8_encode_len, is_valid_codepoint, is_surrogate from unicode;
include alloc;
import alloc, free from alloc;
include buffer;
import Buffer, buffer_new, buffer_push_u8, buffer_push_u16, buffer_push_u32, buffer_as_slice, buffer_free from buffer;

# ═══════════════════════════════════════════════════════
# UTF-8 -> UTF-16 (Little Endian)
# ═══════════════════════════════════════════════════════

entity Utf16Result:
    data: ptr       # int array;
    len:  int     # number of int units;
end

func utf8_to_utf16:
    in(src:ptr; byte_len:int)
    buf = buffer_new();
    i = 0;
    
    when i < byte_len loop
        cp_len = 0;
        cp = utf8_decode(src, i, &cp_len);
        
        if !is_valid_codepoint(cp):
            buffer_free(&buf);
            out Err(str_new("invalid codepoint in UTF-8"));
        end
        
        if cp <= 0xFFFF:
            # BMP: single u16
            buffer_push_u16(&buf, cp);
        else
            # Supplementary: surrogate pair
            adjusted = cp - 0x10000;
            high = 0xD800 + (adjusted >> 10);
            low = 0xDC00 + (adjusted & 0x3FF);
            buffer_push_u16(&buf, high);
            buffer_push_u16(&buf, low);
        end
        
        i = i + cp_len;
    end
    
    slice = buffer_as_slice(buf);
    out Ok(Utf16Result { data = slice.data, len = buf.len / 2 });
end

# ═══════════════════════════════════════════════════════
# UTF-16 -> UTF-8
# ═══════════════════════════════════════════════════════

func utf16_to_utf8:
    in(src:ptr; unit_count:int)
    buf = buffer_new();
    i = 0;
    var tmp:byte[4];
    
    when i < unit_count loop
        u = native_load_u16(src, i);
        var cp:int;
        
        if u >= 0xD800 and u <= 0xDBFF:
            # High surrogate — cần low surrogate
            if i + 1 >= unit_count:
                buffer_free(&buf);
                out Err(str_new("truncated surrogate pair"));
            end
            low = native_load_u16(src, i + 1);
            if !(low >= 0xDC00 and low <= 0xDFFF):
                buffer_free(&buf);
                out Err(str_new("invalid low surrogate"));
            end
            cp = 0x10000 + ((u - 0xD800) << 10) + (low - 0xDC00);
            i = i + 2;
        eif u >= 0xDC00 and u <= 0xDFFF:
            buffer_free(&buf);
            out Err(str_new("unexpected low surrogate"));
        else
            cp = u;
            i = i + 1;
        end
        
        # Encode cp as UTF-8 vào buf
        enc_len = utf8_encode(cp, &tmp, 0);
        j = 0;
        when j < enc_len loop
            buffer_push_u8(&buf, tmp[j]);
            j = j + 1;
        end
    end
    
    slice = buffer_as_slice(buf);
    out Ok(Utf8Result { data = slice.data, byte_len = buf.len });
end

entity Utf8Result:
    data:     ptr;
    byte_len: int;
end

# ═══════════════════════════════════════════════════════
# UTF-8 -> UTF-32 (simplest: 1 codepoint = 1 u32)
# ═══════════════════════════════════════════════════════

entity Utf32Result:
    data: ptr       # int array;
    len:  int     # number of codepoints;
end

func utf8_to_utf32:
    in(src:ptr; byte_len:int)
    buf = buffer_new();
    i = 0;
    
    when i < byte_len loop
        cp_len = 0;
        cp = utf8_decode(src, i, &cp_len);
        buffer_push_u32(&buf, cp);
        i = i + cp_len;
    end
    
    slice = buffer_as_slice(buf);
    out Utf32Result { data = slice.data, len = buf.len / 4 };
end

func utf32_to_utf8:
    in(src:ptr; count:int)
    buf = buffer_new();
    var tmp:byte[4];
    i = 0;
    
    when i < count loop
        cp = native_load_u32(src, i);
        if !is_valid_codepoint(cp):
            buffer_free(&buf);
            out Err(str_new("invalid codepoint"));
        end
        enc_len = utf8_encode(cp, &tmp, 0);
        j = 0;
        when j < enc_len loop
            buffer_push_u8(&buf, tmp[j]);
            j = j + 1;
        end
        i = i + 1;
    end
    
    slice = buffer_as_slice(buf);
    out Ok(Utf8Result { data = slice.data, byte_len = buf.len });
end

# ═══════════════════════════════════════════════════════
# ASCII Conversion
# ═══════════════════════════════════════════════════════

func is_ascii_string:
    in(data:ptr; len:int)
    i = 0;
    when i < len loop
        if native_load_u8(data, i) > 0x7F out false end:
        i = i + 1;
    end
    out true;
end

func utf8_to_ascii_lossy:
    in(data:ptr; byte_len:int)
    # Thay thế non-ASCII bytes bằng '?'
    buf = buffer_new();
    i = 0;
    when i < byte_len loop
        cp_len = 0;
        cp = utf8_decode(data, i, &cp_len);
        if cp <= 0x7F:
            buffer_push_u8(&buf, cp);
        else
            buffer_push_u8(&buf, 0x3F)   # '?';
        end
        i = i + cp_len;
    end
    slice = buffer_as_slice(buf);
    out Utf8Result { data = slice.data, byte_len = buf.len };
end
