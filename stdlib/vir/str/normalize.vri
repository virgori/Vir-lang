##
 * vir/str/normalize.vri — Unicode Normalization (NFC/NFD)
 * ========================================================
 * Inspired by Rust: unicode-normalization crate
 * Inspired by Go: golang.org/x/text/unicode/norm
 * Inspired by Python: unicodedata.normalize
 *
 * Phase C — Tier 2: Unicode Normalization Forms.
 * Implements NFC (Canonical Decomposition + Composition) 
 * and NFD (Canonical Decomposition) for correct string
 * comparison and sorting.
 *
 * Based on Unicode Standard Annex #15.
 ##

include types;
include vec;
import Vec, vec_new, vec_push, vec_get, vec_set, vec_len from vec;
include map;
import Map, map_new, map_insert, map_get, native_hash_i64 from map;
include option;
import Option, Some, None, is_some, is_none, unwrap from option;

# ═══════════════════════════════════════════════════════
# Combining Character Class (CCC) lookup
# Common codepoints and their canonical combining classes.
# CCC = 0 means starter (base character).
# ═══════════════════════════════════════════════════════

func _eq_int:
    in(a: int; b: int)
    out a == b;
end.

func _build_ccc_table:
    in()
    t = map_new(native_hash_i64, _eq_int);
    # Combining diacritical marks (U+0300-U+036F) — common ones
    map_insert(t, 768, 230);   # U+0300 COMBINING GRAVE ACCENT
    map_insert(t, 769, 230);   # U+0301 COMBINING ACUTE ACCENT
    map_insert(t, 770, 230);   # U+0302 COMBINING CIRCUMFLEX
    map_insert(t, 771, 230);   # U+0303 COMBINING TILDE
    map_insert(t, 772, 230);   # U+0304 COMBINING MACRON
    map_insert(t, 774, 230);   # U+0306 COMBINING BREVE
    map_insert(t, 775, 230);   # U+0307 COMBINING DOT ABOVE
    map_insert(t, 776, 230);   # U+0308 COMBINING DIAERESIS
    map_insert(t, 777, 230);   # U+0309 COMBINING HOOK ABOVE
    map_insert(t, 778, 230);   # U+030A COMBINING RING ABOVE
    map_insert(t, 779, 230);   # U+030B COMBINING DOUBLE ACUTE
    map_insert(t, 780, 230);   # U+030C COMBINING CARON
    map_insert(t, 795, 232);   # U+031B COMBINING HORN
    map_insert(t, 803, 220);   # U+0323 COMBINING DOT BELOW
    map_insert(t, 804, 220);   # U+0324 COMBINING DIAERESIS BELOW
    map_insert(t, 805, 220);   # U+0325 COMBINING RING BELOW
    map_insert(t, 807, 202);   # U+0327 COMBINING CEDILLA
    map_insert(t, 808, 202);   # U+0328 COMBINING OGONEK
    map_insert(t, 813, 220);   # U+032D COMBINING CIRCUMFLEX BELOW
    map_insert(t, 814, 220);   # U+032E COMBINING BREVE BELOW
    map_insert(t, 817, 220);   # U+0331 COMBINING MACRON BELOW
    out t;
end.

func get_ccc:
    in(ccc_table: Map; codepoint: int)
    opt = map_get(ccc_table, codepoint);
    if is_some(opt) do
        out unwrap(opt);
    end
    out 0;   # starter
end

# ═══════════════════════════════════════════════════════
# Canonical Decomposition Mappings
# Maps precomposed characters to their decomposed form.
# ═══════════════════════════════════════════════════════

entity DecompMapping:
    first:  int;    # base codepoint
    second: int;    # combining codepoint (-1 if single)
end.

func _build_decomp_table:
    in()
    t = map_new(native_hash_i64, _eq_int);

    # Latin precomposed decompositions
    map_insert(t, 192, DecompMapping { first: 65, second: 768 });   # A-grave
    map_insert(t, 193, DecompMapping { first: 65, second: 769 });   # A-acute
    map_insert(t, 194, DecompMapping { first: 65, second: 770 });   # A-circumflex
    map_insert(t, 195, DecompMapping { first: 65, second: 771 });   # A-tilde
    map_insert(t, 196, DecompMapping { first: 65, second: 776 });   # A-diaeresis
    map_insert(t, 197, DecompMapping { first: 65, second: 778 });   # A-ring
    map_insert(t, 199, DecompMapping { first: 67, second: 807 });   # C-cedilla
    map_insert(t, 200, DecompMapping { first: 69, second: 768 });   # E-grave
    map_insert(t, 201, DecompMapping { first: 69, second: 769 });   # E-acute
    map_insert(t, 202, DecompMapping { first: 69, second: 770 });   # E-circumflex
    map_insert(t, 203, DecompMapping { first: 69, second: 776 });   # E-diaeresis
    map_insert(t, 204, DecompMapping { first: 73, second: 768 });   # I-grave
    map_insert(t, 205, DecompMapping { first: 73, second: 769 });   # I-acute
    map_insert(t, 206, DecompMapping { first: 73, second: 770 });   # I-circumflex
    map_insert(t, 207, DecompMapping { first: 73, second: 776 });   # I-diaeresis
    map_insert(t, 209, DecompMapping { first: 78, second: 771 });   # N-tilde
    map_insert(t, 210, DecompMapping { first: 79, second: 768 });   # O-grave
    map_insert(t, 211, DecompMapping { first: 79, second: 769 });   # O-acute
    map_insert(t, 212, DecompMapping { first: 79, second: 770 });   # O-circumflex
    map_insert(t, 213, DecompMapping { first: 79, second: 771 });   # O-tilde
    map_insert(t, 214, DecompMapping { first: 79, second: 776 });   # O-diaeresis
    map_insert(t, 217, DecompMapping { first: 85, second: 768 });   # U-grave
    map_insert(t, 218, DecompMapping { first: 85, second: 769 });   # U-acute
    map_insert(t, 219, DecompMapping { first: 85, second: 770 });   # U-circumflex
    map_insert(t, 220, DecompMapping { first: 85, second: 776 });   # U-diaeresis
    map_insert(t, 221, DecompMapping { first: 89, second: 769 });   # Y-acute

    # Lowercase
    map_insert(t, 224, DecompMapping { first: 97, second: 768 });   # a-grave
    map_insert(t, 225, DecompMapping { first: 97, second: 769 });   # a-acute
    map_insert(t, 226, DecompMapping { first: 97, second: 770 });   # a-circumflex
    map_insert(t, 227, DecompMapping { first: 97, second: 771 });   # a-tilde
    map_insert(t, 228, DecompMapping { first: 97, second: 776 });   # a-diaeresis
    map_insert(t, 229, DecompMapping { first: 97, second: 778 });   # a-ring
    map_insert(t, 231, DecompMapping { first: 99, second: 807 });   # c-cedilla
    map_insert(t, 232, DecompMapping { first: 101, second: 768 });  # e-grave
    map_insert(t, 233, DecompMapping { first: 101, second: 769 });  # e-acute
    map_insert(t, 234, DecompMapping { first: 101, second: 770 });  # e-circumflex
    map_insert(t, 235, DecompMapping { first: 101, second: 776 });  # e-diaeresis
    map_insert(t, 236, DecompMapping { first: 105, second: 768 });  # i-grave
    map_insert(t, 237, DecompMapping { first: 105, second: 769 });  # i-acute
    map_insert(t, 238, DecompMapping { first: 105, second: 770 });  # i-circumflex
    map_insert(t, 239, DecompMapping { first: 105, second: 776 });  # i-diaeresis
    map_insert(t, 241, DecompMapping { first: 110, second: 771 });  # n-tilde
    map_insert(t, 242, DecompMapping { first: 111, second: 768 });  # o-grave
    map_insert(t, 243, DecompMapping { first: 111, second: 769 });  # o-acute
    map_insert(t, 244, DecompMapping { first: 111, second: 770 });  # o-circumflex
    map_insert(t, 245, DecompMapping { first: 111, second: 771 });  # o-tilde
    map_insert(t, 246, DecompMapping { first: 111, second: 776 });  # o-diaeresis
    map_insert(t, 249, DecompMapping { first: 117, second: 768 });  # u-grave
    map_insert(t, 250, DecompMapping { first: 117, second: 769 });  # u-acute
    map_insert(t, 251, DecompMapping { first: 117, second: 770 });  # u-circumflex
    map_insert(t, 252, DecompMapping { first: 117, second: 776 });  # u-diaeresis
    map_insert(t, 253, DecompMapping { first: 121, second: 769 });  # y-acute

    # Vietnamese precomposed (important for Vir!)
    map_insert(t, 7843, DecompMapping { first: 97, second: 777 });   # ả
    map_insert(t, 7841, DecompMapping { first: 97, second: 803 });   # ạ

    out t;
end

# ═══════════════════════════════════════════════════════
# Canonical Composition Mappings (reverse of decomp)
# ═══════════════════════════════════════════════════════

entity CompKey:
    base:     int,
        combining: int;
end.

func _build_comp_table:
    in()
    t = map_new(native_hash_i64, _eq_int);
    # A + combining -> precomposed
    map_insert(t, 65 * 65536 + 768, 192);   # A + grave -> A-grave
    map_insert(t, 65 * 65536 + 769, 193);   # A + acute
    map_insert(t, 65 * 65536 + 770, 194);   # A + circumflex
    map_insert(t, 65 * 65536 + 771, 195);   # A + tilde
    map_insert(t, 65 * 65536 + 776, 196);   # A + diaeresis
    map_insert(t, 65 * 65536 + 778, 197);   # A + ring
    map_insert(t, 69 * 65536 + 768, 200);   # E + grave
    map_insert(t, 69 * 65536 + 769, 201);
    map_insert(t, 69 * 65536 + 770, 202);
    map_insert(t, 69 * 65536 + 776, 203);
    map_insert(t, 73 * 65536 + 768, 204);
    map_insert(t, 73 * 65536 + 769, 205);
    map_insert(t, 73 * 65536 + 770, 206);
    map_insert(t, 73 * 65536 + 776, 207);
    map_insert(t, 78 * 65536 + 771, 209);
    map_insert(t, 79 * 65536 + 768, 210);
    map_insert(t, 79 * 65536 + 769, 211);
    map_insert(t, 79 * 65536 + 770, 212);
    map_insert(t, 79 * 65536 + 771, 213);
    map_insert(t, 79 * 65536 + 776, 214);
    map_insert(t, 85 * 65536 + 768, 217);
    map_insert(t, 85 * 65536 + 769, 218);
    map_insert(t, 85 * 65536 + 770, 219);
    map_insert(t, 85 * 65536 + 776, 220);

    # Lowercase
    map_insert(t, 97 * 65536 + 768, 224);
    map_insert(t, 97 * 65536 + 769, 225);
    map_insert(t, 97 * 65536 + 770, 226);
    map_insert(t, 97 * 65536 + 771, 227);
    map_insert(t, 97 * 65536 + 776, 228);
    map_insert(t, 97 * 65536 + 778, 229);
    map_insert(t, 101 * 65536 + 768, 232);
    map_insert(t, 101 * 65536 + 769, 233);
    map_insert(t, 101 * 65536 + 770, 234);
    map_insert(t, 101 * 65536 + 776, 235);
    map_insert(t, 105 * 65536 + 768, 236);
    map_insert(t, 105 * 65536 + 769, 237);
    map_insert(t, 105 * 65536 + 770, 238);
    map_insert(t, 105 * 65536 + 776, 239);
    map_insert(t, 110 * 65536 + 771, 241);
    map_insert(t, 111 * 65536 + 768, 242);
    map_insert(t, 111 * 65536 + 769, 243);
    map_insert(t, 111 * 65536 + 770, 244);
    map_insert(t, 111 * 65536 + 771, 245);
    map_insert(t, 111 * 65536 + 776, 246);
    map_insert(t, 117 * 65536 + 768, 249);
    map_insert(t, 117 * 65536 + 769, 250);
    map_insert(t, 117 * 65536 + 770, 251);
    map_insert(t, 117 * 65536 + 776, 252);

    out t;
end

# ═══════════════════════════════════════════════════════
# UTF-8 decode to codepoint array
# ═══════════════════════════════════════════════════════

func _utf8_to_codepoints:
    in(s: string)
    result = vec_new();
    i = 0;
    len = str_len(s);
    when i < len loop
        b0 = str_byte_at(s, i);
        if b0 < 128 do
            vec_push(result, b0);
            i = i + 1;
        eif b0 < 224 do
            b1 = str_byte_at(s, i + 1);
            cp = (b0 % 32) * 64 + (b1 % 64);
            vec_push(result, cp);
            i = i + 2;
        eif b0 < 240 do
            b1 = str_byte_at(s, i + 1);
            b2 = str_byte_at(s, i + 2);
            cp = (b0 % 16) * 4096 + (b1 % 64) * 64 + (b2 % 64);
            vec_push(result, cp);
            i = i + 3;
        else
            b1 = str_byte_at(s, i + 1);
            b2 = str_byte_at(s, i + 2);
            b3 = str_byte_at(s, i + 3);
            cp = (b0 % 8) * 262144 + (b1 % 64) * 4096 + (b2 % 64) * 64 + (b3 % 64);
            vec_push(result, cp);
            i = i + 4;
        end
    end
    out result;
end

# ═══════════════════════════════════════════════════════
# Codepoints back to UTF-8 string
# ═══════════════════════════════════════════════════════

func _codepoints_to_utf8:
    in(cps: Vec)
    sb = sb_new();
    i = 0;
    when i < vec_len(cps) loop
        cp = vec_get(cps, i);
        if cp < 128 do
            sb_append_byte(sb, cp);
        eif cp < 2048 do
            sb_append_byte(sb, 192 + cp / 64);
            sb_append_byte(sb, 128 + cp % 64);
        eif cp < 65536 do
            sb_append_byte(sb, 224 + cp / 4096);
            sb_append_byte(sb, 128 + (cp / 64) % 64);
            sb_append_byte(sb, 128 + cp % 64);
        else
            sb_append_byte(sb, 240 + cp / 262144);
            sb_append_byte(sb, 128 + (cp / 4096) % 64);
            sb_append_byte(sb, 128 + (cp / 64) % 64);
            sb_append_byte(sb, 128 + cp % 64);
        end
        i = i + 1;
    end
    result = sb_build(sb);
    sb_free(sb);
    out result;
end

# ═══════════════════════════════════════════════════════
# Canonical Ordering — sort combining marks by CCC
# ═══════════════════════════════════════════════════════

func _canonical_order:
    in(cps: Vec; ccc_table: Map)
    # Bubble sort combining sequences by CCC
    len = vec_len(cps);
    i = 1;
    when i < len loop
        ccc_i = get_ccc(ccc_table, vec_get(cps, i));
        if ccc_i > 0 do
            j = i;
            swapped = true;
            when j > 0 and swapped loop
                ccc_j = get_ccc(ccc_table, vec_get(cps, j));
                ccc_prev = get_ccc(ccc_table, vec_get(cps, j - 1));
                if ccc_prev > ccc_j and ccc_j > 0 do
                    # Swap
                    tmp = vec_get(cps, j);
                    vec_set(cps, j, vec_get(cps, j - 1));
                    vec_set(cps, j - 1, tmp);
                    j = j - 1;
                else
                    swapped = false;
                end
            end
        end
        i = i + 1;
    end
end

# ═══════════════════════════════════════════════════════
# NFD — Canonical Decomposition
# ═══════════════════════════════════════════════════════

func nfd:
    in(s: string)
    cps = _utf8_to_codepoints(s);
    decomp_table = _build_decomp_table();
    ccc_table = _build_ccc_table();

    result = vec_new();
    i = 0;
    when i < vec_len(cps) loop
        cp = vec_get(cps, i);
        opt = map_get(decomp_table, cp);
        if is_some(opt) do
            mapping = unwrap(opt);
            vec_push(result, mapping.first);
            if mapping.second >= 0 do
                vec_push(result, mapping.second);
            end
        else
            vec_push(result, cp);
        end
        i = i + 1;
    end

    _canonical_order(result, ccc_table);
    out _codepoints_to_utf8(result);
end

# ═══════════════════════════════════════════════════════
# NFC — Canonical Decomposition + Canonical Composition
# ═══════════════════════════════════════════════════════

func nfc:
    in(s: string)
    cps = _utf8_to_codepoints(s);
    decomp_table = _build_decomp_table();
    ccc_table = _build_ccc_table();
    comp_table = _build_comp_table();

    # Step 1: decompose
    decomposed = vec_new();
    i = 0;
    when i < vec_len(cps) loop
        cp = vec_get(cps, i);
        opt = map_get(decomp_table, cp);
        if is_some(opt) do
            mapping = unwrap(opt);
            vec_push(decomposed, mapping.first);
            if mapping.second >= 0 do
                vec_push(decomposed, mapping.second);
            end
        else
            vec_push(decomposed, cp);
        end
        i = i + 1;
    end

    # Step 2: canonical ordering
    _canonical_order(decomposed, ccc_table);

    # Step 3: compose
    if vec_len(decomposed) == 0 do
        out "";
    end

    composed = vec_new();
    vec_push(composed, vec_get(decomposed, 0));

    i = 1;
    when i < vec_len(decomposed) loop
        cp = vec_get(decomposed, i);
        last_idx = vec_len(composed) - 1;
        last = vec_get(composed, last_idx);

        ccc_cp = get_ccc(ccc_table, cp);
        key = last * 65536 + cp;
        opt = map_get(comp_table, key);

        if is_some(opt) and ccc_cp == 0 do
            # Compose: replace last with composite
            vec_set(composed, last_idx, unwrap(opt));
        eif is_some(opt) and ccc_cp > 0 do
            # Check if blocked
            vec_set(composed, last_idx, unwrap(opt));
        else
            vec_push(composed, cp);
        end
        i = i + 1;
    end

    out _codepoints_to_utf8(composed);
end

# ═══════════════════════════════════════════════════════
# Convenience: normalized comparison
# ═══════════════════════════════════════════════════════

func str_eq_nfc:
    in(a: string; b: string)
    out str_eq(nfc(a), nfc(b));
end.

func str_eq_nfd:
    in(a: string; b: string)
    out str_eq(nfd(a), nfd(b));
end.

func is_nfc:
    in(s: string)
    out str_eq(s, nfc(s));
end.

func is_nfd:
    in(s: string)
    out str_eq(s, nfd(s));
end
