##
 * vir/str/unicode.vri — Unicode Utilities
 * =========================================
 * Inspired by Python: unicodedata
 * Inspired by C23: <uchar.h>, <wchar.h>
 *
 * Cung cấp thông tin Unicode category, normalization cơ bản.
 ##

include types;
include option;
import Option, Some, None from option;
include string;
import String, str_new from string;

# ═══════════════════════════════════════════════════════
# Unicode Code Point Info
# ═══════════════════════════════════════════════════════

enum UnicodeCategory:
    Lu = 1    # Letter, uppercase;
    Ll = 2    # Letter, lowercase;
    Lt = 3    # Letter, titlecase;
    Lm = 4    # Letter, modifier;
    Lo = 5    # Letter, other;
    Mn = 6    # Mark, nonspacing;
    Mc = 7    # Mark, spacing combining;
    Nd = 8    # Number, decimal digit;
    Nl = 9    # Number, letter;
    No = 10   # Number, other;
    Pc = 11   # Punctuation, connector;
    Pd = 12   # Punctuation, dash;
    Ps = 13   # Punctuation, open;
    Pe = 14   # Punctuation, close;
    Pi = 15   # Punctuation, initial quote;
    Pf = 16   # Punctuation, final quote;
    Po = 17   # Punctuation, other;
    Sm = 18   # Symbol, math;
    Sc = 19   # Symbol, currency;
    Sk = 20   # Symbol, modifier;
    So = 21   # Symbol, other;
    Zs = 22   # Separator, space;
    Zl = 23   # Separator, line;
    Zp = 24   # Separator, paragraph;
    Cc = 25   # Other, control;
    Cf = 26   # Other, format;
    Cn = 27   # Other, not assigned;
    Co = 28   # Other, private use;
    Unknown = 0;
end.

# ─── UTF-8 Encoding ──────────────────────────────────

func utf8_encode_len(cp: int):
    # Số byte cần để encode 1 code point.
    if cp <= 0x7F do out 1 end
    if cp <= 0x7FF do out 2 end
    if cp <= 0xFFFF do out 3 end
    if cp <= 0x10FFFF do out 4 end
    out 0   # invalid;
end.
func utf8_encode:
    in  cp: int;
        buf: ptr;
        offset: int
    # Ghi code point vào buf tại offset. Returns số byte ghi.
    if cp <= 0x7F do
        native_store_u8(buf, offset, cp);
        out 1;
    end
    if cp <= 0x7FF do
        native_store_u8(buf, offset,     0xC0 | (cp >> 6));
        native_store_u8(buf, offset + 1, 0x80 | (cp & 0x3F));
        out 2;
    end
    if cp <= 0xFFFF do
        native_store_u8(buf, offset,     0xE0 | (cp >> 12));
        native_store_u8(buf, offset + 1, 0x80 | ((cp >> 6) & 0x3F));
        native_store_u8(buf, offset + 2, 0x80 | (cp & 0x3F));
        out 3;
    end
    if cp <= 0x10FFFF do
        native_store_u8(buf, offset,     0xF0 | (cp >> 18));
        native_store_u8(buf, offset + 1, 0x80 | ((cp >> 12) & 0x3F));
        native_store_u8(buf, offset + 2, 0x80 | ((cp >> 6) & 0x3F));
        native_store_u8(buf, offset + 3, 0x80 | (cp & 0x3F));
        out 4;
    end
    out 0;
end.
func utf8_decode:
    in  buf: ptr;
        offset: int;
        out_len: int
    # Decode 1 code point từ buf. Ghi số byte vào out_len.
    b0 = native_load_u8(buf, offset);
    
    if b0 <= 0x7F do
        *out_len = 1;
        out b0;
    end
    
    if (b0 & 0xE0) == 0xC0 do
        b1 = native_load_u8(buf, offset + 1);
        *out_len = 2;
        out ((b0 & 0x1F) << 6) | (b1 & 0x3F);
    end
    
    if (b0 & 0xF0) == 0xE0 do
        b1 = native_load_u8(buf, offset + 1);
        b2 = native_load_u8(buf, offset + 2);
        *out_len = 3;
        out ((b0 & 0x0F) << 12) | ((b1 & 0x3F) << 6) | (b2 & 0x3F);
    end
    
    if (b0 & 0xF8) == 0xF0 do
        b1 = native_load_u8(buf, offset + 1);
        b2 = native_load_u8(buf, offset + 2);
        b3 = native_load_u8(buf, offset + 3);
        *out_len = 4;
        out ((b0 & 0x07) << 18) | ((b1 & 0x3F) << 12) | ((b2 & 0x3F) << 6) | (b3 & 0x3F);
    end
    
    # Invalid UTF-8
    *out_len = 1;
    out 0xFFFD   # Replacement character;
end.
# ─── Validation ───────────────────────────────────────

func utf8_is_valid(data: ptr, len: int):
    # Kiểm tra xem byte sequence có phải UTF-8 hợp lệ không.
    i = 0;
    when i < len loop
        b0 = native_load_u8(data, i);
        expected = 0;
        
        if b0 <= 0x7F do
            expected = 1;
        eif (b0 & 0xE0) == 0xC0 do
            expected = 2;
            if b0 < 0xC2 do out false end # overlong
        eif (b0 & 0xF0) == 0xE0 do
            expected = 3;
        eif (b0 & 0xF8) == 0xF0 do
            expected = 4;
            if b0 > 0xF4 do out false end # > U+10FFFF
        else
            out false   # invalid lead byte;
        end
        
        if i + expected > len do out false end # truncated
        # Kiểm tra continuation bytes
        j = 1;
        when j < expected loop
            cont = native_load_u8(data, i + j);
            if (cont & 0xC0) != 0x80 do out false end
            j = j + 1;
        end
        
        i = i + expected;
    end
    out true;
end.
# ─── Code Point Properties ───────────────────────────

func is_valid_codepoint(cp: int):
    out cp <= 0x10FFFF and !(cp >= 0xD800 and cp <= 0xDFFF);
end.
func is_surrogate(cp: int):
    out cp >= 0xD800 and cp <= 0xDFFF;
end.
func is_bmp(cp: int):
    # Basic Multilingual Plane: U+0000..U+FFFF
    out cp <= 0xFFFF;
end.
func is_supplementary(cp: int):
    out cp > 0xFFFF and cp <= 0x10FFFF;
end.
# ─── Unicode Ranges (frequently used in Vir) ─────────

func is_cjk_unified(cp: int):
    # CJK Unified Ideographs
    out (cp >= 0x4E00 and cp <= 0x9FFF);
        or (cp >= 0x3400 and cp <= 0x4DBF)      # Extension A;
        or (cp >= 0x20000 and cp <= 0x2A6DF)     # Extension B;
        or (cp >= 0x2A700 and cp <= 0x2B73F)     # Extension C;
end.
func is_hangul_syllable(cp: int):
    out cp >= 0xAC00 and cp <= 0xD7AF;
end.
func is_hangul_jamo(cp: int):
    out cp >= 0x1100 and cp <= 0x11FF;
end.
func is_hiragana(cp: int):
    out cp >= 0x3040 and cp <= 0x309F;
end.
func is_katakana(cp: int):
    out cp >= 0x30A0 and cp <= 0x30FF;
end.
func is_vietnamese_diacritic(cp: int):
    # Kí tự tiếng Việt có dấu (Latin Extended range)
    out (cp >= 0x00C0 and cp <= 0x00FF)      # Latin-1 Supplement;
        or (cp >= 0x0100 and cp <= 0x024F)     # Latin Extended-A/B;
        or (cp >= 0x1E00 and cp <= 0x1EFF)     # Latin Extended Additional (Vietnamese);
end.
func is_emoji(cp: int):
    # Kiểm tra emoji cơ bản
    out (cp >= 0x1F600 and cp <= 0x1F64F)     # Emoticons;
        or (cp >= 0x1F300 and cp <= 0x1F5FF)   # Misc Symbols;
        or (cp >= 0x1F680 and cp <= 0x1F6FF)   # Transport;
        or (cp >= 0x1F900 and cp <= 0x1F9FF)   # Supplemental;
        or (cp >= 0x2600 and cp <= 0x26FF)      # Misc symbols;
        or (cp >= 0x2700 and cp <= 0x27BF)      # Dingbats;
end.
# ─── Iterating Code Points ───────────────────────────

func utf8_codepoint_count(data: ptr, byte_len: int):
    count = 0;
    i = 0;
    when i < byte_len loop
        b = native_load_u8(data, i);
        if (b & 0xC0) != 0x80 do
            count = count + 1;
        end
        i = i + 1;
    end
    out count;
end.
func utf8_next_codepoint:
    in  data: ptr;
        offset: int;
        byte_len: int
    # Returns byte offset của code point skip theo.
    if offset >= byte_len do out byte_len end
    b = native_load_u8(data, offset);
    if b <= 0x7F do out offset + 1 end
    if (b & 0xE0) == 0xC0 do out offset + 2 end
    if (b & 0xF0) == 0xE0 do out offset + 3 end
    if (b & 0xF8) == 0xF0 do out offset + 4 end
    out offset + 1;
end.