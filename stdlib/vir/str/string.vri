##
 * vir/str/string.vri — Immutable UTF-8 String
 * =============================================
 * String default của Vir là UTF-8 immutable.
 * Biến đổi string -> tạo string mới (use StringBuilder cho hiệu suất).
 *
 * Inspired by C23: <string.h> strlen, strcmp, strstr
 * Inspired by Python: str type methods
 * Vượt cả hai: Unicode-first, không null-terminated.
 ##

include types
include option
import Option, Some, None, is_some from option
include result
import Result, Ok, Err from result
include parse
import parse from parse
include alloc
import alloc, free from alloc
include copy
import mem_copy, mem_cmp from copy
include vec
import Vec, vec_new, vec_push, vec_len, vec_get from vec

entity String:
    data: ptr       # UTF-8 encoded bytes (owned, NOT null-terminated inside),
        byte_len: int   # Số bytes,
        char_len: int   # Số Unicode codepoints (cached, tính lần đầu)
end.

func _strCstrLen(data: int) -> int:
    if data == 0 do out 0 end
    n = 0
    when native_read_u8(data, n) != 0 loop
        n = n + 1
    end
    out n
end.

func _strCopy(data: int, len: int) -> string:
    p = alloc(len + 1)
    if len > 0 do mem_copy(p, data as ptr, len) end
    native_write_u8(p, len, 0)
    out p as string
end.
# ═══════════════════════════════════════════════════════
# Tạo string
# ═══════════════════════════════════════════════════════

func str_new:
    in literal: string
    data = (literal as ptr) as int
    out _strCopy(data, _strCstrLen(data))
end.
func str_empty:
    out _strCopy(0, 0)
end.
func str_from_bytes:
    in data: ptr; len: int
    out _strCopy(data as int, len)
end.
# ═══════════════════════════════════════════════════════
# Thông tin cơ bản
# ═══════════════════════════════════════════════════════

func str_len:
    in s: string
    data = (s as ptr) as int
    out utf8_count_chars(data as ptr, _strCstrLen(data))
end.
func str_byte_len:
    in s: string
    out _strCstrLen((s as ptr) as int)
end.
func str_is_empty:
    in s: string
    data = (s as ptr) as int
    out data == 0 or native_read_u8(data, 0) == 0
end.
# ═══════════════════════════════════════════════════════
# Truy cập character
# ═══════════════════════════════════════════════════════

func str_char_at:
    in s: string; index: int
    data = (s as ptr) as int
    byte_len = _strCstrLen(data)
    char_len = utf8_count_chars(data as ptr, byte_len)
    if index >= char_len do
        panic("str_char_at: index out of bounds")
    end
    out utf8_char_at(data as ptr, byte_len, index)
end.
func str_byte_at:
    in s: string; index: int
    data = (s as ptr) as int
    if index >= _strCstrLen(data) do
        panic("str_byte_at: index out of bounds")
    end
    out native_read_u8(data, index)
end.
# ═══════════════════════════════════════════════════════
# So sánh
# ═══════════════════════════════════════════════════════

func str_eq:
    in a: string; b: string
    ad = (a as ptr) as int
    bd = (b as ptr) as int
    alen = _strCstrLen(ad)
    blen = _strCstrLen(bd)
    if alen != blen do out false end
    out mem_cmp(ad as ptr, bd as ptr, alen) == 0
end.
func str_cmp:
    in a: string; b: string
    ad = (a as ptr) as int
    bd = (b as ptr) as int
    alen = _strCstrLen(ad)
    blen = _strCstrLen(bd)
    min_len = alen
    if blen < min_len do min_len = blen end
    var cmp_res = mem_cmp(ad as ptr, bd as ptr, min_len)
    if cmp_res != 0 do out cmp_res end
    if alen < blen do out -1 end
    if alen > blen do out 1 end
    out 0
end.
# ═══════════════════════════════════════════════════════
# Cắt string (Slicing)
# ═══════════════════════════════════════════════════════

func str_slice:
    in s: string; from: int; to: int
    data = (s as ptr) as int
    byte_len = _strCstrLen(data)
    char_len = utf8_count_chars(data as ptr, byte_len)
    if from > to or to > char_len do
        panic("str_slice: invalid range")
    end
    byte_start = utf8_offset_of(data as ptr, byte_len, from)
    byte_end = utf8_offset_of(data as ptr, byte_len, to)
    out _strCopy(data + byte_start, byte_end - byte_start)
end.
func str_slice_bytes:
    in s: string; from: int; to: int
    data = (s as ptr) as int
    byte_len = _strCstrLen(data)
    if from > to or to > byte_len do
        panic("str_slice_bytes: invalid range")
    end
    out _strCopy(data + from, to - from)
end.
# ═══════════════════════════════════════════════════════
# Nối string (Concatenation)
# ═══════════════════════════════════════════════════════

func str_concat(a: string, b: string):
    ad = (a as ptr) as int
    bd = (b as ptr) as int
    alen = _strCstrLen(ad)
    blen = _strCstrLen(bd)
    total = alen + blen
    p = alloc(total + 1)
    if alen > 0 do mem_copy(p, ad as ptr, alen) end
    if blen > 0 do mem_copy(p + alen, bd as ptr, blen) end
    native_write_u8(p, total, 0)
    out p as string
end.
# ═══════════════════════════════════════════════════════
# Tìm kiếm
# ═══════════════════════════════════════════════════════

func str_contains(haystack: string, needle: string):
    out is_some(str_find(haystack, needle))
end.
func str_find(haystack: string, needle: string):
    # Two-Way algorithm — O(n) worst-case, O(1) space (same as glibc strstr)
    hd = (haystack as ptr) as int
    nd = (needle as ptr) as int
    n = _strCstrLen(hd)
    m = _strCstrLen(nd)
    if m == 0 do out Some(0) end
    if m > n do out None end
    if m == 1 do
        # Single byte fast path
        b = native_read_u8(nd, 0)
        i = 0
        when i < n loop
            if native_read_u8(hd, i) == b do
                out Some(i)
            end
            i = i + 1
        end
        out None
    end

    # Compute maximal suffix (Two-Way critical factorization)
    ms = _two_way_maxsuf(nd as ptr, m, false)
    ms2 = _two_way_maxsuf(nd as ptr, m, true)
    if ms > ms2 do period_pos = ms; else period_pos = ms2; end

    # Check if needle has a periodic structure
    period = period_pos + 1;  # simplified period for Two-Way
    memory = 0
    i = 0
    when i <= n - m loop
        # Right half
        j = period_pos
        if memory > period_pos do j = memory end
        found_right = true
        when j < m loop
            if native_read_u8(hd, i + j) != native_read_u8(nd, j) do
                i = i + (j - period_pos)
                memory = 0
                found_right = false
                break
            end
            j = j + 1
        end
        if found_right do
            # Left half
            j = period_pos
            matched = true
            when j > memory loop
                j = j - 1
                if native_read_u8(hd, i + j) != native_read_u8(nd, j) do
                    i = i + period
                    memory = m - period
                    matched = false
                    break
                end
            end
            if matched do
                out Some(i)
            end
        end
    end
    out None
end.
func _two_way_maxsuf:
    in  pat: ptr
        m: int
        reversed: bool
    # Compute maximal suffix position for Two-Way algorithm
    ms = -1
    j = 0
    p = 1
    k = 1
    when j + k < m loop
        a = native_read_u8(pat, j + k)
        b = native_read_u8(pat, ms + k)
        if reversed do tmp = a; a = b; b = tmp; end
        if a < b do
            j = j + k
            k = 1
            p = j - ms
        eif a == b do
            if k == p do
                j = j + p
                k = 1
            else
                k = k + 1
            end
        else
            ms = j
            j = ms + 1
            k = 1
            p = 1
        end
    end
    out ms
end.
func str_starts_with(s: string, prefix: string):
    sd = (s as ptr) as int
    pd = (prefix as ptr) as int
    slen = _strCstrLen(sd)
    plen = _strCstrLen(pd)
    if plen > slen do out false end
    out mem_cmp(sd as ptr, pd as ptr, plen) == 0
end.
func str_ends_with(s: string, suffix: string):
    sd = (s as ptr) as int
    xd = (suffix as ptr) as int
    slen = _strCstrLen(sd)
    xlen = _strCstrLen(xd)
    if xlen > slen do out false end
    offset = slen - xlen
    out mem_cmp((sd + offset) as ptr, xd as ptr, xlen) == 0
end.
# ═══════════════════════════════════════════════════════
# Biến đổi
# ═══════════════════════════════════════════════════════

func str_to_upper(s: string):
    # ASCII to_upper (Unicode full case mapping cần bảng tra)
    data = (s as ptr) as int
    byte_len = _strCstrLen(data)
    p = alloc(byte_len + 1)
    if byte_len > 0 do mem_copy(p, data as ptr, byte_len) end
    for i in 0..byte_len do
        b = native_read_u8(p, i)
        if b >= 0x61 and b <= 0x7A do
            native_write_u8(p, i, b - 32)
        end
    end
    native_write_u8(p, byte_len, 0)
    out p as string
end.
func str_to_lower(s: string):
    data = (s as ptr) as int
    byte_len = _strCstrLen(data)
    p = alloc(byte_len + 1)
    if byte_len > 0 do mem_copy(p, data as ptr, byte_len) end
    for i in 0..byte_len do
        b = native_read_u8(p, i)
        if b >= 0x41 and b <= 0x5A do
            native_write_u8(p, i, b + 32)
        end
    end
    native_write_u8(p, byte_len, 0)
    out p as string
end.
func str_trim(s: string):
    data = (s as ptr) as int
    byte_len = _strCstrLen(data)
    start = 0
    when start < byte_len and is_ascii_whitespace(native_read_u8(data, start)) loop
        start = start + 1
    end
    tail = byte_len
    when tail > start and is_ascii_whitespace(native_read_u8(data, tail - 1)) loop
        tail = tail - 1
    end
    out _strCopy(data + start, tail - start)
end.
func str_trim_start(s: string):
    data = (s as ptr) as int
    byte_len = _strCstrLen(data)
    start = 0
    when start < byte_len and is_ascii_whitespace(native_read_u8(data, start)) loop
        start = start + 1
    end
    out _strCopy(data + start, byte_len - start)
end.
func str_trim_end(s: string):
    data = (s as ptr) as int
    tail = _strCstrLen(data)
    when tail > 0 and is_ascii_whitespace(native_read_u8(data, tail - 1)) loop
        tail = tail - 1
    end
    out _strCopy(data, tail)
end.
func str_replace:
    in  s: string
        old: string
        new: string
    source_data = (s as ptr) as int
    old_data = (old as ptr) as int
    new_data = (new as ptr) as int
    source_len = _strCstrLen(source_data)
    old_len = _strCstrLen(old_data)
    new_len = _strCstrLen(new_data)
    if old_len == 0 do out _strCopy(source_data, source_len) end

    count = 0
    i = 0
    when i + old_len <= source_len loop
        if mem_cmp((source_data + i) as ptr, old_data as ptr, old_len) == 0 do
            count = count + 1
            i = i + old_len
        else
            i = i + 1
        end
    end
    if count == 0 do out _strCopy(source_data, source_len) end

    output_len = source_len + count * (new_len - old_len)
    output = alloc(output_len + 1)
    source_pos = 0
    output_pos = 0
    when source_pos < source_len loop
        if source_pos + old_len <= source_len and
           mem_cmp((source_data + source_pos) as ptr, old_data as ptr, old_len) == 0 do
            if new_len > 0 do mem_copy(output + output_pos, new_data as ptr, new_len) end
            source_pos = source_pos + old_len
            output_pos = output_pos + new_len
        else
            native_write_u8(output, output_pos, native_read_u8(source_data, source_pos))
            source_pos = source_pos + 1
            output_pos = output_pos + 1
        end
    end
    native_write_u8(output, output_len, 0)
    out output as string
end.
func str_repeat(s: string, count: int):
    data = (s as ptr) as int
    byte_len = _strCstrLen(data)
    total = byte_len * count
    p = alloc(total + 1)
    for i in 0..count do
        mem_copy(p + i * byte_len, data as ptr, byte_len)
    end
    native_write_u8(p, total, 0)
    out p as string
end.
# ═══════════════════════════════════════════════════════
# Tách / Nối
# ═══════════════════════════════════════════════════════

func str_split(s: string, delim: string):
    source_data = (s as ptr) as int
    delim_data = (delim as ptr) as int
    source_len = _strCstrLen(source_data)
    delim_len = _strCstrLen(delim_data)
    parts = vec_new of (string)()
    if delim_len == 0 do
        parts = vec_push of (string)(parts, _strCopy(source_data, source_len))
        out parts
    end

    part_start = 0
    i = 0
    when i + delim_len <= source_len loop
        if mem_cmp((source_data + i) as ptr, delim_data as ptr, delim_len) == 0 do
            parts = vec_push of (string)(parts, _strCopy(source_data + part_start, i - part_start))
            i = i + delim_len
            part_start = i
        else
            i = i + 1
        end
    end
    parts = vec_push of (string)(parts, _strCopy(source_data + part_start, source_len - part_start))
    out parts
end.
func str_join(parts: Vec of (string), sep: string):
    count = vec_len of (string)(parts)
    sep_data = (sep as ptr) as int
    sep_len = _strCstrLen(sep_data)
    total = 0
    i = 0
    when i < count loop
        part = vec_get of (string)(parts, i)
        part_data = (part as ptr) as int
        total = total + _strCstrLen(part_data)
        if i + 1 < count do total = total + sep_len end
        i = i + 1
    end

    output = alloc(total + 1)
    output_pos = 0
    i = 0
    when i < count loop
        part = vec_get of (string)(parts, i)
        part_data = (part as ptr) as int
        part_len = _strCstrLen(part_data)
        if part_len > 0 do mem_copy(output + output_pos, part_data as ptr, part_len) end
        output_pos = output_pos + part_len
        if i + 1 < count and sep_len > 0 do
            mem_copy(output + output_pos, sep_data as ptr, sep_len)
            output_pos = output_pos + sep_len
        end
        i = i + 1
    end
    native_write_u8(output, total, 0)
    out output as string
end.
# ═══════════════════════════════════════════════════════
# Conversions
# ═══════════════════════════════════════════════════════

func str_to_i64(s: string):
    case parse.int(s)
        Result.Ok(v): out v
        Result.Err(_): out 0
    end
end.
func str_to_f64(s: string):
    out parse_float(s)
end.
func i64_to_str(n: int):
    scratch = alloc(32)
    len = 0
    value = n
    negative = value < 0
    if value > 0 do value = 0 - value end

    if value == 0 do
        native_write_u8(scratch, len, 48)
        len = len + 1
    else
        when value != 0 loop
            quotient = value / 10
            digit = 0 - (value - quotient * 10)
            native_write_u8(scratch, len, 48 + digit)
            len = len + 1
            value = quotient
        end
    end
    if negative do
        native_write_u8(scratch, len, 45)
        len = len + 1
    end

    output = alloc(len + 1)
    i = 0
    when i < len loop
        native_write_u8(output, i, native_read_u8(scratch, len - i - 1))
        i = i + 1
    end
    native_write_u8(output, len, 0)
    free(scratch)
    out output as string
end.
func f64_to_fixed(f: float, precision: int):
    digits = precision
    if digits < 0 do digits = 0 end
    if digits > 18 do digits = 18 end

    negative = f < 0.0
    value = f
    if negative do value = 0.0 - value end

    whole = value as int
    if (whole as float) > value do whole = whole - 1 end
    scale = 1
    i = 0
    when i < digits loop
        scale = scale * 10
        i = i + 1
    end
    fraction = ((value - (whole as float)) * (scale as float)) as int
    if fraction >= scale do
        whole = whole + 1
        fraction = 0
    end

    whole_text = i64_to_str(whole)
    whole_data = (whole_text as ptr) as int
    whole_len = _strCstrLen(whole_data)
    sign_len = 0
    if negative do sign_len = 1 end
    output_len = sign_len + whole_len
    if digits > 0 do output_len = output_len + 1 + digits end

    output = alloc(output_len + 1)
    pos = 0
    if negative do
        native_write_u8(output, pos, 45)
        pos = pos + 1
    end
    if whole_len > 0 do mem_copy(output + pos, whole_data as ptr, whole_len) end
    pos = pos + whole_len
    if digits > 0 do
        native_write_u8(output, pos, 46)
        pos = pos + 1
        i = digits - 1
        when i >= 0 loop
            native_write_u8(output, pos + i, 48 + (fraction mod 10))
            fraction = fraction / 10
            i = i - 1
        end
    end
    native_write_u8(output, output_len, 0)
    free(whole_text as ptr)
    out output as string
end.

func f64_to_str(f: float):
    out f64_to_fixed(f, 6)
end.
func str_free(s: string):
    free(s as ptr)
end.
# ═══════════════════════════════════════════════════════
# UTF-8 helpers (internal)
# ═══════════════════════════════════════════════════════

func is_ascii_whitespace(b: int):
    out b == 0x20 or b == 0x09 or b == 0x0A or b == 0x0D
end.
func utf8_count_chars(data: ptr, byte_len: int):
    # Đếm số codepoints in UTF-8 data
    count = 0
    i = 0
    when i < byte_len loop
        b = native_read_u8(data, i)
        if (b & 0x80) == 0 do
            i = i + 1           # 1-byte (ASCII)
        eif (b & 0xE0) == 0xC0 do
            i = i + 2           # 2-byte
        eif (b & 0xF0) == 0xE0 do
            i = i + 3           # 3-byte
        eif (b & 0xF8) == 0xF0 do
            i = i + 4           # 4-byte
        else
            i = i + 1           # invalid, skip byte
        end
        count = count + 1
    end
    out count
end.

func utf8_decode_char(data: ptr, offset: int, byte_len: int):
    if offset < 0 or offset >= byte_len do out 0xFFFD end
    b0 = native_read_u8(data, offset)
    if b0 <= 0x7F do out b0 end
    if (b0 bit_and 0xE0) == 0xC0 and offset + 1 < byte_len do
        b1 = native_read_u8(data, offset + 1)
        out ((b0 bit_and 0x1F) shl 6) bit_or (b1 bit_and 0x3F)
    end
    if (b0 bit_and 0xF0) == 0xE0 and offset + 2 < byte_len do
        b1 = native_read_u8(data, offset + 1)
        b2 = native_read_u8(data, offset + 2)
        out ((b0 bit_and 0x0F) shl 12) bit_or
            ((b1 bit_and 0x3F) shl 6) bit_or
            (b2 bit_and 0x3F)
    end
    if (b0 bit_and 0xF8) == 0xF0 and offset + 3 < byte_len do
        b1 = native_read_u8(data, offset + 1)
        b2 = native_read_u8(data, offset + 2)
        b3 = native_read_u8(data, offset + 3)
        out ((b0 bit_and 0x07) shl 18) bit_or
            ((b1 bit_and 0x3F) shl 12) bit_or
            ((b2 bit_and 0x3F) shl 6) bit_or
            (b3 bit_and 0x3F)
    end
    out 0xFFFD
end.

func utf8_char_at:
    in  data: ptr
        byte_len: int
        char_index: int
    # Lấy codepoint tại vị trí char_index (O(n) scan)
    count = 0
    i = 0
    when i < byte_len loop
        b = native_read_u8(data, i)
        if count == char_index do
            out utf8_decode_char(data, i, byte_len)
        end
        if (b & 0x80) == 0 do
            i = i + 1
        eif (b & 0xE0) == 0xC0 do
            i = i + 2
        eif (b & 0xF0) == 0xE0 do
            i = i + 3
        eif (b & 0xF8) == 0xF0 do
            i = i + 4
        else
            i = i + 1
        end
        count = count + 1
    end
    panic("utf8_char_at: index out of bounds")
end.
func utf8_offset_of:
    in  data: ptr
        byte_len: int
        char_index: int
    count = 0
    i = 0
    when i < byte_len and count < char_index loop
        b = native_read_u8(data, i)
        if (b & 0x80) == 0 do
            i = i + 1
        eif (b & 0xE0) == 0xC0 do
            i = i + 2
        eif (b & 0xF0) == 0xE0 do
            i = i + 3
        eif (b & 0xF8) == 0xF0 do
            i = i + 4
        else
            i = i + 1
        end
        count = count + 1
    end
    out i
end.

entity StringNamespace:
    method fromBytes(data: ptr, len: int):
        out str_from_bytes(data, len)
    end.
    method empty():
        out str_empty()
    end.
    method len(s: string):
        out str_len(s)
    end.
    method bytes(s: string):
        out str_byte_len(s)
    end.
    method isEmpty(s: string):
        out str_is_empty(s)
    end.
    method char(s: string, i: int):
        out str_char_at(s, i)
    end.
    method byte(s: string, i: int):
        out str_byte_at(s, i)
    end.
    method slice(s: string, from: int, to: int):
        out str_slice(s, from, to)
    end.
    method byteSlice(s: string, from: int, to: int):
        out str_slice_bytes(s, from, to)
    end.
    method concat(a: string, b: string):
        out str_concat(a, b)
    end.
    method contains(s: string, needle: string):
        out str_contains(s, needle)
    end.
    method find(s: string, needle: string):
        out str_find(s, needle)
    end.
    method byteFind(s: string, needle: string):
        out str_find(s, needle)
    end.
    method startsWith(s: string, prefix: string):
        out str_starts_with(s, prefix)
    end.
    method endsWith(s: string, suffix: string):
        out str_ends_with(s, suffix)
    end.
    method trim(s: string):
        out str_trim(s)
    end.
    method trimStart(s: string):
        out str_trim_start(s)
    end.
    method trimEnd(s: string):
        out str_trim_end(s)
    end.
    method lower(s: string):
        out str_to_lower(s)
    end.
    method upper(s: string):
        out str_to_upper(s)
    end.
    method replace(s: string, old: string, new: string):
        out str_replace(s, old, new)
    end.
    method repeat(s: string, n: int):
        out str_repeat(s, n)
    end.
    method free(s: string):
        str_free(s)
    end.
end.

var string: StringNamespace
