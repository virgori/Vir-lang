/*
 * vir/str/string.vri — Immutable UTF-8 String
 * =============================================
 * String default của Vir là UTF-8 immutable.
 * Biến đổi string -> tạo string mới (use StringBuilder cho hiệu suất).
 *
 * Inspired by C23: <string.h> strlen, strcmp, strstr
 * Inspired by Python: str type methods
 * Vượt cả hai: Unicode-first, không null-terminated.
 */

import "vir/core/types" use all
import "vir/core/option" use Option, Some, None
import "vir/core/result" use Result, Ok, Err
import "vir/mem/alloc" use alloc, free
import "vir/mem/copy" use mem_copy, mem_cmp

entity String
    data: ptr       # UTF-8 encoded bytes (owned, NOT null-terminated inside)
    byte_len: u64   # Số bytes
    char_len: u64   # Số Unicode codepoints (cached, tính lần đầu)
end

# ═══════════════════════════════════════════════════════
# Tạo string
# ═══════════════════════════════════════════════════════

func str_new(literal: string) -> String
    # Tạo String từ string literal. Copy dữ liệu.
    var blen = native_str_byte_len(literal)
    var p = alloc(blen)
    mem_copy(p, native_str_ptr(literal), blen)
    out String { data: p, byte_len: blen, char_len: utf8_count_chars(p, blen) }
end

func str_empty() -> String
    out String { data: null, byte_len: 0, char_len: 0 }
end

func str_from_bytes(data: ptr, len: u64) -> String
    var p = alloc(len)
    mem_copy(p, data, len)
    out String { data: p, byte_len: len, char_len: utf8_count_chars(p, len) }
end

# ═══════════════════════════════════════════════════════
# Thông tin cơ bản
# ═══════════════════════════════════════════════════════

func str_len(s: String) -> u64
    # Returns số codepoints (character Unicode)
    out s.char_len
end

func str_byte_len(s: String) -> u64
    # Returns số bytes
    out s.byte_len
end

func str_is_empty(s: String) -> bool
    out s.byte_len == 0
end

# ═══════════════════════════════════════════════════════
# Truy cập character
# ═══════════════════════════════════════════════════════

func str_char_at(s: String, index: u64) -> u32
    # Returns Unicode codepoint tại vị trí index (theo codepoint, O(n))
    if index >= s.char_len
        panic("str_char_at: index out of bounds")
    end
    out utf8_char_at(s.data, s.byte_len, index)
end

func str_byte_at(s: String, index: u64) -> u8
    # Returns byte tại vị trí index (O(1))
    if index >= s.byte_len
        panic("str_byte_at: index out of bounds")
    end
    out native_read_u8(s.data, index)
end

# ═══════════════════════════════════════════════════════
# So sánh
# ═══════════════════════════════════════════════════════

func str_eq(a: String, b: String) -> bool
    if a.byte_len != b.byte_len out false end
    out mem_cmp(a.data, b.data, a.byte_len) == 0
end

func str_cmp(a: String, b: String) -> i32
    var min_len = if a.byte_len < b.byte_len a.byte_len else b.byte_len end
    var r = mem_cmp(a.data, b.data, min_len)
    if r != 0 out r end
    if a.byte_len < b.byte_len out -1 end
    if a.byte_len > b.byte_len out 1 end
    out 0
end

# ═══════════════════════════════════════════════════════
# Cắt string (Slicing)
# ═══════════════════════════════════════════════════════

func str_slice(s: String, from: u64, to: u64) -> String
    # Cắt theo vị trí codepoint [from, to)
    if from > to or to > s.char_len
        panic("str_slice: invalid range")
    end
    var byte_start = utf8_offset_of(s.data, s.byte_len, from)
    var byte_end = utf8_offset_of(s.data, s.byte_len, to)
    out str_from_bytes(s.data + byte_start, byte_end - byte_start)
end

func str_slice_bytes(s: String, from: u64, to: u64) -> String
    # Cắt theo byte offset [from, to) — nhanh hơn, phải đảm bảo valid UTF-8
    if from > to or to > s.byte_len
        panic("str_slice_bytes: invalid range")
    end
    out str_from_bytes(s.data + from, to - from)
end

# ═══════════════════════════════════════════════════════
# Nối string (Concatenation)
# ═══════════════════════════════════════════════════════

func str_concat(a: String, b: String) -> String
    var total = a.byte_len + b.byte_len
    var p = alloc(total)
    mem_copy(p, a.data, a.byte_len)
    mem_copy(p + a.byte_len, b.data, b.byte_len)
    out String { data: p, byte_len: total, char_len: a.char_len + b.char_len }
end

# ═══════════════════════════════════════════════════════
# Tìm kiếm
# ═══════════════════════════════════════════════════════

func str_contains(haystack: String, needle: String) -> bool
    out is_some(str_find(haystack, needle))
end

func str_find(haystack: String, needle: String) -> Option<u64>
    # Returns byte offset của needle in haystack, or None
    if needle.byte_len == 0 out Some(0) end
    if needle.byte_len > haystack.byte_len out None end

    với mỗi i in 0..(haystack.byte_len - needle.byte_len + 1)
        if mem_cmp(haystack.data + i, needle.data, needle.byte_len) == 0
            out Some(i)
        end
    end
    out None
end

func str_starts_with(s: String, prefix: String) -> bool
    if prefix.byte_len > s.byte_len out false end
    out mem_cmp(s.data, prefix.data, prefix.byte_len) == 0
end

func str_ends_with(s: String, suffix: String) -> bool
    if suffix.byte_len > s.byte_len out false end
    var offset = s.byte_len - suffix.byte_len
    out mem_cmp(s.data + offset, suffix.data, suffix.byte_len) == 0
end

# ═══════════════════════════════════════════════════════
# Biến đổi
# ═══════════════════════════════════════════════════════

func str_to_upper(s: String) -> String
    # ASCII to_upper (Unicode full case mapping cần bảng tra)
    var p = alloc(s.byte_len)
    mem_copy(p, s.data, s.byte_len)
    với mỗi i in 0..s.byte_len
        var b = native_read_u8(p, i)
        if b >= 0x61 and b <= 0x7A
            native_write_u8(p, i, b - 32)
        end
    end
    out String { data: p, byte_len: s.byte_len, char_len: s.char_len }
end

func str_to_lower(s: String) -> String
    var p = alloc(s.byte_len)
    mem_copy(p, s.data, s.byte_len)
    với mỗi i in 0..s.byte_len
        var b = native_read_u8(p, i)
        if b >= 0x41 and b <= 0x5A
            native_write_u8(p, i, b + 32)
        end
    end
    out String { data: p, byte_len: s.byte_len, char_len: s.char_len }
end

func str_trim(s: String) -> String
    var start = 0
    while start < s.byte_len and is_ascii_whitespace(native_read_u8(s.data, start))
        start = start + 1
    end
    var end = s.byte_len
    while end > start and is_ascii_whitespace(native_read_u8(s.data, end - 1))
        end = end - 1
    end
    out str_slice_bytes(s, start, end)
end

func str_trim_start(s: String) -> String
    var start = 0
    while start < s.byte_len and is_ascii_whitespace(native_read_u8(s.data, start))
        start = start + 1
    end
    out str_slice_bytes(s, start, s.byte_len)
end

func str_trim_end(s: String) -> String
    var end = s.byte_len
    while end > 0 and is_ascii_whitespace(native_read_u8(s.data, end - 1))
        end = end - 1
    end
    out str_slice_bytes(s, 0, end)
end

func str_replace(s: String, old: String, new: String) -> String
    # Thay thế tất cả occurrence của `old` bằng `new`
    # TODO: implement using StringBuilder for efficiency
    out native_str_replace(s, old, new)
end

func str_repeat(s: String, count: u64) -> String
    var total = s.byte_len * count
    var p = alloc(total)
    với mỗi i in 0..count
        mem_copy(p + i * s.byte_len, s.data, s.byte_len)
    end
    out String { data: p, byte_len: total, char_len: s.char_len * count }
end

# ═══════════════════════════════════════════════════════
# Tách / Nối
# ═══════════════════════════════════════════════════════

func str_split(s: String, delim: String) -> Vec<String>
    # Tách string theo delimiter
    out native_str_split(s, delim)
end

func str_join(parts: Vec<String>, sep: String) -> String
    # Nối các string với separator
    out native_str_join(parts, sep)
end

# ═══════════════════════════════════════════════════════
# Chuyển đổi
# ═══════════════════════════════════════════════════════

func str_to_i64(s: String) -> Result<i64, ParseError>
    out parse_int(s)
end

func str_to_f64(s: String) -> Result<f64, ParseError>
    out parse_float(s)
end

func i64_to_str(n: i64) -> String
    out native_i64_to_str(n)
end

func f64_to_str(f: f64) -> String
    out native_f64_to_str(f)
end

func str_free(s: String)
    free(s.data)
end

# ═══════════════════════════════════════════════════════
# UTF-8 helpers (internal)
# ═══════════════════════════════════════════════════════

func is_ascii_whitespace(b: u8) -> bool
    out b == 0x20 or b == 0x09 or b == 0x0A or b == 0x0D
end

func utf8_count_chars(data: ptr, byte_len: u64) -> u64
    # Đếm số codepoints in UTF-8 data
    var count = 0
    var i = 0
    while i < byte_len
        var b = native_read_u8(data, i)
        if (b & 0x80) == 0
            i = i + 1           # 1-byte (ASCII)
        eif (b & 0xE0) == 0xC0
            i = i + 2           # 2-byte
        eif (b & 0xF0) == 0xE0
            i = i + 3           # 3-byte
        eif (b & 0xF8) == 0xF0
            i = i + 4           # 4-byte
        else
            i = i + 1           # invalid, skip byte
        end
        count = count + 1
    end
    out count
end

func utf8_char_at(data: ptr, byte_len: u64, char_index: u64) -> u32
    # Lấy codepoint tại vị trí char_index (O(n) scan)
    var count = 0
    var i = 0
    while i < byte_len
        var b = native_read_u8(data, i)
        if count == char_index
            out utf8_decode_char(data, i, byte_len)
        end
        if (b & 0x80) == 0 i = i + 1
        eif (b & 0xE0) == 0xC0 i = i + 2
        eif (b & 0xF0) == 0xE0 i = i + 3
        eif (b & 0xF8) == 0xF0 i = i + 4
        else i = i + 1
        end
        count = count + 1
    end
    panic("utf8_char_at: index out of bounds")
end

func utf8_offset_of(data: ptr, byte_len: u64, char_index: u64) -> u64
    var count = 0
    var i = 0
    while i < byte_len and count < char_index
        var b = native_read_u8(data, i)
        if (b & 0x80) == 0 i = i + 1
        eif (b & 0xE0) == 0xC0 i = i + 2
        eif (b & 0xF0) == 0xE0 i = i + 3
        eif (b & 0xF8) == 0xF0 i = i + 4
        else i = i + 1
        end
        count = count + 1
    end
    out i
end
