##
 * vir/str/builder.vri — Mutable String Builder
 * ==============================================
 * Dùng khi cần nối nhiều string hiệu quả (O(1) amortized append).
 * Thay vì str_concat() liên tục (O(n) mỗi lần), use StringBuilder.
 *
 * Compiler uses internally: error message assembly, format strings.
 ##

include types;
include buffer;
import Buffer, buffer_new, buffer_push, buffer_write_bytes, buffer_len, buffer_free from buffer;
include string;
import String, str_from_bytes from string;

entity StringBuilder:
    buf: Buffer;
end.

func sb_new:
    out StringBuilder ( buf: buffer_new(64) );
end.

func sb_with_cap:
    in(cap:int)
    out StringBuilder ( buf: buffer_new(cap) );
end.

func sb_append:
    in(sb:StringBuilder; s:string)
    buffer_write_bytes(sb.buf, s.data, s.byte_len);
end.

func sb_append_cstr:
    in(sb:StringBuilder; literal:string)
    len = native_str_byte_len(literal);
    buffer_write_bytes(sb.buf, native_str_ptr(literal), len);
end.

func sb_append_char:
    in(sb:StringBuilder; codepoint:int)
    # Encode Unicode codepoint as UTF-8 and append
    if codepoint < 0x80 do
        buffer_push(sb.buf, to_u8(codepoint));
    eif codepoint < 0x800 do
        buffer_push(sb.buf, to_u8(0xC0 | (codepoint >> 6)));
        buffer_push(sb.buf, to_u8(0x80 | (codepoint & 0x3F)));
    eif codepoint < 0x10000 do
        buffer_push(sb.buf, to_u8(0xE0 | (codepoint >> 12)));
        buffer_push(sb.buf, to_u8(0x80 | ((codepoint >> 6) & 0x3F)));
        buffer_push(sb.buf, to_u8(0x80 | (codepoint & 0x3F)));
    else
        buffer_push(sb.buf, to_u8(0xF0 | (codepoint >> 18)));
        buffer_push(sb.buf, to_u8(0x80 | ((codepoint >> 12) & 0x3F)));
        buffer_push(sb.buf, to_u8(0x80 | ((codepoint >> 6) & 0x3F)));
        buffer_push(sb.buf, to_u8(0x80 | (codepoint & 0x3F)));
    end
end.

func sb_append_i64:
    in(sb:StringBuilder; n:int)
    sb_append(sb, i64_to_str(n));
end.

func sb_append_f64:
    in(sb:StringBuilder; f:float)
    sb_append(sb, f64_to_str(f));
end.

func sb_append_bool:
    in(sb:StringBuilder; b:bool)
    if b sb_append_cstr(sb, "true") do
    else sb_append_cstr(sb, "false");
    end
end.

func sb_append_byte:
    in(sb:StringBuilder; b:int)
    buffer_push(sb.buf, b);
end.

func sb_append_newline:
    in(sb:StringBuilder)
    buffer_push(sb.buf, 0x0A)   # '\n';
end.

func sb_build:
    in(sb:StringBuilder)
    # Tạo String immutable từ builder content. Builder vẫn use được.
    out str_from_bytes(sb.buf.data, buffer_len(sb.buf));
end.

func sb_len:
    in(sb:StringBuilder)
    out buffer_len(sb.buf);
end.

func sb_clear:
    in(sb:StringBuilder)
    sb.buf.len = 0;
end.

func sb_free:
    in(sb:StringBuilder)
    buffer_free(sb.buf);
end.

func sb_append_repeat:
    in(sb:StringBuilder; s:string; count:int)
    i = 0;
    when i < count loop
        sb_append(sb, s);
        i = i + 1;
    end
end.

func sb_insert:
    in(sb:StringBuilder; pos:int; s:string)
    # Insert string at byte position
    slen = str_byte_len(s);
    cur_len = buffer_len(sb.buf);
    if pos > cur_len do pos = cur_len; end
    # Make room
    i = 0;
    when i < slen loop
        buffer_push(sb.buf, 0);
        i = i + 1;
    end
    # Shift existing bytes right
    i = cur_len - 1;
    when i >= pos loop
        native_store_u8(sb.buf.data, i + slen, native_load_u8(sb.buf.data, i));
        i = i - 1;
    end
    # Copy string
    mem_copy(sb.buf.data + pos, s.data, slen);
end.

func sb_to_string:
    in(sb:StringBuilder)
    # Alias for sb_build
    out sb_build(sb);
end
