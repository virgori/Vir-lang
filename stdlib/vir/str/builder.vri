##
 * vir/str/builder.vri — Mutable String Builder
 * ==============================================
 * Dùng khi cần nối nhiều string hiệu quả (O(1) amortized append).
 * Thay vì str_concat() liên tục (O(n) mỗi lần), use StringBuilder.
 *
 * Compiler uses internally: error message assembly, format strings.
 *
 * Ownership: StringBuilder là Move type. Mutating API nhận `ref sb`.
 ##

include types
include buffer
import Buffer, buffer_new, buffer_push, buffer_write_bytes, buffer_len, buffer_free from buffer
include string
import String, str_from_bytes, str_byte_len from string
include copy
import mem_copy from copy

entity StringBuilder:
    buf: Buffer
end.
func sb_new:
    out StringBuilder ( buf: buffer_new(64) )
end.
func sb_with_cap(cap: int):
    out StringBuilder ( buf: buffer_new(cap) )
end.
func sb_append:
    ref sb: StringBuilder
    in  s: string
    buffer_write_bytes(sb.buf, s.data, s.byte_len)
end.
func sb_append_cstr:
    ref sb: StringBuilder
    in  literal: string
    len = native_str_byte_len(literal)
    buffer_write_bytes(sb.buf, native_str_ptr(literal), len)
end.
func sb_append_char:
    ref sb: StringBuilder
    in  codepoint: int
    # Encode Unicode codepoint as UTF-8 and append
    if codepoint < 0x80 do
        buffer_push(sb.buf, to_u8(codepoint))
    eif codepoint < 0x800 do
        buffer_push(sb.buf, to_u8(0xC0 bit_or (codepoint shr 6)))
        buffer_push(sb.buf, to_u8(0x80 bit_or (codepoint bit_and 0x3F)))
    eif codepoint < 0x10000 do
        buffer_push(sb.buf, to_u8(0xE0 bit_or (codepoint shr 12)))
        buffer_push(sb.buf, to_u8(0x80 bit_or ((codepoint shr 6) bit_and 0x3F)))
        buffer_push(sb.buf, to_u8(0x80 bit_or (codepoint bit_and 0x3F)))
    else
        buffer_push(sb.buf, to_u8(0xF0 bit_or (codepoint shr 18)))
        buffer_push(sb.buf, to_u8(0x80 bit_or ((codepoint shr 12) bit_and 0x3F)))
        buffer_push(sb.buf, to_u8(0x80 bit_or ((codepoint shr 6) bit_and 0x3F)))
        buffer_push(sb.buf, to_u8(0x80 bit_or (codepoint bit_and 0x3F)))
    end
end.
func sb_append_i64:
    ref sb: StringBuilder
    in  n: int
    sb_append(sb, i64_to_str(n))
end.
func sb_append_f64:
    ref sb: StringBuilder
    in  f: float
    sb_append(sb, f64_to_str(f))
end.
func sb_append_bool:
    ref sb: StringBuilder
    in  b: bool
    if b do
        sb_append_cstr(sb, "true")
    else
        sb_append_cstr(sb, "false")
    end
end.
func sb_append_byte:
    ref sb: StringBuilder
    in  b: int
    buffer_push(sb.buf, b)
end.
func sb_append_newline:
    ref sb: StringBuilder
    buffer_push(sb.buf, 0x0A)   # '\n'
end.
func sb_build(sb: StringBuilder):
    # Tạo String immutable từ builder content. Builder vẫn use được.
    out str_from_bytes(sb.buf.data, buffer_len(sb.buf))
end.
func sb_len(sb: StringBuilder):
    out buffer_len(sb.buf)
end.
func sb_clear:
    ref sb: StringBuilder
    sb.buf.len = 0
end.
func sb_free:
    ref sb: StringBuilder
    buffer_free(sb.buf)
end.
func sb_append_repeat:
    ref sb: StringBuilder
    in  s: string
        count: int
    i = 0
    when i < count loop
        sb_append(sb, s)
        i = i + 1
    end
end.
func sb_insert:
    ref sb: StringBuilder
    in  pos: int
        s: string
    # Insert string at byte position
    slen = s.byte_len
    cur_len = buffer_len(sb.buf)
    if pos > cur_len do pos = cur_len; end
    # Make room
    i = 0
    when i < slen loop
        buffer_push(sb.buf, 0)
        i = i + 1
    end
    # Shift existing bytes right
    i = cur_len - 1
    when i >= pos loop
        native_store_u8(sb.buf.data, i + slen, native_load_u8(sb.buf.data, i))
        i = i - 1
    end
    # Copy string
    mem_copy(sb.buf.data + pos, s.data, slen)
end.
func sb_to_string(sb: StringBuilder):
    # Alias for sb_build
    out sb_build(sb)
end.