/*
 * vir/io/buffered.vri — Buffered I/O Wrappers
 * ===============================================
 * Inspired by Python: io.BufferedReader, io.BufferedWriter
 * Inspired by C23: stdio.h (setvbuf, fread/fwrite buffering)
 *
 * Giảm syscall overhead bằng cách đệm đọc/ghi in userspace.
 */

import "vir/core/types" use all
import "vir/core/result" use Result, Ok, Err
import "vir/core/option" use Option, Some, None
import "vir/mem/alloc" use alloc, free
import "vir/mem/copy" use mem_copy
import "vir/str/string" use String, str_new, str_from_bytes

hằng_số BUFFER_SIZE: usize = 8192   # 8 KB default

# ═══════════════════════════════════════════════════════
# BufferedReader
# ═══════════════════════════════════════════════════════

entity BufferedReader
    fd:      i32        # file descriptor
    buf:     ptr        # internal buffer
    buf_len: usize      # số byte in buf
    buf_pos: usize      # vị trí đọc hiện tại in buf
    buf_cap: usize      # size buffer
    eof:     bool       # đã end dữ liệu
end

func buffered_reader_new(fd: i32) -> BufferedReader
    out BufferedReader {
        fd = fd,
        buf = alloc(BUFFER_SIZE),
        buf_len = 0,
        buf_pos = 0,
        buf_cap = BUFFER_SIZE,
        eof = false
    }
end

func buffered_reader_with_cap(fd: i32, cap: usize) -> BufferedReader
    var real_cap = cap
    if real_cap < 512 real_cap = 512 end
    out BufferedReader {
        fd = fd,
        buf = alloc(real_cap),
        buf_len = 0,
        buf_pos = 0,
        buf_cap = real_cap,
        eof = false
    }
end

func _br_fill(r: &BufferedReader) -> Result<usize, String>
    # Đọc thêm dữ liệu từ fd vào buffer.
    if r.eof out Ok(0) end
    
    # Di chuyển dữ liệu chưa đọc về đầu buffer
    var remaining = r.buf_len - r.buf_pos
    if remaining > 0 and r.buf_pos > 0
        mem_copy(r.buf, r.buf + r.buf_pos, remaining)
    end
    r.buf_pos = 0
    r.buf_len = remaining
    
    # Đọc thêm
    var space = r.buf_cap - r.buf_len
    var n = native_read(r.fd, r.buf + r.buf_len, space)
    if n < 0 out Err(str_new("read error")) end
    if n == 0 r.eof = true end
    r.buf_len = r.buf_len + n
    out Ok(n)
end

func br_read(r: &BufferedReader, dst: ptr, count: usize) -> Result<usize, String>
    # Đọc tối đa count bytes vào dst.
    var total: usize = 0
    
    lặp_khi total < count
        var avail = r.buf_len - r.buf_pos
        if avail == 0
            var fill_result = _br_fill(r)
            if is_err(fill_result) out fill_result end
            avail = r.buf_len - r.buf_pos
            if avail == 0 thoát end   # EOF
        end
        
        var to_copy = count - total
        if to_copy > avail to_copy = avail end
        
        mem_copy(dst + total, r.buf + r.buf_pos, to_copy)
        r.buf_pos = r.buf_pos + to_copy
        total = total + to_copy
    end
    
    out Ok(total)
end

func br_read_byte(r: &BufferedReader) -> Option<u8>
    # Đọc 1 byte.
    if r.buf_pos >= r.buf_len
        var result = _br_fill(r)
        if r.buf_pos >= r.buf_len out None end
    end
    var b = native_load_u8(r.buf, r.buf_pos)
    r.buf_pos = r.buf_pos + 1
    out Some(b)
end

func br_read_line(r: &BufferedReader) -> Option<String>
    # Đọc đến '\n' or EOF. Bao gồm '\n' if có.
    var line_buf = alloc(256)
    var line_len: usize = 0
    var line_cap: usize = 256
    
    loop
        var byte_opt = br_read_byte(r)
        chọn byte_opt
            case None
                if line_len == 0
                    free(line_buf)
                    out None
                end
                thoát
            case Some(b)
                # Mở rộng if cần
                if line_len >= line_cap
                    line_cap = line_cap * 2
                    var new_buf = alloc(line_cap)
                    mem_copy(new_buf, line_buf, line_len)
                    free(line_buf)
                    line_buf = new_buf
                end
                native_store_u8(line_buf, line_len, b)
                line_len = line_len + 1
                if b == 0x0A thoát end   # '\n'
        end
    end
    
    var result = str_from_bytes(line_buf, line_len)
    free(line_buf)
    out Some(result)
end

func br_is_eof(r: BufferedReader) -> bool
    out r.eof and r.buf_pos >= r.buf_len
end

func br_close(r: &BufferedReader)
    if r.buf != null free(r.buf) end
    r.buf = null
    native_close(r.fd)
end

# ═══════════════════════════════════════════════════════
# BufferedWriter
# ═══════════════════════════════════════════════════════

entity BufferedWriter
    fd:      i32
    buf:     ptr
    buf_len: usize
    buf_cap: usize
end

func buffered_writer_new(fd: i32) -> BufferedWriter
    out BufferedWriter {
        fd = fd,
        buf = alloc(BUFFER_SIZE),
        buf_len = 0,
        buf_cap = BUFFER_SIZE
    }
end

func bw_write(w: &BufferedWriter, src: ptr, count: usize) -> Result<usize, String>
    # Ghi vào buffer, flush khi full.
    var total: usize = 0
    
    lặp_khi total < count
        var space = w.buf_cap - w.buf_len
        if space == 0
            var flush_result = bw_flush(w)
            if is_err(flush_result) out flush_result end
            space = w.buf_cap
        end
        
        var to_copy = count - total
        if to_copy > space to_copy = space end
        
        mem_copy(w.buf + w.buf_len, src + total, to_copy)
        w.buf_len = w.buf_len + to_copy
        total = total + to_copy
    end
    
    out Ok(total)
end

func bw_write_byte(w: &BufferedWriter, b: u8) -> Result<usize, String>
    if w.buf_len >= w.buf_cap
        var result = bw_flush(w)
        if is_err(result) out result end
    end
    native_store_u8(w.buf, w.buf_len, b)
    w.buf_len = w.buf_len + 1
    out Ok(1)
end

func bw_write_str(w: &BufferedWriter, s: String) -> Result<usize, String>
    out bw_write(w, s.data, s.byte_len)
end

func bw_flush(w: &BufferedWriter) -> Result<usize, String>
    if w.buf_len == 0 out Ok(0) end
    
    var written: usize = 0
    lặp_khi written < w.buf_len
        var n = native_write(w.fd, w.buf + written, w.buf_len - written)
        if n < 0 out Err(str_new("write error")) end
        if n == 0 out Err(str_new("write returned 0")) end
        written = written + n
    end
    
    var total = w.buf_len
    w.buf_len = 0
    out Ok(total)
end

func bw_close(w: &BufferedWriter)
    bw_flush(w)
    if w.buf != null free(w.buf) end
    w.buf = null
    native_close(w.fd)
end

# ═══════════════════════════════════════════════════════
# Line-buffered Writer (auto-flush on '\n')
# ═══════════════════════════════════════════════════════

entity LineWriter
    inner: BufferedWriter
end

func line_writer_new(fd: i32) -> LineWriter
    out LineWriter { inner = buffered_writer_new(fd) }
end

func lw_write(w: &LineWriter, src: ptr, count: usize) -> Result<usize, String>
    var result = bw_write(&w.inner, src, count)
    
    # Kiểm tra có '\n' in dữ liệu vừa ghi
    var i: usize = 0
    var has_newline = false
    lặp_khi i < count
        if native_load_u8(src, i) == 0x0A
            has_newline = true
            thoát
        end
        i = i + 1
    end
    
    if has_newline bw_flush(&w.inner) end
    out result
end

func lw_close(w: &LineWriter)
    bw_close(&w.inner)
end
