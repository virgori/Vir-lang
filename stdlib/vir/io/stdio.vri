##
 * vir/io/stdio.vri — Standard I/O (stdin, stdout, stderr)
 * =========================================================
 * Spec FFI (§4.1): string → address via `as ptr` (not `as i64`).
 * Soft ABI until the compiler boxes literals as fat {data,byte_len,char_len}:
 * handles are NUL C-string pointers. Do not probe fat fields on arbitrary
 * handles (reading past a short literal SEGV).
 * cstr → string retype at the ABI boundary only (same class as string_rt).
 ##

module vir.io.stdio

include types
include syscall
import sys_read, sys_write, STDIN_FD, STDOUT_FD, STDERR_FD from syscall
include alloc
import vir_alloc, vir_free, vir_realloc from alloc
include string_rt
import rt_strlen, native_read_u8, native_write_u8 from string_rt

# Spec §4.1 FFI: string → raw pointer for syscalls / byte scan.
func str_ptr(s: string) -> int:
    out (s as ptr) as int
end.

# ABI boundary: NUL C-string address → string handle (soft until fat literals).
func cstr_to_str(p: int) -> string:
    out p as string
end.

func print_raw_stdout(s: string):
    let p = str_ptr(s)
    if p == 0 do out end
    let len = rt_strlen(p)
    if len > 0 do
        sys_write(STDOUT_FD, p, len)
    end
end.

func print_raw_stderr(s: string):
    let p = str_ptr(s)
    if p == 0 do out end
    let len = rt_strlen(p)
    if len > 0 do
        sys_write(STDERR_FD, p, len)
    end
end.

func print(s: string):
    print_raw_stdout(s)
end.

func println(s: string):
    print_raw_stdout(s)
    sys_write(STDOUT_FD, "\n", 1)
end.

func print_str(s: string):
    print_raw_stdout(s)
end.

func print_ln(s: string):
    println(s)
end.

func eprint(s: string):
    print_raw_stderr(s)
end.

func eprintln(s: string):
    print_raw_stderr(s)
    sys_write(STDERR_FD, "\n", 1)
end.

func eprint_str(s: string):
    print_raw_stderr(s)
end.

func eprint_ln(s: string):
    eprintln(s)
end.

func flush:
    out 0
end.

func flush_stdout:
    out 0
end.

func flush_stderr:
    out 0
end.

# Set when readln hits EOF with no bytes (Ctrl+D / closed stdin).
# Empty line from Enter leaves this false — distinguishes EOF from "".
var g_stdin_eof: bool = false

func stdin_at_eof -> bool:
    out g_stdin_eof
end.

func readln -> string:
    g_stdin_eof = false
    var cap = 64
    var buf = vir_alloc(cap)
    var len = 0
    let byte_buf = vir_alloc(1)
    var reading = true

    when reading loop
        let n = sys_read(STDIN_FD, byte_buf, 1)
        if n <= 0 do
            if len == 0 do
                g_stdin_eof = true
            end
            reading = false
        else
            let ch = native_read_u8(byte_buf, 0)
            if ch == 10 do
                reading = false
            else
                if len + 2 >= cap do
                    cap = cap * 2
                    buf = vir_realloc(buf, cap)
                end
                native_write_u8(buf, len, ch)
                len = len + 1
            end
        end
    end

    vir_free(byte_buf)

    if len > 0 do
        if native_read_u8(buf, len - 1) == 13 do
            len = len - 1
        end
    end

    buf = vir_realloc(buf, len + 1)
    native_write_u8(buf, len, 0)
    out cstr_to_str(buf)
end.

func readLine -> string:
    out readln()
end.

func read_line -> string:
    out readln()
end.

func read_line_secret -> string:
    out readln()
end.

func input(prompt: string) -> string:
    print_raw_stdout(prompt)
    flush_stdout()
    out readln()
end.

func stdio_cstr(s: string) -> int:
    out str_ptr(s)
end.

func stdio_len_p(p: int) -> int:
    if p == 0 do out 0 end
    out rt_strlen(p)
end.

func stdio_byte_p(p: int, i: int) -> int:
    if p == 0 do out 0 end
    if i < 0 do out 0 end
    if i >= rt_strlen(p) do out 0 end
    out native_read_u8(p, i)
end.

func stdio_len(s: string) -> int:
    out stdio_len_p(str_ptr(s))
end.

func stdio_byte(s: string, i: int) -> int:
    out stdio_byte_p(str_ptr(s), i)
end.

func soft_str_from_cstr(p: int) -> string:
    out cstr_to_str(p)
end.

entity IoNamespace:
    method print(s: string):
        print_raw_stdout(s)
    end.
    method println(s: string):
        print_raw_stdout(s)
        sys_write(STDOUT_FD, "\n", 1)
    end.
    method eprint(s: string):
        print_raw_stderr(s)
    end.
    method eprintln(s: string):
        print_raw_stderr(s)
        sys_write(STDERR_FD, "\n", 1)
    end.
    method readln() -> string:
        out read_line()
    end.
end.

var io: IoNamespace

export print, println, print_str, print_ln
export eprint, eprintln, eprint_str, eprint_ln
export flush, flush_stdout, flush_stderr
export readln, readLine, read_line, read_line_secret, input, stdin_at_eof
export stdio_len, stdio_byte, stdio_cstr, stdio_len_p, stdio_byte_p
export str_ptr, soft_str_from_cstr, cstr_to_str
export IoNamespace, io
