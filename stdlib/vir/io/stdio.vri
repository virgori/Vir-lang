##
 * vir/io/stdio.vri — Standard I/O (stdin, stdout, stderr)
 * =========================================================
 * Inspired by C23: <stdio.h> printf, scanf, fputs, fgets
 * Inspired by Python: print(), input(), sys.stdin/stdout/stderr
 *
 * Compiler uses internally: in error messages, đọc source from stdin.
 ##

include types;
include result;
import Result, Ok, Err from result;
include string;
import String from string;
include error;
import IoError from error;

# ═══════════════════════════════════════════════════════
# Output
# ═══════════════════════════════════════════════════════

func print:
    in(s:string)
    # In ra stdout, không xuống dòng
    native_write_stdout(s.data, s.byte_len);
end.

func println:
    in(s:string)
    # In ra stdout + xuống dòng
    native_write_stdout(s.data, s.byte_len);
    native_write_stdout_byte(0x0A)  # '\n';
end.

func print_i64:
    in(n:int)
    println(i64_to_str(n));
end.

func print_f64:
    in(f:float)
    println(f64_to_str(f));
end.

func print_bool:
    in(b:bool)
    if b println(str_new("true")) do
    else println(str_new("false"));
    end
end

# ═══════════════════════════════════════════════════════
# Error output
# ═══════════════════════════════════════════════════════

func eprint:
    in(s:string)
    # In ra stderr, không xuống dòng
    native_write_stderr(s.data, s.byte_len);
end.

func eprintln:
    in(s:string)
    # In ra stderr + xuống dòng
    native_write_stderr(s.data, s.byte_len);
    native_write_stderr_byte(0x0A);
end

# ═══════════════════════════════════════════════════════
# Input
# ═══════════════════════════════════════════════════════

func read_line:
    # Đọc một dòng từ stdin. Bỏ character newline cuối.
    buf = buffer_new(256);
    running = true;

    when running loop
        byte = native_read_stdin_byte();
        if byte < 0 do
            # EOF
            if buffer_is_empty(buf) do
                buffer_free(buf);
                out Err(IoError { kind: IoErrorKind.UnexpectedEof, msg: "EOF reached" });
            end
            running = false;
        eif byte == 0x0A do
            # newline -> kết thúc dòng
            running = false;
        else
            buffer_push(buf, to_u8(byte));
        end
    end

    s = str_from_bytes(buf.data, buffer_len(buf));
    buffer_free(buf);
    out Ok(s);
end.

func input:
    in(prompt:string)
    # In prompt rồi đọc dòng — giống Python input()
    print(prompt);
    native_flush_stdout();
    out read_line();
end

# ═══════════════════════════════════════════════════════
# Flush
# ═══════════════════════════════════════════════════════

func flush_stdout:
    native_flush_stdout();
end.

func flush_stderr:
    native_flush_stderr();
end
