/*
 * vir/io/file.vri — File I/O
 * ============================
 * Inspired by C23: <stdio.h> fopen, fread, fwrite, fclose, fseek, ftell
 * Inspired by Python: open(), file.read(), file.write(), pathlib
 *
 * Compiler uses internally: đọc source file, ghi binary output.
 */

import "vir/core/types" use all
import "vir/core/result" use Result, Ok, Err
import "vir/core/option" use Option, Some, None
import "vir/str/string" use String
import "vir/mem/slice" use Slice, slice_new
import "vir/mem/buffer" use Buffer, buffer_new, buffer_write_bytes, buffer_free
import "vir/io/traits" use Reader, Writer, Seeker, SeekFrom
import "vir/error/error" use IoError, IoErrorKind

enum FileMode
    Read      = 1     # Mở để đọc (file phải tồn tại)
    Write     = 2     # Mở để ghi (tạo mới or truncate)
    Append    = 4     # Mở để ghi thêm cuối file
    ReadWrite = 3     # Mở để đọc + ghi
end

entity File
    fd: i64           # Native file descriptor / handle
    path: String
    mode: FileMode
    closed: bool
end

# ═══════════════════════════════════════════════════════
# Mở / Đóng file
# ═══════════════════════════════════════════════════════

func file_open(path: String, mode: FileMode) -> Result<File, IoError>
    var fd = native_file_open(path.data, path.byte_len, mode)
    if fd < 0
        out Err(IoError {
            kind: io_error_from_errno(native_errno()),
            msg: "cannot open file: " + path
        })
    end
    out Ok(File { fd: fd, path: path, mode: mode, closed: false })
end

func file_create(path: String) -> Result<File, IoError>
    out file_open(path, FileMode.Write)
end

func file_close(f: File) -> Result<void, IoError>
    if f.closed out Ok(void) end
    var r = native_file_close(f.fd)
    f.closed = true
    if r < 0
        out Err(IoError { kind: IoErrorKind.Other, msg: "close failed" })
    end
    out Ok(void)
end

# ═══════════════════════════════════════════════════════
# Đọc file
# ═══════════════════════════════════════════════════════

func file_read(f: File, buf: Slice) -> Result<u64, IoError>
    # Đọc tối đa buf.len bytes. Returns số bytes đọc được.
    if f.closed
        out Err(IoError { kind: IoErrorKind.Other, msg: "file is closed" })
    end
    var n = native_file_read(f.fd, buf.data, buf.len)
    if n < 0
        out Err(IoError { kind: io_error_from_errno(native_errno()), msg: "read failed" })
    end
    out Ok(to_u64(n))
end

func file_read_all(f: File) -> Result<String, IoError>
    # Đọc toàn bộ nội dung file thành String.
    var buf = buffer_new(4096)
    var tmp = alloc(4096)
    var slice = slice_new(tmp, 4096)

    var running = true
    while running
        var r = file_read(f, slice)
        chọn r
            case Ok(0) running = false
            case Ok(n) buffer_write_bytes(buf, tmp, n)
            case Err(e)
                free(tmp)
                buffer_free(buf)
                out Err(e)
        end
    end

    var s = str_from_bytes(buf.data, buffer_len(buf))
    free(tmp)
    buffer_free(buf)
    out Ok(s)
end

func file_read_bytes(f: File) -> Result<Buffer, IoError>
    # Đọc toàn bộ nội dung file thành Buffer (binary).
    var result = buffer_new(4096)
    var tmp = alloc(4096)
    var slice = slice_new(tmp, 4096)

    var running = true
    while running
        var r = file_read(f, slice)
        chọn r
            case Ok(0) running = false
            case Ok(n) buffer_write_bytes(result, tmp, n)
            case Err(e)
                free(tmp)
                buffer_free(result)
                out Err(e)
        end
    end

    free(tmp)
    out Ok(result)
end

# ═══════════════════════════════════════════════════════
# Ghi file
# ═══════════════════════════════════════════════════════

func file_write(f: File, data: Slice) -> Result<u64, IoError>
    if f.closed
        out Err(IoError { kind: IoErrorKind.Other, msg: "file is closed" })
    end
    var n = native_file_write(f.fd, data.data, data.len)
    if n < 0
        out Err(IoError { kind: io_error_from_errno(native_errno()), msg: "write failed" })
    end
    out Ok(to_u64(n))
end

func file_write_str(f: File, s: String) -> Result<u64, IoError>
    out file_write(f, slice_new(s.data, s.byte_len))
end

func file_write_all(f: File, data: Slice) -> Result<void, IoError>
    var written = 0
    while written < data.len
        var r = file_write(f, slice_sub(data, written, data.len))
        chọn r
            case Ok(n) written = written + n
            case Err(e) out Err(e)
        end
    end
    out Ok(void)
end

# ═══════════════════════════════════════════════════════
# Seek & Position
# ═══════════════════════════════════════════════════════

func file_seek(f: File, offset: i64, whence: SeekFrom) -> Result<u64, IoError>
    if f.closed
        out Err(IoError { kind: IoErrorKind.Other, msg: "file is closed" })
    end
    var pos = native_file_seek(f.fd, offset, whence)
    if pos < 0
        out Err(IoError { kind: io_error_from_errno(native_errno()), msg: "seek failed" })
    end
    out Ok(to_u64(pos))
end

func file_size(f: File) -> Result<u64, IoError>
    # Lưu vị trí hiện tại, seek đến cuối, lấy size, quay lại.
    var current = file_seek(f, 0, SeekFrom.Current)
    if is_err(current) out current end
    var end = file_seek(f, 0, SeekFrom.End)
    if is_err(end) out end end
    file_seek(f, unwrap(current), SeekFrom.Start)
    out end
end

# ═══════════════════════════════════════════════════════
# Tiện ích đọc/ghi nhanh (one-shot)
# ═══════════════════════════════════════════════════════

func read_file(path: String) -> Result<String, IoError>
    # Mở, đọc toàn bộ, đóng. Tiện cho source files nhỏ.
    var f = file_open(path, FileMode.Read)
    if is_err(f) out Err(unwrap_err(f)) end
    var content = file_read_all(unwrap(f))
    file_close(unwrap(f))
    out content
end

func write_file(path: String, content: String) -> Result<void, IoError>
    # Tạo/truncate file, ghi toàn bộ, đóng.
    var f = file_open(path, FileMode.Write)
    if is_err(f) out Err(unwrap_err(f)) end
    var r = file_write_str(unwrap(f), content)
    file_close(unwrap(f))
    if is_err(r) out Err(unwrap_err(r)) end
    out Ok(void)
end

# ═══════════════════════════════════════════════════════
# Internal helpers
# ═══════════════════════════════════════════════════════

func io_error_from_errno(errno: i32) -> IoErrorKind
    chọn errno
        case 2  out IoErrorKind.NotFound          # ENOENT
        case 13 out IoErrorKind.PermissionDenied  # EACCES
        case 17 out IoErrorKind.AlreadyExists     # EEXIST
        case 22 out IoErrorKind.InvalidInput      # EINVAL
        mặc_định out IoErrorKind.Other
    end
end
