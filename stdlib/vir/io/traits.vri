/*
 * vir/io/traits.vri — Reader / Writer Interfaces
 * ================================================
 * Inspired by C23: FILE* + fread/fwrite
 * Inspired by Python: io.RawIOBase, io.BufferedIOBase
 *
 * Mọi I/O in Vir đều thông qua Reader/Writer interface.
 */

import "vir/core/types" use all
import "vir/core/result" use Result, Ok, Err
import "vir/mem/slice" use Slice
import "vir/error/error" use IoError

# ═══════════════════════════════════════════════════════
# Reader — đọc dữ liệu
# ═══════════════════════════════════════════════════════

giao_diện Reader
    func read(buf: Slice) -> Result<u64, IoError>
    # Đọc tối đa buf.len bytes vào buf.
    # Returns số bytes đọc được (có thể < buf.len).
    # Returns Ok(0) khi EOF.
end

# ═══════════════════════════════════════════════════════
# Writer — ghi dữ liệu
# ═══════════════════════════════════════════════════════

giao_diện Writer
    func write(data: Slice) -> Result<u64, IoError>
    # Ghi tối đa data.len bytes từ data.
    # Returns số bytes ghi được.

    func flush() -> Result<void, IoError>
    # Đẩy buffer ra output thực tế.
end

# ═══════════════════════════════════════════════════════
# Seeker — di chuyển vị trí đọc/ghi
# ═══════════════════════════════════════════════════════

enum SeekFrom
    Start = 0       # Từ đầu file
    Current = 1     # Từ vị trí hiện tại
    End = 2         # Từ cuối file
end

giao_diện Seeker
    func seek(offset: i64, whence: SeekFrom) -> Result<u64, IoError>
    # Di chuyển vị trí. Returns vị trí mới.
end

# ═══════════════════════════════════════════════════════
# ReadWriter — kết hợp Reader + Writer
# ═══════════════════════════════════════════════════════

giao_diện ReadWriter
    thực_hiện Reader
    thực_hiện Writer
end

# ═══════════════════════════════════════════════════════
# Helper functions
# ═══════════════════════════════════════════════════════

func read_all(reader: Reader) -> Result<Buffer, IoError>
    # Đọc tất cả dữ liệu từ reader cho đến EOF.
    var result = buffer_new(4096)
    var buf = alloc(4096)
    var slice = slice_new(buf, 4096)

    var loop_running = true
    while loop_running
        var n = reader.read(slice)
        chọn n
            case Ok(0) loop_running = false
            case Ok(count) buffer_write_bytes(result, buf, count)
            case Err(e)
                free(buf)
                buffer_free(result)
                out Err(e)
        end
    end

    free(buf)
    out Ok(result)
end

func write_all(writer: Writer, data: Slice) -> Result<void, IoError>
    # Ghi toàn bộ data, retry if ghi chưa end.
    var written = 0
    while written < data.len
        var remaining = slice_sub(data, written, data.len)
        var n = writer.write(remaining)
        chọn n
            case Ok(count) written = written + count
            case Err(e) out Err(e)
        end
    end
    out Ok(void)
end

func copy(reader: Reader, writer: Writer) -> Result<u64, IoError>
    # Copy tất cả từ reader sang writer. Returns tổng bytes copied.
    var total = 0
    var buf = alloc(8192)
    var slice = slice_new(buf, 8192)

    var loop_running = true
    while loop_running
        var n = reader.read(slice)
        chọn n
            case Ok(0) loop_running = false
            case Ok(count)
                var w = writer.write(slice_new(buf, count))
                chọn w
                    case Ok(_) total = total + count
                    case Err(e) free(buf); out Err(e)
                end
            case Err(e) free(buf); out Err(e)
        end
    end

    free(buf)
    out Ok(total)
end
