##
 * vir/io/traits.vri — Reader / Writer Interfaces
 * ================================================
 * Inspired by C23: FILE* + fread/fwrite
 * Inspired by Python: io.RawIOBase, io.BufferedIOBase
 *
 * Mọi I/O in Vir đều thông qua Reader/Writer interface.
 ##

include types;
include result;
import Result, Ok, Err from result;
include slice;
import Slice from slice;
include error;
import IoError from error;

# ═══════════════════════════════════════════════════════
# Reader — đọc dữ liệu
# ═══════════════════════════════════════════════════════

giao_diện Reader:
    func read:
        in(buf:Slice)
    # Đọc tối đa buf.len bytes vào buf.
    # Returns số bytes đọc được (có thể < buf.len).
    # Returns Ok(0) khi EOF.
end
# ═══════════════════════════════════════════════════════
# Writer — ghi dữ liệu
# ═══════════════════════════════════════════════════════

giao_diện Writer:
    func write:
        in(data:Slice)
    # Ghi tối đa data.len bytes từ data.
    # Returns số bytes ghi được.

    func flush:
    # Đẩy buffer ra output thực tế.
end
# ═══════════════════════════════════════════════════════
# Seeker — di chuyển vị trí đọc/ghi
# ═══════════════════════════════════════════════════════

enum SeekFrom:
    Start = 0       # Từ đầu file;
    Current = 1     # Từ vị trí hiện tại;
    End = 2         # Từ cuối file;
end
giao_diện Seeker:
    func seek:
        in(offset:int; whence:SeekFrom)
    # Di chuyển vị trí. Returns vị trí mới.
end
# ═══════════════════════════════════════════════════════
# ReadWriter — kết hợp Reader + Writer
# ═══════════════════════════════════════════════════════

giao_diện ReadWriter:
    thực_hiện Reader;
    thực_hiện Writer;
end
# ═══════════════════════════════════════════════════════
# Helper functions
# ═══════════════════════════════════════════════════════

func read_all:
    in(reader:Reader)
    # Đọc tất cả dữ liệu từ reader cho đến EOF.
    result = buffer_new(4096);
    buf = alloc(4096);
    slice = slice_new(buf, 4096);

    loop_running = true;
    when loop_running loop
        n = reader.read(slice);
        case n
            case Ok(0) loop_running = false
            case Ok(count) buffer_write_bytes(result, buf, count)
        Err(e):
                free(buf);
                buffer_free(result);
                out Err(e);
        end
    end

    free(buf);
    out Ok(result);
end
func write_all:
    in(writer:Writer; data:Slice)
    # Ghi toàn bộ data, retry if ghi chưa end
    written = 0;
    when written < data.len loop
        remaining = slice_sub(data, written, data.len);
        n = writer.write(remaining);
        case n
            case Ok(count) written = written + count
        Err(e): out Err(e);
        end
    end
    out Ok(void);
end
func copy:
    in(reader:Reader; writer:Writer)
    # Copy tất cả từ reader sang writer. Returns tổng bytes copied.
    total = 0;
    buf = alloc(8192);
    slice = slice_new(buf, 8192);

    loop_running = true;
    when loop_running loop
        n = reader.read(slice);
        if is_ok(n) do
            count = unwrap(n);
            if count == 0 do loop_running = false else
                w = writer.write(slice_new(buf, count));
                if is_ok(w) do total = total + count
                else free(buf); out w; end
            end
        else
            free(buf); out n;
        end
    end

    free(buf);
    out Ok(total);
end