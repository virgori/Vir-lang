##
 * vir/io/format.vri — Value → string primitives
 * ==============================================
 * Public API: `format.*` (registry format.md). Disk path under io/ is historical.
 * Templates / printf → fmt.vri. Parse → parse.md (not here).
 ##

include types
include string
import str_new, str_len, str_concat, f64_to_fixed from string
include builder
import sb_new, sb_append, sb_append_cstr, sb_append_char, sb_build, sb_free from builder
include buffer
import buffer_new, buffer_push, buffer_len, buffer_read_u8, buffer_free from buffer

# Digits only for |n| > 0; no sign, no radix prefix.
# Uses negative domain arithmetic to prevent INT64_MIN negation overflow.
func _formatUnsignedDigits(val: int, base: int) -> string:
    digits = buffer_new(64)
    v = val
    if v > 0 do v = 0 - v end
    when v != 0 loop
        quotient = v / base
        rem = v - quotient * base
        d = 0 - rem
        if d < 10 do
            buffer_push(digits, to_u8(0x30 + d))
        else
            buffer_push(digits, to_u8(0x61 + d - 10))
        end
        v = quotient
    end
    sb = sb_new()
    i = buffer_len(digits)
    when i > 0 loop
        i = i - 1
        sb_append_char(sb, to_u8(buffer_read_u8(digits, i)))
    end
    result = sb_build(sb)
    sb_free(sb)
    buffer_free(digits)
    out result
end.

func _formatIntRadix(n: int, base: int) -> string:
    if n == 0 do out str_new("0") end
    negative = n < 0
    body = _formatUnsignedDigits(n, base)
    if negative do out str_concat(str_new("-"), body) end
    out body
end.

func _formatPrefixedRadix(n: int, base: int, prefix: string) -> string:
    if n == 0 do out str_new("0") end
    negative = n < 0
    digits = _formatUnsignedDigits(n, base)
    prefixed = str_concat(prefix, digits)
    if negative do out str_concat(str_new("-"), prefixed) end
    out prefixed
end.

func _formatFloatFixed(f: float, precision: int) -> string:
    out f64_to_fixed(f, precision)
end.

func _formatPadLeft(s: string, width: int, fill: int) -> string:
    slen = str_len(s)
    if slen >= width do out s end
    sb = sb_new()
    padding = width - slen
    for _ in 0..padding do
        sb_append_char(sb, fill)
    end
    sb_append(sb, s)
    result = sb_build(sb)
    sb_free(sb)
    out result
end.

func _formatPadRight(s: string, width: int, fill: int) -> string:
    slen = str_len(s)
    if slen >= width do out s end
    padding = width - slen
    sb = sb_new()
    sb_append(sb, s)
    for _ in 0..padding do
        sb_append_char(sb, fill)
    end
    result = sb_build(sb)
    sb_free(sb)
    out result
end.

func _formatPadCenter(s: string, width: int, fill: int) -> string:
    slen = str_len(s)
    if slen >= width do out s end
    total_pad = width - slen
    left_pad = total_pad / 2
    right_pad = total_pad - left_pad
    sb = sb_new()
    for _ in 0..left_pad do
        sb_append_char(sb, fill)
    end
    sb_append(sb, s)
    for _ in 0..right_pad do
        sb_append_char(sb, fill)
    end
    result = sb_build(sb)
    sb_free(sb)
    out result
end.

entity FormatNamespace:
    method int(n: int) -> string:
        out _formatIntRadix(n, 10)
    end.

    method intRadix(n: int, base: int) -> string:
        out _formatIntRadix(n, base)
    end.

    method hex(n: int) -> string:
        out _formatPrefixedRadix(n, 16, str_new("0x"))
    end.

    method bin(n: int) -> string:
        out _formatPrefixedRadix(n, 2, str_new("0b"))
    end.

    method oct(n: int) -> string:
        out _formatPrefixedRadix(n, 8, str_new("0o"))
    end.

    method bool(value: bool) -> string:
        if value do
            out str_new("true")
        else
            out str_new("false")
        end
    end.

    method padLeft(s: string, width: int, fill: int) -> string:
        out _formatPadLeft(s, width, fill)
    end.

    method padRight(s: string, width: int, fill: int) -> string:
        out _formatPadRight(s, width, fill)
    end.

    method padCenter(s: string, width: int, fill: int) -> string:
        out _formatPadCenter(s, width, fill)
    end.

    # Registry: planned stable surface; used by json/fmt until F1 gates close.
    method floatFixed(value: float, prec: int) -> string:
        out _formatFloatFixed(value, prec)
    end.
end.

var format: FormatNamespace

export FormatNamespace, format
