##
 * vir/io/format.vri — String Formatting
 * =======================================
 * format("Hello {0}, age {1}", name, age) -> "Hello Alice, age 30"
 * Inspired by Python: str.format(), f-strings
 ##

include types;
include string;
import String from string;
include builder;
import StringBuilder, sb_new, sb_append, sb_append_cstr, sb_append_i64, sb_append_char, sb_build, sb_free from builder;

func format_int(n: int, base: int):
    if n == 0 do out str_new("0") end

    sb = sb_new();
    negative = false;
    val = n;

    if val < 0 and base == 10 do
        negative = true;
        val = -val;
    end

    # Digits in reverse
    digits = buffer_new(64);
    when val > 0 loop
        d = val % base;
        if d < 10 do
            buffer_push(digits, to_u8(0x30 + d))   # '0' + d;
        else
            buffer_push(digits, to_u8(0x61 + d - 10))  # 'a' + d - 10;
        end
        val = val / base;
    end

    if negative do sb_append_char(sb, 0x2D) end # '-'
    # Prefix cho non-decimal
    if base == 16 do sb_append_cstr(sb, "0x") end
    if base == 2 do sb_append_cstr(sb, "0b") end
    if base == 8 do sb_append_cstr(sb, "0o") end

    # Reverse digits
    i = buffer_len(digits);
    when i > 0 loop
        i = i - 1;
        sb_append_char(sb, buffer_read_u8(digits, i));
    end

    result = sb_build(sb);
    sb_free(sb);
    buffer_free(digits);
    out result;
end.
func format_hex(n: int):
    out format_int(n, 16);
end.
func format_bin(n: int):
    out format_int(n, 2);
end.
func format_oct(n: int):
    out format_int(n, 8);
end.
func format_float(f: float, precision: int):
    out native_format_float(f, precision);
end.
func format_bool(b: bool):
    if b out str_new("true") do
    else out str_new("false");
    end
end.
func format_pad_left:
    in  s: string;
        width: int;
        fill: int
    if str_len(s) >= width do out s end
    sb = sb_new();
    padding = width - str_len(s);
    for _ in 0..padding do
        sb_append_char(sb, fill);
    end
    sb_append(sb, s);
    result = sb_build(sb);
    sb_free(sb);
    out result;
end.
func format_pad_right:
    in  s: string;
        width: int;
        fill: int
    if str_len(s) >= width do out s end
    sb = sb_new();
    sb_append(sb, s);
    padding = width - str_len(s);
    for _ in 0..padding do
        sb_append_char(sb, fill);
    end
    result = sb_build(sb);
    sb_free(sb);
    out result;
end.
func format_center:
    in  s: string;
        width: int;
        fill: int
    if str_len(s) >= width do out s end
    total_pad = width - str_len(s);
    left_pad = total_pad / 2;
    right_pad = total_pad - left_pad;
    sb = sb_new();
    for _ in 0..left_pad sb_append_char(sb, fill) end do
    sb_append(sb, s);
    for _ in 0..right_pad sb_append_char(sb, fill) end do
    result = sb_build(sb);
    sb_free(sb);
    out result;
end.