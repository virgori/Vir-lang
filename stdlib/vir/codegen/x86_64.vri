/*
 * vir/codegen/x86_64.vri — x86-64 Instruction Encoding
 * ======================================================
 * Step 2: Backend emitter – x86-64 (SSE2/AVX2) target
 *
 * Mirrors arm64.vri structure with x86-64 register model,
 * SSE2 baseline and AVX2 extended instruction emitters.
 *
 * Architecture: AT&T syntax for macOS/Linux assembler
 */

import "vir/core/types" use all
import "vir/str/string" use String, str_new, str_concat, str_eq
import "vir/collections/vec" use Vec, vec_new, vec_push, vec_len
import "vir/io/stdio" use println

# ═══════════════════════════════════════════════════════
# Register Classes
# ═══════════════════════════════════════════════════════

enum X86RegClass
    GPR64   = 0
    GPR32   = 1
    XMM     = 2    # 128-bit SSE
    YMM     = 3    # 256-bit AVX
end

entity X86Reg
    name:   String
    cls:    X86RegClass
    idx:    i32
end

# ── GPR64 registers ──
func rax() -> X86Reg out X86Reg { name: str_new("%rax"), cls: X86RegClass::GPR64, idx: 0 } end
func rbx() -> X86Reg out X86Reg { name: str_new("%rbx"), cls: X86RegClass::GPR64, idx: 3 } end
func rcx() -> X86Reg out X86Reg { name: str_new("%rcx"), cls: X86RegClass::GPR64, idx: 1 } end
func rdx() -> X86Reg out X86Reg { name: str_new("%rdx"), cls: X86RegClass::GPR64, idx: 2 } end
func rsi() -> X86Reg out X86Reg { name: str_new("%rsi"), cls: X86RegClass::GPR64, idx: 6 } end
func rdi() -> X86Reg out X86Reg { name: str_new("%rdi"), cls: X86RegClass::GPR64, idx: 7 } end
func rsp() -> X86Reg out X86Reg { name: str_new("%rsp"), cls: X86RegClass::GPR64, idx: 4 } end
func rbp() -> X86Reg out X86Reg { name: str_new("%rbp"), cls: X86RegClass::GPR64, idx: 5 } end
func r8()  -> X86Reg out X86Reg { name: str_new("%r8"),  cls: X86RegClass::GPR64, idx: 8 } end
func r9()  -> X86Reg out X86Reg { name: str_new("%r9"),  cls: X86RegClass::GPR64, idx: 9 } end
func r10() -> X86Reg out X86Reg { name: str_new("%r10"), cls: X86RegClass::GPR64, idx: 10 } end
func r11() -> X86Reg out X86Reg { name: str_new("%r11"), cls: X86RegClass::GPR64, idx: 11 } end
func r12() -> X86Reg out X86Reg { name: str_new("%r12"), cls: X86RegClass::GPR64, idx: 12 } end
func r13() -> X86Reg out X86Reg { name: str_new("%r13"), cls: X86RegClass::GPR64, idx: 13 } end
func r14() -> X86Reg out X86Reg { name: str_new("%r14"), cls: X86RegClass::GPR64, idx: 14 } end
func r15() -> X86Reg out X86Reg { name: str_new("%r15"), cls: X86RegClass::GPR64, idx: 15 } end

# ── XMM / YMM registers ──
func xmm(n: i32) -> X86Reg
    out X86Reg { name: format("%xmm{}", n), cls: X86RegClass::XMM, idx: n }
end

func ymm(n: i32) -> X86Reg
    out X86Reg { name: format("%ymm{}", n), cls: X86RegClass::YMM, idx: n }
end


# ═══════════════════════════════════════════════════════
# Grade — instruction quality ranking
# ═══════════════════════════════════════════════════════

enum X86Grade
    S = 0    # Optimal (fused ops, AVX2 vectorized)
    A = 1    # Good   (SSE2 vectorized)
    B = 2    # Fallback (scalar, emulated)
end


# ═══════════════════════════════════════════════════════
# Assembler Emitter
# ═══════════════════════════════════════════════════════

entity X86Emitter
    lines:       Vec<String>
    label_count: i32
    indent:      String
end

func x86_emitter_new() -> X86Emitter
    out X86Emitter {
        lines: vec_new(),
        indent: str_new("    "),
        label_count: 0
    }
end

func x86_emit(em: X86Emitter, line: String) -> X86Emitter
    vec_push(em.lines, str_concat(em.indent, line))
    out em
end

func x86_emit_label(em: X86Emitter, label: String) -> X86Emitter
    vec_push(em.lines, str_concat(label, str_new(":")))
    out em
end

func x86_emit_comment(em: X86Emitter, text: String) -> X86Emitter
    vec_push(em.lines, format("    // {}", text))
    out em
end

func x86_new_label(em: X86Emitter) -> (X86Emitter, String)
    var lbl = format(".Lx86_{}", em.label_count)
    em.label_count = em.label_count + 1
    out (em, lbl)
end

func x86_output(em: X86Emitter) -> String
    var out = str_new("")
    var i = 0
    while i < vec_len(em.lines)
        out = str_concat(out, vec_get(em.lines, i))
        out = str_concat(out, str_new("\n"))
        i = i + 1
    end
    out out
end


# ═══════════════════════════════════════════════════════
# System V AMD64 ABI — Prologue / Epilogue
# ═══════════════════════════════════════════════════════

func x86_emit_prologue(em: X86Emitter, frame_size: i32) -> X86Emitter
    em = x86_emit(em, str_new("pushq %rbp"))
    em = x86_emit(em, str_new("movq %rsp, %rbp"))
    if frame_size > 0
        em = x86_emit(em, format("subq ${}, %rsp", frame_size))
    end
    out em
end

func x86_emit_epilogue(em: X86Emitter, frame_size: i32) -> X86Emitter
    if frame_size > 0
        em = x86_emit(em, format("addq ${}, %rsp", frame_size))
    end
    em = x86_emit(em, str_new("popq %rbp"))
    em = x86_emit(em, str_new("retq"))
    out em
end


# ═══════════════════════════════════════════════════════
# GPR Instructions
# ═══════════════════════════════════════════════════════

func x86_emit_mov_reg(em: X86Emitter, src: X86Reg, dst: X86Reg) -> X86Emitter
    out x86_emit(em, format("movq {}, {}", src.name, dst.name))
end

func x86_emit_mov_imm(em: X86Emitter, imm: i64, dst: X86Reg) -> X86Emitter
    out x86_emit(em, format("movq ${}, {}", imm, dst.name))
end

func x86_emit_add(em: X86Emitter, src: X86Reg, dst: X86Reg) -> X86Emitter
    out x86_emit(em, format("addq {}, {}", src.name, dst.name))
end

func x86_emit_sub(em: X86Emitter, src: X86Reg, dst: X86Reg) -> X86Emitter
    out x86_emit(em, format("subq {}, {}", src.name, dst.name))
end

func x86_emit_imul(em: X86Emitter, src: X86Reg, dst: X86Reg) -> X86Emitter
    out x86_emit(em, format("imulq {}, {}", src.name, dst.name))
end

func x86_emit_lea(em: X86Emitter, base: X86Reg, offset: i32, dst: X86Reg) -> X86Emitter
    out x86_emit(em, format("leaq {}({}), {}", offset, base.name, dst.name))
end

func x86_emit_cmp(em: X86Emitter, a: X86Reg, b: X86Reg) -> X86Emitter
    out x86_emit(em, format("cmpq {}, {}", a.name, b.name))
end

func x86_emit_call(em: X86Emitter, func_name: String) -> X86Emitter
    out x86_emit(em, format("callq _{}", func_name))
end

func x86_emit_jmp(em: X86Emitter, label: String) -> X86Emitter
    out x86_emit(em, format("jmp {}", label))
end

func x86_emit_je(em: X86Emitter, label: String) -> X86Emitter
    out x86_emit(em, format("je {}", label))
end

func x86_emit_jne(em: X86Emitter, label: String) -> X86Emitter
    out x86_emit(em, format("jne {}", label))
end

func x86_emit_ret(em: X86Emitter) -> X86Emitter
    out x86_emit(em, str_new("retq"))
end


# ═══════════════════════════════════════════════════════
# Memory Access
# ═══════════════════════════════════════════════════════

func x86_emit_load(em: X86Emitter, base: X86Reg, offset: i32, dst: X86Reg) -> X86Emitter
    out x86_emit(em, format("movq {}({}), {}", offset, base.name, dst.name))
end

func x86_emit_store(em: X86Emitter, src: X86Reg, base: X86Reg, offset: i32) -> X86Emitter
    out x86_emit(em, format("movq {}, {}({})", src.name, offset, base.name))
end

func x86_emit_prefetch(em: X86Emitter, base: X86Reg, offset: i32) -> X86Emitter
    out x86_emit(em, format("prefetcht0 {}({})", offset, base.name))
end


# ═══════════════════════════════════════════════════════
# SSE2 Instructions (128-bit, baseline x86-64)
# Grade A — 4-wide float32
# ═══════════════════════════════════════════════════════

func x86_emit_addps(em: X86Emitter, src: X86Reg, dst: X86Reg) -> X86Emitter
    # Grade A: SSE2 4-wide float add
    out x86_emit(em, format("addps {}, {}", src.name, dst.name))
end

func x86_emit_mulps(em: X86Emitter, src: X86Reg, dst: X86Reg) -> X86Emitter
    out x86_emit(em, format("mulps {}, {}", src.name, dst.name))
end

func x86_emit_subps(em: X86Emitter, src: X86Reg, dst: X86Reg) -> X86Emitter
    out x86_emit(em, format("subps {}, {}", src.name, dst.name))
end

func x86_emit_maxps(em: X86Emitter, src: X86Reg, dst: X86Reg) -> X86Emitter
    out x86_emit(em, format("maxps {}, {}", src.name, dst.name))
end

func x86_emit_xorps(em: X86Emitter, src: X86Reg, dst: X86Reg) -> X86Emitter
    out x86_emit(em, format("xorps {}, {}", src.name, dst.name))
end

func x86_emit_movups_load(em: X86Emitter, base: X86Reg, offset: i32, dst: X86Reg) -> X86Emitter
    out x86_emit(em, format("movups {}({}), {}", offset, base.name, dst.name))
end

func x86_emit_movups_store(em: X86Emitter, src: X86Reg, base: X86Reg, offset: i32) -> X86Emitter
    out x86_emit(em, format("movups {}, {}({})", src.name, offset, base.name))
end

func x86_emit_movaps_load(em: X86Emitter, base: X86Reg, offset: i32, dst: X86Reg) -> X86Emitter
    # Requires 16-byte aligned address
    out x86_emit(em, format("movaps {}({}), {}", offset, base.name, dst.name))
end

func x86_emit_movaps_store(em: X86Emitter, src: X86Reg, base: X86Reg, offset: i32) -> X86Emitter
    out x86_emit(em, format("movaps {}, {}({})", src.name, offset, base.name))
end


# ═══════════════════════════════════════════════════════
# AVX2 Instructions (256-bit)
# Grade S — 8-wide float32
# ═══════════════════════════════════════════════════════

func x86_emit_vaddps(em: X86Emitter, a: X86Reg, b: X86Reg, dst: X86Reg) -> X86Emitter
    # Grade S: AVX2 8-wide float add (non-destructive 3-operand)
    out x86_emit(em, format("vaddps {}, {}, {}", a.name, b.name, dst.name))
end

func x86_emit_vmulps(em: X86Emitter, a: X86Reg, b: X86Reg, dst: X86Reg) -> X86Emitter
    out x86_emit(em, format("vmulps {}, {}, {}", a.name, b.name, dst.name))
end

func x86_emit_vsubps(em: X86Emitter, a: X86Reg, b: X86Reg, dst: X86Reg) -> X86Emitter
    out x86_emit(em, format("vsubps {}, {}, {}", a.name, b.name, dst.name))
end

func x86_emit_vfmadd231ps(em: X86Emitter, a: X86Reg, b: X86Reg, dst: X86Reg) -> X86Emitter
    # Grade S: FMA — dst = dst + a * b
    out x86_emit(em, format("vfmadd231ps {}, {}, {}", a.name, b.name, dst.name))
end

func x86_emit_vmaxps(em: X86Emitter, a: X86Reg, b: X86Reg, dst: X86Reg) -> X86Emitter
    out x86_emit(em, format("vmaxps {}, {}, {}", a.name, b.name, dst.name))
end

func x86_emit_vmovups_load(em: X86Emitter, base: X86Reg, offset: i32, dst: X86Reg) -> X86Emitter
    out x86_emit(em, format("vmovups {}({}), {}", offset, base.name, dst.name))
end

func x86_emit_vmovups_store(em: X86Emitter, src: X86Reg, base: X86Reg, offset: i32) -> X86Emitter
    out x86_emit(em, format("vmovups {}, {}({})", src.name, offset, base.name))
end

func x86_emit_vbroadcastss(em: X86Emitter, base: X86Reg, offset: i32, dst: X86Reg) -> X86Emitter
    out x86_emit(em, format("vbroadcastss {}({}), {}", offset, base.name, dst.name))
end

func x86_emit_vxorps(em: X86Emitter, a: X86Reg, b: X86Reg, dst: X86Reg) -> X86Emitter
    out x86_emit(em, format("vxorps {}, {}, {}", a.name, b.name, dst.name))
end

func x86_emit_vzeroupper(em: X86Emitter) -> X86Emitter
    # Required before calling non-AVX code
    out x86_emit(em, str_new("vzeroupper"))
end


# ═══════════════════════════════════════════════════════
# Micro-Kernel Emitters (x86-64 AVX2)
# ═══════════════════════════════════════════════════════

func x86_emit_micro_gemm_8x8(em: X86Emitter, a_ptr: X86Reg, b_ptr: X86Reg,
                              c_ptr: X86Reg, k_count: X86Reg) -> X86Emitter
    # Grade S: 8x8 micro-GEMM using AVX2 FMA
    #   for each k:
    #     for r in 0..8:
    #       broadcast A[r,k] into ymm14
    #       vfmadd231ps ymm14, B_row[k], C_row[r]

    em = x86_emit_comment(em, str_new("── micro_gemm_8x8 (AVX2 FMA) ──"))

    # Zero accumulators ymm0..ymm7
    var r = 0
    while r < 8
        em = x86_emit_vxorps(em, ymm(r), ymm(r), ymm(r))
        r = r + 1
    end

    # K-loop
    var (em2, k_lbl) = x86_new_label(em)
    em = em2
    var (em3, k_end) = x86_new_label(em)
    em = em3

    em = x86_emit(em, format("xorq {}, {}", r10().name, r10().name))
    em = x86_emit_label(em, k_lbl)
    em = x86_emit_cmp(em, k_count, r10())
    em = x86_emit_je(em, k_end)

    # Load B row: ymm15 = B[k, 0..8]
    em = x86_emit_vmovups_load(em, b_ptr, 0, ymm(15))

    # For each row r: broadcast A[r,k], FMA into ymm[r]
    r = 0
    while r < 8
        em = x86_emit_vbroadcastss(em, a_ptr, r * 4, ymm(14))
        em = x86_emit_vfmadd231ps(em, ymm(14), ymm(15), ymm(r))
        r = r + 1
    end

    # Advance pointers
    em = x86_emit(em, format("addq $32, {}", b_ptr.name))   # 8 floats * 4 bytes
    em = x86_emit(em, format("addq $32, {}", a_ptr.name))
    em = x86_emit(em, format("incq {}", r10().name))
    em = x86_emit_jmp(em, k_lbl)
    em = x86_emit_label(em, k_end)

    # Store results
    r = 0
    while r < 8
        em = x86_emit_vmovups_store(em, ymm(r), c_ptr, r * 32)
        r = r + 1
    end

    em = x86_emit_vzeroupper(em)
    out em
end


func x86_emit_ew_add_avx(em: X86Emitter, a_ptr: X86Reg, b_ptr: X86Reg,
                          c_ptr: X86Reg, n_count: X86Reg) -> X86Emitter
    # Grade S: 8-wide vectorized elementwise add
    em = x86_emit_comment(em, str_new("── ew_add (AVX2 8-wide) ──"))

    var (em2, loop_lbl) = x86_new_label(em)
    em = em2
    var (em3, end_lbl) = x86_new_label(em)
    em = em3

    em = x86_emit(em, format("xorq {}, {}", r10().name, r10().name))
    em = x86_emit_label(em, loop_lbl)
    em = x86_emit_cmp(em, n_count, r10())
    em = x86_emit_je(em, end_lbl)

    em = x86_emit_vmovups_load(em, a_ptr, 0, ymm(0))
    em = x86_emit_vmovups_load(em, b_ptr, 0, ymm(1))
    em = x86_emit_vaddps(em, ymm(0), ymm(1), ymm(2))
    em = x86_emit_vmovups_store(em, ymm(2), c_ptr, 0)

    em = x86_emit(em, format("addq $32, {}", a_ptr.name))
    em = x86_emit(em, format("addq $32, {}", b_ptr.name))
    em = x86_emit(em, format("addq $32, {}", c_ptr.name))
    em = x86_emit(em, format("addq $8, {}", r10().name))
    em = x86_emit_jmp(em, loop_lbl)
    em = x86_emit_label(em, end_lbl)

    em = x86_emit_vzeroupper(em)
    out em
end


func x86_emit_relu_avx(em: X86Emitter, src_ptr: X86Reg, dst_ptr: X86Reg,
                        n_count: X86Reg) -> X86Emitter
    # Grade S: ReLU = max(0, x) using AVX2
    em = x86_emit_comment(em, str_new("── relu (AVX2 8-wide) ──"))

    # Zero register
    em = x86_emit_vxorps(em, ymm(15), ymm(15), ymm(15))

    var (em2, loop_lbl) = x86_new_label(em)
    em = em2
    var (em3, end_lbl) = x86_new_label(em)
    em = em3

    em = x86_emit(em, format("xorq {}, {}", r10().name, r10().name))
    em = x86_emit_label(em, loop_lbl)
    em = x86_emit_cmp(em, n_count, r10())
    em = x86_emit_je(em, end_lbl)

    em = x86_emit_vmovups_load(em, src_ptr, 0, ymm(0))
    em = x86_emit_vmaxps(em, ymm(0), ymm(15), ymm(1))
    em = x86_emit_vmovups_store(em, ymm(1), dst_ptr, 0)

    em = x86_emit(em, format("addq $32, {}", src_ptr.name))
    em = x86_emit(em, format("addq $32, {}", dst_ptr.name))
    em = x86_emit(em, format("addq $8, {}", r10().name))
    em = x86_emit_jmp(em, loop_lbl)
    em = x86_emit_label(em, end_lbl)

    em = x86_emit_vzeroupper(em)
    out em
end


# ═══════════════════════════════════════════════════════
# Platform Helpers
# ═══════════════════════════════════════════════════════

func x86_emit_macos_header(em: X86Emitter) -> X86Emitter
    vec_push(em.lines, str_new(".section __TEXT,__text,regular,pure_instructions"))
    vec_push(em.lines, str_new(".build_version macos, 14, 0"))
    out em
end

func x86_emit_linux_header(em: X86Emitter) -> X86Emitter
    vec_push(em.lines, str_new(".text"))
    out em
end

func x86_emit_global_func(em: X86Emitter, name: String) -> X86Emitter
    vec_push(em.lines, format(".globl _{}", name))
    vec_push(em.lines, str_new(".p2align 4, 0x90"))
    vec_push(em.lines, format("_{}:", name))
    out em
end

func x86_emit_data_section(em: X86Emitter) -> X86Emitter
    vec_push(em.lines, str_new(""))
    vec_push(em.lines, str_new(".section __DATA,__data"))
    out em
end
