/*
 * vir/codegen/linker.vri — Self-Hosting Linker
 * ==============================================
 * Step 3: Cut the umbilical cord — Vir links its own binaries
 *
 * Resolves symbols, applies relocations, and produces
 * a final executable Mach-O binary without external ld.
 *
 * Pipeline:
 *   Object files -> Symbol resolution -> Relocation -> Executable
 */

import "vir/core/types" use all
import "vir/core/result" use Result, Ok, Err
import "vir/core/option" use Option, Some, None
import "vir/str/string" use String, str_new, str_concat, str_eq, str_len
import "vir/collections/vec" use Vec, vec_new, vec_push, vec_len, vec_get
import "vir/collections/map" use Map, map_new, map_set, map_get, map_contains
import "vir/codegen/binary" use all

# ═══════════════════════════════════════════════════════
# Mach-O Executable Constants
# ═══════════════════════════════════════════════════════

const MH_EXECUTE: u32       = 2     # Executable file
const LC_MAIN: u32           = 0x80000028
const LC_LOAD_DYLIB: u32     = 0x0C
const LC_DYLD_INFO_ONLY: u32 = 0x80000022

# Base addresses (macOS ARM64)
const TEXT_BASE: u64          = 0x100000000
const DATA_BASE: u64          = 0x100004000
const PAGE_SIZE: u64           = 0x4000


# ═══════════════════════════════════════════════════════
# Object File Input
# ═══════════════════════════════════════════════════════

entity ObjectFile
    name:       String
    sections:   Vec<Section>
    symbols:    Vec<Symbol>
    relocs:     Vec<Relocation>
end


# ═══════════════════════════════════════════════════════
# Resolved Symbol
# ═══════════════════════════════════════════════════════

entity ResolvedSymbol
    name:           String
    final_address:  u64
    obj_idx:        i32
    sec_idx:        i32
    is_external:    bool
end


# ═══════════════════════════════════════════════════════
# Linker State
# ═══════════════════════════════════════════════════════

entity Linker
    objects:        Vec<ObjectFile>
    symtab:         Map<String, ResolvedSymbol>
    text_buf:       ByteBuffer
    data_buf:       ByteBuffer
    entry_point:    u64
    errors:         Vec<String>
end

func linker_new() -> Linker
    out Linker {
        objects: vec_new(),
        symtab: map_new(),
        text_buf: buf_new(),
        data_buf: buf_new(),
        entry_point: TEXT_BASE,
        errors: vec_new()
    }
end


# ═══════════════════════════════════════════════════════
# Step 1: Add Object Files
# ═══════════════════════════════════════════════════════

func linker_add_object(lnk: Linker, obj: ObjectFile) -> Linker
    vec_push(lnk.objects, obj)
    out lnk
end


# ═══════════════════════════════════════════════════════
# Step 2: Symbol Resolution
# ═══════════════════════════════════════════════════════

func linker_resolve_symbols(lnk: Linker) -> Linker
    # First pass: collect all global symbols with their offsets
    var text_offset: u64 = 0

    var obj_i = 0
    while obj_i < vec_len(lnk.objects)
        var obj = vec_get(lnk.objects, obj_i)

        var sym_i = 0
        while sym_i < vec_len(obj.symbols)
            var sym = vec_get(obj.symbols, sym_i)

            if sym.is_global
                if map_contains(lnk.symtab, sym.name)
                    vec_push(lnk.errors, format(
                        "Duplicate symbol: {} (in {} and previous object)",
                        sym.name, obj.name))
                else
                    var resolved = ResolvedSymbol {
                        name: sym.name,
                        final_address: TEXT_BASE + text_offset + (sym.offset as u64),
                        obj_idx: obj_i,
                        sec_idx: sym.section,
                        is_external: false
                    }
                    map_set(lnk.symtab, sym.name, resolved)
                end
            end

            sym_i = sym_i + 1
        end

        # Accumulate text section sizes
        var sec_i = 0
        while sec_i < vec_len(obj.sections)
            var sec = vec_get(obj.sections, sec_i)
            if str_eq(sec.name, str_new("__text"))
                text_offset = text_offset + (buf_size(sec.data) as u64)
            end
            sec_i = sec_i + 1
        end

        obj_i = obj_i + 1
    end

    # Find _main entry point
    var main_sym = map_get(lnk.symtab, str_new("_main"))
    if main_sym != None
        lnk.entry_point = main_sym.final_address
    end

    out lnk
end


# ═══════════════════════════════════════════════════════
# Step 3: Apply Relocations
# ═══════════════════════════════════════════════════════

func linker_apply_relocations(lnk: Linker) -> Linker
    var obj_i = 0
    while obj_i < vec_len(lnk.objects)
        var obj = vec_get(lnk.objects, obj_i)

        var sec_i = 0
        while sec_i < vec_len(obj.sections)
            var sec = vec_get(obj.sections, sec_i)

            var rel_i = 0
            while rel_i < vec_len(sec.relocs)
                var reloc = vec_get(sec.relocs, rel_i)
                var target_sym = vec_get(obj.symbols, reloc.sym_idx)
                var resolved = map_get(lnk.symtab, target_sym.name)

                if resolved == None
                    vec_push(lnk.errors, format(
                        "Undefined symbol: {} (referenced in {})",
                        target_sym.name, obj.name))
                else
                    # Apply relocation based on type
                    if reloc.reloc_type == RelocType::Branch26
                        # ARM64 B/BL: 26-bit signed offset (in 4-byte units)
                        var pc = TEXT_BASE + (reloc.offset as u64)
                        var delta = (resolved.final_address - pc) as i64
                        var imm26 = ((delta >> 2) & 0x03FFFFFF) as u32
                        # Patch instruction: BL = 0x94000000 | imm26
                        patch_u32(sec.data, reloc.offset as i32,
                                  0x94000000 | imm26)
                    end

                    if reloc.reloc_type == RelocType::Page21
                        # ARM64 ADRP: 21-bit page offset
                        var pc_page = (TEXT_BASE + (reloc.offset as u64)) & ~0xFFF_u64
                        var sym_page = resolved.final_address & ~0xFFF_u64
                        var page_delta = ((sym_page - pc_page) >> 12) as i32
                        # Encode immhi:immlo into ADRP instruction
                        var immlo = (page_delta & 0x3) as u32
                        var immhi = ((page_delta >> 2) & 0x7FFFF) as u32
                        var insn = 0x90000000_u32 | (immlo << 29) | (immhi << 5)
                        patch_u32(sec.data, reloc.offset as i32, insn)
                    end

                    if reloc.reloc_type == RelocType::PageOff12
                        # ARM64 ADD: 12-bit page offset
                        var page_off = (resolved.final_address & 0xFFF) as u32
                        var insn = read_u32(sec.data, reloc.offset as i32)
                        insn = (insn & 0xFFC003FF_u32) | (page_off << 10)
                        patch_u32(sec.data, reloc.offset as i32, insn)
                    end

                    if reloc.reloc_type == RelocType::PC32
                        # x86-64: 32-bit PC-relative
                        var pc = TEXT_BASE + (reloc.offset as u64) + 4
                        var delta = (resolved.final_address - pc) as i32
                        patch_i32(sec.data, reloc.offset as i32, delta)
                    end
                end

                rel_i = rel_i + 1
            end

            sec_i = sec_i + 1
        end

        obj_i = obj_i + 1
    end
    out lnk
end


# ═══════════════════════════════════════════════════════
# Step 4: Merge Sections
# ═══════════════════════════════════════════════════════

func linker_merge_sections(lnk: Linker) -> Linker
    var obj_i = 0
    while obj_i < vec_len(lnk.objects)
        var obj = vec_get(lnk.objects, obj_i)

        var sec_i = 0
        while sec_i < vec_len(obj.sections)
            var sec = vec_get(obj.sections, sec_i)

            if str_eq(sec.seg_name, str_new("__TEXT"))
                lnk.text_buf = buf_write_bytes(lnk.text_buf, sec.data.data)
                # Align to 4 bytes for ARM64 instructions
                lnk.text_buf = buf_align(lnk.text_buf, 4)
            end

            if str_eq(sec.seg_name, str_new("__DATA"))
                lnk.data_buf = buf_write_bytes(lnk.data_buf, sec.data.data)
                lnk.data_buf = buf_align(lnk.data_buf, 8)
            end

            sec_i = sec_i + 1
        end

        obj_i = obj_i + 1
    end
    out lnk
end


# ═══════════════════════════════════════════════════════
# Step 5: Emit Final Executable
# ═══════════════════════════════════════════════════════

func linker_emit_executable(lnk: Linker, arch: Arch) -> Result<ByteBuffer, String>
    # Check for errors
    if vec_len(lnk.errors) > 0
        var msg = str_new("Linker errors:\n")
        var i = 0
        while i < vec_len(lnk.errors)
            msg = str_concat(msg, format("  - {}\n", vec_get(lnk.errors, i)))
            i = i + 1
        end
        out Err(msg)
    end

    var out = buf_new()

    var text_size = buf_size(lnk.text_buf) as u64
    var data_size = buf_size(lnk.data_buf) as u64

    # Align sizes to page boundaries
    var text_filesize = ((text_size + PAGE_SIZE - 1) / PAGE_SIZE) * PAGE_SIZE
    var data_filesize = ((data_size + PAGE_SIZE - 1) / PAGE_SIZE) * PAGE_SIZE

    # Load commands: __PAGEZERO + __TEXT + __DATA + LC_MAIN + LC_SYMTAB = 5
    var ncmds = 5_u32
    var header_and_cmds_size = 32 + 72 + (72 + 80) + (72 + 80) + 24 + 24

    # ── Mach-O Header ──
    out = buf_write_u32_le(out, MH_MAGIC_64)
    if arch == Arch::ARM64
        out = buf_write_u32_le(out, CPU_TYPE_ARM64)
    else
        out = buf_write_u32_le(out, CPU_TYPE_X86_64)
    end
    out = buf_write_u32_le(out, CPU_SUBTYPE_ALL)
    out = buf_write_u32_le(out, MH_EXECUTE)
    out = buf_write_u32_le(out, ncmds)
    out = buf_write_u32_le(out, (header_and_cmds_size - 32) as u32)
    out = buf_write_u32_le(out, 0x00200085_u32)  # MH_PIE | MH_TWOLEVEL | MH_DYLDLINK
    out = buf_write_u32_le(out, 0)               # reserved

    # ── LC_SEGMENT_64: __PAGEZERO ──
    out = buf_write_u32_le(out, LC_SEGMENT_64)
    out = buf_write_u32_le(out, 72)         # cmdsize (no sections)
    out = buf_write_string_padded(out, str_new("__PAGEZERO"), 16)
    out = buf_write_u64_le(out, 0)          # vmaddr
    out = buf_write_u64_le(out, TEXT_BASE)   # vmsize = 4GB
    out = buf_write_u64_le(out, 0)          # fileoff
    out = buf_write_u64_le(out, 0)          # filesize
    out = buf_write_u32_le(out, 0)          # maxprot
    out = buf_write_u32_le(out, 0)          # initprot
    out = buf_write_u32_le(out, 0)          # nsects
    out = buf_write_u32_le(out, 0)          # flags

    # ── LC_SEGMENT_64: __TEXT ──
    out = macho_emit_segment_cmd(out, str_new("__TEXT"), 1,
                                  0, text_filesize as i64)
    var text_sec = section_text()
    text_sec.data = lnk.text_buf
    out = macho_emit_section_hdr(out, text_sec,
                                  header_and_cmds_size as i64, 0)

    # ── LC_SEGMENT_64: __DATA ──
    out = macho_emit_segment_cmd(out, str_new("__DATA"), 1,
                                  text_filesize as i64, data_filesize as i64)
    var data_sec = section_data()
    data_sec.data = lnk.data_buf
    out = macho_emit_section_hdr(out, data_sec,
                                  (header_and_cmds_size as u64 + text_filesize) as i64, 0)

    # ── LC_MAIN ──
    out = buf_write_u32_le(out, LC_MAIN)
    out = buf_write_u32_le(out, 24)                        # cmdsize
    out = buf_write_u64_le(out, lnk.entry_point - TEXT_BASE)  # entryoff
    out = buf_write_u64_le(out, 0)                         # stacksize (default)

    # ── LC_SYMTAB (empty for minimal executable) ──
    out = macho_emit_symtab_cmd(out, 0, 0, 0, 0)

    # Pad header to page boundary
    var pad_needed = (text_filesize as i64) - (buf_size(out))
    if pad_needed > 0
        out = buf_write_zeros(out, pad_needed as i32)
    end

    # Write __TEXT data
    out = buf_write_bytes(out, lnk.text_buf.data)
    # Pad to page
    var text_pad = (text_filesize as i64) - (buf_size(lnk.text_buf))
    if text_pad > 0
        out = buf_write_zeros(out, text_pad as i32)
    end

    # Write __DATA data
    out = buf_write_bytes(out, lnk.data_buf.data)
    var data_pad = (data_filesize as i64) - (buf_size(lnk.data_buf))
    if data_pad > 0
        out = buf_write_zeros(out, data_pad as i32)
    end

    out Ok(out)
end


# ═══════════════════════════════════════════════════════
# High-Level API — Link and Produce Executable
# ═══════════════════════════════════════════════════════

func link_objects(objects: Vec<ObjectFile>, arch: Arch) -> Result<ByteBuffer, String>
    var lnk = linker_new()

    # Add all objects
    var i = 0
    while i < vec_len(objects)
        lnk = linker_add_object(lnk, vec_get(objects, i))
        i = i + 1
    end

    # Pipeline: resolve -> relocate -> merge -> emit
    lnk = linker_resolve_symbols(lnk)
    lnk = linker_apply_relocations(lnk)
    lnk = linker_merge_sections(lnk)

    out linker_emit_executable(lnk, arch)
end


func link_single_kernel(kernel_name: String, code: Vec<u8>,
                        arch: Arch) -> Result<ByteBuffer, String>
    # Convenience: wrap raw machine code into an object and link
    var obj = ObjectFile {
        name: format("{}.o", kernel_name),
        sections: vec_new(),
        symbols: vec_new(),
        relocs: vec_new()
    }

    var text = section_text()
    text.data = buf_new()
    text.data = buf_write_bytes(text.data, code)
    vec_push(obj.sections, text)

    vec_push(obj.symbols, Symbol {
        name: format("_main"),
        sym_type: SymbolType::Function,
        section: 1,
        offset: 0,
        size: vec_len(code) as i64,
        is_global: true
    })

    var objects = vec_new()
    vec_push(objects, obj)
    out link_objects(objects, arch)
end
