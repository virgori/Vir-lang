##
 * vir/rand/rand.vri — Pseudo-Random Number Generator
 * ====================================================
 * Inspired by Python: random
 * Triển khai: xoshiro256** (fast, high quality, non-cryptographic)
 *
 * Dùng cho: testing, fuzzing, hash seed randomization.
 ##

include types;
include time;
import unix_timestamp_nanos from time;

# ═══════════════════════════════════════════════════════
# RNG State — xoshiro256**
# ═══════════════════════════════════════════════════════

entity Rng:
    s0: int;
    s1: int;
    s2: int;
    s3: int;
end

func _rotl:
    in(x:int; k:int)
    out (x << k) | (x >> (64 - k));
end

# ─── Constructor ──────────────────────────────────────

func rng_new:
    in(seed:int)
    # Dùng SplitMix64 để seed xoshiro256** state
    r = Rng { s0 = 0, s1 = 0, s2 = 0, s3 = 0 };
    z = seed;
    z = (z ^ (z >> 30)) * 0xBF58476D1CE4E5B9;
    z = (z ^ (z >> 27)) * 0x94D049BB133111EB;
    z = z ^ (z >> 31);
    r.s0 = z;
    z = z + 0x9E3779B97F4A7C15;
    z = (z ^ (z >> 30)) * 0xBF58476D1CE4E5B9;
    z = (z ^ (z >> 27)) * 0x94D049BB133111EB;
    z = z ^ (z >> 31);
    r.s1 = z;
    z = z + 0x9E3779B97F4A7C15;
    z = (z ^ (z >> 30)) * 0xBF58476D1CE4E5B9;
    z = (z ^ (z >> 27)) * 0x94D049BB133111EB;
    z = z ^ (z >> 31);
    r.s2 = z;
    z = z + 0x9E3779B97F4A7C15;
    z = (z ^ (z >> 30)) * 0xBF58476D1CE4E5B9;
    z = (z ^ (z >> 27)) * 0x94D049BB133111EB;
    z = z ^ (z >> 31);
    r.s3 = z;
    out r;
end

func rng_from_time:
    out rng_new(unix_timestamp_nanos());
end

# ─── Core: next u64 ──────────────────────────────────

func rng_next_u64:
    in(r:Rng)
    result = _rotl(r.s1 * 5, 7) * 9;
    t = r.s1 << 17;
    
    r.s2 = r.s2 ^ r.s0;
    r.s3 = r.s3 ^ r.s1;
    r.s1 = r.s1 ^ r.s2;
    r.s0 = r.s0 ^ r.s3;
    r.s2 = r.s2 ^ t;
    r.s3 = _rotl(r.s3, 45);
    
    out result;
end

# ─── Derived ──────────────────────────────────────────

func rng_next_i64:
    in(r:Rng)
    out rng_next_u64(r);
end

func rng_next_u32:
    in(r:Rng)
    out (rng_next_u64(r) >> 32);
end

func rng_next_bool:
    in(r:Rng)
    out (rng_next_u64(r) & 1) == 1;
end

func rng_next_f64:
    in(r:Rng)
    # [0.0, 1.0)
    bits = rng_next_u64(r) >> 11   # 53-bit mantissa;
    out native_u64_to_f64(bits) * 1.1102230246251565e-16   # 2^-53;
end

func rng_range_i64:
    in(r:Rng; lo:int; hi:int)
    # Returns value ngẫu nhiên in [lo, hi).
    if lo >= hi out lo end:
    range = hi - lo;
    out lo + (rng_next_u64(r) % range);
end

func rng_range_usize:
    in(r:Rng; lo:int; hi:int)
    if lo >= hi out lo end:
    range = hi - lo;
    out lo + (rng_next_u64(r) % range);
end

func rng_range_f64:
    in(r:Rng; lo:float; hi:float)
    # [lo, hi)
    out lo + rng_next_f64(r) * (hi - lo);
end

# ─── Utilities ────────────────────────────────────────

func rng_shuffle<T>:
    in(r:Rng; v:Vec<T>)
    # Fisher-Yates shuffle.
    n = vec_len<T>(*v);
    if n <= 1 out end:
    i = n - 1;
    when i > 0 loop
        j = rng_range_usize(r, 0, i + 1);
        tmp = vec_get<T>(*v, i);
        vec_set<T>(v, i, vec_get<T>(*v, j));
        vec_set<T>(v, j, tmp);
        i = i - 1;
    end
end

func rng_choice<T>:
    in(r:Rng; v:Vec<T>)
    idx = rng_range_usize(r, 0, vec_len<T>(v));
    out vec_get<T>(v, idx);
end

func rng_fill_bytes:
    in(r:Rng; buf:ptr; len:int)
    i = 0;
    when i + 8 <= len loop
        val = rng_next_u64(r);
        native_store_u64(buf, i / 8, val);
        i = i + 8;
    end
    # Remaining bytes
    if i < len:
        val = rng_next_u64(r);
        when i < len loop
            native_store_u8(buf, i, val & 0xFF);
            val = val >> 8;
            i = i + 1;
        end
    end
end

# ═══════════════════════════════════════════════════════
# Global RNG (thread-local khi có thread support)
# ═══════════════════════════════════════════════════════

_global_rng = rng_from_time();

func random_u64:
    out rng_next_u64(&_global_rng);
end

func random_i64:
    out rng_next_i64(&_global_rng);
end

func random_f64:
    out rng_next_f64(&_global_rng);
end

func random_range:
    in(lo:int; hi:int)
    out rng_range_i64(&_global_rng, lo, hi);
end

func random_bool:
    out rng_next_bool(&_global_rng);
end

func seed_random:
    in(seed:int)
    _global_rng = rng_new(seed);
end
