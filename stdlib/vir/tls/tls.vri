##
 * vir/tls/tls.vri — TLS / SSL Wrapper
 * ======================================
 * Inspired by Python: ssl
 *
 * Phase C — wraps native TLS (OpenSSL / LibreSSL / BoringSSL)
 ##

include types;
include option;
import Option, Some, None from option;
include result;
import Result, Ok, Err from result;
include string;
import String, str_new from string;
include net;
import TcpStream from net;

# ═══════════════════════════════════════════════════════
# TLS Context & Configuration
# ═══════════════════════════════════════════════════════

enum TlsVersion:
    TLS_1_2 = 0x0303;
    TLS_1_3 = 0x0304;
end.

entity TlsConfig:
    _raw:            ptr    # native SSL_CTX*,
        min_version:     TlsVersion,
        verify_peer:     bool,
        ca_file:         Option<string>,
        cert_file:       Option<string>,
        key_file:        Option<string>;
end

extern func native_tls_ctx_new() -> ptr
extern func native_tls_ctx_free(ctx: ptr)
extern func native_tls_ctx_set_min_version(ctx: ptr, ver: int) -> int
extern func native_tls_ctx_set_verify(ctx: ptr, verify: bool) -> int
extern func native_tls_ctx_load_ca(ctx: ptr, path: ptr, path_len: int) -> int
extern func native_tls_ctx_load_cert(ctx: ptr, path: ptr, path_len: int) -> int
extern func native_tls_ctx_load_key(ctx: ptr, path: ptr, path_len: int) -> int

func tls_config_new:
    out TlsConfig (;
        _raw = native_tls_ctx_new(),
        min_version = TlsVersion.TLS_1_2,
        verify_peer = true,
        ca_file = None,
        cert_file = None,
        key_file = None
    );
end.

func tls_config_client:
    cfg = tls_config_new();
    cfg.verify_peer = true;
    out cfg;
end.

func tls_config_server:
    in(cert_path:string; key_path:string)
    cfg = tls_config_new();
    cfg.cert_file = Some(cert_path);
    cfg.key_file = Some(key_path);
    
    rc = native_tls_ctx_load_cert(cfg._raw, str_ptr(cert_path), str_byte_len(cert_path));
    if rc != 0 do out Err(str_new("failed to load certificate")) end
    
    rc = native_tls_ctx_load_key(cfg._raw, str_ptr(key_path), str_byte_len(key_path));
    if rc != 0 do out Err(str_new("failed to load private key")) end
    
    out Ok(cfg);
end.

func tls_config_set_ca:
    in(cfg:TlsConfig; ca_path:string)
    rc = native_tls_ctx_load_ca(cfg._raw, str_ptr(ca_path), str_byte_len(ca_path));
    if rc != 0 do out Err(str_new("failed to load CA file")) end
    cfg.ca_file = Some(ca_path);
    out Ok(());
end.

func tls_config_free:
    in(cfg:TlsConfig)
    native_tls_ctx_free(cfg._raw);
end

# ═══════════════════════════════════════════════════════
# TLS Stream (wraps TcpStream)
# ═══════════════════════════════════════════════════════

entity TlsStream:
    _ssl:   ptr     # native SSL*,
        _tcp:   TcpStream;
end

extern func native_tls_connect(ctx: ptr, fd: int, hostname: ptr, hostname_len: int) -> ptr
extern func native_tls_accept(ctx: ptr, fd: int) -> ptr
extern func native_tls_read(ssl: ptr, buf: ptr, len: int) -> int
extern func native_tls_write(ssl: ptr, buf: ptr, len: int) -> int
extern func native_tls_shutdown(ssl: ptr) -> int
extern func native_tls_free(ssl: ptr)
extern func native_tls_peer_cert_subject(ssl: ptr, buf: ptr, buf_len: int) -> int
extern func native_tls_get_alpn(ssl: ptr, buf: ptr, buf_len: int) -> int

# ─── Client ───────────────────────────────────────────

func tls_connect:
    in(cfg:TlsConfig; tcp:TcpStream; hostname:string)
    ssl = native_tls_connect(cfg._raw, tcp.fd, str_ptr(hostname), str_byte_len(hostname));
    if ssl == ptr_null() do
        out Err(str_new("TLS handshake failed"));
    end
    out Ok(TlsStream ( _ssl = ssl, _tcp = tcp ));
end

# ─── Server ───────────────────────────────────────────

func tls_accept:
    in(cfg:TlsConfig; tcp:TcpStream)
    ssl = native_tls_accept(cfg._raw, tcp.fd);
    if ssl == ptr_null() do
        out Err(str_new("TLS accept failed"));
    end
    out Ok(TlsStream ( _ssl = ssl, _tcp = tcp ));
end

# ─── Read / Write ─────────────────────────────────────

func tls_read:
    in(stream:TlsStream; buf:[int]; len:int)
    n = native_tls_read(stream._ssl, buf, len);
    if n < 0 do out Err(str_new("TLS read error")) end
    out Ok(n);
end.

func tls_write:
    in(stream:TlsStream; data:[int]; len:int)
    n = native_tls_write(stream._ssl, data, len);
    if n < 0 do out Err(str_new("TLS write error")) end
    out Ok(n);
end.

func tls_write_all:
    in(stream:TlsStream; data:[int]; len:int)
    written = 0;
    when written < len loop
        n = native_tls_write(stream._ssl, &data[written], len - written);
        if n <= 0 do out Err(str_new("TLS write error")) end
        written = written + n;
    end
    out Ok(());
end

# ─── Shutdown / Info ──────────────────────────────────

func tls_shutdown:
    in(stream:TlsStream)
    native_tls_shutdown(stream._ssl);
end.

func tls_close:
    in(stream:TlsStream)
    native_tls_shutdown(stream._ssl);
    native_tls_free(stream._ssl);
    native_socket_close(stream._tcp.fd);
end.

func tls_peer_subject:
    in(stream:TlsStream)
    var buf: [int; 512];
    n = native_tls_peer_cert_subject(stream._ssl, &buf, 512);
    if n <= 0 do out None end
    out Some(str_from_bytes(&buf, n));
end
