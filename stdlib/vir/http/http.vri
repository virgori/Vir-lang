##
 * vir/http/http.vri — HTTP/1.1 client facade
 ##

include types
include result
import Result, Ok, Err from result
include url
include string
import str_new, str_concat, str_eq, i64_to_str, str_from_bytes from string
include alloc
import vir_alloc from alloc
include net
include http.status

enum Method:
    GET     = 1
    POST    = 2
    PUT     = 3
    DELETE  = 4
    PATCH   = 5
    HEAD    = 6
    OPTIONS = 7
end.

entity Request:
    httpMethod: Method
    targetUrl: string
    body: string
    extraHeaders: string
    contentType: string
end.

entity Response:
    statusCode: int
    statusReason: string
    body: string
end.

func httpRequest(httpMethod: Method, targetUrl: string) -> Request:
    out Request (
        httpMethod: httpMethod,
        targetUrl: targetUrl,
        body: "",
        extraHeaders: "",
        contentType: "application/octet-stream"
    )
end.

func httpParseUrl(raw: string):
    out url.parse(raw)
end.

func httpRequestHeader(ref req: Request, key: string, value: string):
    let line = str_concat(str_concat(key, ": "), str_concat(value, "\r\n"))
    req.extraHeaders = str_concat(req.extraHeaders, line)
end.

func httpRequestBody(ref req: Request, body: string):
    req.body = body
end.

func httpStatus(resp: Response) -> int:
    out resp.statusCode
end.

func httpStatusText(resp: Response) -> string:
    if resp.statusReason != "" do
        out resp.statusReason
    end
    out status.phrase(resp.statusCode)
end.

func _httpMethodName(m: Method) -> string:
    if m == Method.GET do out "GET" end
    if m == Method.POST do out "POST" end
    if m == Method.PUT do out "PUT" end
    if m == Method.DELETE do out "DELETE" end
    if m == Method.PATCH do out "PATCH" end
    if m == Method.HEAD do out "HEAD" end
    if m == Method.OPTIONS do out "OPTIONS" end
    out "GET"
end.

func _httpCopyRange(data: int, from: int, to: int) -> string:
    let n = to - from
    if n <= 0 do out "" end
    let buf = vir_alloc(n + 1)
    var i = 0
    when i < n loop
        native_write_u8(buf, i, native_read_u8(data, from + i))
        i = i + 1
    end
    native_write_u8(buf, n, 0)
    out buf as string
end.

func _httpScanHeaderSep(data: int, raw_len: int) -> int:
    i = 0
    when i < raw_len - 3 loop
        if native_read_u8(data, i) == 13 and native_read_u8(data, i + 1) == 10 and native_read_u8(data, i + 2) == 13 and native_read_u8(data, i + 3) == 10 do
            out i
        end
        i = i + 1
    end
    out -1
end.

func _httpScanFirstCrlf(data: int, limit: int) -> int:
    i = 0
    when i < limit - 1 loop
        if native_read_u8(data, i) == 13 and native_read_u8(data, i + 1) == 10 do
            out i
        end
        i = i + 1
    end
    out limit
end.

func _httpCstrLen(data: int) -> int:
    n = 0
    when true loop
        if native_read_u8(data, n) == 0 do
            out n
        end
        n = n + 1
    end
end.

func httpParseResponse(raw: string):
    rp = raw as ptr
    data = rp as int
    raw_len = _httpPtrLen(rp)
    sep_idx = _httpScanHeaderSep(data, raw_len)
    if sep_idx < 0 do
        out Err(str_new("malformed HTTP response"))
    end
    status_end = _httpScanFirstCrlf(data, sep_idx)
    if status_end < 12 do
        out Err(str_new("malformed status line"))
    end
    code = (native_read_u8(data, 9) - 48) * 100 + (native_read_u8(data, 10) - 48) * 10 + (native_read_u8(data, 11) - 48)
    var reason = ""
    if status_end <= 13 do
        reason = status.phrase(code)
    else
        reason = _httpCopyRange(data, 13, status_end)
        if reason == "" do
            reason = status.phrase(code)
        end
    end
    body_off = sep_idx + 4
    var body = ""
    if body_off > raw_len do
        body = ""
    else
        body = _httpCopyRange(data, body_off, raw_len)
    end
    out Ok(Response(statusCode: code, statusReason: reason, body: body))
end.

func _httpPtrLen(p: ptr) -> int:
    data = p as int
    if data == 0 do
        out 0
    end
    n = 0
    when native_read_u8(data, n) != 0 loop
        n = n + 1
    end
    out n
end.

func _httpStrEmpty(s: string) -> bool:
    out _httpPtrLen(s as ptr) == 0
end.

func _httpBytesClone(sp: ptr, n: int) -> string:
    if n <= 0 do
        out str_new("")
    end
    buf = vir_alloc(n + 1)
    i = 0
    when i < n loop
        native_write_u8(buf, i, native_read_u8(sp as int, i))
        i = i + 1
    end
    native_write_u8(buf, n, 0)
    out buf as string
end.

func _httpWriteCstr(p: int, n: int, lit: string) -> int:
    lp = lit as ptr
    i = 0
    when i < _httpPtrLen(lp) loop
        native_write_u8(p, n, native_read_u8(lp as int, i))
        n = n + 1
        i = i + 1
    end
    out n
end.

func _httpWriteStr(p: int, n: int, text: string) -> int:
    tp = text as ptr
    i = 0
    when i < _httpPtrLen(tp) loop
        native_write_u8(p, n, native_read_u8(tp as int, i))
        n = n + 1
        i = i + 1
    end
    out n
end.

func _httpWriteI64(p: int, n: int, v: int) -> int:
    out _httpWriteStr(p, n, i64_to_str(v))
end.

func _httpBuildRequestParts(
    req: Request,
    pathLine: string,
    queryPart: string,
    hostPart: string,
    listenPort: int,
    defaultPort: int
) -> string:
    extra = req.extraHeaders
    bodyPart = req.body
    ctype = req.contentType
    p = vir_alloc(8192)
    n = 0
    n = _httpWriteStr(p, n, _httpMethodName(req.httpMethod))
    n = _httpWriteCstr(p, n, " ")
    pathUse = pathLine
    if _httpPtrLen(pathUse as ptr) == 0 do
        pathUse = str_new("/")
    end
    n = _httpWriteStr(p, n, pathUse)
    if _httpPtrLen(queryPart as ptr) > 0 do
        n = _httpWriteCstr(p, n, "?")
        n = _httpWriteStr(p, n, queryPart)
    end
    n = _httpWriteCstr(p, n, " HTTP/1.1\r\nHost: ")
    n = _httpWriteStr(p, n, hostPart)
    if listenPort > 0 and listenPort != defaultPort do
        n = _httpWriteCstr(p, n, ":")
        n = _httpWriteI64(p, n, listenPort)
    end
    n = _httpWriteCstr(p, n, "\r\nConnection: close\r\nUser-Agent: VirHttp/1.0\r\n")
    if _httpPtrLen(extra as ptr) > 0 do
        n = _httpWriteStr(p, n, extra)
    end
    blen = _httpPtrLen(bodyPart as ptr)
    if blen > 0 do
        n = _httpWriteCstr(p, n, "Content-Type: ")
        n = _httpWriteStr(p, n, ctype)
        n = _httpWriteCstr(p, n, "\r\nContent-Length: ")
        n = _httpWriteI64(p, n, blen)
        n = _httpWriteCstr(p, n, "\r\n")
    end
    n = _httpWriteCstr(p, n, "\r\n")
    if blen > 0 do
        n = _httpWriteStr(p, n, bodyPart)
    end
    out str_from_bytes(p as ptr, n)
end.

func _httpSchemeIs(u: Url, name: string) -> bool:
    out str_eq(u.scheme, name)
end.

func _httpSendUrl(req: Request, u: Url):
    scheme = u.scheme
    if str_eq(scheme, str_new("https")) do
        out Err(str_new("https requires tls module"))
    end
    if str_eq(scheme, str_new("http")) == false do
        out Err(str_new("unsupported URL scheme"))
    end
    pathLine = u.path
    queryPart = u.query
    listenPort = u.port_num
    hostPtr = u.host as ptr
    hostLen = _httpPtrLen(hostPtr)
    hostForHeader = _httpBytesClone(hostPtr, hostLen)
    hostForConnect = _httpBytesClone(hostPtr, hostLen)
    defaultPort = 80
    if listenPort <= 0 do
        listenPort = 80
    end
    wire = _httpBuildRequestParts(req, pathLine, queryPart, hostForHeader, listenPort, defaultPort)
    case net.connectHost(hostForConnect, listenPort)
    Ok(stream):
        case net.writeAll(stream, wire)
        Ok(_):
            case net.readAll(stream)
            Ok(raw):
                net.close(stream)
                out httpParseResponse(raw)
            Err(e):
                net.close(stream)
                out Err(e)
            end
        Err(_):
            net.close(stream)
            out Err(str_new("write failed"))
        end
    Err(_):
        out Err(str_new("connection failed"))
    end
end.

func httpSend(req: Request):
    target = req.targetUrl
    case url.parse(target)
    Ok(u):
        out _httpSendUrl(req, u)
    Err(_):
        out Err(str_new("invalid URL"))
    end
end.

func httpGet(targetUrl: string):
    out httpSend(httpRequest(Method.GET, targetUrl))
end.

func httpPost(targetUrl: string, body: string, contentType: string):
    var req = httpRequest(Method.POST, targetUrl)
    httpRequestBody(req, body)
    req.contentType = contentType
    out httpSend(req)
end.

entity HttpNamespace:
    method request(httpMethod: Method, targetUrl: string) -> Request:
        out httpRequest(httpMethod, targetUrl)
    end.
    method requestHeader(ref req: Request, key: string, value: string):
        httpRequestHeader(req, key, value)
    end.
    method requestBody(ref req: Request, body: string):
        httpRequestBody(req, body)
    end.
    method parseUrl(raw: string):
        out httpParseUrl(raw)
    end.
    method send(req: Request):
        out httpSend(req)
    end.
    method get(targetUrl: string):
        out httpGet(targetUrl)
    end.
    method post(targetUrl: string, body: string, contentType: string):
        out httpPost(targetUrl, body, contentType)
    end.
    method status(resp: Response) -> int:
        out httpStatus(resp)
    end.
    method statusText(resp: Response) -> string:
        out httpStatusText(resp)
    end.
    method parseResponse(raw: string):
        out httpParseResponse(raw)
    end.
end.

var http: HttpNamespace

export Method, Request, Response, HttpNamespace, http
