# ═════════════════════════════════════════════════════════════════════
# Module: static/mime.vri
# Pure Vir IANA-Standard MIME Type Registry (50+ extensions)
# ═════════════════════════════════════════════════════════════════════

include types
include rt.syscall
include url

# Length of a NUL-terminated C-string at address (avoids moving `string`)
func mime_str_len(addr: int) -> int:
    if addr == 0 do out 0 end
    var i = 0
    when read_byte(addr as ptr, i) != 0 loop
        i = i + 1
    end
    out i
end.

# Case-insensitive ASCII compare of two C-strings by address
func mime_str_eq_ci(a: int, b: int) -> bool:
    var la = mime_str_len(a)
    var lb = mime_str_len(b)
    if la != lb do out false end
    var i = 0
    when i < la loop
        var ca = read_byte(a as ptr, i)
        var cb = read_byte(b as ptr, i)
        if ca >= 65 and ca <= 90 do ca = ca + 32 end
        if cb >= 65 and cb <= 90 do cb = cb + 32 end
        if ca != cb do out false end
        i = i + 1
    end
    out true
end.

# Lookup MIME type by raw extension without dot (e.g. "html", "css", "png")
func mime_lookup_by_extension(ext: string) -> string:
    let ea = ext as int
    var l = mime_str_len(ea)
    if l == 0 do out "application/octet-stream" end

    # 1. Web Core
    if mime_str_eq_ci(ea, "html" as int) or mime_str_eq_ci(ea, "htm" as int) do out "text/html; charset=utf-8" end
    if mime_str_eq_ci(ea, "css" as int) do out "text/css; charset=utf-8" end
    if mime_str_eq_ci(ea, "js" as int) or mime_str_eq_ci(ea, "mjs" as int) do out "text/javascript; charset=utf-8" end
    if mime_str_eq_ci(ea, "json" as int) do out "application/json" end
    if mime_str_eq_ci(ea, "webmanifest" as int) do out "application/manifest+json; charset=utf-8" end
    if mime_str_eq_ci(ea, "wasm" as int) do out "application/wasm" end
    if mime_str_eq_ci(ea, "xml" as int) do out "application/xml" end

    # 2. Images
    if mime_str_eq_ci(ea, "png" as int) do out "image/png" end
    if mime_str_eq_ci(ea, "jpg" as int) or mime_str_eq_ci(ea, "jpeg" as int) do out "image/jpeg" end
    if mime_str_eq_ci(ea, "webp" as int) do out "image/webp" end
    if mime_str_eq_ci(ea, "gif" as int) do out "image/gif" end
    if mime_str_eq_ci(ea, "svg" as int) do out "image/svg+xml" end
    if mime_str_eq_ci(ea, "ico" as int) do out "image/x-icon" end
    if mime_str_eq_ci(ea, "bmp" as int) do out "image/bmp" end
    if mime_str_eq_ci(ea, "tiff" as int) do out "image/tiff" end
    if mime_str_eq_ci(ea, "avif" as int) do out "image/avif" end

    # 3. Audio / Video
    if mime_str_eq_ci(ea, "mp4" as int) do out "video/mp4" end
    if mime_str_eq_ci(ea, "webm" as int) do out "video/webm" end
    if mime_str_eq_ci(ea, "ogg" as int) do out "video/ogg" end
    if mime_str_eq_ci(ea, "mkv" as int) do out "video/x-matroska" end
    if mime_str_eq_ci(ea, "avi" as int) do out "video/x-msvideo" end
    if mime_str_eq_ci(ea, "mp3" as int) do out "audio/mpeg" end
    if mime_str_eq_ci(ea, "wav" as int) do out "audio/wav" end
    if mime_str_eq_ci(ea, "flac" as int) do out "audio/flac" end
    if mime_str_eq_ci(ea, "m4a" as int) do out "audio/mp4" end

    # 4. Fonts
    if mime_str_eq_ci(ea, "woff2" as int) do out "font/woff2" end
    if mime_str_eq_ci(ea, "woff" as int) do out "font/woff" end
    if mime_str_eq_ci(ea, "ttf" as int) do out "font/ttf" end
    if mime_str_eq_ci(ea, "otf" as int) do out "font/otf" end
    if mime_str_eq_ci(ea, "eot" as int) do out "application/vnd.ms-fontobject" end

    # 5. Documents & Text
    if mime_str_eq_ci(ea, "pdf" as int) do out "application/pdf" end
    if mime_str_eq_ci(ea, "txt" as int) do out "text/plain; charset=utf-8" end
    if mime_str_eq_ci(ea, "csv" as int) do out "text/csv; charset=utf-8" end
    if mime_str_eq_ci(ea, "md" as int) do out "text/markdown; charset=utf-8" end
    if mime_str_eq_ci(ea, "vri" as int) do out "text/x-vir; charset=utf-8" end
    if mime_str_eq_ci(ea, "jsonld" as int) do out "application/ld+json" end

    # 6. Archives & Bundles
    if mime_str_eq_ci(ea, "zip" as int) do out "application/zip" end
    if mime_str_eq_ci(ea, "gz" as int) do out "application/gzip" end
    if mime_str_eq_ci(ea, "tar" as int) do out "application/x-tar" end
    if mime_str_eq_ci(ea, "7z" as int) do out "application/x-7z-compressed" end
    if mime_str_eq_ci(ea, "rar" as int) do out "application/vnd.rar" end

    # 7. Office / Productivity
    if mime_str_eq_ci(ea, "docx" as int) do out "application/vnd.openxmlformats-officedocument.wordprocessingml.document" end
    if mime_str_eq_ci(ea, "xlsx" as int) do out "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" end
    if mime_str_eq_ci(ea, "pptx" as int) do out "application/vnd.openxmlformats-officedocument.presentationml.presentation" end
    if mime_str_eq_ci(ea, "epub" as int) do out "application/epub+zip" end

    out "application/octet-stream"
end.

# Extract file extension from filepath and lookup MIME type
func mime_lookup_by_filename(filename: string) -> string:
    let f_addr = filename as int
    var flen = mime_str_len(f_addr)
    if flen == 0 do out "application/octet-stream" end

    # Special case: manifest.json
    if flen >= 13 do
        var sub = url_copy_substr(f_addr, flen - 13, flen)
        if mime_str_eq_ci(sub as int, "manifest.json" as int) do
            out "application/manifest+json; charset=utf-8"
        end
    end

    # Scan from end backwards for last '.'
    var fp = f_addr as ptr
    var p = flen - 1
    var dot_idx = 0 - 1
    var scanning = true
    when scanning loop
        if p >= 0 do
            var b = read_byte(fp, p)
            if b == 46 do
                dot_idx = p
                scanning = false
            else
                if b == 47 or b == 92 do
                    scanning = false
                else
                    p = p - 1
                end
            end
        else
            scanning = false
        end
    end

    if dot_idx < 0 or dot_idx >= (flen - 1) do
        out "application/octet-stream"
    end

    var ext = url_copy_substr(f_addr, dot_idx + 1, flen)
    out mime_lookup_by_extension(ext)
end.

entity MimeNamespace:
    method byExtension(ext: string) -> string:
        out mime_lookup_by_extension(ext)
    end.
    method byFilename(filename: string) -> string:
        out mime_lookup_by_filename(filename)
    end.
end.

var mime: MimeNamespace

export MimeNamespace, mime, mime_lookup_by_extension, mime_lookup_by_filename, mime_str_len, mime_str_eq_ci
