include types
include result
import Result, Ok, Err from result
include url
include string
import str_new, str_slice_bytes from string
include protocol.http_status
import phrase from protocol.http_status

enum Method:
    GET = 1
    POST = 2
end.

entity Request:
    httpMethod: Method
    targetUrl: string
    body: string
    extraHeaders: string
    contentType: string
end.

entity Response:
    statusCode: int
    statusReason: string
    body: string
end.

func httpParseResponse(raw: string):
    out Err(str_new("todo"))
end.

func httpSend(req: Request):
    case url.parse(req.targetUrl)
    Ok(_):
        out Err(str_new("todo"))
    Err(_):
        out Err(str_new("invalid URL"))
    end
end.

entity HttpNamespace:
    method parseUrl(raw: string):
        out url.parse(raw)
    end.
    method send(req: Request):
        out httpSend(req)
    end.
end.

var http: HttpNamespace
export Method, Request, Response, HttpNamespace, http
