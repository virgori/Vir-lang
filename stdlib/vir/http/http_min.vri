include types
include result
import Result, Success, Failure from result
include url
include string
import str_new, str_slice_bytes from string
include http.status

enum Method:
    GET = 1
    POST = 2
end.

entity Request:
    httpMethod: Method
    targetUrl: string
    body: string
    extraHeaders: string
    contentType: string
end.

entity Response:
    statusCode: int
    statusReason: string
    body: string
end.

func httpParseResponse(raw: string):
    out Failure(str_new("todo"))
end.

func httpSend(req: Request):
    case url.parse(req.targetUrl)
    Success(_):
        out Failure(str_new("todo"))
    Failure(_):
        out Failure(str_new("invalid URL"))
    end
end.

entity HttpNamespace:
    method parseUrl(raw: string):
        out url.parse(raw)
    end
    method send(req: Request):
        out httpSend(req)
    end
end.

var http: HttpNamespace
export Method, Request, Response, HttpNamespace, http
