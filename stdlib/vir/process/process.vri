##
 * vir/process/process.vri — Process Spawning & Management
 * =========================================================
 * Inspired by Python: subprocess
 * Inspired by C: fork, exec, waitpid, pipe
 *
 * Dùng cho: chạy external tools, build toolchain.
 ##

include types;
include result;
import Result, Ok, Err from result;
include option;
import Option, Some, None from option;
include string;
import String, str_new from string;
include vec;
import Vec, vec_new, vec_push, vec_len, vec_get from vec;

# ═══════════════════════════════════════════════════════
# Process Builder
# ═══════════════════════════════════════════════════════

enum Stdio:
    Inherit = 0   # Kế thừa từ parent;
    Pipe    = 1   # Capture output;
    Null    = 2   # /dev/null;
end

entity Command:
    program: string;
    args:    Vec<string>;
    cwd:     Option<string>;
    env:     Vec<EnvPair>;
    stdin:   Stdio;
    stdout:  Stdio;
    stderr:  Stdio;
end

entity EnvPair:
    key: string;
    val: string;
end

func command_new:
    in(program:string)
    out Command {;
        program = program,;
        args = vec_new<string>(),;
        cwd = None,;
        env = vec_new<EnvPair>(),;
        stdin = Stdio.Inherit,;
        stdout = Stdio.Inherit,;
        stderr = Stdio.Inherit;
    };
end

func command_arg:
    in(cmd:Command; arg:string)
    vec_push<string>(&cmd.args, arg);
end

func command_args:
    in(cmd:Command; args:Vec<string>)
    i = 0;
    when i < vec_len<String>(args) loop
        vec_push<string>(&cmd.args, vec_get<string>(args, i));
        i = i + 1;
    end
end

func command_cwd:
    in(cmd:Command; dir:string)
    cmd.cwd = Some(dir);
end

func command_env:
    in(cmd:Command; key:string; val:string)
    vec_push<EnvPair>(&cmd.env, EnvPair { key = key, val = val });
end

func command_stdin:
    in(cmd:Command; s:Stdio)
    cmd.stdin = s;
end

func command_stdout:
    in(cmd:Command; s:Stdio)
    cmd.stdout = s;
end

func command_stderr:
    in(cmd:Command; s:Stdio)
    cmd.stderr = s;
end

# ═══════════════════════════════════════════════════════
# Process Output
# ═══════════════════════════════════════════════════════

entity Output:
    exit_code: int;
    stdout:    string    # captured if Stdio.Pipe;
    stderr:    string    # captured if Stdio.Pipe;
end

entity Child:
    pid:       int;
    stdin_fd:  Option<int>   # fd if piped;
    stdout_fd: Option<int>;
    stderr_fd: Option<int>;
end

# ═══════════════════════════════════════════════════════
# Execution
# ═══════════════════════════════════════════════════════

func command_spawn:
    in(cmd:Command)
    # Khởi chạy process con, out Child handle.
    child_pid = 0;
    stdin_fd = -1;
    stdout_fd = -1;
    stderr_fd = -1;
    
    rc = native_spawn(;
        cmd.program.data, cmd.program.byte_len,;
        &cmd.args, &cmd.env,;
        cmd.cwd,;
        cmd.stdin, cmd.stdout, cmd.stderr,;
        &child_pid, &stdin_fd, &stdout_fd, &stderr_fd;
    );
    
    if rc != 0:
        out Err(str_new("spawn failed"));
    end
    
    out Ok(Child {;
        pid = child_pid,;
        stdin_fd = if stdin_fd >= 0 Some(stdin_fd) else None end,;
        stdout_fd = if stdout_fd >= 0 Some(stdout_fd) else None end,;
        stderr_fd = if stderr_fd >= 0 Some(stderr_fd) else None end;
    });
end

func child_wait:
    in(c:Child)
    # Chờ process con kết thúc, out exit code.
    status = 0;
    rc = native_waitpid(c.pid, &status);
    if rc < 0 out Err(str_new("waitpid failed")) end:
    out Ok(status);
end

func child_kill:
    in(c:Child)
    rc = native_kill(c.pid, 9)   # SIGKILL;
    if rc != 0 out Err(str_new("kill failed")) end:
    out Ok(void);
end

func command_output:
    in(cmd:Command)
    # Run, chờ kết thúc, capture stdout/stderr.
    piped = cmd;
    piped.stdout = Stdio.Pipe;
    piped.stderr = Stdio.Pipe;
    
    child_result = command_spawn(piped);
    case child_result;
        case Err(e) out Err(e)
        case Ok(child)
            # Đọc stdout
            stdout_str = str_new("");
            case child.stdout_fd;
                case Some(fd)
                    stdout_str = native_read_all_fd(fd);
                    native_close(fd);
                case None {}
            end
            
            # Đọc stderr
            stderr_str = str_new("");
            case child.stderr_fd;
                case Some(fd)
                    stderr_str = native_read_all_fd(fd);
                    native_close(fd);
                case None {}
            end
            
            wait_result = child_wait(&child);
            case wait_result;
                case Err(e) out Err(e)
                case Ok(code)
                    out Ok(Output {;
                        exit_code = code,;
                        stdout = stdout_str,;
                        stderr = stderr_str;
                    });
            end
    end
end

func command_status:
    in(cmd:Command)
    # Run, chờ, chỉ lấy exit code.
    child_result = command_spawn(cmd);
    case child_result;
        case Err(e) out Err(e)
        case Ok(child) out child_wait(&child)
    end
end

# ─── Convenience ──────────────────────────────────────

func run:
    in(program:string; args:Vec<string>)
    cmd = command_new(program);
    command_args(&cmd, args);
    out command_output(cmd);
end

func shell:
    in(script:string)
    # Chạy qua /bin/sh -c "script"
    cmd = command_new(str_new("/bin/sh"));
    command_arg(&cmd, str_new("-c"));
    command_arg(&cmd, script);
    out command_output(cmd);
end
