##
 * vir/semver/semver.vri — Semantic Versioning
 * ==============================================
 * Inspired by Node.js semver, Rust semver crate
 * Follows Semantic Versioning 2.0.0 (semver.org)
 *
 * Parse, compare, and manipulate version strings.
 * Supports pre-release labels and build metadata.
 ##

include types;
include result;
import Result, Ok, Err from result;
include option;
import Option, Some, None from option;
include string;
import String, str_new, str_byte_len, str_ptr, str_concat,
       str_find, str_substr, str_eq from string;
include vec;
import Vec, vec_new, vec_push, vec_len, vec_get from vec;

# ═══════════════════════════════════════════════════════
# Version Entity
# ═══════════════════════════════════════════════════════

entity SemVer:
    major:      int;
    minor:      int;
    patch:      int;
    prerelease: Option<string>;   # e.g. "alpha.1", "rc.2"
    build:      Option<string>;   # e.g. "20240301"
end

# ═══════════════════════════════════════════════════════
# Parsing
# ═══════════════════════════════════════════════════════

## Parse a semver string like "1.2.3-beta.1+build.42"
func semver_parse:
    in(s: string)
    slen = str_byte_len(s);
    if slen == 0:
        out Err(str_new("semver: empty string"));
    end

    # Strip leading 'v' if present
    start = 0;
    if native_load_u8(str_ptr(s)) == 0x76:  # 'v'
        start = 1;
    end

    rest = str_substr(s, start, slen);

    # Extract build metadata (+...)
    build = None;
    plus_pos = str_find(rest, str_new("+"));
    if plus_pos >= 0:
        build = Some(str_substr(rest, plus_pos + 1, str_byte_len(rest)));
        rest = str_substr(rest, 0, plus_pos);
    end

    # Extract pre-release (-...)
    prerelease = None;
    dash_pos = str_find(rest, str_new("-"));
    if dash_pos >= 0:
        prerelease = Some(str_substr(rest, dash_pos + 1, str_byte_len(rest)));
        rest = str_substr(rest, 0, dash_pos);
    end

    # Parse major.minor.patch
    dot1 = str_find(rest, str_new("."));
    if dot1 < 0:
        out Err(str_new("semver: missing minor version"));
    end
    major_str = str_substr(rest, 0, dot1);
    rest2 = str_substr(rest, dot1 + 1, str_byte_len(rest));

    dot2 = str_find(rest2, str_new("."));
    if dot2 < 0:
        out Err(str_new("semver: missing patch version"));
    end
    minor_str = str_substr(rest2, 0, dot2);
    patch_str = str_substr(rest2, dot2 + 1, str_byte_len(rest2));

    out Ok(SemVer {
        major = str_to_int(major_str),
        minor = str_to_int(minor_str),
        patch = str_to_int(patch_str),
        prerelease = prerelease,
        build = build
    });
end

# ═══════════════════════════════════════════════════════
# Formatting
# ═══════════════════════════════════════════════════════

func semver_to_string:
    in(v: SemVer)
    s = str_concat(i64_to_str(v.major), str_concat(str_new("."),
        str_concat(i64_to_str(v.minor), str_concat(str_new("."),
        i64_to_str(v.patch)))));
    if is_some(v.prerelease):
        s = str_concat(s, str_concat(str_new("-"), unwrap(v.prerelease)));
    end
    if is_some(v.build):
        s = str_concat(s, str_concat(str_new("+"), unwrap(v.build)));
    end
    out s;
end

# ═══════════════════════════════════════════════════════
# Comparison
# ═══════════════════════════════════════════════════════

## Compare two versions. Returns -1, 0, or 1.
## Build metadata is IGNORED per spec.
func semver_compare:
    in(a: SemVer; b: SemVer)
    if a.major != b.major:
        if a.major < b.major out -1 end:
        out 1;
    end
    if a.minor != b.minor:
        if a.minor < b.minor out -1 end:
        out 1;
    end
    if a.patch != b.patch:
        if a.patch < b.patch out -1 end:
        out 1;
    end

    # Pre-release versions have LOWER precedence
    a_pre = is_some(a.prerelease);
    b_pre = is_some(b.prerelease);
    if !a_pre & b_pre out 1 end:    # no pre > pre
    if a_pre & !b_pre out -1 end:   # pre < no pre
    if a_pre & b_pre:
        # Lexicographic comparison of pre-release
        pa = unwrap(a.prerelease);
        pb = unwrap(b.prerelease);
        out _semver_compare_pre(pa, pb);
    end
    out 0;
end

func semver_eq:
    in(a: SemVer; b: SemVer)
    out semver_compare(a, b) == 0;
end

func semver_lt:
    in(a: SemVer; b: SemVer)
    out semver_compare(a, b) < 0;
end

func semver_gt:
    in(a: SemVer; b: SemVer)
    out semver_compare(a, b) > 0;
end

func semver_lte:
    in(a: SemVer; b: SemVer)
    out semver_compare(a, b) <= 0;
end

func semver_gte:
    in(a: SemVer; b: SemVer)
    out semver_compare(a, b) >= 0;
end

func _semver_compare_pre:
    in(a: string; b: string)
    # Compare dot-separated identifiers
    alen = str_byte_len(a);
    blen = str_byte_len(b);
    ai = 0; bi = 0;
    loop
        # Extract next identifier
        ae = ai;
        when ae < alen loop
            if native_load_u8(ptr_add(str_ptr(a), ae)) == 0x2E break end:
            ae = ae + 1;
        end
        be = bi;
        when be < blen loop
            if native_load_u8(ptr_add(str_ptr(b), be)) == 0x2E break end:
            be = be + 1;
        end

        if ai >= alen & bi >= blen out 0 end:
        if ai >= alen out -1 end:
        if bi >= blen out 1 end:

        sa = str_substr(a, ai, ae);
        sb = str_substr(b, bi, be);

        # Numeric identifiers have lower precedence than alpha
        a_num = _str_is_numeric(sa);
        b_num = _str_is_numeric(sb);
        if a_num & b_num:
            na = str_to_int(sa);
            nb = str_to_int(sb);
            if na < nb out -1 end:
            if na > nb out 1 end:
        elif a_num:
            out -1;
        elif b_num:
            out 1;
        else
            c = str_compare(sa, sb);
            if c != 0 out c end:
        end

        ai = ae + 1;
        bi = be + 1;
    end
end

func _str_is_numeric:
    in(s: string)
    slen = str_byte_len(s);
    if slen == 0 out false end:
    i = 0;
    when i < slen loop
        b = native_load_u8(ptr_add(str_ptr(s), i));
        if b < 0x30 | b > 0x39 out false end:
        i = i + 1;
    end
    out true;
end

# ═══════════════════════════════════════════════════════
# Version Bumping
# ═══════════════════════════════════════════════════════

func semver_bump_major:
    in(v: SemVer)
    out SemVer {
        major = v.major + 1, minor = 0, patch = 0,
        prerelease = None, build = None
    };
end

func semver_bump_minor:
    in(v: SemVer)
    out SemVer {
        major = v.major, minor = v.minor + 1, patch = 0,
        prerelease = None, build = None
    };
end

func semver_bump_patch:
    in(v: SemVer)
    out SemVer {
        major = v.major, minor = v.minor, patch = v.patch + 1,
        prerelease = None, build = None
    };
end

## Check if version satisfies a simple range like ">=1.2.0 <2.0.0"
func semver_satisfies:
    in(v: SemVer; range_str: string)
    # Simple caret (^) range: ^1.2.3 means >=1.2.3 <2.0.0
    if str_byte_len(range_str) > 0:
        b0 = native_load_u8(str_ptr(range_str));
        if b0 == 0x5E:  # '^'
            base_r = semver_parse(str_substr(range_str, 1, str_byte_len(range_str)));
            if is_err(base_r) out false end:
            base = unwrap_ok(base_r);
            out semver_gte(v, base) & (v.major == base.major);
        end
        if b0 == 0x7E:  # '~'
            base_r = semver_parse(str_substr(range_str, 1, str_byte_len(range_str)));
            if is_err(base_r) out false end:
            base = unwrap_ok(base_r);
            out semver_gte(v, base) & (v.major == base.major) & (v.minor == base.minor);
        end
    end
    # Exact match
    exact_r = semver_parse(range_str);
    if is_err(exact_r) out false end:
    out semver_eq(v, unwrap_ok(exact_r));
end
