##
 * vir/sql/sql.vri — Database Access (SQL)
 * =========================================
 * Inspired by Python: sqlite3, DB-API 2.0
 *
 * Phase C — generic DB interface + SQLite binding
 ##

include types;
include option;
import Option, Some, None from option;
include result;
import Result, Ok, Err from result;
include string;
import String, str_new from string;
include vec;
import Vec, vec_new, vec_push, vec_len, vec_get from vec;
include map;
import Map, map_new, map_set from map;

# ═══════════════════════════════════════════════════════
# Value types
# ═══════════════════════════════════════════════════════

enum SqlValue:
    Null;
    Integer(int);
    Real(float);
    Text(string);
    Blob(Vec<int>);
end.

entity Row:
    columns: Vec<string>,
        values:  Vec<SqlValue>;
end.

func row_get:
    in(row:Row; col:string)
    i = 0;
    when i < vec_len<String>(row.columns) loop
        if str_eq(vec_get<String>(row.columns, i), col) do
            out Some(vec_get<SqlValue>(row.values, i));
        end
        i = i + 1;
    end
    out None;
end.

func row_get_int:
    in(row:Row; col:string)
    val = row_get(row, col);
    case val;
        case Some(SqlValue.Integer(n)) out Some(n)
        default out None;
    end
end.

func row_get_str:
    in(row:Row; col:string)
    val = row_get(row, col);
    case val;
        case Some(SqlValue.Text(s)) out Some(s)
        default out None;
    end
end

# ═══════════════════════════════════════════════════════
# Connection (SQLite)
# ═══════════════════════════════════════════════════════

entity Connection:
    _db: ptr    # sqlite3*;
end.

entity Statement:
    _stmt: ptr   # sqlite3_stmt*,
        _conn: ptr;
end

extern func native_sqlite3_open(path: ptr, path_len: int) -> ptr
extern func native_sqlite3_close(db: ptr) -> int
extern func native_sqlite3_exec(db: ptr, sql: ptr, sql_len: int) -> int
extern func native_sqlite3_errmsg(db: ptr, buf: ptr, buf_len: int) -> int
extern func native_sqlite3_prepare(db: ptr, sql: ptr, sql_len: int) -> ptr
extern func native_sqlite3_bind_null(stmt: ptr, idx: int) -> int
extern func native_sqlite3_bind_int(stmt: ptr, idx: int, val: int) -> int
extern func native_sqlite3_bind_double(stmt: ptr, idx: int, val: float) -> int
extern func native_sqlite3_bind_text(stmt: ptr, idx: int, text: ptr, len: int) -> int
extern func native_sqlite3_bind_blob(stmt: ptr, idx: int, data: ptr, len: int) -> int
extern func native_sqlite3_step(stmt: ptr) -> int   # 100=SQLITE_ROW, 101=SQLITE_DONE
extern func native_sqlite3_column_count(stmt: ptr) -> int
extern func native_sqlite3_column_name(stmt: ptr, idx: int, buf: ptr, buf_len: int) -> int
extern func native_sqlite3_column_type(stmt: ptr, idx: int) -> int  # 1=INT,2=FLOAT,3=TEXT,4=BLOB,5=NULL
extern func native_sqlite3_column_int(stmt: ptr, idx: int) -> int
extern func native_sqlite3_column_double(stmt: ptr, idx: int) -> float
extern func native_sqlite3_column_text(stmt: ptr, idx: int, buf: ptr, buf_len: int) -> int
extern func native_sqlite3_column_blob(stmt: ptr, idx: int, buf: ptr, buf_len: int) -> int
extern func native_sqlite3_finalize(stmt: ptr) -> int
extern func native_sqlite3_changes(db: ptr) -> int

const SQLITE_ROW: 100;
const SQLITE_DONE: 101;

# ─── Open / Close ─────────────────────────────────────

func db_open:
    in(path:string)
    db = native_sqlite3_open(str_ptr(path), str_byte_len(path));
    if db == ptr_null() do
        out Err(str_new("failed to open database"));
    end
    out Ok(Connection { _db = db });
end.

func db_open_memory:
    out db_open(str_new(":memory:"));
end.

func db_close:
    in(conn:Connection)
    native_sqlite3_close(conn._db);
end.

func _db_error:
    in(conn:Connection)
    var buf: [int; 512];
    n = native_sqlite3_errmsg(conn._db, &buf, 512);
    if n > 0 do out str_from_bytes(&buf, n) end
    out str_new("unknown database error");
end

# ─── Execute (no result) ─────────────────────────────

func db_exec:
    in(conn:Connection; sql:string)
    rc = native_sqlite3_exec(conn._db, str_ptr(sql), str_byte_len(sql));
    if rc != 0 do out Err(_db_error(conn)) end
    out Ok(());
end

# ─── Prepared Statements ─────────────────────────────

func db_prepare:
    in(conn:Connection; sql:string)
    stmt = native_sqlite3_prepare(conn._db, str_ptr(sql), str_byte_len(sql));
    if stmt == ptr_null() do
        out Err(_db_error(conn));
    end
    out Ok(Statement { _stmt = stmt, _conn = conn._db });
end.

func stmt_bind:
    in(stmt:Statement; idx:int; val:SqlValue)
    var rc:int;
    case val;
        case SqlValue.Null
            rc = native_sqlite3_bind_null(stmt._stmt, idx);
        case SqlValue.Integer(n)
            rc = native_sqlite3_bind_int(stmt._stmt, idx, n);
        case SqlValue.Real(f)
            rc = native_sqlite3_bind_double(stmt._stmt, idx, f);
        case SqlValue.Text(s)
            rc = native_sqlite3_bind_text(stmt._stmt, idx, str_ptr(s), str_byte_len(s));
        case SqlValue.Blob(b)
            rc = native_sqlite3_bind_blob(stmt._stmt, idx, vec_ptr<int>(&b), vec_len<int>(b));
    end
    if rc != 0 do out Err(str_new("bind failed")) end
    out Ok(());
end

# ─── Query (returns rows) ────────────────────────────

func db_query:
    in(conn:Connection; sql:string)
    stmt_result = db_prepare(conn, sql);
    var stmt:Statement;
    case stmt_result;
        Err(e): out Err(e);
        case Ok(s) stmt = s
    end
    
    rows = vec_new<Row>();
    col_count = native_sqlite3_column_count(stmt._stmt);
    
    # Read column names
    col_names = vec_new<string>();
    c = 0;
    when c < col_count loop
        var buf: [int; 256];
        n = native_sqlite3_column_name(stmt._stmt, c, &buf, 256);
        vec_push<string>(&col_names, str_from_bytes(&buf, n));
        c = c + 1;
    end
    
    # Read rows
    loop
        rc = native_sqlite3_step(stmt._stmt);
        if rc == SQLITE_DONE do break end
        if rc != SQLITE_ROW do
            native_sqlite3_finalize(stmt._stmt);
            out Err(_db_error(conn));
        end
        
        values = vec_new<SqlValue>();
        c = 0;
        when c < col_count loop
            col_type = native_sqlite3_column_type(stmt._stmt, c);
            case col_type;
                case 5 # NULL
                    vec_push<SqlValue>(&values, SqlValue.Null);
                case 1 # INTEGER
                    vec_push<SqlValue>(&values, SqlValue.Integer(native_sqlite3_column_int(stmt._stmt, c)));
                case 2 # FLOAT
                    vec_push<SqlValue>(&values, SqlValue.Real(native_sqlite3_column_double(stmt._stmt, c)));
                case 3 # TEXT
                    var buf: [int; 4096];
                    n = native_sqlite3_column_text(stmt._stmt, c, &buf, 4096);
                    vec_push<SqlValue>(&values, SqlValue.Text(str_from_bytes(&buf, n)));
                case 4 # BLOB
                    var buf: [int; 65536];
                    n = native_sqlite3_column_blob(stmt._stmt, c, &buf, 65536);
                    blob = vec_new<int>();
                    bi = 0;
                    when bi < n vec_push<u8>(&blob, buf[bi]); bi = bi + 1 end loop
                    vec_push<SqlValue>(&values, SqlValue.Blob(blob));
                default;
                    vec_push<SqlValue>(&values, SqlValue.Null);
            end
            c = c + 1;
        end
        
        vec_push<Row>(&rows, Row { columns = col_names, values = values });
    end
    
    native_sqlite3_finalize(stmt._stmt);
    out Ok(rows);
end

# ─── Transaction ──────────────────────────────────────

func db_begin:
    in(conn:Connection)
    out db_exec(conn, str_new("BEGIN"));
end.

func db_commit:
    in(conn:Connection)
    out db_exec(conn, str_new("COMMIT"));
end.

func db_rollback:
    in(conn:Connection)
    out db_exec(conn, str_new("ROLLBACK"));
end.

func db_changes:
    in(conn:Connection)
    out native_sqlite3_changes(conn._db);
end
