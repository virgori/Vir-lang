/*
 * vir/sql/sql.vri — Database Access (SQL)
 * =========================================
 * Inspired by Python: sqlite3, DB-API 2.0
 *
 * Phase C — generic DB interface + SQLite binding
 */

import "vir/core/types" use all
import "vir/core/option" use Option, Some, None
import "vir/core/result" use Result, Ok, Err
import "vir/str/string" use String, str_new
import "vir/collections/vec" use Vec, vec_new, vec_push, vec_len, vec_get
import "vir/collections/map" use Map, map_new, map_set

# ═══════════════════════════════════════════════════════
# Value types
# ═══════════════════════════════════════════════════════

enum SqlValue
    Null
    Integer(i64)
    Real(f64)
    Text(String)
    Blob(Vec<u8>)
end

entity Row
    columns: Vec<String>
    values:  Vec<SqlValue>
end

func row_get(row: Row, col: String) -> Option<SqlValue>
    var i: usize = 0
    lặp_khi i < vec_len<String>(row.columns)
        if str_eq(vec_get<String>(row.columns, i), col)
            out Some(vec_get<SqlValue>(row.values, i))
        end
        i = i + 1
    end
    out None
end

func row_get_int(row: Row, col: String) -> Option<i64>
    var val = row_get(row, col)
    chọn val
        case Some(SqlValue.Integer(n)) out Some(n)
        mặc_định out None
    end
end

func row_get_str(row: Row, col: String) -> Option<String>
    var val = row_get(row, col)
    chọn val
        case Some(SqlValue.Text(s)) out Some(s)
        mặc_định out None
    end
end

# ═══════════════════════════════════════════════════════
# Connection (SQLite)
# ═══════════════════════════════════════════════════════

entity Connection
    _db: ptr    # sqlite3*
end

entity Statement
    _stmt: ptr   # sqlite3_stmt*
    _conn: ptr
end

func ngoài native_sqlite3_open(path: ptr, path_len: usize) -> ptr
func ngoài native_sqlite3_close(db: ptr) -> i32
func ngoài native_sqlite3_exec(db: ptr, sql: ptr, sql_len: usize) -> i32
func ngoài native_sqlite3_errmsg(db: ptr, buf: ptr, buf_len: usize) -> i32
func ngoài native_sqlite3_prepare(db: ptr, sql: ptr, sql_len: usize) -> ptr
func ngoài native_sqlite3_bind_null(stmt: ptr, idx: i32) -> i32
func ngoài native_sqlite3_bind_int(stmt: ptr, idx: i32, val: i64) -> i32
func ngoài native_sqlite3_bind_double(stmt: ptr, idx: i32, val: f64) -> i32
func ngoài native_sqlite3_bind_text(stmt: ptr, idx: i32, text: ptr, len: usize) -> i32
func ngoài native_sqlite3_bind_blob(stmt: ptr, idx: i32, data: ptr, len: usize) -> i32
func ngoài native_sqlite3_step(stmt: ptr) -> i32   # 100=SQLITE_ROW, 101=SQLITE_DONE
func ngoài native_sqlite3_column_count(stmt: ptr) -> i32
func ngoài native_sqlite3_column_name(stmt: ptr, idx: i32, buf: ptr, buf_len: usize) -> i32
func ngoài native_sqlite3_column_type(stmt: ptr, idx: i32) -> i32  # 1=INT,2=FLOAT,3=TEXT,4=BLOB,5=NULL
func ngoài native_sqlite3_column_int(stmt: ptr, idx: i32) -> i64
func ngoài native_sqlite3_column_double(stmt: ptr, idx: i32) -> f64
func ngoài native_sqlite3_column_text(stmt: ptr, idx: i32, buf: ptr, buf_len: usize) -> i32
func ngoài native_sqlite3_column_blob(stmt: ptr, idx: i32, buf: ptr, buf_len: usize) -> i32
func ngoài native_sqlite3_finalize(stmt: ptr) -> i32
func ngoài native_sqlite3_changes(db: ptr) -> i32

hằng_số SQLITE_ROW:  i32 = 100
hằng_số SQLITE_DONE: i32 = 101

# ─── Open / Close ─────────────────────────────────────

func db_open(path: String) -> Result<Connection, String>
    var db = native_sqlite3_open(str_ptr(path), str_byte_len(path))
    if db == ptr_null()
        out Err(str_new("failed to open database"))
    end
    out Ok(Connection { _db = db })
end

func db_open_memory() -> Result<Connection, String>
    out db_open(str_new(":memory:"))
end

func db_close(conn: &Connection)
    native_sqlite3_close(conn._db)
end

func _db_error(conn: &Connection) -> String
    var buf: [u8; 512]
    var n = native_sqlite3_errmsg(conn._db, &buf, 512)
    if n > 0 out str_from_bytes(&buf, n) end
    out str_new("unknown database error")
end

# ─── Execute (no result) ─────────────────────────────

func db_exec(conn: &Connection, sql: String) -> Result<void, String>
    var rc = native_sqlite3_exec(conn._db, str_ptr(sql), str_byte_len(sql))
    if rc != 0 out Err(_db_error(conn)) end
    out Ok(())
end

# ─── Prepared Statements ─────────────────────────────

func db_prepare(conn: &Connection, sql: String) -> Result<Statement, String>
    var stmt = native_sqlite3_prepare(conn._db, str_ptr(sql), str_byte_len(sql))
    if stmt == ptr_null()
        out Err(_db_error(conn))
    end
    out Ok(Statement { _stmt = stmt, _conn = conn._db })
end

func stmt_bind(stmt: &Statement, idx: i32, val: SqlValue) -> Result<void, String>
    var rc: i32
    chọn val
        case SqlValue.Null
            rc = native_sqlite3_bind_null(stmt._stmt, idx)
        case SqlValue.Integer(n)
            rc = native_sqlite3_bind_int(stmt._stmt, idx, n)
        case SqlValue.Real(f)
            rc = native_sqlite3_bind_double(stmt._stmt, idx, f)
        case SqlValue.Text(s)
            rc = native_sqlite3_bind_text(stmt._stmt, idx, str_ptr(s), str_byte_len(s))
        case SqlValue.Blob(b)
            rc = native_sqlite3_bind_blob(stmt._stmt, idx, vec_ptr<u8>(&b), vec_len<u8>(b))
    end
    if rc != 0 out Err(str_new("bind failed")) end
    out Ok(())
end

# ─── Query (returns rows) ────────────────────────────

func db_query(conn: &Connection, sql: String) -> Result<Vec<Row>, String>
    var stmt_result = db_prepare(conn, sql)
    var stmt: Statement
    chọn stmt_result
        case Err(e) out Err(e)
        case Ok(s) stmt = s
    end
    
    var rows = vec_new<Row>()
    var col_count = native_sqlite3_column_count(stmt._stmt)
    
    # Read column names
    var col_names = vec_new<String>()
    var c: i32 = 0
    lặp_khi c < col_count
        var buf: [u8; 256]
        var n = native_sqlite3_column_name(stmt._stmt, c, &buf, 256)
        vec_push<String>(&col_names, str_from_bytes(&buf, n))
        c = c + 1
    end
    
    # Read rows
    loop
        var rc = native_sqlite3_step(stmt._stmt)
        if rc == SQLITE_DONE thoát end
        if rc != SQLITE_ROW
            native_sqlite3_finalize(stmt._stmt)
            out Err(_db_error(conn))
        end
        
        var values = vec_new<SqlValue>()
        c = 0
        lặp_khi c < col_count
            var col_type = native_sqlite3_column_type(stmt._stmt, c)
            chọn col_type
                case 5 # NULL
                    vec_push<SqlValue>(&values, SqlValue.Null)
                case 1 # INTEGER
                    vec_push<SqlValue>(&values, SqlValue.Integer(native_sqlite3_column_int(stmt._stmt, c)))
                case 2 # FLOAT
                    vec_push<SqlValue>(&values, SqlValue.Real(native_sqlite3_column_double(stmt._stmt, c)))
                case 3 # TEXT
                    var buf: [u8; 4096]
                    var n = native_sqlite3_column_text(stmt._stmt, c, &buf, 4096)
                    vec_push<SqlValue>(&values, SqlValue.Text(str_from_bytes(&buf, n)))
                case 4 # BLOB
                    var buf: [u8; 65536]
                    var n = native_sqlite3_column_blob(stmt._stmt, c, &buf, 65536)
                    var blob = vec_new<u8>()
                    var bi: usize = 0
                    lặp_khi bi < n vec_push<u8>(&blob, buf[bi]); bi = bi + 1 end
                    vec_push<SqlValue>(&values, SqlValue.Blob(blob))
                mặc_định
                    vec_push<SqlValue>(&values, SqlValue.Null)
            end
            c = c + 1
        end
        
        vec_push<Row>(&rows, Row { columns = col_names, values = values })
    end
    
    native_sqlite3_finalize(stmt._stmt)
    out Ok(rows)
end

# ─── Transaction ──────────────────────────────────────

func db_begin(conn: &Connection) -> Result<void, String>
    out db_exec(conn, str_new("BEGIN"))
end

func db_commit(conn: &Connection) -> Result<void, String>
    out db_exec(conn, str_new("COMMIT"))
end

func db_rollback(conn: &Connection) -> Result<void, String>
    out db_exec(conn, str_new("ROLLBACK"))
end

func db_changes(conn: &Connection) -> i32
    out native_sqlite3_changes(conn._db)
end
