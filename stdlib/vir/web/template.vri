##
 * vir/web/template.vri — Template Engine
 * =========================================
 * Inspired by: Jinja2, Mustache, Handlebars
 *
 * Simple template engine with variable substitution,
 * conditionals, loops, and block inheritance.
 ##

include types;
include option;
import Option, Some, None from option;
include vec;
import Vec, vec_new, vec_push, vec_len, vec_get from vec;
include map;
import Map, map_new, map_insert, map_get, map_contains from map;
include str;
import str_len, str_find, str_substr, str_trim from str;
include string_builder;
import StringBuilder, sb_new, sb_append, sb_build, sb_free from string_builder;

# ═══════════════════════════════════════════════════════
# Template token types
# ═══════════════════════════════════════════════════════

const TOK_TEXT     = 1;
const TOK_VAR      = 2;   # {{ var }}
const TOK_IF       = 3;   # {% if var %}
const TOK_ELSE     = 4;   # {% else %}
const TOK_ENDIF    = 5;   # {% endif %}
const TOK_FOR      = 6;   # {% for item in list %}
const TOK_ENDFOR   = 7;   # {% endfor %}
const TOK_BLOCK    = 8;   # {% block name %}
const TOK_ENDBLOCK = 9;   # {% endblock %}
const TOK_INCLUDE  = 10;  # {% include "name" %}

entity TmplToken:
    kind:  int,
        value: string,
        extra: string;    # FOR: loop var; BLOCK: block name
end

# ═══════════════════════════════════════════════════════
# Context (variable bindings)
# ═══════════════════════════════════════════════════════

entity TmplContext:
    vars: Map;       # key → string value
    lists: Map;      # key → Vec<string> for loops
end.

func ctx_new:
    out TmplContext { vars: map_new(), lists: map_new() };
end.

func ctx_set:
    in(ctx: TmplContext; key: string; value: string)
    map_insert(ctx.vars, key, value);
end.

func ctx_set_list:
    in(ctx: TmplContext; key: string; items: Vec)
    map_insert(ctx.lists, key, items);
end.

func ctx_get:
    in(ctx: TmplContext; key: string)
    if map_contains(ctx.vars, key) do
        out Some(map_get(ctx.vars, key));
    end
    out None;
end

# ═══════════════════════════════════════════════════════
# Tokenizer
# ═══════════════════════════════════════════════════════

func _tmpl_tokenize:
    in(source: string)
    tokens = vec_new();
    pos = 0;
    src_len = str_len(source);

    when pos < src_len loop
        # Check for {{ variable }}
        var_start = str_find(source, "{{", pos);
        tag_start = str_find(source, "{%", pos);

        # Determine which comes first
        next_special = src_len;
        if var_start >= 0 && var_start < next_special do
            next_special = var_start;
        end
        if tag_start >= 0 && tag_start < next_special do
            next_special = tag_start;
        end

        # Emit text before special
        if next_special > pos do
            vec_push(tokens, TmplToken {
                kind: TOK_TEXT,
                value: str_substr(source, pos, next_special),
                extra: ""
            });
        end

        if next_special >= src_len do
            pos = src_len;
        eif var_start == next_special do
            # Variable {{ ... }}
            end_pos = str_find(source, "}}", var_start + 2);
            if end_pos >= 0 do
                inner = str_trim(str_substr(source, var_start + 2, end_pos));
                vec_push(tokens, TmplToken { kind: TOK_VAR, value: inner, extra: "" });
                pos = end_pos + 2;
            else
                pos = src_len;
            end
        else
            # Tag {% ... %}
            end_pos = str_find(source, "%}", tag_start + 2);
            if end_pos >= 0 do
                inner = str_trim(str_substr(source, tag_start + 2, end_pos));
                tok = _parse_tag(inner);
                vec_push(tokens, tok);
                pos = end_pos + 2;
            else
                pos = src_len;
            end
        end
    end

    out tokens;
end.

func _parse_tag:
    in(tag: string)
    if tag == "else" do
        out TmplToken { kind: TOK_ELSE, value: "", extra: "" };
    end
    if tag == "endif" do
        out TmplToken { kind: TOK_ENDIF, value: "", extra: "" };
    end
    if tag == "endfor" do
        out TmplToken { kind: TOK_ENDFOR, value: "", extra: "" };
    end
    if tag == "endblock" do
        out TmplToken { kind: TOK_ENDBLOCK, value: "", extra: "" };
    end

    # if var
    if str_len(tag) > 3 && str_substr(tag, 0, 3) == "if " do
        out TmplToken { kind: TOK_IF, value: str_trim(str_substr(tag, 3, str_len(tag))), extra: "" };
    end

    # for item in list
    if str_len(tag) > 4 && str_substr(tag, 0, 4) == "for " do
        body = str_trim(str_substr(tag, 4, str_len(tag)));
        in_pos = str_find(body, " in ", 0);
        if in_pos >= 0 do
            item_var = str_trim(str_substr(body, 0, in_pos));
            list_var = str_trim(str_substr(body, in_pos + 4, str_len(body)));
            out TmplToken { kind: TOK_FOR, value: list_var, extra: item_var };
        end
    end

    # block name
    if str_len(tag) > 6 && str_substr(tag, 0, 6) == "block " do
        out TmplToken { kind: TOK_BLOCK, value: str_trim(str_substr(tag, 6, str_len(tag))), extra: "" };
    end

    # include "name"
    if str_len(tag) > 8 && str_substr(tag, 0, 8) == "include " do
        name = str_trim(str_substr(tag, 8, str_len(tag)));
        out TmplToken { kind: TOK_INCLUDE, value: name, extra: "" };
    end

    out TmplToken { kind: TOK_TEXT, value: tag, extra: "" };
end

# ═══════════════════════════════════════════════════════
# Renderer
# ═══════════════════════════════════════════════════════

entity RenderState:
    tokens:  Vec,
        pos:     int,
        ctx:     TmplContext,
        sb:      StringBuilder;
end.

func tmpl_render:
    in(source: string; ctx: TmplContext)
    tokens = _tmpl_tokenize(source);
    state = RenderState {
        tokens: tokens, pos: 0,
        ctx: ctx, sb: sb_new()
    };
    _render_block(state);
    result = sb_build(state.sb);
    out result;
end.

func _render_block:
    in(state: RenderState)
    when state.pos < vec_len(state.tokens) loop
        tok = vec_get(state.tokens, state.pos);
        state.pos = state.pos + 1;

        if tok.kind == TOK_TEXT do
            sb_append(state.sb, tok.value);

        eif tok.kind == TOK_VAR do
            val_opt = ctx_get(state.ctx, tok.value);
            if is_some(val_opt) do
                sb_append(state.sb, unwrap(val_opt));
            end

        eif tok.kind == TOK_IF do
            truthy = false;
            val_opt = ctx_get(state.ctx, tok.value);
            if is_some(val_opt) do
                v = unwrap(val_opt);
                if str_len(v) > 0 && v != "false" && v != "0" do
                    truthy = true;
                end
            end
            _render_if(state, truthy);

        eif tok.kind == TOK_FOR do
            _render_for(state, tok.extra, tok.value);

        eif tok.kind == TOK_ENDIF || tok.kind == TOK_ENDFOR || tok.kind == TOK_ELSE || tok.kind == TOK_ENDBLOCK do
            state.pos = state.pos - 1;
            out;
        end
    end
end.

func _render_if:
    in(state: RenderState; truthy: bool)
    if truthy do
        _render_block(state);
        # Check for else or endif
        if state.pos < vec_len(state.tokens) do
            tok = vec_get(state.tokens, state.pos);
            state.pos = state.pos + 1;
            if tok.kind == TOK_ELSE do
                _skip_block(state);
                if state.pos < vec_len(state.tokens) do
                    state.pos = state.pos + 1;  # skip endif
                end
            end
        end
    else
        _skip_block(state);
        if state.pos < vec_len(state.tokens) do
            tok = vec_get(state.tokens, state.pos);
            state.pos = state.pos + 1;
            if tok.kind == TOK_ELSE do
                _render_block(state);
                if state.pos < vec_len(state.tokens) do
                    state.pos = state.pos + 1;  # skip endif
                end
            end
        end
    end
end.

func _render_for:
    in(state: RenderState; item_var: string; list_var: string)
    start_pos = state.pos;
    if map_contains(state.ctx.lists, list_var) do
        items = map_get(state.ctx.lists, list_var);
        i = 0;
        when i < vec_len(items) loop
            state.pos = start_pos;
            map_insert(state.ctx.vars, item_var, vec_get(items, i));
            _render_block(state);
            i = i + 1;
        end
        # Skip past endfor
        if state.pos < vec_len(state.tokens) do
            state.pos = state.pos + 1;
        end
    else
        _skip_block(state);
        if state.pos < vec_len(state.tokens) do
            state.pos = state.pos + 1;
        end
    end
end.

func _skip_block:
    in(state: RenderState)
    depth = 1;
    when state.pos < vec_len(state.tokens) && depth > 0 loop
        tok = vec_get(state.tokens, state.pos);
        if tok.kind == TOK_IF || tok.kind == TOK_FOR || tok.kind == TOK_BLOCK do
            depth = depth + 1;
            state.pos = state.pos + 1;
        eif tok.kind == TOK_ENDIF || tok.kind == TOK_ENDFOR || tok.kind == TOK_ENDBLOCK do
            depth = depth - 1;
            if depth > 0 do
                state.pos = state.pos + 1;
            end
        eif tok.kind == TOK_ELSE && depth == 1 do
            depth = 0;
        else
            state.pos = state.pos + 1;
        end
    end
end

# ═══════════════════════════════════════════════════════
# HTML escaping
# ═══════════════════════════════════════════════════════

func html_escape:
    in(s: string)
    sb = sb_new();
    i = 0;
    when i < str_len(s) loop
        ch = str_substr(s, i, i + 1);
        if ch == "&" do
            sb_append(sb, "&amp;");
        eif ch == "<" do
            sb_append(sb, "&lt;");
        eif ch == ">" do
            sb_append(sb, "&gt;");
        eif ch == "\"" do
            sb_append(sb, "&quot;");
        eif ch == "'" do
            sb_append(sb, "&#x27;");
        else
            sb_append(sb, ch);
        end
        i = i + 1;
    end
    out sb_build(sb);
end
