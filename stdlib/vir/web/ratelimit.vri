##
 * vir/web/ratelimit.vri — Rate Limiter
 * =======================================
 * Inspired by: Token bucket, sliding window
 *
 * Fixed-window and sliding-window rate limiting,
 * per-key tracking, rate limit headers.
 ##

include types;
include option;
import Option, Some, None from option;
include map;
import Map, map_new, map_insert, map_get, map_contains from map;
include string_builder;
import StringBuilder, sb_new, sb_append, sb_build from string_builder;

# ═══════════════════════════════════════════════════════
# Rate limit result
# ═══════════════════════════════════════════════════════

entity RateLimitResult:
    allowed:    bool;
    remaining:  int;
    limit:      int;
    retry_after: int;    # seconds until reset, 0 if allowed
end

# ═══════════════════════════════════════════════════════
# Fixed-window entry
# ═══════════════════════════════════════════════════════

entity WindowEntry:
    count:       int;
    window_start: int;   # timestamp of window start
end

# ═══════════════════════════════════════════════════════
# Fixed Window Rate Limiter
# ═══════════════════════════════════════════════════════

entity FixedWindowLimiter:
    entries:     Map;     # key → WindowEntry
    max_reqs:    int;     # max requests per window
    window_sec:  int;     # window size in seconds
end

func fw_limiter_new:
    in(max_reqs: int; window_sec: int)
    out FixedWindowLimiter {
        entries: map_new(),
        max_reqs: max_reqs,
        window_sec: window_sec
    };
end

func fw_check:
    in(lim: FixedWindowLimiter; key: string; now: int)
    if map_contains(lim.entries, key):
        entry = map_get(lim.entries, key);
        # Check if window expired
        if now >= entry.window_start + lim.window_sec:
            # New window
            entry.count = 1;
            entry.window_start = now;
            map_insert(lim.entries, key, entry);
            out RateLimitResult {
                allowed: true, remaining: lim.max_reqs - 1,
                limit: lim.max_reqs, retry_after: 0
            };
        end
        if entry.count < lim.max_reqs:
            entry.count = entry.count + 1;
            map_insert(lim.entries, key, entry);
            out RateLimitResult {
                allowed: true, remaining: lim.max_reqs - entry.count,
                limit: lim.max_reqs, retry_after: 0
            };
        end
        # Rate limited
        retry = (entry.window_start + lim.window_sec) - now;
        out RateLimitResult {
            allowed: false, remaining: 0,
            limit: lim.max_reqs, retry_after: retry
        };
    end

    # First request for this key
    entry = WindowEntry { count: 1, window_start: now };
    map_insert(lim.entries, key, entry);
    out RateLimitResult {
        allowed: true, remaining: lim.max_reqs - 1,
        limit: lim.max_reqs, retry_after: 0
    };
end

# ═══════════════════════════════════════════════════════
# Token Bucket Rate Limiter
# ═══════════════════════════════════════════════════════

entity Bucket:
    tokens:       float;
    last_refill:  int;     # timestamp
end

entity TokenBucketLimiter:
    buckets:      Map;     # key → Bucket
    capacity:     int;     # max tokens
    refill_rate:  float;   # tokens per second
end

func tb_limiter_new:
    in(capacity: int; refill_rate: float)
    out TokenBucketLimiter {
        buckets: map_new(),
        capacity: capacity,
        refill_rate: refill_rate
    };
end

func tb_check:
    in(lim: TokenBucketLimiter; key: string; now: int)
    cap_f = int_to_float(lim.capacity);

    if map_contains(lim.buckets, key):
        bucket = map_get(lim.buckets, key);
        # Refill tokens
        elapsed = now - bucket.last_refill;
        new_tokens = bucket.tokens + (int_to_float(elapsed) * lim.refill_rate);
        if new_tokens > cap_f:
            new_tokens = cap_f;
        end
        bucket.tokens = new_tokens;
        bucket.last_refill = now;

        if bucket.tokens >= 1.0:
            bucket.tokens = bucket.tokens - 1.0;
            map_insert(lim.buckets, key, bucket);
            remaining = float_to_int(bucket.tokens);
            out RateLimitResult {
                allowed: true, remaining: remaining,
                limit: lim.capacity, retry_after: 0
            };
        end

        map_insert(lim.buckets, key, bucket);
        # Need to wait for 1 token
        wait = 1.0 / lim.refill_rate;
        out RateLimitResult {
            allowed: false, remaining: 0,
            limit: lim.capacity, retry_after: float_to_int(wait) + 1
        };
    end

    # First request: full bucket minus 1
    bucket = Bucket { tokens: cap_f - 1.0, last_refill: now };
    map_insert(lim.buckets, key, bucket);
    out RateLimitResult {
        allowed: true, remaining: lim.capacity - 1,
        limit: lim.capacity, retry_after: 0
    };
end

# ═══════════════════════════════════════════════════════
# Rate limit response headers
# ═══════════════════════════════════════════════════════

func ratelimit_headers:
    in(result: RateLimitResult)
    hdrs = map_new();
    map_insert(hdrs, "X-RateLimit-Limit", int_to_str(result.limit));
    map_insert(hdrs, "X-RateLimit-Remaining", int_to_str(result.remaining));
    if !result.allowed:
        map_insert(hdrs, "Retry-After", int_to_str(result.retry_after));
    end
    out hdrs;
end
