##
 * vir/web/session.vri — Cookie & Session Management
 * ====================================================
 * Inspired by: express-session, Flask sessions
 *
 * Server-side session store, secure cookie generation,
 * session lifecycle (create/read/update/delete).
 ##

include types;
include option;
import Option, Some, None from option;
include vec;
import Vec, vec_new, vec_push, vec_len, vec_get from vec;
include map;
import Map, map_new, map_insert, map_get, map_contains, map_remove from map;
include string_builder;
import StringBuilder, sb_new, sb_append, sb_build from string_builder;

# ═══════════════════════════════════════════════════════
# Cookie
# ═══════════════════════════════════════════════════════

entity Cookie:
    name:      string;
    value:     string;
    path:      string;
    domain:    string;
    max_age:   int;       # seconds, -1 = session cookie
    secure:    bool;
    http_only: bool;
    same_site: string;    # "Strict", "Lax", "None"
end

func cookie_new:
    in(name: string; value: string)
    out Cookie {
        name: name, value: value,
        path: "/", domain: "",
        max_age: -1, secure: true,
        http_only: true, same_site: "Lax"
    };
end

func cookie_to_header:
    in(c: Cookie)
    sb = sb_new();
    sb_append(sb, c.name);
    sb_append(sb, "=");
    sb_append(sb, c.value);

    if str_len(c.path) > 0:
        sb_append(sb, "; Path=");
        sb_append(sb, c.path);
    end
    if str_len(c.domain) > 0:
        sb_append(sb, "; Domain=");
        sb_append(sb, c.domain);
    end
    if c.max_age >= 0:
        sb_append(sb, "; Max-Age=");
        sb_append(sb, int_to_str(c.max_age));
    end
    if c.secure:
        sb_append(sb, "; Secure");
    end
    if c.http_only:
        sb_append(sb, "; HttpOnly");
    end
    if str_len(c.same_site) > 0:
        sb_append(sb, "; SameSite=");
        sb_append(sb, c.same_site);
    end

    out sb_build(sb);
end

# ═══════════════════════════════════════════════════════
# Parse Cookie header
# ═══════════════════════════════════════════════════════

func parse_cookies:
    in(header: string)
    cookies = map_new();
    pairs = str_split(header, ";");
    i = 0;
    when i < vec_len(pairs) loop
        pair = str_trim(vec_get(pairs, i));
        eq_pos = str_find(pair, "=", 0);
        if eq_pos > 0:
            name = str_trim(str_substr(pair, 0, eq_pos));
            value = str_trim(str_substr(pair, eq_pos + 1, str_len(pair)));
            map_insert(cookies, name, value);
        end
        i = i + 1;
    end
    out cookies;
end

# ═══════════════════════════════════════════════════════
# Session data
# ═══════════════════════════════════════════════════════

entity Session:
    id:         string;
    data:       Map;       # key → value
    created_at: int;       # timestamp
    expires_at: int;       # timestamp
    modified:   bool;
end

func session_new:
    in(id: string; ttl: int; now: int)
    out Session {
        id: id, data: map_new(),
        created_at: now, expires_at: now + ttl,
        modified: false
    };
end

func session_get:
    in(s: Session; key: string)
    if map_contains(s.data, key):
        out Some(map_get(s.data, key));
    end
    out None;
end

func session_set:
    in(s: Session; key: string; value: string)
    map_insert(s.data, key, value);
    s.modified = true;
end

func session_remove:
    in(s: Session; key: string)
    map_remove(s.data, key);
    s.modified = true;
end

func session_is_expired:
    in(s: Session; now: int)
    out now >= s.expires_at;
end

func session_touch:
    in(s: Session; ttl: int; now: int)
    s.expires_at = now + ttl;
    s.modified = true;
end

# ═══════════════════════════════════════════════════════
# Session Store (in-memory)
# ═══════════════════════════════════════════════════════

entity SessionStore:
    sessions:     Map;        # session_id → Session
    cookie_name:  string;
    ttl:          int;        # default TTL in seconds
end

func store_new:
    in(cookie_name: string; ttl: int)
    out SessionStore {
        sessions: map_new(),
        cookie_name: cookie_name,
        ttl: ttl
    };
end

func store_create:
    in(store: SessionStore; session_id: string; now: int)
    s = session_new(session_id, store.ttl, now);
    map_insert(store.sessions, session_id, s);
    out s;
end

func store_load:
    in(store: SessionStore; session_id: string; now: int)
    if map_contains(store.sessions, session_id):
        s = map_get(store.sessions, session_id);
        if !session_is_expired(s, now):
            out Some(s);
        end
        # Expired — remove
        map_remove(store.sessions, session_id);
    end
    out None;
end

func store_save:
    in(store: SessionStore; s: Session)
    map_insert(store.sessions, s.id, s);
    s.modified = false;
end

func store_destroy:
    in(store: SessionStore; session_id: string)
    map_remove(store.sessions, session_id);
end

# ═══════════════════════════════════════════════════════
# Session ID generator (simple counter + random mix)
# ═══════════════════════════════════════════════════════

entity SessionIdGen:
    counter:  int;
    seed:     int;
end

func sidgen_new:
    in(seed: int)
    out SessionIdGen { counter: 0, seed: seed };
end

func sidgen_next:
    in(gen: SessionIdGen)
    gen.counter = gen.counter + 1;
    # xorshift-style mix
    x = gen.seed ^ (gen.counter * 2654435761);
    x = x ^ (x >> 13);
    x = x ^ (x << 7);
    x = x ^ (x >> 17);
    if x < 0:
        x = -x;
    end
    gen.seed = x;

    # Hex encode
    hex_chars = "0123456789abcdef";
    sb = sb_new();
    sb_append(sb, "sid_");
    i = 0;
    val = x;
    when i < 16 loop
        nibble = val & 0xF;
        sb_append(sb, str_substr(hex_chars, nibble, nibble + 1));
        val = val >> 4;
        if val == 0:
            val = gen.counter ^ (i * 31);
        end
        i = i + 1;
    end

    out sb_build(sb);
end

# ═══════════════════════════════════════════════════════
# Cookie for session
# ═══════════════════════════════════════════════════════

func session_cookie:
    in(store: SessionStore; session_id: string)
    c = cookie_new(store.cookie_name, session_id);
    c.max_age = store.ttl;
    c.http_only = true;
    c.secure = true;
    c.same_site = "Lax";
    out c;
end

func session_delete_cookie:
    in(store: SessionStore)
    c = cookie_new(store.cookie_name, "");
    c.max_age = 0;
    out c;
end
