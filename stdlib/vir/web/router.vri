##
 * vir/web/router.vri — HTTP Router / Web Framework Core
 * ========================================================
 * Inspired by: Express, Gin, Axum, Flask
 *
 * Trie-based path routing with path parameters, method
 * matching, middleware support, and route groups.
 ##

include types;
include option;
import Option, Some, None from option;
include vec;
import Vec, vec_new, vec_push, vec_len, vec_get from vec;
include map;
import Map, map_new, map_insert, map_get, map_contains from map;
include str;
import str_split, str_starts_with, str_len, str_substr from str;

# ═══════════════════════════════════════════════════════
# HTTP methods
# ═══════════════════════════════════════════════════════

const METHOD_GET     = "GET";
const METHOD_POST    = "POST";
const METHOD_PUT     = "PUT";
const METHOD_DELETE  = "DELETE";
const METHOD_PATCH   = "PATCH";
const METHOD_HEAD    = "HEAD";
const METHOD_OPTIONS = "OPTIONS";

# ═══════════════════════════════════════════════════════
# HTTP status codes
# ═══════════════════════════════════════════════════════

const STATUS_OK                  = 200;
const STATUS_CREATED             = 201;
const STATUS_NO_CONTENT          = 204;
const STATUS_MOVED_PERMANENTLY   = 301;
const STATUS_FOUND               = 302;
const STATUS_NOT_MODIFIED        = 304;
const STATUS_BAD_REQUEST         = 400;
const STATUS_UNAUTHORIZED        = 401;
const STATUS_FORBIDDEN           = 403;
const STATUS_NOT_FOUND           = 404;
const STATUS_METHOD_NOT_ALLOWED  = 405;
const STATUS_INTERNAL_ERROR      = 500;
const STATUS_BAD_GATEWAY         = 502;
const STATUS_SERVICE_UNAVAILABLE = 503;

# ═══════════════════════════════════════════════════════
# Request / Response
# ═══════════════════════════════════════════════════════

entity Request:
    method:   string,
        path:     string,
        headers:  Map;      # header_name → value
    params:   Map;      # path params extracted by router
    query:    Map;      # query string params
    body:     string;
end.

entity Response:
    status:   int,
        headers:  Map,
        body:     string;
end.

func request_new:
    in(method: string; path: string)
    out Request (
        method: method, path: path,
        headers: map_new(), params: map_new(),
        query: map_new(), body: ""
    );
end.

func response_new:
    in(status: int; body: string)
    out Response ( status: status, headers: map_new(), body: body );
end.

func response_json:
    in(status: int; json_body: string)
    r = response_new(status, json_body);
    map_insert(r.headers, "Content-Type", "application/json");
    out r;
end.

func response_html:
    in(status: int; html_body: string)
    r = response_new(status, html_body);
    map_insert(r.headers, "Content-Type", "text/html; charset=utf-8");
    out r;
end.

func response_redirect:
    in(url: string; permanent: bool)
    status = STATUS_FOUND;
    if permanent do
        status = STATUS_MOVED_PERMANENTLY;
    end
    r = response_new(status, "");
    map_insert(r.headers, "Location", url);
    out r;
end

# ═══════════════════════════════════════════════════════
# Route definition
# ═══════════════════════════════════════════════════════

entity Route:
    method:      string,
        pattern:     string;      # e.g. "/users/:id/posts"
    segments:    Vec;         # parsed segments
    handler_id:  int;         # handler identifier
end.

entity RouteSegment:
    text:      string,
        is_param:  bool;        # true if starts with ':'
    is_wild:   bool;        # true if '*'
end.

func _parse_segments:
    in(pattern: string)
    parts = str_split(pattern, "/");
    segments = vec_new();
    i = 0;
    when i < vec_len(parts) loop
        part = vec_get(parts, i);
        if str_len(part) > 0 do
            is_p = str_starts_with(part, ":");
            is_w = (part == "*");
            seg_text = part;
            if is_p do
                seg_text = str_substr(part, 1, str_len(part));
            end
            vec_push(segments, RouteSegment (
                text: seg_text, is_param: is_p, is_wild: is_w
            ));
        end
        i = i + 1;
    end
    out segments;
end

# ═══════════════════════════════════════════════════════
# Router
# ═══════════════════════════════════════════════════════

entity Router:
    routes:  Vec;      # Vec<Route>
    prefix:  string;   # group prefix
end.

func router_new:
    out Router ( routes: vec_new(), prefix: "" );
end.

func router_group:
    in(prefix: string)
    out Router ( routes: vec_new(), prefix: prefix );
end.

func router_add:
    in(r: Router; method: string; pattern: string; handler_id: int)
    full_pattern = r.prefix + pattern;
    segs = _parse_segments(full_pattern);
    route = Route (
        method: method, pattern: full_pattern,
        segments: segs, handler_id: handler_id
    );
    vec_push(r.routes, route);
end.

func router_get:
    in(r: Router; pattern: string; handler_id: int)
    router_add(r, METHOD_GET, pattern, handler_id);
end.

func router_post:
    in(r: Router; pattern: string; handler_id: int)
    router_add(r, METHOD_POST, pattern, handler_id);
end.

func router_put:
    in(r: Router; pattern: string; handler_id: int)
    router_add(r, METHOD_PUT, pattern, handler_id);
end.

func router_delete:
    in(r: Router; pattern: string; handler_id: int)
    router_add(r, METHOD_DELETE, pattern, handler_id);
end

# ═══════════════════════════════════════════════════════
# Route matching
# ═══════════════════════════════════════════════════════

entity RouteMatch:
    matched:    bool,
        handler_id: int,
        params:     Map;
end.

func _match_route:
    in(route: Route; method: string; path_segments: Vec)
    if route.method != method do
        out RouteMatch ( matched: false, handler_id: 0, params: map_new() );
    end

    route_segs = route.segments;
    params = map_new();

    # Check for wildcard at end
    last_idx = vec_len(route_segs) - 1;
    has_wild = false;
    if last_idx >= 0 do
        last_seg = vec_get(route_segs, last_idx);
        if last_seg.is_wild do
            has_wild = true;
        end
    end

    if !has_wild && vec_len(route_segs) != vec_len(path_segments) do
        out RouteMatch ( matched: false, handler_id: 0, params: map_new() );
    end

    if has_wild && vec_len(path_segments) < (vec_len(route_segs) - 1) do
        out RouteMatch ( matched: false, handler_id: 0, params: map_new() );
    end

    i = 0;
    ok = true;
    when i < vec_len(route_segs) && ok loop
        seg = vec_get(route_segs, i);
        if seg.is_wild do
            # Match rest — collect remaining
            i = vec_len(route_segs);  # exit loop
        eif seg.is_param do
            if i < vec_len(path_segments) do
                map_insert(params, seg.text, vec_get(path_segments, i));
            else
                ok = false;
            end
            i = i + 1;
        else
            if i < vec_len(path_segments) do
                if seg.text != vec_get(path_segments, i) do
                    ok = false;
                end
            else
                ok = false;
            end
            i = i + 1;
        end
    end

    if ok do
        out RouteMatch ( matched: true, handler_id: route.handler_id, params: params );
    end
    out RouteMatch ( matched: false, handler_id: 0, params: map_new() );
end.

func router_match:
    in(r: Router; method: string; path: string)
    path_segs = vec_new();
    parts = str_split(path, "/");
    i = 0;
    when i < vec_len(parts) loop
        p = vec_get(parts, i);
        if str_len(p) > 0 do
            vec_push(path_segs, p);
        end
        i = i + 1;
    end

    i = 0;
    when i < vec_len(r.routes) loop
        route = vec_get(r.routes, i);
        m = _match_route(route, method, path_segs);
        if m.matched do
            out m;
        end
        i = i + 1;
    end

    out RouteMatch ( matched: false, handler_id: -1, params: map_new() );
end

# ═══════════════════════════════════════════════════════
# Merge sub-router routes
# ═══════════════════════════════════════════════════════

func router_mount:
    in(parent: Router; child: Router)
    i = 0;
    when i < vec_len(child.routes) loop
        route = vec_get(child.routes, i);
        vec_push(parent.routes, route);
        i = i + 1;
    end
end
