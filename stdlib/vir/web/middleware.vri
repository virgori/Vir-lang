##
 * vir/web/middleware.vri — Middleware Stack
 * ==========================================
 * Inspired by: Express middleware, Koa, Tower
 *
 * Ordered middleware chain with before/after hooks,
 * request/response transformation, and error handling.
 ##

include types;
include option;
import Option, Some, None from option;
include vec;
import Vec, vec_new, vec_push, vec_len, vec_get from vec;
include map;
import Map, map_new, map_insert, map_get, map_contains from map;
include string_builder;
import StringBuilder, sb_new, sb_append, sb_build from string_builder;

# ═══════════════════════════════════════════════════════
# Middleware actions
# ═══════════════════════════════════════════════════════

const MW_CONTINUE  = 0;   # pass to next middleware
const MW_HALT      = 1;   # stop chain, return response
const MW_ERROR     = 2;   # error occurred

# ═══════════════════════════════════════════════════════
# Middleware context
# ═══════════════════════════════════════════════════════

entity MwRequest:
    method:    string,
        path:      string,
        headers:   Map,
        body:      string,
        extras:    Map;      # middleware can attach data
end.

entity MwResponse:
    status:    int,
        headers:   Map,
        body:      string;
end.

entity MwResult:
    action:   int;       # MW_CONTINUE, MW_HALT, MW_ERROR
    request:  MwRequest,
        response: MwResponse;
end.

func mw_request_new:
    in(method: string; path: string)
    out MwRequest {
        method: method, path: path,
        headers: map_new(), body: "", extras: map_new()
    };
end.

func mw_response_new:
    in(status: int; body: string)
    out MwResponse { status: status, headers: map_new(), body: body };
end

# ═══════════════════════════════════════════════════════
# Middleware definition
# ═══════════════════════════════════════════════════════

entity Middleware:
    name:        string,
        handler_id:  int;     # function pointer / handler ID
    priority:    int;     # lower = runs first
end

# ═══════════════════════════════════════════════════════
# Middleware Stack
# ═══════════════════════════════════════════════════════

entity MiddlewareStack:
    layers:  Vec;     # Vec<Middleware>
end.

func mw_stack_new:
    out MiddlewareStack { layers: vec_new() };
end.

func mw_stack_use:
    in(stack: MiddlewareStack; name: string; handler_id: int; priority: int)
    mw = Middleware { name: name, handler_id: handler_id, priority: priority };

    # Insert sorted by priority
    inserted = false;
    new_layers = vec_new();
    i = 0;
    when i < vec_len(stack.layers) loop
        existing = vec_get(stack.layers, i);
        if !inserted && priority < existing.priority do
            vec_push(new_layers, mw);
            inserted = true;
        end
        vec_push(new_layers, existing);
        i = i + 1;
    end
    if !inserted do
        vec_push(new_layers, mw);
    end
    stack.layers = new_layers;
end

# ═══════════════════════════════════════════════════════
# Built-in middleware: Logging
# ═══════════════════════════════════════════════════════

const MW_LOGGER_ID = 1;

func mw_logger_before:
    in(req: MwRequest)
    # Record start time placeholder
    map_insert(req.extras, "_log_method", req.method);
    map_insert(req.extras, "_log_path", req.path);
    out MwResult {
        action: MW_CONTINUE,
        request: req,
        response: mw_response_new(0, "")
    };
end

# ═══════════════════════════════════════════════════════
# Built-in middleware: Request ID
# ═══════════════════════════════════════════════════════

const MW_REQID_ID = 2;

entity ReqIdState:
    counter: int;
end.

func mw_reqid:
    in(req: MwRequest; state: ReqIdState)
    state.counter = state.counter + 1;
    sb = sb_new();
    sb_append(sb, "req-");
    # Simple int-to-string via repeated digit extraction
    n = state.counter;
    digits = vec_new();
    when n > 0 loop
        d = n % 10;
        vec_push(digits, d + 48);   # ASCII '0' = 48
        n = n / 10;
    end
    i = vec_len(digits) - 1;
    when i >= 0 loop
        sb_append(sb, chr(vec_get(digits, i)));
        i = i - 1;
    end

    req_id = sb_build(sb);
    map_insert(req.headers, "X-Request-Id", req_id);
    map_insert(req.extras, "request_id", req_id);

    out MwResult {
        action: MW_CONTINUE,
        request: req,
        response: mw_response_new(0, "")
    };
end

# ═══════════════════════════════════════════════════════
# Built-in middleware: Security headers
# ═══════════════════════════════════════════════════════

const MW_SECURITY_ID = 3;

func mw_security_after:
    in(resp: MwResponse)
    map_insert(resp.headers, "X-Content-Type-Options", "nosniff");
    map_insert(resp.headers, "X-Frame-Options", "DENY");
    map_insert(resp.headers, "X-XSS-Protection", "1; mode=block");
    map_insert(resp.headers, "Referrer-Policy", "strict-origin-when-cross-origin");
    out resp;
end

# ═══════════════════════════════════════════════════════
# Chain execution helper
# ═══════════════════════════════════════════════════════

entity ChainState:
    stack:     MiddlewareStack,
        position:  int,
        halted:    bool,
        response:  MwResponse;
end.

func chain_new:
    in(stack: MiddlewareStack)
    out ChainState {
        stack: stack, position: 0, halted: false,
        response: mw_response_new(200, "")
    };
end.

func chain_count:
    in(stack: MiddlewareStack)
    out vec_len(stack.layers);
end.

func mw_stack_layer_at:
    in(stack: MiddlewareStack; idx: int)
    if idx >= 0 && idx < vec_len(stack.layers) do
        out Some(vec_get(stack.layers, idx));
    end
    out None;
end
