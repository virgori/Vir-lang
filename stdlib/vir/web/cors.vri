##
 * vir/web/cors.vri — CORS (Cross-Origin Resource Sharing)
 * ==========================================================
 * Inspired by: rs/cors, Express CORS middleware
 *
 * Configurable CORS policy with preflight handling,
 * origin validation, and header management.
 ##

include types;
include vec;
import Vec, vec_new, vec_push, vec_len, vec_get from vec;
include map;
import Map, map_new, map_insert, map_get from map;
include string_builder;
import StringBuilder, sb_new, sb_append, sb_build from string_builder;

# ═══════════════════════════════════════════════════════
# CORS Configuration
# ═══════════════════════════════════════════════════════

entity CorsConfig:
    allow_origins:      Vec;     # Vec<string>, ["*"] for any
    allow_methods:      Vec;     # Vec<string>
    allow_headers:      Vec;     # Vec<string>
    expose_headers:     Vec;     # Vec<string>
    allow_credentials:  bool;
    max_age:            int;     # preflight cache seconds
end

func cors_default:
    methods = vec_new();
    vec_push(methods, "GET");
    vec_push(methods, "POST");
    vec_push(methods, "PUT");
    vec_push(methods, "DELETE");
    vec_push(methods, "PATCH");
    vec_push(methods, "OPTIONS");

    headers = vec_new();
    vec_push(headers, "Content-Type");
    vec_push(headers, "Authorization");
    vec_push(headers, "Accept");

    origins = vec_new();
    vec_push(origins, "*");

    out CorsConfig {
        allow_origins: origins,
        allow_methods: methods,
        allow_headers: headers,
        expose_headers: vec_new(),
        allow_credentials: false,
        max_age: 86400
    };
end

func cors_new:
    in(origins: Vec; methods: Vec; headers: Vec)
    out CorsConfig {
        allow_origins: origins,
        allow_methods: methods,
        allow_headers: headers,
        expose_headers: vec_new(),
        allow_credentials: false,
        max_age: 86400
    };
end

# ═══════════════════════════════════════════════════════
# Origin checking
# ═══════════════════════════════════════════════════════

func cors_is_origin_allowed:
    in(config: CorsConfig; origin: string)
    i = 0;
    when i < vec_len(config.allow_origins) loop
        allowed = vec_get(config.allow_origins, i);
        if allowed == "*" || allowed == origin:
            out true;
        end
        i = i + 1;
    end
    out false;
end

# ═══════════════════════════════════════════════════════
# Method checking
# ═══════════════════════════════════════════════════════

func cors_is_method_allowed:
    in(config: CorsConfig; method: string)
    i = 0;
    when i < vec_len(config.allow_methods) loop
        if vec_get(config.allow_methods, i) == method:
            out true;
        end
        i = i + 1;
    end
    out false;
end

# ═══════════════════════════════════════════════════════
# Join list helper
# ═══════════════════════════════════════════════════════

func _join_vec:
    in(items: Vec; sep: string)
    sb = sb_new();
    i = 0;
    when i < vec_len(items) loop
        if i > 0:
            sb_append(sb, sep);
        end
        sb_append(sb, vec_get(items, i));
        i = i + 1;
    end
    out sb_build(sb);
end

# ═══════════════════════════════════════════════════════
# Generate CORS headers
# ═══════════════════════════════════════════════════════

func cors_headers:
    in(config: CorsConfig; origin: string)
    hdrs = map_new();

    if cors_is_origin_allowed(config, origin):
        # If wildcard and no credentials, use *
        if vec_len(config.allow_origins) == 1 && vec_get(config.allow_origins, 0) == "*" && !config.allow_credentials:
            map_insert(hdrs, "Access-Control-Allow-Origin", "*");
        else:
            map_insert(hdrs, "Access-Control-Allow-Origin", origin);
            map_insert(hdrs, "Vary", "Origin");
        end

        if config.allow_credentials:
            map_insert(hdrs, "Access-Control-Allow-Credentials", "true");
        end

        if vec_len(config.expose_headers) > 0:
            map_insert(hdrs, "Access-Control-Expose-Headers", _join_vec(config.expose_headers, ", "));
        end
    end

    out hdrs;
end

# ═══════════════════════════════════════════════════════
# Preflight response headers
# ═══════════════════════════════════════════════════════

func cors_preflight_headers:
    in(config: CorsConfig; origin: string; request_method: string; request_headers: string)
    hdrs = cors_headers(config, origin);

    if cors_is_origin_allowed(config, origin):
        map_insert(hdrs, "Access-Control-Allow-Methods", _join_vec(config.allow_methods, ", "));
        map_insert(hdrs, "Access-Control-Allow-Headers", _join_vec(config.allow_headers, ", "));
        map_insert(hdrs, "Access-Control-Max-Age", int_to_str(config.max_age));
    end

    out hdrs;
end

# ═══════════════════════════════════════════════════════
# Preflight detection
# ═══════════════════════════════════════════════════════

func cors_is_preflight:
    in(method: string; headers: Map)
    if method != "OPTIONS":
        out false;
    end
    out map_contains(headers, "Access-Control-Request-Method") || map_contains(headers, "Origin");
end
