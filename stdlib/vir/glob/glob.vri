##
 * vir/glob/glob.vri — Glob Pattern Matching
 * ============================================
 * Inspired by Python: fnmatch, glob
 * Inspired by Rust: globset crate
 * Inspired by C: fnmatch(), glob()
 *
 * Shell-style wildcards: *, ?, **, [abc], [!abc], {a,b}
 ##

include types;
include result;
import Result, Ok, Err from result;
include string;
import String, str_new, str_byte_len, str_ptr from string;
include vec;
import Vec, vec_new, vec_push from vec;
include fs;
import fs_read_dir, DirEntry from fs;

# ═══════════════════════════════════════════════════════
# Pattern Matching
# ═══════════════════════════════════════════════════════

## Match a string against a glob pattern.
## Supports: * (any non-/ chars), ? (any single char), [abc], [!abc]
func glob_match:
    in(pattern: string; text: string)
    out _glob_match_impl(str_ptr(pattern), str_byte_len(pattern), 0,
                          str_ptr(text), str_byte_len(text), 0);
end.

func _glob_match_impl:
    in(pat: ptr; plen: int; pi: int,
        txt: ptr; tlen: int; ti: int)

    when pi < plen loop
        pc = native_load_u8(ptr_add(pat, pi));

        if pc == 0x2A do # '*'
            # Check for ** (match across /)
            if pi + 1 < plen & native_load_u8(ptr_add(pat, pi + 1)) == 0x2A do
                # ** matches everything including /
                pi = pi + 2;
                # Skip optional / after **
                if pi < plen & native_load_u8(ptr_add(pat, pi)) == 0x2F do
                    pi = pi + 1;
                end
                # Try matching the rest at every position
                k = ti;
                when k <= tlen loop
                    if _glob_match_impl(pat, plen, pi, txt, tlen, k) do
                        out true;
                    end
                    k = k + 1;
                end
                out false;
            end

            # Single * — match any chars except /
            pi = pi + 1;
            k = ti;
            when k <= tlen loop
                if _glob_match_impl(pat, plen, pi, txt, tlen, k) do
                    out true;
                end
                if k < tlen & native_load_u8(ptr_add(txt, k)) == 0x2F do
                    break;   # * doesn't cross /
                end
                k = k + 1;
            end
            out false;

        eif pc == 0x3F do # '?'
            if ti >= tlen do out false end
            tc = native_load_u8(ptr_add(txt, ti));
            if tc == 0x2F do out false end # ? doesn't match /
            pi = pi + 1;
            ti = ti + 1;

        eif pc == 0x5B do # '['
            if ti >= tlen do out false end
            tc = native_load_u8(ptr_add(txt, ti));
            pi = pi + 1;
            negate = false;
            if pi < plen & native_load_u8(ptr_add(pat, pi)) == 0x21 do # '!'
                negate = true;
                pi = pi + 1;
            end
            matched = false;
            when pi < plen loop
                cc = native_load_u8(ptr_add(pat, pi));
                if cc == 0x5D do break end # ']'
                # Range: a-z
                if pi + 2 < plen & native_load_u8(ptr_add(pat, pi + 1)) == 0x2D do
                    hi = native_load_u8(ptr_add(pat, pi + 2));
                    if tc >= cc & tc <= hi do
                        matched = true;
                    end
                    pi = pi + 3;
                else
                    if tc == cc do matched = true end
                    pi = pi + 1;
                end
            end
            if pi < plen do pi = pi + 1 end # skip ']'
            if negate do matched = !matched end
            if !matched do out false end
            ti = ti + 1;

        else
            if ti >= tlen do out false end
            tc = native_load_u8(ptr_add(txt, ti));
            if pc != tc do out false end
            pi = pi + 1;
            ti = ti + 1;
        end
    end

    out ti == tlen;
end

# ═══════════════════════════════════════════════════════
# Directory Globbing
# ═══════════════════════════════════════════════════════

## Find all files matching pattern under base_dir.
func glob_find:
    in(base_dir: string; pattern: string)
    results = vec_new<string>();
    _glob_walk(base_dir, pattern, &results);
    out results;
end.

func _glob_walk:
    in(dir: string; pattern: string; results: ptr)
    entries_r = fs_read_dir(dir);
    if is_err(entries_r) do out end
    entries = unwrap_ok(entries_r);

    i = 0;
    when i < vec_len<DirEntry>(entries) loop
        entry = vec_get<DirEntry>(entries, i);
        if glob_match(pattern, entry.name) do
            vec_push<string>(results, entry.path);
        end
        if entry.is_dir do
            _glob_walk(entry.path, pattern, results);
        end
        i = i + 1;
    end
end

# ═══════════════════════════════════════════════════════
# Utility
# ═══════════════════════════════════════════════════════

## Escape special glob characters in a string.
func glob_escape:
    in(s: string)
    result = str_new("");
    i = 0;
    slen = str_byte_len(s);
    when i < slen loop
        b = native_load_u8(ptr_add(str_ptr(s), i));
        if b == 0x2A | b == 0x3F | b == 0x5B | b == 0x5D | b == 0x7B | b == 0x7D do
            result = str_concat(result, str_new("\\"));
        end
        result = str_concat(result, str_from_bytes(&b, 1));
        i = i + 1;
    end
    out result;
end

## Check if a pattern contains any glob special characters.
func glob_is_literal:
    in(pattern: string)
    i = 0;
    plen = str_byte_len(pattern);
    when i < plen loop
        b = native_load_u8(ptr_add(str_ptr(pattern), i));
        if b == 0x2A | b == 0x3F | b == 0x5B | b == 0x7B do
            out false;
        end
        i = i + 1;
    end
    out true;
end
