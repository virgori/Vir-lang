/*
 * vir/bench/bench.vri — Benchmarking Framework
 * ===============================================
 * Phase D — measure function performance
 *
 * Inspired by: Rust criterion, Python timeit
 */

import "vir/core/types" use all
import "vir/str/string" use String, str_new, str_concat
import "vir/str/builder" use sb_new, sb_append, sb_build
import "vir/collections/vec" use Vec, vec_new, vec_push, vec_len, vec_get
import "vir/time/time" use Instant, instant_now, instant_elapsed_ns
import "vir/io/stdio" use println
import "vir/sort/sort" use sort

# ═══════════════════════════════════════════════════════
# Benchmark
# ═══════════════════════════════════════════════════════

entity BenchResult
    name:       String
    iterations: u64
    total_ns:   u64
    min_ns:     u64
    max_ns:     u64
    mean_ns:    u64
    median_ns:  u64
end

entity BenchConfig
    warmup_iters:  u64
    min_iters:     u64
    max_time_ns:   u64     # target time budget (default 1s)
end

func bench_config_default() -> BenchConfig
    out BenchConfig {
        warmup_iters = 10,
        min_iters = 100,
        max_time_ns = 1_000_000_000   # 1 second
    }
end

entity BenchSuite
    name:    String
    cases:   Vec<BenchCase>
    config:  BenchConfig
end

entity BenchCase
    name: String
    func: func() -> void
end

func bench_suite(name: String) -> BenchSuite
    out BenchSuite {
        name = name,
        cases = vec_new<BenchCase>(),
        config = bench_config_default()
    }
end

func bench_add(suite: &BenchSuite, name: String, func: func() -> void)
    vec_push<BenchCase>(&suite.cases, BenchCase { name = name, func = func })
end

func bench_run(suite: BenchSuite) -> Vec<BenchResult>
    var results = vec_new<BenchResult>()
    
    println(str_concat(str_new("=== Benchmark: "), suite.name))
    println(str_new(""))
    
    var i: usize = 0
    lặp_khi i < vec_len<BenchCase>(suite.cases)
        var c = vec_get<BenchCase>(suite.cases, i)
        var result = _run_bench(c, suite.config)
        _print_result(result)
        vec_push<BenchResult>(&results, result)
        i = i + 1
    end
    
    out results
end

func _run_bench(c: BenchCase, cfg: BenchConfig) -> BenchResult
    # Warmup
    var w: u64 = 0
    lặp_khi w < cfg.warmup_iters c.func(); w = w + 1 end
    
    # Collect samples
    var samples = vec_new<u64>()
    var total: u64 = 0
    var count: u64 = 0
    
    loop
        var start = instant_now()
        c.func()
        var elapsed = instant_elapsed_ns(start)
        
        vec_push<u64>(&samples, elapsed)
        total = total + elapsed
        count = count + 1
        
        if count >= cfg.min_iters and total >= cfg.max_time_ns thoát end
    end
    
    # Statistics
    var sorted = _sort_u64(samples)
    var n = vec_len<u64>(sorted)
    var min_v = vec_get<u64>(sorted, 0)
    var max_v = vec_get<u64>(sorted, n - 1)
    var median = vec_get<u64>(sorted, n / 2)
    var mean = total / count
    
    out BenchResult {
        name = c.name,
        iterations = count,
        total_ns = total,
        min_ns = min_v,
        max_ns = max_v,
        mean_ns = mean,
        median_ns = median
    }
end

func _sort_u64(v: Vec<u64>) -> Vec<u64>
    # Simple insertion sort for benchmark samples
    var n = vec_len<u64>(v)
    var i: usize = 1
    lặp_khi i < n
        var key = vec_get<u64>(v, i)
        var j: i32 = i - 1
        lặp_khi j >= 0 and vec_get<u64>(v, j) > key
            vec_set<u64>(&v, j + 1, vec_get<u64>(v, j))
            j = j - 1
        end
        vec_set<u64>(&v, j + 1, key)
        i = i + 1
    end
    out v
end

func _print_result(r: BenchResult)
    var sb = sb_new()
    sb_append(&sb, str_new("  "))
    sb_append(&sb, r.name)
    sb_append(&sb, str_new(":\t"))
    sb_append(&sb, _format_ns(r.mean_ns))
    sb_append(&sb, str_new("/iter"))
    sb_append(&sb, str_new("  (min="))
    sb_append(&sb, _format_ns(r.min_ns))
    sb_append(&sb, str_new(", max="))
    sb_append(&sb, _format_ns(r.max_ns))
    sb_append(&sb, str_new(", median="))
    sb_append(&sb, _format_ns(r.median_ns))
    sb_append(&sb, str_new(", n="))
    sb_append(&sb, int_to_string(r.iterations))
    sb_append(&sb, str_new(")"))
    println(sb_build(sb))
end

func _format_ns(ns: u64) -> String
    if ns >= 1_000_000_000
        out str_concat(float_to_string(ns / 1_000_000_000.0), str_new(" s"))
    eif ns >= 1_000_000
        out str_concat(float_to_string(ns / 1_000_000.0), str_new(" ms"))
    eif ns >= 1_000
        out str_concat(float_to_string(ns / 1_000.0), str_new(" µs"))
    else
        out str_concat(int_to_string(ns), str_new(" ns"))
    end
end
