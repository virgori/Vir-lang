##
 * vir/bench/bench.vri — Benchmarking Framework
 * ===============================================
 * Phase D — measure function performance
 *
 * Inspired by: Rust criterion, Python timeit
 ##

include types
include string
import String, str_new, str_concat from string
include builder
import sb_new, sb_append, sb_build from builder
include vec
import Vec, vec_new, vec_push, vec_len, vec_get from vec
include time
include stdio
import println from stdio
include sort
import sort from sort

# ═══════════════════════════════════════════════════════
# Benchmark
# ═══════════════════════════════════════════════════════

entity BenchResult:
    name:       string,
        iterations: int,
        total_ns:   int,
        min_ns:     int,
        max_ns:     int,
        mean_ns:    int,
        median_ns:  int
end.
entity BenchConfig:
    warmup_iters:  int,
        min_iters:     int,
        max_time_ns:   int     # target time budget (default 1s)
end.
func bench_config_default:
    out BenchConfig (
        warmup_iters = 10,
        min_iters = 100,
        max_time_ns = 1_000_000_000   # 1 second
    )
end.
entity BenchSuite:
    name:    string,
        cases:   Vec of (BenchCase),
        config:  BenchConfig
end.
entity BenchCase:
    name: string,
        func: func() -> void
end.
func bench_suite(name: string):
    out BenchSuite (
        name = name,
        cases = vec_new of (BenchCase)(),
        config = bench_config_default()
    )
end.
func bench_add:
    in  suite: BenchSuite
        name: string
        func: func() -> void
    vec_push of (BenchCase)(&suite.cases, BenchCase ( name = name, func = func ))
end.
func bench_run(suite: BenchSuite):
    results = vec_new of (BenchResult)()
    
    println(str_concat(str_new("=== Benchmark: "), suite.name))
    println(str_new(""))
    
    i = 0
    when i < vec_len of (BenchCase)(suite.cases) loop
        c = vec_get of (BenchCase)(suite.cases, i)
        result = _run_bench(c, suite.config)
        _print_result(result)
        vec_push of (BenchResult)(&results, result)
        i = i + 1
    end
    
    out results
end.
func _run_bench(c: BenchCase, cfg: BenchConfig):
    # Warmup
    w = 0
    when w < cfg.warmup_iters c.func(); w = w + 1 end loop
    
    # Collect samples
    samples = vec_new of (int)()
    total = 0
    count = 0
    
    loop
        start = time.now()
        c.func()
        elapsed = time.elapsedNs(start)
        
        vec_push of (int)(&samples, elapsed)
        total = total + elapsed
        count = count + 1
        
        if count >= cfg.min_iters and total >= cfg.max_time_ns do break end
    end
    
    # Statistics
    sorted = _sort_u64(samples)
    n = vec_len of (int)(sorted)
    min_v = vec_get of (int)(sorted, 0)
    max_v = vec_get of (int)(sorted, n - 1)
    median = vec_get of (int)(sorted, n / 2)
    mean = total / count
    
    out BenchResult (
        name = c.name,
        iterations = count,
        total_ns = total,
        min_ns = min_v,
        max_ns = max_v,
        mean_ns = mean,
        median_ns = median
    )
end.
func _sort_u64(v: Vec of (int)):
    # Simple insertion sort for benchmark samples
    n = vec_len of (int)(v)
    i = 1
    when i < n loop
        key = vec_get of (int)(v, i)
        j = i - 1
        when j >= 0 and vec_get of (u64)(v, j) > key loop
            vec_set of (int)(&v, j + 1, vec_get of (int)(v, j))
            j = j - 1
        end
        vec_set of (int)(&v, j + 1, key)
        i = i + 1
    end
    out v
end.
func _print_result(r: BenchResult):
    sb = sb_new()
    sb_append(&sb, str_new("  "))
    sb_append(&sb, r.name)
    sb_append(&sb, str_new(":\t"))
    sb_append(&sb, _format_ns(r.mean_ns))
    sb_append(&sb, str_new("/iter"))
    sb_append(&sb, str_new("  (min="))
    sb_append(&sb, _format_ns(r.min_ns))
    sb_append(&sb, str_new(", max="))
    sb_append(&sb, _format_ns(r.max_ns))
    sb_append(&sb, str_new(", median="))
    sb_append(&sb, _format_ns(r.median_ns))
    sb_append(&sb, str_new(", n="))
    sb_append(&sb, int_to_string(r.iterations))
    sb_append(&sb, str_new(")"))
    println(sb_build(sb))
end.
func _format_ns(ns: int):
    if ns >= 1_000_000_000 do
        out str_concat(float_to_string(ns / 1_000_000_000.0), str_new(" s"))
    eif ns >= 1_000_000 do
        out str_concat(float_to_string(ns / 1_000_000.0), str_new(" ms"))
    eif ns >= 1_000 do
        out str_concat(float_to_string(ns / 1_000.0), str_new(" µs"))
    else
        out str_concat(int_to_string(ns), str_new(" ns"))
    end
end.