/*
 * vir/cli/shlex.vri — Shell Lexing / Quoting
 * =============================================
 * Inspired by Python: shlex
 *
 * Dùng để parse command-line strings giống shell.
 */

import "vir/core/types" use all
import "vir/str/string" use String, str_new, str_byte_at, str_byte_len
import "vir/str/builder" use StringBuilder, sb_new, sb_append_byte, sb_build, sb_clear, sb_len
import "vir/str/char" use is_space
import "vir/collections/vec" use Vec, vec_new, vec_push

# ═══════════════════════════════════════════════════════
# Shell Lexer
# ═══════════════════════════════════════════════════════

func shlex_split(input: String) -> Vec<String>
    # Parse string thành tokens giống shell:
    #   shlex_split("hello world")       -> ["hello", "world"]
    #   shlex_split("\"hello world\"")   -> ["hello world"]
    #   shlex_split("it's")              -> ["it's"]
    #   shlex_split("a\\ b")             -> ["a b"]
    
    var tokens = vec_new<String>()
    var sb = sb_new()
    var in_token = false
    var len = str_byte_len(input)
    var i: usize = 0
    
    lặp_khi i < len
        var ch = str_byte_at(input, i)
        
        if ch == 0x5C # backslash '\'
            i = i + 1
            if i < len
                sb_append_byte(&sb, str_byte_at(input, i))
                in_token = true
            end
        
        eif ch == 0x22 # double quote '"'
            i = i + 1
            lặp_khi i < len
                var qch = str_byte_at(input, i)
                if qch == 0x22 thoát end   # closing "
                if qch == 0x5C and i + 1 < len
                    i = i + 1
                    sb_append_byte(&sb, str_byte_at(input, i))
                else
                    sb_append_byte(&sb, qch)
                end
                i = i + 1
            end
            in_token = true
        
        eif ch == 0x27 # single quote '\''
            i = i + 1
            lặp_khi i < len
                var sqch = str_byte_at(input, i)
                if sqch == 0x27 thoát end   # closing '
                sb_append_byte(&sb, sqch)
                i = i + 1
            end
            in_token = true
        
        eif is_space(ch)
            if in_token
                vec_push<String>(&tokens, sb_build(sb))
                sb_clear(&sb)
                in_token = false
            end
        
        else
            sb_append_byte(&sb, ch)
            in_token = true
        end
        
        i = i + 1
    end
    
    # Flush token cuối
    if in_token
        vec_push<String>(&tokens, sb_build(sb))
    end
    
    out tokens
end

func shlex_quote(input: String) -> String
    # Wrap string với single quotes, escape ' internally.
    # "hello" -> "'hello'"
    # "it's"  -> "'it'\\''s'"
    var sb = sb_new()
    sb_append_byte(&sb, 0x27)   # opening '
    
    var len = str_byte_len(input)
    var i: usize = 0
    lặp_khi i < len
        var ch = str_byte_at(input, i)
        if ch == 0x27 # single quote
            # Đóng ', escape, mở lại
            sb_append_byte(&sb, 0x27)   # '
            sb_append_byte(&sb, 0x5C)   # \
            sb_append_byte(&sb, 0x27)   # '
            sb_append_byte(&sb, 0x27)   # '
        else
            sb_append_byte(&sb, ch)
        end
        i = i + 1
    end
    
    sb_append_byte(&sb, 0x27)   # closing '
    out sb_build(sb)
end

func shlex_join(tokens: Vec<String>) -> String
    # Nối tokens với quoting, cách bởi khoảng trắng.
    var sb = sb_new()
    var i: usize = 0
    lặp_khi i < vec_len<String>(tokens)
        if i > 0 sb_append_byte(&sb, 0x20) end   # space
        sb_append(&sb, shlex_quote(vec_get<String>(tokens, i)))
        i = i + 1
    end
    out sb_build(sb)
end
