##
 * vir/cli/shlex.vri — Shell Lexing / Quoting
 * =============================================
 * Inspired by Python: shlex
 *
 * Dùng để parse command-line strings giống shell.
 ##

include types;
include string;
import String, str_new, str_byte_at, str_byte_len from string;
include builder;
import StringBuilder, sb_new, sb_append_byte, sb_build, sb_clear, sb_len from builder;
include char;
import is_space from char;
include vec;
import Vec, vec_new, vec_push from vec;

# ═══════════════════════════════════════════════════════
# Shell Lexer
# ═══════════════════════════════════════════════════════

func shlex_split:
    in(input:string)
    # Parse string thành tokens giống shell
    #   shlex_split("hello world")       -> ["hello", "world"]
    #   shlex_split("\"hello world\"")   -> ["hello world"]
    #   shlex_split("it's")              -> ["it's"]
    #   shlex_split("a\\ b")             -> ["a b"]
    
    tokens = vec_new<string>();
    sb = sb_new();
    in_token = false;
    len = str_byte_len(input);
    i = 0;
    
    when i < len loop
        ch = str_byte_at(input, i);
        
        if ch == 0x5C do # backslash '\' do
            i = i + 1;
            if i < len do
                sb_append_byte(&sb, str_byte_at(input, i));
                in_token = true;
            end
        
        eif ch == 0x22 do # double quote '"' do
            i = i + 1;
            when i < len loop
                qch = str_byte_at(input, i);
                if qch == 0x22 do break end # closing "
                if qch == 0x5C and i + 1 < len do
                    i = i + 1;
                    sb_append_byte(&sb, str_byte_at(input, i));
                else
                    sb_append_byte(&sb, qch);
                end
                i = i + 1;
            end
            in_token = true;
        
        eif ch == 0x27 do # single quote '\'' do
            i = i + 1;
            when i < len loop
                sqch = str_byte_at(input, i);
                if sqch == 0x27 do break end # closing '
                sb_append_byte(&sb, sqch);
                i = i + 1;
            end
            in_token = true;
        
        eif is_space(ch) do
            if in_token do
                vec_push<string>(&tokens, sb_build(sb));
                sb_clear(&sb);
                in_token = false;
            end
        
        else
            sb_append_byte(&sb, ch);
            in_token = true;
        end
        
        i = i + 1;
    end
    
    # Flush token cuối
    if in_token do
        vec_push<string>(&tokens, sb_build(sb));
    end
    
    out tokens;
end.

func shlex_quote:
    in(input:string)
    # Wrap string với single quotes, escape ' internally.
    # "hello" -> "'hello'"
    # "it's"  -> "'it'\\''s'"
    sb = sb_new();
    sb_append_byte(&sb, 0x27)   # opening ';
    
    len = str_byte_len(input);
    i = 0;
    when i < len loop
        ch = str_byte_at(input, i);
        if ch == 0x27 do # single quote do
            # Đóng ', escape, mở lại
            sb_append_byte(&sb, 0x27)   # ';
            sb_append_byte(&sb, 0x5C)   # \;
            sb_append_byte(&sb, 0x27)   # ';
            sb_append_byte(&sb, 0x27)   # ';
        else
            sb_append_byte(&sb, ch);
        end
        i = i + 1;
    end
    
    sb_append_byte(&sb, 0x27)   # closing ';
    out sb_build(sb);
end.

func shlex_join:
    in(tokens:Vec<string>)
    # Nối tokens với quoting, cách bởi khoảng trắng.
    sb = sb_new();
    i = 0;
    when i < vec_len<String>(tokens) loop
        if i > 0 do sb_append_byte(&sb, 0x20) end # space
        sb_append(&sb, shlex_quote(vec_get<string>(tokens, i)));
        i = i + 1;
    end
    out sb_build(sb);
end
