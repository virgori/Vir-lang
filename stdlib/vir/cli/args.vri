##
 * vir/cli/args.vri — Command-Line Argument Parsing
 * ===================================================
 * Inspired by Python: argparse
 * Inspired by Rust: clap (simplified)
 *
 * Compiler uses internally: parse CLI flags (--output, --arch, --optimize, etc.)
 ##

include types;
include option;
import Option, Some, None from option;
include string;
import String, str_new, str_eq, str_starts_with, str_slice, str_len, str_find, str_concat from string;
include vec;
import Vec, vec_new, vec_push, vec_get, vec_len, vec_contains from vec;
include env;
import args from env;

# ═══════════════════════════════════════════════════════
# ArgParser — Declarative CLI parser
# ═══════════════════════════════════════════════════════

enum ArgType:
    Flag    = 1   # --verbose (boolean, not cần value);
    Single  = 2   # --output file (cần 1 value);
    Multi   = 3   # --include a --include b (nhiều value);
end.
entity ArgDef:
    short_name: string    # "-o",
        long_name:  string    # "--output",
        help_text:  string    # Description,
        arg_type:   ArgType,
        required:   bool,
        default_val: Option<string>;
end.
entity ArgResult:
    name:   string           # long_name (not có --),
        values: Vec<string>      # Danh sách value;
end.
entity ArgParser:
    program:     string,
        description: string,
        version:     string,
        defs:        Vec<ArgDef>       # Danh sách argument definitions,
        positional:  Vec<string>       # Positional args (not có --),
        results:     Vec<ArgResult>    # Result parse,
        errors:      Vec<string>       # Error parse;
end.

# ─── Builder ──────────────────────────────────────────

func argparser_new(program: string, desc: string):
    out ArgParser (;
        program = program,
        description = desc,
        version = str_new("0.1.0"),
        defs = vec_new<ArgDef>(),
        positional = vec_new<string>(),
        results = vec_new<ArgResult>(),
        errors = vec_new<string>()
    );
end.
func argparser_version(p: ArgParser, ver: string):
    p.version = ver;
end.
func argparser_add:
    in  p: &ArgParser;
        short: string;
        long: string;
        help: string;
        atype: ArgType;
        required: bool;
        default_val: Option<string>
    vec_push<ArgDef>(&p.defs, ArgDef (;
        short_name = short,
        long_name = long,
        help_text = help,
        arg_type = atype,
        required = required,
        default_val = default_val
    ));
end.
func argparser_flag:
    in  p: ArgParser;
        short: string;
        long: string;
        help: string
    argparser_add(p, short, long, help, ArgType.Flag, false, None);
end.
func argparser_option:
    in  p: &ArgParser;
        short: string;
        long: string;
        help: string;
        default_val: Option<string>
    argparser_add(p, short, long, help, ArgType.Single, false, default_val);
end.
func argparser_required:
    in  p: ArgParser;
        short: string;
        long: string;
        help: string
    argparser_add(p, short, long, help, ArgType.Single, true, None);
end.
# ─── Parse ────────────────────────────────────────────

func argparser_parse(p: ArgParser):
    # Parse từ process arguments. Returns true if success.
    argv = args();
    argc = vec_len<string>(argv);
    i = 1   # skip program name;
    
    when i < argc loop
        arg = vec_get<string>(argv, i);
        
        if str_eq(arg, str_new("--help")) or str_eq(arg, str_new("-h")) do
            argparser_print_help(*p);
            out false;
        end
        
        if str_eq(arg, str_new("--version")) do
            println(str_concat(p.program, str_concat(str_new(" "), p.version)));
            out false;
        end
        
        if str_starts_with(arg, str_new("--")) or str_starts_with(arg, str_new("-")) do
            # Tìm ArgDef tương ứng
            def = _find_def(*p, arg);
            case def;
        Some(d):
                    case d.arg_type;
                        case ArgType.Flag
                            _add_result(p, d.long_name, str_new("true"));
                        case ArgType.Single
                            i = i + 1;
                            if i >= argc do
                                vec_push<string>(&p.errors,
                                    str_concat(str_new("Missing value for: "), arg));
                            else
                                _add_result(p, d.long_name, vec_get<string>(argv, i));
                            end
                        case ArgType.Multi
                            i = i + 1;
                            if i >= argc do
                                vec_push<string>(&p.errors,
                                    str_concat(str_new("Missing value for: "), arg));
                            else
                                _add_result(p, d.long_name, vec_get<string>(argv, i));
                            end
                    end
        None:
                    # --key=value form
                    eq_pos = str_find(arg, str_new("="));
                    case eq_pos;
        Some(pos):
                            key = str_slice(arg, 0, pos);
                            val = str_slice(arg, pos + 1, str_len(arg));
                            d2 = _find_def(*p, key);
                            case d2;
        Some(dd):
                                    _add_result(p, dd.long_name, val);
        None:
                                    vec_push<string>(&p.errors,
                                        str_concat(str_new("Unknown option: "), key));
                            end
        None:
                            vec_push<string>(&p.errors,
                                str_concat(str_new("Unknown option: "), arg));
                    end
            end
        else
            # Positional argument
            vec_push<string>(&p.positional, arg);
        end
        
        i = i + 1;
    end
    
    # Kiểm tra required args
    _check_required(p);
    
    # Apply defaults
    _apply_defaults(p);
    
    out vec_is_empty<string>(p.errors);
end.
# ─── Query Results ────────────────────────────────────

func argparser_has(p: ArgParser, name: string):
    i = 0;
    when i < vec_len<ArgResult>(p.results) loop
        r = vec_get<ArgResult>(p.results, i);
        if str_eq(r.name, name) do out true end
        i = i + 1;
    end
    out false;
end.
func argparser_get(p: ArgParser, name: string):
    i = 0;
    when i < vec_len<ArgResult>(p.results) loop
        r = vec_get<ArgResult>(p.results, i);
        if str_eq(r.name, name) do
            if vec_len<String>(r.values) > 0 do
                out Some(vec_get<string>(r.values, 0));
            end
        end
        i = i + 1;
    end
    out None;
end.
func argparser_get_all(p: ArgParser, name: string):
    i = 0;
    when i < vec_len<ArgResult>(p.results) loop
        r = vec_get<ArgResult>(p.results, i);
        if str_eq(r.name, name) do out r.values end
        i = i + 1;
    end
    out vec_new<string>();
end.
func argparser_positional(p: ArgParser):
    out p.positional;
end.
func argparser_errors(p: ArgParser):
    out p.errors;
end.
# ─── Help ─────────────────────────────────────────────

func argparser_print_help(p: ArgParser):
    println(str_concat(str_new("Usage: "), str_concat(p.program, str_new(" [OPTIONS]"))));
    println(p.description);
    println(str_new(""));
    println(str_new("Options:"));
    
    i = 0;
    when i < vec_len<ArgDef>(p.defs) loop
        d = vec_get<ArgDef>(p.defs, i);
        line = str_new("  ");
        line = str_concat(line, d.short_name);
        line = str_concat(line, str_new(", "));
        line = str_concat(line, d.long_name);
        line = str_concat(line, str_new("    "));
        line = str_concat(line, d.help_text);
        if d.required do
            line = str_concat(line, str_new(" (required)"));
        end
        println(line);
        i = i + 1;
    end
    
    println(str_new("  -h, --help       Show this help"));
    println(str_new("  --version        Show version"));
end.
# ─── Internal ─────────────────────────────────────────

func _find_def(p: ArgParser, name: string):
    i = 0;
    when i < vec_len<ArgDef>(p.defs) loop
        d = vec_get<ArgDef>(p.defs, i);
        if str_eq(d.long_name, name) or str_eq(d.short_name, name) do
            out Some(d);
        end
        i = i + 1;
    end
    out None;
end.
func _add_result:
    in  p: ArgParser;
        name: string;
        val: string
    # Tìm existing result or tạo mới
    i = 0;
    when i < vec_len<ArgResult>(p.results) loop
        r = vec_get<ArgResult>(p.results, i);
        if str_eq(r.name, name) do
            vec_push<string>(&r.values, val);
            vec_set<ArgResult>(&p.results, i, r);
            out;
        end
        i = i + 1;
    end
    v = vec_new<string>();
    vec_push<string>(&v, val);
    vec_push<ArgResult>(&p.results, ArgResult ( name = name, values = v ));
end.
func _check_required(p: ArgParser):
    i = 0;
    when i < vec_len<ArgDef>(p.defs) loop
        d = vec_get<ArgDef>(p.defs, i);
        if d.required and !argparser_has(*p, d.long_name) do
            vec_push<string>(&p.errors,
                str_concat(str_new("Missing required: "), d.long_name));
        end
        i = i + 1;
    end
end.
func _apply_defaults(p: ArgParser):
    i = 0;
    when i < vec_len<ArgDef>(p.defs) loop
        d = vec_get<ArgDef>(p.defs, i);
        if !argparser_has(*p, d.long_name) do
            case d.default_val;
        Some(v):
                    _add_result(p, d.long_name, v);
                case None ()
            end
        end
        i = i + 1;
    end
end.