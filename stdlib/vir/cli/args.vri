/*
 * vir/cli/args.vri — Command-Line Argument Parsing
 * ===================================================
 * Inspired by Python: argparse
 * Inspired by Rust: clap (simplified)
 *
 * Compiler uses internally: parse CLI flags (--output, --arch, --optimize, etc.)
 */

import "vir/core/types" use all
import "vir/core/option" use Option, Some, None
import "vir/str/string" use String, str_new, str_eq, str_starts_with, str_slice, str_len, str_find, str_concat
import "vir/collections/vec" use Vec, vec_new, vec_push, vec_get, vec_len, vec_contains
import "vir/env/env" use args

# ═══════════════════════════════════════════════════════
# ArgParser — Declarative CLI parser
# ═══════════════════════════════════════════════════════

enum ArgType
    Flag    = 1   # --verbose (boolean, not cần value)
    Single  = 2   # --output file (cần 1 value)
    Multi   = 3   # --include a --include b (nhiều value)
end

entity ArgDef
    short_name: String    # "-o"
    long_name:  String    # "--output"
    help_text:  String    # Description
    arg_type:   ArgType
    required:   bool
    default_val: Option<String>
end

entity ArgResult
    name:   String           # long_name (not có --)
    values: Vec<String>      # Danh sách value
end

entity ArgParser
    program:     String
    description: String
    version:     String
    defs:        Vec<ArgDef>       # Danh sách argument definitions
    positional:  Vec<String>       # Positional args (not có --)
    results:     Vec<ArgResult>    # Result parse
    errors:      Vec<String>       # Error parse
end

# ─── Builder ──────────────────────────────────────────

func argparser_new(program: String, desc: String) -> ArgParser
    out ArgParser {
        program = program,
        description = desc,
        version = str_new("0.1.0"),
        defs = vec_new<ArgDef>(),
        positional = vec_new<String>(),
        results = vec_new<ArgResult>(),
        errors = vec_new<String>()
    }
end

func argparser_version(p: &ArgParser, ver: String)
    p.version = ver
end

func argparser_add(p: &ArgParser, short: String, long: String,
                   help: String, atype: ArgType, required: bool,
                   default_val: Option<String>)
    vec_push<ArgDef>(&p.defs, ArgDef {
        short_name = short,
        long_name = long,
        help_text = help,
        arg_type = atype,
        required = required,
        default_val = default_val
    })
end

func argparser_flag(p: &ArgParser, short: String, long: String, help: String)
    argparser_add(p, short, long, help, ArgType.Flag, false, None)
end

func argparser_option(p: &ArgParser, short: String, long: String,
                      help: String, default_val: Option<String>)
    argparser_add(p, short, long, help, ArgType.Single, false, default_val)
end

func argparser_required(p: &ArgParser, short: String, long: String, help: String)
    argparser_add(p, short, long, help, ArgType.Single, true, None)
end

# ─── Parse ────────────────────────────────────────────

func argparser_parse(p: &ArgParser) -> bool
    # Parse từ process arguments. Returns true if success.
    var argv = args()
    var argc = vec_len<String>(argv)
    var i: usize = 1   # bỏ qua program name
    
    lặp_khi i < argc
        var arg = vec_get<String>(argv, i)
        
        if str_eq(arg, str_new("--help")) or str_eq(arg, str_new("-h"))
            argparser_print_help(*p)
            out false
        end
        
        if str_eq(arg, str_new("--version"))
            println(str_concat(p.program, str_concat(str_new(" "), p.version)))
            out false
        end
        
        if str_starts_with(arg, str_new("--")) or str_starts_with(arg, str_new("-"))
            # Tìm ArgDef tương ứng
            var def = _find_def(*p, arg)
            chọn def
                case Some(d)
                    chọn d.arg_type
                        case ArgType.Flag
                            _add_result(p, d.long_name, str_new("true"))
                        case ArgType.Single
                            i = i + 1
                            if i >= argc
                                vec_push<String>(&p.errors,
                                    str_concat(str_new("Missing value for: "), arg))
                            else
                                _add_result(p, d.long_name, vec_get<String>(argv, i))
                            end
                        case ArgType.Multi
                            i = i + 1
                            if i >= argc
                                vec_push<String>(&p.errors,
                                    str_concat(str_new("Missing value for: "), arg))
                            else
                                _add_result(p, d.long_name, vec_get<String>(argv, i))
                            end
                    end
                case None
                    # --key=value form
                    var eq_pos = str_find(arg, str_new("="))
                    chọn eq_pos
                        case Some(pos)
                            var key = str_slice(arg, 0, pos)
                            var val = str_slice(arg, pos + 1, str_len(arg))
                            var d2 = _find_def(*p, key)
                            chọn d2
                                case Some(dd)
                                    _add_result(p, dd.long_name, val)
                                case None
                                    vec_push<String>(&p.errors,
                                        str_concat(str_new("Unknown option: "), key))
                            end
                        case None
                            vec_push<String>(&p.errors,
                                str_concat(str_new("Unknown option: "), arg))
                    end
            end
        else
            # Positional argument
            vec_push<String>(&p.positional, arg)
        end
        
        i = i + 1
    end
    
    # Kiểm tra required args
    _check_required(p)
    
    # Apply defaults
    _apply_defaults(p)
    
    out vec_is_empty<String>(p.errors)
end

# ─── Query Results ────────────────────────────────────

func argparser_has(p: ArgParser, name: String) -> bool
    var i: usize = 0
    lặp_khi i < vec_len<ArgResult>(p.results)
        var r = vec_get<ArgResult>(p.results, i)
        if str_eq(r.name, name) out true end
        i = i + 1
    end
    out false
end

func argparser_get(p: ArgParser, name: String) -> Option<String>
    var i: usize = 0
    lặp_khi i < vec_len<ArgResult>(p.results)
        var r = vec_get<ArgResult>(p.results, i)
        if str_eq(r.name, name)
            if vec_len<String>(r.values) > 0
                out Some(vec_get<String>(r.values, 0))
            end
        end
        i = i + 1
    end
    out None
end

func argparser_get_all(p: ArgParser, name: String) -> Vec<String>
    var i: usize = 0
    lặp_khi i < vec_len<ArgResult>(p.results)
        var r = vec_get<ArgResult>(p.results, i)
        if str_eq(r.name, name) out r.values end
        i = i + 1
    end
    out vec_new<String>()
end

func argparser_positional(p: ArgParser) -> Vec<String>
    out p.positional
end

func argparser_errors(p: ArgParser) -> Vec<String>
    out p.errors
end

# ─── Help ─────────────────────────────────────────────

func argparser_print_help(p: ArgParser)
    println(str_concat(str_new("Usage: "), str_concat(p.program, str_new(" [OPTIONS]"))))
    println(p.description)
    println(str_new(""))
    println(str_new("Options:"))
    
    var i: usize = 0
    lặp_khi i < vec_len<ArgDef>(p.defs)
        var d = vec_get<ArgDef>(p.defs, i)
        var line = str_new("  ")
        line = str_concat(line, d.short_name)
        line = str_concat(line, str_new(", "))
        line = str_concat(line, d.long_name)
        line = str_concat(line, str_new("    "))
        line = str_concat(line, d.help_text)
        if d.required
            line = str_concat(line, str_new(" (required)"))
        end
        println(line)
        i = i + 1
    end
    
    println(str_new("  -h, --help       Show this help"))
    println(str_new("  --version        Show version"))
end

# ─── Internal ─────────────────────────────────────────

func _find_def(p: ArgParser, name: String) -> Option<ArgDef>
    var i: usize = 0
    lặp_khi i < vec_len<ArgDef>(p.defs)
        var d = vec_get<ArgDef>(p.defs, i)
        if str_eq(d.long_name, name) or str_eq(d.short_name, name)
            out Some(d)
        end
        i = i + 1
    end
    out None
end

func _add_result(p: &ArgParser, name: String, val: String)
    # Tìm existing result or tạo mới
    var i: usize = 0
    lặp_khi i < vec_len<ArgResult>(p.results)
        var r = vec_get<ArgResult>(p.results, i)
        if str_eq(r.name, name)
            vec_push<String>(&r.values, val)
            vec_set<ArgResult>(&p.results, i, r)
            out
        end
        i = i + 1
    end
    var v = vec_new<String>()
    vec_push<String>(&v, val)
    vec_push<ArgResult>(&p.results, ArgResult { name = name, values = v })
end

func _check_required(p: &ArgParser)
    var i: usize = 0
    lặp_khi i < vec_len<ArgDef>(p.defs)
        var d = vec_get<ArgDef>(p.defs, i)
        if d.required and !argparser_has(*p, d.long_name)
            vec_push<String>(&p.errors,
                str_concat(str_new("Missing required: "), d.long_name))
        end
        i = i + 1
    end
end

func _apply_defaults(p: &ArgParser)
    var i: usize = 0
    lặp_khi i < vec_len<ArgDef>(p.defs)
        var d = vec_get<ArgDef>(p.defs, i)
        if !argparser_has(*p, d.long_name)
            chọn d.default_val
                case Some(v)
                    _add_result(p, d.long_name, v)
                case None {}
            end
        end
        i = i + 1
    end
end
