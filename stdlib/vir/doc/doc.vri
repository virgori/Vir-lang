/*
 * vir/doc/doc.vri — Documentation Generator
 * ============================================
 * Phase D — extract doc-comments, generate HTML/Markdown
 *
 * Inspired by: rustdoc, pydoc, Sphinx
 */

import "vir/core/types" use all
import "vir/core/option" use Option, Some, None
import "vir/str/string" use String, str_new, str_concat, str_starts_with, str_slice_bytes, str_byte_len, str_trim
import "vir/str/builder" use StringBuilder, sb_new, sb_append, sb_build
import "vir/collections/vec" use Vec, vec_new, vec_push, vec_len, vec_get
import "vir/ast/ast" use Module, Item, FnDef, StructDef, EnumDef, Param, FieldDef, VariantDef

# ═══════════════════════════════════════════════════════
# Doc Items
# ═══════════════════════════════════════════════════════

entity DocItem
    name:        String
    kind:        String     # "function", "struct", "enum", "const"
    summary:     String     # first line of doc
    description: String     # full doc
    params:      Vec<DocParam>
    returns:     String
    examples:    Vec<String>
    module_path: String
end

entity DocParam
    name:        String
    type_str:    String
    description: String
end

entity DocModule
    name:  String
    path:  String
    items: Vec<DocItem>
end

# ═══════════════════════════════════════════════════════
# Extract docs from source
# ═══════════════════════════════════════════════════════

func extract_docs(source: String, module_path: String) -> Vec<DocItem>
    var items = vec_new<DocItem>()
    var lines = str_split(source, str_new("\n"))
    var i: usize = 0
    var doc_buf = vec_new<String>()
    
    lặp_khi i < vec_len<String>(lines)
        var line = str_trim(vec_get<String>(lines, i))
        
        # Doc comments: ## or ///
        if str_starts_with(line, str_new("##"))
            var comment = str_trim(str_slice_bytes(line, 2, str_byte_len(line)))
            vec_push<String>(&doc_buf, comment)
        eif str_starts_with(line, str_new("///"))
            var comment = str_trim(str_slice_bytes(line, 3, str_byte_len(line)))
            vec_push<String>(&doc_buf, comment)
        else
            # Non-doc line — check if it's a declaration
            if vec_len<String>(doc_buf) > 0
                if str_starts_with(line, str_new("func ")) or str_starts_with(line, str_new("fn "))
                    var item = _make_doc_item(str_new("function"), line, doc_buf, module_path)
                    vec_push<DocItem>(&items, item)
                eif str_starts_with(line, str_new("entity ")) or str_starts_with(line, str_new("struct "))
                    var item = _make_doc_item(str_new("struct"), line, doc_buf, module_path)
                    vec_push<DocItem>(&items, item)
                eif str_starts_with(line, str_new("enum ")) or str_starts_with(line, str_new("enum "))
                    var item = _make_doc_item(str_new("enum"), line, doc_buf, module_path)
                    vec_push<DocItem>(&items, item)
                end
                doc_buf = vec_new<String>()
            end
        end
        i = i + 1
    end
    
    out items
end

func _make_doc_item(kind: String, decl_line: String, doc_lines: Vec<String>, mod_path: String) -> DocItem
    var name = _extract_name(decl_line)
    var summary = if vec_len<String>(doc_lines) > 0 vec_get<String>(doc_lines, 0) else str_new("") end
    
    var desc_sb = sb_new()
    var i: usize = 0
    lặp_khi i < vec_len<String>(doc_lines)
        sb_append(&desc_sb, vec_get<String>(doc_lines, i))
        sb_append(&desc_sb, str_new("\n"))
        i = i + 1
    end
    
    out DocItem {
        name = name, kind = kind,
        summary = summary, description = sb_build(desc_sb),
        params = vec_new<DocParam>(),
        returns = str_new(""),
        examples = vec_new<String>(),
        module_path = mod_path
    }
end

func _extract_name(line: String) -> String
    # Find first identifier after keyword
    var i: usize = 0
    var len = str_byte_len(line)
    # Skip keyword
    lặp_khi i < len and str_byte_at(line, i) != 0x20 i = i + 1 end
    # Skip space
    lặp_khi i < len and str_byte_at(line, i) == 0x20 i = i + 1 end
    # Read name
    var start = i
    lặp_khi i < len
        var ch = str_byte_at(line, i)
        if !(is_alnum(ch) or ch == 0x5F or ch >= 0x80) thoát end
        i = i + 1
    end
    out str_slice_bytes(line, start, i)
end

# ═══════════════════════════════════════════════════════
# Generate Markdown
# ═══════════════════════════════════════════════════════

func generate_markdown(docs: Vec<DocItem>) -> String
    var sb = sb_new()
    
    var i: usize = 0
    lặp_khi i < vec_len<DocItem>(docs)
        var item = vec_get<DocItem>(docs, i)
        
        sb_append(&sb, str_new("## "))
        sb_append(&sb, item.name)
        sb_append(&sb, str_new("\n\n"))
        
        sb_append(&sb, str_new("**Kind:** "))
        sb_append(&sb, item.kind)
        sb_append(&sb, str_new("  \n"))
        sb_append(&sb, str_new("**Module:** "))
        sb_append(&sb, item.module_path)
        sb_append(&sb, str_new("\n\n"))
        
        sb_append(&sb, item.description)
        sb_append(&sb, str_new("\n---\n\n"))
        
        i = i + 1
    end
    
    out sb_build(sb)
end

# ═══════════════════════════════════════════════════════
# Generate HTML (minimal)
# ═══════════════════════════════════════════════════════

func generate_html(docs: Vec<DocItem>, title: String) -> String
    var sb = sb_new()
    sb_append(&sb, str_new("<!DOCTYPE html><html><head><meta charset=\"utf-8\"><title>"))
    sb_append(&sb, title)
    sb_append(&sb, str_new("</title><style>body{font-family:sans-serif;max-width:800px;margin:auto;padding:20px}"))
    sb_append(&sb, str_new(".item{margin-bottom:2em;border-bottom:1px solid #ccc;padding-bottom:1em}"))
    sb_append(&sb, str_new(".kind{color:#666;font-size:0.9em}</style></head><body>"))
    sb_append(&sb, str_new("<h1>"))
    sb_append(&sb, title)
    sb_append(&sb, str_new("</h1>"))
    
    var i: usize = 0
    lặp_khi i < vec_len<DocItem>(docs)
        var item = vec_get<DocItem>(docs, i)
        sb_append(&sb, str_new("<div class=\"item\"><h2>"))
        sb_append(&sb, item.name)
        sb_append(&sb, str_new("</h2><p class=\"kind\">"))
        sb_append(&sb, item.kind)
        sb_append(&sb, str_new(" — "))
        sb_append(&sb, item.module_path)
        sb_append(&sb, str_new("</p><p>"))
        sb_append(&sb, item.description)
        sb_append(&sb, str_new("</p></div>"))
        i = i + 1
    end
    
    sb_append(&sb, str_new("</body></html>"))
    out sb_build(sb)
end
