##
 * vir/doc/doc.vri — Documentation Generator
 * ============================================
 * Phase D — extract doc-comments, generate HTML/Markdown
 *
 * Inspired by: rustdoc, pydoc, Sphinx
 ##

include types;
include option;
import Option, Some, None from option;
include string;
import String, str_new, str_concat, str_starts_with, str_slice_bytes, str_byte_len, str_trim from string;
include builder;
import StringBuilder, sb_new, sb_append, sb_build from builder;
include vec;
import Vec, vec_new, vec_push, vec_len, vec_get from vec;
include ast;
import Module, Item, FnDef, StructDef, EnumDef, Param, FieldDef, VariantDef from ast;

# ═══════════════════════════════════════════════════════
# Doc Items
# ═══════════════════════════════════════════════════════

entity DocItem:
    name:        string,
        kind:        string     # "function", "struct", "enum", "const",
        summary:     string     # first line of doc,
        description: string     # full doc,
        params:      Vec<DocParam>,
        returns:     string,
        examples:    Vec<string>,
        module_path: string;
end.

entity DocParam:
    name:        string,
        type_str:    string,
        description: string;
end.

entity DocModule:
    name:  string,
        path:  string,
        items: Vec<DocItem>;
end

# ═══════════════════════════════════════════════════════
# Extract docs from source
# ═══════════════════════════════════════════════════════

func extract_docs:
    in(source:string; module_path:string)
    items = vec_new<DocItem>();
    lines = str_split(source, str_new("\n"));
    i = 0;
    doc_buf = vec_new<string>();
    
    when i < vec_len<String>(lines) loop
        line = str_trim(vec_get<string>(lines, i));
        
        # Doc comments: ## or ///
        if str_starts_with(line, str_new(" do ##")) do
            comment = str_trim(str_slice_bytes(line, 2, str_byte_len(line)));
            vec_push<string>(&doc_buf, comment);
        eif str_starts_with(line, str_new("///")) do
            comment = str_trim(str_slice_bytes(line, 3, str_byte_len(line)));
            vec_push<string>(&doc_buf, comment);
        else
            # Non-doc line — check if it's a declaration
            if vec_len<String>(doc_buf) > 0 do
                if str_starts_with(line, str_new("func ")) or str_starts_with(line, str_new("fn ")) do
                    item = _make_doc_item(str_new("function"), line, doc_buf, module_path);
                    vec_push<DocItem>(&items, item);
                eif str_starts_with(line, str_new("entity ")) or str_starts_with(line, str_new("struct ")) do
                    item = _make_doc_item(str_new("struct"), line, doc_buf, module_path);
                    vec_push<DocItem>(&items, item);
                eif str_starts_with(line, str_new("enum ")) or str_starts_with(line, str_new("enum ")) do
                    item = _make_doc_item(str_new("enum"), line, doc_buf, module_path);
                    vec_push<DocItem>(&items, item);
                end
                doc_buf = vec_new<string>();
            end
        end
        i = i + 1;
    end
    
    out items;
end.

func _make_doc_item:
    in(kind:string; decl_line:string; doc_lines:Vec<string>; mod_path:string)
    name = _extract_name(decl_line);
    summary = if vec_len<string>(doc_lines) > 0 vec_get<string>(doc_lines, 0) else str_new("") end;
    
    desc_sb = sb_new();
    i = 0;
    when i < vec_len<String>(doc_lines) loop
        sb_append(&desc_sb, vec_get<string>(doc_lines, i));
        sb_append(&desc_sb, str_new("\n"));
        i = i + 1;
    end
    
    out DocItem {;
        name = name, kind = kind,
        summary = summary, description = sb_build(desc_sb),
        params = vec_new<DocParam>(),
        returns = str_new(""),
        examples = vec_new<string>(),
        module_path = mod_path
    };
end.

func _extract_name:
    in(line:string)
    # Find first identifier after keyword
    i = 0;
    len = str_byte_len(line);
    # Skip keyword
    when i < len and str_byte_at(line, i) != 0x20 i = i + 1 end loop
    # Skip space
    when i < len and str_byte_at(line, i) == 0x20 i = i + 1 end loop
    # Read name
    start = i;
    when i < len loop
        ch = str_byte_at(line, i);
        if !( do is_alnum(ch) or ch == 0x5F or ch >= 0x80) break end
        i = i + 1;
    end
    out str_slice_bytes(line, start, i);
end

# ═══════════════════════════════════════════════════════
# Generate Markdown
# ═══════════════════════════════════════════════════════

func generate_markdown:
    in(docs:Vec<DocItem>)
    sb = sb_new();
    
    i = 0;
    when i < vec_len<DocItem>(docs) loop
        item = vec_get<DocItem>(docs, i);
        
        sb_append(&sb, str_new("## "));
        sb_append(&sb, item.name);
        sb_append(&sb, str_new("\n\n"));
        
        sb_append(&sb, str_new("**Kind:** "));
        sb_append(&sb, item.kind);
        sb_append(&sb, str_new("  \n"));
        sb_append(&sb, str_new("**Module:** "));
        sb_append(&sb, item.module_path);
        sb_append(&sb, str_new("\n\n"));
        
        sb_append(&sb, item.description);
        sb_append(&sb, str_new("\n---\n\n"));
        
        i = i + 1;
    end
    
    out sb_build(sb);
end

# ═══════════════════════════════════════════════════════
# Generate HTML (minimal)
# ═══════════════════════════════════════════════════════

func generate_html:
    in(docs:Vec<DocItem>; title:string)
    sb = sb_new();
    sb_append(&sb, str_new("<!DOCTYPE html><html><head><meta charset=\"utf-8\"><title>"));
    sb_append(&sb, title);
    sb_append(&sb, str_new("</title><style>body{font-family:sans-serif;max-width:800px;margin:auto;padding:20px}"));
    sb_append(&sb, str_new(".item{margin-bottom:2em;border-bottom:1px solid #ccc;padding-bottom:1em}"));
    sb_append(&sb, str_new(".kind{color:#666;font-size:0.9em}</style></head><body>"));
    sb_append(&sb, str_new("<h1>"));
    sb_append(&sb, title);
    sb_append(&sb, str_new("</h1>"));
    
    i = 0;
    when i < vec_len<DocItem>(docs) loop
        item = vec_get<DocItem>(docs, i);
        sb_append(&sb, str_new("<div class=\"item\"><h2>"));
        sb_append(&sb, item.name);
        sb_append(&sb, str_new("</h2><p class=\"kind\">"));
        sb_append(&sb, item.kind);
        sb_append(&sb, str_new(" — "));
        sb_append(&sb, item.module_path);
        sb_append(&sb, str_new("</p><p>"));
        sb_append(&sb, item.description);
        sb_append(&sb, str_new("</p></div>"));
        i = i + 1;
    end
    
    sb_append(&sb, str_new("</body></html>"));
    out sb_build(sb);
end
