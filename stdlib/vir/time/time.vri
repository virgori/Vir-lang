##
 * vir/time/time.vri — Public surface: time.* only (see stdlib/registry/time.md)
 * Monotonic stamps are int (ns). Durations are entity Duration { secs, nanos }.
 * Scalar clock reads + single `out` per constructor — safe scope exit.
 ##

include types
include alloc
import vir_alloc, vir_free from alloc
include string_rt
import native_read_i64, native_write_i64 from string_rt
include syscall
import sys_platform, Platform from syscall
include result
import Result, Ok, Err from result

extern func clock_gettime(clk: int, ts: int) -> int
extern func nanosleep(req: int, rem: int) -> int

const NS_PER_SEC: int = 1000000000
const NS_PER_MS: int = 1000000
const NS_PER_US: int = 1000

const TIME_ERR_INVALID: int = 1

func time_monotonic_id() -> int:
    let plat = sys_platform()
    if plat == Platform.MacOS_ARM64 || plat == Platform.MacOS_x86_64 do
        out 6
    end
    out 1
end.

func time_realtime_id() -> int:
    out 0
end.

func mono_ns() -> int:
    let buf = vir_alloc(16)
    let rc = clock_gettime(time_monotonic_id(), buf)
    if rc != 0 do
        vir_free(buf)
        out 0
    end
    let sec = native_read_i64(buf, 0)
    let nsec = native_read_i64(buf, 8)
    vir_free(buf)
    out sec * NS_PER_SEC + nsec
end.

func wall_ns() -> int:
    let buf = vir_alloc(16)
    let rc = clock_gettime(time_realtime_id(), buf)
    if rc != 0 do
        vir_free(buf)
        out 0
    end
    let sec = native_read_i64(buf, 0)
    let nsec = native_read_i64(buf, 8)
    vir_free(buf)
    out sec * NS_PER_SEC + nsec
end.

entity Duration:
    secs: int
    nanos: int
end.

func _duration_zero() -> Duration:
    out Duration(secs: 0, nanos: 0)
end.

func _duration_from_secs(s: int) -> Duration:
    out Duration(secs: s, nanos: 0)
end.

func _duration_from_millis(ms: int) -> Duration:
    let s = ms / 1000
    let n = to_u32((ms mod 1000) * NS_PER_MS)
    out Duration(secs: s, nanos: n)
end.

func _duration_from_micros(us: int) -> Duration:
    let s = us / 1000000
    let n = to_u32((us mod 1000000) * NS_PER_US)
    out Duration(secs: s, nanos: n)
end.

func _duration_from_nanos(ns: int) -> Duration:
    let s = ns / NS_PER_SEC
    let n = to_u32(ns mod NS_PER_SEC)
    out Duration(secs: s, nanos: n)
end.

func _duration_to_secs(d: Duration) -> int:
    out d.secs
end.

func _duration_to_millis(d: Duration) -> int:
    out d.secs * 1000 + d.nanos / NS_PER_MS
end.

func _duration_to_micros(d: Duration) -> int:
    out d.secs * 1000000 + d.nanos / NS_PER_US
end.

func _duration_to_nanos(d: Duration) -> int:
    out d.secs * NS_PER_SEC + d.nanos
end.

func _duration_add(a: Duration, b: Duration) -> Duration:
    let total = _duration_to_nanos(a) + _duration_to_nanos(b)
    out _duration_from_nanos(total)
end.

func _duration_sub(a: Duration, b: Duration) -> Duration:
    let total_a = _duration_to_nanos(a)
    let total_b = _duration_to_nanos(b)
    if total_b > total_a do
        out _duration_zero()
    end
    out _duration_from_nanos(total_a - total_b)
end.

func _duration_is_zero(d: Duration) -> bool:
    out d.secs == 0 and d.nanos == 0
end.

func _elapsed_ns(start: int) -> int:
    let b = mono_ns()
    if b < start do
        out 0
    end
    out b - start
end.

func _since_ns(start: int, stop: int) -> int:
    if stop < start do
        out 0
    end
    out stop - start
end.

func _sleep_ns(ns: int) -> Result:
    if ns < 0 do
        out Err(TIME_ERR_INVALID)
    end
    if ns == 0 do
        out Ok(0)
    end
    let req = vir_alloc(16)
    native_write_i64(req, 0, ns / NS_PER_SEC)
    native_write_i64(req, 8, ns mod NS_PER_SEC)
    let rc = nanosleep(req, 0)
    vir_free(req)
    if rc != 0 do
        out Err(rc)
    end
    out Ok(0)
end.

entity Timer:
    start: int
    label: string
end.

func _timer_elapsed_ns(t: Timer) -> int:
    out _elapsed_ns(t.start)
end.

entity TimeNamespace:
    method now() -> int:
        out mono_ns()
    end.

    method elapsed(start: int) -> Duration:
        out _duration_from_nanos(_elapsed_ns(start))
    end.

    method elapsedMs(start: int) -> int:
        out _elapsed_ns(start) / NS_PER_MS
    end.

    method elapsedNs(start: int) -> int:
        out _elapsed_ns(start)
    end.

    method since(start: int, stop: int) -> Duration:
        out _duration_from_nanos(_since_ns(start, stop))
    end.

    method unixSecs() -> int:
        out wall_ns() / NS_PER_SEC
    end.

    method unixMs() -> int:
        out wall_ns() / NS_PER_MS
    end.

    method unixNs() -> int:
        out wall_ns()
    end.

    method sleep(duration: Duration) -> Result:
        out _sleep_ns(_duration_to_nanos(duration))
    end.

    method sleepMs(ms: int) -> Result:
        if ms < 0 do
            out Err(TIME_ERR_INVALID)
        end
        out _sleep_ns(ms * NS_PER_MS)
    end.

    method sleepSecs(secs: int) -> Result:
        if secs < 0 do
            out Err(TIME_ERR_INVALID)
        end
        out _sleep_ns(secs * NS_PER_SEC)
    end.

    method zero() -> Duration:
        out _duration_zero()
    end.

    method fromSecs(secs: int) -> Duration:
        out _duration_from_secs(secs)
    end.

    method fromMs(ms: int) -> Duration:
        out _duration_from_millis(ms)
    end.

    method fromUs(us: int) -> Duration:
        out _duration_from_micros(us)
    end.

    method fromNs(ns: int) -> Duration:
        out _duration_from_nanos(ns)
    end.

    method toSecs(duration: Duration) -> int:
        out _duration_to_secs(duration)
    end.

    method toMs(duration: Duration) -> int:
        out _duration_to_millis(duration)
    end.

    method toUs(duration: Duration) -> int:
        out _duration_to_micros(duration)
    end.

    method toNs(duration: Duration) -> int:
        out _duration_to_nanos(duration)
    end.

    method add(a: Duration, b: Duration) -> Duration:
        out _duration_add(a, b)
    end.

    method sub(a: Duration, b: Duration) -> Duration:
        out _duration_sub(a, b)
    end.

    method isZero(duration: Duration) -> bool:
        out _duration_is_zero(duration)
    end.

    method timer(label: string) -> Timer:
        out Timer(start: mono_ns(), label: label)
    end.

    method timerElapsed(timer: Timer) -> Duration:
        out _duration_from_nanos(_timer_elapsed_ns(timer))
    end.

    method timerMs(timer: Timer) -> int:
        out _timer_elapsed_ns(timer) / NS_PER_MS
    end.

    method timerNs(timer: Timer) -> int:
        out _timer_elapsed_ns(timer)
    end.

    method timerStop(timer: Timer) -> Result:
        out Ok(0)
    end.
end.

var time: TimeNamespace

export Duration, Timer, TimeNamespace, time
