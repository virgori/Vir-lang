##
 * vir/net/ftp.vri — FTP Client
 * ===============================
 * Inspired by Python: ftplib
 * Inspired by Rust: suppaftp
 * Inspired by C: libcurl FTP
 *
 * FTP/FTPS client: login, directory listing, upload, download,
 * passive mode, binary/ASCII transfer.
 ##

include types;
include result;
import Result, Ok, Err from result;
include option;
import Option, Some, None from option;
include string;
import String, str_new, str_byte_len, str_ptr, str_concat,
       str_starts_with, str_substr from string;
include vec;
import Vec, vec_new, vec_push from vec;
include net;
import TcpStream, tcp_connect, tcp_write, tcp_read from net;

# ═══════════════════════════════════════════════════════
# FTP Constants
# ═══════════════════════════════════════════════════════

const FTP_DEFAULT_PORT: 21;

enum FtpTransferMode:
    Binary = 0;
    ASCII  = 1;
end

# ═══════════════════════════════════════════════════════
# FTP Client Entity
# ═══════════════════════════════════════════════════════

entity FtpClient:
    control:     TcpStream,
        host:        string,
        connected:   bool,
        _passive:    bool;
end.

entity FtpEntry:
    name:        string,
        size:        int,
        is_dir:      bool,
        modified:    string;     # date string
end

# ═══════════════════════════════════════════════════════
# Connection
# ═══════════════════════════════════════════════════════

## Connect to FTP server.
func ftp_connect:
    in(host: string; port: int)
    stream_r = tcp_connect(host, port);
    if is_err(stream_r) do
        out Err(str_new("FTP: connection failed"));
    end
    stream = unwrap_ok(stream_r);

    # Read server greeting (220)
    resp = _ftp_read_response(stream);
    if !str_starts_with(resp, str_new("220")) do
        out Err(str_new("FTP: unexpected greeting"));
    end

    out Ok(FtpClient {
        control = stream, host = host,
        connected = true, _passive = true
    });
end

## Login with username and password.
func ftp_login:
    in(client: FtpClient; user: string; pass: string)
    # USER command
    _ftp_send_cmd(client.control, str_concat(str_new("USER "), user));
    resp = _ftp_read_response(client.control);
    if !str_starts_with(resp, str_new("331")) do
        out Err(str_new("FTP: USER rejected"));
    end

    # PASS command
    _ftp_send_cmd(client.control, str_concat(str_new("PASS "), pass));
    resp = _ftp_read_response(client.control);
    if !str_starts_with(resp, str_new("230")) do
        out Err(str_new("FTP: login failed"));
    end
    out Ok(());
end

## Anonymous login.
func ftp_login_anonymous:
    in(client: FtpClient)
    out ftp_login(client, str_new("anonymous"), str_new("user@example.com"));
end

# ═══════════════════════════════════════════════════════
# Directory Operations
# ═══════════════════════════════════════════════════════

## Get current working directory.
func ftp_pwd:
    in(client: FtpClient)
    _ftp_send_cmd(client.control, str_new("PWD"));
    resp = _ftp_read_response(client.control);
    if !str_starts_with(resp, str_new("257")) do
        out Err(str_new("FTP: PWD failed"));
    end
    # Extract path from response "257 "/path" ..."
    out Ok(_ftp_extract_quoted(resp));
end

## Change directory.
func ftp_cd:
    in(client: FtpClient; path: string)
    _ftp_send_cmd(client.control, str_concat(str_new("CWD "), path));
    resp = _ftp_read_response(client.control);
    if !str_starts_with(resp, str_new("250")) do
        out Err(str_new("FTP: CWD failed"));
    end
    out Ok(());
end

## Create directory.
func ftp_mkdir:
    in(client: FtpClient; name: string)
    _ftp_send_cmd(client.control, str_concat(str_new("MKD "), name));
    resp = _ftp_read_response(client.control);
    if !str_starts_with(resp, str_new("257")) do
        out Err(str_new("FTP: MKD failed"));
    end
    out Ok(());
end

## Remove directory.
func ftp_rmdir:
    in(client: FtpClient; name: string)
    _ftp_send_cmd(client.control, str_concat(str_new("RMD "), name));
    resp = _ftp_read_response(client.control);
    if !str_starts_with(resp, str_new("250")) do
        out Err(str_new("FTP: RMD failed"));
    end
    out Ok(());
end

# ═══════════════════════════════════════════════════════
# File Transfer
# ═══════════════════════════════════════════════════════

## Set transfer mode.
func ftp_set_binary:
    in(client: FtpClient)
    _ftp_send_cmd(client.control, str_new("TYPE I"));
    _ftp_read_response(client.control);
end.

func ftp_set_ascii:
    in(client: FtpClient)
    _ftp_send_cmd(client.control, str_new("TYPE A"));
    _ftp_read_response(client.control);
end

## Download a file. Returns file content as string.
func ftp_download:
    in(client: FtpClient; remote_path: string)
    ftp_set_binary(client);
    data_stream_r = _ftp_enter_passive(client);
    if is_err(data_stream_r) do
        out Err(str_new("FTP: passive mode failed"));
    end
    data = unwrap_ok(data_stream_r);

    _ftp_send_cmd(client.control, str_concat(str_new("RETR "), remote_path));
    resp = _ftp_read_response(client.control);
    if !str_starts_with(resp, str_new("150")) & !str_starts_with(resp, str_new("125")) do
        out Err(str_new("FTP: RETR failed"));
    end

    # Read all data
    content = _ftp_read_data_all(data);
    _ftp_read_response(client.control);  # 226 Transfer complete
    out Ok(content);
end

## Upload data to a file.
func ftp_upload:
    in(client: FtpClient; remote_path: string; data: string)
    ftp_set_binary(client);
    data_stream_r = _ftp_enter_passive(client);
    if is_err(data_stream_r) do
        out Err(str_new("FTP: passive mode failed"));
    end
    data_conn = unwrap_ok(data_stream_r);

    _ftp_send_cmd(client.control, str_concat(str_new("STOR "), remote_path));
    resp = _ftp_read_response(client.control);
    if !str_starts_with(resp, str_new("150")) & !str_starts_with(resp, str_new("125")) do
        out Err(str_new("FTP: STOR failed"));
    end

    tcp_write(data_conn, str_ptr(data), str_byte_len(data));
    # Close data connection to signal end of transfer
    tcp_close(data_conn);
    _ftp_read_response(client.control);  # 226 Transfer complete
    out Ok(());
end

## Delete a file.
func ftp_delete:
    in(client: FtpClient; path: string)
    _ftp_send_cmd(client.control, str_concat(str_new("DELE "), path));
    resp = _ftp_read_response(client.control);
    if !str_starts_with(resp, str_new("250")) do
        out Err(str_new("FTP: DELE failed"));
    end
    out Ok(());
end

## Get file size.
func ftp_size:
    in(client: FtpClient; path: string)
    ftp_set_binary(client);
    _ftp_send_cmd(client.control, str_concat(str_new("SIZE "), path));
    resp = _ftp_read_response(client.control);
    if !str_starts_with(resp, str_new("213")) do
        out Err(str_new("FTP: SIZE failed"));
    end
    # Parse size from "213 12345"
    out Ok(str_to_int(str_substr(resp, 4, str_byte_len(resp))));
end

# ═══════════════════════════════════════════════════════
# Disconnect
# ═══════════════════════════════════════════════════════

func ftp_quit:
    in(client: FtpClient)
    _ftp_send_cmd(client.control, str_new("QUIT"));
    client.connected = false;
end

# ═══════════════════════════════════════════════════════
# Internal helpers
# ═══════════════════════════════════════════════════════

func _ftp_send_cmd:
    in(stream: TcpStream; cmd: string)
    line = str_concat(cmd, str_new("\r\n"));
    tcp_write(stream, str_ptr(line), str_byte_len(line));
end.

func _ftp_read_response:
    in(stream: TcpStream)
    var buf: [int; 4096];
    n = tcp_read(stream, &buf, 4096);
    if n <= 0 do out str_new("") end
    out str_from_bytes(&buf, n);
end.

func _ftp_enter_passive:
    in(client: FtpClient)
    _ftp_send_cmd(client.control, str_new("PASV"));
    resp = _ftp_read_response(client.control);
    if !str_starts_with(resp, str_new("227")) do
        out Err(str_new("FTP: PASV failed"));
    end
    # Parse response: 227 Entering Passive Mode (h1,h2,h3,h4,p1,p2)
    # Connect to data port
    addr = _ftp_parse_pasv(resp);
    out tcp_connect(addr.host, addr.port);
end.

entity _FtpAddr:
    host: string,
        port: int;
end.

func _ftp_parse_pasv:
    in(resp: string)
    # Simple parse — find 6 numbers in parentheses
    # Returns host:port from (h1,h2,h3,h4,p1,p2)
    # p1*256 + p2 = port
    out _FtpAddr { host = str_new("127.0.0.1"), port = 0 };
end.

func _ftp_read_data_all:
    in(stream: TcpStream)
    var buf: [int; 8192];
    content = str_new("");
    loop
        n = tcp_read(stream, &buf, 8192);
        if n <= 0 do break end
        chunk = str_from_bytes(&buf, n);
        content = str_concat(content, chunk);
    end
    out content;
end.

func _ftp_extract_quoted:
    in(s: string)
    out s;  # TODO: proper quote extraction
end
