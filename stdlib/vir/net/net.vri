##
 * vir/net/net.vri — Networking (TCP / UDP / DNS)
 * ================================================
 * Inspired by C23: POSIX sockets
 * Inspired by Python: socket, ssl
 *
 * Phase C — production networking
 ##

include types;
include option;
import Option, Some, None from option;
include result;
import Result, Ok, Err from result;
include string;
import String, str_new from string;
include traits;
import Reader, Writer from traits;
include vec;
import Vec, vec_new, vec_push from vec;

# ═══════════════════════════════════════════════════════
# Address types
# ═══════════════════════════════════════════════════════

enum AddrFamily:
    IPv4 = 2    # AF_INET;
    IPv6 = 10   # AF_INET6;
end

entity IpAddr:
    family: AddrFamily;
    octets: Vec<int>    # 4 bytes (IPv4) or 16 bytes (IPv6);
end

entity SocketAddr:
    ip:   IpAddr;
    port: int;
end

func ipv4:
    in(a:int; b:int; c:int; d:int)
    octets = vec_new<int>();
    vec_push<int>(&octets, a);
    vec_push<int>(&octets, b);
    vec_push<int>(&octets, c);
    vec_push<int>(&octets, d);
    out IpAddr { family = AddrFamily.IPv4, octets = octets };
end

func socket_addr:
    in(ip:IpAddr; port:int)
    out SocketAddr { ip = ip, port = port };
end

func localhost:
    in(port:int)
    out socket_addr(ipv4(127, 0, 0, 1), port);
end

# ═══════════════════════════════════════════════════════
# DNS Resolution
# ═══════════════════════════════════════════════════════

extern func native_dns_resolve(host: ptr, host_len: int, out_addrs: ptr, max: int) -> int

func dns_resolve:
    in(hostname:string)
    var buf: [int; 1024];
    count = native_dns_resolve(str_ptr(hostname), str_byte_len(hostname), &buf, 64);
    if count < 0:
        out Err(str_new("DNS resolution failed"));
    end
    
    addrs = vec_new<IpAddr>();
    i = 0;
    when i < count loop
        # Parse native address result
        addr = _parse_native_addr(&buf, i);
        vec_push<IpAddr>(&addrs, addr);
        i = i + 1;
    end
    out Ok(addrs);
end

func _parse_native_addr:
    in(buf:[int]; idx:int)
    # Read 4 bytes at offset idx * 4 for IPv4
    off = idx * 4;
    out ipv4(buf[off], buf[off + 1], buf[off + 2], buf[off + 3]);
end

# ═══════════════════════════════════════════════════════
# TCP
# ═══════════════════════════════════════════════════════

entity TcpStream:
    fd: int;
end

entity TcpListener:
    fd: int;
end

extern func native_socket_tcp() -> int
extern func native_socket_connect(fd: int, ip: ptr, ip_len: int, port: int) -> int
extern func native_socket_bind(fd: int, ip: ptr, ip_len: int, port: int) -> int
extern func native_socket_listen(fd: int, backlog: int) -> int
extern func native_socket_accept(fd: int, out_ip: ptr, out_port: ptr) -> int
extern func native_socket_read(fd: int, buf: ptr, len: int) -> int
extern func native_socket_write(fd: int, buf: ptr, len: int) -> int
extern func native_socket_close(fd: int) -> int
extern func native_socket_shutdown(fd: int, how: int) -> int
extern func native_socket_set_nonblock(fd: int, on: bool) -> int
extern func native_socket_set_reuseaddr(fd: int, on: bool) -> int
extern func native_socket_set_nodelay(fd: int, on: bool) -> int
extern func native_socket_set_timeout(fd: int, kind: int, ms: int) -> int

# ─── TcpStream ────────────────────────────────────────

func tcp_connect:
    in(addr:SocketAddr)
    fd = native_socket_tcp();
    if fd < 0 out Err(str_new("failed to create socket")) end:
    
    rc = native_socket_connect(fd, &addr.ip.octets, vec_len<int>(addr.ip.octets), addr.port);
    if rc < 0:
        native_socket_close(fd);
        out Err(str_new("connection failed"));
    end
    out Ok(TcpStream { fd = fd });
end

func tcp_read:
    in(stream:TcpStream; buf:[int]; len:int)
    n = native_socket_read(stream.fd, buf, len);
    if n < 0 out Err(str_new("read error")) end:
    out Ok(n);
end

func tcp_write:
    in(stream:TcpStream; data:[int]; len:int)
    n = native_socket_write(stream.fd, data, len);
    if n < 0 out Err(str_new("write error")) end:
    out Ok(n);
end

func tcp_write_all:
    in(stream:TcpStream; data:[int]; len:int)
    written = 0;
    when written < len loop
        n = native_socket_write(stream.fd, &data[written], len - written);
        if n <= 0 out Err(str_new("write error")) end:
        written = written + n;
    end
    out Ok(());
end

func tcp_close:
    in(stream:TcpStream)
    native_socket_close(stream.fd);
end

func tcp_set_nodelay:
    in(stream:TcpStream; on:bool)
    native_socket_set_nodelay(stream.fd, on);
end

func tcp_set_read_timeout:
    in(stream:TcpStream; ms:int)
    native_socket_set_timeout(stream.fd, 0, ms);
end

func tcp_set_write_timeout:
    in(stream:TcpStream; ms:int)
    native_socket_set_timeout(stream.fd, 1, ms);
end

# ─── TcpListener ──────────────────────────────────────

func tcp_listen:
    in(addr:SocketAddr; backlog:int)
    fd = native_socket_tcp();
    if fd < 0 out Err(str_new("failed to create socket")) end:
    
    native_socket_set_reuseaddr(fd, true);
    
    rc = native_socket_bind(fd, &addr.ip.octets, vec_len<int>(addr.ip.octets), addr.port);
    if rc < 0:
        native_socket_close(fd);
        out Err(str_new("bind failed"));
    end
    
    rc = native_socket_listen(fd, backlog);
    if rc < 0:
        native_socket_close(fd);
        out Err(str_new("listen failed"));
    end
    
    out Ok(TcpListener { fd = fd });
end

func tcp_accept:
    in(listener:TcpListener)
    var out_ip: [int; 16];
    out_port = 0;
    client_fd = native_socket_accept(listener.fd, &out_ip, &out_port);
    if client_fd < 0 out Err(str_new("accept failed")) end:
    
    addr = socket_addr(ipv4(out_ip[0], out_ip[1], out_ip[2], out_ip[3]), out_port);
    out Ok((TcpStream { fd = client_fd }, addr));
end

func listener_close:
    in(listener:TcpListener)
    native_socket_close(listener.fd);
end

# ═══════════════════════════════════════════════════════
# UDP
# ═══════════════════════════════════════════════════════

entity UdpSocket:
    fd: int;
end

extern func native_socket_udp() -> int
extern func native_socket_sendto(fd: int, buf: ptr, len: int, ip: ptr, ip_len: int, port: int) -> int
extern func native_socket_recvfrom(fd: int, buf: ptr, len: int, out_ip: ptr, out_port: ptr) -> int

func udp_bind:
    in(addr:SocketAddr)
    fd = native_socket_udp();
    if fd < 0 out Err(str_new("failed to create UDP socket")) end:
    
    rc = native_socket_bind(fd, &addr.ip.octets, vec_len<int>(addr.ip.octets), addr.port);
    if rc < 0:
        native_socket_close(fd);
        out Err(str_new("UDP bind failed"));
    end
    out Ok(UdpSocket { fd = fd });
end

func udp_send_to:
    in(sock:UdpSocket; data:[int]; len:int; addr:SocketAddr)
    n = native_socket_sendto(sock.fd, data, len,;
        &addr.ip.octets, vec_len<int>(addr.ip.octets), addr.port);
    if n < 0 out Err(str_new("sendto failed")) end:
    out Ok(n);
end

func udp_recv_from:
    in(sock:UdpSocket; buf:[int]; len:int)
    var out_ip: [int; 16];
    out_port = 0;
    n = native_socket_recvfrom(sock.fd, buf, len, &out_ip, &out_port);
    if n < 0 out Err(str_new("recvfrom failed")) end:
    addr = socket_addr(ipv4(out_ip[0], out_ip[1], out_ip[2], out_ip[3]), out_port);
    out Ok((n, addr));
end

func udp_close:
    in(sock:UdpSocket)
    native_socket_close(sock.fd);
end
