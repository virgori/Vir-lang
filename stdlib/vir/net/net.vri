##
 * vir/net/net.vri — Networking (TCP / UDP / DNS)
 ##

include types
include result
import Result, Ok, Err from result
include string
import String, str_new, str_byte_len, str_from_bytes from string
include alloc
import vir_alloc from alloc
include syscall
import sys_socket, sys_connect, sys_bind, sys_listen, sys_accept, sys_read, sys_write, sys_close from syscall

const AF_INET: 2
const SOCK_STREAM: 1
const SOCK_DGRAM: 2

func _host_byte(hp: ptr, i: int, hlen: int) -> int:
    if i >= hlen do
        out 0
    end
    out native_read_u8(hp as int, i)
end.

func _host_is_localhost(hp: ptr, hlen: int) -> bool:
    if hlen != 9 do
        out false
    end
    out native_read_u8(hp as int, 0) == 108
        and native_read_u8(hp as int, 1) == 111
        and native_read_u8(hp as int, 2) == 99
        and native_read_u8(hp as int, 3) == 97
        and native_read_u8(hp as int, 4) == 108
        and native_read_u8(hp as int, 5) == 104
        and native_read_u8(hp as int, 6) == 111
        and native_read_u8(hp as int, 7) == 115
        and native_read_u8(hp as int, 8) == 116
end.

func _dns_write_ipv4(out_addrs: ptr, a: int, b: int, c: int, d: int):
    p = out_addrs as int
    native_write_u8(p, 0, a)
    native_write_u8(p, 1, b)
    native_write_u8(p, 2, c)
    native_write_u8(p, 3, d)
end.

func _host_parse_ipv4(hp: ptr, hlen: int, out_addrs: ptr) -> int:
    var parts = 0
    var cur = 0
    var b0 = 0
    var b1 = 0
    var b2 = 0
    var b3 = 0
    i = 0
    when i <= hlen loop
        ch = _host_byte(hp, i, hlen)
        if ch == 0 or ch == 46 or i == hlen do
            if cur > 255 do
                out 0
            end
            if parts == 0 do b0 = cur end
            if parts == 1 do b1 = cur end
            if parts == 2 do b2 = cur end
            if parts == 3 do b3 = cur end
            parts = parts + 1
            cur = 0
            if ch != 46 do
                break
            end
        else
            if ch < 48 or ch > 57 do
                out 0
            end
            cur = cur * 10 + (ch - 48)
        end
        i = i + 1
    end
    if parts != 4 do
        out 0
    end
    _dns_write_ipv4(out_addrs, b0, b1, b2, b3)
    out 1
end.

func native_dns_resolve(host: ptr, host_len: int, out_addrs: ptr, max: int) -> int:
    if max < 1 do
        out 0
    end
    if _host_is_localhost(host, host_len) do
        _dns_write_ipv4(out_addrs, 127, 0, 0, 1)
        out 1
    end
    out _host_parse_ipv4(host, host_len, out_addrs)
end.

func _sockaddr_in_pack(ip: ptr, ip_len: int, portNum: int) -> int:
    sa = vir_alloc(16)
    native_write_u8(sa, 0, 16)
    native_write_u8(sa, 1, AF_INET)
    native_write_u8(sa, 2, (portNum shr 8) bit_and 255)
    native_write_u8(sa, 3, portNum bit_and 255)
    if ip_len >= 4 do
        native_write_u8(sa, 4, native_read_u8(ip as int, 0))
        native_write_u8(sa, 5, native_read_u8(ip as int, 1))
        native_write_u8(sa, 6, native_read_u8(ip as int, 2))
        native_write_u8(sa, 7, native_read_u8(ip as int, 3))
    end
    out sa as int
end.

func native_socket_tcp() -> int:
    out sys_socket(AF_INET, SOCK_STREAM, 0)
end.

func native_socket_udp() -> int:
    out sys_socket(AF_INET, SOCK_DGRAM, 0)
end.

func native_socket_connect(fd: int, ip: ptr, ip_len: int, portNum: int) -> int:
    sa = _sockaddr_in_pack(ip, ip_len, portNum)
    out sys_connect(fd, sa, 16)
end.

func native_socket_bind(fd: int, ip: ptr, ip_len: int, portNum: int) -> int:
    sa = _sockaddr_in_pack(ip, ip_len, portNum)
    out sys_bind(fd, sa, 16)
end.

func native_socket_listen(fd: int, backlog: int) -> int:
    out sys_listen(fd, backlog)
end.

func native_socket_accept(fd: int, out_ip: ptr, out_peer_port: ptr) -> int:
    sa = vir_alloc(16)
    client = sys_accept(fd, sa as int, 16)
    if client < 0 do
        out client
    end
    if (out_ip as int) != 0 do
        native_write_u8(out_ip as int, 0, native_read_u8(sa, 4))
        native_write_u8(out_ip as int, 1, native_read_u8(sa, 5))
        native_write_u8(out_ip as int, 2, native_read_u8(sa, 6))
        native_write_u8(out_ip as int, 3, native_read_u8(sa, 7))
    end
    if (out_peer_port as int) != 0 do
        portNum = (native_read_u8(sa, 2) shl 8) bit_or native_read_u8(sa, 3)
        native_write_i64(out_peer_port as int, 0, portNum)
    end
    out client
end.

func native_socket_read(fd: int, buf: ptr, len: int) -> int:
    out sys_read(fd, buf as int, len)
end.

func native_socket_write(fd: int, buf: ptr, len: int) -> int:
    out sys_write(fd, buf as int, len)
end.

func native_socket_close(fd: int) -> int:
    sys_close(fd)
    out 0
end.

func native_socket_set_reuseaddr(fd: int, on: bool) -> int:
    out 0
end.

func native_socket_sendto(fd: int, buf: ptr, len: int, ip: ptr, ip_len: int, portNum: int) -> int:
    out 0
end.

func native_socket_recvfrom(fd: int, buf: ptr, len: int, out_ip: ptr, out_peer_port: ptr) -> int:
    out 0
end.

entity IpAddr:
    b0: int
    b1: int
    b2: int
    b3: int
end.

entity SocketAddr:
    ip: IpAddr
    portNum: int
end.

entity TcpStream:
    fd: int
end.

entity TcpListener:
    fd: int
end.

entity UdpSocket:
    fd: int
end.

func ipv4(a: int, b: int, c: int, d: int) -> IpAddr:
    out IpAddr ( b0: a, b1: b, b2: c, b3: d )
end.

func socket_addr(ip: IpAddr, listenPort: int) -> SocketAddr:
    out SocketAddr ( ip: ip, portNum: listenPort )
end.

func localhost(listenPort: int) -> SocketAddr:
    out socket_addr(ipv4(127, 0, 0, 1), listenPort)
end.

func _ptr_cstr_len(p: ptr) -> int:
    data = p as int
    if data == 0 do
        out 0
    end
    n = 0
    when native_read_u8(data, n) != 0 loop
        n = n + 1
    end
    out n
end.

func _ip_pack_ptr(ip: IpAddr):
    p = vir_alloc(4)
    native_write_u8(p, 0, ip.b0)
    native_write_u8(p, 1, ip.b1)
    native_write_u8(p, 2, ip.b2)
    native_write_u8(p, 3, ip.b3)
    out p
end.

func _ip_from_dns_ptr(p: int, idx: int) -> IpAddr:
    off = idx * 4
    out ipv4(
        native_read_u8(p, off),
        native_read_u8(p, off + 1),
        native_read_u8(p, off + 2),
        native_read_u8(p, off + 3)
    )
end.

func dns_resolve(hostname: string):
    out_buf = vir_alloc(256)
    hp = hostname as ptr
    count = native_dns_resolve(hp, _ptr_cstr_len(hp), out_buf as ptr, 64)
    if count < 1 do
        out Err(str_new("DNS resolution failed"))
    end
    out Ok(_ip_from_dns_ptr(out_buf as int, 0))
end.

func tcp_connect_addr(addr: SocketAddr):
    ip_ptr = _ip_pack_ptr(addr.ip)
    fd = native_socket_tcp()
    if fd < 0 do
        out Err(str_new("failed to create socket"))
    end
    rc = native_socket_connect(fd, ip_ptr as ptr, 4, addr.portNum)
    if rc < 0 do
        native_socket_close(fd)
        out Err(str_new("connection failed"))
    end
    out Ok(TcpStream ( fd: fd ))
end.

func tcp_connect(host: string, listenPort: int):
    case dns_resolve(host)
    Ok(ip):
        out tcp_connect_addr(socket_addr(ip, listenPort))
    Err(_):
        out Err(str_new("DNS resolution failed"))
    end
end.

func tcp_connect_host(hostname: string, listenPort: int):
    out tcp_connect(hostname, listenPort)
end.

func tcp_read:
    in
        stream: TcpStream
        buf: [int]
        max_len: int
    p = vir_alloc(max_len)
    n = native_socket_read(stream.fd, p as ptr, max_len)
    if n < 0 do
        out Err(str_new("read error"))
    end
    i = 0
    when i < n loop
        buf[i] = native_read_u8(p, i)
        i = i + 1
    end
    out Ok(n)
end.

func tcp_write:
    in
        stream: TcpStream
        data: [int]
        max_len: int
    p = vir_alloc(max_len)
    i = 0
    when i < max_len loop
        native_write_u8(p, i, data[i])
        i = i + 1
    end
    n = native_socket_write(stream.fd, p as ptr, max_len)
    if n < 0 do
        out Err(str_new("write error"))
    end
    out Ok(n)
end.

func tcp_write_string(stream: TcpStream, text: string):
    tp = text as ptr
    n = native_socket_write(stream.fd, tp, _ptr_cstr_len(tp))
    if n < 0 do
        out Err(str_new("write error"))
    end
    out Ok(n)
end.

func tcp_write_all_string(stream: TcpStream, text: string):
    base = text as ptr
    tlen = _ptr_cstr_len(base)
    written = 0
    when written < tlen loop
        off_ptr = (base as int + written) as ptr
        n = native_socket_write(stream.fd, off_ptr, tlen - written)
        if n <= 0 do
            out Err(str_new("write error"))
        end
        written = written + n
    end
    out Ok(())
end.

func tcp_read_all_string(stream: TcpStream):
    cap = 65536
    p = vir_alloc(cap)
    total = 0
    loop
        read_ptr = (p as int + total) as ptr
        n = native_socket_read(stream.fd, read_ptr, cap - total)
        if n <= 0 do
            break
        end
        total = total + n
        if total >= cap do
            break
        end
    end
    if total <= 0 do
        out Ok(str_new(""))
    end
    out Ok(str_from_bytes(p as ptr, total))
end.

func tcp_close(stream: TcpStream):
    native_socket_close(stream.fd)
end.

func tcp_listen(addr: SocketAddr, backlog: int):
    ip_ptr = _ip_pack_ptr(addr.ip)
    fd = native_socket_tcp()
    if fd < 0 do
        out Err(str_new("failed to create socket"))
    end
    native_socket_set_reuseaddr(fd, true)
    rc = native_socket_bind(fd, ip_ptr as ptr, 4, addr.portNum)
    if rc < 0 do
        native_socket_close(fd)
        out Err(str_new("bind failed"))
    end
    rc = native_socket_listen(fd, backlog)
    if rc < 0 do
        native_socket_close(fd)
        out Err(str_new("listen failed"))
    end
    out Ok(TcpListener ( fd: fd ))
end.

func tcp_accept(listener: TcpListener):
    out_ip = vir_alloc(16)
    out_port = vir_alloc(8)
    client_fd = native_socket_accept(listener.fd, out_ip as ptr, out_port as ptr)
    if client_fd < 0 do
        out Err(str_new("accept failed"))
    end
    peerPort = native_read_i64(out_port as int, 0)
    ip = ipv4(
        native_read_u8(out_ip as int, 0),
        native_read_u8(out_ip as int, 1),
        native_read_u8(out_ip as int, 2),
        native_read_u8(out_ip as int, 3)
    )
    out Ok((TcpStream ( fd: client_fd ), socket_addr(ip, peerPort)))
end.

func listener_close(listener: TcpListener):
    native_socket_close(listener.fd)
end.

entity NetNamespace:
    method resolve(hostname: string):
        out dns_resolve(hostname)
    end.
    method connect(host: string, listenPort: int):
        out tcp_connect(host, listenPort)
    end.
    method connectHost(hostname: string, listenPort: int):
        out tcp_connect_host(hostname, listenPort)
    end.
    method connectAddr(addr: SocketAddr):
        out tcp_connect_addr(addr)
    end.
    method writeAll(stream: TcpStream, text: string):
        out tcp_write_all_string(stream, text)
    end.
    method readAll(stream: TcpStream):
        out tcp_read_all_string(stream)
    end.
    method close(stream: TcpStream):
        tcp_close(stream)
    end.
end.

var net: NetNamespace

export IpAddr, SocketAddr, TcpStream, TcpListener, UdpSocket,
       ipv4, socket_addr, localhost,
       NetNamespace, net
