# Module: protocol/http2_session
# HTTP/2 Multiplexing Session Engine, Preface Verification, and Flow Control
# InterVir Unified Web Runtime — Phase 15: HTTP/2 Protocol Engine

include http2.frame
include http2.stream
include http2.hpack

entity H2Session:
    sess_id: int
    sess_is_server: bool
    sess_preface_verified: bool
    sess_settings_received: bool
    sess_settings_acked: bool
    sess_goaway_sent: bool
    sess_goaway_recv: bool
    sess_goaway_err: int
    sess_last_client_stream_id: int
    sess_last_server_stream_id: int
    sess_max_concurrent_streams: int
    sess_active_stream_count: int
    sess_conn_send_window: int
    sess_conn_recv_window: int
    sess_initial_stream_window: int
    sess_max_frame_size: int
    sess_ping_count: int
    sess_last_ping_payload: int
    s0: H2Stream
    s1: H2Stream
    s2: H2Stream
    s3: H2Stream
    s4: H2Stream
    s5: H2Stream
    s6: H2Stream
    s7: H2Stream
end.

func h2_stream_dummy() -> H2Stream:
    out H2Stream(
        strm_id: 0,
        strm_state: 0,
        strm_send_window: 0,
        strm_recv_window: 0,
        strm_bytes_sent: 0,
        strm_bytes_received: 0,
        strm_error_code: 0,
        strm_request_method: 0,
        strm_response_status: 0,
        strm_end_stream_sent: false,
        strm_end_stream_recv: false,
        strm_active: false,
        strm_request_path: "",
        strm_request_host: ""
    )
end.

func h2_session_init(this: H2Session, sid: int, is_server: bool):
    this.sess_id = sid
    this.sess_is_server = is_server
    this.sess_preface_verified = false
    this.sess_settings_received = false
    this.sess_settings_acked = false
    this.sess_goaway_sent = false
    this.sess_goaway_recv = false
    this.sess_goaway_err = 0
    this.sess_last_client_stream_id = 0
    this.sess_last_server_stream_id = 0
    this.sess_max_concurrent_streams = 8
    this.sess_active_stream_count = 0
    this.sess_conn_send_window = 65535
    this.sess_conn_recv_window = 65535
    this.sess_initial_stream_window = 65535
    this.sess_max_frame_size = 16384
    this.sess_ping_count = 0
    this.sess_last_ping_payload = 0

    this.s0 = h2_stream_dummy()
    this.s1 = h2_stream_dummy()
    this.s2 = h2_stream_dummy()
    this.s3 = h2_stream_dummy()
    this.s4 = h2_stream_dummy()
    this.s5 = h2_stream_dummy()
    this.s6 = h2_stream_dummy()
    this.s7 = h2_stream_dummy()
end.

# RFC 7540 §3.5 Connection Preface: "PRI * HTTP/2.0\r\n\r\nSM\r\n\r\n"
func h2_session_verify_preface(this: H2Session, preface_str: string) -> bool:
    if preface_str == "PRI * HTTP/2.0\r\n\r\nSM\r\n\r\n" do
        this.sess_preface_verified = true
        out true
    end
    out false
end.

# RFC 7540 §6.5 SETTINGS Frame Processing
func h2_session_apply_setting(this: H2Session, param: int, val: int) -> bool:
    # 1 = HeaderTableSize
    # 2 = EnablePush
    # 3 = MaxConcurrentStreams
    # 4 = InitialWindowSize
    # 5 = MaxFrameSize
    # 6 = MaxHeaderListSize
    if param == 2 do
        # EnablePush must be 0 or 1
        if val != 0 do
            if val != 1 do
                out false
            end
        end
    end

    if param == 3 do
        # MaxConcurrentStreams
        if val < 0 do
            out false
        end
        this.sess_max_concurrent_streams = val
    end

    if param == 4 do
        # InitialWindowSize must be <= 2^31 - 1
        var max_win = 2147483647
        if val < 0 do
            out false
        end
        if val > max_win do
            out false
        end
        this.sess_initial_stream_window = val
    end

    if param == 5 do
        # MaxFrameSize must be between 16384 and 16777215
        if val < 16384 do
            out false
        end
        if val > 16777215 do
            out false
        end
        this.sess_max_frame_size = val
    end

    this.sess_settings_received = true
    out true
end.

func h2_session_ack_settings(this: H2Session) -> bool:
    this.sess_settings_acked = true
    out true
end.

# RFC 7540 §6.7 PING Frame
func h2_session_handle_ping(this: H2Session, payload: int, is_ack: bool) -> bool:
    this.sess_last_ping_payload = payload
    this.sess_ping_count = this.sess_ping_count + 1
    out true
end.

# Connection Flow Control (Stream ID 0)
func h2_session_update_conn_send_window(this: H2Session, delta: int) -> bool:
    if delta <= 0 do
        out false
    end
    var max_win = 2147483647
    if this.sess_conn_send_window > max_win - delta do
        out false # FlowControlError (overflow)
    end
    this.sess_conn_send_window = this.sess_conn_send_window + delta
    out true
end.

func h2_session_update_conn_recv_window(this: H2Session, delta: int) -> bool:
    if delta <= 0 do
        out false
    end
    var max_win = 2147483647
    if this.sess_conn_recv_window > max_win - delta do
        out false
    end
    this.sess_conn_recv_window = this.sess_conn_recv_window + delta
    out true
end.

func h2_session_consume_conn_send_window(this: H2Session, bytes: int) -> bool:
    if bytes < 0 do
        out false
    end
    if bytes > this.sess_conn_send_window do
        out false
    end
    this.sess_conn_send_window = this.sess_conn_send_window - bytes
    out true
end.

func h2_session_consume_conn_recv_window(this: H2Session, bytes: int) -> bool:
    if bytes < 0 do
        out false
    end
    if bytes > this.sess_conn_recv_window do
        out false
    end
    this.sess_conn_recv_window = this.sess_conn_recv_window - bytes
    out true
end.

# Stream Lookup: returns slot index (0..7) or -1 if not found
func h2_session_find_stream(this: H2Session, stream_id: int) -> int:
    if this.s0.strm_active do
        if this.s0.strm_id == stream_id do out 0 end
    end
    if this.s1.strm_active do
        if this.s1.strm_id == stream_id do out 1 end
    end
    if this.s2.strm_active do
        if this.s2.strm_id == stream_id do out 2 end
    end
    if this.s3.strm_active do
        if this.s3.strm_id == stream_id do out 3 end
    end
    if this.s4.strm_active do
        if this.s4.strm_id == stream_id do out 4 end
    end
    if this.s5.strm_active do
        if this.s5.strm_id == stream_id do out 5 end
    end
    if this.s6.strm_active do
        if this.s6.strm_id == stream_id do out 6 end
    end
    if this.s7.strm_active do
        if this.s7.strm_id == stream_id do out 7 end
    end
    out -1
end.

# RFC 7540 §5.1.1 Stream Identifiers & Opening
# Returns slot index (0..7) on success,
# -1 on invalid stream ID (not odd, or not strictly increasing),
# -2 on max concurrent streams exceeded or no slot available,
# -3 on session in GOAWAY state
func h2_session_open_stream(this: H2Session, stream_id: int) -> int:
    if this.sess_goaway_sent do
        out -3
    end
    if this.sess_goaway_recv do
        out -3
    end

    # Client-initiated streams MUST be odd
    if (stream_id and 1) == 0 do
        out -1 # ProtocolError
    end

    # Stream IDs MUST be strictly monotonically increasing
    if stream_id <= this.sess_last_client_stream_id do
        out -1 # ProtocolError
    end

    # Max concurrent streams check
    if this.sess_active_stream_count >= this.sess_max_concurrent_streams do
        out -2 # RefusedStream
    end

    # Find free slot (0..7)
    var target_slot = -1
    if not this.s0.strm_active do
        target_slot = 0
    else
        if not this.s1.strm_active do
            target_slot = 1
        else
            if not this.s2.strm_active do
                target_slot = 2
            else
                if not this.s3.strm_active do
                    target_slot = 3
                else
                    if not this.s4.strm_active do
                        target_slot = 4
                    else
                        if not this.s5.strm_active do
                            target_slot = 5
                        else
                            if not this.s6.strm_active do
                                target_slot = 6
                            else
                                if not this.s7.strm_active do
                                    target_slot = 7
                                end
                            end
                        end
                    end
                end
            end
        end
    end

    if target_slot < 0 do
        out -2 # No slot available
    end

    # Initialize stream in slot
    var strm = H2Stream(
        strm_id: stream_id,
        strm_state: 2, # Open
        strm_send_window: this.sess_initial_stream_window,
        strm_recv_window: this.sess_initial_stream_window,
        strm_bytes_sent: 0,
        strm_bytes_received: 0,
        strm_error_code: 0,
        strm_request_method: 0,
        strm_response_status: 0,
        strm_end_stream_sent: false,
        strm_end_stream_recv: false,
        strm_active: true,
        strm_request_path: "/",
        strm_request_host: ""
    )

    if target_slot == 0 do
        this.s0 = strm
    else
        if target_slot == 1 do
            this.s1 = strm
        else
            if target_slot == 2 do
                this.s2 = strm
            else
                if target_slot == 3 do
                    this.s3 = strm
                else
                    if target_slot == 4 do
                        this.s4 = strm
                    else
                        if target_slot == 5 do
                            this.s5 = strm
                        else
                            if target_slot == 6 do
                                this.s6 = strm
                            else
                                if target_slot == 7 do
                                    this.s7 = strm
                                end
                            end
                        end
                    end
                end
            end
        end
    end

    this.sess_last_client_stream_id = stream_id
    this.sess_active_stream_count = this.sess_active_stream_count + 1
    out target_slot
end.

# Close stream and reclaim concurrent slot
func h2_session_close_stream_slot(this: H2Session, slot: int, err_code: int):
    if slot == 0 do
        var s = this.s0
        s.strm_state = 5 # Closed
        s.strm_active = false
        s.strm_error_code = err_code
        this.s0 = s
    end
    if slot == 1 do
        var s = this.s1
        s.strm_state = 5
        s.strm_active = false
        s.strm_error_code = err_code
        this.s1 = s
    end
    if slot == 2 do
        var s = this.s2
        s.strm_state = 5
        s.strm_active = false
        s.strm_error_code = err_code
        this.s2 = s
    end
    if slot == 3 do
        var s = this.s3
        s.strm_state = 5
        s.strm_active = false
        s.strm_error_code = err_code
        this.s3 = s
    end
    if slot == 4 do
        var s = this.s4
        s.strm_state = 5
        s.strm_active = false
        s.strm_error_code = err_code
        this.s4 = s
    end
    if slot == 5 do
        var s = this.s5
        s.strm_state = 5
        s.strm_active = false
        s.strm_error_code = err_code
        this.s5 = s
    end
    if slot == 6 do
        var s = this.s6
        s.strm_state = 5
        s.strm_active = false
        s.strm_error_code = err_code
        this.s6 = s
    end
    if slot == 7 do
        var s = this.s7
        s.strm_state = 5
        s.strm_active = false
        s.strm_error_code = err_code
        this.s7 = s
    end
    if this.sess_active_stream_count > 0 do
        this.sess_active_stream_count = this.sess_active_stream_count - 1
    end
end.

# RFC 7540 §6.4 RST_STREAM Processing
func h2_session_handle_rst_stream(this: H2Session, stream_id: int, err_code: int) -> bool:
    var slot = this.h2_session_find_stream(stream_id)
    if slot >= 0 do
        this.h2_session_close_stream_slot(slot, err_code)
        out true
    end
    out false
end.

# RFC 7540 §6.8 GOAWAY Processing
func h2_session_handle_goaway(this: H2Session, last_stream_id: int, err_code: int) -> bool:
    this.sess_goaway_recv = true
    this.sess_goaway_err = err_code
    this.sess_last_client_stream_id = last_stream_id
    out true
end.

# Send DATA on a stream: consumes both connection window and stream window
# Returns: 0 = OK, 3 = FlowControlError, 5 = StreamClosed, -1 = StreamNotFound
func h2_session_send_stream_data(this: H2Session, stream_id: int, bytes: int, is_end: bool) -> int:
    # Check connection-level window
    if bytes > this.sess_conn_send_window do
        out 3 # FlowControlError
    end

    var slot = this.h2_session_find_stream(stream_id)
    if slot < 0 do
        out -1
    end

    var target_stream = this.s0
    if slot == 1 do target_stream = this.s1 end
    if slot == 2 do target_stream = this.s2 end
    if slot == 3 do target_stream = this.s3 end
    if slot == 4 do target_stream = this.s4 end
    if slot == 5 do target_stream = this.s5 end
    if slot == 6 do target_stream = this.s6 end
    if slot == 7 do target_stream = this.s7 end

    if target_stream.strm_state == 5 do
        out 5 # StreamClosed
    end

    # Check stream-level window
    if bytes > target_stream.strm_send_window do
        out 3 # FlowControlError
    end

    # Consume windows
    this.sess_conn_send_window = this.sess_conn_send_window - bytes
    target_stream.strm_send_window = target_stream.strm_send_window - bytes
    target_stream.strm_bytes_sent = target_stream.strm_bytes_sent + bytes

    if is_end do
        target_stream.strm_end_stream_sent = true
        if target_stream.strm_state == 4 do
            # Was HalfClosedRemote, now closed
            target_stream.strm_state = 5
            target_stream.strm_active = false
            if this.sess_active_stream_count > 0 do
                this.sess_active_stream_count = this.sess_active_stream_count - 1
            end
        else
            target_stream.strm_state = 3 # HalfClosedLocal
        end
    end

    # Write back modified stream to slot
    if slot == 0 do this.s0 = target_stream end
    if slot == 1 do this.s1 = target_stream end
    if slot == 2 do this.s2 = target_stream end
    if slot == 3 do this.s3 = target_stream end
    if slot == 4 do this.s4 = target_stream end
    if slot == 5 do this.s5 = target_stream end
    if slot == 6 do this.s6 = target_stream end
    if slot == 7 do this.s7 = target_stream end

    out 0
end.

# Receive DATA from peer on a stream: consumes both connection window and stream window
# Returns: 0 = OK, 3 = FlowControlError, 5 = StreamClosed, -1 = StreamNotFound
func h2_session_recv_stream_data(this: H2Session, stream_id: int, bytes: int, is_end: bool) -> int:
    if bytes > this.sess_conn_recv_window do
        out 3 # FlowControlError
    end

    var slot = this.h2_session_find_stream(stream_id)
    if slot < 0 do
        out -1
    end

    var target_stream = this.s0
    if slot == 1 do target_stream = this.s1 end
    if slot == 2 do target_stream = this.s2 end
    if slot == 3 do target_stream = this.s3 end
    if slot == 4 do target_stream = this.s4 end
    if slot == 5 do target_stream = this.s5 end
    if slot == 6 do target_stream = this.s6 end
    if slot == 7 do target_stream = this.s7 end

    if target_stream.strm_state == 5 do
        out 5 # StreamClosed
    end

    if bytes > target_stream.strm_recv_window do
        out 3 # FlowControlError
    end

    this.sess_conn_recv_window = this.sess_conn_recv_window - bytes
    target_stream.strm_recv_window = target_stream.strm_recv_window - bytes
    target_stream.strm_bytes_received = target_stream.strm_bytes_received + bytes

    if is_end do
        target_stream.strm_end_stream_recv = true
        if target_stream.strm_state == 3 do
            # Was HalfClosedLocal, now closed
            target_stream.strm_state = 5
            target_stream.strm_active = false
            if this.sess_active_stream_count > 0 do
                this.sess_active_stream_count = this.sess_active_stream_count - 1
            end
        else
            target_stream.strm_state = 4 # HalfClosedRemote
        end
    end

    if slot == 0 do this.s0 = target_stream end
    if slot == 1 do this.s1 = target_stream end
    if slot == 2 do this.s2 = target_stream end
    if slot == 3 do this.s3 = target_stream end
    if slot == 4 do this.s4 = target_stream end
    if slot == 5 do this.s5 = target_stream end
    if slot == 6 do this.s6 = target_stream end
    if slot == 7 do this.s7 = target_stream end

    out 0
end.

# Stream slot state inspection helpers
func session_get_stream_id(this: H2Session, slot: int) -> int:
    if slot == 0 do out this.s0.strm_id end
    if slot == 1 do out this.s1.strm_id end
    if slot == 2 do out this.s2.strm_id end
    if slot == 3 do out this.s3.strm_id end
    if slot == 4 do out this.s4.strm_id end
    if slot == 5 do out this.s5.strm_id end
    if slot == 6 do out this.s6.strm_id end
    if slot == 7 do out this.s7.strm_id end
    out 0
end.

func session_get_stream_state(this: H2Session, slot: int) -> int:
    if slot == 0 do out this.s0.strm_state end
    if slot == 1 do out this.s1.strm_state end
    if slot == 2 do out this.s2.strm_state end
    if slot == 3 do out this.s3.strm_state end
    if slot == 4 do out this.s4.strm_state end
    if slot == 5 do out this.s5.strm_state end
    if slot == 6 do out this.s6.strm_state end
    if slot == 7 do out this.s7.strm_state end
    out 0
end.

func session_get_stream_send_win(this: H2Session, slot: int) -> int:
    if slot == 0 do out this.s0.strm_send_window end
    if slot == 1 do out this.s1.strm_send_window end
    if slot == 2 do out this.s2.strm_send_window end
    if slot == 3 do out this.s3.strm_send_window end
    if slot == 4 do out this.s4.strm_send_window end
    if slot == 5 do out this.s5.strm_send_window end
    if slot == 6 do out this.s6.strm_send_window end
    if slot == 7 do out this.s7.strm_send_window end
    out 0
end.

func session_get_stream_recv_win(this: H2Session, slot: int) -> int:
    if slot == 0 do out this.s0.strm_recv_window end
    if slot == 1 do out this.s1.strm_recv_window end
    if slot == 2 do out this.s2.strm_recv_window end
    if slot == 3 do out this.s3.strm_recv_window end
    if slot == 4 do out this.s4.strm_recv_window end
    if slot == 5 do out this.s5.strm_recv_window end
    if slot == 6 do out this.s6.strm_recv_window end
    if slot == 7 do out this.s7.strm_recv_window end
    out 0
end.

func session_is_stream_active(this: H2Session, slot: int) -> bool:
    if slot == 0 do out this.s0.strm_active end
    if slot == 1 do out this.s1.strm_active end
    if slot == 2 do out this.s2.strm_active end
    if slot == 3 do out this.s3.strm_active end
    if slot == 4 do out this.s4.strm_active end
    if slot == 5 do out this.s5.strm_active end
    if slot == 6 do out this.s6.strm_active end
    if slot == 7 do out this.s7.strm_active end
    out false
end.
