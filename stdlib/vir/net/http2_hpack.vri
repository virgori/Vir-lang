# Module: protocol/http2_hpack
# HPACK Static Table (RFC 7541 Appendix A) and Header Codec Helpers
# InterVir Unified Web Runtime — Phase 15: HTTP/2 Protocol Engine

entity HpackHeader:
    hp_index: int
    hp_is_indexed: bool
    hp_name: string
    hp_value: string
end.

func hpack_header_init(this: HpackHeader, idx: int, is_idx: bool, name: string, val: string):
    this.hp_index = idx
    this.hp_is_indexed = is_idx
    this.hp_name = name
    this.hp_value = val
end.

func hpack_static_table_size() -> int:
    out 61
end.

func hpack_static_get_name(idx: int) -> string:
    if idx == 1 do out ":authority" end
    if idx == 2 do out ":method" end
    if idx == 3 do out ":method" end
    if idx == 4 do out ":path" end
    if idx == 5 do out ":path" end
    if idx == 6 do out ":scheme" end
    if idx == 7 do out ":scheme" end
    if idx == 8 do out ":status" end
    if idx == 9 do out ":status" end
    if idx == 10 do out ":status" end
    if idx == 11 do out ":status" end
    if idx == 12 do out ":status" end
    if idx == 13 do out ":status" end
    if idx == 14 do out ":status" end
    if idx == 15 do out "accept-charset" end
    if idx == 16 do out "accept-encoding" end
    if idx == 17 do out "accept-language" end
    if idx == 18 do out "accept-ranges" end
    if idx == 19 do out "accept" end
    if idx == 20 do out "access-control-allow-origin" end
    if idx == 21 do out "age" end
    if idx == 22 do out "allow" end
    if idx == 23 do out "authorization" end
    if idx == 24 do out "cache-control" end
    if idx == 25 do out "content-disposition" end
    if idx == 26 do out "content-encoding" end
    if idx == 27 do out "content-language" end
    if idx == 28 do out "content-length" end
    if idx == 29 do out "content-location" end
    if idx == 30 do out "content-range" end
    if idx == 31 do out "content-type" end
    if idx == 32 do out "cookie" end
    if idx == 33 do out "date" end
    if idx == 34 do out "etag" end
    if idx == 35 do out "expect" end
    if idx == 36 do out "expires" end
    if idx == 37 do out "from" end
    if idx == 38 do out "host" end
    if idx == 39 do out "if-match" end
    if idx == 40 do out "if-modified-since" end
    if idx == 41 do out "if-none-match" end
    if idx == 42 do out "if-range" end
    if idx == 43 do out "if-unmodified-since" end
    if idx == 44 do out "last-modified" end
    if idx == 45 do out "link" end
    if idx == 46 do out "location" end
    if idx == 47 do out "max-forwards" end
    if idx == 48 do out "proxy-authenticate" end
    if idx == 49 do out "proxy-authorization" end
    if idx == 50 do out "range" end
    if idx == 51 do out "referer" end
    if idx == 52 do out "refresh" end
    if idx == 53 do out "retry-after" end
    if idx == 54 do out "server" end
    if idx == 55 do out "set-cookie" end
    if idx == 56 do out "strict-transport-security" end
    if idx == 57 do out "transfer-encoding" end
    if idx == 58 do out "user-agent" end
    if idx == 59 do out "vary" end
    if idx == 60 do out "via" end
    if idx == 61 do out "www-authenticate" end
    out ""
end.

func hpack_static_get_value(idx: int) -> string:
    if idx == 2 do out "GET" end
    if idx == 3 do out "POST" end
    if idx == 4 do out "/" end
    if idx == 5 do out "/index.html" end
    if idx == 6 do out "http" end
    if idx == 7 do out "https" end
    if idx == 8 do out "200" end
    if idx == 9 do out "204" end
    if idx == 10 do out "206" end
    if idx == 11 do out "304" end
    if idx == 12 do out "400" end
    if idx == 13 do out "404" end
    if idx == 14 do out "500" end
    if idx == 16 do out "gzip, deflate" end
    out ""
end.

func hpack_find_static_index(name: string, val: string) -> int:
    # Check full matches (name and value)
    if name == ":method" do
        if val == "GET" do out 2 end
        if val == "POST" do out 3 end
        out -2
    end
    if name == ":path" do
        if val == "/" do out 4 end
        if val == "/index.html" do out 5 end
        out -4
    end
    if name == ":scheme" do
        if val == "http" do out 6 end
        if val == "https" do out 7 end
        out -6
    end
    if name == ":status" do
        if val == "200" do out 8 end
        if val == "204" do out 9 end
        if val == "206" do out 10 end
        if val == "304" do out 11 end
        if val == "400" do out 12 end
        if val == "404" do out 13 end
        if val == "500" do out 14 end
        out -8
    end
    if name == ":authority" do out -1 end
    if name == "accept-encoding" do
        if val == "gzip, deflate" do out 16 end
        out -16
    end
    if name == "accept-charset" do out -15 end
    if name == "accept-language" do out -17 end
    if name == "accept-ranges" do out -18 end
    if name == "accept" do out -19 end
    if name == "access-control-allow-origin" do out -20 end
    if name == "age" do out -21 end
    if name == "allow" do out -22 end
    if name == "authorization" do out -23 end
    if name == "cache-control" do out -24 end
    if name == "content-disposition" do out -25 end
    if name == "content-encoding" do out -26 end
    if name == "content-language" do out -27 end
    if name == "content-length" do out -28 end
    if name == "content-location" do out -29 end
    if name == "content-range" do out -30 end
    if name == "content-type" do out -31 end
    if name == "cookie" do out -32 end
    if name == "date" do out -33 end
    if name == "etag" do out -34 end
    if name == "expect" do out -35 end
    if name == "expires" do out -36 end
    if name == "from" do out -37 end
    if name == "host" do out -38 end
    if name == "if-match" do out -39 end
    if name == "if-modified-since" do out -40 end
    if name == "if-none-match" do out -41 end
    if name == "if-range" do out -42 end
    if name == "if-unmodified-since" do out -43 end
    if name == "last-modified" do out -44 end
    if name == "link" do out -45 end
    if name == "location" do out -46 end
    if name == "max-forwards" do out -47 end
    if name == "proxy-authenticate" do out -48 end
    if name == "proxy-authorization" do out -49 end
    if name == "range" do out -50 end
    if name == "referer" do out -51 end
    if name == "refresh" do out -52 end
    if name == "retry-after" do out -53 end
    if name == "server" do out -54 end
    if name == "set-cookie" do out -55 end
    if name == "strict-transport-security" do out -56 end
    if name == "transfer-encoding" do out -57 end
    if name == "user-agent" do out -58 end
    if name == "vary" do out -59 end
    if name == "via" do out -60 end
    if name == "www-authenticate" do out -61 end
    out 0
end.

# RFC 7541 Binary Representation Checks

func hpack_is_indexed(first_byte: int) -> bool:
    if (first_byte and 128) != 0 do
        out true
    end
    out false
end.

func hpack_get_indexed_id(first_byte: int) -> int:
    out (first_byte and 127)
end.

func hpack_encode_indexed(idx: int) -> int:
    out (idx or 128)
end.

func hpack_is_literal_with_indexing(first_byte: int) -> bool:
    if (first_byte and 192) == 64 do
        out true
    end
    out false
end.

func hpack_get_literal_name_index(first_byte: int) -> int:
    out (first_byte and 63)
end.

func hpack_is_literal_without_indexing(first_byte: int) -> bool:
    if (first_byte and 240) == 0 do
        out true
    end
    out false
end.

func hpack_get_literal_without_indexing_name_index(first_byte: int) -> int:
    out (first_byte and 15)
end.

func hpack_is_literal_never_indexed(first_byte: int) -> bool:
    if (first_byte and 240) == 16 do
        out true
    end
    out false
end.
