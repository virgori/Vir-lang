# ═════════════════════════════════════════════════════════════════════
# Module: binding/query.vri
# Pure Vir URL Query String Multi-Param Parser
# Extracts scalar strings, integers, and multi-value parameter arrays
# ═════════════════════════════════════════════════════════════════════

const QUERY_MAX_PARAMS: 64

# Param layout (16 bytes):
#  Offset 0: key (ptr)
#  Offset 8: val (ptr)
const QUERY_PARAM_SIZE: 16

# Map layout:
#  Offset 0: count (int)
#  Offset 8: capacity (int)
#  Offset 16: params (ptr)
const QUERY_MAP_SIZE: 24

func qry_str_len(s: ptr) -> int:
    if s == 0 do out 0 end
    var i = 0
    when read_byte(s, i) != 0 loop
        i = i + 1
    end
    out i
end.

func qry_str_eq(a: ptr, b: ptr) -> int:
    if a == 0 do
        if b == 0 do out 1 end
        out 0
    end
    if b == 0 do out 0 end
    let la = qry_str_len(a)
    let lb = qry_str_len(b)
    if la != lb do out 0 end
    var i = 0
    when i < la loop
        if read_byte(a, i) != read_byte(b, i) do out 0 end
        i = i + 1
    end
    out 1
end.

func qry_hex_nibble(ch: int) -> int:
    if ch >= 48 and ch <= 57 do out ch - 48 end
    if ch >= 65 and ch <= 70 do out ch - 55 end
    if ch >= 97 and ch <= 102 do out ch - 87 end
    out 0 - 1
end.

func qry_hex_to_byte(h1: int, h2: int) -> int:
    let v1 = qry_hex_nibble(h1)
    let v2 = qry_hex_nibble(h2)
    if v1 < 0 or v2 < 0 do out 0 - 1 end
    out (v1 shl 4) | v2
end.

func qry_url_decode_slice(src: ptr, start_off: int, len: int) -> ptr:
    let dst = alloc(len + 1)
    var s = 0
    var d = 0
    when s < len loop
        let b = read_byte(src, start_off + s)
        if b == 43 do # '+' -> space
            write_byte(dst, d, 32)
            d = d + 1
            s = s + 1
        else
            var is_pct = 0
            if b == 37 do
                if (s + 2) < len do
                    is_pct = 1
                end
            end

            if is_pct == 1 do
                let h1 = read_byte(src, start_off + s + 1)
                let h2 = read_byte(src, start_off + s + 2)
                let decoded = qry_hex_to_byte(h1, h2)
                if decoded >= 0 do
                    write_byte(dst, d, decoded)
                    d = d + 1
                    s = s + 3
                else
                    write_byte(dst, d, b)
                    d = d + 1
                    s = s + 1
                end
            else
                write_byte(dst, d, b)
                d = d + 1
                s = s + 1
            end
        end
    end
    write_byte(dst, d, 0)
    out dst
end.

# Initialize Query Map
func query_map_create(capacity: int) -> ptr:
    var cap = capacity
    if cap <= 0 do cap = QUERY_MAX_PARAMS end
    if cap > QUERY_MAX_PARAMS do cap = QUERY_MAX_PARAMS end

    let qmap = alloc(QUERY_MAP_SIZE)
    let params = alloc(cap * QUERY_PARAM_SIZE)

    var i = 0
    when i < (cap * QUERY_PARAM_SIZE) loop
        write_byte(params, i, 0)
        i = i + 1
    end

    write_word(qmap, 0, 0)   # count = 0
    write_word(qmap, 8, cap) # capacity
    write_word(qmap, 16, params)
    out qmap
end.

# Parse query string (supports with or without leading '?')
func query_parse(raw_query: ptr, out_map: ptr) -> int:
    if raw_query == 0 do out 0 end
    if out_map == 0 do out 0 end

    let qlen = qry_str_len(raw_query)
    let cap = read_word(out_map, 8)
    let params = read_word(out_map, 16)
    var count = 0

    var p = 0
    # Skip leading '?' if present
    if p < qlen do
        if read_byte(raw_query, p) == 63 do # '?'
            p = p + 1
        end
    end

    when p < qlen loop
        if count >= cap do
            p = qlen
        else
            # skip consecutive '&'
            var skip_amp = 1
            when skip_amp == 1 loop
                if p < qlen do
                    if read_byte(raw_query, p) == 38 do
                        p = p + 1
                    else
                        skip_amp = 0
                    end
                else
                    skip_amp = 0
                end
            end

            if p < qlen do
                let key_start = p
                var scan_k = 1
                when scan_k == 1 loop
                    if p < qlen do
                        let b = read_byte(raw_query, p)
                        if b == 61 do
                            scan_k = 0
                        else
                            if b == 38 do
                                scan_k = 0
                            else
                                p = p + 1
                            end
                        end
                    else
                        scan_k = 0
                    end
                end
                let key_len = p - key_start

                if key_len > 0 do
                    let key_str = qry_url_decode_slice(raw_query, key_start, key_len)
                    var val_str = alloc(1)
                    write_byte(val_str, 0, 0)

                    if p < qlen do
                        if read_byte(raw_query, p) == 61 do
                            p = p + 1
                            let val_start = p
                            var scan_v = 1
                            when scan_v == 1 loop
                                if p < qlen do
                                    if read_byte(raw_query, p) == 38 do
                                        scan_v = 0
                                    else
                                        p = p + 1
                                    end
                                else
                                    scan_v = 0
                                end
                            end
                            let val_len = p - val_start
                            val_str = qry_url_decode_slice(raw_query, val_start, val_len)
                        end
                    end

                    let item = params + (count * QUERY_PARAM_SIZE)
                    write_word(item, 0, key_str)
                    write_word(item, 8, val_str)
                    count = count + 1
                end

                if p < qlen do
                    if read_byte(raw_query, p) == 38 do
                        p = p + 1
                    end
                end
            end
        end
    end

    write_word(out_map, 0, count)
    out count
end.

# Get single string query parameter (returns first match)
func query_get_str(qmap: ptr, key: ptr, out_val: ptr, max_len: int) -> int:
    if qmap == 0 do out 0 end
    if key == 0 do out 0 end
    if out_val == 0 do out 0 end
    if max_len <= 0 do out 0 end

    let count = read_word(qmap, 0)
    let params = read_word(qmap, 16)

    var i = 0
    when i < count loop
        let item = params + (i * QUERY_PARAM_SIZE)
        let k = read_word(item, 0)
        if qry_str_eq(k, key) == 1 do
            let v = read_word(item, 8)
            let vlen = qry_str_len(v)
            var c = 0
            when c < vlen loop
                if c < (max_len - 1) do
                    write_byte(out_val, c, read_byte(v, c))
                    c = c + 1
                else
                    c = vlen
                end
            end
            write_byte(out_val, c, 0)
            out c
        end
        i = i + 1
    end

    out 0
end.

# Get integer query parameter with fallback default value
func query_get_int(qmap: ptr, key: ptr, default_val: int) -> int:
    let buf = alloc(32)
    let l = query_get_str(qmap, key, buf, 32)
    if l <= 0 do out default_val end

    var val = 0
    var sign = 1
    var p = 0
    if read_byte(buf, 0) == 45 do # '-'
        sign = 0 - 1
        p = 1
    end

    when p < l loop
        let b = read_byte(buf, p)
        if b >= 48 do
            if b <= 57 do
                val = (val * 10) + (b - 48)
            else
                out default_val
            end
        else
            out default_val
        end
        p = p + 1
    end

    out val * sign
end.

# Get all values for repeated query parameter (e.g. ?tag=a&tag=b)
func query_get_all(qmap: ptr, key: ptr, out_ptrs: ptr, max_items: int) -> int:
    if qmap == 0 do out 0 end
    if key == 0 do out 0 end
    if out_ptrs == 0 do out 0 end

    let count = read_word(qmap, 0)
    let params = read_word(qmap, 16)
    var matches = 0

    var i = 0
    when i < count loop
        if matches < max_items do
            let item = params + (i * QUERY_PARAM_SIZE)
            let k = read_word(item, 0)
            if qry_str_eq(k, key) == 1 do
                let v = read_word(item, 8)
                write_word(out_ptrs, matches * 8, v)
                matches = matches + 1
            end
            i = i + 1
        else
            i = count
        end
    end

    out matches
end.
