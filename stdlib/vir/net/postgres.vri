##
 * vir/net/postgres.vri — PostgreSQL Wire Protocol (v3)
 * =====================================================
 * Inspired by: PostgreSQL Frontend/Backend Protocol
 *
 * Message encoding/decoding, authentication,
 * simple query, extended query (prepared statements),
 * type OID mapping, row parsing.
 ##

include types;
include option;
import Option, Some, None from option;
include result;
import Result, Ok, Err from result;
include vec;
import Vec, vec_new, vec_push, vec_len, vec_get from vec;
include str;
import StringBuilder, sb_new, sb_append, sb_append_byte, sb_build, sb_free from str;
include map;
import Map, map_new, map_insert, map_get from map;

# ═══════════════════════════════════════════════════════
# Message types (frontend → backend)
# ═══════════════════════════════════════════════════════

const PG_MSG_STARTUP    = 0;    # special (no tag)
const PG_MSG_QUERY      = 81;   # 'Q'
const PG_MSG_PARSE      = 80;   # 'P'
const PG_MSG_BIND       = 66;   # 'B'
const PG_MSG_DESCRIBE   = 68;   # 'D'
const PG_MSG_EXECUTE    = 69;   # 'E'
const PG_MSG_SYNC       = 83;   # 'S'
const PG_MSG_TERMINATE  = 88;   # 'X'
const PG_MSG_PASSWORD   = 112;  # 'p'

# ═══════════════════════════════════════════════════════
# Message types (backend → frontend)
# ═══════════════════════════════════════════════════════

const PG_RESP_AUTH          = 82;   # 'R'
const PG_RESP_PARAM_STATUS  = 83;   # 'S'
const PG_RESP_BACKEND_KEY   = 75;   # 'K'
const PG_RESP_READY         = 90;   # 'Z'
const PG_RESP_ROW_DESC      = 84;   # 'T'
const PG_RESP_DATA_ROW      = 68;   # 'D'
const PG_RESP_CMD_COMPLETE  = 67;   # 'C'
const PG_RESP_ERROR         = 69;   # 'E'
const PG_RESP_NOTICE        = 78;   # 'N'
const PG_RESP_PARSE_DONE    = 49;   # '1'
const PG_RESP_BIND_DONE     = 50;   # '2'

# ═══════════════════════════════════════════════════════
# Type OIDs (commonly used)
# ═══════════════════════════════════════════════════════

const PG_OID_BOOL    = 16;
const PG_OID_INT2    = 21;
const PG_OID_INT4    = 23;
const PG_OID_INT8    = 20;
const PG_OID_FLOAT4  = 700;
const PG_OID_FLOAT8  = 701;
const PG_OID_TEXT    = 25;
const PG_OID_VARCHAR = 1043;
const PG_OID_DATE    = 1082;
const PG_OID_TIMESTAMP = 1114;
const PG_OID_JSON    = 114;
const PG_OID_JSONB   = 3802;
const PG_OID_UUID    = 2950;

# ═══════════════════════════════════════════════════════
# Entities
# ═══════════════════════════════════════════════════════

entity PgMessage:
    tag:     int;
    payload: string;
end

entity PgColumn:
    name:       string;
    table_oid:  int;
    col_idx:    int;
    type_oid:   int;
    type_size:  int;
    type_mod:   int;
    format:     int;  # 0=text, 1=binary
end

entity PgRow:
    columns: Vec;  # Vec<Option<string>> — None for NULL
end

entity PgConnParams:
    host:     string;
    port:     int;
    user:     string;
    password: string;
    database: string;
end

entity PgResult:
    columns:    Vec;  # Vec<PgColumn>
    rows:       Vec;  # Vec<PgRow>
    cmd_tag:    string;
    row_count:  int;
end

# ═══════════════════════════════════════════════════════
# Wire helpers — int32 big-endian
# ═══════════════════════════════════════════════════════

func _pg_put_i32:
    in(sb: StringBuilder; val: int)
    sb_append_byte(sb, (val / 16777216) % 256);
    sb_append_byte(sb, (val / 65536) % 256);
    sb_append_byte(sb, (val / 256) % 256);
    sb_append_byte(sb, val % 256);
end

func _pg_put_i16:
    in(sb: StringBuilder; val: int)
    sb_append_byte(sb, (val / 256) % 256);
    sb_append_byte(sb, val % 256);
end

func _pg_read_i32:
    in(data: string; offset: int)
    b0 = str_byte_at(data, offset);
    b1 = str_byte_at(data, offset + 1);
    b2 = str_byte_at(data, offset + 2);
    b3 = str_byte_at(data, offset + 3);
    out b0 * 16777216 + b1 * 65536 + b2 * 256 + b3;
end

func _pg_read_i16:
    in(data: string; offset: int)
    out str_byte_at(data, offset) * 256 + str_byte_at(data, offset + 1);
end

# ═══════════════════════════════════════════════════════
# Startup message
# ═══════════════════════════════════════════════════════

func pg_startup_message:
    in(params: PgConnParams)
    sb = sb_new();
    # Length placeholder (4 bytes)
    _pg_put_i32(sb, 0);
    # Protocol version 3.0
    _pg_put_i32(sb, 196608);
    # Parameters
    sb_append(sb, "user");
    sb_append_byte(sb, 0);
    sb_append(sb, params.user);
    sb_append_byte(sb, 0);
    sb_append(sb, "database");
    sb_append_byte(sb, 0);
    sb_append(sb, params.database);
    sb_append_byte(sb, 0);
    # Terminator
    sb_append_byte(sb, 0);
    out sb_build(sb);
end

# ═══════════════════════════════════════════════════════
# Simple query protocol
# ═══════════════════════════════════════════════════════

func pg_simple_query:
    in(sql: string)
    sb = sb_new();
    sb_append_byte(sb, PG_MSG_QUERY);
    len = str_len(sql) + 5;  # length(4) + sql + null(1)
    _pg_put_i32(sb, len);
    sb_append(sb, sql);
    sb_append_byte(sb, 0);
    out sb_build(sb);
end

# ═══════════════════════════════════════════════════════
# Extended query protocol
# ═══════════════════════════════════════════════════════

func pg_parse:
    in(stmt_name: string; sql: string; param_oids: Vec)
    sb = sb_new();
    sb_append_byte(sb, PG_MSG_PARSE);
    _pg_put_i32(sb, 0);  # length placeholder
    sb_append(sb, stmt_name);
    sb_append_byte(sb, 0);
    sb_append(sb, sql);
    sb_append_byte(sb, 0);
    n = vec_len(param_oids);
    _pg_put_i16(sb, n);
    i = 0;
    when i < n loop
        oid = vec_get(param_oids, i);
        _pg_put_i32(sb, oid);
        i = i + 1;
    end
    out sb_build(sb);
end

func pg_bind:
    in(portal: string; stmt_name: string; params: Vec)
    sb = sb_new();
    sb_append_byte(sb, PG_MSG_BIND);
    _pg_put_i32(sb, 0);  # placeholder
    sb_append(sb, portal);
    sb_append_byte(sb, 0);
    sb_append(sb, stmt_name);
    sb_append_byte(sb, 0);
    # All text format
    _pg_put_i16(sb, 0);
    # Parameters
    n = vec_len(params);
    _pg_put_i16(sb, n);
    i = 0;
    when i < n loop
        p = vec_get(params, i);
        if is_none(p):
            # NULL
            _pg_put_i32(sb, -1);
        else:
            val = unwrap(p);
            _pg_put_i32(sb, str_len(val));
            sb_append(sb, val);
        end
        i = i + 1;
    end
    # Result format = text
    _pg_put_i16(sb, 0);
    out sb_build(sb);
end

func pg_execute:
    in(portal: string; max_rows: int)
    sb = sb_new();
    sb_append_byte(sb, PG_MSG_EXECUTE);
    _pg_put_i32(sb, 0);
    sb_append(sb, portal);
    sb_append_byte(sb, 0);
    _pg_put_i32(sb, max_rows);
    out sb_build(sb);
end

func pg_sync:
    in()
    sb = sb_new();
    sb_append_byte(sb, PG_MSG_SYNC);
    _pg_put_i32(sb, 4);
    out sb_build(sb);
end

func pg_terminate:
    in()
    sb = sb_new();
    sb_append_byte(sb, PG_MSG_TERMINATE);
    _pg_put_i32(sb, 4);
    out sb_build(sb);
end

# ═══════════════════════════════════════════════════════
# Password message (clear-text / MD5)
# ═══════════════════════════════════════════════════════

func pg_password_message:
    in(password: string)
    sb = sb_new();
    sb_append_byte(sb, PG_MSG_PASSWORD);
    _pg_put_i32(sb, str_len(password) + 5);
    sb_append(sb, password);
    sb_append_byte(sb, 0);
    out sb_build(sb);
end

# ═══════════════════════════════════════════════════════
# Response parsing
# ═══════════════════════════════════════════════════════

func pg_parse_message:
    in(data: string; offset: int)
    tag = str_byte_at(data, offset);
    length = _pg_read_i32(data, offset + 1);
    payload = str_slice(data, offset + 5, offset + 1 + length);
    out PgMessage { tag: tag, payload: payload };
end

func pg_parse_row_desc:
    in(payload: string)
    cols = vec_new();
    n = _pg_read_i16(payload, 0);
    off = 2;
    i = 0;
    when i < n loop
        # Read null-terminated name
        name_start = off;
        when str_byte_at(payload, off) != 0 loop
            off = off + 1;
        end
        name = str_slice(payload, name_start, off);
        off = off + 1;  # skip null
        table_oid = _pg_read_i32(payload, off); off = off + 4;
        col_idx = _pg_read_i16(payload, off); off = off + 2;
        type_oid = _pg_read_i32(payload, off); off = off + 4;
        type_size = _pg_read_i16(payload, off); off = off + 2;
        type_mod = _pg_read_i32(payload, off); off = off + 4;
        fmt = _pg_read_i16(payload, off); off = off + 2;
        col = PgColumn {
            name: name, table_oid: table_oid,
            col_idx: col_idx, type_oid: type_oid,
            type_size: type_size, type_mod: type_mod, format: fmt
        };
        vec_push(cols, col);
        i = i + 1;
    end
    out cols;
end

func pg_parse_data_row:
    in(payload: string)
    row = PgRow { columns: vec_new() };
    n = _pg_read_i16(payload, 0);
    off = 2;
    i = 0;
    when i < n loop
        col_len = _pg_read_i32(payload, off);
        off = off + 4;
        if col_len == -1:
            vec_push(row.columns, None);
        else:
            val = str_slice(payload, off, off + col_len);
            vec_push(row.columns, Some(val));
            off = off + col_len;
        end
        i = i + 1;
    end
    out row;
end

# ═══════════════════════════════════════════════════════
# Result builder
# ═══════════════════════════════════════════════════════

func pg_result_new:
    in()
    out PgResult {
        columns: vec_new(), rows: vec_new(),
        cmd_tag: "", row_count: 0
    };
end

func pg_result_column_index:
    in(result: PgResult; name: string)
    i = 0;
    when i < vec_len(result.columns) loop
        col = vec_get(result.columns, i);
        if col.name == name:
            out Some(i);
        end
        i = i + 1;
    end
    out None;
end

func pg_row_get:
    in(row: PgRow; col_idx: int)
    out vec_get(row.columns, col_idx);
end
