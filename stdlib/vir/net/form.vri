##
 * vir/net/form.vri — Form URL-Encoded Parser and Serializer (application/x-www-form-urlencoded)
 * ==============================================================================================
 ##

include types
include result
include option
include alloc
import vir_alloc, vir_free, vir_realloc from alloc
include vec_rt
import vec_new_rt, vec_push_rt, vec_get_rt, vec_len_rt, vec_set_rt from vec_rt
include vir.net.url

extern func native_read_u8(addr: int, offset: int) -> int
extern func native_write_u8(addr: int, offset: int, val: int)
extern func native_read_i64(addr: int, offset: int) -> int
extern func native_write_i64(addr: int, offset: int, val: int)

entity FormDoc:
    keys: int,
    vals: int
end.

func form_new() -> FormDoc:
    let k = vec_new_rt()
    let v = vec_new_rt()
    out FormDoc ( keys: k, vals: v )
end.

func form_get(doc: FormDoc, key: string) -> Option<string>:
    let n = vec_len_rt(doc.keys)
    var i = 0
    when i < n loop
        let k = vec_get_rt(doc.keys, i) as string
        if url_str_eq(k, key) do
            let v = vec_get_rt(doc.vals, i) as string
            out Some(v)
        end
        i = i + 1
    end
    out None
end.

func form_set(doc: FormDoc, key: string, val: string):
    let n = vec_len_rt(doc.keys)
    var i = 0
    when i < n loop
        let k = vec_get_rt(doc.keys, i) as string
        if url_str_eq(k, key) do
            doc.vals = vec_set_rt(doc.vals, i, val as int)
            out
        end
        i = i + 1
    end
    doc.keys = vec_push_rt(doc.keys, key as int)
    doc.vals = vec_push_rt(doc.vals, val as int)
end.

func form_parse(body: string) -> FormDoc:
    let doc = form_new()
    let bp = body as int
    if bp == 0 do out doc end
    let blen = url_str_len(bp)
    if blen == 0 do out doc end

    var pos = 0
    when pos < blen loop
        var pair_end = pos
        when pair_end < blen loop
            if native_read_u8(bp, pair_end) == 38 do break end # '&'
            pair_end = pair_end + 1
        end

        var eq_pos = 0 - 1
        var si = pos
        when si < pair_end loop
            if native_read_u8(bp, si) == 61 do # '='
                eq_pos = si
                break
            end
            si = si + 1
        end

        if eq_pos >= 0 do
            let raw_k = url_copy_substr(bp, pos, eq_pos)
            let raw_v = url_copy_substr(bp, eq_pos + 1, pair_end)
            var k = raw_k
            let rk = url_decode_form(raw_k)
            case rk
                Ok(dk): k = dk
                Err(_): k = raw_k
            end
            var v = raw_v
            let rv = url_decode_form(raw_v)
            case rv
                Ok(dv): v = dv
                Err(_): v = raw_v
            end
            form_set(doc, k, v)
        else
            let raw_k = url_copy_substr(bp, pos, pair_end)
            var k = raw_k
            let rk = url_decode_form(raw_k)
            case rk
                Ok(dk): k = dk
                Err(_): k = raw_k
            end
            form_set(doc, k, "")
        end

        pos = pair_end + 1
    end

    out doc
end.

func form_stringify(doc: FormDoc) -> string:
    let ub = ub_new()
    let n = vec_len_rt(doc.keys)
    var i = 0
    when i < n loop
        if i > 0 do
            ub_append_byte(ub, 38) # '&'
        end
        let k = vec_get_rt(doc.keys, i) as string
        let v = vec_get_rt(doc.vals, i) as string
        ub_append_str(ub, url_encode(k))
        ub_append_byte(ub, 61) # '='
        ub_append_str(ub, url_encode(v))
        i = i + 1
    end
    ub_append_byte(ub, 0)
    out ub.data as string
end.

export FormDoc, form_new, form_get, form_set, form_parse, form_stringify
