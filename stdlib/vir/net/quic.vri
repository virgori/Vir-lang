##
 * vir/net/quic.vri — QUIC Transport Protocol (RFC 9000)
 * =====================================================
 * Inspired by Rust: quinn crate
 * Inspired by Go: quic-go
 *
 * Phase D — QUIC packet format, connection IDs, stream frames,
 * variable-length integer encoding.
 ##

include types;
include option;
import Option, Some, None, is_some, is_none, unwrap from option;
include vec;
import Vec, vec_new, vec_push, vec_get, vec_len from vec;
include builder;
import StringBuilder, sb_new, sb_append_byte, sb_build, sb_free from builder;

# ═══════════════════════════════════════════════════════
# QUIC variable-length integer (RFC 9000 §16)
# ═══════════════════════════════════════════════════════

func quic_encode_varint:
    in(sb: StringBuilder; value: int)
    if value < 64 do
        sb_append_byte(sb, value);
    eif value < 16384 do
        sb_append_byte(sb, (value / 256) | 64);
        sb_append_byte(sb, value & 255);
    eif value < 1073741824 do
        sb_append_byte(sb, (value / 16777216) | 128);
        sb_append_byte(sb, (value / 65536) & 255);
        sb_append_byte(sb, (value / 256) & 255);
        sb_append_byte(sb, value & 255);
    else
        sb_append_byte(sb, (value / 72057594037927936) | 192);
        sb_append_byte(sb, (value / 281474976710656) & 255);
        sb_append_byte(sb, (value / 1099511627776) & 255);
        sb_append_byte(sb, (value / 4294967296) & 255);
        sb_append_byte(sb, (value / 16777216) & 255);
        sb_append_byte(sb, (value / 65536) & 255);
        sb_append_byte(sb, (value / 256) & 255);
        sb_append_byte(sb, value & 255);
    end
end
entity QuicVarint:
    value: int,
        pos:   int;
end
func quic_decode_varint:
    in(data: string; pos: int)
    first = str_byte_at(data, pos);
    kind = (first / 64) & 3;

    if kind == 0 do
        out QuicVarint ( value: first & 63, pos: pos + 1 );
    eif kind == 1 do
        v = (first & 63) * 256 + str_byte_at(data, pos + 1);
        out QuicVarint ( value: v, pos: pos + 2 );
    eif kind == 2 do
        v = (first & 63) * 16777216
          + str_byte_at(data, pos + 1) * 65536
          + str_byte_at(data, pos + 2) * 256
          + str_byte_at(data, pos + 3);
        out QuicVarint ( value: v, pos: pos + 4 );
    end
    # 8-byte
    v = (first & 63);
    i = 1;
    when i < 8 loop
        v = v * 256 + str_byte_at(data, pos + i);
        i = i + 1;
    end
    out QuicVarint ( value: v, pos: pos + 8 );
end
# ═══════════════════════════════════════════════════════
# Packet types
# ═══════════════════════════════════════════════════════

const QUIC_INITIAL   = 0;
const QUIC_0RTT      = 1;
const QUIC_HANDSHAKE = 2;
const QUIC_RETRY     = 3;
const QUIC_SHORT     = 4;    # 1-RTT

entity QuicPacketHeader:
    form:           int;     # QUIC_INITIAL / QUIC_SHORT etc.
    version:        int;     # 32-bit version (0x00000001 for v1)
    dcid:           string;  # destination connection ID
    dcid_len:       int,
        scid:           string;  # source connection ID
    scid_len:       int,
        packet_number:  int,
        payload_len:    int;
end

# ═══════════════════════════════════════════════════════
# Frame types (RFC 9000 §19)
# ═══════════════════════════════════════════════════════

const QF_PADDING          = 0;
const QF_PING             = 1;
const QF_ACK              = 2;
const QF_RESET_STREAM     = 4;
const QF_STOP_SENDING     = 5;
const QF_CRYPTO           = 6;
const QF_NEW_TOKEN        = 7;
const QF_STREAM           = 8;   # 0x08-0x0f
const QF_MAX_DATA         = 16;
const QF_MAX_STREAM_DATA  = 17;
const QF_MAX_STREAMS      = 18;
const QF_CONNECTION_CLOSE = 28;
const QF_HANDSHAKE_DONE   = 30;

entity QuicFrame:
    frame_type: int,
        stream_id:  int,
        offset:     int,
        data:       string,
        data_len:   int;
end

# ═══════════════════════════════════════════════════════
# Stream state
# ═══════════════════════════════════════════════════════

const QS_IDLE    = 0;
const QS_OPEN    = 1;
const QS_SEND    = 2;
const QS_RECV    = 3;
const QS_CLOSED  = 4;

entity QuicStream:
    id:         int,
        state:      int,
        send_buf:   string,
        recv_buf:   string,
        send_off:   int,
        recv_off:   int,
        max_data:   int;
end
func quic_stream_new:
    in(id: int; max_data: int)
    out QuicStream (
        id: id, state: QS_IDLE,
        send_buf: "", recv_buf: "",
        send_off: 0, recv_off: 0,
        max_data: max_data
    );
end
# ═══════════════════════════════════════════════════════
# Connection
# ═══════════════════════════════════════════════════════

entity QuicConnection:
    local_cid:   string,
        remote_cid:  string,
        version:     int,
        streams:     Vec;       # Vec<QuicStream>
    next_stream: int,
        max_data:    int,
        is_server:   bool;
end
func quic_connection_new:
    in(local_cid: string; remote_cid: string; is_server: bool)
    out QuicConnection (
        local_cid: local_cid,
        remote_cid: remote_cid,
        version: 1,
        streams: vec_new(),
        next_stream: 0,
        max_data: 1048576,
        is_server: is_server
    );
end
func quic_open_stream:
    in(conn: QuicConnection)
    # Client: even bidi (0,4,8...), Server: odd bidi (1,5,9...)
    id = conn.next_stream * 4;
    if conn.is_server do
        id = id + 1;
    end
    conn.next_stream = conn.next_stream + 1;
    stream = quic_stream_new(id, conn.max_data);
    stream.state = QS_OPEN;
    vec_push(conn.streams, stream);
    out stream;
end