##
 * vir/net/mdns.vri — Multicast DNS Service Discovery
 * ====================================================
 * Inspired by: RFC 6762 (mDNS) / RFC 6763 (DNS-SD)
 *
 * mDNS record types, query/response construction,
 * service browsing, registration helpers.
 ##

include types;
include option;
import Option, Some, None from option;
include vec;
import Vec, vec_new, vec_push, vec_len, vec_get from vec;
include str;
import StringBuilder, sb_new, sb_append, sb_append_byte, sb_build, sb_free from str;

# ═══════════════════════════════════════════════════════
# DNS record types
# ═══════════════════════════════════════════════════════

const MDNS_TYPE_A     = 1;
const MDNS_TYPE_PTR   = 12;
const MDNS_TYPE_TXT   = 16;
const MDNS_TYPE_AAAA  = 28;
const MDNS_TYPE_SRV   = 33;

const MDNS_CLASS_IN   = 1;
const MDNS_MULTICAST  = "224.0.0.251";
const MDNS_PORT       = 5353;

# ═══════════════════════════════════════════════════════
# Entities
# ═══════════════════════════════════════════════════════

entity MdnsQuestion:
    name:  string,
        qtype: int,
        qclass: int;
end.
entity MdnsRecord:
    name:   string,
        rtype:  int,
        rclass: int,
        ttl:    int,
        rdata:  string;
end.
entity MdnsMessage:
    id:          int,
        is_response: bool,
        questions:   Vec;  # Vec<MdnsQuestion>
    answers:     Vec;  # Vec<MdnsRecord>
    additional:  Vec;  # Vec<MdnsRecord>
end.
entity MdnsService:
    name:     string;      # "My Printer"
    stype:    string;      # "_http._tcp"
    domain:   string;      # "local"
    port:     int,
        host:     string;      # hostname
    txt:      Vec;         # Vec<string> key=value pairs
end.

# ═══════════════════════════════════════════════════════
# DNS name encoding
# ═══════════════════════════════════════════════════════

func mdns_encode_name(name: string):
    sb = sb_new();
    label_start = 0;
    i = 0;
    n = str_len(name);
    when i < n loop
        ch = str_byte_at(name, i);
        if ch == 46 do # '.'
            label_len = i - label_start;
            sb_append_byte(sb, label_len);
            j = label_start;
            when j < i loop
                sb_append_byte(sb, str_byte_at(name, j));
                j = j + 1;
            end
            label_start = i + 1;
        end
        i = i + 1;
    end
    # last label
    label_len = n - label_start;
    if label_len > 0 do
        sb_append_byte(sb, label_len);
        j = label_start;
        when j < n loop
            sb_append_byte(sb, str_byte_at(name, j));
            j = j + 1;
        end
    end
    sb_append_byte(sb, 0);  # root label
    out sb_build(sb);
end.
# ═══════════════════════════════════════════════════════
# Query construction
# ═══════════════════════════════════════════════════════

func mdns_new_query(name: string, qtype: int):
    msg = MdnsMessage (
        id: 0, is_response: false,
        questions: vec_new(), answers: vec_new(),
        additional: vec_new()
    );
    q = MdnsQuestion ( name: name, qtype: qtype, qclass: MDNS_CLASS_IN );
    vec_push(msg.questions, q);
    out msg;
end.
func mdns_encode_header(msg: MdnsMessage):
    sb = sb_new();
    # ID (2 bytes)
    sb_append_byte(sb, (msg.id / 256) % 256);
    sb_append_byte(sb, msg.id % 256);
    # Flags
    flags = 0;
    if msg.is_response do
        flags = 32768;  # 0x8400 QR=1, AA=1
        flags = flags + 1024;
    end
    sb_append_byte(sb, (flags / 256) % 256);
    sb_append_byte(sb, flags % 256);
    # QD count
    qd = vec_len(msg.questions);
    sb_append_byte(sb, (qd / 256) % 256);
    sb_append_byte(sb, qd % 256);
    # AN count
    an = vec_len(msg.answers);
    sb_append_byte(sb, (an / 256) % 256);
    sb_append_byte(sb, an % 256);
    # NS count = 0
    sb_append_byte(sb, 0);
    sb_append_byte(sb, 0);
    # AR count
    ar = vec_len(msg.additional);
    sb_append_byte(sb, (ar / 256) % 256);
    sb_append_byte(sb, ar % 256);
    out sb_build(sb);
end.
# ═══════════════════════════════════════════════════════
# Service discovery helpers
# ═══════════════════════════════════════════════════════

func mdns_service_fqdn(svc: MdnsService):
    out svc.name + "." + svc.stype + "." + svc.domain;
end.
func mdns_browse_query(service_type: string, domain: string):
    fqdn = service_type + "." + domain;
    out mdns_new_query(fqdn, MDNS_TYPE_PTR);
end.
func mdns_service_response(svc: MdnsService):
    msg = MdnsMessage (
        id: 0, is_response: true,
        questions: vec_new(), answers: vec_new(),
        additional: vec_new()
    );
    fqdn = mdns_service_fqdn(svc);
    ptr_name = svc.stype + "." + svc.domain;
    ptr_rec = MdnsRecord (
        name: ptr_name, rtype: MDNS_TYPE_PTR,
        rclass: MDNS_CLASS_IN, ttl: 4500, rdata: fqdn
    );
    vec_push(msg.answers, ptr_rec);
    srv_rec = MdnsRecord (
        name: fqdn, rtype: MDNS_TYPE_SRV,
        rclass: MDNS_CLASS_IN, ttl: 120,
        rdata: svc.host + ":" + int_to_str(svc.port)
    );
    vec_push(msg.additional, srv_rec);
    out msg;
end.
# ═══════════════════════════════════════════════════════
# TXT record encoding  "key=value" pairs
# ═══════════════════════════════════════════════════════

func mdns_encode_txt(pairs: Vec):
    sb = sb_new();
    i = 0;
    when i < vec_len(pairs) loop
        entry = vec_get(pairs, i);
        elen = str_len(entry);
        sb_append_byte(sb, elen);
        sb_append(sb, entry);
        i = i + 1;
    end
    out sb_build(sb);
end.