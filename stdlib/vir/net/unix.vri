##
 * vir/net/unix.vri — Unix Domain Socket
 * =====================================
 * Inspired by Rust: std::os::unix::net
 * Inspired by Go: net.UnixConn
 *
 * Phase D — Unix domain socket (SOCK_STREAM / SOCK_DGRAM),
 * abstract/filesystem paths, credential passing.
 ##

include types;
include option;
import Option, Some, None from option;
include result;
import Result, Ok, Err from result;

# ═══════════════════════════════════════════════════════
# Socket types
# ═══════════════════════════════════════════════════════

const UNIX_STREAM   = 1;   # SOCK_STREAM
const UNIX_DGRAM    = 2;   # SOCK_DGRAM
const UNIX_SEQPACKET = 5;  # SOCK_SEQPACKET

entity UnixSocket:
    fd:        int,
        path:      string,
        sock_type: int,
        connected: bool;
end
entity UnixListener:
    fd:   int,
        path: string;
end

# ═══════════════════════════════════════════════════════
# Native bindings (implemented in C runtime)
# ═══════════════════════════════════════════════════════

extern func native_unix_socket:   in(sock_type: int) out int; end
extern func native_unix_bind:     in(fd: int; path: string) out int; end
extern func native_unix_listen:   in(fd: int; backlog: int) out int; end
extern func native_unix_accept:   in(fd: int) out int; end
extern func native_unix_connect:  in(fd: int; path: string) out int; end
extern func native_unix_send:     in(fd: int; data: string; len: int) out int; end
extern func native_unix_recv:     in(fd: int; buf_size: int) out string; end
extern func native_unix_close:    in(fd: int) out int; end
extern func native_unix_unlink:   in(path: string) out int; end

# ═══════════════════════════════════════════════════════
# Stream socket API
# ═══════════════════════════════════════════════════════

func unix_listen:
    in(path: string; backlog: int)
    fd = native_unix_socket(UNIX_STREAM);
    if fd < 0 do
        out Err("failed to create unix socket");
    end
    rc = native_unix_bind(fd, path);
    if rc < 0 do
        native_unix_close(fd);
        out Err("failed to bind: " + path);
    end
    rc = native_unix_listen(fd, backlog);
    if rc < 0 do
        native_unix_close(fd);
        out Err("failed to listen");
    end
    out Ok(UnixListener ( fd: fd, path: path ));
end
func unix_accept:
    in(listener: UnixListener)
    cfd = native_unix_accept(listener.fd);
    if cfd < 0 do
        out Err("accept failed");
    end
    out Ok(UnixSocket (
        fd: cfd, path: listener.path,
        sock_type: UNIX_STREAM, connected: true
    ));
end
func unix_connect:
    in(path: string)
    fd = native_unix_socket(UNIX_STREAM);
    if fd < 0 do
        out Err("failed to create socket");
    end
    rc = native_unix_connect(fd, path);
    if rc < 0 do
        native_unix_close(fd);
        out Err("connect failed: " + path);
    end
    out Ok(UnixSocket (
        fd: fd, path: path,
        sock_type: UNIX_STREAM, connected: true
    ));
end
func unix_send:
    in(sock: UnixSocket; data: string; len: int)
    out native_unix_send(sock.fd, data, len);
end
func unix_recv:
    in(sock: UnixSocket; buf_size: int)
    out native_unix_recv(sock.fd, buf_size);
end
func unix_close:
    in(sock: UnixSocket)
    native_unix_close(sock.fd);
    sock.connected = false;
end
func unix_listener_close:
    in(listener: UnixListener)
    native_unix_close(listener.fd);
    native_unix_unlink(listener.path);
end
# ═══════════════════════════════════════════════════════
# Datagram socket API
# ═══════════════════════════════════════════════════════

func unix_dgram_bind:
    in(path: string)
    fd = native_unix_socket(UNIX_DGRAM);
    if fd < 0 do
        out Err("failed to create dgram socket");
    end
    rc = native_unix_bind(fd, path);
    if rc < 0 do
        native_unix_close(fd);
        out Err("bind failed");
    end
    out Ok(UnixSocket (
        fd: fd, path: path,
        sock_type: UNIX_DGRAM, connected: false
    ));
end
# ═══════════════════════════════════════════════════════
# Peer credentials (SO_PEERCRED)
# ═══════════════════════════════════════════════════════

entity PeerCred:
    pid: int,
        uid: int,
        gid: int;
end

extern func native_unix_peercred: in(fd: int) out PeerCred; end

func unix_peer_cred:
    in(sock: UnixSocket)
    out native_unix_peercred(sock.fd);
end