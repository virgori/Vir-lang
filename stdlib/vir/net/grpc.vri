##
 * vir/net/grpc.vri — gRPC Protocol (over HTTP/2)
 * ===============================================
 * Inspired by Rust: tonic crate
 * Inspired by Go: grpc-go
 *
 * Phase D — gRPC frame encoding, status codes, metadata,
 * unary/streaming call abstractions.
 ##

include types;
include option;
import Option, Some, None, is_some, is_none, unwrap from option;
include vec;
import Vec, vec_new, vec_push, vec_get, vec_len from vec;
include builder;
import StringBuilder, sb_new, sb_append, sb_append_byte, sb_append_i64,
       sb_build, sb_free from builder;

# ═══════════════════════════════════════════════════════
# gRPC Status Codes
# ═══════════════════════════════════════════════════════

const GRPC_OK                  = 0;
const GRPC_CANCELLED           = 1;
const GRPC_UNKNOWN             = 2;
const GRPC_INVALID_ARGUMENT    = 3;
const GRPC_DEADLINE_EXCEEDED   = 4;
const GRPC_NOT_FOUND           = 5;
const GRPC_ALREADY_EXISTS      = 6;
const GRPC_PERMISSION_DENIED   = 7;
const GRPC_RESOURCE_EXHAUSTED  = 8;
const GRPC_FAILED_PRECONDITION = 9;
const GRPC_ABORTED             = 10;
const GRPC_OUT_OF_RANGE        = 11;
const GRPC_UNIMPLEMENTED       = 12;
const GRPC_INTERNAL            = 13;
const GRPC_UNAVAILABLE         = 14;
const GRPC_DATA_LOSS           = 15;
const GRPC_UNAUTHENTICATED     = 16;

func grpc_status_name:
    in(code: int)
    if code == 0 do out "OK"; end
    if code == 1 do out "CANCELLED"; end
    if code == 2 do out "UNKNOWN"; end
    if code == 3 do out "INVALID_ARGUMENT"; end
    if code == 4 do out "DEADLINE_EXCEEDED"; end
    if code == 5 do out "NOT_FOUND"; end
    if code == 12 do out "UNIMPLEMENTED"; end
    if code == 13 do out "INTERNAL"; end
    if code == 14 do out "UNAVAILABLE"; end
    out "UNKNOWN";
end
# ═══════════════════════════════════════════════════════
# gRPC wire format: Length-Prefixed-Message
# Compressed-Flag (1 byte) + Message-Length (4 bytes BE) + Message
# ═══════════════════════════════════════════════════════

entity GrpcMessage:
    compressed: bool,
        data:       string,
        data_len:   int;
end
func grpc_encode_message:
    in(data: string; data_len: int; compressed: bool)
    sb = sb_new();
    if compressed do
        sb_append_byte(sb, 1);
    else
        sb_append_byte(sb, 0);
    end
    # 4-byte big-endian length
    sb_append_byte(sb, (data_len / 16777216) & 255);
    sb_append_byte(sb, (data_len / 65536) & 255);
    sb_append_byte(sb, (data_len / 256) & 255);
    sb_append_byte(sb, data_len & 255);
    # Payload
    i = 0;
    when i < data_len loop
        sb_append_byte(sb, str_byte_at(data, i));
        i = i + 1;
    end
    result = sb_build(sb);
    sb_free(sb);
    out result;
end
func grpc_decode_message:
    in(data: string; pos: int)
    compressed = str_byte_at(data, pos) == 1;
    msg_len = str_byte_at(data, pos + 1) * 16777216
            + str_byte_at(data, pos + 2) * 65536
            + str_byte_at(data, pos + 3) * 256
            + str_byte_at(data, pos + 4);
    msg_data = str_slice(data, pos + 5, pos + 5 + msg_len);
    out GrpcMessage (
        compressed: compressed,
        data: msg_data,
        data_len: msg_len
    );
end
# ═══════════════════════════════════════════════════════
# Metadata (key-value headers)
# ═══════════════════════════════════════════════════════

entity GrpcMetadata:
    entries: Vec;    # Vec<GrpcMetaEntry>
end
entity GrpcMetaEntry:
    key:   string,
        value: string;
end
func grpc_metadata_new:
    in()
    out GrpcMetadata ( entries: vec_new() );
end
func grpc_metadata_add:
    in(md: GrpcMetadata; key: string; value: string)
    vec_push(md.entries, GrpcMetaEntry ( key: key, value: value ));
end
func grpc_metadata_get:
    in(md: GrpcMetadata; key: string)
    i = 0;
    when i < vec_len(md.entries) loop
        e = vec_get(md.entries, i);
        if str_eq(e.key, key) do
            out Some(e.value);
        end
        i = i + 1;
    end
    out None;
end
# ═══════════════════════════════════════════════════════
# Service definition
# ═══════════════════════════════════════════════════════

const GRPC_UNARY            = 0;
const GRPC_SERVER_STREAMING = 1;
const GRPC_CLIENT_STREAMING = 2;
const GRPC_BIDI_STREAMING   = 3;

entity GrpcMethod:
    name:         string;     # "/package.Service/MethodName"
    method_type:  int;        # GRPC_UNARY etc.
    handler:      func;       # request -> response
end
entity GrpcService:
    name:    string;          # "package.Service"
    methods: Vec;             # Vec<GrpcMethod>
end
func grpc_service_new:
    in(name: string)
    out GrpcService ( name: name, methods: vec_new() );
end
func grpc_service_add_method:
    in(svc: GrpcService; method_name: string; method_type: int; handler: func)
    path = "/" + svc.name + "/" + method_name;
    m = GrpcMethod ( name: path, method_type: method_type, handler: handler );
    vec_push(svc.methods, m);
end
func grpc_service_find_method:
    in(svc: GrpcService; path: string)
    i = 0;
    when i < vec_len(svc.methods) loop
        m = vec_get(svc.methods, i);
        if str_eq(m.name, path) do
            out Some(m);
        end
        i = i + 1;
    end
    out None;
end
# ═══════════════════════════════════════════════════════
# Request / Response
# ═══════════════════════════════════════════════════════

entity GrpcRequest:
    method:   string,
        metadata: GrpcMetadata,
        body:     string,
        body_len: int;
end
entity GrpcResponse:
    status:   int,
        message:  string,
        metadata: GrpcMetadata,
        body:     string,
        body_len: int;
end
func grpc_response_ok:
    in(body: string; body_len: int)
    out GrpcResponse (
        status: GRPC_OK, message: "",
        metadata: grpc_metadata_new(),
        body: body, body_len: body_len
    );
end
func grpc_response_error:
    in(code: int; message: string)
    out GrpcResponse (
        status: code, message: message,
        metadata: grpc_metadata_new(),
        body: "", body_len: 0
    );
end
# ═══════════════════════════════════════════════════════
# Required HTTP/2 headers for gRPC
# ═══════════════════════════════════════════════════════

func grpc_request_headers:
    in(method: string; authority: string)
    md = grpc_metadata_new();
    grpc_metadata_add(md, ":method", "POST");
    grpc_metadata_add(md, ":scheme", "https");
    grpc_metadata_add(md, ":path", method);
    grpc_metadata_add(md, ":authority", authority);
    grpc_metadata_add(md, "content-type", "application/grpc");
    grpc_metadata_add(md, "te", "trailers");
    out md;
end