##
 * vir/net/smtp.vri — SMTP Email Client
 * =====================================
 * Inspired by: RFC 5321 (SMTP), RFC 4954 (AUTH)
 *
 * SMTP command generation, response parsing,
 * MIME message construction, AUTH PLAIN/LOGIN.
 ##

include types;
include option;
import Option, Some, None from option;
include result;
import Result, Ok, Err from result;
include vec;
import Vec, vec_new, vec_push, vec_len, vec_get from vec;
include str;
import StringBuilder, sb_new, sb_append, sb_build, sb_free from str;
include encode;
import base64_encode from encode;

# ═══════════════════════════════════════════════════════
# SMTP reply codes
# ═══════════════════════════════════════════════════════

const SMTP_READY        = 220;
const SMTP_CLOSING      = 221;
const SMTP_AUTH_OK      = 235;
const SMTP_OK           = 250;
const SMTP_AUTH_CONT    = 334;
const SMTP_DATA_START   = 354;
const SMTP_ERR_SYNTAX   = 500;
const SMTP_ERR_AUTH     = 535;

# ═══════════════════════════════════════════════════════
# Entities
# ═══════════════════════════════════════════════════════

entity SmtpReply:
    code:    int;
    message: string;
end

entity EmailAddress:
    name:    string;
    address: string;
end

entity EmailMessage:
    from:        EmailAddress;
    to:          Vec;           # Vec<EmailAddress>
    cc:          Vec;
    subject:     string;
    body:        string;
    content_type: string;       # "text/plain", "text/html"
    headers:     Vec;           # Vec<string> extra headers
end

entity SmtpClient:
    host:      string;
    port:      int;
    use_tls:   bool;
    username:  string;
    password:  string;
end

# ═══════════════════════════════════════════════════════
# Reply parsing
# ═══════════════════════════════════════════════════════

func smtp_parse_reply:
    in(raw: string)
    if str_len(raw) < 3:
        out SmtpReply { code: 0, message: raw };
    end
    d1 = str_byte_at(raw, 0) - 48;
    d2 = str_byte_at(raw, 1) - 48;
    d3 = str_byte_at(raw, 2) - 48;
    code = d1 * 100 + d2 * 10 + d3;
    msg = "";
    if str_len(raw) > 4:
        msg = str_slice(raw, 4, str_len(raw));
    end
    out SmtpReply { code: code, message: msg };
end

func smtp_reply_ok:
    in(reply: SmtpReply)
    out reply.code >= 200 && reply.code < 400;
end

# ═══════════════════════════════════════════════════════
# SMTP command builders
# ═══════════════════════════════════════════════════════

func smtp_cmd_ehlo:
    in(domain: string)
    out "EHLO " + domain + "\r\n";
end

func smtp_cmd_helo:
    in(domain: string)
    out "HELO " + domain + "\r\n";
end

func smtp_cmd_mail_from:
    in(addr: string)
    out "MAIL FROM:<" + addr + ">\r\n";
end

func smtp_cmd_rcpt_to:
    in(addr: string)
    out "RCPT TO:<" + addr + ">\r\n";
end

func smtp_cmd_data:
    in()
    out "DATA\r\n";
end

func smtp_cmd_quit:
    in()
    out "QUIT\r\n";
end

func smtp_cmd_rset:
    in()
    out "RSET\r\n";
end

func smtp_cmd_noop:
    in()
    out "NOOP\r\n";
end

# ═══════════════════════════════════════════════════════
# AUTH commands
# ═══════════════════════════════════════════════════════

func smtp_cmd_auth_plain:
    in(username: string; password: string)
    # AUTH PLAIN: base64("\0username\0password")
    sb = sb_new();
    sb_append_byte(sb, 0);
    sb_append(sb, username);
    sb_append_byte(sb, 0);
    sb_append(sb, password);
    payload = sb_build(sb);
    encoded = base64_encode(payload);
    out "AUTH PLAIN " + encoded + "\r\n";
end

func smtp_cmd_auth_login:
    in()
    out "AUTH LOGIN\r\n";
end

# ═══════════════════════════════════════════════════════
# Email address formatting
# ═══════════════════════════════════════════════════════

func email_addr:
    in(name: string; address: string)
    out EmailAddress { name: name, address: address };
end

func email_addr_format:
    in(addr: EmailAddress)
    if str_len(addr.name) == 0:
        out addr.address;
    end
    out addr.name + " <" + addr.address + ">";
end

# ═══════════════════════════════════════════════════════
# MIME message construction
# ═══════════════════════════════════════════════════════

func email_new:
    in(from: EmailAddress; subject: string; body: string)
    out EmailMessage {
        from: from, to: vec_new(), cc: vec_new(),
        subject: subject, body: body,
        content_type: "text/plain; charset=UTF-8",
        headers: vec_new()
    };
end

func email_add_to:
    in(msg: EmailMessage; addr: EmailAddress)
    vec_push(msg.to, addr);
end

func email_add_cc:
    in(msg: EmailMessage; addr: EmailAddress)
    vec_push(msg.cc, addr);
end

func email_add_header:
    in(msg: EmailMessage; header: string)
    vec_push(msg.headers, header);
end

func email_render:
    in(msg: EmailMessage)
    sb = sb_new();
    sb_append(sb, "From: " + email_addr_format(msg.from) + "\r\n");
    # To
    i = 0;
    when i < vec_len(msg.to) loop
        sb_append(sb, "To: " + email_addr_format(vec_get(msg.to, i)) + "\r\n");
        i = i + 1;
    end
    # Cc
    i = 0;
    when i < vec_len(msg.cc) loop
        sb_append(sb, "Cc: " + email_addr_format(vec_get(msg.cc, i)) + "\r\n");
        i = i + 1;
    end
    sb_append(sb, "Subject: " + msg.subject + "\r\n");
    sb_append(sb, "MIME-Version: 1.0\r\n");
    sb_append(sb, "Content-Type: " + msg.content_type + "\r\n");
    # Extra headers
    i = 0;
    when i < vec_len(msg.headers) loop
        sb_append(sb, vec_get(msg.headers, i) + "\r\n");
        i = i + 1;
    end
    sb_append(sb, "\r\n");
    sb_append(sb, msg.body);
    sb_append(sb, "\r\n.\r\n");
    out sb_build(sb);
end

# ═══════════════════════════════════════════════════════
# High-level send sequence generator
# ═══════════════════════════════════════════════════════

func smtp_send_sequence:
    in(client: SmtpClient; msg: EmailMessage)
    cmds = vec_new();
    vec_push(cmds, smtp_cmd_ehlo(client.host));
    if str_len(client.username) > 0:
        vec_push(cmds, smtp_cmd_auth_plain(client.username, client.password));
    end
    vec_push(cmds, smtp_cmd_mail_from(msg.from.address));
    i = 0;
    when i < vec_len(msg.to) loop
        addr = vec_get(msg.to, i);
        vec_push(cmds, smtp_cmd_rcpt_to(addr.address));
        i = i + 1;
    end
    vec_push(cmds, smtp_cmd_data());
    vec_push(cmds, email_render(msg));
    vec_push(cmds, smtp_cmd_quit());
    out cmds;
end
