# Module: protocol/http2_frame
# HTTP/2 binary framing foundation and stream state machine.

enum H2FrameType:
    Data
    Headers
    Priority
    RstStream
    Settings
    PushPromise
    Ping
    GoAway
    WindowUpdate
    Continuation
end.

enum H2StreamState:
    Idle
    Reserved
    Open
    HalfClosedLocal
    HalfClosedRemote
    Closed
end.

entity H2FrameHeader:
    length: int
    frame_type: H2FrameType
    flags: int
    stream_id: int
end.

func h2_frame_header_new(length: int, ftype: H2FrameType, flags: int, stream_id: int) -> H2FrameHeader:
    out H2FrameHeader(
        length: length,
        frame_type: ftype,
        flags: flags,
        stream_id: stream_id
    )
end.

func is_end_stream(flags: int) -> bool:
    if (flags and 1) != 0 do
        out true
    end
    out false
end.

func is_end_headers(flags: int) -> bool:
    if (flags and 4) != 0 do
        out true
    end
    out false
end.

func is_ack(flags: int) -> bool:
    if (flags and 1) != 0 do
        out true
    end
    out false
end.

func is_padded(flags: int) -> bool:
    if (flags and 8) != 0 do
        out true
    end
    out false
end.

func is_priority(flags: int) -> bool:
    if (flags and 32) != 0 do
        out true
    end
    out false
end.

enum H2ErrorCode:
    NoError
    ProtocolError
    InternalError
    FlowControlError
    SettingsTimeout
    StreamClosed
    FrameSizeError
    RefusedStream
    Cancel
    CompressionError
    ConnectError
    EnhanceYourCalm
    InadequateSecurity
    Http11Required
end.

func h2_error_name(code: int) -> string:
    if code == 0 do
        out "NO_ERROR"
    end
    if code == 1 do
        out "PROTOCOL_ERROR"
    end
    if code == 2 do
        out "INTERNAL_ERROR"
    end
    if code == 3 do
        out "FLOW_CONTROL_ERROR"
    end
    if code == 4 do
        out "SETTINGS_TIMEOUT"
    end
    if code == 5 do
        out "STREAM_CLOSED"
    end
    if code == 6 do
        out "FRAME_SIZE_ERROR"
    end
    if code == 7 do
        out "REFUSED_STREAM"
    end
    if code == 8 do
        out "CANCEL"
    end
    if code == 9 do
        out "COMPRESSION_ERROR"
    end
    if code == 10 do
        out "CONNECT_ERROR"
    end
    if code == 11 do
        out "ENHANCE_YOUR_CALM"
    end
    if code == 12 do
        out "INADEQUATE_SECURITY"
    end
    if code == 13 do
        out "HTTP_1_1_REQUIRED"
    end
    out "UNKNOWN_ERROR"
end.

enum H2SettingsParam:
    HeaderTableSize
    EnablePush
    MaxConcurrentStreams
    InitialWindowSize
    MaxFrameSize
    MaxHeaderListSize
end.
