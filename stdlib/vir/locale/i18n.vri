##
 * vir/locale/i18n.vri — Internationalization Framework
 * ======================================================
 * Inspired by: ICU MessageFormat, i18next, gettext
 *
 * Message catalog, string interpolation with (key) placeholders,
 * plural rules, locale bundle loading, fallback chains.
 ##

include types;
include option;
import Option, Some, None from option;
include vec;
import Vec, vec_new, vec_push, vec_len, vec_get from vec;
include str;
import StringBuilder, sb_new, sb_append, sb_append_byte, sb_build, sb_free from str;
include map;
import Map, map_new, map_insert, map_get, map_contains from map;

# ═══════════════════════════════════════════════════════
# Message catalog
# ═══════════════════════════════════════════════════════

entity I18nBundle:
    locale:   string;       # "en-US", "vi-VN"
    messages: Map;          # Map<string, string>
end.
entity I18nManager:
    bundles:     Vec;       # Vec<I18nBundle>
    fallback:    string;    # fallback locale, e.g. "en"
    current:     string;    # current locale
end.

# ═══════════════════════════════════════════════════════
# Constructor
# ═══════════════════════════════════════════════════════

func i18n_new(fallback: string):
    out I18nManager (
        bundles: vec_new(),
        fallback: fallback,
        current: fallback
    );
end.
func i18n_bundle(locale: string):
    out I18nBundle ( locale: locale, messages: map_new() );
end.
# ═══════════════════════════════════════════════════════
# Bundle management
# ═══════════════════════════════════════════════════════

func i18n_add_message:
    in  bundle: I18nBundle;
        key: string;
        value: string
    map_insert(bundle.messages, key, value);
end.
func i18n_register_bundle(mgr: I18nManager, bundle: I18nBundle):
    vec_push(mgr.bundles, bundle);
end.
func i18n_set_locale(mgr: I18nManager, locale: string):
    mgr.current = locale;
end.
# ═══════════════════════════════════════════════════════
# Bundle lookup with fallback
# ═══════════════════════════════════════════════════════

func _i18n_find_bundle(mgr: I18nManager, locale: string):
    i = 0;
    when i < vec_len(mgr.bundles) loop
        b = vec_get(mgr.bundles, i);
        if b.locale == locale do
            out Some(b);
        end
        i = i + 1;
    end
    out None;
end.
func _i18n_base_locale(locale: string):
    # "en-US" → "en"
    i = 0;
    when i < str_len(locale) loop
        if str_byte_at(locale, i) == 45 do # '-'
            out str_slice(locale, 0, i);
        end
        i = i + 1;
    end
    out locale;
end.
func i18n_get(mgr: I18nManager, key: string):
    # Try current locale
    bundle = _i18n_find_bundle(mgr, mgr.current);
    if is_some(bundle) do
        b = unwrap(bundle);
        msg = map_get(b.messages, key);
        if is_some(msg) do
            out unwrap(msg);
        end
    end
    # Try base locale
    base = _i18n_base_locale(mgr.current);
    if base != mgr.current do
        bundle = _i18n_find_bundle(mgr, base);
        if is_some(bundle) do
            b = unwrap(bundle);
            msg = map_get(b.messages, key);
            if is_some(msg) do
                out unwrap(msg);
            end
        end
    end
    # Try fallback
    if mgr.fallback != mgr.current do
        bundle = _i18n_find_bundle(mgr, mgr.fallback);
        if is_some(bundle) do
            b = unwrap(bundle);
            msg = map_get(b.messages, key);
            if is_some(msg) do
                out unwrap(msg);
            end
        end
    end
    # Key not found — return key itself
    out key;
end.
# ═══════════════════════════════════════════════════════
# String interpolation: "Hello {name}!" + params
# ═══════════════════════════════════════════════════════

func i18n_format(template: string, params: Map):
    sb = sb_new();
    n = str_len(template);
    i = 0;
    when i < n loop
        ch = str_byte_at(template, i);
        if ch == 123 do # '{'
            # Find closing '}'
            j = i + 1;
            when j < n && str_byte_at(template, j) != 125 loop
                j = j + 1;
            end
            key = str_slice(template, i + 1, j);
            val = map_get(params, key);
            if is_some(val) do
                sb_append(sb, unwrap(val));
            else
                sb_append(sb, "{" + key + "}");
            end
            i = j + 1;
        else
            sb_append_byte(sb, ch);
            i = i + 1;
        end
    end
    out sb_build(sb);
end.
func i18n_t:
    in  mgr: I18nManager;
        key: string;
        params: Map
    template = i18n_get(mgr, key);
    out i18n_format(template, params);
end.
# ═══════════════════════════════════════════════════════
# Plural rules (simplified CLDR categories)
# ═══════════════════════════════════════════════════════

const PLURAL_ZERO  = 0;
const PLURAL_ONE   = 1;
const PLURAL_TWO   = 2;
const PLURAL_FEW   = 3;
const PLURAL_MANY  = 4;
const PLURAL_OTHER = 5;

func plural_category_en(n: int):
    if n == 1 do
        out PLURAL_ONE;
    end
    out PLURAL_OTHER;
end.
func plural_category_vi(n: int):
    # Vietnamese: no grammatical plural
    out PLURAL_OTHER;
end.
func plural_category_zh(n: int):
    out PLURAL_OTHER;
end.
func plural_category_ru(n: int):
    mod10 = n % 10;
    mod100 = n % 100;
    if mod10 == 1 && mod100 != 11 do
        out PLURAL_ONE;
    end
    if mod10 >= 2 && mod10 <= 4 && (mod100 < 12 || mod100 > 14) do
        out PLURAL_FEW;
    end
    out PLURAL_MANY;
end.
# ═══════════════════════════════════════════════════════
# Plural message selection
# ═══════════════════════════════════════════════════════

func i18n_plural:
    in  mgr: I18nManager;
        key_base: string;
        n: int
    # Look up key_base.one, key_base.other, etc.
    cat = plural_category_en(n);  # simplified — use current locale
    suffix = ".other";
    if cat == PLURAL_ONE do
        suffix = ".one";
    eif cat == PLURAL_FEW do
        suffix = ".few";
    eif cat == PLURAL_MANY do
        suffix = ".many";
    eif cat == PLURAL_ZERO do
        suffix = ".zero";
    end
    msg = i18n_get(mgr, key_base + suffix);
    if msg == key_base + suffix do
        # Fall back to .other
        msg = i18n_get(mgr, key_base + ".other");
    end
    out msg;
end.