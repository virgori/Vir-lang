##
 * vir/locale/locale.vri — Locale-Aware Formatting
 * ==================================================
 * Inspired by: ICU, CLDR, Rust unic-locale
 *
 * Locale parsing (BCP 47), number formatting (digit grouping,
 * decimal separator), date formatting, currency formatting.
 ##

include types;
include option;
import Option, Some, None from option;
include vec;
import Vec, vec_new, vec_push, vec_len, vec_get from vec;
include str;
import StringBuilder, sb_new, sb_append, sb_append_byte, sb_build, sb_free from str;
include map;
import Map, map_new, map_insert, map_get from map;

# ═══════════════════════════════════════════════════════
# Locale entity
# ═══════════════════════════════════════════════════════

entity Locale:
    language:       string;   # "en", "vi", "zh"
    region:         string;   # "US", "VN", "CN"
    script:         string;   # "Latn", "Hant"
    decimal_sep:    string;   # "." or ","
    group_sep:      string;   # "," or "."
    group_size:     int;      # 3 typically
    currency_sym:   string;   # "$", "₫", "¥"
    currency_code:  string;   # "USD", "VND"
    date_format:    string;   # "MM/DD/YYYY", "DD/MM/YYYY"
    time_format:    string;   # "h:mm A", "HH:mm"
end.

# ═══════════════════════════════════════════════════════
# Predefined locales
# ═══════════════════════════════════════════════════════

func locale_en_us():
    out Locale (
        language: "en", region: "US", script: "Latn",
        decimal_sep: ".", group_sep: ",", group_size: 3,
        currency_sym: "$", currency_code: "USD",
        date_format: "MM/DD/YYYY", time_format: "h:mm A"
    );
end.
func locale_vi_vn():
    out Locale (
        language: "vi", region: "VN", script: "Latn",
        decimal_sep: ",", group_sep: ".", group_size: 3,
        currency_sym: "₫", currency_code: "VND",
        date_format: "DD/MM/YYYY", time_format: "HH:mm"
    );
end.
