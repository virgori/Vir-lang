        date_format: "DD/MM/YYYY", time_format: "HH:mm"
    );
end.
# ═══════════════════════════════════════════════════════
# BCP 47 locale tag parsing
# ═══════════════════════════════════════════════════════

func locale_parse(tag: string):
    # Parse "en-US", "vi-VN", "zh-Hant-TW"
    parts = _locale_split(tag, 45);  # split on '-'
    lang = "";
    region = "";
    script = "";
    if vec_len(parts) >= 1 do
        lang = vec_get(parts, 0);
    end
    if vec_len(parts) >= 2 do
        p1 = vec_get(parts, 1);
        if str_len(p1) == 4 do
            script = p1;
            if vec_len(parts) >= 3 do
                region = vec_get(parts, 2);
            end
        else
            region = p1;
        end
    end
    out Locale (
        language: lang, region: region, script: script,
        decimal_sep: ".", group_sep: ",", group_size: 3,
        currency_sym: "$", currency_code: "USD",
        date_format: "YYYY-MM-DD", time_format: "HH:mm"
    );
end.
func _locale_split(s: string, sep: int):
    parts = vec_new();
    start = 0;
    i = 0;
    n = str_len(s);
    when i < n loop
        if str_byte_at(s, i) == sep do
            vec_push(parts, str_slice(s, start, i));
            start = i + 1;
        end
        i = i + 1;
    end
    if start <= n do
        vec_push(parts, str_slice(s, start, n));
    end
    out parts;
end.
# ═══════════════════════════════════════════════════════
# Number formatting
# ═══════════════════════════════════════════════════════

func locale_format_int(loc: Locale, value: int):
    negative = false;
    v = value;
    if v < 0 do
        negative = true;
        v = 0 - v;
    end
    s = int_to_str(v);
    n = str_len(s);
    if n <= loc.group_size do
        if negative do
            out "-" + s;
        end
        out s;
    end
    sb = sb_new();
    digits_written = 0;
    i = n - 1;
    when i >= 0 loop
        if digits_written > 0 && digits_written % loc.group_size == 0 do
            # Insert group separator (write reversed later)
            sb_append(sb, loc.group_sep);
        end
        sb_append_byte(sb, str_byte_at(s, i));
        digits_written = digits_written + 1;
        i = i - 1;
    end
    # Reverse the result
    built = sb_build(sb);
    sb2 = sb_new();
    if negative do
        sb_append(sb2, "-");
    end
    j = str_len(built) - 1;
    when j >= 0 loop
        sb_append_byte(sb2, str_byte_at(built, j));
        j = j - 1;
    end
    out sb_build(sb2);
end.
func locale_format_currency:
    in  loc: Locale;
        value: int;
        decimals: int
    int_part = locale_format_int(loc, value / 100);
    frac = value % 100;
    if frac < 0 do
        frac = 0 - frac;
    end
    frac_str = int_to_str(frac);
    if frac < 10 do
        frac_str = "0" + frac_str;
    end
    out loc.currency_sym + int_part + loc.decimal_sep + frac_str;
end.
# ═══════════════════════════════════════════════════════
# Date formatting with locale
# ═══════════════════════════════════════════════════════

func locale_format_date:
    in  loc: Locale;
        year: int;
        month: int;
        day: int
    y = int_to_str(year);
    m = int_to_str(month);
    if month < 10 do
        m = "0" + m;
    end
    d = int_to_str(day);
    if day < 10 do
        d = "0" + d;
    end
    fmt = loc.date_format;
    if fmt == "MM/DD/YYYY" do
        out m + "/" + d + "/" + y;
    end
    if fmt == "DD/MM/YYYY" do
        out d + "/" + m + "/" + y;
    end
    if fmt == "DD.MM.YYYY" do
        out d + "." + m + "." + y;
    end
    if fmt == "YYYY/MM/DD" do
        out y + "/" + m + "/" + d;
    end
    # Default ISO
    out y + "-" + m + "-" + d;
end.
# ═══════════════════════════════════════════════════════
# Locale tag generation
# ═══════════════════════════════════════════════════════

func locale_to_tag(loc: Locale):
    tag = loc.language;
    if str_len(loc.script) > 0 do
        tag = tag + "-" + loc.script;
    end
    if str_len(loc.region) > 0 do
        tag = tag + "-" + loc.region;
    end
    out tag;
end.