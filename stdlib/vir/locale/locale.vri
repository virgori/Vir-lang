    out Locale (
        language: "zh", region: "CN", script: "Hans",
        decimal_sep: ".", group_sep: ",", group_size: 3,
        currency_sym: "¥", currency_code: "CNY",
        date_format: "YYYY-MM-DD", time_format: "HH:mm"
    );
end.
