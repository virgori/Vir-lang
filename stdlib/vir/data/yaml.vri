##
 * vir/data/yaml.vri — YAML Specification Disclaimer (NOT IMPLEMENTED)
 * ====================================================================
 * Architectural Rationale:
 *   YAML 1.2 is an excessively complex specification with massive attack
 *   surface (uncontrolled recursion, arbitrary code execution, ambiguous
 *   implicit typing) that contradicts Vir's strict, memory-safe, libc-free
 *   standard library principles.
 *
 *   Recommended alternatives:
 *     - For config: std.data.toml (vir.data.toml)
 *     - For data:   std.data.json (vir.data.json)
 *     - For simple: std.data.ini (vir.data.ini)
 ##

include types
include result
include vir.data.error

func yaml_parse(text: string):
    out Err(parse_error_new(0, 1, 1, "YAML parser: NOT IMPLEMENTED (complexity and security attack surface; use vir.data.toml or vir.data.json)"))
end.

export yaml_parse
