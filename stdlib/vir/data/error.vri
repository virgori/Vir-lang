##
 * vir/data/error.vri — Standard Parse Error Representation
 * ========================================================
 * Standard error type for all data format parsers (JSON, CSV, TOML, INI, XML).
 ##

include types

entity ParseError:
    offset:  int,
    line:    int,
    column:  int,
    message: string
end.

func parse_error_new(offset: int, line: int, col: int, msg: string):
    out ParseError ( offset: offset, line: line, column: col, message: msg )
end.

export ParseError, parse_error_new
