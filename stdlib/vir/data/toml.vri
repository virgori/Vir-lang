##
 * vir/data/toml.vri — Strict TOML v1.0.0 Subset Parser & Serializer (Pure Vir, Zero Libc)
 * ======================================================================================
 * Supported:
 *   - Key-value pairs: key = "string", key = 123, key = true, key = false
 *   - Sections / Tables: [server], [database.replica]
 *   - Dotted keys: server.host = "localhost"
 *   - Comments: # comment
 *   - Basic string escapes (\\, \", \n, \t)
 *   - Rejection of syntax errors: missing values, unclosed strings, invalid table headers
 *   - Serialization back to canonical TOML
 ##

include types
include option
import Option, Some, None from option
include result
include alloc
import vir_alloc, vir_free, vir_realloc from alloc
include vec_rt
import vec_new_rt, vec_push_rt, vec_get_rt, vec_len_rt from vec_rt
include vir.data.error

extern func native_read_u8(addr: int, offset: int) -> int
extern func native_write_u8(addr: int, offset: int, val: int)
extern func native_read_i64(addr: int, offset: int) -> int
extern func native_write_i64(addr: int, offset: int, val: int)

enum TomlType:
    NoneType = 0
    Bool     = 1
    Integer  = 2
    Str      = 3
    Table    = 4
end.

entity TomlValue:
    tag: int,
    int_val: int,
    str_val: string,
    keys: int,
    vals: int
end.

func toml_none() -> TomlValue:
    out TomlValue ( tag: TomlType.NoneType, int_val: 0, str_val: "", keys: 0, vals: 0 )
end.

func toml_bool(b: int) -> TomlValue:
    var n = 0
    if b != 0 do n = 1 end
    out TomlValue ( tag: TomlType.Bool, int_val: n, str_val: "", keys: 0, vals: 0 )
end.

func toml_int(n: int) -> TomlValue:
    out TomlValue ( tag: TomlType.Integer, int_val: n, str_val: "", keys: 0, vals: 0 )
end.

func toml_str(s: string) -> TomlValue:
    out TomlValue ( tag: TomlType.Str, int_val: 0, str_val: s, keys: 0, vals: 0 )
end.

func toml_table() -> TomlValue:
    let k = vec_new_rt()
    let v = vec_new_rt()
    out TomlValue ( tag: TomlType.Table, int_val: 0, str_val: "", keys: k, vals: v )
end.

func toml_get_tag(v: TomlValue) -> int:
    out v.tag
end.

func toml_get_int(v: TomlValue) -> int:
    out v.int_val
end.

func toml_get_str(v: TomlValue) -> string:
    out v.str_val
end.

func toml_str_len(p: int) -> int:
    if p == 0 do out 0 end
    var i = 0
    when native_read_u8(p, i) != 0 loop
        i = i + 1
    end
    out i
end.

func toml_str_eq(a: string, b: string) -> bool:
    let pa = a as int
    let pb = b as int
    if pa == pb do out true end
    if pa == 0 or pb == 0 do out false end
    var i = 0
    loop
        let ca = native_read_u8(pa, i)
        let cb = native_read_u8(pb, i)
        if ca != cb do out false end
        if ca == 0 do out true end
        i = i + 1
    end
    out true
end.

# Table Operations
func toml_table_len(table: TomlValue) -> int:
    if table.tag == TomlType.Table and table.keys != 0 do
        out vec_len_rt(table.keys)
    end
    out 0
end.

func toml_table_key(table: TomlValue, idx: int) -> string:
    if table.tag == TomlType.Table and table.keys != 0 do
        if idx >= 0 and idx < vec_len_rt(table.keys) do
            let k = vec_get_rt(table.keys, idx)
            out k as string
        end
    end
    out ""
end.

func toml_table_val(table: TomlValue, idx: int) -> TomlValue:
    if table.tag == TomlType.Table and table.vals != 0 do
        if idx >= 0 and idx < vec_len_rt(table.vals) do
            let ptr = vec_get_rt(table.vals, idx)
            out TomlValue (
                tag: native_read_i64(ptr, 0),
                int_val: native_read_i64(ptr, 8),
                str_val: native_read_i64(ptr, 16) as string,
                keys: native_read_i64(ptr, 24),
                vals: native_read_i64(ptr, 32)
            )
        end
    end
    out toml_none()
end.

func toml_table_get(table: TomlValue, key: string) -> Option<TomlValue>:
    if table.tag == TomlType.Table and table.keys != 0 do
        let count = vec_len_rt(table.keys)
        var i = 0
        when i < count loop
            let k = vec_get_rt(table.keys, i) as string
            if toml_str_eq(k, key) do
                let ptr = vec_get_rt(table.vals, i)
                let tv = TomlValue (
                    tag: native_read_i64(ptr, 0),
                    int_val: native_read_i64(ptr, 8),
                    str_val: native_read_i64(ptr, 16) as string,
                    keys: native_read_i64(ptr, 24),
                    vals: native_read_i64(ptr, 32)
                )
                out Some(tv)
            end
            i = i + 1
        end
    end
    out None
end.

func toml_table_set(table: TomlValue, key: string, val: TomlValue):
    if table.tag == TomlType.Table and table.keys != 0 do
        let ptr = vir_alloc(40)
        native_write_i64(ptr, 0, val.tag)
        native_write_i64(ptr, 8, val.int_val)
        native_write_i64(ptr, 16, val.str_val as int)
        native_write_i64(ptr, 24, val.keys)
        native_write_i64(ptr, 32, val.vals)

        let count = vec_len_rt(table.keys)
        var i = 0
        when i < count loop
            let k = vec_get_rt(table.keys, i) as string
            if toml_str_eq(k, key) do
                table.vals = vec_set_rt(table.vals, i, ptr)
                out
            end
            i = i + 1
        end

        table.keys = vec_push_rt(table.keys, key as int)
        table.vals = vec_push_rt(table.vals, ptr)
    end
end.

# ═══════════════════════════════════════════════════════
# TOML Parser Implementation
# ═══════════════════════════════════════════════════════

entity TomlParser:
    src: int,
    len: int,
    pos: int,
    line: int,
    col: int,
    err_msg: string,
    err_pos: int
end.

func toml_skip_inline_ws(p: TomlParser):
    when p.pos < p.len loop
        let ch = native_read_u8(p.src, p.pos)
        if ch == 32 or ch == 9 do
            p.pos = p.pos + 1
            p.col = p.col + 1
        else
            out
        end
    end
end.

func toml_skip_comment(p: TomlParser):
    if p.pos < p.len and native_read_u8(p.src, p.pos) == 35 do # "#"
        when p.pos < p.len loop
            let ch = native_read_u8(p.src, p.pos)
            if ch == 10 or ch == 13 do
                out
            end
            p.pos = p.pos + 1
            p.col = p.col + 1
        end
    end
end.

func toml_parse_bare_key(p: TomlParser) -> string:
    let start = p.pos
    when p.pos < p.len loop
        let ch = native_read_u8(p.src, p.pos)
        if (ch >= 65 and ch <= 90) or (ch >= 97 and ch <= 122) or (ch >= 48 and ch <= 57) or ch == 95 or ch == 45 do
            p.pos = p.pos + 1
            p.col = p.col + 1
        else
            break
        end
    end
    let klen = p.pos - start
    if klen == 0 do out "" end
    let buf = vir_alloc(klen + 1)
    var i = 0
    when i < klen loop
        native_write_u8(buf, i, native_read_u8(p.src, start + i))
        i = i + 1
    end
    native_write_u8(buf, klen, 0)
    out buf as string
end.

func toml_parse_string(p: TomlParser) -> string:
    p.pos = p.pos + 1 # skip opening "
    p.col = p.col + 1
    var cap = 64
    var buf = vir_alloc(cap)
    var out_len = 0

    when p.pos < p.len loop
        let ch = native_read_u8(p.src, p.pos)
        if ch == 34 do # closing "
            p.pos = p.pos + 1
            p.col = p.col + 1
            native_write_u8(buf, out_len, 0)
            out buf as string
        end
        if ch == 10 or ch == 13 do
            p.err_msg = "newline in basic string is forbidden"
            p.err_pos = p.pos
            out ""
        end
        if ch == 92 do # backslash
            p.pos = p.pos + 1
            p.col = p.col + 1
            if p.pos >= p.len do
                p.err_msg = "unterminated string escape"
                p.err_pos = p.pos
                out ""
            end
            let esc = native_read_u8(p.src, p.pos)
            p.pos = p.pos + 1
            p.col = p.col + 1
            var b = esc
            if esc == 110 do b = 10;
            eif esc == 116 do b = 9;
            eif esc == 114 do b = 13;
            eif esc == 34 do b = 34;
            eif esc == 92 do b = 92;
            end
            if out_len + 1 >= cap do
                cap = cap * 2
                buf = vir_realloc(buf, cap)
            end
            native_write_u8(buf, out_len, b)
            out_len = out_len + 1
        else
            p.pos = p.pos + 1
            p.col = p.col + 1
            if out_len + 1 >= cap do
                cap = cap * 2
                buf = vir_realloc(buf, cap)
            end
            native_write_u8(buf, out_len, ch)
            out_len = out_len + 1
        end
    end

    p.err_msg = "unterminated string"
    p.err_pos = p.pos
    out ""
end.

func toml_parse_number(p: TomlParser) -> TomlValue:
    let start = p.pos
    var is_neg = 0
    if native_read_u8(p.src, p.pos) == 45 do
        is_neg = 1
        p.pos = p.pos + 1
        p.col = p.col + 1
    end
    var val = 0
    when p.pos < p.len loop
        let ch = native_read_u8(p.src, p.pos)
        if ch >= 48 and ch <= 57 do
            val = (val * 10) + (ch - 48)
            p.pos = p.pos + 1
            p.col = p.col + 1
        eif ch == 95 do # underscore in number
            p.pos = p.pos + 1
            p.col = p.col + 1
        else
            break
        end
    end
    if is_neg == 1 do val = -val end
    out toml_int(val)
end.

func toml_parse(text: string):
    let src = text as int
    if src == 0 do
        out Ok(toml_table())
    end
    let slen = toml_str_len(src)
    let p = TomlParser (
        src: src,
        len: slen,
        pos: 0,
        line: 1,
        col: 1,
        err_msg: "",
        err_pos: 0
    )

    let root = toml_table()
    let cur_table_box = vir_alloc(8)
    native_write_i64(cur_table_box, 0, root as int)

    when p.pos < p.len loop
        toml_skip_inline_ws(p)
        if p.pos >= p.len do out Ok(root) end

        let ch = native_read_u8(p.src, p.pos)

        # 1. Newlines
        if ch == 10 do
            p.pos = p.pos + 1
            p.line = p.line + 1
            p.col = 1
        eif ch == 13 do
            p.pos = p.pos + 1
            if p.pos < p.len and native_read_u8(p.src, p.pos) == 10 do
                p.pos = p.pos + 1
            end
            p.line = p.line + 1
            p.col = 1

        # 2. Comment
        eif ch == 35 do # "#"
            toml_skip_comment(p)

        # 3. Table Header: [section] or [section.sub]
        eif ch == 91 do # "["
            p.pos = p.pos + 1
            p.col = p.col + 1
            toml_skip_inline_ws(p)

            # Build or find nested table
            native_write_i64(cur_table_box, 0, root as int)
            loop
                let seg = toml_parse_bare_key(p)
                if toml_str_len(seg as int) == 0 do
                    out Err(parse_error_new(p.pos, p.line, p.col, "empty or invalid table header"))
                end
                toml_skip_inline_ws(p)
                let parent_ptr = native_read_i64(cur_table_box, 0)
                let parent_tbl = parent_ptr as TomlValue
                let opt_sub = toml_table_get(parent_tbl, seg)
                case opt_sub
                    Some(existing):
                        if toml_get_tag(existing) == TomlType.Table do
                            native_write_i64(cur_table_box, 0, existing as int)
                        else
                            out Err(parse_error_new(p.pos, p.line, p.col, "table name conflicts with existing non-table key"))
                        end
                    None:
                        let new_sub = toml_table()
                        toml_table_set(parent_tbl, seg, new_sub)
                        native_write_i64(cur_table_box, 0, new_sub as int)
                end

                if p.pos < p.len and native_read_u8(p.src, p.pos) == 46 do # "."
                    p.pos = p.pos + 1
                    p.col = p.col + 1
                    toml_skip_inline_ws(p)
                else
                    break
                end
            end

            if p.pos >= p.len or native_read_u8(p.src, p.pos) != 93 do # "]"
                out Err(parse_error_new(p.pos, p.line, p.col, "expected closing ] in table header"))
            end
            p.pos = p.pos + 1
            p.col = p.col + 1
            toml_skip_inline_ws(p)
            toml_skip_comment(p)

        # 4. Key-value pair
        else
            var key = ""
            if ch == 34 do
                key = toml_parse_string(p)
            else
                key = toml_parse_bare_key(p)
            end
            if toml_str_len(key as int) == 0 do
                out Err(parse_error_new(p.pos, p.line, p.col, "expected key name"))
            end

            # Check for dotted key: server.port
            let target_box = vir_alloc(8)
            native_write_i64(target_box, 0, native_read_i64(cur_table_box, 0))
            loop
                if p.pos < p.len and native_read_u8(p.src, p.pos) == 46 do # "."
                    p.pos = p.pos + 1
                    p.col = p.col + 1
                    toml_skip_inline_ws(p)
                    let parent_ptr = native_read_i64(target_box, 0)
                    let parent_tbl = parent_ptr as TomlValue
                    let opt_sub = toml_table_get(parent_tbl, key)
                    case opt_sub
                        Some(sub):
                            if toml_get_tag(sub) == TomlType.Table do
                                native_write_i64(target_box, 0, sub as int)
                            end
                        None:
                            let new_sub = toml_table()
                            toml_table_set(parent_tbl, key, new_sub)
                            native_write_i64(target_box, 0, new_sub as int)
                    end
                    key = toml_parse_bare_key(p)
                    if toml_str_len(key as int) == 0 do
                        out Err(parse_error_new(p.pos, p.line, p.col, "expected dotted key part"))
                    end
                else
                    break
                end
            end

            toml_skip_inline_ws(p)
            if p.pos >= p.len or native_read_u8(p.src, p.pos) != 61 do # "="
                out Err(parse_error_new(p.pos, p.line, p.col, "expected = after key"))
            end
            p.pos = p.pos + 1
            p.col = p.col + 1
            toml_skip_inline_ws(p)

            # Parse Value
            if p.pos >= p.len do
                out Err(parse_error_new(p.pos, p.line, p.col, "unexpected end of file after ="))
            end

            let val_ch = native_read_u8(p.src, p.pos)
            var val = toml_none()

            # String
            if val_ch == 34 do
                let s = toml_parse_string(p)
                if toml_str_len(p.err_msg as int) > 0 do
                    out Err(parse_error_new(p.err_pos, p.line, p.col, p.err_msg))
                end
                val = toml_str(s)

            # Boolean true
            eif val_ch == 116 do # "t"
                if p.pos + 4 <= p.len and
                   native_read_u8(p.src, p.pos + 1) == 114 and
                   native_read_u8(p.src, p.pos + 2) == 117 and
                   native_read_u8(p.src, p.pos + 3) == 101 do
                    p.pos = p.pos + 4
                    p.col = p.col + 4
                    val = toml_bool(1)
                else
                    out Err(parse_error_new(p.pos, p.line, p.col, "invalid literal value"))
                end

            # Boolean false
            eif val_ch == 102 do # "f"
                if p.pos + 5 <= p.len and
                   native_read_u8(p.src, p.pos + 1) == 97 and
                   native_read_u8(p.src, p.pos + 2) == 108 and
                   native_read_u8(p.src, p.pos + 3) == 115 and
                   native_read_u8(p.src, p.pos + 4) == 101 do
                    p.pos = p.pos + 5
                    p.col = p.col + 5
                    val = toml_bool(0)
                else
                    out Err(parse_error_new(p.pos, p.line, p.col, "invalid literal value"))
                end

            # Integer
            eif val_ch == 45 or (val_ch >= 48 and val_ch <= 57) do
                val = toml_parse_number(p)

            else
                out Err(parse_error_new(p.pos, p.line, p.col, "unsupported or invalid TOML value"))
            end

            let target_ptr = native_read_i64(target_box, 0)
            let target_tbl = target_ptr as TomlValue
            toml_table_set(target_tbl, key, val)

            toml_skip_inline_ws(p)
            toml_skip_comment(p)
        end
    end

    out Ok(root)
end.

# ═══════════════════════════════════════════════════════
# TOML Serializer Implementation
# ═══════════════════════════════════════════════════════

entity TomlBuf:
    data: int,
    len: int,
    cap: int
end.

func tb_new() -> TomlBuf:
    let cap = 128
    let buf = vir_alloc(cap)
    out TomlBuf ( data: buf, len: 0, cap: cap )
end.

func tb_append_byte(tb: TomlBuf, b: int):
    if tb.len + 1 >= tb.cap do
        tb.cap = tb.cap * 2
        tb.data = vir_realloc(tb.data, tb.cap)
    end
    native_write_u8(tb.data, tb.len, b)
    tb.len = tb.len + 1
end.

func tb_append_str(tb: TomlBuf, s_ptr: int):
    if s_ptr == 0 do out end
    let slen = toml_str_len(s_ptr)
    var i = 0
    when i < slen loop
        tb_append_byte(tb, native_read_u8(s_ptr, i))
        i = i + 1
    end
end.

func tb_append_int(tb: TomlBuf, n: int):
    if n == 0 do
        tb_append_byte(tb, 48)
        out
    end
    var num = n
    if num < 0 do
        tb_append_byte(tb, 45) # "-"
        num = -num
    end
    var rev_buf = vir_alloc(32)
    var digits = 0
    when num > 0 loop
        let d = num mod 10
        native_write_u8(rev_buf, digits, 48 + d)
        digits = digits + 1
        num = num / 10
    end
    var i = digits - 1
    when i >= 0 loop
        tb_append_byte(tb, native_read_u8(rev_buf, i))
        i = i - 1
    end
    vir_free(rev_buf)
end.

func tb_serialize_table(tb: TomlBuf, table: TomlValue, prefix: string):
    let count = toml_table_len(table)
    # First pass: write primitives
    var idx = 0
    when idx < count loop
        let k = toml_table_key(table, idx)
        let v = toml_table_val(table, idx)
        if v.tag != TomlType.Table do
            tb_append_str(tb, k as int)
            tb_append_str(tb, " = " as int)
            if v.tag == TomlType.Bool do
                if v.int_val != 0 do
                    tb_append_str(tb, "true" as int)
                else
                    tb_append_str(tb, "false" as int)
                end
            eif v.tag == TomlType.Integer do
                tb_append_int(tb, v.int_val)
            eif v.tag == TomlType.Str do
                tb_append_byte(tb, 34)
                tb_append_str(tb, v.str_val as int)
                tb_append_byte(tb, 34)
            end
            tb_append_byte(tb, 10)
        end
        idx = idx + 1
    end

    # Second pass: write tables
    idx = 0
    when idx < count loop
        let k = toml_table_key(table, idx)
        let v = toml_table_val(table, idx)
        if v.tag == TomlType.Table do
            tb_append_byte(tb, 10)
            tb_append_byte(tb, 91) # "["
            if toml_str_len(prefix as int) > 0 do
                tb_append_str(tb, prefix as int)
                tb_append_byte(tb, 46) # "."
            end
            tb_append_str(tb, k as int)
            tb_append_byte(tb, 93) # "]"
            tb_append_byte(tb, 10)

            # Build sub-prefix
            var sub_pref = k
            if toml_str_len(prefix as int) > 0 do
                let plen = toml_str_len(prefix as int)
                let klen = toml_str_len(k as int)
                let pbuf = vir_alloc(plen + 1 + klen + 1)
                var p_i = 0
                when p_i < plen loop
                    native_write_u8(pbuf, p_i, native_read_u8(prefix as int, p_i))
                    p_i = p_i + 1
                end
                native_write_u8(pbuf, plen, 46) # "."
                var k_i = 0
                when k_i < klen loop
                    native_write_u8(pbuf, plen + 1 + k_i, native_read_u8(k as int, k_i))
                    k_i = k_i + 1
                end
                native_write_u8(pbuf, plen + 1 + klen, 0)
                sub_pref = pbuf as string
            end
            tb_serialize_table(tb, v, sub_pref)
        end
        idx = idx + 1
    end
end.

func toml_stringify(val: TomlValue) -> string:
    let tb = tb_new()
    if val.tag == TomlType.Table do
        tb_serialize_table(tb, val, "")
    end
    tb_append_byte(tb, 0)
    out tb.data as string
end.

export TomlType, TomlValue, toml_none, toml_bool, toml_int, toml_str, toml_table, toml_get_tag, toml_get_int, toml_get_str, toml_table_len, toml_table_key, toml_table_val, toml_table_get, toml_table_set, toml_parse, toml_stringify
