##
 * vir/data/ini.vri — Production-Grade INI File Format Parser & Serializer
 * =======================================================================
 * Features:
 *   - Sections: [section_name]
 *   - Global / default section ("") for properties before any section header
 *   - Delimiters: '=' and ':'
 *   - Comments: '#' and ';' (full-line and inline)
 *   - Whitespace trimming for section names, keys, and values
 *   - Quote stripping for "..." and '...' values (preserving spaces)
 *   - Strict syntax error detection with line, column, offset
 *   - Full two-way read & write with roundtrip stringification
 *   - Memory-safe, zero libc dependencies
 ##

include types
include result
include option
include alloc
import vir_alloc, vir_free, vir_realloc from alloc
include vec_rt
import vec_new_rt, vec_push_rt, vec_get_rt, vec_len_rt, vec_set_rt from vec_rt
include vir.data.error

extern func native_read_u8(addr: int, offset: int) -> int
extern func native_write_u8(addr: int, offset: int, val: int)
extern func native_read_i64(addr: int, offset: int) -> int
extern func native_write_i64(addr: int, offset: int, val: int)

# ═══════════════════════════════════════════════════════
# String Helpers
# ═══════════════════════════════════════════════════════

func ini_str_len(addr: int) -> int:
    if addr == 0 do out 0 end
    var i = 0
    loop
        if native_read_u8(addr, i) == 0 do out i end
        i = i + 1
    end
    out 0
end.

func ini_str_eq(a: string, b: string) -> bool:
    let pa = a as int
    let pb = b as int
    if pa == pb do out true end
    if pa == 0 or pb == 0 do out false end
    var i = 0
    loop
        let ca = native_read_u8(pa, i)
        let cb = native_read_u8(pb, i)
        if ca != cb do out false end
        if ca == 0 do out true end
        i = i + 1
    end
    out true
end.

func ini_copy_substr(src: int, start_idx: int, end_idx: int) -> string:
    let slen = end_idx - start_idx
    if slen <= 0 do out "" end
    let buf = vir_alloc(slen + 1)
    var i = 0
    when i < slen loop
        native_write_u8(buf, i, native_read_u8(src, start_idx + i))
        i = i + 1
    end
    native_write_u8(buf, slen, 0)
    out buf as string
end.

func ini_substr_trimmed(src: int, start_idx: int, end_idx: int) -> string:
    var s = start_idx
    when s < end_idx loop
        let b = native_read_u8(src, s)
        if b != 32 and b != 9 and b != 13 and b != 10 do break end
        s = s + 1
    end
    var e = end_idx
    when e > s loop
        let b = native_read_u8(src, e - 1)
        if b != 32 and b != 9 and b != 13 and b != 10 do break end
        e = e - 1
    end
    if s >= e do out "" end
    out ini_copy_substr(src, s, e)
end.

# ═══════════════════════════════════════════════════════
# Data Structures
# ═══════════════════════════════════════════════════════

entity IniSection:
    name: string,
    keys: int,
    vals: int
end.

entity IniDocument:
    sections: int
end.

func ini_section_new(name: string) -> int:
    let k = vec_new_rt()
    let v = vec_new_rt()
    let ptr = vir_alloc(24)
    native_write_i64(ptr, 0, name as int)
    native_write_i64(ptr, 8, k)
    native_write_i64(ptr, 16, v)
    out ptr
end.

func ini_section_get_name(sec_ptr: int) -> string:
    out native_read_i64(sec_ptr, 0) as string
end.

func ini_section_get_keys(sec_ptr: int) -> int:
    out native_read_i64(sec_ptr, 8)
end.

func ini_section_get_vals(sec_ptr: int) -> int:
    out native_read_i64(sec_ptr, 16)
end.

func ini_doc_new() -> IniDocument:
    let secs = vec_new_rt()
    out IniDocument ( sections: secs )
end.

func ini_find_section_ptr(doc: IniDocument, sec_name: string) -> int:
    let n = vec_len_rt(doc.sections)
    var idx = 0
    when idx < n loop
        let sptr = vec_get_rt(doc.sections, idx)
        let sname = ini_section_get_name(sptr)
        if ini_str_eq(sname, sec_name) do
            out sptr
        end
        idx = idx + 1
    end
    out 0
end.

func ini_get_or_create_section_ptr(doc: IniDocument, sec_name: string) -> int:
    let found = ini_find_section_ptr(doc, sec_name)
    if found != 0 do out found end
    let new_ptr = ini_section_new(sec_name)
    doc.sections = vec_push_rt(doc.sections, new_ptr)
    out new_ptr
end.

func ini_section_get_val(sec_ptr: int, key: string) -> Option<string>:
    let keys_vec = ini_section_get_keys(sec_ptr)
    let vals_vec = ini_section_get_vals(sec_ptr)
    let n = vec_len_rt(keys_vec)
    var idx = 0
    when idx < n loop
        let k = vec_get_rt(keys_vec, idx) as string
        if ini_str_eq(k, key) do
            let v = vec_get_rt(vals_vec, idx) as string
            out Some(v)
        end
        idx = idx + 1
    end
    out None
end.

func ini_section_set_val(sec_ptr: int, key: string, val: string):
    let keys_vec = ini_section_get_keys(sec_ptr)
    let vals_vec = ini_section_get_vals(sec_ptr)
    let n = vec_len_rt(keys_vec)
    var idx = 0
    when idx < n loop
        let k = vec_get_rt(keys_vec, idx) as string
        if ini_str_eq(k, key) do
            let new_vals = vec_set_rt(vals_vec, idx, val as int)
            native_write_i64(sec_ptr, 16, new_vals)
            out
        end
        idx = idx + 1
    end
    let new_keys = vec_push_rt(keys_vec, key as int)
    let new_vals = vec_push_rt(vals_vec, val as int)
    native_write_i64(sec_ptr, 8, new_keys)
    native_write_i64(sec_ptr, 16, new_vals)
end.

# ═══════════════════════════════════════════════════════
# Public Document API
# ═══════════════════════════════════════════════════════

func ini_has_section(doc: IniDocument, section: string) -> bool:
    out ini_find_section_ptr(doc, section) != 0
end.

func ini_get(doc: IniDocument, section: string, key: string) -> Option<string>:
    let sec_ptr = ini_find_section_ptr(doc, section)
    if sec_ptr == 0 do out None end
    out ini_section_get_val(sec_ptr, key)
end.

func ini_get_or(doc: IniDocument, section: string, key: string, default_val: string) -> string:
    let opt = ini_get(doc, section, key)
    case opt
        Some(v): out v
        None: out default_val
    end
end.

func ini_set(doc: IniDocument, section: string, key: string, value: string):
    let sec_ptr = ini_get_or_create_section_ptr(doc, section)
    ini_section_set_val(sec_ptr, key, value)
end.

func ini_sections_len(doc: IniDocument) -> int:
    out vec_len_rt(doc.sections)
end.

func ini_section_name_at(doc: IniDocument, idx: int) -> string:
    if idx >= 0 and idx < vec_len_rt(doc.sections) do
        let sptr = vec_get_rt(doc.sections, idx)
        out ini_section_get_name(sptr)
    end
    out ""
end.

func ini_keys_len(doc: IniDocument, section: string) -> int:
    let sptr = ini_find_section_ptr(doc, section)
    if sptr != 0 do
        out vec_len_rt(ini_section_get_keys(sptr))
    end
    out 0
end.

func ini_key_at(doc: IniDocument, section: string, idx: int) -> string:
    let sptr = ini_find_section_ptr(doc, section)
    if sptr != 0 do
        let kvec = ini_section_get_keys(sptr)
        if idx >= 0 and idx < vec_len_rt(kvec) do
            out vec_get_rt(kvec, idx) as string
        end
    end
    out ""
end.

# ═══════════════════════════════════════════════════════
# INI Value Parsing (Quotes & Comments)
# ═══════════════════════════════════════════════════════

func ini_parse_val(src: int, start_idx: int, end_idx: int) -> string:
    # Trim leading whitespace
    var s = start_idx
    when s < end_idx loop
        let b = native_read_u8(src, s)
        if b != 32 and b != 9 do break end
        s = s + 1
    end
    var e = end_idx
    when e > s loop
        let b = native_read_u8(src, e - 1)
        if b != 32 and b != 9 and b != 13 and b != 10 do break end
        e = e - 1
    end
    if s >= e do out "" end

    let first = native_read_u8(src, s)
    # Check if quoted with " (34) or ' (39)
    if (first == 34 or first == 39) and e - s >= 2 do
        let quote_ch = first
        # Look for closing quote
        var q_end = s + 1
        var found_quote = 0
        when q_end < e loop
            if native_read_u8(src, q_end) == quote_ch do
                found_quote = 1
                break
            end
            q_end = q_end + 1
        end
        if found_quote == 1 do
            out ini_copy_substr(src, s + 1, q_end)
        end
    end

    # Unquoted value: strip inline comment (# or ;)
    var v_end = s
    when v_end < e loop
        let b = native_read_u8(src, v_end)
        if b == 35 or b == 59 do # '#' or ';'
            break
        end
        v_end = v_end + 1
    end
    # Trim trailing whitespace before comment
    when v_end > s loop
        let b = native_read_u8(src, v_end - 1)
        if b != 32 and b != 9 do break end
        v_end = v_end - 1
    end
    if s >= v_end do out "" end
    out ini_copy_substr(src, s, v_end)
end.

# ═══════════════════════════════════════════════════════
# INI Parser Implementation
# ═══════════════════════════════════════════════════════

func ini_parse(text: string):
    let src = text as int
    let doc = ini_doc_new()
    if src == 0 do
        out Ok(doc)
    end
    let slen = ini_str_len(src)
    var pos = 0
    var line = 1
    var col = 1
    var cur_section = ""

    when pos < slen loop
        let line_start_pos = pos
        let line_num = line

        # Find line end (\n or \r\n or end of src)
        var line_end = pos
        when line_end < slen loop
            let ch = native_read_u8(src, line_end)
            if ch == 10 or ch == 13 do
                break
            end
            line_end = line_end + 1
        end

        # Advance pos past line break for next iteration
        pos = line_end
        if pos < slen and native_read_u8(src, pos) == 13 do
            pos = pos + 1
        end
        if pos < slen and native_read_u8(src, pos) == 10 do
            pos = pos + 1
        end
        line = line + 1
        col = 1

        # Now parse line within [line_start_pos, line_end)
        var l_cur = line_start_pos
        when l_cur < line_end loop
            let b = native_read_u8(src, l_cur)
            if b != 32 and b != 9 do break end
            l_cur = l_cur + 1
        end

        var l_tail = line_end
        when l_tail > l_cur loop
            let b = native_read_u8(src, l_tail - 1)
            if b != 32 and b != 9 and b != 13 and b != 10 do break end
            l_tail = l_tail - 1
        end

        # Empty line or whitespace-only
        if l_cur < l_tail do
            let first_ch = native_read_u8(src, l_cur)

            # Comment line: starts with # (35) or ; (59)
            if first_ch == 35 or first_ch == 59 do
                # Comment line ignored

            # Section header: starts with [ (91)
            eif first_ch == 91 do
                let last_ch = native_read_u8(src, l_tail - 1)
                if last_ch != 93 do # "]"
                    let err_col = (l_cur - line_start_pos) + 1
                    out Err(parse_error_new(l_cur, line_num, err_col, "unclosed section header"))
                end
                let s_name = ini_substr_trimmed(src, l_cur + 1, l_tail - 1)
                if ini_str_len(s_name as int) == 0 do
                    let err_col = (l_cur - line_start_pos) + 1
                    out Err(parse_error_new(l_cur, line_num, err_col, "empty section header"))
                end
                cur_section = s_name
                ini_get_or_create_section_ptr(doc, cur_section)

            # Key-value pair
            else
                var delim_pos = 0 - 1
                var scan = l_cur
                when scan < l_tail loop
                    let b = native_read_u8(src, scan)
                    if b == 61 or b == 58 do
                        delim_pos = scan
                        break
                    end
                    scan = scan + 1
                end

                if delim_pos < 0 do
                    let err_col = (l_cur - line_start_pos) + 1
                    out Err(parse_error_new(l_cur, line_num, err_col, "expected key-value delimiter ('=' or ':')"))
                end

                let key = ini_substr_trimmed(src, l_cur, delim_pos)
                if ini_str_len(key as int) == 0 do
                    let err_col = (l_cur - line_start_pos) + 1
                    out Err(parse_error_new(l_cur, line_num, err_col, "empty key name"))
                end

                let val = ini_parse_val(src, delim_pos + 1, l_tail)
                ini_set(doc, cur_section, key, val)
            end
        end
    end

    out Ok(doc)
end.

# ═══════════════════════════════════════════════════════
# INI Serializer Implementation
# ═══════════════════════════════════════════════════════

entity IniBuf:
    data: int,
    len: int,
    cap: int
end.

func inibuf_new() -> IniBuf:
    let cap = 128
    let buf = vir_alloc(cap)
    out IniBuf ( data: buf, len: 0, cap: cap )
end.

func inibuf_append_byte(ib: IniBuf, b: int):
    if ib.len + 1 >= ib.cap do
        ib.cap = ib.cap * 2
        ib.data = vir_realloc(ib.data, ib.cap)
    end
    native_write_u8(ib.data, ib.len, b)
    ib.len = ib.len + 1
end.

func inibuf_append_str(ib: IniBuf, s: string):
    let p = s as int
    if p == 0 do out end
    let slen = ini_str_len(p)
    var i = 0
    when i < slen loop
        inibuf_append_byte(ib, native_read_u8(p, i))
        i = i + 1
    end
end.

func ini_stringify(doc: IniDocument) -> string:
    let ib = inibuf_new()
    let num_secs = vec_len_rt(doc.sections)

    # 1. Root section ("") if present
    let root_ptr = ini_find_section_ptr(doc, "")
    if root_ptr != 0 do
        let kvec = ini_section_get_keys(root_ptr)
        let vvec = ini_section_get_vals(root_ptr)
        let nk = vec_len_rt(kvec)
        var ki = 0
        when ki < nk loop
            let k = vec_get_rt(kvec, ki) as string
            let v = vec_get_rt(vvec, ki) as string
            inibuf_append_str(ib, k)
            inibuf_append_str(ib, " = ")
            inibuf_append_str(ib, v)
            inibuf_append_byte(ib, 10)
            ki = ki + 1
        end
    end

    # 2. Named sections
    var si = 0
    when si < num_secs loop
        let sptr = vec_get_rt(doc.sections, si)
        let sname = ini_section_get_name(sptr)
        if ini_str_len(sname as int) > 0 do
            if ib.len > 0 do
                inibuf_append_byte(ib, 10)
            end
            inibuf_append_byte(ib, 91) # '['
            inibuf_append_str(ib, sname)
            inibuf_append_byte(ib, 93) # ']'
            inibuf_append_byte(ib, 10)

            let kvec = ini_section_get_keys(sptr)
            let vvec = ini_section_get_vals(sptr)
            let nk = vec_len_rt(kvec)
            var ki = 0
            when ki < nk loop
                let k = vec_get_rt(kvec, ki) as string
                let v = vec_get_rt(vvec, ki) as string
                inibuf_append_str(ib, k)
                inibuf_append_str(ib, " = ")
                inibuf_append_str(ib, v)
                inibuf_append_byte(ib, 10)
                ki = ki + 1
            end
        end
        si = si + 1
    end

    inibuf_append_byte(ib, 0)
    out ib.data as string
end.

export IniDocument, IniSection, ini_doc_new, ini_parse, ini_get, ini_get_or, ini_set, ini_has_section, ini_sections_len, ini_section_name_at, ini_keys_len, ini_key_at, ini_stringify
