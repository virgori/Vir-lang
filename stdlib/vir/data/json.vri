##
 * vir/data/json.vri — Strict RFC 8259 JSON Parser & Serializer (Pure Vir, Zero Libc)
 * =================================================================================
 * Full RFC 8259 compliance:
 *   - Primitives: null, true, false, number (strict format), string (with full escapes)
 *   - Collections: array, object
 *   - UTF-16 surrogate pairs (\uD83D\uDE00) -> UTF-8
 *   - Rejection of invalid JSON: leading zero numbers (01), trailing commas,
 *     unquoted keys, comments, unclosed strings, isolated surrogates, control chars
 *   - Nesting depth limit (128) against stack overflow
 *   - Full two-way serializer with pretty-print option
 ##

include types
include option
include result
include alloc
import vir_alloc, vir_free, vir_realloc from alloc
include vec_rt
import vec_new_rt, vec_push_rt, vec_get_rt, vec_len_rt from vec_rt
include vir.data.error

extern func native_read_u8(addr: int, offset: int) -> int
extern func native_write_u8(addr: int, offset: int, val: int)
extern func native_read_i64(addr: int, offset: int) -> int
extern func native_write_i64(addr: int, offset: int, val: int)

enum JsonType:
    Null   = 0
    Bool   = 1
    Number = 2
    Str    = 3
    Array  = 4
    Object = 5
end.

entity JsonValue:
    tag: int
    num_val: int
    str_val: string
    arr_val: int
    obj_keys: int
    obj_vals: int
end.

func json_null() -> JsonValue:
    out JsonValue ( tag: JsonType.Null, num_val: 0, str_val: "", arr_val: 0, obj_keys: 0, obj_vals: 0 )
end.

func json_bool(b: bool) -> JsonValue:
    var n = 0
    if b do n = 1 end
    out JsonValue ( tag: JsonType.Bool, num_val: n, str_val: "", arr_val: 0, obj_keys: 0, obj_vals: 0 )
end.

func json_number(n: int) -> JsonValue:
    out JsonValue ( tag: JsonType.Number, num_val: n, str_val: "", arr_val: 0, obj_keys: 0, obj_vals: 0 )
end.

func json_string(s: string) -> JsonValue:
    out JsonValue ( tag: JsonType.Str, num_val: 0, str_val: s, arr_val: 0, obj_keys: 0, obj_vals: 0 )
end.

func json_array() -> JsonValue:
    let arr = vec_new_rt()
    out JsonValue ( tag: JsonType.Array, num_val: 0, str_val: "", arr_val: arr, obj_keys: 0, obj_vals: 0 )
end.

func json_object() -> JsonValue:
    let k = vec_new_rt()
    let v = vec_new_rt()
    out JsonValue ( tag: JsonType.Object, num_val: 0, str_val: "", arr_val: 0, obj_keys: k, obj_vals: v )
end.

func json_get_tag(v: JsonValue) -> int:
    out v.tag
end.

func json_get_num(v: JsonValue) -> int:
    out v.num_val
end.

func json_get_str(v: JsonValue) -> string:
    out v.str_val
end.

func json_get_arr(v: JsonValue) -> int:
    out v.arr_val
end.

func json_arr_push(arr: JsonValue, item: JsonValue):
    if arr.tag == JsonType.Array and arr.arr_val != 0 do
        let ptr = vir_alloc(48)
        native_write_i64(ptr, 0, item.tag)
        native_write_i64(ptr, 8, item.num_val)
        native_write_i64(ptr, 16, item.str_val as int)
        native_write_i64(ptr, 24, item.arr_val)
        native_write_i64(ptr, 32, item.obj_keys)
        native_write_i64(ptr, 40, item.obj_vals)
        arr.arr_val = vec_push_rt(arr.arr_val, ptr)
    end
end.

func json_arr_len(arr: JsonValue) -> int:
    if arr.tag == JsonType.Array and arr.arr_val != 0 do
        out vec_len_rt(arr.arr_val)
    end
    out 0
end.

func json_arr_get(arr: JsonValue, idx: int) -> JsonValue:
    if arr.tag == JsonType.Array and arr.arr_val != 0 do
        if idx >= 0 and idx < vec_len_rt(arr.arr_val) do
            let ptr = vec_get_rt(arr.arr_val, idx)
            out JsonValue (
                tag: native_read_i64(ptr, 0),
                num_val: native_read_i64(ptr, 8),
                str_val: native_read_i64(ptr, 16) as string,
                arr_val: native_read_i64(ptr, 24),
                obj_keys: native_read_i64(ptr, 32),
                obj_vals: native_read_i64(ptr, 40)
            )
        end
    end
    out json_null()
end.

func json_obj_set(obj: JsonValue, key: string, val: JsonValue):
    if obj.tag == JsonType.Object and obj.obj_keys != 0 do
        let kptr = key as int
        let vptr = vir_alloc(48)
        native_write_i64(vptr, 0, val.tag)
        native_write_i64(vptr, 8, val.num_val)
        native_write_i64(vptr, 16, val.str_val as int)
        native_write_i64(vptr, 24, val.arr_val)
        native_write_i64(vptr, 32, val.obj_keys)
        native_write_i64(vptr, 40, val.obj_vals)

        let n = vec_len_rt(obj.obj_keys)
        var i = 0
        var found = 0
        when i < n and found == 0 loop
            let ek = vec_get_rt(obj.obj_keys, i)
            if json_internal_streq(ek, kptr) do
                native_write_i64(obj.obj_vals, i * 8, vptr)
                found = 1
            end
            i = i + 1
        end
        if found == 0 do
            obj.obj_keys = vec_push_rt(obj.obj_keys, kptr)
            obj.obj_vals = vec_push_rt(obj.obj_vals, vptr)
        end
    end
end.

func json_obj_get(obj: JsonValue, key: string) -> Option<JsonValue>:
    if obj.tag == JsonType.Object and obj.obj_keys != 0 do
        let kptr = key as int
        let n = vec_len_rt(obj.obj_keys)
        var i = 0
        when i < n loop
            let ek = vec_get_rt(obj.obj_keys, i)
            if json_internal_streq(ek, kptr) do
                let ptr = vec_get_rt(obj.obj_vals, i)
                let v = JsonValue (
                    tag: native_read_i64(ptr, 0),
                    num_val: native_read_i64(ptr, 8),
                    str_val: native_read_i64(ptr, 16) as string,
                    arr_val: native_read_i64(ptr, 24),
                    obj_keys: native_read_i64(ptr, 32),
                    obj_vals: native_read_i64(ptr, 40)
                )
                out Some(v)
            end
            i = i + 1
        end
    end
    out None
end.

func json_obj_len(obj: JsonValue) -> int:
    if obj.tag == JsonType.Object and obj.obj_keys != 0 do
        out vec_len_rt(obj.obj_keys)
    end
    out 0
end.

func json_obj_key_at(obj: JsonValue, idx: int) -> string:
    if obj.tag == JsonType.Object and obj.obj_keys != 0 do
        if idx >= 0 and idx < vec_len_rt(obj.obj_keys) do
            out vec_get_rt(obj.obj_keys, idx) as string
        end
    end
    out ""
end.

func json_obj_val_at(obj: JsonValue, idx: int) -> JsonValue:
    if obj.tag == JsonType.Object and obj.obj_vals != 0 do
        if idx >= 0 and idx < vec_len_rt(obj.obj_vals) do
            let ptr = vec_get_rt(obj.obj_vals, idx)
            out JsonValue (
                tag: native_read_i64(ptr, 0),
                num_val: native_read_i64(ptr, 8),
                str_val: native_read_i64(ptr, 16) as string,
                arr_val: native_read_i64(ptr, 24),
                obj_keys: native_read_i64(ptr, 32),
                obj_vals: native_read_i64(ptr, 40)
            )
        end
    end
    out json_null()
end.

func json_internal_streq(a: int, b: int) -> bool:
    if a == b do out true end
    if a == 0 or b == 0 do out false end
    var i = 0
    loop
        let ca = native_read_u8(a, i)
        let cb = native_read_u8(b, i)
        if ca != cb do out false end
        if ca == 0 do out true end
        i = i + 1
    end
    out true
end.

# ═══════════════════════════════════════════════════════
# JSON Parser Implementation
# ═══════════════════════════════════════════════════════

entity JsonParser:
    src: int
    len: int
    pos: int
    depth: int
    err_msg: string
    err_pos: int
end.

func json_skip_ws(p: JsonParser):
    when p.pos < p.len loop
        let ch = native_read_u8(p.src, p.pos)
        if ch == 32 or ch == 9 or ch == 10 or ch == 13 do
            p.pos = p.pos + 1
        else
            out
        end
    end
end.

func json_parse_error(p: JsonParser, msg: string):
    p.err_msg = msg
    p.err_pos = p.pos
end.

func json_parse_value(p: JsonParser) -> JsonValue:
    json_skip_ws(p)
    if p.pos >= p.len do
        json_parse_error(p, "unexpected end of input")
        out json_null()
    end

    if p.depth > 128 do
        json_parse_error(p, "maximum nesting depth exceeded (128)")
        out json_null()
    end

    let ch = native_read_u8(p.src, p.pos)

    # 1. Null
    if ch == 110 do # 'n'
        if p.pos + 4 <= p.len and
           native_read_u8(p.src, p.pos + 1) == 117 and
           native_read_u8(p.src, p.pos + 2) == 108 and
           native_read_u8(p.src, p.pos + 3) == 108 do
            p.pos = p.pos + 4
            out json_null()
        else
            json_parse_error(p, "invalid literal (expected 'null')")
            out json_null()
        end
    end

    # 2. True
    if ch == 116 do # 't'
        if p.pos + 4 <= p.len and
           native_read_u8(p.src, p.pos + 1) == 114 and
           native_read_u8(p.src, p.pos + 2) == 117 and
           native_read_u8(p.src, p.pos + 3) == 101 do
            p.pos = p.pos + 4
            out json_bool(true)
        else
            json_parse_error(p, "invalid literal (expected 'true')")
            out json_null()
        end
    end

    # 3. False
    if ch == 102 do # 'f'
        if p.pos + 5 <= p.len and
           native_read_u8(p.src, p.pos + 1) == 97 and
           native_read_u8(p.src, p.pos + 2) == 108 and
           native_read_u8(p.src, p.pos + 3) == 115 and
           native_read_u8(p.src, p.pos + 4) == 101 do
            p.pos = p.pos + 5
            out json_bool(false)
        else
            json_parse_error(p, "invalid literal (expected 'false')")
            out json_null()
        end
    end

    # 4. String
    if ch == 34 do # '"'
        let s = json_parse_string(p)
        out json_string(s)
    end

    # 5. Array
    if ch == 91 do # '['
        out json_parse_array(p)
    end

    # 6. Object
    if ch == 123 do # '{'
        out json_parse_object(p)
    end

    # 7. Number
    if ch == 45 or (ch >= 48 and ch <= 57) do # '-' or '0'..'9'
        out json_parse_num(p)
    end

    # Reject comments or invalid characters
    if ch == 47 do # '/'
        json_parse_error(p, "comments are not permitted in RFC 8259 JSON")
        out json_null()
    end

    json_parse_error(p, "unexpected character")
    out json_null()
end.

func json_parse_string(p: JsonParser) -> string:
    p.pos = p.pos + 1
    var cap = 64
    var buf = vir_alloc(cap)
    var out_len = 0

    when p.pos < p.len loop
        let ch = native_read_u8(p.src, p.pos)
        if ch == 34 do # closing '"'
            p.pos = p.pos + 1
            native_write_u8(buf, out_len, 0)
            out buf as string
        end

        if ch < 32 do
            json_parse_error(p, "unescaped control character in string")
            out ""
        end

        if ch == 92 do # '\' escape
            p.pos = p.pos + 1
            if p.pos >= p.len do
                json_parse_error(p, "unterminated escape sequence")
                out ""
            end
            let esc = native_read_u8(p.src, p.pos)
            p.pos = p.pos + 1

            var decoded_byte = -1
            if esc == 34 do decoded_byte = 34;
            eif esc == 92 do decoded_byte = 92;
            eif esc == 47 do decoded_byte = 47;
            eif esc == 98 do decoded_byte = 8;
            eif esc == 102 do decoded_byte = 12;
            eif esc == 110 do decoded_byte = 10;
            eif esc == 114 do decoded_byte = 13;
            eif esc == 116 do decoded_byte = 9;
            eif esc == 117 do # \uXXXX
                let cp = json_parse_hex4(p)
                if cp < 0 do
                    json_parse_error(p, "invalid unicode escape sequence")
                    out ""
                end

                var final_cp = cp
                if cp >= 55296 and cp <= 56319 do # 0xD800..0xDBFF High Surrogate
                    if p.pos + 2 <= p.len and
                       native_read_u8(p.src, p.pos) == 92 and
                       native_read_u8(p.src, p.pos + 1) == 117 do
                        p.pos = p.pos + 2
                        let low = json_parse_hex4(p)
                        if low >= 56320 and low <= 57343 do
                            final_cp = 65536 + ((cp - 55296) * 1024) + (low - 56320)
                        else
                            json_parse_error(p, "unpaired high surrogate")
                            out ""
                        end
                    else
                        json_parse_error(p, "unpaired high surrogate")
                        out ""
                    end
                eif cp >= 56320 and cp <= 57343 do
                    json_parse_error(p, "lone low surrogate")
                    out ""
                end

                if final_cp <= 127 do
                    if out_len + 1 >= cap do
                        cap = cap * 2
                        buf = vir_realloc(buf, cap)
                    end
                    native_write_u8(buf, out_len, final_cp)
                    out_len = out_len + 1
                eif final_cp <= 2047 do
                    if out_len + 2 >= cap do
                        cap = cap * 2
                        buf = vir_realloc(buf, cap)
                    end
                    native_write_u8(buf, out_len, 192 bit_or (final_cp / 64))
                    native_write_u8(buf, out_len + 1, 128 bit_or (final_cp bit_and 63))
                    out_len = out_len + 2
                eif final_cp <= 65535 do
                    if out_len + 3 >= cap do
                        cap = cap * 2
                        buf = vir_realloc(buf, cap)
                    end
                    native_write_u8(buf, out_len, 224 bit_or (final_cp / 4096))
                    native_write_u8(buf, out_len + 1, 128 bit_or ((final_cp / 64) bit_and 63))
                    native_write_u8(buf, out_len + 2, 128 bit_or (final_cp bit_and 63))
                    out_len = out_len + 3
                else
                    if out_len + 4 >= cap do
                        cap = cap * 2
                        buf = vir_realloc(buf, cap)
                    end
                    native_write_u8(buf, out_len, 240 bit_or (final_cp / 262144))
                    native_write_u8(buf, out_len + 1, 128 bit_or ((final_cp / 4096) bit_and 63))
                    native_write_u8(buf, out_len + 2, 128 bit_or ((final_cp / 64) bit_and 63))
                    native_write_u8(buf, out_len + 3, 128 bit_or (final_cp bit_and 63))
                    out_len = out_len + 4
                end
            else
                json_parse_error(p, "invalid escape character")
                out ""
            end

            if decoded_byte >= 0 do
                if out_len + 1 >= cap do
                    cap = cap * 2
                    buf = vir_realloc(buf, cap)
                end
                native_write_u8(buf, out_len, decoded_byte)
                out_len = out_len + 1
            end
        else
            p.pos = p.pos + 1
            if out_len + 1 >= cap do
                cap = cap * 2
                buf = vir_realloc(buf, cap)
            end
            native_write_u8(buf, out_len, ch)
            out_len = out_len + 1
        end
    end

    json_parse_error(p, "unterminated string")
    out ""
end.

func json_parse_hex4(p: JsonParser) -> int:
    if p.pos + 4 > p.len do out -1 end
    var val = 0
    var i = 0
    when i < 4 loop
        let ch = native_read_u8(p.src, p.pos + i)
        var d = -1
        if ch >= 48 and ch <= 57 do d = ch - 48;
        eif ch >= 65 and ch <= 70 do d = ch - 65 + 10;
        eif ch >= 97 and ch <= 102 do d = ch - 97 + 10;
        end
        if d < 0 do out -1 end
        val = (val * 16) + d
        i = i + 1
    end
    p.pos = p.pos + 4
    out val
end.

func json_parse_num(p: JsonParser) -> JsonValue:
    let start = p.pos
    var is_neg = 0
    if native_read_u8(p.src, p.pos) == 45 do
        is_neg = 1
        p.pos = p.pos + 1
        if p.pos >= p.len do
            json_parse_error(p, "unexpected end of number")
            out json_null()
        end
    end

    let first_digit = native_read_u8(p.src, p.pos)
    if first_digit < 48 or first_digit > 57 do
        json_parse_error(p, "expected digit in number")
        out json_null()
    end

    if first_digit == 48 do
        p.pos = p.pos + 1
        if p.pos < p.len do
            let next_ch = native_read_u8(p.src, p.pos)
            if next_ch >= 48 and next_ch <= 57 do
                json_parse_error(p, "leading zero in number is forbidden")
                out json_null()
            end
        end
    else
        p.pos = p.pos + 1
        when p.pos < p.len loop
            let ch = native_read_u8(p.src, p.pos)
            if ch >= 48 and ch <= 57 do
                p.pos = p.pos + 1
            else
                break
            end
        end
    end

    if p.pos < p.len and native_read_u8(p.src, p.pos) == 46 do
        p.pos = p.pos + 1
        if p.pos >= p.len do
            json_parse_error(p, "expected digit after decimal point")
            out json_null()
        end
        let ch = native_read_u8(p.src, p.pos)
        if ch < 48 or ch > 57 do
            json_parse_error(p, "expected digit after decimal point")
            out json_null()
        end
        p.pos = p.pos + 1
        when p.pos < p.len loop
            let c = native_read_u8(p.src, p.pos)
            if c >= 48 and c <= 57 do
                p.pos = p.pos + 1
            else
                break
            end
        end
    end

    if p.pos < p.len do
        let ech = native_read_u8(p.src, p.pos)
        if ech == 101 or ech == 69 do
            p.pos = p.pos + 1
            if p.pos >= p.len do
                json_parse_error(p, "expected digit in exponent")
                out json_null()
            end
            let sign_ch = native_read_u8(p.src, p.pos)
            if sign_ch == 43 or sign_ch == 45 do
                p.pos = p.pos + 1
            end
            if p.pos >= p.len do
                json_parse_error(p, "expected digit in exponent")
                out json_null()
            end
            let dig = native_read_u8(p.src, p.pos)
            if dig < 48 or dig > 57 do
                json_parse_error(p, "expected digit in exponent")
                out json_null()
            end
            p.pos = p.pos + 1
            when p.pos < p.len loop
                let c = native_read_u8(p.src, p.pos)
                if c >= 48 and c <= 57 do
                    p.pos = p.pos + 1
                else
                    break
                end
            end
        end
    end

    let num_len = p.pos - start
    var int_val = 0
    var i = start
    if is_neg == 1 do i = i + 1 end
    when i < p.pos loop
        let d = native_read_u8(p.src, i)
        if d >= 48 and d <= 57 do
            int_val = (int_val * 10) + (d - 48)
        else
            break
        end
        i = i + 1
    end
    if is_neg == 1 do int_val = -int_val end

    let raw_buf = vir_alloc(num_len + 1)
    var j = 0
    when j < num_len loop
        native_write_u8(raw_buf, j, native_read_u8(p.src, start + j))
        j = j + 1
    end
    native_write_u8(raw_buf, num_len, 0)

    out JsonValue (
        tag: JsonType.Number,
        num_val: int_val,
        str_val: raw_buf as string,
        arr_val: 0,
        obj_keys: 0,
        obj_vals: 0
    )
end.

func json_parse_array(p: JsonParser) -> JsonValue:
    p.pos = p.pos + 1
    p.depth = p.depth + 1
    let arr = json_array()

    json_skip_ws(p)
    if p.pos < p.len and native_read_u8(p.src, p.pos) == 93 do
        p.pos = p.pos + 1
        p.depth = p.depth - 1
        out arr
    end

    loop
        let val = json_parse_value(p)
        if p.err_msg as int != 0 and json_str_len(p.err_msg as int) > 0 do
            p.depth = p.depth - 1
            out arr
        end
        json_arr_push(arr, val)

        json_skip_ws(p)
        if p.pos >= p.len do
            json_parse_error(p, "unterminated array")
            p.depth = p.depth - 1
            out arr
        end

        let sep = native_read_u8(p.src, p.pos)
        if sep == 44 do
            p.pos = p.pos + 1
            json_skip_ws(p)
            if p.pos < p.len and native_read_u8(p.src, p.pos) == 93 do
                json_parse_error(p, "trailing comma in array is forbidden")
                p.depth = p.depth - 1
                out arr
            end
        eif sep == 93 do
            p.pos = p.pos + 1
            p.depth = p.depth - 1
            out arr
        else
            json_parse_error(p, "expected ',' or ']' in array")
            p.depth = p.depth - 1
            out arr
        end
    end

    out arr
end.

func json_parse_object(p: JsonParser) -> JsonValue:
    p.pos = p.pos + 1
    p.depth = p.depth + 1
    let obj = json_object()

    json_skip_ws(p)
    if p.pos < p.len and native_read_u8(p.src, p.pos) == 125 do
        p.pos = p.pos + 1
        p.depth = p.depth - 1
        out obj
    end

    loop
        json_skip_ws(p)
        if p.pos >= p.len do
            json_parse_error(p, "unterminated object")
            p.depth = p.depth - 1
            out obj
        end

        if native_read_u8(p.src, p.pos) != 34 do
            json_parse_error(p, "expected string key in object")
            p.depth = p.depth - 1
            out obj
        end

        let key = json_parse_string(p)
        if p.err_msg as int != 0 and json_str_len(p.err_msg as int) > 0 do
            p.depth = p.depth - 1
            out obj
        end

        json_skip_ws(p)
        if p.pos >= p.len or native_read_u8(p.src, p.pos) != 58 do
            json_parse_error(p, "expected ':' after key")
            p.depth = p.depth - 1
            out obj
        end
        p.pos = p.pos + 1

        let val = json_parse_value(p)
        if p.err_msg as int != 0 and json_str_len(p.err_msg as int) > 0 do
            p.depth = p.depth - 1
            out obj
        end
        json_obj_set(obj, key, val)

        json_skip_ws(p)
        if p.pos >= p.len do
            json_parse_error(p, "unterminated object")
            p.depth = p.depth - 1
            out obj
        end

        let sep = native_read_u8(p.src, p.pos)
        if sep == 44 do
            p.pos = p.pos + 1
            json_skip_ws(p)
            if p.pos < p.len and native_read_u8(p.src, p.pos) == 125 do
                json_parse_error(p, "trailing comma in object is forbidden")
                p.depth = p.depth - 1
                out obj
            end
        eif sep == 125 do
            p.pos = p.pos + 1
            p.depth = p.depth - 1
            out obj
        else
            json_parse_error(p, "expected ',' or '}' in object")
            p.depth = p.depth - 1
            out obj
        end
    end

    out obj
end.

func json_str_len(p: int) -> int:
    if p == 0 do out 0 end
    var i = 0
    when native_read_u8(p, i) != 0 loop
        i = i + 1
    end
    out i
end.

# Public API: parse
func json_parse(text: string):
    let src = text as int
    if src == 0 do
        out Err(parse_error_new(0, 1, 1, "empty input"))
    end
    let len = json_str_len(src)
    let p = JsonParser (
        src: src,
        len: len,
        pos: 0,
        depth: 0,
        err_msg: "",
        err_pos: 0
    )

    let val = json_parse_value(p)
    if p.err_msg as int != 0 and json_str_len(p.err_msg as int) > 0 do
        var l = 1
        var c = 1
        var i = 0
        when i < p.err_pos and i < len loop
            if native_read_u8(src, i) == 10 do
                l = l + 1
                c = 1
            else
                c = c + 1
            end
            i = i + 1
        end
        out Err(parse_error_new(p.err_pos, l, c, p.err_msg))
    end

    json_skip_ws(p)
    if p.pos < p.len do
        var l = 1
        var c = 1
        var i = 0
        when i < p.pos and i < len loop
            if native_read_u8(src, i) == 10 do
                l = l + 1
                c = 1
            else
                c = c + 1
            end
            i = i + 1
        end
        out Err(parse_error_new(p.pos, l, c, "trailing garbage after JSON value"))
    end

    out Ok(val)
end.

# ═══════════════════════════════════════════════════════
# JSON Serializer Implementation
# ═══════════════════════════════════════════════════════

entity JsonBuf:
    data: int,
    len: int,
    cap: int
end.

func jb_new() -> JsonBuf:
    let cap = 128
    let d = vir_alloc(cap)
    native_write_u8(d, 0, 0)
    out JsonBuf ( data: d, len: 0, cap: cap )
end.

func jb_append_byte(jb: JsonBuf, b: int):
    if jb.len + 1 >= jb.cap do
        jb.cap = jb.cap * 2
        jb.data = vir_realloc(jb.data, jb.cap)
    end
    native_write_u8(jb.data, jb.len, b)
    jb.len = jb.len + 1
    native_write_u8(jb.data, jb.len, 0)
end.

func jb_append_str(jb: JsonBuf, s: int):
    if s == 0 do out end
    let slen = json_str_len(s)
    if jb.len + slen + 1 >= jb.cap do
        jb.cap = (jb.len + slen) * 2 + 16
        jb.data = vir_realloc(jb.data, jb.cap)
    end
    var i = 0
    when i < slen loop
        native_write_u8(jb.data, jb.len + i, native_read_u8(s, i))
        i = i + 1
    end
    jb.len = jb.len + slen
    native_write_u8(jb.data, jb.len, 0)
end.

func jb_append_int(jb: JsonBuf, n: int):
    if n == 0 do
        jb_append_byte(jb, 48)
        out
    end
    var val = n
    if val < 0 do
        jb_append_byte(jb, 45)
        val = -val
    end
    var digits = vir_alloc(32)
    var dlen = 0
    when val > 0 loop
        let d = val - ((val / 10) * 10)
        native_write_u8(digits, dlen, 48 + d)
        dlen = dlen + 1
        val = val / 10
    end
    var i = dlen - 1
    when i >= 0 loop
        jb_append_byte(jb, native_read_u8(digits, i))
        i = i - 1
    end
    vir_free(digits)
end.

func jb_append_escaped_string(jb: JsonBuf, s: string):
    jb_append_byte(jb, 34)
    let ptr = s as int
    if ptr != 0 do
        let slen = json_str_len(ptr)
        var i = 0
        when i < slen loop
            let ch = native_read_u8(ptr, i)
            if ch == 34 do
                jb_append_byte(jb, 92)
                jb_append_byte(jb, 34)
            eif ch == 92 do
                jb_append_byte(jb, 92)
                jb_append_byte(jb, 92)
            eif ch == 10 do
                jb_append_byte(jb, 92)
                jb_append_byte(jb, 110)
            eif ch == 13 do
                jb_append_byte(jb, 92)
                jb_append_byte(jb, 114)
            eif ch == 9 do
                jb_append_byte(jb, 92)
                jb_append_byte(jb, 116)
            eif ch < 32 do
                jb_append_byte(jb, 92)
                jb_append_byte(jb, 117)
                jb_append_byte(jb, 48)
                jb_append_byte(jb, 48)
                let h1 = ch / 16
                let h2 = ch bit_and 15
                if h1 < 10 do jb_append_byte(jb, 48 + h1) else jb_append_byte(jb, 87 + h1) end
                if h2 < 10 do jb_append_byte(jb, 48 + h2) else jb_append_byte(jb, 87 + h2) end
            else
                jb_append_byte(jb, ch)
            end
            i = i + 1
        end
    end
    jb_append_byte(jb, 34)
end.

func json_serialize_node(jb: JsonBuf, val: JsonValue, indent: int, level: int):
    case val.tag
        JsonType.Null:
            jb_append_str(jb, "null" as int)
        JsonType.Bool:
            if val.num_val != 0 do
                jb_append_str(jb, "true" as int)
            else
                jb_append_str(jb, "false" as int)
            end
        JsonType.Number:
            if val.str_val as int != 0 and json_str_len(val.str_val as int) > 0 do
                jb_append_str(jb, val.str_val as int)
            else
                jb_append_int(jb, val.num_val)
            end
        JsonType.Str:
            jb_append_escaped_string(jb, val.str_val)
        JsonType.Array:
            let count = json_arr_len(val)
            if count == 0 do
                jb_append_str(jb, "[]" as int)
            else
                jb_append_byte(jb, 91)
                var i = 0
                when i < count loop
                    if indent > 0 do
                        jb_append_byte(jb, 10)
                        var sp = 0
                        when sp < (level + 1) * indent loop
                            jb_append_byte(jb, 32)
                            sp = sp + 1
                        end
                    end
                    let item = json_arr_get(val, i)
                    json_serialize_node(jb, item, indent, level + 1)
                    if i + 1 < count do
                        jb_append_byte(jb, 44)
                        if indent == 0 do
                            jb_append_byte(jb, 32)
                        end
                    end
                    i = i + 1
                end
                if indent > 0 do
                    jb_append_byte(jb, 10)
                    var sp = 0
                    when sp < level * indent loop
                        jb_append_byte(jb, 32)
                        sp = sp + 1
                    end
                end
                jb_append_byte(jb, 93)
            end
        JsonType.Object:
            let count = json_obj_len(val)
            if count == 0 do
                jb_append_str(jb, "{}" as int)
            else
                jb_append_byte(jb, 123)
                var i = 0
                when i < count loop
                    if indent > 0 do
                        jb_append_byte(jb, 10)
                        var sp = 0
                        when sp < (level + 1) * indent loop
                            jb_append_byte(jb, 32)
                            sp = sp + 1
                        end
                    end
                    let k = json_obj_key_at(val, i)
                    let v = json_obj_val_at(val, i)
                    jb_append_escaped_string(jb, k)
                    jb_append_byte(jb, 58)
                    if indent > 0 or true do
                        jb_append_byte(jb, 32)
                    end
                    json_serialize_node(jb, v, indent, level + 1)
                    if i + 1 < count do
                        jb_append_byte(jb, 44)
                        if indent == 0 do
                            jb_append_byte(jb, 32)
                        end
                    end
                    i = i + 1
                end
                if indent > 0 do
                    jb_append_byte(jb, 10)
                    var sp = 0
                    when sp < level * indent loop
                        jb_append_byte(jb, 32)
                        sp = sp + 1
                    end
                end
                jb_append_byte(jb, 125)
            end
        else
            jb_append_str(jb, "null" as int)
    end
end.

func json_stringify(val: JsonValue) -> string:
    let jb = jb_new()
    json_serialize_node(jb, val, 0, 0)
    out jb.data as string
end.

func json_stringify_pretty(val: JsonValue) -> string:
    let jb = jb_new()
    json_serialize_node(jb, val, 2, 0)
    out jb.data as string
end.

entity JsonNamespace:
    method read(s):
        out json_parse(s as string)
    end.
    method write(val: JsonValue) -> string:
        out json_stringify(val)
    end.
    method pretty(val: JsonValue) -> string:
        out json_stringify_pretty(val)
    end.
    method null() -> JsonValue:
        out json_null()
    end.
    method bool(b: bool) -> JsonValue:
        out json_bool(b)
    end.
    method number(n: int) -> JsonValue:
        out json_number(n)
    end.
    method string(s: string) -> JsonValue:
        out json_string(s)
    end.
    method array() -> JsonValue:
        out json_array()
    end.
    method object() -> JsonValue:
        out json_object()
    end.
    method get(obj: JsonValue, key: string) -> Option<JsonValue>:
        out json_obj_get(obj, key)
    end.
    method set(obj: JsonValue, key: string, val: JsonValue):
        json_obj_set(obj, key, val)
    end.
    method has(obj: JsonValue, key: string) -> bool:
        let opt = json_obj_get(obj, key)
        case opt
            Some(_): out true
            None: out false
        end
    end.
    method at(arr: JsonValue, idx: int) -> JsonValue:
        out json_arr_get(arr, idx)
    end.
    method push(arr: JsonValue, item: JsonValue):
        json_arr_push(arr, item)
    end.
    method len(val: JsonValue) -> int:
        if val.tag == JsonType.Array and val.arr_val != 0 do
            out vec_len_rt(val.arr_val)
        end
        if val.tag == JsonType.Object and val.obj_keys != 0 do
            out vec_len_rt(val.obj_keys)
        end
        out 0
    end.
    method count(val: JsonValue) -> int:
        if val.tag == JsonType.Array and val.arr_val != 0 do
            out vec_len_rt(val.arr_val)
        end
        if val.tag == JsonType.Object and val.obj_keys != 0 do
            out vec_len_rt(val.obj_keys)
        end
        out 0
    end.
    method size(val: JsonValue) -> int:
        out this.count(val)
    end.
    method kind(val: JsonValue) -> int:
        out val.tag
    end.
    method as_int(val: JsonValue) -> int:
        out val.num_val
    end.
    method as_string(val: JsonValue) -> string:
        out val.str_val
    end.
    method as_bool(val: JsonValue) -> bool:
        if val.num_val != 0 do out true end
        out false
    end.
    method is_null(val: JsonValue) -> bool:
        if val.tag == JsonType.Null do out true end
        out false
    end.
end.

var json: JsonNamespace

func kind(v: JsonValue) -> int:
    out v.tag
end.

func as_int(v: JsonValue) -> int:
    out v.num_val
end.

func as_string(v: JsonValue) -> string:
    out v.str_val
end.

func as_bool(v: JsonValue) -> bool:
    if v.num_val != 0 do out true end
    out false
end.

func is_null(v: JsonValue) -> bool:
    if v.tag == JsonType.Null do out true end
    out false
end.

func len(v: JsonValue) -> int:
    if v.tag == JsonType.Array and v.arr_val != 0 do
        out vec_len_rt(v.arr_val)
    end
    if v.tag == JsonType.Object and v.obj_keys != 0 do
        out vec_len_rt(v.obj_keys)
    end
    out 0
end.

func count(v: JsonValue) -> int:
    if v.tag == JsonType.Array and v.arr_val != 0 do
        out vec_len_rt(v.arr_val)
    end
    if v.tag == JsonType.Object and v.obj_keys != 0 do
        out vec_len_rt(v.obj_keys)
    end
    out 0
end.

func size(v: JsonValue) -> int:
    out count(v)
end.

func at(v: JsonValue, idx: int) -> JsonValue:
    out json_arr_get(v, idx)
end.

func get(v: JsonValue, key: string) -> Option<JsonValue>:
    out json_obj_get(v, key)
end.

func set(v: JsonValue, key: string, val: JsonValue):
    json_obj_set(v, key, val)
end.

func push(v: JsonValue, item: JsonValue):
    json_arr_push(v, item)
end.

func has(v: JsonValue, key: string) -> bool:
    let opt = json_obj_get(v, key)
    case opt
        Some(_): out true
        None: out false
    end
end.

func key(v: JsonValue, idx: int) -> string:
    out json_obj_key_at(v, idx)
end.

func value(v: JsonValue, idx: int) -> JsonValue:
    out json_obj_val_at(v, idx)
end.

export JsonType, JsonValue, JsonNamespace, json, kind, as_int, as_string, as_bool, is_null, len, count, size, at, get, set, push, has, key, value
