# wasm.vri — WebAssembly types & helpers for Vir
# ================================================
# Stdlib module for WASM target compilation & runtime.
# Spec: WebAssembly MVP + Vir extensions.

include types;
include option;
import Option, Some, None from option;
include result;
import Result, Ok, Err from result;

# ── Value Types ───────────────────────────────────────

enum ValType:
    I32
    I64
    F32
    F64
    FuncRef
    ExternRef
end.

# ── Function Signature ────────────────────────────────

entity FuncType:
    params: vec<ValType>
    results: vec<ValType>
end.

func func_type: in(params: vec<ValType>, results: vec<ValType>) -> FuncType
    out FuncType ( params: params, results: results );
end.

# ── Memory ────────────────────────────────────────────

entity Memory:
    initial_pages: int
    max_pages: int
    data: vec<int>
end.

func memory_new: in(initial: int) -> Memory
    out Memory ( initial_pages: initial, max_pages: 65536, data: vec_new() );
end.

func memory_grow: in(mem: Memory, pages: int) -> int
    let old = mem.initial_pages;
    mem.initial_pages = old + pages;
    out old;
end.

func memory_size: in(mem: Memory) -> int
    out mem.initial_pages;
end.

const PAGE_SIZE: 65536;

# ── Table ─────────────────────────────────────────────

entity Table:
    elements: vec<int>
    max_size: int
end.

func table_new: in(size: int) -> Table
    out Table ( elements: vec_new(), max_size: size );
end.

# ── Global ────────────────────────────────────────────

entity Global:
    value: int
    mutable: bool
    val_type: ValType
end.

# ── Module ────────────────────────────────────────────

entity WasmModule:
    name: string
    types: vec<FuncType>
    funcs: vec<int>
    tables: vec<Table>
    memories: vec<Memory>
    globals: vec<Global>
    exports: vec<Export>
end.

entity Export:
    name: string
    kind: int           # 0=func, 1=table, 2=memory, 3=global
    index: int
end.

func module_new: in(name: string) -> WasmModule
    out WasmModule (
        name: name,
        types: vec_new(),
        funcs: vec_new(),
        tables: vec_new(),
        memories: vec_new(),
        globals: vec_new(),
        exports: vec_new()
    );
end.

# ── Instructions (for AST-level WASM codegen) ────────

enum WasmOp:
    Unreachable
    Nop
    Block
    Loop
    If
    Else
    End
    Br
    BrIf
    Return
    Call
    Drop
    LocalGet
    LocalSet
    I32Const
    I64Const
    F64Const
    I64Add
    I64Sub
    I64Mul
    I64DivS
    I64RemS
    I64Eq
    I64Ne
    I64LtS
    I64GtS
    I64LeS
    I64GeS
    F64Add
    F64Sub
    F64Mul
    F64Div
end.

entity WasmInstr:
    op: WasmOp
    operand: int
end.

# ── Section IDs ───────────────────────────────────────

const SEC_TYPE: 1;
const SEC_IMPORT: 2;
const SEC_FUNCTION: 3;
const SEC_TABLE: 4;
const SEC_MEMORY: 5;
const SEC_EXPORT: 6;
const SEC_START: 8;
const SEC_ELEMENT: 9;
const SEC_CODE: 10;
const SEC_DATA: 11;

# ── LEB128 Encoding (for binary format) ──────────────

extern func wasm_encode_uleb128(value: int) out(vec);
extern func wasm_encode_sleb128(value: int) out(vec);
extern func wasm_compile_module(mod: WasmModule) out(vec);

# ── Magic & Version ───────────────────────────────────

const WASM_MAGIC_0: 0;     # \0
const WASM_MAGIC_1: 97;    # a
const WASM_MAGIC_2: 115;   # s
const WASM_MAGIC_3: 109;   # m
const WASM_VERSION: 1;

# ── Limits ────────────────────────────────────────────

const MAX_PAGES: 65536;        # 4 GB
const MAX_TABLE_SIZE: 10000000;
const MAX_LOCALS: 50000;
const MAX_FUNC_PARAMS: 1000;
