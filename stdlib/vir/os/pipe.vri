##
 * vir/os/pipe.vri — IPC Pipes
 * ==============================
 * Inspired by C: pipe(), mkfifo(), dup2()
 * Inspired by Python: os.pipe(), multiprocessing.Pipe
 *
 * Anonymous pipes for parent-child IPC, named pipes (FIFO) for
 * unrelated process communication.
 ##

include types;
include result;
import Result, Ok, Err from result;
include string;
import String, str_new from string;

# ═══════════════════════════════════════════════════════
# Pipe Entity
# ═══════════════════════════════════════════════════════

entity Pipe:
    read_fd:  int;    # File descriptor for reading
    write_fd: int;    # File descriptor for writing
end

# ═══════════════════════════════════════════════════════
# Native bindings
# ═══════════════════════════════════════════════════════

extern func native_pipe(fds: ptr) -> int
extern func native_mkfifo(path: ptr, path_len: int, mode: int) -> int
extern func native_close(fd: int) -> int
extern func native_read(fd: int, buf: ptr, count: int) -> int
extern func native_write(fd: int, buf: ptr, count: int) -> int
extern func native_dup2(old_fd: int, new_fd: int) -> int

# ═══════════════════════════════════════════════════════
# Anonymous Pipe
# ═══════════════════════════════════════════════════════

## Create an anonymous pipe.
func pipe_new:
    var fds: [int; 2];
    rc = native_pipe(&fds);
    if rc != 0:
        out Err(str_new("pipe creation failed"));
    end
    out Ok(Pipe { read_fd = fds[0], write_fd = fds[1] });
end

## Close the read end of the pipe.
func pipe_close_read:
    in(p: Pipe)
    native_close(p.read_fd);
end

## Close the write end of the pipe.
func pipe_close_write:
    in(p: Pipe)
    native_close(p.write_fd);
end

## Close both ends.
func pipe_close:
    in(p: Pipe)
    native_close(p.read_fd);
    native_close(p.write_fd);
end

## Write data to the pipe.
func pipe_write:
    in(p: Pipe; data: ptr; len: int)
    written = native_write(p.write_fd, data, len);
    if written < 0:
        out Err(str_new("pipe write failed"));
    end
    out Ok(written);
end

## Write a string to the pipe.
func pipe_write_str:
    in(p: Pipe; s: string)
    out pipe_write(p, str_ptr(s), str_byte_len(s));
end

## Read data from the pipe.
func pipe_read:
    in(p: Pipe; buf: ptr; max_len: int)
    n = native_read(p.read_fd, buf, max_len);
    if n < 0:
        out Err(str_new("pipe read failed"));
    end
    out Ok(n);
end

## Read up to max_len bytes as a string.
func pipe_read_str:
    in(p: Pipe; max_len: int)
    var buf: [int; 4096];
    actual = if max_len < 4096: max_len; else 4096; end;
    n = native_read(p.read_fd, &buf, actual);
    if n < 0:
        out Err(str_new("pipe read failed"));
    end
    out Ok(str_from_bytes(&buf, n));
end

# ═══════════════════════════════════════════════════════
# Named Pipe (FIFO)
# ═══════════════════════════════════════════════════════

## Create a named pipe (FIFO) at the given path.
## mode: permissions (e.g., 0o644 = 420)
func fifo_create:
    in(path: string; mode: int)
    rc = native_mkfifo(str_ptr(path), str_byte_len(path), mode);
    if rc != 0:
        out Err(str_new("mkfifo failed"));
    end
    out Ok(());
end

# ═══════════════════════════════════════════════════════
# File Descriptor Duplication
# ═══════════════════════════════════════════════════════

## Redirect old_fd to new_fd (e.g., redirect stdout to pipe).
func fd_dup2:
    in(old_fd: int; new_fd: int)
    rc = native_dup2(old_fd, new_fd);
    if rc < 0:
        out Err(str_new("dup2 failed"));
    end
    out Ok(rc);
end

const STDIN_FD:  0;
const STDOUT_FD: 1;
const STDERR_FD: 2;
