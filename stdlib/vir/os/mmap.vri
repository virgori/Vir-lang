##
 * vir/os/mmap.vri — Memory-Mapped Files
 * ========================================
 * Inspired by C: mmap, munmap, mprotect, msync
 * Inspired by Python: mmap module
 * Inspired by Rust: memmap2 crate
 *
 * Zero-copy file I/O via virtual memory mapping.
 ##

include types;
include result;
import Result, Ok, Err from result;
include string;
import String, str_new from string;

# ═══════════════════════════════════════════════════════
# Protection flags
# ═══════════════════════════════════════════════════════

const PROT_NONE:  0x0;
const PROT_READ:  0x1;
const PROT_WRITE: 0x2;
const PROT_EXEC:  0x4;

# ═══════════════════════════════════════════════════════
# Map flags
# ═══════════════════════════════════════════════════════

const MAP_SHARED:    0x01;    # Shared between processes
const MAP_PRIVATE:   0x02;    # Copy-on-write
const MAP_ANONYMOUS: 0x20;    # Not backed by a file
const MAP_FIXED:     0x10;    # Map at exact address

# ═══════════════════════════════════════════════════════
# Sync flags
# ═══════════════════════════════════════════════════════

const MS_ASYNC:      1;
const MS_SYNC:       4;
const MS_INVALIDATE: 2;

# ═══════════════════════════════════════════════════════
# Mmap Entity
# ═══════════════════════════════════════════════════════

entity Mmap:
    addr:   ptr,
        length: int,
        prot:   int,
        flags:  int,
        fd:     int,
        offset: int;
end.

# ═══════════════════════════════════════════════════════
# Native bindings
# ═══════════════════════════════════════════════════════

extern func native_mmap(addr: ptr, length: int, prot: int, flags: int, fd: int, offset: int) -> ptr
extern func native_munmap(addr: ptr, length: int) -> int
extern func native_mprotect(addr: ptr, length: int, prot: int) -> int
extern func native_msync(addr: ptr, length: int, flags: int) -> int

# ═══════════════════════════════════════════════════════
# API
# ═══════════════════════════════════════════════════════

## Map a file descriptor into memory.
func mmap_open:
    in  fd: int;
        length: int;
        prot: int;
        flags: int;
        offset: int
    addr = native_mmap(ptr_null(), length, prot, flags, fd, offset);
    if addr == ptr_from_int(-1) do
        out Err(str_new("mmap failed"));
    end
    out Ok(Mmap (
        addr = addr, length = length,
        prot = prot, flags = flags,
        fd = fd, offset = offset
    ));
end.
## Map a file read-only (most common use case).
func mmap_read_only(fd: int, length: int):
    out mmap_open(fd, length, PROT_READ, MAP_SHARED, 0);
end.
## Map a file read-write.
func mmap_read_write(fd: int, length: int):
    out mmap_open(fd, length, PROT_READ | PROT_WRITE, MAP_SHARED, 0);
end.
## Create anonymous mapping (not backed by file).
func mmap_anonymous(length: int, prot: int):
    out mmap_open(-1, length, prot, MAP_PRIVATE | MAP_ANONYMOUS, 0);
end.
## Unmap the region.
func mmap_close(m: Mmap):
    rc = native_munmap(m.addr, m.length);
    if rc != 0 do out Err(str_new("munmap failed")) end
    out Ok(());
end.
## Sync mapped memory to disk.
func mmap_sync(m: Mmap, flags: int):
    rc = native_msync(m.addr, m.length, flags);
    if rc != 0 do out Err(str_new("msync failed")) end
    out Ok(());
end.
## Flush changes to disk (blocking).
func mmap_flush(m: Mmap):
    out mmap_sync(m, MS_SYNC);
end.
## Change protection flags on mapped region.
func mmap_protect(m: Mmap, prot: int):
    rc = native_mprotect(m.addr, m.length, prot);
    if rc != 0 do out Err(str_new("mprotect failed")) end
    m.prot = prot;
    out Ok(());
end.
## Read a byte at offset.
func mmap_read_byte(m: Mmap, offset: int):
    if offset < 0 | offset >= m.length do
        out Err(str_new("mmap offset out of bounds"));
    end
    out Ok(native_load_u8(ptr_add(m.addr, offset)));
end.
## Write a byte at offset.
func mmap_write_byte:
    in  m: Mmap;
        offset: int;
        val: int
    if offset < 0 | offset >= m.length do
        out Err(str_new("mmap offset out of bounds"));
    end
    native_store_u8(ptr_add(m.addr, offset), val);
    out Ok(());
end.
## Read an int (8 bytes) at offset.
func mmap_read_i64(m: Mmap, offset: int):
    if offset < 0 | offset + 8 > m.length do
        out Err(str_new("mmap offset out of bounds"));
    end
    out Ok(native_load_i64(ptr_add(m.addr, offset)));
end.
## Write an int (8 bytes) at offset.
func mmap_write_i64:
    in  m: Mmap;
        offset: int;
        val: int
    if offset < 0 | offset + 8 > m.length do
        out Err(str_new("mmap offset out of bounds"));
    end
    native_store_i64(ptr_add(m.addr, offset), val);
    out Ok(());
end.
## Get the raw pointer into the mapped region at offset.
func mmap_ptr_at(m: Mmap, offset: int):
    if offset < 0 | offset >= m.length do
        out Err(str_new("mmap offset out of bounds"));
    end
    out Ok(ptr_add(m.addr, offset));
end.
## Get the mapped region length.
func mmap_len(m: Mmap):
    out m.length;
end.