##
 * vir/os/signal.vri — Signal Handling
 * =====================================
 * Inspired by C: signal.h, sigaction
 * Inspired by Python: signal module
 * Inspired by Rust: signal-hook crate
 *
 * POSIX signal handling: register handlers, block/unblock signals.
 ##

include types;
include result;
import Result, Ok, Err from result;
include option;
import Option, Some, None from option;
include string;
import String, str_new from string;
include vec;
import Vec, vec_new, vec_push from vec;

# ═══════════════════════════════════════════════════════
# Signal constants (POSIX)
# ═══════════════════════════════════════════════════════

const SIGHUP:    1;
const SIGINT:    2;
const SIGQUIT:   3;
const SIGILL:    4;
const SIGTRAP:   5;
const SIGABRT:   6;
const SIGFPE:    8;
const SIGKILL:   9;
const SIGUSR1:  10;
const SIGSEGV:  11;
const SIGUSR2:  12;
const SIGPIPE:  13;
const SIGALRM:  14;
const SIGTERM:  15;
const SIGCHLD:  17;
const SIGCONT:  18;
const SIGSTOP:  19;
const SIGTSTP:  20;
const SIGWINCH: 28;

# ═══════════════════════════════════════════════════════
# Signal Set
# ═══════════════════════════════════════════════════════

entity SignalSet:
    mask: int;   # bitmask of signal numbers
end
func sigset_new:
    out SignalSet ( mask = 0 );
end
func sigset_add:
    in(ss: SignalSet; sig: int)
    ss.mask = ss.mask | (1 << sig);
end
func sigset_remove:
    in(ss: SignalSet; sig: int)
    ss.mask = ss.mask & ~(1 << sig);
end
func sigset_contains:
    in(ss: SignalSet; sig: int)
    out (ss.mask & (1 << sig)) != 0;
end
func sigset_fill:
    out SignalSet ( mask = 0x7FFFFFFF );
end
# ═══════════════════════════════════════════════════════
# Signal Handlers
# ═══════════════════════════════════════════════════════

extern func native_signal_register(sig: int, handler: ptr) -> int
extern func native_signal_reset(sig: int) -> int
extern func native_signal_ignore(sig: int) -> int
extern func native_signal_raise(sig: int) -> int
extern func native_signal_pending() -> int
extern func native_sigprocmask_block(mask: int) -> int
extern func native_sigprocmask_unblock(mask: int) -> int

## Register a callback for the given signal.
## Note: SIGKILL and SIGSTOP cannot be caught.
func signal_on:
    in(sig: int; handler: func(int))
    if sig == SIGKILL | sig == SIGSTOP do
        out Err(str_new("cannot catch SIGKILL or SIGSTOP"));
    end
    rc = native_signal_register(sig, handler);
    if rc != 0 do out Err(str_new("signal_register failed")) end
    out Ok(());
end
## Reset signal to default behavior.
func signal_reset:
    in(sig: int)
    rc = native_signal_reset(sig);
    if rc != 0 do out Err(str_new("signal_reset failed")) end
    out Ok(());
end
## Ignore the given signal.
func signal_ignore:
    in(sig: int)
    rc = native_signal_ignore(sig);
    if rc != 0 do out Err(str_new("signal_ignore failed")) end
    out Ok(());
end
## Raise a signal in the current process.
func signal_raise:
    in(sig: int)
    rc = native_signal_raise(sig);
    if rc != 0 do out Err(str_new("signal_raise failed")) end
    out Ok(());
end
# ═══════════════════════════════════════════════════════
# Signal Blocking
# ═══════════════════════════════════════════════════════

## Block all signals in the set (no delivery until unblocked).
func signal_block:
    in(ss: SignalSet)
    native_sigprocmask_block(ss.mask);
end
## Unblock all signals in the set.
func signal_unblock:
    in(ss: SignalSet)
    native_sigprocmask_unblock(ss.mask);
end
# ═══════════════════════════════════════════════════════
# Atomic flag-based signal handling (safe pattern)
# ═══════════════════════════════════════════════════════

## A thread-safe flag set by a signal handler, polled by main loop.
entity SignalFlag:
    _flag: ptr;   # atomic int
end

extern func native_atomic_alloc() -> ptr
extern func native_atomic_load(p: ptr) -> int
extern func native_atomic_store(p: ptr, val: int)

func signal_flag_new:
    p = native_atomic_alloc();
    native_atomic_store(p, 0);
    out SignalFlag ( _flag = p );
end
## Check if the flag has been raised, and reset it.
func signal_flag_check:
    in(sf: SignalFlag)
    val = native_atomic_load(sf._flag);
    if val != 0 do
        native_atomic_store(sf._flag, 0);
        out true;
    end
    out false;
end
## Register the flag to be raised on given signal.
func signal_flag_register:
    in(sf: SignalFlag; sig: int)
    handler = lambda(s: int)
        native_atomic_store(sf._flag, 1);
    end;
    native_signal_register(sig, handler);
end
# ═══════════════════════════════════════════════════════
# Common patterns
# ═══════════════════════════════════════════════════════

## Setup graceful shutdown: returns a flag raised on SIGTERM/SIGINT.
func signal_shutdown_flag:
    sf = signal_flag_new();
    signal_flag_register(sf, SIGTERM);
    signal_flag_register(sf, SIGINT);
    out sf;
end
## Get signal name as string.
func signal_name:
    in(sig: int)
    if sig == SIGHUP do out str_new("SIGHUP") end
    if sig == SIGINT do out str_new("SIGINT") end
    if sig == SIGQUIT do out str_new("SIGQUIT") end
    if sig == SIGILL do out str_new("SIGILL") end
    if sig == SIGTRAP do out str_new("SIGTRAP") end
    if sig == SIGABRT do out str_new("SIGABRT") end
    if sig == SIGFPE do out str_new("SIGFPE") end
    if sig == SIGKILL do out str_new("SIGKILL") end
    if sig == SIGUSR1 do out str_new("SIGUSR1") end
    if sig == SIGSEGV do out str_new("SIGSEGV") end
    if sig == SIGUSR2 do out str_new("SIGUSR2") end
    if sig == SIGPIPE do out str_new("SIGPIPE") end
    if sig == SIGALRM do out str_new("SIGALRM") end
    if sig == SIGTERM do out str_new("SIGTERM") end
    if sig == SIGCHLD do out str_new("SIGCHLD") end
    if sig == SIGCONT do out str_new("SIGCONT") end
    if sig == SIGSTOP do out str_new("SIGSTOP") end
    if sig == SIGTSTP do out str_new("SIGTSTP") end
    if sig == SIGWINCH do out str_new("SIGWINCH") end
    out str_new("UNKNOWN");
end