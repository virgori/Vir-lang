##
 * vir/embedded/barrier.vri — Hardware Barriers, Synchronization & Sleep
 * =======================================================================
 * Low-level CPU synchronization, data/instruction barriers, and power-saving
 * sleep state instructions (WFI, WFE, SEV) for embedded and IoT platforms.
 ##

# Full System Data Memory Barrier
func memory_barrier():
    dmb()
end.

# Full System Data Synchronization Barrier
func data_sync_barrier():
    dsb()
end.

# Instruction Synchronization Barrier
func instruction_sync_barrier():
    isb()
end.

# Wait For Interrupt (Sleep CPU until next IRQ)
func wait_for_interrupt():
    wfi()
end.

# Wait For Event
func wait_for_event():
    wfe()
end.

# Send Event
func send_event():
    sev()
end.

# Delay loop executing NOP instructions
func delay_cycles(cycles: int):
    var i = 0
    when i < cycles loop
        nop()
        i = i + 1
    end
end.

export memory_barrier, data_sync_barrier, instruction_sync_barrier, wait_for_interrupt, wait_for_event, send_event, delay_cycles
