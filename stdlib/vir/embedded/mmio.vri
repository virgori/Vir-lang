##
 * vir/embedded/mmio.vri — Memory-Mapped I/O Hardware Register Accessors
 * ======================================================================
 * Provides robust, volatile-guaranteed accessors for hardware peripherals,
 * memory-mapped control registers, and bit-level manipulations.
 ##

# Read 32-bit register with memory barrier
func read_reg32(addr: int):
    out volatile_read32(addr)
end.

# Write 32-bit register with memory barrier
func write_reg32(addr: int, val: int):
    volatile_write32(addr, val)
end.

# Read 8-bit byte register
func read_reg8(addr: int):
    out volatile_read8(addr)
end.

# Write 8-bit byte register
func write_reg8(addr: int, val: int):
    volatile_write8(addr, val)
end.

# Read 16-bit halfword register
func read_reg16(addr: int):
    out volatile_read16(addr)
end.

# Write 16-bit halfword register
func write_reg16(addr: int, val: int):
    volatile_write16(addr, val)
end.

# Read 64-bit doubleword register
func read_reg64(addr: int):
    out volatile_read64(addr)
end.

# Write 64-bit doubleword register
func write_reg64(addr: int, val: int):
    volatile_write64(addr, val)
end.

# Atomic-like bit set on 32-bit MMIO register
func set_bits32(addr: int, mask: int):
    var curr = volatile_read32(addr)
    volatile_write32(addr, curr or mask)
end.

# Atomic-like bit clear on 32-bit MMIO register
func clear_bits32(addr: int, mask: int):
    var curr = volatile_read32(addr)
    var inv_mask = (0 - 1) xor mask
    volatile_write32(addr, curr and inv_mask)
end.

# Atomic-like bit toggle on 32-bit MMIO register
func toggle_bits32(addr: int, mask: int):
    var curr = volatile_read32(addr)
    volatile_write32(addr, curr xor mask)
end.

export read_reg32, write_reg32, read_reg8, write_reg8, read_reg16, write_reg16, read_reg64, write_reg64, set_bits32, clear_bits32, toggle_bits32

