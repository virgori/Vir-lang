##
 * vir/image/image.vri — Image Buffer & Processing
 * ==================================================
 * Inspired by Python: Pillow (PIL)
 * Inspired by Rust: image crate
 * Inspired by C: stb_image
 *
 * Core image types, pixel operations, basic transforms.
 * Format-specific codecs are in separate modules (png.vri, etc.)
 ##

include types;
include result;
import Result, Ok, Err from result;
include option;
import Option, Some, None from option;
include string;
import String, str_new from string;
include vec;
import Vec, vec_new, vec_push, vec_len, vec_get from vec;
include math;
import min, max, abs_f, floor, clamp from math;

# ═══════════════════════════════════════════════════════
# Pixel Types
# ═══════════════════════════════════════════════════════

entity Rgba:
    r: int;   # 0-255
    g: int;
    b: int;
    a: int;   # 0-255 (255 = opaque)
end

entity Rgb:
    r: int;
    g: int;
    b: int;
end

func rgba:
    in(r: int; g: int; b: int; a: int)
    out Rgba { r = r, g = g, b = b, a = a };
end

func rgb:
    in(r: int; g: int; b: int)
    out Rgb { r = r, g = g, b = b };
end

func rgba_from_rgb:
    in(c: Rgb)
    out Rgba { r = c.r, g = c.g, b = c.b, a = 255 };
end

func rgb_from_rgba:
    in(c: Rgba)
    out Rgb { r = c.r, g = c.g, b = c.b };
end

# ═══════════════════════════════════════════════════════
# Image Buffer
# ═══════════════════════════════════════════════════════

enum PixelFormat:
    FormatRgba = 4;    # 4 bytes per pixel
    FormatRgb  = 3;    # 3 bytes per pixel
    FormatGray = 1;    # 1 byte per pixel
end

entity Image:
    width:    int;
    height:   int;
    format:   PixelFormat;
    data:     Vec<int>;    # raw pixel bytes
end

## Create a new blank image.
func image_new:
    in(width: int; height: int; format: PixelFormat)
    bpp = format;
    total = width * height * bpp;
    data = vec_new<int>();
    i = 0;
    when i < total loop
        vec_push<int>(&data, 0);
        i = i + 1;
    end
    out Image { width = width, height = height, format = format, data = data };
end

## Create an image filled with a color.
func image_fill:
    in(width: int; height: int; color: Rgba)
    img = image_new(width, height, PixelFormat.FormatRgba);
    i = 0;
    total = width * height;
    when i < total loop
        offset = i * 4;
        img.data[offset]     = color.r;
        img.data[offset + 1] = color.g;
        img.data[offset + 2] = color.b;
        img.data[offset + 3] = color.a;
        i = i + 1;
    end
    out img;
end

# ═══════════════════════════════════════════════════════
# Pixel Access
# ═══════════════════════════════════════════════════════

## Get pixel at (x, y).
func image_get_pixel:
    in(img: Image; x: int; y: int)
    if x < 0 | x >= img.width | y < 0 | y >= img.height:
        out Rgba { r = 0, g = 0, b = 0, a = 0 };
    end
    bpp = img.format;
    offset = (y * img.width + x) * bpp;
    if bpp == 4:
        out Rgba {
            r = vec_get<int>(img.data, offset),
            g = vec_get<int>(img.data, offset + 1),
            b = vec_get<int>(img.data, offset + 2),
            a = vec_get<int>(img.data, offset + 3)
        };
    elif bpp == 3:
        out Rgba {
            r = vec_get<int>(img.data, offset),
            g = vec_get<int>(img.data, offset + 1),
            b = vec_get<int>(img.data, offset + 2),
            a = 255
        };
    else
        v = vec_get<int>(img.data, offset);
        out Rgba { r = v, g = v, b = v, a = 255 };
    end
end

## Set pixel at (x, y).
func image_set_pixel:
    in(img: Image; x: int; y: int; color: Rgba)
    if x < 0 | x >= img.width | y < 0 | y >= img.height:
        out;
    end
    bpp = img.format;
    offset = (y * img.width + x) * bpp;
    if bpp >= 3:
        img.data[offset]     = color.r;
        img.data[offset + 1] = color.g;
        img.data[offset + 2] = color.b;
    end
    if bpp == 4:
        img.data[offset + 3] = color.a;
    end
    if bpp == 1:
        # Grayscale = luminance
        gray = (color.r * 299 + color.g * 587 + color.b * 114) / 1000;
        img.data[offset] = gray;
    end
end

# ═══════════════════════════════════════════════════════
# Basic Transforms
# ═══════════════════════════════════════════════════════

## Crop a sub-region.
func image_crop:
    in(img: Image; x: int; y: int; w: int; h: int)
    out_img = image_new(w, h, img.format);
    dy = 0;
    when dy < h loop
        dx = 0;
        when dx < w loop
            px = image_get_pixel(img, x + dx, y + dy);
            image_set_pixel(out_img, dx, dy, px);
            dx = dx + 1;
        end
        dy = dy + 1;
    end
    out out_img;
end

## Resize using nearest-neighbor interpolation.
func image_resize:
    in(img: Image; new_w: int; new_h: int)
    out_img = image_new(new_w, new_h, img.format);
    dy = 0;
    when dy < new_h loop
        src_y = (dy * img.height) / new_h;
        dx = 0;
        when dx < new_w loop
            src_x = (dx * img.width) / new_w;
            px = image_get_pixel(img, src_x, src_y);
            image_set_pixel(out_img, dx, dy, px);
            dx = dx + 1;
        end
        dy = dy + 1;
    end
    out out_img;
end

## Flip horizontally.
func image_flip_h:
    in(img: Image)
    out_img = image_new(img.width, img.height, img.format);
    y = 0;
    when y < img.height loop
        x = 0;
        when x < img.width loop
            px = image_get_pixel(img, img.width - 1 - x, y);
            image_set_pixel(out_img, x, y, px);
            x = x + 1;
        end
        y = y + 1;
    end
    out out_img;
end

## Flip vertically.
func image_flip_v:
    in(img: Image)
    out_img = image_new(img.width, img.height, img.format);
    y = 0;
    when y < img.height loop
        x = 0;
        when x < img.width loop
            px = image_get_pixel(img, x, img.height - 1 - y);
            image_set_pixel(out_img, x, y, px);
            x = x + 1;
        end
        y = y + 1;
    end
    out out_img;
end

## Rotate 90° clockwise.
func image_rotate_90:
    in(img: Image)
    out_img = image_new(img.height, img.width, img.format);
    y = 0;
    when y < img.height loop
        x = 0;
        when x < img.width loop
            px = image_get_pixel(img, x, y);
            image_set_pixel(out_img, img.height - 1 - y, x, px);
            x = x + 1;
        end
        y = y + 1;
    end
    out out_img;
end

# ═══════════════════════════════════════════════════════
# Color Adjustments
# ═══════════════════════════════════════════════════════

## Convert to grayscale.
func image_grayscale:
    in(img: Image)
    out_img = image_new(img.width, img.height, PixelFormat.FormatGray);
    y = 0;
    when y < img.height loop
        x = 0;
        when x < img.width loop
            px = image_get_pixel(img, x, y);
            gray = (px.r * 299 + px.g * 587 + px.b * 114) / 1000;
            out_img.data[y * img.width + x] = gray;
            x = x + 1;
        end
        y = y + 1;
    end
    out out_img;
end

## Adjust brightness (-255 to +255).
func image_brightness:
    in(img: Image; amount: int)
    out_img = image_new(img.width, img.height, img.format);
    y = 0;
    when y < img.height loop
        x = 0;
        when x < img.width loop
            px = image_get_pixel(img, x, y);
            nr = _clamp_byte(px.r + amount);
            ng = _clamp_byte(px.g + amount);
            nb = _clamp_byte(px.b + amount);
            image_set_pixel(out_img, x, y, Rgba { r = nr, g = ng, b = nb, a = px.a });
            x = x + 1;
        end
        y = y + 1;
    end
    out out_img;
end

## Invert colors.
func image_invert:
    in(img: Image)
    out_img = image_new(img.width, img.height, img.format);
    y = 0;
    when y < img.height loop
        x = 0;
        when x < img.width loop
            px = image_get_pixel(img, x, y);
            image_set_pixel(out_img, x, y,
                Rgba { r = 255 - px.r, g = 255 - px.g, b = 255 - px.b, a = px.a });
            x = x + 1;
        end
        y = y + 1;
    end
    out out_img;
end

func _clamp_byte:
    in(v: int)
    if v < 0 out 0 end:
    if v > 255 out 255 end:
    out v;
end

# ═══════════════════════════════════════════════════════
# Drawing Primitives
# ═══════════════════════════════════════════════════════

## Draw a filled rectangle.
func image_draw_rect:
    in(img: Image; x: int; y: int; w: int; h: int; color: Rgba)
    dy = 0;
    when dy < h loop
        dx = 0;
        when dx < w loop
            image_set_pixel(img, x + dx, y + dy, color);
            dx = dx + 1;
        end
        dy = dy + 1;
    end
end

## Draw a line (Bresenham's algorithm).
func image_draw_line:
    in(img: Image; x0: int; y0: int; x1: int; y1: int; color: Rgba)
    dx = if x1 > x0: x1 - x0; else x0 - x1; end;
    dy = if y1 > y0: y1 - y0; else y0 - y1; end;
    sx = if x0 < x1: 1; else -1; end;
    sy = if y0 < y1: 1; else -1; end;
    err = dx - dy;

    cx = x0; cy = y0;
    loop
        image_set_pixel(img, cx, cy, color);
        if cx == x1 & cy == y1 break end:
        e2 = 2 * err;
        if e2 > -dy:
            err = err - dy;
            cx = cx + sx;
        end
        if e2 < dx:
            err = err + dx;
            cy = cy + sy;
        end
    end
end

## Draw a circle outline (midpoint algorithm).
func image_draw_circle:
    in(img: Image; cx: int; cy: int; radius: int; color: Rgba)
    x = radius; y = 0;
    d = 1 - radius;
    when x >= y loop
        image_set_pixel(img, cx + x, cy + y, color);
        image_set_pixel(img, cx - x, cy + y, color);
        image_set_pixel(img, cx + x, cy - y, color);
        image_set_pixel(img, cx - x, cy - y, color);
        image_set_pixel(img, cx + y, cy + x, color);
        image_set_pixel(img, cx - y, cy + x, color);
        image_set_pixel(img, cx + y, cy - x, color);
        image_set_pixel(img, cx - y, cy - x, color);
        y = y + 1;
        if d <= 0:
            d = d + 2 * y + 1;
        else
            x = x - 1;
            d = d + 2 * (y - x) + 1;
        end
    end
end
