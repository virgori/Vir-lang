##
 * vir/image/png.vri — PNG Encoder / Decoder
 * ============================================
 * Inspired by C: libpng, stb_image_write
 * Inspired by Python: Pillow PNG
 * Inspired by Rust: png crate
 *
 * PNG (Portable Network Graphics) read/write.
 * Supports RGBA, RGB, Grayscale. Uses Deflate compression.
 ##

include types;
include result;
import Result, Ok, Err from result;
include string;
import String, str_new from string;
include vec;
import Vec, vec_new, vec_push, vec_len, vec_get from vec;
include image;
import Image, image_new, PixelFormat, Rgba from image;
include compress;
import zlib_deflate, zlib_inflate from compress;

# ═══════════════════════════════════════════════════════
# PNG Constants
# ═══════════════════════════════════════════════════════

# PNG magic bytes: 137 80 78 71 13 10 26 10
const PNG_MAGIC_0: 0x89;
const PNG_MAGIC_1: 0x50;   # P
const PNG_MAGIC_2: 0x4E;   # N
const PNG_MAGIC_3: 0x47;   # G
const PNG_MAGIC_4: 0x0D;
const PNG_MAGIC_5: 0x0A;
const PNG_MAGIC_6: 0x1A;
const PNG_MAGIC_7: 0x0A;

# Color types
const PNG_GRAYSCALE:       0;
const PNG_RGB:             2;
const PNG_PALETTE:         3;
const PNG_GRAYSCALE_ALPHA: 4;
const PNG_RGBA:            6;

# ═══════════════════════════════════════════════════════
# CRC32 (for chunk verification)
# ═══════════════════════════════════════════════════════

var _crc32_table: [int; 256];
var _crc32_init: bool = false;

func _crc32_ensure_table:
    if _crc32_init out end:
    i = 0;
    when i < 256 loop
        c = i;
        j = 0;
        when j < 8 loop
            if (c & 1) != 0:
                c = 0xEDB88320 ^ (c >> 1);
            else
                c = c >> 1;
            end
            j = j + 1;
        end
        _crc32_table[i] = c & 0xFFFFFFFF;
        i = i + 1;
    end
    _crc32_init = true;
end

func _crc32:
    in(data: Vec<int>)
    _crc32_ensure_table();
    crc = 0xFFFFFFFF;
    i = 0;
    when i < vec_len<int>(data) loop
        b = vec_get<int>(data, i);
        crc = _crc32_table[(crc ^ b) & 0xFF] ^ (crc >> 8);
        i = i + 1;
    end
    out (crc ^ 0xFFFFFFFF) & 0xFFFFFFFF;
end

# ═══════════════════════════════════════════════════════
# PNG Encoder
# ═══════════════════════════════════════════════════════

## Encode an Image as PNG bytes.
func png_encode:
    in(img: Image)
    buf = vec_new<int>();

    # PNG signature
    vec_push<int>(&buf, PNG_MAGIC_0);
    vec_push<int>(&buf, PNG_MAGIC_1);
    vec_push<int>(&buf, PNG_MAGIC_2);
    vec_push<int>(&buf, PNG_MAGIC_3);
    vec_push<int>(&buf, PNG_MAGIC_4);
    vec_push<int>(&buf, PNG_MAGIC_5);
    vec_push<int>(&buf, PNG_MAGIC_6);
    vec_push<int>(&buf, PNG_MAGIC_7);

    # IHDR chunk
    color_type = if img.format == PixelFormat.FormatRgba: PNG_RGBA;
                 elif img.format == PixelFormat.FormatRgb: PNG_RGB;
                 else PNG_GRAYSCALE;
                 end;
    ihdr = _png_build_ihdr(img.width, img.height, 8, color_type);
    _png_write_chunk(&buf, str_new("IHDR"), ihdr);

    # IDAT chunk — raw pixel data with filter byte per row
    raw = _png_build_raw_data(img);
    compressed = zlib_deflate(raw);
    _png_write_chunk(&buf, str_new("IDAT"), compressed);

    # IEND chunk
    _png_write_chunk(&buf, str_new("IEND"), vec_new<int>());

    out buf;
end

func _png_build_ihdr:
    in(width: int; height: int; bit_depth: int; color_type: int)
    ihdr = vec_new<int>();
    # Width (4 bytes big-endian)
    vec_push<int>(&ihdr, (width >> 24) & 0xFF);
    vec_push<int>(&ihdr, (width >> 16) & 0xFF);
    vec_push<int>(&ihdr, (width >> 8) & 0xFF);
    vec_push<int>(&ihdr, width & 0xFF);
    # Height (4 bytes big-endian)
    vec_push<int>(&ihdr, (height >> 24) & 0xFF);
    vec_push<int>(&ihdr, (height >> 16) & 0xFF);
    vec_push<int>(&ihdr, (height >> 8) & 0xFF);
    vec_push<int>(&ihdr, height & 0xFF);
    # Bit depth
    vec_push<int>(&ihdr, bit_depth);
    # Color type
    vec_push<int>(&ihdr, color_type);
    # Compression, Filter, Interlace (all 0)
    vec_push<int>(&ihdr, 0);
    vec_push<int>(&ihdr, 0);
    vec_push<int>(&ihdr, 0);
    out ihdr;
end

func _png_build_raw_data:
    in(img: Image)
    raw = vec_new<int>();
    bpp = img.format;
    y = 0;
    when y < img.height loop
        vec_push<int>(&raw, 0);  # filter byte: None
        x = 0;
        when x < img.width loop
            offset = (y * img.width + x) * bpp;
            k = 0;
            when k < bpp loop
                vec_push<int>(&raw, vec_get<int>(img.data, offset + k));
                k = k + 1;
            end
            x = x + 1;
        end
        y = y + 1;
    end
    out raw;
end

func _png_write_chunk:
    in(buf: ptr; name: string; data: Vec<int>)
    dlen = vec_len<int>(data);
    # Length (4 bytes big-endian)
    vec_push<int>(buf, (dlen >> 24) & 0xFF);
    vec_push<int>(buf, (dlen >> 16) & 0xFF);
    vec_push<int>(buf, (dlen >> 8) & 0xFF);
    vec_push<int>(buf, dlen & 0xFF);
    # Chunk type (4 bytes)
    i = 0;
    crc_data = vec_new<int>();
    when i < 4 loop
        b = native_load_u8(ptr_add(str_ptr(name), i));
        vec_push<int>(buf, b);
        vec_push<int>(&crc_data, b);
        i = i + 1;
    end
    # Chunk data
    j = 0;
    when j < dlen loop
        b = vec_get<int>(data, j);
        vec_push<int>(buf, b);
        vec_push<int>(&crc_data, b);
        j = j + 1;
    end
    # CRC32
    crc = _crc32(crc_data);
    vec_push<int>(buf, (crc >> 24) & 0xFF);
    vec_push<int>(buf, (crc >> 16) & 0xFF);
    vec_push<int>(buf, (crc >> 8) & 0xFF);
    vec_push<int>(buf, crc & 0xFF);
end

# ═══════════════════════════════════════════════════════
# PNG Decoder
# ═══════════════════════════════════════════════════════

## Decode PNG bytes into an Image.
func png_decode:
    in(data: Vec<int>)
    dlen = vec_len<int>(data);
    if dlen < 8:
        out Err(str_new("PNG: too short"));
    end
    # Verify magic
    if vec_get<int>(data, 0) != PNG_MAGIC_0 | vec_get<int>(data, 1) != PNG_MAGIC_1:
        out Err(str_new("PNG: invalid magic"));
    end

    # Parse chunks
    pos = 8;
    width = 0; height = 0; color_type = 0; bit_depth = 0;
    idat_data = vec_new<int>();

    when pos + 8 <= dlen loop
        chunk_len = (vec_get<int>(data, pos) << 24) | (vec_get<int>(data, pos+1) << 16)
                  | (vec_get<int>(data, pos+2) << 8) | vec_get<int>(data, pos+3);
        pos = pos + 4;

        # Chunk type
        t0 = vec_get<int>(data, pos);
        t1 = vec_get<int>(data, pos+1);
        t2 = vec_get<int>(data, pos+2);
        t3 = vec_get<int>(data, pos+3);
        pos = pos + 4;

        # IHDR
        if t0 == 0x49 & t1 == 0x48 & t2 == 0x44 & t3 == 0x52:
            width = (vec_get<int>(data, pos) << 24) | (vec_get<int>(data, pos+1) << 16)
                  | (vec_get<int>(data, pos+2) << 8) | vec_get<int>(data, pos+3);
            height = (vec_get<int>(data, pos+4) << 24) | (vec_get<int>(data, pos+5) << 16)
                   | (vec_get<int>(data, pos+6) << 8) | vec_get<int>(data, pos+7);
            bit_depth = vec_get<int>(data, pos+8);
            color_type = vec_get<int>(data, pos+9);
        end

        # IDAT — accumulate compressed data
        if t0 == 0x49 & t1 == 0x44 & t2 == 0x41 & t3 == 0x54:
            k = 0;
            when k < chunk_len loop
                vec_push<int>(&idat_data, vec_get<int>(data, pos + k));
                k = k + 1;
            end
        end

        # IEND
        if t0 == 0x49 & t1 == 0x45 & t2 == 0x4E & t3 == 0x44:
            break;
        end

        pos = pos + chunk_len + 4;  # skip data + CRC
    end

    # Decompress IDAT
    raw = zlib_inflate(idat_data);

    # Determine format
    fmt = if color_type == PNG_RGBA: PixelFormat.FormatRgba;
          elif color_type == PNG_RGB: PixelFormat.FormatRgb;
          else PixelFormat.FormatGray;
          end;
    bpp = fmt;

    img = image_new(width, height, fmt);
    src_pos = 0;
    y = 0;
    when y < height loop
        filter_byte = vec_get<int>(raw, src_pos);
        src_pos = src_pos + 1;
        x = 0;
        when x < width * bpp loop
            img.data[y * width * bpp + x] = vec_get<int>(raw, src_pos);
            src_pos = src_pos + 1;
            x = x + 1;
        end
        y = y + 1;
    end

    out Ok(img);
end
