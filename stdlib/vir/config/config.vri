##
 * vir/config/config.vri — Configuration File Parser
 * ====================================================
 * Inspired by Python: configparser, tomllib
 *
 * Hỗ trợ: INI/TOML-like format, environment variable override.
 * Phase C — production config management
 ##

include types;
include option;
import Option, Some, None from option;
include result;
import Result, Ok, Err from result;
include string;
import String, str_new, str_eq, str_byte_at, str_byte_len, str_slice_bytes, str_trim, str_starts_with, str_contains, str_find from string;
include builder;
import StringBuilder, sb_new, sb_append, sb_build from builder;
include map;
import Map, map_new, map_set, map_get, map_keys, map_contains from map;
include vec;
import Vec, vec_new, vec_push, vec_len, vec_get from vec;
include file;
import file_read_string from file;
include env;
import env_var from env;

# ═══════════════════════════════════════════════════════
# Config Value
# ═══════════════════════════════════════════════════════

enum ConfigValue:
    Str(string);
    Int(int);
    Float(float);
    Bool(bool);
    Array(Vec<ConfigValue>);
    Table(Map<string, ConfigValue>);
end.
entity Config:
    sections: Map<string, Map<string, ConfigValue>>;
end.

# ═══════════════════════════════════════════════════════
# Create & Access
# ═══════════════════════════════════════════════════════

func config_new:
    out Config ( sections = map_new<string, Map<string, ConfigValue>>() );
end.
func config_set:
    in  cfg: Config;
        section: string;
        key: string;
        val: ConfigValue
    sec = map_get(&cfg.sections, section);
    case sec;
        None:
            m = map_new<string, ConfigValue>();
            map_set(&m, key, val);
            map_set(&cfg.sections, section, m);
        Some(m):
            map_set(&m, key, val);
    end
end.
func config_get:
    in  cfg: Config;
        section: string;
        key: string
    sec = map_get(cfg.sections, section);
    case sec;
        None: out None;
        Some(m): out map_get(m, key);
    end
end.
func config_get_str:
    in  cfg: Config;
        section: string;
        key: string
    val = config_get(cfg, section, key);
    case val;
        case Some(ConfigValue.Str(s)) out Some(s)
        default out None;
    end
end.
func config_get_int:
    in  cfg: Config;
        section: string;
        key: string
    val = config_get(cfg, section, key);
    case val;
        case Some(ConfigValue.Int(n)) out Some(n)
        default out None;
    end
end.
func config_get_bool:
    in  cfg: Config;
        section: string;
        key: string
    val = config_get(cfg, section, key);
    case val;
        case Some(ConfigValue.Bool(b)) out Some(b)
        default out None;
    end
end.
func config_get_or:
    in  cfg: Config;
        section: string;
        key: string;
        default: string
    val = config_get_str(cfg, section, key);
    case val;
        Some(s): out s;
        None: out default;
    end
end.
# ═══════════════════════════════════════════════════════
# INI Parser
# ═══════════════════════════════════════════════════════

func config_from_ini(text: string):
    cfg = config_new();
    current_section = str_new("default");
    lines = str_split(text, str_new("\n"));
    i = 0;
    
    when i < vec_len<String>(lines) loop
        line = str_trim(vec_get<string>(lines, i));
        len = str_byte_len(line);
        
        # Skip empty lines and comments
        if len == 0 or str_byte_at(line, 0) == 0x23 or str_byte_at(line, 0) == 0x3B do
            i = i + 1;
            skip;
        end
        
        # Section header: [section]
        if str_byte_at(line, 0) == 0x5B do
            if str_byte_at(line, len - 1) != 0x5D do
                out Err(str_concat(str_new("invalid section header: "), line));
            end
            current_section = str_trim(str_slice_bytes(line, 1, len - 1));
            i = i + 1;
            skip;
        end
        
        # Key = Value
        eq_idx = str_find(line, str_new("="));
        case eq_idx;
        None: out Err(str_concat(str_new("invalid line: "), line));;
        Some(idx):
                key = str_trim(str_slice_bytes(line, 0, idx));
                val_str = str_trim(str_slice_bytes(line, idx + 1, len));
                val = _parse_ini_value(val_str);
                config_set(&cfg, current_section, key, val);
        end
        i = i + 1;
    end
    
    out Ok(cfg);
end.
func _parse_ini_value(s: string):
    # Boolean
    if str_eq(s, str_new("true")) or str_eq(s, str_new("yes")) or str_eq(s, str_new("on")) do
        out ConfigValue.Bool(true);
    end
    if str_eq(s, str_new("false")) or str_eq(s, str_new("no")) or str_eq(s, str_new("off")) do
        out ConfigValue.Bool(false);
    end
    
    # Quoted string
    len = str_byte_len(s);
    if len >= 2 do
        first = str_byte_at(s, 0);
        last = str_byte_at(s, len - 1);
        if (first == 0x22 and last == 0x22) or (first == 0x27 and last == 0x27) do
            out ConfigValue.Str(str_slice_bytes(s, 1, len - 1));
        end
    end
    
    # Integer
    is_int = true;
    i = 0;
    if len > 0 and (str_byte_at(s, 0) == 0x2D or str_byte_at(s, 0) == 0x2B) do i = 1 end
    when i < len loop
        b = str_byte_at(s, i);
        if b < 0x30 or b > 0x39 do is_int = false; break end
        i = i + 1;
    end
    if is_int and len > 0 do
        out ConfigValue.Int(str_to_i64(s));
    end
    
    # Default: string
    out ConfigValue.Str(s);
end.
# ═══════════════════════════════════════════════════════
# Load from file with env override
# ═══════════════════════════════════════════════════════

func config_load(path: string):
    text_result = file_read_string(path);
    case text_result;
        Err(e): out Err(e);
        Ok(text): out config_from_ini(text);
    end
end.
func config_get_with_env:
    in  cfg: Config;
        section: string;
        key: string;
        env_key: string
    # Environment override takes priority
    env_val = env_var(env_key);
    case env_val;
        Some(v): out Some(v);
        None: out config_get_str(cfg, section, key);
    end
end.
# ═══════════════════════════════════════════════════════
# Serialize config back to INI
# ═══════════════════════════════════════════════════════

func config_to_ini(cfg: Config):
    sb = sb_new();
    sections = map_keys(cfg.sections);
    i = 0;
    
    when i < vec_len<String>(sections) loop
        sec_name = vec_get<string>(sections, i);
        sb_append(&sb, str_new("["));
        sb_append(&sb, sec_name);
        sb_append(&sb, str_new("]\n"));
        
        sec_map = map_get(cfg.sections, sec_name);
        case sec_map;
        Some(m):
                keys = map_keys(m);
                j = 0;
                when j < vec_len<String>(keys) loop
                    k = vec_get<string>(keys, j);
                    v = map_get(m, k);
                    case v;
        Some(val):
                            sb_append(&sb, k);
                            sb_append(&sb, str_new(" = "));
                            sb_append(&sb, _config_val_to_string(val));
                            sb_append(&sb, str_new("\n"));
                        case None ()
                    end
                    j = j + 1;
                end
            case None ()
        end
        sb_append(&sb, str_new("\n"));
        i = i + 1;
    end
    
    out sb_build(sb);
end.
func _config_val_to_string(val: ConfigValue):
    case val;
        case ConfigValue.Str(s) out s
        case ConfigValue.Int(n) out int_to_string(n)
        case ConfigValue.Float(f) out float_to_string(f)
        case ConfigValue.Bool(b) out if b str_new("true") else str_new("false") end
        default out str_new("<complex>");
    end
end.