/*
 * vir/config/config.vri — Configuration File Parser
 * ====================================================
 * Inspired by Python: configparser, tomllib
 *
 * Hỗ trợ: INI/TOML-like format, environment variable override.
 * Phase C — production config management
 */

import "vir/core/types" use all
import "vir/core/option" use Option, Some, None
import "vir/core/result" use Result, Ok, Err
import "vir/str/string" use String, str_new, str_eq, str_byte_at, str_byte_len, str_slice_bytes, str_trim, str_starts_with, str_contains, str_find
import "vir/str/builder" use StringBuilder, sb_new, sb_append, sb_build
import "vir/collections/map" use Map, map_new, map_set, map_get, map_keys, map_contains
import "vir/collections/vec" use Vec, vec_new, vec_push, vec_len, vec_get
import "vir/io/file" use file_read_string
import "vir/env/env" use env_var

# ═══════════════════════════════════════════════════════
# Config Value
# ═══════════════════════════════════════════════════════

enum ConfigValue
    Str(String)
    Int(i64)
    Float(f64)
    Bool(bool)
    Array(Vec<ConfigValue>)
    Table(Map<String, ConfigValue>)
end

entity Config
    sections: Map<String, Map<String, ConfigValue>>
end

# ═══════════════════════════════════════════════════════
# Create & Access
# ═══════════════════════════════════════════════════════

func config_new() -> Config
    out Config { sections = map_new<String, Map<String, ConfigValue>>() }
end

func config_set(cfg: &Config, section: String, key: String, val: ConfigValue)
    var sec = map_get(&cfg.sections, section)
    chọn sec
        case None
            var m = map_new<String, ConfigValue>()
            map_set(&m, key, val)
            map_set(&cfg.sections, section, m)
        case Some(m)
            map_set(&m, key, val)
    end
end

func config_get(cfg: Config, section: String, key: String) -> Option<ConfigValue>
    var sec = map_get(cfg.sections, section)
    chọn sec
        case None out None
        case Some(m) out map_get(m, key)
    end
end

func config_get_str(cfg: Config, section: String, key: String) -> Option<String>
    var val = config_get(cfg, section, key)
    chọn val
        case Some(ConfigValue.Str(s)) out Some(s)
        mặc_định out None
    end
end

func config_get_int(cfg: Config, section: String, key: String) -> Option<i64>
    var val = config_get(cfg, section, key)
    chọn val
        case Some(ConfigValue.Int(n)) out Some(n)
        mặc_định out None
    end
end

func config_get_bool(cfg: Config, section: String, key: String) -> Option<bool>
    var val = config_get(cfg, section, key)
    chọn val
        case Some(ConfigValue.Bool(b)) out Some(b)
        mặc_định out None
    end
end

func config_get_or(cfg: Config, section: String, key: String, default: String) -> String
    var val = config_get_str(cfg, section, key)
    chọn val
        case Some(s) out s
        case None out default
    end
end

# ═══════════════════════════════════════════════════════
# INI Parser
# ═══════════════════════════════════════════════════════

func config_from_ini(text: String) -> Result<Config, String>
    var cfg = config_new()
    var current_section = str_new("default")
    var lines = str_split(text, str_new("\n"))
    var i: usize = 0
    
    lặp_khi i < vec_len<String>(lines)
        var line = str_trim(vec_get<String>(lines, i))
        var len = str_byte_len(line)
        
        # Skip empty lines and comments
        if len == 0 or str_byte_at(line, 0) == 0x23 or str_byte_at(line, 0) == 0x3B
            i = i + 1
            tiếp_tục
        end
        
        # Section header: [section]
        if str_byte_at(line, 0) == 0x5B
            if str_byte_at(line, len - 1) != 0x5D
                out Err(str_concat(str_new("invalid section header: "), line))
            end
            current_section = str_trim(str_slice_bytes(line, 1, len - 1))
            i = i + 1
            tiếp_tục
        end
        
        # Key = Value
        var eq_idx = str_find(line, str_new("="))
        chọn eq_idx
            case None
                out Err(str_concat(str_new("invalid line: "), line))
            case Some(idx)
                var key = str_trim(str_slice_bytes(line, 0, idx))
                var val_str = str_trim(str_slice_bytes(line, idx + 1, len))
                var val = _parse_ini_value(val_str)
                config_set(&cfg, current_section, key, val)
        end
        i = i + 1
    end
    
    out Ok(cfg)
end

func _parse_ini_value(s: String) -> ConfigValue
    # Boolean
    if str_eq(s, str_new("true")) or str_eq(s, str_new("yes")) or str_eq(s, str_new("on"))
        out ConfigValue.Bool(true)
    end
    if str_eq(s, str_new("false")) or str_eq(s, str_new("no")) or str_eq(s, str_new("off"))
        out ConfigValue.Bool(false)
    end
    
    # Quoted string
    var len = str_byte_len(s)
    if len >= 2
        var first = str_byte_at(s, 0)
        var last = str_byte_at(s, len - 1)
        if (first == 0x22 and last == 0x22) or (first == 0x27 and last == 0x27)
            out ConfigValue.Str(str_slice_bytes(s, 1, len - 1))
        end
    end
    
    # Integer
    var is_int = true
    var i: usize = 0
    if len > 0 and (str_byte_at(s, 0) == 0x2D or str_byte_at(s, 0) == 0x2B) i = 1 end
    lặp_khi i < len
        var b = str_byte_at(s, i)
        if b < 0x30 or b > 0x39 is_int = false; thoát end
        i = i + 1
    end
    if is_int and len > 0
        out ConfigValue.Int(str_to_i64(s))
    end
    
    # Default: string
    out ConfigValue.Str(s)
end

# ═══════════════════════════════════════════════════════
# Load from file with env override
# ═══════════════════════════════════════════════════════

func config_load(path: String) -> Result<Config, String>
    var text_result = file_read_string(path)
    chọn text_result
        case Err(e) out Err(e)
        case Ok(text) out config_from_ini(text)
    end
end

func config_get_with_env(cfg: Config, section: String, key: String, env_key: String) -> Option<String>
    # Environment override takes priority
    var env_val = env_var(env_key)
    chọn env_val
        case Some(v) out Some(v)
        case None out config_get_str(cfg, section, key)
    end
end

# ═══════════════════════════════════════════════════════
# Serialize config back to INI
# ═══════════════════════════════════════════════════════

func config_to_ini(cfg: Config) -> String
    var sb = sb_new()
    var sections = map_keys(cfg.sections)
    var i: usize = 0
    
    lặp_khi i < vec_len<String>(sections)
        var sec_name = vec_get<String>(sections, i)
        sb_append(&sb, str_new("["))
        sb_append(&sb, sec_name)
        sb_append(&sb, str_new("]\n"))
        
        var sec_map = map_get(cfg.sections, sec_name)
        chọn sec_map
            case Some(m)
                var keys = map_keys(m)
                var j: usize = 0
                lặp_khi j < vec_len<String>(keys)
                    var k = vec_get<String>(keys, j)
                    var v = map_get(m, k)
                    chọn v
                        case Some(val)
                            sb_append(&sb, k)
                            sb_append(&sb, str_new(" = "))
                            sb_append(&sb, _config_val_to_string(val))
                            sb_append(&sb, str_new("\n"))
                        case None {}
                    end
                    j = j + 1
                end
            case None {}
        end
        sb_append(&sb, str_new("\n"))
        i = i + 1
    end
    
    out sb_build(sb)
end

func _config_val_to_string(val: ConfigValue) -> String
    chọn val
        case ConfigValue.Str(s) out s
        case ConfigValue.Int(n) out int_to_string(n)
        case ConfigValue.Float(f) out float_to_string(f)
        case ConfigValue.Bool(b) out if b str_new("true") else str_new("false") end
        mặc_định out str_new("<complex>")
    end
end
