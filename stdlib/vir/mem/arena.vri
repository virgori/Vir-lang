##
 * vir/mem/arena.vri — Arena Allocator (Bump Allocator)
 * =====================================================
 * Cấp phát O(1), deallocate tất cả cùng lúc.
 * Cực kỳ hữu ích cho compiler: AST nodes, token list, IR instructions.
 ##

include types;
include alloc;
import alloc, free from alloc;
include copy;
import mem_copy from copy;

entity Arena:
    base: ptr       # Vùng nhớ root,
        offset: int     # Vị trí hiện tại (bump pointer),
        cap: int        # Tổng capacity;
end
func arena_new:
    in(size:int)
    real_size = if size < 4096 do 4096; else size; end;
    out Arena (
        base: alloc(real_size),
        offset: 0,
        cap: real_size
    );
end
func arena_alloc:
    in(a:Arena; size:int)
    # Cấp phát `size` bytes từ arena. O(1) amortized. Auto-grows if needed.
    # Align to 8 bytes
    aligned_size = (size + 7) & ~7;

    if a.offset + aligned_size > a.cap do
        # Auto-grow: double capacity or fit the request
        new_cap = a.cap * 2;
        if new_cap < a.offset + aligned_size do
            new_cap = a.offset + aligned_size;
        end
        new_buf = alloc(new_cap);
        mem_copy(new_buf, a.base, a.offset);
        free(a.base);
        a.base = new_buf;
        a.cap = new_cap;
    end

    p = a.base + a.offset;
    a.offset = a.offset + aligned_size;
    out p;
end
func arena_alloc_zeroed:
    in(a:Arena; size:int)
    p = arena_alloc(a, size);
    mem_set(p, 0, size);
    out p;
end
func arena_reset:
    in(a:Arena)
    # Giải phóng tất cả allocation — reset về vị trí đầu.
    a.offset = 0;
end
func arena_free:
    in(a:Arena)
    # Giải phóng toàn bộ arena.
    free(a.base);
    a.base = null;
    a.offset = 0;
    a.cap = 0;
end
func arena_remaining:
    in(a:Arena)
    out a.cap - a.offset;
end
func arena_used:
    in(a:Arena)
    out a.offset;
end
func arena_save:
    in(a:Arena)
    # Lưu checkpoint — có thể restore sau.
    out a.offset;
end
func arena_restore:
    in(a:Arena; checkpoint:int)
    # Quay về checkpoint (free mọi thứ allocate sau checkpoint).
    if checkpoint <= a.offset do
        a.offset = checkpoint;
    end
end