/*
 * vir/mem/arena.vri — Arena Allocator (Bump Allocator)
 * =====================================================
 * Cấp phát O(1), deallocate tất cả cùng lúc.
 * Cực kỳ hữu ích cho compiler: AST nodes, token list, IR instructions.
 */

import "vir/core/types" use all
import "vir/mem/alloc" use alloc, free

entity Arena
    base: ptr       # Vùng nhớ root
    offset: u64     # Vị trí hiện tại (bump pointer)
    cap: u64        # Tổng capacity
end

func arena_new(size: u64) -> Arena
    out Arena {
        base: alloc(size),
        offset: 0,
        cap: size
    }
end

func arena_alloc(a: Arena, size: u64) -> ptr
    # Cấp phát `size` bytes từ arena. O(1). Không thể free từng phần.
    # Align to 8 bytes
    var aligned_size = (size + 7) & ~7

    if a.offset + aligned_size > a.cap
        panic("arena exhausted: needed " + to_string(size) + ", remaining " + to_string(a.cap - a.offset))
    end

    var p = a.base + a.offset
    a.offset = a.offset + aligned_size
    out p
end

func arena_alloc_zeroed(a: Arena, size: u64) -> ptr
    var p = arena_alloc(a, size)
    mem_set(p, 0, size)
    out p
end

func arena_reset(a: Arena)
    # Giải phóng tất cả allocation — reset về vị trí đầu.
    a.offset = 0
end

func arena_free(a: Arena)
    # Giải phóng toàn bộ arena.
    free(a.base)
    a.base = null
    a.offset = 0
    a.cap = 0
end

func arena_remaining(a: Arena) -> u64
    out a.cap - a.offset
end

func arena_used(a: Arena) -> u64
    out a.offset
end

func arena_save(a: Arena) -> u64
    # Lưu checkpoint — có thể restore sau.
    out a.offset
end

func arena_restore(a: Arena, checkpoint: u64)
    # Quay về checkpoint (free mọi thứ allocate sau checkpoint).
    if checkpoint <= a.offset
        a.offset = checkpoint
    end
end
