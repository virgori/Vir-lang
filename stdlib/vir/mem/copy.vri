##
 * vir/mem/copy.vri — Memory Operations
 * ======================================
 * Inspired by C23: <string.h> memcpy, memset, memmove, memcmp
 ##

include types

func mem_copy:
    in  dst: ptr
        src: ptr
        n: int
    # Copy n bytes từ src sang dst. Hành vi không xác định if overlap.
    var i = 0
    when i < n loop
        native_write_u8(dst as int, i, native_read_u8(src as int, i))
        i = i + 1
    end
end.
func mem_move:
    in  dst: ptr
        src: ptr
        n: int
    # Copy n bytes từ src sang dst. An toàn khi overlap.
    if (dst as int) <= (src as int) do
        mem_copy(dst, src, n)
        out
    end
    var i = n
    when i > 0 loop
        i = i - 1
        native_write_u8(dst as int, i, native_read_u8(src as int, i))
    end
end.
func mem_set:
    in  dst: ptr
        val: int
        n: int
    # Đặt n bytes tại dst thành val.
    var i = 0
    when i < n loop
        native_write_u8(dst as int, i, val and 255)
        i = i + 1
    end
end.
func mem_zero(dst: ptr, n: int):
    # Đặt n bytes = 0.
    mem_set(dst, 0, n)
end.
func mem_cmp:
    in  a: ptr
        b: ptr
        n: int
    # So sánh n bytes. Returns 0 if giống, < 0 if a < b, > 0 if a > b
    var i = 0
    when i < n loop
        let av = native_read_u8(a as int, i)
        let bv = native_read_u8(b as int, i)
        if av < bv do out 0 - 1 end
        if av > bv do out 1 end
        i = i + 1
    end
    out 0
end.
func mem_eq:
    in  a: ptr
        b: ptr
        n: int
    out mem_cmp(a, b, n) == 0
end.
