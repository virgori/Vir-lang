/*
 * vir/mem/copy.vri — Memory Operations
 * ======================================
 * Inspired by C23: <string.h> memcpy, memset, memmove, memcmp
 */

import "vir/core/types" use all

func mem_copy(dst: ptr, src: ptr, n: u64)
    # Copy n bytes từ src sang dst. Hành vi không xác định if overlap.
    native_memcpy(dst, src, n)
end

func mem_move(dst: ptr, src: ptr, n: u64)
    # Copy n bytes từ src sang dst. An toàn khi overlap.
    native_memmove(dst, src, n)
end

func mem_set(dst: ptr, val: u8, n: u64)
    # Đặt n bytes tại dst thành val.
    native_memset(dst, val, n)
end

func mem_zero(dst: ptr, n: u64)
    # Đặt n bytes = 0.
    mem_set(dst, 0, n)
end

func mem_cmp(a: ptr, b: ptr, n: u64) -> i32
    # So sánh n bytes. Returns 0 if giống, < 0 if a < b, > 0 if a > b
    out native_memcmp(a, b, n)
end

func mem_eq(a: ptr, b: ptr, n: u64) -> bool
    out mem_cmp(a, b, n) == 0
end
