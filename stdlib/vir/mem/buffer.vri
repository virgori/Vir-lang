##
 * vir/mem/buffer.vri — Growable Byte Buffer (sở hữu dữ liệu)
 * ============================================================
 * Buffer = Vec<u8> chuyên biệt — use cho machine code emit, binary I/O.
 * Tự grow khi cần, deallocate khi free.
 *
 * Compiler uses internally: code buffer cho codegen, output binary.
 ##

include types;
include alloc;
import alloc, realloc, free from alloc;
include slice;
import Slice, slice_new from slice;
include copy;
import mem_copy, mem_set from copy;

const BUFFER_INITIAL_CAP: 256;

entity Buffer:
    data: ptr,
        len: int,
        cap: int;
end
func buffer_new:
    in(cap:int)
    if cap > 0 do actual_cap = cap; else actual_cap = BUFFER_INITIAL_CAP; end;
    out Buffer (
        data: alloc(actual_cap),
        len: 0,
        cap: actual_cap
    );
end
func buffer_default:
    out buffer_new(BUFFER_INITIAL_CAP);
end
func buffer_grow:
    in(b:Buffer; min_cap:int)
    if min_cap <= b.cap do out end
    new_cap = b.cap * 2;
    when new_cap < min_cap loop
        new_cap = new_cap * 2;
    end
    b.data = realloc(b.data, new_cap);
    b.cap = new_cap;
end
func buffer_push:
    in(b:Buffer; byte:int)
    buffer_grow(b, b.len + 1);
    native_write_u8(b.data, b.len, byte);
    b.len = b.len + 1;
end
func buffer_push_u16:
    in(b:Buffer; val:int)
    buffer_grow(b, b.len + 2);
    native_write_u16_le(b.data, b.len, val);
    b.len = b.len + 2;
end
func buffer_push_u32:
    in(b:Buffer; val:int)
    buffer_grow(b, b.len + 4);
    native_write_u32_le(b.data, b.len, val);
    b.len = b.len + 4;
end
func buffer_push_u64:
    in(b:Buffer; val:int)
    buffer_grow(b, b.len + 8);
    native_write_u64_le(b.data, b.len, val);
    b.len = b.len + 8;
end
func buffer_write:
    in(b:Buffer; data:Slice)
    buffer_grow(b, b.len + data.len);
    mem_copy(b.data + b.len, data.data, data.len);
    b.len = b.len + data.len;
end
func buffer_write_bytes:
    in(b:Buffer; src:ptr; count:int)
    buffer_grow(b, b.len + count);
    mem_copy(b.data + b.len, src, count);
    b.len = b.len + count;
end
func buffer_read_u8:
    in(b:Buffer; offset:int)
    if offset >= b.len panic("buffer read do out of bounds") end
    out native_read_u8(b.data, offset);
end
func buffer_read_u32:
    in(b:Buffer; offset:int)
    if offset + 4 > b.len panic("buffer read do out of bounds") end
    out native_read_u32_le(b.data, offset);
end
func buffer_write_at:
    in(b:Buffer; offset:int; val:int)
    if offset >= b.len panic("buffer write do out of bounds") end
    native_write_u8(b.data, offset, val);
end
func buffer_write_u32_at:
    in(b:Buffer; offset:int; val:int)
    if offset + 4 > b.len panic("buffer write do out of bounds") end
    native_write_u32_le(b.data, offset, val);
end
func buffer_patch_u32:
    in(b:Buffer; offset:int; val:int)
    # Alias rõ nghĩa hơn cho binary patching
    buffer_write_u32_at(b, offset, val);
end
func buffer_as_slice:
    in(b:Buffer)
    out slice_new(b.data, b.len);
end
func buffer_clear:
    in(b:Buffer)
    b.len = 0;
end
func buffer_free:
    in(b:Buffer)
    free(b.data);
    b.data = null;
    b.len = 0;
    b.cap = 0;
end
func buffer_len:
    in(b:Buffer)
    out b.len;
end
func buffer_cap:
    in(b:Buffer)
    out b.cap;
end
func buffer_is_empty:
    in(b:Buffer)
    out b.len == 0;
end
func buffer_reserve:
    in(b:Buffer; additional:int)
    buffer_grow(b, b.len + additional);
end
func buffer_truncate:
    in(b:Buffer; new_len:int)
    if new_len < b.len do
        b.len = new_len;
    end
end