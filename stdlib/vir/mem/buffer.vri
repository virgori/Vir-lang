##
 * vir/mem/buffer.vri — Growable Byte Buffer (sở hữu dữ liệu)
 * ============================================================
 * Buffer = Vec of (u8) chuyên biệt — use cho machine code emit, binary I/O.
 * Tự grow khi cần, deallocate khi free.
 *
 * Compiler uses internally: code buffer cho codegen, output binary.
 *
 * Ownership: Buffer là Move type. Tất cả mutating API nhận `ref b: Buffer`
 * để tránh E5001 use-after-move và stale-pointer sau realloc.
 ##

include types
include alloc
import alloc, realloc, free from alloc
include slice
import Slice, slice_new from slice
include copy
import mem_copy, mem_set from copy

const BUFFER_INITIAL_CAP: 256

entity Buffer:
    data: ptr,
        len: int,
        cap: int
end.
func buffer_new(cap: int):
    if cap > 0 do actual_cap = cap; else actual_cap = BUFFER_INITIAL_CAP; end
    out Buffer (
        data: alloc(actual_cap) as ptr,
        len: 0,
        cap: actual_cap
    )
end.
func buffer_default:
    out buffer_new(BUFFER_INITIAL_CAP)
end.
# ─── Internal: grow capacity if needed ────────────────
func buffer_grow:
    ref b: Buffer
    in  min_cap: int
    if min_cap <= b.cap do out end
    new_cap = b.cap * 2
    when new_cap < min_cap loop
        new_cap = new_cap * 2
    end
    b.data = realloc(b.data, new_cap) as ptr
    b.cap = new_cap
end.
# ─── Push / Write ─────────────────────────────────────
func buffer_push:
    ref b: Buffer
    in  byte: int
    buffer_grow(b, b.len + 1)
    native_write_u8(b.data, b.len, byte)
    b.len = b.len + 1
end.
func buffer_push_u16:
    ref b: Buffer
    in  val: int
    buffer_grow(b, b.len + 2)
    d = b.data as int
    base = b.len
    native_write_u8(d, base,     val bit_and 255)
    native_write_u8(d, base + 1, (val shr 8) bit_and 255)
    b.len = base + 2
end.
func buffer_push_u32:
    ref b: Buffer
    in  val: int
    buffer_grow(b, b.len + 4)
    d = b.data as int
    base = b.len
    native_write_u8(d, base,     val bit_and 255)
    native_write_u8(d, base + 1, (val shr 8) bit_and 255)
    native_write_u8(d, base + 2, (val shr 16) bit_and 255)
    native_write_u8(d, base + 3, (val shr 24) bit_and 255)
    b.len = base + 4
end.
func buffer_push_u64:
    ref b: Buffer
    in  val: int
    buffer_grow(b, b.len + 8)
    d = b.data as int
    base = b.len
    var i = 0
    when i < 8 loop
        native_write_u8(d, base + i, (val shr (i * 8)) bit_and 255)
        i = i + 1
    end
    b.len = base + 8
end.
func buffer_write:
    ref b: Buffer
    in  data: Slice
    buffer_grow(b, b.len + data.len)
    mem_copy(b.data + b.len, data.data, data.len)
    b.len = b.len + data.len
end.
func buffer_write_bytes:
    ref b: Buffer
    in  src: ptr
        count: int
    buffer_grow(b, b.len + count)
    mem_copy(b.data + b.len, src, count)
    b.len = b.len + count
end.
# ─── Read ─────────────────────────────────────────────
func buffer_read_u8(b: Buffer, offset: int):
    if offset >= b.len do panic("buffer read out of bounds") end
    out native_read_u8(b.data, offset)
end.
func buffer_read_u32(b: Buffer, offset: int):
    if offset + 4 > b.len do panic("buffer read out of bounds") end
    d = b.data as int
    out native_read_u8(d, offset) bit_or
        (native_read_u8(d, offset + 1) shl 8) bit_or
        (native_read_u8(d, offset + 2) shl 16) bit_or
        (native_read_u8(d, offset + 3) shl 24)
end.
# ─── Write-at (patch) ─────────────────────────────────
func buffer_write_at:
    ref b: Buffer
    in  offset: int
        val: int
    if offset >= b.len do panic("buffer write out of bounds") end
    native_write_u8(b.data, offset, val)
end.
func buffer_write_u32_at:
    ref b: Buffer
    in  offset: int
        val: int
    if offset + 4 > b.len do panic("buffer write out of bounds") end
    d = b.data as int
    native_write_u8(d, offset,     val bit_and 255)
    native_write_u8(d, offset + 1, (val shr 8) bit_and 255)
    native_write_u8(d, offset + 2, (val shr 16) bit_and 255)
    native_write_u8(d, offset + 3, (val shr 24) bit_and 255)
end.
func buffer_patch_u32:
    ref b: Buffer
    in  offset: int
        val: int
    # Alias rõ nghĩa hơn cho binary patching
    buffer_write_u32_at(b, offset, val)
end.
# ─── Misc ─────────────────────────────────────────────
func buffer_as_slice(b: Buffer):
    out slice_new(b.data, b.len)
end.
func buffer_clear:
    ref b: Buffer
    b.len = 0
end.
func buffer_free:
    ref b: Buffer
    free(b.data)
    b.data = null
    b.len = 0
    b.cap = 0
end.
func buffer_len(b: Buffer):
    out b.len
end.
func buffer_cap(b: Buffer):
    out b.cap
end.
func buffer_is_empty(b: Buffer):
    out b.len == 0
end.
func buffer_reserve:
    ref b: Buffer
    in  additional: int
    buffer_grow(b, b.len + additional)
end.
func buffer_truncate:
    ref b: Buffer
    in  new_len: int
    if new_len < b.len do
        b.len = new_len
    end
end.
