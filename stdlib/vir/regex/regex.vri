##
 * vir/regex/regex.vri — Regular Expression Engine
 * ==================================================
 * Inspired by Python: re
 * Triển khai: NFA-based (Thompson's construction) — no backtracking
 *
 * Hỗ trợ: literal, ., *, +, ?, |, [], [^], (), ^, $, \d, \w, \s
 * Compiler use: pattern matching in lexer, SubLib syntax.
 ##

include types;
include option;
import Option, Some, None from option;
include result;
import Result, Ok, Err from result;
include string;
import String, str_new, str_byte_at, str_byte_len, str_slice_bytes, str_eq from string;
include char;
import is_digit, is_alpha, is_alnum, is_space from char;
include vec;
import Vec, vec_new, vec_push, vec_len, vec_get, vec_contains from vec;

# ═══════════════════════════════════════════════════════
# NFA State Machine
# ═══════════════════════════════════════════════════════

enum NfaType:
    Literal    = 1    # Match single byte;
    Dot        = 2    # Match any byte (except \n);
    CharClass  = 3    # Match one of byte set;
    NegClass   = 4    # Match NOT in byte set;
    Split      = 5    # Epsilon split -> out1, out2;
    Match      = 6    # Accept state;
    Anchor_BOL = 7    # ^ (beginning of line);
    Anchor_EOL = 8    # $ (end of line);
end
entity NfaState:
    tag:     NfaType,
        ch:      int           # for Literal,
        chars:   Vec<int>      # for CharClass / NegClass,
        bitmap:  [int; 4]      # 256-bit bitmap for O(1) CharClass matching,
        out1:    int          # next state index (-1 = none),
        out2:    int          # second output for Split;
end

# ─── Bitmap helpers for CharClass (4 × 64-bit = 256 bits) ────

func _bitmap_set:
    in(bm: [int; 4]; byte: int)
    idx = byte / 64;
    bit = byte % 64;
    bm[idx] = bm[idx] | (1 << bit);
end
func _bitmap_test:
    in(bm: [int; 4]; byte: int)
    idx = byte / 64;
    bit = byte % 64;
    out (bm[idx] >> bit) & 1 == 1;
end
func _build_bitmap:
    in(chars: Vec<int>)
    var bm: [int; 4] = [0, 0, 0, 0];
    i = 0;
    when i < vec_len<int>(chars) loop
        b = vec_get<int>(chars, i);
        if b >= 0 and b < 256 do
            _bitmap_set(&bm, b);
        end
        i = i + 1;
    end
    out bm;
end
entity Regex:
    pattern: string,
        states:  Vec<NfaState>,
        start:   int;
end
entity Match:
    start:  int,
        end:    int,
        text:   string;
end

# ═══════════════════════════════════════════════════════
# Compile pattern -> NFA
# ═══════════════════════════════════════════════════════

func regex_compile:
    in(pattern:string)
    states = vec_new<NfaState>();
    pos = 0;
    len = str_byte_len(pattern);
    
    start_result = _compile_expr(&states, pattern, &pos, len);
    case start_result;
        Err(e): out Err(e);
        Ok(start_idx):
            # Thêm match state
            match_idx = vec_len<NfaState>(states);
            vec_push<NfaState>(&states, NfaState {;
                tag = NfaType.Match, ch = 0, chars = vec_new<int>(),
                bitmap = [0, 0, 0, 0],
                out1 = -1, out2 = -1
    });
            # Nối cuối string tới match
            _patch_dangling(&states, start_idx, match_idx);
            
            out Ok(Regex { pattern = pattern, states = states, start = start_idx });
    end
end
# ─── NFA Construction Helpers ─────────────────────────

func _new_state:
    in(states:Vec<NfaState>; tag:NfaType; ch:int)
    idx = vec_len<NfaState>(*states);
    vec_push<NfaState>(states, NfaState {;
        tag = tag, ch = ch, chars = vec_new<int>(),
        bitmap = [0, 0, 0, 0],
        out1 = -1, out2 = -1
    });
    out idx;
end
func _new_split:
    in(states:Vec<NfaState>; out1:int; out2:int)
    idx = vec_len<NfaState>(*states);
    vec_push<NfaState>(states, NfaState {;
        tag = NfaType.Split, ch = 0, chars = vec_new<int>(),
        bitmap = [0, 0, 0, 0],
        out1 = out1, out2 = out2
    });
    out idx;
end
func _patch_dangling:
    in(states:Vec<NfaState>; from:int; to:int)
    # Nối tất cả dangling out1 = -1 tới to
    s = vec_get<NfaState>(*states, from);
    if s.out1 == -1 and s.tag != NfaType.Split do
        s.out1 = to;
        vec_set<NfaState>(states, from, s);
    end
end
func _compile_expr:
    in(states:Vec<NfaState>; pat:string; pos:int; len:int)
    # Compile alternation: expr '|' expr
    left_result = _compile_seq(states, pat, pos, len);
    var left:int;
    case left_result;
        Err(e): out Err(e);
        case Ok(l) left = l
    end
    
    if *pos < len and str_byte_at(pat, *pos) == 0x7C do # | do
        *pos = *pos + 1;
        right_result = _compile_expr(states, pat, pos, len);
        var right:int;
        case right_result;
        Err(e): out Err(e);
            case Ok(r) right = r
        end
        split = _new_split(states, left, right);
        out Ok(split);
    end
    
    out Ok(left);
end
func _compile_seq:
    in(states:Vec<NfaState>; pat:string; pos:int; len:int)
    # Compile sequence of atoms with quantifiers
    first = -1;
    prev = -1;
    
    when *pos < len loop
        ch = str_byte_at(pat, *pos);
        # Stop at | or )
        if ch == 0x7C or ch == 0x29 do break end
        
        atom_result = _compile_atom(states, pat, pos, len);
        var atom:int;
        case atom_result;
        Err(e): out Err(e);
            case Ok(a) atom = a
        end
        
        # Check for quantifier: *, +, ?
        quantified = atom;
        if *pos < len do
            qch = str_byte_at(pat, *pos);
            if qch == 0x2A do # * do
                *pos = *pos + 1;
                split = _new_split(states, atom, -1);
                _patch_dangling(states, atom, split);
                quantified = split;
            eif qch == 0x2B do # + do
                *pos = *pos + 1;
                split = _new_split(states, atom, -1);
                _patch_dangling(states, atom, split);
                quantified = atom;
            eif qch == 0x3F do # ? do
                *pos = *pos + 1;
                split = _new_split(states, atom, -1);
                quantified = split;
            end
        end
        
        if first == -1 do first = quantified end
        if prev != -1 do
            _patch_dangling(states, prev, quantified);
        end
        prev = quantified;
    end
    
    if first == -1 do
        # Empty expression -> epsilon
        first = _new_state(states, NfaType.Split, 0);
    end
    out Ok(first);
end
func _compile_atom:
    in(states:Vec<NfaState>; pat:string; pos:int; len:int)
    ch = str_byte_at(pat, *pos);
    
    if ch == 0x2E do # . do
        *pos = *pos + 1;
        out Ok(_new_state(states, NfaType.Dot, 0));
    end
    
    if ch == 0x5E do # ^ do
        *pos = *pos + 1;
        out Ok(_new_state(states, NfaType.Anchor_BOL, 0));
    end
    
    if ch == 0x24 do # $ do
        *pos = *pos + 1;
        out Ok(_new_state(states, NfaType.Anchor_EOL, 0));
    end
    
    if ch == 0x28 do # ( do
        *pos = *pos + 1;
        inner = _compile_expr(states, pat, pos, len);
        if *pos >= len or str_byte_at(pat, *pos) != 0x29 do
            out Err(str_new("unmatched '('"));
        end
        *pos = *pos + 1   # skip );
        out inner;
    end
    
    if ch == 0x5B do # [ do
        out _compile_charclass(states, pat, pos, len);
    end
    
    if ch == 0x5C do # backslash do
        *pos = *pos + 1;
        if *pos >= len do out Err(str_new("trailing backslash")) end
        esc = str_byte_at(pat, *pos);
        *pos = *pos + 1;
        
        # \d \w \s shortcuts
        if esc == 0x64 do # \d -> [0-9] do
            idx = _new_state(states, NfaType.CharClass, 0);
            s = vec_get<NfaState>(*states, idx);
            d = 0x30;
            when d <= 0x39 loop
                vec_push<int>(&s.chars, d);
                d = d + 1;
            end
            s.bitmap = _build_bitmap(s.chars);
            vec_set<NfaState>(states, idx, s);
            out Ok(idx);
        end
        if esc == 0x77 do # \w -> [a-zA-Z0-9_] do
            idx = _new_state(states, NfaType.CharClass, 0);
            s = vec_get<NfaState>(*states, idx);
            c = 0x61;
            when c <= 0x7A vec_push<u8>(&s.chars, c); c = c + 1 end loop
            c = 0x41;
            when c <= 0x5A vec_push<u8>(&s.chars, c); c = c + 1 end loop
            c = 0x30;
            when c <= 0x39 vec_push<u8>(&s.chars, c); c = c + 1 end loop
            vec_push<int>(&s.chars, 0x5F)   # _;
            s.bitmap = _build_bitmap(s.chars);
            vec_set<NfaState>(states, idx, s);
            out Ok(idx);
        end
        if esc == 0x73 do # \s -> [ \t\n\r\f] do
            idx = _new_state(states, NfaType.CharClass, 0);
            s = vec_get<NfaState>(*states, idx);
            vec_push<int>(&s.chars, 0x20);
            vec_push<int>(&s.chars, 0x09);
            vec_push<int>(&s.chars, 0x0A);
            vec_push<int>(&s.chars, 0x0D);
            vec_push<int>(&s.chars, 0x0C);
            s.bitmap = _build_bitmap(s.chars);
            vec_set<NfaState>(states, idx, s);
            out Ok(idx);
        end
        
        # Literal escaped char
        out Ok(_new_state(states, NfaType.Literal, esc));
    end
    
    # Plain literal
    *pos = *pos + 1;
    out Ok(_new_state(states, NfaType.Literal, ch));
end
func _compile_charclass:
    in(states:Vec<NfaState>; pat:string; pos:int; len:int)
    *pos = *pos + 1   # skip [;
    
    negated = false;
    if *pos < len and str_byte_at(pat, *pos) == 0x5E do # ^ do
        negated = true;
        *pos = *pos + 1;
    end
    
    tag = if negated NfaType.NegClass else NfaType.CharClass end;
    idx = _new_state(states, tag, 0);
    s = vec_get<NfaState>(*states, idx);
    
    when *pos < len and str_byte_at(pat, *pos) != 0x5D # ] loop
        c = str_byte_at(pat, *pos);
        *pos = *pos + 1;
        
        # Range: a-z
        if *pos + 1 < len and str_byte_at(pat, *pos) == 0x2D and str_byte_at(pat, *pos + 1) != 0x5D do
            *pos = *pos + 1   # skip -;
            end_c = str_byte_at(pat, *pos);
            *pos = *pos + 1;
            r = c;
            when r <= end_c loop
                vec_push<int>(&s.chars, r);
                r = r + 1;
            end
        else
            vec_push<int>(&s.chars, c);
        end
    end
    
    if *pos >= len do out Err(str_new("unterminated character class")) end
    *pos = *pos + 1   # skip ];
    
    s.bitmap = _build_bitmap(s.chars);
    vec_set<NfaState>(states, idx, s);
    out Ok(idx);
end
# ═══════════════════════════════════════════════════════
# NFA Simulation (Thompson's algorithm)
# ═══════════════════════════════════════════════════════

func _add_state:
    in(states:Vec<NfaState>; current:Vec<int>; idx:int; visited:Vec<bool>)
    if idx < 0 do out end
    if vec_get<bool>(*visited, idx) do out end
    vec_set<bool>(visited, idx, true);
    
    s = vec_get<NfaState>(states, idx);
    if s.tag == NfaType.Split do
        _add_state(states, current, s.out1, visited);
        _add_state(states, current, s.out2, visited);
    else
        vec_push<int>(current, idx);
    end
end
func _step:
    in(states:Vec<NfaState>; current:Vec<int>; ch:int; next:Vec<int>; visited:Vec<bool>)
    i = 0;
    when i < vec_len<i32>(current) loop
        idx = vec_get<int>(current, i);
        s = vec_get<NfaState>(states, idx);
        
        matched = false;
        case s.tag;
            case NfaType.Literal
                matched = (ch == s.ch);
            case NfaType.Dot
                matched = (ch != 0x0A)   # . not match \n;
            case NfaType.CharClass
                matched = _bitmap_test(s.bitmap, ch);
            case NfaType.NegClass
                matched = !_bitmap_test(s.bitmap, ch);
            default ();
        end
        
        if matched do
            _add_state(states, next, s.out1, visited);
        end
        i = i + 1;
    end
end
# ═══════════════════════════════════════════════════════
# Public Match API
# ═══════════════════════════════════════════════════════

func regex_is_match:
    in(re:Regex; text:string)
    out is_some(regex_find(re, text));
end
func regex_find:
    in(re:Regex; text:string)
    # Tìm match đầu tiên in text.
    text_len = str_byte_len(text);
    n_states = vec_len<NfaState>(re.states);
    
    start_pos = 0;
    when start_pos <= text_len loop
        current = vec_new<int>();
        visited = vec_filled<bool>(false, n_states);
        _add_state(re.states, &current, re.start, &visited);
        
        pos = start_pos;
        last_match = -1;
        
        # Kiểm tra match tại vị trí hiện tại
        j = 0;
        when j < vec_len<i32>(current) loop
            s = vec_get<NfaState>(re.states, vec_get<int>(current, j));
            if s.tag == NfaType.Match do last_match = pos end
            j = j + 1;
        end
        
        when pos < text_len and vec_len<i32>(current) > 0 loop
            ch = str_byte_at(text, pos);
            next = vec_new<int>();
            next_visited = vec_filled<bool>(false, n_states);
            _step(re.states, current, ch, &next, &next_visited);
            pos = pos + 1;
            current = next;
            
            # Kiểm tra match
            j = 0;
            when j < vec_len<i32>(current) loop
                s = vec_get<NfaState>(re.states, vec_get<int>(current, j));
                if s.tag == NfaType.Match do last_match = pos end
                j = j + 1;
            end
        end
        
        if last_match >= 0 do
            out Some(Match (;
                start = start_pos,
                end = last_match,
                text = str_slice_bytes(text, start_pos, last_match)
    ));
        end
        
        start_pos = start_pos + 1;
    end
    
    out None;
end
func regex_find_all:
    in(re:Regex; text:string)
    matches = vec_new<Match>();
    pos = 0;
    text_len = str_byte_len(text);
    
    when pos <= text_len loop
        sub = str_slice_bytes(text, pos, text_len);
        m = regex_find(re, sub);
        case m;
            case None break
        Some(found):
                vec_push<Match>(&matches, Match (;
                    start = pos + found.start,
                    end = pos + found.end,
                    text = found.text
    ));
                # Advance past this match
                advance = found.end;
                if advance == found.start do advance = advance + 1 end # zero-width
                pos = pos + advance;
        end
    end
    
    out matches;
end
func regex_replace:
    in(re:Regex; text:string; replacement:string)
    sb = sb_new();
    pos = 0;
    text_len = str_byte_len(text);
    
    when pos < text_len loop
        sub = str_slice_bytes(text, pos, text_len);
        m = regex_find(re, sub);
        case m;
        None:
                sb_append(&sb, str_slice_bytes(text, pos, text_len));
                break;
        Some(found):
                # Thêm phần trước match
                if found.start > 0 do
                    sb_append(&sb, str_slice_bytes(sub, 0, found.start));
                end
                sb_append(&sb, replacement);
                pos = pos + found.end;
                if found.end == found.start do pos = pos + 1 end
        end
    end
    
    out sb_build(sb);
end
func regex_split:
    in(re:Regex; text:string)
    parts = vec_new<string>();
    pos = 0;
    text_len = str_byte_len(text);
    
    when pos <= text_len loop
        sub = str_slice_bytes(text, pos, text_len);
        m = regex_find(re, sub);
        case m;
        None:
                vec_push<string>(&parts, sub);
                break;
        Some(found):
                vec_push<string>(&parts, str_slice_bytes(sub, 0, found.start));
                pos = pos + found.end;
                if found.end == found.start do pos = pos + 1 end
        end
    end
    
    out parts;
end