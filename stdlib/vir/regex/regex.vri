##
 * vir/regex/regex.vri -- Traditional Regular Expression Compatibility Frontend
 * ============================================================================
 * Implements standard regex syntax (re-compatible) on top of the unified
 * Pattern IR and Thompson NFA runtime engine.
 *
 * Supported syntax:
 *   - Literals and escapes: \., \*, \\, etc.
 *   - Any char: . (except \n)
 *   - Quantifiers: *, +, ?, {n}, {n,}, {n,m}
 *   - Alternation: |
 *   - Groups: (...) capturing, (?:...) non-capturing
 *   - Character classes: [...], [^...], ranges a-z, 0-9
 *   - Shorthands: \d, \D, \w, \W, \s, \S
 *   - Anchors: ^, $
 ##

include types
include option
include char
include vec

include pattern.ir
include pattern.engine
include pattern.pattern

# -------------------------------------------------------
# Regex Parser & Direct Pattern IR Lowering Entity
# -------------------------------------------------------

entity RegexParser:
    arena:           Vec of (PatternNode),
    pat:             string,
    pos:             int,
    plen:            int,
    capture_counter: int

    method parse_charclass() -> int:
        this.pos = this.pos + 1 # skip '['

        var is_negated = false
        if this.pos < this.plen & str_byte_at(this.pat, this.pos) == 94 do # '^'
            is_negated = true
            this.pos = this.pos + 1
        end

        var chars = vec_new of (int)()
        var ranges = vec_new of (int)()

        when this.pos < this.plen loop
            let ch = str_byte_at(this.pat, this.pos)
            if ch == 93 do # ']'
                this.pos = this.pos + 1
                break
            end

            this.pos = this.pos + 1

            # Range check: c - end_c
            if this.pos + 1 < this.plen & str_byte_at(this.pat, this.pos) == 45 & str_byte_at(this.pat, this.pos + 1) != 93 do
                this.pos = this.pos + 1 # skip '-'
                let end_c = str_byte_at(this.pat, this.pos)
                this.pos = this.pos + 1
                vec_push of (int)(ranges, ch)
                vec_push of (int)(ranges, end_c)
            else
                vec_push of (int)(chars, ch)
            end
        end

        out pattern_node_charclass(this.arena, chars, ranges, is_negated)
    end.

    method parse_atom() -> int:
        if this.pos >= this.plen do
            out 0 - 1
        end

        let ch = str_byte_at(this.pat, this.pos)

        # . Dot
        if ch == 46 do
            this.pos = this.pos + 1
            out pattern_node_dot(this.arena)
        end

        # ^ AnchorStart
        if ch == 94 do
            this.pos = this.pos + 1
            out pattern_node_anchor_start(this.arena)
        end

        # $ AnchorEnd
        if ch == 36 do
            this.pos = this.pos + 1
            out pattern_node_anchor_end(this.arena)
        end

        # [ CharClass
        if ch == 91 do
            out this.parse_charclass()
        end

        # ( Group
        if ch == 40 do
            this.pos = this.pos + 1 # skip '('
            var is_capturing = true
            if this.pos + 1 < this.plen & str_byte_at(this.pat, this.pos) == 63 & str_byte_at(this.pat, this.pos + 1) == 58 do # '?:'
                is_capturing = false
                this.pos = this.pos + 2
            end

            var cap_id = 0
            if is_capturing do
                this.capture_counter = this.capture_counter + 1
                cap_id = this.capture_counter
            end

            let inner = this.parse_alternation()

            if this.pos < this.plen & str_byte_at(this.pat, this.pos) == 41 do # ')'
                this.pos = this.pos + 1
            end

            if is_capturing do
                out pattern_node_group(this.arena, inner, cap_id, false)
            end
            out inner
        end

        # \ Escape & shortcuts
        if ch == 92 do
            this.pos = this.pos + 1
            if this.pos >= this.plen do
                out pattern_node_literal(this.arena, 92)
            end
            let esc = str_byte_at(this.pat, this.pos)
            this.pos = this.pos + 1

            # \d digit
            if esc == 100 do
                out pattern_node_charclass(this.arena, vec_new of (int)(), ranges_digits(), false)
            end
            # \D non-digit
            if esc == 68 do
                out pattern_node_charclass(this.arena, vec_new of (int)(), ranges_digits(), true)
            end
            # \w word
            if esc == 119 do
                out pattern_node_charclass(this.arena, chars_word_extra(), ranges_alnum(), false)
            end
            # \W non-word
            if esc == 87 do
                out pattern_node_charclass(this.arena, chars_word_extra(), ranges_alnum(), true)
            end
            # \s whitespace
            if esc == 115 do
                out pattern_node_charclass(this.arena, chars_space(), vec_new of (int)(), false)
            end
            # \S non-whitespace
            if esc == 83 do
                out pattern_node_charclass(this.arena, chars_space(), vec_new of (int)(), true)
            end

            # Literal escaped character
            out pattern_node_literal(this.arena, esc)
        end

        # Literal
        this.pos = this.pos + 1
        out pattern_node_literal(this.arena, ch)
    end.

    method parse_quantified() -> int:
        let atom = this.parse_atom()
        if atom < 0 do
            out atom
        end

        if this.pos < this.plen do
            let qch = str_byte_at(this.pat, this.pos)

            # * (0..unbounded)
            if qch == 42 do
                this.pos = this.pos + 1
                out pattern_node_repeat(this.arena, atom, 0, 0 - 1)
            end

            # + (1..unbounded)
            if qch == 43 do
                this.pos = this.pos + 1
                out pattern_node_repeat(this.arena, atom, 1, 0 - 1)
            end

            # ? (0..1)
            if qch == 63 do
                this.pos = this.pos + 1
                out pattern_node_repeat(this.arena, atom, 0, 1)
            end

            # {n}, {n,}, {n,m}
            if qch == 123 do # '{'
                var p = this.pos + 1
                var min_v = 0
                when p < this.plen loop
                    let c = str_byte_at(this.pat, p)
                    if !is_digit(c) do break end
                    min_v = min_v * 10 + (c - 48)
                    p = p + 1
                end

                if p < this.plen & str_byte_at(this.pat, p) == 125 do # '}'
                    this.pos = p + 1
                    out pattern_node_repeat(this.arena, atom, min_v, min_v)
                end

                if p < this.plen & str_byte_at(this.pat, p) == 44 do # ','
                    p = p + 1
                    if p < this.plen & str_byte_at(this.pat, p) == 125 do # '{n,}'
                        this.pos = p + 1
                        out pattern_node_repeat(this.arena, atom, min_v, 0 - 1)
                    end
                    var max_v = 0
                    when p < this.plen loop
                        let c = str_byte_at(this.pat, p)
                        if !is_digit(c) do break end
                        max_v = max_v * 10 + (c - 48)
                        p = p + 1
                    end
                    if p < this.plen & str_byte_at(this.pat, p) == 125 do # '{n,m}'
                        this.pos = p + 1
                        out pattern_node_repeat(this.arena, atom, min_v, max_v)
                    end
                end
            end
        end

        out atom
    end.

    method parse_sequence() -> int:
        var items = vec_new of (int)()

        when this.pos < this.plen loop
            let ch = str_byte_at(this.pat, this.pos)
            # Sequence terminates at | or )
            if ch == 124 do
                break
            end
            if ch == 41 do
                break
            end

            let node = this.parse_quantified()
            if node >= 0 do
                vec_push of (int)(items, node)
            else
                break
            end
        end

        if vec_len of (int)(items) == 1 do
            out vec_get of (int)(items, 0)
        end
        out pattern_node_sequence(this.arena, items)
    end.

    method parse_alternation() -> int:
        var branches = vec_new of (int)()

        let first_branch = this.parse_sequence()
        vec_push of (int)(branches, first_branch)

        when this.pos < this.plen loop
            if str_byte_at(this.pat, this.pos) != 124 do
                break
            end
            this.pos = this.pos + 1
            let branch = this.parse_sequence()
            vec_push of (int)(branches, branch)
        end

        if vec_len of (int)(branches) == 1 do
            out vec_get of (int)(branches, 0)
        end
        out pattern_node_alternation(this.arena, branches)
    end.
end.

func _regexCompile(source: &string) -> Pattern:
    var arena = pattern_arena_new()
    let plen = str_byte_len(source)
    var pos = 0

    var anchor_start = false
    var anchor_end = false

    if plen > 0 & str_byte_at(source, 0) == 94 do # '^'
        anchor_start = true
    end
    if plen > 0 & str_byte_at(source, plen - 1) == 36 do # '$'
        anchor_end = true
    end

    var parser = RegexParser (
        arena: arena,
        pat: str_slice_bytes(source, 0, plen),
        pos: pos,
        plen: plen,
        capture_counter: 0
    )
    let root_id = parser.parse_alternation()
    let nfa = pattern_compile_ir(arena, root_id, anchor_start, anchor_end)

    out Pattern (
        source: str_slice_bytes(source, 0, plen),
        engine_kind: 2, # Regex
        nfa: nfa
    )
end.

# -------------------------------------------------------
# Public regex.* namespace
# -------------------------------------------------------

entity RegexNamespace:
    method compile(source: &string) -> Pattern:
        out _regexCompile(source)
    end.

    method isMatch(pat: Pattern, text: &string) -> bool:
        out pat.isMatch(text)
    end.

    method fullMatch(pat: Pattern, text: &string) -> bool:
        out pat.fullMatch(text)
    end.

    method search(pat: Pattern, text: &string) -> Option of (Match):
        out _patternFindMatch(pat, text)
    end.

    method find(pat: Pattern, text: &string) -> string:
        out pat.find(text)
    end.

    method findAll(pat: Pattern, text: &string) -> Vec of (string):
        out pat.findAll(text)
    end.

    method extract(pat: Pattern, text: &string) -> Vec of (string):
        out _patternExtract(pat, text)
    end.

    method extractAll(pat: Pattern, text: &string) -> Vec:
        out _patternExtractAll(pat, text)
    end.

    method replace(pat: Pattern, text: &string, rep: &string) -> string:
        out _patternReplace(pat, text, rep)
    end.

    method replaceAll(pat: Pattern, text: &string, rep: &string) -> string:
        out _patternReplaceAll(pat, text, rep)
    end.

    method split(pat: Pattern, text: &string) -> Vec of (string):
        out _patternSplit(pat, text)
    end.
end.

var regex: RegexNamespace
