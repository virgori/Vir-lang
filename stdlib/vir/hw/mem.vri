##
 * vir/hw/mem.vri — Hardware-Aware Memory Operations
 * ===================================================
 * Aligned allocation, prefetching, and cache control.
 * Maps to platform-specific memory hints and intrinsics.
 *
 * Features:
 *   - Aligned allocation (16/32/64-byte boundaries)
 *   - Cache prefetching (L1/L2/L3)
 *   - Memory barriers (load/store fences)
 *   - NUMA-aware allocation (future)
 *   - Huge page support (Linux)
 ##

include types;
include alloc;
import alloc, free from alloc;

# ═══════════════════════════════════════════════════════
# Alignment Constants
# ═══════════════════════════════════════════════════════

const ALIGN_16:  16;
const ALIGN_32:  32;
const ALIGN_64:  64;
const ALIGN_4K:  4096;    # page-aligned;
const ALIGN_2M:  2097152; # huge page (2MB);

# Prefetch hints;
const PREFETCH_L1:    0;
const PREFETCH_L2:    1;
const PREFETCH_L3:    2;
const PREFETCH_NTA:   3;  # non-temporal (streaming);

# ═══════════════════════════════════════════════════════
# Aligned Allocation
# ═══════════════════════════════════════════════════════

# Allocate aligned memory;
func aligned_alloc:
    in(size: int; alignment: int)
    var raw = alloc(size + alignment + 8);
    if raw == none:
        out none;
    end
    # Calculate aligned address;
    var addr = raw >> int;
    var offset = alignment - (addr mod alignment);
    if offset == alignment:
        offset = 0;
    end
    var aligned = raw + offset;
    # Store original pointer at aligned[-8] for freeing;
    native_store<ptr>(aligned; -1; raw);
    out aligned;
end

# Free aligned memory;
func aligned_free:
    in(ptr: ptr)
    var raw = native_load<ptr>(ptr; -1);
    free(raw);
end

# Allocate zeroed aligned memory;
func aligned_alloc_zeroed:
    in(size: int; alignment: int)
    var p = aligned_alloc(size; alignment);
    if p == none:
        out none;
    end
    # Zero fill;
    var i = 0;
    when i < size loop
        native_store<byte>(p; i; 0);
        i = i + 1;
    end
    out p;
end

# ═══════════════════════════════════════════════════════
# Cache Operations
# ═══════════════════════════════════════════════════════

# Prefetch data into cache;
func prefetch:
    in(addr: ptr; hint: int)
    native("vir_hw_prefetch"; addr; hint);
end

# Prefetch for read;
func prefetch_read:
    in(addr: ptr)
    prefetch(addr; PREFETCH_L1);
end

# Prefetch for write;
func prefetch_write:
    in(addr: ptr)
    native("vir_hw_prefetch_write"; addr);
end

# Non-temporal store (bypass cache);
func stream_store:
    in(addr: ptr; offset: int; value: float)
    native("vir_hw_stream_store"; addr; offset; value);
end

# Cache line flush;
func cache_flush:
    in(addr: ptr)
    native("vir_hw_cache_flush"; addr);
end

# ═══════════════════════════════════════════════════════
# Memory Barriers
# ═══════════════════════════════════════════════════════

# Full memory fence;
func mem_fence:
    native("vir_hw_mem_fence");
end

# Load barrier;
func load_fence:
    native("vir_hw_load_fence");
end

# Store barrier;
func store_fence:
    native("vir_hw_store_fence");
end

# ═══════════════════════════════════════════════════════
# Bulk Memory Operations
# ═══════════════════════════════════════════════════════

# Fast memset using non-temporal stores for large buffers;
func fast_memset:
    in(dst: ptr; value: int; size: int)
    # Use streaming stores for buffers > 64KB;
    if size > 65536:
        var i = 0;
        when i < size loop
            stream_store(dst; i; value >> float);
            i = i + 1;
        end
        store_fence();
    else
        var i = 0;
        when i < size loop
            native_store<byte>(dst; i; value);
            i = i + 1;
        end
    end
end

# Fast memcpy with prefetching;
func fast_memcpy:
    in(dst: ptr; src: ptr; size: int)
    const PREFETCH_DIST: 256;
    var i = 0;
    when i < size loop
        # Prefetch ahead;
        if i + PREFETCH_DIST < size:
            prefetch_read(src + i + PREFETCH_DIST);
        end
        native_store<byte>(dst; i; native_load<byte>(src; i));
        i = i + 1;
    end
end

export ALIGN_16, ALIGN_32, ALIGN_64, ALIGN_4K, ALIGN_2M;
export PREFETCH_L1, PREFETCH_L2, PREFETCH_L3, PREFETCH_NTA;
export aligned_alloc, aligned_free, aligned_alloc_zeroed;
export prefetch, prefetch_read, prefetch_write;
export stream_store, cache_flush;
export mem_fence, load_fence, store_fence;
export fast_memset, fast_memcpy;
