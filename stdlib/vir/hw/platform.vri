##
 * vir/hw/platform.vri — Platform Detection & System Info
 * ========================================================
 * Runtime platform queries for adaptive compilation.
 *
 * Detects
 *   - Operating system (Linux, macOS, Windows)
 *   - Architecture (x86_64, aarch64, riscv64)
 *   - Total/available memory
 *   - Page size
 *   - Endianness
 ##

include types;

# ═══════════════════════════════════════════════════════
# OS Constants
# ═══════════════════════════════════════════════════════

const OS_UNKNOWN: 0;
const OS_LINUX:   1;
const OS_MACOS:   2;
const OS_WINDOWS: 3;
const OS_FREEBSD: 4;

# ═══════════════════════════════════════════════════════
# Platform Info Entity
# ═══════════════════════════════════════════════════════

entity PlatformInfo:
    os:            int;       # OS_* constant,
        os_name:       string;    # "Linux", "macOS", "Windows",
        os_version:    string;    # kernel/OS version string,
        arch:          int;       # ARCH_* from hw/cpu,
        arch_name:     string;    # "x86_64", "aarch64",
        total_mem:     int;       # total physical memory (bytes),
        avail_mem:     int;       # available memory (bytes),
        page_size:     int;       # memory page size (bytes),
        is_little_endian: bool,
        hostname:      string;
end

# ═══════════════════════════════════════════════════════
# Detection
# ═══════════════════════════════════════════════════════

func platform_info:
    out PlatformInfo (
        os:            native("vir_hw_os_type"),
        os_name:       native("vir_hw_os_name"),
        os_version:    native("vir_hw_os_version"),
        arch:          native("vir_hw_cpu_arch"),
        arch_name:     native("vir_hw_arch_name"),
        total_mem:     native("vir_hw_total_mem"),
        avail_mem:     native("vir_hw_avail_mem"),
        page_size:     native("vir_hw_page_size"),
        is_little_endian: native("vir_hw_is_little_endian"),
        hostname:      native("vir_hw_hostname")
    );
end
# Quick queries;
func platform_os:
    out native("vir_hw_os_type");
end
func platform_is_linux:
    out native("vir_hw_os_type") == OS_LINUX;
end
func platform_is_macos:
    out native("vir_hw_os_type") == OS_MACOS;
end
func platform_is_windows:
    out native("vir_hw_os_type") == OS_WINDOWS;
end
func platform_total_mem:
    out native("vir_hw_total_mem");
end
func platform_avail_mem:
    out native("vir_hw_avail_mem");
end
func platform_page_size:
    out native("vir_hw_page_size");
end
func platform_is_64bit:
    out native("vir_hw_pointer_size") == 8;
end
export PlatformInfo;
export OS_UNKNOWN, OS_LINUX, OS_MACOS, OS_WINDOWS, OS_FREEBSD;
export platform_info, platform_os;
export platform_is_linux, platform_is_macos, platform_is_windows;
export platform_total_mem, platform_avail_mem, platform_page_size;
export platform_is_64bit;
