##
 * vir/hw/init.vri — Hardware Module Index
 * =========================================
 * Convenience module that re-exports all hw submodules.
 *
 * Usage
 *   include hw;
 *   var info = cpu_info();
 *   var level = simd_detect();
 ##

include hw/cpu;
include hw/simd;
include hw/mem;
include hw/platform;

export CpuInfo;
export cpu_info, cpu_arch, cpu_cores, cpu_threads;
export cpu_has_avx2, cpu_has_neon, cpu_has_avx512;
export cpu_best_simd, cpu_tile_size;

export F32x4, F64x2, I32x4;
export simd_detect, simd_f32_lanes, simd_f64_lanes;
export f32x4, f32x4_splat, f32x4_load, f32x4_store;
export f32x4_add, f32x4_sub, f32x4_mul, f32x4_div, f32x4_fma;
export simd_vec_add, simd_dot, simd_saxpy;

export aligned_alloc, aligned_free, aligned_alloc_zeroed;
export prefetch, prefetch_read, prefetch_write;
export mem_fence, load_fence, store_fence;
export fast_memset, fast_memcpy;

export PlatformInfo;
export platform_info, platform_os;
export platform_is_linux, platform_is_macos, platform_is_windows;
export platform_total_mem, platform_avail_mem;
