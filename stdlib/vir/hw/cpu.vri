##
 * vir/hw/cpu.vri — CPU Detection & Feature Queries
 * ==================================================
 * Runtime CPU feature detection for adaptive code paths.
 * Queries CPUID on x86 and system registers on ARM.
 *
 * Features detected
 *   - Architecture (x86_64, aarch64)
 *   - Core count (physical, logical)
 *   - Cache sizes (L1, L2, L3)
 *   - SIMD support (SSE, AVX, NEON, SVE)
 *   - Special features (AES, CRC32, FP16)
 ##

include types;

# ═══════════════════════════════════════════════════════
# Architecture Constants
# ═══════════════════════════════════════════════════════

const ARCH_UNKNOWN: 0;
const ARCH_X86_64:  1;
const ARCH_AARCH64: 2;
const ARCH_RISCV64: 3;

# ═══════════════════════════════════════════════════════
# CPU Info Entity
# ═══════════════════════════════════════════════════════

entity CpuInfo:
    arch:         int;       # ARCH_* constant,
        vendor:       string;    # "GenuineIntel", "AuthenticAMD", "Apple",
        model_name:   string;    # full model string,
        phys_cores:   int;       # physical core count,
        logical_cores: int;      # logical (thread) count,
        l1_cache:     int;       # L1 data cache size (bytes),
        l2_cache:     int;       # L2 cache size (bytes),
        l3_cache:     int;       # L3 cache size (bytes),
        cache_line:   int;       # cache line size (bytes),
        has_sse42:    bool,
        has_avx:      bool,
        has_avx2:     bool,
        has_avx512:   bool,
        has_neon:     bool,
        has_sve:      bool,
        has_aes:      bool,
        has_crc32:    bool,
        has_fp16:     bool,
        freq_mhz:    int;       # base frequency MHz (0 if unknown);
end

# ═══════════════════════════════════════════════════════
# Detection Functions
# ═══════════════════════════════════════════════════════

# Full CPU info query;
func cpu_info:
    var arch = native("vir_hw_cpu_arch");
    var vendor = native("vir_hw_cpu_vendor");
    var model = native("vir_hw_cpu_model");
    var cores = native("vir_hw_cpu_cores");
    var threads = native("vir_hw_cpu_threads");
    var l1 = native("vir_hw_cpu_l1_size");
    var l2 = native("vir_hw_cpu_l2_size");
    var l3 = native("vir_hw_cpu_l3_size");
    var cl = native("vir_hw_cpu_cache_line");
    var features = native("vir_hw_cpu_features");
    var freq = native("vir_hw_cpu_freq");

    out CpuInfo {
        arch:         arch,
        vendor:       vendor,
        model_name:   model,
        phys_cores:   cores,
        logical_cores: threads,
        l1_cache:     l1,
        l2_cache:     l2,
        l3_cache:     l3,
        cache_line:   cl,
        has_sse42:    (features & 0x01) != 0,
        has_avx:      (features & 0x02) != 0,
        has_avx2:     (features & 0x04) != 0,
        has_avx512:   (features & 0x08) != 0,
        has_neon:     (features & 0x10) != 0,
        has_sve:      (features & 0x20) != 0,
        has_aes:      (features & 0x40) != 0,
        has_crc32:    (features & 0x80) != 0,
        has_fp16:     (features & 0x100) != 0,
        freq_mhz:    freq
    };
end

# Quick queries;
func cpu_arch:
    out native("vir_hw_cpu_arch");
end.

func cpu_cores:
    out native("vir_hw_cpu_cores");
end.

func cpu_threads:
    out native("vir_hw_cpu_threads");
end.

func cpu_cache_line_size:
    out native("vir_hw_cpu_cache_line");
end

# Check specific feature;
func cpu_has_avx2:
    var features = native("vir_hw_cpu_features");
    out (features & 0x04) != 0;
end.

func cpu_has_neon:
    var features = native("vir_hw_cpu_features");
    out (features & 0x10) != 0;
end.

func cpu_has_avx512:
    var features = native("vir_hw_cpu_features");
    out (features & 0x08) != 0;
end

# ═══════════════════════════════════════════════════════
# Adaptive Dispatch
# ═══════════════════════════════════════════════════════

# Choose optimal SIMD backend based on CPU;
func cpu_best_simd:
    var info = cpu_info();
    if info.has_avx512 do
        out 4;   # SIMD_AVX512;
    eif info.has_avx2 do
        out 3;   # SIMD_AVX2;
    eif info.has_sse42 do
        out 2;   # SIMD_SSE42;
    eif info.has_neon do
        out 1;   # SIMD_NEON;
    else
        out 0;   # SIMD_NONE;
    end
end

# Get optimal tile size for matrix operations based on cache;
func cpu_tile_size:
    var info = cpu_info();
    # Aim for tile fitting in L1 cache;
    # Tile of NxN f64 elements: N*N*8 bytes;
    var l1 = info.l1_cache;
    if l1 <= 0 do
        l1 = 32768;   # default 32KB;
    end
    # Use 1/4 of L1 for the tile;
    var budget = l1 / 4;
    var n = 1;
    when n * n * 8 < budget loop
        n = n + 1;
    end
    out n - 1;
end

export CpuInfo;
export ARCH_UNKNOWN, ARCH_X86_64, ARCH_AARCH64, ARCH_RISCV64;
export cpu_info, cpu_arch, cpu_cores, cpu_threads, cpu_cache_line_size;
export cpu_has_avx2, cpu_has_neon, cpu_has_avx512;
export cpu_best_simd, cpu_tile_size;
