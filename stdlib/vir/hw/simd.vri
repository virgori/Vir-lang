##
 * vir/hw/simd.vri — SIMD Intrinsics Abstraction
 * ================================================
 * Cross-platform SIMD operations for ARM NEON and x86 SSE/AVX.
 * Maps to hardware vector instructions via Q-IR auto-vectorizer.
 *
 * Supported backends
 *   - ARM NEON (float64x2, float32x4, int32x4)
 *   - x86 SSE4.2 (128-bit)
 *   - x86 AVX2 (256-bit)
 *   - Scalar fallback (portable)
 *
 * Architecture detection is automatic at compile time.
 * All operations are pure functions returning new vectors.
 ##

include types;

# ═══════════════════════════════════════════════════════
# SIMD Types
# ═══════════════════════════════════════════════════════

const SIMD_NONE:  0;
const SIMD_NEON:  1;
const SIMD_SSE42: 2;
const SIMD_AVX2:  3;
const SIMD_AVX512: 4;

entity F32x4:
    v0: float,
        v1: float,
        v2: float,
        v3: float;
end
entity F64x2:
    v0: float,
        v1: float;
end
entity I32x4:
    v0: int,
        v1: int,
        v2: int,
        v3: int;
end

# ═══════════════════════════════════════════════════════
# Detection
# ═══════════════════════════════════════════════════════

# Detect available SIMD level;
func simd_detect:
    var level = native("vir_hw_simd_detect");
    if level == none do
        out SIMD_NONE;
    end
    out level;
end
# Get SIMD lane width for float32;
func simd_f32_lanes:
    var level = simd_detect();
    case level
        SIMD_AVX512: out 16,
        SIMD_AVX2:   out 8,
        SIMD_SSE42:  out 4,
        SIMD_NEON:   out 4;
    else
        out 1;
    end
end
# Get SIMD lane width for float64;
func simd_f64_lanes:
    var level = simd_detect();
    case level
        SIMD_AVX512: out 8,
        SIMD_AVX2:   out 4,
        SIMD_SSE42:  out 2,
        SIMD_NEON:   out 2;
    else
        out 1;
    end
end
# ═══════════════════════════════════════════════════════
# F32x4 Operations (4-wide single precision)
# ═══════════════════════════════════════════════════════

func f32x4:
    in(a: float; b: float; c: float; d: float)
    out F32x4 ( v0: a; v1: b; v2: c; v3: d );
end
func f32x4_splat:
    in(v: float)
    out F32x4 ( v0: v; v1: v; v2: v; v3: v );
end
func f32x4_load:
    in(ptr: ptr; offset: int)
    out F32x4 (
        v0: native_load<float>(ptr; offset),
        v1: native_load<float>(ptr; offset + 1),
        v2: native_load<float>(ptr; offset + 2),
        v3: native_load<float>(ptr; offset + 3)
    );
end
func f32x4_store:
    in(ptr: ptr; offset: int; v: F32x4)
    native_store<float>(ptr; offset;     v.v0);
    native_store<float>(ptr; offset + 1; v.v1);
    native_store<float>(ptr; offset + 2; v.v2);
    native_store<float>(ptr; offset + 3; v.v3);
end
func f32x4_add:
    in(a: F32x4; b: F32x4)
    out F32x4 ( v0: a.v0 + b.v0; v1: a.v1 + b.v1; v2: a.v2 + b.v2; v3: a.v3 + b.v3 );
end
func f32x4_sub:
    in(a: F32x4; b: F32x4)
    out F32x4 ( v0: a.v0 - b.v0; v1: a.v1 - b.v1; v2: a.v2 - b.v2; v3: a.v3 - b.v3 );
end
func f32x4_mul:
    in(a: F32x4; b: F32x4)
    out F32x4 ( v0: a.v0 * b.v0; v1: a.v1 * b.v1; v2: a.v2 * b.v2; v3: a.v3 * b.v3 );
end
func f32x4_div:
    in(a: F32x4; b: F32x4)
    out F32x4 ( v0: a.v0 / b.v0; v1: a.v1 / b.v1; v2: a.v2 / b.v2; v3: a.v3 / b.v3 );
end
# Fused Multiply-Add: a * b + c;
func f32x4_fma:
    in(a: F32x4; b: F32x4; c: F32x4)
    out F32x4 (
        v0: a.v0 * b.v0 + c.v0,
        v1: a.v1 * b.v1 + c.v1,
        v2: a.v2 * b.v2 + c.v2,
        v3: a.v3 * b.v3 + c.v3
    );
end
# Horizontal sum: v0 + v1 + v2 + v3;
func f32x4_hsum:
    in(v: F32x4)
    out v.v0 + v.v1 + v.v2 + v.v3;
end
# Max of all lanes;
func f32x4_hmax:
    in(v: F32x4)
    var m = v.v0;
    if v.v1 > m do m = v.v1; end
    if v.v2 > m do m = v.v2; end
    if v.v3 > m do m = v.v3; end
    out m;
end
# ═══════════════════════════════════════════════════════
# F64x2 Operations (2-wide double precision)
# ═══════════════════════════════════════════════════════

func f64x2:
    in(a: float; b: float)
    out F64x2 ( v0: a; v1: b );
end
func f64x2_splat:
    in(v: float)
    out F64x2 ( v0: v; v1: v );
end
func f64x2_add:
    in(a: F64x2; b: F64x2)
    out F64x2 ( v0: a.v0 + b.v0; v1: a.v1 + b.v1 );
end
func f64x2_sub:
    in(a: F64x2; b: F64x2)
    out F64x2 ( v0: a.v0 - b.v0; v1: a.v1 - b.v1 );
end
func f64x2_mul:
    in(a: F64x2; b: F64x2)
    out F64x2 ( v0: a.v0 * b.v0; v1: a.v1 * b.v1 );
end
func f64x2_fma:
    in(a: F64x2; b: F64x2; c: F64x2)
    out F64x2 ( v0: a.v0 * b.v0 + c.v0; v1: a.v1 * b.v1 + c.v1 );
end
func f64x2_hsum:
    in(v: F64x2)
    out v.v0 + v.v1;
end
# ═══════════════════════════════════════════════════════
# Vectorized Bulk Operations
# ═══════════════════════════════════════════════════════

# Vectorized addition of float arrays;
func simd_vec_add:
    in(a: ptr; b: ptr; result: ptr; n: int)
    var i = 0;
    # Process 4 at a time;
    when i + 4 <= n loop
        var va = f32x4_load(a; i);
        var vb = f32x4_load(b; i);
        f32x4_store(result; i; f32x4_add(va; vb));
        i = i + 4;
    end
    # Scalar remainder;
    when i < n loop
        native_store<float>(result; i;
            native_load<float>(a; i) + native_load<float>(b; i));
        i = i + 1;
    end
end
# Vectorized dot product;
func simd_dot:
    in(a: ptr; b: ptr; n: int)
    var acc = f32x4_splat(0.0);
    var i = 0;
    when i + 4 <= n loop
        var va = f32x4_load(a; i);
        var vb = f32x4_load(b; i);
        acc = f32x4_fma(va; vb; acc);
        i = i + 4;
    end
    var sum = f32x4_hsum(acc);
    # Scalar remainder;
    when i < n loop
        sum = sum + native_load<float>(a; i) * native_load<float>(b; i);
        i = i + 1;
    end
    out sum;
end
# Vectorized SAXPY: y = a*x + y;
func simd_saxpy:
    in(alpha: float; x: ptr; y: ptr; n: int)
    var va = f32x4_splat(alpha);
    var i = 0;
    when i + 4 <= n loop
        var vx = f32x4_load(x; i);
        var vy = f32x4_load(y; i);
        f32x4_store(y; i; f32x4_fma(va; vx; vy));
        i = i + 4;
    end
    when i < n loop
        var xv = native_load<float>(x; i);
        var yv = native_load<float>(y; i);
        native_store<float>(y; i; alpha * xv + yv);
        i = i + 1;
    end
end
export F32x4, F64x2, I32x4;
export SIMD_NONE, SIMD_NEON, SIMD_SSE42, SIMD_AVX2, SIMD_AVX512;
export simd_detect, simd_f32_lanes, simd_f64_lanes;
export f32x4, f32x4_splat, f32x4_load, f32x4_store;
export f32x4_add, f32x4_sub, f32x4_mul, f32x4_div, f32x4_fma;
export f32x4_hsum, f32x4_hmax;
export f64x2, f64x2_splat, f64x2_add, f64x2_sub, f64x2_mul, f64x2_fma, f64x2_hsum;
export simd_vec_add, simd_dot, simd_saxpy;
