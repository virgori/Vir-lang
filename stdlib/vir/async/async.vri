##
 * vir/async/async.vri — Async Runtime (Event Loop + Futures)
 * ===========================================================
 * Inspired by Python: asyncio
 * Inspired by Rust: Future, async/await, tokio concepts
 *
 * Phase C — cooperative multitasking
 ##

include types;
include option;
import Option, Some, None from option;
include result;
import Result, Ok, Err from result;
include string;
import String from string;
include vec;
import Vec, vec_new, vec_push, vec_len from vec;
include deque;
import Deque, deque_new, deque_push_back, deque_pop_front from deque;
include time;
import Duration, Instant from time;

# ═══════════════════════════════════════════════════════
# Poll & Future traits
# ═══════════════════════════════════════════════════════

enum Poll<T>
    Ready(T);
    Pending;
end.

# Waker: notify the runtime a future is ready to be polled again
entity Waker:
    _task_id: int,
        _runtime: ptr;
end.

extern func native_waker_wake(runtime: ptr, task_id: int)

func waker_wake(w: Waker):
    native_waker_wake(w._runtime, w._task_id);
end.
# ═══════════════════════════════════════════════════════
# Task
# ═══════════════════════════════════════════════════════

enum TaskState:
    Ready     = 0;
    Running   = 1;
    Waiting   = 2;
    Completed = 3;
end.
entity Task:
    id:      int,
        state:   TaskState,
        _poll:   func(waker: Waker) -> Poll<void>   # type-erased future;
end.

# ═══════════════════════════════════════════════════════
# Event Loop
# ═══════════════════════════════════════════════════════

entity EventLoop:
    _tasks:     Vec<Task>,
        _ready_q:   Deque<int>,
        _next_id:   int,
        _running:   bool;
end.

extern func native_epoll_create() -> ptr
extern func native_epoll_wait(ep: ptr, timeout_ms: int) -> int
extern func native_epoll_add_fd(ep: ptr, fd: int, events: int) -> int

func event_loop_new:
    out EventLoop (;
        _tasks = vec_new<Task>(),
        _ready_q = deque_new<int>(),
        _next_id = 1,
        _running = false
    );
end.
func spawn_task(loop_: EventLoop, poll_fn: func(w: Waker) -> bool):
    id = loop_._next_id;
    loop_._next_id = loop_._next_id + 1;
    
    task = Task (;
        id = id,
        state = TaskState.Ready,
        _poll = poll_fn
    );
    vec_push<Task>(&loop_._tasks, task);
    deque_push_back<int>(&loop_._ready_q, id);
    out id;
end.
func run_until_complete(loop_: EventLoop):
    loop_._running = true;
    
    when loop_._running loop
        maybe_id = deque_pop_front<int>(&loop_._ready_q);
        case maybe_id;
        None:
                # Không còn task sẵn sàng -> kiểm tra còn task nào chưa xong
                has_pending = false;
                i = 0;
                when i < vec_len<Task>(loop_._tasks) loop
                    t = vec_get<Task>(loop_._tasks, i);
                    if t.state != TaskState.Completed do
                        has_pending = true;
                        break;
                    end
                    i = i + 1;
                end
                if !has_pending loop_. do _running = false end
                # Nếu còn pending -> yield/sleep rồi skip
                if has_pending do
                    native_thread_sleep_ms(1);
                end
        Some(task_id):
                _run_task(loop_, task_id);
        end
    end
end.
func _run_task(loop_: EventLoop, task_id: int):
    idx = _find_task(loop_, task_id);
    if idx < 0 do out end
    
    task = vec_get<Task>(loop_._tasks, idx);
    task.state = TaskState.Running;
    
    waker = Waker ( _task_id = task_id, _runtime = ptr_null() );
    result = task._poll(waker);
    
    case result;
        case Poll.Ready(_)
            task.state = TaskState.Completed;
        case Poll.Pending
            task.state = TaskState.Waiting;
    end
    
    vec_set<Task>(&loop_._tasks, idx, task);
end.
func _find_task(loop_: EventLoop, id: int):
    i = 0;
    when i < vec_len<Task>(loop_._tasks) loop
        if vec_get<Task>(loop_._tasks, i).id == id do
            out i;
        end
        i = i + 1;
    end
    out -1;
end.
func wake_task(loop_: EventLoop, task_id: int):
    deque_push_back<int>(&loop_._ready_q, task_id);
end.
# ═══════════════════════════════════════════════════════
# Async Utilities
# ═══════════════════════════════════════════════════════

# sleep_async: out pending lần đầu, ready lần hai
func sleep_async(ms: int):
    # Simplified: real impl needs timer registration
    started = false;
    out func(w: Waker) -> Poll<void>;
        if !started do
            started = true;
            native_thread_sleep_ms(ms);
            out Poll.Ready(());
        end
        out Poll.Ready(());
    end
end.
# yield_now: let other tasks run
func yield_now:
    yielded = false;
    out func(w: Waker) -> Poll<void>;
        if !yielded do
            yielded = true;
            waker_wake(w);
            out Poll.Pending;
        end
        out Poll.Ready(());
    end
end.
# ═══════════════════════════════════════════════════════
# Semaphore (async-aware)
# ═══════════════════════════════════════════════════════

entity Semaphore:
    _permits:  int,
        _waiters:  Deque<Waker>;
end.
func semaphore_new(permits: int):
    out Semaphore (;
        _permits = permits,
        _waiters = deque_new<Waker>()
    );
end.
func semaphore_acquire(sem: Semaphore):
    out func(w: Waker) -> Poll<void>;
        if sem._permits > 0 do
            sem._permits = sem._permits - 1;
            out Poll.Ready(());
        end
        deque_push_back<Waker>(&sem._waiters, w);
        out Poll.Pending;
    end
end.
func semaphore_release(sem: Semaphore):
    sem._permits = sem._permits + 1;
    maybe_w = deque_pop_front<Waker>(&sem._waiters);
    case maybe_w;
        case Some(w) waker_wake(w)
        case None ()
    end
end.