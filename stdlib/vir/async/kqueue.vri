##
 * vir/async/kqueue.vri — Async I/O Event Loop (kqueue)
 * ======================================================
 * macOS/BSD async I/O via kqueue.
 *
 * Provides event registration, polling, timer events,
 * and a simple event-driven reactor pattern.
 ##

include types;
include option;
import Option, Some, None from option;
include vec;
import Vec, vec_new, vec_push, vec_len, vec_get from vec;

# ═══════════════════════════════════════════════════════
# kqueue constants (macOS/BSD)
# ═══════════════════════════════════════════════════════

const EVFILT_READ   = -1;
const EVFILT_WRITE  = -2;
const EVFILT_TIMER  = -7;
const EVFILT_SIGNAL = -6;
const EVFILT_VNODE  = -4;

const EV_ADD        = 0x0001;
const EV_DELETE     = 0x0002;
const EV_ENABLE     = 0x0004;
const EV_DISABLE    = 0x0008;
const EV_ONESHOT    = 0x0010;
const EV_CLEAR      = 0x0020;
const EV_EOF        = 0x8000;
const EV_ERROR      = 0x4000;

# ═══════════════════════════════════════════════════════
# Event entities
# ═══════════════════════════════════════════════════════

entity KEvent:
    ident:   int;     # fd or timer id
    filter:  int;     # EVFILT_*
    flags:   int;     # EV_*
    fflags:  int;     # filter flags
    data:    int;     # bytes available or timer count
    udata:   int;     # user data
end.

func kevent_new:
    in(ident: int; filter: int; flags: int; udata: int)
    out KEvent {
        ident: ident, filter: filter, flags: flags,
        fflags: 0, data: 0, udata: udata
    };
end

# ═══════════════════════════════════════════════════════
# Native kqueue syscalls (extern)
# ═══════════════════════════════════════════════════════

extern func _kqueue: out int; end
extern func _kevent_register: in(kq: int; ident: int; filter: int; flags: int; fflags: int; data: int; udata: int) out int; end
extern func _kevent_poll: in(kq: int; max_events: int; timeout_ms: int) out Vec; end
extern func _close: in(fd: int) out int; end

# ═══════════════════════════════════════════════════════
# EventLoop
# ═══════════════════════════════════════════════════════

entity EventLoop:
    kq_fd:       int,
        running:     bool,
        event_count: int,
        max_events:  int;
end.

func eventloop_new:
    in(max_events: int)
    kq = _kqueue();
    out EventLoop {
        kq_fd: kq, running: false,
        event_count: 0, max_events: max_events
    };
end

# ═══════════════════════════════════════════════════════
# Register interest
# ═══════════════════════════════════════════════════════

func el_register_read:
    in(el: EventLoop; fd: int; udata: int)
    _kevent_register(el.kq_fd, fd, EVFILT_READ, EV_ADD | EV_ENABLE, 0, 0, udata);
end.

func el_register_write:
    in(el: EventLoop; fd: int; udata: int)
    _kevent_register(el.kq_fd, fd, EVFILT_WRITE, EV_ADD | EV_ENABLE, 0, 0, udata);
end.

func el_register_timer:
    in(el: EventLoop; timer_id: int; interval_ms: int; udata: int)
    _kevent_register(el.kq_fd, timer_id, EVFILT_TIMER, EV_ADD | EV_ENABLE, 0, interval_ms, udata);
end.

func el_register_oneshot_timer:
    in(el: EventLoop; timer_id: int; delay_ms: int; udata: int)
    _kevent_register(el.kq_fd, timer_id, EVFILT_TIMER, EV_ADD | EV_ONESHOT, 0, delay_ms, udata);
end

# ═══════════════════════════════════════════════════════
# Deregister
# ═══════════════════════════════════════════════════════

func el_deregister:
    in(el: EventLoop; fd: int; filter: int)
    _kevent_register(el.kq_fd, fd, filter, EV_DELETE, 0, 0, 0);
end

# ═══════════════════════════════════════════════════════
# Poll for events
# ═══════════════════════════════════════════════════════

func el_poll:
    in(el: EventLoop; timeout_ms: int)
    events = _kevent_poll(el.kq_fd, el.max_events, timeout_ms);
    el.event_count = el.event_count + vec_len(events);
    out events;
end

# ═══════════════════════════════════════════════════════
# Callback registry (simple fd→handler mapping)
# ═══════════════════════════════════════════════════════

entity Handler:
    fd:       int,
        filter:   int,
        callback: int;    # function pointer or handler id
end.

entity Reactor:
    loop:     EventLoop,
        handlers: Vec;        # Vec<Handler>
end.

func reactor_new:
    in(max_events: int)
    out Reactor {
        loop: eventloop_new(max_events),
        handlers: vec_new()
    };
end.

func reactor_on_read:
    in(r: Reactor; fd: int; handler_id: int)
    el_register_read(r.loop, fd, handler_id);
    vec_push(r.handlers, Handler { fd: fd, filter: EVFILT_READ, callback: handler_id });
end.

func reactor_on_write:
    in(r: Reactor; fd: int; handler_id: int)
    el_register_write(r.loop, fd, handler_id);
    vec_push(r.handlers, Handler { fd: fd, filter: EVFILT_WRITE, callback: handler_id });
end.

func reactor_on_timer:
    in(r: Reactor; timer_id: int; interval_ms: int; handler_id: int)
    el_register_timer(r.loop, timer_id, interval_ms, handler_id);
    vec_push(r.handlers, Handler { fd: timer_id, filter: EVFILT_TIMER, callback: handler_id });
end

# ═══════════════════════════════════════════════════════
# Run one tick of the reactor
# ═══════════════════════════════════════════════════════

func reactor_tick:
    in(r: Reactor; timeout_ms: int)
    events = el_poll(r.loop, timeout_ms);
    out events;    # Caller dispatches based on udata
end

# ═══════════════════════════════════════════════════════
# Shutdown
# ═══════════════════════════════════════════════════════

func reactor_stop:
    in(r: Reactor)
    r.loop.running = false;
    _close(r.loop.kq_fd);
end.

func el_close:
    in(el: EventLoop)
    el.running = false;
    _close(el.kq_fd);
end
