##
 * vir/db/query.vri — SQL Query Builder
 * ======================================
 * Inspired by: Knex.js, SQLAlchemy Core, Diesel
 *
 * Fluent query builder for SELECT, INSERT, UPDATE, DELETE.
 * Parameter binding with $1/$2 placeholders.
 * Sub-queries, JOINs, WHERE clauses, ORDER BY, LIMIT.
 ##

include types;
include option;
import Option, Some, None from option;
include vec;
import Vec, vec_new, vec_push, vec_len, vec_get from vec;
include str;
import StringBuilder, sb_new, sb_append, sb_build, sb_free from str;

# ═══════════════════════════════════════════════════════
# Query types
# ═══════════════════════════════════════════════════════

const QRY_SELECT = 1;
const QRY_INSERT = 2;
const QRY_UPDATE = 3;
const QRY_DELETE = 4;

# ═══════════════════════════════════════════════════════
# WHERE clause operators
# ═══════════════════════════════════════════════════════

entity WhereClause:
    column:   string,
        op:       string;      # "=", "!=", "<", ">", "<=", ">=", "LIKE", "IN", "IS NULL", "IS NOT NULL"
    param_idx: int;        # index into params Vec, -1 for IS NULL/IS NOT NULL
    logic:    string;      # "AND" or "OR"
end.

entity JoinClause:
    join_type: string;     # "INNER", "LEFT", "RIGHT", "CROSS"
    table:     string,
        on_left:   string,
        on_right:  string;
end.

entity OrderClause:
    column: string,
        desc:   bool;
end

# ═══════════════════════════════════════════════════════
# Query Builder
# ═══════════════════════════════════════════════════════

entity QueryBuilder:
    query_type: int,
        table:      string,
        columns:    Vec;       # Vec<string>
    wheres:     Vec;       # Vec<WhereClause>
    joins:      Vec;       # Vec<JoinClause>
    orders:     Vec;       # Vec<OrderClause>
    params:     Vec;       # Vec<string> — bound parameters
    limit_val:  int;       # -1 = no limit
    offset_val: int;       # -1 = no offset
    group_cols: Vec;       # Vec<string>
    having:     string;
    # INSERT specific
    insert_cols: Vec;      # Vec<string>
    insert_rows: Vec;      # Vec<Vec<string>>
    # UPDATE specific
    set_cols:   Vec;       # Vec<string>
    set_vals:   Vec;       # Vec<int> param indices
    distinct:   bool;
end

# ═══════════════════════════════════════════════════════
# Constructor
# ═══════════════════════════════════════════════════════

func qb_select:
    in(table: string)
    out QueryBuilder (
        query_type: QRY_SELECT, table: table,
        columns: vec_new(), wheres: vec_new(),
        joins: vec_new(), orders: vec_new(),
        params: vec_new(), limit_val: -1, offset_val: -1,
        group_cols: vec_new(), having: "",
        insert_cols: vec_new(), insert_rows: vec_new(),
        set_cols: vec_new(), set_vals: vec_new(),
        distinct: false
    );
end.

func qb_insert:
    in(table: string)
    out QueryBuilder (
        query_type: QRY_INSERT, table: table,
        columns: vec_new(), wheres: vec_new(),
        joins: vec_new(), orders: vec_new(),
        params: vec_new(), limit_val: -1, offset_val: -1,
        group_cols: vec_new(), having: "",
        insert_cols: vec_new(), insert_rows: vec_new(),
        set_cols: vec_new(), set_vals: vec_new(),
        distinct: false
    );
end.

func qb_update:
    in(table: string)
    out QueryBuilder (
        query_type: QRY_UPDATE, table: table,
        columns: vec_new(), wheres: vec_new(),
        joins: vec_new(), orders: vec_new(),
        params: vec_new(), limit_val: -1, offset_val: -1,
        group_cols: vec_new(), having: "",
        insert_cols: vec_new(), insert_rows: vec_new(),
        set_cols: vec_new(), set_vals: vec_new(),
        distinct: false
    );
end.

func qb_delete:
    in(table: string)
    out QueryBuilder (
        query_type: QRY_DELETE, table: table,
        columns: vec_new(), wheres: vec_new(),
        joins: vec_new(), orders: vec_new(),
        params: vec_new(), limit_val: -1, offset_val: -1,
        group_cols: vec_new(), having: "",
        insert_cols: vec_new(), insert_rows: vec_new(),
        set_cols: vec_new(), set_vals: vec_new(),
        distinct: false
    );
end

# ═══════════════════════════════════════════════════════
# Fluent methods
# ═══════════════════════════════════════════════════════

func qb_col:
    in(q: QueryBuilder; col: string)
    vec_push(q.columns, col);
    out q;
end.

func qb_distinct:
    in(q: QueryBuilder)
    q.distinct = true;
    out q;
end.

func qb_where:
    in(q: QueryBuilder; column: string; op: string; value: string)
    idx = vec_len(q.params);
    vec_push(q.params, value);
    clause = WhereClause (
        column: column, op: op, param_idx: idx, logic: "AND"
    );
    vec_push(q.wheres, clause);
    out q;
end.

func qb_or_where:
    in(q: QueryBuilder; column: string; op: string; value: string)
    idx = vec_len(q.params);
    vec_push(q.params, value);
    clause = WhereClause (
        column: column, op: op, param_idx: idx, logic: "OR"
    );
    vec_push(q.wheres, clause);
    out q;
end.

func qb_where_null:
    in(q: QueryBuilder; column: string)
    clause = WhereClause (
        column: column, op: "IS NULL", param_idx: -1, logic: "AND"
    );
    vec_push(q.wheres, clause);
    out q;
end.

func qb_where_not_null:
    in(q: QueryBuilder; column: string)
    clause = WhereClause (
        column: column, op: "IS NOT NULL", param_idx: -1, logic: "AND"
    );
    vec_push(q.wheres, clause);
    out q;
end.

func qb_join:
    in(q: QueryBuilder; join_type: string; table: string; left: string; right: string)
    j = JoinClause (
        join_type: join_type, table: table,
        on_left: left, on_right: right
    );
    vec_push(q.joins, j);
    out q;
end.

func qb_inner_join:
    in(q: QueryBuilder; table: string; left: string; right: string)
    out qb_join(q, "INNER", table, left, right);
end.

func qb_left_join:
    in(q: QueryBuilder; table: string; left: string; right: string)
    out qb_join(q, "LEFT", table, left, right);
end.

func qb_order:
    in(q: QueryBuilder; column: string; desc: bool)
    vec_push(q.orders, OrderClause ( column: column, desc: desc ));
    out q;
end.

func qb_limit:
    in(q: QueryBuilder; n: int)
    q.limit_val = n;
    out q;
end.

func qb_offset:
    in(q: QueryBuilder; n: int)
    q.offset_val = n;
    out q;
end.

func qb_group_by:
    in(q: QueryBuilder; col: string)
    vec_push(q.group_cols, col);
    out q;
end

# ═══════════════════════════════════════════════════════
# INSERT specific
# ═══════════════════════════════════════════════════════

func qb_into_cols:
    in(q: QueryBuilder; cols: Vec)
    q.insert_cols = cols;
    out q;
end.

func qb_values:
    in(q: QueryBuilder; vals: Vec)
    # vals: Vec<string>
    row_params = vec_new();
    i = 0;
    when i < vec_len(vals) loop
        idx = vec_len(q.params);
        vec_push(q.params, vec_get(vals, i));
        vec_push(row_params, idx);
        i = i + 1;
    end
    vec_push(q.insert_rows, row_params);
    out q;
end

# ═══════════════════════════════════════════════════════
# UPDATE specific
# ═══════════════════════════════════════════════════════

func qb_set:
    in(q: QueryBuilder; column: string; value: string)
    idx = vec_len(q.params);
    vec_push(q.params, value);
    vec_push(q.set_cols, column);
    vec_push(q.set_vals, idx);
    out q;
end

# ═══════════════════════════════════════════════════════
# SQL generation
# ═══════════════════════════════════════════════════════

func _qb_where_sql:
    in(q: QueryBuilder; sb: StringBuilder)
    if vec_len(q.wheres) == 0 do
        out 0;
    end
    sb_append(sb, " WHERE ");
    i = 0;
    when i < vec_len(q.wheres) loop
        w = vec_get(q.wheres, i);
        if i > 0 do
            sb_append(sb, " " + w.logic + " ");
        end
        sb_append(sb, w.column + " " + w.op);
        if w.param_idx >= 0 do
            sb_append(sb, " $" + int_to_str(w.param_idx + 1));
        end
        i = i + 1;
    end
    out 1;
end.

func qb_to_sql:
    in(q: QueryBuilder)
    sb = sb_new();

    if q.query_type == QRY_SELECT do
        sb_append(sb, "SELECT ");
        if q.distinct do
            sb_append(sb, "DISTINCT ");
        end
        if vec_len(q.columns) == 0 do
            sb_append(sb, "*");
        else
            i = 0;
            when i < vec_len(q.columns) loop
                if i > 0 do
                    sb_append(sb, ", ");
                end
                sb_append(sb, vec_get(q.columns, i));
                i = i + 1;
            end
        end
        sb_append(sb, " FROM " + q.table);
        # JOINs
        j = 0;
        when j < vec_len(q.joins) loop
            jn = vec_get(q.joins, j);
            sb_append(sb, " " + jn.join_type + " JOIN " + jn.table);
            sb_append(sb, " ON " + jn.on_left + " = " + jn.on_right);
            j = j + 1;
        end
        _qb_where_sql(q, sb);
        # GROUP BY
        if vec_len(q.group_cols) > 0 do
            sb_append(sb, " GROUP BY ");
            g = 0;
            when g < vec_len(q.group_cols) loop
                if g > 0 do
                    sb_append(sb, ", ");
                end
                sb_append(sb, vec_get(q.group_cols, g));
                g = g + 1;
            end
        end
        # ORDER BY
        if vec_len(q.orders) > 0 do
            sb_append(sb, " ORDER BY ");
            o = 0;
            when o < vec_len(q.orders) loop
                if o > 0 do
                    sb_append(sb, ", ");
                end
                ord = vec_get(q.orders, o);
                sb_append(sb, ord.column);
                if ord.desc do
                    sb_append(sb, " DESC");
                end
                o = o + 1;
            end
        end
        if q.limit_val >= 0 do
            sb_append(sb, " LIMIT " + int_to_str(q.limit_val));
        end
        if q.offset_val >= 0 do
            sb_append(sb, " OFFSET " + int_to_str(q.offset_val));
        end
    end

    if q.query_type == QRY_INSERT do
        sb_append(sb, "INSERT INTO " + q.table + " (");
        i = 0;
        when i < vec_len(q.insert_cols) loop
            if i > 0 do
                sb_append(sb, ", ");
            end
            sb_append(sb, vec_get(q.insert_cols, i));
            i = i + 1;
        end
        sb_append(sb, ") VALUES ");
        r = 0;
        when r < vec_len(q.insert_rows) loop
            if r > 0 do
                sb_append(sb, ", ");
            end
            sb_append(sb, "(");
            row = vec_get(q.insert_rows, r);
            c = 0;
            when c < vec_len(row) loop
                if c > 0 do
                    sb_append(sb, ", ");
                end
                pidx = vec_get(row, c);
                sb_append(sb, "$" + int_to_str(pidx + 1));
                c = c + 1;
            end
            sb_append(sb, ")");
            r = r + 1;
        end
    end

    if q.query_type == QRY_UPDATE do
        sb_append(sb, "UPDATE " + q.table + " SET ");
        i = 0;
        when i < vec_len(q.set_cols) loop
            if i > 0 do
                sb_append(sb, ", ");
            end
            col = vec_get(q.set_cols, i);
            pidx = vec_get(q.set_vals, i);
            sb_append(sb, col + " = $" + int_to_str(pidx + 1));
            i = i + 1;
        end
        _qb_where_sql(q, sb);
    end

    if q.query_type == QRY_DELETE do
        sb_append(sb, "DELETE FROM " + q.table);
        _qb_where_sql(q, sb);
    end

    out sb_build(sb);
end.

func qb_params:
    in(q: QueryBuilder)
    out q.params;
end
