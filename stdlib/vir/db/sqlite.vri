##
 * vir/db/sqlite.vri — SQLite Database Interface
 * ================================================
 * Inspired by Python: sqlite3
 * Inspired by Rust: rusqlite
 * Inspired by C: sqlite3.h API
 *
 * FFI wrapper around libsqlite3 for embedded SQL database access.
 * Provides prepared statements, transactions, and typed column access.
 ##

include types;
include result;
import Result, Ok, Err from result;
include option;
import Option, Some, None from option;
include string;
import String, str_new from string;
include vec;
import Vec, vec_new, vec_push, vec_len, vec_get from vec;

# ═══════════════════════════════════════════════════════
# SQLite3 Constants
# ═══════════════════════════════════════════════════════

const SQLITE_OK:        0;
const SQLITE_ERROR:     1;
const SQLITE_BUSY:      5;
const SQLITE_LOCKED:    6;
const SQLITE_MISUSE:    21;
const SQLITE_ROW:       100;
const SQLITE_DONE:      101;

# Open flags
const SQLITE_OPEN_READONLY:     0x01;
const SQLITE_OPEN_READWRITE:    0x02;
const SQLITE_OPEN_CREATE:       0x04;
const SQLITE_OPEN_MEMORY:       0x80;

# Column types
const SQLITE_INTEGER: 1;
const SQLITE_FLOAT:   2;
const SQLITE_TEXT:    3;
const SQLITE_BLOB:    4;
const SQLITE_NULL:    5;

# ═══════════════════════════════════════════════════════
# Entities
# ═══════════════════════════════════════════════════════

entity SqliteDb:
    _handle: ptr,
        path:    string,
        open:    bool;
end
entity SqliteStmt:
    _handle: ptr,
        _db:     ptr,
        sql:     string;
end
entity SqliteRow:
    columns: Vec<SqliteValue>;
end
enum SqliteValue:
    ValNull;
    ValInt(int);
    ValFloat(float);
    ValText(string);
    ValBlob(Vec<int>);
end

# ═══════════════════════════════════════════════════════
# Database lifecycle
# ═══════════════════════════════════════════════════════

## Open a database file. Creates if it doesn't exist.
func sqlite_open:
    in(path: string)
    handle = native_sqlite3_open(str_ptr(path));
    if handle == 0 do
        out Err(str_new("sqlite: failed to open"));
    end
    out Ok(SqliteDb ( _handle = handle, path = path, open = true ));
end
## Open an in-memory database.
func sqlite_open_memory:
    out sqlite_open(str_new(":memory:"));
end
## Close the database.
func sqlite_close:
    in(db: SqliteDb)
    if db.open do
        native_sqlite3_close(db._handle);
        db.open = false;
    end
end
# ═══════════════════════════════════════════════════════
# Execute (no results)
# ═══════════════════════════════════════════════════════

## Execute a SQL statement with no result rows.
func sqlite_exec:
    in(db: SqliteDb; sql: string)
    rc = native_sqlite3_exec(db._handle, str_ptr(sql));
    if rc != SQLITE_OK do
        msg = native_sqlite3_errmsg(db._handle);
        out Err(msg);
    end
    out Ok(0);
end
# ═══════════════════════════════════════════════════════
# Prepared Statements
# ═══════════════════════════════════════════════════════

## Prepare a SQL statement.
func sqlite_prepare:
    in(db: SqliteDb; sql: string)
    handle = native_sqlite3_prepare(db._handle, str_ptr(sql));
    if handle == 0 do
        msg = native_sqlite3_errmsg(db._handle);
        out Err(msg);
    end
    out Ok(SqliteStmt ( _handle = handle, _db = db._handle, sql = sql ));
end
## Bind an integer parameter (1-indexed).
func sqlite_bind_int:
    in(stmt: SqliteStmt; index: int; value: int)
    native_sqlite3_bind_int(stmt._handle, index, value);
end
## Bind a float parameter.
func sqlite_bind_float:
    in(stmt: SqliteStmt; index: int; value: float)
    native_sqlite3_bind_double(stmt._handle, index, value);
end
## Bind a text parameter.
func sqlite_bind_text:
    in(stmt: SqliteStmt; index: int; value: string)
    native_sqlite3_bind_text(stmt._handle, index, str_ptr(value), str_byte_len(value));
end
## Bind NULL.
func sqlite_bind_null:
    in(stmt: SqliteStmt; index: int)
    native_sqlite3_bind_null(stmt._handle, index);
end
## Step the statement (fetch next row). Returns true if row available.
func sqlite_step:
    in(stmt: SqliteStmt)
    rc = native_sqlite3_step(stmt._handle);
    out rc == SQLITE_ROW;
end
## Retrieve column count.
func sqlite_column_count:
    in(stmt: SqliteStmt)
    out native_sqlite3_column_count(stmt._handle);
end
## Retrieve column type.
func sqlite_column_type:
    in(stmt: SqliteStmt; col: int)
    out native_sqlite3_column_type(stmt._handle, col);
end
## Retrieve column as integer.
func sqlite_column_int:
    in(stmt: SqliteStmt; col: int)
    out native_sqlite3_column_int(stmt._handle, col);
end
## Retrieve column as float.
func sqlite_column_float:
    in(stmt: SqliteStmt; col: int)
    out native_sqlite3_column_double(stmt._handle, col);
end
## Retrieve column as text.
func sqlite_column_text:
    in(stmt: SqliteStmt; col: int)
    out native_sqlite3_column_text(stmt._handle, col);
end
## Reset statement for re-execution.
func sqlite_reset:
    in(stmt: SqliteStmt)
    native_sqlite3_reset(stmt._handle);
end
## Finalize (free) a prepared statement.
func sqlite_finalize:
    in(stmt: SqliteStmt)
    native_sqlite3_finalize(stmt._handle);
end
# ═══════════════════════════════════════════════════════
# High-level Query
# ═══════════════════════════════════════════════════════

## Execute a query and return all rows.
func sqlite_query:
    in(db: SqliteDb; sql: string)
    stmt_r = sqlite_prepare(db, sql);
    if is_err(stmt_r) do
        out Err(unwrap_ok(stmt_r));
    end
    stmt = unwrap_ok(stmt_r);

    rows = vec_new<SqliteRow>();
    when sqlite_step(stmt) loop
        ncols = sqlite_column_count(stmt);
        cols = vec_new<SqliteValue>();
        c = 0;
        when c < ncols loop
            ctype = sqlite_column_type(stmt, c);
            if ctype == SQLITE_INTEGER do
                vec_push<SqliteValue>(&cols, SqliteValue.ValInt(sqlite_column_int(stmt, c)));
            eif ctype == SQLITE_FLOAT do
                vec_push<SqliteValue>(&cols, SqliteValue.ValFloat(sqlite_column_float(stmt, c)));
            eif ctype == SQLITE_TEXT do
                vec_push<SqliteValue>(&cols, SqliteValue.ValText(sqlite_column_text(stmt, c)));
            else
                vec_push<SqliteValue>(&cols, SqliteValue.ValNull);
            end
            c = c + 1;
        end
        vec_push<SqliteRow>(&rows, SqliteRow ( columns = cols ));
    end
    sqlite_finalize(stmt);
    out Ok(rows);
end
# ═══════════════════════════════════════════════════════
# Transactions
# ═══════════════════════════════════════════════════════

func sqlite_begin:
    in(db: SqliteDb)
    out sqlite_exec(db, str_new("BEGIN"));
end
func sqlite_commit:
    in(db: SqliteDb)
    out sqlite_exec(db, str_new("COMMIT"));
end
func sqlite_rollback:
    in(db: SqliteDb)
    out sqlite_exec(db, str_new("ROLLBACK"));
end
## Get last inserted row ID.
func sqlite_last_insert_id:
    in(db: SqliteDb)
    out native_sqlite3_last_insert_rowid(db._handle);
end
## Get number of rows affected by last statement.
func sqlite_changes:
    in(db: SqliteDb)
    out native_sqlite3_changes(db._handle);
end
# ═══════════════════════════════════════════════════════
# Native FFI bindings
# ═══════════════════════════════════════════════════════

extern func native_sqlite3_open(path: ptr) -> ptr
extern func native_sqlite3_close(db: ptr)
extern func native_sqlite3_exec(db: ptr; sql: ptr) -> int
extern func native_sqlite3_errmsg(db: ptr) -> string
extern func native_sqlite3_prepare(db: ptr; sql: ptr) -> ptr
extern func native_sqlite3_bind_int(stmt: ptr; index: int; value: int)
extern func native_sqlite3_bind_double(stmt: ptr; index: int; value: float)
extern func native_sqlite3_bind_text(stmt: ptr; index: int; text: ptr; len: int)
extern func native_sqlite3_bind_null(stmt: ptr; index: int)
extern func native_sqlite3_step(stmt: ptr) -> int
extern func native_sqlite3_column_count(stmt: ptr) -> int
extern func native_sqlite3_column_type(stmt: ptr; col: int) -> int
extern func native_sqlite3_column_int(stmt: ptr; col: int) -> int
extern func native_sqlite3_column_double(stmt: ptr; col: int) -> float
extern func native_sqlite3_column_text(stmt: ptr; col: int) -> string
extern func native_sqlite3_reset(stmt: ptr)
extern func native_sqlite3_finalize(stmt: ptr)
extern func native_sqlite3_last_insert_rowid(db: ptr) -> int
extern func native_sqlite3_changes(db: ptr) -> int
