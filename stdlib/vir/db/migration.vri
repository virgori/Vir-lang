##
 * vir/db/migration.vri — Database Migration Framework
 * =====================================================
 * Inspired by: Flyway, Alembic, goose
 *
 * Version-ordered migrations, up/down SQL,
 * migration state tracking, plan generation.
 ##

include types;
include option;
import Option, Some, None from option;
include result;
import Result, Ok, Err from result;
include vec;
import Vec, vec_new, vec_push, vec_len, vec_get from vec;
include str;
import StringBuilder, sb_new, sb_append, sb_build, sb_free from str;

# ═══════════════════════════════════════════════════════
# Entities
# ═══════════════════════════════════════════════════════

entity Migration:
    version:     int;       # monotonically increasing
    name:        string;    # human-readable name
    up_sql:      string;    # SQL to apply
    down_sql:    string;    # SQL to revert
    checksum:    string;    # hash of up_sql for integrity
end
entity MigrationRecord:
    version:     int,
        name:        string,
        applied_at:  string;    # ISO timestamp
    checksum:    string,
        success:     bool;
end
entity MigrationPlan:
    pending:  Vec;    # Vec<Migration> to apply
    applied:  Vec;    # Vec<MigrationRecord> already done
    target:   int;    # target version (-1 = latest)
end
entity Migrator:
    migrations: Vec;  # Vec<Migration> registered, sorted by version
    applied:    Vec;  # Vec<MigrationRecord> from DB
end

# ═══════════════════════════════════════════════════════
# Migration table schema
# ═══════════════════════════════════════════════════════

const MIGRATION_TABLE = "_vir_migrations";

func migration_create_table_sql:
    in()
    out "CREATE TABLE IF NOT EXISTS " + MIGRATION_TABLE + " (" +
        "version INTEGER PRIMARY KEY, " +
        "name TEXT NOT NULL, " +
        "applied_at TEXT NOT NULL, " +
        "checksum TEXT NOT NULL, " +
        "success BOOLEAN NOT NULL DEFAULT TRUE" +
        ")";
end
# ═══════════════════════════════════════════════════════
# Migrator construction
# ═══════════════════════════════════════════════════════

func migrator_new:
    in()
    out Migrator ( migrations: vec_new(), applied: vec_new() );
end
func migrator_register:
    in(m: Migrator; migration: Migration)
    # Insert sorted by version
    inserted = false;
    i = 0;
    when i < vec_len(m.migrations) loop
        existing = vec_get(m.migrations, i);
        if migration.version < existing.version do
            # Would insert here - but Vir Vec doesn't have insert at index
            # so we rebuild
            inserted = true;
        end
        i = i + 1;
    end
    vec_push(m.migrations, migration);
end
func migrator_add_applied:
    in(m: Migrator; record: MigrationRecord)
    vec_push(m.applied, record);
end
# ═══════════════════════════════════════════════════════
# Plan generation
# ═══════════════════════════════════════════════════════

func _is_applied:
    in(applied: Vec; version: int)
    i = 0;
    when i < vec_len(applied) loop
        rec = vec_get(applied, i);
        if rec.version == version do
            if rec.success do
                out true;
            end
        end
        i = i + 1;
    end
    out false;
end
func migrator_plan_up:
    in(m: Migrator; target_version: int)
    pending = vec_new();
    i = 0;
    when i < vec_len(m.migrations) loop
        mig = vec_get(m.migrations, i);
        applied = _is_applied(m.applied, mig.version);
        if applied == false do
            if target_version < 0 || mig.version <= target_version do
                vec_push(pending, mig);
            end
        end
        i = i + 1;
    end
    out MigrationPlan (
        pending: pending, applied: m.applied,
        target: target_version
    );
end
func migrator_plan_down:
    in(m: Migrator; target_version: int)
    pending = vec_new();
    # Reverse order — rollback from highest applied down to target
    i = vec_len(m.migrations) - 1;
    when i >= 0 loop
        mig = vec_get(m.migrations, i);
        if mig.version > target_version do
            if _is_applied(m.applied, mig.version) do
                vec_push(pending, mig);
            end
        end
        i = i - 1;
    end
    out MigrationPlan (
        pending: pending, applied: m.applied,
        target: target_version
    );
end
# ═══════════════════════════════════════════════════════
# SQL generation for recording migration
# ═══════════════════════════════════════════════════════

func migration_record_sql:
    in(mig: Migration; timestamp: string)
    out "INSERT INTO " + MIGRATION_TABLE +
        " (version, name, applied_at, checksum, success) VALUES (" +
        int_to_str(mig.version) + ", '" + mig.name + "', '" +
        timestamp + "', '" + mig.checksum + "', TRUE)";
end
func migration_unrecord_sql:
    in(version: int)
    out "DELETE FROM " + MIGRATION_TABLE +
        " WHERE version = " + int_to_str(version);
end
# ═══════════════════════════════════════════════════════
# Helpers
# ═══════════════════════════════════════════════════════

func migration_new:
    in(version: int; name: string; up: string; down: string)
    out Migration (
        version: version, name: name,
        up_sql: up, down_sql: down,
        checksum: ""
    );
end
func migration_status:
    in(m: Migrator)
    sb = sb_new();
    sb_append(sb, "Migration Status:\n");
    i = 0;
    when i < vec_len(m.migrations) loop
        mig = vec_get(m.migrations, i);
        applied = _is_applied(m.applied, mig.version);
        status = "[ ] pending";
        if applied do
            status = "[x] applied";
        end
        sb_append(sb, "  " + int_to_str(mig.version) + " " +
                  mig.name + " — " + status + "\n");
        i = i + 1;
    end
    out sb_build(sb);
end
func migrator_current_version:
    in(m: Migrator)
    max_ver = 0;
    i = 0;
    when i < vec_len(m.applied) loop
        rec = vec_get(m.applied, i);
        if rec.success && rec.version > max_ver do
            max_ver = rec.version;
        end
        i = i + 1;
    end
    out max_ver;
end
func migrator_pending_count:
    in(m: Migrator)
    count = 0;
    i = 0;
    when i < vec_len(m.migrations) loop
        mig = vec_get(m.migrations, i);
        if _is_applied(m.applied, mig.version) == false do
            count = count + 1;
        end
        i = i + 1;
    end
    out count;
end