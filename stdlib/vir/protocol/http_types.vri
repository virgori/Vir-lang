# Module: protocol/http_types
# Defines HTTP types: Method, Version, Headers, BodyStream, HttpRequest, HttpResponse.

enum HttpMethod:
    Get
    Post
    Put
    Delete
    Head
    Options
    Patch
end.

enum HttpVersion:
    Http10
    Http11
    Http20
end.

enum FlowStatus:
    Active
    Blocked
    Closed
    Failed
end.

entity Header:
    name: string
    val: string
end.

entity HeaderMap:
    count: int
    max_headers: int
end.

# add -- add a header to the map. Returns false if at capacity.
func add(this: HeaderMap, name: string, val: string) -> bool:
    if this.count >= this.max_headers do
        out false
    end
    this.count = this.count + 1
    out true
end.

# has -- check if a header name exists in the map.
func has(this: HeaderMap, name: string) -> bool:
    if this.count > 0 do
        out true
    end
    out false
end.

# count -- number of headers in the map.
func count(this: HeaderMap) -> int:
    out this.count
end.

# ─── Internal ────────────────────────────────────────────────────────

func header_map_new(max_headers: int) -> HeaderMap:
    out HeaderMap(count: 0, max_headers: max_headers)
end.

entity BodyStream:
    content_length: int
    bytes_read: int
    bytes_written: int
    is_chunked: bool
    status: FlowStatus
end.

# complete -- true when all body bytes have been read.
func complete(this: BodyStream) -> bool:
    if this.is_chunked do
        if this.status == FlowStatus.Closed do
            out true
        end
        out false
    end
    if this.content_length >= 0 do
        if this.bytes_read >= this.content_length do
            out true
        end
    end
    out false
end.

func body_stream_new(content_length: int, is_chunked: bool) -> BodyStream:
    out BodyStream(
        content_length: content_length,
        bytes_read: 0,
        bytes_written: 0,
        is_chunked: is_chunked,
        status: FlowStatus.Active
    )
end.

entity HttpRequest:
    http_method: HttpMethod
    path: string
    version: HttpVersion
    headers: HeaderMap
    body: BodyStream
    is_keep_alive: bool
    is_upgrade: bool
end.

entity HttpResponse:
    status_code: int
    version: HttpVersion
    headers: HeaderMap
    body: BodyStream
end.

# request -- construct a new HttpRequest value.
func request(http_m: HttpMethod, path: string, version: HttpVersion) -> HttpRequest:
    var hm = header_map_new(32)
    var bs = body_stream_new(0, false)
    out HttpRequest(
        http_method: http_m,
        path: path,
        version: version,
        headers: hm,
        body: bs,
        is_keep_alive: true,
        is_upgrade: false
    )
end.

# response -- construct a new HttpResponse value.
func response(status_code: int, version: HttpVersion) -> HttpResponse:
    var hm = header_map_new(32)
    var bs = body_stream_new(0, false)
    out HttpResponse(
        status_code: status_code,
        version: version,
        headers: hm,
        body: bs
    )
end.
