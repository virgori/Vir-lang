# Module: memory/slice
# Defines zero-copy BufferSlice pointing to an underlying chunk or buffer.

entity BufferSlice:
    data: ptr
    length: int
    pool_ref: int
end.

func is_empty(this: BufferSlice) -> bool:
    if this.length == 0 do
        out true
    end
    out false
end.

func subslice(this: BufferSlice, offset: int, sub_len: int) -> BufferSlice:
    if offset + sub_len > this.length do
        out BufferSlice(data: 0, length: 0, pool_ref: this.pool_ref)
    end
    out BufferSlice(data: this.data + offset, length: sub_len, pool_ref: this.pool_ref)
end.

func slice_new(data: ptr, length: int, pool_ref: int) -> BufferSlice:
    out BufferSlice(data: data, length: length, pool_ref: pool_ref)
end.

func slice_sub(s: BufferSlice, offset: int, sub_len: int) -> BufferSlice:
    out s.subslice(offset, sub_len)
end.

func slice_empty() -> BufferSlice:
    out BufferSlice(data: 0, length: 0, pool_ref: 0)
end.
