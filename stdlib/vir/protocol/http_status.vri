# Module: protocol/http_status
# Standard HTTP Status Codes and Reason Phrases (RFC 9110 / RFC 7231).
# Comprehensive coverage of 1xx, 2xx, 3xx, 4xx, and 5xx status ranges.

# phrase -- human-readable reason phrase for a status code.
# Usage: phrase(200)  ->  "OK"
func phrase(code: int) -> string:
    # 1xx Informational
    if code == 100 do out "Continue" end
    if code == 101 do out "Switching Protocols" end
    if code == 102 do out "Processing" end
    if code == 103 do out "Early Hints" end

    # 2xx Success
    if code == 200 do out "OK" end
    if code == 201 do out "Created" end
    if code == 202 do out "Accepted" end
    if code == 203 do out "Non-Authoritative Information" end
    if code == 204 do out "No Content" end
    if code == 205 do out "Reset Content" end
    if code == 206 do out "Partial Content" end
    if code == 207 do out "Multi-Status" end
    if code == 208 do out "Already Reported" end
    if code == 226 do out "IM Used" end

    # 3xx Redirection
    if code == 300 do out "Multiple Choices" end
    if code == 301 do out "Moved Permanently" end
    if code == 302 do out "Found" end
    if code == 303 do out "See Other" end
    if code == 304 do out "Not Modified" end
    if code == 305 do out "Use Proxy" end
    if code == 307 do out "Temporary Redirect" end
    if code == 308 do out "Permanent Redirect" end

    # 4xx Client Errors
    if code == 400 do out "Bad Request" end
    if code == 401 do out "Unauthorized" end
    if code == 402 do out "Payment Required" end
    if code == 403 do out "Forbidden" end
    if code == 404 do out "Not Found" end
    if code == 405 do out "Method Not Allowed" end
    if code == 406 do out "Not Acceptable" end
    if code == 407 do out "Proxy Authentication Required" end
    if code == 408 do out "Request Timeout" end
    if code == 409 do out "Conflict" end
    if code == 410 do out "Gone" end
    if code == 411 do out "Length Required" end
    if code == 412 do out "Precondition Failed" end
    if code == 413 do out "Payload Too Large" end
    if code == 414 do out "URI Too Long" end
    if code == 415 do out "Unsupported Media Type" end
    if code == 416 do out "Range Not Satisfiable" end
    if code == 417 do out "Expectation Failed" end
    if code == 418 do out "I'm a teapot" end
    if code == 421 do out "Misdirected Request" end
    if code == 422 do out "Unprocessable Content" end
    if code == 423 do out "Locked" end
    if code == 424 do out "Failed Dependency" end
    if code == 425 do out "Too Early" end
    if code == 426 do out "Upgrade Required" end
    if code == 428 do out "Precondition Required" end
    if code == 429 do out "Too Many Requests" end
    if code == 431 do out "Request Header Fields Too Large" end
    if code == 451 do out "Unavailable For Legal Reasons" end

    # 5xx Server Errors
    if code == 500 do out "Internal Server Error" end
    if code == 501 do out "Not Implemented" end
    if code == 502 do out "Bad Gateway" end
    if code == 503 do out "Service Unavailable" end
    if code == 504 do out "Gateway Timeout" end
    if code == 505 do out "HTTP Version Not Supported" end
    if code == 506 do out "Variant Also Negotiates" end
    if code == 507 do out "Insufficient Storage" end
    if code == 508 do out "Loop Detected" end
    if code == 510 do out "Not Extended" end
    if code == 511 do out "Network Authentication Required" end

    out "Unknown"
end.

# statusLine -- formatted HTTP/1.1 status line with CRLF.
# Usage: statusLine(200)  ->  "HTTP/1.1 200 OK\r\n"
func statusLine(code: int) -> string:
    # 1xx
    if code == 100 do out "HTTP/1.1 100 Continue\r\n" end
    if code == 101 do out "HTTP/1.1 101 Switching Protocols\r\n" end
    if code == 103 do out "HTTP/1.1 103 Early Hints\r\n" end

    # 2xx
    if code == 200 do out "HTTP/1.1 200 OK\r\n" end
    if code == 201 do out "HTTP/1.1 201 Created\r\n" end
    if code == 202 do out "HTTP/1.1 202 Accepted\r\n" end
    if code == 204 do out "HTTP/1.1 204 No Content\r\n" end
    if code == 206 do out "HTTP/1.1 206 Partial Content\r\n" end

    # 3xx
    if code == 301 do out "HTTP/1.1 301 Moved Permanently\r\n" end
    if code == 302 do out "HTTP/1.1 302 Found\r\n" end
    if code == 304 do out "HTTP/1.1 304 Not Modified\r\n" end
    if code == 307 do out "HTTP/1.1 307 Temporary Redirect\r\n" end
    if code == 308 do out "HTTP/1.1 308 Permanent Redirect\r\n" end

    # 4xx
    if code == 400 do out "HTTP/1.1 400 Bad Request\r\n" end
    if code == 401 do out "HTTP/1.1 401 Unauthorized\r\n" end
    if code == 403 do out "HTTP/1.1 403 Forbidden\r\n" end
    if code == 404 do out "HTTP/1.1 404 Not Found\r\n" end
    if code == 405 do out "HTTP/1.1 405 Method Not Allowed\r\n" end
    if code == 408 do out "HTTP/1.1 408 Request Timeout\r\n" end
    if code == 409 do out "HTTP/1.1 409 Conflict\r\n" end
    if code == 413 do out "HTTP/1.1 413 Payload Too Large\r\n" end
    if code == 414 do out "HTTP/1.1 414 URI Too Long\r\n" end
    if code == 415 do out "HTTP/1.1 415 Unsupported Media Type\r\n" end
    if code == 429 do out "HTTP/1.1 429 Too Many Requests\r\n" end

    # 5xx
    if code == 500 do out "HTTP/1.1 500 Internal Server Error\r\n" end
    if code == 501 do out "HTTP/1.1 501 Not Implemented\r\n" end
    if code == 502 do out "HTTP/1.1 502 Bad Gateway\r\n" end
    if code == 503 do out "HTTP/1.1 503 Service Unavailable\r\n" end
    if code == 504 do out "HTTP/1.1 504 Gateway Timeout\r\n" end
    if code == 505 do out "HTTP/1.1 505 HTTP Version Not Supported\r\n" end

    out "HTTP/1.1 500 Internal Server Error\r\n"
end.

# ─── Category helpers ────────────────────────────────────────────────

func isInformational(code: int) -> bool:
    if code >= 100 do
        if code <= 199 do
            out true
        end
    end
    out false
end.

func isSuccess(code: int) -> bool:
    if code >= 200 do
        if code <= 299 do
            out true
        end
    end
    out false
end.

func isRedirection(code: int) -> bool:
    if code >= 300 do
        if code <= 399 do
            out true
        end
    end
    out false
end.

func isClientError(code: int) -> bool:
    if code >= 400 do
        if code <= 499 do
            out true
        end
    end
    out false
end.

func isServerError(code: int) -> bool:
    if code >= 500 do
        if code <= 599 do
            out true
        end
    end
    out false
end.

func isError(code: int) -> bool:
    if code >= 400 do
        out true
    end
    out false
end.

export phrase, statusLine, isInformational, isSuccess, isRedirection, isClientError, isServerError, isError
