# Module: protocol/http1_serializer
# HTTP/1.1 response wire serialization and chunked transfer framing.


func chunkEnd() -> string:
    out "0\r\n\r\n"
end.

func estimateSize(header_count: int, body_len: int) -> int:
    out 64 + (header_count * 48) + body_len
end.

entity Http1SerializerNamespace:
    method chunkEnd() -> string:
        out chunkEnd()
    end.
    method estimateSize(header_count: int, body_len: int) -> int:
        out estimateSize(header_count, body_len)
    end.
end.

var serializer: Http1SerializerNamespace

export Http1SerializerNamespace, serializer
