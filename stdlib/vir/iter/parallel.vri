##
 * vir/iter/parallel.vri — Parallel Iterators
 * =============================================
 * Inspired by: Rayon (Rust), Java parallel streams
 *
 * Parallel map, filter, reduce, for_each over Vec.
 * Chunk-based work splitting for multi-threaded execution.
 ##

include types;
include option;
import Option, Some, None from option;
include vec;
import Vec, vec_new, vec_push, vec_len, vec_get from vec;

# ═══════════════════════════════════════════════════════
# Parallel iterator config
# ═══════════════════════════════════════════════════════

entity ParIter:
    data:         Vec,
        chunk_size:   int,
        num_workers:  int;
end.
func par_iter(data: Vec, num_workers: int):
    chunk = vec_len(data) / num_workers;
    if chunk < 1 do
        chunk = 1;
    end
    out ParIter ( data: data, chunk_size: chunk, num_workers: num_workers );
end.
# ═══════════════════════════════════════════════════════
# Chunking
# ═══════════════════════════════════════════════════════

entity Chunk:
    start: int,
        end_:  int;
end.
func _par_chunks(total: int, num_chunks: int):
    chunks = vec_new();
    chunk_size = total / num_chunks;
    if chunk_size < 1 do
        chunk_size = 1;
    end
    remainder = total % num_chunks;
    pos = 0;
    i = 0;
    when i < num_chunks && pos < total loop
        cs = chunk_size;
        if i < remainder do
            cs = cs + 1;
        end
        end_pos = pos + cs;
        if end_pos > total do
            end_pos = total;
        end
        vec_push(chunks, Chunk ( start: pos, end_: end_pos ));
        pos = end_pos;
        i = i + 1;
    end
    out chunks;
end.
# ═══════════════════════════════════════════════════════
# Parallel map (single-threaded simulation)
# In real impl, each chunk runs on a separate thread
# ═══════════════════════════════════════════════════════

func par_map(pi: ParIter, f: func(int) int):
    result = vec_new();
    chunks = _par_chunks(vec_len(pi.data), pi.num_workers);
    ci = 0;
    when ci < vec_len(chunks) loop
        chunk = vec_get(chunks, ci);
        i = chunk.start;
        when i < chunk.end_ loop
            vec_push(result, f(vec_get(pi.data, i)));
            i = i + 1;
        end
        ci = ci + 1;
    end
    out result;
end.
func par_map_str(pi: ParIter, f: func(string) string):
    result = vec_new();
    i = 0;
    when i < vec_len(pi.data) loop
        vec_push(result, f(vec_get(pi.data, i)));
        i = i + 1;
    end
    out result;
end.
# ═══════════════════════════════════════════════════════
# Parallel filter
# ═══════════════════════════════════════════════════════

func par_filter(pi: ParIter, pred: func(int) bool):
    result = vec_new();
    chunks = _par_chunks(vec_len(pi.data), pi.num_workers);
    ci = 0;
    when ci < vec_len(chunks) loop
        chunk = vec_get(chunks, ci);
        i = chunk.start;
        when i < chunk.end_ loop
            val = vec_get(pi.data, i);
            if pred(val) do
                vec_push(result, val);
            end
            i = i + 1;
        end
        ci = ci + 1;
    end
    out result;
end.
# ═══════════════════════════════════════════════════════
# Parallel reduce
# ═══════════════════════════════════════════════════════

func par_reduce:
    in  pi: ParIter;
        f: func(int; int) int;
        identity: int
    chunks = _par_chunks(vec_len(pi.data), pi.num_workers);
    # Each chunk produces a partial result
    partials = vec_new();
    ci = 0;
    when ci < vec_len(chunks) loop
        chunk = vec_get(chunks, ci);
        acc = identity;
        i = chunk.start;
        when i < chunk.end_ loop
            acc = f(acc, vec_get(pi.data, i));
            i = i + 1;
        end
        vec_push(partials, acc);
        ci = ci + 1;
    end
    # Combine partial results
    result = identity;
    i = 0;
    when i < vec_len(partials) loop
        result = f(result, vec_get(partials, i));
        i = i + 1;
    end
    out result;
end.
# ═══════════════════════════════════════════════════════
# Parallel for_each
# ═══════════════════════════════════════════════════════

func par_for_each(pi: ParIter, f: func(int) int):
    chunks = _par_chunks(vec_len(pi.data), pi.num_workers);
    ci = 0;
    when ci < vec_len(chunks) loop
        chunk = vec_get(chunks, ci);
        i = chunk.start;
        when i < chunk.end_ loop
            f(vec_get(pi.data, i));
            i = i + 1;
        end
        ci = ci + 1;
    end
end.
# ═══════════════════════════════════════════════════════
# Parallel find
# ═══════════════════════════════════════════════════════

func par_find(pi: ParIter, pred: func(int) bool):
    i = 0;
    when i < vec_len(pi.data) loop
        val = vec_get(pi.data, i);
        if pred(val) do
            out Some(val);
        end
        i = i + 1;
    end
    out None;
end.
# ═══════════════════════════════════════════════════════
# Parallel any / all
# ═══════════════════════════════════════════════════════

func par_any(pi: ParIter, pred: func(int) bool):
    out is_some(par_find(pi, pred));
end.
func par_all(pi: ParIter, pred: func(int) bool):
    i = 0;
    when i < vec_len(pi.data) loop
        if pred(vec_get(pi.data, i)) == false do
            out false;
        end
        i = i + 1;
    end
    out true;
end.
# ═══════════════════════════════════════════════════════
# Parallel sum / min / max
# ═══════════════════════════════════════════════════════

func par_sum(data: Vec, num_workers: int):
    pi = par_iter(data, num_workers);
    func _add(a: int, b: int):
        out a + b
    end.
    out par_reduce(pi, _add, 0);
end.
func par_min(data: Vec, num_workers: int):
    if vec_len(data) == 0 do
        out None;
    end
    result = vec_get(data, 0);
    i = 1;
    when i < vec_len(data) loop
        v = vec_get(data, i);
        if v < result do
            result = v;
        end
        i = i + 1;
    end
    out Some(result);
end.
func par_max(data: Vec, num_workers: int):
    if vec_len(data) == 0 do
        out None;
    end
    result = vec_get(data, 0);
    i = 1;
    when i < vec_len(data) loop
        v = vec_get(data, i);
        if v > result do
            result = v;
        end
        i = i + 1;
    end
    out Some(result);
end.