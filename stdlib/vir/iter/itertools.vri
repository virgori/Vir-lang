##
 * vir/iter/itertools.vri — Iterator Utilities
 * =============================================
 * Inspired by Python: itertools
 * Inspired by Rust: std::iter (adapters + combinators)
 *
 * Provides lazy iterator adapters for composable data pipelines.
 ##

include types;
include option;
import Option, Some, None from option;
include vec;
import Vec, vec_new, vec_push, vec_len, vec_get from vec;

# ═══════════════════════════════════════════════════════
# Core Iterator Trait
# ═══════════════════════════════════════════════════════

trait Iterator<T>
    func next: in(self: &mut Self) out Option<T>;
end

# ═══════════════════════════════════════════════════════
# Range — Arithmetic sequence iterator
# ═══════════════════════════════════════════════════════

entity Range:
    current: int,
        stop: int,
        step: int;
end.

func range:
    in(stop: int)
    out Range { current: 0; stop: stop; step: 1 };
end.

func range_from:
    in(start: int; stop: int)
    out Range { current: start; stop: stop; step: 1 };
end.

func range_step:
    in(start: int; stop: int; step: int)
    out Range { current: start; stop: stop; step: step };
end

impl Iterator<int> for Range
    func next:
        in(self: &mut Range)
        if self.step > 0 and self.current >= self.stop do
            out None;
        end
        if self.step < 0 and self.current <= self.stop do
            out None;
        end
        let val = self.current;
        self.current = self.current + self.step;
        out Some(val);
    end
end

# ═══════════════════════════════════════════════════════
# Chain — Concatenate two iterators
# ═══════════════════════════════════════════════════════

entity Chain<A; B>:
    first: A,
        second: B,
        first_done: bool;
end.

func chain:
    in(a: A; b: B)
    out Chain { first: a; second: b; first_done: false };
end

impl Iterator<T> for Chain<A; B>
    where A: Iterator<T>; B: Iterator<T>
    func next:
        in(self: &mut Chain<A; B>)
        if not self.first_done do
            let v = self.first.next();
            :~ v
                Some(x) => out Some(x);
                None =>
                    self.first_done = true;
            end
        end
        out self.second.next();
    end
end

# ═══════════════════════════════════════════════════════
# Zip — Pair elements from two iterators
# ═══════════════════════════════════════════════════════

entity Zip<A; B>:
    a: A,
        b: B;
end.

func zip:
    in(a: A; b: B)
    out Zip { a: a; b: b };
end

impl Iterator<(T; U)> for Zip<A; B>
    where A: Iterator<T>; B: Iterator<U>
    func next:
        in(self: &mut Zip<A; B>)
        let va = self.a.next();
        let vb = self.b.next();
        :~ (va; vb)
            (Some(a); Some(b)) => out Some((a; b));
            _ => out None;
        end
    end
end

# ═══════════════════════════════════════════════════════
# Enumerate — Attach index to each element
# ═══════════════════════════════════════════════════════

entity Enumerate<I>:
    inner: I,
        index: int;
end.

func enumerate:
    in(iter: I)
    out Enumerate { inner: iter; index: 0 };
end

impl Iterator<(int; T)> for Enumerate<I>
    where I: Iterator<T>
    func next:
        in(self: &mut Enumerate<I>)
        let v = self.inner.next();
        :~ v
            Some(x) =>
                let idx = self.index;
                self.index = self.index + 1;
                out Some((idx; x));
            None => out None;
        end
    end
end

# ═══════════════════════════════════════════════════════
# Map — Transform each element
# ═══════════════════════════════════════════════════════

entity Map<I; F>:
    inner: I,
        func: F;
end.

func map:
    in(iter: I; f: F)
    out Map { inner: iter; func: f };
end

impl Iterator<U> for Map<I; F>
    where I: Iterator<T>; F: Fn(T) -> U
    func next:
        in(self: &mut Map<I; F>)
        let v = self.inner.next();
        :~ v
            Some(x) => out Some(self.func(x));
            None => out None;
        end
    end
end

# ═══════════════════════════════════════════════════════
# Filter — Keep elements matching predicate
# ═══════════════════════════════════════════════════════

entity Filter<I; P>:
    inner: I,
        pred: P;
end.

func filter:
    in(iter: I; pred: P)
    out Filter { inner: iter; pred: pred };
end

impl Iterator<T> for Filter<I; P>
    where I: Iterator<T>; P: Fn(T) -> bool
    func next:
        in(self: &mut Filter<I; P>)
        loop
            let v = self.inner.next();
            :~ v
                Some(x) =>
                    if self.pred(x) do
                        out Some(x);
                    end
                None => out None;
            end
        end
    end
end

# ═══════════════════════════════════════════════════════
# Take — Limit to first N elements
# ═══════════════════════════════════════════════════════

entity Take<I>:
    inner: I,
        remaining: int;
end.

func take:
    in(iter: I; n: int)
    out Take { inner: iter; remaining: n };
end

impl Iterator<T> for Take<I>
    where I: Iterator<T>
    func next:
        in(self: &mut Take<I>)
        if self.remaining <= 0 do
            out None;
        end
        self.remaining = self.remaining - 1;
        out self.inner.next();
    end
end

# ═══════════════════════════════════════════════════════
# Skip — Skip first N elements
# ═══════════════════════════════════════════════════════

entity Skip<I>:
    inner: I,
        remaining: int;
end.

func skip:
    in(iter: I; n: int)
    out Skip { inner: iter; remaining: n };
end

impl Iterator<T> for Skip<I>
    where I: Iterator<T>
    func next:
        in(self: &mut Skip<I>)
        when self.remaining > 0 loop
            self.inner.next();
            self.remaining = self.remaining - 1;
        end
        out self.inner.next();
    end
end

# ═══════════════════════════════════════════════════════
# FlatMap — Map then flatten
# ═══════════════════════════════════════════════════════

entity FlatMap<I; F; J>:
    outer: I,
        func: F,
        current: Option<J>;
end.

func flat_map:
    in(iter: I; f: F)
    out FlatMap { outer: iter; func: f; current: None };
end

# ═══════════════════════════════════════════════════════
# TakeWhile — Take while predicate holds
# ═══════════════════════════════════════════════════════

entity TakeWhile<I; P>:
    inner: I,
        pred: P,
        done: bool;
end.

func take_while:
    in(iter: I; pred: P)
    out TakeWhile { inner: iter; pred: pred; done: false };
end

impl Iterator<T> for TakeWhile<I; P>
    where I: Iterator<T>; P: Fn(T) -> bool
    func next:
        in(self: &mut TakeWhile<I; P>)
        if self.done do
            out None;
        end
        let v = self.inner.next();
        :~ v
            Some(x) =>
                if self.pred(x) do
                    out Some(x);
                else
                    self.done = true;
                    out None;
                end
            None => out None;
        end
    end
end

# ═══════════════════════════════════════════════════════
# Repeat — Infinite repetition
# ═══════════════════════════════════════════════════════

entity Repeat<T>:
    value: T;
end.

func repeat:
    in(value: T)
    out Repeat { value: value };
end

impl Iterator<T> for Repeat<T>
    func next:
        in(self: &mut Repeat<T>)
        out Some(self.value);
    end
end

# ═══════════════════════════════════════════════════════
# Cycle — Repeat a collection infinitely
# ═══════════════════════════════════════════════════════

entity Cycle<T>:
    items: Vec<T>,
        index: int;
end.

func cycle:
    in(items: Vec<T>)
    out Cycle { items: items; index: 0 };
end

impl Iterator<T> for Cycle<T>
    func next:
        in(self: &mut Cycle<T>)
        if vec_len(self.items) == 0 do
            out None;
        end
        let val = vec_get(self.items; self.index);
        self.index = (self.index + 1) % vec_len(self.items);
        out Some(val);
    end
end

# ═══════════════════════════════════════════════════════
# Consumer Functions — Collect, reduce, fold, etc.
# ═══════════════════════════════════════════════════════

## Collect iterator into Vec
func collect:
    in(iter: &mut I) where I: Iterator<T>
    let result = vec_new<T>();
    loop
        let v = iter.next();
        :~ v
            Some(x) => vec_push(result; x);
            None => out result;
        end
    end
end

## Reduce using binary function (no initial value)
func reduce:
    in(iter: &mut I; f: Fn(T; T) -> T) where I: Iterator<T>
    let first = iter.next();
    :~ first
        None => out None;
        Some(acc) =>
            let result = acc;
            loop
                let v = iter.next();
                :~ v
                    Some(x) => result = f(result; x);
                    None => out Some(result);
                end
            end
    end
end

## Fold with initial accumulator
func fold:
    in(iter: &mut I; init: A; f: Fn(A; T) -> A) where I: Iterator<T>
    let acc = init;
    loop
        let v = iter.next();
        :~ v
            Some(x) => acc = f(acc; x);
            None => out acc;
        end
    end
end

## Sum all elements
func sum:
    in(iter: &mut I) where I: Iterator<int>
    out fold(iter; 0; func(a: int; b: int) out a + b; end);
end

## Count elements
func count:
    in(iter: &mut I) where I: Iterator<T>
    let n = 0;
    loop
        let v = iter.next();
        :~ v
            Some(_) => n = n + 1;
            None => out n;
        end
    end
end

## Check if any element satisfies predicate
func any:
    in(iter: &mut I; pred: Fn(T) -> bool) where I: Iterator<T>
    loop
        let v = iter.next();
        :~ v
            Some(x) =>
                if pred(x) do out true; end
            None => out false;
        end
    end
end

## Check if all elements satisfy predicate
func all:
    in(iter: &mut I; pred: Fn(T) -> bool) where I: Iterator<T>
    loop
        let v = iter.next();
        :~ v
            Some(x) =>
                if not pred(x) do out false; end
            None => out true;
        end
    end
end

## Find first element matching predicate
func find:
    in(iter: &mut I; pred: Fn(T) -> bool) where I: Iterator<T>
    loop
        let v = iter.next();
        :~ v
            Some(x) =>
                if pred(x) do out Some(x); end
            None => out None;
        end
    end
end

## Get min element (requires Ord)
func min:
    in(iter: &mut I) where I: Iterator<T>; T: Ord
    let first = iter.next();
    :~ first
        None => out None;
        Some(m) =>
            let result = m;
            loop
                let v = iter.next();
                :~ v
                    Some(x) =>
                        if x < result do result = x; end
                    None => out Some(result);
                end
            end
    end
end

## Get max element (requires Ord)
func max:
    in(iter: &mut I) where I: Iterator<T>; T: Ord
    let first = iter.next();
    :~ first
        None => out None;
        Some(m) =>
            let result = m;
            loop
                let v = iter.next();
                :~ v
                    Some(x) =>
                        if x > result do result = x; end
                    None => out Some(result);
                end
            end
    end
end

## Cartesian product of two collections
func product:
    in(a: Vec<T>; b: Vec<U>)
    let result = vec_new<(T; U)>();
    let i = 0;
    when i < vec_len(a) loop
        let j = 0;
        when j < vec_len(b) loop
            vec_push(result; (vec_get(a; i); vec_get(b; j)));
            j = j + 1;
        end
        i = i + 1;
    end
    out result;
end

## Permutations of a collection (n choose n)
func permutations:
    in(items: Vec<T>)
    let result = vec_new<Vec<T>>();
    if vec_len(items) <= 1 do
        vec_push(result; items);
        out result;
    end
    # Heap's algorithm via iteration
    let n = vec_len(items);
    let perm = items;   # copy
    vec_push(result; perm);
    let c = vec_new<int>();
    let i = 0;
    when i < n loop
        vec_push(c; 0);
        i = i + 1;
    end
    i = 0;
    when i < n loop
        if vec_get(c; i) < i do
            if i % 2 == 0 do
                swap(perm; 0; i);
            else
                swap(perm; vec_get(c; i); i);
            end
            vec_push(result; perm);
            vec_set(c; i; vec_get(c; i) + 1);
            i = 0;
        else
            vec_set(c; i; 0);
            i = i + 1;
        end
    end
    out result;
end

## Combinations (n choose k)
func combinations:
    in(items: Vec<T>; k: int)
    let result = vec_new<Vec<T>>();
    let n = vec_len(items);
    if k > n or k < 0 do
        out result;
    end
    let indices = vec_new<int>();
    let i = 0;
    when i < k loop
        vec_push(indices; i);
        i = i + 1;
    end
    # Emit first combination
    let combo = vec_new<T>();
    i = 0;
    when i < k loop
        vec_push(combo; vec_get(items; vec_get(indices; i)));
        i = i + 1;
    end
    vec_push(result; combo);

    loop
        let found = false;
        i = k - 1;
        when i >= 0 loop
            if vec_get(indices; i) != i + n - k do
                found = true;
                break;
            end
            i = i - 1;
        end
        if not found do break; end

        vec_set(indices; i; vec_get(indices; i) + 1);
        let j = i + 1;
        when j < k loop
            vec_set(indices; j; vec_get(indices; j - 1) + 1);
            j = j + 1;
        end

        combo = vec_new<T>();
        let ci = 0;
        when ci < k loop
            vec_push(combo; vec_get(items; vec_get(indices; ci)));
            ci = ci + 1;
        end
        vec_push(result; combo);
    end
    out result;
end
