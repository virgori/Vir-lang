##
 * vir/doctest/doctest.vri — Doc-Test Runner
 * ===========================================
 * Phase D — extract and run code examples from doc-comments
 *
 * Inspired by: doctest (Python/Rust), ExUnit.DocTest (Elixir)
 *
 * Doc-comment format:
 *   ## Example:
 *   ```vir
 *   var x = 42
 *   assert_eq(x, 42)
 *   ```
 ##

include types;
include option;
import Option, Some, None from option;
include string;
import String, str_new, str_concat, str_contains, str_starts_with, str_trim from string;
include builder;
import sb_new, sb_append, sb_push_byte, sb_build from builder;
include vec;
import Vec, vec_new, vec_push, vec_len, vec_get from vec;
include file;
import file_read_string from file;
include stdio;
import println from stdio;
include test;
import TestResult from test;

# ═══════════════════════════════════════════════════════
# DocTest item
# ═══════════════════════════════════════════════════════

entity DocTest:
    source_file: string;
    line_number: int      # line in source where ``` started;
    code:        string      # extracted code block;
    expected:    Option<string>  # optional expected output;
end

entity DocTestResult:
    test:    DocTest;
    passed:  bool;
    message: Option<string>;
end

entity DocTestSuite:
    tests:   Vec<DocTest>;
    results: Vec<DocTestResult>;
end

# ═══════════════════════════════════════════════════════
# Extract doc-tests from source file
# ═══════════════════════════════════════════════════════

func extract_doctests:
    in(source_path:string)
    content = file_read_string(source_path);
    tests = vec_new<DocTest>();
    
    lines = _split_lines(content);
    i = 0;
    total = vec_len<string>(lines);
    
    when i < total loop
        line = str_trim(vec_get<string>(lines, i));
        
        # Look for ```vir inside doc-comments (## or ///)
        if _is_doc_code_start(line):
            code_sb = sb_new();
            start_line = i + 1;
            i = i + 1;
            
            when i < total loop
                cl = vec_get<string>(lines, i);
                trimmed = str_trim(cl);
                
                # End of code block?
                if str_starts_with(trimmed, str_new("```")):
                    i = i + 1;
                    break;
                end
                
                # Strip leading doc-comment markers
                code_line = _strip_doc_prefix(cl);
                sb_append(&code_sb, code_line);
                sb_push_byte(&code_sb, 0x0A)  # \n;
                i = i + 1;
            end
            
            code = sb_build(code_sb);
            if str_byte_len(str_trim(code)) > 0:
                vec_push<DocTest>(&tests, DocTest {;
                    source_file = source_path,;
                    line_number = start_line,;
                    code = code,;
                    expected = None;
                });
            end
        else
            i = i + 1;
        end
    end
    
    out tests;
end

# ═══════════════════════════════════════════════════════
# Run doc-tests
# ═══════════════════════════════════════════════════════

# Native function to eval a Vir code snippet
native func native_eval_vir(code: string) -> TestResult;

func run_doctests:
    in(source_path:string)
    tests = extract_doctests(source_path);
    results = vec_new<DocTestResult>();
    
    i = 0;
    when i < vec_len<DocTest>(tests) loop
        test = vec_get<DocTest>(tests, i);
        result = _run_one_doctest(test);
        vec_push<DocTestResult>(&results, result);
        i = i + 1;
    end
    
    out DocTestSuite { tests = tests, results = results };
end

func _run_one_doctest:
    in(test:DocTest)
    result = native_eval_vir(test.code);
    if result.passed:
        out DocTestResult { test = test, passed = true, message = None };
    else
        out DocTestResult {;
            test = test,;
            passed = false,;
            message = Some(result.message);
        };
    end
end

# ═══════════════════════════════════════════════════════
# Report
# ═══════════════════════════════════════════════════════

func doctest_report:
    in(suite:DocTestSuite)
    sb = sb_new();
    passed = 0;
    failed = 0;
    total = vec_len<DocTestResult>(suite.results);
    
    i = 0;
    when i < total loop
        r = vec_get<DocTestResult>(suite.results, i);
        if r.passed:
            passed = passed + 1;
        else
            failed = failed + 1;
            sb_append(&sb, str_new("FAIL "));
            sb_append(&sb, r.test.source_file);
            sb_append(&sb, str_new(":"));
            sb_append(&sb, int_to_string(r.test.line_number));
            sb_append(&sb, str_new("\n"));
            case r.message;
                case Some(msg)
                    sb_append(&sb, str_new("  -> "));
                    sb_append(&sb, msg);
                    sb_append(&sb, str_new("\n"));
                case None {}
            end
            sb_append(&sb, str_new("  Code:\n"));
            # Indent code block
            code_lines = _split_lines(r.test.code);
            j = 0;
            when j < vec_len<String>(code_lines) loop
                sb_append(&sb, str_new("    "));
                sb_append(&sb, vec_get<string>(code_lines, j));
                sb_append(&sb, str_new("\n"));
                j = j + 1;
            end
        end
        i = i + 1;
    end
    
    sb_append(&sb, str_new("\nDocTests: "));
    sb_append(&sb, int_to_string(total));
    sb_append(&sb, str_new(" total, "));
    sb_append(&sb, int_to_string(passed));
    sb_append(&sb, str_new(" passed, "));
    sb_append(&sb, int_to_string(failed));
    sb_append(&sb, str_new(" failed\n"));
    
    out sb_build(sb);
end

func doctest_print_report:
    in(suite:DocTestSuite)
    println(doctest_report(suite));
end

# ═══════════════════════════════════════════════════════
# Helpers
# ═══════════════════════════════════════════════════════

func _is_doc_code_start:
    in(line:string)
    # Matches:  ```vir  or  ## ```vir  or  /// ```vir
    if str_contains(line, str_new("```vir")) out true end:
    out false;
end

func _strip_doc_prefix:
    in(line:string)
    trimmed = str_trim_start(line);
    if str_starts_with(trimmed, str_new("/// ")):
        out str_slice_from(trimmed, 4);
    end
    if str_starts_with(trimmed, str_new("///")):
        out str_slice_from(trimmed, 3);
    end
    if str_starts_with(trimmed, str_new("## ")):
        out str_slice_from(trimmed, 3);
    end
    out line;
end

func _split_lines:
    in(s:string)
    lines = vec_new<string>();
    sb = sb_new();
    i = 0;
    len = str_byte_len(s);
    
    when i < len loop
        ch = str_byte_at(s, i);
        if ch == 0x0A:
            vec_push<string>(&lines, sb_build(sb));
            sb = sb_new();
        else
            sb_push_byte(&sb, ch);
        end
        i = i + 1;
    end
    
    last = sb_build(sb);
    if str_byte_len(last) > 0 vec_push<String>(&lines, last) end:
    
    out lines;
end
