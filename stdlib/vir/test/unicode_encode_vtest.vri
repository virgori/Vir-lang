# Unicode bridge registry smoke

include types
include string
import str_byte_len from string
include slice
import slice_new from slice
include result
import Ok, Err from result
include str.encode
import encode, utf8_to_ascii_lossy from str.encode

func main:
    source2 = "é"
    source2_data = source2 as ptr
    source2_len = str_byte_len(source2)
    lossy = utf8_to_ascii_lossy(source2_data, source2_len)
    if lossy.len != 1 do out 5 end
    if native_read_u8(lossy.data, 0) != 0x3F do out 6 end

    source = "€"
    source_data = source as ptr
    source_len = str_byte_len(source)
    input = slice_new(source_data, source_len)

    encoded = encode.utf8ToUtf16(input)
    case encoded
        Ok(buf):
            if buf.len != 2 do out 1 end
            if native_read_u8(buf.data, 0) != 0xAC do out 2 end
            if native_read_u8(buf.data, 1) != 0x20 do out 3 end
        Err(_): out 4
    end
    out 0
end.
