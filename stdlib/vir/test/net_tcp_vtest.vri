include net
include http
import str_new from string

func main:
    case net.resolve("127.0.0.1")
        Err(_): out 10
        Ok(_): ()
    end
    case net.connectHost("127.0.0.1", 9876)
    Err(_): out 5
    Ok(stream):
        wire = str_new("GET /hello HTTP/1.1\r\nHost: 127.0.0.1\r\nConnection: close\r\n\r\n")
        case net.writeAll(stream, wire)
        Err(_):
            net.close(stream)
            out 4
        Ok(_):
            case net.readAll(stream)
            Err(_):
                net.close(stream)
                out 3
            Ok(raw):
                net.close(stream)
                case http.parseResponse(raw)
                Err(_): out 2
                Ok(resp):
                    if http.status(resp) != 200 do out 1 end
                end
            end
        end
    end
    out 0
end.
