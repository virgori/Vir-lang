include http
import str_eq, str_new from string

func expectOk(raw: string, code: int, reason: string) -> int:
    case http.parseResponse(raw)
        Ok(resp):
            if http.status(resp) != code do out 100 end
            if str_eq(http.statusText(resp), reason) == false do out 101 end
            out 0
        Err(_): out 102
    end
end.

func expectErr(raw: string) -> int:
    case http.parseResponse(raw)
        Ok(_): out 200
        Err(_): out 0
    end
end.

func main:
    let u = http.parseUrl("http://example.com/path?q=1")
    case u
        Ok(_): ()
        Err(_): out 1
    end

    if expectOk("HTTP/1.1 200 OK\r\n\r\nhello", 200, str_new("OK")) != 0 do out 2 end
    if expectOk("HTTP/1.1 201 Created\r\n\r\n", 201, str_new("Created")) != 0 do out 3 end
    if expectOk("HTTP/1.1 204 No Content\r\n\r\n", 204, str_new("No Content")) != 0 do out 4 end
    if expectOk("HTTP/1.1 301 Moved Permanently\r\n\r\n", 301, str_new("Moved Permanently")) != 0 do out 5 end
    if expectOk("HTTP/1.1 404\r\n\r\n", 404, str_new("Not Found")) != 0 do out 6 end
    if expectOk("HTTP/1.1 500 Internal Server Error\r\n\r\nx", 500, str_new("Internal Server Error")) != 0 do out 7 end

    case http.parseResponse("HTTP/1.1 200 OK\r\n\r\nline1\r\nline2")
        Ok(resp):
            if str_eq(resp.body, str_new("line1\r\nline2")) == false do out 8 end
        Err(_): out 9
    end

    if expectErr("HTTP/1.1 200 OK\r\nno blank line") != 0 do out 10 end
    if expectErr("HTTP/1.0\r\n\r\n") != 0 do out 11 end

    out 0
end.
