##
 * vir/test/bootstrap_vtest.vri — Bootstrap Self-Compilation Tests
 * =================================================================
 * Validates that virc.vri can compile subsets of itself:
 *   - Lexer can tokenize lexer.vri source
 *   - Parser can parse parser.vri source
 *   - QIR pipeline can lower and optimize a real Vir function
 *   - virc pipeline stages don't crash on self-referential input
 *
 * This is the Stage 1→Stage 2 bootstrap verification.
 ##

include types;
include string;
import String, str_new, str_eq, str_len from string;
include vec;
import Vec, vec_new, vec_push, vec_len, vec_get from vec;
include test;
import TestSuite, TestResult from test;
include vtest;
import VTestRegistry,
       vtest_suite_new, vtest_add,
       vtest_registry_new, vtest_registry_add_suite, vtest_registry_run,
       vtest_print_summary, vtest_exit_code,
       vtest_pass, vtest_fail,
       vtest_expect_true, vtest_expect_false,
       vtest_expect_eq_i64, vtest_expect_ne_i64 from vtest;
include compiler/lexer;
import Lexer, Token, TokType, lexer_new, tokenize from compiler/lexer;
include compiler/parser;
import Parser, AstNode, AstType, parser_new, parse_program from compiler/parser;
include compiler/ir_optimizer;
import QOp, QOperand, QInstr, QFunction, QModule,
       OptStats, opt_stats_total_changes,
       q_none, q_vreg, q_imm, q_instr,
       qir_pipeline_m_stats, qir_pipeline_l,
       lower_ctx_new, qir_pipeline_h from ir_optimizer;
include compiler/codegen;
import TargetArch, codegen_emit_module, codebuf_offset from compiler/codegen;


# ═══════════════════════════════════════════════════════
# Bootstrap Test: Lexer can process Vir syntax patterns
# ═══════════════════════════════════════════════════════

## Tokenize a realistic Vir function declaration
func _test_bootstrap_lex_func_decl:
    let src = "func vm_apply_patch:\n    in(state:VMState; target:int; source:int; patch_id:int)\n    out state;\nend";
    let lex = lexer_new(src);
    lex = tokenize(lex);
    if lex.error_count == 0 and lex.token_count >= 10:
        out vtest_pass();
    end
    out vtest_fail(str_new("lexer failed on realistic function declaration"));
end

## Tokenize entity definition (common in Vir sources)
func _test_bootstrap_lex_entity:
    let src = "entity VMState:\n    regs: Vec<VMReg>;\n    ip: int;\n    module: QModule;\nend";
    let lex = lexer_new(src);
    lex = tokenize(lex);
    if lex.error_count == 0 and lex.token_count >= 8:
        out vtest_pass();
    end
    out vtest_fail(str_new("lexer failed on entity definition"));
end

## Tokenize include/import statements
func _test_bootstrap_lex_includes:
    let src = "include types;\ninclude string;\nimport String, str_new from string;\ninclude vec;\nimport Vec, vec_new, vec_push from vec;";
    let lex = lexer_new(src);
    lex = tokenize(lex);
    if lex.error_count == 0 and lex.token_count >= 10:
        out vtest_pass();
    end
    out vtest_fail(str_new("lexer failed on include/import"));
end

## Tokenize enum definition
func _test_bootstrap_lex_enum:
    let src = "enum TierLevel:\n    Interpreter = 0;\n    BaselineJIT = 1;\n    OptimizedJIT = 2;\nend";
    let lex = lexer_new(src);
    lex = tokenize(lex);
    if lex.error_count == 0 and lex.token_count >= 8:
        out vtest_pass();
    end
    out vtest_fail(str_new("lexer failed on enum definition"));
end

## Tokenize a when-loop (idiomatic Vir loop)
func _test_bootstrap_lex_when_loop:
    let src = "when i < n loop\n    vec_push(v, i);\n    i = i + 1;\nend";
    let lex = lexer_new(src);
    lex = tokenize(lex);
    if lex.error_count == 0 and lex.token_count >= 8:
        out vtest_pass();
    end
    out vtest_fail(str_new("lexer failed on when-loop"));
end

## Tokenize conditional (if/eif/else)
func _test_bootstrap_lex_conditional:
    let src = "if x == 0:\n    out zero;\neif x > 0:\n    out positive;\nelse\n    out negative;\nend";
    let lex = lexer_new(src);
    lex = tokenize(lex);
    if lex.error_count == 0 and lex.token_count >= 8:
        out vtest_pass();
    end
    out vtest_fail(str_new("lexer failed on conditional"));
end


# ═══════════════════════════════════════════════════════
# Bootstrap Test: Parser handles Vir constructs
# ═══════════════════════════════════════════════════════

## Parse a simple function
func _test_bootstrap_parse_simple_func:
    let src = "func identity: in(x:int) out x; end";
    let lex = lexer_new(src);
    lex = tokenize(lex);
    if lex.error_count > 0:
        out vtest_fail(str_new("lex error before parse"));
    end
    let parser = parser_new(lex.tokens);
    let ast = parse_program(parser);
    if ast.error_count == 0:
        out vtest_pass();
    end
    out vtest_fail(str_new("parser failed on simple function"));
end

## Parse entity definition
func _test_bootstrap_parse_entity:
    let src = "entity Point: x: int; y: int; end";
    let lex = lexer_new(src);
    lex = tokenize(lex);
    let parser = parser_new(lex.tokens);
    let ast = parse_program(parser);
    if ast.error_count == 0:
        out vtest_pass();
    end
    out vtest_fail(str_new("parser failed on entity"));
end

## Parse let + arithmetic
func _test_bootstrap_parse_let_arith:
    let src = "func calc: let a = 10; let b = a * 2 + 3; out b; end";
    let lex = lexer_new(src);
    lex = tokenize(lex);
    let parser = parser_new(lex.tokens);
    let ast = parse_program(parser);
    if ast.error_count == 0:
        out vtest_pass();
    end
    out vtest_fail(str_new("parser failed on let + arithmetic"));
end


# ═══════════════════════════════════════════════════════
# Bootstrap Test: Full compiler pipeline on Vir-like code
# ═══════════════════════════════════════════════════════

## Full pipeline: function with loop → QIR → optimise → codegen
func _test_bootstrap_pipeline_loop:
    let src = "func sum_to: in(n:int) let s = 0; let i = 0; when i < n loop s = s + i; i = i + 1; end out s; end";
    let lex = lexer_new(src);
    lex = tokenize(lex);
    if lex.error_count > 0:
        out vtest_fail(str_new("lex error in pipeline test"));
    end
    let parser = parser_new(lex.tokens);
    let ast = parse_program(parser);
    if ast.error_count > 0:
        out vtest_fail(str_new("parse error in pipeline test"));
    end
    let ctx = lower_ctx_new(str_new("bootstrap"));
    ctx = qir_pipeline_h(ctx, ast);
    if ctx.error_count > 0:
        out vtest_fail(str_new("QIR lowering error in pipeline test"));
    end
    var (opt_mod, stats) = qir_pipeline_m_stats(ctx.module);
    if vec_len<QFunction>(opt_mod.functions) >= 1:
        out vtest_pass();
    end
    out vtest_fail(str_new("pipeline produced no functions"));
end

## QIR-L register allocation on bootstrap input
func _test_bootstrap_regalloc:
    let src = "func fib: in(n:int) if n < 2: out n; end let a = fib(n - 1); let b = fib(n - 2); out a + b; end";
    let lex = lexer_new(src);
    lex = tokenize(lex);
    if lex.error_count > 0:
        out vtest_fail(str_new("lex error in regalloc test"));
    end
    let parser = parser_new(lex.tokens);
    let ast = parse_program(parser);
    if ast.error_count > 0:
        out vtest_fail(str_new("parse error in regalloc test"));
    end
    let ctx = lower_ctx_new(str_new("boot_reg"));
    ctx = qir_pipeline_h(ctx, ast);
    if ctx.error_count > 0:
        out vtest_fail(str_new("QIR lowering error"));
    end
    let opt_mod = qir_pipeline_m(ctx.module);
    let final_mod = qir_pipeline_l(opt_mod, 14);
    if vec_len<QFunction>(final_mod.functions) >= 1:
        out vtest_pass();
    end
    out vtest_fail(str_new("regalloc failed on recursive function"));
end

## Optimiser handles nested conditionals
func _test_bootstrap_nested_cond:
    let src = "func classify: in(x:int) if x > 0: if x > 100: out 2; end out 1; eif x == 0: out 0; else out -1; end end";
    let lex = lexer_new(src);
    lex = tokenize(lex);
    if lex.error_count > 0:
        out vtest_fail(str_new("lex error in nested conditional"));
    end
    let parser = parser_new(lex.tokens);
    let ast = parse_program(parser);
    if ast.error_count > 0:
        out vtest_fail(str_new("parse error in nested conditional"));
    end
    let ctx = lower_ctx_new(str_new("boot_cond"));
    ctx = qir_pipeline_h(ctx, ast);
    var (opt_mod, stats) = qir_pipeline_m_stats(ctx.module);
    if vec_len<QFunction>(opt_mod.functions) >= 1:
        out vtest_pass();
    end
    out vtest_fail(str_new("pipeline failed on nested conditionals"));
end

## Verify virc-style multifunction module
func _test_bootstrap_multi_func:
    let src = "func double: in(x:int) out x * 2; end func main: let r = double(21); out r; end";
    let lex = lexer_new(src);
    lex = tokenize(lex);
    let parser = parser_new(lex.tokens);
    let ast = parse_program(parser);
    if ast.error_count > 0:
        out vtest_fail(str_new("parse error on multi-function"));
    end
    let ctx = lower_ctx_new(str_new("boot_multi"));
    ctx = qir_pipeline_h(ctx, ast);
    if vec_len<QFunction>(ctx.module.functions) >= 2:
        out vtest_pass();
    end
    out vtest_fail(str_new("expected at least 2 functions in module"));
end


# ═══════════════════════════════════════════════════════
# Suite Registration & Entry
# ═══════════════════════════════════════════════════════

func bootstrap_vtest_main:
    let reg = vtest_registry_new();

    # Lexer bootstrap tests
    let ts_lex = vtest_suite_new(str_new("bootstrap_lex"));
    vtest_add(ts_lex, str_new("func_decl"),           _test_bootstrap_lex_func_decl);
    vtest_add(ts_lex, str_new("entity"),              _test_bootstrap_lex_entity);
    vtest_add(ts_lex, str_new("includes"),            _test_bootstrap_lex_includes);
    vtest_add(ts_lex, str_new("enum"),                _test_bootstrap_lex_enum);
    vtest_add(ts_lex, str_new("when_loop"),           _test_bootstrap_lex_when_loop);
    vtest_add(ts_lex, str_new("conditional"),         _test_bootstrap_lex_conditional);
    vtest_registry_add_suite(reg, ts_lex);

    # Parser bootstrap tests
    let ts_parse = vtest_suite_new(str_new("bootstrap_parse"));
    vtest_add(ts_parse, str_new("simple_func"),       _test_bootstrap_parse_simple_func);
    vtest_add(ts_parse, str_new("entity"),            _test_bootstrap_parse_entity);
    vtest_add(ts_parse, str_new("let_arith"),         _test_bootstrap_parse_let_arith);
    vtest_registry_add_suite(reg, ts_parse);

    # Full pipeline bootstrap tests
    let ts_pipe = vtest_suite_new(str_new("bootstrap_pipeline"));
    vtest_add(ts_pipe, str_new("loop_pipeline"),      _test_bootstrap_pipeline_loop);
    vtest_add(ts_pipe, str_new("regalloc"),           _test_bootstrap_regalloc);
    vtest_add(ts_pipe, str_new("nested_cond"),        _test_bootstrap_nested_cond);
    vtest_add(ts_pipe, str_new("multi_func"),         _test_bootstrap_multi_func);
    vtest_registry_add_suite(reg, ts_pipe);

    vtest_registry_run(reg);
    vtest_print_summary(reg);
    out vtest_exit_code(reg);
end

export bootstrap_vtest_main;
