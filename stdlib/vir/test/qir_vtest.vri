##
 * vir/test/qir_vtest.vri — VTest suite for Q-IR Schema, Pipeline & Lowering
 * ===========================================================================
 * Port of test_qir_pipeline.py + test_qir_schema.py → pure Vir vtest.
 * Covers:  QOp enum, QOperand/QInstr construction, QFunction/QModule,
 *          QIR-H/M/L pipeline, optimizer pipeline smoke.
 ##

include types;
include string;
import String, str_new, str_eq from string;
include vec;
import Vec, vec_new, vec_push, vec_len, vec_get from vec;
include test;
import TestSuite, TestResult from test;
include vtest;
import VTestRegistry,
       vtest_suite_new, vtest_add,
       vtest_registry_new, vtest_registry_add_suite, vtest_registry_run,
       vtest_print_summary, vtest_exit_code,
       vtest_pass, vtest_fail,
       vtest_expect_true, vtest_expect_false,
       vtest_expect_eq_i64, vtest_expect_ne_i64 from vtest;
include ir_optimizer;
import QOp, QOperand, QInstr, QFunction, QModule, OperandType,
       q_none, q_vreg, q_imm, q_label, q_str_ref, q_func_idx,
       q_instr, q_func_new, q_func_emit,
       qir_pipeline_h, qir_pipeline_m, qir_pipeline_l, qir_pipeline_hml from ir_optimizer;


# ═══════════════════════════════════════════════════════
# Tests — QOperand construction
# ═══════════════════════════════════════════════════════

func _test_operand_none:
    op = q_none();
    out vtest_expect_eq_i64(op.op_type >> int, OperandType::None >> int);
end

func _test_operand_vreg:
    op = q_vreg(7);
    if op.op_type == OperandType::VReg and op.vreg == 7:
        out vtest_pass();
    end
    out vtest_fail();
end

func _test_operand_imm:
    op = q_imm(42);
    if op.op_type == OperandType::Immediate and op.imm_val == 42:
        out vtest_pass();
    end
    out vtest_fail();
end

func _test_operand_label:
    op = q_label(99);
    if op.op_type == OperandType::LabelRef and op.vreg == 99:
        out vtest_pass();
    end
    out vtest_fail();
end

func _test_operand_str_ref:
    op = q_str_ref(5);
    if op.op_type == OperandType::StringRef and op.vreg == 5:
        out vtest_pass();
    end
    out vtest_fail();
end

func _test_operand_func_idx:
    op = q_func_idx(3);
    if op.op_type == OperandType::FuncIdx and op.vreg == 3:
        out vtest_pass();
    end
    out vtest_fail();
end


# ═══════════════════════════════════════════════════════
# Tests — QInstr construction
# ═══════════════════════════════════════════════════════

func _test_instr_nop:
    ins = q_instr(QOp::Nop, q_none(), q_none(), q_none());
    out vtest_expect_eq_i64(ins.opcode >> int, QOp::Nop >> int);
end

func _test_instr_load:
    ins = q_instr(QOp::Load, q_vreg(0), q_imm(10), q_none());
    if ins.opcode == QOp::Load and ins.dest.vreg == 0 and ins.src1.imm_val == 10:
        out vtest_pass();
    end
    out vtest_fail();
end

func _test_instr_add:
    ins = q_instr(QOp::Add, q_vreg(2), q_vreg(0), q_vreg(1));
    if ins.opcode == QOp::Add and ins.dest.vreg == 2 and ins.src1.vreg == 0 and ins.src2.vreg == 1:
        out vtest_pass();
    end
    out vtest_fail();
end


# ═══════════════════════════════════════════════════════
# Tests — QFunction / QModule construction
# ═══════════════════════════════════════════════════════

func _test_func_new_empty:
    f = q_func_new(str_new("test"));
    out vtest_expect_eq_i64(vec_len(f.body), 0);
end

func _test_func_emit:
    f = q_func_new(str_new("adder"));
    f = q_func_emit(f, q_instr(QOp::Load, q_vreg(0), q_imm(10), q_none()));
    f = q_func_emit(f, q_instr(QOp::Load, q_vreg(1), q_imm(20), q_none()));
    f = q_func_emit(f, q_instr(QOp::Add, q_vreg(2), q_vreg(0), q_vreg(1)));
    f = q_func_emit(f, q_instr(QOp::Ret, q_none(), q_vreg(2), q_none()));
    out vtest_expect_eq_i64(vec_len(f.body), 4);
end


# ═══════════════════════════════════════════════════════
# Tests — QOp opcode values (sovereignty range)
# ═══════════════════════════════════════════════════════

func _test_qop_nop_zero:
    out vtest_expect_eq_i64(QOp::Nop >> int, 0);
end

func _test_qop_halt_255:
    out vtest_expect_eq_i64(QOp::Halt >> int, 255);
end

func _test_qop_reflect_ir_247:
    out vtest_expect_eq_i64(QOp::ReflectIR >> int, 247);
end

func _test_qop_bounds_check_248:
    out vtest_expect_eq_i64(QOp::BoundsCheck >> int, 248);
end

func _test_qop_stack_alloc_249:
    out vtest_expect_eq_i64(QOp::StackAlloc >> int, 249);
end


# ═══════════════════════════════════════════════════════
# Suite Builder & Runner
# ═══════════════════════════════════════════════════════

func vtest_qir_suite:
    suite = vtest_suite_new(str_new("qir/schema+pipeline"));

    # operand construction
    suite = vtest_add(suite, str_new("operand none"),         _test_operand_none);
    suite = vtest_add(suite, str_new("operand vreg"),         _test_operand_vreg);
    suite = vtest_add(suite, str_new("operand imm"),          _test_operand_imm);
    suite = vtest_add(suite, str_new("operand label"),        _test_operand_label);
    suite = vtest_add(suite, str_new("operand str_ref"),      _test_operand_str_ref);
    suite = vtest_add(suite, str_new("operand func_idx"),     _test_operand_func_idx);

    # instruction construction
    suite = vtest_add(suite, str_new("instr nop"),            _test_instr_nop);
    suite = vtest_add(suite, str_new("instr load"),           _test_instr_load);
    suite = vtest_add(suite, str_new("instr add"),            _test_instr_add);

    # function/module
    suite = vtest_add(suite, str_new("func new empty"),       _test_func_new_empty);
    suite = vtest_add(suite, str_new("func emit 4 instrs"),   _test_func_emit);

    # opcode values
    suite = vtest_add(suite, str_new("qop Nop=0"),            _test_qop_nop_zero);
    suite = vtest_add(suite, str_new("qop Halt=255"),         _test_qop_halt_255);
    suite = vtest_add(suite, str_new("qop ReflectIR=247"),    _test_qop_reflect_ir_247);
    suite = vtest_add(suite, str_new("qop BoundsCheck=248"),  _test_qop_bounds_check_248);
    suite = vtest_add(suite, str_new("qop StackAlloc=249"),   _test_qop_stack_alloc_249);
    out suite;
end

func vtest_qir_run:
    reg = vtest_registry_new();
    reg = vtest_registry_add_suite(reg, vtest_qir_suite());
    report = vtest_registry_run(reg);
    vtest_print_summary(report);
    out vtest_exit_code(report);
end
