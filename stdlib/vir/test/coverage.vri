##
 * vir/test/coverage.vri — Code Coverage Tracking
 * =================================================
 * Inspired by: gcov, lcov, Istanbul/nyc
 *
 * Line/branch/function coverage counters,
 * coverage report generation, threshold assertions.
 ##

include types;
include vec;
import Vec, vec_new, vec_push, vec_len, vec_get, vec_set from vec;
include map;
import Map, map_new, map_insert, map_get, map_contains from map;
include str;
import StringBuilder, sb_new, sb_append, sb_build, sb_free from str;

# ═══════════════════════════════════════════════════════
# Coverage data
# ═══════════════════════════════════════════════════════

entity FileCoverage:
    path:          string,
        total_lines:   int,
        covered_lines: int,
        line_hits:     Vec;       # Vec<int> hit count per line (0-indexed)
    total_branches:   int,
        covered_branches: int,
        total_funcs:      int,
        covered_funcs:    int;
end
entity CoverageReport:
    files:            Vec;    # Vec<FileCoverage>
    total_lines:      int,
        covered_lines:    int,
        total_branches:   int,
        covered_branches: int,
        total_funcs:      int,
        covered_funcs:    int;
end

# ═══════════════════════════════════════════════════════
# Global coverage tracker
# ═══════════════════════════════════════════════════════

entity CoverageTracker:
    files:   Map;    # Map<string, FileCoverage>
    enabled: bool;
end
func coverage_new:
    in()
    out CoverageTracker ( files: map_new(), enabled: true );
end
func coverage_register_file:
    in(tracker: CoverageTracker; path: string; total_lines: int,
        total_branches: int; total_funcs: int)
    hits = vec_new();
    i = 0;
    when i < total_lines loop
        vec_push(hits, 0);
        i = i + 1;
    end
    fc = FileCoverage (
        path: path, total_lines: total_lines,
        covered_lines: 0, line_hits: hits,
        total_branches: total_branches,
        covered_branches: 0,
        total_funcs: total_funcs, covered_funcs: 0
    );
    map_insert(tracker.files, path, fc);
end
# ═══════════════════════════════════════════════════════
# Hit recording (called by instrumented code)
# ═══════════════════════════════════════════════════════

func coverage_hit_line:
    in(tracker: CoverageTracker; path: string; line: int)
    if tracker.enabled == false do
        out 0;
    end
    fc_opt = map_get(tracker.files, path);
    if is_some(fc_opt) do
        fc = unwrap(fc_opt);
        if line >= 0 && line < vec_len(fc.line_hits) do
            prev = vec_get(fc.line_hits, line);
            vec_set(fc.line_hits, line, prev + 1);
        end
    end
    out 1;
end
func coverage_hit_branch:
    in(tracker: CoverageTracker; path: string; branch_id: int)
    if tracker.enabled == false do
        out 0;
    end
    fc_opt = map_get(tracker.files, path);
    if is_some(fc_opt) do
        fc = unwrap(fc_opt);
        fc.covered_branches = fc.covered_branches + 1;
    end
    out 1;
end
func coverage_hit_func:
    in(tracker: CoverageTracker; path: string; func_name: string)
    if tracker.enabled == false do
        out 0;
    end
    fc_opt = map_get(tracker.files, path);
    if is_some(fc_opt) do
        fc = unwrap(fc_opt);
        fc.covered_funcs = fc.covered_funcs + 1;
    end
    out 1;
end
# ═══════════════════════════════════════════════════════
# Report generation
# ═══════════════════════════════════════════════════════

func _coverage_calc_file:
    in(fc: FileCoverage)
    covered = 0;
    i = 0;
    when i < vec_len(fc.line_hits) loop
        if vec_get(fc.line_hits, i) > 0 do
            covered = covered + 1;
        end
        i = i + 1;
    end
    fc.covered_lines = covered;
end
func coverage_report:
    in(tracker: CoverageTracker; file_paths: Vec)
    report = CoverageReport (
        files: vec_new(),
        total_lines: 0, covered_lines: 0,
        total_branches: 0, covered_branches: 0,
        total_funcs: 0, covered_funcs: 0
    );
    i = 0;
    when i < vec_len(file_paths) loop
        path = vec_get(file_paths, i);
        fc_opt = map_get(tracker.files, path);
        if is_some(fc_opt) do
            fc = unwrap(fc_opt);
            _coverage_calc_file(fc);
            vec_push(report.files, fc);
            report.total_lines = report.total_lines + fc.total_lines;
            report.covered_lines = report.covered_lines + fc.covered_lines;
            report.total_branches = report.total_branches + fc.total_branches;
            report.covered_branches = report.covered_branches + fc.covered_branches;
            report.total_funcs = report.total_funcs + fc.total_funcs;
            report.covered_funcs = report.covered_funcs + fc.covered_funcs;
        end
        i = i + 1;
    end
    out report;
end
# ═══════════════════════════════════════════════════════
# Coverage percentage
# ═══════════════════════════════════════════════════════

func coverage_line_pct:
    in(report: CoverageReport)
    if report.total_lines == 0 do
        out 100;
    end
    out (report.covered_lines * 100) / report.total_lines;
end
func coverage_branch_pct:
    in(report: CoverageReport)
    if report.total_branches == 0 do
        out 100;
    end
    out (report.covered_branches * 100) / report.total_branches;
end
func coverage_func_pct:
    in(report: CoverageReport)
    if report.total_funcs == 0 do
        out 100;
    end
    out (report.covered_funcs * 100) / report.total_funcs;
end
# ═══════════════════════════════════════════════════════
# Threshold assertion
# ═══════════════════════════════════════════════════════

func coverage_assert_min:
    in(report: CoverageReport; min_line_pct: int; min_branch_pct: int)
    line = coverage_line_pct(report);
    branch = coverage_branch_pct(report);
    if line < min_line_pct do
        out "Line coverage " + int_to_str(line) + "% < " + int_to_str(min_line_pct) + "%";
    end
    if branch < min_branch_pct do
        out "Branch coverage " + int_to_str(branch) + "% < " + int_to_str(min_branch_pct) + "%";
    end
    out "OK";
end
# ═══════════════════════════════════════════════════════
# Text report
# ═══════════════════════════════════════════════════════

func coverage_to_text:
    in(report: CoverageReport)
    sb = sb_new();
    sb_append(sb, "Coverage Report\n");
    sb_append(sb, "===============\n");
    i = 0;
    when i < vec_len(report.files) loop
        fc = vec_get(report.files, i);
        pct = 0;
        if fc.total_lines > 0 do
            pct = (fc.covered_lines * 100) / fc.total_lines;
        end
        sb_append(sb, fc.path + ": " +
                  int_to_str(fc.covered_lines) + "/" +
                  int_to_str(fc.total_lines) + " lines (" +
                  int_to_str(pct) + "%)\n");
        i = i + 1;
    end
    sb_append(sb, "---\n");
    sb_append(sb, "Total: " + int_to_str(coverage_line_pct(report)) + "% lines, " +
              int_to_str(coverage_branch_pct(report)) + "% branches, " +
              int_to_str(coverage_func_pct(report)) + "% functions\n");
    out sb_build(sb);
end