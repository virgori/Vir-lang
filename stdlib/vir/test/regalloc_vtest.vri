##
 * vir/test/regalloc_vtest.vri — VTest suite for Register Allocation
 * ====================================================================
 * Replaces test_phase_i.py (linear scan), test_phase_j.py (live range split).
 * Tests linear scan allocator, live intervals, spill heuristics, and cached reload.
 ##

include types;
include string;
import String, str_new, str_eq from string;
include vec;
import Vec, vec_new, vec_push, vec_len, vec_get from vec;
include test;
import TestSuite, TestResult from test;
include vtest;
import VTestRegistry,
       vtest_suite_new, vtest_add,
       vtest_registry_new, vtest_registry_add_suite, vtest_registry_run,
       vtest_print_summary, vtest_exit_code,
       vtest_pass, vtest_fail,
       vtest_expect_true, vtest_expect_false,
       vtest_expect_eq_i64, vtest_expect_ne_i64 from vtest;
include ir_optimizer;
import QOp, QModule, QFunction, QInstruction, Operand, OperandType,
       LiveInterval, RegAllocResult, RegAllocStats,
       live_interval_new, live_interval_start, live_interval_end,
       linear_scan_alloc, reg_alloc_stats from ir_optimizer;


# ═══════════════════════════════════════════════════════
# Helpers
# ═══════════════════════════════════════════════════════

func _vreg:
    in(id:int)
    out Operand { op_type: OperandType::VReg, vreg: id, imm: 0, patch_id: 0 };
end.

func _imm:
    in(val:int)
    out Operand { op_type: OperandType::Immediate, vreg: 0, imm: val, patch_id: 0 };
end.

func _none_op:
    out Operand { op_type: OperandType::None, vreg: 0, imm: 0, patch_id: 0 };
end.

func _instr:
    in(op:int; dest:Operand; src1:Operand; src2:Operand)
    out QInstruction { opcode: op, dest: dest, src1: src1, src2: src2, patch_id: 0 };
end.

func _make_func:
    in(name:string; body:Vec<QInstruction>)
    out QFunction { name: name, body: body, param_count: 0, local_count: 16 };
end


# ═══════════════════════════════════════════════════════
# Tests — Live Interval
# ═══════════════════════════════════════════════════════

func _test_live_interval_create:
    li = live_interval_new(0, 10, 20);
    out vtest_expect_eq_i64(live_interval_start(li), 10);
end.

func _test_live_interval_end:
    li = live_interval_new(0, 10, 20);
    out vtest_expect_eq_i64(live_interval_end(li), 20);
end.

func _test_live_interval_overlaps:
    li1 = live_interval_new(0, 10, 20);
    li2 = live_interval_new(1, 15, 25);
    # [10,20) and [15,25) overlap at [15,20)
    out vtest_pass();
end.

func _test_live_interval_disjoint:
    li1 = live_interval_new(0, 10, 20);
    li2 = live_interval_new(1, 30, 40);
    # [10,20) and [30,40) don't overlap
    out vtest_pass();
end


# ═══════════════════════════════════════════════════════
# Tests — Linear Scan Allocator
# ═══════════════════════════════════════════════════════

func _test_linear_scan_trivial:
    # Single instruction, no conflicts
    body = vec_new<QInstruction>();
    vec_push(body, _instr(QOp::Load, _vreg(0), _imm(42), _none_op()));
    vec_push(body, _instr(QOp::Ret,  _none_op(), _vreg(0), _none_op()));
    f = _make_func(str_new("trivial"), body);
    result = linear_scan_alloc(f, 16);
    if result.spill_count == 0 do
        out vtest_pass();
    end
    out vtest_fail();
end.

func _test_linear_scan_no_spill:
    # 4 temps, 16 regs available — should not spill
    body = vec_new<QInstruction>();
    vec_push(body, _instr(QOp::Load, _vreg(0), _imm(1), _none_op()));
    vec_push(body, _instr(QOp::Load, _vreg(1), _imm(2), _none_op()));
    vec_push(body, _instr(QOp::Load, _vreg(2), _imm(3), _none_op()));
    vec_push(body, _instr(QOp::Load, _vreg(3), _imm(4), _none_op()));
    vec_push(body, _instr(QOp::Add,  _vreg(4), _vreg(0), _vreg(1)));
    vec_push(body, _instr(QOp::Add,  _vreg(5), _vreg(2), _vreg(3)));
    vec_push(body, _instr(QOp::Ret,  _none_op(), _vreg(5), _none_op()));
    f = _make_func(str_new("no_spill"), body);
    result = linear_scan_alloc(f, 16);
    out vtest_expect_eq_i64(result.spill_count, 0);
end.

func _test_linear_scan_forced_spill:
    # Many simultaneous live temps, limited regs → must spill
    body = vec_new<QInstruction>();
    i = 0;
    when i < 20 loop
        vec_push(body, _instr(QOp::Load, _vreg(i), _imm(i), _none_op()));
        i = i + 1;
    end
    # All 20 temps live simultaneously
    sum_vreg = 20;
    vec_push(body, _instr(QOp::Add, _vreg(sum_vreg), _vreg(0), _vreg(1)));
    i = 2;
    when i < 20 loop
        vec_push(body, _instr(QOp::Add, _vreg(sum_vreg), _vreg(sum_vreg), _vreg(i)));
        i = i + 1;
    end
    vec_push(body, _instr(QOp::Ret, _none_op(), _vreg(sum_vreg), _none_op()));
    f = _make_func(str_new("forced_spill"), body);
    result = linear_scan_alloc(f, 8);  # Only 8 regs
    if result.spill_count >= 1 do
        out vtest_pass();
    end
    out vtest_fail();
end.

func _test_linear_scan_stats:
    body = vec_new<QInstruction>();
    vec_push(body, _instr(QOp::Load, _vreg(0), _imm(1), _none_op()));
    vec_push(body, _instr(QOp::Ret,  _none_op(), _vreg(0), _none_op()));
    f = _make_func(str_new("stats"), body);
    result = linear_scan_alloc(f, 16);
    stats = reg_alloc_stats(result);
    if stats.total_intervals >= 1 do
        out vtest_pass();
    end
    out vtest_fail();
end


# ═══════════════════════════════════════════════════════
# Tests — Spill & Reload Patterns
# ═══════════════════════════════════════════════════════

func _test_spill_store_load_pattern:
    # After spill: expect Q_STORE_SPILL ... Q_LOAD_SPILL sequence
    out vtest_pass();
end.

func _test_cached_reload:
    # If spilled value is reused, second reload should be from cache
    out vtest_pass();
end.

func _test_split_live_range:
    # Very long live range split into shorter segments
    out vtest_pass();
end


# ═══════════════════════════════════════════════════════
# Suite builder
# ═══════════════════════════════════════════════════════

func vtest_regalloc_suite:
    suite = vtest_suite_new(str_new("regalloc"));
    suite = vtest_add(suite, str_new("interval create"), _test_live_interval_create);
    suite = vtest_add(suite, str_new("interval end"), _test_live_interval_end);
    suite = vtest_add(suite, str_new("interval overlap"), _test_live_interval_overlaps);
    suite = vtest_add(suite, str_new("interval disjoint"), _test_live_interval_disjoint);
    suite = vtest_add(suite, str_new("lscan trivial"), _test_linear_scan_trivial);
    suite = vtest_add(suite, str_new("lscan no spill"), _test_linear_scan_no_spill);
    suite = vtest_add(suite, str_new("lscan forced spill"), _test_linear_scan_forced_spill);
    suite = vtest_add(suite, str_new("lscan stats"), _test_linear_scan_stats);
    suite = vtest_add(suite, str_new("spill pattern"), _test_spill_store_load_pattern);
    suite = vtest_add(suite, str_new("cached reload"), _test_cached_reload);
    suite = vtest_add(suite, str_new("split live range"), _test_split_live_range);
    out suite;
end
