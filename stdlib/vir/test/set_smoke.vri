include types
include option
import Some, None from option
include set
import set_int, set_insert, set_contains, set_len from set

func main:
    s = set_int()
    if set_insert(s, 42) == false do out 1 end
    if set_insert(s, 42) == true do out 2 end
    if set_contains(s, 42) == false do out 3 end
    if set_len(s) != 1 do out 4 end
    out 0
end.
