##
 * vir/test/vtest.vri — Standardized Vir Test Runner Facade
 * ========================================================
 * Unifies the current Vir test APIs behind a stable surface
 * so compiler / stdlib code can migrate away from pytest.
 *
 * Scope in this stage
 *   - stable suite/report API
 *   - sequential execution as the reference path
 *   - exit-code helper for CLI integration
 *
 * Parallel scheduling remains available in parallel.vri but is
 * not yet the default execution backend here.
 ##

include types;
include string;
import String, str_new, str_concat from string;
include format;
import format_int from format;
include vec;
import Vec, vec_new, vec_push, vec_len, vec_get from vec;
include stdio;
import println, eprintln from stdio;
include test;
import TestCase, TestSuite, TestReport, TestResult,
       suite_new, suite_add, suite_run, run_all_suites,
       report_ok, pass, fail, skip,
       expect_true, expect_false,
       expect_eq_i64, expect_eq_str, expect_ne_i64 from test;


# ═══════════════════════════════════════════════════════
# Stable facade aliases
# ═══════════════════════════════════════════════════════

func vtest_suite_new:
    in(name:string)
    out suite_new(name);
end.

func vtest_add:
    in(s:TestSuite; name:string; func:func())
    suite_add(s, name, func);
    out s;
end.

func vtest_run_suite:
    in(s:TestSuite)
    out suite_run(s);
end.

func vtest_run_all:
    in(suites:Vec<TestSuite>)
    out run_all_suites(suites);
end.

func vtest_exit_code:
    in(r:TestReport)
    if report_ok(r) do
        out 0;
    end
    out 1;
end.

func vtest_print_summary:
    in(r:TestReport)
    if report_ok(r) do
        println(str_concat(str_new("vtest: PASS "), format_int(r.passed, 10)));
    else
        eprintln(str_concat(str_new("vtest: FAIL "), format_int(r.failed + r.errors, 10)));
    end
end


# ═══════════════════════════════════════════════════════
# Simple registry helper for tool-driven test assembly
# ═══════════════════════════════════════════════════════

entity VTestRegistry:
    suites: Vec<TestSuite>;
end.

func vtest_registry_new:
    out VTestRegistry { suites: vec_new<TestSuite>() };
end.

func vtest_registry_add_suite:
    in(reg:VTestRegistry; suite:TestSuite)
    vec_push(reg.suites, suite);
    out reg;
end.

func vtest_registry_run:
    in(reg:VTestRegistry)
    out vtest_run_all(reg.suites);
end


# ═══════════════════════════════════════════════════════
# Re-export core expectations through the standardized facade
# ═══════════════════════════════════════════════════════

func vtest_pass:
    out pass();
end.

func vtest_fail:
    out fail();
end.

func vtest_skip:
    out skip();
end.

func vtest_expect_true:
    in(cond:bool)
    out expect_true(cond);
end.

func vtest_expect_false:
    in(cond:bool)
    out expect_false(cond);
end.

func vtest_expect_eq_i64:
    in(a:int; b:int)
    out expect_eq_i64(a, b);
end.

func vtest_expect_eq_str:
    in(a:string; b:string)
    out expect_eq_str(a, b);
end.

func vtest_expect_ne_i64:
    in(a:int; b:int)
    out expect_ne_i64(a, b);
end
