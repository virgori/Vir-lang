##
 * vir/test/snapshot.vri — Snapshot Testing
 * ==========================================
 * Inspired by: Jest snapshots, insta (Rust)
 *
 * Capture output as "snapshots", compare with saved versions,
 * update mode, diff generation.
 ##

include types;
include option;
import Option, Some, None from option;
include vec;
import Vec, vec_new, vec_push, vec_len, vec_get from vec;
include str;
import StringBuilder, sb_new, sb_append, sb_build, sb_free from str;
include map;
import Map, map_new, map_insert, map_get, map_contains from map;

# ═══════════════════════════════════════════════════════
# Snapshot store
# ═══════════════════════════════════════════════════════

entity Snapshot:
    name:     string,
        content:  string;
end
entity SnapshotStore:
    snapshots:   Map;       # Map<string, string> name → content
    update_mode: bool;      # if true, overwrite existing
    failures:    Vec;       # Vec<string> failure messages
    new_count:   int,
        update_count: int,
        pass_count:  int;
end
func snapshot_store_new:
    in(update_mode: bool)
    out SnapshotStore (
        snapshots: map_new(), update_mode: update_mode,
        failures: vec_new(), new_count: 0,
        update_count: 0, pass_count: 0
    );
end
# ═══════════════════════════════════════════════════════
# Load existing snapshots (from serialized format)
# ═══════════════════════════════════════════════════════

func snapshot_load:
    in(store: SnapshotStore; name: string; content: string)
    map_insert(store.snapshots, name, content);
end
# ═══════════════════════════════════════════════════════
# Assert snapshot matches
# ═══════════════════════════════════════════════════════

func snapshot_assert:
    in(store: SnapshotStore; name: string; actual: string)
    existing = map_get(store.snapshots, name);
    if is_none(existing) do
        # New snapshot
        map_insert(store.snapshots, name, actual);
        store.new_count = store.new_count + 1;
        out true;
    end
    expected = unwrap(existing);
    if expected == actual do
        store.pass_count = store.pass_count + 1;
        out true;
    end
    # Mismatch
    if store.update_mode do
        map_insert(store.snapshots, name, actual);
        store.update_count = store.update_count + 1;
        out true;
    end
    diff = snapshot_diff(expected, actual);
    msg = "Snapshot '" + name + "' mismatch:\n" + diff;
    vec_push(store.failures, msg);
    out false;
end
# ═══════════════════════════════════════════════════════
# Simple line-by-line diff
# ═══════════════════════════════════════════════════════

func _split_lines:
    in(s: string)
    lines = vec_new();
    start = 0;
    i = 0;
    n = str_len(s);
    when i < n loop
        if str_byte_at(s, i) == 10 do
            vec_push(lines, str_slice(s, start, i));
            start = i + 1;
        end
        i = i + 1;
    end
    if start <= n do
        vec_push(lines, str_slice(s, start, n));
    end
    out lines;
end
func snapshot_diff:
    in(expected: string; actual: string)
    exp_lines = _split_lines(expected);
    act_lines = _split_lines(actual);
    sb = sb_new();
    max_lines = vec_len(exp_lines);
    if vec_len(act_lines) > max_lines do
        max_lines = vec_len(act_lines);
    end
    i = 0;
    when i < max_lines loop
        exp_line = "";
        act_line = "";
        if i < vec_len(exp_lines) do
            exp_line = vec_get(exp_lines, i);
        end
        if i < vec_len(act_lines) do
            act_line = vec_get(act_lines, i);
        end
        if exp_line != act_line do
            if i < vec_len(exp_lines) do
                sb_append(sb, "- " + exp_line + "\n");
            end
            if i < vec_len(act_lines) do
                sb_append(sb, "+ " + act_line + "\n");
            end
        end
        i = i + 1;
    end
    out sb_build(sb);
end
# ═══════════════════════════════════════════════════════
# Serialize store to string format
# ═══════════════════════════════════════════════════════

func snapshot_serialize:
    in(store: SnapshotStore; names: Vec)
    sb = sb_new();
    i = 0;
    when i < vec_len(names) loop
        name = vec_get(names, i);
        content = map_get(store.snapshots, name);
        if is_some(content) do
            sb_append(sb, "--- " + name + " ---\n");
            sb_append(sb, unwrap(content));
            sb_append(sb, "\n--- end ---\n");
        end
        i = i + 1;
    end
    out sb_build(sb);
end
# ═══════════════════════════════════════════════════════
# Summary
# ═══════════════════════════════════════════════════════

func snapshot_summary:
    in(store: SnapshotStore)
    sb = sb_new();
    sb_append(sb, "Snapshots: ");
    sb_append(sb, int_to_str(store.pass_count) + " passed");
    if store.new_count > 0 do
        sb_append(sb, ", " + int_to_str(store.new_count) + " new");
    end
    if store.update_count > 0 do
        sb_append(sb, ", " + int_to_str(store.update_count) + " updated");
    end
    if vec_len(store.failures) > 0 do
        sb_append(sb, ", " + int_to_str(vec_len(store.failures)) + " failed");
    end
    out sb_build(sb);
end