##
 * vir/test/simd_jit_vtest.vri — VTest for SIMD Intrinsics + JIT Bridge
 * =======================================================================
 * Validates that the Vir-native SIMD layer (hw/simd) and the new Vir-native
 * JIT bridge (jit/bridge) are functional at the stdlib level.
 ##

include types;
include string;
import String, str_new, str_eq from string;
include test;
import TestSuite, TestResult from test;
include vtest;
import VTestRegistry,
       vtest_suite_new, vtest_add,
       vtest_registry_new, vtest_registry_add_suite, vtest_registry_run,
       vtest_print_summary, vtest_exit_code,
       vtest_pass, vtest_fail,
       vtest_expect_true, vtest_expect_false,
       vtest_expect_eq_i64, vtest_expect_ne_i64 from vtest;
include hw/simd;
import F32x4, F64x2, I32x4,
       f32x4, f32x4_splat, f32x4_add, f32x4_sub, f32x4_mul, f32x4_div,
       f32x4_fma, f32x4_hsum, f32x4_hmax,
       f64x2, f64x2_splat, f64x2_add, f64x2_sub, f64x2_mul, f64x2_hsum,
       simd_vec_add, simd_dot, simd_saxpy,
       simd_detect, simd_f32_lanes, simd_f64_lanes,
       SIMD_NONE, SIMD_NEON, SIMD_SSE42, SIMD_AVX2 from hw/simd;
include hw/cpu;
import cpu_arch, ARCH_X86_64, ARCH_AARCH64 from hw/cpu;
include jit/bridge;
import JitBridge, JitCallback, JitBlock,
       jit_bridge_new, jit_bridge_free,
       jit_register_callback, jit_lookup_callback,
       jit_block_count, jit_callback_count, jit_region_used from jit/bridge;
include compiler/ir_optimizer;
import QOp from compiler/ir_optimizer;


# ═══════════════════════════════════════════════════════
# SIMD — Cross-lane / composite ops
# ═══════════════════════════════════════════════════════

func _test_f32x4_sub:
    a = f32x4(10.0, 20.0, 30.0, 40.0);
    b = f32x4(1.0, 2.0, 3.0, 4.0);
    c = f32x4_sub(a, b);
    if c.v0 == 9.0 and c.v1 == 18.0 and c.v2 == 27.0 and c.v3 == 36.0:
        out vtest_pass();
    end
    out vtest_fail();
end

func _test_f32x4_div:
    a = f32x4(12.0, 24.0, 36.0, 48.0);
    b = f32x4_splat(6.0);
    c = f32x4_div(a, b);
    if c.v0 == 2.0 and c.v1 == 4.0 and c.v2 == 6.0 and c.v3 == 8.0:
        out vtest_pass();
    end
    out vtest_fail();
end

func _test_f32x4_fma:
    a = f32x4(2.0, 3.0, 4.0, 5.0);
    b = f32x4(10.0, 10.0, 10.0, 10.0);
    c = f32x4(1.0, 1.0, 1.0, 1.0);      # acc
    r = f32x4_fma(a, b, c);              # a*b + c
    if r.v0 == 21.0 and r.v1 == 31.0 and r.v2 == 41.0 and r.v3 == 51.0:
        out vtest_pass();
    end
    out vtest_fail();
end

func _test_f32x4_hmax:
    a = f32x4(3.0, 7.0, 1.0, 5.0);
    m = f32x4_hmax(a);
    if m == 7.0:
        out vtest_pass();
    end
    out vtest_fail();
end

func _test_f64x2_add:
    a = f64x2(1.0, 2.0);
    b = f64x2(10.0, 20.0);
    c = f64x2_add(a, b);
    if c.v0 == 11.0 and c.v1 == 22.0:
        out vtest_pass();
    end
    out vtest_fail();
end

func _test_f64x2_hsum:
    a = f64x2(3.5, 4.5);
    s = f64x2_hsum(a);
    if s == 8.0:
        out vtest_pass();
    end
    out vtest_fail();
end

func _test_simd_dot:
    # dot(a,b) for 4-element vectors
    a = f32x4(1.0, 2.0, 3.0, 4.0);
    b = f32x4(1.0, 1.0, 1.0, 1.0);
    d = simd_dot(a, b);                  # 1+2+3+4 = 10
    if d == 10.0:
        out vtest_pass();
    end
    out vtest_fail();
end

func _test_simd_f32_lanes_arch:
    lanes = simd_f32_lanes();
    arch = cpu_arch();
    if arch == ARCH_AARCH64:
        # NEON → 4 lanes
        if lanes >= 4: out vtest_pass(); end
    end
    if arch == ARCH_X86_64:
        # At minimum SSE → 4 lanes; AVX → 8 lanes
        if lanes >= 4: out vtest_pass(); end
    end
    # unknown arch → at least scalar
    if lanes >= 1: out vtest_pass(); end
    out vtest_fail();
end


# ═══════════════════════════════════════════════════════
# SIMD — QOp vector opcode values (match C header)
# ═══════════════════════════════════════════════════════

func _test_qop_vload_176:
    out vtest_expect_eq_i64(QOp.VLoad, 176);
end

func _test_qop_vadd_178:
    out vtest_expect_eq_i64(QOp.VAdd, 178);
end

func _test_qop_vfma_181:
    out vtest_expect_eq_i64(QOp.VFma, 181);
end

func _test_qop_vreduce_185:
    out vtest_expect_eq_i64(QOp.VReduce, 185);
end

func _test_qop_vsplat_186:
    out vtest_expect_eq_i64(QOp.VSplat, 186);
end


# ═══════════════════════════════════════════════════════
# JIT Bridge — construction + callback registration
# ═══════════════════════════════════════════════════════

func _test_jit_bridge_new:
    jb = jit_bridge_new(0);            # default 1 MB
    if jit_block_count(jb) == 0 and jit_callback_count(jb) == 0:
        jit_bridge_free(jb);
        out vtest_pass();
    end
    jit_bridge_free(jb);
    out vtest_fail();
end

func _test_jit_bridge_region_used_zero:
    jb = jit_bridge_new(4096);
    if jit_region_used(jb) == 0:
        jit_bridge_free(jb);
        out vtest_pass();
    end
    jit_bridge_free(jb);
    out vtest_fail();
end

func _test_jit_register_callback:
    jb = jit_bridge_new(4096);
    res = jit_register_callback(jb, str_new("test_fn"), ptr_null(), 0);
    if res.is_ok and jit_callback_count(jb) == 1:
        jit_bridge_free(jb);
        out vtest_pass();
    end
    jit_bridge_free(jb);
    out vtest_fail();
end

func _test_jit_lookup_callback:
    jb = jit_bridge_new(4096);
    jit_register_callback(jb, str_new("my_cb"), ptr_null(), 2);
    res = jit_lookup_callback(jb, str_new("my_cb"));
    if res.is_ok:
        jit_bridge_free(jb);
        out vtest_pass();
    end
    jit_bridge_free(jb);
    out vtest_fail();
end

func _test_jit_lookup_missing:
    jb = jit_bridge_new(4096);
    res = jit_lookup_callback(jb, str_new("nonexistent"));
    if res.is_err:
        jit_bridge_free(jb);
        out vtest_pass();
    end
    jit_bridge_free(jb);
    out vtest_fail();
end


# ═══════════════════════════════════════════════════════
# Suite Builder & Runner
# ═══════════════════════════════════════════════════════

func vtest_simd_jit_suite:
    suite = vtest_suite_new(str_new("simd+jit_bridge"));

    # SIMD ops
    suite = vtest_add(suite, str_new("f32x4 sub"),                 _test_f32x4_sub);
    suite = vtest_add(suite, str_new("f32x4 div"),                 _test_f32x4_div);
    suite = vtest_add(suite, str_new("f32x4 fma"),                 _test_f32x4_fma);
    suite = vtest_add(suite, str_new("f32x4 hmax"),                _test_f32x4_hmax);
    suite = vtest_add(suite, str_new("f64x2 add"),                 _test_f64x2_add);
    suite = vtest_add(suite, str_new("f64x2 hsum"),                _test_f64x2_hsum);
    suite = vtest_add(suite, str_new("simd dot product"),          _test_simd_dot);
    suite = vtest_add(suite, str_new("simd lanes arch-aware"),     _test_simd_f32_lanes_arch);

    # QOp vector enum values
    suite = vtest_add(suite, str_new("QOp.VLoad = 176"),           _test_qop_vload_176);
    suite = vtest_add(suite, str_new("QOp.VAdd = 178"),            _test_qop_vadd_178);
    suite = vtest_add(suite, str_new("QOp.VFma = 181"),            _test_qop_vfma_181);
    suite = vtest_add(suite, str_new("QOp.VReduce = 185"),         _test_qop_vreduce_185);
    suite = vtest_add(suite, str_new("QOp.VSplat = 186"),          _test_qop_vsplat_186);

    # JIT bridge
    suite = vtest_add(suite, str_new("jit_bridge_new"),            _test_jit_bridge_new);
    suite = vtest_add(suite, str_new("jit region used = 0"),       _test_jit_bridge_region_used_zero);
    suite = vtest_add(suite, str_new("jit register callback"),     _test_jit_register_callback);
    suite = vtest_add(suite, str_new("jit lookup callback"),       _test_jit_lookup_callback);
    suite = vtest_add(suite, str_new("jit lookup missing → err"),  _test_jit_lookup_missing);
    out suite;
end

func vtest_simd_jit_run:
    reg = vtest_registry_new();
    reg = vtest_registry_add_suite(reg, vtest_simd_jit_suite());
    report = vtest_registry_run(reg);
    vtest_print_summary(report);
    out vtest_exit_code(report);
end
