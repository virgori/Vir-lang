##
 * vir/test/platform_vtest.vri — VTest suite for Hardware & Platform Detection
 * =============================================================================
 * Port of test_virplat.py → pure Vir vtest.
 * Covers:  CPU detection, SIMD capability, platform OS/arch queries.
 ##

include types;
include string;
import String, str_new, str_eq from string;
include test;
import TestSuite, TestResult from test;
include vtest;
import VTestRegistry,
       vtest_suite_new, vtest_add,
       vtest_registry_new, vtest_registry_add_suite, vtest_registry_run,
       vtest_print_summary, vtest_exit_code,
       vtest_pass, vtest_fail,
       vtest_expect_true, vtest_expect_false,
       vtest_expect_eq_i64, vtest_expect_ne_i64 from vtest;
include hw/platform;
import PlatformInfo, platform_info, platform_os,
       OS_UNKNOWN, OS_LINUX, OS_MACOS, OS_WINDOWS,
       platform_total_mem, platform_avail_mem, platform_page_size,
       platform_is_64bit from hw/platform;
include hw/cpu;
import CpuInfo, cpu_info, cpu_arch, cpu_cores, cpu_threads,
       cpu_cache_line_size, cpu_has_neon, cpu_has_avx2,
       cpu_best_simd, cpu_tile_size,
       ARCH_X86_64, ARCH_AARCH64 from hw/cpu;
include hw/simd;
import F32x4, f32x4, f32x4_splat, f32x4_add, f32x4_mul, f32x4_hsum,
       simd_detect, simd_f32_lanes,
       SIMD_NONE, SIMD_NEON, SIMD_SSE42, SIMD_AVX2 from hw/simd;


# ═══════════════════════════════════════════════════════
# Tests — Platform Detection
# ═══════════════════════════════════════════════════════

func _test_platform_os_valid:
    os = platform_os();
    # Should be one of the known constants
    if os == OS_LINUX or os == OS_MACOS or os == OS_WINDOWS or os == OS_UNKNOWN:
        out vtest_pass();
    end
    out vtest_fail();
end

func _test_platform_info_struct:
    info = platform_info();
    # page_size should be 4096 or 16384 (arm64 macOS)
    if info.page_size >= 4096:
        out vtest_pass();
    end
    out vtest_fail();
end

func _test_platform_total_mem_positive:
    mem = platform_total_mem();
    if mem > 0:
        out vtest_pass();
    end
    out vtest_fail();
end

func _test_platform_is_64bit:
    out vtest_expect_true(platform_is_64bit());
end


# ═══════════════════════════════════════════════════════
# Tests — CPU Detection
# ═══════════════════════════════════════════════════════

func _test_cpu_arch_known:
    arch = cpu_arch();
    if arch == ARCH_X86_64 or arch == ARCH_AARCH64:
        out vtest_pass();
    end
    out vtest_fail();
end

func _test_cpu_cores_positive:
    cores = cpu_cores();
    if cores >= 1:
        out vtest_pass();
    end
    out vtest_fail();
end

func _test_cpu_threads_ge_cores:
    cores = cpu_cores();
    threads = cpu_threads();
    if threads >= cores:
        out vtest_pass();
    end
    out vtest_fail();
end

func _test_cpu_cache_line_size:
    cls = cpu_cache_line_size();
    if cls >= 32 and cls <= 256:
        out vtest_pass();
    end
    out vtest_fail();
end

func _test_cpu_tile_size_positive:
    ts = cpu_tile_size();
    if ts > 0:
        out vtest_pass();
    end
    out vtest_fail();
end


# ═══════════════════════════════════════════════════════
# Tests — SIMD Detection & Intrinsics
# ═══════════════════════════════════════════════════════

func _test_simd_detect_valid:
    level = simd_detect();
    if level == SIMD_NONE or level == SIMD_NEON or level == SIMD_SSE42 or level == SIMD_AVX2:
        out vtest_pass();
    end
    out vtest_fail();
end

func _test_simd_f32_lanes_ge1:
    lanes = simd_f32_lanes();
    if lanes >= 1:
        out vtest_pass();
    end
    out vtest_fail();
end

func _test_f32x4_splat:
    v = f32x4_splat(3.0);
    if v.v0 == 3.0 and v.v1 == 3.0 and v.v2 == 3.0 and v.v3 == 3.0:
        out vtest_pass();
    end
    out vtest_fail();
end

func _test_f32x4_add:
    a = f32x4(1.0, 2.0, 3.0, 4.0);
    b = f32x4(10.0, 20.0, 30.0, 40.0);
    c = f32x4_add(a, b);
    if c.v0 == 11.0 and c.v1 == 22.0 and c.v2 == 33.0 and c.v3 == 44.0:
        out vtest_pass();
    end
    out vtest_fail();
end

func _test_f32x4_mul:
    a = f32x4(2.0, 3.0, 4.0, 5.0);
    b = f32x4(10.0, 10.0, 10.0, 10.0);
    c = f32x4_mul(a, b);
    if c.v0 == 20.0 and c.v1 == 30.0 and c.v2 == 40.0 and c.v3 == 50.0:
        out vtest_pass();
    end
    out vtest_fail();
end

func _test_f32x4_hsum:
    a = f32x4(1.0, 2.0, 3.0, 4.0);
    s = f32x4_hsum(a);
    if s == 10.0:
        out vtest_pass();
    end
    out vtest_fail();
end


# ═══════════════════════════════════════════════════════
# Suite Builder & Runner
# ═══════════════════════════════════════════════════════

func vtest_platform_suite:
    suite = vtest_suite_new(str_new("hw/platform+cpu+simd"));

    # platform
    suite = vtest_add(suite, str_new("platform OS valid"),         _test_platform_os_valid);
    suite = vtest_add(suite, str_new("platform info page≥4K"),     _test_platform_info_struct);
    suite = vtest_add(suite, str_new("platform total mem > 0"),    _test_platform_total_mem_positive);
    suite = vtest_add(suite, str_new("platform is 64-bit"),        _test_platform_is_64bit);

    # CPU
    suite = vtest_add(suite, str_new("cpu arch x86/arm"),          _test_cpu_arch_known);
    suite = vtest_add(suite, str_new("cpu cores ≥ 1"),             _test_cpu_cores_positive);
    suite = vtest_add(suite, str_new("cpu threads ≥ cores"),       _test_cpu_threads_ge_cores);
    suite = vtest_add(suite, str_new("cpu cache line 32-256"),     _test_cpu_cache_line_size);
    suite = vtest_add(suite, str_new("cpu tile size > 0"),         _test_cpu_tile_size_positive);

    # SIMD
    suite = vtest_add(suite, str_new("simd detect valid level"),   _test_simd_detect_valid);
    suite = vtest_add(suite, str_new("simd f32 lanes ≥ 1"),        _test_simd_f32_lanes_ge1);
    suite = vtest_add(suite, str_new("f32x4 splat(3)"),            _test_f32x4_splat);
    suite = vtest_add(suite, str_new("f32x4 add"),                 _test_f32x4_add);
    suite = vtest_add(suite, str_new("f32x4 mul"),                 _test_f32x4_mul);
    suite = vtest_add(suite, str_new("f32x4 hsum"),                _test_f32x4_hsum);
    out suite;
end

func vtest_platform_run:
    reg = vtest_registry_new();
    reg = vtest_registry_add_suite(reg, vtest_platform_suite());
    report = vtest_registry_run(reg);
    vtest_print_summary(report);
    out vtest_exit_code(report);
end
