##
 * vir/test/mem_vtest.vri — VTest suite for Memory Management
 * =============================================================
 * Replaces test_virmem.py. Tests arena allocator, buffer, slice, copy,
 * and RC/pool from mem_manager integration.
 ##

include types;
include string;
import String, str_new, str_eq from string;
include vec;
import Vec, vec_new, vec_push, vec_len, vec_get from vec;
include test;
import TestSuite, TestResult from test;
include vtest;
import VTestRegistry,
       vtest_suite_new, vtest_add,
       vtest_registry_new, vtest_registry_add_suite, vtest_registry_run,
       vtest_print_summary, vtest_exit_code,
       vtest_pass, vtest_fail,
       vtest_expect_true, vtest_expect_false,
       vtest_expect_eq_i64, vtest_expect_ne_i64 from vtest;
include mem/arena;
import Arena, arena_new, arena_alloc, arena_reset, arena_used from mem/arena;
include mem/buffer;
import Buffer, buffer_new, buffer_write_byte, buffer_len, buffer_get from mem/buffer;
include mem/slice;
import Slice, slice_new, slice_len, slice_get, slice_set from mem/slice;


# ═══════════════════════════════════════════════════════
# Tests — Arena Allocator
# ═══════════════════════════════════════════════════════

func _test_arena_new:
    a = arena_new(4096);
    out vtest_expect_eq_i64(arena_used(a), 0);
end.

func _test_arena_alloc:
    a = arena_new(4096);
    ptr = arena_alloc(a, 64);
    if arena_used(a) >= 64 do
        out vtest_pass();
    end
    out vtest_fail();
end.

func _test_arena_multiple_alloc:
    a = arena_new(4096);
    arena_alloc(a, 100);
    arena_alloc(a, 200);
    arena_alloc(a, 300);
    if arena_used(a) >= 600 do
        out vtest_pass();
    end
    out vtest_fail();
end.

func _test_arena_reset:
    a = arena_new(4096);
    arena_alloc(a, 1024);
    arena_reset(a);
    out vtest_expect_eq_i64(arena_used(a), 0);
end.

func _test_arena_large_alloc:
    a = arena_new(8192);
    arena_alloc(a, 4096);
    if arena_used(a) >= 4096 do
        out vtest_pass();
    end
    out vtest_fail();
end


# ═══════════════════════════════════════════════════════
# Tests — Buffer
# ═══════════════════════════════════════════════════════

func _test_buffer_new:
    b = buffer_new(256);
    out vtest_expect_eq_i64(buffer_len(b), 0);
end.

func _test_buffer_write_byte:
    b = buffer_new(256);
    buffer_write_byte(b, 0x41);
    out vtest_expect_eq_i64(buffer_len(b), 1);
end.

func _test_buffer_write_multiple:
    b = buffer_new(256);
    buffer_write_byte(b, 0x41);
    buffer_write_byte(b, 0x42);
    buffer_write_byte(b, 0x43);
    out vtest_expect_eq_i64(buffer_len(b), 3);
end.

func _test_buffer_get:
    b = buffer_new(256);
    buffer_write_byte(b, 0x48);
    buffer_write_byte(b, 0x69);
    out vtest_expect_eq_i64(buffer_get(b, 0), 0x48);
end


# ═══════════════════════════════════════════════════════
# Tests — Slice
# ═══════════════════════════════════════════════════════

func _test_slice_new:
    s = slice_new(10);
    out vtest_expect_eq_i64(slice_len(s), 10);
end.

func _test_slice_set_get:
    s = slice_new(5);
    slice_set(s, 0, 42);
    slice_set(s, 4, 99);
    if slice_get(s, 0) == 42 and slice_get(s, 4) == 99 do
        out vtest_pass();
    end
    out vtest_fail();
end.

func _test_slice_bounds:
    s = slice_new(3);
    slice_set(s, 0, 10);
    slice_set(s, 1, 20);
    slice_set(s, 2, 30);
    sum = slice_get(s, 0) + slice_get(s, 1) + slice_get(s, 2);
    out vtest_expect_eq_i64(sum, 60);
end


# ═══════════════════════════════════════════════════════
# Suite builder
# ═══════════════════════════════════════════════════════

func vtest_mem_suite:
    suite = vtest_suite_new(str_new("memory"));
    suite = vtest_add(suite, str_new("arena new"), _test_arena_new);
    suite = vtest_add(suite, str_new("arena alloc"), _test_arena_alloc);
    suite = vtest_add(suite, str_new("arena multi"), _test_arena_multiple_alloc);
    suite = vtest_add(suite, str_new("arena reset"), _test_arena_reset);
    suite = vtest_add(suite, str_new("arena large"), _test_arena_large_alloc);
    suite = vtest_add(suite, str_new("buffer new"), _test_buffer_new);
    suite = vtest_add(suite, str_new("buffer write"), _test_buffer_write_byte);
    suite = vtest_add(suite, str_new("buffer multi"), _test_buffer_write_multiple);
    suite = vtest_add(suite, str_new("buffer get"), _test_buffer_get);
    suite = vtest_add(suite, str_new("slice new"), _test_slice_new);
    suite = vtest_add(suite, str_new("slice set get"), _test_slice_set_get);
    suite = vtest_add(suite, str_new("slice bounds"), _test_slice_bounds);
    out suite;
end
