##
 * vir/test/fixtures.vri — Test Fixtures Framework
 * ==================================================
 * Inspired by: pytest fixtures, JUnit @Before/@After
 *
 * Setup/teardown lifecycle, fixture scopes (test/module/session),
 * fixture registry, dependency injection.
 ##

include types;
include option;
import Option, Some, None from option;
include vec;
import Vec, vec_new, vec_push, vec_len, vec_get from vec;
include map;
import Map, map_new, map_insert, map_get from map;

# ═══════════════════════════════════════════════════════
# Fixture scopes
# ═══════════════════════════════════════════════════════

const FIXTURE_TEST    = 1;    # re-created per test
const FIXTURE_MODULE  = 2;    # created once per module
const FIXTURE_SESSION = 3;    # created once per session

# ═══════════════════════════════════════════════════════
# Entities
# ═══════════════════════════════════════════════════════

entity Fixture:
    name:      string,
        scope:     int,
        value:     string;       # serialized fixture value
    setup_fn:  string;       # name of setup function
    teardown_fn: string;     # name of teardown function
    is_setup:  bool;
end
entity FixtureRegistry:
    fixtures: Map;           # Map<string, Fixture>
    order:    Vec;           # Vec<string> registration order
end
entity TestContext:
    fixtures:  FixtureRegistry,
        active:    Vec;          # Vec<string> currently setup fixtures
    values:    Map;          # Map<string, string> cached values
end

# ═══════════════════════════════════════════════════════
# Registry
# ═══════════════════════════════════════════════════════

func fixture_registry_new:
    in()
    out FixtureRegistry ( fixtures: map_new(), order: vec_new() );
end
func fixture_register:
    in(reg: FixtureRegistry; name: string; scope: int,
        setup_fn: string; teardown_fn: string)
    f = Fixture (
        name: name, scope: scope, value: "",
        setup_fn: setup_fn, teardown_fn: teardown_fn,
        is_setup: false
    );
    map_insert(reg.fixtures, name, f);
    vec_push(reg.order, name);
end
# ═══════════════════════════════════════════════════════
# Test context
# ═══════════════════════════════════════════════════════

func test_context_new:
    in(reg: FixtureRegistry)
    out TestContext (
        fixtures: reg, active: vec_new(),
        values: map_new()
    );
end
func fixture_setup:
    in(ctx: TestContext; name: string; value: string)
    f_opt = map_get(ctx.fixtures.fixtures, name);
    if is_some(f_opt) do
        f = unwrap(f_opt);
        f.is_setup = true;
        f.value = value;
        map_insert(ctx.values, name, value);
        vec_push(ctx.active, name);
    end
end
func fixture_get:
    in(ctx: TestContext; name: string)
    out map_get(ctx.values, name);
end
func fixture_teardown:
    in(ctx: TestContext; name: string)
    f_opt = map_get(ctx.fixtures.fixtures, name);
    if is_some(f_opt) do
        f = unwrap(f_opt);
        f.is_setup = false;
        f.value = "";
    end
end
# ═══════════════════════════════════════════════════════
# Lifecycle management
# ═══════════════════════════════════════════════════════

func fixture_setup_all:
    in(ctx: TestContext; scope: int)
    i = 0;
    when i < vec_len(ctx.fixtures.order) loop
        name = vec_get(ctx.fixtures.order, i);
        f_opt = map_get(ctx.fixtures.fixtures, name);
        if is_some(f_opt) do
            f = unwrap(f_opt);
            if f.scope == scope && f.is_setup == false do
                # Mark as needing setup (caller invokes setup function)
                vec_push(ctx.active, name);
            end
        end
        i = i + 1;
    end
end
func fixture_teardown_all:
    in(ctx: TestContext; scope: int)
    # Teardown in reverse order
    i = vec_len(ctx.active) - 1;
    when i >= 0 loop
        name = vec_get(ctx.active, i);
        f_opt = map_get(ctx.fixtures.fixtures, name);
        if is_some(f_opt) do
            f = unwrap(f_opt);
            if f.scope == scope do
                fixture_teardown(ctx, name);
            end
        end
        i = i - 1;
    end
end
# ═══════════════════════════════════════════════════════
# Temporary directory fixture (common pattern)
# ═══════════════════════════════════════════════════════

func fixture_tmpdir:
    in(test_name: string)
    out "/tmp/vir_test_" + test_name;
end
# ═══════════════════════════════════════════════════════
# Fixture info
# ═══════════════════════════════════════════════════════

func fixture_list:
    in(reg: FixtureRegistry)
    out reg.order;
end
func fixture_is_setup:
    in(ctx: TestContext; name: string)
    f_opt = map_get(ctx.fixtures.fixtures, name);
    if is_some(f_opt) do
        out unwrap(f_opt).is_setup;
    end
    out false;
end