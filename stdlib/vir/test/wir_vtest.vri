##
 * vir/test/wir_vtest.vri — VTest suite for W-IR (Web Compiler Infrastructure)
 * =============================================================================
 * Port of tests/wir/test_wir_builder.py, test_wir_opcodes.py,
 * test_wir_lower_h_to_m.py, test_wir_lower_m_to_l.py, test_wir_optimizer.py
 * → pure Vir vtest.
 *
 * Covers:  WIR opcode enums, schema nodes, builder API,
 *          H→M lowering, M→L lowering, dead style elimination, tree shaking.
 ##

include types;
include string;
import String, str_new, str_eq from string;
include vec;
import Vec, vec_new, vec_push, vec_len, vec_get from vec;
include map;
import Map, map_new, map_set, map_get, map_has, map_len from map;
include test;
import TestSuite, TestResult from test;
include vtest;
import VTestRegistry,
       vtest_suite_new, vtest_add,
       vtest_registry_new, vtest_registry_add_suite, vtest_registry_run,
       vtest_print_summary, vtest_exit_code,
       vtest_pass, vtest_fail,
       vtest_expect_true, vtest_expect_false,
       vtest_expect_eq_i64, vtest_expect_ne_i64,
       vtest_expect_eq_str from vtest;
include wir/opcodes;
import WIRHOp, WIRMOp, WIRLOp from wir/opcodes;
include wir/schema;
import WIRHNode, wir_h_node_new, KVPair, kv_new from wir/schema;
include wir/module;
import WIRGraph, WIRComponent, wir_graph_new, wir_component_new,
       wir_alloc_id, wir_add_h_node,
       wir_add_element, wir_add_text, wir_add_fragment,
       wir_add_component_def, wir_add_state_def,
       wir_add_event_bind, wir_add_style_bind,
       wir_new_block from wir/module;
include wir/builder;
import builder_begin_component, builder_end_component,
       builder_element, builder_text, builder_child,
       builder_root, builder_event, builder_style from wir/builder;
include wir/lower_h_m;
import lower_h_to_m from wir/lower_h_m;
include wir/lower_m_l;
import lower_m_to_l from wir/lower_m_l;


# ═══════════════════════════════════════════════════════
# Tests — WIR Opcode Enum Values
# ═══════════════════════════════════════════════════════

func _test_wir_h_element_40:
    out vtest_expect_eq_i64(WIRHOp::Element >> int, 40);
end

func _test_wir_h_text_41:
    out vtest_expect_eq_i64(WIRHOp::Text >> int, 41);
end

func _test_wir_h_component_def_1:
    out vtest_expect_eq_i64(WIRHOp::ComponentDef >> int, 1);
end

func _test_wir_h_event_bind_20:
    out vtest_expect_eq_i64(WIRHOp::EventBind >> int, 20);
end

func _test_wir_m_create_element_1:
    out vtest_expect_eq_i64(WIRMOp::CreateElement >> int, 1);
end


# ═══════════════════════════════════════════════════════
# Tests — WIR Graph construction
# ═══════════════════════════════════════════════════════

func _test_wir_graph_new:
    g = wir_graph_new(str_new("test_app"));
    out vtest_expect_eq_i64(map_len(g.h_nodes), 0);
end

func _test_wir_add_element:
    g = wir_graph_new(str_new("test_elem"));
    (g, nid) = wir_add_element(g, str_new("div"), str_new("container"));
    if nid > 0:
        node = map_get(g.h_nodes, nid);
        if node.op == WIRHOp::Element:
            out vtest_pass();
        end
    end
    out vtest_fail();
end

func _test_wir_add_text:
    g = wir_graph_new(str_new("test_txt"));
    (g, nid) = wir_add_text(g, str_new("Hello Vir!"));
    if nid > 0:
        node = map_get(g.h_nodes, nid);
        if node.op == WIRHOp::Text:
            out vtest_pass();
        end
    end
    out vtest_fail();
end

func _test_wir_add_component_def:
    g = wir_graph_new(str_new("test_comp"));
    g = wir_new_block(g, str_new("App"));
    (g, nid) = wir_add_component_def(g, str_new("App"));
    node = map_get(g.h_nodes, nid);
    out vtest_expect_eq_i64(node.op >> int, WIRHOp::ComponentDef >> int);
end


# ═══════════════════════════════════════════════════════
# Tests — Builder API
# ═══════════════════════════════════════════════════════

func _test_builder_simple_component:
    g = wir_graph_new(str_new("builder_basic"));
    g = builder_begin_component(g, str_new("App"));
    (g, div_id) = builder_element(g, str_new("App"), str_new("div"), str_new(""));
    (g, txt_id) = builder_text(g, str_new("App"), str_new("Hello"));
    g = builder_child(g, div_id, txt_id);
    g = builder_root(g, str_new("App"), div_id);
    g = builder_end_component(g, str_new("App"));
    # Graph should have ≥ 3 H-nodes (ComponentDef, Element, Text)
    if map_len(g.h_nodes) >= 3:
        out vtest_pass();
    end
    out vtest_fail();
end

func _test_builder_with_event:
    g = wir_graph_new(str_new("builder_evt"));
    g = builder_begin_component(g, str_new("App"));
    (g, btn_id) = builder_element(g, str_new("App"), str_new("button"), str_new(""));
    g = builder_event(g, str_new("App"), btn_id, str_new("click"), str_new("on_click"));
    g = builder_root(g, str_new("App"), btn_id);
    g = builder_end_component(g, str_new("App"));
    # Should have ComponentDef + Element + EventBind ≥ 3
    if map_len(g.h_nodes) >= 3:
        out vtest_pass();
    end
    out vtest_fail();
end

func _test_builder_with_style:
    g = wir_graph_new(str_new("builder_sty"));
    g = builder_begin_component(g, str_new("App"));
    (g, div_id) = builder_element(g, str_new("App"), str_new("div"), str_new("card"));
    g = builder_style(g, str_new("App"), div_id, str_new("card"));
    g = builder_root(g, str_new("App"), div_id);
    g = builder_end_component(g, str_new("App"));
    if map_len(g.h_nodes) >= 3:
        out vtest_pass();
    end
    out vtest_fail();
end


# ═══════════════════════════════════════════════════════
# Tests — H→M Lowering
# ═══════════════════════════════════════════════════════

func _test_lower_h_to_m_element:
    # Single element should lower to CreateElement + AppendChild
    g = wir_graph_new(str_new("hm_elem"));
    g = builder_begin_component(g, str_new("App"));
    (g, div_id) = builder_element(g, str_new("App"), str_new("div"), str_new(""));
    g = builder_root(g, str_new("App"), div_id);
    g = builder_end_component(g, str_new("App"));
    g = lower_h_to_m(g);
    if map_len(g.m_nodes) > 0:
        out vtest_pass();
    end
    out vtest_fail();
end

func _test_lower_h_to_m_text:
    g = wir_graph_new(str_new("hm_txt"));
    g = builder_begin_component(g, str_new("App"));
    (g, div_id) = builder_element(g, str_new("App"), str_new("div"), str_new(""));
    (g, txt_id) = builder_text(g, str_new("App"), str_new("Hi"));
    g = builder_child(g, div_id, txt_id);
    g = builder_root(g, str_new("App"), div_id);
    g = builder_end_component(g, str_new("App"));
    g = lower_h_to_m(g);
    if map_len(g.m_nodes) >= 2:
        out vtest_pass();
    end
    out vtest_fail();
end


# ═══════════════════════════════════════════════════════
# Tests — M→L Lowering
# ═══════════════════════════════════════════════════════

func _test_lower_m_to_l_produces_l_nodes:
    g = wir_graph_new(str_new("ml_basic"));
    g = builder_begin_component(g, str_new("App"));
    (g, div_id) = builder_element(g, str_new("App"), str_new("div"), str_new("card"));
    g = builder_root(g, str_new("App"), div_id);
    g = builder_end_component(g, str_new("App"));
    g = lower_h_to_m(g);
    g = lower_m_to_l(g);
    if map_len(g.l_nodes) > 0:
        out vtest_pass();
    end
    out vtest_fail();
end


# ═══════════════════════════════════════════════════════
# Suite Builder & Runner
# ═══════════════════════════════════════════════════════

func vtest_wir_suite:
    suite = vtest_suite_new(str_new("wir/opcodes+builder+lowering"));

    # opcodes
    suite = vtest_add(suite, str_new("WIRHOp Element=40"),         _test_wir_h_element_40);
    suite = vtest_add(suite, str_new("WIRHOp Text=41"),            _test_wir_h_text_41);
    suite = vtest_add(suite, str_new("WIRHOp ComponentDef=1"),     _test_wir_h_component_def_1);
    suite = vtest_add(suite, str_new("WIRHOp EventBind=20"),       _test_wir_h_event_bind_20);
    suite = vtest_add(suite, str_new("WIRMOp CreateElement=1"),    _test_wir_m_create_element_1);

    # graph construction
    suite = vtest_add(suite, str_new("graph new empty"),           _test_wir_graph_new);
    suite = vtest_add(suite, str_new("add element node"),          _test_wir_add_element);
    suite = vtest_add(suite, str_new("add text node"),             _test_wir_add_text);
    suite = vtest_add(suite, str_new("add component def"),         _test_wir_add_component_def);

    # builder API
    suite = vtest_add(suite, str_new("builder simple component"),  _test_builder_simple_component);
    suite = vtest_add(suite, str_new("builder with event"),        _test_builder_with_event);
    suite = vtest_add(suite, str_new("builder with style"),        _test_builder_with_style);

    # lowering
    suite = vtest_add(suite, str_new("H→M element lowering"),      _test_lower_h_to_m_element);
    suite = vtest_add(suite, str_new("H→M text lowering"),         _test_lower_h_to_m_text);
    suite = vtest_add(suite, str_new("M→L produces L-nodes"),      _test_lower_m_to_l_produces_l_nodes);
    out suite;
end

func vtest_wir_run:
    reg = vtest_registry_new();
    reg = vtest_registry_add_suite(reg, vtest_wir_suite());
    report = vtest_registry_run(reg);
    vtest_print_summary(report);
    out vtest_exit_code(report);
end
