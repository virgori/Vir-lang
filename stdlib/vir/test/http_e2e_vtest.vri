include http
import Method from http
import str_eq, str_new from string

func main:
    let urlHello = str_new("http://127.0.0.1:9876/hello")
    case http.get(urlHello)
    Ok(resp):
        if http.status(resp) != 200 do out 1 end
        let wantHello = str_new("hello")
        if str_eq(resp.body, wantHello) == false do out 2 end
    Err(_): out 3
    end

    let urlEcho = str_new("http://127.0.0.1:9876/echo")
    let bodyPing = str_new("ping")
    let ctPlain = str_new("text/plain")
    case http.post(urlEcho, bodyPing, ctPlain)
    Ok(resp2):
        if http.status(resp2) != 200 do out 4 end
        let wantPing = str_new("ping")
        if str_eq(resp2.body, wantPing) == false do out 5 end
    Err(_): out 6
    end

    let urlHdr = str_new("http://127.0.0.1:9876/headers")
    var req = http.request(Method.GET, urlHdr)
    let hk = str_new("X-Custom-Test")
    let hv = str_new("vir-wave")
    http.requestHeader(req, hk, hv)
    case http.send(req)
    Ok(resp3):
        if http.status(resp3) != 200 do out 7 end
    Err(_): out 8
    end

    let url404 = str_new("http://127.0.0.1:9876/status/404")
    case http.get(url404)
    Ok(resp4):
        if http.status(resp4) != 404 do out 9 end
    Err(_): out 10
    end

    out 0
end.
