##
 * vir/test/parser_conformance_vtest.vri — Parser/Lexer Conformance Test Suite
 * ============================================================================
 * CRITICAL TEST SUITE for Stage 4 "Kill C" transition.
 * 
 * Purpose: Verify that native Vir parser produces IDENTICAL AST to C parser.
 * 
 * Coverage
 *   - All Vir syntax constructs
 *   - Edge cases in tokenization
 *   - Complex nested expressions
 *   - All statement types
 *   - All declaration types
 *   - Spec v1.2 compliance
 *
 * Created: 2026-03-22 for Stage 4 preparation
 ##

include types;
include string;
import String, str_new, str_eq, str_len, str_cat from string;
include vec;
import Vec, vec_new, vec_push, vec_len, vec_get from vec;
include test;
import TestSuite, TestResult from test;
include vtest;
import VTestRegistry,
       vtest_suite_new, vtest_add,
       vtest_registry_new, vtest_registry_add_suite, vtest_registry_run,
       vtest_print_summary, vtest_exit_code,
       vtest_pass, vtest_fail,
       vtest_expect_true, vtest_expect_false,
       vtest_expect_eq_i64, vtest_expect_eq_str from vtest;


# ═══════════════════════════════════════════════════════════════════════════════
# SECTION 1: LITERAL PARSING
# ═══════════════════════════════════════════════════════════════════════════════

func _test_literal_int_decimal:
    x = 12345;
    out vtest_expect_eq_i64(x, 12345);
end.
func _test_literal_int_negative:
    x = -12345;
    out vtest_expect_eq_i64(x, -12345);
end.
func _test_literal_int_zero:
    x = 0;
    out vtest_expect_eq_i64(x, 0);
end.
func _test_literal_int_hex:
    x = 0xFF;
    out vtest_expect_eq_i64(x, 255);
end.
func _test_literal_int_hex_lower:
    x = 0xff;
    out vtest_expect_eq_i64(x, 255);
end.
func _test_literal_int_binary:
    x = 0b1010;
    out vtest_expect_eq_i64(x, 10);
end.
func _test_literal_int_octal:
    x = 0o77;
    out vtest_expect_eq_i64(x, 63);
end.
func _test_literal_float_basic:
    x: f64 = 3.14;
    if x > 3.13 and x < 3.15 do
        out vtest_pass();
    end
    out vtest_fail();
end.
func _test_literal_float_no_int:
    x: f64 = 0.5;
    if x > 0.49 and x < 0.51 do
        out vtest_pass();
    end
    out vtest_fail();
end.
func _test_literal_float_scientific:
    x: f64 = 1.5e3;
    if x > 1499.0 and x < 1501.0 do
        out vtest_pass();
    end
    out vtest_fail();
end.
func _test_literal_float_negative_exp:
    x: f64 = 1.5e-2;
    if x > 0.014 and x < 0.016 do
        out vtest_pass();
    end
    out vtest_fail();
end.
func _test_literal_string_simple:
    s = str_new("hello");
    out vtest_expect_eq_str(s, str_new("hello"));
end.
func _test_literal_string_empty:
    s = str_new("");
    out vtest_expect_eq_i64(str_len(s), 0);
end.
func _test_literal_string_escape_newline:
    s = str_new("line1\nline2");
    # Length should include the newline
    if str_len(s) > 10 do
        out vtest_pass();
    end
    out vtest_fail();
end.
func _test_literal_string_escape_tab:
    s = str_new("col1\tcol2");
    if str_len(s) > 8 do
        out vtest_pass();
    end
    out vtest_fail();
end.
func _test_literal_string_escape_quote:
    s = str_new("say \"hello\"");
    if str_len(s) > 10 do
        out vtest_pass();
    end
    out vtest_fail();
end.
func _test_literal_bool_true:
    b = true;
    out vtest_expect_true(b);
end.
func _test_literal_bool_false:
    b = false;
    out vtest_expect_false(b);
end.
# ═══════════════════════════════════════════════════════════════════════════════
# SECTION 2: VARIABLE DECLARATIONS
# ═══════════════════════════════════════════════════════════════════════════════

func _test_decl_inferred_type:
    x = 42;
    out vtest_expect_eq_i64(x, 42);
end.
func _test_decl_explicit_type_i64:
    x: i64 = 42;
    out vtest_expect_eq_i64(x, 42);
end.
func _test_decl_explicit_type_i32:
    x: i32 = 42;
    out vtest_expect_eq_i64(x >> i64, 42);
end.
func _test_decl_explicit_type_f64:
    x: f64 = 3.14;
    if x > 3.13 and x < 3.15 do
        out vtest_pass();
    end
    out vtest_fail();
end.
func _test_decl_explicit_type_str:
    x: str = "hello";
    out vtest_expect_eq_str(str_new(x), str_new("hello"));
end.
func _test_decl_let_keyword:
    let x = 100;
    out vtest_expect_eq_i64(x, 100);
end.
func _test_decl_const_keyword:
    const PI = 314;
    out vtest_expect_eq_i64(PI, 314);
end.
# ═══════════════════════════════════════════════════════════════════════════════
# SECTION 3: OPERATORS (Precedence & Associativity)
# ═══════════════════════════════════════════════════════════════════════════════

func _test_op_precedence_mul_add:
    # 2 + 3 * 4 = 2 + 12 = 14
    r = 2 + 3 * 4;
    out vtest_expect_eq_i64(r, 14);
end.
func _test_op_precedence_div_sub:
    # 10 - 8 / 2 = 10 - 4 = 6
    r = 10 - 8 / 2;
    out vtest_expect_eq_i64(r, 6);
end.
func _test_op_precedence_parens:
    # (2 + 3) * 4 = 5 * 4 = 20
    r = (2 + 3) * 4;
    out vtest_expect_eq_i64(r, 20);
end.
func _test_op_precedence_nested_parens:
    # ((1 + 2) * (3 + 4)) = 3 * 7 = 21
    r = ((1 + 2) * (3 + 4));
    out vtest_expect_eq_i64(r, 21);
end.
func _test_op_associativity_sub:
    # 10 - 5 - 2 = (10 - 5) - 2 = 3 (left-associative)
    r = 10 - 5 - 2;
    out vtest_expect_eq_i64(r, 3);
end.
func _test_op_associativity_div:
    # 24 / 4 / 2 = (24 / 4) / 2 = 3 (left-associative)
    r = 24 / 4 / 2;
    out vtest_expect_eq_i64(r, 3);
end.
func _test_op_compare_chain:
    # a < b and b < c style
    a: i64 = 1,
        b: i64 = 2,
        c: i64 = 3;
    out vtest_expect_true(a < b and b < c);
end.
func _test_op_logical_and:
    out vtest_expect_true(true and true);
end.
func _test_op_logical_or:
    out vtest_expect_true(false or true);
end.
func _test_op_logical_not:
    out vtest_expect_true(not false);
end.
func _test_op_logical_complex:
    # (true and false) or (not false) = false or true = true
    out vtest_expect_true((true and false) or (not false));
end.
func _test_op_bitwise_precedence:
    # & has higher precedence than |
    # 0b1100 | 0b0011 & 0b0101 = 0b1100 | (0b0011 & 0b0101) = 0b1100 | 0b0001 = 0b1101
    r = 0b1100 | 0b0011 & 0b0101;
    out vtest_expect_eq_i64(r, 0b1101);
end.
func _test_op_shift_precedence:
    # << has higher precedence than +
    # 1 + 2 << 3 = 1 + (2 << 3) = 1 + 16 = 17
    r = 1 + 2 << 3;
    out vtest_expect_eq_i64(r, 17);
end.
# ═══════════════════════════════════════════════════════════════════════════════
# SECTION 4: CONTROL FLOW STATEMENTS
# ═══════════════════════════════════════════════════════════════════════════════

func _test_stmt_if_basic:
    x: i64 = 0;
    if true do
        x = 1;
    end
    out vtest_expect_eq_i64(x, 1);
end.
func _test_stmt_if_else:
    x: i64 = 0;
    if false do
        x = 1;
    else
        x = 2;
    end
    out vtest_expect_eq_i64(x, 2);
end.
func _test_stmt_if_elif:
    x: i64 = 0,
        v: i64 = 2;
    if v == 1 do
        x = 10;
    eif v == 2 do
        x = 20;
    eif v == 3 do
        x = 30;
    else
        x = 40;
    end
    out vtest_expect_eq_i64(x, 20);
end.
func _test_stmt_while:
    count: i64 = 0,
        i: i64 = 0;
    when i < 5 loop
        count = count + 1;
        i = i + 1;
    end
    out vtest_expect_eq_i64(count, 5);
end.
func _test_stmt_for_range:
    sum: i64 = 0;
    for i in 1..6 do
        sum = sum + i;
    end
    # 1+2+3+4+5 = 15
    out vtest_expect_eq_i64(sum, 15);
end.
func _test_stmt_for_inclusive_range:
    sum: i64 = 0;
    for i in 1..=5 do
        sum = sum + i;
    end
    # 1+2+3+4+5 = 15
    out vtest_expect_eq_i64(sum, 15);
end.
func _test_stmt_break:
    count: i64 = 0;
    for i in 0..100 do
        if i == 5 do
            break;
        end
        count = count + 1;
    end
    out vtest_expect_eq_i64(count, 5);
end.
func _test_stmt_continue:
    sum: i64 = 0;
    for i in 0..10 do
        if i % 2 == 0 do
            continue;
        end
        sum = sum + i;
    end
    # 1+3+5+7+9 = 25
    out vtest_expect_eq_i64(sum, 25);
end.
# ═══════════════════════════════════════════════════════════════════════════════
# SECTION 5: FUNCTION DECLARATIONS
# ═══════════════════════════════════════════════════════════════════════════════

func _helper_no_params -> i64
    out 42;
end.
func _helper_one_param(x: i64) -> i64
    out x * 2;
end.
func _helper_two_params(a: i64; b: i64) -> i64
    out a + b;
end.
func _helper_default_param(x: i64; y: i64 = 10) -> i64
    out x + y;
end.
func _helper_void_return(arr: Vec)
    vec_push(arr, 100);
end.
func _test_func_no_params:
    out vtest_expect_eq_i64(_helper_no_params(), 42);
end.
func _test_func_one_param:
    out vtest_expect_eq_i64(_helper_one_param(21), 42);
end.
func _test_func_two_params:
    out vtest_expect_eq_i64(_helper_two_params(20, 22), 42);
end.
func _test_func_default_param_used:
    out vtest_expect_eq_i64(_helper_default_param(32), 42);
end.
func _test_func_default_param_override:
    out vtest_expect_eq_i64(_helper_default_param(32, 10), 42);
end.
func _test_func_void_return:
    arr = vec_new();
    _helper_void_return(arr);
    out vtest_expect_eq_i64(vec_get(arr, 0), 100);
end.
# ═══════════════════════════════════════════════════════════════════════════════
# SECTION 6: ENTITY/STRUCT DECLARATIONS
# ═══════════════════════════════════════════════════════════════════════════════

entity SimpleEntity:
    x: i64,
        y: i64;
end.
entity EntityWithDefault:
    value: i64 = 100,
        name: str;
end.
entity NestedEntity:
    point: SimpleEntity,
        label: str;
end.
func _test_entity_basic:
    e = SimpleEntity ( x: 10, y: 20 );
    out vtest_expect_eq_i64(e.x + e.y, 30);
end.
func _test_entity_field_access:
    e = SimpleEntity ( x: 100, y: 200 );
    out vtest_expect_eq_i64(e.x, 100);
end.
func _test_entity_field_assign:
    e = SimpleEntity ( x: 10, y: 20 );
    e.x = 99;
    out vtest_expect_eq_i64(e.x, 99);
end.
func _test_entity_nested:
    e = NestedEntity (
        point: SimpleEntity ( x: 5, y: 10 ),
        label: "test",
    );
    out vtest_expect_eq_i64(e.point.x, 5);
end.
# ═══════════════════════════════════════════════════════════════════════════════
# SECTION 7: ENUM/VARIANT DECLARATIONS
# ═══════════════════════════════════════════════════════════════════════════════

enum SimpleEnum:
    OptionA;
    OptionB;
    OptionC;
end.
enum EnumWithData:
    None;
    Some(value: i64);
    Pair(first: i64; second: i64);
end.
func _test_enum_simple_match:
    e = SimpleEnum::OptionB,
        x: i64 = 0;
    case e
        case SimpleEnum::OptionA
            x = 1;
        case SimpleEnum::OptionB
            x = 2;
        case SimpleEnum::OptionC
            x = 3;
    end
    out vtest_expect_eq_i64(x, 2);
end.
func _test_enum_with_data:
    e = EnumWithData::Some(42),
        x: i64 = 0;
    case e
        case EnumWithData::None
            x = 0;
        case EnumWithData::Some(v)
            x = v;
        case EnumWithData::Pair(a, b)
            x = a + b;
    end
    out vtest_expect_eq_i64(x, 42);
end.
func _test_enum_pair_destructure:
    e = EnumWithData::Pair(10, 20),
        x: i64 = 0;
    case e
        case EnumWithData::Pair(a, b)
            x = a + b;
        case _
            x = 0;
    end
    out vtest_expect_eq_i64(x, 30);
end.
# ═══════════════════════════════════════════════════════════════════════════════
# SECTION 8: METHOD SYNTAX
# ═══════════════════════════════════════════════════════════════════════════════

entity Counter:
    value: i64;
end.

method Counter.new(init: i64) -> Counter
    out Counter ( value: init );
end.

method Counter.increment(self: &mut Counter)
    self.value = self.value + 1;
end.

method Counter.get(self: &Counter) -> i64
    out self.value;
end.
func _test_method_constructor:
    c = Counter.new(10);
    out vtest_expect_eq_i64(c.value, 10);
end.
func _test_method_call:
    c = Counter.new(5);
    c.increment();
    out vtest_expect_eq_i64(c.get(), 6);
end.
# ═══════════════════════════════════════════════════════════════════════════════
# SECTION 9: ARRAY/VEC LITERAL SYNTAX
# ═══════════════════════════════════════════════════════════════════════════════

func _test_array_literal_empty:
    arr: [i64] = [];
    out vtest_expect_eq_i64(0, 0);  # Just verify no crash
end.
func _test_array_literal_elements:
    arr: [i64] = [1, 2, 3, 4, 5];
    out vtest_expect_eq_i64(arr[2], 3);
end.
func _test_array_literal_nested:
    arr: [[i64]] = [[1, 2], [3, 4]];
    out vtest_expect_eq_i64(arr[0][1], 2);
end.
# ═══════════════════════════════════════════════════════════════════════════════
# SECTION 10: SPEC v1.2 FEATURES
# ═══════════════════════════════════════════════════════════════════════════════

# Test trait definition
trait Printable
    func print_value(self: &Self);
end.

# Test impl blocks
impl Printable for Counter
    func print_value(self: &Counter)
        # Just exercise the syntax
    end.
end.
func _test_trait_impl_exists:
    # Verify trait/impl syntax parses without crash
    c = Counter.new(42);
    out vtest_pass();
end.
# Test generic function syntax
func _generic_identity<T>(x: T) -> T
    out x;
end.
func _test_generic_function:
    r: i64 = _generic_identity(42);
    out vtest_expect_eq_i64(r, 42);
end.
# ═══════════════════════════════════════════════════════════════════════════════
# SECTION 11: COMMENTS
# ═══════════════════════════════════════════════════════════════════════════════

func _test_comment_line:
    x = 10;  # This is a line comment
    # Another comment
    out vtest_expect_eq_i64(x, 10);
end.
func _test_comment_block:
    ##
     * This is a block comment
     * that spans multiple lines
     ##
    x = 20;
    out vtest_expect_eq_i64(x, 20);
end.
# ═══════════════════════════════════════════════════════════════════════════════
# SECTION 12: EDGE CASES
# ═══════════════════════════════════════════════════════════════════════════════

func _test_edge_empty_function:
    # Function with no statements (just pass or empty body)
    out vtest_pass();
end.
func _test_edge_single_statement_if:
    x: i64 = 0;
    if true do x = 1; end
    out vtest_expect_eq_i64(x, 1);
end.
func _test_edge_chained_assignment:
    x: i64 = 0,
        y: i64 = 0;
    x = y = 42;
    if x == 42 and y == 42 do
        out vtest_pass();
    end
    out vtest_fail();
end.
func _test_edge_deeply_nested_expr:
    # (((1 + 2) * 3) + 4) * 5 = ((3 * 3) + 4) * 5 = (9 + 4) * 5 = 13 * 5 = 65
    r = (((1 + 2) * 3) + 4) * 5;
    out vtest_expect_eq_i64(r, 65);
end.
# ═══════════════════════════════════════════════════════════════════════════════
# Suite Registration
# ═══════════════════════════════════════════════════════════════════════════════

func vtest_parser_conformance_suite -> VTestRegistry
    suite = vtest_suite_new(str_new("parser conformance"));
    
    # Section 1: Literals
    suite = vtest_add(suite, str_new("literal int decimal"), _test_literal_int_decimal);
    suite = vtest_add(suite, str_new("literal int negative"), _test_literal_int_negative);
    suite = vtest_add(suite, str_new("literal int zero"), _test_literal_int_zero);
    suite = vtest_add(suite, str_new("literal int hex"), _test_literal_int_hex);
    suite = vtest_add(suite, str_new("literal int hex lower"), _test_literal_int_hex_lower);
    suite = vtest_add(suite, str_new("literal int binary"), _test_literal_int_binary);
    suite = vtest_add(suite, str_new("literal int octal"), _test_literal_int_octal);
    suite = vtest_add(suite, str_new("literal float basic"), _test_literal_float_basic);
    suite = vtest_add(suite, str_new("literal float no int"), _test_literal_float_no_int);
    suite = vtest_add(suite, str_new("literal float scientific"), _test_literal_float_scientific);
    suite = vtest_add(suite, str_new("literal float negative exp"), _test_literal_float_negative_exp);
    suite = vtest_add(suite, str_new("literal string simple"), _test_literal_string_simple);
    suite = vtest_add(suite, str_new("literal string empty"), _test_literal_string_empty);
    suite = vtest_add(suite, str_new("literal string escape newline"), _test_literal_string_escape_newline);
    suite = vtest_add(suite, str_new("literal string escape tab"), _test_literal_string_escape_tab);
    suite = vtest_add(suite, str_new("literal string escape quote"), _test_literal_string_escape_quote);
    suite = vtest_add(suite, str_new("literal bool true"), _test_literal_bool_true);
    suite = vtest_add(suite, str_new("literal bool false"), _test_literal_bool_false);
    
    # Section 2: Declarations
    suite = vtest_add(suite, str_new("decl inferred type"), _test_decl_inferred_type);
    suite = vtest_add(suite, str_new("decl explicit type i64"), _test_decl_explicit_type_i64);
    suite = vtest_add(suite, str_new("decl explicit type i32"), _test_decl_explicit_type_i32);
    suite = vtest_add(suite, str_new("decl explicit type f64"), _test_decl_explicit_type_f64);
    suite = vtest_add(suite, str_new("decl explicit type str"), _test_decl_explicit_type_str);
    suite = vtest_add(suite, str_new("decl let keyword"), _test_decl_let_keyword);
    suite = vtest_add(suite, str_new("decl const keyword"), _test_decl_const_keyword);
    
    # Section 3: Operators
    suite = vtest_add(suite, str_new("op precedence mul add"), _test_op_precedence_mul_add);
    suite = vtest_add(suite, str_new("op precedence div sub"), _test_op_precedence_div_sub);
    suite = vtest_add(suite, str_new("op precedence parens"), _test_op_precedence_parens);
    suite = vtest_add(suite, str_new("op precedence nested parens"), _test_op_precedence_nested_parens);
    suite = vtest_add(suite, str_new("op associativity sub"), _test_op_associativity_sub);
    suite = vtest_add(suite, str_new("op associativity div"), _test_op_associativity_div);
    suite = vtest_add(suite, str_new("op compare chain"), _test_op_compare_chain);
    suite = vtest_add(suite, str_new("op logical and"), _test_op_logical_and);
    suite = vtest_add(suite, str_new("op logical or"), _test_op_logical_or);
    suite = vtest_add(suite, str_new("op logical not"), _test_op_logical_not);
    suite = vtest_add(suite, str_new("op logical complex"), _test_op_logical_complex);
    suite = vtest_add(suite, str_new("op bitwise precedence"), _test_op_bitwise_precedence);
    suite = vtest_add(suite, str_new("op shift precedence"), _test_op_shift_precedence);
    
    # Section 4: Control Flow
    suite = vtest_add(suite, str_new("stmt if basic"), _test_stmt_if_basic);
    suite = vtest_add(suite, str_new("stmt if else"), _test_stmt_if_else);
    suite = vtest_add(suite, str_new("stmt if elif"), _test_stmt_if_elif);
    suite = vtest_add(suite, str_new("stmt while"), _test_stmt_while);
    suite = vtest_add(suite, str_new("stmt for range"), _test_stmt_for_range);
    suite = vtest_add(suite, str_new("stmt for inclusive range"), _test_stmt_for_inclusive_range);
    suite = vtest_add(suite, str_new("stmt break"), _test_stmt_break);
    suite = vtest_add(suite, str_new("stmt continue"), _test_stmt_continue);
    
    # Section 5: Functions
    suite = vtest_add(suite, str_new("func no params"), _test_func_no_params);
    suite = vtest_add(suite, str_new("func one param"), _test_func_one_param);
    suite = vtest_add(suite, str_new("func two params"), _test_func_two_params);
    suite = vtest_add(suite, str_new("func default param used"), _test_func_default_param_used);
    suite = vtest_add(suite, str_new("func default param override"), _test_func_default_param_override);
    suite = vtest_add(suite, str_new("func void return"), _test_func_void_return);
    
    # Section 6: Entities
    suite = vtest_add(suite, str_new("entity basic"), _test_entity_basic);
    suite = vtest_add(suite, str_new("entity field access"), _test_entity_field_access);
    suite = vtest_add(suite, str_new("entity field assign"), _test_entity_field_assign);
    suite = vtest_add(suite, str_new("entity nested"), _test_entity_nested);
    
    # Section 7: Enums
    suite = vtest_add(suite, str_new("enum simple match"), _test_enum_simple_match);
    suite = vtest_add(suite, str_new("enum with data"), _test_enum_with_data);
    suite = vtest_add(suite, str_new("enum pair destructure"), _test_enum_pair_destructure);
    
    # Section 8: Methods
    suite = vtest_add(suite, str_new("method constructor"), _test_method_constructor);
    suite = vtest_add(suite, str_new("method call"), _test_method_call);
    
    # Section 9: Arrays
    suite = vtest_add(suite, str_new("array literal empty"), _test_array_literal_empty);
    suite = vtest_add(suite, str_new("array literal elements"), _test_array_literal_elements);
    suite = vtest_add(suite, str_new("array literal nested"), _test_array_literal_nested);
    
    # Section 10: Spec v1.2
    suite = vtest_add(suite, str_new("trait impl exists"), _test_trait_impl_exists);
    suite = vtest_add(suite, str_new("generic function"), _test_generic_function);
    
    # Section 11: Comments
    suite = vtest_add(suite, str_new("comment line"), _test_comment_line);
    suite = vtest_add(suite, str_new("comment block"), _test_comment_block);
    
    # Section 12: Edge Cases
    suite = vtest_add(suite, str_new("edge empty function"), _test_edge_empty_function);
    suite = vtest_add(suite, str_new("edge single statement if"), _test_edge_single_statement_if);
    suite = vtest_add(suite, str_new("edge chained assignment"), _test_edge_chained_assignment);
    suite = vtest_add(suite, str_new("edge deeply nested expr"), _test_edge_deeply_nested_expr);
    
    out suite;
end.
func vtest_parser_conformance_run:
    reg = vtest_registry_new();
    reg = vtest_registry_add_suite(reg, vtest_parser_conformance_suite());
    result = vtest_registry_run(reg);
    vtest_print_summary(result);
    exit(vtest_exit_code(result));
end.
func main:
    vtest_parser_conformance_run();
end.