##
 * vir/test/tokenizer_vtest.vri — VTest suite for Tokenizer / Frontend
 * =====================================================================
 * Replaces tests/frontend/test_tokenizer.py + tokenizer parts of test_phase3.py.
 * Tests Vir lexer (lexer.vri) on various syntactic patterns.
##

include types;
include string;
import String, str_new, str_eq, str_len, str_contains from string;
include vec;
import Vec, vec_new, vec_push, vec_len, vec_get from vec;
include test;
import TestSuite, TestResult from test;
include vtest;
import VTestRegistry,
       vtest_suite_new, vtest_add,
       vtest_registry_new, vtest_registry_add_suite, vtest_registry_run,
       vtest_print_summary, vtest_exit_code,
       vtest_pass, vtest_fail,
       vtest_expect_true, vtest_expect_false,
       vtest_expect_eq_i64, vtest_expect_ne_i64, vtest_expect_eq_str from vtest;
include compiler/lexer;
import Lexer, Token, TokType, lexer_new, tokenize, token_kind_name from compiler/lexer;


# ═══════════════════════════════════════════════════════
# Tests — Basic Tokenization
# ═══════════════════════════════════════════════════════

func _test_tok_func_keyword:
    let lex = lexer_new(str_new("func hello:"));
    lex = tokenize(lex);
    if lex.error_count == 0 and lex.token_count >= 2:
        out vtest_pass();
    end
    out vtest_fail();
end

func _test_tok_entity_keyword:
    let lex = lexer_new(str_new("entity Point: x:int; y:int end"));
    lex = tokenize(lex);
    if lex.error_count == 0 and lex.token_count >= 6:
        out vtest_pass();
    end
    out vtest_fail();
end

func _test_tok_enum_keyword:
    let lex = lexer_new(str_new("enum Color: Red=0; Green=1; Blue=2 end"));
    lex = tokenize(lex);
    if lex.error_count == 0 and lex.token_count >= 8:
        out vtest_pass();
    end
    out vtest_fail();
end

func _test_tok_numbers:
    let lex = lexer_new(str_new("42 3.14 0xFF 0b1010"));
    lex = tokenize(lex);
    if lex.error_count == 0 and lex.token_count >= 4:
        out vtest_pass();
    end
    out vtest_fail();
end

func _test_tok_string_literal:
    let lex = lexer_new(str_new("let s = str_new(\"hello world\")"));
    lex = tokenize(lex);
    if lex.error_count == 0 and lex.token_count >= 4:
        out vtest_pass();
    end
    out vtest_fail();
end

func _test_tok_operators:
    let lex = lexer_new(str_new("a + b - c * d / e mod f ^ g"));
    lex = tokenize(lex);
    if lex.error_count == 0 and lex.token_count >= 13:
        out vtest_pass();
    end
    out vtest_fail();
end

func _test_tok_comparison:
    let lex = lexer_new(str_new("a == b != c > d < e >= f <= g"));
    lex = tokenize(lex);
    if lex.error_count == 0 and lex.token_count >= 13:
        out vtest_pass();
    end
    out vtest_fail();
end


# ═══════════════════════════════════════════════════════
# Tests — v1.2 Syntax Tokens
# ═══════════════════════════════════════════════════════

func _test_tok_safe_access:
    let lex = lexer_new(str_new("obj?.field"));
    lex = tokenize(lex);
    if lex.error_count == 0:
        out vtest_pass();
    end
    out vtest_fail();
end

func _test_tok_safe_eq:
    let lex = lexer_new(str_new("a ?= b"));
    lex = tokenize(lex);
    if lex.error_count == 0:
        out vtest_pass();
    end
    out vtest_fail();
end

func _test_tok_type_cast:
    let lex = lexer_new(str_new("x >> float"));
    lex = tokenize(lex);
    if lex.error_count == 0 and lex.token_count >= 3:
        out vtest_pass();
    end
    out vtest_fail();
end

func _test_tok_named_args:
    let lex = lexer_new(str_new("f(a=5; b=10)"));
    lex = tokenize(lex);
    if lex.error_count == 0:
        out vtest_pass();
    end
    out vtest_fail();
end

func _test_tok_async_func:
    let lex = lexer_new(str_new("async func fetch_data:\n    out 0;\nend"));
    lex = tokenize(lex);
    if lex.error_count == 0 and lex.token_count >= 5:
        out vtest_pass();
    end
    out vtest_fail();
end

func _test_tok_include_import:
    let lex = lexer_new(str_new("include string;\nimport String, str_new from string;"));
    lex = tokenize(lex);
    if lex.error_count == 0 and lex.token_count >= 6:
        out vtest_pass();
    end
    out vtest_fail();
end

func _test_tok_share_get:
    let lex = lexer_new(str_new("share counter = 0\nget counter"));
    lex = tokenize(lex);
    if lex.error_count == 0:
        out vtest_pass();
    end
    out vtest_fail();
end


# ═══════════════════════════════════════════════════════
# Tests — Complex Structures
# ═══════════════════════════════════════════════════════

func _test_tok_case_statement:
    let src = str_new("case x;\n    case 1\n        out \"one\";\n    case 2\n        out \"two\";\nend");
    let lex = lexer_new(src);
    lex = tokenize(lex);
    if lex.error_count == 0:
        out vtest_pass();
    end
    out vtest_fail();
end

func _test_tok_when_loop:
    let lex = lexer_new(str_new("when i < 10 loop\n    i = i + 1;\nend"));
    lex = tokenize(lex);
    if lex.error_count == 0 and lex.token_count >= 8:
        out vtest_pass();
    end
    out vtest_fail();
end

func _test_tok_try_error:
    let lex = lexer_new(str_new("try:\n    risky_call();\nerror e:\n    println(e);\nend"));
    lex = tokenize(lex);
    if lex.error_count == 0:
        out vtest_pass();
    end
    out vtest_fail();
end

func _test_tok_map_literal:
    let lex = lexer_new(str_new("map\n    \"key1\" => 1\n    \"key2\" => 2\nend"));
    lex = tokenize(lex);
    if lex.error_count == 0:
        out vtest_pass();
    end
    out vtest_fail();
end

func _test_tok_method_def:
    let lex = lexer_new(str_new("method Point.distance:\n    in(other:Point)\n    out 0;\nend"));
    lex = tokenize(lex);
    if lex.error_count == 0 and lex.token_count >= 6:
        out vtest_pass();
    end
    out vtest_fail();
end

func _test_tok_class_def:
    let lex = lexer_new(str_new("class Animal:\n    name:string\n    func speak:\n        out str_new(\"...\");\n    end\nend"));
    lex = tokenize(lex);
    if lex.error_count == 0:
        out vtest_pass();
    end
    out vtest_fail();
end


# ═══════════════════════════════════════════════════════
# Suite builder
# ═══════════════════════════════════════════════════════

func vtest_tokenizer_suite:
    suite = vtest_suite_new(str_new("tokenizer"));
    suite = vtest_add(suite, str_new("func keyword"), _test_tok_func_keyword);
    suite = vtest_add(suite, str_new("entity keyword"), _test_tok_entity_keyword);
    suite = vtest_add(suite, str_new("enum keyword"), _test_tok_enum_keyword);
    suite = vtest_add(suite, str_new("numbers"), _test_tok_numbers);
    suite = vtest_add(suite, str_new("string literal"), _test_tok_string_literal);
    suite = vtest_add(suite, str_new("operators"), _test_tok_operators);
    suite = vtest_add(suite, str_new("comparison"), _test_tok_comparison);
    suite = vtest_add(suite, str_new("safe access"), _test_tok_safe_access);
    suite = vtest_add(suite, str_new("safe eq"), _test_tok_safe_eq);
    suite = vtest_add(suite, str_new("type cast"), _test_tok_type_cast);
    suite = vtest_add(suite, str_new("named args"), _test_tok_named_args);
    suite = vtest_add(suite, str_new("async func"), _test_tok_async_func);
    suite = vtest_add(suite, str_new("include import"), _test_tok_include_import);
    suite = vtest_add(suite, str_new("share get"), _test_tok_share_get);
    suite = vtest_add(suite, str_new("case stmt"), _test_tok_case_statement);
    suite = vtest_add(suite, str_new("when loop"), _test_tok_when_loop);
    suite = vtest_add(suite, str_new("try error"), _test_tok_try_error);
    suite = vtest_add(suite, str_new("map literal"), _test_tok_map_literal);
    suite = vtest_add(suite, str_new("method def"), _test_tok_method_def);
    suite = vtest_add(suite, str_new("class def"), _test_tok_class_def);
    out suite;
end
