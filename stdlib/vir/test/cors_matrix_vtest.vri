include cors

func main:
    cfg = cors.defaults()
    cors.allowOrigin(cfg, "https://ok.example")
    cors.allowMethods(cfg, "DELETE")
    if cors.isOriginAllowed(cfg, "https://ok.example") == false do out 1 end
    if cors.isMethodAllowed(cfg, "GET") == false do out 3 end
    if cors.isMethodAllowed(cfg, "DELETE") == false do out 4 end
    cors.credentials(cfg, false)
    hdrs = cors.headers(cfg, "https://ok.example")
    if hdrs.keys == 0 do out 5 end

    cfg2 = cors.create("https://a.example,https://b.example", "GET,DELETE", "Authorization,Content-Type")
    if cors.isOriginAllowed(cfg2, "https://a.example") == false do out 10 end
    if cors.isOriginAllowed(cfg2, "https://b.example") == false do out 11 end
    if cors.isOriginAllowed(cfg2, "https://other.example") do out 12 end
    if cors.isMethodAllowed(cfg2, "DELETE") == false do out 13 end
    if cors.isMethodAllowed(cfg2, "PATCH") do out 14 end

    pf = cors.preflightHeaders(cfg2, "https://a.example", "DELETE", "Content-Type")
    if pf.keys == 0 do out 15 end

    out 0
end.
