##
 * vir/test/mock.vri — Mocking Framework
 * ========================================
 * Inspired by: Mockito, gomock, Python unittest.mock
 *
 * Mock function recording, expectation verification,
 * return value stubbing, call counting, argument capture.
 ##

include types;
include option;
import Option, Some, None from option;
include vec;
import Vec, vec_new, vec_push, vec_len, vec_get from vec;
include map;
import Map, map_new, map_insert, map_get from map;

# ═══════════════════════════════════════════════════════
# Call recording
# ═══════════════════════════════════════════════════════

entity MockCall:
    method:  string,
        args:    Vec;       # Vec<string> serialized args
end.

entity MockExpect:
    method:     string,
        min_calls:  int,
        max_calls:  int;     # -1 = unlimited
    return_val: string;
end.

entity Mock:
    name:         string,
        calls:        Vec;       # Vec<MockCall>
    expectations: Vec;       # Vec<MockExpect>
    returns:      Map;       # Map<string, string> method → return value
end

# ═══════════════════════════════════════════════════════
# Constructor
# ═══════════════════════════════════════════════════════

func mock_new:
    in(name: string)
    out Mock (
        name: name, calls: vec_new(),
        expectations: vec_new(), returns: map_new()
    );
end

# ═══════════════════════════════════════════════════════
# Stubbing return values
# ═══════════════════════════════════════════════════════

func mock_when:
    in(m: Mock; method: string; return_val: string)
    map_insert(m.returns, method, return_val);
end

# ═══════════════════════════════════════════════════════
# Recording calls
# ═══════════════════════════════════════════════════════

func mock_call:
    in(m: Mock; method: string; args: Vec)
    call = MockCall ( method: method, args: args );
    vec_push(m.calls, call);
    # Return stubbed value
    ret = map_get(m.returns, method);
    if is_some(ret) do
        out unwrap(ret);
    end
    out "";
end.

func mock_call0:
    in(m: Mock; method: string)
    out mock_call(m, method, vec_new());
end.

func mock_call1:
    in(m: Mock; method: string; arg1: string)
    args = vec_new();
    vec_push(args, arg1);
    out mock_call(m, method, args);
end.

func mock_call2:
    in(m: Mock; method: string; arg1: string; arg2: string)
    args = vec_new();
    vec_push(args, arg1);
    vec_push(args, arg2);
    out mock_call(m, method, args);
end

# ═══════════════════════════════════════════════════════
# Expectations
# ═══════════════════════════════════════════════════════

func mock_expect:
    in(m: Mock; method: string; min_calls: int; max_calls: int)
    exp = MockExpect (
        method: method, min_calls: min_calls,
        max_calls: max_calls, return_val: ""
    );
    vec_push(m.expectations, exp);
end.

func mock_expect_once:
    in(m: Mock; method: string)
    mock_expect(m, method, 1, 1);
end.

func mock_expect_at_least:
    in(m: Mock; method: string; n: int)
    mock_expect(m, method, n, -1);
end.

func mock_expect_never:
    in(m: Mock; method: string)
    mock_expect(m, method, 0, 0);
end

# ═══════════════════════════════════════════════════════
# Verification
# ═══════════════════════════════════════════════════════

func _mock_call_count:
    in(m: Mock; method: string)
    count = 0;
    i = 0;
    when i < vec_len(m.calls) loop
        c = vec_get(m.calls, i);
        if c.method == method do
            count = count + 1;
        end
        i = i + 1;
    end
    out count;
end.

entity MockVerifyResult:
    passed:  bool,
        message: string;
end.

func mock_verify:
    in(m: Mock)
    i = 0;
    when i < vec_len(m.expectations) loop
        exp = vec_get(m.expectations, i);
        count = _mock_call_count(m, exp.method);
        if count < exp.min_calls do
            out MockVerifyResult (
                passed: false,
                message: m.name + "." + exp.method + ": expected at least " +
                         int_to_str(exp.min_calls) + " calls, got " +
                         int_to_str(count)
            );
        end
        if exp.max_calls >= 0 && count > exp.max_calls do
            out MockVerifyResult (
                passed: false,
                message: m.name + "." + exp.method + ": expected at most " +
                         int_to_str(exp.max_calls) + " calls, got " +
                         int_to_str(count)
            );
        end
        i = i + 1;
    end
    out MockVerifyResult ( passed: true, message: "OK" );
end.

func mock_verify_method:
    in(m: Mock; method: string; expected_count: int)
    actual = _mock_call_count(m, method);
    out actual == expected_count;
end

# ═══════════════════════════════════════════════════════
# Argument capture
# ═══════════════════════════════════════════════════════

func mock_get_calls:
    in(m: Mock; method: string)
    result = vec_new();
    i = 0;
    when i < vec_len(m.calls) loop
        c = vec_get(m.calls, i);
        if c.method == method do
            vec_push(result, c);
        end
        i = i + 1;
    end
    out result;
end.

func mock_last_call:
    in(m: Mock; method: string)
    calls = mock_get_calls(m, method);
    n = vec_len(calls);
    if n > 0 do
        out Some(vec_get(calls, n - 1));
    end
    out None;
end.

func mock_reset:
    in(m: Mock)
    m.calls = vec_new();
end
