##
 * vir/test/parallel.vri — Parallel Test Runner
 * ===============================================
 * Inspired by: pytest-xdist, Go test -parallel, Rust #[test]
 *
 * Test registration, parallel execution scheduling,
 * result aggregation, worker distribution.
 ##

include types;
include option;
import Option, Some, None from option;
include vec;
import Vec, vec_new, vec_push, vec_len, vec_get, vec_set from vec;
include str;
import StringBuilder, sb_new, sb_append, sb_build, sb_free from str;

# ═══════════════════════════════════════════════════════
# Test status
# ═══════════════════════════════════════════════════════

const TEST_PENDING  = 0;
const TEST_RUNNING  = 1;
const TEST_PASSED   = 2;
const TEST_FAILED   = 3;
const TEST_SKIPPED  = 4;

# ═══════════════════════════════════════════════════════
# Entities
# ═══════════════════════════════════════════════════════

entity TestCase:
    name:     string,
        module:   string,
        status:   int,
        message:  string,
        duration: int;      # ms
    worker:   int;      # assigned worker ID
end.
entity TestSuite:
    name:     string,
        tests:    Vec;      # Vec<TestCase>
end.
entity TestRunner:
    suites:      Vec;   # Vec<TestSuite>
    num_workers: int,
        filter:      string;  # name pattern filter ("" = all)
end.
entity TestReport:
    total:    int,
        passed:   int,
        failed:   int,
        skipped:  int,
        duration: int,
        failures: Vec;      # Vec<TestCase>
end.

# ═══════════════════════════════════════════════════════
# Constructor
# ═══════════════════════════════════════════════════════

func runner_new(num_workers: int):
    out TestRunner (
        suites: vec_new(), num_workers: num_workers,
        filter: ""
    );
end.
func suite_new(name: string):
    out TestSuite ( name: name, tests: vec_new() );
end.
func suite_add_test(suite: TestSuite, name: string):
    tc = TestCase (
        name: name, module: suite.name,
        status: TEST_PENDING, message: "",
        duration: 0, worker: -1
    );
    vec_push(suite.tests, tc);
end.
func runner_add_suite(runner: TestRunner, suite: TestSuite):
    vec_push(runner.suites, suite);
end.
func runner_set_filter(runner: TestRunner, pattern: string):
    runner.filter = pattern;
end.
# ═══════════════════════════════════════════════════════
# Test scheduling — distribute across workers
# ═══════════════════════════════════════════════════════

func runner_schedule(runner: TestRunner):
    # Collect all test cases
    all_tests = vec_new();
    si = 0;
    when si < vec_len(runner.suites) loop
        suite = vec_get(runner.suites, si);
        ti = 0;
        when ti < vec_len(suite.tests) loop
            tc = vec_get(suite.tests, ti);
            if _matches_filter(tc.name, runner.filter) do
                vec_push(all_tests, tc);
            end
            ti = ti + 1;
        end
        si = si + 1;
    end

    # Round-robin assignment
    i = 0;
    when i < vec_len(all_tests) loop
        tc = vec_get(all_tests, i);
        tc.worker = i % runner.num_workers;
        i = i + 1;
    end

    out all_tests;
end.
func _matches_filter(name: string, filter: string):
    if str_len(filter) == 0 do
        out true;
    end
    # Simple substring match
    out str_contains(name, filter);
end.
func str_contains(haystack: string, needle: string):
    hn = str_len(haystack);
    nn = str_len(needle);
    if nn > hn do
        out false;
    end
    i = 0;
    when i <= hn - nn loop
        matched = true;
        j = 0;
        when j < nn && matched loop
            if str_byte_at(haystack, i + j) != str_byte_at(needle, j) do
                matched = false;
            end
            j = j + 1;
        end
        if matched do
            out true;
        end
        i = i + 1;
    end
    out false;
end.
# ═══════════════════════════════════════════════════════
# Get tests for a specific worker
# ═══════════════════════════════════════════════════════

func runner_worker_tests(all_tests: Vec, worker_id: int):
    result = vec_new();
    i = 0;
    when i < vec_len(all_tests) loop
        tc = vec_get(all_tests, i);
        if tc.worker == worker_id do
            vec_push(result, tc);
        end
        i = i + 1;
    end
    out result;
end.
# ═══════════════════════════════════════════════════════
# Record results
# ═══════════════════════════════════════════════════════

func test_pass(tc: TestCase, duration: int):
    tc.status = TEST_PASSED;
    tc.duration = duration;
end.
func test_fail:
    in  tc: TestCase;
        message: string;
        duration: int
    tc.status = TEST_FAILED;
    tc.message = message;
    tc.duration = duration;
end.
func test_skip(tc: TestCase, reason: string):
    tc.status = TEST_SKIPPED;
    tc.message = reason;
end.
# ═══════════════════════════════════════════════════════
# Aggregate report
# ═══════════════════════════════════════════════════════

func runner_report(all_tests: Vec):
    report = TestReport (
        total: 0, passed: 0, failed: 0,
        skipped: 0, duration: 0,
        failures: vec_new()
    );
    i = 0;
    when i < vec_len(all_tests) loop
        tc = vec_get(all_tests, i);
        report.total = report.total + 1;
        report.duration = report.duration + tc.duration;
        if tc.status == TEST_PASSED do
            report.passed = report.passed + 1;
        eif tc.status == TEST_FAILED do
            report.failed = report.failed + 1;
            vec_push(report.failures, tc);
        eif tc.status == TEST_SKIPPED do
            report.skipped = report.skipped + 1;
        end
        i = i + 1;
    end
    out report;
end.
func report_to_text(report: TestReport):
    sb = sb_new();
    sb_append(sb, "Test Results: " + int_to_str(report.passed) + " passed");
    if report.failed > 0 do
        sb_append(sb, ", " + int_to_str(report.failed) + " FAILED");
    end
    if report.skipped > 0 do
        sb_append(sb, ", " + int_to_str(report.skipped) + " skipped");
    end
    sb_append(sb, " (" + int_to_str(report.total) + " total, " +
              int_to_str(report.duration) + "ms)\n");
    if report.failed > 0 do
        sb_append(sb, "\nFailures:\n");
        i = 0;
        when i < vec_len(report.failures) loop
            tc = vec_get(report.failures, i);
            sb_append(sb, "  FAIL " + tc.module + "::" + tc.name +
                      " — " + tc.message + "\n");
            i = i + 1;
        end
    end
    out sb_build(sb);
end.