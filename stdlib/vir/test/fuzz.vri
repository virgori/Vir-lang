##
 * vir/test/fuzz.vri — Fuzz Testing Framework
 * =============================================
 * Inspired by: AFL, libFuzzer, Go fuzzing
 *
 * Mutation-based fuzzing, corpus management,
 * coverage-guided feedback (hooks), crash reporting.
 ##

include types;
include option;
import Option, Some, None from option;
include vec;
import Vec, vec_new, vec_push, vec_len, vec_get, vec_set from vec;
include str;
import StringBuilder, sb_new, sb_append, sb_append_byte, sb_build, sb_free from str;

# ═══════════════════════════════════════════════════════
# PRNG for fuzzing
# ═══════════════════════════════════════════════════════

entity FuzzRng:
    state: int;
end.

func fuzz_rng_new:
    in(seed: int)
    out FuzzRng { state: seed + 1 };
end.

func fuzz_rng_next:
    in(rng: FuzzRng)
    x = rng.state;
    x = x ^ (x * 8192);
    x = x ^ (x / 128);
    x = x ^ (x * 131072);
    if x < 0 do
        x = 0 - x;
    end
    rng.state = x;
    out x;
end

# ═══════════════════════════════════════════════════════
# Corpus management
# ═══════════════════════════════════════════════════════

entity FuzzCorpus:
    entries:     Vec;   # Vec<Vec<int>> — byte arrays
    max_size:    int;
end.

func corpus_new:
    in(max_size: int)
    out FuzzCorpus { entries: vec_new(), max_size: max_size };
end.

func corpus_add:
    in(corpus: FuzzCorpus; input: Vec)
    if vec_len(corpus.entries) < corpus.max_size do
        vec_push(corpus.entries, input);
    end
end.

func corpus_pick:
    in(corpus: FuzzCorpus; rng: FuzzRng)
    n = vec_len(corpus.entries);
    if n == 0 do
        out vec_new();
    end
    idx = fuzz_rng_next(rng) % n;
    out vec_get(corpus.entries, idx);
end

# ═══════════════════════════════════════════════════════
# Mutation strategies
# ═══════════════════════════════════════════════════════

func mutate_flip_bit:
    in(input: Vec; rng: FuzzRng)
    n = vec_len(input);
    if n == 0 do
        out input;
    end
    result = vec_new();
    i = 0;
    when i < n loop
        vec_push(result, vec_get(input, i));
        i = i + 1;
    end
    byte_idx = fuzz_rng_next(rng) % n;
    bit_idx = fuzz_rng_next(rng) % 8;
    mask = 1;
    j = 0;
    when j < bit_idx loop
        mask = mask * 2;
        j = j + 1;
    end
    old_val = vec_get(result, byte_idx);
    vec_set(result, byte_idx, old_val ^ mask);
    out result;
end.

func mutate_insert_byte:
    in(input: Vec; rng: FuzzRng)
    result = vec_new();
    n = vec_len(input);
    pos = fuzz_rng_next(rng) % (n + 1);
    val = fuzz_rng_next(rng) % 256;
    i = 0;
    when i < n + 1 loop
        if i == pos do
            vec_push(result, val);
        end
        if i < n do
            vec_push(result, vec_get(input, i));
        end
        i = i + 1;
    end
    out result;
end.

func mutate_delete_byte:
    in(input: Vec; rng: FuzzRng)
    n = vec_len(input);
    if n == 0 do
        out input;
    end
    result = vec_new();
    pos = fuzz_rng_next(rng) % n;
    i = 0;
    when i < n loop
        if i != pos do
            vec_push(result, vec_get(input, i));
        end
        i = i + 1;
    end
    out result;
end.

func mutate_replace_byte:
    in(input: Vec; rng: FuzzRng)
    n = vec_len(input);
    if n == 0 do
        out input;
    end
    result = vec_new();
    i = 0;
    when i < n loop
        vec_push(result, vec_get(input, i));
        i = i + 1;
    end
    pos = fuzz_rng_next(rng) % n;
    vec_set(result, pos, fuzz_rng_next(rng) % 256);
    out result;
end.

func mutate:
    in(input: Vec; rng: FuzzRng)
    strategy = fuzz_rng_next(rng) % 4;
    if strategy == 0 do
        out mutate_flip_bit(input, rng);
    end
    if strategy == 1 do
        out mutate_insert_byte(input, rng);
    end
    if strategy == 2 do
        out mutate_delete_byte(input, rng);
    end
    out mutate_replace_byte(input, rng);
end

# ═══════════════════════════════════════════════════════
# Fuzz target and result
# ═══════════════════════════════════════════════════════

entity FuzzResult:
    iterations:    int,
        crashes:       int,
        crash_inputs:  Vec;  # Vec<Vec<int>>
    corpus_size:   int;
end

# ═══════════════════════════════════════════════════════
# Fuzz runner
# ═══════════════════════════════════════════════════════

func fuzz_run:
    in(target: func(Vec) bool; seed_inputs: Vec,
        max_iterations: int; seed: int)
    rng = fuzz_rng_new(seed);
    corpus = corpus_new(1000);
    crashes = vec_new();

    # Seed the corpus
    i = 0;
    when i < vec_len(seed_inputs) loop
        corpus_add(corpus, vec_get(seed_inputs, i));
        i = i + 1;
    end
    # Add empty and small inputs
    corpus_add(corpus, vec_new());
    small = vec_new();
    vec_push(small, 0);
    corpus_add(corpus, small);

    iter = 0;
    when iter < max_iterations loop
        # Pick from corpus and mutate
        base = corpus_pick(corpus, rng);
        input = mutate(base, rng);

        # Run target
        ok = target(input);
        if ok == false do
            vec_push(crashes, input);
        else
            # Interesting input → add to corpus
            if vec_len(input) > 0 do
                corpus_add(corpus, input);
            end
        end
        iter = iter + 1;
    end

    out FuzzResult {
        iterations: max_iterations,
        crashes: vec_len(crashes),
        crash_inputs: crashes,
        corpus_size: vec_len(corpus.entries)
    };
end
