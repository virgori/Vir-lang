include crypto.hash
include crypto.hmac
include crypto.rng
import Result, Ok, Err from result

func arr_eq(a: [int], b: [int], n: int) -> bool:
    i = 0
    when i < n loop
        if (a[i] bit_and 255) != (b[i] bit_and 255) do out false end
        i = i + 1
    end
    out true
end.

func main:
    msg = [97, 98, 99]
    dig = hash.sha256(msg, 3)
    expect0 = 0xba
    if (dig[0] bit_and 255) != expect0 do out 1 end

    key = [107, 101, 121]
    tag = hmac.sha256(key, 3, msg, 3)
    if tag[0] == 0 and tag[1] == 0 and tag[2] == 0 do out 2 end
    if hmac.verify(key, 3, msg, 3, tag, 32) == 0 do out 3 end

    case rng.bytes(16)
        Ok(b):
            if b[0] == b[1] and b[1] == b[2] and b[2] == b[3] do out 4 end
        Err(_): out 5
    end

    out 0
end.
