##
 * vir/test/codegen_vtest.vri — VTest suite for Codegen & Backend
 * =================================================================
 * Replaces test_backendpy, codegen parts of test_phase_i/j/h.
 * Tests x86_64 and ARM64 code generation, Mach-O/ELF emitter, JIT.
 ##

include types;
include string;
import String, str_new, str_eq from string;
include vec;
import Vec, vec_new, vec_push, vec_len, vec_get from vec;
include test;
import TestSuite, TestResult from test;
include vtest;
import VTestRegistry,
       vtest_suite_new, vtest_add,
       vtest_registry_new, vtest_registry_add_suite, vtest_registry_run,
       vtest_print_summary, vtest_exit_code,
       vtest_pass, vtest_fail,
       vtest_expect_true, vtest_expect_false,
       vtest_expect_eq_i64, vtest_expect_ne_i64 from vtest;
include ir_optimizer;
import QOp, QModule, QFunction, QInstruction, Operand, OperandType from ir_optimizer;
include compiler/codegen;
import TargetArch, CodeBuffer, codebuf_new, codebuf_len, codebuf_get,
       codegen_emit_func, codegen_emit_module,
       x86_64_emit_add, x86_64_emit_sub, x86_64_emit_ret,
       arm64_emit_add, arm64_emit_sub, arm64_emit_ret from compiler/codegen;


# ═══════════════════════════════════════════════════════
# Helpers
# ═══════════════════════════════════════════════════════

func _vreg:
    in(id:int)
    out Operand ( op_type: OperandType::VReg, vreg: id, imm: 0, patch_id: 0 );
end.

func _imm:
    in(val:int)
    out Operand ( op_type: OperandType::Immediate, vreg: 0, imm: val, patch_id: 0 );
end.

func _none_op:
    out Operand ( op_type: OperandType::None, vreg: 0, imm: 0, patch_id: 0 );
end.

func _instr:
    in(op:int; dest:Operand; src1:Operand; src2:Operand)
    out QInstruction ( opcode: op, dest: dest, src1: src1, src2: src2, patch_id: 0 );
end.

func _make_func:
    in(name:string; body:Vec<QInstruction>)
    out QFunction ( name: name, body: body, param_count: 0, local_count: 8 );
end


# ═══════════════════════════════════════════════════════
# Tests — CodeBuffer
# ═══════════════════════════════════════════════════════

func _test_codebuf_new:
    buf = codebuf_new(256);
    out vtest_expect_eq_i64(codebuf_len(buf), 0);
end.

func _test_codebuf_emit_byte:
    buf = codebuf_new(256);
    codebuf_emit_byte(buf, 0x90);  # NOP
    out vtest_expect_eq_i64(codebuf_len(buf), 1);
end


# ═══════════════════════════════════════════════════════
# Tests — x86_64 Instructions
# ═══════════════════════════════════════════════════════

func _test_x86_emit_add:
    buf = codebuf_new(256);
    x86_64_emit_add(buf, 0, 1);  # ADD RAX, RCX
    if codebuf_len(buf) >= 2 do
        out vtest_pass();
    end
    out vtest_fail();
end.

func _test_x86_emit_sub:
    buf = codebuf_new(256);
    x86_64_emit_sub(buf, 0, 1);
    if codebuf_len(buf) >= 2 do
        out vtest_pass();
    end
    out vtest_fail();
end.

func _test_x86_emit_ret:
    buf = codebuf_new(256);
    x86_64_emit_ret(buf);
    b0 = codebuf_get(buf, 0);
    out vtest_expect_eq_i64(b0, 0xC3);  # RET opcode
end.

func _test_x86_emit_mov_imm:
    buf = codebuf_new(256);
    x86_64_emit_mov_imm(buf, 0, 42);  # MOV RAX, 42
    if codebuf_len(buf) >= 5 do
        out vtest_pass();
    end
    out vtest_fail();
end


# ═══════════════════════════════════════════════════════
# Tests — ARM64 Instructions
# ═══════════════════════════════════════════════════════

func _test_arm64_emit_add:
    buf = codebuf_new(256);
    arm64_emit_add(buf, 0, 1, 2);  # ADD X0, X1, X2
    out vtest_expect_eq_i64(codebuf_len(buf), 4);
end.

func _test_arm64_emit_sub:
    buf = codebuf_new(256);
    arm64_emit_sub(buf, 0, 1, 2);
    out vtest_expect_eq_i64(codebuf_len(buf), 4);
end.

func _test_arm64_emit_ret:
    buf = codebuf_new(256);
    arm64_emit_ret(buf);
    out vtest_expect_eq_i64(codebuf_len(buf), 4);
end.

func _test_arm64_encoding:
    buf = codebuf_new(256);
    arm64_emit_ret(buf);
    # RET encoding: 0xD65F03C0
    b0 = codebuf_get(buf, 0);
    b1 = codebuf_get(buf, 1);
    b2 = codebuf_get(buf, 2);
    b3 = codebuf_get(buf, 3);
    if b0 == 0xC0 and b1 == 0x03 and b2 == 0x5F and b3 == 0xD6 do
        out vtest_pass();
    end
    out vtest_fail();
end


# ═══════════════════════════════════════════════════════
# Tests — Full Function Codegen
# ═══════════════════════════════════════════════════════

func _test_codegen_simple_func:
    body = vec_new<QInstruction>();
    vec_push(body, _instr(QOp::Load, _vreg(0), _imm(42), _none_op()));
    vec_push(body, _instr(QOp::Ret,  _none_op(), _vreg(0), _none_op()));
    f = _make_func(str_new("simple"), body);
    buf = codegen_emit_func(f, TargetArch::ARM64);
    if codebuf_len(buf) >= 8 do
        out vtest_pass();
    end
    out vtest_fail();
end.

func _test_codegen_add_func:
    body = vec_new<QInstruction>();
    vec_push(body, _instr(QOp::Load, _vreg(0), _imm(10), _none_op()));
    vec_push(body, _instr(QOp::Load, _vreg(1), _imm(20), _none_op()));
    vec_push(body, _instr(QOp::Add,  _vreg(2), _vreg(0), _vreg(1)));
    vec_push(body, _instr(QOp::Ret,  _none_op(), _vreg(2), _none_op()));
    f = _make_func(str_new("add_test"), body);
    buf = codegen_emit_func(f, TargetArch::ARM64);
    if codebuf_len(buf) >= 16 do
        out vtest_pass();
    end
    out vtest_fail();
end.

func _test_codegen_module:
    body = vec_new<QInstruction>();
    vec_push(body, _instr(QOp::Load, _vreg(0), _imm(1), _none_op()));
    vec_push(body, _instr(QOp::Ret,  _none_op(), _vreg(0), _none_op()));
    f = _make_func(str_new("entry"), body);
    funcs = vec_new<QFunction>();
    vec_push(funcs, f);
    m = QModule ( functions: funcs, name: str_new("test_mod") );
    buf = codegen_emit_module(m, TargetArch::ARM64);
    if codebuf_len(buf) >= 8 do
        out vtest_pass();
    end
    out vtest_fail();
end


# ═══════════════════════════════════════════════════════
# Suite builder
# ═══════════════════════════════════════════════════════

func vtest_codegen_suite:
    suite = vtest_suite_new(str_new("codegen"));
    suite = vtest_add(suite, str_new("codebuf new"), _test_codebuf_new);
    suite = vtest_add(suite, str_new("codebuf emit"), _test_codebuf_emit_byte);
    suite = vtest_add(suite, str_new("x86 add"), _test_x86_emit_add);
    suite = vtest_add(suite, str_new("x86 sub"), _test_x86_emit_sub);
    suite = vtest_add(suite, str_new("x86 ret"), _test_x86_emit_ret);
    suite = vtest_add(suite, str_new("x86 mov imm"), _test_x86_emit_mov_imm);
    suite = vtest_add(suite, str_new("arm64 add"), _test_arm64_emit_add);
    suite = vtest_add(suite, str_new("arm64 sub"), _test_arm64_emit_sub);
    suite = vtest_add(suite, str_new("arm64 ret"), _test_arm64_emit_ret);
    suite = vtest_add(suite, str_new("arm64 encoding"), _test_arm64_encoding);
    suite = vtest_add(suite, str_new("func simple"), _test_codegen_simple_func);
    suite = vtest_add(suite, str_new("func add"), _test_codegen_add_func);
    suite = vtest_add(suite, str_new("module"), _test_codegen_module);
    out suite;
end
