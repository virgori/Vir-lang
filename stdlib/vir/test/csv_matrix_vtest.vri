include csv

extern func native_read_u8(addr: int, offset: int) -> int

func str_eq(a: string, b: string) -> bool:
    pa = a as int
    pb = b as int
    if pa == pb do out true end
    if pa == 0 or pb == 0 do out false end
    i = 0
    loop
        ca = native_read_u8(pa, i)
        cb = native_read_u8(pb, i)
        if ca != cb do out false end
        if ca == 0 do out true end
        i = i + 1
    end
    out true
end.

func main:
    case csv.parse("\"a,b\",c\n\"a\nb\",c\n\"a\"\"b\",c\na,,c")
    Ok(doc):
        let r0 = csv.at(doc, 0)
        if str_eq(csv.rowAt(r0, 0), "a,b") == false do out 1 end
        let r1 = csv.at(doc, 1)
        if str_eq(csv.rowAt(r1, 0), "a\nb") == false do out 2 end
        let r2 = csv.at(doc, 2)
        if str_eq(csv.rowAt(r2, 0), "a\"b") == false do out 3 end
        let r3 = csv.at(doc, 3)
        if str_eq(csv.rowAt(r3, 1), "") == false do out 4 end
        let back = csv.stringify(doc)
        case csv.parse(back)
        Ok(doc2):
            if csv.count(doc2) != csv.count(doc) do out 5 end
        Err(_): out 6
        end
    Err(_): out 7
    end

    case csv.parseDelim("a;b;c", 59)
    Ok(d3):
        let row = csv.at(d3, 0)
        if str_eq(csv.rowAt(row, 2), "c") == false do out 8 end
        let s3 = csv.stringifyDelim(d3, 59)
        case csv.parseDelim(s3, 59)
        Ok(_): out 0
        Err(_): out 9
        end
    Err(_): out 10
    end

    out 0
end.
