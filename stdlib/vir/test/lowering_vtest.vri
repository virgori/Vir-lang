##
 * vir/test/lowering_vtest.vri — VTest suite for WIR Lowering & Fusion Passes
 * =============================================================================
 * Port of test_m_to_l.py + test_fusion_passes.py → pure Vir vtest.
 * Covers:  H→M lowering, M→L lowering, WIR graph construction + opcode enums,
 *          dead-style/tree-shaking at optimizer level.
 ##

include types;
include string;
import String, str_new, str_eq from string;
include test;
import TestSuite, TestResult from test;
include vtest;
import VTestRegistry,
       vtest_suite_new, vtest_add,
       vtest_registry_new, vtest_registry_add_suite, vtest_registry_run,
       vtest_print_summary, vtest_exit_code,
       vtest_pass, vtest_fail,
       vtest_expect_true, vtest_expect_false,
       vtest_expect_eq_i64, vtest_expect_ne_i64 from vtest;
include wir/opcodes;
import WIRHOp, WIRMOp, WIRLOp from wir/opcodes;
include wir/schema;
import WIRHNode, KVPair, kv_new from wir/schema;
include wir/module;
import WIRGraph, WIRComponent,
       wir_graph_new, wir_add_element, wir_add_text,
       wir_add_component_def, wir_graph_node_count from wir/module;
include wir/builder;
import builder_begin_component, builder_element, builder_text,
       builder_child, builder_root, builder_event, builder_style from wir/builder;
include wir/lower_h_m;
import lower_h_to_m from wir/lower_h_m;
include wir/lower_m_l;
import lower_m_to_l from wir/lower_m_l;


# ═══════════════════════════════════════════════════════
# Tests — H-level → M-level lowering
# ═══════════════════════════════════════════════════════

func _test_h_to_m_element:
    g = wir_graph_new();
    wir_add_element(g, str_new("div"), 0);
    mg = lower_h_to_m(g);
    if wir_graph_node_count(mg) >= 1:
        out vtest_pass();
    end
    out vtest_fail();
end

func _test_h_to_m_text:
    g = wir_graph_new();
    wir_add_text(g, str_new("hello"), 0);
    mg = lower_h_to_m(g);
    if wir_graph_node_count(mg) >= 1:
        out vtest_pass();
    end
    out vtest_fail();
end

func _test_h_to_m_preserves_count:
    g = wir_graph_new();
    wir_add_element(g, str_new("div"), 0);
    wir_add_element(g, str_new("span"), 0);
    wir_add_text(g, str_new("world"), 0);
    mg = lower_h_to_m(g);
    # M-graph should have at least as many nodes as H-graph
    if wir_graph_node_count(mg) >= 3:
        out vtest_pass();
    end
    out vtest_fail();
end


# ═══════════════════════════════════════════════════════
# Tests — M-level → L-level lowering
# ═══════════════════════════════════════════════════════

func _test_m_to_l_produces_nodes:
    g = wir_graph_new();
    wir_add_element(g, str_new("p"), 0);
    wir_add_text(g, str_new("hi"), 0);
    mg = lower_h_to_m(g);
    lg = lower_m_to_l(mg);
    if wir_graph_node_count(lg) >= 1:
        out vtest_pass();
    end
    out vtest_fail();
end

func _test_m_to_l_component:
    g = wir_graph_new();
    wir_add_component_def(g, str_new("MyBtn"));
    wir_add_element(g, str_new("button"), 0);
    mg = lower_h_to_m(g);
    lg = lower_m_to_l(mg);
    if wir_graph_node_count(lg) >= 1:
        out vtest_pass();
    end
    out vtest_fail();
end


# ═══════════════════════════════════════════════════════
# Tests — Builder → full H→M→L pipeline
# ═══════════════════════════════════════════════════════

func _test_builder_full_pipeline:
    comp = builder_begin_component(str_new("Card"));
    builder_element(comp, str_new("div"));
    builder_text(comp, str_new("Hello"));
    g = builder_root(comp);
    mg = lower_h_to_m(g);
    lg = lower_m_to_l(mg);
    if wir_graph_node_count(lg) >= 1:
        out vtest_pass();
    end
    out vtest_fail();
end

func _test_builder_nested_pipeline:
    comp = builder_begin_component(str_new("Page"));
    parent = builder_element(comp, str_new("div"));
    builder_child(comp, parent);
    builder_element(comp, str_new("span"));
    builder_text(comp, str_new("nested"));
    g = builder_root(comp);
    mg = lower_h_to_m(g);
    lg = lower_m_to_l(mg);
    if wir_graph_node_count(lg) >= 2:
        out vtest_pass();
    end
    out vtest_fail();
end

func _test_builder_with_event_pipeline:
    comp = builder_begin_component(str_new("Btn"));
    builder_element(comp, str_new("button"));
    builder_event(comp, str_new("click"), str_new("onClick"));
    g = builder_root(comp);
    mg = lower_h_to_m(g);
    lg = lower_m_to_l(mg);
    if wir_graph_node_count(lg) >= 1:
        out vtest_pass();
    end
    out vtest_fail();
end


# ═══════════════════════════════════════════════════════
# Tests — WIR Opcode enum sanity
# ═══════════════════════════════════════════════════════

func _test_wir_hop_element:
    out vtest_expect_eq_i64(WIRHOp.Element, 40);
end

func _test_wir_hop_text:
    out vtest_expect_eq_i64(WIRHOp.Text, 41);
end

func _test_wir_mop_create_element:
    out vtest_expect_eq_i64(WIRMOp.CreateElement, 1);
end

func _test_wir_lop_create_element:
    out vtest_expect_eq_i64(WIRLOp.CreateElement, 1);
end


# ═══════════════════════════════════════════════════════
# Suite Builder & Runner
# ═══════════════════════════════════════════════════════

func vtest_lowering_suite:
    suite = vtest_suite_new(str_new("wir/lowering+pipeline"));

    # H→M
    suite = vtest_add(suite, str_new("H→M element"),               _test_h_to_m_element);
    suite = vtest_add(suite, str_new("H→M text"),                  _test_h_to_m_text);
    suite = vtest_add(suite, str_new("H→M preserves count ≥3"),    _test_h_to_m_preserves_count);

    # M→L
    suite = vtest_add(suite, str_new("M→L produces nodes"),        _test_m_to_l_produces_nodes);
    suite = vtest_add(suite, str_new("M→L component"),             _test_m_to_l_component);

    # full pipeline
    suite = vtest_add(suite, str_new("builder full H→M→L"),        _test_builder_full_pipeline);
    suite = vtest_add(suite, str_new("builder nested H→M→L"),      _test_builder_nested_pipeline);
    suite = vtest_add(suite, str_new("builder event H→M→L"),       _test_builder_with_event_pipeline);

    # opcode sanity
    suite = vtest_add(suite, str_new("HOp.Element = 40"),          _test_wir_hop_element);
    suite = vtest_add(suite, str_new("HOp.Text = 41"),             _test_wir_hop_text);
    suite = vtest_add(suite, str_new("MOp.CreateElement = 1"),     _test_wir_mop_create_element);
    suite = vtest_add(suite, str_new("LOp.CreateElement = 1"),     _test_wir_lop_create_element);
    out suite;
end

func vtest_lowering_run:
    reg = vtest_registry_new();
    reg = vtest_registry_add_suite(reg, vtest_lowering_suite());
    report = vtest_registry_run(reg);
    vtest_print_summary(report);
    out vtest_exit_code(report);
end
