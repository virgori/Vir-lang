include url
import Option, Some, None from option

extern func native_read_u8(addr: int, offset: int) -> int

func str_eq(a: string, b: string) -> bool:
    pa = a as int
    pb = b as int
    if pa == pb do out true end
    if pa == 0 or pb == 0 do out false end
    i = 0
    loop
        ca = native_read_u8(pa, i)
        cb = native_read_u8(pb, i)
        if ca != cb do out false end
        if ca == 0 do out true end
        i = i + 1
    end
    out true
end.

func main:
    case url.parse("http://example.com")
    Success(u1):
        if str_eq(u1.scheme, "http") == false do out 1 end
        if str_eq(u1.host, "example.com") == false do out 2 end
    Failure(_): out 3
    end

    case url.parse("https://example.com/path")
    Success(u2):
        if str_eq(u2.path, "/path") == false do out 4 end
    Failure(_): out 5
    end

    case url.parse("http://example.com:8080/path")
    Success(u3):
        if u3.port_num != 8080 do out 6 end
    Failure(_): out 7
    end

    enc = url.encode("a b")
    if str_eq(enc, "a%20b") == false do out 8 end

    case url.decode("a%20b")
    Success(dec): if str_eq(dec, "a b") == false do out 9 end
    Failure(_): out 10
    end

    case url.decodeForm("a+b")
    Success(fd): if str_eq(fd, "a b") == false do out 11 end
    Failure(_): out 12
    end

    case url.parse("http://h/?x=1&y=2")
    Success(u4):
        case url.queryGet(u4, "y")
        Some(v): if str_eq(v, "2") == false do out 13 end
        None: out 14
        end
        case url.queryGet(u4, "missing")
        None: ()
        Some(_): out 15
        end
    Failure(_): out 16
    end

    case url.parse("/path?x=1")
    Success(u5):
        s = url.stringify(u5)
        case url.parse(s)
        Success(_): out 0
        Failure(_): out 17
        end
    Failure(_): out 18
    end

    out 0
end.
