include json
import Option, Some, None from option
import json_to_string from json.json

extern func native_read_u8(addr: int, offset: int) -> int

func str_eq(a: string, b: string) -> bool:
    pa = a as int
    pb = b as int
    if pa == pb do out true end
    if pa == 0 or pb == 0 do out false end
    i = 0
    loop
        ca = native_read_u8(pa, i)
        cb = native_read_u8(pb, i)
        if ca != cb do out false end
        if ca == 0 do out true end
        i = i + 1
    end
    out false
end.

func main:
    case json.parse("null")
        Ok(v):
            if json.isNull(v) == false do out 1 end
            if str_eq(json.stringify(v), "null") == false do out 2 end
        Err(_): out 3
    end
    case json.parse("true")
        Ok(v):
            case json.asBool(v)
                Some(flag): if flag == false do out 4 end
                None: out 4
            end
        Err(_): out 5
    end
    case json.parse("42")
        Ok(v):
            case json.asInt(v)
                Some(n): if n != 42 do out 6 end
                None: out 6
            end
        Err(_): out 7
    end
    case json.parse("\"hi\"")
        Ok(v):
            case json.asString(v)
                Some(s): if str_eq(s, "hi") == false do out 8 end
                None: out 8
            end
        Err(_): out 9
    end
    case json.parse("[1,2]")
        Ok(arr):
            case json.at(arr, 1)
                Some(x):
                    case json.asInt(x)
                        Some(n): if n != 2 do out 10 end
                        None: out 10
                    end
                None: out 11
            end
        Err(_): out 12
    end
    case json.parse("{\"k\":1}")
        Ok(obj):
            case json.get(obj, "k")
                Some(x):
                    case json.asInt(x)
                        Some(n): if n != 1 do out 13 end
                        None: out 13
                    end
                None: out 14
            end
        Err(_): out 15
    end
    case json.parse("{bad")
        Ok(_): out 16
        Err(_): ()
    end

    # Exact token access and checked integer conversion.
    case json.parse("1.5")
        Ok(v):
            case json.asInt(v)
                Some(_): out 17
                None: ()
            end
            case json.asNumber(v)
                Some(s):
                    if str_eq(s, "1.5") == false do out 18 end
                    if str_eq(json.stringify(v), "1.5") == false do out 19 end
                None: out 20
            end
        Err(_): out 21
    end
    case json.parse("1e3")
        Ok(v):
            case json.asInt(v)
                Some(_): out 22
                None: ()
            end
            if str_eq(json.stringify(v), "1e3") == false do out 23 end
        Err(_): out 24
    end
    case json.parse("9223372036854775808")
        Ok(v):
            case json.asInt(v)
                Some(_): out 25
                None: ()
            end
            if str_eq(json.stringify(v), "9223372036854775808") == false do out 26 end
        Err(_): out 27
    end
    case json.parse("-9223372036854775808")
        Ok(v):
            case json.asInt(v)
                Some(n):
                    if n != (0 - 9223372036854775807 - 1) do out 31 end
                None: out 32
            end
        Err(_): out 33
    end
    case json.parse("{\"k\":1,\"k\":2}")
        Ok(v):
            if json.getInt(v, "k", -1) != 2 do out 34 end
        Err(_): out 35
    end
    case json.parse("{\"present\":null}")
        Ok(v):
            if json.has(v, "present") == false do out 36 end
            if json.has(v, "missing") do out 37 end
            case json.get(v, "present")
                Some(node):
                    if json.isNull(node) == false do out 38 end
                None: out 39
            end
            case json.get(v, "missing")
                Some(_): out 40
                None: ()
            end
        Err(_): out 41
    end
    case json.asNumber(json.number(-42))
        Some(s):
            if str_eq(s, "-42") == false do out 42 end
        None: out 43
    end
    var ops = json.array()
    json.push(ops, json.number(1))
    json.push(ops, json.number(3))
    if json.insert(ops, 1, json.number(2)) == false do out 44 end
    if json.len(ops) != 3 do out 45 end
    if str_eq(json.stringify(ops), "[1,2,3]") == false do out 46 end
    if json.contains(ops, json.number(2)) == false do out 47 end
    case json.removeAt(ops, 1)
        Some(removed):
            case json.asInt(removed)
                Some(n): if n != 2 do out 48 end
                None: out 49
            end
        None: out 50
    end
    case json.pop(ops)
        Some(removed):
            case json.asInt(removed)
                Some(n): if n != 3 do out 51 end
                None: out 52
            end
        None: out 53
    end
    if json.insert(ops, 8, json.number(0)) do out 54 end
    case json.parse("[1,2]")
        Ok(parsed_arr):
            if json.contains(parsed_arr, json.number(2)) == false do out 71 end
        Err(_): out 72
    end

    var object_ops = json.object()
    json.set(object_ops, "a", json.number(10))
    json.set(object_ops, "b", json.string("x"))
    if json.len(json.keys(object_ops)) != 2 do out 55 end
    if json.len(json.values(object_ops)) != 2 do out 56 end
    if json.len(json.entries(object_ops)) != 2 do out 57 end
    case json.remove(object_ops, "a")
        Some(removed):
            case json.asInt(removed)
                Some(n): if n != 10 do out 58 end
                None: out 59
            end
        None: out 60
    end
    if json.has(object_ops, "a") do out 61 end
    json.clear(object_ops)
    if json.len(object_ops) != 0 do out 62 end
    json.clear(ops)
    if json.len(ops) != 0 do out 63 end
    case json.parse("{\"a\":[1,{\"b\":true}]} ")
        Ok(original):
            case json.deepClone(original)
                Ok(copy):
                    if json.deepEqual(original, copy) == false do out 64 end
                    json.set(copy, "extra", json.null())
                    if json.deepEqual(original, copy) do out 65 end
                Err(_): out 66
            end
        Err(_): out 67
    end
    var merge_target = json.object()
    var merge_source = json.object()
    json.set(merge_target, "keep", json.bool(true))
    json.set(merge_target, "replace", json.number(1))
    json.set(merge_source, "replace", json.number(2))
    json.set(merge_source, "added", json.string("yes"))
    if json.merge(merge_target, merge_source) == false do out 68 end
    if json.getInt(merge_target, "replace", -1) != 2 do out 69 end
    if json.has(merge_target, "keep") == false or json.has(merge_target, "added") == false do out 70 end
    case json.parse("{\"a\":1,\"b\":2}")
        Ok(left):
            case json.parse("{\"b\":2,\"a\":1}")
                Ok(right): if json.deepEqual(left, right) == false do out 73 end
                Err(_): out 74
            end
        Err(_): out 75
    end
    case json.parse("{\"a\":1,\"b\":[2,3]}")
        Ok(v):
            if str_eq(json.stringify(v), "{\"a\":1,\"b\":[2,3]}") == false do out 28 end
            if str_eq(json_to_string(v), "{\"a\":1,\"b\":[2,3]}") == false do out 30 end
        Err(_): out 29
    end
    out 0
end.
