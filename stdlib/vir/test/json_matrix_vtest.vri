include json
import Option, Some, None from option

extern func native_read_u8(addr: int, offset: int) -> int

func str_eq(a: string, b: string) -> bool:
    pa = a as int
    pb = b as int
    if pa == pb do out true end
    if pa == 0 or pb == 0 do out false end
    i = 0
    loop
        ca = native_read_u8(pa, i)
        cb = native_read_u8(pb, i)
        if ca != cb do out false end
        if ca == 0 do out true end
        i = i + 1
    end
    out false
end.

func main:
    case json.parse("null")
        Ok(v):
            if json.isNull(v) == false do out 1 end
            if str_eq(json.stringify(v), "null") == false do out 2 end
        Err(_): out 3
    end
    case json.parse("true")
        Ok(v):
            if json.asBool(v) == false do out 4 end
        Err(_): out 5
    end
    case json.parse("42")
        Ok(v):
            if json.asInt(v) != 42 do out 6 end
        Err(_): out 7
    end
    case json.parse("\"hi\"")
        Ok(v):
            if str_eq(json.asString(v), "hi") == false do out 8 end
        Err(_): out 9
    end
    case json.parse("[1,2]")
        Ok(arr):
            case json.at(arr, 1)
                Some(x):
                    if json.asInt(x) != 2 do out 10 end
                None: out 11
            end
        Err(_): out 12
    end
    case json.parse("{\"k\":1}")
        Ok(obj):
            case json.get(obj, "k")
                Some(x):
                    if json.asInt(x) != 1 do out 13 end
                None: out 14
            end
        Err(_): out 15
    end
    case json.parse("{bad")
        Ok(_): out 16
        Err(_): ()
    end
    out 0
end.
