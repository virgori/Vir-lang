include csv

extern func native_read_u8(addr: int, offset: int) -> int

func str_eq(a: string, b: string) -> bool:
    let pa = a as int
    let pb = b as int
    if pa == pb do out true end
    if pa == 0 or pb == 0 do out false end
    var i = 0
    loop
        let ca = native_read_u8(pa, i)
        let cb = native_read_u8(pb, i)
        if ca != cb do out false end
        if ca == 0 do out true end
        i = i + 1
    end
    out true
end.

func main:
    let r1 = csv.parse("a,b\n1,2")
    case r1
        Ok(doc):
            if csv.count(doc) != 2 do out 1 end
            let row = csv.at(doc, 1)
            if csv.rowCount(row) != 2 do out 2 end
            if !str_eq(csv.rowAt(row, 0), "1") do out 3 end
        Err(_): out 4
    end

    let r2 = csv.parseDelim("x;y", 59)
    case r2
        Ok(doc):
            let row = csv.at(doc, 0)
            if !str_eq(csv.rowAt(row, 1), "y") do out 5 end
        Err(_): out 6
    end

    var doc = csv.doc()
    var row = csv.row()
    csv.rowAdd(row, "q")
    csv.add(doc, row)
    let s = csv.stringify(doc)
    let r3 = csv.parse(s)
    case r3
        Ok(d2):
            if csv.count(d2) != 1 do out 7 end
        Err(_): out 8
    end

    out 0
end.
