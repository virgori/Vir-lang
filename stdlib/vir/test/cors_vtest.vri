include cors

extern func native_read_u8(addr: int, offset: int) -> int

func str_eq(a: string, b: string) -> bool:
    let pa = a as int
    let pb = b as int
    if pa == pb do out true end
    if pa == 0 or pb == 0 do out false end
    var i = 0
    loop
        let ca = native_read_u8(pa, i)
        let cb = native_read_u8(pb, i)
        if ca != cb do out false end
        if ca == 0 do out true end
        i = i + 1
    end
    out true
end.

func main:
    var cfg = cors.defaults()
    if !cors.isOriginAllowed(cfg, "https://a.example") do out 1 end
    if !cors.isMethodAllowed(cfg, "GET") do out 2 end
    cors.allowOrigin(cfg, "https://b.example")
    if !cors.isOriginAllowed(cfg, "https://b.example") do out 3 end
    let hdrs = cors.headers(cfg, "https://b.example")
    if hdrs.keys == 0 do out 4 end
    out 0
end.
