##
 * vir/test/vss_vtest.vri — VTest suite for VSS (Vir Style Sheets)
 * ==================================================================
 * Replaces test_vss.py. Tests VSS tokenizer, parser, resolver, scoper,
 * and CSS emitter.
 ##

include types;
include string;
import String, str_new, str_eq, str_contains from string;
include vec;
import Vec, vec_new, vec_push, vec_len, vec_get from vec;
include test;
import TestSuite, TestResult from test;
include vtest;
import VTestRegistry,
       vtest_suite_new, vtest_add,
       vtest_registry_new, vtest_registry_add_suite, vtest_registry_run,
       vtest_print_summary, vtest_exit_code,
       vtest_pass, vtest_fail,
       vtest_expect_true, vtest_expect_false,
       vtest_expect_eq_i64, vtest_expect_ne_i64, vtest_expect_eq_str from vtest;
include vss/tokenizer;
import VSSTokenizer, VSSToken, VSSTokenKind,
       vss_tokenizer_new, vss_tokenize from vss/tokenizer;
include vss/parser;
import VSSParser, VSSAst, vss_parser_new, vss_parse from vss/parser;
include vss/emitter;
import VSSCSSEmitter, vss_emitter_new, vss_emit_css from vss/emitter;


# ═══════════════════════════════════════════════════════
# Tests — VSS Tokenizer
# ═══════════════════════════════════════════════════════

func _test_vss_tok_theme:
    src = str_new("theme \"dark\" { primary: #0066ff }");
    tok = vss_tokenizer_new(src);
    tokens = vss_tokenize(tok);
    if vec_len(tokens) >= 4 do
        out vtest_pass();
    end
    out vtest_fail();
end
func _test_vss_tok_style:
    src = str_new("style \"card\" { padding: 16px }");
    tok = vss_tokenizer_new(src);
    tokens = vss_tokenize(tok);
    if vec_len(tokens) >= 4 do
        out vtest_pass();
    end
    out vtest_fail();
end
func _test_vss_tok_color_hex:
    src = str_new("color: #ff0033");
    tok = vss_tokenizer_new(src);
    tokens = vss_tokenize(tok);
    has_color = 0;
    i = 0;
    when i < vec_len(tokens) loop
        t = vec_get(tokens, i);
        if t.kind == VSSTokenKind::Color do
            has_color = 1;
        end
        i = i + 1;
    end
    out vtest_expect_eq_i64(has_color, 1);
end
func _test_vss_tok_number:
    src = str_new("opacity: 0.5");
    tok = vss_tokenizer_new(src);
    tokens = vss_tokenize(tok);
    has_number = 0;
    i = 0;
    when i < vec_len(tokens) loop
        t = vec_get(tokens, i);
        if t.kind == VSSTokenKind::Number do
            has_number = 1;
        end
        i = i + 1;
    end
    out vtest_expect_eq_i64(has_number, 1);
end
func _test_vss_tok_unit_values:
    src = str_new("width: 100px margin: 2rem");
    tok = vss_tokenizer_new(src);
    tokens = vss_tokenize(tok);
    unit_count = 0;
    i = 0;
    when i < vec_len(tokens) loop
        t = vec_get(tokens, i);
        if t.kind == VSSTokenKind::UnitValue do
            unit_count = unit_count + 1;
        end
        i = i + 1;
    end
    out vtest_expect_eq_i64(unit_count, 2);
end
func _test_vss_tok_comments_stripped:
    src = str_new("// comment\nstyle \"x\" { color: red }");
    tok = vss_tokenizer_new(src);
    tokens = vss_tokenize(tok);
    has_comment = 0;
    i = 0;
    when i < vec_len(tokens) loop
        t = vec_get(tokens, i);
        if t.kind == VSSTokenKind::Comment do
            has_comment = 1;
        end
        i = i + 1;
    end
    out vtest_expect_eq_i64(has_comment, 0);
end
# ═══════════════════════════════════════════════════════
# Tests — VSS Parser
# ═══════════════════════════════════════════════════════

func _test_vss_parse_theme:
    src = str_new("theme \"dark\" { primary: #0066ff }");
    tok = vss_tokenizer_new(src);
    tokens = vss_tokenize(tok);
    p = vss_parser_new(tokens);
    ast = vss_parse(p);
    if ast.node_count >= 1 do
        out vtest_pass();
    end
    out vtest_fail();
end
func _test_vss_parse_style:
    src = str_new("style \"button\" { padding: 8px background: #333 }");
    tok = vss_tokenizer_new(src);
    tokens = vss_tokenize(tok);
    p = vss_parser_new(tokens);
    ast = vss_parse(p);
    if ast.node_count >= 1 do
        out vtest_pass();
    end
    out vtest_fail();
end
func _test_vss_parse_nested:
    src = str_new("style \"card\" { padding: 16px style \"header\" { font-size: 24px } }");
    tok = vss_tokenizer_new(src);
    tokens = vss_tokenize(tok);
    p = vss_parser_new(tokens);
    ast = vss_parse(p);
    if ast.node_count >= 2 do
        out vtest_pass();
    end
    out vtest_fail();
end
# ═══════════════════════════════════════════════════════
# Tests — VSS CSS Emitter
# ═══════════════════════════════════════════════════════

func _test_vss_emit_simple:
    src = str_new("style \"card\" { padding: 16px }");
    tok = vss_tokenizer_new(src);
    tokens = vss_tokenize(tok);
    p = vss_parser_new(tokens);
    ast = vss_parse(p);
    e = vss_emitter_new();
    css = vss_emit_css(e, ast);
    if str_contains(css, str_new("padding")) do
        out vtest_pass();
    end
    out vtest_fail();
end
func _test_vss_emit_color:
    src = str_new("style \"btn\" { background: #ff0000 }");
    tok = vss_tokenizer_new(src);
    tokens = vss_tokenize(tok);
    p = vss_parser_new(tokens);
    ast = vss_parse(p);
    e = vss_emitter_new();
    css = vss_emit_css(e, ast);
    if str_contains(css, str_new(" do #ff0000")) do
        out vtest_pass();
    end
    out vtest_fail();
end
# ═══════════════════════════════════════════════════════
# Suite builder
# ═══════════════════════════════════════════════════════

func vtest_vss_suite:
    suite = vtest_suite_new(str_new("vss"));
    suite = vtest_add(suite, str_new("tok theme"), _test_vss_tok_theme);
    suite = vtest_add(suite, str_new("tok style"), _test_vss_tok_style);
    suite = vtest_add(suite, str_new("tok color hex"), _test_vss_tok_color_hex);
    suite = vtest_add(suite, str_new("tok number"), _test_vss_tok_number);
    suite = vtest_add(suite, str_new("tok units"), _test_vss_tok_unit_values);
    suite = vtest_add(suite, str_new("tok comments"), _test_vss_tok_comments_stripped);
    suite = vtest_add(suite, str_new("parse theme"), _test_vss_parse_theme);
    suite = vtest_add(suite, str_new("parse style"), _test_vss_parse_style);
    suite = vtest_add(suite, str_new("parse nested"), _test_vss_parse_nested);
    suite = vtest_add(suite, str_new("emit simple"), _test_vss_emit_simple);
    suite = vtest_add(suite, str_new("emit color"), _test_vss_emit_color);
    out suite;
end