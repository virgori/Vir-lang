# parse and fmt registry smoke (no vtest — avoids test/time include parser debt)

include types
include string
import str_new, str_eq, str_concat from string
include result
import is_err from result
include parse
import parse from parse
include fmt
import FmtArg, fmt, fmt_must, fmt_must1 from fmt
include vec
import vec_new from vec

func main:
    r = parse.int("255")
    if is_err(r) do out 1 end
    r2 = parse.intRadix("ff", 16)
    if is_err(r2) do out 2 end
    got = fmt_must1("v=$0", fmt.int(42))
    if str_eq(got, str_new("v=42")) == false do out 3 end
    empty_args = vec_new of (FmtArg)()
    escaped_template = str_concat(str_new("$"), str_new("$"))
    got2 = fmt_must(escaped_template, empty_args)
    if str_eq(got2, str_new("$")) == false do out 4 end
    out 0
end.
