##
 * vir/test/run_all_vtest.vri — Master Test Runner
 * ================================================
 * Runs ALL vtest suites and produces unified report.
 * This replaces `pytest tests/` as the main test entry point.
 *
 * Usage
 *   build/vir run stdlib/vir/test/run_all_vtest.vri
 *
 * Exit codes
 *   0 — All tests passed
 *   1 — One or more tests failed
 ##

include types;
include string;
import String, str_new, str_concat from string;
include format;
import format_int from format;
include vec;
import Vec, vec_new, vec_push, vec_len from vec;
include stdio;
import println, eprintln from stdio;
include test;
import TestSuite, TestReport from test;
include vtest;
import VTestRegistry,
       vtest_registry_new, vtest_registry_add_suite, vtest_registry_run,
       vtest_print_summary, vtest_exit_code from vtest;

# ═══════════════════════════════════════════════════════
# Import ALL vtest suites
# ═══════════════════════════════════════════════════════

include test/virgex_vtest;
import vtest_virgex_suite from test/virgex_vtest;

include test/compiler_vtest;
import vtest_compiler_suite from test/compiler_vtest;

include test/qir_vtest;
import vtest_qir_suite from test/qir_vtest;

include test/wir_vtest;
import vtest_wir_suite from test/wir_vtest;

include test/platform_vtest;
import vtest_platform_suite from test/platform_vtest;

include test/nn_vtest;
import vtest_nn_suite from test/nn_vtest;

include test/math_vtest;
import vtest_math_suite from test/math_vtest;

include test/lowering_vtest;
import vtest_lowering_suite from test/lowering_vtest;

include test/data_profile_vtest;
import vtest_data_profile_suite from test/data_profile_vtest;

include test/simd_jit_vtest;
import vtest_simd_jit_suite from test/simd_jit_vtest;

include test/pgo_tiered_vtest;
import vtest_pgo_tiered_suite from test/pgo_tiered_vtest;

include test/proptest_fuzz_vtest;
import vtest_proptest_fuzz_suite from test/proptest_fuzz_vtest;

include test/bench_e2e_vtest;
import vtest_bench_e2e_suite from test/bench_e2e_vtest;

include test/bootstrap_vtest;
import vtest_bootstrap_suite from test/bootstrap_vtest;

# NEW suites (replacing pytest)

include test/tokenizer_vtest;
import vtest_tokenizer_suite from test/tokenizer_vtest;

include test/type_system_vtest;
import vtest_type_system_suite from test/type_system_vtest;

include test/cost_model_vtest;
import vtest_cost_model_suite from test/cost_model_vtest;

include test/tools_vtest;
import vtest_tools_suite from test/tools_vtest;

include test/mem_vtest;
import vtest_mem_suite from test/mem_vtest;

include test/vss_vtest;
import vtest_vss_suite from test/vss_vtest;

include test/regalloc_vtest;
import vtest_regalloc_suite from test/regalloc_vtest;

include test/grad_vtest;
import vtest_grad_suite from test/grad_vtest;

include test/codegen_vtest;
import vtest_codegen_suite from test/codegen_vtest;

# ═══════════════════════════════════════════════════════
# Stage 4 "Kill C" Conformance Test Suites
# These are CRITICAL for verifying native Vir engine
# ═══════════════════════════════════════════════════════

include test/engine_conformance_vtest;
import vtest_engine_conformance_suite from test/engine_conformance_vtest;

include test/vm_opcodes_vtest;
import vtest_vm_opcodes_suite from test/vm_opcodes_vtest;

include test/parser_conformance_vtest;
import vtest_parser_conformance_suite from test/parser_conformance_vtest;

include test/syscall_conformance_vtest;
import vtest_syscall_conformance_suite from test/syscall_conformance_vtest;


# ═══════════════════════════════════════════════════════
# Main: Register and run all suites
# ═══════════════════════════════════════════════════════

func main:
    println(str_new("═══════════════════════════════════════════════════════"));
    println(str_new("  VIR TEST RUNNER — Full Vtest Suite"));
    println(str_new("═══════════════════════════════════════════════════════"));
    println(str_new(""));

    # Create registry
    reg = vtest_registry_new();

    # Register original suites
    reg = vtest_registry_add_suite(reg, vtest_virgex_suite());
    reg = vtest_registry_add_suite(reg, vtest_compiler_suite());
    reg = vtest_registry_add_suite(reg, vtest_qir_suite());
    reg = vtest_registry_add_suite(reg, vtest_wir_suite());
    reg = vtest_registry_add_suite(reg, vtest_platform_suite());
    reg = vtest_registry_add_suite(reg, vtest_nn_suite());
    reg = vtest_registry_add_suite(reg, vtest_math_suite());
    reg = vtest_registry_add_suite(reg, vtest_lowering_suite());
    reg = vtest_registry_add_suite(reg, vtest_data_profile_suite());
    reg = vtest_registry_add_suite(reg, vtest_simd_jit_suite());
    reg = vtest_registry_add_suite(reg, vtest_pgo_tiered_suite());
    reg = vtest_registry_add_suite(reg, vtest_proptest_fuzz_suite());
    reg = vtest_registry_add_suite(reg, vtest_bench_e2e_suite());
    reg = vtest_registry_add_suite(reg, vtest_bootstrap_suite());

    # Register NEW suites (replacing pytest)
    reg = vtest_registry_add_suite(reg, vtest_tokenizer_suite());
    reg = vtest_registry_add_suite(reg, vtest_type_system_suite());
    reg = vtest_registry_add_suite(reg, vtest_cost_model_suite());
    reg = vtest_registry_add_suite(reg, vtest_tools_suite());
    reg = vtest_registry_add_suite(reg, vtest_mem_suite());
    reg = vtest_registry_add_suite(reg, vtest_vss_suite());
    reg = vtest_registry_add_suite(reg, vtest_regalloc_suite());
    reg = vtest_registry_add_suite(reg, vtest_grad_suite());
    reg = vtest_registry_add_suite(reg, vtest_codegen_suite());

    # Register Stage 4 "Kill C" conformance suites
    reg = vtest_registry_add_suite(reg, vtest_engine_conformance_suite());
    reg = vtest_registry_add_suite(reg, vtest_vm_opcodes_suite());
    reg = vtest_registry_add_suite(reg, vtest_parser_conformance_suite());
    reg = vtest_registry_add_suite(reg, vtest_syscall_conformance_suite());

    # Run all tests
    println(str_new("Running tests..."));
    println(str_new(""));

    report = vtest_registry_run(reg);

    println(str_new(""));
    println(str_new("═══════════════════════════════════════════════════════"));
    vtest_print_summary(report);
    println(str_new("═══════════════════════════════════════════════════════"));

    out vtest_exit_code(report);
end
