include types
include option
import Some, None from option
include deque
import deque_new, deque_push_back, deque_pop_front, deque_len from deque

func main:
    d = deque_new()
    deque_push_back(d, 7)
    deque_push_back(d, 8)
    front = deque_pop_front(d)
    case front
        Some(v):
            if v != 7 do out 1 end
        None: out 2
    end
    if deque_len(d) != 1 do out 3 end
    out 0
end.
