# path and wire-codec registry smoke

include types
include string
import str_eq, str_new from string
include option
import Some, None from option
include path
import path_new, path_join, path_to_string, path_name from path
include encode
import base64_encode_string, hex_encode_string, url_encode from encode

func main:
    joined = path_join(path_new("stdlib"), "vir")
    if str_eq(path_to_string(joined), str_new("stdlib/vir")) == false do out 1 end

    named = path_name(path_new("src/main.vri"))
    case named
        Some(value):
            if str_eq(value, str_new("main.vri")) == false do out 2 end
        None: out 3
    end

    hex = hex_encode_string("Hi")
    if str_eq(hex, str_new("4869")) == false do out 4 end
    b64 = base64_encode_string("Hi")
    if str_eq(b64, str_new("SGk=")) == false do out 5 end
    url = url_encode("a b")
    if str_eq(url, str_new("a%20b")) == false do out 6 end
    out 0
end.
