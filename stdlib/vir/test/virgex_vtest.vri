##
 * vir/test/virgex_vtest.vri — VTest smoke suite for Virgex
 * ========================================================
 * Mục tiêu: chuẩn hóa baseline test Virgex về phía Vir-native,
 * giảm phụ thuộc vào pytest cho lớp integration cơ bản.
 ##

include types;
include string;
import String, str_new, str_contains, str_eq from string;
include result;
import Result, Ok, Err from result;
include option;
import Option, Some, None from option;
include vec;
import Vec, vec_len, vec_get, vec_new, vec_push from vec;
include regex;
import Match from regex;
include virgex;
import VirgexPattern,
       virgex_compile, virgex_pattern_regex,
       virgex_pattern_fullmatch, virgex_pattern_search, virgex_pattern_findall,
       virgex_to_regex, virgex_fullmatch, virgex_search, virgex_findall from virgex;
include test;
import TestSuite, TestResult from test;
include vtest;
import VTestRegistry,
       vtest_suite_new, vtest_add,
       vtest_registry_new, vtest_registry_add_suite, vtest_registry_run,
       vtest_print_summary, vtest_exit_code,
       vtest_pass, vtest_fail, vtest_expect_true, vtest_expect_false, vtest_expect_eq_i64 from vtest;


func _test_to_regex_digits:
    result = virgex_to_regex(str_new("| @0!3 |"));
    case result;
        case Err(e)
            out vtest_fail();
        case Ok(regex_text)
            if str_contains(regex_text, str_new("[0-9]{3}")):
                out vtest_pass();
            end
            out vtest_fail();
    end
end

func _test_fullmatch_ok:
    result = virgex_fullmatch(str_new("| @AZ!2 $- @0!5 |"), str_new("HN-12345"));
    case result;
        case Err(e)
            out vtest_fail();
        case Ok(matched)
            out vtest_expect_true(matched);
    end
end

func _test_fullmatch_fail:
    result = virgex_fullmatch(str_new("| @AZ!2 $- @0!5 |"), str_new("hn-12345"));
    case result;
        case Err(e)
            out vtest_fail();
        case Ok(matched)
            out vtest_expect_false(matched);
    end
end

func _test_search_extract:
    result = virgex_search(str_new("@0!3"), str_new("abc123def"));
    case result;
        case Err(e)
            out vtest_fail();
        case Ok(maybe_match)
            case maybe_match;
                case None
                    out vtest_fail();
                case Some(m)
                    if str_eq(m.text, str_new("123")):
                        out vtest_pass();
                    end
                    out vtest_fail();
            end
    end
end

func _test_findall_count:
    result = virgex_findall(str_new("@0!2~4"), str_new("abc12def3456ghi78"));
    case result;
        case Err(e)
            out vtest_fail();
        case Ok(matches)
            out vtest_expect_eq_i64(vec_len(matches), 3);
    end
end

func _test_compiled_pattern_reuse:
    compiled_result = virgex_compile(str_new("| @0!3 |"));
    case compiled_result;
        case Err(e)
            out vtest_fail();
        case Ok(vp)
            first = virgex_pattern_fullmatch(vp, str_new("123"));
            second = virgex_pattern_fullmatch(vp, str_new("12"));
            if first and !second:
                out vtest_pass();
            end
            out vtest_fail();
    end
end

func vtest_virgex_suite:
    suite = vtest_suite_new(str_new("virgex smoke"));
    suite = vtest_add(suite, str_new("to_regex digits"), _test_to_regex_digits);
    suite = vtest_add(suite, str_new("fullmatch ok"), _test_fullmatch_ok);
    suite = vtest_add(suite, str_new("fullmatch fail"), _test_fullmatch_fail);
    suite = vtest_add(suite, str_new("search extract"), _test_search_extract);
    suite = vtest_add(suite, str_new("findall count"), _test_findall_count);
    suite = vtest_add(suite, str_new("compiled reuse"), _test_compiled_pattern_reuse);
    out suite;
end

func vtest_virgex_smoke_run:
    reg = vtest_registry_new();
    reg = vtest_registry_add_suite(reg, vtest_virgex_suite());
    report = vtest_registry_run(reg);
    vtest_print_summary(report);
    out vtest_exit_code(report);
end
