##
 * vir/test/virgex_vtest.vri — VTest smoke suite for Virgex
 * ========================================================
 * Baseline Vir-native API: virgex.* + Pattern entity (camelCase).
 ##

include types
include string
import String, str_new, str_contains, str_eq from string
include option
import Option from option
include vec
import Vec, vec_len, vec_get, vec_new from vec
include regex
include virgex
include test
import TestSuite, TestResult from test
include vtest
import VTestRegistry,
       vtest_suite_new, vtest_add,
       vtest_registry_new, vtest_registry_add_suite, vtest_registry_run,
       vtest_print_summary, vtest_exit_code,
       vtest_pass, vtest_fail, vtest_expect_true, vtest_expect_false, vtest_expect_eq_i64 from vtest


func _test_compile_digits:
    let pat = virgex.compile("| @0!3 |")
    if pat.fullMatch("123") & !pat.fullMatch("12") do
        out vtest_pass()
    end
    out vtest_fail()
end.
func _test_fullmatch_ok:
    let pat = virgex.compile("| @AZ!2 $- @0!5 |")
    if pat.fullMatch("HN-12345") do
        out vtest_pass()
    end
    out vtest_fail()
end.
func _test_fullmatch_fail:
    let pat = virgex.compile("| @AZ!2 $- @0!5 |")
    if !pat.fullMatch("hn-12345") do
        out vtest_pass()
    end
    out vtest_fail()
end.
func _test_search_extract:
    let pat = virgex.compile("@0!3")
    case virgex.search(pat, "abc123def")
        Option.None: out vtest_fail();
        Option.Some(m):
            if str_eq(m.text, str_new("123")) do
                out vtest_pass()
            end
            out vtest_fail()
    end
end.
func _test_findall_count:
    let pat = virgex.compile("@0!2~4")
    let matches = pat.findAll("abc12def3456ghi78")
    out vtest_expect_eq_i64(vec_len(matches), 3)
end.
func _test_compiled_pattern_reuse:
    let vp = virgex.compile("| @0!3 |")
    if vp.fullMatch("123") & !vp.fullMatch("12") do
        out vtest_pass()
    end
    out vtest_fail()
end.
func vtest_virgex_suite:
    suite = vtest_suite_new(str_new("virgex smoke"))
    suite = vtest_add(suite, str_new("compile digits"), _test_compile_digits)
    suite = vtest_add(suite, str_new("fullmatch ok"), _test_fullmatch_ok)
    suite = vtest_add(suite, str_new("fullmatch fail"), _test_fullmatch_fail)
    suite = vtest_add(suite, str_new("search extract"), _test_search_extract)
    suite = vtest_add(suite, str_new("findall count"), _test_findall_count)
    suite = vtest_add(suite, str_new("compiled reuse"), _test_compiled_pattern_reuse)
    out suite
end.
func vtest_virgex_smoke_run:
    reg = vtest_registry_new()
    reg = vtest_registry_add_suite(reg, vtest_virgex_suite())
    report = vtest_registry_run(reg)
    vtest_print_summary(report)
    out vtest_exit_code(report)
end.
