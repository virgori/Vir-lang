##
 * vir/test/syscall_conformance_vtest.vri — Syscall Conformance Test Suite
 * =======================================================================
 * CRITICAL TEST SUITE for Stage 4 "Kill C" transition.
 * 
 * Purpose: Verify syscall wrappers work identically in C and native Vir.
 * These tests verify the low-level OS interface that Stage 4 must implement.
 *
 * Coverage
 *   - File I/O syscalls (read, write, open, close)
 *   - Memory syscalls (brk-style through wrappers)
 *   - Time syscalls
 *   - Environment syscalls
 *   - Process syscalls (basic only - fork, exec are complex)
 *   - Directory/FS syscalls
 *
 * Created: 2026-03-22 for Stage 4 preparation
 ##

include types;
include string;
import String, str_new, str_eq, str_len, str_cat from string;
include vec;
import Vec, vec_new, vec_push, vec_len, vec_get from vec;
include test;
import TestSuite, TestResult from test;
include vtest;
import VTestRegistry,
       vtest_suite_new, vtest_add,
       vtest_registry_new, vtest_registry_add_suite, vtest_registry_run,
       vtest_print_summary, vtest_exit_code,
       vtest_pass, vtest_fail,
       vtest_expect_true, vtest_expect_false,
       vtest_expect_eq_i64, vtest_expect_eq_str from vtest;
include fs;
import file_read, file_write, file_exists, file_delete, fs_list,
       file_append, file_size from fs;
include os;
import env_get, env_set, time_now, getcwd, getpid from os;


# ═══════════════════════════════════════════════════════════════════════════════
# SECTION 1: FILE I/O - Q_FILE_* syscalls
# ═══════════════════════════════════════════════════════════════════════════════

const TEST_FILE = "/tmp/vir_syscall_test.txt";
const TEST_CONTENT = "Syscall conformance test content\n";

func _test_syscall_file_write:
    file_write(str_new(TEST_FILE), str_new(TEST_CONTENT));
    # Verify file exists
    out vtest_expect_true(file_exists(str_new(TEST_FILE)));
end
func _test_syscall_file_read:
    file_write(str_new(TEST_FILE), str_new(TEST_CONTENT));
    content = file_read(str_new(TEST_FILE));
    out vtest_expect_eq_str(content, str_new(TEST_CONTENT));
end
func _test_syscall_file_size:
    file_write(str_new(TEST_FILE), str_new("12345"));
    size = file_size(str_new(TEST_FILE));
    out vtest_expect_eq_i64(size, 5);
end
func _test_syscall_file_append:
    file_write(str_new(TEST_FILE), str_new("first"));
    file_append(str_new(TEST_FILE), str_new("second"));
    content = file_read(str_new(TEST_FILE));
    out vtest_expect_eq_str(content, str_new("firstsecond"));
end
func _test_syscall_file_delete:
    test_path = str_new("/tmp/vir_delete_test.txt");
    file_write(test_path, str_new("temp"));
    file_delete(test_path);
    out vtest_expect_false(file_exists(test_path));
end
func _test_syscall_file_exists_true:
    file_write(str_new(TEST_FILE), str_new("exists"));
    out vtest_expect_true(file_exists(str_new(TEST_FILE)));
end
func _test_syscall_file_exists_false:
    out vtest_expect_false(file_exists(str_new("/nonexistent/path/xyz.txt")));
end
func _test_syscall_file_binary_data:
    # Test writing and reading binary-like data
    data = str_new("binary\x00data\xFF");
    path = str_new("/tmp/vir_binary_test.bin");
    file_write(path, data);
    read_data = file_read(path);
    # Just verify it doesn't crash
    out vtest_pass();
end
# ═══════════════════════════════════════════════════════════════════════════════
# SECTION 2: ENVIRONMENT VARIABLES - Q_ENV_GET syscalls
# ═══════════════════════════════════════════════════════════════════════════════

func _test_syscall_env_get_path:
    path = env_get(str_new("PATH"));
    # PATH should exist and contain at least /
    out vtest_expect_true(str_len(path) > 0);
end
func _test_syscall_env_get_home:
    home = env_get(str_new("HOME"));
    # HOME should exist on most systems
    out vtest_expect_true(str_len(home) > 0);
end
func _test_syscall_env_get_nonexistent:
    val = env_get(str_new("VIR_SYSCALL_TEST_NONEXISTENT_VAR"));
    out vtest_expect_eq_i64(str_len(val), 0);
end
func _test_syscall_env_set:
    key = str_new("VIR_SYSCALL_TEST_VAR");
    value = str_new("test_value_123");
    env_set(key, value);
    read_val = env_get(key);
    out vtest_expect_eq_str(read_val, value);
end
# ═══════════════════════════════════════════════════════════════════════════════
# SECTION 3: TIME SYSCALLS - Q_TIME
# ═══════════════════════════════════════════════════════════════════════════════

func _test_syscall_time_positive:
    t = time_now();
    # Should be a positive Unix timestamp (after 1970)
    out vtest_expect_true(t > 0);
end
func _test_syscall_time_reasonable:
    t = time_now();
    # Should be after 2020 (1577836800) and before 2100 (4102444800)
    out vtest_expect_true(t > 1577836800 and t < 4102444800);
end
func _test_syscall_time_monotonic:
    t1 = time_now();
    # Small busy wait
    sum: i64 = 0;
    for i in 0..10000
        sum = sum + i;
    end
    t2 = time_now();
    out vtest_expect_true(t2 >= t1);
end
# ═══════════════════════════════════════════════════════════════════════════════
# SECTION 4: PROCESS SYSCALLS - getcwd, getpid
# ═══════════════════════════════════════════════════════════════════════════════

func _test_syscall_getcwd:
    cwd = getcwd();
    # CWD should be non-empty
    out vtest_expect_true(str_len(cwd) > 0);
end
func _test_syscall_getcwd_starts_with_slash:
    cwd = getcwd();
    # On Unix, should start with /
    first_char = str_slice(cwd, 0, 1);
    out vtest_expect_eq_str(first_char, str_new("/"));
end
func _test_syscall_getpid:
    pid = getpid();
    # PID should be positive
    out vtest_expect_true(pid > 0);
end
func _test_syscall_getpid_consistent:
    pid1 = getpid();
    pid2 = getpid();
    # Same process, same PID
    out vtest_expect_eq_i64(pid1, pid2);
end
# ═══════════════════════════════════════════════════════════════════════════════
# SECTION 5: DIRECTORY SYSCALLS - Q_FS_LIST
# ═══════════════════════════════════════════════════════════════════

func _test_syscall_fs_list_root:
    entries = fs_list(str_new("/"));
    # Root should have entries
    out vtest_expect_true(vec_len(entries) > 0);
end
func _test_syscall_fs_list_tmp:
    entries = fs_list(str_new("/tmp"));
    # /tmp should exist and likely have entries
    out vtest_expect_true(vec_len(entries) >= 0);  # Could be empty but shouldn't crash
end
func _test_syscall_fs_list_nonexistent:
    entries = fs_list(str_new("/nonexistent_path_xyz"));
    # Should return empty, not crash
    out vtest_expect_eq_i64(vec_len(entries), 0);
end
# ═══════════════════════════════════════════════════════════════════════════════
# SECTION 6: MEMORY ALLOCATION (indirect through Vec/String)
# ═══════════════════════════════════════════════════════════════════════════════

func _test_syscall_mem_vec_grow:
    # Test that memory allocation works by growing a vector
    arr = vec_new();
    for i in 0..10000
        vec_push(arr, i);
    end
    out vtest_expect_eq_i64(vec_len(arr), 10000);
end
func _test_syscall_mem_string_concat:
    # Test string memory allocation
    s = str_new("");
    for i in 0..100
        s = str_cat(s, str_new("x"));
    end
    out vtest_expect_eq_i64(str_len(s), 100);
end
func _test_syscall_mem_large_alloc:
    # Test large allocation
    arr = vec_new();
    for i in 0..100000
        vec_push(arr, i);
    end
    # Verify last element
    out vtest_expect_eq_i64(vec_get(arr, 99999), 99999);
end
# ═══════════════════════════════════════════════════════════════════════════════
# SECTION 7: INTEGRATION TESTS
# ═══════════════════════════════════════════════════════════════════════════════

func _test_syscall_file_roundtrip:
    # Write, read, verify, delete
    path = str_new("/tmp/vir_roundtrip.txt");
    content = str_new("roundtrip test 12345");
    
    file_write(path, content);
    read_content = file_read(path);
    
    if str_eq(read_content, content) do
        file_delete(path);
        out vtest_pass();
    end
    out vtest_fail();
end
func _test_syscall_env_roundtrip:
    key = str_new("VIR_SYSCALL_ROUNDTRIP");
    value = str_new("value_abc_123");
    
    env_set(key, value);
    read_val = env_get(key);
    
    out vtest_expect_eq_str(read_val, value);
end
func _test_syscall_multiple_files:
    # Test handling multiple files
    for i in 0..10
        path = str_cat(str_new("/tmp/vir_multi_"), str_from_i64(i));
        path = str_cat(path, str_new(".txt"));
        content = str_cat(str_new("content "), str_from_i64(i));
        file_write(path, content);
    end
    
    # Verify all files exist
    all_exist = true;
    for i in 0..10
        path = str_cat(str_new("/tmp/vir_multi_"), str_from_i64(i));
        path = str_cat(path, str_new(".txt"));
        if not file_exists(path) do
            all_exist = false;
        end
    end
    
    # Cleanup
    for i in 0..10
        path = str_cat(str_new("/tmp/vir_multi_"), str_from_i64(i));
        path = str_cat(path, str_new(".txt"));
        file_delete(path);
    end
    
    out vtest_expect_true(all_exist);
end
# ═══════════════════════════════════════════════════════════════════════════════
# Suite Registration
# ═══════════════════════════════════════════════════════════════════════════════

func vtest_syscall_conformance_suite -> VTestRegistry
    suite = vtest_suite_new(str_new("syscall conformance"));
    
    # Section 1: File I/O
    suite = vtest_add(suite, str_new("file write"), _test_syscall_file_write);
    suite = vtest_add(suite, str_new("file read"), _test_syscall_file_read);
    suite = vtest_add(suite, str_new("file size"), _test_syscall_file_size);
    suite = vtest_add(suite, str_new("file append"), _test_syscall_file_append);
    suite = vtest_add(suite, str_new("file delete"), _test_syscall_file_delete);
    suite = vtest_add(suite, str_new("file exists true"), _test_syscall_file_exists_true);
    suite = vtest_add(suite, str_new("file exists false"), _test_syscall_file_exists_false);
    suite = vtest_add(suite, str_new("file binary data"), _test_syscall_file_binary_data);
    
    # Section 2: Environment
    suite = vtest_add(suite, str_new("env get PATH"), _test_syscall_env_get_path);
    suite = vtest_add(suite, str_new("env get HOME"), _test_syscall_env_get_home);
    suite = vtest_add(suite, str_new("env get nonexistent"), _test_syscall_env_get_nonexistent);
    suite = vtest_add(suite, str_new("env set"), _test_syscall_env_set);
    
    # Section 3: Time
    suite = vtest_add(suite, str_new("time positive"), _test_syscall_time_positive);
    suite = vtest_add(suite, str_new("time reasonable"), _test_syscall_time_reasonable);
    suite = vtest_add(suite, str_new("time monotonic"), _test_syscall_time_monotonic);
    
    # Section 4: Process
    suite = vtest_add(suite, str_new("getcwd"), _test_syscall_getcwd);
    suite = vtest_add(suite, str_new("getcwd starts with slash"), _test_syscall_getcwd_starts_with_slash);
    suite = vtest_add(suite, str_new("getpid"), _test_syscall_getpid);
    suite = vtest_add(suite, str_new("getpid consistent"), _test_syscall_getpid_consistent);
    
    # Section 5: Directory
    suite = vtest_add(suite, str_new("fs list root"), _test_syscall_fs_list_root);
    suite = vtest_add(suite, str_new("fs list tmp"), _test_syscall_fs_list_tmp);
    suite = vtest_add(suite, str_new("fs list nonexistent"), _test_syscall_fs_list_nonexistent);
    
    # Section 6: Memory
    suite = vtest_add(suite, str_new("mem vec grow"), _test_syscall_mem_vec_grow);
    suite = vtest_add(suite, str_new("mem string concat"), _test_syscall_mem_string_concat);
    suite = vtest_add(suite, str_new("mem large alloc"), _test_syscall_mem_large_alloc);
    
    # Section 7: Integration
    suite = vtest_add(suite, str_new("file roundtrip"), _test_syscall_file_roundtrip);
    suite = vtest_add(suite, str_new("env roundtrip"), _test_syscall_env_roundtrip);
    suite = vtest_add(suite, str_new("multiple files"), _test_syscall_multiple_files);
    
    out suite;
end
func vtest_syscall_conformance_run:
    reg = vtest_registry_new();
    reg = vtest_registry_add_suite(reg, vtest_syscall_conformance_suite());
    result = vtest_registry_run(reg);
    vtest_print_summary(result);
    exit(vtest_exit_code(result));
end
func main:
    vtest_syscall_conformance_run();
end