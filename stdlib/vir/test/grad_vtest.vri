##
 * vir/test/grad_vtest.vri — VTest suite for Gradient/Autodiff
 * ==============================================================
 * Replaces test_virgrad.py. Tests backward builder, grad rules,
 * tape runtime for autograd/autodiff.
 ##

include types;
include string;
import String, str_new, str_eq from string;
include vec;
import Vec, vec_new, vec_push, vec_len, vec_get from vec;
include test;
import TestSuite, TestResult from test;
include vtest;
import VTestRegistry,
       vtest_suite_new, vtest_add,
       vtest_registry_new, vtest_registry_add_suite, vtest_registry_run,
       vtest_print_summary, vtest_exit_code,
       vtest_pass, vtest_fail,
       vtest_expect_true, vtest_expect_false,
       vtest_expect_eq_i64, vtest_expect_ne_i64 from vtest;
include math/grad;
import Tape, tape_new, tape_record, tape_backward,
       GradTensor, grad_tensor_new, grad_tensor_data, grad_tensor_grad,
       grad_add, grad_mul, grad_relu, grad_softmax from math/grad;


# ═══════════════════════════════════════════════════════
# Tests — Tape Recording
# ═══════════════════════════════════════════════════════

func _test_tape_new:
    t = tape_new();
    out vtest_expect_eq_i64(t.op_count, 0);
end.
func _test_tape_record_add:
    t = tape_new();
    a = grad_tensor_new(vec_of<float>(2.0, 3.0));
    b = grad_tensor_new(vec_of<float>(4.0, 5.0));
    c = grad_add(t, a, b);
    if t.op_count >= 1 do
        out vtest_pass();
    end
    out vtest_fail();
end.
func _test_tape_record_mul:
    t = tape_new();
    a = grad_tensor_new(vec_of<float>(2.0));
    b = grad_tensor_new(vec_of<float>(3.0));
    c = grad_mul(t, a, b);
    if t.op_count >= 1 do
        out vtest_pass();
    end
    out vtest_fail();
end.
# ═══════════════════════════════════════════════════════
# Tests — Grad Rules
# ═══════════════════════════════════════════════════════

func _test_grad_add_rule:
    # d/dx (x + y) = 1
    t = tape_new();
    a = grad_tensor_new(vec_of<float>(2.0));
    b = grad_tensor_new(vec_of<float>(3.0));
    c = grad_add(t, a, b);
    tape_backward(t, c);
    g = grad_tensor_grad(a);
    if g >= 0.99 and g <= 1.01 do
        out vtest_pass();
    end
    out vtest_fail();
end.
func _test_grad_mul_rule:
    # d/dx (x * y) = y
    t = tape_new();
    a = grad_tensor_new(vec_of<float>(2.0));
    b = grad_tensor_new(vec_of<float>(3.0));
    c = grad_mul(t, a, b);
    tape_backward(t, c);
    g = grad_tensor_grad(a);
    if g >= 2.99 and g <= 3.01 do
        out vtest_pass();
    end
    out vtest_fail();
end.
func _test_grad_chain_rule:
    # d/dx (x * x) = 2x
    t = tape_new();
    a = grad_tensor_new(vec_of<float>(4.0));
    c = grad_mul(t, a, a);
    tape_backward(t, c);
    g = grad_tensor_grad(a);
    if g >= 7.99 and g <= 8.01 do
        out vtest_pass();
    end
    out vtest_fail();
end.
# ═══════════════════════════════════════════════════════
# Tests — Activations
# ═══════════════════════════════════════════════════════

func _test_grad_relu_positive:
    t = tape_new();
    a = grad_tensor_new(vec_of<float>(3.0));
    c = grad_relu(t, a);
    data = grad_tensor_data(c);
    if data >= 2.99 and data <= 3.01 do
        out vtest_pass();
    end
    out vtest_fail();
end.
func _test_grad_relu_negative:
    t = tape_new();
    a = grad_tensor_new(vec_of<float>(-3.0));
    c = grad_relu(t, a);
    data = grad_tensor_data(c);
    if data >= -0.01 and data <= 0.01 do
        out vtest_pass();
    end
    out vtest_fail();
end.
# ═══════════════════════════════════════════════════════
# Suite builder
# ═══════════════════════════════════════════════════════

func vtest_grad_suite:
    suite = vtest_suite_new(str_new("gradient"));
    suite = vtest_add(suite, str_new("tape new"), _test_tape_new);
    suite = vtest_add(suite, str_new("tape add"), _test_tape_record_add);
    suite = vtest_add(suite, str_new("tape mul"), _test_tape_record_mul);
    suite = vtest_add(suite, str_new("grad add rule"), _test_grad_add_rule);
    suite = vtest_add(suite, str_new("grad mul rule"), _test_grad_mul_rule);
    suite = vtest_add(suite, str_new("grad chain rule"), _test_grad_chain_rule);
    suite = vtest_add(suite, str_new("relu positive"), _test_grad_relu_positive);
    suite = vtest_add(suite, str_new("relu negative"), _test_grad_relu_negative);
    out suite;
end.