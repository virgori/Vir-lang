##
 * vir/test/engine_conformance_vtest.vri — Engine Conformance Test Suite
 * =====================================================================
 * CRITICAL TEST SUITE for Stage 4 "Kill C" transition.
 * 
 * Purpose: Verify that native Vir engine produces IDENTICAL results to C engine.
 * 
 * Coverage:
 *   1. ALL Q-IR opcodes (148 opcodes)
 *   2. Parser conformance
 *   3. Codegen output consistency
 *   4. Memory operations
 *   5. Syscall wrappers
 *   6. Bootstrap chain verification
 *
 * Run: ./core/build/vir run stdlib/vir/test/engine_conformance_vtest.vri
 *
 * PASS CRITERIA: ALL tests must pass on BOTH C engine and native Vir engine.
 * Any difference = BUG that must be fixed before "Kill C" can proceed.
 *
 * Created: 2026-03-22 for Stage 4 preparation
 ##

include types;
include string;
import String, str_new, str_eq, str_len, str_cat, str_slice, str_to_i64,
       str_from_i64, str_contains, str_starts_with, str_ends_with,
       str_split, str_trim, str_upper, str_lower, str_replace from string;
include vec;
import Vec, vec_new, vec_push, vec_len, vec_get, vec_set, vec_pop,
       vec_slice, vec_insert, vec_remove from vec;
include map;
import Map, map_new, map_set, map_get, map_has, map_del, map_keys from map;
include test;
import TestSuite, TestResult from test;
include vtest;
import VTestRegistry,
       vtest_suite_new, vtest_add,
       vtest_registry_new, vtest_registry_add_suite, vtest_registry_run,
       vtest_print_summary, vtest_exit_code,
       vtest_pass, vtest_fail,
       vtest_expect_true, vtest_expect_false,
       vtest_expect_eq_i64, vtest_expect_ne_i64,
       vtest_expect_eq_str from vtest;
include math;
import abs, sqrt, sin, cos, tan, floor, ceil, round, pow, log, exp,
       min, max from math;
include io;
import print, println, read_line from io;
include fs;
import file_read, file_write, file_exists, fs_list from fs;


# ═══════════════════════════════════════════════════════════════════════════════
# SECTION 1: ARITHMETIC OPERATIONS (Q_ADD, Q_SUB, Q_MUL, Q_DIV, Q_MOD)
# ═══════════════════════════════════════════════════════════════════════════════

func _test_arith_add_i64:
    a: i64 = 100;
    b: i64 = 200;
    c = a + b;
    out vtest_expect_eq_i64(c, 300);
end

func _test_arith_add_negative:
    a: i64 = -50;
    b: i64 = 30;
    c = a + b;
    out vtest_expect_eq_i64(c, -20);
end

func _test_arith_add_overflow:
    # Test large numbers (not actual overflow, just large)
    a: i64 = 9223372036854775800;
    b: i64 = 5;
    c = a + b;
    out vtest_expect_eq_i64(c, 9223372036854775805);
end

func _test_arith_sub:
    a: i64 = 500;
    b: i64 = 123;
    c = a - b;
    out vtest_expect_eq_i64(c, 377);
end

func _test_arith_sub_negative_result:
    a: i64 = 10;
    b: i64 = 25;
    c = a - b;
    out vtest_expect_eq_i64(c, -15);
end

func _test_arith_mul:
    a: i64 = 12;
    b: i64 = 34;
    c = a * b;
    out vtest_expect_eq_i64(c, 408);
end

func _test_arith_mul_negative:
    a: i64 = -7;
    b: i64 = 8;
    c = a * b;
    out vtest_expect_eq_i64(c, -56);
end

func _test_arith_div:
    a: i64 = 100;
    b: i64 = 4;
    c = a / b;
    out vtest_expect_eq_i64(c, 25);
end

func _test_arith_div_truncate:
    a: i64 = 17;
    b: i64 = 5;
    c = a / b;
    out vtest_expect_eq_i64(c, 3);
end

func _test_arith_mod:
    a: i64 = 17;
    b: i64 = 5;
    c = a % b;
    out vtest_expect_eq_i64(c, 2);
end

func _test_arith_mod_negative:
    a: i64 = -17;
    b: i64 = 5;
    c = a % b;
    # C behavior: -17 % 5 = -2
    out vtest_expect_eq_i64(c, -2);
end


# ═══════════════════════════════════════════════════════════════════════════════
# SECTION 2: FLOATING POINT OPERATIONS (Q_FADD, Q_FSUB, Q_FMUL, Q_FDIV)
# ═══════════════════════════════════════════════════════════════════════════════

func _test_float_add:
    a: f64 = 1.5;
    b: f64 = 2.5;
    c = a + b;
    if c > 3.99 and c < 4.01:
        out vtest_pass();
    end
    out vtest_fail();
end

func _test_float_sub:
    a: f64 = 10.5;
    b: f64 = 3.3;
    c = a - b;
    if c > 7.19 and c < 7.21:
        out vtest_pass();
    end
    out vtest_fail();
end

func _test_float_mul:
    a: f64 = 2.5;
    b: f64 = 4.0;
    c = a * b;
    if c > 9.99 and c < 10.01:
        out vtest_pass();
    end
    out vtest_fail();
end

func _test_float_div:
    a: f64 = 15.0;
    b: f64 = 4.0;
    c = a / b;
    if c > 3.74 and c < 3.76:
        out vtest_pass();
    end
    out vtest_fail();
end


# ═══════════════════════════════════════════════════════════════════════════════
# SECTION 3: MATH FUNCTIONS (Q_SIN, Q_COS, Q_TAN, Q_SQRT, Q_ABS, Q_POW)
# ═══════════════════════════════════════════════════════════════════════════════

func _test_math_sqrt:
    r = sqrt(16.0);
    if r > 3.99 and r < 4.01:
        out vtest_pass();
    end
    out vtest_fail();
end

func _test_math_sqrt_non_perfect:
    r = sqrt(2.0);
    if r > 1.413 and r < 1.415:
        out vtest_pass();
    end
    out vtest_fail();
end

func _test_math_abs_positive:
    r = abs(42);
    out vtest_expect_eq_i64(r, 42);
end

func _test_math_abs_negative:
    r = abs(-42);
    out vtest_expect_eq_i64(r, 42);
end

func _test_math_pow:
    r = pow(2.0, 10.0);
    if r > 1023.9 and r < 1024.1:
        out vtest_pass();
    end
    out vtest_fail();
end

func _test_math_sin_zero:
    r = sin(0.0);
    if r > -0.001 and r < 0.001:
        out vtest_pass();
    end
    out vtest_fail();
end

func _test_math_cos_zero:
    r = cos(0.0);
    if r > 0.999 and r < 1.001:
        out vtest_pass();
    end
    out vtest_fail();
end

func _test_math_min:
    r = min(5, 3);
    out vtest_expect_eq_i64(r, 3);
end

func _test_math_max:
    r = max(5, 3);
    out vtest_expect_eq_i64(r, 5);
end


# ═══════════════════════════════════════════════════════════════════════════════
# SECTION 4: COMPARISON OPERATIONS (Q_CMP_EQ/GT/LT/GE/LE/NE)
# ═══════════════════════════════════════════════════════════════════════════════

func _test_cmp_eq_true:
    a: i64 = 42;
    b: i64 = 42;
    out vtest_expect_true(a == b);
end

func _test_cmp_eq_false:
    a: i64 = 42;
    b: i64 = 43;
    out vtest_expect_false(a == b);
end

func _test_cmp_ne:
    a: i64 = 10;
    b: i64 = 20;
    out vtest_expect_true(a != b);
end

func _test_cmp_gt:
    a: i64 = 50;
    b: i64 = 30;
    out vtest_expect_true(a > b);
end

func _test_cmp_lt:
    a: i64 = 30;
    b: i64 = 50;
    out vtest_expect_true(a < b);
end

func _test_cmp_ge_greater:
    a: i64 = 50;
    b: i64 = 30;
    out vtest_expect_true(a >= b);
end

func _test_cmp_ge_equal:
    a: i64 = 50;
    b: i64 = 50;
    out vtest_expect_true(a >= b);
end

func _test_cmp_le_less:
    a: i64 = 30;
    b: i64 = 50;
    out vtest_expect_true(a <= b);
end

func _test_cmp_le_equal:
    a: i64 = 50;
    b: i64 = 50;
    out vtest_expect_true(a <= b);
end


# ═══════════════════════════════════════════════════════════════════════════════
# SECTION 5: BITWISE OPERATIONS (Q_AND, Q_OR, Q_XOR, Q_SHL, Q_SHR, Q_NOT)
# ═══════════════════════════════════════════════════════════════════════════════

func _test_bit_and:
    a: i64 = 0b1100;
    b: i64 = 0b1010;
    c = a & b;
    out vtest_expect_eq_i64(c, 0b1000);
end

func _test_bit_or:
    a: i64 = 0b1100;
    b: i64 = 0b1010;
    c = a | b;
    out vtest_expect_eq_i64(c, 0b1110);
end

func _test_bit_xor:
    a: i64 = 0b1100;
    b: i64 = 0b1010;
    c = a ^ b;
    out vtest_expect_eq_i64(c, 0b0110);
end

func _test_bit_shl:
    a: i64 = 1;
    c = a << 4;
    out vtest_expect_eq_i64(c, 16);
end

func _test_bit_shr:
    a: i64 = 64;
    c = a >> 2;
    out vtest_expect_eq_i64(c, 16);
end

func _test_bit_not:
    a: i64 = 0;
    c = ~a;
    out vtest_expect_eq_i64(c, -1);
end


# ═══════════════════════════════════════════════════════════════════════════════
# SECTION 6: CONTROL FLOW (Q_JUMP, Q_JUMP_IF, Q_JUMP_IF_NOT, Q_CALL, Q_RET)
# ═══════════════════════════════════════════════════════════════════════════════

func _helper_add(a: i64; b: i64) -> i64:
    out a + b;
end

func _test_ctrl_call_ret:
    r = _helper_add(10, 20);
    out vtest_expect_eq_i64(r, 30);
end

func _test_ctrl_if_true_branch:
    x: i64 = 0;
    if 1 == 1:
        x = 100;
    else:
        x = 200;
    end
    out vtest_expect_eq_i64(x, 100);
end

func _test_ctrl_if_false_branch:
    x: i64 = 0;
    if 1 == 2:
        x = 100;
    else:
        x = 200;
    end
    out vtest_expect_eq_i64(x, 200);
end

func _test_ctrl_while_loop:
    sum: i64 = 0;
    i: i64 = 1;
    while i <= 10:
        sum = sum + i;
        i = i + 1;
    end
    out vtest_expect_eq_i64(sum, 55);
end

func _test_ctrl_for_loop:
    sum: i64 = 0;
    for i in 1..11:
        sum = sum + i;
    end
    out vtest_expect_eq_i64(sum, 55);
end

func _test_ctrl_nested_loops:
    count: i64 = 0;
    for i in 0..5:
        for j in 0..5:
            count = count + 1;
        end
    end
    out vtest_expect_eq_i64(count, 25);
end

func _helper_recursive_fact(n: i64) -> i64:
    if n <= 1:
        out 1;
    end
    out n * _helper_recursive_fact(n - 1);
end

func _test_ctrl_recursion:
    r = _helper_recursive_fact(5);
    out vtest_expect_eq_i64(r, 120);
end


# ═══════════════════════════════════════════════════════════════════════════════
# SECTION 7: STRING OPERATIONS (Q_STR_*)
# ═══════════════════════════════════════════════════════════════════════════════

func _test_str_new:
    s = str_new("hello");
    out vtest_expect_eq_str(s, str_new("hello"));
end

func _test_str_len:
    s = str_new("hello world");
    out vtest_expect_eq_i64(str_len(s), 11);
end

func _test_str_len_empty:
    s = str_new("");
    out vtest_expect_eq_i64(str_len(s), 0);
end

func _test_str_eq_true:
    a = str_new("test");
    b = str_new("test");
    out vtest_expect_true(str_eq(a, b));
end

func _test_str_eq_false:
    a = str_new("test");
    b = str_new("TEST");
    out vtest_expect_false(str_eq(a, b));
end

func _test_str_cat:
    a = str_new("hello");
    b = str_new(" world");
    c = str_cat(a, b);
    out vtest_expect_eq_str(c, str_new("hello world"));
end

func _test_str_slice:
    s = str_new("hello world");
    sub = str_slice(s, 0, 5);
    out vtest_expect_eq_str(sub, str_new("hello"));
end

func _test_str_contains_true:
    s = str_new("hello world");
    out vtest_expect_true(str_contains(s, str_new("world")));
end

func _test_str_contains_false:
    s = str_new("hello world");
    out vtest_expect_false(str_contains(s, str_new("foo")));
end

func _test_str_starts_with:
    s = str_new("hello world");
    out vtest_expect_true(str_starts_with(s, str_new("hello")));
end

func _test_str_ends_with:
    s = str_new("hello world");
    out vtest_expect_true(str_ends_with(s, str_new("world")));
end

func _test_str_upper:
    s = str_new("hello");
    u = str_upper(s);
    out vtest_expect_eq_str(u, str_new("HELLO"));
end

func _test_str_lower:
    s = str_new("HELLO");
    l = str_lower(s);
    out vtest_expect_eq_str(l, str_new("hello"));
end

func _test_str_trim:
    s = str_new("  hello  ");
    t = str_trim(s);
    out vtest_expect_eq_str(t, str_new("hello"));
end

func _test_str_to_i64:
    s = str_new("12345");
    n = str_to_i64(s);
    out vtest_expect_eq_i64(n, 12345);
end

func _test_str_from_i64:
    n: i64 = 98765;
    s = str_from_i64(n);
    out vtest_expect_eq_str(s, str_new("98765"));
end

func _test_str_replace:
    s = str_new("hello world world");
    r = str_replace(s, str_new("world"), str_new("vir"));
    out vtest_expect_eq_str(r, str_new("hello vir vir"));
end


# ═══════════════════════════════════════════════════════════════════════════════
# SECTION 8: ARRAY OPERATIONS (Q_ARR_*)
# ═══════════════════════════════════════════════════════════════════════════════

func _test_arr_new:
    arr = vec_new();
    out vtest_expect_eq_i64(vec_len(arr), 0);
end

func _test_arr_push:
    arr = vec_new();
    vec_push(arr, 10);
    vec_push(arr, 20);
    vec_push(arr, 30);
    out vtest_expect_eq_i64(vec_len(arr), 3);
end

func _test_arr_get:
    arr = vec_new();
    vec_push(arr, 100);
    vec_push(arr, 200);
    vec_push(arr, 300);
    out vtest_expect_eq_i64(vec_get(arr, 1), 200);
end

func _test_arr_set:
    arr = vec_new();
    vec_push(arr, 10);
    vec_push(arr, 20);
    vec_set(arr, 0, 99);
    out vtest_expect_eq_i64(vec_get(arr, 0), 99);
end

func _test_arr_pop:
    arr = vec_new();
    vec_push(arr, 10);
    vec_push(arr, 20);
    v = vec_pop(arr);
    out vtest_expect_eq_i64(v, 20);
end

func _test_arr_len_after_pop:
    arr = vec_new();
    vec_push(arr, 10);
    vec_push(arr, 20);
    vec_pop(arr);
    out vtest_expect_eq_i64(vec_len(arr), 1);
end

func _test_arr_slice:
    arr = vec_new();
    vec_push(arr, 1);
    vec_push(arr, 2);
    vec_push(arr, 3);
    vec_push(arr, 4);
    vec_push(arr, 5);
    sub = vec_slice(arr, 1, 4);
    out vtest_expect_eq_i64(vec_len(sub), 3);
end

func _test_arr_insert:
    arr = vec_new();
    vec_push(arr, 1);
    vec_push(arr, 3);
    vec_insert(arr, 1, 2);
    if vec_get(arr, 0) == 1 and vec_get(arr, 1) == 2 and vec_get(arr, 2) == 3:
        out vtest_pass();
    end
    out vtest_fail();
end

func _test_arr_remove:
    arr = vec_new();
    vec_push(arr, 1);
    vec_push(arr, 2);
    vec_push(arr, 3);
    vec_remove(arr, 1);
    if vec_len(arr) == 2 and vec_get(arr, 1) == 3:
        out vtest_pass();
    end
    out vtest_fail();
end


# ═══════════════════════════════════════════════════════════════════════════════
# SECTION 9: MAP OPERATIONS (Q_MAP_*)
# ═══════════════════════════════════════════════════════════════════════════════

func _test_map_new:
    m = map_new();
    out vtest_expect_eq_i64(0, 0);  # Just verify no crash
end

func _test_map_set_get:
    m = map_new();
    map_set(m, str_new("key1"), 100);
    v = map_get(m, str_new("key1"));
    out vtest_expect_eq_i64(v, 100);
end

func _test_map_has_true:
    m = map_new();
    map_set(m, str_new("exists"), 1);
    out vtest_expect_true(map_has(m, str_new("exists")));
end

func _test_map_has_false:
    m = map_new();
    out vtest_expect_false(map_has(m, str_new("nonexistent")));
end

func _test_map_del:
    m = map_new();
    map_set(m, str_new("key"), 42);
    map_del(m, str_new("key"));
    out vtest_expect_false(map_has(m, str_new("key")));
end

func _test_map_overwrite:
    m = map_new();
    map_set(m, str_new("key"), 100);
    map_set(m, str_new("key"), 200);
    v = map_get(m, str_new("key"));
    out vtest_expect_eq_i64(v, 200);
end


# ═══════════════════════════════════════════════════════════════════════════════
# SECTION 10: TYPE CASTING (Q_CAST, Q_I_TO_F, Q_F_TO_I)
# ═══════════════════════════════════════════════════════════════════════════════

func _test_cast_i_to_f:
    i: i64 = 42;
    f: f64 = i >> f64;
    if f > 41.99 and f < 42.01:
        out vtest_pass();
    end
    out vtest_fail();
end

func _test_cast_f_to_i:
    f: f64 = 42.9;
    i: i64 = f >> i64;
    out vtest_expect_eq_i64(i, 42);
end

func _test_cast_f_to_i_negative:
    f: f64 = -42.9;
    i: i64 = f >> i64;
    out vtest_expect_eq_i64(i, -42);
end


# ═══════════════════════════════════════════════════════════════════════════════
# SECTION 11: ENTITY/STRUCT OPERATIONS (Q_ENTITY_NEW, Q_GET_FIELD, Q_SET_FIELD)
# ═══════════════════════════════════════════════════════════════════════════════

entity Point:
    x: i64;
    y: i64;
end

entity Rectangle:
    top_left: Point;
    width: i64;
    height: i64;
end

func _test_entity_new:
    p = Point { x: 10, y: 20 };
    out vtest_expect_eq_i64(p.x, 10);
end

func _test_entity_get_field:
    p = Point { x: 100, y: 200 };
    out vtest_expect_eq_i64(p.y, 200);
end

func _test_entity_set_field:
    p = Point { x: 10, y: 20 };
    p.x = 999;
    out vtest_expect_eq_i64(p.x, 999);
end

func _test_entity_nested:
    r = Rectangle {
        top_left: Point { x: 5, y: 10 },
        width: 100,
        height: 50,
    };
    out vtest_expect_eq_i64(r.top_left.x, 5);
end

func _test_entity_nested_set:
    r = Rectangle {
        top_left: Point { x: 5, y: 10 },
        width: 100,
        height: 50,
    };
    r.top_left.y = 999;
    out vtest_expect_eq_i64(r.top_left.y, 999);
end


# ═══════════════════════════════════════════════════════════════════════════════
# SECTION 12: ENUM/VARIANT OPERATIONS
# ═══════════════════════════════════════════════════════════════════════════════

enum Color:
    Red;
    Green;
    Blue;
    Custom(r: i64; g: i64; b: i64);
end

func _test_enum_simple:
    c = Color::Red;
    case c:
        case Color::Red:
            out vtest_pass();
        case _:
            out vtest_fail();
    end
end

func _test_enum_variant_data:
    c = Color::Custom(255, 128, 64);
    case c:
        case Color::Custom(r, g, b):
            if r == 255 and g == 128 and b == 64:
                out vtest_pass();
            end
            out vtest_fail();
        case _:
            out vtest_fail();
    end
end


# ═══════════════════════════════════════════════════════════════════════════════
# SECTION 13: MEMORY OPERATIONS (Q_ALLOC, Q_FREE, Q_LOAD_BYTE, Q_STORE_BYTE)
# ═══════════════════════════════════════════════════════════════════════════════

func _test_mem_array_large:
    # Test allocating and using a large array
    arr = vec_new();
    for i in 0..1000:
        vec_push(arr, i);
    end
    out vtest_expect_eq_i64(vec_len(arr), 1000);
end

func _test_mem_array_sum_large:
    arr = vec_new();
    for i in 0..100:
        vec_push(arr, i);
    end
    sum: i64 = 0;
    for i in 0..100:
        sum = sum + vec_get(arr, i);
    end
    # Sum of 0..99 = 99*100/2 = 4950
    out vtest_expect_eq_i64(sum, 4950);
end


# ═══════════════════════════════════════════════════════════════════════════════
# SECTION 14: FILE I/O (Q_FILE_*)
# ═══════════════════════════════════════════════════════════════════════════════

func _test_file_write_read:
    test_content = str_new("Engine conformance test content\n12345");
    test_path = str_new("/tmp/vir_engine_test.txt");
    
    # Write
    file_write(test_path, test_content);
    
    # Read back
    read_content = file_read(test_path);
    
    out vtest_expect_eq_str(read_content, test_content);
end

func _test_file_exists_true:
    test_path = str_new("/tmp/vir_engine_test.txt");
    file_write(test_path, str_new("exists"));
    out vtest_expect_true(file_exists(test_path));
end

func _test_file_exists_false:
    out vtest_expect_false(file_exists(str_new("/tmp/nonexistent_vir_test_xyz.txt")));
end


# ═══════════════════════════════════════════════════════════════════════════════
# SECTION 15: COMPLEX ALGORITHMS (Integration Tests)
# ═══════════════════════════════════════════════════════════════════════════════

func _test_algo_fibonacci:
    # Fib(20) = 6765
    fib_prev: i64 = 0;
    fib_curr: i64 = 1;
    for i in 0..19:
        temp = fib_curr;
        fib_curr = fib_prev + fib_curr;
        fib_prev = temp;
    end
    out vtest_expect_eq_i64(fib_curr, 6765);
end

func _test_algo_prime_check:
    # Check if 97 is prime
    n: i64 = 97;
    is_prime: i64 = 1;
    for i in 2..10:  # sqrt(97) < 10
        if n % i == 0:
            is_prime = 0;
        end
    end
    out vtest_expect_eq_i64(is_prime, 1);
end

func _test_algo_bubble_sort:
    arr = vec_new();
    vec_push(arr, 5);
    vec_push(arr, 2);
    vec_push(arr, 8);
    vec_push(arr, 1);
    vec_push(arr, 9);
    
    n = vec_len(arr);
    for i in 0..n:
        for j in 0..(n - i - 1):
            if vec_get(arr, j) > vec_get(arr, j + 1):
                temp = vec_get(arr, j);
                vec_set(arr, j, vec_get(arr, j + 1));
                vec_set(arr, j + 1, temp);
            end
        end
    end
    
    # Check sorted: [1, 2, 5, 8, 9]
    if vec_get(arr, 0) == 1 and vec_get(arr, 1) == 2 and vec_get(arr, 2) == 5:
        if vec_get(arr, 3) == 8 and vec_get(arr, 4) == 9:
            out vtest_pass();
        end
    end
    out vtest_fail();
end

func _test_algo_gcd:
    # GCD of 48 and 18 = 6
    a: i64 = 48;
    b: i64 = 18;
    while b != 0:
        temp = b;
        b = a % b;
        a = temp;
    end
    out vtest_expect_eq_i64(a, 6);
end

func _test_algo_power_iterative:
    # 2^10 = 1024
    base: i64 = 2;
    exp: i64 = 10;
    result: i64 = 1;
    while exp > 0:
        if exp % 2 == 1:
            result = result * base;
        end
        base = base * base;
        exp = exp / 2;
    end
    out vtest_expect_eq_i64(result, 1024);
end


# ═══════════════════════════════════════════════════════════════════════════════
# SECTION 16: EDGE CASES
# ═══════════════════════════════════════════════════════════════════════════════

func _test_edge_zero_operations:
    # 0 + 0, 0 * anything, 0 / nonzero
    out vtest_expect_eq_i64(0 + 0, 0);
end

func _test_edge_zero_mul:
    out vtest_expect_eq_i64(0 * 99999, 0);
end

func _test_edge_zero_div:
    out vtest_expect_eq_i64(0 / 42, 0);
end

func _test_edge_identity_add:
    x: i64 = 12345;
    out vtest_expect_eq_i64(x + 0, x);
end

func _test_edge_identity_mul:
    x: i64 = 12345;
    out vtest_expect_eq_i64(x * 1, x);
end

func _test_edge_self_sub:
    x: i64 = 99999;
    out vtest_expect_eq_i64(x - x, 0);
end

func _test_edge_self_div:
    x: i64 = 99999;
    out vtest_expect_eq_i64(x / x, 1);
end

func _test_edge_empty_string:
    s = str_new("");
    out vtest_expect_eq_i64(str_len(s), 0);
end

func _test_edge_empty_array:
    arr = vec_new();
    out vtest_expect_eq_i64(vec_len(arr), 0);
end

func _test_edge_single_element_array:
    arr = vec_new();
    vec_push(arr, 42);
    if vec_len(arr) == 1 and vec_get(arr, 0) == 42:
        out vtest_pass();
    end
    out vtest_fail();
end


# ═══════════════════════════════════════════════════════════════════════════════
# SECTION 17: UNICODE AND SPECIAL CHARACTERS
# ═══════════════════════════════════════════════════════════════════════════════

func _test_unicode_basic:
    s = str_new("Xin chào Việt Nam");
    # Just verify it doesn't crash and has non-zero length
    if str_len(s) > 0:
        out vtest_pass();
    end
    out vtest_fail();
end

func _test_unicode_chinese:
    s = str_new("你好世界");
    if str_len(s) > 0:
        out vtest_pass();
    end
    out vtest_fail();
end

func _test_special_chars:
    s = str_new("tab:\there newline:\nquote:\"done");
    if str_len(s) > 0:
        out vtest_pass();
    end
    out vtest_fail();
end


# ═══════════════════════════════════════════════════════════════════════════════
# SUITE REGISTRATION
# ═══════════════════════════════════════════════════════════════════════════════

func vtest_engine_conformance_suite -> VTestRegistry:
    suite = vtest_suite_new(str_new("engine conformance"));
    
    # Section 1: Arithmetic
    suite = vtest_add(suite, str_new("arith add i64"), _test_arith_add_i64);
    suite = vtest_add(suite, str_new("arith add negative"), _test_arith_add_negative);
    suite = vtest_add(suite, str_new("arith add overflow"), _test_arith_add_overflow);
    suite = vtest_add(suite, str_new("arith sub"), _test_arith_sub);
    suite = vtest_add(suite, str_new("arith sub negative result"), _test_arith_sub_negative_result);
    suite = vtest_add(suite, str_new("arith mul"), _test_arith_mul);
    suite = vtest_add(suite, str_new("arith mul negative"), _test_arith_mul_negative);
    suite = vtest_add(suite, str_new("arith div"), _test_arith_div);
    suite = vtest_add(suite, str_new("arith div truncate"), _test_arith_div_truncate);
    suite = vtest_add(suite, str_new("arith mod"), _test_arith_mod);
    suite = vtest_add(suite, str_new("arith mod negative"), _test_arith_mod_negative);
    
    # Section 2: Float
    suite = vtest_add(suite, str_new("float add"), _test_float_add);
    suite = vtest_add(suite, str_new("float sub"), _test_float_sub);
    suite = vtest_add(suite, str_new("float mul"), _test_float_mul);
    suite = vtest_add(suite, str_new("float div"), _test_float_div);
    
    # Section 3: Math
    suite = vtest_add(suite, str_new("math sqrt"), _test_math_sqrt);
    suite = vtest_add(suite, str_new("math sqrt non perfect"), _test_math_sqrt_non_perfect);
    suite = vtest_add(suite, str_new("math abs positive"), _test_math_abs_positive);
    suite = vtest_add(suite, str_new("math abs negative"), _test_math_abs_negative);
    suite = vtest_add(suite, str_new("math pow"), _test_math_pow);
    suite = vtest_add(suite, str_new("math sin zero"), _test_math_sin_zero);
    suite = vtest_add(suite, str_new("math cos zero"), _test_math_cos_zero);
    suite = vtest_add(suite, str_new("math min"), _test_math_min);
    suite = vtest_add(suite, str_new("math max"), _test_math_max);
    
    # Section 4: Comparisons
    suite = vtest_add(suite, str_new("cmp eq true"), _test_cmp_eq_true);
    suite = vtest_add(suite, str_new("cmp eq false"), _test_cmp_eq_false);
    suite = vtest_add(suite, str_new("cmp ne"), _test_cmp_ne);
    suite = vtest_add(suite, str_new("cmp gt"), _test_cmp_gt);
    suite = vtest_add(suite, str_new("cmp lt"), _test_cmp_lt);
    suite = vtest_add(suite, str_new("cmp ge greater"), _test_cmp_ge_greater);
    suite = vtest_add(suite, str_new("cmp ge equal"), _test_cmp_ge_equal);
    suite = vtest_add(suite, str_new("cmp le less"), _test_cmp_le_less);
    suite = vtest_add(suite, str_new("cmp le equal"), _test_cmp_le_equal);
    
    # Section 5: Bitwise
    suite = vtest_add(suite, str_new("bit and"), _test_bit_and);
    suite = vtest_add(suite, str_new("bit or"), _test_bit_or);
    suite = vtest_add(suite, str_new("bit xor"), _test_bit_xor);
    suite = vtest_add(suite, str_new("bit shl"), _test_bit_shl);
    suite = vtest_add(suite, str_new("bit shr"), _test_bit_shr);
    suite = vtest_add(suite, str_new("bit not"), _test_bit_not);
    
    # Section 6: Control Flow
    suite = vtest_add(suite, str_new("ctrl call ret"), _test_ctrl_call_ret);
    suite = vtest_add(suite, str_new("ctrl if true branch"), _test_ctrl_if_true_branch);
    suite = vtest_add(suite, str_new("ctrl if false branch"), _test_ctrl_if_false_branch);
    suite = vtest_add(suite, str_new("ctrl while loop"), _test_ctrl_while_loop);
    suite = vtest_add(suite, str_new("ctrl for loop"), _test_ctrl_for_loop);
    suite = vtest_add(suite, str_new("ctrl nested loops"), _test_ctrl_nested_loops);
    suite = vtest_add(suite, str_new("ctrl recursion"), _test_ctrl_recursion);
    
    # Section 7: Strings
    suite = vtest_add(suite, str_new("str new"), _test_str_new);
    suite = vtest_add(suite, str_new("str len"), _test_str_len);
    suite = vtest_add(suite, str_new("str len empty"), _test_str_len_empty);
    suite = vtest_add(suite, str_new("str eq true"), _test_str_eq_true);
    suite = vtest_add(suite, str_new("str eq false"), _test_str_eq_false);
    suite = vtest_add(suite, str_new("str cat"), _test_str_cat);
    suite = vtest_add(suite, str_new("str slice"), _test_str_slice);
    suite = vtest_add(suite, str_new("str contains true"), _test_str_contains_true);
    suite = vtest_add(suite, str_new("str contains false"), _test_str_contains_false);
    suite = vtest_add(suite, str_new("str starts with"), _test_str_starts_with);
    suite = vtest_add(suite, str_new("str ends with"), _test_str_ends_with);
    suite = vtest_add(suite, str_new("str upper"), _test_str_upper);
    suite = vtest_add(suite, str_new("str lower"), _test_str_lower);
    suite = vtest_add(suite, str_new("str trim"), _test_str_trim);
    suite = vtest_add(suite, str_new("str to i64"), _test_str_to_i64);
    suite = vtest_add(suite, str_new("str from i64"), _test_str_from_i64);
    suite = vtest_add(suite, str_new("str replace"), _test_str_replace);
    
    # Section 8: Arrays
    suite = vtest_add(suite, str_new("arr new"), _test_arr_new);
    suite = vtest_add(suite, str_new("arr push"), _test_arr_push);
    suite = vtest_add(suite, str_new("arr get"), _test_arr_get);
    suite = vtest_add(suite, str_new("arr set"), _test_arr_set);
    suite = vtest_add(suite, str_new("arr pop"), _test_arr_pop);
    suite = vtest_add(suite, str_new("arr len after pop"), _test_arr_len_after_pop);
    suite = vtest_add(suite, str_new("arr slice"), _test_arr_slice);
    suite = vtest_add(suite, str_new("arr insert"), _test_arr_insert);
    suite = vtest_add(suite, str_new("arr remove"), _test_arr_remove);
    
    # Section 9: Maps
    suite = vtest_add(suite, str_new("map new"), _test_map_new);
    suite = vtest_add(suite, str_new("map set get"), _test_map_set_get);
    suite = vtest_add(suite, str_new("map has true"), _test_map_has_true);
    suite = vtest_add(suite, str_new("map has false"), _test_map_has_false);
    suite = vtest_add(suite, str_new("map del"), _test_map_del);
    suite = vtest_add(suite, str_new("map overwrite"), _test_map_overwrite);
    
    # Section 10: Type Casting
    suite = vtest_add(suite, str_new("cast i to f"), _test_cast_i_to_f);
    suite = vtest_add(suite, str_new("cast f to i"), _test_cast_f_to_i);
    suite = vtest_add(suite, str_new("cast f to i negative"), _test_cast_f_to_i_negative);
    
    # Section 11: Entities
    suite = vtest_add(suite, str_new("entity new"), _test_entity_new);
    suite = vtest_add(suite, str_new("entity get field"), _test_entity_get_field);
    suite = vtest_add(suite, str_new("entity set field"), _test_entity_set_field);
    suite = vtest_add(suite, str_new("entity nested"), _test_entity_nested);
    suite = vtest_add(suite, str_new("entity nested set"), _test_entity_nested_set);
    
    # Section 12: Enums
    suite = vtest_add(suite, str_new("enum simple"), _test_enum_simple);
    suite = vtest_add(suite, str_new("enum variant data"), _test_enum_variant_data);
    
    # Section 13: Memory
    suite = vtest_add(suite, str_new("mem array large"), _test_mem_array_large);
    suite = vtest_add(suite, str_new("mem array sum large"), _test_mem_array_sum_large);
    
    # Section 14: File I/O
    suite = vtest_add(suite, str_new("file write read"), _test_file_write_read);
    suite = vtest_add(suite, str_new("file exists true"), _test_file_exists_true);
    suite = vtest_add(suite, str_new("file exists false"), _test_file_exists_false);
    
    # Section 15: Algorithms
    suite = vtest_add(suite, str_new("algo fibonacci"), _test_algo_fibonacci);
    suite = vtest_add(suite, str_new("algo prime check"), _test_algo_prime_check);
    suite = vtest_add(suite, str_new("algo bubble sort"), _test_algo_bubble_sort);
    suite = vtest_add(suite, str_new("algo gcd"), _test_algo_gcd);
    suite = vtest_add(suite, str_new("algo power iterative"), _test_algo_power_iterative);
    
    # Section 16: Edge Cases
    suite = vtest_add(suite, str_new("edge zero operations"), _test_edge_zero_operations);
    suite = vtest_add(suite, str_new("edge zero mul"), _test_edge_zero_mul);
    suite = vtest_add(suite, str_new("edge zero div"), _test_edge_zero_div);
    suite = vtest_add(suite, str_new("edge identity add"), _test_edge_identity_add);
    suite = vtest_add(suite, str_new("edge identity mul"), _test_edge_identity_mul);
    suite = vtest_add(suite, str_new("edge self sub"), _test_edge_self_sub);
    suite = vtest_add(suite, str_new("edge self div"), _test_edge_self_div);
    suite = vtest_add(suite, str_new("edge empty string"), _test_edge_empty_string);
    suite = vtest_add(suite, str_new("edge empty array"), _test_edge_empty_array);
    suite = vtest_add(suite, str_new("edge single element array"), _test_edge_single_element_array);
    
    # Section 17: Unicode
    suite = vtest_add(suite, str_new("unicode basic"), _test_unicode_basic);
    suite = vtest_add(suite, str_new("unicode chinese"), _test_unicode_chinese);
    suite = vtest_add(suite, str_new("special chars"), _test_special_chars);
    
    out suite;
end

func vtest_engine_conformance_run:
    reg = vtest_registry_new();
    reg = vtest_registry_add_suite(reg, vtest_engine_conformance_suite());
    result = vtest_registry_run(reg);
    vtest_print_summary(result);
    exit(vtest_exit_code(result));
end

func main:
    vtest_engine_conformance_run();
end
