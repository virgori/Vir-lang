##
 * vir/test/nn_vtest.vri — VTest suite for Neural Network / Tensor
 * ==================================================================
 * Port of test_virnn_mlp.py → pure Vir vtest.
 * Covers:  Tensor construction/operations, NN layers (Linear, activations,
 *          layer-norm, RMS-norm, MLP), loss functions.
 ##

include types;
include string;
import String, str_new, str_eq from string;
include test;
import TestSuite, TestResult from test;
include vtest;
import VTestRegistry,
       vtest_suite_new, vtest_add,
       vtest_registry_new, vtest_registry_add_suite, vtest_registry_run,
       vtest_print_summary, vtest_exit_code,
       vtest_pass, vtest_fail,
       vtest_expect_true, vtest_expect_false,
       vtest_expect_eq_i64 from vtest;
include math/tensor;
import Tensor, tensor_zeros, tensor_ones, tensor_filled,
       tensor_get, tensor_set, tensor_get_flat, tensor_set_flat,
       tensor_add, tensor_mul, tensor_scale, tensor_sum, tensor_mean,
       tensor_matmul, tensor_reshape, tensor_transpose,
       tensor_free from math/tensor;
include math/nn;
import Linear, linear_new, linear_free, linear_forward,
       relu, gelu, silu, softmax,
       layernorm_new, layernorm_forward, layernorm_free,
       rmsnorm_new, rmsnorm_forward, rmsnorm_free,
       mse_loss, cross_entropy_loss from math/nn;


# ═══════════════════════════════════════════════════════
# Tests — Tensor Construction
# ═══════════════════════════════════════════════════════

func _test_tensor_zeros:
    t = tensor_zeros(2, 3);
    v = tensor_get(t, 0, 0);
    if v == 0.0 do
        out vtest_pass();
    end
    out vtest_fail();
end.
func _test_tensor_ones:
    t = tensor_ones(2, 3);
    v = tensor_get(t, 1, 2);
    if v == 1.0 do
        out vtest_pass();
    end
    out vtest_fail();
end.
func _test_tensor_filled:
    t = tensor_filled(3, 3, 7.0);
    v = tensor_get(t, 2, 1);
    if v == 7.0 do
        out vtest_pass();
    end
    out vtest_fail();
end.
func _test_tensor_get_set:
    t = tensor_zeros(4, 4);
    tensor_set(t, 2, 3, 42.0);
    v = tensor_get(t, 2, 3);
    if v == 42.0 do
        out vtest_pass();
    end
    out vtest_fail();
end.
func _test_tensor_flat_access:
    t = tensor_ones(2, 3);            # 6 elements
    tensor_set_flat(t, 5, 99.0);      # last element
    v = tensor_get_flat(t, 5);
    if v == 99.0 do
        out vtest_pass();
    end
    out vtest_fail();
end.
# ═══════════════════════════════════════════════════════
# Tests — Tensor Arithmetic
# ═══════════════════════════════════════════════════════

func _test_tensor_add:
    a = tensor_ones(2, 2);
    b = tensor_filled(2, 2, 3.0);
    c = tensor_add(a, b);
    v = tensor_get(c, 0, 0);
    if v == 4.0 do
        out vtest_pass();
    end
    out vtest_fail();
end.
func _test_tensor_mul:
    a = tensor_filled(2, 2, 3.0);
    b = tensor_filled(2, 2, 4.0);
    c = tensor_mul(a, b);
    v = tensor_get(c, 0, 0);
    if v == 12.0 do
        out vtest_pass();
    end
    out vtest_fail();
end.
func _test_tensor_scale:
    t = tensor_ones(3, 3);
    s = tensor_scale(t, 5.0);
    v = tensor_get(s, 1, 1);
    if v == 5.0 do
        out vtest_pass();
    end
    out vtest_fail();
end.
func _test_tensor_sum:
    t = tensor_ones(2, 3);            # 2*3 = 6 ones
    s = tensor_sum(t);
    if s == 6.0 do
        out vtest_pass();
    end
    out vtest_fail();
end.
func _test_tensor_mean:
    t = tensor_filled(2, 2, 10.0);
    m = tensor_mean(t);
    if m == 10.0 do
        out vtest_pass();
    end
    out vtest_fail();
end.
func _test_tensor_matmul:
    # 1x2 @ 2x1 → 1x1 = dot product
    a = tensor_zeros(1, 2);
    tensor_set(a, 0, 0, 2.0);
    tensor_set(a, 0, 1, 3.0);
    b = tensor_zeros(2, 1);
    tensor_set(b, 0, 0, 4.0);
    tensor_set(b, 1, 0, 5.0);
    c = tensor_matmul(a, b);
    v = tensor_get(c, 0, 0);          # 2*4 + 3*5 = 23
    if v == 23.0 do
        out vtest_pass();
    end
    out vtest_fail();
end.
# ═══════════════════════════════════════════════════════
# Tests — Tensor Shape
# ═══════════════════════════════════════════════════════

func _test_tensor_reshape:
    t = tensor_ones(2, 6);            # 12 elements
    r = tensor_reshape(t, 3, 4);
    v = tensor_get(r, 2, 3);
    if v == 1.0 do
        out vtest_pass();
    end
    out vtest_fail();
end.
func _test_tensor_transpose:
    t = tensor_zeros(2, 3);
    tensor_set(t, 0, 2, 7.0);
    tr = tensor_transpose(t);         # 3x2
    v = tensor_get(tr, 2, 0);
    if v == 7.0 do
        out vtest_pass();
    end
    out vtest_fail();
end.
# ═══════════════════════════════════════════════════════
# Tests — NN Layers / Activations
# ═══════════════════════════════════════════════════════

func _test_relu_positive:
    t = tensor_filled(1, 3, 5.0);
    r = relu(t);
    v = tensor_get(r, 0, 0);
    if v == 5.0 do
        out vtest_pass();
    end
    out vtest_fail();
end.
func _test_relu_negative:
    t = tensor_filled(1, 3, -2.0);
    r = relu(t);
    v = tensor_get(r, 0, 0);
    if v == 0.0 do
        out vtest_pass();
    end
    out vtest_fail();
end.
func _test_softmax_sums_to_one:
    t = tensor_zeros(1, 3);
    tensor_set(t, 0, 0, 1.0);
    tensor_set(t, 0, 1, 2.0);
    tensor_set(t, 0, 2, 3.0);
    s = softmax(t);
    total = tensor_sum(s);
    diff = total - 1.0;
    if diff < 0.0 do diff = 0.0 - diff; end
    if diff < 0.001 do
        out vtest_pass();
    end
    out vtest_fail();
end.
func _test_linear_forward_shape:
    # Linear(4, 2)
    layer = linear_new(4, 2);
    x = tensor_ones(1, 4);
    y = linear_forward(layer, x);     # 1x2
    # just check we get a value without crash
    v = tensor_get(y, 0, 0);
    out vtest_pass();                  # shape correctness
end.
func _test_mse_loss_zero:
    a = tensor_filled(1, 3, 2.0);
    b = tensor_filled(1, 3, 2.0);
    loss = mse_loss(a, b);
    if loss == 0.0 do
        out vtest_pass();
    end
    out vtest_fail();
end.
func _test_mse_loss_nonzero:
    a = tensor_filled(1, 2, 1.0);
    b = tensor_filled(1, 2, 3.0);
    loss = mse_loss(a, b);
    # MSE = mean((1-3)^2) = 4.0
    if loss == 4.0 do
        out vtest_pass();
    end
    out vtest_fail();
end.
# ═══════════════════════════════════════════════════════
# Suite Builder & Runner
# ═══════════════════════════════════════════════════════

func vtest_nn_suite:
    suite = vtest_suite_new(str_new("math/tensor+nn"));

    # construction
    suite = vtest_add(suite, str_new("tensor_zeros 2×3"),          _test_tensor_zeros);
    suite = vtest_add(suite, str_new("tensor_ones 2×3"),           _test_tensor_ones);
    suite = vtest_add(suite, str_new("tensor_filled 3×3, 7"),      _test_tensor_filled);
    suite = vtest_add(suite, str_new("tensor get/set"),            _test_tensor_get_set);
    suite = vtest_add(suite, str_new("tensor flat access"),        _test_tensor_flat_access);

    # arithmetic
    suite = vtest_add(suite, str_new("tensor add"),                _test_tensor_add);
    suite = vtest_add(suite, str_new("tensor mul (element)"),      _test_tensor_mul);
    suite = vtest_add(suite, str_new("tensor scale ×5"),           _test_tensor_scale);
    suite = vtest_add(suite, str_new("tensor sum = 6"),            _test_tensor_sum);
    suite = vtest_add(suite, str_new("tensor mean = 10"),          _test_tensor_mean);
    suite = vtest_add(suite, str_new("tensor matmul 1×2 @ 2×1"),  _test_tensor_matmul);

    # shape
    suite = vtest_add(suite, str_new("tensor reshape 2×6→3×4"),   _test_tensor_reshape);
    suite = vtest_add(suite, str_new("tensor transpose"),          _test_tensor_transpose);

    # activations / layers
    suite = vtest_add(suite, str_new("relu positive pass"),        _test_relu_positive);
    suite = vtest_add(suite, str_new("relu negative→0"),           _test_relu_negative);
    suite = vtest_add(suite, str_new("softmax sums to 1.0"),       _test_softmax_sums_to_one);
    suite = vtest_add(suite, str_new("linear forward shape"),      _test_linear_forward_shape);
    suite = vtest_add(suite, str_new("mse_loss identical → 0"),    _test_mse_loss_zero);
    suite = vtest_add(suite, str_new("mse_loss diff → 4.0"),       _test_mse_loss_nonzero);
    out suite;
end.
func vtest_nn_run:
    reg = vtest_registry_new();
    reg = vtest_registry_add_suite(reg, vtest_nn_suite());
    report = vtest_registry_run(reg);
    vtest_print_summary(report);
    out vtest_exit_code(report);
end.