# ═══════════════════════════════════════════════════════

func _test_strength_reduce_mul_pow2:
    # Mul v0 * 8 → should become Shl v0, 3
    body = vec_new<QInstruction>();
    vec_push(body, _instr(QOp::Load, _vreg(0), _imm(42), _none_op()));
    vec_push(body, _instr(QOp::Load, _vreg(1), _imm(8),  _none_op()));
    vec_push(body, _instr(QOp::Mul,  _vreg(2), _vreg(0), _vreg(1)));
    vec_push(body, _instr(QOp::Ret,  _none_op(), _vreg(2), _none_op()));
    f = _make_func(str_new("sr_mul8"), body);
    var (f2, changes) = opt_strength_reduce(f);
    if changes > 0:
        out vtest_pass();
    end
    out vtest_fail();
end


# ═══════════════════════════════════════════════════════
# Tests — Dead Code Elimination
# ═══════════════════════════════════════════════════════

func _test_dce_removes_unused:
    # Load 99 → v5 (never used afterward) ⟹ DCE should remove it
    body = vec_new<QInstruction>();
    vec_push(body, _instr(QOp::Load, _vreg(0), _imm(1), _none_op()));
    vec_push(body, _instr(QOp::Load, _vreg(5), _imm(99), _none_op()));  # dead
    vec_push(body, _instr(QOp::Ret,  _none_op(), _vreg(0), _none_op()));
    f = _make_func(str_new("dce_dead"), body);
    var (f2, removed) = opt_dce(f);
    if removed > 0:
        out vtest_pass();
    end
    out vtest_fail();
end


# ═══════════════════════════════════════════════════════
# Tests — Copy Propagation
# ═══════════════════════════════════════════════════════

func _test_copy_prop_basic:
    # Load 7 → v0, Move v0 → v1, Add v1+v1 → v2 ⟹ v1 replaced by v0 in Add
    body = vec_new<QInstruction>();
    vec_push(body, _instr(QOp::Load, _vreg(0), _imm(7),    _none_op()));
    vec_push(body, _instr(QOp::Move, _vreg(1), _vreg(0),   _none_op()));
    vec_push(body, _instr(QOp::Add,  _vreg(2), _vreg(1),   _vreg(1)));
    vec_push(body, _instr(QOp::Ret,  _none_op(), _vreg(2), _none_op()));
    f = _make_func(str_new("cp_basic"), body);
    var (f2, changes) = opt_copy_propagate(f);
    if changes > 0:
        out vtest_pass();
    end
    out vtest_fail();
end


# ═══════════════════════════════════════════════════════
# Tests — BCE Analysis (conservative)
# ═══════════════════════════════════════════════════════

func _test_bce_no_loops_zero:
    # Straight-line code: no loops ⟹ safe_accesses == 0
    body = vec_new<QInstruction>();
    vec_push(body, _instr(QOp::Load, _vreg(0), _imm(1), _none_op()));
    vec_push(body, _instr(QOp::Ret,  _none_op(), _vreg(0), _none_op()));
    f = _make_func(str_new("bce_none"), body);
    var (f2, safe) = opt_bce(f);
    out vtest_expect_eq_i64(safe, 0);
end


# ═══════════════════════════════════════════════════════
# Tests — Escape Analysis (conservative)
# ═══════════════════════════════════════════════════════

func _test_escape_no_alloc_zero:
    # No Alloc instructions ⟹ promotable == 0
    body = vec_new<QInstruction>();
    vec_push(body, _instr(QOp::Load, _vreg(0), _imm(1), _none_op()));
    vec_push(body, _instr(QOp::Ret,  _none_op(), _vreg(0), _none_op()));
    f = _make_func(str_new("esc_none"), body);
    var (f2, promotable) = opt_escape_analysis(f);
    out vtest_expect_eq_i64(promotable, 0);
end

func _test_escape_local_alloc_promotable:
    # Alloc → v0, use locally, never escape to Store/Ret/Call ⟹ promotable >= 1
    body = vec_new<QInstruction>();
    vec_push(body, _instr(QOp::Alloc, _vreg(0), _imm(64), _none_op()));
    vec_push(body, _instr(QOp::Load,  _vreg(1), _imm(42), _none_op()));
    vec_push(body, _instr(QOp::Ret,   _none_op(), _vreg(1), _none_op()));
    f = _make_func(str_new("esc_local"), body);
    var (f2, promotable) = opt_escape_analysis(f);
    if promotable > 0:
        out vtest_pass();
    end
    out vtest_fail();
end


# ═══════════════════════════════════════════════════════
# Tests — Deterministic Free Insertion
# ═══════════════════════════════════════════════════════

func _test_det_free_inserts:
    # Alloc → v0, never freed ⟹ det_free pass inserts Free before Ret
    body = vec_new<QInstruction>();
    vec_push(body, _instr(QOp::Alloc, _vreg(0), _imm(32), _none_op()));
    vec_push(body, _instr(QOp::Load,  _vreg(1), _imm(1),  _none_op()));
    vec_push(body, _instr(QOp::Ret,   _none_op(), _vreg(1), _none_op()));
    f = _make_func(str_new("detfree"), body);
    var (f2, inserted) = opt_deterministic_free(f);
    if inserted > 0:
        out vtest_pass();
    end
    out vtest_fail();
end


# ═══════════════════════════════════════════════════════
# Tests — OptStats Entity
# ═══════════════════════════════════════════════════════

func _test_opt_stats_new_zero:
    s = opt_stats_new();
    out vtest_expect_eq_i64(opt_stats_total_changes(s), 0);
end

func _test_opt_stats_merge:
    a = opt_stats_new();
    a.const_fold = 3;
    a.dce = 5;
    b = opt_stats_new();
    b.const_fold = 2;
    b.bce_safe = 4;
    merged = opt_stats_merge(a, b);
    if merged.const_fold == 5 and merged.dce == 5 and merged.bce_safe == 4:
        out vtest_pass();
    end
    out vtest_fail();
end


# ═══════════════════════════════════════════════════════
# Tests — Full Pipeline Smoke (optimize_function_stats)
# ═══════════════════════════════════════════════════════

func _test_full_pipeline_smoke:
    # Build a small function and run the full 12-pass pipeline with stats
    body = vec_new<QInstruction>();
    vec_push(body, _instr(QOp::Load, _vreg(0), _imm(10), _none_op()));
    vec_push(body, _instr(QOp::Load, _vreg(1), _imm(20), _none_op()));
    vec_push(body, _instr(QOp::Add,  _vreg(2), _vreg(0), _vreg(1)));
    vec_push(body, _instr(QOp::Load, _vreg(3), _imm(99), _none_op()));  # dead
    vec_push(body, _instr(QOp::Ret,  _none_op(), _vreg(2), _none_op()));
    f = _make_func(str_new("pipeline_smoke"), body);
    funcs = vec_new<QFunction>();
    vec_push(funcs, f);
    mod = _make_module(funcs);
    var (f2, stats) = optimize_function_stats(f, mod);
    # Expect at least const_fold or dce to fire
    total = opt_stats_total_changes(stats);
    if total > 0:
        out vtest_pass();
    end
    out vtest_fail();
end


