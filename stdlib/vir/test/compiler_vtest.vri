##
 * vir/test/compiler_vtest.vri — VTest smoke suite for Compiler / Optimizer / Pipeline
 * ===================================================================================
 * Compiler-focused vtest suite covering:
 *   - Q-IR construction & basic lowering
 *   - Optimizer passes (const fold, CSE, strength reduction, DCE, …)
 *   - BCE / Escape Analysis analysis counters
 *   - Full pipeline smoke (H→M→L)
 *
 * Thay thế dần các test tương ứng trong pytest (test_phase3, test_phase_i, …)
 ##

include types;
include string;
import String, str_new, str_eq from string;
include vec;
import Vec, vec_new, vec_push, vec_len, vec_get, vec_set from vec;
include test;
import TestSuite, TestResult from test;
include vtest;
import VTestRegistry,
       vtest_suite_new, vtest_add,
       vtest_registry_new, vtest_registry_add_suite, vtest_registry_run,
       vtest_print_summary, vtest_exit_code,
       vtest_pass, vtest_fail,
       vtest_expect_true, vtest_expect_false,
       vtest_expect_eq_i64, vtest_expect_ne_i64 from vtest;
include ir_optimizer;
import QOp, QModule, QFunction, QInstruction, Operand, OperandType,
       OptStats, opt_stats_new, opt_stats_merge, opt_stats_total_changes,
       optimize_function_stats,
       opt_copy_propagate, opt_const_fold, opt_cse,
       opt_strength_reduce, opt_licm, opt_bce, opt_escape_analysis,
       opt_deterministic_free, opt_loop_unroll, opt_vectorize, opt_dce from ir_optimizer;


# ═══════════════════════════════════════════════════════
# Helpers — build minimal Q-IR fragments for testing
# ═══════════════════════════════════════════════════════

func _vreg:
    in(id:int)
    out Operand { op_type: OperandType::VReg, vreg: id, imm: 0, patch_id: 0 };
end

func _imm:
    in(val:int)
    out Operand { op_type: OperandType::Immediate, vreg: 0, imm: val, patch_id: 0 };
end

func _none_op:
    out Operand { op_type: OperandType::None, vreg: 0, imm: 0, patch_id: 0 };
end

func _label_ref:
    in(id:int)
    out Operand { op_type: OperandType::LabelRef, vreg: id, imm: 0, patch_id: 0 };
end

func _instr:
    in(op:int; dest:Operand; src1:Operand; src2:Operand)
    out QInstruction { opcode: op, dest: dest, src1: src1, src2: src2, patch_id: 0 };
end

func _make_func:
    in(name:string; body:Vec<QInstruction>)
    out QFunction { name: name, body: body, param_count: 0, local_count: 8 };
end

func _make_module:
    in(funcs:Vec<QFunction>)
    out QModule { functions: funcs, name: str_new("test_mod") };
end


# ═══════════════════════════════════════════════════════
# Tests — Constant Folding
# ═══════════════════════════════════════════════════════

func _test_const_fold_add:
    # Load 10 → v0, Load 20 → v1, Add v0+v1 → v2  ⟹  v2 should fold to 30
    body = vec_new<QInstruction>();
    vec_push(body, _instr(QOp::Load, _vreg(0), _imm(10), _none_op()));
    vec_push(body, _instr(QOp::Load, _vreg(1), _imm(20), _none_op()));
    vec_push(body, _instr(QOp::Add,  _vreg(2), _vreg(0), _vreg(1)));
    vec_push(body, _instr(QOp::Ret,  _none_op(), _vreg(2), _none_op()));
    f = _make_func(str_new("fold_add"), body);
    var (f2, changes) = opt_const_fold(f);
    # Constant folding should produce ≥1 change (the Add folded)
    if changes > 0:
        out vtest_pass();
    end
    out vtest_fail();
end


# ═══════════════════════════════════════════════════════
# Tests — Common Subexpression Elimination
# ═══════════════════════════════════════════════════════

func _test_cse_duplicate_add:
    # Add v0+v1 → v2, Add v0+v1 → v3  ⟹  second Add should be replaced by Move
    body = vec_new<QInstruction>();
    vec_push(body, _instr(QOp::Load, _vreg(0), _imm(5), _none_op()));
    vec_push(body, _instr(QOp::Load, _vreg(1), _imm(7), _none_op()));
    vec_push(body, _instr(QOp::Add,  _vreg(2), _vreg(0), _vreg(1)));
    vec_push(body, _instr(QOp::Add,  _vreg(3), _vreg(0), _vreg(1)));
    vec_push(body, _instr(QOp::Ret,  _none_op(), _vreg(3), _none_op()));
    f = _make_func(str_new("cse_dup"), body);
    var (f2, changes) = opt_cse(f);
    if changes > 0:
        out vtest_pass();
    end
    out vtest_fail();
end

func _test_cse_different_operands_not_eliminated:
    # Add v0+v1 → v3, Add v0+v2 → v4 (different src2) ⟹ both Adds should remain
    body = vec_new<QInstruction>();
    vec_push(body, _instr(QOp::Load, _vreg(0), _imm(5), _none_op()));
    vec_push(body, _instr(QOp::Load, _vreg(1), _imm(7), _none_op()));
    vec_push(body, _instr(QOp::Load, _vreg(2), _imm(9), _none_op()));
    vec_push(body, _instr(QOp::Add,  _vreg(3), _vreg(0), _vreg(1)));
    vec_push(body, _instr(QOp::Add,  _vreg(4), _vreg(0), _vreg(2)));
    vec_push(body, _instr(QOp::Ret,  _none_op(), _vreg(4), _none_op()));
    f = _make_func(str_new("cse_diff"), body);
    var (f2, changes) = opt_cse(f);
    out vtest_expect_eq_i64(changes, 0);
end

func _test_cse_invalidated_by_redef:
    # Add v0+v1 → v2, redefine v0, Add v0+v1 → v3 ⟹ both Adds must stay
    body = vec_new<QInstruction>();
    vec_push(body, _instr(QOp::Load, _vreg(0), _imm(5), _none_op()));
    vec_push(body, _instr(QOp::Load, _vreg(1), _imm(7), _none_op()));
    vec_push(body, _instr(QOp::Add,  _vreg(2), _vreg(0), _vreg(1)));
    vec_push(body, _instr(QOp::Load, _vreg(0), _imm(99), _none_op()));  # redefine v0
    vec_push(body, _instr(QOp::Add,  _vreg(3), _vreg(0), _vreg(1)));
    vec_push(body, _instr(QOp::Ret,  _none_op(), _vreg(3), _none_op()));
    f = _make_func(str_new("cse_redef"), body);
    var (f2, changes) = opt_cse(f);
    out vtest_expect_eq_i64(changes, 0);
end

func _test_cse_invalidated_by_control_flow:
    # Add v0+v1 → v2, Label, Add v0+v1 → v3 ⟹ both Adds must stay
    body = vec_new<QInstruction>();
    vec_push(body, _instr(QOp::Load,  _vreg(0), _imm(5), _none_op()));
    vec_push(body, _instr(QOp::Load,  _vreg(1), _imm(7), _none_op()));
    vec_push(body, _instr(QOp::Add,   _vreg(2), _vreg(0), _vreg(1)));
    lbl = _instr(QOp::Label, _none_op(), _none_op(), _none_op());
    lbl.patch_id = 1;
    vec_push(body, lbl);
    vec_push(body, _instr(QOp::Add,   _vreg(3), _vreg(0), _vreg(1)));
    vec_push(body, _instr(QOp::Ret,   _none_op(), _vreg(3), _none_op()));
    f = _make_func(str_new("cse_cf"), body);
    var (f2, changes) = opt_cse(f);
    out vtest_expect_eq_i64(changes, 0);
end

func _test_cse_commutative_add:
    # Add v0+v1 → v2, Add v1+v0 → v3 ⟹ commutative CSE detects equivalence
    body = vec_new<QInstruction>();
    vec_push(body, _instr(QOp::Load, _vreg(0), _imm(5), _none_op()));
    vec_push(body, _instr(QOp::Load, _vreg(1), _imm(7), _none_op()));
    vec_push(body, _instr(QOp::Add,  _vreg(2), _vreg(0), _vreg(1)));
    vec_push(body, _instr(QOp::Add,  _vreg(3), _vreg(1), _vreg(0)));
    vec_push(body, _instr(QOp::Ret,  _none_op(), _vreg(3), _none_op()));
    f = _make_func(str_new("cse_comm"), body);
    var (f2, changes) = opt_cse(f);
    if changes > 0:
        out vtest_pass();
    end
    out vtest_fail();
end

func _test_sub_not_commutative:
    # Sub v0-v1 → v2, Sub v1-v0 → v3 ⟹ NOT equivalent, both stay
    body = vec_new<QInstruction>();
    vec_push(body, _instr(QOp::Load, _vreg(0), _imm(10), _none_op()));
    vec_push(body, _instr(QOp::Load, _vreg(1), _imm(3),  _none_op()));
    vec_push(body, _instr(QOp::Sub,  _vreg(2), _vreg(0), _vreg(1)));
    vec_push(body, _instr(QOp::Sub,  _vreg(3), _vreg(1), _vreg(0)));
    vec_push(body, _instr(QOp::Ret,  _none_op(), _vreg(3), _none_op()));
    f = _make_func(str_new("sub_nc"), body);
    var (f2, changes) = opt_cse(f);
    out vtest_expect_eq_i64(changes, 0);
end


