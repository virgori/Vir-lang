# Tests — LICM (straight-line → no changes)
# ═══════════════════════════════════════════════════════

func _test_licm_no_loops_noop:
    body = vec_new<QInstruction>();
    vec_push(body, _instr(QOp::Load, _vreg(0), _imm(1), _none_op()));
    vec_push(body, _instr(QOp::Ret,  _none_op(), _vreg(0), _none_op()));
    f = _make_func(str_new("licm_noop"), body);
    var (f2, changes) = opt_licm(f);
    out vtest_expect_eq_i64(changes, 0);
end


# ═══════════════════════════════════════════════════════
# Tests — BCE Real Transform (BoundsCheck Elimination)
# ═══════════════════════════════════════════════════════

func _test_bce_eliminates_in_canonical_loop:
    # Canonical loop: for v0=0; v0<10; v0++
    # BoundsCheck(v0, v1=10) inside loop → provably safe → eliminated
    body = vec_new<QInstruction>();
    vec_push(body, _instr(QOp::Load, _vreg(0), _imm(0), _none_op()));     # v0 = 0 (iv)
    vec_push(body, _instr(QOp::Load, _vreg(1), _imm(10), _none_op()));    # v1 = 10 (bound)
    lbl = _instr(QOp::Label, _none_op(), _none_op(), _none_op());
    lbl.patch_id = 10;
    vec_push(body, lbl);                                                    # Label @10
    vec_push(body, _instr(QOp::CmpLt, _vreg(2), _vreg(0), _vreg(1)));    # v2 = v0 < v1
    vec_push(body, _instr(QOp::JumpIfNot, _none_op(), _vreg(2), _label_ref(20)));  # exit if not
    vec_push(body, _instr(QOp::BoundsCheck, _none_op(), _vreg(0), _vreg(1)));      # check: i < 10
    vec_push(body, _instr(QOp::Add, _vreg(0), _vreg(0), _imm(1)));       # v0++
    vec_push(body, _instr(QOp::Jump, _none_op(), _label_ref(10), _none_op()));     # back edge @10
    lbl2 = _instr(QOp::Label, _none_op(), _none_op(), _none_op());
    lbl2.patch_id = 20;
    vec_push(body, lbl2);                                                   # Label @20 (exit)
    vec_push(body, _instr(QOp::Ret, _none_op(), _vreg(0), _none_op()));
    f = _make_func(str_new("bce_elim"), body);
    var (f2, eliminated) = opt_bce(f);
    if eliminated > 0:
        out vtest_pass();
    end
    out vtest_fail();
end

func _test_bce_preserves_outside_loop:
    # BoundsCheck in straight-line code → no loop → cannot eliminate
    body = vec_new<QInstruction>();
    vec_push(body, _instr(QOp::Load, _vreg(0), _imm(5), _none_op()));
    vec_push(body, _instr(QOp::Load, _vreg(1), _imm(10), _none_op()));
    vec_push(body, _instr(QOp::BoundsCheck, _none_op(), _vreg(0), _vreg(1)));
    vec_push(body, _instr(QOp::Ret, _none_op(), _vreg(0), _none_op()));
    f = _make_func(str_new("bce_keep"), body);
    var (f2, eliminated) = opt_bce(f);
    out vtest_expect_eq_i64(eliminated, 0);
end

func _test_bce_multiple_checks_in_loop:
    # Two BoundsChecks on the IV inside one loop → both eliminated
    body = vec_new<QInstruction>();
    vec_push(body, _instr(QOp::Load, _vreg(0), _imm(0), _none_op()));
    vec_push(body, _instr(QOp::Load, _vreg(1), _imm(10), _none_op()));
    lbl = _instr(QOp::Label, _none_op(), _none_op(), _none_op());
    lbl.patch_id = 10;
    vec_push(body, lbl);
    vec_push(body, _instr(QOp::CmpLt, _vreg(2), _vreg(0), _vreg(1)));
    vec_push(body, _instr(QOp::JumpIfNot, _none_op(), _vreg(2), _label_ref(20)));
    vec_push(body, _instr(QOp::BoundsCheck, _none_op(), _vreg(0), _vreg(1)));  # check 1
    vec_push(body, _instr(QOp::BoundsCheck, _none_op(), _vreg(0), _vreg(1)));  # check 2
    vec_push(body, _instr(QOp::Add, _vreg(0), _vreg(0), _imm(1)));
    vec_push(body, _instr(QOp::Jump, _none_op(), _label_ref(10), _none_op()));
    lbl2 = _instr(QOp::Label, _none_op(), _none_op(), _none_op());
    lbl2.patch_id = 20;
    vec_push(body, lbl2);
    vec_push(body, _instr(QOp::Ret, _none_op(), _vreg(0), _none_op()));
    f = _make_func(str_new("bce_multi"), body);
    var (f2, eliminated) = opt_bce(f);
    out vtest_expect_eq_i64(eliminated, 2);
end


# ═══════════════════════════════════════════════════════
# Tests — Escape Analysis Real Transform
# ═══════════════════════════════════════════════════════

func _test_escape_rewrites_alloc_to_stack_alloc:
    # local Alloc, never escapes → rewritten to StackAlloc
    body = vec_new<QInstruction>();
    vec_push(body, _instr(QOp::Alloc, _vreg(0), _imm(64), _none_op()));
    vec_push(body, _instr(QOp::Load,  _vreg(1), _imm(42), _none_op()));
    vec_push(body, _instr(QOp::Ret,   _none_op(), _vreg(1), _none_op()));
    f = _make_func(str_new("esc_sa"), body);
    var (f2, promoted) = opt_escape_analysis(f);
    if promoted > 0:
        # Verify first instruction became StackAlloc
        first = vec_get(f2.body, 0);
        if first.opcode == QOp::StackAlloc:
            out vtest_pass();
        end
    end
    out vtest_fail();
end

func _test_escape_not_promoted_via_ret:
    # Alloc → v0, return v0 → escapes → NOT promoted
    body = vec_new<QInstruction>();
    vec_push(body, _instr(QOp::Alloc, _vreg(0), _imm(64), _none_op()));
    vec_push(body, _instr(QOp::Ret,   _none_op(), _vreg(0), _none_op()));
    f = _make_func(str_new("esc_ret"), body);
    var (f2, promoted) = opt_escape_analysis(f);
    out vtest_expect_eq_i64(promoted, 0);
end

func _test_escape_not_promoted_via_call:
    # Alloc → v0, pass to Call → escapes → NOT promoted
    body = vec_new<QInstruction>();
    vec_push(body, _instr(QOp::Alloc, _vreg(0), _imm(64), _none_op()));
    vec_push(body, _instr(QOp::Call,  _vreg(1), _vreg(0), _none_op()));
    vec_push(body, _instr(QOp::Load,  _vreg(2), _imm(0), _none_op()));
    vec_push(body, _instr(QOp::Ret,   _none_op(), _vreg(2), _none_op()));
    f = _make_func(str_new("esc_call"), body);
    var (f2, promoted) = opt_escape_analysis(f);
    out vtest_expect_eq_i64(promoted, 0);
end

func _test_escape_free_becomes_nop:
    # Alloc → v0, Free v0, Ret v1 → v0 promotable → Free becomes Nop
    body = vec_new<QInstruction>();
    vec_push(body, _instr(QOp::Alloc, _vreg(0), _imm(64), _none_op()));
    vec_push(body, _instr(QOp::Load,  _vreg(1), _imm(42), _none_op()));
    vec_push(body, _instr(QOp::Free,  _none_op(), _vreg(0), _none_op()));
    vec_push(body, _instr(QOp::Ret,   _none_op(), _vreg(1), _none_op()));
    f = _make_func(str_new("esc_nop"), body);
    var (f2, promoted) = opt_escape_analysis(f);
    if promoted > 0:
        # Verify Free (index 2) became Nop
        freed = vec_get(f2.body, 2);
        if freed.opcode == QOp::Nop:
            out vtest_pass();
        end
    end
    out vtest_fail();
end

func _test_escape_alias_escapes:
    # Alloc → v0, Move v0 → v1, return v1 → v0 escapes via alias → NOT promoted
    body = vec_new<QInstruction>();
    vec_push(body, _instr(QOp::Alloc, _vreg(0), _imm(64), _none_op()));
    vec_push(body, _instr(QOp::Move,  _vreg(1), _vreg(0), _none_op()));
    vec_push(body, _instr(QOp::Ret,   _none_op(), _vreg(1), _none_op()));
    f = _make_func(str_new("esc_alias"), body);
    var (f2, promoted) = opt_escape_analysis(f);
    out vtest_expect_eq_i64(promoted, 0);
end

func _test_escape_two_allocs_one_escapes:
    # Alloc → v0 (local), Alloc → v1 (escapes via Ret)
    # Only v0 should be promoted
    body = vec_new<QInstruction>();
    vec_push(body, _instr(QOp::Alloc, _vreg(0), _imm(32), _none_op()));
    vec_push(body, _instr(QOp::Alloc, _vreg(1), _imm(64), _none_op()));
    vec_push(body, _instr(QOp::Load,  _vreg(2), _imm(99), _none_op()));
    vec_push(body, _instr(QOp::Ret,   _none_op(), _vreg(1), _none_op()));
    f = _make_func(str_new("esc_two"), body);
    var (f2, promoted) = opt_escape_analysis(f);
    out vtest_expect_eq_i64(promoted, 1);
end


# ═══════════════════════════════════════════════════════
# Tests — Pipeline with New Opcodes
# ═══════════════════════════════════════════════════════

func _test_pipeline_with_bounds_check_and_alloc:
    # Full pipeline: function with BoundsCheck (outside loop) + Alloc (local)
    # BoundsCheck should survive (no loop), Alloc should become StackAlloc
    body = vec_new<QInstruction>();
    vec_push(body, _instr(QOp::Alloc, _vreg(0), _imm(64), _none_op()));
    vec_push(body, _instr(QOp::Load,  _vreg(1), _imm(3),  _none_op()));
    vec_push(body, _instr(QOp::Load,  _vreg(2), _imm(10), _none_op()));
    vec_push(body, _instr(QOp::BoundsCheck, _none_op(), _vreg(1), _vreg(2)));
    vec_push(body, _instr(QOp::Load,  _vreg(3), _imm(42), _none_op()));
    vec_push(body, _instr(QOp::Free,  _none_op(), _vreg(0), _none_op()));
    vec_push(body, _instr(QOp::Ret,   _none_op(), _vreg(3), _none_op()));
    f = _make_func(str_new("pipe_bc_alloc"), body);
    funcs = vec_new<QFunction>();
    vec_push(funcs, f);
    mod = _make_module(funcs);
    var (f2, stats) = optimize_function_stats(f, mod);
    # escape_promo should fire (local Alloc → StackAlloc)
    if stats.escape_promo > 0:
        out vtest_pass();
    end
    out vtest_fail();
end

func _test_opcode_enum_bounds_check_value:
    # Q_BOUNDS_CHECK = 248
    out vtest_expect_eq_i64(QOp::BoundsCheck >> int, 248);
end

func _test_opcode_enum_stack_alloc_value:
    # Q_STACK_ALLOC = 249
    out vtest_expect_eq_i64(QOp::StackAlloc >> int, 249);
end


# ═══════════════════════════════════════════════════════
# Suite Builder & Runner
# ═══════════════════════════════════════════════════════

func vtest_compiler_optimizer_suite:
    suite = vtest_suite_new(str_new("compiler/optimizer smoke"));
    suite = vtest_add(suite, str_new("const fold add"),            _test_const_fold_add);
    suite = vtest_add(suite, str_new("cse duplicate add"),         _test_cse_duplicate_add);
    suite = vtest_add(suite, str_new("cse diff operands kept"),    _test_cse_different_operands_not_eliminated);
    suite = vtest_add(suite, str_new("cse redef invalidates"),     _test_cse_invalidated_by_redef);
    suite = vtest_add(suite, str_new("cse control flow inval"),    _test_cse_invalidated_by_control_flow);
    suite = vtest_add(suite, str_new("cse commutative add"),       _test_cse_commutative_add);
    suite = vtest_add(suite, str_new("sub not commutative"),       _test_sub_not_commutative);
    suite = vtest_add(suite, str_new("strength reduce mul*8"),     _test_strength_reduce_mul_pow2);
    suite = vtest_add(suite, str_new("dce removes unused"),        _test_dce_removes_unused);
    suite = vtest_add(suite, str_new("copy prop basic"),           _test_copy_prop_basic);
    suite = vtest_add(suite, str_new("bce no loops = 0"),          _test_bce_no_loops_zero);
    suite = vtest_add(suite, str_new("escape no alloc = 0"),       _test_escape_no_alloc_zero);
    suite = vtest_add(suite, str_new("escape local promotable"),   _test_escape_local_alloc_promotable);
    suite = vtest_add(suite, str_new("det free inserts"),          _test_det_free_inserts);
    suite = vtest_add(suite, str_new("opt stats new zero"),        _test_opt_stats_new_zero);
    suite = vtest_add(suite, str_new("opt stats merge"),           _test_opt_stats_merge);
    suite = vtest_add(suite, str_new("full pipeline smoke"),       _test_full_pipeline_smoke);
    suite = vtest_add(suite, str_new("licm no loops noop"),        _test_licm_no_loops_noop);

    # ── BCE Real Transform ──
    suite = vtest_add(suite, str_new("bce elim in canon loop"),    _test_bce_eliminates_in_canonical_loop);
    suite = vtest_add(suite, str_new("bce keeps outside loop"),    _test_bce_preserves_outside_loop);
    suite = vtest_add(suite, str_new("bce multi checks in loop"),  _test_bce_multiple_checks_in_loop);

    # ── Escape Analysis Real Transform ──
    suite = vtest_add(suite, str_new("escape alloc→stackalloc"),   _test_escape_rewrites_alloc_to_stack_alloc);
    suite = vtest_add(suite, str_new("escape not via ret"),        _test_escape_not_promoted_via_ret);
    suite = vtest_add(suite, str_new("escape not via call"),       _test_escape_not_promoted_via_call);
    suite = vtest_add(suite, str_new("escape free→nop"),           _test_escape_free_becomes_nop);
    suite = vtest_add(suite, str_new("escape alias escapes"),      _test_escape_alias_escapes);
    suite = vtest_add(suite, str_new("escape two allocs partial"), _test_escape_two_allocs_one_escapes);

    # ── Pipeline + Opcode Values ──
    suite = vtest_add(suite, str_new("pipeline bc+alloc"),         _test_pipeline_with_bounds_check_and_alloc);
    suite = vtest_add(suite, str_new("opcode BoundsCheck=248"),    _test_opcode_enum_bounds_check_value);
    suite = vtest_add(suite, str_new("opcode StackAlloc=249"),     _test_opcode_enum_stack_alloc_value);
    out suite;
end

func vtest_compiler_smoke_run:
    reg = vtest_registry_new();
    reg = vtest_registry_add_suite(reg, vtest_compiler_optimizer_suite());
    report = vtest_registry_run(reg);
    vtest_print_summary(report);
    out vtest_exit_code(report);
end
