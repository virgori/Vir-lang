##
 * vir/test/proptest_fuzz_vtest.vri — Property Testing & Fuzz Coverage
 * ====================================================================
 * Uses the Vir-native proptest.vri and fuzz.vri frameworks to test
 * core invariants: arithmetic properties, sort idempotence, parser
 * resilience, and QIR builder edge cases.
 ##

include types;
include string;
import String, str_new, str_eq, str_len from string;
include vec;
import Vec, vec_new, vec_push, vec_len, vec_get from vec;
include test;
import TestSuite, TestResult from test;
include vtest;
import VTestRegistry,
       vtest_suite_new, vtest_add,
       vtest_registry_new, vtest_registry_add_suite, vtest_registry_run,
       vtest_print_summary, vtest_exit_code,
       vtest_pass, vtest_fail,
       vtest_expect_true, vtest_expect_false,
       vtest_expect_eq_i64 from vtest;
include test/proptest;
import Rng, rng_new, gen_int, gen_bool, gen_vec_int,
       shrink_int, shrink_vec,
       PropResult, prop_check_int from proptest;
include test/fuzz;
import FuzzRng, FuzzCorpus,
       fuzz_rng_new, fuzz_corpus_new, fuzz_corpus_add,
       mutate_flip_bit, mutate_insert_byte, mutate_delete_byte,
       mutate_replace_byte, mutate,
       fuzz_run, FuzzResult from fuzz;


# ═══════════════════════════════════════════════════════
# Property Tests via proptest
# ═══════════════════════════════════════════════════════

## add is commutative: a + b == b + a
func _test_prop_add_commutative:
    let rng = rng_new(12345);
    let i = 0;
    when i < 100 loop
        var (a, rng2) = gen_int(rng, -1000, 1000);
        rng = rng2;
        var (b, rng3) = gen_int(rng, -1000, 1000);
        rng = rng3;
        if (a + b) != (b + a):
            out vtest_fail(str_new("add not commutative"));
        end
        i = i + 1;
    end
    out vtest_pass();
end

## mul is commutative: a * b == b * a
func _test_prop_mul_commutative:
    let rng = rng_new(67890);
    let i = 0;
    when i < 100 loop
        var (a, rng2) = gen_int(rng, -500, 500);
        rng = rng2;
        var (b, rng3) = gen_int(rng, -500, 500);
        rng = rng3;
        if (a * b) != (b * a):
            out vtest_fail(str_new("mul not commutative"));
        end
        i = i + 1;
    end
    out vtest_pass();
end

## add identity: a + 0 == a
func _test_prop_add_identity:
    let rng = rng_new(11111);
    let i = 0;
    when i < 100 loop
        var (a, rng2) = gen_int(rng, -10000, 10000);
        rng = rng2;
        if (a + 0) != a:
            out vtest_fail(str_new("add identity violated"));
        end
        i = i + 1;
    end
    out vtest_pass();
end

## mul identity: a * 1 == a
func _test_prop_mul_identity:
    let rng = rng_new(22222);
    let i = 0;
    when i < 100 loop
        var (a, rng2) = gen_int(rng, -10000, 10000);
        rng = rng2;
        if (a * 1) != a:
            out vtest_fail(str_new("mul identity violated"));
        end
        i = i + 1;
    end
    out vtest_pass();
end

## add is associative: (a + b) + c == a + (b + c)
func _test_prop_add_associative:
    let rng = rng_new(33333);
    let i = 0;
    when i < 100 loop
        var (a, rng2) = gen_int(rng, -1000, 1000);
        rng = rng2;
        var (b, rng3) = gen_int(rng, -1000, 1000);
        rng = rng3;
        var (c, rng4) = gen_int(rng, -1000, 1000);
        rng = rng4;
        if ((a + b) + c) != (a + (b + c)):
            out vtest_fail(str_new("add not associative"));
        end
        i = i + 1;
    end
    out vtest_pass();
end

## negate involution: -(-a) == a
func _test_prop_negate_involution:
    let rng = rng_new(44444);
    let i = 0;
    when i < 100 loop
        var (a, rng2) = gen_int(rng, -10000, 10000);
        rng = rng2;
        if (0 - (0 - a)) != a:
            out vtest_fail(str_new("negate involution violated"));
        end
        i = i + 1;
    end
    out vtest_pass();
end

## gen_bool produces both true and false within 200 samples
func _test_prop_gen_bool_coverage:
    let rng = rng_new(55555);
    let saw_true = false;
    let saw_false = false;
    let i = 0;
    when i < 200 loop
        var (b, rng2) = gen_bool(rng);
        rng = rng2;
        if b: saw_true = true; else: saw_false = true; end
        i = i + 1;
    end
    if saw_true and saw_false:
        out vtest_pass();
    end
    out vtest_fail(str_new("gen_bool did not produce both values"));
end

## shrink_int converges toward zero
func _test_prop_shrink_toward_zero:
    let shrunk = shrink_int(100);
    let found_smaller = false;
    let i = 0;
    when i < vec_len<int>(shrunk) loop
        let v = vec_get<int>(shrunk, i);
        if v >= 0 and v < 100:
            found_smaller = true;
        end
        i = i + 1;
    end
    if found_smaller:
        out vtest_pass();
    end
    out vtest_fail(str_new("shrink_int should produce values closer to zero"));
end

## gen_vec_int produces vectors of correct length
func _test_prop_gen_vec_len:
    let rng = rng_new(66666);
    var (v, _) = gen_vec_int(rng, 10, -100, 100);
    if vec_len<int>(v) == 10:
        out vtest_pass();
    end
    out vtest_fail(str_new("gen_vec_int wrong length"));
end


# ═══════════════════════════════════════════════════════
# Fuzz Tests
# ═══════════════════════════════════════════════════════

## fuzz_rng produces values in range
func _test_fuzz_rng_range:
    let rng = fuzz_rng_new(77777);
    let all_ok = true;
    let i = 0;
    when i < 100 loop
        var (v, rng2) = gen_int(rng, 0, 255);
        rng = rng2;
        if v < 0 or v > 255:
            all_ok = false;
        end
        i = i + 1;
    end
    if all_ok:
        out vtest_pass();
    end
    out vtest_fail(str_new("fuzz_rng produced out-of-range value"));
end

## mutate_flip_bit changes at least one byte
func _test_fuzz_flip_bit:
    let data = vec_new<int>();
    data = vec_push<int>(data, 0xAA);
    data = vec_push<int>(data, 0xBB);
    data = vec_push<int>(data, 0xCC);
    let rng = fuzz_rng_new(88888);
    var (mutated, _) = mutate_flip_bit(data, rng);
    let differ = false;
    let i = 0;
    when i < vec_len<int>(mutated) loop
        if vec_get<int>(mutated, i) != vec_get<int>(data, i):
            differ = true;
        end
        i = i + 1;
    end
    if differ:
        out vtest_pass();
    end
    out vtest_fail(str_new("flip_bit should change at least one byte"));
end

## mutate_insert_byte increases length
func _test_fuzz_insert_byte:
    let data = vec_new<int>();
    data = vec_push<int>(data, 1);
    data = vec_push<int>(data, 2);
    let rng = fuzz_rng_new(99999);
    var (mutated, _) = mutate_insert_byte(data, rng);
    if vec_len<int>(mutated) == 3:
        out vtest_pass();
    end
    out vtest_fail(str_new("insert_byte should increase length by 1"));
end

## mutate_delete_byte decreases length
func _test_fuzz_delete_byte:
    let data = vec_new<int>();
    data = vec_push<int>(data, 1);
    data = vec_push<int>(data, 2);
    data = vec_push<int>(data, 3);
    let rng = fuzz_rng_new(10101);
    var (mutated, _) = mutate_delete_byte(data, rng);
    if vec_len<int>(mutated) == 2:
        out vtest_pass();
    end
    out vtest_fail(str_new("delete_byte should decrease length by 1"));
end

## corpus can store and retrieve entries
func _test_fuzz_corpus:
    let corpus = fuzz_corpus_new();
    let entry1 = vec_new<int>();
    entry1 = vec_push<int>(entry1, 0x41);
    entry1 = vec_push<int>(entry1, 0x42);
    corpus = fuzz_corpus_add(corpus, entry1);
    let entry2 = vec_new<int>();
    entry2 = vec_push<int>(entry2, 0x43);
    corpus = fuzz_corpus_add(corpus, entry2);
    if corpus.size == 2:
        out vtest_pass();
    end
    out vtest_fail(str_new("corpus should have 2 entries"));
end

## mutate_replace_byte preserves length
func _test_fuzz_replace_byte:
    let data = vec_new<int>();
    data = vec_push<int>(data, 10);
    data = vec_push<int>(data, 20);
    data = vec_push<int>(data, 30);
    let rng = fuzz_rng_new(20202);
    var (mutated, _) = mutate_replace_byte(data, rng);
    if vec_len<int>(mutated) == 3:
        out vtest_pass();
    end
    out vtest_fail(str_new("replace_byte should preserve length"));
end


# ═══════════════════════════════════════════════════════
# Suite Registration & Entry
# ═══════════════════════════════════════════════════════

func proptest_fuzz_vtest_main:
    let reg = vtest_registry_new();

    # Property-based tests
    let ts_prop = vtest_suite_new(str_new("proptest"));
    vtest_add(ts_prop, str_new("add_commutative"),        _test_prop_add_commutative);
    vtest_add(ts_prop, str_new("mul_commutative"),        _test_prop_mul_commutative);
    vtest_add(ts_prop, str_new("add_identity"),           _test_prop_add_identity);
    vtest_add(ts_prop, str_new("mul_identity"),           _test_prop_mul_identity);
    vtest_add(ts_prop, str_new("add_associative"),        _test_prop_add_associative);
    vtest_add(ts_prop, str_new("negate_involution"),      _test_prop_negate_involution);
    vtest_add(ts_prop, str_new("gen_bool_coverage"),      _test_prop_gen_bool_coverage);
    vtest_add(ts_prop, str_new("shrink_toward_zero"),     _test_prop_shrink_toward_zero);
    vtest_add(ts_prop, str_new("gen_vec_len"),            _test_prop_gen_vec_len);
    vtest_registry_add_suite(reg, ts_prop);

    # Fuzz tests
    let ts_fuzz = vtest_suite_new(str_new("fuzz"));
    vtest_add(ts_fuzz, str_new("rng_range"),              _test_fuzz_rng_range);
    vtest_add(ts_fuzz, str_new("flip_bit"),               _test_fuzz_flip_bit);
    vtest_add(ts_fuzz, str_new("insert_byte"),            _test_fuzz_insert_byte);
    vtest_add(ts_fuzz, str_new("delete_byte"),            _test_fuzz_delete_byte);
    vtest_add(ts_fuzz, str_new("corpus"),                 _test_fuzz_corpus);
    vtest_add(ts_fuzz, str_new("replace_byte"),           _test_fuzz_replace_byte);
    vtest_registry_add_suite(reg, ts_fuzz);

    vtest_registry_run(reg);
    vtest_print_summary(reg);
    out vtest_exit_code(reg);
end

export proptest_fuzz_vtest_main;
