# ═══════════════════════════════════════════════════════
# Tests — Pass Manager Pipeline
# ═══════════════════════════════════════════════════════

func _test_pass_pipeline_ordering:
    # Verify: const_fold runs before DCE (fold creates dead code for DCE to remove)
    out vtest_pass();
end

func _test_pass_pipeline_idempotent:
    # Running optimizer twice should produce same Q-IR
    out vtest_pass();
