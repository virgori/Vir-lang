# ═══════════════════════════════════════════════════════
# Suite builder
# ═══════════════════════════════════════════════════════

func vtest_tools_suite:
    suite = vtest_suite_new(str_new("tools & pkg"));
    suite = vtest_add(suite, str_new("semver parse"), _test_semver_parse_basic);
    suite = vtest_add(suite, str_new("semver zero"), _test_semver_parse_zero);
    suite = vtest_add(suite, str_new("semver cmp major"), _test_semver_compare_major);
    suite = vtest_add(suite, str_new("semver cmp minor"), _test_semver_compare_minor);
    suite = vtest_add(suite, str_new("semver cmp equal"), _test_semver_compare_equal);
    suite = vtest_add(suite, str_new("semver to_string"), _test_semver_to_string);
    suite = vtest_add(suite, str_new("ver req caret"), _test_version_req_caret);
    suite = vtest_add(suite, str_new("ver req caret rej"), _test_version_req_caret_reject);
    suite = vtest_add(suite, str_new("ver req tilde"), _test_version_req_tilde);
    suite = vtest_add(suite, str_new("ver req tilde rej"), _test_version_req_tilde_reject);
    suite = vtest_add(suite, str_new("ver req exact"), _test_version_req_exact);
    suite = vtest_add(suite, str_new("ver req exact rej"), _test_version_req_exact_reject);
    suite = vtest_add(suite, str_new("ver req gte"), _test_version_req_gte);
    suite = vtest_add(suite, str_new("ver req gte rej"), _test_version_req_gte_reject);
    suite = vtest_add(suite, str_new("manifest name"), _test_manifest_parse_name);
    suite = vtest_add(suite, str_new("manifest version"), _test_manifest_parse_version);
    suite = vtest_add(suite, str_new("manifest deps"), _test_manifest_dep_count);
    suite = vtest_add(suite, str_new("viron commands"), _test_viron_commands_exist);
    suite = vtest_add(suite, str_new("viron aliases"), _test_viron_alias_resolution);
    suite = vtest_add(suite, str_new("pass ordering"), _test_pass_pipeline_ordering);
    suite = vtest_add(suite, str_new("pass idempotent"), _test_pass_pipeline_idempotent);
    out suite;
end
