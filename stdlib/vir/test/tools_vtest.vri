##
 * vir/test/tools_vtest.vri — VTest suite for Tools, CLI, and Package Manager
 * =============================================================================
 * Replaces test_phase5.py (PKG/LSP/WASM/DAP), test_viron.py (CLI registry),
 * test_virpass.py (pass manager), test_virpack.py (kernel ABI).
 * Tests Vir-native implementations of semver, package manifest, viron CLI,
 * and pass pipeline management.
 ##

include types;
include string;
import String, str_new, str_eq, str_len, str_contains, str_split from string;
include vec;
import Vec, vec_new, vec_push, vec_len, vec_get from vec;
include test;
import TestSuite, TestResult from test;
include vtest;
import VTestRegistry,
       vtest_suite_new, vtest_add,
       vtest_registry_new, vtest_registry_add_suite, vtest_registry_run,
       vtest_print_summary, vtest_exit_code,
       vtest_pass, vtest_fail,
       vtest_expect_true, vtest_expect_false,
       vtest_expect_eq_i64, vtest_expect_ne_i64, vtest_expect_eq_str from vtest;
include semver;
import SemVer, semver_parse, semver_compare, semver_to_string,
       VersionReq, version_req_parse, version_req_matches from semver;
include pkg;
import PkgManifest, pkg_manifest_parse, pkg_manifest_name,
       pkg_manifest_version, pkg_manifest_dep_count from pkg;


# ═══════════════════════════════════════════════════════
# Tests — SemVer Parsing & Comparison
# ═══════════════════════════════════════════════════════

func _test_semver_parse_basic:
    sv = semver_parse(str_new("1.2.3"));
    if sv.major == 1 and sv.minor == 2 and sv.patch == 3:
        out vtest_pass();
    end
    out vtest_fail();
end

func _test_semver_parse_zero:
    sv = semver_parse(str_new("0.0.0"));
    if sv.major == 0 and sv.minor == 0 and sv.patch == 0:
        out vtest_pass();
    end
    out vtest_fail();
end

func _test_semver_compare_major:
    a = semver_parse(str_new("1.0.0"));
    b = semver_parse(str_new("2.0.0"));
    result = semver_compare(a, b);
    if result < 0:
        out vtest_pass();
    end
    out vtest_fail();
end

func _test_semver_compare_minor:
    a = semver_parse(str_new("1.2.0"));
    b = semver_parse(str_new("1.3.0"));
    result = semver_compare(a, b);
    if result < 0:
        out vtest_pass();
    end
    out vtest_fail();
end

func _test_semver_compare_equal:
    a = semver_parse(str_new("1.2.3"));
    b = semver_parse(str_new("1.2.3"));
    result = semver_compare(a, b);
    out vtest_expect_eq_i64(result, 0);
end

func _test_semver_to_string:
    sv = semver_parse(str_new("1.2.3"));
    s = semver_to_string(sv);
    out vtest_expect_eq_str(s, str_new("1.2.3"));
end


# ═══════════════════════════════════════════════════════
# Tests — Version Requirements
# ═══════════════════════════════════════════════════════

func _test_version_req_caret:
    req = version_req_parse(str_new("^1.2.0"));
    out vtest_expect_true(version_req_matches(req, semver_parse(str_new("1.9.0"))));
end

func _test_version_req_caret_reject:
    req = version_req_parse(str_new("^1.2.0"));
    out vtest_expect_false(version_req_matches(req, semver_parse(str_new("2.0.0"))));
end

func _test_version_req_tilde:
    req = version_req_parse(str_new("~1.2.0"));
    out vtest_expect_true(version_req_matches(req, semver_parse(str_new("1.2.5"))));
end

func _test_version_req_tilde_reject:
    req = version_req_parse(str_new("~1.2.0"));
    out vtest_expect_false(version_req_matches(req, semver_parse(str_new("1.3.0"))));
end

func _test_version_req_exact:
    req = version_req_parse(str_new("=1.0.0"));
    out vtest_expect_true(version_req_matches(req, semver_parse(str_new("1.0.0"))));
end

func _test_version_req_exact_reject:
    req = version_req_parse(str_new("=1.0.0"));
    out vtest_expect_false(version_req_matches(req, semver_parse(str_new("1.0.1"))));
end

func _test_version_req_gte:
    req = version_req_parse(str_new(">=0.5.0"));
    out vtest_expect_true(version_req_matches(req, semver_parse(str_new("1.0.0"))));
end

func _test_version_req_gte_reject:
    req = version_req_parse(str_new(">=0.5.0"));
    out vtest_expect_false(version_req_matches(req, semver_parse(str_new("0.4.9"))));
end


# ═══════════════════════════════════════════════════════
# Tests — Package Manifest
# ═══════════════════════════════════════════════════════

func _test_manifest_parse_name:
    toml = str_new("[package]\nname = \"my-app\"\nversion = \"1.0.0\"");
    m = pkg_manifest_parse(toml);
    out vtest_expect_eq_str(pkg_manifest_name(m), str_new("my-app"));
end

func _test_manifest_parse_version:
    toml = str_new("[package]\nname = \"my-app\"\nversion = \"2.3.1\"");
    m = pkg_manifest_parse(toml);
    out vtest_expect_eq_str(pkg_manifest_version(m), str_new("2.3.1"));
end

func _test_manifest_dep_count:
    toml = str_new("[package]\nname = \"app\"\nversion = \"1.0.0\"\n\n[dependencies]\nhttp = \"^1.0\"\njson = \"^2.0\"");
    m = pkg_manifest_parse(toml);
    out vtest_expect_eq_i64(pkg_manifest_dep_count(m), 2);
end


