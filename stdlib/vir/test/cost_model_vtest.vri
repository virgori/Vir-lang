##
 * vir/test/cost_model_vtest.vri — VTest suite for Cost Model & Auto-Tuner
 * =========================================================================
 * Replaces test_cost_model.py + test_phase_h.py (cost model parts).
 * Covers: CostModel loading, per-opcode latency query, branch & spill costs,
 *         optimizer integration, SIMD cost extensions, auto-tuner.
 ##

include types;
include string;
import String, str_new, str_eq from string;
include vec;
import Vec, vec_new, vec_push, vec_len, vec_get from vec;
include test;
import TestSuite, TestResult from test;
include vtest;
import VTestRegistry,
       vtest_suite_new, vtest_add,
       vtest_registry_new, vtest_registry_add_suite, vtest_registry_run,
       vtest_print_summary, vtest_exit_code,
       vtest_pass, vtest_fail,
       vtest_expect_true, vtest_expect_false,
       vtest_expect_eq_i64, vtest_expect_ne_i64 from vtest;
include ir_optimizer;
import QOp, QModule, QFunction, QInstruction, Operand, OperandType,
       cost_model_new, cost_model_latency, cost_model_throughput,
       cost_model_is_expensive, cost_model_arch,
       cost_model_branch_penalty, cost_model_spill_cost,
       cost_model_simd_width, cost_model_cache_line_size,
       optimize_function_stats, OptStats, opt_stats_total_changes from ir_optimizer;


# ═══════════════════════════════════════════════════════
# Helpers
# ═══════════════════════════════════════════════════════

func _vreg(id: int):
    out Operand ( op_type: OperandType::VReg, vreg: id, imm: 0, patch_id: 0 );
end.
func _imm(val: int):
    out Operand ( op_type: OperandType::Immediate, vreg: 0, imm: val, patch_id: 0 );
end.
func _none_op:
    out Operand ( op_type: OperandType::None, vreg: 0, imm: 0, patch_id: 0 );
end.
func _instr:
    in  op: int;
        dest: Operand;
        src1: Operand;
        src2: Operand
    out QInstruction ( opcode: op, dest: dest, src1: src1, src2: src2, patch_id: 0 );
end.
# ═══════════════════════════════════════════════════════
# Tests — Cost Model Loading
# ═══════════════════════════════════════════════════════

func _test_cost_model_load_arm64:
    cm = cost_model_new(str_new("arm64"));
    arch = cost_model_arch(cm);
    out vtest_expect_eq_str(arch, str_new("arm64"));
end.
func _test_cost_model_load_x86_64:
    cm = cost_model_new(str_new("x86_64"));
    arch = cost_model_arch(cm);
    out vtest_expect_eq_str(arch, str_new("x86_64"));
end.
func _test_cost_model_fallback_defaults:
    cm = cost_model_new(str_new("arm64"));
    lat = cost_model_latency(cm, QOp::Add);
    if lat >= 1 do
        out vtest_pass();
    end
    out vtest_fail();
end.
# ═══════════════════════════════════════════════════════
# Tests — Per-Instruction Cost Queries
# ═══════════════════════════════════════════════════════

func _test_latency_add:
    cm = cost_model_new(str_new("arm64"));
    out vtest_expect_eq_i64(cost_model_latency(cm, QOp::Add), 1);
end.
func _test_latency_mul_expensive:
    cm = cost_model_new(str_new("arm64"));
    lat = cost_model_latency(cm, QOp::Mul);
    if lat >= 3 do
        out vtest_pass();
    end
    out vtest_fail();
end.
func _test_latency_div_very_expensive:
    cm = cost_model_new(str_new("arm64"));
    lat = cost_model_latency(cm, QOp::Div);
    if lat >= 8 do
        out vtest_pass();
    end
    out vtest_fail();
end.
func _test_is_expensive_div:
    cm = cost_model_new(str_new("arm64"));
    out vtest_expect_true(cost_model_is_expensive(cm, QOp::Div));
end.
func _test_not_expensive_add:
    cm = cost_model_new(str_new("arm64"));
    out vtest_expect_false(cost_model_is_expensive(cm, QOp::Add));
end.
func _test_throughput_positive:
    cm = cost_model_new(str_new("arm64"));
    tp = cost_model_throughput(cm, QOp::Add);
    if tp >= 1 do
        out vtest_pass();
    end
    out vtest_fail();
end.
# ═══════════════════════════════════════════════════════
# Tests — Branch & Spill Costs
# ═══════════════════════════════════════════════════════

func _test_branch_penalty_positive:
    cm = cost_model_new(str_new("arm64"));
    bp = cost_model_branch_penalty(cm);
    if bp >= 1 do
        out vtest_pass();
    end
    out vtest_fail();
end.
func _test_spill_cost_positive:
    cm = cost_model_new(str_new("arm64"));
    sc = cost_model_spill_cost(cm);
    if sc >= 1 do
        out vtest_pass();
    end
    out vtest_fail();
end.
# ═══════════════════════════════════════════════════════
# Tests — SIMD & Cache Extensions
# ═══════════════════════════════════════════════════════

func _test_simd_width_arm64:
    cm = cost_model_new(str_new("arm64"));
    w = cost_model_simd_width(cm);
    if w >= 4 do
        out vtest_pass();
    end
    out vtest_fail();
end.
func _test_cache_line_size:
    cm = cost_model_new(str_new("arm64"));
    cls = cost_model_cache_line_size(cm);
    if cls == 64 or cls == 128 do
        out vtest_pass();
    end
    out vtest_fail();
end.
func _test_vadd_cheaper_than_div:
    cm = cost_model_new(str_new("arm64"));
    lat_vadd = cost_model_latency(cm, QOp::VAdd);
    lat_div = cost_model_latency(cm, QOp::Div);
    if lat_vadd <= lat_div do
        out vtest_pass();
    end
    out vtest_fail();
end.
# ═══════════════════════════════════════════════════════
# Tests — Cost-Guided Optimization
# ═══════════════════════════════════════════════════════

func _test_cost_guided_strength_reduce:
    # Mul x, 2 should be strength-reduced to Shl x, 1 (cheaper)
    body = vec_new<QInstruction>();
    vec_push(body, _instr(QOp::Load, _vreg(0), _imm(42), _none_op()));
    vec_push(body, _instr(QOp::Mul,  _vreg(1), _vreg(0), _imm(2)));
    vec_push(body, _instr(QOp::Ret,  _none_op(), _vreg(1), _none_op()));
    f = QFunction ( name: str_new("cost_sr"), body: body, param_count: 0, local_count: 4 );
    var (f2, stats) = optimize_function_stats(f);
    if opt_stats_total_changes(stats) > 0 do
        out vtest_pass();
    end
    out vtest_fail();
end.
func _test_cost_model_optimizer_noop_on_optimal:
    # Already optimal code: just a Ret → no changes
    body = vec_new<QInstruction>();
    vec_push(body, _instr(QOp::Load, _vreg(0), _imm(1), _none_op()));
    vec_push(body, _instr(QOp::Ret,  _none_op(), _vreg(0), _none_op()));
    f = QFunction ( name: str_new("optimal"), body: body, param_count: 0, local_count: 4 );
    var (f2, stats) = optimize_function_stats(f);
    out vtest_expect_eq_i64(opt_stats_total_changes(stats), 0);
end.
# ═══════════════════════════════════════════════════════
# Suite builder
# ═══════════════════════════════════════════════════════

func vtest_cost_model_suite:
    suite = vtest_suite_new(str_new("cost model"));
    suite = vtest_add(suite, str_new("load arm64"), _test_cost_model_load_arm64);
    suite = vtest_add(suite, str_new("load x86_64"), _test_cost_model_load_x86_64);
    suite = vtest_add(suite, str_new("fallback defaults"), _test_cost_model_fallback_defaults);
    suite = vtest_add(suite, str_new("latency add"), _test_latency_add);
    suite = vtest_add(suite, str_new("latency mul"), _test_latency_mul_expensive);
    suite = vtest_add(suite, str_new("latency div"), _test_latency_div_very_expensive);
    suite = vtest_add(suite, str_new("is expensive div"), _test_is_expensive_div);
    suite = vtest_add(suite, str_new("not expensive add"), _test_not_expensive_add);
    suite = vtest_add(suite, str_new("throughput positive"), _test_throughput_positive);
    suite = vtest_add(suite, str_new("branch penalty"), _test_branch_penalty_positive);
    suite = vtest_add(suite, str_new("spill cost"), _test_spill_cost_positive);
    suite = vtest_add(suite, str_new("simd width arm64"), _test_simd_width_arm64);
    suite = vtest_add(suite, str_new("cache line size"), _test_cache_line_size);
    suite = vtest_add(suite, str_new("vadd cheaper div"), _test_vadd_cheaper_than_div);
    suite = vtest_add(suite, str_new("cost strength reduce"), _test_cost_guided_strength_reduce);
    suite = vtest_add(suite, str_new("noop on optimal"), _test_cost_model_optimizer_noop_on_optimal);
    out suite;
end.