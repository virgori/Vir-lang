# ═══════════════════════════════════════════════════════
# Tests — Async/Task/Has/Share
# ═══════════════════════════════════════════════════════

func _test_async_func_parse:
    let src = str_new("async func fetch:\n    out 0;\nend");
    let lex = lexer_new(src);
    lex = tokenize(lex);
    let p = parser_new(lex);
    let ast = parse_program(p);
    if vec_len(ast.children) >= 1:
        out vtest_pass();
    end
    out vtest_fail();
end

func _test_has_forward_decl:
    let src = str_new("has helper\nfunc main:\n    out 0;\nend\nfunc helper:\n    out 1;\nend");
    let lex = lexer_new(src);
    lex = tokenize(lex);
    let p = parser_new(lex);
    let ast = parse_program(p);
    if vec_len(ast.children) >= 2:
        out vtest_pass();
    end
    out vtest_fail();
end

func _test_share_get_parse:
    let src = str_new("share counter = 0\nfunc inc:\n    get counter\n    counter = counter + 1;\nend");
    let lex = lexer_new(src);
    lex = tokenize(lex);
    let p = parser_new(lex);
    let ast = parse_program(p);
    if vec_len(ast.children) >= 2:
        out vtest_pass();
    end
    out vtest_fail();
end


# ═══════════════════════════════════════════════════════
# Suite builder
# ═══════════════════════════════════════════════════════

func vtest_type_system_suite:
    suite = vtest_suite_new(str_new("type system"));
    suite = vtest_add(suite, str_new("generic entity"), _test_generic_entity_parse);
    suite = vtest_add(suite, str_new("generic func"), _test_generic_func_parse);
    suite = vtest_add(suite, str_new("enum parse"), _test_enum_parse);
    suite = vtest_add(suite, str_new("enum values"), _test_enum_with_values);
    suite = vtest_add(suite, str_new("case int match"), _test_case_integer_match);
    suite = vtest_add(suite, str_new("case str match"), _test_case_string_match);
    suite = vtest_add(suite, str_new("entity fields"), _test_entity_with_fields);
    suite = vtest_add(suite, str_new("method parse"), _test_method_parse);
    suite = vtest_add(suite, str_new("class parse"), _test_class_parse);
    suite = vtest_add(suite, str_new("try error"), _test_try_error_parse);
    suite = vtest_add(suite, str_new("power operator"), _test_power_operator_parse);
    suite = vtest_add(suite, str_new("percent operator"), _test_percent_operator_parse);
    suite = vtest_add(suite, str_new("safe operators"), _test_safe_operators_parse);
    suite = vtest_add(suite, str_new("cast operator"), _test_cast_operator_parse);
    suite = vtest_add(suite, str_new("async func"), _test_async_func_parse);
    suite = vtest_add(suite, str_new("has forward"), _test_has_forward_decl);
    suite = vtest_add(suite, str_new("share get"), _test_share_get_parse);
    out suite;
end
