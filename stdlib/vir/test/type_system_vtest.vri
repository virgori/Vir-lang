##
 * vir/test/type_system_vtest.vri — VTest suite for Type System & Generics
 * =========================================================================
 * Replaces test_phase3.py (Pillar E: generics, traits, enum, pattern match).
 * Tests Vir parser + IR handling of generic types, enum definitions,
 * pattern matching, and type checker basics.
 ##

include types;
include string;
import String, str_new, str_eq, str_len, str_contains from string;
include vec;
import Vec, vec_new, vec_push, vec_len, vec_get from vec;
include test;
import TestSuite, TestResult from test;
include vtest;
import VTestRegistry,
       vtest_suite_new, vtest_add,
       vtest_registry_new, vtest_registry_add_suite, vtest_registry_run,
       vtest_print_summary, vtest_exit_code,
       vtest_pass, vtest_fail,
       vtest_expect_true, vtest_expect_false,
       vtest_expect_eq_i64, vtest_expect_ne_i64, vtest_expect_eq_str from vtest;
include compiler/lexer;
import Lexer, lexer_new, tokenize from compiler/lexer;
include compiler/parser;
import Parser, AstNode, AstType, parser_new, parse_program from compiler/parser;


# ═══════════════════════════════════════════════════════
# Tests — Generic Type Parsing
# ═══════════════════════════════════════════════════════

func _test_generic_entity_parse:
    # entity Vec<T>: data:T; len:int end
    let src = str_new("entity Container:\n    data:int\n    len:int\nend");
    let lex = lexer_new(src);
    lex = tokenize(lex);
    if lex.error_count > 0:
        out vtest_fail();
    end
    let p = parser_new(lex);
    let ast = parse_program(p);
    if ast.node_type == AstType::Program and vec_len(ast.children) >= 1:
        out vtest_pass();
    end
    out vtest_fail();
end

func _test_generic_func_parse:
    let src = str_new("func identity:\n    in(x:int)\n    out x;\nend");
    let lex = lexer_new(src);
    lex = tokenize(lex);
    let p = parser_new(lex);
    let ast = parse_program(p);
    if ast.node_type == AstType::Program and vec_len(ast.children) >= 1:
        child = vec_get(ast.children, 0);
        if child.node_type == AstType::FuncDef:
            out vtest_pass();
        end
    end
    out vtest_fail();
end


# ═══════════════════════════════════════════════════════
# Tests — Enum Definitions
# ═══════════════════════════════════════════════════════

func _test_enum_parse:
    let src = str_new("enum Color:\n    Red = 0\n    Green = 1\n    Blue = 2\nend");
    let lex = lexer_new(src);
    lex = tokenize(lex);
    let p = parser_new(lex);
    let ast = parse_program(p);
    if vec_len(ast.children) >= 1:
        child = vec_get(ast.children, 0);
        if child.node_type == AstType::EnumDef:
            out vtest_pass();
        end
    end
    out vtest_fail();
end

func _test_enum_with_values:
    let src = str_new("enum Direction:\n    North = 0\n    South = 1\n    East = 2\n    West = 3\nend");
    let lex = lexer_new(src);
    lex = tokenize(lex);
    if lex.error_count == 0:
        let p = parser_new(lex);
        let ast = parse_program(p);
        if vec_len(ast.children) >= 1:
            out vtest_pass();
        end
    end
    out vtest_fail();
end


# ═══════════════════════════════════════════════════════
# Tests — Case / Pattern Matching
# ═══════════════════════════════════════════════════════

func _test_case_integer_match:
    let src = str_new("func test_case:\n    in(x:int)\n    case x;\n        case 1\n            out 10;\n        case 2\n            out 20;\n    end\n    out 0;\nend");
    let lex = lexer_new(src);
    lex = tokenize(lex);
    let p = parser_new(lex);
    let ast = parse_program(p);
    if vec_len(ast.children) >= 1:
        out vtest_pass();
    end
    out vtest_fail();
end

func _test_case_string_match:
    let src = str_new("func test_str:\n    in(s:string)\n    case s;\n        case \"hello\"\n            out 1;\n        case \"world\"\n            out 2;\n    end\n    out 0;\nend");
    let lex = lexer_new(src);
    lex = tokenize(lex);
    let p = parser_new(lex);
    let ast = parse_program(p);
    if vec_len(ast.children) >= 1:
        out vtest_pass();
    end
    out vtest_fail();
end


