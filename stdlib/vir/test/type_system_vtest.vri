# Tests — Entity / Method Definitions
# ═══════════════════════════════════════════════════════

func _test_entity_with_fields:
    let src = str_new("entity Point:\n    x:int\n    y:int\nend");
    let lex = lexer_new(src);
    lex = tokenize(lex);
    let p = parser_new(lex);
    let ast = parse_program(p);
    if vec_len(ast.children) >= 1:
        child = vec_get(ast.children, 0);
        if child.node_type == AstType::EntityDef:
            out vtest_pass();
        end
    end
    out vtest_fail();
end

func _test_method_parse:
    let src = str_new("method Point.translate:\n    in(dx:int; dy:int)\n    out 0;\nend");
