##
 * vir/test/math_vtest.vri — VTest suite for Matrix, Gradient (AD), Optimizers
 * =============================================================================
 * Port of test_virmatrix_kernels.py + test_virgrad.py + test_viroptim.py →
 * pure Vir vtest.
 * Covers:  mat_*, tape/scalar/backward, SGD/Adam.
 ##

include types;
include string;
import String, str_new, str_eq from string;
include test;
import TestSuite, TestResult from test;
include vtest;
import VTestRegistry,
       vtest_suite_new, vtest_add,
       vtest_registry_new, vtest_registry_add_suite, vtest_registry_run,
       vtest_print_summary, vtest_exit_code,
       vtest_pass, vtest_fail,
       vtest_expect_true, vtest_expect_false,
       vtest_expect_eq_i64 from vtest;
include math/matrix;
import mat_new, mat_identity, mat_filled, mat_clone, mat_free,
       mat_get, mat_set, mat_rows, mat_cols,
       mat_add, mat_sub, mat_scale, mat_mul,
       mat_transpose, mat_det, mat_trace,
       mat_eq from math/matrix;
include math/grad;
import Tape, TapeNode, Scalar,
       tape_new, tape_free, tape_reset,
       scalar, scalar_val, grad,
       ad_add, ad_sub, ad_mul, ad_div,
       ad_neg, ad_exp, ad_log, ad_relu, ad_sigmoid,
       backward from math/grad;
include math/optim;
import SGD, sgd_new, sgd_free, sgd_step,
       Adam, adam_new, adam_free, adam_step from math/optim;


# ═══════════════════════════════════════════════════════
# Tests — Matrix Operations
# ═══════════════════════════════════════════════════════

func _test_mat_identity:
    m = mat_identity(3);
    d = mat_get(m, 0, 0);
    o = mat_get(m, 0, 1);
    if d == 1.0 and o == 0.0:
        out vtest_pass();
    end
    out vtest_fail();
end

func _test_mat_new_zeros:
    m = mat_new(2, 3);
    v = mat_get(m, 1, 2);
    if v == 0.0:
        out vtest_pass();
    end
    out vtest_fail();
end

func _test_mat_filled:
    m = mat_filled(2, 2, 5.0);
    v = mat_get(m, 1, 1);
    if v == 5.0:
        out vtest_pass();
    end
    out vtest_fail();
end

func _test_mat_get_set:
    m = mat_new(3, 3);
    mat_set(m, 1, 2, 42.0);
    v = mat_get(m, 1, 2);
    if v == 42.0:
        out vtest_pass();
    end
    out vtest_fail();
end

func _test_mat_rows_cols:
    m = mat_new(4, 5);
    r = mat_rows(m);
    c = mat_cols(m);
    if r == 4 and c == 5:
        out vtest_pass();
    end
    out vtest_fail();
end

func _test_mat_add:
    a = mat_filled(2, 2, 3.0);
    b = mat_filled(2, 2, 7.0);
    c = mat_add(a, b);
    v = mat_get(c, 0, 0);
    if v == 10.0:
        out vtest_pass();
    end
    out vtest_fail();
end

func _test_mat_scale:
    m = mat_filled(2, 2, 4.0);
    s = mat_scale(m, 3.0);
    v = mat_get(s, 0, 0);
    if v == 12.0:
        out vtest_pass();
    end
    out vtest_fail();
end

func _test_mat_mul_identity:
    a = mat_filled(2, 2, 5.0);
    I = mat_identity(2);
    r = mat_mul(a, I);
    v = mat_get(r, 0, 0);
    if v == 5.0:
        out vtest_pass();
    end
    out vtest_fail();
end

func _test_mat_transpose:
    m = mat_new(2, 3);
    mat_set(m, 0, 2, 9.0);
    t = mat_transpose(m);             # 3×2
    v = mat_get(t, 2, 0);
    if v == 9.0:
        out vtest_pass();
    end
    out vtest_fail();
end

func _test_mat_det_identity:
    I = mat_identity(3);
    d = mat_det(I);
    if d == 1.0:
        out vtest_pass();
    end
    out vtest_fail();
end

func _test_mat_trace:
    I = mat_identity(4);
    t = mat_trace(I);
    if t == 4.0:
        out vtest_pass();
    end
    out vtest_fail();
end

func _test_mat_eq:
    a = mat_identity(2);
    b = mat_identity(2);
    if mat_eq(a, b):
        out vtest_pass();
    end
    out vtest_fail();
end

func _test_mat_clone:
    a = mat_filled(2, 2, 3.0);
    b = mat_clone(a);
    mat_set(a, 0, 0, 99.0);          # mutate original
    v = mat_get(b, 0, 0);            # clone untouched
    if v == 3.0:
        out vtest_pass();
    end
    out vtest_fail();
end


# ═══════════════════════════════════════════════════════
# Tests — Gradient / Autodiff
# ═══════════════════════════════════════════════════════

func _test_ad_add:
    tape = tape_new();
    a = scalar(tape, 2.0);
    b = scalar(tape, 3.0);
    c = ad_add(a, b);
    if scalar_val(c) == 5.0:
        out vtest_pass();
    end
    out vtest_fail();
end

func _test_ad_mul:
    tape = tape_new();
    a = scalar(tape, 4.0);
    b = scalar(tape, 5.0);
    c = ad_mul(a, b);
    if scalar_val(c) == 20.0:
        out vtest_pass();
    end
    out vtest_fail();
end

func _test_backward_grad_add:
    tape = tape_new();
    a = scalar(tape, 2.0);
    b = scalar(tape, 3.0);
    c = ad_add(a, b);
    backward(c);
    ga = grad(a);
    gb = grad(b);
    # d(a+b)/da = 1, d(a+b)/db = 1
    if ga == 1.0 and gb == 1.0:
        out vtest_pass();
    end
    out vtest_fail();
end

func _test_backward_grad_mul:
    tape = tape_new();
    a = scalar(tape, 3.0);
    b = scalar(tape, 7.0);
    c = ad_mul(a, b);
    backward(c);
    ga = grad(a);                      # d(a*b)/da = b = 7
    gb = grad(b);                      # d(a*b)/db = a = 3
    if ga == 7.0 and gb == 3.0:
        out vtest_pass();
    end
    out vtest_fail();
end

func _test_backward_chain:
    tape = tape_new();
    x = scalar(tape, 2.0);
    y = scalar(tape, 3.0);
    z = ad_mul(x, y);                 # z = 6
    w = ad_add(z, x);                 # w = 8
    backward(w);
    gx = grad(x);                     # dw/dx = y + 1 = 4
    gy = grad(y);                     # dw/dy = x   = 2
    if gx == 4.0 and gy == 2.0:
        out vtest_pass();
    end
    out vtest_fail();
end

func _test_ad_neg:
    tape = tape_new();
    a = scalar(tape, 5.0);
    b = ad_neg(a);
    if scalar_val(b) == -5.0:
        out vtest_pass();
    end
    out vtest_fail();
end

func _test_ad_relu_positive:
    tape = tape_new();
    a = scalar(tape, 3.0);
    b = ad_relu(a);
    backward(b);
    if scalar_val(b) == 3.0 and grad(a) == 1.0:
        out vtest_pass();
    end
    out vtest_fail();
end

func _test_ad_relu_negative:
    tape = tape_new();
    a = scalar(tape, -2.0);
    b = ad_relu(a);
    backward(b);
    if scalar_val(b) == 0.0 and grad(a) == 0.0:
        out vtest_pass();
    end
    out vtest_fail();
end


# ═══════════════════════════════════════════════════════
# Tests — Optimizers (SGD / Adam construction)
# ═══════════════════════════════════════════════════════

func _test_sgd_new:
    opt = sgd_new(0.01);               # lr = 0.01
    # construction succeeds — smoke test
    out vtest_pass();
end

func _test_adam_new:
    opt = adam_new(0.001);              # lr = 0.001
    out vtest_pass();
end


# ═══════════════════════════════════════════════════════
# Suite Builder & Runner
# ═══════════════════════════════════════════════════════

func vtest_math_suite:
    suite = vtest_suite_new(str_new("math/matrix+grad+optim"));

    # matrix
    suite = vtest_add(suite, str_new("mat identity 3×3"),          _test_mat_identity);
    suite = vtest_add(suite, str_new("mat new 2×3 zeros"),         _test_mat_new_zeros);
    suite = vtest_add(suite, str_new("mat filled 2×2,5"),          _test_mat_filled);
    suite = vtest_add(suite, str_new("mat get/set"),               _test_mat_get_set);
    suite = vtest_add(suite, str_new("mat rows/cols"),             _test_mat_rows_cols);
    suite = vtest_add(suite, str_new("mat add"),                   _test_mat_add);
    suite = vtest_add(suite, str_new("mat scale ×3"),              _test_mat_scale);
    suite = vtest_add(suite, str_new("mat mul A×I = A"),           _test_mat_mul_identity);
    suite = vtest_add(suite, str_new("mat transpose"),             _test_mat_transpose);
    suite = vtest_add(suite, str_new("mat det(I) = 1"),            _test_mat_det_identity);
    suite = vtest_add(suite, str_new("mat trace(I4) = 4"),         _test_mat_trace);
    suite = vtest_add(suite, str_new("mat eq I==I"),               _test_mat_eq);
    suite = vtest_add(suite, str_new("mat clone independent"),     _test_mat_clone);

    # gradient / AD
    suite = vtest_add(suite, str_new("ad add 2+3=5"),             _test_ad_add);
    suite = vtest_add(suite, str_new("ad mul 4×5=20"),             _test_ad_mul);
    suite = vtest_add(suite, str_new("backward grad add"),         _test_backward_grad_add);
    suite = vtest_add(suite, str_new("backward grad mul"),         _test_backward_grad_mul);
    suite = vtest_add(suite, str_new("backward chain rule"),       _test_backward_chain);
    suite = vtest_add(suite, str_new("ad neg 5→−5"),               _test_ad_neg);
    suite = vtest_add(suite, str_new("ad relu positive"),          _test_ad_relu_positive);
    suite = vtest_add(suite, str_new("ad relu negative"),          _test_ad_relu_negative);

    # optimizers
    suite = vtest_add(suite, str_new("sgd_new(0.01)"),             _test_sgd_new);
    suite = vtest_add(suite, str_new("adam_new(0.001)"),           _test_adam_new);
    out suite;
end

func vtest_math_run:
    reg = vtest_registry_new();
    reg = vtest_registry_add_suite(reg, vtest_math_suite());
    report = vtest_registry_run(reg);
    vtest_print_summary(report);
    out vtest_exit_code(report);
end
