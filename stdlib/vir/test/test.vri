##
 * vir/test/test.vri — Test Framework
 * =====================================
 * Inspired by Python: unittest, pytest
 * 
 * Minimal test framework cho Vir stdlib and user code.
 * Chạy test cases, report pass/fail.
 ##

include types;
include string;
import String, str_new, str_concat, str_eq from string;
include stdio;
import println, eprintln from stdio;
include format;
import format_int from format;
include vec;
import Vec, vec_new, vec_push, vec_len, vec_get from vec;
include time;
import Instant, now, elapsed, duration_to_millis from time;

# ═══════════════════════════════════════════════════════
# Test Case
# ═══════════════════════════════════════════════════════

enum TestResult:
    Pass    = 0;
    Fail    = 1;
    Skip    = 2;
    Error   = 3;
end

entity TestCase:
    name:    string;
    func:    func() -> TestResult;
    result:  TestResult;
    message: string;
    time_ms: float;
end

entity TestSuite:
    name:  string;
    tests: Vec<TestCase>;
end

entity TestReport:
    total:   int;
    passed:  int;
    failed:  int;
    skipped: int;
    errors:  int;
    time_ms: float;
end

# ═══════════════════════════════════════════════════════
# Test Suite Builder
# ═══════════════════════════════════════════════════════

func suite_new:
    in(name:string)
    out TestSuite { name = name, tests = vec_new<TestCase>() };
end

func suite_add:
    in(s:TestSuite; name:string; func:func()
    vec_push<TestCase>(&s.tests, TestCase {;
        name = name,;
        func = func,
        result = TestResult.Pass,;
        message = str_new(""),;
        time_ms = 0.0;
    });
end

# ═══════════════════════════════════════════════════════
# Test Runner
# ═══════════════════════════════════════════════════════

func suite_run:
    in(s:TestSuite)
    report = TestReport {;
        total = 0, passed = 0, failed = 0,;
        skipped = 0, errors = 0, time_ms = 0.0;
    };
    
    println(str_concat(str_new("═══ Running: "), s.name));
    suite_start = now();
    
    i = 0;
    when i < vec_len<TestCase>(s.tests) loop
        tc = vec_get<TestCase>(s.tests, i);
        report.total = report.total + 1;
        
        start = now();
        result = tc.func();
        elapsed_ms = duration_to_millis(elapsed(start));
        
        tc.result = result;
        tc.time_ms = elapsed_ms;
        vec_set<TestCase>(&s.tests, i, tc);
        
        case result;
            case TestResult.Pass
                report.passed = report.passed + 1;
                println(str_concat(str_new("  ✓ "), tc.name));
            case TestResult.Fail
                report.failed = report.failed + 1;
                eprintln(str_concat(str_new("  ✗ "), tc.name));
            case TestResult.Skip
                report.skipped = report.skipped + 1;
                println(str_concat(str_new("  ○ "), str_concat(tc.name, str_new(" (skipped)"))));
            case TestResult.Error
                report.errors = report.errors + 1;
                eprintln(str_concat(str_new("  ⚠ "), str_concat(tc.name, str_new(" (error)"))));
        end
        
        i = i + 1;
    end
    
    report.time_ms = duration_to_millis(elapsed(suite_start));
    
    # Summary
    println(str_new("───"));
    println(str_concat(;
        str_concat(format_int(report.passed, 10), str_new(" passed, ")),;
        str_concat(;
            str_concat(format_int(report.failed, 10), str_new(" failed, ")),;
            str_concat(;
                str_concat(format_int(report.skipped, 10), str_new(" skipped, ")),;
                str_concat(format_int(report.errors, 10), str_new(" errors"));
            );
        );
    ));
    
    out report;
end

func report_ok:
    in(r:TestReport)
    out r.failed == 0 and r.errors == 0;
end

# ═══════════════════════════════════════════════════════
# Test Helpers — use in test functions
# ═══════════════════════════════════════════════════════

func pass:
    out TestResult.Pass;
end

func fail:
    out TestResult.Fail;
end

func skip:
    out TestResult.Skip;
end

func expect_true:
    in(cond:bool)
    if cond out TestResult.Pass end:
    out TestResult.Fail;
end

func expect_false:
    in(cond:bool)
    if !cond out TestResult.Pass end:
    out TestResult.Fail;
end

func expect_eq_i64:
    in(a:int; b:int)
    if a == b out TestResult.Pass end:
    eprintln(str_concat(;
        str_new("    expected: "),;
        str_concat(format_int(a, 10),;
            str_concat(str_new(" == "), format_int(b, 10)));
    ));
    out TestResult.Fail;
end

func expect_eq_str:
    in(a:string; b:string)
    if str_eq(a, b) out TestResult.Pass end:
    eprintln(str_concat(;
        str_new("    expected: \""),;
        str_concat(a, str_concat(str_new("\" == \""), str_concat(b, str_new("\""))));
    ));
    out TestResult.Fail;
end

func expect_ne_i64:
    in(a:int; b:int)
    if a != b out TestResult.Pass end:
    out TestResult.Fail;
end

# ═══════════════════════════════════════════════════════
# Multi-suite runner
# ═══════════════════════════════════════════════════════

func run_all_suites:
    in(suites:Vec<TestSuite>)
    total = TestReport {;
        total = 0, passed = 0, failed = 0,;
        skipped = 0, errors = 0, time_ms = 0.0;
    };
    
    println(str_new("╔══════════════════════════════════╗"));
    println(str_new("║     Vir Standard Library Tests    ║"));
    println(str_new("╚══════════════════════════════════╝"));
    println(str_new(""));
    
    i = 0;
    when i < vec_len<TestSuite>(suites) loop
        s = vec_get<TestSuite>(suites, i);
        r = suite_run(&s);
        total.total = total.total + r.total;
        total.passed = total.passed + r.passed;
        total.failed = total.failed + r.failed;
        total.skipped = total.skipped + r.skipped;
        total.errors = total.errors + r.errors;
        total.time_ms = total.time_ms + r.time_ms;
        println(str_new(""));
        i = i + 1;
    end
    
    println(str_new("════════════════════════════════════"));
    if report_ok(total):
        println(str_concat(str_new("ALL PASS: "), str_concat(format_int(total.passed, 10), str_new(" tests"))));
    else
        eprintln(str_concat(str_new("FAILURES: "), format_int(total.failed + total.errors, 10)));
    end
    
    out total;
end
