##
 * vir/test/proptest.vri — Property-Based Testing
 * =================================================
 * Inspired by: Haskell QuickCheck, Rust proptest
 *
 * Random value generators, shrinking, property execution,
 * test case minimization on failure.
 ##

include types;
include option;
import Option, Some, None from option;
include vec;
import Vec, vec_new, vec_push, vec_len, vec_get from vec;

# ═══════════════════════════════════════════════════════
# PRNG (xorshift64)
# ═══════════════════════════════════════════════════════

entity Rng:
    state: int;
end

func rng_new:
    in(seed: int)
    s = seed;
    if s == 0:
        s = 88172645463325252;
    end
    out Rng { state: s };
end

func rng_next:
    in(rng: Rng)
    x = rng.state;
    x = x ^ (x * 8192);        # << 13
    x = x ^ (x / 128);         # >> 7
    x = x ^ (x * 131072);      # << 17
    if x < 0:
        x = 0 - x;
    end
    rng.state = x;
    out x;
end

func rng_range:
    in(rng: Rng; min_val: int; max_val: int)
    r = rng_next(rng);
    range = max_val - min_val + 1;
    out min_val + (r % range);
end

# ═══════════════════════════════════════════════════════
# Generators
# ═══════════════════════════════════════════════════════

func gen_int:
    in(rng: Rng; min_val: int; max_val: int)
    out rng_range(rng, min_val, max_val);
end

func gen_bool:
    in(rng: Rng)
    out (rng_next(rng) % 2) == 0;
end

func gen_ascii_char:
    in(rng: Rng)
    out rng_range(rng, 32, 126);
end

func gen_string:
    in(rng: Rng; max_len: int)
    n = rng_range(rng, 0, max_len);
    chars = vec_new();
    i = 0;
    when i < n loop
        vec_push(chars, gen_ascii_char(rng));
        i = i + 1;
    end
    out chars;  # Vec<int> of char codes
end

func gen_vec_int:
    in(rng: Rng; max_len: int; min_val: int; max_val: int)
    n = rng_range(rng, 0, max_len);
    v = vec_new();
    i = 0;
    when i < n loop
        vec_push(v, gen_int(rng, min_val, max_val));
        i = i + 1;
    end
    out v;
end

# ═══════════════════════════════════════════════════════
# Shrinking
# ═══════════════════════════════════════════════════════

func shrink_int:
    in(value: int)
    # Generate candidate shrinks toward 0
    candidates = vec_new();
    if value == 0:
        out candidates;
    end
    vec_push(candidates, 0);
    half = value / 2;
    if half != 0 && half != value:
        vec_push(candidates, half);
    end
    if value > 0:
        vec_push(candidates, value - 1);
    else:
        vec_push(candidates, value + 1);
    end
    out candidates;
end

func shrink_vec:
    in(v: Vec)
    # Shrink by removing elements
    candidates = vec_new();
    n = vec_len(v);
    if n == 0:
        out candidates;
    end
    # Empty vec
    vec_push(candidates, vec_new());
    # Remove one element at a time
    i = 0;
    when i < n loop
        sub = vec_new();
        j = 0;
        when j < n loop
            if j != i:
                vec_push(sub, vec_get(v, j));
            end
            j = j + 1;
        end
        vec_push(candidates, sub);
        i = i + 1;
    end
    # First half, second half
    if n > 2:
        half1 = vec_new();
        half2 = vec_new();
        mid = n / 2;
        i = 0;
        when i < mid loop
            vec_push(half1, vec_get(v, i));
            i = i + 1;
        end
        when i < n loop
            vec_push(half2, vec_get(v, i));
            i = i + 1;
        end
        vec_push(candidates, half1);
        vec_push(candidates, half2);
    end
    out candidates;
end

# ═══════════════════════════════════════════════════════
# Property test result
# ═══════════════════════════════════════════════════════

entity PropResult:
    passed:      bool;
    num_tests:   int;
    num_shrinks: int;
    failing_input: string;
    message:     string;
end

# ═══════════════════════════════════════════════════════
# Property execution — integer property
# ═══════════════════════════════════════════════════════

func prop_check_int:
    in(prop: func(int) bool; num_tests: int; seed: int;
       min_val: int; max_val: int)
    rng = rng_new(seed);
    i = 0;
    when i < num_tests loop
        val = gen_int(rng, min_val, max_val);
        result = prop(val);
        if result == false:
            # Shrink
            shrinks = 0;
            smallest = val;
            candidates = shrink_int(val);
            ci = 0;
            when ci < vec_len(candidates) loop
                c = vec_get(candidates, ci);
                if c >= min_val && c <= max_val:
                    if prop(c) == false:
                        smallest = c;
                        shrinks = shrinks + 1;
                        candidates = shrink_int(c);
                        ci = 0;
                    else:
                        ci = ci + 1;
                    end
                else:
                    ci = ci + 1;
                end
            end
            out PropResult {
                passed: false, num_tests: i + 1,
                num_shrinks: shrinks,
                failing_input: int_to_str(smallest),
                message: "Failed after " + int_to_str(i + 1) + " tests"
            };
        end
        i = i + 1;
    end
    out PropResult {
        passed: true, num_tests: num_tests,
        num_shrinks: 0, failing_input: "",
        message: "OK, passed " + int_to_str(num_tests) + " tests"
    };
end

# ═══════════════════════════════════════════════════════
# Property execution — Vec<int> property
# ═══════════════════════════════════════════════════════

func prop_check_vec:
    in(prop: func(Vec) bool; num_tests: int; seed: int;
       max_len: int; min_val: int; max_val: int)
    rng = rng_new(seed);
    i = 0;
    when i < num_tests loop
        val = gen_vec_int(rng, max_len, min_val, max_val);
        if prop(val) == false:
            # Shrink
            shrinks = 0;
            smallest = val;
            candidates = shrink_vec(val);
            ci = 0;
            when ci < vec_len(candidates) loop
                c = vec_get(candidates, ci);
                if prop(c) == false:
                    smallest = c;
                    shrinks = shrinks + 1;
                    candidates = shrink_vec(c);
                    ci = 0;
                else:
                    ci = ci + 1;
                end
            end
            out PropResult {
                passed: false, num_tests: i + 1,
                num_shrinks: shrinks,
                failing_input: "Vec[len=" + int_to_str(vec_len(smallest)) + "]",
                message: "Failed after " + int_to_str(i + 1) + " tests"
            };
        end
        i = i + 1;
    end
    out PropResult {
        passed: true, num_tests: num_tests,
        num_shrinks: 0, failing_input: "",
        message: "OK, passed " + int_to_str(num_tests) + " tests"
    };
end
