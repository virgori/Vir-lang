##
 * vir/test/data_profile_vtest.vri — VTest suite for Data Loading & Profiling
 * ===========================================================================
 * Port of test_virdata.py + test_virprof.py → pure Vir vtest.
 * Covers:  Dataset construction, DataLoader batching, Profiler lifecycle.
 ##

include types;
include string;
import String, str_new, str_eq from string;
include alloc;
import alloc, alloc_zeroed, free from alloc;
include test;
import TestSuite, TestResult from test;
include vtest;
import VTestRegistry,
       vtest_suite_new, vtest_add,
       vtest_registry_new, vtest_registry_add_suite, vtest_registry_run,
       vtest_print_summary, vtest_exit_code,
       vtest_pass, vtest_fail,
       vtest_expect_true, vtest_expect_false,
       vtest_expect_eq_i64, vtest_expect_ne_i64 from vtest;
include ai/data;
import Dataset, DataLoader, Batch,
       dataset_new, dataset_get_sample, dataset_get_label,
       dataloader_new, dataloader_reset, dataloader_next,
       batch_free, dataloader_free from ai/data;
include profile/profile;
import Profiler, ProfileEntry,
       profiler_init, profiler_enable,
       profile_enter, profile_exit,
       profiler_report, profiler_reset from profile/profile;


# ═══════════════════════════════════════════════════════
# Tests — Dataset
# ═══════════════════════════════════════════════════════

func _test_dataset_new:
    # 4 samples, 3 floats each, no labels
    data = alloc_zeroed(4 * 3 * 8);
    ds = dataset_new(data, none, 4, 3, 0);
    if ds.n_samples == 4 and ds.sample_size == 3 do
        out vtest_pass();
    end
    out vtest_fail();
end.

func _test_dataset_with_labels:
    data = alloc_zeroed(10 * 2 * 8);
    labels = alloc_zeroed(10 * 1 * 8);
    ds = dataset_new(data, labels, 10, 2, 1);
    if ds.label_size == 1 and ds.n_samples == 10 do
        out vtest_pass();
    end
    out vtest_fail();
end.

func _test_dataset_get_sample_ptr:
    data = alloc_zeroed(4 * 3 * 8);
    ds = dataset_new(data, none, 4, 3, 0);
    p = dataset_get_sample(ds, 0);
    if p == data do
        out vtest_pass();
    end
    out vtest_fail();
end


# ═══════════════════════════════════════════════════════
# Tests — DataLoader
# ═══════════════════════════════════════════════════════

func _test_dataloader_new:
    data = alloc_zeroed(8 * 2 * 8);
    ds = dataset_new(data, none, 8, 2, 0);
    dl = dataloader_new(ds, 4, false);
    if dl.batch_size == 4 and dl.n_batches == 2 do
        out vtest_pass();
    end
    out vtest_fail();
end.

func _test_dataloader_next_first:
    data = alloc_zeroed(6 * 2 * 8);
    ds = dataset_new(data, none, 6, 2, 0);
    dl = dataloader_new(ds, 3, false);
    batch = dataloader_next(dl);
    if batch.size == 3 do
        batch_free(batch);
        out vtest_pass();
    end
    out vtest_fail();
end.

func _test_dataloader_exhaustion:
    data = alloc_zeroed(4 * 1 * 8);
    ds = dataset_new(data, none, 4, 1, 0);
    dl = dataloader_new(ds, 4, false);
    b1 = dataloader_next(dl);
    batch_free(b1);
    b2 = dataloader_next(dl);
    if b2 == none do
        out vtest_pass();
    end
    out vtest_fail();
end.

func _test_dataloader_reset:
    data = alloc_zeroed(4 * 1 * 8);
    ds = dataset_new(data, none, 4, 1, 0);
    dl = dataloader_new(ds, 4, false);
    b1 = dataloader_next(dl);
    batch_free(b1);
    dataloader_reset(dl);
    b2 = dataloader_next(dl);
    if b2.size == 4 do
        batch_free(b2);
        out vtest_pass();
    end
    out vtest_fail();
end.

func _test_dataloader_last_batch_partial:
    data = alloc_zeroed(5 * 1 * 8);
    ds = dataset_new(data, none, 5, 1, 0);
    dl = dataloader_new(ds, 3, false);
    b1 = dataloader_next(dl);          # 3 items
    batch_free(b1);
    b2 = dataloader_next(dl);          # 2 items (partial)
    if b2.size == 2 do
        batch_free(b2);
        out vtest_pass();
    end
    out vtest_fail();
end


# ═══════════════════════════════════════════════════════
# Tests — Profiler
# ═══════════════════════════════════════════════════════

func _test_profiler_init:
    profiler_init();
    out vtest_pass();
end.

func _test_profiler_enable:
    profiler_init();
    profiler_enable(true);
    out vtest_pass();
end.

func _test_profiler_enter_exit_cycle:
    profiler_init();
    profiler_enable(true);
    profile_enter(str_new("test_section"));
    profile_exit();
    out vtest_pass();
end.

func _test_profiler_reset:
    profiler_init();
    profiler_enable(true);
    profile_enter(str_new("section"));
    profile_exit();
    profiler_reset();
    out vtest_pass();
end.

func _test_profiler_nested_sections:
    profiler_init();
    profiler_enable(true);
    profile_enter(str_new("outer"));
    profile_enter(str_new("inner"));
    profile_exit();
    profile_exit();
    out vtest_pass();
end


# ═══════════════════════════════════════════════════════
# Suite Builder & Runner
# ═══════════════════════════════════════════════════════

func vtest_data_profile_suite:
    suite = vtest_suite_new(str_new("ai/data+profile"));

    # dataset
    suite = vtest_add(suite, str_new("dataset new 4×3"),            _test_dataset_new);
    suite = vtest_add(suite, str_new("dataset with labels"),        _test_dataset_with_labels);
    suite = vtest_add(suite, str_new("dataset get sample ptr"),     _test_dataset_get_sample_ptr);

    # dataloader
    suite = vtest_add(suite, str_new("dataloader new 8/4=2"),       _test_dataloader_new);
    suite = vtest_add(suite, str_new("dataloader next first"),      _test_dataloader_next_first);
    suite = vtest_add(suite, str_new("dataloader exhaustion"),      _test_dataloader_exhaustion);
    suite = vtest_add(suite, str_new("dataloader reset"),           _test_dataloader_reset);
    suite = vtest_add(suite, str_new("dataloader partial batch"),   _test_dataloader_last_batch_partial);

    # profiler
    suite = vtest_add(suite, str_new("profiler init"),              _test_profiler_init);
    suite = vtest_add(suite, str_new("profiler enable"),            _test_profiler_enable);
    suite = vtest_add(suite, str_new("profiler enter/exit"),        _test_profiler_enter_exit_cycle);
    suite = vtest_add(suite, str_new("profiler reset"),             _test_profiler_reset);
    suite = vtest_add(suite, str_new("profiler nested sections"),   _test_profiler_nested_sections);
    out suite;
end.

func vtest_data_profile_run:
    reg = vtest_registry_new();
    reg = vtest_registry_add_suite(reg, vtest_data_profile_suite());
    report = vtest_registry_run(reg);
    vtest_print_summary(report);
    out vtest_exit_code(report);
end
