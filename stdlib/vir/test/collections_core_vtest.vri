include types
include option
import Some, None from option
include map
import map_int, map_insert, map_get, map_len from map

func main:
    m = map_int()
    map_insert(m, 1, 10)
    map_insert(m, 2, 20)
    got = map_get(m, 1)
    case got
        Some(v):
            if v != 10 do out 1 end
        None: out 2
    end
    if map_len(m) != 2 do out 3 end
    out 0
end.
