##
 * vir/env/env.vri — Production-Grade Environment API (Pure Vir, Zero Libc)
 * ======================================================================
 * Strict namespace-first environment variables API.
 * Uses entity EnvNamespace with global instance `env`.
 ##

include types
include option
import Option, Some, None from option
include result
import Result, Ok, Err from result
include alloc
import vir_alloc, vir_free from alloc
include vec_rt
import vec_new_rt, vec_push_rt, vec_get_rt, vec_set_rt, vec_len_rt from vec_rt

extern func native_read_u8(addr: int, offset: int) -> int
extern func native_write_u8(addr: int, offset: int, val: int)
extern func native_read_i64(addr: int, offset: int) -> int
extern func native_write_i64(addr: int, offset: int, val: int)
extern func _NSGetEnviron() -> int
extern func sys_platform() -> int
extern func sys_exit(code: int)

enum OS:
    MacOS = 1
    Linux = 2
    Windows = 3
    FreeBSD = 4
    Unknown = 0
end.

enum Arch:
    ARM64 = 1
    X86_64 = 2
    RISCV64 = 3
    Unknown = 0
end.

enum Platform:
    MacOS_ARM64    = 0
    MacOS_x86_64   = 1
    Linux_ARM64    = 2
    Linux_x86_64   = 3
    Linux_RISCV64  = 4
    Wasm32_WASI_P1 = 5
end.

func current_os:
    let plat = sys_platform()
    if plat == Platform.MacOS_ARM64 or plat == Platform.MacOS_x86_64 do
        out OS.MacOS
    eif plat == Platform.Linux_ARM64 or plat == Platform.Linux_x86_64 or plat == Platform.Linux_RISCV64 do
        out OS.Linux
    else
        out OS.Unknown
    end
end.

func current_arch:
    let plat = sys_platform()
    if plat == Platform.MacOS_ARM64 or plat == Platform.Linux_ARM64 do
        out Arch.ARM64
    eif plat == Platform.MacOS_x86_64 or plat == Platform.Linux_x86_64 do
        out Arch.X86_64
    eif plat == Platform.Linux_RISCV64 do
        out Arch.RISCV64
    else
        out Arch.Unknown
    end
end.

func os_name:
    case current_os()
        OS.MacOS: out "macOS"
        OS.Linux: out "Linux"
        OS.Windows: out "Windows"
        else out "Unknown"
    end
end.

func arch_name:
    case current_arch()
        Arch.ARM64: out "arm64"
        Arch.X86_64: out "x86_64"
        Arch.RISCV64: out "riscv64"
        else out "unknown"
    end
end.

# ── Low-level Environment Storage ──

var g_env_keys: int = 0
var g_env_vals: int = 0
var g_env_active: int = 0
var g_env_inited: int = 0

func rt_str_len(p: int) -> int:
    if p == 0 do out 0 end
    var i = 0
    when native_read_u8(p, i) != 0 loop
        i = i + 1
    end
    out i
end.

func rt_str_eq(a: int, b: int) -> bool:
    if a == b do out true end
    if a == 0 or b == 0 do out false end
    var i = 0
    loop
        let ca = native_read_u8(a, i)
        let cb = native_read_u8(b, i)
        if ca != cb do out false end
        if ca == 0 do out true end
        i = i + 1
    end
    out true
end.

func rt_copy_str(src: int, len: int) -> int:
    let buf = vir_alloc(len + 1)
    var i = 0
    when i < len loop
        native_write_u8(buf, i, native_read_u8(src, i))
        i = i + 1
    end
    native_write_u8(buf, len, 0)
    out buf
end.

func rt_clone_str(src: int) -> int:
    if src == 0 do out 0 end
    let len = rt_str_len(src)
    out rt_copy_str(src, len)
end.

func rt_env_init:
    if g_env_inited != 0 do out end
    g_env_keys = vec_new_rt()
    g_env_vals = vec_new_rt()
    g_env_active = vec_new_rt()
    g_env_inited = 1

    let plat = sys_platform()
    if plat == Platform.MacOS_ARM64 or plat == Platform.MacOS_x86_64 do
        let pp = _NSGetEnviron()
        if pp != 0 do
            let p = native_read_i64(pp, 0)
            if p != 0 do
                var idx = 0
                loop
                    let entry_p = native_read_i64(p, idx * 8)
                    if entry_p == 0 do break end
                    let n = rt_str_len(entry_p)
                    var eq_pos = 0 - 1
                    var i = 0
                    when i < n loop
                        if native_read_u8(entry_p, i) == 61 do
                            eq_pos = i
                            break
                        end
                        i = i + 1
                    end
                    if eq_pos >= 0 do
                        let k = rt_copy_str(entry_p, eq_pos)
                        let v = rt_copy_str(entry_p + eq_pos + 1, n - eq_pos - 1)
                        g_env_keys = vec_push_rt(g_env_keys, k)
                        g_env_vals = vec_push_rt(g_env_vals, v)
                        g_env_active = vec_push_rt(g_env_active, 1)
                    end
                    idx = idx + 1
                end
            end
        end
    else
        extern func syscall3(num: int, a0: int, a1: int, a2: int) -> int
        extern func syscall1(num: int, a0: int) -> int
        let proc_path = "/proc/self/environ"
        let fd = syscall3(5, proc_path as int, 0, 0)
        if fd >= 0 do
            let buf_size = 65536
            let buf = vir_alloc(buf_size)
            var total = 0
            loop
                let n = syscall3(3, fd, buf + total, buf_size - total)
                if n <= 0 do break end
                total = total + n
                if total >= buf_size do break end
            end
            syscall1(6, fd)

            var entry_start = 0
            var i = 0
            when i < total loop
                let b = native_read_u8(buf, i)
                if b == 0 do
                    let entry_len = i - entry_start
                    if entry_len > 0 do
                        var eq_pos = 0 - 1
                        var j = 0
                        when j < entry_len loop
                            if native_read_u8(buf, entry_start + j) == 61 do
                                eq_pos = j
                                break
                            end
                            j = j + 1
                        end
                        if eq_pos >= 0 do
                            let k = rt_copy_str(buf + entry_start, eq_pos)
                            let v = rt_copy_str(buf + entry_start + eq_pos + 1, entry_len - eq_pos - 1)
                            g_env_keys = vec_push_rt(g_env_keys, k)
                            g_env_vals = vec_push_rt(g_env_vals, v)
                            g_env_active = vec_push_rt(g_env_active, 1)
                        end
                    end
                    entry_start = i + 1
                end
                i = i + 1
            end
        end
    end
end.

func rt_env_find(name: int) -> int:
    rt_env_init()
    let n = vec_len_rt(g_env_keys)
    var i = 0
    when i < n loop
        if vec_get_rt(g_env_active, i) != 0 do
            let k = vec_get_rt(g_env_keys, i)
            if rt_str_eq(k, name) do
                out i
            end
        end
        i = i + 1
    end
    out 0 - 1
end.

func rt_env_get(name: int) -> Option:
    rt_env_init()
    let idx = rt_env_find(name)
    if idx >= 0 do
        let v = vec_get_rt(g_env_vals, idx)
        let cloned = rt_clone_str(v)
        out Option.Some(cloned as string)
    end
    out Option.None
end.

func rt_env_has(name: int) -> bool:
    rt_env_init()
    out rt_env_find(name) >= 0
end.

func rt_env_set(name: int, val: int) -> Result:
    rt_env_init()
    let nlen = rt_str_len(name)
    if nlen == 0 do
        out Result.Err("environment variable name cannot be empty")
    end
    var i = 0
    when i < nlen loop
        let ch = native_read_u8(name, i)
        if ch == 61 do
            out Result.Err("environment variable name cannot contain =")
        end
        if ch == 0 do
            out Result.Err("environment variable name cannot contain NUL")
        end
        i = i + 1
    end

    let vlen = rt_str_len(val)
    var j = 0
    when j < vlen loop
        if native_read_u8(val, j) == 0 do
            out Result.Err("environment variable value cannot contain NUL")
        end
        j = j + 1
    end

    let idx = rt_env_find(name)
    let cloned_val = rt_copy_str(val, vlen)
    if idx >= 0 do
        vec_set_rt(g_env_vals, idx, cloned_val)
        vec_set_rt(g_env_active, idx, 1)
    else
        let cloned_key = rt_copy_str(name, nlen)
        g_env_keys = vec_push_rt(g_env_keys, cloned_key)
        g_env_vals = vec_push_rt(g_env_vals, cloned_val)
        g_env_active = vec_push_rt(g_env_active, 1)
    end
    out Result.Ok(0)
end.

func rt_env_unset(name: int) -> Result:
    rt_env_init()
    let idx = rt_env_find(name)
    if idx >= 0 do
        vec_set_rt(g_env_active, idx, 0)
    end
    out Result.Ok(0)
end.

func rt_env_count -> int:
    rt_env_init()
    let n = vec_len_rt(g_env_active)
    var count = 0
    var i = 0
    when i < n loop
        if vec_get_rt(g_env_active, i) != 0 do
            count = count + 1
        end
        i = i + 1
    end
    out count
end.

func rt_env_key_at(active_idx: int) -> string:
    rt_env_init()
    let n = vec_len_rt(g_env_active)
    var seen = 0
    var i = 0
    when i < n loop
        if vec_get_rt(g_env_active, i) != 0 do
            if seen == active_idx do
                let k = vec_get_rt(g_env_keys, i)
                out rt_clone_str(k) as string
            end
            seen = seen + 1
        end
        i = i + 1
    end
    out ""
end.

func rt_env_val_at(active_idx: int) -> string:
    rt_env_init()
    let n = vec_len_rt(g_env_active)
    var seen = 0
    var i = 0
    when i < n loop
        if vec_get_rt(g_env_active, i) != 0 do
            if seen == active_idx do
                let v = vec_get_rt(g_env_vals, i)
                out rt_clone_str(v) as string
            end
            seen = seen + 1
        end
        i = i + 1
    end
    out ""
end.

func rt_env_clear:
    rt_env_init()
    let n = vec_len_rt(g_env_active)
    var i = 0
    when i < n loop
        vec_set_rt(g_env_active, i, 0)
        i = i + 1
    end
end.

func env_join_kv(k: int, val: int) -> string:
    let klen = rt_str_len(k)
    let vlen = rt_str_len(val)
    let total = klen + 1 + vlen
    let buf = vir_alloc(total + 1)
    var i = 0
    when i < klen loop
        native_write_u8(buf, i, native_read_u8(k, i))
        i = i + 1
    end
    native_write_u8(buf, klen, 61)
    var j = 0
    when j < vlen loop
        native_write_u8(buf, klen + 1 + j, native_read_u8(val, j))
        j = j + 1
    end
    native_write_u8(buf, total, 0)
    out buf as string
end.

func envParseInt(value: string, fallback: int) -> int:
    let opt = envParseIntOpt(value)
    case opt
        Option.Some(n): out n
        Option.None: out fallback
    end
    out fallback
end.

# Registry: env.int(key) -> Option(int) — None on missing / empty / non-digit.
func envParseIntOpt(value: string):
    let length = rt_str_len(value as int)
    if length == 0 do
        out Option.None
    end

    var
        result = 0
        sign = 1
        index = 0
        hasDigit = false

    let first = native_read_u8(value as int, 0)
    if first == 45 do
        sign = 0 - 1
        index = 1
    eif first == 43 do
        index = 1
    end

    when index < length loop
        let byte = native_read_u8(value as int, index)
        if byte >= 48 & byte <= 57 do
            result = result * 10 + (byte - 48)
            hasDigit = true
        else
            out Option.None
        end
        index = index + 1
    end

    if hasDigit do
        out Option.Some(result * sign)
    end
    out Option.None
end.

func envBoolOpt(value: string):
    let p = value as int
    if env_str_eq_ci(p, "true" as int) or env_str_eq_ci(p, "1" as int) or env_str_eq_ci(p, "yes" as int) or env_str_eq_ci(p, "on" as int) do
        out Option.Some(true)
    end
    if env_str_eq_ci(p, "false" as int) or env_str_eq_ci(p, "0" as int) or env_str_eq_ci(p, "no" as int) or env_str_eq_ci(p, "off" as int) do
        out Option.Some(false)
    end
    out Option.None
end.

func env_str_eq_ci(a: int, b: int) -> bool:
    if a == b do out true end
    if a == 0 or b == 0 do out false end
    var i = 0
    loop
        var ca = native_read_u8(a, i)
        var cb = native_read_u8(b, i)
        if ca >= 65 and ca <= 90 do ca = ca + 32 end
        if cb >= 65 and cb <= 90 do cb = cb + 32 end
        if ca != cb do out false end
        if ca == 0 do out true end
        i = i + 1
    end
    out true
end.

func env_missing_err(key: string) -> string:
    let prefix = "Missing required environment variable: "
    let plen = rt_str_len(prefix as int)
    let klen = rt_str_len(key as int)
    let buf = vir_alloc(plen + klen + 1)
    var i = 0
    when i < plen loop
        native_write_u8(buf, i, native_read_u8(prefix as int, i))
        i = i + 1
    end
    var j = 0
    when j < klen loop
        native_write_u8(buf, plen + j, native_read_u8(key as int, j))
        j = j + 1
    end
    native_write_u8(buf, plen + klen, 0)
    out buf as string
end.

func env_int(key: string, default: int) -> int:
    let opt = rt_env_get(key as int)
    case opt
        Option.Some(v): out envParseInt(v as string, default)
        Option.None: out default
    end
    out default
end.

func env_str(key: string, default: string) -> string:
    let opt = rt_env_get(key as int)
    case opt
        Option.Some(v): out v as string
        Option.None: out default
    end
    out default
end.

func env_bool(key: string, default: bool) -> bool:
    let opt = rt_env_get(key as int)
    case opt
        Option.Some(v):
            let parsed = envBoolOpt(v as string)
            case parsed
                Option.Some(b): out b
                Option.None: out default
            end
            out default
        Option.None:
            out default
    end
    out default
end.

func env_require(key: string):
    let opt = rt_env_get(key as int)
    case opt
        Option.Some(v): out Result.Ok(v as string)
        Option.None: out Result.Err(env_missing_err(key))
    end
end.

# ── Namespace-first Public API ──

entity EnvNamespace:
    method get(key: string):
        out rt_env_get(key as int)
    end.
    # Registry/SPEC: env.or — blocked (Vir keyword `or`).
    # Same shape as option.unwrapOr / result.unwrapOr → canonical: unwrapOr.
    # previous: get_or, getOr (mistaken interim name)
    method unwrapOr(key: string, fallback: string) -> string:
        let opt = rt_env_get(key as int)
        case opt
            Option.Some(v): out v as string
            Option.None: out fallback
        end
        out fallback
    end.
    method get_or(key: string, fallback: string) -> string:
        out this.unwrapOr(key, fallback)
    end.
    # Registry: env.int(key) -> Option(int)
    method int(key: string):
        let opt = rt_env_get(key as int)
        case opt
            Option.Some(v): out envParseIntOpt(v as string)
            Option.None: out Option.None
        end
        out Option.None
    end.
    method str(key: string, default: string) -> string:
        out env_str(key, default)
    end.
    method string(key: string, default: string) -> string:
        out env_str(key, default)
    end.
    # Registry: env.bool(key) -> Option(bool)
    method bool(key: string):
        let opt = rt_env_get(key as int)
        case opt
            Option.Some(v): out envBoolOpt(v as string)
            Option.None: out Option.None
        end
        out Option.None
    end.
    method require(key: string):
        out env_require(key)
    end.
    method set(key: string, val: string):
        out rt_env_set(key as int, val as int)
    end.
    method remove(key: string):
        out rt_env_unset(key as int)
    end.
    method has(key: string) -> bool:
        out rt_env_has(key as int)
    end.
    method args():
        let n = arg_count()
        var v = vec_new_rt()
        var i = 0
        when i < n loop
            let a = get_arg(i)
            v = vec_push_rt(v, a as int)
            i = i + 1
        end
        out v
    end.
    method name() -> string:
        if arg_count() > 0 do
            out get_arg(0)
        end
        out ""
    end.
    method cwd() -> string:
        out env_cwd()
    end.
    method home() -> string:
        out this.unwrapOr("HOME", "")
    end.
    method temp() -> string:
        out this.unwrapOr("TMPDIR", "/tmp")
    end.
    method vars() -> int:
        let cnt = rt_env_count()
        var v = vec_new_rt()
        var i = 0
        when i < cnt loop
            let k = rt_env_key_at(i)
            let val = rt_env_val_at(i)
            let item = env_join_kv(k as int, val as int)
            v = vec_push_rt(v, item as int)
            i = i + 1
        end
        out v
    end.
    method keys() -> int:
        let cnt = rt_env_count()
        var v = vec_new_rt()
        var i = 0
        when i < cnt loop
            let k = rt_env_key_at(i)
            v = vec_push_rt(v, k as int)
            i = i + 1
        end
        out v
    end.
    method values() -> int:
        let cnt = rt_env_count()
        var v = vec_new_rt()
        var i = 0
        when i < cnt loop
            let val = rt_env_val_at(i)
            v = vec_push_rt(v, val as int)
            i = i + 1
        end
        out v
    end.
    method count() -> int:
        out rt_env_count()
    end.
    method clear():
        rt_env_clear()
    end.
end.

var env: EnvNamespace

func get(key: string):
    out rt_env_get(key as int)
end.

func get_or(key: string, fallback: string):
    let opt = rt_env_get(key as int)
    case opt
        Option.Some(v): out v as string
        Option.None: out fallback
    end
    out fallback
end.

func has(key: string):
    out rt_env_has(key as int)
end.

func set(key: string, val: string):
    out rt_env_set(key as int, val as int)
end.

func remove(key: string):
    out rt_env_unset(key as int)
end.

func keys:
    let cnt = rt_env_count()
    var v = vec_new_rt()
    var i = 0
    when i < cnt loop
        let k = rt_env_key_at(i)
        v = vec_push_rt(v, k as int)
        i = i + 1
    end
    out v
end.

func values:
    let cnt = rt_env_count()
    var v = vec_new_rt()
    var i = 0
    when i < cnt loop
        let val = rt_env_val_at(i)
        v = vec_push_rt(v, val as int)
        i = i + 1
    end
    out v
end.

func count:
    out rt_env_count()
end.

func clear:
    rt_env_clear()
end.

func args:
    let n = arg_count()
    var v = vec_new_rt()
    var i = 0
    when i < n loop
        let a = get_arg(i)
        v = vec_push_rt(v, a as int)
        i = i + 1
    end
    out v
end.

func program_name:
    if arg_count() > 0 do
        out get_arg(0)
    end
    out ""
end.

func exit(code: int):
    sys_exit(code)
end.

func abort:
    sys_exit(134)
end.

func panic(msg: string):
    print msg
    sys_exit(134)
end.

enum Signal:
    INT = 2
    TERM = 15
    HUP = 1
    USR1 = 10
    USR2 = 12
end.

func on_signal(sig: Signal, handler: int):
end.

func ignore_signal(sig: Signal):
end.

func default_signal(sig: Signal):
end.

func cwd:
    out env_cwd()
end.

func env_cwd -> string:
    let buf = vir_alloc(1024)
    let plat = sys_platform()
    if plat == Platform.MacOS_ARM64 or plat == Platform.MacOS_x86_64 do
        extern func syscall2(num: int, a0: int, a1: int) -> int
        syscall2(0x2000128, buf, 1024)
    else
        extern func syscall2(num: int, a0: int, a1: int) -> int
        syscall2(17, buf, 1024)
    end
    out buf as string
end.

func home_dir:
    out get_or("HOME", "")
end.

func temp_dir:
    out get_or("TMPDIR", "/tmp")
end.

# Free-function migration forms (default arg). Prefer env.int / env.bool Option API.
func int(key: string, default: int) -> int:
    out env_int(key, default)
end.

func str(key: string, default: string) -> string:
    out env_str(key, default)
end.

func bool(key: string, default: bool) -> bool:
    out env_bool(key, default)
end.

func require(key: string):
    out env_require(key)
end.

export EnvNamespace, env, env_int, get, get_or, has, set, remove, keys, values, count, clear, current_os, current_arch, os_name, arch_name, args, program_name, exit, abort, panic, on_signal, ignore_signal, default_signal, cwd, home_dir, temp_dir, int, str, bool, require
