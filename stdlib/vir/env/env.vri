/*
 * vir/env/env.vri — Environment, Platform & Process Control
 * ===========================================================
 * Inspired by C23: <stdlib.h> getenv, exit, abort; <signal.h>
 * Inspired by Python: os, sys, platform, signal
 *
 * Compiler uses internally: platform detect cho codegen, env vars, exit codes.
 */

import "vir/core/types" use all
import "vir/core/option" use Option, Some, None
import "vir/str/string" use String

# ═══════════════════════════════════════════════════════
# Platform Detection
# ═══════════════════════════════════════════════════════

enum OS
    MacOS   = 1
    Linux   = 2
    Windows = 3
    FreeBSD = 4
    Unknown = 0
end

enum Arch
    ARM64   = 1    # aarch64
    X86_64  = 2    # amd64
    RISCV64 = 3
    Unknown = 0
end

func current_os() -> OS
    @if MACOS
        out OS.MacOS
    @eif LINUX
        out OS.Linux
    @eif WINDOWS
        out OS.Windows
    @else
        out OS.Unknown
    @end
end

func current_arch() -> Arch
    @if ARM64
        out Arch.ARM64
    @eif X86_64
        out Arch.X86_64
    @else
        out Arch.Unknown
    @end
end

func os_name() -> String
    chọn current_os()
        case OS.MacOS out str_new("macOS")
        case OS.Linux out str_new("Linux")
        case OS.Windows out str_new("Windows")
        mặc_định out str_new("Unknown")
    end
end

func arch_name() -> String
    chọn current_arch()
        case Arch.ARM64 out str_new("arm64")
        case Arch.X86_64 out str_new("x86_64")
        mặc_định out str_new("unknown")
    end
end

# ═══════════════════════════════════════════════════════
# Environment Variables
# ═══════════════════════════════════════════════════════

func get_env(key: String) -> Option<String>
    var val = native_getenv(key.data, key.byte_len)
    if val == null out None end
    out Some(str_from_cstr(val))
end

func set_env(key: String, val: String)
    native_setenv(key.data, key.byte_len, val.data, val.byte_len)
end

func unset_env(key: String)
    native_unsetenv(key.data, key.byte_len)
end

# ═══════════════════════════════════════════════════════
# Command-line Arguments
# ═══════════════════════════════════════════════════════

func args() -> Vec<String>
    # Returns list arguments từ command line
    out native_argv()
end

func program_name() -> String
    var argv = args()
    if vec_len(argv) > 0 out vec_get(argv, 0) end
    out str_new("")
end

# ═══════════════════════════════════════════════════════
# Process Control
# ═══════════════════════════════════════════════════════

func exit(code: i32)
    # Thoát process với exit code.
    native_exit(code)
end

func abort()
    # Terminate ngay lập tức (SIGABRT).
    native_abort()
end

func panic(msg: String)
    # In thông báo lỗi ra stderr rồi abort.
    eprintln(str_new("PANIC: ") + msg)
    print_trace()    # từ vir/debug
    abort()
end

# ═══════════════════════════════════════════════════════
# Signals (cơ bản)
# ═══════════════════════════════════════════════════════

enum Signal
    INT    = 2     # Ctrl+C
    TERM   = 15    # Kill polite
    HUP    = 1     # Terminal hangup
    USR1   = 10    # User-defined 1
    USR2   = 12    # User-defined 2
end

func on_signal(sig: Signal, handler: func)
    # Đăng ký signal handler.
    native_signal(sig, handler)
end

func ignore_signal(sig: Signal)
    native_signal_ignore(sig)
end

func default_signal(sig: Signal)
    native_signal_default(sig)
end

# ═══════════════════════════════════════════════════════
# Tiện ích khác
# ═══════════════════════════════════════════════════════

func cwd() -> String
    # Working directory hiện tại
    out native_getcwd()
end

func home_dir() -> Option<String>
    out get_env(str_new("HOME"))
end

func temp_dir() -> String
    var tmp = get_env(str_new("TMPDIR"))
    if is_some(tmp) out unwrap(tmp) end
    out str_new("/tmp")
end
