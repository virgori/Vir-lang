##
 * vir/wir/module.vri — W-IR Graph, Block, Component Containers
 * ==============================================================
 * WIRGraph is the top-level container (equivalent to QModule for Q-IR).
 * Holds all WIR-H/M/L nodes, blocks, and component metadata.
 ##

include types;
include string;
import String, str_new, str_eq, str_concat from string;
include vec;
import Vec, vec_new, vec_push, vec_len, vec_get, vec_set from vec;
include map;
import Map, map_new, map_set, map_get, map_has from map;
include wir/opcodes;
import WIRHOp, WIRMOp, WIRLOp, EventKind, DOMAttrType from wir/opcodes;
include wir/schema;
import KVPair, kv_new, StateField, state_field_new from wir/schema;
import WIRHNode, wir_h_node_new from wir/schema;
import WIRMNode, wir_m_node_new from wir/schema;
import WIRLNode, wir_l_node_new from wir/schema;


# ═══════════════════════════════════════════════════════
# WIR Component — component-scoped metadata
# ═══════════════════════════════════════════════════════

entity WIRComponent:
    component_id:   int,
        name:           string,
        root_node_id:   int,
        prop_names:     Vec<string>,
        state_names:    Vec<string>,
        event_handlers: Vec<string>,
        vss_classes:    Vec<string>,
        mount_fn:       string,
        unmount_fn:     string,
        render_fn:      string;
end
func wir_component_new:
    in(id: int; name: string)
    out WIRComponent (
        component_id:   id,
        name:           name,
        root_node_id:   0,
        prop_names:     vec_new<string>(),
        state_names:    vec_new<string>(),
        event_handlers: vec_new<string>(),
        vss_classes:    vec_new<string>(),
        mount_fn:       "",
        unmount_fn:     "",
        render_fn:      ""
    );
end
# ═══════════════════════════════════════════════════════
# WIR Block — basic block of sequential DOM ops
# ═══════════════════════════════════════════════════════

entity WIRBlock:
    block_id:   int,
        name:       string,
        node_ids:   Vec<int>;
end
func wir_block_new:
    in(id: int; name: string)
    out WIRBlock ( block_id: id, name: name, node_ids: vec_new<int>() );
end
# ═══════════════════════════════════════════════════════
# WIR Graph — top-level web IR container
# ═══════════════════════════════════════════════════════
# Supports all three levels (H/M/L) — a graph progresses
# through H → M → L via lowering passes.

entity WIRGraph:
    name:           string;

    # Node storage (keyed by node_id)
    h_nodes:        Map<int, WIRHNode>,
        m_nodes:        Map<int, WIRMNode>,
        l_nodes:        Map<int, WIRLNode>;

    # Block structure
    blocks:         Vec<WIRBlock>;

    # Component registry
    components:     Map<string, WIRComponent>;

    # Route table
    routes:         Vec<int>;

    # Entry points
    root_component: string,
        entry_node_ids: Vec<int>;

    # Auto-increment counter
    next_id:        int;
end
func wir_graph_new:
    in(name: string)
    out WIRGraph (
        name:           name,
        h_nodes:        map_new<int, WIRHNode>(),
        m_nodes:        map_new<int, WIRMNode>(),
        l_nodes:        map_new<int, WIRLNode>(),
        blocks:         vec_new<WIRBlock>(),
        components:     map_new<string, WIRComponent>(),
        routes:         vec_new<int>(),
        root_component: "",
        entry_node_ids: vec_new<int>(),
        next_id:        1
    );
end
# ── ID allocation ──────────────────────────────────────

func wir_alloc_id:
    in(g: WIRGraph)
    nid = g.next_id;
    g.next_id = g.next_id + 1;
    out (g, nid >> int);
end
# ── WIR-H construction helpers ─────────────────────────

func wir_add_h_node:
    in(g: WIRGraph; op: WIRHOp)
    (g, nid) = wir_alloc_id(g);
    node = wir_h_node_new(nid, op);
    map_set(g.h_nodes, nid, node);
    # Append to current block if any
    if vec_len(g.blocks) > 0 do
        blk = vec_get(g.blocks, vec_len(g.blocks) - 1);
        vec_push(blk.node_ids, nid);
    end
    out (g, nid >> int);
end
func wir_add_element:
    in(g: WIRGraph; tag: string; vss_class: string)
    (g, nid) = wir_add_h_node(g, WIRHOp::Element);
    node = map_get(g.h_nodes, nid);
    node.tag = tag;
    node.vss_class = vss_class;
    map_set(g.h_nodes, nid, node);
    out (g, nid >> int);
end
func wir_add_text:
    in(g: WIRGraph; content: string)
    (g, nid) = wir_add_h_node(g, WIRHOp::Text);
    node = map_get(g.h_nodes, nid);
    node.text_content = content;
    map_set(g.h_nodes, nid, node);
    out (g, nid >> int);
end
func wir_add_fragment:
    in(g: WIRGraph; children: Vec<int>)
    (g, nid) = wir_add_h_node(g, WIRHOp::Fragment);
    node = map_get(g.h_nodes, nid);
    node.children_ids = children;
    map_set(g.h_nodes, nid, node);
    out (g, nid >> int);
end
func wir_add_component_def:
    in(g: WIRGraph; comp_name: string)
    (g, nid) = wir_add_h_node(g, WIRHOp::ComponentDef);
    node = map_get(g.h_nodes, nid);
    node.component_name = comp_name;
    node.name = comp_name;
    map_set(g.h_nodes, nid, node);
    comp = wir_component_new(nid, comp_name);
    map_set(g.components, comp_name, comp);
    out (g, nid >> int);
end
func wir_add_state_def:
    in(g: WIRGraph; sname: string; stype: string; initial: string)
    (g, nid) = wir_add_h_node(g, WIRHOp::StateDef);
    node = map_get(g.h_nodes, nid);
    node.state_name = sname;
    sf = state_field_new(sname, stype, initial);
    vec_push(node.state_fields, sf);
    map_set(g.h_nodes, nid, node);
    out (g, nid >> int);
end
func wir_add_event_bind:
    in(g: WIRGraph; element_id: int; etype: string; handler: string)
    (g, nid) = wir_add_h_node(g, WIRHOp::EventBind);
    node = map_get(g.h_nodes, nid);
    vec_push(node.input_ids, element_id);
    node.event_type = etype;
    node.handler_fn = handler;
    map_set(g.h_nodes, nid, node);
    out (g, nid >> int);
end
func wir_add_style_bind:
    in(g: WIRGraph; element_id: int; vss_class: string)
    (g, nid) = wir_add_h_node(g, WIRHOp::StyleBind);
    node = map_get(g.h_nodes, nid);
    vec_push(node.input_ids, element_id);
    node.vss_class = vss_class;
    map_set(g.h_nodes, nid, node);
    out (g, nid >> int);
end
func wir_add_conditional:
    in(g: WIRGraph; cond_id: int; then_ids: Vec<int>; else_ids: Vec<int>)
    (g, nid) = wir_add_h_node(g, WIRHOp::Conditional);
    node = map_get(g.h_nodes, nid);
    node.condition_id = cond_id;
    node.then_ids = then_ids;
    node.else_ids = else_ids;
    map_set(g.h_nodes, nid, node);
    out (g, nid >> int);
end
func wir_add_list:
    in(g: WIRGraph; items_id: int; key_fn: string; render_fn: string)
    (g, nid) = wir_add_h_node(g, WIRHOp::List);
    node = map_get(g.h_nodes, nid);
    node.items_id = items_id;
    node.key_fn = key_fn;
    node.render_fn = render_fn;
    map_set(g.h_nodes, nid, node);
    out (g, nid >> int);
end
# ── Block management ───────────────────────────────────

func wir_new_block:
    in(g: WIRGraph; name: string)
    bid = vec_len(g.blocks);
    blk = wir_block_new(bid, name);
    vec_push(g.blocks, blk);
    out g;
end
# ── Topological order for H-nodes ─────────────────────
# Simple: iterate node IDs in insertion order (sufficient
# since builder constructs bottom-up / children before parents).

func wir_topo_order_h:
    in(g: WIRGraph)
    ids = vec_new<int>();
    # Collect all h_node keys in order
    i = 1;
    when i < g.next_id loop
        if map_has(g.h_nodes, i) do
            vec_push(ids, i);
        end
        i = i + 1;
    end
    out ids;
end
export WIRComponent, wir_component_new;
export WIRBlock, wir_block_new;
export WIRGraph, wir_graph_new;
export wir_alloc_id, wir_add_h_node;
export wir_add_element, wir_add_text, wir_add_fragment;
export wir_add_component_def, wir_add_state_def;
export wir_add_event_bind, wir_add_style_bind;
export wir_add_conditional, wir_add_list;
export wir_new_block, wir_topo_order_h;
