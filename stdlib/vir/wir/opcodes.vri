##
 * vir/wir/opcodes.vri — W-IR Opcode Definitions
 * ================================================
 * Web-IR opcodes for all three IR levels
 *   H (High-level, component-semantic)
 *   M (Mid-level, canonical DOM operations)
 *   L (Low-level, WASM + JS bridge emission)
 *
 * Namespace separate from Q-IR opcodes (core compiler)
 * and QIR opcodes (tensor). These are DOM/event/component/
 * style-semantic operations for the web compiler spine.
 ##

include types;


# ═══════════════════════════════════════════════════════
# WIR-H Opcodes (High-level, component-semantic)
# ═══════════════════════════════════════════════════════

enum WIRHOp:
    # ── Component lifecycle ─────────────────────────────
    ComponentDef        = 1;
    ComponentMount      = 2;
    ComponentUpdate     = 3;
    ComponentUnmount    = 4;

    # ── Routing ─────────────────────────────────────────
    RouteDef            = 10;
    RouteNavigate       = 11;
    RouteParam          = 12;

    # ── Event binding ───────────────────────────────────
    EventBind           = 20;
    EventUnbind         = 21;
    EventEmit           = 22;

    # ── Reactive state ──────────────────────────────────
    StateDef            = 30;
    StateGet            = 31;
    StateSet            = 32;
    Computed            = 33;
    Effect              = 34;

    # ── DOM declaration (virtual tree) ──────────────────
    Element             = 40;
    Text                = 41;
    Fragment            = 42;
    Conditional         = 43;
    List                = 44;
    Slot                = 45;

    # ── Style binding ───────────────────────────────────
    StyleBind           = 50;
    StyleDynamic        = 51;
    StyleScoped         = 52;

    # ── Form ────────────────────────────────────────────
    FormBind            = 60;
    FormValidate        = 61;

    # ── Lifecycle hooks ─────────────────────────────────
    OnMount             = 70;
    OnUnmount           = 71;
    OnUpdate            = 72;
end.


# ═══════════════════════════════════════════════════════
# WIR-M Opcodes (Mid-level, canonical DOM operations)
# ═══════════════════════════════════════════════════════

enum WIRMOp:
    # ── DOM mutation ────────────────────────────────────
    CreateElement       = 1;
    CreateText          = 2;
    SetAttr             = 3;
    RemoveAttr          = 4;
    SetProp             = 5;
    AppendChild         = 6;
    InsertBefore        = 7;
    RemoveChild         = 8;
    ReplaceChild        = 9;
    SetText             = 10;
    SetInnerHTML        = 11;

    # ── VDOM diff ───────────────────────────────────────
    DiffStart           = 20;
    DiffPatch           = 21;
    DiffCommit          = 22;

    # ── Style resolution ────────────────────────────────
    ResolveClass        = 30;
    ResolveDynamic      = 31;
    ApplyStyle          = 32;

    # ── Events (canonical) ──────────────────────────────
    AddListener         = 40;
    RemoveListener      = 41;
    DispatchEvent       = 42;

    # ── State (canonical) ───────────────────────────────
    AllocState          = 50;
    LoadState           = 51;
    StoreState          = 52;
    Subscribe           = 53;

    # ── Attribute batching ──────────────────────────────
    BatchSetAttrs       = 60;
end.


# ═══════════════════════════════════════════════════════
# WIR-L Opcodes (Low-level, WASM + JS bridge emission)
# ═══════════════════════════════════════════════════════

enum WIRLOp:
    # ── JS interop ──────────────────────────────────────
    ImportJS            = 1;
    CallJS              = 2;
    ExportWasm          = 3;

    # ── DOM API (via JS imports) ────────────────────────
    JSCreateElement     = 10;
    JSCreateText        = 11;
    JSSetAttribute      = 12;
    JSRemoveAttribute   = 13;
    JSAppendChild       = 14;
    JSInsertBefore      = 15;
    JSRemoveChild       = 16;
    JSReplaceChild      = 17;
    JSAddEvent          = 18;
    JSRemoveEvent       = 19;
    JSSetText           = 20;
    JSSetStyle          = 21;
    JSSetProperty       = 22;
    JSQuerySelector     = 23;

    # ── CSS emission ────────────────────────────────────
    EmitCSSRule         = 30;
    EmitCSSMedia        = 31;
    EmitCSSKeyframe     = 32;
    EmitCSSVar          = 33;

    # ── Linear memory (string/data management) ──────────
    StringAlloc         = 40;
    StringWrite         = 41;
    StringFree          = 42;
    DataAlloc           = 43;

    # ── Scheduling ──────────────────────────────────────
    RequestFrame        = 50;
    SetTimeout          = 51;
    SetInterval         = 52;
    ClearTimeout        = 53;
    Microtask           = 54;

    # ── History / Navigation ────────────────────────────
    PushState           = 60;
    ReplaceState        = 61;
end.


# ═══════════════════════════════════════════════════════
# Supporting Enums
# ═══════════════════════════════════════════════════════

## DOM event categories for type-safe event binding ##
enum EventKind:
    Click       = 1;
    DblClick    = 2;
    MouseDown   = 3;
    MouseUp     = 4;
    MouseMove   = 5;
    MouseEnter  = 6;
    MouseLeave  = 7;
    KeyDown     = 8;
    KeyUp       = 9;
    KeyPress    = 10;
    Input       = 11;
    Change      = 12;
    Submit      = 13;
    Focus       = 14;
    Blur        = 15;
    Scroll      = 16;
    Resize      = 17;
    Load        = 18;
    Unload      = 19;
    Custom      = 20;
end.

## Attribute vs property distinction for correct DOM API calls ##
enum DOMAttrType:
    Attribute   = 1;    # setAttribute / removeAttribute
    Property    = 2;    # direct property assignment (checked, value)
    Style       = 3;    # style property
    Class       = 4;    # className / classList
    Data        = 5;    # data-* attributes
    Event       = 6;    # event handler
end.


export WIRHOp, WIRMOp, WIRLOp, EventKind, DOMAttrType;
