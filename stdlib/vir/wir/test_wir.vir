##
 * vir/wir/test_wir.vir — W-IR Test Suite
 * =========================================
 * Tests for WIR opcodes, schema, module, builder, and lowering passes.
 *
 * Run:  vir jit stdlib/vir/wir/test_wir.vir
 ##

include types;
include string;
import String, str_new, str_eq, str_concat, str_contains from string;
include vec;
import Vec, vec_new, vec_push, vec_len, vec_get from vec;
include map;
import Map, map_new, map_set, map_get, map_has from map;
include test;
import TestSuite, TestReport, suite_new, suite_add, suite_run,
       report_ok, pass, fail, expect_true, expect_eq_i64, expect_eq_str from test;
include stdio;
import println from stdio;

# ─── W-IR modules ─────────────────────────────────────

import WIRHOp, WIRMOp, WIRLOp, EventKind, DOMAttrType from wir/opcodes;

import KVPair, kv_new, StateField, state_field_new from wir/schema;
import WIRHNode, wir_h_node_new from wir/schema;
import WIRMNode, wir_m_node_new from wir/schema;
import WIRLNode, wir_l_node_new from wir/schema;

import WIRComponent, wir_component_new from wir/module;
import WIRBlock, wir_block_new from wir/module;
import WIRGraph, wir_graph_new from wir/module;
import wir_alloc_id, wir_add_h_node from wir/module;
import wir_add_element, wir_add_text, wir_add_fragment from wir/module;
import wir_add_component_def, wir_add_state_def from wir/module;
import wir_add_event_bind, wir_add_style_bind from wir/module;
import wir_add_conditional, wir_add_list from wir/module;
import wir_new_block, wir_topo_order_h from wir/module;

import builder_begin_component, builder_end_component from wir/builder;
import builder_element, builder_text, builder_fragment from wir/builder;
import builder_child, builder_root, builder_attr from wir/builder;
import builder_state, builder_computed, builder_effect from wir/builder;
import builder_event, builder_style from wir/builder;
import builder_conditional, builder_list_render from wir/builder;
import builder_on_mount, builder_on_unmount from wir/builder;

import lower_h_to_m from wir/lower_h_m;
import lower_m_to_l from wir/lower_m_l;


# ═══════════════════════════════════════════════════════
# 1. Opcode coverage tests
# ═══════════════════════════════════════════════════════

func test_wirh_component_lifecycle:
    in()
    # Verify WIRHOp enum values exist and are distinct
    a = WIRHOp.ComponentDef;
    b = WIRHOp.ComponentMount;
    c = WIRHOp.ComponentUpdate;
    d = WIRHOp.ComponentUnmount;
    if a == b or b == c or c == d do
        out fail();
    end
    out pass();
end

func test_wirh_dom_opcodes:
    in()
    e = WIRHOp.Element;
    t = WIRHOp.Text;
    f = WIRHOp.Fragment;
    co = WIRHOp.Conditional;
    li = WIRHOp.List;
    sl = WIRHOp.Slot;
    # All must be different
    vals = vec_new<int>();
    vec_push<int>(&vals, e);
    vec_push<int>(&vals, t);
    vec_push<int>(&vals, f);
    vec_push<int>(&vals, co);
    vec_push<int>(&vals, li);
    vec_push<int>(&vals, sl);
    i = 0;
    when i < vec_len<int>(vals) loop
        j = i + 1;
        when j < vec_len<int>(vals) loop
            if vec_get<int>(vals, i) == vec_get<int>(vals, j) do
                out fail();
            end
            j = j + 1;
        end
        i = i + 1;
    end
    out pass();
end

func test_wirh_reactive_opcodes:
    in()
    sd = WIRHOp.StateDef;
    sg = WIRHOp.StateGet;
    ss = WIRHOp.StateSet;
    cp = WIRHOp.Computed;
    ef = WIRHOp.Effect;
    if sd == sg or sg == ss or ss == cp or cp == ef do
        out fail();
    end
    out pass();
end

func test_wirm_dom_mutations:
    in()
    ce = WIRMOp.CreateElement;
    ct = WIRMOp.CreateText;
    sa = WIRMOp.SetAttr;
    ra = WIRMOp.RemoveAttr;
    ac = WIRMOp.AppendChild;
    rc = WIRMOp.RemoveChild;
    if ce == ct or sa == ra or ac == rc do
        out fail();
    end
    out pass();
end

func test_wirl_js_interop:
    in()
    ij = WIRLOp.ImportJS;
    cj = WIRLOp.CallJS;
    jc = WIRLOp.JSCreateElement;
    js = WIRLOp.JSSetAttribute;
    if ij == cj or jc == js do
        out fail();
    end
    out pass();
end

func test_event_kind_coverage:
    in()
    ck = EventKind.Click;
    ip = EventKind.Input;
    sb = EventKind.Submit;
    if ck == ip or ip == sb do
        out fail();
    end
    out pass();
end


# ═══════════════════════════════════════════════════════
# 2. Schema / entity tests
# ═══════════════════════════════════════════════════════

func test_h_node_defaults:
    in()
    n = wir_h_node_new(1, WIRHOp.Element);
    out expect_eq_i64(n.node_id, 1);
end

func test_m_node_defaults:
    in()
    n = wir_m_node_new(10, WIRMOp.CreateElement);
    out expect_eq_i64(n.node_id, 10);
end

func test_l_node_defaults:
    in()
    n = wir_l_node_new(20, WIRLOp.JSCreateElement);
    out expect_eq_i64(n.node_id, 20);
end

func test_kv_pair:
    in()
    kv = kv_new(str_new("class"), str_new("container"));
    r1 = expect_eq_str(kv.key, str_new("class"));
    if r1 != pass() do
        out r1;
    end
    out expect_eq_str(kv.val, str_new("container"));
end

func test_state_field:
    in()
    sf = state_field_new(str_new("count"), str_new("int"), str_new("0"));
    r1 = expect_eq_str(sf.name, str_new("count"));
    if r1 != pass() do
        out r1;
    end
    out expect_eq_str(sf.stype, str_new("int"));
end


# ═══════════════════════════════════════════════════════
# 3. Module / graph tests
# ═══════════════════════════════════════════════════════

func test_graph_new_empty:
    in()
    g = wir_graph_new();
    out expect_eq_i64(g.next_id, 1);
end

func test_add_element:
    in()
    g = wir_graph_new();
    attrs = vec_new<KVPair>();
    vec_push<KVPair>(&attrs, kv_new(str_new("id"), str_new("main")));
    nid = wir_add_element(&g, str_new("div"), attrs, str_new(""));
    # node id should be >= 1
    if nid < 1 do
        out fail();
    end
    # Check the node is stored
    h = map_get<int, WIRHNode>(g.h_nodes, nid);
    out expect_eq_str(h.tag, str_new("div"));
end

func test_add_text:
    in()
    g = wir_graph_new();
    nid = wir_add_text(&g, str_new("Hello World"));
    h = map_get<int, WIRHNode>(g.h_nodes, nid);
    out expect_eq_str(h.text_content, str_new("Hello World"));
end

func test_add_fragment:
    in()
    g = wir_graph_new();
    children = vec_new<int>();
    nid = wir_add_fragment(&g, children);
    h = map_get<int, WIRHNode>(g.h_nodes, nid);
    r = expect_eq_i64(h.op, WIRHOp.Fragment);
    out r;
end

func test_add_component_def:
    in()
    g = wir_graph_new();
    props = vec_new<string>();
    vec_push<string>(&props, str_new("title"));
    nid = wir_add_component_def(&g, str_new("Card"), props);
    # Should be in components map
    if !map_has<string, WIRComponent>(g.components, str_new("Card")) do
        out fail();
    end
    out pass();
end

func test_add_state_def:
    in()
    g = wir_graph_new();
    nid = wir_add_state_def(&g, str_new("count"), str_new("int"), str_new("0"));
    h = map_get<int, WIRHNode>(g.h_nodes, nid);
    out expect_eq_str(h.state_name, str_new("count"));
end

func test_add_event_bind:
    in()
    g = wir_graph_new();
    attrs = vec_new<KVPair>();
    target = wir_add_element(&g, str_new("button"), attrs, str_new(""));
    nid = wir_add_event_bind(&g, target, EventKind.Click, str_new("handleClick"));
    h = map_get<int, WIRHNode>(g.h_nodes, nid);
    out expect_eq_i64(h.event_kind, EventKind.Click);
end

func test_add_style_bind:
    in()
    g = wir_graph_new();
    nid = wir_add_style_bind(&g, 0, str_new("card_style"));
    h = map_get<int, WIRHNode>(g.h_nodes, nid);
    out expect_eq_str(h.vss_class, str_new("card_style"));
end

func test_alloc_id_increment:
    in()
    g = wir_graph_new();
    id1 = wir_alloc_id(&g);
    id2 = wir_alloc_id(&g);
    id3 = wir_alloc_id(&g);
    if id2 != id1 + 1 or id3 != id2 + 1 do
        out fail();
    end
    out pass();
end


# ═══════════════════════════════════════════════════════
# 4. Builder API tests
# ═══════════════════════════════════════════════════════

func test_builder_component:
    in()
    g = wir_graph_new();
    builder_begin_component(&g, str_new("App"), vec_new<string>());
    builder_end_component(&g);
    if !map_has<string, WIRComponent>(g.components, str_new("App")) do
        out fail();
    end
    out pass();
end

func test_builder_element_and_text:
    in()
    g = wir_graph_new();
    builder_begin_component(&g, str_new("App"), vec_new<string>());
    div_id = builder_element(&g, str_new("div"));
    txt_id = builder_text(&g, str_new("Hello"));
    builder_child(&g, div_id, txt_id);
    builder_root(&g, str_new("App"), div_id);
    builder_end_component(&g);

    h = map_get<int, WIRHNode>(g.h_nodes, div_id);
    out expect_eq_str(h.tag, str_new("div"));
end

func test_builder_attrs:
    in()
    g = wir_graph_new();
    builder_begin_component(&g, str_new("App"), vec_new<string>());
    div_id = builder_element(&g, str_new("div"));
    builder_attr(&g, div_id, str_new("class"), str_new("wrapper"));
    builder_end_component(&g);

    h = map_get<int, WIRHNode>(g.h_nodes, div_id);
    # attrs should have 1 entry
    out expect_eq_i64(vec_len<KVPair>(h.attrs), 1);
end

func test_builder_state_and_event:
    in()
    g = wir_graph_new();
    builder_begin_component(&g, str_new("Counter"), vec_new<string>());
    sid = builder_state(&g, str_new("count"), str_new("int"), str_new("0"));
    btn = builder_element(&g, str_new("button"));
    builder_event(&g, btn, EventKind.Click, str_new("increment"));
    builder_end_component(&g);

    sh = map_get<int, WIRHNode>(g.h_nodes, sid);
    out expect_eq_str(sh.state_name, str_new("count"));
end

func test_builder_style_bind:
    in()
    g = wir_graph_new();
    builder_begin_component(&g, str_new("App"), vec_new<string>());
    div_id = builder_element(&g, str_new("div"));
    builder_style(&g, div_id, str_new("card"));
    builder_end_component(&g);
    # Just verify no crash
    out pass();
end

func test_builder_conditional_and_list:
    in()
    g = wir_graph_new();
    builder_begin_component(&g, str_new("App"), vec_new<string>());
    cid = builder_conditional(&g, 0);
    lid = builder_list_render(&g, str_new("items"), str_new("item"));
    builder_end_component(&g);

    ch = map_get<int, WIRHNode>(g.h_nodes, cid);
    out expect_eq_i64(ch.op, WIRHOp.Conditional);
end

func test_builder_lifecycle_hooks:
    in()
    g = wir_graph_new();
    builder_begin_component(&g, str_new("App"), vec_new<string>());
    mid = builder_on_mount(&g, str_new("fetchData"));
    uid = builder_on_unmount(&g, str_new("cleanup"));
    builder_end_component(&g);

    mh = map_get<int, WIRHNode>(g.h_nodes, mid);
    out expect_eq_i64(mh.op, WIRHOp.OnMount);
end


# ═══════════════════════════════════════════════════════
# 5. Lowering H→M tests
# ═══════════════════════════════════════════════════════

func test_lower_h_to_m_element:
    in()
    g = wir_graph_new();
    attrs = vec_new<KVPair>();
    vec_push<KVPair>(&attrs, kv_new(str_new("id"), str_new("root")));
    nid = wir_add_element(&g, str_new("div"), attrs, str_new(""));

    lower_h_to_m(&g);

    # After lowering, m_nodes should be non-empty
    # At minimum: CreateElement + SetAttr + AppendChild
    m_count = 0;
    i = 1;
    when i < g.next_id loop
        if map_has<int, WIRMNode>(g.m_nodes, i) do
            m_count = m_count + 1;
        end
        i = i + 1;
    end
    if m_count < 1 do
        out fail();
    end
    out pass();
end

func test_lower_h_to_m_text:
    in()
    g = wir_graph_new();
    nid = wir_add_text(&g, str_new("Hello"));

    lower_h_to_m(&g);

    # Should produce at least CreateText m-node
    m_count = 0;
    i = 1;
    when i < g.next_id loop
        if map_has<int, WIRMNode>(g.m_nodes, i) do
            m_count = m_count + 1;
        end
        i = i + 1;
    end
    out expect_true(m_count >= 1);
end

func test_lower_h_to_m_state:
    in()
    g = wir_graph_new();
    wir_add_state_def(&g, str_new("counter"), str_new("int"), str_new("0"));

    lower_h_to_m(&g);

    # Should produce AllocState m-node
    found = 0;
    i = 1;
    when i < g.next_id loop
        if map_has<int, WIRMNode>(g.m_nodes, i) do
            mn = map_get<int, WIRMNode>(g.m_nodes, i);
            if mn.op == WIRMOp.AllocState do
                found = 1;
            end
        end
        i = i + 1;
    end
    out expect_true(found == 1);
end

func test_lower_h_to_m_event:
    in()
    g = wir_graph_new();
    attrs = vec_new<KVPair>();
    target = wir_add_element(&g, str_new("button"), attrs, str_new(""));
    wir_add_event_bind(&g, target, EventKind.Click, str_new("onClick"));

    lower_h_to_m(&g);

    # Should produce AddListener m-node
    found = 0;
    i = 1;
    when i < g.next_id loop
        if map_has<int, WIRMNode>(g.m_nodes, i) do
            mn = map_get<int, WIRMNode>(g.m_nodes, i);
            if mn.op == WIRMOp.AddListener do
                found = 1;
            end
        end
        i = i + 1;
    end
    out expect_true(found == 1);
end


# ═══════════════════════════════════════════════════════
# 6. Lowering M→L tests
# ═══════════════════════════════════════════════════════

func test_lower_m_to_l_create_element:
    in()
    g = wir_graph_new();
    attrs = vec_new<KVPair>();
    wir_add_element(&g, str_new("div"), attrs, str_new(""));

    # H→M first
    lower_h_to_m(&g);
    # M→L
    lower_m_to_l(&g);

    # Should have l-nodes
    l_count = 0;
    i = 1;
    when i < g.next_id loop
        if map_has<int, WIRLNode>(g.l_nodes, i) do
            l_count = l_count + 1;
        end
        i = i + 1;
    end
    out expect_true(l_count >= 1);
end

func test_lower_full_pipeline:
    in()
    # Build a small counter component through the whole pipeline
    g = wir_graph_new();

    builder_begin_component(&g, str_new("Counter"), vec_new<string>());
    sid = builder_state(&g, str_new("count"), str_new("int"), str_new("0"));
    div_id = builder_element(&g, str_new("div"));
    txt_id = builder_text(&g, str_new("0"));
    btn_id = builder_element(&g, str_new("button"));
    builder_event(&g, btn_id, EventKind.Click, str_new("inc"));
    builder_child(&g, div_id, txt_id);
    builder_child(&g, div_id, btn_id);
    builder_root(&g, str_new("Counter"), div_id);
    builder_end_component(&g);

    # Lower H→M
    lower_h_to_m(&g);
    # Lower M→L
    lower_m_to_l(&g);

    # All three levels should have nodes
    h_count = 0;
    m_count = 0;
    l_count = 0;
    i = 1;
    when i < g.next_id loop
        if map_has<int, WIRHNode>(g.h_nodes, i) do
            h_count = h_count + 1;
        end
        if map_has<int, WIRMNode>(g.m_nodes, i) do
            m_count = m_count + 1;
        end
        if map_has<int, WIRLNode>(g.l_nodes, i) do
            l_count = l_count + 1;
        end
        i = i + 1;
    end

    if h_count == 0 or m_count == 0 or l_count == 0 do
        out fail();
    end
    out pass();
end


# ═══════════════════════════════════════════════════════
# Main — run all suites
# ═══════════════════════════════════════════════════════

func main:
    in()
    # Suite 1: Opcodes
    s1 = suite_new(str_new("WIR Opcodes"));
    suite_add(&s1, str_new("H-op component lifecycle"), test_wirh_component_lifecycle);
    suite_add(&s1, str_new("H-op DOM opcodes"),         test_wirh_dom_opcodes);
    suite_add(&s1, str_new("H-op reactive opcodes"),    test_wirh_reactive_opcodes);
    suite_add(&s1, str_new("M-op DOM mutations"),       test_wirm_dom_mutations);
    suite_add(&s1, str_new("L-op JS interop"),          test_wirl_js_interop);
    suite_add(&s1, str_new("EventKind coverage"),       test_event_kind_coverage);
    r1 = suite_run(&s1);

    # Suite 2: Schema
    s2 = suite_new(str_new("WIR Schema"));
    suite_add(&s2, str_new("H-node defaults"),  test_h_node_defaults);
    suite_add(&s2, str_new("M-node defaults"),  test_m_node_defaults);
    suite_add(&s2, str_new("L-node defaults"),  test_l_node_defaults);
    suite_add(&s2, str_new("KVPair"),           test_kv_pair);
    suite_add(&s2, str_new("StateField"),       test_state_field);
    r2 = suite_run(&s2);

    # Suite 3: Module / Graph
    s3 = suite_new(str_new("WIR Module"));
    suite_add(&s3, str_new("graph new empty"),    test_graph_new_empty);
    suite_add(&s3, str_new("add element"),        test_add_element);
    suite_add(&s3, str_new("add text"),           test_add_text);
    suite_add(&s3, str_new("add fragment"),       test_add_fragment);
    suite_add(&s3, str_new("add component def"),  test_add_component_def);
    suite_add(&s3, str_new("add state def"),      test_add_state_def);
    suite_add(&s3, str_new("add event bind"),     test_add_event_bind);
    suite_add(&s3, str_new("add style bind"),     test_add_style_bind);
    suite_add(&s3, str_new("alloc id increment"), test_alloc_id_increment);
    r3 = suite_run(&s3);

    # Suite 4: Builder API
    s4 = suite_new(str_new("WIR Builder"));
    suite_add(&s4, str_new("builder component"),       test_builder_component);
    suite_add(&s4, str_new("builder element+text"),     test_builder_element_and_text);
    suite_add(&s4, str_new("builder attrs"),            test_builder_attrs);
    suite_add(&s4, str_new("builder state+event"),      test_builder_state_and_event);
    suite_add(&s4, str_new("builder style bind"),       test_builder_style_bind);
    suite_add(&s4, str_new("builder conditional+list"), test_builder_conditional_and_list);
    suite_add(&s4, str_new("builder lifecycle hooks"),  test_builder_lifecycle_hooks);
    r4 = suite_run(&s4);

    # Suite 5: Lowering H→M
    s5 = suite_new(str_new("WIR Lowering H→M"));
    suite_add(&s5, str_new("lower element"),  test_lower_h_to_m_element);
    suite_add(&s5, str_new("lower text"),     test_lower_h_to_m_text);
    suite_add(&s5, str_new("lower state"),    test_lower_h_to_m_state);
    suite_add(&s5, str_new("lower event"),    test_lower_h_to_m_event);
    r5 = suite_run(&s5);

    # Suite 6: Lowering M→L + full pipeline
    s6 = suite_new(str_new("WIR Lowering M→L"));
    suite_add(&s6, str_new("lower create element"), test_lower_m_to_l_create_element);
    suite_add(&s6, str_new("full pipeline"),         test_lower_full_pipeline);
    r6 = suite_run(&s6);

    # Final summary
    println(str_new(""));
    println(str_new("═══════════════════════════════════"));
    total_ok = report_ok(r1) and report_ok(r2) and report_ok(r3)
               and report_ok(r4) and report_ok(r5) and report_ok(r6);
    if total_ok do
        println(str_new("✓ All WIR tests passed!"));
    else
        println(str_new("✗ Some WIR tests FAILED."));
    end
end
