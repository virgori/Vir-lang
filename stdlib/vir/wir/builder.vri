##
 * vir/wir/builder.vri — DOMBuilder: Fluent Component Builder for WIR-H
 * ======================================================================
 * High-level API for building component trees that populate a WIRGraph
 * with WIR-H nodes.  Follows the QIRBuilder pattern.
 *
 * Usage:
 *   g = wir_graph_new("my_app");
 *   g = builder_begin_component(g, "App");
 *   (g, div_id)  = builder_element(g, "App", "div", "container");
 *   (g, h1_id)   = builder_element(g, "App", "h1", "");
 *   (g, txt_id)  = builder_text(g, "App", "Hello Vir!");
 *   g = builder_child(g, h1_id, txt_id);
 *   g = builder_child(g, div_id, h1_id);
 *   (g, btn_id)  = builder_element(g, "App", "button", "");
 *   g = builder_event(g, "App", btn_id, "click", "on_click");
 *   g = builder_root(g, "App", div_id);
 *   g = builder_end_component(g, "App");
 ##

include types;
include string;
import String, str_new, str_eq, str_concat from string;
include vec;
import Vec, vec_new, vec_push, vec_len, vec_get from vec;
include map;
import Map, map_get, map_set, map_has from map;
include wir/opcodes;
import WIRHOp from wir/opcodes;
include wir/schema;
import WIRHNode, KVPair, kv_new from wir/schema;
include wir/module;
import WIRGraph, WIRComponent from wir/module;
import wir_graph_new, wir_add_h_node, wir_add_element from wir/module;
import wir_add_text, wir_add_fragment from wir/module;
import wir_add_component_def, wir_add_state_def from wir/module;
import wir_add_event_bind, wir_add_style_bind from wir/module;
import wir_add_conditional, wir_add_list from wir/module;
import wir_new_block from wir/module;


# ═══════════════════════════════════════════════════════
# Component scope management
# ═══════════════════════════════════════════════════════

func builder_begin_component:
    in(g: WIRGraph; comp_name: string)
    g = wir_new_block(g, comp_name);
    (g, nid) = wir_add_component_def(g, comp_name);
    out g;
end

func builder_end_component:
    in(g: WIRGraph; comp_name: string)
    # Finalize — no-op for now; metadata already stored
    out g;
end


# ═══════════════════════════════════════════════════════
# Element construction
# ═══════════════════════════════════════════════════════

func builder_element:
    in(g: WIRGraph; comp_name: string; tag: string; vss_class: string)
    (g, nid) = wir_add_element(g, tag, vss_class);
    node = map_get(g.h_nodes, nid);
    node.name = str_concat(comp_name, str_concat(".", tag));
    map_set(g.h_nodes, nid, node);
    out (g, nid >> int);
end

func builder_text:
    in(g: WIRGraph; comp_name: string; content: string)
    (g, nid) = wir_add_text(g, content);
    node = map_get(g.h_nodes, nid);
    node.name = str_concat(comp_name, ".text");
    map_set(g.h_nodes, nid, node);
    out (g, nid >> int);
end

func builder_fragment:
    in(g: WIRGraph; comp_name: string; children: Vec<int>)
    (g, nid) = wir_add_fragment(g, children);
    node = map_get(g.h_nodes, nid);
    node.name = str_concat(comp_name, ".frag");
    map_set(g.h_nodes, nid, node);
    out (g, nid >> int);
end


# ═══════════════════════════════════════════════════════
# Tree assembly
# ═══════════════════════════════════════════════════════

func builder_child:
    in(g: WIRGraph; parent_id: int; child_id: int)
    if map_has(g.h_nodes, parent_id):
        parent = map_get(g.h_nodes, parent_id);
        vec_push(parent.children_ids, child_id);
        map_set(g.h_nodes, parent_id, parent);
    end
    out g;
end

func builder_root:
    in(g: WIRGraph; comp_name: string; node_id: int)
    if map_has(g.components, comp_name):
        comp = map_get(g.components, comp_name);
        comp.root_node_id = node_id;
        map_set(g.components, comp_name, comp);
    end
    out g;
end

func builder_attr:
    in(g: WIRGraph; element_id: int; attr_name: string; attr_value: string)
    if map_has(g.h_nodes, element_id):
        node = map_get(g.h_nodes, element_id);
        vec_push(node.attrs, kv_new(attr_name, attr_value));
        map_set(g.h_nodes, element_id, node);
    end
    out g;
end


# ═══════════════════════════════════════════════════════
# State
# ═══════════════════════════════════════════════════════

func builder_state:
    in(g: WIRGraph; comp_name: string; sname: string; stype: string; initial: string)
    (g, nid) = wir_add_state_def(g, sname, stype, initial);
    if map_has(g.components, comp_name):
        comp = map_get(g.components, comp_name);
        vec_push(comp.state_names, sname);
        map_set(g.components, comp_name, comp);
    end
    out (g, nid >> int);
end

func builder_computed:
    in(g: WIRGraph; comp_name: string; sname: string; deps: Vec<int>; fn_name: string)
    (g, nid) = wir_add_h_node(g, WIRHOp::Computed);
    node = map_get(g.h_nodes, nid);
    node.state_name = sname;
    node.deps = deps;
    node.compute_fn = fn_name;
    node.name = str_concat(comp_name, str_concat(".computed.", sname));
    map_set(g.h_nodes, nid, node);
    out (g, nid >> int);
end

func builder_effect:
    in(g: WIRGraph; comp_name: string; deps: Vec<int>; fn_name: string)
    (g, nid) = wir_add_h_node(g, WIRHOp::Effect);
    node = map_get(g.h_nodes, nid);
    node.deps = deps;
    node.compute_fn = fn_name;
    node.name = str_concat(comp_name, ".effect");
    map_set(g.h_nodes, nid, node);
    out (g, nid >> int);
end


# ═══════════════════════════════════════════════════════
# Events
# ═══════════════════════════════════════════════════════

func builder_event:
    in(g: WIRGraph; comp_name: string; element_id: int; event_type: string; handler: string)
    (g, nid) = wir_add_event_bind(g, element_id, event_type, handler);
    if map_has(g.components, comp_name):
        comp = map_get(g.components, comp_name);
        vec_push(comp.event_handlers, handler);
        map_set(g.components, comp_name, comp);
    end
    out (g, nid >> int);
end


# ═══════════════════════════════════════════════════════
# Style
# ═══════════════════════════════════════════════════════

func builder_style:
    in(g: WIRGraph; comp_name: string; element_id: int; vss_class: string)
    (g, nid) = wir_add_style_bind(g, element_id, vss_class);
    if map_has(g.components, comp_name):
        comp = map_get(g.components, comp_name);
        vec_push(comp.vss_classes, vss_class);
        map_set(g.components, comp_name, comp);
    end
    out (g, nid >> int);
end


# ═══════════════════════════════════════════════════════
# Control flow
# ═══════════════════════════════════════════════════════

func builder_conditional:
    in(g: WIRGraph; cond_id: int; then_ids: Vec<int>; else_ids: Vec<int>)
    (g, nid) = wir_add_conditional(g, cond_id, then_ids, else_ids);
    out (g, nid >> int);
end

func builder_list_render:
    in(g: WIRGraph; items_id: int; key_fn: string; render_fn: string)
    (g, nid) = wir_add_list(g, items_id, key_fn, render_fn);
    out (g, nid >> int);
end


# ═══════════════════════════════════════════════════════
# Lifecycle hooks
# ═══════════════════════════════════════════════════════

func builder_on_mount:
    in(g: WIRGraph; comp_name: string; fn_name: string)
    (g, nid) = wir_add_h_node(g, WIRHOp::OnMount);
    node = map_get(g.h_nodes, nid);
    node.handler_fn = fn_name;
    node.name = str_concat(comp_name, ".on_mount");
    map_set(g.h_nodes, nid, node);
    if map_has(g.components, comp_name):
        comp = map_get(g.components, comp_name);
        comp.mount_fn = fn_name;
        map_set(g.components, comp_name, comp);
    end
    out (g, nid >> int);
end

func builder_on_unmount:
    in(g: WIRGraph; comp_name: string; fn_name: string)
    (g, nid) = wir_add_h_node(g, WIRHOp::OnUnmount);
    node = map_get(g.h_nodes, nid);
    node.handler_fn = fn_name;
    node.name = str_concat(comp_name, ".on_unmount");
    map_set(g.h_nodes, nid, node);
    if map_has(g.components, comp_name):
        comp = map_get(g.components, comp_name);
        comp.unmount_fn = fn_name;
        map_set(g.components, comp_name, comp);
    end
    out (g, nid >> int);
end


export builder_begin_component, builder_end_component;
export builder_element, builder_text, builder_fragment;
export builder_child, builder_root, builder_attr;
export builder_state, builder_computed, builder_effect;
export builder_event, builder_style;
export builder_conditional, builder_list_render;
export builder_on_mount, builder_on_unmount;
