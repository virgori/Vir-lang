##
 * vir/wir/schema.vri — W-IR Node Definitions
 * =============================================
 * Immutable node entities for all three web IR levels.
 * DOM-aware metadata per node (tag, attrs, event type, style refs).
 * Source tracing between levels for debugging.
 ##

include types;
include string;
import String, str_new, str_eq from string;
include vec;
import Vec, vec_new, vec_push, vec_len, vec_get from vec;
include wir/opcodes;
import WIRHOp, WIRMOp, WIRLOp, EventKind, DOMAttrType from wir/opcodes;


# ═══════════════════════════════════════════════════════
# Key-Value Pair (for attrs, props, CSS declarations)
# ═══════════════════════════════════════════════════════

entity KVPair:
    key:   string;
    val:   string;
end

func kv_new:
    in(k: string; v: string)
    out KVPair { key: k, val: v };
end


# ═══════════════════════════════════════════════════════
# State Field Triple (name, type, initial_expr)
# ═══════════════════════════════════════════════════════

entity StateField:
    name:     string;
    stype:    string;
    initial:  string;
end

func state_field_new:
    in(n: string; t: string; init: string)
    out StateField { name: n, stype: t, initial: init };
end


# ═══════════════════════════════════════════════════════
# WIR-H Node — High-level component-semantic IR
# ═══════════════════════════════════════════════════════
# Represents:
#   - Component definitions and lifecycle events
#   - Virtual DOM tree declarations (elements, text, fragments)
#   - Reactive state and computed values
#   - Event bindings and style bindings
#   - Route definitions

entity WIRHNode:
    # Identity
    node_id:        int;
    op:             WIRHOp;
    input_ids:      Vec<int>;
    output_ids:     Vec<int>;
    name:           string;

    # Component metadata
    component_name: string;
    props:          Vec<KVPair>;
    state_fields:   Vec<StateField>;

    # DOM metadata
    tag:            string;
    attrs:          Vec<KVPair>;
    children_ids:   Vec<int>;
    text_content:   string;

    # Style metadata
    vss_class:      string;
    dynamic_styles: Vec<KVPair>;

    # Event metadata
    event_kind:     int;
    event_type:     string;
    handler_fn:     string;

    # Reactive metadata
    state_name:     string;
    deps:           Vec<int>;
    compute_fn:     string;

    # Routing metadata
    route_path:      string;
    route_component: string;
    route_guards:    Vec<string>;

    # Conditional / List metadata
    condition_id:   int;
    then_ids:       Vec<int>;
    else_ids:       Vec<int>;
    items_id:       int;
    key_fn:         string;
    render_fn:      string;

    # Source info
    source_line:    int;
end

func wir_h_node_new:
    in(id: int; op: WIRHOp)
    out WIRHNode {;
        node_id:        id,;
        op:             op,;
        input_ids:      vec_new<int>(),;
        output_ids:     vec_new<int>(),;
        name:           "",;
        component_name: "",;
        props:          vec_new<KVPair>(),;
        state_fields:   vec_new<StateField>(),;
        tag:            "",;
        attrs:          vec_new<KVPair>(),;
        children_ids:   vec_new<int>(),;
        text_content:   "",;
        vss_class:      "",;
        dynamic_styles: vec_new<KVPair>(),;
        event_kind:     0,;
        event_type:     "",;
        handler_fn:     "",;
        state_name:     "",;
        deps:           vec_new<int>(),;
        compute_fn:     "",;
        route_path:     "",;
        route_component:"",;
        route_guards:   vec_new<string>(),;
        condition_id:   0,;
        then_ids:       vec_new<int>(),;
        else_ids:       vec_new<int>(),;
        items_id:       0,;
        key_fn:         "",;
        render_fn:      "",;
        source_line:    0;
    };
end


# ═══════════════════════════════════════════════════════
# WIR-M Node — Mid-level canonical DOM operations
# ═══════════════════════════════════════════════════════
# All high-level component abstractions have been lowered
# to concrete DOM mutation, event, and state operations.

entity WIRMNode:
    node_id:        int;
    op:             WIRMOp;
    input_ids:      Vec<int>;
    output_ids:     Vec<int>;

    # DOM op details
    tag:            string;
    attr_name:      string;
    attr_value:     string;
    attr_type:      DOMAttrType;
    text_content:   string;
    parent_id:      int;
    child_id:       int;
    ref_id:         int;

    # Style resolution
    css_class:      string;
    css_properties: Vec<KVPair>;

    # Event details
    event_type:     string;
    handler_id:     int;
    event_options:  Vec<KVPair>;

    # State details
    state_size:     int;
    state_type:     string;
    callback_id:    int;

    # Batch attrs
    batch_attrs:    Vec<KVPair>;

    # Source tracing
    source_h_id:    int;
end

func wir_m_node_new:
    in(id: int; op: WIRMOp; src_h: int)
    out WIRMNode {;
        node_id:        id,;
        op:             op,;
        input_ids:      vec_new<int>(),;
        output_ids:     vec_new<int>(),;
        tag:            "",;
        attr_name:      "",;
        attr_value:     "",;
        attr_type:      DOMAttrType::Attribute,;
        text_content:   "",;
        parent_id:      0,;
        child_id:       0,;
        ref_id:         0,;
        css_class:      "",;
        css_properties: vec_new<KVPair>(),;
        event_type:     "",;
        handler_id:     0,;
        event_options:  vec_new<KVPair>(),;
        state_size:     0,;
        state_type:     "",;
        callback_id:    0,;
        batch_attrs:    vec_new<KVPair>(),;
        source_h_id:    src_h;
    };
end


# ═══════════════════════════════════════════════════════
# WIR-L Node — Low-level WASM + JS bridge calls
# ═══════════════════════════════════════════════════════
# Each node maps directly to a WASM import call or CSS emission.

entity WIRLNode:
    node_id:            int;
    op:                 WIRLOp;
    input_ids:          Vec<int>;
    output_ids:         Vec<int>;

    # JS call metadata
    js_module:          string;
    js_func:            string;
    js_args:            Vec<int>;
    wasm_param_types:   Vec<string>;
    wasm_result_type:   string;

    # CSS emission
    css_selector:       string;
    css_declarations:   Vec<KVPair>;
    css_media_query:    string;
    css_keyframe_name:  string;
    css_keyframe_steps: Vec<KVPair>;
    css_var_name:       string;
    css_var_value:      string;

    # Memory
    string_data:        string;
    alloc_size:         int;

    # Scheduling
    delay_ms:           int;
    callback_id:        int;

    # Navigation
    url:                string;
    state_data:         string;

    # Source tracing
    source_mid_id:      int;
end

func wir_l_node_new:
    in(id: int; op: WIRLOp; src_m: int)
    out WIRLNode {;
        node_id:            id,;
        op:                 op,;
        input_ids:          vec_new<int>(),;
        output_ids:         vec_new<int>(),;
        js_module:          "",;
        js_func:            "",;
        js_args:            vec_new<int>(),;
        wasm_param_types:   vec_new<string>(),;
        wasm_result_type:   "",;
        css_selector:       "",;
        css_declarations:   vec_new<KVPair>(),;
        css_media_query:    "",;
        css_keyframe_name:  "",;
        css_keyframe_steps: vec_new<KVPair>(),;
        css_var_name:       "",;
        css_var_value:      "",;
        string_data:        "",;
        alloc_size:         0,;
        delay_ms:           0,;
        callback_id:        0,;
        url:                "",;
        state_data:         "",;
        source_mid_id:      src_m;
    };
end


export KVPair, kv_new, StateField, state_field_new;
export WIRHNode, wir_h_node_new;
export WIRMNode, wir_m_node_new;
export WIRLNode, wir_l_node_new;
