##
 * vir/rt/mod.vri — Vir Runtime Module Index
 * ===========================================
 * Root module for the pure-Vir runtime layer.
 * ZERO C library. ZERO Python. Direct kernel syscalls only.
 *
 * This module re-exports all rt/ submodules so programs
 * can simply:  include vir.rt;
 *
 * Architecture:
 *   intrinsics  → compiler-emitted inline machine code
 *   syscall     → raw kernel syscall wrappers (BSD + Linux)
 *   alloc       → mmap-based memory allocator (arena + heap)
 *   string_rt   → string operations + StringBuilder
 *   io          → file and console I/O
 *   vec_rt      → dynamic arrays (Vec<i64> + ByteVec)
 *   macho       → Mach-O executable emitter
 *   elf         → ELF executable emitter
 *   start       → _start entry point (replaces C main)
 ##

module vir.rt;

include vir.rt.intrinsics;
include vir.rt.syscall;
include vir.rt.alloc;
include vir.rt.string_rt;
include vir.rt.io;
include vir.rt.vec_rt;
include vir.rt.macho;
include vir.rt.elf;
include vir.rt.start;

# Re-export commonly used functions
export sys_exit, sys_read, sys_write, sys_open, sys_close;
export sys_mmap, sys_munmap;
export vir_alloc, vir_free, vir_realloc;
export rt_strlen, rt_strcmp, rt_streq, rt_strcat, rt_strdup, rt_itoa;
export sb_new, sb_append, sb_append_int, sb_to_string, sb_free;
export print_str, print_int, print_ln, print_newline;
export eprint_str, eprint_ln;
export file_open_read, file_open_write, file_read_all, file_close;
export read_file_str, write_file_str;
export vec_new_rt, vec_push_rt, vec_get_rt, vec_len_rt, vec_free_rt;
export bvec_new, bvec_push, bvec_push_u32_le, bvec_push_u64_le;
export bvec_len, bvec_get, bvec_data_ptr, bvec_free;
export MachOBuilder, macho_new, macho_write_to_file;
export ElfBuilder, elf_new, elf_write_to_file;
export rt_argc, rt_argv;
