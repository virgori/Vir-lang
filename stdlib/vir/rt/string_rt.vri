##
 * vir/rt/string_rt.vri — String Runtime (Pure Vir, No libc)
 * ==========================================================
 * UTF-8 string operations built on vir_alloc/vir_free.
 * Replaces C strlen, strcpy, strcmp, strcat, snprintf, etc.
 *
 * String representation
 *   Pointer to null-terminated UTF-8 byte array.
 *   Length computed on demand via byte scan.
 *   For builder patterns, StringBuilder tracks length explicitly.
 ##

module vir.rt.string_rt

include types
include alloc
import vir_alloc, vir_free, vir_realloc from alloc

# ═══════════════════════════════════════════════════════
# Low-level byte access (compiler intrinsics)
# ═══════════════════════════════════════════════════════

extern func native_read_u8(addr: int, offset: int) -> int
extern func native_write_u8(addr: int, offset: int, val: int)
extern func native_read_i64(addr: int, offset: int) -> int
extern func native_write_i64(addr: int, offset: int, val: int)
extern func native_mem_copy(dst: int, src: int, len: int)
extern func native_mem_set(dst: int, val: int, len: int)

# C-core does not bind native_mem_copy; copy bytes explicitly.
func rt_memcpy(dst: int, src: int, len: int):
    i = 0
    when i < len loop
        b = native_read_u8(src, i)
        native_write_u8(dst, i, b)
        i = i + 1
    end
end.

# ═══════════════════════════════════════════════════════
# String Length (replaces strlen)
# ═══════════════════════════════════════════════════════

func rt_strlen(s: int):

    if s == 0 do
        out 0
    end
    let i = 0
    when native_read_u8(s, i) != 0 loop
        i = i + 1
    end
    out i
end.
# ═══════════════════════════════════════════════════════
# String Copy (replaces strcpy)
# ═══════════════════════════════════════════════════════

func rt_strcpy(dst: int, src: int):

    let i = 0
    let ch = native_read_u8(src, i)
    when ch != 0 loop
        native_write_u8(dst, i, ch)
        i = i + 1
        ch = native_read_u8(src, i)
    end
    native_write_u8(dst, i, 0);    # null terminator
    out dst
end.
# ═══════════════════════════════════════════════════════
# String Compare (replaces strcmp)
# ═══════════════════════════════════════════════════════

func rt_strcmp(a: int, b: int):

    let i = 0
    when true loop
        let ca = native_read_u8(a, i)
        let cb = native_read_u8(b, i)
        if ca != cb do
            out ca - cb
        end
        if ca == 0 do
            out 0    # equal
        end
        i = i + 1
    end
    out 0
end.
func rt_streq(a: int, b: int):

    out rt_strcmp(a, b) == 0
end.
# Wrap a C string pointer as a string entity {data, byte_len, char_len}
# so stdlib APIs that expect `.data` / `.byte_len` work with get_arg().
# Layout matches String: word0=data, word1=byte_len, word2=char_len (byte ofs 0/8/16).
func str_from_cstr(p: int):
    n = 0
    if p != 0 do
        n = rt_strlen(p)
    end
    s = vir_alloc(24)
    native_write_i64(s, 0, p)
    native_write_i64(s, 8, n)
    native_write_i64(s, 16, n)
    out s
end.

# Fat-string accessors — MUST NOT be named str_len/str_byte_at/str_concat/str_eq:
# C-core parser maps those names to Q_STR_* builtins that strlen() raw C pointers.
func fat_str_len(s: int):
    if s == 0 do
        out 0
    end
    out native_read_i64(s, 8)
end.

func fat_str_byte_at(s: int, index: int):
    if s == 0 do
        out 0
    end
    data = native_read_i64(s, 0)
    out native_read_u8(data, index)
end.

func fat_str_new(literal: int):
    out str_from_cstr(literal)
end.

func fat_str_concat(a: int, b: int):
    la = 0
    lb = 0
    da = 0
    db = 0
    if a != 0 do
        da = native_read_i64(a, 0)
        la = native_read_i64(a, 8)
    end
    if b != 0 do
        db = native_read_i64(b, 0)
        lb = native_read_i64(b, 8)
    end
    total = la + lb
    p = vir_alloc(total + 1)
    if la > 0 do
        rt_memcpy(p, da, la)
    end
    if lb > 0 do
        dst = p + la
        rt_memcpy(dst, db, lb)
    end
    native_write_u8(p, total, 0)
    s = vir_alloc(24)
    native_write_i64(s, 0, p)
    native_write_i64(s, 8, total)
    native_write_i64(s, 16, total)
    out s
end.

func fat_str_eq(a: int, b: int):
    if a == 0 and b == 0 do
        out 1
    end
    if a == 0 or b == 0 do
        out 0
    end
    la = native_read_i64(a, 8)
    lb = native_read_i64(b, 8)
    if la != lb do
        out 0
    end
    da = native_read_i64(a, 0)
    db = native_read_i64(b, 0)
    i = 0
    when i < la loop
        ca = native_read_u8(da, i)
        cb = native_read_u8(db, i)
        if ca != cb do
            out 0
        end
        i = i + 1
    end
    out 1
end.

func fat_char_to_str(ch: int):
    p = vir_alloc(2)
    native_write_u8(p, 0, ch)
    native_write_u8(p, 1, 0)
    s = vir_alloc(24)
    native_write_i64(s, 0, p)
    native_write_i64(s, 8, 1)
    native_write_i64(s, 16, 1)
    out s
end.

# Compare fat-string to a raw C string (for rt_streq-style checks under C-core).
func fat_cstr_eq(fat: int, cstr: int):
    if fat == 0 do
        out rt_streq(cstr, "")
    end
    data = native_read_i64(fat, 0)
    out rt_streq(data, cstr)
end.
# ═══════════════════════════════════════════════════════
# String Concatenation (replaces strcat pattern)
# ═══════════════════════════════════════════════════════

func rt_strcat(a: int, b: int):

    let la = rt_strlen(a)
    let lb = rt_strlen(b)
    let result = vir_alloc(la + lb + 1)
    rt_memcpy(result, a, la)
    dst = result + la
    rt_memcpy(dst, b, lb)
    native_write_u8(result, la + lb, 0)
    out result
end.
# ═══════════════════════════════════════════════════════
# String Duplicate
# ═══════════════════════════════════════════════════════

func rt_strdup(s: int):

    let len = rt_strlen(s)
    let result = vir_alloc(len + 1)
    rt_memcpy(result, s, len + 1);   # includes null terminator
    out result
end.
# ═══════════════════════════════════════════════════════
# String Substring
# ═══════════════════════════════════════════════════════

func rt_substr:
    in  s: int
        start: int
        len: int

    let slen = rt_strlen(s)
    if start >= slen do
        let empty = vir_alloc(1)
        native_write_u8(empty, 0, 0)
        out empty
    end
    let actual = len
    if start + actual > slen do
        actual = slen - start
    end
    let result = vir_alloc(actual + 1)
    src = s + start
    rt_memcpy(result, src, actual)
    native_write_u8(result, actual, 0)
    out result
end.
# ═══════════════════════════════════════════════════════
# String Contains
# ═══════════════════════════════════════════════════════

func rt_strcontains(haystack: int, needle: int):

    let hlen = rt_strlen(haystack)
    let nlen = rt_strlen(needle)
    if nlen == 0 do
        out true
    end
    if nlen > hlen do
        out false
    end
    let i = 0
    when i <= hlen - nlen loop
        let j = 0
        let match = true
        when j < nlen loop
            if native_read_u8(haystack, i + j) != native_read_u8(needle, j) do
                match = false
                out skip
            end
            j = j + 1
        end
        if match do
            out true
        end
        i = i + 1
    end
    out false
end.
# ═══════════════════════════════════════════════════════
# String from Literal
# ═══════════════════════════════════════════════════════

func rt_str_from_cstr(cstr: int):

    out rt_strdup(cstr)
end.
# ═══════════════════════════════════════════════════════
# Integer to String (replaces snprintf %d)
# ═══════════════════════════════════════════════════════

func rt_itoa(n: int):

    let buf = vir_alloc(24);    # max i64 digits + sign + null
    let pos = 0
    let val = n

    if val < 0 do
        native_write_u8(buf, 0, 45);   # '-'
        pos = 1
        val = 0 - val
    end

    if val == 0 do
        native_write_u8(buf, pos, 48);   # '0'
        pos = pos + 1
        native_write_u8(buf, pos, 0)
        out buf
    end

    # Write digits in reverse to temp buffer
    let tmp = vir_alloc(24)
    let tlen = 0
    when val > 0 loop
        let digit = val mod 10
        native_write_u8(tmp, tlen, 48 + digit)
        tlen = tlen + 1
        val = val / 10
    end

    # Reverse into output
    let i = tlen - 1
    when i >= 0 loop
        native_write_u8(buf, pos, native_read_u8(tmp, i))
        pos = pos + 1
        i = i - 1
    end
    native_write_u8(buf, pos, 0)
    vir_free(tmp)
    out buf
end.
# ═══════════════════════════════════════════════════════
# String to Integer (replaces atoi/strtol)
# ═══════════════════════════════════════════════════════

func rt_atoi(s: int):

    let i = 0
    let sign = 1
    let result = 0

    # Skip whitespace
    when native_read_u8(s, i) == 32 or native_read_u8(s, i) == 9 loop
        i = i + 1
    end

    # Sign
    if native_read_u8(s, i) == 45 do # '-'
        sign = -1
        i = i + 1
    eif native_read_u8(s, i) == 43 do # '+'
        i = i + 1
    end

    # Digits
    let ch = native_read_u8(s, i)
    when ch >= 48 and ch <= 57 loop
        result = result * 10 + (ch - 48)
        i = i + 1
        ch = native_read_u8(s, i)
    end

    out result * sign
end.
# ═══════════════════════════════════════════════════════
# Hex Integer to String
# ═══════════════════════════════════════════════════════

func rt_itoa_hex(n: int, width: int):

    let hex_chars = "0123456789abcdef"
    let buf = vir_alloc(width + 3)
    native_write_u8(buf, 0, 48);    # '0'
    native_write_u8(buf, 1, 120);   # 'x'
    let pos = 2
    let i = width - 1
    when i >= 0 loop
        let nibble = (n shr (i * 4)) & 0xF
        native_write_u8(buf, pos, native_read_u8(hex_chars, nibble))
        pos = pos + 1
        i = i - 1
    end
    native_write_u8(buf, pos, 0)
    out buf
end.
# ═══════════════════════════════════════════════════════
# StringBuilder — Efficient String Building
# ═══════════════════════════════════════════════════════

entity StringBuilder:
    buf:     int;     # allocated buffer
    len:     int;     # current length
    cap:     int     # capacity
end.
func sb_new:
    let cap = 256
    let buf = vir_alloc(cap)
    out StringBuilder ( buf: buf, len: 0, cap: cap )
end.
func sb_grow(sb: StringBuilder, needed: int):

    if sb.len + needed <= sb.cap do
        out sb
    end
    let new_cap = sb.cap * 2
    when new_cap < sb.len + needed loop
        new_cap = new_cap * 2
    end
    sb.buf = vir_realloc(sb.buf, new_cap)
    sb.cap = new_cap
    out sb
end.
func sb_append(sb: StringBuilder, s: int):

    let slen = rt_strlen(s)
    sb = sb_grow(sb, slen)
    dst = sb.buf + sb.len
    rt_memcpy(dst, s, slen)
    sb.len = sb.len + slen
    out sb
end.
func sb_append_char(sb: StringBuilder, ch: int):

    sb = sb_grow(sb, 1)
    native_write_u8(sb.buf, sb.len, ch)
    sb.len = sb.len + 1
    out sb
end.
func sb_append_int(sb: StringBuilder, n: int):

    let s = rt_itoa(n)
    sb = sb_append(sb, s)
    vir_free(s)
    out sb
end.
func sb_to_string(sb: StringBuilder):

    native_write_u8(sb.buf, sb.len, 0)
    out sb.buf
end.
func sb_len(sb: StringBuilder):

    out sb.len
end.
func sb_clear(sb: StringBuilder):

    sb.len = 0
    out sb
end.
func sb_free(sb: StringBuilder):

    vir_free(sb.buf)
end.