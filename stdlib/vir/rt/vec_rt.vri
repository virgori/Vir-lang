##
 * vir/rt/vec_rt.vri — Dynamic Array Runtime (Pure Vir)
 * =====================================================
 * Growable vector (dynamic array) built on vir_alloc/realloc.
 * Core data structure for the self-hosting compiler.
 *
 * Layout: [cap:i64][len:i64][data[0]][data[1]]...
 *                            ^-- returned pointer
 ##

module vir.rt.vec_rt;

include types;
include alloc;
import vir_alloc, vir_free, vir_realloc from alloc;

extern func native_read_i64(addr: int, offset: int) -> int;
extern func native_write_i64(addr: int, offset: int, val: int);
extern func native_mem_copy(dst: int, src: int, len: int);

# ═══════════════════════════════════════════════════════
# Vec operations (i64 element array)
# ═══════════════════════════════════════════════════════
# Header: ptr[-2] = capacity, ptr[-1] = length
# Data starts at ptr[0]

const VEC_INIT_CAP = 16;
const ELEM_SIZE = 8;          # i64 = 8 bytes
const HEADER_SIZE = 16;       # 2 * 8 bytes

func vec_new_rt:
    let base = vir_alloc(HEADER_SIZE + VEC_INIT_CAP * ELEM_SIZE);
    let data = base + HEADER_SIZE;
    # Offsets are bytes (same convention as collections/vec and bvec).
    native_write_i64(base, 0, VEC_INIT_CAP);   # capacity
    native_write_i64(base, 8, 0);               # length
    out data
end.
func vec_len_rt(v: int):

    if v == 0 do
        out 0
    end
    out native_read_i64(v - 8, 0)    # ptr[-1]
end.
func vec_cap_rt(v: int):

    out native_read_i64(v - 16, 0)   # ptr[-2]
end.
func vec_push_rt(v: int, val: int):

    let len = vec_len_rt(v);
    let cap = vec_cap_rt(v);

    if len >= cap do
        # Grow: double capacity
        let new_cap = cap * 2;
        if new_cap < VEC_INIT_CAP do
            new_cap = VEC_INIT_CAP
        end
        let base = v - HEADER_SIZE;
        let new_base = vir_realloc(base, HEADER_SIZE + new_cap * ELEM_SIZE);
        let new_data = new_base + HEADER_SIZE;
        native_write_i64(new_base, 0, new_cap);
        v = new_data
    end

    native_write_i64(v, len * 8, val);
    native_write_i64(v - 8, 0, len + 1);
    out v
end.
func vec_get_rt(v: int, index: int):

    if v == 0 do
        out 0
    end
    out native_read_i64(v, index * 8)
end.
func vec_set_rt:
    in  v: int;
        index: int;
        val: int

    native_write_i64(v, index * 8, val)
end.
func vec_pop_rt(v: int):

    let len = vec_len_rt(v);
    if len == 0 do
        out 0
    end
    let val = vec_get_rt(v, len - 1);
    native_write_i64(v - 8, 0, len - 1);
    out val
end.
func vec_last_rt(v: int):

    let len = vec_len_rt(v);
    if len == 0 do
        out 0
    end
    out vec_get_rt(v, len - 1)
end.
func vec_clear_rt(v: int):

    native_write_i64(v - 8, 0, 0)
end.
func vec_free_rt(v: int):

    vir_free(v - HEADER_SIZE)
end.
func vec_copy_rt(v: int):

    let len = vec_len_rt(v);
    let new_v = vec_new_rt();
    let i = 0;
    when i < len loop
        new_v = vec_push_rt(new_v, vec_get_rt(v, i));
        i = i + 1
    end
    out new_v
end.
func vec_contains_rt(v: int, val: int):

    let len = vec_len_rt(v);
    let i = 0;
    when i < len loop
        if vec_get_rt(v, i) == val do
            out true
        end
        i = i + 1
    end
    out false
end.
func vec_index_of_rt(v: int, val: int):

    let len = vec_len_rt(v);
    let i = 0;
    when i < len loop
        if vec_get_rt(v, i) == val do
            out i
        end
        i = i + 1
    end
    out -1
end.
# ═══════════════════════════════════════════════════════
# Byte Vec — for code buffers (u8 elements)
# ═══════════════════════════════════════════════════════

extern func native_read_u8(addr: int, offset: int) -> int;
extern func native_write_u8(addr: int, offset: int, val: int);

const BVEC_INIT_CAP = 4096;

func bvec_new:
    let base = vir_alloc(HEADER_SIZE + BVEC_INIT_CAP);
    let data = base + HEADER_SIZE;
    # Offsets are bytes (same as vec native_read/write_i64 convention).
    native_write_i64(base, 0, BVEC_INIT_CAP);
    native_write_i64(base, 8, 0);
    out data
end.
func bvec_len(v: int):

    out native_read_i64(v - 8, 0)
end.
func bvec_push(v: int, byte: int):

    let len = bvec_len(v);
    let cap = native_read_i64(v - 16, 0);

    if len >= cap do
        let new_cap = cap * 2;
        let base = v - HEADER_SIZE;
        let new_base = vir_realloc(base, HEADER_SIZE + new_cap);
        let new_data = new_base + HEADER_SIZE;
        native_write_i64(new_base, 0, new_cap);
        v = new_data
    end

    native_write_u8(v, len, byte & 0xFF);
    native_write_i64(v - 8, 0, len + 1);
    out v
end.
func bvec_push_u16_le(v: int, val: int):

    v = bvec_push(v, val & 0xFF);
    v = bvec_push(v, (val shr 8) & 0xFF);
    out v
end.
func bvec_push_u32_le(v: int, val: int):

    v = bvec_push(v, val & 0xFF);
    v = bvec_push(v, (val shr 8) & 0xFF);
    v = bvec_push(v, (val shr 16) & 0xFF);
    v = bvec_push(v, (val shr 24) & 0xFF);
    out v
end.
func bvec_push_u64_le(v: int, val: int):

    v = bvec_push_u32_le(v, val & 0xFFFFFFFF);
    v = bvec_push_u32_le(v, (val shr 32) & 0xFFFFFFFF);
    out v
end.
func bvec_get(v: int, index: int):

    out native_read_u8(v, index)
end.
func bvec_set:
    in  v: int;
        index: int;
        byte: int

    native_write_u8(v, index, byte & 0xFF)
end.
func bvec_patch_u32_le:
    in  v: int;
        offset: int;
        val: int

    native_write_u8(v, offset, val & 0xFF);
    native_write_u8(v, offset + 1, (val shr 8) & 0xFF);
    native_write_u8(v, offset + 2, (val shr 16) & 0xFF);
    native_write_u8(v, offset + 3, (val shr 24) & 0xFF)
end.
func bvec_data_ptr(v: int):

    out v   # data pointer is v itself
end.
func bvec_free(v: int):

    vir_free(v - HEADER_SIZE)
end.