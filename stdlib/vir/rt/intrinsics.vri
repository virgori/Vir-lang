##
 * vir/rt/intrinsics.vri — Compiler Intrinsics (Pure Vir)
 * ========================================================
 * Maps extern func declarations to inline machine code.
 * These are the primitive operations that cannot be written
 * in Vir itself — they emit raw CPU instructions.
 *
 * The self-hosting compiler recognizes these names and emits
 * the appropriate machine code inline rather than generating
 * a function call.
 *
 * ZERO external dependency — these are implemented by the
 * compiler's code generator directly.
 ##

module vir.rt.intrinsics;

# ═══════════════════════════════════════════════════════
# Memory Intrinsics
# ═══════════════════════════════════════════════════════
# These emit the smallest possible instruction sequence
# for direct memory access. No function call overhead.

# Read a single byte from memory
# ARM64: LDRB W_dest, [X_addr, X_offset]
# x86:   MOVZX eax, BYTE PTR [rdi + rsi]
extern func native_read_u8(addr: int, offset: int) -> int;

# Write a single byte to memory
# ARM64: STRB W_val, [X_addr, X_offset]
# x86:   MOV BYTE PTR [rdi + rsi], dl
extern func native_write_u8(addr: int, offset: int, val: int);

# Read a 64-bit integer from memory
# ARM64: LDR X_dest, [X_addr, X_offset, LSL #3]
# x86:   MOV rax, QWORD PTR [rdi + rsi*8]
extern func native_read_i64(addr: int, offset: int) -> int;

# Write a 64-bit integer to memory
# ARM64: STR X_val, [X_addr, X_offset, LSL #3]
# x86:   MOV QWORD PTR [rdi + rsi*8], rdx
extern func native_write_i64(addr: int, offset: int, val: int);

# Read a 16-bit value from memory
# ARM64: LDRH W_dest, [X_addr, X_offset]
# x86:   MOVZX eax, WORD PTR [rdi + rsi]
extern func native_read_u16(addr: int, offset: int) -> int;

# Write a 16-bit value to memory
# ARM64: STRH W_val, [X_addr, X_offset]
# x86:   MOV WORD PTR [rdi + rsi], dx
extern func native_write_u16(addr: int, offset: int, val: int);

# Read a 32-bit value from memory
# ARM64: LDR W_dest, [X_addr, X_offset]
# x86:   MOV eax, DWORD PTR [rdi + rsi]
extern func native_read_u32(addr: int, offset: int) -> int;

# Write a 32-bit value to memory
# ARM64: STR W_val, [X_addr, X_offset]
# x86:   MOV DWORD PTR [rdi + rsi], edx
extern func native_write_u32(addr: int, offset: int, val: int);


# ═══════════════════════════════════════════════════════
# Bulk Memory Operations
# ═══════════════════════════════════════════════════════

# Copy n bytes from src to dst (non-overlapping)
# Emits an optimized copy loop (8 bytes at a time, then tail)
extern func mem_copy(dst: int, src: int, n: int);

# Set n bytes at dst to val (byte value 0-255)
# Emits an optimized fill loop
extern func mem_set(dst: int, val: int, n: int);

# Compare n bytes at a and b, returns 0 if equal
extern func mem_cmp(a: int, b: int, n: int) -> int;


# ═══════════════════════════════════════════════════════
# System Call Intrinsics
# ═══════════════════════════════════════════════════════
# These emit the SVC/SYSCALL instruction directly.
#
# ARM64: MOV X16, #num; SVC #0x80
# x86:   MOV rax, num; SYSCALL

extern func syscall0(num: int) -> int;
extern func syscall1(num: int, a1: int) -> int;
extern func syscall2(num: int, a1: int, a2: int) -> int;
extern func syscall3(num: int, a1: int, a2: int, a3: int) -> int;
extern func syscall4(num: int, a1: int, a2: int, a3: int, a4: int) -> int;
extern func syscall5(num: int, a1: int, a2: int, a3: int, a4: int, a5: int) -> int;
extern func syscall6(num: int, a1: int, a2: int, a3: int, a4: int, a5: int, a6: int) -> int;


# ═══════════════════════════════════════════════════════
# Atomic Intrinsics (for future concurrency)
# ═══════════════════════════════════════════════════════

# Atomic load 64-bit
# ARM64: LDAR X_dest, [X_addr]
extern func atomic_load(addr: int) -> int;

# Atomic store 64-bit
# ARM64: STLR X_val, [X_addr]
extern func atomic_store(addr: int, val: int);

# Compare-and-swap: if *addr == expected, set *addr = desired, return old
# ARM64: LDAXR + STLXR loop
# x86:   LOCK CMPXCHG
extern func atomic_cas(addr: int, expected: int, desired: int) -> int;

# Atomic add: return old value
# ARM64: LDADDAL
# x86:   LOCK XADD
extern func atomic_add(addr: int, val: int) -> int;


# ═══════════════════════════════════════════════════════
# Architecture Query
# ═══════════════════════════════════════════════════════

# Returns 0 for ARM64, 1 for x86_64
# This is a compile-time constant embedded by the compiler
extern func host_arch() -> int;

# Returns page size (16384 on ARM64 macOS, 4096 on Linux)
extern func host_page_size() -> int;

export native_read_u8, native_write_u8, native_read_i64, native_write_i64;
export native_read_u16, native_write_u16, native_read_u32, native_write_u32;
export mem_copy, mem_set, mem_cmp;
export syscall0, syscall1, syscall2, syscall3, syscall4, syscall5, syscall6;
export atomic_load, atomic_store, atomic_cas, atomic_add;
export host_arch, host_page_size;
