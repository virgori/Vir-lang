##
 * vir/rt/env.vri — Platform Environment Runtime (Pure Vir, Zero Libc)
 * =================================================================
 * Manages process environment variables independently of libc malloc.
 * On macOS: snapshots environment via _NSGetEnviron() without libc calls.
 * On Linux: reads /proc/self/environ via raw syscalls.
 * Maintains process environment table in Vir native memory.
 ##

include types
include option
import Option, Some, None from option
include result
import Result, Ok, Err from result
include vec_rt
import vec_new_rt, vec_push_rt, vec_get_rt, vec_len_rt from vec_rt
include alloc
import vir_alloc from alloc
include vir.rt.syscall

extern func native_read_u8(addr: int, offset: int) -> int
extern func native_write_u8(addr: int, offset: int, val: int)
extern func native_read_i64(addr: int, offset: int) -> int
extern func native_write_i64(addr: int, offset: int, val: int)
extern func _NSGetEnviron() -> int

# Global environment tables:
# g_env_keys stores pointers to key C-strings
# g_env_vals stores pointers to val C-strings
# g_env_active stores 1 (active) or 0 (deleted)
var g_env_keys: int = 0
var g_env_vals: int = 0
var g_env_active: int = 0
var g_env_inited: int = 0

func rt_str_len(p: int) -> int:
    if p == 0 do out 0 end
    var i = 0
    when native_read_u8(p, i) != 0 loop
        i = i + 1
    end
    out i
end.

func rt_str_eq(a: int, b: int) -> bool:
    if a == b do out true end
    if a == 0 or b == 0 do out false end
    var i = 0
    loop
        let ca = native_read_u8(a, i)
        let cb = native_read_u8(b, i)
        if ca != cb do out false end
        if ca == 0 do out true end
        i = i + 1
    end
    out true
end.

func rt_copy_str(src: int, len: int) -> int:
    let buf = vir_alloc(len + 1)
    var i = 0
    when i < len loop
        native_write_u8(buf, i, native_read_u8(src, i))
        i = i + 1
    end
    native_write_u8(buf, len, 0)
    out buf
end.

func rt_clone_str(src: int) -> int:
    if src == 0 do out 0 end
    let len = rt_str_len(src)
    out rt_copy_str(src, len)
end.

# Initialize process environment table from OS
func rt_env_init:
    if g_env_inited != 0 do out end
    g_env_keys = vec_new_rt()
    g_env_vals = vec_new_rt()
    g_env_active = vec_new_rt()
    g_env_inited = 1

    let plat = sys_platform()
    if plat == Platform.MacOS_ARM64 or plat == Platform.MacOS_x86_64 do
        let pp = _NSGetEnviron()
        if pp != 0 do
            let p = native_read_i64(pp, 0)
            if p != 0 do
                var idx = 0
                loop
                    let entry_p = native_read_i64(p, idx * 8)
                    if entry_p == 0 do break end
                    let n = rt_str_len(entry_p)
                    var eq_pos = 0 - 1
                    var i = 0
                    when i < n loop
                        if native_read_u8(entry_p, i) == 61 do # '='
                            eq_pos = i
                            break
                        end
                        i = i + 1
                    end
                    if eq_pos >= 0 do
                        let k = rt_copy_str(entry_p, eq_pos)
                        let v = rt_copy_str(entry_p + eq_pos + 1, n - eq_pos - 1)
                        g_env_keys = vec_push_rt(g_env_keys, k)
                        g_env_vals = vec_push_rt(g_env_vals, v)
                        g_env_active = vec_push_rt(g_env_active, 1)
                    end
                    idx = idx + 1
                end
            end
        end
    else
        # Linux /proc/self/environ
        let proc_path = "/proc/self/environ"
        let fd = sys_open(proc_path as int, 0, 0) # O_RDONLY
        if fd >= 0 do
            let buf_size = 65536
            let buf = vir_alloc(buf_size)
            var total = 0
            loop
                let n = sys_read(fd, buf + total, buf_size - total)
                if n <= 0 do break end
                total = total + n
                if total >= buf_size do break end
            end
            sys_close(fd)

            # Parse NUL-separated KEY=VALUE
            var entry_start = 0
            var i = 0
            when i < total loop
                let b = native_read_u8(buf, i)
                if b == 0 do
                    let entry_len = i - entry_start
                    if entry_len > 0 do
                        var eq_pos = 0 - 1
                        var j = 0
                        when j < entry_len loop
                            if native_read_u8(buf, entry_start + j) == 61 do
                                eq_pos = j
                                break
                            end
                            j = j + 1
                        end
                        if eq_pos >= 0 do
                            let k = rt_copy_str(buf + entry_start, eq_pos)
                            let v = rt_copy_str(buf + entry_start + eq_pos + 1, entry_len - eq_pos - 1)
                            g_env_keys = vec_push_rt(g_env_keys, k)
                            g_env_vals = vec_push_rt(g_env_vals, v)
                            g_env_active = vec_push_rt(g_env_active, 1)
                        end
                    end
                    entry_start = i + 1
                end
                i = i + 1
            end
        end
    end
end.

func rt_env_find(name: int) -> int:
    rt_env_init()
    let n = vec_len_rt(g_env_keys)
    var i = 0
    when i < n loop
        if vec_get_rt(g_env_active, i) != 0 do
            let k = vec_get_rt(g_env_keys, i)
            if rt_str_eq(k, name) do
                out i
            end
        end
        i = i + 1
    end
    out 0 - 1
end.

# Get environment variable: returns cloned string pointer or 0 if missing
func rt_env_get(name: int) -> Option:
    rt_env_init()
    let idx = rt_env_find(name)
    if idx >= 0 do
        let v = vec_get_rt(g_env_vals, idx)
        # Return cloned string so caller owns it
        let cloned = rt_clone_str(v)
        out Some(cloned as string)
    end
    out None
end.

func rt_env_has(name: int) -> bool:
    rt_env_init()
    out rt_env_find(name) >= 0
end.

func rt_env_set(name: int, val: int) -> Result:
    rt_env_init()
    # Validate name: cannot be empty, cannot contain '=' or NUL
    let nlen = rt_str_len(name)
    if nlen == 0 do
        out Err("environment variable name cannot be empty")
    end
    var i = 0
    when i < nlen loop
        let ch = native_read_u8(name, i)
        if ch == 61 do # '='
            out Err("environment variable name cannot contain '='")
        end
        if ch == 0 do
            out Err("environment variable name cannot contain NUL")
        end
        i = i + 1
    end

    # Validate value: cannot contain NUL within declared length
    let vlen = rt_str_len(val)
    var j = 0
    when j < vlen loop
        if native_read_u8(val, j) == 0 do
            out Err("environment variable value cannot contain NUL")
        end
        j = j + 1
    end

    let idx = rt_env_find(name)
    let new_val = rt_clone_str(val)
    if idx >= 0 do
        # Overwrite existing
        vec_set_rt(g_env_vals, idx, new_val)
        vec_set_rt(g_env_active, idx, 1)
    else
        # Insert new
        let new_key = rt_clone_str(name)
        g_env_keys = vec_push_rt(g_env_keys, new_key)
        g_env_vals = vec_push_rt(g_env_vals, new_val)
        g_env_active = vec_push_rt(g_env_active, 1)
    end
    out Ok(void)
end.

func rt_env_unset(name: int) -> Result:
    rt_env_init()
    let idx = rt_env_find(name)
    if idx >= 0 do
        vec_set_rt(g_env_active, idx, 0)
    end
    # Idempotent: unset nonexistent key succeeds
    out Ok(void)
end.

func rt_env_count() -> int:
    rt_env_init()
    let n = vec_len_rt(g_env_keys)
    var count = 0
    var i = 0
    when i < n loop
        if vec_get_rt(g_env_active, i) != 0 do
            count = count + 1
        end
        i = i + 1
    end
    out count
end.

func rt_env_key_at(active_idx: int) -> string:
    rt_env_init()
    let n = vec_len_rt(g_env_keys)
    var seen = 0
    var i = 0
    when i < n loop
        if vec_get_rt(g_env_active, i) != 0 do
            if seen == active_idx do
                let k = vec_get_rt(g_env_keys, i)
                out rt_clone_str(k) as string
            end
            seen = seen + 1
        end
        i = i + 1
    end
    out ""
end.

func rt_env_val_at(active_idx: int) -> string:
    rt_env_init()
    let n = vec_len_rt(g_env_vals)
    var seen = 0
    var i = 0
    when i < n loop
        if vec_get_rt(g_env_active, i) != 0 do
            if seen == active_idx do
                let v = vec_get_rt(g_env_vals, i)
                out rt_clone_str(v) as string
            end
            seen = seen + 1
        end
        i = i + 1
    end
    out ""
end.

func rt_env_clear:
    rt_env_init()
    let n = vec_len_rt(g_env_active)
    var i = 0
    when i < n loop
        vec_set_rt(g_env_active, i, 0)
        i = i + 1
    end
end.

export rt_env_init, rt_env_get, rt_env_has, rt_env_set, rt_env_unset, rt_env_count, rt_env_key_at, rt_env_val_at, rt_env_clear
