##
 * vir/rt/io.vri — I/O Runtime (Pure Vir, No libc)
 * ==================================================
 * File and console I/O built on raw syscalls.
 * Replaces C stdio (printf, fopen, fread, fwrite, fclose).
 *
 * Buffered I/O for performance.
 * UTF-8 native throughout.
 ##

module vir.rt.io

include types
include syscall
import sys_read, sys_write, sys_open, sys_close, sys_lseek,
    sys_fstat, STDIN_FD, STDOUT_FD, STDERR_FD,
    O_RDONLY, O_WRONLY, O_RDWR, O_CREAT, O_TRUNC, O_APPEND from syscall
include alloc
import vir_alloc, vir_free, vir_realloc from alloc
include string_rt
import rt_strlen, rt_itoa, sb_new, sb_append, sb_append_char,
    sb_append_int, sb_to_string, sb_free, StringBuilder from string_rt


# ═══════════════════════════════════════════════════════
# Console Write — replaces printf/fputs
# ═══════════════════════════════════════════════════════

func print_str(s: int):

    let len = rt_strlen(s)
    sys_write(STDOUT_FD, s, len)
end.
func print_int(n: int):

    let s = rt_itoa(n)
    print_str(s)
end.
func print_ln(s: int):

    print_str(s)
    print_str("\n")
end.
func print_newline:
    let nl = "\n"
    sys_write(STDOUT_FD, nl, 1)
end.
func eprint_str(s: int):

    let len = rt_strlen(s)
    sys_write(STDERR_FD, s, len)
end.
func eprint_ln(s: int):

    eprint_str(s)
    let nl = "\n"
    sys_write(STDERR_FD, nl, 1)
end.
# ═══════════════════════════════════════════════════════
# Console Read — replaces scanf/fgets
# ═══════════════════════════════════════════════════════

func read_line:
    let buf = vir_alloc(4096)
    let pos = 0
    let byte_buf = vir_alloc(1)

    when true loop
        let n = sys_read(STDIN_FD, byte_buf, 1)
        if n <= 0 do
            out skip
        end

        extern func native_read_u8(addr: int, offset: int) -> int
        extern func native_write_u8(addr: int, offset: int, val: int)

        let ch = native_read_u8(byte_buf, 0)
        if ch == 10 do # '\n'
            out skip
        end
        native_write_u8(buf, pos, ch)
        pos = pos + 1

        if pos >= 4095 do
            out skip
        end
    end

    extern func native_write_u8(addr: int, offset: int, val: int)
    native_write_u8(buf, pos, 0)
    out buf
end.
# ═══════════════════════════════════════════════════════
# File Handle
# ═══════════════════════════════════════════════════════

entity VirFile:
    fd:       int,
        is_open:  bool,
        mode:     int     # O_RDONLY / O_WRONLY / O_RDWR
end.
const FILE_NONE = VirFile ( fd: -1, is_open: false, mode: 0 )

# ═══════════════════════════════════════════════════════
# File Open / Close
# ═══════════════════════════════════════════════════════

func file_open_read(path: int):

    let fd = sys_open(path, O_RDONLY, 0)
    print_str("virc: bootstrap read fd=")
    print_int(fd)
    print_ln("")
    if fd < 0 do
        out VirFile ( fd: -1, is_open: false, mode: 0 )
    end
    out VirFile ( fd: fd, is_open: true, mode: O_RDONLY )
end.
func file_open_write(path: int, mode: int):

    let fd = sys_open(path, O_WRONLY bit_or O_CREAT bit_or O_TRUNC, mode)
    if fd < 0 do
        out VirFile ( fd: -1, is_open: false, mode: 0 )
    end
    out VirFile ( fd: fd, is_open: true, mode: O_WRONLY )
end.
func file_open_append(path: int, mode: int):

    let fd = sys_open(path, O_WRONLY bit_or O_CREAT bit_or O_APPEND, mode)
    if fd < 0 do
        out VirFile ( fd: -1, is_open: false, mode: 0 )
    end
    out VirFile ( fd: fd, is_open: true, mode: O_WRONLY )
end.
func file_close(f: VirFile):

    if (f as i64) <= 4096 do
        out 0
    end
    if f.is_open do
        sys_close(f.fd)
    end
end.
# ═══════════════════════════════════════════════════════
# File Read
# ═══════════════════════════════════════════════════════

func file_read_all(f: VirFile):

    if (f as i64) <= 4096 or f.is_open == false do
        out 0
    end

    # Get file size
    let end_pos = sys_lseek(f.fd, 0, 2);    # SEEK_END
    sys_lseek(f.fd, 0, 0);                   # SEEK_SET

    if end_pos <= 0 do
        let empty = vir_alloc(1)
        extern func native_write_u8(addr: int, offset: int, val: int)
        native_write_u8(empty, 0, 0)
        out empty
    end

    let buf = vir_alloc(end_pos + 1)
    var total = 0
    var keep_reading = 1
    when total < end_pos and keep_reading == 1 loop
        let n = sys_read(f.fd, buf + total, end_pos - total)
        if n == -4 do
            skip
        end
        if n <= 0 do
            keep_reading = 0
            skip
        end
        total = total + n
    end

    extern func native_write_u8(addr: int, offset: int, val: int)
    native_write_u8(buf, total, 0);    # null-terminate
    out buf
end.
func file_read_bytes:
    in  f: VirFile
        buf: int
        count: int

    if f.is_open == false do
        out -1
    end
    out sys_read(f.fd, buf, count)
end.
# ═══════════════════════════════════════════════════════
# File Write
# ═══════════════════════════════════════════════════════

func file_write_str(f: VirFile, s: int):

    if f.is_open == false do
        out -1
    end
    let len = rt_strlen(s)
    out sys_write(f.fd, s, len)
end.
func file_write_bytes:
    in  f: VirFile
        data: int
        len: int

    if f.is_open == false do
        out -1
    end
    var written = 0
    var keep_writing = 1
    when written < len and keep_writing == 1 loop
        let n = sys_write(f.fd, data + written, len - written)
        if n == -4 do
            skip
        end
        if n <= 0 do
            keep_writing = 0
            skip
        end
        written = written + n
    end
    out written
end.
# ═══════════════════════════════════════════════════════
# File Size
# ═══════════════════════════════════════════════════════

func file_size(f: VirFile):

    let cur = sys_lseek(f.fd, 0, 1);      # SEEK_CUR
    let end_pos = sys_lseek(f.fd, 0, 2);  # SEEK_END
    sys_lseek(f.fd, cur, 0);              # restore position
    out end_pos
end.
# ═══════════════════════════════════════════════════════

# Convenience: Read file by path
# ═══════════════════════════════════════════════════════

extern func native_write_u8(addr: int, offset: int, val: int)

func read_file_str(path: int):
    # Keep the bootstrap path scalar-only. Returning VirFile across a
    # self-hosted generation currently depends on aggregate-return ABI details
    # and can turn a valid descriptor into an empty read in the next compiler.
    let fd = sys_open(path, O_RDONLY, 0)
    if fd < 0 do
        out 0
    end
    let sz = sys_lseek(fd, 0, 2)
    sys_lseek(fd, 0, 0)
    if sz <= 0 do
        var cap = 65536
        var content = vir_alloc(cap)
        var total = 0
        var reading = 1
        when reading == 1 loop
            let n = sys_read(fd, content + total, cap - total - 1)
            if n == -4 do
                skip
            end
            if n <= 0 do
                reading = 0
                skip
            end
            total = total + n
            if total + 1 >= cap do
                cap = cap * 2
                content = vir_realloc(content, cap)
            end
        end
        native_write_u8(content, total, 0)
        sys_close(fd)
        out content
    end
    let content = vir_alloc(sz + 1)
    var total = 0
    var reading = 1
    when total < sz and reading == 1 loop
        var to_read = sz - total
        if to_read > 65536 do
            to_read = 65536
        end
        let n = sys_read(fd, content + total, to_read)
        if n == -4 do
            skip
        end
        if n <= 0 do
            reading = 0
            skip
        end
        total = total + n
    end
    native_write_u8(content, total, 0)
    sys_close(fd)
    out content
end.
# ═══════════════════════════════════════════════════════
# Convenience: Write string to file by path
# ═══════════════════════════════════════════════════════

func write_file_str(path: int, content: int):

    let f = file_open_write(path, 0o644)
    if (f as i64) <= 4096 or f.is_open == false do
        out false
    end
    file_write_str(f, content)
    out true
end.
# ═══════════════════════════════════════════════════════
# Convenience: Write bytes to file by path
# ═══════════════════════════════════════════════════════

func write_file_bytes:
    in  path: int
        data: int
        len: int
        mode: int

    let f = file_open_write(path, mode)
    if f.is_open == false do
        out false
    end
    file_write_bytes(f, data, len)
    sys_close(f.fd)
    out true
end.
