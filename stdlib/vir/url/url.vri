##
 * vir/url/url.vri — URL Parsing & Building
 * ===========================================
 * Inspired by Python: urllib.parse
 * Inspired by Rust: url crate (WHATWG URL Standard)
 * Inspired by C: curl_url_*
 *
 * RFC 3986 URI parsing: scheme, authority, path, query, fragment.
 * URL-encoding / decoding. Query string builder.
 ##

include types;
include result;
import Result, Ok, Err from result;
include option;
import Option, Some, None from option;
include string;
import String, str_new, str_byte_len, str_ptr, str_concat,
       str_find, str_substr, str_contains from string;
include vec;
import Vec, vec_new, vec_push, vec_len, vec_get from vec;

# ═══════════════════════════════════════════════════════
# URL Entity
# ═══════════════════════════════════════════════════════

entity Url:
    scheme:   string;          # "http", "https", "ftp"
    username: Option<string>;
    password: Option<string>;
    host:     string;          # "example.com"
    port:     Option<int>;
    path:     string;          # "/api/v1/users"
    query:    Option<string>;  # "page=1&size=10"
    fragment: Option<string>;  # "section1"
end

entity QueryParam:
    key:   string;
    value: string;
end

# ═══════════════════════════════════════════════════════
# Parsing
# ═══════════════════════════════════════════════════════

## Parse a URL string into components.
func url_parse:
    in(raw: string)
    slen = str_byte_len(raw);
    if slen == 0:
        out Err(str_new("URL: empty string"));
    end

    # Extract scheme
    colon_pos = str_find(raw, str_new("://"));
    if colon_pos < 0:
        out Err(str_new("URL: missing scheme"));
    end
    scheme = str_substr(raw, 0, colon_pos);
    rest = str_substr(raw, colon_pos + 3, slen);

    # Extract fragment (after #)
    fragment = None;
    hash_pos = str_find(rest, str_new("#"));
    if hash_pos >= 0:
        fragment = Some(str_substr(rest, hash_pos + 1, str_byte_len(rest)));
        rest = str_substr(rest, 0, hash_pos);
    end

    # Extract query (after ?)
    query = None;
    q_pos = str_find(rest, str_new("?"));
    if q_pos >= 0:
        query = Some(str_substr(rest, q_pos + 1, str_byte_len(rest)));
        rest = str_substr(rest, 0, q_pos);
    end

    # Extract path (after first /)
    path = str_new("/");
    slash_pos = str_find(rest, str_new("/"));
    if slash_pos >= 0:
        path = str_substr(rest, slash_pos, str_byte_len(rest));
        rest = str_substr(rest, 0, slash_pos);
    end

    # Extract userinfo (before @)
    username = None;
    password = None;
    at_pos = str_find(rest, str_new("@"));
    if at_pos >= 0:
        userinfo = str_substr(rest, 0, at_pos);
        rest = str_substr(rest, at_pos + 1, str_byte_len(rest));
        colon = str_find(userinfo, str_new(":"));
        if colon >= 0:
            username = Some(str_substr(userinfo, 0, colon));
            password = Some(str_substr(userinfo, colon + 1, str_byte_len(userinfo)));
        else
            username = Some(userinfo);
        end
    end

    # Extract host:port
    host = rest;
    port = None;
    # Check for IPv6 bracket notation [::1]:port
    if str_byte_len(rest) > 0:
        b0 = native_load_u8(str_ptr(rest));
        if b0 == 0x5B:  # '['
            bracket = str_find(rest, str_new("]"));
            if bracket >= 0:
                host = str_substr(rest, 1, bracket);
                if bracket + 1 < str_byte_len(rest):
                    port_str = str_substr(rest, bracket + 2, str_byte_len(rest));
                    port = Some(str_to_int(port_str));
                end
            end
        else
            colon2 = str_find(rest, str_new(":"));
            if colon2 >= 0:
                host = str_substr(rest, 0, colon2);
                port_str = str_substr(rest, colon2 + 1, str_byte_len(rest));
                port = Some(str_to_int(port_str));
            end
        end
    end

    out Ok(Url {
        scheme = scheme, username = username, password = password,
        host = host, port = port, path = path,
        query = query, fragment = fragment
    });
end

# ═══════════════════════════════════════════════════════
# Formatting
# ═══════════════════════════════════════════════════════

## Convert URL back to string.
func url_to_string:
    in(u: Url)
    s = str_concat(u.scheme, str_new("://"));

    if is_some(u.username):
        s = str_concat(s, unwrap(u.username));
        if is_some(u.password):
            s = str_concat(s, str_concat(str_new(":"), unwrap(u.password)));
        end
        s = str_concat(s, str_new("@"));
    end

    s = str_concat(s, u.host);

    if is_some(u.port):
        s = str_concat(s, str_concat(str_new(":"), i64_to_str(unwrap(u.port))));
    end

    s = str_concat(s, u.path);

    if is_some(u.query):
        s = str_concat(s, str_concat(str_new("?"), unwrap(u.query)));
    end

    if is_some(u.fragment):
        s = str_concat(s, str_concat(str_new("#"), unwrap(u.fragment)));
    end

    out s;
end

# ═══════════════════════════════════════════════════════
# Query String
# ═══════════════════════════════════════════════════════

## Parse query string "key1=val1&key2=val2" into pairs.
func url_query_parse:
    in(query: string)
    params = vec_new<QueryParam>();
    qlen = str_byte_len(query);
    start = 0;
    i = 0;
    when i <= qlen loop
        if i == qlen | native_load_u8(ptr_add(str_ptr(query), i)) == 0x26:  # '&'
            segment = str_substr(query, start, i);
            eq_pos = str_find(segment, str_new("="));
            if eq_pos >= 0:
                key = url_decode(str_substr(segment, 0, eq_pos));
                val = url_decode(str_substr(segment, eq_pos + 1, str_byte_len(segment)));
                vec_push<QueryParam>(&params, QueryParam { key = key, value = val });
            end
            start = i + 1;
        end
        i = i + 1;
    end
    out params;
end

## Build query string from parameters.
func url_query_build:
    in(params: Vec<QueryParam>)
    s = str_new("");
    i = 0;
    when i < vec_len<QueryParam>(params) loop
        p = vec_get<QueryParam>(params, i);
        if i > 0 s = str_concat(s, str_new("&")) end:
        s = str_concat(s, str_concat(url_encode(p.key),
            str_concat(str_new("="), url_encode(p.value))));
        i = i + 1;
    end
    out s;
end

# ═══════════════════════════════════════════════════════
# URL Encoding / Decoding (percent-encoding)
# ═══════════════════════════════════════════════════════

func url_encode:
    in(s: string)
    result = str_new("");
    i = 0;
    slen = str_byte_len(s);
    when i < slen loop
        b = native_load_u8(ptr_add(str_ptr(s), i));
        if _url_is_unreserved(b):
            result = str_concat(result, str_from_bytes(&b, 1));
        else
            result = str_concat(result, str_concat(str_new("%"), _byte_to_hex(b)));
        end
        i = i + 1;
    end
    out result;
end

func url_decode:
    in(s: string)
    result = str_new("");
    i = 0;
    slen = str_byte_len(s);
    when i < slen loop
        b = native_load_u8(ptr_add(str_ptr(s), i));
        if b == 0x25 & i + 2 < slen:  # '%'
            hi = _hex_digit(native_load_u8(ptr_add(str_ptr(s), i + 1)));
            lo = _hex_digit(native_load_u8(ptr_add(str_ptr(s), i + 2)));
            decoded = (hi << 4) | lo;
            result = str_concat(result, str_from_bytes(&decoded, 1));
            i = i + 3;
        elif b == 0x2B:  # '+' → space
            result = str_concat(result, str_new(" "));
            i = i + 1;
        else
            result = str_concat(result, str_from_bytes(&b, 1));
            i = i + 1;
        end
    end
    out result;
end

func _url_is_unreserved:
    in(b: int)
    # A-Z, a-z, 0-9, '-', '.', '_', '~'
    if b >= 0x41 & b <= 0x5A out true end:   # A-Z
    if b >= 0x61 & b <= 0x7A out true end:   # a-z
    if b >= 0x30 & b <= 0x39 out true end:   # 0-9
    if b == 0x2D | b == 0x2E | b == 0x5F | b == 0x7E out true end:
    out false;
end

func _byte_to_hex:
    in(b: int)
    hex = str_new("0123456789ABCDEF");
    hi = native_load_u8(ptr_add(str_ptr(hex), (b >> 4) & 0x0F));
    lo = native_load_u8(ptr_add(str_ptr(hex), b & 0x0F));
    var buf: [int; 2];
    buf[0] = hi;
    buf[1] = lo;
    out str_from_bytes(&buf, 2);
end

func _hex_digit:
    in(ch: int)
    if ch >= 0x30 & ch <= 0x39 out ch - 0x30 end:    # 0-9
    if ch >= 0x41 & ch <= 0x46 out ch - 0x41 + 10 end: # A-F
    if ch >= 0x61 & ch <= 0x66 out ch - 0x61 + 10 end: # a-f
    out 0;
end

# ═══════════════════════════════════════════════════════
# URL Helpers
# ═══════════════════════════════════════════════════════

## Get the default port for a scheme.
func url_default_port:
    in(scheme: string)
    if str_eq(scheme, str_new("http"))  out 80   end:
    if str_eq(scheme, str_new("https")) out 443  end:
    if str_eq(scheme, str_new("ftp"))   out 21   end:
    if str_eq(scheme, str_new("ssh"))   out 22   end:
    if str_eq(scheme, str_new("mqtt"))  out 1883 end:
    if str_eq(scheme, str_new("ws"))    out 80   end:
    if str_eq(scheme, str_new("wss"))   out 443  end:
    out 0;
end

## Get effective port (explicit or default for scheme).
func url_effective_port:
    in(u: Url)
    if is_some(u.port) out unwrap(u.port) end:
    out url_default_port(u.scheme);
end

## Join a relative path onto a URL.
func url_join:
    in(base: Url; relative: string)
    if str_byte_len(relative) > 0:
        b0 = native_load_u8(str_ptr(relative));
        if b0 == 0x2F:  # starts with '/'
            base.path = relative;
        else
            base.path = str_concat(base.path, str_concat(str_new("/"), relative));
        end
    end
    base.query = None;
    base.fragment = None;
    out base;
end
