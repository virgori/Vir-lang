##
 * vir/pattern/string.vri -- Minimal Production String Helpers
 * ==========================================================
 * Pattern matching operates on native NUL-terminated strings directly.
 * Keeping this slice small avoids pulling literal-only and legacy string
 * primitives into standalone Virgex/Regex binaries.
 ##

include types
include alloc

func str_byte_len(s: string) -> int:
    var n = 0
    when native_read_u8(s as int, n) != 0 loop
        n = n + 1
    end
    out n
end.

func str_byte_at(s: string, index: int) -> int:
    if index < 0 || index >= str_byte_len(s) do
        out 0
    end
    out native_read_u8(s as int, index)
end.

func str_eq(a: string, b: string) -> bool:
    let a_len = str_byte_len(a)
    let b_len = str_byte_len(b)
    if a_len != b_len do
        out false
    end
    var i = 0
    when i < a_len loop
        if native_read_u8(a as int, i) != native_read_u8(b as int, i) do
            out false
        end
        i = i + 1
    end
    out true
end.

func str_slice_bytes(s: string, from: int, to: int) -> string:
    let s_len = str_byte_len(s)
    if from < 0 || to < from || to > s_len do
        out ""
    end
    let n = to - from
    if n == 0 do
        out ""
    end
    let data = vir_alloc(n + 1)
    var i = 0
    when i < n loop
        let _w = native_write_u8(data, i, native_read_u8(s as int, from + i))
        i = i + 1
    end
    let _z = native_write_u8(data, n, 0)
    out data as string
end.

func str_concat(a: string, b: string) -> string:
    let a_len = str_byte_len(a)
    let b_len = str_byte_len(b)
    let n = a_len + b_len
    if n == 0 do
        out ""
    end
    let data = vir_alloc(n + 1)
    var i = 0
    when i < a_len loop
        let _wa = native_write_u8(data, i, native_read_u8(a as int, i))
        i = i + 1
    end
    var j = 0
    when j < b_len loop
        let _wb = native_write_u8(data, a_len + j, native_read_u8(b as int, j))
        j = j + 1
    end
    let _z = native_write_u8(data, n, 0)
    out data as string
end.
