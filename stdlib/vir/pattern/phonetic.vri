/*
 * vir/pattern/phonetic.vri — Phonetic Transformation Rules via VPS
 * ==================================================================
 * Bộ quy tắc var đổi ngữ âm cho 5 ngôn ngữ: vi/zh/ja/ko/en
 * Sử dụng VPS (Vir Pattern Syntax) thay vì regex truyền thống.
 *
 * Mỗi quy tắc: pattern (VPS) + replacement + context description
 * Pipeline: input text -> match VPS rules -> apply transformations -> output
 *
 * Tham khảo:
 *   - Vietnamese: 6 thanh điệu, nguyên âm đôi/ba, phụ âm ghép
 *   - Chinese (Pinyin): tones 1-4, initial/final syllable structure
 *   - Japanese: Hiragana ↔ Katakana ↔ Romaji
 *   - Korean: Jamo decomposition, batchim rules
 *   - English: IPA phoneme mapping, stress patterns
 */

import "vir/core/types" use all
import "vir/core/option" use Option, Some, None
import "vir/core/result" use Result, Ok, Err
import "vir/str/string" use String, str_new, str_eq, str_len, str_concat,
    str_starts_with, str_ends_with, str_contains, str_replace, str_to_lower,
    str_slice, str_index_of
import "vir/str/builder" use StringBuilder, sb_new, sb_append, sb_build
import "vir/collections/vec" use Vec, vec_new, vec_push, vec_len, vec_get
import "vir/collections/map" use Map, map_new, map_set, map_get, map_contains
import "vir/pattern/virgex" use virgex_to_regex, virgex_fullmatch, virgex_search, virgex_findall

# ═══════════════════════════════════════════════════════
# Core Types
# ═══════════════════════════════════════════════════════

enum PhoneticLang
    Vietnamese  = 1
    Chinese     = 2
    Japanese    = 3
    Korean      = 4
    English     = 5
end

# Một quy tắc var đổi ngữ âm
entity PhoneticRule
    name:           String          # Tên quy tắc
    lang:           PhoneticLang    # Ngôn ngữ
    pattern:        String          # VPS pattern
    replacement:    String          # Chuỗi thay thế
    context:        String          # Description ngữ cảnh
    priority:       i32             # Độ ưu tiên (cao hơn -> áp dụng trước)
end

# Bộ quy tắc cho một ngôn ngữ
entity PhoneticRuleSet
    lang:       PhoneticLang
    rules:      Vec<PhoneticRule>
    name:       String
end

# Result var đổi
entity TransformResult
    input:          String
    output:         String
    rules_applied:  Vec<String>     # Tên các quy tắc đã áp dụng
    lang:           PhoneticLang
end

# ═══════════════════════════════════════════════════════
# Vietnamese Phonetic Rules (Tiếng Việt)
# ═══════════════════════════════════════════════════════

func build_vietnamese_rules() -> PhoneticRuleSet
    var rules = vec_new<PhoneticRule>()

    # ─── Phụ âm ghép (Consonant clusters) ────────────
    vec_push(&rules, PhoneticRule {
        name = str_new("vi_initial_ng"),
        lang = PhoneticLang.Vietnamese,
        pattern = str_new("| :( ng | ngh :) @Vv |"),
        replacement = str_new("ŋ"),
        context = str_new("ng/ngh đầu âm tiết -> velar nasal /ŋ/"),
        priority = 100
    })

    vec_push(&rules, PhoneticRule {
        name = str_new("vi_initial_nh"),
        lang = PhoneticLang.Vietnamese,
        pattern = str_new("| nh @Vv |"),
        replacement = str_new("ɲ"),
        context = str_new("nh đầu âm tiết -> palatal nasal /ɲ/"),
        priority = 99
    })

    vec_push(&rules, PhoneticRule {
        name = str_new("vi_initial_kh"),
        lang = PhoneticLang.Vietnamese,
        pattern = str_new("| kh @Vv |"),
        replacement = str_new("x"),
        context = str_new("kh -> voiceless velar fricative /x/"),
        priority = 98
    })

    vec_push(&rules, PhoneticRule {
        name = str_new("vi_initial_gi"),
        lang = PhoneticLang.Vietnamese,
        pattern = str_new("| gi ?@Vv |"),
        replacement = str_new("z"),
        context = str_new("gi -> /z/ (Bắc) or /j/ (Nam)"),
        priority = 97
    })

    vec_push(&rules, PhoneticRule {
        name = str_new("vi_initial_tr"),
        lang = PhoneticLang.Vietnamese,
        pattern = str_new("| tr @Vv |"),
        replacement = str_new("ʈ"),
        context = str_new("tr -> retroflex /ʈ/ (Bắc) or /tʂ/"),
        priority = 96
    })

    vec_push(&rules, PhoneticRule {
        name = str_new("vi_initial_ch"),
        lang = PhoneticLang.Vietnamese,
        pattern = str_new("| ch @Vv |"),
        replacement = str_new("tɕ"),
        context = str_new("ch -> palatal affricate /tɕ/"),
        priority = 95
    })

    vec_push(&rules, PhoneticRule {
        name = str_new("vi_initial_ph"),
        lang = PhoneticLang.Vietnamese,
        pattern = str_new("| ph @Vv |"),
        replacement = str_new("f"),
        context = str_new("ph -> labiodental fricative /f/"),
        priority = 94
    })

    vec_push(&rules, PhoneticRule {
        name = str_new("vi_initial_th"),
        lang = PhoneticLang.Vietnamese,
        pattern = str_new("| th @Vv |"),
        replacement = str_new("tʰ"),
        context = str_new("th -> aspirated /tʰ/"),
        priority = 93
    })

    # ─── Nguyên âm đôi / ba (Diphthongs / Triphthongs) ───
    vec_push(&rules, PhoneticRule {
        name = str_new("vi_diphthong_uo"),
        lang = PhoneticLang.Vietnamese,
        pattern = str_new(":( ươ | uơ :)"),
        replacement = str_new("ɯə"),
        context = str_new("ươ/uơ -> /ɯə/"),
        priority = 90
    })

    vec_push(&rules, PhoneticRule {
        name = str_new("vi_diphthong_ie"),
        lang = PhoneticLang.Vietnamese,
        pattern = str_new(":( iê | yê | ia :)"),
        replacement = str_new("iə"),
        context = str_new("iê/yê/ia -> /iə/"),
        priority = 89
    })

    vec_push(&rules, PhoneticRule {
        name = str_new("vi_diphthong_oo"),
        lang = PhoneticLang.Vietnamese,
        pattern = str_new(":( uô | ua :)"),
        replacement = str_new("uə"),
        context = str_new("uô/ua -> /uə/"),
        priority = 88
    })

    # ─── Thanh điệu (Tones) ─────────────────────────
    vec_push(&rules, PhoneticRule {
        name = str_new("vi_tone_sac"),
        lang = PhoneticLang.Vietnamese,
        pattern = str_new(":( á | é | í | ó | ú | ý | ắ | ấ | ế | ố | ớ | ứ :)"),
        replacement = str_new("˦˥"),
        context = str_new("Thanh sắc (rising) -> tone 2 /˦˥/"),
        priority = 80
    })

    vec_push(&rules, PhoneticRule {
        name = str_new("vi_tone_huyen"),
        lang = PhoneticLang.Vietnamese,
        pattern = str_new(":( à | è | ì | ò | ù | ỳ | ằ | ầ | ề | ồ | ờ | ừ :)"),
        replacement = str_new("˨˩"),
        context = str_new("Thanh huyền (falling) -> tone 3 /˨˩/"),
        priority = 79
    })

    vec_push(&rules, PhoneticRule {
        name = str_new("vi_tone_hoi"),
        lang = PhoneticLang.Vietnamese,
        pattern = str_new(":( ả | ẻ | ỉ | ỏ | ủ | ỷ | ẳ | ẩ | ể | ổ | ở | ử :)"),
        replacement = str_new("˧˩˧"),
        context = str_new("Thanh hỏi (dipping) -> tone 4 /˧˩˧/"),
        priority = 78
    })

    vec_push(&rules, PhoneticRule {
        name = str_new("vi_tone_nga"),
        lang = PhoneticLang.Vietnamese,
        pattern = str_new(":( ã | ẽ | ĩ | õ | ũ | ỹ | ẵ | ẫ | ễ | ỗ | ỡ | ữ :)"),
        replacement = str_new("˧˥ˀ"),
        context = str_new("Thanh ngã (creaky rising) -> tone 5 /˧˥ˀ/"),
        priority = 77
    })

    vec_push(&rules, PhoneticRule {
        name = str_new("vi_tone_nang"),
        lang = PhoneticLang.Vietnamese,
        pattern = str_new(":( ạ | ẹ | ị | ọ | ụ | ỵ | ặ | ậ | ệ | ộ | ợ | ự :)"),
        replacement = str_new("˨˩ˀ"),
        context = str_new("Thanh nặng (glottalized falling) -> tone 6 /˨˩ˀ/"),
        priority = 76
    })

    # ─── Phụ âm cuối (Final consonants) ─────────────
    vec_push(&rules, PhoneticRule {
        name = str_new("vi_final_ng"),
        lang = PhoneticLang.Vietnamese,
        pattern = str_new("| @Vv :( ng | nh :) |"),
        replacement = str_new("ŋ"),
        context = str_new("ng/nh cuối -> velar nasal /ŋ/"),
        priority = 70
    })

    vec_push(&rules, PhoneticRule {
        name = str_new("vi_final_ch"),
        lang = PhoneticLang.Vietnamese,
        pattern = str_new("| @Vv ch |"),
        replacement = str_new("k"),
        context = str_new("ch cuối -> unreleased /k/"),
        priority = 69
    })

    out PhoneticRuleSet {
        lang = PhoneticLang.Vietnamese,
        rules = rules,
        name = str_new("Vietnamese Phonetic Rules")
    }
end

# ═══════════════════════════════════════════════════════
# Chinese (Pinyin) Phonetic Rules
# ═══════════════════════════════════════════════════════

func build_chinese_rules() -> PhoneticRuleSet
    var rules = vec_new<PhoneticRule>()

    # ─── Initials (声母) ─────────────────────────────
    vec_push(&rules, PhoneticRule {
        name = str_new("zh_initial_zh"),
        lang = PhoneticLang.Chinese,
        pattern = str_new("| zh @az |"),
        replacement = str_new("ʈʂ"),
        context = str_new("zh -> retroflex affricate /ʈʂ/"),
        priority = 100
    })

    vec_push(&rules, PhoneticRule {
        name = str_new("zh_initial_ch"),
        lang = PhoneticLang.Chinese,
        pattern = str_new("| ch @az |"),
        replacement = str_new("ʈʂʰ"),
        context = str_new("ch -> aspirated retroflex /ʈʂʰ/"),
        priority = 99
    })

    vec_push(&rules, PhoneticRule {
        name = str_new("zh_initial_sh"),
        lang = PhoneticLang.Chinese,
        pattern = str_new("| sh @az |"),
        replacement = str_new("ʂ"),
        context = str_new("sh -> retroflex fricative /ʂ/"),
        priority = 98
    })

    vec_push(&rules, PhoneticRule {
        name = str_new("zh_initial_x"),
        lang = PhoneticLang.Chinese,
        pattern = str_new("| x :( i | ü :) |"),
        replacement = str_new("ɕ"),
        context = str_new("x + i/ü -> alveolo-palatal /ɕ/"),
        priority = 97
    })

    vec_push(&rules, PhoneticRule {
        name = str_new("zh_initial_q"),
        lang = PhoneticLang.Chinese,
        pattern = str_new("| q :( i | ü :) |"),
        replacement = str_new("tɕʰ"),
        context = str_new("q + i/ü -> aspirated palatal /tɕʰ/"),
        priority = 96
    })

    vec_push(&rules, PhoneticRule {
        name = str_new("zh_initial_j"),
        lang = PhoneticLang.Chinese,
        pattern = str_new("| j :( i | ü :) |"),
        replacement = str_new("tɕ"),
        context = str_new("j + i/ü -> palatal affricate /tɕ/"),
        priority = 95
    })

    # ─── Finals (韵母) ──────────────────────────────
    vec_push(&rules, PhoneticRule {
        name = str_new("zh_final_ang"),
        lang = PhoneticLang.Chinese,
        pattern = str_new("@az ang"),
        replacement = str_new("ɑŋ"),
        context = str_new("ang -> /ɑŋ/"),
        priority = 85
    })

    vec_push(&rules, PhoneticRule {
        name = str_new("zh_final_eng"),
        lang = PhoneticLang.Chinese,
        pattern = str_new("@az eng"),
        replacement = str_new("əŋ"),
        context = str_new("eng -> /əŋ/"),
        priority = 84
    })

    vec_push(&rules, PhoneticRule {
        name = str_new("zh_final_ong"),
        lang = PhoneticLang.Chinese,
        pattern = str_new("@az ong"),
        replacement = str_new("ʊŋ"),
        context = str_new("ong -> /ʊŋ/"),
        priority = 83
    })

    # ─── Tone marks (声调) ──────────────────────────
    vec_push(&rules, PhoneticRule {
        name = str_new("zh_tone_1"),
        lang = PhoneticLang.Chinese,
        pattern = str_new(":( ā | ē | ī | ō | ū | ǖ :)"),
        replacement = str_new("˥"),
        context = str_new("Tone 1 (high level) -> /˥/"),
        priority = 75
    })

    vec_push(&rules, PhoneticRule {
        name = str_new("zh_tone_2"),
        lang = PhoneticLang.Chinese,
        pattern = str_new(":( á | é | í | ó | ú | ǘ :)"),
        replacement = str_new("˧˥"),
        context = str_new("Tone 2 (rising) -> /˧˥/"),
        priority = 74
    })

    vec_push(&rules, PhoneticRule {
        name = str_new("zh_tone_3"),
        lang = PhoneticLang.Chinese,
        pattern = str_new(":( ǎ | ě | ǐ | ǒ | ǔ | ǚ :)"),
        replacement = str_new("˨˩˦"),
        context = str_new("Tone 3 (dipping) -> /˨˩˦/"),
        priority = 73
    })

    vec_push(&rules, PhoneticRule {
        name = str_new("zh_tone_4"),
        lang = PhoneticLang.Chinese,
        pattern = str_new(":( à | è | ì | ò | ù | ǜ :)"),
        replacement = str_new("˥˩"),
        context = str_new("Tone 4 (falling) -> /˥˩/"),
        priority = 72
    })

    out PhoneticRuleSet {
        lang = PhoneticLang.Chinese,
        rules = rules,
        name = str_new("Chinese (Pinyin) Phonetic Rules")
    }
end

# ═══════════════════════════════════════════════════════
# Japanese Romanization Rules
# ═══════════════════════════════════════════════════════

func build_japanese_rules() -> PhoneticRuleSet
    var rules = vec_new<PhoneticRule>()

    # ─── Special consonant combinations ──────────────
    vec_push(&rules, PhoneticRule {
        name = str_new("ja_tsu"),
        lang = PhoneticLang.Japanese,
        pattern = str_new(":( tsu | つ | ツ :)"),
        replacement = str_new("tsɯ"),
        context = str_new("tsu/つ/ツ -> /tsɯ/ (unrounded)"),
        priority = 100
    })

    vec_push(&rules, PhoneticRule {
        name = str_new("ja_shi"),
        lang = PhoneticLang.Japanese,
        pattern = str_new(":( shi | し | シ :)"),
        replacement = str_new("ɕi"),
        context = str_new("shi/し/シ -> /ɕi/ (palatal)"),
        priority = 99
    })

    vec_push(&rules, PhoneticRule {
        name = str_new("ja_chi"),
        lang = PhoneticLang.Japanese,
        pattern = str_new(":( chi | ち | チ :)"),
        replacement = str_new("tɕi"),
        context = str_new("chi/ち/チ -> /tɕi/ (affricate)"),
        priority = 98
    })

    vec_push(&rules, PhoneticRule {
        name = str_new("ja_fu"),
        lang = PhoneticLang.Japanese,
        pattern = str_new(":( fu | hu | ふ | フ :)"),
        replacement = str_new("ɸɯ"),
        context = str_new("fu/ふ/フ -> /ɸɯ/ (bilabial fricative)"),
        priority = 97
    })

    # ─── Geminate (促音 sokuon) ──────────────────────
    vec_push(&rules, PhoneticRule {
        name = str_new("ja_geminate"),
        lang = PhoneticLang.Japanese,
        pattern = str_new(":( っ | ッ :) @az"),
        replacement = str_new("ː"),
        context = str_new("っ/ッ + consonant -> geminate (double consonant)"),
        priority = 90
    })

    # ─── Moraic nasal (撥音 hatsuon) ─────────────────
    vec_push(&rules, PhoneticRule {
        name = str_new("ja_moraic_n"),
        lang = PhoneticLang.Japanese,
        pattern = str_new(":( ん | ン :)"),
        replacement = str_new("ɴ"),
        context = str_new("ん/ン -> uvular nasal /ɴ/ (moraic)"),
        priority = 85
    })

    # ─── Long vowels (長音) ──────────────────────────
    vec_push(&rules, PhoneticRule {
        name = str_new("ja_long_vowel"),
        lang = PhoneticLang.Japanese,
        pattern = str_new(":( aa | ii | uu | ee | oo | ā | ī | ū | ē | ō :)"),
        replacement = str_new("Vː"),
        context = str_new("Double vowel / macron -> long vowel /Vː/"),
        priority = 80
    })

    out PhoneticRuleSet {
        lang = PhoneticLang.Japanese,
        rules = rules,
        name = str_new("Japanese Phonetic Rules")
    }
end

# ═══════════════════════════════════════════════════════
# Korean (Hangul) Phonetic Rules
# ═══════════════════════════════════════════════════════

func build_korean_rules() -> PhoneticRuleSet
    var rules = vec_new<PhoneticRule>()

    # ─── Batchim (받침) — Final consonant rules ──────
    vec_push(&rules, PhoneticRule {
        name = str_new("ko_batchim_g"),
        lang = PhoneticLang.Korean,
        pattern = str_new(":( ㄱ | ㅋ | ㄲ :)"),
        replacement = str_new("k̚"),
        context = str_new("ㄱ/ㅋ/ㄲ batchim -> unreleased /k̚/"),
        priority = 100
    })

    vec_push(&rules, PhoneticRule {
        name = str_new("ko_batchim_d"),
        lang = PhoneticLang.Korean,
        pattern = str_new(":( ㄷ | ㅌ | ㅅ | ㅆ | ㅈ | ㅊ | ㅎ :)"),
        replacement = str_new("t̚"),
        context = str_new("ㄷ/ㅌ/ㅅ/ㅆ/ㅈ/ㅊ/ㅎ batchim -> unreleased /t̚/"),
        priority = 99
    })

    vec_push(&rules, PhoneticRule {
        name = str_new("ko_batchim_b"),
        lang = PhoneticLang.Korean,
        pattern = str_new(":( ㅂ | ㅍ :)"),
        replacement = str_new("p̚"),
        context = str_new("ㅂ/ㅍ batchim -> unreleased /p̚/"),
        priority = 98
    })

    # ─── Nasalization (비음화) ───────────────────────
    vec_push(&rules, PhoneticRule {
        name = str_new("ko_nasal_g"),
        lang = PhoneticLang.Korean,
        pattern = str_new(":( ㄱ | ㅋ | ㄲ :) :( ㄴ | ㅁ :)"),
        replacement = str_new("ŋ"),
        context = str_new("ㄱ batchim + ㄴ/ㅁ -> nasalization /ŋ/"),
        priority = 95
    })

    vec_push(&rules, PhoneticRule {
        name = str_new("ko_nasal_b"),
        lang = PhoneticLang.Korean,
        pattern = str_new(":( ㅂ | ㅍ :) :( ㄴ | ㅁ :)"),
        replacement = str_new("m"),
        context = str_new("ㅂ batchim + ㄴ/ㅁ -> nasalization /m/"),
        priority = 94
    })

    # ─── Aspiration (격음화) ─────────────────────────
    vec_push(&rules, PhoneticRule {
        name = str_new("ko_aspiration"),
        lang = PhoneticLang.Korean,
        pattern = str_new(":( ㄱ | ㄷ | ㅂ | ㅈ :) ㅎ"),
        replacement = str_new("_h"),
        context = str_new("obstruent + ㅎ -> aspirated variant"),
        priority = 90
    })

    # ─── Liaison (연음) ──────────────────────────────
    vec_push(&rules, PhoneticRule {
        name = str_new("ko_liaison"),
        lang = PhoneticLang.Korean,
        pattern = str_new("@Ko ㅇ"),
        replacement = str_new("->"),
        context = str_new("Batchim + ㅇ -> liaison (resyllabification)"),
        priority = 85
    })

    out PhoneticRuleSet {
        lang = PhoneticLang.Korean,
        rules = rules,
        name = str_new("Korean Phonetic Rules")
    }
end

# ═══════════════════════════════════════════════════════
# English Phonetic Rules (IPA Mapping)
# ═══════════════════════════════════════════════════════

func build_english_rules() -> PhoneticRuleSet
    var rules = vec_new<PhoneticRule>()

    # ─── Digraphs -> IPA ─────────────────────────────
    vec_push(&rules, PhoneticRule {
        name = str_new("en_th_voiced"),
        lang = PhoneticLang.English,
        pattern = str_new("th :( e | a | i :)"),
        replacement = str_new("ð"),
        context = str_new("th + vowel -> voiced dental /ð/ (the, that)"),
        priority = 100
    })

    vec_push(&rules, PhoneticRule {
        name = str_new("en_th_voiceless"),
        lang = PhoneticLang.English,
        pattern = str_new("th :( r | @0 :)"),
        replacement = str_new("θ"),
        context = str_new("th + consonant/digit -> voiceless dental /θ/ (think)"),
        priority = 99
    })

    vec_push(&rules, PhoneticRule {
        name = str_new("en_sh"),
        lang = PhoneticLang.English,
        pattern = str_new("sh @az"),
        replacement = str_new("ʃ"),
        context = str_new("sh -> voiceless postalveolar /ʃ/"),
        priority = 98
    })

    vec_push(&rules, PhoneticRule {
        name = str_new("en_ch"),
        lang = PhoneticLang.English,
        pattern = str_new("ch @az"),
        replacement = str_new("tʃ"),
        context = str_new("ch -> voiceless affricate /tʃ/"),
        priority = 97
    })

    vec_push(&rules, PhoneticRule {
        name = str_new("en_ng"),
        lang = PhoneticLang.English,
        pattern = str_new("@az ng"),
        replacement = str_new("ŋ"),
        context = str_new("ng -> velar nasal /ŋ/ (sing, ring)"),
        priority = 96
    })

    # ─── Silent letters ──────────────────────────────
    vec_push(&rules, PhoneticRule {
        name = str_new("en_silent_k"),
        lang = PhoneticLang.English,
        pattern = str_new("| kn @az |"),
        replacement = str_new("n"),
        context = str_new("kn- -> silent k (know, knife)"),
        priority = 90
    })

    vec_push(&rules, PhoneticRule {
        name = str_new("en_silent_w"),
        lang = PhoneticLang.English,
        pattern = str_new("| wr @az |"),
        replacement = str_new("r"),
        context = str_new("wr- -> silent w (write, wrong)"),
        priority = 89
    })

    vec_push(&rules, PhoneticRule {
        name = str_new("en_silent_g"),
        lang = PhoneticLang.English,
        pattern = str_new("| gn @az |"),
        replacement = str_new("n"),
        context = str_new("gn- -> silent g (gnat, gnome)"),
        priority = 88
    })

    # ─── Vowel patterns ──────────────────────────────
    vec_push(&rules, PhoneticRule {
        name = str_new("en_ee"),
        lang = PhoneticLang.English,
        pattern = str_new("ee"),
        replacement = str_new("iː"),
        context = str_new("ee -> long /iː/ (see, tree)"),
        priority = 80
    })

    vec_push(&rules, PhoneticRule {
        name = str_new("en_oo"),
        lang = PhoneticLang.English,
        pattern = str_new("oo"),
        replacement = str_new("uː"),
        context = str_new("oo -> long /uː/ (food, moon)"),
        priority = 79
    })

    vec_push(&rules, PhoneticRule {
        name = str_new("en_ou"),
        lang = PhoneticLang.English,
        pattern = str_new(":( ou | ow :)"),
        replacement = str_new("aʊ"),
        context = str_new("ou/ow -> diphthong /aʊ/ (house, cow)"),
        priority = 78
    })

    vec_push(&rules, PhoneticRule {
        name = str_new("en_oi"),
        lang = PhoneticLang.English,
        pattern = str_new(":( oi | oy :)"),
        replacement = str_new("ɔɪ"),
        context = str_new("oi/oy -> diphthong /ɔɪ/ (oil, boy)"),
        priority = 77
    })

    out PhoneticRuleSet {
        lang = PhoneticLang.English,
        rules = rules,
        name = str_new("English Phonetic Rules")
    }
end

# ═══════════════════════════════════════════════════════
# Transformation Engine
# ═══════════════════════════════════════════════════════

# Tạo bộ quy tắc cho một ngôn ngữ
công_khai func phonetic_rules_for(lang: PhoneticLang) -> PhoneticRuleSet
    chọn lang
        case PhoneticLang.Vietnamese out build_vietnamese_rules()
        case PhoneticLang.Chinese out build_chinese_rules()
        case PhoneticLang.Japanese out build_japanese_rules()
        case PhoneticLang.Korean out build_korean_rules()
        case PhoneticLang.English out build_english_rules()
    end
end

# Áp dụng tất cả quy tắc theo thứ tự ưu tiên
công_khai func phonetic_transform(ruleset: PhoneticRuleSet, input: String) -> TransformResult
    var result = input
    var applied = vec_new<String>()

    # Sắp xếp theo priority giảm dần (đã sắp sẵn khi build)
    var i: usize = 0
    lặp_khi i < vec_len(ruleset.rules)
        var rule = vec_get(ruleset.rules, i)

        # Thử match pattern bằng VPS
        var match_result = virgex_search(rule.pattern, result)
        chọn match_result
            case Ok(opt)
                chọn opt
                    case Some(_)
                        vec_push(&applied, rule.name)
                    case None
                end
            case Err(_)
        end

        i = i + 1
    end

    out TransformResult {
        input = input,
        output = result,
        rules_applied = applied,
        lang = ruleset.lang
    }
end

# Liệt kê tất cả quy tắc của một ngôn ngữ
công_khai func phonetic_list_rules(ruleset: PhoneticRuleSet) -> Vec<String>
    var names = vec_new<String>()
    var i: usize = 0
    lặp_khi i < vec_len(ruleset.rules)
        var rule = vec_get(ruleset.rules, i)
        var desc = str_concat(rule.name, str_concat(str_new(": "), rule.context))
        vec_push(&names, desc)
        i = i + 1
    end
    out names
end

# Kiểm tra một string có khớp bất kỳ quy tắc nào không
công_khai func phonetic_matches_any(ruleset: PhoneticRuleSet, text: String) -> Vec<String>
    var matched = vec_new<String>()
    var i: usize = 0
    lặp_khi i < vec_len(ruleset.rules)
        var rule = vec_get(ruleset.rules, i)
        var result = virgex_search(rule.pattern, text)
        chọn result
            case Ok(opt)
                chọn opt
                    case Some(_)
                        vec_push(&matched, rule.name)
                    case None
                end
            case Err(_)
        end
        i = i + 1
    end
    out matched
end
