##
 * vir/pattern/pattern.vri -- Public Pattern Entity & Dual UFCS Operations
 * =====================================================================
 * Public Pattern type and uniform operations: match, find, find_all,
 * extract, extract_all, replace, replace_all, split, tokenize, iter.
 *
 * Implements Dual UFCS: both `pattern.op(text)` and `text.op(pattern)`.
 ##

include types
include option
include vec
include vir.pattern.ir
include vir.pattern.engine

# -------------------------------------------------------
# Public Pattern Entity & Iterator
# -------------------------------------------------------

entity PatternIterator:
    pattern_nfa: NfaProgram,
    text:        string,
    pos:         int
end.

entity Pattern:
    source:      string,
    engine_kind: int,      # 1 = Virgex (VPS), 2 = Regex
    nfa:         NfaProgram

    method match(text: string) -> bool:
        out nfa_fullmatch(this.nfa, text)
    end.

    method find(text: string) -> string:
        let m = nfa_search(this.nfa, text, 0)
        if is_none(m) do
            out ""
        end
        let found: Match = match_option_value(m)
        out match_text(found)
    end.

    method find_all(text: string) -> Vec<string>:
        let matches = nfa_search_all(this.nfa, text)
        let mlen = match_list_len(matches)
        var res = arr_new(mlen + 8)
        var i = 0
        when i < mlen loop
            let m: Match = match_list_get(matches, i)
            push(res, match_text(m))
            i = i + 1
        end
        out res
    end.

    method extract(text: string) -> Vec<string>:
        let m = nfa_search(this.nfa, text, 0)
        if is_none(m) do
            out arr_new(8)
        end
        let found: Match = match_option_value(m)
        out match_groups(found)
    end.

    method replace(text: string, rep: string) -> string:
        let m = nfa_search(this.nfa, text, 0)
        if is_none(m) do
            out text
        end
        let found: Match = match_option_value(m)
        let text_len = str_byte_len(text)
        let head = str_slice_bytes(text, 0, match_start(found))
        let tail = str_slice_bytes(text, match_end(found), text_len)
        out str_concat(str_concat(head, rep), tail)
    end.

    method replace_all(text: string, rep: string) -> string:
        let matches = nfa_search_all(this.nfa, text)
        let mlen = match_list_len(matches)
        if mlen == 0 do out text end
        let text_len = str_byte_len(text)
        var out_str = ""
        var last_pos = 0
        var i = 0
        when i < mlen loop
            let m: Match = match_list_get(matches, i)
            if match_start(m) > last_pos do
                out_str = str_concat(out_str, str_slice_bytes(text, last_pos, match_start(m)))
            end
            out_str = str_concat(out_str, rep)
            last_pos = match_end(m)
            i = i + 1
        end
        if last_pos < text_len do
            out_str = str_concat(out_str, str_slice_bytes(text, last_pos, text_len))
        end
        out out_str
    end.

    method split(text: string) -> Vec<string>:
        let matches = nfa_search_all(this.nfa, text)
        let mlen = match_list_len(matches)
        let text_len = str_byte_len(text)
        var parts = arr_new(mlen + 8)
        if mlen == 0 do
            push(parts, text)
            out parts
        end
        var last_pos = 0
        var i = 0
        when i < mlen loop
            let m: Match = match_list_get(matches, i)
            push(parts, str_slice_bytes(text, last_pos, match_start(m)))
            last_pos = match_end(m)
            i = i + 1
        end
        if last_pos <= text_len do
            push(parts, str_slice_bytes(text, last_pos, text_len))
        end
        out parts
    end.

    method tokenize(text: string) -> Vec<string>:
        let matches = nfa_search_all(this.nfa, text)
        let mlen = match_list_len(matches)
        let text_len = str_byte_len(text)
        var tokens = arr_new(mlen * 2 + 8)
        if mlen == 0 do
            if text_len > 0 do push(tokens, text) end
            out tokens
        end
        var last_pos = 0
        var i = 0
        when i < mlen loop
            let m: Match = match_list_get(matches, i)
            if match_start(m) > last_pos do
                push(tokens, str_slice_bytes(text, last_pos, match_start(m)))
            end
            push(tokens, match_text(m))
            last_pos = match_end(m)
            i = i + 1
        end
        if last_pos < text_len do
            push(tokens, str_slice_bytes(text, last_pos, text_len))
        end
        out tokens
    end.

    method iter(text: string) -> PatternIterator:
        out PatternIterator ( pattern_nfa: this.nfa, text: text, pos: 0 )
    end.

end.

# -------------------------------------------------------
# Free Functions for Pattern Creation & Direct Calling
# -------------------------------------------------------

func pattern_iter(pat: Pattern, text: string) -> PatternIterator:
    out PatternIterator ( pattern_nfa: pat.nfa, text: text, pos: 0 )
end.

func next(it: PatternIterator) -> Option<Match>:
    let text_len = str_byte_len(it.text)
    if it.pos > text_len do
        out Option.None
    end
    let m = nfa_search(it.pattern_nfa, it.text, it.pos)
    if is_none(m) do
        it.pos = text_len + 1
        out Option.None
    end
    let found: Match = match_option_value(m)
    it.pos = match_end(found)
    if match_end(found) == match_start(found) do
        it.pos = it.pos + 1
    end
    out Option.Some(found)
end.

func pattern_iter_next(it: PatternIterator) -> Option<Match>:
    out next(it)
end.

func pattern_match(pat: Pattern, text: string) -> bool:
    out nfa_fullmatch(pat.nfa, text)
end.

func pattern_find_match(pat: Pattern, text: string) -> Option<Match>:
    out nfa_search(pat.nfa, text, 0)
end.

func pattern_find(pat: Pattern, text: string) -> string:
    let m = nfa_search(pat.nfa, text, 0)
    if is_none(m) do
        out ""
    end
    let found: Match = match_option_value(m)
    out match_text(found)
end.

func pattern_find_all(pat: Pattern, text: string) -> Vec<string>:
    let matches = nfa_search_all(pat.nfa, text)
    let mlen = match_list_len(matches)
    var res = arr_new(mlen + 8)
    var i = 0
    when i < mlen loop
        let m: Match = match_list_get(matches, i)
        push(res, match_text(m))
        i = i + 1
    end
    out res
end.

func pattern_extract(pat: Pattern, text: string) -> Vec<string>:
    var res = arr_new(8)
    let m = nfa_search(pat.nfa, text, 0)
    if is_none(m) do
        out res
    end
    let found: Match = match_option_value(m)
    var k = 1
    when k <= match_num_groups(found) loop
        let group_text = match_group(found, k)
        push(res, group_text)
        k = k + 1
    end
    out res
end.

func pattern_extract_all(pat: Pattern, text: string) -> Vec:
    let matches = nfa_search_all(pat.nfa, text)
    let mlen = match_list_len(matches)
    var res = arr_new(mlen + 8)
    var i = 0
    when i < mlen loop
        push(res, match_groups_at(matches, i))
        i = i + 1
    end
    out res
end.

func pattern_replace(pat: Pattern, text: string, rep: string) -> string:
    let m = nfa_search(pat.nfa, text, 0)
    if is_none(m) do
        out text
    end
    let found: Match = match_option_value(m)
    let text_len = str_byte_len(text)
    let head = str_slice_bytes(text, 0, match_start(found))
    let tail = str_slice_bytes(text, match_end(found), text_len)
    out str_concat(str_concat(head, rep), tail)
end.

func pattern_replace_all(pat: Pattern, text: string, rep: string) -> string:
    let matches = nfa_search_all(pat.nfa, text)
    let mlen = match_list_len(matches)
    if mlen == 0 do
        out text
    end

    let text_len = str_byte_len(text)
    var out_str = ""
    var last_pos = 0

    var i = 0
    when i < mlen loop
        let m: Match = match_list_get(matches, i)
        if match_start(m) > last_pos do
            out_str = str_concat(out_str, str_slice_bytes(text, last_pos, match_start(m)))
        end
        out_str = str_concat(out_str, rep)
        last_pos = match_end(m)
        i = i + 1
    end

    if last_pos < text_len do
        out_str = str_concat(out_str, str_slice_bytes(text, last_pos, text_len))
    end

    out out_str
end.

func pattern_split(pat: Pattern, text: string) -> Vec<string>:
    let matches = nfa_search_all(pat.nfa, text)
    let mlen = match_list_len(matches)
    let text_len = str_byte_len(text)
    var parts = arr_new(mlen + 8)

    if mlen == 0 do
        push(parts, text)
        out parts
    end

    var last_pos = 0
    var i = 0
    when i < mlen loop
        let m: Match = match_list_get(matches, i)
        push(parts, str_slice_bytes(text, last_pos, match_start(m)))
        last_pos = match_end(m)
        i = i + 1
    end

    if last_pos <= text_len do
        push(parts, str_slice_bytes(text, last_pos, text_len))
    end

    out parts
end.

func pattern_tokenize(pat: Pattern, text: string) -> Vec<string>:
    let matches = nfa_search_all(pat.nfa, text)
    let mlen = match_list_len(matches)
    let text_len = str_byte_len(text)
    var tokens = arr_new(mlen * 2 + 8)

    if mlen == 0 do
        if text_len > 0 do
            push(tokens, text)
        end
        out tokens
    end

    var last_pos = 0
    var i = 0
    when i < mlen loop
        let m: Match = match_list_get(matches, i)
        if match_start(m) > last_pos do
            push(tokens, str_slice_bytes(text, last_pos, match_start(m)))
        end
        push(tokens, match_text(m))
        last_pos = match_end(m)
        i = i + 1
    end

    if last_pos < text_len do
        push(tokens, str_slice_bytes(text, last_pos, text_len))
    end

    out tokens
end.

# -------------------------------------------------------
# Dual UFCS String-First Calling Forms: string.op(pattern)
# -------------------------------------------------------

func match(s: string, pat: Pattern) -> bool:
    out pattern_match(pat, s)
end.

func find(s: string, pat: Pattern) -> string:
    out pattern_find(pat, s)
end.

func find_all(s: string, pat: Pattern) -> Vec<string>:
    out pattern_find_all(pat, s)
end.

func extract(s: string, pat: Pattern) -> Vec<string>:
    out pattern_extract(pat, s)
end.

func extract_all(s: string, pat: Pattern) -> Vec:
    out pattern_extract_all(pat, s)
end.

func replace(s: string, pat: Pattern, rep: string) -> string:
    out pattern_replace(pat, s, rep)
end.

func replace_all(s: string, pat: Pattern, rep: string) -> string:
    out pattern_replace_all(pat, s, rep)
end.

func split(s: string, pat: Pattern) -> Vec<string>:
    out pattern_split(pat, s)
end.

func tokenize(s: string, pat: Pattern) -> Vec<string>:
    out pattern_tokenize(pat, s)
end.

func iter(s: string, pat: Pattern) -> PatternIterator:
    out pattern_iter(pat, s)
end.
