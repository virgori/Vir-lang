##
 * vir/pattern/pattern.vri — Pattern entity + camelCase helpers
 * Public: Pattern.fullMatch, isMatch, find, findAll, extract, extractAll,
 * replace, replaceAll, split, tokenize. Namespace: pattern.iter / pattern.advance.
 ##

include types
include option
include vec
include pattern.ir
include pattern.engine
include pattern.string

entity Iterator:
    pattern_nfa: NfaProgram,
    text:        string,
    pos:         int
end.

entity Pattern:
    source:      string,
    engine_kind: int,
    nfa:         NfaProgram

    method fullMatch(text: &string) -> bool:
        out nfa_fullmatch(this.nfa, text)
    end.

    method isMatch(text: &string) -> bool:
        let m = nfa_search(this.nfa, text, 0)
        out is_none(m) == false
    end.

    method find(text: &string) -> string:
        let m = nfa_search(this.nfa, text, 0)
        if is_none(m) do
            out ""
        end
        let found: Match = match_option_value(m)
        out match_text(found)
    end.

    method findAll(text: &string) -> Vec of (string):
        let matches = nfa_search_all(this.nfa, text)
        let mlen = match_list_len(matches)
        var res = arr_new(mlen + 8)
        var i = 0
        when i < mlen loop
            let m: Match = match_list_get(matches, i)
            push(res, match_text(m))
            i = i + 1
        end
        out res
    end.

    method extract(text: &string) -> Vec of (string):
        out _patternExtract(this, text)
    end.

    method extractAll(text: &string) -> Vec:
        out _patternExtractAll(this, text)
    end.

    method replace(text: &string, rep: &string) -> string:
        out _patternReplace(this, text, rep)
    end.

    method replaceAll(text: &string, rep: &string) -> string:
        out _patternReplaceAll(this, text, rep)
    end.

    method split(text: &string) -> Vec of (string):
        out _patternSplit(this, text)
    end.

    method tokenize(text: &string) -> Vec of (string):
        out _patternTokenize(this, text)
    end.

    method iter(text: string) -> Iterator:
        out _patternIter(this, text)
    end.
end.

func _patternReplace(pat: Pattern, text: &string, rep: &string) -> string:
    let m = nfa_search(pat.nfa, text, 0)
    if is_none(m) do
        out text
    end
    let found: Match = match_option_value(m)
    let text_len = str_byte_len(text)
    let head = str_slice_bytes(text, 0, match_start(found))
    let tail = str_slice_bytes(text, match_end(found), text_len)
    out str_concat(str_concat(head, rep), tail)
end.

func _patternReplaceAll(pat: Pattern, text: &string, rep: &string) -> string:
    let matches = nfa_search_all(pat.nfa, text)
    let mlen = match_list_len(matches)
    if mlen == 0 do
        out text
    end
    let text_len = str_byte_len(text)
    var out_str = ""
    var last_pos = 0
    var i = 0
    when i < mlen loop
        let m: Match = match_list_get(matches, i)
        if match_start(m) > last_pos do
            out_str = str_concat(out_str, str_slice_bytes(text, last_pos, match_start(m)))
        end
        out_str = str_concat(out_str, rep)
        last_pos = match_end(m)
        i = i + 1
    end
    if last_pos < text_len do
        out_str = str_concat(out_str, str_slice_bytes(text, last_pos, text_len))
    end
    out out_str
end.

func _patternExtract(pat: Pattern, text: &string) -> Vec of (string):
    var res = arr_new(8)
    let m = nfa_search(pat.nfa, text, 0)
    if is_none(m) do
        out res
    end
    let found: Match = match_option_value(m)
    var k = 1
    when k <= match_num_groups(found) loop
        push(res, match_group(found, k))
        k = k + 1
    end
    out res
end.

func _patternExtractAll(pat: Pattern, text: &string) -> Vec:
    let matches = nfa_search_all(pat.nfa, text)
    let mlen = match_list_len(matches)
    var res = arr_new(mlen + 8)
    var i = 0
    when i < mlen loop
        push(res, match_groups_at(matches, i))
        i = i + 1
    end
    out res
end.

func _patternSplit(pat: Pattern, text: &string) -> Vec of (string):
    let matches = nfa_search_all(pat.nfa, text)
    let mlen = match_list_len(matches)
    let text_len = str_byte_len(text)
    var parts = arr_new(mlen + 8)
    if mlen == 0 do
        push(parts, text)
        out parts
    end
    var last_pos = 0
    var i = 0
    when i < mlen loop
        let m: Match = match_list_get(matches, i)
        push(parts, str_slice_bytes(text, last_pos, match_start(m)))
        last_pos = match_end(m)
        i = i + 1
    end
    if last_pos <= text_len do
        push(parts, str_slice_bytes(text, last_pos, text_len))
    end
    out parts
end.

func _patternTokenize(pat: Pattern, text: &string) -> Vec of (string):
    let matches = nfa_search_all(pat.nfa, text)
    let mlen = match_list_len(matches)
    let text_len = str_byte_len(text)
    var tokens = arr_new(mlen * 2 + 8)
    if mlen == 0 do
        if text_len > 0 do
            push(tokens, text)
        end
        out tokens
    end
    var last_pos = 0
    var i = 0
    when i < mlen loop
        let m: Match = match_list_get(matches, i)
        if match_start(m) > last_pos do
            push(tokens, str_slice_bytes(text, last_pos, match_start(m)))
        end
        push(tokens, match_text(m))
        last_pos = match_end(m)
        i = i + 1
    end
    if last_pos < text_len do
        push(tokens, str_slice_bytes(text, last_pos, text_len))
    end
    out tokens
end.

func _patternFindMatch(pat: Pattern, text: &string) -> Option of (Match):
    out nfa_search(pat.nfa, text, 0)
end.

func _patternIter(pat: Pattern, text: string) -> Iterator:
    out Iterator ( pattern_nfa: pat.nfa, text: text, pos: 0 )
end.

func _patternNext(it: Iterator) -> Option of (Match):
    let text_len = str_byte_len(it.text)
    if it.pos > text_len do
        out Option.None
    end
    let m = nfa_search(it.pattern_nfa, it.text, it.pos)
    if is_none(m) do
        it.pos = text_len + 1
        out Option.None
    end
    let found: Match = match_option_value(m)
    it.pos = match_end(found)
    if match_end(found) == match_start(found) do
        it.pos = it.pos + 1
    end
    out Option.Some(found)
end.

entity PatternNamespace:
    method iter(pat: Pattern, text: string) -> Iterator:
        out _patternIter(pat, text)
    end.

    method advance(it: Iterator) -> Option of (Match):
        out _patternNext(it)
    end.
end.

var pattern: PatternNamespace
