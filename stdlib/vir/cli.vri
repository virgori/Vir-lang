##
 * vir/cli.vri — Interactive CLI prompts (registry: cli.*)
 * ========================================================
 * Soft-string byte access via stdio_cstr / stdio_byte_p (one consume → ptr).
 * Do NOT call bare builtin `print`/`println` (they append `\n` per call).
 * Use `io.print` / `io.println` from stdio instead.
 ##

include types
include option
import Option, Some, None from option
include stdio
include vec
import Vec, vec_new, vec_push, vec_get, vec_len from vec
include alloc
import vir_alloc, vir_free from alloc
include string_rt
import native_write_u8, native_read_i64, native_write_i64 from string_rt
include syscall
import syscall3, SYS_IOCTL, STDIN_FD from syscall

# macOS termios ioctl (Darwin).
const CLI_TIOCGETA = 1076655123   # 0x40487413
const CLI_TIOCSETA = 2151445524   # 0x80487414
const CLI_ECHO     = 8            # 0x00000008
const CLI_TERMIOS_SIZE = 72
const CLI_LFLAG_OFF = 24


func cli_is_space(c: int) -> bool:
    if c == 32 || c == 9 || c == 13 || c == 10 do out true end
    out false
end.

func cli_lower(c: int) -> int:
    if c >= 65 & c <= 90 do out c + 32 end
    out c
end.

func cli_trim_copy(s: string) -> string:
    let p = stdio_cstr(s)
    let n = stdio_len_p(p)
    var start = 0
    var tail = n
    when start < tail & cli_is_space(stdio_byte_p(p, start)) loop
        start = start + 1
    end
    when tail > start & cli_is_space(stdio_byte_p(p, tail - 1)) loop
        tail = tail - 1
    end
    let out_len = tail - start
    let buf = vir_alloc(out_len + 1)
    var i = 0
    when i < out_len loop
        native_write_u8(buf, i, stdio_byte_p(p, start + i))
        i = i + 1
    end
    native_write_u8(buf, out_len, 0)
    out soft_str_from_cstr(buf)
end.

func cli_parse_yn(s: string):
    let t = cli_trim_copy(s)
    let p = stdio_cstr(t)
    let n = stdio_len_p(p)
    if n == 1 do
        let c = cli_lower(stdio_byte_p(p, 0))
        if c == 121 do out Option.Some(true) end
        if c == 110 do out Option.Some(false) end
    end
    if n == 3 do
        if cli_lower(stdio_byte_p(p, 0)) == 121 & cli_lower(stdio_byte_p(p, 1)) == 101 & cli_lower(stdio_byte_p(p, 2)) == 115 do
            out Option.Some(true)
        end
    end
    if n == 2 do
        if cli_lower(stdio_byte_p(p, 0)) == 110 & cli_lower(stdio_byte_p(p, 1)) == 111 do
            out Option.Some(false)
        end
    end
    out Option.None
end.

func cli_parse_index(s: string, nopts: int) -> Option of (int):
    let t = cli_trim_copy(s)
    let p = stdio_cstr(t)
    let n = stdio_len_p(p)
    if n == 0 do out Option.None end
    var
        val = 0
        i = 0
    when i < n loop
        let c = stdio_byte_p(p, i)
        if c >= 48 & c <= 57 do
            val = val * 10 + (c - 48)
        else
            out Option.None
        end
        i = i + 1
    end
    if val >= 0 & val < nopts do
        out Option.Some(val)
    end
    out Option.None
end.

func cli_print_index(i: int):
    if i == 0 do io.print("0")
    eif i == 1 do io.print("1")
    eif i == 2 do io.print("2")
    eif i == 3 do io.print("3")
    eif i == 4 do io.print("4")
    eif i == 5 do io.print("5")
    eif i == 6 do io.print("6")
    eif i == 7 do io.print("7")
    eif i == 8 do io.print("8")
    eif i == 9 do io.print("9")
    else io.print("?")
    end
end.

# Toggle stdin ECHO via Darwin TIOCGETA/TIOCSETA. No-op if ioctl fails (pipe/Linux).
func cli_stdin_echo(on: bool) -> bool:
    let buf = vir_alloc(CLI_TERMIOS_SIZE)
    let rc = syscall3(SYS_IOCTL, STDIN_FD, CLI_TIOCGETA, buf)
    if rc != 0 do
        vir_free(buf)
        out false
    end
    let lflag = native_read_i64(buf, CLI_LFLAG_OFF)
    var new_lflag = lflag
    if on do
        new_lflag = lflag bit_or CLI_ECHO
    else
        let bit = lflag bit_and CLI_ECHO
        new_lflag = lflag - bit
    end
    native_write_i64(buf, CLI_LFLAG_OFF, new_lflag)
    let rc2 = syscall3(SYS_IOCTL, STDIN_FD, CLI_TIOCSETA, buf)
    vir_free(buf)
    if rc2 != 0 do out false end
    out true
end.

entity CliNamespace:
    method ask(prompt: string) -> string:
        io.print(prompt)
        out readln()
    end.

    method confirm(prompt: string) -> bool:
        when true loop
            io.print(prompt)
            io.print(" ")
            let line = readln()
            if stdin_at_eof() do out false end
            let parsed = cli_parse_yn(line)
            case parsed
                Option.Some(v): out v
                Option.None:
                    io.println("Please answer y/yes or n/no.")
            end
        end
        out false
    end.

    method choose(prompt: string, options: Vec of (string)) -> int:
        when true loop
            io.println(prompt)
            let n = vec_len(options)
            if n <= 0 do
                io.println("(empty options)")
                out 0
            end
            var i = 0
            when i < n loop
                io.print("  ")
                cli_print_index(i)
                io.print(") ")
                io.println(vec_get(options, i))
                i = i + 1
            end
            io.print("Choice: ")
            let line = readln()
            if stdin_at_eof() do out 0 end
            let parsed = cli_parse_index(line, n)
            case parsed
                Option.Some(v): out v
                Option.None:
                    io.println("Enter a valid index.")
            end
        end
        out 0
    end.

    method password(prompt: string) -> string:
        io.print(prompt)
        let hidden = cli_stdin_echo(false)
        let s = readln()
        if hidden do
            cli_stdin_echo(true)
            io.println("")
        end
        out s
    end.

    method multi(prompt: string, options: Vec of (string)) -> Vec of (int):
        when true loop
            io.println(prompt)
            io.println("(comma-separated indices, e.g. 0,2)")
            let n = vec_len(options)
            if n <= 0 do
                io.println("(empty options)")
                out vec_new()
            end
            var i = 0
            when i < n loop
                io.print("  ")
                cli_print_index(i)
                io.print(") ")
                io.println(vec_get(options, i))
                i = i + 1
            end
            io.print("Choices: ")
            let line = readln()
            if stdin_at_eof() do out vec_new() end
            let trimmed = cli_trim_copy(line)
            let p = stdio_cstr(trimmed)
            let blen = stdio_len_p(p)
            var selected = vec_new()
            var
                j = 0
                cur = 0
                has_digit = false
                bad = false
            when j <= blen loop
                var c = 44
                if j < blen do
                    c = stdio_byte_p(p, j)
                end
                if c >= 48 & c <= 57 do
                    cur = cur * 10 + (c - 48)
                    has_digit = true
                eif c == 44 || c == 32 || j == blen do
                    if has_digit do
                        if cur >= 0 & cur < n do
                            vec_push(selected, cur)
                        else
                            bad = true
                        end
                        cur = 0
                        has_digit = false
                    end
                else
                    bad = true
                end
                j = j + 1
            end
            if bad == false & vec_len(selected) > 0 do
                out selected
            end
            io.println("Enter valid comma-separated indices.")
        end
        out vec_new()
    end.
end.

var cli: CliNamespace

func ask(prompt: string) -> string:
    out cli.ask(prompt)
end.

func confirm(prompt: string) -> bool:
    out cli.confirm(prompt)
end.

func choose(prompt: string, options: Vec of (string)) -> int:
    out cli.choose(prompt, options)
end.

func password(prompt: string) -> string:
    out cli.password(prompt)
end.

func multi(prompt: string, options: Vec of (string)) -> Vec of (int):
    out cli.multi(prompt, options)
end.

export CliNamespace, cli, ask, confirm, choose, password, multi
