##
 * vir/error/error.vri — Error Types & Handling
 * ===============================================
 * Inspired by Python: BaseException hierarchy
 * Inspired by Rust: Error trait, thiserror
 * Inspired by C23: errno.h
 *
 * Vir sử dụng Result<T,E> thay vì exception — nhưng cần hierarchy
 * error types để phân biệt loại lỗi.
 ##

include types;
include result;
import Result, Ok, Err from result;
include option;
import Option, Some, None from option;
include string;
import String, str_new, str_concat from string;

# ═══════════════════════════════════════════════════════
# Error Kinds — Các loại lỗi cơ bản
# ═══════════════════════════════════════════════════════

enum ErrorKind:
    # I/O
    NotFound        = 1;
    PermissionDenied = 2;
    AlreadyExists   = 3;
    BrokenPipe      = 4;
    WouldBlock      = 5;
    TimedOut        = 6;
    ConnectionRefused = 7;
    ConnectionReset = 8;
    Interrupted     = 9;
    
    # Parse
    InvalidInput    = 20;
    InvalidData     = 21;
    InvalidEncoding = 22;
    ParseIntError   = 23;
    ParseFloatError = 24;
    SyntaxError     = 25;
    
    # Runtime
    OutOfMemory     = 40;
    Overflow        = 41;
    DivisionByZero  = 42;
    IndexOutOfBounds = 43;
    NullPointer     = 44;
    StackOverflow   = 45;
    
    # Logic
    Unimplemented   = 60;
    Unreachable     = 61;
    AssertionFailed = 62;
    
    # Generic
    Other           = 99;
end.

# ═══════════════════════════════════════════════════════
# Error — Generic error type
# ═══════════════════════════════════════════════════════

entity Error:
    kind:    ErrorKind,
        message: string,
        source:  Option<ptr>   # chain to cause (optional);
end.

# ─── Constructors ─────────────────────────────────────

func error_new:
    in(kind:ErrorKind; msg:string)
    out Error ( kind = kind, message = msg, source = None );
end.

func error_with_source:
    in(kind:ErrorKind; msg:string; src:Error)
    # Chuỗi lỗi: error này gây ra bởi src.
    src_ptr = native_box(src)   # heap-allocate cause;
    out Error ( kind = kind, message = msg, source = Some(src_ptr) );
end.

# ─── Access ───────────────────────────────────────────

func error_kind:
    in(e:Error)
    out e.kind;
end.

func error_message:
    in(e:Error)
    out e.message;
end.

func error_source:
    in(e:Error)
    case e.source

        case Some(p): out Some(native_unbox<Error>(p));
        case None: out None;
    end
end.

# ─── Display ──────────────────────────────────────────

func error_to_string:
    in(e:Error)
    prefix = error_kind_name(e.kind);
    out str_concat(str_concat(prefix, str_new(": ")), e.message);
end.

func error_chain:
    in(e:Error)
    # In toàn bộ string lỗi: "kind: msg\n caused by: ..."
    s = error_to_string(e);
    cause = error_source(e);
    when is_some(cause) loop
        c = unwrap(cause);
        s = str_concat(s, str_new("\n  caused by: "));
        s = str_concat(s, error_to_string(c));
        cause = error_source(c);
    end
    out s;
end.

func error_kind_name:
    in(kind:ErrorKind)
    if kind == ErrorKind.NotFound do out str_new("NotFound"); eif kind == ErrorKind.PermissionDenied do out str_new("PermissionDenied"); eif kind == ErrorKind.AlreadyExists do out str_new("AlreadyExists"); eif kind == ErrorKind.BrokenPipe do out str_new("BrokenPipe"); eif kind == ErrorKind.InvalidInput do out str_new("InvalidInput"); eif kind == ErrorKind.InvalidData do out str_new("InvalidData"); eif kind == ErrorKind.ParseIntError do out str_new("ParseIntError"); eif kind == ErrorKind.ParseFloatError do out str_new("ParseFloatError"); eif kind == ErrorKind.SyntaxError do out str_new("SyntaxError"); eif kind == ErrorKind.OutOfMemory do out str_new("OutOfMemory"); eif kind == ErrorKind.Overflow do out str_new("Overflow"); eif kind == ErrorKind.DivisionByZero do out str_new("DivisionByZero"); eif kind == ErrorKind.IndexOutOfBounds do out str_new("IndexOutOfBounds"); eif kind == ErrorKind.NullPointer do out str_new("NullPointer"); eif kind == ErrorKind.Unimplemented do out str_new("Unimplemented"); eif kind == ErrorKind.AssertionFailed do out str_new("AssertionFailed"); else out str_new("Error"); end
end.

# ═══════════════════════════════════════════════════════
# Convenience Constructors
# ═══════════════════════════════════════════════════════

func io_error:
    in(msg:string)
    out error_new(ErrorKind.NotFound, msg);
end.

func parse_error:
    in(msg:string)
    out error_new(ErrorKind.InvalidInput, msg);
end.

func overflow_error:
    in(msg:string)
    out error_new(ErrorKind.Overflow, msg);
end.

func index_error:
    in(msg:string)
    out error_new(ErrorKind.IndexOutOfBounds, msg);
end.

func null_error:
    out error_new(ErrorKind.NullPointer, str_new("null pointer dereference"));
end.

func todo_error:
    in(msg:string)
    out error_new(ErrorKind.Unimplemented, msg);
end.

# ═══════════════════════════════════════════════════════
# IoError — Specialized cho I/O
# ═══════════════════════════════════════════════════════

entity IoError:
    kind:    ErrorKind,
        message: string,
        errno:   int           # POSIX errno;
end.

func io_error_from_errno:
    in(errno:int)
    var kind:ErrorKind;
    var msg:string;
    
    case errno

        case 2: # ENOENT
            kind = ErrorKind.NotFound;
            msg = str_new("file not found");
        case 13: # EACCES
            kind = ErrorKind.PermissionDenied;
            msg = str_new("permission denied");
        case 17: # EEXIST
            kind = ErrorKind.AlreadyExists;
            msg = str_new("already exists");
        case 12 # ENOMEM
            kind = ErrorKind.OutOfMemory;
            msg = str_new("out of memory");
        else:
            kind = ErrorKind.Other;
            msg = str_new("I/O error");
    end
    
    out IoError ( kind = kind, message = msg, errno = errno );
end.

func io_error_to_error:
    in(e:IoError)
    out error_new(e.kind, e.message);
end.

# ═══════════════════════════════════════════════════════
# Panic — Unrecoverable error
# ═══════════════════════════════════════════════════════

func panic_msg:
    in(msg:string)
    # Ghi lỗi ra stderr, dump trace, abort.
    eprintln(str_concat(str_new("PANIC: "), msg));
    native_abort();
end.

func unreachable:
    panic_msg(str_new("entered unreachable code"));
end.

func unimplemented:
    in(feature:string)
    panic_msg(str_concat(str_new("not yet implemented: "), feature));
end.

func todo:
    in(what:string)
    panic_msg(str_concat(str_new("TODO: "), what));
end.
