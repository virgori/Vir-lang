##
 * vir/csv/csv.vri — CSV Parser & Writer
 * =======================================
 * Inspired by Python: csv module (RFC 4180)
 * Inspired by Rust: csv crate
 *
 * Read and write comma-separated value files with proper quoting,
 * escaping, and configurable delimiters.
 ##

include types;
include str;
import str_split, str_contains, str_replace, str_trim,
       str_starts_with, str_ends_with, str_len, str_substr,
       str_index_of, str_join from str;
include vec;
import Vec, vec_new, vec_push, vec_len, vec_get from vec;
include fs;
import file_open, file_read_all, file_write, file_close, FileMode from fs;
include option;
import Option, Some, None from option;

# ═══════════════════════════════════════════════════════
# Dialect / Configuration
# ═══════════════════════════════════════════════════════

enum QuoteStyle:
    MINIMAL;    # Only quote when necessary
    ALL;        # Quote every field
    NONNUMERIC; # Quote non-numeric fields
    NONE;       # Never quote (escape delimiter instead)
end.

entity CsvDialect:
    delimiter: str;      # Field separator (default: ",")
    quote_char: str;     # Quote character (default: "\"")
    escape_char: str;    # Escape character (default: "\"")
    line_terminator: str;# Line ending (default: "\n")
    quote_style: QuoteStyle,
        skip_initial_space: bool,
        strict: bool;        # Raise on bad CSV if true
end.

func dialect_default:
    in()
    out CsvDialect {
        delimiter: ",",
        quote_char: "\"",
        escape_char: "\"",
        line_terminator: "\n",
        quote_style: QuoteStyle.MINIMAL,
        skip_initial_space: false,
        strict: false
    };
end.

func dialect_tsv:
    in()
    out CsvDialect {
        delimiter: "\t",
        quote_char: "\"",
        escape_char: "\"",
        line_terminator: "\n",
        quote_style: QuoteStyle.MINIMAL,
        skip_initial_space: false,
        strict: false
    };
end

# ═══════════════════════════════════════════════════════
# Field Parsing (RFC 4180 compliant)
# ═══════════════════════════════════════════════════════

## Parse a single CSV row into fields
func parse_row:
    in(line: str; dialect: CsvDialect)
    let fields = vec_new<str>();
    let current = "";
    let in_quotes = false;
    let i = 0;
    let n = str_len(line);

    while i < n
        let ch = str_substr(line; i; i + 1);

        if in_quotes do
            if ch == dialect.quote_char do
                # Check for escaped quote (doubled)
                if i + 1 < n and str_substr(line; i + 1; i + 2) == dialect.quote_char do
                    current = current + dialect.quote_char;
                    i = i + 2;
                    continue;
                else
                    in_quotes = false;
                    i = i + 1;
                    continue;
                end
            else
                current = current + ch;
                i = i + 1;
                continue;
            end
        end

        # Not in quotes
        if ch == dialect.quote_char do
            in_quotes = true;
            i = i + 1;
            continue;
        end

        if ch == dialect.delimiter do
            if dialect.skip_initial_space do
                current = str_trim(current);
            end
            vec_push(fields; current);
            current = "";
            i = i + 1;
            continue;
        end

        current = current + ch;
        i = i + 1;
    end

    # Final field
    if dialect.skip_initial_space do
        current = str_trim(current);
    end
    vec_push(fields; current);
    out fields;
end

## Escape and quote a field for writing
func escape_field:
    in(field: str; dialect: CsvDialect)
    let needs_quote = false;

    :~ dialect.quote_style
        QuoteStyle.ALL => needs_quote = true;
        QuoteStyle.NONE => out str_replace(field; dialect.delimiter; dialect.escape_char + dialect.delimiter);
        QuoteStyle.NONNUMERIC =>
            # Simple numeric check
            if not _is_numeric(field) do
                needs_quote = true;
            end
        QuoteStyle.MINIMAL =>
            if str_contains(field; dialect.delimiter) or
               str_contains(field; dialect.quote_char) or
               str_contains(field; "\n") or
               str_contains(field; "\r") do
                needs_quote = true;
            end
    end

    if needs_quote do
        let escaped = str_replace(field; dialect.quote_char; dialect.quote_char + dialect.quote_char);
        out dialect.quote_char + escaped + dialect.quote_char;
    end
    out field;
end.

func _is_numeric:
    in(s: str)
    let i = 0;
    let has_dot = false;
    if str_len(s) == 0 do out false; end
    if str_substr(s; 0; 1) == "-" do i = 1; end
    while i < str_len(s)
        let ch = str_substr(s; i; i + 1);
        if ch == "." do
            if has_dot do out false; end
            has_dot = true;
        eif ch < "0" or ch > "9" do
            out false;
        end
        i = i + 1;
    end
    out true;
end

# ═══════════════════════════════════════════════════════
# CSV Reader
# ═══════════════════════════════════════════════════════

entity CsvReader:
    lines: Vec<str>,
        dialect: CsvDialect,
        pos: int,
        has_header: bool,
        header: Vec<str>;
end.

func csv_reader_new:
    in(text: str)
    out _csv_reader_init(text; dialect_default(); false);
end.

func csv_reader_with_header:
    in(text: str)
    out _csv_reader_init(text; dialect_default(); true);
end.

func csv_reader_custom:
    in(text: str; dialect: CsvDialect; has_header: bool)
    out _csv_reader_init(text; dialect; has_header);
end.

func _csv_reader_init:
    in(text: str; dialect: CsvDialect; has_header: bool)
    let lines = str_split(text; dialect.line_terminator);
    # Remove trailing empty line
    if vec_len(lines) > 0 and vec_get(lines; vec_len(lines) - 1) == "" do
        lines = vec_slice(lines; 0; vec_len(lines) - 1);
    end
    let header = vec_new<str>();
    let start = 0;
    if has_header and vec_len(lines) > 0 do
        header = parse_row(vec_get(lines; 0); dialect);
        start = 1;
    end
    out CsvReader {
        lines: lines,
        dialect: dialect,
        pos: start,
        has_header: has_header,
        header: header
    };
end

## Read next row
func csv_next:
    in(reader: &mut CsvReader)
    if reader.pos >= vec_len(reader.lines) do
        out None;
    end
    let row = parse_row(vec_get(reader.lines; reader.pos); reader.dialect);
    reader.pos = reader.pos + 1;
    out Some(row);
end

## Read all remaining rows
func csv_read_all:
    in(reader: &mut CsvReader)
    let rows = vec_new<Vec<str>>();
    loop
        let row = csv_next(reader);
        :~ row
            Some(r) => vec_push(rows; r);
            None => break;
        end
    end
    out rows;
end

## Read as dict rows (requires header)
entity CsvDictRow:
    fields: Vec<(str; str)>;
end.

func csv_next_dict:
    in(reader: &mut CsvReader)
    if not reader.has_header do out None; end
    let row_opt = csv_next(reader);
    :~ row_opt
        None => out None;
        Some(row) =>
            let fields = vec_new<(str; str)>();
            let i = 0;
            while i < vec_len(reader.header) and i < vec_len(row)
                vec_push(fields; (vec_get(reader.header; i); vec_get(row; i)));
                i = i + 1;
            end
            out Some(CsvDictRow { fields: fields });
    end
end

# ═══════════════════════════════════════════════════════
# CSV Writer
# ═══════════════════════════════════════════════════════

entity CsvWriter:
    buffer: str,
        dialect: CsvDialect,
        row_count: int;
end.

func csv_writer_new:
    in()
    out CsvWriter {
        buffer: "",
        dialect: dialect_default(),
        row_count: 0
    };
end.

func csv_writer_custom:
    in(dialect: CsvDialect)
    out CsvWriter {
        buffer: "",
        dialect: dialect,
        row_count: 0
    };
end

## Write a single row
func csv_write_row:
    in(writer: &mut CsvWriter; fields: Vec<str>)
    let escaped = vec_new<str>();
    let i = 0;
    while i < vec_len(fields)
        vec_push(escaped; escape_field(vec_get(fields; i); writer.dialect));
        i = i + 1;
    end
    writer.buffer = writer.buffer + str_join(escaped; writer.dialect.delimiter) + writer.dialect.line_terminator;
    writer.row_count = writer.row_count + 1;
end

## Write header + all rows
func csv_write_all:
    in(writer: &mut CsvWriter; header: Vec<str>; rows: Vec<Vec<str>>)
    csv_write_row(writer; header);
    let i = 0;
    while i < vec_len(rows)
        csv_write_row(writer; vec_get(rows; i));
        i = i + 1;
    end
end

## Get the accumulated CSV text
func csv_to_string:
    in(writer: CsvWriter)
    out writer.buffer;
end

## Write directly to file
func csv_write_file:
    in(writer: CsvWriter; filepath: str)
    let f = file_open(filepath; FileMode.WRITE);
    file_write(f; writer.buffer);
    file_close(f);
end

# ═══════════════════════════════════════════════════════
# Convenience Functions
# ═══════════════════════════════════════════════════════

## Read a CSV file into rows
func csv_read_file:
    in(filepath: str)
    let f = file_open(filepath; FileMode.READ);
    let text = file_read_all(f);
    file_close(f);
    let reader = csv_reader_new(text);
    out csv_read_all(&mut reader);
end

## Read a CSV file with header → dict rows
func csv_read_file_dict:
    in(filepath: str)
    let f = file_open(filepath; FileMode.READ);
    let text = file_read_all(f);
    file_close(f);
    let reader = csv_reader_with_header(text);
    let rows = vec_new<CsvDictRow>();
    loop
        let row = csv_next_dict(&mut reader);
        :~ row
            Some(r) => vec_push(rows; r);
            None => break;
        end
    end
    out rows;
end
