##
 * vir/json/json.vri — JSON Parser & Serializer
 * ================================================
 * Inspired by Python: json
 * Tuân thủ RFC 8259 (JSON)
 *
 * Cung cấp: parse JSON -> JsonValue tree, serialize JsonValue -> String
 * Compiler use: config files, tool output, language server protocol.
 ##

include types;
include option;
import Option, Some, None from option;
include result;
import Result, Ok, Err from result;
include string;
import String, str_new, str_eq, str_byte_at, str_byte_len, str_slice_bytes, str_concat, str_from_bytes from string;
include builder;
import StringBuilder, sb_new, sb_append, sb_append_byte, sb_build from builder;
include char;
import is_digit, is_space from char;
include vec;
import Vec, vec_new, vec_push, vec_len, vec_get from vec;
include map;
import Map, string_map_new, map_insert, map_get, map_keys, map_len from map;
include format;
import format_int, format_float from format;

# ═══════════════════════════════════════════════════════
# JSON Value — Tagged Union
# ═══════════════════════════════════════════════════════

enum JsonType:
    Null    = 0;
    Bool    = 1;
    Number  = 2;
    Str     = 3;
    Array   = 4;
    Object  = 5;
    Integer = 6;
end
entity JsonValue:
    tag:     JsonType,
        bool_v:  bool,
        num_v:   float,
        int_v:   int,
        str_v:   string,
        arr_v:   Vec<JsonValue>,
        obj_v:   Map<string, JsonValue>;
end

# ─── Constructors ─────────────────────────────────────

func json_null:
    out JsonValue ( tag = JsonType.Null, bool_v = false, num_v = 0.0, int_v = 0, str_v = str_new(""), arr_v = vec_new<JsonValue>(), obj_v = string_map_new<JsonValue>() );
end
func json_bool:
    in(v:bool)
    j = json_null();
    j.tag = JsonType.Bool;
    j.bool_v = v;
    out j;
end
func json_number:
    in(v:float)
    j = json_null();
    j.tag = JsonType.Number;
    j.num_v = v;
    out j;
end
func json_int:
    in(v:int)
    j = json_null();
    j.tag = JsonType.Integer;
    j.int_v = v;
    out j;
end
func json_string:
    in(v:string)
    j = json_null();
    j.tag = JsonType.Str;
    j.str_v = v;
    out j;
end
func json_array:
    j = json_null();
    j.tag = JsonType.Array;
    out j;
end
func json_object:
    j = json_null();
    j.tag = JsonType.Object;
    out j;
end
# ─── Access ───────────────────────────────────────────

func json_is_null:
    in(j:JsonValue)
    out j.tag == JsonType.Null;
end
func json_is_bool:
    in(j:JsonValue)
    out j.tag == JsonType.Bool;
end
func json_is_number:
    in(j:JsonValue)
    out j.tag == JsonType.Number;
end
func json_is_string:
    in(j:JsonValue)
    out j.tag == JsonType.Str;
end
func json_is_array:
    in(j:JsonValue)
    out j.tag == JsonType.Array;
end
func json_is_object:
    in(j:JsonValue)
    out j.tag == JsonType.Object;
end
func json_is_integer:
    in(j:JsonValue)
    out j.tag == JsonType.Integer;
end
func json_as_bool:
    in(j:JsonValue)
    if j.tag != JsonType.Bool do out None end
    out Some(j.bool_v);
end
func json_as_number:
    in(j:JsonValue)
    if j.tag == JsonType.Integer do out Some(native_i64_to_f64(j.int_v)) end
    if j.tag != JsonType.Number do out None end
    out Some(j.num_v);
end
func json_as_int:
    in(j:JsonValue)
    if j.tag == JsonType.Integer do out Some(j.int_v) end
    if j.tag == JsonType.Number do
        as_int = native_f64_to_i64(j.num_v);
        if native_i64_to_f64(as_int) == j.num_v do out Some(as_int) end
    end
    out None;
end
func json_as_string:
    in(j:JsonValue)
    if j.tag != JsonType.Str do out None end
    out Some(j.str_v);
end
func json_as_i64:
    in(j:JsonValue)
    if j.tag != JsonType.Number do out None end
    out Some(native_f64_to_i64(j.num_v));
end
# ─── Array Operations ─────────────────────────────────

func json_array_push:
    in(j:JsonValue; val:JsonValue)
    vec_push<JsonValue>(&j.arr_v, val);
end
func json_array_get:
    in(j:JsonValue; idx:int)
    if j.tag != JsonType.Array do out None end
    if idx >= vec_len<JsonValue>(j.arr_v) do out None end
    out Some(vec_get<JsonValue>(j.arr_v, idx));
end
func json_array_len:
    in(j:JsonValue)
    if j.tag != JsonType.Array do out 0 end
    out vec_len<JsonValue>(j.arr_v);
end
# ─── Object Operations ────────────────────────────────

func json_object_set:
    in(j:JsonValue; key:string; val:JsonValue)
    map_insert<string, JsonValue>(&j.obj_v, key, val);
end
func json_object_get:
    in(j:JsonValue; key:string)
    if j.tag != JsonType.Object do out None end
    out map_get<string, JsonValue>(j.obj_v, key);
end
func json_object_has:
    in(j:JsonValue; key:string)
    out is_some(json_object_get(j, key));
end
func json_object_keys:
    in(j:JsonValue)
    if j.tag != JsonType.Object do out vec_new<String>() end
    out map_keys<string, JsonValue>(j.obj_v);
end
# ═══════════════════════════════════════════════════════
# JSON Serializer (JsonValue -> String)
# ═══════════════════════════════════════════════════════

func json_to_string:
    in(j:JsonValue)
    sb = sb_new();
    _serialize(&sb, j, 0, false);
    out sb_build(sb);
end
func json_to_string_pretty:
    in(j:JsonValue)
    sb = sb_new();
    _serialize(&sb, j, 0, true);
    out sb_build(sb);
end
func _serialize:
    in(sb:StringBuilder; j:JsonValue; depth:int; pretty:bool)
    case j.tag;
        case JsonType.Null
            sb_append(sb, str_new("null"));
        
        case JsonType.Bool
            if j.bool_v do
                sb_append(sb, str_new("true"));
            else
                sb_append(sb, str_new("false"));
            end
        
        case JsonType.Number
            # Nếu là integer, output không có dấu chấm
            as_int = native_f64_to_i64(j.num_v);
            if native_i64_to_f64(as_int) == j.num_v do
                sb_append(sb, format_int(as_int, 10));
            else
                sb_append(sb, format_float(j.num_v, 15));
            end
        
        case JsonType.Integer
            sb_append(sb, format_int(j.int_v, 10));
        
        case JsonType.Str
            _serialize_string(sb, j.str_v);
        
        case JsonType.Array
            sb_append_byte(sb, 0x5B)   # [;
            len = vec_len<JsonValue>(j.arr_v);
            i = 0;
            when i < len loop
                if i > 0 do sb_append_byte(sb, 0x2C) end # ,
                if pretty do
                    sb_append_byte(sb, 0x0A)   # \n;
                    _indent(sb, depth + 1);
                end
                _serialize(sb, vec_get<JsonValue>(j.arr_v, i), depth + 1, pretty);
                i = i + 1;
            end
            if pretty and len > 0 do
                sb_append_byte(sb, 0x0A);
                _indent(sb, depth);
            end
            sb_append_byte(sb, 0x5D)   # ];
        
        case JsonType.Object
            sb_append_byte(sb, 0x7B)   # {;
            keys = map_keys<string, JsonValue>(j.obj_v);
            klen = vec_len<string>(keys);
            i = 0;
            when i < klen loop
                if i > 0 do sb_append_byte(sb, 0x2C) end
                if pretty do
                    sb_append_byte(sb, 0x0A);
                    _indent(sb, depth + 1);
                end
                key = vec_get<string>(keys, i);
                _serialize_string(sb, key);
                sb_append_byte(sb, 0x3A)   # 
                if pretty do sb_append_byte(sb, 0x20) end # space
                val = unwrap(map_get<string, JsonValue>(j.obj_v, key));
                _serialize(sb, val, depth + 1, pretty);
                i = i + 1;
            end
            if pretty and klen > 0 do
                sb_append_byte(sb, 0x0A);
                _indent(sb, depth);
            end
            sb_append_byte(sb, 0x7D)   # };
    end
end
func _serialize_string:
    in(sb:StringBuilder; s:string)
    sb_append_byte(sb, 0x22)   # ";
    len = str_byte_len(s);
    i = 0;
    when i < len loop
        ch = str_byte_at(s, i);
        case ch;
            case 0x22 sb_append(sb, str_new("\\\""))    # "
            case 0x5C sb_append(sb, str_new("\\\\"))    # \
            case 0x08 sb_append(sb, str_new("\\b"))     # backspace
            case 0x0C sb_append(sb, str_new("\\f"))     # form feed
            case 0x0A sb_append(sb, str_new("\\n"))     # newline
            case 0x0D sb_append(sb, str_new("\\r"))     # carriage return
            case 0x09 sb_append(sb, str_new("\\t"))     # tab
            default;
                if ch < 0x20 do
                    # Control char -> \u00xx
                    sb_append(sb, str_new("\\u00"));
                    sb_append_byte(sb, _hex_digit(ch >> 4));
                    sb_append_byte(sb, _hex_digit(ch & 0x0F));
                else
                    sb_append_byte(sb, ch);
                end
        end
        i = i + 1;
    end
    sb_append_byte(sb, 0x22)   # ";
end
func _indent:
    in(sb:StringBuilder; depth:int)
    i = 0;
    when i < depth loop
        sb_append(sb, str_new("  "))   # 2-space indent;
        i = i + 1;
    end
end
func _hex_digit:
    in(n:int)
    if n < 10 do out 0x30 + n end
    out 0x61 + n - 10;
end
# ═══════════════════════════════════════════════════════
# JSON Parser (String -> JsonValue)
# ═══════════════════════════════════════════════════════

entity JsonParser:
    src:  string,
        pos:  int,
        len:  int;
end
func json_parse:
    in(input:string)
    p = JsonParser ( src = input, pos = 0, len = str_byte_len(input) );
    _skip_ws(&p);
    result = _parse_value(&p);
    case result;
        Err(e): out Err(e);
        Ok(val):
            _skip_ws(&p);
            if p.pos < p.len do
                out Err(str_concat(str_new("unexpected trailing content at position "), format_int(p.pos, 10)));
            end
            out Ok(val);
    end
end
func _peek:
    in(p:JsonParser)
    if p.pos >= p.len do out 0 end
    out str_byte_at(p.src, p.pos);
end
func _advance:
    in(p:JsonParser)
    ch = _peek(*p);
    p.pos = p.pos + 1;
    out ch;
end
func _skip_ws:
    in(p:JsonParser)
    when p.pos < p.len loop
        ch = str_byte_at(p.src, p.pos);
        if ch == 0x20 or ch == 0x09 or ch == 0x0A or ch == 0x0D do
            p.pos = p.pos + 1;
        else
            break;
        end
    end
end
func _expect:
    in(p:JsonParser; ch:int)
    if p.pos >= p.len or str_byte_at(p.src, p.pos) != ch do
        out Err(str_concat(str_new("expected '"), str_concat(str_from_bytes(&ch, 1), str_concat(str_new("' at "), format_int(p.pos, 10)))));
    end
    p.pos = p.pos + 1;
    out Ok(void);
end
func _parse_value:
    in(p:JsonParser)
    _skip_ws(p);
    if p.pos >= p.len do out Err(str_new("unexpected end of input")) end
    
    ch = _peek(*p);
    
    case ch;
        case 0x22 out _parse_string(p)          # "
        case 0x7B out _parse_object(p)          # {
        case 0x5B out _parse_array(p)           # [
        case 0x74 out _parse_true(p)            # t
        case 0x66 out _parse_false(p)           # f
        case 0x6E out _parse_null(p)            # n
        default;
            if ch == 0x2D or is_digit(ch) do # - or 0-9 do
                out _parse_number(p);
            end
            out Err(str_concat(str_new("unexpected character at "), format_int(p.pos, 10)));
    end
end
func _parse_null:
    in(p:JsonParser)
    if p.pos + 4 > p.len do out Err(str_new("unexpected end")) end
    s = str_slice_bytes(p.src, p.pos, p.pos + 4);
    if !str_eq(s, str_new("null")) do out Err(str_new("expected 'null'")) end
    p.pos = p.pos + 4;
    out Ok(json_null());
end
func _parse_true:
    in(p:JsonParser)
    if p.pos + 4 > p.len do out Err(str_new("unexpected end")) end
    s = str_slice_bytes(p.src, p.pos, p.pos + 4);
    if !str_eq(s, str_new("true")) do out Err(str_new("expected 'true'")) end
    p.pos = p.pos + 4;
    out Ok(json_bool(true));
end
func _parse_false:
    in(p:JsonParser)
    if p.pos + 5 > p.len do out Err(str_new("unexpected end")) end
    s = str_slice_bytes(p.src, p.pos, p.pos + 5);
    if !str_eq(s, str_new("false")) do out Err(str_new("expected 'false'")) end
    p.pos = p.pos + 5;
    out Ok(json_bool(false));
end
func _parse_number:
    in(p:JsonParser)
    start = p.pos;
    
    # Optional minus
    if _peek(*p) == 0x2D p. do pos = p.pos + 1 end
    
    # Digits
    if p.pos >= p.len or !is_digit(str_byte_at(p.src, p.pos)) do
        out Err(str_new("expected digit"));
    end
    when p.pos < p.len and is_digit(str_byte_at(p.src, p.pos)) loop
        p.pos = p.pos + 1;
    end
    
    # Fraction
    is_float = false;
    if p.pos < p.len and str_byte_at(p.src, p.pos) == 0x2E do
        is_float = true;
        p.pos = p.pos + 1;
        when p.pos < p.len and is_digit(str_byte_at(p.src, p.pos)) loop
            p.pos = p.pos + 1;
        end
    end
    
    # Exponent
    if p.pos < p.len do
        ec = str_byte_at(p.src, p.pos);
        if ec == 0x65 or ec == 0x45 do # e E do
            is_float = true;
            p.pos = p.pos + 1;
            if p.pos < p.len do
                sign = str_byte_at(p.src, p.pos);
                if sign == 0x2B or sign == 0x2D p. do pos = p.pos + 1 end
            end
            when p.pos < p.len and is_digit(str_byte_at(p.src, p.pos)) loop
                p.pos = p.pos + 1;
            end
        end
    end
    
    num_str = str_slice_bytes(p.src, start, p.pos);
    if is_float do
        val = native_parse_f64(num_str.data, num_str.byte_len);
        out Ok(json_number(val));
    else
        ival = native_parse_i64(num_str.data, num_str.byte_len);
        out Ok(json_int(ival));
    end
end
func _parse_string:
    in(p:JsonParser)
    str_result = _parse_string_raw(p);
    case str_result;
        Ok(s): out Ok(json_string(s));
        Err(e): out Err(e);
    end
end
func _parse_string_raw:
    in(p:JsonParser)
    r = _expect(p, 0x22)   # opening ";
    if is_err(r) do out Err(str_new("expected '\"'")) end
    
    sb = sb_new();
    loop
        if p.pos >= p.len do out Err(str_new("unterminated string")) end
        ch = _advance(p);
        
        if ch == 0x22 do break end # closing "
        if ch == 0x5C do # backslash do
            if p.pos >= p.len do out Err(str_new("unterminated escape")) end
            esc = _advance(p);
            case esc;
                case 0x22 sb_append_byte(&sb, 0x22)   # \"
                case 0x5C sb_append_byte(&sb, 0x5C)   # \\
                case 0x2F sb_append_byte(&sb, 0x2F)   # \/
                case 0x62 sb_append_byte(&sb, 0x08)   # \b
                case 0x66 sb_append_byte(&sb, 0x0C)   # \f
                case 0x6E sb_append_byte(&sb, 0x0A)   # \n
                case 0x72 sb_append_byte(&sb, 0x0D)   # \r
                case 0x74 sb_append_byte(&sb, 0x09)   # \t
                case 0x75 # \uXXXX
                    if p.pos + 4 > p.len do out Err(str_new("truncated \\u escape")) end
                    hex = str_slice_bytes(p.src, p.pos, p.pos + 4);
                    cp = native_parse_hex(hex.data, 4);
                    p.pos = p.pos + 4;
                    # Encode as UTF-8
                    _encode_codepoint(&sb, cp);
                default;
                    out Err(str_concat(str_new("invalid escape: \\"), str_from_bytes(&esc, 1)));
            end
        else
            sb_append_byte(&sb, ch);
        end
    end
    out Ok(sb_build(sb));
end
func _encode_codepoint:
    in(sb:StringBuilder; cp:int)
    if cp <= 0x7F do
        sb_append_byte(sb, cp);
    eif cp <= 0x7FF do
        sb_append_byte(sb, 0xC0 | (cp >> 6));
        sb_append_byte(sb, 0x80 | (cp & 0x3F));
    eif cp <= 0xFFFF do
        sb_append_byte(sb, 0xE0 | (cp >> 12));
        sb_append_byte(sb, 0x80 | ((cp >> 6) & 0x3F));
        sb_append_byte(sb, 0x80 | (cp & 0x3F));
    else
        sb_append_byte(sb, 0xF0 | (cp >> 18));
        sb_append_byte(sb, 0x80 | ((cp >> 12) & 0x3F));
        sb_append_byte(sb, 0x80 | ((cp >> 6) & 0x3F));
        sb_append_byte(sb, 0x80 | (cp & 0x3F));
    end
end
func _parse_array:
    in(p:JsonParser)
    r = _expect(p, 0x5B)   # [;
    if is_err(r) do out Err(str_new("expected '['")) end
    
    arr = json_array();
    _skip_ws(p);
    
    if _peek(*p) == 0x5D do # empty array do
        p.pos = p.pos + 1;
        out Ok(arr);
    end
    
    loop
        val_result = _parse_value(p);
        case val_result;
        Err(e): out Err(e);
            case Ok(val) json_array_push(&arr, val)
        end
        
        _skip_ws(p);
        next = _peek(*p);
        if next == 0x5D do # ] do
            p.pos = p.pos + 1;
            break;
        eif next == 0x2C do # , do
            p.pos = p.pos + 1;
        else
            out Err(str_new("expected ',' or ']' in array"));
        end
    end
    
    out Ok(arr);
end
func _parse_object:
    in(p:JsonParser)
    r = _expect(p, 0x7B)   # {;
    if is_err(r) do out Err(str_new("expected '{'")) end
    
    obj = json_object();
    _skip_ws(p);
    
    if _peek(*p) == 0x7D do # empty object do
        p.pos = p.pos + 1;
        out Ok(obj);
    end
    
    loop
        _skip_ws(p);
        # Parse key (must be string)
        key_result = _parse_string_raw(p);
        var key:string;
        case key_result;
        Err(e): out Err(e);
            case Ok(k) key = k
        end
        
        # Expect 
        _skip_ws(p);
        colon = _expect(p, 0x3A);
        if is_err(colon) do out Err(str_new("expected ':' in object")) end
        
        # Parse value
        val_result = _parse_value(p);
        case val_result;
        Err(e): out Err(e);
            case Ok(val) json_object_set(&obj, key, val)
        end
        
        _skip_ws(p);
        next = _peek(*p);
        if next == 0x7D do # } do
            p.pos = p.pos + 1;
            break;
        eif next == 0x2C do
            p.pos = p.pos + 1;
        else
            out Err(str_new("expected ',' or '}' in object"));
        end
    end
    
    out Ok(obj);
end