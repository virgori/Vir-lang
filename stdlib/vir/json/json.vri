##
 * vir/json/json.vri — compatibility names for vir.data.json
 *
 * JSON values, parsing, number handling, and serialization are implemented
 * only by vir.data.json. This module preserves the older operation names.
 ##

include vir.data.json

func json_int(value: int) -> JsonValue:
    out json_number(value)
end.

func json_to_string(value: JsonValue) -> string:
    out json_stringify(value)
end.

func json_to_string_pretty(value: JsonValue) -> string:
    out json_stringify_pretty(value)
end.

func json_array_push(arr: JsonValue, value: JsonValue):
    json_arr_push(arr, value)
end.

func json_array_get(arr: JsonValue, index: int) -> Option of (JsonValue):
    out json_at_opt(arr, index)
end.

func json_array_len(arr: JsonValue) -> int:
    out json_arr_len(arr)
end.

func json_object_set(obj: JsonValue, key: string, value: JsonValue):
    json_obj_set(obj, key, value)
end.

func json_object_get(obj: JsonValue, key: string) -> Option of (JsonValue):
    out json_obj_get(obj, key)
end.

func json_object_has(obj: JsonValue, key: string) -> bool:
    out has(obj, key)
end.

export json_int, json_to_string, json_to_string_pretty, json_array_push, json_array_get, json_array_len, json_object_set, json_object_get, json_object_has
