##
 * vir/sort/sort.vri — Sorting Algorithms
 * ========================================
 * Inspired by Python: list.sort(), sorted(), bisect
 * Inspired by C: qsort
 *
 * Triển khai: Introsort (quicksort + heapsort fallback + insertion sort for small)
 * + binary search
 ##

include types
include option
import Option, Some, None from option
include vec
import Vec, vec_get, vec_set, vec_len from vec

# ═══════════════════════════════════════════════════════
# Sort API
# ═══════════════════════════════════════════════════════

func sort of (T)(v: Vec of (T), cmp: func(T, T) -> int):
    # In-place sort bằng introsort.
    n = vec_len of (T)(*v)
    if n <= 1 do out end
    max_depth = _log2(n) * 2
    _introsort of (T)(v, 0, n - 1, max_depth, cmp)
end.
func is_sorted of (T)(v: Vec of (T), cmp: func(T, T) -> int):
    n = vec_len of (T)(v)
    if n <= 1 do out true end
    i = 0
    when i < n - 1 loop
        if cmp(vec_get of (T)(v, i), vec_get of (T)(v, i + 1)) > 0 do
            out false
        end
        i = i + 1
    end
    out true
end.
# ═══════════════════════════════════════════════════════
# Binary Search
# ═══════════════════════════════════════════════════════

func binary_search of (T):
    in  v: Vec of (T)
        target: T
        cmp: func(T, T) -> int
    # Tìm index chính xác. Vec phải sorted.
    n = vec_len of (T)(v)
    if n == 0 do out None end
    
    lo = 0
    hi = n - 1
    
    when lo <= hi loop
        mid = lo + (hi - lo) / 2
        c = cmp(vec_get of (T)(v, mid), target)
        if c == 0 out Some(mid) do
        eif c < 0 lo = mid + 1 do
        else
            if mid == 0 do break end
            hi = mid - 1
        end
    end
    out None
end.
func bisect_left of (T):
    in  v: Vec of (T)
        target: T
        cmp: func(T, T) -> int
    # Tìm vị trí chèn bên trái (leftmost, Python bisect_left).
    lo = 0
    hi = vec_len of (T)(v)
    when lo < hi loop
        mid = lo + (hi - lo) / 2
        if cmp(vec_get of (T)(v, mid), target) < 0 do
            lo = mid + 1
        else
            hi = mid
        end
    end
    out lo
end.
func bisect_right of (T):
    in  v: Vec of (T)
        target: T
        cmp: func(T, T) -> int
    # Python bisect_right.
    lo = 0
    hi = vec_len of (T)(v)
    when lo < hi loop
        mid = lo + (hi - lo) / 2
        if cmp(vec_get of (T)(v, mid), target) <= 0 do
            lo = mid + 1
        else
            hi = mid
        end
    end
    out lo
end.
# ═══════════════════════════════════════════════════════
# Introsort Implementation
# ═══════════════════════════════════════════════════════

const INSERTION_THRESHOLD: 16

func _introsort of (T):
    in  v: Vec of (T)
        lo: int
        hi: int
        depth: int
        cmp: func(T, T) -> int
    if hi - lo < INSERTION_THRESHOLD do
        _insertion_sort of (T)(v, lo, hi, cmp)
        out
    end
    
    if depth == 0 do
        _heap_sort_range of (T)(v, lo, hi, cmp)
        out
    end
    
    pivot = _partition of (T)(v, lo, hi, cmp)
    if pivot > lo do
        _introsort of (T)(v, lo, pivot - 1, depth - 1, cmp)
    end
    if pivot < hi do
        _introsort of (T)(v, pivot + 1, hi, depth - 1, cmp)
    end
end.
func _insertion_sort of (T):
    in  v: Vec of (T)
        lo: int
        hi: int
        cmp: func(T, T) -> int
    i = lo + 1
    when i <= hi loop
        key = vec_get of (T)(*v, i)
        j = i
        when j > lo loop
            prev = vec_get of (T)(*v, j - 1)
            if cmp(prev, key) <= 0 do break end
            vec_set of (T)(v, j, prev)
            j = j - 1
        end
        vec_set of (T)(v, j, key)
        i = i + 1
    end
end.
func _partition of (T):
    in  v: Vec of (T)
        lo: int
        hi: int
        cmp: func(T, T) -> int
    # Median-of-three pivot selection
    mid = lo + (hi - lo) / 2
    _sort_three of (T)(v, lo, mid, hi, cmp)
    pivot = vec_get of (T)(*v, mid)
    
    # Swap pivot to hi-1
    _vec_swap of (T)(v, mid, hi - 1)
    
    i = lo
    j = hi - 1
    loop
        loop
            i = i + 1
            if cmp(vec_get of (T)(*v, i), pivot) >= 0 do break end
        end
        loop
            j = j - 1
            if j <= i or do cmp(vec_get of (T)(*v, j), pivot) <= 0 break end
        end
        if i >= j do break end
        _vec_swap of (T)(v, i, j)
    end
    
    # Put pivot back
    _vec_swap of (T)(v, i, hi - 1)
    out i
end.
func _heap_sort_range of (T):
    in  v: Vec of (T)
        lo: int
        hi: int
        cmp: func(T, T) -> int
    n = hi - lo + 1
    # Build heap
    i = n / 2
    loop
        _sift_down_range of (T)(v, lo, i, n, cmp)
        if i == 0 do break end
        i = i - 1
    end
    # Extract
    end = n - 1
    when end > 0 loop
        _vec_swap of (T)(v, lo, lo + end)
        _sift_down_range of (T)(v, lo, 0, end, cmp)
        end = end - 1
    end
end.
func _sift_down_range of (T):
    in  v: Vec of (T)
        base: int
        idx: int
        n: int
        cmp: func(T, T) -> int
    i = idx
    loop
        largest = i
        l = 2 * i + 1
        r = 2 * i + 2
        if l < n and cmp(vec_get of (T)(*v, base + l), vec_get of (T)(*v, base + largest)) > 0 do
            largest = l
        end
        if r < n and cmp(vec_get of (T)(*v, base + r), vec_get of (T)(*v, base + largest)) > 0 do
            largest = r
        end
        if largest == i do break end
        _vec_swap of (T)(v, base + i, base + largest)
        i = largest
    end
end.
# ─── Helpers ──────────────────────────────────────────

func _vec_swap of (T):
    in  v: Vec of (T)
        a: int
        b: int)
    va = vec_get of (T)(*v, a)
    vb = vec_get of (T)(*v, b)
    vec_set of (T)(v, a, vb)
    vec_set of (T)(v, b, va)
end.
func _sort_three of (T):
    in  v: Vec of (T)
        a: int
        b: int
        c: int
        cmp: func(T, T) -> int
    if cmp(vec_get of (T)(*v, a), vec_get of (T)(*v, b)) > 0 _vec_swap of (T)(v, a, b) end do
    if cmp(vec_get of (T)(*v, b), vec_get of (T)(*v, c)) > 0 _vec_swap of (T)(v, b, c) end do
    if cmp(vec_get of (T)(*v, a), vec_get of (T)(*v, b)) > 0 _vec_swap of (T)(v, a, b) end do
end.
func _log2(n: int):
    log = 0
    v = n
    when v > 1 loop
        v = v  shr  1
        log = log + 1
    end
    out log
end.
# ═══════════════════════════════════════════════════════
# Stable Sort — Merge sort (O(n log n), stable, extra O(n) space)
# ═══════════════════════════════════════════════════════

func stable_sort of (T)(v: Vec of (T), cmp: func(T, T) -> int):
    n = vec_len of (T)(*v)
    if n <= 1 do out end
    _merge_sort of (T)(v, 0, n, cmp)
end.
func _merge_sort of (T):
    in  v: Vec of (T)
        lo: int
        hi: int
        cmp: func(T, T) -> int
    len = hi - lo
    if len <= 1 do out end
    if len <= INSERTION_THRESHOLD do
        _insertion_sort of (T)(v, lo, hi - 1, cmp)
        out
    end
    mid = lo + len / 2
    _merge_sort of (T)(v, lo, mid, cmp)
    _merge_sort of (T)(v, mid, hi, cmp)
    _merge of (T)(v, lo, mid, hi, cmp)
end.
func _merge of (T):
    in  v: Vec of (T)
        lo: int
        mid: int
        hi: int
        cmp: func(T, T) -> int
    # Copy left half to temp buffer
    left_len = mid - lo
    tmp = vec_with_cap of (T)(left_len)
    i = lo
    when i < mid loop
        vec_push of (T)(&tmp, vec_get of (T)(*v, i))
        i = i + 1
    end
    # Merge back
    li = 0;   # index into tmp (left half)
    ri = mid; # index into v (right half)
    wi = lo;  # write index
    when li < left_len and ri < hi loop
        if cmp(vec_get of (T)(tmp, li), vec_get of (T)(*v, ri)) <= 0 do
            vec_set of (T)(v, wi, vec_get of (T)(tmp, li))
            li = li + 1
        else
            vec_set of (T)(v, wi, vec_get of (T)(*v, ri))
            ri = ri + 1
        end
        wi = wi + 1
    end
    # Copy remaining left elements
    when li < left_len loop
        vec_set of (T)(v, wi, vec_get of (T)(tmp, li))
        li = li + 1
        wi = wi + 1
    end
    vec_free of (T)(&tmp)
end.