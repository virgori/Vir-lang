##
 * vir/log/logging.vri — Logging Framework
 * ==========================================
 * Inspired by Python: logging module
 * Inspired by Rust: tracing/log crates
 *
 * Structured logging with levels, handlers, and formatters.
 ##

include types;
include str;
import str_fmt, str_join, str_len from str;
include time;
import time_now, time_format from time;
include fs;
import file_open, file_write, file_close, FileMode from fs;
include vec;
import Vec, vec_new, vec_push, vec_len, vec_get from vec;

# ═══════════════════════════════════════════════════════
# Log Levels
# ═══════════════════════════════════════════════════════

enum LogLevel:
    TRACE = 0;
    DEBUG = 10;
    INFO = 20;
    WARN = 30;
    ERROR = 40;
    FATAL = 50;
end.

func level_name:
    in(level: LogLevel)
    :~ level
        LogLevel.TRACE => out "TRACE";
        LogLevel.DEBUG => out "DEBUG";
        LogLevel.INFO  => out "INFO";
        LogLevel.WARN  => out "WARN";
        LogLevel.ERROR => out "ERROR";
        LogLevel.FATAL => out "FATAL";
    end
end.

func level_from_str:
    in(s: str)
    :~ s
        "TRACE" | "trace" => out LogLevel.TRACE;
        "DEBUG" | "debug" => out LogLevel.DEBUG;
        "INFO"  | "info"  => out LogLevel.INFO;
        "WARN"  | "warn"  => out LogLevel.WARN;
        "ERROR" | "error" => out LogLevel.ERROR;
        "FATAL" | "fatal" => out LogLevel.FATAL;
        _ => out LogLevel.INFO;
    end
end

# ═══════════════════════════════════════════════════════
# Log Record
# ═══════════════════════════════════════════════════════

entity LogRecord:
    level: LogLevel,
        message: str,
        logger_name: str,
        timestamp: float,
        file: str,
        line: int;
end.

func log_record_new:
    in(level: LogLevel; message: str; logger_name: str)
    out LogRecord (
        level: level,
        message: message,
        logger_name: logger_name,
        timestamp: time_now(),
        file: "",
        line: 0
    );
end

# ═══════════════════════════════════════════════════════
# Formatter
# ═══════════════════════════════════════════════════════

entity LogFormatter:
    pattern: str;   # e.g. "{time} [{level}] {name}: {message}"
    time_format: str; # e.g. "%Y-%m-%d %H:%M:%S"
end.

func formatter_new:
    in(pattern: str)
    out LogFormatter (
        pattern: pattern,
        time_format: "%Y-%m-%d %H:%M:%S"
    );
end.

func formatter_default:
    in()
    out formatter_new("{time} [{level}] {name}: {message}");
end.

func format_record:
    in(fmt: LogFormatter; record: LogRecord)
    let ts = time_format(record.timestamp; fmt.time_format);
    let result = fmt.pattern;
    result = str_replace(result; "{time}"; ts);
    result = str_replace(result; "{level}"; level_name(record.level));
    result = str_replace(result; "{name}"; record.logger_name);
    result = str_replace(result; "{message}"; record.message);
    result = str_replace(result; "{file}"; record.file);
    result = str_replace(result; "{line}"; str_fmt("{}", record.line));
    out result;
end

# ═══════════════════════════════════════════════════════
# Handler Trait & Implementations
# ═══════════════════════════════════════════════════════

trait LogHandler
    func handle(self; record: LogRecord);
    func flush(self);
    func set_level(self; level: LogLevel);
    func get_level(self) -> LogLevel;
end

## Console Handler — writes to stdout/stderr
entity ConsoleHandler:
    level: LogLevel,
        formatter: LogFormatter,
        use_stderr: bool;   # true = ERROR+ go to stderr
end.

func console_handler_new:
    in()
    out ConsoleHandler (
        level: LogLevel.DEBUG,
        formatter: formatter_default(),
        use_stderr: true
    );
end

impl LogHandler for ConsoleHandler
    func handle:
        in(self; record: LogRecord)
        if record.level < self.level do out; end
        let line = format_record(self.formatter; record);
        if self.use_stderr and record.level >= LogLevel.ERROR do
            eprint(line);
        else
            print(line);
        end
    end

    func flush:
        in(self)
        # stdout/stderr are line-buffered by default
    end

    func set_level:
        in(self; level: LogLevel)
        self.level = level;
    end

    func get_level:
        in(self)
        out self.level;
    end
end

## File Handler — writes to a log file
entity FileHandler:
    level: LogLevel,
        formatter: LogFormatter,
        filepath: str,
        max_bytes: int;     # 0 = unlimited
    backup_count: int;  # number of rotated files to keep
    current_size: int;
end.

func file_handler_new:
    in(filepath: str)
    out FileHandler (
        level: LogLevel.DEBUG,
        formatter: formatter_default(),
        filepath: filepath,
        max_bytes: 0,
        backup_count: 0,
        current_size: 0
    );
end.

func file_handler_rotating:
    in(filepath: str; max_bytes: int; backup_count: int)
    out FileHandler (
        level: LogLevel.DEBUG,
        formatter: formatter_default(),
        filepath: filepath,
        max_bytes: max_bytes,
        backup_count: backup_count,
        current_size: 0
    );
end

impl LogHandler for FileHandler
    func handle:
        in(self; record: LogRecord)
        if record.level < self.level do out; end
        let line = format_record(self.formatter; record) + "\n";

        # Check rotation
        if self.max_bytes > 0 and self.current_size + str_len(line) > self.max_bytes do
            _rotate_file(self);
        end

        let f = file_open(self.filepath; FileMode.APPEND);
        file_write(f; line);
        file_close(f);
        self.current_size = self.current_size + str_len(line);
    end

    func flush:
        in(self)
        # Each write opens/closes file, so no buffering
    end

    func set_level:
        in(self; level: LogLevel)
        self.level = level;
    end

    func get_level:
        in(self)
        out self.level;
    end
end.

func _rotate_file:
    in(handler: &mut FileHandler)
    # Rename log.3 -> log.4, log.2 -> log.3, etc.
    let i = handler.backup_count;
    while i > 0
        let src = str_fmt("{}. {}", handler.filepath, i);
        let dst = str_fmt("{}.{}", handler.filepath, i + 1);
        fs_rename(src; dst);
        i = i - 1;
    end
    fs_rename(handler.filepath; str_fmt("{}.1", handler.filepath));
    handler.current_size = 0;
end

# ═══════════════════════════════════════════════════════
# Logger
# ═══════════════════════════════════════════════════════

entity Logger:
    name: str,
        level: LogLevel,
        handlers: Vec<&dyn LogHandler>,
        propagate: bool,
        parent: Option<&Logger>;
end.

func logger_new:
    in(name: str)
    out Logger (
        name: name,
        level: LogLevel.DEBUG,
        handlers: vec_new<&dyn LogHandler>(),
        propagate: true,
        parent: None
    );
end.

func add_handler:
    in(logger: &mut Logger; handler: &dyn LogHandler)
    vec_push(logger.handlers; handler);
end.

func set_level:
    in(logger: &mut Logger; level: LogLevel)
    logger.level = level;
end

## Core log dispatch
func _log:
    in(logger: Logger; level: LogLevel; message: str)
    if level < logger.level do out; end
    let record = log_record_new(level; message; logger.name);
    let i = 0;
    while i < vec_len(logger.handlers)
        let h = vec_get(logger.handlers; i);
        h.handle(record);
        i = i + 1;
    end
    # Propagate to parent
    if logger.propagate::~ logger.parent do
            Some(p) => _log(p; level; message);
            None => pass;
        end
    end
end

## Convenience methods
func trace:
    in(logger: Logger; msg: str)
    _log(logger; LogLevel.TRACE; msg);
end.

func debug:
    in(logger: Logger; msg: str)
    _log(logger; LogLevel.DEBUG; msg);
end.

func info:
    in(logger: Logger; msg: str)
    _log(logger; LogLevel.INFO; msg);
end.

func warn:
    in(logger: Logger; msg: str)
    _log(logger; LogLevel.WARN; msg);
end.

func error:
    in(logger: Logger; msg: str)
    _log(logger; LogLevel.ERROR; msg);
end.

func fatal:
    in(logger: Logger; msg: str)
    _log(logger; LogLevel.FATAL; msg);
end

# ═══════════════════════════════════════════════════════
# Global Root Logger (quick setup)
# ═══════════════════════════════════════════════════════

let _root_logger = logger_new("root");

func get_logger:
    in(name: str)
    let lg = logger_new(name);
    lg.parent = Some(&_root_logger);
    out lg;
end.

func basic_config:
    in(level: LogLevel)
    ## Quick setup: add console handler to root, set level
    let ch = console_handler_new();
    ch.level = level;
    set_level(&mut _root_logger; level);
    add_handler(&mut _root_logger; &ch);
end.

func basic_config_file:
    in(level: LogLevel; filepath: str)
    ## Quick setup with file output
    let fh = file_handler_new(filepath);
    fh.level = level;
    let ch = console_handler_new();
    ch.level = level;
    set_level(&mut _root_logger; level);
    add_handler(&mut _root_logger; &ch);
    add_handler(&mut _root_logger; &fh);
end
