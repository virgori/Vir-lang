##
 * vir/log/structured.vri — Structured Logging (Tracing-style)
 * =============================================================
 * Inspired by Rust: tracing crate
 * Inspired by Go: slog, zap (uber)
 * Inspired by Python: structlog
 *
 * Phase C — Tier 2: Structured, leveled logging with spans.
 * Supports JSON and text output formats.
 * Thread-safe via Mutex-protected writer.
 ##

include types;
include option;
import Option, Some, None from option;
include vec;
import Vec, vec_new, vec_push, vec_get, vec_len from vec;
include map;
import Map, map_new, map_insert, map_get, map_keys, map_pairs, native_hash_str, str_eq from map;
include builder;
import StringBuilder, sb_new, sb_append, sb_append_byte, sb_append_i64, sb_append_cstr, sb_build, sb_free from builder;
include time;
import Instant, now, elapsed from time;
include thread;
import Mutex, mutex_new, mutex_lock, mutex_unlock from thread;

# ═══════════════════════════════════════════════════════
# Log Levels
# ═══════════════════════════════════════════════════════

const LOG_TRACE: 0;
const LOG_DEBUG: 1;
const LOG_INFO:  2;
const LOG_WARN:  3;
const LOG_ERROR: 4;
const LOG_FATAL: 5;

func _level_name:
    in(level: int)
    if level == LOG_TRACE out "TRACE" end:
    if level == LOG_DEBUG out "DEBUG" end:
    if level == LOG_INFO  out "INFO"  end:
    if level == LOG_WARN  out "WARN"  end:
    if level == LOG_ERROR out "ERROR" end:
    if level == LOG_FATAL out "FATAL" end:
    out "UNKNOWN";
end

# ═══════════════════════════════════════════════════════
# Log Record — a single structured log event
# ═══════════════════════════════════════════════════════

entity LogRecord:
    level:     int;
    message:   string;
    fields:    Map;        # string -> string KV pairs
    timestamp: Instant;
    span_id:   int;        # -1 if no span
end

func log_record_new:
    in(level: int; msg: string)
    out LogRecord {
        level: level,
        message: msg,
        fields: map_new(native_hash_str, str_eq),
        timestamp: now(),
        span_id: -1
    };
end

func log_record_field:
    in(rec: LogRecord; key: string; value: string)
    map_insert(rec.fields, key, value);
    out rec;
end

func log_record_field_int:
    in(rec: LogRecord; key: string; value: int)
    sb = sb_new();
    sb_append_i64(sb, value);
    val_str = sb_build(sb);
    sb_free(sb);
    map_insert(rec.fields, key, val_str);
    out rec;
end

# ═══════════════════════════════════════════════════════
# Output Format
# ═══════════════════════════════════════════════════════

const FORMAT_TEXT: 0;
const FORMAT_JSON: 1;

# ═══════════════════════════════════════════════════════
# Logger — thread-safe structured logger
# ═══════════════════════════════════════════════════════

entity Logger:
    min_level:  int;
    format:     int;        # FORMAT_TEXT or FORMAT_JSON
    mtx:        Mutex;
    start_time: Instant;
end

func logger_new:
    in(min_level: int; format: int)
    out Logger {
        min_level: min_level,
        format: format,
        mtx: mutex_new(),
        start_time: now()
    };
end

func logger_text:
    in()
    out logger_new(LOG_INFO, FORMAT_TEXT);
end

func logger_json:
    in()
    out logger_new(LOG_INFO, FORMAT_JSON);
end

func logger_set_level:
    in(log: Logger; level: int)
    log.min_level = level;
end

# ═══════════════════════════════════════════════════════
# Format record to string
# ═══════════════════════════════════════════════════════

func _format_text:
    in(log: Logger; rec: LogRecord)
    sb = sb_new();

    # Elapsed time
    sb_append_cstr(sb, "[");
    elapsed_d = elapsed(log.start_time);
    sb_append_i64(sb, elapsed_d.secs);
    sb_append_cstr(sb, "s] ");

    # Level
    sb_append(sb, _level_name(rec.level));
    sb_append_cstr(sb, " ");

    # Message
    sb_append(sb, rec.message);

    # Fields
    keys = map_keys(rec.fields);
    i = 0;
    when i < vec_len(keys) loop
        key = vec_get(keys, i);
        opt = map_get(rec.fields, key);
        if is_some(opt):
            sb_append_cstr(sb, " ");
            sb_append(sb, key);
            sb_append_cstr(sb, "=");
            sb_append(sb, unwrap(opt));
        end
        i = i + 1;
    end

    result = sb_build(sb);
    sb_free(sb);
    out result;
end

func _format_json:
    in(log: Logger; rec: LogRecord)
    sb = sb_new();

    sb_append_cstr(sb, "{\"level\":\"");
    sb_append(sb, _level_name(rec.level));
    sb_append_cstr(sb, "\",\"msg\":\"");
    sb_append(sb, rec.message);
    sb_append_cstr(sb, "\",\"elapsed_s\":");

    elapsed_d = elapsed(log.start_time);
    sb_append_i64(sb, elapsed_d.secs);

    # Fields
    keys = map_keys(rec.fields);
    i = 0;
    when i < vec_len(keys) loop
        key = vec_get(keys, i);
        opt = map_get(rec.fields, key);
        if is_some(opt):
            sb_append_cstr(sb, ",\"");
            sb_append(sb, key);
            sb_append_cstr(sb, "\":\"");
            sb_append(sb, unwrap(opt));
            sb_append_cstr(sb, "\"");
        end
        i = i + 1;
    end

    sb_append_cstr(sb, "}");
    result = sb_build(sb);
    sb_free(sb);
    out result;
end

# ═══════════════════════════════════════════════════════
# Emit — write log record (thread-safe)
# ═══════════════════════════════════════════════════════

func log_emit:
    in(log: Logger; rec: LogRecord)
    if rec.level < log.min_level out end:

    mutex_lock(log.mtx);

    if log.format == FORMAT_JSON:
        line = _format_json(log, rec);
    else:
        line = _format_text(log, rec);
    end

    println(line);

    mutex_unlock(log.mtx);
end

# ═══════════════════════════════════════════════════════
# Convenience log functions
# ═══════════════════════════════════════════════════════

func log_trace:
    in(log: Logger; msg: string)
    log_emit(log, log_record_new(LOG_TRACE, msg));
end

func log_debug:
    in(log: Logger; msg: string)
    log_emit(log, log_record_new(LOG_DEBUG, msg));
end

func log_info:
    in(log: Logger; msg: string)
    log_emit(log, log_record_new(LOG_INFO, msg));
end

func log_warn:
    in(log: Logger; msg: string)
    log_emit(log, log_record_new(LOG_WARN, msg));
end

func log_error:
    in(log: Logger; msg: string)
    log_emit(log, log_record_new(LOG_ERROR, msg));
end

func log_fatal:
    in(log: Logger; msg: string)
    log_emit(log, log_record_new(LOG_FATAL, msg));
end

# ─── Logging with fields ────────────────────────────

func log_info_f:
    in(log: Logger; msg: string; key: string; val: string)
    rec = log_record_new(LOG_INFO, msg);
    log_record_field(rec, key, val);
    log_emit(log, rec);
end

func log_error_f:
    in(log: Logger; msg: string; key: string; val: string)
    rec = log_record_new(LOG_ERROR, msg);
    log_record_field(rec, key, val);
    log_emit(log, rec);
end

# ═══════════════════════════════════════════════════════
# Span — a logical scope for grouping log events
# ═══════════════════════════════════════════════════════

entity Span:
    id:       int;
    name:     string;
    start:    Instant;
    fields:   Map;
    parent:   int;       # parent span id, -1 if root
end

var _next_span_id: int = 1;

func span_new:
    in(name: string)
    id = _next_span_id;
    _next_span_id = _next_span_id + 1;
    out Span {
        id: id,
        name: name,
        start: now(),
        fields: map_new(native_hash_str, str_eq),
        parent: -1
    };
end

func span_field:
    in(s: Span; key: string; val: string)
    map_insert(s.fields, key, val);
    out s;
end

func span_elapsed:
    in(s: Span)
    out elapsed(s.start);
end

func span_close:
    in(log: Logger; s: Span)
    rec = log_record_new(LOG_DEBUG, "span.close");
    log_record_field(rec, "span", s.name);
    d = elapsed(s.start);
    sb = sb_new();
    sb_append_i64(sb, d.secs);
    sb_append_cstr(sb, "s");
    dur_str = sb_build(sb);
    sb_free(sb);
    log_record_field(rec, "duration", dur_str);
    log_emit(log, rec);
end
