##
 * vir/yaml/yaml.vri — YAML Parser (subset)
 * ===========================================
 * Inspired by Rust: serde_yaml, yaml-rust2
 * Inspired by Python: PyYAML
 * Inspired by Go: go-yaml/yaml
 *
 * Phase C — Tier 2: YAML 1.2 core schema subset parser.
 * Supports: mappings, sequences, scalars, comments, multi-line.
 * Does not support: anchors, aliases, tags, flow collections (inline).
 ##

include types;
include option;
import Option, Some, None, is_some, is_none, unwrap from option;
include vec;
import Vec, vec_new, vec_push, vec_get, vec_set, vec_len, vec_pop from vec;
include map;
import Map, map_new, map_insert, map_get, map_keys, native_hash_str from map;
include builder;
import StringBuilder, sb_new, sb_append, sb_append_byte, sb_append_i64, sb_build, sb_free from builder;

# ═══════════════════════════════════════════════════════
# YAML Value enum
# ═══════════════════════════════════════════════════════

const YAML_NULL    = 0;
const YAML_BOOL    = 1;
const YAML_INT     = 2;
const YAML_STRING  = 3;
const YAML_SEQ     = 4;
const YAML_MAP     = 5;

entity YamlValue:
    kind:       int;
    bool_val:   bool;
    int_val:    int;
    str_val:    string;
    seq_val:    Vec;     # Vec<YamlValue>
    map_keys:   Vec;     # Vec<string> (ordered keys)
    map_vals:   Map;     # Map<string, YamlValue>
end

# ─── Constructors ───────────────────────────────────

func _str_eq:
    in(a: string; b: string)
    out a == b;
end

func yaml_null:
    in()
    out YamlValue {
        kind: YAML_NULL, bool_val: false, int_val: 0,
        str_val: "", seq_val: vec_new(),
        map_keys: vec_new(), map_vals: map_new(native_hash_str, _str_eq)
    };
end

func yaml_bool:
    in(v: bool)
    out YamlValue {
        kind: YAML_BOOL, bool_val: v, int_val: 0,
        str_val: "", seq_val: vec_new(),
        map_keys: vec_new(), map_vals: map_new(native_hash_str, _str_eq)
    };
end

func yaml_int:
    in(v: int)
    out YamlValue {
        kind: YAML_INT, bool_val: false, int_val: v,
        str_val: "", seq_val: vec_new(),
        map_keys: vec_new(), map_vals: map_new(native_hash_str, _str_eq)
    };
end

func yaml_string:
    in(v: string)
    out YamlValue {
        kind: YAML_STRING, bool_val: false, int_val: 0,
        str_val: v, seq_val: vec_new(),
        map_keys: vec_new(), map_vals: map_new(native_hash_str, _str_eq)
    };
end

func yaml_seq:
    in()
    out YamlValue {
        kind: YAML_SEQ, bool_val: false, int_val: 0,
        str_val: "", seq_val: vec_new(),
        map_keys: vec_new(), map_vals: map_new(native_hash_str, _str_eq)
    };
end

func yaml_map:
    in()
    out YamlValue {
        kind: YAML_MAP, bool_val: false, int_val: 0,
        str_val: "", seq_val: vec_new(),
        map_keys: vec_new(), map_vals: map_new(native_hash_str, _str_eq)
    };
end

# ─── Accessors ──────────────────────────────────────

func yaml_is_null:   in(v: YamlValue) out v.kind == YAML_NULL;   end
func yaml_is_bool:   in(v: YamlValue) out v.kind == YAML_BOOL;   end
func yaml_is_int:    in(v: YamlValue) out v.kind == YAML_INT;    end
func yaml_is_string: in(v: YamlValue) out v.kind == YAML_STRING; end
func yaml_is_seq:    in(v: YamlValue) out v.kind == YAML_SEQ;    end
func yaml_is_map:    in(v: YamlValue) out v.kind == YAML_MAP;    end

func yaml_get_bool:   in(v: YamlValue) out v.bool_val; end
func yaml_get_int:    in(v: YamlValue) out v.int_val;  end
func yaml_get_string: in(v: YamlValue) out v.str_val;  end

func yaml_seq_len:
    in(v: YamlValue)
    out vec_len(v.seq_val);
end

func yaml_seq_get:
    in(v: YamlValue; idx: int)
    out vec_get(v.seq_val, idx);
end

func yaml_seq_push:
    in(v: YamlValue; item: YamlValue)
    vec_push(v.seq_val, item);
end

func yaml_map_set:
    in(v: YamlValue; key: string; val: YamlValue)
    # Check if key already present
    opt = map_get(v.map_vals, key);
    if is_none(opt):
        vec_push(v.map_keys, key);
    end
    map_insert(v.map_vals, key, val);
end

func yaml_map_get:
    in(v: YamlValue; key: string)
    out map_get(v.map_vals, key);
end

func yaml_map_keys_list:
    in(v: YamlValue)
    out v.map_keys;
end

# ═══════════════════════════════════════════════════════
# Parser State
# ═══════════════════════════════════════════════════════

entity YamlParser:
    lines:     Vec;      # Vec<string>
    pos:       int;      # current line index
    num_lines: int;
end

func _yaml_parser_new:
    in(text: string)
    lines = _split_lines(text);
    out YamlParser {
        lines: lines,
        pos: 0,
        num_lines: vec_len(lines)
    };
end

# ─── Split into lines ──────────────────────────────

func _split_lines:
    in(text: string)
    lines = vec_new();
    sb = sb_new();
    i = 0;
    when i < str_len(text) loop
        ch = str_byte_at(text, i);
        if ch == 10:
            vec_push(lines, sb_build(sb));
            sb_free(sb);
            sb = sb_new();
        else:
            sb_append_byte(sb, ch);
        end
        i = i + 1;
    end
    last = sb_build(sb);
    sb_free(sb);
    if str_len(last) > 0:
        vec_push(lines, last);
    end
    out lines;
end

# ─── Indentation level ─────────────────────────────

func _indent_of:
    in(line: string)
    count = 0;
    when count < str_len(line) and str_byte_at(line, count) == 32 loop
        count = count + 1;
    end
    out count;
end

# ─── Strip leading/trailing whitespace ──────────────

func _yaml_trim:
    in(s: string)
    start = 0;
    when start < str_len(s) and str_byte_at(s, start) == 32 loop
        start = start + 1;
    end
    e = str_len(s) - 1;
    when e >= start and str_byte_at(s, e) == 32 loop
        e = e - 1;
    end
    if start > e out "" end:
    sb = sb_new();
    i = start;
    when i <= e loop
        sb_append_byte(sb, str_byte_at(s, i));
        i = i + 1;
    end
    result = sb_build(sb);
    sb_free(sb);
    out result;
end

# ─── Check line type ───────────────────────────────

func _is_comment_or_empty:
    in(line: string)
    trimmed = _yaml_trim(line);
    if str_len(trimmed) == 0 out true end:
    if str_byte_at(trimmed, 0) == 35 out true end:  # '#'
    out false;
end

func _starts_with_dash:
    in(line: string)
    trimmed = _yaml_trim(line);
    if str_len(trimmed) == 0 out false end:
    out str_byte_at(trimmed, 0) == 45;  # '-'
end

# ─── Find colon position (key: value) ──────────────

func _find_colon:
    in(line: string)
    i = 0;
    in_quotes = false;
    when i < str_len(line) loop
        ch = str_byte_at(line, i);
        if ch == 34 or ch == 39:   # " or '
            in_quotes = not in_quotes;
        end
        if ch == 58 and not in_quotes:  # ':'
            # Ensure followed by space or end-of-line
            if i + 1 >= str_len(line):
                out i;
            eif str_byte_at(line, i + 1) == 32:
                out i;
            end
        end
        i = i + 1;
    end
    out -1;
end

# ─── Extract substring ─────────────────────────────

func _yaml_substr:
    in(s: string; start: int; e: int)
    if start >= e out "" end:
    sb = sb_new();
    i = start;
    when i < e and i < str_len(s) loop
        sb_append_byte(sb, str_byte_at(s, i));
        i = i + 1;
    end
    result = sb_build(sb);
    sb_free(sb);
    out result;
end

# ─── Strip quotes from string ──────────────────────

func _yaml_unquote:
    in(s: string)
    if str_len(s) < 2 out s end:
    first = str_byte_at(s, 0);
    last = str_byte_at(s, str_len(s) - 1);
    if (first == 34 and last == 34) or (first == 39 and last == 39):
        out _yaml_substr(s, 1, str_len(s) - 1);
    end
    out s;
end

# ─── Strip inline comment ──────────────────────────

func _strip_comment:
    in(s: string)
    i = 0;
    when i < str_len(s) loop
        if str_byte_at(s, i) == 32 and i + 1 < str_len(s) and str_byte_at(s, i + 1) == 35:
            out _yaml_trim(_yaml_substr(s, 0, i));
        end
        i = i + 1;
    end
    out s;
end

# ─── Parse scalar value ────────────────────────────

func _yaml_is_digit:
    in(ch: int)
    out ch >= 48 and ch <= 57;
end

func _parse_scalar:
    in(raw: string)
    s = _yaml_trim(_strip_comment(raw));
    s = _yaml_unquote(s);

    if s == "null" or s == "~" or str_len(s) == 0:
        out yaml_null();
    end
    if s == "true" or s == "True" or s == "TRUE":
        out yaml_bool(true);
    end
    if s == "false" or s == "False" or s == "FALSE":
        out yaml_bool(false);
    end

    # Try parse integer
    is_int = true;
    start = 0;
    neg = false;
    if str_len(s) > 0 and str_byte_at(s, 0) == 45:  # '-'
        neg = true;
        start = 1;
    end
    if start >= str_len(s):
        is_int = false;
    end
    ci = start;
    when ci < str_len(s) and is_int loop
        if not _yaml_is_digit(str_byte_at(s, ci)):
            is_int = false;
        end
        ci = ci + 1;
    end

    if is_int:
        val = 0;
        di = start;
        when di < str_len(s) loop
            val = val * 10 + str_byte_at(s, di) - 48;
            di = di + 1;
        end
        if neg:
            val = 0 - val;
        end
        out yaml_int(val);
    end

    out yaml_string(s);
end

# ═══════════════════════════════════════════════════════
# Recursive parser
# ═══════════════════════════════════════════════════════

func _peek_line:
    in(p: YamlParser)
    if p.pos >= p.num_lines out None end:
    out Some(vec_get(p.lines, p.pos));
end

func _advance:
    in(p: YamlParser)
    p.pos = p.pos + 1;
end

func _skip_empty:
    in(p: YamlParser)
    when p.pos < p.num_lines loop
        line = vec_get(p.lines, p.pos);
        if not _is_comment_or_empty(line):
            out;
        end
        p.pos = p.pos + 1;
    end
end

func yaml_parse:
    in(text: string)
    p = _yaml_parser_new(text);
    out _parse_value(p, 0);
end

func _parse_value:
    in(p: YamlParser; min_indent: int)
    _skip_empty(p);
    if p.pos >= p.num_lines out yaml_null() end:

    line = vec_get(p.lines, p.pos);
    indent = _indent_of(line);

    if indent < min_indent out yaml_null() end:

    trimmed = _yaml_trim(line);

    # Sequence item?
    if str_byte_at(trimmed, 0) == 45:  # '-'
        out _parse_seq(p, indent);
    end

    # Mapping?
    colon = _find_colon(line);
    if colon >= 0:
        out _parse_map(p, indent);
    end

    # Scalar
    _advance(p);
    out _parse_scalar(trimmed);
end

func _parse_seq:
    in(p: YamlParser; base_indent: int)
    seq = yaml_seq();

    done = false;
    when not done loop
        _skip_empty(p);
        if p.pos >= p.num_lines:
            done = true;
        else:
            line = vec_get(p.lines, p.pos);
            indent = _indent_of(line);
            trimmed = _yaml_trim(line);

            if indent != base_indent or str_byte_at(trimmed, 0) != 45:
                done = true;
            else:
                # Strip the "- " prefix
                after_dash = _yaml_trim(_yaml_substr(trimmed, 1, str_len(trimmed)));

                if str_len(after_dash) == 0:
                    # Block value on next lines
                    _advance(p);
                    item = _parse_value(p, base_indent + 2);
                    yaml_seq_push(seq, item);
                else:
                    colon = _find_colon(after_dash);
                    if colon >= 0:
                        # Inline mapping under sequence
                        _advance(p);
                        mp = yaml_map();
                        key = _yaml_trim(_yaml_substr(after_dash, 0, colon));
                        val_str = _yaml_trim(_yaml_substr(after_dash, colon + 1, str_len(after_dash)));

                        if str_len(val_str) == 0:
                            val = _parse_value(p, indent + 2);
                        else:
                            val = _parse_scalar(val_str);
                        end
                        yaml_map_set(mp, key, val);

                        # Collect further keys at indent+2
                        cont = true;
                        when cont loop
                            _skip_empty(p);
                            if p.pos >= p.num_lines:
                                cont = false;
                            else:
                                nl = vec_get(p.lines, p.pos);
                                ni = _indent_of(nl);
                                if ni <= base_indent:
                                    cont = false;
                                else:
                                    nc = _find_colon(nl);
                                    if nc < 0:
                                        cont = false;
                                    else:
                                        nk = _yaml_trim(_yaml_substr(nl, ni, nc));
                                        nv_str = _yaml_trim(_yaml_substr(nl, nc + 1, str_len(nl)));
                                        _advance(p);
                                        if str_len(nv_str) == 0:
                                            nv = _parse_value(p, ni + 2);
                                        else:
                                            nv = _parse_scalar(nv_str);
                                        end
                                        yaml_map_set(mp, nk, nv);
                                    end
                                end
                            end
                        end
                        yaml_seq_push(seq, mp);
                    else:
                        # Inline scalar
                        _advance(p);
                        yaml_seq_push(seq, _parse_scalar(after_dash));
                    end
                end
            end
        end
    end
    out seq;
end

func _parse_map:
    in(p: YamlParser; base_indent: int)
    mp = yaml_map();

    done = false;
    when not done loop
        _skip_empty(p);
        if p.pos >= p.num_lines:
            done = true;
        else:
            line = vec_get(p.lines, p.pos);
            indent = _indent_of(line);

            if indent != base_indent:
                done = true;
            else:
                colon = _find_colon(line);
                if colon < 0:
                    done = true;
                else:
                    key = _yaml_trim(_yaml_substr(line, indent, colon));
                    val_str = _yaml_trim(_yaml_substr(line, colon + 1, str_len(line)));
                    val_str = _strip_comment(val_str);
                    _advance(p);

                    if str_len(val_str) > 0:
                        val = _parse_scalar(val_str);
                    else:
                        val = _parse_value(p, base_indent + 2);
                    end
                    yaml_map_set(mp, key, val);
                end
            end
        end
    end
    out mp;
end

# ═══════════════════════════════════════════════════════
# YAML Serializer (emit)
# ═══════════════════════════════════════════════════════

func yaml_emit:
    in(v: YamlValue)
    sb = sb_new();
    _emit_value(sb, v, 0);
    result = sb_build(sb);
    sb_free(sb);
    out result;
end

func _emit_indent:
    in(sb: StringBuilder; level: int)
    i = 0;
    when i < level * 2 loop
        sb_append_byte(sb, 32);
        i = i + 1;
    end
end

func _emit_value:
    in(sb: StringBuilder; v: YamlValue; level: int)
    if v.kind == YAML_NULL:
        sb_append(sb, "null\n");
    eif v.kind == YAML_BOOL:
        if v.bool_val:
            sb_append(sb, "true\n");
        else:
            sb_append(sb, "false\n");
        end
    eif v.kind == YAML_INT:
        sb_append_i64(sb, v.int_val);
        sb_append_byte(sb, 10);
    eif v.kind == YAML_STRING:
        sb_append(sb, v.str_val);
        sb_append_byte(sb, 10);
    eif v.kind == YAML_SEQ:
        sb_append_byte(sb, 10);
        i = 0;
        when i < vec_len(v.seq_val) loop
            _emit_indent(sb, level);
            sb_append(sb, "- ");
            item = vec_get(v.seq_val, i);
            if item.kind == YAML_MAP or item.kind == YAML_SEQ:
                _emit_value(sb, item, level + 1);
            else:
                _emit_value(sb, item, level);
            end
            i = i + 1;
        end
    eif v.kind == YAML_MAP:
        sb_append_byte(sb, 10);
        i = 0;
        keys = v.map_keys;
        when i < vec_len(keys) loop
            key = vec_get(keys, i);
            opt = map_get(v.map_vals, key);
            if is_some(opt):
                _emit_indent(sb, level);
                sb_append(sb, key);
                sb_append(sb, ": ");
                val = unwrap(opt);
                _emit_value(sb, val, level + 1);
            end
            i = i + 1;
        end
    end
end
