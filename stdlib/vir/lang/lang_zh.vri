module vir/lang/lang_zh

include string;
import str_new from string;

include vir/compiler/lexer;
import Lexer, TokType, register_keyword from vir/compiler/lexer;

func load_keywords(lex: Lexer)
    lex = register_keyword(lex, str_new("函数"), TokType.Func);
    lex = register_keyword(lex, str_new("变量"), TokType.Var);
    lex = register_keyword(lex, str_new("常量"), TokType.Const);
    lex = register_keyword(lex, str_new("如果"), TokType.If);
    lex = register_keyword(lex, str_new("否则"), TokType.Else);
    lex = register_keyword(lex, str_new("循环"), TokType.Loop);
    lex = register_keyword(lex, str_new("结束"), TokType.End);
    lex = register_keyword(lex, str_new("返回"), TokType.Out);
    lex = register_keyword(lex, str_new("真"), TokType.True);
    lex = register_keyword(lex, str_new("假"), TokType.False);
    lex = register_keyword(lex, str_new("空"), TokType.NoneLit);
    lex = register_keyword(lex, str_new("打印"), TokType.Print);
    lex = register_keyword(lex, str_new("输入"), TokType.Input);
    lex = register_keyword(lex, str_new("导入"), TokType.Import);
    lex = register_keyword(lex, str_new("导出"), TokType.Export);
    lex = register_keyword(lex, str_new("模块"), TokType.Module);
    lex = register_keyword(lex, str_new("包含"), TokType.Include);
    lex = register_keyword(lex, str_new("跳出"), TokType.Break);
    lex = register_keyword(lex, str_new("继续"), TokType.Skip);
    lex = register_keyword(lex, str_new("与"), TokType.And);
    lex = register_keyword(lex, str_new("或"), TokType.Or);
    lex = register_keyword(lex, str_new("非"), TokType.Not);
    out lex;
end.