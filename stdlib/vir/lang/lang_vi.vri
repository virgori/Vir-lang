module vir/lang/lang_vi

include string;
import str_new from string;

include vir/compiler/lexer;
import Lexer, TokType, register_keyword from vir/compiler/lexer;

func load_keywords(lex: Lexer):
    lex = register_keyword(lex, str_new("hàm"), TokType.Func);
    lex = register_keyword(lex, str_new("biến"), TokType.Var);
    lex = register_keyword(lex, str_new("hằng"), TokType.Const);
    lex = register_keyword(lex, str_new("nếu"), TokType.If);
    lex = register_keyword(lex, str_new("lặp"), TokType.Loop);
    lex = register_keyword(lex, str_new("hết"), TokType.End);
    lex = register_keyword(lex, str_new("nhập"), TokType.Input);
    lex = register_keyword(lex, str_new("đúng"), TokType.True);
    lex = register_keyword(lex, str_new("sai"), TokType.False);
    lex = register_keyword(lex, str_new("rỗng"), TokType.NoneLit);
    lex = register_keyword(lex, str_new("và"), TokType.And);
    lex = register_keyword(lex, str_new("hoặc"), TokType.Or);
    lex = register_keyword(lex, str_new("thoát"), TokType.Break);
    lex = register_keyword(lex, str_new("trong"), TokType.In);
    lex = register_keyword(lex, str_new("bản_ghi"), TokType.Entity);
    lex = register_keyword(lex, str_new("liệt_kê"), TokType.Enum);
    lex = register_keyword(lex, str_new("nhập_khẩu"), TokType.Import);
    lex = register_keyword(lex, str_new("từ"), TokType.From);
    lex = register_keyword(lex, str_new("mô_đun"), TokType.Module);
    lex = register_keyword(lex, str_new("xuất"), TokType.Export);
    lex = register_keyword(lex, str_new("bao_gồm"), TokType.Include);
    out lex;
end.
