module vir/lang/lang_vi

include string;
import str_new from string;

include vir/compiler/lexer;
import Lexer, TokType, register_keyword from vir/compiler/lexer;

func load_keywords(lex: Lexer)
    lex = register_keyword(lex, str_new("func"), TokType.Func);
    lex = register_keyword(lex, str_new("var"), TokType.Var);
    lex = register_keyword(lex, str_new("const"), TokType.Const);
    lex = register_keyword(lex, str_new("if"), TokType.If);
    lex = register_keyword(lex, str_new("loop"), TokType.Loop);
    lex = register_keyword(lex, str_new("end"), TokType.End);
    lex = register_keyword(lex, str_new("input"), TokType.Input);
    lex = register_keyword(lex, str_new("true"), TokType.True);
    lex = register_keyword(lex, str_new("false"), TokType.False);
    lex = register_keyword(lex, str_new("none"), TokType.NoneLit);
    lex = register_keyword(lex, str_new("and"), TokType.And);
    lex = register_keyword(lex, str_new("or"), TokType.Or);
    lex = register_keyword(lex, str_new("break"), TokType.Break);
    lex = register_keyword(lex, str_new("in"), TokType.In);
    lex = register_keyword(lex, str_new("entity"), TokType.Entity);
    lex = register_keyword(lex, str_new("enum"), TokType.Enum);
    lex = register_keyword(lex, str_new("import"), TokType.Import);
    lex = register_keyword(lex, str_new("from"), TokType.From);
    lex = register_keyword(lex, str_new("module"), TokType.Module);
    lex = register_keyword(lex, str_new("export"), TokType.Export);
    lex = register_keyword(lex, str_new("include"), TokType.Include);
    out lex;
end.
