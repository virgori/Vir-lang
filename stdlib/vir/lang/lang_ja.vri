module vir/lang/lang_ja

include string;
import str_new from string;

include vir/compiler/lexer;
import Lexer, TokType, register_keyword from vir/compiler/lexer;

func load_keywords(lex: Lexer)
    lex = register_keyword(lex, str_new("関数"), TokType.Func);
    lex = register_keyword(lex, str_new("変数"), TokType.Var);
    lex = register_keyword(lex, str_new("定数"), TokType.Const);
    lex = register_keyword(lex, str_new("もし"), TokType.If);
    lex = register_keyword(lex, str_new("そうでなければ"), TokType.Else);
    lex = register_keyword(lex, str_new("繰り返し"), TokType.Loop);
    lex = register_keyword(lex, str_new("終わり"), TokType.End);
    lex = register_keyword(lex, str_new("戻る"), TokType.Out);
    lex = register_keyword(lex, str_new("真_"), TokType.True);
    lex = register_keyword(lex, str_new("偽"), TokType.False);
    lex = register_keyword(lex, str_new("印刷"), TokType.Print);
    lex = register_keyword(lex, str_new("入力"), TokType.Input);
    lex = register_keyword(lex, str_new("読込"), TokType.Import);
    out lex;
end.