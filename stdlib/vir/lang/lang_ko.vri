module vir/lang/lang_ko

include string;
import str_new from string;

include vir/compiler/lexer;
import Lexer, TokType, register_keyword from vir/compiler/lexer;

func load_keywords(lex: Lexer)
    lex = register_keyword(lex, str_new("함수"), TokType.Func);
    lex = register_keyword(lex, str_new("변수"), TokType.Var);
    lex = register_keyword(lex, str_new("상수"), TokType.Const);
    lex = register_keyword(lex, str_new("만약"), TokType.If);
    lex = register_keyword(lex, str_new("아니면"), TokType.Else);
    lex = register_keyword(lex, str_new("반복"), TokType.Loop);
    lex = register_keyword(lex, str_new("끝"), TokType.End);
    lex = register_keyword(lex, str_new("반환"), TokType.Out);
    lex = register_keyword(lex, str_new("참"), TokType.True);
    lex = register_keyword(lex, str_new("거짓"), TokType.False);
    lex = register_keyword(lex, str_new("출력"), TokType.Print);
    lex = register_keyword(lex, str_new("입력"), TokType.Input);
    lex = register_keyword(lex, str_new("가져오기"), TokType.Import);
    out lex;
end.