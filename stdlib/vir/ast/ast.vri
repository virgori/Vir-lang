/*
 * vir/ast/ast.vri — AST Node Types for Vir Self-Hosting
 * =======================================================
 * Phase D — self-hosting compiler infrastructure
 *
 * Defines the complete AST for Vir language.
 * Used by: vir/token, vir/parser_kit, compiler frontend
 */

import "vir/core/types" use all
import "vir/core/option" use Option, Some, None
import "vir/str/string" use String
import "vir/collections/vec" use Vec, vec_new, vec_push

# ═══════════════════════════════════════════════════════
# Source Location
# ═══════════════════════════════════════════════════════

entity Span
    file:  String
    line:  u32
    col:   u32
    start: usize   # byte offset
    end:   usize
end

func span_new(file: String, line: u32, col: u32, start: usize, end: usize) -> Span
    out Span { file = file, line = line, col = col, start = start, end = end }
end

func span_merge(a: Span, b: Span) -> Span
    out Span {
        file = a.file, line = a.line, col = a.col,
        start = if a.start < b.start a.start else b.start end,
        end = if a.end > b.end a.end else b.end end
    }
end

# ═══════════════════════════════════════════════════════
# Type Representations
# ═══════════════════════════════════════════════════════

enum TypeNode
    Primitive(String)               # i64, f64, bool, void, ...
    Named(String)                   # User-defined type name
    Generic(String, Vec<TypeNode>)  # Vec<T>, Map<K,V>
    Pointer(TypeNode)               # ptr<T>
    Ref(TypeNode)                   # &T
    Array(TypeNode, usize)          # [T; N]
    Slice(TypeNode)                 # [T]
    Function(Vec<TypeNode>, TypeNode)  # func(A, B) -> C
    Optional(TypeNode)              # Option<T>
    Result(TypeNode, TypeNode)      # Result<T, E>
    Infer                           # type to be inferred
end

# ═══════════════════════════════════════════════════════
# Expression Nodes
# ═══════════════════════════════════════════════════════

enum UnaryOp Neg = 1; Not = 2; Deref = 3; AddrOf = 4 end

enum BinaryOp
    Add = 1; Sub = 2; Mul = 3; Div = 4; Mod = 5
    Eq = 10; Ne = 11; Lt = 12; Le = 13; Gt = 14; Ge = 15
    And = 20; Or = 21
    BitAnd = 30; BitOr = 31; BitXor = 32; Shl = 33; Shr = 34
    Assign = 40; AddAssign = 41; SubAssign = 42; MulAssign = 43; DivAssign = 44
end

enum Expr
    # Literals
    IntLit(i64, Span)
    FloatLit(f64, Span)
    BoolLit(bool, Span)
    StrLit(String, Span)
    CharLit(u32, Span)
    NullLit(Span)
    
    # Names
    Ident(String, Span)
    Path(Vec<String>, Span)           # module::name
    
    # Ops
    Unary(UnaryOp, Expr, Span)
    Binary(BinaryOp, Expr, Expr, Span)
    
    # Access
    Field(Expr, String, Span)         # expr.field
    Index(Expr, Expr, Span)           # expr[idx]
    Call(Expr, Vec<Expr>, Span)       # func(args...)
    MethodCall(Expr, String, Vec<Expr>, Span)  # expr.method(args...)
    
    # Constructors
    StructInit(String, Vec<FieldInit>, Span)
    ArrayInit(Vec<Expr>, Span)
    TupleInit(Vec<Expr>, Span)
    
    # Control flow as expr
    If(Expr, Vec<Stmt>, Option<Vec<Stmt>>, Span)  # if cond body [else body]
    Match(Expr, Vec<MatchArm>, Span)
    
    # Closures
    Lambda(Vec<Param>, Option<TypeNode>, Vec<Stmt>, Span)
    
    # Type
    Cast(Expr, TypeNode, Span)        # expr as Type
    SizeOf(TypeNode, Span)            # size_of<T>()
end

entity FieldInit
    name:  String
    value: Expr
    span:  Span
end

entity MatchArm
    pattern: Pattern
    guard:   Option<Expr>
    body:    Vec<Stmt>
    span:    Span
end

# ═══════════════════════════════════════════════════════
# Pattern Matching
# ═══════════════════════════════════════════════════════

enum Pattern
    Wildcard(Span)                    # _
    Ident(String, Span)               # x
    Literal(Expr, Span)               # 42, "hello"
    Tuple(Vec<Pattern>, Span)         # (a, b)
    Struct(String, Vec<FieldPattern>, Span)
    Enum(String, String, Option<Vec<Pattern>>, Span)  # EnumName.Variant(inner...)
    Or(Vec<Pattern>, Span)            # p1 | p2
end

entity FieldPattern
    name:    String
    pattern: Pattern
end

# ═══════════════════════════════════════════════════════
# Statement Nodes
# ═══════════════════════════════════════════════════════

enum Stmt
    # Declarations
    Let(String, Option<TypeNode>, Option<Expr>, Span)     # var x: T = expr
    Const(String, TypeNode, Expr, Span)                   # hằng_số X: T = expr
    
    # Expression statement
    ExprStmt(Expr, Span)
    
    # Control flow
    Return(Option<Expr>, Span)                            # out expr
    Break(Span)                                           # thoát
    Continue(Span)                                        # tiếp_tục
    
    # Loops
    While(Expr, Vec<Stmt>, Span)                          # lặp_khi cond body end
    Loop(Vec<Stmt>, Span)                                 # loop body end
    For(String, Expr, Vec<Stmt>, Span)                    # lặp_cho x in iter body end
    
    # Branching
    If(Expr, Vec<Stmt>, Vec<ElseIf>, Option<Vec<Stmt>>, Span)
    Match(Expr, Vec<MatchArm>, Span)
    
    # Block
    Block(Vec<Stmt>, Span)
end

entity ElseIf
    cond: Expr
    body: Vec<Stmt>
    span: Span
end

# ═══════════════════════════════════════════════════════
# Top-level Items
# ═══════════════════════════════════════════════════════

entity Param
    name:     String
    type_:    TypeNode
    default_: Option<Expr>
    span:     Span
end

enum Visibility Public = 1; Private = 2 end

enum Item
    Function(FnDef)
    Struct(StructDef)
    Enum(EnumDef)
    Const(String, TypeNode, Expr, Span)
    Import(ImportDef)
    ExternFn(ExternFnDef)
    TypeAlias(String, TypeNode, Span)
end

entity FnDef
    name:       String
    vis:        Visibility
    params:     Vec<Param>
    return_ty:  Option<TypeNode>
    generics:   Vec<String>
    body:       Vec<Stmt>
    span:       Span
end

entity StructDef
    name:     String
    vis:      Visibility
    generics: Vec<String>
    fields:   Vec<FieldDef>
    span:     Span
end

entity FieldDef
    name:  String
    type_: TypeNode
    span:  Span
end

entity EnumDef
    name:     String
    vis:      Visibility
    generics: Vec<String>
    variants: Vec<VariantDef>
    span:     Span
end

entity VariantDef
    name:   String
    fields: Vec<TypeNode>   # tuple-style: Variant(T1, T2)
    value:  Option<i64>     # explicit discriminant: Variant = 42
    span:   Span
end

entity ImportDef
    path:   Vec<String>           # "vir/core/types"
    items:  Vec<String>           # use A, B, C
    all:    bool                  # use all
    alias:  Option<String>        # use ... as X
    span:   Span
end

entity ExternFnDef
    name:      String
    params:    Vec<Param>
    return_ty: Option<TypeNode>
    span:      Span
end

# ═══════════════════════════════════════════════════════
# Module / Program
# ═══════════════════════════════════════════════════════

entity Module
    name:  String
    path:  String
    items: Vec<Item>
end

entity Program
    modules: Vec<Module>
end

func program_new() -> Program
    out Program { modules = vec_new<Module>() }
end

func program_add_module(prog: &Program, mod_: Module)
    vec_push<Module>(&prog.modules, mod_)
end
