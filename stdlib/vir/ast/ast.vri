##
 * vir/ast/ast.vri — AST Node Types for Vir Self-Hosting
 * =======================================================
 * Phase D — self-hosting compiler infrastructure
 *
 * Defines the complete AST for Vir language.
 * Used by: vir/token, vir/parser_kit, compiler frontend
 ##

include types
include option
import Option, Some, None from option
include string
import String from string
include vec
import Vec, vec_new, vec_push from vec

# ═══════════════════════════════════════════════════════
# Source Location
# ═══════════════════════════════════════════════════════

entity Span:
    file:  string,
        line:  int,
        col:   int,
        start: int   # byte offset,
        end:   int
end.
func span_new:
    in  file: string
        line: int
        col: int
        start: int
        end: int
    out Span ( file = file, line = line, col = col, start = start, end = end )
end.
func span_merge(a: Span, b: Span):
    out Span (
        file = a.file, line = a.line, col = a.col,
        start = if a.start < b.start a.start else b.start end,
        end = if a.end > b.end a.end else b.end end
    )
end.
# ═══════════════════════════════════════════════════════
# Type Representations
# ═══════════════════════════════════════════════════════

enum TypeNode:
    Primitive(string)               # int, float, bool, void, ...
    Named(string)                   # User-defined type name
    Generic(string, Vec of (TypeNode))  # Vec of (T), Map of (K,V)
    Pointer(TypeNode)               # ptr of (T)
    Ref of (TypeNode)                   # &T
    Array of (TypeNode, int)          # [T; N]
    Slice of (TypeNode)                 # [T]
    Function(Vec of (TypeNode), TypeNode)  # func(A, B) -> C
    Optional(TypeNode)              # Option of (T)
    Result of (TypeNode, TypeNode)      # Result of (T, E)
    Infer                           # type to be inferred
end.

# ═══════════════════════════════════════════════════════
# Expression Nodes
# ═══════════════════════════════════════════════════════

enum UnaryOp Neg = 1; Not = 2; Deref = 3; AddrOf = 4 end

enum BinaryOp:
    Add = 1; Sub = 2; Mul = 3; Div = 4; Mod = 5
    Eq = 10; Ne = 11; Lt = 12; Le = 13; Gt = 14; Ge = 15
    And = 20; Or = 21
    BitAnd = 30; BitOr = 31; BitXor = 32; Shl = 33; Shr = 34
    Assign = 40; AddAssign = 41; SubAssign = 42; MulAssign = 43; DivAssign = 44
end.
enum Expr:
    # Literals
    IntLit(int, Span)
    FloatLit(float, Span)
    BoolLit(bool, Span)
    StrLit(string, Span)
    CharLit(int, Span)
    NullLit(Span)
    
    # Names
    Ident(string, Span)
    Path(Vec of (string), Span)           # module.name
    
    # Ops
    Unary(UnaryOp, Expr, Span)
    Binary(BinaryOp, Expr, Expr, Span)
    
    # Access
    Field(Expr, string, Span)         # expr.field
    Index(Expr, Expr, Span)           # expr[idx]
    Call(Expr, Vec of (Expr), Span)       # func(args...)
    MethodCall(Expr, string, Vec of (Expr), Span)  # expr.method(args...)
    
    # Constructors
    StructInit(string, Vec of (FieldInit), Span)
    ArrayInit(Vec of (Expr), Span)
    TupleInit(Vec of (Expr), Span)
    
    # Control flow as expr
    If(Expr, Vec of (Stmt), Option of (Vec of (Stmt)), Span)  # if cond body [else body]
    Match(Expr, Vec of (MatchArm), Span)
    
    # Closures
    Lambda(Vec of (Param), Option of (TypeNode), Vec of (Stmt), Span)
    
    # Type
    Cast(Expr, TypeNode, Span)        # expr as Type
    SizeOf(TypeNode, Span)            # size_of of (T)()
end.
entity FieldInit:
    name:  string,
        value: Expr,
        span:  Span
end.
entity MatchArm:
    pattern: Pattern,
        guard:   Option of (Expr),
        body:    Vec of (Stmt),
        span:    Span
end.

# ═══════════════════════════════════════════════════════
# Pattern Matching
# ═══════════════════════════════════════════════════════

enum Pattern:
    Wildcard(Span)                    # _
    Ident(string, Span)               # x
    Literal(Expr, Span)               # 42, "hello"
    Tuple(Vec of (Pattern), Span)         # (a, b)
    Struct(string, Vec of (FieldPattern), Span)
    Enum(string, string, Option of (Vec of (Pattern)), Span)  # EnumName.Variant(inner...)
    Or(Vec of (Pattern), Span)            # p1 | p2
end.
entity FieldPattern:
    name:    string,
        pattern: Pattern
end.

# ═══════════════════════════════════════════════════════
# Statement Nodes
# ═══════════════════════════════════════════════════════

enum Stmt:
    # Declarations
    Let(string, Option of (TypeNode), Option of (Expr), Span)     # var x: T = expr
    Const(string, TypeNode, Expr, Span)                   # hằng_số X: T = expr
    
    # Expression statement
    ExprStmt(Expr, Span)
    
    # Control flow
    Return(Option of (Expr), Span)                            # out expr
    Break(Span)                                           # break
    Continue(Span)                                        # skip
    
    # Loops
    While(Expr, Vec of (Stmt), Span)                          # lặp_khi cond body end
    Loop(Vec of (Stmt), Span)                                 # loop body end
    For(string, Expr, Vec of (Stmt), Span)                    # lặp_cho x in iter body end
    
    # Branching
    If(Expr, Vec of (Stmt), Vec of (ElseIf), Option of (Vec of (Stmt)), Span)
    Match(Expr, Vec of (MatchArm), Span)
    
    # Block
    Block(Vec of (Stmt), Span)
end.
entity ElseIf:
    cond: Expr,
        body: Vec of (Stmt),
        span: Span
end.

# ═══════════════════════════════════════════════════════
# Top-level Items
# ═══════════════════════════════════════════════════════

entity Param:
    name:     string,
        type_:    TypeNode,
        default_: Option of (Expr),
        span:     Span
end.
enum Visibility Public = 1; Private = 2 end

enum Item:
    Function(FnDef)
    Struct(StructDef)
    Enum(EnumDef)
    Const(string, TypeNode, Expr, Span)
    Import(ImportDef)
    ExternFn(ExternFnDef)
    TypeAlias(string, TypeNode, Span)
end.
entity FnDef:
    name:       string,
        vis:        Visibility,
        params:     Vec of (Param),
        return_ty:  Option of (TypeNode),
        generics:   Vec of (string),
        body:       Vec of (Stmt),
        span:       Span
end.
entity StructDef:
    name:     string,
        vis:      Visibility,
        generics: Vec of (string),
        fields:   Vec of (FieldDef),
        span:     Span
end.
entity FieldDef:
    name:  string,
        type_: TypeNode,
        span:  Span
end.
entity EnumDef:
    name:     string,
        vis:      Visibility,
        generics: Vec of (string),
        variants: Vec of (VariantDef),
        span:     Span
end.
entity VariantDef:
    name:   string,
        fields: Vec of (TypeNode)   # tuple-style: Variant(T1, T2),
        value:  Option of (int)     # explicit discriminant: Variant = 42,
        span:   Span
end.
entity ImportDef:
    path:   Vec of (string)           # "vir/core/types",
        items:  Vec of (string)           # use A, B, C,
        all:    bool                  # use all,
        alias:  Option of (string)        # use ... as X,
        span:   Span
end.
entity ExternFnDef:
    name:      string,
        params:    Vec of (Param),
        return_ty: Option of (TypeNode),
        span:      Span
end.

# ═══════════════════════════════════════════════════════
# Module / Program
# ═══════════════════════════════════════════════════════

entity Module:
    name:  string,
        path:  string,
        items: Vec of (Item)
end.
entity Program:
    modules: Vec of (Module)
end.
func program_new:
    out Program ( modules = vec_new of (Module)() )
end.
func program_add_module(prog: Program, mod_: Module):
    vec_push of (Module)(&prog.modules, mod_)
end.
