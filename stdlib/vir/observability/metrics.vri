##
 * vir/observability/metrics.vri — Prometheus-style Metrics
 * ===========================================================
 * Inspired by: Prometheus client, OpenTelemetry metrics
 *
 * Counter, Gauge, Histogram with labels,
 * Prometheus exposition format output.
 ##

include types;
include option;
import Option, Some, None from option;
include vec;
import Vec, vec_new, vec_push, vec_len, vec_get from vec;
include map;
import Map, map_new, map_insert, map_get, map_contains from map;
include string_builder;
import StringBuilder, sb_new, sb_append, sb_build from string_builder;

# ═══════════════════════════════════════════════════════
# Metric types
# ═══════════════════════════════════════════════════════

const METRIC_COUNTER   = 1;
const METRIC_GAUGE     = 2;
const METRIC_HISTOGRAM = 3;

# ═══════════════════════════════════════════════════════
# Counter
# ═══════════════════════════════════════════════════════

entity Counter:
    name:    string,
        help:    string,
        values:  Map;      # label_key → float
end
func counter_new:
    in(name: string; help: string)
    out Counter ( name: name, help: help, values: map_new() );
end
func counter_inc:
    in(c: Counter; labels: string)
    if map_contains(c.values, labels) do
        v = map_get(c.values, labels);
        map_insert(c.values, labels, v + 1.0);
    else
        map_insert(c.values, labels, 1.0);
    end
end
func counter_add:
    in(c: Counter; labels: string; val: float)
    if map_contains(c.values, labels) do
        v = map_get(c.values, labels);
        map_insert(c.values, labels, v + val);
    else
        map_insert(c.values, labels, val);
    end
end
# ═══════════════════════════════════════════════════════
# Gauge
# ═══════════════════════════════════════════════════════

entity Gauge:
    name:    string,
        help:    string,
        values:  Map;
end
func gauge_new:
    in(name: string; help: string)
    out Gauge ( name: name, help: help, values: map_new() );
end
func gauge_set:
    in(g: Gauge; labels: string; val: float)
    map_insert(g.values, labels, val);
end
func gauge_inc:
    in(g: Gauge; labels: string)
    if map_contains(g.values, labels) do
        v = map_get(g.values, labels);
        map_insert(g.values, labels, v + 1.0);
    else
        map_insert(g.values, labels, 1.0);
    end
end
func gauge_dec:
    in(g: Gauge; labels: string)
    if map_contains(g.values, labels) do
        v = map_get(g.values, labels);
        map_insert(g.values, labels, v - 1.0);
    else
        map_insert(g.values, labels, -1.0);
    end
end
# ═══════════════════════════════════════════════════════
# Histogram
# ═══════════════════════════════════════════════════════

entity HistBucket:
    upper_bound: float,
        count:       int;
end
entity Histogram:
    name:    string,
        help:    string,
        buckets: Vec;       # Vec<HistBucket>
    sum:     float,
        count:   int;
end
func histogram_new:
    in(name: string; help: string; bounds: Vec)
    buckets = vec_new();
    i = 0;
    when i < vec_len(bounds) loop
        vec_push(buckets, HistBucket (
            upper_bound: vec_get(bounds, i),
            count: 0
        ));
        i = i + 1;
    end
    # +Inf bucket
    vec_push(buckets, HistBucket ( upper_bound: 1.0e300, count: 0 ));
    out Histogram (
        name: name, help: help,
        buckets: buckets, sum: 0.0, count: 0
    );
end
func histogram_default_bounds:
    bounds = vec_new();
    vec_push(bounds, 0.005);
    vec_push(bounds, 0.01);
    vec_push(bounds, 0.025);
    vec_push(bounds, 0.05);
    vec_push(bounds, 0.1);
    vec_push(bounds, 0.25);
    vec_push(bounds, 0.5);
    vec_push(bounds, 1.0);
    vec_push(bounds, 2.5);
    vec_push(bounds, 5.0);
    vec_push(bounds, 10.0);
    out bounds;
end
func histogram_observe:
    in(h: Histogram; value: float)
    h.sum = h.sum + value;
    h.count = h.count + 1;
    i = 0;
    when i < vec_len(h.buckets) loop
        b = vec_get(h.buckets, i);
        if value <= b.upper_bound do
            b.count = b.count + 1;
        end
        i = i + 1;
    end
end
# ═══════════════════════════════════════════════════════
# Metric Registry
# ═══════════════════════════════════════════════════════

entity MetricRegistry:
    counters:   Vec;     # Vec<Counter>
    gauges:     Vec;     # Vec<Gauge>
    histograms: Vec;     # Vec<Histogram>
end
func registry_new:
    out MetricRegistry (
        counters: vec_new(),
        gauges: vec_new(),
        histograms: vec_new()
    );
end
func registry_add_counter:
    in(reg: MetricRegistry; c: Counter)
    vec_push(reg.counters, c);
end
func registry_add_gauge:
    in(reg: MetricRegistry; g: Gauge)
    vec_push(reg.gauges, g);
end
func registry_add_histogram:
    in(reg: MetricRegistry; h: Histogram)
    vec_push(reg.histograms, h);
end
# ═══════════════════════════════════════════════════════
# Prometheus exposition format
# ═══════════════════════════════════════════════════════

func _expose_counter:
    in(sb: StringBuilder; c: Counter)
    sb_append(sb, "# HELP ");
    sb_append(sb, c.name);
    sb_append(sb, " ");
    sb_append(sb, c.help);
    sb_append(sb, "\n# TYPE ");
    sb_append(sb, c.name);
    sb_append(sb, " counter\n");
    # Flat iteration over values would require map iteration;
    # For now emit the "" (no label) value
    if map_contains(c.values, "") do
        v = map_get(c.values, "");
        sb_append(sb, c.name);
        sb_append(sb, " ");
        sb_append(sb, float_to_str(v));
        sb_append(sb, "\n");
    end
end
func _expose_gauge:
    in(sb: StringBuilder; g: Gauge)
    sb_append(sb, "# HELP ");
    sb_append(sb, g.name);
    sb_append(sb, " ");
    sb_append(sb, g.help);
    sb_append(sb, "\n# TYPE ");
    sb_append(sb, g.name);
    sb_append(sb, " gauge\n");
    if map_contains(g.values, "") do
        v = map_get(g.values, "");
        sb_append(sb, g.name);
        sb_append(sb, " ");
        sb_append(sb, float_to_str(v));
        sb_append(sb, "\n");
    end
end
func _expose_histogram:
    in(sb: StringBuilder; h: Histogram)
    sb_append(sb, "# HELP ");
    sb_append(sb, h.name);
    sb_append(sb, " ");
    sb_append(sb, h.help);
    sb_append(sb, "\n# TYPE ");
    sb_append(sb, h.name);
    sb_append(sb, " histogram\n");

    i = 0;
    when i < vec_len(h.buckets) loop
        b = vec_get(h.buckets, i);
        sb_append(sb, h.name);
        sb_append(sb, "_bucket{le=\"");
        if b.upper_bound >= 1.0e300 do
            sb_append(sb, "+Inf");
        else
            sb_append(sb, float_to_str(b.upper_bound));
        end
        sb_append(sb, "\"} ");
        sb_append(sb, int_to_str(b.count));
        sb_append(sb, "\n");
        i = i + 1;
    end

    sb_append(sb, h.name);
    sb_append(sb, "_sum ");
    sb_append(sb, float_to_str(h.sum));
    sb_append(sb, "\n");
    sb_append(sb, h.name);
    sb_append(sb, "_count ");
    sb_append(sb, int_to_str(h.count));
    sb_append(sb, "\n");
end
func registry_expose:
    in(reg: MetricRegistry)
    sb = sb_new();

    i = 0;
    when i < vec_len(reg.counters) loop
        _expose_counter(sb, vec_get(reg.counters, i));
        i = i + 1;
    end
    i = 0;
    when i < vec_len(reg.gauges) loop
        _expose_gauge(sb, vec_get(reg.gauges, i));
        i = i + 1;
    end
    i = 0;
    when i < vec_len(reg.histograms) loop
        _expose_histogram(sb, vec_get(reg.histograms, i));
        i = i + 1;
    end

    out sb_build(sb);
end