##
 * vir/encoding/hex.vri — Production-Grade Hexadecimal Encoder & Decoder
 * ======================================================================
 * Features:
 *   - Lowercase and uppercase hex encoding
 *   - Case-insensitive hex decoding
 *   - Strict validation: even length and valid hex characters [0-9a-fA-F]
 *   - Error model via Result<string, ParseError>
 *   - Zero libc dependencies
 ##

include types
include result
include alloc
import vir_alloc, vir_free from alloc
include vir.data.error

extern func native_read_u8(addr: int, offset: int) -> int
extern func native_write_u8(addr: int, offset: int, val: int)

func hex_str_len(addr: int) -> int:
    if addr == 0 do out 0 end
    var i = 0
    loop
        if native_read_u8(addr, i) == 0 do out i end
        i = i + 1
    end
    out 0
end.

func hex_char_to_val(ch: int) -> int:
    if ch >= 48 and ch <= 57 do out ch - 48 end # '0'..'9'
    if ch >= 97 and ch <= 102 do out ch - 97 + 10 end # 'a'..'f'
    if ch >= 65 and ch <= 70 do out ch - 65 + 10 end # 'A'..'F'
    out 0 - 1
end.

func hex_val_to_char(v: int, upper: bool) -> int:
    if v < 10 do out 48 + v end
    if upper do
        out 65 + (v - 10) # 'A'..'F'
    else
        out 97 + (v - 10) # 'a'..'f'
    end
end.

func hex_encode_bytes(src: int, len: int, upper: bool) -> string:
    if len <= 0 do out "" end
    let out_buf = vir_alloc(len * 2 + 1)
    var i = 0
    when i < len loop
        let b = native_read_u8(src, i)
        let hi = (b shr 4) bit_and 15
        let lo = b bit_and 15
        native_write_u8(out_buf, i * 2, hex_val_to_char(hi, upper))
        native_write_u8(out_buf, i * 2 + 1, hex_val_to_char(lo, upper))
        i = i + 1
    end
    native_write_u8(out_buf, len * 2, 0)
    out out_buf as string
end.

func hex_encode(data: string) -> string:
    let p = data as int
    if p == 0 do out "" end
    let slen = hex_str_len(p)
    out hex_encode_bytes(p, slen, false)
end.

func hex_encode_upper(data: string) -> string:
    let p = data as int
    if p == 0 do out "" end
    let slen = hex_str_len(p)
    out hex_encode_bytes(p, slen, true)
end.

func hex_decode(encoded: string) -> Result<string, ParseError>:
    let p = encoded as int
    if p == 0 do out Ok("") end
    let slen = hex_str_len(p)
    if slen == 0 do out Ok("") end
    if (slen mod 2) != 0 do
        out Err(parse_error_new(slen, 1, slen + 1, "hex string must have an even number of characters"))
    end

    let out_len = slen / 2
    let out_buf = vir_alloc(out_len + 1)
    var i = 0
    when i < out_len loop
        let c0 = native_read_u8(p, i * 2)
        let c1 = native_read_u8(p, i * 2 + 1)
        let v0 = hex_char_to_val(c0)
        if v0 < 0 do
            out Err(parse_error_new(i * 2, 1, i * 2 + 1, "invalid hexadecimal character"))
        end
        let v1 = hex_char_to_val(c1)
        if v1 < 0 do
            out Err(parse_error_new(i * 2 + 1, 1, i * 2 + 2, "invalid hexadecimal character"))
        end
        let b = (v0 shl 4) bit_or v1
        native_write_u8(out_buf, i, b)
        i = i + 1
    end
    native_write_u8(out_buf, out_len, 0)
    out Ok(out_buf as string)
end.

export hex_encode, hex_encode_upper, hex_encode_bytes, hex_decode
