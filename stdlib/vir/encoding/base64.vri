##
 * vir/encoding/base64.vri — Production-Grade RFC 4648 Base64 Encoder & Decoder
 * ============================================================================
 * Features:
 *   - Standard Base64 (+ and / with = padding)
 *   - URL-Safe Base64 (- and _, optional/unpadded or padded)
 *   - Strict character validation and padding enforcement
 *   - Error model via Result<string, ParseError>
 *   - Zero libc dependencies, pure Vir native operations
 ##

include types
include result
include alloc
import vir_alloc, vir_free from alloc
include vir.data.error

extern func native_read_u8(addr: int, offset: int) -> int
extern func native_write_u8(addr: int, offset: int, val: int)

func b64_str_len(addr: int) -> int:
    if addr == 0 do out 0 end
    var i = 0
    loop
        if native_read_u8(addr, i) == 0 do out i end
        i = i + 1
    end
    out 0
end.

func b64_enc_char(val: int, url_safe: bool) -> int:
    if val < 26 do out 65 + val end # 'A'..'Z'
    if val < 52 do out 97 + (val - 26) end # 'a'..'z'
    if val < 62 do out 48 + (val - 52) end # '0'..'9'
    if val == 62 do
        if url_safe do out 45 end # '-'
        out 43 # '+'
    end
    if val == 63 do
        if url_safe do out 95 end # '_'
        out 47 # '/'
    end
    out 61 # '='
end.

func b64_dec_val(c: int, url_safe: bool) -> int:
    if c >= 65 and c <= 90 do out c - 65 end
    if c >= 97 and c <= 122 do out c - 97 + 26 end
    if c >= 48 and c <= 57 do out c - 48 + 52 end
    if c == 43 do # '+'
        if url_safe do out 0 - 1 end
        out 62
    end
    if c == 47 do # '/'
        if url_safe do out 0 - 1 end
        out 63
    end
    if c == 45 do # '-'
        if url_safe do out 62 end
        out 0 - 1
    end
    if c == 95 do # '_'
        if url_safe do out 63 end
        out 0 - 1
    end
    out 0 - 1
end.

func base64_encode_bytes(src: int, len: int) -> string:
    if len <= 0 do out "" end
    let out_cap = ((len + 2) / 3) * 4 + 1
    let out_buf = vir_alloc(out_cap)
    var dst = 0
    var i = 0

    when i + 2 < len loop
        let b0 = native_read_u8(src, i)
        let b1 = native_read_u8(src, i + 1)
        let b2 = native_read_u8(src, i + 2)

        native_write_u8(out_buf, dst, b64_enc_char((b0 shr 2) bit_and 63, false))
        dst = dst + 1
        native_write_u8(out_buf, dst, b64_enc_char(((b0 shl 4) bit_or (b1 shr 4)) bit_and 63, false))
        dst = dst + 1
        native_write_u8(out_buf, dst, b64_enc_char(((b1 shl 2) bit_or (b2 shr 6)) bit_and 63, false))
        dst = dst + 1
        native_write_u8(out_buf, dst, b64_enc_char(b2 bit_and 63, false))
        dst = dst + 1

        i = i + 3
    end

    let rem = len - i
    if rem == 1 do
        let b0 = native_read_u8(src, i)
        native_write_u8(out_buf, dst, b64_enc_char((b0 shr 2) bit_and 63, false))
        dst = dst + 1
        native_write_u8(out_buf, dst, b64_enc_char((b0 shl 4) bit_and 63, false))
        dst = dst + 1
        native_write_u8(out_buf, dst, 61) # '='
        dst = dst + 1
        native_write_u8(out_buf, dst, 61) # '='
        dst = dst + 1
    eif rem == 2 do
        let b0 = native_read_u8(src, i)
        let b1 = native_read_u8(src, i + 1)
        native_write_u8(out_buf, dst, b64_enc_char((b0 shr 2) bit_and 63, false))
        dst = dst + 1
        native_write_u8(out_buf, dst, b64_enc_char(((b0 shl 4) bit_or (b1 shr 4)) bit_and 63, false))
        dst = dst + 1
        native_write_u8(out_buf, dst, b64_enc_char((b1 shl 2) bit_and 63, false))
        dst = dst + 1
        native_write_u8(out_buf, dst, 61) # '='
        dst = dst + 1
    end

    native_write_u8(out_buf, dst, 0)
    out out_buf as string
end.

func base64_encode(data: string) -> string:
    let p = data as int
    if p == 0 do out "" end
    let slen = b64_str_len(p)
    out base64_encode_bytes(p, slen)
end.

func base64_url_encode(data: string) -> string:
    let src = data as int
    if src == 0 do out "" end
    let len = b64_str_len(src)
    if len <= 0 do out "" end
    let out_cap = ((len + 2) / 3) * 4 + 1
    let out_buf = vir_alloc(out_cap)
    var dst = 0
    var i = 0

    when i + 2 < len loop
        let b0 = native_read_u8(src, i)
        let b1 = native_read_u8(src, i + 1)
        let b2 = native_read_u8(src, i + 2)

        native_write_u8(out_buf, dst, b64_enc_char((b0 shr 2) bit_and 63, true))
        dst = dst + 1
        native_write_u8(out_buf, dst, b64_enc_char(((b0 shl 4) bit_or (b1 shr 4)) bit_and 63, true))
        dst = dst + 1
        native_write_u8(out_buf, dst, b64_enc_char(((b1 shl 2) bit_or (b2 shr 6)) bit_and 63, true))
        dst = dst + 1
        native_write_u8(out_buf, dst, b64_enc_char(b2 bit_and 63, true))
        dst = dst + 1

        i = i + 3
    end

    let rem = len - i
    if rem == 1 do
        let b0 = native_read_u8(src, i)
        native_write_u8(out_buf, dst, b64_enc_char((b0 shr 2) bit_and 63, true))
        dst = dst + 1
        native_write_u8(out_buf, dst, b64_enc_char((b0 shl 4) bit_and 63, true))
        dst = dst + 1
    eif rem == 2 do
        let b0 = native_read_u8(src, i)
        let b1 = native_read_u8(src, i + 1)
        native_write_u8(out_buf, dst, b64_enc_char((b0 shr 2) bit_and 63, true))
        dst = dst + 1
        native_write_u8(out_buf, dst, b64_enc_char(((b0 shl 4) bit_or (b1 shr 4)) bit_and 63, true))
        dst = dst + 1
        native_write_u8(out_buf, dst, b64_enc_char((b1 shl 2) bit_and 63, true))
        dst = dst + 1
    end

    native_write_u8(out_buf, dst, 0)
    out out_buf as string
end.

func base64_decode_internal(encoded: string, url_safe: bool) -> Result<string, ParseError>:
    let src = encoded as int
    if src == 0 do out Ok("") end
    let slen = b64_str_len(src)
    if slen == 0 do out Ok("") end

    var pad_count = 0
    if slen >= 1 and native_read_u8(src, slen - 1) == 61 do
        pad_count = pad_count + 1
        if slen >= 2 and native_read_u8(src, slen - 2) == 61 do
            pad_count = pad_count + 1
        end
    end

    if pad_count > 0 and (slen mod 4) != 0 do
        out Err(parse_error_new(slen, 1, slen + 1, "invalid base64 padding length"))
    end

    let data_len = slen - pad_count
    if (data_len mod 4) == 1 do
        out Err(parse_error_new(data_len, 1, data_len + 1, "invalid base64 input length"))
    end

    let out_cap = (slen * 3 / 4) + 4
    let out_buf = vir_alloc(out_cap)
    var dst = 0
    var i = 0

    when i < data_len loop
        let c0 = native_read_u8(src, i)
        let v0 = b64_dec_val(c0, url_safe)
        if v0 < 0 do
            out Err(parse_error_new(i, 1, i + 1, "invalid base64 character"))
        end

        if i + 1 >= data_len do
            out Err(parse_error_new(i, 1, i + 1, "truncated base64 sequence"))
        end
        let c1 = native_read_u8(src, i + 1)
        let v1 = b64_dec_val(c1, url_safe)
        if v1 < 0 do
            out Err(parse_error_new(i + 1, 1, i + 2, "invalid base64 character"))
        end

        let b0 = ((v0 shl 2) bit_or (v1 shr 4)) bit_and 255
        native_write_u8(out_buf, dst, b0)
        dst = dst + 1

        if i + 2 < data_len do
            let c2 = native_read_u8(src, i + 2)
            let v2 = b64_dec_val(c2, url_safe)
            if v2 < 0 do
                out Err(parse_error_new(i + 2, 1, i + 3, "invalid base64 character"))
            end
            let b1 = ((v1 shl 4) bit_or (v2 shr 2)) bit_and 255
            native_write_u8(out_buf, dst, b1)
            dst = dst + 1

            if i + 3 < data_len do
                let c3 = native_read_u8(src, i + 3)
                let v3 = b64_dec_val(c3, url_safe)
                if v3 < 0 do
                    out Err(parse_error_new(i + 3, 1, i + 4, "invalid base64 character"))
                end
                let b2 = ((v2 shl 6) bit_or v3) bit_and 255
                native_write_u8(out_buf, dst, b2)
                dst = dst + 1
            end
        end

        i = i + 4
    end

    native_write_u8(out_buf, dst, 0)
    out Ok(out_buf as string)
end.

func base64_decode(encoded: string) -> Result<string, ParseError>:
    out base64_decode_internal(encoded, false)
end.

func base64_url_decode(encoded: string) -> Result<string, ParseError>:
    out base64_decode_internal(encoded, true)
end.

export base64_encode, base64_encode_bytes, base64_decode, base64_url_encode, base64_url_decode
