##
 * vir/math/rational.vri — Rational Number Arithmetic
 * ===================================================
 * Inspired by Rust: num-rational crate
 * Inspired by Python: fractions.Fraction
 * Inspired by Go: math/big.Rat
 *
 * Phase C — Tier 3: Exact rational arithmetic.
 * Rational numbers stored as numerator/denominator,
 * automatically reduced to lowest terms via GCD.
 ##

include types;
include option;
import Option, Some, None, is_some, is_none, unwrap from option;
include builder;
import StringBuilder, sb_new, sb_append, sb_append_byte, sb_append_i64,
       sb_build, sb_free from builder;

# ═══════════════════════════════════════════════════════
# Core entity
# ═══════════════════════════════════════════════════════

entity Rational:
    num: int;     # numerator (can be negative)
    den: int;     # denominator (always > 0)
end.

# ═══════════════════════════════════════════════════════
# GCD / LCM helpers
# ═══════════════════════════════════════════════════════

func _abs(x: int):
    if x < 0 do
        out -x;
    end
    out x;
end.
func _gcd(a: int, b: int):
    a = _abs(a);
    b = _abs(b);
    when b != 0 loop
        t = b;
        b = a % b;
        a = t;
    end
    out a;
end.
func _lcm(a: int, b: int):
    if a == 0 do
        out 0;
    end
    if b == 0 do
        out 0;
    end
    out _abs(a) / _gcd(a, b) * _abs(b);
end.
# ═══════════════════════════════════════════════════════
# Construction & normalization
# ═══════════════════════════════════════════════════════

func _normalize(r: Rational):
    if r.den < 0 do
        r.num = -r.num;
        r.den = -r.den;
    end
    if r.num == 0 do
        r.den = 1;
    else
        g = _gcd(r.num, r.den);
        if g > 1 do
            r.num = r.num / g;
            r.den = r.den / g;
        end
    end
end.
func rational_new(num: int, den: int):
    r = Rational ( num: num, den: den );
    _normalize(r);
    out r;
end.
func rational_from_int(n: int):
    out Rational ( num: n, den: 1 );
end.
func rational_zero():
    out Rational ( num: 0, den: 1 );
end.
func rational_one():
    out Rational ( num: 1, den: 1 );
end.
# ═══════════════════════════════════════════════════════
# Accessors
# ═══════════════════════════════════════════════════════

func rational_num(r: Rational):
    out r.num;
end.
func rational_den(r: Rational):
    out r.den;
end.
func rational_is_zero(r: Rational):
    out r.num == 0;
end.
func rational_is_positive(r: Rational):
    out r.num > 0;
end.
func rational_is_negative(r: Rational):
    out r.num < 0;
end.
func rational_is_integer(r: Rational):
    out r.den == 1;
end.
# ═══════════════════════════════════════════════════════
# Arithmetic
# ═══════════════════════════════════════════════════════

func rational_add(a: Rational, b: Rational):
    # a.num/a.den + b.num/b.den = (a.num*b.den + b.num*a.den) / (a.den*b.den)
    n = a.num * b.den + b.num * a.den;
    d = a.den * b.den;
    out rational_new(n, d);
end.
func rational_sub(a: Rational, b: Rational):
    n = a.num * b.den - b.num * a.den;
    d = a.den * b.den;
    out rational_new(n, d);
end.
func rational_mul(a: Rational, b: Rational):
    # cross-reduce first to avoid overflow
    g1 = _gcd(a.num, b.den);
    g2 = _gcd(b.num, a.den);
    n = (a.num / g1) * (b.num / g2);
    d = (a.den / g2) * (b.den / g1);
    r = Rational ( num: n, den: d );
    _normalize(r);
    out r;
end.
func rational_div(a: Rational, b: Rational):
    # a / b = a * (b.den / b.num)
    reciprocal = Rational ( num: b.den, den: b.num );
    out rational_mul(a, reciprocal);
end.
func rational_neg(a: Rational):
    out Rational ( num: -a.num, den: a.den );
end.
func rational_abs(a: Rational):
    out Rational ( num: _abs(a.num), den: a.den );
end.
func rational_inv(a: Rational):
    r = Rational ( num: a.den, den: a.num );
    _normalize(r);
    out r;
end.
# ═══════════════════════════════════════════════════════
# Comparison
# ═══════════════════════════════════════════════════════

func rational_cmp(a: Rational, b: Rational):
    # compare a.num * b.den vs b.num * a.den
    lhs = a.num * b.den;
    rhs = b.num * a.den;
    if lhs < rhs do
        out -1;
    eif lhs > rhs do
        out 1;
    end
    out 0;
end.
func rational_eq(a: Rational, b: Rational):
    out rational_cmp(a, b) == 0;
end.
func rational_lt(a: Rational, b: Rational):
    out rational_cmp(a, b) < 0;
end.
func rational_le(a: Rational, b: Rational):
    out rational_cmp(a, b) <= 0;
end.
func rational_gt(a: Rational, b: Rational):
    out rational_cmp(a, b) > 0;
end.
func rational_ge(a: Rational, b: Rational):
    out rational_cmp(a, b) >= 0;
end.
func rational_min(a: Rational, b: Rational):
    if rational_le(a, b) do
        out a;
    end
    out b;
end.
func rational_max(a: Rational, b: Rational):
    if rational_ge(a, b) do
        out a;
    end
    out b;
end.
# ═══════════════════════════════════════════════════════
# Conversion
# ═══════════════════════════════════════════════════════

func rational_to_int(r: Rational):
    out r.num / r.den;
end.
func rational_to_string(r: Rational):
    sb = sb_new();

    if r.den == 1 do
        sb_append_i64(sb, r.num);
    else
        sb_append_i64(sb, r.num);
        sb_append(sb, "/");
        sb_append_i64(sb, r.den);
    end

    result = sb_build(sb);
    sb_free(sb);
    out result;
end.
# Approximate as integer: floor(num/den)
func rational_floor(r: Rational):
    q = r.num / r.den;
    # Adjust for negative division
    if r.num < 0 do
        if q * r.den != r.num do
            q = q - 1;
        end
    end
    out q;
end.
# Approximate as integer: ceil(num/den)
func rational_ceil(r: Rational):
    q = r.num / r.den;
    if r.num > 0 do
        if q * r.den != r.num do
            q = q + 1;
        end
    end
    out q;
end.
# ═══════════════════════════════════════════════════════
# Power
# ═══════════════════════════════════════════════════════

func rational_pow(r: Rational, exp: int):
    if exp == 0 do
        out rational_one();
    end

    base = r;
    if exp < 0 do
        base = rational_inv(r);
        exp = -exp;
    end

    result_num = 1;
    result_den = 1;
    b_num = base.num;
    b_den = base.den;

    when exp > 0 loop
        if exp % 2 == 1 do
            result_num = result_num * b_num;
            result_den = result_den * b_den;
        end
        b_num = b_num * b_num;
        b_den = b_den * b_den;
        exp = exp / 2;
    end

    out rational_new(result_num, result_den);
end.
# ═══════════════════════════════════════════════════════
# Mediant & continued fraction
# ═══════════════════════════════════════════════════════

func rational_mediant(a: Rational, b: Rational):
    out rational_new(a.num + b.num, a.den + b.den);
end.
# Approximate a ratio n/d as best rational with den <= max_den
# Uses Stern-Brocot tree / mediants
func rational_approximate:
    in  num: int;
        den: int;
        max_den: int
    # Simple continued fraction convergent approach
    lo = Rational ( num: 0, den: 1 );    # 0/1
    hi = Rational ( num: 1, den: 0 );    # 1/0 = infinity sentinel
    best = rational_new(num, den);

    # Normalize to positive, track sign
    sign = 1;
    n = num;
    if n < 0 do
        sign = -1;
        n = -n;
    end
    d = den;

    # If already within limits, return as-is
    if d <= max_den do
        out best;
    end

    lo_n = 0;
    lo_d = 1;
    hi_n = 1;
    hi_d = 0;

    done = false;
    when not done loop
        mid_n = lo_n + hi_n;
        mid_d = lo_d + hi_d;

        if mid_d > max_den do
            done = true;
        else
            # Compare mid_n/mid_d with n/d
            cmp = mid_n * d - n * mid_d;
            if cmp < 0 do
                lo_n = mid_n;
                lo_d = mid_d;
            eif cmp > 0 do
                hi_n = mid_n;
                hi_d = mid_d;
            else
                # Exact match
                out rational_new(sign * mid_n, mid_d);
            end
        end
    end

    # Pick better of lo and hi
    # Compare |lo_n/lo_d - n/d| vs |hi_n/hi_d - n/d|
    err_lo = _abs(lo_n * d - n * lo_d);
    err_hi = _abs(hi_n * d - n * hi_d);

    if err_lo * hi_d <= err_hi * lo_d do
        out rational_new(sign * lo_n, lo_d);
    end
    out rational_new(sign * hi_n, hi_d);
end.