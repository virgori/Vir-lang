##
 * vir/math/distributions.vri — Statistical Distributions
 * ========================================================
 * Inspired by: SciPy stats, R distributions
 *
 * Normal, Uniform, Exponential, Poisson, Binomial, Chi-squared,
 * Student-t distributions. PDF, CDF, quantile functions.
 ##

include types;
include math;
import abs, sqrt, exp, log, pow, floor, PI, E from math;

# ═══════════════════════════════════════════════════════
# Gamma and Error functions
# ═══════════════════════════════════════════════════════

func _stirling_gamma(x: float):
    # Stirling's approximation for Gamma(x) when x > 0.5
    out sqrt(2.0 * PI / x) * pow(x / E, x);
end.
func _erf_approx(x: float):
    # Abramowitz & Stegun approximation (max error 1.5e-7)
    t = 1.0 / (1.0 + 0.3275911 * abs(x));
    poly = t * (0.254829592 + t * (-0.284496736 + t * (1.421413741 + t * (-1.453152027 + t * 1.061405429))));
    e = 1.0 - poly * exp(0.0 - x * x);
    if x < 0.0 do
        out 0.0 - e;
    end
    out e;
end.
# ═══════════════════════════════════════════════════════
# Normal Distribution
# ═══════════════════════════════════════════════════════

entity Normal:
    mu:    float,
        sigma: float;
end.
func normal_new(mu: float, sigma: float):
    out Normal ( mu: mu, sigma: sigma );
end.
func normal_standard():
    out Normal ( mu: 0.0, sigma: 1.0 );
end.
func normal_pdf(d: Normal, x: float):
    z = (x - d.mu) / d.sigma;
    out exp(-0.5 * z * z) / (d.sigma * sqrt(2.0 * PI));
end.
func normal_cdf(d: Normal, x: float):
    z = (x - d.mu) / (d.sigma * sqrt(2.0));
    out 0.5 * (1.0 + _erf_approx(z));
end.
func normal_quantile(d: Normal, p: float):
    # Rational approximation (Beasley-Springer-Moro)
    t = 0.0;
    if p < 0.5 do
        t = sqrt(-2.0 * log(p));
    else
        t = sqrt(-2.0 * log(1.0 - p));
    end
    c0 = 2.515517;
    c1 = 0.802853;
    c2 = 0.010328;
    d1 = 1.432788;
    d2 = 0.189269;
    d3 = 0.001308;
    z = t - (c0 + c1 * t + c2 * t * t) / (1.0 + d1 * t + d2 * t * t + d3 * t * t * t);
    if p < 0.5 do
        z = 0.0 - z;
    end
    out d.mu + z * d.sigma;
end.
# ═══════════════════════════════════════════════════════
# Uniform Distribution
# ═══════════════════════════════════════════════════════

entity Uniform:
    a: float,
        b: float;
end.
func uniform_new(a: float, b: float):
    out Uniform ( a: a, b: b );
end.
func uniform_pdf(d: Uniform, x: float):
    if x < d.a || x > d.b do
        out 0.0;
    end
    out 1.0 / (d.b - d.a);
end.
func uniform_cdf(d: Uniform, x: float):
    if x <= d.a do
        out 0.0;
    end
    if x >= d.b do
        out 1.0;
    end
    out (x - d.a) / (d.b - d.a);
end.
func uniform_quantile(d: Uniform, p: float):
    out d.a + p * (d.b - d.a);
end.
# ═══════════════════════════════════════════════════════
# Exponential Distribution
# ═══════════════════════════════════════════════════════

entity Exponential:
    lambda: float;
end.
func exponential_new(lambda: float):
    out Exponential ( lambda: lambda );
end.
func exponential_pdf(d: Exponential, x: float):
    if x < 0.0 do
        out 0.0;
    end
    out d.lambda * exp(0.0 - d.lambda * x);
end.
func exponential_cdf(d: Exponential, x: float):
    if x < 0.0 do
        out 0.0;
    end
    out 1.0 - exp(0.0 - d.lambda * x);
end.
func exponential_quantile(d: Exponential, p: float):
    out 0.0 - log(1.0 - p) / d.lambda;
end.
# ═══════════════════════════════════════════════════════
# Poisson Distribution (discrete)
# ═══════════════════════════════════════════════════════

entity Poisson:
    lambda: float;
end.
func poisson_new(lambda: float):
    out Poisson ( lambda: lambda );
end.
func poisson_pmf(d: Poisson, k: int):
    # P(X=k) = λ^k * e^(-λ) / k!
    lk = pow(d.lambda, int_to_float(k));
    e_neg = exp(0.0 - d.lambda);
    factorial = 1.0;
    i = 1;
    when i <= k loop
        factorial = factorial * int_to_float(i);
        i = i + 1;
    end
    out lk * e_neg / factorial;
end.
func poisson_cdf(d: Poisson, k: int):
    s = 0.0;
    i = 0;
    when i <= k loop
        s = s + poisson_pmf(d, i);
        i = i + 1;
    end
    out s;
end.
# ═══════════════════════════════════════════════════════
# Binomial Distribution (discrete)
# ═══════════════════════════════════════════════════════

entity Binomial:
    n: int,
        p: float;
end.
func binomial_new(n: int, p: float):
    out Binomial ( n: n, p: p );
end.
func _binomial_coeff(n: int, k: int):
    if k > n do
        out 0.0;
    end
    r = 1.0;
    i = 0;
    when i < k loop
        r = r * int_to_float(n - i) / int_to_float(i + 1);
        i = i + 1;
    end
    out r;
end.
func binomial_pmf(d: Binomial, k: int):
    c = _binomial_coeff(d.n, k);
    out c * pow(d.p, int_to_float(k)) * pow(1.0 - d.p, int_to_float(d.n - k));
end.
func binomial_cdf(d: Binomial, k: int):
    s = 0.0;
    i = 0;
    when i <= k loop
        s = s + binomial_pmf(d, i);
        i = i + 1;
    end
    out s;
end.
# ═══════════════════════════════════════════════════════
# Chi-Squared Distribution
# ═══════════════════════════════════════════════════════

entity ChiSquared:
    k: int;  # degrees of freedom
end.
func chi_squared_new(k: int):
    out ChiSquared ( k: k );
end.
func chi_squared_pdf(d: ChiSquared, x: float):
    if x <= 0.0 do
        out 0.0;
    end
    half_k = int_to_float(d.k) / 2.0;
    coeff = pow(0.5, half_k) / _stirling_gamma(half_k);
    out coeff * pow(x, half_k - 1.0) * exp(0.0 - x / 2.0);
end.
# ═══════════════════════════════════════════════════════
# t-Distribution (Student's)
# ═══════════════════════════════════════════════════════

entity StudentT:
    nu: int;  # degrees of freedom
end.
func student_t_new(nu: int):
    out StudentT ( nu: nu );
end.
func student_t_pdf(d: StudentT, x: float):
    v = int_to_float(d.nu);
    coeff = _stirling_gamma((v + 1.0) / 2.0) /
            (sqrt(v * PI) * _stirling_gamma(v / 2.0));
    out coeff * pow(1.0 + x * x / v, 0.0 - (v + 1.0) / 2.0);
end.
# ═══════════════════════════════════════════════════════
# Distribution statistics helpers
# ═══════════════════════════════════════════════════════

func normal_mean(d: Normal):
    out d.mu;
end.
func normal_variance(d: Normal):
    out d.sigma * d.sigma;
end.
func exponential_mean(d: Exponential):
    out 1.0 / d.lambda;
end.
func poisson_mean(d: Poisson):
    out d.lambda;
end.
func binomial_mean(d: Binomial):
    out int_to_float(d.n) * d.p;
end.
func binomial_variance(d: Binomial):
    out int_to_float(d.n) * d.p * (1.0 - d.p);
end.