##
 * vir/math/tensor_q8_0.vri — Borrowed Q8_0 tensor views and kernels
 *
 * Canonical block layout for this module:
 *   [little-endian f64 scale: 8 bytes][signed int8 values: 32 bytes]
 *
 * The view never owns or copies model bytes. Its generation cell is owned by
 * the mapping layer and must remain alive longer than every derived view. The
 * mapping layer increments the cell before unmapping the underlying bytes.
 ##

include types

extern func native_read_f64(addr: int, offset: int) -> float
extern func native_write_f64(addr: int, offset: int, value: float)

const
    Q80_OWNERSHIP_BORROWED: 0
    Q80_STORAGE_KIND: 80
    Q80_BLOCK_ELEMENTS: 32
    Q80_SCALE_BYTES: 8
    Q80_BLOCK_BYTES: 40

    Q80_OK: 0
    Q80_ERROR_NULL_BASE: 1
    Q80_ERROR_NULL_GENERATION: 2
    Q80_ERROR_DEAD_GENERATION: 3
    Q80_ERROR_STORAGE_KIND: 4
    Q80_ERROR_WRITABLE_STORAGE: 5
    Q80_ERROR_RANK: 6
    Q80_ERROR_SHAPE: 7
    Q80_ERROR_OFFSET: 8
    Q80_ERROR_LENGTH: 9
    Q80_ERROR_STRIDE: 10
    Q80_ERROR_ALIGNMENT: 11
    Q80_ERROR_OVERFLOW: 12
    Q80_ERROR_NULL_ACTIVATION: 13
    Q80_ERROR_NULL_OUTPUT: 14
    Q80_ERROR_ACTIVATION_LENGTH: 15
    Q80_ERROR_OUTPUT_LENGTH: 16
    Q80_ERROR_OWNERSHIP: 17

entity Q80TensorView:
    base: ptr
    byteLength: int
    byteOffset: int
    viewByteLength: int
    storageKind: int
    rank: int
    rows: int
    columns: int
    rowStrideBytes: int
    alignment: int
    readOnly: bool
    ownershipKind: int
    generationCell: ptr
    generation: int
end.

func q80RequiredRowBytes(columns: int) -> int:
    if columns <= 0 || columns mod Q80_BLOCK_ELEMENTS != 0 do
        out 0
    end
    let blocks = columns / Q80_BLOCK_ELEMENTS
    if blocks > 230584300921369395 do
        out 0
    end
    out blocks * Q80_BLOCK_BYTES
end.

func q80ValidateView(view: &Q80TensorView) -> int:
    if view.base == none do
        out Q80_ERROR_NULL_BASE
    end
    if view.generationCell == none do
        out Q80_ERROR_NULL_GENERATION
    end
    if native_read_i64(view.generationCell, 0) != view.generation do
        out Q80_ERROR_DEAD_GENERATION
    end
    if view.storageKind != Q80_STORAGE_KIND do
        out Q80_ERROR_STORAGE_KIND
    end
    if !view.readOnly do
        out Q80_ERROR_WRITABLE_STORAGE
    end
    if view.ownershipKind != Q80_OWNERSHIP_BORROWED do
        out Q80_ERROR_OWNERSHIP
    end
    if view.rank != 2 do
        out Q80_ERROR_RANK
    end
    if view.rows <= 0 || view.columns <= 0 || view.columns mod Q80_BLOCK_ELEMENTS != 0 do
        out Q80_ERROR_SHAPE
    end
    if view.byteLength <= 0 || view.viewByteLength <= 0 do
        out Q80_ERROR_LENGTH
    end
    if view.byteOffset < 0 || view.byteOffset > view.byteLength do
        out Q80_ERROR_OFFSET
    end
    if view.viewByteLength > view.byteLength - view.byteOffset do
        out Q80_ERROR_LENGTH
    end
    if view.alignment < Q80_SCALE_BYTES ||
       (view.alignment and (view.alignment - 1)) != 0 do
        out Q80_ERROR_ALIGNMENT
    end

    let baseAddress = view.base as int
    if baseAddress < 0 || view.byteOffset > 9223372036854775807 - baseAddress do
        out Q80_ERROR_OVERFLOW
    end
    let viewAddress = baseAddress + view.byteOffset
    if view.viewByteLength > 9223372036854775807 - viewAddress do
        out Q80_ERROR_OVERFLOW
    end

    let
        baseRemainder = baseAddress mod view.alignment
        offsetRemainder = view.byteOffset mod view.alignment
    if (baseRemainder + offsetRemainder) mod view.alignment != 0 do
        out Q80_ERROR_ALIGNMENT
    end

    let rowBytes = q80RequiredRowBytes(view.columns)
    if rowBytes == 0 do
        out Q80_ERROR_OVERFLOW
    end
    if view.rowStrideBytes < rowBytes || view.rowStrideBytes mod Q80_BLOCK_BYTES != 0 do
        out Q80_ERROR_STRIDE
    end
    if rowBytes > view.viewByteLength do
        out Q80_ERROR_LENGTH
    end
    if view.rows > 1 do
        let remainingRows = view.rows - 1
        if remainingRows > (view.viewByteLength - rowBytes) / view.rowStrideBytes do
            out Q80_ERROR_LENGTH
        end
    end
    out Q80_OK
end.

func q80CreateView:
    in base: ptr
       byteLength: int
       byteOffset: int
       viewByteLength: int
       rows: int
       columns: int
       rowStrideBytes: int
       alignment: int
       readOnly: bool
       ownershipKind: int
       generationCell: ptr
       generation: int

    let view = Q80TensorView(
        base: base,
        byteLength: byteLength,
        byteOffset: byteOffset,
        viewByteLength: viewByteLength,
        storageKind: Q80_STORAGE_KIND,
        rank: 2,
        rows: rows,
        columns: columns,
        rowStrideBytes: rowStrideBytes,
        alignment: alignment,
        readOnly: readOnly,
        ownershipKind: ownershipKind,
        generationCell: generationCell,
        generation: generation
    )
    let code = q80ValidateView(&view)
    if code != Q80_OK do
        throw code
    end
    out view
end.

func q80BlockAddress(view: &Q80TensorView, row: int, block: int) -> ptr:
    let byteAddress = (view.base as int) + view.byteOffset +
        row * view.rowStrideBytes + block * Q80_BLOCK_BYTES
    out byteAddress as ptr
end.

func q80SignedByte(block: ptr, element: int) -> int:
    var value = native_read_u8(block, Q80_SCALE_BYTES + element)
    if value > 127 do
        value = value - 256
    end
    out value
end.

func q80ValidateKernelBuffers:
    in view: &Q80TensorView
       activations: ptr
       activationLength: int
       output: ptr
       outputLength: int

    let viewCode = q80ValidateView(view)
    if viewCode != Q80_OK do
        out viewCode
    end
    if activations == none do
        out Q80_ERROR_NULL_ACTIVATION
    end
    if output == none do
        out Q80_ERROR_NULL_OUTPUT
    end
    if activationLength < view.columns do
        out Q80_ERROR_ACTIVATION_LENGTH
    end
    if outputLength < view.rows do
        out Q80_ERROR_OUTPUT_LENGTH
    end
    out Q80_OK
end.

func q80GemvScalar:
    in view: &Q80TensorView
       activations: ptr
       activationLength: int
       output: ptr
       outputLength: int

    let code = q80ValidateKernelBuffers(
        view,
        activations,
        activationLength,
        output,
        outputLength
    )
    if code != Q80_OK do
        throw code
    end

    let blockCount = view.columns / Q80_BLOCK_ELEMENTS
    var row = 0
    when row < view.rows loop
        var
            total = 0.0
            blockIndex = 0
        when blockIndex < blockCount loop
            let
                block = q80BlockAddress(view, row, blockIndex)
                scale = native_read_f64(block as int, 0)
                activationBase = blockIndex * Q80_BLOCK_ELEMENTS
            var
                element = 0
                blockSum = 0.0
            when element < Q80_BLOCK_ELEMENTS loop
                let
                    quantized = q80SignedByte(block, element)
                    activation = native_read_f64(
                        activations as int,
                        (activationBase + element) * 8
                    )
                blockSum = blockSum + (quantized as float) * activation
                element = element + 1
            end
            total = total + blockSum * scale
            blockIndex = blockIndex + 1
        end
        native_write_f64(output as int, row * 8, total)
        row = row + 1
    end
end.

func q80GemvSimd:
    in view: &Q80TensorView
       activations: ptr
       activationLength: int
       output: ptr
       outputLength: int

    let code = q80ValidateKernelBuffers(
        view,
        activations,
        activationLength,
        output,
        outputLength
    )
    if code != Q80_OK do
        throw code
    end

    let blockCount = view.columns / Q80_BLOCK_ELEMENTS
    var row = 0
    when row < view.rows loop
        var
            total = 0.0
            blockIndex = 0
        when blockIndex < blockCount loop
            let
                block = q80BlockAddress(view, row, blockIndex)
                scale = native_read_f64(block as int, 0)
                activationBase = blockIndex * Q80_BLOCK_ELEMENTS
            var
                element = 0
                blockAccumulator: flux of (float, 2) = flux(0.0, 0.0)
            when element < Q80_BLOCK_ELEMENTS loop
                let
                    q0 = q80SignedByte(block, element) as float
                    q1 = q80SignedByte(block, element + 1) as float
                    a0 = native_read_f64(
                        activations as int,
                        (activationBase + element) * 8
                    )
                    a1 = native_read_f64(
                        activations as int,
                        (activationBase + element + 1) * 8
                    )
                    quantizedPair: flux of (float, 2) = flux(q0, q1)
                    activationPair: flux of (float, 2) = flux(a0, a1)
                blockAccumulator = blockAccumulator + quantizedPair * activationPair
                element = element + 2
            end
            total = total + (blockAccumulator[0] + blockAccumulator[1]) * scale
            blockIndex = blockIndex + 1
        end
        native_write_f64(output as int, row * 8, total)
        row = row + 1
    end
end.

func q80GemvNeon:
    in view: &Q80TensorView
       activations: ptr
       activationLength: int
       output: ptr
       outputLength: int

    q80GemvSimd(view, activations, activationLength, output, outputLength)
end.

func q80Gemv:
    in view: &Q80TensorView
       activations: ptr
       activationLength: int
       output: ptr
       outputLength: int

    # `flux` lowers to target SIMD where supported and to scalar operations
    # under `--no-simd` or on targets without a native vector lowering.
    q80GemvSimd(view, activations, activationLength, output, outputLength)
end.

func q80Gemm:
    in view: &Q80TensorView
       activations: ptr
       batchRows: int
       activationStride: int
       output: ptr
       outputStride: int

    let viewCode = q80ValidateView(view)
    if viewCode != Q80_OK do
        throw viewCode
    end
    if activations == none do
        throw Q80_ERROR_NULL_ACTIVATION
    end
    if output == none do
        throw Q80_ERROR_NULL_OUTPUT
    end
    if batchRows <= 0 || activationStride < view.columns do
        throw Q80_ERROR_ACTIVATION_LENGTH
    end
    if outputStride < view.rows do
        throw Q80_ERROR_OUTPUT_LENGTH
    end

    var batch = 0
    when batch < batchRows loop
        let
            activationRow = ((activations as int) + batch * activationStride * 8) as ptr
            outputRow = ((output as int) + batch * outputStride * 8) as ptr
        q80Gemv(view, activationRow, activationStride, outputRow, outputStride)
        batch = batch + 1
    end
end.

export Q80TensorView
export Q80_OWNERSHIP_BORROWED
export Q80_STORAGE_KIND, Q80_BLOCK_ELEMENTS, Q80_SCALE_BYTES, Q80_BLOCK_BYTES
export Q80_OK, Q80_ERROR_NULL_BASE, Q80_ERROR_NULL_GENERATION
export Q80_ERROR_DEAD_GENERATION, Q80_ERROR_STORAGE_KIND
export Q80_ERROR_WRITABLE_STORAGE, Q80_ERROR_RANK, Q80_ERROR_SHAPE
export Q80_ERROR_OFFSET, Q80_ERROR_LENGTH, Q80_ERROR_STRIDE
export Q80_ERROR_ALIGNMENT, Q80_ERROR_OVERFLOW
export Q80_ERROR_NULL_ACTIVATION, Q80_ERROR_NULL_OUTPUT
export Q80_ERROR_ACTIVATION_LENGTH, Q80_ERROR_OUTPUT_LENGTH
export Q80_ERROR_OWNERSHIP
export q80RequiredRowBytes, q80ValidateView, q80CreateView
export q80BlockAddress, q80SignedByte, q80ValidateKernelBuffers
export q80GemvScalar, q80GemvSimd, q80GemvNeon, q80Gemv, q80Gemm
