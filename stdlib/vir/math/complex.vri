##
 * vir/math/complex.vri — Complex Number Arithmetic
 * =================================================
 * Inspired by Rust: num-complex crate
 * Inspired by Python: cmath
 * Inspired by Go: math/cmplx
 *
 * Phase C — Tier 2: Complex number entity with full arithmetic.
 * Uses fixed-point representation: values are scaled by 1_000_000
 * to simulate floating-point with integer-only arithmetic.
 ##

include types;
include option;
import Option, Some, None, is_some, unwrap from option;
include vec;
import Vec, vec_new, vec_push, vec_get, vec_len from vec;
include builder;
import StringBuilder, sb_new, sb_append, sb_append_i64, sb_build, sb_free from builder;

# ═══════════════════════════════════════════════════════
# Scale factor: 1 million (6 decimal places of precision)
# ═══════════════════════════════════════════════════════

const SCALE = 1000000;

# ═══════════════════════════════════════════════════════
# Complex number entity
# ═══════════════════════════════════════════════════════

entity Complex:
    re: int;    # real part, scaled by SCALE
    im: int;    # imaginary part, scaled by SCALE
end

# ─── Constructors ───────────────────────────────────

func complex_new:
    in(re: int; im: int)
    out Complex { re: re * SCALE, im: im * SCALE };
end

func complex_from_scaled:
    in(re_s: int; im_s: int)
    out Complex { re: re_s, im: im_s };
end

func complex_zero:
    in()
    out Complex { re: 0, im: 0 };
end

func complex_one:
    in()
    out Complex { re: SCALE, im: 0 };
end

func complex_i:
    in()
    out Complex { re: 0, im: SCALE };
end

# ─── Accessors (unscaled integers) ──────────────────

func complex_re:
    in(z: Complex)
    out z.re / SCALE;
end

func complex_im:
    in(z: Complex)
    out z.im / SCALE;
end

func complex_re_scaled:
    in(z: Complex)
    out z.re;
end

func complex_im_scaled:
    in(z: Complex)
    out z.im;
end

# ─── Arithmetic ─────────────────────────────────────

func complex_add:
    in(a: Complex; b: Complex)
    out Complex { re: a.re + b.re, im: a.im + b.im };
end

func complex_sub:
    in(a: Complex; b: Complex)
    out Complex { re: a.re - b.re, im: a.im - b.im };
end

func complex_mul:
    in(a: Complex; b: Complex)
    # (a+bi)(c+di) = (ac-bd) + (ad+bc)i
    re = (a.re * b.re - a.im * b.im) / SCALE;
    im = (a.re * b.im + a.im * b.re) / SCALE;
    out Complex { re: re, im: im };
end

func complex_div:
    in(a: Complex; b: Complex)
    # (a+bi)/(c+di) = ((ac+bd) + (bc-ad)i) / (c^2+d^2)
    denom = (b.re * b.re + b.im * b.im) / SCALE;
    re = (a.re * b.re + a.im * b.im) / denom;
    im = (a.im * b.re - a.re * b.im) / denom;
    out Complex { re: re, im: im };
end

# ─── Conjugate, Negate ──────────────────────────────

func complex_conj:
    in(z: Complex)
    out Complex { re: z.re, im: 0 - z.im };
end

func complex_neg:
    in(z: Complex)
    out Complex { re: 0 - z.re, im: 0 - z.im };
end

# ─── Magnitude squared (scaled) ─────────────────────

func complex_mag_sq:
    in(z: Complex)
    # |z|^2 = re^2 + im^2, result in SCALE^2 units
    out (z.re * z.re + z.im * z.im) / SCALE;
end

# ─── Integer square root (Newton's method) ──────────

func _isqrt:
    in(n: int)
    if n <= 0 out 0 end:
    if n == 1 out 1 end:
    x = n;
    y = (x + 1) / 2;
    when y < x loop
        x = y;
        y = (x + n / x) / 2;
    end
    out x;
end

# ─── Magnitude (|z|, scaled) ────────────────────────

func complex_abs:
    in(z: Complex)
    # |z| = sqrt(re^2 + im^2)
    mag_sq = z.re * z.re + z.im * z.im;
    out _isqrt(mag_sq);
end

# ─── Scale a complex by integer factor ──────────────

func complex_scale:
    in(z: Complex; k: int)
    out Complex { re: z.re * k, im: z.im * k };
end

func complex_scale_div:
    in(z: Complex; k: int)
    out Complex { re: z.re / k, im: z.im / k };
end

# ─── Equality (with tolerance) ──────────────────────

func complex_eq:
    in(a: Complex; b: Complex)
    dr = a.re - b.re;
    di = a.im - b.im;
    if dr < 0:
        dr = 0 - dr;
    end
    if di < 0:
        di = 0 - di;
    end
    # Tolerance: 1 unit of scaled value (0.000001)
    out dr <= 1 and di <= 1;
end

func complex_approx_eq:
    in(a: Complex; b: Complex; tol: int)
    dr = a.re - b.re;
    di = a.im - b.im;
    if dr < 0:
        dr = 0 - dr;
    end
    if di < 0:
        di = 0 - di;
    end
    out dr <= tol and di <= tol;
end

# ─── Power (integer exponent) ───────────────────────

func complex_pow:
    in(z: Complex; n: int)
    if n == 0 out complex_one() end:
    if n < 0:
        inv = complex_div(complex_one(), z);
        out complex_pow(inv, 0 - n);
    end
    result = complex_one();
    base = z;
    exp = n;
    when exp > 0 loop
        half = exp / 2;
        if exp - half * 2 == 1:
            result = complex_mul(result, base);
        end
        base = complex_mul(base, base);
        exp = half;
    end
    out result;
end

# ─── Phase angle approximation via CORDIC ───────────
# Returns angle in milliradians (1 radian = 1000 mrad)

func _abs_int:
    in(x: int)
    if x < 0 out 0 - x end:
    out x;
end

func complex_angle_mrad:
    in(z: Complex)
    # atan2 approximation using rational approximation
    # atan(t) ≈ t * (1 - t^2 / 3) for small t, scaled
    x = _abs_int(z.re);
    y = _abs_int(z.im);

    if x == 0 and y == 0 out 0 end:

    # Work in first quadrant, adjust later
    # atan2 base: pi/4 ~ 785 mrad, pi/2 ~ 1571 mrad, pi ~ 3142 mrad
    angle = 0;
    if x >= y:
        # atan(y/x) approximation
        # atan(t) ≈ t - t^3/3 ≈ t*(1 - t^2/3) for t<1
        t = (y * 1000) / x;     # t in milliunits
        t2 = t * t / 1000;
        angle = t - t * t2 / (3 * 1000);
    else:
        # pi/2 - atan(x/y)
        t = (x * 1000) / y;
        t2 = t * t / 1000;
        angle = 1571 - (t - t * t2 / (3 * 1000));
    end

    # Adjust for quadrant
    if z.re < 0 and z.im >= 0:
        angle = 3142 - angle;
    eif z.re < 0 and z.im < 0:
        angle = 0 - (3142 - angle);
    eif z.re >= 0 and z.im < 0:
        angle = 0 - angle;
    end
    out angle;
end

# ─── String representation ──────────────────────────

func complex_to_str:
    in(z: Complex)
    sb = sb_new();

    re_i = z.re / SCALE;
    im_i = z.im / SCALE;

    sb_append_i64(sb, re_i);

    if im_i >= 0:
        sb_append(sb, "+");
        sb_append_i64(sb, im_i);
    else:
        sb_append_i64(sb, im_i);
    end
    sb_append(sb, "i");

    result = sb_build(sb);
    sb_free(sb);
    out result;
end

# ─── Vector of complex numbers ──────────────────────

func complex_vec_new:
    in()
    out vec_new();
end

func complex_vec_push:
    in(v: Vec; z: Complex)
    vec_push(v, z);
end

func complex_vec_get:
    in(v: Vec; i: int)
    out vec_get(v, i);
end

# ─── Dot product of complex vectors ─────────────────

func complex_dot:
    in(a: Vec; b: Vec)
    sum = complex_zero();
    n = vec_len(a);
    i = 0;
    when i < n loop
        za = vec_get(a, i);
        zb = vec_get(b, i);
        sum = complex_add(sum, complex_mul(za, complex_conj(zb)));
        i = i + 1;
    end
    out sum;
end
