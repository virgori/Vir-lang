##
 * vir/math/bigint.vri — Arbitrary-Precision Integer Arithmetic
 * =============================================================
 * Inspired by Python: built-in int (unlimited precision)
 * Inspired by Go: math/big
 * Inspired by Rust: num-bigint crate
 *
 * Phase C — big integer support for cryptography and finance.
 * Uses base-2^30 digit representation for efficient arithmetic.
 * Supports add, sub, mul, div, mod, pow, comparison, string conversion.
 ##

include types;
include result;
import Result, Ok, Err from result;
include string;
import String, str_new, str_append, str_len, str_char_at from string;
include vec;
import Vec, vec_new, vec_push, vec_len, vec_get, vec_set from vec;

# ═══════════════════════════════════════════════════════
# BigInt representation
# ═══════════════════════════════════════════════════════

const BIGINT_BASE: 1073741824;    # 2^30
const BIGINT_BASE_BITS: 30;

entity BigInt:
    digits: Vec;    # Vec of int, each in [0, BASE), least significant first
    sign: int;      # 1 = positive, -1 = negative, 0 = zero
end

# ═══════════════════════════════════════════════════════
# Constructors
# ═══════════════════════════════════════════════════════

func bigint_zero:
    in()
    out BigInt { digits: vec_new(), sign: 0 };
end

func bigint_from_int:
    in(n: int)
    if n == 0 out bigint_zero() end:
    
    result = BigInt { digits: vec_new(), sign: 1 };
    if n < 0:
        result.sign = -1;
        n = -n;
    end
    
    when n > 0 loop
        vec_push(result.digits, n % BIGINT_BASE);
        n = n / BIGINT_BASE;
    end
    
    out result;
end

func bigint_from_str:
    in(s: String)
    if str_len(s) == 0 out bigint_zero() end:
    
    result = BigInt { digits: vec_new(), sign: 1 };
    start = 0;
    if str_char_at(s, 0) == '-':
        result.sign = -1;
        start = 1;
    eif str_char_at(s, 0) == '+':
        start = 1;
    end
    
    # Parse decimal digits
    i = start;
    when i < str_len(s) loop
        ch = str_char_at(s, i);
        digit = ch - 48;   # '0' = 48
        if digit < 0 or digit > 9:
            out bigint_zero();    # invalid char
        end
        _bigint_mul_add_digit(result, 10, digit);
        i = i + 1;
    end
    
    if vec_len(result.digits) == 0 result.sign = 0 end:
    out result;
end

func _bigint_mul_add_digit:
    in(a: BigInt; mul: int; add: int)
    carry = add;
    i = 0;
    when i < vec_len(a.digits) loop
        prod = vec_get(a.digits, i) * mul + carry;
        vec_set(a.digits, i, prod % BIGINT_BASE);
        carry = prod / BIGINT_BASE;
        i = i + 1;
    end
    when carry > 0 loop
        vec_push(a.digits, carry % BIGINT_BASE);
        carry = carry / BIGINT_BASE;
    end
end

# ═══════════════════════════════════════════════════════
# String Conversion
# ═══════════════════════════════════════════════════════

func bigint_to_str:
    in(a: BigInt)
    if a.sign == 0 out "0" end:
    
    # Repeatedly divide by 10 and collect remainders
    tmp = bigint_clone(a);
    chars = vec_new();
    
    when _bigint_is_nonzero(tmp) loop
        rem = _bigint_div_mod_small(tmp, 10);
        vec_push(chars, rem + 48);    # '0' = 48
    end
    
    result = str_new();
    if a.sign < 0 str_append(result, "-") end:
    i = vec_len(chars) - 1;
    when i >= 0 loop
        str_append(result, chr(vec_get(chars, i)));
        i = i - 1;
    end
    out result;
end

func _bigint_is_nonzero:
    in(a: BigInt)
    out vec_len(a.digits) > 0;
end

func _bigint_div_mod_small:
    in(a: BigInt; divisor: int)
    # In-place divide a by small int, return remainder
    carry = 0;
    i = vec_len(a.digits) - 1;
    when i >= 0 loop
        cur = carry * BIGINT_BASE + vec_get(a.digits, i);
        vec_set(a.digits, i, cur / divisor);
        carry = cur % divisor;
        i = i - 1;
    end
    # Remove leading zeros
    when vec_len(a.digits) > 0 and vec_get(a.digits, vec_len(a.digits) - 1) == 0 loop
        vec_pop(a.digits);
    end
    out carry;
end

func bigint_clone:
    in(a: BigInt)
    result = BigInt { digits: vec_new(), sign: a.sign };
    i = 0;
    when i < vec_len(a.digits) loop
        vec_push(result.digits, vec_get(a.digits, i));
        i = i + 1;
    end
    out result;
end

# ═══════════════════════════════════════════════════════
# Comparison
# ═══════════════════════════════════════════════════════

func bigint_compare:
    in(a: BigInt; b: BigInt)
    # Returns: -1, 0, 1
    if a.sign != b.sign:
        if a.sign > b.sign out 1 else out -1 end:
    end
    if a.sign == 0 out 0 end:
    
    result = _bigint_compare_abs(a, b);
    if a.sign < 0 out -result else out result end:
end

func _bigint_compare_abs:
    in(a: BigInt; b: BigInt)
    la = vec_len(a.digits);
    lb = vec_len(b.digits);
    if la != lb:
        if la > lb out 1 else out -1 end:
    end
    i = la - 1;
    when i >= 0 loop
        da = vec_get(a.digits, i);
        db = vec_get(b.digits, i);
        if da > db out 1 eif da < db out -1 end:
        i = i - 1;
    end
    out 0;
end

func bigint_eq:
    in(a: BigInt; b: BigInt)
    out bigint_compare(a, b) == 0;
end

func bigint_lt:
    in(a: BigInt; b: BigInt)
    out bigint_compare(a, b) < 0;
end

func bigint_gt:
    in(a: BigInt; b: BigInt)
    out bigint_compare(a, b) > 0;
end

# ═══════════════════════════════════════════════════════
# Addition
# ═══════════════════════════════════════════════════════

func bigint_add:
    in(a: BigInt; b: BigInt)
    if a.sign == 0 out bigint_clone(b) end:
    if b.sign == 0 out bigint_clone(a) end:
    
    if a.sign == b.sign:
        result = _bigint_add_abs(a, b);
        result.sign = a.sign;
        out result;
    end
    
    # Different signs: subtract
    cmp = _bigint_compare_abs(a, b);
    if cmp == 0 out bigint_zero() end:
    if cmp > 0:
        result = _bigint_sub_abs(a, b);
        result.sign = a.sign;
    else:
        result = _bigint_sub_abs(b, a);
        result.sign = b.sign;
    end
    out result;
end

func _bigint_add_abs:
    in(a: BigInt; b: BigInt)
    result = BigInt { digits: vec_new(), sign: 1 };
    la = vec_len(a.digits);
    lb = vec_len(b.digits);
    max_len = if la > lb la else lb end:
    carry = 0;
    
    i = 0;
    when i < max_len or carry > 0 loop
        da = if i < la vec_get(a.digits, i) else 0 end:
        db = if i < lb vec_get(b.digits, i) else 0 end:
        sum = da + db + carry;
        vec_push(result.digits, sum % BIGINT_BASE);
        carry = sum / BIGINT_BASE;
        i = i + 1;
    end
    out result;
end

# ═══════════════════════════════════════════════════════
# Subtraction
# ═══════════════════════════════════════════════════════

func bigint_sub:
    in(a: BigInt; b: BigInt)
    neg_b = BigInt { digits: b.digits, sign: -b.sign };
    if b.sign == 0 neg_b.sign = 0 end:
    out bigint_add(a, neg_b);
end

func _bigint_sub_abs:
    in(a: BigInt; b: BigInt)
    # Precondition: |a| >= |b|
    result = BigInt { digits: vec_new(), sign: 1 };
    borrow = 0;
    la = vec_len(a.digits);
    lb = vec_len(b.digits);
    
    i = 0;
    when i < la loop
        da = vec_get(a.digits, i);
        db = if i < lb vec_get(b.digits, i) else 0 end:
        diff = da - db - borrow;
        if diff < 0:
            diff = diff + BIGINT_BASE;
            borrow = 1;
        else:
            borrow = 0;
        end
        vec_push(result.digits, diff);
        i = i + 1;
    end
    
    # Remove leading zeros
    when vec_len(result.digits) > 0 and vec_get(result.digits, vec_len(result.digits) - 1) == 0 loop
        vec_pop(result.digits);
    end
    if vec_len(result.digits) == 0 result.sign = 0 end:
    out result;
end

# ═══════════════════════════════════════════════════════
# Multiplication — Karatsuba (O(n^1.585)) with schoolbook fallback
# ═══════════════════════════════════════════════════════

const KARATSUBA_THRESHOLD: 32;

func bigint_mul:
    in(a: BigInt; b: BigInt)
    if a.sign == 0 or b.sign == 0 out bigint_zero() end:
    result = _bigint_mul_abs(a, b);
    result.sign = a.sign * b.sign;
    out result;
end

func _bigint_mul_schoolbook:
    in(a: BigInt; b: BigInt)
    la = vec_len(a.digits);
    lb = vec_len(b.digits);
    result = BigInt { digits: vec_new(), sign: 1 };
    i = 0;
    when i < la + lb loop
        vec_push(result.digits, 0);
        i = i + 1;
    end
    i = 0;
    when i < la loop
        carry = 0;
        da = vec_get(a.digits, i);
        j = 0;
        when j < lb loop
            db = vec_get(b.digits, j);
            prod = da * db + vec_get(result.digits, i + j) + carry;
            vec_set(result.digits, i + j, prod % BIGINT_BASE);
            carry = prod / BIGINT_BASE;
            j = j + 1;
        end
        if carry > 0:
            cur = vec_get(result.digits, i + lb) + carry;
            vec_set(result.digits, i + lb, cur);
        end
        i = i + 1;
    end
    _bigint_strip_zeros(&result);
    out result;
end

func _bigint_mul_abs:
    in(a: BigInt; b: BigInt)
    la = vec_len(a.digits);
    lb = vec_len(b.digits);
    if la < KARATSUBA_THRESHOLD or lb < KARATSUBA_THRESHOLD:
        out _bigint_mul_schoolbook(a, b);
    end

    # Karatsuba: a = a1*B^m + a0, b = b1*B^m + b0
    m = if la < lb: la / 2; else: lb / 2; end;

    a0 = _bigint_slice(a, 0, m);
    a1 = _bigint_slice(a, m, la);
    b0 = _bigint_slice(b, 0, m);
    b1 = _bigint_slice(b, m, lb);

    z0 = _bigint_mul_abs(a0, b0);        # a0 * b0
    z2 = _bigint_mul_abs(a1, b1);        # a1 * b1
    # z1 = (a0+a1)*(b0+b1) - z0 - z2
    sum_a = _bigint_add_abs(a0, a1);
    sum_b = _bigint_add_abs(b0, b1);
    z1_full = _bigint_mul_abs(sum_a, sum_b);
    z1 = _bigint_sub_abs(_bigint_sub_abs(z1_full, z0), z2);

    # result = z2 * B^(2m) + z1 * B^m + z0
    _bigint_shift_left(&z2, 2 * m);
    _bigint_shift_left(&z1, m);
    result = _bigint_add_abs(_bigint_add_abs(z2, z1), z0);
    out result;
end

func _bigint_slice:
    in(a: BigInt; from: int; to: int)
    result = BigInt { digits: vec_new(), sign: 1 };
    i = from;
    when i < to and i < vec_len(a.digits) loop
        vec_push(result.digits, vec_get(a.digits, i));
        i = i + 1;
    end
    _bigint_strip_zeros(&result);
    if vec_len(result.digits) == 0: result.sign = 0; end
    out result;
end

func _bigint_shift_left:
    in(a: &BigInt; n: int)
    if a.sign == 0 out end:
    # Shift digits left by n positions (multiply by BASE^n)
    old_len = vec_len(a.digits);
    # Extend
    i = 0;
    when i < n loop
        vec_push(a.digits, 0);
        i = i + 1;
    end
    # Move existing digits up
    i = old_len - 1;
    when i >= 0 loop
        vec_set(a.digits, i + n, vec_get(a.digits, i));
        i = i - 1;
    end
    # Zero the low positions
    i = 0;
    when i < n loop
        vec_set(a.digits, i, 0);
        i = i + 1;
    end
end

func _bigint_strip_zeros:
    in(a: &BigInt)
    when vec_len(a.digits) > 0 and vec_get(a.digits, vec_len(a.digits) - 1) == 0 loop
        vec_pop(a.digits);
    end
    if vec_len(a.digits) == 0: a.sign = 0; end
end

# ═══════════════════════════════════════════════════════
# Division & Modulo
# ═══════════════════════════════════════════════════════

func bigint_divmod:
    in(a: BigInt; b: BigInt)
    if b.sign == 0 out Err("division by zero") end:
    if a.sign == 0 out Ok({ quot: bigint_zero(), rem: bigint_zero() }) end:
    
    cmp = _bigint_compare_abs(a, b);
    if cmp < 0:
        out Ok({ quot: bigint_zero(), rem: bigint_clone(a) });
    end
    if cmp == 0:
        one = bigint_from_int(1);
        one.sign = a.sign * b.sign;
        out Ok({ quot: one, rem: bigint_zero() });
    end
    
    # Long division
    quotient = BigInt { digits: vec_new(), sign: a.sign * b.sign };
    remainder = bigint_zero();
    
    i = vec_len(a.digits) - 1;
    when i >= 0 loop
        # Shift remainder left by one digit and add a.digits[i]
        _bigint_shift_left_one(remainder);
        if vec_len(remainder.digits) == 0:
            vec_push(remainder.digits, vec_get(a.digits, i));
        else:
            vec_set(remainder.digits, 0, vec_get(a.digits, i));
        end
        remainder.sign = if vec_len(remainder.digits) > 0 1 else 0 end:
        
        # Find how many times b fits into remainder (binary search)
        lo = 0; hi = BIGINT_BASE - 1;
        when lo < hi loop
            mid = (lo + hi + 1) / 2;
            trial = _bigint_mul_small_abs(b, mid);
            if _bigint_compare_abs(trial, remainder) <= 0:
                lo = mid;
            else:
                hi = mid - 1;
            end
        end
        
        vec_push(quotient.digits, lo);   # digits will be reversed
        if lo > 0:
            sub_val = _bigint_mul_small_abs(b, lo);
            remainder = _bigint_sub_abs(remainder, sub_val);
        end
        
        i = i - 1;
    end
    
    # Reverse quotient digits (we pushed most-significant first)
    _vec_reverse(quotient.digits);
    
    # Remove leading zeros
    when vec_len(quotient.digits) > 0 and vec_get(quotient.digits, vec_len(quotient.digits) - 1) == 0 loop
        vec_pop(quotient.digits);
    end
    if vec_len(quotient.digits) == 0 quotient.sign = 0 end:
    
    remainder.sign = if vec_len(remainder.digits) > 0 a.sign else 0 end:
    out Ok({ quot: quotient, rem: remainder });
end

func bigint_div:
    in(a: BigInt; b: BigInt)
    result = bigint_divmod(a, b);
    if result.is_err out bigint_zero() end:
    out result.value.quot;
end

func bigint_mod:
    in(a: BigInt; b: BigInt)
    result = bigint_divmod(a, b);
    if result.is_err out bigint_zero() end:
    out result.value.rem;
end

func _bigint_shift_left_one:
    in(a: BigInt)
    # Shift digits array left by 1 position (multiply by BASE)
    if vec_len(a.digits) == 0 out end:
    vec_push(a.digits, 0);
    i = vec_len(a.digits) - 1;
    when i > 0 loop
        vec_set(a.digits, i, vec_get(a.digits, i - 1));
        i = i - 1;
    end
    vec_set(a.digits, 0, 0);
end

func _bigint_mul_small_abs:
    in(a: BigInt; n: int)
    result = BigInt { digits: vec_new(), sign: 1 };
    carry = 0;
    i = 0;
    when i < vec_len(a.digits) loop
        prod = vec_get(a.digits, i) * n + carry;
        vec_push(result.digits, prod % BIGINT_BASE);
        carry = prod / BIGINT_BASE;
        i = i + 1;
    end
    when carry > 0 loop
        vec_push(result.digits, carry % BIGINT_BASE);
        carry = carry / BIGINT_BASE;
    end
    out result;
end

func _vec_reverse:
    in(v: Vec)
    lo = 0;
    hi = vec_len(v) - 1;
    when lo < hi loop
        tmp = vec_get(v, lo);
        vec_set(v, lo, vec_get(v, hi));
        vec_set(v, hi, tmp);
        lo = lo + 1;
        hi = hi - 1;
    end
end

# ═══════════════════════════════════════════════════════
# Exponentiation — modexp for crypto
# ═══════════════════════════════════════════════════════

func bigint_pow:
    in(base: BigInt; exp: int)
    if exp == 0 out bigint_from_int(1) end:
    if exp == 1 out bigint_clone(base) end:
    
    result = bigint_from_int(1);
    b = bigint_clone(base);
    e = exp;
    
    when e > 0 loop
        if e % 2 == 1:
            result = bigint_mul(result, b);
        end
        b = bigint_mul(b, b);
        e = e / 2;
    end
    out result;
end

func bigint_modpow:
    in(base: BigInt; exp: BigInt; modulus: BigInt)
    # Square-and-multiply with modular reduction
    if modulus.sign == 0 out bigint_zero() end:
    
    result = bigint_from_int(1);
    b = bigint_mod(base, modulus);
    
    i = 0;
    when i < vec_len(exp.digits) loop
        d = vec_get(exp.digits, i);
        bit = 0;
        when bit < BIGINT_BASE_BITS loop
            if (d >> bit) & 1 == 1:
                result = bigint_mod(bigint_mul(result, b), modulus);
            end
            b = bigint_mod(bigint_mul(b, b), modulus);
            bit = bit + 1;
        end
        i = i + 1;
    end
    out result;
end

# ═══════════════════════════════════════════════════════
# Bitwise operations
# ═══════════════════════════════════════════════════════

func bigint_abs:
    in(a: BigInt)
    result = bigint_clone(a);
    if result.sign < 0 result.sign = 1 end:
    out result;
end

func bigint_negate:
    in(a: BigInt)
    result = bigint_clone(a);
    result.sign = -result.sign;
    out result;
end

func bigint_is_zero:
    in(a: BigInt)
    out a.sign == 0;
end

func bigint_is_positive:
    in(a: BigInt)
    out a.sign > 0;
end

func bigint_is_negative:
    in(a: BigInt)
    out a.sign < 0;
end

# ═══════════════════════════════════════════════════════
# GCD — Euclidean algorithm
# ═══════════════════════════════════════════════════════

func bigint_gcd:
    in(a: BigInt; b: BigInt)
    x = bigint_abs(a);
    y = bigint_abs(b);
    when not bigint_is_zero(y) loop
        t = bigint_mod(x, y);
        x = y;
        y = t;
    end
    out x;
end
