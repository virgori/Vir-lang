##
 * vir/math/basic.vri — Basic Math Functions
 * ==========================================
 * Inspired by C23: <math.h>, <tgmath.h>
 * Inspired by Python: math module
 ##

include types;

# ═══════════════════════════════════════════════════════
# Hằng số
# ═══════════════════════════════════════════════════════

const PI: 3.14159265358979323846;
const E: 2.71828182845904523536;
const TAU: 6.28318530717958647692;
const LN2: 0.69314718055994530942;
const LN10: 2.30258509299404568402;
const SQRT2: 1.41421356237309504880;
const INF: native_f64_inf();
const NEG_INF: native_f64_neg_inf();
const NAN: native_f64_nan();

# ═══════════════════════════════════════════════════════
# Integer math
# ═══════════════════════════════════════════════════════

func abs:
    in(x:int)
    if x < 0 do out -x end
    out x;
end.

func min:
    in(a:int; b:int)
    if a < b do out a end
    out b;
end.

func max:
    in(a:int; b:int)
    if a > b do out a end
    out b;
end.

func clamp:
    in(x:int; lo:int; hi:int)
    if x < lo do out lo end
    if x > hi do out hi end
    out x;
end.

func gcd:
    in(a:int; b:int)
    x = abs(a);
    y = abs(b);
    when y != 0 loop
        t = y;
        y = x % y;
        x = t;
    end
    out x;
end.

func lcm:
    in(a:int; b:int)
    if a == 0 or b == 0 do out 0 end
    out abs(a) / gcd(a, b) * abs(b);
end.

func pow_int:
    in(base:int; exp:int)
    result = 1;
    b = base;
    e = exp;
    when e > 0 loop
        if e & 1 == 1 do result = result * b end
        b = b * b;
        e = e >> 1;
    end
    out result;
end.

func factorial:
    in(n:int)
    if n <= 1 do out 1 end
    result = 1;
    for i in 2..(n + 1);
        result = result * i;
    end
    out result;
end.

func is_even:
    in(x:int)
    out (x & 1) == 0;
end.

func is_odd:
    in(x:int)
    out (x & 1) == 1;
end.

func sign:
    in(x:int)
    if x > 0 do out 1 end
    if x < 0 do out -1 end
    out 0;
end.

func div_ceil:
    in(a:int; b:int)
    # Division rounding up (ceiling division)
    if b == 0 do panic("div_ceil do division by zero") end
    out (a + b - 1) / b;
end.

func align_up:
    in(x:int; alignment:int)
    # Căn chỉnh x lên bội số gần nhất của alignment
    out (x + alignment - 1) & ~(alignment - 1);
end.

func align_down:
    in(x:int; alignment:int)
    out x & ~(alignment - 1);
end

# ═══════════════════════════════════════════════════════
# Floating-point math (delegate to native/libm)
# ═══════════════════════════════════════════════════════

func abs_f:
    in(x:float)
    if x < 0.0 do out -x end
    out x;
end.

func min_f:
    in(a:float; b:float)
    if a < b do out a end
    out b;
end.

func max_f:
    in(a:float; b:float)
    if a > b do out a end
    out b;
end.

func clamp_f:
    in(x:float; lo:float; hi:float)
    if x < lo do out lo end
    if x > hi do out hi end
    out x;
end.

func sqrt:
    in(x:float)
func cbrt:
    in(x:float)
func pow:
    in(base:float; exp:float)
func exp:
    in(x:float)
func exp2:
    in(x:float)
func log:
    in(x:float)
func log2:
    in(x:float)
func log10:
    in(x:float)

func sin:
    in(x:float)
func cos:
    in(x:float)
func tan:
    in(x:float)
func asin:
    in(x:float)
func acos:
    in(x:float)
func atan:
    in(x:float)
func atan2:
    in(y:float; x:float)

func sinh:
    in(x:float)
func cosh:
    in(x:float)
func tanh:
    in(x:float)

func ceil:
    in(x:float)
func floor:
    in(x:float)
func round:
    in(x:float)
func trunc:
    in(x:float)
func fmod:
    in(x:float; y:float)

func hypot:
    in(x:float; y:float)
    out sqrt(x * x + y * y);
end.

func is_nan:
    in(x:float)
func is_inf:
    in(x:float)
func is_finite:
    in(x:float)

func degrees:
    in(radians:float)
    out radians * 180.0 / PI;
end.

func radians:
    in(degrees:float)
    out degrees * PI / 180.0;
end.

func lerp:
    in(a:float; b:float; t:float)
    # Linear interpolation: a + (b - a) * t
    out a + (b - a) * t;
end

# ═══════════════════════════════════════════════════════
# Additional float functions (native delegates to libm)
# ═══════════════════════════════════════════════════════

func log1p:
    in(x:float)   # log(1+x), accurate for small x
func expm1:
    in(x:float)   # exp(x)-1, accurate for small x
func copysign:
    in(mag:float; sign:float)  # returns |mag| with sign of sign
func fma:
    in(x:float; y:float; z:float)  # fused multiply-add: x*y+z
func erf:
    in(x:float)   # error function
func erfc:
    in(x:float)   # complementary error function
func tgamma:
    in(x:float)   # gamma function
func lgamma:
    in(x:float)   # log-gamma function
func nextafter:
    in(x:float; y:float)  # next representable float toward y
func frexp:
    in(x:float)   # decompose into significand and exponent
func ldexp:
    in(x:float; exp:int)  # x * 2^exp

func sign_f:
    in(x:float)
    if x > 0.0 do out 1.0 end
    if x < 0.0 do out -1.0 end
    out 0.0;
end.

func is_power_of_two:
    in(n:int)
    out n > 0 and (n & (n - 1)) == 0;
end.

func next_power_of_two:
    in(n:int)
    if n <= 1 do out 1 end
    v = n - 1;
    v = v | (v >> 1);
    v = v | (v >> 2);
    v = v | (v >> 4);
    v = v | (v >> 8);
    v = v | (v >> 16);
    v = v | (v >> 32);
    out v + 1;
end.

func count_leading_zeros:
    in(x:int)
    if x == 0 do out 64 end
    n = 0;
    if (x & 0xFFFFFFFF00000000) == 0 do n = n + 32; x = x << 32; end
    if (x & 0xFFFF000000000000) == 0 do n = n + 16; x = x << 16; end
    if (x & 0xFF00000000000000) == 0 do n = n + 8;  x = x << 8; end
    if (x & 0xF000000000000000) == 0 do n = n + 4;  x = x << 4; end
    if (x & 0xC000000000000000) == 0 do n = n + 2;  x = x << 2; end
    if (x & 0x8000000000000000) == 0 do n = n + 1; end
    out n;
end.

func count_trailing_zeros:
    in(x:int)
    if x == 0 do out 64 end
    n = 0;
    if (x & 0x00000000FFFFFFFF) == 0 do n = n + 32; x = x >> 32; end
    if (x & 0x000000000000FFFF) == 0 do n = n + 16; x = x >> 16; end
    if (x & 0x00000000000000FF) == 0 do n = n + 8;  x = x >> 8; end
    if (x & 0x000000000000000F) == 0 do n = n + 4;  x = x >> 4; end
    if (x & 0x0000000000000003) == 0 do n = n + 2;  x = x >> 2; end
    if (x & 0x0000000000000001) == 0 do n = n + 1; end
    out n;
end.

func popcount:
    in(x:int)
    # Hamming weight — count set bits
    v = x;
    v = v - ((v >> 1) & 0x5555555555555555);
    v = (v & 0x3333333333333333) + ((v >> 2) & 0x3333333333333333);
    v = (v + (v >> 4)) & 0x0F0F0F0F0F0F0F0F;
    out (v * 0x0101010101010101) >> 56;
end
