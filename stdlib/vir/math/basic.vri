##
 * vir/math/basic.vri — Basic Math Functions
 * ==========================================
 * Inspired by C23: <math.h>, <tgmath.h>
 * Inspired by Python: math module
 ##

include types

# ═══════════════════════════════════════════════════════
# Hằng số
# ═══════════════════════════════════════════════════════

const PI: 3.14159265358979323846
const E: 2.71828182845904523536
const TAU: 6.28318530717958647692
const LN2: 0.69314718055994530942
const LN10: 2.30258509299404568402
const SQRT2: 1.41421356237309504880
const INF: native_f64_inf()
const NEG_INF: native_f64_neg_inf()
const NAN: native_f64_nan()

# ═══════════════════════════════════════════════════════
# Integer math
# ═══════════════════════════════════════════════════════

func abs(x: int):
    if x < 0 do out -x end
    out x
end.
func min(a: int, b: int):
    if a < b do out a end
    out b
end.
func max(a: int, b: int):
    if a > b do out a end
    out b
end.
func clamp:
    in  x: int
        lo: int
        hi: int
    if x < lo do out lo end
    if x > hi do out hi end
    out x
end.
func gcd(a: int, b: int):
    x = abs(a)
    y = abs(b)
    when y != 0 loop
        t = y
        y = x mod y
        x = t
    end
    out x
end.
func lcm(a: int, b: int):
    if a == 0 or b == 0 do out 0 end
    out abs(a) / gcd(a, b) * abs(b)
end.
func pow_int(base: int, exp: int):
    result = 1
    b = base
    e = exp
    when e > 0 loop
        if e & 1 == 1 do result = result * b end
        b = b * b
        e = e  shr  1
    end
    out result
end.
func factorial(n: int):
    if n <= 1 do out 1 end
    result = 1
    for i in 2..(n + 1) do
        result = result * i
    end
    out result
end.
func is_even(x: int):
    out (x & 1) == 0
end.
func is_odd(x: int):
    out (x & 1) == 1
end.
func sign(x: int):
    if x > 0 do out 1 end
    if x < 0 do out -1 end
    out 0
end.
func div_ceil(a: int, b: int):
    # Division rounding up (ceiling division)
    if b == 0 do panic("div_ceil do division by zero") end
    out (a + b - 1) / b
end.
func align_up(x: int, alignment: int):
    # Căn chỉnh x lên bội số gần nhất của alignment
    out (x + alignment - 1) and ~(alignment - 1)
end.
func align_down(x: int, alignment: int):
    out x and ~(alignment - 1)
end.
# ═══════════════════════════════════════════════════════
# Floating-point math (delegate to native/libm)
# ═══════════════════════════════════════════════════════

func abs_f(x: float):
    if x < 0.0 do out -x end
    out x
end.
func min_f(a: float, b: float):
    if a < b do out a end
    out b
end.
func max_f(a: float, b: float):
    if a > b do out a end
    out b
end.
func clamp_f:
    in  x: float
        lo: float
        hi: float
    if x < lo do out lo end
    if x > hi do out hi end
    out x
end.
extern func sqrt(x: float) -> float
extern func cbrt(x: float) -> float
extern func pow(base: float, exp: float) -> float
extern func exp(x: float) -> float
extern func exp2(x: float) -> float
extern func log(x: float) -> float
extern func log2(x: float) -> float
extern func log10(x: float) -> float

extern func sin(x: float) -> float
extern func cos(x: float) -> float
extern func tan(x: float) -> float
extern func asin(x: float) -> float
extern func acos(x: float) -> float
extern func atan(x: float) -> float
extern func atan2(y: float, x: float) -> float

extern func sinh(x: float) -> float
extern func cosh(x: float) -> float
extern func tanh(x: float) -> float

extern func ceil(x: float) -> float
extern func floor(x: float) -> float
extern func round(x: float) -> float
extern func trunc(x: float) -> float
extern func fmod(x: float, y: float) -> float

func hypot(x: float, y: float):
    out sqrt(x * x + y * y)
end.
extern func is_nan(x: float) -> bool
extern func is_inf(x: float) -> bool
extern func is_finite(x: float) -> bool

func degrees(radians: float):
    out radians * 180.0 / PI
end.
func radians(degrees: float):
    out degrees * PI / 180.0
end.
func lerp:
    in  a: float
        b: float
        t: float
    # Linear interpolation: a + (b - a) * t
    out a + (b - a) * t
end.
# ═══════════════════════════════════════════════════════
# Additional float functions (native delegates to libm)
# ═══════════════════════════════════════════════════════

extern func log1p(x: float) -> float
extern func expm1(x: float) -> float
extern func copysign(mag: float, sign: float) -> float
extern func fma(x: float, y: float, z: float) -> float
extern func erf(x: float) -> float
extern func erfc(x: float) -> float
extern func tgamma(x: float) -> float
extern func lgamma(x: float) -> float
extern func nextafter(x: float, y: float) -> float
extern func frexp(x: float) -> float
extern func ldexp(x: float, exp: int) -> float

func sign_f(x: float):
    if x > 0.0 do out 1.0 end
    if x < 0.0 do out -1.0 end
    out 0.0
end.
func is_power_of_two(n: int):
    out n > 0 and (n and (n - 1)) == 0
end.
func next_power_of_two(n: int):
    if n <= 1 do out 1 end
    v = n - 1
    v = v or (v  shr  1)
    v = v or (v  shr  2)
    v = v or (v  shr  4)
    v = v or (v  shr  8)
    v = v or (v  shr  16)
    v = v or (v  shr  32)
    out v + 1
end.
func count_leading_zeros(x: int):
    if x == 0 do out 64 end
    n = 0
    if (x and 0xFFFFFFFF00000000) == 0 do n = n + 32; x = x  shl  32; end
    if (x and 0xFFFF000000000000) == 0 do n = n + 16; x = x  shl  16; end
    if (x and 0xFF00000000000000) == 0 do n = n + 8;  x = x  shl  8; end
    if (x and 0xF000000000000000) == 0 do n = n + 4;  x = x  shl  4; end
    if (x and 0xC000000000000000) == 0 do n = n + 2;  x = x  shl  2; end
    if (x and 0x8000000000000000) == 0 do n = n + 1; end
    out n
end.
func count_trailing_zeros(x: int):
    if x == 0 do out 64 end
    n = 0
    if (x and 0x00000000FFFFFFFF) == 0 do n = n + 32; x = x  shr  32; end
    if (x and 0x000000000000FFFF) == 0 do n = n + 16; x = x  shr  16; end
    if (x and 0x00000000000000FF) == 0 do n = n + 8;  x = x  shr  8; end
    if (x and 0x000000000000000F) == 0 do n = n + 4;  x = x  shr  4; end
    if (x and 0x0000000000000003) == 0 do n = n + 2;  x = x  shr  2; end
    if (x and 0x0000000000000001) == 0 do n = n + 1; end
    out n
end.
func popcount(x: int):
    # Hamming weight — count set bits
    v = x
    v = v - ((v  shr  1) and 0x5555555555555555)
    v = (v and 0x3333333333333333) + ((v  shr  2) and 0x3333333333333333)
    v = (v + (v  shr  4)) and 0x0F0F0F0F0F0F0F0F
    out (v * 0x0101010101010101)  shr  56
end.