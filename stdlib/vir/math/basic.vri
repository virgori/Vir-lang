/*
 * vir/math/basic.vri — Basic Math Functions
 * ==========================================
 * Inspired by C23: <math.h>, <tgmath.h>
 * Inspired by Python: math module
 */

import "vir/core/types" use all

# ═══════════════════════════════════════════════════════
# Hằng số
# ═══════════════════════════════════════════════════════

const PI      : f64 = 3.14159265358979323846
const E       : f64 = 2.71828182845904523536
const TAU     : f64 = 6.28318530717958647692
const LN2     : f64 = 0.69314718055994530942
const LN10    : f64 = 2.30258509299404568402
const SQRT2   : f64 = 1.41421356237309504880
const INF     : f64 = native_f64_inf()
const NEG_INF : f64 = native_f64_neg_inf()
const NAN     : f64 = native_f64_nan()

# ═══════════════════════════════════════════════════════
# Integer math
# ═══════════════════════════════════════════════════════

func abs(x: i64) -> i64
    if x < 0 out -x end
    out x
end

func min(a: i64, b: i64) -> i64
    if a < b out a end
    out b
end

func max(a: i64, b: i64) -> i64
    if a > b out a end
    out b
end

func clamp(x: i64, lo: i64, hi: i64) -> i64
    if x < lo out lo end
    if x > hi out hi end
    out x
end

func gcd(a: i64, b: i64) -> i64
    var x = abs(a)
    var y = abs(b)
    while y != 0
        var t = y
        y = x % y
        x = t
    end
    out x
end

func lcm(a: i64, b: i64) -> i64
    if a == 0 or b == 0 out 0 end
    out abs(a) / gcd(a, b) * abs(b)
end

func pow_int(base: i64, exp: u32) -> i64
    var result = 1
    var b = base
    var e = exp
    while e > 0
        if e & 1 == 1 result = result * b end
        b = b * b
        e = e >> 1
    end
    out result
end

func factorial(n: u32) -> i64
    if n <= 1 out 1 end
    var result = 1
    với mỗi i in 2..(n + 1)
        result = result * i
    end
    out result
end

func is_even(x: i64) -> bool
    out (x & 1) == 0
end

func is_odd(x: i64) -> bool
    out (x & 1) == 1
end

func sign(x: i64) -> i64
    if x > 0 out 1 end
    if x < 0 out -1 end
    out 0
end

func div_ceil(a: i64, b: i64) -> i64
    # Division rounding up (ceiling division)
    if b == 0 panic("div_ceil: division by zero") end
    out (a + b - 1) / b
end

func align_up(x: u64, alignment: u64) -> u64
    # Căn chỉnh x lên bội số gần nhất của alignment
    out (x + alignment - 1) & ~(alignment - 1)
end

func align_down(x: u64, alignment: u64) -> u64
    out x & ~(alignment - 1)
end

# ═══════════════════════════════════════════════════════
# Floating-point math (delegate to native/libm)
# ═══════════════════════════════════════════════════════

func abs_f(x: f64) -> f64
    if x < 0.0 out -x end
    out x
end

func min_f(a: f64, b: f64) -> f64
    if a < b out a end
    out b
end

func max_f(a: f64, b: f64) -> f64
    if a > b out a end
    out b
end

func clamp_f(x: f64, lo: f64, hi: f64) -> f64
    if x < lo out lo end
    if x > hi out hi end
    out x
end

func sqrt(x: f64) -> f64      out native_sqrt(x) end
func cbrt(x: f64) -> f64      out native_cbrt(x) end
func pow(base: f64, exp: f64) -> f64  out native_pow(base, exp) end
func exp(x: f64) -> f64       out native_exp(x) end
func exp2(x: f64) -> f64      out native_exp2(x) end
func log(x: f64) -> f64       out native_log(x) end    # ln
func log2(x: f64) -> f64      out native_log2(x) end
func log10(x: f64) -> f64     out native_log10(x) end

func sin(x: f64) -> f64       out native_sin(x) end
func cos(x: f64) -> f64       out native_cos(x) end
func tan(x: f64) -> f64       out native_tan(x) end
func asin(x: f64) -> f64      out native_asin(x) end
func acos(x: f64) -> f64      out native_acos(x) end
func atan(x: f64) -> f64      out native_atan(x) end
func atan2(y: f64, x: f64) -> f64  out native_atan2(y, x) end

func sinh(x: f64) -> f64      out native_sinh(x) end
func cosh(x: f64) -> f64      out native_cosh(x) end
func tanh(x: f64) -> f64      out native_tanh(x) end

func ceil(x: f64) -> f64      out native_ceil(x) end
func floor(x: f64) -> f64     out native_floor(x) end
func round(x: f64) -> f64     out native_round(x) end
func trunc(x: f64) -> f64     out native_trunc(x) end
func fmod(x: f64, y: f64) -> f64  out native_fmod(x, y) end

func hypot(x: f64, y: f64) -> f64
    out sqrt(x * x + y * y)
end

func is_nan(x: f64) -> bool   out native_isnan(x) end
func is_inf(x: f64) -> bool   out native_isinf(x) end
func is_finite(x: f64) -> bool out not is_nan(x) and not is_inf(x) end

func degrees(radians: f64) -> f64
    out radians * 180.0 / PI
end

func radians(degrees: f64) -> f64
    out degrees * PI / 180.0
end

func lerp(a: f64, b: f64, t: f64) -> f64
    # Linear interpolation: a + (b - a) * t
    out a + (b - a) * t
end
