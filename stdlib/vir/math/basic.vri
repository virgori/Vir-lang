func abs_f(x: float):
    if x < 0.0 do out -x end
    out x;
end.
func min_f(a: float, b: float):
    if a < b do out a end
    out b;
end.
func max_f(a: float, b: float):
    if a > b do out a end
    out b;
end.
func clamp_f:
    in  x: float;
        lo: float;
        hi: float
    if x < lo do out lo end
    if x > hi do out hi end
    out x;
end.
