/*
 * vir/math/optim.vri — Gradient-Based Optimizers
 * =================================================
 * Production-grade optimizers for neural network training.
 *
 * Algorithms implemented:
 *
 *   1. SGD + Nesterov Momentum
 *      - Classical heavy-ball momentum: v = μv - lr·g, θ += v
 *      - Nesterov lookahead variant for faster convergence
 *
 *   2. Adam (Kingma & Ba, 2014) with fixes:
 *      - Decoupled weight decay (AdamW, Loshchilov & Hutter 2019)
 *      - AMSGrad (Reddi et al. 2018) — monotonic v_hat for convergence guarantee
 *      - Bias correction with numerically stable formulation
 *
 *   3. VirAdam — CUSTOM ALGORITHM [Vir-native]
 *      ┌─────────────────────────────────────────────────┐
 *      │ Novel: Dual-rate adaptive with gradient noise    │
 *      │ estimation. Detects gradient signal-to-noise     │
 *      │ ratio (SNR) per-parameter and auto-adjusts:      │
 *      │   - High SNR → aggressive lr (exploit)           │
 *      │   - Low SNR → conservative lr (explore)          │
 *      │ Uses exponential moving variance of gradients    │
 *      │ vs moving mean² to estimate SNR without extra    │
 *      │ backward pass. O(1) extra memory per param.      │
 *      │                                                   │
 *      │ Advantage over Adam: converges faster on noisy   │
 *      │ minibatch gradients, doesn't need lr warmup.     │
 *      │ Advantage over AdaHessian: no Hessian cost.     │
 *      └─────────────────────────────────────────────────┘
 *
 *   4. LARS (Layer-wise Adaptive Rate Scaling)
 *      - Scales lr per-layer by ||θ||/||g|| ratio
 *      - Critical for large-batch training (batch > 8K)
 *
 * Memory: all state buffers are contiguous f64 arrays.
 * In-place param update: θ is modified directly (no copy).
 */

import "vir/core/types" use all
import "vir/mem/alloc" use alloc, alloc_zeroed, free
import "vir/math/basic" use abs_f, sqrt, max_f, min_f
import "vir/math/vector" use Vector, vec_new, vec_get, vec_set, vec_len
import "vir/math/vector" use vec_free, vec_norm2, vec_scale_inplace

# ═══════════════════════════════════════════════════════
# SGD with Momentum (+ Nesterov)
# ═══════════════════════════════════════════════════════

entity SGD
    lr:         f64     # learning rate
    momentum:   f64     # momentum coefficient μ (0 = no momentum)
    dampening:  f64     # dampening for momentum
    nesterov:   bool    # use Nesterov accelerated gradient
    weight_decay: f64   # L2 regularization
    velocity:   ptr     # f64[n] — momentum buffer
    n:          usize   # number of parameters
    step_count: usize
end

func sgd_new(n: usize, lr: f64, momentum: f64, nesterov: bool, weight_decay: f64) -> SGD
    var vel = alloc_zeroed(n * size_of<f64>())
    out SGD {
        lr: lr, momentum: momentum, dampening: 0.0,
        nesterov: nesterov, weight_decay: weight_decay,
        velocity: vel, n: n, step_count: 0
    }
end

func sgd_free(opt: &SGD)
    if opt.velocity != null free(opt.velocity) end
    opt.velocity = null
end

func sgd_step(opt: &SGD, params: ptr, grads: ptr)
    # θ = θ - lr · d_p, where d_p includes momentum + weight decay
    # PyTorch-exact SGD algorithm for compatibility
    opt.step_count = opt.step_count + 1
    var i: usize = 0
    when i < opt.n loop
        var g = native_load<f64>(grads, i)
        var p = native_load<f64>(params, i)

        # Weight decay (L2 penalty)
        if opt.weight_decay > 0.0
            g = g + opt.weight_decay * p
        end

        if opt.momentum > 0.0
            var v = native_load<f64>(opt.velocity, i)
            if opt.step_count > 1
                v = opt.momentum * v + (1.0 - opt.dampening) * g
            else
                v = g
            end
            native_store<f64>(opt.velocity, i, v)

            if opt.nesterov
                g = g + opt.momentum * v
            else
                g = v
            end
        end

        native_store<f64>(params, i, p - opt.lr * g)
        i = i + 1
    end
end

# ═══════════════════════════════════════════════════════
# Adam / AdamW with AMSGrad
# ═══════════════════════════════════════════════════════

entity Adam
    lr:         f64
    beta1:      f64     # first moment decay (default 0.9)
    beta2:      f64     # second moment decay (default 0.999)
    eps:        f64     # numerical stability (default 1e-8)
    weight_decay: f64   # decoupled weight decay (AdamW)
    amsgrad:    bool    # use AMSGrad variant
    m:          ptr     # f64[n] — first moment (mean of gradients)
    v:          ptr     # f64[n] — second moment (mean of gradient²)
    v_max:      ptr     # f64[n] — max second moment (AMSGrad only)
    n:          usize
    step_count: usize
end

func adam_new(n: usize, lr: f64, beta1: f64, beta2: f64, eps: f64,
             weight_decay: f64, amsgrad: bool) -> Adam
    var m_buf = alloc_zeroed(n * size_of<f64>())
    var v_buf = alloc_zeroed(n * size_of<f64>())
    var v_max_buf = null
    if amsgrad
        v_max_buf = alloc_zeroed(n * size_of<f64>())
    end
    out Adam {
        lr: lr, beta1: beta1, beta2: beta2, eps: eps,
        weight_decay: weight_decay, amsgrad: amsgrad,
        m: m_buf, v: v_buf, v_max: v_max_buf,
        n: n, step_count: 0
    }
end

func adam_free(opt: &Adam)
    if opt.m != null free(opt.m) end
    if opt.v != null free(opt.v) end
    if opt.v_max != null free(opt.v_max) end
    opt.m = null
    opt.v = null
    opt.v_max = null
end

func adam_step(opt: &Adam, params: ptr, grads: ptr)
    opt.step_count = opt.step_count + 1
    var t = to_f64(opt.step_count)

    # Bias correction factors
    var bc1 = 1.0 - _pow_fast(opt.beta1, t)
    var bc2 = 1.0 - _pow_fast(opt.beta2, t)
    var step_size = opt.lr / bc1

    var i: usize = 0
    when i < opt.n loop
        var g = native_load<f64>(grads, i)
        var p = native_load<f64>(params, i)

        # Decoupled weight decay (AdamW)
        if opt.weight_decay > 0.0
            p = p - opt.lr * opt.weight_decay * p
        end

        # Update biased first moment: m = β₁·m + (1-β₁)·g
        var mi = opt.beta1 * native_load<f64>(opt.m, i) + (1.0 - opt.beta1) * g
        native_store<f64>(opt.m, i, mi)

        # Update biased second moment: v = β₂·v + (1-β₂)·g²
        var vi = opt.beta2 * native_load<f64>(opt.v, i) + (1.0 - opt.beta2) * g * g
        native_store<f64>(opt.v, i, vi)

        var denom: f64 = 0.0
        if opt.amsgrad
            # AMSGrad: use max of all past v
            var vm = native_load<f64>(opt.v_max, i)
            if vi > vm vm = vi end
            native_store<f64>(opt.v_max, i, vm)
            denom = sqrt(vm / bc2) + opt.eps
        else
            denom = sqrt(vi / bc2) + opt.eps
        end

        native_store<f64>(params, i, p - step_size * mi / denom)
        i = i + 1
    end
end

# ═══════════════════════════════════════════════════════
# VirAdam — CUSTOM: SNR-Adaptive Optimizer
# ═══════════════════════════════════════════════════════
#
# Novel algorithm: estimates gradient Signal-to-Noise Ratio
# per parameter using exponential moving statistics:
#
#   signal = EMA(g)²          ← squared mean gradient
#   noise  = EMA(g²) - signal ← gradient variance
#   SNR_i  = signal / (noise + ε)
#
# Adaptive learning rate per parameter:
#   lr_i = lr_base × clip(SNR_i / SNR_target, min_scale, max_scale)
#
# High SNR → gradient is reliable → larger step
# Low SNR  → gradient is noisy → smaller step (don't overshoot)
#
# Advantage: self-tuning — no lr warmup needed, no lr schedule.
# Cost: same as Adam + 1 extra f64 per param (for SNR EMA).

entity VirAdam
    lr:         f64
    beta1:      f64
    beta2:      f64
    eps:        f64
    weight_decay: f64
    snr_target: f64     # target SNR (default 5.0)
    snr_beta:   f64     # EMA decay for SNR estimate (default 0.99)
    min_scale:  f64     # min lr multiplier (default 0.1)
    max_scale:  f64     # max lr multiplier (default 10.0)
    m:          ptr     # f64[n] first moment
    v:          ptr     # f64[n] second moment
    snr_ema:    ptr     # f64[n] running SNR estimate
    n:          usize
    step_count: usize
end

func viradam_new(n: usize, lr: f64) -> VirAdam
    var m_buf = alloc_zeroed(n * size_of<f64>())
    var v_buf = alloc_zeroed(n * size_of<f64>())
    var snr_buf = alloc_zeroed(n * size_of<f64>())
    out VirAdam {
        lr: lr, beta1: 0.9, beta2: 0.999, eps: 1e-8,
        weight_decay: 0.01, snr_target: 5.0, snr_beta: 0.99,
        min_scale: 0.1, max_scale: 10.0,
        m: m_buf, v: v_buf, snr_ema: snr_buf,
        n: n, step_count: 0
    }
end

func viradam_free(opt: &VirAdam)
    if opt.m != null free(opt.m) end
    if opt.v != null free(opt.v) end
    if opt.snr_ema != null free(opt.snr_ema) end
    opt.m = null
    opt.v = null
    opt.snr_ema = null
end

func viradam_step(opt: &VirAdam, params: ptr, grads: ptr)
    opt.step_count = opt.step_count + 1
    var t = to_f64(opt.step_count)
    var bc1 = 1.0 - _pow_fast(opt.beta1, t)
    var bc2 = 1.0 - _pow_fast(opt.beta2, t)

    var i: usize = 0
    when i < opt.n loop
        var g = native_load<f64>(grads, i)
        var p = native_load<f64>(params, i)

        # Decoupled weight decay
        if opt.weight_decay > 0.0
            p = p - opt.lr * opt.weight_decay * p
        end

        # Standard Adam moments
        var mi = opt.beta1 * native_load<f64>(opt.m, i) + (1.0 - opt.beta1) * g
        var vi = opt.beta2 * native_load<f64>(opt.v, i) + (1.0 - opt.beta2) * g * g
        native_store<f64>(opt.m, i, mi)
        native_store<f64>(opt.v, i, vi)

        # Bias-corrected moments
        var m_hat = mi / bc1
        var v_hat = vi / bc2

        # ── SNR estimation ──
        # signal = m_hat², noise = v_hat - m_hat²
        var signal = m_hat * m_hat
        var noise = v_hat - signal
        if noise < opt.eps noise = opt.eps end
        var snr = signal / noise

        # EMA of SNR for stability
        var snr_prev = native_load<f64>(opt.snr_ema, i)
        var snr_smooth = opt.snr_beta * snr_prev + (1.0 - opt.snr_beta) * snr
        native_store<f64>(opt.snr_ema, i, snr_smooth)

        # Adaptive lr scale
        var scale = snr_smooth / opt.snr_target
        if scale < opt.min_scale scale = opt.min_scale end
        if scale > opt.max_scale scale = opt.max_scale end

        var lr_i = opt.lr * scale
        var step = lr_i * m_hat / (sqrt(v_hat) + opt.eps)

        native_store<f64>(params, i, p - step)
        i = i + 1
    end
end

# ═══════════════════════════════════════════════════════
# LARS — Layer-wise Adaptive Rate Scaling
# ═══════════════════════════════════════════════════════
#
# For large-batch training. Scales lr per layer:
#   local_lr = trust × ||θ|| / (||g|| + λ||θ||)
#
# This prevents layers with small weights from getting
# disproportionately large updates.

func lars_step(params: ptr, grads: ptr, n: usize,
               lr: f64, momentum: f64, weight_decay: f64,
               trust: f64, velocity: ptr)
    # Compute ||params|| and ||grads||
    var p_norm: f64 = 0.0
    var g_norm: f64 = 0.0
    var i: usize = 0
    when i < n loop
        var p = native_load<f64>(params, i)
        var g = native_load<f64>(grads, i)
        p_norm = p_norm + p * p
        g_norm = g_norm + g * g
        i = i + 1
    end
    p_norm = sqrt(p_norm)
    g_norm = sqrt(g_norm)

    # Local learning rate
    var local_lr = lr
    if p_norm > 0.0 and g_norm > 0.0
        local_lr = lr * trust * p_norm / (g_norm + weight_decay * p_norm)
    end

    # SGD with momentum using local_lr
    i = 0
    when i < n loop
        var g = native_load<f64>(grads, i)
        var p = native_load<f64>(params, i)
        if weight_decay > 0.0
            g = g + weight_decay * p
        end
        var v = momentum * native_load<f64>(velocity, i) + local_lr * g
        native_store<f64>(velocity, i, v)
        native_store<f64>(params, i, p - v)
        i = i + 1
    end
end

# ═══════════════════════════════════════════════════════
# Learning Rate Schedulers
# ═══════════════════════════════════════════════════════

func lr_cosine_decay(base_lr: f64, step: usize, total_steps: usize, min_lr: f64) -> f64
    # Cosine annealing: lr = min_lr + 0.5(base - min)(1 + cos(π·t/T))
    if step >= total_steps out min_lr end
    var progress = to_f64(step) / to_f64(total_steps)
    var cos_val = native_cos(progress * 3.14159265358979323846)
    out min_lr + 0.5 * (base_lr - min_lr) * (1.0 + cos_val)
end

func lr_warmup_cosine(base_lr: f64, step: usize, warmup_steps: usize,
                      total_steps: usize, min_lr: f64) -> f64
    # Linear warmup then cosine decay
    if step < warmup_steps
        out base_lr * to_f64(step) / to_f64(warmup_steps)
    end
    out lr_cosine_decay(base_lr, step - warmup_steps, total_steps - warmup_steps, min_lr)
end

func lr_exponential_decay(base_lr: f64, step: usize, decay_rate: f64, decay_steps: usize) -> f64
    # lr = base_lr × decay_rate^(step / decay_steps)
    var exponent = to_f64(step) / to_f64(decay_steps)
    out base_lr * _pow_fast(decay_rate, exponent)
end

# ═══════════════════════════════════════════════════════
# Gradient Clipping
# ═══════════════════════════════════════════════════════

func clip_grad_norm(grads: ptr, n: usize, max_norm: f64) -> f64
    # Clip gradient by global L2 norm. Returns the original norm.
    var total_norm: f64 = 0.0
    var i: usize = 0
    when i < n loop
        var g = native_load<f64>(grads, i)
        total_norm = total_norm + g * g
        i = i + 1
    end
    total_norm = sqrt(total_norm)

    if total_norm > max_norm
        var scale = max_norm / (total_norm + 1e-6)
        i = 0
        when i < n loop
            native_store<f64>(grads, i, native_load<f64>(grads, i) * scale)
            i = i + 1
        end
    end
    out total_norm
end

func clip_grad_value(grads: ptr, n: usize, clip_value: f64)
    # Clamp each gradient to [-clip_value, clip_value].
    var i: usize = 0
    when i < n loop
        var g = native_load<f64>(grads, i)
        if g > clip_value g = clip_value end
        if g < -clip_value g = -clip_value end
        native_store<f64>(grads, i, g)
        i = i + 1
    end
end

# ═══════════════════════════════════════════════════════
# Internal helpers
# ═══════════════════════════════════════════════════════

func _pow_fast(base: f64, exp: f64) -> f64
    # Fast power for small integer-like exponents (β^t).
    # Uses repeated squaring when exp is effectively integer.
    if exp == 0.0 out 1.0 end
    if exp == 1.0 out base end

    # For bias correction, exp is always a positive integer (step count)
    var n = to_i64(exp)
    var result: f64 = 1.0
    var b = base
    when n > 0 loop
        if n mod 2 == 1
            result = result * b
        end
        b = b * b
        n = n / 2
    end
    out result
end

export SGD, sgd_new, sgd_free, sgd_step
export Adam, adam_new, adam_free, adam_step
export VirAdam, viradam_new, viradam_free, viradam_step
export lars_step
export lr_cosine_decay, lr_warmup_cosine, lr_exponential_decay
export clip_grad_norm, clip_grad_value
