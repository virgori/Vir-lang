##
 * vir/math/optim.vri — Gradient-Based Optimizers
 * =================================================
 * Production-grade optimizers for neural network training.
 *
 * Algorithms implemented
 *
 *   1. SGD + Nesterov Momentum
 *      - Classical heavy-ball momentum: v = μv - lr·g, θ += v
 *      - Nesterov lookahead variant for faster convergence
 *
 *   2. Adam (Kingma & Ba, 2014) with fixes
 *      - Decoupled weight decay (AdamW, Loshchilov & Hutter 2019)
 *      - AMSGrad (Reddi et al. 2018) — monotonic v_hat for convergence guarantee
 *      - Bias correction with numerically stable formulation
 *
 *   3. VirAdam — CUSTOM ALGORITHM [Vir-native]
 *      ┌─────────────────────────────────────────────────┐
 *      │ Novel: Dual-rate adaptive with gradient noise    │
 *      │ estimation. Detects gradient signal-to-noise     │
 *      │ ratio (SNR) per-parameter and auto-adjusts:      │
 *      │   - High SNR → aggressive lr (exploit)           │
 *      │   - Low SNR → conservative lr (explore)          │
 *      │ Uses exponential moving variance of gradients    │
 *      │ vs moving mean² to estimate SNR without extra    │
 *      │ backward pass. O(1) extra memory per param.      │
 *      │                                                   │
 *      │ Advantage over Adam: converges faster on noisy   │
 *      │ minibatch gradients, doesn't need lr warmup.     │
 *      │ Advantage over AdaHessian: no Hessian cost.     │
 *      └─────────────────────────────────────────────────┘
 *
 *   4. LARS (Layer-wise Adaptive Rate Scaling)
 *      - Scales lr per-layer by ||θ||/||g|| ratio
 *      - Critical for large-batch training (batch > 8K)
 *
 * Memory: all state buffers are contiguous f64 arrays.
 * In-place param update: θ is modified directly (no copy).
 ##

include types;
include alloc;
import alloc, alloc_zeroed, free from alloc;
include basic;
import abs_f, sqrt, max_f, min_f from basic;
include vector;
import Vector, vec_new, vec_get, vec_set, vec_len from vector;
include vector;
import vec_free, vec_norm2, vec_scale_inplace from vector;

# ═══════════════════════════════════════════════════════
# SGD with Momentum (+ Nesterov)
# ═══════════════════════════════════════════════════════

entity SGD:
    lr:         float     # learning rate,
        momentum:   float     # momentum coefficient μ (0 = no momentum),
        dampening:  float     # dampening for momentum,
        nesterov:   bool    # use Nesterov accelerated gradient,
        weight_decay: float   # L2 regularization,
        velocity:   ptr     # float[n] — momentum buffer,
        n:          int   # number of parameters,
        step_count: int;
end.
func sgd_new:
    in  n: int;
        lr: float;
        momentum: float;
        nesterov: bool;
        weight_decay: float
    vel = alloc_zeroed(n * size_of<float>());
    out SGD {
        lr: lr, momentum: momentum, dampening: 0.0,
        nesterov: nesterov, weight_decay: weight_decay,
        velocity: vel, n: n, step_count: 0
    };
end.
func sgd_free(opt: SGD):
    if opt.velocity != null do free(opt.velocity) end
    opt.velocity = null;
end.
func sgd_step:
    in  opt: SGD;
        params: ptr;
        grads: ptr
    # θ = θ - lr · d_p, where d_p includes momentum + weight decay
    # PyTorch-exact SGD algorithm for compatibility
    opt.step_count = opt.step_count + 1;
    i = 0;
    when i < opt.n loop
        g = native_load<float>(grads, i);
        p = native_load<float>(params, i);

        # Weight decay (L2 penalty)
        if opt.weight_decay > 0.0 do
            g = g + opt.weight_decay * p;
        end

        if opt.momentum > 0.0 do
            v = native_load<float>(opt.velocity, i);
            if opt.step_count > 1 do
                v = opt.momentum * v + (1.0 - opt.dampening) * g;
            else
                v = g;
            end
            native_store<float>(opt.velocity, i, v);

            if opt.nesterov do
                g = g + opt.momentum * v;
            else
                g = v;
            end
        end

        native_store<float>(params, i, p - opt.lr * g);
        i = i + 1;
    end
end.
# ═══════════════════════════════════════════════════════
# Adam / AdamW with AMSGrad
# ═══════════════════════════════════════════════════════

entity Adam:
    lr:         float,
        beta1:      float     # first moment decay (default 0.9),
        beta2:      float     # second moment decay (default 0.999),
        eps:        float     # numerical stability (default 1e-8),
        weight_decay: float   # decoupled weight decay (AdamW),
        amsgrad:    bool    # use AMSGrad variant,
        m:          ptr     # float[n] — first moment (mean of gradients),
        v:          ptr     # float[n] — second moment (mean of gradient²),
        v_max:      ptr     # float[n] — max second moment (AMSGrad only),
        n:          int,
        step_count: int;
end.
func adam_new(n: int, lr: float, beta1: float, beta2: float, eps: float,
             weight_decay: float, amsgrad: bool) -> Adam;
    m_buf = alloc_zeroed(n * size_of<float>());
    v_buf = alloc_zeroed(n * size_of<float>());
    v_max_buf = null;
    if amsgrad do
        v_max_buf = alloc_zeroed(n * size_of<float>());
    end
    out Adam {
        lr: lr, beta1: beta1, beta2: beta2, eps: eps,
        weight_decay: weight_decay, amsgrad: amsgrad,
        m: m_buf, v: v_buf, v_max: v_max_buf,
        n: n, step_count: 0
    };
end.
func adam_free(opt: Adam):
    if opt.m != null do free(opt.m) end
    if opt.v != null do free(opt.v) end
    if opt.v_max != null do free(opt.v_max) end
    opt.m = null;
    opt.v = null;
    opt.v_max = null;
end.
func adam_step:
    in  opt: Adam;
        params: ptr;
        grads: ptr
    opt.step_count = opt.step_count + 1;
    t = to_f64(opt.step_count);

    # Bias correction factors
    bc1 = 1.0 - _pow_fast(opt.beta1, t);
    bc2 = 1.0 - _pow_fast(opt.beta2, t);
    step_size = opt.lr / bc1;

    i = 0;
    when i < opt.n loop
        g = native_load<float>(grads, i);
        p = native_load<float>(params, i);

        # Decoupled weight decay (AdamW)
        if opt.weight_decay > 0.0 do
            p = p - opt.lr * opt.weight_decay * p;
        end

        # Update biased first moment: m = β₁·m + (1-β₁)·g
        mi = opt.beta1 * native_load<float>(opt.m, i) + (1.0 - opt.beta1) * g;
        native_store<float>(opt.m, i, mi);

        # Update biased second moment: v = β₂·v + (1-β₂)·g²
        vi = opt.beta2 * native_load<float>(opt.v, i) + (1.0 - opt.beta2) * g * g;
        native_store<float>(opt.v, i, vi);

        denom = 0.0;
        if opt.amsgrad do
            # AMSGrad: use max of all past v
            vm = native_load<float>(opt.v_max, i);
            if vi > vm do vm = vi end
            native_store<float>(opt.v_max, i, vm);
            denom = sqrt(vm / bc2) + opt.eps;
        else
            denom = sqrt(vi / bc2) + opt.eps;
        end

        native_store<float>(params, i, p - step_size * mi / denom);
        i = i + 1;
    end
end.
# ═══════════════════════════════════════════════════════
# VirAdam — CUSTOM: SNR-Adaptive Optimizer
# ═══════════════════════════════════════════════════════
#
# Novel algorithm: estimates gradient Signal-to-Noise Ratio
# per parameter using exponential moving statistics
#
#   signal = EMA(g)²          ← squared mean gradient
#   noise  = EMA(g²) - signal ← gradient variance
#   SNR_i  = signal / (noise + ε)
#
# Adaptive learning rate per parameter
#   lr_i = lr_base × clip(SNR_i / SNR_target, min_scale, max_scale)
#
# High SNR → gradient is reliable → larger step
# Low SNR  → gradient is noisy → smaller step (don't overshoot)
#
# Advantage: self-tuning — no lr warmup needed, no lr schedule.
# Cost: same as Adam + 1 extra f64 per param (for SNR EMA).

entity VirAdam:
    lr:         float,
        beta1:      float,
        beta2:      float,
        eps:        float,
        weight_decay: float,
        snr_target: float     # target SNR (default 5.0),
        snr_beta:   float     # EMA decay for SNR estimate (default 0.99),
        min_scale:  float     # min lr multiplier (default 0.1),
        max_scale:  float     # max lr multiplier (default 10.0),
        m:          ptr     # float[n] first moment,
        v:          ptr     # float[n] second moment,
        snr_ema:    ptr     # float[n] running SNR estimate,
        n:          int,
        step_count: int;
end.
func viradam_new(n: int, lr: float):
    m_buf = alloc_zeroed(n * size_of<float>());
    v_buf = alloc_zeroed(n * size_of<float>());
    snr_buf = alloc_zeroed(n * size_of<float>());
    out VirAdam (
        lr: lr, beta1: 0.9, beta2: 0.999, eps: 1e-8,
        weight_decay: 0.01, snr_target: 5.0, snr_beta: 0.99,
        min_scale: 0.1, max_scale: 10.0,
        m: m_buf, v: v_buf, snr_ema: snr_buf,
        n: n, step_count: 0
    );
end.
func viradam_free(opt: VirAdam):
    if opt.m != null do free(opt.m) end
    if opt.v != null do free(opt.v) end
    if opt.snr_ema != null do free(opt.snr_ema) end
    opt.m = null;
    opt.v = null;
    opt.snr_ema = null;
end.
func viradam_step:
    in  opt: VirAdam;
        params: ptr;
        grads: ptr
    opt.step_count = opt.step_count + 1;
    t = to_f64(opt.step_count);
    bc1 = 1.0 - _pow_fast(opt.beta1, t);
    bc2 = 1.0 - _pow_fast(opt.beta2, t);

    i = 0;
    when i < opt.n loop
        g = native_load<float>(grads, i);
        p = native_load<float>(params, i);

        # Decoupled weight decay
        if opt.weight_decay > 0.0 do
            p = p - opt.lr * opt.weight_decay * p;
        end

        # Standard Adam moments
        mi = opt.beta1 * native_load<float>(opt.m, i) + (1.0 - opt.beta1) * g;
        vi = opt.beta2 * native_load<float>(opt.v, i) + (1.0 - opt.beta2) * g * g;
        native_store<float>(opt.m, i, mi);
        native_store<float>(opt.v, i, vi);

        # Bias-corrected moments
        m_hat = mi / bc1;
        v_hat = vi / bc2;

        # ── SNR estimation ──
        # signal = m_hat², noise = v_hat - m_hat²
        signal = m_hat * m_hat;
        noise = v_hat - signal;
        if noise < opt.eps do noise = opt.eps end
        snr = signal / noise;

        # EMA of SNR for stability
        snr_prev = native_load<float>(opt.snr_ema, i);
        snr_smooth = opt.snr_beta * snr_prev + (1.0 - opt.snr_beta) * snr;
        native_store<float>(opt.snr_ema, i, snr_smooth);

        # Adaptive lr scale
        scale = snr_smooth / opt.snr_target;
        if scale < opt.min_scale do scale = opt.min_scale end
        if scale > opt.max_scale do scale = opt.max_scale end

        lr_i = opt.lr * scale;
        step = lr_i * m_hat / (sqrt(v_hat) + opt.eps);

        native_store<float>(params, i, p - step);
        i = i + 1;
    end
end.
# ═══════════════════════════════════════════════════════
# LARS — Layer-wise Adaptive Rate Scaling
# ═══════════════════════════════════════════════════════
#
# For large-batch training. Scales lr per layer
#   local_lr = trust × ||θ|| / (||g|| + λ||θ||)
#
# This prevents layers with small weights from getting
# disproportionately large updates.

func lars_step(params: ptr, grads: ptr, n: int,
               lr: float, momentum: float, weight_decay: float,
               trust: float, velocity: ptr);
    # Compute ||params|| and ||grads||
    p_norm = 0.0;
    g_norm = 0.0;
    i = 0;
    when i < n loop
        p = native_load<float>(params, i);
        g = native_load<float>(grads, i);
        p_norm = p_norm + p * p;
        g_norm = g_norm + g * g;
        i = i + 1;
    end
    p_norm = sqrt(p_norm);
    g_norm = sqrt(g_norm);

    # Local learning rate
    local_lr = lr;
    if p_norm > 0.0 and g_norm > 0.0 do
        local_lr = lr * trust * p_norm / (g_norm + weight_decay * p_norm);
    end

    # SGD with momentum using local_lr
    i = 0;
    when i < n loop
        g = native_load<float>(grads, i);
        p = native_load<float>(params, i);
        if weight_decay > 0.0 do
            g = g + weight_decay * p;
        end
        v = momentum * native_load<float>(velocity, i) + local_lr * g;
        native_store<float>(velocity, i, v);
        native_store<float>(params, i, p - v);
        i = i + 1;
    end
end.
# ═══════════════════════════════════════════════════════
# Learning Rate Schedulers
# ═══════════════════════════════════════════════════════

func lr_cosine_decay:
    in  base_lr: float;
        step: int;
        total_steps: int;
        min_lr: float
    # Cosine annealing: lr = min_lr + 0.5(base - min)(1 + cos(π·t/T))
    if step >= total_steps do out min_lr end
    progress = to_f64(step) / to_f64(total_steps);
    cos_val = native_cos(progress * 3.14159265358979323846);
    out min_lr + 0.5 * (base_lr - min_lr) * (1.0 + cos_val);
end.
func lr_warmup_cosine(base_lr: float, step: int, warmup_steps: int,
                      total_steps: int, min_lr: float) -> float;
    # Linear warmup then cosine decay
    if step < warmup_steps do
        out base_lr * to_f64(step) / to_f64(warmup_steps);
    end
    out lr_cosine_decay(base_lr, step - warmup_steps, total_steps - warmup_steps, min_lr);
end.
func lr_exponential_decay:
    in  base_lr: float;
        step: int;
        decay_rate: float;
        decay_steps: int
    # lr = base_lr × decay_rate^(step / decay_steps)
    exponent = to_f64(step) / to_f64(decay_steps);
    out base_lr * _pow_fast(decay_rate, exponent);
end.
# ═══════════════════════════════════════════════════════
# Gradient Clipping
# ═══════════════════════════════════════════════════════

func clip_grad_norm:
    in  grads: ptr;
        n: int;
        max_norm: float
    # Clip gradient by global L2 norm. Returns the original norm.
    total_norm = 0.0;
    i = 0;
    when i < n loop
        g = native_load<float>(grads, i);
        total_norm = total_norm + g * g;
        i = i + 1;
    end
    total_norm = sqrt(total_norm);

    if total_norm > max_norm do
        scale = max_norm / (total_norm + 1e-6);
        i = 0;
        when i < n loop
            native_store<float>(grads, i, native_load<float>(grads, i) * scale);
            i = i + 1;
        end
    end
    out total_norm;
end.
func clip_grad_value:
    in  grads: ptr;
        n: int;
        clip_value: float
    # Clamp each gradient to [-clip_value, clip_value].
    i = 0;
    when i < n loop
        g = native_load<float>(grads, i);
        if g > clip_value do g = clip_value end
        if g < -clip_value do g = -clip_value end
        native_store<float>(grads, i, g);
        i = i + 1;
    end
end.
# ═══════════════════════════════════════════════════════
# Internal helpers
# ═══════════════════════════════════════════════════════

func _pow_fast(base: float, exp: float):
    # Fast power for small integer-like exponents (β^t).
    # Uses repeated squaring when exp is effectively integer.
    if exp == 0.0 do out 1.0 end
    if exp == 1.0 do out base end

    # For bias correction, exp is always a positive integer (step count)
    n = to_i64(exp);
    result = 1.0;
    b = base;
    when n > 0 loop
        if n mod 2 == 1 do
            result = result * b;
        end
        b = b * b;
        n = n / 2;
    end
    out result;
end.
export SGD, sgd_new, sgd_free, sgd_step;
export Adam, adam_new, adam_free, adam_step;
export VirAdam, viradam_new, viradam_free, viradam_step;
export lars_step;
export lr_cosine_decay, lr_warmup_cosine, lr_exponential_decay;
export clip_grad_norm, clip_grad_value;
