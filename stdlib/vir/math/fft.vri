##
 * vir/math/fft.vri — Fast Fourier Transform (Cooley-Tukey)
 * =========================================================
 * Inspired by Rust: rustfft, realfft crates
 * Inspired by Python: numpy.fft
 * Inspired by Go: mjibson/go-dsp
 *
 * Phase C — Tier 2: Radix-2 DIT FFT for power-of-two lengths.
 * Uses fixed-point complex arithmetic via math/complex.
 * All values scaled by SCALE=1_000_000.
 ##

include types;
include vec;
import Vec, vec_new, vec_push, vec_get, vec_set, vec_len from vec;
include math/complex;
import Complex, complex_new, complex_from_scaled, complex_zero, complex_add,
       complex_sub, complex_mul, complex_conj, complex_neg,
       complex_abs, complex_re_scaled, complex_im_scaled, SCALE from math/complex;

# ═══════════════════════════════════════════════════════
# Precomputed twiddle factors
# ═══════════════════════════════════════════════════════

# sin/cos table for common angles (scaled by SCALE)
# We store cos and sin for 2*pi*k/N via rational approximation

# Integer cosine approximation: cos(2*pi*k/N) * SCALE
# Using the identity: cos(x) ≈ 1 - x^2/2 + x^4/24 (Taylor)
# where x = 2*pi*k/N

# PI scaled: 3_141_593
const PI_S = 3141593;

func _cos_scaled(angle_s: int):
    # angle_s is in micro-radians (angle * SCALE)
    # cos(x) ≈ 1 - x²/2 + x⁴/24
    # Scale management: x_s = angle * SCALE
    # x² = x_s² / SCALE
    x2 = (angle_s * angle_s) / SCALE;
    x4 = (x2 * x2) / SCALE;
    out SCALE - x2 / 2 + x4 / 24;
end.
func _sin_scaled(angle_s: int):
    # sin(x) ≈ x - x³/6 + x⁵/120
    x2 = (angle_s * angle_s) / SCALE;
    x3 = (x2 * angle_s) / SCALE;
    x5 = (x3 * x2) / SCALE;
    out angle_s - x3 / 6 + x5 / 120;
end.
# ═══════════════════════════════════════════════════════
# Bit-reversal permutation
# ═══════════════════════════════════════════════════════

func _bit_reverse(x: int, bits: int):
    result = 0;
    val = x;
    i = 0;
    when i < bits loop
        result = result * 2 + val - (val / 2) * 2;
        val = val / 2;
        i = i + 1;
    end
    out result;
end.
func _log2(n: int):
    result = 0;
    val = n;
    when val > 1 loop
        val = val / 2;
        result = result + 1;
    end
    out result;
end.
func _is_power_of_2(n: int):
    if n <= 0 do out false end
    # n & (n-1) == 0, but no bitwise ops — check divisibility
    val = n;
    when val > 1 loop
        half = val / 2;
        if val - half * 2 != 0 do out false end
        val = half;
    end
    out true;
end.
# ═══════════════════════════════════════════════════════
# FFT (in-place, Cooley-Tukey radix-2 DIT)
# ═══════════════════════════════════════════════════════

func fft(data: Vec):
    # data is Vec<Complex>, length must be power of 2
    n = vec_len(data);
    bits = _log2(n);

    # Bit-reversal permutation
    i = 0;
    when i < n loop
        j = _bit_reverse(i, bits);
        if i < j do
            tmp = vec_get(data, i);
            vec_set(data, i, vec_get(data, j));
            vec_set(data, j, tmp);
        end
        i = i + 1;
    end

    # Butterfly stages
    stage = 1;
    when stage <= bits loop
        m = 1;
        s = 0;
        when s < stage loop
            m = m * 2;
            s = s + 1;
        end
        half_m = m / 2;

        # Twiddle: W_m^k = exp(-2*pi*i*k/m)
        k = 0;
        when k < half_m loop
            # angle = -2 * pi * k / m (in scaled units)
            angle_s = (0 - 2 * PI_S * k) / m;
            w_re = _cos_scaled(angle_s);
            w_im = _sin_scaled(angle_s);
            w = complex_from_scaled(w_re, w_im);

            j2 = k;
            when j2 < n loop
                t = complex_mul(w, vec_get(data, j2 + half_m));
                u = vec_get(data, j2);
                vec_set(data, j2, complex_add(u, t));
                vec_set(data, j2 + half_m, complex_sub(u, t));
                j2 = j2 + m;
            end
            k = k + 1;
        end
        stage = stage + 1;
    end
end.
# ═══════════════════════════════════════════════════════
# Inverse FFT
# ═══════════════════════════════════════════════════════

func ifft(data: Vec):
    n = vec_len(data);

    # Conjugate
    i = 0;
    when i < n loop
        z = vec_get(data, i);
        vec_set(data, i, complex_conj(z));
        i = i + 1;
    end

    # Forward FFT
    fft(data);

    # Conjugate and scale by 1/N
    i = 0;
    when i < n loop
        z = vec_get(data, i);
        c = complex_conj(z);
        scaled = complex_from_scaled(
            complex_re_scaled(c) / n,
            complex_im_scaled(c) / n
        );
        vec_set(data, i, scaled);
        i = i + 1;
    end
end.
# ═══════════════════════════════════════════════════════
# Helper: create signal from integer samples
# ═══════════════════════════════════════════════════════

func fft_from_real(samples: Vec):
    result = vec_new();
    i = 0;
    when i < vec_len(samples) loop
        val = vec_get(samples, i);
        vec_push(result, complex_new(val, 0));
        i = i + 1;
    end
    out result;
end.
func fft_magnitudes(data: Vec):
    result = vec_new();
    i = 0;
    when i < vec_len(data) loop
        z = vec_get(data, i);
        vec_push(result, complex_abs(z));
        i = i + 1;
    end
    out result;
end.
# ═══════════════════════════════════════════════════════
# Convolution via FFT
# ═══════════════════════════════════════════════════════

func fft_convolve(a: Vec, b: Vec):
    # Convolution theorem: conv(a,b) = IFFT(FFT(a) * FFT(b))
    n = vec_len(a);

    fft(a);
    fft(b);

    result = vec_new();
    i = 0;
    when i < n loop
        prod = complex_mul(vec_get(a, i), vec_get(b, i));
        vec_push(result, prod);
        i = i + 1;
    end

    ifft(result);
    out result;
end.
# ═══════════════════════════════════════════════════════
# Power spectrum
# ═══════════════════════════════════════════════════════

func fft_power_spectrum(data: Vec):
    result = vec_new();
    i = 0;
    when i < vec_len(data) loop
        z = vec_get(data, i);
        re = complex_re_scaled(z);
        im = complex_im_scaled(z);
        power = (re * re + im * im) / SCALE;
        vec_push(result, power);
        i = i + 1;
    end
    out result;
end.