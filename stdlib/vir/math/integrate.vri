##
 * vir/math/integrate.vri — Numerical Integration
 * =================================================
 * Inspired by: SciPy integrate, Boost.Math
 *
 * Trapezoidal rule, Simpson's rule, adaptive Simpson,
 * Gauss-Legendre quadrature (5-point), Romberg integration.
 ##

include types;
include math;
import abs, sqrt from math;

# ═══════════════════════════════════════════════════════
# Trapezoidal Rule
# ═══════════════════════════════════════════════════════

func integrate_trapezoidal:
    in(f: func(float) float; a: float; b: float; n: int)
    h = (b - a) / int_to_float(n);
    s = (f(a) + f(b)) / 2.0;
    i = 1;
    when i < n loop
        x = a + int_to_float(i) * h;
        s = s + f(x);
        i = i + 1;
    end
    out s * h;
end

# ═══════════════════════════════════════════════════════
# Simpson's Rule (composite)
# ═══════════════════════════════════════════════════════

func integrate_simpson:
    in(f: func(float) float; a: float; b: float; n: int)
    # n must be even
    steps = n;
    if steps % 2 == 1 do
        steps = steps + 1;
    end
    h = (b - a) / int_to_float(steps);
    s = f(a) + f(b);
    i = 1;
    when i < steps loop
        x = a + int_to_float(i) * h;
        if i % 2 == 0 do
            s = s + 2.0 * f(x);
        else
            s = s + 4.0 * f(x);
        end
        i = i + 1;
    end
    out s * h / 3.0;
end

# ═══════════════════════════════════════════════════════
# Adaptive Simpson's Rule
# ═══════════════════════════════════════════════════════

func _simpson_single:
    in(f: func(float) float; a: float; b: float)
    h = b - a;
    mid = (a + b) / 2.0;
    out (h / 6.0) * (f(a) + 4.0 * f(mid) + f(b));
end.

func _adaptive_simpson_rec:
    in(f: func(float) float; a: float; b: float; eps: float,
        whole: float; fa: float; fb: float; fm: float; depth: int)
    mid = (a + b) / 2.0;
    lm = (a + mid) / 2.0;
    rm = (mid + b) / 2.0;
    flm = f(lm);
    frm = f(rm);
    h = b - a;
    left  = (h / 12.0) * (fa + 4.0 * flm + fm);
    right = (h / 12.0) * (fm + 4.0 * frm + fb);
    combined = left + right;
    error = (combined - whole) / 15.0;
    if depth <= 0 do
        out combined + error;
    end
    err_abs = error;
    if err_abs < 0.0 do
        err_abs = 0.0 - err_abs;
    end
    if err_abs <= eps do
        out combined + error;
    end
    l = _adaptive_simpson_rec(f, a, mid, eps / 2.0, left, fa, fm, flm, depth - 1);
    r = _adaptive_simpson_rec(f, mid, b, eps / 2.0, right, fm, fb, frm, depth - 1);
    out l + r;
end.

func integrate_adaptive_simpson:
    in(f: func(float) float; a: float; b: float; eps: float)
    fa = f(a);
    fb = f(b);
    fm = f((a + b) / 2.0);
    whole = _simpson_single(f, a, b);
    out _adaptive_simpson_rec(f, a, b, eps, whole, fa, fb, fm, 20);
end

# ═══════════════════════════════════════════════════════
# Gauss-Legendre 5-point Quadrature
# ═══════════════════════════════════════════════════════

func integrate_gauss5:
    in(f: func(float) float; a: float; b: float)
    # Nodes and weights for [-1,1] mapped to [a,b]
    # Nodes: ±0.90618, ±0.53847, 0
    # Weights: 0.23693, 0.47863, 0.56889
    mid = (a + b) / 2.0;
    half = (b - a) / 2.0;

    # Node 0: x=0, w=0.5688888889
    s = 0.5688888889 * f(mid);

    # Nodes ±0.5384693101
    x1 = 0.5384693101;
    w1 = 0.4786286705;
    s = s + w1 * (f(mid + half * x1) + f(mid - half * x1));

    # Nodes ±0.9061798459
    x2 = 0.9061798459;
    w2 = 0.2369268851;
    s = s + w2 * (f(mid + half * x2) + f(mid - half * x2));

    out s * half;
end

# ═══════════════════════════════════════════════════════
# Romberg Integration
# ═══════════════════════════════════════════════════════

func integrate_romberg:
    in(f: func(float) float; a: float; b: float; max_order: int)
    # R[i][j] table stored flat: R[i * (max_order+1) + j]
    size = max_order + 1;
    r_table = vec_new();
    i = 0;
    when i < size * size loop
        vec_push(r_table, 0.0);
        i = i + 1;
    end

    # R[0][0] = trapezoidal with n=1
    h = b - a;
    _romberg_set(r_table, size, 0, 0, h * (f(a) + f(b)) / 2.0);

    k = 1;
    when k <= max_order loop
        # Trapezoidal with 2^k intervals
        n = 1;
        p = 0;
        when p < k loop
            n = n * 2;
            p = p + 1;
        end
        h = (b - a) / int_to_float(n);
        s = 0.0;
        i = 1;
        when i < n loop
            if i % 2 == 1 do
                s = s + f(a + int_to_float(i) * h);
            end
            i = i + 1;
        end
        prev = _romberg_get(r_table, size, k - 1, 0);
        _romberg_set(r_table, size, k, 0, prev / 2.0 + h * s);

        # Richardson extrapolation
        j = 1;
        when j <= k loop
            pow4j = 1;
            p = 0;
            when p < j loop
                pow4j = pow4j * 4;
                p = p + 1;
            end
            rk_j1 = _romberg_get(r_table, size, k, j - 1);
            rk1_j1 = _romberg_get(r_table, size, k - 1, j - 1);
            val = (int_to_float(pow4j) * rk_j1 - rk1_j1) / int_to_float(pow4j - 1);
            _romberg_set(r_table, size, k, j, val);
            j = j + 1;
        end
        k = k + 1;
    end

    out _romberg_get(r_table, size, max_order, max_order);
end.

func _romberg_get:
    in(table: Vec; size: int; i: int; j: int)
    out vec_get(table, i * size + j);
end.

func _romberg_set:
    in(table: Vec; size: int; i: int; j: int; val: float)
    vec_set(table, i * size + j, val);
end

# ═══════════════════════════════════════════════════════
# Midpoint Rule (simple)
# ═══════════════════════════════════════════════════════

func integrate_midpoint:
    in(f: func(float) float; a: float; b: float; n: int)
    h = (b - a) / int_to_float(n);
    s = 0.0;
    i = 0;
    when i < n loop
        x = a + (int_to_float(i) + 0.5) * h;
        s = s + f(x);
        i = i + 1;
    end
    out s * h;
end
