##
 * vir/math/grad.vri — Reverse-Mode Automatic Differentiation
 * ============================================================
 * Tape-based reverse-mode AD (backpropagation) engine.
 *
 * Architecture
 *   1. Each Scalar wraps a value + a tape index
 *   2. Forward pass records operations onto a Tape
 *   3. backward() replays tape in reverse, accumulating gradients
 *
 * Supported ops: add, sub, mul, div, neg, pow, exp, log,
 *                sqrt, sin, cos, tanh, relu, sigmoid
 *
 * Optimization strategy
 *   - Arena-style tape allocation: one contiguous buffer, no per-node alloc
 *   - Gradient array = single alloc_zeroed, cache-line friendly
 *   - Fan-out sharing: gradients accumulate (+=), correct for DAGs
 *   - Dead-node pruning: skip zero-gradient nodes during backward
 *
 * Usage pattern
 *   var tape = tape_new(256)
 *   var x = scalar(tape, 3.0)
 *   var y = scalar(tape, 4.0)
 *   var z = ad_mul(tape, ad_add(tape, x, y), x)  # z = (x+y)*x
 *   backward(tape, z)
 *   var dz_dx = grad(tape, x)   # ∂z/∂x = 2x + y = 10
 *   var dz_dy = grad(tape, y)   # ∂z/∂y = x = 3
 *   tape_free(&tape)
 ##

include types;
include alloc;
import alloc, alloc_zeroed, free, realloc from alloc;
include basic;
import abs_f, sqrt, exp, log, sin, cos, pow from basic;

# ═══════════════════════════════════════════════════════
# Op Codes
# ═══════════════════════════════════════════════════════

const OP_CONST: 0;
const OP_ADD: 1;
const OP_SUB: 2;
const OP_MUL: 3;
const OP_DIV: 4;
const OP_NEG: 5;
const OP_POW: 6;
const OP_EXP: 7;
const OP_LOG: 8;
const OP_SQRT: 9;
const OP_SIN: 10;
const OP_COS: 11;
const OP_TANH: 12;
const OP_RELU: 13;
const OP_SIGMOID: 14;

# Sentinel: no parent
const NO_PARENT: -1;

# ═══════════════════════════════════════════════════════
# Tape Node
# ═══════════════════════════════════════════════════════

entity TapeNode:
    op:    int      # OP_* constant,
        val:   float      # computed value (forward pass),
        lhs:   int      # left parent index  (or NO_PARENT),
        rhs:   int      # right parent index (or NO_PARENT);
end.

# ═══════════════════════════════════════════════════════
# Tape (computation graph)
# ═══════════════════════════════════════════════════════

entity Tape:
    nodes: ptr      # ptr to TapeNode[cap],
        grads: ptr      # ptr to float[cap]  — gradient accumulator,
        len:   int    # number of recorded nodes,
        cap:   int    # allocated capacity;
end.
func tape_new(initial_cap: int):
    cap = initial_cap;
    if cap < 64 do cap = 64 end
    nodes = alloc_zeroed(cap * size_of<TapeNode>());
    grads = alloc_zeroed(cap * size_of<float>());
    out Tape ( nodes: nodes, grads: grads, len: 0, cap: cap );
end.
func tape_free(t: Tape):
    if t.nodes != null do free(t.nodes) end
    if t.grads != null do free(t.grads) end
    t.nodes = null;
    t.grads = null;
    t.len = 0;
    t.cap = 0;
end.
func tape_reset(t: Tape):
    # Reuse allocated memory, just reset length and zero grads.
    t.len = 0;
    i = 0;
    when i < t.cap loop
        native_store<float>(t.grads, i, 0.0);
        i = i + 1;
    end
end.
func _tape_grow(t: Tape):
    new_cap = t.cap * 2;
    t.nodes = realloc(t.nodes, new_cap * size_of<TapeNode>());
    t.grads = realloc(t.grads, new_cap * size_of<float>());
    # Zero new gradient slots
    i = t.cap;
    when i < new_cap loop
        native_store<float>(t.grads, i, 0.0);
        i = i + 1;
    end
    t.cap = new_cap;
end.
func _tape_push:
    in  t: Tape;
        op: int;
        val: float;
        lhs: int;
        rhs: int
    if t.len >= t.cap do _tape_grow(t) end
    idx = t.len;
    node = TapeNode ( op: op, val: val, lhs: lhs, rhs: rhs );
    native_store<TapeNode>(t.nodes, idx, node);
    native_store<float>(t.grads, idx, 0.0);
    t.len = t.len + 1;
    out to_i32(idx);
end.
# ═══════════════════════════════════════════════════════
# Scalar Handle
# ═══════════════════════════════════════════════════════

entity Scalar:
    idx: int        # index into Tape.nodes;
end.
func scalar(t: Tape, val: float):
    # Create a leaf variable (input parameter).
    idx = _tape_push(t, OP_CONST, val, NO_PARENT, NO_PARENT);
    out Scalar ( idx: idx );
end.
func scalar_val(t: Tape, s: Scalar):
    out native_load<TapeNode>(t.nodes, to_usize(s.idx)).val;
end.
func grad(t: Tape, s: Scalar):
    out native_load<float>(t.grads, to_usize(s.idx));
end.
# ═══════════════════════════════════════════════════════
# Forward Operations — record on tape
# ═══════════════════════════════════════════════════════

func ad_add:
    in  t: Tape;
        a: Scalar;
        b: Scalar
    va = scalar_val(*t, a);
    vb = scalar_val(*t, b);
    idx = _tape_push(t, OP_ADD, va + vb, a.idx, b.idx);
    out Scalar ( idx: idx );
end.
func ad_sub:
    in  t: Tape;
        a: Scalar;
        b: Scalar
    va = scalar_val(*t, a);
    vb = scalar_val(*t, b);
    idx = _tape_push(t, OP_SUB, va - vb, a.idx, b.idx);
    out Scalar ( idx: idx );
end.
func ad_mul:
    in  t: Tape;
        a: Scalar;
        b: Scalar
    va = scalar_val(*t, a);
    vb = scalar_val(*t, b);
    idx = _tape_push(t, OP_MUL, va * vb, a.idx, b.idx);
    out Scalar ( idx: idx );
end.
func ad_div:
    in  t: Tape;
        a: Scalar;
        b: Scalar
    va = scalar_val(*t, a);
    vb = scalar_val(*t, b);
    idx = _tape_push(t, OP_DIV, va / vb, a.idx, b.idx);
    out Scalar ( idx: idx );
end.
func ad_neg(t: Tape, a: Scalar):
    va = scalar_val(*t, a);
    idx = _tape_push(t, OP_NEG, -va, a.idx, NO_PARENT);
    out Scalar ( idx: idx );
end.
func ad_pow:
    in  t: Tape;
        a: Scalar;
        b: Scalar
    va = scalar_val(*t, a);
    vb = scalar_val(*t, b);
    idx = _tape_push(t, OP_POW, pow(va, vb), a.idx, b.idx);
    out Scalar ( idx: idx );
end.
func ad_exp(t: Tape, a: Scalar):
    va = scalar_val(*t, a);
    idx = _tape_push(t, OP_EXP, exp(va), a.idx, NO_PARENT);
    out Scalar ( idx: idx );
end.
func ad_log(t: Tape, a: Scalar):
    va = scalar_val(*t, a);
    idx = _tape_push(t, OP_LOG, log(va), a.idx, NO_PARENT);
    out Scalar ( idx: idx );
end.
func ad_sqrt(t: Tape, a: Scalar):
    va = scalar_val(*t, a);
    idx = _tape_push(t, OP_SQRT, sqrt(va), a.idx, NO_PARENT);
    out Scalar ( idx: idx );
end.
func ad_sin(t: Tape, a: Scalar):
    va = scalar_val(*t, a);
    idx = _tape_push(t, OP_SIN, sin(va), a.idx, NO_PARENT);
    out Scalar ( idx: idx );
end.
func ad_cos(t: Tape, a: Scalar):
    va = scalar_val(*t, a);
    idx = _tape_push(t, OP_COS, cos(va), a.idx, NO_PARENT);
    out Scalar ( idx: idx );
end.
func ad_tanh(t: Tape, a: Scalar):
    va = scalar_val(*t, a);
    e2x = exp(2.0 * va);
    idx = _tape_push(t, OP_TANH, (e2x - 1.0) / (e2x + 1.0), a.idx, NO_PARENT);
    out Scalar ( idx: idx );
end.
func ad_relu(t: Tape, a: Scalar):
    va = scalar_val(*t, a);
    val = 0.0;
    if va > 0.0 do val = va end
    idx = _tape_push(t, OP_RELU, val, a.idx, NO_PARENT);
    out Scalar ( idx: idx );
end.
func ad_sigmoid(t: Tape, a: Scalar):
    va = scalar_val(*t, a);
    s = 1.0 / (1.0 + exp(-va));
    idx = _tape_push(t, OP_SIGMOID, s, a.idx, NO_PARENT);
    out Scalar ( idx: idx );
end.
# ═══════════════════════════════════════════════════════
# Backward Pass — Reverse-Mode AD
# ═══════════════════════════════════════════════════════

func backward(t: Tape, output: Scalar):
    # Seed the output gradient with 1.0
    native_store<float>(t.grads, to_usize(output.idx), 1.0);

    # Walk tape in reverse order
    i = to_i64(t.len);
    when i > 0 loop
        i = i - 1;
        idx = to_usize(i);
        g = native_load<float>(t.grads, idx);

        # Skip zero gradients (dead-node pruning)
        if abs_f(g) < 1e-30 do skip end

        node = native_load<TapeNode>(t.nodes, idx);

        if node.op == OP_ADD do
            # d(a+b)/da = 1, d(a+b)/db = 1
            _accum_grad(t, node.lhs, g);
            _accum_grad(t, node.rhs, g);
        end

        if node.op == OP_SUB do
            _accum_grad(t, node.lhs, g);
            _accum_grad(t, node.rhs, -g);
        end

        if node.op == OP_MUL do
            va = _node_val(t, node.lhs);
            vb = _node_val(t, node.rhs);
            _accum_grad(t, node.lhs, g * vb);
            _accum_grad(t, node.rhs, g * va);
        end

        if node.op == OP_DIV do
            va = _node_val(t, node.lhs);
            vb = _node_val(t, node.rhs);
            _accum_grad(t, node.lhs, g / vb);
            _accum_grad(t, node.rhs, -g * va / (vb * vb));
        end

        if node.op == OP_NEG do
            _accum_grad(t, node.lhs, -g);
        end

        if node.op == OP_POW do
            # d(a^b)/da = b * a^(b-1)
            # d(a^b)/db = a^b * ln(a)
            va = _node_val(t, node.lhs);
            vb = _node_val(t, node.rhs);
            _accum_grad(t, node.lhs, g * vb * pow(va, vb - 1.0));
            _accum_grad(t, node.rhs, g * node.val * log(va));
        end

        if node.op == OP_EXP do
            _accum_grad(t, node.lhs, g * node.val);
        end

        if node.op == OP_LOG do
            va = _node_val(t, node.lhs);
            _accum_grad(t, node.lhs, g / va);
        end

        if node.op == OP_SQRT do
            _accum_grad(t, node.lhs, g / (2.0 * node.val));
        end

        if node.op == OP_SIN do
            va = _node_val(t, node.lhs);
            _accum_grad(t, node.lhs, g * cos(va));
        end

        if node.op == OP_COS do
            va = _node_val(t, node.lhs);
            _accum_grad(t, node.lhs, -g * sin(va));
        end

        if node.op == OP_TANH do
            # d/dx tanh(x) = 1 - tanh²(x)
            _accum_grad(t, node.lhs, g * (1.0 - node.val * node.val));
        end

        if node.op == OP_RELU do
            va = _node_val(t, node.lhs);
            if va > 0.0 do
                _accum_grad(t, node.lhs, g);
            end
        end

        if node.op == OP_SIGMOID do
            # d/dx σ(x) = σ(x)(1 - σ(x))
            _accum_grad(t, node.lhs, g * node.val * (1.0 - node.val));
        end
    end
end.
func _accum_grad:
    in  t: Tape;
        idx: int;
        dg: float
    if idx == NO_PARENT do out end
    ui = to_usize(idx);
    native_store<float>(t.grads, ui, native_load<float>(t.grads, ui) + dg);
end.
func _node_val(t: Tape, idx: int):
    out native_load<TapeNode>(t.nodes, to_usize(idx)).val;
end.
# ═══════════════════════════════════════════════════════
# Higher-Level Convenience
# ═══════════════════════════════════════════════════════

func ad_mse_loss:
    in  t: Tape;
        pred: Scalar;
        target: Scalar
    # Mean squared error: (pred - target)²
    diff = ad_sub(t, pred, target);
    out ad_mul(t, diff, diff);
end.
func ad_cross_entropy:
    in  t: Tape;
        pred: Scalar;
        target: Scalar
    # Binary cross-entropy: -[target * log(pred) + (1 - target) * log(1 - pred)]
    one = scalar(t, 1.0);
    term1 = ad_mul(t, target, ad_log(t, pred));
    term2 = ad_mul(t, ad_sub(t, one, target), ad_log(t, ad_sub(t, one, pred)));
    out ad_neg(t, ad_add(t, term1, term2));
end.
func ad_softplus(t: Tape, a: Scalar):
    # softplus(x) = log(1 + exp(x))
    one = scalar(t, 1.0);
    out ad_log(t, ad_add(t, one, ad_exp(t, a)));
end.
func ad_swish(t: Tape, a: Scalar):
    # swish(x) = x * sigmoid(x)
    out ad_mul(t, a, ad_sigmoid(t, a));
end.
# ═══════════════════════════════════════════════════════
# Gradient Utilities
# ═══════════════════════════════════════════════════════

func numerical_grad:
    in  t: Tape;
        f: func(&Tape; Scalar) # Central difference: [f(x+h) - f(x-h)] / 2h # Useful for verifying AD correctness. tape_reset(t);
        xp = scalar(t, x_val + h);
        yp = f(t, xp);
        tape_reset(t);
        xm = scalar(t, x_val - h);
        ym = f(t, xm);
        out (scalar_val(*t, yp) - scalar_val(*t, ym)) / (2.0 * h);
        end
        func zero_grads(t: Tape):
            # Zero all gradient accumulators without resetting the tape. i = 0;
        when i < t.len loop native_store<float>(t.grads, i, 0.0
