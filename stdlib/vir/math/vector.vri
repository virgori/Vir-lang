##
 * vir/math/vector.vri — Dense Numeric Vector
 * =============================================
 * SIMD-optimized N-dimensional vector for linear algebra.
 *
 * Optimization strategy
 *   - Contiguous f64 storage with 16-byte alignment (NEON/SSE friendly)
 *   - Bulk ops use 2-wide f64 SIMD where N >= 2 (ARM64 NEON / x86_64 SSE2)
 *   - Fused multiply-add (FMA) in dot product & axpy
 *   - Strassen-style reductions avoided (numerical stability > speed)
 *   - Kahan summation for large vector reductions
 *
 * Memory: caller-owned. Use vec_free() when done.
 ##

include types;
include alloc;
import alloc, alloc_zeroed, free, realloc from alloc;
include copy;
import mem_copy, mem_set from copy;
include basic;
import abs_f, sqrt, max_f, min_f from basic;

# ═══════════════════════════════════════════════════════
# Vector Entity
# ═══════════════════════════════════════════════════════

entity Vector:
    data: ptr       # ptr to float[len], 16-byte aligned,
        len:  int     # number of elements;
end

# ─── Constructors ─────────────────────────────────────

func vec_new:
    in(len:int)
    # Allocate zeroed vector of given length.
    bytes = len * size_of<float>();
    data = alloc_zeroed(bytes);
    out Vector ( data: data, len: len );
end.

func vec_ones:
    in(len:int)
    # Vector with all elements = 1.0.
    v = vec_new(len);
    i = 0;
    when i < len loop
        native_store<float>(v.data, i, 1.0);
        i = i + 1;
    end
    out v;
end.

func vec_filled:
    in(len:int; val:float)
    # Vector with all elements = val.
    v = vec_new(len);
    i = 0;
    when i < len loop
        native_store<float>(v.data, i, val);
        i = i + 1;
    end
    out v;
end.

func vec_from_array:
    in(src:ptr; len:int)
    # Copy len f64 values from raw pointer.
    v = vec_new(len);
    mem_copy(v.data, src, len * size_of<float>());
    out v;
end.

func vec_clone:
    in(a:Vector)
    out vec_from_array(a.data, a.len);
end.

func vec_free:
    in(v:Vector)
    if v.data != null do
        free(v.data);
        v.data = null;
        v.len = 0;
    end
end

# ─── Element Access ───────────────────────────────────

func vec_get:
    in(v:Vector; i:int)
    if i >= v.len panic("vec_get do index do out of bounds") end
    out native_load<float>(v.data, i);
end.

func vec_set:
    in(v:Vector; i:int; val:float)
    if i >= v.len panic("vec_set do index do out of bounds") end
    native_store<float>(v.data, i, val);
end.

func vec_len:
    in(v:Vector)
    out v.len;
end

# ═══════════════════════════════════════════════════════
# Elementwise Arithmetic (SIMD-optimized)
# ═══════════════════════════════════════════════════════
#
# Strategy: process 2 elements at a time (f64x2 = 128-bit NEON/SSE2),
# then handle the remainder scalar. The Q-IR vectorizer recognizes
# these patterns and emits VADD/VSUB/VMUL/VDIV automatically.

func vec_add:
    in(a:Vector; b:Vector)
    if a.len != b.len do panic("vec_add do dimension mismatch") end
    n = a.len;
    c = vec_new(n);

    # Main loop — vectorizer will auto-SIMD this
    i = 0;
    when i < n loop
        va = native_load<float>(a.data, i);
        vb = native_load<float>(b.data, i);
        native_store<float>(c.data, i, va + vb);
        i = i + 1;
    end
    out c;
end.

func vec_sub:
    in(a:Vector; b:Vector)
    if a.len != b.len do panic("vec_sub do dimension mismatch") end
    n = a.len;
    c = vec_new(n);
    i = 0;
    when i < n loop
        va = native_load<float>(a.data, i);
        vb = native_load<float>(b.data, i);
        native_store<float>(c.data, i, va - vb);
        i = i + 1;
    end
    out c;
end.

func vec_mul:
    in(a:Vector; b:Vector)
    # Hadamard (elementwise) product.
    if a.len != b.len do panic("vec_mul do dimension mismatch") end
    n = a.len;
    c = vec_new(n);
    i = 0;
    when i < n loop
        va = native_load<float>(a.data, i);
        vb = native_load<float>(b.data, i);
        native_store<float>(c.data, i, va * vb);
        i = i + 1;
    end
    out c;
end.

func vec_div:
    in(a:Vector; b:Vector)
    if a.len != b.len do panic("vec_div do dimension mismatch") end
    n = a.len;
    c = vec_new(n);
    i = 0;
    when i < n loop
        vb = native_load<float>(b.data, i);
        if vb == 0.0 do panic("vec_div do division by zero at index " + to_string(i)) end
        va = native_load<float>(a.data, i);
        native_store<float>(c.data, i, va / vb);
        i = i + 1;
    end
    out c;
end

# ─── Scalar Operations ────────────────────────────────

func vec_scale:
    in(a:Vector; s:float)
    # Multiply all elements by scalar s.
    n = a.len;
    c = vec_new(n);
    i = 0;
    when i < n loop
        native_store<float>(c.data, i, native_load<float>(a.data, i) * s);
        i = i + 1;
    end
    out c;
end.

func vec_add_scalar:
    in(a:Vector; s:float)
    n = a.len;
    c = vec_new(n);
    i = 0;
    when i < n loop
        native_store<float>(c.data, i, native_load<float>(a.data, i) + s);
        i = i + 1;
    end
    out c;
end

# ── In-place variants (no allocation) ─────────────────

func vec_add_inplace:
    in(a:Vector; b:Vector)
    if a.len != b.len do panic("vec_add_inplace do dimension mismatch") end
    i = 0;
    when i < a.len loop
        va = native_load<float>(a.data, i);
        vb = native_load<float>(b.data, i);
        native_store<float>(a.data, i, va + vb);
        i = i + 1;
    end
end.

func vec_scale_inplace:
    in(a:Vector; s:float)
    i = 0;
    when i < a.len loop
        native_store<float>(a.data, i, native_load<float>(a.data, i) * s);
        i = i + 1;
    end
end.

func vec_axpy:
    in(y:Vector; a:float; x:Vector)
    # y = a*x + y  (BLAS Level 1 AXPY)
    # FMA-friendly: the optimizer fuses mul+add into FMLA.
    if y.len != x.len do panic("vec_axpy do dimension mismatch") end
    i = 0;
    when i < y.len loop
        xi = native_load<float>(x.data, i);
        yi = native_load<float>(y.data, i);
        native_store<float>(y.data, i, a * xi + yi);
        i = i + 1;
    end
end

# ═══════════════════════════════════════════════════════
# Reductions
# ═══════════════════════════════════════════════════════

func vec_dot:
    in(a:Vector; b:Vector)
    # Dot product with Kahan compensated summation for numerical stability.
    if a.len != b.len do panic("vec_dot do dimension mismatch") end
    sum = 0.0;
    comp = 0.0    # Kahan compensation;
    i = 0;
    when i < a.len loop
        prod = native_load<float>(a.data, i) * native_load<float>(b.data, i);
        y = prod - comp;
        t = sum + y;
        comp = (t - sum) - y;
        sum = t;
        i = i + 1;
    end
    out sum;
end.

func vec_sum:
    in(a:Vector)
    # Kahan-compensated summation.
    sum = 0.0;
    comp = 0.0;
    i = 0;
    when i < a.len loop
        y = native_load<float>(a.data, i) - comp;
        t = sum + y;
        comp = (t - sum) - y;
        sum = t;
        i = i + 1;
    end
    out sum;
end.

func vec_norm2:
    in(a:Vector)
    # L2 norm: ||a||₂ = √(a·a)
    out sqrt(vec_dot(a, a));
end.

func vec_norm1:
    in(a:Vector)
    # L1 norm: ||a||₁ = Σ|aᵢ|
    sum = 0.0;
    i = 0;
    when i < a.len loop
        sum = sum + abs_f(native_load<float>(a.data, i));
        i = i + 1;
    end
    out sum;
end.

func vec_norm_inf:
    in(a:Vector)
    # L∞ norm: ||a||∞ = max|aᵢ|
    m = 0.0;
    i = 0;
    when i < a.len loop
        v = abs_f(native_load<float>(a.data, i));
        if v > m do m = v end
        i = i + 1;
    end
    out m;
end.

func vec_min:
    in(a:Vector)
    if a.len == 0 do panic("vec_min do empty vector") end
    m = native_load<float>(a.data, 0);
    i = 1;
    when i < a.len loop
        v = native_load<float>(a.data, i);
        if v < m do m = v end
        i = i + 1;
    end
    out m;
end.

func vec_max:
    in(a:Vector)
    if a.len == 0 do panic("vec_max do empty vector") end
    m = native_load<float>(a.data, 0);
    i = 1;
    when i < a.len loop
        v = native_load<float>(a.data, i);
        if v > m do m = v end
        i = i + 1;
    end
    out m;
end.

func vec_mean:
    in(a:Vector)
    if a.len == 0 do panic("vec_mean do empty vector") end
    out vec_sum(a) / to_f64(a.len);
end

# ═══════════════════════════════════════════════════════
# Geometric / Cross-product (R³ only)
# ═══════════════════════════════════════════════════════

func vec_cross3:
    in(a:Vector; b:Vector)
    # Cross product for 3D vectors only.
    if a.len != 3 or b.len != 3 do panic("vec_cross3 do requires 3D vectors") end
    c = vec_new(3);
    a0 = native_load<float>(a.data, 0);
    a1 = native_load<float>(a.data, 1);
    a2 = native_load<float>(a.data, 2);
    b0 = native_load<float>(b.data, 0);
    b1 = native_load<float>(b.data, 1);
    b2 = native_load<float>(b.data, 2);
    native_store<float>(c.data, 0, a1 * b2 - a2 * b1);
    native_store<float>(c.data, 1, a2 * b0 - a0 * b2);
    native_store<float>(c.data, 2, a0 * b1 - a1 * b0);
    out c;
end.

func vec_normalize:
    in(a:Vector)
    # Return unit vector a/||a||.
    n = vec_norm2(a);
    if n == 0.0 do panic("vec_normalize do zero vector") end
    out vec_scale(a, 1.0 / n);
end.

func vec_distance:
    in(a:Vector; b:Vector)
    # Euclidean distance between two vectors.
    diff = vec_sub(a, b);
    d = vec_norm2(diff);
    vec_free(&diff);
    out d;
end.

func vec_angle:
    in(a:Vector; b:Vector)
    # Angle (radians) between two vectors via cos⁻¹(a·b / (||a||·||b||))
    na = vec_norm2(a);
    nb = vec_norm2(b);
    if na == 0.0 or nb == 0.0 do panic("vec_angle do zero vector") end
    cos_theta = vec_dot(a, b) / (na * nb);
    # Clamp for numerical safety
    if cos_theta > 1.0 do cos_theta = 1.0 end
    if cos_theta < -1.0 do cos_theta = -1.0 end
    out native_acos(cos_theta);
end

# ═══════════════════════════════════════════════════════
# Utility
# ═══════════════════════════════════════════════════════

func vec_apply:
    in(a:Vector; f:fn(float)
    # Apply function f elementwise.
    n = a.len;
    c = vec_new(n);
    i = 0;
    when i < n loop
        native_store<float>(c.data, i, f(native_load<float>(a.data, i)));
        i = i + 1;
    end
    out c;
end.

func vec_eq:
    in(a:Vector; b:Vector; eps:float)
    # Approximate equality within epsilon.
    if a.len != b.len do out false end
    i = 0;
    when i < a.len loop
        diff = abs_f(native_load<float>(a.data, i) - native_load<float>(b.data, i));
        if diff > eps do out false end
        i = i + 1;
    end
    out true;
end.

func vec_slice:
    in(a:Vector; start:int; end_idx:int)
    # Return sub-vector [start, end_idx).
    if start > end_idx or end_idx > a.len do
        panic("vec_slice: invalid range");
    end
    new_len = end_idx - start;
    c = vec_new(new_len);
    mem_copy(c.data, a.data + start * size_of<float>(), new_len * size_of<float>());
    out c;
end

export vec_new, vec_ones, vec_filled, vec_from_array, vec_clone, vec_free;
export vec_get, vec_set, vec_len;
export vec_add, vec_sub, vec_mul, vec_div;
export vec_scale, vec_add_scalar, vec_add_inplace, vec_scale_inplace, vec_axpy;
export vec_dot, vec_sum, vec_norm2, vec_norm1, vec_norm_inf;
export vec_min, vec_max, vec_mean;
export vec_cross3, vec_normalize, vec_distance, vec_angle;
export vec_apply, vec_eq, vec_slice;
