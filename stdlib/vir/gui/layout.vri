##
 * vir/gui/layout.vri — Layout Helpers
 * =====================================
 * Convenience functions for common GUI layout patterns.
 ##

module vir.gui.layout;

include gui;

# ═══════════════════════════════════════════════════════
# Layout Presets
# ═══════════════════════════════════════════════════════

enum Align:
    Left   = 0;
    Center = 1;
    Right  = 2;
end.
enum LayoutDir:
    Horizontal = 0;
    Vertical   = 1;
end.

# ═══════════════════════════════════════════════════════
# Margin / Padding
# ═══════════════════════════════════════════════════════

entity Insets:
    top:    int,
        right:  int,
        bottom: int,
        left:   int;
end.
func insets_all(val: int):
    out Insets( top = val, right = val, bottom = val, left = val );
end.
func insets:
    in  top: int;
        right: int;
        bottom: int;
        left: int
    out Insets( top = top, right = right, bottom = bottom, left = left );
end.
func insets_h(h: int):
    out Insets( top = 0, right = h, bottom = 0, left = h );
end.
func insets_v(v: int):
    out Insets( top = v, right = 0, bottom = v, left = 0 );
end.
# ═══════════════════════════════════════════════════════
# Layout calculator
# ═══════════════════════════════════════════════════════

# Distribute N items evenly in a container
func layout_distribute:
    in  container_size: int;
        item_count: int;
        spacing: int
    # Returns size per item  
    var total_spacing = (item_count - 1) * spacing;
    var available = container_size - total_spacing;
    out available / item_count;
end.
# Calculate centered position
func layout_center(container_size: int, item_size: int):
    out (container_size - item_size) / 2;
end.