##
 * vir/gui/gui.vri — Native GUI Framework
 * ========================================
 * Cross-platform native GUI for Vir applications.
 *
 * macOS: AppKit/Cocoa via Objective-C bridge
 * Linux: GTK4 (planned)
 * Windows: Win32 (planned)
 *
 * Usage
 *   include gui;
 *   app = gui_app("My App");
 *   win = gui_window(app, "Hello", 800, 600);
 *   btn = gui_button(win, "Click me", 10, 10, 120, 40);
 *   gui_on_click(btn, on_click_handler);
 *   gui_run(app);
 ##

module vir.gui;

include types;

# ═══════════════════════════════════════════════════════
# Widget Type IDs
# ═══════════════════════════════════════════════════════

enum WidgetType:
    App       = 0;
    Window    = 1;
    Button    = 2;
    Label     = 3;
    TextField = 4;
    TextArea  = 5;
    Image     = 6;
    Panel     = 7;
    Scroll    = 8;
    Menu      = 9;
    MenuItem  = 10;
    Toolbar   = 11;
    Stack     = 12;
    Grid      = 13;
    Slider    = 14;
    Checkbox  = 15;
    Dropdown  = 16;
    Progress  = 17;
    Tab       = 18;
    Canvas    = 19;
end

# ═══════════════════════════════════════════════════════
# Color
# ═══════════════════════════════════════════════════════

entity Color:
    r: int;     # 0-255
    g: int,
        b: int,
        a: int;     # alpha 0-255
end
func color_rgb:
    in(r: int; g: int; b: int)
    out Color( r = r, g = g, b = b, a = 255 );
end
func color_rgba:
    in(r: int; g: int; b: int; a: int)
    out Color( r = r, g = g, b = b, a = a );
end
# Preset colors
const COLOR_BLACK   = Color( r = 0,   g = 0,   b = 0,   a = 255 );
const COLOR_WHITE   = Color( r = 255, g = 255, b = 255, a = 255 );
const COLOR_RED     = Color( r = 255, g = 0,   b = 0,   a = 255 );
const COLOR_GREEN   = Color( r = 0,   g = 200, b = 0,   a = 255 );
const COLOR_BLUE    = Color( r = 0,   g = 120, b = 255, a = 255 );
const COLOR_GRAY    = Color( r = 180, g = 180, b = 180, a = 255 );
const COLOR_YELLOW  = Color( r = 255, g = 220, b = 0,   a = 255 );
const COLOR_CLEAR   = Color( r = 0,   g = 0,   b = 0,   a = 0   );

# ═══════════════════════════════════════════════════════
# Rect — Position + Size
# ═══════════════════════════════════════════════════════

entity Rect:
    x: int,
        y: int,
        w: int,
        h: int;
end
func rect:
    in(x: int; y: int; w: int; h: int)
    out Rect( x = x, y = y, w = w, h = h );
end
# ═══════════════════════════════════════════════════════
# Font
# ═══════════════════════════════════════════════════════

entity Font:
    name: string,
        size: int,
        bold: int;      # 0 or 1
    italic: int;    # 0 or 1
end
func font:
    in(name: string; size: int)
    out Font( name = name, size = size, bold = 0, italic = 0 );
end
func font_bold:
    in(name: string; size: int)
    out Font( name = name, size = size, bold = 1, italic = 0 );
end
# ═══════════════════════════════════════════════════════
# Widget Handle — opaque native pointer wrapper
# ═══════════════════════════════════════════════════════

entity Widget:
    _handle: int;       # native pointer as int
    _type:   int;       # WidgetType
    _id:     int;       # unique widget ID
end

# ═══════════════════════════════════════════════════════
# Event System
# ═══════════════════════════════════════════════════════

enum EventType:
    Click       = 1;
    DoubleClick = 2;
    KeyDown     = 3;
    KeyUp       = 4;
    MouseMove   = 5;
    MouseDown   = 6;
    MouseUp     = 7;
    Scroll      = 8;
    Resize      = 9;
    Close       = 10;
    Focus       = 11;
    Blur        = 12;
    TextChange  = 13;
    ValueChange = 14;
end
entity Event:
    _type:     int;     # EventType
    widget_id: int,
        key_code:  int,
        mouse_x:   int,
        mouse_y:   int,
        modifiers: int;     # bitfield: 1=shift 2=ctrl 4=alt 8=cmd
end

# ═══════════════════════════════════════════════════════
# Native Bridge — extern functions (implemented in C/ObjC)
# ═══════════════════════════════════════════════════════

# App lifecycle
extern func _gui_app_create(name_ptr: ptr; name_len: int) -> int
extern func _gui_app_run(app: int) -> int
extern func _gui_app_quit(app: int) -> int

# Window
extern func _gui_window_create(app: int; title_ptr: ptr; title_len: int; w: int; h: int) -> int
extern func _gui_window_show(win: int) -> int
extern func _gui_window_hide(win: int) -> int
extern func _gui_window_close(win: int) -> int
extern func _gui_window_set_title(win: int; title_ptr: ptr; title_len: int) -> int
extern func _gui_window_set_size(win: int; w: int; h: int) -> int
extern func _gui_window_center(win: int) -> int
extern func _gui_window_set_bg(win: int; r: int; g: int; b: int; a: int) -> int

# Button
extern func _gui_button_create(parent: int; label_ptr: ptr; label_len: int; x: int; y: int; w: int; h: int) -> int
extern func _gui_button_set_label(btn: int; label_ptr: ptr; label_len: int) -> int
extern func _gui_button_set_action(btn: int; callback_id: int) -> int

# Label
extern func _gui_label_create(parent: int; text_ptr: ptr; text_len: int; x: int; y: int; w: int; h: int) -> int
extern func _gui_label_set_text(lbl: int; text_ptr: ptr; text_len: int) -> int
extern func _gui_label_set_font(lbl: int; name_ptr: ptr; name_len: int; size: int) -> int
extern func _gui_label_set_color(lbl: int; r: int; g: int; b: int; a: int) -> int
extern func _gui_label_set_align(lbl: int; align: int) -> int

# TextField
extern func _gui_textfield_create(parent: int; placeholder_ptr: ptr; ph_len: int; x: int; y: int; w: int; h: int) -> int
extern func _gui_textfield_get_text(tf: int; buf: ptr; buf_len: int) -> int
extern func _gui_textfield_set_text(tf: int; text_ptr: ptr; text_len: int) -> int

# Image
extern func _gui_image_create(parent: int; path_ptr: ptr; path_len: int; x: int; y: int; w: int; h: int) -> int

# Panel / Container
extern func _gui_panel_create(parent: int; x: int; y: int; w: int; h: int) -> int
extern func _gui_panel_set_bg(panel: int; r: int; g: int; b: int; a: int) -> int

# Stack layout
extern func _gui_stack_create(parent: int; vertical: int; x: int; y: int; w: int; h: int) -> int
extern func _gui_stack_add(stack: int; child: int) -> int

# Slider
extern func _gui_slider_create(parent: int; min_val: int; max_val: int; x: int; y: int; w: int; h: int) -> int
extern func _gui_slider_get_value(slider: int) -> int
extern func _gui_slider_set_value(slider: int; val: int) -> int

# Checkbox
extern func _gui_checkbox_create(parent: int; label_ptr: ptr; label_len: int; x: int; y: int; w: int; h: int) -> int
extern func _gui_checkbox_is_checked(cb: int) -> int
extern func _gui_checkbox_set_checked(cb: int; val: int) -> int

# Progress bar
extern func _gui_progress_create(parent: int; x: int; y: int; w: int; h: int) -> int
extern func _gui_progress_set_value(prog: int; val: int) -> int

# Canvas (custom drawing)
extern func _gui_canvas_create(parent: int; x: int; y: int; w: int; h: int) -> int
extern func _gui_canvas_draw_rect(canvas: int; x: int; y: int; w: int; h: int; r: int; g: int; b: int; a: int) -> int
extern func _gui_canvas_draw_line(canvas: int; x1: int; y1: int; x2: int; y2: int; r: int; g: int; b: int) -> int
extern func _gui_canvas_draw_circle(canvas: int; cx: int; cy: int; radius: int; r: int; g: int; b: int) -> int
extern func _gui_canvas_draw_text(canvas: int; text_ptr: ptr; text_len: int; x: int; y: int; size: int) -> int
extern func _gui_canvas_clear(canvas: int) -> int
extern func _gui_canvas_flush(canvas: int) -> int

# Event handling
extern func _gui_set_callback(widget: int; event_type: int; callback_id: int) -> int
extern func _gui_poll_event(event_out: ptr) -> int

# Dialog boxes
extern func _gui_alert(title_ptr: ptr; title_len: int; msg_ptr: ptr; msg_len: int) -> int
extern func _gui_confirm(title_ptr: ptr; title_len: int; msg_ptr: ptr; msg_len: int) -> int
extern func _gui_file_open(buf: ptr; buf_len: int) -> int
extern func _gui_file_save(buf: ptr; buf_len: int) -> int

# ═══════════════════════════════════════════════════════
# High-Level API (wraps extern calls)
# ═══════════════════════════════════════════════════════

var _next_widget_id = 1;

func _make_widget:
    in(handle: int; wtype: int)
    var id = _next_widget_id;
    _next_widget_id = _next_widget_id + 1;
    out Widget( _handle = handle, _type = wtype, _id = id );
end
func gui_app:
    in(name: string)
    var h = _gui_app_create(str_ptr(name), str_byte_len(name));
    out _make_widget(h, WidgetType::App);
end
func gui_run:
    in(app: Widget)
    _gui_app_run(app._handle);
end
func gui_quit:
    in(app: Widget)
    _gui_app_quit(app._handle);
end
func gui_window:
    in(app: Widget; title: string; w: int; h: int)
    var wh = _gui_window_create(app._handle, str_ptr(title), str_byte_len(title), w, h);
    out _make_widget(wh, WidgetType::Window);
end
func gui_window_center:
    in(win: Widget)
    _gui_window_center(win._handle);
end
func gui_window_set_bg:
    in(win: Widget; c: Color)
    _gui_window_set_bg(win._handle, c.r, c.g, c.b, c.a);
end
func gui_button:
    in(parent: Widget; label: string; x: int; y: int; w: int; h: int)
    var bh = _gui_button_create(parent._handle, str_ptr(label), str_byte_len(label), x, y, w, h);
    out _make_widget(bh, WidgetType::Button);
end
func gui_label:
    in(parent: Widget; text: string; x: int; y: int; w: int; h: int)
    var lh = _gui_label_create(parent._handle, str_ptr(text), str_byte_len(text), x, y, w, h);
    out _make_widget(lh, WidgetType::Label);
end
func gui_label_set_font:
    in(lbl: Widget; f: Font)
    _gui_label_set_font(lbl._handle, str_ptr(f.name), str_byte_len(f.name), f.size);
end
func gui_label_set_color:
    in(lbl: Widget; c: Color)
    _gui_label_set_color(lbl._handle, c.r, c.g, c.b, c.a);
end
func gui_textfield:
    in(parent: Widget; placeholder: string; x: int; y: int; w: int; h: int)
    var th = _gui_textfield_create(parent._handle, str_ptr(placeholder), str_byte_len(placeholder), x, y, w, h);
    out _make_widget(th, WidgetType::TextField);
end
func gui_image:
    in(parent: Widget; path: string; x: int; y: int; w: int; h: int)
    var ih = _gui_image_create(parent._handle, str_ptr(path), str_byte_len(path), x, y, w, h);
    out _make_widget(ih, WidgetType::Image);
end
func gui_panel:
    in(parent: Widget; x: int; y: int; w: int; h: int)
    var ph = _gui_panel_create(parent._handle, x, y, w, h);
    out _make_widget(ph, WidgetType::Panel);
end
func gui_panel_set_bg:
    in(panel: Widget; c: Color)
    _gui_panel_set_bg(panel._handle, c.r, c.g, c.b, c.a);
end
func gui_vstack:
    in(parent: Widget; x: int; y: int; w: int; h: int)
    var sh = _gui_stack_create(parent._handle, 1, x, y, w, h);
    out _make_widget(sh, WidgetType::Stack);
end
func gui_hstack:
    in(parent: Widget; x: int; y: int; w: int; h: int)
    var sh = _gui_stack_create(parent._handle, 0, x, y, w, h);
    out _make_widget(sh, WidgetType::Stack);
end
func gui_slider:
    in(parent: Widget; min_val: int; max_val: int; x: int; y: int; w: int; h: int)
    var sh = _gui_slider_create(parent._handle, min_val, max_val, x, y, w, h);
    out _make_widget(sh, WidgetType::Slider);
end
func gui_checkbox:
    in(parent: Widget; label: string; x: int; y: int; w: int; h: int)
    var ch = _gui_checkbox_create(parent._handle, str_ptr(label), str_byte_len(label), x, y, w, h);
    out _make_widget(ch, WidgetType::Checkbox);
end
func gui_progress:
    in(parent: Widget; x: int; y: int; w: int; h: int)
    var ph = _gui_progress_create(parent._handle, x, y, w, h);
    out _make_widget(ph, WidgetType::Progress);
end
func gui_canvas:
    in(parent: Widget; x: int; y: int; w: int; h: int)
    var ch = _gui_canvas_create(parent._handle, x, y, w, h);
    out _make_widget(ch, WidgetType::Canvas);
end
# Event binding
func gui_on_click:
    in(widget: Widget; callback_id: int)
    _gui_set_callback(widget._handle, EventType::Click, callback_id);
end
func gui_on_key:
    in(widget: Widget; callback_id: int)
    _gui_set_callback(widget._handle, EventType::KeyDown, callback_id);
end
func gui_on_resize:
    in(widget: Widget; callback_id: int)
    _gui_set_callback(widget._handle, EventType::Resize, callback_id);
end
func gui_on_close:
    in(widget: Widget; callback_id: int)
    _gui_set_callback(widget._handle, EventType::Close, callback_id);
end
# Dialogs
func gui_alert:
    in(title: string; message: string)
    _gui_alert(str_ptr(title), str_byte_len(title), str_ptr(message), str_byte_len(message));
end
func gui_confirm:
    in(title: string; message: string)
    out _gui_confirm(str_ptr(title), str_byte_len(title), str_ptr(message), str_byte_len(message));
end