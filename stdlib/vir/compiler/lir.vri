##
 * vir/compiler/lir.vri — Low-level Intermediate Representation
 * ==============================================================
 * Represents instructions close to the machine level, introducing
 * physical registers and stack slots.
 ##

include types;
include vec_rt;
import vec_new_rt, vec_push_rt, vec_get_rt, vec_set_rt, vec_len_rt from vec_rt;

enum LirType:
    None    = 0;
    Int8    = 1;
    Int16   = 2;
    Int32   = 3;
    Int64   = 4;
    F32     = 5;
    F64     = 6;
    Ptr     = 7;
    Vector  = 8
end.
enum LirOp:
    Nop     = 0;
    Mov     = 1;
    Add     = 2;
    Sub     = 3;
    Mul     = 4;
    Div     = 5;
    Push    = 6;
    Pop     = 7;
    Call    = 8;
    Jmp     = 9;
    JmpCond = 10;
    Cmp     = 11;
    Ret     = 12;
    Load    = 13;
    Store   = 14
end.
enum LirOperandType:
    None      = 0;
    VRegInt   = 1;
    VRegFloat = 2;
    PhysReg   = 3;
    StackMem  = 4;
    Imm       = 5;
    Label     = 6
end.
enum LirPhysReg:
    R0 = 0;
    R1 = 1;
    R2 = 2;
    R3 = 3;
    R4 = 4;
    R5 = 5;
    R6 = 6;
    R7 = 7;
    R8 = 8;
    R9 = 9;
    SP = 10;
    FP = 11;
    Max = 12
end.
entity LirOperand:
    op_type: LirOperandType,
        vreg: i64,
        phys_reg: i64,
        stack_offset: i64,
        imm: i64,
        label_id: i64
end.
func lir_opnd_none:
    out LirOperand ( op_type: LirOperandType.None, vreg: 0, phys_reg: 0, stack_offset: 0, imm: 0, label_id: 0 )
end.
func lir_opnd_vreg_int(r: i64)
    out LirOperand ( op_type: LirOperandType.VRegInt, vreg: r, phys_reg: 0, stack_offset: 0, imm: 0, label_id: 0 )
end.
func lir_opnd_phys(r: LirPhysReg)
    out LirOperand ( op_type: LirOperandType.PhysReg, vreg: 0, phys_reg: r as i64, stack_offset: 0, imm: 0, label_id: 0 )
end.
func lir_opnd_imm(val: i64)
    out LirOperand ( op_type: LirOperandType.Imm, vreg: 0, phys_reg: 0, stack_offset: 0, imm: val, label_id: 0 )
end.
entity LirInstr:
    op: LirOp,
        typ: LirType,
        dst: LirOperand,
        src1: LirOperand,
        src2: LirOperand
end.
entity LirBlock:
    id: i64,
        instrs: i64  # Vec<LirInstr>
end.
entity LirFunc:
    id: i64,
        blocks: i64;  # Vec<LirBlock>
    stack_size: i64
end.
export LirType, LirOp, LirOperandType, LirPhysReg, LirOperand, LirInstr, LirBlock, LirFunc;
export lir_opnd_none, lir_opnd_vreg_int, lir_opnd_phys, lir_opnd_phys_reg, lir_opnd_stack_mem, lir_opnd_imm;
