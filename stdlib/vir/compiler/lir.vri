##
 * vir/compiler/lir.vri — Low-level Intermediate Representation
 * ==============================================================
 * Represents instructions close to the machine level, introducing
 * physical registers and stack slots.
 ##

include types
include vec_rt
import vec_new_rt, vec_push_rt, vec_get_rt, vec_set_rt, vec_len_rt from vec_rt

enum LirType:
	None = 0
	Int8 = 1
	Int16 = 2
	Int32 = 3
	Int64 = 4
	F32 = 5
	F64 = 6
	Ptr = 7
	Vector = 8
end.
enum LirOp:
	Nop = 0
	Mov = 1
	Add = 2
	Sub = 3
	Mul = 4
	Div = 5
	Push = 6
	Pop = 7
	Call = 8
	Jmp = 9
	JmpCond = 10
	Cmp = 11
	Ret = 12
	Load = 13
	Store = 14
	Rem = 15
	SetArg = 16
	Intrinsic = 17
	And = 18
	Or = 19
	Xor = 20
	Shl = 21
	Shr = 22
	Not = 23
	Pow = 24
	MatMul = 25
	Fma = 26
end.

# Cmp / JmpCond predicate in LirInstr.aux
const LIR_CMP_EQ: i64 = 0
const LIR_CMP_NE: i64 = 1
const LIR_CMP_GT: i64 = 2
const LIR_CMP_LT: i64 = 3
const LIR_CMP_GE: i64 = 4
const LIR_CMP_LE: i64 = 5
const LIR_JMP_IF: i64 = 0
const LIR_JMP_IFNOT: i64 = 1
enum LirOperandType:
	None = 0
	VRegInt = 1
	VRegFloat = 2
	PhysReg = 3
	StackMem = 4
	Imm = 5
	Label = 6
end.
enum LirPhysReg:
	R0 = 0
	R1 = 1
	R2 = 2
	R3 = 3
	R4 = 4
	R5 = 5
	R6 = 6
	R7 = 7
	R8 = 8
	R9 = 9
	SP = 10
	FP = 11
	Max = 12
end.
entity LirOperand:
	op_type: LirOperandType,
	vreg: i64,
	phys_reg: i64,
	stack_offset: i64,
	imm: i64,
	label_id: i64
end.
include string_rt
import native_read_i64, native_write_i64 from string_rt

func lir_opnd_new(op_type: i64, vreg: i64, phys_reg: i64, stack_offset: i64, imm: i64, label_id: i64):
    p = alloc(48)
    native_write_i64(p, 0, op_type)
    native_write_i64(p, 8, vreg)
    native_write_i64(p, 16, phys_reg)
    native_write_i64(p, 24, stack_offset)
    native_write_i64(p, 32, imm)
    native_write_i64(p, 40, label_id)
    out p
end.

func lir_opnd_none():
    out lir_opnd_new(0, 0, 0, 0, 0, 0)
end.
func lir_opnd_vreg_int(r: i64):
    out lir_opnd_new(1, r, 0, 0, 0, 0)
end.
func lir_opnd_phys(r: LirPhysReg):
    out lir_opnd_new(2, 0, r as i64, 0, 0, 0)
end.
func lir_opnd_phys_reg(reg: LirPhysReg):
    out lir_opnd_phys(reg)
end.
func lir_opnd_stack_mem(offset: i64):
    out lir_opnd_new(3, 0, 0, offset, 0, 0)
end.
func lir_opnd_imm(val: i64):
    out lir_opnd_new(4, 0, 0, 0, val, 0)
end.
func lir_opnd_label(id: i64):
    out lir_opnd_new(5, 0, 0, 0, 0, id)
end.

func lir_instr_new(op: i64, typ: i64, dst: i64, src1: i64, src2: i64, aux: i64):
    p = alloc(48)
    native_write_i64(p, 0, op)
    native_write_i64(p, 8, typ)
    native_write_i64(p, 16, dst)
    native_write_i64(p, 24, src1)
    native_write_i64(p, 32, src2)
    native_write_i64(p, 40, aux)
    out p
end.

func lir_block_new(id: i64, instrs: i64):
    p = alloc(16)
    native_write_i64(p, 0, id)
    native_write_i64(p, 8, instrs)
    out p
end.

func lir_func_new(id: i64, name: string, blocks: i64, stack_size: i64, strings: i64):
    p = alloc(40)
    native_write_i64(p, 0, id)
    native_write_i64(p, 8, name as i64)
    native_write_i64(p, 16, blocks)
    native_write_i64(p, 24, stack_size)
    native_write_i64(p, 32, strings)
    out p
end.

entity LirInstr:
	op: LirOp,
	typ: LirType,
	dst: LirOperand,
	src1: LirOperand,
	src2: LirOperand,
	aux: i64
end.
entity LirBlock:
	id: i64,
	instrs: [LirInstr]
end.
entity LirFunc:
	id: i64,
	name: string,
	blocks: [LirBlock],
	stack_size: i64,
	strings: i64
end.

# Soft RT stub table indices (emit_lir_module_arm64).
# 1..60 mirror MIR_INTR_*; 0 = unresolved Call; 61..63 = Pow/MatMul/Fma.
const LIR_RT_NATIVE_READ_U8: i64 = 57
const LIR_RT_NATIVE_WRITE_U8: i64 = 58
const LIR_RT_NATIVE_READ_I64: i64 = 59
const LIR_RT_NATIVE_WRITE_I64: i64 = 60
const LIR_RT_UNRESOLVED: i64 = 0
const LIR_RT_POW: i64 = 61
const LIR_RT_MATMUL: i64 = 62
const LIR_RT_FMA: i64 = 63
const LIR_RT_ALLOC: i64 = 64
const LIR_RT_PRINT_STR: i64 = 65
const LIR_RT_GET_ARG: i64 = 66
const LIR_RT_ARG_COUNT: i64 = 67
const LIR_RT_VOLATILE_READ: i64 = 68
const LIR_RT_VOLATILE_WRITE: i64 = 69
const LIR_RT_VOLATILE_READ8: i64 = 70
const LIR_RT_VOLATILE_WRITE8: i64 = 71
const LIR_RT_DMB: i64 = 72
const LIR_RT_DSB: i64 = 73
const LIR_RT_ISB: i64 = 74
const LIR_RT_WFI: i64 = 75
const LIR_RT_WFE: i64 = 76
const LIR_RT_SEV: i64 = 77
const LIR_RT_NOP: i64 = 78
const LIR_RT_ATOMIC_LOAD32: i64 = 79
const LIR_RT_ATOMIC_STORE32: i64 = 80
const LIR_RT_ATOMIC_ADD32: i64 = 81
const LIR_RT_ATOMIC_SUB32: i64 = 82
const LIR_RT_ATOMIC_CAS32: i64 = 83
const LIR_RT_ATOMIC_EXCHANGE32: i64 = 84
const LIR_RT_ATOMIC_LOAD64: i64 = 85
const LIR_RT_ATOMIC_STORE64: i64 = 86
const LIR_RT_ATOMIC_ADD64: i64 = 87
const LIR_RT_ATOMIC_SUB64: i64 = 88
const LIR_RT_ATOMIC_CAS64: i64 = 89
const LIR_RT_ATOMIC_EXCHANGE64: i64 = 90
const LIR_RT_STUB_COUNT: i64 = 91

# Dump / test tags — keep 1:1 with LirOp enum numbers.
func lir_op_tag(op: i64):
	if op == 0 do out "Nop" end
	if op == 1 do out "Mov" end
	if op == 2 do out "Add" end
	if op == 3 do out "Sub" end
	if op == 4 do out "Mul" end
	if op == 5 do out "Div" end
	if op == 6 do out "Push" end
	if op == 7 do out "Pop" end
	if op == 8 do out "Call" end
	if op == 9 do out "Jmp" end
	if op == 10 do out "JmpCond" end
	if op == 11 do out "Cmp" end
	if op == 12 do out "Ret" end
	if op == 13 do out "Load" end
	if op == 14 do out "Store" end
	if op == 15 do out "Rem" end
	if op == 16 do out "SetArg" end
	if op == 17 do out "Intrinsic" end
	if op == 18 do out "And" end
	if op == 19 do out "Or" end
	if op == 20 do out "Xor" end
	if op == 21 do out "Shl" end
	if op == 22 do out "Shr" end
	if op == 23 do out "Not" end
	if op == 24 do out "Pow" end
	if op == 25 do out "MatMul" end
	if op == 26 do out "Fma" end
	out "Unknown"
end.

include string_rt
import native_read_i64 from string_rt

func lir_func_id(f: LirFunc): out native_read_i64(f as i64, 0) end.
func lir_func_name(f: LirFunc): out native_read_i64(f as i64, 8) as string end.
func lir_func_blocks(f: LirFunc): out native_read_i64(f as i64, 16) end.
func lir_func_stack_size(f: LirFunc): out native_read_i64(f as i64, 24) end.
func lir_func_strings(f: LirFunc): out native_read_i64(f as i64, 32) end.

func lir_block_id(b: LirBlock): out native_read_i64(b as i64, 0) end.
func lir_block_instrs(b: LirBlock): out native_read_i64(b as i64, 8) end.

func lir_instr_op(ins: LirInstr): out native_read_i64(ins as i64, 0) end.
func lir_instr_typ(ins: LirInstr): out native_read_i64(ins as i64, 8) end.
func lir_instr_dst(ins: LirInstr): out native_read_i64(ins as i64, 16) end.
func lir_instr_src1(ins: LirInstr): out native_read_i64(ins as i64, 24) end.
func lir_instr_src2(ins: LirInstr): out native_read_i64(ins as i64, 32) end.
func lir_instr_aux(ins: LirInstr): out native_read_i64(ins as i64, 40) end.

func lir_opnd_type(o: LirOperand): out native_read_i64(o as i64, 0) end.
func lir_opnd_vreg(o: LirOperand): out native_read_i64(o as i64, 8) end.
func lir_opnd_phys_reg_val(o: LirOperand): out native_read_i64(o as i64, 16) end.
func lir_opnd_stack_offset(o: LirOperand): out native_read_i64(o as i64, 24) end.
func lir_opnd_imm_val(o: LirOperand): out native_read_i64(o as i64, 32) end.
func lir_opnd_label_id(o: LirOperand): out native_read_i64(o as i64, 40) end.

export LirType, LirOp, LirOperandType, LirPhysReg, LirOperand, LirInstr, LirBlock, LirFunc
export lir_opnd_new, lir_instr_new, lir_block_new, lir_func_new
export lir_opnd_none, lir_opnd_vreg_int, lir_opnd_phys, lir_opnd_phys_reg, lir_opnd_stack_mem, lir_opnd_imm, lir_opnd_label
export lir_func_id, lir_func_name, lir_func_blocks, lir_func_stack_size, lir_func_strings
export lir_block_id, lir_block_instrs
export lir_instr_op, lir_instr_dst, lir_instr_src1, lir_instr_src2, lir_instr_aux, lir_instr_typ
export lir_opnd_type, lir_opnd_vreg, lir_opnd_imm_val, lir_opnd_label_id, lir_opnd_phys_reg_val, lir_opnd_stack_offset
export LIR_CMP_EQ, LIR_CMP_NE, LIR_CMP_GT, LIR_CMP_LT, LIR_CMP_GE, LIR_CMP_LE, LIR_JMP_IF, LIR_JMP_IFNOT
export lir_op_tag
export LIR_RT_NATIVE_READ_U8, LIR_RT_NATIVE_WRITE_U8, LIR_RT_NATIVE_READ_I64, LIR_RT_NATIVE_WRITE_I64, LIR_RT_UNRESOLVED, LIR_RT_POW, LIR_RT_MATMUL, LIR_RT_FMA, LIR_RT_ALLOC, LIR_RT_PRINT_STR, LIR_RT_GET_ARG, LIR_RT_ARG_COUNT, LIR_RT_VOLATILE_READ, LIR_RT_VOLATILE_WRITE, LIR_RT_VOLATILE_READ8, LIR_RT_VOLATILE_WRITE8, LIR_RT_DMB, LIR_RT_DSB, LIR_RT_ISB, LIR_RT_WFI, LIR_RT_WFE, LIR_RT_SEV, LIR_RT_NOP, LIR_RT_STUB_COUNT
