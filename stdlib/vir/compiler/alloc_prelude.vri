##
 * Soft-bootstrap prelude for `include alloc;` / rt alloc.
 * Soft cannot call extern yet — provide no-op / zero stubs so call sites
 * lower. Entity literals still use QOp.Alloc via soft lower.
 ##

func vir_alloc(size: int):
    out 0
end.

func alloc(size: int):
    out 0
end.

func alloc_zeroed(size: int):
    out 0
end.

func vir_free(ptr: int):
    out 0
end.

func free(ptr: int):
    out 0
end.

func vir_realloc(ptr: int, size: int):
    out ptr
end.

func realloc(ptr: int, size: int):
    out ptr
end.

func page_alloc(size: int):
    out 0
end.
