##
 * vir/compiler/lir_liveness.vri — Liveness Analysis
 * ==============================================================
 * Computes live intervals for virtual registers to prepare
 * for register allocation.
 ##

include types
include vec_rt
import vec_new_rt, vec_push_rt, vec_get_rt, vec_set_rt, vec_len_rt from vec_rt
include compiler.lir
import LirOperandType, LirOperand, LirInstr, LirBlock, LirFunc from compiler.lir

entity LiveInterval:
    vreg: i64,
    start_pos: i64,
    end_pos: i64
end.

# Typed accessors — bare vec_get_rt results have no record type, so `.op_type`
# / `.vreg` would resolve against the wrong layout (MirOperand, etc.).
func lir_opnd_is_vreg(o: LirOperand)
    out o.op_type == LirOperandType.VRegInt
end.
func lir_opnd_vreg_id(o: LirOperand)
    out o.vreg
end.
func lir_instr_dst(ins: LirInstr)
    out ins.dst
end.
func lir_instr_src1(ins: LirInstr)
    out ins.src1
end.
func lir_instr_src2(ins: LirInstr)
    out ins.src2
end.
func lir_block_instrs(b: LirBlock)
    out b.instrs
end.
func lir_func_blocks(f: LirFunc)
    out f.blocks
end.

func live_start(iv: LiveInterval)
    out iv.start_pos
end.

func touch_interval(intervals: i64, v: i64, pos: i64)
    iv = vec_get_rt(intervals, v)
    start = live_start(iv)
    if start == -1 do
        start = pos
    end
    vec_set_rt(intervals, v, LiveInterval (
        vreg: v,
        start_pos: start,
        end_pos: pos
    ))
end.

func max_vreg_lir(func_obj: LirFunc)
    max_v = 0
    blocks = lir_func_blocks(func_obj)
    n_blocks = vec_len_rt(blocks)
    i = 0
    when i < n_blocks loop
        b = vec_get_rt(blocks, i)
        instrs = lir_block_instrs(b)
        n_instrs = vec_len_rt(instrs)
        j = 0
        when j < n_instrs loop
            ins = vec_get_rt(instrs, j)
            d = lir_instr_dst(ins)
            s1 = lir_instr_src1(ins)
            s2 = lir_instr_src2(ins)
            if lir_opnd_is_vreg(d) do
                if lir_opnd_vreg_id(d) > max_v do
                    max_v = lir_opnd_vreg_id(d)
                end
            end
            if lir_opnd_is_vreg(s1) do
                if lir_opnd_vreg_id(s1) > max_v do
                    max_v = lir_opnd_vreg_id(s1)
                end
            end
            if lir_opnd_is_vreg(s2) do
                if lir_opnd_vreg_id(s2) > max_v do
                    max_v = lir_opnd_vreg_id(s2)
                end
            end
            j = j + 1
        end
        i = i + 1
    end
    out max_v
end.

func lir_compute_liveness(func_obj: LirFunc)
    max_v = max_vreg_lir(func_obj)

    intervals = vec_new_rt()
    i = 0
    when i <= max_v loop
        intervals = vec_push_rt(intervals, LiveInterval (
            vreg: i,
            start_pos: -1,
            end_pos: -1
        ))
        i = i + 1
    end

    pos = 0
    blocks = lir_func_blocks(func_obj)
    n_blocks = vec_len_rt(blocks)
    b_idx = 0
    when b_idx < n_blocks loop
        b = vec_get_rt(blocks, b_idx)
        instrs = lir_block_instrs(b)
        n_instrs = vec_len_rt(instrs)
        i_idx = 0
        when i_idx < n_instrs loop
            ins = vec_get_rt(instrs, i_idx)
            s1 = lir_instr_src1(ins)
            s2 = lir_instr_src2(ins)
            d = lir_instr_dst(ins)
            if lir_opnd_is_vreg(s1) do
                touch_interval(intervals, lir_opnd_vreg_id(s1), pos)
            end
            if lir_opnd_is_vreg(s2) do
                touch_interval(intervals, lir_opnd_vreg_id(s2), pos)
            end
            if lir_opnd_is_vreg(d) do
                touch_interval(intervals, lir_opnd_vreg_id(d), pos)
            end
            pos = pos + 1
            i_idx = i_idx + 1
        end
        b_idx = b_idx + 1
    end
    out intervals
end.

export LiveInterval, lir_compute_liveness
export lir_opnd_is_vreg, lir_opnd_vreg_id, lir_instr_dst, lir_instr_src1, lir_instr_src2
export lir_block_instrs, lir_func_blocks
