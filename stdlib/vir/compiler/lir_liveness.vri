##
 * vir/compiler/lir_liveness.vri — Liveness Analysis
 * ==============================================================
 * Computes live intervals for virtual registers to prepare
 * for register allocation.
 ##

include types;
include vec_rt;
import vec_new_rt, vec_push_rt, vec_get_rt, vec_set_rt, vec_len_rt from vec_rt;
include lir;
import LirOperandType, LirFunc from lir;

entity LiveInterval:
    vreg: i64,
        start_pos: i64
    end_pos: i64
end.

func max_vreg_lir(func_obj: LirFunc)
    max_v = 0;
    n_blocks = vec_len_rt(func_obj.blocks);
    i = 0;
    when i < n_blocks loop
        b = vec_get_rt(func_obj.blocks, i);
        instrs = b.instrs;
        n_instrs = vec_len_rt(instrs);
        j = 0;
        when j < n_instrs loop
            ins = vec_get_rt(instrs, j);
            if ins.dst.op_type == LirOperandType.VRegInt and ins.dst.vreg > max_v do
                max_v = ins.dst.vreg
            end
            if ins.src1.op_type == LirOperandType.VRegInt and ins.src1.vreg > max_v do
                max_v = ins.src1.vreg
            end
            if ins.src2.op_type == LirOperandType.VRegInt and ins.src2.vreg > max_v do
                max_v = ins.src2.vreg
            end
            j = j + 1
        end
        i = i + 1
    end
    out max_v
end.

func lir_compute_liveness(func_obj: LirFunc)
    max_v = max_vreg_lir(func_obj);
    
    # Initialize intervals
    intervals = vec_new_rt();
    i = 0;
    when i <= max_v loop
        iv = LiveInterval (
            vreg: i,
            start_pos: -1,
            end_pos: -1
        );
        intervals = vec_push_rt(intervals, iv);
        i = i + 1
    end.
    
    # Simple linear scan to build intervals
    pos = 0;
    n_blocks = vec_len_rt(func_obj.blocks);
    
    b_idx = 0;
    when b_idx < n_blocks loop
        b = vec_get_rt(func_obj.blocks, b_idx);
        instrs = b.instrs;
        n_instrs = vec_len_rt(instrs);
        
        i_idx = 0;
        when i_idx < n_instrs loop
            ins = vec_get_rt(instrs, i_idx);
            
            # Process src1 (USE)
            if ins.src1.op_type == LirOperandType.VRegInt do
                v = ins.src1.vreg;
                iv = vec_get_rt(intervals, v);
                if iv.start_pos == -1 do iv.start_pos = pos end
                iv.end_pos = pos;
                vec_set_rt(intervals, v, iv)
            end.
            
            # Process src2 (USE)
            if ins.src2.op_type == LirOperandType.VRegInt do
                v = ins.src2.vreg;
                iv = vec_get_rt(intervals, v);
                if iv.start_pos == -1 do iv.start_pos = pos end
                iv.end_pos = pos;
                vec_set_rt(intervals, v, iv)
            end.
            
            # Process dst (DEF)
            if ins.dst.op_type == LirOperandType.VRegInt do
                v = ins.dst.vreg;
                iv = vec_get_rt(intervals, v);
                if iv.start_pos == -1 do iv.start_pos = pos end
                iv.end_pos = pos;
                vec_set_rt(intervals, v, iv)
            end.
            
            pos = pos + 1;
            i_idx = i_idx + 1
        end
        b_idx = b_idx + 1
    end.
    
    out intervals
end.

export LiveInterval, lir_compute_liveness;
