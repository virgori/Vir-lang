##
 * vir/compiler/sem_pass9_constfold.vri
 * ==============================================================
 * Pass 9: Constant Folding Analysis.
 * Detects compile-time evaluable expressions and constant propagation.
 * Reports warnings for always-true/false conditions (dead code).
 * Actual folding is deferred to MIR optimizer.
 ##

include vec_rt
import vec_new_rt, vec_push_rt, vec_get_rt, vec_set_rt, vec_len_rt, vec_copy_rt from vec_rt

include string_rt
import rt_streq, fat_str_eq, fat_str_len, fat_cstr_eq, rt_strcat, rt_itoa, rt_strlen from string_rt

include parser
import AstNode, AstType, OpType from parser

include symbol_table
import SymbolTable, SymbolKind, SymbolNode from symbol_table

include scope_tree
import ScopeTree, ScopeKind, ScopeNode, scope_push, scope_pop from scope_tree

include context
import DiagnosticEngine, report_warning, report_error from context

include alloc
import vir_alloc from alloc

func pass9_is_known_const(const_map_box: int, name: &string):
    let const_map = native_read_i64(const_map_box, 0)
    let count = vec_len_rt(const_map)
    var i = 0
    when i < count loop
        let cname = vec_get_rt(const_map, i) as string
        if fat_str_eq(cname, name) do
            out 1
        end
        i = i + 2
    end
    out 0
end.

func pass9_get_const_val(const_map_box: int, name: string):
    let const_map = native_read_i64(const_map_box, 0)
    let count = vec_len_rt(const_map)
    var i = 0
    when i < count loop
        let cname = vec_get_rt(const_map, i) as string
        if fat_str_eq(cname, name) do
            out vec_get_rt(const_map, i + 1)
        end
        i = i + 2
    end
    out 0 - 999999
end.

func pass9_add_const(const_map_box: int, name: string, value: int):
    var m = native_read_i64(const_map_box, 0)
    m = vec_push_rt(m, name as i64)
    m = vec_push_rt(m, value as i64)
    native_write_i64(const_map_box, 0, m)
end.

func pass9_ctx_new(root: &AstNode, diag: &DiagnosticEngine, const_map_box: int):
    let ctx = vir_alloc(64)
    native_write_i64(ctx, 0, root as i64)
    native_write_i64(ctx, 8, diag as i64)
    native_write_i64(ctx, 16, vec_new_rt())
    native_write_i64(ctx, 24, 0)
    native_write_i64(ctx, 32, 0)
    native_write_i64(ctx, 40, 0)
    native_write_i64(ctx, 48, 0)
    native_write_i64(ctx, 56, const_map_box as i64)
    out ctx
end.

func pass9_ctx_get_root(ctx: int): out native_read_i64(ctx, 0) as AstNode end.
func pass9_ctx_get_diag(ctx: int): out native_read_i64(ctx, 8) as DiagnosticEngine end.
func pass9_ctx_get_env(ctx: int): out native_read_i64(ctx, 16) end.
func pass9_ctx_set_env(ctx: int, env: i64): native_write_i64(ctx, 16, env) end.
func pass9_ctx_has_returned(ctx: int): out native_read_i64(ctx, 24) end.
func pass9_ctx_set_returned(ctx: int, flag: int, val: int):
    native_write_i64(ctx, 24, flag)
    native_write_i64(ctx, 32, val)
end.
func pass9_ctx_get_return_val(ctx: int): out native_read_i64(ctx, 32) end.
func pass9_ctx_has_error(ctx: int): out native_read_i64(ctx, 40) end.
func pass9_ctx_set_error(ctx: int): native_write_i64(ctx, 40, 1) end.
func pass9_ctx_get_depth(ctx: int): out native_read_i64(ctx, 48) end.
func pass9_ctx_set_depth(ctx: int, d: int): native_write_i64(ctx, 48, d) end.
func pass9_ctx_get_const_map_box(ctx: int): out native_read_i64(ctx, 56) end.

func pass9_env_lookup(ctx: int, name: string):
    let env = pass9_ctx_get_env(ctx)
    let count = vec_len_rt(env)
    var i = count - 2
    when i >= 0 loop
        let vname = vec_get_rt(env, i) as string
        if fat_str_eq(vname, name) do
            out vec_get_rt(env, i + 1)
        end
        i = i - 2
    end
    let const_map_box = pass9_ctx_get_const_map_box(ctx)
    if pass9_is_known_const(const_map_box, name) == 1 do
        out pass9_get_const_val(const_map_box, name)
    end
    out 0 - 999999
end.

func pass9_env_push(ctx: int, name: string, val: int):
    var env = pass9_ctx_get_env(ctx)
    env = vec_push_rt(env, name as i64)
    env = vec_push_rt(env, val as i64)
    pass9_ctx_set_env(ctx, env)
end.

func pass9_env_update(ctx: int, name: string, val: int):
    let env = pass9_ctx_get_env(ctx)
    let count = vec_len_rt(env)
    var i = count - 2
    when i >= 0 loop
        let vname = vec_get_rt(env, i) as string
        if fat_str_eq(vname, name) do
            vec_set_rt(env, i + 1, val as i64)
            out 1
        end
        i = i - 2
    end
    pass9_env_push(ctx, name, val)
    out 0
end.

func pass9_env_len(ctx: int):
    let env = pass9_ctx_get_env(ctx)
    if env == 0 do
        out 0
    end
    out vec_len_rt(env)
end.

func pass9_env_pop_to(ctx: int, saved_len: int):
    let env = pass9_ctx_get_env(ctx)
    if env != 0 do
        native_write_i64(env - 8, 0, saved_len)
    end
end.

func pass9_find_func(root: &AstNode, name: string):
    if (root as i64) == 0 do
        out 0 as AstNode
    end
    let count = vec_len_rt(root.children)
    var i = 0
    when i < count loop
        let ch = vec_get_rt(root.children, i) as AstNode
        if ch.node_type == AstType.FuncDef do
            if fat_str_eq(ch.name, name) do
                out ch
            end
        end
        i = i + 1
    end
    out 0 as AstNode
end.

func pass9_eval_call(ctx: int, node: &AstNode):
    if fat_cstr_eq(node.name, "print") == 1 or fat_cstr_eq(node.name, "println") == 1 or fat_cstr_eq(node.name, "print_ln") == 1 or fat_cstr_eq(node.name, "printf") == 1 do
        report_error(pass9_ctx_get_diag(ctx), 3080, node.line, 0)
        pass9_ctx_set_error(ctx)
        out 0
    end

    let depth = pass9_ctx_get_depth(ctx)
    if depth > 500 do
        g_precomp_throw_kind = 2
        g_precomp_throw_val = 0
        g_precomp_throw_str = "recursion limit reached (> 500 depth)"
        report_error(pass9_ctx_get_diag(ctx), 3083, node.line, 0)
        pass9_ctx_set_error(ctx)
        out 0
    end

    let fn = pass9_find_func(pass9_ctx_get_root(ctx), node.name)
    if (fn as i64) == 0 do
        out 0
    end

    let arg_count = vec_len_rt(node.children)
    var evaled_args = vec_new_rt()
    var ai = 0
    when ai < arg_count loop
        let arg_node = vec_get_rt(node.children, ai) as AstNode
        let arg_v = pass9_eval_precomp_expr(ctx, arg_node)
        evaled_args = vec_push_rt(evaled_args, arg_v)
        ai = ai + 1
    end

    let saved_len = pass9_env_len(ctx)
    let fn_child_count = vec_len_rt(fn.children)
    var param_idx = 0
    var body_node = 0 as AstNode

    var pi = 0
    when pi < fn_child_count loop
        let fch = vec_get_rt(fn.children, pi) as AstNode
        if fch.node_type == AstType.ParamDef or fch.node_type == AstType.RefParam do
            if param_idx < arg_count do
                let pv = vec_get_rt(evaled_args, param_idx)
                pass9_env_push(ctx, fch.name, pv)
                param_idx = param_idx + 1
            end
        eif fch.node_type == AstType.Block do
            body_node = fch
        end
        pi = pi + 1
    end

    if (body_node as i64) != 0 do
        pass9_ctx_set_depth(ctx, depth + 1)
        pass9_eval_precomp_stmt(ctx, body_node)
        pass9_ctx_set_depth(ctx, depth)
    end

    var ret_val = 0
    if pass9_ctx_has_returned(ctx) == 1 do
        ret_val = pass9_ctx_get_return_val(ctx)
        pass9_ctx_set_returned(ctx, 0, 0)
    end

    pass9_env_pop_to(ctx, saved_len)
    out ret_val
end.

func pass9_eval_precomp_expr(ctx: int, node: &AstNode):
    if (node as i64) == 0 do
        out 0
    end
    if pass9_ctx_has_error(ctx) == 1 do
        out 0
    end

    if node.node_type == AstType.ArrayLiteral or node.node_type == AstType.IndexAccess or node.node_type == AstType.ExprIndex or node.node_type == AstType.ArenaBlock or node.node_type == AstType.LiteralStr or node.node_type == AstType.InterpExpr do
        report_error(pass9_ctx_get_diag(ctx), 3082, node.line, 0)
        pass9_ctx_set_error(ctx)
        out 0
    end

    if node.node_type == AstType.LiteralInt or node.node_type == AstType.LiteralBool do
        out node.int_val
    end
    if node.node_type == AstType.LiteralNone do
        out 0
    end

    if node.node_type == AstType.Identifier do
        if fat_cstr_eq(node.name, "true") == 1 do out 1 end
        if fat_cstr_eq(node.name, "false") == 1 do out 0 end
        if fat_cstr_eq(node.name, "null") == 1 do out 0 end
        let v = pass9_env_lookup(ctx, node.name)
        if v != (0 - 999999) do
            out v
        end
        out 0
    end

    if node.node_type == AstType.UnaryMinus do
        if vec_len_rt(node.children) > 0 do
            let c = vec_get_rt(node.children, 0) as AstNode
            let v = pass9_eval_precomp_expr(ctx, c)
            out 0 - v
        end
        out 0
    end

    if node.node_type == AstType.UnaryNot do
        if vec_len_rt(node.children) > 0 do
            let c = vec_get_rt(node.children, 0) as AstNode
            let v = pass9_eval_precomp_expr(ctx, c)
            if v == 0 do out 1 else out 0 end
        end
        out 0
    end

    if node.node_type == AstType.Call or node.node_type == AstType.BuiltinCall do
        out pass9_eval_call(ctx, node)
    end

    if node.node_type == AstType.PrecompBlock do
        if vec_len_rt(node.children) > 0 do
            let c = vec_get_rt(node.children, 0) as AstNode
            out pass9_eval_precomp_node(ctx, c)
        end
        out 0
    end

    if node.node_type == AstType.BinOp or node.node_type == AstType.Compare do
        let child_count = vec_len_rt(node.children)
        if child_count >= 2 do
            let left = vec_get_rt(node.children, 0) as AstNode
            let right = vec_get_rt(node.children, 1) as AstNode
            let lv = pass9_eval_precomp_expr(ctx, left)
            if pass9_ctx_has_error(ctx) == 1 do out 0 end
            let rv = pass9_eval_precomp_expr(ctx, right)
            if pass9_ctx_has_error(ctx) == 1 do out 0 end

            if node.op == OpType.Add do out lv + rv end
            if node.op == OpType.Sub do out lv - rv end
            if node.op == OpType.Mul do out lv * rv end
            if node.op == OpType.Div do
                if rv == 0 do
                    report_error(pass9_ctx_get_diag(ctx), 3081, node.line, 0)
                    pass9_ctx_set_error(ctx)
                    out 0
                end
                out lv / rv
            end
            if node.op == OpType.ModOp do
                if rv == 0 do
                    report_error(pass9_ctx_get_diag(ctx), 3081, node.line, 0)
                    pass9_ctx_set_error(ctx)
                    out 0
                end
                out lv mod rv
            end
            if node.op == OpType.ShlOp do out lv shl rv end
            if node.op == OpType.ShrOp do out lv shr rv end
            if node.op == OpType.AndOp or node.op == OpType.Land do out lv and rv end
            if node.op == OpType.OrOp or node.op == OpType.Lor do out lv or rv end
            if node.op == OpType.XorOp do out lv xor rv end
            if node.op == OpType.Eq do
                if lv == rv do out 1 else out 0 end
            end
            if node.op == OpType.Ne do
                if lv != rv do out 1 else out 0 end
            end
            if node.op == OpType.Gt do
                if lv > rv do out 1 else out 0 end
            end
            if node.op == OpType.Lt do
                if lv < rv do out 1 else out 0 end
            end
            if node.op == OpType.Ge do
                if lv >= rv do out 1 else out 0 end
            end
            if node.op == OpType.Le do
                if lv <= rv do out 1 else out 0 end
            end
        end
    end

    out 0
end.

func pass9_eval_precomp_stmt(ctx: int, node: &AstNode):
    if (node as i64) == 0 do
        out 0
    end
    if pass9_ctx_has_returned(ctx) == 1 or pass9_ctx_has_error(ctx) == 1 do
        out 0
    end

    if node.node_type == AstType.PrintStmt do
        report_error(pass9_ctx_get_diag(ctx), 3080, node.line, 0)
        pass9_ctx_set_error(ctx)
        out 0
    end

    if node.node_type == AstType.ThrowStmt do
        g_precomp_throw_kind = 0
        g_precomp_throw_val = 0
        g_precomp_throw_str = ""
        if vec_len_rt(node.children) > 0 do
            let c = vec_get_rt(node.children, 0) as AstNode
            if c.node_type == AstType.LiteralInt do
                g_precomp_throw_kind = 1
                g_precomp_throw_val = c.int_val
            eif c.node_type == AstType.LiteralStr do
                g_precomp_throw_kind = 2
                g_precomp_throw_str = c.name
            else
                g_precomp_throw_kind = 1
                g_precomp_throw_val = pass9_eval_precomp_expr(ctx, c)
            end
        end
        report_error(pass9_ctx_get_diag(ctx), 3083, node.line, 0)
        pass9_ctx_set_error(ctx)
        out 0
    end

    if node.node_type == AstType.ReturnStmt do
        var val = 0
        if vec_len_rt(node.children) > 0 do
            let c = vec_get_rt(node.children, 0) as AstNode
            val = pass9_eval_precomp_expr(ctx, c)
        end
        pass9_ctx_set_returned(ctx, 1, val)
        out 0
    end

    if node.node_type == AstType.VarDecl do
        var val = 0
        if vec_len_rt(node.children) > 0 do
            let init = vec_get_rt(node.children, 0) as AstNode
            val = pass9_eval_precomp_expr(ctx, init)
        end
        pass9_env_push(ctx, node.name, val)
        out 0
    end

    if node.node_type == AstType.Assign do
        if vec_len_rt(node.children) > 0 do
            let val = pass9_eval_precomp_expr(ctx, vec_get_rt(node.children, 0) as AstNode)
            pass9_env_update(ctx, node.name, val)
        end
        out 0
    end

    if node.node_type == AstType.IfStmt do
        let child_count = vec_len_rt(node.children)
        if child_count >= 2 do
            let cond = vec_get_rt(node.children, 0) as AstNode
            let cond_val = pass9_eval_precomp_expr(ctx, cond)
            if pass9_ctx_has_error(ctx) == 1 do
                out 0
            end
            if cond_val != 0 do
                let then_blk = vec_get_rt(node.children, 1) as AstNode
                pass9_eval_precomp_stmt(ctx, then_blk)
            else
                if child_count >= 3 do
                    let else_blk = vec_get_rt(node.children, 2) as AstNode
                    pass9_eval_precomp_stmt(ctx, else_blk)
                end
            end
        end
        out 0
    end

    if node.node_type == AstType.Block do
        let child_count = vec_len_rt(node.children)
        var i = 0
        when i < child_count loop
            if pass9_ctx_has_returned(ctx) == 1 or pass9_ctx_has_error(ctx) == 1 do
                out 0
            end
            let child = vec_get_rt(node.children, i) as AstNode
            pass9_eval_precomp_stmt(ctx, child)
            i = i + 1
        end
        out 0
    end


    pass9_eval_precomp_expr(ctx, node)
    out 0
end.

func pass9_eval_precomp_node(ctx: int, node: &AstNode):
    if (node as i64) == 0 do
        out 0
    end
    if node.node_type == AstType.Block or node.node_type == AstType.IfStmt or node.node_type == AstType.ReturnStmt or node.node_type == AstType.ThrowStmt or node.node_type == AstType.PrintStmt or node.node_type == AstType.VarDecl or node.node_type == AstType.Assign do
        pass9_eval_precomp_stmt(ctx, node)
        out pass9_ctx_get_return_val(ctx)
    end
    out pass9_eval_precomp_expr(ctx, node)
end.

func pass9_const_fold(ref symbols: SymbolTable, ref scopes: ScopeTree, diag: &DiagnosticEngine, node: &AstNode):
    # const_map_box: 1-word cell holding vec of (name, value) pairs
    let const_map_box = vir_alloc(8)
    native_write_i64(const_map_box, 0, vec_new_rt())
    pass9_walk(symbols, scopes, diag, node, const_map_box, node)
end.

func pass9_is_const_expr(node: &AstNode, const_map_box: int):
    if node.node_type == AstType.LiteralInt or node.node_type == AstType.LiteralBool or node.node_type == AstType.LiteralNone do
        out 1
    end
    if node.node_type == AstType.LiteralFloat do
        out 1
    end
    if node.node_type == AstType.LiteralStr do
        out 1
    end
    if node.node_type == AstType.Identifier do
        out pass9_is_known_const(const_map_box, node.name)
    end
    if node.node_type == AstType.BinOp or node.node_type == AstType.Compare do
        let child_count = vec_len_rt(node.children)
        if child_count >= 2 do
            let left = vec_get_rt(node.children, 0)
            let right = vec_get_rt(node.children, 1)
            let left_const = pass9_is_const_expr(left, const_map_box)
            let right_const = pass9_is_const_expr(right, const_map_box)
            out left_const and right_const
        end
    end
    if node.node_type == AstType.UnaryMinus do
        let child_count = vec_len_rt(node.children)
        if child_count > 0 do
            let child = vec_get_rt(node.children, 0)
            out pass9_is_const_expr(child, const_map_box)
        end
    end
    if node.node_type == AstType.PrecompBlock do
        let child_count = vec_len_rt(node.children)
        if child_count > 0 do
            let child = vec_get_rt(node.children, 0)
            out pass9_is_const_expr(child, const_map_box)
        end
    end
    out 0
end.

func pass9_eval_int(node: &AstNode, const_map_box: int):
    if node.node_type == AstType.LiteralInt or node.node_type == AstType.LiteralBool or node.node_type == AstType.LiteralNone do
        out node.int_val
    end
    if node.node_type == AstType.Identifier do
        out pass9_get_const_val(const_map_box, node.name)
    end
    if node.node_type == AstType.BinOp do
        let child_count = vec_len_rt(node.children)
        if child_count >= 2 do
            let left = vec_get_rt(node.children, 0)
            let right = vec_get_rt(node.children, 1)
            let lv = pass9_eval_int(left, const_map_box)
            let rv = pass9_eval_int(right, const_map_box)
            if lv == (0 - 999999) or rv == (0 - 999999) do
                out 0 - 999999
            end
            if node.op == OpType.Add do out lv + rv end
            if node.op == OpType.Sub do out lv - rv end
            if node.op == OpType.Mul do out lv * rv end
            if node.op == OpType.Div do
                if rv != 0 do
                    out lv / rv
                end
                out 0 - 999999
            end
            if node.op == OpType.ModOp do
                if rv != 0 do
                    out lv mod rv
                end
                out 0 - 999999
            end
            if node.op == OpType.ShlOp do out lv shl rv end
            if node.op == OpType.ShrOp do out lv shr rv end
            if node.op == OpType.AndOp or node.op == OpType.Land do out lv and rv end
            if node.op == OpType.OrOp or node.op == OpType.Lor do out lv or rv end
            if node.op == OpType.XorOp do out lv xor rv end
        end
    end
    if node.node_type == AstType.PrecompBlock do
        let child_count = vec_len_rt(node.children)
        if child_count > 0 do
            let child = vec_get_rt(node.children, 0)
            out pass9_eval_int(child, const_map_box)
        end
    end
    if node.node_type == AstType.UnaryMinus do
        let child_count = vec_len_rt(node.children)
        if child_count > 0 do
            let child = vec_get_rt(node.children, 0)
            let v = pass9_eval_int(child, const_map_box)
            if v != (0 - 999999) do
                out 0 - v
            end
        end
    end
    out 0 - 999999
end.

func pass9_eval_bool_condition(node: &AstNode, const_map_box: int):
    if node.node_type == AstType.Compare do
        let child_count = vec_len_rt(node.children)
        if child_count >= 2 do
            let left = vec_get_rt(node.children, 0)
            let right = vec_get_rt(node.children, 1)
            if pass9_is_const_expr(left, const_map_box) and pass9_is_const_expr(right, const_map_box) do
                let lv = pass9_eval_int(left, const_map_box)
                let rv = pass9_eval_int(right, const_map_box)
                if lv != (0 - 999999) and rv != (0 - 999999) do
                    if node.op == OpType.Eq do
                        if lv == rv do out 1 else out 0 end
                    end
                    if node.op == OpType.Ne do
                        if lv != rv do out 1 else out 0 end
                    end
                    if node.op == OpType.Gt do
                        if lv > rv do out 1 else out 0 end
                    end
                    if node.op == OpType.Lt do
                        if lv < rv do out 1 else out 0 end
                    end
                    if node.op == OpType.Ge do
                        if lv >= rv do out 1 else out 0 end
                    end
                    if node.op == OpType.Le do
                        if lv <= rv do out 1 else out 0 end
                    end
                end
            end
        end
    end
    out 0 - 1
end.

func pass9_walk(ref symbols: SymbolTable, ref scopes: ScopeTree, diag: &DiagnosticEngine, node: &AstNode, const_map_box: int, root_node: &AstNode):
    if (node as i64) == 0 do
        out 0
    end

    # Local `let`/const values are not visible in the next function. Carry
    # module-level constants into a private map, and discard function locals
    # when the walk returns; otherwise unrelated dynamic conditions can be
    # reported as dead code (W6002).
    if node.node_type == AstType.FuncDef do
        let local_box = vir_alloc(8)
        native_write_i64(local_box, 0, vec_copy_rt(native_read_i64(const_map_box, 0)))
        let child_count = vec_len_rt(node.children)
        var fi = 0
        when fi < child_count loop
            pass9_walk(symbols, scopes, diag, vec_get_rt(node.children, fi), local_box, root_node)
            fi = fi + 1
        end
        out 0
    end

    # Precomp block at statement level
    if node.node_type == AstType.PrecompBlock do
        if vec_len_rt(node.children) > 0 do
            let child = vec_get_rt(node.children, 0) as AstNode
            let ctx = pass9_ctx_new(root_node, diag, const_map_box)
            let val = pass9_eval_precomp_node(ctx, child)
            node.int_val = val
        end
        out 0
    end

    # Register const declarations for propagation
    if node.node_type == AstType.ConstDecl do
        let child_count = vec_len_rt(node.children)
        if child_count > 0 do
            let init = vec_get_rt(node.children, 0) as AstNode
            if init.node_type == AstType.PrecompBlock do
                let ctx = pass9_ctx_new(root_node, diag, const_map_box)
                var val = 0
                if vec_len_rt(init.children) > 0 do
                    val = pass9_eval_precomp_node(ctx, vec_get_rt(init.children, 0) as AstNode)
                end
                init.int_val = val
                node.int_val = val
                pass9_add_const(const_map_box, node.name, val)
            eif pass9_is_const_expr(init, const_map_box) do
                let val = pass9_eval_int(init, const_map_box)
                if val != (0 - 999999) do
                    node.int_val = val
                    pass9_add_const(const_map_box, node.name, val)
                end
            end
        end
        out 0
    end

    # Var declaration with precomp initializer
    if node.node_type == AstType.VarDecl do
        let child_count = vec_len_rt(node.children)
        if child_count > 0 do
            let init = vec_get_rt(node.children, 0) as AstNode
            if (init as i64) != 0 and init.node_type == AstType.PrecompBlock do
                let ctx = pass9_ctx_new(root_node, diag, const_map_box)
                var val = 0
                if vec_len_rt(init.children) > 0 do
                    val = pass9_eval_precomp_node(ctx, vec_get_rt(init.children, 0) as AstNode)
                end
                init.int_val = val
                node.int_val = val
            end
        end
    end

    # Check if-conditions for always-true/false
    if node.node_type == AstType.IfStmt do
        let child_count = vec_len_rt(node.children)
        if child_count >= 1 do
            let cond = vec_get_rt(node.children, 0)
            let result = pass9_eval_bool_condition(cond, const_map_box)
            if result == 1 do
                # Condition is always true — warning: else branch is dead code
                if child_count >= 3 do
                    report_warning(diag, 6001, node.line, 0)
                end
            end
            if result == 0 do
                # Condition is always false — warning: if branch is dead code
                report_warning(diag, 6002, node.line, 0)
            end
        end
        # Walk children
        var i = 0
        when i < child_count loop
            let child = vec_get_rt(node.children, i)
            pass9_walk(symbols, scopes, diag, child, const_map_box, root_node)
            i = i + 1
        end
        out 0
    end

    # Check while-conditions for always-false
    if node.node_type == AstType.WhileStmt do
        let child_count = vec_len_rt(node.children)
        if child_count >= 1 do
            let cond = vec_get_rt(node.children, 0)
            let result = pass9_eval_bool_condition(cond, const_map_box)
            if result == 0 do
                # While condition is always false — loop body never executes
                report_warning(diag, 6003, node.line, 0)
            end
        end
        var i = 0
        when i < child_count loop
            let child = vec_get_rt(node.children, i)
            pass9_walk(symbols, scopes, diag, child, const_map_box, root_node)
            i = i + 1
        end
        out 0
    end

    if node.node_type == AstType.ExternFunc do
        out 0
    end

    # Scoping for blocks / functions
    if node.node_type == AstType.FuncDef do
        scope_push(scopes, ScopeKind.Func)
        let child_count = vec_len_rt(node.children)
        var i = 0
        when i < child_count loop
            let child = vec_get_rt(node.children, i)
            pass9_walk(symbols, scopes, diag, child, const_map_box, root_node)
            i = i + 1
        end
        scope_pop(scopes)
        out 0
    end

    if node.node_type == AstType.Block do
        scope_push(scopes, ScopeKind.Block)
        let child_count = vec_len_rt(node.children)
        var i = 0
        when i < child_count loop
            let child = vec_get_rt(node.children, i)
            pass9_walk(symbols, scopes, diag, child, const_map_box, root_node)
            i = i + 1
        end
        scope_pop(scopes)
        out 0
    end

    # Default: walk all children
    let child_count = vec_len_rt(node.children)
    var i = 0
    when i < child_count loop
        let child = vec_get_rt(node.children, i)
        pass9_walk(symbols, scopes, diag, child, const_map_box, root_node)
        i = i + 1
    end
    out 0
end.

export pass9_const_fold
