##
 * vir/compiler/lir_interference.vri — Interference Graph
 * ==============================================================
 * Builds an interference graph (Adjacency Matrix) from live
 * intervals. Used for Graph Coloring Register Allocation.
 ##

include types
include vec_rt
import vec_new_rt, vec_push_rt, vec_get_rt, vec_set_rt, vec_len_rt from vec_rt
include compiler.lir_liveness
import LiveInterval from compiler.lir_liveness

entity InterferenceGraph:
    num_nodes: i64,
    matrix: [i64],
    degrees: [i64]
end.

func max_i64(a: i64, b: i64)
    if a > b do out a end
    out b
end.
func min_i64(a: i64, b: i64)
    if a < b do out a end
    out b
end.

func live_start_of(iv: LiveInterval)
    out iv.start_pos
end.
func live_end_of(iv: LiveInterval)
    out iv.end_pos
end.

func intervals_overlap(i1: LiveInterval, i2: LiveInterval)
    if live_start_of(i1) == -1 or live_start_of(i2) == -1 do
        out false
    end
    start_max = max_i64(live_start_of(i1), live_start_of(i2))
    end_min = min_i64(live_end_of(i1), live_end_of(i2))
    if start_max <= end_min do
        out true
    end
    out false
end.

func ig_num_nodes(ig: InterferenceGraph)
    out ig.num_nodes
end.
func ig_matrix(ig: InterferenceGraph)
    out ig.matrix
end.
func ig_degrees(ig: InterferenceGraph)
    out ig.degrees
end.

func build_interference_graph(intervals: i64)
    n_nodes = vec_len_rt(intervals)

    matrix = vec_new_rt()
    degrees = vec_new_rt()

    total_size = n_nodes * n_nodes
    i = 0
    when i < total_size loop
        matrix = vec_push_rt(matrix, 0)
        i = i + 1
    end
    i = 0
    when i < n_nodes loop
        degrees = vec_push_rt(degrees, 0)
        i = i + 1
    end

    i = 0
    when i < n_nodes loop
        iv1 = vec_get_rt(intervals, i)
        if live_start_of(iv1) != -1 do
            j = i + 1
            when j < n_nodes loop
                iv2 = vec_get_rt(intervals, j)
                if live_start_of(iv2) != -1 do
                    if intervals_overlap(iv1, iv2) do
                        idx1 = (i * n_nodes) + j
                        idx2 = (j * n_nodes) + i
                        vec_set_rt(matrix, idx1, 1)
                        vec_set_rt(matrix, idx2, 1)
                        d1 = vec_get_rt(degrees, i)
                        vec_set_rt(degrees, i, d1 + 1)
                        d2 = vec_get_rt(degrees, j)
                        vec_set_rt(degrees, j, d2 + 1)
                    end
                end
                j = j + 1
            end
        end
        i = i + 1
    end

    out InterferenceGraph (
        num_nodes: n_nodes,
        matrix: matrix,
        degrees: degrees
    )
end.

func get_edge(ig: InterferenceGraph, u: i64, v: i64)
    n = ig_num_nodes(ig)
    idx = (u * n) + v
    out vec_get_rt(ig_matrix(ig), idx)
end.

export InterferenceGraph, build_interference_graph, get_edge, ig_num_nodes, ig_degrees
