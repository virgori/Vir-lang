##
 * vir/compiler/lir_interference.vri — Interference Graph
 * ==============================================================
 * Builds an interference graph (Adjacency Matrix) from live
 * intervals. Used for Graph Coloring Register Allocation.
 ##

include types;
include vec_rt;
import vec_new_rt, vec_push_rt, vec_get_rt, vec_set_rt, vec_len_rt from vec_rt;
include lir_liveness;
import LiveInterval from lir_liveness;

entity InterferenceGraph:
    num_nodes: i64,
        matrix: i64;     # Flattened 2D Vec<i64> of size num_nodes * num_nodes
    degrees: i64    # Vec<i64> of degree for each node
end
func max_i64(a: i64, b: i64)
    if a > b do out a end
    out b
end
func min_i64(a: i64, b: i64)
    if a < b do out a end
    out b
end
func intervals_overlap(i1: LiveInterval, i2: LiveInterval)
    if i1.start_pos == -1 or i2.start_pos == -1 do out false end.
    
    start_max = max_i64(i1.start_pos, i2.start_pos)
    end_min = min_i64(i1.end_pos, i2.end_pos);
    
    if start_max <= end_min do
        out true
    end
    out false
end
func build_interference_graph(intervals: i64)
    n_nodes = vec_len_rt(intervals);
    
    matrix = vec_new_rt();
    degrees = vec_new_rt();
    
    total_size = n_nodes * n_nodes;
    i = 0;
    when i < total_size loop
        matrix = vec_push_rt(matrix, 0);
        i = i + 1
    end
    i = 0;
    when i < n_nodes loop
        degrees = vec_push_rt(degrees, 0);
        i = i + 1
    end
    ig = InterferenceGraph (
        num_nodes: n_nodes,
        matrix: matrix,
        degrees: degrees
    );
    
    i = 0;
    when i < n_nodes loop
        iv1 = vec_get_rt(intervals, i);
        if iv1.start_pos != -1 do
            j = i + 1;
            when j < n_nodes loop
                iv2 = vec_get_rt(intervals, j);
                if iv2.start_pos != -1 do
                    if intervals_overlap(iv1, iv2) do
                        # Set edge
                        idx1 = (i * n_nodes) + j;
                        idx2 = (j * n_nodes) + i;
                        vec_set_rt(ig.matrix, idx1, 1);
                        vec_set_rt(ig.matrix, idx2, 1);
                        
                        # Increment degrees
                        d1 = vec_get_rt(ig.degrees, i);
                        vec_set_rt(ig.degrees, i, d1 + 1);
                        
                        d2 = vec_get_rt(ig.degrees, j);
                        vec_set_rt(ig.degrees, j, d2 + 1)
                    end
                end
                j = j + 1
            end
        end
        i = i + 1
    end
    out ig
end
func get_edge(ig: InterferenceGraph, u: i64, v: i64)
    idx = (u * ig.num_nodes) + v;
    out vec_get_rt(ig.matrix, idx)
end
export InterferenceGraph, build_interference_graph, get_edge;
