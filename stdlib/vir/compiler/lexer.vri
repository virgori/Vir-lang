    end
    if t == TokType.BitShrAssign do
        out fat_str_new("SHR_ASSIGN")
    end
    out fat_str_new("???")
end.
export TokType, Token, KeywordEntry, Lexer, lexer_new, tokenize, lexer_lex, token_name