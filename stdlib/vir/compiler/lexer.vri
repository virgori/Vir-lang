##
 * vir/compiler/lexer.vri — Vir Source Lexer (Pure Vir)
 * =====================================================
 * UTF-8 tokenizer for Vir v1.2 standard syntax.
 * Converted from C (core/src/lexer.c) for self-hosting.
 *
 * Features
 *   - Full v1.2 keyword set (English standard)
 *   - Multi-char operators (?=, ?., :~, >>, ||, ->, ..)
 *   - Block comments (hash-hash open, hash-hash close)
 *   - Hex literal support (0x...)
 *   - Paren-depth tracking (suppress newlines inside parens)
 *   - String escape sequences (\n, \t, \\, \", \')
 ##

include types;
include result;
import Result, Ok, Err from result;
include "stdlib/vir/rt/string_rt.vri";
import fat_str_new, fat_str_concat, fat_str_len, fat_str_byte_at, fat_str_eq, fat_char_to_str, rt_streq from "stdlib/vir/rt/string_rt.vri";
include vec;
import Vec, vec_new, vec_push, vec_len, vec_get from vec;

# ═══════════════════════════════════════════════════════
# Token Types (v1.2 Standard)
# ═══════════════════════════════════════════════════════

enum TokType:
    # Literals
    Eof         = 0;
    Error       = 1;
    Int         = 2;
    Float       = 3;
    Str         = 4;
    Ident       = 5;
    Newline     = 6;

    # Definitions
    Func        = 10;
    Var         = 11;
    Const       = 12;
    Entity      = 13;
    Enum        = 14;
    Method      = 15;
    Class       = 16;
    Has         = 17;
    Share       = 18;
    Async       = 19;
    Task        = 20;
    Wait        = 21;
    TypeKw      = 22;

    # Control flow
    If          = 30;
    Else        = 31;
    Eif         = 32;
    Loop        = 33;
    While       = 34;
    When        = 35;
    For         = 36;
    Break       = 37;
    Skip        = 38;
    Out         = 39;
    Case        = 40;
    End         = 41;
    In          = 42;

    # Arithmetic operators
    Plus        = 50;
    Minus       = 51;
    Star        = 52;
    Slash       = 53;
    Percent     = 54;
    Power       = 55;
    Mod         = 56;

    # Comparison operators
    Eq          = 60;
    Ne          = 61;
    Gt          = 62;
    Lt          = 63;
    Ge          = 64;
    Le          = 65;
    SafeEq      = 66;
    SafeNe      = 67;

    # Logical operators
    And         = 70;
    Or          = 71;
    Not         = 72;

    # Bitwise operators
    BitXor      = 75;
    BitShl      = 76;
    BitShr      = 77;
    BitAnd      = 78;
    BitOr       = 79;
    BitNot      = 80;

    # Access / transform
    SafeAccess  = 85;
    Exist       = 86;
    Cast        = 87;
    Pattern     = 88;

    # Assignment
    Assign      = 90;

    # Delimiters
    LParen      = 100;
    RParen      = 101;
    LBracket    = 102;
    RBracket    = 103;
    LBrace      = 104;
    RBrace      = 105;
    Comma       = 106;
    Dot         = 107;
    DotDot      = 108;
    Colon       = 109;
    DoubleColon = 112;
    Semicolon   = 110;
    Arrow       = 111;

    # I/O
    Print       = 120;
    Input       = 121;
    CheckCpu    = 122;
    Patch       = 123;

    # Module
    Import      = 130;
    From        = 131;
    Module      = 132;
    Export      = 133;
    As          = 134;
    Include     = 135;
    Get         = 136;

    # Boolean / None
    True        = 140;
    False       = 141;
    NoneLit     = 142;

    # Error handling
    Try         = 150;
    ErrorKw     = 151;
    MapKw       = 152;
    Extern      = 153;
    EnsureKw    = 154;
    PackedKw    = 155;
    RefKw       = 156;
    RegisterKw  = 157;
    RevertKw    = 158;
    ThisKw      = 159;
    InterpStart = 160;
    InterpEnd   = 161;
    ThrowKw     = 162;
    AtSign      = 163;
    Do          = 164;
    Let         = 165;
    Del         = 166;   # Vietnamese alias "xóa" / delete

    # §26.2 AI / advanced operators, §24.4 atomics, compound assign
    MatMul      = 180;   # **
    Fma         = 181;   # ><
    Lock        = 182;   # lock keyword
    AtomicBang  = 183;   # !!
    PlusAssign  = 184;   # +=
    MinusAssign = 185;   # -=
    StarAssign  = 186;   # *=
    SlashAssign = 187;   # /=
    Swizzle     = 188   # ~ (postfix swizzle reuses BitNot lex)
end.
# ═══════════════════════════════════════════════════════
# Token
# ═══════════════════════════════════════════════════════

entity Token:
    tok_type:   TokType,
        line:       int,
        col:        int,
        str_val:    string,
        int_val:    int,
        float_val:  float
end.
func token_new:
    in  t: TokType;
        line: int;
        col: int

    out Token (
        tok_type: t,
        line: line,
        col: col,
        str_val: fat_str_new(""),
        int_val: 0,
        float_val: 0.0
    )
end.
# ═══════════════════════════════════════════════════════
# Keyword Lookup Table
# ═══════════════════════════════════════════════════════

entity KeywordEntry:
    word:   string,
        tok:    TokType
end.
func kw_table_part1:
    in table: Vec<KeywordEntry>
    table = vec_push(table, KeywordEntry ( word: fat_str_new("func"), tok: TokType.Func ));
    table = vec_push(table, KeywordEntry ( word: fat_str_new("function"), tok: TokType.Func ));
    table = vec_push(table, KeywordEntry ( word: fat_str_new("var"), tok: TokType.Var ));
    table = vec_push(table, KeywordEntry ( word: fat_str_new("let"), tok: TokType.Var ));
