    table = vec_push(table, KeywordEntry ( word: fat_str_new("mod"), tok: TokType.Mod ))
    table = vec_push(table, KeywordEntry ( word: fat_str_new("import"), tok: TokType.Import ))
    table = vec_push(table, KeywordEntry ( word: fat_str_new("from"), tok: TokType.From ))
