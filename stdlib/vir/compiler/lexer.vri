    out table
end.

func build_keyword_table:
    table = vec_new<KeywordEntry>();
    table = kw_table_part1(table);
    table = kw_table_part2(table);
    table = kw_table_part3(table);
    table = kw_table_part4(table);
    out table
end.
func lookup_keyword(table: Vec<KeywordEntry>, word: string):

    i = 0;
    when i < vec_len(table) loop
        entry = vec_get(table, i);
        if fat_str_eq(entry.word, word) do
            out entry.tok
        end
        i = i + 1
    end
    out TokType.Error  # sentinel: not found (instead of Eof)
end.
# ═══════════════════════════════════════════════════════
# Lexer State
# ═══════════════════════════════════════════════════════

entity Lexer:
    source:         string,
        source_len:     int,
        pos:            int,
        line:           int,
        col:            int,
        tokens:         Vec<Token>,
        paren_depth:    int,
        keywords:       Vec<KeywordEntry>,
        error_msg:          string
end.
# §28.3 — Runtime keyword registration API (after Lexer entity).
func register_keyword:
    in  lex: Lexer;
        word: string;
        tok: TokType

    lex.keywords = vec_push(lex.keywords, KeywordEntry ( word: word, tok: tok ));
    out lex
end.
func lexer_new(source: string):

    slen = fat_str_len(source);
    toks = vec_new();
    kws = build_keyword_table();
    err = fat_str_new("");
    out Lexer (
        source: source,
        source_len: slen,
        pos: 0,
        line: 1,
        col: 1,
        tokens: toks,
        paren_depth: 0,
        keywords: kws,
        error_msg: err
    )
end.
# ═══════════════════════════════════════════════════════
# Character Helpers
# ═══════════════════════════════════════════════════════

func is_eof(lex: Lexer):

    out lex.pos >= lex.source_len
end.
func lex_peek(lex: Lexer):

    if lex.pos < lex.source_len do
        out fat_str_byte_at(lex.source, lex.pos)
    end
    out 0
end.
func lex_peek_at(lex: Lexer, offset: int):

    p = lex.pos + offset;
    if p < lex.source_len do
        out fat_str_byte_at(lex.source, p)
    end
    out 0
end.
func lex_advance(lex: Lexer):

    c = lex_peek(lex);
    if c == 10 do # '\n'
        lex.line = lex.line + 1;
        lex.col = 1
    else
        lex.col = lex.col + 1
    end
    lex.pos = lex.pos + 1;
    out (lex, c)
end.
func is_alpha(c: int):

    out (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or c == 95
end.
func is_digit(c: int):

    out c >= 48 and c <= 57
end.
func is_hex_digit(c: int):

    out is_digit(c) or (c >= 65 and c <= 70) or (c >= 97 and c <= 102)
end.
func is_word_char(c: int):

    out is_alpha(c) or is_digit(c) or c >= 128
end.
# ═══════════════════════════════════════════════════════
# Skip Whitespace & Comments
# ═══════════════════════════════════════════════════════

func skip_whitespace(lex: Lexer):

    when not is_eof(lex) loop
        c = lex_peek(lex);
        if c == 32 or c == 9 or c == 13 do # space, tab, CR
            var (lex2, _) = lex_advance(lex);
            lex = lex2
        else
            out lex
        end
    end
    out lex
end.
func skip_comment(lex: Lexer):

    # Single-line comment: # ... until \n
    when not is_eof(lex) and lex_peek(lex) != 10 loop
        var (lex2, _) = lex_advance(lex);
        lex = lex2
    end
    out lex
end.
func skip_block_comment(lex: Lexer):

    # Block comment: ## ... ##
    var (lex2, _) = lex_advance(lex)  # skip first #;
    var (lex3, _) = lex_advance(lex2)  # skip second #;
    lex = lex3;
    when not is_eof(lex) loop
        if lex_peek(lex) == 35 and lex_peek_at(lex, 1) == 35 do
            var (lex4, _) = lex_advance(lex);
            var (lex5, _) = lex_advance(lex4);
            out lex5
        end
        var (lex6, _) = lex_advance(lex);
        lex = lex6
    end
    out lex
end.
# ═══════════════════════════════════════════════════════
# Number Lexing
# ═══════════════════════════════════════════════════════

func lex_number(lex: Lexer):

    tok = token_new(TokType.Int, lex.line, lex.col);
    num = 0;
    is_float = false;

    # Hex literal
    if lex_peek(lex) == 48 and (lex_peek_at(lex, 1) == 120 or lex_peek_at(lex, 1) == 88) do
        var (lex2, _) = lex_advance(lex)    # 0;
        var (lex3, _) = lex_advance(lex2)   # x;
        lex = lex3;
        when not is_eof(lex) and is_hex_digit(lex_peek(lex)) loop
            c = lex_peek(lex);
            digit = 0;
            if c >= 48 and c <= 57 do
                digit = (c - 48) >> int
            end
            if c >= 65 and c <= 70 do
                digit = (c - 55) >> int
            end
            if c >= 97 and c <= 102 do
                digit = (c - 87) >> int
            end
            num = num * 16 + digit;
            var (lex4, _) = lex_advance(lex);
            lex = lex4
        end
        tok.int_val = num;
        out (lex, tok)
    end

    # Octal literal (0o...)
    if lex_peek(lex) == 48 and (lex_peek_at(lex, 1) == 111 or lex_peek_at(lex, 1) == 79) do
        var (lex2, _) = lex_advance(lex)    # 0;
        var (lex3, _) = lex_advance(lex2)   # o;
        lex = lex3;
        when not is_eof(lex) and is_digit(lex_peek(lex)) loop
            c = lex_peek(lex);
            if c >= 48 and c <= 55 do # '0' to '7'
                digit = (c - 48) >> int;
                num = num * 8 + digit
            end
            var (lex4, _) = lex_advance(lex);
            lex = lex4
        end
        tok.int_val = num;
        out (lex, tok)
    end

    # Decimal literal (integer or float)
    when not is_eof(lex) and (is_digit(lex_peek(lex)) or lex_peek(lex) == 46) loop
        c = lex_peek(lex);
        if c == 46 do # '.'
            if is_float do
                # Second dot — stop
                tok.int_val = num;
                out (lex, tok)
            end
            # Check for .. range operator
            if lex_peek_at(lex, 1) == 46 do
                tok.int_val = num;
                out (lex, tok)
            end
            is_float = true;
            var (lex2, _) = lex_advance(lex);
            lex = lex2
        else
            digit = c - 48;
            num = num * 10 + digit;
            var (lex3, _) = lex_advance(lex);
            lex = lex3
        end
    end

    if is_float do
        tok.tok_type = TokType.Float
    end
    tok.int_val = num;
    out (lex, tok)
end.
# ═══════════════════════════════════════════════════════
# String Lexing
# ═══════════════════════════════════════════════════════

func lex_string(lex: Lexer):

    tok = token_new(TokType.Str, lex.line, lex.col);
    var (lex2, quote) = lex_advance(lex)  # consume opening quote;
    lex = lex2;
    buf = fat_str_new("");

    when not is_eof(lex) and lex_peek(lex) != quote loop
        if lex_peek(lex) == 92 do # backslash
            var (lex3, _) = lex_advance(lex);
            lex = lex3;
            if is_eof(lex) do
                out (lex, tok)
            end
            var (lex4, esc) = lex_advance(lex);
            lex = lex4;
            if esc == 110 do # \n
                piece = fat_str_new("\n");
                buf = fat_str_concat(buf, piece)
            end
            if esc == 116 do # \t
                piece = fat_str_new("\t");
                buf = fat_str_concat(buf, piece)
            end
            if esc == 92 do # \\
                piece = fat_str_new("\\");
                buf = fat_str_concat(buf, piece)
            end
            if esc == 34 do # \"
                piece = fat_str_new("\"");
                buf = fat_str_concat(buf, piece)
            end
            if esc == 39 do # \'
                piece = fat_str_new("'");
                buf = fat_str_concat(buf, piece)
            end
        else
            var (lex5, ch) = lex_advance(lex);
            lex = lex5;
            piece = fat_char_to_str(ch);
            buf = fat_str_concat(buf, piece)
        end
    end

    # Consume closing quote
    if not is_eof(lex) do
        var (lex6, _) = lex_advance(lex);
        lex = lex6
    end

    tok.str_val = buf;
    out (lex, tok)
end.
# ═══════════════════════════════════════════════════════
# Word / Keyword Lexing
# ═══════════════════════════════════════════════════════

func lex_word(lex: Lexer):

    start_line = lex.line;
    start_col = lex.col;
    buf = fat_str_new("");

    when not is_eof(lex) and is_word_char(lex_peek(lex)) loop
        var (lex2, ch) = lex_advance(lex);
        lex = lex2;
        piece = fat_char_to_str(ch);
        buf = fat_str_concat(buf, piece)
    end

    # Lookup keyword
    kw_type = lookup_keyword(lex.keywords, buf);
    if kw_type != TokType.Error do
        tok = token_new(kw_type, start_line, start_col);
        tok.str_val = buf;
        out (lex, tok)
    end

    # Identifier
    tok = token_new(TokType.Ident, start_line, start_col);
    tok.str_val = buf;
    out (lex, tok)
end.
# ═══════════════════════════════════════════════════════
# Main Tokenize Loop
# ═══════════════════════════════════════════════════════

func tokenize(lex: Lexer):

    prev_was_newline = true;

    when not is_eof(lex) loop
        lex = skip_whitespace(lex);
        if is_eof(lex) do
            out lex
        end

        c = lex_peek(lex);

        # Newline (statement separator)
        if c == 10 do
            var (lex2, _) = lex_advance(lex);
            lex = lex2;
            if not prev_was_newline and lex.paren_depth == 0 do
                lex.tokens = vec_push(lex.tokens, token_new(TokType.Newline, lex.line, lex.col));
                prev_was_newline = true
            end
            skip  # continue
        end

        prev_was_newline = false;

        # Comment
        if c == 35 do # '#'
            if lex_peek_at(lex, 1) == 35 do
                lex = skip_block_comment(lex)
            else
                lex = skip_comment(lex)
            end
            skip
        end

        # String literal
        if c == 34 or c == 39 do # " or '
            var (lex2, tok) = lex_string(lex);
            lex = lex2;
            lex.tokens = vec_push(lex.tokens, tok);
            skip
        end

        # Number literal
        if is_digit(c) do
            var (lex2, tok) = lex_number(lex);
            lex = lex2;
            lex.tokens = vec_push(lex.tokens, tok);
            skip
        end

        # Multi-char operators
        c2 = lex_peek_at(lex, 1);

        if c == 61 and c2 == 61 do # ==
            tok = token_new(TokType.Eq, lex.line, lex.col);
            var (l1, _) = lex_advance(lex);
            var (l2, _) = lex_advance(l1);
            lex = l2;
            lex.tokens = vec_push(lex.tokens, tok);
            skip
        end

        if c == 33 and c2 == 61 do # !=
            tok = token_new(TokType.Ne, lex.line, lex.col);
            var (l1, _) = lex_advance(lex);
            var (l2, _) = lex_advance(l1);
            lex = l2;
            lex.tokens = vec_push(lex.tokens, tok);
            skip
        end

        if c == 62 and c2 == 61 do # >=
            tok = token_new(TokType.Ge, lex.line, lex.col);
            var (l1, _) = lex_advance(lex);
            var (l2, _) = lex_advance(l1);
            lex = l2;
            lex.tokens = vec_push(lex.tokens, tok);
            skip
        end

        if c == 60 and c2 == 61 do # <=
            tok = token_new(TokType.Le, lex.line, lex.col);
            var (l1, _) = lex_advance(lex);
            var (l2, _) = lex_advance(l1);
            lex = l2;
            lex.tokens = vec_push(lex.tokens, tok);
            skip
        end

        # ?=/= (safe not-equal — 4 chars)
        if c == 63 and c2 == 61 and lex_peek_at(lex, 2) == 47 and lex_peek_at(lex, 3) == 61 do
            tok = token_new(TokType.SafeNe, lex.line, lex.col);
            var (l1, _) = lex_advance(lex);
            var (l2, _) = lex_advance(l1);
            var (l3, _) = lex_advance(l2);
            var (l4, _) = lex_advance(l3);
            lex = l4;
            lex.tokens = vec_push(lex.tokens, tok);
            skip
        end

        # ?= (safe equal)
        if c == 63 and c2 == 61 do
            tok = token_new(TokType.SafeEq, lex.line, lex.col);
            var (l1, _) = lex_advance(lex);
            var (l2, _) = lex_advance(l1);
            lex = l2;
            lex.tokens = vec_push(lex.tokens, tok);
            skip
        end

        # ?. (safe member access)
        if c == 63 and c2 == 46 do
            tok = token_new(TokType.SafeAccess, lex.line, lex.col);
            var (l1, _) = lex_advance(lex);
            var (l2, _) = lex_advance(l1);
            lex = l2;
            lex.tokens = vec_push(lex.tokens, tok);
            skip
        end

        # :~ (pattern match)
        if c == 58 and c2 == 126 do
            tok = token_new(TokType.Pattern, lex.line, lex.col);
            var (l1, _) = lex_advance(lex);
            var (l2, _) = lex_advance(l1);
            lex = l2;
            lex.tokens = vec_push(lex.tokens, tok);
            skip
        end

        # || (logical OR)
        if c == 124 and c2 == 124 do
            tok = token_new(TokType.Or, lex.line, lex.col);
            var (l1, _) = lex_advance(lex);
            var (l2, _) = lex_advance(l1);
            lex = l2;
            lex.tokens = vec_push(lex.tokens, tok);
            skip
        end

        # -> (arrow)
        if c == 45 and c2 == 62 do
            tok = token_new(TokType.Arrow, lex.line, lex.col);
            var (l1, _) = lex_advance(lex);
            var (l2, _) = lex_advance(l1);
            lex = l2;
            lex.tokens = vec_push(lex.tokens, tok);
            skip
        end

        # << (bit shift left)
        if c == 60 and c2 == 60 do
            tok = token_new(TokType.BitShl, lex.line, lex.col);
            var (l1, _) = lex_advance(lex);
            var (l2, _) = lex_advance(l1);
            lex = l2;
            lex.tokens = vec_push(lex.tokens, tok);
            skip
        end

        # shr (cast in v1.2)
        if c == 62 and c2 == 62 do
            tok = token_new(TokType.Cast, lex.line, lex.col);
            var (l1, _) = lex_advance(lex);
            var (l2, _) = lex_advance(l1);
            lex = l2;
            lex.tokens = vec_push(lex.tokens, tok);
            skip
        end

        # .. (range)
        if c == 46 and c2 == 46 do
            tok = token_new(TokType.DotDot, lex.line, lex.col);
            var (l1, _) = lex_advance(lex);
            var (l2, _) = lex_advance(l1);
            lex = l2;
            lex.tokens = vec_push(lex.tokens, tok);
            skip
        end


        # Single-char operators
        single_tok = TokType.Eof;
        if c == 43 do
            single_tok = TokType.Plus
        end
        if c == 45 and single_tok == TokType.Eof do
            single_tok = TokType.Minus
        end
        if c == 42 do
            single_tok = TokType.Star
        end
        if c == 47 do
            single_tok = TokType.Slash
        end
        if c == 37 do
            single_tok = TokType.Percent
        end
        if c == 94 do
            single_tok = TokType.Power
        end
        if c == 61 and single_tok == TokType.Eof do
            single_tok = TokType.Assign
        end
        if c == 62 and single_tok == TokType.Eof do
            single_tok = TokType.Gt
        end
        if c == 60 and single_tok == TokType.Eof do
            single_tok = TokType.Lt
        end
        if c == 33 and single_tok == TokType.Eof do
            single_tok = TokType.Not
        end
        if c == 63 and single_tok == TokType.Eof do
            single_tok = TokType.Exist
        end
        if c == 38 do
            single_tok = TokType.BitAnd
        end
        if c == 124 and single_tok == TokType.Eof do
            single_tok = TokType.BitOr
        end
        if c == 126 do
            single_tok = TokType.BitNot
        end

        # Delimiters
        if c == 40 do
            single_tok = TokType.LParen;
            lex.paren_depth = lex.paren_depth + 1
        end
        if c == 41 do
            single_tok = TokType.RParen;
            if lex.paren_depth > 0 do
                lex.paren_depth = lex.paren_depth - 1
            end
        end
        if c == 91 do
            single_tok = TokType.LBracket;
            lex.paren_depth = lex.paren_depth + 1
        end
        if c == 93 do
            single_tok = TokType.RBracket;
            if lex.paren_depth > 0 do
                lex.paren_depth = lex.paren_depth - 1
            end
        end
        if c == 123 do
            single_tok = TokType.LBrace;
            lex.paren_depth = lex.paren_depth + 1
        end
        if c == 125 do
            single_tok = TokType.RBrace;
            if lex.paren_depth > 0 do
                lex.paren_depth = lex.paren_depth - 1
            end
        end
        if c == 44 do
            single_tok = TokType.Comma
        end
        if c == 46 and single_tok == TokType.Eof do
            single_tok = TokType.Dot
        end
        if c == 58 and single_tok == TokType.Eof do
            single_tok = TokType.Colon
        end
        if c == 59 do
            single_tok = TokType.Semicolon
        end

        if single_tok != TokType.Eof do
            tok = token_new(single_tok, lex.line, lex.col);
            var (lex2, _) = lex_advance(lex);
            lex = lex2;
            lex.tokens = vec_push(lex.tokens, tok);
            skip
        end

        # Word (keyword / identifier)
        if is_word_char(c) do
            var (lex2, tok) = lex_word(lex);
            lex = lex2;
            lex.tokens = vec_push(lex.tokens, tok);
            skip
        end

        # Unknown character — report error token & set error_msg
        err_str = fat_str_new("unexpected character");
        lex.error_msg = err_str;
        tok = token_new(TokType.Error, lex.line, lex.col);
        tok.str_val = fat_char_to_str(c);
        var (lex2, _) = lex_advance(lex);
        lex = lex2;
        lex.tokens = vec_push(lex.tokens, tok)
    end

    # Push sentinel EOF token
    lex.tokens = vec_push(lex.tokens, token_new(TokType.Eof, lex.line, lex.col));
    out lex
end.
# ═══════════════════════════════════════════════════════
# Token Name (for debug / error messages)
# ═══════════════════════════════════════════════════════

func token_name(t: TokType):

    if t == TokType.Eof do
        out fat_str_new("EOF")
    end
    if t == TokType.Int do
        out fat_str_new("INT")
    end
    if t == TokType.Float do
        out fat_str_new("FLOAT")
    end
    if t == TokType.Str do
        out fat_str_new("STRING")
    end
    if t == TokType.Ident do
        out fat_str_new("IDENT")
    end
    if t == TokType.Newline do
        out fat_str_new("NEWLINE")
    end
    if t == TokType.Func do
        out fat_str_new("FUNC")
    end
    if t == TokType.Var do
        out fat_str_new("VAR")
    end
    if t == TokType.Const do
        out fat_str_new("CONST")
    end
    if t == TokType.Entity do
        out fat_str_new("ENTITY")
    end
    if t == TokType.Enum do
        out fat_str_new("ENUM")
    end
    if t == TokType.If do
        out fat_str_new("IF")
    end
    if t == TokType.Else do
        out fat_str_new("ELSE")
    end
    if t == TokType.End do
        out fat_str_new("END")
    end
    if t == TokType.Out do
        out fat_str_new("OUT")
    end
    if t == TokType.While do
        out fat_str_new("WHILE")
    end
    if t == TokType.Error do
        out fat_str_new("ERROR")
    end
    if t == TokType.Assign do
        out fat_str_new("ASSIGN")
    end
    if t == TokType.Eq do
        out fat_str_new("EQ")
    end
    if t == TokType.Ne do
        out fat_str_new("NE")
    end
    if t == TokType.Lt do
        out fat_str_new("LT")
    end
    if t == TokType.Le do
        out fat_str_new("LE")
    end
    if t == TokType.Gt do
        out fat_str_new("GT")
    end
    if t == TokType.Ge do
        out fat_str_new("GE")
    end
    if t == TokType.Plus do
        out fat_str_new("PLUS")
    end
    if t == TokType.Minus do
        out fat_str_new("MINUS")
    end
    if t == TokType.Star do
        out fat_str_new("STAR")
    end
    if t == TokType.Slash do
        out fat_str_new("SLASH")
    end
    if t == TokType.Percent do
        out fat_str_new("PERCENT")
    end
    if t == TokType.And do
        out fat_str_new("AND")
    end
    if t == TokType.Or do
        out fat_str_new("OR")
    end
    if t == TokType.Not do
        out fat_str_new("NOT")
    end
    if t == TokType.LParen do
        out fat_str_new("LPAREN")
    end
    if t == TokType.RParen do
        out fat_str_new("RPAREN")
    end
    if t == TokType.LBracket do
        out fat_str_new("LBRACKET")
    end
    if t == TokType.RBracket do
        out fat_str_new("RBRACKET")
    end
    if t == TokType.LBrace do
        out fat_str_new("LBRACE")
    end
    if t == TokType.RBrace do
        out fat_str_new("RBRACE")
    end
    if t == TokType.Colon do
        out fat_str_new("COLON")
    end
    if t == TokType.Semicolon do
        out fat_str_new("SEMICOLON")
    end
    if t == TokType.Comma do
        out fat_str_new("COMMA")
    end
    if t == TokType.Dot do
        out fat_str_new("DOT")
    end
    if t == TokType.Import do
        out fat_str_new("IMPORT")
    end
    if t == TokType.Export do
        out fat_str_new("EXPORT")
    end
    if t == TokType.Include do
        out fat_str_new("INCLUDE")
    end
    if t == TokType.Module do
        out fat_str_new("MODULE")
    end
    if t == TokType.From do
        out fat_str_new("FROM")
    end
    if t == TokType.As do
        out fat_str_new("AS")
    end
    if t == TokType.Try do
        out fat_str_new("TRY")
    end
    out fat_str_new("???")
end.
export TokType, Token, KeywordEntry, Lexer, lexer_new, tokenize, token_name;