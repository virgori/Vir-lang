##
 * vir/compiler/lexer.vri — Vir Source Lexer (Pure Vir)
 * =====================================================
 * UTF-8 tokenizer for Vir v1.2 standard syntax.
 * Converted from C (core/src/lexer.c) for self-hosting.
 *
 * Features:
 *   - Full v1.2 keyword set (English standard)
 *   - Multi-char operators (?=, ?., :~, >>, ||, ->, ..)
 *   - Block comments (hash-hash open, hash-hash close)
 *   - Hex literal support (0x...)
 *   - Paren-depth tracking (suppress newlines inside parens)
 *   - String escape sequences (\n, \t, \\, \", \')
 ##

include types;
include result;
import Result, Ok, Err from result;
include string;
import String, str_new, str_concat, str_len, str_byte_at, str_eq from string;
include vec;
import Vec, vec_new, vec_push, vec_len, vec_get from vec;

# ═══════════════════════════════════════════════════════
# Token Types (v1.2 Standard)
# ═══════════════════════════════════════════════════════

enum TokType:
    # Literals
    Eof         = 0;
    Error       = 1;
    Int         = 2;
    Float       = 3;
    Str         = 4;
    Ident       = 5;
    Newline     = 6;

    # Definitions
    Func        = 10;
    Var         = 11;
    Const       = 12;
    Entity      = 13;
    Enum        = 14;
    Method      = 15;
    Class       = 16;
    Has         = 17;
    Share       = 18;
    Async       = 19;
    Task        = 20;
    Wait        = 21;

    # Control flow
    If          = 30;
    Else        = 31;
    Eif         = 32;
    Loop        = 33;
    While       = 34;
    When        = 35;
    For         = 36;
    Break       = 37;
    Skip        = 38;
    Out         = 39;
    Case        = 40;
    End         = 41;
    In          = 42;

    # Arithmetic operators
    Plus        = 50;
    Minus       = 51;
    Star        = 52;
    Slash       = 53;
    Percent     = 54;
    Power       = 55;
    Mod         = 56;

    # Comparison operators
    Eq          = 60;
    Ne          = 61;
    Gt          = 62;
    Lt          = 63;
    Ge          = 64;
    Le          = 65;
    SafeEq      = 66;
    SafeNe      = 67;

    # Logical operators
    And         = 70;
    Or          = 71;
    Not         = 72;

    # Bitwise operators
    BitXor      = 75;
    BitShl      = 76;
    BitShr      = 77;
    BitAnd      = 78;
    BitOr       = 79;
    BitNot      = 80;

    # Access / transform
    SafeAccess  = 85;
    Exist       = 86;
    Cast        = 87;
    Pattern     = 88;

    # Assignment
    Assign      = 90;

    # Delimiters
    LParen      = 100;
    RParen      = 101;
    LBracket    = 102;
    RBracket    = 103;
    LBrace      = 104;
    RBrace      = 105;
    Comma       = 106;
    Dot         = 107;
    DotDot      = 108;
    Colon       = 109;
    Semicolon   = 110;
    Arrow       = 111;
    DoubleColon = 112;   # ::  (module path separator)

    # I/O
    Print       = 120;
    Input       = 121;
    CheckCpu    = 122;
    Patch       = 123;

    # Module
    Import      = 130;
    From        = 131;
    Module      = 132;
    Export      = 133;
    As          = 134;
    Include     = 135;
    Get         = 136;

    # Boolean / None
    True        = 140;
    False       = 141;
    NoneLit     = 142;

    # Error handling
    Try         = 150;
    ErrorKw     = 151;
    MapKw       = 152;

    # §26.2 AI / advanced operators, §24.4 atomics, compound assign
    MatMul      = 180;   # **
    Fma         = 181;   # ><
    Lock        = 182;   # lock keyword
    AtomicBang  = 183;   # !!
    PlusAssign  = 184;   # +=
    MinusAssign = 185;   # -=
    StarAssign  = 186;   # *=
    SlashAssign = 187;   # /=
    Swizzle     = 188;   # ~ (postfix swizzle reuses BitNot lex)
end


# ═══════════════════════════════════════════════════════
# Token
# ═══════════════════════════════════════════════════════

entity Token:
    tok_type:   TokType;
    line:       int;
    col:        int;
    str_val:    string;
    int_val:    int;
    float_val:  float;
end

func token_new:
    in(t:TokType; line:int; col:int)
    out Token (;
        tok_type: t,;
        line: line,;
        col: col,;
        str_val: str_new(""),;
        int_val: 0,;
        float_val: 0.0
    );
end


# ═══════════════════════════════════════════════════════
# Keyword Lookup Table
# ═══════════════════════════════════════════════════════

entity KeywordEntry:
    word:   string;
    tok:    TokType;
end

func build_keyword_table:
    table = vec_new<KeywordEntry>();

    # Definition keywords
    vec_push(table, KeywordEntry ( word: str_new("func"), tok: TokType::Func ));
    vec_push(table, KeywordEntry ( word: str_new("function"), tok: TokType::Func ));
    vec_push(table, KeywordEntry ( word: str_new("var"), tok: TokType::Var ));
    vec_push(table, KeywordEntry ( word: str_new("let"), tok: TokType::Var ));
    vec_push(table, KeywordEntry ( word: str_new("const"), tok: TokType::Const ));
    vec_push(table, KeywordEntry ( word: str_new("entity"), tok: TokType::Entity ));
    vec_push(table, KeywordEntry ( word: str_new("enum"), tok: TokType::Enum ));
    vec_push(table, KeywordEntry ( word: str_new("method"), tok: TokType::Method ));
    vec_push(table, KeywordEntry ( word: str_new("class"), tok: TokType::Class ));
    vec_push(table, KeywordEntry ( word: str_new("has"), tok: TokType::Has ));
    vec_push(table, KeywordEntry ( word: str_new("share"), tok: TokType::Share ));
    vec_push(table, KeywordEntry ( word: str_new("async"), tok: TokType::Async ));
    vec_push(table, KeywordEntry ( word: str_new("task"), tok: TokType::Task ));
    vec_push(table, KeywordEntry ( word: str_new("wait"), tok: TokType::Wait ));

    # Control flow keywords
    vec_push(table, KeywordEntry ( word: str_new("if"), tok: TokType::If ));
    vec_push(table, KeywordEntry ( word: str_new("else"), tok: TokType::Else ));
    vec_push(table, KeywordEntry ( word: str_new("eif"), tok: TokType::Eif ));
    vec_push(table, KeywordEntry ( word: str_new("loop"), tok: TokType::Loop ));
    vec_push(table, KeywordEntry ( word: str_new("while"), tok: TokType::While ));
    vec_push(table, KeywordEntry ( word: str_new("when"), tok: TokType::When ));
    vec_push(table, KeywordEntry ( word: str_new("for"), tok: TokType::For ));
    vec_push(table, KeywordEntry ( word: str_new("break"), tok: TokType::Break ));
    vec_push(table, KeywordEntry ( word: str_new("skip"), tok: TokType::Skip ));
    vec_push(table, KeywordEntry ( word: str_new("continue"), tok: TokType::Skip ));
    vec_push(table, KeywordEntry ( word: str_new("out"), tok: TokType::Out ));
    vec_push(table, KeywordEntry ( word: str_new("return"), tok: TokType::Out ));
    vec_push(table, KeywordEntry ( word: str_new("case"), tok: TokType::Case ));
    vec_push(table, KeywordEntry ( word: str_new("end"), tok: TokType::End ));
    vec_push(table, KeywordEntry ( word: str_new("in"), tok: TokType::In ));

    # I/O keywords
    vec_push(table, KeywordEntry ( word: str_new("print"), tok: TokType::Print ));
    vec_push(table, KeywordEntry ( word: str_new("input"), tok: TokType::Input ));
    vec_push(table, KeywordEntry ( word: str_new("check_cpu"), tok: TokType::CheckCpu ));
    vec_push(table, KeywordEntry ( word: str_new("patch"), tok: TokType::Patch ));

    # Boolean / None
    vec_push(table, KeywordEntry ( word: str_new("true"), tok: TokType::True ));
    vec_push(table, KeywordEntry ( word: str_new("false"), tok: TokType::False ));
    vec_push(table, KeywordEntry ( word: str_new("none"), tok: TokType::NoneLit ));

    # Logical
    vec_push(table, KeywordEntry ( word: str_new("and"), tok: TokType::And ));
    vec_push(table, KeywordEntry ( word: str_new("or"), tok: TokType::Or ));
    vec_push(table, KeywordEntry ( word: str_new("not"), tok: TokType::Not ));

    # Bitwise keywords
    vec_push(table, KeywordEntry ( word: str_new("xor"), tok: TokType::BitXor ));
    vec_push(table, KeywordEntry ( word: str_new("shl"), tok: TokType::BitShl ));
    vec_push(table, KeywordEntry ( word: str_new("shr"), tok: TokType::BitShr ));
    vec_push(table, KeywordEntry ( word: str_new("mod"), tok: TokType::Mod ));

    # Module keywords
    vec_push(table, KeywordEntry ( word: str_new("import"), tok: TokType::Import ));
    vec_push(table, KeywordEntry ( word: str_new("from"), tok: TokType::From ));
    vec_push(table, KeywordEntry ( word: str_new("module"), tok: TokType::Module ));
    vec_push(table, KeywordEntry ( word: str_new("export"), tok: TokType::Export ));
    vec_push(table, KeywordEntry ( word: str_new("as"), tok: TokType::As ));
    vec_push(table, KeywordEntry ( word: str_new("include"), tok: TokType::Include ));
    vec_push(table, KeywordEntry ( word: str_new("get"), tok: TokType::Get ));

    # Error handling
    vec_push(table, KeywordEntry ( word: str_new("try"), tok: TokType::Try ));
    vec_push(table, KeywordEntry ( word: str_new("error"), tok: TokType::ErrorKw ));
    vec_push(table, KeywordEntry ( word: str_new("map"), tok: TokType::MapKw ));

    # Legacy compatibility
    vec_push(table, KeywordEntry ( word: str_new("struct"), tok: TokType::Entity ));
    vec_push(table, KeywordEntry ( word: str_new("record"), tok: TokType::Entity ));
    vec_push(table, KeywordEntry ( word: str_new("elif"), tok: TokType::Eif ));
    vec_push(table, KeywordEntry ( word: str_new("then"), tok: TokType::End ));

    # ── §28 Tiếng Việt (single-word aliases) ──
    vec_push(table, KeywordEntry ( word: str_new("hàm"), tok: TokType::Func ));
    vec_push(table, KeywordEntry ( word: str_new("biến"), tok: TokType::Var ));
    vec_push(table, KeywordEntry ( word: str_new("hằng"), tok: TokType::Const ));
    vec_push(table, KeywordEntry ( word: str_new("nếu"), tok: TokType::If ));
    vec_push(table, KeywordEntry ( word: str_new("lặp"), tok: TokType::Loop ));
    vec_push(table, KeywordEntry ( word: str_new("hết"), tok: TokType::End ));
    vec_push(table, KeywordEntry ( word: str_new("nhập"), tok: TokType::Input ));
    vec_push(table, KeywordEntry ( word: str_new("đúng"), tok: TokType::True ));
    vec_push(table, KeywordEntry ( word: str_new("sai"), tok: TokType::False ));
    vec_push(table, KeywordEntry ( word: str_new("rỗng"), tok: TokType::NoneLit ));
    vec_push(table, KeywordEntry ( word: str_new("và"), tok: TokType::And ));
    vec_push(table, KeywordEntry ( word: str_new("hoặc"), tok: TokType::Or ));
    vec_push(table, KeywordEntry ( word: str_new("thoát"), tok: TokType::Break ));
    vec_push(table, KeywordEntry ( word: str_new("trong"), tok: TokType::In ));
    vec_push(table, KeywordEntry ( word: str_new("bản_ghi"), tok: TokType::Entity ));
    vec_push(table, KeywordEntry ( word: str_new("liệt_kê"), tok: TokType::Enum ));
    vec_push(table, KeywordEntry ( word: str_new("nhập_khẩu"), tok: TokType::Import ));
    vec_push(table, KeywordEntry ( word: str_new("từ"), tok: TokType::From ));
    vec_push(table, KeywordEntry ( word: str_new("mô_đun"), tok: TokType::Module ));
    vec_push(table, KeywordEntry ( word: str_new("xuất"), tok: TokType::Export ));
    vec_push(table, KeywordEntry ( word: str_new("bao_gồm"), tok: TokType::Include ));

    # ── §28 中文 (Simplified Chinese) ──
    vec_push(table, KeywordEntry ( word: str_new("函数"), tok: TokType::Func ));
    vec_push(table, KeywordEntry ( word: str_new("变量"), tok: TokType::Var ));
    vec_push(table, KeywordEntry ( word: str_new("常量"), tok: TokType::Const ));
    vec_push(table, KeywordEntry ( word: str_new("如果"), tok: TokType::If ));
    vec_push(table, KeywordEntry ( word: str_new("否则"), tok: TokType::Else ));
    vec_push(table, KeywordEntry ( word: str_new("循环"), tok: TokType::Loop ));
    vec_push(table, KeywordEntry ( word: str_new("结束"), tok: TokType::End ));
    vec_push(table, KeywordEntry ( word: str_new("返回"), tok: TokType::Out ));
    vec_push(table, KeywordEntry ( word: str_new("真"), tok: TokType::True ));
    vec_push(table, KeywordEntry ( word: str_new("假"), tok: TokType::False ));
    vec_push(table, KeywordEntry ( word: str_new("空"), tok: TokType::NoneLit ));
    vec_push(table, KeywordEntry ( word: str_new("打印"), tok: TokType::Print ));
    vec_push(table, KeywordEntry ( word: str_new("输入"), tok: TokType::Input ));
    vec_push(table, KeywordEntry ( word: str_new("导入"), tok: TokType::Import ));
    vec_push(table, KeywordEntry ( word: str_new("导出"), tok: TokType::Export ));
    vec_push(table, KeywordEntry ( word: str_new("模块"), tok: TokType::Module ));
    vec_push(table, KeywordEntry ( word: str_new("包含"), tok: TokType::Include ));
    vec_push(table, KeywordEntry ( word: str_new("跳出"), tok: TokType::Break ));
    vec_push(table, KeywordEntry ( word: str_new("继续"), tok: TokType::Skip ));
    vec_push(table, KeywordEntry ( word: str_new("与"), tok: TokType::And ));
    vec_push(table, KeywordEntry ( word: str_new("或"), tok: TokType::Or ));
    vec_push(table, KeywordEntry ( word: str_new("非"), tok: TokType::Not ));

    # ── §28 日本語 (Japanese) ──
    vec_push(table, KeywordEntry ( word: str_new("関数"), tok: TokType::Func ));
    vec_push(table, KeywordEntry ( word: str_new("変数"), tok: TokType::Var ));
    vec_push(table, KeywordEntry ( word: str_new("定数"), tok: TokType::Const ));
    vec_push(table, KeywordEntry ( word: str_new("もし"), tok: TokType::If ));
    vec_push(table, KeywordEntry ( word: str_new("そうでなければ"), tok: TokType::Else ));
    vec_push(table, KeywordEntry ( word: str_new("繰り返し"), tok: TokType::Loop ));
    vec_push(table, KeywordEntry ( word: str_new("終わり"), tok: TokType::End ));
    vec_push(table, KeywordEntry ( word: str_new("戻る"), tok: TokType::Out ));
    vec_push(table, KeywordEntry ( word: str_new("真_"), tok: TokType::True ));
    vec_push(table, KeywordEntry ( word: str_new("偽"), tok: TokType::False ));
    vec_push(table, KeywordEntry ( word: str_new("印刷"), tok: TokType::Print ));
    vec_push(table, KeywordEntry ( word: str_new("入力"), tok: TokType::Input ));
    vec_push(table, KeywordEntry ( word: str_new("読込"), tok: TokType::Import ));

    # ── §28 한국어 (Korean) ──
    vec_push(table, KeywordEntry ( word: str_new("함수"), tok: TokType::Func ));
    vec_push(table, KeywordEntry ( word: str_new("변수"), tok: TokType::Var ));
    vec_push(table, KeywordEntry ( word: str_new("상수"), tok: TokType::Const ));
    vec_push(table, KeywordEntry ( word: str_new("만약"), tok: TokType::If ));
    vec_push(table, KeywordEntry ( word: str_new("아니면"), tok: TokType::Else ));
    vec_push(table, KeywordEntry ( word: str_new("반복"), tok: TokType::Loop ));
    vec_push(table, KeywordEntry ( word: str_new("끝"), tok: TokType::End ));
    vec_push(table, KeywordEntry ( word: str_new("반환"), tok: TokType::Out ));
    vec_push(table, KeywordEntry ( word: str_new("참"), tok: TokType::True ));
    vec_push(table, KeywordEntry ( word: str_new("거짓"), tok: TokType::False ));
    vec_push(table, KeywordEntry ( word: str_new("출력"), tok: TokType::Print ));
    vec_push(table, KeywordEntry ( word: str_new("입력"), tok: TokType::Input ));
    vec_push(table, KeywordEntry ( word: str_new("가져오기"), tok: TokType::Import ));

    out table;
end

# §28.3 — Runtime keyword registration API.
# Callers can inject custom aliases into an existing Lexer's keyword table.
# Mirrors C core `vir_register_keyword()` (lexer.h).
func register_keyword:
    in(lex:Lexer; word:string; tok:TokType)
    vec_push(lex.keywords, KeywordEntry ( word: word, tok: tok ));
    out lex;
end

func lookup_keyword:
    in(table:Vec<KeywordEntry>; word:string)
    i = 0;
    when i < vec_len(table) loop
        entry = vec_get(table, i);
        if str_eq(entry.word, word):
            out entry.tok;
        end
        i = i + 1;
    end
    out TokType::Eof  # not found;
end


# ═══════════════════════════════════════════════════════
# Lexer State
# ═══════════════════════════════════════════════════════

entity Lexer:
    source:         string;
    source_len:     int;
    pos:            int;
    line:           int;
    col:            int;
    tokens:         Vec<Token>;
    paren_depth:    int;
    keywords:       Vec<KeywordEntry>;
    error_msg:          string;
end

func lexer_new:
    in(source:string)
    out Lexer (;
        source: source,;
        source_len: str_len(source),;
        pos: 0,;
        line: 1,;
        col: 1,;
        tokens: vec_new(),;
        paren_depth: 0,;
        keywords: build_keyword_table(),;
        error_msg: str_new("")
    );
end


# ═══════════════════════════════════════════════════════
# Character Helpers
# ═══════════════════════════════════════════════════════

func is_eof:
    in(lex:Lexer)
    out lex.pos >= lex.source_len;
end

func lex_peek:
    in(lex:Lexer)
    if lex.pos < lex.source_len:
        out str_byte_at(lex.source, lex.pos);
    end
    out 0;
end

func lex_peek_at:
    in(lex:Lexer; offset:int)
    p = lex.pos + offset;
    if p < lex.source_len:
        out str_byte_at(lex.source, p);
    end
    out 0;
end

func lex_advance:
    in(lex:Lexer)
    c = lex_peek(lex);
    if c == 10  # '\n':
        lex.line = lex.line + 1;
        lex.col = 1;
    else
        lex.col = lex.col + 1;
    end
    lex.pos = lex.pos + 1;
    out (lex, c);
end

func is_alpha:
    in(c:int)
    out (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or c == 95;
end

func is_digit:
    in(c:int)
    out c >= 48 and c <= 57;
end

func is_hex_digit:
    in(c:int)
    out is_digit(c) or (c >= 65 and c <= 70) or (c >= 97 and c <= 102);
end

func is_word_char:
    in(c:int)
    out is_alpha(c) or is_digit(c) or c >= 128;
end


# ═══════════════════════════════════════════════════════
# Skip Whitespace & Comments
# ═══════════════════════════════════════════════════════

func skip_whitespace:
    in(lex:Lexer)
    when not is_eof(lex) loop
        c = lex_peek(lex);
        if c == 32 or c == 9 or c == 13   # space, tab, CR:
            var (lex2, _) = lex_advance(lex);
            lex = lex2;
        else
            out lex;
        end
    end
    out lex;
end

func skip_comment:
    in(lex:Lexer)
    # Single-line comment: # ... until \n
    when not is_eof(lex) and lex_peek(lex) != 10 loop
        var (lex2, _) = lex_advance(lex);
        lex = lex2;
    end
    out lex;
end

func skip_block_comment:
    in(lex:Lexer)
    # Block comment: ## ... ##
    var (lex2, _) = lex_advance(lex)  # skip first #;
    var (lex3, _) = lex_advance(lex2)  # skip second #;
    lex = lex3;
    when not is_eof(lex) loop
        if lex_peek(lex) == 35 and lex_peek_at(lex, 1) == 35:
            var (lex4, _) = lex_advance(lex);
            var (lex5, _) = lex_advance(lex4);
            out lex5;
        end
        var (lex6, _) = lex_advance(lex);
        lex = lex6;
    end
    out lex;
end


# ═══════════════════════════════════════════════════════
# Number Lexing
# ═══════════════════════════════════════════════════════

func lex_number:
    in(lex:Lexer)
    tok = token_new(TokType::Int, lex.line, lex.col);
    num = 0;
    is_float = false;

    # Hex literal
    if lex_peek(lex) == 48 and (lex_peek_at(lex, 1) == 120 or lex_peek_at(lex, 1) == 88):
        var (lex2, _) = lex_advance(lex)    # 0;
        var (lex3, _) = lex_advance(lex2)   # x;
        lex = lex3;
        when not is_eof(lex) and is_hex_digit(lex_peek(lex)) loop
            c = lex_peek(lex);
            digit = 0;
            if c >= 48 and c <= 57:
                digit = (c - 48) >> int;
            end
            if c >= 65 and c <= 70:
                digit = (c - 55) >> int;
            end
            if c >= 97 and c <= 102:
                digit = (c - 87) >> int;
            end
            num = num * 16 + digit;
            var (lex4, _) = lex_advance(lex);
            lex = lex4;
        end
        tok.int_val = num;
        out (lex, tok);
    end

    # Octal literal (0o...)
    if lex_peek(lex) == 48 and (lex_peek_at(lex, 1) == 111 or lex_peek_at(lex, 1) == 79):
        var (lex2, _) = lex_advance(lex)    # 0;
        var (lex3, _) = lex_advance(lex2)   # o;
        lex = lex3;
        when not is_eof(lex) and is_digit(lex_peek(lex)) loop
            c = lex_peek(lex);
            if c >= 48 and c <= 55:   # '0' to '7'
                digit = (c - 48) >> int;
                num = num * 8 + digit;
            end
            var (lex4, _) = lex_advance(lex);
            lex = lex4;
        end
        tok.int_val = num;
        out (lex, tok);
    end

    # Decimal literal (integer or float)
    when not is_eof(lex) and (is_digit(lex_peek(lex)) or lex_peek(lex) == 46) loop
        c = lex_peek(lex);
        if c == 46  # '.':
            if is_float:
                # Second dot — stop
                out (lex, tok);
            end
            # Check for .. range operator
            if lex_peek_at(lex, 1) == 46:
                out (lex, tok);
            end
            is_float = true;
        end
        var (lex2, _) = lex_advance(lex);
        lex = lex2;
    end

    # Parse value from the accumulated string range
    # (In a real implementation, accumulate digits into a buffer)
    if is_float:
        tok.tok_type = TokType::Float;
    end

    out (lex, tok);
end


# ═══════════════════════════════════════════════════════
# String Lexing
# ═══════════════════════════════════════════════════════

func lex_string:
    in(lex:Lexer)
    tok = token_new(TokType::Str, lex.line, lex.col);
    var (lex2, quote) = lex_advance(lex)  # consume opening quote;
    lex = lex2;
    buf = str_new("");

    when not is_eof(lex) and lex_peek(lex) != quote loop
        if lex_peek(lex) == 92  # backslash:
            var (lex3, _) = lex_advance(lex);
            lex = lex3;
            if is_eof(lex):
                out (lex, tok);
            end
            var (lex4, esc) = lex_advance(lex);
            lex = lex4;
            if esc == 110      # \n:
                buf = str_concat(buf, str_new("\n"));
            end
            if esc == 116      # \t:
                buf = str_concat(buf, str_new("\t"));
            end
            if esc == 92       # \\:
                buf = str_concat(buf, str_new("\\"));
            end
            if esc == 34       # \":
                buf = str_concat(buf, str_new("\""));
            end
            if esc == 39       # \':
                buf = str_concat(buf, str_new("'"));
            end
        else
            var (lex5, ch) = lex_advance(lex);
            lex = lex5;
            buf = str_concat(buf, char_to_str(ch));
        end
    end

    # Consume closing quote
    if not is_eof(lex):
        var (lex6, _) = lex_advance(lex);
        lex = lex6;
    end

    tok.str_val = buf;
    out (lex, tok);
end


# ═══════════════════════════════════════════════════════
# Word / Keyword Lexing
# ═══════════════════════════════════════════════════════

func lex_word:
    in(lex:Lexer)
    start_line = lex.line;
    start_col = lex.col;
    buf = str_new("");

    when not is_eof(lex) and is_word_char(lex_peek(lex)) loop
        var (lex2, ch) = lex_advance(lex);
        lex = lex2;
        buf = str_concat(buf, char_to_str(ch));
    end

    # Lookup keyword
    kw_type = lookup_keyword(lex.keywords, buf);
    if kw_type != TokType::Eof:
        tok = token_new(kw_type, start_line, start_col);
        out (lex, tok);
    end

    # Identifier
    tok = token_new(TokType::Ident, start_line, start_col);
    tok.str_val = buf;
    out (lex, tok);
end


# ═══════════════════════════════════════════════════════
# Main Tokenize Loop
# ═══════════════════════════════════════════════════════

func tokenize:
    in(lex:Lexer)
    prev_was_newline = true;

    when not is_eof(lex) loop
        lex = skip_whitespace(lex);
        if is_eof(lex):
            out lex;
        end

        c = lex_peek(lex);

        # Newline (statement separator)
        if c == 10:
            var (lex2, _) = lex_advance(lex);
            lex = lex2;
            if not prev_was_newline and lex.paren_depth == 0:
                vec_push(lex.tokens, token_new(TokType::Newline, lex.line, lex.col));
                prev_was_newline = true;
            end
            skip  # continue;
        end

        prev_was_newline = false;

        # Comment
        if c == 35  # '#':
            if lex_peek_at(lex, 1) == 35:
                lex = skip_block_comment(lex);
            else
                lex = skip_comment(lex);
            end
            skip;
        end

        # String literal
        if c == 34 or c == 39  # " or ':
            var (lex2, tok) = lex_string(lex);
            lex = lex2;
            vec_push(lex.tokens, tok);
            skip;
        end

        # Number literal
        if is_digit(c):
            var (lex2, tok) = lex_number(lex);
            lex = lex2;
            vec_push(lex.tokens, tok);
            skip;
        end

        # Multi-char operators
        c2 = lex_peek_at(lex, 1);

        if c == 61 and c2 == 61  # ==:
            tok = token_new(TokType::Eq, lex.line, lex.col);
            var (l1, _) = lex_advance(lex);
            var (l2, _) = lex_advance(l1);
            lex = l2;
            vec_push(lex.tokens, tok);
            skip;
        end

        if c == 33 and c2 == 61  # !=:
            tok = token_new(TokType::Ne, lex.line, lex.col);
            var (l1, _) = lex_advance(lex);
            var (l2, _) = lex_advance(l1);
            lex = l2;
            vec_push(lex.tokens, tok);
            skip;
        end

        if c == 62 and c2 == 61  # >=:
            tok = token_new(TokType::Ge, lex.line, lex.col);
            var (l1, _) = lex_advance(lex);
            var (l2, _) = lex_advance(l1);
            lex = l2;
            vec_push(lex.tokens, tok);
            skip;
        end

        if c == 60 and c2 == 61  # <=:
            tok = token_new(TokType::Le, lex.line, lex.col);
            var (l1, _) = lex_advance(lex);
            var (l2, _) = lex_advance(l1);
            lex = l2;
            vec_push(lex.tokens, tok);
            skip;
        end

        # ?=/= (safe not-equal — 4 chars)
        if c == 63 and c2 == 61 and lex_peek_at(lex, 2) == 47 and lex_peek_at(lex, 3) == 61:
            tok = token_new(TokType::SafeNe, lex.line, lex.col);
            var (l1, _) = lex_advance(lex);
            var (l2, _) = lex_advance(l1);
            var (l3, _) = lex_advance(l2);
            var (l4, _) = lex_advance(l3);
            lex = l4;
            vec_push(lex.tokens, tok);
            skip;
        end

        # ?= (safe equal)
        if c == 63 and c2 == 61:
            tok = token_new(TokType::SafeEq, lex.line, lex.col);
            var (l1, _) = lex_advance(lex);
            var (l2, _) = lex_advance(l1);
            lex = l2;
            vec_push(lex.tokens, tok);
            skip;
        end

        # ?. (safe member access)
        if c == 63 and c2 == 46:
            tok = token_new(TokType::SafeAccess, lex.line, lex.col);
            var (l1, _) = lex_advance(lex);
            var (l2, _) = lex_advance(l1);
            lex = l2;
            vec_push(lex.tokens, tok);
            skip;
        end

        # :~ (pattern match)
        if c == 58 and c2 == 126:
            tok = token_new(TokType::Pattern, lex.line, lex.col);
            var (l1, _) = lex_advance(lex);
            var (l2, _) = lex_advance(l1);
            lex = l2;
            vec_push(lex.tokens, tok);
            skip;
        end

        # || (logical OR)
        if c == 124 and c2 == 124:
            tok = token_new(TokType::Or, lex.line, lex.col);
            var (l1, _) = lex_advance(lex);
            var (l2, _) = lex_advance(l1);
            lex = l2;
            vec_push(lex.tokens, tok);
            skip;
        end

        # -> (arrow)
        if c == 45 and c2 == 62:
            tok = token_new(TokType::Arrow, lex.line, lex.col);
            var (l1, _) = lex_advance(lex);
            var (l2, _) = lex_advance(l1);
            lex = l2;
            vec_push(lex.tokens, tok);
            skip;
        end

        # << (bit shift left)
        if c == 60 and c2 == 60:
            tok = token_new(TokType::BitShl, lex.line, lex.col);
            var (l1, _) = lex_advance(lex);
            var (l2, _) = lex_advance(l1);
            lex = l2;
            vec_push(lex.tokens, tok);
            skip;
        end

        # >> (cast in v1.2)
        if c == 62 and c2 == 62:
            tok = token_new(TokType::Cast, lex.line, lex.col);
            var (l1, _) = lex_advance(lex);
            var (l2, _) = lex_advance(l1);
            lex = l2;
            vec_push(lex.tokens, tok);
            skip;
        end

        # .. (range)
        if c == 46 and c2 == 46:
            tok = token_new(TokType::DotDot, lex.line, lex.col);
            var (l1, _) = lex_advance(lex);
            var (l2, _) = lex_advance(l1);
            lex = l2;
            vec_push(lex.tokens, tok);
            skip;
        end

        # :: (module path separator)
        if c == 58 and c2 == 58:
            tok = token_new(TokType::DoubleColon, lex.line, lex.col);
            var (l1, _) = lex_advance(lex);
            var (l2, _) = lex_advance(l1);
            lex = l2;
            vec_push(lex.tokens, tok);
            skip;
        end

        # Single-char operators
        single_tok = TokType::Eof;
        if c == 43:
            single_tok = TokType::Plus;
        end
        if c == 45 and single_tok == TokType::Eof:
            single_tok = TokType::Minus;
        end
        if c == 42:
            single_tok = TokType::Star;
        end
        if c == 47:
            single_tok = TokType::Slash;
        end
        if c == 37:
            single_tok = TokType::Percent;
        end
        if c == 94:
            single_tok = TokType::Power;
        end
        if c == 61 and single_tok == TokType::Eof:
            single_tok = TokType::Assign;
        end
        if c == 62 and single_tok == TokType::Eof:
            single_tok = TokType::Gt;
        end
        if c == 60 and single_tok == TokType::Eof:
            single_tok = TokType::Lt;
        end
        if c == 33 and single_tok == TokType::Eof:
            single_tok = TokType::Not;
        end
        if c == 63 and single_tok == TokType::Eof:
            single_tok = TokType::Exist;
        end
        if c == 38:
            single_tok = TokType::And;
        end
        if c == 124 and single_tok == TokType::Eof:
            single_tok = TokType::BitOr;
        end
        if c == 126:
            single_tok = TokType::BitNot;
        end

        # Delimiters
        if c == 40:
            single_tok = TokType::LParen;
            lex.paren_depth = lex.paren_depth + 1;
        end
        if c == 41:
            single_tok = TokType::RParen;
            if lex.paren_depth > 0:
                lex.paren_depth = lex.paren_depth - 1;
            end
        end
        if c == 91:
            single_tok = TokType::LBracket;
            lex.paren_depth = lex.paren_depth + 1;
        end
        if c == 93:
            single_tok = TokType::RBracket;
            if lex.paren_depth > 0:
                lex.paren_depth = lex.paren_depth - 1;
            end
        end
        if c == 123:
            single_tok = TokType::LBrace;
            lex.paren_depth = lex.paren_depth + 1;
        end
        if c == 125:
            single_tok = TokType::RBrace;
            if lex.paren_depth > 0:
                lex.paren_depth = lex.paren_depth - 1;
            end
        end
        if c == 44:
            single_tok = TokType::Comma;
        end
        if c == 46 and single_tok == TokType::Eof:
            single_tok = TokType::Dot;
        end
        if c == 58 and single_tok == TokType::Eof:
            single_tok = TokType::Colon;
        end
        if c == 59:
            single_tok = TokType::Semicolon;
        end

        if single_tok != TokType::Eof:
            tok = token_new(single_tok, lex.line, lex.col);
            var (lex2, _) = lex_advance(lex);
            lex = lex2;
            vec_push(lex.tokens, tok);
            skip;
        end

        # Word (keyword / identifier)
        if is_word_char(c):
            var (lex2, tok) = lex_word(lex);
            lex = lex2;
            vec_push(lex.tokens, tok);
            skip;
        end

        # Unknown character — skip
        var (lex2, _) = lex_advance(lex);
        lex = lex2;
    end

    # Push sentinel EOF token
    vec_push(lex.tokens, token_new(TokType::Eof, lex.line, lex.col));
    out lex;
end


# ═══════════════════════════════════════════════════════
# Token Name (for debug / error messages)
# ═══════════════════════════════════════════════════════

func token_name:
    in(t:TokType)
    if t == TokType::Eof:
        out str_new("EOF");
    end
    if t == TokType::Int:
        out str_new("INT");
    end
    if t == TokType::Float:
        out str_new("FLOAT");
    end
    if t == TokType::Str:
        out str_new("STRING");
    end
    if t == TokType::Ident:
        out str_new("IDENT");
    end
    if t == TokType::Newline:
        out str_new("NEWLINE");
    end
    if t == TokType::Func:
        out str_new("FUNC");
    end
    if t == TokType::Var:
        out str_new("VAR");
    end
    if t == TokType::Const:
        out str_new("CONST");
    end
    if t == TokType::Entity:
        out str_new("ENTITY");
    end
    if t == TokType::Enum:
        out str_new("ENUM");
    end
    if t == TokType::If:
        out str_new("IF");
    end
    if t == TokType::Else:
        out str_new("ELSE");
    end
    if t == TokType::End:
        out str_new("END");
    end
    if t == TokType::Out:
        out str_new("OUT");
    end
    if t == TokType::While:
        out str_new("WHILE");
    end
    if t == TokType::Break:
        out str_new("BREAK");
    end
    if t == TokType::Skip:
        out str_new("SKIP");
    end
    out str_new("???");
end
