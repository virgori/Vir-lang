    table = vec_push(table, KeywordEntry ( word: fat_str_new("class"), tok: TokType.Class ));
    table = vec_push(table, KeywordEntry ( word: fat_str_new("has"), tok: TokType.Has ));
    table = vec_push(table, KeywordEntry ( word: fat_str_new("share"), tok: TokType.Share ));
    table = vec_push(table, KeywordEntry ( word: fat_str_new("async"), tok: TokType.Async ));
    table = vec_push(table, KeywordEntry ( word: fat_str_new("task"), tok: TokType.Task ));
    table = vec_push(table, KeywordEntry ( word: fat_str_new("wait"), tok: TokType.Wait ));
    table = vec_push(table, KeywordEntry ( word: fat_str_new("if"), tok: TokType.If ));
    table = vec_push(table, KeywordEntry ( word: fat_str_new("else"), tok: TokType.Else ));
    table = vec_push(table, KeywordEntry ( word: fat_str_new("eif"), tok: TokType.Eif ));
    table = vec_push(table, KeywordEntry ( word: fat_str_new("loop"), tok: TokType.Loop ));
    table = vec_push(table, KeywordEntry ( word: fat_str_new("while"), tok: TokType.While ));
    table = vec_push(table, KeywordEntry ( word: fat_str_new("when"), tok: TokType.When ));
    table = vec_push(table, KeywordEntry ( word: fat_str_new("for"), tok: TokType.For ));
    table = vec_push(table, KeywordEntry ( word: fat_str_new("break"), tok: TokType.Break ));
    table = vec_push(table, KeywordEntry ( word: fat_str_new("skip"), tok: TokType.Skip ));
