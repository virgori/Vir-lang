# Keyword lookup index.  The old path scanned all ~100 keywords for every
# source word.  Bucket by first byte + length so a lookup normally compares
# only one or two candidates while keeping the table as the source of truth.
const KW_LEN_SLOTS: int = 32
const KW_BUCKET_COUNT: int = 8192
const KW_MAX_ENTRIES: int = 256
var g_kw_bucket_head: i64 = 0
var g_kw_bucket_next: i64 = 0

func keyword_bucket_build(table: Vec<KeywordEntry>):
    if g_kw_bucket_head == 0 do
        g_kw_bucket_head = vir_alloc(KW_BUCKET_COUNT * 8)
    end
    if g_kw_bucket_next == 0 do
        g_kw_bucket_next = vir_alloc(KW_MAX_ENTRIES * 8)
    end

    var i = 0
    when i < KW_BUCKET_COUNT loop
        native_write_i64(g_kw_bucket_head, i * 8, 0)
        i = i + 1
    end

    count = vec_len(table)
    i = 0
    when i < count and i < KW_MAX_ENTRIES loop
        entry = vec_get(table, i)
        word_len = fat_str_len(entry.word)
        if word_len > 0 and word_len < KW_LEN_SLOTS do
            first = fat_str_byte_at(entry.word, 0)
            key = first * KW_LEN_SLOTS + word_len
            head = native_read_i64(g_kw_bucket_head, key * 8)
            native_write_i64(g_kw_bucket_next, i * 8, head)
            native_write_i64(g_kw_bucket_head, key * 8, i + 1)
        end
        i = i + 1
    end
end.

func build_keyword_table:
    table = vec_new<KeywordEntry>()
    table = kw_table_part1(table)
    table = kw_table_part2(table)
    keyword_bucket_build(table)
    out table
end.
# Zero-copy keyword match: compare lexeme span in source buffer (no substring alloc).
func lookup_keyword_span(table: Vec<KeywordEntry>, source: string, start: int, span_len: int):
    if span_len <= 0 do out TokType.Error end
    if span_len >= KW_LEN_SLOTS or g_kw_bucket_head == 0 or g_kw_bucket_next == 0 do
        i = 0
        when i < vec_len(table) loop
            entry = vec_get(table, i)
            if fat_str_len(entry.word) == span_len do
                if fat_str_eq_span(source, start, span_len, entry.word) do out entry.tok end
            end
            i = i + 1
        end
        out TokType.Error
    end
    first = fat_str_byte_at(source, start)
    key = first * KW_LEN_SLOTS + span_len
    link = native_read_i64(g_kw_bucket_head, key * 8)
    when link > 0 loop
        i = link - 1
        entry = vec_get(table, i)
        if fat_str_eq_span(source, start, span_len, entry.word) do
            out entry.tok
        end
        link = native_read_i64(g_kw_bucket_next, i * 8)
    end
    # Runtime keyword registration may grow beyond the fixed fast index.
    i = KW_MAX_ENTRIES
    when i < vec_len(table) loop
        entry = vec_get(table, i)
        if fat_str_len(entry.word) == span_len do
            if fat_str_eq_span(source, start, span_len, entry.word) do out entry.tok end
        end
        i = i + 1
    end
    out TokType.Error
end.
# ═══════════════════════════════════════════════════════
# Lexer State
# ═══════════════════════════════════════════════════════

entity Lexer:
    source:         string,
        source_len:     int,
        pos:            int,
        line:           int,
        col:            int,
        tokens:         Vec<Token>,
        paren_depth:    int,
        keywords:       Vec<KeywordEntry>,
        error_msg:          string
end.

# Stable C-VM hand-off.  Returning the Lexer aggregate can lose fields when
# the caller performs another CALL, so publish the final token vector/error
# from inside tokenize while the aggregate is still live.
var g_lexer_tokens: i64 = 0
var g_lexer_error: i64 = 0
var g_lexer_source: i64 = 0
var g_lexer_source_data: i64 = 0
var g_ident_intern: i64 = 0

func ident_intern_reset():
    g_ident_intern = 0
end.

# Materialize identifier from source span.  Do NOT linear-scan a growing
# intern table here: on large inputs (parser.vri ~50k tokens) that is O(n²)
# string compares and looks like a silent hang in C-VM.
func ident_intern_span(source: int, start: int, span_len: int):
    out fat_str_slice(source, start, span_len)
end.

# ASCII class flags for single-pass lexer hot path (256-byte lookup).
const LEX_C_SPACE: int = 1
const LEX_C_DIGIT: int = 2
const LEX_C_ID_START: int = 4
const LEX_C_ID_CONT: int = 8

var g_lex_ascii: i64 = 0
var g_lex_single: i64 = 0

func lex_single_store(c: int, tok: TokType):
    native_write_i64(g_lex_single, c * 8, tok as int)
end.

func lex_single_init():
    if g_lex_single != 0 do out end
    if g_lex_ascii == 0 do lex_ascii_init() end
    g_lex_single = vir_alloc(256 * 8)
    var c = 0
    when c < 256 loop
        native_write_i64(g_lex_single, c * 8, 0)
        c = c + 1
    end
    lex_single_store(43, TokType.Plus)
    lex_single_store(45, TokType.Minus)
    lex_single_store(42, TokType.Star)
    lex_single_store(47, TokType.Slash)
    lex_single_store(37, TokType.Percent)
    lex_single_store(94, TokType.Power)
    lex_single_store(61, TokType.Assign)
    lex_single_store(62, TokType.Gt)
    lex_single_store(60, TokType.Lt)
    lex_single_store(33, TokType.Not)
    lex_single_store(63, TokType.Exist)
    lex_single_store(38, TokType.BitAnd)
    lex_single_store(124, TokType.BitOr)
    lex_single_store(126, TokType.BitNot)
    lex_single_store(40, TokType.LParen)
    lex_single_store(41, TokType.RParen)
    lex_single_store(91, TokType.LBracket)
    lex_single_store(93, TokType.RBracket)
    lex_single_store(123, TokType.LBrace)
    lex_single_store(125, TokType.RBrace)
    lex_single_store(58, TokType.Colon)
    lex_single_store(44, TokType.Comma)
    lex_single_store(59, TokType.Semicolon)
    lex_single_store(64, TokType.AtSign)
    lex_single_store(46, TokType.Dot)
end.

# Materialize token text: zero-copy span for keywords, intern pool for idents.
func token_lexeme(tok: Token):
    if tok.len <= 0 do out tok.str_val end
    if fat_str_len(tok.str_val) == tok.len and fat_str_len(tok.str_val) > 0 do
        out tok.str_val
    end
    if g_lexer_source == 0 do out tok.str_val end
    out ident_intern_span(g_lexer_source, tok.start, tok.len)
end.

func lex_char_flags(c: int):
    flags = 0
    if c == 32 or c == 9 or c == 13 do flags = flags | LEX_C_SPACE end
    if c >= 48 and c <= 57 do flags = flags | LEX_C_DIGIT | LEX_C_ID_CONT end
    if (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or c == 95 do
        flags = flags | LEX_C_ID_START | LEX_C_ID_CONT
    end
    if c >= 128 do flags = flags | LEX_C_ID_CONT end
    out flags
end.

func lex_ascii_init():
    if g_lex_ascii != 0 do out end
    g_lex_ascii = vir_alloc(256)
    var c = 0
    when c < 256 loop
        native_write_u8(g_lex_ascii, c, lex_char_flags(c))
        c = c + 1
    end
end.

func lex_flags(c: int):
    if c < 0 or c > 255 do out 0 end
    if g_lex_ascii == 0 do lex_ascii_init() end
    out native_read_u8(g_lex_ascii, c)
end.

func lex_skip_whitespace(lex: Lexer):
    # This runs inside the C-VM, where constructing and inspecting a fake
    # 64-bit SIMD word costs more than a direct byte loop. Newlines are not
    # whitespace here because the parser needs them as separator tokens.
    source_data = g_lexer_source_data
    if source_data == 0 do
        source_data = native_read_i64(lex.source as i64, 0)
    end
    when lex.pos < lex.source_len loop
        c = native_read_u8(source_data, lex.pos)
        if c != 32 and c != 9 and c != 13 do out lex end
        lex.pos = lex.pos + 1
    end
    out lex
end.

func lex_is_digit_fast(c: int):
    out (lex_flags(c) & LEX_C_DIGIT) != 0
end.

func lex_is_ident_start_fast(c: int):
    out (lex_flags(c) & LEX_C_ID_START) != 0
end.

func lex_is_ident_continue_fast(c: int):
    out (lex_flags(c) & LEX_C_ID_CONT) != 0
end.

func lexer_token_count:
    if g_lexer_tokens == 0 do
        out 0
    end
    out native_read_i64(g_lexer_tokens, 8)
end.

func lexer_token_get(index: int):
    if g_lexer_tokens == 0 do
        out 0
    end
    data = native_read_i64(g_lexer_tokens, 0)
    val = native_read_i64(data, index * 8)
    if index == 0 do
        print_str("DEBUG lexer_token_get: g_toks=")
        print_int(g_lexer_tokens)
        print_str(" data=")
        print_int(data)
        print_str(" val0=")
        print_int(val)
        print_str("\n")
    end
    out val
end.

func lexer_error_message:
    out g_lexer_error
end.

# §28.3 — Runtime keyword registration API (after Lexer entity).
func register_keyword:
    in  lex: Lexer
        word: string
        tok: TokType

    lex.keywords = vec_push(lex.keywords, KeywordEntry ( word: word, tok: tok ))
    keyword_bucket_build(lex.keywords)
    out lex
end.
func lexer_new(source: string):

    # The native backend treats CALLs as clobbering argument registers.  Keep
    # the fat-string pointer in a local before building the keyword table
    # otherwise the `source` used by the entity literal below can become the
    # result of a later call and the lexer observes an empty/corrupt input.
    # See the matching safeguard in parser_new.
    lex_ascii_init()
    lex_single_init()
    held_source = fat_str_sentinel_pad(source)
    slen = fat_str_len(held_source)
    g_lexer_source_data = native_read_i64(held_source as i64, 0)
    toks = vec_new()
    est_toks = 64
    if slen >= 4 do
        est_toks = slen / 4
    end
    if est_toks < 64 do est_toks = 64 end
    vec_reserve(toks, est_toks)
    kws = build_keyword_table()
    err = fat_str_new("")
    # Publish the reserved Vec object before tokenization starts. vec_push
    # mutates this object's data/len/cap fields in place, so readers do not
    # depend on tokenize reaching one particular native return epilogue.
    g_lexer_tokens = toks as i64
    g_lexer_error = err as i64
    out Lexer (
        source: held_source,
        source_len: slen,
        pos: 0,
        line: 1,
        col: 1,
        tokens: toks,
        paren_depth: 0,
        keywords: kws,
        error_msg: err
    )
end.
# ═══════════════════════════════════════════════════════
# Character Helpers
# ═══════════════════════════════════════════════════════

func is_eof(lex: Lexer):

    out lex.pos >= lex.source_len
end.
func lex_peek(lex: Lexer):

    if lex.pos < lex.source_len do
        out native_read_u8(g_lexer_source_data, lex.pos)
    end
    out 0
end.
func lex_peek_at(lex: Lexer, offset: int):

    p = lex.pos + offset
    if p < lex.source_len do
        out native_read_u8(g_lexer_source_data, p)
    end
    out 0
end.
func lex_advance(lex: Lexer):

    c = lex_peek(lex)
    if c == 10 do # '\n'
        lex.line = lex.line + 1
    end
    # Do not write `lex.col` here.  The bootstrap field mapper currently
    # aliases Lexer.col to the same slot as Lexer.pos; updating both advanced
    # the input cursor twice per byte.  In a leading ## comment that can miss
    # the closing delimiter forever and make tokenize return zero tokens.
    lex.pos = lex.pos + 1
    out (lex, c)
end.
func is_alpha(c: int):

    out (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or c == 95
end.
func is_digit(c: int):

    out c >= 48 and c <= 57
end.
func is_hex_digit(c: int):

    out is_digit(c) or (c >= 65 and c <= 70) or (c >= 97 and c <= 102)
end.
func is_word_char(c: int):

    out is_alpha(c) or is_digit(c) or c >= 128
end.
# ═══════════════════════════════════════════════════════
# Skip Whitespace & Comments
# ═══════════════════════════════════════════════════════

func skip_whitespace(lex: Lexer):
    out lex_skip_whitespace(lex)
end.

# Bulk skip: whitespace + line/block comments in one tight loop (no per-byte dispatcher).
func skip_trivia(lex: Lexer):
    when not is_eof(lex) loop
        c = lex_peek(lex)
        if c == 32 or c == 9 or c == 13 do
            lex = lex_skip_whitespace(lex)
        eif c == 35 do
            if lex_peek_at(lex, 1) == 35 or (lex_peek_at(lex, 1) == 42 and lex_peek_at(lex, 2) == 35) do
                lex = skip_block_comment(lex)
            else
                lex = skip_comment(lex)
            end
        else
            out lex
        end
    end
    out lex
end.
func skip_comment(lex: Lexer):

    # Single-line comment: # ... until \n
    when not is_eof(lex) and lex_peek(lex) != 10 loop
        # This path discards the consumed byte.  Avoid the C-VM's unstable
        # `(Lexer, int)` multi-return after a large number of calls; only a
        # cursor increment is required because the loop stops before newline.
        lex.pos = lex.pos + 1
    end
    out lex
end.
func skip_block_comment(lex: Lexer):

    # Preferred #*# ... #*#; retain legacy ## ... ## compatibility.
    # Advance the cursor directly here.  The bootstrap C-VM's generic field
    # mapper aliases Lexer.col with Lexer.pos, and its `(Lexer, int)` return
    # path is not stable under the number of calls made while scanning the
    # expanded compiler.  A comment only needs pos/line bookkeeping.
    framed = lex_peek_at(lex, 1) == 42 and lex_peek_at(lex, 2) == 35
    if framed do
        lex.pos = lex.pos + 3
    else
        lex.pos = lex.pos + 2
    end
    when not is_eof(lex) loop
        framed_close = framed and lex_peek(lex) == 35 and lex_peek_at(lex, 1) == 42 and lex_peek_at(lex, 2) == 35
        legacy_close = not framed and lex_peek(lex) == 35 and lex_peek_at(lex, 1) == 35
        if framed_close or legacy_close do
            if framed do
                lex.pos = lex.pos + 3
            else
                lex.pos = lex.pos + 2
            end
            out lex
        end
        if lex_peek(lex) == 10 do
            lex.line = lex.line + 1
        end
        lex.pos = lex.pos + 1
    end
    out lex
end.
# ═══════════════════════════════════════════════════════
# Number Lexing
# ═══════════════════════════════════════════════════════

func lex_consume_number_suffix(lex: Lexer):
    # Keep parity with core/src/lexer.c: typed literals such as 5_u32 and
    # 0xFFF_u64 are a single numeric token, not Int + Identifier.
    when not is_eof(lex) and is_word_char(lex_peek(lex)) loop
        var (lex2, _) = lex_advance(lex)
        lex = lex2
    end
    out lex
end.

func lex_number(lex: Lexer):

    tok = token_new(TokType.Int, lex.line, lex.col)
    num = 0
    is_float = false
    # Literal text for float parse (C uses strtod on the scanned buffer).
    lit_sb = sb_new()

    # Hex literal
    if lex_peek(lex) == 48 and (lex_peek_at(lex, 1) == 120 or lex_peek_at(lex, 1) == 88) do
        var (lex2, _) = lex_advance(lex)    # 0
        var (lex3, _) = lex_advance(lex2)   # x
        lex = lex3
        hex_digits = 0
        when not is_eof(lex) and is_hex_digit(lex_peek(lex)) loop
            c = lex_peek(lex)
            digit = 0
            if c >= 48 and c <= 57 do
                digit = c - 48
            end
            if c >= 65 and c <= 70 do
                digit = c - 55
            end
            if c >= 97 and c <= 102 do
                digit = c - 87
            end
            num = num * 16 + digit
            hex_digits = hex_digits + 1
            var (lex4, _) = lex_advance(lex)
            lex = lex4
        end
        if hex_digits == 0 do
            tok = token_new(TokType.Error, tok.line, tok.col)
            tok.str_val = fat_str_new("empty hex literal")
            lex.error_msg = tok.str_val
            out (lex, tok)
        end
        tok.int_val = num
        lex = lex_consume_number_suffix(lex)
        out (lex, tok)
    end

    # Binary literal (0b...)
    if lex_peek(lex) == 48 and (lex_peek_at(lex, 1) == 98 or lex_peek_at(lex, 1) == 66) do
        var (lex2, _) = lex_advance(lex);    # 0
        var (lex3, _) = lex_advance(lex2);   # b
        lex = lex3
        bin_digits = 0
        when not is_eof(lex) and (lex_peek(lex) == 48 or lex_peek(lex) == 49) loop
            c = lex_peek(lex)
            digit = c - 48
            num = num * 2 + digit
            bin_digits = bin_digits + 1
            var (lex4, _) = lex_advance(lex)
            lex = lex4
        end
        if bin_digits == 0 do
            tok = token_new(TokType.Error, tok.line, tok.col)
            tok.str_val = fat_str_new("empty binary literal")
            lex.error_msg = tok.str_val
            out (lex, tok)
        end
        tok.int_val = num
        lex = lex_consume_number_suffix(lex)
        out (lex, tok)
    end

    # Octal literal (0o...) — only digits 0-7; stop before 8/9 (C parity)
    if lex_peek(lex) == 48 and (lex_peek_at(lex, 1) == 111 or lex_peek_at(lex, 1) == 79) do
        var (lex2, _) = lex_advance(lex)    # 0
        var (lex3, _) = lex_advance(lex2)   # o
        lex = lex3
        oct_digits = 0
        when not is_eof(lex) and lex_peek(lex) >= 48 and lex_peek(lex) <= 55 loop
            c = lex_peek(lex)
            digit = c - 48
            num = num * 8 + digit
            oct_digits = oct_digits + 1
            var (lex4, _) = lex_advance(lex)
            lex = lex4
        end
        if oct_digits == 0 do
            tok = token_new(TokType.Error, tok.line, tok.col)
            tok.str_val = fat_str_new("empty octal literal")
            lex.error_msg = tok.str_val
            out (lex, tok)
        end
        tok.int_val = num
        lex = lex_consume_number_suffix(lex)
        out (lex, tok)
    end

    # Decimal literal (integer or float) — accumulate text for float_val
    overflowed = false
    when not is_eof(lex) and (is_digit(lex_peek(lex)) or lex_peek(lex) == 46) loop
        c = lex_peek(lex)
        if c == 46 do # '.'
            if is_float do
                # Second dot — stop
                tok.int_val = num
                out (lex, tok)
            end
            # Check for .. range operator
            if lex_peek_at(lex, 1) == 46 do
                tok.int_val = num
                out (lex, tok)
            end
            # UFCS: 10.foo — don't swallow '.' before identifier (C parity)
            nx = lex_peek_at(lex, 1)
            if (nx >= 65 and nx <= 90) or (nx >= 97 and nx <= 122) or nx == 95 do
                tok.int_val = num
                out (lex, tok)
            end
            is_float = true
            lit_sb = sb_append_char(lit_sb, 46)
            var (lex2, _) = lex_advance(lex)
            lex = lex2
        else
            digit = c - 48
            # P2: keep truncated i64; still consume remaining digits
            if not is_float and not overflowed do
                if num > 922337203685477580 or (num == 922337203685477580 and digit > 7) do
                    overflowed = true
                else
                    num = num * 10 + digit
                end
            end
            lit_sb = sb_append_char(lit_sb, c)
            var (lex3, _) = lex_advance(lex)
            lex = lex3
        end
    end

    # Scientific notation exponent (e.g. 1e9, 1.5e-3)
    if not is_eof(lex) and (lex_peek(lex) == 101 or lex_peek(lex) == 69) do
        is_float = true
        lit_sb = sb_append_char(lit_sb, lex_peek(lex))
        var (lex_e, _) = lex_advance(lex)
        lex = lex_e
        if lex_peek(lex) == 45 or lex_peek(lex) == 43 do # '+' or '-'
            lit_sb = sb_append_char(lit_sb, lex_peek(lex))
            var (lex_s, _) = lex_advance(lex)
            lex = lex_s
        end
        when not is_eof(lex) and is_digit(lex_peek(lex)) loop
            lit_sb = sb_append_char(lit_sb, lex_peek(lex))
            var (lex_d, _) = lex_advance(lex)
            lex = lex_d
        end
    end

    if is_float do
        tok.tok_type = TokType.Float
        tok.float_val = parse_float(sb_to_string(lit_sb))
        tok.int_val = 0
        lex = lex_consume_number_suffix(lex)
        out (lex, tok)
    end
    tok.int_val = num
    lex = lex_consume_number_suffix(lex)
    out (lex, tok)
end.
# ═══════════════════════════════════════════════════════
# String Lexing
# ═══════════════════════════════════════════════════════

func lex_string(lex: Lexer):

    tok = token_new(TokType.Str, lex.line, lex.col)
    var (lex2, quote) = lex_advance(lex)  # consume opening quote
    lex = lex2
    sb = sb_new()

    when not is_eof(lex) and lex_peek(lex) != quote loop
        if lex_peek(lex) == 92 do # backslash
            var (lex3, _) = lex_advance(lex)
            lex = lex3
            if is_eof(lex) do
                tok = token_new(TokType.Error, tok.line, tok.col)
                tok.str_val = fat_str_new("unterminated string literal")
                lex.error_msg = tok.str_val
                out (lex, tok)
            end
            var (lex4, esc) = lex_advance(lex)
            lex = lex4
            known = 0
            if esc == 110 do # \n
                sb = sb_append_char(sb, 10)
                known = 1
            end
            if esc == 116 do # \t
                sb = sb_append_char(sb, 9)
                known = 1
            end
            if esc == 92 do # \\
                sb = sb_append_char(sb, 92)
                known = 1
            end
            if esc == 114 do # \r
                sb = sb_append_char(sb, 13)
                known = 1
            end
            if esc == 48 do # \0
                sb = sb_append_char(sb, 0)
                known = 1
            end
            if esc == 34 do # \"
                sb = sb_append_char(sb, 34)
                known = 1
            end
            if esc == 39 do # \'
                sb = sb_append_char(sb, 39)
                known = 1
            end
            # C core default: keep the escaped character as-is
            if known == 0 do
                sb = sb_append_char(sb, esc)
            end
        else
            var (lex5, ch) = lex_advance(lex)
            lex = lex5
            sb = sb_append_char(sb, ch)
        end
    end

    # Consume closing quote — Error if EOF (C reports unterminated string)
    if is_eof(lex) do
        tok = token_new(TokType.Error, tok.line, tok.col)
        tok.str_val = fat_str_new("unterminated string literal")
        lex.error_msg = tok.str_val
        out (lex, tok)
    end
    var (lex6, _) = lex_advance(lex)
    lex = lex6

    tok.str_val = str_from_cstr(sb_to_string(sb))
    out (lex, tok)
end.
# ═══════════════════════════════════════════════════════
# Word / Keyword Lexing
# ═══════════════════════════════════════════════════════

func lex_word(lex: Lexer):

    start_line = lex.line
    start_col = lex.col
    start_pos = lex.pos

    scanning = true
    when scanning and lex.pos < lex.source_len loop
        c = native_read_u8(g_lexer_source_data, lex.pos)
        flags = native_read_u8(g_lex_ascii, c)
        if c >= 128 or (flags & LEX_C_ID_CONT) != 0 do
            lex.pos = lex.pos + 1
        else
            scanning = false
        end
    end

    span_len = lex.pos - start_pos
    kw_type = lookup_keyword_span(lex.keywords, lex.source, start_pos, span_len)
    if kw_type != TokType.Error do
        tok = token_new(kw_type, start_line, start_col)
        tok.start = start_pos
        tok.len = span_len
        out (lex, tok)
    end

    tok = token_new(TokType.Ident, start_line, start_col)
    tok.start = start_pos
    tok.len = span_len
    out (lex, tok)
end.
# ═══════════════════════════════════════════════════════
# Main Tokenize Loop
# ═══════════════════════════════════════════════════════

func tokenize(lex: Lexer):

    ident_intern_reset()
    g_lexer_source = lex.source as i64
    g_lexer_source_data = native_read_i64(lex.source as i64, 0)
    prev_was_newline = true

    when not is_eof(lex) loop
        lex = skip_trivia(lex)
        if is_eof(lex) do
            # Trailing space/tab/CR reaches EOF here.  Do not bypass the
            # sentinel appended by the normal loop-exit path.
            lex.tokens = vec_push(lex.tokens, token_new(TokType.Eof, lex.line, lex.col))
            g_lexer_tokens = lex.tokens as i64
            g_lexer_error = lex.error_msg as i64
            out lex
        end

        c = lex_peek(lex)
        c_flags = native_read_u8(g_lex_ascii, c)

        # Newline (statement / list separator, §1.0) — emit inside parens too
        if c == 10 do
            var (lex2, _) = lex_advance(lex)
            lex = lex2
            if not prev_was_newline do
                lex.tokens = vec_push(lex.tokens, token_new(TokType.Newline, lex.line, lex.col))
                prev_was_newline = true
            end
            skip  # continue
        end

        prev_was_newline = false

        # String literal
        if c == 34 or c == 39 do # " or '
            var (lex2, tok) = lex_string(lex)
            lex = lex2
            lex.tokens = vec_push(lex.tokens, tok)
            skip
        end

        # Number literal
        if (c_flags & LEX_C_DIGIT) != 0 do
            var (lex2, tok) = lex_number(lex)
            lex = lex2
            lex.tokens = vec_push(lex.tokens, tok)
            skip
        end

        # Words dominate compiler source. Recognize them before walking the
        # long multi-character operator cascade below.
        if (c_flags & LEX_C_ID_START) != 0 or c >= 128 do
            var (lex2, tok) = lex_word(lex)
            lex = lex2
            lex.tokens = vec_push(lex.tokens, tok)
            skip
        end

        # Multi-char operators
        c2 = lex_peek_at(lex, 1)

        if c == 61 and c2 == 61 do # ==
            tok = token_new(TokType.Eq, lex.line, lex.col)
            var (l1, _) = lex_advance(lex)
            var (l2, _) = lex_advance(l1)
            lex = l2
            lex.tokens = vec_push(lex.tokens, tok)
            skip
        end

        if c == 33 and c2 == 61 do # !=
            tok = token_new(TokType.Ne, lex.line, lex.col)
            var (l1, _) = lex_advance(lex)
            var (l2, _) = lex_advance(l1)
            lex = l2
            lex.tokens = vec_push(lex.tokens, tok)
            skip
        end

        if c == 62 and c2 == 61 do # >=
            tok = token_new(TokType.Ge, lex.line, lex.col)
            var (l1, _) = lex_advance(lex)
            var (l2, _) = lex_advance(l1)
            lex = l2
            lex.tokens = vec_push(lex.tokens, tok)
            skip
        end

        if c == 60 and c2 == 61 do # <=
            tok = token_new(TokType.Le, lex.line, lex.col)
            var (l1, _) = lex_advance(lex)
            var (l2, _) = lex_advance(l1)
            lex = l2
            lex.tokens = vec_push(lex.tokens, tok)
            skip
        end

        # &mut (mutable borrow — 4 chars)
        if c == 38 and c2 == 109 and lex_peek_at(lex, 2) == 117 and lex_peek_at(lex, 3) == 116 do
            tok = token_new(TokType.BorrowMut, lex.line, lex.col)
            var (l1, _) = lex_advance(lex)
            var (l2, _) = lex_advance(l1)
            var (l3, _) = lex_advance(l2)
            var (l4, _) = lex_advance(l3)
            lex = l4
            lex.tokens = vec_push(lex.tokens, tok)
            skip
        end

        # ?=/= (safe not-equal — 4 chars)
        if c == 63 and c2 == 61 and lex_peek_at(lex, 2) == 47 and lex_peek_at(lex, 3) == 61 do
            tok = token_new(TokType.SafeNe, lex.line, lex.col)
            var (l1, _) = lex_advance(lex)
            var (l2, _) = lex_advance(l1)
            var (l3, _) = lex_advance(l2)
            var (l4, _) = lex_advance(l3)
            lex = l4
            lex.tokens = vec_push(lex.tokens, tok)
            skip
        end

        # ?= (safe equal)
        if c == 63 and c2 == 61 do
            tok = token_new(TokType.SafeEq, lex.line, lex.col)
            var (l1, _) = lex_advance(lex)
            var (l2, _) = lex_advance(l1)
            lex = l2
            lex.tokens = vec_push(lex.tokens, tok)
            skip
        end

        # ?. (safe member access)
        if c == 63 and c2 == 46 do
            tok = token_new(TokType.SafeAccess, lex.line, lex.col)
            var (l1, _) = lex_advance(lex)
            var (l2, _) = lex_advance(l1)
            lex = l2
            lex.tokens = vec_push(lex.tokens, tok)
            skip
        end

        # :~ (pattern match)
        if c == 58 and c2 == 126 do
            tok = token_new(TokType.Pattern, lex.line, lex.col)
            var (l1, _) = lex_advance(lex)
            var (l2, _) = lex_advance(l1)
            lex = l2
            lex.tokens = vec_push(lex.tokens, tok)
            skip
        end

        # ** (MatMul)
        if c == 42 and c2 == 42 do
            tok = token_new(TokType.MatMul, lex.line, lex.col)
            var (l1, _) = lex_advance(lex)
            var (l2, _) = lex_advance(l1)
            lex = l2
            lex.tokens = vec_push(lex.tokens, tok)
            skip
        end

        # >< (FMA)
        if c == 62 and c2 == 60 do
            tok = token_new(TokType.Fma, lex.line, lex.col)
            var (l1, _) = lex_advance(lex)
            var (l2, _) = lex_advance(l1)
            lex = l2
            lex.tokens = vec_push(lex.tokens, tok)
            skip
        end

        # !! (AtomicBang)
        if c == 33 and c2 == 33 do
            tok = token_new(TokType.AtomicBang, lex.line, lex.col)
            var (l1, _) = lex_advance(lex)
            var (l2, _) = lex_advance(l1)
            lex = l2
            lex.tokens = vec_push(lex.tokens, tok)
            skip
        end

        # <- (SendArrow)
        if c == 60 and c2 == 45 do
            tok = token_new(TokType.SendArrow, lex.line, lex.col)
            var (l1, _) = lex_advance(lex)
            var (l2, _) = lex_advance(l1)
            lex = l2
            lex.tokens = vec_push(lex.tokens, tok)
            skip
        end

        # && (logical AND)
        if c == 38 and c2 == 38 do
            tok = token_new(TokType.LogicalAnd, lex.line, lex.col)
            var (l1, _) = lex_advance(lex)
            var (l2, _) = lex_advance(l1)
            lex = l2
            lex.tokens = vec_push(lex.tokens, tok)
            skip
        end

        # || (logical OR)
        if c == 124 and c2 == 124 do
            tok = token_new(TokType.LogicalOr, lex.line, lex.col)
            var (l1, _) = lex_advance(lex)
            var (l2, _) = lex_advance(l1)
            lex = l2
            lex.tokens = vec_push(lex.tokens, tok)
            skip
        end

        # -> (arrow)
        if c == 45 and c2 == 62 do
            tok = token_new(TokType.Arrow, lex.line, lex.col)
            var (l1, _) = lex_advance(lex)
            var (l2, _) = lex_advance(l1)
            lex = l2
            lex.tokens = vec_push(lex.tokens, tok)
            skip
        end

        # <<= (bit shift left assign — 3 chars)
        if c == 60 and c2 == 60 and lex_peek_at(lex, 2) == 61 do
            tok = token_new(TokType.BitShlAssign, lex.line, lex.col)
            var (l1, _) = lex_advance(lex)
            var (l2, _) = lex_advance(l1)
            var (l3, _) = lex_advance(l2)
            lex = l3
            lex.tokens = vec_push(lex.tokens, tok)
            skip
        end

        # >>= (bit shift right assign — 3 chars)
        if c == 62 and c2 == 62 and lex_peek_at(lex, 2) == 61 do
            tok = token_new(TokType.BitShrAssign, lex.line, lex.col)
            var (l1, _) = lex_advance(lex)
            var (l2, _) = lex_advance(l1)
            var (l3, _) = lex_advance(l2)
            lex = l3
            lex.tokens = vec_push(lex.tokens, tok)
            skip
        end

        # << (bit shift left)
        if c == 60 and c2 == 60 do
            tok = token_new(TokType.BitShl, lex.line, lex.col)
            var (l1, _) = lex_advance(lex)
            var (l2, _) = lex_advance(l1)
            lex = l2
            lex.tokens = vec_push(lex.tokens, tok)
            skip
        end

        # >> (type cast per spec §10.5 — NOT bit shift; use keyword `shr`)
        if c == 62 and c2 == 62 do
            tok = token_new(TokType.Cast, lex.line, lex.col)
            var (l1, _) = lex_advance(lex)
            var (l2, _) = lex_advance(l1)
            lex = l2
            lex.tokens = vec_push(lex.tokens, tok)
            skip
        end

        # += (PlusAssign)
        if c == 43 and c2 == 61 do
            tok = token_new(TokType.PlusAssign, lex.line, lex.col)
            var (l1, _) = lex_advance(lex)
            var (l2, _) = lex_advance(l1)
            lex = l2
            lex.tokens = vec_push(lex.tokens, tok)
            skip
        end

        # -= (MinusAssign)
        if c == 45 and c2 == 61 do
            tok = token_new(TokType.MinusAssign, lex.line, lex.col)
            var (l1, _) = lex_advance(lex)
            var (l2, _) = lex_advance(l1)
            lex = l2
            lex.tokens = vec_push(lex.tokens, tok)
            skip
        end

        # *= (StarAssign)
        if c == 42 and c2 == 61 do
            tok = token_new(TokType.StarAssign, lex.line, lex.col)
            var (l1, _) = lex_advance(lex)
            var (l2, _) = lex_advance(l1)
            lex = l2
            lex.tokens = vec_push(lex.tokens, tok)
            skip
        end

        # /= (SlashAssign)
        if c == 47 and c2 == 61 do
            tok = token_new(TokType.SlashAssign, lex.line, lex.col)
            var (l1, _) = lex_advance(lex)
            var (l2, _) = lex_advance(l1)
            lex = l2
            lex.tokens = vec_push(lex.tokens, tok)
            skip
        end

        # %= (ModAssign)
        if c == 37 and c2 == 61 do
            tok = token_new(TokType.ModAssign, lex.line, lex.col)
            var (l1, _) = lex_advance(lex)
            var (l2, _) = lex_advance(l1)
            lex = l2
            lex.tokens = vec_push(lex.tokens, tok)
            skip
        end

        # &= (BitAndAssign)
        if c == 38 and c2 == 61 do
            tok = token_new(TokType.BitAndAssign, lex.line, lex.col)
            var (l1, _) = lex_advance(lex)
            var (l2, _) = lex_advance(l1)
            lex = l2
            lex.tokens = vec_push(lex.tokens, tok)
            skip
        end

        # |= (BitOrAssign)
        if c == 124 and c2 == 61 do
            tok = token_new(TokType.BitOrAssign, lex.line, lex.col)
            var (l1, _) = lex_advance(lex)
            var (l2, _) = lex_advance(l1)
            lex = l2
            lex.tokens = vec_push(lex.tokens, tok)
            skip
        end

        # ^= (BitXorAssign)
        if c == 94 and c2 == 61 do
            tok = token_new(TokType.BitXorAssign, lex.line, lex.col)
            var (l1, _) = lex_advance(lex)
            var (l2, _) = lex_advance(l1)
            lex = l2
            lex.tokens = vec_push(lex.tokens, tok)
            skip
        end

        # .. (range)
        if c == 46 and c2 == 46 do
            tok = token_new(TokType.DotDot, lex.line, lex.col)
            var (l1, _) = lex_advance(lex)
            var (l2, _) = lex_advance(l1)
            lex = l2
            lex.tokens = vec_push(lex.tokens, tok)
            skip
        end


        # Single-char operators / delimiters (256-byte table; multi-char rules above win).
        single_val = native_read_i64(g_lex_single, c * 8)
        single_tok = TokType.Eof
        if single_val != 0 do single_tok = single_val as TokType end
        if single_tok == TokType.LParen or single_tok == TokType.LBracket or single_tok == TokType.LBrace do
            lex.paren_depth = lex.paren_depth + 1
        end
        if single_tok == TokType.RParen or single_tok == TokType.RBracket or single_tok == TokType.RBrace do
            if lex.paren_depth > 0 do
                lex.paren_depth = lex.paren_depth - 1
            end
        end

        if single_tok != TokType.Eof do
            tok = token_new(single_tok, lex.line, lex.col)
            lex.pos = lex.pos + 1
            lex.tokens = vec_push(lex.tokens, tok)
            skip
        end

        # Unknown character — report error token & set error_msg
        err_str = fat_str_new("unexpected character")
        lex.error_msg = err_str
        g_lexer_error = err_str as i64
        tok = token_new(TokType.Error, lex.line, lex.col)
        tok.str_val = fat_char_to_str(c)
        var (lex2, _) = lex_advance(lex)
        lex = lex2
        lex.tokens = vec_push(lex.tokens, tok)
    end

    # Push sentinel EOF token
    lex.tokens = vec_push(lex.tokens, token_new(TokType.Eof, lex.line, lex.col))
    g_lexer_tokens = lex.tokens as i64
    g_lexer_error = lex.error_msg as i64
    out lex
end.

# C-string entry: read_file_str / get_arg return raw pointers; lexer needs fat string.
func lexer_lex(source_cstr: int):
    let source = str_from_cstr(source_cstr)
    let lex = lexer_new(source)
    out tokenize(lex)
end.

# ═══════════════════════════════════════════════════════
# Token Name (for debug / error messages)
# ═══════════════════════════════════════════════════════

func token_name(t: TokType):

    if t == TokType.Eof do
        out fat_str_new("EOF")
    end
    if t == TokType.Int do
        out fat_str_new("INT")
    end
    if t == TokType.Float do
        out fat_str_new("FLOAT")
    end
    if t == TokType.Str do
        out fat_str_new("STRING")
    end
    if t == TokType.Ident do
        out fat_str_new("IDENT")
    end
    if t == TokType.Newline do
        out fat_str_new("NEWLINE")
    end
    if t == TokType.Func do
        out fat_str_new("FUNC")
    end
    if t == TokType.Var do
        out fat_str_new("VAR")
    end
    if t == TokType.Const do
        out fat_str_new("CONST")
    end
    if t == TokType.Entity do
        out fat_str_new("ENTITY")
    end
    if t == TokType.InterfaceKw do
        out fat_str_new("INTERFACE")
    end
    if t == TokType.Enum do
        out fat_str_new("ENUM")
    end
    if t == TokType.If do
        out fat_str_new("IF")
    end
    if t == TokType.Else do
        out fat_str_new("ELSE")
    end
    if t == TokType.End do
        out fat_str_new("END")
    end
    if t == TokType.Out do
        out fat_str_new("OUT")
    end
    if t == TokType.While do
        out fat_str_new("WHILE")
    end
    if t == TokType.Error do
        out fat_str_new("ERROR")
    end
    if t == TokType.Assign do
        out fat_str_new("ASSIGN")
    end
    if t == TokType.Eq do
        out fat_str_new("EQ")
    end
    if t == TokType.Ne do
        out fat_str_new("NE")
    end
    if t == TokType.Lt do
        out fat_str_new("LT")
    end
    if t == TokType.Le do
        out fat_str_new("LE")
    end
    if t == TokType.Gt do
        out fat_str_new("GT")
    end
    if t == TokType.Ge do
        out fat_str_new("GE")
    end
    if t == TokType.Plus do
        out fat_str_new("PLUS")
    end
    if t == TokType.Minus do
        out fat_str_new("MINUS")
    end
    if t == TokType.Star do
        out fat_str_new("STAR")
    end
    if t == TokType.Slash do
        out fat_str_new("SLASH")
    end
    if t == TokType.Percent do
        out fat_str_new("PERCENT")
    end
    if t == TokType.And do
        out fat_str_new("AND")
    end
    if t == TokType.Or do
        out fat_str_new("OR")
    end
    if t == TokType.Not do
        out fat_str_new("NOT")
    end
    if t == TokType.LParen do
        out fat_str_new("LPAREN")
    end
    if t == TokType.RParen do
        out fat_str_new("RPAREN")
    end
    if t == TokType.LBracket do
        out fat_str_new("LBRACKET")
    end
    if t == TokType.RBracket do
        out fat_str_new("RBRACKET")
    end
    if t == TokType.LBrace do
        out fat_str_new("LBRACE")
    end
    if t == TokType.RBrace do
        out fat_str_new("RBRACE")
    end
    if t == TokType.Colon do
        out fat_str_new("COLON")
    end
    if t == TokType.Semicolon do
        out fat_str_new("SEMICOLON")
    end
    if t == TokType.Comma do
        out fat_str_new("COMMA")
    end
    if t == TokType.Dot do
        out fat_str_new("DOT")
    end
    if t == TokType.Import do
        out fat_str_new("IMPORT")
    end
    if t == TokType.Export do
        out fat_str_new("EXPORT")
    end
    if t == TokType.Include do
        out fat_str_new("INCLUDE")
    end
    if t == TokType.Module do
        out fat_str_new("MODULE")
    end
    if t == TokType.From do
        out fat_str_new("FROM")
    end
    if t == TokType.As do
        out fat_str_new("AS")
    end
    if t == TokType.Try do
        out fat_str_new("TRY")
    end
    if t == TokType.PlusAssign do
        out fat_str_new("PLUS_ASSIGN")
    end
    if t == TokType.MinusAssign do
        out fat_str_new("MINUS_ASSIGN")
    end
    if t == TokType.StarAssign do
        out fat_str_new("STAR_ASSIGN")
    end
    if t == TokType.SlashAssign do
        out fat_str_new("SLASH_ASSIGN")
    end
    if t == TokType.ModAssign do
        out fat_str_new("MOD_ASSIGN")
    end
    if t == TokType.BitAndAssign do
        out fat_str_new("AND_ASSIGN")
    end
    if t == TokType.BitOrAssign do
        out fat_str_new("OR_ASSIGN")
    end
    if t == TokType.BitXorAssign do
        out fat_str_new("XOR_ASSIGN")
    end
    if t == TokType.BitShlAssign do
        out fat_str_new("SHL_ASSIGN")
    end
    if t == TokType.BitShrAssign do
        out fat_str_new("SHR_ASSIGN")
    end
    out fat_str_new("???")
end.
export TokType, Token, KeywordEntry, Lexer, lexer_new, tokenize, lexer_lex,
       lexer_token_count, lexer_token_get, lexer_error_message, token_name,
       token_lexeme, g_lexer_source, lookup_keyword_span
