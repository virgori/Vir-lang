    if t == TokType.Try do
        out fat_str_new("TRY")
    end
    if t == TokType.PlusAssign do
        out fat_str_new("PLUS_ASSIGN")
    end
    if t == TokType.MinusAssign do
        out fat_str_new("MINUS_ASSIGN")
    end
    if t == TokType.StarAssign do
        out fat_str_new("STAR_ASSIGN")
    end
    if t == TokType.SlashAssign do
