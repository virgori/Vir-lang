
 # vir/compiler/lexer.vri — Vir Source Lexer (Pure Vir)
 # =====================================================
 # Converted from C (core/src/lexer.c) for self-hosting.
 #
 # Features
 #   - Full v1.2 keyword set (English standard)
 #   - Multi-char operators (?=, ?., :~, >>, ||, ->, ..)
 #   - Block comments: #*# ... #*# (preferred) and ## ... ## (legacy)
 #   - Hex literal support (0x...)
 #   - Paren-depth tracking (brackets / grouping; NEWLINE still emitted for §1.0)
 #   - String escape sequences (\n, \t, \\, \", \')

include types
include result
import Result, Ok, Err from result
include vir.rt.string_rt
import fat_str_new, fat_str_concat, fat_str_len, fat_str_byte_at, fat_str_eq, fat_str_eq_span, fat_str_slice,
    fat_str_sentinel_pad, fat_char_to_str, rt_streq, str_from_cstr, sb_new, sb_append_char, sb_to_string, sb_len,
    StringBuilder, native_read_u8, native_write_u8, native_read_i64, native_write_i64, rt_memcpy from vir.rt.string_rt
include alloc
import alloc, vir_alloc from alloc
include vec
import Vec, vec_new, vec_push, vec_len, vec_get, vec_reserve from vec

# ═══════════════════════════════════════════════════════
# Token Types (v1.2 Standard)
# ═══════════════════════════════════════════════════════

enum TokType:
    # Literals
    Eof         = 0
    Error       = 1
    Int         = 2
    Float       = 3
    Str         = 4
    Ident       = 5
    Newline     = 6

    # Definitions
    Func        = 10
    Var         = 11
    Const       = 12
    Entity      = 13
    Enum        = 14
    Method      = 15
    Class       = 16
    Has         = 17
    Share       = 18
    Async       = 19
    Task        = 20
    Wait        = 21
    TypeKw      = 22

    # Control flow
    If          = 30
    Else        = 31
    Eif         = 32
    Loop        = 33
    While       = 34
    When        = 35
    For         = 36
    Break       = 37
    Skip        = 38
    Out         = 39
    Case        = 40
    End         = 41
    In          = 42

    # Arithmetic operators
    Plus        = 50
    Minus       = 51
    Star        = 52
    Slash       = 53
    Percent     = 54
    Power       = 55
    Mod         = 56

    # Comparison operators
    Eq          = 60
    Ne          = 61
    Gt          = 62
    Lt          = 63
    Ge          = 64
    Le          = 65
    SafeEq      = 66
    SafeNe      = 67

    # Logical operators
    And         = 70
    Or          = 71
    Not         = 72

    # Bitwise operators
    BitXor      = 75
    BitShl      = 76
    BitShr      = 77
    BitAnd      = 78
    BitOr       = 79
    BitNot      = 80

    # Access / transform
    SafeAccess  = 85
    Exist       = 86
    Cast        = 87
    Pattern     = 88

    # Assignment
    Assign      = 90

    # Delimiters
    LParen      = 100
    RParen      = 101
    LBracket    = 102
    RBracket    = 103
    LBrace      = 104
    RBrace      = 105
    Comma       = 106
    Dot         = 107
    DotDot      = 108
    Colon       = 109
    DoubleColon = 112
    Semicolon   = 110
    Arrow       = 111

    # I/O
    Print       = 120
    Input       = 121
    CheckCpu    = 122
    Patch       = 123

    # Module
    Import      = 130
    From        = 131
    Module      = 132
    Export      = 133
    As          = 134
    Include     = 135
    Get         = 136

    # Boolean / None
    True        = 140
    False       = 141
    NoneLit     = 142

    # Error handling
    Try         = 150
    ErrorKw     = 151
    MapKw       = 152
    Extern      = 153
    EnsureKw    = 154
    PackedKw    = 155
    RefKw       = 156
    RegisterKw  = 157
    RevertKw    = 158
    ThisKw      = 159
    InterpStart = 160
    InterpEnd   = 161
    ThrowKw     = 162
    AtSign      = 163
    Do          = 164
    Let         = 165
    Del         = 166;   # reserved keyword token

    # §26.2 AI / advanced operators, §24.4 atomics, compound assign
    MatMul      = 180;   # **
    Fma         = 181;   # ><
    Lock        = 182;   # lock keyword
    AtomicBang  = 183;   # !!
    PlusAssign  = 184;   # +=
    MinusAssign = 185;   # -=
    StarAssign  = 186;   # *=
    SlashAssign = 187;   # /=
    ModAssign   = 170;   # %=
    BitAndAssign = 171;  # &=
    BitOrAssign = 172;   # |=
    BitXorAssign = 173;  # ^=
    BitShlAssign = 174;  #  shl =
    BitShrAssign = 175;  # >>=
    Swizzle     = 188;   # ~ (postfix swizzle)
    SendArrow   = 189;   # <-
    LogicalOr   = 190;   # ||
    LogicalAnd  = 187;   # &&

    # P0 Keywords & Annotations
    BindKw      = 191;   # @bind
    EntryKw     = 192;   # @entry
    AtomicKw    = 193;   # atomic
    IsolateKw   = 194;   # isolate
    ResumeKw    = 195;   # resume
    RetryKw     = 196;   # retry
    EmitKw      = 197;   # emit
    ErxKw       = 198;   # erx
    PrecompKw   = 199;   # precomp
    PortKw      = 200;   # port
    SendKw      = 201;   # send
    RecvKw      = 202;   # recv
    SelectKw    = 203;   # select

    # P1 Keywords & Subsystem Tokens
    BorrowMut   = 204;   # &mut
    LazyKw      = 205;   # lazy
    TensorKw    = 206;   # tensor
    InferKw     = 207;   # infer
    TrainKw     = 208;   # train
    QuantizeKw  = 209;   # quantize
    FluxKw      = 210;   # flux
    DeckKw      = 211;   # deck
    MoldKw      = 212;   # mold
    ReactiveKw  = 213;   # reactive
    MorphKw     = 214;   # morph
    BundleKw    = 215;   # bundle
    ExposeKw    = 216;   # expose

    # P2 VPS Pattern Delimiters
    VpsGroupOpen  = 217; # :(
    VpsGroupClose = 218; # :)

    # Runtime keywords (spec §22 / §4.6) — distinct from Wait.Task
    AwaitKw       = 219
    CancelKw      = 220
    QuietKw       = 221
    ArenaKw       = 222
    PassKw        = 223;  # await pass
    TimeoutKw     = 224
    DictKw        = 225
    ArrCompactKw  = 226
    PtrKw         = 227;  # ptr type keyword (§29 FFI)
    MutKw         = 228;  # mut (after & or standalone binder)
    Then          = 229;  # then — block opener (alias of Do)
    EmbedKw       = 230;  # embed (bundle asset macro §25.3)
    InterfaceKw   = 231   # interface declaration (signature-only methods)
end.
# ═══════════════════════════════════════════════════════
# Token
# ═══════════════════════════════════════════════════════

entity Token:
    tok_type:   TokType,
    line:       int,
    col:        int,
    start:      int,
    len:        int,
    str_val:    string,
    int_val:    int,
    float_val:  float
end.
# Shared empty string — avoid allocating "" per token (P1).
var g_tok_empty_str = 0
func tok_empty_str:
    if g_tok_empty_str == 0 do
        g_tok_empty_str = fat_str_new("")
    end
    out g_tok_empty_str
end.

func token_new:
    in  t: TokType
        line: int
        col: int

    out Token (
        tok_type: t,
        line: line,
        col: col,
        start: 0,
        len: 0,
        str_val: tok_empty_str(),
        int_val: 0,
        float_val: 0.0
    )
end.
# ═══════════════════════════════════════════════════════
# Keyword Lookup Table
# ═══════════════════════════════════════════════════════

entity KeywordEntry:
    word:   string,
        tok:    TokType
end.
