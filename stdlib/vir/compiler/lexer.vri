func kw_table_part3:
    in table: Vec<KeywordEntry>
    # Chinese keywords only (English already in part1/part2)
    table = vec_push(table, KeywordEntry ( word: fat_str_new("函数"), tok: TokType.Func ))
    table = vec_push(table, KeywordEntry ( word: fat_str_new("变量"), tok: TokType.Var ))
    table = vec_push(table, KeywordEntry ( word: fat_str_new("常量"), tok: TokType.Const ))
    table = vec_push(table, KeywordEntry ( word: fat_str_new("如果"), tok: TokType.If ))
    table = vec_push(table, KeywordEntry ( word: fat_str_new("否则"), tok: TokType.Else ))
    table = vec_push(table, KeywordEntry ( word: fat_str_new("循环"), tok: TokType.Loop ))
    table = vec_push(table, KeywordEntry ( word: fat_str_new("结束"), tok: TokType.End ))
    table = vec_push(table, KeywordEntry ( word: fat_str_new("返回"), tok: TokType.Out ))
    table = vec_push(table, KeywordEntry ( word: fat_str_new("真"), tok: TokType.True ))
    table = vec_push(table, KeywordEntry ( word: fat_str_new("假"), tok: TokType.False ))
    table = vec_push(table, KeywordEntry ( word: fat_str_new("空"), tok: TokType.NoneLit ))
    table = vec_push(table, KeywordEntry ( word: fat_str_new("打印"), tok: TokType.Print ))
    table = vec_push(table, KeywordEntry ( word: fat_str_new("输入"), tok: TokType.Input ))
    table = vec_push(table, KeywordEntry ( word: fat_str_new("导入"), tok: TokType.Import ))
    table = vec_push(table, KeywordEntry ( word: fat_str_new("导出"), tok: TokType.Export ))
    table = vec_push(table, KeywordEntry ( word: fat_str_new("模块"), tok: TokType.Module ))
    table = vec_push(table, KeywordEntry ( word: fat_str_new("包含"), tok: TokType.Include ))
    table = vec_push(table, KeywordEntry ( word: fat_str_new("跳出"), tok: TokType.Break ))
    table = vec_push(table, KeywordEntry ( word: fat_str_new("继续"), tok: TokType.Skip ))
    table = vec_push(table, KeywordEntry ( word: fat_str_new("与"), tok: TokType.And ))
    out table
end.

