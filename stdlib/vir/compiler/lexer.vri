    table = vec_push(table, KeywordEntry ( word: fat_str_new("return"), tok: TokType.Out ));
    table = vec_push(table, KeywordEntry ( word: fat_str_new("case"), tok: TokType.Case ));
    table = vec_push(table, KeywordEntry ( word: fat_str_new("end"), tok: TokType.End ));
    table = vec_push(table, KeywordEntry ( word: fat_str_new("do"), tok: TokType.Do ));
    table = vec_push(table, KeywordEntry ( word: fat_str_new("in"), tok: TokType.In ));
    table = vec_push(table, KeywordEntry ( word: fat_str_new("print"), tok: TokType.Print ));
    table = vec_push(table, KeywordEntry ( word: fat_str_new("input"), tok: TokType.Input ));
    table = vec_push(table, KeywordEntry ( word: fat_str_new("check_cpu"), tok: TokType.CheckCpu ));
    table = vec_push(table, KeywordEntry ( word: fat_str_new("patch"), tok: TokType.Patch ));
    table = vec_push(table, KeywordEntry ( word: fat_str_new("true"), tok: TokType.True ));
    out table
end.

