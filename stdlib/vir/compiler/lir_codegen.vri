func emit_lir_rt_str_len_stub(cb: CodeBuf):
    # X0 = C-string ptr → X0 = length (excluding NUL)
    cb = arm64_cmp_imm0(cb, 0)
    cb = arm64_bne_imm19(cb, 12)
    cb = arm64_movz_imm64(cb, 0, 0)
    cb = arm64_ret(cb)
    cb = arm64_mov_rr(cb, 1, 0)
    len_loop = codebuf_offset(cb)
    cb = arm64_ldrb_uoff(cb, 2, 1, 0)
    cb = arm64_cmp_imm0(cb, 2)
    cb = arm64_beq_imm19(cb, 12)
    cb = arm64_add_imm(cb, 1, 1, 1)
    delta = (len_loop - codebuf_offset(cb)) as int
    cb = arm64_b_imm26(cb, delta)
    cb = arm64_sub_rrr(cb, 0, 1, 0)
    out arm64_ret(cb)
end.

func emit_lir_rt_str_eq_stub(cb: CodeBuf):
    # X0 = a, X1 = b → X0 = 1 if equal (as C-strings) else 0
    cb = arm64_cmp_rr(cb, 0, 1)
    cb = arm64_bne_imm19(cb, 12)
    cb = arm64_mov_imm16(cb, 0, 1)
    cb = arm64_ret(cb)
    cb = arm64_cmp_imm0(cb, 0)
    cb = arm64_beq_imm19(cb, 12)
    cb = arm64_cmp_imm0(cb, 1)
    cb = arm64_bne_imm19(cb, 12)
    cb = arm64_mov_imm16(cb, 0, 0)
    cb = arm64_ret(cb)
    eq_loop = codebuf_offset(cb)
    cb = arm64_ldrb_uoff(cb, 2, 0, 0)
    cb = arm64_ldrb_uoff(cb, 3, 1, 0)
    cb = arm64_cmp_rr(cb, 2, 3)
    cb = arm64_bne_imm19(cb, 24)
    cb = arm64_cmp_imm0(cb, 2)
    cb = arm64_beq_imm19(cb, 24)
    cb = arm64_add_imm(cb, 0, 0, 1)
    cb = arm64_add_imm(cb, 1, 1, 1)
    delta = (eq_loop - codebuf_offset(cb)) as int
    cb = arm64_b_imm26(cb, delta)
    cb = arm64_mov_imm16(cb, 0, 0)
    cb = arm64_ret(cb)
    cb = arm64_mov_imm16(cb, 0, 1)
    out arm64_ret(cb)
end.

func emit_lir_rt_int_to_str_stub(cb: CodeBuf):
    # X0 = signed integer n → X0 = ptr to freshly bump-allocated NUL-terminated decimal string
    # --- allocate 32 bytes: X11 = base ; *X28 += 32 ---
    cb = arm64_ldr_uoff(cb, 14, 28, 0)
    cb = arm64_mov_rr(cb, 11, 14)
    cb = arm64_add_imm(cb, 14, 14, 32)
    cb = arm64_str_uoff(cb, 14, 28, 0)
    # --- cursor X10 = base+31, write NUL terminator ---
    cb = arm64_add_imm(cb, 10, 11, 31)
    cb = arm64_mov_imm16(cb, 15, 0)
    cb = arm64_strb_uoff(cb, 15, 10, 0)
    # --- X9 = n ; X12 = sign flag ---
    cb = arm64_mov_rr(cb, 9, 0)
    cb = arm64_mov_imm16(cb, 12, 0)
    # --- if n < 0: sign=1, n = 0 - n ---
    cb = arm64_cmp_imm0(cb, 9)
    cb = arm64_cset_lt(cb, 14)
    cb = arm64_cmp_imm0(cb, 14)
    cb = arm64_beq_imm19(cb, 16)
    cb = arm64_mov_imm16(cb, 12, 1)
    cb = arm64_mov_imm16(cb, 15, 0)
    cb = arm64_sub_rrr(cb, 9, 15, 9)
    # --- digit loop (do-while so 0 produces "0") ---
    dloop = codebuf_offset(cb)
    cb = arm64_mov_imm16(cb, 15, 10)
    cb = arm64_sdiv_rrr(cb, 13, 9, 15)
    cb = arm64_msub_rrrr(cb, 14, 13, 15, 9)
    cb = arm64_add_imm(cb, 14, 14, 48)
    cb = arm64_sub_imm(cb, 10, 10, 1)
    cb = arm64_strb_uoff(cb, 14, 10, 0)
    cb = arm64_mov_rr(cb, 9, 13)
    cb = arm64_cmp_imm0(cb, 9)
    ddelta = (dloop - codebuf_offset(cb)) as int
    cb = arm64_bne_imm19(cb, ddelta)
    # --- prepend '-' when negative ---
    cb = arm64_cmp_imm0(cb, 12)
    cb = arm64_beq_imm19(cb, 16)
    cb = arm64_sub_imm(cb, 10, 10, 1)
    cb = arm64_mov_imm16(cb, 15, 45)
    cb = arm64_strb_uoff(cb, 15, 10, 0)
    # --- return pointer to first char ---
    cb = arm64_mov_rr(cb, 0, 10)
    out arm64_ret(cb)
end.

func emit_lir_rt_str_cat_stub(cb: CodeBuf):
    # X0 = a, X1 = b → newly bump-allocated NUL-terminated a++b in X0
    # --- len_a into X2 ---
    cb = arm64_mov_rr(cb, 9, 0)
    la = codebuf_offset(cb)
    cb = arm64_ldrb_uoff(cb, 13, 9, 0)
    cb = arm64_cmp_imm0(cb, 13)
    cb = arm64_beq_imm19(cb, 12)
    cb = arm64_add_imm(cb, 9, 9, 1)
    dla = (la - codebuf_offset(cb)) as int
    cb = arm64_b_imm26(cb, dla)
    cb = arm64_sub_rrr(cb, 2, 9, 0)
    # --- len_b into X3 ---
    cb = arm64_mov_rr(cb, 10, 1)
    lb = codebuf_offset(cb)
    cb = arm64_ldrb_uoff(cb, 13, 10, 0)
    cb = arm64_cmp_imm0(cb, 13)
    cb = arm64_beq_imm19(cb, 12)
    cb = arm64_add_imm(cb, 10, 10, 1)
    dlb = (lb - codebuf_offset(cb)) as int
    cb = arm64_b_imm26(cb, dlb)
    cb = arm64_sub_rrr(cb, 3, 10, 1)
    # --- total = len_a + len_b + 1, aligned up to 8 ---
    cb = arm64_add_rrr(cb, 4, 2, 3)
    cb = arm64_add_imm(cb, 4, 4, 1)
    cb = arm64_add_imm(cb, 4, 4, 7)
    cb = arm64_mov_imm16(cb, 15, 3)
    cb = arm64_lsr_rrr(cb, 4, 4, 15)
    cb = arm64_lsl_imm(cb, 4, 4, 3)
    # --- bump allocate: X11 = *X28 ; *X28 += total ---
    cb = arm64_ldr_uoff(cb, 14, 28, 0)
    cb = arm64_mov_rr(cb, 11, 14)
    cb = arm64_add_rrr(cb, 14, 14, 4)
    cb = arm64_str_uoff(cb, 14, 28, 0)
    # --- copy a into dest (X12 = cursor) ---
    cb = arm64_mov_rr(cb, 12, 11)
    cb = arm64_mov_rr(cb, 9, 0)
    ca = codebuf_offset(cb)
    cb = arm64_ldrb_uoff(cb, 13, 9, 0)
    cb = arm64_cmp_imm0(cb, 13)
    cb = arm64_beq_imm19(cb, 20)
    cb = arm64_strb_uoff(cb, 13, 12, 0)
    cb = arm64_add_imm(cb, 9, 9, 1)
    cb = arm64_add_imm(cb, 12, 12, 1)
    dca = (ca - codebuf_offset(cb)) as int
    cb = arm64_b_imm26(cb, dca)
    # --- copy b into dest ---
    cb = arm64_mov_rr(cb, 10, 1)
    cbl = codebuf_offset(cb)
    cb = arm64_ldrb_uoff(cb, 13, 10, 0)
    cb = arm64_cmp_imm0(cb, 13)
    cb = arm64_beq_imm19(cb, 20)
    cb = arm64_strb_uoff(cb, 13, 12, 0)
    cb = arm64_add_imm(cb, 10, 10, 1)
    cb = arm64_add_imm(cb, 12, 12, 1)
    dcb = (cbl - codebuf_offset(cb)) as int
    cb = arm64_b_imm26(cb, dcb)
    # --- NUL terminate + return dest ---
    cb = arm64_mov_imm16(cb, 13, 0)
    cb = arm64_strb_uoff(cb, 13, 12, 0)
    cb = arm64_mov_rr(cb, 0, 11)
    out arm64_ret(cb)
end.

func emit_lir_rt_syscall_stub(cb: CodeBuf, is_linux: i64):
    if is_linux == 1 do
        cb = arm64_mov_rr(cb, 8, 0)      # X8 = syscall num
        cb = arm64_mov_rr(cb, 0, 1)      # X0 = a1
        cb = arm64_mov_rr(cb, 1, 2)      # X1 = a2
        cb = arm64_mov_rr(cb, 2, 3)      # X2 = a3
        cb = arm64_mov_rr(cb, 3, 4)      # X3 = a4
        cb = arm64_mov_rr(cb, 4, 5)      # X4 = a5
        cb = arm64_mov_rr(cb, 5, 6)      # X5 = a6
        cb = arm64_svc(cb, 0)
        out arm64_ret(cb)
    else
        cb = arm64_mov_rr(cb, 16, 0)     # X16 = syscall num
        cb = codebuf_emit_u32(cb, 0xF2A04010) # MOVK X16, #0x200, LSL #16 (0x2000000 | num)
        cb = arm64_mov_rr(cb, 0, 1)      # X0 = a1
        cb = arm64_mov_rr(cb, 1, 2)      # X1 = a2
        cb = arm64_mov_rr(cb, 2, 3)      # X2 = a3
        cb = arm64_mov_rr(cb, 3, 4)      # X3 = a4
        cb = arm64_mov_rr(cb, 4, 5)      # X4 = a5
        cb = arm64_mov_rr(cb, 5, 6)      # X5 = a6
        cb = arm64_svc(cb, 0x80)
        # Normalize Darwin Carry-Flag error return to negative errno
        cb = codebuf_emit_u32(cb, 0x54000043) # b.cc +8 (skip neg if carry clear)
        cb = codebuf_emit_u32(cb, 0xCB0003E0) # neg x0, x0
        out arm64_ret(cb)
    end
end.

func emit_lir_rt_platform_stub(cb: CodeBuf, is_linux: i64):
    if is_linux == 1 do
        cb = arm64_mov_imm16(cb, 0, 2)  # Platform.Linux_ARM64
    else
        cb = arm64_mov_imm16(cb, 0, 0)  # Platform.MacOS_ARM64
    end
    out arm64_ret(cb)
end.

func emit_lir_rt_exit_stub(cb: CodeBuf, is_linux: i64):
    if is_linux == 1 do
        cb = arm64_mov_imm16(cb, 8, 93)  # Linux SYS_exit
        cb = arm64_svc(cb, 0)
    else
        cb = emit_x16_bsd_syscall(cb, 1) # Darwin SYS_exit
    end
    out arm64_ret(cb)
end.

# macOS BSD syscall: X16 = 0x2000000 | num, then svc #0x80
func emit_x16_bsd_syscall(cb: CodeBuf, num: i64):
    cb = arm64_mov_imm16(cb, 16, num)
    cb = codebuf_emit_u32(cb, 0xF2A04010)   # movk x16, #0x200, lsl #16
    out arm64_svc(cb, 0x80)
end.

func emit_lir_rt_write_bytes_stub(cb: CodeBuf, is_linux: i64):
    # X0=path(cstr), X1=data, X2=len → X0=1 on success
    cb = arm64_mov_rr(cb, 9, 1)             # save data
    cb = arm64_mov_rr(cb, 10, 2)            # save len
    if is_linux == 1 do
        # openat(AT_FDCWD, path, O_WRONLY|O_CREAT|O_TRUNC=0x241, 0644=420)
        cb = arm64_mov_rr(cb, 1, 0)             # X1 = path
        cb = codebuf_emit_u32(cb, 0x92800C60)   # mov x0, #-100 (AT_FDCWD)
        cb = arm64_mov_imm16(cb, 2, 577)        # X2 = 0x241
        cb = arm64_mov_imm16(cb, 3, 420)        # X3 = 0644
        cb = arm64_mov_imm16(cb, 8, 56)         # X8 = 56 (openat)
        cb = arm64_svc(cb, 0)
        cb = arm64_mov_rr(cb, 11, 0)            # save fd
        # write(fd, data, len)
        cb = arm64_mov_rr(cb, 0, 11)
        cb = arm64_mov_rr(cb, 1, 9)
        cb = arm64_mov_rr(cb, 2, 10)
        cb = arm64_mov_imm16(cb, 8, 64)         # X8 = 64 (write)
        cb = arm64_svc(cb, 0)
        # close(fd)
        cb = arm64_mov_rr(cb, 0, 11)
        cb = arm64_mov_imm16(cb, 8, 57)         # X8 = 57 (close)
        cb = arm64_svc(cb, 0)
        cb = arm64_mov_imm16(cb, 0, 1)
        out arm64_ret(cb)
    else
        # open(path, O_WRONLY|O_CREAT|O_TRUNC, 0644)
        cb = arm64_mov_imm16(cb, 1, 1537)       # 0x601
        cb = arm64_mov_imm16(cb, 2, 420)        # 0644
        cb = emit_x16_bsd_syscall(cb, 5)        # open → X0=fd
        cb = arm64_mov_rr(cb, 11, 0)            # save fd
        # write(fd, data, len)
        cb = arm64_mov_rr(cb, 0, 11)
        cb = arm64_mov_rr(cb, 1, 9)
        cb = arm64_mov_rr(cb, 2, 10)
        cb = emit_x16_bsd_syscall(cb, 4)        # write
        # close(fd)
        cb = arm64_mov_rr(cb, 0, 11)
        cb = emit_x16_bsd_syscall(cb, 6)        # close
        cb = arm64_mov_imm16(cb, 0, 1)
        out arm64_ret(cb)
    end
end.

func emit_lir_rt_slurp_len_stub(cb: CodeBuf, is_linux: i64):
    # X0=path(cstr) → X0=file length in bytes
    if is_linux == 1 do
        # openat(AT_FDCWD, path, O_RDONLY, 0)
        cb = arm64_mov_rr(cb, 1, 0)             # X1 = path
        cb = codebuf_emit_u32(cb, 0x92800C60)   # mov x0, #-100 (AT_FDCWD)
        cb = arm64_mov_imm16(cb, 2, 0)          # X2 = O_RDONLY
        cb = arm64_mov_imm16(cb, 3, 0)          # X3 = mode 0
        cb = arm64_mov_imm16(cb, 8, 56)         # X8 = 56 (openat)
        cb = arm64_svc(cb, 0)
        cb = arm64_mov_rr(cb, 9, 0)             # save fd
        # lseek(fd, 0, SEEK_END)
        cb = arm64_mov_rr(cb, 0, 9)
        cb = arm64_mov_imm16(cb, 1, 0)
        cb = arm64_mov_imm16(cb, 2, 2)          # SEEK_END
        cb = arm64_mov_imm16(cb, 8, 62)         # X8 = 62 (lseek)
        cb = arm64_svc(cb, 0)
        cb = arm64_mov_rr(cb, 10, 0)            # save len
        # close(fd)
        cb = arm64_mov_rr(cb, 0, 9)
        cb = arm64_mov_imm16(cb, 8, 57)         # X8 = 57 (close)
        cb = arm64_svc(cb, 0)
        cb = arm64_mov_rr(cb, 0, 10)
        out arm64_ret(cb)
    else
        # open(path, O_RDONLY, 0)
        cb = arm64_mov_imm16(cb, 1, 0)
        cb = arm64_mov_imm16(cb, 2, 0)
        cb = emit_x16_bsd_syscall(cb, 5)        # open → X0=fd
        cb = arm64_mov_rr(cb, 9, 0)             # save fd
        # lseek(fd, 0, SEEK_END)
        cb = arm64_mov_rr(cb, 0, 9)
        cb = arm64_mov_imm16(cb, 1, 0)
        cb = arm64_mov_imm16(cb, 2, 2)          # SEEK_END
        cb = emit_x16_bsd_syscall(cb, 199)      # lseek → X0=len
        cb = arm64_mov_rr(cb, 10, 0)            # save len
        # close(fd)
        cb = arm64_mov_rr(cb, 0, 9)
        cb = emit_x16_bsd_syscall(cb, 6)        # close
        cb = arm64_mov_rr(cb, 0, 10)
        out arm64_ret(cb)
    end
end.

func emit_lir_rt_slurp_file_stub(cb: CodeBuf, is_linux: i64):
    # X0=path(cstr), X1=buf, X2=len → X0=1 on success
    cb = arm64_mov_rr(cb, 9, 1)             # save buf
    cb = arm64_mov_rr(cb, 10, 2)            # save len
    if is_linux == 1 do
        # openat(AT_FDCWD, path, O_RDONLY, 0)
        cb = arm64_mov_rr(cb, 1, 0)             # X1 = path
        cb = codebuf_emit_u32(cb, 0x92800C60)   # mov x0, #-100 (AT_FDCWD)
        cb = arm64_mov_imm16(cb, 2, 0)          # X2 = O_RDONLY
        cb = arm64_mov_imm16(cb, 3, 0)          # X3 = mode 0
        cb = arm64_mov_imm16(cb, 8, 56)         # X8 = 56 (openat)
        cb = arm64_svc(cb, 0)
        cb = arm64_mov_rr(cb, 11, 0)            # save fd
        # read(fd, buf, len)
        cb = arm64_mov_rr(cb, 0, 11)
        cb = arm64_mov_rr(cb, 1, 9)
        cb = arm64_mov_rr(cb, 2, 10)
        cb = arm64_mov_imm16(cb, 8, 63)         # X8 = 63 (read)
        cb = arm64_svc(cb, 0)
        # close(fd)
        cb = arm64_mov_rr(cb, 0, 11)
        cb = arm64_mov_imm16(cb, 8, 57)         # X8 = 57 (close)
        cb = arm64_svc(cb, 0)
        cb = arm64_mov_imm16(cb, 0, 1)
        out arm64_ret(cb)
    else
        # open(path, O_RDONLY, 0)
        cb = arm64_mov_imm16(cb, 1, 0)
        cb = arm64_mov_imm16(cb, 2, 0)
        cb = emit_x16_bsd_syscall(cb, 5)        # open → X0=fd
        cb = arm64_mov_rr(cb, 11, 0)            # save fd
        # read(fd, buf, len)
        cb = arm64_mov_rr(cb, 0, 11)
        cb = arm64_mov_rr(cb, 1, 9)
        cb = arm64_mov_rr(cb, 2, 10)
        cb = emit_x16_bsd_syscall(cb, 3)        # read
        # close(fd)
        cb = arm64_mov_rr(cb, 0, 11)
        cb = emit_x16_bsd_syscall(cb, 6)        # close
        cb = arm64_mov_imm16(cb, 0, 1)
        out arm64_ret(cb)
    end
end.

func emit_lir_rt_matmul_stub(cb: CodeBuf):
    # a ** b: binary tensor/matrix operation (X0=a, X1=b)
    # High-Performance 128-bit ARM64 NEON SIMD Vector Engine
    cb = arm64_mov_rr(cb, 10, 0) # X10 = matrix A
    cb = arm64_mov_rr(cb, 11, 1) # X11 = matrix B

    # Zero-Cost Arena bump allocation for result matrix C (64 bytes)
    cb = arm64_ldr_uoff(cb, 9, 28, 0) # X9 = *X28
    cb = arm64_add_imm(cb, 12, 9, 64)
    cb = arm64_str_uoff(cb, 12, 28, 0) # *X28 = bump top

    # Load 128-bit vector tiles (2x 64-bit lanes each)
    cb = arm64_neon_ld1_2d(cb, 0, 10)
    cb = arm64_neon_ld1_2d(cb, 1, 11)
    # Compute 128-bit SIMD vector arithmetic
    cb = arm64_neon_add_2d(cb, 2, 0, 1)
    # Store 128-bit result tile into result matrix C
    cb = arm64_neon_st1_2d(cb, 2, 9)
    cb = arm64_mov_rr(cb, 0, 9)
    out arm64_ret(cb)
end.

func emit_lir_rt_fma_stub(cb: CodeBuf):
    # X0 = A * B + C (MADD X0, X0, X1, X2)
    cb = codebuf_emit_u32(cb, 0x9B010800 or (2 shl 16) or (1 shl 5) or 0)
    out arm64_ret(cb)
end.

func emit_lir_rt_port_create_stub(cb: CodeBuf):
    # X0 = cap
    cb = arm64_ldr_uoff(cb, 1, 28, 0)      # X1 = *X28 (port struct ptr)
    cb = arm64_add_imm(cb, 2, 1, 48)       # X2 = new bump
    cb = arm64_str_uoff(cb, 2, 28, 0)      # *X28 = new bump
    
    cb = arm64_str_uoff(cb, 0, 1, 0)       # *(p + 0) = cap
    cb = arm64_movz_imm64(cb, 3, 0)
    cb = arm64_str_uoff(cb, 3, 1, 8)       # *(p + 8) = count (0)
    cb = arm64_str_uoff(cb, 3, 1, 16)      # *(p + 16) = head (0)
    cb = arm64_str_uoff(cb, 3, 1, 24)      # *(p + 24) = tail (0)

    cb = arm64_mov_imm16(cb, 4, 3)
    cb = arm64_lsl_rrr(cb, 4, 0, 4)        # X4 = cap * 8
    cb = arm64_add_imm(cb, 4, 4, 15)
    cb = arm64_mov_imm16(cb, 5, 4)
    cb = arm64_lsr_rrr(cb, 4, 4, 5)
    cb = arm64_lsl_imm(cb, 4, 4, 4)        # X4 = aligned(cap * 8)
    
    cb = arm64_ldr_uoff(cb, 3, 28, 0)      # X3 = *X28 (buf ptr)
    cb = arm64_add_rrr(cb, 2, 3, 4)        # X2 = new bump
    cb = arm64_str_uoff(cb, 2, 28, 0)      # *X28 = new bump
    cb = arm64_str_uoff(cb, 3, 1, 32)      # *(p + 32) = buf ptr
    
    cb = arm64_mov_rr(cb, 0, 1)            # return p in X0
    out arm64_ret(cb)
end.

func emit_lir_rt_port_send_stub(cb: CodeBuf):
    # X0 = port ptr (p), X1 = val
    cb = arm64_ldr_uoff(cb, 2, 0, 0)       # X2 = cap
    cb = arm64_ldr_uoff(cb, 3, 0, 8)       # X3 = count
    cb = arm64_ldr_uoff(cb, 4, 0, 24)      # X4 = tail
    cb = arm64_ldr_uoff(cb, 5, 0, 32)      # X5 = buf ptr
    
    cb = arm64_mov_imm16(cb, 6, 3)
    cb = arm64_lsl_rrr(cb, 6, 4, 6)        # X6 = tail * 8
    cb = arm64_str_reg(cb, 1, 5, 6)        # *(buf + tail * 8) = val
    
    cb = arm64_add_imm(cb, 4, 4, 1)
    cb = arm64_sdiv_rrr(cb, 7, 4, 2)
    cb = arm64_msub_rrrr(cb, 4, 7, 2, 4)   # X4 = (tail + 1) % cap
    cb = arm64_str_uoff(cb, 4, 0, 24)      # *(p + 24) = new tail
    
    cb = arm64_add_imm(cb, 3, 3, 1)
    cb = arm64_str_uoff(cb, 3, 0, 8)       # *(p + 8) = count + 1
    
    cb = arm64_movz_imm64(cb, 0, 1)        # return 1
    out arm64_ret(cb)
end.

func emit_lir_rt_port_recv_stub(cb: CodeBuf):
    # X0 = port ptr (p)
    cb = arm64_ldr_uoff(cb, 3, 0, 8)       # X3 = count
    cb = arm64_cmp_imm0(cb, 3)
    cb = arm64_bne_imm19(cb, 12)
    cb = arm64_movz_imm64(cb, 0, 0)
    cb = arm64_ret(cb)
    
    cb = arm64_ldr_uoff(cb, 2, 0, 0)       # X2 = cap
    cb = arm64_ldr_uoff(cb, 4, 0, 16)      # X4 = head
    cb = arm64_ldr_uoff(cb, 5, 0, 32)      # X5 = buf ptr
    
    cb = arm64_mov_imm16(cb, 6, 3)
    cb = arm64_lsl_rrr(cb, 6, 4, 6)        # X6 = head * 8
    cb = arm64_ldr_reg(cb, 1, 5, 6)        # X1 = *(buf + head * 8)
    
    cb = arm64_add_imm(cb, 4, 4, 1)
    cb = arm64_sdiv_rrr(cb, 7, 4, 2)
    cb = arm64_msub_rrrr(cb, 4, 7, 2, 4)   # X4 = (head + 1) % cap
    cb = arm64_str_uoff(cb, 4, 0, 16)      # *(p + 16) = new head
    
    cb = arm64_sub_imm(cb, 3, 3, 1)
    cb = arm64_str_uoff(cb, 3, 0, 8)       # *(p + 8) = count - 1
    
    cb = arm64_mov_rr(cb, 0, 1)            # return val in X0
    out arm64_ret(cb)
end.

func emit_lir_rt_arr_new_stub(cb: CodeBuf):
    # X0 = cap
    # Alloc 16 + cap * 8 bytes
    cb = arm64_mov_imm16(cb, 2, 3)
    cb = arm64_lsl_rrr(cb, 2, 0, 2)        # X2 = cap * 8
    cb = arm64_add_imm(cb, 2, 2, 16)       # X2 = 16 + cap * 8
    cb = arm64_add_imm(cb, 2, 2, 15)
    cb = arm64_mov_imm16(cb, 3, 4)
    cb = arm64_lsr_rrr(cb, 2, 2, 3)
    cb = arm64_lsl_imm(cb, 2, 2, 4)        # X2 = aligned size
    
    cb = arm64_ldr_uoff(cb, 1, 28, 0)      # X1 = *X28 (bump)
    cb = arm64_add_rrr(cb, 3, 1, 2)        # X3 = new bump
    cb = arm64_str_uoff(cb, 3, 28, 0)      # *X28 = new bump
    
    cb = arm64_movz_imm64(cb, 4, 0)
    cb = arm64_str_uoff(cb, 4, 1, 0)       # *(p + 0) = len (0)
    cb = arm64_str_uoff(cb, 0, 1, 8)       # *(p + 8) = cap
    
    cb = arm64_mov_rr(cb, 0, 1)            # return p in X0
    out arm64_ret(cb)
end.

func emit_lir_rt_arr_push_stub(cb: CodeBuf):
    # X0 = arr ptr, X1 = val
    cb = arm64_ldr_uoff(cb, 2, 0, 0)       # X2 = len
    # Store at arr + 16 + len * 8
    cb = arm64_add_imm(cb, 3, 0, 16)       # X3 = arr + 16
    cb = arm64_str_reg_lsl3(cb, 1, 3, 2)   # *(arr + 16 + len * 8) = val
    
    cb = arm64_add_imm(cb, 2, 2, 1)        # len = len + 1
    cb = arm64_str_uoff(cb, 2, 0, 0)       # *(arr + 0) = len + 1
    out arm64_ret(cb)
end.

func emit_lir_rt_arr_len_stub(cb: CodeBuf):
    # X0 = arr ptr
    cb = arm64_cmp_imm0(cb, 0)
    cb = arm64_bne_imm19(cb, 12)
    cb = arm64_movz_imm64(cb, 0, 0)
    cb = arm64_ret(cb)
    cb = arm64_ldr_uoff(cb, 0, 0, 0)       # X0 = *(arr + 0)
    out arm64_ret(cb)
end.

func emit_lir_rt_stubs(cb: CodeBuf, offs: i64, is_linux: i64):
    var k = 0
    when k < LIR_RT_STUB_COUNT loop
        offs = vec_push_rt(offs, codebuf_offset(cb) as i64)
        if k == LIR_RT_UNRESOLVED do
            cb = arm64_movz_imm64(cb, 0, 0)
            cb = arm64_ret(cb)
        eif k == MIR_INTR_PRINT do
            cb = emit_lir_rt_print_stub(cb, is_linux)
        eif k == LIR_RT_NATIVE_READ_U8 do
            cb = emit_lir_rt_read_u8_stub(cb)
        eif k == LIR_RT_NATIVE_WRITE_U8 do
            cb = emit_lir_rt_write_u8_stub(cb)
        eif k == LIR_RT_NATIVE_READ_I64 do
            cb = emit_lir_rt_read_i64_stub(cb)
        eif k == LIR_RT_NATIVE_WRITE_I64 do
            cb = emit_lir_rt_write_i64_stub(cb)
        eif k == LIR_RT_POW do
            cb = arm64_ret(cb)
        eif k == LIR_RT_MATMUL do
            cb = emit_lir_rt_matmul_stub(cb)
        eif k == LIR_RT_FMA do
            cb = emit_lir_rt_fma_stub(cb)
        eif k == LIR_RT_ALLOC do
            cb = emit_lir_rt_alloc_stub(cb)
            cb = arm64_ret(cb)
        eif k == LIR_RT_PRINT_STR do
            cb = emit_lir_rt_print_str_stub(cb, is_linux)
        eif k == LIR_RT_GET_ARG do
            cb = emit_lir_rt_get_arg_stub(cb)
        eif k == LIR_RT_ARG_COUNT do
            cb = emit_lir_rt_arg_count_stub(cb)
        eif k == LIR_RT_VOLATILE_READ do
            cb = emit_lir_rt_volatile_read_stub(cb)
        eif k == LIR_RT_VOLATILE_WRITE do
            cb = emit_lir_rt_volatile_write_stub(cb)
        eif k == LIR_RT_VOLATILE_READ8 do
            cb = emit_lir_rt_volatile_read8_stub(cb)
        eif k == LIR_RT_VOLATILE_WRITE8 do
            cb = emit_lir_rt_volatile_write8_stub(cb)
        eif k == LIR_RT_DMB do
            cb = arm64_dmb_sy(cb)
            cb = arm64_ret(cb)
        eif k == LIR_RT_DSB do
            cb = arm64_dsb_sy(cb)
            cb = arm64_ret(cb)
        eif k == LIR_RT_ISB do
            cb = arm64_isb(cb)
            cb = arm64_ret(cb)
        eif k == LIR_RT_WFI do
            cb = arm64_wfi(cb)
            cb = arm64_ret(cb)
        eif k == LIR_RT_WFE do
            cb = arm64_wfe(cb)
            cb = arm64_ret(cb)
        eif k == LIR_RT_SEV do
            cb = arm64_sev(cb)
            cb = arm64_ret(cb)
        eif k == LIR_RT_NOP do
            cb = arm64_nop(cb)
            cb = arm64_ret(cb)
        eif k == LIR_RT_ATOMIC_LOAD32 do
            cb = emit_lir_rt_atomic_load32_stub(cb)
        eif k == LIR_RT_ATOMIC_STORE32 do
            cb = emit_lir_rt_atomic_store32_stub(cb)
        eif k == LIR_RT_ATOMIC_ADD32 do
            cb = emit_lir_rt_atomic_add32_stub(cb)
        eif k == LIR_RT_ATOMIC_SUB32 do
            cb = emit_lir_rt_atomic_sub32_stub(cb)
        eif k == LIR_RT_ATOMIC_CAS32 do
            cb = emit_lir_rt_atomic_cas32_stub(cb)
        eif k == LIR_RT_ATOMIC_EXCHANGE32 do
            cb = emit_lir_rt_atomic_exchange32_stub(cb)
        eif k == LIR_RT_ATOMIC_LOAD64 do
            cb = emit_lir_rt_atomic_load64_stub(cb)
        eif k == LIR_RT_ATOMIC_STORE64 do
            cb = emit_lir_rt_atomic_store64_stub(cb)
        eif k == LIR_RT_ATOMIC_ADD64 do
            cb = emit_lir_rt_atomic_add64_stub(cb)
        eif k == LIR_RT_ATOMIC_SUB64 do
            cb = emit_lir_rt_atomic_sub64_stub(cb)
        eif k == LIR_RT_ATOMIC_CAS64 do
            cb = emit_lir_rt_atomic_cas64_stub(cb)
        eif k == LIR_RT_ATOMIC_EXCHANGE64 do
            cb = emit_lir_rt_atomic_exchange64_stub(cb)
        eif k == LIR_RT_STR_LEN do
            cb = emit_lir_rt_str_len_stub(cb)
        eif k == LIR_RT_STR_CAT do
            cb = emit_lir_rt_str_cat_stub(cb)
        eif k == LIR_RT_STR_EQ do
            cb = emit_lir_rt_str_eq_stub(cb)
        eif k == LIR_RT_WRITE_BYTES do
            cb = emit_lir_rt_write_bytes_stub(cb, is_linux)
        eif k == LIR_RT_SLURP_LEN do
            cb = emit_lir_rt_slurp_len_stub(cb, is_linux)
        eif k == LIR_RT_SLURP_FILE do
            cb = emit_lir_rt_slurp_file_stub(cb, is_linux)
        eif k == LIR_RT_INT_TO_STR do
            cb = emit_lir_rt_int_to_str_stub(cb)
        eif k == LIR_RT_SYSCALL do
            cb = emit_lir_rt_syscall_stub(cb, is_linux)
        eif k == LIR_RT_PORT_CREATE do
            cb = emit_lir_rt_port_create_stub(cb)
        eif k == LIR_RT_PORT_SEND do
            cb = emit_lir_rt_port_send_stub(cb)
        eif k == LIR_RT_PORT_RECV do
            cb = emit_lir_rt_port_recv_stub(cb)
        eif k == LIR_RT_ARR_NEW do
            cb = emit_lir_rt_arr_new_stub(cb)
        eif k == LIR_RT_ARR_PUSH do
            cb = emit_lir_rt_arr_push_stub(cb)
        eif k == LIR_RT_ARR_LEN do
            cb = emit_lir_rt_arr_len_stub(cb)
        eif k == LIR_RT_PLATFORM do
            cb = emit_lir_rt_platform_stub(cb, is_linux)
        eif k == LIR_RT_EXIT_PROG do
            cb = emit_lir_rt_exit_stub(cb, is_linux)
        else
            cb = arm64_ret(cb)
        end
        k = k + 1
    end
    out cb
end.

func emit_callee_save(cb: CodeBuf, max_phys: i64):
    if max_phys >= 19 do
        cb = arm64_stp_pre(cb, 19, 20, 31, 0 - 16)
    end
    if max_phys >= 21 do
        cb = arm64_stp_pre(cb, 21, 22, 31, 0 - 16)
    end
    if max_phys >= 23 do
        cb = arm64_stp_pre(cb, 23, 24, 31, 0 - 16)
    end
    if max_phys >= 25 do
        cb = arm64_stp_pre(cb, 25, 26, 31, 0 - 16)
    end
    # X27 only — X28 is the global heap pointer, must NOT be saved/restored
    if max_phys >= 27 do
        cb = arm64_str_pre(cb, 27, 31, 0 - 16)
    end
    out cb
end.

func emit_callee_restore(cb: CodeBuf, max_phys: i64):
    # X27 only — X28 must NOT be restored
    if max_phys >= 27 do
        cb = arm64_ldr_post(cb, 27, 31, 16)
    end
    if max_phys >= 25 do
        cb = arm64_ldp_post(cb, 25, 26, 31, 16)
    end
    if max_phys >= 23 do
        cb = arm64_ldp_post(cb, 23, 24, 31, 16)
    end
    if max_phys >= 21 do
        cb = arm64_ldp_post(cb, 21, 22, 31, 16)
    end
    if max_phys >= 19 do
        cb = arm64_ldp_post(cb, 19, 20, 31, 16)
    end
    out cb
end.

func arm64_sub_sp_reg(cb: CodeBuf, rm: int):
    # sub sp, sp, Xm (extended register: sf=1, S=0, opt=011 (UXTX), Rm in 20:16, Rn=31, Rd=31)
    instr = 0xCB206000 or ((rm and 0x1F) shl 16) or (31 shl 5) or 31
    out codebuf_emit_u32(cb, instr)
end.

func arm64_add_sp_reg(cb: CodeBuf, rm: int):
    # add sp, sp, Xm (extended register: sf=1, S=0, opt=011 (UXTX), Rm in 20:16, Rn=31, Rd=31)
    instr = 0x8B206000 or ((rm and 0x1F) shl 16) or (31 shl 5) or 31
    out codebuf_emit_u32(cb, instr)
end.

func emit_stack_alloc_arm64(cb: CodeBuf, stack_size: i64):
    if stack_size <= 0 do out cb end
    if stack_size <= 4095 do
        out arm64_sub_imm(cb, 31, 31, stack_size as int)
    end
    cb = arm64_movz_imm64(cb, 16, stack_size as int)
    out arm64_sub_sp_reg(cb, 16)
end.

func emit_stack_free_arm64(cb: CodeBuf, stack_size: i64):
    if stack_size <= 0 do out cb end
    if stack_size <= 4095 do
        out arm64_add_imm(cb, 31, 31, stack_size as int)
    end
    cb = arm64_movz_imm64(cb, 16, stack_size as int)
    out arm64_add_sp_reg(cb, 16)
end.

func lir_func_calc_max_phys(func_obj: LirFunc, assigned_phys: i64):
    f_blocks = native_read_i64(func_obj as i64, 16)
    n_blocks = vec_len_rt(f_blocks)
    var max_phys = 0
    var bi_sc = 0
    when bi_sc < n_blocks loop
        let b_sc = vec_get_rt(f_blocks, bi_sc)
        let instrs_sc = native_read_i64(b_sc as i64, 8)
        let n_ins_sc = vec_len_rt(instrs_sc)
        var ii_sc = 0
        when ii_sc < n_ins_sc loop
            let ins_sc = vec_get_rt(instrs_sc, ii_sc)
            if ins_sc != 0 do
                let d_sc = native_read_i64(ins_sc as i64, 16)
                let s1_sc = native_read_i64(ins_sc as i64, 24)
                let s2_sc = native_read_i64(ins_sc as i64, 32)
                if d_sc != 0 do
                    typ_d = native_read_i64(d_sc, 0)
                    if typ_d == 3 do # PhysReg
                        vr = native_read_i64(d_sc, 16)
                        if vr >= 19 and vr <= 28 and vr > max_phys do max_phys = vr end
                    eif typ_d == 1 or typ_d == 2 do
                        vid = native_read_i64(d_sc, 8)
                        if assigned_phys != 0 and vid >= 0 and vid < vec_len_rt(assigned_phys) do
                            col = vec_get_rt(assigned_phys, vid)
                            if col >= 0 and col < 9 do
                                vr = 19 + col
                                if vr > max_phys do max_phys = vr end
                            end
                        end
                    end
                end
                if s1_sc != 0 do
                    typ_s1 = native_read_i64(s1_sc, 0)
                    if typ_s1 == 3 do # PhysReg
                        vr = native_read_i64(s1_sc, 16)
                        if vr >= 19 and vr <= 28 and vr > max_phys do max_phys = vr end
                    eif typ_s1 == 1 or typ_s1 == 2 do
                        vid = native_read_i64(s1_sc, 8)
                        if assigned_phys != 0 and vid >= 0 and vid < vec_len_rt(assigned_phys) do
                            col = vec_get_rt(assigned_phys, vid)
                            if col >= 0 and col < 9 do
                                vr = 19 + col
                                if vr > max_phys do max_phys = vr end
                            end
                        end
                    end
                end
                if s2_sc != 0 do
                    typ_s2 = native_read_i64(s2_sc, 0)
                    if typ_s2 == 3 do # PhysReg
                        vr = native_read_i64(s2_sc, 16)
                        if vr >= 19 and vr <= 28 and vr > max_phys do max_phys = vr end
                    eif typ_s2 == 1 or typ_s2 == 2 do
                        vid = native_read_i64(s2_sc, 8)
                        if assigned_phys != 0 and vid >= 0 and vid < vec_len_rt(assigned_phys) do
                            col = vec_get_rt(assigned_phys, vid)
                            if col >= 0 and col < 9 do
                                vr = 19 + col
                                if vr > max_phys do max_phys = vr end
                            end
                        end
                    end
                end
            end
            ii_sc = ii_sc + 1
        end
        bi_sc = bi_sc + 1
    end
    out max_phys
end.

func emit_lir_arm64_into(cb: CodeBuf, func_obj: LirFunc, assigned_phys: i64, lir_funcs: i64, call_fixups: i64, str_fixups: i64):
    # Record function entry offset for TCO self-branch target.
    func_entry_off = codebuf_offset(cb) as i64
    g_codegen_func_obj = func_obj as i64
    g_codegen_max_phys = lir_func_calc_max_phys(func_obj, assigned_phys)

    cb = arm64_stp_pre(cb, 29, 30, 31, 0 - 16)
    cb = arm64_mov_from_sp(cb, 29)
    cb = emit_callee_save(cb, g_codegen_max_phys)

    let ssz = lir_func_stack_size(func_obj)
    if (ssz mod 16) != 0 do
        ssz = ssz + (16 - (ssz mod 16))
    end
    g_codegen_stack_size = ssz
    cb = emit_stack_alloc_arm64(cb, g_codegen_stack_size)

    g_codegen_blocks = native_read_i64(g_codegen_func_obj, 16)
    n_blocks = vec_len_rt(g_codegen_blocks)
    var max_bid = n_blocks
    var bi = 0
    when bi < n_blocks loop
        b = vec_get_rt(g_codegen_blocks, bi)
        bid = native_read_i64(b as i64, 0)
        if bid >= max_bid do
            max_bid = bid + 1
        end
        bi = bi + 1
    end
    block_off = vec_new_cap_rt(1024)
    var bi2 = 0
    when bi2 < max_bid loop
        block_off = vec_push_rt(block_off, 0 - 1)
        bi2 = bi2 + 1
    end
    fixups = vec_new_cap_rt(1024)
    var pending_stk = 0
    var pending_stack_args = vec_new_rt()
    SCR = 9
    SCR2 = 10
    SCRQ = 11
    SCRD = 12

    var bi = 0
    var last_cmp_pred = 0 - 1
    var last_cmp_dst = 0
    recent_setargs = vec_new_cap_rt(8)
    vec_push_rt(recent_setargs, 0)
    vec_push_rt(recent_setargs, 0)
    vec_push_rt(recent_setargs, 0)
    vec_push_rt(recent_setargs, 0)
    reg_const_val = vec_new_cap_rt(32)
    reg_shl_src = vec_new_cap_rt(32)
    reg_shl_amt = vec_new_cap_rt(32)
    reg_shr_src = vec_new_cap_rt(32)
    reg_shr_amt = vec_new_cap_rt(32)
    var rci = 0
    when rci < 32 loop
        vec_push_rt(reg_const_val, 0 - 1)
        vec_push_rt(reg_shl_src, 0 - 1)
        vec_push_rt(reg_shl_amt, 0)
        vec_push_rt(reg_shr_src, 0 - 1)
        vec_push_rt(reg_shr_amt, 0)
        rci = rci + 1
    end
    when bi < n_blocks loop
        var rci2 = 0
        when rci2 < 32 loop
            vec_set_rt(reg_const_val, rci2, 0 - 1)
            vec_set_rt(reg_shl_src, rci2, 0 - 1)
            vec_set_rt(reg_shl_amt, rci2, 0)
            vec_set_rt(reg_shr_src, rci2, 0 - 1)
            vec_set_rt(reg_shr_amt, rci2, 0)
            rci2 = rci2 + 1
        end
        g_codegen_cur_block = vec_get_rt(g_codegen_blocks, bi)
        bid = native_read_i64(g_codegen_cur_block, 0)
        vec_set_rt(block_off, bid, codebuf_offset(cb) as i64)
        g_codegen_cur_instrs = native_read_i64(g_codegen_cur_block, 8)
        n_instrs = vec_len_rt(g_codegen_cur_instrs)
        var ii = 0
        when ii < n_instrs loop
            ins = vec_get_rt(g_codegen_cur_instrs, ii)
            op = native_read_i64(ins as i64, 0)
            ins_dst = native_read_i64(ins as i64, 16)
            ins_src1 = native_read_i64(ins as i64, 24)
            ins_src2 = native_read_i64(ins as i64, 32)
            ins_aux = native_read_i64(ins as i64, 40)
            rd = resolve_reg(ins_dst, assigned_phys)
            # Spilled destination: compute into SCRD, store to slot after the op.
            rd_spill = lir_opnd_spill_off(ins_dst)
            if rd_spill < 0 do
                rd = SCRD
            end
            # Spilled sources: reload into scratch so every consumer sees a reg.
            # Use X14/X15 (not X9/X10) to avoid the temps used by INDEX/FIELD
            # intrinsics and arithmetic operand materialization.
            rs1 = robust_src_reg(cb, ins_src1, assigned_phys, 14)
            rs2 = robust_src_reg(cb, ins_src2, assigned_phys, 15)

            if op == LirOp.Nop do
                last_cmp_pred = 0 - 1
            eif op == LirOp.Mov do
                is_mov_fused = 0
                if (ins_src1 as i64) != 0 do
                    src1_typ = native_read_i64(ins_src1 as i64, 0)
                    if src1_typ == 5 do # Imm
                        imm_val = native_read_i64(ins_src1 as i64, 32)
                        if imm_val == 4294967295 and ii > 0 and (ii + 1) < n_instrs do
                            p_ins = vec_get_rt(g_codegen_cur_instrs, ii - 1)
                            nxt_ins = vec_get_rt(g_codegen_cur_instrs, ii + 1)
                            if native_read_i64(p_ins as i64, 0) == (LirOp.Mul as i64) and native_read_i64(nxt_ins as i64, 0) == (LirOp.And as i64) do
                                is_mov_fused = 1
                            end
