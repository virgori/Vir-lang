##
 * vir/compiler/lir_codegen.vri — LIR to Machine Code
 * ==============================================================
 * Maps LirInstr to ARM64 Machine Code.
 ##

include types;
include vec_rt;
import vec_new_rt, vec_push_rt, vec_get_rt, vec_set_rt, vec_len_rt from vec_rt;
include lir;
import LirOp, LirOperandType, LirFunc from lir;
include codegen;
import codebuf_new, codebuf_emit_u32, TargetArch from codegen;
import arm64_add_rrr, arm64_sub_rrr, arm64_mul_rrr, arm64_sdiv_rrr, arm64_mov_rr, arm64_movz_imm64, arm64_ldr_post, arm64_str_pre, arm64_ret from codegen;

func emit_lir_arm64(func_obj: LirFunc, assigned_phys: i64, assigned_stack: i64)
    cb = codebuf_new(TargetArch.ARM64);
    
    # Prologue: allocate stack
    stack_size = func_obj.stack_size;
    # Align stack to 16 bytes
    if (stack_size % 16) != 0 do
        stack_size = stack_size + (16 - (stack_size % 16))
    end.
    
    if stack_size > 0 do
        # SUB SP, SP, #stack_size
        cb = arm64_sub_rrr(cb, 31, 31, 0) # Placeholder for sub sp, sp, imm
    end.
    
    n_blocks = vec_len_rt(func_obj.blocks);
    b_idx = 0;
    when b_idx < n_blocks loop
        b = vec_get_rt(func_obj.blocks, b_idx);
        instrs = b.instrs;
        n_instrs = vec_len_rt(instrs);
        
        i_idx = 0;
        when i_idx < n_instrs loop
            ins = vec_get_rt(instrs, i_idx);
            
            # Resolve physical registers
            rd = -1;
            rs1 = -1;
            rs2 = -1;
            
            if ins.dst.op_type == LirOperandType.VRegInt do
                rd = vec_get_rt(assigned_phys, ins.dst.vreg)
            eif ins.dst.op_type == LirOperandType.PhysReg do
                rd = ins.dst.phys_reg
            end.
            
            if ins.src1.op_type == LirOperandType.VRegInt do
                rs1 = vec_get_rt(assigned_phys, ins.src1.vreg)
            eif ins.src1.op_type == LirOperandType.PhysReg do
                rs1 = ins.src1.phys_reg
            end.
            
            if ins.src2.op_type == LirOperandType.VRegInt do
                rs2 = vec_get_rt(assigned_phys, ins.src2.vreg)
            eif ins.src2.op_type == LirOperandType.PhysReg do
                rs2 = ins.src2.phys_reg
            end.
            
            # Emit instruction
            if ins.op == LirOp.Add do
                if rd >= 0 and rs1 >= 0 and rs2 >= 0 do
                    cb = arm64_add_rrr(cb, rd, rs1, rs2)
                end
            eif ins.op == LirOp.Sub do
                if rd >= 0 and rs1 >= 0 and rs2 >= 0 do
                    cb = arm64_sub_rrr(cb, rd, rs1, rs2)
                end
            eif ins.op == LirOp.Mul do
                if rd >= 0 and rs1 >= 0 and rs2 >= 0 do
                    cb = arm64_mul_rrr(cb, rd, rs1, rs2)
                end
            eif ins.op == LirOp.Div do
                if rd >= 0 and rs1 >= 0 and rs2 >= 0 do
                    cb = arm64_sdiv_rrr(cb, rd, rs1, rs2)
                end
            eif ins.op == LirOp.Mov do
                if rd >= 0 do
                    if ins.src1.op_type == LirOperandType.Imm do
                        cb = arm64_movz_imm64(cb, rd, ins.src1.imm)
                    eif rs1 >= 0 do
                        cb = arm64_mov_rr(cb, rd, rs1)
                    end
                end
            eif ins.op == LirOp.Ret do
                if stack_size > 0 do
                    # ADD SP, SP, #stack_size (placeholder)
                    cb = arm64_add_rrr(cb, 31, 31, 0)
                end
                cb = arm64_ret(cb)
            end.
            
            i_idx = i_idx + 1
        end
        b_idx = b_idx + 1
    end.
    
    out cb
end.

export emit_lir_arm64;
