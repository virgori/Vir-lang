    cb = codebuf_emit_u32(cb, 0xC8047C01)
    cb = codebuf_emit_u32(cb, 0x35FFFFC4)
    cb = codebuf_emit_u32(cb, 0xAA0203E0)
    out arm64_ret(cb)
end.

func emit_lir_rt_str_len_stub(cb: CodeBuf):
    # X0 = C-string ptr → X0 = length (excluding NUL)
    cb = arm64_mov_rr(cb, 1, 0)
    len_loop = codebuf_offset(cb)
    cb = arm64_ldrb_uoff(cb, 2, 1, 0)
    cb = arm64_cmp_imm0(cb, 2)
    cb = arm64_beq_imm19(cb, 12)
    cb = arm64_add_imm(cb, 1, 1, 1)
    delta = (len_loop - codebuf_offset(cb)) as int
    cb = arm64_b_imm26(cb, delta)
    cb = arm64_sub_rrr(cb, 0, 1, 0)
    out arm64_ret(cb)
end.

func emit_lir_rt_str_eq_stub(cb: CodeBuf):
    # X0 = a, X1 = b → X0 = 1 if equal (as C-strings) else 0
    eq_loop = codebuf_offset(cb)
    cb = arm64_ldrb_uoff(cb, 2, 0, 0)
    cb = arm64_ldrb_uoff(cb, 3, 1, 0)
    cb = arm64_cmp_rr(cb, 2, 3)
    cb = arm64_bne_imm19(cb, 24)
    cb = arm64_cmp_imm0(cb, 2)
    cb = arm64_beq_imm19(cb, 24)
    cb = arm64_add_imm(cb, 0, 0, 1)
    cb = arm64_add_imm(cb, 1, 1, 1)
    delta = (eq_loop - codebuf_offset(cb)) as int
    cb = arm64_b_imm26(cb, delta)
    cb = arm64_mov_imm16(cb, 0, 0)
    cb = arm64_ret(cb)
    cb = arm64_mov_imm16(cb, 0, 1)
    out arm64_ret(cb)
end.

func emit_lir_rt_int_to_str_stub(cb: CodeBuf):
    # X0 = signed integer n → X0 = ptr to freshly bump-allocated NUL-terminated decimal string
    # --- allocate 32 bytes: X11 = base ; *X28 += 32 ---
    cb = arm64_ldr_uoff(cb, 14, 28, 0)
    cb = arm64_mov_rr(cb, 11, 14)
    cb = arm64_add_imm(cb, 14, 14, 32)
    cb = arm64_str_uoff(cb, 14, 28, 0)
    # --- cursor X10 = base+31, write NUL terminator ---
    cb = arm64_add_imm(cb, 10, 11, 31)
    cb = arm64_mov_imm16(cb, 15, 0)
    cb = arm64_strb_uoff(cb, 15, 10, 0)
    # --- X9 = n ; X12 = sign flag ---
    cb = arm64_mov_rr(cb, 9, 0)
    cb = arm64_mov_imm16(cb, 12, 0)
    # --- if n < 0: sign=1, n = 0 - n ---
    cb = arm64_cmp_imm0(cb, 9)
    cb = arm64_cset_lt(cb, 14)
    cb = arm64_cmp_imm0(cb, 14)
    cb = arm64_beq_imm19(cb, 16)
    cb = arm64_mov_imm16(cb, 12, 1)
    cb = arm64_mov_imm16(cb, 15, 0)
    cb = arm64_sub_rrr(cb, 9, 15, 9)
    # --- digit loop (do-while so 0 produces "0") ---
    dloop = codebuf_offset(cb)
    cb = arm64_mov_imm16(cb, 15, 10)
    cb = arm64_sdiv_rrr(cb, 13, 9, 15)
    cb = arm64_msub_rrrr(cb, 14, 13, 15, 9)
    cb = arm64_add_imm(cb, 14, 14, 48)
    cb = arm64_sub_imm(cb, 10, 10, 1)
    cb = arm64_strb_uoff(cb, 14, 10, 0)
    cb = arm64_mov_rr(cb, 9, 13)
    cb = arm64_cmp_imm0(cb, 9)
    ddelta = (dloop - codebuf_offset(cb)) as int
    cb = arm64_bne_imm19(cb, ddelta)
    # --- prepend '-' when negative ---
    cb = arm64_cmp_imm0(cb, 12)
    cb = arm64_beq_imm19(cb, 16)
    cb = arm64_sub_imm(cb, 10, 10, 1)
    cb = arm64_mov_imm16(cb, 15, 45)
    cb = arm64_strb_uoff(cb, 15, 10, 0)
    # --- return pointer to first char ---
    cb = arm64_mov_rr(cb, 0, 10)
    out arm64_ret(cb)
end.

func emit_lir_rt_str_cat_stub(cb: CodeBuf):
    # X0 = a, X1 = b → newly bump-allocated NUL-terminated a++b in X0
    # --- len_a into X2 ---
    cb = arm64_mov_rr(cb, 9, 0)
    la = codebuf_offset(cb)
    cb = arm64_ldrb_uoff(cb, 13, 9, 0)
    cb = arm64_cmp_imm0(cb, 13)
    cb = arm64_beq_imm19(cb, 12)
    cb = arm64_add_imm(cb, 9, 9, 1)
    dla = (la - codebuf_offset(cb)) as int
    cb = arm64_b_imm26(cb, dla)
    cb = arm64_sub_rrr(cb, 2, 9, 0)
    # --- len_b into X3 ---
    cb = arm64_mov_rr(cb, 10, 1)
    lb = codebuf_offset(cb)
    cb = arm64_ldrb_uoff(cb, 13, 10, 0)
    cb = arm64_cmp_imm0(cb, 13)
    cb = arm64_beq_imm19(cb, 12)
    cb = arm64_add_imm(cb, 10, 10, 1)
    dlb = (lb - codebuf_offset(cb)) as int
    cb = arm64_b_imm26(cb, dlb)
    cb = arm64_sub_rrr(cb, 3, 10, 1)
    # --- total = len_a + len_b + 1, aligned up to 8 ---
    cb = arm64_add_rrr(cb, 4, 2, 3)
    cb = arm64_add_imm(cb, 4, 4, 1)
    cb = arm64_add_imm(cb, 4, 4, 7)
    cb = arm64_mov_imm16(cb, 15, 3)
    cb = arm64_lsr_rrr(cb, 4, 4, 15)
    cb = arm64_lsl_imm(cb, 4, 4, 3)
    # --- bump allocate: X11 = *X28 ; *X28 += total ---
    cb = arm64_ldr_uoff(cb, 14, 28, 0)
    cb = arm64_mov_rr(cb, 11, 14)
    cb = arm64_add_rrr(cb, 14, 14, 4)
    cb = arm64_str_uoff(cb, 14, 28, 0)
    # --- copy a into dest (X12 = cursor) ---
    cb = arm64_mov_rr(cb, 12, 11)
    cb = arm64_mov_rr(cb, 9, 0)
    ca = codebuf_offset(cb)
    cb = arm64_ldrb_uoff(cb, 13, 9, 0)
    cb = arm64_cmp_imm0(cb, 13)
    cb = arm64_beq_imm19(cb, 20)
    cb = arm64_strb_uoff(cb, 13, 12, 0)
    cb = arm64_add_imm(cb, 9, 9, 1)
    cb = arm64_add_imm(cb, 12, 12, 1)
    dca = (ca - codebuf_offset(cb)) as int
    cb = arm64_b_imm26(cb, dca)
    # --- copy b into dest ---
    cb = arm64_mov_rr(cb, 10, 1)
    cbl = codebuf_offset(cb)
    cb = arm64_ldrb_uoff(cb, 13, 10, 0)
    cb = arm64_cmp_imm0(cb, 13)
    cb = arm64_beq_imm19(cb, 20)
    cb = arm64_strb_uoff(cb, 13, 12, 0)
    cb = arm64_add_imm(cb, 10, 10, 1)
    cb = arm64_add_imm(cb, 12, 12, 1)
    dcb = (cbl - codebuf_offset(cb)) as int
    cb = arm64_b_imm26(cb, dcb)
    # --- NUL terminate + return dest ---
    cb = arm64_mov_imm16(cb, 13, 0)
    cb = arm64_strb_uoff(cb, 13, 12, 0)
    cb = arm64_mov_rr(cb, 0, 11)
    out arm64_ret(cb)
end.

# macOS BSD syscall: X16 = 0x2000000 | num, then svc #0x80
func emit_x16_bsd_syscall(cb: CodeBuf, num: i64):
    cb = arm64_mov_imm16(cb, 16, num)
    cb = codebuf_emit_u32(cb, 0xF2A04010)   # movk x16, #0x200, lsl #16
    out arm64_svc(cb, 0x80)
end.

func emit_lir_rt_write_bytes_stub(cb: CodeBuf):
    # X0=path(cstr), X1=data, X2=len → X0=1 on success
    cb = arm64_mov_rr(cb, 9, 1)             # save data
    cb = arm64_mov_rr(cb, 10, 2)            # save len
    # open(path, O_WRONLY|O_CREAT|O_TRUNC, 0644)
    cb = arm64_mov_imm16(cb, 1, 1537)       # 0x601
    cb = arm64_mov_imm16(cb, 2, 420)        # 0644
    cb = emit_x16_bsd_syscall(cb, 5)        # open → X0=fd
    cb = arm64_mov_rr(cb, 11, 0)            # save fd
    # write(fd, data, len)
    cb = arm64_mov_rr(cb, 0, 11)
    cb = arm64_mov_rr(cb, 1, 9)
    cb = arm64_mov_rr(cb, 2, 10)
    cb = emit_x16_bsd_syscall(cb, 4)        # write
    # close(fd)
    cb = arm64_mov_rr(cb, 0, 11)
    cb = emit_x16_bsd_syscall(cb, 6)        # close
    cb = arm64_mov_imm16(cb, 0, 1)
    out arm64_ret(cb)
end.

func emit_lir_rt_slurp_len_stub(cb: CodeBuf):
    # X0=path(cstr) → X0=file length in bytes
    # open(path, O_RDONLY, 0)
    cb = arm64_mov_imm16(cb, 1, 0)
    cb = arm64_mov_imm16(cb, 2, 0)
    cb = emit_x16_bsd_syscall(cb, 5)        # open → X0=fd
    cb = arm64_mov_rr(cb, 9, 0)             # save fd
    # lseek(fd, 0, SEEK_END)
    cb = arm64_mov_rr(cb, 0, 9)
    cb = arm64_mov_imm16(cb, 1, 0)
    cb = arm64_mov_imm16(cb, 2, 2)          # SEEK_END
    cb = emit_x16_bsd_syscall(cb, 199)      # lseek → X0=len
    cb = arm64_mov_rr(cb, 10, 0)            # save len
    # close(fd)
    cb = arm64_mov_rr(cb, 0, 9)
    cb = emit_x16_bsd_syscall(cb, 6)        # close
    cb = arm64_mov_rr(cb, 0, 10)
    out arm64_ret(cb)
end.

func emit_lir_rt_slurp_file_stub(cb: CodeBuf):
    # X0=path(cstr), X1=buf, X2=len → X0=1 on success
    cb = arm64_mov_rr(cb, 9, 1)             # save buf
    cb = arm64_mov_rr(cb, 10, 2)            # save len
    # open(path, O_RDONLY, 0)
    cb = arm64_mov_imm16(cb, 1, 0)
    cb = arm64_mov_imm16(cb, 2, 0)
    cb = emit_x16_bsd_syscall(cb, 5)        # open → X0=fd
    cb = arm64_mov_rr(cb, 11, 0)            # save fd
    # read(fd, buf, len)
    cb = arm64_mov_rr(cb, 0, 11)
    cb = arm64_mov_rr(cb, 1, 9)
    cb = arm64_mov_rr(cb, 2, 10)
    cb = emit_x16_bsd_syscall(cb, 3)        # read
    # close(fd)
    cb = arm64_mov_rr(cb, 0, 11)
    cb = emit_x16_bsd_syscall(cb, 6)        # close
    cb = arm64_mov_imm16(cb, 0, 1)
    out arm64_ret(cb)
end.

func emit_lir_rt_stubs(cb: CodeBuf, offs: i64, is_linux: i64):
    var k = 0
    when k < LIR_RT_STUB_COUNT loop
        offs = vec_push_rt(offs, codebuf_offset(cb) as i64)
        if k == LIR_RT_UNRESOLVED do
            cb = arm64_movz_imm64(cb, 0, 0)
            cb = arm64_ret(cb)
        eif k == MIR_INTR_PRINT do
            cb = emit_lir_rt_print_stub(cb, is_linux)
        eif k == LIR_RT_NATIVE_READ_U8 do
            cb = emit_lir_rt_read_u8_stub(cb)
        eif k == LIR_RT_NATIVE_WRITE_U8 do
            cb = emit_lir_rt_write_u8_stub(cb)
        eif k == LIR_RT_NATIVE_READ_I64 do
            cb = emit_lir_rt_read_i64_stub(cb)
        eif k == LIR_RT_NATIVE_WRITE_I64 do
            cb = emit_lir_rt_write_i64_stub(cb)
        eif k == LIR_RT_POW do
            cb = arm64_ret(cb)
        eif k == LIR_RT_MATMUL do
            cb = arm64_movz_imm64(cb, 0, 0)
            cb = arm64_ret(cb)
        eif k == LIR_RT_FMA do
            cb = arm64_add_rrr(cb, 0, 0, 1)
            cb = arm64_ret(cb)
        eif k == LIR_RT_ALLOC do
            cb = emit_lir_rt_alloc_stub(cb)
            cb = arm64_ret(cb)
        eif k == LIR_RT_PRINT_STR do
            cb = emit_lir_rt_print_str_stub(cb, is_linux)
        eif k == LIR_RT_GET_ARG do
            cb = emit_lir_rt_get_arg_stub(cb)
        eif k == LIR_RT_ARG_COUNT do
            cb = emit_lir_rt_arg_count_stub(cb)
        eif k == LIR_RT_VOLATILE_READ do
            cb = emit_lir_rt_volatile_read_stub(cb)
        eif k == LIR_RT_VOLATILE_WRITE do
            cb = emit_lir_rt_volatile_write_stub(cb)
        eif k == LIR_RT_VOLATILE_READ8 do
            cb = emit_lir_rt_volatile_read8_stub(cb)
        eif k == LIR_RT_VOLATILE_WRITE8 do
            cb = emit_lir_rt_volatile_write8_stub(cb)
        eif k == LIR_RT_DMB do
            cb = arm64_dmb_sy(cb)
            cb = arm64_ret(cb)
        eif k == LIR_RT_DSB do
            cb = arm64_dsb_sy(cb)
            cb = arm64_ret(cb)
        eif k == LIR_RT_ISB do
            cb = arm64_isb(cb)
            cb = arm64_ret(cb)
        eif k == LIR_RT_WFI do
            cb = arm64_wfi(cb)
            cb = arm64_ret(cb)
        eif k == LIR_RT_WFE do
            cb = arm64_wfe(cb)
            cb = arm64_ret(cb)
        eif k == LIR_RT_SEV do
            cb = arm64_sev(cb)
            cb = arm64_ret(cb)
        eif k == LIR_RT_NOP do
            cb = arm64_nop(cb)
            cb = arm64_ret(cb)
        eif k == LIR_RT_ATOMIC_LOAD32 do
            cb = emit_lir_rt_atomic_load32_stub(cb)
        eif k == LIR_RT_ATOMIC_STORE32 do
            cb = emit_lir_rt_atomic_store32_stub(cb)
        eif k == LIR_RT_ATOMIC_ADD32 do
            cb = emit_lir_rt_atomic_add32_stub(cb)
        eif k == LIR_RT_ATOMIC_SUB32 do
            cb = emit_lir_rt_atomic_sub32_stub(cb)
        eif k == LIR_RT_ATOMIC_CAS32 do
            cb = emit_lir_rt_atomic_cas32_stub(cb)
        eif k == LIR_RT_ATOMIC_EXCHANGE32 do
            cb = emit_lir_rt_atomic_exchange32_stub(cb)
        eif k == LIR_RT_ATOMIC_LOAD64 do
            cb = emit_lir_rt_atomic_load64_stub(cb)
        eif k == LIR_RT_ATOMIC_STORE64 do
            cb = emit_lir_rt_atomic_store64_stub(cb)
        eif k == LIR_RT_ATOMIC_ADD64 do
            cb = emit_lir_rt_atomic_add64_stub(cb)
        eif k == LIR_RT_ATOMIC_SUB64 do
            cb = emit_lir_rt_atomic_sub64_stub(cb)
        eif k == LIR_RT_ATOMIC_CAS64 do
            cb = emit_lir_rt_atomic_cas64_stub(cb)
        eif k == LIR_RT_ATOMIC_EXCHANGE64 do
            cb = emit_lir_rt_atomic_exchange64_stub(cb)
        eif k == LIR_RT_STR_LEN do
            cb = emit_lir_rt_str_len_stub(cb)
        eif k == LIR_RT_STR_CAT do
            cb = emit_lir_rt_str_cat_stub(cb)
        eif k == LIR_RT_STR_EQ do
            cb = emit_lir_rt_str_eq_stub(cb)
        eif k == LIR_RT_WRITE_BYTES do
            cb = emit_lir_rt_write_bytes_stub(cb)
        eif k == LIR_RT_SLURP_LEN do
            cb = emit_lir_rt_slurp_len_stub(cb)
        eif k == LIR_RT_SLURP_FILE do
            cb = emit_lir_rt_slurp_file_stub(cb)
        eif k == LIR_RT_INT_TO_STR do
            cb = emit_lir_rt_int_to_str_stub(cb)
        else
            cb = arm64_ret(cb)
        end
        k = k + 1
    end
    out cb
end.

func emit_callee_save(cb: CodeBuf, max_phys: i64):
    if max_phys >= 19 do
        cb = arm64_stp_pre(cb, 19, 20, 31, 0 - 16)
    end
    if max_phys >= 21 do
        cb = arm64_stp_pre(cb, 21, 22, 31, 0 - 16)
    end
    if max_phys >= 23 do
        cb = arm64_stp_pre(cb, 23, 24, 31, 0 - 16)
    end
    if max_phys >= 25 do
        cb = arm64_stp_pre(cb, 25, 26, 31, 0 - 16)
    end
    if max_phys >= 27 do
        cb = arm64_stp_pre(cb, 27, 28, 31, 0 - 16)
    end
    out cb
end.

func emit_callee_restore(cb: CodeBuf, max_phys: i64):
    if max_phys >= 27 do
        cb = arm64_ldp_post(cb, 27, 28, 31, 16)
    end
    if max_phys >= 25 do
        cb = arm64_ldp_post(cb, 25, 26, 31, 16)
    end
    if max_phys >= 23 do
        cb = arm64_ldp_post(cb, 23, 24, 31, 16)
    end
    if max_phys >= 21 do
        cb = arm64_ldp_post(cb, 21, 22, 31, 16)
    end
    if max_phys >= 19 do
        cb = arm64_ldp_post(cb, 19, 20, 31, 16)
    end
    out cb
end.

func emit_lir_arm64_into(cb: CodeBuf, func_obj: LirFunc, assigned_phys: i64, lir_funcs: i64, call_fixups: i64, str_fixups: i64):
    # Record function entry offset for TCO self-branch target.
    func_entry_off = codebuf_offset(cb) as i64
    f_blocks = native_read_i64(func_obj as i64, 16)
    n_blocks = vec_len_rt(f_blocks)

    var max_phys = 0
    var bi_sc = 0
    when bi_sc < n_blocks loop
        b_sc = vec_get_rt(f_blocks, bi_sc)
        instrs_sc = native_read_i64(b_sc as i64, 8)
        n_ins_sc = vec_len_rt(instrs_sc)
        var ii_sc = 0
        when ii_sc < n_ins_sc loop
            ins_sc = vec_get_rt(instrs_sc, ii_sc)
            d_sc = native_read_i64(ins_sc as i64, 16)
            s1_sc = native_read_i64(ins_sc as i64, 24)
            s2_sc = native_read_i64(ins_sc as i64, 32)
            if d_sc != 0 do
                typ_d = native_read_i64(d_sc, 0)
                if typ_d == 2 do
                    vr = native_read_i64(d_sc, 16)
                    if vr >= 19 and vr <= 28 and vr > max_phys do max_phys = vr end
                eif typ_d == 1 do
                    vid = native_read_i64(d_sc, 8)
                    if assigned_phys != 0 and vid >= 0 and vid < vec_len_rt(assigned_phys) do
                        col = vec_get_rt(assigned_phys, vid)
                        if col >= 0 and col < 9 do
                            vr = 19 + col
                            if vr > max_phys do max_phys = vr end
                        end
                    end
                end
            end
            if s1_sc != 0 do
                typ_s1 = native_read_i64(s1_sc, 0)
                if typ_s1 == 2 do
                    vr = native_read_i64(s1_sc, 16)
                    if vr >= 19 and vr <= 28 and vr > max_phys do max_phys = vr end
                eif typ_s1 == 1 do
                    vid = native_read_i64(s1_sc, 8)
                    if assigned_phys != 0 and vid >= 0 and vid < vec_len_rt(assigned_phys) do
                        col = vec_get_rt(assigned_phys, vid)
                        if col >= 0 and col < 9 do
                            vr = 19 + col
                            if vr > max_phys do max_phys = vr end
                        end
                    end
                end
            end
            if s2_sc != 0 do
                typ_s2 = native_read_i64(s2_sc, 0)
                if typ_s2 == 2 do
                    vr = native_read_i64(s2_sc, 16)
                    if vr >= 19 and vr <= 28 and vr > max_phys do max_phys = vr end
                eif typ_s2 == 1 do
                    vid = native_read_i64(s2_sc, 8)
                    if assigned_phys != 0 and vid >= 0 and vid < vec_len_rt(assigned_phys) do
                        col = vec_get_rt(assigned_phys, vid)
                        if col >= 0 and col < 9 do
                            vr = 19 + col
                            if vr > max_phys do max_phys = vr end
                        end
                    end
                end
            end
            ii_sc = ii_sc + 1
        end
        bi_sc = bi_sc + 1
    end

    cb = arm64_stp_pre(cb, 29, 30, 31, 0 - 16)
    cb = arm64_mov_from_sp(cb, 29)
    cb = emit_callee_save(cb, max_phys)

    stack_size = lir_func_stack_size(func_obj)
    if (stack_size mod 16) != 0 do
        stack_size = stack_size + (16 - (stack_size mod 16))
    end
    if stack_size > 0 and stack_size <= 4095 do
        cb = arm64_sub_imm(cb, 31, 31, stack_size as int)
    end

    f_blocks = native_read_i64(func_obj as i64, 16)
    n_blocks = vec_len_rt(f_blocks)
    var max_bid = n_blocks
    var bi = 0
    when bi < n_blocks loop
        b = vec_get_rt(f_blocks, bi)
        bid = native_read_i64(b as i64, 0)
        if bid >= max_bid do
            max_bid = bid + 1
        end
        bi = bi + 1
    end
    block_off = vec_new_cap_rt(1024)
    var bi2 = 0
    when bi2 < max_bid loop
        block_off = vec_push_rt(block_off, 0 - 1)
        bi2 = bi2 + 1
    end
    fixups = vec_new_cap_rt(1024)
    var pending_stk = 0
    SCR = 9
    SCR2 = 10
    SCRQ = 11
    SCRD = 12

    var bi = 0
    var last_cmp_pred = 0 - 1
    var last_cmp_dst = 0
    recent_setargs = vec_new_cap_rt(8)
    vec_push_rt(recent_setargs, 0)
    vec_push_rt(recent_setargs, 0)
    vec_push_rt(recent_setargs, 0)
    vec_push_rt(recent_setargs, 0)
    reg_const_val = vec_new_cap_rt(32)
    reg_shl_src = vec_new_cap_rt(32)
    reg_shl_amt = vec_new_cap_rt(32)
    reg_shr_src = vec_new_cap_rt(32)
    reg_shr_amt = vec_new_cap_rt(32)
    var rci = 0
    when rci < 32 loop
        vec_push_rt(reg_const_val, 0 - 1)
        vec_push_rt(reg_shl_src, 0 - 1)
        vec_push_rt(reg_shl_amt, 0)
        vec_push_rt(reg_shr_src, 0 - 1)
        vec_push_rt(reg_shr_amt, 0)
        rci = rci + 1
    end
    when bi < n_blocks loop
        b = vec_get_rt(f_blocks, bi)
        bid = native_read_i64(b as i64, 0)
        vec_set_rt(block_off, bid, codebuf_offset(cb) as i64)
        instrs = native_read_i64(b as i64, 8)
        n_instrs = vec_len_rt(instrs)
        var ii = 0
        when ii < n_instrs loop
            ins = vec_get_rt(instrs, ii)
            op = native_read_i64(ins as i64, 0)
            ins_dst = native_read_i64(ins as i64, 16)
            ins_src1 = native_read_i64(ins as i64, 24)
            ins_src2 = native_read_i64(ins as i64, 32)
            ins_aux = native_read_i64(ins as i64, 40)
            rd = resolve_reg(ins_dst, assigned_phys)
            # Spilled destination: compute into SCRD, store to slot after the op.
            rd_spill = lir_opnd_spill_off(ins_dst)
            if rd_spill < 0 do
                rd = SCRD
            end
            # Spilled sources: reload into scratch so every consumer sees a reg.
            # Use X14/X15 (not X9/X10) to avoid the temps used by INDEX/FIELD
            # intrinsics and arithmetic operand materialization.
            rs1 = robust_src_reg(cb, ins_src1, assigned_phys, 14)
            rs2 = robust_src_reg(cb, ins_src2, assigned_phys, 15)

            if op == LirOp.Nop do
                last_cmp_pred = 0 - 1
            eif op == LirOp.Mov do
                is_mov_fused = 0
                if (ins_src1 as i64) != 0 do
                    src1_typ = native_read_i64(ins_src1 as i64, 0)
                    if src1_typ == 4 or src1_typ == 5 do
                        imm_val = native_read_i64(ins_src1 as i64, 32)
                        if imm_val == 4294967295 and ii > 0 and (ii + 1) < n_instrs do
                            p_ins = vec_get_rt(instrs, ii - 1)
                            nxt_ins = vec_get_rt(instrs, ii + 1)
                            if native_read_i64(p_ins as i64, 0) == (LirOp.Mul as i64) and native_read_i64(nxt_ins as i64, 0) == (LirOp.And as i64) do
                                is_mov_fused = 1
                            end
                        end
                        if rd >= 0 and rd < 32 do
                            vec_set_rt(reg_const_val, rd, imm_val)
                        end
                        if is_mov_fused == 0 and rd >= 0 do
                            cb = arm64_movz_imm64(cb, rd as int, imm_val as int)
                        end
                    eif rd >= 0 and rs1 >= 0 do
                        if rd < 32 and rs1 < 32 do
                            vec_set_rt(reg_const_val, rd, vec_get_rt(reg_const_val, rs1))
                            vec_set_rt(reg_shl_src, rd, vec_get_rt(reg_shl_src, rs1))
                            vec_set_rt(reg_shl_amt, rd, vec_get_rt(reg_shl_amt, rs1))
                            vec_set_rt(reg_shr_src, rd, vec_get_rt(reg_shr_src, rs1))
                            vec_set_rt(reg_shr_amt, rd, vec_get_rt(reg_shr_amt, rs1))
                        end
                        if rd != rs1 do
                            cb = arm64_mov_rr(cb, rd as int, rs1 as int)
                        end
                    end
                end
                last_cmp_pred = 0 - 1
            eif op == LirOp.Add do
                a = resolve_or_imm_reg(cb, ins_src1, assigned_phys, SCR)
                is_imm_add = 0
                imm_v = 0 - 1
                if (ins_src2 as i64) != 0 do
                    s2_typ = native_read_i64(ins_src2 as i64, 0)
                    if s2_typ == 4 or s2_typ == 5 do
                        imm_v = native_read_i64(ins_src2 as i64, 32)
                    end
                end
                if imm_v < 0 and rs2 >= 0 and rs2 < 32 do
                    imm_v = vec_get_rt(reg_const_val, rs2)
                end
                if imm_v >= 0 and imm_v <= 4095 and rd >= 0 and a >= 0 do
                    cb = arm64_add_imm(cb, rd as int, a as int, imm_v as int)
                    is_imm_add = 1
                end
                if is_imm_add == 0 do
                    is_madd = 0
                    if ii > 0 do
                        p_ins = vec_get_rt(instrs, ii - 1)
                        if native_read_i64(p_ins as i64, 0) == (LirOp.Mul as i64) do
                            p_dst = native_read_i64(p_ins as i64, 16)
                            if lir_opnd_matches(ins_src1, p_dst) == 1 do
                                p_s1 = native_read_i64(p_ins as i64, 24)
                                p_s2 = native_read_i64(p_ins as i64, 32)
                                p_rn = resolve_or_imm_reg(cb, p_s1, assigned_phys, SCR)
                                p_rm = resolve_or_imm_reg(cb, p_s2, assigned_phys, SCR2)
                                ra_reg = resolve_or_imm_reg(cb, ins_src2, assigned_phys, 13)
                                if rd >= 0 and p_rn >= 0 and p_rm >= 0 and ra_reg >= 0 do
                                    cb = arm64_madd_rrrr(cb, rd as int, p_rn as int, p_rm as int, ra_reg as int)
                                    is_madd = 1
                                end
                            eif lir_opnd_matches(ins_src2, p_dst) == 1 do
                                p_s1 = native_read_i64(p_ins as i64, 24)
                                p_s2 = native_read_i64(p_ins as i64, 32)
                                p_rn = resolve_or_imm_reg(cb, p_s1, assigned_phys, SCR)
                                p_rm = resolve_or_imm_reg(cb, p_s2, assigned_phys, SCR2)
                                ra_reg = resolve_or_imm_reg(cb, ins_src1, assigned_phys, 13)
                                if rd >= 0 and p_rn >= 0 and p_rm >= 0 and ra_reg >= 0 do
                                    cb = arm64_madd_rrrr(cb, rd as int, p_rn as int, p_rm as int, ra_reg as int)
                                    is_madd = 1
                                end
                            end
                        end
                    end
                    if is_madd == 0 do
                        breg = resolve_or_imm_reg(cb, ins_src2, assigned_phys, SCR2)
                        if rd >= 0 and a >= 0 and breg >= 0 do
                            cb = arm64_add_rrr(cb, rd as int, a as int, breg as int)
                        end
                    end
                end
                if rd >= 0 and rd < 32 do
                    vec_set_rt(reg_const_val, rd, 0 - 1)
                end
                last_cmp_pred = 0 - 1
            eif op == LirOp.Sub do
                a = resolve_or_imm_reg(cb, ins_src1, assigned_phys, SCR)
                is_imm_sub = 0
                imm_v = 0 - 1
                if (ins_src2 as i64) != 0 do
                    s2_typ = native_read_i64(ins_src2 as i64, 0)
                    if s2_typ == 4 or s2_typ == 5 do
                        imm_v = native_read_i64(ins_src2 as i64, 32)
                    end
                end
                if imm_v < 0 and rs2 >= 0 and rs2 < 32 do
                    imm_v = vec_get_rt(reg_const_val, rs2)
                end
                if imm_v >= 0 and imm_v <= 4095 and rd >= 0 and a >= 0 do
                    cb = arm64_sub_imm(cb, rd as int, a as int, imm_v as int)
                    is_imm_sub = 1
                end
                if is_imm_sub == 0 do
                    breg = resolve_or_imm_reg(cb, ins_src2, assigned_phys, SCR2)
                    if rd >= 0 and a >= 0 and breg >= 0 do
                        cb = arm64_sub_rrr(cb, rd as int, a as int, breg as int)
                    end
                end
                if rd >= 0 and rd < 32 do
                    vec_set_rt(reg_const_val, rd, 0 - 1)
                end
                last_cmp_pred = 0 - 1
            eif op == LirOp.Mul do
                a = resolve_or_imm_reg(cb, ins_src1, assigned_phys, SCR)
                breg = resolve_or_imm_reg(cb, ins_src2, assigned_phys, SCR2)
                is_fused_32bit_mul = 0
                if (ii + 2) < n_instrs do
                    mov_ins = vec_get_rt(instrs, ii + 1)
                    and_ins = vec_get_rt(instrs, ii + 2)
                    if native_read_i64(mov_ins as i64, 0) == 1 and native_read_i64(and_ins as i64, 0) == (LirOp.And as i64) do
                        m_src1 = native_read_i64(mov_ins as i64, 24)
                        m_dst = native_read_i64(mov_ins as i64, 16)
                        if (m_src1 as i64) != 0 do
                            if native_read_i64(m_src1 as i64, 0) == 4 and native_read_i64(m_src1 as i64, 32) == 4294967295 do
                                a_s1 = native_read_i64(and_ins as i64, 24)
                                a_s2 = native_read_i64(and_ins as i64, 32)
                                a_dst = native_read_i64(and_ins as i64, 16)
                                if (lir_opnd_matches(ins_dst, a_s1) == 1 and lir_opnd_matches(m_dst, a_s2) == 1) or (lir_opnd_matches(ins_dst, a_s2) == 1 and lir_opnd_matches(m_dst, a_s1) == 1) do
                                    n_rd = -1
                                    if a_dst != 0 do
                                        if native_read_i64(a_dst, 0) == 1 do
                                            v_id = native_read_i64(a_dst, 8)
                                            if v_id >= 0 and v_id < vec_len_rt(assigned_phys) do
                                                p_c = vec_get_rt(assigned_phys, v_id)
                                                if p_c >= 0 do n_rd = color_to_phys(p_c) end
                                            end
                                        eif native_read_i64(a_dst, 0) == 2 do
                                            n_rd = native_read_i64(a_dst, 16)
                                        end
                                    end
                                    target_rd = rd
                                    if n_rd >= 0 do target_rd = n_rd end
                                    if target_rd >= 0 and a >= 0 and breg >= 0 do
                                        mul_w = 0x1B007C00 bit_or ((breg as int bit_and 0x1F) shl 16) bit_or ((a as int bit_and 0x1F) shl 5) bit_or (target_rd as int bit_and 0x1F)
                                        cb = codebuf_emit_u32(cb, mul_w)
                                        is_fused_32bit_mul = 1
                                    end
                                end
                            end
                        end
                    end
                end
                if is_fused_32bit_mul == 0 and (ii + 1) < n_instrs do
                    next_ins = vec_get_rt(instrs, ii + 1)
                    if native_read_i64(next_ins as i64, 0) == (LirOp.And as i64) do
                        n_s1 = native_read_i64(next_ins as i64, 24)
                        n_s2 = native_read_i64(next_ins as i64, 32)
                        n_dst = native_read_i64(next_ins as i64, 16)
                        var mask_val = 0 - 1
                        if (n_s2 as i64) != 0 do
                            if native_read_i64(n_s2 as i64, 0) == 4 do
                                mask_val = native_read_i64(n_s2 as i64, 32)
                            end
                        end
                        if mask_val == 4294967295 and lir_opnd_matches(ins_dst, n_s1) == 1 do
                            n_rd = -1
                            if n_dst != 0 do
                                if native_read_i64(n_dst, 0) == 1 do
                                    v_id = native_read_i64(n_dst, 8)
                                    if v_id >= 0 and v_id < vec_len_rt(assigned_phys) do
                                        p_c = vec_get_rt(assigned_phys, v_id)
                                        if p_c >= 0 do n_rd = color_to_phys(p_c) end
                                    end
                                eif native_read_i64(n_dst, 0) == 2 do
                                    n_rd = native_read_i64(n_dst, 16)
                                end
                            end
                            target_rd = rd
                            if n_rd >= 0 do target_rd = n_rd end
                            if target_rd >= 0 and a >= 0 and breg >= 0 do
                                mul_w = 0x1B007C00 bit_or ((breg as int bit_and 0x1F) shl 16) bit_or ((a as int bit_and 0x1F) shl 5) bit_or (target_rd as int bit_and 0x1F)
                                cb = codebuf_emit_u32(cb, mul_w)
                                is_fused_32bit_mul = 1
                            end
                        end
                    end
                end
                if is_fused_32bit_mul == 0 do
                    if rd >= 0 and a >= 0 and breg >= 0 do
                        cb = arm64_mul_rrr(cb, rd as int, a as int, breg as int)
                    end
                end
                if rd >= 0 and rd < 32 do
                    vec_set_rt(reg_const_val, rd, 0 - 1)
                end
                last_cmp_pred = 0 - 1
            eif op == LirOp.Div do
                a = resolve_or_imm_reg(cb, ins_src1, assigned_phys, SCR)
                breg = resolve_or_imm_reg(cb, ins_src2, assigned_phys, SCR2)
                if rd >= 0 and a >= 0 and breg >= 0 do
                    cb = arm64_sdiv_rrr(cb, rd as int, a as int, breg as int)
                end
                if rd >= 0 and rd < 32 do
                    vec_set_rt(reg_const_val, rd, 0 - 1)
                end
                last_cmp_pred = 0 - 1
            eif op == LirOp.Rem do
                a = resolve_or_imm_reg(cb, ins_src1, assigned_phys, SCR)
                breg = resolve_or_imm_reg(cb, ins_src2, assigned_phys, SCR2)
                if rd >= 0 and a >= 0 and breg >= 0 do
                    cb = arm64_sdiv_rrr(cb, SCRQ, a as int, breg as int)
                    cb = arm64_msub_rrrr(cb, rd as int, SCRQ, breg as int, a as int)
                end
                if rd >= 0 and rd < 32 do
                    vec_set_rt(reg_const_val, rd, 0 - 1)
                end
                last_cmp_pred = 0 - 1
            eif op == LirOp.And do
                is_prev_fused = 0
                var is_32bit_mask = 0
                if (ins_src2 as i64) != 0 do
                    if native_read_i64(ins_src2 as i64, 0) == 4 and native_read_i64(ins_src2 as i64, 32) == 4294967295 do
                        is_32bit_mask = 1
                    end
                end
                if is_32bit_mask == 0 and rs2 >= 0 and rs2 < 32 do
                    if vec_get_rt(reg_const_val, rs2) == 4294967295 do
                        is_32bit_mask = 1
                    end
                end
                if is_32bit_mask == 1 do
                    if ii > 0 do
                        prev_ins = vec_get_rt(instrs, ii - 1)
                        if native_read_i64(prev_ins as i64, 0) == (LirOp.Mul as i64) do
                            is_prev_fused = 1
                        end
                    end
                    if is_prev_fused == 0 and ii > 1 do
                        prev2_ins = vec_get_rt(instrs, ii - 2)
                        if native_read_i64(prev2_ins as i64, 0) == (LirOp.Mul as i64) do
                            is_prev_fused = 1
                        end
                    end
                end
                if is_prev_fused == 0 do
                    is_mask_imm = 0
                    mask_v = 0 - 1
                    var var_opnd = ins_src1
                    if (ins_src2 as i64) != 0 do
                        s2_typ = native_read_i64(ins_src2 as i64, 0)
                        if s2_typ == 4 or s2_typ == 5 do
                            mask_v = native_read_i64(ins_src2 as i64, 32)
                            var_opnd = ins_src1
                        end
                    end
                    if mask_v < 0 and (ins_src1 as i64) != 0 do
                        s1_typ = native_read_i64(ins_src1 as i64, 0)
                        if s1_typ == 4 or s1_typ == 5 do
                            mask_v = native_read_i64(ins_src1 as i64, 32)
                            var_opnd = ins_src2
                        end
                    end
                    if mask_v == 255 or mask_v == 4095 or mask_v == 65535 or mask_v == 4294967295 do
                        vreg = resolve_or_imm_reg(cb, var_opnd, assigned_phys, SCR)
                        if rd >= 0 and vreg >= 0 do
                            cb = arm64_and_mask(cb, rd as int, vreg as int, mask_v)
                            is_mask_imm = 1
                        end
                    end
                    if is_mask_imm == 0 do
                        a = resolve_or_imm_reg(cb, ins_src1, assigned_phys, SCR)
                        breg = resolve_or_imm_reg(cb, ins_src2, assigned_phys, SCR2)
                        if rd >= 0 and a >= 0 and breg >= 0 do
                            cb = arm64_and_rrr(cb, rd as int, a as int, breg as int)
                        end
                    end
                end
                if rd >= 0 and rd < 32 do
                    vec_set_rt(reg_const_val, rd, 0 - 1)
                    is_32bit_and = 0
                    if mask_v == 4294967295 or mask_v == 0xFFFFFFFF do
                        is_32bit_and = 1
                    end
                    if is_32bit_and == 0 and rs2 >= 0 and rs2 < 32 do
                        if vec_get_rt(reg_const_val, rs2) == 4294967295 or vec_get_rt(reg_const_val, rs2) == 0xFFFFFFFF do
                            is_32bit_and = 1
                        end
                    end
                    if is_32bit_and == 1 and rs1 >= 0 and rs1 < 32 do
                        vec_set_rt(reg_shl_src, rd, vec_get_rt(reg_shl_src, rs1))
                        vec_set_rt(reg_shl_amt, rd, vec_get_rt(reg_shl_amt, rs1))
                        vec_set_rt(reg_shr_src, rd, vec_get_rt(reg_shr_src, rs1))
                        vec_set_rt(reg_shr_amt, rd, vec_get_rt(reg_shr_amt, rs1))
                    else
                        vec_set_rt(reg_shl_src, rd, 0 - 1)
                        vec_set_rt(reg_shr_src, rd, 0 - 1)
                    end
                end
                last_cmp_pred = 0 - 1
            eif op == LirOp.Or do
                a = resolve_or_imm_reg(cb, ins_src1, assigned_phys, SCR)
                breg = resolve_or_imm_reg(cb, ins_src2, assigned_phys, SCR2)
                is_ror = 0
                if a >= 0 and a < 32 and breg >= 0 and breg < 32 and rd >= 0 do
                    shl_src_a = vec_get_rt(reg_shl_src, a)
                    shr_src_b = vec_get_rt(reg_shr_src, breg)
                    shl_amt_a = vec_get_rt(reg_shl_amt, a)
                    shr_amt_b = vec_get_rt(reg_shr_amt, breg)
                    if shl_src_a >= 0 and shl_src_a == shr_src_b and (shl_amt_a + shr_amt_b == 32) do
                        shift = 32 - shl_amt_a
                        cb = arm64_ror_imm32(cb, rd as int, shl_src_a as int, shift as int)
                        is_ror = 1
                    else
                        shr_src_a = vec_get_rt(reg_shr_src, a)
                        shl_src_b = vec_get_rt(reg_shl_src, breg)
                        shr_amt_a = vec_get_rt(reg_shr_amt, a)
                        shl_amt_b = vec_get_rt(reg_shl_amt, breg)
                        if shr_src_a >= 0 and shr_src_a == shl_src_b and (shr_amt_a + shl_amt_b == 32) do
                            shift = 32 - shl_amt_b
                            cb = arm64_ror_imm32(cb, rd as int, shr_src_a as int, shift as int)
                            is_ror = 1
                        end
                    end
                end
                if is_ror == 0 do
                    if rd >= 0 and a >= 0 and breg >= 0 do
                        cb = arm64_orr_rrr(cb, rd as int, a as int, breg as int)
                    end
                end
                if rd >= 0 and rd < 32 do
                    vec_set_rt(reg_const_val, rd, 0 - 1)
                    vec_set_rt(reg_shl_src, rd, 0 - 1)
                    vec_set_rt(reg_shr_src, rd, 0 - 1)
                end
                last_cmp_pred = 0 - 1
            eif op == LirOp.Xor do
                a = resolve_or_imm_reg(cb, ins_src1, assigned_phys, SCR)
                breg = resolve_or_imm_reg(cb, ins_src2, assigned_phys, SCR2)
                is_eor_lsr = 0
                if rd >= 0 and a >= 0 and breg >= 0 and breg < 32 do
                    shr_src_b = vec_get_rt(reg_shr_src, breg)
                    shr_amt_b = vec_get_rt(reg_shr_amt, breg)
                    if shr_src_b >= 0 and shr_amt_b > 0 and shr_amt_b < 64 do
                        cb = arm64_eor_lsr64(cb, rd as int, a as int, shr_src_b as int, shr_amt_b as int)
                        is_eor_lsr = 1
                    end
                end
                if is_eor_lsr == 0 do
                    if rd >= 0 and a >= 0 and breg >= 0 do
                        cb = arm64_eor_rrr(cb, rd as int, a as int, breg as int)
                    end
                end
                if rd >= 0 and rd < 32 do
                    vec_set_rt(reg_const_val, rd, 0 - 1)
                    vec_set_rt(reg_shl_src, rd, 0 - 1)
                    vec_set_rt(reg_shr_src, rd, 0 - 1)
                end
                last_cmp_pred = 0 - 1
            eif op == LirOp.Shl do
                a = resolve_or_imm_reg(cb, ins_src1, assigned_phys, SCR)
                shl_k = 0 - 1
                if (ins_src2 as i64) != 0 do
                    s2_typ = native_read_i64(ins_src2 as i64, 0)
                    if s2_typ == 4 or s2_typ == 5 do
                        shl_k = native_read_i64(ins_src2 as i64, 32)
                    end
                end
                if shl_k < 0 and rs2 >= 0 and rs2 < 32 do
                    shl_k = vec_get_rt(reg_const_val, rs2)
                end
                breg = resolve_or_imm_reg(cb, ins_src2, assigned_phys, SCR2)
                if rd >= 0 and a >= 0 and breg >= 0 do
                    cb = arm64_lsl_rrr(cb, rd as int, a as int, breg as int)
                end
                if rd >= 0 and rd < 32 do
                    vec_set_rt(reg_const_val, rd, 0 - 1)
                    if a >= 0 and shl_k > 0 and shl_k < 32 do
                        vec_set_rt(reg_shl_src, rd, a)
                        vec_set_rt(reg_shl_amt, rd, shl_k)
                    else
                        vec_set_rt(reg_shl_src, rd, 0 - 1)
                    end
                    vec_set_rt(reg_shr_src, rd, 0 - 1)
                end
                last_cmp_pred = 0 - 1
            eif op == LirOp.Shr do
                a = resolve_or_imm_reg(cb, ins_src1, assigned_phys, SCR)
                shr_m = 0 - 1
                if (ins_src2 as i64) != 0 do
                    s2_typ = native_read_i64(ins_src2 as i64, 0)
                    if s2_typ == 4 or s2_typ == 5 do
                        shr_m = native_read_i64(ins_src2 as i64, 32)
                    end
                end
                if shr_m < 0 and rs2 >= 0 and rs2 < 32 do
                    shr_m = vec_get_rt(reg_const_val, rs2)
                end
                breg = resolve_or_imm_reg(cb, ins_src2, assigned_phys, SCR2)
                if rd >= 0 and a >= 0 and breg >= 0 do
                    cb = arm64_lsr_rrr(cb, rd as int, a as int, breg as int)
                end
                if rd >= 0 and rd < 32 do
                    vec_set_rt(reg_const_val, rd, 0 - 1)
                    if a >= 0 and shr_m > 0 and shr_m < 32 do
                        vec_set_rt(reg_shr_src, rd, a)
                        vec_set_rt(reg_shr_amt, rd, shr_m)
                    else
                        vec_set_rt(reg_shr_src, rd, 0 - 1)
                    end
                    vec_set_rt(reg_shl_src, rd, 0 - 1)
                end
                last_cmp_pred = 0 - 1
            eif op == LirOp.Not do
                a = resolve_or_imm_reg(cb, ins_src1, assigned_phys, SCR)
                if rd >= 0 and a >= 0 do
                    cb = arm64_mvn_rr(cb, rd as int, a as int)
                end
                if rd >= 0 and rd < 32 do
                    vec_set_rt(reg_const_val, rd, 0 - 1)
                end
                last_cmp_pred = 0 - 1
            eif op == LirOp.Pow do
                cb = emit_bl_fixup(cb, call_fixups, 1, LIR_RT_POW, rd)
                last_cmp_pred = 0 - 1
            eif op == LirOp.MatMul do
                cb = emit_bl_fixup(cb, call_fixups, 1, LIR_RT_MATMUL, rd)
                last_cmp_pred = 0 - 1
            eif op == LirOp.Fma do
                cb = emit_bl_fixup(cb, call_fixups, 1, LIR_RT_FMA, rd)
                last_cmp_pred = 0 - 1
            # TCO: self-recursive tail-call — emit B <func_entry> instead of BL+RET.
            # Arguments must already be in X0..X7 via preceding SetArg instructions.
            # We restore the frame before branching so the callee sees a clean state.
            eif op == LirOp.TailCall do
                # Restore stack pointer to pre-prologue state
                if stack_size > 0 and stack_size <= 4095 do
                    cb = arm64_add_imm(cb, 31, 31, stack_size as int)
                end
                cb = emit_callee_restore(cb, max_phys)
                # Restore FP/LR that were saved in prologue
                cb = arm64_ldp_post(cb, 29, 30, 31, 16)
                # Re-enter the function at its first instruction (after prologue saves).
                # This is a guaranteed backward branch so offset is negative.
                at_tco = codebuf_offset(cb) as i64
                cb = arm64_stp_pre(cb, 29, 30, 31, 0 - 16)
                cb = arm64_mov_from_sp(cb, 29)
                cb = emit_callee_save(cb, max_phys)
                if stack_size > 0 and stack_size <= 4095 do
                    cb = arm64_sub_imm(cb, 31, 31, stack_size as int)
                end
                # Branch back to body start (first block after prologue), using a fixup.
                at_jmp = codebuf_offset(cb) as i64
                cb = arm64_b_imm26(cb, 0)
                fixups = vec_push_rt(fixups, lir_fixup_new(at_jmp, 0, 0))
                last_cmp_pred = 0 - 1
            eif op == LirOp.Cmp do
                a = resolve_or_imm_reg(cb, ins_src1, assigned_phys, SCR)
                is_imm_cmp = 0
                imm_v = 0 - 1
                if (ins_src2 as i64) != 0 do
                    s2_typ = native_read_i64(ins_src2 as i64, 0)
                    if s2_typ == 4 or s2_typ == 5 do
                        imm_v = native_read_i64(ins_src2 as i64, 32)
                    end
                end
                if imm_v < 0 and rs2 >= 0 and rs2 < 32 do
                    imm_v = vec_get_rt(reg_const_val, rs2)
                end
                if imm_v >= 0 and imm_v <= 4095 and a >= 0 do
                    cb = arm64_cmp_imm(cb, a as int, imm_v as int)
                    is_imm_cmp = 1
                end
                if is_imm_cmp == 0 do
                    b_val = resolve_or_imm_reg(cb, ins_src2, assigned_phys, 10)
                    if a >= 0 and b_val >= 0 do
                        cb = arm64_cmp_rr(cb, a as int, b_val as int)
                    end
                end
                is_fused = 0
                if (ii + 1) < n_instrs do
                    next_ins = vec_get_rt(instrs, ii + 1)
                    if native_read_i64(next_ins as i64, 0) == (LirOp.JmpCond as i64) do
                        next_src1 = native_read_i64(next_ins as i64, 24)
                        if lir_opnd_matches(ins_dst, next_src1) == 1 do
                            is_fused = 1
                            last_cmp_pred = ins_aux
                            last_cmp_dst = ins_dst
                        end
                    end
                end
                if is_fused == 0 do
                    last_cmp_pred = 0 - 1
                    if rd >= 0 do
                        if ins_aux == LIR_CMP_EQ do
                            cb = arm64_cset_eq(cb, rd as int)
                        eif ins_aux == LIR_CMP_NE do
                            cb = arm64_cset_ne(cb, rd as int)
                        eif ins_aux == LIR_CMP_GT do
                            cb = arm64_cset_gt(cb, rd as int)
                        eif ins_aux == LIR_CMP_LT do
                            cb = arm64_cset_lt(cb, rd as int)
                        eif ins_aux == LIR_CMP_GE do
                            cb = arm64_cset_ge(cb, rd as int)
                        eif ins_aux == LIR_CMP_LE do
                            cb = arm64_cset_le(cb, rd as int)
                        end
                    end
                end
                if rd >= 0 and rd < 32 do
                    vec_set_rt(reg_const_val, rd, 0 - 1)
                end
            eif op == LirOp.Load do
                if rd >= 0 and rs1 >= 0 do
                    cb = codebuf_emit_u32(cb, 0xF9400000 bit_or ((rs1 as int bit_and 0x1F) shl 5) bit_or (rd as int bit_and 0x1F))
                end
                if rd >= 0 and rd < 32 do
                    vec_set_rt(reg_const_val, rd, 0 - 1)
                end
                last_cmp_pred = 0 - 1
            eif op == LirOp.Store do
                if rs1 >= 0 and rs2 >= 0 do
                    cb = codebuf_emit_u32(cb, 0xF9000000 bit_or ((rs2 as int bit_and 0x1F) shl 5) bit_or (rs1 as int bit_and 0x1F))
                end
                last_cmp_pred = 0 - 1
            eif op == LirOp.Push do
                rval = resolve_or_imm_reg(cb, ins_src1, assigned_phys, SCR)
                if rval >= 0 do
                    cb = arm64_str_pre(cb, rval as int, 31, 0 - 16)
                end
                last_cmp_pred = 0 - 1
            eif op == LirOp.SetArg do
                ai = native_read_i64(ins as i64, 40)
                s1_arg = native_read_i64(ins as i64, 24)
                if (s1_arg as i64) != 0 do
                    if native_read_i64(s1_arg as i64, 0) == 4 do
                        ai = native_read_i64(s1_arg as i64, 32)
                    end
                end
                s2_arg = native_read_i64(ins as i64, 32)
                if ai >= 0 and ai < 4 do
                    vec_set_rt(recent_setargs, ai, s2_arg)
                end
                if is_inlined_builtin_arg(instrs, ii, n_instrs) == 0 do
                    pending_stk = emit_lir_setarg(cb, ins, assigned_phys, pending_stk)
                end
                last_cmp_pred = 0 - 1
            eif op == LirOp.Pop do
                if rd >= 0 do
                    cb = arm64_ldr_post(cb, rd as int, 31, 16)
                end
                last_cmp_pred = 0 - 1
            eif op == LirOp.Call do
                pending_stk = emit_lir_call(cb, ins, rd, func_obj, lir_funcs, call_fixups, pending_stk)
                last_cmp_pred = 0 - 1
            eif op == LirOp.Intrinsic do
                cb = emit_lir_intrinsic(cb, ins, rd, rs1, assigned_phys, call_fixups, func_obj, str_fixups, recent_setargs)
                last_cmp_pred = 0 - 1
            eif op == LirOp.Jmp do
                tgt = 0 - 1
                if (ins_src1 as i64) != 0 do
                    src1_typ = native_read_i64(ins_src1 as i64, 0)
                    if src1_typ == 5 do
                        tgt = native_read_i64(ins_src1 as i64, 40)
                    eif src1_typ == 4 do
                        tgt = native_read_i64(ins_src1 as i64, 32)
                    end
                end
                if tgt >= 0 do
                    next_bid = 0 - 1
                    if bi + 1 < n_blocks do
                        next_b = vec_get_rt(f_blocks, bi + 1)
                        next_bid = native_read_i64(next_b as i64, 0)
                    end
                    if tgt != next_bid do
                        at = codebuf_offset(cb) as i64
                        cb = arm64_b_imm26(cb, 0)
                        fixups = vec_push_rt(fixups, lir_fixup_new(at, tgt, 0))
                    end
                end
                last_cmp_pred = 0 - 1
            eif op == LirOp.JmpCond do
                tgt = 0 - 1
                if (ins_src2 as i64) != 0 do
                    src2_typ = native_read_i64(ins_src2 as i64, 0)
                    if src2_typ == 5 do
                        tgt = native_read_i64(ins_src2 as i64, 40)
                    eif src2_typ == 4 do
                        tgt = native_read_i64(ins_src2 as i64, 32)
                    end
                end
                if last_cmp_pred >= 0 and lir_opnd_matches(last_cmp_dst, ins_src1) == 1 do
                    # Fused Cmp + JmpCond: flags already in NZCV, branch directly to condition!
                    if tgt >= 0 do
                        at = codebuf_offset(cb) as i64
                        is_ifnot = 0
                        if ins_aux == LIR_JMP_IFNOT do
                            is_ifnot = 1
                        end
                        cond = arm64_cond_code(last_cmp_pred, is_ifnot)
                        cb = codebuf_emit_u32(cb, 0x54000000)
                        fixups = vec_push_rt(fixups, lir_fixup_new(at, tgt, 10 + cond))
                    end
                    last_cmp_pred = 0 - 1
                else
                    a = resolve_or_imm_reg(cb, ins_src1, assigned_phys, SCR)
                    if a >= 0 do
                        cb = codebuf_emit_u32(cb, 0xF100001F bit_or ((a as int bit_and 0x1F) shl 5))
                    end
                    if tgt >= 0 do
                        at = codebuf_offset(cb) as i64
                        kind = 2
                        if ins_aux == LIR_JMP_IFNOT do
                            kind = 1
                        end
                        if kind == 1 do
                            cb = arm64_beq_imm19(cb, 0)
                        else
                            cb = arm64_bne_imm19(cb, 0)
                        end
                        fixups = vec_push_rt(fixups, lir_fixup_new(at, tgt, kind))
                    end
                    last_cmp_pred = 0 - 1
                end
            eif op == LirOp.Ret do
                if (ins_src1 as i64) != 0 do
                    src1_typ = native_read_i64(ins_src1 as i64, 0)
                    if src1_typ == 4 do
                        imm_val = native_read_i64(ins_src1 as i64, 32)
                        cb = arm64_movz_imm64(cb, 0, imm_val as int)
                    eif rs1 >= 0 and rs1 != 0 do
                        cb = arm64_mov_rr(cb, 0, rs1 as int)
                    end
                eif rs1 >= 0 and rs1 != 0 do
                    cb = arm64_mov_rr(cb, 0, rs1 as int)
                end
                if stack_size > 0 and stack_size <= 4095 do
                    cb = arm64_add_imm(cb, 31, 31, stack_size as int)
                end
                cb = emit_callee_restore(cb, max_phys)
                cb = arm64_ldp_post(cb, 29, 30, 31, 16)
                cb = arm64_ret(cb)
                last_cmp_pred = 0 - 1
            end
            if rd_spill < 0 do
                cb = emit_spill_store(cb, ins_dst, SCRD)
            end
            ii = ii + 1
        end
        bi = bi + 1
    end

    # Fall-through epilogue (when function has no explicit Ret)
    cb = arm64_mov_imm16(cb, 0, 0)
    if stack_size > 0 and stack_size <= 4095 do
        cb = arm64_add_imm(cb, 31, 31, stack_size as int)
    end
    cb = emit_callee_restore(cb, max_phys)
    cb = arm64_ldp_post(cb, 29, 30, 31, 16)
    cb = arm64_ret(cb)

    nf = vec_len_rt(fixups)
    var fxi = 0
    when fxi < nf loop
        fx = vec_get_rt(fixups, fxi)
        f_tgt = lir_fixup_target_block(fx)
        f_kind = lir_fixup_kind(fx)
        f_at = lir_fixup_at_off(fx)
        if f_tgt >= 0 and f_tgt < max_bid do
            dest = vec_get_rt(block_off, f_tgt)
            if dest >= 0 do
                rel = (dest - f_at) as int
                if f_kind == 0 do
                    imm26 = (rel shr 2) bit_and 0x03FFFFFF
                    word = 0x14000000 bit_or imm26
                    cb = codebuf_patch_u32(cb, f_at as int, word)
                eif f_kind == 1 do
                    imm19 = (rel shr 2) bit_and 0x7FFFF
                    word = 0x54000000 bit_or (imm19 shl 5)
                    cb = codebuf_patch_u32(cb, f_at as int, word)
                eif f_kind == 2 do
                    imm19 = (rel shr 2) bit_and 0x7FFFF
                    word = 0x54000001 bit_or (imm19 shl 5)
                    cb = codebuf_patch_u32(cb, f_at as int, word)
                eif f_kind >= 10 do
                    cond = (f_kind - 10) bit_and 0xF
                    imm19 = (rel shr 2) bit_and 0x7FFFF
                    word = 0x54000000 bit_or (imm19 shl 5) bit_or cond
                    cb = codebuf_patch_u32(cb, f_at as int, word)
                end
            end
        end
        fxi = fxi + 1
    end

    out cb
end.

func emit_lir_module_arm64(lir_funcs: i64, is_linux: i64):
    cb = codebuf_new(TargetArch.ARM64)
    n_funcs = vec_len_rt(lir_funcs)
    func_offs = vec_new_cap_rt(1024)
    call_fixups = vec_new_cap_rt(1024)
    str_fixups = vec_new_cap_rt(1024)

    var fi = 0
    when fi < n_funcs loop
        func_offs = vec_push_rt(func_offs, codebuf_offset(cb) as i64)
        lf = vec_get_rt(lir_funcs, fi)
        cb = emit_lir_arm64_into(cb, lf, 0 - 1, lir_funcs, call_fixups, str_fixups)
        fi = fi + 1
    end

    rt_offs = vec_new_cap_rt(1024)
    cb = emit_lir_rt_stubs(cb, rt_offs, is_linux)

    nf = vec_len_rt(call_fixups)
    var ci = 0
    when ci < nf loop
        fx = vec_get_rt(call_fixups, ci)
        f_tkind = native_read_i64(fx as i64, 8)
        f_tid = native_read_i64(fx as i64, 16)
        f_at = native_read_i64(fx as i64, 0)
        dest = 0 - 1
        if f_tkind == 0 do
            if f_tid >= 0 and f_tid < n_funcs do
                dest = vec_get_rt(func_offs, f_tid)
            end
        else
            if f_tid >= 0 and f_tid < LIR_RT_STUB_COUNT do
                dest = vec_get_rt(rt_offs, f_tid)
            end
        end
        if dest < 0 do
            dest = vec_get_rt(rt_offs, LIR_RT_UNRESOLVED)
        end
        cb = patch_bl_site(cb, f_at, dest)
        ci = ci + 1
    end

    cb.start_offset = codebuf_offset(cb)
    if is_linux == 1 do
        # ── Linux ARM64 ELF Entry: [SP] = argc, SP + 8 = argv ──
        cb = arm64_ldr_uoff(cb, 19, 31, 0)   # X19 = argc
        cb = arm64_add_imm(cb, 20, 31, 8)    # X20 = argv
        cb = arm64_stp_pre(cb, 29, 30, 31, 0 - 16)
        cb = arm64_mov_from_sp(cb, 29)

        # ── Initialize 256MB Global Arena Heap via Linux mmap ──
        cb = arm64_mov_imm16(cb, 0, 0)
        cb = arm64_mov_imm16(cb, 1, 0)
        cb = codebuf_emit_u32(cb, 0xF2A20001) # MOVK X1, #0x1000, LSL #16 (256MB)
        cb = arm64_mov_imm16(cb, 2, 3)         # PROT_READ | PROT_WRITE
        cb = arm64_mov_imm16(cb, 3, 34)        # MAP_PRIVATE | MAP_ANONYMOUS (0x22)
        cb = codebuf_emit_u32(cb, 0x92800004) # MOVN X4, #0 (-1 fd)
        cb = arm64_mov_imm16(cb, 5, 0)
        cb = arm64_mov_imm16(cb, 8, 222)       # X8 = 222 (SYS_mmap)
        cb = arm64_svc(cb, 0)                  # SVC #0
    else
        # ── macOS Mach-O Entry: dyld passes X0 = argc, X1 = argv ──
        cb = arm64_mov_rr(cb, 19, 0)     # X19 = argc
        cb = arm64_mov_rr(cb, 20, 1)     # X20 = argv

        cb = arm64_stp_pre(cb, 29, 30, 31, 0 - 16)
        cb = arm64_mov_from_sp(cb, 29)

        # ── Initialize 256MB Global Arena Heap via macOS mmap ──
        cb = arm64_mov_imm16(cb, 0, 0)
        cb = arm64_mov_imm16(cb, 1, 0)
        cb = codebuf_emit_u32(cb, 0xF2A20001) # MOVK X1, #0x1000, LSL #16 (256MB)
        cb = arm64_mov_imm16(cb, 2, 3)         # PROT_READ | PROT_WRITE
        cb = arm64_mov_imm16(cb, 3, 4098)      # MAP_ANON | MAP_PRIVATE (0x1002)
        cb = codebuf_emit_u32(cb, 0x92800004) # MOVN X4, #0 (-1 fd)
        cb = arm64_mov_imm16(cb, 5, 0)
        cb = arm64_mov_imm16(cb, 16, 197)     # SYS_mmap
        cb = codebuf_emit_u32(cb, 0xF2A04010) # MOVK X16, #0x200, LSL #16
        cb = arm64_svc(cb, 0x80)
    end

    # X28 = heap base returned in X0
    cb = arm64_mov_rr(cb, 28, 0)
    # Initialize bump pointer: *(X28) = X28 + 32
    cb = arm64_add_imm(cb, 1, 28, 32)
    cb = arm64_str_uoff(cb, 1, 28, 0)
    # Save argc and argv in heap header:
    cb = arm64_str_uoff(cb, 19, 28, 8)     # *(X28 + 8) = argc
    cb = arm64_str_uoff(cb, 20, 28, 16)    # *(X28 + 16) = argv
    if n_funcs > 0 do
        main_idx = lir_find_func_index(lir_funcs, fat_str_new("main"))
        if main_idx < 0 do
            main_idx = 0
        end
        at = codebuf_offset(cb) as i64
        cb = arm64_bl_imm26(cb, 0)
        main_off = vec_get_rt(func_offs, main_idx)
        cb = patch_bl_site(cb, at, main_off)
    end
    cb = arm64_mov_imm16(cb, 0, 0)
    if is_linux == 1 do
        cb = arm64_mov_imm16(cb, 8, 93)        # X8 = 93 (SYS_exit on Linux)
        cb = arm64_svc(cb, 0)
    else
        cb = arm64_mov_imm16(cb, 16, 1)        # SYS_exit on macOS
        cb = codebuf_emit_u32(cb, 0xF2A04010)
        cb = arm64_svc(cb, 0x80)
    end
    cb = arm64_ldp_post(cb, 29, 30, 31, 16)
    cb = arm64_ret(cb)

    # ── String Literal Pool & Patch ADR Sites ──
    n_sfx = vec_len_rt(str_fixups)
    if n_sfx > 0 do
        pool_offsets = vec_new_cap_rt(n_sfx)
        var sfi = 0
        when sfi < n_sfx loop
            sfx = vec_get_rt(str_fixups, sfi)
            s_val = native_read_i64(sfx as i64, 8) as string
            s_data = native_read_i64(s_val as i64, 0)
            s_len = native_read_i64(s_val as i64, 8)
            found_off = 0 - 1
            var pfi = 0
            when pfi < sfi loop
                prev_sfx = vec_get_rt(str_fixups, pfi)
                prev_s_val = native_read_i64(prev_sfx as i64, 8) as string
                if fat_str_eq(prev_s_val, s_val) == 1 do
                    found_off = vec_get_rt(pool_offsets, pfi)
                    pfi = sfi
                end
                pfi = pfi + 1
            end
            if found_off < 0 do
                found_off = codebuf_offset(cb) as i64
                var bi = 0
                when bi < s_len loop
                    b_ch = native_read_u8(s_data, bi)
                    cb = codebuf_emit_byte(cb, b_ch)
                    bi = bi + 1
                end
                cb = codebuf_emit_byte(cb, 0)
            end
            pool_offsets = vec_push_rt(pool_offsets, found_off)
            sfi = sfi + 1
        end

        pad = (4 - (codebuf_offset(cb) mod 4)) mod 4
        var pi = 0
        when pi < pad loop
            cb = codebuf_emit_byte(cb, 0)
            pi = pi + 1
        end

        sfi = 0
        when sfi < n_sfx loop
            sfx = vec_get_rt(str_fixups, sfi)
            s_at = native_read_i64(sfx as i64, 0)
            s_rd = native_read_i64(sfx as i64, 16)
            s_target = vec_get_rt(pool_offsets, sfi)
            delta = (s_target - s_at) as int
            immlo = delta bit_and 3
            immhi = (delta shr 2) bit_and 0x7FFFF
            word = 0x10000000 bit_or (immlo shl 29) bit_or (immhi shl 5) bit_or (s_rd as int bit_and 0x1F)
            cb = codebuf_patch_u32(cb, s_at as int, word)
            sfi = sfi + 1
        end
    end

    out cb
end.

# Single-func helper → module path.
func emit_lir_arm64(func_obj: LirFunc, assigned_phys: i64, assigned_stack: i64):
    funcs = vec_new_rt()
    funcs = vec_push_rt(funcs, func_obj)
    out emit_lir_module_arm64(funcs)
end.

export emit_lir_arm64, emit_lir_module_arm64, emit_lir_arm64_into
export emit_lir_intrinsic, emit_lir_setarg, emit_lir_rt_stubs
export lir_intr_is_marker, lir_intr_is_identity, lir_intr_is_payload
export lir_fixup_new, lir_fixup_at_off, lir_fixup_target_block, lir_fixup_kind
export lir_call_fixup_new, lir_stub_for_builtin_id
export patch_bl_site, lir_find_func_index
