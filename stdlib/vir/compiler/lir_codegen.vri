##
 * vir/compiler/lir_codegen.vri — LIR to Machine Code (ARM64)
 * ==============================================================
 * AAPCS64 soft ABI:
 *   SetArg 0..7 → MOV X0..X7
 *   SetArg ≥8  → push 16-byte slots; Call pops them
 *   Call       → BL patched to func offs / RT unresolved
 *   Intrinsic  → marker/payload inline; else BL → RT stub[kind]
 *   Pow/ML     → BL → RT stub[61..63]
 *
 * Module: emit_lir_module_arm64 — funcs + RT stubs + BL patch + _start.
 ##

include types
include vec_rt
import vec_new_rt, vec_push_rt, vec_get_rt, vec_set_rt, vec_len_rt from vec_rt
include string_rt
import rt_streq, fat_str_eq, fat_str_new, sb_new, sb_append, sb_append_int, sb_to_string, sb_free, native_read_i64, native_write_i64, native_read_u8 from string_rt
include compiler.context
import print_str, print_int from compiler.context
include compiler.lir
import LirOp, LirOperandType, LirOperand, LirInstr, LirBlock, LirFunc, lir_func_id, lir_func_name, lir_func_blocks, lir_func_stack_size, lir_func_strings, lir_block_id, lir_block_instrs, lir_instr_op, lir_instr_dst, lir_instr_src1, lir_instr_src2, lir_instr_aux, lir_instr_typ, lir_opnd_type, lir_opnd_vreg, lir_opnd_imm_val, lir_opnd_label_id, lir_opnd_phys_reg_val, lir_opnd_stack_offset, LIR_CMP_EQ, LIR_CMP_NE, LIR_CMP_GT, LIR_CMP_LT, LIR_CMP_GE, LIR_CMP_LE, LIR_JMP_IF, LIR_JMP_IFNOT, LIR_RT_UNRESOLVED, LIR_RT_POW, LIR_RT_MATMUL, LIR_RT_FMA, LIR_RT_ALLOC, LIR_RT_PRINT_STR, LIR_RT_GET_ARG, LIR_RT_ARG_COUNT, LIR_RT_NATIVE_READ_U8, LIR_RT_NATIVE_WRITE_U8, LIR_RT_NATIVE_READ_I64, LIR_RT_NATIVE_WRITE_I64, LIR_RT_VOLATILE_READ, LIR_RT_VOLATILE_WRITE, LIR_RT_VOLATILE_READ8, LIR_RT_VOLATILE_WRITE8, LIR_RT_DMB, LIR_RT_DSB, LIR_RT_ISB, LIR_RT_WFI, LIR_RT_WFE, LIR_RT_SEV, LIR_RT_NOP, LIR_RT_STUB_COUNT from compiler.lir
include compiler.mir
import MIR_INTR_PRINT, MIR_INTR_PRINT_STR, MIR_INTR_PARAM, MIR_INTR_ADDR_OF, MIR_INTR_CAST, MIR_INTR_NOP_MARKER, MIR_INTR_DECL, MIR_INTR_QUIET, MIR_INTR_CHECK_CPU, MIR_INTR_PATCH_POINT, MIR_INTR_PRECOMP, MIR_INTR_EXPOSE, MIR_INTR_ASYNC, MIR_INTR_ATOMIC_VAR, MIR_INTR_TIMEOUT, MIR_INTR_ISOLATE, MIR_INTR_PTR, MIR_INTR_AWAIT_PASS, MIR_INTR_ENSURE, MIR_INTR_REVERT, MIR_INTR_STR_LIT, MIR_INTR_INTERP, MIR_INTR_ENUM, MIR_INTR_ERROR, MIR_INTR_EXIST, MIR_INTR_BUILTIN, MIR_INTR_INDEX, MIR_INTR_INDEX_STORE, MIR_INTR_FIELD, MIR_INTR_FIELD_STORE, MIR_INTR_ARRAY, MIR_INTR_ENTITY, MIR_INTR_TUPLE, MIR_INTR_BUNDLE, MIR_INTR_INFER, MIR_INTR_TRAIN, MIR_INTR_REACTIVE, MIR_INTR_MORPH, MIR_INTR_QUANTIZE from compiler.mir
include compiler.codegen
import codebuf_new, codebuf_emit_u32, codebuf_emit_byte, codebuf_offset, codebuf_patch_u32, TargetArch, CodeBuf from compiler.codegen
import arm64_add_rrr, arm64_sub_rrr, arm64_mul_rrr, arm64_sdiv_rrr, arm64_madd_rrrr, arm64_msub_rrrr, arm64_mov_rr, arm64_movz_imm64, arm64_mov_from_sp, arm64_ldr_post, arm64_str_pre, arm64_ret, arm64_nop, arm64_cmp_rr, arm64_cset_eq, arm64_cset_ne, arm64_cset_gt, arm64_cset_lt, arm64_cset_ge, arm64_cset_le, arm64_b_imm26, arm64_beq_imm19, arm64_bne_imm19, arm64_bl_imm26, arm64_add_imm, arm64_sub_imm, arm64_and_rrr, arm64_orr_rrr, arm64_eor_rrr, arm64_lsl_rrr, arm64_lsr_rrr, arm64_lsl_imm, arm64_mvn_rr, arm64_stp_pre, arm64_ldp_post, arm64_svc, arm64_mov_imm16, arm64_str_uoff, arm64_ldr_uoff, arm64_strb_reg, arm64_ldrb_reg, arm64_strb_uoff, arm64_ldrb_uoff, arm64_cmp_imm0, arm64_ubfx, arm64_bfi, arm64_dmb_ishld, arm64_dmb_ishst, arm64_dmb_sy, arm64_dsb_sy, arm64_isb, arm64_wfi, arm64_wfe, arm64_sev, arm64_clz, arm64_rbit, arm64_rev, arm64_brk, arm64_ror_imm32, arm64_eor_lsr32, arm64_eor_lsr64 from compiler.codegen

func vec_new_cap_rt(cap: int):
    base = alloc(16 + cap * 8)
    data = base + 16
    native_write_i64(base, 0, cap as i64)
    native_write_i64(base, 8, 0)
    out data
end.

func lir_fixup_new(at_off: i64, target_block: i64, kind: i64):
    p = alloc(24)
    native_write_i64(p, 0, at_off)
    native_write_i64(p, 8, target_block)
    native_write_i64(p, 16, kind)
    out p
end.

func lir_fixup_at_off(fx: LirFixup): out native_read_i64(fx as i64, 0) end.
func lir_fixup_target_block(fx: LirFixup): out native_read_i64(fx as i64, 8) end.
func lir_fixup_kind(fx: LirFixup): out native_read_i64(fx as i64, 16) end.

func lir_call_fixup_new(at_off: i64, target_kind: i64, target_id: i64):
    p = alloc(24)
    native_write_i64(p, 0, at_off)
    native_write_i64(p, 8, target_kind)
    native_write_i64(p, 16, target_id)
    out p
end.

func lir_str_fixup_new(at_off: i64, str_val: i64, rd: i64):
    p = alloc(24)
    native_write_i64(p, 0, at_off)
    native_write_i64(p, 8, str_val)
    native_write_i64(p, 16, rd)
    out p
end.

func resolve_reg(opnd: LirOperand, assigned_phys: i64):
    if (opnd as i64) == 0 do
        out 0 - 1
    end
    typ = native_read_i64(opnd as i64, 0)
    if typ == 1 do
        if assigned_phys >= 0 do
            out vec_get_rt(assigned_phys, native_read_i64(opnd as i64, 8))
        end
        out native_read_i64(opnd as i64, 8)
    end
    if typ == 2 do
        out native_read_i64(opnd as i64, 16)
    end
    out 0 - 1
end.

func resolve_or_imm_reg(cb: CodeBuf, opnd: LirOperand, assigned_phys: i64, scratch: i64):
    if (opnd as i64) == 0 do
        out scratch
    end
    r = resolve_reg(opnd, assigned_phys)
    if r >= 0 do
        out r
    end
    typ = native_read_i64(opnd as i64, 0)
    if typ == 4 do
        imm_val = native_read_i64(opnd as i64, 32)
        arm64_movz_imm64(cb, scratch as int, imm_val as int)
        out scratch
    end
    if typ == 3 do
        off = native_read_i64(opnd as i64, 24)
        if off < 0 and off >= 0 - 255 do
            arm64_ldur(cb, scratch as int, 29, off as int)
            out scratch
        else
            if off < 0 do
                arm64_sub_imm(cb, scratch as int, 29, (0 - off) as int)
                arm64_ldr_uoff(cb, scratch as int, scratch as int, 0)
                out scratch
            end
        end
    end
    out scratch
end.

func lir_opnd_spill_off(opnd: i64):
    # Returns the negative stack offset if `opnd` is a StackMem slot, else 0.
    if opnd == 0 do
        out 0
    end
    if native_read_i64(opnd, 0) == 3 do
        out native_read_i64(opnd, 24)
    end
    out 0
end.

func robust_src_reg(cb: CodeBuf, opnd: i64, assigned_phys: i64, scratch: i64):
    # Like resolve_reg, but transparently reloads a spilled (StackMem) source
    # into `scratch` so every consumer sees a real register.
    if opnd == 0 do
        out 0 - 1
    end
    r = resolve_reg(opnd as LirOperand, assigned_phys)
    if r >= 0 do
        out r
    end
    if native_read_i64(opnd, 0) == 3 do
        out resolve_or_imm_reg(cb, opnd as LirOperand, assigned_phys, scratch)
    end
    out r
end.

func lir_load_opnd_to_reg(cb: CodeBuf, opnd: i64, assigned_phys: i64, scratch: i64):
    if opnd == 0 do
        out (cb, scratch)
    end
    typ = native_read_i64(opnd, 0)
    if typ == 4 do
        cb = arm64_movz_imm64(cb, scratch as int, native_read_i64(opnd, 32) as int)
        out (cb, scratch)
    end
    if typ == 3 do
        off = native_read_i64(opnd, 24)
        if off < 0 and off >= 0 - 255 do
            cb = arm64_ldur(cb, scratch as int, 29, off as int)
        else
            if off < 0 do
                cb = arm64_sub_imm(cb, scratch as int, 29, (0 - off) as int)
                cb = arm64_ldr_uoff(cb, scratch as int, scratch as int, 0)
            end
        end
        out (cb, scratch)
    end
    r = resolve_reg(opnd as LirOperand, assigned_phys)
    if r >= 0 do
        out (cb, r)
    end
    out (cb, scratch)
end.

func emit_spill_store(cb: CodeBuf, opnd: i64, src_reg: i64):
    off = lir_opnd_spill_off(opnd)
    if off < 0 and off >= 0 - 255 do
        cb = arm64_stur(cb, src_reg as int, 29, off as int)
    else
        if off < 0 do
            cb = arm64_sub_imm(cb, 13, 29, (0 - off) as int)
            cb = arm64_str_uoff(cb, src_reg as int, 13, 0)
        end
    end
    out cb
end.

func emit_cmp_cset(cb: CodeBuf, rd: i64, rs1: i64, rs2: i64, pred: i64):
    cb = arm64_cmp_rr(cb, rs1 as int, rs2 as int)
    if pred == LIR_CMP_EQ do
        out arm64_cset_eq(cb, rd as int)
    eif pred == LIR_CMP_NE do
        out arm64_cset_ne(cb, rd as int)
    eif pred == LIR_CMP_GT do
        out arm64_cset_gt(cb, rd as int)
    eif pred == LIR_CMP_LT do
        out arm64_cset_lt(cb, rd as int)
    eif pred == LIR_CMP_GE do
        out arm64_cset_ge(cb, rd as int)
    eif pred == LIR_CMP_LE do
        out arm64_cset_le(cb, rd as int)
    end
    out arm64_cset_eq(cb, rd as int)
end.

func arm64_cond_code(pred: i64, is_ifnot: i64):
    if is_ifnot == 0 do
        if pred == LIR_CMP_EQ do out 0 end    # EQ (0x0)
        if pred == LIR_CMP_NE do out 1 end    # NE (0x1)
        if pred == LIR_CMP_GE do out 10 end   # GE (0xA)
        if pred == LIR_CMP_LT do out 11 end   # LT (0xB)
        if pred == LIR_CMP_GT do out 12 end   # GT (0xC)
        if pred == LIR_CMP_LE do out 13 end   # LE (0xD)
        out 0
    end
    # Inverted condition (IFNOT)
    if pred == LIR_CMP_EQ do out 1 end        # NE (0x1)
    if pred == LIR_CMP_NE do out 0 end        # EQ (0x0)
    if pred == LIR_CMP_GE do out 11 end       # LT (0xB)
    if pred == LIR_CMP_LT do out 10 end       # GE (0xA)
    if pred == LIR_CMP_GT do out 13 end       # LE (0xD)
    if pred == LIR_CMP_LE do out 12 end       # GT (0xC)
    out 1
end.

func lir_opnd_matches(o1: i64, o2: i64):
    if o1 == 0 or o2 == 0 do out 0 end
    t1 = native_read_i64(o1, 0)
    t2 = native_read_i64(o2, 0)
    if t1 != t2 do out 0 end
    if t1 == 1 do
        v1 = native_read_i64(o1, 8)
        v2 = native_read_i64(o2, 8)
        if v1 == v2 do out 1 end
    end
    if t1 == 2 do
        v1 = native_read_i64(o1, 16)
        v2 = native_read_i64(o2, 16)
        if v1 == v2 do out 1 end
    end
    out 0
end.

func arm64_and_mask(cb: CodeBuf, rd: int, rn: int, mask: i64):
    if mask == 255 do       # 0xFF (8-bit) -> uxtb w_rd, w_rn
        out codebuf_emit_u32(cb, 0x53001C00 bit_or ((rn bit_and 0x1F) shl 5) bit_or (rd bit_and 0x1F))
    end
    if mask == 4095 do      # 0xFFF (12-bit) -> ubfx w_rd, w_rn, #0, #12
        out codebuf_emit_u32(cb, 0x53002C00 bit_or ((rn bit_and 0x1F) shl 5) bit_or (rd bit_and 0x1F))
    end
    if mask == 65535 do     # 0xFFFF (16-bit) -> uxth w_rd, w_rn
        out codebuf_emit_u32(cb, 0x53003C00 bit_or ((rn bit_and 0x1F) shl 5) bit_or (rd bit_and 0x1F))
    end
    if mask == 4294967295 do # 0xFFFFFFFF (32-bit) -> mov w_rd, w_rn (ORR Wd, WZR, Wn)
        out codebuf_emit_u32(cb, 0x2A0003E0 bit_or ((rn bit_and 0x1F) shl 16) bit_or (rd bit_and 0x1F))
    end
    out cb
end.

func arm64_cmp_imm(cb: CodeBuf, rn: int, imm: int):
    instr = 0xF100001F bit_or ((imm bit_and 0xFFF) shl 10) bit_or ((rn bit_and 0x1F) shl 5)
    out codebuf_emit_u32(cb, instr)
end.

func is_opnd_used_later(instrs: i64, start_idx: i64, n_instrs: i64, target_opnd: i64):
    var idx = start_idx
    when idx < n_instrs loop
        ins = vec_get_rt(instrs, idx)
        s1 = native_read_i64(ins as i64, 24)
        s2 = native_read_i64(ins as i64, 32)
        if lir_opnd_matches(target_opnd, s1) == 1 or lir_opnd_matches(target_opnd, s2) == 1 do
            out 1
        end
        d = native_read_i64(ins as i64, 16)
        if lir_opnd_matches(target_opnd, d) == 1 do
            out 0
        end
        idx = idx + 1
    end
    out 0
end.

func is_inlined_imm_consumer(instrs: i64, ii: i64, n_instrs: i64, imm_dst: i64, imm_val: i64):
    if (ii + 1) >= n_instrs do
        out 0
    end
    next_ins = vec_get_rt(instrs, ii + 1)
    next_op = native_read_i64(next_ins as i64, 0)
    next_src1 = native_read_i64(next_ins as i64, 24)
    next_src2 = native_read_i64(next_ins as i64, 32)
    if (next_op == (LirOp.Add as i64) or next_op == (LirOp.Sub as i64) or next_op == (LirOp.Cmp as i64)) and imm_val >= 0 and imm_val <= 4095 do
        if lir_opnd_matches(imm_dst, next_src2) == 1 or lir_opnd_matches(imm_dst, next_src1) == 1 do
            if is_opnd_used_later(instrs, ii + 2, n_instrs, imm_dst) == 0 do
                out 1
            end
        end
    end
    if next_op == (LirOp.And as i64) and (imm_val == 255 or imm_val == 4095 or imm_val == 65535 or imm_val == 4294967295) do
        if lir_opnd_matches(imm_dst, next_src2) == 1 or lir_opnd_matches(imm_dst, next_src1) == 1 do
            if is_opnd_used_later(instrs, ii + 2, n_instrs, imm_dst) == 0 do
                out 1
            end
        end
    end
    out 0
end.

func is_inlined_builtin_arg(instrs: i64, ii: i64, n_instrs: i64):
    var k = 1
    when k <= 4 loop
        if (ii + k) < n_instrs do
            target_ins = vec_get_rt(instrs, ii + k)
            top = native_read_i64(target_ins as i64, 0)
            if top == (LirOp.Intrinsic as i64) do
                tkind = native_read_i64(target_ins as i64, 40)
                if tkind == MIR_INTR_BUILTIN do
                    tsrc1 = native_read_i64(target_ins as i64, 24)
                    if (tsrc1 as i64) != 0 do
                        tbid = native_read_i64(tsrc1 as i64, 32)
                        if tbid == 3 or tbid == 5 or tbid == 6 or tbid == 7 or tbid == 8 or tbid == 32 do
                            out 1
                        end
                    end
                end
            end
            if top != (LirOp.SetArg as i64) and top != (LirOp.Mov as i64) do
                out 0
            end
        end
        k = k + 1
    end
    out 0
end.

func lir_intr_is_marker(kind: i64):
    if kind == MIR_INTR_NOP_MARKER or kind == MIR_INTR_DECL or kind == MIR_INTR_QUIET or kind == MIR_INTR_CHECK_CPU or kind == MIR_INTR_PATCH_POINT or kind == MIR_INTR_PRECOMP or kind == MIR_INTR_EXPOSE or kind == MIR_INTR_ASYNC or kind == MIR_INTR_ATOMIC_VAR or kind == MIR_INTR_TIMEOUT or kind == MIR_INTR_ISOLATE or kind == MIR_INTR_PTR or kind == MIR_INTR_AWAIT_PASS or kind == MIR_INTR_ENSURE or kind == MIR_INTR_REVERT or kind == MIR_INTR_ENUM or kind == MIR_INTR_ERROR or kind == MIR_INTR_EXIST or kind == MIR_INTR_INFER or kind == MIR_INTR_TRAIN or kind == MIR_INTR_REACTIVE or kind == MIR_INTR_MORPH or kind == MIR_INTR_QUANTIZE or kind == MIR_INTR_TRY or kind == MIR_INTR_RESUME or kind == MIR_INTR_EMIT do
        out 1
    end
    out 0
end.

func lir_intr_is_payload(kind: i64):
    if kind == MIR_INTR_ADDR_OF or kind == MIR_INTR_CAST do
        out 1
    end
    out 0
end.

func lir_stub_for_builtin_id(bid: i64):
    if bid == 3 or bid == 35 or bid == 49 or bid == 50 do out LIR_RT_ALLOC end
    if bid == 22 do out LIR_RT_PRINT_STR end
    if bid == 9 do out LIR_RT_STR_LEN end
    if bid == 11 do out LIR_RT_STR_CAT end
    if bid == 12 do out LIR_RT_STR_EQ end
    if bid == 19 do out LIR_RT_INT_TO_STR end
    if bid == 25 do out LIR_RT_SLURP_FILE end
    if bid == 26 do out LIR_RT_SLURP_LEN end
    if bid == 27 do out LIR_RT_WRITE_BYTES end
    if bid == 5 do out LIR_RT_NATIVE_READ_U8 end
    if bid == 6 do out LIR_RT_NATIVE_WRITE_U8 end
    if bid == 7 or bid == 46 do out LIR_RT_NATIVE_READ_I64 end
    if bid == 8 or bid == 47 do out LIR_RT_NATIVE_WRITE_I64 end
    if bid == 23 do out LIR_RT_GET_ARG end
    if bid == 24 do out LIR_RT_ARG_COUNT end
    if bid == 54 or bid == 60 or bid == 62 do out LIR_RT_VOLATILE_READ end
    if bid == 55 or bid == 61 or bid == 63 do out LIR_RT_VOLATILE_WRITE end
    if bid == 56 or bid == 58 do out LIR_RT_VOLATILE_READ8 end
    if bid == 57 or bid == 59 do out LIR_RT_VOLATILE_WRITE8 end
    if bid == 64 or bid == 39 do out LIR_RT_DMB end
    if bid == 65 do out LIR_RT_DSB end
    if bid == 66 do out LIR_RT_ISB end
    if bid == 67 do out LIR_RT_WFI end
    if bid == 68 do out LIR_RT_WFE end
    if bid == 69 do out LIR_RT_SEV end
    if bid == 70 do out LIR_RT_NOP end
    if bid == 40 or bid == 78 do out LIR_RT_ATOMIC_LOAD64 end
    if bid == 72 do out LIR_RT_ATOMIC_LOAD32 end
    if bid == 41 or bid == 79 do out LIR_RT_ATOMIC_STORE64 end
    if bid == 73 do out LIR_RT_ATOMIC_STORE32 end
    if bid == 43 or bid == 80 do out LIR_RT_ATOMIC_ADD64 end
    if bid == 74 do out LIR_RT_ATOMIC_ADD32 end
    if bid == 44 or bid == 81 do out LIR_RT_ATOMIC_SUB64 end
    if bid == 75 do out LIR_RT_ATOMIC_SUB32 end
    if bid == 42 or bid == 82 do out LIR_RT_ATOMIC_CAS64 end
    if bid == 76 do out LIR_RT_ATOMIC_CAS32 end
    if bid == 71 or bid == 83 do out LIR_RT_ATOMIC_EXCHANGE64 end
    if bid == 77 do out LIR_RT_ATOMIC_EXCHANGE32 end
    out 0 - 1
end.

func lir_intr_is_identity(kind: i64):
    out lir_intr_is_payload(kind)
end.

func patch_bl_site(cb: CodeBuf, at_off: i64, dest_off: i64):
    rel = (dest_off - at_off) as int
    imm26 = (rel shr 2) bit_and 0x03FFFFFF
    word = 0x94000000 bit_or imm26
    out codebuf_patch_u32(cb, at_off as int, word)
end.

func emit_bl_fixup(cb: CodeBuf, call_fixups: i64, target_kind: i64, target_id: i64, rd: i64):
    at = codebuf_offset(cb) as i64
    cb = arm64_bl_imm26(cb, 0)
    call_fixups = vec_push_rt(call_fixups, lir_call_fixup_new(at, target_kind, target_id))
    if rd >= 0 and rd != 0 do
        cb = arm64_mov_rr(cb, rd as int, 0)
    end
    out cb
end.

func emit_to_x0(cb: CodeBuf, opnd: LirOperand, assigned_phys: i64, scratch: i64):
    r = resolve_or_imm_reg(cb, opnd, assigned_phys, scratch)
    if r >= 0 and r != 0 do
        cb = arm64_mov_rr(cb, 0, r as int)
    end
    out cb
end.

func emit_lir_setarg(cb: CodeBuf, ins: LirInstr, assigned_phys: i64, pending_stk: i64):
    SCR = 9
    ai = native_read_i64(ins as i64, 40)
    src1 = native_read_i64(ins as i64, 24)
    if (src1 as i64) != 0 do
        if native_read_i64(src1 as i64, 0) == (LirOperandType.Imm as i64) do
            ai = native_read_i64(src1 as i64, 32)
        end
    end
    src2 = native_read_i64(ins as i64, 32) as LirOperand
    rval = resolve_or_imm_reg(cb, src2, assigned_phys, SCR)
    if rval < 0 do
        out pending_stk
    end
    if ai >= 0 and ai < 8 do
        if rval != ai do
            arm64_mov_rr(cb, ai as int, rval as int)
        end
        out pending_stk
    end
    arm64_str_pre(cb, rval as int, 31, 0 - 16)
    out (pending_stk + 1)
end.

func emit_lir_intrinsic(cb: CodeBuf, ins: LirInstr, rd: i64, rs1: i64, assigned_phys: i64, call_fixups: i64, func_obj: LirFunc, str_fixups: i64, recent_setargs: i64):
    kind = native_read_i64(ins as i64, 40)
    ins_src1 = native_read_i64(ins as i64, 24) as LirOperand
    SCR = 9
    if lir_intr_is_marker(kind) == 1 do
        out arm64_nop(cb)
    end
    if kind == MIR_INTR_PARAM do
        abi = native_read_i64(ins_src1 as i64, 32)
        if rd >= 0 and abi >= 0 and abi < 8 do
            if rd != abi do
                arm64_mov_rr(cb, rd as int, abi as int)
            end
            out cb
        end
        out arm64_nop(cb)
    end
    if kind == MIR_INTR_BUILTIN do
        bid = native_read_i64(ins_src1 as i64, 32)
        # ── HOOK A + D: Inline read_byte(ptr, idx) → LDRB Wrd, [X_ptr, X_idx] ──
        if bid == 5 do
            if rd >= 0 do
                s0 = vec_get_rt(recent_setargs, 0)
                s1 = vec_get_rt(recent_setargs, 1)
                var (cb1, r0) = lir_load_opnd_to_reg(cb, s0, assigned_phys, 14)
                var (cb2, r1) = lir_load_opnd_to_reg(cb1, s1, assigned_phys, 15)
                cb = arm64_ldrb_reg(cb2, rd as int, r0 as int, r1 as int)
            end
            out cb
        end
        # ── HOOK A + D: Inline write_byte(ptr, idx, val) → STRB W_val, [X_ptr, X_idx]
        if bid == 6 do
            s0 = vec_get_rt(recent_setargs, 0)
            s1 = vec_get_rt(recent_setargs, 1)
            s2 = vec_get_rt(recent_setargs, 2)
            var (cb1, r0) = lir_load_opnd_to_reg(cb, s0, assigned_phys, 14)
            var (cb2, r1) = lir_load_opnd_to_reg(cb1, s1, assigned_phys, 15)
            var (cb3, r2) = lir_load_opnd_to_reg(cb2, s2, assigned_phys, 9)
            cb = arm64_strb_reg(cb3, r2 as int, r0 as int, r1 as int)
            out cb
        end
        # ── Inline read_word(ptr, idx) → LDR Xrd, [X_ptr, X_idx] ──
        if bid == 7 do
            if rd >= 0 do
                s0 = vec_get_rt(recent_setargs, 0)
                s1 = vec_get_rt(recent_setargs, 1)
                var (cb1, r0) = lir_load_opnd_to_reg(cb, s0, assigned_phys, 14)
                var (cb2, r1) = lir_load_opnd_to_reg(cb1, s1, assigned_phys, 15)
                cb = arm64_ldr_reg(cb2, rd as int, r0 as int, r1 as int)
            end
            out cb
        end
        # ── Inline write_word(ptr, idx, val) → STR X_val, [X_ptr, X_idx] ──
        if bid == 8 do
            s0 = vec_get_rt(recent_setargs, 0)
            s1 = vec_get_rt(recent_setargs, 1)
            s2 = vec_get_rt(recent_setargs, 2)
            var (cb1, r0) = lir_load_opnd_to_reg(cb, s0, assigned_phys, 14)
            var (cb2, r1) = lir_load_opnd_to_reg(cb1, s1, assigned_phys, 15)
            var (cb3, r2) = lir_load_opnd_to_reg(cb2, s2, assigned_phys, 9)
            cb = arm64_str_reg(cb3, r2 as int, r0 as int, r1 as int)
            out cb
        end
        # ── Inline memset(buf, val, len) / fill_bytes → Hardware 8-Byte Block Fill ──
        if bid == 32 do
            s0 = vec_get_rt(recent_setargs, 0)
            s1 = vec_get_rt(recent_setargs, 1)
            s2 = vec_get_rt(recent_setargs, 2)
            if s0 != 0 do
                typ0 = native_read_i64(s0 as i64, 0)
                if typ0 == 4 do
                    cb = arm64_movz_imm64(cb, 9, native_read_i64(s0 as i64, 32) as int)
                eif typ0 == 3 do
                    off0 = native_read_i64(s0 as i64, 24)
                    cb = arm64_sub_imm(cb, 9, 29, (0 - off0) as int)
                    cb = arm64_ldr_uoff(cb, 9, 9, 0)
                else
                    r_s0 = resolve_reg(s0 as LirOperand, assigned_phys)
                    if r_s0 >= 0 and r_s0 != 9 do
                        cb = arm64_mov_rr(cb, 9, r_s0 as int)
                    end
                end
            end
            if s1 != 0 do
                typ1 = native_read_i64(s1 as i64, 0)
                if typ1 == 4 do
                    cb = arm64_movz_imm64(cb, 10, native_read_i64(s1 as i64, 32) as int)
                eif typ1 == 3 do
                    off1 = native_read_i64(s1 as i64, 24)
                    cb = arm64_sub_imm(cb, 10, 29, (0 - off1) as int)
                    cb = arm64_ldr_uoff(cb, 10, 10, 0)
                else
                    r_s1 = resolve_reg(s1 as LirOperand, assigned_phys)
                    if r_s1 >= 0 and r_s1 != 10 do
                        cb = arm64_mov_rr(cb, 10, r_s1 as int)
                    end
                end
            end
            if s2 != 0 do
                typ2 = native_read_i64(s2 as i64, 0)
                if typ2 == 4 do
                    cb = arm64_movz_imm64(cb, 11, native_read_i64(s2 as i64, 32) as int)
                eif typ2 == 3 do
                    off2 = native_read_i64(s2 as i64, 24)
                    cb = arm64_sub_imm(cb, 11, 29, (0 - off2) as int)
                    cb = arm64_ldr_uoff(cb, 11, 11, 0)
                else
                    r_s2 = resolve_reg(s2 as LirOperand, assigned_phys)
                    if r_s2 >= 0 and r_s2 != 11 do
                        cb = arm64_mov_rr(cb, 11, r_s2 as int)
                    end
                end
            end
            cb = arm64_and_mask(cb, 12, 10, 255)
            cb = arm64_movz_imm64(cb, 13, 8)
            cb = arm64_lsl_rrr(cb, 13, 12, 13)
            cb = arm64_orr_rrr(cb, 12, 12, 13)
            cb = arm64_movz_imm64(cb, 13, 16)
            cb = arm64_lsl_rrr(cb, 13, 12, 13)
            cb = arm64_orr_rrr(cb, 12, 12, 13)
            cb = arm64_movz_imm64(cb, 13, 32)
            cb = arm64_lsl_rrr(cb, 13, 12, 13)
            cb = arm64_orr_rrr(cb, 12, 12, 13)
            cb = arm64_cmp_imm(cb, 11, 8)
            cb = codebuf_emit_u32(cb, 0x54000083)
            cb = codebuf_emit_u32(cb, 0xF800852C)
            cb = arm64_sub_imm(cb, 11, 11, 8)
            cb = arm64_b_imm26(cb, 0 - 16)
            cb = codebuf_emit_u32(cb, 0xB400008B)
            cb = codebuf_emit_u32(cb, 0x3800152A)
            cb = codebuf_emit_u32(cb, 0xF100056B)
            cb = codebuf_emit_u32(cb, 0x54FFFFE1)
            if rd >= 0 do
                cb = arm64_mov_rr(cb, rd as int, 9)
            end
            out cb
        end
        # ── HOOK B + D: Inline alloc(size) fast-path → bump X28 directly ──────
        if bid == 3 do
            if rd >= 0 do
                s0 = vec_get_rt(recent_setargs, 0)
                r_sz = 0
                if s0 != 0 do
                    r_sz = resolve_or_imm_reg(cb, s0 as LirOperand, assigned_phys, 9)
                end
                # Compute aligned size in X9 FIRST (before modifying rd in case rd == r_sz)
                cb = arm64_add_imm(cb, 9, r_sz as int, 7)   # X9  = size + 7
                cb = arm64_movz_imm64(cb, 10, 3)             # X10 = 3 (shift amt)
                cb = arm64_lsr_rrr(cb, 9, 9, 10)            # X9  = (size+7) >> 3
                cb = arm64_lsl_imm(cb, 9, 9, 3)             # X9  = aligned to 8
                cb = arm64_ldr_uoff(cb, rd as int, 28, 0)   # rd = bump_curr
                cb = arm64_add_rrr(cb, 9, rd as int, 9)     # X9  = bump + aligned
                cb = arm64_str_uoff(cb, 9, 28, 0)           # *X28 = new bump_curr
                out cb
            end
        end
        # ── Inline rotl32(val, n) → Hardware 32-bit ROR / RORV ──
        if bid == 84 do
            if rd >= 0 do
                s0 = vec_get_rt(recent_setargs, 0)
                s1 = vec_get_rt(recent_setargs, 1)
                var (cb1, r0) = lir_load_opnd_to_reg(cb, s0, assigned_phys, 14)
                var (cb2, r1) = lir_load_opnd_to_reg(cb1, s1, assigned_phys, 15)
                # ARM64: neg w15, w_r1; ror w_rd, w_r0, w15
                cb = codebuf_emit_u32(cb2, 0x4B0003EF bit_or ((r1 as int bit_and 0x1F) shl 16))
                cb = codebuf_emit_u32(cb, 0x1AC02C00 bit_or (15 shl 16) bit_or ((r0 as int bit_and 0x1F) shl 5) bit_or (rd as int bit_and 0x1F))
                out cb
            end
            out cb
        end
        # ── Inline rotr32(val, n) → Hardware 32-bit ROR / RORV ──
        if bid == 85 do
            if rd >= 0 do
                s0 = vec_get_rt(recent_setargs, 0)
                s1 = vec_get_rt(recent_setargs, 1)
                var (cb1, r0) = lir_load_opnd_to_reg(cb, s0, assigned_phys, 14)
                var (cb2, r1) = lir_load_opnd_to_reg(cb1, s1, assigned_phys, 15)
                # ARM64: ror w_rd, w_r0, w_r1
                cb = codebuf_emit_u32(cb2, 0x1AC02C00 bit_or ((r1 as int bit_and 0x1F) shl 16) bit_or ((r0 as int bit_and 0x1F) shl 5) bit_or (rd as int bit_and 0x1F))
                out cb
            end
            out cb
        end
        stub = lir_stub_for_builtin_id(bid)
        if stub < 0 do
            stub = LIR_RT_UNRESOLVED
        end
        out emit_bl_fixup(cb, call_fixups, 1, stub, rd)
    end
    if kind == MIR_INTR_PRINT do
        cb = emit_to_x0(cb, ins_src1, assigned_phys, 9)
        out emit_bl_fixup(cb, call_fixups, 1, MIR_INTR_PRINT, rd)
    end
    if kind == MIR_INTR_PRINT_STR do
        cb = emit_to_x0(cb, ins_src1, assigned_phys, 9)
        out emit_bl_fixup(cb, call_fixups, 1, LIR_RT_PRINT_STR, rd)
    end
    if kind == MIR_INTR_STR_LIT or kind == MIR_INTR_INTERP or kind == MIR_INTR_BUNDLE do
        sid = native_read_i64(ins_src1 as i64, 32)
        f_strings = native_read_i64(func_obj as i64, 32)
        if f_strings > 0 and sid >= 0 and sid < vec_len_rt(f_strings) and rd >= 0 do
            s_val = vec_get_rt(f_strings, sid)
            str_fixups = vec_push_rt(str_fixups, lir_str_fixup_new(codebuf_offset(cb) as i64, s_val as i64, rd))
            out codebuf_emit_u32(cb, 0x10000000 bit_or (rd as int bit_and 0x1F))
        end
        if rd >= 0 do
            arm64_movz_imm64(cb, rd as int, 0)
            out cb
        end
        out arm64_nop(cb)
    end
    if lir_intr_is_payload(kind) == 1 do
        if rd >= 0 do
            if native_read_i64(ins_src1 as i64, 0) == (LirOperandType.Imm as i64) do
                arm64_movz_imm64(cb, rd as int, native_read_i64(ins_src1 as i64, 32) as int)
                out cb
            eif rs1 >= 0 do
                arm64_mov_rr(cb, rd as int, rs1 as int)
                out cb
            end
        end
        out arm64_nop(cb)
    end
    if kind == MIR_INTR_INDEX do
        if rd >= 0 and rs1 >= 0 do
            cb = arm64_lsl_imm(cb, 9, 0, 3)
            cb = arm64_add_rrr(cb, 9, rs1 as int, 9)
            cb = arm64_ldr_uoff(cb, rd as int, 9, 0)
            out cb
        end
        out arm64_nop(cb)
    end
    if kind == MIR_INTR_INDEX_STORE do
        if rs1 >= 0 do
            cb = arm64_lsl_imm(cb, 9, 0, 3)
            cb = arm64_add_rrr(cb, 9, rs1 as int, 9)
            cb = arm64_str_uoff(cb, 1, 9, 0)
            out cb
        end
        out arm64_nop(cb)
    end
    if kind == MIR_INTR_FIELD do
        if rd >= 0 and rs1 >= 0 do
            cb = arm64_lsl_imm(cb, 9, 0, 3)
            cb = arm64_add_rrr(cb, 9, rs1 as int, 9)
            cb = arm64_ldr_uoff(cb, rd as int, 9, 0)
            out cb
        end
        out arm64_nop(cb)
    end
    if kind == MIR_INTR_FIELD_STORE do
        if rs1 >= 0 do
            cb = arm64_lsl_imm(cb, 9, 0, 3)
            cb = arm64_add_rrr(cb, 9, rs1 as int, 9)
            cb = arm64_str_uoff(cb, 1, 9, 0)
            out cb
        end
        out arm64_nop(cb)
    end
    if kind == MIR_INTR_ARENA do
        if rd >= 0 do
            cb = arm64_ldr_uoff(cb, rd as int, 28, 0)
            out cb
        end
        if rs1 >= 0 do
            cb = arm64_str_uoff(cb, rs1 as int, 28, 0)
            out cb
        end
        out arm64_nop(cb)
    end
    if kind == MIR_INTR_ENTITY or kind == MIR_INTR_ARRAY or kind == MIR_INTR_TUPLE do
        n_elem = 0
        if (ins_src1 as i64) != 0 do
            styp = native_read_i64(ins_src1 as i64, 0)
            if styp == 5 or styp == 4 or styp == (LirOperandType.Imm as i64) do
                n_elem = native_read_i64(ins_src1 as i64, 32)
            end
        end
        if rd >= 0 do
            cb = arm64_ldr_uoff(cb, 9, 28, 0)
            cb = arm64_mov_rr(cb, rd as int, 9)
            alloc_bytes = n_elem * 8
            if alloc_bytes > 0 do
                cb = arm64_add_imm(cb, 10, 9, alloc_bytes as int)
                cb = arm64_str_uoff(cb, 10, 28, 0)
            end
            var ei = 0
            when ei < n_elem and ei < 8 loop
                cb = arm64_str_uoff(cb, ei as int, rd as int, (ei * 8) as int)
                ei = ei + 1
            end
            out cb
        end
        out arm64_nop(cb)
    end
    emit_to_x0(cb, ins_src1, assigned_phys, SCR)
    stub2 = kind
    if stub2 < 1 or stub2 >= LIR_RT_STUB_COUNT do
        stub2 = LIR_RT_UNRESOLVED
    end
    out emit_bl_fixup(cb, call_fixups, 1, stub2, rd)
end.

func lir_find_func_index(lir_funcs: i64, name: string):
    n = vec_len_rt(lir_funcs)
    var i = 0
    when i < n loop
        lf = vec_get_rt(lir_funcs, i)
        fn_name = native_read_i64(lf as i64, 8) as string
        if fat_str_eq(fn_name, name) == 1 do
            out i
        end
        i = i + 1
    end
    out 0 - 1
end.

func emit_lir_call(cb: CodeBuf, ins: LirInstr, rd: i64, func_obj: LirFunc, lir_funcs: i64, call_fixups: i64, pending_stk: i64):
    sid = native_read_i64(ins as i64, 40)
    target_kind = 1
    target_id = LIR_RT_UNRESOLVED
    f_strings = native_read_i64(func_obj as i64, 32)
    if f_strings > 0 and sid >= 0 and sid < vec_len_rt(f_strings) do
        cname = vec_get_rt(f_strings, sid)
        fi = lir_find_func_index(lir_funcs, cname)
        if fi >= 0 do
            target_kind = 0
            target_id = fi
        end
    end
    emit_bl_fixup(cb, call_fixups, target_kind, target_id, rd)
    if pending_stk > 0 do
        bytes = pending_stk * 16
        if bytes <= 4095 do
            arm64_add_imm(cb, 31, 31, bytes as int)
        end
    end
    out 0
end.

func emit_lir_rt_print_stub(cb: CodeBuf, is_linux: i64):
    cb = arm64_sub_imm(cb, 31, 31, 128)
    cb = arm64_str_uoff(cb, 1, 31, 0)
    cb = arm64_str_uoff(cb, 2, 31, 8)
    cb = arm64_str_uoff(cb, 3, 31, 16)
    cb = arm64_str_uoff(cb, 4, 31, 24)
    cb = arm64_str_uoff(cb, 5, 31, 32)
    cb = arm64_str_uoff(cb, 6, 31, 40)
    cb = arm64_str_uoff(cb, 16, 31, 48)

    cb = arm64_mov_imm16(cb, 2, 10)
    cb = arm64_mov_imm16(cb, 3, 10)
    cb = arm64_strb_uoff(cb, 2, 31, 127)

    cb = arm64_cmp_imm0(cb, 0)
    cb = arm64_bne_imm19(cb, 24)
    cb = arm64_mov_imm16(cb, 2, 48)
    cb = arm64_strb_uoff(cb, 2, 31, 126)
    cb = arm64_add_imm(cb, 2, 31, 126)
    cb = arm64_mov_imm16(cb, 3, 2)
    cb = arm64_b_imm26(cb, 88)

    cb = arm64_add_imm(cb, 1, 31, 127)
    cb = arm64_cset_lt(cb, 4)
    cb = arm64_cmp_imm0(cb, 4)
    cb = arm64_beq_imm19(cb, 8)
    cb = arm64_sub_rrr(cb, 0, 31, 0)

    loop_top = codebuf_offset(cb)
    cb = arm64_sdiv_rrr(cb, 5, 0, 3)
    cb = arm64_msub_rrrr(cb, 6, 5, 3, 0)
    cb = arm64_add_imm(cb, 6, 6, 48)
    cb = arm64_sub_imm(cb, 1, 1, 1)
    cb = arm64_strb_uoff(cb, 6, 1, 0)
    cb = arm64_mov_rr(cb, 0, 5)
    cb = arm64_cmp_imm0(cb, 0)
    delta = (loop_top - codebuf_offset(cb)) as int
    cb = arm64_bne_imm19(cb, delta)

    cb = arm64_cmp_imm0(cb, 4)
    cb = arm64_beq_imm19(cb, 16)
    cb = arm64_mov_imm16(cb, 6, 45)
    cb = arm64_sub_imm(cb, 1, 1, 1)
    cb = arm64_strb_uoff(cb, 6, 1, 0)

    cb = arm64_mov_rr(cb, 2, 1)
    cb = arm64_add_imm(cb, 5, 31, 128)
    cb = arm64_sub_rrr(cb, 3, 5, 1)

    cb = arm64_mov_imm16(cb, 0, 1)
    cb = arm64_mov_rr(cb, 1, 2)
    cb = arm64_mov_rr(cb, 2, 3)
    if is_linux == 1 do
        cb = arm64_mov_imm16(cb, 8, 64)
        cb = arm64_svc(cb, 0)
    else
        cb = arm64_mov_imm16(cb, 16, 4)
        cb = codebuf_emit_u32(cb, 0xF2A04010)
        cb = arm64_svc(cb, 0x80)
    end

    cb = arm64_ldr_uoff(cb, 1, 31, 0)
    cb = arm64_ldr_uoff(cb, 2, 31, 8)
    cb = arm64_ldr_uoff(cb, 3, 31, 16)
    cb = arm64_ldr_uoff(cb, 4, 31, 24)
    cb = arm64_ldr_uoff(cb, 5, 31, 32)
    cb = arm64_ldr_uoff(cb, 6, 31, 40)
    cb = arm64_ldr_uoff(cb, 16, 31, 48)
    cb = arm64_add_imm(cb, 31, 31, 128)
    out arm64_ret(cb)
end.

func emit_lir_rt_print_str_stub(cb: CodeBuf, is_linux: i64):
    cb = arm64_sub_imm(cb, 31, 31, 32)
    cb = arm64_str_uoff(cb, 19, 31, 0)
    cb = arm64_str_uoff(cb, 20, 31, 8)
    cb = arm64_str_uoff(cb, 30, 31, 16)

    cb = arm64_mov_rr(cb, 19, 0)
    cb = arm64_mov_rr(cb, 20, 0)

    len_loop = codebuf_offset(cb)
    cb = arm64_ldrb_uoff(cb, 0, 20, 0)
    cb = arm64_cmp_imm0(cb, 0)
    cb = arm64_beq_imm19(cb, 12)
    cb = arm64_add_imm(cb, 20, 20, 1)
    delta = (len_loop - codebuf_offset(cb)) as int
    cb = arm64_b_imm26(cb, delta)

    cb = arm64_sub_rrr(cb, 2, 20, 19)

    cb = arm64_cmp_imm0(cb, 2)
    cb = arm64_beq_imm19(cb, 32)
    cb = arm64_mov_imm16(cb, 0, 1)
    cb = arm64_mov_rr(cb, 1, 19)
    if is_linux == 1 do
        cb = arm64_mov_imm16(cb, 8, 64)
        cb = arm64_svc(cb, 0)
    else
        cb = arm64_mov_imm16(cb, 16, 4)
        cb = codebuf_emit_u32(cb, 0xF2A04010)
        cb = arm64_svc(cb, 0x80)
    end

    cb = arm64_mov_imm16(cb, 0, 10)
    cb = arm64_strb_uoff(cb, 0, 31, 24)
    cb = arm64_mov_imm16(cb, 0, 1)
    cb = arm64_add_imm(cb, 1, 31, 24)
    cb = arm64_mov_imm16(cb, 2, 1)
    if is_linux == 1 do
        cb = arm64_mov_imm16(cb, 8, 64)
        cb = arm64_svc(cb, 0)
    else
        cb = arm64_mov_imm16(cb, 16, 4)
        cb = codebuf_emit_u32(cb, 0xF2A04010)
        cb = arm64_svc(cb, 0x80)
    end

    cb = arm64_ldr_uoff(cb, 19, 31, 0)
    cb = arm64_ldr_uoff(cb, 20, 31, 8)
    cb = arm64_ldr_uoff(cb, 30, 31, 16)
    cb = arm64_add_imm(cb, 31, 31, 32)
    out arm64_ret(cb)
end.

func emit_lir_rt_read_u8_stub(cb: CodeBuf):
    cb = arm64_add_rrr(cb, 0, 0, 1)
    cb = arm64_ldrb_uoff(cb, 0, 0, 0)
    out arm64_ret(cb)
end.

func emit_lir_rt_write_u8_stub(cb: CodeBuf):
    cb = arm64_add_rrr(cb, 0, 0, 1)
    cb = arm64_strb_uoff(cb, 2, 0, 0)
    out arm64_ret(cb)
end.

func emit_lir_rt_alloc_stub(cb: CodeBuf):
    # X0 = requested size
    cb = arm64_ldr_uoff(cb, 1, 28, 0)      # X1 = *X28 (bump_curr)
    cb = arm64_mov_rr(cb, 2, 1)           # X2 = bump_curr (return pointer)

    cb = arm64_cmp_imm0(cb, 0)
    cb = arm64_beq_imm19(cb, 28)

    cb = arm64_add_imm(cb, 0, 0, 7)
    cb = arm64_mov_imm16(cb, 3, 3)
    cb = arm64_lsr_rrr(cb, 0, 0, 3)
    cb = arm64_lsl_imm(cb, 0, 0, 3)
    cb = arm64_add_rrr(cb, 1, 1, 0)
    cb = arm64_str_uoff(cb, 1, 28, 0)

    cb = arm64_mov_rr(cb, 0, 2)
    out arm64_ret(cb)
end.

func emit_lir_rt_arg_count_stub(cb: CodeBuf):
    cb = arm64_ldr_uoff(cb, 0, 28, 8)
    out arm64_ret(cb)
end.

func emit_lir_rt_get_arg_stub(cb: CodeBuf):
    cb = arm64_ldr_uoff(cb, 1, 28, 8)
    cb = arm64_cmp_rr(cb, 0, 1)
    cb = arm64_cset_lt(cb, 2)
    cb = arm64_cmp_imm0(cb, 2)
    cb = arm64_beq_imm19(cb, 24)

    cb = arm64_ldr_uoff(cb, 1, 28, 16)
    cb = arm64_lsl_imm(cb, 0, 0, 3)
    cb = arm64_add_rrr(cb, 1, 1, 0)
    cb = arm64_ldr_uoff(cb, 0, 1, 0)
    cb = arm64_ret(cb)

    cb = arm64_mov_imm16(cb, 0, 0)
    out arm64_ret(cb)
end.

func emit_lir_rt_read_i64_stub(cb: CodeBuf):
    cb = arm64_add_rrr(cb, 0, 0, 1)
    cb = arm64_ldr_uoff(cb, 0, 0, 0)
    out arm64_ret(cb)
end.

func emit_lir_rt_write_i64_stub(cb: CodeBuf):
    cb = arm64_add_rrr(cb, 0, 0, 1)
    cb = arm64_str_uoff(cb, 2, 0, 0)
    out arm64_ret(cb)
end.

func emit_lir_rt_volatile_read_stub(cb: CodeBuf):
