                        eif ins_aux == LIR_CMP_GT do
                            cb = arm64_cset_gt(cb, rd as int)
                        eif ins_aux == LIR_CMP_LT do
                            cb = arm64_cset_lt(cb, rd as int)
                        eif ins_aux == LIR_CMP_GE do
                            cb = arm64_cset_ge(cb, rd as int)
                        eif ins_aux == LIR_CMP_LE do
                            cb = arm64_cset_le(cb, rd as int)
                        end
                    end
                end
                if rd >= 0 and rd < 32 do
                    vec_set_rt(reg_const_val, rd, 0 - 1)
                end
            eif op == LirOp.Load do
                if rd >= 0 and rs1 >= 0 do
                    cb = codebuf_emit_u32(cb, 0xF9400000 or ((rs1 as int and 0x1F) shl 5) or (rd as int and 0x1F))
                end
                if rd >= 0 and rd < 32 do
                    vec_set_rt(reg_const_val, rd, 0 - 1)
                end
                last_cmp_pred = 0 - 1
            eif op == LirOp.Store do
                if rs1 >= 0 and rs2 >= 0 do
                    cb = codebuf_emit_u32(cb, 0xF9000000 or ((rs2 as int and 0x1F) shl 5) or (rs1 as int and 0x1F))
                end
                last_cmp_pred = 0 - 1
            eif op == LirOp.Push do
                rval = resolve_or_imm_reg(cb, ins_src1, assigned_phys, SCR)
                if rval >= 0 do
                    cb = arm64_str_pre(cb, rval as int, 31, 0 - 16)
                end
                last_cmp_pred = 0 - 1
            eif op == LirOp.SetArg do
                ai = native_read_i64(ins as i64, 40)
                s1_arg = native_read_i64(ins as i64, 24)
                if (s1_arg as i64) != 0 do
                    if native_read_i64(s1_arg as i64, 0) == 5 do # Imm tag
                        ai = native_read_i64(s1_arg as i64, 32)
                    end
                end
                s2_arg = native_read_i64(ins as i64, 32)
                if ai >= 0 and ai < 4 do
                    vec_set_rt(recent_setargs, ai, s2_arg)
                end
                if ai < 8 do
                    var (cb_sa, p_stk_sa) = emit_lir_setarg(cb, ins, assigned_phys, 0)
                    cb = cb_sa
                else
                    pending_stack_args = vec_push_rt(pending_stack_args, ins)
                end
                last_cmp_pred = 0 - 1
            eif op == LirOp.Pop do
                if rd >= 0 do
                    cb = arm64_ldr_post(cb, rd as int, 31, 16)
                end
            eif op == LirOp.Call do
                n_stk = vec_len_rt(pending_stack_args)
                stk_bytes = 0
                if n_stk > 0 do
                    stk_bytes = (n_stk * 8) + 15
                    stk_bytes = stk_bytes - (stk_bytes mod 16)
                    cb = emit_stack_alloc_arm64(cb, stk_bytes)
                    var si = 0
                    when si < n_stk loop
                        stk_ins = vec_get_rt(pending_stack_args, si)
                        stk_s2 = native_read_i64(stk_ins as i64, 32)
                        var (cb_s, r_s) = lir_load_opnd_to_reg(cb, stk_s2, assigned_phys, SCR)
                        cb = cb_s
                        cb = arm64_str_uoff(cb, r_s as int, 31, (si * 8) as int)
                        si = si + 1
                    end
                end
                var (cb_cl, p_stk_cl) = emit_lir_call(cb, ins, rd, func_obj, lir_funcs, call_fixups, 0, assigned_phys)
                cb = cb_cl
                if stk_bytes > 0 do
                    cb = emit_stack_free_arm64(cb, stk_bytes)
                    pending_stack_args = vec_new_rt()
                end
                last_cmp_pred = 0 - 1
            eif op == LirOp.Intrinsic do
                pending_stack_args = vec_new_rt()
                cb = emit_lir_intrinsic(cb, ins, rd, rs1, assigned_phys, call_fixups, func_obj, str_fixups, recent_setargs, lir_funcs)
                last_cmp_pred = 0 - 1
            eif op == LirOp.Jmp do
                tgt = 0 - 1
                if (ins_src1 as i64) != 0 do
                    src1_typ = native_read_i64(ins_src1 as i64, 0)
                    if src1_typ == 6 do # Label
                        tgt = native_read_i64(ins_src1 as i64, 40)
                    eif src1_typ == 5 do # Imm
                        tgt = native_read_i64(ins_src1 as i64, 32)
                    end
                end
                if tgt >= 0 do
                    next_bid = 0 - 1
                    if bi + 1 < n_blocks do
                        next_b = vec_get_rt(g_codegen_blocks, bi + 1)
                        next_bid = native_read_i64(next_b as i64, 0)
                    end
                    if tgt != next_bid do
                        at = codebuf_offset(cb) as i64
                        cb = arm64_b_imm26(cb, 0)
                        fixups = vec_push_rt(fixups, lir_fixup_new(at, tgt, 0))
                    end
                end
                last_cmp_pred = 0 - 1
            eif op == LirOp.JmpCond do
                tgt = 0 - 1
                if (ins_src2 as i64) != 0 do
                    src2_typ = native_read_i64(ins_src2 as i64, 0)
                    if src2_typ == 6 do # Label
                        tgt = native_read_i64(ins_src2 as i64, 40)
                    eif src2_typ == 5 do # Imm
                        tgt = native_read_i64(ins_src2 as i64, 32)
                    end
                end
                if last_cmp_pred >= 0 and lir_opnd_matches(last_cmp_dst, ins_src1) == 1 do
                    # Fused Cmp + JmpCond: flags already in NZCV, branch directly to condition!
                    if tgt >= 0 do
                        at = codebuf_offset(cb) as i64
                        is_ifnot = 0
                        if ins_aux == LIR_JMP_IFNOT do
                            is_ifnot = 1
                        end
                        cond = arm64_cond_code(last_cmp_pred, is_ifnot)
                        cb = codebuf_emit_u32(cb, 0x54000000)
                        fixups = vec_push_rt(fixups, lir_fixup_new(at, tgt, 10 + cond))
                    end
                    last_cmp_pred = 0 - 1
                else
                    a = resolve_or_imm_reg(cb, ins_src1, assigned_phys, SCR)
                    if a >= 0 do
                        cb = codebuf_emit_u32(cb, 0xF100001F or ((a as int and 0x1F) shl 5))
                    end
                    if tgt >= 0 do
                        at = codebuf_offset(cb) as i64
                        kind = 2
                        if ins_aux == LIR_JMP_IFNOT do
                            kind = 1
                        end
                        if kind == 1 do
                            cb = arm64_beq_imm19(cb, 0)
                        else
                            cb = arm64_bne_imm19(cb, 0)
                        end
                        fixups = vec_push_rt(fixups, lir_fixup_new(at, tgt, kind))
                    end
                    last_cmp_pred = 0 - 1
                end
            eif op == LirOp.Ret do
                if (ins_src1 as i64) != 0 do
                    src1_typ = native_read_i64(ins_src1 as i64, 0)
                    if src1_typ == 5 do # Imm
                        imm_val = native_read_i64(ins_src1 as i64, 32)
                        cb = arm64_movz_imm64(cb, 0, imm_val as int)
                    eif rs1 >= 0 and rs1 != 0 do
                        cb = arm64_mov_rr(cb, 0, rs1 as int)
                    end
                eif rs1 >= 0 and rs1 != 0 do
                    cb = arm64_mov_rr(cb, 0, rs1 as int)
                end
                cb = emit_stack_free_arm64(cb, g_codegen_stack_size)
                cb = emit_callee_restore(cb, g_codegen_max_phys)
                cb = arm64_ldp_post(cb, 29, 30, 31, 16)
                cb = arm64_ret(cb)
                last_cmp_pred = 0 - 1
            end
            if rd_spill < 0 do
                cb = emit_spill_store(cb, ins_dst, SCRD)
            end
            ii = ii + 1
        end
        bi = bi + 1
    end

    # Fall-through epilogue (when function has no explicit Ret)
    cb = arm64_mov_imm16(cb, 0, 0)
    cb = emit_stack_free_arm64(cb, g_codegen_stack_size)
    cb = emit_callee_restore(cb, g_codegen_max_phys)
    cb = arm64_ldp_post(cb, 29, 30, 31, 16)
    cb = arm64_ret(cb)

    nf = vec_len_rt(fixups)
    var fxi = 0
    when fxi < nf loop
        fx = vec_get_rt(fixups, fxi)
        f_tgt = lir_fixup_target_block(fx)
        f_kind = lir_fixup_kind(fx)
        f_at = lir_fixup_at_off(fx)
        if f_tgt >= 0 and f_tgt < max_bid do
            dest = vec_get_rt(block_off, f_tgt)
            if dest >= 0 do
                rel = (dest - f_at) as int
                if f_kind == 0 do
                    imm26 = (rel shr 2) and 0x03FFFFFF
                    word = 0x14000000 or imm26
                    cb = codebuf_patch_u32(cb, f_at as int, word)
                else
                    # Conditional branch B.cond immediate range is ±1 MiB (-1048576 .. 1048572)
                    if rel < -1048576 or rel > 1048572 do
                        print_str("FATAL: ARM64 conditional branch out of range (+/-1MB)\n")
                    end
                    imm19 = (rel shr 2) and 0x7FFFF
                    if f_kind == 1 do
                        word = 0x54000000 or (imm19 shl 5)
                        cb = codebuf_patch_u32(cb, f_at as int, word)
                    eif f_kind == 2 do
                        word = 0x54000001 or (imm19 shl 5)
                        cb = codebuf_patch_u32(cb, f_at as int, word)
                    eif f_kind >= 10 do
                        cond = (f_kind - 10) and 0xF
                        word = 0x54000000 or (imm19 shl 5) or cond
                        cb = codebuf_patch_u32(cb, f_at as int, word)
                    end
                end
            end
        end
        fxi = fxi + 1
    end

    out cb
end.

func emit_lir_module_arm64(lir_funcs: i64, is_linux: i64):
    arm64_prepare_func_index(lir_funcs)
    var va_base = 0x100000000 + 616
    if is_linux == 1 do
        va_base = 0x401000
    end
    var cb = codebuf_new(TargetArch.ARM64)
    let n_funcs = vec_len_rt(lir_funcs)
    var func_offs = vec_new_cap_rt(4096)
    var call_fixups_box = alloc(8)
    native_write_i64(call_fixups_box, 0, vec_new_cap_rt(65536))
    var str_fixups_box = alloc(8)
    native_write_i64(str_fixups_box, 0, vec_new_cap_rt(65536))

    var fi = 0
    when fi < n_funcs loop
        func_offs = vec_push_rt(func_offs, codebuf_offset(cb) as i64)
        let lf = vec_get_rt(lir_funcs, fi)
        cb = emit_lir_arm64_into(cb, lf, 0 - 1, lir_funcs, call_fixups_box, str_fixups_box)
        fi = fi + 1
    end

    var rt_offs = vec_new_cap_rt(1024)
    cb = emit_lir_rt_stubs(cb, rt_offs, is_linux)

    let call_fixups = native_read_i64(call_fixups_box, 0)
    let nf = vec_len_rt(call_fixups)
    var ci = 0
    var dest = 0 - 1
    when ci < nf loop
        let fx = vec_get_rt(call_fixups, ci)
        let f_tkind = native_read_i64(fx as i64, 8)
        let f_tid = native_read_i64(fx as i64, 16)
        let f_at = native_read_i64(fx as i64, 0)
        if f_tkind == 2 do
            if f_tid >= 0 and f_tid < n_funcs do
                let dest_adr = vec_get_rt(func_offs, f_tid)
                let f_rd = native_read_i64(fx as i64, 24)

                va_pc = va_base + f_at
                va_dest = va_base + dest_adr

                pc_page = va_pc and (0 - 4096)
                target_page = va_dest and (0 - 4096)
                page_delta = target_page - pc_page
                page_imm = ((page_delta - (page_delta mod 4096)) / 4096) and 0x1FFFFF
                immlo = page_imm and 3
                immhi = (page_imm shr 2) and 0x7FFFF
                adrp_word = 0x90000000 or (immlo shl 29) or (immhi shl 5) or (f_rd and 0x1F)
                cb = codebuf_patch_u32(cb, f_at as int, adrp_word as int)

                lo12 = va_dest and 0xFFF
                add_word = 0x91000000 or ((lo12 as int) shl 10) or ((f_rd as int and 0x1F) shl 5) or (f_rd as int and 0x1F)
                cb = codebuf_patch_u32(cb, (f_at + 4) as int, add_word as int)
            end
        else
            dest = 0 - 1
            if f_tkind == 0 do
                if f_tid >= 0 and f_tid < n_funcs do
                    dest = vec_get_rt(func_offs, f_tid)
                end
            else
                if f_tid >= 0 and f_tid < LIR_RT_STUB_COUNT do
                    dest = vec_get_rt(rt_offs, f_tid)
                end
            end
            if dest < 0 do
                dest = vec_get_rt(rt_offs, LIR_RT_UNRESOLVED)
            end
            cb = patch_bl_site(cb, f_at, dest)
        end
        ci = ci + 1
    end

    cb.start_offset = codebuf_offset(cb)
    if is_linux == 1 do
        # ── Linux ARM64 ELF Entry: [SP] = argc, SP + 8 = argv ──
        cb = arm64_ldr_uoff(cb, 19, 31, 0)   # X19 = argc
        cb = arm64_add_imm(cb, 20, 31, 8)    # X20 = argv
        cb = arm64_stp_pre(cb, 29, 30, 31, 0 - 16)
        cb = arm64_mov_from_sp(cb, 29)

        # ── Initialize 2GB Global Arena Heap via Linux mmap ──
        cb = arm64_mov_imm16(cb, 0, 0)
        cb = arm64_mov_imm16(cb, 1, 0)
        cb = codebuf_emit_u32(cb, 0xF2B00001) # MOVK X1, #0x8000, LSL #16 (2GB)
        cb = arm64_mov_imm16(cb, 2, 3)         # PROT_READ | PROT_WRITE
        cb = arm64_mov_imm16(cb, 3, 34)        # MAP_PRIVATE | MAP_ANONYMOUS (0x22)
        cb = codebuf_emit_u32(cb, 0x92800004) # MOVN X4, #0 (-1 fd)
        cb = arm64_mov_imm16(cb, 5, 0)
        cb = arm64_mov_imm16(cb, 8, 222)       # X8 = 222 (SYS_mmap)
        cb = arm64_svc(cb, 0)                  # SVC #0
    else
        # ── macOS Mach-O Entry: dyld passes X0 = argc, X1 = argv ──
        cb = arm64_mov_rr(cb, 19, 0)     # X19 = argc
        cb = arm64_mov_rr(cb, 20, 1)     # X20 = argv

        cb = arm64_stp_pre(cb, 29, 30, 31, 0 - 16)
        cb = arm64_mov_from_sp(cb, 29)

        # ── Initialize 2GB Global Arena Heap via macOS mmap ──
        cb = arm64_mov_imm16(cb, 0, 0)
        cb = arm64_mov_imm16(cb, 1, 0)
        cb = codebuf_emit_u32(cb, 0xF2B00001) # MOVK X1, #0x8000, LSL #16 (2GB)
        cb = arm64_mov_imm16(cb, 2, 3)         # PROT_READ | PROT_WRITE
        cb = arm64_mov_imm16(cb, 3, 4098)      # MAP_ANON | MAP_PRIVATE (0x1002)
        cb = codebuf_emit_u32(cb, 0x92800004) # MOVN X4, #0 (-1 fd)
        cb = arm64_mov_imm16(cb, 5, 0)
        cb = arm64_mov_imm16(cb, 16, 197)     # SYS_mmap
        cb = codebuf_emit_u32(cb, 0xF2A04010) # MOVK X16, #0x200, LSL #16
        cb = arm64_svc(cb, 0x80)
    end

    # X28 = heap base returned in X0
    cb = arm64_mov_rr(cb, 28, 0)
    # Reserve 32 KiB at the arena base for argc/argv and module globals.
    # Global slots start at X28+32 and are addressed directly by intrinsics.
    cb = arm64_mov_imm16(cb, 10, 32768)
    cb = arm64_add_rrr(cb, 1, 28, 10)
    cb = arm64_str_uoff(cb, 1, 28, 0)
    # Save argc and argv in heap header:
    cb = arm64_str_uoff(cb, 19, 28, 8)     # *(X28 + 8) = argc
    cb = arm64_str_uoff(cb, 20, 28, 16)    # *(X28 + 16) = argv
    if n_funcs > 0 do
        init_idx = lir_find_func_index(lir_funcs, fat_str_new("__vir_global_init"))
        if init_idx >= 0 do
            init_at = codebuf_offset(cb) as i64
            cb = arm64_bl_imm26(cb, 0)
            cb = patch_bl_site(cb, init_at, vec_get_rt(func_offs, init_idx))
        end
        main_idx = lir_find_func_index(lir_funcs, fat_str_new("main"))
        if main_idx < 0 do
            main_idx = lir_find_func_index(lir_funcs, fat_str_new("__main__"))
        end
        if main_idx < 0 do
            main_idx = n_funcs - 1
        end
        at = codebuf_offset(cb) as i64
        cb = arm64_bl_imm26(cb, 0)
        main_off = vec_get_rt(func_offs, main_idx)
        cb = patch_bl_site(cb, at, main_off)
    end
    cb = arm64_mov_imm16(cb, 0, 0)
    if is_linux == 1 do
        cb = arm64_mov_imm16(cb, 8, 93)        # X8 = 93 (SYS_exit on Linux)
        cb = arm64_svc(cb, 0)
    else
        cb = arm64_mov_imm16(cb, 16, 1)        # SYS_exit on macOS
        cb = codebuf_emit_u32(cb, 0xF2A04010)
        cb = arm64_svc(cb, 0x80)
    end
    cb = arm64_ldp_post(cb, 29, 30, 31, 16)
    cb = arm64_ret(cb)

    # ── String Literal Pool & Patch ADR Sites ──
    let str_fixups = native_read_i64(str_fixups_box, 0)
    n_sfx = vec_len_rt(str_fixups)
    if n_sfx > 0 do
        pool_offsets = vec_new_cap_rt(n_sfx)
        str_pool_buckets = vec_new_cap_rt(256)
        var sbi = 0
        when sbi < 256 loop
            str_pool_buckets = vec_push_rt(str_pool_buckets, 0)
            sbi = sbi + 1
        end
        var sfi = 0
        when sfi < n_sfx loop
            sfx = vec_get_rt(str_fixups, sfi)
            s_val = native_read_i64(sfx as i64, 8) as string
            s_data = native_read_i64(s_val as i64, 0)
            s_len = native_read_i64(s_val as i64, 8)
            found_off = 0 - 1
            str_bid = arm64_func_name_hash(s_val)
            str_bucket = vec_get_rt(str_pool_buckets, str_bid)
            if str_bucket == 0 do str_bucket = vec_new_rt() end
            var pbi = 0
            when pbi < vec_len_rt(str_bucket) loop
                pfi = vec_get_rt(str_bucket, pbi)
                prev_sfx = vec_get_rt(str_fixups, pfi)
                prev_s_val = native_read_i64(prev_sfx as i64, 8) as string
                if fat_str_eq(prev_s_val, s_val) == 1 do
                    found_off = vec_get_rt(pool_offsets, pfi)
                    pbi = vec_len_rt(str_bucket)
                end
                pbi = pbi + 1
            end
            if found_off < 0 do
                found_off = codebuf_offset(cb) as i64
                var bi = 0
                when bi < s_len loop
                    b_ch = native_read_u8(s_data, bi)
                    cb = codebuf_emit_byte(cb, b_ch)
                    bi = bi + 1
                end
                cb = codebuf_emit_byte(cb, 0)
                str_bucket = vec_push_rt(str_bucket, sfi)
                vec_set_rt(str_pool_buckets, str_bid, str_bucket)
            end
            pool_offsets = vec_push_rt(pool_offsets, found_off)
            sfi = sfi + 1
        end

        pad = (4 - (codebuf_offset(cb) mod 4)) mod 4
        var pi = 0
        when pi < pad loop
            cb = codebuf_emit_byte(cb, 0)
            pi = pi + 1
        end

        sfi = 0
        when sfi < n_sfx loop
            sfx = vec_get_rt(str_fixups, sfi)
            s_at = native_read_i64(sfx as i64, 0)
            s_rd = native_read_i64(sfx as i64, 16)
            s_target = vec_get_rt(pool_offsets, sfi)

            va_pc = va_base + s_at
            va_target = va_base + s_target

            pc_page = va_pc and (0 - 4096)
            target_page = va_target and (0 - 4096)
            page_delta = target_page - pc_page
            page_imm = ((page_delta - (page_delta mod 4096)) / 4096) and 0x1FFFFF
            immlo = page_imm and 3
            immhi = (page_imm shr 2) and 0x7FFFF
            adrp_word = 0x90000000 or (immlo shl 29) or (immhi shl 5) or (s_rd as int and 0x1F)
            cb = codebuf_patch_u32(cb, s_at as int, adrp_word as int)

            lo12 = va_target and 0xFFF
            add_word = 0x91000000 or ((lo12 as int) shl 10) or ((s_rd as int and 0x1F) shl 5) or (s_rd as int and 0x1F)
            cb = codebuf_patch_u32(cb, (s_at + 4) as int, add_word as int)

            sfi = sfi + 1
        end
    end

    out cb
end.

# Single-func helper → module path.
func emit_lir_arm64(func_obj: LirFunc, assigned_phys: i64, assigned_stack: i64, is_linux: i64):
    funcs = vec_new_rt()
    funcs = vec_push_rt(funcs, func_obj)
    out emit_lir_module_arm64(funcs, is_linux)
end.

export emit_lir_arm64, emit_lir_module_arm64, emit_lir_arm64_into
export emit_lir_intrinsic, emit_lir_setarg, emit_lir_rt_stubs
export lir_intr_is_marker, lir_intr_is_identity, lir_intr_is_payload
export lir_fixup_new, lir_fixup_at_off, lir_fixup_target_block, lir_fixup_kind
export lir_call_fixup_new, lir_stub_for_builtin_id
export patch_bl_site, lir_find_func_index
