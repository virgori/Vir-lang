##
 * vir/compiler/lir_codegen.vri — LIR to Machine Code (ARM64)
 * ==============================================================
 * AAPCS64 soft ABI:
 *   SetArg 0..7 → MOV X0..X7
 *   SetArg ≥8  → push 16-byte slots; Call pops them
 *   Call       → BL patched to func offs / RT unresolved
 *   Intrinsic  → marker/payload inline; else BL → RT stub[kind]
 *   Pow/ML     → BL → RT stub[61..63]
 *
 * Module: emit_lir_module_arm64 — funcs + RT stubs + BL patch + _start.
 ##

include types
include vec_rt
import vec_new_rt, vec_push_rt, vec_get_rt, vec_set_rt, vec_len_rt from vec_rt
include string_rt
import rt_streq, fat_str_eq, fat_cstr_eq, fat_str_new, sb_new, sb_append, sb_append_int, sb_to_string, sb_free, native_read_i64, native_write_i64, native_read_u8 from string_rt
include compiler.context
import print_str, print_int from compiler.context
include compiler.lir
import LirOp, LirOperandType, LirOperand, LirInstr, LirBlock, LirFunc, lir_func_id, lir_func_name, lir_func_blocks, lir_func_stack_size, lir_func_strings, lir_block_id, lir_block_instrs, lir_instr_op, lir_instr_dst, lir_instr_src1, lir_instr_src2, lir_instr_aux, lir_instr_typ, lir_opnd_type, lir_opnd_vreg, lir_opnd_imm_val, lir_opnd_label_id, lir_opnd_phys_reg_val, lir_opnd_stack_offset, LIR_CMP_EQ, LIR_CMP_NE, LIR_CMP_GT, LIR_CMP_LT, LIR_CMP_GE, LIR_CMP_LE, LIR_JMP_IF, LIR_JMP_IFNOT, LIR_RT_UNRESOLVED, LIR_RT_POW, LIR_RT_MATMUL, LIR_RT_FMA, LIR_RT_ALLOC, LIR_RT_PRINT_STR, LIR_RT_GET_ARG, LIR_RT_ARG_COUNT, LIR_RT_NATIVE_READ_U8, LIR_RT_NATIVE_WRITE_U8, LIR_RT_NATIVE_READ_I64, LIR_RT_NATIVE_WRITE_I64, LIR_RT_VOLATILE_READ, LIR_RT_VOLATILE_WRITE, LIR_RT_VOLATILE_READ8, LIR_RT_VOLATILE_WRITE8, LIR_RT_DMB, LIR_RT_DSB, LIR_RT_ISB, LIR_RT_WFI, LIR_RT_WFE, LIR_RT_SEV, LIR_RT_NOP, LIR_RT_SYSCALL, LIR_RT_PORT_CREATE, LIR_RT_PORT_SEND, LIR_RT_PORT_RECV, LIR_RT_ARR_NEW, LIR_RT_ARR_PUSH, LIR_RT_ARR_LEN, LIR_RT_STUB_COUNT from compiler.lir
include compiler.mir
import MIR_INTR_PRINT, MIR_INTR_PRINT_STR, MIR_INTR_PARAM, MIR_INTR_GLOBAL_LOAD, MIR_INTR_GLOBAL_STORE, MIR_INTR_ADDR_OF, MIR_INTR_CAST, MIR_INTR_NOP_MARKER, MIR_INTR_DECL, MIR_INTR_QUIET, MIR_INTR_CHECK_CPU, MIR_INTR_PATCH_POINT, MIR_INTR_PRECOMP, MIR_INTR_EXPOSE, MIR_INTR_ASYNC, MIR_INTR_ATOMIC_VAR, MIR_INTR_TIMEOUT, MIR_INTR_ISOLATE, MIR_INTR_PTR, MIR_INTR_AWAIT_PASS, MIR_INTR_ENSURE, MIR_INTR_REVERT, MIR_INTR_STR_LIT, MIR_INTR_INTERP, MIR_INTR_ENUM, MIR_INTR_ERROR, MIR_INTR_EXIST, MIR_INTR_BUILTIN, MIR_INTR_INDEX, MIR_INTR_INDEX_STORE, MIR_INTR_FIELD, MIR_INTR_FIELD_STORE, MIR_INTR_ARRAY, MIR_INTR_ENTITY, MIR_INTR_TUPLE, MIR_INTR_BUNDLE, MIR_INTR_INFER, MIR_INTR_TRAIN, MIR_INTR_REACTIVE, MIR_INTR_MORPH, MIR_INTR_QUANTIZE from compiler.mir
include compiler.codegen
import codebuf_new, codebuf_emit_u32, codebuf_emit_byte, codebuf_offset, codebuf_patch_u32, TargetArch, CodeBuf from compiler.codegen
import arm64_add_rrr, arm64_sub_rrr, arm64_mul_rrr, arm64_sdiv_rrr, arm64_madd_rrrr, arm64_msub_rrrr, arm64_mov_rr, arm64_movz_imm64, arm64_mov_from_sp, arm64_ldr_post, arm64_str_pre, arm64_ret, arm64_nop, arm64_cmp_rr, arm64_cset_eq, arm64_cset_ne, arm64_cset_gt, arm64_cset_lt, arm64_cset_ge, arm64_cset_le, arm64_b_imm26, arm64_beq_imm19, arm64_bne_imm19, arm64_bge_imm19, arm64_blt_imm19, arm64_bgt_imm19, arm64_ble_imm19, arm64_bl_imm26, arm64_add_imm, arm64_sub_imm, arm64_and_rrr, arm64_orr_rrr, arm64_eor_rrr, arm64_lsl_rrr, arm64_lsr_rrr, arm64_lsl_imm, arm64_lsr_imm, arm64_mvn_rr, arm64_stp_pre, arm64_ldp_post, arm64_svc, arm64_blr, arm64_mov_imm16, arm64_str_uoff, arm64_ldr_uoff, arm64_str_reg, arm64_ldr_reg, arm64_strb_reg, arm64_ldrb_reg, arm64_strb_uoff, arm64_ldrb_uoff, arm64_ldr_reg_lsl3, arm64_str_reg_lsl3, arm64_csel_rrr, arm64_cbz_imm19, arm64_cbnz_imm19, arm64_cmp_imm0, arm64_ubfx, arm64_bfi, arm64_dmb_ishld, arm64_dmb_ishst, arm64_dmb_sy, arm64_dsb_sy, arm64_isb, arm64_wfi, arm64_wfe, arm64_sev, arm64_clz, arm64_rbit, arm64_rev, arm64_brk, arm64_ror_imm32, arm64_eor_lsr32, arm64_eor_lsr64 from compiler.codegen

func vec_new_cap_rt(cap: int):
    base = alloc(16 + cap * 8)
    data = base + 16
    native_write_i64(base, 0, cap as i64)
    native_write_i64(base, 8, 0)
    out data
end.

func lir_fixup_new(at_off: i64, target_block: i64, kind: i64):
    p = alloc(24)
    native_write_i64(p, 0, at_off)
    native_write_i64(p, 8, target_block)
    native_write_i64(p, 16, kind)
    out p
end.

func lir_fixup_at_off(fx: LirFixup): out native_read_i64(fx as i64, 0) end.
func lir_fixup_target_block(fx: LirFixup): out native_read_i64(fx as i64, 8) end.
func lir_fixup_kind(fx: LirFixup): out native_read_i64(fx as i64, 16) end.

func lir_call_fixup_new(at_off: i64, target_kind: i64, target_id: i64, rd: i64):
    p = alloc(32)
    native_write_i64(p, 0, at_off)
    native_write_i64(p, 8, target_kind)
    native_write_i64(p, 16, target_id)
    native_write_i64(p, 24, rd)
    out p
end.

func lir_str_fixup_new(at_off: i64, str_val: i64, rd: i64):
    p = alloc(24)
    native_write_i64(p, 0, at_off)
    native_write_i64(p, 8, str_val)
    native_write_i64(p, 16, rd)
    out p
end.

func resolve_reg(opnd: LirOperand, assigned_phys: i64):
    if (opnd as i64) == 0 do
        out 0 - 1
    end
    typ = native_read_i64(opnd as i64, 0)
    if typ == 1 or typ == 2 do
        if assigned_phys >= 0 do
            vid = native_read_i64(opnd as i64, 8)
            if vid >= 0 and vid < vec_len_rt(assigned_phys) do
                col = vec_get_rt(assigned_phys, vid)
                if col >= 0 and col < 9 do
                    out (col + 19)
                end
                out col
            end
        end
        out native_read_i64(opnd as i64, 8)
    end
    if typ == 3 do # PhysReg
        out native_read_i64(opnd as i64, 16)
    end
    out 0 - 1
end.

func emit_fp_sub_addr(cb: CodeBuf, rd: i64, distance: i64):
    # ARM64 SUB (immediate) only carries 12 immediate bits. Large frames must
    # materialize the full distance or offsets such as 4096 alias FP+0 and
    # overwrite the frame header/callee-save area.
    if distance <= 4095 do
        out arm64_sub_imm(cb, rd as int, 29, distance as int)
    end
    cb = arm64_movz_imm64(cb, rd as int, distance as int)
    out arm64_sub_rrr(cb, rd as int, 29, rd as int)
end.

func resolve_or_imm_reg(cb: CodeBuf, opnd: LirOperand, assigned_phys: i64, scratch: i64):
    if (opnd as i64) == 0 do
        out scratch
    end
    r = resolve_reg(opnd, assigned_phys)
    if r >= 0 do
        out r
    end
    typ = native_read_i64(opnd as i64, 0)
    if typ == 5 do # Imm
        imm_val = native_read_i64(opnd as i64, 32)
        cb = arm64_movz_imm64(cb, scratch as int, imm_val as int)
        out scratch
    end
    if typ == 4 do # StackMem
        off = native_read_i64(opnd as i64, 24)
        if off < 0 and off >= 0 - 255 do
            cb = arm64_ldur(cb, scratch as int, 29, off as int)
            out scratch
        else
            if off < 0 do
                cb = emit_fp_sub_addr(cb, scratch, 0 - off)
                cb = arm64_ldr_uoff(cb, scratch as int, scratch as int, 0)
                out scratch
            end
        end
    end
    if typ == 3 do # PhysReg
        out native_read_i64(opnd as i64, 16)
    end
    out scratch
end.

func lir_opnd_spill_off(opnd: i64):
    # Returns the negative stack offset if `opnd` is a StackMem slot, else 0.
    if opnd == 0 do
        out 0
    end
    if native_read_i64(opnd, 0) == 4 do
        out native_read_i64(opnd, 24)
    end
    out 0
end.

func robust_src_reg(cb: CodeBuf, opnd: i64, assigned_phys: i64, scratch: i64):
    # Like resolve_reg, but transparently reloads a spilled (StackMem) source
    # into `scratch` so every consumer sees a real register.
    if opnd == 0 do
        out 0 - 1
    end
    r = resolve_reg(opnd as LirOperand, assigned_phys)
    if r >= 0 do
        out r
    end
    if native_read_i64(opnd, 0) == 4 or native_read_i64(opnd, 0) == 5 do
        out resolve_or_imm_reg(cb, opnd as LirOperand, assigned_phys, scratch)
    end
    out r
end.

func lir_load_opnd_to_reg(cb: CodeBuf, opnd: i64, assigned_phys: i64, scratch: i64):
    if opnd == 0 do
        out (cb, scratch)
    end
    typ = native_read_i64(opnd, 0)
    if typ == 5 do # Imm
        cb = arm64_movz_imm64(cb, scratch as int, native_read_i64(opnd, 32) as int)
        out (cb, scratch)
    end
    if typ == 4 do # StackMem
        off = native_read_i64(opnd, 24)
        if off < 0 and off >= 0 - 255 do
            cb = arm64_ldur(cb, scratch as int, 29, off as int)
        else
            if off < 0 do
                cb = emit_fp_sub_addr(cb, scratch, 0 - off)
                cb = arm64_ldr_uoff(cb, scratch as int, scratch as int, 0)
            end
        end
        out (cb, scratch)
    end
    if typ == 3 do # PhysReg
        out (cb, native_read_i64(opnd, 16))
    end
    r = resolve_reg(opnd as LirOperand, assigned_phys)
    if r >= 0 do
        out (cb, r)
    end
    out (cb, scratch)
end.

func emit_spill_store(cb: CodeBuf, opnd: i64, src_reg: i64):
    off = lir_opnd_spill_off(opnd)
    if off < 0 and off >= 0 - 255 do
        cb = arm64_stur(cb, src_reg as int, 29, off as int)
    else
        if off < 0 do
            cb = emit_fp_sub_addr(cb, 13, 0 - off)
            cb = arm64_str_uoff(cb, src_reg as int, 13, 0)
        end
    end
    out cb
end.

func emit_cmp_cset(cb: CodeBuf, rd: i64, rs1: i64, rs2: i64, pred: i64):
    cb = arm64_cmp_rr(cb, rs1 as int, rs2 as int)
    if pred == LIR_CMP_EQ do
        out arm64_cset_eq(cb, rd as int)
    eif pred == LIR_CMP_NE do
        out arm64_cset_ne(cb, rd as int)
    eif pred == LIR_CMP_GT do
        out arm64_cset_gt(cb, rd as int)
    eif pred == LIR_CMP_LT do
        out arm64_cset_lt(cb, rd as int)
    eif pred == LIR_CMP_GE do
        out arm64_cset_ge(cb, rd as int)
    eif pred == LIR_CMP_LE do
        out arm64_cset_le(cb, rd as int)
    end
    out arm64_cset_eq(cb, rd as int)
end.

func arm64_cond_code(pred: i64, is_ifnot: i64):
    if is_ifnot == 0 do
        if pred == LIR_CMP_EQ do out 0 end    # EQ (0x0)
        if pred == LIR_CMP_NE do out 1 end    # NE (0x1)
        if pred == LIR_CMP_GE do out 10 end   # GE (0xA)
        if pred == LIR_CMP_LT do out 11 end   # LT (0xB)
        if pred == LIR_CMP_GT do out 12 end   # GT (0xC)
        if pred == LIR_CMP_LE do out 13 end   # LE (0xD)
        out 0
    end
    # Inverted condition (IFNOT)
    if pred == LIR_CMP_EQ do out 1 end        # NE (0x1)
    if pred == LIR_CMP_NE do out 0 end        # EQ (0x0)
    if pred == LIR_CMP_GE do out 11 end       # LT (0xB)
    if pred == LIR_CMP_LT do out 10 end       # GE (0xA)
    if pred == LIR_CMP_GT do out 13 end       # LE (0xD)
    if pred == LIR_CMP_LE do out 12 end       # GT (0xC)
    out 1
end.

func lir_opnd_matches(o1: i64, o2: i64):
    if o1 == 0 or o2 == 0 do out 0 end
    t1 = native_read_i64(o1, 0)
    t2 = native_read_i64(o2, 0)
    if t1 != t2 do out 0 end
    if t1 == 1 do
        v1 = native_read_i64(o1, 8)
        v2 = native_read_i64(o2, 8)
        if v1 == v2 do out 1 end
    end
    if t1 == 2 do
        v1 = native_read_i64(o1, 16)
        v2 = native_read_i64(o2, 16)
        if v1 == v2 do out 1 end
    end
    out 0
end.

func arm64_and_mask(cb: CodeBuf, rd: int, rn: int, mask: i64):
    if mask == 255 do       # 0xFF (8-bit) -> uxtb w_rd, w_rn
        out codebuf_emit_u32(cb, 0x53001C00 or ((rn and 0x1F) shl 5) or (rd and 0x1F))
    end
    if mask == 4095 do      # 0xFFF (12-bit) -> ubfx w_rd, w_rn, #0, #12
        out codebuf_emit_u32(cb, 0x53002C00 or ((rn and 0x1F) shl 5) or (rd and 0x1F))
    end
    if mask == 65535 do     # 0xFFFF (16-bit) -> uxth w_rd, w_rn
        out codebuf_emit_u32(cb, 0x53003C00 or ((rn and 0x1F) shl 5) or (rd and 0x1F))
    end
    if mask == 4294967295 do # 0xFFFFFFFF (32-bit) -> mov w_rd, w_rn (ORR Wd, WZR, Wn)
        out codebuf_emit_u32(cb, 0x2A0003E0 or ((rn and 0x1F) shl 16) or (rd and 0x1F))
    end
    out cb
end.

# ── ARM64 NEON 128-bit SIMD Emitters ──────────────────────────────
func arm64_neon_ld1_2d(cb: CodeBuf, vt: int, xn: int):
    # LD1 {Vt.2D}, [Xn] -> 0x4C407000 | (Xn << 5) | Vt
    out codebuf_emit_u32(cb, 0x4C407000 or ((xn and 0x1F) shl 5) or (vt and 0x1F))
end.

func arm64_neon_st1_2d(cb: CodeBuf, vt: int, xn: int):
    # ST1 {Vt.2D}, [Xn] -> 0x4C007000 | (Xn << 5) | Vt
    out codebuf_emit_u32(cb, 0x4C007000 or ((xn and 0x1F) shl 5) or (vt and 0x1F))
end.

func arm64_neon_ld1_4s(cb: CodeBuf, vt: int, xn: int):
    # LD1 {Vt.4S}, [Xn] -> 0x4C402000 | (Xn << 5) | Vt
    out codebuf_emit_u32(cb, 0x4C402000 or ((xn and 0x1F) shl 5) or (vt and 0x1F))
end.

func arm64_neon_st1_4s(cb: CodeBuf, vt: int, xn: int):
    # ST1 {Vt.4S}, [Xn] -> 0x4C002000 | (Xn << 5) | Vt
    out codebuf_emit_u32(cb, 0x4C002000 or ((xn and 0x1F) shl 5) or (vt and 0x1F))
end.

func arm64_neon_add_2d(cb: CodeBuf, vd: int, vn: int, vm: int):
    # ADD Vd.2D, Vn.2D, Vm.2D -> 0x4EE08400 | (Vm << 16) | (Vn << 5) | Vd
    out codebuf_emit_u32(cb, 0x4EE08400 or ((vm and 0x1F) shl 16) or ((vn and 0x1F) shl 5) or (vd and 0x1F))
end.

func arm64_neon_sub_2d(cb: CodeBuf, vd: int, vn: int, vm: int):
    # SUB Vd.2D, Vn.2D, Vm.2D -> 0x4EE08C00 | (Vm << 16) | (Vn << 5) | Vd
    out codebuf_emit_u32(cb, 0x4EE08C00 or ((vm and 0x1F) shl 16) or ((vn and 0x1F) shl 5) or (vd and 0x1F))
end.

func arm64_neon_eor_16b(cb: CodeBuf, vd: int, vn: int, vm: int):
    # EOR Vd.16B, Vn.16B, Vm.16B -> 0x6E201C00 | (Vm << 16) | (Vn << 5) | Vd
    out codebuf_emit_u32(cb, 0x6E201C00 or ((vm and 0x1F) shl 16) or ((vn and 0x1F) shl 5) or (vd and 0x1F))
end.

func arm64_neon_orr_16b(cb: CodeBuf, vd: int, vn: int, vm: int):
    # ORR Vd.16B, Vn.16B, Vm.16B -> 0x4EA01C00 | (Vm << 16) | (Vn << 5) | Vd
    out codebuf_emit_u32(cb, 0x4EA01C00 or ((vm and 0x1F) shl 16) or ((vn and 0x1F) shl 5) or (vd and 0x1F))
end.

func arm64_neon_and_16b(cb: CodeBuf, vd: int, vn: int, vm: int):
    # AND Vd.16B, Vn.16B, Vm.16B -> 0x4E201C00 | (Vm << 16) | (Vn << 5) | Vd
    out codebuf_emit_u32(cb, 0x4E201C00 or ((vm and 0x1F) shl 16) or ((vn and 0x1F) shl 5) or (vd and 0x1F))
end.

func arm64_neon_fmla_4s(cb: CodeBuf, vd: int, vn: int, vm: int):
    # FMLA Vd.4S, Vn.4S, Vm.4S -> 0x4E20CC00 | (Vm << 16) | (Vn << 5) | Vd
    out codebuf_emit_u32(cb, 0x4E20CC00 or ((vm and 0x1F) shl 16) or ((vn and 0x1F) shl 5) or (vd and 0x1F))
end.

func arm64_neon_fmla_2d(cb: CodeBuf, vd: int, vn: int, vm: int):
    # FMLA Vd.2D, Vn.2D, Vm.2D -> 0x4EE0CC00 | (Vm << 16) | (Vn << 5) | Vd
    out codebuf_emit_u32(cb, 0x4EE0CC00 or ((vm and 0x1F) shl 16) or ((vn and 0x1F) shl 5) or (vd and 0x1F))
end.

func arm64_neon_dup_2d_gpr(cb: CodeBuf, vd: int, xn: int):
    # DUP Vd.2D, Xn -> 0x4E080C00 | ((xn & 0x1F) << 5) | (vd & 0x1F)
    out codebuf_emit_u32(cb, 0x4E080C00 or ((xn and 0x1F) shl 5) or (vd and 0x1F))
end.

# ── Apple AMX (Apple Matrix Coprocessor) Direct Emitters ───────────
func arm64_amx_set(cb: CodeBuf):
    # AMXSET -> Enable AMX hardware coprocessor
    out codebuf_emit_u32(cb, 0x00201000)
end.

func arm64_amx_clr(cb: CodeBuf):
    # AMXCLR -> Disable / Clear AMX coprocessor state
    out codebuf_emit_u32(cb, 0x00201020)
end.

func arm64_amx_ldx(cb: CodeBuf, xn: int):
    # AMX_LDX Xn -> Load 64-byte row from [Xn] into Matrix X
    out codebuf_emit_u32(cb, 0x00201000 or (xn and 0x1F))
end.

func arm64_amx_ldy(cb: CodeBuf, xn: int):
    # AMX_LDY Xn -> Load 64-byte column from [Xn] into Matrix Y
    out codebuf_emit_u32(cb, 0x00201020 or (xn and 0x1F))
end.

func arm64_amx_fma64(cb: CodeBuf, xn: int):
    # AMX_FMA64 Xn -> Outer-product FP64 multiply-accumulate: Z += X (x) Y
    out codebuf_emit_u32(cb, 0x00201180 or (xn and 0x1F))
end.

func arm64_amx_stz(cb: CodeBuf, xn: int):
    # AMX_STZ Xn -> Store Matrix Z accumulator tile to [Xn]
    out codebuf_emit_u32(cb, 0x00201080 or (xn and 0x1F))
end.

func arm64_cmp_imm(cb: CodeBuf, rn: int, imm: int):
    instr = 0xF100001F or ((imm and 0xFFF) shl 10) or ((rn and 0x1F) shl 5)
    out codebuf_emit_u32(cb, instr)
end.

func is_opnd_used_later(instrs: i64, start_idx: i64, n_instrs: i64, target_opnd: i64):
    var idx = start_idx
    when idx < n_instrs loop
        ins = vec_get_rt(instrs, idx)
        s1 = native_read_i64(ins as i64, 24)
        s2 = native_read_i64(ins as i64, 32)
        if lir_opnd_matches(target_opnd, s1) == 1 or lir_opnd_matches(target_opnd, s2) == 1 do
            out 1
        end
        d = native_read_i64(ins as i64, 16)
        if lir_opnd_matches(target_opnd, d) == 1 do
            out 0
        end
        idx = idx + 1
    end
    out 0
end.

func is_inlined_imm_consumer(instrs: i64, ii: i64, n_instrs: i64, imm_dst: i64, imm_val: i64):
    if (ii + 1) >= n_instrs do
        out 0
    end
    next_ins = vec_get_rt(g_codegen_cur_instrs, ii + 1)
    next_op = native_read_i64(next_ins as i64, 0)
    next_src1 = native_read_i64(next_ins as i64, 24)
    next_src2 = native_read_i64(next_ins as i64, 32)
    if (next_op == (LirOp.Add as i64) or next_op == (LirOp.Sub as i64) or next_op == (LirOp.Cmp as i64)) and imm_val >= 0 and imm_val <= 4095 do
        if lir_opnd_matches(imm_dst, next_src2) == 1 or lir_opnd_matches(imm_dst, next_src1) == 1 do
            if is_opnd_used_later(instrs, ii + 2, n_instrs, imm_dst) == 0 do
                out 1
            end
        end
    end
    if next_op == (LirOp.And as i64) and (imm_val == 255 or imm_val == 4095 or imm_val == 65535 or imm_val == 4294967295) do
        if lir_opnd_matches(imm_dst, next_src2) == 1 or lir_opnd_matches(imm_dst, next_src1) == 1 do
            if is_opnd_used_later(instrs, ii + 2, n_instrs, imm_dst) == 0 do
                out 1
            end
        end
    end
    out 0
end.

func is_inlined_builtin_arg(instrs: i64, ii: i64, n_instrs: i64):
    var k = 1
    when k <= 4 loop
        if (ii + k) < n_instrs do
            target_ins = vec_get_rt(instrs, ii + k)
            top = native_read_i64(target_ins as i64, 0)
            if top == (LirOp.Intrinsic as i64) do
                tkind = native_read_i64(target_ins as i64, 40)
                if tkind == MIR_INTR_BUILTIN do
                    tsrc1 = native_read_i64(target_ins as i64, 24)
                    if (tsrc1 as i64) != 0 do
                        tbid = native_read_i64(tsrc1 as i64, 32)
                        if tbid == 3 or tbid == 5 or tbid == 6 or tbid == 7 or tbid == 8 or tbid == 32 do
                            out 1
                        end
                    end
                end
            end
            if top != (LirOp.SetArg as i64) and top != (LirOp.Mov as i64) do
                out 0
            end
        end
        k = k + 1
    end
    out 0
end.

func lir_intr_is_marker(kind: i64):
    if kind == MIR_INTR_NOP_MARKER or kind == MIR_INTR_DECL or kind == MIR_INTR_QUIET or kind == MIR_INTR_CHECK_CPU or kind == MIR_INTR_PATCH_POINT or kind == MIR_INTR_PRECOMP or kind == MIR_INTR_EXPOSE or kind == MIR_INTR_ASYNC or kind == MIR_INTR_ATOMIC_VAR or kind == MIR_INTR_TIMEOUT or kind == MIR_INTR_ISOLATE or kind == MIR_INTR_PTR or kind == MIR_INTR_AWAIT_PASS or kind == MIR_INTR_ENSURE or kind == MIR_INTR_REVERT or kind == MIR_INTR_ENUM or kind == MIR_INTR_ERROR or kind == MIR_INTR_EXIST or kind == MIR_INTR_INFER or kind == MIR_INTR_TRAIN or kind == MIR_INTR_REACTIVE or kind == MIR_INTR_MORPH or kind == MIR_INTR_QUANTIZE or kind == MIR_INTR_TRY or kind == MIR_INTR_RESUME or kind == MIR_INTR_EMIT do
        out 1
    end
    out 0
end.

func lir_intr_is_payload(kind: i64):
    if kind == MIR_INTR_CAST do
        out 1
    end
    out 0
end.

func lir_stub_for_builtin_id(bid: i64):
    if bid == 3 or bid == 35 or bid == 49 or bid == 50 do out LIR_RT_ALLOC end
    if bid == 22 do out LIR_RT_PRINT_STR end
    if bid == 9 do out LIR_RT_STR_LEN end
    if bid == 11 do out LIR_RT_STR_CAT end
    if bid == 12 do out LIR_RT_STR_EQ end
    if bid == 19 do out LIR_RT_INT_TO_STR end
    if bid == 25 do out LIR_RT_SLURP_FILE end
    if bid == 26 do out LIR_RT_SLURP_LEN end
    if bid == 27 do out LIR_RT_WRITE_BYTES end
    if bid == 5 do out LIR_RT_NATIVE_READ_U8 end
    if bid == 6 do out LIR_RT_NATIVE_WRITE_U8 end
    if bid == 7 or bid == 46 do out LIR_RT_NATIVE_READ_I64 end
    if bid == 8 or bid == 47 do out LIR_RT_NATIVE_WRITE_I64 end
    if bid == 23 do out LIR_RT_GET_ARG end
    if bid == 24 do out LIR_RT_ARG_COUNT end
    if bid == 54 or bid == 60 or bid == 62 do out LIR_RT_VOLATILE_READ end
    if bid == 55 or bid == 61 or bid == 63 do out LIR_RT_VOLATILE_WRITE end
    if bid == 56 or bid == 58 do out LIR_RT_VOLATILE_READ8 end
    if bid == 57 or bid == 59 do out LIR_RT_VOLATILE_WRITE8 end
    if bid == 64 or bid == 39 do out LIR_RT_DMB end
    if bid == 65 do out LIR_RT_DSB end
    if bid == 66 do out LIR_RT_ISB end
    if bid == 67 do out LIR_RT_WFI end
    if bid == 68 do out LIR_RT_WFE end
    if bid == 69 do out LIR_RT_SEV end
    if bid == 70 do out LIR_RT_NOP end
    if bid == 40 or bid == 78 do out LIR_RT_ATOMIC_LOAD64 end
    if bid == 72 do out LIR_RT_ATOMIC_LOAD32 end
    if bid == 41 or bid == 79 do out LIR_RT_ATOMIC_STORE64 end
    if bid == 73 do out LIR_RT_ATOMIC_STORE32 end
    if bid == 43 or bid == 80 do out LIR_RT_ATOMIC_ADD64 end
    if bid == 74 do out LIR_RT_ATOMIC_ADD32 end
    if bid == 44 or bid == 81 do out LIR_RT_ATOMIC_SUB64 end
    if bid == 75 do out LIR_RT_ATOMIC_SUB32 end
    if bid == 30 do out LIR_RT_SYSCALL end
    if bid == 42 or bid == 82 do out LIR_RT_ATOMIC_CAS64 end
    if bid == 76 do out LIR_RT_ATOMIC_CAS32 end
    if bid == 71 or bid == 83 do out LIR_RT_ATOMIC_EXCHANGE64 end
    if bid == 1 or bid == 20 do out LIR_RT_ARR_LEN end
    if bid == 2 do out LIR_RT_ARR_PUSH end
    if bid == 21 do out LIR_RT_ARR_NEW end
    if bid == 90 do out LIR_RT_PORT_CREATE end
    if bid == 18 do out LIR_RT_EXIT_PROG end
    if bid == 105 do out LIR_RT_PLATFORM end
    out 0 - 1
end.

func lir_stub_for_callee_name(cname: string):
    if fat_cstr_eq(cname, "read_byte") or fat_cstr_eq(cname, "native_read_u8") or fat_cstr_eq(cname, "read_u8") or fat_cstr_eq(cname, "read8") or rt_streq(cname as int, "read_byte") or rt_streq(cname as int, "native_read_u8") or rt_streq(cname as int, "read_u8") or rt_streq(cname as int, "read8") do out LIR_RT_NATIVE_READ_U8 end
    if fat_cstr_eq(cname, "write_byte") or fat_cstr_eq(cname, "native_write_u8") or fat_cstr_eq(cname, "write_u8") or fat_cstr_eq(cname, "write8") or rt_streq(cname as int, "write_byte") or rt_streq(cname as int, "native_write_u8") or rt_streq(cname as int, "write_u8") or rt_streq(cname as int, "write8") do out LIR_RT_NATIVE_WRITE_U8 end
    if fat_cstr_eq(cname, "read_word") or fat_cstr_eq(cname, "native_read_i64") or fat_cstr_eq(cname, "read_i64") or fat_cstr_eq(cname, "read64") or rt_streq(cname as int, "read_word") or rt_streq(cname as int, "native_read_i64") or rt_streq(cname as int, "read_i64") or rt_streq(cname as int, "read64") do out LIR_RT_NATIVE_READ_I64 end
    if fat_cstr_eq(cname, "write_word") or fat_cstr_eq(cname, "native_write_i64") or fat_cstr_eq(cname, "write_i64") or fat_cstr_eq(cname, "write64") or rt_streq(cname as int, "write_word") or rt_streq(cname as int, "native_write_i64") or rt_streq(cname as int, "write_i64") or rt_streq(cname as int, "write64") do out LIR_RT_NATIVE_WRITE_I64 end
    if fat_cstr_eq(cname, "get_arg") or fat_cstr_eq(cname, "rt_argv") or fat_cstr_eq(cname, "rt_get_arg") or rt_streq(cname as int, "get_arg") or rt_streq(cname as int, "rt_argv") or rt_streq(cname as int, "rt_get_arg") do out LIR_RT_GET_ARG end
    if fat_cstr_eq(cname, "arg_count") or fat_cstr_eq(cname, "rt_argc") or rt_streq(cname as int, "arg_count") or rt_streq(cname as int, "rt_argc") do out LIR_RT_ARG_COUNT end
    if fat_cstr_eq(cname, "alloc") or fat_cstr_eq(cname, "vir_alloc") or rt_streq(cname as int, "alloc") or rt_streq(cname as int, "vir_alloc") do out LIR_RT_ALLOC end
    if fat_cstr_eq(cname, "print_str") or rt_streq(cname as int, "print_str") do out LIR_RT_PRINT_STR end
    if fat_cstr_eq(cname, "str_len") or rt_streq(cname as int, "str_len") do out LIR_RT_STR_LEN end
    if fat_cstr_eq(cname, "str_cat") or fat_cstr_eq(cname, "str_concat") or fat_cstr_eq(cname, "strcat") or rt_streq(cname as int, "str_cat") or rt_streq(cname as int, "str_concat") or rt_streq(cname as int, "strcat") do out LIR_RT_STR_CAT end
    if fat_cstr_eq(cname, "str_eq") or rt_streq(cname as int, "str_eq") do out LIR_RT_STR_EQ end
    if fat_cstr_eq(cname, "write_bytes") or rt_streq(cname as int, "write_bytes") do out LIR_RT_WRITE_BYTES end
    if fat_cstr_eq(cname, "slurp_len") or rt_streq(cname as int, "slurp_len") do out LIR_RT_SLURP_LEN end
    if fat_cstr_eq(cname, "slurp_file") or rt_streq(cname as int, "slurp_file") do out LIR_RT_SLURP_FILE end
    if fat_cstr_eq(cname, "int_to_str") or fat_cstr_eq(cname, "i_to_str") or fat_cstr_eq(cname, "itoa") or rt_streq(cname as int, "int_to_str") or rt_streq(cname as int, "i_to_str") or rt_streq(cname as int, "itoa") do out LIR_RT_INT_TO_STR end
    if fat_cstr_eq(cname, "syscall") or fat_cstr_eq(cname, "__syscall") or rt_streq(cname as int, "syscall") or rt_streq(cname as int, "__syscall") do out LIR_RT_SYSCALL end
    if fat_cstr_eq(cname, "exit_prog") or fat_cstr_eq(cname, "exit") or rt_streq(cname as int, "exit_prog") or rt_streq(cname as int, "exit") do out LIR_RT_EXIT_PROG end
    if fat_cstr_eq(cname, "vir_get_platform") or fat_cstr_eq(cname, "sys_platform") or rt_streq(cname as int, "vir_get_platform") or rt_streq(cname as int, "sys_platform") do out LIR_RT_PLATFORM end
    if fat_cstr_eq(cname, "port") or rt_streq(cname as int, "port") do out LIR_RT_PORT_CREATE end
    if fat_cstr_eq(cname, "send") or rt_streq(cname as int, "send") do out LIR_RT_PORT_SEND end
    if fat_cstr_eq(cname, "recv") or rt_streq(cname as int, "recv") do out LIR_RT_PORT_RECV end
    if fat_cstr_eq(cname, "arr_new") or rt_streq(cname as int, "arr_new") do out LIR_RT_ARR_NEW end
    if fat_cstr_eq(cname, "push") or fat_cstr_eq(cname, "arr_push") or rt_streq(cname as int, "push") or rt_streq(cname as int, "arr_push") do out LIR_RT_ARR_PUSH end
    if fat_cstr_eq(cname, "len") or fat_cstr_eq(cname, "arr_len") or rt_streq(cname as int, "len") or rt_streq(cname as int, "arr_len") do out LIR_RT_ARR_LEN end
    out 0 - 1
end.

func lir_intr_is_identity(kind: i64):
    out lir_intr_is_payload(kind)
end.

func patch_bl_site(cb: CodeBuf, at_off: i64, dest_off: i64):
    rel = (dest_off - at_off) as int
    imm26 = (rel shr 2) and 0x03FFFFFF
    word = 0x94000000 or imm26
    out codebuf_patch_u32(cb, at_off as int, word)
end.

func emit_bl_fixup(cb: CodeBuf, call_fixups: i64, target_kind: i64, target_id: i64, rd: i64):
    at = codebuf_offset(cb) as i64
    cb = arm64_bl_imm26(cb, 0)
    cf = native_read_i64(call_fixups, 0)
    cf = vec_push_rt(cf, lir_call_fixup_new(at, target_kind, target_id, rd))
    native_write_i64(call_fixups, 0, cf)
    if rd >= 0 and rd != 0 do
        cb = arm64_mov_rr(cb, rd as int, 0)
    end
    out cb
end.

func emit_to_x0(cb: CodeBuf, opnd: LirOperand, assigned_phys: i64, scratch: i64):
    r = resolve_or_imm_reg(cb, opnd, assigned_phys, scratch)
    if r >= 0 and r != 0 do
        cb = arm64_mov_rr(cb, 0, r as int)
    end
    out cb
end.

func emit_lir_setarg(cb: CodeBuf, ins: LirInstr, assigned_phys: i64, pending_stk: i64):
    SCR = 9
    ai = native_read_i64(ins as i64, 40)
    src1 = native_read_i64(ins as i64, 24)
    if (src1 as i64) != 0 do
        if native_read_i64(src1 as i64, 0) == (LirOperandType.Imm as i64) do
            ai = native_read_i64(src1 as i64, 32)
        end
    end
    src2 = native_read_i64(ins as i64, 32)
    var (cb_arg, rval) = lir_load_opnd_to_reg(cb, src2, assigned_phys, SCR)
    cb = cb_arg
    if rval < 0 do
        out (cb, pending_stk)
    end
    if ai >= 0 and ai < 8 do
        if rval != ai do
            cb = arm64_mov_rr(cb, ai as int, rval as int)
        end
        out (cb, pending_stk)
    end
    cb = arm64_str_pre(cb, rval as int, 31, 0 - 16)
    out (cb, pending_stk + 1)
end.

func emit_lir_intrinsic(cb: CodeBuf, ins: LirInstr, rd: i64, rs1: i64, assigned_phys: i64, call_fixups: i64, func_obj: LirFunc, str_fixups: i64, recent_setargs: i64, lir_funcs: i64):
    kind = native_read_i64(ins as i64, 40)
    ins_dst = native_read_i64(ins as i64, 16) as LirOperand
    ins_src1 = native_read_i64(ins as i64, 24) as LirOperand
    ins_src2 = native_read_i64(ins as i64, 32) as LirOperand
    SCR = 9
    if kind == MIR_INTR_GLOBAL_LOAD do
        slot = native_read_i64(ins_src1 as i64, 32)
        if rd >= 0 and slot >= 0 and slot < 4092 do
            out arm64_ldr_uoff(cb, rd as int, 28, (32 + slot * 8) as int)
        end
        out arm64_nop(cb)
    end
    if kind == MIR_INTR_GLOBAL_STORE do
        slot = native_read_i64(ins_dst as i64, 32)
        if slot >= 0 and slot < 4092 do
            var (cb_global, global_reg) = lir_load_opnd_to_reg(cb, ins_src1 as i64, assigned_phys, SCR)
            out arm64_str_uoff(cb_global, global_reg as int, 28, (32 + slot * 8) as int)
        end
        out arm64_nop(cb)
    end
    if lir_intr_is_marker(kind) == 1 do
        out arm64_nop(cb)
    end
    if kind == MIR_INTR_PARAM do
        abi = native_read_i64(ins_src1 as i64, 32)
        if abi >= 0 and abi < 8 do
            if rd >= 0 do
                if rd != abi do
                    cb = arm64_mov_rr(cb, rd as int, abi as int)
                end
            else
                if (ins_dst as i64) != 0 do
                    cb = emit_spill_store(cb, ins_dst as i64, abi)
                end
            end
            out cb
        end
        if abi >= 8 do
            # AAPCS64: caller stack arguments start at FP + 16
            off = 16 + ((abi - 8) * 8)
            if rd >= 0 do
                cb = arm64_ldr_uoff(cb, rd as int, 29, off as int)
            else
                if (ins_dst as i64) != 0 do
                    cb = arm64_ldr_uoff(cb, SCR as int, 29, off as int)
                    cb = emit_spill_store(cb, ins_dst as i64, SCR)
                end
            end
            out cb
        end
        out arm64_nop(cb)
    end
    if kind == MIR_INTR_BUILTIN do
        bid = native_read_i64(ins_src1 as i64, 32)
        # ── Inline read_byte(ptr, idx) → LDRB Wrd, [X_ptr, X_idx] ──
        if bid == 5 do
            if rd >= 0 do
                s0 = vec_get_rt(recent_setargs, 0)
                s1 = vec_get_rt(recent_setargs, 1)
                var (cb1, r0) = lir_load_opnd_to_reg(cb, s0, assigned_phys, 9)
                var (cb2, r1) = lir_load_opnd_to_reg(cb1, s1, assigned_phys, 10)
                cb = arm64_ldrb_reg(cb2, rd as int, r0 as int, r1 as int)
            end
            out cb
        end
        # ── Inline write_byte(ptr, idx, val) → STRB W_val, [X_ptr, X_idx] ──
        if bid == 6 do
            s0 = vec_get_rt(recent_setargs, 0)
            s1 = vec_get_rt(recent_setargs, 1)
            s2 = vec_get_rt(recent_setargs, 2)
            var (cb1, r0) = lir_load_opnd_to_reg(cb, s0, assigned_phys, 9)
            var (cb2, r1) = lir_load_opnd_to_reg(cb1, s1, assigned_phys, 10)
            var (cb3, r2) = lir_load_opnd_to_reg(cb2, s2, assigned_phys, 11)
            cb = arm64_strb_reg(cb3, r2 as int, r0 as int, r1 as int)
            out cb
        end
        # ── Inline read_word(ptr, idx) → LDR Xrd, [X_ptr, X_idx] ──
        if bid == 7 or bid == 46 do
            if rd >= 0 do
                s0 = vec_get_rt(recent_setargs, 0)
                s1 = vec_get_rt(recent_setargs, 1)
                var (cb1, r0) = lir_load_opnd_to_reg(cb, s0, assigned_phys, 9)
                var (cb2, r1) = lir_load_opnd_to_reg(cb1, s1, assigned_phys, 10)
                cb = arm64_ldr_reg(cb2, rd as int, r0 as int, r1 as int)
            end
            out cb
        end
        # ── Inline write_word(ptr, idx, val) → STR X_val, [X_ptr, X_idx] ──
        if bid == 8 or bid == 47 do
            s0 = vec_get_rt(recent_setargs, 0)
            s1 = vec_get_rt(recent_setargs, 1)
            s2 = vec_get_rt(recent_setargs, 2)
            var (cb1, r0) = lir_load_opnd_to_reg(cb, s0, assigned_phys, 9)
            var (cb2, r1) = lir_load_opnd_to_reg(cb1, s1, assigned_phys, 10)
            var (cb3, r2) = lir_load_opnd_to_reg(cb2, s2, assigned_phys, 11)
            cb = arm64_str_reg(cb3, r2 as int, r0 as int, r1 as int)
            out cb
        end
        # ── Inline memset(buf, val, len) / fill_bytes → Hardware 8-Byte Block Fill ──
        if bid == 32 do
            s0 = vec_get_rt(recent_setargs, 0)
            s1 = vec_get_rt(recent_setargs, 1)
            s2 = vec_get_rt(recent_setargs, 2)
            if s0 != 0 do
                typ0 = native_read_i64(s0 as i64, 0)
                if typ0 == 5 do # Imm
                    cb = arm64_movz_imm64(cb, 9, native_read_i64(s0 as i64, 32) as int)
                eif typ0 == 4 do # StackMem
                    off0 = native_read_i64(s0 as i64, 24)
                    cb = emit_fp_sub_addr(cb, 9, 0 - off0)
                    cb = arm64_ldr_uoff(cb, 9, 9, 0)
                else
                    r_s0 = resolve_reg(s0 as LirOperand, assigned_phys)
                    if r_s0 >= 0 and r_s0 != 9 do
                        cb = arm64_mov_rr(cb, 9, r_s0 as int)
                    end
                end
            end
            if s1 != 0 do
                typ1 = native_read_i64(s1 as i64, 0)
                if typ1 == 5 do # Imm
                    cb = arm64_movz_imm64(cb, 10, native_read_i64(s1 as i64, 32) as int)
                eif typ1 == 4 do # StackMem
                    off1 = native_read_i64(s1 as i64, 24)
                    cb = emit_fp_sub_addr(cb, 10, 0 - off1)
                    cb = arm64_ldr_uoff(cb, 10, 10, 0)
                else
                    r_s1 = resolve_reg(s1 as LirOperand, assigned_phys)
                    if r_s1 >= 0 and r_s1 != 10 do
                        cb = arm64_mov_rr(cb, 10, r_s1 as int)
                    end
                end
            end
            if s2 != 0 do
                typ2 = native_read_i64(s2 as i64, 0)
                if typ2 == 5 do # Imm
                    cb = arm64_movz_imm64(cb, 11, native_read_i64(s2 as i64, 32) as int)
                eif typ2 == 4 do # StackMem
                    off2 = native_read_i64(s2 as i64, 24)
                    cb = emit_fp_sub_addr(cb, 11, 0 - off2)
                    cb = arm64_ldr_uoff(cb, 11, 11, 0)
                else
                    r_s2 = resolve_reg(s2 as LirOperand, assigned_phys)
                    if r_s2 >= 0 and r_s2 != 11 do
                        cb = arm64_mov_rr(cb, 11, r_s2 as int)
                    end
                end
            end
            cb = arm64_and_mask(cb, 12, 10, 255)
            cb = arm64_movz_imm64(cb, 13, 8)
            cb = arm64_lsl_rrr(cb, 13, 12, 13)
            cb = arm64_orr_rrr(cb, 12, 12, 13)
            cb = arm64_movz_imm64(cb, 13, 16)
            cb = arm64_lsl_rrr(cb, 13, 12, 13)
            cb = arm64_orr_rrr(cb, 12, 12, 13)
            cb = arm64_movz_imm64(cb, 13, 32)
            cb = arm64_lsl_rrr(cb, 13, 12, 13)
            cb = arm64_orr_rrr(cb, 12, 12, 13)
            cb = arm64_cmp_imm(cb, 11, 8)
            cb = codebuf_emit_u32(cb, 0x54000083)
            cb = codebuf_emit_u32(cb, 0xF800852C)
            cb = arm64_sub_imm(cb, 11, 11, 8)
            cb = arm64_b_imm26(cb, 0 - 16)
            cb = codebuf_emit_u32(cb, 0xB400008B)
            cb = codebuf_emit_u32(cb, 0x3800152A)
            cb = codebuf_emit_u32(cb, 0xF100056B)
            cb = codebuf_emit_u32(cb, 0x54FFFFE1)
            if rd >= 0 do
                cb = arm64_mov_rr(cb, rd as int, 9)
            end
            out cb
        end
        # ── Zero-Cost Inlined Linear / Arena Allocator (bid 3, 35, 49, 50, 51) ──
        if bid == 3 or bid == 35 or bid == 49 or bid == 50 do
            var size_arg_idx = 0
            if bid == 50 do
                size_arg_idx = 1
            end
            var out_r = rd
            if out_r < 0 do
                out_r = 12
            end
            # Load the size argument from recent_setargs into scratch register X0
            var size_reg = 0
            if vec_len_rt(recent_setargs) > size_arg_idx do
                s_size = vec_get_rt(recent_setargs, size_arg_idx)
                if s_size != 0 do
                    var (cb_sz, r_sz) = lir_load_opnd_to_reg(cb, s_size as LirOperand, assigned_phys, 0)
                    cb = cb_sz
                    size_reg = r_sz
                end
            end
            # Compute aligned size in X10 (align to 16 bytes)
            cb = arm64_add_imm(cb, 10, size_reg as int, 15)  # X10 = size + 15
            cb = arm64_movz_imm64(cb, 11, 4)                  # X11 = 4 (shift amt)
            cb = arm64_lsr_rrr(cb, 10, 10, 11)                # X10 = (size+15)  shr  4
            cb = arm64_lsl_imm(cb, 10, 10, 4)                 # X10 = aligned to 16
            cb = arm64_ldr_uoff(cb, out_r as int, 28, 0)      # out_r = bump_curr
            cb = arm64_add_rrr(cb, 10, out_r as int, 10)      # X10 = bump + aligned
            cb = arm64_str_uoff(cb, 10, 28, 0)                # *X28 = new bump_curr
            if rd < 0 and ins_dst != 0 do
                off = lir_opnd_spill_off(ins_dst as i64)
                if off != 0 do
                    if off < 0 and off >= 0 - 255 do
                        cb = arm64_stur(cb, out_r as int, 29, off as int)
                    else
                        if off < 0 do
                            cb = emit_fp_sub_addr(cb, 9, 0 - off)
                            cb = arm64_str_uoff(cb, out_r as int, 9, 0)
                        end
                    end
                end
            end
            out cb
        end
        # ── Zero-Cost Instant Arena Reset / Free (bid == 51) ──
        if bid == 51 do
            if vec_len_rt(recent_setargs) >= 1 do
                s0 = vec_get_rt(recent_setargs, 0)
                if s0 != 0 do
                    r_mark = resolve_or_imm_reg(cb, s0 as LirOperand, assigned_phys, 9)
                    cb = arm64_str_uoff(cb, r_mark as int, 28, 0)
                end
            end
            out cb
        end
        # ── Inline rotl32(val, n) → Hardware 32-bit ROR / RORV ──
        if bid == 84 do
            if rd >= 0 do
                s0 = vec_get_rt(recent_setargs, 0)
                s1 = vec_get_rt(recent_setargs, 1)
                var (cb1, r0) = lir_load_opnd_to_reg(cb, s0, assigned_phys, 14)
                var (cb2, r1) = lir_load_opnd_to_reg(cb1, s1, assigned_phys, 15)
                # ARM64: neg w15, w_r1; ror w_rd, w_r0, w15
                cb = codebuf_emit_u32(cb2, 0x4B0003EF or ((r1 as int and 0x1F) shl 16))
                cb = codebuf_emit_u32(cb, 0x1AC02C00 or (15 shl 16) or ((r0 as int and 0x1F) shl 5) or (rd as int and 0x1F))
                out cb
            end
            out cb
        end
        # ── Inline rotr32(val, n) → Hardware 32-bit ROR / RORV ──
        if bid == 85 do
            if rd >= 0 do
                s0 = vec_get_rt(recent_setargs, 0)
                s1 = vec_get_rt(recent_setargs, 1)
                var (cb1, r0) = lir_load_opnd_to_reg(cb, s0, assigned_phys, 14)
                var (cb2, r1) = lir_load_opnd_to_reg(cb1, s1, assigned_phys, 15)
                # ARM64: ror w_rd, w_r0, w_r1
                cb = codebuf_emit_u32(cb2, 0x1AC02C00 or ((r1 as int and 0x1F) shl 16) or ((r0 as int and 0x1F) shl 5) or (rd as int and 0x1F))
                out cb
            end
            out cb
        end
        stub = lir_stub_for_builtin_id(bid)
        if stub < 0 do
            stub = LIR_RT_UNRESOLVED
        end
        out emit_bl_fixup(cb, call_fixups, 1, stub, rd)
    end
    if kind == MIR_INTR_PRINT do
        var target_src = ins_src1
        if (target_src as i64) == 0 or native_read_i64(target_src as i64, 0) == 0 do
            target_src = ins_src2
        end
        cb = emit_to_x0(cb, target_src, assigned_phys, 9)
        out emit_bl_fixup(cb, call_fixups, 1, MIR_INTR_PRINT, rd)
    end
    if kind == MIR_INTR_PRINT_STR do
        var target_src2 = ins_src1
        if (target_src2 as i64) == 0 or native_read_i64(target_src2 as i64, 0) == 0 do
            target_src2 = ins_src2
        end
        cb = emit_to_x0(cb, target_src2, assigned_phys, 9)
        out emit_bl_fixup(cb, call_fixups, 1, LIR_RT_PRINT_STR, rd)
    end
    if kind == MIR_INTR_STR_LIT or kind == MIR_INTR_INTERP or kind == MIR_INTR_BUNDLE do
        sid = native_read_i64(ins_src1 as i64, 32)
        f_strings = native_read_i64(func_obj as i64, 32)
        if f_strings > 0 and sid >= 0 and sid < vec_len_rt(f_strings) and rd >= 0 do
            s_val = vec_get_rt(f_strings, sid)
            sf = native_read_i64(str_fixups, 0)
            sf = vec_push_rt(sf, lir_str_fixup_new(codebuf_offset(cb) as i64, s_val as i64, rd))
            native_write_i64(str_fixups, 0, sf)
            cb = codebuf_emit_u32(cb, 0x90000000 or (rd as int and 0x1F))
            out codebuf_emit_u32(cb, 0x91000000 or ((rd as int and 0x1F) shl 5) or (rd as int and 0x1F))
        end
        if rd >= 0 do
            arm64_movz_imm64(cb, rd as int, 0)
            out cb
        end
        out arm64_nop(cb)
    end
    if lir_intr_is_payload(kind) == 1 do
        if rd >= 0 do
            if native_read_i64(ins_src1 as i64, 0) == (LirOperandType.Imm as i64) do
                arm64_movz_imm64(cb, rd as int, native_read_i64(ins_src1 as i64, 32) as int)
                out cb
            eif rs1 >= 0 do
                arm64_mov_rr(cb, rd as int, rs1 as int)
                out cb
            end
        end
        out arm64_nop(cb)
    end
    if kind == MIR_INTR_INDEX do
        s0 = vec_get_rt(recent_setargs, 0)
        var (cb1, r_idx) = lir_load_opnd_to_reg(cb, s0, assigned_phys, 9)
        var (cb2, r_base) = lir_load_opnd_to_reg(cb1, ins_src1 as i64, assigned_phys, 10)
        if rd >= 0 do
            cb2 = arm64_add_imm(cb2, 11, r_base as int, 16)
            cb2 = arm64_ldr_reg_lsl3(cb2, rd as int, 11, r_idx as int)
        end
        out cb2
    end
    if kind == MIR_INTR_INDEX_STORE do
        s0 = vec_get_rt(recent_setargs, 0)
        s1 = vec_get_rt(recent_setargs, 1)
        var (cb1, r_idx) = lir_load_opnd_to_reg(cb, s0, assigned_phys, 9)
        var (cb2, r_val) = lir_load_opnd_to_reg(cb1, s1, assigned_phys, 10)
        var (cb3, r_base) = lir_load_opnd_to_reg(cb2, ins_src1 as i64, assigned_phys, 11)
        cb3 = arm64_add_imm(cb3, 12, r_base as int, 16)
        cb3 = arm64_str_reg_lsl3(cb3, r_val as int, 12, r_idx as int)
        out cb3
    end
    if kind == MIR_INTR_FIELD do
        if rd >= 0 and rs1 >= 0 do
            cb = arm64_ldr_reg_lsl3(cb, rd as int, rs1 as int, 0)
            out cb
        end
        out arm64_nop(cb)
    end
    if kind == MIR_INTR_FIELD_STORE do
        if rs1 >= 0 do
            cb = arm64_str_reg_lsl3(cb, 1, rs1 as int, 0)
            out cb
        end
        out arm64_nop(cb)
    end
    if kind == MIR_INTR_ARENA do
        if rd >= 0 do
            cb = arm64_ldr_uoff(cb, rd as int, 28, 0)
            out cb
        end
        if rs1 >= 0 do
            cb = arm64_str_uoff(cb, rs1 as int, 28, 0)
            out cb
        end
        out arm64_nop(cb)
    end
    if kind == MIR_INTR_ENTITY or kind == MIR_INTR_ARRAY or kind == MIR_INTR_TUPLE do
        n_elem = 0
        if (ins_src1 as i64) != 0 do
            styp = native_read_i64(ins_src1 as i64, 0)
            if styp == 5 do # Imm
                n_elem = native_read_i64(ins_src1 as i64, 32)
            end
        end
        if rd >= 0 do
            cb = arm64_ldr_uoff(cb, 9, 28, 0)
            cb = arm64_mov_rr(cb, rd as int, 9)
            alloc_bytes = n_elem * 8
            if alloc_bytes > 0 do
                cb = arm64_add_imm(cb, 10, 9, alloc_bytes as int)
                cb = arm64_str_uoff(cb, 10, 28, 0)
            end
            var ei = 0
            when ei < n_elem and ei < 8 loop
                cb = arm64_str_uoff(cb, ei as int, rd as int, (ei * 8) as int)
                ei = ei + 1
            end
            out cb
        end
        out arm64_nop(cb)
    end
    if kind == MIR_INTR_ADDR_OF do
        cid = native_read_i64(ins_src1 as i64, 32)
        f_strings = native_read_i64(func_obj as i64, 32)
        if f_strings > 0 and cid >= 0 and cid < vec_len_rt(f_strings) do
            cname = vec_get_rt(f_strings, cid)
            fi = lir_find_func_index(lir_funcs, cname)
            if fi >= 0 and rd >= 0 do
                at = codebuf_offset(cb) as i64
                cb = codebuf_emit_u32(cb, 0x90000000 or (rd as int and 0x1F))
                cb = codebuf_emit_u32(cb, 0x91000000 or ((rd as int and 0x1F) shl 5) or (rd as int and 0x1F))
                cf = native_read_i64(call_fixups, 0)
                cf = vec_push_rt(cf, lir_call_fixup_new(at, 2, fi, rd))
                native_write_i64(call_fixups, 0, cf)
                out cb
            end
        end
        if rd >= 0 do
            cb = arm64_mov_imm16(cb, rd as int, 0)
        end
        out cb
    end
    emit_to_x0(cb, ins_src1, assigned_phys, SCR)
    stub2 = kind
    if stub2 < 1 or stub2 >= LIR_RT_STUB_COUNT do
        stub2 = LIR_RT_UNRESOLVED
    end
    out emit_bl_fixup(cb, call_fixups, 1, stub2, rd)
end.

var g_arm64_func_index_source: i64 = 0
var g_arm64_func_index_buckets: i64 = 0
var g_codegen_func_obj: i64 = 0
var g_codegen_blocks: i64 = 0
var g_codegen_cur_block: i64 = 0
var g_codegen_cur_instrs: i64 = 0
var g_codegen_stack_size: i64 = 0
var g_codegen_max_phys: i64 = 0

func arm64_func_name_hash(name: string):
    data = native_read_i64(name as i64, 0)
    n = native_read_i64(name as i64, 8)
    h = n * 17
    var i = 0
    when i < n loop
        h = h * 131 + native_read_u8(data, i)
        i = i + 1
    end
    if h < 0 do h = 0 - h end
    out h mod 256
end.

func arm64_prepare_func_index(lir_funcs: i64):
    held_funcs = lir_funcs
    buckets = vec_new_cap_rt(256)
    var bi = 0
    when bi < 256 loop
        buckets = vec_push_rt(buckets, 0)
        bi = bi + 1
    end
    n = vec_len_rt(held_funcs)
    var i = 0
    when i < n loop
        lf = vec_get_rt(held_funcs, i)
        fn_name = native_read_i64(lf as i64, 8) as string
        bid = arm64_func_name_hash(fn_name)
        bucket = vec_get_rt(buckets, bid)
        if bucket == 0 do bucket = vec_new_rt() end
        bucket = vec_push_rt(bucket, i)
        vec_set_rt(buckets, bid, bucket)
        i = i + 1
    end
    g_arm64_func_index_source = held_funcs
    g_arm64_func_index_buckets = buckets
end.

func lir_find_func_index(lir_funcs: i64, name: string):
    if g_arm64_func_index_source != lir_funcs or g_arm64_func_index_buckets == 0 do
        arm64_prepare_func_index(lir_funcs)
    end
    bid = arm64_func_name_hash(name)
    bucket = vec_get_rt(g_arm64_func_index_buckets, bid)
    if bucket == 0 do out 0 - 1 end
    n = vec_len_rt(bucket)
    var i = 0
    when i < n loop
        idx = vec_get_rt(bucket, i)
        lf = vec_get_rt(lir_funcs, idx)
        fn_name = native_read_i64(lf as i64, 8) as string
        if fat_str_eq(fn_name, name) == 1 do out idx end
        i = i + 1
    end
    out 0 - 1
end.

func emit_lir_call(cb: CodeBuf, ins: LirInstr, rd: i64, func_obj: LirFunc, lir_funcs: i64, call_fixups: i64, pending_stk: i64, assigned_phys: i64):
    sid = native_read_i64(ins as i64, 40)
    ins_src2 = native_read_i64(ins as i64, 32) as LirOperand
    is_dynamic = 0
    if sid < 0 do
        is_dynamic = 1
    eif (ins_src2 as i64) != 0 do
        s2_typ = native_read_i64(ins_src2 as i64, 0)
        if s2_typ == (LirOperandType.VRegInt as i64) or s2_typ == (LirOperandType.PhysReg as i64) do
            is_dynamic = 1
        end
    end
    if is_dynamic == 1 do
        var (cb_dyn, r_target) = lir_load_opnd_to_reg(cb, ins_src2 as i64, assigned_phys, 16)
        cb = cb_dyn
        if r_target >= 0 do
            cb = arm64_blr(cb, r_target as int)
        else
            cb = arm64_blr(cb, 16)
        end
        if rd >= 0 and rd != 0 do
            cb = arm64_mov_rr(cb, rd as int, 0)
        end
    else
        target_kind = 1
        target_id = LIR_RT_UNRESOLVED
        f_strings = native_read_i64(func_obj as i64, 32)
        if f_strings > 0 and sid >= 0 and sid < vec_len_rt(f_strings) do
            cname = vec_get_rt(f_strings, sid)
            fi = lir_find_func_index(lir_funcs, cname)
            if fi >= 0 do
                target_kind = 0
                target_id = fi
            else
                stub_id = lir_stub_for_callee_name(cname)
                if stub_id >= 0 do
                    target_kind = 1
                    target_id = stub_id
                end
            end
        end
        cb = emit_bl_fixup(cb, call_fixups, target_kind, target_id, rd)
    end
    if pending_stk > 0 do
        bytes = pending_stk * 16
        if bytes <= 4095 do
            cb = arm64_add_imm(cb, 31, 31, bytes as int)
        end
    end
    out (cb, 0)
end.

func emit_lir_rt_print_stub(cb: CodeBuf, is_linux: i64):
    cb = arm64_sub_imm(cb, 31, 31, 128)
    cb = arm64_str_uoff(cb, 1, 31, 0)
    cb = arm64_str_uoff(cb, 2, 31, 8)
    cb = arm64_str_uoff(cb, 3, 31, 16)
    cb = arm64_str_uoff(cb, 4, 31, 24)
    cb = arm64_str_uoff(cb, 5, 31, 32)
    cb = arm64_str_uoff(cb, 6, 31, 40)
    cb = arm64_str_uoff(cb, 16, 31, 48)

    cb = arm64_mov_imm16(cb, 2, 10)
    cb = arm64_mov_imm16(cb, 3, 10)
    cb = arm64_strb_uoff(cb, 2, 31, 127)

    cb = arm64_cmp_imm0(cb, 0)
    cb = arm64_bne_imm19(cb, 28)
    cb = arm64_mov_imm16(cb, 2, 48)
    cb = arm64_strb_uoff(cb, 2, 31, 126)
    cb = arm64_mov_imm16(cb, 0, 1)
    cb = arm64_add_imm(cb, 1, 31, 126)
    cb = arm64_mov_imm16(cb, 2, 2)
    cb = arm64_b_imm26(cb, 104)

    cb = arm64_add_imm(cb, 1, 31, 127)
    cb = arm64_cmp_imm0(cb, 0)
    cb = arm64_cset_lt(cb, 4)
    cb = arm64_cmp_imm0(cb, 4)
    cb = arm64_beq_imm19(cb, 8)
    cb = arm64_sub_rrr(cb, 0, 31, 0)

    loop_top = codebuf_offset(cb)
    cb = arm64_sdiv_rrr(cb, 5, 0, 3)
    cb = arm64_msub_rrrr(cb, 6, 5, 3, 0)
    cb = arm64_add_imm(cb, 6, 6, 48)
    cb = arm64_sub_imm(cb, 1, 1, 1)
    cb = arm64_strb_uoff(cb, 6, 1, 0)
    cb = arm64_mov_rr(cb, 0, 5)
    cb = arm64_cmp_imm0(cb, 0)
    delta = (loop_top - codebuf_offset(cb)) as int
    cb = arm64_bne_imm19(cb, delta)

    cb = arm64_cmp_imm0(cb, 4)
    cb = arm64_beq_imm19(cb, 16)
    cb = arm64_mov_imm16(cb, 6, 45)
    cb = arm64_sub_imm(cb, 1, 1, 1)
    cb = arm64_strb_uoff(cb, 6, 1, 0)

    cb = arm64_mov_rr(cb, 2, 1)
    cb = arm64_add_imm(cb, 5, 31, 128)
    cb = arm64_sub_rrr(cb, 3, 5, 1)

    cb = arm64_mov_imm16(cb, 0, 1)
    cb = arm64_mov_rr(cb, 1, 2)
    cb = arm64_mov_rr(cb, 2, 3)
    if is_linux == 1 do
        cb = arm64_mov_imm16(cb, 8, 64)
        cb = arm64_svc(cb, 0)
    else
        cb = arm64_mov_imm16(cb, 16, 4)
        cb = codebuf_emit_u32(cb, 0xF2A04010)
        cb = arm64_svc(cb, 0x80)
    end

    cb = arm64_ldr_uoff(cb, 1, 31, 0)
    cb = arm64_ldr_uoff(cb, 2, 31, 8)
    cb = arm64_ldr_uoff(cb, 3, 31, 16)
    cb = arm64_ldr_uoff(cb, 4, 31, 24)
    cb = arm64_ldr_uoff(cb, 5, 31, 32)
    cb = arm64_ldr_uoff(cb, 6, 31, 40)
    cb = arm64_ldr_uoff(cb, 16, 31, 48)
    cb = arm64_add_imm(cb, 31, 31, 128)
    out arm64_ret(cb)
end.

func emit_lir_rt_print_str_stub(cb: CodeBuf, is_linux: i64):
    cb = arm64_sub_imm(cb, 31, 31, 32)
    cb = arm64_str_uoff(cb, 19, 31, 0)
    cb = arm64_str_uoff(cb, 20, 31, 8)
    cb = arm64_str_uoff(cb, 30, 31, 16)

    cb = arm64_mov_rr(cb, 19, 0)
    cb = arm64_mov_rr(cb, 20, 0)

    len_loop = codebuf_offset(cb)
    cb = arm64_ldrb_uoff(cb, 0, 20, 0)
    cb = arm64_cmp_imm0(cb, 0)
    cb = arm64_beq_imm19(cb, 12)
    cb = arm64_add_imm(cb, 20, 20, 1)
    delta = (len_loop - codebuf_offset(cb)) as int
    cb = arm64_b_imm26(cb, delta)

    cb = arm64_sub_rrr(cb, 2, 20, 19)

    cb = arm64_cmp_imm0(cb, 2)
    skip_empty_write = 24
    if is_linux == 1 do skip_empty_write = 20 end
    cb = arm64_beq_imm19(cb, skip_empty_write)
    cb = arm64_mov_imm16(cb, 0, 1)
    cb = arm64_mov_rr(cb, 1, 19)
    if is_linux == 1 do
        cb = arm64_mov_imm16(cb, 8, 64)
        cb = arm64_svc(cb, 0)
    else
        cb = arm64_mov_imm16(cb, 16, 4)
        cb = codebuf_emit_u32(cb, 0xF2A04010)
        cb = arm64_svc(cb, 0x80)
    end

    cb = arm64_mov_imm16(cb, 0, 10)
    cb = arm64_strb_uoff(cb, 0, 31, 24)
    cb = arm64_mov_imm16(cb, 0, 1)
    cb = arm64_add_imm(cb, 1, 31, 24)
    cb = arm64_mov_imm16(cb, 2, 1)
    if is_linux == 1 do
        cb = arm64_mov_imm16(cb, 8, 64)
        cb = arm64_svc(cb, 0)
    else
        cb = arm64_mov_imm16(cb, 16, 4)
        cb = codebuf_emit_u32(cb, 0xF2A04010)
        cb = arm64_svc(cb, 0x80)
    end

    cb = arm64_ldr_uoff(cb, 19, 31, 0)
    cb = arm64_ldr_uoff(cb, 20, 31, 8)
    cb = arm64_ldr_uoff(cb, 30, 31, 16)
    cb = arm64_add_imm(cb, 31, 31, 32)
    out arm64_ret(cb)
end.

func emit_lir_rt_read_u8_stub(cb: CodeBuf):
    cb = arm64_ldrb_reg(cb, 0, 0, 1)
    out arm64_ret(cb)
end.

func emit_lir_rt_write_u8_stub(cb: CodeBuf):
    cb = arm64_strb_reg(cb, 2, 0, 1)
    out arm64_ret(cb)
end.

func emit_lir_rt_alloc_stub(cb: CodeBuf):
    # X0 = requested size
    cb = arm64_ldr_uoff(cb, 1, 28, 0)      # X1 = *X28 (bump_curr)
    cb = arm64_mov_rr(cb, 2, 1)           # X2 = bump_curr (return pointer)

    cb = arm64_cmp_imm0(cb, 0)
    cb = arm64_beq_imm19(cb, 28)

    cb = arm64_add_imm(cb, 0, 0, 7)
    cb = arm64_mov_imm16(cb, 3, 3)
    cb = arm64_lsr_rrr(cb, 0, 0, 3)
    cb = arm64_lsl_imm(cb, 0, 0, 3)
    cb = arm64_add_rrr(cb, 1, 1, 0)
    cb = arm64_str_uoff(cb, 1, 28, 0)

    cb = arm64_mov_rr(cb, 0, 2)
    out arm64_ret(cb)
end.

func emit_lir_rt_arg_count_stub(cb: CodeBuf):
    cb = arm64_ldr_uoff(cb, 0, 28, 8)
    out arm64_ret(cb)
end.

func emit_lir_rt_get_arg_stub(cb: CodeBuf):
    # X0 = arg index (0..N-1)
    cb = arm64_ldr_uoff(cb, 1, 28, 8)      # X1 = argc
    cb = arm64_cmp_rr(cb, 0, 1)
    cb = arm64_bge_imm19(cb, 20)           # if idx >= argc -> return null

    cb = arm64_ldr_uoff(cb, 2, 28, 16)     # X2 = argv base ptr (load char** pointer)
    cb = arm64_lsl_imm(cb, 3, 0, 3)        # X3 = idx * 8
    cb = arm64_ldr_reg(cb, 0, 2, 3)        # X0 = argv[idx]
    out arm64_ret(cb)

    cb = arm64_mov_imm16(cb, 0, 0)
    out arm64_ret(cb)
end.

func emit_lir_rt_read_i64_stub(cb: CodeBuf):
    cb = arm64_ldr_reg(cb, 0, 0, 1)
    out arm64_ret(cb)
end.

func emit_lir_rt_write_i64_stub(cb: CodeBuf):
    cb = arm64_str_reg(cb, 2, 0, 1)
    out arm64_ret(cb)
end.

func emit_lir_rt_volatile_read_stub(cb: CodeBuf):
    cb = arm64_dmb_ishld(cb)
    cb = arm64_ldr_uoff(cb, 0, 0, 0)
    cb = arm64_dmb_ishld(cb)
    out arm64_ret(cb)
end.

func emit_lir_rt_volatile_write_stub(cb: CodeBuf):
    cb = arm64_dmb_ishst(cb)
    cb = arm64_str_uoff(cb, 1, 0, 0)
    cb = arm64_dmb_ishst(cb)
    out arm64_ret(cb)
end.

func emit_lir_rt_volatile_read8_stub(cb: CodeBuf):
    cb = arm64_dmb_ishld(cb)
    cb = arm64_ldrb_uoff(cb, 0, 0, 0)
    cb = arm64_dmb_ishld(cb)
    out arm64_ret(cb)
end.

func emit_lir_rt_volatile_write8_stub(cb: CodeBuf):
    cb = arm64_dmb_ishst(cb)
    cb = arm64_strb_uoff(cb, 1, 0, 0)
    cb = arm64_dmb_ishst(cb)
    out arm64_ret(cb)
end.

func emit_lir_rt_atomic_load32_stub(cb: CodeBuf):
    cb = codebuf_emit_u32(cb, 0x88DFFC00)
    out arm64_ret(cb)
end.

func emit_lir_rt_atomic_store32_stub(cb: CodeBuf):
    cb = codebuf_emit_u32(cb, 0x889FFC01)
    out arm64_ret(cb)
end.

func emit_lir_rt_atomic_add32_stub(cb: CodeBuf):
    cb = codebuf_emit_u32(cb, 0x885F7C02)
    cb = codebuf_emit_u32(cb, 0x0B010043)
    cb = codebuf_emit_u32(cb, 0x88047C03)
    cb = codebuf_emit_u32(cb, 0x35FFFFA4)
    cb = codebuf_emit_u32(cb, 0x2A0203E0)
    out arm64_ret(cb)
end.

func emit_lir_rt_atomic_sub32_stub(cb: CodeBuf):
    cb = codebuf_emit_u32(cb, 0x885F7C02)
    cb = codebuf_emit_u32(cb, 0x4B010043)
    cb = codebuf_emit_u32(cb, 0x88047C03)
    cb = codebuf_emit_u32(cb, 0x35FFFFA4)
    cb = codebuf_emit_u32(cb, 0x2A0203E0)
    out arm64_ret(cb)
end.

func emit_lir_rt_atomic_cas32_stub(cb: CodeBuf):
    cb = codebuf_emit_u32(cb, 0x885F7C03) # ldaxr w3, [x0]
    cb = codebuf_emit_u32(cb, 0x6B01007F) # cmp w3, w1
    cb = codebuf_emit_u32(cb, 0x540000A1) # b.ne +20 (to clrex)
    cb = codebuf_emit_u32(cb, 0x88047C02) # stlxr w4, w2, [x0]
    cb = codebuf_emit_u32(cb, 0x35FFFF84) # cbnz w4, -16 (to ldaxr)
    cb = codebuf_emit_u32(cb, 0xD2800020) # mov x0, #1
    cb = arm64_ret(cb)
    cb = codebuf_emit_u32(cb, 0xD5033F5F) # clrex
    cb = codebuf_emit_u32(cb, 0xD2800000) # mov x0, #0
    out arm64_ret(cb)
end.

func emit_lir_rt_atomic_exchange32_stub(cb: CodeBuf):
    cb = codebuf_emit_u32(cb, 0x885F7C02)
    cb = codebuf_emit_u32(cb, 0x88047C01)
    cb = codebuf_emit_u32(cb, 0x35FFFFC4)
    cb = codebuf_emit_u32(cb, 0x2A0203E0)
    out arm64_ret(cb)
end.

