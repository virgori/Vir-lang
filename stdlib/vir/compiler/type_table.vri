##
 * vir/compiler/type_table.vri
 * ==============================================================
 * Bảng quản lý kiểu dữ liệu (Type Table) cho compiler.
 ##

include vec_rt;
import vec_new_rt, vec_push_rt, vec_get_rt, vec_len_rt from vec_rt;

enum TypeKind:
    Void    = 0,
    Int     = 1,
    Float   = 2,
    Bool    = 3,
    String  = 4,
    Entity  = 5,
    Enum    = 6,
    Array   = 7,
    Func    = 8,
    Pointer = 9
end.
# Const IDs for primitive types (will be allocated first)
const TYPE_VOID:   0;
const TYPE_INT:    1;
const TYPE_FLOAT:  2;
const TYPE_BOOL:   3;
const TYPE_STRING: 4;

entity TypeNode:
    kind: TypeKind,
    name_id: i64,       # InternID (0 if anonymous)
    size: i64,          # Size in bytes
    elem_type: i64,     # TypeID cho Array/Pointer
    return_type: i64,   # TypeID cho Func
    fields: i64         # Vec của Field/Param (các TypeID thành phần)
end.
entity TypeTable:
    nodes: i64          # vec của TypeNode
end.
func type_table_new()
    tbl = TypeTable (
        nodes: vec_new_rt()
    );
    
    # Khởi tạo các primitive types theo đúng thứ tự (Void = 0, Int = 1, Float = 2, Bool = 3, String = 4)
    # Void
    vec_push_rt(tbl.nodes, TypeNode ( kind: TypeKind.Void, name_id: 0, size: 0, elem_type: 0, return_type: 0, fields: 0 ));
    # Int (i64 mặc định là 8 bytes)
    vec_push_rt(tbl.nodes, TypeNode ( kind: TypeKind.Int, name_id: 0, size: 8, elem_type: 0, return_type: 0, fields: 0 ));
    # Float (f64 mặc định là 8 bytes)
    vec_push_rt(tbl.nodes, TypeNode ( kind: TypeKind.Float, name_id: 0, size: 8, elem_type: 0, return_type: 0, fields: 0 ));
    # Bool (1 byte)
    vec_push_rt(tbl.nodes, TypeNode ( kind: TypeKind.Bool, name_id: 0, size: 1, elem_type: 0, return_type: 0, fields: 0 ));
    # String (Pointer size = 8 bytes)
    vec_push_rt(tbl.nodes, TypeNode ( kind: TypeKind.String, name_id: 0, size: 8, elem_type: 0, return_type: 0, fields: 0 ));
    
    out tbl
end.
func type_alloc(tbl: TypeTable, node: any)
    id = vec_len_rt(tbl.nodes);
    vec_push_rt(tbl.nodes, node);
    out id
end.
func type_get(tbl: TypeTable, id: i64)
    out vec_get_rt(tbl.nodes, id)
end.