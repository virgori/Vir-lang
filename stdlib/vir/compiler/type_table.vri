##
 * vir/compiler/type_table.vri
 * ==============================================================
 * Bảng quản lý kiểu dữ liệu (Type Table) cho compiler.
 ##

include vec_rt;
import vec_new_rt, vec_push_rt, vec_get_rt, vec_len_rt from vec_rt;

enum TypeKind:
    Void    = 0,
    Int     = 1,
    Float   = 2,
    Bool    = 3,
    String  = 4,
    Entity  = 5,
    Enum    = 6,
    Array   = 7,
    Func    = 8,
    Pointer = 9,
    Dict     = 10,
    Tuple    = 11,
    Ref      = 12,
    MutRef   = 13,
    Register = 14,
    Mold     = 15,
    Packed   = 16,
    Flux     = 17,
    Deck     = 18,
    Optional = 19
end.
# Const IDs for primitive types (will be allocated first)
const TYPE_VOID:   0;
const TYPE_INT:    1;
const TYPE_FLOAT:  2;
const TYPE_BOOL:   3;
const TYPE_STRING: 4;

entity TypeNode:
    kind: TypeKind,
    name_id: i64,       # InternID (0 if anonymous)
    size: i64,          # Size in bytes
    elem_type: i64,     # TypeID cho Array/Pointer
    return_type: i64,   # TypeID cho Func
    fields: i64         # Vec của Field/Param (các TypeID thành phần)
end.
entity TypeTable:
    nodes: i64          # vec của TypeNode
end.
func type_table_new()
    tbl = TypeTable (
        nodes: vec_new_rt()
    );
    
    # Khởi tạo các primitive types theo đúng thứ tự (Void = 0, Int = 1, Float = 2, Bool = 3, String = 4)
    tbl.nodes = vec_push_rt(tbl.nodes, TypeNode ( kind: TypeKind.Void, name_id: 0, size: 0, elem_type: 0, return_type: 0, fields: 0 ));
    tbl.nodes = vec_push_rt(tbl.nodes, TypeNode ( kind: TypeKind.Int, name_id: 0, size: 8, elem_type: 0, return_type: 0, fields: 0 ));
    tbl.nodes = vec_push_rt(tbl.nodes, TypeNode ( kind: TypeKind.Float, name_id: 0, size: 8, elem_type: 0, return_type: 0, fields: 0 ));
    tbl.nodes = vec_push_rt(tbl.nodes, TypeNode ( kind: TypeKind.Bool, name_id: 0, size: 1, elem_type: 0, return_type: 0, fields: 0 ));
    tbl.nodes = vec_push_rt(tbl.nodes, TypeNode ( kind: TypeKind.String, name_id: 0, size: 8, elem_type: 0, return_type: 0, fields: 0 ));
    
    out tbl
end.
func type_alloc(tbl: TypeTable, node: any)
    nodes = native_read_i64(tbl as i64, 0);
    id = vec_len_rt(nodes);
    nodes = vec_push_rt(nodes, node);
    native_write_i64(tbl as i64, 0, nodes);
    out id
end.
func type_get(tbl: TypeTable, id: i64)
    nodes = native_read_i64(tbl as i64, 0);
    out vec_get_rt(nodes, id)
end.
func type_is_numeric(kind: TypeKind)
    out kind == TypeKind.Int or kind == TypeKind.Float
end.
func type_is_integer(kind: TypeKind)
    out kind == TypeKind.Int
end.
func type_is_copy(kind: TypeKind)
    out kind == TypeKind.Int or kind == TypeKind.Float or kind == TypeKind.Bool or kind == TypeKind.Enum or kind == TypeKind.Register or kind == TypeKind.Mold
end.
func type_is_move(kind: TypeKind)
    out kind == TypeKind.String or kind == TypeKind.Array or kind == TypeKind.Entity or kind == TypeKind.Dict or kind == TypeKind.Flux or kind == TypeKind.Deck
end.
func type_can_binop(a: TypeKind, b: TypeKind, op: int)
    # op: 0=Add, 1=Sub, 2=Mul, 3=Div, 4=Mod, 5=Eq, 6=Ne, 7=Lt, 8=Le, 9=Gt, 10=Ge
    # String only supports Add (concat) and Eq/Ne
    if a == TypeKind.String or b == TypeKind.String do
        if a != b do
            out false
        end
        out op == 0 or op == 5 or op == 6
    end
    # Bool only supports Eq/Ne and logic (And/Or)
    if a == TypeKind.Bool or b == TypeKind.Bool do
        if a != b do
            out false
        end
        out op >= 5
    end
    # Numeric types can do everything
    if type_is_numeric(a) and type_is_numeric(b) do
        out true
    end
    out false
end.
func type_common(a: TypeKind, b: TypeKind)
    # Return the common type for implicit promotion
    if a == b do
        out a
    end
    # int + float -> float
    if type_is_numeric(a) and type_is_numeric(b) do
        out TypeKind.Float
    end
    out TypeKind.Void # incompatible
end.

export TypeKind, TypeNode, TypeTable, TYPE_VOID, TYPE_INT, TYPE_FLOAT, TYPE_BOOL, TYPE_STRING, type_table_new, type_alloc, type_get, type_is_numeric, type_is_integer, type_is_copy, type_is_move, type_can_binop, type_common