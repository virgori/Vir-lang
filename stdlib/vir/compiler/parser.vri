##
 * vir/compiler/parser.vri — Recursive-Descent Parser (Pure Vir)
 * ==============================================================
 * Produces AST trees from a token stream.
 * Converted from C (core/src/parser.c) for self-hosting.
 *
 * Grammar (keyword-delimited blocks)
 *
 *   program     → (func_def | statement)* EOF
 *   func_def    → FUNC IDENT '(' params ')' block END
 *   params      → (IDENT (',' IDENT)*)?
 *   block       → statement*
 *   statement   → var_decl | const_decl | if_stmt | loop_stmt
 *               | while_stmt | return_stmt | print_stmt
 *               | for_range | enum_def | entity_def
 *               | assign_or_expr | NEWLINE
 *   expr        → or_expr
 *   or_expr     → and_expr (OR and_expr)*
 *   and_expr    → compare (AND compare)*
 *   compare     → bitwise ((EQ|NE|GT|LT|GE|LE) bitwise)?
 *   bitwise     → addition ((SHL|SHR|XOR|BIT_AND|BIT_OR) addition)*
 *   addition    → mult ((PLUS|MINUS) mult)*
 *   mult        → unary ((STAR|SLASH|PERCENT) unary)*
 *   unary       → (MINUS|NOT) unary | postfix
 *   postfix     → primary ('.' IDENT | '[' expr ']' | '(' args ')')*
 *   primary     → INT | FLOAT | STRING | TRUE | FALSE | NONE
 *               | IDENT | '(' expr ')' | '[' elems ']' | INPUT
 ##

include types
include result
