# ═══════════════════════════════════════════════════════
# Operator Types
# ═══════════════════════════════════════════════════════

enum OpType:
    Add     = 0
    Sub     = 1
    Mul     = 2
    Div     = 3
    ModOp   = 4
    Eq      = 10
    Ne      = 11
    Gt      = 12
