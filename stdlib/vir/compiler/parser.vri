##
 * vir/compiler/parser.vri — Recursive-Descent Parser (Pure Vir)
 * ==============================================================
 * Produces AST trees from a token stream.
 * Converted from C (core/src/parser.c) for self-hosting.
 *
 * Grammar (keyword-delimited blocks):
 *
 *   program     → (func_def | statement)* EOF
 *   func_def    → FUNC IDENT '(' params ')' block END
 *   params      → (IDENT (',' IDENT)*)?
 *   block       → statement*
 *   statement   → var_decl | const_decl | if_stmt | loop_stmt
 *               | while_stmt | return_stmt | print_stmt
 *               | for_range | enum_def | entity_def
 *               | assign_or_expr | NEWLINE
 *   expr        → or_expr
 *   or_expr     → and_expr (OR and_expr)*
 *   and_expr    → compare (AND compare)*
 *   compare     → bitwise ((EQ|NE|GT|LT|GE|LE) bitwise)?
 *   bitwise     → addition ((SHL|SHR|XOR|BIT_AND|BIT_OR) addition)*
 *   addition    → mult ((PLUS|MINUS) mult)*
 *   mult        → unary ((STAR|SLASH|PERCENT) unary)*
 *   unary       → (MINUS|NOT) unary | postfix
 *   postfix     → primary ('.' IDENT | '[' expr ']' | '(' args ')')*
 *   primary     → INT | FLOAT | STRING | TRUE | FALSE | NONE
 *               | IDENT | '(' expr ')' | '[' elems ']' | INPUT
 ##

include types;
include result;
import Result, Ok, Err from result;
include string_rt;
import rt_strlen, rt_streq, rt_strcat, rt_strdup, rt_itoa from string_rt;

include vec_rt;
import vec_new_rt, vec_push_rt, vec_get_rt, vec_len_rt from vec_rt;
include lexer;
import Token, TokType, token_name from lexer;


# ═══════════════════════════════════════════════════════
# AST Node Types
# ═══════════════════════════════════════════════════════

enum AstType:
    Program         = 0;
    Block           = 1;
    FuncDef         = 2;
    VarDecl         = 3;
    ConstDecl       = 4;
    Assign          = 5;
    IndexAssign     = 6;
    FieldAssign     = 7;
    IfStmt          = 8;
    LoopStmt        = 9;
    WhileStmt       = 10;
    ForRange        = 11;
    ReturnStmt      = 12;
    PrintStmt       = 13;
    BreakStmt       = 14;
    ContinueStmt    = 15;
    EnumDef         = 16;
    EntityDef       = 17;
    ImportStmt      = 18;
    ModuleStmt      = 19;
    ExportStmt      = 20;
    IncludeStmt     = 21;
    LiteralInt      = 30;
    LiteralFloat    = 31;
    LiteralStr      = 32;
    Identifier      = 33;
    BinOp           = 34;
    Compare         = 35;
    Call            = 36;
    BuiltinCall     = 37;
    InputExpr       = 38;
    ArrayLiteral    = 39;
    IndexAccess     = 40;
    FieldAccess     = 41;
    EnumAccess      = 42;
    EntityLiteral   = 43;
    CheckCpu        = 50;
    PatchPoint      = 51;
    ExternFunc      = 52;
    WhenStmt        = 53;
    CastExpr        = 54;
    UnaryMinus      = 55;
    ExprIndex       = 56;
    TupleExpr       = 57;
    # Phase 8: New language features
    ThrowStmt       = 58;
    EnsureBlock     = 59;
    RevertBlock     = 60;
    InterpExpr      = 61;
    MethodCall      = 62;
    PackedDef       = 63;
    RegisterDef     = 64;
    BindAttr        = 65;
    RefParam        = 66;
    CaseExpr        = 67;
    # §22 / §4.5 additions (Phase 7.2 parity)
    ArenaBlock      = 68;
    AwaitExpr       = 69;
    CancelStmt      = 70;
    QuietStmt       = 71;
    NamedArg        = 72;
    AddrOf          = 73;
end


# ═══════════════════════════════════════════════════════
# Operator Types
# ═══════════════════════════════════════════════════════

enum OpType:
    Add     = 0;
    Sub     = 1;
    Mul     = 2;
    Div     = 3;
    ModOp   = 4;
    Eq      = 10;
    Ne      = 11;
    Gt      = 12;
    Lt      = 13;
    Ge      = 14;
    Le      = 15;
    AndOp   = 20;
    OrOp    = 21;
    XorOp   = 22;
    ShlOp   = 23;
    ShrOp   = 24;
    PowOp   = 25;
end


# ═══════════════════════════════════════════════════════
# AST Node
# ═══════════════════════════════════════════════════════

entity AstNode:
    name:           string;
    name2:          string;
    node_type:      AstType;
    op:             OpType;
    line:           int;
    int_val:        int;
    float_val:      float;
    builtin_id:     int;
    children:       int;
end

func ast_new:
    in(typ:AstType)
    out AstNode {;
        name:       "",;
        name2:      "",;
        node_type:  typ,;
        op:         OpType::Add,;
        line:       0,;
        int_val:    0,;
        float_val:  0.0,;
        builtin_id: 0,;
        children:   vec_new_rt();
    };
end

func ast_add_child:
    in(parent:AstNode; child:AstNode)
    parent.children = vec_push_rt(parent.children, child);
    out parent;
end


# ═══════════════════════════════════════════════════════
# Builtin Function Lookup
# ═══════════════════════════════════════════════════════

enum BuiltinId:
    None            = 0;
    Len             = 1;
    Push            = 2;
    Alloc           = 3;
    FreeMem         = 4;
    Read8           = 5;
    Write8          = 6;
    Read64          = 7;
    Write64         = 8;
    StrLen          = 9;
    StrGet          = 10;
    StrCat          = 11;
    StrEq           = 12;
    FileOpen        = 13;
    FileRead        = 14;
    FileWrite       = 15;
    FileClose       = 16;
    FileWriteByte   = 17;
    Exit            = 18;
    IToStr          = 19;
    StrToI          = 20;
    ArrNew          = 21;
    PrintStr        = 22;
    GetArg          = 23;
    ArgCount        = 24;
    # Phase 7: New intrinsics
    Syscall         = 30;
    MemCopy         = 31;
    MemSet          = 32;
    CLZ             = 33;
    CTZ             = 34;
    PopCnt          = 35;
    BSwap           = 36;
    BitNot          = 37;
    BitNeg          = 38;
    Fence           = 39;
    AtomicLoad      = 40;
    AtomicStore     = 41;
    AtomicCas       = 42;
    AtomicAdd       = 43;
    AtomicSub       = 44;
    Trap            = 45;
    Unreachable     = 46;
    AlignPtr        = 47;
    # §19 / §4.5 / §22 additions (Phase 7.2 parity)
    Yield           = 48;
    ArenaNew        = 49;
    ArenaAlloc      = 50;
    ArenaFree       = 51;
    Cap             = 52;
    ArrCompact      = 53;
end

entity BuiltinEntry:
    name:   string;
    bid:    BuiltinId;
end

func build_builtins:
    table = vec_new_rt();
    table = vec_push_rt(table, BuiltinEntry { name: "len", bid: BuiltinId::Len });
    table = vec_push_rt(table, BuiltinEntry { name: "push", bid: BuiltinId::Push });
    table = vec_push_rt(table, BuiltinEntry { name: "alloc", bid: BuiltinId::Alloc });
    table = vec_push_rt(table, BuiltinEntry { name: "dealloc", bid: BuiltinId::FreeMem });
    table = vec_push_rt(table, BuiltinEntry { name: "read_byte", bid: BuiltinId::Read8 });
    table = vec_push_rt(table, BuiltinEntry { name: "write_byte", bid: BuiltinId::Write8 });
    table = vec_push_rt(table, BuiltinEntry { name: "read_word", bid: BuiltinId::Read64 });
    table = vec_push_rt(table, BuiltinEntry { name: "write_word", bid: BuiltinId::Write64 });
    table = vec_push_rt(table, BuiltinEntry { name: "str_len", bid: BuiltinId::StrLen });
    table = vec_push_rt(table, BuiltinEntry { name: "str_get", bid: BuiltinId::StrGet });
    table = vec_push_rt(table, BuiltinEntry { name: "str_cat", bid: BuiltinId::StrCat });
    table = vec_push_rt(table, BuiltinEntry { name: "str_eq", bid: BuiltinId::StrEq });
    table = vec_push_rt(table, BuiltinEntry { name: "file_open", bid: BuiltinId::FileOpen });
    table = vec_push_rt(table, BuiltinEntry { name: "file_read", bid: BuiltinId::FileRead });
    table = vec_push_rt(table, BuiltinEntry { name: "file_write", bid: BuiltinId::FileWrite });
    table = vec_push_rt(table, BuiltinEntry { name: "file_close", bid: BuiltinId::FileClose });
    table = vec_push_rt(table, BuiltinEntry { name: "file_write_byte", bid: BuiltinId::FileWriteByte });
    table = vec_push_rt(table, BuiltinEntry { name: "exit_prog", bid: BuiltinId::Exit });
    table = vec_push_rt(table, BuiltinEntry { name: "i_to_str", bid: BuiltinId::IToStr });
    table = vec_push_rt(table, BuiltinEntry { name: "int_to_str", bid: BuiltinId::IToStr });
    table = vec_push_rt(table, BuiltinEntry { name: "str_to_i", bid: BuiltinId::StrToI });
    table = vec_push_rt(table, BuiltinEntry { name: "str_to_int", bid: BuiltinId::StrToI });
    table = vec_push_rt(table, BuiltinEntry { name: "arr_new", bid: BuiltinId::ArrNew });
    table = vec_push_rt(table, BuiltinEntry { name: "arr_push", bid: BuiltinId::Push });
    table = vec_push_rt(table, BuiltinEntry { name: "arr_len", bid: BuiltinId::Len });
    table = vec_push_rt(table, BuiltinEntry { name: "print_str", bid: BuiltinId::PrintStr });
    table = vec_push_rt(table, BuiltinEntry { name: "get_arg", bid: BuiltinId::GetArg });
    table = vec_push_rt(table, BuiltinEntry { name: "arg_count", bid: BuiltinId::ArgCount });
    # Phase 7: New intrinsics
    table = vec_push_rt(table, BuiltinEntry { name: "__syscall", bid: BuiltinId::Syscall });
    table = vec_push_rt(table, BuiltinEntry { name: "__memcpy", bid: BuiltinId::MemCopy });
    table = vec_push_rt(table, BuiltinEntry { name: "__memset", bid: BuiltinId::MemSet });
    table = vec_push_rt(table, BuiltinEntry { name: "__clz", bid: BuiltinId::CLZ });
    table = vec_push_rt(table, BuiltinEntry { name: "__ctz", bid: BuiltinId::CTZ });
    table = vec_push_rt(table, BuiltinEntry { name: "__popcnt", bid: BuiltinId::PopCnt });
    table = vec_push_rt(table, BuiltinEntry { name: "__bswap", bid: BuiltinId::BSwap });
    table = vec_push_rt(table, BuiltinEntry { name: "__not", bid: BuiltinId::BitNot });
    table = vec_push_rt(table, BuiltinEntry { name: "__neg", bid: BuiltinId::BitNeg });
    table = vec_push_rt(table, BuiltinEntry { name: "__fence", bid: BuiltinId::Fence });
    table = vec_push_rt(table, BuiltinEntry { name: "__atomic_load", bid: BuiltinId::AtomicLoad });
    table = vec_push_rt(table, BuiltinEntry { name: "__atomic_store", bid: BuiltinId::AtomicStore });
    table = vec_push_rt(table, BuiltinEntry { name: "__atomic_cas", bid: BuiltinId::AtomicCas });
    table = vec_push_rt(table, BuiltinEntry { name: "__atomic_add", bid: BuiltinId::AtomicAdd });
    table = vec_push_rt(table, BuiltinEntry { name: "__atomic_sub", bid: BuiltinId::AtomicSub });
    table = vec_push_rt(table, BuiltinEntry { name: "__trap", bid: BuiltinId::Trap });
    table = vec_push_rt(table, BuiltinEntry { name: "__unreachable", bid: BuiltinId::Unreachable });
    table = vec_push_rt(table, BuiltinEntry { name: "__align", bid: BuiltinId::AlignPtr });
    # §19/§4.5/§22 runtime hooks
    table = vec_push_rt(table, BuiltinEntry { name: "yield", bid: BuiltinId::Yield });
    table = vec_push_rt(table, BuiltinEntry { name: "nhường", bid: BuiltinId::Yield });
    table = vec_push_rt(table, BuiltinEntry { name: "arena_new", bid: BuiltinId::ArenaNew });
    table = vec_push_rt(table, BuiltinEntry { name: "arena_alloc", bid: BuiltinId::ArenaAlloc });
    table = vec_push_rt(table, BuiltinEntry { name: "arena_free", bid: BuiltinId::ArenaFree });
    table = vec_push_rt(table, BuiltinEntry { name: "vùng_mới", bid: BuiltinId::ArenaNew });
    table = vec_push_rt(table, BuiltinEntry { name: "vùng_cấp", bid: BuiltinId::ArenaAlloc });
    table = vec_push_rt(table, BuiltinEntry { name: "vùng_giải", bid: BuiltinId::ArenaFree });
    table = vec_push_rt(table, BuiltinEntry { name: "cap", bid: BuiltinId::Cap });
    table = vec_push_rt(table, BuiltinEntry { name: "sức_chứa", bid: BuiltinId::Cap });
    table = vec_push_rt(table, BuiltinEntry { name: "arr_compact", bid: BuiltinId::ArrCompact });
    table = vec_push_rt(table, BuiltinEntry { name: "nén_mảng", bid: BuiltinId::ArrCompact });
    out table;
end

func lookup_builtin:
    in(table:int; name:string)
    i = 0;
    when i < vec_len_rt(table) loop
        entry = vec_get_rt(table, i);
        if rt_streq(entry.name, name):
            out entry.bid;
        end
        i = i + 1;
    end
    out BuiltinId::None;
end


# ═══════════════════════════════════════════════════════
# Parser State
# ═══════════════════════════════════════════════════════

entity Parser:
    tokens:         int;
    pos:            int;
    token_count:    int;
    error:          string;
    error_line:     int;
    builtins:       int;
end

func parser_new:
    in(tokens:int)
    tc = vec_len_rt(tokens);
    bi = build_builtins();
    p = Parser {;
        tokens:      tokens,;
        pos:         0,;
        token_count: tc,;
        error:       "",;
        error_line:  0,;
        builtins:    bi;
    };
    out p;
end


# ═══════════════════════════════════════════════════════
# Parser Helpers
# ═══════════════════════════════════════════════════════

func parse_error:
    in(p:Parser; msg:string)
    if rt_strlen(p.error) == 0:
        t = peek(p);
        p.error = rt_strcat(rt_strcat("line ", rt_itoa(t.line >> int)), rt_strcat(": ", msg));
        p.error_line = t.line;
    end
    out p;
end

func peek:
    in(p:Parser)
    idx = p.pos;
    if idx >= p.token_count:
        idx = p.token_count - 1;
    end
    out vec_get_rt(p.tokens, idx >> int);
end

func advance:
    in(p:Parser)
    t = peek(p);
    if p.pos < p.token_count:
        p.pos = p.pos + 1;
    end
    out (p, t);
end

func check:
    in(p:Parser; tok_type:TokType)
    out peek(p).tok_type == tok_type;
end

func match_tok:
    in(p:Parser; tok_type:TokType)
    if check(p, tok_type):
        var (p2, _) = advance(p);
        out (p2, true);
    end
    out (p, false);
end

func expect_tok:
    in(p:Parser; tok_type:TokType; msg:string)
    if check(p, tok_type):
        var (p2, t) = advance(p);
        out (p2, t, true);
    end
    p = parse_error(p, msg);
    out (p, peek(p), false);
end

func skip_newlines:
    in(p:Parser)
    when check(p, TokType::Newline) loop
        var (p2, _) = advance(p);
        p = p2;
    end
    out p;
end

func is_stmt_start:
    in(t:TokType)
    out t == TokType::Var or t == TokType::Const or t == TokType::If or;
        t == TokType::Loop or t == TokType::While or t == TokType::When or t == TokType::For or;
        t == TokType::Out or t == TokType::Print or t == TokType::Input or;
        t == TokType::Ident or t == TokType::Int or t == TokType::Float or;
        t == TokType::Str or t == TokType::LParen or t == TokType::Minus or;
        t == TokType::Not or t == TokType::CheckCpu or t == TokType::Patch or;
        t == TokType::Func or t == TokType::Break or t == TokType::Skip or;
        t == TokType::True or t == TokType::False or t == TokType::LBracket or;
        t == TokType::Enum or t == TokType::Entity or;
        t == TokType::Import or t == TokType::From or t == TokType::Module or;
        t == TokType::Export or t == TokType::Include;
end


# ═══════════════════════════════════════════════════════
# Expression Parsing (precedence climbing)
# ═══════════════════════════════════════════════════════

func parse_primary:
    in(p:Parser)
    t = peek(p);

    # Integer literal
    if t.tok_type == TokType::Int:
        var (p2, t2) = advance(p);
        n = ast_new(AstType::LiteralInt);
        n.int_val = t2.tok_ival;
        n.line = t2.line;
        out (p2, n);
    end

    # Float literal
    if t.tok_type == TokType::Float:
        var (p2, t2) = advance(p);
        n = ast_new(AstType::LiteralFloat);
        n.float_val = t2.tok_fval;
        n.line = t2.line;
        out (p2, n);
    end

    # String literal
    if t.tok_type == TokType::Str:
        var (p2, t2) = advance(p);
        n = ast_new(AstType::LiteralStr);
        n.name = t2.str_val;
        n.line = t2.line;
        out (p2, n);
    end

    # Interpolated string: InterpStart Str Ident [Dot Ident] Str ... InterpEnd
    if t.tok_type == TokType::InterpStart:
        var (p2, _) = advance(p);
        interp = ast_new(AstType::InterpExpr);
        interp.line = t.line;
        when not check(p2, TokType::InterpEnd) and not check(p2, TokType::Eof) loop
            it = peek(p2);
            if it.tok_type == TokType::Str:
                var (p3, st) = advance(p2);
                seg = ast_new(AstType::LiteralStr);
                seg.name = st.str_val;
                seg.line = st.line;
                interp = ast_add_child(interp, seg);
                p2 = p3;
            eif it.tok_type == TokType::Ident:
                var (p3, id_t) = advance(p2);
                # Check for .field access
                if check(p3, TokType::Dot):
                    var (p4, _) = advance(p3);
                    var (p5, fld_t, _) = expect_tok(p4, TokType::Ident, "expected field after '.'");
                    fa = ast_new(AstType::FieldAccess);
                    fa.name = fld_t.str_val;
                    fa.line = fld_t.line;
                    base = ast_new(AstType::Identifier);
                    base.name = id_t.str_val;
                    base.line = id_t.line;
                    fa = ast_add_child(fa, base);
                    interp = ast_add_child(interp, fa);
                    p2 = p5;
                else
                    seg = ast_new(AstType::Identifier);
                    seg.name = id_t.str_val;
                    seg.line = id_t.line;
                    interp = ast_add_child(interp, seg);
                    p2 = p3;
                end
            else
                # Unexpected token in interpolation - skip
                var (p3, _) = advance(p2);
                p2 = p3;
            end
        end
        var (p3, _) = match_tok(p2, TokType::InterpEnd);
        out (p3, interp);
    end

    # 'this' keyword used as identifier in method body
    if t.tok_type == TokType::ThisKw:
        var (p2, _) = advance(p);
        n = ast_new(AstType::Identifier);
        n.name = "this";
        n.line = t.line;
        out (p2, n);
    end

    # Boolean true
    if t.tok_type == TokType::True:
        var (p2, _) = advance(p);
        n = ast_new(AstType::LiteralInt);
        n.int_val = 1;
        n.line = t.line;
        out (p2, n);
    end

    # Boolean false / none
    if t.tok_type == TokType::False or t.tok_type == TokType::NoneLit:
        var (p2, _) = advance(p);
        n = ast_new(AstType::LiteralInt);
        n.int_val = 0;
        n.line = t.line;
        out (p2, n);
    end

    # Identifier (may be call, index, entity literal...)
    if t.tok_type == TokType::Ident:
        var (p2, id_tok) = advance(p);

        # Check for enum access: IDENT '::' variant
        if check(p, TokType::DoubleColon):
            var (p3, _) = advance(p);  # consume ::
            # The variant name might be a keyword (e.g. TokType::Func)
            # Accept any token that has a str_val
            vt = peek(p3);
            var (p4, _) = advance(p3);
            ea = ast_new(AstType::EnumAccess);
            ea.name = id_tok.str_val;
            ea.name2 = vt.str_val;
            ea.line = id_tok.line;
            out (p4, ea);
        end

        # Check for entity literal: IDENT '{' field: val, ... '}'
        if check(p, TokType::LBrace) and check_entity_literal(p):
            var (p3, _) = advance(p)  # consume '{';
            el = ast_new(AstType::EntityLiteral);
            el.name = id_tok.str_val;
            el.line = id_tok.line;
            p3 = skip_newlines(p3);    # skip optional newline/semicolon after '{'
            var (p3, _) = match_tok(p3, TokType::Semicolon);
            p3 = skip_newlines(p3);
            when not check(p3, TokType::RBrace) and not check(p3, TokType::Eof) loop
                var (p4, fname, ok) = expect_tok(p3, TokType::Ident, "expected field name");
                p3 = p4;
                if not ok:
                    out (p3, el);
                end
                var (p5, _, _) = expect_tok(p3, TokType::Colon, "expected ':' after field");
                p3 = p5;
                var (p6, val) = parse_expr(p3);
                p3 = p6;
                val.name2 = fname.str_val;
                el = ast_add_child(el, val);
                var (p7, _) = match_tok(p3, TokType::Comma);
                p3 = p7;
                p3 = skip_newlines(p3);
            end
            var (p8, _, _) = expect_tok(p3, TokType::RBrace, "expected '}' after entity literal");
            out (p8, el);
        end

        # Check for generic call: IDENT '<' Type '>' '(' ... ')'
        # Skip generic type parameters and treat as regular call
        if check(p, TokType::Lt):
            # Try to match: < IDENT [, IDENT]* > (
            # Only attempt generic detection if token after '<' is an identifier
            save_pos = p.pos;
            p.pos = p.pos + 1;
            next_tok_type = peek(p).tok_type;
            p.pos = save_pos;
            if next_tok_type == TokType::Ident:
                var (p_g1, _) = advance(p);  # consume <
                depth = 1;
                success = false;
                when depth > 0 and not check(p_g1, TokType::Eof) loop
                    g_tok = peek(p_g1);
                    if g_tok.tok_type == TokType::Lt:
                        depth = depth + 1;
                    end
                    if g_tok.tok_type == TokType::Gt:
                        depth = depth - 1;
                    end
                    var (p_g2, _) = advance(p_g1);
                    p_g1 = p_g2;
                end
                # After '>', check for '(' — if found, it's a generic call
                if depth == 0 and check(p_g1, TokType::LParen):
                    p = p_g1;
                    success = true;
                else
                    p.pos = save_pos;
                end
            end
        end

        # Check for function call: IDENT '('
        if check(p, TokType::LParen):
            bid = lookup_builtin(p.builtins, id_tok.str_val);
            if bid != BuiltinId::None:
                # Builtin call
                call = ast_new(AstType::BuiltinCall);
                call.builtin_id = bid >> int;
                call.name = id_tok.str_val;
                call.line = id_tok.line;
                var (p3, _) = advance(p)  # consume '(';
                if not check(p3, TokType::RParen):
                    var (p4, arg) = parse_expr(p3);
                    p3 = p4;
                    call = ast_add_child(call, arg);
                    should_loop = true;
                    when should_loop loop
                        var (p5, matched) = match_tok(p3, TokType::Comma);
                        p3 = p5;
                        if not matched:
                            should_loop = false;
                        else
                            var (p6, arg2) = parse_expr(p3);
                            p3 = p6;
                            call = ast_add_child(call, arg2);
                        end
                    end
                end
                var (p7, _, _) = expect_tok(p3, TokType::RParen, "expected ')' after builtin args");
                out (p7, call);
            end

            # Regular function call
            call = ast_new(AstType::Call);
            call.name = id_tok.str_val;
            call.line = id_tok.line;
            p.pos = p.pos + 1;  # consume '('
            if not check(p, TokType::RParen):
                # Detect named args: IDENT followed by '='
                is_named = false;
                if p.pos + 1 < p.token_count:
                    na_tok1 = vec_get_rt(p.tokens, p.pos);
                    na_tok2 = vec_get_rt(p.tokens, p.pos + 1);
                    if na_tok1.tok_type == TokType::Ident and na_tok2.tok_type == TokType::Assign:
                        is_named = true;
                    end
                end
                if is_named:
                    call.int_val = 1;
                    should_loop2 = true;
                    when should_loop2 loop
                        name_ident_tok = peek(p);
                        p.pos = p.pos + 1;  # consume name
                        p.pos = p.pos + 1;  # consume '='
                        var (p_na, val_expr) = parse_expr(p);
                        p = p_na;
                        val_expr.name = name_ident_tok.str_val;
                        call = ast_add_child(call, val_expr);
                        var (p_sc, sc_matched) = match_tok(p, TokType::Semicolon);
                        p = p_sc;
                        if not sc_matched:
                            should_loop2 = false;
                        end
                    end
                else
                    var (p4, arg) = parse_expr(p);
                    p = p4;
                    call = ast_add_child(call, arg);
                    should_loop = true;
                    when should_loop loop
                        var (p5, matched) = match_tok(p, TokType::Comma);
                        p = p5;
                        if not matched:
                            should_loop = false;
                        else
                            var (p6, arg2) = parse_expr(p);
                            p = p6;
                            call = ast_add_child(call, arg2);
                        end
                    end
                end
            end
            var (p7, _, _) = expect_tok(p, TokType::RParen, "expected ')' after arguments");
            out (p7, call);
        end

        # Check for index access: IDENT '['
        if check(p, TokType::LBracket):
            var (p3, _) = advance(p)  # consume '[';
            var (p4, idx_expr) = parse_expr(p3);
            var (p5, _, _) = expect_tok(p4, TokType::RBracket, "expected ']' after index");
            access = ast_new(AstType::IndexAccess);
            access.name = id_tok.str_val;
            access.line = id_tok.line;
            access = ast_add_child(access, idx_expr);
            out (p5, access);
        end

        # Plain identifier
        n = ast_new(AstType::Identifier);
        n.name = id_tok.str_val;
        n.line = id_tok.line;
        out (p, n);
    end

    # Input expression
    if t.tok_type == TokType::Input:
        var (p2, _) = advance(p);
        n = ast_new(AstType::InputExpr);
        n.line = t.line;
        out (p2, n);
    end

    # Parenthesised expression
    if t.tok_type == TokType::LParen:
        var (p2, _) = advance(p);
        var (p3, inner) = parse_expr(p2);
        var (p4, _, _) = expect_tok(p3, TokType::RParen, "expected ')'");
        out (p4, inner);
    end

    # Array literal: [elem, ...]
    if t.tok_type == TokType::LBracket:
        var (p2, _) = advance(p);
        arr = ast_new(AstType::ArrayLiteral);
        arr.line = t.line;
        if not check(p2, TokType::RBracket):
            var (p3, elem) = parse_expr(p2);
            p2 = p3;
            arr = ast_add_child(arr, elem);
            should_loop = true;
            when should_loop loop
                var (p4, matched) = match_tok(p2, TokType::Comma);
                p2 = p4;
                if not matched:
                    should_loop = false;
                else
                    var (p5, elem2) = parse_expr(p2);
                    p2 = p5;
                    arr = ast_add_child(arr, elem2);
                end
            end
        end
        var (p6, _, _) = expect_tok(p2, TokType::RBracket, "expected ']' after array literal");
        out (p6, arr);
    end

    # Error — expected expression
    p = parse_error(p, "expected expression");
    out (p, ast_new(AstType::LiteralInt));
end


func check_entity_literal:
    in(p:Parser)
    # Check if '{' starts an entity literal (lookahead for '{' IDENT ':' or '{' '}' or '{ ;')
    if not check(p, TokType::LBrace):
        out false;
    end
    next_idx = p.pos + 1;
    if next_idx < p.token_count:
        t1 = vec_get_rt(p.tokens, next_idx >> int);
        # Empty entity: Name { }
        if t1.tok_type == TokType::RBrace:
            out true;
        end
        # Entity with fields on next line: Name {; field: val ... }
        if t1.tok_type == TokType::Newline or t1.tok_type == TokType::Semicolon:
            out true;
        end
        if next_idx + 1 < p.token_count:
            t2 = vec_get_rt(p.tokens, (next_idx + 1) >> int);
            if t1.tok_type == TokType::Ident and t2.tok_type == TokType::Colon:
                out true;
            end
        end
    end
    out false;
end


func parse_unary:
    in(p:Parser)
    # Unary minus
    if check(p, TokType::Minus):
        var (p2, t) = advance(p);
        var (p3, operand) = parse_unary(p2);
        zero = ast_new(AstType::LiteralInt);
        zero.int_val = 0;
        zero.line = t.line;
        n = ast_new(AstType::BinOp);
        n.op = OpType::Sub;
        n.line = t.line;
        n = ast_add_child(n, zero);
        n = ast_add_child(n, operand);
        out (p3, n);
    end

    # Unary NOT
    if check(p, TokType::Not):
        var (p2, t) = advance(p);
        var (p3, operand) = parse_unary(p2);
        zero = ast_new(AstType::LiteralInt);
        zero.int_val = 0;
        zero.line = t.line;
        n = ast_new(AstType::Compare);
        n.op = OpType::Eq;
        n.line = t.line;
        n = ast_add_child(n, operand);
        n = ast_add_child(n, zero);
        out (p3, n);
    end

    # Primary with optional postfix '.' field access / UFCS method call
    var (p2, left) = parse_primary(p);
    when check(p2, TokType::Dot) loop
        var (p3, _) = advance(p2);
        var (p4, field, ok) = expect_tok(p3, TokType::Ident, "expected field name after '.'");
        if not ok:
            out (p4, left);
        end
        # UFCS: obj.method(args) → MethodCall(name=method, children=[obj, args...])
        if check(p4, TokType::LParen):
            mc = ast_new(AstType::MethodCall);
            mc.name = field.str_val;
            mc.line = field.line;
            mc = ast_add_child(mc, left);
            var (p5, _) = advance(p4);
            if not check(p5, TokType::RParen):
                var (p6, arg) = parse_expr(p5);
                p5 = p6;
                mc = ast_add_child(mc, arg);
                mc_loop = true;
                when mc_loop loop
                    var (p7, mc_matched) = match_tok(p5, TokType::Comma);
                    p5 = p7;
                    if not mc_matched:
                        mc_loop = false;
                    else
                        var (p8, arg2) = parse_expr(p5);
                        p5 = p8;
                        mc = ast_add_child(mc, arg2);
                    end
                end
            end
            var (p9, _, _) = expect_tok(p5, TokType::RParen, "expected ')' after method args");
            left = mc;
            p2 = p9;
        else
            fa = ast_new(AstType::FieldAccess);
            fa.name = field.str_val;
            fa.line = field.line;
            fa = ast_add_child(fa, left);
            left = fa;
            p2 = p4;
        end
    end
    out (p2, left);
end


func parse_power:
    in(p:Parser)
    var (p2, left) = parse_unary(p);
    when check(p2, TokType::Power) loop
        var (p3, op_tok) = advance(p2);
        var (p4, right) = parse_unary(p3);
        bin = ast_new(AstType::BinOp);
        bin.op = OpType::PowOp;
        bin.line = op_tok.line;
        bin = ast_add_child(bin, left);
        bin = ast_add_child(bin, right);
        left = bin;
        p2 = p4;
    end
    out (p2, left);
end


func parse_mult:
    in(p:Parser)
    var (p2, left) = parse_power(p);

    when check(p2, TokType::Star) or check(p2, TokType::Slash) or check(p2, TokType::Percent) loop
        var (p3, op_tok) = advance(p2);
        op = OpType::Mul;
        if op_tok.tok_type == TokType::Slash:
            op = OpType::Div;
        end
        if op_tok.tok_type == TokType::Percent:
            op = OpType::ModOp;
        end
        var (p4, right) = parse_power(p3);
        bin = ast_new(AstType::BinOp);
        bin.op = op;
        bin.line = op_tok.line;
        bin = ast_add_child(bin, left);
        bin = ast_add_child(bin, right);
        left = bin;
        p2 = p4;
    end
    out (p2, left);
end


func parse_addition:
    in(p:Parser)
    var (p2, left) = parse_mult(p);

    when check(p2, TokType::Plus) or check(p2, TokType::Minus) loop
        var (p3, op_tok) = advance(p2);
        op = OpType::Add;
        if op_tok.tok_type == TokType::Minus:
            op = OpType::Sub;
        end
        var (p4, right) = parse_mult(p3);
        bin = ast_new(AstType::BinOp);
        bin.op = op;
        bin.line = op_tok.line;
        bin = ast_add_child(bin, left);
        bin = ast_add_child(bin, right);
        left = bin;
        p2 = p4;
    end
    out (p2, left);
end


func parse_bitwise:
    in(p:Parser)
    var (p2, left) = parse_addition(p);

    is_bitwise = check(p2, TokType::BitAnd) or check(p2, TokType::BitOr) or;
                 check(p2, TokType::BitXor) or check(p2, TokType::BitShl) or;
                 check(p2, TokType::BitShr);
    when is_bitwise loop
        var (p3, op_tok) = advance(p2);
        op = OpType::AndOp;
        if op_tok.tok_type == TokType::BitOr:
            op = OpType::OrOp;
        end
        if op_tok.tok_type == TokType::BitXor:
            op = OpType::XorOp;
        end
        if op_tok.tok_type == TokType::BitShl:
            op = OpType::ShlOp;
        end
        if op_tok.tok_type == TokType::BitShr:
            op = OpType::ShrOp;
        end
        var (p4, right) = parse_addition(p3);
        bin = ast_new(AstType::BinOp);
        bin.op = op;
        bin.line = op_tok.line;
        bin = ast_add_child(bin, left);
        bin = ast_add_child(bin, right);
        left = bin;
        p2 = p4;
        is_bitwise = check(p2, TokType::BitAnd) or check(p2, TokType::BitOr) or;
                     check(p2, TokType::BitXor) or check(p2, TokType::BitShl) or;
                     check(p2, TokType::BitShr);
    end
    out (p2, left);
end


func parse_compare:
    in(p:Parser)
    var (p2, left) = parse_bitwise(p);

    has_cmp = check(p2, TokType::Eq) or check(p2, TokType::Ne) or;
              check(p2, TokType::Gt) or check(p2, TokType::Lt) or;
              check(p2, TokType::Ge) or check(p2, TokType::Le);
    if has_cmp:
        var (p3, op_tok) = advance(p2);
        op = OpType::Eq;
        if op_tok.tok_type == TokType::Ne:
            op = OpType::Ne;
        end
        if op_tok.tok_type == TokType::Gt:
            op = OpType::Gt;
        end
        if op_tok.tok_type == TokType::Lt:
            op = OpType::Lt;
        end
        if op_tok.tok_type == TokType::Ge:
            op = OpType::Ge;
        end
        if op_tok.tok_type == TokType::Le:
            op = OpType::Le;
        end
        var (p4, right) = parse_bitwise(p3);
        cmp = ast_new(AstType::Compare);
        cmp.op = op;
        cmp.line = op_tok.line;
        cmp = ast_add_child(cmp, left);
        cmp = ast_add_child(cmp, right);
        out (p4, cmp);
    end
    out (p2, left);
end


func parse_and_expr:
    in(p:Parser)
    var (p2, left) = parse_compare(p);

    when check(p2, TokType::And) loop
        var (p3, _) = advance(p2);
        var (p4, right) = parse_compare(p3);
        bin = ast_new(AstType::BinOp);
        bin.op = OpType::AndOp;
        bin = ast_add_child(bin, left);
        bin = ast_add_child(bin, right);
        left = bin;
        p2 = p4;
    end
    out (p2, left);
end


func parse_or_expr:
    in(p:Parser)
    var (p2, left) = parse_and_expr(p);

    when check(p2, TokType::Or) loop
        var (p3, _) = advance(p2);
        var (p4, right) = parse_and_expr(p3);
        bin = ast_new(AstType::BinOp);
        bin.op = OpType::OrOp;
        bin = ast_add_child(bin, left);
        bin = ast_add_child(bin, right);
        left = bin;
        p2 = p4;
    end
    out (p2, left);
end


func parse_expr:
    in(p:Parser)
    out parse_or_expr(p);
end


# ═══════════════════════════════════════════════════════
# Statement Parsing
# ═══════════════════════════════════════════════════════

func parse_block:
    in(p:Parser)
    block = ast_new(AstType::Block);
    p = skip_newlines(p);

    should_continue = true;
    when should_continue loop
        if check(p, TokType::End) or check(p, TokType::Else) or check(p, TokType::Eif) or check(p, TokType::Eof) or check(p, TokType::EnsureKw) or check(p, TokType::RevertKw):
            should_continue = false;
        eif check(p, TokType::ThrowKw):
            var (p_t, _) = advance(p);
            var (p_t2, throw_expr) = parse_expr(p_t);
            n_throw = ast_new(AstType::ThrowStmt);
            n_throw.line = peek(p).line;
            n_throw = ast_add_child(n_throw, throw_expr);
            block = ast_add_child(block, n_throw);
            p = p_t2;
            p = skip_newlines(p);
        else
            var (p2, stmt) = parse_statement(p);
            p = p2;
            block = ast_add_child(block, stmt);
            if rt_strlen(p.error) > 0:
                out (p, block);
            end
            # Skip optional trailing semicolons
            when check(p, TokType::Semicolon) loop
                var (p_semi, _) = advance(p);
                p = p_semi;
            end
            p = skip_newlines(p);
        end
    end
    out (p, block);
end


func parse_var_decl:
    in(p:Parser; is_const:bool)
    var (p2, name_tok, ok) = expect_tok(p, TokType::Ident, "expected variable name");
    if not ok:
        out (p2, ast_new(AstType::VarDecl));
    end

    decl_type = AstType::VarDecl;
    if is_const:
        decl_type = AstType::ConstDecl;
    end
    decl = ast_new(decl_type);
    decl.name = name_tok.str_val;
    decl.line = name_tok.line;

    var (p3, matched) = match_tok(p2, TokType::Assign);
    if not matched:
        # Also accept : as separator for const decls (const FOO: 42;)
        var (p3b, matched2) = match_tok(p2, TokType::Colon);
        if matched2:
            matched = true;
            p3 = p3b;
        end
    end
    if matched:
        var (p4, init) = parse_expr(p3);
        decl = ast_add_child(decl, init);
        # Skip optional semicolon
        var (p5, _) = match_tok(p4, TokType::Semicolon);
        out (p5, decl);
    end
    out (p3, decl);
end

func parse_const_decl:
    in(p:Parser)
    var (p2, decl) = parse_var_decl(p, false);
    decl.node_type = AstType::ConstDecl;
    decl.name2 = "const";
    out (p2, decl);
end


func parse_if_stmt:
    in(p:Parser)
    line = peek(p).line;
    var (p2, cond) = parse_expr(p);

    # Optional colon or 'do' after condition (v1.2 style: if x > 5 do)
    var (p2b, _) = match_tok(p2, TokType::Colon);
    p2 = p2b;
    var (p2c, _) = match_tok(p2, TokType::Do);
    p2 = p2c;

    # Implicit block opening (v1.2: no 'then' keyword needed)
    p2 = skip_newlines(p2);

    var (p3, then_block) = parse_block(p2);

    if_node = ast_new(AstType::IfStmt);
    if_node.line = line;
    if_node = ast_add_child(if_node, cond);
    if_node = ast_add_child(if_node, then_block);

    # Handle eif (elif)
    if check(p3, TokType::Eif):
        var (p4, _) = advance(p3);
        var (p5, elif_as_if) = parse_if_stmt(p4);
        else_block = ast_new(AstType::Block);
        else_block = ast_add_child(else_block, elif_as_if);
        if_node = ast_add_child(if_node, else_block);
        out (p5, if_node);
    end

    # Handle else
    var (p4, has_else) = match_tok(p3, TokType::Else);
    if has_else:
        var (p4b, _) = match_tok(p4, TokType::Colon);
        p4 = p4b;
        p4 = skip_newlines(p4);
        var (p5, else_block) = parse_block(p4);
        if_node = ast_add_child(if_node, else_block);
        p4 = p5;
    end

    var (p5, _, _) = expect_tok(p4, TokType::End, "expected 'end' after if block");
    out (p5, if_node);
end


func parse_case_stmt:
    in(p:Parser)
    line = peek(p).line;
    var (p2, expr) = parse_expr(p);
    p2 = skip_newlines(p2);
    n = ast_new(AstType::CaseExpr);
    n.line = line;
    n = ast_add_child(n, expr);
    when not check(p2, TokType::Else) and not check(p2, TokType::End) and not check(p2, TokType::Eof) loop
        var (p3, val) = parse_expr(p2);
        var (p4, _) = match_tok(p3, TokType::Colon);
        var (p5, body) = parse_statement(p4);
        n = ast_add_child(n, val);
        n = ast_add_child(n, body);
        p2 = p5;
        p2 = skip_newlines(p2);
    end
    var (p3, has_else) = match_tok(p2, TokType::Else);
    if has_else:
        p3 = skip_newlines(p3);
        var (p4, else_body) = parse_block(p3);
        n = ast_add_child(n, else_body);
        n.int_val = 1;
        p3 = p4;
    end
    var (p4, _, _) = expect_tok(p3, TokType::End, "expected 'end' after case");
    out (p4, n);
end


func parse_loop_stmt:
    in(p:Parser)
    line = peek(p).line;
    var (p2, count) = parse_expr(p);
    var (p2b, _) = match_tok(p2, TokType::Colon);
    p2 = p2b;
    p2 = skip_newlines(p2);
    var (p3, body) = parse_block(p2);
    var (p4, _, _) = expect_tok(p3, TokType::End, "expected 'end' after loop block");
    n = ast_new(AstType::LoopStmt);
    n.line = line;
    n = ast_add_child(n, count);
    n = ast_add_child(n, body);
    out (p4, n);
end


func parse_while_stmt:
    in(p:Parser)
    line = peek(p).line;
    var (_, cond) = parse_expr(p);
    # C VM note: p is modified in-place by parse_expr; p2 from tuple is corrupted
    # Consume optional 'loop' keyword (when...loop syntax)
    var (_, _) = match_tok(p, TokType::Loop);
    var (_, _) = match_tok(p, TokType::Colon);
    p = skip_newlines(p);
    var (_, body) = parse_block(p);
    var (_, _, _) = expect_tok(p, TokType::End, "expected 'end' after while block");
    n = ast_new(AstType::WhileStmt);
    n.line = line;
    n = ast_add_child(n, cond);
    n = ast_add_child(n, body);
    out (p, n);
end


func parse_return_stmt:
    in(p:Parser)
    line = peek(p).line;
    n = ast_new(AstType::ReturnStmt);
    n.line = line;
    has_val = not check(p, TokType::Newline) and not check(p, TokType::End) and;
              not check(p, TokType::Eof) and not check(p, TokType::Else);
    if has_val:
        var (p2, val) = parse_expr(p);
        n = ast_add_child(n, val);
        out (p2, n);
    end
    out (p, n);
end


func parse_print_stmt:
    in(p:Parser)
    line = peek(p).line;
    n = ast_new(AstType::PrintStmt);
    n.line = line;
    var (p2, val) = parse_expr(p);
    n = ast_add_child(n, val);
    out (p2, n);
end


func parse_func_def:
    in(p:Parser)
    var (p2, name_tok, ok) = expect_tok(p, TokType::Ident, "expected function name");
    if not ok:
        out (p2, ast_new(AstType::FuncDef));
    end

    fn_node = ast_new(AstType::FuncDef);
    fn_node.name = name_tok.str_val;
    fn_node.line = name_tok.line;

    # Parse parameters (optional parens — `func name` and `func name(...)` both valid)
    if check(p2, TokType::LParen):
        var (p3, _) = advance(p2);

        # Parse parameters
        if not check(p3, TokType::RParen):
            # Check for 'this' as first parameter (method syntax)
            if check(p3, TokType::ThisKw):
                var (p_this, _) = advance(p3);
                p3 = p_this;
                param = ast_new(AstType::Identifier);
                param.name = "this";
                fn_node = ast_add_child(fn_node, param);
                fn_node.int_val = 1;
                # Skip optional type annotation `: type`
                if check(p3, TokType::Colon):
                    var (p_skip, _) = advance(p3);
                    p3 = p_skip;
                    if check(p3, TokType::Ident):
                        var (p_skip2, _) = advance(p3);
                        p3 = p_skip2;
                    end
                end
            else
                # Check for 'ref' modifier
                is_ref = false;
                if check(p3, TokType::RefKw):
                    var (p_ref, _) = advance(p3);
                    p3 = p_ref;
                    is_ref = true;
                end
                var (p4, param_tok, ok2) = expect_tok(p3, TokType::Ident, "expected parameter name");
                p3 = p4;
                if ok2:
                    if is_ref:
                        param = ast_new(AstType::RefParam);
                    else
                        param = ast_new(AstType::Identifier);
                    end
                    param.name = param_tok.str_val;
                    fn_node = ast_add_child(fn_node, param);
                end
                # Skip optional type annotation `: type`
                if check(p3, TokType::Colon):
                    var (p_skip, _) = advance(p3);
                    p3 = p_skip;
                    if check(p3, TokType::Ident):
                        var (p_skip2, _) = advance(p3);
                        p3 = p_skip2;
                    end
                end
            end
            # Handle semicolon-separated params (VIR style: `a:int; b:int`)
            should_loop = true;
            when should_loop loop
                has_sep = false;
                var (p5, matched_comma) = match_tok(p3, TokType::Comma);
                p3 = p5;
                if matched_comma:
                    has_sep = true;
                end
                if not has_sep:
                    var (p5b, matched_semi) = match_tok(p3, TokType::Semicolon);
                    p3 = p5b;
                    if matched_semi:
                        has_sep = true;
                    end
                end
                if not has_sep:
                    should_loop = false;
                else
                    # Check for 'ref' modifier on subsequent params
                    is_ref2 = false;
                    if check(p3, TokType::RefKw):
                        var (p_ref2, _) = advance(p3);
                        p3 = p_ref2;
                        is_ref2 = true;
                    end
                    var (p6, pt, ok3) = expect_tok(p3, TokType::Ident, "expected parameter name");
                    p3 = p6;
                    if ok3:
                        if is_ref2:
                            param2 = ast_new(AstType::RefParam);
                        else
                            param2 = ast_new(AstType::Identifier);
                        end
                        param2.name = pt.str_val;
                        fn_node = ast_add_child(fn_node, param2);
                    end
                    # Skip optional type annotation `: type`
                    if check(p3, TokType::Colon):
                        var (p_skip3, _) = advance(p3);
                        p3 = p_skip3;
                        if check(p3, TokType::Ident):
                            var (p_skip4, _) = advance(p3);
                            p3 = p_skip4;
                        end
                    end
                end
            end
        end

        var (p4, _, _) = expect_tok(p3, TokType::RParen, "expected ')' after parameters");
        p2 = p4;
    end

    # Skip optional return type `-> type`
    if check(p2, TokType::Arrow):
        var (p_arr, _) = advance(p2);
        p2 = p_arr;
        if check(p2, TokType::Ident):
            var (p_rt, _) = advance(p2);
            p2 = p_rt;
        end
    end

    # Skip optional trailing colon `:`
    var (p_colon, _) = match_tok(p2, TokType::Colon);
    p2 = p_colon;

    p2 = skip_newlines(p2);

    var (p5, body) = parse_block(p2);
    fn_node = ast_add_child(fn_node, body);

    # Parse optional ensure block (cleanup on normal exit)
    if check(p5, TokType::EnsureKw):
        var (p_ens, _) = advance(p5);
        var (p_ens2, _) = match_tok(p_ens, TokType::Colon);
        p_ens2 = skip_newlines(p_ens2);
        var (p_ens3, ensure_body) = parse_block(p_ens2);
        ensure_node = ast_new(AstType::EnsureBlock);
        ensure_node = ast_add_child(ensure_node, ensure_body);
        fn_node = ast_add_child(fn_node, ensure_node);
        p5 = p_ens3;
    end

    # Parse optional revert block (cleanup on error / early exit)
    if check(p5, TokType::RevertKw):
        var (p_rev, _) = advance(p5);
        var (p_rev2, _) = match_tok(p_rev, TokType::Colon);
        p_rev2 = skip_newlines(p_rev2);
        var (p_rev3, revert_body) = parse_block(p_rev2);
        revert_node = ast_new(AstType::RevertBlock);
        revert_node = ast_add_child(revert_node, revert_body);
        fn_node = ast_add_child(fn_node, revert_node);
        p5 = p_rev3;
    end

    var (p6, _, _) = expect_tok(p5, TokType::End, "expected 'end' to close function");
    # v1.2: definition blocks close with 'end.' — consume optional dot
    var (p6b, _) = match_tok(p6, TokType::Dot);
    out (p6b, fn_node);
end


func parse_for_range_stmt:
    in(p:Parser)
    line = peek(p).line;
    var (p2, var_tok, ok) = expect_tok(p, TokType::Ident, "expected loop variable");
    if not ok:
        out (p2, ast_new(AstType::ForRange));
    end

    var (p3, _, ok2) = expect_tok(p2, TokType::In, "expected 'in' after for variable");
    if not ok2:
        out (p3, ast_new(AstType::ForRange));
    end

    var (p4, start_expr) = parse_expr(p3);
    var (p5, _, ok3) = expect_tok(p4, TokType::DotDot, "expected '..' in range");
    if not ok3:
        out (p5, ast_new(AstType::ForRange));
    end

    var (p6, end_expr) = parse_expr(p5);
    var (p6b, _) = match_tok(p6, TokType::Colon);
    p6 = p6b;
    p6 = skip_newlines(p6);

    var (p7, body) = parse_block(p6);
    var (p8, _, _) = expect_tok(p7, TokType::End, "expected 'end' after for block");

    n = ast_new(AstType::ForRange);
    n.name = var_tok.str_val;
    n.line = line;
    n = ast_add_child(n, start_expr);
    n = ast_add_child(n, end_expr);
    n = ast_add_child(n, body);
    out (p8, n);
end


func parse_enum_def:
    in(p:Parser)
    line = peek(p).line;
    var (p2, name_tok, ok) = expect_tok(p, TokType::Ident, "expected enum name");
    if not ok:
        out (p2, ast_new(AstType::EnumDef));
    end

    p2 = skip_newlines(p2);

    en = ast_new(AstType::EnumDef);
    en.name = name_tok.str_val;
    en.line = line;

    # Consume optional ':' after enum name
    var (p2b, _) = match_tok(p2, TokType::Colon);
    p2 = p2b;
    p2 = skip_newlines(p2);

    next_val = 0;
    when not check(p2, TokType::End) and not check(p2, TokType::Eof) loop
        var (p3, vname, ok2) = expect_tok(p2, TokType::Ident, "expected enum variant");
        p2 = p3;
        if not ok2:
            out (p2, en);
        end

        val = next_val;
        var (p4, has_val) = match_tok(p2, TokType::Assign);
        if has_val:
            var (p5, vt, _) = expect_tok(p4, TokType::Int, "expected integer value");
            p2 = p5;
            val = vt.tok_ival;
        else
            p2 = p4;
        end
        next_val = val + 1;

        variant = ast_new(AstType::LiteralInt);
        variant.name = vname.str_val;
        variant.int_val = val;
        variant.line = vname.line;
        en = ast_add_child(en, variant);
        var (p6, _) = match_tok(p2, TokType::Semicolon);
        p2 = p6;
        p2 = skip_newlines(p2);
    end

    var (p3, _, _) = expect_tok(p2, TokType::End, "expected 'end' after enum");
    # v1.2: definition blocks close with 'end.' — consume optional dot
    var (p3b, _) = match_tok(p3, TokType::Dot);
    out (p3b, en);
end


func parse_entity_def:
    in(p:Parser)
    line = peek(p).line;
    var (p2, name_tok, ok) = expect_tok(p, TokType::Ident, "expected entity name");
    if not ok:
        out (p2, ast_new(AstType::EntityDef));
    end

    p2 = skip_newlines(p2);

    # Consume optional ':' after entity name
    var (p2b, _) = match_tok(p2, TokType::Colon);
    p2 = p2b;
    p2 = skip_newlines(p2);

    ed = ast_new(AstType::EntityDef);
    ed.name = name_tok.str_val;
    ed.line = line;

    when not check(p2, TokType::End) and not check(p2, TokType::Eof) loop
        var (p3, fname, ok2) = expect_tok(p2, TokType::Ident, "expected field name");
        p2 = p3;
        if not ok2:
            out (p2, ed);
        end

        field = ast_new(AstType::Identifier);
        field.name = fname.str_val;
        field.line = fname.line;

        # Optional type hint
        var (p4, has_colon) = match_tok(p2, TokType::Colon);
        if has_colon:
            if check(p4, TokType::Ident):
                var (p5, type_tok) = advance(p4);
                field.name2 = type_tok.str_val;
                p2 = p5;
            else
                p2 = p4;
            end
        else
            p2 = p4;
        end

        ed = ast_add_child(ed, field);
        var (p6, _) = match_tok(p2, TokType::Semicolon);
        p2 = p6;
        p2 = skip_newlines(p2);
    end

    var (p3, _, _) = expect_tok(p2, TokType::End, "expected 'end' after entity");
    # v1.2: definition blocks close with 'end.' — consume optional dot
    var (p3b, _) = match_tok(p3, TokType::Dot);
    out (p3b, ed);
end


func parse_statement:
    in(p:Parser)
    p = skip_newlines(p);
    t = peek(p);

    if t.tok_type == TokType::Extern:
        var (p2, _) = advance(p);
        # extern func name(params) -> type;
        if check(p2, TokType::Func):
            var (p3, _) = advance(p2);
            var (p4, name_tok, ok) = expect_tok(p3, TokType::Ident, "expected function name after extern func");
            n = ast_new(AstType::ExternFunc);
            n.name = name_tok.str_val;
            n.line = t.line;
            # Skip everything up to the next semicolon or newline
            when not check(p4, TokType::Semicolon) and not check(p4, TokType::Newline) and not check(p4, TokType::Eof) loop
                var (p5, _) = advance(p4);
                p4 = p5;
            end
            var (p5, _) = match_tok(p4, TokType::Semicolon);
            out (p5, n);
        end
        # Unknown extern declaration — skip the line
        when not check(p2, TokType::Newline) and not check(p2, TokType::Eof) loop
            var (p3, _) = advance(p2);
            p2 = p3;
        end
        out (p2, ast_new(AstType::ExternFunc));
    end

    if t.tok_type == TokType::Func:
        var (p2, _) = advance(p);
        out parse_func_def(p2);
    end

    if t.tok_type == TokType::Var:
        var (p2, _) = advance(p);
        out parse_var_decl(p2, false);
    end

    if t.tok_type == TokType::Const:
        var (p2, _) = advance(p);
        out parse_const_decl(p2);
    end

    if t.tok_type == TokType::Let:
        var (p2, _) = advance(p);
        out parse_const_decl(p2);
    end

    if t.tok_type == TokType::If:
        var (p2, _) = advance(p);
        out parse_if_stmt(p2);
    end

    if t.tok_type == TokType::Loop:
        var (p2, _) = advance(p);
        out parse_loop_stmt(p2);
    end

    if t.tok_type == TokType::While or t.tok_type == TokType::When:
        var (p2, _) = advance(p);
        out parse_while_stmt(p2);
    end

    if t.tok_type == TokType::For:
        var (p2, _) = advance(p);
        out parse_for_range_stmt(p2);
    end

    if t.tok_type == TokType::Case:
        var (p2, _) = advance(p);
        out parse_case_stmt(p2);
    end

    if t.tok_type == TokType::Enum:
        var (p2, _) = advance(p);
        out parse_enum_def(p2);
    end

    if t.tok_type == TokType::Entity:
        var (p2, _) = advance(p);
        out parse_entity_def(p2);
    end

    # packed entity Name: ... end
    if t.tok_type == TokType::PackedKw:
        var (p2, _) = advance(p);
        if check(p2, TokType::Entity):
            var (p3, _) = advance(p2);
            var (p4, ed) = parse_entity_def(p3);
            ed.node_type = AstType::PackedDef;
            out (p4, ed);
        end
        # Lone 'packed' without entity — treat as identifier
        n = ast_new(AstType::Identifier);
        n.name = "packed";
        n.line = t.line;
        out (p2, n);
    end

    # register entity Name: ... end
    if t.tok_type == TokType::RegisterKw:
        var (p2, _) = advance(p);
        if check(p2, TokType::Entity):
            var (p3, _) = advance(p2);
            var (p4, ed) = parse_entity_def(p3);
            ed.node_type = AstType::RegisterDef;
            out (p4, ed);
        end
        n = ast_new(AstType::Identifier);
        n.name = "register";
        n.line = t.line;
        out (p2, n);
    end

    # @bind(c) func ... — attribute on next declaration
    if t.tok_type == TokType::AtSign:
        var (p2, _) = advance(p);
        var (p3, attr_name, _) = expect_tok(p2, TokType::Ident, "expected attribute name after '@'");
        # Parse optional parenthesized args: @bind(c)
        attr_arg = "";
        if check(p3, TokType::LParen):
            var (p4, _) = advance(p3);
            if check(p4, TokType::Ident):
                var (p5, arg_tok) = advance(p4);
                attr_arg = arg_tok.str_val;
                p4 = p5;
            end
            var (p6, _, _) = expect_tok(p4, TokType::RParen, "expected ')' after attribute args");
            p3 = p6;
        end
        p3 = skip_newlines(p3);
        # Parse the decorated declaration
        var (p7, inner_stmt) = parse_statement(p3);
        n = ast_new(AstType::BindAttr);
        n.name = attr_name.str_val;
        n.name2 = attr_arg;
        n.line = t.line;
        n = ast_add_child(n, inner_stmt);
        out (p7, n);
    end

    if t.tok_type == TokType::Out:
        var (p2, _) = advance(p);
        out parse_return_stmt(p2);
    end

    if t.tok_type == TokType::Print:
        var (p2, _) = advance(p);
        out parse_print_stmt(p2);
    end

    if t.tok_type == TokType::Break:
        var (p2, _) = advance(p);
        n = ast_new(AstType::BreakStmt);
        n.line = t.line;
        out (p2, n);
    end

    if t.tok_type == TokType::Skip:
        var (p2, _) = advance(p);
        n = ast_new(AstType::ContinueStmt);
        n.line = t.line;
        out (p2, n);
    end

    if t.tok_type == TokType::Import:
        var (p2, _) = advance(p);
        var (p3, first_tok, ok) = expect_tok(p2, TokType::Ident, "expected name after import");
        if not ok:
            out (p3, ast_new(AstType::ImportStmt));
        end
        # Check if this is "import X, Y, Z from MODULE;" pattern
        # Collect all identifiers before 'from'
        names = vec_new_rt();
        names = vec_push_rt(names, first_tok.str_val);
        p4 = p3;
        when check(p4, TokType::Comma) loop
            var (p5, _) = advance(p4);
            p5 = skip_newlines(p5);
            var (p6, sym, _) = expect_tok(p5, TokType::Ident, "expected symbol name");
            names = vec_push_rt(names, sym.str_val);
            p4 = p6;
        end
        if check(p4, TokType::From):
            # "import X, Y from MOD;" syntax
            var (p5, _) = advance(p4);
            var (p6, mod_tok, _) = expect_tok(p5, TokType::Ident, "expected module name after 'from'");
            n = ast_new(AstType::ImportStmt);
            n.name = mod_tok.str_val;
            n.line = t.line;
            ni = 0;
            when ni < vec_len_rt(names) loop
                s = ast_new(AstType::Identifier);
                s.name = vec_get_rt(names, ni);
                n = ast_add_child(n, s);
                ni = ni + 1;
            end
            var (p7, _) = match_tok(p6, TokType::Semicolon);
            out (p7, n);
        end
        # Simple "import MOD" or "import MOD as ALIAS"
        n = ast_new(AstType::ImportStmt);
        n.name = first_tok.str_val;
        n.line = t.line;
        var (p5, has_as) = match_tok(p4, TokType::As);
        if has_as:
            var (p6, alias, _) = expect_tok(p5, TokType::Ident, "expected alias");
            n.name2 = alias.str_val;
            out (p6, n);
        end
        out (p5, n);
    end

    if t.tok_type == TokType::Get:
        var (p2, _) = advance(p);
        var (p3, var_tok, ok) = expect_tok(p2, TokType::Ident, "expected name after get");
        if not ok:
            out (p3, ast_new(AstType::ImportStmt));
        end
        var (p4, _) = match_tok(p3, TokType::From);
        var (p5, mod_tok, _) = expect_tok(p4, TokType::Ident, "expected module name after 'from'");
        n = ast_new(AstType::ImportStmt);
        n.name = mod_tok.str_val;
        n.line = t.line;
        s = ast_new(AstType::Identifier);
        s.name = var_tok.str_val;
        n = ast_add_child(n, s);
        var (p6, _) = match_tok(p5, TokType::Semicolon);
        out (p6, n);
    end

    if t.tok_type == TokType::From:
        var (p2, _) = advance(p);
        var (p3, mod_tok, ok) = expect_tok(p2, TokType::Ident, "expected module name");
        if not ok:
            out (p3, ast_new(AstType::ImportStmt));
        end
        var (p4, _, _) = expect_tok(p3, TokType::Import, "expected 'import'");
        n = ast_new(AstType::ImportStmt);
        n.name = mod_tok.str_val;
        n.line = t.line;
        should_loop = true;
        when should_loop loop
            var (p5, sym, _) = expect_tok(p4, TokType::Ident, "expected symbol name");
            p4 = p5;
            s = ast_new(AstType::Identifier);
            s.name = sym.str_val;
            s.line = sym.line;
            n = ast_add_child(n, s);
            var (p6, matched) = match_tok(p4, TokType::Comma);
            p4 = p6;
            if not matched:
                should_loop = false;
            end
        end
        out (p4, n);
    end

    if t.tok_type == TokType::Module:
        var (p2, _) = advance(p);
        var (p3, mod_tok, _) = expect_tok(p2, TokType::Ident, "expected module name");
        mod_path = mod_tok.str_val;
        when check(p3, TokType::DoubleColon) loop
            var (p4, _) = advance(p3);
            var (p5, seg, _) = expect_tok(p4, TokType::Ident, "expected name after '::'");
            mod_path = mod_path + "::" + seg.str_val;
            p3 = p5;
        end
        when check(p3, TokType::Dot) loop
            var (p4, _) = advance(p3);
            var (p5, seg, _) = expect_tok(p4, TokType::Ident, "expected name after '.'");
            mod_path = mod_path + "." + seg.str_val;
            p3 = p5;
        end
        n = ast_new(AstType::ModuleStmt);
        n.name = mod_path;
        n.line = t.line;
        var (p4, _) = match_tok(p3, TokType::Semicolon);
        out (p4, n);
    end

    if t.tok_type == TokType::Export:
        var (p2, _) = advance(p);
        var (p3, fn_tok, _) = expect_tok(p2, TokType::Ident, "expected function name after export");
        n = ast_new(AstType::ExportStmt);
        n.name = fn_tok.str_val;
        n.line = t.line;
        out (p3, n);
    end

    if t.tok_type == TokType::Include:
        var (p2, _) = advance(p);
        n = ast_new(AstType::IncludeStmt);
        n.line = t.line;
        # Accept both string literal and identifier for include
        if check(p2, TokType::Str):
            var (p3, file_tok, _) = expect_tok(p2, TokType::Str, "expected filename after include");
            n.name = file_tok.str_val;
            p2 = p3;
        else
            # Identifier path: include types; or include vir::rt::syscall;
            var (p3, id_tok, _) = expect_tok(p2, TokType::Ident, "expected module name after include");
            path = id_tok.str_val;
            p2 = p3;
            when check(p2, TokType::DoubleColon) loop
                var (p4, _) = advance(p2);
                var (p5, seg, _) = expect_tok(p4, TokType::Ident, "expected name after '::'");
                path = path + "::" + seg.str_val;
                p2 = p5;
            end
            when check(p2, TokType::Dot) loop
                var (p4, _) = advance(p2);
                var (p5, seg, _) = expect_tok(p4, TokType::Ident, "expected name after '.'");
                path = path + "." + seg.str_val;
                p2 = p5;
            end
            n.name = path;
        end
        var (p3, _) = match_tok(p2, TokType::Semicolon);
        out (p3, n);
    end

    if t.tok_type == TokType::CheckCpu:
        var (p2, _) = advance(p);
        n = ast_new(AstType::CheckCpu);
        n.line = t.line;
        out (p2, n);
    end

    if t.tok_type == TokType::Patch:
        var (p2, _) = advance(p);
        n = ast_new(AstType::PatchPoint);
        n.line = t.line;
        out (p2, n);
    end

    # Identifier (may be assignment, field/index assign, or expression)
    if t.tok_type == TokType::Ident:
        # throw expr — detect by name checking
        if rt_streq(t.str_val, "throw"):
            var (p2, _) = advance(p);
            var (p3, expr) = parse_expr(p2);
            n = ast_new(AstType::ThrowStmt);
            n.line = t.line;
            n = ast_add_child(n, expr);
            out (p3, n);
        end

        # §22 await — "await pass" (cooperative yield) | "await EXPR" (task join)
        if rt_streq(t.str_val, "await"):
            var (p2, _) = advance(p);
            # `await pass` → yield builtin call
            if check(p2, TokType::Ident):
                nx = peek(p2);
                if rt_streq(nx.str_val, "pass"):
                    var (p3, _) = advance(p2);
                    call = ast_new(AstType::BuiltinCall);
                    call.name = "yield";
                    call.builtin_id = 48;   # BuiltinId::Yield
                    call.line = t.line;
                    out (p3, call);
                end
            end
            # generic `await EXPR` → AwaitExpr wrapping the result-bearing expr
            var (p3, expr) = parse_expr(p2);
            n = ast_new(AstType::AwaitExpr);
            n.line = t.line;
            n = ast_add_child(n, expr);
            out (p3, n);
        end

        # §22 cancel EXPR — mark task cancelled
        if rt_streq(t.str_val, "cancel"):
            var (p2, _) = advance(p);
            var (p3, expr) = parse_expr(p2);
            n = ast_new(AstType::CancelStmt);
            n.line = t.line;
            n = ast_add_child(n, expr);
            out (p3, n);
        end

        # §22 quiet EXPR — evaluate-and-discard
        if rt_streq(t.str_val, "quiet"):
            var (p2, _) = advance(p);
            var (p3, expr) = parse_expr(p2);
            n = ast_new(AstType::QuietStmt);
            n.line = t.line;
            n = ast_add_child(n, expr);
            out (p3, n);
        end

        # §4.5 arena NAME: body end — scoped arena allocator block
        if rt_streq(t.str_val, "arena"):
            if p.pos + 1 < p.token_count:
                nx = vec_get_rt(p.tokens, p.pos + 1);
                if nx.tok_type == TokType::Ident:
                    # Peek further for ':' to disambiguate from identifier `arena`
                    if p.pos + 2 < p.token_count:
                        nx2 = vec_get_rt(p.tokens, p.pos + 2);
                        if nx2.tok_type == TokType::Colon:
                            var (p2, _) = advance(p);                # 'arena'
                            var (p3, name_tok, _) = expect_tok(p2, TokType::Ident, "expected arena name");
                            var (p4, _) = match_tok(p3, TokType::Colon);
                            p4 = skip_newlines(p4);
                            var (p5, body) = parse_block(p4);
                            var (p6, _, _) = expect_tok(p5, TokType::End, "expected 'end' after arena block");
                            var (p6b, _) = match_tok(p6, TokType::Dot);
                            n = ast_new(AstType::ArenaBlock);
                            n.name = name_tok.str_val;
                            n.line = t.line;
                            n = ast_add_child(n, body);
                            out (p6b, n);
                        end
                    end
                end
            end
        end

        # Peek ahead: if IDENT followed by '(' → expression statement (function call)
        # Do NOT advance first — let parse_expr handle it directly
        save_pos = p.pos;
        p.pos = p.pos + 1;
        next_type = peek(p).tok_type;
        p.pos = save_pos;
        if next_type == TokType::LParen:
            out parse_expr(p);
        end

        var (p2, id_tok) = advance(p);

        # Simple assignment: IDENT = expr
        if check(p, TokType::Assign):
            var (p3, _) = advance(p);
            var (p4, val) = parse_expr(p3);
            assign = ast_new(AstType::Assign);
            assign.name = id_tok.str_val;
            assign.line = id_tok.line;
            assign = ast_add_child(assign, val);
            out (p4, assign);
        end

        # Field assignment: IDENT.FIELD = expr
        if check(p, TokType::Dot):
            var (p3, _) = advance(p);
            var (p4, field_tok, ok) = expect_tok(p3, TokType::Ident, "expected field name");
            if ok and check(p4, TokType::Assign):
                var (p5, _) = advance(p4);
                var (p6, val) = parse_expr(p5);
                fa = ast_new(AstType::FieldAssign);
                fa.name = id_tok.str_val;
                fa.line = id_tok.line;
                fa = ast_add_child(fa, val);
                # Set name2 AFTER ast_add_child since vec_push_rt corrupts name2
                fa.name2 = field_tok.str_val;
                out (p6, fa);
            end
            # Not field assign — back up and parse as expression
            p2 = p;
            var (p5, expr) = parse_expr(p2);
            out (p5, expr);
        end

        # Index assignment: IDENT[expr] = expr
        if check(p, TokType::LBracket):
            var (p3, _) = advance(p);
            var (p4, idx_expr) = parse_expr(p3);
            var (p5, _, _) = expect_tok(p4, TokType::RBracket, "expected ']'");
            if check(p5, TokType::Assign):
                var (p6, _) = advance(p5);
                var (p7, val) = parse_expr(p6);
                ia = ast_new(AstType::IndexAssign);
                ia.name = id_tok.str_val;
                ia.line = id_tok.line;
                ia = ast_add_child(ia, idx_expr);
                ia = ast_add_child(ia, val);
                out (p7, ia);
            end
            # Not assignment — it's an index access expression
            acc = ast_new(AstType::IndexAccess);
            acc.name = id_tok.str_val;
            acc.line = id_tok.line;
            acc = ast_add_child(acc, idx_expr);
            out (p5, acc);
        end

        # Back up and parse as expression
        p.pos = p.pos - 1;
        var (p3, expr) = parse_expr(p);
        out (p3, expr);
    end

    # EOF / END / ELSE / EIF — no statement
    is_terminator = t.tok_type == TokType::Eof or t.tok_type == TokType::End or;
                    t.tok_type == TokType::Else or t.tok_type == TokType::Eif or;
                    t.tok_type == TokType::EnsureKw or t.tok_type == TokType::RevertKw;
    if is_terminator:
        out (p, ast_new(AstType::LiteralInt));
    end

    # Default: try as expression statement
    out parse_expr(p);
end


# ═══════════════════════════════════════════════════════
# Top-Level Entry Point
# ═══════════════════════════════════════════════════════

func parse_program:
    in(p:Parser)
    prog = ast_new(AstType::Program);
    p = skip_newlines(p);

    when not check(p, TokType::Eof) loop
        var (p2, stmt) = parse_statement(p);
        p = p2;
        if rt_strlen(p.error) > 0:
            # Error recovery: clear error and skip to next statement
            p.error = "";
            when not check(p, TokType::Eof) and not check(p, TokType::Func) and not check(p, TokType::Enum) and not check(p, TokType::Entity) and not check(p, TokType::Const) and not check(p, TokType::Var) and not check(p, TokType::Extern) and not check(p, TokType::Import) loop
                var (p3, _) = advance(p);
                p = p3;
            end
        else
            prog = ast_add_child(prog, stmt);
        end
        # Skip optional trailing semicolons at top level
        when check(p, TokType::Semicolon) loop
            var (p_semi, _) = advance(p);
            p = p_semi;
        end
        p = skip_newlines(p);
    end

    out (p, prog);
end
