include string_rt
import rt_strlen, fat_str_len, fat_str_eq, fat_cstr_eq, fat_str_new, fat_str_concat, rt_streq, rt_strcat, rt_strdup, rt_itoa from string_rt

include vec_rt
import vec_new_rt, vec_push_rt, vec_get_rt, vec_len_rt from vec_rt
include vir.rt.alloc
import vir_alloc from vir.rt.alloc
include vir.compiler.lexer
import Token, TokType, token_name, token_lexeme from vir.compiler.lexer

extern func native_read_i64(addr: int, offset: int) -> int
extern func native_write_i64(addr: int, offset: int, val: int) -> int
extern func native_write_u8(addr: int, offset: int, val: int) -> int


