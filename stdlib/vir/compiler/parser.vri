# Builtin Function Lookup
# ═══════════════════════════════════════════════════════

enum BuiltinId:
    None            = 0
    Len             = 1
    Push            = 2
    Alloc           = 3
    FreeMem         = 4
    Read8           = 5
    Write8          = 6
    Read64          = 7
    Write64         = 8
    StrLen          = 9
    StrGet          = 10
    StrCat          = 11
    StrEq           = 12
    FileOpen        = 13
    FileRead        = 14
    FileWrite       = 15
    FileClose       = 16
    FileWriteByte   = 17
    Exit            = 18
    IToStr          = 19
    StrToI          = 20
    ArrNew          = 21
    PrintStr        = 22
    GetArg          = 23
    ArgCount        = 24
    SlurpFile       = 25
    SlurpLen        = 26
    WriteBytes      = 27
    # Phase 7: New intrinsics
    Syscall         = 30
    MemCopy         = 31
    MemSet          = 32
    CLZ             = 33
    CTZ             = 34
    PopCnt          = 35
    BSwap           = 36
    BitNot          = 37
    BitNeg          = 38
    Fence           = 39
    AtomicLoad      = 40
    AtomicStore     = 41
    AtomicCas       = 42
    AtomicAdd       = 43
    AtomicSub       = 44
    Trap            = 45
    Unreachable     = 46
    AlignPtr        = 47
    # §19 / §4.5 / §22 additions (Phase 7.2 parity)
    Yield           = 48
    ArenaNew        = 49
    ArenaAlloc      = 50
    ArenaFree       = 51
    Cap             = 52
    ArrCompact      = 53
    # §16.5 & Bare Metal Builtins
    VolatileRead    = 54
    VolatileWrite   = 55
    VolatileRead8   = 56
    VolatileWrite8  = 57
    VolatileRead16  = 58
    VolatileWrite16 = 59
    VolatileRead32  = 60
    VolatileWrite32 = 61
    VolatileRead64  = 62
    VolatileWrite64 = 63
    Dmb             = 64
    Dsb             = 65
    Isb             = 66
    Wfi             = 67
    Wfe             = 68
    Sev             = 69
    Nop             = 70
    AtomicExchange  = 71
    AtomicLoad32    = 72
    AtomicStore32   = 73
    AtomicAdd32     = 74
    AtomicSub32     = 75
    AtomicCas32     = 76
    AtomicExchange32 = 77
    AtomicLoad64    = 78
    AtomicStore64   = 79
    AtomicAdd64     = 80
    AtomicSub64     = 81
    AtomicCas64     = 82
    AtomicExchange64 = 83
end.
entity BuiltinEntry:
    name:   string,
        bid:    BuiltinId
end.

# Builtin calls are common in compiler sources.  Avoid scanning the complete
# builtin table for every `name(...)`; bucket by first byte and name length.
const BUILTIN_LEN_SLOTS: int = 32
const BUILTIN_BUCKET_COUNT: int = 8192
const BUILTIN_MAX_ENTRIES: int = 256
var g_builtin_bucket_head: i64 = 0
var g_builtin_bucket_next: i64 = 0

func builtin_bucket_build(table: int):
    if g_builtin_bucket_head == 0 do
        g_builtin_bucket_head = vir_alloc(BUILTIN_BUCKET_COUNT * 8)
    end
    if g_builtin_bucket_next == 0 do
        g_builtin_bucket_next = vir_alloc(BUILTIN_MAX_ENTRIES * 8)
    end
    var i = 0
    when i < BUILTIN_BUCKET_COUNT loop
        native_write_i64(g_builtin_bucket_head, i * 8, 0)
        i = i + 1
    end
    count = vec_len_rt(table)
    i = 0
    when i < count and i < BUILTIN_MAX_ENTRIES loop
        entry = vec_get_rt(table, i) as BuiltinEntry
        n = rt_strlen(entry.name)
        if n > 0 and n < BUILTIN_LEN_SLOTS do
            first = native_read_u8(entry.name as i64, 0)
            key = first * BUILTIN_LEN_SLOTS + n
            head = native_read_i64(g_builtin_bucket_head, key * 8)
            native_write_i64(g_builtin_bucket_next, i * 8, head)
            native_write_i64(g_builtin_bucket_head, key * 8, i + 1)
        end
        i = i + 1
    end
end.

func build_builtins:
    table = vec_new_rt()
    table = vec_push_rt(table, BuiltinEntry ( name: "len", bid: BuiltinId.Len ))
    table = vec_push_rt(table, BuiltinEntry ( name: "push", bid: BuiltinId.Push ))
    table = vec_push_rt(table, BuiltinEntry ( name: "alloc", bid: BuiltinId.Alloc ))
    table = vec_push_rt(table, BuiltinEntry ( name: "dealloc", bid: BuiltinId.FreeMem ))
    table = vec_push_rt(table, BuiltinEntry ( name: "read_byte", bid: BuiltinId.Read8 ))
    table = vec_push_rt(table, BuiltinEntry ( name: "read_u8", bid: BuiltinId.Read8 ))
    table = vec_push_rt(table, BuiltinEntry ( name: "read8", bid: BuiltinId.Read8 ))
    table = vec_push_rt(table, BuiltinEntry ( name: "native_read_u8", bid: BuiltinId.Read8 ))
    table = vec_push_rt(table, BuiltinEntry ( name: "write_byte", bid: BuiltinId.Write8 ))
    table = vec_push_rt(table, BuiltinEntry ( name: "write_u8", bid: BuiltinId.Write8 ))
    table = vec_push_rt(table, BuiltinEntry ( name: "write8", bid: BuiltinId.Write8 ))
    table = vec_push_rt(table, BuiltinEntry ( name: "native_write_u8", bid: BuiltinId.Write8 ))
    table = vec_push_rt(table, BuiltinEntry ( name: "read_word", bid: BuiltinId.Read64 ))
    table = vec_push_rt(table, BuiltinEntry ( name: "read_i64", bid: BuiltinId.Read64 ))
    table = vec_push_rt(table, BuiltinEntry ( name: "read64", bid: BuiltinId.Read64 ))
    table = vec_push_rt(table, BuiltinEntry ( name: "native_read_i64", bid: BuiltinId.Read64 ))
    table = vec_push_rt(table, BuiltinEntry ( name: "write_word", bid: BuiltinId.Write64 ))
    table = vec_push_rt(table, BuiltinEntry ( name: "write_i64", bid: BuiltinId.Write64 ))
    table = vec_push_rt(table, BuiltinEntry ( name: "write64", bid: BuiltinId.Write64 ))
    table = vec_push_rt(table, BuiltinEntry ( name: "native_write_i64", bid: BuiltinId.Write64 ))
    table = vec_push_rt(table, BuiltinEntry ( name: "memset", bid: BuiltinId.MemSet ))
    table = vec_push_rt(table, BuiltinEntry ( name: "fill_bytes", bid: BuiltinId.MemSet ))
    table = vec_push_rt(table, BuiltinEntry ( name: "native_mem_set", bid: BuiltinId.MemSet ))
    table = vec_push_rt(table, BuiltinEntry ( name: "str_len", bid: BuiltinId.StrLen ))
    table = vec_push_rt(table, BuiltinEntry ( name: "str_get", bid: BuiltinId.StrGet ))
    table = vec_push_rt(table, BuiltinEntry ( name: "str_cat", bid: BuiltinId.StrCat ))
    table = vec_push_rt(table, BuiltinEntry ( name: "str_concat", bid: BuiltinId.StrCat ))
    table = vec_push_rt(table, BuiltinEntry ( name: "str_eq", bid: BuiltinId.StrEq ))
    table = vec_push_rt(table, BuiltinEntry ( name: "file_open", bid: BuiltinId.FileOpen ))
    table = vec_push_rt(table, BuiltinEntry ( name: "native_file_open", bid: BuiltinId.FileOpen ))
    table = vec_push_rt(table, BuiltinEntry ( name: "file_read", bid: BuiltinId.FileRead ))
    table = vec_push_rt(table, BuiltinEntry ( name: "native_file_read", bid: BuiltinId.FileRead ))
    table = vec_push_rt(table, BuiltinEntry ( name: "file_write", bid: BuiltinId.FileWrite ))
    table = vec_push_rt(table, BuiltinEntry ( name: "native_file_write", bid: BuiltinId.FileWrite ))
    table = vec_push_rt(table, BuiltinEntry ( name: "file_close", bid: BuiltinId.FileClose ))
    table = vec_push_rt(table, BuiltinEntry ( name: "native_file_close", bid: BuiltinId.FileClose ))
    table = vec_push_rt(table, BuiltinEntry ( name: "file_write_byte", bid: BuiltinId.FileWriteByte ))
    table = vec_push_rt(table, BuiltinEntry ( name: "slurp_file", bid: BuiltinId.SlurpFile ))
    table = vec_push_rt(table, BuiltinEntry ( name: "slurp_len", bid: BuiltinId.SlurpLen ))
    table = vec_push_rt(table, BuiltinEntry ( name: "write_bytes", bid: BuiltinId.WriteBytes ))
    table = vec_push_rt(table, BuiltinEntry ( name: "exit_prog", bid: BuiltinId.Exit ))
    table = vec_push_rt(table, BuiltinEntry ( name: "i_to_str", bid: BuiltinId.IToStr ))
    table = vec_push_rt(table, BuiltinEntry ( name: "int_to_str", bid: BuiltinId.IToStr ))
    table = vec_push_rt(table, BuiltinEntry ( name: "str_to_i", bid: BuiltinId.StrToI ))
    table = vec_push_rt(table, BuiltinEntry ( name: "str_to_int", bid: BuiltinId.StrToI ))
    table = vec_push_rt(table, BuiltinEntry ( name: "arr_new", bid: BuiltinId.ArrNew ))
    table = vec_push_rt(table, BuiltinEntry ( name: "arr_push", bid: BuiltinId.Push ))
    table = vec_push_rt(table, BuiltinEntry ( name: "arr_len", bid: BuiltinId.Len ))
    table = vec_push_rt(table, BuiltinEntry ( name: "print_str", bid: BuiltinId.PrintStr ))
    table = vec_push_rt(table, BuiltinEntry ( name: "get_arg", bid: BuiltinId.GetArg ))
    table = vec_push_rt(table, BuiltinEntry ( name: "rt_argv", bid: BuiltinId.GetArg ))
    table = vec_push_rt(table, BuiltinEntry ( name: "rt_get_arg", bid: BuiltinId.GetArg ))
    table = vec_push_rt(table, BuiltinEntry ( name: "arg_count", bid: BuiltinId.ArgCount ))
    table = vec_push_rt(table, BuiltinEntry ( name: "rt_argc", bid: BuiltinId.ArgCount ))
    # Phase 7: New intrinsics
    table = vec_push_rt(table, BuiltinEntry ( name: "__syscall", bid: BuiltinId.Syscall ))
    table = vec_push_rt(table, BuiltinEntry ( name: "__memcpy", bid: BuiltinId.MemCopy ))
    table = vec_push_rt(table, BuiltinEntry ( name: "native_mem_copy", bid: BuiltinId.MemCopy ))
    table = vec_push_rt(table, BuiltinEntry ( name: "__memset", bid: BuiltinId.MemSet ))
    table = vec_push_rt(table, BuiltinEntry ( name: "__clz", bid: BuiltinId.CLZ ))
    table = vec_push_rt(table, BuiltinEntry ( name: "__ctz", bid: BuiltinId.CTZ ))
    table = vec_push_rt(table, BuiltinEntry ( name: "__popcnt", bid: BuiltinId.PopCnt ))
    table = vec_push_rt(table, BuiltinEntry ( name: "__bswap", bid: BuiltinId.BSwap ))
    table = vec_push_rt(table, BuiltinEntry ( name: "__not", bid: BuiltinId.BitNot ))
    table = vec_push_rt(table, BuiltinEntry ( name: "__neg", bid: BuiltinId.BitNeg ))
    table = vec_push_rt(table, BuiltinEntry ( name: "__fence", bid: BuiltinId.Fence ))
    table = vec_push_rt(table, BuiltinEntry ( name: "atomic_fence", bid: BuiltinId.Fence ))
    table = vec_push_rt(table, BuiltinEntry ( name: "__atomic_load", bid: BuiltinId.AtomicLoad ))
    table = vec_push_rt(table, BuiltinEntry ( name: "__atomic_store", bid: BuiltinId.AtomicStore ))
    table = vec_push_rt(table, BuiltinEntry ( name: "__atomic_cas", bid: BuiltinId.AtomicCas ))
    table = vec_push_rt(table, BuiltinEntry ( name: "__atomic_add", bid: BuiltinId.AtomicAdd ))
    table = vec_push_rt(table, BuiltinEntry ( name: "__atomic_sub", bid: BuiltinId.AtomicSub ))
    table = vec_push_rt(table, BuiltinEntry ( name: "__trap", bid: BuiltinId.Trap ))
    table = vec_push_rt(table, BuiltinEntry ( name: "__unreachable", bid: BuiltinId.Unreachable ))
    table = vec_push_rt(table, BuiltinEntry ( name: "__align", bid: BuiltinId.AlignPtr ))
    # §19/§4.5/§22 runtime hooks
    table = vec_push_rt(table, BuiltinEntry ( name: "yield", bid: BuiltinId.Yield ))
    table = vec_push_rt(table, BuiltinEntry ( name: "arena_new", bid: BuiltinId.ArenaNew ))
    table = vec_push_rt(table, BuiltinEntry ( name: "arena_alloc", bid: BuiltinId.ArenaAlloc ))
    table = vec_push_rt(table, BuiltinEntry ( name: "arena_free", bid: BuiltinId.ArenaFree ))
    table = vec_push_rt(table, BuiltinEntry ( name: "cap", bid: BuiltinId.Cap ))
    table = vec_push_rt(table, BuiltinEntry ( name: "arr_compact", bid: BuiltinId.ArrCompact ))
    # §16.5 & Bare Metal
    table = vec_push_rt(table, BuiltinEntry ( name: "volatile_read", bid: BuiltinId.VolatileRead ))
    table = vec_push_rt(table, BuiltinEntry ( name: "volatile_write", bid: BuiltinId.VolatileWrite ))
    table = vec_push_rt(table, BuiltinEntry ( name: "volatile_read8", bid: BuiltinId.VolatileRead8 ))
    table = vec_push_rt(table, BuiltinEntry ( name: "volatile_write8", bid: BuiltinId.VolatileWrite8 ))
    table = vec_push_rt(table, BuiltinEntry ( name: "volatile_read16", bid: BuiltinId.VolatileRead16 ))
    table = vec_push_rt(table, BuiltinEntry ( name: "volatile_write16", bid: BuiltinId.VolatileWrite16 ))
    table = vec_push_rt(table, BuiltinEntry ( name: "volatile_read32", bid: BuiltinId.VolatileRead32 ))
    table = vec_push_rt(table, BuiltinEntry ( name: "volatile_write32", bid: BuiltinId.VolatileWrite32 ))
    table = vec_push_rt(table, BuiltinEntry ( name: "volatile_read64", bid: BuiltinId.VolatileRead64 ))
    table = vec_push_rt(table, BuiltinEntry ( name: "volatile_write64", bid: BuiltinId.VolatileWrite64 ))
    table = vec_push_rt(table, BuiltinEntry ( name: "dmb", bid: BuiltinId.Dmb ))
    table = vec_push_rt(table, BuiltinEntry ( name: "__dmb", bid: BuiltinId.Dmb ))
    table = vec_push_rt(table, BuiltinEntry ( name: "dsb", bid: BuiltinId.Dsb ))
    table = vec_push_rt(table, BuiltinEntry ( name: "__dsb", bid: BuiltinId.Dsb ))
    table = vec_push_rt(table, BuiltinEntry ( name: "isb", bid: BuiltinId.Isb ))
    table = vec_push_rt(table, BuiltinEntry ( name: "__isb", bid: BuiltinId.Isb ))
    table = vec_push_rt(table, BuiltinEntry ( name: "wfi", bid: BuiltinId.Wfi ))
    table = vec_push_rt(table, BuiltinEntry ( name: "__wfi", bid: BuiltinId.Wfi ))
    table = vec_push_rt(table, BuiltinEntry ( name: "wfe", bid: BuiltinId.Wfe ))
    table = vec_push_rt(table, BuiltinEntry ( name: "__wfe", bid: BuiltinId.Wfe ))
    table = vec_push_rt(table, BuiltinEntry ( name: "sev", bid: BuiltinId.Sev ))
    table = vec_push_rt(table, BuiltinEntry ( name: "__sev", bid: BuiltinId.Sev ))
    table = vec_push_rt(table, BuiltinEntry ( name: "nop", bid: BuiltinId.Nop ))
    table = vec_push_rt(table, BuiltinEntry ( name: "__nop", bid: BuiltinId.Nop ))
    # §24.4 Atomic Primitives
    table = vec_push_rt(table, BuiltinEntry ( name: "atomic_load", bid: BuiltinId.AtomicLoad ))
    table = vec_push_rt(table, BuiltinEntry ( name: "atomic_store", bid: BuiltinId.AtomicStore ))
    table = vec_push_rt(table, BuiltinEntry ( name: "atomic_add", bid: BuiltinId.AtomicAdd ))
    table = vec_push_rt(table, BuiltinEntry ( name: "atomic_sub", bid: BuiltinId.AtomicSub ))
    table = vec_push_rt(table, BuiltinEntry ( name: "atomic_cas", bid: BuiltinId.AtomicCas ))
    table = vec_push_rt(table, BuiltinEntry ( name: "atomic_exchange", bid: BuiltinId.AtomicExchange ))
    table = vec_push_rt(table, BuiltinEntry ( name: "atomic_swap", bid: BuiltinId.AtomicExchange ))
    table = vec_push_rt(table, BuiltinEntry ( name: "atomic_load32", bid: BuiltinId.AtomicLoad32 ))
    table = vec_push_rt(table, BuiltinEntry ( name: "atomic_store32", bid: BuiltinId.AtomicStore32 ))
    table = vec_push_rt(table, BuiltinEntry ( name: "atomic_add32", bid: BuiltinId.AtomicAdd32 ))
    table = vec_push_rt(table, BuiltinEntry ( name: "atomic_sub32", bid: BuiltinId.AtomicSub32 ))
    table = vec_push_rt(table, BuiltinEntry ( name: "atomic_cas32", bid: BuiltinId.AtomicCas32 ))
    table = vec_push_rt(table, BuiltinEntry ( name: "atomic_exchange32", bid: BuiltinId.AtomicExchange32 ))
    table = vec_push_rt(table, BuiltinEntry ( name: "atomic_swap32", bid: BuiltinId.AtomicExchange32 ))
    table = vec_push_rt(table, BuiltinEntry ( name: "atomic_load64", bid: BuiltinId.AtomicLoad64 ))
    table = vec_push_rt(table, BuiltinEntry ( name: "atomic_store64", bid: BuiltinId.AtomicStore64 ))
    table = vec_push_rt(table, BuiltinEntry ( name: "atomic_add64", bid: BuiltinId.AtomicAdd64 ))
    table = vec_push_rt(table, BuiltinEntry ( name: "atomic_sub64", bid: BuiltinId.AtomicSub64 ))
    table = vec_push_rt(table, BuiltinEntry ( name: "atomic_cas64", bid: BuiltinId.AtomicCas64 ))
    table = vec_push_rt(table, BuiltinEntry ( name: "atomic_exchange64", bid: BuiltinId.AtomicExchange64 ))
    table = vec_push_rt(table, BuiltinEntry ( name: "atomic_swap64", bid: BuiltinId.AtomicExchange64 ))
    # syscallN helpers — map to BuiltinId.Syscall (id=30); N encodes arg count.
    table = vec_push_rt(table, BuiltinEntry ( name: "syscall0", bid: BuiltinId.Syscall ))
    table = vec_push_rt(table, BuiltinEntry ( name: "syscall1", bid: BuiltinId.Syscall ))
    table = vec_push_rt(table, BuiltinEntry ( name: "syscall2", bid: BuiltinId.Syscall ))
    table = vec_push_rt(table, BuiltinEntry ( name: "syscall3", bid: BuiltinId.Syscall ))
    table = vec_push_rt(table, BuiltinEntry ( name: "syscall4", bid: BuiltinId.Syscall ))
    table = vec_push_rt(table, BuiltinEntry ( name: "syscall5", bid: BuiltinId.Syscall ))
    table = vec_push_rt(table, BuiltinEntry ( name: "syscall6", bid: BuiltinId.Syscall ))
    builtin_bucket_build(table)
    out table
end.
func lookup_builtin(table: int, name: string):
    n = fat_str_len(name)
    if n > 0 and n < BUILTIN_LEN_SLOTS and g_builtin_bucket_head != 0 and g_builtin_bucket_next != 0 do
        data = native_read_i64(name as i64, 0)
        first = native_read_u8(data, 0)
        key = first * BUILTIN_LEN_SLOTS + n
        link = native_read_i64(g_builtin_bucket_head, key * 8)
        when link > 0 loop
            i = link - 1
            entry = vec_get_rt(table, i) as BuiltinEntry
            # Builtin table names are C-string literals; lexer names are fat.
            if fat_cstr_eq(name, entry.name) == 1 do
                out entry.bid
            end
            link = native_read_i64(g_builtin_bucket_next, i * 8)
        end
        out BuiltinId.None
    end
    # Preserve support for unusually long or runtime-extended builtin names.
    var i = 0
    when i < vec_len_rt(table) loop
        entry = vec_get_rt(table, i) as BuiltinEntry
        if fat_cstr_eq(name, entry.name) == 1 do out entry.bid end
        i = i + 1
    end
    out BuiltinId.None
end.
# ═══════════════════════════════════════════════════════
# Parser State
# ═══════════════════════════════════════════════════════

entity Parser:
    tokens:         int,
        pos:            int,
        token_count:    int,
        error_msg:          string,
        error_line:     int,
        builtins:       int
end.
func parser_new(tokens: int):

    # Snapshot before CALLs (same ABI footgun as lexer_new).
    tc = vec_len_rt(tokens)
    held_toks = tokens
    bi = build_builtins()
    p = Parser (
        tokens:      held_toks,
        pos:         0,
        token_count: tc,
        error_msg:       "",
        error_line:  0,
        builtins:    bi
    )
    out p
end.
# ═══════════════════════════════════════════════════════
# Parser Helpers
# ═══════════════════════════════════════════════════════

func parse_error(p: Parser, msg: string):

    if rt_strlen(p.error_msg) == 0 do
        t = peek(p)
        p.error_msg = rt_strcat(
            rt_strcat(rt_strcat("line ", rt_itoa(t.line)), rt_strcat(": ", msg)),
            ""
        )
        if check(p, TokType.Eof) do
            p.error_msg = rt_strcat(p.error_msg, " (at EOF)")
        else
            p.error_msg = rt_strcat(
                p.error_msg,
                rt_strcat(" [tok=", rt_strcat(rt_itoa(t.tok_type as int), "]"))
            )
        end
        # Keep the first failing line across parse-program recovery.  Later
        # errors are still printed, but the driver source-map summary should
        # identify the root error rather than a cascading EOF diagnostic.
        if p.error_line == 0 do
            p.error_line = t.line
        end
    end
    out p
end.
func parse_error_at(p: Parser, msg: string, line: int):

    first_error = p.error_line == 0
    p = parse_error(p, msg)
    # An expression parser can consume through EOF while diagnosing a missing
    # delimiter.  Keep the line where the construct began so source-map
    # diagnostics point at the offending statement, not the end of a bundle.
    if first_error and line > 0 do
        p.error_line = line
    end
    out p
end.
func peek(p: Parser):

    if p.pos >= p.token_count do
        out Token (
            tok_type: TokType.Eof,
            line: 0,
            col: 0,
            start: 0,
            len: 0,
            str_val: "",
            int_val: 0,
            float_val: 0.0
        )
    end
    out native_read_i64(p.tokens, p.pos * 8) as Token
end.
func advance(p: Parser):
    if p.pos >= p.token_count do
        out (p, peek(p))
    end
    t = native_read_i64(p.tokens, p.pos * 8) as Token
    p.pos = p.pos + 1
    # Zero-copy lexer leaves Ident/keyword with start/len only.  Many parse
    # paths still read .str_val; materialize once on advance so names are not
    # empty (that flooded pass3 with fake "undefined" / E1002 reports).
    if t.len > 0 do
        if fat_str_len(t.str_val) == 0 do
            t.str_val = token_lexeme(t)
        end
    end
    out (p, t)
end.
func peek_n(p: Parser, offset: int):

    idx = p.pos + offset
    if idx >= p.token_count or idx < 0 do
        out Token (
            tok_type: TokType.Eof,
            line: 0,
            col: 0,
            start: 0,
            len: 0,
            str_val: "",
            int_val: 0,
            float_val: 0.0
        )
    end
    out native_read_i64(p.tokens, idx * 8) as Token
end.
func sync_statement(p: Parser):

    when not check(p, TokType.Eof) and not check(p, TokType.Semicolon) and not check(p, TokType.Newline) and not check(p, TokType.End) loop
        var (p2, _) = advance(p)
        p = p2
    end
    var (p3, _) = match_tok(p, TokType.Semicolon)
    p3 = skip_newlines(p3)
    out p3
end.
func check(p: Parser, tok_type: TokType):
    if p.pos >= p.token_count do
        out tok_type == TokType.Eof
    end
    t = native_read_i64(p.tokens, p.pos * 8) as Token
    out t.tok_type == tok_type
end.
func match_tok(p: Parser, tok_type: TokType):

    if check(p, tok_type) do
        var (p2, _) = advance(p)
        out (p2, true)
    end
    out (p, false)
end.
func expect_tok:
    in  p: Parser
        tok_type: TokType
        msg: string

    if check(p, tok_type) do
        var (p2, t) = advance(p)
        out (p2, t, true)
    end
    p = parse_error(p, msg)
    out (p, peek(p), false)
end.

func is_reserved_keyword(t: TokType):
    if t == TokType.PortKw do out true end
    if t == TokType.Module do out true end
    # Definitions & Declarations
    if t == TokType.Func or t == TokType.Var or t == TokType.Const or t == TokType.Entity or t == TokType.Enum or t == TokType.Class or t == TokType.Extern or t == TokType.Let do
        out true
    end
    # Control flow
    if t == TokType.If or t == TokType.Else or t == TokType.Eif or t == TokType.Loop or t == TokType.While or t == TokType.When or t == TokType.For or t == TokType.Break or t == TokType.Skip or t == TokType.Out or t == TokType.Case or t == TokType.End or t == TokType.Do or t == TokType.Then do
        out true
    end
    # Modules & Imports
    if t == TokType.Import or t == TokType.Export or t == TokType.Include do
        out true
    end
    out false
end.

func keyword_name(t: TokType):
    if t == TokType.PortKw do out "port" end
    if t == TokType.Module do out "module" end
    if t == TokType.Func do out "func" end
    if t == TokType.Var do out "var" end
    if t == TokType.Const do out "const" end
    if t == TokType.Entity do out "entity" end
    if t == TokType.Enum do out "enum" end
    if t == TokType.Class do out "class" end
    if t == TokType.Extern do out "extern" end
    if t == TokType.Let do out "let" end
    if t == TokType.If do out "if" end
    if t == TokType.Else do out "else" end
    if t == TokType.Eif do out "eif" end
    if t == TokType.Loop do out "loop" end
    if t == TokType.While do out "while" end
    if t == TokType.When do out "when" end
    if t == TokType.For do out "for" end
    if t == TokType.Break do out "break" end
    if t == TokType.Skip do out "skip" end
    if t == TokType.Out do out "out" end
    if t == TokType.Case do out "case" end
    if t == TokType.End do out "end" end
    if t == TokType.Do do out "do" end
    if t == TokType.Then do out "then" end
    if t == TokType.Import do out "import" end
    if t == TokType.Export do out "export" end
    if t == TokType.Include do out "include" end
    out "keyword"
end.

# Vir keywords are contextual: runtime/compiler code may legally use names
# such as `arena`, `timeout`, `map`, or `type` in binder and expression
# positions. Match the C parser's is_name_token policy here.
func is_name_token(t: TokType):
    v = t as int
    if t == TokType.Ident do out true end
    if v >= 10 and v <= 42 do out true end
    if v >= 120 and v <= 159 do out true end
    if v >= 162 and v <= 166 do out true end
    if v >= 191 and v <= 230 do out true end
    out false
end.

func tok_lex(tok: Token):
    out token_lexeme(tok)
end.

func expect_name_tok:
    in  p: Parser
        msg: string

    t = peek(p)
    if is_reserved_keyword(t.tok_type) do
        let kw_name = keyword_name(t.tok_type)
        var msg_buf = rt_strcat(rt_strcat("expected identifier, found reserved keyword '", kw_name), "'")
        print_ln(rt_strcat("line ", rt_strcat(rt_itoa(t.line), rt_strcat(": ", msg_buf))))
        p = parse_error(p, msg_buf)
        out (p, peek(p), false)
    end
    if is_name_token(t.tok_type) do
        var (p2, got) = advance(p)
        got.str_val = tok_lex(got)
        out (p2, got, true)
    end
    p = parse_error(p, msg)
    out (p, peek(p), false)
end.
func skip_newlines(p: Parser):

    when check(p, TokType.Newline) loop
        var (p2, _) = advance(p)
        p = p2
    end
    out p
end.

# Close a definition block per spec: `end` with optional trailing `.` (§12).
# On mismatch, record a parse error and resync — never abort the VM.
func sync_past_block_end(p: Parser):
    when not check(p, TokType.Eof) loop
        if check(p, TokType.End) do
            var (p2, _) = advance(p)
            var (p3, _) = match_tok(p2, TokType.Dot)
            out p3
        end
        if check(p, TokType.Func) or check(p, TokType.Entity) or check(p, TokType.Enum) or check(p, TokType.Const) or check(p, TokType.Var) or check(p, TokType.Extern) or check(p, TokType.Import) or check(p, TokType.Module) or check(p, TokType.Class) do
            out p
        end
        var (p2, _) = advance(p)
        p = p2
    end
    out p
end.

func expect_block_end(p: Parser, msg: string):
    if check(p, TokType.End) do
        var (p2, _) = advance(p)
        var (p3, _) = match_tok(p2, TokType.Dot)
        out p3
    end
    p = parse_error(p, msg)
    out sync_past_block_end(p)
end.
# §1.0 list separator: ";" | NEWLINE  (+ optional ",").
# Returns (parser, matched). After match, newlines / extra trailing seps are consumed.
func match_list_sep(p: Parser, allow_comma: bool):

    got = false
    if allow_comma do
        var (p2, m) = match_tok(p, TokType.Comma)
        p = p2
        if m do
            got = true
        end
    end
    if not got do
        var (p3, m2) = match_tok(p, TokType.Semicolon)
        p = p3
        if m2 do
            got = true
        end
    end
    if not got do
        if check(p, TokType.Newline) do
            got = true
        end
    end
    if not got do
        out (p, false)
    end
    p = skip_newlines(p)
    # Extra trailing ;/, — flag loop (avoid when-true+break on VM)
    more = true
    when more loop
        ate = false
        var (p4, m3) = match_tok(p, TokType.Semicolon)
        p = p4
        if m3 do
            ate = true
        end
        if not ate and allow_comma do
            var (p5, m4) = match_tok(p, TokType.Comma)
            p = p5
            if m4 do
                ate = true
            end
        end
        if ate do
            p = skip_newlines(p)
        else
            more = false
        end
    end
    out (p, true)
end.
func is_stmt_start(t: TokType):

    out (t == TokType.Var or t == TokType.Const or t == TokType.If or
        t == TokType.Loop or t == TokType.While or t == TokType.When or t == TokType.For or
        t == TokType.Out or t == TokType.Print or t == TokType.Input or
        t == TokType.Ident or t == TokType.Int or t == TokType.Float or
        t == TokType.Str or t == TokType.LParen or t == TokType.Minus or
        t == TokType.Not or t == TokType.CheckCpu or t == TokType.Patch or
        t == TokType.Func or t == TokType.Break or t == TokType.Skip or
        t == TokType.True or t == TokType.False or t == TokType.LBracket or
        t == TokType.Enum or t == TokType.Entity or
        t == TokType.Import or t == TokType.From or t == TokType.Module or
        t == TokType.Export or t == TokType.Include or
        t == TokType.Async or t == TokType.AwaitKw or t == TokType.Task or
        t == TokType.Wait or t == TokType.BitAnd or t == TokType.BorrowMut or
        t == TokType.BitNot or t == TokType.ErxKw or t == TokType.MapKw or
        t == TokType.ArrCompactKw or t == TokType.PtrKw or t == TokType.ThisKw or
        t == TokType.ErrorKw or t == TokType.NoneLit)
end.
# ═══════════════════════════════════════════════════════
# Expression Parsing (precedence climbing)
# ═══════════════════════════════════════════════════════

func parse_primary(p: Parser):

    t = peek(p)

    # Integer literal
    if t.tok_type == TokType.Int do
        var (p2, t2) = advance(p)
        n = ast_new(AstType.LiteralInt)
        n.int_val = t2.int_val
        n.line = t2.line
        out (p2, n)
    end

    # Float literal
    if t.tok_type == TokType.Float do
        var (p2, t2) = advance(p)
        n = ast_new(AstType.LiteralFloat)
        # Preserve raw IEEE-754 payload.  The self-host compiler's aggregate
        # float ABI is not used for literal transport.
        native_write_i64(n as int, 48, native_read_i64(t2 as int, 56))
        n.line = t2.line
        out (p2, n)
    end

    # §26.5 canonical quantization: quantize(value, bits: N).
    # Keep both operands in the AST; bits is never discarded into a marker.
    if t.tok_type == TokType.QuantizeKw do
        var (p2, _) = advance(p)
        var (p3, _, _) = expect_tok(p2, TokType.LParen, "expected '(' after quantize")
        var (p4, value_expr) = parse_expr(p3)
        var (p5, _, _) = expect_tok(p4, TokType.Comma, "expected ',' before quantize bits")
        p5 = skip_newlines(p5)

        # Canonical named form uses `bits: N`; retain positional N as a
        # compatibility input while semantic analysis enforces constness/range.
        if is_name_token(peek(p5).tok_type) and fat_cstr_eq(tok_lex(peek(p5)), "bits") == 1 do
            var (p6, _) = advance(p5)
            var (p7, _, _) = expect_tok(p6, TokType.Colon, "expected ':' after quantize bits")
            p5 = p7
        end
        var (p8, bits_expr) = parse_expr(p5)
        var (p9, _, _) = expect_tok(p8, TokType.RParen, "expected ')' after quantize")
        q = ast_new(AstType.QuantizeExpr)
        q.name = fat_str_new("quantize")
        q.line = t.line
        q.int_val = 0 - 1
        if bits_expr.node_type == AstType.LiteralInt do q.int_val = bits_expr.int_val end
        q = ast_add_child(q, value_expr)
        q = ast_add_child(q, bits_expr)
        out (p9, q)
    end

    # §4.4 / §7.3 sizeof(Type)
    if t.tok_type == TokType.SizeofKw do
        var (p2, _) = advance(p)
        var (p3, _, _) = expect_tok(p2, TokType.LParen, "expected '(' after sizeof")
        var (p4, type_name) = parse_type_expr_string(p3)
        var (p5, _, _) = expect_tok(p4, TokType.RParen, "expected ')' after sizeof type")
        sz_node = ast_new(AstType.SizeofExpr)
        sz_node.name = type_name
        sz_node.line = t.line
        out (p5, sz_node)
    end

    # String literal
    if t.tok_type == TokType.Str do
        var (p2, t2) = advance(p)
        n = ast_new(AstType.LiteralStr)
        n.name = t2.str_val
        n.line = t2.line
        out (p2, n)
    end

    # Interpolated string: InterpStart Str Ident [Dot Ident] Str ... InterpEnd
    if t.tok_type == TokType.InterpStart do
        var (p2, _) = advance(p)
        interp = ast_new(AstType.InterpExpr)
        interp.line = t.line
        when not check(p2, TokType.InterpEnd) and not check(p2, TokType.Eof) loop
            it = peek(p2)
            if it.tok_type == TokType.Str do
                var (p3, st) = advance(p2)
                seg = ast_new(AstType.LiteralStr)
                seg.name = st.str_val
                seg.line = st.line
                interp = ast_add_child(interp, seg)
                p2 = p3
            eif it.tok_type == TokType.LParen do
                # General expression: $(expr)
                var (p3, _) = advance(p2)
                var (p4, inner_expr) = parse_expr(p3)
                var (p5, _, _) = expect_tok(p4, TokType.RParen, "expected ')' in interpolation")
                interp = ast_add_child(interp, inner_expr)
                p2 = p5
            eif it.tok_type == TokType.Ident or it.tok_type == TokType.ThisKw do
                var (p3, id_t) = advance(p2)
                var curr_node = ast_new(AstType.Identifier)
                if id_t.tok_type == TokType.ThisKw do
                    curr_node.name = fat_str_new("this")
                else
                    curr_node.name = tok_lex(id_t)
                end
                curr_node.line = id_t.line
                # Chained dot field access: $user.name, $a.b.c
                when check(p3, TokType.Dot) loop
                    var (p4, _) = advance(p3)
                    var (p5, fld_t, _) = expect_name_tok(p4, "expected field after '.'")
                    fa = ast_new(AstType.FieldAccess)
                    fa.name = tok_lex(fld_t)
                    fa.line = fld_t.line
                    fa = ast_add_child(fa, curr_node)
                    curr_node = fa
                    p3 = p5
                end
                interp = ast_add_child(interp, curr_node)
                p2 = p3
            else
                # Malformed interpolation is a parser error.  Silently
                # dropping a token could turn a broken source string into a
                # different valid program.
                p2 = parse_error_at(p2, "unexpected token in string interpolation", it.line)
                var (p3, _) = advance(p2)
                p2 = p3
            end
        end
        var (p3, _, _) = expect_tok(p2, TokType.InterpEnd, "expected end of interpolated string")
        out (p3, interp)
    end

    # 'this' keyword used as identifier in method body
    if t.tok_type == TokType.ThisKw do
        var (p2, this_tok) = advance(p)
        n = ast_new(AstType.Identifier)
        n.name = fat_str_new("this")
        n.line = t.line
        out (p2, n)
    end

    # `ptr` as type/primary expression
    if t.tok_type == TokType.PtrKw do
        var (p2, _) = advance(p)
        n = ast_new(AstType.PtrTypeExpr)
        n.name = fat_str_new("ptr")
        n.line = t.line
        out (p2, n)
    end

    # `map(...)` functional map
    if t.tok_type == TokType.MapKw do
        var (p2, _) = advance(p)
        n = ast_new(AstType.MapExpr)
        n.name = fat_str_new("map")
        n.line = t.line
        if check(p2, TokType.LParen) do
            var (p3, _) = advance(p2)
            p3 = skip_newlines(p3)
            if not check(p3, TokType.RParen) do
                var (p4, arg) = parse_expr(p3)
                p3 = p4
                n = ast_add_child(n, arg)
                ml = true
                when ml loop
                    var (p5, matched) = match_list_sep(p3, true)
                    p3 = p5
                    if not matched or check(p3, TokType.RParen) do
                        ml = false
                    else
                        var (p6, arg2) = parse_expr(p3)
                        p3 = p6
                        n = ast_add_child(n, arg2)
                    end
                end
            end
            var (p7, _, _) = expect_tok(p3, TokType.RParen, "expected ')' after map args")
            out (p7, n)
        end
        out (p2, n)
    end
    # `port(...)` channel creation
    if t.tok_type == TokType.PortKw do
        var (p2, _) = advance(p)
        n = ast_new(AstType.BuiltinCall)
        n.name = fat_str_new("port")
        n.line = t.line
        n.builtin_id = 90
        if check(p2, TokType.LParen) do
            var (p3, _) = advance(p2)
            p3 = skip_newlines(p3)
            if not check(p3, TokType.RParen) do
                var (p4, arg) = parse_expr(p3)
                p3 = p4
                n = ast_add_child(n, arg)
            end
            var (p5, _, _) = expect_tok(p3, TokType.RParen, "expected ')' after port")
            out (p5, n)
        end
        out (p2, n)
    end

    # `arr_compact(...)` / bare keyword
    if t.tok_type == TokType.ArrCompactKw do
        var (p2, _) = advance(p)
        n = ast_new(AstType.ArrCompactExpr)
        n.name = fat_str_new("arr_compact")
        n.line = t.line
        if check(p2, TokType.LParen) do
            var (p3, _) = advance(p2)
            if not check(p3, TokType.RParen) do
                var (p4, arg) = parse_expr(p3)
                p3 = p4
                n = ast_add_child(n, arg)
            end
            var (p5, _, _) = expect_tok(p3, TokType.RParen, "expected ')' after arr_compact")
            out (p5, n)
        end
        out (p2, n)
    end

    # `error` / `erx` as error-register expr (erx also has statement path)
    if t.tok_type == TokType.ErrorKw or t.tok_type == TokType.ErxKw do
        var (p2, _) = advance(p)
        n = ast_new(AstType.ErrorExpr)
        n.name = fat_str_new("error")
        n.line = t.line
        out (p2, n)
    end

    # Boolean true
    if t.tok_type == TokType.True do
        var (p2, _) = advance(p)
        n = ast_new(AstType.LiteralBool)
        n.int_val = 1
        n.line = t.line
        out (p2, n)
    end

    # Boolean false
    if t.tok_type == TokType.False do
        var (p2, _) = advance(p)
        n = ast_new(AstType.LiteralBool)
        n.int_val = 0
        n.line = t.line
        out (p2, n)
    end

    # Null / none
    if t.tok_type == TokType.NoneLit do
        var (p2, _) = advance(p)
        n = ast_new(AstType.LiteralNone)
        n.int_val = 0
        n.line = t.line
        out (p2, n)
    end

    # Identifier (may be call, index, entity literal...)
    if is_name_token(t.tok_type) do
        var (p2, id_tok) = advance(p)
        id_name = tok_lex(id_tok)
        p = p2

        # Enum access via '::' (rare). Dot form is FieldAccess; lower resolves Enum.Variant.
        if check(p, TokType.DoubleColon) do
            var (p3, _) = advance(p);  # consume ::
            # Variant may be a keyword (e.g. TokType::Func)
            vt = peek(p3)
            var (p4, _) = advance(p3)
            ea = ast_new(AstType.EnumAccess)
            ea.name = id_name
            ea.name2 = tok_lex(vt)
            ea.line = id_tok.line
            out (p4, ea)
        end

        # A generic call or entity literal may place type arguments between
        # the identifier and `(`. Resolve that lookahead before classifying
        # the parenthesized form.
        var (p_gen, skipped_gen) = try_skip_generic_call_args(p)
        if skipped_gen do
            p = p_gen
        end

        # Entity/record literal: IDENT ['<' TypeArgs '>'] '(' field: val, ... ')'
        # (Hard C also accepts '{'…'}' as record literal; soft path uses paren form
        # which is what lexer.vri / most stdlib entities emit.)
        if check(p, TokType.LParen) and check_entity_literal(p) do
            var (p3, _) = advance(p)  # consume '('
            el = ast_new(AstType.EntityLiteral)
            el.name = id_name
            el.line = id_tok.line
            p3 = skip_newlines(p3);    # skip optional newline/semicolon after '('
            var (p3, _) = match_tok(p3, TokType.Semicolon)
            p3 = skip_newlines(p3)
            when not check(p3, TokType.RParen) and not check(p3, TokType.Eof) loop
                var (p4, fname, ok) = expect_name_tok(p3, "expected field name")
                p3 = p4
                if not ok do
                    out (p3, el)
                end
                var (p5, _, _) = expect_tok(p3, TokType.Colon, "expected ':' after field")
                p3 = p5
                var (p6, val) = parse_expr(p3)
                p3 = p6
                val.name2 = fname.str_val
                el = ast_add_child(el, val)
                # Accept ',' or ';' between fields (stdlib uses both).
                var (p7, had_comma) = match_tok(p3, TokType.Comma)
                if had_comma do
                    p3 = p7
                else
                    var (p7b, _) = match_tok(p7, TokType.Semicolon)
                    p3 = p7b
                end
                p3 = skip_newlines(p3)
            end
            var (p8, _, _) = expect_tok(p3, TokType.RParen, "expected ')' after entity literal")
            out (p8, el)
        end

        # Check for function call: IDENT '('
        if check(p, TokType.LParen) do
            bid = lookup_builtin(p.builtins, id_name)
            if bid != BuiltinId.None do
                # Builtin call
                call = ast_new(AstType.BuiltinCall)
                let this_bid = bid as i64
                let this_builtin_name = id_name
                call.builtin_id = this_bid
                call.name = this_builtin_name
                call.line = id_tok.line
                var (p_lp, _) = advance(p)  # consume '('
                p = skip_newlines(p_lp)
                if not check(p, TokType.RParen) do
                    var (p4, arg) = parse_expr(p)
                    p = p4
                    call = ast_add_child(call, arg)
                    should_loop = true
                    when should_loop loop
                        var (p5, matched) = match_list_sep(p, true)
                        p = p5
                        if not matched or check(p, TokType.RParen) do
                            should_loop = false
                        else
                            var (p6, arg2) = parse_expr(p)
                            p = p6
                            call = ast_add_child(call, arg2)
                        end
                    end
                end
                var (p7, _, _) = expect_tok(p, TokType.RParen, "expected ')' after builtin args")
                # ast_add_child corrupts soft .name / .builtin_id — restore after children.
                # Write builtin_id last so it survives if only the final field store sticks.
                call.name = this_builtin_name
                call.builtin_id = this_bid
                out (p7, call)
            end

            # Regular function call
            call = ast_new(AstType.Call)
            let this_call_name = id_name
            call.name = this_call_name
            call.line = id_tok.line
            var (p_lp, _) = advance(p)  # consume '('
            p = skip_newlines(p_lp)
            if not check(p, TokType.RParen) do
                # Detect named args: IDENT followed by '='
                is_named = false
                if p.pos + 1 < p.token_count do
                    na_tok1 = vec_get_rt(p.tokens, p.pos)
                    na_tok2 = vec_get_rt(p.tokens, p.pos + 1)
                    if is_name_token(na_tok1.tok_type) and na_tok2.tok_type == TokType.Assign do
                        is_named = true
                    end
                end
                if is_named do
                    call.int_val = 1
                    should_loop2 = true
                    when should_loop2 loop
                        var (p_n1, name_ident_tok) = advance(p)  # consume name
                        var (p_n2, _) = advance(p_n1)  # consume '='
                        var (p_na, val_expr) = parse_expr(p_n2)
                        p = p_na
                        val_expr.name = tok_lex(name_ident_tok)
                        call = ast_add_child(call, val_expr)
                        # §1.0 / §6.4: named-arg sep is "," | ";" | NEWLINE
                        var (p_sc, sc_matched) = match_list_sep(p, true)
                        p = p_sc
                        if not sc_matched or check(p, TokType.RParen) do
                            should_loop2 = false
                        end
                    end
                else
                    var (p4, arg) = parse_expr(p)
                    p = p4
                    call = ast_add_child(call, arg)
                    should_loop = true
                    when should_loop loop
                        # §1.0: positional arg sep is "," | ";" | NEWLINE
                        var (p5, matched) = match_list_sep(p, true)
                        p = p5
                        if not matched or check(p, TokType.RParen) do
                            should_loop = false
                        else
                            var (p6, arg2) = parse_expr(p)
                            p = p6
                            call = ast_add_child(call, arg2)
                        end
                    end
                end
            end
            var (p7, _, _) = expect_tok(p, TokType.RParen, "expected ')' after arguments")
            # ast_add_child corrupts soft .name — restore after children.
            call.name = this_call_name
            out (p7, call)
        end

        # Check for index access: IDENT '['
        if check(p, TokType.LBracket) do
            var (p3, lbr_tok) = advance(p)  # consume '['
            if check(p3, TokType.Comma) do
                p_err = parse_error_at(p3, "unexpected ',' at start of index", peek(p3).line)
                out (p_err, ast_new(AstType.IndexAccess))
            end
            if check(p3, TokType.RBracket) do
                p_err = parse_error_at(p3, "expected expression after '['", peek(p3).line)
                out (p_err, ast_new(AstType.IndexAccess))
            end
            var (p4, idx_expr) = parse_expr(p3)
            if check(p4, TokType.DotDot) do
                var (p4b, _) = advance(p4)
                var (p4c, end_expr) = parse_expr(p4b)
                var (p5, _, _) = expect_tok(p4c, TokType.RBracket, "expected ']' after slice")
                access = ast_new(AstType.IndexAccess)
                access.name = id_name
                access.name2 = fat_str_new("__slice__")
                access.line = id_tok.line
                access = ast_add_child(access, idx_expr)
                access = ast_add_child(access, end_expr)
                out (p5, access)
            end
            access = ast_new(AstType.IndexAccess)
            access.name = id_name
            access.line = id_tok.line
            access = ast_add_child(access, idx_expr)
            p_cur = p4
            var idx_loop = true
            when idx_loop loop
                if check(p_cur, TokType.Comma) do
                    var (p_comma, _) = advance(p_cur)
                    if check(p_comma, TokType.RBracket) do
                        p_cur = parse_error_at(p_comma, "unexpected ',' before ']'", peek(p_comma).line)
                        idx_loop = false
                    else
                        var (p_next, next_idx) = parse_expr(p_comma)
                        access = ast_add_child(access, next_idx)
                        p_cur = p_next
                    end
                else
                    idx_loop = false
                end
            end
            var (p5, _, _) = expect_tok(p_cur, TokType.RBracket, "expected ']' after index")
            out (p5, access)
        end

        # Plain identifier
        n = ast_new(AstType.Identifier)
        n.name = id_name
        n.line = id_tok.line
        out (p, n)
    end

    # Input expression
    if t.tok_type == TokType.Input do
        var (p2, _) = advance(p)
        n = ast_new(AstType.InputExpr)
        n.line = t.line
        out (p2, n)
    end

    # Parenthesised expression or tuple: (expr) / (a, b, …)
    if t.tok_type == TokType.LParen do
        var (p2, _) = advance(p)
        p2 = skip_newlines(p2)
        if check(p2, TokType.RParen) do
            # Empty tuple ()
            var (p3, _) = advance(p2)
            tup = ast_new(AstType.TupleExpr)
            tup.line = t.line
            out (p3, tup)
        end
        var (p3, inner) = parse_expr(p2)
        p2 = p3
        if check(p2, TokType.Comma) do
            tup = ast_new(AstType.TupleExpr)
            tup.line = t.line
            tup = ast_add_child(tup, inner)
            when check(p2, TokType.Comma) loop
                var (p4, _) = advance(p2)
                p4 = skip_newlines(p4)
                if check(p4, TokType.RParen) do
                    p2 = p4
                else
                    var (p5, elem) = parse_expr(p4)
                    tup = ast_add_child(tup, elem)
                    p2 = p5
                end
            end
            var (p6, _, _) = expect_tok(p2, TokType.RParen, "expected ')' to close tuple")
            out (p6, tup)
        end
        var (p4, _, _) = expect_tok(p2, TokType.RParen, "expected ')'")
        out (p4, inner)
    end

    # Array or Dict literal: [elem, ...] or [key: val, ...]
    if t.tok_type == TokType.LBracket do
        var (p2, _) = advance(p)
        p2 = skip_newlines(p2)
        arr = ast_new(AstType.ArrayLiteral)
        arr.line = t.line
        if not check(p2, TokType.RBracket) do
            var (p3, elem) = parse_expr(p2)
            p2 = skip_newlines(p3)
            if check(p2, TokType.Colon) do
                # Dict Literal: [key: val, ...]
                arr.node_type = AstType.DictLiteral
                arr.name = fat_str_new("dict")
                var (p_col, _) = advance(p2)
                p_col = skip_newlines(p_col)
                var (p_val, val_elem) = parse_expr(p_col)
                p2 = skip_newlines(p_val)
                arr = ast_add_child(arr, elem)
                arr = ast_add_child(arr, val_elem)
                when check(p2, TokType.Comma) loop
                    var (p4, _) = advance(p2)
                    p4 = skip_newlines(p4)
                    if check(p4, TokType.RBracket) do
                        p2 = p4
                    else
                        var (p5, key_next) = parse_expr(p4)
                        p5 = skip_newlines(p5)
                        var (p6, _, _) = expect_tok(p5, TokType.Colon, "expected ':' after dict key")
                        p6 = skip_newlines(p6)
                        var (p7, val_next) = parse_expr(p6)
                        p2 = skip_newlines(p7)
                        arr = ast_add_child(arr, key_next)
                        arr = ast_add_child(arr, val_next)
                    end
                end
            eif check(p2, TokType.Semicolon) do
                # Fill syntax: [init_val; count]
                var (p_semi, _) = advance(p2)
                p_semi = skip_newlines(p_semi)
                var (p_cnt, count_tok, _) = expect_tok(p_semi, TokType.Int, "expected integer for array fill count")
                p2 = skip_newlines(p_cnt)
                let fill_count = count_tok.int_val
                var fi = 0
                when fi < fill_count loop
                    arr = ast_add_child(arr, elem)
                    fi = fi + 1
                end
            else
                arr = ast_add_child(arr, elem)
                should_loop = true
                when should_loop loop
                    p2 = skip_newlines(p2)
                    var (p4, matched) = match_tok(p2, TokType.Comma)
                    p2 = skip_newlines(p4)
                    if check(p2, TokType.RBracket) or not matched do
                        should_loop = false
                    else
                        var (p5, elem2) = parse_expr(p2)
                        p2 = skip_newlines(p5)
                        arr = ast_add_child(arr, elem2)
                    end
                end
            end
        end
        p2 = skip_newlines(p2)
        var (p6, _, _) = expect_tok(p2, TokType.RBracket, "expected ']' after literal")
        out (p6, arr)
    end

    # Error — expected expression
    p = parse_error(p, "expected expression")
    out (p, ast_new(AstType.LiteralInt))
end.
func check_entity_literal(p: Parser):

    # Lookahead: '(' [NL|SEMI]* IDENT ':' ...
    # Empty '()' is a call. Bare NL/SEMI after '(' is NOT enough (avoids foo(\n expr)).
    if not check(p, TokType.LParen) do
        out false
    end
    next_idx = p.pos + 1
    when next_idx < p.token_count and (vec_get_rt(p.tokens, next_idx).tok_type == TokType.Newline or vec_get_rt(p.tokens, next_idx).tok_type == TokType.Semicolon) loop
        next_idx = next_idx + 1
    end
    if next_idx >= p.token_count do
        out false
    end
    t1 = vec_get_rt(p.tokens, next_idx)
    if t1.tok_type == TokType.RParen do
        out false
    end
    if next_idx + 1 < p.token_count do
        t2 = vec_get_rt(p.tokens, next_idx + 1)
        if is_name_token(t1.tok_type) and t2.tok_type == TokType.Colon do
            out true
        end
    end
    out false
end.
func try_skip_generic_call_args(p: Parser):

    # If at '<' and span is type-args then '(', move p.pos to that '('; else
    # leave it unchanged.  This must be index-only lookahead: Parser aggregates
    # alias in the bootstrap VM, so speculative advance(p) calls mutate the
    # caller even when this function returns the original value.  A comparison
    # such as `total < end_pos loop` was therefore scanned all the way to EOF
    # while looking for a generic-closing `>`.
    if not check(p, TokType.Lt) do
        out (p, false)
    end
    if p.pos + 1 >= p.token_count do
        out (p, false)
    end
    if not is_name_token(vec_get_rt(p.tokens, p.pos + 1).tok_type) do
        out (p, false)
    end
    idx = p.pos
    depth = 1
    paren_depth = 0
    bracket_depth = 0
    idx = idx + 1
    steps = 0
    valid = true
    when depth > 0 and idx < p.token_count and valid loop
        tt = vec_get_rt(p.tokens, idx).tok_type
        if tt == TokType.Lt do
            depth = depth + 1
        eif tt == TokType.Gt do
            depth = depth - 1
        eif tt == TokType.Cast do
            depth = depth - 2
        eif tt == TokType.LParen do
            paren_depth = paren_depth + 1
        eif tt == TokType.RParen do
            if paren_depth > 0 do
                paren_depth = paren_depth - 1
            else
                valid = false
            end
        eif tt == TokType.LBracket do
            bracket_depth = bracket_depth + 1
        eif tt == TokType.RBracket do
            if bracket_depth > 0 do
                bracket_depth = bracket_depth - 1
            else
                valid = false
            end
        eif paren_depth == 0 and bracket_depth == 0 and
             (tt == TokType.Newline or tt == TokType.Semicolon or
              tt == TokType.Do or tt == TokType.Then or tt == TokType.Loop or
              tt == TokType.Assign or tt == TokType.Colon or tt == TokType.RBrace or tt == TokType.Eof or
              tt == TokType.Plus or tt == TokType.Minus or tt == TokType.Slash or
              tt == TokType.Mod or
              tt == TokType.Eq or tt == TokType.Ne or tt == TokType.Ge or tt == TokType.Le or
              tt == TokType.And or tt == TokType.Or or tt == TokType.LogicalOr or
              tt == TokType.BitOr or tt == TokType.BitXor or
              tt == TokType.BitShl or tt == TokType.BitShr or tt == TokType.Pattern) do
            # This is an ordinary comparison/expression, not TypeArgs.
            valid = false
        end
        idx = idx + 1
        steps = steps + 1
        # A malformed '<' must never scan an unbounded suffix for a later '>'.
        # 128 tokens is far beyond normal type-argument lists while keeping
        # lookahead O(1) with respect to the rest of the source file.
        if steps > 128 do
            valid = false
        end
    end
    if not valid or depth != 0 do
        out (p, false)
    end
    if idx >= p.token_count or vec_get_rt(p.tokens, idx).tok_type != TokType.LParen do
        out (p, false)
    end
    p.pos = idx
    out (p, true)
end.
# Spec §30 precedence (tight → loose):
#   postfix . ?. ~mask !! ? | unary ! - ~ & &mut | ^ (right) | ** >< |
#   * / | % mod | shl shr as | + - | :~ | rel | eq | & and | || or xor
# Parser must match Spec; do not "fix" Spec to match parser.
#
# Binding-power dispatch table (Pratt). parse_* layers below implement these levels.
func infix_bp_left(t: TokType):
    if t == TokType.LogicalOr or t == TokType.BitOr or t == TokType.Or or t == TokType.BitXor do out 1 end
    if t == TokType.LogicalAnd or t == TokType.And do out 5 end
    if t == TokType.BitAnd do out 5 end
    if t == TokType.Eq or t == TokType.Ne or t == TokType.SafeEq or t == TokType.SafeNe do out 7 end
    if t == TokType.Gt or t == TokType.Lt or t == TokType.Ge or t == TokType.Le do out 9 end
    if t == TokType.Pattern do out 11 end
    if t == TokType.Plus or t == TokType.Minus do out 13 end
    if t == TokType.As or t == TokType.Cast or t == TokType.BitShl or t == TokType.BitShr do out 15 end
    if t == TokType.Mod do out 17 end
    if t == TokType.Star or t == TokType.Slash do out 19 end
    if t == TokType.MatMul or t == TokType.Fma do out 21 end
    if t == TokType.Power do out 23 end
    out 0
end.

func infix_bp_right(t: TokType):
    if t == TokType.Power do out 22 end
    l = infix_bp_left(t)
    if l > 0 do out l + 1 end
    out 0
end.

func parse_infix_make(left: AstNode, op_tok: Token, right: AstNode):
    tt = op_tok.tok_type
    if tt == TokType.Eq or tt == TokType.Ne or tt == TokType.SafeEq or tt == TokType.SafeNe do
        op = OpType.Eq
        if tt == TokType.Ne do op = OpType.Ne end
        if tt == TokType.SafeEq do op = OpType.SafeEq end
        if tt == TokType.SafeNe do op = OpType.SafeNe end
        cmp = ast_new(AstType.Compare)
        cmp.op = op
        cmp.line = op_tok.line
        cmp = ast_add_child(cmp, left)
        cmp = ast_add_child(cmp, right)
        out cmp
    end
    if tt == TokType.Gt or tt == TokType.Lt or tt == TokType.Ge or tt == TokType.Le do
        op = OpType.Gt
        if tt == TokType.Lt do op = OpType.Lt end
        if tt == TokType.Ge do op = OpType.Ge end
        if tt == TokType.Le do op = OpType.Le end
        cmp = ast_new(AstType.Compare)
        cmp.op = op
        cmp.line = op_tok.line
        cmp = ast_add_child(cmp, left)
        cmp = ast_add_child(cmp, right)
        out cmp
    end
    if tt == TokType.Pattern do
        n = ast_new(AstType.PatternExpr)
        n.op = OpType.PatternOp
        n.line = op_tok.line
        n = ast_add_child(n, left)
        n = ast_add_child(n, right)
        out n
    end
    bin = ast_new(AstType.BinOp)
    bin.op = OpType.Add
    bin.line = op_tok.line
    if tt == TokType.Plus do bin.op = OpType.Add end
    if tt == TokType.Minus do bin.op = OpType.Sub end
    if tt == TokType.Star do bin.op = OpType.Mul end
    if tt == TokType.Slash do bin.op = OpType.Div end
    if tt == TokType.Mod do bin.op = OpType.ModOp end
    if tt == TokType.BitShl do bin.op = OpType.ShlOp end
    if tt == TokType.BitShr do bin.op = OpType.ShrOp end
    if tt == TokType.Power do bin.op = OpType.PowOp end
    if tt == TokType.MatMul do bin.op = OpType.MatMulOp end
    if tt == TokType.Fma do bin.op = OpType.FmaOp end
    # `&` / `and` / `and` → bitwise AndOp (Bool×Bool also allowed in pass 6).
    if tt == TokType.BitAnd do bin.op = OpType.AndOp end
    if tt == TokType.And do bin.op = OpType.AndOp end
    if tt == TokType.BitOr do bin.op = OpType.OrOp end
    if tt == TokType.Or do bin.op = OpType.OrOp end
    if tt == TokType.BitXor do bin.op = OpType.XorOp end
    if tt == TokType.LogicalOr do bin.op = OpType.Lor end
    if tt == TokType.LogicalAnd do bin.op = OpType.Land end
    bin = ast_add_child(bin, left)
    bin = ast_add_child(bin, right)
    out bin
end.

# Unified Pratt parser (replaces parse_power … parse_or_expr chain).
func parse_expr_bp(p: Parser, min_bp: int):
    var (p2, left) = parse_unary(p)
    pratt_more = true
    when pratt_more loop
        p2 = skip_newlines(p2)
        op_t = peek(p2)
        tt = op_t.tok_type
        lbp = infix_bp_left(tt)
        if lbp < min_bp do
            pratt_more = false
        eif tt == TokType.As or tt == TokType.Cast do
            # Cast binds tighter than the following lower-precedence operator.
            # Keep the Pratt loop running so `(x as int and mask)` consumes
            # `and mask` instead of returning with `and` before `)`.
            var (p3, _) = advance(p2)
            if check(p3, TokType.Ident) or check(p3, TokType.PtrKw) do
                var (p4, _) = advance(p3)
                p3 = p4
            end
            cast_n = ast_new(AstType.CastExpr)
            cast_n = ast_add_child(cast_n, left)
            left = cast_n
            p2 = p3
        eif lbp > 0 do
            var (p3, op_tok) = advance(p2)
            rbp = infix_bp_right(op_tok.tok_type)
            var (p4, right) = parse_expr_bp(p3, rbp)
            left = parse_infix_make(left, op_tok, right)
            p2 = p4
        else
            pratt_more = false
        end
    end
    out (p2, left)
end.

func parse_unary(p: Parser):

    # Allow `a +\n b` / multiline args inside `()` once lexer emits NEWLINE (§1.0).
    p = skip_newlines(p)

    # Unary minus
    if check(p, TokType.Minus) do
        var (p2, t) = advance(p)
        var (p3, operand) = parse_unary(p2)
        if operand.node_type == AstType.LiteralFloat do
            flt_bits = native_read_i64(operand as int, 48)
            native_write_i64(operand as int, 48, flt_bits xor (1 shl 63))
            operand.line = t.line
            out (p3, operand)
        end
        if operand.node_type == AstType.LiteralInt do
            operand.int_val = 0 - operand.int_val
            operand.line = t.line
            out (p3, operand)
        end
        zero = ast_new(AstType.LiteralInt)
        zero.int_val = 0
        zero.line = t.line
        n = ast_new(AstType.BinOp)
        n.op = OpType.Sub
        n.line = t.line
        n = ast_add_child(n, zero)
        n = ast_add_child(n, operand)
        out (p3, n)
    end

    # Boolean `not` / `!` → x == 0 (truthiness)
    if check(p, TokType.Not) do
        var (p2, t) = advance(p)
        var (p3, operand) = parse_unary(p2)
        zero = ast_new(AstType.LiteralInt)
        zero.int_val = 0
        zero.line = t.line
        n = ast_new(AstType.Compare)
        n.op = OpType.Eq
        n.line = t.line
        n = ast_add_child(n, operand)
        n = ast_add_child(n, zero)
        out (p3, n)
    end

    # Bitwise `~` → UnaryNot
    if check(p, TokType.BitNot) do
        var (p2, t) = advance(p)
        var (p3, operand) = parse_unary(p2)
        n = ast_new(AstType.UnaryNot)
        n.line = t.line
        n = ast_add_child(n, operand)
        out (p3, n)
    end

    # `&mut expr` shared/mut borrow
    if check(p, TokType.BorrowMut) do
        var (p2, t) = advance(p)
        var (p3, operand) = parse_unary(p2)
        n = ast_new(AstType.AddrOf)
        n.name = fat_str_new("mut")
        n.line = t.line
        n = ast_add_child(n, operand)
        out (p3, n)
    end

    # `& expr` shared borrow (BitAnd as prefix, not binary)
    if check(p, TokType.BitAnd) do
        var (p2, t) = advance(p)
        # `&mut` may also be two tokens if lexer split — accept MutKw
        if check(p2, TokType.MutKw) do
            var (p2b, _) = advance(p2)
            var (p3, operand) = parse_unary(p2b)
            n = ast_new(AstType.AddrOf)
            n.name = fat_str_new("mut")
            n.line = t.line
            n = ast_add_child(n, operand)
            out (p3, n)
        end
        var (p3, operand) = parse_unary(p2)
        n = ast_new(AstType.AddrOf)
        n.name = fat_str_new("shared")
        n.line = t.line
        n = ast_add_child(n, operand)
        out (p3, n)
    end

    # `precomp expr` (§17)
    if check(p, TokType.PrecompKw) do
        var (p2, t) = advance(p)
        var (p3, operand) = parse_unary(p2)
        n = ast_new(AstType.PrecompBlock)
        n.name = fat_str_new("precomp")
        n.line = t.line
        n = ast_add_child(n, operand)
        out (p3, n)
    end

    # `recv port` (§23)
    if check(p, TokType.RecvKw) and (is_name_token(peek_n(p, 1).tok_type) or peek_n(p, 1).tok_type == TokType.LParen) do
        var (p2, t) = advance(p)
        var (p3, operand) = parse_unary(p2)
        n = ast_new(AstType.RecvExpr)
        n.line = t.line
        n = ast_add_child(n, operand)
        out (p3, n)
    end

    # `await expr` / `await pass` (§22)
    if check(p, TokType.AwaitKw) do
        var (p2, t) = advance(p)
        if check(p2, TokType.PassKw) do
            var (p_pass, _) = advance(p2)
            n = ast_new(AstType.AwaitPass)
            n.line = t.line
            out (p_pass, n)
        end
        var (p3, operand) = parse_unary(p2)
        n = ast_new(AstType.AwaitExpr)
        n.line = t.line
        n = ast_add_child(n, operand)
        out (p3, n)
    end

    # Primary + postfix: . ?. ~mask !! ?
    var (p2, left) = parse_primary(p)
    pf = true
    when pf loop
        if check(p2, TokType.Percent) do
            # Spec §10.1: postfix percent, e.g. 10% == 0.1, 10.5% == 0.105.
            var (p3, percent_tok) = advance(p2)
            pct = ast_new(AstType.PercentExpr)
            pct.op = OpType.PercentOp
            pct.line = percent_tok.line
            pct = ast_add_child(pct, left)
            left = pct
            p2 = p3
            # `%` is never a binary remainder operator. An adjacent expression
            # after the postfix form is almost certainly legacy `a % b`.
            next_tt = peek(p2).tok_type
            if next_tt == TokType.Int or next_tt == TokType.Float or next_tt == TokType.Str or
               next_tt == TokType.Ident or next_tt == TokType.LParen or next_tt == TokType.LBracket or
               next_tt == TokType.True or next_tt == TokType.False or next_tt == TokType.NoneLit or
               next_tt == TokType.ThisKw do
                p2 = parse_error(p2, "'%' is postfix percent; use 'mod' for remainder")
            end
        eif check(p2, TokType.SafeAccess) do
            var (p3, _) = advance(p2)
            ft = peek(p3)
            if ft.tok_type == TokType.Eof or ft.tok_type == TokType.Newline do
                out (p3, left)
            end
            var (p4, field_tok) = advance(p3)
            sa = ast_new(AstType.SafeAccessExpr)
            sa.name = tok_lex(field_tok)
            sa.line = field_tok.line
            sa = ast_add_child(sa, left)
            left = sa
            p2 = p4
        eif check(p2, TokType.Dot) do
            var (p3, _) = advance(p2)
            ft = peek(p3)
            if ft.tok_type == TokType.Eof or ft.tok_type == TokType.Newline do
                out (p3, left)
            end
            var (p4, field_tok) = advance(p3)
            if check(p4, TokType.LParen) do
                mc = ast_new(AstType.MethodCall)
                mc_name = tok_lex(field_tok)
                mc.name = mc_name
                mc.line = field_tok.line
                mc = ast_add_child(mc, left)
                var (p5, _) = advance(p4)
                p5 = skip_newlines(p5)
                if not check(p5, TokType.RParen) do
                    var (p6, arg) = parse_expr(p5)
                    p5 = p6
                    mc = ast_add_child(mc, arg)
                    mc_loop = true
                    when mc_loop loop
                        var (p7, mc_matched) = match_list_sep(p5, true)
                        p5 = p7
                        if not mc_matched or check(p5, TokType.RParen) do
                            mc_loop = false
                        else
                            var (p8, arg2) = parse_expr(p5)
                            p5 = p8
                            mc = ast_add_child(mc, arg2)
                        end
                    end
                end
                var (p9, _, _) = expect_tok(p5, TokType.RParen, "expected ')' after method args")
                mc.name = mc_name
                left = mc
                p2 = p9
            else
                fa = ast_new(AstType.FieldAccess)
                fa_name = tok_lex(field_tok)
                fa.name = fa_name
                fa.line = field_tok.line
                fa = ast_add_child(fa, left)
                fa.name = fa_name
                left = fa
                p2 = p4
            end
        eif (check(p2, TokType.BitNot) or check(p2, TokType.Swizzle)) and peek_n(p2, 1).tok_type == TokType.Ident do
            # postfix swizzle: v~mask
            var (p3, op_tok) = advance(p2)
            var (p4, mask_tok) = advance(p3)
            sw = ast_new(AstType.SwizzleExpr)
            sw.name = tok_lex(mask_tok)
            sw.line = op_tok.line
            sw = ast_add_child(sw, left)
            left = sw
            p2 = p4
        eif check(p2, TokType.AtomicBang) do
            var (p3, op_tok) = advance(p2)
            ab = ast_new(AstType.BuiltinCall)
            ab.name = fat_str_new("atomic_bang")
            ab.line = op_tok.line
            ab = ast_add_child(ab, left)
            left = ab
            p2 = p3
        eif check(p2, TokType.Exist) do
            # postfix optional `?`
            var (p3, op_tok) = advance(p2)
            ex = ast_new(AstType.ExistExpr)
            ex.line = op_tok.line
            ex = ast_add_child(ex, left)
            left = ex
            p2 = p3
        eif check(p2, TokType.LBracket) do
            var (p3, lbr_tok) = advance(p2)
            if check(p3, TokType.Comma) do
                p_err = parse_error_at(p3, "unexpected ',' at start of index", peek(p3).line)
                out (p_err, left)
            end
            if check(p3, TokType.RBracket) do
                p_err = parse_error_at(p3, "expected expression after '['", peek(p3).line)
                out (p_err, left)
            end
            var (p4, idx1) = parse_expr(p3)
            if check(p4, TokType.DotDot) do
                var (p4b, _) = advance(p4)
                var (p4c, end_expr) = parse_expr(p4b)
                var (p5, _, _) = expect_tok(p4c, TokType.RBracket, "expected ']' after slice")
                idx_node = ast_new(AstType.ExprIndex)
                idx_node.line = lbr_tok.line
                idx_node.name2 = fat_str_new("__slice__")
                idx_node = ast_add_child(idx_node, left)
                idx_node = ast_add_child(idx_node, idx1)
                idx_node = ast_add_child(idx_node, end_expr)
                left = idx_node
                p2 = p5
            else
                idx_node = ast_new(AstType.ExprIndex)
                idx_node.line = lbr_tok.line
                idx_node = ast_add_child(idx_node, left)
                idx_node = ast_add_child(idx_node, idx1)
                p_cur = p4
                var idx_loop = true
                when idx_loop loop
                    if check(p_cur, TokType.Comma) do
                        var (p_comma, _) = advance(p_cur)
                        if check(p_comma, TokType.RBracket) do
                            p_cur = parse_error_at(p_comma, "unexpected ',' before ']'", peek(p_comma).line)
                            idx_loop = false
                        else
                            var (p_next, next_idx) = parse_expr(p_comma)
                            idx_node = ast_add_child(idx_node, next_idx)
                            p_cur = p_next
                        end
                    else
                        idx_loop = false
                    end
                end
                var (p5, _, _) = expect_tok(p_cur, TokType.RBracket, "expected ']' after index")
                left = idx_node
                p2 = p5
            end
        else
            pf = false
        end
    end
    out (p2, left)
end.

func parse_expr(p: Parser):
    out parse_expr_bp(p, 0)
end.
# ═══════════════════════════════════════════════════════
# Statement Parsing
# ═══════════════════════════════════════════════════════

func parse_block(p: Parser):

    block = ast_new(AstType.Block)
    p = skip_newlines(p)

    should_continue = true
    when should_continue loop
        if check(p, TokType.End) or check(p, TokType.Else) or check(p, TokType.Eif) or check(p, TokType.Eof) or check(p, TokType.EnsureKw) or check(p, TokType.RevertKw) do
            should_continue = false
        eif check(p, TokType.ThrowKw) do
            var (p_t, _) = advance(p)
            var (p_t2, throw_expr) = parse_expr(p_t)
            n_throw = ast_new(AstType.ThrowStmt)
            n_throw.line = peek(p).line
            n_throw = ast_add_child(n_throw, throw_expr)
            block = ast_add_child(block, n_throw)
            p = p_t2
            p = skip_newlines(p)
        else
            let old_pos = p.pos
            var (p2, stmt) = parse_statement(p)
            if p2.pos == old_pos and rt_strlen(p2.error_msg) == 0 do
                # Forced progress if parse_statement failed to consume any token
                var (p_adv, _) = advance(p)
                p = p_adv
            else
                p = p2
                block = ast_add_child(block, stmt)
            end

            if rt_strlen(p.error_msg) > 0 do
                out (p, block)
            end
            # Skip optional trailing semicolons
            when check(p, TokType.Semicolon) loop
                var (p_semi, _) = advance(p)
                p = p_semi
            end
            p = skip_newlines(p)
        end
    end
    out (p, block)
end.
func parse_var_decl_single(p: Parser, is_const: bool):

    if check(p, TokType.LParen) do
        var (p_lp, _) = advance(p)
        decl = ast_new(AstType.VarDecl)
        decl.int_val = 16384; # tuple destructuring flag
        p2 = p_lp
        when not check(p2, TokType.RParen) and not check(p2, TokType.Eof) loop
            var (p3, id_tok, ok) = expect_name_tok(p2, "expected tuple var name")
            if ok do
                id_node = ast_new(AstType.Identifier)
                id_node.name = id_tok.str_val
                id_node.line = id_tok.line
                decl = ast_add_child(decl, id_node)
            end
            p2 = p3
            var (p4, had_comma) = match_tok(p2, TokType.Comma)
            if had_comma do
                p2 = p4
            end
        end
        var (p5, _, _) = expect_tok(p2, TokType.RParen, "expected ')'")
        p2 = p5
        var (p6, matched) = match_tok(p2, TokType.Assign)
        if matched do
            var (p7, init) = parse_expr(p6)
            decl = ast_add_child(decl, init)
            var (p8, _) = match_tok(p7, TokType.Semicolon)
            out (p8, decl)
        end
        out (p2, decl)
    end

    # Allow contextual keywords (e.g. `ptr`) as variable names in declarations.
    # If `ptr` (TokType.PtrKw) appears where a variable name is expected, treat it as ident.
    if check(p, TokType.PtrKw) do
        var (p_ptr, ptr_tok) = advance(p)
        p2 = p_ptr
        name_tok = ptr_tok
        name_tok.str_val = fat_str_new("ptr")
        ok = true
    else
        var (p2x, name_tok_x, ok_x) = expect_name_tok(p, "expected variable name")
        p2 = p2x
        name_tok = name_tok_x
        ok = ok_x
    end
    if not ok do
        out (p2, ast_new(AstType.VarDecl))
    end

    decl_type = AstType.VarDecl
    if is_const do
        decl_type = AstType.ConstDecl
    end
    decl = ast_new(decl_type)
    decl_name = name_tok.str_val
    decl.name = decl_name
    decl.line = name_tok.line

    p3 = p2
    # Type annotation: x: int = 10. Parser handles are mutable, so decide
    # whether ':' starts a type annotation before advancing it; otherwise p2
    # aliases the advanced parser and `const X: 42` loses its initializer.
    if check(p3, TokType.Colon) do
        colon_next = peek_n(p3, 1)
        colon_after = peek_n(p3, 2)
        colon_is_type = not is_const
        if is_const and is_name_token(colon_next.tok_type) and colon_after.tok_type == TokType.Assign do
            colon_is_type = true
        end
        if colon_is_type do
            var (p_col, _) = advance(p3)
            var (p_end_type, type_str) = parse_type_expr_string(p_col)
            decl.name2 = type_str
            p3 = p_end_type
        end
    end

    var (p4, matched) = match_tok(p3, TokType.Assign)
    if matched do
        p3 = p4
    end
    if not matched do
        # Also accept : as separator for const decls (const FOO: 42)
        var (p3b, matched2) = match_tok(p2, TokType.Colon)
        if matched2 do
            matched = true
            p3 = p3b
        end
    end
    if matched do
        var (p5, init) = parse_expr(p3)
        decl = ast_add_child(decl, init)
        # ast_add_child corrupts soft .name — restore for lowering / var map.
        decl.name = decl_name
        # Skip optional semicolon
        var (p6, _) = match_tok(p5, TokType.Semicolon)
        out (p6, decl)
    end
    decl.name = decl_name
    out (p3, decl)
end.
func parse_var_decl(p: Parser, is_const: bool):

    p = skip_newlines(p)
    var (p2, first_decl) = parse_var_decl_single(p, is_const)

    p_curr = p2
    block = ast_new(AstType.Block)
    block = ast_add_child(block, first_decl)
    count = 1

    when true loop
        var has_sep = false
        var (p_sep, had_comma) = match_tok(p_curr, TokType.Comma)
        if had_comma do
            has_sep = true
            p_curr = p_sep
        else
            var (p_sep2, had_semi) = match_tok(p_curr, TokType.Semicolon)
            if had_semi do
                has_sep = true
                p_curr = p_sep2
            end
        end
        if not has_sep do
            break
        end

        p_next = skip_newlines(p_curr)

        if check(p_next, TokType.Ident) do
            next_idx = p_next.pos + 1
            if next_idx < p_next.token_count do
                t2 = vec_get_rt(p_next.tokens, next_idx)
                if t2.tok_type == TokType.Assign or t2.tok_type == TokType.Colon or t2.tok_type == TokType.Semicolon or t2.tok_type == TokType.Newline do
                    var (p_sub, nxt_decl) = parse_var_decl_single(p_next, is_const)
                    block = ast_add_child(block, nxt_decl)
                    count = count + 1
                    p_curr = p_sub
                    skip
                end
            end
        end
        break
    end

    if count == 1 do
        out (p2, first_decl)
    end
    out (p_curr, block)
end.
func parse_const_decl(p: Parser):

    var (p2, decl) = parse_var_decl(p, true)
    out (p2, decl)
end.
func parse_if_stmt(p: Parser):

    line = peek(p).line
    var (p2, cond) = parse_expr(p)

    # Optional colon / 'do' / 'then' after condition
    var (p2b, _) = match_tok(p2, TokType.Colon)
    p2 = p2b
    var (p2c, _) = match_tok(p2, TokType.Do)
    p2 = p2c
    var (p2d, _) = match_tok(p2, TokType.Then)
    p2 = p2d

    # Implicit block opening (v1.2: no 'then' keyword needed)
    p2 = skip_newlines(p2)

    var (p3, then_block) = parse_block(p2)

    if_node = ast_new(AstType.IfStmt)
    if_node.line = line
    if_node = ast_add_child(if_node, cond)
    if_node = ast_add_child(if_node, then_block)

    # Handle eif (elif)
    if check(p3, TokType.Eif) do
        var (p4, _) = advance(p3)
        var (p5, elif_as_if) = parse_if_stmt(p4)
        else_block = ast_new(AstType.Block)
        else_block = ast_add_child(else_block, elif_as_if)
        if_node = ast_add_child(if_node, else_block)
        out (p5, if_node)
    end

    # Handle else — continuation (§1.1): no ':'
    var (p4, has_else) = match_tok(p3, TokType.Else)
    if has_else do
        if check(p4, TokType.Colon) do
            var (p_err, _, _) = expect_name_tok(p4, "'else' does not take ':' (spec 1.1)")
            p4 = p_err
        end
        p4 = skip_newlines(p4)
        var (p5, else_block) = parse_block(p4)
        if_node = ast_add_child(if_node, else_block)
        p4 = p5
    end

    var (p5, _, _) = expect_tok(p4, TokType.End, "expected 'end' after if block")
    out (p5, if_node)
end.

# §21: next case arm begins at `pattern:` / `else` (optional leading `case`).
# Used to stop colon-arm bodies without requiring `case` on every arm.
func case_arm_starts_here(p: Parser):
    if check(p, TokType.End) or check(p, TokType.Eof) do
        out false
    end
    if check(p, TokType.Else) or check(p, TokType.Case) do
        out true
    end

    idx = p.pos
    if idx >= p.token_count do
        out false
    end
    t = vec_get_rt(p.tokens, idx).tok_type

    if t == TokType.Int do
        idx = idx + 1
        if idx + 1 < p.token_count and vec_get_rt(p.tokens, idx).tok_type == TokType.DotDot and vec_get_rt(p.tokens, idx + 1).tok_type == TokType.Int do
            idx = idx + 2
        end
        if idx < p.token_count and vec_get_rt(p.tokens, idx).tok_type == TokType.Colon do
            out true
        end
        out false
    end

    if t == TokType.Str or t == TokType.True or t == TokType.False or t == TokType.NoneLit do
        idx = idx + 1
        if idx < p.token_count and vec_get_rt(p.tokens, idx).tok_type == TokType.Colon do
            out true
        end
        out false
    end

    if not is_name_token(t) do
        out false
    end

    idx = idx + 1
    when idx < p.token_count and vec_get_rt(p.tokens, idx).tok_type == TokType.Dot loop
        idx = idx + 1
        if idx >= p.token_count do
            out false
        end
        if not is_name_token(vec_get_rt(p.tokens, idx).tok_type) do
            out false
        end
        idx = idx + 1
    end

    had_payload_paren = false
    if idx < p.token_count and vec_get_rt(p.tokens, idx).tok_type == TokType.LParen do
        had_payload_paren = true
        depth = 1
        idx = idx + 1
        when depth > 0 and idx < p.token_count loop
            tt = vec_get_rt(p.tokens, idx).tok_type
            if tt == TokType.LParen do
                depth = depth + 1
            end
            if tt == TokType.RParen do
                depth = depth - 1
            end
            idx = idx + 1
        end
    end

    if idx < p.token_count and vec_get_rt(p.tokens, idx).tok_type == TokType.Colon do
        out true
    end

    # Block arm without colon: `Enum.Variant` NEWLINE body (§21 / conformance).
    if not had_payload_paren and idx < p.token_count and vec_get_rt(p.tokens, idx).tok_type == TokType.Newline do
        out true
    end

    out false
end.

func parse_case_stmt(p: Parser):

    line = peek(p).line
    var (p2, expr) = parse_expr(p)
    p2 = skip_newlines(p2)
    n = ast_new(AstType.CaseExpr)
    n.line = line
    n = ast_add_child(n, expr)
    when not check(p2, TokType.Else) and not check(p2, TokType.End) and not check(p2, TokType.Eof) loop
        # Optional leading `case` on each arm (v2 style).
        var (p2b, _) = match_tok(p2, TokType.Case)
        p2 = p2b
        # Pattern: _ | else | Int | Str | Ident[(...)]
        pat = ast_new(AstType.Identifier)
        pat.name = fat_str_new("_")
        pat.int_val = 0 - 1
        if check(p2, TokType.Else) do
            var (p3, _) = advance(p2)
            p2 = p3
        eif check(p2, TokType.Int) do
            var (p3, it) = advance(p2)
            pat = ast_new(AstType.LiteralInt)
            pat.int_val = it.int_val
            p2 = p3
            if check(p2, TokType.DotDot) do
                var (p_dd, _) = advance(p2)
                var (p_hi, hi_tok, _) = expect_tok(p_dd, TokType.Int, "expected upper bound integer in range")
                range_node = ast_new(AstType.BinaryExpr)
                range_node.op = 36
                range_node = ast_add_child(range_node, pat)
                hi_node = ast_new(AstType.LiteralInt)
                hi_node.int_val = hi_tok.int_val
                range_node = ast_add_child(range_node, hi_node)
                pat = range_node
                p2 = p_hi
            end
        eif check(p2, TokType.Str) do
            var (p3, st) = advance(p2)
            pat = ast_new(AstType.LiteralStr)
            pat.name = st.str_val
            p2 = p3
        eif check(p2, TokType.Ident) or check(p2, TokType.NoneLit) or check(p2, TokType.True) or check(p2, TokType.False) do
            var (p3, idt) = advance(p2)
            pat = ast_new(AstType.Identifier)
            if idt.tok_type == TokType.NoneLit do
                pat.name = fat_str_new("None")
            eif idt.tok_type == TokType.True do
                pat.name = fat_str_new("true")
            eif idt.tok_type == TokType.False do
                pat.name = fat_str_new("false")
            else
                pat.name = tok_lex(idt)
            end
            pat.int_val = 0 - 3
            p2 = p3
            # Tagged payload Some(v) / Ok(count): keep binder idents as children of `pat`.
            if check(p2, TokType.LParen) do
                var (p_lp, _) = advance(p2)
                depth = 1
                p2 = p_lp
                when depth > 0 and not check(p2, TokType.Eof) loop
                    if check(p2, TokType.LParen) do
                        depth = depth + 1
                        var (p_adv, _) = advance(p2)
                        p2 = p_adv
                    eif check(p2, TokType.RParen) do
                        depth = depth - 1
                        var (p_adv2, _) = advance(p2)
                        p2 = p_adv2
                    eif check(p2, TokType.Ident) or check(p2, TokType.NoneLit) or check(p2, TokType.True) or check(p2, TokType.False) do
                        var (p_id, id_tok) = advance(p2)
                        id_name = fat_str_new("_")
                        if id_tok.tok_type == TokType.NoneLit do
                            id_name = fat_str_new("None")
                        eif id_tok.tok_type == TokType.True do
                            id_name = fat_str_new("true")
                        eif id_tok.tok_type == TokType.False do
                            id_name = fat_str_new("false")
                        else
                            id_name = tok_lex(id_tok)
                        end
                        # Nested tag Some(Ok(x)): Ident followed by '(' — not a binder.
                        if check(p_id, TokType.LParen) do
                            p2 = p_id
                        else
                            if not fat_str_eq(id_name, fat_str_new("_")) and not fat_str_eq(id_name, fat_str_new("true")) and not fat_str_eq(id_name, fat_str_new("false")) and not fat_str_eq(id_name, fat_str_new("None")) do
                                binder = ast_new(AstType.Identifier)
                                binder.name = id_name
                                binder.line = id_tok.line
                                pat = ast_add_child(pat, binder)
                            end
                            p2 = p_id
                        end
                    else
                        var (p_adv3, _) = advance(p2)
                        p2 = p_adv3
                    end
                end
            end
        else
            # Force progress
            var (p3, _) = advance(p2)
            p2 = p3
        end
        var (p4, has_arm_colon) = match_tok(p2, TokType.Colon)
        p4 = skip_newlines(p4)
        body = ast_new(AstType.Block)
        p5 = p4
        if has_arm_colon do
            # A colon arm owns a statement block.  Stop at the next arm
            # (`pattern:` / `else`, optional `case`) or case terminator.
            arm_open = true
            when arm_open loop
                if check(p5, TokType.End) or check(p5, TokType.Eof) or case_arm_starts_here(p5) do
                    arm_open = false
                else
                    old_arm_pos = p5.pos
                    var (p_arm, arm_stmt) = parse_statement(p5)
                    if p_arm.pos == old_arm_pos do
                        var (p_force, _) = advance(p5)
                        p5 = p_force
                    else
                        p5 = p_arm
                        body = ast_add_child(body, arm_stmt)
                    end
                    when check(p5, TokType.Semicolon) loop
                        var (p_semi, _) = advance(p5)
                        p5 = p_semi
                    end
                    p5 = skip_newlines(p5)
                end
            end
        else
            var (p_one, one_stmt) = parse_statement(p4)
            p5 = p_one
            body = one_stmt
        end
        n = ast_add_child(n, pat)
        n = ast_add_child(n, body)
        p2 = p5
        var (p2s, _) = match_tok(p2, TokType.Semicolon)
        p2 = p2s
        p2 = skip_newlines(p2)
    end
    var (p3, has_else) = match_tok(p2, TokType.Else)
    if has_else do
        var (p3_col, _) = match_tok(p3, TokType.Colon)
        p3 = p3_col
        p3 = skip_newlines(p3)
        var (p4, else_body) = parse_block(p3)
        n = ast_add_child(n, else_body)
        n.int_val = 1
        p3 = p4
    end
    # §21: control block closes with `end` (not `end.`).
    var (p4, _, _) = expect_tok(p3, TokType.End, "expected 'end' after case")
    out (p4, n)
end.
func parse_loop_stmt(p: Parser):

    line = peek(p).line
    # Bare `loop` is an infinite loop. Represent it as `while true` so the
    # existing MIR/HIR lowering does not mistake the first body token for a
    # counted-loop expression.
    if check(p, TokType.Newline) or check(p, TokType.Semicolon) or check(p, TokType.Colon) do
        var (p_sep, _) = match_tok(p, TokType.Colon)
        var (p_sep2, _) = match_tok(p_sep, TokType.Semicolon)
        p_sep2 = skip_newlines(p_sep2)
        var (p_body, body) = parse_block(p_sep2)
        var (p_end, _, _) = expect_tok(p_body, TokType.End, "expected 'end' after loop block")
        cond = ast_new(AstType.LiteralInt)
        cond.int_val = 1
        cond.line = line
        n = ast_new(AstType.WhileStmt)
        n.line = line
        n = ast_add_child(n, cond)
        n = ast_add_child(n, body)
        out (p_end, n)
    end
    var (p2, count) = parse_expr(p)
    var (p2b, _) = match_tok(p2, TokType.Colon)
    p2 = p2b
    p2 = skip_newlines(p2)
    var (p3, body) = parse_block(p2)
    var (p4, _, _) = expect_tok(p3, TokType.End, "expected 'end' after loop block")
    n = ast_new(AstType.LoopStmt)
    n.line = line
    n = ast_add_child(n, count)
    n = ast_add_child(n, body)
    out (p4, n)
end.
func parse_when_loop_stmt(p: Parser, is_when_kw: int):

    line = peek(p).line
    var (p2, cond) = parse_expr(p)
    if not check(p2, TokType.Loop) do
        if is_when_kw == 1 do
            p2 = parse_error_at(p2, "expected `loop` after when condition", line)
        else
            p2 = parse_error_at(p2, "expected `loop` after while condition", line)
        end
        out (p2, ast_new(AstType.WhileStmt))
    end
    var (p3, _) = advance(p2)
    # Spec §9.2: `when cond loop` — body follows; `:` after loop is optional.
    var (p4, _) = match_tok(p3, TokType.Colon)
    p4 = skip_newlines(p4)
    var (p5, body) = parse_block(p4)
    if is_when_kw == 1 do
        p6 = expect_block_end(p5, "expected 'end' after when ... loop block")
    else
        p6 = expect_block_end(p5, "expected 'end' after while ... loop block")
    end
    var (p7, _) = match_tok(p6, TokType.Dot)
    n = ast_new(AstType.WhileStmt)
    n.line = line
    n = ast_add_child(n, cond)
    n = ast_add_child(n, body)
    out (p7, n)
end.
func parse_return_stmt(p: Parser):

    line = peek(p).line
    # C-parser parity: the stdlib idiom `out skip` / `out break` exits the
    # enclosing loop.  Treating `skip` as a return expression desynchronizes
    # parsing and would give the loop the wrong control-flow semantics.
    if check(p, TokType.Skip) or check(p, TokType.Break) do
        var (p2, _) = advance(p)
        n = ast_new(AstType.BreakStmt)
        n.line = line
        var (p3, _) = match_tok(p2, TokType.Semicolon)
        out (p3, n)
    end
    n = ast_new(AstType.ReturnStmt)
    n.line = line
    has_val = not check(p, TokType.Newline) and not check(p, TokType.End) and not check(p, TokType.Eof) and not check(p, TokType.Else) and not check(p, TokType.Semicolon)
    if has_val do
        var (p2, val) = parse_expr(p)
        n = ast_add_child(n, val)
        out (p2, n)
    end
    out (p, n)
end.
func parse_print_stmt(p: Parser):

    line = peek(p).line
    n = ast_new(AstType.PrintStmt)
    n.line = line
    var (p2, val) = parse_expr(p)
    n = ast_add_child(n, val)
    out (p2, n)
end.

# Consume a generic parameter/argument list beginning at '<'.  Declarations
# such as `entity Map<K, V>` and `func map_get<K, V>` do not need the generic
# names in the current soft AST, but the parser must consume them atomically.
func skip_generic_list(p: Parser):
    if not check(p, TokType.Lt) do
        out p
    end
    depth = 0
    when not check(p, TokType.Eof) loop
        if check(p, TokType.Lt) do
            depth = depth + 1
        eif check(p, TokType.Gt) do
            depth = depth - 1
        eif check(p, TokType.Cast) do
            depth = depth - 2
        end
        var (p2, _) = advance(p)
        p = p2
        if depth == 0 do
            break
        end
    end
    out p
end.

# Skip a complete type expression without consuming the surrounding list or
# declaration delimiter.  This covers references, arrays, nested generics and
# function types such as `&Map<K,V>` and `func(K, K) -> bool`.
func skip_type_expr(p: Parser):
    angle_depth = 0
    paren_depth = 0
    bracket_depth = 0
    keep_going = true
    when keep_going and not check(p, TokType.Eof) loop
        t = peek(p).tok_type
        at_top = angle_depth == 0 and paren_depth == 0 and bracket_depth == 0
        # Never swallow a block `end` while recovering a type expression.
        if t == TokType.End do
            keep_going = false
        eif at_top and (t == TokType.Comma or t == TokType.Semicolon or t == TokType.Newline or t == TokType.RParen or t == TokType.Colon or t == TokType.Assign) do
            keep_going = false
        else
            if t == TokType.Lt do
                angle_depth = angle_depth + 1
            eif t == TokType.Gt and angle_depth > 0 do
                angle_depth = angle_depth - 1
            eif t == TokType.Cast and angle_depth > 0 do
                # `>>` is cast token (two closing `>` in nested generics).
                angle_depth = angle_depth - 2
            eif t == TokType.LParen do
                paren_depth = paren_depth + 1
            eif t == TokType.RParen and paren_depth > 0 do
                paren_depth = paren_depth - 1
            eif t == TokType.LBracket do
                bracket_depth = bracket_depth + 1
            eif t == TokType.RBracket and bracket_depth > 0 do
                bracket_depth = bracket_depth - 1
            end
            var (p2, _) = advance(p)
            p = p2
        end
    end
    out p
end.

func parse_type_expr_string(p: Parser):
    angle_depth = 0
    paren_depth = 0
    bracket_depth = 0
    keep_going = true
    res = fat_str_new("")
    when keep_going and not check(p, TokType.Eof) loop
        t = peek(p).tok_type
        at_top = angle_depth == 0 and paren_depth == 0 and bracket_depth == 0
        # Never swallow a block `end` while recovering a type expression.
        if t == TokType.End do
            keep_going = false
        eif at_top and (t == TokType.Comma or t == TokType.Semicolon or t == TokType.Newline or t == TokType.RParen or t == TokType.Colon or t == TokType.Assign) do
            keep_going = false
        else
            if t == TokType.Lt do
                angle_depth = angle_depth + 1
            eif t == TokType.Gt and angle_depth > 0 do
                angle_depth = angle_depth - 1
            eif t == TokType.Cast and angle_depth > 0 do
                angle_depth = angle_depth - 2
            eif t == TokType.LParen do
                paren_depth = paren_depth + 1
            eif t == TokType.RParen and paren_depth > 0 do
                paren_depth = paren_depth - 1
            eif t == TokType.LBracket do
                bracket_depth = bracket_depth + 1
            eif t == TokType.RBracket and bracket_depth > 0 do
                bracket_depth = bracket_depth - 1
            end
            lex = tok_lex(peek(p))
            res = fat_str_concat(res, lex)
            var (p2, _) = advance(p)
            p = p2
        end
    end
    out (p, res)
end.

# Skip optional `out(TYPE)` / `out TYPE` return annotation (§6).
# Without this, `out(Vec):` is parsed as a body return statement.
func skip_out_return_type(p: Parser):
    if not check(p, TokType.Out) do
        out p
    end
    var (p2, _) = advance(p)
    if check(p2, TokType.LParen) do
        depth = 1
        var (p3, _) = advance(p2)
        p2 = p3
        when depth > 0 and not check(p2, TokType.Eof) loop
            if check(p2, TokType.LParen) do
                depth = depth + 1
            eif check(p2, TokType.RParen) do
                depth = depth - 1
            end
            var (p4, _) = advance(p2)
            p2 = p4
        end
        out p2
    end
    if is_name_token(peek(p2).tok_type) do
        var (p3, _) = advance(p2)
        p2 = p3
        if check(p2, TokType.Lt) do
            p2 = skip_generic_list(p2)
        end
    end
    out p2
end.

func parse_func_def_mode(p: Parser, signature_only: bool):

    var (p2, name_tok, ok) = expect_name_tok(p, "expected function name")
    if not ok do
        out (p2, ast_new(AstType.FuncDef))
    end

    fn_node = ast_new(AstType.FuncDef)
    fn_name = name_tok.str_val
    fn_node.name = fn_name
    fn_node.line = name_tok.line

    # Generic declaration: `func name<T, U>(...)`.
    p2 = skip_generic_list(p2)

    # Parse parameters (optional parens — `func name` and `func name(...)` both valid)
    if check(p2, TokType.LParen) do
        var (p3, _) = advance(p2)
        p3 = skip_newlines(p3)

        # Parse parameters
        if not check(p3, TokType.RParen) do
            # Check for 'this' as first parameter (method syntax)
            if check(p3, TokType.ThisKw) do
                var (p_this, this_ptok) = advance(p3)
                p3 = p_this
                param = ast_new(AstType.Identifier)
                param.name = fat_str_new("this")
                fn_node = ast_add_child(fn_node, param)
                fn_node.int_val = 1
                # Preserve the receiver annotation for strict UFCS type checks.
                if check(p3, TokType.Colon) do
                    var (p_type_start, _) = advance(p3)
                    var (p_type_end, this_type) = parse_type_expr_string(p_type_start)
                    param.name2 = this_type
                    p3 = p_type_end
                end
            else
                # Check for 'ref' modifier
                is_ref = false
                if check(p3, TokType.RefKw) do
                    var (p_ref, _) = advance(p3)
                    p3 = p_ref
                    is_ref = true
                end
                param_name = fat_str_new("")
                ok2 = false
                if check(p3, TokType.Ident) do
                    var (p4, pt) = advance(p3)
                    p3 = p4
                    param_name = pt.str_val
                    ok2 = true
                eif check(p3, TokType.PtrKw) do
                    var (p4, _) = advance(p3)
                    p3 = p4
                    param_name = fat_str_new("ptr")
                    ok2 = true
                else
                    var (p4, param_tok, ok_e) = expect_name_tok(p3, "expected parameter name")
                    p3 = p4
                    param_name = param_tok.str_val
                    ok2 = ok_e
                end
                    if ok2 do
                    if is_ref do
                        param = ast_new(AstType.RefParam)
                    else
                        param = ast_new(AstType.Identifier)
                    end
                    param.name = param_name
                    # Keep annotation parsing in the same lexical scope as the
                    # parameter handle.  Using `param` after this block yielded
                    # an empty handle in the native self-hosted compiler.
                    if check(p3, TokType.Colon) do
                        var (p_skip, _) = advance(p3)
                        var (p_type_end, type_str) = parse_type_expr_string(p_skip)
                        param.name2 = type_str
                        p3 = p_type_end
                    end
                    fn_node = ast_add_child(fn_node, param)
                else
                    if check(p3, TokType.Colon) do
                        var (p_skip_bad, _) = advance(p3)
                        p3 = skip_type_expr(p_skip_bad)
                    end
                end
            end
            # §1.0: param separator is "," | ";" | NEWLINE
            should_loop = true
            when should_loop loop
                var (p5, has_sep) = match_list_sep(p3, true)
                p3 = p5
                if not has_sep or check(p3, TokType.RParen) do
                    should_loop = false
                else
                    # Check for 'ref' modifier on subsequent params
                    is_ref2 = false
                    if check(p3, TokType.RefKw) do
                        var (p_ref2, _) = advance(p3)
                        p3 = p_ref2
                        is_ref2 = true
                    end
                    param2_name = fat_str_new("")
                    ok3 = false
                    if check(p3, TokType.Ident) do
                        var (p6, pt2) = advance(p3)
                        p3 = p6
                        param2_name = pt2.str_val
                        ok3 = true
                    eif check(p3, TokType.PtrKw) do
                        var (p6, _) = advance(p3)
                        p3 = p6
                        param2_name = fat_str_new("ptr")
                        ok3 = true
                    else
                        var (p6, pt, ok_e3) = expect_name_tok(p3, "expected parameter name")
                        p3 = p6
                        param2_name = pt.str_val
                        ok3 = ok_e3
                    end
                    if ok3 do
                        if is_ref2 do
                            param2 = ast_new(AstType.RefParam)
                        else
                            param2 = ast_new(AstType.Identifier)
                        end
                        param2.name = param2_name
                        if check(p3, TokType.Colon) do
                            var (p_skip3, _) = advance(p3)
                            var (p_type_end3, type_str3) = parse_type_expr_string(p_skip3)
                            param2.name2 = type_str3
                            p3 = p_type_end3
                        end
                        fn_node = ast_add_child(fn_node, param2)
                    else
                        if check(p3, TokType.Colon) do
                            var (p_skip_bad3, _) = advance(p3)
                            p3 = skip_type_expr(p_skip_bad3)
                        end
                    end
                end
            end
        end

        var (p4, _, _) = expect_tok(p3, TokType.RParen, "expected ')' after parameters")
        p2 = p4
    end

    # Skip optional return type `-> type` or `out(TYPE)` / `out TYPE`
    if check(p2, TokType.Arrow) do
        var (p_arr, _) = advance(p2)
        var (p_ret_end, ret_str) = parse_type_expr_string(p_arr)
        fn_node.name2 = ret_str
        p2 = p_ret_end
    end
    p2 = skip_out_return_type(p2)

    # Skip optional trailing colon `:`
    var (p_colon, _) = match_tok(p2, TokType.Colon)
    p2 = p_colon

    p2 = skip_newlines(p2)

    # Interface members are declarations, not nested function blocks. Their
    # trailing `:` and newline finish the signature; the interface owns the
    # only `end` token.
    if signature_only do
        empty_body = ast_new(AstType.Block)
        fn_node = ast_add_child(fn_node, empty_body)
        fn_node.name = fn_name
        out (p2, fn_node)
    end

    # v1.2 / Vir body params: `in(a:int; b:int)` or `in a:int; b:int`
    # Also accept repeated lines: `in a: int` / `in b: int`
    when check(p2, TokType.In) loop
        var (p_in, _) = advance(p2)
        p2 = p_in
        has_paren = false
        if check(p2, TokType.LParen) do
            var (p_lp, _) = advance(p2)
            p2 = p_lp
            has_paren = true
        end
        p2 = skip_newlines(p2)
        # Leading orphan separators
        when check(p2, TokType.Semicolon) or check(p2, TokType.Comma) loop
            var (p_sep, _) = advance(p2)
            p2 = p_sep
        end
        p2 = skip_newlines(p2)
        if not check(p2, TokType.RParen) do
            # At least one param, then more after ;/,
            more_params = true
            when more_params loop
                p2 = skip_newlines(p2)
                if not is_name_token(peek(p2).tok_type) and not check(p2, TokType.RefKw) do
                    more_params = false
                else
                    is_ref = false
                    if check(p2, TokType.RefKw) do
                        var (p_ref, _) = advance(p2)
                        p2 = p_ref
                        is_ref = true
                    end
                    var (p_pn, param_tok, ok_p) = expect_name_tok(p2, "expected parameter name after 'in'")
                    p2 = p_pn
                    if not ok_p do
                        more_params = false
                    else
                        if is_ref do
                            param = ast_new(AstType.RefParam)
                        else
                            param = ast_new(AstType.Identifier)
                        end
                        param.name = param_tok.str_val
                        param.line = param_tok.line
                        # Optional `: type` (skip type tokens until separator)
                        if check(p2, TokType.Colon) do
                            var (p_ct, _) = advance(p2)
                            p2 = skip_type_expr(p_ct)
                        end
                        fn_node = ast_add_child(fn_node, param)
                        # §1.0: in-param separator — trailing NEWLINE before ')' is whitespace
                        before_sep = native_read_i64(p2 as i64, 8)
                        p2 = skip_newlines(p2)
                        got_nl = native_read_i64(p2 as i64, 8) != before_sep
                        if check(p2, TokType.RParen) do
                            more_params = false
                        else
                            has_sep = false
                            var (p_cm, m_cm) = match_tok(p2, TokType.Comma)
                            p2 = p_cm
                            if m_cm do
                                has_sep = true
                            end
                            if not has_sep do
                                var (p_sc, m_sc) = match_tok(p2, TokType.Semicolon)
                                p2 = p_sc
                                if m_sc do
                                    has_sep = true
                                end
                            end
                            if has_sep do
                                p2 = skip_newlines(p2)
                                if check(p2, TokType.RParen) do
                                    more_params = false
                                end
                            eif not got_nl do
                                more_params = false
                            else
                                # A bare newline ends an unparenthesized `in`
                                # list unless the next line still has the
                                # unmistakable `name: type` parameter shape.
                                # Otherwise a body assignment such as
                                # `table = ...` is accidentally eaten as a
                                # second parameter and parsing resumes on '='.
                                nt = peek(p2).tok_type
                                if is_name_token(nt) do
                                    nt2 = peek_n(p2, 1).tok_type
                                    if nt2 != TokType.Colon and nt2 != TokType.Newline and nt2 != TokType.Semicolon and nt2 != TokType.Comma do
                                        more_params = false
                                    end
                                eif nt != TokType.RefKw do
                                    more_params = false
                                end
                            end
                            # got_nl without ;/, → continue with next param on following line
                        end
                    end
                end
            end
        end
        if has_paren do
            var (p_rp, _, _) = expect_tok(p2, TokType.RParen, "expected ')' after in-params")
            p2 = p_rp
        end
        # Optional `-> type` / `out type` after in-block (C-core parity) — skip lightly
        if check(p2, TokType.Arrow) do
            var (p_ar, _) = advance(p2)
            p2 = p_ar
            if check(p2, TokType.Ident) do
                var (p_rt, _) = advance(p2)
                p2 = p_rt
            end
        end
        p2 = skip_newlines(p2)
    end

    var (p5, body) = parse_block(p2)
    fn_node = ast_add_child(fn_node, body)

    # Parse optional ensure / revert blocks in any order (Saga pattern)
    has_cleanup = true
    when has_cleanup loop
        if check(p5, TokType.EnsureKw) do
            var (p_ens, _) = advance(p5)
            var (p_ens2, _) = match_tok(p_ens, TokType.Colon)
            p_ens2 = skip_newlines(p_ens2)
            var (p_ens3, ensure_body) = parse_block(p_ens2)
            ensure_node = ast_new(AstType.EnsureBlock)
            ensure_node = ast_add_child(ensure_node, ensure_body)
            fn_node = ast_add_child(fn_node, ensure_node)
            p5 = p_ens3
        eif check(p5, TokType.RevertKw) do
            var (p_rev, _) = advance(p5)
            var (p_rev2, _) = match_tok(p_rev, TokType.Colon)
            p_rev2 = skip_newlines(p_rev2)
            var (p_rev3, revert_body) = parse_block(p_rev2)
            revert_node = ast_new(AstType.RevertBlock)
            revert_node = ast_add_child(revert_node, revert_body)
            fn_node = ast_add_child(fn_node, revert_node)
            p5 = p_rev3
        else
            has_cleanup = false
        end
    end

    if not check(p5, TokType.End) do
        p5 = parse_error_at(p5, "expected 'end' to close function", fn_node.line)
    end
    var (p6, _, _) = expect_tok(p5, TokType.End, "expected 'end' to close function")
    # `end` and `end.` are both accepted by the C parser/spec-compatible
    # frontend.  Keep the dot optional on the soft self-host path as well.
    var (p6b, _) = match_tok(p6, TokType.Dot)
    # ast_add_child corrupts soft .name — restore for lowering / Call lookup.
    fn_node.name = fn_name
    out (p6b, fn_node)
end.

func parse_func_def(p: Parser):
    out parse_func_def_mode(p, false)
end.
func parse_for_range_stmt(p: Parser):

    line = peek(p).line
    var (p2, var_tok, ok) = expect_name_tok(p, "expected loop variable")
    if not ok do
        out (p2, ast_new(AstType.ForRange))
    end
    loop_name = tok_lex(var_tok)

    var (p3, _, ok2) = expect_tok(p2, TokType.In, "expected 'in' after for variable")
    if not ok2 do
        out (p3, ast_new(AstType.ForRange))
    end

    var (p4, start_expr) = parse_expr(p3)
    if check(p4, TokType.DotDot) do
        var (p5, _) = advance(p4)
        var (p6, end_expr) = parse_expr(p5)
        # Body opener: ':' or 'do' (stdlib uses both).
        var (p6b, _) = match_tok(p6, TokType.Colon)
        p6 = p6b
        var (p6c, _) = match_tok(p6, TokType.Do)
        p6 = p6c
        p6 = skip_newlines(p6)

        var (p7, body) = parse_block(p6)
        var (p8, _, _) = expect_tok(p7, TokType.End, "expected 'end' after for block")

        n = ast_new(AstType.ForRange)
        n.name = loop_name
        n.line = line
        n = ast_add_child(n, start_expr)
        n = ast_add_child(n, end_expr)
        n = ast_add_child(n, body)
        out (p8, n)
    end

    # Array loop: for x in arr do ... end
    var (p4b, _) = match_tok(p4, TokType.Colon)
    p4 = p4b
    var (p4c, _) = match_tok(p4, TokType.Do)
    p4 = p4c
    p4 = skip_newlines(p4)

    var (p7a, body_arr) = parse_block(p4)
    var (p8a, _, _) = expect_tok(p7a, TokType.End, "expected 'end' after for block")

    n = ast_new(AstType.ForRange)
    n.name = loop_name
    n.line = line
    n = ast_add_child(n, start_expr)
    n = ast_add_child(n, body_arr)
    out (p8a, n)
end.
func parse_enum_def(p: Parser):

    line = peek(p).line
    var (p2, name_tok, ok) = expect_name_tok(p, "expected enum name")
    if not ok do
        out (p2, ast_new(AstType.EnumDef))
    end

    p2 = skip_newlines(p2)

    en = ast_new(AstType.EnumDef)
    en.name = name_tok.str_val
    en.line = line

    # Consume optional ':' after enum name
    var (p2b, _) = match_tok(p2, TokType.Colon)
    p2 = p2b
    p2 = skip_newlines(p2)

    next_val = 0
    when not check(p2, TokType.End) and not check(p2, TokType.Eof) loop
        var (p3, vname, ok2) = expect_name_tok(p2, "expected enum variant")
        p2 = p3
        if not ok2 do
            out (p2, en)
        end

        val = next_val
        var (p4, has_val) = match_tok(p2, TokType.Assign)
        if has_val do
            var (p5, int_tok, _) = expect_tok(p4, TokType.Int, "expected integer value")
            p2 = p5
            val = int_tok.int_val
        else
            p2 = p4
        end
        # Optional payload: Some(v) / Ok(value) — skip parenthesized binder list.
        if check(p2, TokType.LParen) do
            var (p_lp, _) = advance(p2)
            depth = 1
            p2 = p_lp
            when depth > 0 and not check(p2, TokType.Eof) loop
                if check(p2, TokType.LParen) do
                    depth = depth + 1
                end
                if check(p2, TokType.RParen) do
                    depth = depth - 1
                end
                var (p_adv, _) = advance(p2)
                p2 = p_adv
            end
        end
        next_val = val + 1

        variant = ast_new(AstType.LiteralInt)
        variant.name = vname.str_val
        variant.int_val = val
        variant.line = vname.line
        en = ast_add_child(en, variant)
        var (p6c, _) = match_tok(p2, TokType.Comma)
        var (p6, _) = match_tok(p6c, TokType.Semicolon)
        p2 = p6
        p2 = skip_newlines(p2)
    end

    var (p3, _, _) = expect_tok(p2, TokType.End, "expected 'end' after enum")
    # v1.2: definition blocks close with 'end' — consume optional dot
    var (p3b, _) = match_tok(p3, TokType.Dot)
    out (p3b, en)
end.
func parse_entity_def(p: Parser):

    line = peek(p).line
    var (p2, name_tok, ok) = expect_name_tok(p, "expected entity name")
    if not ok do
        out (p2, ast_new(AstType.EntityDef))
    end

    # Generic declaration: `entity Name<T, U>`.
    p2 = skip_generic_list(p2)
    p2 = skip_newlines(p2)

    # Optional base type for register / mold: `register UART_SR: u32`
    var base_type_name = fat_str_new("")
    var (p2b, has_colon) = match_tok(p2, TokType.Colon)
    if has_colon do
        if check(p2b, TokType.Ident) do
            var (p2c, type_tok) = advance(p2b)
            base_type_name = type_tok.str_val
            p2 = p2c
        else
            p2 = p2b
        end
    end
    p2 = skip_newlines(p2)

    ed = ast_new(AstType.EntityDef)
    ed.name = name_tok.str_val
    ed.name2 = base_type_name
    ed.line = line

    when not check(p2, TokType.End) and not check(p2, TokType.Eof) loop
        if check(p2, TokType.Method) or check(p2, TokType.Func) do
            var (p_m, _) = advance(p2)
            var (p_mdef, mnode) = parse_func_def(p_m)
            p2 = p_mdef
            ed = ast_add_child(ed, mnode)
            p2 = skip_newlines(p2)
            skip
        end
        var (p3, fname, ok2) = expect_name_tok(p2, "expected field name")
        p2 = p3
        if not ok2 do
            p2 = parse_error(p2, "expected field name in entity body")
            p2 = sync_past_block_end(p2)
            ed.name = name_tok.str_val
            out (p2, ed)
        end

        field = ast_new(AstType.Identifier)
        field.name = fname.str_val
        field.line = fname.line

        # Optional type or bitfield hint
        var (p4, has_fcolon) = match_tok(p2, TokType.Colon)
        if has_fcolon do
            if check(p4, TokType.Int) do
                var (p5, int_tok) = advance(p4)
                start_bit = int_tok.int_val
                width = 1
                if check(p5, TokType.DotDot) do
                    var (p6, _) = advance(p5)
                    var (p7, hi_tok) = advance(p6)
                    end_bit = hi_tok.int_val
                    width = end_bit - start_bit + 1
                    p2 = p7
                else
                    p2 = p5
                end
                field.int_val = start_bit
                field.builtin_id = width
            else
                if not check(p4, TokType.Comma) and not check(p4, TokType.Semicolon) and not check(p4, TokType.Newline) and not check(p4, TokType.End) and not check(p4, TokType.Eof) do
                    if check(p4, TokType.Func) do
                        # Callable-field UFCS needs the full signature for
                        # arity/type validation, not only the leading `func`.
                        var (p_type_end, callable_type) = parse_type_expr_string(p4)
                        field.name2 = callable_type
                        p2 = p_type_end
                    else
                        # Preserve the leading type spelling for existing lowering,
                        # then consume the entire type expression.
                        type_name_pos = p4
                        if check(type_name_pos, TokType.BitAnd) or check(type_name_pos, TokType.LBracket) do
                            var (p_name, _) = advance(type_name_pos)
                            type_name_pos = p_name
                        end
                        field.name2 = tok_lex(peek(type_name_pos))
                        p2 = skip_type_expr(p4)
                    end
                else
                    p2 = p4
                end
            end
        else
            p2 = p4
        end

        ed = ast_add_child(ed, field)
        # Hard parser accepts ',' or ';' between entity fields (lexer.vri uses commas).
        var (p6, had_semi) = match_tok(p2, TokType.Semicolon)
        if had_semi do
            p2 = p6
        else
            var (p7, _) = match_tok(p6, TokType.Comma)
            p2 = p7
        end
        p2 = skip_newlines(p2)
    end

    p2 = expect_block_end(p2, "expected 'end' after entity")
    # ast_add_child corrupts soft .name — restore for entity ctor lookup.
    ed.name = name_tok.str_val
    out (p2, ed)
end.

func parse_interface_def(p: Parser):
    line = peek(p).line
    var (p2, name_tok, ok) = expect_name_tok(p, "expected interface name")
    if not ok do
        out (p2, ast_new(AstType.EntityDef))
    end

    p2 = skip_generic_list(p2)
    var (p_colon, _) = match_tok(p2, TokType.Colon)
    p2 = skip_newlines(p_colon)

    iface = ast_new(AstType.EntityDef)
    iface.name = name_tok.str_val
    iface.name2 = fat_str_new("interface")
    iface.line = line

    when not check(p2, TokType.End) and not check(p2, TokType.Eof) loop
        if check(p2, TokType.Func) or check(p2, TokType.Method) do
            var (p_func, _) = advance(p2)
            var (p_after, method_node) = parse_func_def_mode(p_func, true)
            iface = ast_add_child(iface, method_node)
            p2 = skip_newlines(p_after)
        else
            # `implement Base` and future interface metadata are line-scoped.
            # Preserve parser progress without treating them as method bodies.
            when not check(p2, TokType.Newline) and not check(p2, TokType.End) and not check(p2, TokType.Eof) loop
                var (p_next, _) = advance(p2)
                p2 = p_next
            end
            p2 = skip_newlines(p2)
        end
    end

    p2 = expect_block_end(p2, "expected 'end' after interface")
    iface.name = name_tok.str_val
    out (p2, iface)
end.

func parse_mold_def(p: Parser):
    line = peek(p).line
    var (p2, name_tok, ok) = expect_name_tok(p, "expected mold name")
    if not ok do
        out (p2, ast_new(AstType.RegisterDef))
    end
    p2 = skip_newlines(p2)
    var base_type_name = fat_str_new("")
    var (p2b, has_colon) = match_tok(p2, TokType.Colon)
    if has_colon do
        if check(p2b, TokType.Ident) do
            var (p2c, type_tok) = advance(p2b)
            base_type_name = type_tok.str_val
            p2 = p2c
        else
            p2 = p2b
        end
    end
    p2 = skip_newlines(p2)

    ed = ast_new(AstType.RegisterDef)
    ed.name = name_tok.str_val
    ed.name2 = base_type_name
    ed.line = line

    var cur_bit = 0
    when not check(p2, TokType.End) and not check(p2, TokType.Eof) loop
        var (p3, fname, ok2) = expect_name_tok(p2, "expected field name")
        p2 = p3
        if not ok2 do
            out (p2, ed)
        end

        field = ast_new(AstType.Identifier)
        field.name = fname.str_val
        field.line = fname.line

        var (p4, has_fcolon) = match_tok(p2, TokType.Colon)
        if has_fcolon do
            if check(p4, TokType.Int) do
                var (p5, int_tok) = advance(p4)
                w = int_tok.int_val
                if w <= 0 do w = 1 end
                field.int_val = cur_bit
                field.builtin_id = w
                cur_bit = cur_bit + w
                p2 = p5
            else
                p2 = p4
            end
        else
            p2 = p4
        end

        ed = ast_add_child(ed, field)
        var (p6, had_semi) = match_tok(p2, TokType.Semicolon)
        if had_semi do
            p2 = p6
        else
            var (p7, _) = match_tok(p6, TokType.Comma)
            p2 = p7
        end
        p2 = skip_newlines(p2)
    end

    var (p3, _) = expect_block_end(p2, "expected 'end' after mold")
    out (p3, ed)
end.

func is_compound_assign(tok: Token):
    t = tok.tok_type
    if t == TokType.PlusAssign or t == TokType.MinusAssign or t == TokType.StarAssign or t == TokType.SlashAssign or t == TokType.ModAssign or t == TokType.BitAndAssign or t == TokType.BitOrAssign or t == TokType.BitXorAssign or t == TokType.BitShlAssign or t == TokType.BitShrAssign do
        out true
    end
    out false
end.

func is_compound_assign_type(t: TokType):
    if t == TokType.PlusAssign or t == TokType.MinusAssign or t == TokType.StarAssign or t == TokType.SlashAssign or t == TokType.ModAssign or t == TokType.BitAndAssign or t == TokType.BitOrAssign or t == TokType.BitXorAssign or t == TokType.BitShlAssign or t == TokType.BitShrAssign do
        out true
    end
    out false
end.

func stmt_is_field_assign(p: Parser):
    var k = 1
    when peek_n(p, k).tok_type == TokType.Dot and is_name_token(peek_n(p, k + 1).tok_type) loop
        k = k + 2
    end
    if k == 1 do out false end
    nxt = peek_n(p, k).tok_type
    if nxt == TokType.Assign do out true end
    out is_compound_assign_type(nxt)
end.

func compound_assign_op(t: TokType):
    if t == TokType.PlusAssign do out OpType.Add end
    if t == TokType.MinusAssign do out OpType.Sub end
    if t == TokType.StarAssign do out OpType.Mul end
    if t == TokType.SlashAssign do out OpType.Div end
    if t == TokType.ModAssign do out OpType.ModOp end
    if t == TokType.BitAndAssign do out OpType.AndOp end
    if t == TokType.BitOrAssign do out OpType.OrOp end
    if t == TokType.BitXorAssign do out OpType.XorOp end
    if t == TokType.BitShlAssign do out OpType.ShlOp end
    if t == TokType.BitShrAssign do out OpType.ShrOp end
    out OpType.Add
end.

func parse_statement(p: Parser):

    p = skip_newlines(p)
    t = peek(p)

    if t.tok_type == TokType.Extern do
        var (p2, _) = advance(p)
        # FFI declarations keep a real signature instead of being discarded:
        #   extern func puts(s: ptr) -> int
        #   extern from os func puts(s: ptr) -> int
        #   extern from "/usr/local/lib/libfoo.dylib" func foo(x: int) -> int
        # `extern func` remains shorthand for the target OS provider.
        extern_source = fat_str_new("os")
        if check(p2, TokType.From) do
            var (p_from, _) = advance(p2)
            p2 = p_from
            src_tok = peek(p2)
            if is_name_token(src_tok.tok_type) or src_tok.tok_type == TokType.Str do
                var (p_src, taken_src) = advance(p2)
                p2 = p_src
                extern_source = taken_src.str_val
            else
                p2 = parse_error_at(p2, "expected OS alias or dylib path after extern from", t.line)
            end
        end
        if check(p2, TokType.Func) do
            var (p3, _) = advance(p2)
            var (p4, n) = parse_func_def_mode(p3, true)
            n.node_type = AstType.ExternFunc
            # Keep the parsed return type in name2.  Extern provider metadata is
            # orthogonal to the function signature and is carried in int_val.
            # Overwriting name2 here used to erase the return type before the
            # semantic and target ABI passes could inspect it.
            n.int_val = extern_source as int
            var (p5, _) = match_tok(p4, TokType.Semicolon)
            out (p5, n)
        end
        # Unknown extern declaration — skip the line
        when not check(p2, TokType.Newline) and not check(p2, TokType.Eof) loop
            var (p3, _) = advance(p2)
            p2 = p3
        end
        out (p2, ast_new(AstType.ExternFunc))
    end

    # `type Name = ...;` / `type Name;`
    if t.tok_type == TokType.TypeKw do
        var (p2, _) = advance(p)
        n = ast_new(AstType.TypeAlias)
        n.line = t.line
        if is_name_token(peek(p2).tok_type) do
            var (p3, nt) = advance(p2)
            n.name = nt.str_val
            p2 = p3
        end
        if check(p2, TokType.Assign) do
            var (p3, _) = advance(p2)
            var (p4, rhs) = parse_expr(p3)
            n = ast_add_child(n, rhs)
            p2 = p4
        end
        var (p5, _) = match_tok(p2, TokType.Semicolon)
        out (p5, n)
    end

    # `async func ...`
    if t.tok_type == TokType.Async do
        var (p2, _) = advance(p)
        if check(p2, TokType.Func) do
            var (p3, _) = advance(p2)
            var (p4, fn) = parse_func_def(p3)
            fn.name2 = fat_str_new("async")
            out (p4, fn)
        end
        p2 = parse_error(p2, "expected 'func' after 'async'")
        out (p2, ast_new(AstType.FuncDef))
    end

    # `atomic var ...` / `atomic let ...`
    if t.tok_type == TokType.AtomicKw do
        var (p2, _) = advance(p)
        if check(p2, TokType.Var) or check(p2, TokType.Let) or check(p2, TokType.Const) do
            is_const = check(p2, TokType.Const) or check(p2, TokType.Let)
            var (p3, _) = advance(p2)
            var (p4, vd) = parse_var_decl(p3, is_const)
            n = ast_new(AstType.AtomicVarDecl)
            n.line = t.line
            n = ast_add_child(n, vd)
            out (p4, n)
        end
        p2 = parse_error(p2, "expected var/let/const after 'atomic'")
        out (p2, ast_new(AstType.AtomicVarDecl))
    end

    # `mut var ...` binder
    if t.tok_type == TokType.MutKw do
        var (p2, _) = advance(p)
        if check(p2, TokType.Var) do
            var (p3, _) = advance(p2)
            out parse_var_decl(p3, false)
        end
        out parse_var_decl(p2, false)
    end

    # `precomp:` / `precomp func`
    if t.tok_type == TokType.PrecompKw do
        var (p2, _) = advance(p)
        if check(p2, TokType.Func) do
            var (p3, _) = advance(p2)
            var (p4, fn) = parse_func_def(p3)
            fn.name2 = fat_str_new("precomp")
            out (p4, fn)
        end
        var (p3, _) = match_tok(p2, TokType.Colon)
        p3 = skip_newlines(p3)
        var (p4, body) = parse_block(p3)
        var (p5, _, _) = expect_tok(p4, TokType.End, "expected 'end' after precomp")
        var (p6, _) = match_tok(p5, TokType.Dot)
        n = ast_new(AstType.PrecompBlock)
        n.line = t.line
        n = ast_add_child(n, body)
        out (p6, n)
    end

    # `port name: Type` / `port(cap: N) name: Type` (§23)
    if t.tok_type == TokType.PortKw do
        var (p2, _) = advance(p)
        var cap_val = 0
        if check(p2, TokType.LParen) do
            var (p_lp, _) = advance(p2)
            if check(p_lp, TokType.Ident) do
                var (p_cap_id, cap_tok) = advance(p_lp)
                if check(p_cap_id, TokType.Colon) do
                    var (p_col, _) = advance(p_cap_id)
                    if check(p_col, TokType.Int) do
                        var (p_int, int_tok) = advance(p_col)
                        cap_val = int_tok.int_val
                        p_lp = p_int
                    end
                end
            end
            var (p_rp, _, _) = expect_tok(p_lp, TokType.RParen, "expected ')' after port capacity")
            p2 = p_rp
        end
        var (p3, name_tok, ok) = expect_name_tok(p2, "expected port name")
        n = ast_new(AstType.PortDecl)
        n.name = name_tok.str_val
        n.int_val = cap_val
        n.line = t.line
        p3 = skip_newlines(p3)
        if check(p3, TokType.Colon) do
            var (p4, _) = advance(p3)
            if check(p4, TokType.Ident) do
                var (p5, ty_tok) = advance(p4)
                n.name2 = ty_tok.str_val
                p3 = p5
            end
        end
        var (p6, _) = match_tok(p3, TokType.Semicolon)
        out (p6, n)
    end

    # `send port <- message` (§23)
    if t.tok_type == TokType.SendKw do
        var (p2, _) = advance(p)
        var (p3, port_expr) = parse_expr(p2)
        var (p4, _) = match_tok(p3, TokType.SendArrow)
        var (p5, msg_expr) = parse_expr(p4)
        n = ast_new(AstType.SendStmt)
        n.line = t.line
        n = ast_add_child(n, port_expr)
        n = ast_add_child(n, msg_expr)
        var (p6, _) = match_tok(p5, TokType.Semicolon)
        out (p6, n)
    end

    # `cancel task_handle` (§22.7)
    if t.tok_type == TokType.CancelKw do
        var (p2, _) = advance(p)
        var (p3, task_expr) = parse_expr(p2)
        n = ast_new(AstType.CancelStmt)
        n.line = t.line
        n = ast_add_child(n, task_expr)
        var (p4, _) = match_tok(p3, TokType.Semicolon)
        out (p4, n)
    end

    # `quiet fn_call(...)` (§22.9)
    if t.tok_type == TokType.QuietKw do
        var (p2, _) = advance(p)
        var (p3, call_expr) = parse_expr(p2)
        n = ast_new(AstType.QuietStmt)
        n.line = t.line
        n = ast_add_child(n, call_expr)
        var (p4, _) = match_tok(p3, TokType.Semicolon)
        out (p4, n)
    end

    # `lazy include ...`
    if t.tok_type == TokType.LazyKw do
        var (p2, _) = advance(p)
        if check(p2, TokType.Include) do
            var (p3, _) = advance(p2)
            # Reuse include parsing via fake peek — call include path by building stmt
            n = ast_new(AstType.LazyIncludeStmt)
            n.line = t.line
            if check(p3, TokType.Str) do
                var (p4, ft) = advance(p3)
                n.name = ft.str_val
                p3 = p4
            eif check(p3, TokType.Ident) do
                var (p4, idt) = advance(p3)
                path = idt.str_val
                p3 = p4
                when check(p3, TokType.Dot) or check(p3, TokType.DoubleColon) loop
                    var (p5, _) = advance(p3)
                    var (p6, seg, _) = expect_name_tok(p5, "expected name after path sep")
                    path = fat_str_concat(fat_str_concat(path, fat_str_new(".")), seg.str_val)
                    p3 = p6
                end
                n.name = path
            end
            if check(p3, TokType.As) do
                var (p_as, _) = advance(p3)
                var (p_al, at, _) = expect_name_tok(p_as, "expected alias after as")
                n.name2 = at.str_val
                p3 = p_al
            end
            var (p7, _) = match_tok(p3, TokType.Semicolon)
            out (p7, n)
        end
        p2 = parse_error(p2, "expected 'include' after 'lazy'")
        out (p2, ast_new(AstType.LazyIncludeStmt))
    end

    if t.tok_type == TokType.Func do
        var (p2, _) = advance(p)
        out parse_func_def(p2)
    end

    if t.tok_type == TokType.Method do
        var (p2, _) = advance(p)
        var (p3, fn) = parse_func_def(p2)
        fn.name2 = fat_str_new("method")
        out (p3, fn)
    end

    if t.tok_type == TokType.Class do
        var (p2, _) = advance(p)
        var (p3, ed) = parse_entity_def(p2)
        ed.node_type = AstType.ClassDef
        out (p3, ed)
    end

    if t.tok_type == TokType.Share do
        var (p2, _) = advance(p)
        n = ast_new(AstType.ShareDecl)
        n.line = t.line
        if check(p2, TokType.Ident) do
            var (p3, idt) = advance(p2)
            n.name = idt.str_val
            p2 = p3
        end
        var (p4, _) = match_tok(p2, TokType.Semicolon)
        out (p4, n)
    end

    if t.tok_type == TokType.Has do
        var (p2, _) = advance(p)
        n = ast_new(AstType.HasDecl)
        n.line = t.line
        if check(p2, TokType.Ident) do
            var (p3, idt) = advance(p2)
            n.name = idt.str_val
            p2 = p3
        end
        var (p4, _) = match_tok(p2, TokType.Semicolon)
        out (p4, n)
    end

    # Type-form decls: dict / tensor / flux Name ...
    if t.tok_type == TokType.DictKw or t.tok_type == TokType.TensorKw or t.tok_type == TokType.FluxKw do
        var (p2, kt) = advance(p)
        nt = AstType.DictDecl
        if kt.tok_type == TokType.TensorKw do
            nt = AstType.TensorDecl
        end
        if kt.tok_type == TokType.FluxKw do
            nt = AstType.FluxDecl
        end
        n = ast_new(nt)
        n.line = t.line
        if check(p2, TokType.Ident) do
            var (p3, idt) = advance(p2)
            n.name = idt.str_val
            p2 = p3
        end
        # Skip rest of line / until end or semicolon (type params later)
        when not check(p2, TokType.Semicolon) and not check(p2, TokType.Newline) and not check(p2, TokType.Eof) and not check(p2, TokType.End) loop
            var (p3, _) = advance(p2)
            p2 = p3
        end
        var (p4, _) = match_tok(p2, TokType.Semicolon)
        out (p4, n)
    end

    # UI / expose / morph / reactive / bundle
    if t.tok_type == TokType.ReactiveKw or t.tok_type == TokType.MorphKw do
        var (p2, kt) = advance(p)
        nt = AstType.ReactiveDecl
        if kt.tok_type == TokType.MorphKw do
            nt = AstType.MorphDecl
        end
        n = ast_new(nt)
        n.line = t.line
        if check(p2, TokType.Ident) do
            var (p3, idt) = advance(p2)
            n.name = idt.str_val
            p2 = p3
        end
        if check(p2, TokType.Assign) do
            var (p3, _) = advance(p2)
            var (p4, rhs) = parse_expr(p3)
            n = ast_add_child(n, rhs)
            p2 = p4
        end
        var (p5, _) = match_tok(p2, TokType.Semicolon)
        out (p5, n)
    end

    if t.tok_type == TokType.BundleKw do
        var (p2, _) = advance(p)
        n = ast_new(AstType.BundleExpr)
        n.line = t.line
        if check(p2, TokType.Ident) do
            var (p3, id_tok) = advance(p2)
            n.name = id_tok.str_val
            if check(p3, TokType.Colon) do
                var (p4, _) = advance(p3)
                if check(p4, TokType.Ident) do
                    var (p5, _) = advance(p4)
                    p3 = p5
                else
                    p3 = p4
                end
            end
            if check(p3, TokType.Assign) do
                var (p4, _) = advance(p3)
                p3 = p4
            end
            if check(p3, TokType.EmbedKw) do
                var (p4, _) = advance(p3)
                p3 = p4
            end
            var (p_expr, arg) = parse_expr(p3)
            n = ast_add_child(n, arg)
            p2 = p_expr
        end
        var (p4, _) = match_tok(p2, TokType.Semicolon)
        out (p4, n)
    end

    if t.tok_type == TokType.ExposeKw do
        var (p2, _) = advance(p)
        # expose func ...  or expose on next decl
        if check(p2, TokType.Func) do
            var (p3, _) = advance(p2)
            var (p4, fn) = parse_func_def(p3)
            n = ast_new(AstType.ExposeAttr)
            n.name = fat_str_new("expose")
            n.line = t.line
            n = ast_add_child(n, fn)
            out (p4, n)
        end
        var (p3, inner) = parse_statement(p2)
        n = ast_new(AstType.ExposeAttr)
        n.name = fat_str_new("expose")
        n.line = t.line
        n = ast_add_child(n, inner)
        out (p3, n)
    end

    if t.tok_type == TokType.Var do
        var (p2, _) = advance(p)
        out parse_var_decl(p2, false)
    end

    if t.tok_type == TokType.Const do
        var (p2, _) = advance(p)
        out parse_const_decl(p2)
    end

    if t.tok_type == TokType.Let do
        var (p2, _) = advance(p)
        out parse_const_decl(p2)
    end

    if t.tok_type == TokType.If do
        var (p2, _) = advance(p)
        out parse_if_stmt(p2)
    end

    if t.tok_type == TokType.Loop do
        var (p2, _) = advance(p)
        out parse_loop_stmt(p2)
    end

    if t.tok_type == TokType.When do
        var (p2, _) = advance(p)
        out parse_when_loop_stmt(p2, 1)
    end

    if t.tok_type == TokType.While do
        var (p2, _) = advance(p)
        out parse_when_loop_stmt(p2, 0)
    end

    if t.tok_type == TokType.For do
        var (p2, _) = advance(p)
        out parse_for_range_stmt(p2)
    end

    if t.tok_type == TokType.Case do
        var (p2, _) = advance(p)
        out parse_case_stmt(p2)
    end

    if t.tok_type == TokType.Enum do
        var (p2, _) = advance(p)
        out parse_enum_def(p2)
    end

    if t.tok_type == TokType.ThrowKw do
        var (p2, _) = advance(p)
        var (p3, expr) = parse_expr(p2)
        n = ast_new(AstType.ThrowStmt)
        n.line = t.line
        n = ast_add_child(n, expr)
        out (p3, n)
    end

    if t.tok_type == TokType.SelectKw do
        var (p2, _) = advance(p)
        var (p3, _) = match_tok(p2, TokType.Colon)
        p3 = skip_newlines(p3)
        var (p4, body) = parse_block(p3)
        var (p5, _, _) = expect_tok(p4, TokType.End, "expected 'end' after select block")
        var (p6, _) = match_tok(p5, TokType.Dot)
        n = ast_new(AstType.SelectStmt)
        n.line = t.line
        n = ast_add_child(n, body)
        out (p6, n)
    end

    if t.tok_type == TokType.PortKw do
        var (p2, _) = advance(p)
        var (p3, name_tok, _) = expect_name_tok(p2, "expected port name")
        n = ast_new(AstType.VarDecl)
        n.name = name_tok.str_val
        n.line = t.line
        var (p4, _) = match_tok(p3, TokType.Semicolon)
        out (p4, n)
    end

    if t.tok_type == TokType.SendKw do
        var (p2, _) = advance(p)
        var (p3, port_expr) = parse_expr(p2)
        var (p4, _) = match_tok(p3, TokType.SendArrow)
        var (p5, val_expr) = parse_expr(p4)
        n = ast_new(AstType.BuiltinCall)
        n.name = fat_str_new("__mir_send")
        n.line = t.line
        n.builtin_id = 32;  # MIR_INTR_SEND
        n = ast_add_child(n, port_expr)
        n = ast_add_child(n, val_expr)
        out (p5, n)
    end

    if t.tok_type == TokType.RecvKw and peek_n(p, 1).tok_type != TokType.Assign do
        var (p2, _) = advance(p)
        var (p3, port_expr) = parse_expr(p2)
        n = ast_new(AstType.BuiltinCall)
        n.name = fat_str_new("__mir_recv")
        n.line = t.line
        n.builtin_id = 33;  # MIR_INTR_RECV
        n = ast_add_child(n, port_expr)
        out (p3, n)
    end

    if t.tok_type == TokType.TrainKw do
        var (p2, _) = advance(p)
        var (p3, _) = match_tok(p2, TokType.Colon)
        p3 = skip_newlines(p3)
        var (p4, body) = parse_block(p3)
        var (p5, _, _) = expect_tok(p4, TokType.End, "expected 'end' after train block")
        var (p6, _) = match_tok(p5, TokType.Dot)
        n = ast_new(AstType.TrainBlock)
        n.line = t.line
        n = ast_add_child(n, body)
        out (p6, n)
    end

    if t.tok_type == TokType.InferKw do
        var (p2, _) = advance(p)
        var (p3, _) = match_tok(p2, TokType.Colon)
        p3 = skip_newlines(p3)
        var (p4, body) = parse_block(p3)
        var (p5, _, _) = expect_tok(p4, TokType.End, "expected 'end' after infer block")
        var (p6, _) = match_tok(p5, TokType.Dot)
        n = ast_new(AstType.InferBlock)
        n.line = t.line
        n = ast_add_child(n, body)
        out (p6, n)
    end

    if t.tok_type == TokType.AwaitKw do
        var (p2, _) = advance(p)
        if check(p2, TokType.PassKw) do
            var (p3, _) = advance(p2)
            n = ast_new(AstType.AwaitExpr)
            n.name = fat_str_new("pass")
            n.line = t.line
            out (p3, n)
        end
        var (p3, expr) = parse_expr(p2)
        n = ast_new(AstType.AwaitExpr)
        n.line = t.line
        n = ast_add_child(n, expr)
        out (p3, n)
    end

    if t.tok_type == TokType.CancelKw do
        var (p2, _) = advance(p)
        n = ast_new(AstType.CancelStmt)
        n.line = t.line
        if not check(p2, TokType.Newline) and not check(p2, TokType.Semicolon) and not check(p2, TokType.End) do
            var (p3, expr) = parse_expr(p2)
            n = ast_add_child(n, expr)
            out (p3, n)
        end
        out (p2, n)
    end

    if t.tok_type == TokType.QuietKw do
        var (p2, _) = advance(p)
        var (p3, expr) = parse_expr(p2)
        n = ast_new(AstType.QuietStmt)
        n.line = t.line
        n = ast_add_child(n, expr)
        out (p3, n)
    end

    # `arena` is contextual.  Parse an arena block only when its header ends
    # in ':', otherwise let the generic name path handle arena variables.
    arena_header = false
    if t.tok_type == TokType.ArenaKw do
        if peek_n(p, 1).tok_type == TokType.Colon do
            arena_header = true
        eif is_name_token(peek_n(p, 1).tok_type) and peek_n(p, 2).tok_type == TokType.Colon do
            arena_header = true
        eif peek_n(p, 1).tok_type == TokType.LParen do
            ai = p.pos + 2
            adepth = 1
            when ai < p.token_count and adepth > 0 loop
                atok = vec_get_rt(p.tokens, ai).tok_type
                if atok == TokType.LParen do adepth = adepth + 1 end
                if atok == TokType.RParen do adepth = adepth - 1 end
                ai = ai + 1
            end
            if adepth == 0 and ai < p.token_count and vec_get_rt(p.tokens, ai).tok_type == TokType.Colon do
                arena_header = true
            end
        end
    end
    if t.tok_type == TokType.ArenaKw and arena_header do
        var (p2, _) = advance(p)
        n = ast_new(AstType.ArenaBlock)
        n.line = t.line
        if check(p2, TokType.LParen) do
            var (p_lp, _) = advance(p2)
            if check(p_lp, TokType.Ident) do
                var (p_cap, cap_ident) = advance(p_lp)
                if fat_str_eq(tok_lex(cap_ident), fat_str_new("capacity")) do
                    var (p_col, _) = match_tok(p_cap, TokType.Colon)
                    var (p_expr, cap_expr) = parse_expr(p_col)
                    n = ast_add_child(n, cap_expr)
                    p2 = p_expr
                else
                    var (p_expr, cap_expr) = parse_expr(p_lp)
                    n = ast_add_child(n, cap_expr)
                    p2 = p_expr
                end
            else
                var (p_expr, cap_expr) = parse_expr(p_lp)
                n = ast_add_child(n, cap_expr)
                p2 = p_expr
            end
            var (p_rp, _, _) = expect_tok(p2, TokType.RParen, "expected ')' after arena capacity")
            p2 = p_rp
        end
        var (p3, _) = match_tok(p2, TokType.Colon)
        p3 = skip_newlines(p3)
        var (p4, body) = parse_block(p3)
        var (p5, _, _) = expect_tok(p4, TokType.End, "expected 'end' after arena block")
        var (p6, _) = match_tok(p5, TokType.Dot)
        n = ast_add_child(n, body)
        out (p6, n)
    end

    if t.tok_type == TokType.EmitKw do
        var (p2, _) = advance(p)
        var (p3, expr) = parse_expr(p2)
        n = ast_new(AstType.EmitStmt)
        n.line = t.line
        n = ast_add_child(n, expr)
        out (p3, n)
    end

    if t.tok_type == TokType.ErxKw do
        var (p2, _) = advance(p)
        n = ast_new(AstType.ErxExpr)
        n.line = t.line
        out (p2, n)
    end

    if t.tok_type == TokType.Task do
        var (p2, _) = advance(p)
        var (p3, expr) = parse_expr(p2)
        n = ast_new(AstType.TaskExpr)
        n.line = t.line
        n = ast_add_child(n, expr)
        out (p3, n)
    end

    if t.tok_type == TokType.Wait do
        var (p2, _) = advance(p)
        var (p3, expr) = parse_expr(p2)
        n = ast_new(AstType.WaitExpr)
        n.line = t.line
        n = ast_add_child(n, expr)
        out (p3, n)
    end

    if t.tok_type == TokType.ResumeKw do
        var (p2, _) = advance(p)
        n = ast_new(AstType.ResumeStmt)
        n.line = t.line
        if check(p2, TokType.RetryKw) do
            var (p3, _) = advance(p2)
            n.name = fat_str_new("retry")
            out (p3, n)
        end
        if check(p2, TokType.RevertKw) do
            var (p3, _) = advance(p2)
            n.name = fat_str_new("revert")
            out (p3, n)
        end
        out (p2, n)
    end

    if t.tok_type == TokType.Try do
        var (p2, _) = advance(p)
        n = ast_new(AstType.TryStmt)
        n.line = t.line
        # try(timeout: …) / try(isolate: […])
        if check(p2, TokType.LParen) do
            var (p3, _) = advance(p2)
            when not check(p3, TokType.RParen) and not check(p3, TokType.Eof) loop
                if check(p3, TokType.TimeoutKw) do
                    var (p4, _) = advance(p3)
                    var (p5, _) = match_tok(p4, TokType.Colon)
                    var (p6, tex) = parse_expr(p5)
                    cl = ast_new(AstType.TimeoutClause)
                    cl = ast_add_child(cl, tex)
                    n = ast_add_child(n, cl)
                    p3 = p6
                eif check(p3, TokType.IsolateKw) do
                    var (p4, _) = advance(p3)
                    var (p5, _) = match_tok(p4, TokType.Colon)
                    var (p6, iex) = parse_expr(p5)
                    cl = ast_new(AstType.IsolateClause)
                    cl = ast_add_child(cl, iex)
                    n = ast_add_child(n, cl)
                    p3 = p6
                else
                    var (p4, _) = advance(p3)
                    p3 = p4
                end
                var (p_c, _) = match_tok(p3, TokType.Comma)
                p3 = p_c
            end
            var (p_rp, _, _) = expect_tok(p3, TokType.RParen, "expected ')' after try options")
            p2 = p_rp
        end
        var (p3, _) = match_tok(p2, TokType.Colon)
        p3 = skip_newlines(p3)
        var (p4, body) = parse_block(p3)
        n = ast_add_child(n, body)
        if check(p4, TokType.RevertKw) do
            var (p5, _) = advance(p4)
            var (p5b, _) = match_tok(p5, TokType.Colon)
            p5 = p5b
            p5 = skip_newlines(p5)
            var (p6, rev) = parse_block(p5)
            n = ast_add_child(n, rev)
            p4 = p6
        end
        var (p7, _, _) = expect_tok(p4, TokType.End, "expected 'end' after try")
        var (p8, _) = match_tok(p7, TokType.Dot)
        out (p8, n)
    end

    # `isolate:` sandbox block (§25.5) — distinct from try(isolate:)
    if t.tok_type == TokType.IsolateKw do
        var (p2, _) = advance(p)
        var (p3, _) = match_tok(p2, TokType.Colon)
        p3 = skip_newlines(p3)
        var (p4, body) = parse_block(p3)
        var (p5, _, _) = expect_tok(p4, TokType.End, "expected 'end' after isolate")
        var (p6, _) = match_tok(p5, TokType.Dot)
        n = ast_new(AstType.IsolateClause)
        n.name = fat_str_new("block")
        n.line = t.line
        n = ast_add_child(n, body)
        out (p6, n)
    end

    # timeout as bare stmt is invalid alone — allow `timeout expr` marker for completeness
    if t.tok_type == TokType.TimeoutKw do
        var (p2, _) = advance(p)
        var (p3, tex) = parse_expr(p2)
        n = ast_new(AstType.TimeoutClause)
        n.line = t.line
        n = ast_add_child(n, tex)
        out (p3, n)
    end

    if t.tok_type == TokType.QuantizeKw do
        var (p2, _) = advance(p)
        var (p3, expr) = parse_expr(p2)
        n = ast_new(AstType.QuantizeExpr)
        n.line = t.line
        n = ast_add_child(n, expr)
        out (p3, n)
    end

    if t.tok_type == TokType.Lock do
        var (p2, _) = advance(p)
        var (p3, expr) = parse_expr(p2)
        n = ast_new(AstType.BuiltinCall)
        n.name = fat_str_new("__mir_lock")
        n.builtin_id = 38
        n.line = t.line
        n = ast_add_child(n, expr)
        out (p3, n)
    end

    if t.tok_type == TokType.DeckKw do
        var (p2, _) = advance(p)
        var (p3, name_tok, _) = expect_name_tok(p2, "expected deck name")
        n = ast_new(AstType.VarDecl)
        n.name = name_tok.str_val
        n.line = t.line
        var (p4, _) = match_tok(p3, TokType.Semicolon)
        out (p4, n)
    end

    if t.tok_type == TokType.MoldKw do
        var (p2, _) = advance(p)
        out parse_mold_def(p2)
    end

    if t.tok_type == TokType.Entity do
        var (p2, _) = advance(p)
        out parse_entity_def(p2)
    end

    if t.tok_type == TokType.InterfaceKw do
        var (p2, _) = advance(p)
        out parse_interface_def(p2)
    end

    # packed entity Name: ... end
    if t.tok_type == TokType.PackedKw do
        var (p2, _) = advance(p)
        if check(p2, TokType.Entity) do
            var (p3, _) = advance(p2)
            var (p4, ed) = parse_entity_def(p3)
            ed.node_type = AstType.PackedDef
            out (p4, ed)
        end
        p2 = parse_error(p2, "expected 'entity' after 'packed' in strict v2")
        p2 = sync_past_block_end(p2)
        ed_err = ast_new(AstType.PackedDef)
        ed_err.line = t.line
        out (p2, ed_err)
    end

    # register Name: ... end or register entity Name: ... end
    if t.tok_type == TokType.RegisterKw do
        var (p2, _) = advance(p)
        if check(p2, TokType.Entity) do
            var (p3, _) = advance(p2)
            var (p4, ed) = parse_entity_def(p3)
            ed.node_type = AstType.RegisterDef
            out (p4, ed)
        end
        if check(p2, TokType.Ident) do
            var (p4, ed) = parse_entity_def(p2)
            ed.node_type = AstType.RegisterDef
            out (p4, ed)
        end
        n = ast_new(AstType.Identifier)
        n.name = fat_str_new("register")
        n.line = t.line
        out (p2, n)
    end

    # @bind(c) / @entry — attribute on next declaration (`bind`/`entry` may be keywords)
    if t.tok_type == TokType.AtSign do
        var (p2, _) = advance(p)
        attr_tok = peek(p2)
        is_attr = attr_tok.tok_type == TokType.Ident or attr_tok.tok_type == TokType.BindKw or attr_tok.tok_type == TokType.EntryKw
        if not is_attr do
            p2 = parse_error(p2, "expected attribute name after '@'")
            out (p2, ast_new(AstType.BindAttr))
        end
        var (p3, attr_name) = advance(p2)
        attr_nm = attr_name.str_val
        if attr_name.tok_type == TokType.BindKw do
            attr_nm = fat_str_new("bind")
        end
        if attr_name.tok_type == TokType.EntryKw do
            attr_nm = fat_str_new("entry")
        end
        # Parse optional parenthesized args: @bind(c)
        attr_arg = fat_str_new("")
        if check(p3, TokType.LParen) do
            var (p4, _) = advance(p3)
            if check(p4, TokType.Ident) do
                var (p5, arg_tok) = advance(p4)
                attr_arg = arg_tok.str_val
                p4 = p5
            end
            var (p6, _, _) = expect_tok(p4, TokType.RParen, "expected ')' after attribute args")
            p3 = p6
        end
        p3 = skip_newlines(p3)
        var (p7, inner_stmt) = parse_statement(p3)
        n = ast_new(AstType.BindAttr)
        n.name = attr_nm
        n.name2 = attr_arg
        n.line = t.line
        n = ast_add_child(n, inner_stmt)
        out (p7, n)
    end

    if t.tok_type == TokType.Out do
        var (p2, _) = advance(p)
        out parse_return_stmt(p2)
    end

    if t.tok_type == TokType.Print do
        var (p2, _) = advance(p)
        out parse_print_stmt(p2)
    end

    if t.tok_type == TokType.Break do
        var (p2, _) = advance(p)
        n = ast_new(AstType.BreakStmt)
        n.line = t.line
        out (p2, n)
    end

    if t.tok_type == TokType.Skip do
        var (p2, _) = advance(p)
        n = ast_new(AstType.ContinueStmt)
        n.line = t.line
        out (p2, n)
    end

    if t.tok_type == TokType.Import do
        var (p2, _) = advance(p)
        var (p3, first_tok, ok) = expect_name_tok(p2, "expected name after import")
        if not ok do
            out (p3, ast_new(AstType.ImportStmt))
        end
        var first_alias = fat_str_new("")
        p4 = p3
        var (p3_as, has_first_as) = match_tok(p4, TokType.As)
        if has_first_as do
            var (p3_alias, a_tok, _) = expect_name_tok(p3_as, "expected alias name")
            first_alias = a_tok.str_val
            p4 = p3_alias
        end

        # Check if this is "import X, Y, Z from MODULE;" pattern
        names = vec_new_rt()
        aliases = vec_new_rt()
        names = vec_push_rt(names, first_tok.str_val)
        aliases = vec_push_rt(aliases, first_alias)
        when check(p4, TokType.Comma) loop
            var (p5, _) = advance(p4)
            p5 = skip_newlines(p5)
            var (p6, sym, _) = expect_name_tok(p5, "expected symbol name")
            p4 = p6
            var sym_alias = fat_str_new("")
            var (p6_as, has_sym_as) = match_tok(p4, TokType.As)
            if has_sym_as do
                var (p6_alias, a2_tok, _) = expect_name_tok(p6_as, "expected alias name")
                sym_alias = a2_tok.str_val
                p4 = p6_alias
            end
            names = vec_push_rt(names, sym.str_val)
            aliases = vec_push_rt(aliases, sym_alias)
        end
        if check(p4, TokType.From) do
            # "import X, Y from MOD;" syntax
            var (p5, _) = advance(p4)
            var (p6, mod_tok, _) = expect_name_tok(p5, "expected module name after 'from'")
            mod_name = mod_tok.str_val
            when check(p6, TokType.Dot) or check(p6, TokType.DoubleColon) loop
                var (p6_sep, _) = advance(p6)
                var (p6_seg, mod_seg, _) = expect_name_tok(p6_sep, "expected module path segment")
                mod_name = fat_str_concat(fat_str_concat(mod_name, fat_str_new(".")), mod_seg.str_val)
                p6 = p6_seg
            end
            # Optional trailing "as <alias>" (Vir form: import <sym> from <mod> as <alias>).
            var trailing_alias = fat_str_new("")
            var (p6_as, has_mod_as) = match_tok(p6, TokType.As)
            if has_mod_as do
                var (p6_al, al_tok, _) = expect_name_tok(p6_as, "expected alias name")
                trailing_alias = al_tok.str_val
                p6 = p6_al
            else
                p6 = p6_as
            end
            n = ast_new(AstType.ImportStmt)
            n.name = mod_name
            n.line = t.line
            ni = 0
            when ni < vec_len_rt(names) loop
                s = ast_new(AstType.Identifier)
                s.name = vec_get_rt(names, ni)
                s.name2 = vec_get_rt(aliases, ni)
                if ni == 0 and fat_str_len(trailing_alias) > 0 do
                    s.name2 = trailing_alias
                end
                n = ast_add_child(n, s)
                ni = ni + 1
            end
            var (p7, _) = match_tok(p6, TokType.Semicolon)
            out (p7, n)
        end
        # Simple "import MOD" or "import MOD as ALIAS"
        n = ast_new(AstType.ImportStmt)
        n.name = first_tok.str_val
        n.line = t.line
        if has_first_as do
            n.name2 = first_alias
        end
        var (p5_semi, _) = match_tok(p4, TokType.Semicolon)
        out (p5_semi, n)
    end

    if t.tok_type == TokType.Get do
        var (p2, _) = advance(p)
        var (p3, var_tok, ok) = expect_name_tok(p2, "expected name after get")
        if not ok do
            out (p3, ast_new(AstType.ImportStmt))
        end
        var (p4, _) = match_tok(p3, TokType.From)
        var (p5, mod_tok, _) = expect_name_tok(p4, "expected module name after 'from'")
        mod_name = mod_tok.str_val
        when check(p5, TokType.Dot) or check(p5, TokType.DoubleColon) loop
            var (p5_sep, _) = advance(p5)
            var (p5_seg, mod_seg, _) = expect_name_tok(p5_sep, "expected module path segment")
            mod_name = fat_str_concat(fat_str_concat(mod_name, fat_str_new(".")), mod_seg.str_val)
            p5 = p5_seg
        end
        n = ast_new(AstType.ImportStmt)
        n.name = mod_name
        n.line = t.line
        s = ast_new(AstType.Identifier)
        s.name = var_tok.str_val
        s.line = var_tok.line
        var (p5_as, has_as) = match_tok(p5, TokType.As)
        if has_as do
            var (p5_alias, alias_tok, _) = expect_name_tok(p5_as, "expected alias name")
            s.name2 = alias_tok.str_val
            p5 = p5_alias
        end
        n = ast_add_child(n, s)
        var (p6, _) = match_tok(p5, TokType.Semicolon)
        out (p6, n)
    end

    if t.tok_type == TokType.From do
        var (p2, _) = advance(p)
        var (p3, mod_tok, ok) = expect_name_tok(p2, "expected module name")
        if not ok do
            out (p3, ast_new(AstType.ImportStmt))
        end
        mod_name = mod_tok.str_val
        when check(p3, TokType.Dot) or check(p3, TokType.DoubleColon) loop
            var (p3_sep, _) = advance(p3)
            var (p3_seg, mod_seg, _) = expect_name_tok(p3_sep, "expected module path segment")
            mod_name = fat_str_concat(fat_str_concat(mod_name, fat_str_new(".")), mod_seg.str_val)
            p3 = p3_seg
        end
        var (p4, _, _) = expect_tok(p3, TokType.Import, "expected 'import'")
        n = ast_new(AstType.ImportStmt)
        n.name = mod_name
        n.line = t.line
        should_loop = true
        when should_loop loop
            var (p5, sym, _) = expect_name_tok(p4, "expected symbol name")
            p4 = p5
            s = ast_new(AstType.Identifier)
            s.name = sym.str_val
            s.line = sym.line
            var (p5_as, has_as) = match_tok(p4, TokType.As)
            if has_as do
                var (p5_alias, alias_tok, _) = expect_name_tok(p5_as, "expected alias name")
                s.name2 = alias_tok.str_val
                p4 = p5_alias
            end
            n = ast_add_child(n, s)
            var (p6, matched) = match_tok(p4, TokType.Comma)
            p4 = p6
            if not matched do
                should_loop = false
            end
        end
        out (p4, n)
    end

    if t.tok_type == TokType.Module do
        var (p2, _) = advance(p)
        var (p3, mod_tok, _) = expect_name_tok(p2, "expected module name")
        mod_path = mod_tok.str_val
        when check(p3, TokType.DoubleColon) loop
            var (p4, _) = advance(p3)
            var (p5, seg, _) = expect_name_tok(p4, "expected name after '.'")
            mod_path = fat_str_concat(fat_str_concat(mod_path, fat_str_new(".")), seg.str_val)
            p3 = p5
        end
        when check(p3, TokType.Dot) loop
            var (p4, _) = advance(p3)
            var (p5, seg, _) = expect_name_tok(p4, "expected name after '.'")
            mod_path = fat_str_concat(fat_str_concat(mod_path, fat_str_new(".")), seg.str_val)
            p3 = p5
        end
        n = ast_new(AstType.ModuleStmt)
        n.name = mod_path
        n.line = t.line
        var (p4, _) = match_tok(p3, TokType.Semicolon)
        out (p4, n)
    end

    if t.tok_type == TokType.Export do
        var (p2, _) = advance(p)
        var (p3, fn_tok, _) = expect_name_tok(p2, "expected function name after export")
        n = ast_new(AstType.ExportStmt)
        n.name = fn_tok.str_val
        n.line = t.line
        when check(p3, TokType.Comma) loop
            var (p4, _) = advance(p3)
            p4 = skip_newlines(p4)
            var (p5, extra_tok, _) = expect_name_tok(p4, "expected export identifier")
            p3 = p5
            s = ast_new(AstType.Identifier)
            s.name = extra_tok.str_val
            n = ast_add_child(n, s)
        end
        var (p6, _) = match_tok(p3, TokType.Semicolon)
        out (p6, n)
    end

    if t.tok_type == TokType.Include do
        var (p2, _) = advance(p)
        var inc_block = ast_new(AstType.Block)
        inc_block.line = t.line

        when true loop
            var n = ast_new(AstType.IncludeStmt)
            n.line = t.line
            # Accept both string literal and identifier for include
            if check(p2, TokType.Str) do
                var (p3, file_tok, _) = expect_tok(p2, TokType.Str, "expected filename after include")
                n.name = file_tok.str_val
                p2 = p3
            else
                # Identifier path: include types; or include vir.rt.syscall
                var (p3, id_tok, _) = expect_name_tok(p2, "expected module name after include")
                path = id_tok.str_val
                p2 = p3
                when check(p2, TokType.DoubleColon) loop
                    var (p4, _) = advance(p2)
                    var (p5, seg, _) = expect_name_tok(p4, "expected name after '::'")
                    path = fat_str_concat(fat_str_concat(path, fat_str_new(".")), seg.str_val)
                    p2 = p5
                end
                when check(p2, TokType.Dot) loop
                    var (p4, _) = advance(p2)
                    var (p5, seg, _) = expect_name_tok(p4, "expected name after '.'")
                    path = fat_str_concat(fat_str_concat(path, fat_str_new(".")), seg.str_val)
                    p2 = p5
                end
                n.name = path
            end

            # Check optional `as alias`
            if check(p2, TokType.As) do
                var (p_as, _) = advance(p2)
                var (p_alias, alias_tok, _) = expect_name_tok(p_as, "expected alias name after 'as'")
                n.name2 = alias_tok.str_val
                p2 = p_alias
            end

            inc_block = ast_add_child(inc_block, n)

            if check(p2, TokType.Comma) do
                var (p_comma, _) = advance(p2)
                p2 = p_comma
            else
                break
            end
        end

        var (p3, _) = match_tok(p2, TokType.Semicolon)
        if vec_len_rt(inc_block.children) == 1 do
            out (p3, vec_get_rt(inc_block.children, 0))
        else
            out (p3, inc_block)
        end
    end

    if t.tok_type == TokType.CheckCpu do
        var (p2, _) = advance(p)
        n = ast_new(AstType.CheckCpu)
        n.line = t.line
        out (p2, n)
    end

    if t.tok_type == TokType.Patch do
        var (p2, _) = advance(p)
        n = ast_new(AstType.PatchPoint)
        n.line = t.line
        out (p2, n)
    end

    # Be liberal with a standalone block-closing dot.  It is purely a
    # separator and can remain after recovery from an optional `end.`.
    if t.tok_type == TokType.Dot do
        var (p2, _) = advance(p)
        out (p2, ast_new(AstType.LiteralInt))
    end

    # Identifier (may be assignment, field/index assign, or expression)
    if is_name_token(t.tok_type) do
        ident_pos = p.pos

        # IDENT(...) — expression statement; no backtracking.
        if peek_n(p, 1).tok_type == TokType.LParen do
            out parse_expr(p)
        end

        # IDENT.FIELD[.FIELD...] = expr — lookahead avoids rewinding into parse_expr.
        if stmt_is_field_assign(p) do
            var (p2, id_tok) = advance(p)
            id_name = tok_lex(id_tok)
            var base_obj = ast_new(AstType.Identifier)
            base_obj.name = id_name
            base_obj.line = id_tok.line
            var (p_dot, _) = advance(p2)
            var (p_field, field_tok1) = advance(p_dot)
            var last_field_tok = field_tok1
            var cur_p = p_field
            when check(cur_p, TokType.Dot) and is_name_token(peek_n(cur_p, 1).tok_type) loop
                var next_base = ast_new(AstType.FieldAccess)
                next_base.name = tok_lex(last_field_tok)
                next_base.line = last_field_tok.line
                next_base = ast_add_child(next_base, base_obj)
                base_obj = next_base
                var (p_d, _) = advance(cur_p)
                var (p_f, f_tok) = advance(p_d)
                last_field_tok = f_tok
                cur_p = p_f
            end
            field_name = tok_lex(last_field_tok)
            if check(cur_p, TokType.Assign) do
                var (p5, _) = advance(cur_p)
                var (p6, val) = parse_expr(p5)
                fa = ast_new(AstType.FieldAssign)
                fa.line = id_tok.line
                fa = ast_add_child(fa, val)
                fa = ast_add_child(fa, base_obj)
                fa.name = id_name
                fa.name2 = field_name
                out (p6, fa)
            end
            var (p5, op_tok) = advance(cur_p)
            var (p6, val) = parse_expr(p5)
            lhs_fa = ast_new(AstType.FieldAccess)
            lhs_fa.line = last_field_tok.line
            lhs_fa = ast_add_child(lhs_fa, base_obj)
            lhs_fa.name = field_name
            bin = ast_new(AstType.BinOp)
            bin.op = compound_assign_op(op_tok.tok_type)
            bin.line = op_tok.line
            bin = ast_add_child(bin, lhs_fa)
            bin = ast_add_child(bin, val)
            fa = ast_new(AstType.FieldAssign)
            fa.line = id_tok.line
            fa = ast_add_child(fa, bin)
            fa = ast_add_child(fa, base_obj)
            fa.name = id_name
            fa.name2 = field_name
            out (p6, fa)
        end

        var (p2, id_tok) = advance(p)
        id_name = tok_lex(id_tok)

        # Simple assignment: IDENT = expr or IDENT += expr
        if check(p2, TokType.Assign) do
            p2.pos = p2.pos + 1
            var (p4, val) = parse_expr(p2)
            assign = ast_new(AstType.Assign)
            assign.line = id_tok.line
            assign = ast_add_child(assign, val)
            assign.name = id_name
            out (p4, assign)
        end
        if is_compound_assign(peek(p2)) do
            var (p3, op_tok) = advance(p2)
            var (p4, val) = parse_expr(p3)
            lhs_id = ast_new(AstType.Identifier)
            lhs_id.name = id_name
            lhs_id.line = id_tok.line
            bin = ast_new(AstType.BinOp)
            bin.op = compound_assign_op(op_tok.tok_type)
            bin.line = op_tok.line
            bin = ast_add_child(bin, lhs_id)
            bin = ast_add_child(bin, val)
            assign = ast_new(AstType.Assign)
            assign.line = id_tok.line
            assign = ast_add_child(assign, bin)
            assign.name = id_name
            out (p4, assign)
        end

        # Index assignment: IDENT[expr, ...] = expr or IDENT[expr, ...] += expr
        if check(p2, TokType.LBracket) do
            var (p3, lbr_tok) = advance(p2)
            if check(p3, TokType.Comma) do
                p_err = parse_error_at(p3, "unexpected ',' at start of index", peek(p3).line)
                out (p_err, ast_new(AstType.IndexAssign))
            end
            if check(p3, TokType.RBracket) do
                p_err = parse_error_at(p3, "expected expression after '['", peek(p3).line)
                out (p_err, ast_new(AstType.IndexAssign))
            end
            var (p4, first_idx) = parse_expr(p3)
            var indices = vec_new_rt()
            indices = vec_push_rt(indices, first_idx)
            p_cur = p4
            var idx_loop = true
            when idx_loop loop
                if check(p_cur, TokType.Comma) do
                    var (p_comma, _) = advance(p_cur)
                    if check(p_comma, TokType.RBracket) do
                        p_cur = parse_error_at(p_comma, "unexpected ',' before ']'", peek(p_comma).line)
                        idx_loop = false
                    else
                        var (p_next, next_idx) = parse_expr(p_comma)
                        indices = vec_push_rt(indices, next_idx)
                        p_cur = p_next
                    end
                else
                    idx_loop = false
                end
            end
            var (p5, _, _) = expect_tok(p_cur, TokType.RBracket, "expected ']'")
            if check(p5, TokType.Assign) do
                var (p6, _) = advance(p5)
                var (p7, val) = parse_expr(p6)
                ia = ast_new(AstType.IndexAssign)
                ia.line = id_tok.line
                num_indices = vec_len_rt(indices)
                var ki = 0
                when ki < num_indices loop
                    ia = ast_add_child(ia, vec_get_rt(indices, ki))
                    ki = ki + 1
                end
                ia = ast_add_child(ia, val)
                ia.name = id_name
                out (p7, ia)
            end
            if is_compound_assign(peek(p5)) do
                var (p6, op_tok) = advance(p5)
                var (p7, val) = parse_expr(p6)
                lhs_ia = ast_new(AstType.IndexAccess)
                lhs_ia.line = id_tok.line
                num_indices = vec_len_rt(indices)
                var ki = 0
                when ki < num_indices loop
                    lhs_ia = ast_add_child(lhs_ia, vec_get_rt(indices, ki))
                    ki = ki + 1
                end
                lhs_ia.name = id_name
                bin = ast_new(AstType.BinOp)
                bin.op = compound_assign_op(op_tok.tok_type)
                bin.line = op_tok.line
                bin = ast_add_child(bin, lhs_ia)
                bin = ast_add_child(bin, val)
                ia = ast_new(AstType.IndexAssign)
                ia.line = id_tok.line
                var kj = 0
                when kj < num_indices loop
                    ia = ast_add_child(ia, vec_get_rt(indices, kj))
                    kj = kj + 1
                end
                ia = ast_add_child(ia, bin)
                ia.name = id_name
                out (p7, ia)
            end
        end

        # Expression statement (field access, index, calls, etc.)
        p.pos = ident_pos
        out parse_expr(p)
    end

    # EOF / END / ELSE / EIF — no statement
    is_terminator = t.tok_type == TokType.Eof or t.tok_type == TokType.End or t.tok_type == TokType.Else or t.tok_type == TokType.Eif or t.tok_type == TokType.EnsureKw or t.tok_type == TokType.RevertKw
    if is_terminator do
        out (p, ast_new(AstType.LiteralInt))
    end

    # Default: try as expression statement
    out parse_expr(p)
end.
# ═══════════════════════════════════════════════════════
# Top-Level Entry Point
# ═══════════════════════════════════════════════════════

func parse_program(p: Parser):

    ast_arena_begin()
    prog = ast_new(AstType.Program)
    p = skip_newlines(p)

    when not check(p, TokType.Eof) loop
        let old_pos = p.pos
        var (p2, stmt) = parse_statement(p)
        if p2.pos == old_pos and rt_strlen(p2.error_msg) == 0 do
            # Forced progress if parse_statement failed to consume any token
            var (p_adv, _) = advance(p)
            p = p_adv
        eif rt_strlen(p2.error_msg) > 0 do
            # Error recovery: log error and advance at least 1 token to guarantee progress
            print_ln(p2.error_msg)
            if p.error_line == 0 do
                p.error_line = p2.error_line
            end
            p.error_msg = ""
            var (p_adv, _) = advance(p)
            p = p_adv
            when not check(p, TokType.Eof) and not check(p, TokType.Func) and not check(p, TokType.Enum) and not check(p, TokType.Entity) and not check(p, TokType.Const) and not check(p, TokType.Var) and not check(p, TokType.Extern) and not check(p, TokType.Import) loop
                var (p3, _) = advance(p)
                p = p3
            end
        else
            p = p2
            prog = ast_add_child(prog, stmt)
        end
        # Skip optional trailing semicolons at top level
        when check(p, TokType.Semicolon) loop
            var (p_semi, _) = advance(p)
            p = p_semi
        end
        p = skip_newlines(p)
    end

    ast_arena_end()
    out (p, prog)
end.
