##
 * vir/compiler/target_spec.vri — Authoritative Target Specification Model
 * =========================================================================
 * Unified canonical target model across the 8-target matrix:
 *   1. macos-arm64
 *   2. macos-arm64-libsystem
 *   3. linux-arm64
 *   4. windows-arm64
 *   5. linux-x86_64
 *   6. windows-x86_64
 *   7. linux-riscv64
 *   8. wasm32-wasi-p1
 ##

module vir.compiler.target_spec

include types
include string_rt
import rt_streq, native_read_i64, native_write_i64 from string_rt
include alloc
import vir_alloc from alloc
include compiler.mc
import TargetArch, TargetOS, TargetABI, RuntimeProvider, ObjectFormat, AsmDialect from compiler.mc
include rt.syscall
import Platform, sys_platform from rt.syscall

entity TargetSpec:
    canonical_name:   string;
    arch:             int;
    os:               int;
    call_abi:         int;
    runtime_provider: int;
    object_format:    int;
    asm_dialect:      int;
    pointer_width:    int;
    stack_align:      int
end.

func target_spec_new(name: string, arch: int, os: int, abi: int, provider: int, format: int, dialect: int, ptr_w: int, stack_a: int):
    let p = vir_alloc(72)
    native_write_i64(p, 0, name as i64)
    native_write_i64(p, 8, arch as i64)
    native_write_i64(p, 16, os as i64)
    native_write_i64(p, 24, abi as i64)
    native_write_i64(p, 32, provider as i64)
    native_write_i64(p, 40, format as i64)
    native_write_i64(p, 48, dialect as i64)
    native_write_i64(p, 56, ptr_w as i64)
    native_write_i64(p, 64, stack_a as i64)
    out p as TargetSpec
end.

func target_spec_name(s: TargetSpec):        out native_read_i64(s as i64, 0) as string end.
func target_spec_arch(s: TargetSpec):        out native_read_i64(s as i64, 8) as int end.
func target_spec_os(s: TargetSpec):          out native_read_i64(s as i64, 16) as int end.
func target_spec_abi(s: TargetSpec):         out native_read_i64(s as i64, 24) as int end.
func target_spec_provider(s: TargetSpec):    out native_read_i64(s as i64, 32) as int end.
func target_spec_format(s: TargetSpec):      out native_read_i64(s as i64, 40) as int end.
func target_spec_dialect(s: TargetSpec):     out native_read_i64(s as i64, 48) as int end.
func target_spec_ptr_width(s: TargetSpec):   out native_read_i64(s as i64, 56) as int end.
func target_spec_stack_align(s: TargetSpec): out native_read_i64(s as i64, 64) as int end.

func target_spec_is_linux(s: TargetSpec):
    out (native_read_i64(s as i64, 16) as int) == TargetOS.Linux
end.

func target_spec_is_darwin(s: TargetSpec):
    out (native_read_i64(s as i64, 16) as int) == TargetOS.Darwin
end.

func target_spec_is_windows(s: TargetSpec):
    out (native_read_i64(s as i64, 16) as int) == TargetOS.Windows
end.

func target_spec_is_wasi(s: TargetSpec):
    out (native_read_i64(s as i64, 16) as int) == TargetOS.WASI_P1
end.

# Factory functions for the 8 canonical targets
func make_target_macos_arm64():
    out target_spec_new("macos-arm64", TargetArch.ARM64, TargetOS.Darwin, TargetABI.AAPCS64, RuntimeProvider.DarwinRawSyscall, ObjectFormat.MachO, AsmDialect.DarwinAsm, 8, 16)
end.

func make_target_macos_arm64_libsystem():
    out target_spec_new("macos-arm64-libsystem", TargetArch.ARM64, TargetOS.Darwin, TargetABI.AAPCS64, RuntimeProvider.DarwinLibSystem, ObjectFormat.MachO, AsmDialect.DarwinAsm, 8, 16)
end.

func make_target_linux_arm64():
    out target_spec_new("linux-arm64", TargetArch.ARM64, TargetOS.Linux, TargetABI.AAPCS64, RuntimeProvider.LinuxSyscall, ObjectFormat.ELF, AsmDialect.GNU_ELF, 8, 16)
end.

func make_target_windows_arm64():
    out target_spec_new("windows-arm64", TargetArch.ARM64, TargetOS.Windows, TargetABI.Windows_ARM64, RuntimeProvider.WindowsKernel32, ObjectFormat.PE_COFF, AsmDialect.DarwinAsm, 8, 16)
end.

func make_target_linux_x86_64():
    out target_spec_new("linux-x86_64", TargetArch.X86_64, TargetOS.Linux, TargetABI.SysV_AMD64, RuntimeProvider.LinuxSyscall, ObjectFormat.ELF, AsmDialect.GNU_ELF, 8, 16)
end.

func make_target_windows_x86_64():
    out target_spec_new("windows-x86_64", TargetArch.X86_64, TargetOS.Windows, TargetABI.Windows_AMD64, RuntimeProvider.WindowsKernel32, ObjectFormat.PE_COFF, AsmDialect.Intel_X86, 8, 16)
end.

func make_target_linux_riscv64():
    out target_spec_new("linux-riscv64", TargetArch.RISCV64, TargetOS.Linux, TargetABI.RV64D, RuntimeProvider.LinuxSyscall, ObjectFormat.ELF, AsmDialect.GNU_RISCV, 8, 16)
end.

func make_target_wasm32_wasi_p1():
    out target_spec_new("wasm32-wasi-p1", TargetArch.Wasm32, TargetOS.WASI_P1, TargetABI.WasmMVP, RuntimeProvider.WASIP1, ObjectFormat.Wasm, AsmDialect.WasmWAT, 4, 16)
end.

func get_host_target_spec():
    let p = sys_platform()
    if p == Platform.Linux_ARM64 do
        out make_target_linux_arm64()
    eif p == Platform.Linux_x86_64 do
        out make_target_linux_x86_64()
    eif p == Platform.Linux_RISCV64 do
        out make_target_linux_riscv64()
    else
        out make_target_macos_arm64()
    end
end.

func parse_target_spec(str_val: string):
    # 1. Exact match for 8 canonical target names
    if rt_streq(str_val, "macos-arm64") do
        out make_target_macos_arm64()
    end
    if rt_streq(str_val, "macos-arm64-libsystem") do
        out make_target_macos_arm64_libsystem()
    end
    if rt_streq(str_val, "linux-arm64") do
        out make_target_linux_arm64()
    end
    if rt_streq(str_val, "windows-arm64") do
        out make_target_windows_arm64()
    end
    if rt_streq(str_val, "linux-x86_64") do
        out make_target_linux_x86_64()
    end
    if rt_streq(str_val, "windows-x86_64") do
        out make_target_windows_x86_64()
    end
    if rt_streq(str_val, "linux-riscv64") do
        out make_target_linux_riscv64()
    end
    if rt_streq(str_val, "wasm32-wasi-p1") do
        out make_target_wasm32_wasi_p1()
    end

    # 2. Target aliases
    if rt_streq(str_val, "arm64-apple-darwin") or rt_streq(str_val, "darwin-arm64") do
        out make_target_macos_arm64()
    end
    if rt_streq(str_val, "aarch64-linux") or rt_streq(str_val, "aarch64-unknown-linux-gnu") do
        out make_target_linux_arm64()
    end
    if rt_streq(str_val, "x86_64-linux") or rt_streq(str_val, "x86_64-unknown-linux-gnu") do
        out make_target_linux_x86_64()
    end
    if rt_streq(str_val, "riscv64-linux") or rt_streq(str_val, "riscv64-unknown-linux-gnu") or rt_streq(str_val, "riscv64") or rt_streq(str_val, "riscv") do
        out make_target_linux_riscv64()
    end
    if rt_streq(str_val, "wasm32-wasi") or rt_streq(str_val, "wasm32") or rt_streq(str_val, "wasm") do
        out make_target_wasm32_wasi_p1()
    end
    if rt_streq(str_val, "x86_64-pc-windows") or rt_streq(str_val, "x86_64-windows") or rt_streq(str_val, "win-x64") do
        out make_target_windows_x86_64()
    end
    if rt_streq(str_val, "arm64-pc-windows") or rt_streq(str_val, "arm64-windows") or rt_streq(str_val, "win-arm64") do
        out make_target_windows_arm64()
    end
    if rt_streq(str_val, "macos-x86_64") or rt_streq(str_val, "x86_64-apple-darwin") or rt_streq(str_val, "darwin-x86_64") do
        out target_spec_new("macos-x86_64", TargetArch.X86_64, TargetOS.Darwin, TargetABI.SysV_AMD64, RuntimeProvider.DarwinRawSyscall, ObjectFormat.MachO, AsmDialect.DarwinAsm, 8, 16)
    end

    # 3. Short architecture aliases (resolved against host OS)
    if rt_streq(str_val, "arm64") or rt_streq(str_val, "aarch64") do
        let host = get_host_target_spec()
        if target_spec_is_linux(host) != 0 do
            out make_target_linux_arm64()
        else
            out make_target_macos_arm64()
        end
    end
    if rt_streq(str_val, "x86_64") or rt_streq(str_val, "x86-64") do
        let host = get_host_target_spec()
        if target_spec_is_darwin(host) != 0 do
            out target_spec_new("macos-x86_64", TargetArch.X86_64, TargetOS.Darwin, TargetABI.SysV_AMD64, RuntimeProvider.DarwinRawSyscall, ObjectFormat.MachO, AsmDialect.DarwinAsm, 8, 16)
        else
            out make_target_linux_x86_64()
        end
    end

    out 0 as TargetSpec
end.
