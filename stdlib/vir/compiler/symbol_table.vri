##
 * vir/compiler/symbol_table.vri
 * ==============================================================
 * Bảng quản lý Danh xưng (Symbol Table) cho Semantic Analysis.
 ##

include vec_rt;
import vec_new_rt, vec_push_rt, vec_get_rt, vec_len_rt from vec_rt;

enum SymbolKind:
    Variable = 0,
    Func     = 1,
    Param    = 2,
    TypeDef  = 3,
    Const    = 4,
    Method   = 5,
    Entity   = 6,
    Enum     = 7,
    Variant  = 8,
    Module   = 9,
    Builtin  = 10
end.
entity SymbolNode:
    kind: SymbolKind,
    name_id: i64,       # InternID
    type_id: i64,       # TypeID
    scope_id: i64,      # ScopeID mà symbol này thuộc về
    ast_id: i64,        # AstID nơi khai báo
    is_mutable: bool,   # Cho Var/Param
    offset: i64,        # Vị trí memory/register (sẽ được gán sau)
    param_count: i64,   # Number of params (for Func/Method)
    return_type: i64,   # Return TypeID (for Func/Method)
    parent_id: i64      # Parent symbol ID (for Method->Entity, Variant->Enum)
end.
entity SymbolTable:
    symbols: i64        # Vec chứa SymbolNode
end.
func symbol_table_new()
    out SymbolTable (
        symbols: vec_new_rt()
    )
end.
func symbol_alloc(tbl: SymbolTable, sym: SymbolNode)
    syms = native_read_i64(tbl as i64, 0)
    id = vec_len_rt(syms)
    syms = vec_push_rt(syms, sym)
    native_write_i64(tbl as i64, 0, syms)
    out id
end.
func symbol_get(tbl: SymbolTable, id: i64)
    syms = native_read_i64(tbl as i64, 0)
    out vec_get_rt(syms, id)
end.
# Tìm symbol theo name_id trong một scope cụ thể
func symbol_lookup_in_scope(tbl: SymbolTable, tree: ScopeTree, scope_id: i64, name_id: i64)
    node = vec_get_rt(tree.scopes, scope_id);
    count = vec_len_rt(node.symbols);
    var i = 0;
    when i < count loop
        sym_id = vec_get_rt(node.symbols, i);
        sym = vec_get_rt(tbl.symbols, sym_id);
        if sym.name_id == name_id do
            out sym_id # Found
        end
        i = i + 1
    end
    out -1 # Not found
end.
# Tìm symbol theo name_id từ scope hiện tại lên trên root
func symbol_lookup(tbl: SymbolTable, tree: ScopeTree, start_scope_id: i64, name_id: i64)
    curr = start_scope_id;
    when curr >= 0 loop
        found = symbol_lookup_in_scope(tbl, tree, curr, name_id);
        if found != -1 do
            out found
        end
        curr = scope_get_parent(tree, curr)
    end
    out -1 # Not found
end.