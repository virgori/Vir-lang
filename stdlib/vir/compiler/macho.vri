##
 * vir/compiler/macho.vri — Mach-O Executable Emitter (Pure Vir)
 * =========================================================
 * Emits a complete Mach-O 64-bit executable for macOS ARM64
 * and x86-64. No external assembler (as) or linker (ld) needed.
 *
 * Produces a standalone binary that the kernel can exec directly
 *   Mach-O Header → Load Commands → __TEXT → __DATA → LC_MAIN
 *
 * The binary uses direct BSD syscalls — no dyld, no libSystem
 * unless linking is explicitly requested.
 ##
module vir.compiler.macho

include types
include vec_rt
import bvec_new, bvec_push, bvec_push_u16_le, bvec_push_u32_le, bvec_push_u64_le,
    bvec_len, bvec_get, bvec_set, bvec_patch_u32_le, bvec_data_ptr, bvec_free from vec_rt
include io
import write_file_bytes from io
include string_rt
import rt_strlen, fat_str_new, fat_str_eq, fat_str_len, fat_str_byte_at from string_rt
include vir.compiler.ffi_imports
import ffi_import_used_count, ffi_import_used_at, ffi_import_name, ffi_import_source, ffi_source_is_os, ffi_arm64_stub_offset from vir.compiler.ffi_imports

# ═══════════════════════════════════════════════════════
# Mach-O Constants
# ═══════════════════════════════════════════════════════

# Magic numbers
const MH_MAGIC_64:      0xFEEDFACF

# CPU types
const CPU_TYPE_X86_64:  0x01000007
const CPU_TYPE_ARM64:   0x0100000C
const CPU_SUB_ALL:      0x00000000
const CPU_SUB_ARM64_ALL: 0x00000000

# File types
const MH_EXECUTE:       2

# Flags
const MH_NOUNDEFS:      0x00000001
const MH_DYLDLINK:      0x00000004
const MH_TWOLEVEL:      0x00000080
const MH_PIE:           0x00200000

# Load command types
const LC_SEGMENT_64:    0x19
const LC_MAIN:          0x80000028
const LC_SYMTAB:        0x02
const LC_DYSYMTAB:      0x0B
const LC_UUID:          0x1B
const LC_BUILD_VERSION: 0x32
const LC_SOURCE_VERSION: 0x2A
const LC_LOAD_DYLIB:    0x0C
const LC_LOAD_DYLINKER: 0x0E
const LC_DYLD_INFO_ONLY: 0x80000022
const LC_DYLD_CHAINED_FIXUPS: 0x80000034

# Segment/section constants
const VM_PROT_READ:     1
const VM_PROT_WRITE:    2
const VM_PROT_EXECUTE:  4

const S_ATTR_PURE_INSTRUCTIONS: 0x80000000
const S_ATTR_SOME_INSTRUCTIONS: 0x00000400
const S_REGULAR:        0x00000000
const S_ZEROFILL:       0x00000001
const S_NON_LAZY_SYMBOL_POINTERS: 0x00000006
const S_SYMBOL_STUBS:   0x00000008

# Page sizes
const PAGE_SIZE_ARM64:  0x4000;     # 16KB
const PAGE_SIZE_X86:    0x1000;     # 4KB
const TEXT_BASE:        0x100000000

# FFI constants
const MACHO_FFI_CODE_OFFSET: 16384

# ═══════════════════════════════════════════════════════
# Mach-O Builder
# ═══════════════════════════════════════════════════════

entity MachOBuilder:
    buf: i64;        # bvec byte buffer
    macho_arch: i64;        # 0=ARM64, 1=x86_64
    page_size: i64;
    text_code: i64;        # bvec with machine code
    data_bytes: i64;        # bvec with data section
    entry_offset: i64        # offset of _start in __text
end.

func macho_new(arch: i64):
    let page = PAGE_SIZE_ARM64
    if arch == 1 do
        page = PAGE_SIZE_X86
    end
    out MachOBuilder(buf: bvec_new(),
        macho_arch: arch,
        page_size: page,
        text_code: bvec_new(),
        data_bytes: bvec_new(),
        entry_offset: 0)
end.

# ═══════════════════════════════════════════════════════
# Write Header
# ═══════════════════════════════════════════════════════

func macho_write_header(b: MachOBuilder, ncmds: i64, sizeofcmds: i64):
    let buf = b.buf

    # MH_MAGIC_64
    buf = bvec_push_u32_le(buf, MH_MAGIC_64)

    # cputype
    if b.macho_arch == 0 do
        buf = bvec_push_u32_le(buf, CPU_TYPE_ARM64)
        buf = bvec_push_u32_le(buf, CPU_SUB_ARM64_ALL)
    else
        buf = bvec_push_u32_le(buf, CPU_TYPE_X86_64)
        buf = bvec_push_u32_le(buf, CPU_SUB_ALL)
    end

    # filetype: MH_EXECUTE
    buf = bvec_push_u32_le(buf, MH_EXECUTE)

    # ncmds, sizeofcmds
    buf = bvec_push_u32_le(buf, ncmds)
    buf = bvec_push_u32_le(buf, sizeofcmds)

    # flags: MH_NOUNDEFS | MH_DYLDLINK | MH_TWOLEVEL | MH_PIE
    let flags = MH_NOUNDEFS or MH_DYLDLINK or MH_TWOLEVEL or MH_PIE
    buf = bvec_push_u32_le(buf, flags)

    # reserved
    buf = bvec_push_u32_le(buf, 0)

    b.buf = buf
    out b
end.

func macho_write_dynamic_header(b: MachOBuilder, ncmds: i64, sizeofcmds: i64):
    let buf = b.buf
    buf = bvec_push_u32_le(buf, MH_MAGIC_64)
    if b.macho_arch == 0 do
        buf = bvec_push_u32_le(buf, CPU_TYPE_ARM64)
        buf = bvec_push_u32_le(buf, CPU_SUB_ARM64_ALL)
    else
        buf = bvec_push_u32_le(buf, CPU_TYPE_X86_64)
        buf = bvec_push_u32_le(buf, CPU_SUB_ALL)
    end
    buf = bvec_push_u32_le(buf, MH_EXECUTE)
    buf = bvec_push_u32_le(buf, ncmds)
    buf = bvec_push_u32_le(buf, sizeofcmds)
    let flags = MH_NOUNDEFS or MH_DYLDLINK or MH_TWOLEVEL or MH_PIE
    buf = bvec_push_u32_le(buf, flags)
    buf = bvec_push_u32_le(buf, 0)
    b.buf = buf
    out b
end.

# ═══════════════════════════════════════════════════════
# Write Segments & Sections
# ═══════════════════════════════════════════════════════

func macho_write_segment(b: MachOBuilder, name: i64, vmaddr: i64, vmsize: i64,
       fileoff: i64, filesize: i64, maxprot: i64, initprot: i64,
       nsects: i64):
    let buf = b.buf

    # cmd
    buf = bvec_push_u32_le(buf, LC_SEGMENT_64)

    # cmdsize: 72 + nsects * 80
    let cmdsize = 72 + nsects * 80
    buf = bvec_push_u32_le(buf, cmdsize)

    # segname (16 bytes, null-padded)
    extern func native_read_u8(addr: i64, offset: i64) -> i64
    let name_len = rt_strlen(name)
    var i = 0
    when i < 16 loop
        if i < name_len do
            buf = bvec_push(buf, native_read_u8(name, i))
        else
            buf = bvec_push(buf, 0)
        end
        i = i + 1
    end

    # vmaddr, vmsize
    buf = bvec_push_u64_le(buf, vmaddr)
    buf = bvec_push_u64_le(buf, vmsize)

    # fileoff, filesize
    buf = bvec_push_u64_le(buf, fileoff)
    buf = bvec_push_u64_le(buf, filesize)

    # maxprot, initprot
    buf = bvec_push_u32_le(buf, maxprot)
    buf = bvec_push_u32_le(buf, initprot)

    # nsects, flags
    buf = bvec_push_u32_le(buf, nsects)
    buf = bvec_push_u32_le(buf, 0)

    b.buf = buf
    out b
end.

func macho_write_section(b: MachOBuilder, sectname: i64, segname: i64,
       addr: i64, size: i64, offset: i64, align: i64,
       flags: i64):
    let buf = b.buf

    extern func native_read_u8(addr: i64, offset: i64) -> i64

    # sectname (16 bytes)
    let sname_len = rt_strlen(sectname)
    var i = 0
    when i < 16 loop
        if i < sname_len do
            buf = bvec_push(buf, native_read_u8(sectname, i))
        else
            buf = bvec_push(buf, 0)
        end
        i = i + 1
    end

    # segname (16 bytes)
    let gname_len = rt_strlen(segname)
    i = 0
    when i < 16 loop
        if i < gname_len do
            buf = bvec_push(buf, native_read_u8(segname, i))
        else
            buf = bvec_push(buf, 0)
        end
        i = i + 1
    end

    # addr, size
    buf = bvec_push_u64_le(buf, addr)
    buf = bvec_push_u64_le(buf, size)

    # offset, align
    buf = bvec_push_u32_le(buf, offset)
    buf = bvec_push_u32_le(buf, align)

    # reloff, nreloc
    buf = bvec_push_u32_le(buf, 0)
    buf = bvec_push_u32_le(buf, 0)

    # flags
    buf = bvec_push_u32_le(buf, flags)

    # reserved1, reserved2, reserved3
    buf = bvec_push_u32_le(buf, 0)
    buf = bvec_push_u32_le(buf, 0)
    buf = bvec_push_u32_le(buf, 0)

    b.buf = buf
    out b
end.

func macho_write_lc_main(b: MachOBuilder, entryoff: i64):
    let buf = b.buf

    buf = bvec_push_u32_le(buf, LC_MAIN)
    buf = bvec_push_u32_le(buf, 24);           # cmdsize
    buf = bvec_push_u64_le(buf, entryoff);      # entryoff (file offset of entry)
    buf = bvec_push_u64_le(buf, 0);             # stacksize (0 = default)

    b.buf = buf
    out b
end.

func macho_push_uleb(v: i64, value: i64):
    var n = value
    when n >= 128 loop
        v = bvec_push(v, (n mod 128) or 0x80)
        n = n / 128
    end
    out bvec_push(v, n)
end.

func macho_ffi_library_for_source(source: string):
    if ffi_source_is_os(source) == 1 do out fat_str_new("/usr/lib/libSystem.B.dylib") end
    out source
end.

func macho_ffi_library_index(libs: i64, library: string):
    var i = 0
    when i < vec_len_rt(libs) loop
        if fat_str_eq(vec_get_rt(libs, i) as string, library) == 1 do out i end
        i = i + 1
    end
    out 0 - 1
end.

func macho_write_section_indirect(b: MachOBuilder, sectname: i64, segname: i64,
       addr: i64, size: i64, offset: i64, align: i64,
       flags: i64, indirect_start: i64, stub_size: i64):
    b = macho_write_section(b, sectname, segname, addr, size, offset, align, flags)
    let section_end = bvec_len(b.buf)
    bvec_patch_u32_le(b.buf, section_end - 12, indirect_start)
    bvec_patch_u32_le(b.buf, section_end - 8, stub_size)
    out b
end.

func macho_write_dylib_fat(b: MachOBuilder, path: string):
    let plen = fat_str_len(path)
    let cmdsize = 24 + ((plen + 1 + 7) / 8) * 8
    b.buf = bvec_push_u32_le(b.buf, LC_LOAD_DYLIB)
    b.buf = bvec_push_u32_le(b.buf, cmdsize)
    b.buf = bvec_push_u32_le(b.buf, 24)
    b.buf = bvec_push_u32_le(b.buf, 0)
    b.buf = bvec_push_u32_le(b.buf, 0x00010000)
    b.buf = bvec_push_u32_le(b.buf, 0x00010000)
    var i = 0
    when i < cmdsize - 24 loop
        if i < plen do
            b.buf = bvec_push(b.buf, fat_str_byte_at(path, i))
        else
            b.buf = bvec_push(b.buf, 0)
        end
        i = i + 1
    end
    out b
end.

func macho_emit_ffi(b: MachOBuilder, entry_off_param: i64):
    let nimp = ffi_import_used_count()
    if nimp <= 0 do out b end
    if b.macho_arch != 0 do out b end

    var libs = vec_new_rt()
    var ii = 0
    when ii < nimp loop
        import_id = ffi_import_used_at(ii)
        lib = macho_ffi_library_for_source(ffi_import_source(import_id))
        if macho_ffi_library_index(libs, lib) < 0 do libs = vec_push_rt(libs, lib) end
        ii = ii + 1
    end
    let nlibs = vec_len_rt(libs)

    var bind = bvec_new()
    ii = 0
    when ii < nimp loop
        import_id = ffi_import_used_at(ii)
        name = ffi_import_name(import_id)
        lib = macho_ffi_library_for_source(ffi_import_source(import_id))
        ord = macho_ffi_library_index(libs, lib) + 1
        bind = bvec_push(bind, 0x10 or ord)
        bind = bvec_push(bind, 0x40)
        bind = bvec_push(bind, 95)
        var ni = 0
        when ni < fat_str_len(name) loop
            bind = bvec_push(bind, fat_str_byte_at(name, ni))
            ni = ni + 1
        end
        bind = bvec_push(bind, 0)
        bind = bvec_push(bind, 0x51)
        bind = bvec_push(bind, 0x72)
        bind = macho_push_uleb(bind, ii * 8)
        bind = bvec_push(bind, 0x90)
        ii = ii + 1
    end
    bind = bvec_push(bind, 0)
    let bind_size = bvec_len(bind)

    var str_size = 1
    ii = 0
    when ii < nimp loop
        str_size = str_size + 2 + fat_str_len(ffi_import_name(ffi_import_used_at(ii)))
        ii = ii + 1
    end

    var dylib_cmd_bytes = 0
    ii = 0
    when ii < nlibs loop
        dylib_cmd_bytes = dylib_cmd_bytes + 24 + ((fat_str_len(vec_get_rt(libs, ii) as string) + 1 + 7) / 8) * 8
        ii = ii + 1
    end
    let ncmds = 10 + nlibs
    let sizeofcmds = 840 + dylib_cmd_bytes
    let code_offset = MACHO_FFI_CODE_OFFSET
    let code_size = bvec_len(b.text_code)
    let stub_start = ffi_arm64_stub_offset(ffi_import_used_at(0))
    let stubs_size = nimp * 12
    let entry_file_offset = code_offset + entry_off_param
    let text_raw = code_offset + code_size
    let text_size = ((text_raw + b.page_size - 1) / b.page_size) * b.page_size
    let data_fileoff = text_size
    let data_size = b.page_size
    let linkedit_fileoff = data_fileoff + data_size
    let symoff = linkedit_fileoff + bind_size
    let indirectoff = symoff + nimp * 16
    let stroff = indirectoff + nimp * 4
    let linkedit_size = bind_size + nimp * 16 + nimp * 4 + str_size
    let linkedit_vmsize = ((linkedit_size + b.page_size - 1) / b.page_size) * b.page_size
    let text_vm = TEXT_BASE
    let data_vm = TEXT_BASE + data_fileoff
    let linkedit_vm = TEXT_BASE + linkedit_fileoff

    ii = 0
    when ii < nimp loop
        import_id = ffi_import_used_at(ii)
        stub = ffi_arm64_stub_offset(import_id)
        pc = TEXT_BASE + code_offset + stub
        target = data_vm + ii * 8
        delta_pages = ((target and (0 - 4096)) - (pc and (0 - 4096))) / 4096
        page_imm = delta_pages and 0x1FFFFF
        adrp = 0x90000010 or ((page_imm and 3) shl 29) or (((page_imm shr 2) and 0x7FFFF) shl 5)
        ldr = 0xF9400210 or (((target and 0xFFF) / 8) shl 10)
        bvec_patch_u32_le(b.text_code, stub, adrp)
        bvec_patch_u32_le(b.text_code, stub + 4, ldr)
        ii = ii + 1
    end

    b = macho_write_dynamic_header(b, ncmds, sizeofcmds)
    b = macho_write_segment(b, "__PAGEZERO", 0, TEXT_BASE, 0, 0, 0, 0, 0)
    b = macho_write_segment(b, "__TEXT", text_vm, text_size, 0, text_size,
                            VM_PROT_READ or VM_PROT_EXECUTE, VM_PROT_READ or VM_PROT_EXECUTE, 3)
    b = macho_write_section(b, "__text", "__TEXT", text_vm + code_offset, stub_start, code_offset, 2,
                            S_ATTR_PURE_INSTRUCTIONS or S_ATTR_SOME_INSTRUCTIONS)
    b = macho_write_section_indirect(b, "__stubs", "__TEXT", text_vm + code_offset + stub_start,
                            stubs_size, code_offset + stub_start, 2, S_SYMBOL_STUBS or S_ATTR_PURE_INSTRUCTIONS,
                            0, 12)
    let tail_off = stub_start + stubs_size
    let tail_size = code_size - tail_off
    b = macho_write_section(b, "__const", "__TEXT", text_vm + code_offset + tail_off,
                            tail_size, code_offset + tail_off, 2, S_REGULAR)
    b = macho_write_segment(b, "__DATA", data_vm, data_size, data_fileoff, data_size,
                            VM_PROT_READ or VM_PROT_WRITE, VM_PROT_READ or VM_PROT_WRITE, 1)
    b = macho_write_section_indirect(b, "__la_symbol_ptr", "__DATA", data_vm, nimp * 8,
                            data_fileoff, 3, S_NON_LAZY_SYMBOL_POINTERS, 0, 0)
    b = macho_write_segment(b, "__LINKEDIT", linkedit_vm, linkedit_vmsize,
                            linkedit_fileoff, linkedit_size, VM_PROT_READ, VM_PROT_READ, 0)

    b.buf = bvec_push_u32_le(b.buf, LC_DYLD_INFO_ONLY)
    b.buf = bvec_push_u32_le(b.buf, 48)
    b.buf = bvec_push_u32_le(b.buf, 0); b.buf = bvec_push_u32_le(b.buf, 0)
    b.buf = bvec_push_u32_le(b.buf, linkedit_fileoff); b.buf = bvec_push_u32_le(b.buf, bind_size)
    var zi = 0
    when zi < 6 loop b.buf = bvec_push_u32_le(b.buf, 0); zi = zi + 1 end
    b.buf = bvec_push_u32_le(b.buf, LC_SYMTAB); b.buf = bvec_push_u32_le(b.buf, 24)
    b.buf = bvec_push_u32_le(b.buf, symoff); b.buf = bvec_push_u32_le(b.buf, nimp)
    b.buf = bvec_push_u32_le(b.buf, stroff); b.buf = bvec_push_u32_le(b.buf, str_size)
    b.buf = bvec_push_u32_le(b.buf, LC_DYSYMTAB); b.buf = bvec_push_u32_le(b.buf, 80)
    b.buf = bvec_push_u32_le(b.buf, 0); b.buf = bvec_push_u32_le(b.buf, 0)
    b.buf = bvec_push_u32_le(b.buf, 0); b.buf = bvec_push_u32_le(b.buf, 0)
    b.buf = bvec_push_u32_le(b.buf, 0); b.buf = bvec_push_u32_le(b.buf, nimp)
    zi = 0
    when zi < 6 loop b.buf = bvec_push_u32_le(b.buf, 0); zi = zi + 1 end
    b.buf = bvec_push_u32_le(b.buf, indirectoff); b.buf = bvec_push_u32_le(b.buf, nimp)
    b.buf = bvec_push_u32_le(b.buf, 0); b.buf = bvec_push_u32_le(b.buf, 0)
    b.buf = bvec_push_u32_le(b.buf, 0); b.buf = bvec_push_u32_le(b.buf, 0)
    b.buf = bvec_push_u32_le(b.buf, LC_LOAD_DYLINKER); b.buf = bvec_push_u32_le(b.buf, 32)
    b.buf = bvec_push_u32_le(b.buf, 12)
    let dyld_path = "/usr/lib/dyld"
    zi = 0
    when zi < 20 loop
        if zi < 13 do b.buf = bvec_push(b.buf, native_read_u8(dyld_path, zi)) else b.buf = bvec_push(b.buf, 0) end
        zi = zi + 1
    end
    b.buf = bvec_push_u32_le(b.buf, LC_UUID); b.buf = bvec_push_u32_le(b.buf, 24)
    zi = 1
    when zi <= 16 loop b.buf = bvec_push(b.buf, zi); zi = zi + 1 end
    b = macho_write_lc_main(b, entry_file_offset)
    ii = 0
    when ii < nlibs loop b = macho_write_dylib_fat(b, vec_get_rt(libs, ii) as string); ii = ii + 1 end

    var cur = bvec_len(b.buf)
    when cur < code_offset loop b.buf = bvec_push(b.buf, 0); cur = cur + 1 end
    ii = 0
    when ii < code_size loop b.buf = bvec_push(b.buf, bvec_get(b.text_code, ii)); ii = ii + 1 end
    cur = bvec_len(b.buf)
    when cur < data_fileoff loop b.buf = bvec_push(b.buf, 0); cur = cur + 1 end
    ii = 0
    when ii < nimp loop b.buf = bvec_push_u64_le(b.buf, 0); ii = ii + 1 end
    cur = bvec_len(b.buf)
    when cur < linkedit_fileoff loop b.buf = bvec_push(b.buf, 0); cur = cur + 1 end
    ii = 0
    when ii < bind_size loop b.buf = bvec_push(b.buf, bvec_get(bind, ii)); ii = ii + 1 end
    var strx = 1
    ii = 0
    when ii < nimp loop
        b.buf = bvec_push_u32_le(b.buf, strx); b.buf = bvec_push(b.buf, 1)
        b.buf = bvec_push(b.buf, 0); b.buf = bvec_push_u16_le(b.buf, 0); b.buf = bvec_push_u64_le(b.buf, 0)
        strx = strx + 2 + fat_str_len(ffi_import_name(ffi_import_used_at(ii)))
        ii = ii + 1
    end
    ii = 0
    when ii < nimp loop b.buf = bvec_push_u32_le(b.buf, ii); ii = ii + 1 end
    b.buf = bvec_push(b.buf, 0)
    ii = 0
    when ii < nimp loop
        name = ffi_import_name(ffi_import_used_at(ii))
        b.buf = bvec_push(b.buf, 95)
        var ni = 0
        when ni < fat_str_len(name) loop b.buf = bvec_push(b.buf, fat_str_byte_at(name, ni)); ni = ni + 1 end
        b.buf = bvec_push(b.buf, 0)
        ii = ii + 1
    end
    out b
end.

func macho_emit(b: MachOBuilder, entry_off_param: i64):
    if ffi_import_used_count() > 0 and b.macho_arch == 0 do
        out macho_emit_ffi(b, entry_off_param)
    end
    let page = b.page_size
    let code_size = bvec_len(b.text_code)

    let ncmds = 10
    let sizeofcmds = 552
    let header_end = 32 + sizeofcmds

    let code_offset = header_end + 32
    let entry_file_offset = code_offset + entry_off_param

    let text_raw_size = code_offset + code_size
    let text_segment_size = ((text_raw_size + page - 1) / page) * page

    let chained_fixups_size = 48
    let string_table_size = 4
    let linkedit_data_size = chained_fixups_size + string_table_size
    let linkedit_fileoff = text_segment_size
    let linkedit_vmaddr = TEXT_BASE + text_segment_size
    let strtab_off = linkedit_fileoff + chained_fixups_size

    b = macho_write_header(b, ncmds, sizeofcmds)
    b = macho_write_segment(b, "__PAGEZERO", 0, TEXT_BASE, 0, 0, 0, 0, 0)
    b = macho_write_segment(b, "__TEXT",
                            TEXT_BASE, text_segment_size,
                            0, text_segment_size,
                            VM_PROT_READ or VM_PROT_WRITE or VM_PROT_EXECUTE,
                            VM_PROT_READ or VM_PROT_EXECUTE,
                            1)
    b = macho_write_section(b, "__text", "__TEXT",
                            TEXT_BASE + code_offset, code_size, code_offset,
                            2,
                            S_ATTR_PURE_INSTRUCTIONS or S_ATTR_SOME_INSTRUCTIONS)
    b = macho_write_segment(b, "__LINKEDIT",
                            linkedit_vmaddr, page,
                            linkedit_fileoff, linkedit_data_size,
                            VM_PROT_READ,
                            VM_PROT_READ,
                            0)

    b.buf = bvec_push_u32_le(b.buf, LC_DYLD_CHAINED_FIXUPS)
    b.buf = bvec_push_u32_le(b.buf, 16)
    b.buf = bvec_push_u32_le(b.buf, linkedit_fileoff)
    b.buf = bvec_push_u32_le(b.buf, chained_fixups_size)

    b.buf = bvec_push_u32_le(b.buf, LC_SYMTAB)
    b.buf = bvec_push_u32_le(b.buf, 24)
    b.buf = bvec_push_u32_le(b.buf, strtab_off)
    b.buf = bvec_push_u32_le(b.buf, 0)
    b.buf = bvec_push_u32_le(b.buf, strtab_off)
    b.buf = bvec_push_u32_le(b.buf, string_table_size)

    b.buf = bvec_push_u32_le(b.buf, LC_DYSYMTAB)
    b.buf = bvec_push_u32_le(b.buf, 80)
    var dsi = 0
    when dsi < 18 loop
        b.buf = bvec_push_u32_le(b.buf, 0)
        dsi = dsi + 1
    end

    b.buf = bvec_push_u32_le(b.buf, LC_LOAD_DYLINKER)
    b.buf = bvec_push_u32_le(b.buf, 32)
    b.buf = bvec_push_u32_le(b.buf, 12)
    extern func native_read_u8(addr: i64, offset: i64) -> i64
    let dyld_path = "/usr/lib/dyld"
    let dyld_len = 13
    var di = 0
    when di < 20 loop
        if di < dyld_len do
            b.buf = bvec_push(b.buf, native_read_u8(dyld_path as i64, di))
        else
            b.buf = bvec_push(b.buf, 0)
        end
        di = di + 1
    end

    b.buf = bvec_push_u32_le(b.buf, LC_UUID)
    b.buf = bvec_push_u32_le(b.buf, 24)
    var ui = 1
    when ui <= 16 loop
        b.buf = bvec_push(b.buf, ui)
        ui = ui + 1
    end

    b = macho_write_lc_main(b, entry_file_offset)

    b.buf = bvec_push_u32_le(b.buf, LC_LOAD_DYLIB)
    b.buf = bvec_push_u32_le(b.buf, 56)
    b.buf = bvec_push_u32_le(b.buf, 24)
    b.buf = bvec_push_u32_le(b.buf, 0)
    b.buf = bvec_push_u32_le(b.buf, 0x00010000)
    b.buf = bvec_push_u32_le(b.buf, 0x00010000)
    let dylib_path = "/usr/lib/libSystem.B.dylib"
    let dylib_len = 26
    var dli = 0
    when dli < 32 loop
        if dli < dylib_len do
            b.buf = bvec_push(b.buf, native_read_u8(dylib_path as i64, dli))
        else
            b.buf = bvec_push(b.buf, 0)
        end
        dli = dli + 1
    end

    var current = bvec_len(b.buf)
    when current < code_offset loop
        b.buf = bvec_push(b.buf, 0)
        current = current + 1
    end

    var i = 0
    when i < code_size loop
        b.buf = bvec_push(b.buf, bvec_get(b.text_code, i))
        i = i + 1
    end

    current = bvec_len(b.buf)
    when current < text_segment_size loop
        b.buf = bvec_push(b.buf, 0)
        current = current + 1
    end

    let link_buf = b.buf
    link_buf = bvec_push_u32_le(link_buf, 0)
    link_buf = bvec_push_u32_le(link_buf, 28)
    link_buf = bvec_push_u32_le(link_buf, 44)
    link_buf = bvec_push_u32_le(link_buf, 44)
    link_buf = bvec_push_u32_le(link_buf, 0)
    link_buf = bvec_push_u32_le(link_buf, 1)
    link_buf = bvec_push_u32_le(link_buf, 0)

    link_buf = bvec_push_u32_le(link_buf, 3)
    link_buf = bvec_push_u32_le(link_buf, 0)
    link_buf = bvec_push_u32_le(link_buf, 0)
    link_buf = bvec_push_u32_le(link_buf, 0)

    link_buf = bvec_push_u32_le(link_buf, 0)
    link_buf = bvec_push_u32_le(link_buf, 0)
    b.buf = link_buf

    out b
end.

func macho_write_to_file(b: MachOBuilder, path: i64):
    let eo = b.entry_offset
    b = macho_emit(b, eo)
    let data = bvec_data_ptr(b.buf)
    let size = bvec_len(b.buf)
    write_file_bytes(path, data, size, 493)
    out true
end.
