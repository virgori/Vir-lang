##
 * vir/compiler/semantic.vri
 * ==============================================================
 * Bộ Phân tích Ngữ nghĩa (Semantic Analyzer) — Orchestrator.
 *
 * Điều phối các pass theo thứ tự:
 *   Pass 2: Symbol Registration
 *   Pass 3: Name Resolution
 *   Pass 6: Type Checking
 *   Pass 10: Diagnostics Emission
 *
 * Trả về error_count. Nếu > 0, pipeline PHẢI dừng trước codegen.
 ##

include context;
import CompilerContext, DiagnosticEngine, diagnostic_engine_new, has_errors from context;

include parser;
import AstNode, AstType from parser;

include type_table;
import TypeTable, type_table_new from type_table;

include scope_tree;
import ScopeTree, ScopeKind, scope_tree_new from scope_tree;

include symbol_table;
import SymbolTable, symbol_table_new from symbol_table;

include sem_pass2_symbols;
import pass2_register_symbols from sem_pass2_symbols;

include sem_pass3_names;
import pass3_resolve_names from sem_pass3_names;

include sem_pass6_typecheck;
import pass6_typecheck from sem_pass6_typecheck;

include sem_pass10_diagnostics;
import pass10_emit_diagnostics from sem_pass10_diagnostics;

func semantic_run(ast: AstNode, source_path: string, verbose: int)
    # Initialize subsystems
    let types = type_table_new();
    let symbols = symbol_table_new();
    let scopes = scope_tree_new();
    let diag = diagnostic_engine_new();

    # ── Pass 2: Symbol Registration ──
    # Register all top-level declarations (func, entity, enum, var, const)
    if verbose == 1 do
        print_ln("virc: semantic pass 2 — symbol registration")
    end
    pass2_register_symbols(symbols, scopes, diag, ast);

    # ── Pass 3: Name Resolution ──
    # Resolve identifiers, function calls, enum accesses
    if verbose == 1 do
        print_ln("virc: semantic pass 3 — name resolution")
    end
    # Reset scope to global before pass 3 (pass 2 only touches global scope)
    scopes.current_id = 0;
    pass3_resolve_names(symbols, scopes, diag, ast);

    # ── Pass 6: Type Checking ──
    # Validate operator types, assignment mutability, L-values
    if verbose == 1 do
        print_ln("virc: semantic pass 6 — type checking")
    end
    scopes.current_id = 0;
    pass6_typecheck(symbols, scopes, diag, ast);

    # ── Pass 10: Diagnostics Emission ──
    let err_count = pass10_emit_diagnostics(diag, source_path);

    if verbose == 1 do
        if err_count == 0 do
            print_ln("virc: semantic analysis passed")
        else
            let sb = sb_new();
            sb = sb_append(sb, "virc: semantic analysis found ");
            sb = sb_append_int(sb, err_count);
            sb = sb_append(sb, " error(s)");
            print_ln(sb_to_string(sb));
            sb_free(sb)
        end
    end

    out err_count
end.

export semantic_run