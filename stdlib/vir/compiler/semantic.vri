##
 * vir/compiler/semantic.vri
 * ==============================================================
 * Bộ Phân tích Ngữ nghĩa (Semantic Analyzer).
 * Có nhiệm vụ: Type Checking, Scoping, Symbol Resolution.
 ##

include context;
import CompilerContext from context;

include parser;
import AstType from parser;

include type_table;
import TypeTable, TYPE_VOID, TYPE_INT, TYPE_FLOAT, TYPE_BOOL, TYPE_STRING, type_alloc, type_get from type_table;

include scope_tree;
import ScopeTree, ScopeKind, scope_push, scope_pop, scope_add_symbol from scope_tree;

include symbol_table;
import SymbolTable, SymbolKind, SymbolNode, symbol_alloc, symbol_lookup, symbol_lookup_in_scope from symbol_table;

func semantic_analyze(ctx: CompilerContext, node_id: i64)
    # Hàm đệ quy duyệt AST, trả về TypeID của Node đó.
    # Trả về TYPE_VOID (0) nếu node là statement không có giá trị trả về.
    
    if node_id == 0 do
        out TYPE_VOID
    end
    
    node = ast_arena_get(ctx.ast_arena, node_id);
    typ = node.typ;
    
    if typ == AstType.Block do
        scope_id = scope_push(ctx.scopes, ScopeKind.Block);
        
        var last_type = TYPE_VOID;
        count = vec_len_rt(node.children);
        var i = 0;
        when i < count loop
            child_id = vec_get_rt(node.children, i);
            last_type = semantic_analyze(ctx, child_id);
            i = i + 1
        end
        
        scope_pop(ctx.scopes);
        out last_type
        
    eif typ == AstType.IntLiteral do
        out TYPE_INT
        
    eif typ == AstType.FloatLiteral do
        out TYPE_FLOAT
        
    eif typ == AstType.StringLiteral do
        out TYPE_STRING
        
    eif typ == AstType.VarDecl do
        # Xử lý khai báo biến
        name_id = node.name;
        
        # 1. Báo lỗi nếu biến đã tồn tại trong cùng scope
        existing = symbol_lookup_in_scope(ctx.symbols, ctx.scopes, ctx.scopes.current_id, name_id);
        if existing != -1 do
            report_error(ctx.diagnostics, 1001, node.line, 0) # 1001: Redefined variable
        else
            # 2. Cảnh báo (Warning) nếu Shadowing (tồn tại ở scope cha)
            shadowed = symbol_lookup(ctx.symbols, ctx.scopes, ctx.scopes.current_id, name_id);
            if shadowed != -1 do
                # report_warning(...)
                # Mặc định phát warning theo đúng quyết định của user!
                report_error(ctx.diagnostics, 2001, node.line, 0) # Tạm dùng report_error làm warning
            end
            
            # Phân tích biểu thức gán (nếu có)
            var type_id = TYPE_VOID;
            if vec_len_rt(node.children) > 0 do
                val_id = vec_get_rt(node.children, 0);
                type_id = semantic_analyze(ctx, val_id)
            end
            
            # Khởi tạo Symbol
            sym = SymbolNode (
                kind: SymbolKind.Variable,
                name_id: name_id,
                type_id: type_id,
                scope_id: ctx.scopes.current_id,
                ast_id: node_id,
                is_mutable: true,
                offset: 0
            );
            
            sym_id = symbol_alloc(ctx.symbols, sym);
            scope_add_symbol(ctx.scopes, ctx.scopes.current_id, sym_id)
        end
        out TYPE_VOID
        
    eif typ == AstType.Identifier do
        # Xử lý truy cập biến
        name_id = node.name;
        sym_id = symbol_lookup(ctx.symbols, ctx.scopes, ctx.scopes.current_id, name_id);
        if sym_id == -1 do
            report_error(ctx.diagnostics, 1002, node.line, 0); # 1002: Undefined variable
            out TYPE_VOID
        end
        
        sym = symbol_get(ctx.symbols, sym_id);
        out sym.type_id
        
    else
        # Duyệt tiếp các node con mặc định
        count = vec_len_rt(node.children);
        var i = 0;
        when i < count loop
            child_id = vec_get_rt(node.children, i);
            semantic_analyze(ctx, child_id);
            i = i + 1
        end
        out TYPE_VOID
    end
    
    out TYPE_VOID
end