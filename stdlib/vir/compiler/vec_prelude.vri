##
 * Soft-bootstrap prelude for `include vec;` (collections Vec).
 * Soft cannot call `extern` yet — provide a minimal in-process Vec using
 * vir_alloc when available, else a fixed empty handle (len=0).
 ##

include types;
include alloc;

entity Vec:
    data: int;
    len: int;
    cap: int;
end.

func vec_new:
    v = Vec ( data: 0, len: 0, cap: 0 )
    out v
end.

func vec_push:
    in v: Vec;
        item: int
    # Soft stub: do not grow; return vec unchanged (tables stay empty).
    out v
end.

func vec_len:
    in v: Vec
    out v.len
end.

func vec_get:
    in v: Vec;
        i: int
    out 0
end.
