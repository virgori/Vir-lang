##
 * Soft-bootstrap prelude for `include vec;` (collections Vec).
 * Provides a minimal in-process Vec using vir_alloc.
 ##

include types
include alloc

entity Vec:
    data: int
    len: int
    cap: int
end.

func vec_new:
    v = Vec ( data: 0, len: 0, cap: 0 )
    out v
end.

func vec_reserve:
    in  v: Vec
        additional: int

    if (v as i64) == 0 do
        out
    end
    let v_len = native_read_i64(v as i64, 8)
    let v_cap = native_read_i64(v as i64, 16)
    let new_cap = v_len + additional
    if new_cap <= v_cap do
        out
    end
    var target = v_cap * 2
    if target < new_cap do
        target = new_cap
    end
    if target < 16 do
        target = 16
    end
    let new_bytes = target * 8
    let old_data = native_read_i64(v as i64, 0)
    let new_data = vir_alloc(new_bytes)
    if old_data != 0 and v_len > 0 do
        var ci = 0
        when ci < v_len loop
            let word = native_read_i64(old_data, ci * 8)
            let _w = native_write_i64(new_data, ci * 8, word)
            ci = ci + 1
        end
    end
    let _s0 = native_write_i64(v as i64, 0, new_data)
    let _s16 = native_write_i64(v as i64, 16, target)
end.

func vec_push:
    in  v: Vec
        item: int

    if (v as i64) == 0 do
        out v
    end
    vec_reserve(v, 1)
    let v_data = native_read_i64(v as i64, 0)
    let v_len = native_read_i64(v as i64, 8)
    let _w = native_write_i64(v_data, v_len * 8, item)
    let _wl = native_write_i64(v as i64, 8, v_len + 1)
    out v
end.

func vec_len:
    in  v: Vec
    if (v as i64) == 0 do
        out 0
    end
    out native_read_i64(v as i64, 8)
end.

func vec_get:
    in  v: Vec
        i: int
    if (v as i64) == 0 do
        out 0
    end
    let v_len = native_read_i64(v as i64, 8)
    if i < 0 or i >= v_len do
        out 0
    end
    let v_data = native_read_i64(v as i64, 0)
    out native_read_i64(v_data, i * 8)
end.

func vec_set:
    in  v: Vec
        i: int
        val: int
    if (v as i64) != 0 do
        let v_len = native_read_i64(v as i64, 8)
        if i >= 0 and i < v_len do
            let v_data = native_read_i64(v as i64, 0)
            let _w = native_write_i64(v_data, i * 8, val)
        end
    end
    out v
end.
