##
 * vir/codegen/linker.vri — Self-Hosting Linker
 * ==============================================
 * Step 3: Cut the umbilical cord — Vir links its own binaries
 *
 * Resolves symbols, applies relocations, and produces
 * a final executable Mach-O binary without external ld.
 *
 * Pipeline
 *   Object files -> Symbol resolution -> Relocation -> Executable
 ##

include types;
include result;
import Result, Ok, Err from result;
include option;
import Option, Some, None from option;
include "stdlib/vir/rt/string_rt.vri";
import str_new, str_concat, rt_streq, str_len from "stdlib/vir/rt/string_rt.vri";
include vec;
import Vec, vec_new, vec_push, vec_len, vec_get from vec;
include hashmap;
import Map, map_new, map_set, map_get, map_contains from hashmap;
include binary;

# ═══════════════════════════════════════════════════════
# Mach-O Executable Constants
# ═══════════════════════════════════════════════════════

const MH_EXECUTE: 2     # Executable file;
const LC_MAIN: 0x80000028;
const LC_LOAD_DYLIB: 0x0C;
const LC_DYLD_INFO_ONLY: 0x80000022;

# Base addresses (macOS ARM64)
const TEXT_BASE: 0x100000000;
const DATA_BASE: 0x100004000;
const PAGE_SIZE: 0x4000;


# ═══════════════════════════════════════════════════════
# Object File Input
# ═══════════════════════════════════════════════════════

entity ObjectFile:
    name:       string,
        sections:   Vec<Section>,
        symbols:    Vec<Symbol>,
        relocs:     Vec<Relocation>
end
# ═══════════════════════════════════════════════════════
# Resolved Symbol
# ═══════════════════════════════════════════════════════

entity ResolvedSymbol:
    name:           string,
        final_address:  int,
        obj_idx:        int,
        sec_idx:        int,
        is_external:    bool
end
# ═══════════════════════════════════════════════════════
# Linker State
# ═══════════════════════════════════════════════════════

entity Linker:
    objects:        Vec<ObjectFile>,
        symtab:         Map<string, ResolvedSymbol>,
        text_buf:       ByteBuffer,
        data_buf:       ByteBuffer,
        entry_point:    int,
        errors:         Vec<string>
end
func linker_new:
    out Linker (
        objects: vec_new(),
        symtab: map_new(),
        text_buf: buf_new(),
        data_buf: buf_new(),
        entry_point: TEXT_BASE,
        errors: vec_new()
    )
end
# ═══════════════════════════════════════════════════════
# Step 1: Add Object Files
# ═══════════════════════════════════════════════════════

func linker_add_object:
    in(lnk:Linker, obj:ObjectFile)

    vec_push(lnk.objects, obj);
    out lnk
end
# ═══════════════════════════════════════════════════════
# Step 2: Symbol Resolution
# ═══════════════════════════════════════════════════════

func linker_resolve_symbols:
    in(lnk:Linker)

    # First pass: collect all global symbols with their offsets
    text_offset = 0;

    obj_i = 0;
    when obj_i < vec_len(lnk.objects) loop
        obj = vec_get(lnk.objects, obj_i);

        sym_i = 0;
        when sym_i < vec_len(obj.symbols) loop
            sym = vec_get(obj.symbols, sym_i);

            if sym.is_global do
                if map_contains(lnk.symtab, sym.name) do
                    vec_push(lnk.errors, str_concat(str_concat(str_concat("Duplicate symbol: ", sym.name), " in "), obj.name))
                else
                    resolved = ResolvedSymbol (
        name: sym.name,
                        final_address: TEXT_BASE + text_offset + (sym.offset >> int),
                        obj_idx: obj_i,
                        sec_idx: sym.section,
                        is_external: false
                    );
                    map_set(lnk.symtab, sym.name, resolved)
                end
            end

            sym_i = sym_i + 1
        end

        # Accumulate text section sizes
        sec_i = 0;
        when sec_i < vec_len(obj.sections) loop
            sec = vec_get(obj.sections, sec_i);
            if str_eq(sec.name, str_new("__text")) do
                text_offset = text_offset + (buf_size(sec.data) >> int)
            end
            sec_i = sec_i + 1
        end

        obj_i = obj_i + 1
    end

    # Find _main entry point
    main_sym = map_get(lnk.symtab, str_new("_main"));
    if main_sym != None do
        lnk.entry_point = main_sym.final_address
    end

    out lnk
end
# ═══════════════════════════════════════════════════════
# Step 3: Apply Relocations
# ═══════════════════════════════════════════════════════

func linker_apply_relocations:
    in(lnk:Linker)

    obj_i = 0;
    when obj_i < vec_len(lnk.objects) loop
        obj = vec_get(lnk.objects, obj_i);

        sec_i = 0;
        when sec_i < vec_len(obj.sections) loop
            sec = vec_get(obj.sections, sec_i);

            rel_i = 0;
            when rel_i < vec_len(sec.relocs) loop
                reloc = vec_get(sec.relocs, rel_i);
                target_sym = vec_get(obj.symbols, reloc.sym_idx);
                resolved = map_get(lnk.symtab, target_sym.name);

                if resolved == None do
                    vec_push(lnk.errors, str_concat(str_concat(str_concat("Undefined symbol: ", target_sym.name), " referenced in "), obj.name))
                else
                    # Apply relocation based on type
                    if reloc.reloc_type == RelocType.Branch26 do
                        # ARM64 B/BL: 26-bit signed offset (in 4-byte units)
                        pc = TEXT_BASE + (reloc.offset >> int);
                        delta = (resolved.final_address - pc) >> int;
                        imm26 = ((delta shr 2) & 0x03FFFFFF) >> int;
                        # Patch instruction: BL = 0x94000000 | imm26
                        patch_u32(sec.data, reloc.offset >> int,
                                  0x94000000 | imm26)
                    end

                    if reloc.reloc_type == RelocType.Page21 do
                        # ARM64 ADRP: 21-bit page offset
                        pc_page = (TEXT_BASE + (reloc.offset >> int)) & ~0xFFF_u64;
                        sym_page = resolved.final_address & ~0xFFF_u64;
                        page_delta = ((sym_page - pc_page) shr 12) >> int;
                        # Encode immhi:immlo into ADRP instruction
                        immlo = (page_delta & 0x3) >> int;
                        immhi = ((page_delta shr 2) & 0x7FFFF) >> int;
                        insn = 0x90000000_u32 | (immlo << 29) | (immhi << 5);
                        patch_u32(sec.data, reloc.offset >> int, insn)
                    end

                    if reloc.reloc_type == RelocType.PageOff12 do
                        # ARM64 ADD: 12-bit page offset
                        page_off = (resolved.final_address & 0xFFF) >> int;
                        insn = read_u32(sec.data, reloc.offset >> int);
                        insn = (insn & 0xFFC003FF) | (page_off << 10);
                        patch_u32(sec.data, reloc.offset >> int, insn)
                    end

                    if reloc.reloc_type == RelocType.PC32 do
                        # x86-64: 32-bit PC-relative
                        pc = TEXT_BASE + (reloc.offset >> int) + 4;
                        delta = (resolved.final_address - pc) >> int;
                        patch_i32(sec.data, reloc.offset >> int, delta)
                    end
                end

                rel_i = rel_i + 1
            end

            sec_i = sec_i + 1
        end

        obj_i = obj_i + 1
    end
    out lnk
end
# ═══════════════════════════════════════════════════════
# Step 4: Merge Sections
# ═══════════════════════════════════════════════════════

func linker_merge_sections:
    in(lnk:Linker)

    obj_i = 0;
    when obj_i < vec_len(lnk.objects) loop
        obj = vec_get(lnk.objects, obj_i);

        sec_i = 0;
        when sec_i < vec_len(obj.sections) loop
            sec = vec_get(obj.sections, sec_i);

            if str_eq(sec.seg_name, str_new("__TEXT")) do
                lnk.text_buf = buf_write_bytes(lnk.text_buf, sec.data.data);
                # Align to 4 bytes for ARM64 instructions
                lnk.text_buf = buf_align(lnk.text_buf, 4)
            end

            if str_eq(sec.seg_name, str_new("__DATA")) do
                lnk.data_buf = buf_write_bytes(lnk.data_buf, sec.data.data);
                lnk.data_buf = buf_align(lnk.data_buf, 8)
            end

            sec_i = sec_i + 1
        end

        obj_i = obj_i + 1
    end
    out lnk
end
# ═══════════════════════════════════════════════════════
# Step 5: Emit Final Executable
# ═══════════════════════════════════════════════════════

func linker_emit_executable:
    in(lnk:Linker, arch:Arch)

    # Check for errors
    if vec_len(lnk.errors) > 0 do
        msg = str_new("Linker errors:\n");
        i = 0;
        when i < vec_len(lnk.errors) loop
            msg = str_concat(msg, str_concat("  - ", vec_get(lnk.errors, i)));
            i = i + 1
        end
        out Err(msg)
    end

    out_buf = buf_new();

    text_size = buf_size(lnk.text_buf) >> int;
    data_size = buf_size(lnk.data_buf) >> int;

    # Align sizes to page boundaries
    text_filesize = ((text_size + PAGE_SIZE - 1) / PAGE_SIZE) * PAGE_SIZE;
    data_filesize = ((data_size + PAGE_SIZE - 1) / PAGE_SIZE) * PAGE_SIZE;

    # Load commands: __PAGEZERO + __TEXT + __DATA + LC_MAIN + LC_SYMTAB = 5
    ncmds = 5_u32;
    header_and_cmds_size = 32 + 72 + (72 + 80) + (72 + 80) + 24 + 24;

    # ── Mach-O Header ──
    out_buf = buf_write_u32_le(out_buf, MH_MAGIC_64);
    if arch == Arch.ARM64 do
        out_buf = buf_write_u32_le(out_buf, CPU_TYPE_ARM64)
    else
        out_buf = buf_write_u32_le(out_buf, CPU_TYPE_X86_64)
    end
    out_buf = buf_write_u32_le(out_buf, CPU_SUBTYPE_ALL);
    out_buf = buf_write_u32_le(out_buf, MH_EXECUTE);
    out_buf = buf_write_u32_le(out_buf, ncmds);
    out_buf = buf_write_u32_le(out_buf, (header_and_cmds_size - 32) >> int);
    out_buf = buf_write_u32_le(out_buf, 0x00200085)  # MH_PIE | MH_TWOLEVEL | MH_DYLDLINK;
    out_buf = buf_write_u32_le(out_buf, 0)               # reserved;

    # ── LC_SEGMENT_64: __PAGEZERO ──
    out_buf = buf_write_u32_le(out_buf, LC_SEGMENT_64);
    out_buf = buf_write_u32_le(out_buf, 72)         # cmdsize (no sections);
    out_buf = buf_write_string_padded(out_buf, str_new("__PAGEZERO"), 16);
    out_buf = buf_write_u64_le(out_buf, 0)          # vmaddr;
    out_buf = buf_write_u64_le(out_buf, TEXT_BASE)   # vmsize = 4GB;
    out_buf = buf_write_u64_le(out_buf, 0)          # fileoff;
    out_buf = buf_write_u64_le(out_buf, 0)          # filesize;
    out_buf = buf_write_u32_le(out_buf, 0)          # maxprot;
    out_buf = buf_write_u32_le(out_buf, 0)          # initprot;
    out_buf = buf_write_u32_le(out_buf, 0)          # nsects;
    out_buf = buf_write_u32_le(out_buf, 0)          # flags;

    # ── LC_SEGMENT_64: __TEXT ──
    out_buf = macho_emit_segment_cmd(out_buf, str_new("__TEXT"), 1,
                                  0, text_filesize >> int);
    text_sec = section_text();
    text_sec.data = lnk.text_buf;
    out_buf = macho_emit_section_hdr(out_buf, text_sec,
                                  header_and_cmds_size >> int, 0);

    # ── LC_SEGMENT_64: __DATA ──
    out_buf = macho_emit_segment_cmd(out_buf, str_new("__DATA"), 1,
                                  text_filesize >> int, data_filesize >> int);
    data_sec = section_data();
    data_sec.data = lnk.data_buf;
    out_buf = macho_emit_section_hdr(out_buf, data_sec,
                                  ((header_and_cmds_size >> int) + text_filesize) >> int, 0);

    # ── LC_MAIN ──
    out_buf = buf_write_u32_le(out_buf, LC_MAIN);
    out_buf = buf_write_u32_le(out_buf, 24)                        # cmdsize;
    out_buf = buf_write_u64_le(out_buf, lnk.entry_point - TEXT_BASE)  # entryoff;
    out_buf = buf_write_u64_le(out_buf, 0)                         # stacksize (default);

    # ── LC_SYMTAB (empty for minimal executable) ──
    out_buf = macho_emit_symtab_cmd(out_buf, 0, 0, 0, 0);

    # Pad header to page boundary
    pad_needed = (text_filesize >> int) - (buf_size(out_buf));
    if pad_needed > 0 do
        out_buf = buf_write_zeros(out_buf, pad_needed >> int)
    end

    # Write __TEXT data
    out_buf = buf_write_bytes(out_buf, lnk.text_buf.data);
    # Pad to page
    text_pad = (text_filesize >> int) - (buf_size(lnk.text_buf));
    if text_pad > 0 do
        out_buf = buf_write_zeros(out_buf, text_pad >> int)
    end

    # Write __DATA data
    out_buf = buf_write_bytes(out_buf, lnk.data_buf.data);
    data_pad = (data_filesize >> int) - (buf_size(lnk.data_buf));
    if data_pad > 0 do
        out_buf = buf_write_zeros(out_buf, data_pad >> int)
    end

    out Ok(out_buf)
end
# ═══════════════════════════════════════════════════════
# High-Level API — Link and Produce Executable
# ═══════════════════════════════════════════════════════

func link_objects:
    in(objects:Vec<ObjectFile>, arch:Arch)

    lnk = linker_new();

    # Add all objects
    i = 0;
    when i < vec_len(objects) loop
        lnk = linker_add_object(lnk, vec_get(objects, i));
        i = i + 1
    end

    # Pipeline: resolve -> relocate -> merge -> emit
    lnk = linker_resolve_symbols(lnk);
    lnk = linker_apply_relocations(lnk);
    lnk = linker_merge_sections(lnk);

    out linker_emit_executable(lnk, arch)
end
func link_single_kernel:
    in(kernel_name:string, code:Vec<int>, arch:Arch)

    # Convenience: wrap raw machine code into an object and link
    obj = ObjectFile (
        name: str_concat(kernel_name, ".o"),
        sections: vec_new(),
        symbols: vec_new(),
        relocs: vec_new()
    );

    text = section_text();
    text.data = buf_new();
    text.data = buf_write_bytes(text.data, code);
    vec_push(obj.sections, text);

    vec_push(obj.symbols, Symbol (
        name: str_new("_main"),
        sym_type: SymbolType.Function,
        section: 1,
        offset: 0,
        size: vec_len(code) >> int,
        is_global: true
    ));

    objects = vec_new();
    vec_push(objects, obj);
    out link_objects(objects, arch)
end