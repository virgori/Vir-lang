    cb = codebuf_emit_byte(cb, 0xF3)
    cb = codebuf_emit_byte(cb, 0x0F)
    cb = codebuf_emit_byte(cb, 0x59)
    out codebuf_emit_byte(cb, x86_modrm(3, dst_xmm, src_xmm))
end.

