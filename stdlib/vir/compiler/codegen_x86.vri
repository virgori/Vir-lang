##
 * vir/compiler/codegen_x86.vri — x86_64 Binary Instruction Emitters
 * ==================================================================
 * Ported from core/src/codegen.c (hand-coded REX + opcode bytes).
 * Register IDs match codegen.h: RAX=0 .. R15=15.
 ##

include types
include compiler.codegen
import CodeBuf, codebuf_emit_byte, codebuf_emit_u32, codebuf_emit_u64, codebuf_emit_i32 from compiler.codegen

# ── Register constants (codegen.h) ──
const X86_RAX  = 0
const X86_RCX  = 1
const X86_RDX  = 2
const X86_RBX  = 3
const X86_RSP  = 4
const X86_RBP  = 5
const X86_RSI  = 6
const X86_RDI  = 7
const X86_R8   = 8
const X86_R9   = 9
const X86_R10  = 10
const X86_R11  = 11
const X86_R12  = 12
const X86_R13  = 13
const X86_R14  = 14
const X86_R15  = 15

# SysV AMD64 argument registers (SetArg order): RDI, RSI, RDX, RCX, R8, R9

func x86_arg_reg(idx: int):
    if idx == 0 do out X86_RDI end
    if idx == 1 do out X86_RSI end
    if idx == 2 do out X86_RDX end
    if idx == 3 do out X86_RCX end
    if idx == 4 do out X86_R8 end
    if idx == 5 do out X86_R9 end
    out X86_RAX
end.

func x86_rex_w(r: int, rm: int):
    var rex = 0x48
    if r >= X86_R8 do
        rex = rex bit_or 0x04
    end
    if rm >= X86_R8 do
        rex = rex bit_or 0x01
    end
    out rex
end.

func x86_modrm(mod_bits: int, reg: int, rm: int):
    v = (mod_bits shl 6) bit_or ((reg bit_and 7) shl 3)
    out v bit_or (rm bit_and 7)
end.

func x86_emit_add_rr(cb: CodeBuf, dst: int, src: int):
    cb = codebuf_emit_byte(cb, x86_rex_w(src, dst))
    cb = codebuf_emit_byte(cb, 0x01)
    out codebuf_emit_byte(cb, x86_modrm(3, src, dst))
end.

func x86_emit_sub_rr(cb: CodeBuf, dst: int, src: int):
    cb = codebuf_emit_byte(cb, x86_rex_w(src, dst))
    cb = codebuf_emit_byte(cb, 0x29)
    out codebuf_emit_byte(cb, x86_modrm(3, src, dst))
end.

func x86_emit_imul_rr(cb: CodeBuf, dst: int, src: int):
    cb = codebuf_emit_byte(cb, x86_rex_w(dst, src))
    cb = codebuf_emit_byte(cb, 0x0F)
    cb = codebuf_emit_byte(cb, 0xAF)
    out codebuf_emit_byte(cb, x86_modrm(3, dst, src))
end.

func x86_emit_mov_rr(cb: CodeBuf, dst: int, src: int):
    cb = codebuf_emit_byte(cb, x86_rex_w(src, dst))
    cb = codebuf_emit_byte(cb, 0x89)
    out codebuf_emit_byte(cb, x86_modrm(3, src, dst))
end.

func x86_emit_mov_reg_imm64(cb: CodeBuf, dst: int, imm: int):
    var rex = 0x48
    if dst >= X86_R8 do
        rex = rex bit_or 0x01
    end
    cb = codebuf_emit_byte(cb, rex)
    cb = codebuf_emit_byte(cb, 0xB8 + (dst bit_and 7))
    out codebuf_emit_u64(cb, imm)
end.

func x86_emit_mov_reg_imm32(cb: CodeBuf, dst: int, imm: int):
    var rex = 0x48
    if dst >= X86_R8 do
        rex = rex bit_or 0x01
    end
    cb = codebuf_emit_byte(cb, rex)
    cb = codebuf_emit_byte(cb, 0xC7)
    cb = codebuf_emit_byte(cb, x86_modrm(3, 0, dst))
    out codebuf_emit_i32(cb, imm)
end.

func x86_emit_push(cb: CodeBuf, reg: int):
    if reg >= X86_R8 do
        cb = codebuf_emit_byte(cb, 0x41)
    end
    out codebuf_emit_byte(cb, 0x50 + (reg bit_and 7))
end.

func x86_emit_pop(cb: CodeBuf, reg: int):
    if reg >= X86_R8 do
        cb = codebuf_emit_byte(cb, 0x41)
    end
    out codebuf_emit_byte(cb, 0x58 + (reg bit_and 7))
end.

func x86_emit_ret(cb: CodeBuf):
    out codebuf_emit_byte(cb, 0xC3)
end.

func x86_emit_nop(cb: CodeBuf):
    out codebuf_emit_byte(cb, 0x90)
end.

func x86_emit_jmp_rel32(cb: CodeBuf, offset: int):
    cb = codebuf_emit_byte(cb, 0xE9)
    out codebuf_emit_i32(cb, offset)
end.

func x86_emit_call_rel32(cb: CodeBuf, offset: int):
    cb = codebuf_emit_byte(cb, 0xE8)
    out codebuf_emit_i32(cb, offset)
end.

func x86_emit_cmp_rr(cb: CodeBuf, a: int, b: int):
    cb = codebuf_emit_byte(cb, x86_rex_w(b, a))
    cb = codebuf_emit_byte(cb, 0x39)
    out codebuf_emit_byte(cb, x86_modrm(3, b, a))
end.

func x86_emit_sete(cb: CodeBuf, dst: int):
    if dst >= X86_R8 do
        cb = codebuf_emit_byte(cb, 0x41)
    end
    cb = codebuf_emit_byte(cb, 0x0F)
    cb = codebuf_emit_byte(cb, 0x94)
    out codebuf_emit_byte(cb, x86_modrm(3, 0, dst))
end.

func x86_emit_setne(cb: CodeBuf, dst: int):
    if dst >= X86_R8 do
        cb = codebuf_emit_byte(cb, 0x41)
    end
    cb = codebuf_emit_byte(cb, 0x0F)
    cb = codebuf_emit_byte(cb, 0x95)
    out codebuf_emit_byte(cb, x86_modrm(3, 0, dst))
end.

func x86_emit_setg(cb: CodeBuf, dst: int):
    if dst >= X86_R8 do
        cb = codebuf_emit_byte(cb, 0x41)
    end
    cb = codebuf_emit_byte(cb, 0x0F)
    cb = codebuf_emit_byte(cb, 0x9F)
    out codebuf_emit_byte(cb, x86_modrm(3, 0, dst))
end.

func x86_emit_setl(cb: CodeBuf, dst: int):
    if dst >= X86_R8 do
        cb = codebuf_emit_byte(cb, 0x41)
    end
    cb = codebuf_emit_byte(cb, 0x0F)
    cb = codebuf_emit_byte(cb, 0x9C)
    out codebuf_emit_byte(cb, x86_modrm(3, 0, dst))
end.

func x86_emit_je_rel32(cb: CodeBuf, offset: int):
    cb = codebuf_emit_byte(cb, 0x0F)
    cb = codebuf_emit_byte(cb, 0x84)
    out codebuf_emit_i32(cb, offset)
end.

func x86_emit_jne_rel32(cb: CodeBuf, offset: int):
    cb = codebuf_emit_byte(cb, 0x0F)
    cb = codebuf_emit_byte(cb, 0x85)
    out codebuf_emit_i32(cb, offset)
end.

func x86_emit_jg_rel32(cb: CodeBuf, offset: int):
    cb = codebuf_emit_byte(cb, 0x0F)
    cb = codebuf_emit_byte(cb, 0x8F)
    out codebuf_emit_i32(cb, offset)
end.

func x86_emit_jl_rel32(cb: CodeBuf, offset: int):
    cb = codebuf_emit_byte(cb, 0x0F)
    cb = codebuf_emit_byte(cb, 0x8C)
    out codebuf_emit_i32(cb, offset)
end.

func x86_emit_xor_rr(cb: CodeBuf, dst: int, src: int):
    cb = codebuf_emit_byte(cb, x86_rex_w(src, dst))
    cb = codebuf_emit_byte(cb, 0x31)
    out codebuf_emit_byte(cb, x86_modrm(3, src, dst))
end.

func x86_emit_cqo(cb: CodeBuf):
    cb = codebuf_emit_byte(cb, 0x48)
    out codebuf_emit_byte(cb, 0x99)
end.

func x86_emit_idiv(cb: CodeBuf, divisor: int):
    var rex = 0x48
    if divisor >= X86_R8 do
        rex = rex bit_or 0x01
    end
    cb = codebuf_emit_byte(cb, rex)
    cb = codebuf_emit_byte(cb, 0xF7)
    out codebuf_emit_byte(cb, x86_modrm(3, 7, divisor))
end.

func x86_emit_syscall(cb: CodeBuf):
    cb = codebuf_emit_byte(cb, 0x0F)
    out codebuf_emit_byte(cb, 0x05)
end.

func x86_emit_sub_rsp_imm(cb: CodeBuf, imm: int):
    if imm <= 127 do
        cb = codebuf_emit_byte(cb, 0x48)
        cb = codebuf_emit_byte(cb, 0x83)
        cb = codebuf_emit_byte(cb, x86_modrm(3, 5, X86_RSP))
        out codebuf_emit_byte(cb, imm bit_and 0xFF)
    end
    cb = codebuf_emit_byte(cb, 0x48)
    cb = codebuf_emit_byte(cb, 0x81)
    cb = codebuf_emit_byte(cb, x86_modrm(3, 5, X86_RSP))
    out codebuf_emit_i32(cb, imm)
end.

func x86_emit_add_rsp_imm(cb: CodeBuf, imm: int):
    if imm <= 127 do
        cb = codebuf_emit_byte(cb, 0x48)
        cb = codebuf_emit_byte(cb, 0x83)
        cb = codebuf_emit_byte(cb, x86_modrm(3, 0, X86_RSP))
        out codebuf_emit_byte(cb, imm bit_and 0xFF)
    end
    cb = codebuf_emit_byte(cb, 0x48)
    cb = codebuf_emit_byte(cb, 0x81)
    cb = codebuf_emit_byte(cb, x86_modrm(3, 0, X86_RSP))
    out codebuf_emit_i32(cb, imm)
end.

func x86_emit_cmp_imm0(cb: CodeBuf, reg: int):
    cb = codebuf_emit_byte(cb, x86_rex_w(0, reg))
    cb = codebuf_emit_byte(cb, 0x83)
    cb = codebuf_emit_byte(cb, x86_modrm(3, 7, reg))
    out codebuf_emit_byte(cb, 0)
end.

func x86_emit_test_rr(cb: CodeBuf, a: int, b: int):
    cb = codebuf_emit_byte(cb, x86_rex_w(b, a))
    cb = codebuf_emit_byte(cb, 0x85)
    out codebuf_emit_byte(cb, x86_modrm(3, b, a))
end.

func x86_emit_mov_reg_mem(cb: CodeBuf, dst: int, base: int, disp: int):
    cb = codebuf_emit_byte(cb, x86_rex_w(dst, base))
    cb = codebuf_emit_byte(cb, 0x8B)
    if disp == 0 and base != X86_RBP and base != X86_R13 do
        out codebuf_emit_byte(cb, x86_modrm(0, dst, base))
    end
    cb = codebuf_emit_byte(cb, x86_modrm(1, dst, base))
    out codebuf_emit_byte(cb, disp bit_and 0xFF)
end.

func x86_emit_mov_mem_reg(cb: CodeBuf, base: int, disp: int, src: int):
    cb = codebuf_emit_byte(cb, x86_rex_w(src, base))
    cb = codebuf_emit_byte(cb, 0x89)
    cb = codebuf_emit_byte(cb, x86_modrm(1, src, base))
    out codebuf_emit_byte(cb, disp bit_and 0xFF)
end.

func x86_emit_setge(cb: CodeBuf, dst: int):
    if dst >= X86_R8 do
        cb = codebuf_emit_byte(cb, 0x41)
    end
    cb = codebuf_emit_byte(cb, 0x0F)
    cb = codebuf_emit_byte(cb, 0x9D)
    out codebuf_emit_byte(cb, x86_modrm(3, 0, dst))
end.

func x86_emit_setle(cb: CodeBuf, dst: int):
    if dst >= X86_R8 do
        cb = codebuf_emit_byte(cb, 0x41)
    end
    cb = codebuf_emit_byte(cb, 0x0F)
    cb = codebuf_emit_byte(cb, 0x9E)
    out codebuf_emit_byte(cb, x86_modrm(3, 0, dst))
end.

func x86_emit_jge_rel32(cb: CodeBuf, offset: int):
    cb = codebuf_emit_byte(cb, 0x0F)
    cb = codebuf_emit_byte(cb, 0x8D)
    out codebuf_emit_i32(cb, offset)
end.

func x86_emit_jle_rel32(cb: CodeBuf, offset: int):
    cb = codebuf_emit_byte(cb, 0x0F)
    cb = codebuf_emit_byte(cb, 0x8E)
    out codebuf_emit_i32(cb, offset)
end.

func x86_emit_and_rr(cb: CodeBuf, dst: int, src: int):
    cb = codebuf_emit_byte(cb, x86_rex_w(src, dst))
    cb = codebuf_emit_byte(cb, 0x21)
    out codebuf_emit_byte(cb, x86_modrm(3, src, dst))
end.

func x86_emit_or_rr(cb: CodeBuf, dst: int, src: int):
    cb = codebuf_emit_byte(cb, x86_rex_w(src, dst))
    cb = codebuf_emit_byte(cb, 0x09)
    out codebuf_emit_byte(cb, x86_modrm(3, src, dst))
end.

func x86_emit_shl_cl(cb: CodeBuf, dst: int):
    cb = codebuf_emit_byte(cb, x86_rex_w(0, dst))
    cb = codebuf_emit_byte(cb, 0xD3)
    out codebuf_emit_byte(cb, x86_modrm(3, 4, dst))
end.

func x86_emit_shr_cl(cb: CodeBuf, dst: int):
    cb = codebuf_emit_byte(cb, x86_rex_w(0, dst))
    cb = codebuf_emit_byte(cb, 0xD3)
    out codebuf_emit_byte(cb, x86_modrm(3, 5, dst))
end.

func x86_emit_not_rr(cb: CodeBuf, dst: int):
    cb = codebuf_emit_byte(cb, x86_rex_w(0, dst))
    cb = codebuf_emit_byte(cb, 0xF7)
    out codebuf_emit_byte(cb, x86_modrm(3, 2, dst))
end.

export X86_RAX, X86_RCX, X86_RDX, X86_RBX, X86_RSP, X86_RBP, X86_RSI, X86_RDI
export x86_emit_sub_rsp_imm, x86_emit_add_rsp_imm, x86_emit_cmp_imm0, x86_emit_test_rr
export x86_emit_mov_reg_mem, x86_emit_mov_mem_reg
export x86_emit_setge, x86_emit_setle, x86_emit_jge_rel32, x86_emit_jle_rel32
export x86_emit_and_rr, x86_emit_or_rr, x86_emit_shl_cl, x86_emit_shr_cl, x86_emit_not_rr
export X86_R8, X86_R9, X86_R10, X86_R11, X86_R12, X86_R13, X86_R14, X86_R15
export x86_emit_add_rr, x86_emit_sub_rr, x86_emit_imul_rr, x86_emit_mov_rr
export x86_emit_mov_reg_imm64, x86_emit_mov_reg_imm32
export x86_emit_push, x86_emit_pop, x86_emit_ret, x86_emit_nop
export x86_emit_jmp_rel32, x86_emit_call_rel32
export x86_emit_cmp_rr, x86_emit_sete, x86_emit_setne, x86_emit_setg, x86_emit_setl
export x86_emit_je_rel32, x86_emit_jne_rel32, x86_emit_jg_rel32, x86_emit_jl_rel32
export x86_emit_xor_rr, x86_emit_cqo, x86_emit_idiv, x86_emit_syscall
export x86_arg_reg
