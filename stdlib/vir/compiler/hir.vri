##
 * vir/compiler/hir.vri — High-level Intermediate Representation
 * ==============================================================
 * Converted from C (core/include/hir.h) for self-hosting.
 ##

include types;
include vec_rt;
import vec_new_rt, vec_push_rt, vec_get_rt, vec_len_rt from vec_rt;

enum HirKind:
    IntrinsicCall = 0;
    Call          = 1;
    Return        = 2;
    If            = 3;
    Loop          = 4;
    Block         = 5;
    Const         = 6;
    Load          = 7;
    Store         = 8;
    Break         = 9;
    Continue      = 10;
    BinOp         = 11;
    VarDecl       = 12
end
# HIR Node. Since Vir's `entity` is flat and we don't have C unions,
# we map all possible properties into a single struct, using `i64` for
# pointers or collections (like Vec).
entity HirNode:
    kind: HirKind,
        type_id: i64;
    
    # Generic fields for different kinds
    var_id: i64,
        intrinsic_id: i64,
        op: i64;           # BinOp opcode
    value: i64;        # Const value
    
    # Node references (indices or pointers stored as i64)
    # 0 = null/none
    left_node: i64,
        right_node: i64,
        cond_node: i64,
        then_block: i64,
        else_block: i64;
    
    # Collections (Vec)
    args: i64,
        body: i64
end
func hir_new(kind: HirKind, type_id: i64)
    out HirNode (
        kind: kind,
        type_id: type_id,
        var_id: 0,
        intrinsic_id: 0,
        op: 0,
        value: 0,
        left_node: 0,
        right_node: 0,
        cond_node: 0,
        then_block: 0,
        else_block: 0,
        args: vec_new_rt(),
        body: vec_new_rt()
    )
end
func hir_add_arg(node: HirNode, arg: HirNode)
    node.args = vec_push_rt(node.args, arg);
    out node
end
func hir_add_stmt(node: HirNode, stmt: HirNode)
    node.body = vec_push_rt(node.body, stmt);
    out node
end
export HirKind, HirNode, hir_new, hir_add_arg, hir_add_stmt;
