##
 * vir/compiler/hir.vri — High-level Intermediate Representation (Vir v2.0)
 * =========================================================================
 * Full-fidelity HIR data structures for canonical compiler lowering.
 ##

include types;
include vec_rt;
import vec_new_rt, vec_push_rt, vec_get_rt, vec_len_rt, vec_set_rt from vec_rt;

include string_rt;
import fat_str_new from string_rt;

enum HirKind:
    Const          = 0;
    StrLit         = 1;
    Load           = 2;
    Store          = 3;
    VarDecl        = 4;
    BinOp          = 5;
    UnaryOp        = 6;
    Call           = 7;
    BuiltinCall    = 8;
    IntrinsicCall  = 9;
    If             = 10;
    Loop           = 11;
    Block          = 12;
    Return         = 13;
    Break          = 14;
    Continue       = 15;
    Print          = 16;
    FieldAccess    = 17;
    FieldStore     = 18;
    IndexAccess    = 19;
    IndexStore     = 20;
    Aggregate      = 21;
    Param          = 22;
    DeclMarker     = 23
end.

entity HirNode:
    kind: HirKind,
    type_id: i64,
    name: string,
    name2: string,
    imm_val: i64,
    op: i64,
    left_node: i64,
    right_node: i64,
    cond_node: i64,
    then_block: i64,
    else_block: i64,
    args: i64,
    body: i64,
    line: i64
end.

entity HirFunc:
    id: i64,
    name: string,
    name2: string,
    params: i64,
    body: HirNode,
    strings: i64
end.

func hir_new(kind: HirKind, type_id: i64):
    out HirNode (
        kind: kind,
        type_id: type_id,
        # HIR names are always fat strings. This keeps synthetic/default
        # names safe for the same comparison path as parser-derived names.
        name: fat_str_new(""),
        name2: fat_str_new(""),
        imm_val: 0,
        op: 0,
        left_node: 0,
        right_node: 0,
        cond_node: 0,
        then_block: 0,
        else_block: 0,
        args: vec_new_rt(),
        body: vec_new_rt(),
        line: 0
    )
end.

func hir_add_arg(node: HirNode, arg: HirNode):
    node.args = vec_push_rt(node.args, arg as i64);
    out node
end.

func hir_add_stmt(node: HirNode, stmt: HirNode):
    node.body = vec_push_rt(node.body, stmt as i64);
    out node
end.

func hir_func_new(id: i64, name: string, name2: string, params: i64, body: HirNode):
    out HirFunc (
        id: id,
        name: name,
        name2: name2,
        params: params,
        body: body,
        strings: vec_new_rt()
    )
end.

export HirKind, HirNode, HirFunc, hir_new, hir_add_arg, hir_add_stmt, hir_func_new
