##
 * vir/compiler/lir_lower.vri — SSA Destruction & MIR to LIR Lowering
 * ====================================================================
 * Translates MIR functions to LIR functions.
 * Destroys SSA form by replacing Phi nodes with Mov instructions
 * in predecessor blocks.
 ##

include types;
include vec_rt;
import vec_new_rt, vec_push_rt, vec_get_rt, vec_set_rt, vec_len_rt from vec_rt;
include mir;
import MirOp, MirOperandType, MirOperand, MirPhi, MirBlock, MirFunc from mir;
include lir;
import LirType, LirOp, LirOperandType, LirOperand, LirInstr, LirBlock, LirFunc, lir_opnd_none, lir_opnd_vreg_int, lir_opnd_imm from lir;

func lower_mir_opnd(m_opnd: MirOperand)
    if m_opnd.op_type == MirOperandType.VReg do
        out lir_opnd_vreg_int(m_opnd.vreg)
    eif m_opnd.op_type == MirOperandType.Imm do
        out lir_opnd_imm(m_opnd.imm)
    end
    out lir_opnd_none()
end.

func lower_mir_op(m_op: MirOp)
    if m_op == MirOp.Move do out LirOp.Mov end
    if m_op == MirOp.Load do out LirOp.Load end
    if m_op == MirOp.Store do out LirOp.Store end
    if m_op == MirOp.Add do out LirOp.Add end
    if m_op == MirOp.Sub do out LirOp.Sub end
    if m_op == MirOp.Mul do out LirOp.Mul end
    if m_op == MirOp.Div do out LirOp.Div end
    if m_op == MirOp.Call do out LirOp.Call end
    if m_op == MirOp.Jump do out LirOp.Jmp end
    if m_op == MirOp.JumpIf do out LirOp.JmpCond end
    if m_op == MirOp.Return do out LirOp.Ret end
    out LirOp.Nop
end.

func lir_lower_func(m_func: MirFunc, m_blocks: i64)
    l_func = LirFunc (
        id: m_func.id,
        blocks: vec_new_rt(),
        stack_size: 0
    );

    n_blocks = vec_len_rt(m_blocks);

    # 1. Create LIR blocks
    var i = 0;
    when i < n_blocks loop
        m_b = vec_get_rt(m_blocks, i);
        l_b = LirBlock (
            id: m_b.id,
            instrs: vec_new_rt()
        );
        l_func.blocks = vec_push_rt(l_func.blocks, l_b);
        i = i + 1
    end

    # 2. Lower instructions and handle Phi nodes
    i = 0;
    when i < n_blocks loop
        m_b = vec_get_rt(m_blocks, i);
        l_b = vec_get_rt(l_func.blocks, i);

        m_instrs = m_b.head;
        if m_instrs >= 0 do
            n_instrs = vec_len_rt(m_instrs);
            var j = 0;
            when j < n_instrs loop
                m_ins = vec_get_rt(m_instrs, j);
                l_ins = LirInstr (
                    op: lower_mir_op(m_ins.op),
                    typ: LirType.Int64,
                    dst: lower_mir_opnd(m_ins.dst),
                    src1: lower_mir_opnd(m_ins.src1),
                    src2: lower_mir_opnd(m_ins.src2)
                );
                l_b.instrs = vec_push_rt(l_b.instrs, l_ins);
                j = j + 1
            end
        end
        vec_set_rt(l_func.blocks, i, l_b);

        # SSA Destruction: For each Phi node in m_b, insert Mov in predecessor blocks
        phis = m_b.phis;
        if phis >= 0 do
            n_phis = vec_len_rt(phis);
            var p_idx = 0;
            when p_idx < n_phis loop
                phi = vec_get_rt(phis, p_idx);
                n_incoming = vec_len_rt(phi.incoming_blocks);
                var k = 0;
                when k < n_incoming loop
                    pred_id = vec_get_rt(phi.incoming_blocks, k);
                    val = vec_get_rt(phi.incoming_values, k);

                    if val.op_type != MirOperandType.None do
                        pred_lb = vec_get_rt(l_func.blocks, pred_id);
                        mov_ins = LirInstr (
                            op: LirOp.Mov,
                            typ: LirType.Int64,
                            dst: lir_opnd_vreg_int(phi.dst_vreg),
                            src1: lower_mir_opnd(val),
                            src2: lir_opnd_none()
                        );
                        pred_lb.instrs = vec_push_rt(pred_lb.instrs, mov_ins);
                        vec_set_rt(l_func.blocks, pred_id, pred_lb)
                    end
                    k = k + 1
                end
                p_idx = p_idx + 1
            end
        end
        i = i + 1
    end
    out l_func
end.

func lir_lower_program(mir_funcs: i64)
    # Lower all MIR functions to LIR functions
    lir_funcs = vec_new_rt();
    n_funcs = vec_len_rt(mir_funcs);
    var i = 0;
    when i < n_funcs loop
        mf = vec_get_rt(mir_funcs, i);
        lf = lir_lower_func(mf, mf.blocks);
        lir_funcs = vec_push_rt(lir_funcs, lf);
        i = i + 1
    end
    out lir_funcs
end.

export lir_lower_func, lir_lower_program
