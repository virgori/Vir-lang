##
 * vir/compiler/sem_pass3_names.vri
 * ==============================================================
 * Pass 3: Name Resolution (Vir v2.0 Complete).
 * Resolves identifier references, function calls, method calls,
 * builtin calls, and enum access to their declaring symbols.
 ##

include vec_rt
import vec_new_rt, vec_push_rt, vec_get_rt, vec_len_rt from vec_rt

include string_rt
import rt_streq, fat_str_eq, fat_str_len, fat_cstr_eq, fat_str_new, rt_strcat, rt_itoa, rt_strlen from string_rt

include parser
import AstNode, AstType from parser

include symbol_table
import SymbolTable, SymbolKind, SymbolNode, symbol_alloc from symbol_table

include scope_tree
import ScopeTree, ScopeKind, ScopeNode, scope_push, scope_pop, scope_add_symbol, scope_current_id from scope_tree

include context
import DiagnosticEngine, report_error from context

include io
import print_str, print_int, print_newline from io

include alloc
import vir_alloc from alloc

# Name resolution used to scan every symbol in the global scope for every
# identifier.  A self-host build has thousands of globals and tens of
# thousands of references, making pass 3 effectively O(refs * globals).
# Keep scope-local lookup linear (local scopes are small), but index the
# global scope once before walking the AST.
const PASS3_GLOBAL_BUCKETS: int = 4096
const PASS3_GLOBAL_BUCKET_MASK: int = 4095
var g_pass3_global_heads: i64 = 0
var g_pass3_global_next: i64 = 0
var g_pass3_global_indexed_count: i64 = 0

func pass3_name_bucket(name: string):
    n = fat_str_len(name)
    if n <= 0 do
        out 0
    end
    data = native_read_i64(name as i64, 0)
    h = n bit_and PASS3_GLOBAL_BUCKET_MASK
    var i = 0
    when i < n loop
        h = (h * 131 + native_read_u8(data, i)) bit_and PASS3_GLOBAL_BUCKET_MASK
        i = i + 1
    end
    out h
end.

func pass3_build_global_index(symbols: SymbolTable, scopes: ScopeTree):
    if g_pass3_global_heads == 0 do
        g_pass3_global_heads = vir_alloc(PASS3_GLOBAL_BUCKETS * 8)
    end

    var i = 0
    when i < PASS3_GLOBAL_BUCKETS loop
        native_write_i64(g_pass3_global_heads, i * 8, 0)
        i = i + 1
    end

    scopes_vec = native_read_i64(scopes as i64, 0)
    global_scope = vec_get_rt(scopes_vec, 0)
    global_syms = native_read_i64(global_scope as i64, 16)
    count = vec_len_rt(global_syms)
    # semantic_run invokes pass 3 once.  Allocate the exact chain array for
    # that snapshot; symbols added later use the small linear tail fallback.
    if count > 0 do
        g_pass3_global_next = vir_alloc(count * 8)
    else
        g_pass3_global_next = 0
    end
    g_pass3_global_indexed_count = count

    syms_vec = native_read_i64(symbols as i64, 0)
    i = 0
    when i < count loop
        sym_id = vec_get_rt(global_syms, i)
        sym = vec_get_rt(syms_vec, sym_id)
        sym_name = native_read_i64(sym as i64, 8) as string
        bucket = pass3_name_bucket(sym_name)
        head = native_read_i64(g_pass3_global_heads, bucket * 8)
        native_write_i64(g_pass3_global_next, i * 8, head)
        native_write_i64(g_pass3_global_heads, bucket * 8, i + 1)
        i = i + 1
    end
end.

func pass3_lookup_global(symbols: SymbolTable, scopes: ScopeTree, name: string):
    if fat_str_len(name) == 0 do
        out -1
    end
    scopes_vec = native_read_i64(scopes as i64, 0)
    global_scope = vec_get_rt(scopes_vec, 0)
    global_syms = native_read_i64(global_scope as i64, 16)
    syms_vec = native_read_i64(symbols as i64, 0)

    if g_pass3_global_heads != 0 and g_pass3_global_next != 0 do
        bucket = pass3_name_bucket(name)
        link = native_read_i64(g_pass3_global_heads, bucket * 8)
        when link > 0 loop
            pos = link - 1
            sym_id = vec_get_rt(global_syms, pos)
            sym = vec_get_rt(syms_vec, sym_id)
            sym_name = native_read_i64(sym as i64, 8) as string
            if fat_str_eq(sym_name, name) == 1 do
                out sym_id
            end
            link = native_read_i64(g_pass3_global_next, pos * 8)
        end
    end

    # Normally empty: declarations handled by pass 2 are already indexed.
    # Preserve correctness for a declaration kind added by pass 3 itself.
    count = vec_len_rt(global_syms)
    var i = g_pass3_global_indexed_count
    when i < count loop
        sym_id = vec_get_rt(global_syms, i)
        sym = vec_get_rt(syms_vec, sym_id)
        sym_name = native_read_i64(sym as i64, 8) as string
        if fat_str_eq(sym_name, name) == 1 do
            out sym_id
        end
        i = i + 1
    end
    out -1
end.

func is_builtin_method_name(name: i64):
    if name == 0 do out 0 end
    if fat_cstr_eq(name, "send") or fat_cstr_eq(name, "recv") or fat_cstr_eq(name, "push") or fat_cstr_eq(name, "pop") or fat_cstr_eq(name, "len") do out 1 end
    if rt_streq(name as int, "send") or rt_streq(name as int, "recv") or rt_streq(name as int, "push") or rt_streq(name as int, "pop") or rt_streq(name as int, "len") do out 1 end
    out 0
end.

func pass3_is_soft_call_name(name: string):
    if fat_str_len(name) == 0 do
        out 0
    end
    nm = name as i64
    if fat_str_len(name) >= 7 do
        data = native_read_i64(nm, 0)
        if native_read_u8(data, 0) == 110 and native_read_u8(data, 1) == 97 and native_read_u8(data, 2) == 116 and native_read_u8(data, 3) == 105 and native_read_u8(data, 4) == 118 and native_read_u8(data, 5) == 101 and native_read_u8(data, 6) == 95 do
            out 1
        end
    end
    if fat_cstr_eq(nm, "panic") or fat_cstr_eq(nm, "free") or fat_cstr_eq(nm, "realloc") or fat_cstr_eq(nm, "size_of") or fat_cstr_eq(nm, "alloc") or fat_cstr_eq(nm, "min") or fat_cstr_eq(nm, "max") or fat_cstr_eq(nm, "to_string") or fat_cstr_eq(nm, "utf8_decode_char") or fat_cstr_eq(nm, "vec_set_at") or fat_cstr_eq(nm, "str_from_i64") or fat_cstr_eq(nm, "codebuf_get_data") or fat_cstr_eq(nm, "read_u32") or fat_cstr_eq(nm, "patch_u32") or fat_cstr_eq(nm, "patch_i32") or fat_cstr_eq(nm, "eprintln") or fat_cstr_eq(nm, "read") or fat_cstr_eq(nm, "write") or fat_cstr_eq(nm, "_next_pow2") or fat_cstr_eq(nm, "alloc_zeroed") or fat_cstr_eq(nm, "float_to_bits") or fat_cstr_eq(nm, "wf_emit_sleb128") or fat_cstr_eq(nm, "map_set") or fat_cstr_eq(nm, "write_bytes_to_file") do
        out 1
    end
    out 0
end.

func pass3_register_pattern_binders(symbols: SymbolTable, scopes: ScopeTree, diag: DiagnosticEngine, pat: AstNode):
    if pat.node_type == AstType.Identifier do
        child_count = vec_len_rt(pat.children)
        if child_count > 0 do
            # Tagged patterns are encoded as an Identifier constructor with
            # binder identifiers as children: Some(p), Ok(v), Err(e).
            var i = 0
            when i < child_count loop
                child = vec_get_rt(pat.children, i)
                pass3_register_pattern_binders(symbols, scopes, diag, child)
                i = i + 1
            end
            out 0
        end
        if not fat_str_eq(pat.name, fat_str_new("_")) and not fat_str_eq(pat.name, fat_str_new("true")) and not fat_str_eq(pat.name, fat_str_new("false")) and not fat_str_eq(pat.name, fat_str_new("None")) and not fat_str_eq(pat.name, fat_str_new("null")) do
            found = pass3_lookup_chain(symbols, scopes, 0, pat.name)
            if found == -1 do
                pass3_register_local(symbols, scopes, pat.name, SymbolKind.Variable, pat.line)
            end
        end
        out 0
    end
    if pat.node_type == AstType.Call or pat.node_type == AstType.TupleExpr or pat.node_type == AstType.ArrayLiteral do
        child_count = vec_len_rt(pat.children)
        var i = 0
        when i < child_count loop
            child = vec_get_rt(pat.children, i)
            pass3_register_pattern_binders(symbols, scopes, diag, child)
            i = i + 1
        end
    end
    out 0
end.

func pass3_resolve_names(symbols: SymbolTable, scopes: ScopeTree, diag: DiagnosticEngine, node: AstNode):
    pass3_build_global_index(symbols, scopes)
    pass3_walk(symbols, scopes, diag, node)
end.
func pass3_walk(symbols: SymbolTable, scopes: ScopeTree, diag: DiagnosticEngine, node: AstNode):

    if node.node_type == AstType.Identifier do
        nm = node.name as i64
        if fat_cstr_eq(nm, "null") or fat_cstr_eq(nm, "void") or fat_cstr_eq(nm, "true") or fat_cstr_eq(nm, "false") or fat_cstr_eq(nm, "None") do
            out 0
        end
        found = pass3_lookup_chain(symbols, scopes, scope_current_id(scopes), node.name)
        if found == -1 do
            # `this` in a method body: register if the parser used ThisKw.
            if fat_cstr_eq(nm, "this") == 1 do
                pass3_register_local(symbols, scopes, fat_str_new("this"), SymbolKind.Param, node.line)
            else
                report_error(diag, 2001, node.line, 0)
            end
        end
        out 0
    end

    if node.node_type == AstType.BuiltinCall do
        # Parser already bound builtin_id; do not require a symbol name
        # (ast_add_child can clobber .name on the soft ABI).
        child_count = vec_len_rt(node.children)
        var i = 0
        when i < child_count loop
            child = vec_get_rt(node.children, i)
            pass3_walk(symbols, scopes, diag, child)
            i = i + 1
        end
        out 0
    end

    if node.node_type == AstType.Call do
        found = pass3_lookup_chain(symbols, scopes, scope_current_id(scopes), node.name)
        if found == -1 and pass3_is_soft_call_name(node.name) == 0 do
            report_error(diag, 1003, node.line, 0)
        end
        # Resolve arguments
        child_count = vec_len_rt(node.children)
        var i = 0
        when i < child_count loop
            child = vec_get_rt(node.children, i)
            pass3_walk(symbols, scopes, diag, child)
            i = i + 1
        end
        out 0
    end

    if node.node_type == AstType.MethodCall do
        # UFCS / Callable field: receiver is children[0]. Missing free function
        # is allowed because callable record fields lower dynamically.
        found = pass3_lookup_chain(symbols, scopes, scope_current_id(scopes), node.name)
        if found == -1 do
            found = pass3_lookup_chain(symbols, scopes, 0, node.name)
        end
        child_count = vec_len_rt(node.children)
        if child_count > 0 do
            receiver = vec_get_rt(node.children, 0)
            pass3_walk(symbols, scopes, diag, receiver)
        end
        # Resolve method arguments
        var i = 1
        when i < child_count loop
            child = vec_get_rt(node.children, i)
            pass3_walk(symbols, scopes, diag, child)
            i = i + 1
        end
        out 0
    end

    if node.node_type == AstType.BindAttr do
        child_count = vec_len_rt(node.children)
        if child_count > 0 do
            child = vec_get_rt(node.children, 0)
            pass3_walk(symbols, scopes, diag, child)
        end
        out 0
    end

    if node.node_type == AstType.EntityDef or node.node_type == AstType.PackedDef or node.node_type == AstType.RegisterDef or node.node_type == AstType.EnumDef do
        out 0
    end

    if node.node_type == AstType.EntityLiteral do
        child_count = vec_len_rt(node.children)
        var i = 0
        when i < child_count loop
            child = vec_get_rt(node.children, i)
            pass3_walk(symbols, scopes, diag, child)
            i = i + 1
        end
        out 0
    end

    if node.node_type == AstType.FieldAccess do
        child_count = vec_len_rt(node.children)
        var i = 0
        when i < child_count loop
            child = vec_get_rt(node.children, i)
            pass3_walk(symbols, scopes, diag, child)
            i = i + 1
        end
        out 0
    end

    if node.node_type == AstType.EnumAccess do
        found = pass3_lookup_chain(symbols, scopes, scope_current_id(scopes), node.name)
        if found == -1 do
            # Could be a qualified lookup, we try to resolve parts if needed
            # But for simplicity, logging it if totally not found globally
            report_error(diag, 1005, node.line, 0)
        end
        out 0
    end

    if node.node_type == AstType.CaseExpr do
        child_count = vec_len_rt(node.children)
        if child_count > 0 do
            # 1. Walk target expression
            target = vec_get_rt(node.children, 0)
            pass3_walk(symbols, scopes, diag, target)

            # 2. Walk each arm: [pat, body, pat, body, ...]
            var i = 1
            when i + 1 < child_count loop
                pat = vec_get_rt(node.children, i)
                body = vec_get_rt(node.children, i + 1)

                old_scope = scope_current_id(scopes)
                scope_id = scope_push(scopes, ScopeKind.Block)

                pass3_register_pattern_binders(symbols, scopes, diag, pat)
                pass3_walk(symbols, scopes, diag, body)
                scope_pop(scopes)
                i = i + 2
            end
        end
        out 0
    end
    
    if node.node_type == AstType.WhenStmt do
        old_scope = scope_current_id(scopes)
        scope_id = scope_push(scopes, ScopeKind.Block)
        if fat_str_len(node.name) > 0 do
            pass3_register_local(symbols, scopes, node.name, SymbolKind.Variable, node.line)
        end
        child_count = vec_len_rt(node.children)
        var i = 0
        when i < child_count loop
            child = vec_get_rt(node.children, i)
            pass3_walk(symbols, scopes, diag, child)
            i = i + 1
        end
        scope_pop(scopes)
        out 0
    end

    if node.node_type == AstType.FuncDef do
        # Push function scope for body
        old_scope = scope_current_id(scopes)
        scope_id = scope_push(scopes, ScopeKind.Func)
        # Children: params*, body Block, optional Ensure/Revert.
        child_count = vec_len_rt(node.children)
        body_idx = child_count - 1
        if body_idx < 0 do
            body_idx = 0
        end
        var bi = 0
        when bi < child_count loop
            ch = vec_get_rt(node.children, bi)
            if ch.node_type == AstType.Block do
                body_idx = bi
                bi = child_count
            else
                bi = bi + 1
            end
        end
        var i = 0
        when i < body_idx loop
            param = vec_get_rt(node.children, i)
            pass3_register_local(symbols, scopes, param.name, SymbolKind.Param, param.line)
            i = i + 1
        end
        var j = body_idx
        when j < child_count loop
            child = vec_get_rt(node.children, j)
            pass3_walk(symbols, scopes, diag, child)
            j = j + 1
        end
        scope_pop(scopes)
        out 0
    end

    if node.node_type == AstType.Block do
        old_scope = scope_current_id(scopes)
        scope_id = scope_push(scopes, ScopeKind.Block)
        child_count = vec_len_rt(node.children)
        var i = 0
        when i < child_count loop
            child = vec_get_rt(node.children, i)
            pass3_walk(symbols, scopes, diag, child)
            i = i + 1
        end
        scope_pop(scopes)
        out 0
    end

    if node.node_type == AstType.TryStmt do
        # `err` is an implicit variable bound to the thrown value inside the
        # revert handler. Register it for the whole try/revert scope.
        old_scope = scope_current_id(scopes)
        scope_id = scope_push(scopes, ScopeKind.Block)
        pass3_register_local(symbols, scopes, fat_str_new("err"), SymbolKind.Variable, node.line)
        child_count = vec_len_rt(node.children)
        var i = 0
        when i < child_count loop
            child = vec_get_rt(node.children, i)
            pass3_walk(symbols, scopes, diag, child)
            i = i + 1
        end
        scope_pop(scopes)
        out 0
    end

    if node.node_type == AstType.VarDecl or node.node_type == AstType.ConstDecl or node.node_type == AstType.ReactiveDecl do
        is_mut = node.node_type == AstType.VarDecl or node.node_type == AstType.ReactiveDecl
        if node.int_val == 16384 do
            child_count = vec_len_rt(node.children)
            if child_count > 0 do
                # 1. Resolve initializer (last child)
                init_child = vec_get_rt(node.children, child_count - 1)
                pass3_walk(symbols, scopes, diag, init_child)
                # 2. Register destructure variable names (first child_count - 1 children)
                var i = 0
                when i < child_count - 1 loop
                    var_ident = vec_get_rt(node.children, i)
                    if is_mut do
                        pass3_register_local(symbols, scopes, var_ident.name, SymbolKind.Variable, var_ident.line)
                    else
                        pass3_register_local(symbols, scopes, var_ident.name, SymbolKind.Const, var_ident.line)
                    end
                    i = i + 1
                end
            end
        else
            # First resolve initializer, then register the name
            child_count = vec_len_rt(node.children)
            var i = 0
            when i < child_count loop
                child = vec_get_rt(node.children, i)
                pass3_walk(symbols, scopes, diag, child)
                i = i + 1
            end
            if is_mut do
                pass3_register_local(symbols, scopes, node.name, SymbolKind.Variable, node.line)
            else
                pass3_register_local(symbols, scopes, node.name, SymbolKind.Const, node.line)
            end
        end
        out 0
    end

    if node.node_type == AstType.BundleExpr do
        child_count = vec_len_rt(node.children)
        var i = 0
        when i < child_count loop
            child = vec_get_rt(node.children, i)
            pass3_walk(symbols, scopes, diag, child)
            i = i + 1
        end
        if fat_str_len(node.name) > 0 do
            pass3_register_local(symbols, scopes, node.name, SymbolKind.Const, node.line)
        end
        out 0
    end

    if node.node_type == AstType.ExposeAttr do
        child_count = vec_len_rt(node.children)
        if child_count > 0 do
            child = vec_get_rt(node.children, 0)
            pass3_walk(symbols, scopes, diag, child)
        end
        out 0
    end

    if node.node_type == AstType.ShareDecl or node.node_type == AstType.HasDecl do
        if fat_str_len(node.name) > 0 do
            pass3_register_local(symbols, scopes, node.name, SymbolKind.Variable, node.line)
        end
        out 0
    end

    # Implicit locals: Vir allows `x = expr` without prior `var`/`let`.
    # LHS lives on node.name; children are RHS only (see parse_stmt Assign).
    if node.node_type == AstType.Assign do
        if fat_str_len(node.name) > 0 do
            found = pass3_lookup_chain(symbols, scopes, scope_current_id(scopes), node.name)
            if found == -1 do
                pass3_register_implicit_local(symbols, scopes, node.name, SymbolKind.Variable, node.line)
            end
        end
        child_count = vec_len_rt(node.children)
        if child_count >= 2 do
            lhs = vec_get_rt(node.children, 0)
            if lhs.node_type == AstType.TupleExpr do
                pass3_register_pattern_binders(symbols, scopes, diag, lhs)
            end
        end
        var i = 0
        when i < child_count loop
            child = vec_get_rt(node.children, i)
            pass3_walk(symbols, scopes, diag, child)
            i = i + 1
        end
        out 0
    end

    # for i in lo..hi: register loop binder before walking the body.
    if node.node_type == AstType.ForRange do
        child_count = vec_len_rt(node.children)
        if child_count >= 1 do
            pass3_walk(symbols, scopes, diag, vec_get_rt(node.children, 0))
        end
        if child_count >= 2 do
            pass3_walk(symbols, scopes, diag, vec_get_rt(node.children, 1))
        end
        scope_push(scopes, ScopeKind.Loop)
        if fat_str_len(node.name) > 0 do
            pass3_register_local(symbols, scopes, node.name, SymbolKind.Variable, node.line)
        end
        if child_count >= 3 do
            pass3_walk(symbols, scopes, diag, vec_get_rt(node.children, 2))
        end
        scope_pop(scopes)
        out 0
    end

    # Default: recurse into children
    child_count = vec_len_rt(node.children)
    var i = 0
    when i < child_count loop
        child = vec_get_rt(node.children, i)
        pass3_walk(symbols, scopes, diag, child)
        i = i + 1
    end
    out 0
end.
func pass3_lookup_chain(symbols: SymbolTable, scopes: ScopeTree, start_scope: int, name: string):
    if fat_str_len(name) == 0 do
        out -1
    end
    curr = start_scope
    scopes_vec = native_read_i64(scopes as i64, 0)
    syms_vec = native_read_i64(symbols as i64, 0)
    when curr >= 0 loop
        if curr == 0 do
            out pass3_lookup_global(symbols, scopes, name)
        end
        scope_node = vec_get_rt(scopes_vec, curr)
        sym_list = native_read_i64(scope_node as i64, 16)
        count = vec_len_rt(sym_list)
        var i = 0
        when i < count loop
            sym_id = vec_get_rt(sym_list, i)
            sym = vec_get_rt(syms_vec, sym_id)
            sym_name = native_read_i64(sym as i64, 8) as string
            if fat_str_eq(sym_name, name) == 1 do
                out sym_id
            end
            i = i + 1
        end
        curr = native_read_i64(scope_node as i64, 8)
    end
    out -1
end.
func pass3_enclosing_func_scope(scopes: ScopeTree, curr_scope: int):
    if curr_scope <= 0 do
        out curr_scope
    end
    scopes_vec = native_read_i64(scopes as i64, 0)
    var s = curr_scope
    when s > 0 loop
        scope_node = vec_get_rt(scopes_vec, s)
        skind = native_read_i64(scope_node as i64, 0)
        if skind == ScopeKind.Func do
            out s
        end
        s = native_read_i64(scope_node as i64, 8)
    end
    out curr_scope
end.

func pass3_register_local(symbols: SymbolTable, scopes: ScopeTree, name: string, kind: SymbolKind, line: int):
    if fat_str_len(name) == 0 do
        out 0
    end
    curr_scope = scope_current_id(scopes)
    # Pass 2 already registered top-level declarations.  Registering them a
    # second time here both changed shadowing behaviour and enlarged the hot
    # global lookup set while pass 3 was running.
    if curr_scope == 0 do
        found = pass3_lookup_global(symbols, scopes, name)
        if found != -1 do
            out found
        end
    end
    sym = SymbolNode (
        kind: kind,
        name_id: name as i64,
        type_id: 0,
        scope_id: curr_scope,
        ast_id: 0,
        is_mutable: kind == SymbolKind.Variable or kind == SymbolKind.Param,
        offset: 0,
        param_count: 0,
        return_type: 0,
        parent_id: -1
    )
    sym_id = symbol_alloc(symbols, sym)
    scope_add_symbol(scopes, curr_scope, sym_id)
    out sym_id
end.

func pass3_register_implicit_local(symbols: SymbolTable, scopes: ScopeTree, name: string, kind: SymbolKind, line: int):
    curr_scope = scope_current_id(scopes)
    sym_id = pass3_register_local(symbols, scopes, name, kind, line)
    func_scope = pass3_enclosing_func_scope(scopes, curr_scope)
    if sym_id > 0 and func_scope != curr_scope do
        scope_add_symbol(scopes, func_scope, sym_id)
    end
    out sym_id
end.

export pass3_resolve_names
