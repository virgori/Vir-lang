##
 * vir/compiler/sem_pass3_names.vri
 * ==============================================================
 * Pass 3: Name Resolution (Vir v2.0 Complete).
 * Resolves identifier references, function calls, method calls,
 * builtin calls, and enum access to their declaring symbols.
 ##

include vec_rt;
import vec_new_rt, vec_push_rt, vec_get_rt, vec_len_rt from vec_rt;

include string_rt;
import rt_streq, fat_str_eq, fat_str_len, fat_cstr_eq, fat_str_new, rt_strcat, rt_itoa, rt_strlen from string_rt;

include parser;
import AstNode, AstType from parser;

include symbol_table;
import SymbolTable, SymbolKind, SymbolNode, symbol_alloc from symbol_table;

include scope_tree;
import ScopeTree, ScopeKind, ScopeNode, scope_push, scope_pop, scope_add_symbol, scope_current_id from scope_tree;

include context;
import DiagnosticEngine, report_error from context;

include io;
import print_str, print_int, print_newline from io;

func pass3_resolve_names(symbols: SymbolTable, scopes: ScopeTree, diag: DiagnosticEngine, node: AstNode):
    pass3_walk(symbols, scopes, diag, node)
end.
func pass3_walk(symbols: SymbolTable, scopes: ScopeTree, diag: DiagnosticEngine, node: AstNode):

    if node.node_type == AstType.Identifier do
        found = pass3_lookup_chain(symbols, scopes, scope_current_id(scopes), node.name);
        if found == -1 do
            # `this` in a method body: register if the parser used ThisKw.
            if fat_str_eq(node.name, fat_str_new("this")) == 1 do
                pass3_register_local(symbols, scopes, fat_str_new("this"), SymbolKind.Param, node.line)
            else
                report_error(diag, 1002, node.line, 0)
            end
        end
        out 0
    end

    if node.node_type == AstType.BuiltinCall do
        # Parser already bound builtin_id; do not require a symbol name
        # (ast_add_child can clobber .name on the soft ABI).
        child_count = vec_len_rt(node.children);
        var i = 0;
        when i < child_count loop
            child = vec_get_rt(node.children, i);
            pass3_walk(symbols, scopes, diag, child);
            i = i + 1
        end
        out 0
    end

    if node.node_type == AstType.Call do
        found = pass3_lookup_chain(symbols, scopes, scope_current_id(scopes), node.name);
        if found == -1 do
            report_error(diag, 1003, node.line, 0)
        end
        # Resolve arguments
        child_count = vec_len_rt(node.children);
        var i = 0;
        when i < child_count loop
            child = vec_get_rt(node.children, i);
            pass3_walk(symbols, scopes, diag, child);
            i = i + 1
        end
        out 0
    end

    if node.node_type == AstType.MethodCall do
        # UFCS: method name is a top-level function. Look up from the current
        # scope chain (walks to global). Missing name is not fatal if the
        # parser already captured the callee as a function ident.
        found = pass3_lookup_chain(symbols, scopes, scope_current_id(scopes), node.name);
        if found == -1 do
            found = pass3_lookup_chain(symbols, scopes, 0, node.name)
        end
        if found == -1 do
            report_error(diag, 1004, node.line, 0)
        end
        child_count = vec_len_rt(node.children);
        if child_count > 0 do
            receiver = vec_get_rt(node.children, 0);
            pass3_walk(symbols, scopes, diag, receiver)
        end
        # Resolve method arguments
        var i = 1;
        when i < child_count loop
            child = vec_get_rt(node.children, i);
            pass3_walk(symbols, scopes, diag, child);
            i = i + 1
        end
        out 0
    end

    if node.node_type == AstType.BindAttr do
        child_count = vec_len_rt(node.children);
        if child_count > 0 do
            child = vec_get_rt(node.children, 0);
            pass3_walk(symbols, scopes, diag, child);
        end
        out 0
    end

    if node.node_type == AstType.EntityDef or node.node_type == AstType.PackedDef or node.node_type == AstType.RegisterDef or node.node_type == AstType.EnumDef do
        out 0
    end

    if node.node_type == AstType.EntityLiteral do
        child_count = vec_len_rt(node.children);
        var i = 0;
        when i < child_count loop
            child = vec_get_rt(node.children, i);
            pass3_walk(symbols, scopes, diag, child);
            i = i + 1
        end
        out 0
    end

    if node.node_type == AstType.FieldAccess do
        child_count = vec_len_rt(node.children);
        var i = 0;
        when i < child_count loop
            child = vec_get_rt(node.children, i);
            pass3_walk(symbols, scopes, diag, child);
            i = i + 1
        end
        out 0
    end

    if node.node_type == AstType.EnumAccess do
        found = pass3_lookup_chain(symbols, scopes, scope_current_id(scopes), node.name);
        if found == -1 do
            # Could be a qualified lookup, we try to resolve parts if needed
            # But for simplicity, logging it if totally not found globally
            report_error(diag, 1005, node.line, 0)
        end
        out 0
    end

    if node.node_type == AstType.CaseExpr do
        child_count = vec_len_rt(node.children);
        if child_count > 0 do
            # 1. Walk target expression
            target = vec_get_rt(node.children, 0);
            pass3_walk(symbols, scopes, diag, target);

            # 2. Walk each arm: [pat, body, pat, body, ...]
            var i = 1;
            when i + 1 < child_count loop
                pat = vec_get_rt(node.children, i);
                body = vec_get_rt(node.children, i + 1);

                old_scope = scope_current_id(scopes);
                scope_id = scope_push(scopes, ScopeKind.Block);

                if pat.node_type == AstType.Identifier do
                    if not fat_str_eq(pat.name, "_") and not fat_str_eq(pat.name, "true") and not fat_str_eq(pat.name, "false") and not fat_str_eq(pat.name, "None") do
                        found = pass3_lookup_chain(symbols, scopes, 0, pat.name);
                        if found == -1 do
                            pass3_register_local(symbols, scopes, pat.name, SymbolKind.Variable, pat.line);
                        end
                    end
                end

                pass3_walk(symbols, scopes, diag, body);
                scope_pop(scopes);
                i = i + 2;
            end
        end
        out 0
    end
    
    if node.node_type == AstType.WhenStmt do
        old_scope = scope_current_id(scopes);
        scope_id = scope_push(scopes, ScopeKind.Block);
        if fat_str_len(node.name) > 0 do
            pass3_register_local(symbols, scopes, node.name, SymbolKind.Variable, node.line)
        end
        child_count = vec_len_rt(node.children);
        var i = 0;
        when i < child_count loop
            child = vec_get_rt(node.children, i);
            pass3_walk(symbols, scopes, diag, child);
            i = i + 1
        end
        scope_pop(scopes);
        out 0
    end

    if node.node_type == AstType.FuncDef do
        # Push function scope for body
        old_scope = scope_current_id(scopes);
        scope_id = scope_push(scopes, ScopeKind.Func);
        # Register parameters
        child_count = vec_len_rt(node.children);
        if child_count > 0 do
            last_idx = child_count - 1;
            var i = 0;
            when i < last_idx loop
                param = vec_get_rt(node.children, i);
                pass3_register_local(symbols, scopes, param.name, SymbolKind.Param, param.line);
                i = i + 1
            end
            # Walk body
            body = vec_get_rt(node.children, last_idx);
            pass3_walk(symbols, scopes, diag, body)
        end
        scope_pop(scopes);
        out 0
    end

    if node.node_type == AstType.Block do
        old_scope = scope_current_id(scopes);
        scope_id = scope_push(scopes, ScopeKind.Block);
        child_count = vec_len_rt(node.children);
        var i = 0;
        when i < child_count loop
            child = vec_get_rt(node.children, i);
            pass3_walk(symbols, scopes, diag, child);
            i = i + 1
        end
        scope_pop(scopes);
        out 0
    end

    if node.node_type == AstType.TryStmt do
        # `err` is an implicit variable bound to the thrown value inside the
        # revert handler. Register it for the whole try/revert scope.
        old_scope = scope_current_id(scopes);
        scope_id = scope_push(scopes, ScopeKind.Block);
        pass3_register_local(symbols, scopes, fat_str_new("err"), SymbolKind.Variable, node.line);
        child_count = vec_len_rt(node.children);
        var i = 0;
        when i < child_count loop
            child = vec_get_rt(node.children, i);
            pass3_walk(symbols, scopes, diag, child);
            i = i + 1
        end
        scope_pop(scopes);
        out 0
    end

    if node.node_type == AstType.VarDecl or node.node_type == AstType.ConstDecl or node.node_type == AstType.ReactiveDecl do
        is_mut = node.node_type == AstType.VarDecl or node.node_type == AstType.ReactiveDecl;
        if node.int_val == 16384 do
            child_count = vec_len_rt(node.children);
            if child_count > 0 do
                # 1. Resolve initializer (last child)
                init_child = vec_get_rt(node.children, child_count - 1);
                pass3_walk(symbols, scopes, diag, init_child);
                # 2. Register destructure variable names (first child_count - 1 children)
                var i = 0;
                when i < child_count - 1 loop
                    var_ident = vec_get_rt(node.children, i);
                    if is_mut do
                        pass3_register_local(symbols, scopes, var_ident.name, SymbolKind.Variable, var_ident.line);
                    else
                        pass3_register_local(symbols, scopes, var_ident.name, SymbolKind.Const, var_ident.line);
                    end
                    i = i + 1;
                end
            end
        else
            # First resolve initializer, then register the name
            child_count = vec_len_rt(node.children);
            var i = 0;
            when i < child_count loop
                child = vec_get_rt(node.children, i);
                pass3_walk(symbols, scopes, diag, child);
                i = i + 1;
            end
            if is_mut do
                pass3_register_local(symbols, scopes, node.name, SymbolKind.Variable, node.line)
            else
                pass3_register_local(symbols, scopes, node.name, SymbolKind.Const, node.line)
            end
        end
        out 0
    end

    if node.node_type == AstType.BundleExpr do
        child_count = vec_len_rt(node.children);
        var i = 0;
        when i < child_count loop
            child = vec_get_rt(node.children, i);
            pass3_walk(symbols, scopes, diag, child);
            i = i + 1
        end
        if fat_str_len(node.name) > 0 do
            pass3_register_local(symbols, scopes, node.name, SymbolKind.Const, node.line)
        end
        out 0
    end

    if node.node_type == AstType.ExposeAttr do
        child_count = vec_len_rt(node.children);
        if child_count > 0 do
            child = vec_get_rt(node.children, 0);
            pass3_walk(symbols, scopes, diag, child);
        end
        out 0
    end

    if node.node_type == AstType.ShareDecl or node.node_type == AstType.HasDecl do
        if fat_str_len(node.name) > 0 do
            pass3_register_local(symbols, scopes, node.name, SymbolKind.Variable, node.line)
        end
        out 0
    end

    # Default: recurse into children
    child_count = vec_len_rt(node.children);
    var i = 0;
    when i < child_count loop
        child = vec_get_rt(node.children, i);
        pass3_walk(symbols, scopes, diag, child);
        i = i + 1
    end
    out 0
end.
func pass3_lookup_chain(symbols: SymbolTable, scopes: ScopeTree, start_scope: int, name: string):
    if fat_str_len(name) == 0 do
        out -1
    end
    curr = start_scope;
    scopes_vec = native_read_i64(scopes as i64, 0);
    syms_vec = native_read_i64(symbols as i64, 0);
    when curr >= 0 loop
        scope_node = vec_get_rt(scopes_vec, curr);
        sym_list = native_read_i64(scope_node as i64, 16);
        count = vec_len_rt(sym_list);
        var i = 0;
        when i < count loop
            sym_id = vec_get_rt(sym_list, i);
            sym = vec_get_rt(syms_vec, sym_id);
            sym_name = native_read_i64(sym as i64, 8) as string;
            if fat_str_eq(sym_name, name) == 1 do
                out sym_id
            end
            i = i + 1
        end
        curr = native_read_i64(scope_node as i64, 8);
    end
    out -1
end.
func pass3_register_local(symbols: SymbolTable, scopes: ScopeTree, name: string, kind: SymbolKind, line: int):
    if fat_str_len(name) == 0 do
        out 0
    end
    sym = SymbolNode (
        kind: kind,
        name_id: name as i64,
        type_id: 0,
        scope_id: scope_current_id(scopes),
        ast_id: 0,
        is_mutable: kind == SymbolKind.Variable or kind == SymbolKind.Param,
        offset: 0,
        param_count: 0,
        return_type: 0,
        parent_id: -1
    );
    sym_id = symbol_alloc(symbols, sym);
    scope_add_symbol(scopes, scope_current_id(scopes), sym_id);
    out sym_id
end.

export pass3_resolve_names
