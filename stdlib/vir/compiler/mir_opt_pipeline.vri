##
 * vir/compiler/mir_opt_pipeline.vri — Spec §1.2.1 MIR optimizer orchestrator
 * ========================================================================
 * Runs only OptStageMIR passes. Architecture-specific passes are invoked
 * later via opt_backend.vri (SIMD, ISA peephole, shrink-wrap, TCO, IRC).
 ##

include types
include opt_pass
import OptPassConstFold, OptPassStrengthReduce, OptPassCSE, OptPassDCE,
       OptPassLICM, OptPassIVSR, OptPassLoopUnroll, OptPassLoopCollapse, OptPassLoopTiling,
       OptPassBCE, OptPassEscapeArena, OptPassInlining, OptPassGVN, OptPassPRE, OptPassSLP,
       OptPassJumpThread, OptPassSROA, OptPassSCCP, OptPassDAE, OptPassDevirt,
       opt_pass_min_level from opt_pass

include mir_opt
import mir_opt_reset_counters,
       mir_opt_constant_folding, mir_opt_constant_propagation, mir_opt_copy_propagation,
       mir_opt_algebraic_simplification, mir_opt_strength_reduction,
       mir_opt_cse, mir_opt_dce,
       mir_opt_licm, mir_opt_ivsr, mir_opt_loop_unroll, mir_opt_symbolic_loop_collapse,
       mir_opt_loop_tiling_fusion_interchange, mir_opt_loop_idiom_recognizer,
       mir_opt_bce, mir_opt_escape_analysis_and_arena_promotion,
       mir_opt_ipo_inline_cascade, mir_opt_inlining,
       mir_opt_gvn, mir_opt_pre, mir_opt_slp,
       mir_opt_jump_threading, mir_opt_cfg_simplification, mir_opt_branch_folding,
       mir_opt_phi_simplification, mir_opt_redundant_load_store_elimination,
       mir_opt_sroa, mir_opt_sccp, mir_opt_dae, mir_opt_devirtualization,
       mir_opt_zero_cost_abi_and_semantics_tuning,
       mir_opt_inline_bump_arena_fastpath from mir_opt

var g_mir_opt_level: int = 1

func set_mir_opt_level(level: int):
    if level < 0 do
        g_mir_opt_level = 0
    eif level > 3 do
        g_mir_opt_level = 3
    else
        g_mir_opt_level = level
    end
end.

func get_mir_opt_level():
    out g_mir_opt_level
end.

func mir_opt_should_run(pass_id: int, level: int):
    if level <= 0 do
        if pass_id == OptPassConstFold or pass_id == OptPassDCE do out true end
        out false
    end
    out level >= opt_pass_min_level(pass_id)
end.

# Tier-1 .. Tier-6 MIR passes in spec order (IDs 1-26, skipping non-MIR stages).
func mir_opt_run_spec_round(blocks: i64, level: int):
    # 1. Constant folding & propagation
    if mir_opt_should_run(OptPassConstFold, level) do
        blocks = mir_opt_constant_folding(blocks)
        blocks = mir_opt_algebraic_simplification(blocks)
        blocks = mir_opt_constant_propagation(blocks)
        blocks = mir_opt_copy_propagation(blocks)
    end
    # 2. Peephole strength reduction
    if mir_opt_should_run(OptPassStrengthReduce, level) do
        blocks = mir_opt_strength_reduction(blocks)
    end
    # 3. Local CSE
    if mir_opt_should_run(OptPassCSE, level) do
        blocks = mir_opt_cse(blocks)
    end
    # 4. DCE (also run at end)
    if mir_opt_should_run(OptPassDCE, level) do
        blocks = mir_opt_dce(blocks)
    end
    # 5. LICM
    if mir_opt_should_run(OptPassLICM, level) do
        blocks = mir_opt_licm(blocks)
    end
    # 6. IVSR
    if mir_opt_should_run(OptPassIVSR, level) do
        blocks = mir_opt_ivsr(blocks)
    end
    # 7. Loop unroll is disabled until cloned SSA defs/uses are remapped per
    # iteration. Reusing the same vregs makes every copy read the pre-loop
    # value and can also corrupt nested-loop CFGs.
    # 8. Symbolic loop collapse / idiom recognition are disabled until their
    # SSA pattern checks distinguish induction updates from real reductions.
    # 9. Polyhedral tiling (conservative placeholder)
    if mir_opt_should_run(OptPassLoopTiling, level) do
        blocks = mir_opt_loop_tiling_fusion_interchange(blocks)
    end
    # 10 SIMD — OptStageBackend (skipped)
    # 11 TCO — OptStageLIR (skipped)
    # 12 IRC — OptStageLIR (skipped)
    # 13. BCE
    if mir_opt_should_run(OptPassBCE, level) do
        blocks = mir_opt_bce(blocks)
    end
    # 14. Escape analysis & arena promotion
    if mir_opt_should_run(OptPassEscapeArena, level) do
        blocks = mir_opt_escape_analysis_and_arena_promotion(blocks)
        blocks = mir_opt_inline_bump_arena_fastpath(blocks)
    end
    # 15 ARC trial deletion — OptStageBackend (opt_backend_arc.vri, O2+)
    # 16 Orchestrator — outer fixed-point loop (mir_opt_run_spec_pipeline)
    # 17. IPA inlining
    if mir_opt_should_run(OptPassInlining, level) do
        blocks = mir_opt_inlining(blocks)
        blocks = mir_opt_ipo_inline_cascade(blocks)
    end
    # 18. GVN
    if mir_opt_should_run(OptPassGVN, level) do
        blocks = mir_opt_gvn(blocks)
    end
    # 19. PRE
    if mir_opt_should_run(OptPassPRE, level) do
        blocks = mir_opt_pre(blocks)
    end
    # 20. SLP (MIR packing; SIMD lowering is backend)
    if mir_opt_should_run(OptPassSLP, level) do
        blocks = mir_opt_slp(blocks)
    end
    # 21 Shrink-wrap — OptStageLIR (skipped)
    # 22. CFG simplification & jump threading
    if mir_opt_should_run(OptPassJumpThread, level) do
        blocks = mir_opt_jump_threading(blocks)
        blocks = mir_opt_cfg_simplification(blocks)
        blocks = mir_opt_branch_folding(blocks)
        blocks = mir_opt_phi_simplification(blocks)
    end
    # 23. SROA
    if mir_opt_should_run(OptPassSROA, level) do
        blocks = mir_opt_sroa(blocks)
        blocks = mir_opt_redundant_load_store_elimination(blocks)
    end
    # 24. SCCP
    if mir_opt_should_run(OptPassSCCP, level) do
        blocks = mir_opt_sccp(blocks)
    end
    # 25. DAE
    if mir_opt_should_run(OptPassDAE, level) do
        blocks = mir_opt_dae(blocks)
        blocks = mir_opt_zero_cost_abi_and_semantics_tuning(blocks)
    end
    # 26. Devirtualization
    if mir_opt_should_run(OptPassDevirt, level) do
        blocks = mir_opt_devirtualization(blocks)
    end
    out blocks
end.

# Pass 16: multi-pass convergence (O2 = 2 rounds, O3 = 3 rounds).
func mir_opt_run_spec_pipeline(blocks: i64, opt_level: int):
    mir_opt_reset_counters()
    level = opt_level
    if level < 0 do level = 0 end
    if level > 3 do level = 3 end
    g_mir_opt_level = level

    if level == 0 do
        blocks = mir_opt_constant_folding(blocks)
        blocks = mir_opt_dce(blocks)
        out blocks
    end

    rounds = 1
    if level >= 2 do rounds = 2 end
    if level >= 3 do rounds = 3 end

    var r = 0
    when r < rounds loop
        blocks = mir_opt_run_spec_round(blocks, level)
        r = r + 1
    end

    # IPO cascade cleanup: Inlining → SCCP → SROA → DAE → const fold (spec §4.8.6)
    if level >= 2 do
        blocks = mir_opt_sccp(blocks)
        blocks = mir_opt_sroa(blocks)
        blocks = mir_opt_dae(blocks)
        blocks = mir_opt_constant_folding(blocks)
        blocks = mir_opt_dce(blocks)
    end

    out blocks
end.

func mir_optimize_all(blocks: i64):
    out mir_opt_run_spec_pipeline(blocks, 3)
end.

export mir_opt_run_spec_pipeline, mir_opt_run_spec_round, mir_optimize_all,
       set_mir_opt_level, get_mir_opt_level
