##
 * vir/compiler/mir_opt.vri — MIR SSA Optimizations (Vir v2.0 Expansion)
 * ======================================================================
 * Block-local passes with kill-on-redef (safe on SSA and pre-SSA form).
 ##

include types;
include vec_rt;
import vec_new_rt, vec_push_rt, vec_get_rt, vec_set_rt, vec_len_rt from vec_rt;

include mir;
import MirOp, MirOperandType, MirOperand, MirInstr, MirBlock, MirFunc, mir_opnd_imm, mir_opnd_vreg, mir_opnd_none, mir_instr_new, mir_block_new, mir_instr_op, mir_instr_dst, mir_instr_src1, mir_instr_src2, mir_block_id, mir_block_head, mir_block_tail, mir_block_successors, mir_block_preds, mir_block_idom, mir_block_dom_children, mir_block_df, mir_block_next_block, mir_block_phis, mir_opnd_type, mir_opnd_vreg_id, mir_opnd_imm_val from mir;

func mir_instr_defines_vreg(ins: MirInstr, v: i64):
    d = mir_instr_dst(ins);
    if mir_opnd_type(d) == MirOperandType.VReg and mir_opnd_vreg_id(d) == v do
        out true
    end
    out false
end.

func mir_opt_constant_folding(blocks: i64):
    n_blocks = vec_len_rt(blocks);
    var i = 0;

    when i < n_blocks loop
        b = vec_get_rt(blocks, i);
        instrs = mir_block_head(b);
        if instrs >= 0 do
            n_instrs = vec_len_rt(instrs);
            var j = 0;
            when j < n_instrs loop
                ins = vec_get_rt(instrs, j);
                op = mir_instr_op(ins);
                dst = mir_instr_dst(ins);
                s1 = mir_instr_src1(ins);
                s2 = mir_instr_src2(ins);
                s1_t = mir_opnd_type(s1);
                s2_t = mir_opnd_type(s2);

                if op == MirOp.Add and s1_t == MirOperandType.Imm and s2_t == MirOperandType.Imm do
                    new_ins = mir_instr_new(MirOp.Move, dst, mir_opnd_imm(mir_opnd_imm_val(s1) + mir_opnd_imm_val(s2)), mir_opnd_none());
                    vec_set_rt(instrs, j, new_ins)
                eif op == MirOp.Sub and s1_t == MirOperandType.Imm and s2_t == MirOperandType.Imm do
                    new_ins = mir_instr_new(MirOp.Move, dst, mir_opnd_imm(mir_opnd_imm_val(s1) - mir_opnd_imm_val(s2)), mir_opnd_none());
                    vec_set_rt(instrs, j, new_ins)
                eif op == MirOp.Mul and s1_t == MirOperandType.Imm and s2_t == MirOperandType.Imm do
                    new_ins = mir_instr_new(MirOp.Move, dst, mir_opnd_imm(mir_opnd_imm_val(s1) * mir_opnd_imm_val(s2)), mir_opnd_none());
                    vec_set_rt(instrs, j, new_ins)
                eif op == MirOp.Div and s1_t == MirOperandType.Imm and s2_t == MirOperandType.Imm do
                    if mir_opnd_imm_val(s2) != 0 do
                        new_ins = mir_instr_new(MirOp.Move, dst, mir_opnd_imm(mir_opnd_imm_val(s1) / mir_opnd_imm_val(s2)), mir_opnd_none());
                        vec_set_rt(instrs, j, new_ins)
                    end
                eif op == MirOp.Mul and ((s1_t == MirOperandType.Imm and mir_opnd_imm_val(s1) == 0) or (s2_t == MirOperandType.Imm and mir_opnd_imm_val(s2) == 0)) do
                    new_ins = mir_instr_new(MirOp.Move, dst, mir_opnd_imm(0), mir_opnd_none());
                    vec_set_rt(instrs, j, new_ins)
                eif op == MirOp.Add and (s2_t == MirOperandType.Imm and mir_opnd_imm_val(s2) == 0) do
                    new_ins = mir_instr_new(MirOp.Move, dst, s1, mir_opnd_none());
                    vec_set_rt(instrs, j, new_ins)
                eif op == MirOp.Add and (s1_t == MirOperandType.Imm and mir_opnd_imm_val(s1) == 0) do
                    new_ins = mir_instr_new(MirOp.Move, dst, s2, mir_opnd_none());
                    vec_set_rt(instrs, j, new_ins)
                end
                j = j + 1
            end
        end
        i = i + 1
    end
    out blocks
end.

func mir_opt_copy_propagation(blocks: i64):
    n_blocks = vec_len_rt(blocks);
    var i = 0;
    when i < n_blocks loop
        b = vec_get_rt(blocks, i);
        instrs = mir_block_head(b);
        if instrs >= 0 do
            n_instrs = vec_len_rt(instrs);
            var j = 0;
            when j < n_instrs loop
                ins = vec_get_rt(instrs, j);
                op = mir_instr_op(ins);
                dst = mir_instr_dst(ins);
                src1 = mir_instr_src1(ins);
                if op == MirOp.Move and mir_opnd_type(dst) == MirOperandType.VReg and mir_opnd_type(src1) == MirOperandType.VReg do
                    dst_v = mir_opnd_vreg_id(dst);
                    src_v = mir_opnd_vreg_id(src1);
                    var k = j + 1;
                    stop = false;
                    when k < n_instrs and not stop loop
                        ins_next = vec_get_rt(instrs, k);
                        if mir_instr_defines_vreg(ins_next, dst_v) or mir_instr_defines_vreg(ins_next, src_v) do
                            stop = true
                        else
                            changed = false;
                            n_s1 = mir_instr_src1(ins_next);
                            n_s2 = mir_instr_src2(ins_next);
                            if mir_opnd_type(n_s1) == MirOperandType.VReg and mir_opnd_vreg_id(n_s1) == dst_v do
                                n_s1 = mir_opnd_vreg(src_v);
                                changed = true
                            end
                            if mir_opnd_type(n_s2) == MirOperandType.VReg and mir_opnd_vreg_id(n_s2) == dst_v do
                                n_s2 = mir_opnd_vreg(src_v);
                                changed = true
                            end
                            if changed do
                                new_next = mir_instr_new(mir_instr_op(ins_next), mir_instr_dst(ins_next), n_s1, n_s2);
                                vec_set_rt(instrs, k, new_next)
                            end
                            k = k + 1
                        end
                    end
                end
                j = j + 1
            end
        end
        i = i + 1
    end
    out blocks
end.

func mir_opt_cse(blocks: i64):
    n_blocks = vec_len_rt(blocks);
    var i = 0;
    when i < n_blocks loop
        b = vec_get_rt(blocks, i);
        instrs = mir_block_head(b);
        if instrs >= 0 do
            n_instrs = vec_len_rt(instrs);
            var j = 0;
            when j < n_instrs loop
                ins1 = vec_get_rt(instrs, j);
                op1 = mir_instr_op(ins1);
                s1_1 = mir_instr_src1(ins1);
                s2_1 = mir_instr_src2(ins1);
                is_bin = op1 == MirOp.Add or op1 == MirOp.Sub or op1 == MirOp.Mul;
                if is_bin and mir_opnd_type(s1_1) == MirOperandType.VReg and mir_opnd_type(s2_1) == MirOperandType.VReg do
                    var k = j + 1;
                    stop = false;
                    when k < n_instrs and not stop loop
                        ins2 = vec_get_rt(instrs, k);
                        if mir_instr_defines_vreg(ins2, mir_opnd_vreg_id(s1_1)) or mir_instr_defines_vreg(ins2, mir_opnd_vreg_id(s2_1)) do
                            stop = true
                        else
                            op2 = mir_instr_op(ins2);
                            s1_2 = mir_instr_src1(ins2);
                            s2_2 = mir_instr_src2(ins2);
                            if op2 == op1 and mir_opnd_type(s1_2) == MirOperandType.VReg and mir_opnd_type(s2_2) == MirOperandType.VReg do
                                if mir_opnd_vreg_id(s1_2) == mir_opnd_vreg_id(s1_1) and mir_opnd_vreg_id(s2_2) == mir_opnd_vreg_id(s2_1) do
                                    new_ins2 = mir_instr_new(MirOp.Move, mir_instr_dst(ins2), mir_instr_dst(ins1), mir_opnd_none());
                                    vec_set_rt(instrs, k, new_ins2)
                                end
                            end
                            k = k + 1
                        end
                    end
                end
                j = j + 1
            end
        end
        i = i + 1
    end
    out blocks
end.

func mir_opt_dce(blocks: i64):
    n_blocks = vec_len_rt(blocks);
    var i = 0;
    when i < n_blocks loop
        b = vec_get_rt(blocks, i);
        instrs = mir_block_head(b);
        if instrs >= 0 do
            n_instrs = vec_len_rt(instrs);
            new_instrs = vec_new_rt();
            var j = 0;
            when j < n_instrs loop
                ins = vec_get_rt(instrs, j);
                op = mir_instr_op(ins);
                dst = mir_instr_dst(ins);
                src1 = mir_instr_src1(ins);
                is_dead = false;
                if op == MirOp.Nop do
                    is_dead = true
                end
                if op == MirOp.Move and mir_opnd_type(dst) == MirOperandType.VReg and mir_opnd_type(src1) == MirOperandType.VReg do
                    if mir_opnd_vreg_id(dst) == mir_opnd_vreg_id(src1) do
                        is_dead = true
                    end
                end
                if not is_dead do
                    new_instrs = vec_push_rt(new_instrs, ins)
                end
                j = j + 1
            end
            b_new = mir_block_new(
                mir_block_id(b),
                mir_block_phis(b),
                new_instrs,
                mir_block_tail(b),
                mir_block_successors(b),
                mir_block_preds(b),
                mir_block_idom(b),
                mir_block_dom_children(b),
                mir_block_df(b),
                mir_block_next_block(b)
            );
            vec_set_rt(blocks, i, b_new)
        end
        i = i + 1
    end
    out blocks
end.

func mir_opt_bce(blocks: i64):
    out blocks
end.

func mir_opt_pass_fusion(blocks: i64):
    out blocks
end.

func mir_optimize_all(blocks: i64):
    blocks = mir_opt_constant_folding(blocks);
    blocks = mir_opt_copy_propagation(blocks);
    blocks = mir_opt_cse(blocks);
    blocks = mir_opt_dce(blocks);
    out blocks
end.

export mir_opt_constant_folding, mir_opt_copy_propagation, mir_opt_cse, mir_opt_dce, mir_opt_bce, mir_opt_pass_fusion, mir_optimize_all
