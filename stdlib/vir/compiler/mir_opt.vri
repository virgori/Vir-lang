include mir
import MirOp, MirOperandType, MirOperand, MirInstr, MirBlock, MirFunc, mir_opnd_imm, mir_opnd_vreg, mir_opnd_none, mir_instr_new, mir_block_new, mir_instr_op, mir_instr_dst, mir_instr_src1, mir_instr_src2, mir_block_id, mir_block_head, mir_block_replace_head, mir_block_tail, mir_block_successors, mir_block_preds, mir_block_idom, mir_block_dom_children, mir_block_df, mir_block_next_block, mir_block_phis, mir_phi_new, mir_phi_dst, mir_phi_orig_vreg, mir_phi_incoming_values, mir_phi_incoming_blocks, mir_opnd_type, mir_opnd_vreg_id, mir_opnd_imm_val, mir_opnd_block_id, mir_func_name, mir_func_blocks, mir_func_strings, mir_func_next_vreg, MIR_INTR_BUILTIN, MIR_INTR_PARAM, MIR_INTR_SAFE_ACCESS, MIR_INTR_INDEX, MIR_INTR_FIELD, MIR_INTR_ENTITY, MIR_INTR_TUPLE, MIR_INTR_ADDR_OF, MIR_INTR_ARENA, MIR_INTR_PATCH_POINT, MIR_INTR_NOP_MARKER, MIR_INTR_SWIZZLE from mir
import MirOp, MirOperandType, MirOperand, MirInstr, MirBlock, MirFunc, mir_opnd_imm, mir_opnd_vreg, mir_opnd_none, mir_instr_new, mir_instr_aux, mir_instr_set_aux, mir_block_new, mir_instr_op, mir_instr_dst, mir_instr_src1, mir_instr_src2, mir_block_id, mir_block_head, mir_block_replace_head, mir_block_tail, mir_block_successors, mir_block_preds, mir_block_idom, mir_block_dom_children, mir_block_df, mir_block_next_block, mir_block_phis, mir_phi_new, mir_phi_dst, mir_phi_orig_vreg, mir_phi_incoming_values, mir_phi_incoming_blocks, mir_opnd_type, mir_opnd_vreg_id, mir_opnd_imm_val, mir_opnd_block_id, mir_func_name, mir_func_blocks, mir_func_strings, mir_func_next_vreg, MIR_INTR_BUILTIN, MIR_INTR_PARAM, MIR_INTR_SAFE_ACCESS, MIR_INTR_INDEX, MIR_INTR_FIELD, MIR_INTR_ENTITY, MIR_INTR_TUPLE, MIR_INTR_ADDR_OF, MIR_INTR_ARENA, MIR_INTR_PATCH_POINT, MIR_INTR_NOP_MARKER, MIR_INTR_SWIZZLE from mir
import MirOp, MirOperandType, MirOperand, MirInstr, MirBlock, MirFunc, mir_opnd_imm, mir_opnd_vreg, mir_opnd_none, mir_instr_new, mir_instr_aux, mir_instr_set_aux, mir_instr_type, mir_instr_set_type, mir_instr_alloc_kind, mir_instr_set_alloc_kind, mir_instr_region, mir_instr_set_region, mir_instr_epoch, mir_instr_set_epoch, mir_instr_size, mir_instr_set_size, mir_instr_align, mir_instr_set_align, mir_instr_owner_id, mir_instr_set_owner_id, mir_instr_alloc_id, mir_instr_set_alloc_id, mir_instr_provenance, mir_instr_set_provenance, mir_instr_parent_rel, mir_instr_set_parent_rel, mir_instr_src_origin, mir_instr_set_src_origin, mir_block_new, mir_instr_op, mir_instr_dst, mir_instr_src1, mir_instr_src2, mir_block_id, mir_block_head, mir_block_replace_head, mir_block_tail, mir_block_successors, mir_block_preds, mir_block_idom, mir_block_dom_children, mir_block_df, mir_block_next_block, mir_block_phis, mir_phi_new, mir_phi_dst, mir_phi_orig_vreg, mir_phi_incoming_values, mir_phi_incoming_blocks, mir_opnd_type, mir_opnd_vreg_id, mir_opnd_imm_val, mir_opnd_block_id, mir_func_name, mir_func_blocks, mir_func_strings, mir_func_next_vreg, MIR_INTR_BUILTIN, MIR_INTR_PARAM, MIR_INTR_SAFE_ACCESS, MIR_INTR_INDEX, MIR_INTR_INDEX_STORE, MIR_INTR_THROW, MIR_INTR_REVERT, MIR_INTR_FIELD, MIR_INTR_ENTITY, MIR_INTR_TUPLE, MIR_INTR_ADDR_OF, MIR_INTR_ARENA, MIR_INTR_PATCH_POINT, MIR_INTR_NOP_MARKER, MIR_INTR_SWIZZLE, MIR_MEM_MARK, MIR_MEM_RESET, MIR_MEM_PROMOTE, MIR_MEM_DROP, MIR_MEM_ALLOC from mir
include target
import target_simd_width_bytes from target

include string_rt
import rt_streq, fat_str_eq from string_rt

var g_mir_opt_last_changes: i64 = 0
var g_mir_opt_total_changes: i64 = 0
var g_mir_opt_program: i64 = -1
var g_mir_opt_current_func: i64 = 0
var g_mir_mutate_mode: int = 0

func set_mir_mutate_mode(m: int):
    g_mir_mutate_mode = m
end.

const MIR_INLINE_MAX_INSTRS: i64 = 40
const MIR_SROA_MAX_FIELDS: i64 = 4
const MIR_UNROLL_MAX: i64 = 4
const MIR_BCE_MARKER: i64 = 77
const MIR_SHRINK_WRAP_MARKER: i64 = 88
const MIR_HOT_BLOCK_MARKER: i64 = 99
const MIR_COLD_BLOCK_MARKER: i64 = 100
const MIR_ARC_RETAIN: i64 = 201
const MIR_ARC_RELEASE: i64 = 202
const MIR_ARC_TRIAL: i64 = 203

# Inline budget: maximum total instructions allowed in the caller after inlining.
# Prevents exponential IR growth when many small leaf helpers are inlined into a
# large function (e.g. rt.alloc TLSF helpers at -O2/-O3).
const MIR_INLINE_CALLER_BUDGET: i64 = 300

# Inline visit table — flat fixed-size hash table that tracks which callee names
# have already been inlined during the current mir_opt_inlining pass.
# Capacity must be a power of two; 64 slots covers typical leaf-helper counts.
const MIR_INLINE_VISIT_SLOTS: i64 = 64
const MIR_INLINE_VISIT_MASK: i64 = 63
var g_inline_visit: i64 = 0      # vec handle; 0 = uninitialized
var g_inline_pass_epoch: i64 = 0  # incremented each inlining pass; slots are invalidated by mismatch

func mir_opt_set_program(program: i64):
    g_mir_opt_program = program
end.

func mir_opt_set_current_func(func_obj: i64):
    g_mir_opt_current_func = func_obj
end.

func mir_opt_reset_counters():
    g_mir_opt_last_changes = 0
    g_mir_opt_total_changes = 0
end.

func mir_opt_note_change():
    g_mir_opt_last_changes = g_mir_opt_last_changes + 1
    g_mir_opt_total_changes = g_mir_opt_total_changes + 1
end.

func mir_opt_get_last_changes():
    out g_mir_opt_last_changes
end.

func mir_opt_get_total_changes():
    out g_mir_opt_total_changes
end.

func mir_instr_defines_vreg(ins: &MirInstr, v: i64):
    d = mir_instr_dst(ins)
    if mir_opnd_type(d) == MirOperandType.VReg and mir_opnd_vreg_id(d) == v do
        out true
    end
    out false
end.

func mir_copy_instr_metadata(src: &MirInstr, dst: &MirInstr):
    mir_instr_set_aux(dst, mir_instr_aux(src))
    mir_instr_set_type(dst, mir_instr_type(src))
    mir_instr_set_alloc_kind(dst, mir_instr_alloc_kind(src))
    mir_instr_set_region(dst, mir_instr_region(src))
    mir_instr_set_epoch(dst, mir_instr_epoch(src))
    mir_instr_set_size(dst, mir_instr_size(src))
    mir_instr_set_align(dst, mir_instr_align(src))
    mir_instr_set_owner_id(dst, mir_instr_owner_id(src))
    mir_instr_set_alloc_id(dst, mir_instr_alloc_id(src))
    mir_instr_set_provenance(dst, mir_instr_provenance(src))
    mir_instr_set_parent_rel(dst, mir_instr_parent_rel(src))
    mir_instr_set_src_origin(dst, mir_instr_src_origin(src))
    out dst
end.

func mir_opt_constant_folding(blocks: i64):
    n_blocks = vec_len_rt(blocks)
    var i = 0

    when i < n_blocks loop
        b = vec_get_rt(blocks, i)
        instrs = mir_block_head(b)
        if instrs >= 0 do
            n_instrs = vec_len_rt(instrs)
            var j = 0
            when j < n_instrs loop
                ins = vec_get_rt(instrs, j)
                op = mir_instr_op(ins)
                dst = mir_instr_dst(ins)
                s1 = mir_instr_src1(ins)
                s2 = mir_instr_src2(ins)
                s1_t = mir_opnd_type(s1)
                s2_t = mir_opnd_type(s2)

                if s1_t == MirOperandType.Imm and s2_t == MirOperandType.Imm do
                    var (ok, val) = mir_eval_const_binary_typed(op, mir_opnd_imm_val(s1), mir_opnd_imm_val(s2), mir_instr_type(ins))
                    if ok do
                        new_ins = mir_instr_new(MirOp.Move, dst, mir_opnd_imm(val), mir_opnd_none())
                        vec_set_rt(instrs, j, new_ins)
                        mir_opt_note_change()
                    end
                eif op == MirOp.Not and s1_t == MirOperandType.Imm do
                    new_not = mir_instr_new(MirOp.Move, dst, mir_opnd_imm(mir_opnd_imm_val(s1) xor (0 - 1)), mir_opnd_none())
                    vec_set_rt(instrs, j, new_not)
                    mir_opt_note_change()
                end
                j = j + 1
            end
        end
        i = i + 1
    end
    out blocks
end.

func count_vreg_defs_mir(blocks: i64, target_vreg: i64):
    n_blocks = vec_len_rt(blocks)
    var def_cnt = 0
    var i = 0
    when i < n_blocks loop
        b = vec_get_rt(blocks, i)
        instrs = mir_block_head(b)
        if instrs >= 0 do
            n_instrs = vec_len_rt(instrs)
            var j = 0
            when j < n_instrs loop
                ins = vec_get_rt(instrs, j)
                if mir_instr_defines_vreg(ins, target_vreg) do
                    def_cnt = def_cnt + 1
                end
                j = j + 1
            end
        end
        i = i + 1
    end
    out def_cnt
end.

# O(B*I) vreg def-count table; index = vreg id. Avoids repeated full-block scans.
func mir_build_vreg_def_counts(blocks: i64):
    counts = vec_new_rt()
    n_blocks = vec_len_rt(blocks)
    var i = 0
    when i < n_blocks loop
        instrs = mir_block_head(vec_get_rt(blocks, i))
        if instrs >= 0 do
            var j = 0
            when j < vec_len_rt(instrs) loop
                ins = vec_get_rt(instrs, j)
                dst = mir_instr_dst(ins)
                if mir_opnd_type(dst) == MirOperandType.VReg do
                    vid = mir_opnd_vreg_id(dst)
                    if vid >= 0 do
                        cl = vec_len_rt(counts)
                        when cl <= vid loop
                            counts = vec_push_rt(counts, 0)
                            cl = cl + 1
                        end
                        vec_set_rt(counts, vid, vec_get_rt(counts, vid) + 1)
                    end
                end
                j = j + 1
            end
        end
        i = i + 1
    end
    out counts
end.

func mir_vreg_def_count(def_counts: i64, vreg: i64):
    if def_counts < 0 do out 0 end
    if vreg < 0 or vreg >= vec_len_rt(def_counts) do out 0 end
    out vec_get_rt(def_counts, vreg)
end.

func mir_opt_copy_propagation(blocks: i64):
    def_counts = mir_build_vreg_def_counts(blocks)
    n_blocks = vec_len_rt(blocks)
    var i = 0
    when i < n_blocks loop
        b = vec_get_rt(blocks, i)
        instrs = mir_block_head(b)
        if instrs >= 0 do
            n_instrs = vec_len_rt(instrs)
            var j = 0
            when j < n_instrs loop
                ins = vec_get_rt(instrs, j)
                op = mir_instr_op(ins)
                dst = mir_instr_dst(ins)
                src1 = mir_instr_src1(ins)
                if op == MirOp.Move and mir_opnd_type(dst) == MirOperandType.VReg do
                    dst_v = mir_opnd_vreg_id(dst)
                    if mir_vreg_def_count(def_counts, dst_v) == 1 do
                        is_prop_vreg = mir_opnd_type(src1) == MirOperandType.VReg
                        is_prop_imm = mir_opnd_type(src1) == MirOperandType.Imm
                        if is_prop_vreg or is_prop_imm do
                            var k = j + 1
                            var stop = false
                            when k < n_instrs and not stop loop
                                ins_next = vec_get_rt(instrs, k)
                                if mir_instr_defines_vreg(ins_next, dst_v) do
                                    stop = true
                                else
                                    if is_prop_vreg do
                                        if mir_instr_defines_vreg(ins_next, mir_opnd_vreg_id(src1)) do
                                            stop = true
                                        end
                                    end
                                    if not stop do
                                        var changed = false
                                        n_s1 = mir_instr_src1(ins_next)
                                        n_s2 = mir_instr_src2(ins_next)
                                        if mir_opnd_type(n_s1) == MirOperandType.VReg and mir_opnd_vreg_id(n_s1) == dst_v do
                                            n_s1 = src1
                                            changed = true
                                        end
                                        if mir_opnd_type(n_s2) == MirOperandType.VReg and mir_opnd_vreg_id(n_s2) == dst_v do
                                            n_s2 = src1
                                            changed = true
                                        end
                                        if changed do
                                            new_next = mir_instr_new(mir_instr_op(ins_next), mir_instr_dst(ins_next), n_s1, n_s2)
                                            mir_copy_instr_metadata(ins_next, new_next)
                                            vec_set_rt(instrs, k, new_next)
                                            mir_opt_note_change()
                                        end
                                    end
                                    k = k + 1
                                end
                            end
                        end
                    end
                end
                j = j + 1
            end
        end
        i = i + 1
    end
    vec_free_rt(def_counts)
    out blocks
end.

func mir_opt_constant_propagation(blocks: i64):
    def_counts = mir_build_vreg_def_counts(blocks)
    n_blocks = vec_len_rt(blocks)
    var i = 0
    when i < n_blocks loop
        instrs = mir_block_head(vec_get_rt(blocks, i))
        if instrs >= 0 do
            n_instrs = vec_len_rt(instrs)
            var j = 0
            when j < n_instrs loop
                ins = vec_get_rt(instrs, j)
                if mir_instr_op(ins) == MirOp.Move and mir_opnd_type(mir_instr_dst(ins)) == MirOperandType.VReg and mir_opnd_type(mir_instr_src1(ins)) == MirOperandType.Imm do
                    dst_v = mir_opnd_vreg_id(mir_instr_dst(ins))
                    if mir_vreg_def_count(def_counts, dst_v) == 1 do
                        blocks = mir_rewrite_uses_from(blocks, dst_v, mir_instr_src1(ins))
                    end
                end
                j = j + 1
            end
        end
        i = i + 1
    end
    vec_free_rt(def_counts)
    out blocks
end.

func mir_opt_cse(blocks: i64):
    n_blocks = vec_len_rt(blocks)
    var i = 0
    when i < n_blocks loop
        b = vec_get_rt(blocks, i)
        instrs = mir_block_head(b)
        if instrs >= 0 do
            n_instrs = vec_len_rt(instrs)
            var j = 0
            when j < n_instrs loop
                ins1 = vec_get_rt(instrs, j)
                op1 = mir_instr_op(ins1)
                s1_1 = mir_instr_src1(ins1)
                s2_1 = mir_instr_src2(ins1)
                if mir_gvn_candidate(op1) and mir_opnd_type(mir_instr_dst(ins1)) == MirOperandType.VReg do
                    var k = j + 1
                    var stop = false
                    dst1_v = -1
                    if mir_opnd_type(mir_instr_dst(ins1)) == MirOperandType.VReg do
                        dst1_v = mir_opnd_vreg_id(mir_instr_dst(ins1))
                    end
                    when k < n_instrs and not stop loop
                        ins2 = vec_get_rt(instrs, k)
                        if mir_instr_redefines_operand(ins2, s1_1) or mir_instr_redefines_operand(ins2, s2_1) or (dst1_v >= 0 and mir_instr_defines_vreg(ins2, dst1_v)) do
                            stop = true
                        else
                            if mir_gvn_expr_same(ins2, op1, s1_1, s2_1) and mir_opnd_type(mir_instr_dst(ins2)) == MirOperandType.VReg do
                                new_ins2 = mir_instr_new(MirOp.Move, mir_instr_dst(ins2), mir_instr_dst(ins1), mir_opnd_none())
                                vec_set_rt(instrs, k, new_ins2)
                                mir_opt_note_change()
                            end
                            k = k + 1
                        end
                    end
                end
                j = j + 1
            end
        end
        i = i + 1
    end
    out blocks
end.

func mir_instr_redefines_operand(ins: &MirInstr, opnd: &MirOperand):
    if mir_opnd_type(opnd) == MirOperandType.VReg do
        out mir_instr_defines_vreg(ins, mir_opnd_vreg_id(opnd))
    end
    out false
end.

func count_vreg_uses_mir(blocks: i64, n_vregs: i64):
    uses = vec_new_rt()
    var vi = 0
    when vi < n_vregs loop
        uses = vec_push_rt(uses, 0)
        vi = vi + 1
    end
    n_blocks = vec_len_rt(blocks)
    var i = 0
    when i < n_blocks loop
        b = vec_get_rt(blocks, i)
        instrs = mir_block_head(b)
        if instrs >= 0 do
            n_instrs = vec_len_rt(instrs)
            var j = 0
            when j < n_instrs loop
                ins = vec_get_rt(instrs, j)
                s1 = mir_instr_src1(ins)
                s2 = mir_instr_src2(ins)
                if mir_opnd_type(s1) == MirOperandType.VReg do
                    v1 = mir_opnd_vreg_id(s1)
                    if v1 >= 0 and v1 < n_vregs do
                        cnt = vec_get_rt(uses, v1)
                        vec_set_rt(uses, v1, cnt + 1)
                    end
                end
                if mir_opnd_type(s2) == MirOperandType.VReg do
                    v2 = mir_opnd_vreg_id(s2)
                    if v2 >= 0 and v2 < n_vregs do
                        cnt2 = vec_get_rt(uses, v2)
                        vec_set_rt(uses, v2, cnt2 + 1)
                    end
                end
                let op_u = mir_instr_op(ins)
                if op_u >= MirOp.VLoad as i64 and op_u <= MirOp.Shuffle as i64 do
                    let d_u = mir_instr_dst(ins)
                    if mir_opnd_type(d_u) == MirOperandType.VReg do
                        let vd = mir_opnd_vreg_id(d_u)
                        if vd >= 0 and vd < n_vregs do
                            let cntd = vec_get_rt(uses, vd)
                            vec_set_rt(uses, vd, cntd + 1)
                        end
                    end
                end
                j = j + 1
            end
        end
        phis = mir_block_phis(b)
        if phis >= 0 do
            n_phis = vec_len_rt(phis)
            var p = 0
            when p < n_phis loop
                phi = vec_get_rt(phis, p)
                inc_vals = mir_phi_incoming_values(phi)
                n_inc = vec_len_rt(inc_vals)
                var k = 0
                when k < n_inc loop
                    val = vec_get_rt(inc_vals, k)
                    if mir_opnd_type(val) == MirOperandType.VReg do
                        pv = mir_opnd_vreg_id(val)
                        if pv >= 0 and pv < n_vregs do
                            cntp = vec_get_rt(uses, pv)
                            vec_set_rt(uses, pv, cntp + 1)
                        end
                    end
                    k = k + 1
                end
                p = p + 1
            end
        end
        i = i + 1
    end
    out uses
end.

func max_vreg_mir(blocks: i64):
    var max_v = 0
    n_blocks = vec_len_rt(blocks)
    var i = 0
    when i < n_blocks loop
        b = vec_get_rt(blocks, i)
        instrs = mir_block_head(b)
        if instrs >= 0 do
            n_instrs = vec_len_rt(instrs)
            var j = 0
            when j < n_instrs loop
                ins = vec_get_rt(instrs, j)
                d = mir_instr_dst(ins)
                s1 = mir_instr_src1(ins)
                s2 = mir_instr_src2(ins)
                if mir_opnd_type(d) == MirOperandType.VReg and mir_opnd_vreg_id(d) > max_v do max_v = mir_opnd_vreg_id(d) end
                if mir_opnd_type(s1) == MirOperandType.VReg and mir_opnd_vreg_id(s1) > max_v do max_v = mir_opnd_vreg_id(s1) end
                if mir_opnd_type(s2) == MirOperandType.VReg and mir_opnd_vreg_id(s2) > max_v do max_v = mir_opnd_vreg_id(s2) end
                j = j + 1
            end
        end
        i = i + 1
    end
    out max_v + 1
end.

func is_pure_mir_op(op: i64):
    if op == MirOp.Move as i64 or op == MirOp.Add as i64 or op == MirOp.Sub as i64 or op == MirOp.Mul as i64 or op == MirOp.Div as i64 or op == MirOp.Mod as i64 or op == MirOp.Shl as i64 or op == MirOp.Shr as i64 or op == MirOp.And as i64 or op == MirOp.Or as i64 or op == MirOp.Xor as i64 or op == MirOp.Not as i64 or op == MirOp.CmpEq as i64 or op == MirOp.CmpNe as i64 or op == MirOp.CmpGt as i64 or op == MirOp.CmpLt as i64 or op == MirOp.CmpGe as i64 or op == MirOp.CmpLe as i64 do
        out true
    end
    out false
end.

func mir_opt_dce(blocks: i64):
    n_vregs = max_vreg_mir(blocks)
    if n_vregs <= 0 do out blocks end
    uses = count_vreg_uses_mir(blocks, n_vregs)

    # Tables to track definition for each vreg
    def_ins_tab = vec_new_rt()
    var vi = 0
    when vi < n_vregs loop
        def_ins_tab = vec_push_rt(def_ins_tab, 0)
        vi = vi + 1
    end

    worklist = vec_new_rt()
    n_blocks = vec_len_rt(blocks)
    var bi = 0
    when bi < n_blocks loop
        b = vec_get_rt(blocks, bi)
        instrs = mir_block_head(b)
        if instrs >= 0 do
            n_instrs = vec_len_rt(instrs)
            var j = 0
            when j < n_instrs loop
                ins = vec_get_rt(instrs, j)
                op = mir_instr_op(ins)
                dst = mir_instr_dst(ins)
                src1 = mir_instr_src1(ins)

                if op == MirOp.Nop as i64 do
                    # already dead
                eif op == MirOp.Move as i64 & mir_opnd_type(dst) == MirOperandType.VReg & mir_opnd_type(src1) == MirOperandType.VReg & mir_opnd_vreg_id(dst) == mir_opnd_vreg_id(src1) do
                    native_write_i64(ins as i64, 0, MirOp.Nop as i64)
                    mir_opt_note_change()
                eif mir_opnd_type(dst) == MirOperandType.VReg & (op < MirOp.VLoad as i64 or op > MirOp.Shuffle as i64) do
                    dst_v = mir_opnd_vreg_id(dst)
                    if dst_v >= 0 & dst_v < n_vregs do
                        vec_set_rt(def_ins_tab, dst_v, ins)
                        if is_pure_mir_op(op) & vec_get_rt(uses, dst_v) == 0 do
                            worklist = vec_push_rt(worklist, dst_v)
                        end
                    end
                end
                j = j + 1
            end
        end
        bi = bi + 1
    end

    # Process dead worklist recursively
    var wl_head = 0
    when wl_head < vec_len_rt(worklist) loop
        dead_v = vec_get_rt(worklist, wl_head)
        wl_head = wl_head + 1
        d_ins = vec_get_rt(def_ins_tab, dead_v)
        if d_ins != 0 do
            d_op = mir_instr_op(d_ins)
            if d_op != MirOp.Nop as i64 do
                native_write_i64(d_ins as i64, 0, MirOp.Nop as i64)
                mir_opt_note_change()

                # Decrement uses of operands
                s1 = mir_instr_src1(d_ins)
                if mir_opnd_type(s1) == MirOperandType.VReg do
                    s1_v = mir_opnd_vreg_id(s1)
                    if s1_v >= 0 & s1_v < n_vregs do
                        cnt = vec_get_rt(uses, s1_v) - 1
                        vec_set_rt(uses, s1_v, cnt)
                        if cnt == 0 do
                            p_ins = vec_get_rt(def_ins_tab, s1_v)
                            if p_ins != 0 do
                                if is_pure_mir_op(mir_instr_op(p_ins)) do
                                    worklist = vec_push_rt(worklist, s1_v)
                                end
                            end
                        end
                    end
                end

                s2 = mir_instr_src2(d_ins)
                if mir_opnd_type(s2) == MirOperandType.VReg do
                    s2_v = mir_opnd_vreg_id(s2)
                    if s2_v >= 0 & s2_v < n_vregs do
                        cnt2 = vec_get_rt(uses, s2_v) - 1
                        vec_set_rt(uses, s2_v, cnt2)
                        if cnt2 == 0 do
                            p_ins2 = vec_get_rt(def_ins_tab, s2_v)
                            if p_ins2 != 0 do
                                if is_pure_mir_op(mir_instr_op(p_ins2)) do
                                    worklist = vec_push_rt(worklist, s2_v)
                                end
                            end
                        end
                    end
                end
            end
        end
    end

    # Single sweep: in-place compact instructions omitting Nop
    bi = 0
    when bi < n_blocks loop
        b = vec_get_rt(blocks, bi)
        instrs = mir_block_head(b)
        if instrs >= 0 do
            n_instrs = vec_len_rt(instrs)
            var write_idx = 0
            var j = 0
            var has_nop = 0
            when j < n_instrs loop
                ins = vec_get_rt(instrs, j)
                if mir_instr_op(ins) != MirOp.Nop as i64 do
                    if write_idx != j do
                        vec_set_rt(instrs, write_idx, ins)
                    end
                    write_idx = write_idx + 1
                else
                    has_nop = 1
                end
                j = j + 1
            end
            if has_nop == 1 do
                native_write_i64(instrs - 8, 0, write_idx)
            end
        end
        bi = bi + 1
    end
    vec_free_rt(uses)
    vec_free_rt(def_ins_tab)
    vec_free_rt(worklist)
    out blocks
end.

##
 * mir_opt_strength_reduction — Replace expensive ops with cheaper equivalents.
 * Mul(v, 2^k) -> Shl(v, k). Signed Div/Mod by pow2 is not rewritten
 * without non-negative range facts because shift/and do not match all i64 inputs.
 ##
func mir_log2(v: i64):
    var k = 0
    x = v
    when x > 1 loop
        x = x / 2
        k = k + 1
    end
    out k
end.

func mir_is_pow2(v: i64):
    if v <= 0 do
        out false
    end
    out (v and (v - 1)) == 0
end.

func mir_opt_strength_reduction(blocks: i64):
    n_blocks = vec_len_rt(blocks)
    var i = 0
    when i < n_blocks loop
        b = vec_get_rt(blocks, i)
        instrs = mir_block_head(b)
        if instrs >= 0 do
            n_instrs = vec_len_rt(instrs)
            var j = 0
            when j < n_instrs loop
                ins = vec_get_rt(instrs, j)
                op = mir_instr_op(ins)
                dst = mir_instr_dst(ins)
                s1 = mir_instr_src1(ins)
                s2 = mir_instr_src2(ins)
                s1_t = mir_opnd_type(s1)
                s2_t = mir_opnd_type(s2)
                # Mul(v, 2^k) → Shl(v, k)
                if op == MirOp.Mul and mir_instr_type(ins) != 7 do # MirType.F64
                    if s2_t == MirOperandType.Imm do
                        imm_v = mir_opnd_imm_val(s2)
                        if mir_is_pow2(imm_v) do
                            new_ins = mir_instr_new(MirOp.Shl, dst, s1, mir_opnd_imm(mir_log2(imm_v)))
                            vec_set_rt(instrs, j, new_ins)
                            mir_opt_note_change()
                        end
                    eif s1_t == MirOperandType.Imm do
                        imm_v = mir_opnd_imm_val(s1)
                        if mir_is_pow2(imm_v) do
                            new_ins = mir_instr_new(MirOp.Shl, dst, s2, mir_opnd_imm(mir_log2(imm_v)))
                            vec_set_rt(instrs, j, new_ins)
                            mir_opt_note_change()
                        end
                    end
                end
                j = j + 1
            end
        end
        i = i + 1
    end
    out blocks
end.

func mir_is_control_terminator(op: i64):
    out op == MirOp.Jump or op == MirOp.JumpIf or op == MirOp.JumpIfNot or op == MirOp.Return
end.

func mir_block_insert_before_terminator(instrs: i64, ins: &MirInstr):
    n = vec_len_rt(instrs)
    insert_at = n
    var scan = n - 1
    when scan >= 0 loop
        op = mir_instr_op(vec_get_rt(instrs, scan))
        if mir_is_control_terminator(op) do
            insert_at = scan
        end
        scan = scan - 1
    end
    new_instrs = vec_new_rt()
    var j = 0
    when j < n loop
        if j == insert_at do
            new_instrs = vec_push_rt(new_instrs, ins)
        end
        new_instrs = vec_push_rt(new_instrs, vec_get_rt(instrs, j))
        j = j + 1
    end
    if insert_at == n do
        new_instrs = vec_push_rt(new_instrs, ins)
    end
    out new_instrs
end.

func mir_find_block_index(blocks: i64, block_id: i64):
    n_blocks = vec_len_rt(blocks)
    var i = 0
    when i < n_blocks loop
        if mir_block_id(vec_get_rt(blocks, i)) == block_id do out i end
        i = i + 1
    end
    out 0 - 1
end.

func mir_find_loop_preheader(blocks: i64, hdr_idx: i64, back_edge_body_id: i64):
    hdr = vec_get_rt(blocks, hdr_idx)
    preds = mir_block_preds(hdr)
    if preds < 0 do out 0 - 1 end
    var pi = 0
    when pi < vec_len_rt(preds) loop
        pred_id = vec_get_rt(preds, pi)
        if pred_id != back_edge_body_id do
            out mir_find_block_index(blocks, pred_id)
        end
        pi = pi + 1
    end
    out 0 - 1
end.

func mir_vreg_defined_in_body(blocks: i64, body_idx: i64, v: i64, except_idx: i64):
    instrs = mir_block_head(vec_get_rt(blocks, body_idx))
    if instrs < 0 do out false end
    var ji = 0
    when ji < vec_len_rt(instrs) loop
        if ji != except_idx do
            ins = vec_get_rt(instrs, ji)
            if mir_instr_defines_vreg(ins, v) do out true end
        end
        ji = ji + 1
    end
    out false
end.

func mir_opt_licm_hoistable(op: i64):
    if is_pure_mir_op(op) do out true end
    if op == MirOp.Load do out true end
    out false
end.

func mir_opt_licm_operands_invariant(blocks: i64, body_idx: i64, op: i64, ins: &MirInstr, def_counts: i64):
    s1 = mir_instr_src1(ins)
    if op == MirOp.Not do
        out mir_opt_operand_loop_invariant(blocks, body_idx, s1, def_counts)
    end
    if op == MirOp.Load do
        s2 = mir_instr_src2(ins)
        out mir_opt_operand_loop_invariant(blocks, body_idx, s1, def_counts) and mir_opt_operand_loop_invariant(blocks, body_idx, s2, def_counts)
    end
    s2 = mir_instr_src2(ins)
    out mir_opt_operand_loop_invariant(blocks, body_idx, s1, def_counts) and mir_opt_operand_loop_invariant(blocks, body_idx, s2, def_counts)
end.

##
 * mir_opt_licm — Loop-Invariant Code Motion.
 * Hoists pure invariant ops to the loop preheader (or header before terminator).
 ##
func mir_opt_licm(blocks: i64):
    def_counts = mir_build_vreg_def_counts(blocks)
    n_blocks = vec_len_rt(blocks)
    var hdr_idx = 0
    when hdr_idx < n_blocks loop
        hdr = vec_get_rt(blocks, hdr_idx)
        hdr_id = mir_block_id(hdr)
        succs = mir_block_successors(hdr)
        if succs >= 0 do
            ns = vec_len_rt(succs)
            var si = 0
            when si < ns loop
                body_id = vec_get_rt(succs, si)
                body_idx = mir_find_block_index(blocks, body_id)
                if body_idx >= 0 do
                    preds = mir_block_preds(vec_get_rt(blocks, body_idx))
                    var is_back_edge = 0
                    if preds >= 0 do
                        var pi = 0
                        when pi < vec_len_rt(preds) loop
                            if vec_get_rt(preds, pi) == hdr_id do is_back_edge = 1 end
                            pi = pi + 1
                        end
                    end
                    if is_back_edge == 1 do
                        pre_idx = mir_find_loop_preheader(blocks, hdr_idx, body_id)
                        hoist_idx = pre_idx
                        if hoist_idx < 0 do hoist_idx = hdr_idx end
                        body = vec_get_rt(blocks, body_idx)
                        instrs = mir_block_head(body)
                        hoist_b = vec_get_rt(blocks, hoist_idx)
                        hoist_instrs = mir_block_head(hoist_b)
                        if instrs >= 0 and hoist_instrs >= 0 do
                            n_ins = vec_len_rt(instrs)
                            var ii = 0
                            when ii < n_ins loop
                                ins = vec_get_rt(instrs, ii)
                                op = mir_instr_op(ins)
                                if mir_opt_licm_hoistable(op) do
                                    dst = mir_instr_dst(ins)
                                    can_hoist = mir_opt_licm_operands_invariant(blocks, body_idx, op, ins, def_counts)
                                    if can_hoist and mir_opnd_type(dst) == MirOperandType.VReg do
                                        dv = mir_opnd_vreg_id(dst)
                                        if not mir_vreg_defined_in_body(blocks, body_idx, dv, ii) do
                                            hoisted = mir_instr_new(op, dst, mir_instr_src1(ins), mir_instr_src2(ins))
                                            mir_instr_set_aux(hoisted, mir_instr_aux(ins))
                                            mir_instr_set_type(hoisted, mir_instr_type(ins))
                                            hoist_instrs = mir_block_insert_before_terminator(hoist_instrs, hoisted)
                                            vec_set_rt(instrs, ii, mir_instr_new(MirOp.Nop, mir_opnd_none(), mir_opnd_none(), mir_opnd_none()))
                                            mir_opt_note_change()
                                        end
                                    end
                                end
                                ii = ii + 1
                            end
                            body = mir_block_replace_head(body, instrs)
                            hoist_b = mir_block_replace_head(hoist_b, hoist_instrs)
                            vec_set_rt(blocks, body_idx, body)
                            vec_set_rt(blocks, hoist_idx, hoist_b)
                        end
                    end
                end
                si = si + 1
            end
        end
        hdr_idx = hdr_idx + 1
    end
    vec_free_rt(def_counts)
    out blocks
end.

func mir_opt_operand_loop_invariant(blocks: i64, loop_body_idx: i64, opnd: &MirOperand, def_counts: i64):
    if mir_opnd_type(opnd) == MirOperandType.Imm do out true end
    if mir_opnd_type(opnd) != MirOperandType.VReg do out false end
    v = mir_opnd_vreg_id(opnd)
    if mir_vreg_def_count(def_counts, v) != 1 do out false end
    n_blocks = vec_len_rt(blocks)
    var bi = 0
    when bi < n_blocks loop
        instrs = mir_block_head(vec_get_rt(blocks, bi))
        if instrs >= 0 do
            var ji = 0
            when ji < vec_len_rt(instrs) loop
                ins = vec_get_rt(instrs, ji)
                if mir_instr_defines_vreg(ins, v) do
                    if bi == loop_body_idx do out false end
                    out true
                end
                ji = ji + 1
            end
        end
        bi = bi + 1
    end
    out true
end.

##
 * mir_opt_gvn — Global Value Numbering over Dominator Tree.
 ##
func mir_opt_gvn(blocks: i64):
    n_blocks = vec_len_rt(blocks)
    var b_idx = 0
    when b_idx < n_blocks loop
        b = vec_get_rt(blocks, b_idx)
        instrs = mir_block_head(b)
        if instrs >= 0 do
            n_instrs = vec_len_rt(instrs)
            var i = 0
            when i < n_instrs loop
                ins = vec_get_rt(instrs, i)
                op = mir_instr_op(ins)
                dst = mir_instr_dst(ins)
                if mir_gvn_candidate(op) and mir_opnd_type(dst) == MirOperandType.VReg do
                    s1 = mir_instr_src1(ins)
                    s2 = mir_instr_src2(ins)
                    var (cs1, cs2) = mir_gvn_canonicalize_pair(op, s1, s2)
                    replacement = mir_opnd_none()
                    found = false
                    var d_idx = 0
                    when d_idx < n_blocks and not found loop
                        if mir_block_index_dominates(blocks, d_idx, b_idx) do
                            db = vec_get_rt(blocks, d_idx)
                            d_instrs = mir_block_head(db)
                            if d_instrs >= 0 do
                                limit = vec_len_rt(d_instrs)
                                if d_idx == b_idx do limit = i end
                                var j = 0
                                when j < limit and not found loop
                                    prev = vec_get_rt(d_instrs, j)
                                    if mir_gvn_expr_same(prev, op, cs1, cs2) do
                                        prev_dst = mir_instr_dst(prev)
                                        if mir_opnd_type(prev_dst) == MirOperandType.VReg do
                                            replacement = prev_dst
                                            found = true
                                        end
                                    end
                                    j = j + 1
                                end
                            end
                        end
                        d_idx = d_idx + 1
                    end
                    if found do
                        vec_set_rt(instrs, i, mir_instr_new(MirOp.Move, dst, replacement, mir_opnd_none()))
                        mir_opt_note_change()
                    end
                end
                i = i + 1
            end
        end
        b_idx = b_idx + 1
    end
    out blocks
end.

func mir_gvn_candidate(op: i64):
    if op == MirOp.Not do out true end
    out op == MirOp.Add or op == MirOp.Sub or op == MirOp.Mul or op == MirOp.Div or op == MirOp.Mod or op == MirOp.And or op == MirOp.Or or op == MirOp.Xor or op == MirOp.Shl or op == MirOp.Shr or op == MirOp.CmpEq or op == MirOp.CmpNe or op == MirOp.CmpGt or op == MirOp.CmpLt or op == MirOp.CmpGe or op == MirOp.CmpLe
end.

func mir_gvn_canonicalize_pair(op: i64, s1: &MirOperand, s2: &MirOperand):
    if mir_gvn_commutative(op) do
        if mir_opnd_type(s1) == MirOperandType.Imm and mir_opnd_type(s2) != MirOperandType.Imm do
            out (s2, s1)
        end
        if mir_opnd_type(s1) == MirOperandType.VReg and mir_opnd_type(s2) == MirOperandType.VReg do
            if mir_opnd_vreg_id(s1) > mir_opnd_vreg_id(s2) do
                out (s2, s1)
            end
        end
    end
    out (s1, s2)
end.

func mir_gvn_commutative(op: i64):
    out op == MirOp.Add or op == MirOp.Mul or op == MirOp.And or op == MirOp.Or or op == MirOp.Xor or op == MirOp.CmpEq or op == MirOp.CmpNe
end.

func mir_gvn_expr_same(ins: &MirInstr, op: i64, s1: &MirOperand, s2: &MirOperand):
    if mir_instr_op(ins) != op do out false end
    p1 = mir_instr_src1(ins)
    p2 = mir_instr_src2(ins)
    var (cs1, cs2) = mir_gvn_canonicalize_pair(op, s1, s2)
    var (cp1, cp2) = mir_gvn_canonicalize_pair(op, p1, p2)
    if mir_opnd_is_same(cp1, cs1) and mir_opnd_is_same(cp2, cs2) do out true end
    out false
end.

func mir_block_index_dominates(blocks: i64, dom_idx: i64, block_idx: i64):
    if dom_idx == block_idx do out true end
    n_blocks = vec_len_rt(blocks)
    current = block_idx
    var steps = 0
    when current >= 0 and current < n_blocks and steps < n_blocks loop
        current = mir_block_idom(vec_get_rt(blocks, current))
        if current == dom_idx do out true end
        steps = steps + 1
    end
    out false
end.

##
 * mir_opt_jump_threading — CFG simplification, empty block pruning, and jump threading.
 ##
func mir_opt_jump_threading(blocks: i64):
    n_blocks = vec_len_rt(blocks)
    var b_idx = 0
    when b_idx < n_blocks loop
        b = vec_get_rt(blocks, b_idx)
        instrs = mir_block_head(b)
        if instrs >= 0 do
            n_instrs = vec_len_rt(instrs)
            var i = 0
            when i < n_instrs loop
                ins = vec_get_rt(instrs, i)
                op = mir_instr_op(ins)
                if op == MirOp.Jump do
                    target = mir_instr_src1(ins)
                    if mir_opnd_type(target) == MirOperandType.Imm do
                        resolved = mir_resolve_trampoline(blocks, mir_opnd_imm_val(target))
                        if resolved != mir_opnd_imm_val(target) do
                            vec_set_rt(instrs, i, mir_instr_new(MirOp.Jump, mir_instr_dst(ins), mir_opnd_imm(resolved), mir_instr_src2(ins)))
                            mir_opt_note_change()
                        end
                    end
                eif op == MirOp.JumpIf or op == MirOp.JumpIfNot do
                    target = mir_instr_src2(ins)
                    if mir_opnd_type(target) == MirOperandType.Imm do
                        resolved = mir_resolve_trampoline(blocks, mir_opnd_imm_val(target))
                        if resolved != mir_opnd_imm_val(target) do
                            vec_set_rt(instrs, i, mir_instr_new(op, mir_instr_dst(ins), mir_instr_src1(ins), mir_opnd_imm(resolved)))
                            mir_opt_note_change()
                        end
                    end
                end
                i = i + 1
            end
        end
        b_idx = b_idx + 1
    end
    out blocks
end.

func mir_trampoline_target(blocks: i64, block_id: i64):
    idx = mir_find_block_index(blocks, block_id)
    if idx < 0 do out 0 - 1 end
    b = vec_get_rt(blocks, idx)
    phis = mir_block_phis(b)
    if phis >= 0 and vec_len_rt(phis) > 0 do out 0 - 1 end
    instrs = mir_block_head(b)
    if instrs < 0 do out 0 - 1 end
    n_instrs = vec_len_rt(instrs)
    target = 0 - 1
    var meaningful = 0
    var i = 0
    when i < n_instrs loop
        ins = vec_get_rt(instrs, i)
        op = mir_instr_op(ins)
        if op != MirOp.Nop do
            meaningful = meaningful + 1
            if op == MirOp.Jump and mir_opnd_type(mir_instr_src1(ins)) == MirOperandType.Imm do
                target = mir_opnd_imm_val(mir_instr_src1(ins))
            else
                target = 0 - 1
            end
        end
        i = i + 1
    end
    if meaningful == 1 do
        t_idx = mir_find_block_index(blocks, target)
        if t_idx >= 0 do
            tb = vec_get_rt(blocks, t_idx)
            t_phis = mir_block_phis(tb)
            if t_phis >= 0 and vec_len_rt(t_phis) > 0 do out 0 - 1 end
        end
        out target
    end
    out 0 - 1
end.

func mir_resolve_trampoline(blocks: i64, target_id: i64):
    n_blocks = vec_len_rt(blocks)
    current = target_id
    var hops = 0
    when hops < n_blocks loop
        next_target = mir_trampoline_target(blocks, current)
        if next_target < 0 or next_target == current do out current end
        current = next_target
        hops = hops + 1
    end
    out target_id
end.

const MIR_SCCP_TOP: i64 = 0
const MIR_SCCP_CONST: i64 = 1
const MIR_SCCP_OVER: i64 = 2

func mir_sccp_lattice_meet(a_state: i64, a_val: i64, b_state: i64, b_val: i64):
    if a_state == MIR_SCCP_OVER or b_state == MIR_SCCP_OVER do out (MIR_SCCP_OVER, 0) end
    if a_state == MIR_SCCP_TOP do out (b_state, b_val) end
    if b_state == MIR_SCCP_TOP do out (a_state, a_val) end
    if a_state == MIR_SCCP_CONST and b_state == MIR_SCCP_CONST do
        if a_val == b_val do out (MIR_SCCP_CONST, a_val) end
        out (MIR_SCCP_OVER, 0)
    end
    out (MIR_SCCP_OVER, 0)
end.

func mir_sccp_operand_state(opnd: &MirOperand, states: i64, values: i64):
    if mir_opnd_type(opnd) == MirOperandType.Imm do
        out (MIR_SCCP_CONST, mir_opnd_imm_val(opnd))
    end
    if mir_opnd_type(opnd) == MirOperandType.VReg do
        id = mir_opnd_vreg_id(opnd)
        if id >= 0 and id < vec_len_rt(states) do
            st = vec_get_rt(states, id)
            if st == MIR_SCCP_CONST do out (MIR_SCCP_CONST, vec_get_rt(values, id)) end
            out (st, 0)
        end
    end
    out (MIR_SCCP_OVER, 0)
end.

func mir_sccp_try_set(states: i64, values: i64, v: i64, new_state: i64, new_val: i64):
    if v < 0 or v >= vec_len_rt(states) do out false end
    old_state = vec_get_rt(states, v)
    if old_state == MIR_SCCP_OVER do out false end
    old_val = vec_get_rt(values, v)
    if old_state == new_state and (new_state != MIR_SCCP_CONST or old_val == new_val) do out false end
    vec_set_rt(states, v, new_state)
    if new_state == MIR_SCCP_CONST do vec_set_rt(values, v, new_val) end
    out true
end.

##
 * mir_opt_sccp — Sparse Conditional Constant Propagation (lattice + phi meet).
 ##
func mir_opt_sccp(blocks: i64):
    n_vregs = max_vreg_mir(blocks)
    states = vec_new_rt()
    values = vec_new_rt()
    var v = 0
    when v < n_vregs loop
        states = vec_push_rt(states, MIR_SCCP_TOP)
        values = vec_push_rt(values, 0)
        v = v + 1
    end

    changed = true
    var iter = 0
    n_blocks = vec_len_rt(blocks)
    max_iter = (n_blocks + 1) * 8
    if max_iter > 512 do max_iter = 512 end
    when changed and iter < max_iter loop
        changed = false
        n_blocks = vec_len_rt(blocks)
        var b_idx = 0
        when b_idx < n_blocks loop
            b = vec_get_rt(blocks, b_idx)
            phis = mir_block_phis(b)
            if phis >= 0 do
                var p = 0
                when p < vec_len_rt(phis) loop
                    phi = vec_get_rt(phis, p)
                    dst_v = mir_phi_dst(phi)
                    inc_vals = mir_phi_incoming_values(phi)
                    meet_state = MIR_SCCP_TOP
                    meet_val = 0
                    var k = 0
                    when k < vec_len_rt(inc_vals) loop
                        inc = vec_get_rt(inc_vals, k)
                        var (ist, ival) = mir_sccp_operand_state(inc, states, values)
                        var (mst, mval) = mir_sccp_lattice_meet(meet_state, meet_val, ist, ival)
                        meet_state = mst
                        meet_val = mval
                        k = k + 1
                    end
                    if mir_sccp_try_set(states, values, dst_v, meet_state, meet_val) do
                        changed = true
                    end
                    p = p + 1
                end
            end
            instrs = mir_block_head(b)
            if instrs >= 0 do
                var i = 0
                when i < vec_len_rt(instrs) loop
                    ins = vec_get_rt(instrs, i)
                    op = mir_instr_op(ins)
                    dst = mir_instr_dst(ins)
                    if mir_op_defines_value(op) and mir_opnd_type(dst) == MirOperandType.VReg do
                        dst_v = mir_opnd_vreg_id(dst)
                        s1 = mir_instr_src1(ins)
                        s2 = mir_instr_src2(ins)
                        var (s1_st, s1_val) = mir_sccp_operand_state(s1, states, values)
                        var (s2_st, s2_val) = mir_sccp_operand_state(s2, states, values)
                        if s1_st == MIR_SCCP_OVER or s2_st == MIR_SCCP_OVER do
                            if mir_sccp_try_set(states, values, dst_v, MIR_SCCP_OVER, 0) do changed = true end
                        eif s1_st == MIR_SCCP_TOP or s2_st == MIR_SCCP_TOP do
                            # wait for operands
                        else
                            rs1_eval = s1
                            rs2_eval = s2
                            if s1_st == MIR_SCCP_CONST do rs1_eval = mir_opnd_imm(s1_val) end
                            if s2_st == MIR_SCCP_CONST do rs2_eval = mir_opnd_imm(s2_val) end
                            var (is_const, const_val) = mir_sccp_eval(op, rs1_eval, rs2_eval, mir_instr_type(ins))
                            if is_const do
                                if mir_sccp_try_set(states, values, dst_v, MIR_SCCP_CONST, const_val) do changed = true end
                            else
                                if mir_sccp_try_set(states, values, dst_v, MIR_SCCP_OVER, 0) do changed = true end
                            end
                        end
                    eif mir_opnd_type(dst) == MirOperandType.VReg and not (op >= MirOp.VLoad as i64 and op <= MirOp.Shuffle as i64) do
                        dst_v = mir_opnd_vreg_id(dst)
                        if mir_sccp_try_set(states, values, dst_v, MIR_SCCP_OVER, 0) do changed = true end
                    end
                    i = i + 1
                end
            end
            b_idx = b_idx + 1
        end
        iter = iter + 1
    end

    n_blocks2 = vec_len_rt(blocks)
    var bi = 0
    when bi < n_blocks2 loop
        instrs2 = mir_block_head(vec_get_rt(blocks, bi))
        if instrs2 >= 0 do
            var ii = 0
            when ii < vec_len_rt(instrs2) loop
                ins2 = vec_get_rt(instrs2, ii)
                op2 = mir_instr_op(ins2)
                dst2 = mir_instr_dst(ins2)
                rs1 = mir_sccp_resolve_operand(mir_instr_src1(ins2), states, values)
                rs2 = mir_sccp_resolve_operand(mir_instr_src2(ins2), states, values)
                if mir_op_defines_value(op2) and mir_opnd_type(dst2) == MirOperandType.VReg do
                    dv = mir_opnd_vreg_id(dst2)
                    if dv >= 0 and dv < n_vregs and vec_get_rt(states, dv) == MIR_SCCP_CONST do
                        cval = vec_get_rt(values, dv)
                        if op2 != MirOp.Move or mir_opnd_type(mir_instr_src1(ins2)) != MirOperandType.Imm or mir_opnd_imm_val(mir_instr_src1(ins2)) != cval do
                            vec_set_rt(instrs2, ii, mir_instr_new(MirOp.Move, dst2, mir_opnd_imm(cval), mir_opnd_none()))
                            mir_opt_note_change()
                        end
                    else
                        if not mir_opnd_is_same(rs1, mir_instr_src1(ins2)) or not mir_opnd_is_same(rs2, mir_instr_src2(ins2)) do
                            new_ins2 = mir_instr_new(op2, dst2, rs1, rs2)
                            mir_copy_instr_metadata(ins2, new_ins2)
                            vec_set_rt(instrs2, ii, new_ins2)
                            mir_opt_note_change()
                        end
                    end
                else
                    if not mir_opnd_is_same(rs1, mir_instr_src1(ins2)) or not mir_opnd_is_same(rs2, mir_instr_src2(ins2)) do
                        new_ins2 = mir_instr_new(op2, dst2, rs1, rs2)
                        mir_copy_instr_metadata(ins2, new_ins2)
                        vec_set_rt(instrs2, ii, new_ins2)
                        mir_opt_note_change()
                    end
                end
                ii = ii + 1
            end
        end
        bi = bi + 1
    end
    vec_free_rt(states)
    vec_free_rt(values)
    out blocks
end.

func mir_op_defines_value(op: i64):
    out op == MirOp.Move or op == MirOp.Load or op == MirOp.Add or op == MirOp.Sub or op == MirOp.Mul or op == MirOp.Div or op == MirOp.Mod or op == MirOp.And or op == MirOp.Or or op == MirOp.Xor or op == MirOp.Shl or op == MirOp.Shr or op == MirOp.Not or op == MirOp.CmpEq or op == MirOp.CmpNe or op == MirOp.CmpGt or op == MirOp.CmpLt or op == MirOp.CmpGe or op == MirOp.CmpLe
end.

func count_vreg_value_defs_mir(blocks: i64, target_vreg: i64):
    n_blocks = vec_len_rt(blocks)
    var defs = 0
    var i = 0
    when i < n_blocks loop
        instrs = mir_block_head(vec_get_rt(blocks, i))
        if instrs >= 0 do
            var j = 0
            when j < vec_len_rt(instrs) loop
                ins = vec_get_rt(instrs, j)
                if mir_op_defines_value(mir_instr_op(ins)) and mir_instr_defines_vreg(ins, target_vreg) do
                    defs = defs + 1
                end
                j = j + 1
            end
        end
        i = i + 1
    end
    out defs
end.

func mir_sccp_resolve_operand(opnd: &MirOperand, states: i64, values: i64):
    if mir_opnd_type(opnd) == MirOperandType.VReg do
        id = mir_opnd_vreg_id(opnd)
        if id >= 0 and id < vec_len_rt(states) and vec_get_rt(states, id) == MIR_SCCP_CONST do
            out mir_opnd_imm(vec_get_rt(values, id))
        end
    end
    out opnd
end.

func mir_sccp_eval(op: i64, s1: &MirOperand, s2: &MirOperand, ins_t: i64):
    if op == MirOp.Move and mir_opnd_type(s1) == MirOperandType.Imm do
        out (true, mir_opnd_imm_val(s1))
    end
    if op == MirOp.Not and mir_opnd_type(s1) == MirOperandType.Imm do
        out (true, mir_opnd_imm_val(s1) xor (0 - 1))
    end
    if mir_opnd_type(s1) != MirOperandType.Imm or mir_opnd_type(s2) != MirOperandType.Imm do
        out (false, 0)
    end
    out mir_eval_const_binary_typed(op, mir_opnd_imm_val(s1), mir_opnd_imm_val(s2), ins_t)
end.

func mir_opnd_is_same(o1: &MirOperand, o2: &MirOperand):
    if (o1 as i64) == 0 or (o2 as i64) == 0 do out false end
    t1 = mir_opnd_type(o1)
    t2 = mir_opnd_type(o2)
    if t1 != t2 do out false end
    if t1 == MirOperandType.None do
        out true
    end
    if t1 == MirOperandType.VReg do
        out mir_opnd_vreg_id(o1) == mir_opnd_vreg_id(o2)
    end
    if t1 == MirOperandType.Imm do
        out mir_opnd_imm_val(o1) == mir_opnd_imm_val(o2)
    end
    if t1 == MirOperandType.Block do
        out mir_opnd_block_id(o1) == mir_opnd_block_id(o2)
    end
    out false
end.

func mir_opnd_replace_vreg(o: &MirOperand, from_v: i64, to: &MirOperand):
    if mir_opnd_type(o) == MirOperandType.VReg and mir_opnd_vreg_id(o) == from_v do
        out to
    end
    out o
end.

func mir_rewrite_uses_from(blocks: i64, from_v: i64, to: &MirOperand):
    n_blocks = vec_len_rt(blocks)
    var i = 0
    when i < n_blocks loop
        b = vec_get_rt(blocks, i)
        instrs = mir_block_head(b)
        if instrs >= 0 do
            n_instrs = vec_len_rt(instrs)
            var j = 0
            when j < n_instrs loop
                ins = vec_get_rt(instrs, j)
                ns1 = mir_opnd_replace_vreg(mir_instr_src1(ins), from_v, to)
                ns2 = mir_opnd_replace_vreg(mir_instr_src2(ins), from_v, to)
                if not mir_opnd_is_same(ns1, mir_instr_src1(ins)) or not mir_opnd_is_same(ns2, mir_instr_src2(ins)) do
                    new_ins = mir_instr_new(mir_instr_op(ins), mir_instr_dst(ins), ns1, ns2)
                    mir_copy_instr_metadata(ins, new_ins)
                    vec_set_rt(instrs, j, new_ins)
                    mir_opt_note_change()
                end
                j = j + 1
            end
        end
        phis = mir_block_phis(b)
        if phis >= 0 do
            n_phis = vec_len_rt(phis)
            var p = 0
            when p < n_phis loop
                phi = vec_get_rt(phis, p)
                inc_vals = mir_phi_incoming_values(phi)
                n_inc = vec_len_rt(inc_vals)
                var k = 0
                when k < n_inc loop
                    val = vec_get_rt(inc_vals, k)
                    nval = mir_opnd_replace_vreg(val, from_v, to)
                    if not mir_opnd_is_same(nval, val) do
                        vec_set_rt(inc_vals, k, nval)
                        mir_opt_note_change()
                    end
                    k = k + 1
                end
                p = p + 1
            end
        end
        i = i + 1
    end
    out blocks
end.

func mir_bool_i64(cond: bool):
    if cond do out 1 end
    out 0
end.

func mir_eval_const_binary(op: i64, a: i64, b: i64):
    if op == MirOp.Add do out (true, a + b) end
    if op == MirOp.Sub do out (true, a - b) end
    if op == MirOp.Mul do out (true, a * b) end
    if op == MirOp.Div and b != 0 do out (true, a / b) end
    if op == MirOp.Mod and b != 0 do out (true, a mod b) end
    if op == MirOp.And do out (true, a and b) end
    if op == MirOp.Or do out (true, a or b) end
    if op == MirOp.Xor do out (true, a xor b) end
    if op == MirOp.Shl and b >= 0 and b < 63 do out (true, a shl b) end
    if op == MirOp.Shr and b >= 0 and b < 63 do out (true, a shr b) end
    if op == MirOp.CmpEq do out (true, mir_bool_i64(a == b)) end
    if op == MirOp.CmpNe do out (true, mir_bool_i64(a != b)) end
    if op == MirOp.CmpGt do out (true, mir_bool_i64(a > b)) end
    if op == MirOp.CmpLt do out (true, mir_bool_i64(a < b)) end
    if op == MirOp.CmpGe do out (true, mir_bool_i64(a >= b)) end
    if op == MirOp.CmpLe do out (true, mir_bool_i64(a <= b)) end
    out (false, 0)
end.

func mir_eval_const_binary_typed(op: i64, a: i64, b: i64, ins_t: i64):
    if ins_t == 7 do # MirType.F64
        let a_zero = a == 0 or a == (1 shl 63)
        let b_zero = b == 0 or b == (1 shl 63)
        if a_zero and b_zero do
            if op == MirOp.CmpEq do out (true, 1) end
            if op == MirOp.CmpNe do out (true, 0) end
            if op == MirOp.CmpLt do out (true, 0) end
            if op == MirOp.CmpGt do out (true, 0) end
            if op == MirOp.CmpLe do out (true, 1) end
            if op == MirOp.CmpGe do out (true, 1) end
        end
        # Float immediates carry raw IEEE-754 bits. Integer folding would
        # reinterpret those bits as i64 values and silently change semantics.
        out (false, 0)
    end
    out mir_eval_const_binary(op, a, b)
end.

func mir_opt_algebraic_simplification(blocks: i64):
    n_blocks = vec_len_rt(blocks)
    var i = 0
    when i < n_blocks loop
        instrs = mir_block_head(vec_get_rt(blocks, i))
        if instrs >= 0 do
            n_instrs = vec_len_rt(instrs)
            var j = 0
            when j < n_instrs loop
                ins = vec_get_rt(instrs, j)
                op = mir_instr_op(ins)
                dst = mir_instr_dst(ins)
                s1 = mir_instr_src1(ins)
                s2 = mir_instr_src2(ins)
                t1 = mir_opnd_type(s1)
                t2 = mir_opnd_type(s2)
                # F64 operands are raw IEEE-754 bits; none of the integer
                # identities below are valid for every float value (NaN, -0).
                changed = mir_instr_type(ins) == 7 # MirType.F64 sentinel
                repl = ins
                if not changed and t1 == MirOperandType.Imm and t2 == MirOperandType.Imm do
                    var (ok, val) = mir_eval_const_binary_typed(op, mir_opnd_imm_val(s1), mir_opnd_imm_val(s2), mir_instr_type(ins))
                    if ok do
                        repl = mir_instr_new(MirOp.Move, dst, mir_opnd_imm(val), mir_opnd_none())
                        changed = true
                    end
                end
                if not changed and op == MirOp.Add and t2 == MirOperandType.Imm and mir_opnd_imm_val(s2) == 0 do
                    repl = mir_instr_new(MirOp.Move, dst, s1, mir_opnd_none())
                    changed = true
                end
                if not changed and op == MirOp.Add and t1 == MirOperandType.Imm and mir_opnd_imm_val(s1) == 0 do
                    repl = mir_instr_new(MirOp.Move, dst, s2, mir_opnd_none())
                    changed = true
                end
                if not changed and op == MirOp.Sub and t2 == MirOperandType.Imm and mir_opnd_imm_val(s2) == 0 do
                    repl = mir_instr_new(MirOp.Move, dst, s1, mir_opnd_none())
                    changed = true
                end
                if not changed and op == MirOp.Sub and mir_opnd_is_same(s1, s2) do
                    repl = mir_instr_new(MirOp.Move, dst, mir_opnd_imm(0), mir_opnd_none())
                    changed = true
                end
                if not changed and op == MirOp.Mul and t2 == MirOperandType.Imm and mir_opnd_imm_val(s2) == 1 do
                    repl = mir_instr_new(MirOp.Move, dst, s1, mir_opnd_none())
                    changed = true
                end
                if not changed and op == MirOp.Mul and t1 == MirOperandType.Imm and mir_opnd_imm_val(s1) == 1 do
                    repl = mir_instr_new(MirOp.Move, dst, s2, mir_opnd_none())
                    changed = true
                end
                if not changed and op == MirOp.Mul and ((t1 == MirOperandType.Imm and mir_opnd_imm_val(s1) == 0) or (t2 == MirOperandType.Imm and mir_opnd_imm_val(s2) == 0)) do
                    repl = mir_instr_new(MirOp.Move, dst, mir_opnd_imm(0), mir_opnd_none())
                    changed = true
                end
                if not changed and op == MirOp.Div and t2 == MirOperandType.Imm and mir_opnd_imm_val(s2) == 1 do
                    repl = mir_instr_new(MirOp.Move, dst, s1, mir_opnd_none())
                    changed = true
                end
                if not changed and op == MirOp.And and ((t1 == MirOperandType.Imm and mir_opnd_imm_val(s1) == 0) or (t2 == MirOperandType.Imm and mir_opnd_imm_val(s2) == 0)) do
                    repl = mir_instr_new(MirOp.Move, dst, mir_opnd_imm(0), mir_opnd_none())
                    changed = true
                end
                if not changed and op == MirOp.And and t2 == MirOperandType.Imm and mir_opnd_imm_val(s2) == (0 - 1) do
                    repl = mir_instr_new(MirOp.Move, dst, s1, mir_opnd_none())
                    changed = true
                end
                if not changed and op == MirOp.And and t1 == MirOperandType.Imm and mir_opnd_imm_val(s1) == (0 - 1) do
                    repl = mir_instr_new(MirOp.Move, dst, s2, mir_opnd_none())
                    changed = true
                end
                if not changed and op == MirOp.Or and t2 == MirOperandType.Imm and mir_opnd_imm_val(s2) == 0 do
                    repl = mir_instr_new(MirOp.Move, dst, s1, mir_opnd_none())
                    changed = true
                end
                if not changed and op == MirOp.Or and t1 == MirOperandType.Imm and mir_opnd_imm_val(s1) == 0 do
                    repl = mir_instr_new(MirOp.Move, dst, s2, mir_opnd_none())
                    changed = true
                end
                if not changed and op == MirOp.Xor and t2 == MirOperandType.Imm and mir_opnd_imm_val(s2) == 0 do
                    repl = mir_instr_new(MirOp.Move, dst, s1, mir_opnd_none())
                    changed = true
                end
                if not changed and op == MirOp.Xor and t1 == MirOperandType.Imm and mir_opnd_imm_val(s1) == 0 do
                    repl = mir_instr_new(MirOp.Move, dst, s2, mir_opnd_none())
                    changed = true
                end
                if not changed and (op == MirOp.Xor or op == MirOp.Or or op == MirOp.And) and mir_opnd_is_same(s1, s2) do
                    if op == MirOp.Xor do
                        repl = mir_instr_new(MirOp.Move, dst, mir_opnd_imm(0), mir_opnd_none())
                    else
                        repl = mir_instr_new(MirOp.Move, dst, s1, mir_opnd_none())
                    end
                    changed = true
                end
                if not changed and (op == MirOp.CmpEq or op == MirOp.CmpGe or op == MirOp.CmpLe) and mir_opnd_is_same(s1, s2) do
                    repl = mir_instr_new(MirOp.Move, dst, mir_opnd_imm(1), mir_opnd_none())
                    changed = true
                end
                if not changed and (op == MirOp.CmpNe or op == MirOp.CmpGt or op == MirOp.CmpLt) and mir_opnd_is_same(s1, s2) do
                    repl = mir_instr_new(MirOp.Move, dst, mir_opnd_imm(0), mir_opnd_none())
                    changed = true
                end
                if changed and mir_instr_type(ins) != 7 do
                    vec_set_rt(instrs, j, repl)
                    mir_opt_note_change()
                end
                j = j + 1
            end
        end
        i = i + 1
    end
    out blocks
end.

func mir_opt_branch_folding(blocks: i64):
    n_blocks = vec_len_rt(blocks)
    var i = 0
    when i < n_blocks loop
        instrs = mir_block_head(vec_get_rt(blocks, i))
        if instrs >= 0 do
            n_instrs = vec_len_rt(instrs)
            var j = 0
            when j < n_instrs loop
                ins = vec_get_rt(instrs, j)
                op = mir_instr_op(ins)
                cond = mir_instr_src1(ins)
                target = mir_instr_src2(ins)
                if op == MirOp.JumpIf and mir_opnd_type(cond) == MirOperandType.Imm do
                    if mir_opnd_imm_val(cond) != 0 do
                        vec_set_rt(instrs, j, mir_instr_new(MirOp.Jump, mir_opnd_none(), target, mir_opnd_none()))
                    else
                        vec_set_rt(instrs, j, mir_instr_new(MirOp.Nop, mir_opnd_none(), mir_opnd_none(), mir_opnd_none()))
                    end
                    mir_opt_note_change()
                eif op == MirOp.JumpIfNot and mir_opnd_type(cond) == MirOperandType.Imm do
                    if mir_opnd_imm_val(cond) == 0 do
                        vec_set_rt(instrs, j, mir_instr_new(MirOp.Jump, mir_opnd_none(), target, mir_opnd_none()))
                    else
                        vec_set_rt(instrs, j, mir_instr_new(MirOp.Nop, mir_opnd_none(), mir_opnd_none(), mir_opnd_none()))
                    end
                    mir_opt_note_change()
                end
                j = j + 1
            end
        end
        i = i + 1
    end
    out blocks
end.

func mir_opt_phi_simplification(blocks: i64):
    n_blocks = vec_len_rt(blocks)
    var i = 0
    when i < n_blocks loop
        b = vec_get_rt(blocks, i)
        phis = mir_block_phis(b)
        if phis >= 0 do
            n_phis = vec_len_rt(phis)
            var p = 0
            when p < n_phis loop
                phi = vec_get_rt(phis, p)
                vals = mir_phi_incoming_values(phi)
                n_vals = vec_len_rt(vals)
                if n_vals > 0 do
                    first = vec_get_rt(vals, 0)
                    all_same = true
                    var k = 1
                    when k < n_vals loop
                        if not mir_opnd_is_same(first, vec_get_rt(vals, k)) do
                            all_same = false
                        end
                        k = k + 1
                    end
                    if all_same do
                        blocks = mir_rewrite_uses_from(blocks, mir_phi_dst(phi), first)
                        empty_vals = vec_new_rt()
                        empty_blocks = vec_new_rt()
                        vec_set_rt(phis, p, mir_phi_new(mir_phi_dst(phi), mir_phi_orig_vreg(phi), empty_vals, empty_blocks, 0))
                        mir_opt_note_change()
                    end
                end
                p = p + 1
            end
        end
        i = i + 1
    end
    out blocks
end.

# Remove phi placeholders left behind by mir_opt_phi_simplification.  A
# simplified phi has no incoming values and must not reserve a register slot
# for later lowering or allocation.
func mir_opt_sweep_dead_phis(blocks: i64):
    n_blocks = vec_len_rt(blocks)
    var i = 0
    when i < n_blocks loop
        b = vec_get_rt(blocks, i)
        phis = mir_block_phis(b)
        if phis >= 0 do
            live_phis = vec_new_rt()
            n_phis = vec_len_rt(phis)
            var p = 0
            when p < n_phis loop
                phi = vec_get_rt(phis, p)
                if vec_len_rt(mir_phi_incoming_values(phi)) > 0 do
                    live_phis = vec_push_rt(live_phis, phi)
                else
                    mir_opt_note_change()
                end
                p = p + 1
            end
            b_new = mir_block_new(
                mir_block_id(b),
                live_phis,
                mir_block_head(b),
                mir_block_tail(b),
                mir_block_successors(b),
                mir_block_preds(b),
                mir_block_idom(b),
                mir_block_dom_children(b),
                mir_block_df(b),
                mir_block_next_block(b)
            )
            vec_set_rt(blocks, i, b_new)
        end
        i = i + 1
    end
    out blocks
end.

func mir_terminates_control(op: i64):
    out op == MirOp.Jump or op == MirOp.Return
end.

func mir_opt_cfg_simplification(blocks: i64):
    n_blocks = vec_len_rt(blocks)
    var i = 0
    when i < n_blocks loop
        instrs = mir_block_head(vec_get_rt(blocks, i))
        if instrs >= 0 do
            n_instrs = vec_len_rt(instrs)
            var terminated = false
            var j = 0
            when j < n_instrs loop
                ins = vec_get_rt(instrs, j)
                op = mir_instr_op(ins)
                if terminated do
                    if op != MirOp.Nop do
                        vec_set_rt(instrs, j, mir_instr_new(MirOp.Nop, mir_opnd_none(), mir_opnd_none(), mir_opnd_none()))
                        mir_opt_note_change()
                    end
                eif mir_terminates_control(op) do
                    terminated = true
                end
                j = j + 1
            end
        end
        i = i + 1
    end
    out blocks
end.

##
 * mir_opt_redundant_load_store_elimination — Eliminates redundant load/store & forwards values.
 ##
func mir_opt_redundant_load_store_elimination(blocks: i64):
    n_blocks = vec_len_rt(blocks)
    var b_idx = 0
    when b_idx < n_blocks loop
        b = vec_get_rt(blocks, b_idx)
        instrs = mir_block_head(b)
        if instrs >= 0 do
            n_ins = vec_len_rt(instrs)
            var i = 0
            when i < n_ins loop
                ins = vec_get_rt(instrs, i)
                op = mir_instr_op(ins)

                if op == MirOp.Load do
                    ld_dst0 = mir_instr_dst(ins)
                    ld_ptr0 = mir_instr_src1(ins)
                    ld_off0 = mir_instr_src2(ins)
                    var j_load = i + 1
                    var stop_load = 0
                    when j_load < n_ins and stop_load == 0 loop
                        ins_load2 = vec_get_rt(instrs, j_load)
                        op_load2 = mir_instr_op(ins_load2)
                        if op_load2 == MirOp.Load do
                            if mir_opnd_is_same(ld_ptr0, mir_instr_src1(ins_load2)) and mir_opnd_is_same(ld_off0, mir_instr_src2(ins_load2)) do
                                vec_set_rt(instrs, j_load, mir_instr_new(MirOp.Move, mir_instr_dst(ins_load2), ld_dst0, mir_opnd_none()))
                                mir_opt_note_change()
                            end
                        end
                        if mir_memory_barrier(op_load2) do
                            stop_load = 1
                        end
                        j_load = j_load + 1
                    end
                end

                if op == MirOp.Store do
                    st_ptr = mir_instr_dst(ins)
                    st_off = mir_instr_src1(ins)
                    st_val = mir_instr_src2(ins)

                    var j = i + 1
                    var stop = 0
                    when j < n_ins and stop == 0 loop
                        ins2 = vec_get_rt(instrs, j)
                        op2 = mir_instr_op(ins2)
                        if op2 == MirOp.Load do
                            ld_dst = mir_instr_dst(ins2)
                            ld_ptr = mir_instr_src1(ins2)
                            ld_off = mir_instr_src2(ins2)
                            if mir_opnd_is_same(st_ptr, ld_ptr) and mir_opnd_is_same(st_off, ld_off) do
                                ins_fwd = mir_instr_new(MirOp.Move, ld_dst, st_val, mir_opnd_none())
                                vec_set_rt(instrs, j, ins_fwd)
                                mir_opt_note_change()
                            end
                        eif op2 == MirOp.Store do
                            var st2_ptr = mir_instr_dst(ins2)
                            var st2_off = mir_instr_src1(ins2)
                            if mir_opnd_is_same(st_ptr, st2_ptr) and mir_opnd_is_same(st_off, st2_off) do
                                vec_set_rt(instrs, i, mir_instr_new(MirOp.Nop, mir_opnd_none(), mir_opnd_none(), mir_opnd_none()))
                                mir_opt_note_change()
                                stop = 1
                            else
                                stop = 1
                            end
                        eif mir_memory_barrier(op2) do
                            stop = 1
                        end
                        j = j + 1
                    end
                end
                i = i + 1
            end
        end
        b_idx = b_idx + 1
    end
    out blocks
end.

func mir_memory_barrier(op: i64):
    out op == MirOp.Store or op == MirOp.Call or op == MirOp.Intrinsic or op == MirOp.Jump or op == MirOp.JumpIf or op == MirOp.JumpIfNot or op == MirOp.Return
end.

##
 * mir_opt_arm64_instruction_selection_and_scheduling — Immediate folding & MADD/MSUB fusion.
 ##
func mir_arm64_trace_vreg_def(instrs: i64, before_idx: i64, vreg: i64):
  var k = before_idx - 1
  when k >= 0 loop
    ins = vec_get_rt(instrs, k)
    if mir_instr_defines_vreg(ins, vreg) do
      out ins
    end
    k = k - 1
  end
  out mir_instr_new(MirOp.Nop, mir_opnd_none(), mir_opnd_none(), mir_opnd_none())
end.

func mir_opt_arm64_instruction_selection_and_scheduling(blocks: i64):
    n_blocks = vec_len_rt(blocks)
    var b_idx = 0
    when b_idx < n_blocks loop
        b = vec_get_rt(blocks, b_idx)
        instrs = mir_block_head(b)
        if instrs >= 0 do
            n_ins = vec_len_rt(instrs)
            var i = 0
            when i < n_ins loop
                ins = vec_get_rt(instrs, i)
                op = mir_instr_op(ins)
                dst = mir_instr_dst(ins)
                s1 = mir_instr_src1(ins)
                s2 = mir_instr_src2(ins)

                if op == MirOp.Mul do
                    if mir_opnd_type(s2) == MirOperandType.Imm do
                        v = mir_opnd_imm_val(s2)
                        if mir_is_pow2(v) do
                            vec_set_rt(instrs, i, mir_instr_new(MirOp.Shl, dst, s1, mir_opnd_imm(mir_log2(v))))
                            mir_opt_note_change()
                        end
                    eif mir_opnd_type(s1) == MirOperandType.Imm do
                        v = mir_opnd_imm_val(s1)
                        if mir_is_pow2(v) do
                            vec_set_rt(instrs, i, mir_instr_new(MirOp.Shl, dst, s2, mir_opnd_imm(mir_log2(v))))
                            mir_opt_note_change()
                        end
                    end
                end

                if op == MirOp.Add do
                    fused = false
                    if mir_opnd_type(s1) == MirOperandType.VReg do
                        mul_ins = mir_arm64_trace_vreg_def(instrs, i, mir_opnd_vreg_id(s1))
                        if mir_instr_op(mul_ins) == MirOp.Mul do
                            ma = mir_instr_src1(mul_ins)
                            mb = mir_instr_src2(mul_ins)
                            vec_set_rt(instrs, i, mir_instr_new(MirOp.Fma, dst, ma, mb, s2))
                            mir_opt_note_change()
                            fused = true
                        end
                    end
                    if not fused and mir_opnd_type(s2) == MirOperandType.VReg do
                        mul_ins2 = mir_arm64_trace_vreg_def(instrs, i, mir_opnd_vreg_id(s2))
                        if mir_instr_op(mul_ins2) == MirOp.Mul do
                            ma2 = mir_instr_src1(mul_ins2)
                            mb2 = mir_instr_src2(mul_ins2)
                            vec_set_rt(instrs, i, mir_instr_new(MirOp.Fma, dst, ma2, mb2, s1))
                            mir_opt_note_change()
                        end
                    end
                end

                i = i + 1
            end
        end
        b_idx = b_idx + 1
    end
    out blocks
end.

##
 * mir_opt_zero_cost_abi_and_semantics_tuning — Leaf stripping, unboxed primitives, BCE.
 ##
func mir_opt_zero_cost_abi_and_semantics_tuning(blocks: i64):
    n_blocks = vec_len_rt(blocks)
    var b_idx = 0
    when b_idx < n_blocks loop
        b = vec_get_rt(blocks, b_idx)
        instrs = mir_block_head(b)
        if instrs >= 0 do
            n_ins = vec_len_rt(instrs)
            var i = 0
            when i < n_ins loop
                ins = vec_get_rt(instrs, i)
                op = mir_instr_op(ins)
                dst = mir_instr_dst(ins)
                s1 = mir_instr_src1(ins)
                s2 = mir_instr_src2(ins)
                s1_t = mir_opnd_type(s1)
                s2_t = mir_opnd_type(s2)

                if op == MirOp.Move do
                    if mir_opnd_is_same(dst, s1) do
                        vec_set_rt(instrs, i, mir_instr_new(MirOp.Nop, mir_opnd_none(), mir_opnd_none(), mir_opnd_none()))
                        mir_opt_note_change()
                    end
                end

                if op == MirOp.Add or op == MirOp.Sub do
                    if s2_t == MirOperandType.Imm and mir_opnd_imm_val(s2) == 0 do
                        vec_set_rt(instrs, i, mir_instr_new(MirOp.Move, dst, s1, mir_opnd_none()))
                        mir_opt_note_change()
                    eif s1_t == MirOperandType.Imm and mir_opnd_imm_val(s1) == 0 and op == MirOp.Add do
                        vec_set_rt(instrs, i, mir_instr_new(MirOp.Move, dst, s2, mir_opnd_none()))
                        mir_opt_note_change()
                    end
                end

                if op == MirOp.Mul do
                    if (s2_t == MirOperandType.Imm and mir_opnd_imm_val(s2) == 1) or (s1_t == MirOperandType.Imm and mir_opnd_imm_val(s1) == 1) do
                        mv_src = s1
                        if s2_t == MirOperandType.Imm and mir_opnd_imm_val(s2) == 1 do mv_src = s1 end
                        if s1_t == MirOperandType.Imm and mir_opnd_imm_val(s1) == 1 do mv_src = s2 end
                        vec_set_rt(instrs, i, mir_instr_new(MirOp.Move, dst, mv_src, mir_opnd_none()))
                        mir_opt_note_change()
                    end
                end

                if op == MirOp.Div or op == MirOp.Mod do
                    if s2_t == MirOperandType.Imm and mir_opnd_imm_val(s2) == 1 do
                        vec_set_rt(instrs, i, mir_instr_new(MirOp.Move, dst, s1, mir_opnd_none()))
                        mir_opt_note_change()
                    end
                end

                if op == MirOp.Shl or op == MirOp.Shr do
                    if s2_t == MirOperandType.Imm and mir_opnd_imm_val(s2) == 0 do
                        vec_set_rt(instrs, i, mir_instr_new(MirOp.Move, dst, s1, mir_opnd_none()))
                        mir_opt_note_change()
                    end
                end

                i = i + 1
            end
        end
        b_idx = b_idx + 1
    end
    out blocks
end.

##
 * mir_opt_inline_bump_arena_fastpath — Pre-aligns constant allocations to 16 bytes.
 ##
func mir_opt_inline_bump_arena_fastpath(blocks: i64):
    n_blocks = vec_len_rt(blocks)
    var b_idx = 0
    when b_idx < n_blocks loop
        b = vec_get_rt(blocks, b_idx)
        instrs = mir_block_head(b)
        if instrs >= 0 do
            n_ins = vec_len_rt(instrs)
            var i = 0
            when i < n_ins loop
                ins = vec_get_rt(instrs, i)
                op = mir_instr_op(ins)
                if op == MirOp.Intrinsic do
                    s2 = mir_instr_src2(ins)
                    if mir_opnd_type(s2) == MirOperandType.Imm and mir_opnd_imm_val(s2) == MIR_INTR_BUILTIN do
                        s1 = mir_instr_src1(ins)
                        if mir_opnd_type(s1) == MirOperandType.Imm do
                            bid = mir_opnd_imm_val(s1)
                            if bid == 3 or bid == 50 do
                                if i > 0 do
                                    p_ins = vec_get_rt(instrs, i - 1)
                                    if mir_instr_op(p_ins) == MirOp.SetArg do
                                        arg_val = mir_instr_src2(p_ins)
                                        if mir_opnd_type(arg_val) == MirOperandType.Imm do
                                            raw_sz = mir_opnd_imm_val(arg_val)
                                            if raw_sz > 0 do
                                                var req_align = mir_instr_align(ins)
                                                if req_align < 8 do req_align = 8 end
                                                aligned_sz = ((raw_sz + req_align - 1) / req_align) * req_align
                                                vec_set_rt(instrs, i - 1, mir_instr_new(MirOp.SetArg, mir_instr_dst(p_ins), mir_instr_src1(p_ins), mir_opnd_imm(aligned_sz)))
                                            end
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
                i = i + 1
            end
        end
        b_idx = b_idx + 1
    end
    out blocks
end.

##
 * mir_opt_arm64_addressing_modes_and_register_induction — Base-register offset folding.
 ##
func mir_opt_arm64_addressing_modes_and_register_induction(blocks: i64):
    n_blocks = vec_len_rt(blocks)
    var b_idx = 0
    when b_idx < n_blocks loop
        b = vec_get_rt(blocks, b_idx)
        instrs = mir_block_head(b)
        if instrs >= 0 do
            n_ins = vec_len_rt(instrs)
            var i = 0
            when i < n_ins loop
                ins = vec_get_rt(instrs, i)
                op = mir_instr_op(ins)
                if op == MirOp.Load or op == MirOp.Store do
                    dst = mir_instr_dst(ins)
                    ptr = mir_instr_src1(ins)
                    off = mir_instr_src2(ins)
                    if mir_opnd_type(off) == MirOperandType.Imm and mir_opnd_imm_val(off) == 0 and i > 0 do
                        prev = vec_get_rt(instrs, i - 1)
                        if mir_instr_op(prev) == MirOp.Add do
                            add_dst = mir_instr_dst(prev)
                            if mir_opnd_is_same(add_dst, ptr) do
                                base = mir_instr_src1(prev)
                                imm = mir_instr_src2(prev)
                                if mir_opnd_type(imm) == MirOperandType.Imm do
                                    if op == MirOp.Load do
                                        new_ins = mir_instr_new(MirOp.Load, dst, base, imm)
                                        mir_instr_set_aux(new_ins, mir_instr_aux(ins))
                                        mir_instr_set_type(new_ins, mir_instr_type(ins))
                                        vec_set_rt(instrs, i, new_ins)
                                    else
                                        st_val = mir_instr_src2(ins)
                                        new_ins = mir_instr_new(MirOp.Store, base, imm, st_val)
                                        mir_instr_set_aux(new_ins, mir_instr_aux(ins))
                                        mir_instr_set_type(new_ins, mir_instr_type(ins))
                                        vec_set_rt(instrs, i, new_ins)
                                    end
                                    vec_set_rt(instrs, i - 1, mir_instr_new(MirOp.Nop, mir_opnd_none(), mir_opnd_none(), mir_opnd_none()))
                                    mir_opt_note_change()
                                end
                            end
                        end
                    end
                end
                i = i + 1
            end
        end
        b_idx = b_idx + 1
    end
    out blocks
end.

func mir_trace_source_opnd(instrs: i64, limit_idx: i64, opnd: &MirOperand):
    var cur = opnd as i64
    var keep_going = true
    when keep_going loop
        keep_going = false
        if native_read_i64(cur, 0) == MirOperandType.VReg as int do
            v = native_read_i64(cur, 8)
            var k = limit_idx - 1
            when k >= 0 and not keep_going loop
                ins = vec_get_rt(instrs, k)
                if mir_instr_op(ins) == MirOp.Move do
                    dst = mir_instr_dst(ins)
                    if mir_opnd_type(dst) == MirOperandType.VReg and mir_opnd_vreg_id(dst) == v do
                        cur = mir_instr_src1(ins) as i64
                        keep_going = true
                    end
                end
                k = k - 1
            end
        end
    end
    out cur as MirOperand
end.

##
 * mir_opt_loop_idiom_recognizer — Pattern match hot loop idioms and rewrite to optimized kernels.
 ##
func mir_opt_loop_idiom_recognizer(blocks: i64):
    n_blocks = vec_len_rt(blocks)
    var i = 0
    when i < (n_blocks - 1) loop
        cond_b = vec_get_rt(blocks, i)
        cond_id = mir_block_id(cond_b)
        cond_instrs = mir_block_head(cond_b)
        if cond_instrs >= 0 do
            n_cond_ins = vec_len_rt(cond_instrs)
            if n_cond_ins >= 3 do
                ins_jump = vec_get_rt(cond_instrs, n_cond_ins - 1)
                ins_jin = vec_get_rt(cond_instrs, n_cond_ins - 2)
                ins_cmp = vec_get_rt(cond_instrs, n_cond_ins - 3)
                if mir_instr_op(ins_jump) == MirOp.Jump and mir_instr_op(ins_jin) == MirOp.JumpIfNot do
                    exit_opnd = mir_instr_src2(ins_jin)
                    body_opnd = mir_instr_src1(ins_jump)
                    body_id = mir_opnd_imm_val(body_opnd)
                    op_cmp = mir_instr_op(ins_cmp)
                    if (op_cmp == MirOp.CmpLe or op_cmp == MirOp.CmpLt) do
                        s1_cmp = mir_instr_src1(ins_cmp)
                        s2_cmp = mir_instr_src2(ins_cmp)
                        body_b = vec_get_rt(blocks, i + 1)
                        if mir_block_id(body_b) == body_id do
                            body_instrs = mir_block_head(body_b)
                            if body_instrs >= 0 do
                                n_body_ins = vec_len_rt(body_instrs)
                                if n_body_ins >= 4 do
                                    ins_body_jump = vec_get_rt(body_instrs, n_body_ins - 1)
                                    if mir_instr_op(ins_body_jump) == MirOp.Jump and mir_opnd_imm_val(mir_instr_src1(ins_body_jump)) == cond_id do
                                        var has_write_byte = 0
                                        var buf_opnd = mir_opnd_none()
                                        var val_opnd = mir_opnd_none()
                                        var bi_idx = 0
                                        when bi_idx < (n_body_ins - 1) loop
                                            b_ins = vec_get_rt(body_instrs, bi_idx)
                                            if mir_instr_op(b_ins) == MirOp.Intrinsic do
                                                s1_intr = mir_instr_src1(b_ins)
                                                s2_intr = mir_instr_src2(b_ins)
                                                if mir_opnd_type(s2_intr) == MirOperandType.Imm and mir_opnd_imm_val(s2_intr) == 8 do
                                                    if mir_opnd_type(s1_intr) == MirOperandType.Imm and mir_opnd_imm_val(s1_intr) == 6 do
                                                        if bi_idx >= 3 do
                                                            sa0 = vec_get_rt(body_instrs, bi_idx - 3)
                                                            sa1 = vec_get_rt(body_instrs, bi_idx - 2)
                                                            sa2 = vec_get_rt(body_instrs, bi_idx - 1)
                                                            if mir_instr_op(sa0) == MirOp.SetArg and mir_instr_op(sa1) == MirOp.SetArg and mir_instr_op(sa2) == MirOp.SetArg do
                                                                buf_opnd = mir_trace_source_opnd(body_instrs, bi_idx - 3, mir_instr_src2(sa0))
                                                                val_opnd = mir_trace_source_opnd(body_instrs, bi_idx - 1, mir_instr_src2(sa2))
                                                                has_write_byte = 1
                                                            end
                                                        end
                                                    end
                                                end
                                            end
                                            bi_idx = bi_idx + 1
                                        end
                                        var is_step_one = 0
                                        var step_k = 0
                                        when step_k < n_body_ins loop
                                            ins_step = vec_get_rt(body_instrs, step_k)
                                            if mir_instr_op(ins_step) == MirOp.Add do
                                                s1_add = mir_trace_source_opnd(body_instrs, step_k, mir_instr_src1(ins_step))
                                                s2_add = mir_trace_source_opnd(body_instrs, step_k, mir_instr_src2(ins_step))
                                                if (mir_opnd_type(s1_add) == MirOperandType.Imm and mir_opnd_imm_val(s1_add) == 1) or (mir_opnd_type(s2_add) == MirOperandType.Imm and mir_opnd_imm_val(s2_add) == 1) do
                                                    is_step_one = 1
                                                end
                                            end
                                            step_k = step_k + 1
                                        end
                                        var val_is_invariant = 0
                                        if mir_opnd_type(val_opnd) == MirOperandType.Imm do
                                            val_is_invariant = 1
                                        eif mir_opnd_type(val_opnd) == MirOperandType.VReg do
                                            var v_def_in_body = 0
                                            var vi = 0
                                            let target_v = mir_opnd_vreg_id(val_opnd)
                                            when vi < n_body_ins loop
                                                let b_ins_chk = vec_get_rt(body_instrs, vi)
                                                let dst_chk = mir_instr_dst(b_ins_chk)
                                                if mir_opnd_type(dst_chk) == MirOperandType.VReg and mir_opnd_vreg_id(dst_chk) == target_v do
                                                    v_def_in_body = 1
                                                end
                                                vi = vi + 1
                                            end
                                            if v_def_in_body == 0 do
                                                val_is_invariant = 1
                                            end
                                        end
                                        # Check that the buffer pointer is also loop-invariant
                                        # (i.e. not defined inside the loop body). If buf_opnd is a VReg
                                        # whose definition is inside body_instrs, the buffer changes every
                                        # iteration (e.g. `let p = alloc(64)`) and must NOT be rewritten.
                                        var buf_is_invariant = 0
                                        if mir_opnd_type(buf_opnd) == MirOperandType.Imm do
                                            buf_is_invariant = 1
                                        eif mir_opnd_type(buf_opnd) == MirOperandType.VReg do
                                            var buf_def_in_body = 0
                                            let buf_vreg_id = mir_opnd_vreg_id(buf_opnd)
                                            var bvi = 0
                                            when bvi < n_body_ins loop
                                                let b_chk2 = vec_get_rt(body_instrs, bvi)
                                                let dst_b2 = mir_instr_dst(b_chk2)
                                                if mir_opnd_type(dst_b2) == MirOperandType.VReg and mir_opnd_vreg_id(dst_b2) == buf_vreg_id do
                                                    buf_def_in_body = 1
                                                end
                                                bvi = bvi + 1
                                            end
                                            if buf_def_in_body == 0 do
                                                buf_is_invariant = 1
                                            end
                                        end
                                        if has_write_byte == 1 and is_step_one == 1 and val_is_invariant == 1 and buf_is_invariant == 1 do
                                            real_limit = mir_trace_source_opnd(cond_instrs, n_cond_ins - 3, s2_cmp)
                                            len_opnd = real_limit
                                            if op_cmp == MirOp.CmpLe do
                                                if mir_opnd_type(real_limit) == MirOperandType.Imm do
                                                    len_opnd = mir_opnd_imm(mir_opnd_imm_val(real_limit) + 1)
                                                end
                                            end
                                            ins_sa0 = mir_instr_new(MirOp.SetArg, mir_opnd_none(), mir_opnd_imm(0), buf_opnd)
                                            ins_sa1 = mir_instr_new(MirOp.SetArg, mir_opnd_none(), mir_opnd_imm(1), val_opnd)
                                            ins_sa2 = mir_instr_new(MirOp.SetArg, mir_opnd_none(), mir_opnd_imm(2), len_opnd)
                                            ins_memset = mir_instr_new(MirOp.Intrinsic, mir_opnd_none(), mir_opnd_imm(32), mir_opnd_imm(8))
                                            ins_exit_jump = mir_instr_new(MirOp.Jump, mir_opnd_none(), exit_opnd, mir_opnd_none())
                                            var ck = 0
                                            when ck < (n_cond_ins - 3) loop
                                                vec_set_rt(cond_instrs, ck, mir_instr_new(MirOp.Nop, mir_opnd_none(), mir_opnd_none(), mir_opnd_none()))
                                                ck = ck + 1
                                            end
                                            vec_set_rt(cond_instrs, n_cond_ins - 3, ins_sa0)
                                            vec_set_rt(cond_instrs, n_cond_ins - 2, ins_sa1)
                                            vec_set_rt(cond_instrs, n_cond_ins - 1, ins_sa2)
                                            cond_instrs = vec_push_rt(cond_instrs, ins_memset)
                                            cond_instrs = vec_push_rt(cond_instrs, ins_exit_jump)
                                            var bk = 0
                                            when bk < n_body_ins loop
                                                vec_set_rt(body_instrs, bk, mir_instr_new(MirOp.Nop, mir_opnd_none(), mir_opnd_none(), mir_opnd_none()))
                                                bk = bk + 1
                                            end
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
        i = i + 1
    end
    out blocks
end.

##
 * vir/compiler/mir_opt_advanced.vri — Spec §1.2.1 advanced MIR passes
 * Included by mir_opt.vri (shares its imports and helpers).
 ##

func mir_strings_get(strings: i64, idx: i64):
    if strings < 0 do out "" end
    if idx < 0 or idx >= vec_len_rt(strings) do out "" end
    out vec_get_rt(strings, idx)
end.

func mir_program_find_func(program: i64, name: string):
    if program < 0 do out 0 end
    var fi = vec_len_rt(program) - 1
    when fi >= 0 loop
        f = vec_get_rt(program, fi)
        if rt_streq(mir_func_name(f), name) do out f end
        fi = fi - 1
    end
    out 0
end.

func mir_count_all_instrs(blocks: i64):
    total = 0
    var bi = 0
    when bi < vec_len_rt(blocks) loop
        instrs = mir_block_head(vec_get_rt(blocks, bi))
        if instrs >= 0 do total = total + vec_len_rt(instrs) end
        bi = bi + 1
    end
    out total
end.

func mir_blocks_contain_call(blocks: i64):
    var bi = 0
    when bi < vec_len_rt(blocks) loop
        instrs = mir_block_head(vec_get_rt(blocks, bi))
        if instrs >= 0 do
            var ii = 0
            when ii < vec_len_rt(instrs) loop
                if mir_instr_op(vec_get_rt(instrs, ii)) == MirOp.Call do out true end
                ii = ii + 1
            end
        end
        bi = bi + 1
    end
    out false
end.

func mir_vreg_is_induction_step(blocks: i64, body_idx: i64, v: i64):
    instrs = mir_block_head(vec_get_rt(blocks, body_idx))
    if instrs < 0 do out (false, 0) end
    var ii = 0
    when ii < vec_len_rt(instrs) loop
        ins = vec_get_rt(instrs, ii)
        if mir_instr_op(ins) == MirOp.Add do
            dst = mir_instr_dst(ins)
            if mir_opnd_type(dst) == MirOperandType.VReg and mir_opnd_vreg_id(dst) == v do
                s1 = mir_instr_src1(ins)
                s2 = mir_instr_src2(ins)
                if mir_opnd_type(s2) == MirOperandType.Imm and mir_opnd_imm_val(s2) == 1 do
                    if mir_opnd_type(s1) == MirOperandType.VReg and mir_opnd_vreg_id(s1) == v do
                        out (true, 1)
                    end
                end
                if mir_opnd_type(s1) == MirOperandType.Imm and mir_opnd_imm_val(s1) == 1 do
                    if mir_opnd_type(s2) == MirOperandType.VReg and mir_opnd_vreg_id(s2) == v do
                        out (true, 1)
                    end
                end
            end
        end
        ii = ii + 1
    end
    out (false, 0)
end.

func mir_inline_remap_opnd(opnd: &MirOperand, param_vregs: i64, arg_vals: i64, vreg_base: i64):
    if mir_opnd_type(opnd) != MirOperandType.VReg do out opnd end
    vid = mir_opnd_vreg_id(opnd)
    if param_vregs >= 0 do
        var pi = 0
        when pi < vec_len_rt(param_vregs) loop
            if vec_get_rt(param_vregs, pi) == vid do
                out vec_get_rt(arg_vals, pi)
            end
            pi = pi + 1
        end
    end
    out mir_opnd_vreg(vreg_base + vid)
end.

func mir_inline_clone_instr(ins: &MirInstr, param_vregs: i64, arg_vals: i64, vreg_base: i64):
    op = mir_instr_op(ins)
    dst = mir_inline_remap_opnd(mir_instr_dst(ins), param_vregs, arg_vals, vreg_base)
    s1 = mir_inline_remap_opnd(mir_instr_src1(ins), param_vregs, arg_vals, vreg_base)
    s2 = mir_inline_remap_opnd(mir_instr_src2(ins), param_vregs, arg_vals, vreg_base)
    if op == MirOp.Return do
        out mir_instr_new(MirOp.Move, dst, s1, mir_opnd_none())
    end
    if op == MirOp.Intrinsic do
        s2k = mir_instr_src2(ins)
        if mir_opnd_type(s2k) == MirOperandType.Imm and mir_opnd_imm_val(s2k) == MIR_INTR_PARAM do
            out mir_instr_new(MirOp.Nop, mir_opnd_none(), mir_opnd_none(), mir_opnd_none())
        end
    end
    let cloned = mir_instr_new(op, dst, s1, s2)
    mir_instr_set_aux(cloned, mir_instr_aux(ins))
    mir_instr_set_type(cloned, mir_instr_type(ins))
    mir_instr_set_alloc_kind(cloned, mir_instr_alloc_kind(ins))
    mir_instr_set_region(cloned, mir_instr_region(ins))
    var epoch = mir_instr_epoch(ins)
    if epoch > 0 do epoch = epoch + vreg_base end
    mir_instr_set_epoch(cloned, epoch)
    mir_instr_set_size(cloned, mir_instr_size(ins))
    mir_instr_set_align(cloned, mir_instr_align(ins))
    mir_instr_set_provenance(cloned, mir_instr_provenance(ins))
    mir_instr_set_parent_rel(cloned, mir_instr_parent_rel(ins))
    mir_instr_set_src_origin(cloned, mir_instr_src_origin(ins))
    if mir_instr_provenance(ins) == 1 and mir_opnd_type(dst) == MirOperandType.VReg do
        let cloned_id = mir_opnd_vreg_id(dst)
        mir_instr_set_owner_id(cloned, cloned_id)
        mir_instr_set_alloc_id(cloned, cloned_id)
    else
        mir_instr_set_owner_id(cloned, mir_instr_owner_id(ins))
        mir_instr_set_alloc_id(cloned, mir_instr_alloc_id(ins))
    end
    out cloned
end.

func mir_opt_collect_call_args(instrs: i64, call_idx: i64, nargs: i64):
    args = vec_new_rt()
    var ai = 0
    when ai < nargs loop
        args = vec_push_rt(args, mir_opnd_none())
        ai = ai + 1
    end
    ci = call_idx - 1
    when ci >= 0 loop
        ins = vec_get_rt(instrs, ci)
        if mir_instr_op(ins) != MirOp.SetArg do
            ci = 0 - 1
        else
            slot = mir_opnd_imm_val(mir_instr_src1(ins))
            if slot >= 0 and slot < nargs do
                vec_set_rt(args, slot, mir_instr_src2(ins))
            end
            ci = ci - 1
        end
    end
    out args
end.

func mir_callee_param_vregs(callee_blocks: i64):
    pmap = vec_new_rt()
    var bi = 0
    when bi < vec_len_rt(callee_blocks) loop
        instrs = mir_block_head(vec_get_rt(callee_blocks, bi))
        if instrs >= 0 do
            var ii = 0
            when ii < vec_len_rt(instrs) loop
                ins = vec_get_rt(instrs, ii)
                if mir_instr_op(ins) == MirOp.Intrinsic do
                    s2 = mir_instr_src2(ins)
                    if mir_opnd_type(s2) == MirOperandType.Imm and mir_opnd_imm_val(s2) == MIR_INTR_PARAM do
                        idx = mir_opnd_imm_val(mir_instr_src1(ins))
                        dst = mir_instr_dst(ins)
                        if mir_opnd_type(dst) == MirOperandType.VReg do
                            var grow = vec_len_rt(pmap)
                            when grow <= idx loop
                                pmap = vec_push_rt(pmap, 0 - 1)
                                grow = grow + 1
                            end
                            vec_set_rt(pmap, idx, mir_opnd_vreg_id(dst))
                        end
                    end
                end
                ii = ii + 1
            end
        end
        bi = bi + 1
    end
    out pmap
end.

##
 * IVSR — pointer induction: Load(base, Mul(iv, es)) + iv++  =>  running pointer.
 ##
func mir_opt_ivsr(blocks: i64):
    n_blocks = vec_len_rt(blocks)
    var hdr_idx = 0
    when hdr_idx < n_blocks loop
        hdr = vec_get_rt(blocks, hdr_idx)
        hdr_id = mir_block_id(hdr)
        succs = mir_block_successors(hdr)
        if succs >= 0 do
            var si = 0
            when si < vec_len_rt(succs) loop
                body_id = vec_get_rt(succs, si)
                body_idx = mir_find_block_index(blocks, body_id)
                if body_idx >= 0 do
                    preds = mir_block_preds(vec_get_rt(blocks, body_idx))
                    var back = 0
                    if preds >= 0 do
                        var pi = 0
                        when pi < vec_len_rt(preds) loop
                            if vec_get_rt(preds, pi) == hdr_id do back = 1 end
                            pi = pi + 1
                        end
                    end
                    if back == 1 do
                        body_instrs = mir_block_head(vec_get_rt(blocks, body_idx))
                        if body_instrs >= 0 do
                            var ii = 0
                            when ii < vec_len_rt(body_instrs) loop
                                ins = vec_get_rt(body_instrs, ii)
                                if mir_instr_op(ins) == MirOp.Load or mir_instr_op(ins) == MirOp.Store do
                                    off = mir_instr_src2(ins)
                                    if mir_opnd_type(off) == MirOperandType.VReg do
                                        ov = mir_opnd_vreg_id(off)
                                        def_ins = mir_arm64_trace_vreg_def(body_instrs, ii, ov)
                                        if mir_instr_op(def_ins) == MirOp.Mul do
                                            ms1 = mir_instr_src1(def_ins)
                                            ms2 = mir_instr_src2(def_ins)
                                            iv = 0 - 1
                                            es = 0
                                            if mir_opnd_type(ms2) == MirOperandType.Imm do
                                                iv = mir_opnd_vreg_id(ms1)
                                                es = mir_opnd_imm_val(ms2)
                                            eif mir_opnd_type(ms1) == MirOperandType.Imm do
                                                iv = mir_opnd_vreg_id(ms2)
                                                es = mir_opnd_imm_val(ms1)
                                            end
                                            var (is_iv, step) = mir_vreg_is_induction_step(blocks, body_idx, iv)
                                            if is_iv and es > 0 do
                                                ptr = mir_instr_src1(ins)
                                                run = mir_instr_dst(def_ins)
                                                if mir_instr_op(ins) == MirOp.Load do
                                                    new_ins = mir_instr_new(MirOp.Load, mir_instr_dst(ins), run, mir_opnd_imm(0))
                                                    mir_instr_set_aux(new_ins, mir_instr_aux(ins))
                                                    mir_instr_set_type(new_ins, mir_instr_type(ins))
                                                    vec_set_rt(body_instrs, ii, new_ins)
                                                else
                                                    new_ins = mir_instr_new(MirOp.Store, run, mir_opnd_imm(0), mir_instr_src2(ins))
                                                    mir_instr_set_aux(new_ins, mir_instr_aux(ins))
                                                    mir_instr_set_type(new_ins, mir_instr_type(ins))
                                                    vec_set_rt(body_instrs, ii, new_ins)
                                                end
                                                vec_set_rt(body_instrs, ii + 1, mir_instr_new(MirOp.Add, run, run, mir_opnd_imm(es)))
                                                mir_opt_note_change()
                                            end
                                        end
                                    end
                                end
                                ii = ii + 1
                            end
                            vec_set_rt(blocks, body_idx, mir_block_replace_head(vec_get_rt(blocks, body_idx), body_instrs))
                        end
                    end
                end
                si = si + 1
            end
        end
        hdr_idx = hdr_idx + 1
    end
    out blocks
end.

##
 * Symbolic loop collapse — sum(0..n-1) via Gauss formula.
 ##
func mir_opt_symbolic_loop_collapse(blocks: i64):
    n_blocks = vec_len_rt(blocks)
    var i = 0
    when i < (n_blocks - 1) loop
        cond_b = vec_get_rt(blocks, i)
        cond_instrs = mir_block_head(cond_b)
        if cond_instrs >= 0 do
            n_cond = vec_len_rt(cond_instrs)
            if n_cond >= 3 do
                ins_jump = vec_get_rt(cond_instrs, n_cond - 1)
                ins_jin = vec_get_rt(cond_instrs, n_cond - 2)
                ins_cmp = vec_get_rt(cond_instrs, n_cond - 3)
                if mir_instr_op(ins_jump) == MirOp.Jump and mir_instr_op(ins_jin) == MirOp.JumpIfNot do
                    exit_opnd = mir_instr_src2(ins_jin)
                    body_id = mir_opnd_imm_val(mir_instr_src1(ins_jump))
                    body_b = vec_get_rt(blocks, i + 1)
                    if mir_block_id(body_b) == body_id do
                        body_instrs = mir_block_head(body_b)
                        if body_instrs >= 0 do
                            n_body = vec_len_rt(body_instrs)
                            cond_id = mir_block_id(cond_b)
                            last_body = vec_get_rt(body_instrs, n_body - 1)
                            # Skip counted loops with a separate step block (body -> step -> cond).
                            if n_body >= 1 and mir_instr_op(last_body) == MirOp.Jump and mir_opnd_imm_val(mir_instr_src1(last_body)) == cond_id do
                            op_cmp = mir_instr_op(ins_cmp)
                            if op_cmp == MirOp.CmpLe or op_cmp == MirOp.CmpLt do
                                limit_op = mir_instr_src2(ins_cmp)
                                iv_op = mir_instr_src1(ins_cmp)
                                var has_sum = 0
                                sum_dst = mir_opnd_none()
                                var bi = 0
                                when bi < (vec_len_rt(body_instrs) - 1) loop
                                    b_ins = vec_get_rt(body_instrs, bi)
                                    if mir_instr_op(b_ins) == MirOp.Add do
                                        s1a = mir_instr_src1(b_ins)
                                        s2a = mir_instr_src2(b_ins)
                                        if mir_opnd_is_same(s1a, iv_op) do
                                            has_sum = 1
                                            sum_dst = mir_instr_dst(b_ins)
                                        eif mir_opnd_is_same(s2a, iv_op) do
                                            has_sum = 1
                                            sum_dst = mir_instr_dst(b_ins)
                                        end
                                    end
                                    bi = bi + 1
                                end
                                if has_sum == 1 and mir_opnd_type(limit_op) == MirOperandType.Imm do
                                    n = mir_opnd_imm_val(limit_op)
                                    if op_cmp == MirOp.CmpLe do n = n + 1 end
                                    gauss = (n * (n - 1)) / 2
                                    ins_mv = mir_instr_new(MirOp.Move, sum_dst, mir_opnd_imm(gauss), mir_opnd_none())
                                    ins_exit = mir_instr_new(MirOp.Jump, mir_opnd_none(), exit_opnd, mir_opnd_none())
                                    var ck = 0
                                    when ck < (n_cond - 3) loop
                                        vec_set_rt(cond_instrs, ck, mir_instr_new(MirOp.Nop, mir_opnd_none(), mir_opnd_none(), mir_opnd_none()))
                                        ck = ck + 1
                                    end
                                    vec_set_rt(cond_instrs, n_cond - 3, ins_mv)
                                    vec_set_rt(cond_instrs, n_cond - 2, ins_exit)
                                    vec_set_rt(cond_instrs, n_cond - 1, mir_instr_new(MirOp.Nop, mir_opnd_none(), mir_opnd_none(), mir_opnd_none()))
                                    var bk = 0
                                    when bk < vec_len_rt(body_instrs) loop
                                        vec_set_rt(body_instrs, bk, mir_instr_new(MirOp.Nop, mir_opnd_none(), mir_opnd_none(), mir_opnd_none()))
                                        bk = bk + 1
                                    end
                                    mir_opt_note_change()
                                end
                            end
                            end
                        end
                    end
                end
            end
        end
        i = i + 1
    end
    out blocks
end.

##
 * BCE — eliminate redundant bounds compares and downgrade SAFE_ACCESS.
 ##
func mir_opt_bce(blocks: i64):
    n_blocks = vec_len_rt(blocks)
    var b_idx = 0
    when b_idx < n_blocks loop
        instrs = mir_block_head(vec_get_rt(blocks, b_idx))
        if instrs >= 0 do
            var i = 0
            when i < vec_len_rt(instrs) loop
                ins = vec_get_rt(instrs, i)
                op = mir_instr_op(ins)
                if op == MirOp.CmpLt or op == MirOp.CmpLe or op == MirOp.CmpGt or op == MirOp.CmpGe do
                    if i > 0 do
                        prev = vec_get_rt(instrs, i - 1)
                        if mir_instr_op(prev) == op do
                            if mir_opnd_is_same(mir_instr_src1(prev), mir_instr_src1(ins)) and mir_opnd_is_same(mir_instr_src2(prev), mir_instr_src2(ins)) do
                                vec_set_rt(instrs, i, mir_instr_new(MirOp.Move, mir_instr_dst(ins), mir_opnd_imm(1), mir_opnd_none()))
                                mir_opt_note_change()
                            end
                        end
                    end
                end
                if op == MirOp.Intrinsic do
                    s2k = mir_instr_src2(ins)
                    if mir_opnd_type(s2k) == MirOperandType.Imm and mir_opnd_imm_val(s2k) == MIR_INTR_SAFE_ACCESS do
                        if i > 0 do
                            prev = vec_get_rt(instrs, i - 1)
                            if mir_instr_op(prev) == MirOp.CmpLt or mir_instr_op(prev) == MirOp.CmpLe do
                                vec_set_rt(instrs, i, mir_instr_new(MirOp.Intrinsic, mir_instr_dst(ins), mir_instr_src1(ins), mir_opnd_imm(MIR_INTR_INDEX)))
                                mir_opt_note_change()
                            end
                        end
                    end
                end
                i = i + 1
            end
        end
        b_idx = b_idx + 1
    end
    out blocks
end.

##
 * PRE — hoist partially-redundant pure exprs into dominating predecessor.
 ##
func mir_opt_pre(blocks: i64):
    # PRE is disabled until safe cross-predecessor insertion is implemented.
    # Blindly hoisting from a successor into one predecessor starves all other predecessors.
    out blocks
end.

func mir_slp_find_def_before(instrs: i64, max_idx: int, vreg_id: i64) -> int:
    var cur_v = vreg_id
    var k = max_idx - 1
    when k >= 0 loop
        let ins = vec_get_rt(instrs, k)
        let op = mir_instr_op(ins)
        if op < MirOp.VLoad as i64 or op > MirOp.Shuffle as i64 do
            let d = mir_instr_dst(ins)
            if mir_opnd_type(d) == MirOperandType.VReg and mir_opnd_vreg_id(d) == cur_v do
                if op == MirOp.Move do
                    let s1 = mir_instr_src1(ins)
                    if mir_opnd_type(s1) == MirOperandType.VReg do
                        cur_v = mir_opnd_vreg_id(s1)
                    else
                        out k
                    end
                else
                    out k
                end
            end
        end
        k = k - 1
    end
    out 0 - 1
end.

func mir_slp_is_index_load_at(instrs: i64, ld_idx: int):
    if ld_idx < 1 do out (0, mir_opnd_none(), mir_opnd_none()) end
    let ld_ins = vec_get_rt(instrs, ld_idx)
    if mir_instr_op(ld_ins) != MirOp.Intrinsic do out (0, mir_opnd_none(), mir_opnd_none()) end
    let s2k = mir_instr_src2(ld_ins)
    if mir_opnd_type(s2k) != MirOperandType.Imm do out (0, mir_opnd_none(), mir_opnd_none()) end
    let kind = mir_opnd_imm_val(s2k)
    if kind != MIR_INTR_INDEX and kind != MIR_INTR_SAFE_ACCESS do out (0, mir_opnd_none(), mir_opnd_none()) end
    let sa = vec_get_rt(instrs, ld_idx - 1)
    if mir_instr_op(sa) != MirOp.SetArg do out (0, mir_opnd_none(), mir_opnd_none()) end
    if mir_opnd_imm_val(mir_instr_src1(sa)) != 0 do out (0, mir_opnd_none(), mir_opnd_none()) end
    let base_op = mir_trace_source_opnd(instrs, ld_idx, mir_instr_src1(ld_ins))
    let idx_op = mir_trace_source_opnd(instrs, ld_idx - 1, mir_instr_src2(sa))
    out (1, base_op, idx_op)
end.

func mir_slp_is_index_store_at(instrs: i64, st_idx: int):
    if st_idx < 2 do out (0, mir_opnd_none(), mir_opnd_none(), mir_opnd_none()) end
    let st_ins = vec_get_rt(instrs, st_idx)
    if mir_instr_op(st_ins) != MirOp.Intrinsic do out (0, mir_opnd_none(), mir_opnd_none(), mir_opnd_none()) end
    let s2k = mir_instr_src2(st_ins)
    if mir_opnd_type(s2k) != MirOperandType.Imm or mir_opnd_imm_val(s2k) != MIR_INTR_INDEX_STORE do
        out (0, mir_opnd_none(), mir_opnd_none(), mir_opnd_none())
    end
    let sa0 = vec_get_rt(instrs, st_idx - 2)
    let sa1 = vec_get_rt(instrs, st_idx - 1)
    if mir_instr_op(sa0) != MirOp.SetArg or mir_instr_op(sa1) != MirOp.SetArg do
        out (0, mir_opnd_none(), mir_opnd_none(), mir_opnd_none())
    end
    if mir_opnd_imm_val(mir_instr_src1(sa0)) != 0 or mir_opnd_imm_val(mir_instr_src1(sa1)) != 1 do
        out (0, mir_opnd_none(), mir_opnd_none(), mir_opnd_none())
    end
    let base_op = mir_trace_source_opnd(instrs, st_idx, mir_instr_src1(st_ins))
    let idx_op = mir_trace_source_opnd(instrs, st_idx - 2, mir_instr_src2(sa0))
    let val_op = mir_trace_source_opnd(instrs, st_idx - 1, mir_instr_src2(sa1))
    out (1, base_op, idx_op, val_op)
end.

func mir_slp_has_barrier_between(instrs: i64, start_idx: int, end_idx: int) -> int:
    var k = start_idx + 1
    when k < end_idx loop
        let ins = vec_get_rt(instrs, k)
        let op = mir_instr_op(ins)
        if op == MirOp.Call do out 1 end
        if op == MirOp.Intrinsic do
            let s2k = mir_instr_src2(ins)
            if mir_opnd_type(s2k) == MirOperandType.Imm do
                let kind = mir_opnd_imm_val(s2k)
                if kind == MIR_MEM_MARK or kind == MIR_MEM_RESET or kind == MIR_MEM_PROMOTE or kind == MIR_MEM_DROP or kind == MIR_INTR_THROW or kind == MIR_INTR_REVERT or kind == MIR_INTR_INDEX_STORE do
                    out 1
                end
            end
        end
        k = k + 1
    end
    out 0
end.

func mir_slp_vector_op_for(scalar_op: i64) -> i64:
    if scalar_op == MirOp.Add do out MirOp.VAdd end
    if scalar_op == MirOp.Sub do out MirOp.VSub end
    if scalar_op == MirOp.Mul do out MirOp.VMul end
    out 0 - 1
end.

func mir_opt_slp_block(instrs: i64):
    let n = vec_len_rt(instrs)
    var s0 = 2
    when s0 < n loop
        let (ok0, dst0, idx0, val0) = mir_slp_is_index_store_at(instrs, s0)
        if ok0 == 1 and mir_opnd_type(idx0) == MirOperandType.Imm and mir_opnd_imm_val(idx0) == 0 and mir_opnd_type(val0) == MirOperandType.VReg do
            let bin0_pos = mir_slp_find_def_before(instrs, s0 - 2, mir_opnd_vreg_id(val0))
            if bin0_pos >= 0 do
                let bin0 = vec_get_rt(instrs, bin0_pos)
                let v_op = mir_slp_vector_op_for(mir_instr_op(bin0))
                if v_op >= 0 and mir_opnd_type(mir_instr_src1(bin0)) == MirOperandType.VReg and mir_opnd_type(mir_instr_src2(bin0)) == MirOperandType.VReg do
                    let ld0_a = mir_slp_find_def_before(instrs, bin0_pos, mir_opnd_vreg_id(mir_instr_src1(bin0)))
                    let ld0_b = mir_slp_find_def_before(instrs, bin0_pos, mir_opnd_vreg_id(mir_instr_src2(bin0)))
                    let (oka0, src1_0, idx0_a) = mir_slp_is_index_load_at(instrs, ld0_a)
                    let (okb0, src2_0, idx0_b) = mir_slp_is_index_load_at(instrs, ld0_b)
                    if oka0 == 1 and okb0 == 1 and mir_opnd_type(idx0_a) == MirOperandType.Imm and mir_opnd_imm_val(idx0_a) == 0 and mir_opnd_type(idx0_b) == MirOperandType.Imm and mir_opnd_imm_val(idx0_b) == 0 do
                        # Look for adjacent store1 at lane 1 without intervening barriers
                        var s1 = s0 + 3
                        var matched = 0
                        when s1 < n and matched == 0 loop
                            if mir_slp_has_barrier_between(instrs, s0, s1) == 1 do
                                s1 = n
                            else
                                let (ok1, dst1, idx1, val1) = mir_slp_is_index_store_at(instrs, s1)
                                if ok1 == 1 and mir_opnd_is_same(dst0, dst1) and mir_opnd_type(idx1) == MirOperandType.Imm and mir_opnd_imm_val(idx1) == 1 and mir_opnd_type(val1) == MirOperandType.VReg do
                                    let bin1_pos = mir_slp_find_def_before(instrs, s1 - 2, mir_opnd_vreg_id(val1))
                                    if bin1_pos > s0 do
                                        let bin1 = vec_get_rt(instrs, bin1_pos)
                                        if mir_instr_op(bin1) == mir_instr_op(bin0) and mir_opnd_type(mir_instr_src1(bin1)) == MirOperandType.VReg and mir_opnd_type(mir_instr_src2(bin1)) == MirOperandType.VReg do
                                            let ld1_a = mir_slp_find_def_before(instrs, bin1_pos, mir_opnd_vreg_id(mir_instr_src1(bin1)))
                                            let ld1_b = mir_slp_find_def_before(instrs, bin1_pos, mir_opnd_vreg_id(mir_instr_src2(bin1)))
                                            let (oka1, src1_1, idx1_a) = mir_slp_is_index_load_at(instrs, ld1_a)
                                            let (okb1, src2_1, idx1_b) = mir_slp_is_index_load_at(instrs, ld1_b)
                                            if oka1 == 1 and okb1 == 1 and mir_opnd_is_same(src1_0, src1_1) and mir_opnd_is_same(src2_0, src2_1) do
                                                var alias_ok = 0
                                                if g_mir_mutate_mode == 4 do
                                                    alias_ok = 1
                                                else
                                                    if mir_opnd_type(idx1_a) == MirOperandType.Imm and mir_opnd_imm_val(idx1_a) == 1 and mir_opnd_type(idx1_b) == MirOperandType.Imm and mir_opnd_imm_val(idx1_b) == 1 do
                                                        if not mir_opnd_is_same(dst0, src1_0) and not mir_opnd_is_same(dst0, src2_0) do
                                                            alias_ok = 1
                                                        end
                                                    end
                                                end
                                                if alias_ok == 1 do
                                                    let nop_ins = mir_instr_new(MirOp.Nop, mir_opnd_none(), mir_opnd_none(), mir_opnd_none())
                                                    vec_set_rt(instrs, s0 - 2, nop_ins)
                                                    vec_set_rt(instrs, s0 - 1, nop_ins)
                                                    vec_set_rt(instrs, s0, nop_ins)
                                                    vec_set_rt(instrs, s1 - 2, nop_ins)
                                                    vec_set_rt(instrs, s1 - 1, nop_ins)
                                                    let v_ins = mir_instr_new(v_op, dst0, src1_0, src2_0)
                                                    mir_instr_set_aux(v_ins, (2 shl 8) or 1)
                                                    vec_set_rt(instrs, s1, v_ins)
                                                    mir_opt_note_change()
                                                    matched = 1
                                                end
                                            end
                                        end
                                    end
                                end
                                s1 = s1 + 1
                            end
                        end
                    end
                end
            end
        end
        s0 = s0 + 1
    end
    out instrs
end.

func mir_opt_loop_vectorize(blocks: i64):
    let n_blocks = vec_len_rt(blocks)
    var i = 0
    when i < (n_blocks - 2) loop
        let cond_b = vec_get_rt(blocks, i)
        let body_b = vec_get_rt(blocks, i + 1)
        let end_b = vec_get_rt(blocks, i + 2)
        let cond_instrs = mir_block_head(cond_b)
        let body_instrs = mir_block_head(body_b)
        let end_instrs = mir_block_head(end_b)
        if cond_instrs >= 0 and body_instrs >= 0 and end_instrs >= 0 do
            let n_cond = vec_len_rt(cond_instrs)
            if n_cond >= 3 do
                let ins_cmp = vec_get_rt(cond_instrs, n_cond - 3)
                let ins_jin = vec_get_rt(cond_instrs, n_cond - 2)
                let ins_jmp = vec_get_rt(cond_instrs, n_cond - 1)
                if mir_instr_op(ins_cmp) == MirOp.CmpLt and mir_instr_op(ins_jin) == MirOp.JumpIfNot and mir_instr_op(ins_jmp) == MirOp.Jump do
                    let iv_op = mir_instr_src1(ins_cmp)
                    var limit_op = mir_trace_source_opnd(cond_instrs, n_cond - 3, mir_instr_src2(ins_cmp))
                    if mir_opnd_type(limit_op) == MirOperandType.VReg and i > 0 do
                        let pre_instrs = mir_block_head(vec_get_rt(blocks, i - 1))
                        if pre_instrs >= 0 do
                            limit_op = mir_trace_source_opnd(pre_instrs, vec_len_rt(pre_instrs), limit_op)
                        end
                    end
                    if mir_opnd_type(iv_op) == MirOperandType.VReg and mir_opnd_type(limit_op) == MirOperandType.Imm do
                        let iv_vreg = mir_opnd_vreg_id(iv_op)
                        let trip_n = mir_opnd_imm_val(limit_op)
                        var iv_start_known = 0
                        var iv_start_val = 0
                        let phis = mir_block_phis(cond_b)
                        if phis >= 0 do
                            let n_phis = vec_len_rt(phis)
                            var p = 0
                            when p < n_phis loop
                                let phi = vec_get_rt(phis, p)
                                if mir_phi_dst(phi) == iv_vreg do
                                    let inc_vals = mir_phi_incoming_values(phi)
                                    let inc_blks = mir_phi_incoming_blocks(phi)
                                    let n_inc = vec_len_rt(inc_vals)
                                    var k = 0
                                    when k < n_inc loop
                                        let inc_blk_id = vec_get_rt(inc_blks, k)
                                        if inc_blk_id != mir_block_id(body_b) do
                                            let inc_v = vec_get_rt(inc_vals, k) as MirOperand
                                            if mir_opnd_type(inc_v) == MirOperandType.Imm do
                                                iv_start_known = 1
                                                iv_start_val = mir_opnd_imm_val(inc_v)
                                            eif mir_opnd_type(inc_v) == MirOperandType.VReg do
                                                var b_scan = 0
                                                when b_scan < n_blocks loop
                                                    let cand_b = vec_get_rt(blocks, b_scan)
                                                    if mir_block_id(cand_b) == inc_blk_id do
                                                        let b_instrs = mir_block_head(cand_b)
                                                        if b_instrs >= 0 do
                                                            let traced_start = mir_trace_source_opnd(b_instrs, vec_len_rt(b_instrs), inc_v)
                                                            if mir_opnd_type(traced_start) == MirOperandType.Imm do
                                                                iv_start_known = 1
                                                                iv_start_val = mir_opnd_imm_val(traced_start)
                                                            end
                                                        end
                                                    end
                                                    b_scan = b_scan + 1
                                                end
                                            end
                                        end
                                        k = k + 1
                                    end
                                end
                                p = p + 1
                            end
                        end
                        if iv_start_known == 0 and i > 0 do
                            let pre_instrs = mir_block_head(vec_get_rt(blocks, i - 1))
                            if pre_instrs >= 0 do
                                let traced_pre = mir_trace_source_opnd(pre_instrs, vec_len_rt(pre_instrs), iv_op)
                                if mir_opnd_type(traced_pre) == MirOperandType.Imm do
                                    iv_start_known = 1
                                    iv_start_val = mir_opnd_imm_val(traced_pre)
                                end
                            end
                        end
                        if iv_start_known == 1 and iv_start_val == 0 and trip_n >= 2 do
                            # Scan body_instrs for barriers and count stores
                            let n_body = vec_len_rt(body_instrs)
                            var has_barrier = 0
                            var store_count = 0
                            var st_pos = 0 - 1
                            var iv_add_pos = 0 - 1
                            var bi = 0
                            when bi < n_body loop
                                let bins = vec_get_rt(body_instrs, bi)
                                let bop = mir_instr_op(bins)
                                if bop == MirOp.Call do has_barrier = 1 end
                                if bop >= MirOp.VLoad as i64 and bop <= MirOp.Shuffle as i64 do has_barrier = 1 end
                                if bop == MirOp.Intrinsic do
                                    let bs2 = mir_instr_src2(bins)
                                    if mir_opnd_type(bs2) == MirOperandType.Imm do
                                        let bkind = mir_opnd_imm_val(bs2)
                                        if bkind == MIR_MEM_MARK or bkind == MIR_MEM_RESET or bkind == MIR_MEM_PROMOTE or bkind == MIR_MEM_DROP or bkind == MIR_INTR_THROW or bkind == MIR_INTR_REVERT do
                                            has_barrier = 1
                                        eif bkind == MIR_INTR_INDEX_STORE do
                                            store_count = store_count + 1
                                            st_pos = bi
                                        end
                                    end
                                end
                                if bop == MirOp.Add do
                                    let as1 = mir_trace_source_opnd(body_instrs, bi, mir_instr_src1(bins))
                                    let as2 = mir_trace_source_opnd(body_instrs, bi, mir_instr_src2(bins))
                                    if mir_opnd_type(as1) == MirOperandType.VReg and mir_opnd_vreg_id(as1) == iv_vreg and mir_opnd_type(as2) == MirOperandType.Imm and mir_opnd_imm_val(as2) == 1 do
                                        iv_add_pos = bi
                                    end
                                end
                                bi = bi + 1
                            end
                            if has_barrier == 0 and store_count == 1 and st_pos >= 2 and iv_add_pos >= 0 do
                                let (ok_st, dst_raw, st_idx_op, st_val_op) = mir_slp_is_index_store_at(body_instrs, st_pos)
                                if ok_st == 1 and mir_opnd_type(st_idx_op) == MirOperandType.VReg and mir_opnd_vreg_id(st_idx_op) == iv_vreg and mir_opnd_type(st_val_op) == MirOperandType.VReg do
                                    let bin_pos = mir_slp_find_def_before(body_instrs, st_pos - 2, mir_opnd_vreg_id(st_val_op))
                                    if bin_pos >= 0 and bin_pos != iv_add_pos do
                                        let bin_ins = vec_get_rt(body_instrs, bin_pos)
                                        let v_op = mir_slp_vector_op_for(mir_instr_op(bin_ins))
                                        if v_op >= 0 and mir_opnd_type(mir_instr_src1(bin_ins)) == MirOperandType.VReg and mir_opnd_type(mir_instr_src2(bin_ins)) == MirOperandType.VReg do
                                            let ld_a = mir_slp_find_def_before(body_instrs, bin_pos, mir_opnd_vreg_id(mir_instr_src1(bin_ins)))
                                            let ld_b = mir_slp_find_def_before(body_instrs, bin_pos, mir_opnd_vreg_id(mir_instr_src2(bin_ins)))
                                            let (oka, src1_raw, idx_a) = mir_slp_is_index_load_at(body_instrs, ld_a)
                                            let (okb, src2_raw, idx_b) = mir_slp_is_index_load_at(body_instrs, ld_b)
                                            if oka == 1 and okb == 1 and mir_opnd_type(idx_a) == MirOperandType.VReg and mir_opnd_vreg_id(idx_a) == iv_vreg and mir_opnd_type(idx_b) == MirOperandType.VReg and mir_opnd_vreg_id(idx_b) == iv_vreg do
                                                var dst_base = dst_raw
                                                var src1_base = src1_raw
                                                var src2_base = src2_raw
                                                if i > 0 do
                                                    let pre_instrs = mir_block_head(vec_get_rt(blocks, i - 1))
                                                    if pre_instrs >= 0 do
                                                        dst_base = mir_trace_source_opnd(pre_instrs, vec_len_rt(pre_instrs), dst_raw)
                                                        src1_base = mir_trace_source_opnd(pre_instrs, vec_len_rt(pre_instrs), src1_raw)
                                                        src2_base = mir_trace_source_opnd(pre_instrs, vec_len_rt(pre_instrs), src2_raw)
                                                    end
                                                end
                                                var alias_ok = 0
                                                if g_mir_mutate_mode == 4 do
                                                    alias_ok = 1
                                                else
                                                    if not mir_opnd_is_same(dst_base, src1_base) and not mir_opnd_is_same(dst_base, src2_base) do
                                                        alias_ok = 1
                                                    end
                                                end
                                                if alias_ok == 1 do
                                                    let vec_limit = (trip_n / 2) * 2
                                                    vec_set_rt(cond_instrs, n_cond - 3, mir_instr_new(MirOp.CmpLt, mir_instr_dst(ins_cmp), iv_op, mir_opnd_imm(vec_limit)))
                                                    let nop_ins = mir_instr_new(MirOp.Nop, mir_opnd_none(), mir_opnd_none(), mir_opnd_none())
                                                    vec_set_rt(body_instrs, st_pos - 2, mir_instr_new(MirOp.SetArg, mir_opnd_none(), mir_opnd_imm(0), mir_opnd_vreg(iv_vreg)))
                                                    vec_set_rt(body_instrs, st_pos - 1, nop_ins)
                                                    let v_ins = mir_instr_new(v_op, dst_raw, src1_raw, src2_raw)
                                                    mir_instr_set_aux(v_ins, (1 shl 26) or (2 shl 8) or 1)
                                                    vec_set_rt(body_instrs, st_pos, v_ins)
                                                    let old_add = vec_get_rt(body_instrs, iv_add_pos)
                                                    vec_set_rt(body_instrs, iv_add_pos, mir_instr_new(MirOp.Add, mir_instr_dst(old_add), mir_opnd_vreg(iv_vreg), mir_opnd_imm(2)))
                                                    if trip_n > vec_limit and g_mir_mutate_mode != 5 do
                                                        let tail_idx = vec_limit
                                                        let ld_a_ins = vec_get_rt(body_instrs, ld_a)
                                                        let ld_b_ins = vec_get_rt(body_instrs, ld_b)
                                                        var new_end = vec_new_rt()
                                                        new_end = vec_push_rt(new_end, mir_instr_new(MirOp.SetArg, mir_opnd_none(), mir_opnd_imm(0), mir_opnd_imm(tail_idx)))
                                                        new_end = vec_push_rt(new_end, mir_instr_new(MirOp.Intrinsic, mir_instr_dst(ld_a_ins), src1_raw, mir_opnd_imm(MIR_INTR_INDEX)))
                                                        new_end = vec_push_rt(new_end, mir_instr_new(MirOp.SetArg, mir_opnd_none(), mir_opnd_imm(0), mir_opnd_imm(tail_idx)))
                                                        new_end = vec_push_rt(new_end, mir_instr_new(MirOp.Intrinsic, mir_instr_dst(ld_b_ins), src2_raw, mir_opnd_imm(MIR_INTR_INDEX)))
                                                        new_end = vec_push_rt(new_end, mir_instr_new(mir_instr_op(bin_ins), mir_instr_dst(bin_ins), mir_instr_dst(ld_a_ins), mir_instr_dst(ld_b_ins)))
                                                        new_end = vec_push_rt(new_end, mir_instr_new(MirOp.SetArg, mir_opnd_none(), mir_opnd_imm(0), mir_opnd_imm(tail_idx)))
                                                        new_end = vec_push_rt(new_end, mir_instr_new(MirOp.SetArg, mir_opnd_none(), mir_opnd_imm(1), mir_instr_dst(bin_ins)))
                                                        new_end = vec_push_rt(new_end, mir_instr_new(MirOp.Intrinsic, mir_opnd_none(), dst_raw, mir_opnd_imm(MIR_INTR_INDEX_STORE)))
                                                        var ei = 0
                                                        when ei < vec_len_rt(end_instrs) loop
                                                            new_end = vec_push_rt(new_end, vec_get_rt(end_instrs, ei))
                                                            ei = ei + 1
                                                        end
                                                        vec_set_rt(blocks, i + 2, mir_block_replace_head(end_b, new_end))
                                                    end
                                                    mir_opt_note_change()
                                                end
                                            end
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
        i = i + 1
    end
    out blocks
end.

##
 * SLP — Superword-Level Parallelism & 1D Loop Auto-Vectorization (Phase 5).
 ##
func mir_opt_slp(blocks: i64):
    if target_simd_width_bytes() < 16 do
        out blocks
    end
    let n_blocks = vec_len_rt(blocks)
    var b_idx = 0
    when b_idx < n_blocks loop
        let blk = vec_get_rt(blocks, b_idx)
        let instrs = mir_block_head(blk)
        if instrs >= 0 do
            mir_opt_slp_block(instrs)
        end
        b_idx = b_idx + 1
    end
    blocks = mir_opt_loop_vectorize(blocks)
    out blocks
end.

##
 * Hash a fat string using FNV-1a over its data bytes (up to 64 bytes).
 * Used by the inline visit table to detect repeated inlining of the same callee.
 ##
func mir_inline_name_hash(name: string):
    var name_ptr = name as i64
    if name_ptr == 0 do out 0 end
    var data_ptr = native_read_i64(name_ptr, 0)
    var len = native_read_i64(name_ptr, 8)
    if data_ptr == 0 or len <= 0 do out 0 end
    var h = 2166136261
    var limit = len
    if limit > 64 do limit = 64 end
    var i = 0
    when i < limit loop
        var b = native_read_u8(data_ptr, i)
        h = (h ^ b) * 16777619
        i = i + 1
    end
    out (h & MIR_INLINE_VISIT_MASK)
end.


##
 * Initialize the inline visit table for a new pass epoch.
 * Call once at the start of each mir_opt_inlining invocation.
 ##
func mir_inline_visit_begin():
    g_inline_pass_epoch = g_inline_pass_epoch + 1
    if g_inline_visit == 0 do
        g_inline_visit = vec_new_rt()
        var s = 0
        when s < MIR_INLINE_VISIT_SLOTS loop
            g_inline_visit = vec_push_rt(g_inline_visit, 0)
            s = s + 1
        end
    end
end.

##
 * Mark callee name as visited in this pass epoch.
 * Returns 1 if callee was already visited (skip), 0 if newly seen (proceed).
 ##
func mir_inline_visit_check_mark(callee_name: string):
    slot = mir_inline_name_hash(callee_name)
    stored = vec_get_rt(g_inline_visit, slot)
    # Encode epoch in high 32 bits and hash in low 32 bits.
    # Collision between two different names in the same slot is treated as visited
    # (conservative) — correct but may skip one inline opportunity per pass.
    key = (g_inline_pass_epoch * 4294967296) + slot
    if stored == key do
        out 1
    end
    vec_set_rt(g_inline_visit, slot, key)
    out 0
end.

func mir_opt_try_inline_at(blocks: i64, b_idx: i64, call_idx: i64):
    if g_mir_opt_program < 0 or g_mir_opt_current_func == 0 do out blocks end
    caller = g_mir_opt_current_func
    b = vec_get_rt(blocks, b_idx)
    instrs = mir_block_head(b)
    if instrs < 0 do out blocks end
    call_ins = vec_get_rt(instrs, call_idx)
    if mir_instr_op(call_ins) != MirOp.Call do out blocks end
    if mir_opnd_type(mir_instr_src2(call_ins)) != MirOperandType.Imm do out blocks end
    pool_id = mir_opnd_imm_val(mir_instr_src2(call_ins))
    callee_name = mir_strings_get(mir_func_strings(caller), pool_id)
    # Epoch check FIRST — O(1). For repeated call sites to the same callee in one
    # pass (common in adversarial inputs), this skips all expensive lookups below.
    if mir_inline_visit_check_mark(callee_name) != 0 do out blocks end
    callee = mir_program_find_func(g_mir_opt_program, callee_name)
    if callee == 0 do out blocks end
    callee_blocks = mir_func_blocks(callee)
    if vec_len_rt(callee_blocks) != 1 do out blocks end
    if mir_count_all_instrs(callee_blocks) > MIR_INLINE_MAX_INSTRS do out blocks end
    if mir_blocks_contain_call(callee_blocks) do out blocks end
    # IR-size budget — stop inlining into this function if the caller body is
    # already large. Guards against exponential blowup at O2/O3 on rt.alloc-heavy code.
    if mir_count_all_instrs(blocks) > MIR_INLINE_CALLER_BUDGET do out blocks end

    nargs = mir_opnd_imm_val(mir_instr_src1(call_ins))
    arg_vals = mir_opt_collect_call_args(instrs, call_idx, nargs)
    param_vregs = mir_callee_param_vregs(callee_blocks)
    vreg_base = mir_func_next_vreg(caller)
    new_instrs = vec_new_rt()
    var ii = 0
    when ii < call_idx loop
        ins = vec_get_rt(instrs, ii)
        if ii < (call_idx - nargs) or mir_instr_op(ins) != MirOp.SetArg do
            new_instrs = vec_push_rt(new_instrs, ins)
        end
        ii = ii + 1
    end
    ret_val = mir_opnd_none()
    var cbi = 0
    when cbi < vec_len_rt(callee_blocks) loop
        c_instrs = mir_block_head(vec_get_rt(callee_blocks, cbi))
        if c_instrs >= 0 do
            var ci = 0
            when ci < vec_len_rt(c_instrs) loop
                raw = vec_get_rt(c_instrs, ci)
                if mir_instr_op(raw) == MirOp.Return do
                    ret_val = mir_inline_remap_opnd(mir_instr_src1(raw), param_vregs, arg_vals, vreg_base)
                else
                    cloned = mir_inline_clone_instr(raw, param_vregs, arg_vals, vreg_base)
                    if mir_instr_op(cloned) != MirOp.Nop do
                        new_instrs = vec_push_rt(new_instrs, cloned)
                    end
                end
                ci = ci + 1
            end
        end
        cbi = cbi + 1
    end
    call_dst = mir_instr_dst(call_ins)
    if mir_opnd_type(call_dst) == MirOperandType.VReg do
        if mir_opnd_type(ret_val) != MirOperandType.None do
            new_instrs = vec_push_rt(new_instrs, mir_instr_new(MirOp.Move, call_dst, ret_val, mir_opnd_none()))
        else
            new_instrs = vec_push_rt(new_instrs, mir_instr_new(MirOp.Move, call_dst, mir_opnd_vreg(vreg_base), mir_opnd_none()))
        end
    end
    ii = call_idx + 1
    when ii < vec_len_rt(instrs) loop
        new_instrs = vec_push_rt(new_instrs, vec_get_rt(instrs, ii))
        ii = ii + 1
    end
    vec_set_rt(blocks, b_idx, mir_block_replace_head(b, new_instrs))
    mir_opt_note_change()
    out blocks
end.

##
 * Inlining — leaf direct calls when program context is set.
 * Each call to mir_opt_inlining gets a fresh epoch so the visit table is reset,
 * preventing cross-pass state leaking into a new round.
 ##
func mir_opt_inlining(blocks: i64):
    # Fix 2: begin a new epoch — clears visit table for this pass.
    mir_inline_visit_begin()
    n_blocks = vec_len_rt(blocks)
    var b_idx = 0
    when b_idx < n_blocks loop
        instrs = mir_block_head(vec_get_rt(blocks, b_idx))
        if instrs >= 0 do
            var i = 0
            when i < vec_len_rt(instrs) loop
                if mir_instr_op(vec_get_rt(instrs, i)) == MirOp.Call do
                    blocks = mir_opt_try_inline_at(blocks, b_idx, i)
                    instrs = mir_block_head(vec_get_rt(blocks, b_idx))
                end
                i = i + 1
            end
        end
        b_idx = b_idx + 1
    end
    out blocks
end.

##
 * Shrink-wrap — annotate call-free blocks for minimal prologue/epilogue.
 ##
func mir_opt_shrink_wrapping(blocks: i64):
    n_blocks = vec_len_rt(blocks)
    var b_idx = 0
    when b_idx < n_blocks loop
        b = vec_get_rt(blocks, b_idx)
        instrs = mir_block_head(b)
        if instrs >= 0 do
            var has_call = 0
            var i = 0
            when i < vec_len_rt(instrs) loop
                op = mir_instr_op(vec_get_rt(instrs, i))
                if op == MirOp.Call or op == MirOp.Intrinsic do has_call = 1 end
                i = i + 1
            end
            if has_call == 0 do
                marker = mir_instr_new(MirOp.Intrinsic, mir_opnd_none(), mir_opnd_imm(MIR_SHRINK_WRAP_MARKER), mir_opnd_imm(MIR_INTR_PATCH_POINT))
                instrs = mir_block_insert_before_terminator(instrs, marker)
                vec_set_rt(blocks, b_idx, mir_block_replace_head(b, instrs))
                mir_opt_note_change()
            end
        end
        b_idx = b_idx + 1
    end
    out blocks
end.

##
 * SROA — promote small aggregate field accesses to scalar SSA values.
 ##
func mir_opt_sroa(blocks: i64):
    n_blocks = vec_len_rt(blocks)
    var b_idx = 0
    when b_idx < n_blocks loop
        instrs = mir_block_head(vec_get_rt(blocks, b_idx))
        if instrs >= 0 do
            var i = 0
            when i < vec_len_rt(instrs) loop
                ins = vec_get_rt(instrs, i)
                if mir_instr_op(ins) == MirOp.Intrinsic do
                    s2k = mir_instr_src2(ins)
                    if mir_opnd_type(s2k) == MirOperandType.Imm do
                        kind = mir_opnd_imm_val(s2k)
                        if kind == MIR_INTR_FIELD do
                            agg = mir_instr_src1(ins)
                            if i >= 1 do
                                prev = vec_get_rt(instrs, i - 1)
                                if mir_instr_op(prev) == MirOp.SetArg do
                                    field_val = mir_instr_src2(prev)
                                    vec_set_rt(instrs, i, mir_instr_new(MirOp.Move, mir_instr_dst(ins), field_val, mir_opnd_none()))
                                    mir_opt_note_change()
                                end
                            end
                        end
                        if kind == MIR_INTR_ENTITY or kind == MIR_INTR_TUPLE do
                            if i >= MIR_SROA_MAX_FIELDS do
                                # keep aggregate when too many fields
                            end
                        end
                    end
                end
                i = i + 1
            end
        end
        b_idx = b_idx + 1
    end
    out blocks
end.

##
 * DAE — drop duplicate / unused SetArg slots before Call.
 ##
func mir_opt_dae(blocks: i64):
    n_blocks = vec_len_rt(blocks)
    last_slot = vec_new_rt()
    var b_idx = 0
    when b_idx < n_blocks loop
        instrs = mir_block_head(vec_get_rt(blocks, b_idx))
        if instrs >= 0 do
            var i = 0
            when i < vec_len_rt(instrs) loop
                if mir_instr_op(vec_get_rt(instrs, i)) == MirOp.Call do
                    nargs = mir_opnd_imm_val(mir_instr_src1(vec_get_rt(instrs, i)))
                    vec_clear_rt(last_slot)
                    var ci = i - 1
                    when ci >= 0 loop
                        ins = vec_get_rt(instrs, ci)
                        if mir_instr_op(ins) != MirOp.SetArg do
                            ci = 0 - 1
                        else
                            slot = mir_opnd_imm_val(mir_instr_src1(ins))
                            if slot >= nargs do
                                native_write_i64(ins as i64, 0, MirOp.Nop as i64)
                                mir_opt_note_change()
                            else
                                if slot < vec_len_rt(last_slot) do
                                    if vec_get_rt(last_slot, slot) == 1 do
                                        native_write_i64(ins as i64, 0, MirOp.Nop as i64)
                                        mir_opt_note_change()
                                    end
                                end
                                var grow2 = vec_len_rt(last_slot)
                                when grow2 <= slot loop
                                    last_slot = vec_push_rt(last_slot, 0)
                                    grow2 = grow2 + 1
                                end
                                vec_set_rt(last_slot, slot, 1)
                            end
                            ci = ci - 1
                        end
                    end
                end
                i = i + 1
            end
        end
        b_idx = b_idx + 1
    end
    vec_free_rt(last_slot)
    out blocks
end.

##
 * Devirtualization — monomorphic indirect call → direct pool call.
 ##
func mir_opt_devirtualization(blocks: i64):
    n_blocks = vec_len_rt(blocks)
    var b_idx = 0
    when b_idx < n_blocks loop
        instrs = mir_block_head(vec_get_rt(blocks, b_idx))
        if instrs >= 0 do
            var i = 0
            when i < vec_len_rt(instrs) loop
                ins = vec_get_rt(instrs, i)
                if mir_instr_op(ins) == MirOp.Call do
                    callee = mir_instr_src2(ins)
                    if mir_opnd_type(callee) == MirOperandType.VReg do
                        traced = mir_trace_source_opnd(instrs, i, callee)
                        if mir_opnd_type(traced) == MirOperandType.Imm do
                            vec_set_rt(instrs, i, mir_instr_new(MirOp.Call, mir_instr_dst(ins), mir_instr_src1(ins), traced))
                            mir_opt_note_change()
                        end
                    end
                end
                i = i + 1
            end
        end
        b_idx = b_idx + 1
    end
    out blocks
end.

func mir_block_dominates(blocks: i64, n_blocks: int, dom_b: int, target_b: int) -> bool:
    if dom_b == target_b do out true end
    if dom_b == 0 do out true end
    if target_b == 0 do out false end

    var visited = vec_new_rt()
    var vi = 0
    when vi < n_blocks loop
        visited = vec_push_rt(visited, 0 as i64)
        vi = vi + 1
    end
    var q = vec_new_rt()
    q = vec_push_rt(q, 0 as i64)
    vec_set_rt(visited, 0, 1 as i64)
    var q_head = 0
    when q_head < vec_len_rt(q) loop
        let u = vec_get_rt(q, q_head) as int
        q_head = q_head + 1
        if u != dom_b do
            let blk = vec_get_rt(blocks, u)
            let succs = mir_block_successors(blk)
            if succs >= 0 do
                let ns = vec_len_rt(succs)
                var si = 0
                when si < ns loop
                    let v = vec_get_rt(succs, si) as int
                    if v >= 0 and v < n_blocks do
                        if v == target_b do out false end
                        if vec_get_rt(visited, v) == 0 and v != dom_b do
                            vec_set_rt(visited, v, 1 as i64)
                            q = vec_push_rt(q, v as i64)
                        end
                    end
                    si = si + 1
                end
            end
        end
    end
    out true
end.

# Stable detail for the most recent verifier failure. The pipeline prints this
# before aborting, so malformed MIR reports the violated invariant and origin
# instead of collapsing every failure into a bare E6001.
var g_mir_verify_reason: string = ""
var g_mir_verify_block: int = -1
var g_mir_verify_instr: int = -1
var g_mir_verify_origin: i64 = -1

func mir_verify_fail(reason: string, block_idx: int, instr_idx: int, origin: i64) -> bool:
    g_mir_verify_reason = reason
    g_mir_verify_block = block_idx
    g_mir_verify_instr = instr_idx
    g_mir_verify_origin = origin
    out false
end.

func mir_verify_error_reason() -> string: out g_mir_verify_reason end.
func mir_verify_error_block() -> int: out g_mir_verify_block end.
func mir_verify_error_instr() -> int: out g_mir_verify_instr end.
func mir_verify_error_origin() -> i64: out g_mir_verify_origin end.

# Mandatory ownership metadata verifier. Run before and after the optimizer so
# an allocation cannot silently lose its stable identity while being cloned or
# rewritten across CFG/SSA transformations.
func mir_verify_memory_contract(blocks: i64) -> bool:
    g_mir_verify_reason = ""
    g_mir_verify_block = -1
    g_mir_verify_instr = -1
    g_mir_verify_origin = -1
    let n_blocks = vec_len_rt(blocks)
    if n_blocks == 0 do out true end

    # 1. Compute reachable blocks from block 0 via successors
    var reachable = vec_new_rt()
    var ri = 0
    when ri < n_blocks loop
        reachable = vec_push_rt(reachable, 0 as i64)
        ri = ri + 1
    end
    var worklist = vec_new_rt()
    worklist = vec_push_rt(worklist, 0 as i64)
    vec_set_rt(reachable, 0, 1 as i64)
    var wl_idx = 0
    when wl_idx < vec_len_rt(worklist) loop
        let curr = vec_get_rt(worklist, wl_idx)
        wl_idx = wl_idx + 1
        if curr >= 0 and curr < n_blocks do
            let blk = vec_get_rt(blocks, curr)
            let succs = mir_block_successors(blk)
            if succs >= 0 do
                var si = 0
                let n_succs = vec_len_rt(succs)
                when si < n_succs loop
                    let s = vec_get_rt(succs, si)
                    if s >= 0 and s < n_blocks do
                        if vec_get_rt(reachable, s) == 0 do
                            vec_set_rt(reachable, s, 1 as i64)
                            worklist = vec_push_rt(worklist, s as i64)
                        end
                    end
                    si = si + 1
                end
            end
        end
    end

    # 2. Verify instructions in reachable blocks
    var b_idx = 0
    var mark_count = 0
    var reset_count = 0
    var mark_vregs = vec_new_rt()
    var mark_regions = vec_new_rt()
    var mark_resets = vec_new_rt()
    var mark_b_indices = vec_new_rt()
    var mark_ins_indices = vec_new_rt()
    var arena_epochs = vec_new_rt()
    var alloc_epochs = vec_new_rt()
    var alloc_b_indices = vec_new_rt()
    var alloc_ins_indices = vec_new_rt()
    var reset_vregs = vec_new_rt()
    var reset_b_indices = vec_new_rt()
    var reset_ins_indices = vec_new_rt()

    when b_idx < n_blocks loop
        if vec_get_rt(reachable, b_idx) == 0 do
            b_idx = b_idx + 1
        else
            let instrs = mir_block_head(vec_get_rt(blocks, b_idx))
            if instrs >= 0 do
                var i = 0
                when i < vec_len_rt(instrs) loop
                    let ins = vec_get_rt(instrs, i)
                    if mir_instr_op(ins) == MirOp.Intrinsic do
                        let kind = mir_instr_src2(ins)
                        let detail = mir_instr_src1(ins)
                        if mir_opnd_type(kind) == MirOperandType.Imm do
                            let ik = mir_opnd_imm_val(kind)
                            if ik == MIR_INTR_BUILTIN and mir_opnd_type(detail) == MirOperandType.Imm and mir_opnd_imm_val(detail) == 3 do
                                let dst = mir_instr_dst(ins)
                                if mir_opnd_type(dst) != MirOperandType.VReg do out mir_verify_fail("allocation destination is not a vreg", b_idx, i, mir_instr_src_origin(ins)) end
                                let alloc_vreg = mir_opnd_vreg_id(dst)
                                let align = mir_instr_align(ins)
                                let region = mir_instr_region(ins)
                                if mir_instr_provenance(ins) != 1 do out mir_verify_fail("allocation provenance is invalid", b_idx, i, mir_instr_src_origin(ins)) end
                                if mir_instr_owner_id(ins) != alloc_vreg or mir_instr_alloc_id(ins) != alloc_vreg do out mir_verify_fail("allocation owner identity is inconsistent", b_idx, i, mir_instr_src_origin(ins)) end
                                if mir_instr_parent_rel(ins) != 0 do out mir_verify_fail("allocation parent relation is invalid", b_idx, i, mir_instr_src_origin(ins)) end
                                if mir_instr_size(ins) < 0 or align < 8 or (align bit_and (align - 1)) != 0 do out mir_verify_fail("allocation size or alignment is invalid", b_idx, i, mir_instr_src_origin(ins)) end
                                if region < 0 do out mir_verify_fail("allocation region is negative", b_idx, i, mir_instr_src_origin(ins)) end
                                if region == 0 and mir_instr_epoch(ins) != 0 do out mir_verify_fail("root allocation has a nonzero arena epoch", b_idx, i, mir_instr_src_origin(ins)) end
                                if region > 0 do
                                    let ep = mir_instr_epoch(ins)
                                    if ep > 0 do
                                        arena_epochs = vec_push_rt(arena_epochs, ep as i64)
                                        alloc_epochs = vec_push_rt(alloc_epochs, ep as i64)
                                        alloc_b_indices = vec_push_rt(alloc_b_indices, b_idx as i64)
                                        alloc_ins_indices = vec_push_rt(alloc_ins_indices, i as i64)
                                    end
                                end
                                if mir_instr_src_origin(ins) < 0 do out mir_verify_fail("allocation is missing source origin", b_idx, i, mir_instr_src_origin(ins)) end
                            end
                            if ik == MIR_MEM_MARK do
                                let dst = mir_instr_dst(ins)
                                if mir_opnd_type(dst) != MirOperandType.VReg do out mir_verify_fail("arena mark destination is not a vreg", b_idx, i, mir_instr_src_origin(ins)) end
                                let m_reg = mir_instr_region(ins)
                                if m_reg < 0 do out mir_verify_fail("arena mark region is negative", b_idx, i, mir_instr_src_origin(ins)) end
                                let m_vr = mir_opnd_vreg_id(dst)
                                mark_vregs = vec_push_rt(mark_vregs, m_vr as i64)
                                mark_regions = vec_push_rt(mark_regions, m_reg as i64)
                                mark_resets = vec_push_rt(mark_resets, 0 as i64)
                                mark_b_indices = vec_push_rt(mark_b_indices, b_idx as i64)
                                mark_ins_indices = vec_push_rt(mark_ins_indices, i as i64)
                                mark_count = mark_count + 1
                            end
                            if ik == MIR_MEM_RESET do
                                if mir_opnd_type(detail) != MirOperandType.VReg do out mir_verify_fail("arena reset mark is not a vreg", b_idx, i, mir_instr_src_origin(ins)) end
                                let r_reg = mir_instr_region(ins)
                                if r_reg < 0 do out mir_verify_fail("arena reset region is negative", b_idx, i, mir_instr_src_origin(ins)) end
                                let r_vr = mir_opnd_vreg_id(detail)
                                var matched_idx = -1
                                var mi = 0
                                let n_marks = vec_len_rt(mark_vregs)
                                when mi < n_marks loop
                                    if vec_get_rt(mark_vregs, mi) == (r_vr as i64) do
                                        matched_idx = mi
                                    end
                                    mi = mi + 1
                                end
                                if matched_idx < 0 do out mir_verify_fail("arena reset has no matching mark", b_idx, i, mir_instr_src_origin(ins)) end
                                let exp_reg = vec_get_rt(mark_regions, matched_idx)
                                if exp_reg > 0 and r_reg > 0 and exp_reg != (r_reg as i64) do out mir_verify_fail("arena reset region does not match its mark", b_idx, i, mir_instr_src_origin(ins)) end
                                let old_rc = vec_get_rt(mark_resets, matched_idx)
                                vec_set_rt(mark_resets, matched_idx, (old_rc + 1) as i64)
                                reset_count = reset_count + 1
                                reset_vregs = vec_push_rt(reset_vregs, r_vr as i64)
                                reset_b_indices = vec_push_rt(reset_b_indices, b_idx as i64)
                                reset_ins_indices = vec_push_rt(reset_ins_indices, i as i64)
                            end
                            if ik == MIR_MEM_DROP do
                                if mir_opnd_type(detail) != MirOperandType.VReg do out mir_verify_fail("memory drop owner is not a vreg", b_idx, i, mir_instr_src_origin(ins)) end
                                if mir_instr_region(ins) < 0 do out mir_verify_fail("memory drop region is negative", b_idx, i, mir_instr_src_origin(ins)) end
                            end
                            if ik == MIR_MEM_PROMOTE do
                                let dst = mir_instr_dst(ins)
                                if mir_opnd_type(dst) != MirOperandType.VReg and mir_opnd_type(dst) != MirOperandType.None do out mir_verify_fail("promotion destination is malformed", b_idx, i, mir_instr_src_origin(ins)) end
                                if mir_opnd_type(detail) != MirOperandType.VReg and mir_opnd_type(detail) != MirOperandType.Imm do out mir_verify_fail("promotion source is malformed", b_idx, i, mir_instr_src_origin(ins)) end
                                if mir_instr_region(ins) < 0 do out mir_verify_fail("promotion region is negative", b_idx, i, mir_instr_src_origin(ins)) end
                            end
                        end
                    end
                    i = i + 1
                end
            end
            b_idx = b_idx + 1
        end
    end

    if mark_count > 0 and reset_count == 0 do
        if vec_len_rt(arena_epochs) > 0 do out mir_verify_fail("arena allocation is missing reset", -1, -1, -1) end
    end
    if reset_count > 0 and mark_count == 0 do out mir_verify_fail("arena reset exists without any mark", -1, -1, -1) end

    # 3. Dominance and Exactly-Once verification for every mark
    var m = 0
    let total_marks = vec_len_rt(mark_vregs)
    when m < total_marks loop
        let V_m = vec_get_rt(mark_vregs, m)
        let B_m = vec_get_rt(mark_b_indices, m) as int
        let I_m = vec_get_rt(mark_ins_indices, m) as int
        let R_m = vec_get_rt(mark_resets, m) as int

        var is_arena_mark = false
        if R_m > 0 do
            is_arena_mark = true
        else
            var ea = 0
            let n_ae = vec_len_rt(alloc_epochs)
            when ea < n_ae loop
                if vec_get_rt(alloc_epochs, ea) == V_m do
                    is_arena_mark = true
                    ea = n_ae
                else
                    ea = ea + 1
                end
            end
        end

        if is_arena_mark do
            # (A) Check dominance and intra-block order for allocations
            var a = 0
            let n_allocs = vec_len_rt(alloc_epochs)
            when a < n_allocs loop
                if vec_get_rt(alloc_epochs, a) == V_m do
                    let B_a = vec_get_rt(alloc_b_indices, a) as int
                    let I_a = vec_get_rt(alloc_ins_indices, a) as int
                    if B_a != B_m do
                        if mir_block_dominates(blocks, n_blocks, B_m, B_a) == false do out mir_verify_fail("arena mark does not dominate allocation", B_a, I_a, -1) end
                    else
                        if I_m >= I_a do out mir_verify_fail("arena allocation precedes its mark", B_a, I_a, -1) end
                    end
                end
                a = a + 1
            end

            # (B) Check dominance and intra-block order for resets
            var r = 0
            let n_rsts = vec_len_rt(reset_vregs)
            when r < n_rsts loop
                if vec_get_rt(reset_vregs, r) == V_m do
                    let B_r = vec_get_rt(reset_b_indices, r) as int
                    let I_r = vec_get_rt(reset_ins_indices, r) as int
                    if B_r != B_m do
                        if mir_block_dominates(blocks, n_blocks, B_m, B_r) == false do out mir_verify_fail("arena mark does not dominate reset", B_r, I_r, -1) end
                    else
                        if I_m >= I_r do out mir_verify_fail("arena reset precedes its mark", B_r, I_r, -1) end
                    end
                end
                r = r + 1
            end

            # (C) CFG Exactly-Once Active-State Dataflow Check
            var in_state = vec_new_rt()
            var bi = 0
            when bi < n_blocks loop
                in_state = vec_push_rt(in_state, 0 - 1)
                bi = bi + 1
            end

            vec_set_rt(in_state, B_m, 0 as i64)
            var df_worklist = vec_new_rt()
            df_worklist = vec_push_rt(df_worklist, B_m as i64)
            var df_head = 0

            when df_head < vec_len_rt(df_worklist) loop
                let b = vec_get_rt(df_worklist, df_head) as int
                df_head = df_head + 1
                var curr_st = vec_get_rt(in_state, b) as int

                let instrs = mir_block_head(vec_get_rt(blocks, b))
                var has_ret = false
                if instrs >= 0 do
                    let ni = vec_len_rt(instrs)
                    var ii = 0
                    when ii < ni loop
                        let ins = vec_get_rt(instrs, ii)
                        if mir_instr_op(ins) == MirOp.Return do
                            has_ret = true
                            if curr_st != 0 do out mir_verify_fail("function exits with an active arena mark", b, ii, mir_instr_src_origin(ins)) end
                        end
                        if mir_instr_op(ins) == MirOp.Intrinsic do
                            let kind = mir_instr_src2(ins)
                            let detail = mir_instr_src1(ins)
                            if mir_opnd_type(kind) == MirOperandType.Imm do
                                let ik = mir_opnd_imm_val(kind)
                                if ik == MIR_MEM_MARK and mir_opnd_type(mir_instr_dst(ins)) == MirOperandType.VReg and mir_opnd_vreg_id(mir_instr_dst(ins)) == V_m do
                                    if curr_st != 0 do out mir_verify_fail("arena mark is activated twice", b, ii, mir_instr_src_origin(ins)) end
                                    curr_st = 1
                                end
                                if ik == MIR_INTR_BUILTIN and mir_opnd_type(detail) == MirOperandType.Imm and mir_opnd_imm_val(detail) == 3 do
                                    if mir_instr_epoch(ins) == V_m do
                                        if curr_st != 1 do out mir_verify_fail("arena allocation occurs outside its active mark", b, ii, mir_instr_src_origin(ins)) end
                                    end
                                end
                                if ik == MIR_MEM_RESET and mir_opnd_type(detail) == MirOperandType.VReg and mir_opnd_vreg_id(detail) == V_m do
                                    if curr_st != 1 do out mir_verify_fail("arena reset occurs while mark is inactive", b, ii, mir_instr_src_origin(ins)) end
                                    curr_st = 0
                                end
                            end
                        end
                        ii = ii + 1
                    end
                end

                let succs = mir_block_successors(vec_get_rt(blocks, b))
                var n_succs = 0
                if succs >= 0 do
                    n_succs = vec_len_rt(succs)
                end

                if n_succs == 0 or has_ret == true do
                    if curr_st != 0 do out mir_verify_fail("control-flow exit is missing arena reset", b, -1, -1) end
                end

                if succs >= 0 and has_ret == false do
                    var si = 0
                    when si < n_succs loop
                        let succ_b = vec_get_rt(succs, si) as int
                        if succ_b >= 0 and succ_b < n_blocks and vec_get_rt(reachable, succ_b) == 1 do
                            let prev_st = vec_get_rt(in_state, succ_b) as int
                            if prev_st == -1 do
                                vec_set_rt(in_state, succ_b, curr_st as i64)
                                df_worklist = vec_push_rt(df_worklist, succ_b as i64)
                            else
                                if prev_st != curr_st do
                                    out mir_verify_fail("arena active state disagrees at CFG merge", succ_b, -1, -1)
                                end
                            end
                        end
                        si = si + 1
                    end
                end
            end
        end
        m = m + 1
    end

    # Verify that all arena allocation epochs were matched to a reset mark
    var ei = 0
    let n_epochs = vec_len_rt(arena_epochs)
    when ei < n_epochs loop
        let ep = vec_get_rt(arena_epochs, ei)
        var ep_matched = false
        var k = 0
        when k < total_marks loop
            if vec_get_rt(mark_vregs, k) == ep do
                if vec_get_rt(mark_resets, k) > 0 do
                    ep_matched = true
                end
            end
            k = k + 1
        end
        if ep_matched == false do out mir_verify_fail("allocation epoch has no matching arena mark", -1, -1, -1) end
        ei = ei + 1
    end

    out true
end.

##
 * Escape analysis — non-escaping allocs → arena fastpath marker.
 ##
func mir_opt_escape_analysis_and_arena_promotion(blocks: i64):
    n_blocks = vec_len_rt(blocks)
    escaped = mir_opt_build_escaped_vregs(blocks)
    n_escaped = vec_len_rt(escaped)
    var b_idx = 0
    when b_idx < n_blocks loop
        b = vec_get_rt(blocks, b_idx)
        instrs = mir_block_head(b)
        if instrs >= 0 do
            n_ins = vec_len_rt(instrs)
            var new_instrs = vec_new_rt()
            var promoted = vec_new_rt()
            var active_arena_vregs = vec_new_rt()
            var in_arena = 0
            var i = 0
            when i < n_ins loop
                ins = vec_get_rt(instrs, i)
                op = mir_instr_op(ins)
                if op == MirOp.Intrinsic do
                    s2k = mir_instr_src2(ins)
                    if mir_opnd_type(s2k) == MirOperandType.Imm do
                        ik = mir_opnd_imm_val(s2k)
                        if ik == MIR_MEM_MARK do
                            in_arena = 1
                            active_arena_vregs = vec_new_rt()
                        eif ik == MIR_MEM_PROMOTE do
                            s1 = mir_instr_src1(ins)
                            if mir_opnd_type(s1) == MirOperandType.VReg do
                                pv = mir_opnd_vreg_id(s1)
                                promoted = vec_push_rt(promoted, pv)
                            end
                        eif ik == MIR_MEM_RESET do
                            in_arena = 0
                            let n_act = vec_len_rt(active_arena_vregs)
                            var ai = 0
                            when ai < n_act loop
                                let pi = vec_get_rt(active_arena_vregs, ai)
                                if pi >= 0 and pi < n_escaped and vec_get_rt(escaped, pi) == 1 do
                                    var already = 0
                                    var k = 0
                                    let plen = vec_len_rt(promoted)
                                    when k < plen loop
                                        if vec_get_rt(promoted, k) == pi do
                                            already = 1
                                        end
                                        k = k + 1
                                    end
                                    if already == 0 do
                                        let setarg_ins = mir_instr_new(MirOp.SetArg as i64, mir_opnd_none() as i64, mir_opnd_imm(0) as i64, mir_opnd_vreg(pi) as i64)
                                        new_instrs = vec_push_rt(new_instrs, setarg_ins)
                                        let prom_ins = mir_instr_new(MirOp.Intrinsic as i64, mir_opnd_none() as i64, mir_opnd_vreg(pi) as i64, mir_opnd_imm(MIR_MEM_PROMOTE) as i64)
                                        mir_instr_set_alloc_kind(prom_ins, 1)
                                        new_instrs = vec_push_rt(new_instrs, prom_ins)
                                        promoted = vec_push_rt(promoted, pi)
                                        mir_opt_note_change()
                                    end
                                end
                                ai = ai + 1
                            end
                            active_arena_vregs = vec_new_rt()
                        eif ik == MIR_MEM_ALLOC or ik == MIR_INTR_ARRAY or ik == MIR_INTR_ENTITY or ik == MIR_INTR_TUPLE or ik == 3 do
                            dst = mir_instr_dst(ins)
                            if mir_opnd_type(dst) == MirOperandType.VReg do
                                dv = mir_opnd_vreg_id(dst)
                                if in_arena == 1 and dv >= 0 do
                                    active_arena_vregs = vec_push_rt(active_arena_vregs, dv)
                                end
                                if dv >= 0 and dv < n_escaped do
                                    if vec_get_rt(escaped, dv) == 0 do
                                        mir_instr_set_alloc_kind(ins, 0)
                                    else
                                        mir_instr_set_alloc_kind(ins, 1)
                                    end
                                end
                            end
                        end
                    end
                end
                new_instrs = vec_push_rt(new_instrs, ins)
                i = i + 1
            end
            mir_block_replace_head(b, new_instrs)
        end
        b_idx = b_idx + 1
    end
    out blocks
end.

##
 * #15 ARC trial deletion — Bacon–Rajan refcount pairing (backend / GlobalEscape heap).
 * Inserts retain/release on escaped heap allocs, then deletes redundant pairs locally.
 ##
##
 * Build escaped-vreg set with cross-CFG phi propagation.
 *
 * Pass 1: linear scan — mark vregs that escape via Call/Return/Store/SetArg/AddrOf.
 * Pass 2: union phi destinations with their incoming values, then propagate
 *          escape once per equivalence class.
 ##
func mir_escape_root(parent: i64, vreg: i64):
    var root = vreg
    when vec_get_rt(parent, root) != root loop
        root = vec_get_rt(parent, root)
    end
    var current = vreg
    when vec_get_rt(parent, current) != current loop
        let next = vec_get_rt(parent, current)
        vec_set_rt(parent, current, root)
        current = next
    end
    out root
end.

func mir_escape_union(parent: i64, left: i64, right: i64):
    let left_root = mir_escape_root(parent, left)
    let right_root = mir_escape_root(parent, right)
    if left_root != right_root do
        if left_root < right_root do
            vec_set_rt(parent, right_root, left_root)
        else
            vec_set_rt(parent, left_root, right_root)
        end
    end
end.

func mir_opt_build_escaped_vregs(blocks: i64):
    n_vregs = max_vreg_mir(blocks)
    escaped = vec_new_rt()
    var vi = 0
    when vi < n_vregs loop
        escaped = vec_push_rt(escaped, 0)
        vi = vi + 1
    end
    var b_idx = 0
    when b_idx < vec_len_rt(blocks) loop
        instrs = mir_block_head(vec_get_rt(blocks, b_idx))
        if instrs >= 0 do
            var i = 0
            when i < vec_len_rt(instrs) loop
                ins = vec_get_rt(instrs, i)
                op = mir_instr_op(ins)
                if op == MirOp.Call or op == MirOp.Return or op == MirOp.Store do
                    s1 = mir_instr_src1(ins)
                    s2 = mir_instr_src2(ins)
                    if mir_opnd_type(s1) == MirOperandType.VReg do
                        v = mir_opnd_vreg_id(s1)
                        if v >= 0 and v < n_vregs do vec_set_rt(escaped, v, 1) end
                    end
                    if mir_opnd_type(s2) == MirOperandType.VReg do
                        v2 = mir_opnd_vreg_id(s2)
                        if v2 >= 0 and v2 < n_vregs do vec_set_rt(escaped, v2, 1) end
                    end
                end
                if op == MirOp.Intrinsic do
                    s2k = mir_instr_src2(ins)
                    if mir_opnd_type(s2k) == MirOperandType.Imm and mir_opnd_imm_val(s2k) == MIR_INTR_ADDR_OF do
                        s1k = mir_instr_src1(ins)
                        if mir_opnd_type(s1k) == MirOperandType.VReg do
                            v3 = mir_opnd_vreg_id(s1k)
                            if v3 >= 0 and v3 < n_vregs do vec_set_rt(escaped, v3, 1) end
                        end
                    end
                end
                if op == MirOp.SetArg do
                    sa = mir_instr_src2(ins)
                    if mir_opnd_type(sa) == MirOperandType.VReg do
                        v4 = mir_opnd_vreg_id(sa)
                        if v4 >= 0 and v4 < n_vregs do vec_set_rt(escaped, v4, 1) end
                    end
                end
                i = i + 1
            end
        end
        b_idx = b_idx + 1
    end
    # Pass 2: build phi escape-equivalence classes in near-linear time.
    var parent = vec_new_rt()
    vi = 0
    when vi < n_vregs loop
        parent = vec_push_rt(parent, vi)
        vi = vi + 1
    end
    var bp_idx = 0
    when bp_idx < vec_len_rt(blocks) loop
        let phis = mir_block_phis(vec_get_rt(blocks, bp_idx))
        if phis >= 0 do
            var pi = 0
            when pi < vec_len_rt(phis) loop
                let phi = vec_get_rt(phis, pi)
                let phi_dst = mir_phi_dst(phi)
                let inc_vals = mir_phi_incoming_values(phi)
                var ii2 = 0
                when ii2 < vec_len_rt(inc_vals) loop
                    let inc_v = vec_get_rt(inc_vals, ii2) as MirOperand
                    if phi_dst >= 0 & phi_dst < n_vregs & mir_opnd_type(inc_v) == MirOperandType.VReg do
                        let src_vr = mir_opnd_vreg_id(inc_v)
                        if src_vr >= 0 and src_vr < n_vregs do
                            mir_escape_union(parent, phi_dst, src_vr)
                        end
                    end
                    ii2 = ii2 + 1
                end
                pi = pi + 1
            end
        end
        bp_idx = bp_idx + 1
    end
    var root_escaped = vec_new_rt()
    vi = 0
    when vi < n_vregs loop
        root_escaped = vec_push_rt(root_escaped, 0)
        vi = vi + 1
    end
    vi = 0
    when vi < n_vregs loop
        if vec_get_rt(escaped, vi) == 1 do
            vec_set_rt(root_escaped, mir_escape_root(parent, vi), 1)
        end
        vi = vi + 1
    end
    vi = 0
    when vi < n_vregs loop
        if vec_get_rt(root_escaped, mir_escape_root(parent, vi)) == 1 do
            vec_set_rt(escaped, vi, 1)
        end
        vi = vi + 1
    end
    out escaped
end.


func mir_is_heap_alloc_builtin(ins: &MirInstr):
    if mir_instr_op(ins) != MirOp.Intrinsic do out false end
    s2 = mir_instr_src2(ins)
    if mir_opnd_type(s2) != MirOperandType.Imm or mir_opnd_imm_val(s2) != MIR_INTR_BUILTIN do out false end
    s1 = mir_instr_src1(ins)
    if mir_opnd_type(s1) != MirOperandType.Imm do out false end
    bid = mir_opnd_imm_val(s1)
    out bid == 3 or bid == 50
end.

func mir_is_arc_patch(ins: &MirInstr, kind: i64):
    if mir_instr_op(ins) != MirOp.Intrinsic do out false end
    s2 = mir_instr_src2(ins)
    if mir_opnd_type(s2) != MirOperandType.Imm or mir_opnd_imm_val(s2) != MIR_INTR_PATCH_POINT do out false end
    s1 = mir_instr_src1(ins)
    if mir_opnd_type(s1) != MirOperandType.Imm do out false end
    out mir_opnd_imm_val(s1) == kind
end.

func mir_arc_marker_vreg(ins: &MirInstr):
    dst = mir_instr_dst(ins)
    if mir_opnd_type(dst) == MirOperandType.VReg do out mir_opnd_vreg_id(dst) end
    s1 = mir_instr_src1(ins)
    if mir_opnd_type(s1) == MirOperandType.VReg do out mir_opnd_vreg_id(s1) end
    out 0 - 1
end.

func mir_opt_arc_insert_retain_release(blocks: i64, escaped: i64):
    n_vregs = vec_len_rt(escaped)
    var b_idx = 0
    when b_idx < vec_len_rt(blocks) loop
        b = vec_get_rt(blocks, b_idx)
        instrs = mir_block_head(b)
        if instrs >= 0 do
            n_ins = vec_len_rt(instrs)
            var needs_insert = 0
            var i = 0
            when i < n_ins loop
                ins = vec_get_rt(instrs, i)
                if mir_instr_op(ins) == MirOp.Return do
                    rv = mir_instr_src1(ins)
                    if mir_opnd_type(rv) == MirOperandType.VReg do
                        dv2 = mir_opnd_vreg_id(rv)
                        if dv2 >= 0 and dv2 < n_vregs and vec_get_rt(escaped, dv2) == 1 do
                            has_release = 0
                            if i > 0 do
                                prev = vec_get_rt(instrs, i - 1)
                                if mir_is_arc_patch(prev, MIR_ARC_RELEASE) and mir_arc_marker_vreg(prev) == dv2 do
                                    has_release = 1
                                end
                            end
                            if has_release == 0 do
                                needs_insert = 1
                            end
                        end
                    end
                eif mir_is_heap_alloc_builtin(ins) do
                    dst = mir_instr_dst(ins)
                    if mir_opnd_type(dst) == MirOperandType.VReg do
                        dv = mir_opnd_vreg_id(dst)
                        if dv >= 0 and dv < n_vregs and vec_get_rt(escaped, dv) == 1 do
                            has_retain = 0
                            if (i + 1) < n_ins do
                                nxt = vec_get_rt(instrs, i + 1)
                                if mir_is_arc_patch(nxt, MIR_ARC_RETAIN) and mir_arc_marker_vreg(nxt) == dv do
                                    has_retain = 1
                                end
                            end
                            if has_retain == 0 do
                                needs_insert = 1
                            end
                        end
                    end
                end
                i = i + 1
            end

            if needs_insert == 1 do
                new_instrs = vec_new_rt()
                i = 0
                when i < n_ins loop
                    ins = vec_get_rt(instrs, i)
                    if mir_instr_op(ins) == MirOp.Return do
                        rv = mir_instr_src1(ins)
                        if mir_opnd_type(rv) == MirOperandType.VReg do
                            dv2 = mir_opnd_vreg_id(rv)
                            if dv2 >= 0 and dv2 < n_vregs and vec_get_rt(escaped, dv2) == 1 do
                                has_release = 0
                                cur_len = vec_len_rt(new_instrs)
                                if cur_len > 0 do
                                    prev = vec_get_rt(new_instrs, cur_len - 1)
                                    if mir_is_arc_patch(prev, MIR_ARC_RELEASE) and mir_arc_marker_vreg(prev) == dv2 do
                                        has_release = 1
                                    end
                                end
                                if has_release == 0 do
                                    rel = mir_instr_new(MirOp.Intrinsic, mir_opnd_vreg(dv2), mir_opnd_imm(MIR_ARC_RELEASE), mir_opnd_imm(MIR_INTR_PATCH_POINT))
                                    new_instrs = vec_push_rt(new_instrs, rel)
                                end
                            end
                        end
                    end

                    new_instrs = vec_push_rt(new_instrs, ins)

                    if mir_is_heap_alloc_builtin(ins) do
                        dst = mir_instr_dst(ins)
                        if mir_opnd_type(dst) == MirOperandType.VReg do
                            dv = mir_opnd_vreg_id(dst)
                            if dv >= 0 and dv < n_vregs and vec_get_rt(escaped, dv) == 1 do
                                has_retain = 0
                                if (i + 1) < n_ins do
                                    nxt = vec_get_rt(instrs, i + 1)
                                    if mir_is_arc_patch(nxt, MIR_ARC_RETAIN) and mir_arc_marker_vreg(nxt) == dv do
                                        has_retain = 1
                                    end
                                end
                                if has_retain == 0 do
                                    retain = mir_instr_new(MirOp.Intrinsic, dst, mir_opnd_imm(MIR_ARC_RETAIN), mir_opnd_imm(MIR_INTR_PATCH_POINT))
                                    trial = mir_instr_new(MirOp.Intrinsic, dst, mir_opnd_imm(MIR_ARC_TRIAL), mir_opnd_imm(MIR_INTR_PATCH_POINT))
                                    new_instrs = vec_push_rt(new_instrs, retain)
                                    new_instrs = vec_push_rt(new_instrs, trial)
                                end
                            end
                        end
                    end

                    i = i + 1
                end
                vec_free_rt(instrs)
                vec_set_rt(blocks, b_idx, mir_block_replace_head(b, new_instrs))
                mir_opt_note_change()
            end
        end
        b_idx = b_idx + 1
    end
    out blocks
end.

func mir_opt_arc_trial_delete_pairs(blocks: i64, escaped: i64):
    n_vregs = vec_len_rt(escaped)
    var b_idx = 0
    when b_idx < vec_len_rt(blocks) loop
        b = vec_get_rt(blocks, b_idx)
        instrs = mir_block_head(b)
        if instrs >= 0 do
            pending_v = 0 - 1
            var i = 0
            when i < vec_len_rt(instrs) loop
                ins = vec_get_rt(instrs, i)
                if mir_is_arc_patch(ins, MIR_ARC_RETAIN) do
                    pending_v = mir_arc_marker_vreg(ins)
                eif mir_is_arc_patch(ins, MIR_ARC_RELEASE) do
                    rv = mir_arc_marker_vreg(ins)
                    if rv == pending_v and pending_v >= 0 do
                        native_write_i64(ins as i64, 0, MirOp.Nop as i64)
                        native_write_i64(ins as i64, 8, mir_opnd_none() as i64)
                        var j = i - 1
                        when j >= 0 loop
                            prev = vec_get_rt(instrs, j)
                            if mir_is_arc_patch(prev, MIR_ARC_RETAIN) and mir_arc_marker_vreg(prev) == rv do
                                native_write_i64(prev as i64, 0, MirOp.Nop as i64)
                                native_write_i64(prev as i64, 8, mir_opnd_none() as i64)
                                j = 0 - 1
                            else
                                if mir_is_arc_patch(prev, MIR_ARC_TRIAL) and mir_arc_marker_vreg(prev) == rv do
                                    native_write_i64(prev as i64, 0, MirOp.Nop as i64)
                                    native_write_i64(prev as i64, 8, mir_opnd_none() as i64)
                                end
                                j = j - 1
                            end
                        end
                        pending_v = 0 - 1
                        mir_opt_note_change()
                    else
                        pending_v = 0 - 1
                    end
                else
                    op = mir_instr_op(ins)
                    if mir_memory_barrier(op) do pending_v = 0 - 1 end
                    if op == MirOp.Intrinsic do
                        s2k = mir_instr_src2(ins)
                        if mir_opnd_type(s2k) == MirOperandType.Imm and (mir_opnd_imm_val(s2k) == MIR_INTR_ARENA or mir_opnd_imm_val(s2k) == MIR_MEM_MARK or mir_opnd_imm_val(s2k) == MIR_MEM_RESET) do
                            dst = mir_instr_dst(ins)
                            if mir_opnd_type(dst) == MirOperandType.VReg do
                                dv = mir_opnd_vreg_id(dst)
                                if dv >= 0 and dv < n_vregs do
                                    # arena path — strip any ARC markers for this vreg in block
                                end
                            end
                        end
                    end
                end
                i = i + 1
            end
            var i2 = 0
            when i2 < vec_len_rt(instrs) loop
                ins2 = vec_get_rt(instrs, i2)
                if mir_is_arc_patch(ins2, MIR_ARC_RETAIN) or mir_is_arc_patch(ins2, MIR_ARC_RELEASE) or mir_is_arc_patch(ins2, MIR_ARC_TRIAL) do
                    vv = mir_arc_marker_vreg(ins2)
                    if vv >= 0 and vv < n_vregs and vec_get_rt(escaped, vv) == 0 do
                        native_write_i64(ins2 as i64, 0, MirOp.Nop as i64)
                        native_write_i64(ins2 as i64, 8, mir_opnd_none() as i64)
                        mir_opt_note_change()
                    end
                end
                i2 = i2 + 1
            end
            vec_set_rt(blocks, b_idx, mir_block_replace_head(b, instrs))
        end
        b_idx = b_idx + 1
    end
    out blocks
end.

func mir_opt_arc_trial_deletion(blocks: i64):
    escaped = mir_opt_build_escaped_vregs(blocks)
    blocks = mir_opt_arc_insert_retain_release(blocks, escaped)
    blocks = mir_opt_arc_trial_delete_pairs(blocks, escaped)
    vec_free_rt(escaped)
    out blocks
end.

##
 * IPO cascade — re-run key passes after inlining to fold constants and eliminate
 * dead code exposed by the just-completed inlining round.
 * NOTE: mir_opt_inlining() is intentionally NOT called here; it is always called
 * by mir_opt_run_spec_round immediately before this cascade. Calling it again
 * would start a new epoch and re-expand every callee, causing O(n²) IR growth.
 ##
func mir_opt_ipo_inline_cascade(blocks: i64):
    blocks = mir_opt_sccp(blocks)
    blocks = mir_opt_sroa(blocks)
    blocks = mir_opt_dae(blocks)
    blocks = mir_opt_constant_folding(blocks)

    blocks = mir_opt_dce(blocks)
    out blocks
end.

##
 * Loop tiling / fusion — fuse adjacent loops with identical bounds.
 ##
func mir_opt_loop_tiling_fusion_interchange(blocks: i64):
    n_blocks = vec_len_rt(blocks)
    var i = 0
    when i < (n_blocks - 2) loop
        b0 = vec_get_rt(blocks, i)
        b1 = vec_get_rt(blocks, i + 1)
        b2 = vec_get_rt(blocks, i + 2)
        i0 = mir_block_head(b0)
        i1 = mir_block_head(b1)
        i2 = mir_block_head(b2)
        if i0 >= 0 and i1 >= 0 and i2 >= 0 do
            n0 = vec_len_rt(i0)
            n1 = vec_len_rt(i1)
            if n0 >= 2 and n1 >= 2 do
                c0 = vec_get_rt(i0, n0 - 2)
                c1 = vec_get_rt(i1, n1 - 2)
                if mir_instr_op(c0) == MirOp.CmpLe and mir_instr_op(c1) == MirOp.CmpLe do
                    if mir_opnd_is_same(mir_instr_src1(c0), mir_instr_src1(c1)) and mir_opnd_is_same(mir_instr_src2(c0), mir_instr_src2(c1)) do
                        fused = mir_instr_new(MirOp.Intrinsic, mir_opnd_none(), mir_opnd_imm(i), mir_opnd_imm(MIR_INTR_PATCH_POINT))
                        i0 = mir_block_insert_before_terminator(i0, fused)
                        vec_set_rt(blocks, i, mir_block_replace_head(b0, i0))
                        mir_opt_note_change()
                    end
                end
            end
        end
        i = i + 1
    end
    out blocks
end.

##
 * Hot/cold layout — annotate cold blocks (no succ back to header).
 ##
func mir_opt_hot_cold_layout_partitioning(blocks: i64):
    if vec_len_rt(blocks) <= 0 do out blocks end
    entry = vec_get_rt(blocks, 0)
    entry_id = mir_block_id(entry)
    hot = vec_new_rt()
    var bi = 0
    when bi < vec_len_rt(blocks) loop
        hot = vec_push_rt(hot, 0)
        bi = bi + 1
    end
    vec_set_rt(hot, 0, 1)
    var changed = 1
    var iter = 0
    when changed == 1 and iter < vec_len_rt(blocks) loop
        changed = 0
        bi = 0
        when bi < vec_len_rt(blocks) loop
            if vec_get_rt(hot, bi) == 1 do
                succs = mir_block_successors(vec_get_rt(blocks, bi))
                if succs >= 0 do
                    var si = 0
                    when si < vec_len_rt(succs) loop
                        sid = vec_get_rt(succs, si)
                        sj = mir_find_block_index(blocks, sid)
                        if sj >= 0 and vec_get_rt(hot, sj) == 0 do
                            vec_set_rt(hot, sj, 1)
                            changed = 1
                        end
                        si = si + 1
                    end
                end
            end
            bi = bi + 1
        end
        iter = iter + 1
    end
    bi = 0
    when bi < vec_len_rt(blocks) loop
        if vec_get_rt(hot, bi) == 0 do
            b = vec_get_rt(blocks, bi)
            instrs = mir_block_head(b)
            if instrs >= 0 do
                marker = mir_instr_new(MirOp.Intrinsic, mir_opnd_none(), mir_opnd_imm(MIR_COLD_BLOCK_MARKER), mir_opnd_imm(MIR_INTR_NOP_MARKER))
                instrs = mir_block_insert_before_terminator(instrs, marker)
                vec_set_rt(blocks, bi, mir_block_replace_head(b, instrs))
                mir_opt_note_change()
            end
        else
            instrs_h = mir_block_head(vec_get_rt(blocks, bi))
            if instrs_h >= 0 do
                marker_h = mir_instr_new(MirOp.Intrinsic, mir_opnd_none(), mir_opnd_imm(MIR_HOT_BLOCK_MARKER), mir_opnd_imm(MIR_INTR_NOP_MARKER))
                instrs_h = mir_block_insert_before_terminator(instrs_h, marker_h)
                vec_set_rt(blocks, bi, mir_block_replace_head(vec_get_rt(blocks, bi), instrs_h))
                mir_opt_note_change()
            end
        end
        bi = bi + 1
    end
    out blocks
end.

##
 * NEON SIMD — vector lowering hook (legacy SWIZZLE rewrite removed per Phase 5 spec).
 ##
func mir_opt_neon_simd_vector_lowering(blocks: i64):
    out blocks
end.

##
 * Loop unroll — full unroll when constant trip count <= MIR_UNROLL_MAX.
 ##
func mir_opt_loop_unroll(blocks: i64):
    n_blocks = vec_len_rt(blocks)
    var i = 0
    when i < (n_blocks - 1) loop
        cond_b = vec_get_rt(blocks, i)
        cond_instrs = mir_block_head(cond_b)
        if cond_instrs >= 0 do
            n_cond = vec_len_rt(cond_instrs)
            if n_cond >= 3 do
                ins_jump = vec_get_rt(cond_instrs, n_cond - 1)
                ins_jin = vec_get_rt(cond_instrs, n_cond - 2)
                ins_cmp = vec_get_rt(cond_instrs, n_cond - 3)
                if mir_instr_op(ins_jump) == MirOp.Jump and mir_instr_op(ins_jin) == MirOp.JumpIfNot do
                    if mir_instr_op(ins_cmp) == MirOp.CmpLe or mir_instr_op(ins_cmp) == MirOp.CmpLt do
                        lim = mir_instr_src2(ins_cmp)
                        if mir_opnd_type(lim) == MirOperandType.Imm do
                            trip = mir_opnd_imm_val(lim)
                            if mir_instr_op(ins_cmp) == MirOp.CmpLe do trip = trip + 1 end
                            if trip >= 2 and trip <= MIR_UNROLL_MAX do
                                cond_id = mir_block_id(cond_b)
                                exit_id = mir_opnd_imm_val(mir_instr_src2(ins_jin))
                                body_b = vec_get_rt(blocks, i + 1)
                                body_instrs = mir_block_head(body_b)
                                if body_instrs >= 0 do
                                    n_body = vec_len_rt(body_instrs)
                                    if n_body >= 1 do
                                        last_body = vec_get_rt(body_instrs, n_body - 1)
                                        # Counted loops (loop N / for-range) use body -> step -> cond.
                                        # Unroll only when the back-edge is body -> cond (O(1) shape check).
                                        if mir_instr_op(last_body) == MirOp.Jump and mir_opnd_imm_val(mir_instr_src1(last_body)) == cond_id do
                                            cloned = vec_new_rt()
                                            var rep = 0
                                            when rep < trip loop
                                                var bi = 0
                                                when bi < (n_body - 1) loop
                                                    cloned = vec_push_rt(cloned, vec_get_rt(body_instrs, bi))
                                                    bi = bi + 1
                                                end
                                                rep = rep + 1
                                            end
                                            exit_jump = mir_instr_new(MirOp.Jump, mir_opnd_none(), mir_opnd_imm(exit_id), mir_opnd_none())
                                            cloned = vec_push_rt(cloned, exit_jump)
                                            vec_set_rt(blocks, i + 1, mir_block_replace_head(body_b, cloned))
                                            entry_jump = mir_instr_new(MirOp.Jump, mir_opnd_none(), mir_opnd_imm(i + 1), mir_opnd_none())
                                            new_cond = vec_new_rt()
                                            new_cond = vec_push_rt(new_cond, entry_jump)
                                            vec_set_rt(blocks, i, mir_block_replace_head(cond_b, new_cond))
                                            mir_opt_note_change()
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
        i = i + 1
    end
    out blocks
end.


