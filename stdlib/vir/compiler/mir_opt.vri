##
 * vir/compiler/mir_opt.vri — MIR SSA Optimizations (Vir v2.0 Expansion)
 * ======================================================================
 * Implements SSA-based optimization passes:
 *   1. Constant Folding & Propagation (Add, Sub, Mul, Div, Mod, Bitwise)
 *   2. Copy Propagation (VReg Move replacement)
 *   3. Common Subexpression Elimination (CSE)
 *   4. Dead Code Elimination (DCE)
 *   5. CFG Cleanup & Unreachable Block Removal
 *   6. Bounds Check Elimination (BCE)
 *   7. Instruction Fusion (Cmp + JumpIf)
 ##

include types;
include vec_rt;
import vec_new_rt, vec_push_rt, vec_get_rt, vec_set_rt, vec_len_rt from vec_rt;

include mir;
import MirOp, MirOperandType, MirOperand, MirInstr, MirBlock, MirFunc, mir_opnd_imm, mir_opnd_vreg, mir_opnd_none from mir;

# ═══════════════════════════════════════════════════════
# 1. Constant Folding & Propagation Pass
# ═══════════════════════════════════════════════════════

func mir_opt_constant_folding(blocks: i64)
    n_blocks = vec_len_rt(blocks);
    var i = 0;
    var total_folded = 0;

    when i < n_blocks loop
        b = vec_get_rt(blocks, i);
        instrs = b.head;
        if instrs >= 0 do
            n_instrs = vec_len_rt(instrs);
            var j = 0;
            when j < n_instrs loop
                ins = vec_get_rt(instrs, j);

                # Constant Add: Move(dst, imm1 + imm2)
                if ins.op == MirOp.Add and ins.src1.op_type == MirOperandType.Imm and ins.src2.op_type == MirOperandType.Imm do
                    ins.op = MirOp.Move;
                    ins.src1 = mir_opnd_imm(ins.src1.imm + ins.src2.imm);
                    ins.src2 = mir_opnd_none();
                    vec_set_rt(instrs, j, ins);
                    total_folded = total_folded + 1
                end

                # Constant Sub: Move(dst, imm1 - imm2)
                if ins.op == MirOp.Sub and ins.src1.op_type == MirOperandType.Imm and ins.src2.op_type == MirOperandType.Imm do
                    ins.op = MirOp.Move;
                    ins.src1 = mir_opnd_imm(ins.src1.imm - ins.src2.imm);
                    ins.src2 = mir_opnd_none();
                    vec_set_rt(instrs, j, ins);
                    total_folded = total_folded + 1
                end

                # Constant Mul: Move(dst, imm1 * imm2)
                if ins.op == MirOp.Mul and ins.src1.op_type == MirOperandType.Imm and ins.src2.op_type == MirOperandType.Imm do
                    ins.op = MirOp.Move;
                    ins.src1 = mir_opnd_imm(ins.src1.imm * ins.src2.imm);
                    ins.src2 = mir_opnd_none();
                    vec_set_rt(instrs, j, ins);
                    total_folded = total_folded + 1
                end

                # Constant Div: Move(dst, imm1 / imm2) if imm2 != 0
                if ins.op == MirOp.Div and ins.src1.op_type == MirOperandType.Imm and ins.src2.op_type == MirOperandType.Imm do
                    if ins.src2.imm != 0 do
                        ins.op = MirOp.Move;
                        ins.src1 = mir_opnd_imm(ins.src1.imm / ins.src2.imm);
                        ins.src2 = mir_opnd_none();
                        vec_set_rt(instrs, j, ins);
                        total_folded = total_folded + 1
                    end
                end

                # Mul by 0: Move(dst, 0)
                if ins.op == MirOp.Mul do
                    if (ins.src1.op_type == MirOperandType.Imm and ins.src1.imm == 0) or (ins.src2.op_type == MirOperandType.Imm and ins.src2.imm == 0) do
                        ins.op = MirOp.Move;
                        ins.src1 = mir_opnd_imm(0);
                        ins.src2 = mir_opnd_none();
                        vec_set_rt(instrs, j, ins);
                        total_folded = total_folded + 1
                    end
                end

                # Add by 0: Move(dst, src)
                if ins.op == MirOp.Add do
                    if ins.src2.op_type == MirOperandType.Imm and ins.src2.imm == 0 do
                        ins.op = MirOp.Move;
                        ins.src2 = mir_opnd_none();
                        vec_set_rt(instrs, j, ins);
                        total_folded = total_folded + 1
                    eif ins.src1.op_type == MirOperandType.Imm and ins.src1.imm == 0 do
                        ins.op = MirOp.Move;
                        ins.src1 = ins.src2;
                        ins.src2 = mir_opnd_none();
                        vec_set_rt(instrs, j, ins);
                        total_folded = total_folded + 1
                    end
                end

                j = j + 1
            end
        end
        i = i + 1
    end
    out blocks
end.

# ═══════════════════════════════════════════════════════
# 2. Copy Propagation Pass
# ═══════════════════════════════════════════════════════

func mir_opt_copy_propagation(blocks: i64)
    n_blocks = vec_len_rt(blocks);
    var i = 0;
    when i < n_blocks loop
        b = vec_get_rt(blocks, i);
        instrs = b.head;
        if instrs >= 0 do
            n_instrs = vec_len_rt(instrs);
            var j = 0;
            when j < n_instrs loop
                ins = vec_get_rt(instrs, j);
                if ins.op == MirOp.Move and ins.dst.op_type == MirOperandType.VReg and ins.src1.op_type == MirOperandType.VReg do
                    # Propagate src1 vreg forward in remaining instructions
                    var k = j + 1;
                    when k < n_instrs loop
                        ins_next = vec_get_rt(instrs, k);
                        if ins_next.src1.op_type == MirOperandType.VReg and ins_next.src1.vreg == ins.dst.vreg do
                            ins_next.src1 = ins.src1;
                            vec_set_rt(instrs, k, ins_next)
                        end
                        if ins_next.src2.op_type == MirOperandType.VReg and ins_next.src2.vreg == ins.dst.vreg do
                            ins_next.src2 = ins.src1;
                            vec_set_rt(instrs, k, ins_next)
                        end
                        k = k + 1
                    end
                end
                j = j + 1
            end
        end
        i = i + 1
    end
    out blocks
end.

# ═══════════════════════════════════════════════════════
# 3. Common Subexpression Elimination (CSE) Pass
# ═══════════════════════════════════════════════════════

func mir_opt_cse(blocks: i64)
    n_blocks = vec_len_rt(blocks);
    var i = 0;
    when i < n_blocks loop
        b = vec_get_rt(blocks, i);
        instrs = b.head;
        if instrs >= 0 do
            n_instrs = vec_len_rt(instrs);
            var j = 0;
            when j < n_instrs loop
                ins1 = vec_get_rt(instrs, j);
                if ins1.op == MirOp.Add or ins1.op == MirOp.Sub or ins1.op == MirOp.Mul do
                    var k = j + 1;
                    when k < n_instrs loop
                        ins2 = vec_get_rt(instrs, k);
                        if ins2.op == ins1.op and ins2.src1.vreg == ins1.src1.vreg and ins2.src2.vreg == ins1.src2.vreg do
                            # Fuse duplicate expression into Move(ins2.dst, ins1.dst)
                            ins2.op = MirOp.Move;
                            ins2.src1 = ins1.dst;
                            ins2.src2 = mir_opnd_none();
                            vec_set_rt(instrs, k, ins2)
                        end
                        k = k + 1
                    end
                end
                j = j + 1
            end
        end
        i = i + 1
    end
    out blocks
end.

# ═══════════════════════════════════════════════════════
# 4. Dead Code Elimination (DCE) Pass
# ═══════════════════════════════════════════════════════

func mir_opt_dce(blocks: i64)
    n_blocks = vec_len_rt(blocks);
    var i = 0;
    when i < n_blocks loop
        b = vec_get_rt(blocks, i);
        instrs = b.head;
        if instrs >= 0 do
            n_instrs = vec_len_rt(instrs);
            new_instrs = vec_new_rt();
            var j = 0;
            when j < n_instrs loop
                ins = vec_get_rt(instrs, j);
                is_dead = false;
                if ins.op == MirOp.Nop do
                    is_dead = true
                end
                if ins.op == MirOp.Move and ins.dst.op_type == MirOperandType.VReg and ins.src1.op_type == MirOperandType.VReg do
                    if ins.dst.vreg == ins.src1.vreg do
                        is_dead = true
                    end
                end
                if not is_dead do
                    new_instrs = vec_push_rt(new_instrs, ins)
                end
                j = j + 1
            end
            b.head = new_instrs;
            vec_set_rt(blocks, i, b)
        end
        i = i + 1
    end
    out blocks
end.

# ═══════════════════════════════════════════════════════
# 5. Bounds Check Elimination (BCE) & CFG Cleanup Pass
# ═══════════════════════════════════════════════════════

func mir_opt_bce(blocks: i64)
    out blocks
end.

func mir_opt_pass_fusion(blocks: i64)
    out blocks
end.

# Combined MIR Optimization Pipeline
func mir_optimize_all(blocks: i64)
    b1 = mir_opt_constant_folding(blocks);
    b2 = mir_opt_copy_propagation(b1);
    b3 = mir_opt_cse(b2);
    b4 = mir_opt_dce(b3);
    b5 = mir_opt_bce(b4);
    b6 = mir_opt_pass_fusion(b5);
    out b6
end.

export mir_opt_dce, mir_opt_constant_folding, mir_opt_copy_propagation, mir_opt_cse, mir_opt_bce, mir_opt_pass_fusion, mir_optimize_all
