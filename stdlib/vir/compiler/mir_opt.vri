##
 * vir/compiler/mir_opt.vri — MIR SSA Optimizations (Vir v2.0 Expansion)
 * ======================================================================
 * Block-local passes with kill-on-redef (safe on SSA and pre-SSA form).
 ##

include types;
include vec_rt;
import vec_new_rt, vec_push_rt, vec_get_rt, vec_set_rt, vec_len_rt from vec_rt;

include mir;
import MirOp, MirOperandType, MirOperand, MirInstr, MirBlock, MirFunc, mir_opnd_imm, mir_opnd_vreg, mir_opnd_none, mir_instr_new, mir_block_new, mir_instr_op, mir_instr_dst, mir_instr_src1, mir_instr_src2, mir_block_id, mir_block_head, mir_block_tail, mir_block_successors, mir_block_preds, mir_block_idom, mir_block_dom_children, mir_block_df, mir_block_next_block, mir_block_phis, mir_opnd_type, mir_opnd_vreg_id, mir_opnd_imm_val, mir_opnd_block_id from mir;

func mir_instr_defines_vreg(ins: MirInstr, v: i64):
    d = mir_instr_dst(ins);
    if mir_opnd_type(d) == MirOperandType.VReg and mir_opnd_vreg_id(d) == v do
        out true
    end
    out false
end.

func mir_opt_constant_folding(blocks: i64):
    n_blocks = vec_len_rt(blocks);
    var i = 0;

    when i < n_blocks loop
        b = vec_get_rt(blocks, i);
        instrs = mir_block_head(b);
        if instrs >= 0 do
            n_instrs = vec_len_rt(instrs);
            var j = 0;
            when j < n_instrs loop
                ins = vec_get_rt(instrs, j);
                op = mir_instr_op(ins);
                dst = mir_instr_dst(ins);
                s1 = mir_instr_src1(ins);
                s2 = mir_instr_src2(ins);
                s1_t = mir_opnd_type(s1);
                s2_t = mir_opnd_type(s2);

                if op == MirOp.Add and s1_t == MirOperandType.Imm and s2_t == MirOperandType.Imm do
                    new_ins = mir_instr_new(MirOp.Move, dst, mir_opnd_imm(mir_opnd_imm_val(s1) + mir_opnd_imm_val(s2)), mir_opnd_none());
                    vec_set_rt(instrs, j, new_ins)
                eif op == MirOp.Sub and s1_t == MirOperandType.Imm and s2_t == MirOperandType.Imm do
                    new_ins = mir_instr_new(MirOp.Move, dst, mir_opnd_imm(mir_opnd_imm_val(s1) - mir_opnd_imm_val(s2)), mir_opnd_none());
                    vec_set_rt(instrs, j, new_ins)
                eif op == MirOp.Mul and s1_t == MirOperandType.Imm and s2_t == MirOperandType.Imm do
                    new_ins = mir_instr_new(MirOp.Move, dst, mir_opnd_imm(mir_opnd_imm_val(s1) * mir_opnd_imm_val(s2)), mir_opnd_none());
                    vec_set_rt(instrs, j, new_ins)
                eif op == MirOp.Div and s1_t == MirOperandType.Imm and s2_t == MirOperandType.Imm do
                    if mir_opnd_imm_val(s2) != 0 do
                        new_ins = mir_instr_new(MirOp.Move, dst, mir_opnd_imm(mir_opnd_imm_val(s1) / mir_opnd_imm_val(s2)), mir_opnd_none());
                        vec_set_rt(instrs, j, new_ins)
                    end
                eif op == MirOp.Mul and ((s1_t == MirOperandType.Imm and mir_opnd_imm_val(s1) == 0) or (s2_t == MirOperandType.Imm and mir_opnd_imm_val(s2) == 0)) do
                    new_ins = mir_instr_new(MirOp.Move, dst, mir_opnd_imm(0), mir_opnd_none());
                    vec_set_rt(instrs, j, new_ins)
                eif op == MirOp.Add and (s2_t == MirOperandType.Imm and mir_opnd_imm_val(s2) == 0) do
                    new_ins = mir_instr_new(MirOp.Move, dst, s1, mir_opnd_none());
                    vec_set_rt(instrs, j, new_ins)
                eif op == MirOp.Add and (s1_t == MirOperandType.Imm and mir_opnd_imm_val(s1) == 0) do
                    new_ins = mir_instr_new(MirOp.Move, dst, s2, mir_opnd_none());
                    vec_set_rt(instrs, j, new_ins)
                end
                j = j + 1
            end
        end
        i = i + 1
    end
    out blocks
end.

func mir_opt_copy_propagation(blocks: i64):
    n_blocks = vec_len_rt(blocks);
    var i = 0;
    when i < n_blocks loop
        b = vec_get_rt(blocks, i);
        instrs = mir_block_head(b);
        if instrs >= 0 do
            n_instrs = vec_len_rt(instrs);
            var j = 0;
            when j < n_instrs loop
                ins = vec_get_rt(instrs, j);
                op = mir_instr_op(ins);
                dst = mir_instr_dst(ins);
                src1 = mir_instr_src1(ins);
                if op == MirOp.Move and mir_opnd_type(dst) == MirOperandType.VReg do
                    dst_v = mir_opnd_vreg_id(dst);
                    is_prop_vreg = mir_opnd_type(src1) == MirOperandType.VReg;
                    is_prop_imm = mir_opnd_type(src1) == MirOperandType.Imm;
                    if is_prop_vreg or is_prop_imm do
                        var k = j + 1;
                        stop = false;
                        when k < n_instrs and not stop loop
                            ins_next = vec_get_rt(instrs, k);
                            if mir_instr_defines_vreg(ins_next, dst_v) do
                                stop = true
                            else
                                if is_prop_vreg do
                                    if mir_instr_defines_vreg(ins_next, mir_opnd_vreg_id(src1)) do
                                        stop = true
                                    end
                                end
                                if not stop do
                                    changed = false;
                                    n_s1 = mir_instr_src1(ins_next);
                                    n_s2 = mir_instr_src2(ins_next);
                                    if mir_opnd_type(n_s1) == MirOperandType.VReg and mir_opnd_vreg_id(n_s1) == dst_v do
                                        n_s1 = src1;
                                        changed = true
                                    end
                                    if mir_opnd_type(n_s2) == MirOperandType.VReg and mir_opnd_vreg_id(n_s2) == dst_v do
                                        n_s2 = src1;
                                        changed = true
                                    end
                                    if changed do
                                        new_next = mir_instr_new(mir_instr_op(ins_next), mir_instr_dst(ins_next), n_s1, n_s2);
                                        vec_set_rt(instrs, k, new_next)
                                    end
                                end
                                k = k + 1
                            end
                        end
                    end
                end
                j = j + 1
            end
        end
        i = i + 1
    end
    out blocks
end.

func mir_opt_cse(blocks: i64):
    n_blocks = vec_len_rt(blocks);
    var i = 0;
    when i < n_blocks loop
        b = vec_get_rt(blocks, i);
        instrs = mir_block_head(b);
        if instrs >= 0 do
            n_instrs = vec_len_rt(instrs);
            var j = 0;
            when j < n_instrs loop
                ins1 = vec_get_rt(instrs, j);
                op1 = mir_instr_op(ins1);
                s1_1 = mir_instr_src1(ins1);
                s2_1 = mir_instr_src2(ins1);
                is_bin = op1 == MirOp.Add or op1 == MirOp.Sub or op1 == MirOp.Mul;
                if is_bin and mir_opnd_type(s1_1) == MirOperandType.VReg and mir_opnd_type(s2_1) == MirOperandType.VReg do
                    var k = j + 1;
                    stop = false;
                    when k < n_instrs and not stop loop
                        ins2 = vec_get_rt(instrs, k);
                        if mir_instr_defines_vreg(ins2, mir_opnd_vreg_id(s1_1)) or mir_instr_defines_vreg(ins2, mir_opnd_vreg_id(s2_1)) do
                            stop = true
                        else
                            op2 = mir_instr_op(ins2);
                            s1_2 = mir_instr_src1(ins2);
                            s2_2 = mir_instr_src2(ins2);
                            if op2 == op1 and mir_opnd_type(s1_2) == MirOperandType.VReg and mir_opnd_type(s2_2) == MirOperandType.VReg do
                                if mir_opnd_vreg_id(s1_2) == mir_opnd_vreg_id(s1_1) and mir_opnd_vreg_id(s2_2) == mir_opnd_vreg_id(s2_1) do
                                    new_ins2 = mir_instr_new(MirOp.Move, mir_instr_dst(ins2), mir_instr_dst(ins1), mir_opnd_none());
                                    vec_set_rt(instrs, k, new_ins2)
                                end
                            end
                            k = k + 1
                        end
                    end
                end
                j = j + 1
            end
        end
        i = i + 1
    end
    out blocks
end.

func count_vreg_uses_mir(blocks: i64, n_vregs: i64):
    uses = vec_new_rt();
    var vi = 0;
    when vi < n_vregs loop
        uses = vec_push_rt(uses, 0);
        vi = vi + 1
    end
    n_blocks = vec_len_rt(blocks);
    var i = 0;
    when i < n_blocks loop
        b = vec_get_rt(blocks, i);
        instrs = mir_block_head(b);
        if instrs >= 0 do
            n_instrs = vec_len_rt(instrs);
            var j = 0;
            when j < n_instrs loop
                ins = vec_get_rt(instrs, j);
                s1 = mir_instr_src1(ins);
                s2 = mir_instr_src2(ins);
                if mir_opnd_type(s1) == MirOperandType.VReg do
                    v1 = mir_opnd_vreg_id(s1);
                    if v1 >= 0 and v1 < n_vregs do
                        cnt = vec_get_rt(uses, v1);
                        vec_set_rt(uses, v1, cnt + 1)
                    end
                end
                if mir_opnd_type(s2) == MirOperandType.VReg do
                    v2 = mir_opnd_vreg_id(s2);
                    if v2 >= 0 and v2 < n_vregs do
                        cnt2 = vec_get_rt(uses, v2);
                        vec_set_rt(uses, v2, cnt2 + 1)
                    end
                end
                j = j + 1
            end
        end
        phis = mir_block_phis(b);
        if phis >= 0 do
            n_phis = vec_len_rt(phis);
            var p = 0;
            when p < n_phis loop
                phi = vec_get_rt(phis, p);
                inc_vals = mir_phi_incoming_values(phi);
                n_inc = vec_len_rt(inc_vals);
                var k = 0;
                when k < n_inc loop
                    val = vec_get_rt(inc_vals, k);
                    if mir_opnd_type(val) == MirOperandType.VReg do
                        pv = mir_opnd_vreg_id(val);
                        if pv >= 0 and pv < n_vregs do
                            cntp = vec_get_rt(uses, pv);
                            vec_set_rt(uses, pv, cntp + 1)
                        end
                    end
                    k = k + 1
                end
                p = p + 1
            end
        end
        i = i + 1
    end
    out uses
end.

func max_vreg_mir(blocks: i64):
    var max_v = 0;
    n_blocks = vec_len_rt(blocks);
    var i = 0;
    when i < n_blocks loop
        b = vec_get_rt(blocks, i);
        instrs = mir_block_head(b);
        if instrs >= 0 do
            n_instrs = vec_len_rt(instrs);
            var j = 0;
            when j < n_instrs loop
                ins = vec_get_rt(instrs, j);
                d = mir_instr_dst(ins);
                s1 = mir_instr_src1(ins);
                s2 = mir_instr_src2(ins);
                if mir_opnd_type(d) == MirOperandType.VReg and mir_opnd_vreg_id(d) > max_v do max_v = mir_opnd_vreg_id(d) end
                if mir_opnd_type(s1) == MirOperandType.VReg and mir_opnd_vreg_id(s1) > max_v do max_v = mir_opnd_vreg_id(s1) end
                if mir_opnd_type(s2) == MirOperandType.VReg and mir_opnd_vreg_id(s2) > max_v do max_v = mir_opnd_vreg_id(s2) end
                j = j + 1
            end
        end
        i = i + 1
    end
    out max_v + 1
end.

func is_pure_mir_op(op: i64):
    if op == MirOp.Move as i64 or op == MirOp.Add as i64 or op == MirOp.Sub as i64 or op == MirOp.Mul as i64 or op == MirOp.Div as i64 or op == MirOp.Rem as i64 or op == MirOp.Shl as i64 or op == MirOp.Shr as i64 or op == MirOp.And as i64 or op == MirOp.Or as i64 or op == MirOp.Xor as i64 or op == MirOp.Not as i64 or op == MirOp.Cmp as i64 do
        out true
    end
    out false
end.

func mir_opt_dce(blocks: i64):
    n_vregs = max_vreg_mir(blocks);
    uses = count_vreg_uses_mir(blocks, n_vregs);
    n_blocks = vec_len_rt(blocks);
    var i = 0;
    when i < n_blocks loop
        b = vec_get_rt(blocks, i);
        instrs = mir_block_head(b);
        if instrs >= 0 do
            n_instrs = vec_len_rt(instrs);
            new_instrs = vec_new_rt();
            var j = 0;
            when j < n_instrs loop
                ins = vec_get_rt(instrs, j);
                op = mir_instr_op(ins);
                dst = mir_instr_dst(ins);
                src1 = mir_instr_src1(ins);
                is_dead = false;
                if op == MirOp.Nop as i64 do
                    is_dead = true
                end
                if is_dead == false and op == MirOp.Move as i64 and mir_opnd_type(dst) == MirOperandType.VReg and mir_opnd_type(src1) == MirOperandType.VReg do
                    if mir_opnd_vreg_id(dst) == mir_opnd_vreg_id(src1) do
                        is_dead = true
                    end
                end
                if is_dead == false and is_pure_mir_op(op) and mir_opnd_type(dst) == MirOperandType.VReg do
                    dst_v = mir_opnd_vreg_id(dst);
                    if dst_v >= 0 and dst_v < n_vregs do
                        if vec_get_rt(uses, dst_v) == 0 do
                            is_dead = true
                        end
                    end
                end
                if is_dead == false do
                    new_instrs = vec_push_rt(new_instrs, ins)
                end
                j = j + 1
            end
            b_new = mir_block_new(
                mir_block_id(b),
                mir_block_phis(b),
                new_instrs,
                mir_block_tail(b),
                mir_block_successors(b),
                mir_block_preds(b),
                mir_block_idom(b),
                mir_block_dom_children(b),
                mir_block_df(b),
                mir_block_next_block(b)
            );
            vec_set_rt(blocks, i, b_new)
        end
        i = i + 1
    end
    out blocks
end.

##
 * mir_opt_strength_reduction — Replace expensive ops with cheaper equivalents.
 * Mul(v, 2^k) → Shl(v, k), Div(v, 2^k) → Shr(v, k).
 ## 
func mir_log2(v: i64):
    var k = 0;
    x = v;
    when x > 1 loop
        x = x / 2;
        k = k + 1
    end
    out k
end.

func mir_is_pow2(v: i64):
    if v <= 0 do
        out false
    end
    out (v bit_and (v - 1)) == 0
end.

func mir_opt_strength_reduction(blocks: i64):
    n_blocks = vec_len_rt(blocks);
    var i = 0;
    when i < n_blocks loop
        b = vec_get_rt(blocks, i);
        instrs = mir_block_head(b);
        if instrs >= 0 do
            n_instrs = vec_len_rt(instrs);
            var j = 0;
            when j < n_instrs loop
                ins = vec_get_rt(instrs, j);
                op = mir_instr_op(ins);
                dst = mir_instr_dst(ins);
                s1 = mir_instr_src1(ins);
                s2 = mir_instr_src2(ins);
                s1_t = mir_opnd_type(s1);
                s2_t = mir_opnd_type(s2);
                # Mul(v, 2^k) → Shl(v, k)
                if op == MirOp.Mul do
                    if s2_t == MirOperandType.Imm do
                        imm_v = mir_opnd_imm_val(s2);
                        if mir_is_pow2(imm_v) do
                            new_ins = mir_instr_new(MirOp.Shl, dst, s1, mir_opnd_imm(mir_log2(imm_v)));
                            vec_set_rt(instrs, j, new_ins)
                        end
                    eif s1_t == MirOperandType.Imm do
                        imm_v = mir_opnd_imm_val(s1);
                        if mir_is_pow2(imm_v) do
                            new_ins = mir_instr_new(MirOp.Shl, dst, s2, mir_opnd_imm(mir_log2(imm_v)));
                            vec_set_rt(instrs, j, new_ins)
                        end
                    end
                end
                # Div(v, 2^k) → Shr(v, k) for positive immediate divisors
                if op == MirOp.Div do
                    if s2_t == MirOperandType.Imm do
                        imm_v = mir_opnd_imm_val(s2);
                        if imm_v > 0 and mir_is_pow2(imm_v) do
                            new_ins = mir_instr_new(MirOp.Shr, dst, s1, mir_opnd_imm(mir_log2(imm_v)));
                            vec_set_rt(instrs, j, new_ins)
                        end
                    end
                end
                j = j + 1
            end
        end
        i = i + 1
    end
    out blocks
end.

