##
 * vir/compiler/mir_opt.vri — MIR Optimizations
 * ==============================================================
 * Implements Constant Folding and Dead Code Elimination (DCE).
 ##

include types;
include vec_rt;
import vec_new_rt, vec_push_rt, vec_get_rt, vec_set_rt, vec_len_rt from vec_rt;
include mir;
import MirOp, MirOperandType, MirOperand, MirInstr, MirBlock, MirFunc from mir;

func mir_opt_dce(blocks: i64):
    # Simulated DCE pass
    # In a real compiler, we would use def_uses chains.
    out blocks
end.

func mir_opt_constant_folding(blocks: i64):
    n_blocks = vec_len_rt(blocks);
    i = 0;
    when i < n_blocks loop
        b = vec_get_rt(blocks, i);
        instrs = b.head;
        if instrs >= 0 do
            n_instrs = vec_len_rt(instrs);
            j = 0;
            when j < n_instrs loop
                ins = vec_get_rt(instrs, j);
                if ins.op == MirOp.Add and ins.src1.op_type == MirOperandType.Imm and ins.src2.op_type == MirOperandType.Imm do
                    ins.op = MirOp.Move;
                    ins.src1.imm = ins.src1.imm + ins.src2.imm;
                    ins.src2.op_type = MirOperandType.None;
                    vec_set_rt(instrs, j, ins)
                end.
                j = j + 1
            end.
        end.
        i = i + 1
    end.
    out blocks
end.

export mir_opt_dce, mir_opt_constant_folding;
