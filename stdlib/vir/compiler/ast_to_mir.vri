##
 * vir/compiler/ast_to_mir.vri — AST to MIR Lowering
 * ==============================================================
 * Flattens AST into MIR basic blocks + CFG. Locals map to vregs.
 * Phi insertion is deferred to mir_ssa.vri (this phase emits non-SSA MIR).
 * Coverage / status: MUST_READ_CONTEXT/AST_TO_MIR_LOWERING_CHECKLIST.md
 ##

include types;
include vec_rt;
import vec_new_rt, vec_push_rt, vec_get_rt, vec_set_rt, vec_len_rt from vec_rt;

include string_rt;
import rt_streq, rt_strlen from string_rt;

include parser;
import AstNode, AstType, OpType from parser;

include mir;
import MirFunc, MirBlock, MirInstr, MirOp, MirOperand, MirOperandType, mir_opnd_none, mir_opnd_vreg, mir_opnd_imm, mir_block_new, mir_intern_string, MIR_INTR_STR_LIT, MIR_INTR_PRINT, MIR_INTR_ARRAY, MIR_INTR_TUPLE, MIR_INTR_ENTITY, MIR_INTR_ADDR_OF, MIR_INTR_INTERP, MIR_INTR_BUILTIN, MIR_INTR_INDEX, MIR_INTR_FIELD, MIR_INTR_MATCH_PAT, MIR_INTR_INPUT, MIR_INTR_ENUM, MIR_INTR_CAST, MIR_INTR_THROW, MIR_INTR_CANCEL, MIR_INTR_QUIET, MIR_INTR_ARENA, MIR_INTR_ENSURE, MIR_INTR_REVERT, MIR_INTR_INDEX_STORE, MIR_INTR_FIELD_STORE, MIR_INTR_STR_EQ, MIR_INTR_CHECK_CPU, MIR_INTR_PATCH_POINT, MIR_INTR_DECL, MIR_INTR_AWAIT, MIR_INTR_NOP_MARKER, MIR_INTR_TASK, MIR_INTR_WAIT, MIR_INTR_SELECT, MIR_INTR_SEND, MIR_INTR_RECV, MIR_INTR_EMIT, MIR_INTR_ERX, MIR_INTR_TRY, MIR_INTR_RESUME, MIR_INTR_LOCK, MIR_INTR_SWIZZLE, MIR_INTR_INFER, MIR_INTR_TRAIN, MIR_INTR_QUANTIZE, MIR_INTR_AWAIT_PASS, MIR_INTR_SAFE_ACCESS, MIR_INTR_ATOMIC, MIR_INTR_EXIST, MIR_INTR_PATTERN, MIR_INTR_MAP, MIR_INTR_ARR_COMPACT, MIR_INTR_BUNDLE, MIR_INTR_TIMEOUT, MIR_INTR_ISOLATE, MIR_INTR_ERROR, MIR_INTR_PRECOMP, MIR_INTR_REACTIVE, MIR_INTR_MORPH, MIR_INTR_EXPOSE, MIR_INTR_PTR, MIR_INTR_ASYNC, MIR_INTR_ATOMIC_VAR from mir;

# Map OpType → MirOp code.
# Special: Land=-2, Lor=-3, PatternOp=-4 (Intrinsic PATTERN). Unknown=-1.
func mir_op_from_optype(op: OpType)
    if op == OpType.Add do out MirOp.Add as i64 end
    if op == OpType.Sub do out MirOp.Sub as i64 end
    if op == OpType.Mul do out MirOp.Mul as i64 end
    if op == OpType.Div do out MirOp.Div as i64 end
    if op == OpType.ModOp do out MirOp.Mod as i64 end
    # PercentOp: AST-correct; MIR lower TODO (Spec §10.1 — not remainder)
    if op == OpType.Eq do out MirOp.CmpEq as i64 end
    if op == OpType.Ne do out MirOp.CmpNe as i64 end
    if op == OpType.Gt do out MirOp.CmpGt as i64 end
    if op == OpType.Lt do out MirOp.CmpLt as i64 end
    if op == OpType.Ge do out MirOp.CmpGe as i64 end
    if op == OpType.Le do out MirOp.CmpLe as i64 end
    if op == OpType.SafeEq do out MirOp.CmpEq as i64 end
    if op == OpType.SafeNe do out MirOp.CmpNe as i64 end
    if op == OpType.AndOp do out MirOp.And as i64 end
    if op == OpType.OrOp do out MirOp.Or as i64 end
    if op == OpType.XorOp do out MirOp.Xor as i64 end
    if op == OpType.ShlOp do out MirOp.Shl as i64 end
    if op == OpType.ShrOp do out MirOp.Shr as i64 end
    if op == OpType.PowOp do out MirOp.Pow as i64 end
    if op == OpType.MatMulOp do out MirOp.MatMul as i64 end
    if op == OpType.FmaOp do out MirOp.Fma as i64 end
    if op == OpType.Land do out -2 end
    if op == OpType.Lor do out -3 end
    if op == OpType.PatternOp do out -4 end
    out -1
end.

const MIR_VAR_BUCKETS: i64 = 64;

entity VarMap:
    name: string,
    vreg: i64
end.
entity LoopTarget:
    break_block: i64,
    continue_block: i64
end.
entity MirBuilder:
    func_obj: MirFunc,
    current_block: i64,
    vreg_counter: i64,
    var_buckets: i64,      # Vec<Vec<VarMap>> length MIR_VAR_BUCKETS
    loop_stack: i64       # Vec<LoopTarget>
end.

func name_hash_bucket(name: string)
    # Pointer+length mix (string is soft heap ptr). Bucket count = 64.
    p = name as i64;
    n = rt_strlen(name as int) as i64;
    h = p * 131 + n * 17;
    if h < 0 do
        h = 0 - h
    end
    out h % MIR_VAR_BUCKETS
end.

func builder_new(func_id: i64, fname: string)
    f = MirFunc (
        id: func_id,
        name: fname,
        next_vreg: 0,
        def_uses: vec_new_rt(),
        next_block_id: 1,
        entry_block: 0,
        blocks: vec_new_rt(),
        strings: vec_new_rt()
    );
    b0 = mir_block_new(0);
    f.blocks = vec_push_rt(f.blocks, b0);
    buckets = vec_new_rt();
    var bi = 0;
    when bi < MIR_VAR_BUCKETS loop
        buckets = vec_push_rt(buckets, vec_new_rt());
        bi = bi + 1
    end
    out MirBuilder (
        func_obj: f,
        current_block: 0,
        vreg_counter: 0,
        var_buckets: buckets,
        loop_stack: vec_new_rt()
    )
end.
func builder_intern(b: MirBuilder, s: string)
    var (f2, sid) = mir_intern_string(b.func_obj, s);
    b.func_obj = f2;
    out (b, sid)
end.
func builder_new_vreg(b: MirBuilder)
    reg = b.vreg_counter;
    b.vreg_counter = b.vreg_counter + 1;
    out (b, reg)
end.
func builder_add_block(b: MirBuilder)
    id = vec_len_rt(b.func_obj.blocks);
    blk = mir_block_new(id);
    b.func_obj.blocks = vec_push_rt(b.func_obj.blocks, blk);
    b.func_obj.next_block_id = id + 1;
    out (b, id)
end.
func builder_add_instr(b: MirBuilder, instr: MirInstr)
    if b.current_block >= 0 do
        blk = vec_get_rt(b.func_obj.blocks, b.current_block);
        blk.head = vec_push_rt(blk.head, instr);
        vec_set_rt(b.func_obj.blocks, b.current_block, blk)
    end
    out b
end.
func builder_edge_exists(b: MirBuilder, from_b: i64, to_b: i64)
    if from_b < 0 or to_b < 0 do
        out 0
    end
    src = vec_get_rt(b.func_obj.blocks, from_b);
    n = vec_len_rt(src.successors);
    var i = 0;
    when i < n loop
        if vec_get_rt(src.successors, i) == to_b do
            out 1
        end
        i = i + 1
    end
    out 0
end.
func builder_add_edge(b: MirBuilder, from_b: i64, to_b: i64)
    if from_b >= 0 and to_b >= 0 do
        if builder_edge_exists(b, from_b, to_b) == 0 do
            src = vec_get_rt(b.func_obj.blocks, from_b);
            dst = vec_get_rt(b.func_obj.blocks, to_b);
            src.successors = vec_push_rt(src.successors, to_b);
            dst.preds = vec_push_rt(dst.preds, from_b);
            vec_set_rt(b.func_obj.blocks, from_b, src);
            vec_set_rt(b.func_obj.blocks, to_b, dst)
        end
    end
    out b
end.
func builder_push_loop(b: MirBuilder, break_id: i64, cont_id: i64)
    lt = LoopTarget ( break_block: break_id, continue_block: cont_id );
    b.loop_stack = vec_push_rt(b.loop_stack, lt);
    out b
end.
func builder_pop_loop(b: MirBuilder)
    n = vec_len_rt(b.loop_stack);
    if n > 0 do
        # Vec has no pop — rebuild without last element.
        nv = vec_new_rt();
        var i = 0;
        when i < n - 1 loop
            nv = vec_push_rt(nv, vec_get_rt(b.loop_stack, i));
            i = i + 1
        end
        b.loop_stack = nv
    end
    out b
end.
func builder_loop_top(b: MirBuilder)
    n = vec_len_rt(b.loop_stack);
    if n <= 0 do
        out LoopTarget ( break_block: 0 - 1, continue_block: 0 - 1 )
    end
    out vec_get_rt(b.loop_stack, n - 1)
end.
func get_var_vreg(b: MirBuilder, name: string)
    bid = name_hash_bucket(name);
    bucket = vec_get_rt(b.var_buckets, bid);
    i = 0;
    n = vec_len_rt(bucket);
    when i < n loop
        vm = vec_get_rt(bucket, i);
        if rt_streq(vm.name, name) do
            out vm.vreg
        end
        i = i + 1
    end
    out -1
end.
func set_var_vreg(b: MirBuilder, name: string, vreg: i64)
    bid = name_hash_bucket(name);
    bucket = vec_get_rt(b.var_buckets, bid);
    i = 0;
    n = vec_len_rt(bucket);
    var found = false;
    when i < n loop
        vm = vec_get_rt(bucket, i);
        if rt_streq(vm.name, name) do
            vm.vreg = vreg;
            vec_set_rt(bucket, i, vm);
            found = true;
            i = n
        end
        i = i + 1
    end
    if not found do
        vm = VarMap ( name: name, vreg: vreg );
        bucket = vec_push_rt(bucket, vm)
    end
    vec_set_rt(b.var_buckets, bid, bucket);
    out b
end.

func emit_jump(b: MirBuilder, target: i64)
    ins = MirInstr (
        op: MirOp.Jump,
        dst: mir_opnd_none(),
        src1: mir_opnd_imm(target),
        src2: mir_opnd_none()
    );
    b = builder_add_instr(b, ins);
    b = builder_add_edge(b, b.current_block, target);
    out b
end.
func emit_jump_if(b: MirBuilder, cond: MirOperand, then_id: i64, else_id: i64)
    ins = MirInstr (
        op: MirOp.JumpIf,
        dst: mir_opnd_none(),
        src1: cond,
        src2: mir_opnd_imm(then_id)
    );
    b = builder_add_instr(b, ins);
    ins2 = MirInstr (
        op: MirOp.Jump,
        dst: mir_opnd_none(),
        src1: mir_opnd_imm(else_id),
        src2: mir_opnd_none()
    );
    b = builder_add_instr(b, ins2);
    b = builder_add_edge(b, b.current_block, then_id);
    b = builder_add_edge(b, b.current_block, else_id);
    out b
end.
func emit_set_arg(b: MirBuilder, idx: i64, val: MirOperand)
    ins = MirInstr (
        op: MirOp.SetArg,
        dst: mir_opnd_none(),
        src1: mir_opnd_imm(idx),
        src2: val
    );
    out builder_add_instr(b, ins)
end.
func emit_intrinsic(b: MirBuilder, kind: i64, dst: MirOperand, src1: MirOperand)
    ins = MirInstr (
        op: MirOp.Intrinsic,
        dst: dst,
        src1: src1,
        src2: mir_opnd_imm(kind),
        next: 0
    );
    out builder_add_instr(b, ins)
end.
func emit_jump_if_not(b: MirBuilder, cond: MirOperand, then_id: i64, else_id: i64)
    # JumpIfNot → then when cond==0; else fallthrough Jump to else_id.
    ins = MirInstr (
        op: MirOp.JumpIfNot,
        dst: mir_opnd_none(),
        src1: cond,
        src2: mir_opnd_imm(then_id),
        next: 0
    );
    b = builder_add_instr(b, ins);
    b = emit_jump(b, else_id);
    out b
end.
func emit_move(b: MirBuilder, dst_v: i64, src: MirOperand)
    ins = MirInstr (
        op: MirOp.Move,
        dst: mir_opnd_vreg(dst_v),
        src1: src,
        src2: mir_opnd_none(),
        next: 0
    );
    out builder_add_instr(b, ins)
end.
func emit_store(b: MirBuilder, addr: MirOperand, val: MirOperand)
    ins = MirInstr (
        op: MirOp.Store,
        dst: mir_opnd_none(),
        src1: val,
        src2: addr,
        next: 0
    );
    out builder_add_instr(b, ins)
end.
func emit_load(b: MirBuilder, dst_v: i64, addr: MirOperand)
    ins = MirInstr (
        op: MirOp.Load,
        dst: mir_opnd_vreg(dst_v),
        src1: addr,
        src2: mir_opnd_none(),
        next: 0
    );
    out builder_add_instr(b, ins)
end.
func lower_aggregate(b: MirBuilder, kind: i64, expr: AstNode)
    n = vec_len_rt(expr.children);
    b_mut = b;
    var i = 0;
    when i < n loop
        var (b2, aop) = lower_expr(b_mut, vec_get_rt(expr.children, i));
        b_mut = emit_set_arg(b2, i, aop);
        i = i + 1
    end
    var (b3, dst) = builder_new_vreg(b_mut);
    if kind == MIR_INTR_ENTITY do
        var (b4, tid) = builder_intern(b3, expr.name);
        b4 = emit_set_arg(b4, n, mir_opnd_imm(tid));
        b4 = emit_intrinsic(b4, kind, mir_opnd_vreg(dst), mir_opnd_imm(n));
        out (b4, mir_opnd_vreg(dst))
    end
    b3 = emit_intrinsic(b3, kind, mir_opnd_vreg(dst), mir_opnd_imm(n));
    out (b3, mir_opnd_vreg(dst))
end.

# Pre-declare recursive functions
func lower_stmt(b: MirBuilder, stmt: AstNode);
func lower_expr(b: MirBuilder, expr: AstNode);
func lower_decl_marker(b: MirBuilder, node: AstNode);
func ast_lower_func(func_id: int, ast_func: AstNode);
func ast_lower_program(prog: AstNode);
func lower_call_args(b: MirBuilder, expr: AstNode, start_child: i64, arg_base: i64);

func lower_call_args(b: MirBuilder, expr: AstNode, start_child: i64, arg_base: i64)
    n = vec_len_rt(expr.children);
    var i = start_child;
    var ai = 0;
    b_mut = b;
    when i < n loop
        arg = vec_get_rt(expr.children, i);
        var (b2, aop) = lower_expr(b_mut, arg);
        b_mut = emit_set_arg(b2, arg_base + ai, aop);
        ai = ai + 1;
        i = i + 1
    end
    out (b_mut, ai)
end.

func lower_expr_impl(b: MirBuilder, expr: AstNode)

    # 1. Literal Int
    if expr.node_type == AstType.LiteralInt do
        var (b2, v) = builder_new_vreg(b);
        ins = MirInstr (
            op: MirOp.Move,
            dst: mir_opnd_vreg(v),
            src1: mir_opnd_imm(expr.int_val),
            src2: mir_opnd_none()
        );
        b2 = builder_add_instr(b2, ins);
        out (b2, mir_opnd_vreg(v))
    end

    # 2. Literal Float (raw bits in int_val for now)
    if expr.node_type == AstType.LiteralFloat do
        var (b2, v) = builder_new_vreg(b);
        ins = MirInstr (
            op: MirOp.Move,
            dst: mir_opnd_vreg(v),
            src1: mir_opnd_imm(expr.int_val),
            src2: mir_opnd_none()
        );
        b2 = builder_add_instr(b2, ins);
        out (b2, mir_opnd_vreg(v))
    end

    # 3. Literal Str — src1 = string-pool id
    if expr.node_type == AstType.LiteralStr do
        var (b1, sid) = builder_intern(b, expr.name);
        var (b2, v) = builder_new_vreg(b1);
        b2 = emit_intrinsic(b2, MIR_INTR_STR_LIT, mir_opnd_vreg(v), mir_opnd_imm(sid));
        out (b2, mir_opnd_vreg(v))
    end

    # 3b. InterpExpr
    if expr.node_type == AstType.InterpExpr do
        var (b1, sid) = builder_intern(b, expr.name);
        var (b2, v) = builder_new_vreg(b1);
        b2 = emit_intrinsic(b2, MIR_INTR_INTERP, mir_opnd_vreg(v), mir_opnd_imm(sid));
        out (b2, mir_opnd_vreg(v))
    end

    # 4. Identifier
    if expr.node_type == AstType.Identifier do
        v = get_var_vreg(b, expr.name);
        if v >= 0 do
            out (b, mir_opnd_vreg(v))
        else
            out (b, mir_opnd_none())
        end
    end

    # 5. BinOp & Compare — full OpType→MirOp; Land/Lor → CFG (no silent Add)
    if expr.node_type == AstType.BinOp or expr.node_type == AstType.Compare do
        child_count = vec_len_rt(expr.children);
        if child_count >= 2 do
            left = vec_get_rt(expr.children, 0);
            right = vec_get_rt(expr.children, 1);
            mop_i = mir_op_from_optype(expr.op);

            # Land: if !lhs → 0 else rhs
            if mop_i == -2 do
                var (b1, opnd_l) = lower_expr(b, left);
                var (b2, dst) = builder_new_vreg(b1);
                var (b3, rhs_id) = builder_add_block(b2);
                var (b4, end_id) = builder_add_block(b3);
                b4 = emit_move(b4, dst, mir_opnd_imm(0));
                b4 = emit_jump_if_not(b4, opnd_l, end_id, rhs_id);
                b4.current_block = rhs_id;
                var (b5, opnd_r) = lower_expr(b4, right);
                b5 = emit_move(b5, dst, opnd_r);
                b5 = emit_jump(b5, end_id);
                b5.current_block = end_id;
                out (b5, mir_opnd_vreg(dst))
            end

            # Lor: if lhs → 1 else rhs
            if mop_i == -3 do
                var (b1, opnd_l) = lower_expr(b, left);
                var (b2, dst) = builder_new_vreg(b1);
                var (b3, rhs_id) = builder_add_block(b2);
                var (b4, end_id) = builder_add_block(b3);
                b4 = emit_move(b4, dst, mir_opnd_imm(1));
                b4 = emit_jump_if(b4, opnd_l, end_id, rhs_id);
                b4.current_block = rhs_id;
                var (b5, opnd_r) = lower_expr(b4, right);
                b5 = emit_move(b5, dst, opnd_r);
                b5 = emit_jump(b5, end_id);
                b5.current_block = end_id;
                out (b5, mir_opnd_vreg(dst))
            end

            # PatternOp `:~` → MIR_INTR_PATTERN
            if mop_i == -4 do
                var (b3, opnd_l) = lower_expr(b, left);
                var (b4, opnd_r) = lower_expr(b3, right);
                var (b5, dst) = builder_new_vreg(b4);
                b5 = emit_set_arg(b5, 0, opnd_l);
                b5 = emit_set_arg(b5, 1, opnd_r);
                out (emit_intrinsic(b5, MIR_INTR_PATTERN, mir_opnd_vreg(dst), opnd_l), mir_opnd_vreg(dst))
            end

            if mop_i < 0 do
                # Unknown OpType — emit Nop marker, return 0 (never default Add)
                var (b1, dst) = builder_new_vreg(b);
                b1 = emit_intrinsic(b1, MIR_INTR_NOP_MARKER, mir_opnd_vreg(dst), mir_opnd_imm(expr.op as i64));
                out (b1, mir_opnd_vreg(dst))
            end

            var (b3, opnd_l) = lower_expr(b, left);
            var (b4, opnd_r) = lower_expr(b3, right);
            var (b5, dst) = builder_new_vreg(b4);
            var m_op = MirOp.Add;
            if mop_i == 5 do m_op = MirOp.Sub end
            if mop_i == 6 do m_op = MirOp.Mul end
            if mop_i == 7 do m_op = MirOp.Div end
            if mop_i == 19 do m_op = MirOp.Mod end
            if mop_i == 13 do m_op = MirOp.CmpEq end
            if mop_i == 14 do m_op = MirOp.CmpNe end
            if mop_i == 15 do m_op = MirOp.CmpGt end
            if mop_i == 16 do m_op = MirOp.CmpLt end
            if mop_i == 17 do m_op = MirOp.CmpGe end
            if mop_i == 18 do m_op = MirOp.CmpLe end
            if mop_i == 22 do m_op = MirOp.And end
            if mop_i == 23 do m_op = MirOp.Or end
            if mop_i == 24 do m_op = MirOp.Xor end
            if mop_i == 25 do m_op = MirOp.Shl end
            if mop_i == 26 do m_op = MirOp.Shr end
            if mop_i == 28 do m_op = MirOp.Pow end
            if mop_i == 29 do m_op = MirOp.MatMul end
            if mop_i == 30 do m_op = MirOp.Fma end
            if mop_i == 4 do m_op = MirOp.Add end
            ins = MirInstr (
                op: m_op,
                dst: mir_opnd_vreg(dst),
                src1: opnd_l,
                src2: opnd_r
            );
            b5 = builder_add_instr(b5, ins);
            out (b5, mir_opnd_vreg(dst))
        end
    end

    # 5b. UnaryNot → MirOp.Not
    if expr.node_type == AstType.UnaryNot do
        if vec_len_rt(expr.children) > 0 do
            var (b2, opnd) = lower_expr(b, vec_get_rt(expr.children, 0));
            var (b3, dst) = builder_new_vreg(b2);
            ins = MirInstr (
                op: MirOp.Not,
                dst: mir_opnd_vreg(dst),
                src1: opnd,
                src2: mir_opnd_none()
            );
            b3 = builder_add_instr(b3, ins);
            out (b3, mir_opnd_vreg(dst))
        end
    end

    # 5c. Swizzle / SafeAccess
    if expr.node_type == AstType.SwizzleExpr do
        var (b1, mid) = builder_intern(b, expr.name);
        if vec_len_rt(expr.children) > 0 do
            var (b2, base) = lower_expr(b1, vec_get_rt(expr.children, 0));
            var (b3, dst) = builder_new_vreg(b2);
            b3 = emit_set_arg(b3, 0, base);
            b3 = emit_set_arg(b3, 1, mir_opnd_imm(mid));
            out (emit_intrinsic(b3, MIR_INTR_SWIZZLE, mir_opnd_vreg(dst), mir_opnd_imm(mid)), mir_opnd_vreg(dst))
        end
    end
    if expr.node_type == AstType.SafeAccessExpr do
        var (b1, fid) = builder_intern(b, expr.name);
        if vec_len_rt(expr.children) > 0 do
            var (b2, base) = lower_expr(b1, vec_get_rt(expr.children, 0));
            var (b3, dst) = builder_new_vreg(b2);
            b3 = emit_set_arg(b3, 0, base);
            b3 = emit_set_arg(b3, 1, mir_opnd_imm(fid));
            out (emit_intrinsic(b3, MIR_INTR_SAFE_ACCESS, mir_opnd_vreg(dst), mir_opnd_imm(fid)), mir_opnd_vreg(dst))
        end
    end

    # 5d. Erx / Task / Wait / Quantize
    if expr.node_type == AstType.ErxExpr do
        var (b1, dst) = builder_new_vreg(b);
        out (emit_intrinsic(b1, MIR_INTR_ERX, mir_opnd_vreg(dst), mir_opnd_none()), mir_opnd_vreg(dst))
    end
    if expr.node_type == AstType.TaskExpr do
        if vec_len_rt(expr.children) > 0 do
            var (b2, v) = lower_expr(b, vec_get_rt(expr.children, 0));
            var (b3, dst) = builder_new_vreg(b2);
            out (emit_intrinsic(b3, MIR_INTR_TASK, mir_opnd_vreg(dst), v), mir_opnd_vreg(dst))
        end
    end
    if expr.node_type == AstType.WaitExpr do
        if vec_len_rt(expr.children) > 0 do
            var (b2, v) = lower_expr(b, vec_get_rt(expr.children, 0));
            var (b3, dst) = builder_new_vreg(b2);
            out (emit_intrinsic(b3, MIR_INTR_WAIT, mir_opnd_vreg(dst), v), mir_opnd_vreg(dst))
        end
    end
    if expr.node_type == AstType.QuantizeExpr do
        if vec_len_rt(expr.children) > 0 do
            var (b2, v) = lower_expr(b, vec_get_rt(expr.children, 0));
            var (b3, dst) = builder_new_vreg(b2);
            out (emit_intrinsic(b3, MIR_INTR_QUANTIZE, mir_opnd_vreg(dst), v), mir_opnd_vreg(dst))
        end
    end

    # 6. Call — SetArg* then Call(dst, nargs); src2 = callee string-pool id
    if expr.node_type == AstType.Call do
        var (b1, cid) = builder_intern(b, expr.name);
        var (b2, nargs) = lower_call_args(b1, expr, 0, 0);
        var (b3, dst) = builder_new_vreg(b2);
        ins = MirInstr (
            op: MirOp.Call,
            dst: mir_opnd_vreg(dst),
            src1: mir_opnd_imm(nargs),
            src2: mir_opnd_imm(cid),
            next: 0
        );
        b3 = builder_add_instr(b3, ins);
        out (b3, mir_opnd_vreg(dst))
    end

    # 6b. BuiltinCall — port/lock/atomic map to MIR_INTR_*; else BUILTIN+Call
    if expr.node_type == AstType.BuiltinCall do
        if rt_streq(expr.name, "__mir_send") or rt_streq(expr.name, "port_send") do
            var (b2, nargs) = lower_call_args(b, expr, 0, 0);
            var (b3, dst) = builder_new_vreg(b2);
            out (emit_intrinsic(b3, MIR_INTR_SEND, mir_opnd_vreg(dst), mir_opnd_imm(nargs)), mir_opnd_vreg(dst))
        end
        if rt_streq(expr.name, "__mir_recv") or rt_streq(expr.name, "port_recv") do
            var (b2, nargs) = lower_call_args(b, expr, 0, 0);
            var (b3, dst) = builder_new_vreg(b2);
            out (emit_intrinsic(b3, MIR_INTR_RECV, mir_opnd_vreg(dst), mir_opnd_imm(nargs)), mir_opnd_vreg(dst))
        end
        if rt_streq(expr.name, "__mir_lock") or rt_streq(expr.name, "atomic_bang") do
            var (b2, nargs) = lower_call_args(b, expr, 0, 0);
            var (b3, dst) = builder_new_vreg(b2);
            var kind = MIR_INTR_LOCK;
            if rt_streq(expr.name, "atomic_bang") do
                kind = MIR_INTR_ATOMIC
            end
            out (emit_intrinsic(b3, kind, mir_opnd_vreg(dst), mir_opnd_imm(nargs)), mir_opnd_vreg(dst))
        end
        var (b1, cid) = builder_intern(b, expr.name);
        var (b2, nargs) = lower_call_args(b1, expr, 0, 0);
        var (b3, dst) = builder_new_vreg(b2);
        b3 = emit_intrinsic(b3, MIR_INTR_BUILTIN, mir_opnd_none(), mir_opnd_imm(expr.builtin_id as i64));
        ins = MirInstr (
            op: MirOp.Call,
            dst: mir_opnd_vreg(dst),
            src1: mir_opnd_imm(nargs),
            src2: mir_opnd_imm(cid),
            next: 0
        );
        b3 = builder_add_instr(b3, ins);
        out (b3, mir_opnd_vreg(dst))
    end

    # 6c. MethodCall — SetArg(0)=recv; src2 = method name id
    if expr.node_type == AstType.MethodCall do
        var (b0, mid) = builder_intern(b, expr.name);
        nch = vec_len_rt(expr.children);
        b_mut = b0;
        var nargs = 0;
        if nch > 0 do
            recv = vec_get_rt(expr.children, 0);
            var (b2, rop) = lower_expr(b_mut, recv);
            b_mut = emit_set_arg(b2, 0, rop);
            nargs = 1;
            var (b3, rest) = lower_call_args(b_mut, expr, 1, 1);
            b_mut = b3;
            nargs = nargs + rest
        end
        var (b4, dst) = builder_new_vreg(b_mut);
        ins = MirInstr (
            op: MirOp.Call,
            dst: mir_opnd_vreg(dst),
            src1: mir_opnd_imm(nargs),
            src2: mir_opnd_imm(mid),
            next: 0
        );
        b4 = builder_add_instr(b4, ins);
        out (b4, mir_opnd_vreg(dst))
    end

    # 5e. PatternExpr / ExistExpr / Map / ArrCompact / Bundle / Error / Ptr
    if expr.node_type == AstType.PatternExpr do
        if vec_len_rt(expr.children) >= 2 do
            var (b3, opnd_l) = lower_expr(b, vec_get_rt(expr.children, 0));
            var (b4, opnd_r) = lower_expr(b3, vec_get_rt(expr.children, 1));
            var (b5, dst) = builder_new_vreg(b4);
            b5 = emit_set_arg(b5, 0, opnd_l);
            b5 = emit_set_arg(b5, 1, opnd_r);
            out (emit_intrinsic(b5, MIR_INTR_PATTERN, mir_opnd_vreg(dst), opnd_l), mir_opnd_vreg(dst))
        end
    end
    if expr.node_type == AstType.ExistExpr do
        if vec_len_rt(expr.children) > 0 do
            var (b2, v) = lower_expr(b, vec_get_rt(expr.children, 0));
            var (b3, dst) = builder_new_vreg(b2);
            out (emit_intrinsic(b3, MIR_INTR_EXIST, mir_opnd_vreg(dst), v), mir_opnd_vreg(dst))
        end
    end
    if expr.node_type == AstType.MapExpr do
        var (b2, nargs) = lower_call_args(b, expr, 0, 0);
        var (b3, dst) = builder_new_vreg(b2);
        out (emit_intrinsic(b3, MIR_INTR_MAP, mir_opnd_vreg(dst), mir_opnd_imm(nargs)), mir_opnd_vreg(dst))
    end
    if expr.node_type == AstType.ArrCompactExpr do
        var (b2, nargs) = lower_call_args(b, expr, 0, 0);
        var (b3, dst) = builder_new_vreg(b2);
        out (emit_intrinsic(b3, MIR_INTR_ARR_COMPACT, mir_opnd_vreg(dst), mir_opnd_imm(nargs)), mir_opnd_vreg(dst))
    end
    if expr.node_type == AstType.BundleExpr do
        var (b2, nargs) = lower_call_args(b, expr, 0, 0);
        var (b3, dst) = builder_new_vreg(b2);
        out (emit_intrinsic(b3, MIR_INTR_BUNDLE, mir_opnd_vreg(dst), mir_opnd_imm(nargs)), mir_opnd_vreg(dst))
    end
    if expr.node_type == AstType.ErrorExpr do
        var (b1, dst) = builder_new_vreg(b);
        out (emit_intrinsic(b1, MIR_INTR_ERROR, mir_opnd_vreg(dst), mir_opnd_none()), mir_opnd_vreg(dst))
    end
    if expr.node_type == AstType.PtrTypeExpr do
        var (b1, pid) = builder_intern(b, expr.name);
        var (b2, dst) = builder_new_vreg(b1);
        out (emit_intrinsic(b2, MIR_INTR_PTR, mir_opnd_vreg(dst), mir_opnd_imm(pid)), mir_opnd_vreg(dst))
    end

    # 7. UnaryMinus
    if expr.node_type == AstType.UnaryMinus do
        child_count = vec_len_rt(expr.children);
        if child_count > 0 do
            child = vec_get_rt(expr.children, 0);
            var (b2, child_opnd) = lower_expr(b, child);
            var (b3, dst) = builder_new_vreg(b2);
            ins = MirInstr (
                op: MirOp.Sub,
                dst: mir_opnd_vreg(dst),
                src1: mir_opnd_imm(0),
                src2: child_opnd
            );
            b3 = builder_add_instr(b3, ins);
            out (b3, mir_opnd_vreg(dst))
        end
    end

    # 7b. AddrOf — shared (&) / mut (&mut); SetArg0 = mut flag
    if expr.node_type == AstType.AddrOf do
        child_count = vec_len_rt(expr.children);
        if child_count > 0 do
            child = vec_get_rt(expr.children, 0);
            var (b2, child_opnd) = lower_expr(b, child);
            var (b3, dst) = builder_new_vreg(b2);
            mutf = 0;
            if rt_streq(expr.name, "mut") do
                mutf = 1
            end
            b3 = emit_set_arg(b3, 0, mir_opnd_imm(mutf));
            b3 = emit_intrinsic(b3, MIR_INTR_ADDR_OF, mir_opnd_vreg(dst), child_opnd);
            out (b3, mir_opnd_vreg(dst))
        end
    end

    # 8. Aggregate literals — SetArg each element then Intrinsic
    if expr.node_type == AstType.ArrayLiteral do
        out lower_aggregate(b, MIR_INTR_ARRAY, expr)
    end
    if expr.node_type == AstType.TupleExpr do
        out lower_aggregate(b, MIR_INTR_TUPLE, expr)
    end
    if expr.node_type == AstType.EntityLiteral do
        out lower_aggregate(b, MIR_INTR_ENTITY, expr)
    end

    # 9. Index — shapes: children[base,idx] OR name=base + children[idx]
    if expr.node_type == AstType.IndexAccess or expr.node_type == AstType.ExprIndex do
        nch = vec_len_rt(expr.children);
        b_mut = b;
        base = mir_opnd_none();
        idx = mir_opnd_none();
        if nch >= 2 do
            var (b2, base2) = lower_expr(b_mut, vec_get_rt(expr.children, 0));
            var (b3, idx2) = lower_expr(b2, vec_get_rt(expr.children, 1));
            b_mut = b3;
            base = base2;
            idx = idx2
        eif nch == 1 do
            bv = get_var_vreg(b_mut, expr.name);
            if bv >= 0 do
                base = mir_opnd_vreg(bv)
            end
            var (b2, idx2) = lower_expr(b_mut, vec_get_rt(expr.children, 0));
            b_mut = b2;
            idx = idx2
        end
        if base.op_type != MirOperandType.None do
            var (b4, dst) = builder_new_vreg(b_mut);
            b4 = emit_set_arg(b4, 0, idx);
            b4 = emit_intrinsic(b4, MIR_INTR_INDEX, mir_opnd_vreg(dst), base);
            out (b4, mir_opnd_vreg(dst))
        end
    end
    if expr.node_type == AstType.FieldAccess do
        nch = vec_len_rt(expr.children);
        if nch >= 1 do
            var (b1, fid) = builder_intern(b, expr.name);
            var (b2, base) = lower_expr(b1, vec_get_rt(expr.children, 0));
            var (b3, dst) = builder_new_vreg(b2);
            b3 = emit_set_arg(b3, 0, mir_opnd_imm(fid));
            b3 = emit_intrinsic(b3, MIR_INTR_FIELD, mir_opnd_vreg(dst), base);
            out (b3, mir_opnd_vreg(dst))
        end
    end

    # 10. EnumAccess — name::name2
    if expr.node_type == AstType.EnumAccess do
        var (b1, e1) = builder_intern(b, expr.name);
        var (b2, e2) = builder_intern(b1, expr.name2);
        var (b3, dst) = builder_new_vreg(b2);
        b3 = emit_set_arg(b3, 0, mir_opnd_imm(e1));
        b3 = emit_set_arg(b3, 1, mir_opnd_imm(e2));
        b3 = emit_intrinsic(b3, MIR_INTR_ENUM, mir_opnd_vreg(dst), mir_opnd_none());
        out (b3, mir_opnd_vreg(dst))
    end

    # 11. InputExpr
    if expr.node_type == AstType.InputExpr do
        var (b2, dst) = builder_new_vreg(b);
        b2 = emit_intrinsic(b2, MIR_INTR_INPUT, mir_opnd_vreg(dst), mir_opnd_none());
        out (b2, mir_opnd_vreg(dst))
    end

    # 12. CastExpr — identity Move (+ CAST marker for typed backends)
    if expr.node_type == AstType.CastExpr do
        nch = vec_len_rt(expr.children);
        if nch > 0 do
            var (b2, child_opnd) = lower_expr(b, vec_get_rt(expr.children, 0));
            var (b3, dst) = builder_new_vreg(b2);
            b3 = emit_move(b3, dst, child_opnd);
            b3 = emit_intrinsic(b3, MIR_INTR_CAST, mir_opnd_vreg(dst), mir_opnd_vreg(dst));
            out (b3, mir_opnd_vreg(dst))
        end
    end

    # 13. AwaitExpr — await expr | await pass
    if expr.node_type == AstType.AwaitExpr do
        if rt_streq(expr.name, "pass") do
            var (b2, dst) = builder_new_vreg(b);
            b2 = emit_intrinsic(b2, MIR_INTR_AWAIT_PASS, mir_opnd_vreg(dst), mir_opnd_none());
            out (b2, mir_opnd_vreg(dst))
        end
        nch = vec_len_rt(expr.children);
        if nch > 0 do
            var (b2, child_opnd) = lower_expr(b, vec_get_rt(expr.children, 0));
            var (b3, dst) = builder_new_vreg(b2);
            b3 = emit_intrinsic(b3, MIR_INTR_AWAIT, mir_opnd_vreg(dst), child_opnd);
            out (b3, mir_opnd_vreg(dst))
        end
    end

    # 15. CheckCpu / PatchPoint
    if expr.node_type == AstType.CheckCpu do
        var (b2, dst) = builder_new_vreg(b);
        b2 = emit_intrinsic(b2, MIR_INTR_CHECK_CPU, mir_opnd_vreg(dst), mir_opnd_none());
        out (b2, mir_opnd_vreg(dst))
    end
    if expr.node_type == AstType.PatchPoint do
        var (b1, pid) = builder_intern(b, expr.name);
        var (b2, dst) = builder_new_vreg(b1);
        b2 = emit_intrinsic(b2, MIR_INTR_PATCH_POINT, mir_opnd_vreg(dst), mir_opnd_imm(pid));
        out (b2, mir_opnd_vreg(dst))
    end

    # 14. NamedArg — children[0] is value (name on .name)
    if expr.node_type == AstType.NamedArg do
        nch = vec_len_rt(expr.children);
        if nch > 0 do
            out lower_expr(b, vec_get_rt(expr.children, 0))
        end
    end

    out (b, mir_opnd_none())
end.
func lower_expr(b: MirBuilder, expr: AstNode)
    out lower_expr_impl(b, expr)
end.

func lower_stmt_impl(b: MirBuilder, stmt: AstNode)

    # 1. VarDecl & ConstDecl
    if stmt.node_type == AstType.VarDecl or stmt.node_type == AstType.ConstDecl do
        child_count = vec_len_rt(stmt.children);
        if child_count > 0 do
            expr = vec_get_rt(stmt.children, 0);
            var (b2, val_opnd) = lower_expr(b, expr);
            var (b3, v) = builder_new_vreg(b2);
            ins = MirInstr (
                op: MirOp.Move,
                dst: mir_opnd_vreg(v),
                src1: val_opnd,
                src2: mir_opnd_none()
            );
            b3 = builder_add_instr(b3, ins);
            b3 = set_var_vreg(b3, stmt.name, v);
            out b3
        end
        out b
    end

    # 2. Assign — new vreg (SSA-ready)
    if stmt.node_type == AstType.Assign do
        child_count = vec_len_rt(stmt.children);
        if child_count >= 2 do
            expr = vec_get_rt(stmt.children, 1);
            var (b2, val_opnd) = lower_expr(b, expr);
            var (b3, v) = builder_new_vreg(b2);
            b3 = emit_move(b3, v, val_opnd);
            b3 = set_var_vreg(b3, stmt.name, v);
            out b3
        eif child_count == 1 do
            expr = vec_get_rt(stmt.children, 0);
            var (b2, val_opnd) = lower_expr(b, expr);
            var (b3, v) = builder_new_vreg(b2);
            b3 = emit_move(b3, v, val_opnd);
            b3 = set_var_vreg(b3, stmt.name, v);
            out b3
        end
        out b
    end

    # 2b. IndexAssign — name[idx] = val → INDEX_STORE
    if stmt.node_type == AstType.IndexAssign do
        child_count = vec_len_rt(stmt.children);
        if child_count >= 2 do
            bv = get_var_vreg(b, stmt.name);
            var (b2, idx) = lower_expr(b, vec_get_rt(stmt.children, 0));
            var (b3, val) = lower_expr(b2, vec_get_rt(stmt.children, 1));
            if bv >= 0 do
                b3 = emit_set_arg(b3, 0, idx);
                b3 = emit_set_arg(b3, 1, val);
                b3 = emit_intrinsic(b3, MIR_INTR_INDEX_STORE, mir_opnd_none(), mir_opnd_vreg(bv))
            end
            out b3
        end
        out b
    end

    # 2c. FieldAssign — name.field = val → FIELD_STORE
    if stmt.node_type == AstType.FieldAssign do
        child_count = vec_len_rt(stmt.children);
        if child_count >= 1 do
            bv = get_var_vreg(b, stmt.name);
            var (b1, fid) = builder_intern(b, stmt.name2);
            var (b2, val) = lower_expr(b1, vec_get_rt(stmt.children, 0));
            if bv >= 0 do
                b2 = emit_set_arg(b2, 0, mir_opnd_imm(fid));
                b2 = emit_set_arg(b2, 1, val);
                b2 = emit_intrinsic(b2, MIR_INTR_FIELD_STORE, mir_opnd_none(), mir_opnd_vreg(bv))
            end
            out b2
        end
        out b
    end

    # 3. IfStmt
    if stmt.node_type == AstType.IfStmt do
        cond_expr = vec_get_rt(stmt.children, 0);
        then_block = vec_get_rt(stmt.children, 1);
        var (b2, cond_opnd) = lower_expr(b, cond_expr);
        var (b3, then_id) = builder_add_block(b2);
        var (b4, end_id) = builder_add_block(b3);
        else_id = end_id;
        has_else = vec_len_rt(stmt.children) > 2;
        if has_else do
            var (b4_2, else_id_2) = builder_add_block(b4);
            b4 = b4_2;
            else_id = else_id_2
        end
        b4 = emit_jump_if(b4, cond_opnd, then_id, else_id);
        b4.current_block = then_id;
        b4 = lower_stmt(b4, then_block);
        b4 = emit_jump(b4, end_id);
        if has_else do
            else_block = vec_get_rt(stmt.children, 2);
            b4.current_block = else_id;
            b4 = lower_stmt(b4, else_block);
            b4 = emit_jump(b4, end_id)
        end
        b4.current_block = end_id;
        out b4
    end

    # 4. WhileStmt — JumpIfNot(cond, end) else Jump(body)
    if stmt.node_type == AstType.WhileStmt do
        cond_expr = vec_get_rt(stmt.children, 0);
        body_block = vec_get_rt(stmt.children, 1);
        var (b2, cond_id) = builder_add_block(b);
        var (b3, body_id) = builder_add_block(b2);
        var (b4, end_id) = builder_add_block(b3);
        b4 = emit_jump(b4, cond_id);
        b4 = builder_push_loop(b4, end_id, cond_id);
        b4.current_block = cond_id;
        var (b5, cond_opnd) = lower_expr(b4, cond_expr);
        b5 = emit_jump_if_not(b5, cond_opnd, end_id, body_id);
        b5.current_block = body_id;
        b5 = lower_stmt(b5, body_block);
        b5 = emit_jump(b5, cond_id);
        b5 = builder_pop_loop(b5);
        b5.current_block = end_id;
        out b5
    end

    # 4b. LoopStmt — counted: i in 0..count
    if stmt.node_type == AstType.LoopStmt do
        count_expr = vec_get_rt(stmt.children, 0);
        body_block = vec_get_rt(stmt.children, 1);
        var (b2, count_opnd) = lower_expr(b, count_expr);
        var (b3, iv) = builder_new_vreg(b2);
        ins0 = MirInstr (
            op: MirOp.Move,
            dst: mir_opnd_vreg(iv),
            src1: mir_opnd_imm(0),
            src2: mir_opnd_none()
        );
        b3 = builder_add_instr(b3, ins0);
        var (b4, cond_id) = builder_add_block(b3);
        var (b5, body_id) = builder_add_block(b4);
        var (b6, end_id) = builder_add_block(b5);
        var (b7, step_id) = builder_add_block(b6);
        b7 = emit_jump(b7, cond_id);
        b7 = builder_push_loop(b7, end_id, step_id);
        b7.current_block = cond_id;
        var (b8, cmpv) = builder_new_vreg(b7);
        insc = MirInstr (
            op: MirOp.CmpLt,
            dst: mir_opnd_vreg(cmpv),
            src1: mir_opnd_vreg(iv),
            src2: count_opnd
        );
        b8 = builder_add_instr(b8, insc);
        b8 = emit_jump_if_not(b8, mir_opnd_vreg(cmpv), end_id, body_id);
        b8.current_block = body_id;
        b8 = lower_stmt(b8, body_block);
        b8 = emit_jump(b8, step_id);
        b8.current_block = step_id;
        # Non-SSA induction: redefine same vreg (SSA rename comes later).
        var (b9, iv2) = builder_new_vreg(b8);
        ins1 = MirInstr (
            op: MirOp.Add,
            dst: mir_opnd_vreg(iv2),
            src1: mir_opnd_vreg(iv),
            src2: mir_opnd_imm(1)
        );
        b9 = builder_add_instr(b9, ins1);
        insm = MirInstr (
            op: MirOp.Move,
            dst: mir_opnd_vreg(iv),
            src1: mir_opnd_vreg(iv2),
            src2: mir_opnd_none()
        );
        b9 = builder_add_instr(b9, insm);
        b9 = emit_jump(b9, cond_id);
        b9 = builder_pop_loop(b9);
        b9.current_block = end_id;
        out b9
    end

    # 5. Block
    if stmt.node_type == AstType.Block do
        child_count = vec_len_rt(stmt.children);
        var i = 0;
        b_mut = b;
        when i < child_count loop
            child = vec_get_rt(stmt.children, i);
            b_mut = lower_stmt(b_mut, child);
            i = i + 1
        end
        out b_mut
    end

    # 6. ReturnStmt
    if stmt.node_type == AstType.ReturnStmt do
        child_count = vec_len_rt(stmt.children);
        if child_count > 0 do
            var (b2, ret_opnd) = lower_expr(b, vec_get_rt(stmt.children, 0));
            ins = MirInstr (
                op: MirOp.Return,
                dst: mir_opnd_none(),
                src1: ret_opnd,
                src2: mir_opnd_none()
            );
            b2 = builder_add_instr(b2, ins);
            out b2
        else
            ins = MirInstr (
                op: MirOp.Return,
                dst: mir_opnd_none(),
                src1: mir_opnd_none(),
                src2: mir_opnd_none()
            );
            b2 = builder_add_instr(b, ins);
            out b2
        end
    end

    # 7. PrintStmt
    if stmt.node_type == AstType.PrintStmt do
        child_count = vec_len_rt(stmt.children);
        if child_count > 0 do
            expr = vec_get_rt(stmt.children, 0);
            var (b2, val_opnd) = lower_expr(b, expr);
            b2 = emit_intrinsic(b2, MIR_INTR_PRINT, mir_opnd_none(), val_opnd);
            out b2
        end
        out b
    end

    # 8. Break / Continue
    if stmt.node_type == AstType.BreakStmt do
        lt = builder_loop_top(b);
        if lt.break_block >= 0 do
            out emit_jump(b, lt.break_block)
        end
        out b
    end
    if stmt.node_type == AstType.ContinueStmt do
        lt = builder_loop_top(b);
        if lt.continue_block >= 0 do
            out emit_jump(b, lt.continue_block)
        end
        out b
    end

    # 9. CaseExpr — children: [target, pat, body, pat, body, ...]
    if stmt.node_type == AstType.CaseExpr do
        child_count = vec_len_rt(stmt.children);
        if child_count >= 1 do
            target_expr = vec_get_rt(stmt.children, 0);
            var (b2, target_opnd) = lower_expr(b, target_expr);
            var (b3, end_id) = builder_add_block(b2);
            var i = 1;
            b_mut = b3;
            when i + 1 < child_count loop
                pat = vec_get_rt(stmt.children, i);
                body = vec_get_rt(stmt.children, i + 1);
                var (b4, arm_id) = builder_add_block(b_mut);
                var (b5, next_id) = builder_add_block(b4);
                # Wildcard / else
                is_wild = 0;
                if pat.node_type == AstType.Identifier do
                    if rt_streq(pat.name, "_") do
                        is_wild = 1
                    end
                    if pat.int_val == 0 - 1 do
                        is_wild = 1
                    end
                end
                if is_wild != 0 do
                    b5 = emit_jump(b5, arm_id)
                eif pat.node_type == AstType.LiteralInt do
                    var (b6, cv) = builder_new_vreg(b5);
                    insc = MirInstr (
                        op: MirOp.CmpEq,
                        dst: mir_opnd_vreg(cv),
                        src1: target_opnd,
                        src2: mir_opnd_imm(pat.int_val)
                    );
                    b6 = builder_add_instr(b6, insc);
                    b5 = emit_jump_if(b6, mir_opnd_vreg(cv), arm_id, next_id)
                eif pat.node_type == AstType.Identifier and rt_streq(pat.name, "true") do
                    var (b6, cv) = builder_new_vreg(b5);
                    insc = MirInstr (
                        op: MirOp.CmpEq,
                        dst: mir_opnd_vreg(cv),
                        src1: target_opnd,
                        src2: mir_opnd_imm(1)
                    );
                    b6 = builder_add_instr(b6, insc);
                    b5 = emit_jump_if(b6, mir_opnd_vreg(cv), arm_id, next_id)
                eif pat.node_type == AstType.Identifier and rt_streq(pat.name, "false") do
                    var (b6, cv) = builder_new_vreg(b5);
                    insc = MirInstr (
                        op: MirOp.CmpEq,
                        dst: mir_opnd_vreg(cv),
                        src1: target_opnd,
                        src2: mir_opnd_imm(0)
                    );
                    b6 = builder_add_instr(b6, insc);
                    b5 = emit_jump_if(b6, mir_opnd_vreg(cv), arm_id, next_id)
                eif pat.node_type == AstType.LiteralStr do
                    var (b5b, pid) = builder_intern(b5, pat.name);
                    b5b = emit_set_arg(b5b, 0, mir_opnd_imm(pid));
                    var (b6, cv) = builder_new_vreg(b5b);
                    b6 = emit_intrinsic(b6, MIR_INTR_STR_EQ, mir_opnd_vreg(cv), target_opnd);
                    b5 = emit_jump_if(b6, mir_opnd_vreg(cv), arm_id, next_id)
                else
                    # Tagged / other — pool id in SetArg0, then MATCH_PAT
                    var (b5b, pid) = builder_intern(b5, pat.name);
                    b5b = emit_set_arg(b5b, 0, mir_opnd_imm(pid));
                    var (b6, cv) = builder_new_vreg(b5b);
                    b6 = emit_intrinsic(b6, MIR_INTR_MATCH_PAT, mir_opnd_vreg(cv), target_opnd);
                    b5 = emit_jump_if(b6, mir_opnd_vreg(cv), arm_id, next_id)
                end
                b5.current_block = arm_id;
                b5 = lower_stmt(b5, body);
                b5 = emit_jump(b5, end_id);
                b5.current_block = next_id;
                b_mut = b5;
                i = i + 2
            end
            # Fallthrough if no arm matched → end
            b_mut = emit_jump(b_mut, end_id);
            b_mut.current_block = end_id;
            out b_mut
        end
        out b
    end

    # 10. ForRange — name=var, children=[start, end, body]
    if stmt.node_type == AstType.ForRange do
        child_count = vec_len_rt(stmt.children);
        if child_count >= 3 do
            start_expr = vec_get_rt(stmt.children, 0);
            end_expr = vec_get_rt(stmt.children, 1);
            body_stmt = vec_get_rt(stmt.children, 2);
            var (b2, start_opnd) = lower_expr(b, start_expr);
            var (b3, end_opnd) = lower_expr(b2, end_expr);
            var (b4, iv) = builder_new_vreg(b3);
            ins0 = MirInstr (
                op: MirOp.Move,
                dst: mir_opnd_vreg(iv),
                src1: start_opnd,
                src2: mir_opnd_none()
            );
            b4 = builder_add_instr(b4, ins0);
            b4 = set_var_vreg(b4, stmt.name, iv);
            var (b5, cond_id) = builder_add_block(b4);
            var (b6, body_id) = builder_add_block(b5);
            var (b7, end_id) = builder_add_block(b6);
            var (b8, step_id) = builder_add_block(b7);
            b8 = emit_jump(b8, cond_id);
            b8 = builder_push_loop(b8, end_id, step_id);
            b8.current_block = cond_id;
            # Re-read iv from var_map (may be updated each iter after SSA-ish Move)
            iv_cur = get_var_vreg(b8, stmt.name);
            var (b9, cmpv) = builder_new_vreg(b8);
            insc = MirInstr (
                op: MirOp.CmpLt,
                dst: mir_opnd_vreg(cmpv),
                src1: mir_opnd_vreg(iv_cur),
                src2: end_opnd
            );
            b9 = builder_add_instr(b9, insc);
            b9 = emit_jump_if_not(b9, mir_opnd_vreg(cmpv), end_id, body_id);
            b9.current_block = body_id;
            b9 = lower_stmt(b9, body_stmt);
            b9 = emit_jump(b9, step_id);
            b9.current_block = step_id;
            iv_cur2 = get_var_vreg(b9, stmt.name);
            var (b10, ivn) = builder_new_vreg(b9);
            ins1 = MirInstr (
                op: MirOp.Add,
                dst: mir_opnd_vreg(ivn),
                src1: mir_opnd_vreg(iv_cur2),
                src2: mir_opnd_imm(1)
            );
            b10 = builder_add_instr(b10, ins1);
            b10 = set_var_vreg(b10, stmt.name, ivn);
            b10 = emit_jump(b10, cond_id);
            b10 = builder_pop_loop(b10);
            b10.current_block = end_id;
            out b10
        end
        out b
    end

    # 11. EnsureBlock / RevertBlock — marker + body
    if stmt.node_type == AstType.EnsureBlock do
        b = emit_intrinsic(b, MIR_INTR_ENSURE, mir_opnd_none(), mir_opnd_none());
        if vec_len_rt(stmt.children) > 0 do
            out lower_stmt(b, vec_get_rt(stmt.children, 0))
        end
        out b
    end
    if stmt.node_type == AstType.RevertBlock do
        b = emit_intrinsic(b, MIR_INTR_REVERT, mir_opnd_none(), mir_opnd_none());
        if vec_len_rt(stmt.children) > 0 do
            out lower_stmt(b, vec_get_rt(stmt.children, 0))
        end
        out b
    end

    # 12. WhenStmt — same CFG as While (JumpIfNot)
    if stmt.node_type == AstType.WhenStmt do
        cond_expr = vec_get_rt(stmt.children, 0);
        body_block = vec_get_rt(stmt.children, 1);
        var (b2, cond_id) = builder_add_block(b);
        var (b3, body_id) = builder_add_block(b2);
        var (b4, end_id) = builder_add_block(b3);
        b4 = emit_jump(b4, cond_id);
        b4 = builder_push_loop(b4, end_id, cond_id);
        b4.current_block = cond_id;
        var (b5, cond_opnd) = lower_expr(b4, cond_expr);
        b5 = emit_jump_if_not(b5, cond_opnd, end_id, body_id);
        b5.current_block = body_id;
        b5 = lower_stmt(b5, body_block);
        b5 = emit_jump(b5, cond_id);
        b5 = builder_pop_loop(b5);
        b5.current_block = end_id;
        out b5
    end

    # 13. Throw / Cancel / Quiet
    if stmt.node_type == AstType.ThrowStmt do
        if vec_len_rt(stmt.children) > 0 do
            var (b2, v) = lower_expr(b, vec_get_rt(stmt.children, 0));
            out emit_intrinsic(b2, MIR_INTR_THROW, mir_opnd_none(), v)
        end
        out emit_intrinsic(b, MIR_INTR_THROW, mir_opnd_none(), mir_opnd_none())
    end
    if stmt.node_type == AstType.CancelStmt do
        if vec_len_rt(stmt.children) > 0 do
            var (b2, v) = lower_expr(b, vec_get_rt(stmt.children, 0));
            out emit_intrinsic(b2, MIR_INTR_CANCEL, mir_opnd_none(), v)
        end
        out emit_intrinsic(b, MIR_INTR_CANCEL, mir_opnd_none(), mir_opnd_none())
    end
    if stmt.node_type == AstType.QuietStmt do
        if vec_len_rt(stmt.children) > 0 do
            var (b2, _) = lower_expr(b, vec_get_rt(stmt.children, 0));
            out emit_intrinsic(b2, MIR_INTR_QUIET, mir_opnd_none(), mir_opnd_none())
        end
        out b
    end

    # 14. ArenaBlock — marker + body
    if stmt.node_type == AstType.ArenaBlock do
        var (b1, aid) = builder_intern(b, stmt.name);
        b1 = emit_intrinsic(b1, MIR_INTR_ARENA, mir_opnd_none(), mir_opnd_imm(aid));
        if vec_len_rt(stmt.children) > 0 do
            out lower_stmt(b1, vec_get_rt(stmt.children, 0))
        end
        out b1
    end

    # 14b. Emit / Select / Try / Resume / Infer / Train
    if stmt.node_type == AstType.EmitStmt do
        if vec_len_rt(stmt.children) > 0 do
            var (b2, v) = lower_expr(b, vec_get_rt(stmt.children, 0));
            out emit_intrinsic(b2, MIR_INTR_EMIT, mir_opnd_none(), v)
        end
        out emit_intrinsic(b, MIR_INTR_EMIT, mir_opnd_none(), mir_opnd_none())
    end
    if stmt.node_type == AstType.SelectStmt do
        b = emit_intrinsic(b, MIR_INTR_SELECT, mir_opnd_none(), mir_opnd_none());
        if vec_len_rt(stmt.children) > 0 do
            out lower_stmt(b, vec_get_rt(stmt.children, 0))
        end
        out b
    end
    if stmt.node_type == AstType.TryStmt do
        b = emit_intrinsic(b, MIR_INTR_TRY, mir_opnd_none(), mir_opnd_none());
        nch = vec_len_rt(stmt.children);
        var ti = 0;
        when ti < nch loop
            ch = vec_get_rt(stmt.children, ti);
            if ch.node_type == AstType.TimeoutClause do
                if vec_len_rt(ch.children) > 0 do
                    var (b2, v) = lower_expr(b, vec_get_rt(ch.children, 0));
                    b = emit_intrinsic(b2, MIR_INTR_TIMEOUT, mir_opnd_none(), v)
                else
                    b = emit_intrinsic(b, MIR_INTR_TIMEOUT, mir_opnd_none(), mir_opnd_none())
                end
            eif ch.node_type == AstType.IsolateClause do
                b = emit_intrinsic(b, MIR_INTR_ISOLATE, mir_opnd_none(), mir_opnd_none());
                if vec_len_rt(ch.children) > 0 do
                    # isolate: [vars] expr OR isolate: block body
                    c0 = vec_get_rt(ch.children, 0);
                    if c0.node_type == AstType.Block do
                        b = lower_stmt(b, c0)
                    else
                        var (b2, _) = lower_expr(b, c0);
                        b = b2
                    end
                end
            eif ch.node_type == AstType.RevertBlock do
                b = emit_intrinsic(b, MIR_INTR_REVERT, mir_opnd_none(), mir_opnd_none());
                b = lower_stmt(b, ch)
            else
                # try body (Block) or nested stmt
                b = lower_stmt(b, ch)
            end
            ti = ti + 1
        end
        out b
    end
    if stmt.node_type == AstType.TimeoutClause do
        if vec_len_rt(stmt.children) > 0 do
            var (b2, v) = lower_expr(b, vec_get_rt(stmt.children, 0));
            out emit_intrinsic(b2, MIR_INTR_TIMEOUT, mir_opnd_none(), v)
        end
        out emit_intrinsic(b, MIR_INTR_TIMEOUT, mir_opnd_none(), mir_opnd_none())
    end
    if stmt.node_type == AstType.IsolateClause do
        b = emit_intrinsic(b, MIR_INTR_ISOLATE, mir_opnd_none(), mir_opnd_none());
        if vec_len_rt(stmt.children) > 0 do
            c0 = vec_get_rt(stmt.children, 0);
            if c0.node_type == AstType.Block do
                out lower_stmt(b, c0)
            end
            var (b2, _) = lower_expr(b, c0);
            out b2
        end
        out b
    end
    if stmt.node_type == AstType.ResumeStmt do
        var (b1, rid) = builder_intern(b, stmt.name);
        out emit_intrinsic(b1, MIR_INTR_RESUME, mir_opnd_none(), mir_opnd_imm(rid))
    end
    if stmt.node_type == AstType.InferBlock do
        b = emit_intrinsic(b, MIR_INTR_INFER, mir_opnd_none(), mir_opnd_none());
        if vec_len_rt(stmt.children) > 0 do
            out lower_stmt(b, vec_get_rt(stmt.children, 0))
        end
        out b
    end
    if stmt.node_type == AstType.TrainBlock do
        b = emit_intrinsic(b, MIR_INTR_TRAIN, mir_opnd_none(), mir_opnd_none());
        if vec_len_rt(stmt.children) > 0 do
            out lower_stmt(b, vec_get_rt(stmt.children, 0))
        end
        out b
    end
    if stmt.node_type == AstType.PrecompBlock do
        b = emit_intrinsic(b, MIR_INTR_PRECOMP, mir_opnd_none(), mir_opnd_none());
        if vec_len_rt(stmt.children) > 0 do
            out lower_stmt(b, vec_get_rt(stmt.children, 0))
        end
        out b
    end
    if stmt.node_type == AstType.AtomicVarDecl do
        b = emit_intrinsic(b, MIR_INTR_ATOMIC_VAR, mir_opnd_none(), mir_opnd_none());
        if vec_len_rt(stmt.children) > 0 do
            out lower_stmt(b, vec_get_rt(stmt.children, 0))
        end
        out b
    end
    if stmt.node_type == AstType.ReactiveDecl do
        var (b1, nid) = builder_intern(b, stmt.name);
        b1 = emit_set_arg(b1, 0, mir_opnd_imm(nid));
        b1 = emit_intrinsic(b1, MIR_INTR_REACTIVE, mir_opnd_none(), mir_opnd_imm(nid));
        if vec_len_rt(stmt.children) > 0 do
            var (b2, _) = lower_expr(b1, vec_get_rt(stmt.children, 0));
            out b2
        end
        out b1
    end
    if stmt.node_type == AstType.MorphDecl do
        var (b1, nid) = builder_intern(b, stmt.name);
        b1 = emit_set_arg(b1, 0, mir_opnd_imm(nid));
        b1 = emit_intrinsic(b1, MIR_INTR_MORPH, mir_opnd_none(), mir_opnd_imm(nid));
        if vec_len_rt(stmt.children) > 0 do
            var (b2, _) = lower_expr(b1, vec_get_rt(stmt.children, 0));
            out b2
        end
        out b1
    end
    if stmt.node_type == AstType.ExposeAttr do
        b = emit_intrinsic(b, MIR_INTR_EXPOSE, mir_opnd_none(), mir_opnd_none());
        if vec_len_rt(stmt.children) > 0 do
            out lower_stmt(b, vec_get_rt(stmt.children, 0))
        end
        out b
    end
    # Decl-style stmts inside functions → DECL markers
    if stmt.node_type == AstType.TypeAlias or stmt.node_type == AstType.LazyIncludeStmt or stmt.node_type == AstType.ShareDecl or stmt.node_type == AstType.HasDecl or stmt.node_type == AstType.ClassDef or stmt.node_type == AstType.DictDecl or stmt.node_type == AstType.TensorDecl or stmt.node_type == AstType.FluxDecl do
        out lower_decl_marker(b, stmt)
    end
    if stmt.node_type == AstType.BundleExpr or stmt.node_type == AstType.MapExpr or stmt.node_type == AstType.ArrCompactExpr or stmt.node_type == AstType.ErrorExpr or stmt.node_type == AstType.PtrTypeExpr or stmt.node_type == AstType.ExistExpr or stmt.node_type == AstType.PatternExpr or stmt.node_type == AstType.AddrOf or stmt.node_type == AstType.ErxExpr do
        var (b2, _) = lower_expr(b, stmt);
        out b2
    end

    # 15. Expr-as-stmt
    if stmt.node_type == AstType.Call or stmt.node_type == AstType.BuiltinCall or stmt.node_type == AstType.MethodCall or stmt.node_type == AstType.AwaitExpr or stmt.node_type == AstType.TaskExpr or stmt.node_type == AstType.WaitExpr or stmt.node_type == AstType.QuantizeExpr do
        var (b2, _) = lower_expr(b, stmt);
        out b2
    end

    out b
end.
func lower_stmt(b: MirBuilder, stmt: AstNode)
    out lower_stmt_impl(b, stmt)
end.

func ast_lower_func(func_id: int, ast_func: AstNode)
    b = builder_new(func_id, ast_func.name);
    # Modifiers carried in name2: async / precomp / method
    if rt_streq(ast_func.name2, "async") do
        b = emit_intrinsic(b, MIR_INTR_ASYNC, mir_opnd_none(), mir_opnd_none())
    end
    if rt_streq(ast_func.name2, "precomp") do
        b = emit_intrinsic(b, MIR_INTR_PRECOMP, mir_opnd_none(), mir_opnd_none())
    end
    if rt_streq(ast_func.name2, "method") do
        var (b1, mid) = builder_intern(b, "method");
        b = emit_intrinsic(b1, MIR_INTR_DECL, mir_opnd_none(), mir_opnd_imm(AstType.MethodCall as i64))
    end
    child_count = vec_len_rt(ast_func.children);
    if child_count > 0 do
        last_idx = child_count - 1;
        # Params: all children except trailing body block
        var pi = 0;
        when pi < last_idx loop
            param = vec_get_rt(ast_func.children, pi);
            if param.node_type == AstType.Identifier or param.node_type == AstType.RefParam do
                var (b2, pv) = builder_new_vreg(b);
                # Param vregs are definition sites; ABI binding is backend concern.
                b = set_var_vreg(b2, param.name, pv)
            end
            pi = pi + 1
        end
        body = vec_get_rt(ast_func.children, last_idx);
        b = lower_stmt(b, body)
    end
    b.func_obj.next_vreg = b.vreg_counter;
    out b.func_obj
end.
func lower_decl_marker(b: MirBuilder, node: AstNode)
    # Decl-only nodes: Intrinsic DECL so later MIR_/linker sees the name.
    var (b1, nid) = builder_intern(b, node.name);
    b1 = emit_set_arg(b1, 0, mir_opnd_imm(nid));
    out emit_intrinsic(b1, MIR_INTR_DECL, mir_opnd_none(), mir_opnd_imm(node.node_type as i64))
end.

func ast_lower_program(prog: AstNode)
    mir_funcs = vec_new_rt();
    # Synthetic module-init func holds decl markers (Enum/Entity/Import/…).
    init_b = builder_new(0 - 1, "__mir_decls");
    child_count = vec_len_rt(prog.children);
    var i = 0;
    when i < child_count loop
        child = vec_get_rt(prog.children, i);
        if child.node_type == AstType.FuncDef or child.node_type == AstType.ExternFunc do
            m_func = ast_lower_func(i, child);
            mir_funcs = vec_push_rt(mir_funcs, m_func)
        eif child.node_type == AstType.ExposeAttr or child.node_type == AstType.BindAttr do
            # @bind / expose wrap a declaration — marker + lower inner FuncDef if present
            if child.node_type == AstType.ExposeAttr do
                init_b = emit_intrinsic(init_b, MIR_INTR_EXPOSE, mir_opnd_none(), mir_opnd_none())
            else
                init_b = lower_decl_marker(init_b, child)
            end
            if vec_len_rt(child.children) > 0 do
                inner = vec_get_rt(child.children, 0);
                if inner.node_type == AstType.FuncDef or inner.node_type == AstType.ExternFunc do
                    m_func = ast_lower_func(i, inner);
                    mir_funcs = vec_push_rt(mir_funcs, m_func)
                eif inner.node_type == AstType.EnumDef or inner.node_type == AstType.EntityDef or inner.node_type == AstType.ClassDef or inner.node_type == AstType.VarDecl or inner.node_type == AstType.ConstDecl do
                    if inner.node_type == AstType.VarDecl or inner.node_type == AstType.ConstDecl do
                        init_b = lower_stmt(init_b, inner)
                    else
                        init_b = lower_decl_marker(init_b, inner)
                    end
                end
            end
        eif child.node_type == AstType.EnumDef or child.node_type == AstType.EntityDef or child.node_type == AstType.ImportStmt or child.node_type == AstType.ModuleStmt or child.node_type == AstType.ExportStmt or child.node_type == AstType.IncludeStmt or child.node_type == AstType.PackedDef or child.node_type == AstType.RegisterDef or child.node_type == AstType.TypeAlias or child.node_type == AstType.LazyIncludeStmt or child.node_type == AstType.ShareDecl or child.node_type == AstType.HasDecl or child.node_type == AstType.ClassDef or child.node_type == AstType.DictDecl or child.node_type == AstType.TensorDecl or child.node_type == AstType.FluxDecl do
            init_b = lower_decl_marker(init_b, child)
        eif child.node_type == AstType.PrecompBlock do
            init_b = emit_intrinsic(init_b, MIR_INTR_PRECOMP, mir_opnd_none(), mir_opnd_none());
            if vec_len_rt(child.children) > 0 do
                init_b = lower_stmt(init_b, vec_get_rt(child.children, 0))
            end
        eif child.node_type == AstType.ReactiveDecl do
            var (b1, nid) = builder_intern(init_b, child.name);
            init_b = emit_set_arg(b1, 0, mir_opnd_imm(nid));
            init_b = emit_intrinsic(init_b, MIR_INTR_REACTIVE, mir_opnd_none(), mir_opnd_imm(nid))
        eif child.node_type == AstType.MorphDecl do
            var (b1, nid) = builder_intern(init_b, child.name);
            init_b = emit_set_arg(b1, 0, mir_opnd_imm(nid));
            init_b = emit_intrinsic(init_b, MIR_INTR_MORPH, mir_opnd_none(), mir_opnd_imm(nid))
        eif child.node_type == AstType.AtomicVarDecl do
            init_b = emit_intrinsic(init_b, MIR_INTR_ATOMIC_VAR, mir_opnd_none(), mir_opnd_none());
            if vec_len_rt(child.children) > 0 do
                init_b = lower_stmt(init_b, vec_get_rt(child.children, 0))
            end
        eif child.node_type == AstType.CheckCpu do
            init_b = emit_intrinsic(init_b, MIR_INTR_CHECK_CPU, mir_opnd_none(), mir_opnd_none())
        eif child.node_type == AstType.PatchPoint do
            var (b1, pid) = builder_intern(init_b, child.name);
            init_b = b1;
            init_b = emit_intrinsic(init_b, MIR_INTR_PATCH_POINT, mir_opnd_none(), mir_opnd_imm(pid))
        eif child.node_type == AstType.VarDecl or child.node_type == AstType.ConstDecl do
            init_b = lower_stmt(init_b, child)
        end
        i = i + 1
    end
    init_b.func_obj.next_vreg = init_b.vreg_counter;
    blk0 = vec_get_rt(init_b.func_obj.blocks, 0);
    if vec_len_rt(blk0.head) > 0 do
        mir_funcs = vec_push_rt(mir_funcs, init_b.func_obj)
    end
    out mir_funcs
end.

export ast_lower_program, ast_lower_func, name_hash_bucket, get_var_vreg, set_var_vreg, emit_jump, emit_jump_if, emit_jump_if_not, emit_set_arg, emit_intrinsic, emit_move, emit_load, emit_store, lower_aggregate, MIR_VAR_BUCKETS
