##
 * vir/compiler/ast_to_mir.vri — AST to MIR Lowering
 * ==============================================================
 * Flattens the AST (Nested structures, While/If) into
 * Mid-Level IR (MIR) Basic Blocks and Control Flow Graph.
 * Maps local variables to Virtual Registers.
 ##

include types;
include vec_rt;
import vec_new_rt, vec_push_rt, vec_get_rt, vec_set_rt, vec_len_rt from vec_rt;
include string_rt;
import rt_streq from string_rt;

include parser;
import AstNode, AstType, OpType from parser;

include mir;
import MirFunc, MirBlock, MirInstr, MirOp, MirOperand, MirOperandType, mir_opnd_none, mir_opnd_vreg, mir_opnd_imm from mir;

entity VarMap:
    name: string;
    vreg: i64
end.

entity MirBuilder:
    func_obj: MirFunc;
    current_block: i64;
    vreg_counter: i64;
    var_map: i64;      # Vec<VarMap>
end.

func builder_new(func_id: i64):
    f = MirFunc (
        id: func_id,
        blocks: vec_new_rt(),
        max_vreg: 0
    );
    
    # Create entry block
    b0 = MirBlock (
        id: 0,
        head: vec_new_rt(),
        phis: -1,
        successors: vec_new_rt(),
        predecessors: vec_new_rt()
    );
    f.blocks = vec_push_rt(f.blocks, b0);
    
    out MirBuilder (
        func_obj: f,
        current_block: 0,
        vreg_counter: 0,
        var_map: vec_new_rt()
    )
end.

func builder_new_vreg(b: MirBuilder):
    reg = b.vreg_counter;
    b.vreg_counter = b.vreg_counter + 1;
    out (b, reg)
end.

func builder_add_block(b: MirBuilder):
    id = vec_len_rt(b.func_obj.blocks);
    blk = MirBlock (
        id: id,
        head: vec_new_rt(),
        phis: -1,
        successors: vec_new_rt(),
        predecessors: vec_new_rt()
    );
    b.func_obj.blocks = vec_push_rt(b.func_obj.blocks, blk);
    out (b, id)
end.

func builder_add_instr(b: MirBuilder, instr: MirInstr):
    if b.current_block >= 0 do
        blk = vec_get_rt(b.func_obj.blocks, b.current_block);
        blk.head = vec_push_rt(blk.head, instr);
        vec_set_rt(b.func_obj.blocks, b.current_block, blk)
    end.
    out b
end.

func builder_add_edge(b: MirBuilder, from_b: i64, to_b: i64):
    if from_b >= 0 and to_b >= 0 do
        src = vec_get_rt(b.func_obj.blocks, from_b);
        dst = vec_get_rt(b.func_obj.blocks, to_b);
        
        src.successors = vec_push_rt(src.successors, to_b);
        dst.predecessors = vec_push_rt(dst.predecessors, from_b);
        
        vec_set_rt(b.func_obj.blocks, from_b, src);
        vec_set_rt(b.func_obj.blocks, to_b, dst)
    end.
    out b
end.

func get_var_vreg(b: MirBuilder, name: string):
    i = 0;
    n = vec_len_rt(b.var_map);
    when i < n loop
        vm = vec_get_rt(b.var_map, i);
        if rt_streq(vm.name, name) do
            out vm.vreg
        end.
        i = i + 1
    end.
    out -1
end.

func set_var_vreg(b: MirBuilder, name: string, vreg: i64):
    i = 0;
    n = vec_len_rt(b.var_map);
    found = false;
    when i < n loop
        vm = vec_get_rt(b.var_map, i);
        if rt_streq(vm.name, name) do
            vm.vreg = vreg;
            vec_set_rt(b.var_map, i, vm);
            found = true;
            i = n; # break
        end.
        i = i + 1
    end.
    
    if found == false do
        vm = VarMap ( name: name, vreg: vreg );
        b.var_map = vec_push_rt(b.var_map, vm)
    end.
    out b
end.

# Pre-declare recursive
func lower_stmt(b: MirBuilder; stmt: AstNode);
func lower_expr(b: MirBuilder; expr: AstNode);

# Lower Expression
func lower_expr_impl(b: MirBuilder, expr: AstNode):
    if expr.node_type == AstType.LiteralInt do
        var (b2, v) = builder_new_vreg(b);
        ins = MirInstr (
            op: MirOp.Move,
            dst: mir_opnd_vreg(v),
            src1: mir_opnd_imm(expr.int_val),
            src2: mir_opnd_none()
        );
        b2 = builder_add_instr(b2, ins);
        out (b2, mir_opnd_vreg(v));
        
    eif expr.node_type == AstType.Identifier do
        v = get_var_vreg(b, expr.name);
        if v >= 0 do
            out (b, mir_opnd_vreg(v));
        else
            out (b, mir_opnd_none()); # Error: undefined var
        end.
        
    eif expr.node_type == AstType.BinOp do
        left = vec_get_rt(expr.children, 0);
        right = vec_get_rt(expr.children, 1);
        var (b3, opnd_l) = lower_expr(b, left);
        var (b4, opnd_r) = lower_expr(b3, right);
        
        m_op = MirOp.Add;
        if expr.op == OpType.Add do m_op = MirOp.Add end.
        if expr.op == OpType.Sub do m_op = MirOp.Sub end.
        if expr.op == OpType.Mul do m_op = MirOp.Mul end.
        if expr.op == OpType.Div do m_op = MirOp.Div end.
        
        var (b5, dst) = builder_new_vreg(b4);
        ins = MirInstr (
            op: m_op,
            dst: mir_opnd_vreg(dst),
            src1: opnd_l,
            src2: opnd_r
        );
        b5 = builder_add_instr(b5, ins);
        out (b5, mir_opnd_vreg(dst))
    end.
    
    out (b, mir_opnd_none())
end.

func lower_expr(b: MirBuilder, expr: AstNode):
    out lower_expr_impl(b, expr)
end.

# Lower Statement
func lower_stmt_impl(b: MirBuilder, stmt: AstNode):
    if stmt.node_type == AstType.VarDecl do
        expr = vec_get_rt(stmt.children, 0);
        var (b2, val_opnd) = lower_expr(b, expr);
        
        var (b3, v) = builder_new_vreg(b2);
        ins = MirInstr (
            op: MirOp.Move,
            dst: mir_opnd_vreg(v),
            src1: val_opnd,
            src2: mir_opnd_none()
        );
        b3 = builder_add_instr(b3, ins);
        b3 = set_var_vreg(b3, stmt.name, v);
        out b3;
        
    eif stmt.node_type == AstType.Assign do
        # We model assignment by creating a new VReg and moving the value.
        # The Variable Renaming pass in SSA will link this up perfectly.
        expr = vec_get_rt(stmt.children, 0);
        var (b2, val_opnd) = lower_expr(b, expr);
        
        var (b3, v) = builder_new_vreg(b2);
        ins = MirInstr (
            op: MirOp.Move,
            dst: mir_opnd_vreg(v),
            src1: val_opnd,
            src2: mir_opnd_none()
        );
        b3 = builder_add_instr(b3, ins);
        b3 = set_var_vreg(b3, stmt.name, v);
        out b3;
        
    eif stmt.node_type == AstType.IfStmt do
        cond_expr = vec_get_rt(stmt.children, 0);
        then_block = vec_get_rt(stmt.children, 1);
        
        var (b2, cond_opnd) = lower_expr(b, cond_expr);
        
        var (b3, then_id) = builder_add_block(b2);
        var (b4, end_id) = builder_add_block(b3);
        
        else_id = end_id;
        has_else = false;
        if vec_len_rt(stmt.children) > 2 do
            has_else = true;
            var (b4_2, else_id_2) = builder_add_block(b4);
            b4 = b4_2;
            else_id = else_id_2
        end.
        
        # Branch
        ins = MirInstr (
            op: MirOp.JumpIf,
            dst: mir_opnd_none(),
            src1: cond_opnd,
            src2: mir_opnd_imm(then_id)
            # We need a 3rd operand for else_id, but MirInstr has 2.
            # In MIR, JumpIf jumps to src2 if src1 is true, and fallthrough otherwise.
            # So we append a Jump right after JumpIf.
        );
        b4 = builder_add_instr(b4, ins);
        
        ins_jmp = MirInstr (
            op: MirOp.Jump,
            dst: mir_opnd_none(),
            src1: mir_opnd_imm(else_id),
            src2: mir_opnd_none()
        );
        b4 = builder_add_instr(b4, ins_jmp);
        
        b4 = builder_add_edge(b4, b4.current_block, then_id);
        b4 = builder_add_edge(b4, b4.current_block, else_id);
        
        # Then
        b4.current_block = then_id;
        b4 = lower_stmt(b4, then_block);
        # Jump to end.
        ins_end = MirInstr ( op: MirOp.Jump, dst: mir_opnd_none(), src1: mir_opnd_imm(end_id), src2: mir_opnd_none() );
        b4 = builder_add_instr(b4, ins_end);
        b4 = builder_add_edge(b4, b4.current_block, end_id);
        
        # Else
        if has_else do
            else_block = vec_get_rt(stmt.children, 2);
            b4.current_block = else_id;
            b4 = lower_stmt(b4, else_block);
            ins_end2 = MirInstr ( op: MirOp.Jump, dst: mir_opnd_none(), src1: mir_opnd_imm(end_id), src2: mir_opnd_none() );
            b4 = builder_add_instr(b4, ins_end2);
            b4 = builder_add_edge(b4, b4.current_block, end_id)
        end.
        
        b4.current_block = end_id;
        out b4;
        
    eif stmt.node_type == AstType.WhileStmt do
        cond_expr = vec_get_rt(stmt.children, 0);
        body_block = vec_get_rt(stmt.children, 1);
        
        var (b2, cond_id) = builder_add_block(b);
        var (b3, body_id) = builder_add_block(b2);
        var (b4, end_id) = builder_add_block(b3);
        
        # Jump to cond
        ins_jmp_cond = MirInstr ( op: MirOp.Jump, dst: mir_opnd_none(), src1: mir_opnd_imm(cond_id), src2: mir_opnd_none() );
        b4 = builder_add_instr(b4, ins_jmp_cond);
        b4 = builder_add_edge(b4, b4.current_block, cond_id);
        
        # Cond block
        b4.current_block = cond_id;
        var (b5, cond_opnd) = lower_expr(b4, cond_expr);
        
        ins = MirInstr ( op: MirOp.JumpIf, dst: mir_opnd_none(), src1: cond_opnd, src2: mir_opnd_imm(body_id) );
        b5 = builder_add_instr(b5, ins);
        ins_jmp_end = MirInstr ( op: MirOp.Jump, dst: mir_opnd_none(), src1: mir_opnd_imm(end_id), src2: mir_opnd_none() );
        b5 = builder_add_instr(b5, ins_jmp_end);
        b5 = builder_add_edge(b5, cond_id, body_id);
        b5 = builder_add_edge(b5, cond_id, end_id);
        
        # Body block
        b5.current_block = body_id;
        b5 = lower_stmt(b5, body_block);
        ins_jmp_loop = MirInstr ( op: MirOp.Jump, dst: mir_opnd_none(), src1: mir_opnd_imm(cond_id), src2: mir_opnd_none() );
        b5 = builder_add_instr(b5, ins_jmp_loop);
        b5 = builder_add_edge(b5, b5.current_block, cond_id);
        
        b5.current_block = end_id;
        out b5;
        
    eif stmt.node_type == AstType.Block do
        i = 0;
        n = vec_len_rt(stmt.children);
        b_mut = b;
        when i < n loop
            child = vec_get_rt(stmt.children, i);
            b_mut = lower_stmt(b_mut, child);
            i = i + 1
        end.
        out b_mut;
        
    eif stmt.node_type == AstType.ReturnStmt do
        var (b2, ret_opnd) = lower_expr(b, vec_get_rt(stmt.children, 0));
        ins = MirInstr (
            op: MirOp.Return,
            dst: mir_opnd_none(),
            src1: ret_opnd,
            src2: mir_opnd_none()
        );
        b2 = builder_add_instr(b2, ins);
        out b2
    end.
    
    out b
end.

func lower_stmt(b: MirBuilder, stmt: AstNode):
    out lower_stmt_impl(b, stmt)
end.

func ast_lower_func(func_id: i64, ast_func: AstNode):
    b = builder_new(func_id);
    
    # ast_func children: [0]=params, [1]=body (Block)
    body = vec_get_rt(ast_func.children, 1);
    b = lower_stmt(b, body);
    
    b.func_obj.max_vreg = b.vreg_counter;
    out b.func_obj
end.

func ast_lower_program(prog: AstNode):
    # Returns Vec<MirFunc>
    mir_funcs = vec_new_rt();
    
    i = 0;
    n = vec_len_rt(prog.children);
    when i < n loop
        child = vec_get_rt(prog.children, i);
        if child.node_type == AstType.FuncDef do
            m_func = ast_lower_func(i, child);
            mir_funcs = vec_push_rt(mir_funcs, m_func)
        end.
        i = i + 1
    end.
    
    out mir_funcs
end.

export ast_lower_program, ast_lower_func;
