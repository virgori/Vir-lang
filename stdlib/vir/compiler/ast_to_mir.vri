#*#
 * vir/compiler/ast_to_mir.vri — AST to MIR Lowering
 * ==============================================================
 * Flattens AST into MIR basic blocks + CFG. Locals map to vregs.
 * Phi insertion is deferred to mir_ssa.vri (this phase emits non-SSA MIR).
 * Coverage / status: MUST_READ_CONTEXT/AST_TO_MIR_LOWERING_CHECKLIST.md
 #*#

include types
include vec_rt
import vec_new_rt, vec_push_rt, vec_get_rt, vec_set_rt, vec_len_rt, vec_pop_rt from vec_rt

include string_rt
import rt_streq, fat_str_eq, fat_str_len, fat_cstr_eq, fat_str_new, fat_str_concat, rt_itoa, rt_strlen, fat_str_byte_at, sb_new, sb_append, sb_append_int, sb_to_string, sb_free from string_rt

# Local fail-fast exit: avoids importing sys_exit (avoid include chain crash).
# On macOS ARM64: X16=0x2000001, SVC #0x80. On Linux ARM64: X8=93, SVC #0.
# We call syscall1 from vir.rt.syscall if available, otherwise use direct native.
# Simpler: just reference sys_exit which is always in scope when ast_to_mir is
# expanded as part of virc.vri (which already includes vir.rt.syscall).

include parser
import AstNode, AstType, OpType from parser

include vir.compiler.ffi_imports
import ffi_import_reset, ffi_import_register from vir.compiler.ffi_imports

include type_table
import is_tensor_type_str, parse_tensor_shape, parse_tensor_rank, parse_tensor_stride, parse_tensor_numel, parse_tensor_elem_type from type_table

include vir.compiler.mir
import print_str, print_ln from vir.compiler.context
import MirFunc, MirBlock, MirInstr, MirOp, MirOperand, MirOperandType, mir_opnd_none, mir_opnd_vreg, mir_opnd_imm, mir_opnd_new, mir_opnd_type, mir_instr_new, mir_instr_set_aux, mir_func_new, mir_block_new, mir_create_block, mir_intern_string, mir_func_id, mir_func_name, mir_func_next_vreg, mir_func_def_uses, mir_func_next_block_id, mir_func_entry_block, mir_func_blocks, mir_func_strings, mir_func_var_buckets, mir_block_id, mir_block_head, mir_block_tail, mir_block_successors, mir_block_preds, mir_block_idom, mir_block_dom_children, mir_block_df, mir_block_next_block, mir_block_phis, MIR_INTR_STR_LIT, MIR_INTR_PRINT, MIR_INTR_ARRAY, MIR_INTR_TUPLE, MIR_INTR_ENTITY, MIR_INTR_ADDR_OF, MIR_INTR_INTERP, MIR_INTR_BUILTIN, MIR_INTR_INDEX, MIR_INTR_FIELD, MIR_INTR_MATCH_PAT, MIR_INTR_INPUT, MIR_INTR_ENUM, MIR_INTR_CAST, MIR_INTR_THROW, MIR_INTR_CANCEL, MIR_INTR_QUIET, MIR_INTR_ARENA, MIR_INTR_ENSURE, MIR_INTR_REVERT, MIR_INTR_INDEX_STORE, MIR_INTR_FIELD_STORE, MIR_INTR_STR_EQ, MIR_INTR_CHECK_CPU, MIR_INTR_PATCH_POINT, MIR_INTR_DECL, MIR_INTR_AWAIT, MIR_INTR_NOP_MARKER, MIR_INTR_TASK, MIR_INTR_WAIT, MIR_INTR_SELECT, MIR_INTR_SEND, MIR_INTR_RECV, MIR_INTR_EMIT, MIR_INTR_ERX, MIR_INTR_TRY, MIR_INTR_RESUME, MIR_INTR_LOCK, MIR_INTR_SWIZZLE, MIR_INTR_INFER, MIR_INTR_TRAIN, MIR_INTR_QUANTIZE, MIR_INTR_AWAIT_PASS, MIR_INTR_SAFE_ACCESS, MIR_INTR_ATOMIC, MIR_INTR_EXIST, MIR_INTR_PATTERN, MIR_INTR_MAP, MIR_INTR_ARR_COMPACT, MIR_INTR_BUNDLE, MIR_INTR_TIMEOUT, MIR_INTR_ISOLATE, MIR_INTR_ERROR, MIR_INTR_PRECOMP, MIR_INTR_REACTIVE, MIR_INTR_MORPH, MIR_INTR_EXPOSE, MIR_INTR_PTR, MIR_INTR_ASYNC, MIR_INTR_ATOMIC_VAR, MIR_INTR_PRINT_STR, MIR_INTR_PARAM, MIR_INTR_GLOBAL_LOAD, MIR_INTR_GLOBAL_STORE, MIR_INTR_BIT_EXTRACT, MIR_INTR_BIT_INSERT from vir.compiler.mir

# Map OpType → MirOp code.
# Special: Land=-2, Lor=-3, PatternOp=-4 (Intrinsic PATTERN). Unknown=-1.
var g_ast_lower_verbose: int = 0

func set_ast_lower_verbose(mode: int):
    g_ast_lower_verbose = mode
end.

func mir_op_from_optype(op: OpType):
	if op == OpType.Add do out MirOp.Add as i64 end
	if op == OpType.Sub do out MirOp.Sub as i64 end
	if op == OpType.Mul do out MirOp.Mul as i64 end
	if op == OpType.Div do out MirOp.Div as i64 end
	if op == OpType.ModOp or op == OpType.PercentOp do out MirOp.Mod as i64 end
	if op == OpType.Eq do out MirOp.CmpEq as i64 end
	if op == OpType.Ne do out MirOp.CmpNe as i64 end
	if op == OpType.Gt do out MirOp.CmpGt as i64 end
	if op == OpType.Lt do out MirOp.CmpLt as i64 end
	if op == OpType.Ge do out MirOp.CmpGe as i64 end
	if op == OpType.Le do out MirOp.CmpLe as i64 end
	if op == OpType.SafeEq do out MirOp.CmpEq as i64 end
	if op == OpType.SafeNe do out MirOp.CmpNe as i64 end
	if op == OpType.AndOp do out MirOp.And as i64 end
	if op == OpType.OrOp do out MirOp.Or as i64 end
	if op == OpType.XorOp do out MirOp.Xor as i64 end
	if op == OpType.ShlOp do out MirOp.Shl as i64 end
	if op == OpType.ShrOp do out MirOp.Shr as i64 end
	if op == OpType.PowOp do out MirOp.Pow as i64 end
	if op == OpType.MatMulOp do out MirOp.MatMul as i64 end
	if op == OpType.FmaOp do out MirOp.Fma as i64 end
	if op == OpType.Land do out 0 - 2 end
	if op == OpType.Lor do out 0 - 3 end
	if op == OpType.PatternOp do out 0 - 4 end
	out 0 - 1
end.

const MIR_VAR_BUCKETS: i64 = 256

entity VarMap:
	name: string,
	vreg: i64
end.

func var_map_new(name: string, vreg: i64):
    out VarMap (
        name: name,
        vreg: vreg
    )
end.

# Typed accessors — bare vec_get_rt results have no record type.
func var_map_name(vm: VarMap):
	out vm.name
end.
func var_map_vreg(vm: VarMap):
	out vm.vreg
end.


entity LoopTarget:
	break_block: i64,
	continue_block: i64
end.

func loop_target_new(break_block: i64, continue_block: i64):
    p = alloc(16)
    native_write_i64(p, 0, break_block)
    native_write_i64(p, 8, continue_block)
    out p
end.

func loop_target_break_block(lt: LoopTarget):
    out native_read_i64(lt as i64, 0)
end.

func loop_target_continue_block(lt: LoopTarget):
    out native_read_i64(lt as i64, 8)
end.

entity MirBuilder:
	current_block: i64,
	vreg_counter: i64,
	loop_stack: i64, # Vec<LoopTarget>
	func_box: i64, # Vec<MirFunc> length 1 — locals live on MirFunc.var_buckets
	cur_func_ptr: i64,
	cur_block_ptr: i64
end.

var g_prog_ast: AstNode = 0
var g_entity_names: i64 = 0
var g_import_aliases: i64 = 0
var g_import_targets: i64 = 0
var g_field_names: i64 = 0
var g_field_indices: i64 = 0
var g_register_field_names: i64 = 0
var g_register_field_starts: i64 = 0
var g_register_field_widths: i64 = 0
var g_builtin_lookup_buckets: i64 = 0
var g_mir_scratch_args: i64 = 0
var g_mir_scratch_top: i64 = 0

# Active `try` handler context (for `throw` inside a try body). These are saved
# and restored around each TryStmt lowering so nested try blocks work.
var g_try_revert_block: i64 = 0 - 1
var g_try_retry_block: i64 = 0 - 1
var g_try_err_vreg: i64 = 0

var g_entity_hash: i64 = 0
var g_import_hash: i64 = 0
var g_field_hash: i64 = 0
var g_regfield_hash: i64 = 0
var g_const_names: i64 = 0
var g_const_values: i64 = 0
var g_const_hash: i64 = 0
var g_lower_global_names: i64 = 0
var g_lower_global_values: i64 = 0
var g_lower_global_hash: i64 = 0
var g_lower_global_init_nodes: i64 = 0

var g_scoped_field_hash: i64 = 0
var g_scoped_field_names: i64 = 0
var g_scoped_field_indices: i64 = 0
var g_scoped_field_types: i64 = 0
var g_scope_stack: i64 = 0
var g_current_func_buckets: i64 = 0

var g_var_type_hash: i64 = 0
var g_var_type_names: i64 = 0
var g_var_type_values: i64 = 0

var g_current_entity_name: i64 = 0

func set_var_type(var_name: string, type_name: string):
    if g_var_type_hash != 0 and var_name != 0 and type_name != 0 do
        idx = hash_table_lookup(g_var_type_hash, g_var_type_names, var_name)
        if idx >= 0 do
            vec_set_rt(g_var_type_values, idx, type_name as i64)
        else
            idx = vec_len_rt(g_var_type_names)
            g_var_type_names = vec_push_rt(g_var_type_names, var_name as i64)
            g_var_type_values = vec_push_rt(g_var_type_values, type_name as i64)
            hash_table_insert(g_var_type_hash, g_var_type_names, var_name, idx)
        end
    end
end.

func get_var_type(var_name: string):
    if g_var_type_hash != 0 and var_name != 0 do
        idx = hash_table_lookup(g_var_type_hash, g_var_type_names, var_name)
        if idx >= 0 do
            out vec_get_rt(g_var_type_values, idx) as string
        end
    end
    out 0
end.

func name_hash_256(name: string):
    n = fat_str_len(name as int) as i64
    h = n * 17
    var i = 0
    when i < n loop
        h = h * 131 + (fat_str_byte_at(name as int, i) as i64)
        i = i + 1
    end
    if h < 0 do h = 0 - h end
    out h mod 256
end.

func hash_table_new():
    tab = vec_new_rt()
    var i = 0
    when i < 256 loop
        tab = vec_push_rt(tab, 0)
        i = i + 1
    end
    out tab
end.

func hash_table_lookup(hash_tab: i64, names: i64, name: string):
    if hash_tab == 0 or names == 0 do out 0 - 1 end
    bid = name_hash_256(name)
    bucket = vec_get_rt(hash_tab, bid)
    if bucket == 0 do out 0 - 1 end
    n = vec_len_rt(bucket)
    var i = 0
    when i < n loop
        idx = vec_get_rt(bucket, i)
        if fat_str_eq(vec_get_rt(names, idx) as string, name) == 1 do
            out idx
        end
        i = i + 1
    end
    out 0 - 1
end.

func hash_table_insert(hash_tab: i64, names: i64, name: string, idx: i64):
    if hash_tab == 0 do out 0 end
    bid = name_hash_256(name)
    bucket = vec_get_rt(hash_tab, bid)
    if bucket == 0 do
        bucket = vec_new_rt()
    end
    bucket = vec_push_rt(bucket, idx)
    vec_set_rt(hash_tab, bid, bucket)
    out 0
end.

func lookup_cached_name(names: i64, name: string):
    if names == 0 do out 0 - 1 end
    if names == g_field_names and g_field_hash != 0 do
        out hash_table_lookup(g_field_hash, names, name)
    end
    if names == g_scoped_field_names and g_scoped_field_hash != 0 do
        out hash_table_lookup(g_scoped_field_hash, names, name)
    end
    if names == g_entity_names and g_entity_hash != 0 do
        out hash_table_lookup(g_entity_hash, names, name)
    end
    if names == g_import_aliases and g_import_hash != 0 do
        out hash_table_lookup(g_import_hash, names, name)
    end
    if names == g_register_field_names and g_regfield_hash != 0 do
        out hash_table_lookup(g_regfield_hash, names, name)
    end
    n = vec_len_rt(names)
    var i = 0
    when i < n loop
        if fat_str_eq(vec_get_rt(names, i) as string, name) == 1 do out i end
        i = i + 1
    end
    out 0 - 1
end.

func eval_const_expr(node: AstNode):
    if node == 0 do out 0 end
    nt = ast_node_type_of(node)
    if nt == AstType.LiteralInt do
        out ast_node_int_val(node)
    end
    if nt == AstType.LiteralFloat do
        out ast_node_int_val(node)
    end
    if nt == AstType.UnaryMinus do
        if ast_node_child_count(node) > 0 do
            out 0 - eval_const_expr(ast_node_child(node, 0))
        end
        out 0
    end
    if nt == AstType.Identifier do
        cname = ast_node_name(node)
        if fat_cstr_eq(cname, "true") == 1 do out 1 end
        if fat_cstr_eq(cname, "false") == 1 do out 0 end
        if fat_cstr_eq(cname, "null") == 1 do out 0 end
        if g_const_hash > 0 do
            c_idx = hash_table_lookup(g_const_hash, g_const_names, cname)
            if c_idx >= 0 do
                out vec_get_rt(g_const_values, c_idx)
            end
        end
        out 0
    end
    if nt == AstType.FieldAccess do
        if ast_node_child_count(node) > 0 do
            base = ast_node_child(node, 0)
            if ast_node_type_of(base) == AstType.Identifier do
                key = fat_str_concat(fat_str_concat(ast_node_name(base), fat_str_new(".")), ast_node_name(node))
                if g_const_hash > 0 do
                    c_idx = hash_table_lookup(g_const_hash, g_const_names, key)
                    if c_idx >= 0 do
                        out vec_get_rt(g_const_values, c_idx)
                    end
                end
            end
        end
        out 0
    end
    if nt == AstType.EnumAccess do
        key = fat_str_concat(fat_str_concat(ast_node_name(node), fat_str_new(".")), ast_node_name2(node))
        if g_const_hash > 0 do
            c_idx = hash_table_lookup(g_const_hash, g_const_names, key)
            if c_idx >= 0 do
                out vec_get_rt(g_const_values, c_idx)
            end
        end
        out 0
    end
    if nt == AstType.BinOp or nt == AstType.Compare do
        if ast_node_child_count(node) >= 2 do
            lval = eval_const_expr(ast_node_child(node, 0))
            rval = eval_const_expr(ast_node_child(node, 1))
            op = ast_node_op_of(node)
            if op == OpType.Add do out lval + rval end
            if op == OpType.Sub do out lval - rval end
            if op == OpType.Mul do out lval * rval end
            if op == OpType.Div do
                if rval != 0 do out lval / rval end
                out 0
            end
            if op == OpType.ModOp or op == OpType.PercentOp do
                if rval != 0 do out lval mod rval end
                out 0
            end
            if op == OpType.OrOp or op == OpType.Lor do out lval or rval end
            if op == OpType.AndOp or op == OpType.Land do out lval and rval end
            if op == OpType.XorOp do out lval xor rval end
            if op == OpType.ShlOp do out lval shl rval end
            if op == OpType.ShrOp do out lval shr rval end
        end
        out 0
    end
    out 0
end.

func set_global_prog_ast(ast: AstNode):
    g_prog_ast = ast
    g_entity_names = vec_new_rt()
    g_import_aliases = vec_new_rt()
    g_import_targets = vec_new_rt()
    g_field_names = vec_new_rt()
    g_field_indices = vec_new_rt()
    g_register_field_names = vec_new_rt()
    g_register_field_starts = vec_new_rt()
    g_register_field_widths = vec_new_rt()

    g_entity_hash = hash_table_new()
    g_import_hash = hash_table_new()
    g_field_hash = hash_table_new()
    g_regfield_hash = hash_table_new()

    g_const_names = vec_new_rt()
    g_const_values = vec_new_rt()
    g_const_hash = hash_table_new()

    g_scoped_field_names = vec_new_rt()
    g_scoped_field_indices = vec_new_rt()
    g_scoped_field_types = vec_new_rt()
    g_scoped_field_hash = hash_table_new()

    g_var_type_names = vec_new_rt()
    g_var_type_values = vec_new_rt()
    g_var_type_hash = hash_table_new()

    g_current_entity_name = 0

    # Native code needs real cross-function storage for top-level `var`s.
    # Assign each declaration a stable heap-header slot before lowering funcs.
    g_lower_global_names = vec_new_rt()
    g_lower_global_values = vec_new_rt()
    g_lower_global_hash = hash_table_new()
    g_lower_global_init_nodes = vec_new_rt()

    n = ast_node_child_count(ast)
    var i = 0
    when i < n loop
        child = ast_node_child(ast, i)
        child_type = ast_node_type_of(child)
        if child_type == AstType.ImportStmt do
            child_count = ast_node_child_count(child)
            var j = 0
            when j < child_count loop
                sym = ast_node_child(child, j)
                alias = ast_node_name2(sym)
                if fat_str_len(alias) > 0 and hash_table_lookup(g_import_hash, g_import_aliases, alias) < 0 do
                    idx = vec_len_rt(g_import_aliases)
                    g_import_aliases = vec_push_rt(g_import_aliases, alias as i64)
                    g_import_targets = vec_push_rt(g_import_targets, ast_node_name(sym) as i64)
                    hash_table_insert(g_import_hash, g_import_aliases, alias, idx)
                end
                j = j + 1
            end
        end
        if child_type == AstType.EnumDef do
            enum_name = ast_node_name(child)
            v_cnt = ast_node_child_count(child)
            var vi = 0
            when vi < v_cnt loop
                variant = ast_node_child(child, vi)
                vname = ast_node_name(variant)
                vval = ast_node_int_val(variant)
                key = fat_str_concat(fat_str_concat(enum_name, fat_str_new(".")), vname)
                if hash_table_lookup(g_const_hash, g_const_names, key) < 0 do
                    idx = vec_len_rt(g_const_names)
                    g_const_names = vec_push_rt(g_const_names, key as i64)
                    g_const_values = vec_push_rt(g_const_values, vval)
                    hash_table_insert(g_const_hash, g_const_names, key, idx)
                end
                vi = vi + 1
            end
        end
        if child_type == AstType.ConstDecl do
            const_name = ast_node_name(child)
            if ast_node_child_count(child) > 0 do
                init_expr = ast_node_child(child, 0)
                val = eval_const_expr(init_expr)
                if hash_table_lookup(g_const_hash, g_const_names, const_name) < 0 do
                    idx = vec_len_rt(g_const_names)
                    g_const_names = vec_push_rt(g_const_names, const_name as i64)
                    g_const_values = vec_push_rt(g_const_values, val)
                    hash_table_insert(g_const_hash, g_const_names, const_name, idx)
                end
            end
        end
        if child_type == AstType.EntityDef or child_type == AstType.PackedDef or child_type == AstType.RegisterDef do
            entity_name = ast_node_name(child)
            if hash_table_lookup(g_entity_hash, g_entity_names, entity_name) < 0 do
                idx = vec_len_rt(g_entity_names)
                g_entity_names = vec_push_rt(g_entity_names, entity_name as i64)
                hash_table_insert(g_entity_hash, g_entity_names, entity_name, idx)
            end
            field_count = ast_node_child_count(child)
            var j = 0
            var actual_field_idx = 0
            when j < field_count loop
                field = ast_node_child(child, j)
                if ast_node_type_of(field) != AstType.FuncDef do
                    field_name = ast_node_name(field)
                    dot_str = fat_str_new(".")
                    scoped_key = fat_str_concat(fat_str_concat(entity_name, dot_str), field_name)
                    if hash_table_lookup(g_scoped_field_hash, g_scoped_field_names, scoped_key) < 0 do
                        idx_s = vec_len_rt(g_scoped_field_names)
                        g_scoped_field_names = vec_push_rt(g_scoped_field_names, scoped_key as i64)
                        g_scoped_field_indices = vec_push_rt(g_scoped_field_indices, actual_field_idx)
                        var ft_decl = ast_node_name2(field)
                        if ft_decl == 0 do ft_decl = fat_str_new("") end
                        g_scoped_field_types = vec_push_rt(g_scoped_field_types, ft_decl as i64)
                        hash_table_insert(g_scoped_field_hash, g_scoped_field_names, scoped_key, idx_s)
                    end
                    field_t = ast_node_name2(field)
                    if field_t != 0 and fat_str_len(field_t) > 0 do
                        set_var_type(field_name, field_t)
                    end
                    if hash_table_lookup(g_field_hash, g_field_names, field_name) < 0 do
                        idx = vec_len_rt(g_field_names)
                        g_field_names = vec_push_rt(g_field_names, field_name as i64)
                        g_field_indices = vec_push_rt(g_field_indices, actual_field_idx)
                        hash_table_insert(g_field_hash, g_field_names, field_name, idx)
                    end
                    if child_type == AstType.RegisterDef and hash_table_lookup(g_regfield_hash, g_register_field_names, field_name) < 0 do
                        width = ast_node_builtin_id(field)
                        if width <= 0 do width = 1 end
                        idx = vec_len_rt(g_register_field_names)
                        g_register_field_names = vec_push_rt(g_register_field_names, field_name as i64)
                        g_register_field_starts = vec_push_rt(g_register_field_starts, ast_node_int_val(field))
                        g_register_field_widths = vec_push_rt(g_register_field_widths, width)
                        hash_table_insert(g_regfield_hash, g_register_field_names, field_name, idx)
                    end
                    actual_field_idx = actual_field_idx + 1
                end
                j = j + 1
            end
        end
        i = i + 1
    end

    global_n = ast_node_child_count(ast)
    var global_i = 0
    when global_i < global_n loop
        global_node = ast_node_child(ast, global_i)
        if ast_node_type_of(global_node) == AstType.VarDecl do
            global_name = ast_node_name(global_node)
            if hash_table_lookup(g_lower_global_hash, g_lower_global_names, global_name) < 0 do
                global_slot = vec_len_rt(g_lower_global_names)
                global_value = 0
                init_node = 0
                if ast_node_child_count(global_node) > 0 do
                    init_node = ast_node_child(global_node, 0) as i64
                    global_value = eval_const_expr(ast_node_child(global_node, 0))
                end
                g_lower_global_names = vec_push_rt(g_lower_global_names, global_name as i64)
                g_lower_global_values = vec_push_rt(g_lower_global_values, global_value)
                g_lower_global_init_nodes = vec_push_rt(g_lower_global_init_nodes, init_node)
                hash_table_insert(g_lower_global_hash, g_lower_global_names, global_name, global_slot)
            end
        end
        global_i = global_i + 1
    end
end.

func global_slot_lookup(name: string):
    out hash_table_lookup(g_lower_global_hash, g_lower_global_names, name)
end.

func get_scoped_field_type(entity_name: string, field_name: string):
    if g_scoped_field_hash != 0 and entity_name != 0 and field_name != 0 do
        dot_str = fat_str_new(".")
        scoped_key = fat_str_concat(fat_str_concat(entity_name, dot_str), field_name)
        idx_s = hash_table_lookup(g_scoped_field_hash, g_scoped_field_names, scoped_key)
        if idx_s >= 0 do
            out vec_get_rt(g_scoped_field_types, idx_s) as string
        end
    end
    out fat_str_new("")
end.

func get_scoped_field_index(entity_name: string, field_name: string):
    if g_scoped_field_hash != 0 and entity_name != 0 and field_name != 0 do
        dot_str = fat_str_new(".")
        scoped_key = fat_str_concat(fat_str_concat(entity_name, dot_str), field_name)
        idx_s = hash_table_lookup(g_scoped_field_hash, g_scoped_field_names, scoped_key)
        if idx_s >= 0 do
            out vec_get_rt(g_scoped_field_indices, idx_s)
        end
    end
    out 0 - 1
end.

func get_expr_entity_type(node: AstNode):
    if node == 0 do out fat_str_new("") end
    nt = ast_node_type_of(node)
    if nt == AstType.Identifier do
        vname = ast_node_name(node)
        vt = get_var_type(vname)
        if vt != 0 and fat_str_len(vt) > 0 do out vt end
        if is_entity_name(vname) == 1 do out vname end
        out fat_str_new("")
    end
    if nt == AstType.FieldAccess do
        if ast_node_child_count(node) > 0 do
            base_node = ast_node_child(node, 0)
            base_type = get_expr_entity_type(base_node)
            if fat_str_len(base_type) > 0 do
                field_name = ast_node_name(node)
                out get_scoped_field_type(base_type, field_name)
            end
        end
        out fat_str_new("")
    end
    if nt == AstType.EntityLiteral do
        out ast_node_name(node)
    end
    if nt == AstType.Call do
        callee = resolve_callee_alias(ast_node_name(node))
        if is_entity_name(callee) == 1 do out callee end
        out fat_str_new("")
    end
    out fat_str_new("")
end.

func find_field_index_for_base(base_name: string, field_name: string):
    if base_name != 0 do
        var ent_type = get_var_type(base_name)
        if ent_type == 0 and is_entity_name(base_name) == 1 do
            ent_type = base_name
        end
        if ent_type != 0 do
            idx_s = get_scoped_field_index(ent_type, field_name)
            if idx_s >= 0 do
                out idx_s
            end
        end
    end

    # Lexer entity fields (base is lex, lex2, etc.)
    if fat_cstr_eq(base_name, "lex") == 1 or fat_cstr_eq(base_name, "lex2") == 1 or fat_cstr_eq(base_name, "l") == 1 do
        if fat_cstr_eq(field_name, "source") == 1 do out 0 end
        if fat_cstr_eq(field_name, "source_len") == 1 do out 1 end
        if fat_cstr_eq(field_name, "pos") == 1 do out 2 end
        if fat_cstr_eq(field_name, "line") == 1 do out 3 end
        if fat_cstr_eq(field_name, "col") == 1 do out 4 end
        if fat_cstr_eq(field_name, "tokens") == 1 do out 5 end
        if fat_cstr_eq(field_name, "paren_depth") == 1 do out 6 end
        if fat_cstr_eq(field_name, "keywords") == 1 do out 7 end
        if fat_cstr_eq(field_name, "error_msg") == 1 do out 8 end
    end

    # Parser entity fields (tokens:0, pos:1, token_count:2, error_msg:3, error_line:4, builtins:5)
    if fat_cstr_eq(field_name, "token_count") == 1 do out 2 end
    if fat_cstr_eq(field_name, "builtins") == 1 do out 5 end
    if fat_cstr_eq(field_name, "tokens") == 1 do out 0 end
    if fat_cstr_eq(field_name, "pos") == 1 do out 1 end
    if fat_cstr_eq(field_name, "error_line") == 1 do out 4 end
    if fat_cstr_eq(field_name, "error_msg") == 1 do
        if fat_cstr_eq(base_name, "lex") == 1 or fat_cstr_eq(base_name, "lex2") == 1 or fat_cstr_eq(base_name, "l") == 1 do
            out 8
        end
        out 3
    end

    # StringBuilder entity fields (buf: 0, len: 1, cap: 2)
    if fat_cstr_eq(field_name, "buf") == 1 do out 0 end
    if fat_cstr_eq(field_name, "cap") == 1 do out 2 end
    if fat_cstr_eq(base_name, "sb") == 1 or fat_cstr_eq(base_name, "sb_pre") == 1 or fat_cstr_eq(base_name, "sb_src") == 1 or fat_cstr_eq(base_name, "builder") == 1 or fat_cstr_eq(base_name, "out_sb") == 1 or fat_cstr_eq(base_name, "resp_sb") == 1 do
        if fat_cstr_eq(field_name, "len") == 1 do out 1 end
    end

    # Token entity fields (tok_type:0, line:1, col:2, start:3, len:4, str_val:5, int_val:6, float_val:7)
    if fat_cstr_eq(field_name, "tok_type") == 1 do out 0 end
    if fat_cstr_eq(field_name, "str_val") == 1 do out 5 end
    if fat_cstr_eq(base_name, "t") == 1 or fat_cstr_eq(base_name, "t2") == 1 or fat_cstr_eq(base_name, "t3") == 1 or fat_cstr_eq(base_name, "tok") == 1 or fat_cstr_eq(base_name, "op_tok") == 1 or fat_cstr_eq(base_name, "id_tok") == 1 or fat_cstr_eq(base_name, "name_tok") == 1 or fat_cstr_eq(base_name, "field_tok") == 1 or fat_cstr_eq(base_name, "count_tok") == 1 or fat_cstr_eq(base_name, "int_tok") == 1 or fat_cstr_eq(base_name, "hi_tok") == 1 or fat_cstr_eq(base_name, "it") == 1 or fat_cstr_eq(base_name, "st") == 1 or fat_cstr_eq(base_name, "cur") == 1 or fat_cstr_eq(base_name, "prev") == 1 or fat_cstr_eq(base_name, "vt") == 1 or fat_cstr_eq(base_name, "end_tok") == 1 or fat_cstr_eq(base_name, "val_tok") == 1 do
        if fat_cstr_eq(field_name, "line") == 1 do out 1 end
        if fat_cstr_eq(field_name, "col") == 1 do out 2 end
        if fat_cstr_eq(field_name, "start") == 1 do out 3 end
        if fat_cstr_eq(field_name, "len") == 1 do out 4 end
        if fat_cstr_eq(field_name, "int_val") == 1 do out 6 end
        if fat_cstr_eq(field_name, "float_val") == 1 do out 7 end
    end

    out find_field_index(field_name)
end.

func find_field_index(field_name: string):
    # Builtin compiler entity field indices (AstNode, Token, Lexer, ScopeNode, SymbolNode)
    if fat_cstr_eq(field_name, "name") == 1 do out 0 end
    if fat_cstr_eq(field_name, "name2") == 1 do out 1 end
    if fat_cstr_eq(field_name, "node_type") == 1 do out 2 end
    if fat_cstr_eq(field_name, "op") == 1 do out 3 end
    if fat_cstr_eq(field_name, "line") == 1 do out 4 end
    if fat_cstr_eq(field_name, "int_val") == 1 do out 5 end
    if fat_cstr_eq(field_name, "float_val") == 1 do out 6 end
    if fat_cstr_eq(field_name, "builtin_id") == 1 do out 7 end
    if fat_cstr_eq(field_name, "children") == 1 do out 8 end

    if fat_cstr_eq(field_name, "parent_id") == 1 do out 1 end
    if fat_cstr_eq(field_name, "symbols") == 1 do out 2 end
    if fat_cstr_eq(field_name, "scopes") == 1 do out 0 end
    if fat_cstr_eq(field_name, "current_id") == 1 do out 1 end
    if fat_cstr_eq(field_name, "name_id") == 1 do out 1 end
    if fat_cstr_eq(field_name, "type_id") == 1 do out 2 end
    if fat_cstr_eq(field_name, "scope_id") == 1 do out 3 end
    if fat_cstr_eq(field_name, "ast_id") == 1 do out 4 end
    if fat_cstr_eq(field_name, "is_mutable") == 1 do out 5 end
    if fat_cstr_eq(field_name, "offset") == 1 do out 6 end
    if fat_cstr_eq(field_name, "param_count") == 1 do out 7 end
    if fat_cstr_eq(field_name, "return_type") == 1 do out 8 end

    if fat_cstr_eq(field_name, "tok_type") == 1 do out 0 end
    if fat_cstr_eq(field_name, "col") == 1 do out 2 end
    if fat_cstr_eq(field_name, "start") == 1 do out 3 end
    if fat_cstr_eq(field_name, "len") == 1 do out 4 end
    if fat_cstr_eq(field_name, "str_val") == 1 do out 5 end

    if fat_cstr_eq(field_name, "source") == 1 do out 0 end
    if fat_cstr_eq(field_name, "source_len") == 1 do out 1 end
    if fat_cstr_eq(field_name, "pos") == 1 do out 2 end
    if fat_cstr_eq(field_name, "token_count") == 1 do out 3 end
    if fat_cstr_eq(field_name, "error_line") == 1 do out 4 end
    if fat_cstr_eq(field_name, "tokens") == 1 do out 5 end
    if fat_cstr_eq(field_name, "paren_depth") == 1 do out 6 end
    if fat_cstr_eq(field_name, "builtins") == 1 do out 6 end
    if fat_cstr_eq(field_name, "keywords") == 1 do out 7 end
    if fat_cstr_eq(field_name, "error_msg") == 1 do out 8 end

    idx = lookup_cached_name(g_field_names, field_name)
    if idx >= 0 do out vec_get_rt(g_field_indices, idx) end
    out 0
end.

func resolve_callee_alias(callee_name: string):
    idx = lookup_cached_name(g_import_aliases, callee_name)
    if idx >= 0 do out vec_get_rt(g_import_targets, idx) as string end
    out callee_name
end.

func is_entity_name(type_name: string):
    out lookup_cached_name(g_entity_names, type_name) >= 0
end.

func is_register_field(field_name: string):
    if g_register_field_names == 0 do out 0 end
    if (field_name as i64) < 4096 do out 0 end
    if lookup_cached_name(g_register_field_names, field_name) >= 0 do out 1 end
    out 0
end.

func get_register_field_start(field_name: string):
    if g_register_field_names == 0 do out 0 end
    idx = lookup_cached_name(g_register_field_names, field_name)
    if idx >= 0 do out vec_get_rt(g_register_field_starts, idx) end
    out 0
end.

func get_register_field_width(field_name: string):
    if g_register_field_names == 0 do out 1 end
    idx = lookup_cached_name(g_register_field_names, field_name)
    if idx >= 0 do out vec_get_rt(g_register_field_widths, idx) end
    out 1
end.

func is_register_field_scoped(base_type: string, field_name: string):
    out is_register_field(field_name)
end.

func get_register_field_start_scoped(base_type: string, field_name: string):
    out get_register_field_start(field_name)
end.

func get_register_field_width_scoped(base_type: string, field_name: string):
    out get_register_field_width(field_name)
end.

func as_mir_func(f: MirFunc):
	out f
end.
func builder_func(b: MirBuilder):
	f = native_read_i64(b as i64, 32)
	if f != 0 do out f end
    fb = native_read_i64(b as i64, 24)
	f = vec_get_rt(fb, 0)
	native_write_i64(b as i64, 32, f)
	out f
end.

func builder_set_func(b: MirBuilder, f: MirFunc):
	fb = native_read_i64(b as i64, 24)
	if vec_len_rt(fb) == 0 do
		fb = vec_push_rt(fb, f as i64)
	else
		vec_set_rt(fb, 0, f as i64)
    end
    native_write_i64(b as i64, 24, fb)
	native_write_i64(b as i64, 32, f as i64)
	out b
end.

func name_hash_bucket(name: string):
	n = fat_str_len(name as int) as i64
	h = n * 17
	var i = 0
	when i < n loop
		h = h * 131 + (fat_str_byte_at(name as int, i) as i64)
		i = i + 1
	end
	if h < 0 do
		h = 0 - h
	end
	out h mod MIR_VAR_BUCKETS
end.

func builder_pack(cb: i64, vc: i64, loops: i64, fb: i64, cur_func: i64, cur_block: i64):
    p = alloc(48)
    native_write_i64(p, 0, cb)
    native_write_i64(p, 8, vc)
    native_write_i64(p, 16, loops)
    native_write_i64(p, 24, fb)
    native_write_i64(p, 32, cur_func)
    native_write_i64(p, 40, cur_block)
    out p
end.

func builder_new(func_id: i64, fname: string):
	buckets = vec_new_rt()
	var bi = 0
	when bi < MIR_VAR_BUCKETS loop
		# Allocate buckets on first write. Most small functions use only a
		# handful of the 64 slots, so eager vectors waste tens of thousands
		# of allocations during self-host lowering.
		buckets = vec_push_rt(buckets, 0)
		bi = bi + 1
	end
	b0 = mir_create_block(0)
	blocks = vec_new_rt()
	blocks = vec_push_rt(blocks, b0)
	f = mir_func_new(func_id, fname, 0, vec_new_rt(), 1, 0, blocks, vec_new_rt(), buckets)
	fb = vec_new_rt()
	fb = vec_push_rt(fb, f)
	out builder_pack(0, 0, vec_new_rt(), fb, f as i64, b0 as i64)
end.

func builder_intern(b: MirBuilder, s: string):
	var (f2, sid) = mir_intern_string(builder_func(b), s)
	out (builder_set_func(b, f2), sid)
end.

func builder_new_vreg(b: MirBuilder):
	reg = native_read_i64(b as i64, 8)
    native_write_i64(b as i64, 8, reg + 1)
	out (b, reg)
end.

func builder_add_block(b: MirBuilder):
	f = builder_func(b)
    f_blocks = native_read_i64(f as i64, 48)
	id = vec_len_rt(f_blocks)
	blk = mir_create_block(id)
    f_blocks = vec_push_rt(f_blocks, blk)
    native_write_i64(f as i64, 48, f_blocks)
    native_write_i64(f as i64, 32, id + 1)
	out (b, id)
end.

func builder_set_current_block(b: MirBuilder, cb: i64):
    native_write_i64(b as i64, 0, cb)
	block_ptr = 0
	if cb >= 0 do
		f = builder_func(b)
		f_blocks = native_read_i64(f as i64, 48)
		if cb < vec_len_rt(f_blocks) do block_ptr = vec_get_rt(f_blocks, cb) end
	end
	native_write_i64(b as i64, 40, block_ptr)
    out b
end.

func builder_add_instr(b: MirBuilder, instr: MirInstr):
    cb = native_read_i64(b as i64, 0)
	if cb < 0 do
		out b
	end
	blk = native_read_i64(b as i64, 40)
	if blk == 0 do
		f = builder_func(b)
		f_blocks = native_read_i64(f as i64, 48)
		blk = vec_get_rt(f_blocks, cb)
		native_write_i64(b as i64, 40, blk)
	end
    blk_head = native_read_i64(blk as i64, 16)
	blk_head = vec_push_rt(blk_head, instr as i64)
	native_write_i64(blk as i64, 16, blk_head)
	out b
end.

func builder_current_block_terminated(b: MirBuilder):
    cb = native_read_i64(b as i64, 0)
    if cb < 0 do out true end
    blk = native_read_i64(b as i64, 40)
    if blk == 0 do
        f = builder_func(b)
        f_blocks = native_read_i64(f as i64, 48)
        if cb >= vec_len_rt(f_blocks) do out false end
        blk = vec_get_rt(f_blocks, cb)
    end
    instrs = native_read_i64(blk as i64, 16)
    n = vec_len_rt(instrs)
    if n <= 0 do out false end
    last = vec_get_rt(instrs, n - 1)
    op = native_read_i64(last as i64, 0)
    out op == MirOp.Jump or op == MirOp.JumpIf or op == MirOp.JumpIfNot or op == MirOp.Return
end.

func builder_edge_exists(b: MirBuilder, from_b: i64, to_b: i64):
	if from_b < 0 or to_b < 0 do
		out 0
	end
	f = builder_func(b)
    f_blocks = native_read_i64(f as i64, 48)
	src = vec_get_rt(f_blocks, from_b)
	succs = native_read_i64(src as i64, 32)
	n = vec_len_rt(succs)
	var i = 0
	when i < n loop
		if vec_get_rt(succs, i) == to_b do
			out 1
		end
		i = i + 1
	end
	out 0
end.

func builder_add_edge(b: MirBuilder, from_b: i64, to_b: i64):
	if from_b >= 0 and to_b >= 0 do
		if builder_edge_exists(b, from_b, to_b) == 0 do
			f = builder_func(b)
			f_blocks = native_read_i64(f as i64, 48)
			src = vec_get_rt(f_blocks, from_b)
			dst = vec_get_rt(f_blocks, to_b)
			src_succs = native_read_i64(src as i64, 32)
			if src_succs == 0 do src_succs = vec_new_rt() end
			src_succs = vec_push_rt(src_succs, to_b)
            native_write_i64(src as i64, 32, src_succs)
			dst_preds = native_read_i64(dst as i64, 40)
			if dst_preds == 0 do dst_preds = vec_new_rt() end
			dst_preds = vec_push_rt(dst_preds, from_b)
            native_write_i64(dst as i64, 40, dst_preds)
		end
	end
	out b
end.

func builder_push_loop(b: MirBuilder, break_id: i64, cont_id: i64):
	lt = loop_target_new(break_id, cont_id)
    ls = native_read_i64(b as i64, 16)
    ls = vec_push_rt(ls, lt)
    native_write_i64(b as i64, 16, ls)
	out b
end.

func builder_pop_loop(b: MirBuilder):
    ls = native_read_i64(b as i64, 16)
    if vec_len_rt(ls) > 0 do
        vec_pop_rt(ls)
    end
    out b
end.

func builder_loop_top(b: MirBuilder):
    ls = native_read_i64(b as i64, 16)
	n = vec_len_rt(ls)
	if n <= 0 do
		out loop_target_new(0 - 1, 0 - 1)
	end
	out vec_get_rt(ls, n - 1)
end.

func builder_loop_depth(b: MirBuilder):
    ls = native_read_i64(b as i64, 16)
    if ls <= 0 do out 0 end
    out vec_len_rt(ls)
end.

func buckets_get_var(buckets: i64, name: string):
	if buckets == 0 or (name as i64) == 0 do out 0 - 1 end
	bid = name_hash_bucket(name)
	bucket = vec_get_rt(buckets, bid)
	if bucket == 0 do out 0 - 1 end
	var i = 0
	n = vec_len_rt(bucket)
	when i < n loop
		vm = vec_get_rt(bucket, i)
		vname = var_map_name(vm)
		if fat_str_eq(vname, name) == 1 do
			out var_map_vreg(vm)
		end
		i = i + 1
	end
	out 0 - 1
end.

func buckets_set_var(buckets: i64, name: string, vreg: i64):
	if buckets == 0 or (name as i64) == 0 do out 0 end
	bid = name_hash_bucket(name)
	bucket = vec_get_rt(buckets, bid)
	if bucket == 0 do bucket = vec_new_rt() end
	var i = 0
	n = vec_len_rt(bucket)
	var found = false
	when i < n loop
		vm = vec_get_rt(bucket, i)
		vname = var_map_name(vm)
		if fat_str_eq(vname, name) == 1 do
			vec_set_rt(bucket, i, var_map_new(vname, vreg))
			found = true
			i = n
		end
		i = i + 1
	end
	if not found do
		bucket = vec_push_rt(bucket, var_map_new(name, vreg))
	end
	vec_set_rt(buckets, bid, bucket)
	out 0
end.

func buckets_remove_var(buckets: i64, name: string):
	if buckets == 0 or (name as i64) == 0 do out 0 end
	bid = name_hash_bucket(name)
	bucket = vec_get_rt(buckets, bid)
	if bucket == 0 do out 0 end
	new_bucket = vec_new_rt()
	var i = 0
	n = vec_len_rt(bucket)
	when i < n loop
		vm = vec_get_rt(bucket, i)
		vname = var_map_name(vm)
		if fat_str_eq(vname, name) == 0 do
			new_bucket = vec_push_rt(new_bucket, vm)
		end
		i = i + 1
	end
	vec_set_rt(buckets, bid, new_bucket)
	out 0
end.

func get_var_vreg(b: MirBuilder, name: string):
	f = builder_func(b)
	buckets = native_read_i64(f as i64, 64)
	out buckets_get_var(buckets, name)
end.

func set_var_vreg(b: MirBuilder, name: string, vreg: i64):
	f = builder_func(b)
	buckets = native_read_i64(f as i64, 64)
	buckets_set_var(buckets, name, vreg)
	out b
end.

func remove_var_vreg(b: MirBuilder, name: string):
	f = builder_func(b)
	buckets = native_read_i64(f as i64, 64)
	buckets_remove_var(buckets, name)
	out b
end.

func push_scope():
	if g_scope_stack == 0 do
		g_scope_stack = vec_new_rt()
	end
	frame = vec_new_rt()
	frame = vec_push_rt(frame, vec_new_rt())
	frame = vec_push_rt(frame, vec_new_rt())
	frame = vec_push_rt(frame, vec_new_rt())
	g_scope_stack = vec_push_rt(g_scope_stack, frame)
end.

func record_var_declaration(name: string):
	if g_scope_stack != 0 and (name as i64) != 0 do
		stack_len = vec_len_rt(g_scope_stack)
		if stack_len > 1 do
			cur_frame = vec_get_rt(g_scope_stack, stack_len - 1)
			names = vec_get_rt(cur_frame, 0)
			vregs = vec_get_rt(cur_frame, 1)
			types = vec_get_rt(cur_frame, 2)
			var already_in_frame = false
			var fi = 0
			fn = vec_len_rt(names)
			when fi < fn loop
				entry_name = vec_get_rt(names, fi) as string
				if fat_str_eq(entry_name, name) == 1 do
					already_in_frame = true
					fi = fn
				end
				fi = fi + 1
			end
			if not already_in_frame do
				pv = buckets_get_var(g_current_func_buckets, name)
				pt = get_var_type(name)
				if (pt as i64) == 0 do pt = fat_str_new("") end
				names = vec_push_rt(names, name as i64)
				vregs = vec_push_rt(vregs, pv)
				types = vec_push_rt(types, pt as i64)
				vec_set_rt(cur_frame, 0, names)
				vec_set_rt(cur_frame, 1, vregs)
				vec_set_rt(cur_frame, 2, types)
			end
		end
	end
end.

func pop_scope():
	if g_scope_stack != 0 do
		stack_len = vec_len_rt(g_scope_stack)
		if stack_len > 1 do
			cur_frame = vec_get_rt(g_scope_stack, stack_len - 1)
			names = vec_get_rt(cur_frame, 0)
			vregs = vec_get_rt(cur_frame, 1)
			types = vec_get_rt(cur_frame, 2)
			fn = vec_len_rt(names)
			var fi = 0
			when fi < fn loop
				vname = vec_get_rt(names, fi) as string
				pv = vec_get_rt(vregs, fi)
				pt = vec_get_rt(types, fi) as string
				if pv >= 0 do
					buckets_set_var(g_current_func_buckets, vname, pv)
				else
					buckets_remove_var(g_current_func_buckets, vname)
				end
				if (pt as i64) != 0 and fat_str_len(pt) > 0 do
					set_var_type(vname, pt)
				else
					set_var_type(vname, fat_str_new(""))
				end
				fi = fi + 1
			end
			vec_pop_rt(g_scope_stack)
		else
			if stack_len == 1 do
				vec_pop_rt(g_scope_stack)
			end
		end
	end
end.

func emit_jump(b: MirBuilder, target: i64):
	ins = mir_instr_new(MirOp.Jump, mir_opnd_none(), mir_opnd_imm(target), mir_opnd_none())
	b = builder_add_instr(b, ins)
    cb = native_read_i64(b as i64, 0)
	b = builder_add_edge(b, cb, target)
	out b
end.

func emit_jump_if(b: MirBuilder, cond: MirOperand, then_id: i64, else_id: i64):
	ins = mir_instr_new(MirOp.JumpIf, mir_opnd_none(), cond, mir_opnd_imm(then_id))
	b = builder_add_instr(b, ins)
	ins2 = mir_instr_new(MirOp.Jump, mir_opnd_none(), mir_opnd_imm(else_id), mir_opnd_none())
	b = builder_add_instr(b, ins2)
    cb = native_read_i64(b as i64, 0)
	b = builder_add_edge(b, cb, then_id)
	b = builder_add_edge(b, cb, else_id)
	out b
end.

func emit_set_arg(b: MirBuilder, idx: i64, val: MirOperand):
	ins = mir_instr_new(MirOp.SetArg, mir_opnd_none(), mir_opnd_imm(idx), val)
	out builder_add_instr(b, ins)
end.

func emit_intrinsic(b: MirBuilder, kind: i64, dst: MirOperand, src1: MirOperand):
	ins = mir_instr_new(MirOp.Intrinsic, dst, src1, mir_opnd_imm(kind))
	out builder_add_instr(b, ins)
end.

func emit_jump_if_not(b: MirBuilder, cond: MirOperand, then_id: i64, else_id: i64):
    # JumpIfNot → jump to then_id when cond==0 (false); else fall through to else_id.
    cb = native_read_i64(b as i64, 0)
	ins = mir_instr_new(MirOp.JumpIfNot, mir_opnd_none(), cond, mir_opnd_imm(then_id))
	b = builder_add_instr(b, ins)
    # Add edge to then_id (the exit/break branch) — required for correct dominance frontier
    b = builder_add_edge(b, cb, then_id)
	b = emit_jump(b, else_id)
	out b
end.

func emit_move(b: MirBuilder, dst_v: i64, src: MirOperand):
	ins = mir_instr_new(MirOp.Move, mir_opnd_vreg(dst_v), src, mir_opnd_none())
	out builder_add_instr(b, ins)
end.

func emit_store(b: MirBuilder, addr: MirOperand, val: MirOperand):
	ins = mir_instr_new(MirOp.Store, mir_opnd_none(), val, addr)
	out builder_add_instr(b, ins)
end.

func emit_load(b: MirBuilder, dst_v: i64, addr: MirOperand):
	ins = mir_instr_new(MirOp.Load, mir_opnd_vreg(dst_v), addr, mir_opnd_none())
	out builder_add_instr(b, ins)
end.

func lower_aggregate(b: MirBuilder, kind: i64, expr: AstNode):
	# Arrays / entities / tuples all lower to a heap buffer of n 8-byte slots.
	# Allocate via the `alloc` builtin (id 3) and store each element with
	# INDEX_STORE so the element count is not bounded by the ABI arg registers.
	n = ast_node_child_count(expr)
	if kind == MIR_INTR_ARRAY do
		b_mut = emit_set_arg(b, 0, mir_opnd_imm(16 + n * 8))
		var (b_base, base) = builder_new_vreg(b_mut)
		b_base = emit_intrinsic(b_base, MIR_INTR_BUILTIN, mir_opnd_vreg(base), mir_opnd_imm(3))
		b_mut = b_base
		b_mut = emit_set_arg(b_mut, 0, mir_opnd_vreg(base))
		b_mut = emit_set_arg(b_mut, 1, mir_opnd_imm(0))
		b_mut = emit_set_arg(b_mut, 2, mir_opnd_imm(n))
		b_mut = emit_intrinsic(b_mut, MIR_INTR_BUILTIN, mir_opnd_none(), mir_opnd_imm(8))
		b_mut = emit_set_arg(b_mut, 0, mir_opnd_vreg(base))
		b_mut = emit_set_arg(b_mut, 1, mir_opnd_imm(8))
		b_mut = emit_set_arg(b_mut, 2, mir_opnd_imm(n))
		b_mut = emit_intrinsic(b_mut, MIR_INTR_BUILTIN, mir_opnd_none(), mir_opnd_imm(8))
		var i = 0
		when i < n loop
			var (b2, aop) = lower_expr(b_mut, ast_node_child(expr, i))
			b2 = emit_set_arg(b2, 0, mir_opnd_imm(i))
			b2 = emit_set_arg(b2, 1, aop)
			b2 = emit_intrinsic(b2, MIR_INTR_INDEX_STORE, mir_opnd_none(), mir_opnd_vreg(base))
			b_mut = b2
			i = i + 1
		end
		out (b_mut, mir_opnd_vreg(base))
	end
	# Entity / Tuple: flat 8-byte fields starting at offset 0
	b_mut = emit_set_arg(b, 0, mir_opnd_imm(n * 8))
	var (b_base, base) = builder_new_vreg(b_mut)
	b_base = emit_intrinsic(b_base, MIR_INTR_BUILTIN, mir_opnd_vreg(base), mir_opnd_imm(3))
	b_mut = b_base
	var i = 0
	when i < n loop
		var (b2, aop) = lower_expr(b_mut, ast_node_child(expr, i))
		b2 = emit_set_arg(b2, 0, mir_opnd_vreg(base))
		b2 = emit_set_arg(b2, 1, mir_opnd_imm(i * 8))
		b2 = emit_set_arg(b2, 2, aop)
		b2 = emit_intrinsic(b2, MIR_INTR_BUILTIN, mir_opnd_none(), mir_opnd_imm(8)) # write_word(base, i*8, aop)
		b_mut = b2
		i = i + 1
	end
	out (b_mut, mir_opnd_vreg(base))
end.

# NOTE: Do NOT pre-declare function stubs.

func as_ast_node(n: AstNode):
	out n
end.
func ast_node_name(n: AstNode):
	out n.name
end.
func ast_node_name2(n: AstNode):
	out n.name2
end.
func ast_node_type_of(n: AstNode):
	out n.node_type
end.
func ast_node_op_of(n: AstNode):
	out n.op
end.
func ast_node_line(n: AstNode):
	out n.line
end.
func ast_node_int_val(n: AstNode):
	out n.int_val
end.
func ast_node_float_val(n: AstNode):
	out n.float_val
end.
func ast_node_builtin_id(n: AstNode):
	out n.builtin_id
end.

func builtin_id_from_name_uncached(name: string):
    # Name → BuiltinId discriminant. Used when ast_add_child clobbers .builtin_id
    # (soft ABI) so LIR would otherwise BL the unresolved stub (returns 0).
    if fat_cstr_eq(name, "len") == 1 do out 1 end
    if fat_cstr_eq(name, "push") == 1 do out 2 end
    if fat_cstr_eq(name, "arr_push") == 1 do out 2 end
    if fat_cstr_eq(name, "alloc") == 1 or fat_cstr_eq(name, "vir_alloc") == 1 do out 3 end
    if fat_cstr_eq(name, "dealloc") == 1 or fat_cstr_eq(name, "free") == 1 or fat_cstr_eq(name, "vir_free") == 1 do out 4 end
    if fat_cstr_eq(name, "read_byte") == 1 or fat_cstr_eq(name, "native_read_u8") == 1 or fat_cstr_eq(name, "read_u8") == 1 or fat_cstr_eq(name, "read8") == 1 do out 5 end
    if fat_cstr_eq(name, "write_byte") == 1 or fat_cstr_eq(name, "native_write_u8") == 1 or fat_cstr_eq(name, "write_u8") == 1 or fat_cstr_eq(name, "write8") == 1 do out 6 end
    if fat_cstr_eq(name, "read_word") == 1 or fat_cstr_eq(name, "native_read_i64") == 1 or fat_cstr_eq(name, "read_i64") == 1 or fat_cstr_eq(name, "read64") == 1 do out 7 end
    if fat_cstr_eq(name, "write_word") == 1 or fat_cstr_eq(name, "native_write_i64") == 1 or fat_cstr_eq(name, "write_i64") == 1 or fat_cstr_eq(name, "write64") == 1 do out 8 end
    if fat_cstr_eq(name, "memset") == 1 or fat_cstr_eq(name, "__memset") == 1 or fat_cstr_eq(name, "fill_bytes") == 1 or fat_cstr_eq(name, "native_mem_set") == 1 do out 32 end
    if fat_cstr_eq(name, "memcpy") == 1 or fat_cstr_eq(name, "__memcpy") == 1 or fat_cstr_eq(name, "native_mem_copy") == 1 do out 31 end
    if fat_cstr_eq(name, "str_len") == 1 do out 9 end
    if fat_cstr_eq(name, "str_get") == 1 do out 10 end
    if fat_cstr_eq(name, "__clz") == 1 or fat_cstr_eq(name, "clz") == 1 do out 33 end
    if fat_cstr_eq(name, "__ctz") == 1 or fat_cstr_eq(name, "ctz") == 1 do out 34 end
    if fat_cstr_eq(name, "__popcnt") == 1 or fat_cstr_eq(name, "popcnt") == 1 do out 35 end
    if fat_cstr_eq(name, "__not") == 1 do out 37 end
    if fat_cstr_eq(name, "__neg") == 1 do out 38 end
    if fat_cstr_eq(name, "str_cat") == 1 do out 11 end
    if fat_cstr_eq(name, "str_concat") == 1 do out 11 end
    if fat_cstr_eq(name, "strcat") == 1 do out 11 end
    if fat_cstr_eq(name, "str_eq") == 1 do out 12 end
    if fat_cstr_eq(name, "file_open") == 1 or fat_cstr_eq(name, "native_file_open") == 1 do out 13 end
    if fat_cstr_eq(name, "file_read") == 1 or fat_cstr_eq(name, "native_file_read") == 1 do out 14 end
    if fat_cstr_eq(name, "file_write") == 1 or fat_cstr_eq(name, "native_file_write") == 1 do out 15 end
    if fat_cstr_eq(name, "file_close") == 1 or fat_cstr_eq(name, "native_file_close") == 1 do out 16 end
    if fat_cstr_eq(name, "file_write_byte") == 1 do out 17 end
    if fat_cstr_eq(name, "exit_prog") == 1 do out 18 end
    if fat_cstr_eq(name, "exit") == 1 do out 18 end
    if fat_cstr_eq(name, "i_to_str") == 1 do out 19 end
    if fat_cstr_eq(name, "int_to_str") == 1 do out 19 end
    if fat_cstr_eq(name, "itoa") == 1 do out 19 end
    if fat_cstr_eq(name, "str_to_i") == 1 do out 20 end
    if fat_cstr_eq(name, "str_to_int") == 1 do out 20 end
    if fat_cstr_eq(name, "arr_new") == 1 do out 21 end
    if fat_cstr_eq(name, "print_str") == 1 do out 22 end
    if fat_cstr_eq(name, "get_arg") == 1 or fat_cstr_eq(name, "rt_argv") == 1 or fat_cstr_eq(name, "rt_get_arg") == 1 do out 23 end
    if fat_cstr_eq(name, "arg_count") == 1 or fat_cstr_eq(name, "rt_argc") == 1 do out 24 end
    if fat_cstr_eq(name, "slurp_file") == 1 do out 25 end
    if fat_cstr_eq(name, "slurp_len") == 1 do out 26 end
    if fat_cstr_eq(name, "write_bytes") == 1 do out 27 end
    if fat_cstr_eq(name, "arr_len") == 1 do out 1 end
    if fat_cstr_eq(name, "atomic_load") == 1 do out 40 end
    if fat_cstr_eq(name, "atomic_store") == 1 do out 41 end
    if fat_cstr_eq(name, "atomic_cas") == 1 do out 42 end
    if fat_cstr_eq(name, "atomic_add") == 1 do out 43 end
    if fat_cstr_eq(name, "atomic_sub") == 1 do out 44 end
    if fat_cstr_eq(name, "atomic_exchange") == 1 do out 71 end
    if fat_cstr_eq(name, "atomic_swap") == 1 do out 71 end
    if fat_cstr_eq(name, "atomic_fence") == 1 do out 39 end
    if fat_cstr_eq(name, "atomic_load32") == 1 do out 72 end
    if fat_cstr_eq(name, "atomic_store32") == 1 do out 73 end
    if fat_cstr_eq(name, "atomic_add32") == 1 do out 74 end
    if fat_cstr_eq(name, "atomic_sub32") == 1 do out 75 end
    if fat_cstr_eq(name, "atomic_cas32") == 1 do out 76 end
    if fat_cstr_eq(name, "atomic_exchange32") == 1 do out 77 end
    if fat_cstr_eq(name, "atomic_swap32") == 1 do out 77 end
    if fat_cstr_eq(name, "atomic_load64") == 1 do out 78 end
    if fat_cstr_eq(name, "atomic_store64") == 1 do out 79 end
    if fat_cstr_eq(name, "atomic_add64") == 1 do out 80 end
    if fat_cstr_eq(name, "atomic_sub64") == 1 do out 81 end
    if fat_cstr_eq(name, "atomic_cas64") == 1 do out 82 end
    if fat_cstr_eq(name, "atomic_exchange64") == 1 do out 83 end
    if fat_cstr_eq(name, "atomic_swap64") == 1 do out 83 end
    if fat_cstr_eq(name, "arena_new") == 1 do out 49 end
    if fat_cstr_eq(name, "arena_alloc") == 1 do out 50 end
    if fat_cstr_eq(name, "arena_free") == 1 do out 51 end
    # syscallN helpers — all map to BuiltinId.Syscall = 30
    if fat_cstr_eq(name, "syscall0") == 1 do out 30 end
    if fat_cstr_eq(name, "syscall1") == 1 do out 30 end
    if fat_cstr_eq(name, "syscall2") == 1 do out 30 end
    if fat_cstr_eq(name, "syscall3") == 1 do out 30 end
    if fat_cstr_eq(name, "syscall4") == 1 do out 30 end
    if fat_cstr_eq(name, "syscall5") == 1 do out 30 end
    if fat_cstr_eq(name, "syscall6") == 1 do out 30 end
    if fat_cstr_eq(name, "port") == 1 do out 90 end
    out 0
end.

func builtin_id_from_name(name: string):
    if g_builtin_lookup_buckets == 0 do
        g_builtin_lookup_buckets = vec_new_rt()
        var bi = 0
        when bi < MIR_VAR_BUCKETS loop
            g_builtin_lookup_buckets = vec_push_rt(g_builtin_lookup_buckets, vec_new_rt())
            bi = bi + 1
        end
    end
    bucket_id = name_hash_bucket(name)
    bucket = vec_get_rt(g_builtin_lookup_buckets, bucket_id)
    count = vec_len_rt(bucket)
    var i = 0
    when i + 1 < count loop
        if fat_str_eq(vec_get_rt(bucket, i) as string, name) == 1 do
            out vec_get_rt(bucket, i + 1)
        end
        i = i + 2
    end
    builtin_id = builtin_id_from_name_uncached(name)
    bucket = vec_push_rt(bucket, name as i64)
    bucket = vec_push_rt(bucket, builtin_id)
    vec_set_rt(g_builtin_lookup_buckets, bucket_id, bucket)
    out builtin_id
end.

func resolve_builtin_id(expr: AstNode):
    bid = ast_node_builtin_id(expr) as i64
    if bid >= 1 and bid <= 100 do
        out bid
    end
    out builtin_id_from_name(ast_node_name(expr))
end.
func ast_node_children(n: AstNode):
	out n.children
end.
func ast_node_child(n: AstNode, i: i64):
    kids = n.children
	out vec_get_rt(kids, i) as AstNode
end.
func ast_node_child_count(n: AstNode):
    kids = n.children
	out vec_len_rt(kids)
end.

func lower_call_args(b: MirBuilder, expr: AstNode, start_child: i64, arg_base: i64):
    # Stage into fresh vregs first — a nested call clobbers X0..Xn / prior SetArgs.
	if g_mir_scratch_args == 0 do g_mir_scratch_args = vec_new_rt() end
	scratch_start = g_mir_scratch_top
	n = ast_node_child_count(expr)
	var i = start_child
	var ai = 0
	b_mut = b
	when i < n loop
		arg = ast_node_child(expr, i)
		var (b2, aop) = lower_expr(b_mut, arg)
		if g_mir_scratch_top < vec_len_rt(g_mir_scratch_args) do
			vec_set_rt(g_mir_scratch_args, g_mir_scratch_top, aop as i64)
		else
			g_mir_scratch_args = vec_push_rt(g_mir_scratch_args, aop as i64)
		end
		g_mir_scratch_top = g_mir_scratch_top + 1
		b_mut = b2
		ai = ai + 1
		i = i + 1
	end
	var j = 0
	when j < ai loop
		b_mut = emit_set_arg(b_mut, arg_base + j, vec_get_rt(g_mir_scratch_args, scratch_start + j))
		j = j + 1
	end
	g_mir_scratch_top = scratch_start
	out (b_mut, ai)
end.

func lower_expr_impl(b: MirBuilder, expr: AstNode):
	expr_type = ast_node_type_of(expr)

    # 1. Literal Int
	if expr_type == AstType.LiteralInt do
		var (b2, v) = builder_new_vreg(b)
		ins = mir_instr_new(MirOp.Move, mir_opnd_vreg(v), mir_opnd_imm(ast_node_int_val(expr)), mir_opnd_none())
		b2 = builder_add_instr(b2, ins)
		out (b2, mir_opnd_vreg(v))
	end

    # 2. Literal Float (raw bits in int_val for now)
	if expr_type == AstType.LiteralFloat do
		var (b2, v) = builder_new_vreg(b)
		ins = mir_instr_new(MirOp.Move, mir_opnd_vreg(v), mir_opnd_imm(ast_node_int_val(expr)), mir_opnd_none())
		b2 = builder_add_instr(b2, ins)
		out (b2, mir_opnd_vreg(v))
	end

    # 3. Literal Str — src1 = string-pool id
	if expr_type == AstType.LiteralStr do
		var (b1, sid) = builder_intern(b, ast_node_name(expr))
		var (b2, v) = builder_new_vreg(b1)
		b2 = emit_intrinsic(b2, MIR_INTR_STR_LIT, mir_opnd_vreg(v), mir_opnd_imm(sid))
		out (b2, mir_opnd_vreg(v))
	end

    # 3b. InterpExpr
	if expr_type == AstType.InterpExpr do
		var (b1, sid) = builder_intern(b, ast_node_name(expr))
		var (b2, v) = builder_new_vreg(b1)
		b2 = emit_intrinsic(b2, MIR_INTR_INTERP, mir_opnd_vreg(v), mir_opnd_imm(sid))
		out (b2, mir_opnd_vreg(v))
	end

    # 4. Identifier
	if expr_type == AstType.Identifier do
		fname = ast_node_name(expr)
		v = get_var_vreg(b, fname)
		if v >= 0 do
			out (b, mir_opnd_vreg(v))
		else
            if fat_cstr_eq(fname, "true") == 1 do
                out (b, mir_opnd_imm(1))
            end
            if fat_cstr_eq(fname, "false") == 1 do
                out (b, mir_opnd_imm(0))
            end
            if fat_cstr_eq(fname, "null") == 1 do
                out (b, mir_opnd_imm(0))
            end
            if g_const_hash > 0 do
                c_idx = hash_table_lookup(g_const_hash, g_const_names, fname)
                if c_idx >= 0 do
                    c_val = vec_get_rt(g_const_values, c_idx)
                    out (b, mir_opnd_imm(c_val))
                end
            end
			global_slot = global_slot_lookup(fname)
			if global_slot >= 0 do
				var (b_global, global_vreg) = builder_new_vreg(b)
				b_global = emit_intrinsic(b_global, MIR_INTR_GLOBAL_LOAD, mir_opnd_vreg(global_vreg), mir_opnd_imm(global_slot))
				out (b_global, mir_opnd_vreg(global_vreg))
			end
			var (b1, cid) = builder_intern(b, fname)
			var (b2, dst) = builder_new_vreg(b1)
			b2 = emit_intrinsic(b2, MIR_INTR_ADDR_OF, mir_opnd_vreg(dst), mir_opnd_imm(cid))
			out (b2, mir_opnd_vreg(dst))
		end
	end

    # 5. BinOp & Compare — full OpType→MirOp; Land/Lor → CFG (no silent Add)
	if expr_type == AstType.BinOp or expr_type == AstType.Compare do
		child_count = ast_node_child_count(expr)
		if child_count >= 2 do
			left = ast_node_child(expr, 0)
			right = ast_node_child(expr, 1)
			mop_i = mir_op_from_optype(ast_node_op_of(expr))

            # Land: if !lhs → 0 else rhs
			if mop_i == -2 do
				var (b1, opnd_l) = lower_expr(b, left)
				var (b2, dst) = builder_new_vreg(b1)
				var (b3, rhs_id) = builder_add_block(b2)
				var (b4, end_id) = builder_add_block(b3)
				b4 = emit_move(b4, dst, mir_opnd_imm(0))
				b4 = emit_jump_if_not(b4, opnd_l, end_id, rhs_id)
				b4 = builder_set_current_block(b4, rhs_id)
				var (b5, opnd_r) = lower_expr(b4, right)
				b5 = emit_move(b5, dst, opnd_r)
				b5 = emit_jump(b5, end_id)
				b5 = builder_set_current_block(b5, end_id)
				out (b5, mir_opnd_vreg(dst))
			end

            # Lor: if lhs → 1 else rhs
			if mop_i == -3 do
				var (b1, opnd_l) = lower_expr(b, left)
				var (b2, dst) = builder_new_vreg(b1)
				var (b3, rhs_id) = builder_add_block(b2)
				var (b4, end_id) = builder_add_block(b3)
				b4 = emit_move(b4, dst, mir_opnd_imm(1))
				b4 = emit_jump_if(b4, opnd_l, end_id, rhs_id)
				b4 = builder_set_current_block(b4, rhs_id)
				var (b5, opnd_r) = lower_expr(b4, right)
				b5 = emit_move(b5, dst, opnd_r)
				b5 = emit_jump(b5, end_id)
				b5 = builder_set_current_block(b5, end_id)
				out (b5, mir_opnd_vreg(dst))
			end

            # PatternOp `:~` → MIR_INTR_PATTERN
			if mop_i == -4 do
				var (b3, opnd_l) = lower_expr(b, left)
				var (b4, opnd_r) = lower_expr(b3, right)
				var (b5, dst) = builder_new_vreg(b4)
				b5 = emit_set_arg(b5, 0, opnd_l)
				b5 = emit_set_arg(b5, 1, opnd_r)
				out (emit_intrinsic(b5, MIR_INTR_PATTERN, mir_opnd_vreg(dst), opnd_l), mir_opnd_vreg(dst))
			end

			if mop_i < 0 do
                # Unknown OpType — emit Nop marker, return 0 (never default Add)
				var (b1, dst) = builder_new_vreg(b)
				b1 = emit_intrinsic(b1, MIR_INTR_NOP_MARKER, mir_opnd_vreg(dst), mir_opnd_imm(ast_node_op_of(expr) as i64))
				out (b1, mir_opnd_vreg(dst))
			end

			var (b3, opnd_l) = lower_expr(b, left)
			var (b4, opnd_r) = lower_expr(b3, right)
			var (b5, dst) = builder_new_vreg(b4)
			var m_op = MirOp.Add
			if mop_i == 5 do m_op = MirOp.Sub end
			if mop_i == 6 do m_op = MirOp.Mul end
			if mop_i == 7 do m_op = MirOp.Div end
			if mop_i == 19 do m_op = MirOp.Mod end
			if mop_i == 13 do m_op = MirOp.CmpEq end
			if mop_i == 14 do m_op = MirOp.CmpNe end
			if mop_i == 15 do m_op = MirOp.CmpGt end
			if mop_i == 16 do m_op = MirOp.CmpLt end
			if mop_i == 17 do m_op = MirOp.CmpGe end
			if mop_i == 18 do m_op = MirOp.CmpLe end
			if mop_i == 22 do m_op = MirOp.And end
			if mop_i == 23 do m_op = MirOp.Or end
			if mop_i == 24 do m_op = MirOp.Xor end
			if mop_i == 25 do m_op = MirOp.Shl end
			if mop_i == 26 do m_op = MirOp.Shr end
			if mop_i == 28 do m_op = MirOp.Pow end
			if mop_i == 29 do m_op = MirOp.MatMul end
			if mop_i == 30 do m_op = MirOp.Fma end
			if mop_i == 4 do m_op = MirOp.Add end
			ins = mir_instr_new(m_op, mir_opnd_vreg(dst), opnd_l, opnd_r)
			if mop_i == 29 do
				var dim_m = 2
				var dim_k = 2
				var dim_n = 2
				var left_t = ""
				var right_t = ""
				if ast_node_type_of(left) == AstType.Identifier do
					left_t = get_var_type(ast_node_name(left))
				end
				if ast_node_type_of(right) == AstType.Identifier do
					right_t = get_var_type(ast_node_name(right))
				end
				if is_tensor_type_str(left_t) and is_tensor_type_str(right_t) do
					shape_a = parse_tensor_shape(left_t)
					shape_b = parse_tensor_shape(right_t)
					if vec_len_rt(shape_a) >= 2 and vec_len_rt(shape_b) >= 2 do
						dim_m = vec_get_rt(shape_a, 0) as int
						dim_k = vec_get_rt(shape_a, 1) as int
						dim_n = vec_get_rt(shape_b, 1) as int
					end
				end
				let aux_val = (dim_m shl 32) + (dim_k shl 16) + dim_n
				mir_instr_set_aux(ins, aux_val)
			end
			b5 = builder_add_instr(b5, ins)
			out (b5, mir_opnd_vreg(dst))
		end
	end

    # 5b. UnaryNot → MirOp.Not
	if expr_type == AstType.UnaryNot do
		if ast_node_child_count(expr) > 0 do
			var (b2, opnd) = lower_expr(b, ast_node_child(expr, 0))
			var (b3, dst) = builder_new_vreg(b2)
			ins = mir_instr_new(MirOp.Not, mir_opnd_vreg(dst), opnd, mir_opnd_none())
			b3 = builder_add_instr(b3, ins)
			out (b3, mir_opnd_vreg(dst))
		end
	end

    # 5c. Swizzle / SafeAccess
	if expr_type == AstType.SwizzleExpr do
		var (b1, mid) = builder_intern(b, ast_node_name(expr))
		if ast_node_child_count(expr) > 0 do
			var (b2, base) = lower_expr(b1, ast_node_child(expr, 0))
			var (b3, dst) = builder_new_vreg(b2)
			b3 = emit_set_arg(b3, 0, base)
			b3 = emit_set_arg(b3, 1, mir_opnd_imm(mid))
			out (emit_intrinsic(b3, MIR_INTR_SWIZZLE, mir_opnd_vreg(dst), mir_opnd_imm(mid)), mir_opnd_vreg(dst))
		end
	end
	if expr_type == AstType.SafeAccessExpr do
		var (b1, fid) = builder_intern(b, ast_node_name(expr))
		if ast_node_child_count(expr) > 0 do
			var (b2, base) = lower_expr(b1, ast_node_child(expr, 0))
			var (b3, dst) = builder_new_vreg(b2)
			b3 = emit_set_arg(b3, 0, base)
			b3 = emit_set_arg(b3, 1, mir_opnd_imm(fid))
			out (emit_intrinsic(b3, MIR_INTR_SAFE_ACCESS, mir_opnd_vreg(dst), mir_opnd_imm(fid)), mir_opnd_vreg(dst))
		end
	end

    # 5d. Erx / Task / Wait / Quantize
	if expr_type == AstType.ErxExpr do
		var (b1, dst) = builder_new_vreg(b)
		out (emit_intrinsic(b1, MIR_INTR_ERX, mir_opnd_vreg(dst), mir_opnd_none()), mir_opnd_vreg(dst))
	end
	if expr_type == AstType.TaskExpr do
		if ast_node_child_count(expr) > 0 do
			var (b2, v) = lower_expr(b, ast_node_child(expr, 0))
			var (b3, dst) = builder_new_vreg(b2)
			out (emit_intrinsic(b3, MIR_INTR_TASK, mir_opnd_vreg(dst), v), mir_opnd_vreg(dst))
		end
	end
	if expr_type == AstType.WaitExpr do
		if ast_node_child_count(expr) > 0 do
			var (b2, v) = lower_expr(b, ast_node_child(expr, 0))
			var (b3, dst) = builder_new_vreg(b2)
			out (emit_intrinsic(b3, MIR_INTR_WAIT, mir_opnd_vreg(dst), v), mir_opnd_vreg(dst))
		end
	end
	if expr_type == AstType.QuantizeExpr do
		if ast_node_child_count(expr) > 0 do
			var (b2, v) = lower_expr(b, ast_node_child(expr, 0))
			var (b3, dst) = builder_new_vreg(b2)
			out (emit_intrinsic(b3, MIR_INTR_QUANTIZE, mir_opnd_vreg(dst), v), mir_opnd_vreg(dst))
		end
	end

    # 6. Call — SetArg* then Call(dst, nargs); src2 = callee string-pool id
	if expr_type == AstType.Call do
		# Positional entity construction `Ent(v0, v1, ...)` parses as a Call
		# reclassify to an aggregate when the callee names an entity type.
		callee = resolve_callee_alias(ast_node_name(expr))
		if is_entity_name(callee) == 1 do
			out lower_aggregate(b, MIR_INTR_ENTITY, expr)
		end
		# Parser lookup_builtin can miss (fat vs C-string table names) and
		# emit a Call instead of BuiltinCall. Reclassify by callee name.
		b_id = builtin_id_from_name(callee)
		if b_id > 0 do
			if b_id == 9 and ast_node_child_count(expr) >= 1 do
				arg0 = ast_node_child(expr, 0)
				if ast_node_type_of(arg0) == AstType.LiteralStr do
					slen = fat_str_len(ast_node_name(arg0))
					out (b, mir_opnd_imm(slen))
				end
			end
			var (b2, nargs) = lower_call_args(b, expr, 0, 0)
			var (b3, dst) = builder_new_vreg(b2)
			out (emit_intrinsic(b3, MIR_INTR_BUILTIN, mir_opnd_vreg(dst), mir_opnd_imm(b_id)), mir_opnd_vreg(dst))
		end
		# Dynamic / Indirect Call: if callee is a local variable in scope
		callee_vreg = get_var_vreg(b, callee)
		if callee_vreg >= 0 do
			var (b2, nargs) = lower_call_args(b, expr, 0, 0)
			var (b3, dst) = builder_new_vreg(b2)
			ins = mir_instr_new(MirOp.Call, mir_opnd_vreg(dst), mir_opnd_imm(nargs), mir_opnd_vreg(callee_vreg))
			b3 = builder_add_instr(b3, ins)
			out (b3, mir_opnd_vreg(dst))
		end
		var (b1, cid) = builder_intern(b, callee)
		var (b2, nargs) = lower_call_args(b1, expr, 0, 0)
		var (b3, dst) = builder_new_vreg(b2)
		ins = mir_instr_new(MirOp.Call, mir_opnd_vreg(dst), mir_opnd_imm(nargs), mir_opnd_imm(cid))
		b3 = builder_add_instr(b3, ins)
		out (b3, mir_opnd_vreg(dst))
	end

    # 6b. BuiltinCall — port/lock/atomic map to MIR_INTR_*; else BUILTIN+Call
	if expr_type == AstType.BuiltinCall do
		if fat_cstr_eq(ast_node_name(expr), "__mir_send") or fat_cstr_eq(ast_node_name(expr), "port_send") do
			var (b2, nargs) = lower_call_args(b, expr, 0, 0)
			var (b3, dst) = builder_new_vreg(b2)
			out (emit_intrinsic(b3, MIR_INTR_SEND, mir_opnd_vreg(dst), mir_opnd_imm(nargs)), mir_opnd_vreg(dst))
		end
		if fat_cstr_eq(ast_node_name(expr), "__mir_recv") or fat_cstr_eq(ast_node_name(expr), "port_recv") do
			var (b2, nargs) = lower_call_args(b, expr, 0, 0)
			var (b3, dst) = builder_new_vreg(b2)
			out (emit_intrinsic(b3, MIR_INTR_RECV, mir_opnd_vreg(dst), mir_opnd_imm(nargs)), mir_opnd_vreg(dst))
		end
		if fat_cstr_eq(ast_node_name(expr), "__mir_lock") or fat_cstr_eq(ast_node_name(expr), "atomic_bang") do
			var (b2, nargs) = lower_call_args(b, expr, 0, 0)
			var (b3, dst) = builder_new_vreg(b2)
			var kind = MIR_INTR_LOCK
			if fat_cstr_eq(ast_node_name(expr), "atomic_bang") do
				kind = MIR_INTR_ATOMIC
			end
			out (emit_intrinsic(b3, kind, mir_opnd_vreg(dst), mir_opnd_imm(nargs)), mir_opnd_vreg(dst))
		end
        bid = resolve_builtin_id(expr)
        if bid == 9 and ast_node_child_count(expr) >= 1 do
            arg0 = ast_node_child(expr, 0)
            if ast_node_type_of(arg0) == AstType.LiteralStr do
                slen = fat_str_len(ast_node_name(arg0))
                out (b, mir_opnd_imm(slen))
            end
        end
		var (b2, nargs) = lower_call_args(b, expr, 0, 0)
		var (b3, dst) = builder_new_vreg(b2)
		out (emit_intrinsic(b3, MIR_INTR_BUILTIN, mir_opnd_vreg(dst), mir_opnd_imm(bid)), mir_opnd_vreg(dst))
	end

    # 6c. MethodCall — SetArg(0)=recv; src2 = method name id
	if expr_type == AstType.MethodCall do
		var (b0, mid) = builder_intern(b, ast_node_name(expr))
		nch = ast_node_child_count(expr)
		b_mut = b0
		var nargs = 0
		if nch > 0 do
			recv = ast_node_child(expr, 0)
			var (b2, rop) = lower_expr(b_mut, recv)
			b_mut = emit_set_arg(b2, 0, rop)
			nargs = 1
			var (b3, rest) = lower_call_args(b_mut, expr, 1, 1)
			b_mut = b3
			nargs = nargs + rest
		end
		var (b4, dst) = builder_new_vreg(b_mut)
		ins = mir_instr_new(MirOp.Call, mir_opnd_vreg(dst), mir_opnd_imm(nargs), mir_opnd_imm(mid))
		b4 = builder_add_instr(b4, ins)
		out (b4, mir_opnd_vreg(dst))
	end

    # 5e. PatternExpr / ExistExpr / Map / ArrCompact / Bundle / Error / Ptr
	if expr_type == AstType.PatternExpr do
		if ast_node_child_count(expr) >= 2 do
			var (b3, opnd_l) = lower_expr(b, ast_node_child(expr, 0))
			var (b4, opnd_r) = lower_expr(b3, ast_node_child(expr, 1))
			var (b5, dst) = builder_new_vreg(b4)
			b5 = emit_set_arg(b5, 0, opnd_l)
			b5 = emit_set_arg(b5, 1, opnd_r)
			out (emit_intrinsic(b5, MIR_INTR_PATTERN, mir_opnd_vreg(dst), opnd_l), mir_opnd_vreg(dst))
		end
	end
	if expr_type == AstType.ExistExpr do
		if ast_node_child_count(expr) > 0 do
			var (b2, v) = lower_expr(b, ast_node_child(expr, 0))
			var (b3, dst) = builder_new_vreg(b2)
			out (emit_intrinsic(b3, MIR_INTR_EXIST, mir_opnd_vreg(dst), v), mir_opnd_vreg(dst))
		end
	end
	if expr_type == AstType.MapExpr do
		var (b2, nargs) = lower_call_args(b, expr, 0, 0)
		var (b3, dst) = builder_new_vreg(b2)
		out (emit_intrinsic(b3, MIR_INTR_MAP, mir_opnd_vreg(dst), mir_opnd_imm(nargs)), mir_opnd_vreg(dst))
	end
	if expr_type == AstType.ArrCompactExpr do
		var (b2, nargs) = lower_call_args(b, expr, 0, 0)
		var (b3, dst) = builder_new_vreg(b2)
		out (emit_intrinsic(b3, MIR_INTR_ARR_COMPACT, mir_opnd_vreg(dst), mir_opnd_imm(nargs)), mir_opnd_vreg(dst))
	end
	if expr_type == AstType.BundleExpr do
		child_count = ast_node_child_count(expr)
		if child_count > 0 do
			c0 = ast_node_child(expr, 0)
			if ast_node_type_of(c0) == AstType.LiteralStr do
				var (b1, sid) = builder_intern(b, ast_node_name(c0))
				var (b2, dst) = builder_new_vreg(b1)
				out (emit_intrinsic(b2, MIR_INTR_STR_LIT, mir_opnd_vreg(dst), mir_opnd_imm(sid)), mir_opnd_vreg(dst))
			end
		end
		var (b2, nargs) = lower_call_args(b, expr, 0, 0)
		var (b3, dst) = builder_new_vreg(b2)
		out (emit_intrinsic(b3, MIR_INTR_BUNDLE, mir_opnd_vreg(dst), mir_opnd_imm(nargs)), mir_opnd_vreg(dst))
	end
	if expr_type == AstType.ErrorExpr do
		var (b1, dst) = builder_new_vreg(b)
		out (emit_intrinsic(b1, MIR_INTR_ERROR, mir_opnd_vreg(dst), mir_opnd_none()), mir_opnd_vreg(dst))
	end
	if expr_type == AstType.PtrTypeExpr do
        fname = ast_node_name(expr)
        v = get_var_vreg(b, fname)
        if v >= 0 do
            out (b, mir_opnd_vreg(v))
        end
		var (b1, pid) = builder_intern(b, fname)
		var (b2, dst) = builder_new_vreg(b1)
		out (emit_intrinsic(b2, MIR_INTR_PTR, mir_opnd_vreg(dst), mir_opnd_imm(pid)), mir_opnd_vreg(dst))
	end

    # 7. UnaryMinus
	if expr_type == AstType.UnaryMinus do
		child_count = ast_node_child_count(expr)
		if child_count > 0 do
			child = ast_node_child(expr, 0)
			var (b2, child_opnd) = lower_expr(b, child)
			var (b3, dst) = builder_new_vreg(b2)
			ins = mir_instr_new(MirOp.Sub, mir_opnd_vreg(dst), mir_opnd_imm(0), child_opnd)
			b3 = builder_add_instr(b3, ins)
			out (b3, mir_opnd_vreg(dst))
		end
	end

    # 7b. AddrOf — shared (&) / mut (&mut); SetArg0 = mut flag
	if expr_type == AstType.AddrOf do
		child_count = ast_node_child_count(expr)
		if child_count > 0 do
			child = ast_node_child(expr, 0)
			var (b2, child_opnd) = lower_expr(b, child)
			var (b3, dst) = builder_new_vreg(b2)
			mutf = 0
			if fat_cstr_eq(ast_node_name(expr), "mut") do
				mutf = 1
			end
			b3 = emit_set_arg(b3, 0, mir_opnd_imm(mutf))
			b3 = emit_intrinsic(b3, MIR_INTR_ADDR_OF, mir_opnd_vreg(dst), child_opnd)
			out (b3, mir_opnd_vreg(dst))
		end
	end

	if expr_type == AstType.PrecompBlock do
		if ast_node_child_count(expr) > 0 do
			out lower_expr(b, ast_node_child(expr, 0))
		end
		out (b, mir_opnd_imm(0))
	end

    # 8. Aggregate literals — SetArg each element then Intrinsic
 if expr_type == AstType.ArrayLiteral do
 out lower_aggregate(b, MIR_INTR_ARRAY, expr)
 end
 if expr_type == AstType.TupleExpr do
 out lower_aggregate(b, MIR_INTR_TUPLE, expr)
 end
 if expr_type == AstType.EntityLiteral do
 out lower_aggregate(b, MIR_INTR_ENTITY, expr)
 end

    # 9. Index — shapes: children[base,idx] OR name=base + children[idx]
	if expr_type == AstType.IndexAccess or expr_type == AstType.ExprIndex do
		if fat_cstr_eq(ast_node_name2(expr), "__slice__") == 1 do
			bv = get_var_vreg(b, ast_node_name(expr))
			var (b2, start_op) = lower_expr(b, ast_node_child(expr, 0))
			var (b3, end_op) = lower_expr(b2, ast_node_child(expr, 1))
			var (b4, slen_vreg) = builder_new_vreg(b3)
			ins_sub = mir_instr_new(MirOp.Sub, mir_opnd_vreg(slen_vreg), end_op, start_op)
			b4 = builder_add_instr(b4, ins_sub)

			var (b5, tmp8) = builder_new_vreg(b4)
			ins_mul = mir_instr_new(MirOp.Mul, mir_opnd_vreg(tmp8), mir_opnd_vreg(slen_vreg), mir_opnd_imm(8))
			b5 = builder_add_instr(b5, ins_mul)
			var (b6, alloc_sz) = builder_new_vreg(b5)
			ins_add = mir_instr_new(MirOp.Add, mir_opnd_vreg(alloc_sz), mir_opnd_vreg(tmp8), mir_opnd_imm(16))
			b6 = builder_add_instr(b6, ins_add)

			b6 = emit_set_arg(b6, 0, mir_opnd_vreg(alloc_sz))
			var (b7, dst_base) = builder_new_vreg(b6)
			b7 = emit_intrinsic(b7, MIR_INTR_BUILTIN, mir_opnd_vreg(dst_base), mir_opnd_imm(3))

			b7 = emit_set_arg(b7, 0, mir_opnd_vreg(dst_base))
			b7 = emit_set_arg(b7, 1, mir_opnd_imm(0))
			b7 = emit_set_arg(b7, 2, mir_opnd_vreg(slen_vreg))
			b7 = emit_intrinsic(b7, MIR_INTR_BUILTIN, mir_opnd_none(), mir_opnd_imm(8))

			b7 = emit_set_arg(b7, 0, mir_opnd_vreg(dst_base))
			b7 = emit_set_arg(b7, 1, mir_opnd_imm(8))
			b7 = emit_set_arg(b7, 2, mir_opnd_vreg(slen_vreg))
			b7 = emit_intrinsic(b7, MIR_INTR_BUILTIN, mir_opnd_none(), mir_opnd_imm(8))

			var (b8, iv) = builder_new_vreg(b7)
			ins0 = mir_instr_new(MirOp.Move, mir_opnd_vreg(iv), mir_opnd_imm(0), mir_opnd_none())
			b8 = builder_add_instr(b8, ins0)
			loop_var_name = fat_str_concat(fat_str_new("__slice_i_"), ast_node_name(expr))
			b8 = set_var_vreg(b8, loop_var_name, iv)

			var (b9, cond_id) = builder_add_block(b8)
			var (b10, body_id) = builder_add_block(b9)
			var (b11, step_id) = builder_add_block(b10)
			var (b12, end_id) = builder_add_block(b11)

			b12 = emit_jump(b12, cond_id)
			b12 = builder_push_loop(b12, end_id, step_id)
			b12 = builder_set_current_block(b12, cond_id)

			iv_cur = get_var_vreg(b12, loop_var_name)
			var (b13, cmpv) = builder_new_vreg(b12)
			insc = mir_instr_new(MirOp.CmpLt, mir_opnd_vreg(cmpv), mir_opnd_vreg(iv_cur), mir_opnd_vreg(slen_vreg))
			b13 = builder_add_instr(b13, insc)
			b13 = emit_jump_if_not(b13, mir_opnd_vreg(cmpv), end_id, body_id)

			b13 = builder_set_current_block(b13, body_id)
			var (b14, src_idx) = builder_new_vreg(b13)
			ins_src = mir_instr_new(MirOp.Add, mir_opnd_vreg(src_idx), start_op, mir_opnd_vreg(iv_cur))
			b14 = builder_add_instr(b14, ins_src)

			var (b15, elem_val) = builder_new_vreg(b14)
			b15 = emit_set_arg(b15, 0, mir_opnd_vreg(src_idx))
			b15 = emit_intrinsic(b15, MIR_INTR_INDEX, mir_opnd_vreg(elem_val), mir_opnd_vreg(bv))

			b15 = emit_set_arg(b15, 0, mir_opnd_vreg(iv_cur))
			b15 = emit_set_arg(b15, 1, mir_opnd_vreg(elem_val))
			b15 = emit_intrinsic(b15, MIR_INTR_INDEX_STORE, mir_opnd_none(), mir_opnd_vreg(dst_base))

			b15 = emit_jump(b15, step_id)
			b15 = builder_set_current_block(b15, step_id)
			iv_cur2 = get_var_vreg(b15, loop_var_name)
			var (b16, ivn) = builder_new_vreg(b15)
			ins_add1 = mir_instr_new(MirOp.Add, mir_opnd_vreg(ivn), mir_opnd_vreg(iv_cur2), mir_opnd_imm(1))
			b16 = builder_add_instr(b16, ins_add1)
			ins_mov1 = mir_instr_new(MirOp.Move, mir_opnd_vreg(iv_cur2), mir_opnd_vreg(ivn), mir_opnd_none())
			b16 = builder_add_instr(b16, ins_mov1)
			b16 = set_var_vreg(b16, loop_var_name, iv_cur2)
			b16 = emit_jump(b16, cond_id)
			b16 = builder_pop_loop(b16)
			b16 = builder_set_current_block(b16, end_id)

			out (b16, mir_opnd_vreg(dst_base))
		end
	nch = ast_node_child_count(expr)
	b_mut = b
	base = mir_opnd_none()
	var vtype = ""
	var start_idx = 0
	var num_idx = 0
	if expr_type == AstType.IndexAccess do
		base_name = ast_node_name(expr)
		bv = get_var_vreg(b_mut, base_name)
		if bv >= 0 do
			base = mir_opnd_vreg(bv)
		end
		vtype = get_var_type(base_name)
		start_idx = 0
		num_idx = nch
	else
		var (b_base, base_op) = lower_expr(b_mut, ast_node_child(expr, 0))
		b_mut = b_base
		base = base_op
		start_idx = 1
		num_idx = nch - 1
	end

	flat_opnd = mir_opnd_none()
	if num_idx <= 1 do
		if num_idx == 1 do
			var (b_idx, idx_op) = lower_expr(b_mut, ast_node_child(expr, start_idx))
			b_mut = b_idx
			flat_opnd = idx_op
		else
			flat_opnd = mir_opnd_imm(0)
		end
	else
		var k = 0
		when k < num_idx loop
			idx_ast = ast_node_child(expr, start_idx + k)
			var (b_next, idx_op) = lower_expr(b_mut, idx_ast)
			b_mut = b_next
			stride = 1
			if is_tensor_type_str(vtype) do
				stride = parse_tensor_stride(vtype, k)
			else
				if k == 0 and num_idx == 2 do stride = 2 end
			end
			term_op = idx_op
			if stride > 1 do
				var (b_mul, mul_v) = builder_new_vreg(b_mut)
				ins_m = mir_instr_new(MirOp.Mul, mir_opnd_vreg(mul_v), idx_op, mir_opnd_imm(stride))
				b_mut = builder_add_instr(b_mul, ins_m)
				term_op = mir_opnd_vreg(mul_v)
			end
			if k == 0 do
				flat_opnd = term_op
			else
				var (b_add, add_v) = builder_new_vreg(b_mut)
				ins_a = mir_instr_new(MirOp.Add, mir_opnd_vreg(add_v), flat_opnd, term_op)
				b_mut = builder_add_instr(b_add, ins_a)
				flat_opnd = mir_opnd_vreg(add_v)
			end
			k = k + 1
		end
	end

	if base.op_type != MirOperandType.None do
		var (b4, dst) = builder_new_vreg(b_mut)
		b4 = emit_set_arg(b4, 0, flat_opnd)
		b4 = emit_intrinsic(b4, MIR_INTR_INDEX, mir_opnd_vreg(dst), base)
		out (b4, mir_opnd_vreg(dst))
	end
	end
	if expr_type == AstType.FieldAccess do
		nch = ast_node_child_count(expr)
		if nch >= 1 do
			base_ast = ast_node_child(expr, 0)
			if ast_node_type_of(base_ast) == AstType.Identifier do
				base_name_str = ast_node_name(base_ast)
				dot_str = fat_str_new(".")
				field_name_str = ast_node_name(expr)
				key = fat_str_concat(base_name_str, dot_str)
				key = fat_str_concat(key, field_name_str)
				if g_const_hash > 0 do
					c_idx = hash_table_lookup(g_const_hash, g_const_names, key)
					if c_idx >= 0 do
						c_val = vec_get_rt(g_const_values, c_idx)
						out (b, mir_opnd_imm(c_val))
					end
				end
				base_name = ast_node_name(base_ast)
				bv = get_var_vreg(b, base_name)
				gv = global_slot_lookup(base_name)
				if bv < 0 and gv < 0 do
					print_str("virc: error: unresolved symbol or enum: base=")
					print_str(native_read_i64(base_name, 0))
					print_str(" field=")
					print_ln(native_read_i64(field_name_str, 0))
					sys_exit(1)
					out (b, mir_opnd_imm(0))
				end
			end
			var (b2, base) = lower_expr(b, base_ast)
			fname = ast_node_name(expr)
			if is_register_field(fname) == 1 do
				start_bit = get_register_field_start(fname)
				width = get_register_field_width(fname)
				var (b3, dst) = builder_new_vreg(b2)
				let pack_info = MIR_INTR_BIT_EXTRACT or (start_bit shl 8) or (width shl 16)
				ins = mir_instr_new(MirOp.Intrinsic, mir_opnd_vreg(dst), base, mir_opnd_imm(pack_info))
				b3 = builder_add_instr(b3, ins)
				out (b3, mir_opnd_vreg(dst))
			end
			var (b3, dst) = builder_new_vreg(b2)
			base_type = get_expr_entity_type(base_ast)
			var fid = 0 - 1
			if fat_str_len(base_type) > 0 do
				fid = get_scoped_field_index(base_type, fname)
			end
			if fid < 0 do
				base_name = ast_node_name(base_ast)
				fid = find_field_index_for_base(base_name, fname)
			end
			var (b4, addr) = builder_new_vreg(b3)
			ins_a = mir_instr_new(MirOp.Add, mir_opnd_vreg(addr), base, mir_opnd_imm(fid * 8))
			b4 = builder_add_instr(b4, ins_a)
			b4 = emit_load(b4, dst, mir_opnd_vreg(addr))
			out (b4, mir_opnd_vreg(dst))
		end
	end

    # 10. EnumAccess — name::name2
	if expr_type == AstType.EnumAccess do
		enum_name_str = ast_node_name(expr)
		dot_str = fat_str_new(".")
		variant_name_str = ast_node_name2(expr)
		key = fat_str_concat(enum_name_str, dot_str)
		key = fat_str_concat(key, variant_name_str)
		if g_const_hash > 0 do
			c_idx = hash_table_lookup(g_const_hash, g_const_names, key)
			if c_idx >= 0 do
				c_val = vec_get_rt(g_const_values, c_idx)
				out (b, mir_opnd_imm(c_val))
			end
		end
		print_str("virc: error: unresolved enum variant: enum=")
		print_str(native_read_i64(enum_name_str, 0))
		print_str(" variant=")
		print_ln(native_read_i64(variant_name_str, 0))
		sys_exit(1)
		out (b, mir_opnd_imm(0))
	end

    # 11. InputExpr
 if expr_type == AstType.InputExpr do
 var (b2, dst) = builder_new_vreg(b)
 b2 = emit_intrinsic(b2, MIR_INTR_INPUT, mir_opnd_vreg(dst), mir_opnd_none())
 out (b2, mir_opnd_vreg(dst))
 end

    # 12. CastExpr — identity Move (+ CAST marker for typed backends)
 if expr_type == AstType.CastExpr do
 nch = ast_node_child_count(expr)
 if nch > 0 do
 var (b2, child_opnd) = lower_expr(b, ast_node_child(expr, 0))
 var (b3, dst) = builder_new_vreg(b2)
 b3 = emit_move(b3, dst, child_opnd)
 b3 = emit_intrinsic(b3, MIR_INTR_CAST, mir_opnd_vreg(dst), mir_opnd_vreg(dst))
 out (b3, mir_opnd_vreg(dst))
 end
 end

    # 13. AwaitExpr — await expr | await pass
 if expr_type == AstType.AwaitExpr do
 if fat_cstr_eq(ast_node_name(expr), "pass") do
 var (b2, dst) = builder_new_vreg(b)
 b2 = emit_intrinsic(b2, MIR_INTR_AWAIT_PASS, mir_opnd_vreg(dst), mir_opnd_none())
 out (b2, mir_opnd_vreg(dst))
 end
 nch = ast_node_child_count(expr)
 if nch > 0 do
 var (b2, child_opnd) = lower_expr(b, ast_node_child(expr, 0))
 var (b3, dst) = builder_new_vreg(b2)
 b3 = emit_intrinsic(b3, MIR_INTR_AWAIT, mir_opnd_vreg(dst), child_opnd)
 out (b3, mir_opnd_vreg(dst))
 end
 end

    # 15. CheckCpu / PatchPoint
 if expr_type == AstType.CheckCpu do
 var (b2, dst) = builder_new_vreg(b)
 b2 = emit_intrinsic(b2, MIR_INTR_CHECK_CPU, mir_opnd_vreg(dst), mir_opnd_none())
 out (b2, mir_opnd_vreg(dst))
 end
	if expr_type == AstType.PatchPoint do
		var (b1, pid) = builder_intern(b, ast_node_name(expr))
		var (b2, dst) = builder_new_vreg(b1)
		b2 = emit_intrinsic(b2, MIR_INTR_PATCH_POINT, mir_opnd_vreg(dst), mir_opnd_imm(pid))
		out (b2, mir_opnd_vreg(dst))
	end

    # 14. NamedArg — children[0] is value (name on .name)
	if expr_type == AstType.NamedArg do
		nch = ast_node_child_count(expr)
		if nch > 0 do
			out lower_expr(b, ast_node_child(expr, 0))
		end
	end

	out (b, mir_opnd_none())
end.

func lower_expr(b: MirBuilder, expr: AstNode):
	out lower_expr_impl(b, expr)
end.

func lower_stmt_impl(b: MirBuilder, stmt: AstNode):
	stmt_type = ast_node_type_of(stmt)

    # 1. VarDecl & ConstDecl
	if stmt_type == AstType.VarDecl or stmt_type == AstType.ConstDecl do
		if ast_node_int_val(stmt) == 16384 do
			child_count = ast_node_child_count(stmt)
			if child_count > 1 do
				init_expr = ast_node_child(stmt, child_count - 1)
				var (b2, base_opnd) = lower_expr(b, init_expr)
				var b_curr = b2
				var i = 0
				when i < child_count - 1 loop
					var_ident = ast_node_child(stmt, i)
					var_name = ast_node_name(var_ident)
					# Tuples/entities are flat aggregates. MIR_INTR_INDEX is for Vec
					# storage and adds a 16-byte capacity/length header, so using it
					# here made `(a, b) = pair()` read beyond the returned object.
					var (b_addr, elem_addr) = builder_new_vreg(b_curr)
					b_addr = builder_add_instr(b_addr, mir_instr_new(MirOp.Add, mir_opnd_vreg(elem_addr), base_opnd, mir_opnd_imm(i * 8)))
					var (b_elem, dst_v) = builder_new_vreg(b_addr)
					b_elem = emit_load(b_elem, dst_v, mir_opnd_vreg(elem_addr))
					record_var_declaration(var_name)
					b_elem = set_var_vreg(b_elem, var_name, dst_v)
					b_curr = b_elem
					i = i + 1
				end
				out b_curr
			end
			out b
		end
		child_count = ast_node_child_count(stmt)
		if child_count > 0 do
			expr = ast_node_child(stmt, 0)
			var (b2, val_opnd) = lower_expr(b, expr)
			var (b3, v) = builder_new_vreg(b2)
			ins = mir_instr_new(MirOp.Move, mir_opnd_vreg(v), val_opnd, mir_opnd_none())
			b3 = builder_add_instr(b3, ins)
			record_var_declaration(ast_node_name(stmt))
			b3 = set_var_vreg(b3, ast_node_name(stmt), v)
			var var_t = ast_node_name2(stmt)
			if var_t == 0 or fat_str_len(var_t) == 0 do
				var expr_nt = ast_node_type_of(expr)
				if expr_nt == AstType.EntityLiteral or expr_nt == AstType.Call do
					var cname = resolve_callee_alias(ast_node_name(expr))
					if is_entity_name(cname) == 1 do
						var_t = cname
					end
				end
				if expr_nt == AstType.BinOp and ast_node_op_of(expr) == OpType.MatMulOp do
					left_n = ast_node_child(expr, 0)
					right_n = ast_node_child(expr, 1)
					left_t = get_var_type(ast_node_name(left_n))
					right_t = get_var_type(ast_node_name(right_n))
					if is_tensor_type_str(left_t) and is_tensor_type_str(right_t) do
						shape_a = parse_tensor_shape(left_t)
						shape_b = parse_tensor_shape(right_t)
						if vec_len_rt(shape_a) >= 2 and vec_len_rt(shape_b) >= 2 do
							dim_m = vec_get_rt(shape_a, 0) as i64
							dim_n = vec_get_rt(shape_b, 1) as i64
							# Determine element type prefix from left operand
							var elem_prefix = fat_str_new("tensor<int>")
							var pt_len = fat_str_len(left_t)
							var is_float_elem = false
							var ci2 = 0
							when ci2 < pt_len loop
								let cc = fat_str_byte_at(left_t, ci2)
								if cc == 102 or cc == 70 do is_float_elem = true end
								ci2 = ci2 + 1
							end
							if is_float_elem do
								elem_prefix = fat_str_new("tensor<f32>")
							end
							var_t = fat_str_concat(elem_prefix, fat_str_new("["))
							var_t = fat_str_concat(var_t, fat_str_new(rt_itoa(dim_m)))
							var_t = fat_str_concat(var_t, fat_str_new(","))
							var_t = fat_str_concat(var_t, fat_str_new(rt_itoa(dim_n)))
							var_t = fat_str_concat(var_t, fat_str_new("]"))
						end
					end
				end
			end
			if var_t != 0 and fat_str_len(var_t) > 0 do
				set_var_type(ast_node_name(stmt), var_t)
			end
			out b3
		end
		decl_name = ast_node_name(stmt)
		var_t = ast_node_name2(stmt)
		record_var_declaration(decl_name)
		if var_t != 0 and is_tensor_type_str(var_t) do
			numel = parse_tensor_numel(var_t)
			if numel <= 0 do numel = 4 end
			alloc_sz = 16 + numel * 8
			b_mut = emit_set_arg(b, 0, mir_opnd_imm(alloc_sz))
			var (b_base, base_vr) = builder_new_vreg(b_mut)
			b_base = emit_intrinsic(b_base, MIR_INTR_BUILTIN, mir_opnd_vreg(base_vr), mir_opnd_imm(3))
			b_base = emit_set_arg(b_base, 0, mir_opnd_vreg(base_vr))
			b_base = emit_set_arg(b_base, 1, mir_opnd_imm(0))
			b_base = emit_set_arg(b_base, 2, mir_opnd_imm(numel))
			b_base = emit_intrinsic(b_base, MIR_INTR_BUILTIN, mir_opnd_none(), mir_opnd_imm(8))
			b_base = emit_set_arg(b_base, 0, mir_opnd_vreg(base_vr))
			b_base = emit_set_arg(b_base, 1, mir_opnd_imm(8))
			b_base = emit_set_arg(b_base, 2, mir_opnd_imm(numel))
			b_base = emit_intrinsic(b_base, MIR_INTR_BUILTIN, mir_opnd_none(), mir_opnd_imm(8))
			b_base = set_var_vreg(b_base, decl_name, base_vr)
			set_var_type(decl_name, var_t)
			out b_base
		end
		out b
	end

	if stmt_type == AstType.Assign do
		child_count = ast_node_child_count(stmt)
		var expr = 0
		var target_name = ast_node_name(stmt)
		if child_count >= 2 do
			target_name = ast_node_name(ast_node_child(stmt, 0))
			expr = ast_node_child(stmt, 1)
		else
			expr = ast_node_child(stmt, 0)
		end
		if expr != 0 do
			var expr_nt = ast_node_type_of(expr)
			if expr_nt == AstType.EntityLiteral or expr_nt == AstType.Call do
				var cname = resolve_callee_alias(ast_node_name(expr))
				if is_entity_name(cname) == 1 do
					set_var_type(target_name, cname)
				end
			end
			if expr_nt == AstType.BinOp and ast_node_op_of(expr) == OpType.MatMulOp do
				left_n = ast_node_child(expr, 0)
				right_n = ast_node_child(expr, 1)
				left_t = get_var_type(ast_node_name(left_n))
				right_t = get_var_type(ast_node_name(right_n))
				if is_tensor_type_str(left_t) and is_tensor_type_str(right_t) do
					shape_a = parse_tensor_shape(left_t)
					shape_b = parse_tensor_shape(right_t)
					if vec_len_rt(shape_a) >= 2 and vec_len_rt(shape_b) >= 2 do
						dim_m = vec_get_rt(shape_a, 0) as i64
						dim_n = vec_get_rt(shape_b, 1) as i64
						# Detect float element type from left operand
						var elem_prefix = fat_str_new("tensor<int>")
						var pt_len = fat_str_len(left_t)
						var is_float = false
						var ci = 0
						when ci < pt_len loop
							let cc = fat_str_byte_at(left_t, ci)
							if cc == 102 or cc == 70 do is_float = true end
							ci = ci + 1
						end
						if is_float do
							elem_prefix = fat_str_new("tensor<f32>")
						end
						var mm_type = fat_str_concat(elem_prefix, fat_str_new("["))
						mm_type = fat_str_concat(mm_type, fat_str_new(rt_itoa(dim_m)))
						mm_type = fat_str_concat(mm_type, fat_str_new(","))
						mm_type = fat_str_concat(mm_type, fat_str_new(rt_itoa(dim_n)))
						mm_type = fat_str_concat(mm_type, fat_str_new("]"))
						set_var_type(target_name, mm_type)
					end
				end
			end
		end
		var (b2, val_opnd) = lower_expr(b, expr)
		v = get_var_vreg(b2, target_name)
		if v >= 0 do
			b2 = emit_move(b2, v, val_opnd)
			out b2
		end
		global_slot = global_slot_lookup(target_name)
		if global_slot >= 0 do
			out emit_intrinsic(b2, MIR_INTR_GLOBAL_STORE, mir_opnd_imm(global_slot), val_opnd)
		end
		var (b3, v2) = builder_new_vreg(b2)
		b3 = emit_move(b3, v2, val_opnd)
		b3 = set_var_vreg(b3, target_name, v2)
		out b3
	end

    # 2b. IndexAssign — name[idx, ...] = val → INDEX_STORE
	if stmt_type == AstType.IndexAssign do
		child_count = ast_node_child_count(stmt)
		if child_count >= 2 do
			vname = ast_node_name(stmt)
			bv = get_var_vreg(b, vname)
			vtype = get_var_type(vname)
			val_expr = ast_node_child(stmt, child_count - 1)
			num_indices = child_count - 1
			b_cur = b
			flat_opnd = mir_opnd_none()
			if num_indices == 1 do
				var (b2, idx) = lower_expr(b_cur, ast_node_child(stmt, 0))
				b_cur = b2
				flat_opnd = idx
			else
				var k = 0
				when k < num_indices loop
					idx_ast = ast_node_child(stmt, k)
					var (b_next, idx_op) = lower_expr(b_cur, idx_ast)
					b_cur = b_next
					stride = 1
					if is_tensor_type_str(vtype) do
						stride = parse_tensor_stride(vtype, k)
					else
						if k == 0 and num_indices == 2 do stride = 2 end
					end
					term_op = idx_op
					if stride > 1 do
						var (b_mul, mul_v) = builder_new_vreg(b_cur)
						ins_m = mir_instr_new(MirOp.Mul, mir_opnd_vreg(mul_v), idx_op, mir_opnd_imm(stride))
						b_cur = builder_add_instr(b_mul, ins_m)
						term_op = mir_opnd_vreg(mul_v)
					end
					if k == 0 do
						flat_opnd = term_op
					else
						var (b_add, add_v) = builder_new_vreg(b_cur)
						ins_a = mir_instr_new(MirOp.Add, mir_opnd_vreg(add_v), flat_opnd, term_op)
						b_cur = builder_add_instr(b_add, ins_a)
						flat_opnd = mir_opnd_vreg(add_v)
					end
					k = k + 1
				end
			end
			var (b3, val) = lower_expr(b_cur, val_expr)
			if bv >= 0 do
				b3 = emit_set_arg(b3, 0, flat_opnd)
				b3 = emit_set_arg(b3, 1, val)
				b3 = emit_intrinsic(b3, MIR_INTR_INDEX_STORE, mir_opnd_none(), mir_opnd_vreg(bv))
			end
			out b3
		end
		out b
	end

	if stmt_type == AstType.FieldAssign do
		child_count = ast_node_child_count(stmt)
		if child_count >= 1 do
			var fld_name = ast_node_name2(stmt)
			var base_name = ast_node_name(stmt)
			if child_count >= 2 do
				base_ast = ast_node_child(stmt, 1)
				if ast_node_type_of(base_ast) == AstType.Identifier do
					base_name = ast_node_name(base_ast)
				end
			end
			var bv = get_var_vreg(b, base_name)
			if is_register_field(fld_name) == 1 and bv >= 0 do
				var (b2, val) = lower_expr(b, ast_node_child(stmt, 0))
				start_bit = get_register_field_start(fld_name)
				width = get_register_field_width(fld_name)
				let pack_info = MIR_INTR_BIT_INSERT or (start_bit shl 8) or (width shl 16)
				b2 = emit_set_arg(b2, 0, val)
				var (b3, new_vreg) = builder_new_vreg(b2)
				ins = mir_instr_new(MirOp.Intrinsic, mir_opnd_vreg(new_vreg), mir_opnd_vreg(bv), mir_opnd_imm(pack_info))
				b3 = builder_add_instr(b3, ins)
				out set_var_vreg(b3, base_name, new_vreg)
			end
			var (b2, val) = lower_expr(b, ast_node_child(stmt, 0))
			var base_opnd = mir_opnd_none()
			var base_type = fat_str_new("")
			var b_curr = b2
			if child_count >= 2 do
				base_ast = ast_node_child(stmt, 1)
				base_type = get_expr_entity_type(base_ast)
				var (b_b, b_op) = lower_expr(b_curr, base_ast)
				b_curr = b_b
				base_opnd = b_op
			else
				base_type = get_var_type(base_name)
				if bv >= 0 do
					base_opnd = mir_opnd_vreg(bv)
				end
			end
			if (base_opnd as i64) != 0 and native_read_i64(base_opnd as i64, 0) != MirOperandType.None do
				var fid = 0 - 1
				if fat_str_len(base_type) > 0 do
					fid = get_scoped_field_index(base_type, fld_name)
				end
				if fid < 0 do
					base_name = ast_node_name(stmt)
					fid = find_field_index_for_base(base_name, fld_name)
				end
				var (b3, addr) = builder_new_vreg(b_curr)
				ins_a = mir_instr_new(MirOp.Add, mir_opnd_vreg(addr), base_opnd, mir_opnd_imm(fid * 8))
				b3 = builder_add_instr(b3, ins_a)
				out emit_store(b3, mir_opnd_vreg(addr), val)
			end
			out b_curr
		end
		out b
	end

    # 3. IfStmt
	if stmt_type == AstType.IfStmt do
		cond_expr = ast_node_child(stmt, 0)
		then_block = ast_node_child(stmt, 1)
		var (b2, cond_opnd) = lower_expr(b, cond_expr)
		has_else = ast_node_child_count(stmt) > 2
		var (b3, then_id) = builder_add_block(b2)
		var else_id = 0
		var b4 = b3
		if has_else do
			var (b4_2, else_id_2) = builder_add_block(b3)
			b4 = b4_2
			else_id = else_id_2
		end
		var (b5, end_id) = builder_add_block(b4)
		if has_else == false do
			else_id = end_id
		end
		b5 = emit_jump_if(b5, cond_opnd, then_id, else_id)
		b5 = builder_set_current_block(b5, then_id)
		b5 = lower_stmt(b5, then_block)
		if not builder_current_block_terminated(b5) do
			b5 = emit_jump(b5, end_id)
		end
		if has_else do
			else_block = ast_node_child(stmt, 2)
			b5 = builder_set_current_block(b5, else_id)
			b5 = lower_stmt(b5, else_block)
			if not builder_current_block_terminated(b5) do
				b5 = emit_jump(b5, end_id)
			end
		end
		b5 = builder_set_current_block(b5, end_id)
		out b5
	end

    # 4. WhileStmt — JumpIfNot(cond, end) else Jump(body)
	if stmt_type == AstType.WhileStmt do
		cond_expr = ast_node_child(stmt, 0)
		body_block = ast_node_child(stmt, 1)
		var (b2, cond_id) = builder_add_block(b)
		var (b3, body_id) = builder_add_block(b2)
		var (b4, end_id) = builder_add_block(b3)
		b4 = emit_jump(b4, cond_id)
		b4 = builder_push_loop(b4, end_id, cond_id)
		b4 = builder_set_current_block(b4, cond_id)
		var (b5, cond_opnd) = lower_expr(b4, cond_expr)
		b5 = emit_jump_if_not(b5, cond_opnd, end_id, body_id)
		b5 = builder_set_current_block(b5, body_id)
		b5 = lower_stmt(b5, body_block)
		if not builder_current_block_terminated(b5) do
			b5 = emit_jump(b5, cond_id)
		end
		b5 = builder_pop_loop(b5)
		b5 = builder_set_current_block(b5, end_id)
		out b5
	end

    # 4b. LoopStmt — counted: i in 0..count
	if stmt_type == AstType.LoopStmt do
		count_expr = ast_node_child(stmt, 0)
		body_block = ast_node_child(stmt, 1)
		var (b2, count_opnd) = lower_expr(b, count_expr)
		var (b3, iv) = builder_new_vreg(b2)
		ins0 = mir_instr_new(MirOp.Move, mir_opnd_vreg(iv), mir_opnd_imm(0), mir_opnd_none())
		b3 = builder_add_instr(b3, ins0)
		var (b4, cond_id) = builder_add_block(b3)
		var (b5, body_id) = builder_add_block(b4)
		var (b6, step_id) = builder_add_block(b5)
		var (b7, end_id) = builder_add_block(b6)
		b7 = emit_jump(b7, cond_id)
		b7 = builder_push_loop(b7, end_id, step_id)
		b7 = builder_set_current_block(b7, cond_id)
		var (b8, cmpv) = builder_new_vreg(b7)
		insc = mir_instr_new(MirOp.CmpLt, mir_opnd_vreg(cmpv), mir_opnd_vreg(iv), count_opnd)
		b8 = builder_add_instr(b8, insc)
		b8 = emit_jump_if_not(b8, mir_opnd_vreg(cmpv), end_id, body_id)
		b8 = builder_set_current_block(b8, body_id)
		b8 = lower_stmt(b8, body_block)
		if not builder_current_block_terminated(b8) do
			b8 = emit_jump(b8, step_id)
		end
		b8 = builder_set_current_block(b8, step_id)
        # Non-SSA induction: redefine same vreg (SSA rename comes later).
		var (b9, iv2) = builder_new_vreg(b8)
		ins1 = mir_instr_new(MirOp.Add, mir_opnd_vreg(iv2), mir_opnd_vreg(iv), mir_opnd_imm(1))
		b9 = builder_add_instr(b9, ins1)
		insm = mir_instr_new(MirOp.Move, mir_opnd_vreg(iv), mir_opnd_vreg(iv2), mir_opnd_none())
		b9 = builder_add_instr(b9, insm)
		b9 = emit_jump(b9, cond_id)
		b9 = builder_pop_loop(b9)
		b9 = builder_set_current_block(b9, end_id)
		out b9
	end

    # 5. Block
	if stmt_type == AstType.Block do
		push_scope()
		child_count = ast_node_child_count(stmt)
		var i = 0
		b_mut = b
		when i < child_count loop
			child = ast_node_child(stmt, i)
			b_mut = lower_stmt(b_mut, child)
			if builder_current_block_terminated(b_mut) do
				break
			end
			i = i + 1
		end
		pop_scope()
		out b_mut
	end

    # 6. ReturnStmt
	if stmt_type == AstType.ReturnStmt do
		child_count = ast_node_child_count(stmt)
		if child_count > 0 do
			var (b2, ret_opnd) = lower_expr(b, ast_node_child(stmt, 0))
			ins = mir_instr_new(MirOp.Return, mir_opnd_none(), ret_opnd, mir_opnd_none())
			b2 = builder_add_instr(b2, ins)
			out b2
		else
			ins = mir_instr_new(MirOp.Return, mir_opnd_none(), mir_opnd_none(), mir_opnd_none())
			b2 = builder_add_instr(b, ins)
			out b2
		end
	end

    # 7. PrintStmt
	if stmt_type == AstType.PrintStmt do
		child_count = ast_node_child_count(stmt)
		if child_count > 0 do
			expr = ast_node_child(stmt, 0)
			var (b2, val_opnd) = lower_expr(b, expr)
			if ast_node_type_of(expr) == AstType.LiteralStr or ast_node_type_of(expr) == AstType.InterpExpr do
				b2 = emit_intrinsic(b2, MIR_INTR_PRINT_STR, mir_opnd_none(), val_opnd)
			else
				b2 = emit_intrinsic(b2, MIR_INTR_PRINT, mir_opnd_none(), val_opnd)
			end
			out b2
		end
		out b
	end

    # 8. Break / Continue
	if stmt_type == AstType.BreakStmt do
		lt = builder_loop_top(b)
		brk = loop_target_break_block(lt)
		if brk >= 0 do
			out emit_jump(b, brk)
		end
		out b
	end
	if stmt_type == AstType.ContinueStmt do
		lt = builder_loop_top(b)
		cnt = loop_target_continue_block(lt)
		if cnt >= 0 do
			out emit_jump(b, cnt)
		end
		out b
	end

    # 9. CaseExpr — children: [target, pat, body, pat, body, ...]
	if stmt_type == AstType.CaseExpr do
		child_count = ast_node_child_count(stmt)
		if child_count >= 1 do
			target_expr = ast_node_child(stmt, 0)
			var (b2, target_opnd) = lower_expr(b, target_expr)
			var (b3, end_id) = builder_add_block(b2)
			var i = 1
			b_mut = b3
			when i + 1 < child_count loop
				pat = ast_node_child(stmt, i)
				body = ast_node_child(stmt, i + 1)
				var (b4, arm_id) = builder_add_block(b_mut)
				var (b5, next_id) = builder_add_block(b4)
                # Wildcard / else
				is_wild = 0
				if ast_node_type_of(pat) == AstType.Identifier do
					if fat_cstr_eq(ast_node_name(pat), "_") do
						is_wild = 1
					end
					if ast_node_int_val(pat) == 0 - 1 do
						is_wild = 1
					end
				end
				if is_wild != 0 do
					b5 = emit_jump(b5, arm_id)
				else
					if ast_node_type_of(pat) == AstType.BinaryExpr or ast_node_type_of(pat) == AstType.RangeExpr do
						low_node = ast_node_child(pat, 0)
						high_node = ast_node_child(pat, 1)
						var (b5_1, v_ge) = builder_new_vreg(b5)
						ins_ge = mir_instr_new(MirOp.CmpGe, mir_opnd_vreg(v_ge), target_opnd, mir_opnd_imm(ast_node_int_val(low_node)))
						b5_1 = builder_add_instr(b5_1, ins_ge)
						var (b5_2, v_lt) = builder_new_vreg(b5_1)
						ins_lt = mir_instr_new(MirOp.CmpLt, mir_opnd_vreg(v_lt), target_opnd, mir_opnd_imm(ast_node_int_val(high_node)))
						b5_2 = builder_add_instr(b5_2, ins_lt)
						var (b5_3, v_in_range) = builder_new_vreg(b5_2)
						ins_and = mir_instr_new(MirOp.BitAnd, mir_opnd_vreg(v_in_range), mir_opnd_vreg(v_ge), mir_opnd_vreg(v_lt))
						b5_3 = builder_add_instr(b5_3, ins_and)
						b5 = emit_jump_if(b5_3, mir_opnd_vreg(v_in_range), arm_id, next_id)
					else
					if ast_node_type_of(pat) == AstType.LiteralInt do
						var (b6, cv) = builder_new_vreg(b5)
						insc = mir_instr_new(MirOp.CmpEq, mir_opnd_vreg(cv), target_opnd, mir_opnd_imm(ast_node_int_val(pat)))
						b6 = builder_add_instr(b6, insc)
						b5 = emit_jump_if(b6, mir_opnd_vreg(cv), arm_id, next_id)
					else
						if ast_node_type_of(pat) == AstType.Identifier and fat_cstr_eq(ast_node_name(pat), "true") do
							var (b6, cv) = builder_new_vreg(b5)
							insc = mir_instr_new(MirOp.CmpEq, mir_opnd_vreg(cv), target_opnd, mir_opnd_imm(1))
							b6 = builder_add_instr(b6, insc)
							b5 = emit_jump_if(b6, mir_opnd_vreg(cv), arm_id, next_id)
						else
							if ast_node_type_of(pat) == AstType.Identifier and fat_cstr_eq(ast_node_name(pat), "false") do
								var (b6, cv) = builder_new_vreg(b5)
								insc = mir_instr_new(MirOp.CmpEq, mir_opnd_vreg(cv), target_opnd, mir_opnd_imm(0))
								b6 = builder_add_instr(b6, insc)
								b5 = emit_jump_if(b6, mir_opnd_vreg(cv), arm_id, next_id)
							else
								if ast_node_type_of(pat) == AstType.LiteralStr do
									var (b5b, pid) = builder_intern(b5, ast_node_name(pat))
									b5b = emit_set_arg(b5b, 0, mir_opnd_imm(pid))
									var (b6, cv) = builder_new_vreg(b5b)
									b6 = emit_intrinsic(b6, MIR_INTR_STR_EQ, mir_opnd_vreg(cv), target_opnd)
									b5 = emit_jump_if(b6, mir_opnd_vreg(cv), arm_id, next_id)
								else
                                    # Tagged / other — pool id in SetArg0, then MATCH_PAT
									var (b5b, pid) = builder_intern(b5, ast_node_name(pat))
									b5b = emit_set_arg(b5b, 0, mir_opnd_imm(pid))
									var (b6, cv) = builder_new_vreg(b5b)
									b6 = emit_intrinsic(b6, MIR_INTR_MATCH_PAT, mir_opnd_vreg(cv), target_opnd)
									b5 = emit_jump_if(b6, mir_opnd_vreg(cv), arm_id, next_id)
								end
							end
						end
					end
					end
				end
				b5 = builder_set_current_block(b5, arm_id)
				b5 = lower_stmt(b5, body)
				if not builder_current_block_terminated(b5) do
					b5 = emit_jump(b5, end_id)
				end
				b5 = builder_set_current_block(b5, next_id)
				b_mut = b5
				i = i + 2
			end
			if i < child_count do
				else_body = ast_node_child(stmt, i)
				b_mut = lower_stmt(b_mut, else_body)
			end
            # Fallthrough if no arm matched → end
			b_mut = emit_jump(b_mut, end_id)
			b_mut = builder_set_current_block(b_mut, end_id)
			out b_mut
		end
		out b
	end

    # 10. ForRange — name=var, children=[start, end, body]
	if stmt_type == AstType.ForRange do
		child_count = ast_node_child_count(stmt)
		if child_count >= 3 do
			start_expr = ast_node_child(stmt, 0)
			end_expr = ast_node_child(stmt, 1)
			body_stmt = ast_node_child(stmt, 2)
			var (b2, start_opnd) = lower_expr(b, start_expr)
			var (b3, end_opnd) = lower_expr(b2, end_expr)
			var (b4, iv) = builder_new_vreg(b3)
			ins0 = mir_instr_new(MirOp.Move, mir_opnd_vreg(iv), start_opnd, mir_opnd_none())
			b4 = builder_add_instr(b4, ins0)
			b4 = set_var_vreg(b4, ast_node_name(stmt), iv)
			var (b5, cond_id) = builder_add_block(b4)
			var (b6, body_id) = builder_add_block(b5)
			var (b7, step_id) = builder_add_block(b6)
			var (b8, end_id) = builder_add_block(b7)
			b8 = emit_jump(b8, cond_id)
			b8 = builder_push_loop(b8, end_id, step_id)
			b8 = builder_set_current_block(b8, cond_id)
            # Re-read iv from var_map (may be updated each iter after SSA-ish Move)
			iv_cur = get_var_vreg(b8, ast_node_name(stmt))
			var (b9, cmpv) = builder_new_vreg(b8)
			insc = mir_instr_new(MirOp.CmpLt, mir_opnd_vreg(cmpv), mir_opnd_vreg(iv_cur), end_opnd)
			b9 = builder_add_instr(b9, insc)
			b9 = emit_jump_if_not(b9, mir_opnd_vreg(cmpv), end_id, body_id)
			b9 = builder_set_current_block(b9, body_id)
			b9 = lower_stmt(b9, body_stmt)
			if not builder_current_block_terminated(b9) do
				b9 = emit_jump(b9, step_id)
			end
			b9 = builder_set_current_block(b9, step_id)
			iv_cur2 = get_var_vreg(b9, ast_node_name(stmt))
			var (b10, ivn) = builder_new_vreg(b9)
			ins1 = mir_instr_new(MirOp.Add, mir_opnd_vreg(ivn), mir_opnd_vreg(iv_cur2), mir_opnd_imm(1))
			b10 = builder_add_instr(b10, ins1)
			insm = mir_instr_new(MirOp.Move, mir_opnd_vreg(iv_cur2), mir_opnd_vreg(ivn), mir_opnd_none())
			b10 = builder_add_instr(b10, insm)
			b10 = set_var_vreg(b10, ast_node_name(stmt), iv_cur2)
			b10 = emit_jump(b10, cond_id)
			b10 = builder_pop_loop(b10)
			b10 = builder_set_current_block(b10, end_id)
			out b10
		end
		out b
	end

    # 11. EnsureBlock / RevertBlock — marker + body
	if stmt_type == AstType.EnsureBlock do
		b = emit_intrinsic(b, MIR_INTR_ENSURE, mir_opnd_none(), mir_opnd_none())
		if ast_node_child_count(stmt) > 0 do
			out lower_stmt(b, ast_node_child(stmt, 0))
		end
		out b
	end
	if stmt_type == AstType.RevertBlock do
		b = emit_intrinsic(b, MIR_INTR_REVERT, mir_opnd_none(), mir_opnd_none())
		if ast_node_child_count(stmt) > 0 do
			out lower_stmt(b, ast_node_child(stmt, 0))
		end
		out b
	end

    # 12. WhenStmt — same CFG as While (JumpIfNot)
	if stmt_type == AstType.WhenStmt do
		cond_expr = ast_node_child(stmt, 0)
		body_block = ast_node_child(stmt, 1)
		var (b2, cond_id) = builder_add_block(b)
		var (b3, body_id) = builder_add_block(b2)
		var (b4, end_id) = builder_add_block(b3)
		b4 = emit_jump(b4, cond_id)
		b4 = builder_push_loop(b4, end_id, cond_id)
		b4 = builder_set_current_block(b4, cond_id)
		var (b5, cond_opnd) = lower_expr(b4, cond_expr)
		b5 = emit_jump_if_not(b5, cond_opnd, end_id, body_id)
		b5 = builder_set_current_block(b5, body_id)
		b5 = lower_stmt(b5, body_block)
		if not builder_current_block_terminated(b5) do
			b5 = emit_jump(b5, cond_id)
		end
		b5 = builder_pop_loop(b5)
		b5 = builder_set_current_block(b5, end_id)
		out b5
	end

    # 13. Throw / Cancel / Quiet
	if stmt_type == AstType.ThrowStmt do
        # Inside a `try` body: set `err` to the thrown value and branch to the
        # revert handler. Subsequent code in this block is dead, so continue in
        # a fresh (unreachable) block to keep the CFG well-formed.
		if g_try_revert_block >= 0 do
			if ast_node_child_count(stmt) > 0 do
				var (bt, tv) = lower_expr(b, ast_node_child(stmt, 0))
				bt = emit_move(bt, g_try_err_vreg, tv)
				b = bt
			end
			b = emit_jump(b, g_try_revert_block)
			var (bd, dead_id) = builder_add_block(b)
			out builder_set_current_block(bd, dead_id)
		end
		if ast_node_child_count(stmt) > 0 do
			var (b2, v) = lower_expr(b, ast_node_child(stmt, 0))
			out emit_intrinsic(b2, MIR_INTR_THROW, mir_opnd_none(), v)
		end
		out emit_intrinsic(b, MIR_INTR_THROW, mir_opnd_none(), mir_opnd_none())
	end
	if stmt_type == AstType.CancelStmt do
		if ast_node_child_count(stmt) > 0 do
			var (b2, v) = lower_expr(b, ast_node_child(stmt, 0))
			out emit_intrinsic(b2, MIR_INTR_CANCEL, mir_opnd_none(), v)
		end
		out emit_intrinsic(b, MIR_INTR_CANCEL, mir_opnd_none(), mir_opnd_none())
	end
	if stmt_type == AstType.QuietStmt do
		if ast_node_child_count(stmt) > 0 do
			var (b2, _) = lower_expr(b, ast_node_child(stmt, 0))
			out emit_intrinsic(b2, MIR_INTR_QUIET, mir_opnd_none(), mir_opnd_none())
		end
		out b
	end

    # 14. ArenaBlock — sub-arena save and restore
	if stmt_type == AstType.ArenaBlock do
		var (b1, mark_vreg) = builder_new_vreg(b)
		b1 = emit_intrinsic(b1, MIR_INTR_ARENA, mir_opnd_vreg(mark_vreg), mir_opnd_none())
		n_ch = ast_node_child_count(stmt)
		if n_ch > 0 do
			body_idx = n_ch - 1
			b1 = lower_stmt(b1, ast_node_child(stmt, body_idx))
		end
		out emit_intrinsic(b1, MIR_INTR_ARENA, mir_opnd_none(), mir_opnd_vreg(mark_vreg))
	end

    # 14b. Emit / Select / Try / Resume / Infer / Train
	if stmt_type == AstType.EmitStmt do
		if ast_node_child_count(stmt) > 0 do
			var (b2, v) = lower_expr(b, ast_node_child(stmt, 0))
			out emit_intrinsic(b2, MIR_INTR_EMIT, mir_opnd_none(), v)
		end
		out emit_intrinsic(b, MIR_INTR_EMIT, mir_opnd_none(), mir_opnd_none())
	end
	if stmt_type == AstType.SelectStmt do
		b = emit_intrinsic(b, MIR_INTR_SELECT, mir_opnd_none(), mir_opnd_none())
		if ast_node_child_count(stmt) > 0 do
			out lower_stmt(b, ast_node_child(stmt, 0))
		end
		out b
	end
	if stmt_type == AstType.TryStmt do
		nch = ast_node_child_count(stmt)
        # Emit timeout/isolate option markers first (kept for compatibility).
		var ci = 0
		var try_body = 0 - 1
		var revert_body = 0 - 1
		when ci < nch loop
			ch = ast_node_child(stmt, ci)
			ct = ast_node_type_of(ch)
			if ct == AstType.TimeoutClause do
				if ast_node_child_count(ch) > 0 do
					var (bt2, tv2) = lower_expr(b, ast_node_child(ch, 0))
					b = emit_intrinsic(bt2, MIR_INTR_TIMEOUT, mir_opnd_none(), tv2)
				else
					b = emit_intrinsic(b, MIR_INTR_TIMEOUT, mir_opnd_none(), mir_opnd_none())
				end
			eif ct == AstType.IsolateClause do
				b = emit_intrinsic(b, MIR_INTR_ISOLATE, mir_opnd_none(), mir_opnd_none())
			else
                # First Block is the try body; the second is the revert handler.
				if try_body == 0 - 1 do
					try_body = ch
				else
					revert_body = ch
				end
			end
			ci = ci + 1
		end

        # `err` variable, visible to the revert handler; init to 0.
		var (be, err_v) = builder_new_vreg(b)
		be = emit_move(be, err_v, mir_opnd_imm(0))
		be = set_var_vreg(be, fat_str_new("err"), err_v)
		b = be

        # Create dedicated try_entry, revert, and join/end blocks.
		var (b_try, try_entry_id) = builder_add_block(b)
		var (b_rv, revert_id) = builder_add_block(b_try)
		var (b_en, end_id) = builder_add_block(b_rv)
		b = emit_jump(b_en, try_entry_id)
		b = builder_set_current_block(b, try_entry_id)

        # Install try context (save outer for nesting).
		saved_retry = g_try_retry_block
		saved_block = g_try_revert_block
		saved_err = g_try_err_vreg
		g_try_retry_block = try_entry_id
		g_try_revert_block = revert_id
		g_try_err_vreg = err_v

        # Try body: on normal completion jump past the handler.
		if (try_body as i64) != (0 - 1) do
			b = lower_stmt(b, try_body)
		end
		b = emit_jump(b, end_id)

        # Revert handler: outer revert block is active for nested throw / resume revert.
		g_try_revert_block = saved_block
		b = builder_set_current_block(b, revert_id)
		if (revert_body as i64) != (0 - 1) do
			b = lower_stmt(b, revert_body)
		end
		b = emit_jump(b, end_id)

        # Restore outer try context before continuing past try block.
		g_try_retry_block = saved_retry
		g_try_revert_block = saved_block
		g_try_err_vreg = saved_err

		b = builder_set_current_block(b, end_id)
		out b
	end
	if stmt_type == AstType.TimeoutClause do
		if ast_node_child_count(stmt) > 0 do
			var (b2, v) = lower_expr(b, ast_node_child(stmt, 0))
			out emit_intrinsic(b2, MIR_INTR_TIMEOUT, mir_opnd_none(), v)
		end
		out emit_intrinsic(b, MIR_INTR_TIMEOUT, mir_opnd_none(), mir_opnd_none())
	end
	if stmt_type == AstType.IsolateClause do
		b = emit_intrinsic(b, MIR_INTR_ISOLATE, mir_opnd_none(), mir_opnd_none())
		if ast_node_child_count(stmt) > 0 do
			c0 = ast_node_child(stmt, 0)
			if ast_node_type_of(c0) == AstType.Block do
				out lower_stmt(b, c0)
			end
			var (b2, _) = lower_expr(b, c0)
			out b2
		end
		out b
	end
	if stmt_type == AstType.ResumeStmt do
		let rname = ast_node_name(stmt)
		if fat_cstr_eq(rname, "retry") == 1 or fat_cstr_eq(rname, "ResumeRetry") == 1 do
			if g_try_retry_block >= 0 do
				b = emit_jump(b, g_try_retry_block)
				var (bd, dead_id) = builder_add_block(b)
				out builder_set_current_block(bd, dead_id)
			end
		eif fat_cstr_eq(rname, "revert") == 1 or fat_cstr_eq(rname, "ResumeRevert") == 1 do
			if g_try_revert_block >= 0 do
				b = emit_jump(b, g_try_revert_block)
				var (bd2, dead_id2) = builder_add_block(b)
				out builder_set_current_block(bd2, dead_id2)
			else
				out emit_intrinsic(b, MIR_INTR_THROW, mir_opnd_none(), mir_opnd_none())
			end
		end
		var (b1, rid) = builder_intern(b, rname)
		out emit_intrinsic(b1, MIR_INTR_RESUME, mir_opnd_none(), mir_opnd_imm(rid))
	end
	if stmt_type == AstType.InferBlock do
		b = emit_intrinsic(b, MIR_INTR_INFER, mir_opnd_none(), mir_opnd_none())
		if ast_node_child_count(stmt) > 0 do
			out lower_stmt(b, ast_node_child(stmt, 0))
		end
		out b
	end
	if stmt_type == AstType.TrainBlock do
		b = emit_intrinsic(b, MIR_INTR_TRAIN, mir_opnd_none(), mir_opnd_none())
		if ast_node_child_count(stmt) > 0 do
			out lower_stmt(b, ast_node_child(stmt, 0))
		end
		out b
	end
	if stmt_type == AstType.PrecompBlock do
		b = emit_intrinsic(b, MIR_INTR_PRECOMP, mir_opnd_none(), mir_opnd_none())
		if ast_node_child_count(stmt) > 0 do
			out lower_stmt(b, ast_node_child(stmt, 0))
		end
		out b
	end
	if stmt_type == AstType.AtomicVarDecl do
		b = emit_intrinsic(b, MIR_INTR_ATOMIC_VAR, mir_opnd_none(), mir_opnd_none())
		if ast_node_child_count(stmt) > 0 do
			out lower_stmt(b, ast_node_child(stmt, 0))
		end
		out b
	end
	if stmt_type == AstType.ReactiveDecl do
		var (b1, nid) = builder_intern(b, ast_node_name(stmt))
		b1 = emit_set_arg(b1, 0, mir_opnd_imm(nid))
		b1 = emit_intrinsic(b1, MIR_INTR_REACTIVE, mir_opnd_none(), mir_opnd_imm(nid))
		if ast_node_child_count(stmt) > 0 do
			var (b2, _) = lower_expr(b1, ast_node_child(stmt, 0))
			out b2
		end
		out b1
	end
	if stmt_type == AstType.MorphDecl do
		var (b1, nid) = builder_intern(b, ast_node_name(stmt))
		b1 = emit_set_arg(b1, 0, mir_opnd_imm(nid))
		b1 = emit_intrinsic(b1, MIR_INTR_MORPH, mir_opnd_none(), mir_opnd_imm(nid))
		if ast_node_child_count(stmt) > 0 do
			var (b2, _) = lower_expr(b1, ast_node_child(stmt, 0))
			out b2
		end
		out b1
	end
	if stmt_type == AstType.ExposeAttr do
		b = emit_intrinsic(b, MIR_INTR_EXPOSE, mir_opnd_none(), mir_opnd_none())
		if ast_node_child_count(stmt) > 0 do
			out lower_stmt(b, ast_node_child(stmt, 0))
		end
		out b
	end
    # Decl-style stmts inside functions → DECL markers
	if stmt_type == AstType.TypeAlias or stmt_type == AstType.LazyIncludeStmt or stmt_type == AstType.ShareDecl or stmt_type == AstType.HasDecl or stmt_type == AstType.ClassDef or stmt_type == AstType.DictDecl or stmt_type == AstType.TensorDecl or stmt_type == AstType.FluxDecl do
		out lower_decl_marker(b, stmt)
	end
	if stmt_type == AstType.BundleExpr or stmt_type == AstType.MapExpr or stmt_type == AstType.ArrCompactExpr or stmt_type == AstType.ErrorExpr or stmt_type == AstType.PtrTypeExpr or stmt_type == AstType.ExistExpr or stmt_type == AstType.PatternExpr or stmt_type == AstType.AddrOf or stmt_type == AstType.ErxExpr do
		var (b2, _) = lower_expr(b, stmt)
		out b2
	end

    # 15. Expr-as-stmt
	if stmt_type == AstType.Call or stmt_type == AstType.BuiltinCall or stmt_type == AstType.MethodCall or stmt_type == AstType.AwaitExpr or stmt_type == AstType.TaskExpr or stmt_type == AstType.WaitExpr or stmt_type == AstType.QuantizeExpr do
		var (b2, _) = lower_expr(b, stmt)
		out b2
	end

	out b
end.

func ast_build_global_init_func():
    b = builder_new(0 - 1, fat_str_new("__vir_global_init"))
    n = vec_len_rt(g_lower_global_names)
    var i = 0
    when i < n loop
        init_value = vec_get_rt(g_lower_global_values, i)
        init_node = vec_get_rt(g_lower_global_init_nodes, i) as AstNode
        # For entity/array/tuple literals or any non-constant init, lower the AST node.
        needs_lower = 0
        if init_node != 0 do
            node_t = ast_node_type_of(init_node)
            if node_t == AstType.EntityLiteral or node_t == AstType.ArrayLiteral or node_t == AstType.TupleLiteral do
                needs_lower = 1
            end
        end
        if needs_lower == 1 do
            var (b2, val_opnd) = lower_expr(b, init_node)
            b2 = emit_intrinsic(b2, MIR_INTR_GLOBAL_STORE, mir_opnd_imm(i), val_opnd)
            b = b2
        else
            b = emit_intrinsic(b, MIR_INTR_GLOBAL_STORE, mir_opnd_imm(i), mir_opnd_imm(init_value))
        end
        i = i + 1
    end
    b = builder_add_instr(b, mir_instr_new(MirOp.Return, mir_opnd_none(), mir_opnd_none(), mir_opnd_none()))
    out builder_func(b)
end.
func lower_stmt(b: MirBuilder, stmt: AstNode):
	# MirBuilder is mutated in place. In native self-host output the large
	# lower_stmt_impl return CFG can occasionally leave an AstType/boolean in
	# X0 instead of the builder pointer (for example 2 after a terminated
	# function body). Preserve the input handle in that case; all mutations
	# performed by the lowering call are already visible through it.
	lowered_b = lower_stmt_impl(b, stmt)
	if (lowered_b as i64) < 4096 do
		out b
	end
	out lowered_b
end.

func ast_lower_func(func_id: int, ast_func: AstNode):
    g_scope_stack = vec_new_rt()
    fname = ast_node_name(ast_func)
    fname2 = ast_node_name2(ast_func)
	b = builder_new(func_id, fname)
	f = builder_func(b)
	g_current_func_buckets = native_read_i64(f as i64, 64)
    # Modifiers carried in name2: async / precomp / method
	if fat_cstr_eq(fname2, "async") do
		b = emit_intrinsic(b, MIR_INTR_ASYNC, mir_opnd_none(), mir_opnd_none())
	end
	if fat_cstr_eq(fname2, "precomp") do
		b = emit_intrinsic(b, MIR_INTR_PRECOMP, mir_opnd_none(), mir_opnd_none())
	end
	is_method = 0
	if fat_cstr_eq(fname2, "method") == 1 do
		b = emit_intrinsic(b, MIR_INTR_DECL, mir_opnd_none(), mir_opnd_imm(AstType.MethodCall as i64))
		is_method = 1
	end
	child_count = ast_node_child_count(ast_func)

	var param_idx = 0
	if is_method == 1 do
		var has_this = 0
		if child_count > 0 do
			first_ch = ast_node_child(ast_func, 0)
			fcnt = ast_node_type_of(first_ch)
			if fcnt == AstType.Identifier or fcnt == AstType.RefParam or fcnt == AstType.ParamDef do
				if fat_cstr_eq(ast_node_name(first_ch), "this") == 1 do
					has_this = 1
				end
			end
		end
		if g_current_entity_name != 0 do
			set_var_type(fat_str_new("this"), g_current_entity_name as string)
		end
		if has_this == 0 do
			if ast_node_int_val(ast_func) == 0 do
				var (b_th, pv_th) = builder_new_vreg(b)
				b_th = emit_intrinsic(b_th, MIR_INTR_PARAM, mir_opnd_vreg(pv_th), mir_opnd_imm(0))
				b = set_var_vreg(b_th, fat_str_new("this"), pv_th)
				param_idx = 1
			end
		end
	end

	if child_count > 0 do
		var pi = 0
		when pi < child_count loop
			ch = ast_node_child(ast_func, pi)
			cnt = ast_node_type_of(ch)
			if cnt == AstType.Identifier or cnt == AstType.RefParam or cnt == AstType.ParamDef do
				var (b2, pv) = builder_new_vreg(b)
				b2 = emit_intrinsic(b2, MIR_INTR_PARAM, mir_opnd_vreg(pv), mir_opnd_imm(param_idx))
				b = set_var_vreg(b2, ast_node_name(ch), pv)
				if ast_node_name2(ch) != 0 and fat_str_len(ast_node_name2(ch)) > 0 do
					set_var_type(ast_node_name(ch), ast_node_name2(ch))
				end
				param_idx = param_idx + 1
			else
				b = lower_stmt(b, ch)
			end
			pi = pi + 1
		end
	end
    ins_ret = mir_instr_new(MirOp.Return, mir_opnd_none(), mir_opnd_none(), mir_opnd_none())
    b = builder_add_instr(b, ins_ret)
	f = builder_func(b)
    vc = native_read_i64(b as i64, 8)
    native_write_i64(f as i64, 16, vc)
	out f
end.
func lower_decl_marker(b: MirBuilder, node: AstNode):
    # Decl-only nodes: Intrinsic DECL so later MIR_/linker sees the name.
	var (b1, nid) = builder_intern(b, ast_node_name(node))
	b1 = emit_set_arg(b1, 0, mir_opnd_imm(nid))
	out emit_intrinsic(b1, MIR_INTR_DECL, mir_opnd_none(), mir_opnd_imm(ast_node_type_of(node) as i64))
end.

func ast_lower_program(prog: AstNode):
    set_global_prog_ast(prog)
	ffi_import_reset()
	g_mir_scratch_top = 0
	# Soft/C-VM: keep `var` on the result vec so push reassignments stick.
	var mir_funcs = vec_new_rt()
	mir_funcs = vec_push_rt(mir_funcs, ast_build_global_init_func())
	var child_count = ast_node_child_count(prog)
	var lowered = 0
	var i = 0
	when i < child_count loop
		var child = ast_node_child(prog, i)
		var is_func = 0
		nt = ast_node_type_of(child)
		if nt == AstType.BindAttr do
			if ast_node_child_count(child) > 0 do
				child = ast_node_child(child, 0)
				nt = ast_node_type_of(child)
			end
		end
		if nt == AstType.FuncDef do
			is_func = 1
		end
		if nt == AstType.ExternFunc do
			# Externs are symbols, not empty executable functions.  The registry
			# is consumed by target object writers (Mach-O/ELF/PE/Wasm).
			ffi_import_register(ast_node_name(child), ast_node_name2(child))
		end
		if is_func == 1 do
			var m_func = ast_lower_func(i, child)
			mir_funcs = vec_push_rt(mir_funcs, m_func)
			lowered = lowered + 1
			if g_ast_lower_verbose == 1 do
				if lowered == 1 || (lowered mod 50) == 0 do
					arena:
						var sb = sb_new()
						sb = sb_append(sb, "virc: pipeline — AST->MIR func ")
						sb = sb_append_int(sb, lowered)
						print_ln(sb_to_string(sb))
						sb_free(sb)
					end
				end
			end
		end
		if nt == AstType.EntityDef and fat_cstr_eq(ast_node_name2(child), "interface") == 0 do
			g_current_entity_name = ast_node_name(child) as i64
			var n_ech = ast_node_child_count(child)
			var j = 0
			when j < n_ech loop
				var m_node = ast_node_child(child, j)
				if ast_node_type_of(m_node) == AstType.FuncDef do
					m_node.name2 = fat_str_new("method")
					var m_func = ast_lower_func(vec_len_rt(mir_funcs), m_node)
					mir_funcs = vec_push_rt(mir_funcs, m_func)
					lowered = lowered + 1
					if g_ast_lower_verbose == 1 do
						if lowered == 1 || (lowered mod 50) == 0 do
							arena:
								var sb = sb_new()
								sb = sb_append(sb, "virc: pipeline — AST->MIR func ")
								sb = sb_append_int(sb, lowered)
								print_ln(sb_to_string(sb))
								sb_free(sb)
							end
						end
					end
				end
				j = j + 1
			end
			g_current_entity_name = 0
		end
		i = i + 1
	end
	out mir_funcs
end.

export ast_lower_program, ast_lower_func, set_ast_lower_verbose, name_hash_bucket, get_var_vreg, set_var_vreg, emit_jump, emit_jump_if, emit_jump_if_not, emit_set_arg, emit_intrinsic, emit_move, emit_load, emit_store, lower_aggregate, MIR_VAR_BUCKETS, set_global_prog_ast, find_field_index, is_entity_name, is_register_field, get_register_field_start, get_register_field_width, is_register_field_scoped, get_register_field_start_scoped, get_register_field_width_scoped
