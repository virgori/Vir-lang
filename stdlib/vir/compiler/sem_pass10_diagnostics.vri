##
 * vir/compiler/sem_pass10_diagnostics.vri
 * ==============================================================
 * Pass 10: Diagnostics Emission.
 * Formats and prints all collected diagnostics, returns error count.
 ##

include vec_rt;
import vec_new_rt, vec_push_rt, vec_get_rt, vec_len_rt from vec_rt;

include string_rt;
import rt_streq, rt_strcat, rt_itoa, rt_strlen from string_rt;

include context;
import DiagnosticEngine, DiagnosticLevel, Diagnostic from context;

func pass10_emit_diagnostics(diag: DiagnosticEngine, source_path: string)
    count = vec_len_rt(diag.diagnostics);
    if count == 0 do
        out 0
    end

    var i = 0;
    when i < count loop
        d = vec_get_rt(diag.diagnostics, i);
        pass10_print_one(d, source_path);
        i = i + 1
    end

    # Print summary
    let sb = sb_new();
    sb = sb_append(sb, "virc: ");
    sb = sb_append_int(sb, diag.error_count);
    sb = sb_append(sb, " error(s), ");
    var warn_count = count - diag.error_count;
    sb = sb_append_int(sb, warn_count);
    sb = sb_append(sb, " warning(s)");
    print_ln(sb_to_string(sb));
    sb_free(sb);

    out diag.error_count
end.
func pass10_print_one(d: Diagnostic, source_path: string)
    let sb = sb_new();

    # Level prefix
    if d.level == DiagnosticLevel.Error do
        sb = sb_append(sb, "[ERROR] ")
    eif d.level == DiagnosticLevel.Warning do
        sb = sb_append(sb, "[WARN]  ")
    else
        sb = sb_append(sb, "[INFO]  ")
    end

    # Location
    sb = sb_append(sb, source_path);
    sb = sb_append(sb, ":");
    sb = sb_append_int(sb, d.line);
    sb = sb_append(sb, ":");
    sb = sb_append_int(sb, d.col);
    sb = sb_append(sb, " — ");

    # Error code → message
    sb = sb_append(sb, pass10_code_to_msg(d.message));

    print_ln(sb_to_string(sb));
    sb_free(sb)
end.
func pass10_code_to_msg(code: int)
    # Symbol Resolution errors (1xxx)
    if code == 1001 do out "redefined symbol in current scope" end
    if code == 1002 do out "undefined variable" end
    if code == 1003 do out "undefined function" end
    if code == 1004 do out "undefined field" end
    if code == 1005 do out "undefined enum variant" end
    if code == 1006 do out "undefined type" end
    if code == 1007 do out "undefined module" end

    # Warnings (2xxx)
    if code == 2001 do out "variable shadows outer scope" end

    # Type Checking errors (3xxx)
    if code == 3001 do out "type mismatch in binary operation" end
    if code == 3002 do out "invalid operator for type" end
    if code == 3003 do out "assignment to immutable variable" end
    if code == 3004 do out "type mismatch in assignment" end
    if code == 3005 do out "wrong argument count" end
    if code == 3006 do out "argument type mismatch" end
    if code == 3007 do out "return type mismatch" end
    if code == 3008 do out "unknown entity field" end
    if code == 3009 do out "missing required field" end
    if code == 3010 do out "duplicate field in literal" end
    if code == 3011 do out "field type mismatch" end
    if code == 3012 do out "invalid assignment target (not l-value)" end
    if code == 3013 do out "invalid cast" end

    # Control Flow errors (4xxx)
    if code == 4001 do out "missing return on some paths" end
    if code == 4002 do out "unreachable code" end
    if code == 4004 do out "break/skip outside loop" end

    # Fallback
    let sb = sb_new();
    sb = sb_append(sb, "semantic error ");
    sb = sb_append_int(sb, code);
    out sb_to_string(sb)
end.

export pass10_emit_diagnostics
