##
 * vir/compiler/sem_pass7_cfa.vri
 * ==============================================================
 * Pass 7: Control Flow Analysis.
 * Checks for break/skip outside loops, unreachable code,
 * and missing return statements.
 ##

include vec_rt;
import vec_new_rt, vec_push_rt, vec_get_rt, vec_len_rt from vec_rt;

include string_rt;
import rt_streq, fat_str_eq, fat_str_len, fat_cstr_eq, fat_str_eq, fat_str_len, fat_cstr_eq, rt_strcat, rt_itoa, rt_strlen from string_rt;

include parser;
import AstNode, AstType from parser;

include symbol_table;
import SymbolTable, SymbolKind, SymbolNode from symbol_table;

include scope_tree;
import ScopeTree, ScopeKind, ScopeNode, scope_push, scope_pop from scope_tree;

include context;
import DiagnosticEngine, report_error, report_warning from context;

func pass7_analyze_cfa(symbols: SymbolTable, scopes: ScopeTree, diag: DiagnosticEngine, node: AstNode):
    # Start with loop_depth=0, in_func=0
    pass7_walk(symbols, scopes, diag, node, 0, 0)
end.
func pass7_walk(symbols: SymbolTable, scopes: ScopeTree, diag: DiagnosticEngine, node: AstNode, loop_depth: int, in_func: int):

    if node.node_type == AstType.FuncDef do
        # Check if function has a return type annotation (name2)
        has_return_type = fat_str_len(node.name2) > 0;

        scope_push(scopes, ScopeKind.Func);
        child_count = vec_len_rt(node.children);
        if child_count > 0 do
            last_idx = child_count - 1;
            body = vec_get_rt(node.children, last_idx);
            # Walk body with loop_depth=0, in_func=1
            has_out = pass7_walk_block_check_return(symbols, scopes, diag, body, 0);

            # If function has return type but body doesn't always return
            if has_return_type and not has_out do
                report_warning(diag, 4001, node.line, 0)
            end
        end
        scope_pop(scopes);
        out 0
    end

    if node.node_type == AstType.BreakStmt do
        if loop_depth == 0 do
            report_error(diag, 4004, node.line, 0)
        end
        out 0
    end

    if node.node_type == AstType.ContinueStmt do
        if loop_depth == 0 do
            report_error(diag, 4004, node.line, 0)
        end
        out 0
    end

    if node.node_type == AstType.ThrowStmt do
        # Check if throw is inside an ensure block — Error 4005
        # (Not tracked yet, will be added when ensure handling is more complete)
        out 0
    end

    if node.node_type == AstType.LoopStmt or node.node_type == AstType.WhileStmt or node.node_type == AstType.ForRange do
        # Increase loop depth for children
        scope_push(scopes, ScopeKind.Loop);
        child_count = vec_len_rt(node.children);
        var i = 0;
        when i < child_count loop
            child = vec_get_rt(node.children, i);
            pass7_walk(symbols, scopes, diag, child, loop_depth + 1, in_func);
            i = i + 1
        end
        scope_pop(scopes);
        out 0
    end

    if node.node_type == AstType.Block do
        # Check for unreachable code
        scope_push(scopes, ScopeKind.Block);
        child_count = vec_len_rt(node.children);
        var found_terminator = 0;
        var i = 0;
        when i < child_count loop
            child = vec_get_rt(node.children, i);
            if found_terminator == 1 do
                # Code after terminator is unreachable
                report_warning(diag, 4002, child.line, 0);
                # Don't walk unreachable code
                i = child_count
            else
                pass7_walk(symbols, scopes, diag, child, loop_depth, in_func);
                # Check if this child is a terminator
                if child.node_type == AstType.ReturnStmt or child.node_type == AstType.ThrowStmt or child.node_type == AstType.BreakStmt do
                    found_terminator = 1
                end
            end
            i = i + 1
        end
        scope_pop(scopes);
        out 0
    end

    # Default recurse
    child_count = vec_len_rt(node.children);
    var i = 0;
    when i < child_count loop
        child = vec_get_rt(node.children, i);
        pass7_walk(symbols, scopes, diag, child, loop_depth, in_func);
        i = i + 1
    end
    out 0
end.
func pass7_walk_block_check_return(symbols: SymbolTable, scopes: ScopeTree, diag: DiagnosticEngine, node: AstNode, loop_depth: int):
    # Returns 1 if this block always has a return/out statement, 0 otherwise
    # Walk children and check the last statement
    if node.node_type == AstType.ReturnStmt do
        out 1
    end
    if node.node_type == AstType.ThrowStmt do
        out 1
    end

    if node.node_type == AstType.Block do
        child_count = vec_len_rt(node.children);
        if child_count == 0 do
            out 0
        end
        # Check if last child always returns
        last = vec_get_rt(node.children, child_count - 1);
        out pass7_walk_block_check_return(symbols, scopes, diag, last, loop_depth)
    end

    if node.node_type == AstType.IfStmt do
        # If-else: both branches must return
        child_count = vec_len_rt(node.children);
        # IfStmt children: [condition, then_block, (optional) else_block]
        if child_count >= 3 do
            then_branch = vec_get_rt(node.children, 1);
            else_branch = vec_get_rt(node.children, 2);
            then_returns = pass7_walk_block_check_return(symbols, scopes, diag, then_branch, loop_depth);
            else_returns = pass7_walk_block_check_return(symbols, scopes, diag, else_branch, loop_depth);
            out then_returns and else_returns
        end
        # If without else doesn't always return
        out 0
    end

    # Default: doesn't return
    out 0
end.

export pass7_analyze_cfa
