##
 * vir/compiler/sem_pass7_cfa.vri
 * ==============================================================
 * Pass 7: Control Flow Analysis.
 * Checks for break/skip outside loops, unreachable code,
 * and missing return statements.
 ##

include vec_rt
import vec_new_rt, vec_push_rt, vec_get_rt, vec_len_rt from vec_rt

include string_rt
import rt_streq, fat_str_eq, fat_str_len, fat_cstr_eq, fat_str_eq, fat_str_len, fat_cstr_eq, rt_strcat, rt_itoa, rt_strlen from string_rt

include parser
import AstNode, AstType from parser

include symbol_table
import SymbolTable, SymbolKind, SymbolNode from symbol_table

include scope_tree
import ScopeTree, ScopeKind, ScopeNode, scope_push, scope_pop from scope_tree

include context
import DiagnosticEngine, report_error, report_warning from context

var g_pass7_func_asts: i64 = 0
var g_pass7_error_in_func: i64 = 0
var g_pass7_error_clause: i64 = 0
var g_pass7_error_try_depth: i64 = 0
var g_pass7_error_locals: i64 = 0
var g_pass7_error_atomics: i64 = 0

func pass7_analyze_cfa(symbols: SymbolTable, scopes: ScopeTree, diag: DiagnosticEngine, node: AstNode):
    g_pass7_func_asts = vec_new_rt()
    if node.node_type == AstType.Program do
        var fi = 0
        when fi < vec_len_rt(node.children) loop
            fn = vec_get_rt(node.children, fi) as AstNode
            if fn.node_type == AstType.FuncDef do
                g_pass7_func_asts = vec_push_rt(g_pass7_func_asts, fn as i64)
            end
            fi = fi + 1
        end
    end
    g_pass7_error_in_func = 0
    g_pass7_error_clause = 0
    g_pass7_error_try_depth = 0
    g_pass7_error_locals = vec_new_rt()
    g_pass7_error_atomics = vec_new_rt()
    pass7_validate_error_flow(diag, node)
    # Start with loop_depth=0, in_func=0
    pass7_walk(symbols, scopes, diag, node, 0, 0)
end.

func pass7_collect_decl_names(node: AstNode, include_try: int):
    if (node as i64) == 0 do out 0 end
    if node.node_type == AstType.TryStmt and include_try == 0 do out 0 end
    if node.node_type == AstType.VarDecl or node.node_type == AstType.ConstDecl do
        if fat_str_len(node.name) > 0 and pass7_vec_contains(g_pass7_error_locals, node.name) == 0 do
            g_pass7_error_locals = vec_push_rt(g_pass7_error_locals, node.name as i64)
        end
    end
    if node.node_type == AstType.AtomicVarDecl and vec_len_rt(node.children) > 0 do
        decl = vec_get_rt(node.children, 0) as AstNode
        if fat_str_len(decl.name) > 0 do
            if pass7_vec_contains(g_pass7_error_locals, decl.name) == 0 do
                g_pass7_error_locals = vec_push_rt(g_pass7_error_locals, decl.name as i64)
            end
            if pass7_vec_contains(g_pass7_error_atomics, decl.name) == 0 do
                g_pass7_error_atomics = vec_push_rt(g_pass7_error_atomics, decl.name as i64)
            end
        end
    end
    var i = 0
    when i < vec_len_rt(node.children) loop
        pass7_collect_decl_names(vec_get_rt(node.children, i) as AstNode, include_try)
        i = i + 1
    end
    out 0
end.

func pass7_collect_assign_names(node: AstNode, names: int):
    if (node as i64) == 0 do out names end
    if node.node_type == AstType.Assign or node.node_type == AstType.IndexAssign or node.node_type == AstType.FieldAssign do
        if fat_str_len(node.name) > 0 and pass7_vec_contains(names, node.name) == 0 do
            names = vec_push_rt(names, node.name as i64)
        end
    end
    var i = 0
    when i < vec_len_rt(node.children) loop
        names = pass7_collect_assign_names(vec_get_rt(node.children, i) as AstNode, names)
        i = i + 1
    end
    out names
end.

func pass7_has_resume_retry(node: AstNode):
    if (node as i64) == 0 do out 0 end
    if node.node_type == AstType.ResumeStmt and fat_cstr_eq(node.name, "retry") == 1 do out 1 end
    var i = 0
    when i < vec_len_rt(node.children) loop
        if pass7_has_resume_retry(vec_get_rt(node.children, i) as AstNode) do out 1 end
        i = i + 1
    end
    out 0
end.

func pass7_validate_try(diag: DiagnosticEngine, node: AstNode):
    var isolate_names = vec_new_rt()
    var try_body = 0 as AstNode
    var revert_body = 0 as AstNode
    var ci = 0
    when ci < vec_len_rt(node.children) loop
        ch = vec_get_rt(node.children, ci) as AstNode
        if ch.node_type == AstType.IsolateClause do
            if vec_len_rt(ch.children) != 1 do
                report_error(diag, 3071, ch.line, 0)
            else
                list = vec_get_rt(ch.children, 0) as AstNode
                if list.node_type != AstType.ArrayLiteral do
                    report_error(diag, 3071, ch.line, 0)
                else
                    var ii = 0
                    when ii < vec_len_rt(list.children) loop
                        item = vec_get_rt(list.children, ii) as AstNode
                        if item.node_type != AstType.Identifier or pass7_vec_contains(g_pass7_error_locals, item.name) == 0 or pass7_vec_contains(g_pass7_error_atomics, item.name) == 1 or pass7_vec_contains(isolate_names, item.name) == 1 do
                            report_error(diag, 3071, item.line, 0)
                        else
                            isolate_names = vec_push_rt(isolate_names, item.name as i64)
                        end
                        ii = ii + 1
                    end
                end
            end
        eif ch.node_type == AstType.TimeoutClause do
            # Type/range validation belongs to pass 6; no error-flow child.
        else
            if (try_body as i64) == 0 do try_body = ch else revert_body = ch end
        end
        ci = ci + 1
    end
    if (try_body as i64) == 0 or (revert_body as i64) == 0 do
        report_error(diag, 3069, node.line, 0)
    end

    saved_clause = g_pass7_error_clause
    saved_depth = g_pass7_error_try_depth
    g_pass7_error_clause = 0
    g_pass7_error_try_depth = saved_depth + 1
    if (try_body as i64) != 0 do pass7_validate_error_flow(diag, try_body) end
    g_pass7_error_clause = 3
    if (revert_body as i64) != 0 do pass7_validate_error_flow(diag, revert_body) end
    g_pass7_error_clause = saved_clause
    g_pass7_error_try_depth = saved_depth

    if (try_body as i64) != 0 and (revert_body as i64) != 0 and pass7_has_resume_retry(revert_body) do
        mutated = pass7_collect_assign_names(try_body, vec_new_rt())
        reset = pass7_collect_assign_names(revert_body, vec_new_rt())
        var mi = 0
        when mi < vec_len_rt(mutated) loop
            mname = vec_get_rt(mutated, mi) as string
            if pass7_vec_contains(isolate_names, mname) == 0 and pass7_vec_contains(g_pass7_error_atomics, mname) == 0 and pass7_vec_contains(reset, mname) == 0 do
                report_warning(diag, 302, node.line, 0)
            end
            mi = mi + 1
        end
    end
    out 0
end.

func pass7_validate_error_flow(diag: DiagnosticEngine, node: AstNode):
    if (node as i64) == 0 do out 0 end
    if node.node_type == AstType.FuncDef do
        saved_in = g_pass7_error_in_func
        saved_clause = g_pass7_error_clause
        saved_depth = g_pass7_error_try_depth
        saved_locals = g_pass7_error_locals
        saved_atomics = g_pass7_error_atomics
        g_pass7_error_in_func = 1
        g_pass7_error_clause = 0
        g_pass7_error_try_depth = 0
        g_pass7_error_locals = vec_new_rt()
        g_pass7_error_atomics = vec_new_rt()
        var pi = 0
        when pi < vec_len_rt(node.children) loop
            pc = vec_get_rt(node.children, pi) as AstNode
            if pc.node_type == AstType.ParamDef or pc.node_type == AstType.RefParam or pc.node_type == AstType.OutParam or pc.node_type == AstType.Identifier do
                g_pass7_error_locals = vec_push_rt(g_pass7_error_locals, pc.name as i64)
            eif pc.node_type == AstType.Block do
                pass7_collect_decl_names(pc, 0)
            end
            pi = pi + 1
        end
        var fi = 0
        when fi < vec_len_rt(node.children) loop
            fc = vec_get_rt(node.children, fi) as AstNode
            if fc.node_type == AstType.EnsureBlock do
                g_pass7_error_clause = 1
                pass7_validate_error_flow(diag, fc)
            eif fc.node_type == AstType.RevertBlock do
                g_pass7_error_clause = 2
                pass7_validate_error_flow(diag, fc)
            else
                g_pass7_error_clause = 0
                pass7_validate_error_flow(diag, fc)
            end
            fi = fi + 1
        end
        g_pass7_error_in_func = saved_in
        g_pass7_error_clause = saved_clause
        g_pass7_error_try_depth = saved_depth
        g_pass7_error_locals = saved_locals
        g_pass7_error_atomics = saved_atomics
        out 0
    end
    if node.node_type == AstType.TryStmt do
        if g_pass7_error_in_func == 0 do report_error(diag, 3075, node.line, 0) end
        out pass7_validate_try(diag, node)
    end
    if node.node_type == AstType.ErxExpr do
        if g_pass7_error_clause == 0 do report_error(diag, 3060, node.line, 0) end
        out 0
    end
    if node.node_type == AstType.ResumeStmt do
        if g_pass7_error_clause != 3 or g_pass7_error_try_depth <= 0 do
            report_error(diag, 3061, node.line, 0)
        end
        out 0
    end
    if node.node_type == AstType.ThrowStmt and g_pass7_error_in_func == 0 do
        report_error(diag, 3074, node.line, 0)
    end
    var i = 0
    when i < vec_len_rt(node.children) loop
        pass7_validate_error_flow(diag, vec_get_rt(node.children, i) as AstNode)
        i = i + 1
    end
    out 0
end.
func pass7_walk(symbols: SymbolTable, scopes: ScopeTree, diag: DiagnosticEngine, node: AstNode, loop_depth: int, in_func: int):

    if node.node_type == AstType.FuncDef do
        # Check if function has a return type annotation (name2)
        has_return_type = fat_str_len(node.name2) > 0

        scope_push(scopes, ScopeKind.Func)
        child_count = vec_len_rt(node.children)
        body_idx = child_count - 1
        if body_idx < 0 do
            body_idx = 0
        end
        var bi = 0
        when bi < child_count loop
            ch = vec_get_rt(node.children, bi)
            if ch.node_type == AstType.Block do
                body_idx = bi
                bi = child_count
            else
                bi = bi + 1
            end
        end
        has_out = 0
        if child_count > 0 and body_idx < child_count do
            body = vec_get_rt(node.children, body_idx)
            has_out = pass7_walk_block_check_return(symbols, scopes, diag, body, 0)

            # Collect out parameters for definite assignment check (§14.4)
            var out_params = vec_new_rt()
            var pi = 0
            when pi < body_idx loop
                p_ch = vec_get_rt(node.children, pi)
                if p_ch.node_type == AstType.OutParam or (p_ch.node_type == AstType.ParamDef and p_ch.int_val == 2) do
                    out_params = vec_push_rt(out_params, p_ch.name)
                end
                pi = pi + 1
            end

            if vec_len_rt(out_params) > 0 and body != 0 do
                assigned_outs = pass7_check_stmt_outs(diag, body, out_params, vec_new_rt())
                if pass7_state_falls_through(assigned_outs) do
                    pass7_require_outs_assigned(diag, node.line, out_params, assigned_outs)
                end
            end
        end
        var j = body_idx + 1
        when j < child_count loop
            child = vec_get_rt(node.children, j)
            pass7_walk(symbols, scopes, diag, child, 0, 1)
            j = j + 1
        end

        if has_return_type and not has_out do
            report_warning(diag, 4001, node.line, 0)
        end
        scope_pop(scopes)
        out 0
    end

    if node.node_type == AstType.BreakStmt do
        if loop_depth == 0 do
            report_error(diag, 4004, node.line, 0)
        end
        out 0
    end

    if node.node_type == AstType.ContinueStmt do
        if loop_depth == 0 do
            report_error(diag, 4004, node.line, 0)
        end
        out 0
    end

    if node.node_type == AstType.ThrowStmt do
        # Check if throw is inside an ensure block — Error 4005
        # (Not tracked yet, will be added when ensure handling is more complete)
        out 0
    end

    if node.node_type == AstType.LoopStmt or node.node_type == AstType.WhileStmt or node.node_type == AstType.ForRange do
        # Increase loop depth for children
        scope_push(scopes, ScopeKind.Loop)
        child_count = vec_len_rt(node.children)
        var i = 0
        when i < child_count loop
            child = vec_get_rt(node.children, i)
            pass7_walk(symbols, scopes, diag, child, loop_depth + 1, in_func)
            i = i + 1
        end
        scope_pop(scopes)
        out 0
    end

    if node.node_type == AstType.Block do
        # Check for unreachable code
        scope_push(scopes, ScopeKind.Block)
        child_count = vec_len_rt(node.children)
        var found_terminator = 0
        var i = 0
        when i < child_count loop
            child = vec_get_rt(node.children, i)
            if found_terminator == 1 do
                # Code after terminator is unreachable
                report_warning(diag, 4002, child.line, 0)
                # Don't walk unreachable code
                i = child_count
            else
                pass7_walk(symbols, scopes, diag, child, loop_depth, in_func)
                # Check if this child is a terminator
                if child.node_type == AstType.ReturnStmt or child.node_type == AstType.ThrowStmt or child.node_type == AstType.BreakStmt do
                    found_terminator = 1
                end
            end
            i = i + 1
        end
        scope_pop(scopes)
        out 0
    end

    # Default recurse
    child_count = vec_len_rt(node.children)
    var i = 0
    when i < child_count loop
        child = vec_get_rt(node.children, i)
        pass7_walk(symbols, scopes, diag, child, loop_depth, in_func)
        i = i + 1
    end
    out 0
end.

func pass7_vec_contains(v: int, s: string):
    if v == 0 do out 0 end
    n = vec_len_rt(v)
    var i = 0
    when i < n loop
        item = vec_get_rt(v, i) as string
        if fat_str_eq(item, s) == 1 do
            out 1
        end
        i = i + 1
    end
    out 0
end.

func pass7_copy_vec(v: int):
    new_v = vec_new_rt()
    if v == 0 do out new_v end
    n = vec_len_rt(v)
    var i = 0
    when i < n loop
        new_v = vec_push_rt(new_v, vec_get_rt(v, i))
        i = i + 1
    end
    out new_v
end.

func pass7_state_falls_through(assigned_outs: int):
    out pass7_vec_contains(assigned_outs, fat_str_new("__vir_cfa_no_fallthrough__")) == 0
end.

func pass7_mark_no_fallthrough(assigned_outs: int):
    if pass7_state_falls_through(assigned_outs) do
        assigned_outs = vec_push_rt(assigned_outs, fat_str_new("__vir_cfa_no_fallthrough__") as i64)
    end
    out assigned_outs
end.

func pass7_require_outs_assigned(diag: DiagnosticEngine, line: int, out_params: int, assigned_outs: int):
    var oi = 0
    when oi < vec_len_rt(out_params) loop
        op = vec_get_rt(out_params, oi) as string
        if pass7_vec_contains(assigned_outs, op) == 0 do
            report_error(diag, 3051, line, 0)
        end
        oi = oi + 1
    end
end.

func pass7_merge_fallthrough_states(out_params: int, left: int, right: int):
    let left_falls = pass7_state_falls_through(left)
    let right_falls = pass7_state_falls_through(right)
    if not left_falls and not right_falls do
        out pass7_mark_no_fallthrough(vec_new_rt())
    end
    if not left_falls do out right end
    if not right_falls do out left end
    inter = vec_new_rt()
    var oi = 0
    when oi < vec_len_rt(out_params) loop
        op = vec_get_rt(out_params, oi) as string
        if pass7_vec_contains(left, op) == 1 and pass7_vec_contains(right, op) == 1 do
            inter = vec_push_rt(inter, op as i64)
        end
        oi = oi + 1
    end
    out inter
end.

func pass7_find_func(name: string):
    var fi = 0
    when fi < vec_len_rt(g_pass7_func_asts) loop
        fn = vec_get_rt(g_pass7_func_asts, fi) as AstNode
        if fat_str_eq(fn.name, name) == 1 do out fn end
        fi = fi + 1
    end
    out 0 as AstNode
end.

func pass7_check_call_outs(diag: DiagnosticEngine, call: AstNode, out_params: int, assigned_outs: int):
    fn = pass7_find_func(call.name)
    if (fn as i64) == 0 do
        pass7_check_expr_reads(diag, call, out_params, assigned_outs)
        out assigned_outs
    end
    var pi = 0
    var ai = 0
    when pi < vec_len_rt(fn.children) & ai < vec_len_rt(call.children) loop
        param = vec_get_rt(fn.children, pi) as AstNode
        if param.node_type == AstType.Identifier or param.node_type == AstType.ParamDef or param.node_type == AstType.RefParam or param.node_type == AstType.OutParam do
            arg = vec_get_rt(call.children, ai) as AstNode
            let is_out = param.node_type == AstType.OutParam or param.int_val == 2
            if is_out and arg.node_type == AstType.Identifier do
                if pass7_vec_contains(out_params, arg.name) == 1 and pass7_vec_contains(assigned_outs, arg.name) == 0 do
                    assigned_outs = vec_push_rt(assigned_outs, arg.name as i64)
                end
            else
                pass7_check_expr_reads(diag, arg, out_params, assigned_outs)
            end
            ai = ai + 1
        end
        pi = pi + 1
    end
    out assigned_outs
end.

func pass7_check_expr_reads(diag: DiagnosticEngine, expr: AstNode, out_params: int, assigned_outs: int):
    if (expr as i64) == 0 do out 0 end
    if expr.node_type == AstType.Identifier do
        if pass7_vec_contains(out_params, expr.name) == 1 and pass7_vec_contains(assigned_outs, expr.name) == 0 do
            report_error(diag, 3050, expr.line, 0)
        end
        out 0
    end
    child_count = vec_len_rt(expr.children)
    var i = 0
    when i < child_count loop
        pass7_check_expr_reads(diag, vec_get_rt(expr.children, i) as AstNode, out_params, assigned_outs)
        i = i + 1
    end
    out 0
end.

func pass7_check_stmt_outs(diag: DiagnosticEngine, stmt: AstNode, out_params: int, assigned_outs: int):
    if (stmt as i64) == 0 do out assigned_outs end
    if stmt.node_type == AstType.ReturnStmt do
        pass7_check_expr_reads(diag, stmt, out_params, assigned_outs)
        pass7_require_outs_assigned(diag, stmt.line, out_params, assigned_outs)
        out pass7_mark_no_fallthrough(assigned_outs)
    end
    if stmt.node_type == AstType.ThrowStmt do
        pass7_check_expr_reads(diag, stmt, out_params, assigned_outs)
        out pass7_mark_no_fallthrough(assigned_outs)
    end
    if stmt.node_type == AstType.Call do
        out pass7_check_call_outs(diag, stmt, out_params, assigned_outs)
    end
    if stmt.node_type == AstType.Assign do
        if vec_len_rt(stmt.children) > 0 do
            pass7_check_expr_reads(diag, vec_get_rt(stmt.children, 0) as AstNode, out_params, assigned_outs)
        end
        if pass7_vec_contains(out_params, stmt.name) == 1 do
            if pass7_vec_contains(assigned_outs, stmt.name) == 0 do
                assigned_outs = vec_push_rt(assigned_outs, stmt.name)
            end
        end
        out assigned_outs
    end
    if stmt.node_type == AstType.IfStmt do
        if vec_len_rt(stmt.children) > 0 do
            pass7_check_expr_reads(diag, vec_get_rt(stmt.children, 0) as AstNode, out_params, assigned_outs)
        end
        then_assigned = assigned_outs
        if vec_len_rt(stmt.children) >= 2 do
            then_b = vec_get_rt(stmt.children, 1) as AstNode
            then_assigned = pass7_check_stmt_outs(diag, then_b, out_params, pass7_copy_vec(assigned_outs))
        end
        if vec_len_rt(stmt.children) >= 3 do
            else_b = vec_get_rt(stmt.children, 2) as AstNode
            else_assigned = pass7_check_stmt_outs(diag, else_b, out_params, pass7_copy_vec(assigned_outs))
            out pass7_merge_fallthrough_states(out_params, then_assigned, else_assigned)
        end
        out pass7_merge_fallthrough_states(out_params, then_assigned, pass7_copy_vec(assigned_outs))
    end
    if stmt.node_type == AstType.WhileStmt or stmt.node_type == AstType.ForRange or stmt.node_type == AstType.LoopStmt do
        # A loop may execute zero times or leave through break.  Analyze its
        # children for read-before-write and early returns, but do not promote
        # assignments made only inside the loop to the post-loop state.
        var li = 0
        when li < vec_len_rt(stmt.children) loop
            pass7_check_stmt_outs(diag, vec_get_rt(stmt.children, li) as AstNode, out_params, pass7_copy_vec(assigned_outs))
            li = li + 1
        end
        out assigned_outs
    end
    if stmt.node_type == AstType.Block do
        child_count = vec_len_rt(stmt.children)
        var i = 0
        when i < child_count loop
            if pass7_state_falls_through(assigned_outs) do
                assigned_outs = pass7_check_stmt_outs(diag, vec_get_rt(stmt.children, i) as AstNode, out_params, assigned_outs)
            end
            i = i + 1
        end
        out assigned_outs
    end
    pass7_check_expr_reads(diag, stmt, out_params, assigned_outs)
    out assigned_outs
end.

func pass7_walk_block_check_return(symbols: SymbolTable, scopes: ScopeTree, diag: DiagnosticEngine, node: AstNode, loop_depth: int):
    # Returns 1 if this block always has a return/out statement, 0 otherwise
    # Walk children and check the last statement
    if node.node_type == AstType.ReturnStmt do
        out 1
    end
    if node.node_type == AstType.ThrowStmt do
        out 1
    end

    if node.node_type == AstType.Block do
        child_count = vec_len_rt(node.children)
        if child_count == 0 do
            out 0
        end
        # Check if last child always returns
        last = vec_get_rt(node.children, child_count - 1)
        out pass7_walk_block_check_return(symbols, scopes, diag, last, loop_depth)
    end

    if node.node_type == AstType.IfStmt do
        # If-else: both branches must return
        child_count = vec_len_rt(node.children)
        # IfStmt children: [condition, then_block, (optional) else_block]
        if child_count >= 3 do
            then_branch = vec_get_rt(node.children, 1)
            else_branch = vec_get_rt(node.children, 2)
            then_returns = pass7_walk_block_check_return(symbols, scopes, diag, then_branch, loop_depth)
            else_returns = pass7_walk_block_check_return(symbols, scopes, diag, else_branch, loop_depth)
            out then_returns and else_returns
        end
        # If without else doesn't always return
        out 0
    end

    # Default: doesn't return
    out 0
end.

export pass7_analyze_cfa
