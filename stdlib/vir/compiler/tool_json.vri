# Bounded read-only JSON document for compiler snapshots and native JSON-RPC.
# Keeps source spans in one owned buffer; never interprets compiler semantics.
# Tree construction is O(bytes + nodes), using child-tail indices (no rescans).
# Numbers remain lexical spans: i64 IDs must be strings, not floating numbers.

include rt.string_rt
include rt.alloc
import vir_alloc, vir_free from rt.alloc
import native_read_u8, native_write_u8, native_read_i64, native_write_i64,
       rt_strlen, rt_streq from rt.string_rt

# Document words: source, length, cursor, nodes, count, capacity, error.
# Node words: kind, start, end, first child, next sibling, decoded string cache.
# Kind: string=1, number=2, object=3, array=4, true=5, false=6, null=7.
func toolJsonNode(document: int, index: int):
    out native_read_i64(document, 24) + index * 48
end.

func toolJsonByte(document: int):
    let cursor = native_read_i64(document, 16)
    if cursor >= native_read_i64(document, 8) do out 0 end
    out native_read_u8(native_read_i64(document, 0), cursor)
end.

func toolJsonAdvance(document: int):
    native_write_i64(document, 16, native_read_i64(document, 16) + 1)
end.

func toolJsonWhitespace(document: int):
    loop
        let byte = toolJsonByte(document)
        var whitespace = 0
        if byte == 32 do whitespace = 1 end
        if byte == 9 do whitespace = 1 end
        if byte == 10 do whitespace = 1 end
        if byte == 13 do whitespace = 1 end
        if whitespace == 0 do out end
        toolJsonAdvance(document)
    end
end.

func toolJsonAllocateNode(document: int, kind: int):
    let count = native_read_i64(document, 32)
    var capacity = native_read_i64(document, 40)
    if count >= 1048576 do out 0 end
    if count == capacity do
        let
            oldNodes = native_read_i64(document, 24)
            newNodes = vir_alloc(capacity * 96)
        var index = 0
        when index < capacity * 48 loop
            native_write_u8(newNodes, index, native_read_u8(oldNodes, index))
            index = index + 1
        end
        vir_free(oldNodes)
        native_write_i64(document, 24, newNodes)
        native_write_i64(document, 40, capacity * 2)
    end
    let node = toolJsonNode(document, count)
    var word = 0
    when word < 6 loop
        native_write_i64(node, word * 8, 0)
        word = word + 1
    end
    native_write_i64(node, 0, kind)
    native_write_i64(node, 8, native_read_i64(document, 16))
    native_write_i64(document, 32, count + 1)
    out count
end.

func toolJsonHex(byte: int):
    if byte >= 48 do
        if byte <= 57 do out byte - 48 end
    end
    if byte >= 65 do
        if byte <= 70 do out byte - 55 end
    end
    if byte >= 97 do
        if byte <= 102 do out byte - 87 end
    end
    out 0 - 1
end.

func toolJsonHex4(document: int):
    var
        value = 0
        index = 0
    when index < 4 loop
        let digit = toolJsonHex(toolJsonByte(document))
        if digit < 0 do out 0 - 1 end
        value = value * 16 + digit
        toolJsonAdvance(document)
        index = index + 1
    end
    out value
end.

# Strict scalar UTF-8: reject overlong forms, surrogates and > U+10FFFF.
func toolJsonUtf8(document: int):
    let first = toolJsonByte(document)
    var
        remaining = 0
        value = 0
        minimum = 0
    if first >= 194 do
        if first <= 223 do remaining = 1; value = first and 31; minimum = 128 end
    end
    if first >= 224 do
        if first <= 239 do remaining = 2; value = first and 15; minimum = 2048 end
    end
    if first >= 240 do
        if first <= 244 do remaining = 3; value = first and 7; minimum = 65536 end
    end
    if remaining == 0 do out 0 end
    toolJsonAdvance(document)
    when remaining > 0 loop
        let byte = toolJsonByte(document)
        if byte < 128 do out 0 end
        if byte > 191 do out 0 end
        value = value * 64 + (byte and 63)
        toolJsonAdvance(document)
        remaining = remaining - 1
    end
    if value < minimum do out 0 end
    if value > 1114111 do out 0 end
    if value >= 55296 do
        if value <= 57343 do out 0 end
    end
    out 1
end.

func toolJsonStringToken(document: int):
    toolJsonAdvance(document)
    loop
        let byte = toolJsonByte(document)
        if byte < 32 do out 0 end
        if byte == 34 do toolJsonAdvance(document); out 1 end
        if byte == 92 do
            toolJsonAdvance(document)
            let escaped = toolJsonByte(document)
            toolJsonAdvance(document)
            if escaped == 117 do
                let scalar = toolJsonHex4(document)
                if scalar < 0 do out 0 end
                if scalar >= 55296 do
                    if scalar <= 56319 do
                        if toolJsonByte(document) != 92 do out 0 end
                        toolJsonAdvance(document)
                        if toolJsonByte(document) != 117 do out 0 end
                        toolJsonAdvance(document)
                        let low = toolJsonHex4(document)
                        if low < 56320 do out 0 end
                        if low > 57343 do out 0 end
                    eif scalar <= 57343 do
                        out 0
                    end
                end
            else
                var valid = 0
                if escaped == 34 do valid = 1 end
                if escaped == 92 do valid = 1 end
                if escaped == 47 do valid = 1 end
                if escaped == 98 do valid = 1 end
                if escaped == 102 do valid = 1 end
                if escaped == 110 do valid = 1 end
                if escaped == 114 do valid = 1 end
                if escaped == 116 do valid = 1 end
                if valid == 0 do out 0 end
            end
        eif byte >= 128 do
            if toolJsonUtf8(document) != 1 do out 0 end
        else
            toolJsonAdvance(document)
        end
    end
end.

func toolJsonDigits(document: int):
    let start = native_read_i64(document, 16)
    loop
        let byte = toolJsonByte(document)
        if byte < 48 do break end
        if byte > 57 do break end
        toolJsonAdvance(document)
    end
    out native_read_i64(document, 16) - start
end.

func toolJsonNumberToken(document: int):
    if toolJsonByte(document) == 45 do toolJsonAdvance(document) end
    if toolJsonByte(document) == 48 do
        toolJsonAdvance(document)
    else
        if toolJsonDigits(document) == 0 do out 0 end
    end
    if toolJsonByte(document) == 46 do
        toolJsonAdvance(document)
        if toolJsonDigits(document) == 0 do out 0 end
    end
    let exponent = toolJsonByte(document)
    var hasExponent = 0
    if exponent == 101 do hasExponent = 1 end
    if exponent == 69 do hasExponent = 1 end
    if hasExponent == 1 do
        toolJsonAdvance(document)
        let sign = toolJsonByte(document)
        if sign == 43 do toolJsonAdvance(document) end
        if sign == 45 do toolJsonAdvance(document) end
        if toolJsonDigits(document) == 0 do out 0 end
    end
    out 1
end.

func toolJsonLiteral(document: int, text: int):
    var index = 0
    when native_read_u8(text, index) != 0 loop
        if toolJsonByte(document) != native_read_u8(text, index) do out 0 end
        toolJsonAdvance(document)
        index = index + 1
    end
    out 1
end.

func toolJsonLinkChild:
    in document: int
       parent: int
       child: int
       tail: int
    if tail == 0 do
        native_write_i64(toolJsonNode(document, parent), 24, child)
    else
        native_write_i64(toolJsonNode(document, tail), 32, child)
    end
end.

func toolJsonContainer(document: int, parent: int, depth: int):
    let kind = native_read_i64(toolJsonNode(document, parent), 0)
    var close = 93
    if kind == 3 do close = 125 end
    toolJsonAdvance(document)
    toolJsonWhitespace(document)
    if toolJsonByte(document) == close do toolJsonAdvance(document); out 1 end
    var tail = 0
    loop
        if kind == 3 do
            if toolJsonByte(document) != 34 do out 0 end
            let key = toolJsonValue(document, depth + 1)
            if key == 0 do out 0 end
            toolJsonLinkChild(document, parent, key, tail)
            tail = key
            toolJsonWhitespace(document)
            if toolJsonByte(document) != 58 do out 0 end
            toolJsonAdvance(document)
        end
        let child = toolJsonValue(document, depth + 1)
        if child == 0 do out 0 end
        toolJsonLinkChild(document, parent, child, tail)
        tail = child
        toolJsonWhitespace(document)
        if toolJsonByte(document) == close do toolJsonAdvance(document); out 1 end
        if toolJsonByte(document) != 44 do out 0 end
        toolJsonAdvance(document)
        toolJsonWhitespace(document)
    end
end.

func toolJsonValue(document: int, depth: int):
    if depth > 64 do out 0 end
    toolJsonWhitespace(document)
    let byte = toolJsonByte(document)
    var kind = 0
    if byte == 34 do kind = 1 end
    if byte == 45 do kind = 2 end
    if byte >= 48 do
        if byte <= 57 do kind = 2 end
    end
    if byte == 123 do kind = 3 end
    if byte == 91 do kind = 4 end
    if byte == 116 do kind = 5 end
    if byte == 102 do kind = 6 end
    if byte == 110 do kind = 7 end
    if kind == 0 do out 0 end
    let index = toolJsonAllocateNode(document, kind)
    if index == 0 do out 0 end
    var valid = 0
    if kind == 1 do valid = toolJsonStringToken(document) end
    if kind == 2 do valid = toolJsonNumberToken(document) end
    if kind == 3 do valid = toolJsonContainer(document, index, depth) end
    if kind == 4 do valid = toolJsonContainer(document, index, depth) end
    if kind == 5 do valid = toolJsonLiteral(document, "true" as int) end
    if kind == 6 do valid = toolJsonLiteral(document, "false" as int) end
    if kind == 7 do valid = toolJsonLiteral(document, "null" as int) end
    if valid == 0 do out 0 end
    native_write_i64(toolJsonNode(document, index), 16, native_read_i64(document, 16))
    out index
end.

func toolJsonFree(document: int):
    if document == 0 do out end
    var index = 1
    when index < native_read_i64(document, 32) loop
        let decoded = native_read_i64(toolJsonNode(document, index), 40)
        if decoded != 0 do vir_free(decoded) end
        index = index + 1
    end
    vir_free(native_read_i64(document, 0))
    vir_free(native_read_i64(document, 24))
    vir_free(document)
end.

func toolJsonParse(data: int, length: int):
    if data == 0 do out 0 end
    if length <= 0 do out 0 end
    if length > 16777216 do out 0 end
    let
        document = vir_alloc(56)
        source = vir_alloc(length + 1)
    var index = 0
    when index < length loop
        native_write_u8(source, index, native_read_u8(data, index))
        index = index + 1
    end
    native_write_u8(source, length, 0)
    native_write_i64(document, 0, source)
    native_write_i64(document, 8, length)
    native_write_i64(document, 16, 0)
    native_write_i64(document, 24, vir_alloc(12288))
    native_write_i64(document, 32, 1)
    native_write_i64(document, 40, 256)
    native_write_i64(document, 48, 0)
    let root = toolJsonValue(document, 0)
    if root == 0 do toolJsonFree(document); out 0 end
    toolJsonWhitespace(document)
    if native_read_i64(document, 16) != length do toolJsonFree(document); out 0 end
    out document
end.

func toolJsonHexAt(data: int, offset: int):
    var
        value = 0
        index = 0
    when index < 4 loop
        value = value * 16 + toolJsonHex(native_read_u8(data, offset + index))
        index = index + 1
    end
    out value
end.

func toolJsonWriteScalar(buffer: int, offset: int, scalar: int):
    if scalar <= 127 do
        native_write_u8(buffer, offset, scalar)
        out offset + 1
    end
    if scalar <= 2047 do
        native_write_u8(buffer, offset, 192 or (scalar shr 6))
        native_write_u8(buffer, offset + 1, 128 or (scalar and 63))
        out offset + 2
    end
    if scalar <= 65535 do
        native_write_u8(buffer, offset, 224 or (scalar shr 12))
        native_write_u8(buffer, offset + 1, 128 or ((scalar shr 6) and 63))
        native_write_u8(buffer, offset + 2, 128 or (scalar and 63))
        out offset + 3
    end
    native_write_u8(buffer, offset, 240 or (scalar shr 18))
    native_write_u8(buffer, offset + 1, 128 or ((scalar shr 12) and 63))
    native_write_u8(buffer, offset + 2, 128 or ((scalar shr 6) and 63))
    native_write_u8(buffer, offset + 3, 128 or (scalar and 63))
    out offset + 4
end.

# Returned string is borrowed from the document. Embedded NUL is valid JSON
# but unavailable to C-string consumers; never silently truncate a URI/key.
func toolJsonString(document: int, index: int):
    if index <= 0 do out 0 end
    if index >= native_read_i64(document, 32) do out 0 end
    let node = toolJsonNode(document, index)
    if native_read_i64(node, 0) != 1 do out 0 end
    let cached = native_read_i64(node, 40)
    if cached != 0 do out cached end
    let
        source = native_read_i64(document, 0)
        finish = native_read_i64(node, 16) - 1
        buffer = vir_alloc(finish - native_read_i64(node, 8) + 1)
    var
        cursor = native_read_i64(node, 8) + 1
        written = 0
    when cursor < finish loop
        var byte = native_read_u8(source, cursor)
        cursor = cursor + 1
        if byte == 92 do
            byte = native_read_u8(source, cursor)
            cursor = cursor + 1
            if byte == 117 do
                var scalar = toolJsonHexAt(source, cursor)
                cursor = cursor + 4
                if scalar >= 55296 do
                    if scalar <= 56319 do
                        let low = toolJsonHexAt(source, cursor + 2)
                        scalar = 65536 + (scalar - 55296) * 1024 + low - 56320
                        cursor = cursor + 6
                    end
                end
                if scalar == 0 do vir_free(buffer); out 0 end
                written = toolJsonWriteScalar(buffer, written, scalar)
                skip
            end
            if byte == 98 do byte = 8 end
            if byte == 102 do byte = 12 end
            if byte == 110 do byte = 10 end
            if byte == 114 do byte = 13 end
            if byte == 116 do byte = 9 end
        end
        native_write_u8(buffer, written, byte)
        written = written + 1
    end
    native_write_u8(buffer, written, 0)
    native_write_i64(node, 40, buffer)
    out buffer
end.

# Duplicate queried keys fail closed. Unknown fields are retained but ignored.
func toolJsonField(document: int, object: int, name: int):
    if object <= 0 do out 0 end
    if object >= native_read_i64(document, 32) do out 0 end
    let node = toolJsonNode(document, object)
    if native_read_i64(node, 0) != 3 do out 0 end
    var
        key = native_read_i64(node, 24)
        found = 0
    when key != 0 loop
        let value = native_read_i64(toolJsonNode(document, key), 32)
        let text = toolJsonString(document, key)
        if text != 0 do
            if rt_streq(text, name) do
                if found != 0 do out 0 end
                found = value
            end
        end
        key = native_read_i64(toolJsonNode(document, value), 32)
    end
    out found
end.

func toolJsonInteger(document: int, index: int, fallback: int):
    if index <= 0 do out fallback end
    if index >= native_read_i64(document, 32) do out fallback end
    let node = toolJsonNode(document, index)
    if native_read_i64(node, 0) != 2 do out fallback end
    let
        source = native_read_i64(document, 0)
        finish = native_read_i64(node, 16)
    var
        cursor = native_read_i64(node, 8)
        negative = 0
        value = 0
    if native_read_u8(source, cursor) == 45 do negative = 1; cursor = cursor + 1 end
    when cursor < finish loop
        let digit = native_read_u8(source, cursor) - 48
        if digit < 0 do out fallback end
        if digit > 9 do out fallback end
        if value < ((0 - 9223372036854775807 - 1) + digit) / 10 do out fallback end
        value = value * 10 - digit
        cursor = cursor + 1
    end
    if negative == 1 do out value end
    if value == 0 - 9223372036854775807 - 1 do out fallback end
    out 0 - value
end.

export toolJsonParse, toolJsonFree, toolJsonNode, toolJsonField,
       toolJsonString, toolJsonInteger
