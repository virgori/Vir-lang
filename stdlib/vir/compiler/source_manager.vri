##
 * vir/compiler/source_manager.vri — Source Origin & Source Manager
 * ==============================================================
 * Single source of truth for physical and logical source locations,
 * mapping preprocessed / expanded text back to pre-include origins.
 ##

include types
include rt.string_rt
import fat_str_new, fat_str_len, fat_str_byte_at, fat_str_eq, str_from_cstr from rt.string_rt
include rt.alloc
import vir_alloc from rt.alloc
include rt.vec_rt
import vec_new_rt, vec_push_rt, vec_get_rt, vec_len_rt from rt.vec_rt

extern func native_read_u8(addr: int, offset: int) -> int
extern func native_write_u8(addr: int, offset: int, val: int)
extern func native_read_i64(addr: int, offset: int) -> int
extern func native_write_i64(addr: int, offset: int, val: int)

entity SourceFile:
    file_id:        int,
    display_path:   string,
    canonical_path: string,
    src_content:    int,
    line_count:     int
end.

entity SourceMapSegment:
    expanded_start_line: int,
    expanded_end_line:   int,
    original_file_id:    int,
    original_start_line: int
end.

entity SourceSpan:
    file_id:       int,
    start_line:    int,
    start_col:     int,
    end_line:      int,
    end_col:       int
end.

entity SourceManager:
    files:         int,
    segments:      int,
    spans:         int
end.

var g_active_source_manager: i64 = 0

func sm_new():
    let sm = vir_alloc(24)
    var spans = vec_new_rt()
    spans = vec_push_rt(spans, 0); # span id 0 is invalid
    native_write_i64(sm, 0, vec_new_rt())
    native_write_i64(sm, 8, vec_new_rt())
    native_write_i64(sm, 16, spans)
    out sm
end.

func sm_register_file(sm: i64, display_path: string, canonical_path: string):
    if sm == 0 do out 0 end
    let files = native_read_i64(sm, 0)
    let n = vec_len_rt(files)
    var i = 0
    when i < n loop
        let f = vec_get_rt(files, i)
        let cur_disp = native_read_i64(f, 8) as string
        if fat_str_eq(cur_disp, display_path) == 1 do
            out i
        end
        i = i + 1
    end
    let f_obj = vir_alloc(40)
    native_write_i64(f_obj, 0, n)
    native_write_i64(f_obj, 8, display_path as i64)
    native_write_i64(f_obj, 16, canonical_path as i64)
    native_write_i64(f_obj, 24, 0)
    native_write_i64(f_obj, 32, 0)
    let new_files = vec_push_rt(files, f_obj)
    native_write_i64(sm, 0, new_files)
    out n
end.

func sm_get_file_path(sm: i64, file_id: int):
    if sm == 0 do out 0 end
    let files = native_read_i64(sm, 0)
    let n = vec_len_rt(files)
    if file_id < 0 or file_id >= n do
        out 0
    end
    let f = vec_get_rt(files, file_id)
    let fat = native_read_i64(f, 8)
    if fat == 0 do out 0 end
    out native_read_i64(fat, 0)
end.

func sm_add_segment(sm: i64, exp_start: int, exp_end: int, orig_fid: int, orig_start: int):
    if sm == 0 do out 0 end
    let segs = native_read_i64(sm, 8)
    let seg = vir_alloc(32)
    native_write_i64(seg, 0, exp_start)
    native_write_i64(seg, 8, exp_end)
    native_write_i64(seg, 16, orig_fid)
    native_write_i64(seg, 24, orig_start)
    let new_segs = vec_push_rt(segs, seg)
    native_write_i64(sm, 8, new_segs)
    out 0
end.

func sm_find_segment(sm: i64, exp_line: int):
    if sm == 0 do out 0 - 1 end
    let segs = native_read_i64(sm, 8)
    let count = vec_len_rt(segs)
    if count <= 0 do out 0 - 1 end
    var low = 0
    var high = count - 1
    var best = 0 - 1
    when low <= high loop
        let mid = (low + high) / 2
        let seg = vec_get_rt(segs, mid)
        let s_start = native_read_i64(seg, 0)
        let s_end = native_read_i64(seg, 8)
        if exp_line >= s_start and exp_line <= s_end do
            out mid
        eif exp_line < s_start do
            high = mid - 1
        else
            best = mid
            low = mid + 1
        end
    end
    out best
end.

func sm_file_from_line(sm: i64, exp_line: int):
    let s_idx = sm_find_segment(sm, exp_line)
    if s_idx < 0 do out 0 end
    let segs = native_read_i64(sm, 8)
    let seg = vec_get_rt(segs, s_idx)
    out native_read_i64(seg, 16)
end.

func sm_line_from_expanded(sm: i64, exp_line: int):
    let s_idx = sm_find_segment(sm, exp_line)
    if s_idx < 0 do out exp_line end
    let segs = native_read_i64(sm, 8)
    let seg = vec_get_rt(segs, s_idx)
    let s_start = native_read_i64(seg, 0)
    let orig_start = native_read_i64(seg, 24)
    out orig_start + (exp_line - s_start)
end.

func sm_add_span(sm: i64, fid: int, s_line: int, s_col: int, e_line: int, e_col: int):
    if sm == 0 do out 0 end
    let spans = native_read_i64(sm, 16)
    let n = vec_len_rt(spans)
    let sp = vir_alloc(40)
    native_write_i64(sp, 0, fid)
    native_write_i64(sp, 8, s_line)
    native_write_i64(sp, 16, s_col)
    native_write_i64(sp, 24, e_line)
    native_write_i64(sp, 32, e_col)
    let new_spans = vec_push_rt(spans, sp)
    native_write_i64(sm, 16, new_spans)
    out n
end.

func sm_get_span(sm: i64, span_id: int):
    if sm == 0 or span_id <= 0 do out 0 end
    let spans = native_read_i64(sm, 16)
    let n = vec_len_rt(spans)
    if span_id >= n do out 0 end
    out vec_get_rt(spans, span_id)
end.

func sm_build_from_source(sm: i64, source: string, main_file: int):
    if sm == 0 do out 0 end
    let data = native_read_i64(source as i64, 0)
    let n = native_read_i64(source as i64, 8)
    if n <= 0 do out 0 end

    let main_fat = str_from_cstr(main_file)
    let main_fid = sm_register_file(sm, main_fat, main_fat)

    var cur_fid = main_fid
    var cur_orig_start = 1
    var cur_exp_start = 1
    var pos = 0
    var cur_line = 1
    var has_markers = 0

    when pos < n loop
        let line_start = pos
        when pos < n and native_read_u8(data, pos) != 10 loop
            pos = pos + 1
        end
        let line_end = pos

        var is_marker = 0
        if line_end - line_start >= 15 do
            if native_read_u8(data, line_start) == 35 and native_read_u8(data, line_start + 1) == 32 and native_read_u8(data, line_start + 2) == 64 and native_read_u8(data, line_start + 3) == 118 and native_read_u8(data, line_start + 4) == 105 and native_read_u8(data, line_start + 5) == 114 and native_read_u8(data, line_start + 6) == 95 and native_read_u8(data, line_start + 7) == 115 and native_read_u8(data, line_start + 8) == 111 and native_read_u8(data, line_start + 9) == 117 and native_read_u8(data, line_start + 10) == 114 and native_read_u8(data, line_start + 11) == 99 and native_read_u8(data, line_start + 12) == 101 and native_read_u8(data, line_start + 13) == 32 do
                is_marker = 1
            end
        end

        if is_marker == 1 do
            has_markers = 1
            if cur_exp_start <= cur_line - 1 do
                sm_add_segment(sm, cur_exp_start, cur_line - 1, cur_fid, cur_orig_start)
            end

            var p_start = line_start + 14
            when p_start < line_end and native_read_u8(data, p_start) == 32 loop
                p_start = p_start + 1
            end

            var p_end = p_start
            var orig_line = 1
            if p_start < line_end and native_read_u8(data, p_start) == 34 do
                p_start = p_start + 1
                p_end = p_start
                when p_end < line_end and native_read_u8(data, p_end) != 34 loop
                    p_end = p_end + 1
                end
                var l_pos = p_end + 1
                when l_pos < line_end and native_read_u8(data, l_pos) == 32 loop
                    l_pos = l_pos + 1
                end
                orig_line = 0
                when l_pos < line_end loop
                    let c = native_read_u8(data, l_pos)
                    if c >= 48 and c <= 57 do
                        orig_line = orig_line * 10 + c - 48
                    end
                    l_pos = l_pos + 1
                end
            else
                var last_sp = line_end - 1
                when last_sp > p_start and native_read_u8(data, last_sp) != 32 loop
                    last_sp = last_sp - 1
                end
                p_end = last_sp
                orig_line = 0
                var l_pos = last_sp + 1
                when l_pos < line_end loop
                    let c = native_read_u8(data, l_pos)
                    if c >= 48 and c <= 57 do
                        orig_line = orig_line * 10 + c - 48
                    end
                    l_pos = l_pos + 1
                end
            end

            if orig_line <= 0 do orig_line = 1 end
            let path_len = p_end - p_start
            let path_buf = vir_alloc(path_len + 1)
            var pi = 0
            when pi < path_len loop
                native_write_u8(path_buf, pi, native_read_u8(data, p_start + pi))
                pi = pi + 1
            end
            native_write_u8(path_buf, path_len, 0)
            let path_fat = str_from_cstr(path_buf)
            cur_fid = sm_register_file(sm, path_fat, path_fat)
            cur_orig_start = orig_line
            cur_exp_start = cur_line + 1
        end

        if pos < n and native_read_u8(data, pos) == 10 do
            pos = pos + 1
        end
        cur_line = cur_line + 1
    end

    if cur_exp_start <= cur_line do
        sm_add_segment(sm, cur_exp_start, cur_line, cur_fid, cur_orig_start)
    end
    if has_markers == 0 do
        sm_add_segment(sm, 1, cur_line, main_fid, 1)
    end
    out 0
end.

export SourceFile, SourceMapSegment, SourceSpan, SourceManager, g_active_source_manager,
       sm_new, sm_register_file, sm_get_file_path, sm_add_segment, sm_find_segment,
       sm_file_from_line, sm_line_from_expanded, sm_add_span, sm_get_span, sm_build_from_source
