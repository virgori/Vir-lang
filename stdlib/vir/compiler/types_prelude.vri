##
 * vir/core/types.vri — Primitive types & limits
 * ===================================================
 * Inspired by C23: <stdint.h>, <stddef.h>, <limits.h>, <float.h>
 * Inspired by Python: builtins (int, float, bool, None)
 *
 * This is the foundation: all other modules depend on vir/core/types.
 * Compiler uses internally: i64 for registers, u8 for byte buffer, bool for flags.
 ##

# ═══════════════════════════════════════════════════════
# Signed integer types
# ═══════════════════════════════════════════════════════

type i8;      # 8-bit signed:  -128 .. 127
type i16;     # 16-bit signed: -32768 .. 32767
type i32;     # 32-bit signed: -2^31 .. 2^31 - 1
type i64;     # 64-bit signed: -2^63 .. 2^63 - 1  (default for integers)

# ═══════════════════════════════════════════════════════
# Unsigned integer types
# ═══════════════════════════════════════════════════════

type u8;      # 8-bit unsigned: 0 .. 255
type u16;     # 16-bit unsigned: 0 .. 65535
type u32;     # 32-bit unsigned: 0 .. 2^32 - 1
type u64;     # 64-bit unsigned: 0 .. 2^64 - 1

# ═══════════════════════════════════════════════════════
# Floating point types (IEEE 754)
# ═══════════════════════════════════════════════════════

type f32;     # 32-bit float (single precision)
type f64;     # 64-bit float (double precision, default for floats)

# ═══════════════════════════════════════════════════════
# Other fundamental types
# ═══════════════════════════════════════════════════════

type bool;    # true / false
type byte;    # alias for u8 — use for binary data
type ptr;     # raw pointer — address-as-integer (u64 internally)
type void;    # void type — func returns nothing

# ═══════════════════════════════════════════════════════
# Size types (from C23 <stddef.h>)
# ═══════════════════════════════════════════════════════

type usize;   # unsigned, pointer-sized (u64 on 64-bit)
type isize;   # signed, pointer-sized (i64 on 64-bit)

# ═══════════════════════════════════════════════════════
# Type limits (from C23 <limits.h> + <float.h>)
# ═══════════════════════════════════════════════════════

const I8_MIN: -128;
const I8_MAX: 127;
const I16_MIN: -32768;
const I16_MAX: 32767;
const I32_MIN: -2147483648;
const I32_MAX: 2147483647;
const I64_MIN: -9223372036854775808;
const I64_MAX: 9223372036854775807;

const U8_MAX: 255;
const U16_MAX: 65535;
const U32_MAX: 4294967295;
const U64_MAX: 18446744073709551615;

const F32_EPSILON: 1.1920929e-7;
const F32_MIN: 1.17549435e-38;
const F32_MAX: 3.40282347e+38;

const F64_EPSILON: 2.2204460492503131e-16;
const F64_MIN: 2.2250738585072014e-308;
const F64_MAX: 1.7976931348623157e+308;

# ═══════════════════════════════════════════════════════
# Type conversion functions
# ═══════════════════════════════════════════════════════

