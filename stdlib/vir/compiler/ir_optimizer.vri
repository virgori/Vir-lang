##
 * vir/compiler/ir_optimizer.vri — AST→Q-IR Lowering + Linear-Scan RegAlloc
 * =========================================================================
 * Pure Vir implementation. Transforms AST into Q-IR instructions,
 * performs liveness analysis, linear-scan register allocation,
 * spill code insertion, and tail-call optimization.
 *
 * Converted from C (core/src/ir_lower.c) for self-hosting.
 ##

include types;
include string;
import String, str_new, str_concat, str_len, str_eq from string;
include option;
import Option, is_some, unwrap from option;
include vec;
import Vec, vec_new, vec_push, vec_len, vec_get, vec_set from vec;
include map;
import Map, string_map_new, map_insert, map_get from map;
include lexer;
import TokType from lexer;
include parser;
import AstNode, AstType, OpType, BuiltinId from parser;


# ═══════════════════════════════════════════════════════
# Q-IR Opcode Set
# ═══════════════════════════════════════════════════════

enum QOp:
    Nop             = 0;
    Load            = 1;
    Move            = 2;
    Add             = 3;
    Sub             = 4;
    Mul             = 5;
    Div             = 6;
    Mod             = 7;
    And             = 8;
    Or              = 9;
    Xor             = 10;
    Shl             = 11;
    Shr             = 12;
    CmpEq           = 20;
    CmpNe           = 21;
    CmpGt           = 22;
    CmpLt           = 23;
    CmpGe           = 24;
    CmpLe           = 25;
    Jump            = 30;
    JumpIfNot       = 31;
    Label           = 32;
    Call            = 33;
    CallFunc        = 34;
    Ret             = 35;
    Print           = 40;
    PrintStr        = 41;
    Input           = 42;
    Alloc           = 50;
    Free            = 51;
    LoadByte        = 52;
    StoreByte       = 53;
    LoadWord        = 54;
    StoreWord       = 55;
    ArrNew          = 60;
    ArrPush         = 61;
    ArrGet          = 62;
    ArrSet          = 63;
    ArrLen          = 64;
    StrLenOp        = 70;
    StrGet          = 71;
    StrCat          = 72;
    StrEq           = 73;
    IToStr          = 74;
    StrToI          = 75;
    FileOpen        = 80;
    FileRead        = 81;
    FileWrite       = 82;
    FileClose       = 83;
    FileWriteByte   = 84;
    Exit            = 90;
    PatchPoint      = 91;
    LoadGlobal      = 92;
    StoreGlobal     = 93;
    GetArg          = 94;
    ArgCount        = 95;
    # §13 Error handling
    TryBegin        = 192;   # 0xC0
    TryEnd          = 193;   # 0xC1
    ThrowOp         = 194;   # 0xC2
    ErxLoad         = 195;   # 0xC3
    ResumeRetry     = 196;   # 0xC4
    ResumeRevert    = 197;   # 0xC5
    # §19 / §4.5 / §22 — Phase 7.3 parity with C core q_ir.h
    ArrCap          = 149;   # 0x95
    ArrCompact      = 150;   # 0x96
    ArenaNew        = 133;   # 0x85
    ArenaAlloc      = 134;   # 0x86
    ArenaFree       = 135;   # 0x87
    TaskWait        = 244;   # 0xF4
    TaskCancel      = 245;   # 0xF5
    Yield           = 246;   # 0xF6 — cooperative yield (await pass)
    # §20 Dict — Phase 7.5 runtime parity
    DictNew         = 230;   # 0xE6
    DictSet         = 231;   # 0xE7
    DictGet         = 232;   # 0xE8
    DictHas         = 233;   # 0xE9
    DictDel         = 234;   # 0xEA
    DictSize        = 235;   # 0xEB
    # §23 Port — Phase 7.5 runtime parity
    PortNew         = 236;   # 0xEC
    PortSend        = 237;   # 0xED
    PortRecv        = 238;   # 0xEE
    PortLen         = 239;   # 0xEF
    PortClose       = 240;   # 0xF0
    # §24 Tensor — Phase 7.5 runtime parity
    TensorNew       = 247;   # 0xF7
    TensorGet1D     = 248;   # 0xF8
    Intrinsic       = 249;   # 0xF9
    TensorSet1D     = 255;   # Will fix later if needed, but Intrinsic must be 249
    TensorGet2D     = 250;   # 0xFA
    TensorSet2D     = 251;   # 0xFB
    TensorMatmul    = 252;   # 0xFC
    TensorHadamard  = 253;   # 0xFD
    TensorQuantize  = 254   # 0xFE
end.


# ═══════════════════════════════════════════════════════
# Q-IR Operand
# ═══════════════════════════════════════════════════════

enum OperandType:
    None        = 0;
    VReg        = 1;
    Immediate   = 2;
    LabelRef    = 3;
    StringRef   = 4;
    FuncIdx     = 5
end.

entity QOperand:
    op_type:    OperandType,
        vreg: i64,
        imm_val: i64
end.

func q_none:
    out QOperand ( op_type: OperandType.None, vreg: 0, imm_val: 0 )
end.

func q_vreg:
    in(r: i64)
    out QOperand ( op_type: OperandType.VReg, vreg: r, imm_val: 0 )
end.

func q_imm:
    in(val: i64)
    out QOperand ( op_type: OperandType.Immediate, vreg: 0, imm_val: val )
end.

func q_label:
    in(id: i64)
    out QOperand ( op_type: OperandType.LabelRef, vreg: id, imm_val: 0 )
end.

func q_str_ref:
    in(idx: i64)
    out QOperand ( op_type: OperandType.StringRef, vreg: idx, imm_val: 0 )
end.

func q_func_idx:
    in(idx: i64)
    out QOperand ( op_type: OperandType.FuncIdx, vreg: idx, imm_val: 0 )
end.


# ═══════════════════════════════════════════════════════
# Q-IR Instruction
# ═══════════════════════════════════════════════════════

entity QInstr:
    opcode:     QOp,
        dest:       QOperand,
        src1:       QOperand,
        src2:       QOperand,
        patch_id: i64
end.

func q_instr:
    in(op:QOp; d:QOperand; s1:QOperand; s2:QOperand)
    out QInstr ( opcode: op, dest: d, src1: s1, src2: s2, patch_id: 0 )
end.


# ═══════════════════════════════════════════════════════
# Q-IR Function & Module
# ═══════════════════════════════════════════════════════

entity QFunction:
    name:           string,
        body:           Vec<QInstr>,
        param_count: i64,
        param_vregs:    Vec<int>,
        param_names:    Vec<string>   # §6.4 named-arg reorder
end.

func q_func_new:
    in(name:string)
    out QFunction (
        name:        name,
        body:        vec_new<QInstr>(),
        param_count: 0,
        param_vregs: vec_new<int>(),
        param_names: vec_new<string>()
    )
end.

func q_func_emit:
    in(f:QFunction; instr:QInstr)
    vec_push(f.body, instr);
    out f
end.


entity QModule:
    name:       string,
        functions:  Vec<QFunction>,
        strings:    Vec<string>,
        string_map: Map<string, i64>,
        func_map:   Map<string, i64>
end.

func q_module_new:
    in(name:string)
    out QModule (
        name:       name,
        functions:  vec_new<QFunction>(),
        strings:    vec_new<string>(),
        string_map: string_map_new<i64>(),
        func_map:   string_map_new<i64>()
    )
end.

func q_module_add_func:
    in(m:QModule; name:string)
    f = q_func_new(name);
    vec_push(m.functions, f);
    let idx = (vec_len(m.functions) - 1) as i64;
    map_insert<string, i64>(&m.func_map, name, idx);
    out (m, idx)
end.

func q_module_add_string:
    in(m:QModule; s:string)
    # Check if string already exists in O(1)
    var idx_opt = map_get<string, i64>(m.string_map, s);
    if is_some(idx_opt) do
        out (m, unwrap<i64>(idx_opt))
    end
    
    vec_push(m.strings, s);
    let idx = (vec_len(m.strings) - 1) as i64;
    map_insert<string, i64>(&m.string_map, s, idx);
    out (m, idx)
end.


# ═══════════════════════════════════════════════════════
# Symbol Table
# ═══════════════════════════════════════════════════════

entity SymEntry:
    name:               string,
        vreg: i64,
        is_move_type: i64;    # array/string/entity — needs drop
    is_moved: i64;    # value already moved out
    borrow_shared_count: i64;   # active shared borrows (&)
    borrow_mut_count: i64;    # active mutable borrows (&mut)
    borrow_kind: i64;    # 0=none, 1=shared, 2=mut
    borrow_of_name:     string # name of the variable being borrowed
end.

# §4.8 NLL: transient borrow record for stmt-level tracking
entity BorrowRecord:
    target:     string;   # name of borrowed variable
    kind: i64;      # 1=shared, 2=mut
    claimed: i64      # 1=consumed by a binder
end.

entity SymTable:
    entries:    Vec<SymEntry>,
        name_map:   Map<string, i64>
end.

func sym_new:
    out SymTable ( entries: vec_new<SymEntry>(), name_map: string_map_new<i64>() )
end.

func sym_define:
    in(st:SymTable; name:string; vreg: i64)
    # Check map first for O(1) lookup
    var idx_opt = map_get<string, i64>(st.name_map, name);
    if is_some(idx_opt) do
        idx = unwrap<i64>(idx_opt);
        entry = vec_get(st.entries, idx);
        entry.vreg = vreg;
        vec_set(st.entries, idx, entry);
        out st
    end
    # Not found, add new
    vec_push(st.entries, SymEntry ( name: name, vreg: vreg, is_move_type: 0, is_moved: 0, borrow_shared_count: 0, borrow_mut_count: 0, borrow_kind: 0, borrow_of_name: str_new("") ));
    map_insert<string, i64>(&st.name_map, name, vec_len(st.entries) - 1);
    out st
end.

func sym_lookup:
    in(st:SymTable; name:string)
    var idx_opt = map_get<string, i64>(st.name_map, name);
    if is_some(idx_opt) do
        idx = unwrap<i64>(idx_opt);
        entry = vec_get(st.entries, idx);
        out (true, entry.vreg)
    end
    out (false, 0)
end.


# ═══════════════════════════════════════════════════════
# Enum / Entity Type Registry
# ═══════════════════════════════════════════════════════

entity EnumVariant:
    name:   string,
        value: i64
end.

entity EnumType:
    name:       string,
        variants:   Vec<EnumVariant>
end.

entity EntityField:
    name:   string,
        offset: i64
end.

entity EntityType:
    name:       string,
        fields:     Vec<EntityField>
end.

func type_lookup_enum:
    in(ctx:LowerCtx; name:string)
    var idx_opt = map_get<string, i64>(ctx.enum_map, name);
    if is_some(idx_opt) do
        out (true, unwrap<i64>(idx_opt))
    end
    out (false, -1)
end.

func enum_lookup_variant:
    in(et:EnumType; variant:string)
    i = 0;
    when i < vec_len(et.variants) loop
        v = vec_get(et.variants, i);
        if str_eq(v.name, variant) do
            out (true, v.value)
        end
        i = i + 1
    end
    out (false, 0)
end.

func find_entity_type:
    in(ctx:LowerCtx; name:string)
    var idx_opt = map_get<string, i64>(ctx.entity_map, name);
    if is_some(idx_opt) do
        out (true, unwrap<i64>(idx_opt))
    end
    out (false, -1)
end.

func entity_field_offset:
    in(et:EntityType; field:string)
    i = 0;
    when i < vec_len(et.fields) loop
        f = vec_get(et.fields, i);
        if str_eq(f.name, field) do
            out (true, f.offset as i64)
        end
        i = i + 1
    end
    out (false, -1)
end.


# ═══════════════════════════════════════════════════════
# Lowering Context
# ═══════════════════════════════════════════════════════

entity LowerCtx:
    prog:             QModule,
        next_vreg: i64,
        label_counter: i64,
        symbols:            SymTable,
        global_symbols:     SymTable,
        global_idx_counter: i64,
        enum_types:         Vec<EnumType>,
        entity_types:       Vec<EntityType>,
        enum_map:           Map<string, i64>,
        entity_map:         Map<string, i64>,
        current_func_idx: i64,
        loop_depth: i64,
        loop_start_labels:  Vec<int>,
        loop_end_labels:    Vec<int>,
        error_count: i64,
        last_error:         string,
        patch_counter: i64;
    # §4.8 NLL borrow checker state
    stmt_borrows:       Vec<BorrowRecord>
end.

func lower_ctx_new:
    in(mod_name:string)
    out LowerCtx (
        prog:             q_module_new(mod_name),
        next_vreg:          0,
        label_counter:      0,
        symbols:            sym_new(),
        global_symbols:     sym_new(),
        global_idx_counter: 0,
        enum_types:         vec_new<EnumType>(),
        entity_types:       vec_new<EntityType>(),
        enum_map:           string_map_new<i64>(),
        entity_map:         string_map_new<i64>(),
        current_func_idx:   -1,
        loop_depth:         0,
        loop_start_labels:  vec_new<int>(),
        loop_end_labels:    vec_new<int>(),
        error_count:        0,
        last_error:         str_new(""),
        patch_counter:      0,
        stmt_borrows:       vec_new<BorrowRecord>()
    )
end.

func fresh_vreg:
    in(ctx:LowerCtx)
    r = ctx.next_vreg;
    ctx.next_vreg = ctx.next_vreg + 1;
    out (ctx, r)
end.

func fresh_label:
    in(ctx:LowerCtx)
    l = ctx.label_counter;
    ctx.label_counter = ctx.label_counter + 1;
    out (ctx, l)
end.

func lower_error:
    in(ctx:LowerCtx; msg:string)
    ctx.last_error = msg;
    ctx.error_count = ctx.error_count + 1;
    out ctx
end.

func emit_instr:
    in(ctx:LowerCtx; instr:QInstr)
    if ctx.current_func_idx >= 0 do
        f = vec_get(ctx.prog.functions, ctx.current_func_idx);
        f = q_func_emit(f, instr);
        vec_set(ctx.prog.functions, ctx.current_func_idx, f)
    end
    out ctx
end.

func sym_lookup_both:
    in(ctx:LowerCtx; name:string)
    # Returns: 0=local, 1=global, -1=not found; and the vreg/index
    var (found, vreg) = sym_lookup(ctx.symbols, name);
    if found do
        out (0, vreg)
    end
    var (found2, idx) = sym_lookup(ctx.global_symbols, name);
    if found2 do
        out (1, idx)
    end
    out (-1, 0)
end.

func find_func_index:
    in(ctx:LowerCtx; name:string)
    var idx_opt = map_get<string, i64>(ctx.prog.func_map, name);
    if is_some(idx_opt) do
        out unwrap<i64>(idx_opt)
    end
    out -1
end.


# ═══════════════════════════════════════════════════════
# §4.8 Borrow Checker (NLL) — Ownership helpers
# ═══════════════════════════════════════════════════════

# Look up a symbol entry by name (returns found flag + entry index in table)
func sym_lookup_entry:
    in(st:SymTable; name:string)
    var idx_opt = map_get<string, i64>(st.name_map, name);
    if is_some(idx_opt) do
        out (true, unwrap<i64>(idx_opt))
    end
    out (false, -1)
end.

# Check if an AST expression produces a move-typed value (heap alloc)
func ast_produces_move_type:
    in(expr:AstNode)
    if expr.node_type == AstType.ArrayLiteral do
        out true
    end
    if expr.node_type == AstType.LiteralStr do
        out true
    end
    if expr.node_type == AstType.EntityLiteral do
        out true
    end
    out false
end.

# Release a borrow held by a symbol entry, decrementing target's counter
func ownership_release_borrow:
    in(ctx:LowerCtx; table_name:string)
    # Find the borrower entry
    var (found, bidx) = sym_lookup_entry(ctx.symbols, table_name);
    if not found do
        out ctx
    end
    borrower = vec_get(ctx.symbols.entries, bidx);
    if borrower.borrow_kind == 0 do
        out ctx
    end
    # Find the target being borrowed and decrement its counter
    var (tfound, tidx) = sym_lookup_entry(ctx.symbols, borrower.borrow_of_name);
    if tfound do
        target = vec_get(ctx.symbols.entries, tidx);
        if borrower.borrow_kind == 1 and target.borrow_shared_count > 0 do
            target.borrow_shared_count = target.borrow_shared_count - 1;
            vec_set(ctx.symbols.entries, tidx, target)
        end
        if borrower.borrow_kind == 2 and target.borrow_mut_count > 0 do
            target.borrow_mut_count = target.borrow_mut_count - 1;
            vec_set(ctx.symbols.entries, tidx, target)
        end
    end
    # Clear the borrower's borrow state
    borrower.borrow_kind = 0;
    borrower.borrow_of_name = str_new("");
    vec_set(ctx.symbols.entries, bidx, borrower);
    out ctx
end.

# Release all unclaimed stmt borrows at end of statement
func ownership_release_unclaimed:
    in(ctx:LowerCtx)
    i = 0;
    when i < vec_len(ctx.stmt_borrows) loop
        rec = vec_get(ctx.stmt_borrows, i);
        if rec.claimed == 0 do
            var (tfound, tidx) = sym_lookup_entry(ctx.symbols, rec.target);
            if tfound do
                target = vec_get(ctx.symbols.entries, tidx);
                if rec.kind == 1 and target.borrow_shared_count > 0 do
                    target.borrow_shared_count = target.borrow_shared_count - 1;
                    vec_set(ctx.symbols.entries, tidx, target)
                end
                if rec.kind == 2 and target.borrow_mut_count > 0 do
                    target.borrow_mut_count = target.borrow_mut_count - 1;
                    vec_set(ctx.symbols.entries, tidx, target)
                end
            end
        end
        i = i + 1
    end
    ctx.stmt_borrows = vec_new<BorrowRecord>()
    out ctx
end.

# Claim the most recent matching stmt borrow for a binder (var/assign)
func ownership_claim_stmt_borrow:
    in(ctx:LowerCtx; borrower_name:string; target_name:string; kind: i64)
    i = vec_len(ctx.stmt_borrows) - 1;
    when i >= 0 loop
        rec = vec_get(ctx.stmt_borrows, i);
        if rec.claimed == 0 and rec.kind == kind and str_eq(rec.target, target_name) do
            rec.claimed = 1;
            vec_set(ctx.stmt_borrows, i, rec);
            # Set borrower's back-link
            var (found, bidx) = sym_lookup_entry(ctx.symbols, borrower_name);
            if found do
                borrower = vec_get(ctx.symbols.entries, bidx);
                borrower.borrow_kind = kind;
                borrower.borrow_of_name = target_name;
                vec_set(ctx.symbols.entries, bidx, borrower)
            end
            out ctx
        end
        i = i - 1
    end
    out ctx
end.

# If src is a bare identifier of a move-type var, mark it as moved
func ownership_mark_moved_if_id:
    in(ctx:LowerCtx; src:AstNode)
    # AddrOf (&x) does NOT consume
    if src.node_type == AstType.AddrOf do
        out ctx
    end
    if src.node_type != AstType.Identifier do
        out ctx
    end
    var (found, eidx) = sym_lookup_entry(ctx.symbols, src.name);
    if not found do
        out ctx
    end
    entry = vec_get(ctx.symbols.entries, eidx);
    if entry.is_move_type == 1 do
        entry.is_moved = 1;
        vec_set(ctx.symbols.entries, eidx, entry)
    end
    out ctx
end.


# ═══════════════════════════════════════════════════════
# Expression Lowering
# ═══════════════════════════════════════════════════════

func lower_expr:
    in(ctx:LowerCtx; expr:AstNode)
    if expr.node_type == AstType.LiteralInt do
        var (ctx2, r) = fresh_vreg(ctx);
        ctx2 = emit_instr(ctx2, q_instr(QOp.Load, q_vreg(r), q_imm(expr.int_val), q_none()));
        out (ctx2, r as i64)
    end

    if expr.node_type == AstType.LiteralFloat do
        var (ctx2, r) = fresh_vreg(ctx);
        ctx2 = emit_instr(ctx2, q_instr(QOp.Load, q_vreg(r), q_imm(expr.float_val as i64), q_none()));
        out (ctx2, r as i64)
    end

    if expr.node_type == AstType.LiteralStr do
        var (ctx2, str_idx) = q_module_add_string(ctx.prog, expr.name);
        ctx.prog = ctx2;
        var (ctx3, r) = fresh_vreg(ctx);
        ctx3 = emit_instr(ctx3, q_instr(QOp.Load, q_vreg(r), q_str_ref(str_idx), q_none()));
        out (ctx3, r as i64)
    end

    if expr.node_type == AstType.Identifier do
        var (scope, idx) = sym_lookup_both(ctx, expr.name);
        if scope < 0 do
            ctx = lower_error(ctx, str_concat(str_new("undefined variable: "), expr.name));
            out (ctx, -1)
        end
        # §4.8: reject read of a moved value
        if scope == 0 do
            var (efound, eidx) = sym_lookup_entry(ctx.symbols, expr.name);
            if efound do
                ent = vec_get(ctx.symbols.entries, eidx);
                if ent.is_moved == 1 do
                    ctx = lower_error(ctx, str_concat(str_new("use of moved value: '"), str_concat(expr.name, str_new("'"))));
                    out (ctx, -1)
                end
            end
        end
        if scope == 1 do
            var (ctx2, rd) = fresh_vreg(ctx);
            ctx2 = emit_instr(ctx2, q_instr(QOp.LoadGlobal, q_vreg(rd), q_imm(idx as i64), q_none()));
            out (ctx2, rd as i64)
        end
        out (ctx, idx as i64)
    end

    # §4.8 AddrOf: &x (shared) / &mut x — borrow conflict check
    if expr.node_type == AstType.AddrOf do
        if vec_len(expr.children) < 1 do
            ctx = lower_error(ctx, str_new("borrow without operand"));
            out (ctx, -1)
        end
        is_mut = expr.int_val;
        tgt = vec_get(expr.children, 0);
        if tgt.node_type == AstType.Identifier do
            var (efound, eidx) = sym_lookup_entry(ctx.symbols, tgt.name);
            if efound do
                ent = vec_get(ctx.symbols.entries, eidx);
                if ent.is_moved == 1 do
                    ctx = lower_error(ctx, str_concat(str_new("borrow of moved value: '"), str_concat(tgt.name, str_new("'"))));
                    out (ctx, -1)
                end
                if is_mut != 0 do
                    if ent.borrow_shared_count > 0 do
                        ctx = lower_error(ctx, str_concat(str_new("cannot borrow '"), str_concat(tgt.name, str_new("' as mutable: already borrowed as shared"))));
                        out (ctx, -1)
                    end
                    if ent.borrow_mut_count > 0 do
                        ctx = lower_error(ctx, str_concat(str_new("cannot borrow '"), str_concat(tgt.name, str_new("' as mutable more than once"))));
                        out (ctx, -1)
                    end
                    ent.borrow_mut_count = ent.borrow_mut_count + 1
                else
                    if ent.borrow_mut_count > 0 do
                        ctx = lower_error(ctx, str_concat(str_new("cannot borrow '"), str_concat(tgt.name, str_new("' as shared: already borrowed as mutable"))));
                        out (ctx, -1)
                    end
                    ent.borrow_shared_count = ent.borrow_shared_count + 1
                end
                vec_set(ctx.symbols.entries, eidx, ent);
                # Record transient borrow for stmt-level tracking
                borrow_kind = 1;
                if is_mut != 0 do
                    borrow_kind = 2
                end
                vec_push(ctx.stmt_borrows, BorrowRecord ( target: tgt.name, kind: borrow_kind, claimed: 0 ))
            end
            # Materialise value like a plain read
            var (scope2, idx2) = sym_lookup_both(ctx, tgt.name);
            if scope2 == 1 do
                var (ctx2, rd) = fresh_vreg(ctx);
                ctx2 = emit_instr(ctx2, q_instr(QOp.LoadGlobal, q_vreg(rd), q_imm(idx2 as i64), q_none()));
                out (ctx2, rd as i64)
            end
            out (ctx, idx2 as i64)
        end
        # Non-identifier borrow (e.g. &obj.field) — pass through
        out lower_expr(ctx, tgt)
    end

    if expr.node_type == AstType.BinOp do
        var (ctx2, lhs) = lower_expr(ctx, vec_get(expr.children, 0));
        if lhs < 0 do
            out (ctx2, -1)
        end
        var (ctx3, rhs) = lower_expr(ctx2, vec_get(expr.children, 1));
        if rhs < 0 do
            out (ctx3, -1)
        end
        var (ctx4, rd) = fresh_vreg(ctx3);
        op = QOp.Add;
        if expr.op == OpType.Sub do
            op = QOp.Sub
        end
        if expr.op == OpType.Mul do
            op = QOp.Mul
        end
        if expr.op == OpType.Div do
            op = QOp.Div
        end
        if expr.op == OpType.ModOp do
            op = QOp.Mod
        end
        if expr.op == OpType.AndOp do
            op = QOp.And
        end
        if expr.op == OpType.OrOp do
            op = QOp.Or
        end
        if expr.op == OpType.XorOp do
            op = QOp.Xor
        end
        if expr.op == OpType.ShlOp do
            op = QOp.Shl
        end
        if expr.op == OpType.ShrOp do
            op = QOp.Shr
        end
        ctx4 = emit_instr(ctx4, q_instr(op, q_vreg(rd), q_vreg(lhs as i64), q_vreg(rhs as i64)));
        out (ctx4, rd as i64)
    end

    if expr.node_type == AstType.Compare do
        var (ctx2, lhs) = lower_expr(ctx, vec_get(expr.children, 0));
        if lhs < 0 do
            out (ctx2, -1)
        end
        var (ctx3, rhs) = lower_expr(ctx2, vec_get(expr.children, 1));
        if rhs < 0 do
            out (ctx3, -1)
        end
        var (ctx4, rd) = fresh_vreg(ctx3);

        if expr.op == OpType.Ne do
            # NE = XOR(EQ(lhs, rhs), 1)
            var (ctx5, eq_r) = fresh_vreg(ctx4);
            var (ctx6, one_r) = fresh_vreg(ctx5);
            ctx6 = emit_instr(ctx6, q_instr(QOp.CmpEq, q_vreg(eq_r), q_vreg(lhs as i64), q_vreg(rhs as i64)));
            ctx6 = emit_instr(ctx6, q_instr(QOp.Load, q_vreg(one_r), q_imm(1), q_none()));
            ctx6 = emit_instr(ctx6, q_instr(QOp.Xor, q_vreg(rd), q_vreg(eq_r), q_vreg(one_r)));
            out (ctx6, rd as i64)
        end

        cmp_op = QOp.CmpEq;
        if expr.op == OpType.Gt do
            cmp_op = QOp.CmpGt
        end
        if expr.op == OpType.Lt do
            cmp_op = QOp.CmpLt
        end
        if expr.op == OpType.Ge do
            cmp_op = QOp.CmpGe
        end
        if expr.op == OpType.Le do
            cmp_op = QOp.CmpLe
        end
        ctx4 = emit_instr(ctx4, q_instr(cmp_op, q_vreg(rd), q_vreg(lhs as i64), q_vreg(rhs as i64)));
        out (ctx4, rd as i64)
    end

    if expr.node_type == AstType.BuiltinCall do
        # Evaluate arguments
        arg_vregs = vec_new<int>()
        i = 0;
        when i < vec_len(expr.children) loop
            var (ctx2, av) = lower_expr(ctx, vec_get(expr.children, i));
            ctx = ctx2;
            if av >= 0 do
                ctx = emit_instr(ctx, q_instr(QOp.Move, q_vreg(i as i64), q_vreg(av as i64), q_none()))
            end
            i = i + 1
        end
        var (ctx3, rd) = fresh_vreg(ctx);
        if expr.builtin_id == BuiltinId.Syscall do
            ctx3 = emit_instr(ctx3, q_instr(QOp.Intrinsic, q_vreg(rd), q_imm(0), q_imm(i as i64)))
        end
        if expr.builtin_id == BuiltinId.MemCopy do
            ctx3 = emit_instr(ctx3, q_instr(QOp.Intrinsic, q_vreg(rd), q_imm(9), q_imm(i as i64)))
        end
        if expr.builtin_id == BuiltinId.MemSet do
            ctx3 = emit_instr(ctx3, q_instr(QOp.Intrinsic, q_vreg(rd), q_imm(10), q_imm(i as i64)))
        end
        if expr.builtin_id == BuiltinId.Trap do
            ctx3 = emit_instr(ctx3, q_instr(QOp.Intrinsic, q_vreg(rd), q_imm(11), q_imm(i as i64)))
        end
        if expr.builtin_id == BuiltinId.Unreachable do
            ctx3 = emit_instr(ctx3, q_instr(QOp.Intrinsic, q_vreg(rd), q_imm(11), q_imm(i as i64)))
        end
        # Map Phase 3 math & atomics
        if expr.builtin_id == BuiltinId.CLZ do
            ctx3 = emit_instr(ctx3, q_instr(QOp.Intrinsic, q_vreg(rd), q_imm(12), q_imm(1)))
        end
        if expr.builtin_id == BuiltinId.CTZ do
            ctx3 = emit_instr(ctx3, q_instr(QOp.Intrinsic, q_vreg(rd), q_imm(13), q_imm(1)))
        end
        if expr.builtin_id == BuiltinId.PopCnt do
            ctx3 = emit_instr(ctx3, q_instr(QOp.Intrinsic, q_vreg(rd), q_imm(14), q_imm(1)))
        end
        if expr.builtin_id == BuiltinId.BSwap do
            ctx3 = emit_instr(ctx3, q_instr(QOp.Intrinsic, q_vreg(rd), q_imm(15), q_imm(1)))
        end
        if expr.builtin_id == BuiltinId.AtomicLoad do
            ctx3 = emit_instr(ctx3, q_instr(QOp.Intrinsic, q_vreg(rd), q_imm(16), q_imm(1)))
        end
        if expr.builtin_id == BuiltinId.AtomicStore do
            ctx3 = emit_instr(ctx3, q_instr(QOp.Intrinsic, q_vreg(rd), q_imm(17), q_imm(2)))
        end
        if expr.builtin_id == BuiltinId.AtomicAdd do
            ctx3 = emit_instr(ctx3, q_instr(QOp.Intrinsic, q_vreg(rd), q_imm(18), q_imm(2)))
        end
        if expr.builtin_id == BuiltinId.AtomicSub do
            ctx3 = emit_instr(ctx3, q_instr(QOp.Intrinsic, q_vreg(rd), q_imm(19), q_imm(2)))
        end
        out (ctx3, rd as i64)
    end

    if expr.node_type == AstType.Call do
        fidx = find_func_index(ctx, expr.name);
        if fidx < 0 do
            ctx = lower_error(ctx, str_concat(str_new("undefined function: "), expr.name));
            var (ctx2, rd) = fresh_vreg(ctx);
            ctx2 = emit_instr(ctx2, q_instr(QOp.Load, q_vreg(rd), q_imm(0), q_none()));
            out (ctx2, rd as i64)
        end

        # Evaluate arguments
        arg_vregs = vec_new<int>()
        i = 0;
        when i < vec_len(expr.children) loop
            var (ctx2, av) = lower_expr(ctx, vec_get(expr.children, i));
            ctx = ctx2;
            if av < 0 do
                out (ctx, -1)
            end
            vec_push(arg_vregs, av);
            i = i + 1
        end

        # §6.4 named-arg reorder — when call.int_val == 1, child.name is the
        # target param name; shuffle arg_vregs so each slot matches param_names.
        if expr.int_val == 1 do
            tgt = vec_get(ctx.prog.functions, fidx);
            reordered = vec_new<int>()
            pi = 0;
            when pi < vec_len(tgt.param_names) loop
                pname = vec_get(tgt.param_names, pi);
                found = -1;
                ai = 0;
                when ai < vec_len(expr.children) and found < 0 loop
                    child = vec_get(expr.children, ai);
                    if str_eq(child.name, pname) do
                        found = ai
                    end
                    ai = ai + 1
                end
                if found < 0 do
                    # Unmatched slot — emit 0 placeholder
                    var (ctx_z, zr) = fresh_vreg(ctx);
                    ctx = ctx_z;
                    ctx = emit_instr(ctx, q_instr(QOp.Load, q_vreg(zr), q_imm(0), q_none()));
                    vec_push(reordered, zr)
                else
                    vec_push(reordered, vec_get(arg_vregs, found))
                end
                pi = pi + 1
            end
            arg_vregs = reordered
        end

        # Move to R0..Rn
        i = 0;
        when i < vec_len(arg_vregs) loop
            av = vec_get(arg_vregs, i);
            ctx = emit_instr(ctx, q_instr(QOp.Move, q_vreg(i as i64), q_vreg(av as i64), q_none()));
            i = i + 1
        end

        # Emit call
        ctx = emit_instr(ctx, q_instr(QOp.CallFunc, q_none(), q_func_idx(fidx as i64), q_none()));

        # Result in R0
        var (ctx3, rd) = fresh_vreg(ctx);
        ctx3 = emit_instr(ctx3, q_instr(QOp.Move, q_vreg(rd), q_vreg(0), q_none()));
        out (ctx3, rd as i64)
    end

    if expr.node_type == AstType.InputExpr do
        var (ctx2, rd) = fresh_vreg(ctx);
        ctx2 = emit_instr(ctx2, q_instr(QOp.Input, q_vreg(rd), q_none(), q_none()));
        out (ctx2, rd as i64)
    end

    # §22 await EXPR — join on a task id, produce its result
    if expr.node_type == AstType.AwaitExpr do
        if vec_len(expr.children) > 0 do
            var (ctx_a, tr) = lower_expr(ctx, vec_get(expr.children, 0));
            if tr < 0 do
                var (ctx_z, rd0) = fresh_vreg(ctx_a);
                ctx_z = emit_instr(ctx_z, q_instr(QOp.Load, q_vreg(rd0), q_imm(0), q_none()));
                out (ctx_z, rd0 as i64)
            end
            var (ctx_b, rd) = fresh_vreg(ctx_a);
            ctx_b = emit_instr(ctx_b, q_instr(QOp.TaskWait, q_vreg(rd), q_vreg(tr as i64), q_none()));
            out (ctx_b, rd as i64)
        end
        var (ctx2, rd2) = fresh_vreg(ctx);
        ctx2 = emit_instr(ctx2, q_instr(QOp.Load, q_vreg(rd2), q_imm(0), q_none()));
        out (ctx2, rd2 as i64)
    end

    if expr.node_type == AstType.ArrayLiteral do
        var (ctx2, cap_r) = fresh_vreg(ctx);
        var (ctx3, arr_r) = fresh_vreg(ctx2);
        n = vec_len(expr.children) as i64;
        cap = n;
        if cap < 16 do
            cap = 16
        end
        ctx3 = emit_instr(ctx3, q_instr(QOp.Load, q_vreg(cap_r), q_imm(cap), q_none()));
        ctx3 = emit_instr(ctx3, q_instr(QOp.ArrNew, q_vreg(arr_r), q_vreg(cap_r), q_none()));
        i = 0;
        when i < vec_len(expr.children) loop
            var (ctx4, elem) = lower_expr(ctx3, vec_get(expr.children, i));
            ctx3 = ctx4;
            if elem >= 0 do
                ctx3 = emit_instr(ctx3, q_instr(QOp.ArrPush, q_none(), q_vreg(arr_r), q_vreg(elem as i64)))
            end
            i = i + 1
        end
        out (ctx3, arr_r as i64)
    end

    if expr.node_type == AstType.IndexAccess do
        var (scope, arr_idx) = sym_lookup_both(ctx, expr.name);
        if scope < 0 do
            ctx = lower_error(ctx, str_new("undefined variable for index"));
            out (ctx, -1)
        end
        arr_vreg = arr_idx;
        if scope == 1 do
            var (ctx2, gv) = fresh_vreg(ctx);
            ctx = ctx2;
            ctx = emit_instr(ctx, q_instr(QOp.LoadGlobal, q_vreg(gv), q_imm(arr_idx as i64), q_none()));
            arr_vreg = gv
        end
        var (ctx3, idx_v) = lower_expr(ctx, vec_get(expr.children, 0));
        if idx_v < 0 do
            out (ctx3, -1)
        end
        var (ctx4, rd) = fresh_vreg(ctx3);
        ctx4 = emit_instr(ctx4, q_instr(QOp.ArrGet, q_vreg(rd), q_vreg(arr_vreg), q_vreg(idx_v as i64)));
        out (ctx4, rd as i64)
    end

    if expr.node_type == AstType.FieldAccess do
        # Check for enum access first
        base = vec_get(expr.children, 0);
        if base.node_type == AstType.Identifier do
            var (found, eidx) = type_lookup_enum(ctx, base.name);
            if found do
                et = vec_get(ctx.enum_types, eidx);
                var (ok, val) = enum_lookup_variant(et, expr.name);
                if ok do
                    var (ctx2, r) = fresh_vreg(ctx);
                    ctx2 = emit_instr(ctx2, q_instr(QOp.Load, q_vreg(r), q_imm(val), q_none()));
                    out (ctx2, r as i64)
                end
                ctx = lower_error(ctx, str_concat(str_new("unknown variant: "), expr.name));
                out (ctx, -1)
            end
        end

        # Entity field access
        var (ctx2, base_r) = lower_expr(ctx, vec_get(expr.children, 0));
        if base_r < 0 do
            out (ctx2, -1)
        end

        # Search entity types for field offset
        offset = -1;
        j = 0;
        when j < vec_len(ctx2.entity_types) and offset < 0 loop
            et = vec_get(ctx2.entity_types, j);
            var (ok, off) = entity_field_offset(et, expr.name);
            if ok do
                offset = off
            end
            j = j + 1
        end

        if offset < 0 do
            ctx2 = lower_error(ctx2, str_concat(str_new("unknown field: "), expr.name));
            out (ctx2, -1)
        end

        var (ctx3, off_r) = fresh_vreg(ctx2);
        var (ctx4, rd) = fresh_vreg(ctx3);
        ctx4 = emit_instr(ctx4, q_instr(QOp.Load, q_vreg(off_r), q_imm(offset as i64), q_none()));
        ctx4 = emit_instr(ctx4, q_instr(QOp.LoadWord, q_vreg(rd), q_vreg(base_r as i64), q_vreg(off_r)));
        out (ctx4, rd as i64)
    end

    if expr.node_type == AstType.EntityLiteral do
        var (found, eidx) = find_entity_type(ctx, expr.name);
        if not found do
            ctx = lower_error(ctx, str_concat(str_new("undefined entity: "), expr.name));
            out (ctx, -1)
        end
        et = vec_get(ctx.entity_types, eidx);
        var (ctx2, sz_r) = fresh_vreg(ctx);
        var (ctx3, ptr_r) = fresh_vreg(ctx2);
        sz = (vec_len(et.fields) as i64) * 8;
        ctx3 = emit_instr(ctx3, q_instr(QOp.Load, q_vreg(sz_r), q_imm(sz), q_none()));
        ctx3 = emit_instr(ctx3, q_instr(QOp.Alloc, q_vreg(ptr_r), q_vreg(sz_r), q_none()));

        i = 0;
        when i < vec_len(expr.children) loop
            child = vec_get(expr.children, i);
            var (ok, foff) = entity_field_offset(et, child.name2);
            if ok do
                var (ctx4, val_r) = lower_expr(ctx3, child);
                ctx3 = ctx4;
                if val_r >= 0 do
                    var (ctx5, off_r) = fresh_vreg(ctx3);
                    ctx3 = ctx5;
                    ctx3 = emit_instr(ctx3, q_instr(QOp.Load, q_vreg(off_r), q_imm(foff as i64), q_none()));
                    ctx3 = emit_instr(ctx3, q_instr(QOp.StoreWord, q_vreg(val_r as i64), q_vreg(ptr_r), q_vreg(off_r)))
                end
            end
            i = i + 1
        end
        out (ctx3, ptr_r as i64)
    end

    ctx = lower_error(ctx, str_new("unsupported expression type"));
    out (ctx, -1)
end.


# ═══════════════════════════════════════════════════════
# Statement Lowering
# ═══════════════════════════════════════════════════════

func lower_stmt:
    in(ctx:LowerCtx; stmt:AstNode)

    if stmt.node_type == AstType.VarDecl or stmt.node_type == AstType.ConstDecl do
        var (ctx2, r) = fresh_vreg(ctx);
        ctx2.symbols = sym_define(ctx2.symbols, stmt.name, r);
        if vec_len(stmt.children) > 0 do
            init = vec_get(stmt.children, 0);
            var (ctx3, val) = lower_expr(ctx2, init);
            if val >= 0 and (val as u32) != r do
                ctx3 = emit_instr(ctx3, q_instr(QOp.Move, q_vreg(r), q_vreg(val as i64), q_none()))
            end
            # §4.1 sized-type narrowing — emit AND mask for u8/u16/u32/i8/i16/i32
            mask = 0;
            if str_eq(stmt.name2, str_new("u8")) or str_eq(stmt.name2, str_new("i8")) do
                mask = 255
            end
            if str_eq(stmt.name2, str_new("u16")) or str_eq(stmt.name2, str_new("i16")) do
                mask = 65535
            end
            if str_eq(stmt.name2, str_new("u32")) or str_eq(stmt.name2, str_new("i32")) do
                mask = 4294967295
            end
            if mask != 0 do
                var (ctx4, mr) = fresh_vreg(ctx3);
                ctx4 = emit_instr(ctx4, q_instr(QOp.Load, q_vreg(mr), q_imm(mask), q_none()));
                ctx4 = emit_instr(ctx4, q_instr(QOp.And, q_vreg(r), q_vreg(r), q_vreg(mr)));
                # §4.8: mark move type + claim borrow
                if ast_produces_move_type(init) do
                    var (ef, ei) = sym_lookup_entry(ctx4.symbols, stmt.name);
                    if ef do
                        e2 = vec_get(ctx4.symbols.entries, ei);
                        e2.is_move_type = 1;
                        vec_set(ctx4.symbols.entries, ei, e2)
                    end
                end
                ctx4 = ownership_mark_moved_if_id(ctx4, init);
                if init.node_type == AstType.AddrOf and vec_len(init.children) > 0 do
                    bk = 1;
                    if init.int_val != 0 do
                        bk = 2
                    end
                    ctx4 = ownership_claim_stmt_borrow(ctx4, stmt.name, vec_get(init.children, 0).name, bk)
                end
                ctx4 = ownership_release_unclaimed(ctx4);
                out ctx4
            end
            # §4.8: mark move type + claim borrow (no mask path)
            if ast_produces_move_type(init) do
                var (ef, ei) = sym_lookup_entry(ctx3.symbols, stmt.name);
                if ef do
                    e2 = vec_get(ctx3.symbols.entries, ei);
                    e2.is_move_type = 1;
                    vec_set(ctx3.symbols.entries, ei, e2)
                end
            end
            ctx3 = ownership_mark_moved_if_id(ctx3, init);
            if init.node_type == AstType.AddrOf and vec_len(init.children) > 0 do
                bk = 1;
                if init.int_val != 0 do
                    bk = 2
                end
                ctx3 = ownership_claim_stmt_borrow(ctx3, stmt.name, vec_get(init.children, 0).name, bk)
            end
            ctx3 = ownership_release_unclaimed(ctx3);
            out ctx3
        else
            ctx2 = emit_instr(ctx2, q_instr(QOp.Load, q_vreg(r), q_imm(0), q_none()));
            out ctx2
        end
    end

    if stmt.node_type == AstType.Assign do
        var (scope, idx) = sym_lookup_both(ctx, stmt.name);
        if scope < 0 do
            out lower_error(ctx, str_concat(str_new("assign to undefined: "), stmt.name))
        end
        rhs = vec_get(stmt.children, 0);
        var (ctx2, val) = lower_expr(ctx, rhs);
        if val < 0 do
            out ctx2
        end
        if scope == 1 do
            ctx2 = emit_instr(ctx2, q_instr(QOp.StoreGlobal, q_none(), q_imm(idx as i64), q_vreg(val as i64)))
        else
            if (val as u32) != idx do
                ctx2 = emit_instr(ctx2, q_instr(QOp.Move, q_vreg(idx), q_vreg(val as i64), q_none()))
            end
        end
        # §4.8: release old borrow on LHS, track move, claim new borrow
        ctx2 = ownership_release_borrow(ctx2, stmt.name);
        if rhs.node_type != AstType.AddrOf do
            ctx2 = ownership_mark_moved_if_id(ctx2, rhs);
            if ast_produces_move_type(rhs) do
                var (ef, ei) = sym_lookup_entry(ctx2.symbols, stmt.name);
                if ef do
                    e2 = vec_get(ctx2.symbols.entries, ei);
                    e2.is_move_type = 1;
                    vec_set(ctx2.symbols.entries, ei, e2)
                end
            end
        else
            if vec_len(rhs.children) > 0 do
                bk = 1;
                if rhs.int_val != 0 do
                    bk = 2
                end
                ctx2 = ownership_claim_stmt_borrow(ctx2, stmt.name, vec_get(rhs.children, 0).name, bk)
            end
        end
        # Resurrect LHS (no longer moved)
        var (ef2, ei2) = sym_lookup_entry(ctx2.symbols, stmt.name);
        if ef2 do
            e3 = vec_get(ctx2.symbols.entries, ei2);
            e3.is_moved = 0;
            vec_set(ctx2.symbols.entries, ei2, e3)
        end
        ctx2 = ownership_release_unclaimed(ctx2);
        out ctx2
    end

    if stmt.node_type == AstType.IndexAssign do
        var (scope, arr_idx) = sym_lookup_both(ctx, stmt.name);
        if scope < 0 do
            out lower_error(ctx, str_new("index assign to undefined variable"))
        end
        arr_vreg = arr_idx;
        if scope == 1 do
            var (ctx2, gv) = fresh_vreg(ctx);
            ctx = ctx2;
            ctx = emit_instr(ctx, q_instr(QOp.LoadGlobal, q_vreg(gv), q_imm(arr_idx as i64), q_none()));
            arr_vreg = gv
        end
        var (ctx3, idx_v) = lower_expr(ctx, vec_get(stmt.children, 0));
        var (ctx4, val_v) = lower_expr(ctx3, vec_get(stmt.children, 1));
        if idx_v >= 0 and val_v >= 0 do
            ctx4 = emit_instr(ctx4, q_instr(QOp.ArrSet, q_vreg(val_v as i64), q_vreg(arr_vreg), q_vreg(idx_v as i64)))
        end
        out ctx4
    end

    if stmt.node_type == AstType.PrintStmt do
        var (ctx2, val) = lower_expr(ctx, vec_get(stmt.children, 0));
        if val >= 0 do
            ctx2 = emit_instr(ctx2, q_instr(QOp.Print, q_none(), q_vreg(val as i64), q_none()))
        end
        out ctx2
    end

    if stmt.node_type == AstType.ReturnStmt do
        if vec_len(stmt.children) > 0 do
            var (ctx2, val) = lower_expr(ctx, vec_get(stmt.children, 0));
            if val >= 0 do
                ctx2 = emit_instr(ctx2, q_instr(QOp.Ret, q_none(), q_vreg(val as i64), q_none()))
            end
            out ctx2
        else
            ctx = emit_instr(ctx, q_instr(QOp.Ret, q_none(), q_none(), q_none()));
            out ctx
        end
    end

    if stmt.node_type == AstType.IfStmt do
        var (ctx2, cond_r) = lower_expr(ctx, vec_get(stmt.children, 0));
        if cond_r < 0 do
            out ctx2
        end
        var (ctx3, else_lbl) = fresh_label(ctx2);
        var (ctx4, end_lbl) = fresh_label(ctx3);

        ctx4 = emit_instr(ctx4, q_instr(QOp.JumpIfNot, q_none(), q_vreg(cond_r as i64), q_label(else_lbl)));

        # Then block
        ctx4 = lower_stmt(ctx4, vec_get(stmt.children, 1));

        if vec_len(stmt.children) > 2 do
            ctx4 = emit_instr(ctx4, q_instr(QOp.Jump, q_none(), q_label(end_lbl), q_none()))
        end

        # Else label
        lbl = q_instr(QOp.Label, q_none(), q_none(), q_none());
        lbl.patch_id = else_lbl;
        ctx4 = emit_instr(ctx4, lbl);

        # Else block
        if vec_len(stmt.children) > 2 do
            ctx4 = lower_stmt(ctx4, vec_get(stmt.children, 2));
            lbl.patch_id = end_lbl;
            ctx4 = emit_instr(ctx4, lbl)
        end
        out ctx4
    end

    if stmt.node_type == AstType.WhileStmt do
        var (ctx2, loop_lbl) = fresh_label(ctx);
        var (ctx3, end_lbl) = fresh_label(ctx2);

        lbl = q_instr(QOp.Label, q_none(), q_none(), q_none());
        lbl.patch_id = loop_lbl;
        ctx3 = emit_instr(ctx3, lbl);

        var (ctx4, cond_r) = lower_expr(ctx3, vec_get(stmt.children, 0));
        if cond_r < 0 do
            out ctx4
        end
        ctx4 = emit_instr(ctx4, q_instr(QOp.JumpIfNot, q_none(), q_vreg(cond_r as i64), q_label(end_lbl)));

        # Push loop labels
        vec_push(ctx4.loop_start_labels, loop_lbl);
        vec_push(ctx4.loop_end_labels, end_lbl);
        ctx4.loop_depth = ctx4.loop_depth + 1;

        ctx4 = lower_stmt(ctx4, vec_get(stmt.children, 1));

        ctx4.loop_depth = ctx4.loop_depth - 1;

        ctx4 = emit_instr(ctx4, q_instr(QOp.Jump, q_none(), q_label(loop_lbl), q_none()));

        lbl.patch_id = end_lbl;
        ctx4 = emit_instr(ctx4, lbl);
        out ctx4
    end

    if stmt.node_type == AstType.LoopStmt do
        # Counter-based loop
        var (ctx2, counter) = fresh_vreg(ctx);
        ctx2 = emit_instr(ctx2, q_instr(QOp.Load, q_vreg(counter), q_imm(0), q_none()));

        var (ctx3, limit_r) = lower_expr(ctx2, vec_get(stmt.children, 0));
        if limit_r < 0 do
            out ctx3
        end

        var (ctx4, loop_lbl) = fresh_label(ctx3);
        var (ctx5, cont_lbl) = fresh_label(ctx4);
        var (ctx6, end_lbl) = fresh_label(ctx5);

        lbl = q_instr(QOp.Label, q_none(), q_none(), q_none());
        lbl.patch_id = loop_lbl;
        ctx6 = emit_instr(ctx6, lbl);

        var (ctx7, cmp_r) = fresh_vreg(ctx6);
        ctx7 = emit_instr(ctx7, q_instr(QOp.CmpLt, q_vreg(cmp_r), q_vreg(counter), q_vreg(limit_r as i64)));
        ctx7 = emit_instr(ctx7, q_instr(QOp.JumpIfNot, q_none(), q_vreg(cmp_r), q_label(end_lbl)));

        vec_push(ctx7.loop_start_labels, cont_lbl);
        vec_push(ctx7.loop_end_labels, end_lbl);
        ctx7.loop_depth = ctx7.loop_depth + 1;

        ctx7 = lower_stmt(ctx7, vec_get(stmt.children, 1));

        ctx7.loop_depth = ctx7.loop_depth - 1;

        lbl.patch_id = cont_lbl;
        ctx7 = emit_instr(ctx7, lbl);
        var (ctx8, one_r) = fresh_vreg(ctx7);
        ctx8 = emit_instr(ctx8, q_instr(QOp.Load, q_vreg(one_r), q_imm(1), q_none()));
        ctx8 = emit_instr(ctx8, q_instr(QOp.Add, q_vreg(counter), q_vreg(counter), q_vreg(one_r)));
        ctx8 = emit_instr(ctx8, q_instr(QOp.Jump, q_none(), q_label(loop_lbl), q_none()));

        lbl.patch_id = end_lbl;
        ctx8 = emit_instr(ctx8, lbl);
        out ctx8
    end

    if stmt.node_type == AstType.ForRange do
        var (ctx2, start_v) = lower_expr(ctx, vec_get(stmt.children, 0));
        if start_v < 0 do
            out ctx2
        end
        var (ctx3, end_v) = lower_expr(ctx2, vec_get(stmt.children, 1));
        if end_v < 0 do
            out ctx3
        end

        var (ctx4, loop_var) = fresh_vreg(ctx3);
        ctx4.symbols = sym_define(ctx4.symbols, stmt.name, loop_var);
        ctx4 = emit_instr(ctx4, q_instr(QOp.Move, q_vreg(loop_var), q_vreg(start_v as i64), q_none()));

        var (ctx5, loop_lbl) = fresh_label(ctx4);
        var (ctx6, end_lbl) = fresh_label(ctx5);
        var (ctx7, cont_lbl) = fresh_label(ctx6);

        lbl = q_instr(QOp.Label, q_none(), q_none(), q_none());
        lbl.patch_id = loop_lbl;
        ctx7 = emit_instr(ctx7, lbl);

        var (ctx8, cmp_r) = fresh_vreg(ctx7);
        ctx8 = emit_instr(ctx8, q_instr(QOp.CmpLt, q_vreg(cmp_r), q_vreg(loop_var), q_vreg(end_v as i64)));
        ctx8 = emit_instr(ctx8, q_instr(QOp.JumpIfNot, q_none(), q_vreg(cmp_r), q_label(end_lbl)));

        vec_push(ctx8.loop_start_labels, cont_lbl);
        vec_push(ctx8.loop_end_labels, end_lbl);
        ctx8.loop_depth = ctx8.loop_depth + 1;

        ctx8 = lower_stmt(ctx8, vec_get(stmt.children, 2));

        ctx8.loop_depth = ctx8.loop_depth - 1;

        lbl.patch_id = cont_lbl;
        ctx8 = emit_instr(ctx8, lbl);
        var (ctx9, one_r) = fresh_vreg(ctx8);
        ctx9 = emit_instr(ctx9, q_instr(QOp.Load, q_vreg(one_r), q_imm(1), q_none()));
        ctx9 = emit_instr(ctx9, q_instr(QOp.Add, q_vreg(loop_var), q_vreg(loop_var), q_vreg(one_r)));
        ctx9 = emit_instr(ctx9, q_instr(QOp.Jump, q_none(), q_label(loop_lbl), q_none()));

        lbl.patch_id = end_lbl;
        ctx9 = emit_instr(ctx9, lbl);
        out ctx9
    end

    if stmt.node_type == AstType.Block do
        i = 0;
        when i < vec_len(stmt.children) loop
            ctx = lower_stmt(ctx, vec_get(stmt.children, i));
            i = i + 1
        end
        out ctx
    end

    if stmt.node_type == AstType.BreakStmt do
        if ctx.loop_depth == 0 do
            out lower_error(ctx, str_new("break outside of loop"))
        end
        end_lbl = vec_get(ctx.loop_end_labels, (ctx.loop_depth - 1) as i64);
        ctx = emit_instr(ctx, q_instr(QOp.Jump, q_none(), q_label(end_lbl), q_none()));
        out ctx
    end

    if stmt.node_type == AstType.ContinueStmt do
        if ctx.loop_depth == 0 do
            out lower_error(ctx, str_new("continue outside of loop"))
        end
        start_lbl = vec_get(ctx.loop_start_labels, (ctx.loop_depth - 1) as i64);
        ctx = emit_instr(ctx, q_instr(QOp.Jump, q_none(), q_label(start_lbl), q_none()));
        out ctx
    end

    if stmt.node_type == AstType.EnumDef do
        et = EnumType ( name: stmt.name, variants: vec_new<EnumVariant>() );
        i = 0;
        when i < vec_len(stmt.children) loop
            v = vec_get(stmt.children, i);
            vec_push(et.variants, EnumVariant ( name: v.name, value: v.int_val ));
            i = i + 1
        end
        vec_push(ctx.enum_types, et);
        let idx = (vec_len(ctx.enum_types) - 1) as i64;
        map_insert<string, i64>(&ctx.enum_map, stmt.name, idx);
        out ctx
    end

    if stmt.node_type == AstType.EntityDef do
        et = EntityType ( name: stmt.name, fields: vec_new<EntityField>() );
        i = 0;
        when i < vec_len(stmt.children) loop
            f = vec_get(stmt.children, i);
            vec_push(et.fields, EntityField ( name: f.name, offset: i as i64 ));
            i = i + 1
        end
        vec_push(ctx.entity_types, et);
        out ctx
    end

    if stmt.node_type == AstType.FieldAssign do
        var (scope, idx) = sym_lookup_both(ctx, stmt.name);
        if scope < 0 do
            out lower_error(ctx, str_concat(str_new("field assign to undefined: "), stmt.name))
        end
        base_vreg = idx;
        if scope == 1 do
            var (ctx2, gv) = fresh_vreg(ctx);
            ctx = ctx2;
            ctx = emit_instr(ctx, q_instr(QOp.LoadGlobal, q_vreg(gv), q_imm(idx as i64), q_none()));
            base_vreg = gv
        end

        # Find field offset across all entity types
        offset = -1;
        j = 0;
        when j < vec_len(ctx.entity_types) and offset < 0 loop
            et = vec_get(ctx.entity_types, j);
            var (ok, off) = entity_field_offset(et, stmt.name2);
            if ok do
                offset = off
            end
            j = j + 1
        end
        if offset < 0 do
            out lower_error(ctx, str_concat(str_new("unknown field: "), stmt.name2))
        end

        var (ctx3, val_r) = lower_expr(ctx, vec_get(stmt.children, 0));
        if val_r < 0 do
            out ctx3
        end
        var (ctx4, off_r) = fresh_vreg(ctx3);
        ctx4 = emit_instr(ctx4, q_instr(QOp.Load, q_vreg(off_r), q_imm(offset as i64), q_none()));
        ctx4 = emit_instr(ctx4, q_instr(QOp.StoreWord, q_vreg(val_r as i64), q_vreg(base_vreg), q_vreg(off_r)));
        out ctx4
    end

    if stmt.node_type == AstType.CheckCpu or stmt.node_type == AstType.PatchPoint do
        ctx.patch_counter = ctx.patch_counter + 1;
        pp = q_instr(QOp.PatchPoint, q_none(), q_none(), q_none());
        pp.patch_id = ctx.patch_counter;
        ctx = emit_instr(ctx, pp);
        out ctx
    end

    # §4.5 arena NAME: body end — scoped arena allocator
    if stmt.node_type == AstType.ArenaBlock do
        var (ctx_a, size_r) = fresh_vreg(ctx);
        ctx_a = emit_instr(ctx_a, q_instr(QOp.Load, q_vreg(size_r), q_imm(4096), q_none()));
        var (ctx_b, aid_r) = fresh_vreg(ctx_a);
        ctx_b = emit_instr(ctx_b, q_instr(QOp.ArenaNew, q_vreg(aid_r), q_vreg(size_r), q_none()));
        ctx_b.symbols = sym_define(ctx_b.symbols, stmt.name, aid_r);
        if vec_len(stmt.children) > 0 do
            ctx_b = lower_stmt(ctx_b, vec_get(stmt.children, 0))
        end
        ctx_b = emit_instr(ctx_b, q_instr(QOp.ArenaFree, q_none(), q_vreg(aid_r), q_none()));
        out ctx_b
    end

    # §13 throw EXPR — trigger error panic
    if stmt.node_type == AstType.ThrowStmt do
        if vec_len(stmt.children) > 0 do
            var (ctx2, code_v) = lower_expr(ctx, vec_get(stmt.children, 0));
            if code_v >= 0 do
                ctx2 = emit_instr(ctx2, q_instr(QOp.ThrowOp, q_none(), q_vreg(code_v as i64), q_none()))
            end
            out ctx2
        end
        out ctx
    end

    # §22 cancel EXPR — mark task cancelled
    if stmt.node_type == AstType.CancelStmt do
        if vec_len(stmt.children) > 0 do
            var (ctx2, tr) = lower_expr(ctx, vec_get(stmt.children, 0));
            if tr < 0 do
                out ctx2
            end
            var (ctx3, rd) = fresh_vreg(ctx2);
            ctx3 = emit_instr(ctx3, q_instr(QOp.TaskCancel, q_vreg(rd), q_vreg(tr as i64), q_none()));
            out ctx3
        end
        out ctx
    end

    # §22 quiet EXPR — evaluate and discard
    if stmt.node_type == AstType.QuietStmt do
        if vec_len(stmt.children) > 0 do
            var (ctx2, _) = lower_expr(ctx, vec_get(stmt.children, 0));
            out ctx2
        end
        out ctx
    end

    # Module system (compile-time only)
    if (stmt.node_type == AstType.ImportStmt or
        stmt.node_type == AstType.ModuleStmt or
        stmt.node_type == AstType.ExportStmt or
        stmt.node_type == AstType.IncludeStmt) do
        out ctx
    end

    # Default: try as expression statement
    var (ctx2, _) = lower_expr(ctx, stmt);
    out ctx2
end.


# ═══════════════════════════════════════════════════════
# Function Lowering
# ═══════════════════════════════════════════════════════

func lower_func_def:
    in(ctx:LowerCtx; func_def:AstNode)
    var (ctx2, fidx) = q_module_add_func(ctx.module, func_def.name);
    ctx.module = ctx2;
    ctx.current_func_idx = fidx;

    # Save local scope
    saved_syms = ctx.symbols;
    ctx.symbols = sym_new()

    # Find body, ensure, and revert blocks
    body_idx = -1;
    ensure_node_idx = -1;
    revert_node_idx = -1;
    idx = vec_len(func_def.children) - 1;
    when idx >= 0 and body_idx < 0 loop
        ct = vec_get(func_def.children, idx).node_type;
        if ct == AstType.EnsureBlock do
            ensure_node_idx = idx
        else
            if ct == AstType.RevertBlock do
                revert_node_idx = idx
            else
                body_idx = idx
            end
        end
        idx = idx - 1
    end

    # Register parameters
    i = 0;
    when i < body_idx loop
        param = vec_get(func_def.children, i);
        if param.node_type == AstType.Identifier do
            var (ctx3, pr) = fresh_vreg(ctx);
            ctx = ctx3;
            ctx.symbols = sym_define(ctx.symbols, param.name, pr);
            # §6.4 — record param name on QFunction for named-arg reorder
            cf = vec_get(ctx.prog.functions, fidx);
            vec_push(cf.param_names, param.name);
            cf.param_count = cf.param_count + 1;
            vec_set(ctx.prog.functions, fidx, cf)
        end
        i = i + 1
    end

    has_epilogue = ensure_node_idx >= 0 or revert_node_idx >= 0;
    revert_L = -1;
    ensure_L = -1;

    if has_epilogue do
        var (ctx4, rl) = fresh_label(ctx);
        var (ctx5, el) = fresh_label(ctx4);
        revert_L = rl;
        ensure_L = el;
        ctx = ctx5;
        ctx = emit_instr(ctx, q_instr(QOp.TryBegin, q_label(revert_L), q_none(), q_none()))
    end

    # Lower body
    if body_idx >= 0 do
        ctx = lower_stmt(ctx, vec_get(func_def.children, body_idx))
    end

    if has_epilogue do
        ctx = emit_instr(ctx, q_instr(QOp.TryEnd, q_none(), q_none(), q_none()));
        ctx = emit_instr(ctx, q_instr(QOp.Jump, q_none(), q_label(ensure_L), q_none()));

        rlbl = q_instr(QOp.Label, q_none(), q_none(), q_none());
        rlbl.patch_id = revert_L;
        ctx = emit_instr(ctx, rlbl);

        if revert_node_idx >= 0 do
            rev_node = vec_get(func_def.children, revert_node_idx);
            if vec_len(rev_node.children) > 0 do
                ctx = lower_stmt(ctx, vec_get(rev_node.children, 0))
            end
        end
        if ensure_node_idx >= 0 do
            ens_node = vec_get(func_def.children, ensure_node_idx);
            if vec_len(ens_node.children) > 0 do
                ctx = lower_stmt(ctx, vec_get(ens_node.children, 0))
            end
        end
        ctx = emit_instr(ctx, q_instr(QOp.ResumeRevert, q_none(), q_none(), q_none()));

        elbl = q_instr(QOp.Label, q_none(), q_none(), q_none());
        elbl.patch_id = ensure_L;
        ctx = emit_instr(ctx, elbl);

        if ensure_node_idx >= 0 do
            ens_node2 = vec_get(func_def.children, ensure_node_idx);
            if vec_len(ens_node2.children) > 0 do
                ctx = lower_stmt(ctx, vec_get(ens_node2.children, 0))
            end
        end
    end

    # Restore scope
    ctx.symbols = saved_syms;
    ctx.current_func_idx = -1;
    out ctx
end.


# ═══════════════════════════════════════════════════════
# Program Lowering
# ═══════════════════════════════════════════════════════

func vir_lower_program:
    in(ctx:LowerCtx; program:AstNode)
    # Pass 0: register enum/entity types
    i = 0;
    when i < vec_len(program.children) loop
        child = vec_get(program.children, i);
        if child.node_type == AstType.EnumDef or child.node_type == AstType.EntityDef do
            ctx = lower_stmt(ctx, child)
        end
        i = i + 1
    end

    # Pass 1: register function names for forward references
    has_main = false;
    has_top_stmt = false;
    i = 0;
    when i < vec_len(program.children) loop
        child = vec_get(program.children, i);
        if child.node_type == AstType.FuncDef do
            var (mod2, _) = q_module_add_func(ctx.module, child.name);
            ctx.module = mod2;
            if str_eq(child.name, str_new("main")) do
                has_main = true
            end
        else
            if not is_metadata(child.node_type) do
                has_top_stmt = true
            end
        end
        i = i + 1
    end

    # Pass 2: lower function bodies and top-level code
    if not has_main do
        var (mod3, main_idx) = q_module_add_func(ctx.module, str_new("__main__"));
        ctx.module = mod3;
        ctx.current_func_idx = main_idx;

        i = 0;
        when i < vec_len(program.children) loop
            child = vec_get(program.children, i);
            if child.node_type != AstType.FuncDef do
                ctx = lower_stmt(ctx, child)
            end
            i = i + 1
        end

        # Implicit return 0
        var (ctx2, rz) = fresh_vreg(ctx);
        ctx = ctx2;
        ctx = emit_instr(ctx, q_instr(QOp.Load, q_vreg(rz), q_imm(0), q_none()));
        ctx = emit_instr(ctx, q_instr(QOp.Ret, q_none(), q_vreg(rz), q_none()));
        ctx.current_func_idx = -1
    end

    # Lower all function definitions
    i = 0;
    when i < vec_len(program.children) loop
        child = vec_get(program.children, i);
        if child.node_type == AstType.FuncDef do
            ctx = lower_func_def(ctx, child)
        end
        i = i + 1
    end

    out ctx
end.


func is_metadata:
    in(t:AstType)
    out (t == AstType.EnumDef or t == AstType.EntityDef or
         t == AstType.ModuleStmt or t == AstType.ImportStmt or
         t == AstType.ExportStmt or t == AstType.IncludeStmt)
end.


# ═══════════════════════════════════════════════════════
# Liveness Analysis
# ═══════════════════════════════════════════════════════

entity LiveInterval:
    vreg: i64,
        start: i64,
        end_pos: i64,
        phys_reg: i64,
        spill_slot: i64
end.

func compute_liveness:
    in(f:QFunction)
    intervals = vec_new<LiveInterval>()

    i = 0;
    when i < vec_len(f.body) loop
        instr = vec_get(f.body, i);

        # Definition (dest)
        if instr.dest.op_type == OperandType.VReg do
            iv = find_or_create_interval(intervals, instr.dest.vreg);
            intervals = iv.0;
            idx = iv.1;
            interval = vec_get(intervals, idx);
            if (i as u32) < interval.start do
                interval.start = i as i64
            end
            if (i as u32) > interval.end_pos do
                interval.end_pos = i as i64
            end
            vec_set(intervals, idx, interval)
        end

        # Use (src1)
        if instr.src1.op_type == OperandType.VReg do
            iv = find_or_create_interval(intervals, instr.src1.vreg);
            intervals = iv.0;
            idx = iv.1;
            interval = vec_get(intervals, idx);
            if (i as u32) < interval.start do
                interval.start = i as i64
            end
            if (i as u32) > interval.end_pos do
                interval.end_pos = i as i64
            end
            vec_set(intervals, idx, interval)
        end

        # Use (src2)
        if instr.src2.op_type == OperandType.VReg do
            iv = find_or_create_interval(intervals, instr.src2.vreg);
            intervals = iv.0;
            idx = iv.1;
            interval = vec_get(intervals, idx);
            if (i as u32) < interval.start do
                interval.start = i as i64
            end
            if (i as u32) > interval.end_pos do
                interval.end_pos = i as i64
            end
            vec_set(intervals, idx, interval)
        end

        i = i + 1
    end
    out intervals
end.


func find_or_create_interval:
    in(intervals:Vec<LiveInterval>; vreg: i64)
    i = 0;
    when i < vec_len(intervals) loop
        iv = vec_get(intervals, i);
        if iv.vreg == vreg do
            out (intervals, i)
        end
        i = i + 1
    end
    vec_push(intervals, LiveInterval (
        vreg:       vreg,
        start:      0xFFFFFFFF as i64,
        end_pos:    0,
        phys_reg:   -1,
        spill_slot: -1
    ));
    out (intervals, vec_len(intervals) - 1)
end.


# ═══════════════════════════════════════════════════════
# Linear-Scan Register Allocation
# ═══════════════════════════════════════════════════════

func regalloc_linear_scan:
    in(intervals:Vec<LiveInterval>; num_phys_regs: i64)
    if num_phys_regs == 0 or vec_len(intervals) == 0 do
        out intervals
    end

    # Sort by start position (bubble sort — simple for correctness)
    n = vec_len(intervals);
    s = 0;
    when s < n - 1 loop
        t = 0;
        when t < n - s - 1 loop
            a = vec_get(intervals, t);
            b = vec_get(intervals, t + 1);
            if a.start > b.start do
                vec_set(intervals, t, b);
                vec_set(intervals, t + 1, a)
            end
            t = t + 1
        end
        s = s + 1
    end

    # Free register pool (bit-set, max 32 regs)
    max_regs = num_phys_regs;
    if max_regs > 32 do
        max_regs = 32
    end
    free_mask = (1 shl max_regs) - 1;

    # Active list (indices into intervals)
    active = vec_new<int>()
    next_spill = 0;

    i = 0;
    when i < n loop
        cur = vec_get(intervals, i);

        # Expire finished intervals
        new_active = vec_new<int>()
        a = 0;
        when a < vec_len(active) loop
            aidx = vec_get(active, a);
            act = vec_get(intervals, aidx);
            if act.end_pos < cur.start do
                # Release register
                if act.phys_reg >= 0 do
                    free_mask = free_mask or (1 shl (act.phys_reg as i64))
                end
            else
                vec_push(new_active, aidx)
            end
            a = a + 1
        end
        active = new_active;

        # Try to allocate a free register
        if free_mask != 0 do
            # Find lowest set bit
            bit = 0;
            tmp = free_mask;
            when (tmp and 1) == 0 loop
                bit = bit + 1;
                tmp = tmp shr 1
            end

            cur.phys_reg = bit as i64;
            free_mask = free_mask and (not (1 shl bit));
            vec_set(intervals, i, cur)

            # Insert into active (sorted by end)
            pos = vec_len(active);
            k = 0;
            when k < vec_len(active) loop
                aidx = vec_get(active, k);
                act = vec_get(intervals, aidx);
                if act.end_pos > cur.end_pos do
                    pos = k;
                    k = vec_len(active)  # break
                end
                k = k + 1
            end
            # Insert at pos
            vec_push(active, i)  # placeholder;
            j = vec_len(active) - 1;
            when j > pos loop
                vec_set(active, j, vec_get(active, j - 1));
                j = j - 1
            end
            vec_set(active, pos, i)
        else
            # Spill
            if vec_len(active) > 0 do
                last_idx = vec_get(active, vec_len(active) - 1);
                spill_cand = vec_get(intervals, last_idx);
                if spill_cand.end_pos > cur.end_pos do
                    cur.phys_reg = spill_cand.phys_reg;
                    spill_cand.phys_reg = -1;
                    spill_cand.spill_slot = next_spill;
                    next_spill = next_spill + 1;
                    vec_set(intervals, last_idx, spill_cand);
                    vec_set(intervals, i, cur);
                    # Remove last from active
                    new_active2 = vec_new<int>()
                    k = 0;
                    when k < vec_len(active) - 1 loop
                        vec_push(new_active2, vec_get(active, k));
                        k = k + 1
                    end
                    active = new_active2;
                    # Insert current
                    vec_push(active, i)
                else
                    cur.phys_reg = -1;
                    cur.spill_slot = next_spill;
                    next_spill = next_spill + 1;
                    vec_set(intervals, i, cur)
                end
            else
                cur.phys_reg = -1;
                cur.spill_slot = next_spill;
                next_spill = next_spill + 1;
                vec_set(intervals, i, cur)
            end
        end

        i = i + 1
    end

    out intervals
end.


# ═══════════════════════════════════════════════════════
# Tail-Call Optimization
# ═══════════════════════════════════════════════════════

func tco_pass:
    in(f:QFunction)
    tco_count = 0;
    body_len = vec_len(f.body);
    if body_len < 2 do
        out (f, 0)
    end

    i = 0;
    when i + 1 < body_len loop
        cur = vec_get(f.body, i);
        next_instr = vec_get(f.body, i + 1);

        # Pattern: CALL followed by RET
        if cur.opcode == QOp.Call and next_instr.opcode == QOp.Ret do
            cur.opcode = QOp.Jump;
            cur.dest = q_none()
            cur.src2 = q_none()
            vec_set(f.body, i, cur);

            next_instr.opcode = QOp.Nop;
            next_instr.dest = q_none()
            next_instr.src1 = q_none()
            next_instr.src2 = q_none()
            vec_set(f.body, i + 1, next_instr);

            tco_count = tco_count + 1;
            i = i + 2
        else
            i = i + 1
        end
    end
    out (f, tco_count)
end.


# ═══════════════════════════════════════════════════════
# Get Physical Register for a VReg
# ═══════════════════════════════════════════════════════

func get_phys_reg:
    in(intervals:Vec<LiveInterval>; vreg: i64)
    i = 0;
    when i < vec_len(intervals) loop
        iv = vec_get(intervals, i);
        if iv.vreg == vreg do
            out iv.phys_reg
        end
        i = i + 1
    end
    out -1
end.
