##
 * vir/compiler/mir_cfg.vri — Control Flow Graph & Dominator Tree
 * ================================================================
 * Builds predecessor edges from successors Vec, IDom, and
 * Dominance Frontiers (DF) for SSA construction.
 ##

include types
include vec_rt
import vec_new_rt, vec_push_rt, vec_get_rt, vec_set_rt, vec_len_rt from vec_rt
include mir
import MirBlock, mir_block_successors, mir_block_preds, mir_block_replace_preds, mir_block_reset_cfg, mir_block_idom, mir_block_replace_idom, mir_block_dom_children, mir_block_replace_dom_children, mir_block_df, mir_block_replace_df from mir

func mir_build_cfg(blocks: i64):
    n_blocks = vec_len_rt(blocks)

    # 1. Reuse CFG metadata vectors in place. Constructing fresh vectors as
    # nested call arguments leaves arena-scoped pointers inside the block.
    var i = 0
    when i < n_blocks loop
        b = vec_get_rt(blocks, i)
        mir_block_reset_cfg(b)
        i = i + 1
    end

    # 2. Add predecessors from successors Vec
    i = 0
    when i < n_blocks loop
        b = vec_get_rt(blocks, i)
        succs = mir_block_successors(b)
        if succs >= 0 do
            ns = vec_len_rt(succs)
            var s = 0
            when s < ns loop
                succ_idx = vec_get_rt(succs, s)
                if succ_idx >= 0 and succ_idx < n_blocks do
                    sb = vec_get_rt(blocks, succ_idx)
                    new_preds = vec_push_rt(mir_block_preds(sb), i)
                    mir_block_replace_preds(sb, new_preds)
                end
                s = s + 1
            end
        end
        i = i + 1
    end
    out blocks
end.

func intersect_idom_chains(idoms: i64, left: i64, right: i64, marks: i64, epoch: i64, n_blocks: i64):
    x = left
    var steps = 0
    when x >= 0 and x < n_blocks and steps < n_blocks loop
        vec_set_rt(marks, x, epoch)
        parent = vec_get_rt(idoms, x)
        if parent < 0 or parent == x do
            steps = n_blocks
        else
            x = parent
            steps = steps + 1
        end
    end

    y = right
    steps = 0
    when y >= 0 and y < n_blocks and steps < n_blocks loop
        if vec_get_rt(marks, y) == epoch do out y end
        parent = vec_get_rt(idoms, y)
        if parent < 0 or parent == y do
            steps = n_blocks
        else
            y = parent
            steps = steps + 1
        end
    end
    out 0 - 1
end.

func mir_compute_dominators(blocks: i64, entry_idx: i64):
    n_blocks = vec_len_rt(blocks)
    if n_blocks == 0 do out blocks end

    # Direct idom fixed point. This avoids the old n*n dominance matrix,
    # repeated set intersections, and cubic immediate-dominator search.
    idoms = vec_new_rt()
    marks = vec_new_rt()
    var i = 0
    when i < n_blocks loop
        idoms = vec_push_rt(idoms, 0 - 1)
        marks = vec_push_rt(marks, 0)
        i = i + 1
    end
    vec_set_rt(idoms, entry_idx, entry_idx)

    changed = true
    var iter = 0
    var epoch = 0
    when changed and iter < n_blocks * 2 loop
        changed = false
        iter = iter + 1
        i = 0
        when i < n_blocks loop
            if i != entry_idx do
                b = vec_get_rt(blocks, i)
                preds = mir_block_preds(b)
                candidate = 0 - 1
                var p = 0
                when p < vec_len_rt(preds) loop
                    pred_idx = vec_get_rt(preds, p)
                    if pred_idx >= 0 and pred_idx < n_blocks do
                        if vec_get_rt(idoms, pred_idx) >= 0 do
                            if candidate < 0 do
                                candidate = pred_idx
                            else
                                epoch = epoch + 1
                                candidate = intersect_idom_chains(idoms, candidate, pred_idx, marks, epoch, n_blocks)
                            end
                        end
                    end
                    p = p + 1
                end
                if candidate >= 0 and candidate != vec_get_rt(idoms, i) do
                    vec_set_rt(idoms, i, candidate)
                    changed = true
                end
            end
            i = i + 1
        end
    end

    i = 0
    when i < n_blocks loop
        b = vec_get_rt(blocks, i)
        idom_idx = vec_get_rt(idoms, i)
        mir_block_replace_idom(b, idom_idx)
        if i != entry_idx and idom_idx >= 0 do
            idom_block = vec_get_rt(blocks, idom_idx)
            idom_children = vec_push_rt(mir_block_dom_children(idom_block), i)
            mir_block_replace_dom_children(idom_block, idom_children)
        end
        i = i + 1
    end

    i = 0
    when i < n_blocks loop
        b = vec_get_rt(blocks, i)
        b_preds = mir_block_preds(b)
        if vec_len_rt(b_preds) >= 2 do
            var p = 0
            when p < vec_len_rt(b_preds) loop
                runner = vec_get_rt(b_preds, p)
                var step = 0
                when runner >= 0 and runner != mir_block_idom(b) and step < n_blocks loop
                    r_block = vec_get_rt(blocks, runner)
                    r_df = mir_block_df(r_block)
                    exists = false
                    df_len = vec_len_rt(r_df)
                    var df_idx = 0
                    when df_idx < df_len loop
                        if vec_get_rt(r_df, df_idx) == i do
                            exists = true
                        end
                        df_idx = df_idx + 1
                    end
                    if not exists do
                        new_df = vec_push_rt(r_df, i)
                        mir_block_replace_df(r_block, new_df)
                    end
                    runner = mir_block_idom(r_block)
                    step = step + 1
                end
                p = p + 1
            end
        end
        i = i + 1
    end
    out blocks
end.

export mir_build_cfg, mir_compute_dominators
