##
 * vir/compiler/mir_cfg.vri — Control Flow Graph & Dominator Tree
 * ================================================================
 * Builds predecessor edges from successors Vec, IDom, and
 * Dominance Frontiers (DF) for SSA construction.
 ##

include types;
include vec_rt;
import vec_new_rt, vec_push_rt, vec_get_rt, vec_set_rt, vec_len_rt from vec_rt;
include mir;
import MirBlock, mir_block_new, mir_block_id, mir_block_head, mir_block_tail, mir_block_successors, mir_block_preds, mir_block_idom, mir_block_dom_children, mir_block_df, mir_block_next_block, mir_block_phis from mir;

func mir_build_cfg(blocks: i64):
    n_blocks = vec_len_rt(blocks);

    # 1. Clear predecessors; ensure DF/dom_children exist
    var i = 0;
    when i < n_blocks loop
        b = vec_get_rt(blocks, i);
        b_new = mir_block_new(
            mir_block_id(b),
            mir_block_phis(b),
            mir_block_head(b),
            mir_block_tail(b),
            mir_block_successors(b),
            vec_new_rt(),
            0 - 1,
            vec_new_rt(),
            vec_new_rt(),
            mir_block_next_block(b)
        );
        vec_set_rt(blocks, i, b_new);
        i = i + 1
    end

    # 2. Add predecessors from successors Vec
    i = 0;
    when i < n_blocks loop
        b = vec_get_rt(blocks, i);
        succs = mir_block_successors(b);
        if succs >= 0 do
            ns = vec_len_rt(succs);
            var s = 0;
            when s < ns loop
                succ_idx = vec_get_rt(succs, s);
                if succ_idx >= 0 and succ_idx < n_blocks do
                    sb = vec_get_rt(blocks, succ_idx);
                    new_preds = vec_push_rt(mir_block_preds(sb), i);
                    sb_new = mir_block_new(
                        mir_block_id(sb),
                        mir_block_phis(sb),
                        mir_block_head(sb),
                        mir_block_tail(sb),
                        mir_block_successors(sb),
                        new_preds,
                        mir_block_idom(sb),
                        mir_block_dom_children(sb),
                        mir_block_df(sb),
                        mir_block_next_block(sb)
                    );
                    vec_set_rt(blocks, succ_idx, sb_new)
                end
                s = s + 1
            end
        end
        i = i + 1
    end
    out blocks
end.

func intersect_doms(dom1: i64, dom2: i64, n: i64):
    res = vec_new_rt();
    var i = 0;
    when i < n loop
        v1 = vec_get_rt(dom1, i);
        v2 = vec_get_rt(dom2, i);
        v = 0;
        if v1 == 1 and v2 == 1 do
            v = 1
        end
        res = vec_push_rt(res, v);
        i = i + 1
    end
    out res
end.

func doms_equal(dom1: i64, dom2: i64, n: i64):
    var i = 0;
    when i < n loop
        if vec_get_rt(dom1, i) != vec_get_rt(dom2, i) do
            out false
        end
        i = i + 1
    end
    out true
end.

func mir_compute_dominators(blocks: i64, entry_idx: i64):
    n_blocks = vec_len_rt(blocks);
    if n_blocks == 0 do
        out blocks
    end
    doms = vec_new_rt();

    var i = 0;
    when i < n_blocks loop
        dset = vec_new_rt();
        var j = 0;
        when j < n_blocks loop
            val = 0;
            if i == entry_idx do
                if j == entry_idx do
                    val = 1
                end
            else
                val = 1
            end
            dset = vec_push_rt(dset, val);
            j = j + 1
        end
        doms = vec_push_rt(doms, dset);
        i = i + 1
    end

    changed = true;
    when changed loop
        changed = false;
        i = 0;
        when i < n_blocks loop
            if i != entry_idx do
                b = vec_get_rt(blocks, i);
                b_preds = mir_block_preds(b);
                if vec_len_rt(b_preds) > 0 do
                    temp = 0 - 1;
                    var p = 0;
                    when p < vec_len_rt(b_preds) loop
                        pred_idx = vec_get_rt(b_preds, p);
                        pred_dom = vec_get_rt(doms, pred_idx);
                        if temp == 0 - 1 do
                            temp = vec_new_rt();
                            var k = 0;
                            when k < n_blocks loop
                                temp = vec_push_rt(temp, vec_get_rt(pred_dom, k));
                                k = k + 1
                            end
                        else
                            temp = intersect_doms(temp, pred_dom, n_blocks)
                        end
                        p = p + 1
                    end
                    vec_set_rt(temp, i, 1);

                    old_dom = vec_get_rt(doms, i);
                    if not doms_equal(old_dom, temp, n_blocks) do
                        vec_set_rt(doms, i, temp);
                        changed = true
                    end
                end
            end
            i = i + 1
        end
    end

    i = 0;
    when i < n_blocks loop
        if i != entry_idx do
            b = vec_get_rt(blocks, i);
            idom_idx = 0 - 1;
            var d = 0;
            when d < n_blocks loop
                if d != i do
                    d_doms_i = vec_get_rt(vec_get_rt(doms, i), d);
                    if d_doms_i == 1 do
                        is_idom = true;
                        var other_d = 0;
                        when other_d < n_blocks loop
                            if other_d != i and other_d != d do
                                other_d_doms_i = vec_get_rt(vec_get_rt(doms, i), other_d);
                                if other_d_doms_i == 1 do
                                    other_d_doms_d = vec_get_rt(vec_get_rt(doms, d), other_d);
                                    if other_d_doms_d == 0 do
                                        is_idom = false
                                    end
                                end
                            end
                            other_d = other_d + 1
                        end
                        if is_idom do
                            idom_idx = d
                        end
                    end
                end
                d = d + 1
            end
            if idom_idx >= 0 do
                b_updated = mir_block_new(
                    mir_block_id(b),
                    mir_block_phis(b),
                    mir_block_head(b),
                    mir_block_tail(b),
                    mir_block_successors(b),
                    mir_block_preds(b),
                    idom_idx,
                    mir_block_dom_children(b),
                    mir_block_df(b),
                    mir_block_next_block(b)
                );
                vec_set_rt(blocks, i, b_updated);

                idom_block = vec_get_rt(blocks, idom_idx);
                idom_new_children = vec_push_rt(mir_block_dom_children(idom_block), i);
                idom_updated = mir_block_new(
                    mir_block_id(idom_block),
                    mir_block_phis(idom_block),
                    mir_block_head(idom_block),
                    mir_block_tail(idom_block),
                    mir_block_successors(idom_block),
                    mir_block_preds(idom_block),
                    mir_block_idom(idom_block),
                    idom_new_children,
                    mir_block_df(idom_block),
                    mir_block_next_block(idom_block)
                );
                vec_set_rt(blocks, idom_idx, idom_updated)
            end
        end
        i = i + 1
    end

    i = 0;
    when i < n_blocks loop
        b = vec_get_rt(blocks, i);
        b_preds = mir_block_preds(b);
        if vec_len_rt(b_preds) >= 2 do
            var p = 0;
            when p < vec_len_rt(b_preds) loop
                runner = vec_get_rt(b_preds, p);
                when runner >= 0 and runner != mir_block_idom(b) loop
                    r_block = vec_get_rt(blocks, runner);
                    r_df = mir_block_df(r_block);
                    exists = false;
                    df_len = vec_len_rt(r_df);
                    var df_idx = 0;
                    when df_idx < df_len loop
                        if vec_get_rt(r_df, df_idx) == i do
                            exists = true
                        end
                        df_idx = df_idx + 1
                    end
                    if not exists do
                        new_df = vec_push_rt(r_df, i);
                        r_updated = mir_block_new(
                            mir_block_id(r_block),
                            mir_block_phis(r_block),
                            mir_block_head(r_block),
                            mir_block_tail(r_block),
                            mir_block_successors(r_block),
                            mir_block_preds(r_block),
                            mir_block_idom(r_block),
                            mir_block_dom_children(r_block),
                            new_df,
                            mir_block_next_block(r_block)
                        );
                        vec_set_rt(blocks, runner, r_updated)
                    end
                    runner = mir_block_idom(r_block)
                end
                p = p + 1
            end
        end
        i = i + 1
    end
    out blocks
end.

export mir_build_cfg, mir_compute_dominators
