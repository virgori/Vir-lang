##
 * vir/compiler/mir_cfg.vri — Control Flow Graph & Dominator Tree
 * ================================================================
 * Builds predecessor edges, IDom (Immediate Dominators), and 
 * Dominance Frontiers (DF) for SSA construction.
 ##

include types;
include vec_rt;
import vec_new_rt, vec_push_rt, vec_get_rt, vec_set_rt, vec_len_rt from vec_rt;
include mir;
import MirBlock from mir;

# ═══════════════════════════════════════════════════════
# Build CFG (Predecessors)
# ═══════════════════════════════════════════════════════

func mir_build_cfg(blocks: i64)
    # blocks is a Vec<MirBlock>
    n_blocks = vec_len_rt(blocks);
    
    # 1. Clear predecessors
    i = 0;
    when i < n_blocks loop
        b = vec_get_rt(blocks, i);
        b.preds = vec_new_rt();
        vec_set_rt(blocks, i, b);
        i = i + 1
    end.
    
    # 2. Add predecessors from successors
    i = 0;
    when i < n_blocks loop
        b = vec_get_rt(blocks, i);
        
        if b.succ_true >= 0 do
            t_block = vec_get_rt(blocks, b.succ_true);
            t_block.preds = vec_push_rt(t_block.preds, i);
            vec_set_rt(blocks, b.succ_true, t_block)
        end.
        
        if b.succ_false >= 0 and b.succ_false != b.succ_true do
            f_block = vec_get_rt(blocks, b.succ_false);
            f_block.preds = vec_push_rt(f_block.preds, i);
            vec_set_rt(blocks, b.succ_false, f_block)
        end.
        
        i = i + 1
    end.
    
    out blocks
end.


# ═══════════════════════════════════════════════════════
# Dominator Tree (IDom) & Dominance Frontier
# ═══════════════════════════════════════════════════════

func intersect_doms(dom1: i64, dom2: i64, n: i64)
    # Both are Vec<i64> of size n acting as booleans (0 or 1)
    res = vec_new_rt();
    i = 0;
    when i < n loop
        v1 = vec_get_rt(dom1, i);
        v2 = vec_get_rt(dom2, i);
        v = 0;
        if v1 == 1 and v2 == 1 do
            v = 1
        end
        res = vec_push_rt(res, v);
        i = i + 1
    end
    out res
end.

func doms_equal(dom1: i64, dom2: i64, n: i64)
    i = 0;
    when i < n loop
        if vec_get_rt(dom1, i) != vec_get_rt(dom2, i) do
            out false
        end
        i = i + 1
    end
    out true
end.

func mir_compute_dominators(blocks: i64, entry_idx: i64)
    n_blocks = vec_len_rt(blocks);
    if n_blocks == 0 do
        out blocks
    end.
    
    # doms is a Vec of Vec<i64> (bitsets)
    doms = vec_new_rt();
    
    # Initialize dom sets
    i = 0;
    when i < n_blocks loop
        dset = vec_new_rt();
        j = 0;
        when j < n_blocks loop
            val = 0;
            if i == entry_idx do
                # Dom(entry) = (entry)
                if j == entry_idx do val = 1 end
            else
                # Dom(other) = (all) initially
                val = 1
            end
            dset = vec_push_rt(dset, val);
            j = j + 1
        end
        doms = vec_push_rt(doms, dset);
        i = i + 1
    end.
    
    # Iterative solver
    changed = true;
    when changed loop
        changed = false;
        i = 0;
        when i < n_blocks loop
            if i != entry_idx do
                b = vec_get_rt(blocks, i);
                if vec_len_rt(b.preds) > 0 do
                    # Intersect all predecessors' doms
                    temp = -1;
                    p = 0;
                    when p < vec_len_rt(b.preds) loop
                        pred_idx = vec_get_rt(b.preds, p);
                        pred_dom = vec_get_rt(doms, pred_idx);
                        if temp == -1 do
                            # copy first pred
                            temp = vec_new_rt();
                            k = 0;
                            when k < n_blocks loop
                                temp = vec_push_rt(temp, vec_get_rt(pred_dom, k));
                                k = k + 1
                            end
                        else
                            temp = intersect_doms(temp, pred_dom, n_blocks)
                        end
                        p = p + 1
                    end.
                    
                    # Dom(i) = (i) U intersection
                    vec_set_rt(temp, i, 1);
                    
                    # Check if changed
                    old_dom = vec_get_rt(doms, i);
                    if not doms_equal(old_dom, temp, n_blocks) do
                        vec_set_rt(doms, i, temp);
                        changed = true
                    end
                end
            end
            i = i + 1
        end
    end.
    
    # Compute IDom
    i = 0;
    when i < n_blocks loop
        if i != entry_idx do
            b = vec_get_rt(blocks, i);
            idom_idx = -1;
            d = 0;
            when d < n_blocks loop
                if d != i do
                    d_doms_i = vec_get_rt(vec_get_rt(doms, i), d);
                    if d_doms_i == 1 do
                        # d strictly dominates i. Does d dominate all other strict dominators?
                        is_idom = true;
                        other_d = 0;
                        when other_d < n_blocks loop
                            if other_d != i and other_d != d do
                                other_d_doms_i = vec_get_rt(vec_get_rt(doms, i), other_d);
                                if other_d_doms_i == 1 do
                                    other_d_doms_d = vec_get_rt(vec_get_rt(doms, d), other_d);
                                    if other_d_doms_d == 0 do
                                        is_idom = false
                                    end
                                end
                            end
                            other_d = other_d + 1
                        end.
                        
                        if is_idom do
                            idom_idx = d
                        end
                    end
                end
                d = d + 1
            end.
            
            if idom_idx >= 0 do
                b.idom = idom_idx;
                idom_block = vec_get_rt(blocks, idom_idx);
                idom_block.dom_children = vec_push_rt(idom_block.dom_children, i);
                vec_set_rt(blocks, idom_idx, idom_block)
            end
            vec_set_rt(blocks, i, b)
        end
        i = i + 1
    end.
    
    # Compute Dominance Frontier
    i = 0;
    when i < n_blocks loop
        b = vec_get_rt(blocks, i);
        if vec_len_rt(b.preds) >= 2 do
            p = 0;
            when p < vec_len_rt(b.preds) loop
                runner = vec_get_rt(b.preds, p);
                when runner >= 0 and runner != b.idom loop
                    # Add i to runner's DF
                    r_block = vec_get_rt(blocks, runner);
                    
                    # Check if already in DF
                    exists = false;
                    df_len = vec_len_rt(r_block.df);
                    df_idx = 0;
                    when df_idx < df_len loop
                        if vec_get_rt(r_block.df, df_idx) == i do
                            exists = true
                        end
                        df_idx = df_idx + 1
                    end.
                    
                    if not exists do
                        r_block.df = vec_push_rt(r_block.df, i);
                        vec_set_rt(blocks, runner, r_block)
                    end.
                    
                    runner = r_block.idom
                end
                p = p + 1
            end
        end
        i = i + 1
    end.
    
    out blocks
end.

export mir_build_cfg, mir_compute_dominators;
