##
 * vir/compiler/target.vri — Codegen target selection (shared state)
 ##

include types
include compiler.codegen
import TargetArch from compiler.codegen

include compiler.target_spec
import TargetSpec, target_spec_arch from compiler.target_spec

var g_codegen_target: int = 2   # TargetArch.ARM64
var g_codegen_spec: TargetSpec = 0

func set_codegen_target(arch: int):
    g_codegen_target = arch
end.

func get_codegen_target():
    out g_codegen_target
end.

func set_codegen_spec(spec: TargetSpec):
    g_codegen_spec = spec
    if spec != 0 do
        g_codegen_target = target_spec_arch(spec)
    end
end.

func get_codegen_spec():
    out g_codegen_spec
end.

func color_to_phys(color: i64, is_leaf: i64):
    let t = get_codegen_target()
    if t == 1 or t == TargetArch.X86_64 do
        if color == 0 do out 3 end    # RBX
        if color == 1 do out 13 end   # R13
        if color == 2 do out 14 end   # R14
        out 3
    end
    if t == 3 or t == TargetArch.RISCV64 do
        out 18 + color # s2..s10
    end
    out 20 + color
end.

export set_codegen_target, get_codegen_target, set_codegen_spec, get_codegen_spec, TargetArch, color_to_phys
