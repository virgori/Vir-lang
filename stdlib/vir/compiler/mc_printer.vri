##
 * vir/compiler/mc_printer.vri — Multi-Dialect Assembly Printer (bvec-based)
 * =========================================================================
 * Consumes MCInst stream and emits textual assembly for:
 *   - DarwinAsm (macOS clang/llvm assembler, ARM64)
 *   - GNU_ELF   (Linux GNU as / aarch64-linux-gnu-gcc)
 *   - Intel_X86 (Linux x86_64 .intel_syntax noprefix / x86_64-linux-gnu-gcc)
 *   - GNU_RISCV (Linux riscv64-linux-gnu-gcc)
 ##

module vir.compiler.mc_printer

include types
include string_rt
import rt_strlen, native_read_u8, native_read_i64, native_write_i64 from string_rt
include vir.rt.vec_rt
import bvec_new, bvec_push, bvec_len, bvec_data_ptr from vir.rt.vec_rt
include compiler.mc
import AsmDialect, MCOpcode, MCOperandKind, RelocKind, MCInst, MCOperand, mc_inst_opc, mc_inst_op0, mc_inst_op1, mc_inst_op2, mc_inst_op3, mc_inst_flags, mc_opnd_kind, mc_opnd_reg_val, mc_opnd_imm_val, mc_opnd_mem_base, mc_opnd_mem_off, mc_opnd_mem_scale, mc_opnd_mem_idx, mc_opnd_sym_name, mc_opnd_reloc, mc_opnd_addend from compiler.mc

func bvec_emit_cstr(b: int, s: int):
    if s == 0 do out b end
    let slen = rt_strlen(s)
    var i = 0
    when i < slen loop
        b = bvec_push(b, native_read_u8(s, i))
        i = i + 1
    end
    out b
end.

func bvec_emit_int(b: int, n: int):
    if n == 0 do
        out bvec_push(b, 48)
    end
    var val = n
    if val < 0 do
        b = bvec_push(b, 45) # '-'
        val = 0 - val
    end
    var digits = 0
    var temp = val
    when temp > 0 loop
        digits = digits + 1
        temp = temp / 10
    end
    var d = digits
    when d > 0 loop
        var p = 1
        var k = 1
        when k < d loop
            p = p * 10
            k = k + 1
        end
        let digit = (val / p) mod 10
        b = bvec_push(b, 48 + digit)
        d = d - 1
    end
    out b
end.

func reg_name(reg: int):
    if reg == 31 do out "sp" end
    if reg == 30 do out "lr" end
    if reg == 29 do out "fp" end
    if reg == 0 do out "x0" end
    if reg == 1 do out "x1" end
    if reg == 2 do out "x2" end
    if reg == 3 do out "x3" end
    if reg == 4 do out "x4" end
    if reg == 5 do out "x5" end
    if reg == 6 do out "x6" end
    if reg == 7 do out "x7" end
    if reg == 8 do out "x8" end
    if reg == 9 do out "x9" end
    if reg == 10 do out "x10" end
    if reg == 11 do out "x11" end
    if reg == 12 do out "x12" end
    if reg == 13 do out "x13" end
    if reg == 14 do out "x14" end
    if reg == 15 do out "x15" end
    if reg == 16 do out "x16" end
    if reg == 17 do out "x17" end
    if reg == 18 do out "x18" end
    if reg == 19 do out "x19" end
    if reg == 20 do out "x20" end
    if reg == 21 do out "x21" end
    if reg == 22 do out "x22" end
    if reg == 23 do out "x23" end
    if reg == 24 do out "x24" end
    if reg == 25 do out "x25" end
    if reg == 26 do out "x26" end
    if reg == 27 do out "x27" end
    if reg == 28 do out "x28" end
    out "xzr"
end.

func x86_reg_name(reg: int):
    if reg == 0 do out "rax" end
    if reg == 1 do out "rcx" end
    if reg == 2 do out "rdx" end
    if reg == 3 do out "rbx" end
    if reg == 4 do out "rsp" end
    if reg == 5 do out "rbp" end
    if reg == 6 do out "rsi" end
    if reg == 7 do out "rdi" end
    if reg == 8 do out "r8" end
    if reg == 9 do out "r9" end
    if reg == 10 do out "r10" end
    if reg == 11 do out "r11" end
    if reg == 12 do out "r12" end
    if reg == 13 do out "r13" end
    if reg == 14 do out "r14" end
    if reg == 15 do out "r15" end
    out "rax"
end.

func riscv_reg_name(reg: int):
    if reg == 0 do out "zero" end
    if reg == 1 do out "ra" end
    if reg == 2 do out "sp" end
    if reg == 3 do out "gp" end
    if reg == 4 do out "tp" end
    if reg == 5 do out "t0" end
    if reg == 6 do out "t1" end
    if reg == 7 do out "t2" end
    if reg == 8 do out "s0" end
    if reg == 9 do out "s1" end
    if reg == 10 do out "a0" end
    if reg == 11 do out "a1" end
    if reg == 12 do out "a2" end
    if reg == 13 do out "a3" end
    if reg == 14 do out "a4" end
    if reg == 15 do out "a5" end
    if reg == 16 do out "a6" end
    if reg == 17 do out "a7" end
    if reg == 18 do out "s2" end
    if reg == 19 do out "s3" end
    if reg == 20 do out "s4" end
    if reg == 21 do out "s5" end
    if reg == 22 do out "s6" end
    if reg == 23 do out "s7" end
    if reg == 24 do out "s8" end
    if reg == 25 do out "s9" end
    if reg == 26 do out "s10" end
    if reg == 27 do out "s11" end
    if reg == 28 do out "t3" end
    if reg == 29 do out "t4" end
    if reg == 30 do out "t5" end
    if reg == 31 do out "t6" end
    out "zero"
end.

func append_label(b: int, label_id: int, dialect: int):
    if dialect == AsmDialect.DarwinAsm do
        b = bvec_emit_cstr(b, "LBB_")
    else
        b = bvec_emit_cstr(b, ".LBB_")
    end
    var lid = label_id
    if lid < 0 do lid = 0 - lid end
    let fid = lid / 10000
    let bid = lid mod 10000
    b = bvec_emit_int(b, fid)
    b = bvec_emit_cstr(b, "_")
    out bvec_emit_int(b, bid)
end.

func print_mc_inst_x86(inst: MCInst, dialect: int, b: int):
    let opc = mc_inst_opc(inst)
    if opc == MCOpcode.X86_64_MOV_RR do
        b = bvec_emit_cstr(b, "    mov ")
        b = bvec_emit_cstr(b, x86_reg_name(mc_opnd_reg_val(mc_inst_op0(inst))))
        b = bvec_emit_cstr(b, ", ")
        b = bvec_emit_cstr(b, x86_reg_name(mc_opnd_reg_val(mc_inst_op1(inst))))
        out bvec_emit_cstr(b, "
")
    end
    if opc == MCOpcode.X86_64_MOV_RI do
        b = bvec_emit_cstr(b, "    mov ")
        b = bvec_emit_cstr(b, x86_reg_name(mc_opnd_reg_val(mc_inst_op0(inst))))
        b = bvec_emit_cstr(b, ", ")
        b = bvec_emit_int(b, mc_opnd_imm_val(mc_inst_op1(inst)))
        out bvec_emit_cstr(b, "
")
    end
    if opc == MCOpcode.X86_64_ADD_RR or opc == MCOpcode.X86_64_SUB_RR or opc == MCOpcode.X86_64_AND_RR or opc == MCOpcode.X86_64_OR_RR or opc == MCOpcode.X86_64_XOR_RR or opc == MCOpcode.X86_64_IMUL_RR do
        if opc == MCOpcode.X86_64_ADD_RR do b = bvec_emit_cstr(b, "    add ") end
        if opc == MCOpcode.X86_64_SUB_RR do b = bvec_emit_cstr(b, "    sub ") end
        if opc == MCOpcode.X86_64_AND_RR do b = bvec_emit_cstr(b, "    and ") end
        if opc == MCOpcode.X86_64_OR_RR  do b = bvec_emit_cstr(b, "    or ") end
        if opc == MCOpcode.X86_64_XOR_RR do b = bvec_emit_cstr(b, "    xor ") end
        if opc == MCOpcode.X86_64_IMUL_RR do b = bvec_emit_cstr(b, "    imul ") end
        b = bvec_emit_cstr(b, x86_reg_name(mc_opnd_reg_val(mc_inst_op0(inst))))
        b = bvec_emit_cstr(b, ", ")
        b = bvec_emit_cstr(b, x86_reg_name(mc_opnd_reg_val(mc_inst_op1(inst))))
        out bvec_emit_cstr(b, "
")
    end
    if opc == MCOpcode.X86_64_ADD_RI or opc == MCOpcode.X86_64_SUB_RI do
        if opc == MCOpcode.X86_64_ADD_RI do b = bvec_emit_cstr(b, "    add ") else b = bvec_emit_cstr(b, "    sub ") end
        b = bvec_emit_cstr(b, x86_reg_name(mc_opnd_reg_val(mc_inst_op0(inst))))
        b = bvec_emit_cstr(b, ", ")
        b = bvec_emit_int(b, mc_opnd_imm_val(mc_inst_op1(inst)))
        out bvec_emit_cstr(b, "
")
    end
    if opc == MCOpcode.X86_64_SUB_RSP_IMM or opc == MCOpcode.X86_64_ADD_RSP_IMM do
        if opc == MCOpcode.X86_64_SUB_RSP_IMM do b = bvec_emit_cstr(b, "    sub rsp, ") else b = bvec_emit_cstr(b, "    add rsp, ") end
        b = bvec_emit_int(b, mc_opnd_imm_val(mc_inst_op0(inst)))
        out bvec_emit_cstr(b, "
")
    end
    if opc == MCOpcode.X86_64_CQO do
        out bvec_emit_cstr(b, "    cqo
")
    end
    if opc == MCOpcode.X86_64_IDIV do
        b = bvec_emit_cstr(b, "    idiv ")
        b = bvec_emit_cstr(b, x86_reg_name(mc_opnd_reg_val(mc_inst_op0(inst))))
        out bvec_emit_cstr(b, "
")
    end
    if opc == MCOpcode.X86_64_SHL_CL or opc == MCOpcode.X86_64_SHR_CL do
        if opc == MCOpcode.X86_64_SHL_CL do b = bvec_emit_cstr(b, "    shl ") else b = bvec_emit_cstr(b, "    shr ") end
        b = bvec_emit_cstr(b, x86_reg_name(mc_opnd_reg_val(mc_inst_op0(inst))))
        out bvec_emit_cstr(b, ", cl
")
    end
    if opc == MCOpcode.X86_64_NOT_R do
        b = bvec_emit_cstr(b, "    not ")
        b = bvec_emit_cstr(b, x86_reg_name(mc_opnd_reg_val(mc_inst_op0(inst))))
        out bvec_emit_cstr(b, "
")
    end
    if opc == MCOpcode.X86_64_CMP_RR do
        b = bvec_emit_cstr(b, "    cmp ")
        b = bvec_emit_cstr(b, x86_reg_name(mc_opnd_reg_val(mc_inst_op0(inst))))
        b = bvec_emit_cstr(b, ", ")
        b = bvec_emit_cstr(b, x86_reg_name(mc_opnd_reg_val(mc_inst_op1(inst))))
        out bvec_emit_cstr(b, "
")
    end
    if opc == MCOpcode.X86_64_CMP_RI do
        b = bvec_emit_cstr(b, "    cmp ")
        b = bvec_emit_cstr(b, x86_reg_name(mc_opnd_reg_val(mc_inst_op0(inst))))
        b = bvec_emit_cstr(b, ", ")
        b = bvec_emit_int(b, mc_opnd_imm_val(mc_inst_op1(inst)))
        out bvec_emit_cstr(b, "
")
    end
    if opc >= MCOpcode.X86_64_SETE and opc <= MCOpcode.X86_64_SETLE do
        if opc == MCOpcode.X86_64_SETE do b = bvec_emit_cstr(b, "    sete al
") end
        if opc == MCOpcode.X86_64_SETNE do b = bvec_emit_cstr(b, "    setne al
") end
        if opc == MCOpcode.X86_64_SETG do b = bvec_emit_cstr(b, "    setg al
") end
        if opc == MCOpcode.X86_64_SETL do b = bvec_emit_cstr(b, "    setl al
") end
        if opc == MCOpcode.X86_64_SETGE do b = bvec_emit_cstr(b, "    setge al
") end
        if opc == MCOpcode.X86_64_SETLE do b = bvec_emit_cstr(b, "    setle al
") end
        b = bvec_emit_cstr(b, "    movzx ")
        b = bvec_emit_cstr(b, x86_reg_name(mc_opnd_reg_val(mc_inst_op0(inst))))
        out bvec_emit_cstr(b, ", al
")
    end
    if opc >= MCOpcode.X86_64_JMP and opc <= MCOpcode.X86_64_JLE do
        if opc == MCOpcode.X86_64_JMP do b = bvec_emit_cstr(b, "    jmp ") end
        if opc == MCOpcode.X86_64_JE  do b = bvec_emit_cstr(b, "    je ") end
        if opc == MCOpcode.X86_64_JNE do b = bvec_emit_cstr(b, "    jne ") end
        if opc == MCOpcode.X86_64_JG  do b = bvec_emit_cstr(b, "    jg ") end
        if opc == MCOpcode.X86_64_JL  do b = bvec_emit_cstr(b, "    jl ") end
        if opc == MCOpcode.X86_64_JGE do b = bvec_emit_cstr(b, "    jge ") end
        if opc == MCOpcode.X86_64_JLE do b = bvec_emit_cstr(b, "    jle ") end
        b = append_label(b, mc_opnd_imm_val(mc_inst_op0(inst)), dialect)
        out bvec_emit_cstr(b, "
")
    end
    if opc == MCOpcode.X86_64_CALL do
        b = bvec_emit_cstr(b, "    call ")
        b = bvec_emit_cstr(b, mc_opnd_sym_name(mc_inst_op0(inst)))
        out bvec_emit_cstr(b, "
")
    end
    if opc == MCOpcode.X86_64_CALL_R do
        b = bvec_emit_cstr(b, "    call ")
        b = bvec_emit_cstr(b, x86_reg_name(mc_opnd_reg_val(mc_inst_op0(inst))))
        out bvec_emit_cstr(b, "
")
    end
    if opc == MCOpcode.X86_64_PUSH_R do
        b = bvec_emit_cstr(b, "    push ")
        b = bvec_emit_cstr(b, x86_reg_name(mc_opnd_reg_val(mc_inst_op0(inst))))
        out bvec_emit_cstr(b, "
")
    end
    if opc == MCOpcode.X86_64_POP_R do
        b = bvec_emit_cstr(b, "    pop ")
        b = bvec_emit_cstr(b, x86_reg_name(mc_opnd_reg_val(mc_inst_op0(inst))))
        out bvec_emit_cstr(b, "
")
    end
    if opc == MCOpcode.X86_64_RET do
        out bvec_emit_cstr(b, "    ret
")
    end
    if opc == MCOpcode.X86_64_SYSCALL do
        out bvec_emit_cstr(b, "    syscall
")
    end
    out b
end.

func print_mc_inst_riscv(inst: MCInst, dialect: int, b: int):
    let opc = mc_inst_opc(inst)
    if opc == MCOpcode.RISCV_ADDI do
        b = bvec_emit_cstr(b, "    addi ")
        b = bvec_emit_cstr(b, riscv_reg_name(mc_opnd_reg_val(mc_inst_op0(inst))))
        b = bvec_emit_cstr(b, ", ")
        b = bvec_emit_cstr(b, riscv_reg_name(mc_opnd_reg_val(mc_inst_op1(inst))))
        b = bvec_emit_cstr(b, ", ")
        b = bvec_emit_int(b, mc_opnd_imm_val(mc_inst_op2(inst)))
        out bvec_emit_cstr(b, "
")
    end
    if opc >= MCOpcode.RISCV_ADD and opc <= MCOpcode.RISCV_SLT and opc != MCOpcode.RISCV_ADDI do
        if opc == MCOpcode.RISCV_ADD do b = bvec_emit_cstr(b, "    add ") end
        if opc == MCOpcode.RISCV_SUB do b = bvec_emit_cstr(b, "    sub ") end
        if opc == MCOpcode.RISCV_MUL do b = bvec_emit_cstr(b, "    mul ") end
        if opc == MCOpcode.RISCV_DIV do b = bvec_emit_cstr(b, "    div ") end
        if opc == MCOpcode.RISCV_REM do b = bvec_emit_cstr(b, "    rem ") end
        if opc == MCOpcode.RISCV_AND do b = bvec_emit_cstr(b, "    and ") end
        if opc == MCOpcode.RISCV_OR  do b = bvec_emit_cstr(b, "    or ") end
        if opc == MCOpcode.RISCV_XOR do b = bvec_emit_cstr(b, "    xor ") end
        if opc == MCOpcode.RISCV_SLL do b = bvec_emit_cstr(b, "    sll ") end
        if opc == MCOpcode.RISCV_SRL do b = bvec_emit_cstr(b, "    srl ") end
        if opc == MCOpcode.RISCV_SLT do b = bvec_emit_cstr(b, "    slt ") end
        b = bvec_emit_cstr(b, riscv_reg_name(mc_opnd_reg_val(mc_inst_op0(inst))))
        b = bvec_emit_cstr(b, ", ")
        b = bvec_emit_cstr(b, riscv_reg_name(mc_opnd_reg_val(mc_inst_op1(inst))))
        b = bvec_emit_cstr(b, ", ")
        b = bvec_emit_cstr(b, riscv_reg_name(mc_opnd_reg_val(mc_inst_op2(inst))))
        out bvec_emit_cstr(b, "
")
    end
    if opc >= MCOpcode.RISCV_BEQ and opc <= MCOpcode.RISCV_BLE do
        if opc == MCOpcode.RISCV_BEQ do b = bvec_emit_cstr(b, "    beq ") end
        if opc == MCOpcode.RISCV_BNE do b = bvec_emit_cstr(b, "    bne ") end
        if opc == MCOpcode.RISCV_BLT do b = bvec_emit_cstr(b, "    blt ") end
        if opc == MCOpcode.RISCV_BGE do b = bvec_emit_cstr(b, "    bge ") end
        if opc == MCOpcode.RISCV_BGT do b = bvec_emit_cstr(b, "    blt ") end
        if opc == MCOpcode.RISCV_BLE do b = bvec_emit_cstr(b, "    bge ") end
        if opc == MCOpcode.RISCV_BGT or opc == MCOpcode.RISCV_BLE do
            b = bvec_emit_cstr(b, riscv_reg_name(mc_opnd_reg_val(mc_inst_op1(inst))))
            b = bvec_emit_cstr(b, ", ")
            b = bvec_emit_cstr(b, riscv_reg_name(mc_opnd_reg_val(mc_inst_op0(inst))))
        else
            b = bvec_emit_cstr(b, riscv_reg_name(mc_opnd_reg_val(mc_inst_op0(inst))))
            b = bvec_emit_cstr(b, ", ")
            b = bvec_emit_cstr(b, riscv_reg_name(mc_opnd_reg_val(mc_inst_op1(inst))))
        end
        b = bvec_emit_cstr(b, ", ")
        b = append_label(b, mc_opnd_imm_val(mc_inst_op2(inst)), dialect)
        out bvec_emit_cstr(b, "
")
    end
    if opc == MCOpcode.RISCV_JAL do
        let op0 = mc_inst_op0(inst)
        let k = mc_opnd_kind(op0)
        if k == MCOperandKind.Symbol do
            b = bvec_emit_cstr(b, "    jal ra, ")
            b = bvec_emit_cstr(b, mc_opnd_sym_name(op0))
            out bvec_emit_cstr(b, "
")
        else
            b = bvec_emit_cstr(b, "    j ")
            b = append_label(b, mc_opnd_imm_val(op0), dialect)
            out bvec_emit_cstr(b, "
")
        end
    end
    if opc == MCOpcode.RISCV_JALR do
        b = bvec_emit_cstr(b, "    jalr ra, ")
        b = bvec_emit_cstr(b, riscv_reg_name(mc_opnd_reg_val(mc_inst_op0(inst))))
        out bvec_emit_cstr(b, ", 0
")
    end
    if opc == MCOpcode.RISCV_LD do
        b = bvec_emit_cstr(b, "    ld ")
        b = bvec_emit_cstr(b, riscv_reg_name(mc_opnd_reg_val(mc_inst_op0(inst))))
        b = bvec_emit_cstr(b, ", ")
        b = bvec_emit_int(b, mc_opnd_imm_val(mc_inst_op2(inst)))
        b = bvec_emit_cstr(b, "(")
        b = bvec_emit_cstr(b, riscv_reg_name(mc_opnd_reg_val(mc_inst_op1(inst))))
        out bvec_emit_cstr(b, ")
")
    end
    if opc == MCOpcode.RISCV_SD do
        b = bvec_emit_cstr(b, "    sd ")
        b = bvec_emit_cstr(b, riscv_reg_name(mc_opnd_reg_val(mc_inst_op0(inst))))
        b = bvec_emit_cstr(b, ", ")
        b = bvec_emit_int(b, mc_opnd_imm_val(mc_inst_op2(inst)))
        b = bvec_emit_cstr(b, "(")
        b = bvec_emit_cstr(b, riscv_reg_name(mc_opnd_reg_val(mc_inst_op1(inst))))
        out bvec_emit_cstr(b, ")
")
    end
    if opc == MCOpcode.RISCV_LI do
        b = bvec_emit_cstr(b, "    li ")
        b = bvec_emit_cstr(b, riscv_reg_name(mc_opnd_reg_val(mc_inst_op0(inst))))
        b = bvec_emit_cstr(b, ", ")
        b = bvec_emit_int(b, mc_opnd_imm_val(mc_inst_op1(inst)))
        out bvec_emit_cstr(b, "
")
    end
    if opc == MCOpcode.RISCV_MV do
        b = bvec_emit_cstr(b, "    mv ")
        b = bvec_emit_cstr(b, riscv_reg_name(mc_opnd_reg_val(mc_inst_op0(inst))))
        b = bvec_emit_cstr(b, ", ")
        b = bvec_emit_cstr(b, riscv_reg_name(mc_opnd_reg_val(mc_inst_op1(inst))))
        out bvec_emit_cstr(b, "
")
    end
    if opc == MCOpcode.RISCV_ECALL do
        out bvec_emit_cstr(b, "    ecall
")
    end
    if opc == MCOpcode.RISCV_RET do
        out bvec_emit_cstr(b, "    ret
")
    end
    out b
end.

func print_mc_inst(inst: MCInst, dialect: int, b: int):
    let opc = mc_inst_opc(inst)
    if opc == MCOpcode.NOP do
        out bvec_emit_cstr(b, "    nop
")
    end
    if opc == MCOpcode.LABEL_DEF do
        let op0 = mc_inst_op0(inst)
        b = append_label(b, mc_opnd_imm_val(op0), dialect)
        out bvec_emit_cstr(b, ":
")
    end
    if opc == MCOpcode.COMMENT do
        let op0 = mc_inst_op0(inst)
        let s = mc_opnd_sym_name(op0)
        if s != 0 do
            if dialect == AsmDialect.GNU_RISCV do
                b = bvec_emit_cstr(b, "    # ")
            else
                b = bvec_emit_cstr(b, "    // ")
            end
            b = bvec_emit_cstr(b, s)
            b = bvec_emit_cstr(b, "
")
        end
        out b
    end

    if opc >= 100 and opc < 200 do
        out print_mc_inst_x86(inst, dialect, b)
    end
    if opc >= 200 and opc < 300 do
        out print_mc_inst_riscv(inst, dialect, b)
    end

    # ── ARM64 instructions ──
    # Data processing (register)
    if opc == MCOpcode.ARM64_ADD_RRR or opc == MCOpcode.ARM64_SUB_RRR or opc == MCOpcode.ARM64_MUL_RRR or opc == MCOpcode.ARM64_SDIV_RRR or opc == MCOpcode.ARM64_AND_RRR or opc == MCOpcode.ARM64_ORR_RRR or opc == MCOpcode.ARM64_EOR_RRR or opc == MCOpcode.ARM64_LSL_RRR or opc == MCOpcode.ARM64_LSR_RRR do
        if opc == MCOpcode.ARM64_ADD_RRR do b = bvec_emit_cstr(b, "    add ") end
        if opc == MCOpcode.ARM64_SUB_RRR do b = bvec_emit_cstr(b, "    sub ") end
        if opc == MCOpcode.ARM64_MUL_RRR do b = bvec_emit_cstr(b, "    mul ") end
        if opc == MCOpcode.ARM64_SDIV_RRR do b = bvec_emit_cstr(b, "    sdiv ") end
        if opc == MCOpcode.ARM64_AND_RRR do b = bvec_emit_cstr(b, "    and ") end
        if opc == MCOpcode.ARM64_ORR_RRR do b = bvec_emit_cstr(b, "    orr ") end
        if opc == MCOpcode.ARM64_EOR_RRR do b = bvec_emit_cstr(b, "    eor ") end
        if opc == MCOpcode.ARM64_LSL_RRR do b = bvec_emit_cstr(b, "    lsl ") end
        if opc == MCOpcode.ARM64_LSR_RRR do b = bvec_emit_cstr(b, "    lsr ") end
        b = bvec_emit_cstr(b, reg_name(mc_opnd_reg_val(mc_inst_op0(inst))))
        b = bvec_emit_cstr(b, ", ")
        b = bvec_emit_cstr(b, reg_name(mc_opnd_reg_val(mc_inst_op1(inst))))
        b = bvec_emit_cstr(b, ", ")
        b = bvec_emit_cstr(b, reg_name(mc_opnd_reg_val(mc_inst_op2(inst))))
        out bvec_emit_cstr(b, "
")
    end

    if opc == MCOpcode.ARM64_MSUB_RRRR do
        b = bvec_emit_cstr(b, "    msub ")
        b = bvec_emit_cstr(b, reg_name(mc_opnd_reg_val(mc_inst_op0(inst))))
        b = bvec_emit_cstr(b, ", ")
        b = bvec_emit_cstr(b, reg_name(mc_opnd_reg_val(mc_inst_op1(inst))))
        b = bvec_emit_cstr(b, ", ")
        b = bvec_emit_cstr(b, reg_name(mc_opnd_reg_val(mc_inst_op2(inst))))
        b = bvec_emit_cstr(b, ", ")
        b = bvec_emit_cstr(b, reg_name(mc_opnd_reg_val(mc_inst_op3(inst))))
        out bvec_emit_cstr(b, "
")
    end

    if opc == MCOpcode.ARM64_MOV_RR do
        b = bvec_emit_cstr(b, "    mov ")
        b = bvec_emit_cstr(b, reg_name(mc_opnd_reg_val(mc_inst_op0(inst))))
        b = bvec_emit_cstr(b, ", ")
        b = bvec_emit_cstr(b, reg_name(mc_opnd_reg_val(mc_inst_op1(inst))))
        out bvec_emit_cstr(b, "
")
    end

    if opc == MCOpcode.ARM64_MOV_FROM_SP do
        b = bvec_emit_cstr(b, "    mov ")
        b = bvec_emit_cstr(b, reg_name(mc_opnd_reg_val(mc_inst_op0(inst))))
        out bvec_emit_cstr(b, ", sp
")
    end

    if opc == MCOpcode.ARM64_ADD_IMM or opc == MCOpcode.ARM64_SUB_IMM do
        if opc == MCOpcode.ARM64_ADD_IMM do b = bvec_emit_cstr(b, "    add ") else b = bvec_emit_cstr(b, "    sub ") end
        b = bvec_emit_cstr(b, reg_name(mc_opnd_reg_val(mc_inst_op0(inst))))
        b = bvec_emit_cstr(b, ", ")
        b = bvec_emit_cstr(b, reg_name(mc_opnd_reg_val(mc_inst_op1(inst))))
        b = bvec_emit_cstr(b, ", #")
        b = bvec_emit_int(b, mc_opnd_imm_val(mc_inst_op2(inst)))
        out bvec_emit_cstr(b, "
")
    end

    if opc == MCOpcode.ARM64_MOVZ do
        b = bvec_emit_cstr(b, "    mov ")
        b = bvec_emit_cstr(b, reg_name(mc_opnd_reg_val(mc_inst_op0(inst))))
        b = bvec_emit_cstr(b, ", #")
        b = bvec_emit_int(b, mc_opnd_imm_val(mc_inst_op1(inst)))
        out bvec_emit_cstr(b, "
")
    end

    if opc == MCOpcode.ARM64_CMP_RR do
        b = bvec_emit_cstr(b, "    cmp ")
        b = bvec_emit_cstr(b, reg_name(mc_opnd_reg_val(mc_inst_op0(inst))))
        b = bvec_emit_cstr(b, ", ")
        b = bvec_emit_cstr(b, reg_name(mc_opnd_reg_val(mc_inst_op1(inst))))
        out bvec_emit_cstr(b, "
")
    end

    if opc == MCOpcode.ARM64_CMP_IMM0 do
        b = bvec_emit_cstr(b, "    cmp ")
        b = bvec_emit_cstr(b, reg_name(mc_opnd_reg_val(mc_inst_op0(inst))))
        out bvec_emit_cstr(b, ", #0
")
    end

    if opc == MCOpcode.ARM64_CSET_EQ or opc == MCOpcode.ARM64_CSET_NE or opc == MCOpcode.ARM64_CSET_GT or opc == MCOpcode.ARM64_CSET_LT or opc == MCOpcode.ARM64_CSET_GE or opc == MCOpcode.ARM64_CSET_LE do
        b = bvec_emit_cstr(b, "    cset ")
        b = bvec_emit_cstr(b, reg_name(mc_opnd_reg_val(mc_inst_op0(inst))))
        if opc == MCOpcode.ARM64_CSET_EQ do b = bvec_emit_cstr(b, ", eq
") end
        if opc == MCOpcode.ARM64_CSET_NE do b = bvec_emit_cstr(b, ", ne
") end
        if opc == MCOpcode.ARM64_CSET_GT do b = bvec_emit_cstr(b, ", gt
") end
        if opc == MCOpcode.ARM64_CSET_LT do b = bvec_emit_cstr(b, ", lt
") end
        if opc == MCOpcode.ARM64_CSET_GE do b = bvec_emit_cstr(b, ", ge
") end
        if opc == MCOpcode.ARM64_CSET_LE do b = bvec_emit_cstr(b, ", le
") end
        out b
    end

    if opc >= MCOpcode.ARM64_B and opc <= MCOpcode.ARM64_BLE do
        if opc == MCOpcode.ARM64_B   do b = bvec_emit_cstr(b, "    b ") end
        if opc == MCOpcode.ARM64_BEQ do b = bvec_emit_cstr(b, "    b.eq ") end
        if opc == MCOpcode.ARM64_BNE do b = bvec_emit_cstr(b, "    b.ne ") end
        if opc == MCOpcode.ARM64_BGE do b = bvec_emit_cstr(b, "    b.ge ") end
        if opc == MCOpcode.ARM64_BLT do b = bvec_emit_cstr(b, "    b.lt ") end
        if opc == MCOpcode.ARM64_BGT do b = bvec_emit_cstr(b, "    b.gt ") end
        if opc == MCOpcode.ARM64_BLE do b = bvec_emit_cstr(b, "    b.le ") end
        b = append_label(b, mc_opnd_imm_val(mc_inst_op0(inst)), dialect)
        out bvec_emit_cstr(b, "
")
    end

    if opc == MCOpcode.ARM64_BL do
        b = bvec_emit_cstr(b, "    bl ")
        if dialect == AsmDialect.DarwinAsm do
            b = bvec_emit_cstr(b, "_")
        end
        b = bvec_emit_cstr(b, mc_opnd_sym_name(mc_inst_op0(inst)))
        out bvec_emit_cstr(b, "
")
    end

    if opc == MCOpcode.ARM64_BLR do
        b = bvec_emit_cstr(b, "    blr ")
        b = bvec_emit_cstr(b, reg_name(mc_opnd_reg_val(mc_inst_op0(inst))))
        out bvec_emit_cstr(b, "
")
    end

    if opc == MCOpcode.ARM64_RET do
        out bvec_emit_cstr(b, "    ret
")
    end

    if opc == MCOpcode.ARM64_LDR_UOFF or opc == MCOpcode.ARM64_STR_UOFF do
        if opc == MCOpcode.ARM64_LDR_UOFF do b = bvec_emit_cstr(b, "    ldr ") else b = bvec_emit_cstr(b, "    str ") end
        b = bvec_emit_cstr(b, reg_name(mc_opnd_reg_val(mc_inst_op0(inst))))
        b = bvec_emit_cstr(b, ", [")
        let m = mc_inst_op1(inst)
        b = bvec_emit_cstr(b, reg_name(mc_opnd_mem_base(m)))
        let off = mc_opnd_mem_off(m)
        if off != 0 do
            b = bvec_emit_cstr(b, ", #")
            b = bvec_emit_int(b, off)
        end
        b = bvec_emit_cstr(b, "]
")
        out b
    end

    if opc == MCOpcode.ARM64_STP_PRE do
        b = bvec_emit_cstr(b, "    stp ")
        b = bvec_emit_cstr(b, reg_name(mc_opnd_reg_val(mc_inst_op0(inst))))
        b = bvec_emit_cstr(b, ", ")
        b = bvec_emit_cstr(b, reg_name(mc_opnd_reg_val(mc_inst_op1(inst))))
        b = bvec_emit_cstr(b, ", [sp, #-16]!
")
        out b
    end

    if opc == MCOpcode.ARM64_LDP_POST do
        b = bvec_emit_cstr(b, "    ldp ")
        b = bvec_emit_cstr(b, reg_name(mc_opnd_reg_val(mc_inst_op0(inst))))
        b = bvec_emit_cstr(b, ", ")
        b = bvec_emit_cstr(b, reg_name(mc_opnd_reg_val(mc_inst_op1(inst))))
        b = bvec_emit_cstr(b, ", [sp], #16
")
        out b
    end

    if opc == MCOpcode.ARM64_SVC do
        b = bvec_emit_cstr(b, "    svc #")
        b = bvec_emit_int(b, mc_opnd_imm_val(mc_inst_op0(inst)))
        out bvec_emit_cstr(b, "
")
    end

    out b
end.

func print_mc_function_header(func_name: int, dialect: int, b: int):
    b = bvec_emit_cstr(b, "
")
    if dialect == AsmDialect.DarwinAsm do
        b = bvec_emit_cstr(b, ".globl _")
        b = bvec_emit_cstr(b, func_name)
        b = bvec_emit_cstr(b, "
.p2align 2
_")
        b = bvec_emit_cstr(b, func_name)
        b = bvec_emit_cstr(b, ":
")
    else
        b = bvec_emit_cstr(b, ".globl ")
        b = bvec_emit_cstr(b, func_name)
        b = bvec_emit_cstr(b, "
.type ")
        b = bvec_emit_cstr(b, func_name)
        if dialect == AsmDialect.Intel_X86 do
            b = bvec_emit_cstr(b, ", @function
.p2align 4
")
        else
            b = bvec_emit_cstr(b, ", %function
.p2align 2
")
        end
        b = bvec_emit_cstr(b, func_name)
        b = bvec_emit_cstr(b, ":
")
    end
    out b
end.

func print_mc_function_footer(func_name: int, dialect: int, b: int):
    if dialect != AsmDialect.DarwinAsm do
        b = bvec_emit_cstr(b, ".size ")
        b = bvec_emit_cstr(b, func_name)
        b = bvec_emit_cstr(b, ", .-")
        b = bvec_emit_cstr(b, func_name)
        b = bvec_emit_cstr(b, "
")
    end
    out b
end.

func print_mc_assembly_prologue(dialect: int, b: int):
    if dialect == AsmDialect.DarwinAsm do
        b = bvec_emit_cstr(b, "// Target: Darwin ARM64 (Apple clang/Mach-O)
")
        b = bvec_emit_cstr(b, ".section __TEXT,__text,regular,pure_instructions
")
    eif dialect == AsmDialect.Intel_X86 do
        b = bvec_emit_cstr(b, "// Target: Linux x86_64 (Intel syntax / GNU ELF)
")
        b = bvec_emit_cstr(b, ".intel_syntax noprefix
")
        b = bvec_emit_cstr(b, ".text
")
    eif dialect == AsmDialect.GNU_RISCV do
        b = bvec_emit_cstr(b, "# Target: Linux RISC-V 64 (GNU ELF)
")
        b = bvec_emit_cstr(b, ".text
")
    else
        b = bvec_emit_cstr(b, "// Target: Linux ARM64 (GNU ELF)
")
        b = bvec_emit_cstr(b, ".text
")
    end
    out b
end.

func print_mc_runtime_stubs(dialect: int, b: int):
    if dialect == AsmDialect.GNU_RISCV do
        b = bvec_emit_cstr(b, "
# ── Runtime Stubs ──
")
    else
        b = bvec_emit_cstr(b, "
// ── Runtime Stubs ──
")
    end
    if dialect == AsmDialect.DarwinAsm do
        b = bvec_emit_cstr(b, ".globl _rt_exit
.p2align 2
_rt_exit:
")
        b = bvec_emit_cstr(b, "    mov x16, #1
    movk x16, #0x200, lsl #16
    svc #0x80
    ret

")

        b = bvec_emit_cstr(b, ".globl _rt_print_int
.p2align 2
_rt_print_int:
")
        b = bvec_emit_cstr(b, "    sub sp, sp, #128
")
        b = bvec_emit_cstr(b, "    str x1, [sp, #0]
    str x2, [sp, #8]
    str x3, [sp, #16]
")
        b = bvec_emit_cstr(b, "    str x4, [sp, #24]
    str x5, [sp, #32]
    str x6, [sp, #40]
    str x16, [sp, #48]
")
        b = bvec_emit_cstr(b, "    mov x2, #10
    mov x3, #10
    strb w2, [sp, #127]
")
        b = bvec_emit_cstr(b, "    cmp x0, #0
    b.ne 1f
")
        b = bvec_emit_cstr(b, "    mov x2, #48
    strb w2, [sp, #126]
")
        b = bvec_emit_cstr(b, "    mov x0, #1
    add x1, sp, #126
    mov x2, #2
    b 5f
")
        b = bvec_emit_cstr(b, "1:
    add x1, sp, #127
    cmp x0, #0
    cset x4, lt
    cmp x4, #0
    b.eq 2f
    neg x0, x0
")
        b = bvec_emit_cstr(b, "2:
    sdiv x5, x0, x3
    msub x6, x5, x3, x0
    add x6, x6, #48
    sub x1, x1, #1
    strb w6, [x1]
")
        b = bvec_emit_cstr(b, "    mov x0, x5
    cmp x0, #0
    b.ne 2b
")
        b = bvec_emit_cstr(b, "    cmp x4, #0
    b.eq 3f
    mov x6, #45
    sub x1, x1, #1
    strb w6, [x1]
")
        b = bvec_emit_cstr(b, "3:
    mov x2, x1
    add x5, sp, #128
    sub x3, x5, x1
    mov x0, #1
    mov x1, x2
    mov x2, x3
")
        b = bvec_emit_cstr(b, "5:
    mov x16, #4
    movk x16, #0x200, lsl #16
    svc #0x80
")
        b = bvec_emit_cstr(b, "    ldr x1, [sp, #0]
    ldr x2, [sp, #8]
    ldr x3, [sp, #16]
")
        b = bvec_emit_cstr(b, "    ldr x4, [sp, #24]
    ldr x5, [sp, #32]
    ldr x6, [sp, #40]
    ldr x16, [sp, #48]
")
        b = bvec_emit_cstr(b, "    add sp, sp, #128
    ret

")

        b = bvec_emit_cstr(b, ".globl _rt_print_str
.p2align 2
_rt_print_str:
")
        b = bvec_emit_cstr(b, "    stp fp, lr, [sp, #-16]!
    mov fp, sp
    sub sp, sp, #32
")
        b = bvec_emit_cstr(b, "    str x19, [sp, #0]
    str x20, [sp, #8]
    mov x19, x0
    mov x20, #0
")
        b = bvec_emit_cstr(b, "1:
    ldrb w1, [x19, x20]
    cbz w1, 2f
    add x20, x20, #1
    b 1b
")
        b = bvec_emit_cstr(b, "2:
    mov x0, #1
    mov x1, x19
    mov x2, x20
    mov x16, #4
    movk x16, #0x200, lsl #16
    svc #0x80
")
        b = bvec_emit_cstr(b, "    ldr x19, [sp, #0]
    ldr x20, [sp, #8]
    add sp, sp, #32
    ldp fp, lr, [sp], #16
    ret
")
    eif dialect == AsmDialect.Intel_X86 do
        b = bvec_emit_cstr(b, ".globl rt_exit
.type rt_exit, @function
.p2align 4
rt_exit:
")
        b = bvec_emit_cstr(b, "    mov eax, 60
    syscall
    ret
.size rt_exit, .-rt_exit

")

        b = bvec_emit_cstr(b, ".globl rt_print_int
.type rt_print_int, @function
.p2align 4
rt_print_int:
")
        b = bvec_emit_cstr(b, "    push rbp
    mov rbp, rsp
    sub rsp, 128
")
        b = bvec_emit_cstr(b, "    mov [rsp+0], rsi
    mov [rsp+8], rdx
    mov [rsp+16], rcx
")
        b = bvec_emit_cstr(b, "    mov [rsp+24], r8
    mov [rsp+32], r9
    mov [rsp+40], r10
")
        b = bvec_emit_cstr(b, "    mov byte ptr [rsp+127], 10
")
        b = bvec_emit_cstr(b, "    cmp rdi, 0
    jne .L_p_nz
")
        b = bvec_emit_cstr(b, "    mov byte ptr [rsp+126], 48
    mov eax, 1
    mov edi, 1
    lea rsi, [rsp+126]
    mov edx, 2
    syscall
    jmp .L_p_done
")
        b = bvec_emit_cstr(b, ".L_p_nz:
    mov rax, rdi
    xor r8d, r8d
    test rax, rax
    jns .L_p_loop
    inc r8d
    neg rax
")
        b = bvec_emit_cstr(b, ".L_p_loop:
    lea rsi, [rsp+127]
    mov rcx, 10
")
        b = bvec_emit_cstr(b, ".L_p_div:
    dec rsi
    xor edx, edx
    div rcx
    add dl, 48
    mov [rsi], dl
    test rax, rax
    jnz .L_p_div
")
        b = bvec_emit_cstr(b, "    test r8d, r8d
    jz .L_p_wr
    dec rsi
    mov byte ptr [rsi], 45
")
        b = bvec_emit_cstr(b, ".L_p_wr:
    lea rdx, [rsp+128]
    sub rdx, rsi
    mov eax, 1
    mov edi, 1
    syscall
")
        b = bvec_emit_cstr(b, ".L_p_done:
    mov rsi, [rsp+0]
    mov rdx, [rsp+8]
    mov rcx, [rsp+16]
    mov r8, [rsp+24]
    mov r9, [rsp+32]
    mov r10, [rsp+40]
")
        b = bvec_emit_cstr(b, "    mov rsp, rbp
    pop rbp
    ret
.size rt_print_int, .-rt_print_int

")

        b = bvec_emit_cstr(b, ".globl rt_print_str
.type rt_print_str, @function
.p2align 4
rt_print_str:
")
        b = bvec_emit_cstr(b, "    push rbp
    mov rbp, rsp
    sub rsp, 32
")
        b = bvec_emit_cstr(b, "    mov [rsp+0], rsi
    mov [rsp+8], rdx
    mov rsi, rdi
    xor edx, edx
")
        b = bvec_emit_cstr(b, ".L_ps_1:
    cmp byte ptr [rsi+rdx], 0
    je .L_ps_2
    inc rdx
    jmp .L_ps_1
")
        b = bvec_emit_cstr(b, ".L_ps_2:
    mov eax, 1
    mov edi, 1
    syscall
")
        b = bvec_emit_cstr(b, "    mov rsi, [rsp+0]
    mov rdx, [rsp+8]
    mov rsp, rbp
    pop rbp
    ret
.size rt_print_str, .-rt_print_str
")
    eif dialect == AsmDialect.GNU_RISCV do
        b = bvec_emit_cstr(b, ".globl rt_exit
.type rt_exit, %function
.p2align 2
rt_exit:
")
        b = bvec_emit_cstr(b, "    li a7, 93
    ecall
    ret
.size rt_exit, .-rt_exit

")

        b = bvec_emit_cstr(b, ".globl rt_print_int
.type rt_print_int, %function
.p2align 2
rt_print_int:
")
        b = bvec_emit_cstr(b, "    addi sp, sp, -128
")
        b = bvec_emit_cstr(b, "    sd a1, 0(sp)
    sd a2, 8(sp)
    sd a3, 16(sp)
    sd a7, 24(sp)
    sd s0, 32(sp)
    sd s1, 40(sp)
")
        b = bvec_emit_cstr(b, "    li a1, 10
    addi a2, sp, 127
    sb a1, 0(a2)
")
        b = bvec_emit_cstr(b, "    bnez a0, .L_rv_nz
    li a1, 48
    addi a2, sp, 126
    sb a1, 0(a2)
")
        b = bvec_emit_cstr(b, "    li a7, 64
    li a0, 1
    mv a1, a2
    li a2, 2
    ecall
    j .L_rv_done
")
        b = bvec_emit_cstr(b, ".L_rv_nz:
    li s1, 0
    bge a0, zero, .L_rv_pos
    li s1, 1
    neg a0, a0
")
        b = bvec_emit_cstr(b, ".L_rv_pos:
    li a3, 10
    addi a1, sp, 127
")
        b = bvec_emit_cstr(b, ".L_rv_loop:
    rem a2, a0, a3
    div a0, a0, a3
    addi a2, a2, 48
    addi a1, a1, -1
    sb a2, 0(a1)
    bnez a0, .L_rv_loop
")
        b = bvec_emit_cstr(b, "    beqz s1, .L_rv_write
    li a2, 45
    addi a1, a1, -1
    sb a2, 0(a1)
")
        b = bvec_emit_cstr(b, ".L_rv_write:
    addi a2, sp, 128
    sub a2, a2, a1
    li a7, 64
    li a0, 1
    ecall
")
        b = bvec_emit_cstr(b, ".L_rv_done:
