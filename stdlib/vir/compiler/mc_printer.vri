# Emits literal data after code/runtime sections. Byte directives avoid quoting
# and escaping differences between Darwin, GNU x86-64 and GNU RISC-V assemblers.
func print_mc_string_pool(lir_funcs: int, dialect: int, b: int):
    if dialect == AsmDialect.DarwinAsm do
        b = bvec_emit_cstr(b, "\n.section __TEXT,__cstring,cstring_literals\n")
    else
        b = bvec_emit_cstr(b, "\n.section .rodata\n")
    end
    var fi = 0
    let nf = vec_len_rt(lir_funcs)
    when fi < nf loop
        let f = vec_get_rt(lir_funcs, fi) as LirFunc
        let strings = lir_func_strings(f)
        let ns = vec_len_rt(strings)
        var sid = 0
        when sid < ns loop
            let s = vec_get_rt(strings, sid)
            b = append_string_label(b, lir_func_id(f), sid)
            b = bvec_emit_cstr(b, ":\n    .byte ")
            let nbytes = fat_str_len(s)
            var bi = 0
            when bi < nbytes loop
                if bi > 0 do b = bvec_emit_cstr(b, ", ") end
                b = bvec_emit_int(b, fat_str_byte_at(s, bi))
                bi = bi + 1
            end
            if nbytes > 0 do b = bvec_emit_cstr(b, ", ") end
            b = bvec_emit_cstr(b, "0\n")
            sid = sid + 1
        end
        fi = fi + 1
    end
    out b
end.

export print_mc_inst, print_mc_function_header, print_mc_function_footer, print_mc_assembly_prologue, print_mc_runtime_stubs, print_mc_string_pool
