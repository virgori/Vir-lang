func emit_lir_rt_quantize_stub_x86(cb: CodeBuf):
    cb = x86_emit_push(cb, X86_RBX)
    cb = x86_emit_push(cb, X86_R12)
    cb = x86_emit_push(cb, X86_R13)
    cb = x86_emit_push(cb, X86_R14)

    cb = x86_emit_mov_rr(cb, X86_R12, X86_RDI)
    cb = x86_emit_mov_rr(cb, X86_R13, X86_RSI)
    cb = x86_emit_mov_reg_mem(cb, X86_R14, X86_R12, 0)

    cb = x86_emit_cmp_reg_imm32(cb, X86_R14, 0)
    cb = x86_emit_jle_rel32(cb, 0)
    let fixup_ret_zero = codebuf_offset(cb) as int

    cb = x86_emit_mov_reg_imm32(cb, X86_RBX, 127)
    cb = x86_emit_cmp_reg_imm32(cb, X86_R13, 4)
    cb = x86_emit_jne_rel32(cb, 0)
    let fixup_not_4 = codebuf_offset(cb) as int
    cb = x86_emit_mov_reg_imm32(cb, X86_RBX, 7)
    let qmax_pos = codebuf_offset(cb) as int
    cb = patch_rel32(cb, fixup_not_4 - 4, qmax_pos)

    cb = x86_emit_xor_rr(cb, X86_R8, X86_R8)
    cb = x86_emit_xor_rr(cb, X86_RCX, X86_RCX)

    let loop_scale_start = codebuf_offset(cb) as int
    cb = x86_emit_cmp_rr(cb, X86_RCX, X86_R14)
    cb = x86_emit_jge_rel32(cb, 0)
    let fixup_scale_exit = codebuf_offset(cb) as int

    cb = x86_emit_mov_rr(cb, X86_RDI, X86_RCX)
    cb = x86_emit_shl_imm(cb, X86_RDI, 3)
    cb = x86_emit_add_rr(cb, X86_RDI, X86_R12)
    cb = x86_emit_mov_reg_imm32(cb, X86_RAX, 16)
    cb = x86_emit_add_rr(cb, X86_RDI, X86_RAX)

    cb = x86_emit_mov_reg_mem(cb, X86_RAX, X86_RDI, 0)

    cb = x86_emit_mov_rr(cb, X86_RDX, X86_RAX)
    cb = x86_emit_shr_imm(cb, X86_RDX, 52)
    cb = codebuf_emit_byte(cb, 0x48)
    cb = codebuf_emit_byte(cb, 0x81)
    cb = codebuf_emit_byte(cb, 0xE2)
    cb = codebuf_emit_byte(cb, 0xFF)
    cb = codebuf_emit_byte(cb, 0x07)
    cb = codebuf_emit_byte(cb, 0x00)
    cb = codebuf_emit_byte(cb, 0x00)
    cb = x86_emit_test_rr(cb, X86_RDX, X86_RDX)
    cb = x86_emit_je_rel32(cb, 0)
    let fixup_exp0 = codebuf_offset(cb) as int
    cb = x86_emit_cmp_reg_imm32(cb, X86_RDX, 2047)
    cb = x86_emit_je_rel32(cb, 0)
    let fixup_exp2047 = codebuf_offset(cb) as int

    cb = codebuf_emit_byte(cb, 0xF2)
    cb = codebuf_emit_byte(cb, 0x48)
    cb = codebuf_emit_byte(cb, 0x0F)
    cb = codebuf_emit_byte(cb, 0x2C)
    cb = codebuf_emit_byte(cb, 0x07)

    let int_val_pos = codebuf_offset(cb) as int
    cb = patch_rel32(cb, fixup_exp0 - 4, int_val_pos)
    cb = patch_rel32(cb, fixup_exp2047 - 4, int_val_pos)

    cb = x86_emit_cmp_reg_imm32(cb, X86_RAX, 0)
    cb = x86_emit_jge_rel32(cb, 0)
    let fixup_non_neg = codebuf_offset(cb) as int
    cb = x86_emit_neg_r(cb, X86_RAX)
    let abs_done_pos = codebuf_offset(cb) as int
    cb = patch_rel32(cb, fixup_non_neg - 4, abs_done_pos)

    cb = x86_emit_cmp_rr(cb, X86_RAX, X86_R8)
    cb = x86_emit_jle_rel32(cb, 0)
    let fixup_not_max = codebuf_offset(cb) as int
    cb = x86_emit_mov_rr(cb, X86_R8, X86_RAX)
    let max_done_pos = codebuf_offset(cb) as int
    cb = patch_rel32(cb, fixup_not_max - 4, max_done_pos)

    cb = x86_emit_mov_reg_imm32(cb, X86_RAX, 1)
    cb = x86_emit_add_rr(cb, X86_RCX, X86_RAX)
    cb = x86_emit_jmp_rel32(cb, 0)
    let fixup_scale_loop = codebuf_offset(cb) as int
    cb = patch_rel32(cb, fixup_scale_loop - 4, loop_scale_start)

    let scale_done_pos = codebuf_offset(cb) as int
    cb = patch_rel32(cb, fixup_scale_exit - 4, scale_done_pos)

    cb = x86_emit_cmp_rr(cb, X86_R8, X86_RBX)
    cb = x86_emit_jle_rel32(cb, 0)
    let fixup_scale_1 = codebuf_offset(cb) as int

    cb = x86_emit_mov_rr(cb, X86_RAX, X86_R8)
    cb = x86_emit_add_rr(cb, X86_RAX, X86_RBX)
    cb = x86_emit_mov_reg_imm32(cb, X86_RDX, 1)
    cb = x86_emit_sub_rr(cb, X86_RAX, X86_RDX)
    cb = x86_emit_cqo(cb)
    cb = x86_emit_idiv(cb, X86_RBX)
    cb = x86_emit_mov_rr(cb, X86_R8, X86_RAX)
    cb = x86_emit_jmp_rel32(cb, 0)
    let fixup_scale_calc_done = codebuf_offset(cb) as int

    let scale_1_pos = codebuf_offset(cb) as int
    cb = patch_rel32(cb, fixup_scale_1 - 4, scale_1_pos)
    cb = x86_emit_mov_reg_imm32(cb, X86_R8, 1)
    let scale_final_pos = codebuf_offset(cb) as int
    cb = patch_rel32(cb, fixup_scale_calc_done - 4, scale_final_pos)

    cb = x86_emit_mov_rr(cb, X86_RAX, X86_R14)
    cb = x86_emit_cmp_reg_imm32(cb, X86_R13, 4)
    cb = x86_emit_jne_rel32(cb, 0)
    let fixup_alloc_not4 = codebuf_offset(cb) as int
    cb = x86_emit_mov_reg_imm32(cb, X86_RDX, 1)
    cb = x86_emit_add_rr(cb, X86_RAX, X86_RDX)
    cb = x86_emit_shr_imm(cb, X86_RAX, 1)
    let alloc_p_pos = codebuf_offset(cb) as int
    cb = patch_rel32(cb, fixup_alloc_not4 - 4, alloc_p_pos)

    cb = x86_emit_mov_reg_imm32(cb, X86_RDX, 47)
    cb = x86_emit_add_rr(cb, X86_RAX, X86_RDX)
    cb = x86_emit_mov_reg_imm32(cb, X86_RDX, 0 - 16)
    cb = x86_emit_and_rr(cb, X86_RAX, X86_RDX)

    cb = x86_emit_mov_reg_mem(cb, X86_RDI, X86_R15, 0)
    cb = x86_emit_mov_rr(cb, X86_RDX, X86_RDI)
    cb = x86_emit_add_rr(cb, X86_RDX, X86_RAX)
    cb = x86_emit_mov_mem_reg(cb, X86_R15, 0, X86_RDX)

    cb = x86_emit_mov_mem_reg(cb, X86_RDI, 0, X86_R14)
    cb = x86_emit_mov_mem_reg(cb, X86_RDI, 8, X86_R13)
    cb = x86_emit_mov_mem_reg(cb, X86_RDI, 16, X86_R8)
    cb = x86_emit_xor_rr(cb, X86_RAX, X86_RAX)
    cb = x86_emit_mov_mem_reg(cb, X86_RDI, 24, X86_RAX)

    cb = x86_emit_push(cb, X86_RDI)

    cb = x86_emit_mov_rr(cb, X86_RSI, X86_RDI)
    cb = x86_emit_mov_reg_imm32(cb, X86_RAX, 32)
    cb = x86_emit_add_rr(cb, X86_RSI, X86_RAX)

    cb = x86_emit_xor_rr(cb, X86_RCX, X86_RCX)

    let loop_pack_start = codebuf_offset(cb) as int
    cb = x86_emit_cmp_rr(cb, X86_RCX, X86_R14)
    cb = x86_emit_jge_rel32(cb, 0)
    let fixup_pack_exit = codebuf_offset(cb) as int

    cb = x86_emit_mov_rr(cb, X86_RDI, X86_RCX)
    cb = x86_emit_shl_imm(cb, X86_RDI, 3)
    cb = x86_emit_add_rr(cb, X86_RDI, X86_R12)
    cb = x86_emit_mov_reg_imm32(cb, X86_RAX, 16)
    cb = x86_emit_add_rr(cb, X86_RDI, X86_RAX)

    cb = x86_emit_mov_reg_mem(cb, X86_RAX, X86_RDI, 0)

    cb = x86_emit_mov_rr(cb, X86_RDX, X86_RAX)
    cb = x86_emit_shr_imm(cb, X86_RDX, 52)
    cb = codebuf_emit_byte(cb, 0x48)
    cb = codebuf_emit_byte(cb, 0x81)
    cb = codebuf_emit_byte(cb, 0xE2)
    cb = codebuf_emit_byte(cb, 0xFF)
    cb = codebuf_emit_byte(cb, 0x07)
    cb = codebuf_emit_byte(cb, 0x00)
    cb = codebuf_emit_byte(cb, 0x00)
    cb = x86_emit_test_rr(cb, X86_RDX, X86_RDX)
    cb = x86_emit_je_rel32(cb, 0)
    let fixup_pexp0 = codebuf_offset(cb) as int
    cb = x86_emit_cmp_reg_imm32(cb, X86_RDX, 2047)
    cb = x86_emit_je_rel32(cb, 0)
    let fixup_pexp2047 = codebuf_offset(cb) as int

    cb = codebuf_emit_byte(cb, 0xF2)
    cb = codebuf_emit_byte(cb, 0x48)
    cb = codebuf_emit_byte(cb, 0x0F)
    cb = codebuf_emit_byte(cb, 0x2C)
    cb = codebuf_emit_byte(cb, 0x07)

    let pint_val_pos = codebuf_offset(cb) as int
    cb = patch_rel32(cb, fixup_pexp0 - 4, pint_val_pos)
    cb = patch_rel32(cb, fixup_pexp2047 - 4, pint_val_pos)

    cb = x86_emit_cqo(cb)
    cb = x86_emit_idiv(cb, X86_R8)

    cb = x86_emit_cmp_rr(cb, X86_RAX, X86_RBX)
    cb = x86_emit_jle_rel32(cb, 0)
    let fixup_clamp_up = codebuf_offset(cb) as int
    cb = x86_emit_mov_rr(cb, X86_RAX, X86_RBX)
    let clamp_up_pos = codebuf_offset(cb) as int
    cb = patch_rel32(cb, fixup_clamp_up - 4, clamp_up_pos)

    cb = x86_emit_mov_rr(cb, X86_RDX, X86_RBX)
    cb = x86_emit_neg_r(cb, X86_RDX)
    cb = x86_emit_cmp_rr(cb, X86_RAX, X86_RDX)
    cb = x86_emit_jge_rel32(cb, 0)
    let fixup_clamp_lo = codebuf_offset(cb) as int
    cb = x86_emit_mov_rr(cb, X86_RAX, X86_RDX)
    let clamp_lo_pos = codebuf_offset(cb) as int
    cb = patch_rel32(cb, fixup_clamp_lo - 4, clamp_lo_pos)

    cb = x86_emit_cmp_reg_imm32(cb, X86_R13, 4)
    cb = x86_emit_je_rel32(cb, 0)
    let fixup_is_pack4 = codebuf_offset(cb) as int

    cb = x86_emit_mov_rr(cb, X86_RDI, X86_RSI)
    cb = x86_emit_add_rr(cb, X86_RDI, X86_RCX)
    cb = codebuf_emit_byte(cb, 0x88)
    cb = codebuf_emit_byte(cb, 0x07)
    cb = x86_emit_jmp_rel32(cb, 0)
    let fixup_p8_step_done = codebuf_offset(cb) as int

    let pack4_step_pos = codebuf_offset(cb) as int
    cb = patch_rel32(cb, fixup_is_pack4 - 4, pack4_step_pos)

    cb = x86_emit_mov_reg_imm32(cb, X86_RDX, 15)
    cb = x86_emit_and_rr(cb, X86_RAX, X86_RDX)

    cb = x86_emit_mov_rr(cb, X86_RDI, X86_RCX)
    cb = x86_emit_shr_imm(cb, X86_RDI, 1)
    cb = x86_emit_add_rr(cb, X86_RDI, X86_RSI)

    cb = x86_emit_mov_rr(cb, X86_RDX, X86_RCX)
    cb = x86_emit_mov_reg_imm32(cb, SCR as int, 1)
    cb = x86_emit_and_rr(cb, X86_RDX, SCR as int)
    cb = x86_emit_test_rr(cb, X86_RDX, X86_RDX)
    cb = x86_emit_jne_rel32(cb, 0)
    let fixup_odd = codebuf_offset(cb) as int

    cb = codebuf_emit_byte(cb, 0x88)
    cb = codebuf_emit_byte(cb, 0x07)
    cb = x86_emit_jmp_rel32(cb, 0)
    let fixup_even_done = codebuf_offset(cb) as int

    let odd_pos = codebuf_offset(cb) as int
    cb = patch_rel32(cb, fixup_odd - 4, odd_pos)
    cb = codebuf_emit_byte(cb, 0x48)
    cb = codebuf_emit_byte(cb, 0x0F)
    cb = codebuf_emit_byte(cb, 0xB6)
    cb = codebuf_emit_byte(cb, 0x17)
    cb = x86_emit_shl_imm(cb, X86_RAX, 4)
    cb = x86_emit_or_rr(cb, X86_RDX, X86_RAX)
    cb = codebuf_emit_byte(cb, 0x88)
    cb = codebuf_emit_byte(cb, 0x17)

    let even_done_pos = codebuf_offset(cb) as int
    cb = patch_rel32(cb, fixup_even_done - 4, even_done_pos)

    let p8_step_done_pos = codebuf_offset(cb) as int
    cb = patch_rel32(cb, fixup_p8_step_done - 4, p8_step_done_pos)

    cb = x86_emit_mov_reg_imm32(cb, X86_RAX, 1)
    cb = x86_emit_add_rr(cb, X86_RCX, X86_RAX)
    cb = x86_emit_jmp_rel32(cb, 0)
    let fixup_pack_back = codebuf_offset(cb) as int
    cb = patch_rel32(cb, fixup_pack_back - 4, loop_pack_start)

    let pack_exit_pos = codebuf_offset(cb) as int
    cb = patch_rel32(cb, fixup_pack_exit - 4, pack_exit_pos)

    cb = x86_emit_pop(cb, X86_RAX)
    cb = x86_emit_pop(cb, X86_R14)
    cb = x86_emit_pop(cb, X86_R13)
    cb = x86_emit_pop(cb, X86_R12)
    cb = x86_emit_pop(cb, X86_RBX)
    cb = x86_emit_ret(cb)

    let ret_zero_pos = codebuf_offset(cb) as int
    cb = patch_rel32(cb, fixup_ret_zero - 4, ret_zero_pos)
    cb = x86_emit_xor_rr(cb, X86_RAX, X86_RAX)
    cb = x86_emit_pop(cb, X86_R14)
    cb = x86_emit_pop(cb, X86_R13)
    cb = x86_emit_pop(cb, X86_R12)
    cb = x86_emit_pop(cb, X86_RBX)
    out x86_emit_ret(cb)
end.

func emit_lir_rt_stubs_x86(cb: CodeBuf, offs: i64):
    var k = 0
    when k < LIR_RT_STUB_COUNT loop
        offs = vec_push_rt(offs, codebuf_offset(cb) as i64)
        if k == LIR_RT_UNRESOLVED do
            cb = x86_emit_mov_reg_imm64(cb, X86_RDI, 1)
            cb = x86_emit_mov_reg_imm64(cb, X86_RAX, X86_SYS_EXIT)
            cb = x86_emit_syscall(cb)
        eif k == MIR_INTR_PRINT do
            cb = emit_lir_rt_print_stub_x86(cb)
        eif k == LIR_RT_PRINT_STR do
            # RDI = string pointer. Save to RSI and RCX
            cb = x86_emit_mov_rr(cb, X86_RSI, X86_RDI)
            cb = x86_emit_mov_rr(cb, X86_RCX, X86_RDI)
            # Count length in bytes until null terminator
            cb = codebuf_emit_byte(cb, 0x80)
            cb = codebuf_emit_byte(cb, 0x39)
            cb = codebuf_emit_byte(cb, 0x00)
            cb = codebuf_emit_byte(cb, 0x74)
            cb = codebuf_emit_byte(cb, 0x05)
            cb = codebuf_emit_byte(cb, 0x48)
            cb = codebuf_emit_byte(cb, 0xFF)
            cb = codebuf_emit_byte(cb, 0xC1)
            cb = codebuf_emit_byte(cb, 0xEB)
            cb = codebuf_emit_byte(cb, 0xF6)
            # RDX = len = RCX - RSI
            cb = x86_emit_mov_rr(cb, X86_RDX, X86_RCX)
            cb = x86_emit_sub_rr(cb, X86_RDX, X86_RSI)
            cb = x86_emit_mov_reg_imm64(cb, X86_RAX, X86_SYS_WRITE)
            cb = x86_emit_mov_reg_imm64(cb, X86_RDI, 1)
            cb = x86_emit_syscall(cb)
            # Emit newline \n:
            cb = codebuf_emit_byte(cb, 0x6A)
            cb = codebuf_emit_byte(cb, 0x0A)
            cb = x86_emit_mov_rr(cb, X86_RSI, X86_RSP)
            cb = x86_emit_mov_reg_imm64(cb, X86_RDX, 1)
            cb = x86_emit_mov_reg_imm64(cb, X86_RDI, 1)
            cb = x86_emit_mov_reg_imm64(cb, X86_RAX, X86_SYS_WRITE)
            cb = x86_emit_syscall(cb)
            cb = x86_emit_pop(cb, SCR as int)
            cb = x86_emit_ret(cb)
        eif k == LIR_RT_ALLOC do
            # RDI = requested size, R15 = pointer to bump_curr
            cb = x86_emit_mov_reg_mem(cb, X86_RAX, X86_R15, 0)
            cb = x86_emit_mov_rr(cb, X86_RSI, X86_RDI)
            cb = x86_emit_mov_reg_imm32(cb, SCR as int, 7)
            cb = x86_emit_add_rr(cb, X86_RSI, SCR as int)
            cb = x86_emit_mov_reg_imm32(cb, SCR as int, 0 - 8)
            cb = x86_emit_and_rr(cb, X86_RSI, SCR as int)
            cb = x86_emit_add_rr(cb, X86_RSI, X86_RAX)
            cb = x86_emit_mov_mem_reg(cb, X86_R15, 0, X86_RSI)
            cb = x86_emit_ret(cb)
        eif k == LIR_RT_NATIVE_READ_I64 do
            cb = x86_emit_add_rr(cb, X86_RDI, X86_RSI)
            cb = x86_emit_mov_reg_mem(cb, X86_RAX, X86_RDI, 0)
            cb = x86_emit_ret(cb)
        eif k == LIR_RT_NATIVE_WRITE_I64 do
            cb = x86_emit_add_rr(cb, X86_RDI, X86_RSI)
            cb = x86_emit_mov_mem_reg(cb, X86_RDI, 0, X86_RDX)
            cb = x86_emit_ret(cb)
        eif k == LIR_RT_NATIVE_READ_U8 do
            cb = x86_emit_add_rr(cb, X86_RDI, X86_RSI)
            cb = x86_emit_xor_rr(cb, X86_RAX, X86_RAX)
            cb = codebuf_emit_byte(cb, 0x0F)
            cb = codebuf_emit_byte(cb, 0xB6)
            cb = codebuf_emit_byte(cb, 0x07)
            cb = x86_emit_ret(cb)
        eif k == LIR_RT_NATIVE_WRITE_U8 do
            cb = x86_emit_add_rr(cb, X86_RDI, X86_RSI)
            cb = codebuf_emit_byte(cb, 0x88)
            cb = codebuf_emit_byte(cb, 0x17)
            cb = x86_emit_ret(cb)
        eif k == LIR_RT_MATMUL or k == LIR_RT_FMA do
            cb = emit_lir_rt_tensor_dot_stub_x86(cb)
        eif k == LIR_RT_STR_CAT do
            cb = emit_lir_rt_str_cat_stub_x86(cb)
        eif k == LIR_RT_INT_TO_STR do
            cb = emit_lir_rt_int_to_str_stub_x86(cb)
        eif k == LIR_RT_POW do
            cb = x86_emit_xor_rr(cb, X86_RAX, X86_RAX)
            cb = x86_emit_ret(cb)
        eif k == LIR_RT_QUANTIZE do
            cb = emit_lir_rt_quantize_stub_x86(cb)
        eif k == LIR_RT_BACKWARD do
            cb = emit_lir_rt_backward_stub_x86(cb)
        eif k == LIR_RT_MATMUL_F64 or k == LIR_RT_FMA_F64 do
            # x86 f64 matmul: delegate to integer stub for now (elements stored as 8-byte int64)
            cb = emit_lir_rt_tensor_dot_stub_x86(cb)
        else
            cb = x86_emit_ret(cb)
        end
        k = k + 1
    end
    out cb
end.

func emit_callee_save_x86(cb: CodeBuf):
    cb = x86_emit_push(cb, X86_RBX)
    cb = x86_emit_push(cb, X86_R12)
    cb = x86_emit_push(cb, X86_R13)
    out x86_emit_push(cb, X86_R14)
end.

func emit_callee_restore_x86(cb: CodeBuf):
    cb = x86_emit_pop(cb, X86_R14)
    cb = x86_emit_pop(cb, X86_R13)
    cb = x86_emit_pop(cb, X86_R12)
    out x86_emit_pop(cb, X86_RBX)
end.

func emit_lir_x86_into(cb: CodeBuf, func_obj: LirFunc, assigned_phys: i64, lir_funcs: i64, call_fixups: i64, str_fixups: i64):
    cb = x86_emit_push(cb, X86_RBP)
    cb = x86_emit_mov_rr(cb, X86_RBP, X86_RSP)
    cb = emit_callee_save_x86(cb)

    stack_size = lir_func_stack_size(func_obj)
    if (stack_size mod 16) != 0 do
        stack_size = stack_size + (16 - (stack_size mod 16))
    end
    if stack_size > 0 do
        cb = x86_emit_sub_rsp_imm(cb, stack_size as int)
    end

    f_blocks = native_read_i64(func_obj as i64, 16)
    n_blocks = vec_len_rt(f_blocks)
    var max_bid = n_blocks
    var bi = 0
    when bi < n_blocks loop
        b = vec_get_rt(f_blocks, bi)
        bid = native_read_i64(b as i64, 0)
        if bid >= max_bid do
            max_bid = bid + 1
        end
        bi = bi + 1
    end
    block_off = vec_new_cap_rt_x86(1024)
    bi = 0
    when bi < max_bid loop
        block_off = vec_push_rt(block_off, 0 - 1)
        bi = bi + 1
    end
    fixups = vec_new_cap_rt_x86(1024)
    var pending_stk = 0

    bi = 0
    when bi < n_blocks loop
        b = vec_get_rt(f_blocks, bi)
        bid = native_read_i64(b as i64, 0)
        vec_set_rt(block_off, bid, codebuf_offset(cb) as i64)
        instrs = native_read_i64(b as i64, 8)
        n_instrs = vec_len_rt(instrs)
        var ii = 0
        when ii < n_instrs loop
            ins = vec_get_rt(instrs, ii)
            op = native_read_i64(ins as i64, 0)
            ins_dst = native_read_i64(ins as i64, 16)
            ins_src1 = native_read_i64(ins as i64, 24)
            ins_src2 = native_read_i64(ins as i64, 32)
            ins_aux = native_read_i64(ins as i64, 40)
            rd = resolve_reg_x86(ins_dst, assigned_phys)
            rs1 = resolve_reg_x86(ins_src1, assigned_phys)
            rs2 = resolve_reg_x86(ins_src2, assigned_phys)

            if op == LirOp.Nop do
                cb = x86_emit_nop(cb)
            eif op == LirOp.Mov do
                if (ins_src1 as i64) != 0 do
                    src1_typ = native_read_i64(ins_src1 as i64, 0)
                    if src1_typ == 5 do # Imm
                        imm_val = native_read_i64(ins_src1 as i64, 32)
                        if rd >= 0 do
                            cb = x86_emit_mov_reg_imm64(cb, rd as int, imm_val as int)
                        end
                    eif src1_typ == 4 do # StackMem reload
                        off = native_read_i64(ins_src1 as i64, 24)
                        if rd >= 0 and off < 0 do
                            cb = x86_emit_mov_reg_imm32(cb, SCR as int, off as int)
                            cb = x86_emit_add_rr(cb, SCR as int, X86_RBP)
                            cb = x86_emit_mov_reg_mem(cb, rd as int, SCR as int, 0)
                        end
                    eif rd >= 0 and rs1 >= 0 do
                        if rd != rs1 do
                            cb = x86_emit_mov_rr(cb, rd as int, rs1 as int)
                        end
                    end
                end
                if (ins_dst as i64) != 0 do
                    dst_typ = native_read_i64(ins_dst as i64, 0)
                    if dst_typ == 4 do # StackMem spill store
                        off_d = native_read_i64(ins_dst as i64, 24)
                        if off_d < 0 and rs1 >= 0 do
                            cb = x86_emit_mov_reg_imm32(cb, SCR as int, off_d as int)
                            cb = x86_emit_add_rr(cb, SCR as int, X86_RBP)
                            cb = x86_emit_mov_mem_reg(cb, SCR as int, 0, rs1 as int)
                        end
                    end
                end
            eif op == LirOp.Add do
                a = resolve_or_imm_reg_x86(cb, ins_src1, assigned_phys, SCR)
                breg = resolve_or_imm_reg_x86(cb, ins_src2, assigned_phys, SCR2)
                if rd >= 0 and a >= 0 and breg >= 0 do
                    cb = x86_emit_mov_rr(cb, rd as int, a as int)
                    cb = x86_emit_add_rr(cb, rd as int, breg as int)
                end
            eif op == LirOp.Sub do
                a = resolve_or_imm_reg_x86(cb, ins_src1, assigned_phys, SCR)
                breg = resolve_or_imm_reg_x86(cb, ins_src2, assigned_phys, SCR2)
                if rd >= 0 and a >= 0 and breg >= 0 do
                    cb = x86_emit_mov_rr(cb, rd as int, a as int)
                    cb = x86_emit_sub_rr(cb, rd as int, breg as int)
                end
            eif op == LirOp.Mul do
                a = resolve_or_imm_reg_x86(cb, ins_src1, assigned_phys, SCR)
                breg = resolve_or_imm_reg_x86(cb, ins_src2, assigned_phys, SCR2)
                if rd >= 0 and a >= 0 and breg >= 0 do
                    cb = x86_emit_mov_rr(cb, rd as int, a as int)
                    cb = x86_emit_imul_rr(cb, rd as int, breg as int)
                end
            eif op == LirOp.Div do
                a = resolve_or_imm_reg_x86(cb, ins_src1, assigned_phys, SCR)
                breg = resolve_or_imm_reg_x86(cb, ins_src2, assigned_phys, SCR2)
                if rd >= 0 and a >= 0 and breg >= 0 do
                    cb = x86_emit_mov_rr(cb, X86_RAX, a as int)
                    cb = x86_emit_cqo(cb)
                    cb = x86_emit_idiv(cb, breg as int)
                    if rd != X86_RAX do
                        cb = x86_emit_mov_rr(cb, rd as int, X86_RAX)
                    end
                end
            eif op == LirOp.Rem do
                a = resolve_or_imm_reg_x86(cb, ins_src1, assigned_phys, SCR)
                breg = resolve_or_imm_reg_x86(cb, ins_src2, assigned_phys, SCR2)
                if rd >= 0 and a >= 0 and breg >= 0 do
                    cb = x86_emit_mov_rr(cb, X86_RAX, a as int)
                    cb = x86_emit_cqo(cb)
                    cb = x86_emit_idiv(cb, breg as int)
                    if rd != X86_RDX do
                        cb = x86_emit_mov_rr(cb, rd as int, X86_RDX)
                    end
                end
            eif op == LirOp.And do
                a = resolve_or_imm_reg_x86(cb, ins_src1, assigned_phys, SCR)
                breg = resolve_or_imm_reg_x86(cb, ins_src2, assigned_phys, SCR2)
                if rd >= 0 and a >= 0 and breg >= 0 do
                    cb = x86_emit_mov_rr(cb, rd as int, a as int)
                    cb = x86_emit_and_rr(cb, rd as int, breg as int)
                end
            eif op == LirOp.Or do
                a = resolve_or_imm_reg_x86(cb, ins_src1, assigned_phys, SCR)
                breg = resolve_or_imm_reg_x86(cb, ins_src2, assigned_phys, SCR2)
                if rd >= 0 and a >= 0 and breg >= 0 do
                    cb = x86_emit_mov_rr(cb, rd as int, a as int)
                    cb = x86_emit_or_rr(cb, rd as int, breg as int)
                end
            eif op == LirOp.Xor do
                a = resolve_or_imm_reg_x86(cb, ins_src1, assigned_phys, SCR)
                breg = resolve_or_imm_reg_x86(cb, ins_src2, assigned_phys, SCR2)
                if rd >= 0 and a >= 0 and breg >= 0 do
                    cb = x86_emit_mov_rr(cb, rd as int, a as int)
                    cb = x86_emit_xor_rr(cb, rd as int, breg as int)
                end
            eif op == LirOp.Shl do
                a = resolve_or_imm_reg_x86(cb, ins_src1, assigned_phys, SCR)
                breg = resolve_or_imm_reg_x86(cb, ins_src2, assigned_phys, SCR2)
                if rd >= 0 and a >= 0 and breg >= 0 do
                    cb = x86_emit_mov_rr(cb, rd as int, a as int)
                    cb = x86_emit_mov_rr(cb, X86_RCX, breg as int)
                    cb = x86_emit_shl_cl(cb, rd as int)
                end
            eif op == LirOp.Shr do
                a = resolve_or_imm_reg_x86(cb, ins_src1, assigned_phys, SCR)
                breg = resolve_or_imm_reg_x86(cb, ins_src2, assigned_phys, SCR2)
                if rd >= 0 and a >= 0 and breg >= 0 do
                    cb = x86_emit_mov_rr(cb, rd as int, a as int)
                    cb = x86_emit_mov_rr(cb, X86_RCX, breg as int)
                    cb = x86_emit_shr_cl(cb, rd as int)
                end
            eif op == LirOp.Not do
                a = resolve_or_imm_reg_x86(cb, ins_src1, assigned_phys, SCR)
                if rd >= 0 and a >= 0 do
                    cb = x86_emit_mov_rr(cb, rd as int, a as int)
                    cb = x86_emit_not_rr(cb, rd as int)
                end
            eif op == LirOp.MatMul or op == LirOp.Fma do
                a_dot = resolve_or_imm_reg_x86(cb, ins_src1, assigned_phys, SCR)
                b_dot = resolve_or_imm_reg_x86(cb, ins_src2, assigned_phys, SCR2)
                # Parallel move A/B into the SysV RDI/RSI argument pair without
                # losing an operand when the allocator chose the opposite pair.
                if a_dot == X86_RSI and b_dot == X86_RDI do
                    cb = x86_emit_mov_rr(cb, X86_RAX, X86_RDI)
                    cb = x86_emit_mov_rr(cb, X86_RDI, X86_RSI)
                    cb = x86_emit_mov_rr(cb, X86_RSI, X86_RAX)
                eif b_dot == X86_RDI and a_dot != X86_RDI do
                    cb = x86_emit_mov_rr(cb, X86_RAX, X86_RDI)
                    if a_dot >= 0 do cb = x86_emit_mov_rr(cb, X86_RDI, a_dot as int) end
                    cb = x86_emit_mov_rr(cb, X86_RSI, X86_RAX)
                eif a_dot == X86_RSI do
                    cb = x86_emit_mov_rr(cb, X86_RDI, X86_RSI)
                    if b_dot >= 0 and b_dot != X86_RSI do cb = x86_emit_mov_rr(cb, X86_RSI, b_dot as int) end
                else
                    if b_dot >= 0 and b_dot != X86_RSI do cb = x86_emit_mov_rr(cb, X86_RSI, b_dot as int) end
                    if a_dot >= 0 and a_dot != X86_RDI do cb = x86_emit_mov_rr(cb, X86_RDI, a_dot as int) end
                end
                dot_is_float = (ins_aux shr 48) and 1
                dot_m = (ins_aux shr 32) and 65535
                dot_k = (ins_aux shr 16) and 65535
                dot_n = ins_aux and 65535
                cb = x86_emit_mov_reg_imm32(cb, X86_RDX, dot_m as int)
                cb = x86_emit_mov_reg_imm32(cb, X86_RCX, dot_k as int)
                cb = x86_emit_mov_reg_imm32(cb, X86_R8, dot_n as int)
                dot_stub = LIR_RT_MATMUL
                if dot_is_float == 1 do
                    dot_stub = LIR_RT_MATMUL_F64
                    if op == LirOp.Fma do dot_stub = LIR_RT_FMA_F64 end
                else
                    if op == LirOp.Fma do dot_stub = LIR_RT_FMA end
                end
                cb = emit_call_fixup_x86(cb, call_fixups, 1, dot_stub, rd)
                if rd < 0 and (ins_dst as i64) != 0 do
                    dst_dot_typ = native_read_i64(ins_dst as i64, 0)
                    if dst_dot_typ == 4 do
                        dst_dot_off = native_read_i64(ins_dst as i64, 24)
                        if dst_dot_off < 0 do
                            cb = x86_emit_mov_reg_imm32(cb, SCR as int, dst_dot_off as int)
                            cb = x86_emit_add_rr(cb, SCR as int, X86_RBP)
                            cb = x86_emit_mov_mem_reg(cb, SCR as int, 0, X86_RAX)
                        end
                    end
                end
            eif op == LirOp.Cmp do
                a = resolve_or_imm_reg_x86(cb, ins_src1, assigned_phys, SCR)
                breg = resolve_or_imm_reg_x86(cb, ins_src2, assigned_phys, SCR2)
                if a >= 0 and breg >= 0 do
                    cb = x86_emit_cmp_rr(cb, a as int, breg as int)
                end
                if rd >= 0 do
                    cb = emit_setcc(cb, rd as int, ins_aux)
                end
            eif op == LirOp.Load do
                if rd >= 0 and rs1 >= 0 do
                    cb = x86_emit_mov_reg_mem(cb, rd as int, rs1 as int, 0)
                end
            eif op == LirOp.Store do
                if rs1 >= 0 and rs2 >= 0 do
                    cb = x86_emit_mov_mem_reg(cb, rs1 as int, 0, rs2 as int)
                end
            eif op == LirOp.SetArg do
                pending_stk = emit_lir_setarg_x86(cb, ins, assigned_phys, pending_stk)
            eif op == LirOp.Call do
                pending_stk = emit_lir_call_x86(cb, ins, rd, func_obj, lir_funcs, call_fixups, pending_stk)
            eif op == LirOp.Intrinsic do
                cb = emit_lir_intrinsic_x86(cb, ins, rd, rs1, assigned_phys, call_fixups, func_obj, str_fixups)
            eif op == LirOp.Jmp do
                tgt = 0 - 1
                if (ins_src1 as i64) != 0 do
                    src1_typ = native_read_i64(ins_src1 as i64, 0)
                    if src1_typ == 6 do # Label
                        tgt = native_read_i64(ins_src1 as i64, 40)
                    eif src1_typ == 5 do # Imm
                        tgt = native_read_i64(ins_src1 as i64, 32)
                    end
                end
                if tgt >= 0 do
                    at = codebuf_offset(cb) as i64
                    cb = x86_emit_jmp_rel32(cb, 0)
                    fixups = vec_push_rt(fixups, x86_fixup_new(at + 1, tgt, 0))
                end
            eif op == LirOp.JmpCond do
                tgt = 0 - 1
                if (ins_src2 as i64) != 0 do
                    src2_typ = native_read_i64(ins_src2 as i64, 0)
                    if src2_typ == 6 do # Label
                        tgt = native_read_i64(ins_src2 as i64, 40)
                    eif src2_typ == 5 do # Imm
                        tgt = native_read_i64(ins_src2 as i64, 32)
                    end
                end
                a = resolve_or_imm_reg_x86(cb, ins_src1, assigned_phys, SCR)
                if a >= 0 do
                    cb = x86_emit_test_rr(cb, a as int, a as int)
                end
                if tgt >= 0 do
                    at = codebuf_offset(cb) as i64
                    kind = 2
                    if ins_aux == LIR_JMP_IFNOT do
                        kind = 1
                    end
                    if kind == 1 do
                        cb = x86_emit_je_rel32(cb, 0)
                    else
                        cb = x86_emit_jne_rel32(cb, 0)
                    end
                    fixups = vec_push_rt(fixups, x86_fixup_new(at + 2, tgt, kind))
                end
            eif op == LirOp.Ret do
                if (ins_src1 as i64) != 0 do
                    src1_typ = native_read_i64(ins_src1 as i64, 0)
                    if src1_typ == 5 do # Imm
                        imm_val = native_read_i64(ins_src1 as i64, 32)
                        cb = x86_emit_mov_reg_imm64(cb, X86_RAX, imm_val as int)
                    eif rs1 >= 0 and rs1 != X86_RAX do
                        cb = x86_emit_mov_rr(cb, X86_RAX, rs1 as int)
                    end
                eif rs1 >= 0 and rs1 != X86_RAX do
                    cb = x86_emit_mov_rr(cb, X86_RAX, rs1 as int)
                end
                if stack_size > 0 do
                    cb = x86_emit_add_rsp_imm(cb, stack_size as int)
                end
                cb = emit_callee_restore_x86(cb)
                cb = x86_emit_mov_rr(cb, X86_RSP, X86_RBP)
                cb = x86_emit_pop(cb, X86_RBP)
                cb = x86_emit_ret(cb)
            end
            ii = ii + 1
        end
        bi = bi + 1
    end

    cb = x86_emit_mov_reg_imm64(cb, X86_RAX, 0)
    if stack_size > 0 do
        cb = x86_emit_add_rsp_imm(cb, stack_size as int)
    end
    cb = emit_callee_restore_x86(cb)
    cb = x86_emit_mov_rr(cb, X86_RSP, X86_RBP)
    cb = x86_emit_pop(cb, X86_RBP)
    cb = x86_emit_ret(cb)

    nf = vec_len_rt(fixups)
    var fxi = 0
    when fxi < nf loop
        fx = vec_get_rt(fixups, fxi)
        f_tgt = x86_fixup_target_block(fx)
        f_kind = x86_fixup_kind(fx)
        f_at = x86_fixup_at_off(fx)
        if f_tgt >= 0 and f_tgt < max_bid do
            dest = vec_get_rt(block_off, f_tgt)
            if dest >= 0 do
                cb = patch_rel32(cb, f_at as int, dest as int)
            end
        end
        fxi = fxi + 1
    end

    out cb
end.

func emit_lir_module_x86_64(lir_funcs: i64):
    x86_prepare_func_index(lir_funcs)
    cb = codebuf_new(TargetArch.X86_64)
    n_funcs = vec_len_rt(lir_funcs)
    func_offs = vec_new_cap_rt_x86(4096)
    call_fixups_box = alloc(8)
    native_write_i64(call_fixups_box, 0, vec_new_cap_rt_x86(65536))
    str_fixups_box = alloc(8)
    native_write_i64(str_fixups_box, 0, vec_new_cap_rt_x86(65536))

    var fi = 0
    when fi < n_funcs loop
        func_offs = vec_push_rt(func_offs, codebuf_offset(cb) as i64)
        lf = vec_get_rt(lir_funcs, fi)
        cb = emit_lir_x86_into(cb, lf, 0 - 1, lir_funcs, call_fixups_box, str_fixups_box)
        fi = fi + 1
    end

    rt_offs = vec_new_cap_rt_x86(1024)
    cb = emit_lir_rt_stubs_x86(cb, rt_offs)

    call_fixups = native_read_i64(call_fixups_box, 0)
    nf = vec_len_rt(call_fixups)
    var ci = 0
    when ci < nf loop
        fx = vec_get_rt(call_fixups, ci)
        f_tkind = native_read_i64(fx as i64, 8)
        f_tid = native_read_i64(fx as i64, 16)
        f_at = native_read_i64(fx as i64, 0)
        dest = 0 - 1
        if f_tkind == 0 do
            if f_tid >= 0 and f_tid < n_funcs do
                dest = vec_get_rt(func_offs, f_tid)
            end
        else
            if f_tid > 0 and f_tid < LIR_RT_STUB_COUNT do
                dest = vec_get_rt(rt_offs, f_tid)
            end
        end
        if dest < 0 do
            print_str("virc: linker error: unresolved direct function call\n")
            sys_exit(1)
        end
        cb = patch_rel32(cb, (f_at + 1) as int, dest as int)
        ci = ci + 1
    end

    cb.start_offset = codebuf_offset(cb)

    cb = x86_emit_push(cb, X86_RBP)
    cb = x86_emit_mov_rr(cb, X86_RBP, X86_RSP)
    cb = x86_emit_mov_reg_imm64(cb, X86_RDI, 0)
    cb = x86_emit_mov_reg_imm64(cb, X86_RSI, 268435456)
    cb = x86_emit_mov_reg_imm32(cb, X86_RDX, X86_PROT_RW)
    cb = x86_emit_mov_reg_imm32(cb, X86_R10, X86_MAP_ANON or X86_MAP_PRIVATE)
    cb = x86_emit_mov_reg_imm64(cb, X86_R8, 0 - 1)
    cb = x86_emit_mov_reg_imm64(cb, X86_R9, 0)
    cb = x86_emit_mov_reg_imm64(cb, X86_RAX, X86_SYS_MMAP)
    cb = x86_emit_syscall(cb)
    cb = x86_emit_mov_rr(cb, X86_R15, X86_RAX)
    cb = x86_emit_mov_rr(cb, X86_RSI, X86_R15)
    cb = x86_emit_mov_reg_imm32(cb, SCR as int, 32768)
    cb = x86_emit_add_rr(cb, X86_RSI, SCR as int)
    cb = x86_emit_mov_mem_reg(cb, X86_R15, 0, X86_RSI)

    if n_funcs > 0 do
        init_name = fat_str_new("__vir_global_init")
        init_idx = x86_find_func_index(lir_funcs, init_name)
        if init_idx >= 0 do
            init_at = codebuf_offset(cb)
            cb = x86_emit_call_rel32(cb, 0)
            cb = patch_rel32(cb, init_at + 1, vec_get_rt(func_offs, init_idx) as int)
        end
        main_name = fat_str_new("main")
        main_idx = x86_find_func_index(lir_funcs, main_name)
        if main_idx < 0 do
            main_idx = 0
        end
        call_at = codebuf_offset(cb)
        cb = x86_emit_call_rel32(cb, 0)
        main_off = vec_get_rt(func_offs, main_idx)
        cb = patch_rel32(cb, call_at + 1, main_off as int)
    end

    # Linux exit(2) receives the entry function result in RDI.
    if n_funcs > 0 do
        cb = x86_emit_mov_rr(cb, X86_RDI, X86_RAX)
    else
        cb = x86_emit_mov_reg_imm64(cb, X86_RDI, 0)
    end
    cb = x86_emit_mov_reg_imm64(cb, X86_RAX, X86_SYS_EXIT)
    cb = x86_emit_syscall(cb)
    cb = x86_emit_mov_rr(cb, X86_RSP, X86_RBP)
    cb = x86_emit_pop(cb, X86_RBP)
    cb = x86_emit_ret(cb)

    # ── String Literal Pool & Patch mov reg, imm64 sites ──
    let str_fixups = native_read_i64(str_fixups_box, 0)
    let n_sfx = vec_len_rt(str_fixups)
    if n_sfx > 0 do
        let va_base: i64 = 0x401000
        pool_offsets = vec_new_cap_rt_x86(n_sfx)
        var sfi = 0
        when sfi < n_sfx loop
            sfx = vec_get_rt(str_fixups, sfi)
            s_val = native_read_i64(sfx as i64, 8) as string
            s_data = native_read_i64(s_val as i64, 0)
            s_len = native_read_i64(s_val as i64, 8)
            found_off = codebuf_offset(cb) as i64
            var bi = 0
            when bi < s_len loop
                b_ch = native_read_u8(s_data, bi)
                cb = codebuf_emit_byte(cb, b_ch)
                bi = bi + 1
            end
            cb = codebuf_emit_byte(cb, 0)
            pool_offsets = vec_push_rt(pool_offsets, found_off)
            sfi = sfi + 1
        end

        sfi = 0
        when sfi < n_sfx loop
            sfx = vec_get_rt(str_fixups, sfi)
            imm_at = native_read_i64(sfx as i64, 0)
            s_target = vec_get_rt(pool_offsets, sfi)
            va_target = va_base + s_target
            cb = codebuf_patch_u32(cb, imm_at as int, (va_target and 0xFFFFFFFF) as int)
            cb = codebuf_patch_u32(cb, (imm_at + 4) as int, ((va_target shr 32) and 0xFFFFFFFF) as int)
            sfi = sfi + 1
        end
    end

    out cb
end.

export emit_lir_module_x86_64
