##
 * vir/compiler/lir_codegen_x86.vri — LIR to Machine Code (x86_64)
 * ================================================================
 * System V AMD64. Mirror of lir_codegen.vri (ARM64).
 ##

include types
include vec_rt
import vec_new_rt, vec_push_rt, vec_get_rt, vec_set_rt, vec_len_rt from vec_rt
include string_rt
import fat_str_eq, fat_str_new, native_read_i64, native_write_i64, native_read_u8 from string_rt
include compiler.lir
import LirOp, LirOperandType, LirOperand, LirInstr, LirBlock, LirFunc, lir_func_stack_size, LIR_CMP_EQ, LIR_CMP_NE, LIR_CMP_GT, LIR_CMP_LT, LIR_CMP_GE, LIR_CMP_LE, LIR_JMP_IF, LIR_JMP_IFNOT, LIR_RT_UNRESOLVED, LIR_RT_POW, LIR_RT_MATMUL, LIR_RT_FMA, LIR_RT_ALLOC, LIR_RT_PRINT_STR, LIR_RT_GET_ARG, LIR_RT_ARG_COUNT, LIR_RT_NATIVE_READ_U8, LIR_RT_NATIVE_WRITE_U8, LIR_RT_NATIVE_READ_I64, LIR_RT_NATIVE_WRITE_I64, LIR_RT_VOLATILE_READ, LIR_RT_VOLATILE_WRITE, LIR_RT_VOLATILE_READ8, LIR_RT_VOLATILE_WRITE8, LIR_RT_DMB, LIR_RT_DSB, LIR_RT_ISB, LIR_RT_WFI, LIR_RT_WFE, LIR_RT_SEV, LIR_RT_NOP, LIR_RT_ATOMIC_LOAD32, LIR_RT_ATOMIC_STORE32, LIR_RT_ATOMIC_ADD32, LIR_RT_ATOMIC_SUB32, LIR_RT_ATOMIC_CAS32, LIR_RT_ATOMIC_EXCHANGE32, LIR_RT_ATOMIC_LOAD64, LIR_RT_ATOMIC_STORE64, LIR_RT_ATOMIC_ADD64, LIR_RT_ATOMIC_SUB64, LIR_RT_ATOMIC_CAS64, LIR_RT_ATOMIC_EXCHANGE64, LIR_RT_STUB_COUNT from compiler.lir
include compiler.mir
import MIR_INTR_PRINT, MIR_INTR_PRINT_STR, MIR_INTR_PARAM, MIR_INTR_BUILTIN, MIR_INTR_STR_LIT, MIR_INTR_INTERP, MIR_INTR_BUNDLE, MIR_INTR_ADDR_OF, MIR_INTR_CAST, MIR_INTR_NOP_MARKER, MIR_INTR_DECL, MIR_INTR_QUIET, MIR_INTR_CHECK_CPU, MIR_INTR_PATCH_POINT, MIR_INTR_PRECOMP, MIR_INTR_EXPOSE, MIR_INTR_ASYNC, MIR_INTR_ATOMIC_VAR, MIR_INTR_TIMEOUT, MIR_INTR_ISOLATE, MIR_INTR_PTR, MIR_INTR_AWAIT_PASS, MIR_INTR_ENSURE, MIR_INTR_REVERT, MIR_INTR_ENUM, MIR_INTR_ERROR, MIR_INTR_EXIST, MIR_INTR_INDEX, MIR_INTR_INDEX_STORE, MIR_INTR_FIELD, MIR_INTR_FIELD_STORE, MIR_INTR_ENTITY, MIR_INTR_ARRAY, MIR_INTR_TUPLE, MIR_INTR_INFER, MIR_INTR_TRAIN, MIR_INTR_REACTIVE, MIR_INTR_MORPH, MIR_INTR_QUANTIZE, MIR_INTR_ARENA from compiler.mir
include compiler.codegen
import codebuf_new, codebuf_emit_byte, codebuf_emit_u32, codebuf_offset, codebuf_patch_i32, TargetArch, CodeBuf from compiler.codegen
include compiler.codegen_x86
import X86_RAX, X86_RCX, X86_RDX, X86_RBX, X86_RSP, X86_RBP, X86_RSI, X86_RDI, X86_R8, X86_R9, X86_R10, X86_R11, X86_R12, X86_R13, X86_R14, X86_R15 from compiler.codegen_x86
import x86_emit_mov_reg_imm64, x86_emit_mov_reg_imm32, x86_emit_mov_rr, x86_emit_call_rel32, x86_emit_push, x86_emit_pop, x86_emit_ret, x86_emit_syscall, x86_arg_reg from compiler.codegen_x86
import x86_emit_add_rr, x86_emit_sub_rr, x86_emit_imul_rr, x86_emit_xor_rr, x86_emit_and_rr, x86_emit_or_rr from compiler.codegen_x86
import x86_emit_cmp_rr, x86_emit_cmp_imm0, x86_emit_test_rr, x86_emit_cqo, x86_emit_idiv from compiler.codegen_x86
import x86_emit_sete, x86_emit_setne, x86_emit_setg, x86_emit_setl, x86_emit_setge, x86_emit_setle from compiler.codegen_x86
import x86_emit_jmp_rel32, x86_emit_je_rel32, x86_emit_jne_rel32, x86_emit_jg_rel32, x86_emit_jl_rel32, x86_emit_jge_rel32, x86_emit_jle_rel32 from compiler.codegen_x86
import x86_emit_sub_rsp_imm, x86_emit_add_rsp_imm, x86_emit_mov_reg_mem, x86_emit_mov_mem_reg, x86_emit_nop, x86_emit_shl_cl, x86_emit_shr_cl, x86_emit_not_rr from compiler.codegen_x86
const X86_SYS_EXIT   = 60
const X86_SYS_WRITE  = 1
const X86_SYS_MMAP   = 9
const X86_MAP_ANON   = 0x20
const X86_MAP_PRIVATE = 0x02
const X86_PROT_RW    = 3

const SCR  = X86_R10
const SCR2 = X86_R11
const SCRQ = X86_RCX

func vec_new_cap_rt_x86(cap: int):
    base = alloc(16 + cap * 8)
    data = base + 16
    native_write_i64(base, 0, cap as i64)
    native_write_i64(base, 8, 0)
    out data
end.

func patch_rel32(cb: CodeBuf, rel_off: int, dest_off: int):
    rel = dest_off - (rel_off + 4)
    out codebuf_patch_i32(cb, rel_off, rel)
end.

func x86_fixup_new(at_off: i64, target_block: i64, kind: i64):
    p = alloc(24)
    native_write_i64(p, 0, at_off)
    native_write_i64(p, 8, target_block)
    native_write_i64(p, 16, kind)
    out p
end.

func x86_fixup_at_off(fx: i64): out native_read_i64(fx, 0) end.
func x86_fixup_target_block(fx: i64): out native_read_i64(fx, 8) end.
func x86_fixup_kind(fx: i64): out native_read_i64(fx, 16) end.

func x86_call_fixup_new(at_off: i64, target_kind: i64, target_id: i64):
    p = alloc(24)
    native_write_i64(p, 0, at_off)
    native_write_i64(p, 8, target_kind)
    native_write_i64(p, 16, target_id)
    out p
end.

func x86_intr_is_marker(kind: i64):
    if kind == MIR_INTR_NOP_MARKER or kind == MIR_INTR_DECL or kind == MIR_INTR_QUIET or kind == MIR_INTR_CHECK_CPU or kind == MIR_INTR_PATCH_POINT or kind == MIR_INTR_PRECOMP or kind == MIR_INTR_EXPOSE or kind == MIR_INTR_ASYNC or kind == MIR_INTR_ATOMIC_VAR or kind == MIR_INTR_TIMEOUT or kind == MIR_INTR_ISOLATE or kind == MIR_INTR_PTR or kind == MIR_INTR_AWAIT_PASS or kind == MIR_INTR_ENSURE or kind == MIR_INTR_REVERT or kind == MIR_INTR_ENUM or kind == MIR_INTR_ERROR or kind == MIR_INTR_EXIST or kind == MIR_INTR_INFER or kind == MIR_INTR_TRAIN or kind == MIR_INTR_REACTIVE or kind == MIR_INTR_MORPH or kind == MIR_INTR_QUANTIZE do
        out 1
    end
    out 0
end.

func x86_intr_is_payload(kind: i64):
    if kind == MIR_INTR_ADDR_OF or kind == MIR_INTR_CAST do
        out 1
    end
    out 0
end.

func x86_stub_for_builtin_id(bid: i64):
    if bid == 3 or bid == 11 or bid == 35 or bid == 49 or bid == 50 do out LIR_RT_ALLOC end
    if bid == 5 do out LIR_RT_NATIVE_READ_U8 end
    if bid == 6 do out LIR_RT_NATIVE_WRITE_U8 end
    if bid == 7 or bid == 46 do out LIR_RT_NATIVE_READ_I64 end
    if bid == 8 or bid == 47 do out LIR_RT_NATIVE_WRITE_I64 end
    if bid == 23 do out LIR_RT_GET_ARG end
    if bid == 24 do out LIR_RT_ARG_COUNT end
    if bid == 54 or bid == 60 or bid == 62 do out LIR_RT_VOLATILE_READ end
    if bid == 55 or bid == 61 or bid == 63 do out LIR_RT_VOLATILE_WRITE end
    if bid == 56 or bid == 58 do out LIR_RT_VOLATILE_READ8 end
    if bid == 57 or bid == 59 do out LIR_RT_VOLATILE_WRITE8 end
    if bid == 64 or bid == 39 do out LIR_RT_DMB end
    if bid == 65 do out LIR_RT_DSB end
    if bid == 66 do out LIR_RT_ISB end
    if bid == 67 do out LIR_RT_WFI end
    if bid == 68 do out LIR_RT_WFE end
    if bid == 69 do out LIR_RT_SEV end
    if bid == 70 do out LIR_RT_NOP end
    if bid == 40 or bid == 78 do out LIR_RT_ATOMIC_LOAD64 end
    if bid == 72 do out LIR_RT_ATOMIC_LOAD32 end
    if bid == 41 or bid == 79 do out LIR_RT_ATOMIC_STORE64 end
    if bid == 73 do out LIR_RT_ATOMIC_STORE32 end
    if bid == 43 or bid == 80 do out LIR_RT_ATOMIC_ADD64 end
    if bid == 74 do out LIR_RT_ATOMIC_ADD32 end
    if bid == 44 or bid == 81 do out LIR_RT_ATOMIC_SUB64 end
    if bid == 75 do out LIR_RT_ATOMIC_SUB32 end
    if bid == 42 or bid == 82 do out LIR_RT_ATOMIC_CAS64 end
    if bid == 76 do out LIR_RT_ATOMIC_CAS32 end
    if bid == 71 or bid == 83 do out LIR_RT_ATOMIC_EXCHANGE64 end
    if bid == 77 do out LIR_RT_ATOMIC_EXCHANGE32 end
    out 0 - 1
end.

func x86_find_func_index(lir_funcs: i64, name: string):
    n = vec_len_rt(lir_funcs)
    var i = 0
    when i < n loop
        lf = vec_get_rt(lir_funcs, i)
        fn_name = native_read_i64(lf as i64, 8) as string
        if fat_str_eq(fn_name, name) == 1 do
            out i
        end
        i = i + 1
    end
    out 0 - 1
end.

func resolve_reg_x86(opnd: LirOperand, assigned_phys: i64):
    if (opnd as i64) == 0 do
        out 0 - 1
    end
    typ = native_read_i64(opnd as i64, 0)
    if typ == 1 do
        if assigned_phys >= 0 do
            out vec_get_rt(assigned_phys, native_read_i64(opnd as i64, 8))
        end
        out native_read_i64(opnd as i64, 8)
    end
    if typ == 2 do
        out native_read_i64(opnd as i64, 16)
    end
    out 0 - 1
end.

func resolve_or_imm_reg_x86(cb: CodeBuf, opnd: LirOperand, assigned_phys: i64, scratch: i64):
    if (opnd as i64) == 0 do
        out scratch
    end
    r = resolve_reg_x86(opnd, assigned_phys)
    if r >= 0 do
        out r
    end
    typ = native_read_i64(opnd as i64, 0)
    if typ == 4 do
        imm_val = native_read_i64(opnd as i64, 32)
        cb = x86_emit_mov_reg_imm64(cb, scratch as int, imm_val as int)
        out scratch
    end
    if typ == 3 do
        off = native_read_i64(opnd as i64, 24)
        if off < 0 do
            cb = x86_emit_mov_reg_imm32(cb, scratch as int, off as int)
            cb = x86_emit_add_rr(cb, scratch as int, X86_RBP)
            cb = x86_emit_mov_reg_mem(cb, scratch as int, scratch as int, 0)
            out scratch
        end
    end
    out scratch
end.

func emit_call_fixup_x86(cb: CodeBuf, call_fixups: i64, target_kind: i64, target_id: i64, rd: i64):
    at = codebuf_offset(cb) as i64
    cb = x86_emit_call_rel32(cb, 0)
    call_fixups = vec_push_rt(call_fixups, x86_call_fixup_new(at, target_kind, target_id))
    if rd >= 0 and rd != X86_RAX do
        cb = x86_emit_mov_rr(cb, rd as int, X86_RAX)
    end
    out cb
end.

func emit_to_rdi(cb: CodeBuf, opnd: LirOperand, assigned_phys: i64):
    r = resolve_or_imm_reg_x86(cb, opnd, assigned_phys, SCR)
    if r >= 0 and r != X86_RDI do
        cb = x86_emit_mov_rr(cb, X86_RDI, r as int)
    end
    out cb
end.

func emit_setcc(cb: CodeBuf, rd: int, pred: i64):
    cb = x86_emit_xor_rr(cb, rd, rd)
    if pred == LIR_CMP_EQ do
        out x86_emit_sete(cb, rd)
    eif pred == LIR_CMP_NE do
        out x86_emit_setne(cb, rd)
    eif pred == LIR_CMP_GT do
        out x86_emit_setg(cb, rd)
    eif pred == LIR_CMP_LT do
        out x86_emit_setl(cb, rd)
    eif pred == LIR_CMP_GE do
        out x86_emit_setge(cb, rd)
    eif pred == LIR_CMP_LE do
        out x86_emit_setle(cb, rd)
    end
    out x86_emit_sete(cb, rd)
end.

func emit_lir_setarg_x86(cb: CodeBuf, ins: LirInstr, assigned_phys: i64, pending_stk: i64):
    ai = native_read_i64(ins as i64, 40)
    src1 = native_read_i64(ins as i64, 24)
    if (src1 as i64) != 0 do
        if native_read_i64(src1 as i64, 0) == (LirOperandType.Imm as i64) do
            ai = native_read_i64(src1 as i64, 32)
        end
    end
    src2 = native_read_i64(ins as i64, 32) as LirOperand
    rval = resolve_or_imm_reg_x86(cb, src2, assigned_phys, SCR)
    if rval < 0 do
        out pending_stk
    end
    if ai >= 0 and ai < 6 do
        areg = x86_arg_reg(ai as int)
        if rval != areg do
            cb = x86_emit_mov_rr(cb, areg, rval as int)
        end
        out pending_stk
    end
    cb = x86_emit_push(cb, rval as int)
    out pending_stk + 1
end.

func emit_lir_intrinsic_x86(cb: CodeBuf, ins: LirInstr, rd: i64, rs1: i64, assigned_phys: i64, call_fixups: i64, func_obj: LirFunc):
    kind = native_read_i64(ins as i64, 40)
    ins_src1 = native_read_i64(ins as i64, 24) as LirOperand
    if x86_intr_is_marker(kind) == 1 do
        out x86_emit_nop(cb)
    end
    if kind == MIR_INTR_PARAM do
        abi = native_read_i64(ins_src1 as i64, 32)
        if rd >= 0 and abi >= 0 and abi < 6 do
            areg = x86_arg_reg(abi as int)
            if rd != areg do
                cb = x86_emit_mov_rr(cb, rd as int, areg)
            end
            out cb
        end
        out x86_emit_nop(cb)
    end
    if kind == MIR_INTR_BUILTIN do
        bid = native_read_i64(ins_src1 as i64, 32)
        stub = x86_stub_for_builtin_id(bid)
        if stub < 0 do
            stub = LIR_RT_UNRESOLVED
        end
        out emit_call_fixup_x86(cb, call_fixups, 1, stub, rd)
    end
    if kind == MIR_INTR_PRINT do
        cb = emit_to_rdi(cb, ins_src1, assigned_phys)
        out emit_call_fixup_x86(cb, call_fixups, 1, MIR_INTR_PRINT, rd)
    end
    if kind == MIR_INTR_PRINT_STR do
        cb = emit_to_rdi(cb, ins_src1, assigned_phys)
        out emit_call_fixup_x86(cb, call_fixups, 1, LIR_RT_PRINT_STR, rd)
    end
    if x86_intr_is_payload(kind) == 1 do
        if rd >= 0 do
            if native_read_i64(ins_src1 as i64, 0) == (LirOperandType.Imm as i64) do
                cb = x86_emit_mov_reg_imm64(cb, rd as int, native_read_i64(ins_src1 as i64, 32) as int)
                out cb
            eif rs1 >= 0 do
                cb = x86_emit_mov_rr(cb, rd as int, rs1 as int)
                out cb
            end
        end
        out x86_emit_nop(cb)
    end
    if kind == MIR_INTR_INDEX or kind == MIR_INTR_FIELD do
        if rd >= 0 and rs1 >= 0 do
            cb = x86_emit_mov_reg_imm32(cb, SCR as int, 3)
            cb = x86_emit_shl_cl(cb, SCR as int)
            cb = x86_emit_add_rr(cb, SCR as int, rs1 as int)
            cb = x86_emit_mov_reg_mem(cb, rd as int, SCR as int, 0)
            out cb
        end
        out x86_emit_nop(cb)
    end
    if kind == MIR_INTR_INDEX_STORE or kind == MIR_INTR_FIELD_STORE do
        if rs1 >= 0 do
            cb = x86_emit_mov_reg_imm32(cb, SCR as int, 3)
            cb = x86_emit_shl_cl(cb, SCR as int)
            cb = x86_emit_add_rr(cb, SCR as int, rs1 as int)
            cb = x86_emit_mov_mem_reg(cb, SCR as int, 0, X86_RSI)
            out cb
        end
        out x86_emit_nop(cb)
    end
    if kind == MIR_INTR_ARENA do
        if rd >= 0 do
            cb = x86_emit_mov_reg_mem(cb, rd as int, X86_R15, 0)
            out cb
        end
        if rs1 >= 0 do
            cb = x86_emit_mov_mem_reg(cb, X86_R15, 0, rs1 as int)
            out cb
        end
        out x86_emit_nop(cb)
    end
    cb = emit_to_rdi(cb, ins_src1, assigned_phys)
    stub2 = kind
    if stub2 < 1 or stub2 >= LIR_RT_STUB_COUNT do
        stub2 = LIR_RT_UNRESOLVED
    end
    out emit_call_fixup_x86(cb, call_fixups, 1, stub2, rd)
end.

func emit_lir_call_x86(cb: CodeBuf, ins: LirInstr, rd: i64, func_obj: LirFunc, lir_funcs: i64, call_fixups: i64, pending_stk: i64):
    sid = native_read_i64(ins as i64, 40)
    target_kind = 1
    target_id = LIR_RT_UNRESOLVED
    f_strings = native_read_i64(func_obj as i64, 32)
    if f_strings > 0 and sid >= 0 and sid < vec_len_rt(f_strings) do
        cname = vec_get_rt(f_strings, sid)
        fi = x86_find_func_index(lir_funcs, cname)
        if fi >= 0 do
            target_kind = 0
            target_id = fi
        end
    end
    cb = emit_call_fixup_x86(cb, call_fixups, target_kind, target_id, rd)
    if pending_stk > 0 do
        bytes = pending_stk * 8
        if bytes > 0 and bytes <= 4096 do
            cb = x86_emit_add_rsp_imm(cb, bytes)
        end
    end
    out 0
end.

func emit_lir_rt_print_stub_x86(cb: CodeBuf):
    cb = x86_emit_push(cb, X86_RBP)
    cb = x86_emit_mov_rr(cb, X86_RBP, X86_RSP)
    cb = x86_emit_sub_rsp_imm(cb, 64)
    cb = x86_emit_mov_rr(cb, X86_RAX, X86_RDI)
    cb = x86_emit_mov_reg_imm32(cb, X86_RCX, 10)
    cb = x86_emit_mov_reg_imm64(cb, X86_RSI, 0)
    cb = x86_emit_mov_reg_imm32(cb, SCR as int, 48)
    cb = x86_emit_cmp_imm0(cb, X86_RAX)
    cb = x86_emit_jne_rel32(cb, 0)
    zero_jmp = codebuf_offset(cb) - 6
    cb = x86_emit_mov_mem_reg(cb, X86_RBP, 0 - 1, SCR as int)
    cb = x86_emit_mov_reg_imm64(cb, X86_RDX, 1)
    cb = x86_emit_jmp_rel32(cb, 0)
    done_jmp = codebuf_offset(cb)
    cb = patch_rel32(cb, zero_jmp + 2, codebuf_offset(cb))
    loop_top = codebuf_offset(cb)
    cb = x86_emit_xor_rr(cb, X86_RDX, X86_RDX)
    cb = x86_emit_div_idiv(cb)
    cb = x86_emit_mov_reg_imm32(cb, SCR as int, 48)
    cb = x86_emit_add_rr(cb, SCR as int, X86_RDX)
    cb = x86_emit_sub_rsp_imm(cb, 1)
    cb = x86_emit_mov_mem_reg(cb, X86_RSP, 0, SCR as int)
    cb = x86_emit_add_rr(cb, X86_RSI, 1)
    cb = x86_emit_cmp_imm0(cb, X86_RAX)
    rel = loop_top - (codebuf_offset(cb) + 6)
    cb = x86_emit_jne_rel32(cb, rel)
    cb = x86_emit_mov_rr(cb, X86_RSI, X86_RSP)
    cb = patch_rel32(cb, done_jmp + 1, codebuf_offset(cb))
    cb = x86_emit_mov_reg_imm64(cb, X86_RAX, X86_SYS_WRITE)
    cb = x86_emit_mov_reg_imm64(cb, X86_RDI, 1)
    cb = x86_emit_syscall(cb)
    cb = x86_emit_mov_rr(cb, X86_RSP, X86_RBP)
    cb = x86_emit_pop(cb, X86_RBP)
    out x86_emit_ret(cb)
end.

func x86_emit_div_idiv(cb: CodeBuf):
    cb = x86_emit_cqo(cb)
    out x86_emit_idiv(cb, X86_RCX)
end.

func emit_lir_rt_stubs_x86(cb: CodeBuf, offs: i64):
    var k = 0
    when k < LIR_RT_STUB_COUNT loop
        offs = vec_push_rt(offs, codebuf_offset(cb) as i64)
        if k == LIR_RT_UNRESOLVED do
            cb = x86_emit_mov_reg_imm64(cb, X86_RAX, 0)
            cb = x86_emit_ret(cb)
        eif k == MIR_INTR_PRINT do
            cb = emit_lir_rt_print_stub_x86(cb)
        eif k == LIR_RT_PRINT_STR do
            cb = x86_emit_mov_reg_imm64(cb, X86_RAX, X86_SYS_WRITE)
            cb = x86_emit_mov_reg_imm64(cb, X86_RDI, 1)
            cb = x86_emit_mov_rr(cb, X86_RSI, X86_RDI)
            cb = x86_emit_mov_reg_imm64(cb, X86_RDX, 1)
            cb = x86_emit_syscall(cb)
            cb = x86_emit_ret(cb)
        eif k == LIR_RT_ALLOC do
            cb = x86_emit_mov_reg_mem(cb, X86_RAX, X86_R15, 0)
            cb = x86_emit_mov_rr(cb, X86_RSI, X86_RAX)
            cb = x86_emit_mov_reg_imm32(cb, SCR as int, 32)
            cb = x86_emit_add_rr(cb, X86_RSI, SCR as int)
            cb = x86_emit_mov_mem_reg(cb, X86_R15, 0, X86_RSI)
            cb = x86_emit_mov_rr(cb, X86_RAX, X86_RSI)
            cb = x86_emit_ret(cb)
        eif k == LIR_RT_POW or k == LIR_RT_MATMUL or k == LIR_RT_FMA do
            cb = x86_emit_xor_rr(cb, X86_RAX, X86_RAX)
            cb = x86_emit_ret(cb)
        else
            cb = x86_emit_ret(cb)
        end
        k = k + 1
    end
    out cb
end.

func emit_callee_save_x86(cb: CodeBuf):
    cb = x86_emit_push(cb, X86_RBX)
    cb = x86_emit_push(cb, X86_R12)
    cb = x86_emit_push(cb, X86_R13)
    out x86_emit_push(cb, X86_R14)
end.

func emit_callee_restore_x86(cb: CodeBuf):
    cb = x86_emit_pop(cb, X86_R14)
    cb = x86_emit_pop(cb, X86_R13)
    cb = x86_emit_pop(cb, X86_R12)
    out x86_emit_pop(cb, X86_RBX)
end.

func emit_lir_x86_into(cb: CodeBuf, func_obj: LirFunc, assigned_phys: i64, lir_funcs: i64, call_fixups: i64):
    cb = x86_emit_push(cb, X86_RBP)
    cb = x86_emit_mov_rr(cb, X86_RBP, X86_RSP)
    cb = emit_callee_save_x86(cb)

    stack_size = lir_func_stack_size(func_obj)
    if (stack_size mod 16) != 0 do
        stack_size = stack_size + (16 - (stack_size mod 16))
    end
    if stack_size > 0 and stack_size <= 4096 do
        cb = x86_emit_sub_rsp_imm(cb, stack_size as int)
    end

    f_blocks = native_read_i64(func_obj as i64, 16)
    n_blocks = vec_len_rt(f_blocks)
    var max_bid = n_blocks
    var bi = 0
    when bi < n_blocks loop
        b = vec_get_rt(f_blocks, bi)
        bid = native_read_i64(b as i64, 0)
        if bid >= max_bid do
            max_bid = bid + 1
        end
        bi = bi + 1
    end
    block_off = vec_new_cap_rt_x86(1024)
    bi = 0
    when bi < max_bid loop
        block_off = vec_push_rt(block_off, 0 - 1)
        bi = bi + 1
    end
    fixups = vec_new_cap_rt_x86(1024)
    var pending_stk = 0

    bi = 0
    when bi < n_blocks loop
        b = vec_get_rt(f_blocks, bi)
        bid = native_read_i64(b as i64, 0)
        vec_set_rt(block_off, bid, codebuf_offset(cb) as i64)
        instrs = native_read_i64(b as i64, 8)
        n_instrs = vec_len_rt(instrs)
        var ii = 0
        when ii < n_instrs loop
            ins = vec_get_rt(instrs, ii)
            op = native_read_i64(ins as i64, 0)
            ins_dst = native_read_i64(ins as i64, 16)
            ins_src1 = native_read_i64(ins as i64, 24)
            ins_src2 = native_read_i64(ins as i64, 32)
            ins_aux = native_read_i64(ins as i64, 40)
            rd = resolve_reg_x86(ins_dst, assigned_phys)
            rs1 = resolve_reg_x86(ins_src1, assigned_phys)
            rs2 = resolve_reg_x86(ins_src2, assigned_phys)

            if op == LirOp.Nop do
                cb = x86_emit_nop(cb)
            eif op == LirOp.Mov do
                if (ins_src1 as i64) != 0 do
                    src1_typ = native_read_i64(ins_src1 as i64, 0)
                    if src1_typ == 4 do
                        imm_val = native_read_i64(ins_src1 as i64, 32)
                        if rd >= 0 do
                            cb = x86_emit_mov_reg_imm64(cb, rd as int, imm_val as int)
                        end
                    eif rd >= 0 and rs1 >= 0 do
                        if rd != rs1 do
                            cb = x86_emit_mov_rr(cb, rd as int, rs1 as int)
                        end
                    end
                end
            eif op == LirOp.Add do
                a = resolve_or_imm_reg_x86(cb, ins_src1, assigned_phys, SCR)
                breg = resolve_or_imm_reg_x86(cb, ins_src2, assigned_phys, SCR2)
                if rd >= 0 and a >= 0 and breg >= 0 do
                    cb = x86_emit_mov_rr(cb, rd as int, a as int)
                    cb = x86_emit_add_rr(cb, rd as int, breg as int)
                end
            eif op == LirOp.Sub do
                a = resolve_or_imm_reg_x86(cb, ins_src1, assigned_phys, SCR)
                breg = resolve_or_imm_reg_x86(cb, ins_src2, assigned_phys, SCR2)
                if rd >= 0 and a >= 0 and breg >= 0 do
                    cb = x86_emit_mov_rr(cb, rd as int, a as int)
                    cb = x86_emit_sub_rr(cb, rd as int, breg as int)
                end
            eif op == LirOp.Mul do
                a = resolve_or_imm_reg_x86(cb, ins_src1, assigned_phys, SCR)
                breg = resolve_or_imm_reg_x86(cb, ins_src2, assigned_phys, SCR2)
                if rd >= 0 and a >= 0 and breg >= 0 do
                    cb = x86_emit_mov_rr(cb, rd as int, a as int)
                    cb = x86_emit_imul_rr(cb, rd as int, breg as int)
                end
            eif op == LirOp.Div do
                a = resolve_or_imm_reg_x86(cb, ins_src1, assigned_phys, SCR)
                breg = resolve_or_imm_reg_x86(cb, ins_src2, assigned_phys, SCR2)
                if rd >= 0 and a >= 0 and breg >= 0 do
                    cb = x86_emit_mov_rr(cb, X86_RAX, a as int)
                    cb = x86_emit_cqo(cb)
                    cb = x86_emit_idiv(cb, breg as int)
                    if rd != X86_RAX do
                        cb = x86_emit_mov_rr(cb, rd as int, X86_RAX)
                    end
                end
            eif op == LirOp.Rem do
                a = resolve_or_imm_reg_x86(cb, ins_src1, assigned_phys, SCR)
                breg = resolve_or_imm_reg_x86(cb, ins_src2, assigned_phys, SCR2)
                if rd >= 0 and a >= 0 and breg >= 0 do
                    cb = x86_emit_mov_rr(cb, X86_RAX, a as int)
                    cb = x86_emit_cqo(cb)
                    cb = x86_emit_idiv(cb, breg as int)
                    if rd != X86_RDX do
                        cb = x86_emit_mov_rr(cb, rd as int, X86_RDX)
                    end
                end
            eif op == LirOp.And do
                a = resolve_or_imm_reg_x86(cb, ins_src1, assigned_phys, SCR)
                breg = resolve_or_imm_reg_x86(cb, ins_src2, assigned_phys, SCR2)
                if rd >= 0 and a >= 0 and breg >= 0 do
                    cb = x86_emit_mov_rr(cb, rd as int, a as int)
                    cb = x86_emit_and_rr(cb, rd as int, breg as int)
                end
            eif op == LirOp.Or do
                a = resolve_or_imm_reg_x86(cb, ins_src1, assigned_phys, SCR)
                breg = resolve_or_imm_reg_x86(cb, ins_src2, assigned_phys, SCR2)
                if rd >= 0 and a >= 0 and breg >= 0 do
                    cb = x86_emit_mov_rr(cb, rd as int, a as int)
                    cb = x86_emit_or_rr(cb, rd as int, breg as int)
                end
            eif op == LirOp.Xor do
                a = resolve_or_imm_reg_x86(cb, ins_src1, assigned_phys, SCR)
                breg = resolve_or_imm_reg_x86(cb, ins_src2, assigned_phys, SCR2)
                if rd >= 0 and a >= 0 and breg >= 0 do
                    cb = x86_emit_mov_rr(cb, rd as int, a as int)
                    cb = x86_emit_xor_rr(cb, rd as int, breg as int)
                end
            eif op == LirOp.Shl do
                a = resolve_or_imm_reg_x86(cb, ins_src1, assigned_phys, SCR)
                breg = resolve_or_imm_reg_x86(cb, ins_src2, assigned_phys, SCR2)
                if rd >= 0 and a >= 0 and breg >= 0 do
                    cb = x86_emit_mov_rr(cb, rd as int, a as int)
                    cb = x86_emit_mov_rr(cb, X86_RCX, breg as int)
                    cb = x86_emit_shl_cl(cb, rd as int)
                end
            eif op == LirOp.Shr do
                a = resolve_or_imm_reg_x86(cb, ins_src1, assigned_phys, SCR)
                breg = resolve_or_imm_reg_x86(cb, ins_src2, assigned_phys, SCR2)
                if rd >= 0 and a >= 0 and breg >= 0 do
                    cb = x86_emit_mov_rr(cb, rd as int, a as int)
                    cb = x86_emit_mov_rr(cb, X86_RCX, breg as int)
                    cb = x86_emit_shr_cl(cb, rd as int)
                end
            eif op == LirOp.Not do
                a = resolve_or_imm_reg_x86(cb, ins_src1, assigned_phys, SCR)
                if rd >= 0 and a >= 0 do
                    cb = x86_emit_mov_rr(cb, rd as int, a as int)
                    cb = x86_emit_not_rr(cb, rd as int)
                end
            eif op == LirOp.Cmp do
                a = resolve_or_imm_reg_x86(cb, ins_src1, assigned_phys, SCR)
                breg = resolve_or_imm_reg_x86(cb, ins_src2, assigned_phys, SCR2)
                if a >= 0 and breg >= 0 do
                    cb = x86_emit_cmp_rr(cb, a as int, breg as int)
                end
                if rd >= 0 do
                    cb = emit_setcc(cb, rd as int, ins_aux)
                end
            eif op == LirOp.Load do
                if rd >= 0 and rs1 >= 0 do
                    cb = x86_emit_mov_reg_mem(cb, rd as int, rs1 as int, 0)
                end
            eif op == LirOp.Store do
                if rs1 >= 0 and rs2 >= 0 do
                    cb = x86_emit_mov_mem_reg(cb, rs1 as int, 0, rs2 as int)
                end
            eif op == LirOp.SetArg do
                pending_stk = emit_lir_setarg_x86(cb, ins, assigned_phys, pending_stk)
            eif op == LirOp.Call do
                pending_stk = emit_lir_call_x86(cb, ins, rd, func_obj, lir_funcs, call_fixups, pending_stk)
            eif op == LirOp.Intrinsic do
                cb = emit_lir_intrinsic_x86(cb, ins, rd, rs1, assigned_phys, call_fixups, func_obj)
            eif op == LirOp.Jmp do
                tgt = 0 - 1
                if (ins_src1 as i64) != 0 do
                    src1_typ = native_read_i64(ins_src1 as i64, 0)
                    if src1_typ == 5 do
                        tgt = native_read_i64(ins_src1 as i64, 40)
                    eif src1_typ == 4 do
                        tgt = native_read_i64(ins_src1 as i64, 32)
                    end
                end
                if tgt >= 0 do
                    at = codebuf_offset(cb) as i64
                    cb = x86_emit_jmp_rel32(cb, 0)
                    fixups = vec_push_rt(fixups, x86_fixup_new(at + 1, tgt, 0))
                end
            eif op == LirOp.JmpCond do
                tgt = 0 - 1
                if (ins_src2 as i64) != 0 do
                    src2_typ = native_read_i64(ins_src2 as i64, 0)
                    if src2_typ == 5 do
                        tgt = native_read_i64(ins_src2 as i64, 40)
                    eif src2_typ == 4 do
                        tgt = native_read_i64(ins_src2 as i64, 32)
                    end
                end
                a = resolve_or_imm_reg_x86(cb, ins_src1, assigned_phys, SCR)
                if a >= 0 do
                    cb = x86_emit_test_rr(cb, a as int, a as int)
                end
                if tgt >= 0 do
                    at = codebuf_offset(cb) as i64
                    kind = 2
                    if ins_aux == LIR_JMP_IFNOT do
                        kind = 1
                    end
                    if kind == 1 do
                        cb = x86_emit_je_rel32(cb, 0)
                    else
                        cb = x86_emit_jne_rel32(cb, 0)
                    end
                    fixups = vec_push_rt(fixups, x86_fixup_new(at + 2, tgt, kind))
                end
            eif op == LirOp.Ret do
                if (ins_src1 as i64) != 0 do
                    src1_typ = native_read_i64(ins_src1 as i64, 0)
                    if src1_typ == 4 do
                        imm_val = native_read_i64(ins_src1 as i64, 32)
                        cb = x86_emit_mov_reg_imm64(cb, X86_RAX, imm_val as int)
                    eif rs1 >= 0 and rs1 != X86_RAX do
                        cb = x86_emit_mov_rr(cb, X86_RAX, rs1 as int)
                    end
                eif rs1 >= 0 and rs1 != X86_RAX do
                    cb = x86_emit_mov_rr(cb, X86_RAX, rs1 as int)
                end
                if stack_size > 0 and stack_size <= 4096 do
                    cb = x86_emit_add_rsp_imm(cb, stack_size as int)
                end
                cb = emit_callee_restore_x86(cb)
                cb = x86_emit_mov_rr(cb, X86_RSP, X86_RBP)
                cb = x86_emit_pop(cb, X86_RBP)
                cb = x86_emit_ret(cb)
            end
            ii = ii + 1
        end
        bi = bi + 1
    end

    cb = x86_emit_mov_reg_imm64(cb, X86_RAX, 0)
    if stack_size > 0 and stack_size <= 4096 do
        cb = x86_emit_add_rsp_imm(cb, stack_size as int)
    end
    cb = emit_callee_restore_x86(cb)
    cb = x86_emit_mov_rr(cb, X86_RSP, X86_RBP)
    cb = x86_emit_pop(cb, X86_RBP)
    cb = x86_emit_ret(cb)

    nf = vec_len_rt(fixups)
    var fxi = 0
    when fxi < nf loop
        fx = vec_get_rt(fixups, fxi)
        f_tgt = x86_fixup_target_block(fx)
        f_kind = x86_fixup_kind(fx)
        f_at = x86_fixup_at_off(fx)
        if f_tgt >= 0 and f_tgt < max_bid do
            dest = vec_get_rt(block_off, f_tgt)
            if dest >= 0 do
                cb = patch_rel32(cb, f_at as int, dest as int)
            end
        end
        fxi = fxi + 1
    end

    out cb
end.

func emit_lir_module_x86_64(lir_funcs: i64):
    cb = codebuf_new(TargetArch.X86_64)
    n_funcs = vec_len_rt(lir_funcs)
    func_offs = vec_new_cap_rt_x86(1024)
    call_fixups = vec_new_cap_rt_x86(1024)

    var fi = 0
    when fi < n_funcs loop
        func_offs = vec_push_rt(func_offs, codebuf_offset(cb) as i64)
        lf = vec_get_rt(lir_funcs, fi)
        cb = emit_lir_x86_into(cb, lf, 0 - 1, lir_funcs, call_fixups)
        fi = fi + 1
    end

    rt_offs = vec_new_cap_rt_x86(1024)
    cb = emit_lir_rt_stubs_x86(cb, rt_offs)

    nf = vec_len_rt(call_fixups)
    var ci = 0
    when ci < nf loop
        fx = vec_get_rt(call_fixups, ci)
        f_tkind = native_read_i64(fx as i64, 8)
        f_tid = native_read_i64(fx as i64, 16)
        f_at = native_read_i64(fx as i64, 0)
        dest = 0 - 1
        if f_tkind == 0 do
            if f_tid >= 0 and f_tid < n_funcs do
                dest = vec_get_rt(func_offs, f_tid)
            end
        else
            if f_tid >= 0 and f_tid < LIR_RT_STUB_COUNT do
                dest = vec_get_rt(rt_offs, f_tid)
            end
        end
        if dest < 0 do
            dest = vec_get_rt(rt_offs, LIR_RT_UNRESOLVED)
        end
        cb = patch_rel32(cb, (f_at + 1) as int, dest as int)
        ci = ci + 1
    end

    cb.start_offset = codebuf_offset(cb)

    cb = x86_emit_push(cb, X86_RBP)
    cb = x86_emit_mov_rr(cb, X86_RBP, X86_RSP)
    cb = x86_emit_mov_reg_imm64(cb, X86_RDI, 0)
    cb = x86_emit_mov_reg_imm64(cb, X86_RSI, 268435456)
    cb = x86_emit_mov_reg_imm32(cb, X86_RDX, X86_PROT_RW)
    cb = x86_emit_mov_reg_imm32(cb, X86_RCX, X86_MAP_ANON bit_or X86_MAP_PRIVATE)
    cb = x86_emit_mov_reg_imm64(cb, X86_R8, 0 - 1)
    cb = x86_emit_mov_reg_imm64(cb, X86_R9, 0)
    cb = x86_emit_mov_reg_imm64(cb, X86_RAX, X86_SYS_MMAP)
    cb = x86_emit_syscall(cb)
    cb = x86_emit_mov_rr(cb, X86_R15, X86_RAX)
    cb = x86_emit_mov_rr(cb, X86_RSI, X86_R15)
    cb = x86_emit_mov_reg_imm32(cb, SCR as int, 32)
    cb = x86_emit_add_rr(cb, X86_RSI, SCR as int)
    cb = x86_emit_mov_mem_reg(cb, X86_R15, 0, X86_RSI)

    if n_funcs > 0 do
        main_idx = x86_find_func_index(lir_funcs, fat_str_new("main"))
        if main_idx < 0 do
            main_idx = 0
        end
        call_at = codebuf_offset(cb)
        cb = x86_emit_call_rel32(cb, 0)
        main_off = vec_get_rt(func_offs, main_idx)
        cb = patch_rel32(cb, call_at + 1, main_off as int)
    end

    cb = x86_emit_mov_reg_imm64(cb, X86_RDI, 0)
    cb = x86_emit_mov_reg_imm64(cb, X86_RAX, X86_SYS_EXIT)
    cb = x86_emit_syscall(cb)
    cb = x86_emit_mov_rr(cb, X86_RSP, X86_RBP)
    cb = x86_emit_pop(cb, X86_RBP)
    cb = x86_emit_ret(cb)

    out cb
end.

export emit_lir_module_x86_64
