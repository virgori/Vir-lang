##
 * vir/compiler/lir_codegen_x86.vri — LIR to Machine Code (x86_64)
 * ================================================================
 * System V AMD64. Mirror of lir_codegen.vri (ARM64).
 ##

include types
include vec_rt
import vec_new_rt, vec_push_rt, vec_get_rt, vec_set_rt, vec_len_rt from vec_rt
include string_rt
import fat_str_eq, fat_str_new, native_read_i64, native_write_i64, native_read_u8 from string_rt
include compiler.lir
include vir.compiler.context
import print_str from vir.compiler.context
import sys_exit from vir.rt.syscall
import LirOp, LirOperandType, LirOperand, LirInstr, LirBlock, LirFunc, lir_func_stack_size, LIR_CMP_EQ, LIR_CMP_NE, LIR_CMP_GT, LIR_CMP_LT, LIR_CMP_GE, LIR_CMP_LE, LIR_JMP_IF, LIR_JMP_IFNOT, LIR_RT_UNRESOLVED, LIR_RT_POW, LIR_RT_MATMUL, LIR_RT_FMA, LIR_RT_ALLOC, LIR_RT_PRINT_STR, LIR_RT_GET_ARG, LIR_RT_ARG_COUNT, LIR_RT_STR_CAT, LIR_RT_INT_TO_STR, LIR_RT_NATIVE_READ_U8, LIR_RT_NATIVE_WRITE_U8, LIR_RT_NATIVE_READ_I64, LIR_RT_NATIVE_WRITE_I64, LIR_RT_VOLATILE_READ, LIR_RT_VOLATILE_WRITE, LIR_RT_VOLATILE_READ8, LIR_RT_VOLATILE_WRITE8, LIR_RT_DMB, LIR_RT_DSB, LIR_RT_ISB, LIR_RT_WFI, LIR_RT_WFE, LIR_RT_SEV, LIR_RT_NOP, LIR_RT_ATOMIC_LOAD32, LIR_RT_ATOMIC_STORE32, LIR_RT_ATOMIC_ADD32, LIR_RT_ATOMIC_SUB32, LIR_RT_ATOMIC_CAS32, LIR_RT_ATOMIC_EXCHANGE32, LIR_RT_ATOMIC_LOAD64, LIR_RT_ATOMIC_STORE64, LIR_RT_ATOMIC_ADD64, LIR_RT_ATOMIC_SUB64, LIR_RT_ATOMIC_CAS64, LIR_RT_ATOMIC_EXCHANGE64, LIR_RT_QUANTIZE, LIR_RT_BACKWARD, LIR_RT_MATMUL_F64, LIR_RT_FMA_F64, LIR_RT_STUB_COUNT from compiler.lir
include compiler.mir
import MIR_INTR_PRINT, MIR_INTR_PRINT_STR, MIR_INTR_PARAM, MIR_INTR_GLOBAL_LOAD, MIR_INTR_GLOBAL_STORE, MIR_INTR_BUILTIN, MIR_INTR_STR_LIT, MIR_INTR_INTERP, MIR_INTR_BUNDLE, MIR_INTR_ADDR_OF, MIR_INTR_CAST, MIR_INTR_NOP_MARKER, MIR_INTR_DECL, MIR_INTR_QUIET, MIR_INTR_CHECK_CPU, MIR_INTR_PATCH_POINT, MIR_INTR_PRECOMP, MIR_INTR_EXPOSE, MIR_INTR_ASYNC, MIR_INTR_ATOMIC_VAR, MIR_INTR_TIMEOUT, MIR_INTR_ISOLATE, MIR_INTR_PTR, MIR_INTR_AWAIT_PASS, MIR_INTR_ENSURE, MIR_INTR_REVERT, MIR_INTR_ENUM, MIR_INTR_ERROR, MIR_INTR_EXIST, MIR_INTR_INDEX, MIR_INTR_INDEX_STORE, MIR_INTR_FIELD, MIR_INTR_FIELD_STORE, MIR_INTR_ENTITY, MIR_INTR_ARRAY, MIR_INTR_TUPLE, MIR_INTR_INFER, MIR_INTR_TRAIN, MIR_INTR_REACTIVE, MIR_INTR_MORPH, MIR_INTR_QUANTIZE, MIR_INTR_BACKWARD, MIR_INTR_ARENA from compiler.mir
include compiler.ffi_imports
import ffi_import_find, ffi_import_mark_used from compiler.ffi_imports
include compiler.codegen
import codebuf_new, codebuf_emit_byte, codebuf_emit_u32, codebuf_offset, codebuf_patch_i32, TargetArch, CodeBuf from compiler.codegen
include compiler.codegen_x86
import X86_RAX, X86_RCX, X86_RDX, X86_RBX, X86_RSP, X86_RBP, X86_RSI, X86_RDI, X86_R8, X86_R9, X86_R10, X86_R11, X86_R12, X86_R13, X86_R14, X86_R15 from compiler.codegen_x86
import x86_emit_mov_reg_imm64, x86_emit_mov_reg_imm32, x86_emit_mov_rr, x86_emit_call_rel32, x86_emit_push, x86_emit_pop, x86_emit_ret, x86_emit_syscall, x86_arg_reg from compiler.codegen_x86
import x86_emit_add_rr, x86_emit_sub_rr, x86_emit_imul_rr, x86_emit_xor_rr, x86_emit_and_rr, x86_emit_or_rr from compiler.codegen_x86
import x86_emit_cmp_rr, x86_emit_cmp_imm0, x86_emit_test_rr, x86_emit_cqo, x86_emit_idiv from compiler.codegen_x86
import x86_emit_sete, x86_emit_setne, x86_emit_setg, x86_emit_setl, x86_emit_setge, x86_emit_setle from compiler.codegen_x86
import x86_emit_jmp_rel32, x86_emit_je_rel32, x86_emit_jne_rel32, x86_emit_jg_rel32, x86_emit_jl_rel32, x86_emit_jge_rel32, x86_emit_jle_rel32 from compiler.codegen_x86
import x86_emit_sub_rsp_imm, x86_emit_add_rsp_imm, x86_emit_mov_reg_mem, x86_emit_mov_mem_reg, x86_emit_nop, x86_emit_shl_cl, x86_emit_shr_cl, x86_emit_not_rr from compiler.codegen_x86
import x86_emit_sub_rsp_imm, x86_emit_add_rsp_imm, x86_emit_mov_reg_mem, x86_emit_mov_mem_reg, x86_emit_nop, x86_emit_shl_cl, x86_emit_shr_cl, x86_emit_not_rr, x86_emit_neg_r, x86_emit_shr_imm, x86_emit_shl_imm, x86_emit_cmp_reg_imm32, x86_emit_and_imm8 from compiler.codegen_x86
const X86_SYS_EXIT   = 60
const X86_SYS_WRITE  = 1
const X86_SYS_MMAP   = 9
const X86_MAP_ANON   = 0x20
const X86_MAP_PRIVATE = 0x02
const X86_PROT_RW    = 3

const SCR  = X86_R10
const SCR2 = X86_R11
const SCRQ = X86_RCX

func vec_new_cap_rt_x86(cap: int):
    base = alloc(16 + cap * 8)
    data = base + 16
    native_write_i64(base, 0, cap as i64)
    native_write_i64(base, 8, 0)
    out data
end.

func patch_rel32(cb: CodeBuf, rel_off: int, dest_off: int):
    rel = dest_off - (rel_off + 4)
    out codebuf_patch_i32(cb, rel_off, rel)
end.

func x86_fixup_new(at_off: i64, target_block: i64, kind: i64):
    p = alloc(24)
    native_write_i64(p, 0, at_off)
    native_write_i64(p, 8, target_block)
    native_write_i64(p, 16, kind)
    out p
end.

func x86_fixup_at_off(fx: i64): out native_read_i64(fx, 0) end.
func x86_fixup_target_block(fx: i64): out native_read_i64(fx, 8) end.
func x86_fixup_kind(fx: i64): out native_read_i64(fx, 16) end.

func x86_call_fixup_new(at_off: i64, target_kind: i64, target_id: i64):
    p = alloc(24)
    native_write_i64(p, 0, at_off)
    native_write_i64(p, 8, target_kind)
    native_write_i64(p, 16, target_id)
    out p
end.

func x86_str_fixup_new(at_off: i64, str_val: i64, rd: i64):
    p = alloc(24)
    native_write_i64(p, 0, at_off)
    native_write_i64(p, 8, str_val)
    native_write_i64(p, 16, rd)
    out p
end.

func x86_intr_is_marker(kind: i64):
    if kind == MIR_INTR_NOP_MARKER or kind == MIR_INTR_DECL or kind == MIR_INTR_QUIET or kind == MIR_INTR_CHECK_CPU or kind == MIR_INTR_PATCH_POINT or kind == MIR_INTR_PRECOMP or kind == MIR_INTR_EXPOSE or kind == MIR_INTR_ASYNC or kind == MIR_INTR_ATOMIC_VAR or kind == MIR_INTR_TIMEOUT or kind == MIR_INTR_ISOLATE or kind == MIR_INTR_PTR or kind == MIR_INTR_AWAIT_PASS or kind == MIR_INTR_ENSURE or kind == MIR_INTR_REVERT or kind == MIR_INTR_ENUM or kind == MIR_INTR_ERROR or kind == MIR_INTR_EXIST or kind == MIR_INTR_REACTIVE or kind == MIR_INTR_MORPH do
        out 1
    end

    out 0
end.

func x86_intr_is_payload(kind: i64):
    if kind == MIR_INTR_ADDR_OF or kind == MIR_INTR_CAST do
        out 1
    end
    out 0
end.

func x86_stub_for_builtin_id(bid: i64):
    if bid == 11 do out LIR_RT_STR_CAT end
    if bid == 19 do out LIR_RT_INT_TO_STR end
    if bid == 3 or bid == 35 or bid == 49 or bid == 50 do out LIR_RT_ALLOC end
    if bid == 5 do out LIR_RT_NATIVE_READ_U8 end
    if bid == 6 do out LIR_RT_NATIVE_WRITE_U8 end
    if bid == 7 or bid == 46 do out LIR_RT_NATIVE_READ_I64 end
    if bid == 8 or bid == 47 do out LIR_RT_NATIVE_WRITE_I64 end
    if bid == 23 do out LIR_RT_GET_ARG end
    if bid == 24 do out LIR_RT_ARG_COUNT end
    if bid == 54 or bid == 60 or bid == 62 do out LIR_RT_VOLATILE_READ end
    if bid == 55 or bid == 61 or bid == 63 do out LIR_RT_VOLATILE_WRITE end
    if bid == 56 or bid == 58 do out LIR_RT_VOLATILE_READ8 end
    if bid == 57 or bid == 59 do out LIR_RT_VOLATILE_WRITE8 end
    if bid == 64 or bid == 39 do out LIR_RT_DMB end
    if bid == 65 do out LIR_RT_DSB end
    if bid == 66 do out LIR_RT_ISB end
    if bid == 67 do out LIR_RT_WFI end
    if bid == 68 do out LIR_RT_WFE end
    if bid == 69 do out LIR_RT_SEV end
    if bid == 70 do out LIR_RT_NOP end
    if bid == 40 or bid == 78 do out LIR_RT_ATOMIC_LOAD64 end
    if bid == 72 do out LIR_RT_ATOMIC_LOAD32 end
    if bid == 41 or bid == 79 do out LIR_RT_ATOMIC_STORE64 end
    if bid == 73 do out LIR_RT_ATOMIC_STORE32 end
    if bid == 43 or bid == 80 do out LIR_RT_ATOMIC_ADD64 end
    if bid == 74 do out LIR_RT_ATOMIC_ADD32 end
    if bid == 44 or bid == 81 do out LIR_RT_ATOMIC_SUB64 end
    if bid == 75 do out LIR_RT_ATOMIC_SUB32 end
    if bid == 42 or bid == 82 do out LIR_RT_ATOMIC_CAS64 end
    if bid == 76 do out LIR_RT_ATOMIC_CAS32 end
    if bid == 71 or bid == 83 do out LIR_RT_ATOMIC_EXCHANGE64 end
    if bid == 77 do out LIR_RT_ATOMIC_EXCHANGE32 end
    if bid == 4 do out LIR_RT_NOP end
    if bid == 105 do out LIR_RT_PLATFORM end
    out 0 - 1
end.

var g_x86_func_index_source: i64 = 0
var g_x86_func_index_buckets: i64 = 0

func x86_func_name_hash(name: string):
    data = native_read_i64(name as i64, 0)
    n = native_read_i64(name as i64, 8)
    h = n * 17
    var i = 0
    when i < n loop
        h = h * 131 + native_read_u8(data, i)
        i = i + 1
    end
    if h < 0 do h = 0 - h end
    out h mod 256
end.

func x86_prepare_func_index(lir_funcs: i64):
    held_funcs = lir_funcs
    buckets = vec_new_cap_rt_x86(256)
    var bi = 0
    when bi < 256 loop
        buckets = vec_push_rt(buckets, 0)
        bi = bi + 1
    end
    n = vec_len_rt(held_funcs)
    var i = 0
    when i < n loop
        lf = vec_get_rt(held_funcs, i)
        fn_name = native_read_i64(lf as i64, 8) as string
        bid = x86_func_name_hash(fn_name)
        bucket = vec_get_rt(buckets, bid)
        if bucket == 0 do bucket = vec_new_rt() end
        bucket = vec_push_rt(bucket, i)
        vec_set_rt(buckets, bid, bucket)
        i = i + 1
    end
    g_x86_func_index_source = held_funcs
    g_x86_func_index_buckets = buckets
end.

func x86_find_func_index(lir_funcs: i64, name: string):
    # Do not trust pointer-identity cache invalidation across self-hosted arena
    # generations; the same address may hold a newly allocated LIR vector.
    n = vec_len_rt(lir_funcs)
    var i = 0
    when i < n loop
        lf = vec_get_rt(lir_funcs, i)
        if lf != 0 do
            fn_name = native_read_i64(lf as i64, 8) as string
            if (fn_name as i64) != 0 and fat_str_eq(fn_name, name) == 1 do out i end
        end
        i = i + 1
    end
    out 0 - 1
end.

func resolve_reg_x86(opnd: LirOperand, assigned_phys: i64):
    if (opnd as i64) == 0 do
        out 0 - 1
    end
    typ = native_read_i64(opnd as i64, 0)
    if typ == 1 do # VRegInt
        if assigned_phys >= 0 do
            out vec_get_rt(assigned_phys, native_read_i64(opnd as i64, 8))
        end
        out native_read_i64(opnd as i64, 8)
    end
    if typ == 3 do # PhysReg
        out native_read_i64(opnd as i64, 16)
    end
    out 0 - 1
end.

func resolve_or_imm_reg_x86(cb: CodeBuf, opnd: LirOperand, assigned_phys: i64, scratch: i64):
    if (opnd as i64) == 0 do
        out scratch
    end
    r = resolve_reg_x86(opnd, assigned_phys)
    if r >= 0 do
        out r
    end
    typ = native_read_i64(opnd as i64, 0)
    if typ == 5 do # Imm
        imm_val = native_read_i64(opnd as i64, 32)
        cb = x86_emit_mov_reg_imm64(cb, scratch as int, imm_val as int)
        out scratch
    end
    if typ == 4 do # StackMem
        off = native_read_i64(opnd as i64, 24)
        if off < 0 do
            cb = x86_emit_mov_reg_imm32(cb, scratch as int, off as int)
            cb = x86_emit_add_rr(cb, scratch as int, X86_RBP)
            cb = x86_emit_mov_reg_mem(cb, scratch as int, scratch as int, 0)
            out scratch
        end
    end
    out scratch
end.

func emit_call_fixup_x86(cb: CodeBuf, call_fixups: i64, target_kind: i64, target_id: i64, rd: i64):
    at = codebuf_offset(cb) as i64
    cb = x86_emit_call_rel32(cb, 0)
    cf = native_read_i64(call_fixups, 0)
    cf = vec_push_rt(cf, x86_call_fixup_new(at, target_kind, target_id))
    native_write_i64(call_fixups, 0, cf)
    if rd >= 0 and rd != X86_RAX do
        cb = x86_emit_mov_rr(cb, rd as int, X86_RAX)
    end
    out cb
end.

func emit_to_rdi(cb: CodeBuf, opnd: LirOperand, assigned_phys: i64):
    r = resolve_or_imm_reg_x86(cb, opnd, assigned_phys, SCR)
    if r >= 0 and r != X86_RDI do
        cb = x86_emit_mov_rr(cb, X86_RDI, r as int)
    end
    out cb
end.

func emit_setcc(cb: CodeBuf, rd: int, pred: i64):
    if pred == LIR_CMP_EQ do
        cb = x86_emit_sete(cb, rd)
    eif pred == LIR_CMP_NE do
        cb = x86_emit_setne(cb, rd)
    eif pred == LIR_CMP_GT do
        cb = x86_emit_setg(cb, rd)
    eif pred == LIR_CMP_LT do
        cb = x86_emit_setl(cb, rd)
    eif pred == LIR_CMP_GE do
        cb = x86_emit_setge(cb, rd)
    eif pred == LIR_CMP_LE do
        cb = x86_emit_setle(cb, rd)
    else
        cb = x86_emit_sete(cb, rd)
    end
    out x86_emit_and_imm8(cb, rd, 1)
end.

func emit_lir_setarg_x86(cb: CodeBuf, ins: LirInstr, assigned_phys: i64, pending_stk: i64):
    ai = native_read_i64(ins as i64, 40)
    src1 = native_read_i64(ins as i64, 24)
    if (src1 as i64) != 0 do
        if native_read_i64(src1 as i64, 0) == (LirOperandType.Imm as i64) do
            ai = native_read_i64(src1 as i64, 32)
        end
    end
    src2 = native_read_i64(ins as i64, 32) as LirOperand
    rval = resolve_or_imm_reg_x86(cb, src2, assigned_phys, SCR)
    if rval < 0 do
        out pending_stk
    end
    if ai >= 0 and ai < 6 do
        areg = x86_arg_reg(ai as int)
        if rval != areg do
            cb = x86_emit_mov_rr(cb, areg, rval as int)
        end
        out pending_stk
    end
    cb = x86_emit_push(cb, rval as int)
    out pending_stk + 1
end.

func emit_lir_intrinsic_x86(cb: CodeBuf, ins: LirInstr, rd: i64, rs1: i64, assigned_phys: i64, call_fixups: i64, func_obj: LirFunc, str_fixups: i64):
    kind = native_read_i64(ins as i64, 40)
    ins_dst = native_read_i64(ins as i64, 16) as LirOperand
    ins_src1 = native_read_i64(ins as i64, 24) as LirOperand
    ins_src2 = native_read_i64(ins as i64, 32) as LirOperand
    if kind == MIR_INTR_STR_LIT or kind == MIR_INTR_INTERP or kind == MIR_INTR_BUNDLE do
        sid = native_read_i64(ins_src1 as i64, 32)
        f_strings = native_read_i64(func_obj as i64, 32)
        if f_strings > 0 and sid >= 0 and sid < vec_len_rt(f_strings) and rd >= 0 do
            s_val = vec_get_rt(f_strings, sid)
            sf = native_read_i64(str_fixups, 0)
            imm_off = (codebuf_offset(cb) + 2) as i64
            sf = vec_push_rt(sf, x86_str_fixup_new(imm_off, s_val as i64, rd))
            native_write_i64(str_fixups, 0, sf)
            cb = x86_emit_mov_reg_imm64(cb, rd as int, 0)
            out cb
        end
        if rd >= 0 do
            cb = x86_emit_mov_reg_imm64(cb, rd as int, 0)
            out cb
        end
        out x86_emit_nop(cb)
    end
    if kind == MIR_INTR_GLOBAL_LOAD do
        slot = native_read_i64(ins_src1 as i64, 32)
        if rd >= 0 and slot >= 0 and slot < 4092 do
            out x86_emit_mov_reg_mem(cb, rd as int, X86_R15, (32 + slot * 8) as int)
        end
        out x86_emit_nop(cb)
    end
    if kind == MIR_INTR_GLOBAL_STORE do
        slot = native_read_i64(ins_dst as i64, 32)
        if slot >= 0 and slot < 4092 do
            global_reg = resolve_or_imm_reg_x86(cb, ins_src1, assigned_phys, SCR)
            out x86_emit_mov_mem_reg(cb, X86_R15, (32 + slot * 8) as int, global_reg as int)
        end
        out x86_emit_nop(cb)
    end
    if x86_intr_is_marker(kind) == 1 do
        out x86_emit_nop(cb)
    end
    if kind == MIR_INTR_TRAIN do
        cb = x86_emit_mov_reg_imm32(cb, SCR as int, 1)
        cb = x86_emit_mov_mem_reg(cb, X86_R15, 8, SCR as int)
        cb = x86_emit_xor_rr(cb, SCR as int, SCR as int)
        cb = x86_emit_mov_mem_reg(cb, X86_R15, 16, SCR as int)
        cb = x86_emit_mov_mem_reg(cb, X86_R15, 24, SCR as int)
        out cb
    end
    if kind == MIR_INTR_INFER do
        cb = x86_emit_xor_rr(cb, SCR as int, SCR as int)
        cb = x86_emit_mov_mem_reg(cb, X86_R15, 8, SCR as int)
        out cb
    end
    if kind == MIR_INTR_QUANTIZE do
        cb = x86_emit_mov_rr(cb, X86_RSI, X86_RDI)
        cb = emit_to_rdi(cb, ins_src1, assigned_phys)
        out emit_call_fixup_x86(cb, call_fixups, 1, LIR_RT_QUANTIZE, rd)
    end
    if kind == MIR_INTR_BACKWARD do
        out emit_call_fixup_x86(cb, call_fixups, 1, LIR_RT_BACKWARD, rd)
    end
    if kind == MIR_INTR_PARAM do
        abi = native_read_i64(ins_src1 as i64, 32)
        if rd >= 0 and abi >= 0 and abi < 6 do
            areg = x86_arg_reg(abi as int)
            if rd != areg do
                cb = x86_emit_mov_rr(cb, rd as int, areg)
            end
            out cb
        end
        if abi >= 6 and rd >= 0 do
            # SysV AMD64 ABI: stack parameters start at [RBP + 16]
            off = 16 + ((abi - 6) * 8)
            cb = x86_emit_mov_reg_imm32(cb, SCR as int, off as int)
            cb = x86_emit_add_rr(cb, SCR as int, X86_RBP)
            cb = x86_emit_mov_reg_mem(cb, rd as int, SCR as int, 0)
            out cb
        end
        out x86_emit_nop(cb)
    end
    if kind == MIR_INTR_BUILTIN do
        bid = native_read_i64(ins_src1 as i64, 32)
        stub = x86_stub_for_builtin_id(bid)
        if stub < 0 do
            stub = LIR_RT_UNRESOLVED
        end
        out emit_call_fixup_x86(cb, call_fixups, 1, stub, rd)
    end
    if kind == MIR_INTR_PRINT do
        cb = emit_to_rdi(cb, ins_src1, assigned_phys)
        out emit_call_fixup_x86(cb, call_fixups, 1, MIR_INTR_PRINT, rd)
    end
    if kind == MIR_INTR_PRINT_STR do
        var target_src2 = ins_src1
        if (target_src2 as i64) == 0 or native_read_i64(target_src2 as i64, 0) == 0 do
            target_src2 = ins_src2
        end
        cb = emit_to_rdi(cb, target_src2, assigned_phys)
        out emit_call_fixup_x86(cb, call_fixups, 1, LIR_RT_PRINT_STR, rd)
    end
    if x86_intr_is_payload(kind) == 1 do
        if rd >= 0 do
            if native_read_i64(ins_src1 as i64, 0) == (LirOperandType.Imm as i64) do
                cb = x86_emit_mov_reg_imm64(cb, rd as int, native_read_i64(ins_src1 as i64, 32) as int)
                out cb
            eif rs1 >= 0 do
                cb = x86_emit_mov_rr(cb, rd as int, rs1 as int)
                out cb
            end
        end
        out x86_emit_nop(cb)
    end
    if kind == MIR_INTR_INDEX do
        # SetArg(0) places the flattened index in RDI.  Tensor elements start
        # after the 16-byte [len, cap] header.
        if rd >= 0 and rs1 >= 0 do
            cb = x86_emit_mov_rr(cb, X86_RAX, rs1 as int)
            cb = x86_emit_mov_rr(cb, SCR as int, X86_RDI)
            cb = x86_emit_mov_reg_imm32(cb, X86_RCX, 3)
            cb = x86_emit_shl_cl(cb, SCR as int)
            cb = x86_emit_add_rr(cb, SCR as int, X86_RAX)
            cb = x86_emit_mov_reg_mem(cb, rd as int, SCR as int, 16)
            out cb
        end
        out x86_emit_nop(cb)
    end
    if kind == MIR_INTR_INDEX_STORE do
        # SetArg(0/1) places index/value in RDI/RSI.
        if rs1 >= 0 do
            cb = x86_emit_mov_rr(cb, X86_RAX, rs1 as int)
            cb = x86_emit_mov_rr(cb, SCR as int, X86_RDI)
            cb = x86_emit_mov_reg_imm32(cb, X86_RCX, 3)
            cb = x86_emit_shl_cl(cb, SCR as int)
            cb = x86_emit_add_rr(cb, SCR as int, X86_RAX)
            cb = x86_emit_mov_mem_reg(cb, SCR as int, 16, X86_RSI)
            out cb
        end
        out x86_emit_nop(cb)
    end
    if kind == MIR_INTR_FIELD do
        if rd >= 0 and rs1 >= 0 do
            cb = x86_emit_mov_reg_mem(cb, rd as int, rs1 as int, 0)
            out cb
        end
        out x86_emit_nop(cb)
    end
    if kind == MIR_INTR_FIELD_STORE do
        if rs1 >= 0 do
            cb = x86_emit_mov_mem_reg(cb, rs1 as int, 0, X86_RSI)
            out cb
        end
        out x86_emit_nop(cb)
    end
    if kind == MIR_INTR_ARENA do
        if rd >= 0 do
            cb = x86_emit_mov_reg_mem(cb, rd as int, X86_R15, 0)
            out cb
        end
        if rs1 >= 0 do
            cb = x86_emit_mov_mem_reg(cb, X86_R15, 0, rs1 as int)
            out cb
        end
        out x86_emit_nop(cb)
    end
    cb = emit_to_rdi(cb, ins_src1, assigned_phys)
    stub2 = kind
    if stub2 < 1 or stub2 >= LIR_RT_STUB_COUNT do
        stub2 = LIR_RT_UNRESOLVED
    end
    out emit_call_fixup_x86(cb, call_fixups, 1, stub2, rd)
end.

func x86_stub_for_callee_name(cname: string):
    if fat_cstr_eq(cname, "read_byte") or fat_cstr_eq(cname, "native_read_u8") or fat_cstr_eq(cname, "read_u8") or fat_cstr_eq(cname, "read8") or rt_streq(cname as int, "read_byte") or rt_streq(cname as int, "native_read_u8") or rt_streq(cname as int, "read_u8") or rt_streq(cname as int, "read8") do out LIR_RT_NATIVE_READ_U8 end
    if fat_cstr_eq(cname, "write_byte") or fat_cstr_eq(cname, "native_write_u8") or fat_cstr_eq(cname, "write_u8") or fat_cstr_eq(cname, "write8") or rt_streq(cname as int, "write_byte") or rt_streq(cname as int, "native_write_u8") or rt_streq(cname as int, "write_u8") or rt_streq(cname as int, "write8") do out LIR_RT_NATIVE_WRITE_U8 end
    if fat_cstr_eq(cname, "read_word") or fat_cstr_eq(cname, "native_read_i64") or fat_cstr_eq(cname, "read_i64") or fat_cstr_eq(cname, "read64") or rt_streq(cname as int, "read_word") or rt_streq(cname as int, "native_read_i64") or rt_streq(cname as int, "read_i64") or rt_streq(cname as int, "read64") do out LIR_RT_NATIVE_READ_I64 end
    if fat_cstr_eq(cname, "write_word") or fat_cstr_eq(cname, "native_write_i64") or fat_cstr_eq(cname, "write_i64") or fat_cstr_eq(cname, "write64") or rt_streq(cname as int, "write_word") or rt_streq(cname as int, "native_write_i64") or rt_streq(cname as int, "write_i64") or rt_streq(cname as int, "write64") do out LIR_RT_NATIVE_WRITE_I64 end
    if fat_cstr_eq(cname, "get_arg") or fat_cstr_eq(cname, "rt_argv") or fat_cstr_eq(cname, "rt_get_arg") or rt_streq(cname as int, "get_arg") or rt_streq(cname as int, "rt_argv") or rt_streq(cname as int, "rt_get_arg") do out LIR_RT_GET_ARG end
    if fat_cstr_eq(cname, "arg_count") or fat_cstr_eq(cname, "rt_argc") or rt_streq(cname as int, "arg_count") or rt_streq(cname as int, "rt_argc") do out LIR_RT_ARG_COUNT end
    if fat_cstr_eq(cname, "alloc") or fat_cstr_eq(cname, "vir_alloc") or rt_streq(cname as int, "alloc") or rt_streq(cname as int, "vir_alloc") do out LIR_RT_ALLOC end
    if fat_cstr_eq(cname, "free") or fat_cstr_eq(cname, "vir_free") or fat_cstr_eq(cname, "dealloc") or rt_streq(cname as int, "free") or rt_streq(cname as int, "vir_free") or rt_streq(cname as int, "dealloc") do out LIR_RT_NOP end
    if fat_cstr_eq(cname, "print_str") or rt_streq(cname as int, "print_str") do out LIR_RT_PRINT_STR end
    if fat_cstr_eq(cname, "vir_get_platform") or fat_cstr_eq(cname, "sys_platform") or rt_streq(cname as int, "vir_get_platform") or rt_streq(cname as int, "sys_platform") do out LIR_RT_PLATFORM end
    if fat_cstr_eq(cname, "exit") or fat_cstr_eq(cname, "exit_prog") or fat_cstr_eq(cname, "sys_exit") or rt_streq(cname as int, "exit") or rt_streq(cname as int, "exit_prog") or rt_streq(cname as int, "sys_exit") do out LIR_RT_EXIT_PROG end
    out 0 - 1
end.

func emit_lir_call_x86(cb: CodeBuf, ins: LirInstr, rd: i64, func_obj: LirFunc, lir_funcs: i64, call_fixups: i64, pending_stk: i64):
    sid = native_read_i64(ins as i64, 40)
    target_kind = 1
    target_id = LIR_RT_UNRESOLVED
    var cname = fat_str_new("")
    f_strings = native_read_i64(func_obj as i64, 32)
    if f_strings > 0 and sid >= 0 and sid < vec_len_rt(f_strings) do
        cname = vec_get_rt(f_strings, sid)
        fi = x86_find_func_index(lir_funcs, cname)
        if fi >= 0 do
            target_kind = 0
            target_id = fi
        else
            ffi_id = ffi_import_find(cname)
            if ffi_id >= 0 do
                target_kind = 3
                target_id = ffi_id
                ffi_import_mark_used(ffi_id as int)
            else
                stub_id = x86_stub_for_callee_name(cname)
                if stub_id >= 0 do
                    target_kind = 1
                    target_id = stub_id
                end
            end
        end
    end
    if target_id == LIR_RT_UNRESOLVED do
        print_str("virc: linker error: unresolved direct function call: ")
        print_str(cname)
        print_str("\n")
        sys_exit(1)
    end
    cb = emit_call_fixup_x86(cb, call_fixups, target_kind, target_id, rd)
    if pending_stk > 0 do
        bytes = pending_stk * 8
        if bytes > 0 and bytes <= 4096 do
            cb = x86_emit_add_rsp_imm(cb, bytes)
        end
    end
    out 0
end.

func emit_lir_rt_print_stub_x86(cb: CodeBuf):
    cb = x86_emit_push(cb, X86_RBP)
    cb = x86_emit_mov_rr(cb, X86_RBP, X86_RSP)
    cb = x86_emit_sub_rsp_imm(cb, 64)
    cb = x86_emit_mov_rr(cb, X86_RAX, X86_RDI)
    cb = x86_emit_mov_reg_imm32(cb, X86_RCX, 10)
    cb = x86_emit_mov_reg_imm64(cb, X86_RSI, 0)
    cb = x86_emit_mov_reg_imm32(cb, SCR as int, 48)
    cb = x86_emit_cmp_imm0(cb, X86_RAX)
    cb = x86_emit_jne_rel32(cb, 0)
    zero_jmp = codebuf_offset(cb) - 6
    cb = x86_emit_mov_mem_reg(cb, X86_RBP, 0 - 1, SCR as int)
    cb = x86_emit_mov_reg_imm64(cb, X86_RDX, 1)
    cb = x86_emit_mov_rr(cb, X86_RSI, X86_RBP)
    cb = x86_emit_mov_reg_imm32(cb, SCR as int, 1)
    cb = x86_emit_sub_rr(cb, X86_RSI, SCR as int)
    cb = x86_emit_jmp_rel32(cb, 0)
    done_jmp = codebuf_offset(cb)
    cb = patch_rel32(cb, zero_jmp + 2, codebuf_offset(cb))
    loop_top = codebuf_offset(cb)
    cb = x86_emit_xor_rr(cb, X86_RDX, X86_RDX)
    cb = x86_emit_div_idiv(cb)
    cb = x86_emit_mov_reg_imm32(cb, SCR as int, 48)
    cb = x86_emit_add_rr(cb, SCR as int, X86_RDX)
    cb = x86_emit_sub_rsp_imm(cb, 1)
    cb = x86_emit_mov_mem_reg(cb, X86_RSP, 0, SCR as int)
    cb = x86_emit_add_rr(cb, X86_RSI, 1)
    cb = x86_emit_cmp_imm0(cb, X86_RAX)
    rel = loop_top - (codebuf_offset(cb) + 6)
    cb = x86_emit_jne_rel32(cb, rel)
    cb = x86_emit_mov_rr(cb, X86_RDX, X86_RSI)
    cb = x86_emit_mov_rr(cb, X86_RSI, X86_RSP)
    cb = patch_rel32(cb, done_jmp + 1, codebuf_offset(cb))
    cb = patch_rel32(cb, done_jmp - 4, codebuf_offset(cb))
    cb = x86_emit_mov_reg_imm64(cb, X86_RAX, X86_SYS_WRITE)
    cb = x86_emit_mov_reg_imm64(cb, X86_RDI, 1)
    cb = x86_emit_syscall(cb)
    # Emit newline \n:
    cb = codebuf_emit_byte(cb, 0x6A)
    cb = codebuf_emit_byte(cb, 0x0A)
    cb = x86_emit_mov_rr(cb, X86_RSI, X86_RSP)
    cb = x86_emit_mov_reg_imm64(cb, X86_RDX, 1)
    cb = x86_emit_mov_reg_imm64(cb, X86_RDI, 1)
    cb = x86_emit_mov_reg_imm64(cb, X86_RAX, X86_SYS_WRITE)
    cb = x86_emit_syscall(cb)
    cb = x86_emit_pop(cb, SCR as int)
    cb = x86_emit_mov_rr(cb, X86_RSP, X86_RBP)
    cb = x86_emit_pop(cb, X86_RBP)
    out x86_emit_ret(cb)
end.

func emit_lir_rt_str_cat_stub_x86(cb: CodeBuf):
    # RDI = a, RSI = b, R15 = ptr to bump pointer -> RAX = newly allocated concatenated string
    cb = codebuf_emit_byte(cb, 0x49); cb = codebuf_emit_byte(cb, 0x89); cb = codebuf_emit_byte(cb, 0xF8) # mov r8, rdi
    cb = codebuf_emit_byte(cb, 0x41); cb = codebuf_emit_byte(cb, 0x80); cb = codebuf_emit_byte(cb, 0x38); cb = codebuf_emit_byte(cb, 0x00) # cmp byte ptr [r8], 0
    cb = codebuf_emit_byte(cb, 0x74); cb = codebuf_emit_byte(cb, 0x05) # je +5
    cb = codebuf_emit_byte(cb, 0x49); cb = codebuf_emit_byte(cb, 0xFF); cb = codebuf_emit_byte(cb, 0xC0) # inc r8
    cb = codebuf_emit_byte(cb, 0xEB); cb = codebuf_emit_byte(cb, 0xF5) # jmp -11
    cb = codebuf_emit_byte(cb, 0x4D); cb = codebuf_emit_byte(cb, 0x89); cb = codebuf_emit_byte(cb, 0xC2) # mov r10, r8
    cb = codebuf_emit_byte(cb, 0x49); cb = codebuf_emit_byte(cb, 0x29); cb = codebuf_emit_byte(cb, 0xFA) # sub r10, rdi
    cb = codebuf_emit_byte(cb, 0x49); cb = codebuf_emit_byte(cb, 0x89); cb = codebuf_emit_byte(cb, 0xF1) # mov r9, rsi
    cb = codebuf_emit_byte(cb, 0x41); cb = codebuf_emit_byte(cb, 0x80); cb = codebuf_emit_byte(cb, 0x39); cb = codebuf_emit_byte(cb, 0x00) # cmp byte ptr [r9], 0
    cb = codebuf_emit_byte(cb, 0x74); cb = codebuf_emit_byte(cb, 0x05) # je +5
    cb = codebuf_emit_byte(cb, 0x49); cb = codebuf_emit_byte(cb, 0xFF); cb = codebuf_emit_byte(cb, 0xC1) # inc r9
    cb = codebuf_emit_byte(cb, 0xEB); cb = codebuf_emit_byte(cb, 0xF5) # jmp -11
    cb = codebuf_emit_byte(cb, 0x4D); cb = codebuf_emit_byte(cb, 0x89); cb = codebuf_emit_byte(cb, 0xCB) # mov r11, r9
    cb = codebuf_emit_byte(cb, 0x49); cb = codebuf_emit_byte(cb, 0x29); cb = codebuf_emit_byte(cb, 0xF3) # sub r11, rsi
    cb = codebuf_emit_byte(cb, 0x4B); cb = codebuf_emit_byte(cb, 0x8D); cb = codebuf_emit_byte(cb, 0x4C); cb = codebuf_emit_byte(cb, 0x1A); cb = codebuf_emit_byte(cb, 0x01) # lea rcx, [r10+r11+1]
    cb = codebuf_emit_byte(cb, 0x48); cb = codebuf_emit_byte(cb, 0x83); cb = codebuf_emit_byte(cb, 0xC1); cb = codebuf_emit_byte(cb, 0x07) # add rcx, 7
    cb = codebuf_emit_byte(cb, 0x48); cb = codebuf_emit_byte(cb, 0x83); cb = codebuf_emit_byte(cb, 0xE1); cb = codebuf_emit_byte(cb, 0xF8) # and rcx, -8
    cb = codebuf_emit_byte(cb, 0x49); cb = codebuf_emit_byte(cb, 0x8B); cb = codebuf_emit_byte(cb, 0x07) # mov rax, [r15]
    cb = codebuf_emit_byte(cb, 0x48); cb = codebuf_emit_byte(cb, 0x89); cb = codebuf_emit_byte(cb, 0xC2) # mov rdx, rax
    cb = codebuf_emit_byte(cb, 0x48); cb = codebuf_emit_byte(cb, 0x01); cb = codebuf_emit_byte(cb, 0xCA) # add rdx, rcx
    cb = codebuf_emit_byte(cb, 0x49); cb = codebuf_emit_byte(cb, 0x89); cb = codebuf_emit_byte(cb, 0x17) # mov [r15], rdx
    cb = codebuf_emit_byte(cb, 0x48); cb = codebuf_emit_byte(cb, 0x89); cb = codebuf_emit_byte(cb, 0xC2) # mov rdx, rax
    cb = codebuf_emit_byte(cb, 0x49); cb = codebuf_emit_byte(cb, 0x89); cb = codebuf_emit_byte(cb, 0xF8) # mov r8, rdi
    cb = codebuf_emit_byte(cb, 0x41); cb = codebuf_emit_byte(cb, 0x80); cb = codebuf_emit_byte(cb, 0x38); cb = codebuf_emit_byte(cb, 0x00) # cmp byte ptr [r8], 0
    cb = codebuf_emit_byte(cb, 0x74); cb = codebuf_emit_byte(cb, 0x0D) # je +13
    cb = codebuf_emit_byte(cb, 0x41); cb = codebuf_emit_byte(cb, 0x8A); cb = codebuf_emit_byte(cb, 0x08) # mov cl, [r8]
    cb = codebuf_emit_byte(cb, 0x88); cb = codebuf_emit_byte(cb, 0x0A) # mov [rdx], cl
    cb = codebuf_emit_byte(cb, 0x49); cb = codebuf_emit_byte(cb, 0xFF); cb = codebuf_emit_byte(cb, 0xC0) # inc r8
    cb = codebuf_emit_byte(cb, 0x48); cb = codebuf_emit_byte(cb, 0xFF); cb = codebuf_emit_byte(cb, 0xC2) # inc rdx
    cb = codebuf_emit_byte(cb, 0xEB); cb = codebuf_emit_byte(cb, 0xED) # jmp -19
    cb = codebuf_emit_byte(cb, 0x49); cb = codebuf_emit_byte(cb, 0x89); cb = codebuf_emit_byte(cb, 0xF1) # mov r9, rsi
    cb = codebuf_emit_byte(cb, 0x41); cb = codebuf_emit_byte(cb, 0x80); cb = codebuf_emit_byte(cb, 0x39); cb = codebuf_emit_byte(cb, 0x00) # cmp byte ptr [r9], 0
    cb = codebuf_emit_byte(cb, 0x74); cb = codebuf_emit_byte(cb, 0x0D) # je +13
    cb = codebuf_emit_byte(cb, 0x41); cb = codebuf_emit_byte(cb, 0x8A); cb = codebuf_emit_byte(cb, 0x09) # mov cl, [r9]
    cb = codebuf_emit_byte(cb, 0x88); cb = codebuf_emit_byte(cb, 0x0A) # mov [rdx], cl
    cb = codebuf_emit_byte(cb, 0x49); cb = codebuf_emit_byte(cb, 0xFF); cb = codebuf_emit_byte(cb, 0xC1) # inc r9
    cb = codebuf_emit_byte(cb, 0x48); cb = codebuf_emit_byte(cb, 0xFF); cb = codebuf_emit_byte(cb, 0xC2) # inc rdx
    cb = codebuf_emit_byte(cb, 0xEB); cb = codebuf_emit_byte(cb, 0xED) # jmp -19
    cb = codebuf_emit_byte(cb, 0xC6); cb = codebuf_emit_byte(cb, 0x02); cb = codebuf_emit_byte(cb, 0x00) # mov byte ptr [rdx], 0
    out x86_emit_ret(cb)
end.

func emit_lir_rt_int_to_str_stub_x86(cb: CodeBuf):
    # RDI = signed int n, R15 = ptr to bump pointer -> RAX = ptr to freshly bump-allocated decimal string
    cb = codebuf_emit_byte(cb, 0x49); cb = codebuf_emit_byte(cb, 0x8B); cb = codebuf_emit_byte(cb, 0x07) # mov rax, [r15]
    cb = codebuf_emit_byte(cb, 0x48); cb = codebuf_emit_byte(cb, 0x8D); cb = codebuf_emit_byte(cb, 0x48); cb = codebuf_emit_byte(cb, 0x20) # lea rcx, [rax+32]
    cb = codebuf_emit_byte(cb, 0x49); cb = codebuf_emit_byte(cb, 0x89); cb = codebuf_emit_byte(cb, 0x0F) # mov [r15], rcx
    cb = codebuf_emit_byte(cb, 0x4C); cb = codebuf_emit_byte(cb, 0x8D); cb = codebuf_emit_byte(cb, 0x40); cb = codebuf_emit_byte(cb, 0x1F) # lea r8, [rax+31]
    cb = codebuf_emit_byte(cb, 0x41); cb = codebuf_emit_byte(cb, 0xC6); cb = codebuf_emit_byte(cb, 0x00); cb = codebuf_emit_byte(cb, 0x00) # mov byte ptr [r8], 0
    cb = codebuf_emit_byte(cb, 0x48); cb = codebuf_emit_byte(cb, 0x89); cb = codebuf_emit_byte(cb, 0xF9) # mov rcx, rdi
    cb = codebuf_emit_byte(cb, 0x45); cb = codebuf_emit_byte(cb, 0x31); cb = codebuf_emit_byte(cb, 0xC9) # xor r9d, r9d
    cb = codebuf_emit_byte(cb, 0x48); cb = codebuf_emit_byte(cb, 0x85); cb = codebuf_emit_byte(cb, 0xC9) # test rcx, rcx
    cb = codebuf_emit_byte(cb, 0x79); cb = codebuf_emit_byte(cb, 0x09) # jns +9
    cb = codebuf_emit_byte(cb, 0x41); cb = codebuf_emit_byte(cb, 0xB9); cb = codebuf_emit_byte(cb, 0x01); cb = codebuf_emit_byte(cb, 0x00); cb = codebuf_emit_byte(cb, 0x00); cb = codebuf_emit_byte(cb, 0x00) # mov r9d, 1
    cb = codebuf_emit_byte(cb, 0x48); cb = codebuf_emit_byte(cb, 0xF7); cb = codebuf_emit_byte(cb, 0xD9) # neg rcx
    cb = codebuf_emit_byte(cb, 0x48); cb = codebuf_emit_byte(cb, 0x89); cb = codebuf_emit_byte(cb, 0xC8) # mov rax, rcx
    cb = codebuf_emit_byte(cb, 0x49); cb = codebuf_emit_byte(cb, 0xC7); cb = codebuf_emit_byte(cb, 0xC2); cb = codebuf_emit_byte(cb, 0x0A); cb = codebuf_emit_byte(cb, 0x00); cb = codebuf_emit_byte(cb, 0x00); cb = codebuf_emit_byte(cb, 0x00) # mov r10, 10
    cb = codebuf_emit_byte(cb, 0x31); cb = codebuf_emit_byte(cb, 0xD2) # xor edx, edx
    cb = codebuf_emit_byte(cb, 0x49); cb = codebuf_emit_byte(cb, 0xF7); cb = codebuf_emit_byte(cb, 0xF2) # div r10
    cb = codebuf_emit_byte(cb, 0x80); cb = codebuf_emit_byte(cb, 0xC2); cb = codebuf_emit_byte(cb, 0x30) # add dl, 48
    cb = codebuf_emit_byte(cb, 0x49); cb = codebuf_emit_byte(cb, 0xFF); cb = codebuf_emit_byte(cb, 0xC8) # dec r8
    cb = codebuf_emit_byte(cb, 0x41); cb = codebuf_emit_byte(cb, 0x88); cb = codebuf_emit_byte(cb, 0x10) # mov [r8], dl
    cb = codebuf_emit_byte(cb, 0x48); cb = codebuf_emit_byte(cb, 0x85); cb = codebuf_emit_byte(cb, 0xC0) # test rax, rax
    cb = codebuf_emit_byte(cb, 0x75); cb = codebuf_emit_byte(cb, 0xED) # jne -19
    cb = codebuf_emit_byte(cb, 0x45); cb = codebuf_emit_byte(cb, 0x85); cb = codebuf_emit_byte(cb, 0xC9) # test r9d, r9d
    cb = codebuf_emit_byte(cb, 0x74); cb = codebuf_emit_byte(cb, 0x07) # je +7
    cb = codebuf_emit_byte(cb, 0x49); cb = codebuf_emit_byte(cb, 0xFF); cb = codebuf_emit_byte(cb, 0xC8) # dec r8
    cb = codebuf_emit_byte(cb, 0x41); cb = codebuf_emit_byte(cb, 0xC6); cb = codebuf_emit_byte(cb, 0x00); cb = codebuf_emit_byte(cb, 0x2D) # mov byte ptr [r8], 45
    cb = codebuf_emit_byte(cb, 0x4C); cb = codebuf_emit_byte(cb, 0x89); cb = codebuf_emit_byte(cb, 0xC0) # mov rax, r8
    out x86_emit_ret(cb)
end.

func x86_emit_div_idiv(cb: CodeBuf):
    cb = x86_emit_cqo(cb)
    out x86_emit_idiv(cb, X86_RCX)
end.

# Integer tensor dot-product kernel shared by `**` and `><`.
# SysV input: RDI=A, RSI=B, RDX=M, RCX=K, R8=N.
# Tensor storage is [len, cap, row-major i64 elements...].  Integer
# multiplication/addition is exact modulo i64, so the fused form has no
# intermediate rounding to expose.  Floating-point fusion is selected by the
# typed/vector backend; this scalar kernel is the exact portable fallback.
func emit_lir_rt_tensor_dot_stub_x86(cb: CodeBuf):
    cb = x86_emit_push(cb, X86_RBX)
    cb = x86_emit_push(cb, X86_RBP)
    cb = x86_emit_push(cb, X86_R12)
    cb = x86_emit_push(cb, X86_R13)
    cb = x86_emit_push(cb, X86_R14)
    # 0. If autodiff is active (*(R15 + 8) == 1), record RDI (W) and RSI (X):
    cb = x86_emit_mov_reg_mem(cb, X86_RAX, X86_R15, 8)
    cb = x86_emit_cmp_reg_imm32(cb, X86_RAX, 1)
    cb = x86_emit_jne_rel32(cb, 0)
    let fixup_tape = codebuf_offset(cb) as int
    cb = x86_emit_mov_mem_reg(cb, X86_R15, 16, X86_RDI)
    cb = x86_emit_mov_mem_reg(cb, X86_R15, 24, X86_RSI)
    let tape_done_pos = codebuf_offset(cb) as int
    cb = patch_rel32(cb, fixup_tape - 4, tape_done_pos)

    # Preserve inputs and point at element payloads.
    cb = x86_emit_mov_rr(cb, X86_RBX, X86_RDI)
    cb = x86_emit_mov_reg_imm32(cb, X86_RAX, 16)
    cb = x86_emit_add_rr(cb, X86_RBX, X86_RAX)
    cb = x86_emit_mov_rr(cb, X86_R13, X86_RSI)
    cb = x86_emit_add_rr(cb, X86_R13, X86_RAX)
    cb = x86_emit_mov_rr(cb, X86_R12, X86_RDX) # M
    cb = x86_emit_mov_rr(cb, X86_R14, X86_RCX) # K

    # Allocate 16 + M*N*8 bytes, rounded up to 16 bytes, from [R15].
    cb = x86_emit_mov_reg_mem(cb, X86_RBP, X86_R15, 0)
    cb = x86_emit_mov_rr(cb, X86_RAX, X86_R12)
    cb = x86_emit_imul_rr(cb, X86_RAX, X86_R8)
    cb = x86_emit_mov_mem_reg(cb, X86_RBP, 0, X86_RAX)
    cb = x86_emit_mov_mem_reg(cb, X86_RBP, 8, X86_RAX)
    cb = x86_emit_mov_rr(cb, X86_RDI, X86_RAX)
    cb = x86_emit_mov_reg_imm32(cb, X86_RCX, 3)
    cb = x86_emit_shl_cl(cb, X86_RDI)
    cb = x86_emit_mov_reg_imm32(cb, X86_RAX, 31)
    cb = x86_emit_add_rr(cb, X86_RDI, X86_RAX)
    cb = x86_emit_mov_reg_imm32(cb, X86_RAX, 0 - 16)
    cb = x86_emit_and_rr(cb, X86_RDI, X86_RAX)
    cb = x86_emit_add_rr(cb, X86_RDI, X86_RBP)
    cb = x86_emit_mov_mem_reg(cb, X86_R15, 0, X86_RDI)

    # for i in [0,M), j in [0,N), k in [0,K)
    cb = x86_emit_xor_rr(cb, X86_RDI, X86_RDI) # i
    outer_check = codebuf_offset(cb) as int
    cb = x86_emit_cmp_rr(cb, X86_RDI, X86_R12)
    outer_done_at = codebuf_offset(cb) as int
    cb = x86_emit_jge_rel32(cb, 0)

    cb = x86_emit_xor_rr(cb, X86_RSI, X86_RSI) # j
    middle_check = codebuf_offset(cb) as int
    cb = x86_emit_cmp_rr(cb, X86_RSI, X86_R8)
    middle_done_at = codebuf_offset(cb) as int
    cb = x86_emit_jge_rel32(cb, 0)

    cb = x86_emit_xor_rr(cb, X86_R9, X86_R9)   # accumulator
    cb = x86_emit_xor_rr(cb, X86_RDX, X86_RDX) # k
    inner_check = codebuf_offset(cb) as int
    cb = x86_emit_cmp_rr(cb, X86_RDX, X86_R14)
    inner_done_at = codebuf_offset(cb) as int
    cb = x86_emit_jge_rel32(cb, 0)

    # A[i*K+k]
    cb = x86_emit_mov_rr(cb, X86_R10, X86_RDI)
    cb = x86_emit_imul_rr(cb, X86_R10, X86_R14)
    cb = x86_emit_add_rr(cb, X86_R10, X86_RDX)
    cb = x86_emit_mov_reg_imm32(cb, X86_RCX, 3)
    cb = x86_emit_shl_cl(cb, X86_R10)
    cb = x86_emit_add_rr(cb, X86_R10, X86_RBX)
    cb = x86_emit_mov_reg_mem(cb, X86_R10, X86_R10, 0)
    # B[k*N+j]
    cb = x86_emit_mov_rr(cb, X86_R11, X86_RDX)
    cb = x86_emit_imul_rr(cb, X86_R11, X86_R8)
    cb = x86_emit_add_rr(cb, X86_R11, X86_RSI)
    cb = x86_emit_shl_cl(cb, X86_R11)
    cb = x86_emit_add_rr(cb, X86_R11, X86_R13)
    cb = x86_emit_mov_reg_mem(cb, X86_R11, X86_R11, 0)
    cb = x86_emit_imul_rr(cb, X86_R10, X86_R11)
    cb = x86_emit_add_rr(cb, X86_R9, X86_R10)
    cb = x86_emit_mov_reg_imm32(cb, X86_RAX, 1)
    cb = x86_emit_add_rr(cb, X86_RDX, X86_RAX)
    inner_back_at = codebuf_offset(cb) as int
    cb = x86_emit_jmp_rel32(cb, 0)

    inner_done = codebuf_offset(cb) as int
    cb = patch_rel32(cb, inner_done_at + 2, inner_done)
    cb = patch_rel32(cb, inner_back_at + 1, inner_check)
    # C[i*N+j] = accumulator
    cb = x86_emit_mov_rr(cb, X86_R10, X86_RDI)
    cb = x86_emit_imul_rr(cb, X86_R10, X86_R8)
    cb = x86_emit_add_rr(cb, X86_R10, X86_RSI)
    cb = x86_emit_mov_reg_imm32(cb, X86_RCX, 3)
    cb = x86_emit_shl_cl(cb, X86_R10)
    cb = x86_emit_add_rr(cb, X86_R10, X86_RBP)
    cb = x86_emit_mov_mem_reg(cb, X86_R10, 16, X86_R9)
    cb = x86_emit_mov_reg_imm32(cb, X86_RAX, 1)
    cb = x86_emit_add_rr(cb, X86_RSI, X86_RAX)
    middle_back_at = codebuf_offset(cb) as int
    cb = x86_emit_jmp_rel32(cb, 0)

    middle_done = codebuf_offset(cb) as int
    cb = patch_rel32(cb, middle_done_at + 2, middle_done)
    cb = patch_rel32(cb, middle_back_at + 1, middle_check)
    cb = x86_emit_mov_reg_imm32(cb, X86_RAX, 1)
    cb = x86_emit_add_rr(cb, X86_RDI, X86_RAX)
    outer_back_at = codebuf_offset(cb) as int
    cb = x86_emit_jmp_rel32(cb, 0)

    outer_done = codebuf_offset(cb) as int
    cb = patch_rel32(cb, outer_done_at + 2, outer_done)
    cb = patch_rel32(cb, outer_back_at + 1, outer_check)
    cb = x86_emit_mov_rr(cb, X86_RAX, X86_RBP)
    cb = x86_emit_pop(cb, X86_R14)
    cb = x86_emit_pop(cb, X86_R13)
    cb = x86_emit_pop(cb, X86_R12)
    cb = x86_emit_pop(cb, X86_RBP)
    cb = x86_emit_pop(cb, X86_RBX)
    out x86_emit_ret(cb)
end.

