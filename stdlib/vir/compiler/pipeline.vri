##
 * vir/compiler/pipeline.vri — Vir v2.0 Canonical Compiler Pipeline
 * ================================================================
 * Canonical lowering path per vir_language_spec_v2.0_vi.md:
 *
 *   source → lex → parse → semantic → AST→MIR → MIR SSA → MIR Opt → LIR Lower → RegAlloc Graph Coloring → Codegen
 ##

include "stdlib/vir/rt/vec_rt.vri";
import vec_new_rt, vec_push_rt, vec_get_rt, vec_set_rt, vec_len_rt from "stdlib/vir/rt/vec_rt.vri";

include "stdlib/vir/compiler/parser.vri";
import AstNode from "stdlib/vir/compiler/parser.vri";

include "stdlib/vir/compiler/ast_to_mir.vri";
import ast_lower_program, ast_lower_func from "stdlib/vir/compiler/ast_to_mir.vri";

include "stdlib/vir/compiler/mir_cfg.vri";
import mir_build_cfg, mir_compute_dominators from "stdlib/vir/compiler/mir_cfg.vri";

include "stdlib/vir/compiler/mir_ssa.vri";
import mir_insert_phi_nodes from "stdlib/vir/compiler/mir_ssa.vri";

include "stdlib/vir/compiler/mir_opt.vri";
import mir_optimize_all from "stdlib/vir/compiler/mir_opt.vri";

include "stdlib/vir/compiler/lir_lower.vri";
import lir_lower_program from "stdlib/vir/compiler/lir_lower.vri";

include "stdlib/vir/compiler/lir_liveness.vri";
import lir_compute_liveness from "stdlib/vir/compiler/lir_liveness.vri";

include "stdlib/vir/compiler/lir_regalloc_color.vri";
import lir_allocate_registers_color from "stdlib/vir/compiler/lir_regalloc_color.vri";

include "stdlib/vir/compiler/ir_optimizer.vri";
import LowerCtx, lower_ctx_new, lower_program from "stdlib/vir/compiler/ir_optimizer.vri";

func compile_pipeline(source_path: string, ast: AstNode, verbose: int)
    if verbose == 1 do
        print_ln("virc: pipeline — lowering AST to MIR...")
    end

    # 1. AST -> MIR Lowering
    let mir_funcs = ast_lower_program(ast);

    # 2. CFG & Dominator Tree & SSA Phi Insertion & Optimization for each function
    let func_count = vec_len_rt(mir_funcs);
    var i = 0;
    when i < func_count loop
        let mf = vec_get_rt(mir_funcs, i);
        let blocks1 = mir_build_cfg(mf.blocks);
        let blocks2 = mir_compute_dominators(blocks1, 0);
        let blocks3 = mir_insert_phi_nodes(mf, blocks2);
        let blocks4 = mir_optimize_all(blocks3);
        mf.blocks = blocks4;
        vec_set_rt(mir_funcs, i, mf);
        i = i + 1
    end

    if verbose == 1 do
        print_ln("virc: pipeline — lowering MIR to LIR & SSA Destruction...")
    end

    # 3. MIR -> LIR Lowering
    let lir_funcs = lir_lower_program(mir_funcs);

    if verbose == 1 do
        print_ln("virc: pipeline — Chaitin-Briggs Graph Coloring Register Allocation...")
    end

    # 4. Liveness Analysis & Graph Coloring Register Allocation
    i = 0;
    let lir_count = vec_len_rt(lir_funcs);
    when i < lir_count loop
        let lf = vec_get_rt(lir_funcs, i);
        let intervals = lir_compute_liveness(lf);
        var (lf2, phys_map, stack_map) = lir_allocate_registers_color(lf, intervals);
        vec_set_rt(lir_funcs, i, lf2);
        i = i + 1
    end

    if verbose == 1 do
        print_ln("virc: pipeline — lowering complete")
    end

    # Q-IR lower context for machine code generator emission
    let ctx = lower_ctx_new("main");
    ctx = lower_program(ctx, ast);
    out ctx
end.

export compile_pipeline
