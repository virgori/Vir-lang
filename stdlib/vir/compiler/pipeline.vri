##
 * vir/compiler/pipeline.vri — Vir v2.0 Compiler Pipeline
 * ======================================================
 * Canonical lowering path per vir_language_spec_v2.0_vi.md:
 *
 *   source → lex → parse → semantic → HIR → MIR → LIR → Q-IR → codegen
 *
 * C-core (core/build/vir) executes HIR/MIR/LIR by default.
 * Self-hosted driver uses this module for Q-IR lowering + optimization.
 ##

include parser;
import AstNode from parser;
include ir_optimizer;
import LowerCtx, lower_ctx_new, lower_program from ir_optimizer;

func compile_pipeline:
    in  source_path: string;
        ast: AstNode;
        verbose: int

    if verbose == 1 do
        print "pipeline: lowering..."
    end

    let ctx = lower_ctx_new("main");
    ctx = lower_program(ctx, ast);
    out ctx
end.

export compile_pipeline
