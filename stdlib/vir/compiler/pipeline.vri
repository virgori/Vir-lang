##
 * vir/compiler/pipeline.vri — Vir v2.0 Canonical Compiler Pipeline
 * ================================================================
 * Canonical lowering path per vir_language_spec_v2.0_vi.md:
 *
 *   source → lex → parse → semantic → AST→MIR → MIR SSA → MIR Opt → LIR Lower → RegAlloc Graph Coloring → Codegen
 ##

include vir.rt.vec_rt
import vec_new_rt, vec_push_rt, vec_get_rt, vec_set_rt, vec_len_rt from vir.rt.vec_rt

include vir.compiler.parser
import AstNode from vir.compiler.parser

include vir.compiler.ast_to_mir
import ast_lower_program, ast_lower_func from vir.compiler.ast_to_mir

include vir.compiler.hir
include vir.compiler.ast_to_hir
import ast_to_hir_program from vir.compiler.ast_to_hir

include vir.compiler.hir_to_mir
import hir_to_mir_program from vir.compiler.hir_to_mir

include vir.compiler.mir
import MirFunc, mir_func_new, mir_func_id, mir_func_name, mir_func_next_vreg, mir_func_def_uses, mir_func_next_block_id, mir_func_entry_block, mir_func_blocks, mir_func_strings, mir_func_var_buckets from vir.compiler.mir

include vir.compiler.mir_cfg
import mir_build_cfg, mir_compute_dominators from vir.compiler.mir_cfg

include vir.compiler.mir_ssa
import mir_insert_phi_nodes, mir_rename_variables from vir.compiler.mir_ssa

include compiler.context
import print_str, print_int, print_ln from compiler.context

include vir.compiler.mir_opt
import mir_opt_constant_folding, mir_opt_dce, mir_opt_set_program, mir_opt_set_current_func from vir.compiler.mir_opt

include vir.compiler.mir_opt_pipeline
import mir_optimize_all, mir_opt_run_spec_pipeline, set_mir_opt_level, get_mir_opt_level from vir.compiler.mir_opt_pipeline

include vir.compiler.target
import get_codegen_target, TargetArch from vir.compiler.target

include vir.compiler.opt_backend
import opt_backend_run_mir_post, opt_backend_run_lir_post from vir.compiler.opt_backend

include vir.compiler.lir_lower
import lir_lower_program from vir.compiler.lir_lower

include vir.compiler.lir_liveness
import lir_compute_liveness from vir.compiler.lir_liveness

include vir.compiler.lir
import LirFunc, LirBlock from vir.compiler.lir

func lir_func_name(f: LirFunc): out native_read_i64(f as i64, 8) as string end.
func lir_func_blocks(f: LirFunc): out native_read_i64(f as i64, 16) end.
func lir_block_instrs(b: LirBlock): out native_read_i64(b as i64, 8) end.

include vir.compiler.lir_regalloc_color
import lir_allocate_registers_color from vir.compiler.lir_regalloc_color

var g_use_hir_pipeline: int = 0
var g_mir_full_opt: int = 0
var g_mir_opt_level: int = 1

func set_pipeline_hir_mode(mode: int):
    g_use_hir_pipeline = mode
end.

func set_pipeline_mir_full(mode: int):
    g_mir_full_opt = mode
    if mode == 1 do
        set_mir_opt_level(3)
        g_mir_opt_level = 3
    end
end.

func set_pipeline_opt_level(level: int):
    if level < 0 do
        g_mir_opt_level = 0
    eif level > 3 do
        g_mir_opt_level = 3
    else
        g_mir_opt_level = level
    end
    set_mir_opt_level(g_mir_opt_level)
    if g_mir_opt_level >= 2 do g_mir_full_opt = 1 end
end.

func get_pipeline_opt_level():
    out g_mir_opt_level
end.

func compile_pipeline(source_path: string, ast: AstNode, verbose: int):
    var mir_funcs = vec_new_rt()
    if g_use_hir_pipeline == 1 do
        if verbose == 1 do
            print_ln("virc: pipeline — canonical lowering AST -> HIR -> MIR...")
        end
        let hir_funcs = ast_to_hir_program(ast)
        mir_funcs = hir_to_mir_program(hir_funcs)
    else
        if verbose == 1 do
            print_ln("virc: pipeline — lowering AST to MIR...")
        end
        mir_funcs = ast_lower_program(ast)
    end

    # 2. CFG & Dominator Tree & SSA Phi Insertion & Optimization for each function
    mir_opt_set_program(mir_funcs)
    let func_count = vec_len_rt(mir_funcs)
    var i = 0
    when i < func_count loop
        let mf = vec_get_rt(mir_funcs, i)
        let blocks1 = mir_build_cfg(mir_func_blocks(mf))
        let blocks2 = mir_compute_dominators(blocks1, 0)
        let blocks3 = mir_insert_phi_nodes(mf, blocks2)
        var (mf2, blocks4) = mir_rename_variables(mf, blocks3)
        mir_opt_set_current_func(mf2)
        var blocks5 = blocks4
        opt_level = g_mir_opt_level
        if g_mir_full_opt == 1 and opt_level < 2 do opt_level = 3 end
        if opt_level >= 1 or g_mir_full_opt == 1 do
            blocks5 = mir_opt_run_spec_pipeline(blocks4, opt_level)
            blocks5 = opt_backend_run_mir_post(blocks5, get_codegen_target(), opt_level)
        else
            blocks5 = mir_opt_constant_folding(blocks4)
            blocks5 = mir_opt_dce(blocks5)
        end
        mf_new = mir_func_new(
            mir_func_id(mf2),
            mir_func_name(mf2),
            mir_func_next_vreg(mf2),
            mir_func_def_uses(mf2),
            mir_func_next_block_id(mf2),
            mir_func_entry_block(mf2),
            blocks5,
            mir_func_strings(mf2),
            mir_func_var_buckets(mf2)
        )
        vec_set_rt(mir_funcs, i, mf_new)
        i = i + 1
    end

    if verbose == 1 do
        print_ln("virc: pipeline — MIR spec opts (26-pass, arch-neutral) + backend hooks...")
    end

    # 3. MIR -> LIR Lowering
    let lir_funcs = lir_lower_program(mir_funcs)

    if verbose == 1 do
        print_ln("virc: pipeline — Chaitin-Briggs Graph Coloring + George-Appel Move Coalescing...")
    end

    # 4. Liveness Analysis & Graph Coloring Register Allocation
    # Policy: LIR clean first; Briggs assigns/spills; George-Appel IRC coalescing
    # eliminates redundant Mov(Rd, Rs) where Rd == Rs after coloring.
    i = 0
    let lir_count = vec_len_rt(lir_funcs)
    when i < lir_count loop
        let lf = vec_get_rt(lir_funcs, i)
        let intervals = lir_compute_liveness(lf)
        var (lf2, phys_map, stack_map) = lir_allocate_registers_color(lf, intervals)
        lf2 = opt_backend_run_lir_post(lf2, get_codegen_target())
        vec_set_rt(lir_funcs, i, lf2)
        i = i + 1
    end

    if verbose == 1 do
        print_ln("virc: pipeline — LIR lowering complete (Q-IR fallback bypassed)")
    end

    out lir_funcs
end.

export compile_pipeline, set_pipeline_hir_mode, set_pipeline_mir_full, set_pipeline_opt_level, get_pipeline_opt_level
