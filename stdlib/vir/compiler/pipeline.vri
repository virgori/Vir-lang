##
 * vir/compiler/pipeline.vri — Vir v2.0 Canonical Compiler Pipeline
 * ================================================================
 * Canonical lowering path per vir_language_spec_v2.0_vi.md:
 *
 *   source → lex → parse → semantic → AST→MIR → MIR SSA → MIR Opt → LIR Lower → RegAlloc Graph Coloring → Codegen
 ##

include rt.vec_rt
import vec_new_rt, vec_push_rt, vec_get_rt, vec_set_rt, vec_len_rt from rt.vec_rt

include compiler.parser
import AstNode from compiler.parser

include compiler.ast_to_mir
import ast_lower_program, ast_lower_func, set_ast_lower_verbose from compiler.ast_to_mir
import ast_lower_program, ast_lower_func, set_ast_lower_verbose, set_global_prog_ast from compiler.ast_to_mir

include compiler.hir
include compiler.ast_to_hir
import ast_to_hir_program from compiler.ast_to_hir

include compiler.hir_to_mir
import hir_to_mir_program from compiler.hir_to_mir

include compiler.mir
import MirFunc, mir_func_new, mir_func_id, mir_func_name, mir_func_next_vreg, mir_func_def_uses, mir_func_next_block_id, mir_func_entry_block, mir_func_blocks, mir_func_strings, mir_func_var_buckets from compiler.mir

include compiler.mir_cfg
import mir_build_cfg, mir_compute_dominators from compiler.mir_cfg

include compiler.mir_ssa
import mir_insert_phi_nodes, mir_rename_variables from compiler.mir_ssa

include compiler.context
import print_str, print_int, print_ln from compiler.context

include string_rt
import sb_new, sb_append, sb_append_int, sb_to_string, sb_free from string_rt

include compiler.mir_opt
import mir_opt_constant_folding, mir_opt_dce, mir_opt_set_program, mir_opt_set_current_func from compiler.mir_opt

include compiler.mir_opt_pipeline
import mir_optimize_all, mir_opt_run_spec_pipeline, set_mir_opt_level, get_mir_opt_level from compiler.mir_opt_pipeline

include compiler.target
import get_codegen_target, TargetArch from compiler.target

include compiler.opt_backend
import opt_backend_run_mir_post, opt_backend_run_lir_post from compiler.opt_backend
import opt_backend_run_mir_post, opt_backend_run_lir_pre, opt_backend_run_lir_post from compiler.opt_backend

include compiler.lir_lower
import lir_lower_program from compiler.lir_lower

include compiler.lir_liveness
import lir_compute_liveness from compiler.lir_liveness

include compiler.lir
import LirFunc, LirBlock from compiler.lir

func lir_func_name(f: LirFunc): out native_read_i64(f as i64, 8) as string end.
func lir_func_blocks(f: LirFunc): out native_read_i64(f as i64, 16) end.
func lir_block_instrs(b: LirBlock): out native_read_i64(b as i64, 8) end.

include compiler.lir_regalloc_color
import lir_allocate_registers_color from compiler.lir_regalloc_color

var g_use_hir_pipeline: int = 0
var g_mir_full_opt: int = 0
var g_mir_opt_level: int = 1

func set_pipeline_hir_mode(mode: int):
    g_use_hir_pipeline = mode
end.

func set_pipeline_mir_full(mode: int):
    g_mir_full_opt = mode
    if mode == 1 do
        set_mir_opt_level(3)
        g_mir_opt_level = 3
    end
end.

func set_pipeline_opt_level(level: int):
    if level < 0 do
        g_mir_opt_level = 0
    eif level > 3 do
        g_mir_opt_level = 3
    else
        g_mir_opt_level = level
    end
    set_mir_opt_level(g_mir_opt_level)
    if g_mir_opt_level >= 2 do g_mir_full_opt = 1 end
end.

func get_pipeline_opt_level:
    out g_mir_opt_level
end.

func pipeline_print_progress(verbose: int, label: string, cur: i64, total: i64):
    if verbose != 1 do out end
    if cur != 1 & (cur mod 25) != 0 & cur != total do out end
    arena:
        var sb = sb_new()
        sb = sb_append(sb, "virc: pipeline — ")
        sb = sb_append(sb, label)
        sb = sb_append(sb, " ")
        sb = sb_append_int(sb, cur)
        sb = sb_append(sb, "/")
        sb = sb_append_int(sb, total)
        print_ln(sb_to_string(sb))
        sb_free(sb)
    end
end.

func compile_pipeline(source_path: string, ast: AstNode, verbose: int):
    var mir_funcs = vec_new_rt()
    if g_use_hir_pipeline == 1 do
        if verbose == 1 do
            print_ln("virc: pipeline — canonical lowering AST -> HIR -> MIR...")
        end
        set_global_prog_ast(ast)
        let hir_funcs = ast_to_hir_program(ast)
        mir_funcs = hir_to_mir_program(hir_funcs)
    else
        if verbose == 1 do
            print_ln("virc: pipeline — lowering AST to MIR...")
        end
        set_ast_lower_verbose(verbose)
        mir_funcs = ast_lower_program(ast)
        set_ast_lower_verbose(0)
    end

    # 2. CFG & Dominator Tree & SSA Phi Insertion & Optimization for each function
    mir_opt_set_program(mir_funcs)
    let func_count = vec_len_rt(mir_funcs)
    if verbose == 1 do
        arena:
            var sb0 = sb_new()
            sb0 = sb_append(sb0, "virc: pipeline — SSA + MIR opts on ")
            sb0 = sb_append_int(sb0, func_count)
            sb0 = sb_append(sb0, " function(s)...")
            print_ln(sb_to_string(sb0))
            sb_free(sb0)
        end
    end
    var i = 0
    when i < func_count loop
        pipeline_print_progress(verbose, "MIR func", i + 1, func_count)
        let mf = vec_get_rt(mir_funcs, i)
        let blocks1 = mir_build_cfg(mir_func_blocks(mf))
        # CFG dominance and SSA renaming must agree on the same entry block.
        # Most frontend-built functions start at 0, but imported/generated MIR
        # may retain a different valid entry index.
        var entry_idx = mir_func_entry_block(mf)
        if entry_idx < 0 or entry_idx >= vec_len_rt(blocks1) do
            entry_idx = 0
        end
        let blocks2 = mir_compute_dominators(blocks1, entry_idx)
        let blocks3 = mir_insert_phi_nodes(mf, blocks2)
        var (mf2, blocks4) = mir_rename_variables(mf, blocks3)
        mir_opt_set_current_func(mf2)
        var blocks5 = blocks4
        opt_level = g_mir_opt_level
        if g_mir_full_opt == 1 and opt_level < 2 do opt_level = 3 end
        if opt_level >= 1 or g_mir_full_opt == 1 do
            blocks5 = mir_opt_run_spec_pipeline(blocks4, opt_level)
            blocks5 = opt_backend_run_mir_post(blocks5, get_codegen_target(), opt_level)
        else
            blocks5 = mir_opt_constant_folding(blocks4)
            blocks5 = mir_opt_dce(blocks5)
        end
        mf_new = mir_func_new(
            mir_func_id(mf2),
            mir_func_name(mf2),
            mir_func_next_vreg(mf2),
            mir_func_def_uses(mf2),
            mir_func_next_block_id(mf2),
            mir_func_entry_block(mf2),
            blocks5,
            mir_func_strings(mf2),
            mir_func_var_buckets(mf2)
        )
        vec_set_rt(mir_funcs, i, mf_new)
        i = i + 1
    end

    if verbose == 1 do
        print_ln("virc: pipeline — MIR spec opts complete, lowering to LIR...")
    end

    # 3. MIR -> LIR Lowering
    let lir_funcs = lir_lower_program(mir_funcs)

    if verbose == 1 do
        print_ln("virc: pipeline — Chaitin-Briggs regalloc + George-Appel coalescing...")
    end

    # 4. Liveness Analysis & Graph Coloring Register Allocation
    # Policy: LIR clean first; Briggs assigns/spills; George-Appel IRC coalescing
    # eliminates redundant Mov(Rd, Rs) where Rd == Rs after coloring.
    i = 0
    let lir_count = vec_len_rt(lir_funcs)
    when i < lir_count loop
        pipeline_print_progress(verbose, "regalloc func", i + 1, lir_count)
        var lf = vec_get_rt(lir_funcs, i)
        let target_arch = get_codegen_target()

        # Pre-RA LIR hook: branch by target before register allocation
        lf = opt_backend_run_lir_pre(lf, target_arch)

        var lf2 = lf
        if target_arch != TargetArch.Wasm32 and target_arch != 4 do
            let intervals = lir_compute_liveness(lf)
            var (colored_lf, phys_map, stack_map) = lir_allocate_registers_color(lf, intervals)
            lf2 = colored_lf
        end

        # Post-RA LIR hook: completely independent optimizations per target
        lf2 = opt_backend_run_lir_post(lf2, target_arch)
        vec_set_rt(lir_funcs, i, lf2)
        i = i + 1
    end

    if verbose == 1 do
        print_ln("virc: pipeline — LIR lowering complete (Q-IR fallback bypassed)")
    end

    out lir_funcs
end.

export compile_pipeline, set_pipeline_hir_mode, set_pipeline_mir_full, set_pipeline_opt_level, get_pipeline_opt_level
