##
 * vir/compiler/sem_pass4_types.vri
 * ==============================================================
 * Pass 4: Type Resolution (Vir v2.0 Complete).
 * Resolves all primitive and compound type annotation strings (name2)
 * to TypeKind IDs and updates symbol type_id in SymbolTable.
 ##

include vec_rt;
import vec_new_rt, vec_push_rt, vec_get_rt, vec_len_rt from vec_rt;

include string_rt;
import rt_streq, fat_str_eq, fat_str_len, fat_cstr_eq, fat_str_eq, fat_str_len, fat_cstr_eq, rt_strcat, rt_itoa, rt_strlen from string_rt;

include parser;
import AstNode, AstType from parser;

include symbol_table;
import SymbolTable, SymbolKind, SymbolNode, symbol_alloc from symbol_table;

include scope_tree;
import ScopeTree, ScopeKind, ScopeNode, scope_push, scope_pop, scope_add_symbol from scope_tree;

include type_table;
import TypeKind, TYPE_VOID, TYPE_INT, TYPE_FLOAT, TYPE_BOOL, TYPE_STRING from type_table;

func pass4_resolve_types(symbols: SymbolTable, scopes: ScopeTree, node: AstNode)
    pass4_walk(symbols, scopes, node)
end.
func pass4_resolve_type_name(name: string)
    if fat_str_len(name) == 0 do
        out TypeKind.Void
    end
    # Primitive types
    if rt_streq(name, "int") do out TypeKind.Int end
    if rt_streq(name, "i8") do out TypeKind.Int end
    if rt_streq(name, "i16") do out TypeKind.Int end
    if rt_streq(name, "i32") do out TypeKind.Int end
    if rt_streq(name, "i64") do out TypeKind.Int end
    if rt_streq(name, "uint") do out TypeKind.Int end
    if rt_streq(name, "u8") do out TypeKind.Int end
    if rt_streq(name, "u16") do out TypeKind.Int end
    if rt_streq(name, "u32") do out TypeKind.Int end
    if rt_streq(name, "u64") do out TypeKind.Int end
    if rt_streq(name, "float") do out TypeKind.Float end
    if rt_streq(name, "f32") do out TypeKind.Float end
    if rt_streq(name, "f64") do out TypeKind.Float end
    if rt_streq(name, "bool") do out TypeKind.Bool end
    if rt_streq(name, "string") do out TypeKind.String end
    if rt_streq(name, "ptr") do out TypeKind.Pointer end
    if rt_streq(name, "any") do out TypeKind.Void end

    # Compound & Advanced Vir Types (§4.1 - §4.5)
    if rt_streq(name, "array") do out TypeKind.Array end
    if rt_streq(name, "dict") do out TypeKind.Dict end
    if rt_streq(name, "tuple") do out TypeKind.Tuple end
    if rt_streq(name, "ref") or rt_streq(name, "&") do out TypeKind.Ref end
    if rt_streq(name, "mutref") or rt_streq(name, "&mut") do out TypeKind.MutRef end
    if rt_streq(name, "register") do out TypeKind.Register end
    if rt_streq(name, "mold") do out TypeKind.Mold end
    if rt_streq(name, "packed") do out TypeKind.Packed end
    if rt_streq(name, "flux") do out TypeKind.Flux end
    if rt_streq(name, "deck") do out TypeKind.Deck end
    if rt_streq(name, "optional") or rt_streq(name, "option") do out TypeKind.Optional end

    out TypeKind.Entity
end.
func pass4_walk(symbols: SymbolTable, scopes: ScopeTree, node: AstNode)

    if node.node_type == AstType.VarDecl or node.node_type == AstType.ConstDecl do
        if fat_str_len(node.name2) > 0 do
            resolved = pass4_resolve_type_name(node.name2);
            pass4_update_symbol_type(symbols, scopes, node.name, resolved)
        end
        child_count = vec_len_rt(node.children);
        var i = 0;
        when i < child_count loop
            child = vec_get_rt(node.children, i);
            pass4_walk(symbols, scopes, child);
            i = i + 1
        end
        out 0
    end

    if node.node_type == AstType.FuncDef do
        if fat_str_len(node.name2) > 0 do
            ret_type = pass4_resolve_type_name(node.name2);
            pass4_update_func_return(symbols, scopes, node.name, ret_type)
        end
        scope_push(scopes, ScopeKind.Func);
        child_count = vec_len_rt(node.children);
        if child_count > 0 do
            last_idx = child_count - 1;
            var i = 0;
            when i < last_idx loop
                param = vec_get_rt(node.children, i);
                if fat_str_len(param.name2) > 0 do
                    param_type = pass4_resolve_type_name(param.name2);
                    pass4_update_symbol_type(symbols, scopes, param.name, param_type)
                end
                i = i + 1
            end
            body = vec_get_rt(node.children, last_idx);
            pass4_walk(symbols, scopes, body)
        end
        scope_pop(scopes);
        out 0
    end

    if node.node_type == AstType.EntityDef or node.node_type == AstType.PackedDef or node.node_type == AstType.RegisterDef do
        child_count = vec_len_rt(node.children);
        var i = 0;
        when i < child_count loop
            field = vec_get_rt(node.children, i);
            if fat_str_len(field.name2) > 0 do
                field_type = pass4_resolve_type_name(field.name2)
            end
            i = i + 1
        end
        out 0
    end

    if node.node_type == AstType.Block do
        scope_push(scopes, ScopeKind.Block);
        child_count = vec_len_rt(node.children);
        var i = 0;
        when i < child_count loop
            child = vec_get_rt(node.children, i);
            pass4_walk(symbols, scopes, child);
            i = i + 1
        end
        scope_pop(scopes);
        out 0
    end

    # Default: recurse
    child_count = vec_len_rt(node.children);
    var i = 0;
    when i < child_count loop
        child = vec_get_rt(node.children, i);
        pass4_walk(symbols, scopes, child);
        i = i + 1
    end
    out 0
end.
func pass4_update_symbol_type(symbols: SymbolTable, scopes: ScopeTree, name: string, type_kind: TypeKind)
    if fat_str_len(name) == 0 do
        out 0
    end
    curr = scopes.current_id;
    when curr >= 0 loop
        scope_node = vec_get_rt(scopes.scopes, curr);
        count = vec_len_rt(scope_node.symbols);
        var i = 0;
        when i < count loop
            sym_id = vec_get_rt(scope_node.symbols, i);
            sym = vec_get_rt(symbols.symbols, sym_id);
            sym_name = native_read_i64(sym as i64, 8) as string;
            if fat_str_eq(sym_name, name) do
                sym.type_id = type_kind as i64;
                out 0
            end
            i = i + 1
        end
        curr = scope_node.parent_id
    end
    out 0
end.
func pass4_update_func_return(symbols: SymbolTable, scopes: ScopeTree, name: string, ret_type: TypeKind)
    if fat_str_len(name) == 0 do
        out 0
    end
    curr = scopes.current_id;
    when curr >= 0 loop
        scope_node = vec_get_rt(scopes.scopes, curr);
        count = vec_len_rt(scope_node.symbols);
        var i = 0;
        when i < count loop
            sym_id = vec_get_rt(scope_node.symbols, i);
            sym = vec_get_rt(symbols.symbols, sym_id);
            sym_name = native_read_i64(sym as i64, 8) as string;
            if fat_str_eq(sym_name, name) do
                sym.return_type = ret_type as i64;
                out 0
            end
            i = i + 1
        end
        curr = scope_node.parent_id
    end
    out 0
end.

export pass4_resolve_types, pass4_resolve_type_name
