##
 * vir/compiler/virc.vri — Pure Vir Compiler Driver (Zero C/Python)
 * =================================================================
 * The self-hosting Vir compiler entry point. Uses ONLY the vir/rt/*
 * modules (direct syscalls, mmap allocator, raw I/O). No Python,
 * no C runtime, no libc, no external linker.
 *
 * Pipeline
 *   source.vri → lex → parse → lower → regalloc → codegen → Mach-O/ELF
 *
 * This is the file that gets compiled by the Python compiler (Stage 0),
 * then the resulting binary compiles itself (Stage 1), completing bootstrap.
 *
 * Usage
 *   ./virc <input.vri> [-o output] [--target arm64|x86_64] [--format macho|elf]
 ##

module vir.compiler.virc

# ── Runtime layer (pure Vir, no C) ──
include vir.rt.syscall
import sys_exit, sys_write, SYS_EXIT, SYS_WRITE from vir.rt.syscall
include vir.rt.alloc
import vir_alloc, vir_free, vir_realloc, heap_init from vir.rt.alloc
include vir.rt.string_rt
import rt_strlen, rt_strcmp, rt_streq, rt_strcat, rt_strdup,
       rt_itoa, rt_atoi, StringBuilder, sb_new, sb_append,
       sb_append_char, sb_append_int, sb_to_string, sb_free,
       str_from_cstr, fat_str_len from vir.rt.string_rt
include vir.rt.io
import print_str, print_int, print_ln, print_newline, eprint_ln,
       file_open_read, file_read_all, file_close,
       write_file_bytes, read_file_str from vir.rt.io
include vir.rt.vec_rt
import vec_new_rt, vec_push_rt, vec_get_rt, vec_set_rt, vec_len_rt,
       vec_free_rt, bvec_new, bvec_push, bvec_push_u32_le,
       bvec_push_u64_le, bvec_len, bvec_get, bvec_data_ptr,
       bvec_free from vir.rt.vec_rt
include vir.rt.start
import rt_argc, rt_argv from vir.rt.start
# Note: vir.str.string removed — compiler modules use stdlib/vir/string.vri shim instead

# ── Mach-O/ELF emitters — MUST be BEFORE compiler/main (which includes
#    binary.vri) so that these definitions win under "first compiled wins" ──
include vir.rt.macho
import MachOBuilder, macho_new, macho_write_to_file from vir.rt.macho
include vir.rt.elf
import ElfBuilder, elf_new, elf_write_to_file from vir.rt.elf

# ── Compiler modules (self-hosting, pure Vir) ──
include vir.compiler.lexer
import Lexer, TokType, Token, lexer_new, tokenize, lexer_lex from vir.compiler.lexer
include vir.compiler.parser
import Parser, AstNode, AstType, parser_new, parse_program from vir.compiler.parser
include vir.compiler.semantic
import semantic_run from vir.compiler.semantic
include vir.compiler.mir
include vir.compiler.mir_cfg
include vir.compiler.mir_ssa
include vir.compiler.mir_opt
include vir.compiler.ast_to_mir
include vir.compiler.lir
include vir.compiler.lir_liveness
include vir.compiler.lir_interference
include vir.compiler.lir_regalloc_color
include vir.compiler.lir_lower
include vir.compiler.pipeline
import compile_pipeline, set_pipeline_hir_mode from vir.compiler.pipeline
import set_codegen_target from vir.compiler.target
include vir.compiler.ir_optimizer
import LowerCtx, QModule, QOp, lower_ctx_new, lower_program, optimize_module from vir.compiler.ir_optimizer
include vir.compiler.codegen
import TargetArch, CodeBuf, codebuf_new, codebuf_offset,
       codebuf_emit_u32, codebuf_patch_u32, codebuf_get_data, lir_emit_module from vir.compiler.codegen
include vir.compiler.lir_codegen
import emit_lir_module_arm64 from vir.compiler.lir_codegen
include vir.compiler.codegen_x86
include vir.compiler.lir_codegen_x86
import emit_lir_module_x86_64 from vir.compiler.lir_codegen_x86
include vir.compiler.codegen_wasm
import wasm_compile_module, wasm_write_module, QIRFunc from vir.compiler.codegen_wasm
include vir.compiler.main
import codegen_emit_module, emit_macho_executable, emit_macho_with_entry, FuncLayout, expand_includes_text, expand_imports_text, text_ascii_sanitize, g_inc_base, g_inc_err from vir.compiler.main
include vec
import vec_len, vec_get from vec


# ═══════════════════════════════════════════════════════
# Configuration
# ═══════════════════════════════════════════════════════

const VERSION: "virc 2.0.0 (self-hosted)"

entity CompilerConfig:
    input_path:     int;    # string pointer
    output_path:    int;    # string pointer
    target:         int;    # 0=ARM64, 1=x86_64
    out_fmt:        int;    # 0=Mach-O, 1=ELF
    verbose:        int    # 0=quiet, 1=verbose
end.
func default_config:
    out CompilerConfig (
        input_path:  0,
        output_path: 0,
        target:      0,        # ARM64 (default on macOS)
        out_fmt:     0,        # Mach-O (default on macOS)
        verbose:     1
    )
end.
func cstr_ends_with_vri(s: int):
    if s == 0 do out 0 end
    let l = rt_strlen(s)
    if l < 4 do out 0 end
    if native_read_u8(s, l - 4) != 46 do out 0 end
    if native_read_u8(s, l - 3) != 118 do out 0 end
    if native_read_u8(s, l - 2) != 114 do out 0 end
    if native_read_u8(s, l - 1) != 105 do out 0 end
    out 1
end.

# ═══════════════════════════════════════════════════════
# CLI Argument Parsing
# ═══════════════════════════════════════════════════════

func parse_args:
    let argc = arg_count()
    let cfg = default_config()

    var base_idx = 0
    if argc > 1 and cstr_ends_with_vri(get_arg(0)) == 0 do
        base_idx = 1
    end

    if argc <= base_idx do
        print_ln("virc: error_msg: no input file")
        print_ln("Usage: virc <input.vri> [-o output] [--target arm64|x86_64] [--format macho|elf]")
        exit_prog(1)
    end

    # First positional argument is the input file
    cfg.input_path = get_arg(base_idx)

    # Default output: a.out
    cfg.output_path = "a.out"

    var i = base_idx + 1
    when i < argc loop
        let arg = get_arg(i)

        if rt_streq(arg, "-o") do
            if i + 1 < argc do
                i = i + 1
                cfg.output_path = get_arg(i)
            else
                print_ln("virc: error_msg: -o requires an argument")
                exit_prog(1)
            end

        eif rt_streq(arg, "--target") do
            if i + 1 < argc do
                i = i + 1
                let tgt = get_arg(i)
                if rt_streq(tgt, "arm64") or rt_streq(tgt, "aarch64") do
                    cfg.target = 0
                eif rt_streq(tgt, "x86_64") or rt_streq(tgt, "x86-64") do
                    cfg.target = 1
                eif rt_streq(tgt, "wasm32") or rt_streq(tgt, "wasm") do
                    cfg.target = 2
                else
                    print_ln("virc: error_msg: unknown target (use arm64, x86_64 or wasm32)")
                    exit_prog(1)
                end
            end

        eif rt_streq(arg, "--format") do
            if i + 1 < argc do
                i = i + 1
                let fmt = get_arg(i)
                if rt_streq(fmt, "macho") do
                    cfg.out_fmt = 0
                eif rt_streq(fmt, "elf") do
                    cfg.out_fmt = 1
                eif rt_streq(fmt, "wasm") do
                    cfg.out_fmt = 2
                else
                    print_ln("virc: error_msg: unknown format (use macho, elf or wasm)")
                    exit_prog(1)
                end
            end

        eif rt_streq(arg, "--hir") do
            set_pipeline_hir_mode(1)

        eif rt_streq(arg, "-q") or rt_streq(arg, "--quiet") do
            cfg.verbose = 0

        eif rt_streq(arg, "-v") or rt_streq(arg, "--version") do
            print_ln(VERSION)
            exit_prog(0)

        eif rt_streq(arg, "-h") or rt_streq(arg, "--help") do
            print_ln("virc — Vir Self-Hosting Compiler")
            print_ln("")
            print_ln("Usage: virc <input.vri> [-o output] [options]")
            print_ln("")
            print_ln("Options:")
            print_ln("  -o <file>           Output file (default: a.out)")
            print_ln("  --target <arch>     arm64, x86_64 or wasm32 (default: arm64)")
            print_ln("  --format <fmt>      macho, elf or wasm (default: macho)")
            print_ln("  -q, --quiet         Suppress progress messages")
            print_ln("  -v, --version       Print version")
            print_ln("  -h, --help          Print this help")
            exit_prog(0)
        end

        i = i + 1
    end

    out cfg
end.
# ═══════════════════════════════════════════════════════
# Compiler Pipeline
# ═══════════════════════════════════════════════════════

func virc_compile(cfg: CompilerConfig):


    let verbose = cfg.verbose

    # ── Read source file ──
    if verbose == 1 do
        let sb = sb_new()
        sb = sb_append(sb, "virc: reading ")
        sb = sb_append(sb, cfg.input_path)
        sb = sb_append(sb, "...")
        print_ln(sb_to_string(sb))
        sb_free(sb)
    end

    let source_raw = read_file_str(cfg.input_path)
    if source_raw == 0 do
        print_ln("virc: error_msg: cannot read input file")
        exit_prog(1)
    end

    let src_len = rt_strlen(source_raw)
    if verbose == 1 do
        let sb = sb_new()
        sb = sb_append(sb, "virc: ")
        sb = sb_append_int(sb, src_len)
        sb = sb_append(sb, " bytes source")
        print_ln(sb_to_string(sb))
        sb_free(sb)
    end

    # ── Step 0: Preprocess includes + imports ──
    var last_slash = -1
    var pi = 0
    let path_len = rt_strlen(cfg.input_path)
    when pi < path_len loop
        if native_read_u8(cfg.input_path, pi) == 47 do
            last_slash = pi
        end
        pi = pi + 1
    end
    if last_slash >= 0 do
        let dbuf = vir_alloc(last_slash + 1)
        pi = 0
        when pi < last_slash loop
            native_write_u8(dbuf, pi, native_read_u8(cfg.input_path, pi))
            pi = pi + 1
        end
        native_write_u8(dbuf, last_slash, 0)
        g_inc_base = dbuf
    end

    var source_fat = str_from_cstr(source_raw)
    source_fat = text_ascii_sanitize(source_fat)
    source_fat = expand_includes_text(source_fat)
    source_fat = expand_imports_text(source_fat)

    # ── Step 1: Tokenize ──
    if verbose == 1 do
        print_ln("virc: tokenizing...")
    end

    let lex = lexer_new(source_fat)
    lex = tokenize(lex)

    if fat_str_len(lex.error_msg) > 0 do
        let sb = sb_new()
        sb = sb_append(sb, "virc: lex error_msg: ")
        sb = sb_append(sb, lex.error_msg)
        print_ln(sb_to_string(sb))
        sb_free(sb)
        exit_prog(1)
    end

    # Parser expects rt-vec of token pointers; lexer uses collections Vec.
    let tok_count = vec_len(lex.tokens)
    let tok_rt = vec_new_rt()
    let ti = 0
    when ti < tok_count loop
        let tok = vec_get(lex.tokens, ti)
        tok_rt = vec_push_rt(tok_rt, tok)
        ti = ti + 1
    end

    if verbose == 1 do
        let sb = sb_new()
        sb = sb_append(sb, "virc: ")
        sb = sb_append_int(sb, tok_count)
        sb = sb_append(sb, " tokens")
        print_ln(sb_to_string(sb))
        sb_free(sb)
    end

    # ── Step 2: Parse ──
    if verbose == 1 do
        print_ln("virc: parsing...")
    end

    let parser = parser_new(tok_rt)
    var (parser2, ast) = parse_program(parser)

    print_str("VIRC ast ptr=")
    print_int(ast as int)
    print_str(" ast.node_type=")
    print_int(ast.node_type as int)
    print_str(" ast.children ptr=")
    print_int(ast.children)
    print_str(" vec_len=")
    print_int(vec_len_rt(ast.children))
    print_str("\n")

    if verbose == 1 do
        let k_count = vec_len_rt(ast.children)
        let sb_ast = sb_new()
        sb_ast = sb_append(sb_ast, "virc: ast children ")
        sb_ast = sb_append_int(sb_ast, k_count)
        print_ln(sb_to_string(sb_ast))
        sb_free(sb_ast)
    end

    # Report parse errors
    if rt_strlen(parser2.error_msg) > 0 do
        let sb_pe = sb_new()
        sb_pe = sb_append(sb_pe, "virc: parse error (line ")
        sb_pe = sb_append_int(sb_pe, parser2.error_line)
        sb_pe = sb_append(sb_pe, "): ")
        sb_pe = sb_append(sb_pe, parser2.error_msg)
        print_ln(sb_to_string(sb_pe))
        sb_free(sb_pe)
    end

    # ── Step 2.5: Semantic Analysis ──
    if verbose == 1 do
        print_ln("virc: running semantic analysis...")
    end

    let sem_errors = semantic_run(ast, cfg.input_path, verbose)
    if sem_errors > 0 do
        let sb_sem = sb_new()
        sb_sem = sb_append(sb_sem, "virc: compilation aborted — ")
        sb_sem = sb_append_int(sb_sem, sem_errors)
        sb_sem = sb_append(sb_sem, " semantic error(s)")
        print_ln(sb_to_string(sb_sem))
        sb_free(sb_sem)
        exit_prog(1)
    end

    # ── Step 3: Target + pipeline (AST -> MIR -> SSA -> MIR Opt -> LIR -> RegAlloc) ──
    let target_arch = TargetArch.ARM64
    let target_name = "ARM64"
    if cfg.target == 1 do
        target_arch = TargetArch.X86_64
        target_name = "x86_64"
    eif cfg.target == 2 do
        target_arch = TargetArch.Wasm32
        target_name = "wasm32"
    end
    set_codegen_target(target_arch as int)

    if verbose == 1 do
        print_ln("virc: lowering via v2.0 MIR/SSA/LIR pipeline...")
    end

    let lir_funcs = compile_pipeline(cfg.input_path, ast, verbose)

    let func_count = vec_len_rt(lir_funcs)

    if verbose == 1 do
        let sb = sb_new()
        sb = sb_append(sb, "virc: ")
        sb = sb_append_int(sb, func_count)
        sb = sb_append(sb, " function(s) lowered to LIR")
        print_ln(sb_to_string(sb))
        sb_free(sb)
    end

    # ── Step 5: Code Generation directly from LIR ──
    if verbose == 1 do
        let sb = sb_new()
        sb = sb_append(sb, "virc: generating ")
        sb = sb_append(sb, target_name)
        sb = sb_append(sb, " machine code...")
        print_ln(sb_to_string(sb))
        sb_free(sb)
    end

    var code = codebuf_new(target_arch)
    var is_linux = 0
    if cfg.out_fmt == 1 do
        is_linux = 1
    end
    if target_arch == TargetArch.ARM64 do
        code = emit_lir_module_arm64(lir_funcs, is_linux)
    eif target_arch == TargetArch.X86_64 do
        code = emit_lir_module_x86_64(lir_funcs)
    else
        code = lir_emit_module(lir_funcs, target_arch)
    end
    let code_size = codebuf_offset(code)

    if verbose == 1 do
        let sb = sb_new()
        sb = sb_append(sb, "virc: ")
        sb = sb_append_int(sb, code_size)
        sb = sb_append(sb, " bytes machine code")
        print_ln(sb_to_string(sb))
        sb_free(sb)
    end

    # ── Step 6: Emit executable ──
    if verbose == 1 do
        let fmt_name = "Mach-O"
        if cfg.out_fmt == 1 do
            fmt_name = "ELF"
        eif cfg.out_fmt == 2 or cfg.target == 2 do
            fmt_name = "WASM"
        end
        let sb = sb_new()
        sb = sb_append(sb, "virc: linking ")
        sb = sb_append(sb, fmt_name)
        sb = sb_append(sb, " ")
        sb = sb_append(sb, target_name)
        sb = sb_append(sb, " executable...")
        print_ln(sb_to_string(sb))
        sb_free(sb)
    end

    if cfg.target == 2 or cfg.out_fmt == 2 do
        # WASM output: build QIRFunc list from LIR, emit .wasm
        let wasm_funcs = vec_new<QIRFunc>()
        let wfi = 0
        let wfn = vec_len_rt(lir_funcs)
        when wfi < wfn loop
            let lf = vec_get_rt(lir_funcs, wfi)
            wasm_funcs = vec_push<QIRFunc>(wasm_funcs, QIRFunc (
                name: "main",
                param_count: 0,
                body: []
            ))
            wfi = wfi + 1
        end
        wasm_write_module(wasm_funcs, cfg.output_path)
    eif cfg.out_fmt == 0 do
        # Mach-O
        let mb = macho_new(cfg.target)
        let c_data = native_read_i64(code as i64, 8)
        let c_entry = native_read_i64(code as i64, 24)
        native_write_i64(mb as i64, 24, c_data)
        native_write_i64(mb as i64, 40, c_entry)
        macho_write_to_file(mb, cfg.output_path)
    else
        # ELF
        let eb = elf_new(cfg.target)
        let c_data = native_read_i64(code as i64, 8)
        let c_entry = native_read_i64(code as i64, 24)
        native_write_i64(eb as i64, 16, c_data)
        native_write_i64(eb as i64, 32, c_entry)
        elf_write_to_file(eb, cfg.output_path)
    end

    if verbose == 1 do
        let sb = sb_new()
        sb = sb_append(sb, "virc: done! ")
        sb = sb_append(sb, cfg.output_path)
        sb = sb_append(sb, " (")
        sb = sb_append_int(sb, code_size)
        sb = sb_append(sb, " bytes code)")
        print_ln(sb_to_string(sb))
        sb_free(sb)
    end

    out 0
end.
# ═══════════════════════════════════════════════════════
# Entry Point (called from _start via rt/start.vri)
# ═══════════════════════════════════════════════════════

func main:
    print_ln("====================================")
    print_ln("  virc — Vir Self-Hosting Compiler")
    print_ln("  v2.0.0 — HIR/MIR/LIR pipeline")
    print_ln("====================================")

    let cfg = parse_args()
    let result = virc_compile(cfg)
    exit_prog(result)
    out result
end.
export vir_main, virc_compile, parse_args, CompilerConfig
