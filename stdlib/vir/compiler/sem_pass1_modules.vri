##
 * vir/compiler/sem_pass1_modules.vri
 * ==============================================================
 * Pass 1: Module Collection & Import Resolution.
 * Walks top-level statements for ModuleStmt, ImportStmt, ExportStmt, IncludeStmt.
 * Registers module namespaces and imported symbols into scope.
 ##

include vec_rt;
import vec_new_rt, vec_push_rt, vec_get_rt, vec_len_rt from vec_rt;

include string_rt;
import rt_streq, fat_str_eq, fat_str_len, fat_cstr_eq, fat_str_eq, fat_str_len, fat_cstr_eq, rt_strcat, rt_itoa, rt_strlen from string_rt;

include parser;
import AstNode, AstType from parser;

include symbol_table;
import SymbolTable, SymbolKind, SymbolNode, symbol_alloc from symbol_table;

include scope_tree;
import ScopeTree, ScopeKind, ScopeNode, scope_push, scope_pop, scope_add_symbol from scope_tree;

include context;
import DiagnosticEngine, report_error from context;

func pass1_collect_modules(symbols: SymbolTable, scopes: ScopeTree, diag: DiagnosticEngine, node: AstNode)
    pass1_walk(symbols, scopes, diag, node)
end.
func pass1_walk(symbols: SymbolTable, scopes: ScopeTree, diag: DiagnosticEngine, node: AstNode)

    # ModuleStmt (19)
    if node.node_type == AstType.ModuleStmt do
        if fat_str_len(node.name) > 0 do
            pass1_register_module_symbol(symbols, scopes, diag, node.name, node.line)
        end
        out 0
    end

    # ImportStmt (18)
    if node.node_type == AstType.ImportStmt do
        # Case A: import X, Y from MOD
        child_count = vec_len_rt(node.children);
        if child_count > 0 do
            var i = 0;
            when i < child_count loop
                sym_child = vec_get_rt(node.children, i);
                var sym_name = sym_child.name;
                if fat_str_len(sym_child.name2) > 0 do
                    sym_name = sym_child.name2;
                end
                if fat_str_len(sym_name) > 0 do
                    pass1_register_imported_symbol(symbols, scopes, diag, sym_name, sym_child.line)
                end
                i = i + 1
            end
        else
            # Case B: import MOD as ALIAS (or simple import MOD)
            target_name = node.name;
            if fat_str_len(node.name2) > 0 do
                target_name = node.name2
            end
            if fat_str_len(target_name) > 0 do
                pass1_register_imported_symbol(symbols, scopes, diag, target_name, node.line)
            end
        end
        out 0
    end

    # ExportStmt (20)
    if node.node_type == AstType.ExportStmt do
        out 0
    end

    # IncludeStmt (21)
    if node.node_type == AstType.IncludeStmt do
        target_name = node.name;
        if fat_str_len(node.name2) > 0 do
            target_name = node.name2
        end
        if fat_str_len(target_name) > 0 do
            pass1_register_imported_symbol(symbols, scopes, diag, target_name, node.line)
        end
        out 0
    end

    # Recurse into program/block children
    child_count = vec_len_rt(node.children);
    var i = 0;
    when i < child_count loop
        child = vec_get_rt(node.children, i);
        pass1_walk(symbols, scopes, diag, child);
        i = i + 1
    end
    out 0
end.
func pass1_register_module_symbol(symbols: SymbolTable, scopes: ScopeTree, diag: DiagnosticEngine, name: string, line: int)
    sym = SymbolNode (
        kind: SymbolKind.Module,
        name_id: name as i64,
        type_id: 0,
        scope_id: scopes.current_id,
        ast_id: 0,
        is_mutable: false,
        offset: 0,
        param_count: 0,
        return_type: 0,
        parent_id: -1
    );
    sym_id = symbol_alloc(symbols, sym);
    scope_add_symbol(scopes, scopes.current_id, sym_id);
    out sym_id
end.
func pass1_register_imported_symbol(symbols: SymbolTable, scopes: ScopeTree, diag: DiagnosticEngine, name: string, line: int)
    sym = SymbolNode (
        kind: SymbolKind.Variable,
        name_id: name as i64,
        type_id: 0,
        scope_id: scopes.current_id,
        ast_id: 0,
        is_mutable: false,
        offset: 0,
        param_count: 0,
        return_type: 0,
        parent_id: -1
    );
    sym_id = symbol_alloc(symbols, sym);
    scope_add_symbol(scopes, scopes.current_id, sym_id);
    out sym_id
end.

export pass1_collect_modules
