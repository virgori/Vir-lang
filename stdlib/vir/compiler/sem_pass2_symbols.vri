##
 * vir/compiler/sem_pass2_symbols.vri
 * ==============================================================
 * Pass 2: Symbol Registration (Vir v2.0 Complete).
 * Walks the top-level AST and registers all functions, entities,
 * packed/register structs, enums, variables, constants, and builtins.
 ##

include vec_rt;
import vec_new_rt, vec_push_rt, vec_get_rt, vec_len_rt from vec_rt;

include string_rt;
import rt_streq, rt_strcat, rt_itoa, rt_strlen from string_rt;

include parser;
import AstNode, AstType from parser;

include symbol_table;
import SymbolTable, SymbolKind, SymbolNode, symbol_alloc, symbol_lookup_in_scope from symbol_table;

include scope_tree;
import ScopeTree, ScopeKind, ScopeNode, scope_push, scope_pop, scope_add_symbol from scope_tree;

include context;
import DiagnosticEngine, report_error from context;

func pass2_register_symbols(symbols: SymbolTable, scopes: ScopeTree, diag: DiagnosticEngine, node: AstNode)
    # 1. Register builtin symbols into global scope
    pass2_register_builtins(symbols, scopes);

    # 2. Walk AST for declarations
    pass2_walk_node(symbols, scopes, diag, node)
end.
func pass2_register_builtins(symbols: SymbolTable, scopes: ScopeTree)
    pass2_register_builtin_one(symbols, scopes, "len", 1);
    pass2_register_builtin_one(symbols, scopes, "push", 2);
    pass2_register_builtin_one(symbols, scopes, "alloc", 1);
    pass2_register_builtin_one(symbols, scopes, "free", 1);
    pass2_register_builtin_one(symbols, scopes, "print", 1);
    pass2_register_builtin_one(symbols, scopes, "input", 0);
    pass2_register_builtin_one(symbols, scopes, "strcat", 2);
    pass2_register_builtin_one(symbols, scopes, "itoa", 1)
end.
func pass2_register_builtin_one(symbols: SymbolTable, scopes: ScopeTree, name: string, param_count: int)
    found = pass2_lookup_name_in_scope(symbols, scopes, 0, name);
    if found != -1 do
        out 0
    end
    sym = SymbolNode (
        kind: SymbolKind.Builtin,
        name_id: name >> i64,
        type_id: 0,
        scope_id: 0,
        ast_id: 0,
        is_mutable: false,
        offset: 0,
        param_count: param_count,
        return_type: 0,
        parent_id: -1
    );
    sym_id = symbol_alloc(symbols, sym);
    scope_add_symbol(scopes, 0, sym_id);
    out sym_id
end.
func pass2_walk_node(symbols: SymbolTable, scopes: ScopeTree, diag: DiagnosticEngine, node: AstNode)

    if node.node_type == AstType.FuncDef do
        pass2_register(symbols, scopes, diag, node.name, SymbolKind.Func, node.line);
        out 0
    end

    if node.node_type == AstType.EntityDef or node.node_type == AstType.PackedDef or node.node_type == AstType.RegisterDef do
        pass2_register(symbols, scopes, diag, node.name, SymbolKind.Entity, node.line);
        scope_push(scopes, ScopeKind.Entity);
        child_count = vec_len_rt(node.children);
        var i = 0;
        when i < child_count loop
            child = vec_get_rt(node.children, i);
            if child.node_type == AstType.VarDecl do
                pass2_register(symbols, scopes, diag, child.name, SymbolKind.Variable, child.line)
            end
            if child.node_type == AstType.FuncDef do
                pass2_register(symbols, scopes, diag, child.name, SymbolKind.Func, child.line)
            end
            i = i + 1
        end
        scope_pop(scopes);
        out 0
    end

    if node.node_type == AstType.EnumDef do
        pass2_register(symbols, scopes, diag, node.name, SymbolKind.Enum, node.line);
        child_count = vec_len_rt(node.children);
        var i = 0;
        when i < child_count loop
            variant = vec_get_rt(node.children, i);
            pass2_register(symbols, scopes, diag, variant.name, SymbolKind.Variant, variant.line);
            i = i + 1
        end
        out 0
    end

    if node.node_type == AstType.VarDecl do
        pass2_register(symbols, scopes, diag, node.name, SymbolKind.Variable, node.line);
        out 0
    end

    if node.node_type == AstType.ConstDecl do
        pass2_register(symbols, scopes, diag, node.name, SymbolKind.Const, node.line);
        out 0
    end

    if node.node_type == AstType.ExternFunc do
        if rt_strlen(node.name) > 0 do
            pass2_register(symbols, scopes, diag, node.name, SymbolKind.Func, node.line)
        end
        out 0
    end

    # Recurse into block/program children
    child_count = vec_len_rt(node.children);
    var i = 0;
    when i < child_count loop
        child = vec_get_rt(node.children, i);
        pass2_walk_node(symbols, scopes, diag, child);
        i = i + 1
    end
    out 0
end.
func pass2_register(symbols: SymbolTable, scopes: ScopeTree, diag: DiagnosticEngine, name: string, kind: SymbolKind, line: int)
    if rt_strlen(name) == 0 do
        out 0
    end
    # Check redefinition in current scope
    found = pass2_lookup_name_in_scope(symbols, scopes, scopes.current_id, name);
    if found != -1 do
        report_error(diag, 1001, line, 0);
        out found
    end
    # Create and register symbol
    sym = SymbolNode (
        kind: kind,
        name_id: name >> i64,
        type_id: 0,
        scope_id: scopes.current_id,
        ast_id: 0,
        is_mutable: kind == SymbolKind.Variable,
        offset: 0,
        param_count: 0,
        return_type: 0,
        parent_id: -1
    );
    sym_id = symbol_alloc(symbols, sym);
    scope_add_symbol(scopes, scopes.current_id, sym_id);
    out sym_id
end.
func pass2_lookup_name_in_scope(symbols: SymbolTable, scopes: ScopeTree, scope_id: int, name: string)
    scope_node = vec_get_rt(scopes.scopes, scope_id);
    count = vec_len_rt(scope_node.symbols);
    var i = 0;
    when i < count loop
        sym_id = vec_get_rt(scope_node.symbols, i);
        sym = vec_get_rt(symbols.symbols, sym_id);
        sym_name = sym.name_id >> string;
        if rt_streq(sym_name, name) do
            out sym_id
        end
        i = i + 1
    end
    out -1
end.

export pass2_register_symbols
