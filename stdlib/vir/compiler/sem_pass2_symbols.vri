    pass2_register_builtin_one(symbols, scopes, fat_str_new("sev"), 0)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("nop"), 0)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("đọc_nạp"), 1)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("ghi_nạp"), 2)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("đọc_nạp8"), 1)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("ghi_nạp8"), 2)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("đọc_nạp32"), 1)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("ghi_nạp32"), 2)
    # Atomic primitives
    pass2_register_builtin_one(symbols, scopes, fat_str_new("atomic_load"), 1)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("atomic_store"), 2)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("atomic_add"), 2)
