##
 * vir/compiler/sem_pass2_symbols.vri
 * ==============================================================
 * Pass 2: Symbol Registration (Vir v2.0 Complete).
 * Walks the top-level AST and registers all functions, entities,
 * packed/register structs, enums, variables, constants, and builtins.
 ##

include vec_rt
import vec_new_rt, vec_push_rt, vec_get_rt, vec_len_rt from vec_rt

include string_rt
import fat_str_new, rt_streq, fat_str_eq, fat_str_len, fat_cstr_eq, rt_strcat, rt_itoa, rt_strlen from string_rt

include parser
import AstNode, AstType from parser

include compiler.symbol_table
import SymbolTable, SymbolKind, SymbolNode, symbol_alloc, symbol_lookup_in_scope from compiler.symbol_table

include compiler.scope_tree
import ScopeTree, ScopeKind, ScopeNode, scope_push, scope_pop, scope_add_symbol from compiler.scope_tree

include compiler.context
import DiagnosticEngine, report_error from compiler.context

func pass2_register_symbols(symbols: SymbolTable, scopes: ScopeTree, diag: DiagnosticEngine, node: AstNode)
    # 1. Register builtin symbols into global scope
    pass2_register_builtins(symbols, scopes)

    # 2. Walk AST for declarations
    pass2_walk_node(symbols, scopes, diag, node)
end.
func pass2_register_builtins(symbols: SymbolTable, scopes: ScopeTree)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("len"), 1)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("push"), 2)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("alloc"), 1)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("dealloc"), 1)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("free"), 1)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("read_byte"), 2)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("write_byte"), 3)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("read_word"), 2)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("write_word"), 3)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("str_len"), 1)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("str_get"), 2)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("str_cat"), 2)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("str_eq"), 2)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("file_open"), 2)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("file_read"), 3)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("file_write"), 3)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("file_close"), 1)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("file_write_byte"), 2)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("exit"), 1)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("exit_prog"), 1)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("i_to_str"), 1)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("int_to_str"), 1)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("str_to_i"), 1)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("str_to_int"), 1)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("arr_new"), 1)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("print"), 1)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("print_str"), 1)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("get_arg"), 1)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("arg_count"), 0)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("strcat"), 2)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("itoa"), 1)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("arena_alloc"), 1)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("arena_new"), 1)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("arena_free"), 1)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("arena_reset"), 0)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("vùng_cấp"), 1)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("vùng_mới"), 1)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("vùng_giải"), 1)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("volatile_read"), 1)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("volatile_write"), 2)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("volatile_read8"), 1)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("volatile_write8"), 2)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("volatile_read16"), 1)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("volatile_write16"), 2)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("volatile_read32"), 1)
