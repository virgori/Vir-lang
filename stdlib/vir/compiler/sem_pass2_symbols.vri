    pass2_register_builtin_one(symbols, scopes, fat_str_new("atomic_cas"), 3)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("atomic_exchange"), 2)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("atomic_swap"), 2)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("atomic_load32"), 1)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("atomic_store32"), 2)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("atomic_add32"), 2)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("atomic_sub32"), 2)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("atomic_cas32"), 3)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("atomic_exchange32"), 2)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("atomic_swap32"), 2)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("atomic_load64"), 1)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("atomic_store64"), 2)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("atomic_add64"), 2)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("atomic_sub64"), 2)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("atomic_cas64"), 3)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("atomic_exchange64"), 2)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("atomic_swap64"), 2)
    # Vietnamese aliases
    pass2_register_builtin_one(symbols, scopes, fat_str_new("nạp_nguyên_tử"), 1)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("lưu_nguyên_tử"), 2)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("cộng_nguyên_tử"), 2)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("trừ_nguyên_tử"), 2)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("so_đổi_nguyên_tử"), 3)
    pass2_register_builtin_one(symbols, scopes, fat_str_new("tráo_nguyên_tử"), 2)
end.
func pass2_register_builtin_one(symbols: SymbolTable, scopes: ScopeTree, name: string, param_count: int)
    found = pass2_lookup_name_in_scope(symbols, scopes, 0, name)
    if found != -1 do
        out 0
    end
    sym = SymbolNode (
        kind: SymbolKind.Builtin,
        name_id: name as i64,
        type_id: 0,
        scope_id: 0,
        ast_id: 0,
        is_mutable: false,
        offset: 0,
        param_count: param_count,
        return_type: 0,
        parent_id: -1
    )
    sym_id = symbol_alloc(symbols, sym)
    scope_add_symbol(scopes, 0, sym_id)
    out sym_id
end.
func pass2_walk_node(symbols: SymbolTable, scopes: ScopeTree, diag: DiagnosticEngine, node: AstNode)

    if node.node_type == AstType.BindAttr do
        child_count = vec_len_rt(node.children)
        if child_count > 0 do
            child = vec_get_rt(node.children, 0)
            pass2_walk_node(symbols, scopes, diag, child)
        end
        out 0
    end

    if node.node_type == AstType.FuncDef do
        pass2_register(symbols, scopes, diag, node.name, SymbolKind.Func, node.line)
        out 0
    end

    if node.node_type == AstType.EntityDef or node.node_type == AstType.PackedDef or node.node_type == AstType.RegisterDef do
        pass2_register(symbols, scopes, diag, node.name, SymbolKind.Entity, node.line)
        scope_push(scopes, ScopeKind.Entity)
        child_count = vec_len_rt(node.children)
        var i = 0
        when i < child_count loop
            child = vec_get_rt(node.children, i)
            if child.node_type == AstType.VarDecl do
                pass2_register(symbols, scopes, diag, child.name, SymbolKind.Variable, child.line)
            end
            if child.node_type == AstType.FuncDef do
                pass2_register(symbols, scopes, diag, child.name, SymbolKind.Func, child.line)
            end
            i = i + 1
        end
        scope_pop(scopes)
        out 0
    end

    if node.node_type == AstType.EnumDef do
        pass2_register(symbols, scopes, diag, node.name, SymbolKind.Enum, node.line)
        child_count = vec_len_rt(node.children)
        var i = 0
        when i < child_count loop
            variant = vec_get_rt(node.children, i)
            pass2_register(symbols, scopes, diag, variant.name, SymbolKind.Variant, variant.line)
            i = i + 1
        end
        out 0
    end

    if node.node_type == AstType.VarDecl do
        pass2_register(symbols, scopes, diag, node.name, SymbolKind.Variable, node.line)
        out 0
    end

    if node.node_type == AstType.ReactiveDecl do
        if fat_str_len(node.name) > 0 do
            pass2_register(symbols, scopes, diag, node.name, SymbolKind.Variable, node.line)
        end
        out 0
    end

    if node.node_type == AstType.BundleExpr do
        if fat_str_len(node.name) > 0 do
            pass2_register(symbols, scopes, diag, node.name, SymbolKind.Const, node.line)
        end
        out 0
    end

    if node.node_type == AstType.ExposeAttr do
        child_count = vec_len_rt(node.children)
        if child_count > 0 do
            child = vec_get_rt(node.children, 0)
            pass2_walk_node(symbols, scopes, diag, child)
        end
        out 0
    end

    if node.node_type == AstType.ConstDecl do
        pass2_register(symbols, scopes, diag, node.name, SymbolKind.Const, node.line)
        out 0
    end

    if node.node_type == AstType.ExternFunc do
        if fat_str_len(node.name) > 0 do
            pass2_register(symbols, scopes, diag, node.name, SymbolKind.Func, node.line)
        end
        out 0
    end

    # Recurse into block/program children
    child_count = vec_len_rt(node.children)
    var i = 0
    when i < child_count loop
        child = vec_get_rt(node.children, i)
        pass2_walk_node(symbols, scopes, diag, child)
        i = i + 1
    end
    out 0
end.
func pass2_register(symbols: SymbolTable, scopes: ScopeTree, diag: DiagnosticEngine, name: string, kind: SymbolKind, line: int)
    if fat_str_len(name) == 0 do
        out 0
    end
    # Check redefinition in current scope
    found = pass2_lookup_name_in_scope(symbols, scopes, scopes.current_id, name)
    if found != -1 do
        report_error(diag, 1001, line, 0)
        out found
    end
    cstr = native_read_i64(name as i64, 0);
    persistent_name = str_from_cstr(cstr);
    # Create and register symbol
    sym = SymbolNode (
        kind: kind,
        name_id: persistent_name as i64,
        type_id: 0,
        scope_id: scopes.current_id,
        ast_id: 0,
        is_mutable: kind == SymbolKind.Variable,
        offset: 0,
        param_count: 0,
        return_type: 0,
        parent_id: -1
    )
    sym_id = symbol_alloc(symbols, sym)
    scope_add_symbol(scopes, scopes.current_id, sym_id)
    out sym_id
end.
func pass2_lookup_name_in_scope(symbols: SymbolTable, scopes: ScopeTree, scope_id: int, name: string)
    scope_node = vec_get_rt(scopes.scopes, scope_id)
    count = vec_len_rt(scope_node.symbols)
    var i = 0
    when i < count loop
        sym_id = vec_get_rt(scope_node.symbols, i)
        sym = vec_get_rt(symbols.symbols, sym_id)
        sym_name = native_read_i64(sym as i64, 8) as string
        if fat_str_eq(sym_name, name) do
            out sym_id
        end
        i = i + 1
    end
    out -1
end.

export pass2_register_symbols
