##
 * vir/compiler/sem_pass5_infer.vri
 * ==============================================================
 * Pass 5: Type Inference (Vir v2.0 Complete).
 * Infers types for variables without explicit annotations,
 * array/tuple literals, interpolated strings, method calls, and references.
 ##

include vec_rt;
import vec_new_rt, vec_push_rt, vec_get_rt, vec_len_rt from vec_rt;

include string_rt;
import rt_streq, rt_strcat, rt_itoa, rt_strlen from string_rt;

include parser;
import AstNode, AstType, OpType from parser;

include symbol_table;
import SymbolTable, SymbolKind, SymbolNode from symbol_table;

include scope_tree;
import ScopeTree, ScopeKind, ScopeNode, scope_push, scope_pop from scope_tree;

include type_table;
import TypeKind, TYPE_VOID, TYPE_INT, TYPE_FLOAT, TYPE_BOOL, TYPE_STRING from type_table;

func pass5_infer_types(symbols: SymbolTable, scopes: ScopeTree, node: AstNode)
    pass5_walk(symbols, scopes, node)
end.
func pass5_infer_expr(symbols: SymbolTable, scopes: ScopeTree, node: AstNode)
    if node.node_type == AstType.LiteralInt do
        out TypeKind.Int
    end
    if node.node_type == AstType.LiteralFloat do
        out TypeKind.Float
    end
    if node.node_type == AstType.LiteralStr or node.node_type == AstType.InterpExpr do
        out TypeKind.String
    end
    if node.node_type == AstType.Identifier do
        found = pass5_lookup(symbols, scopes, scopes.current_id, node.name);
        if found != -1 do
            sym = vec_get_rt(symbols.symbols, found);
            out sym.type_id >> TypeKind
        end
        out TypeKind.Void
    end
    if node.node_type == AstType.BinOp do
        child_count = vec_len_rt(node.children);
        if child_count >= 2 do
            left = vec_get_rt(node.children, 0);
            right = vec_get_rt(node.children, 1);
            lt = pass5_infer_expr(symbols, scopes, left);
            rt_type = pass5_infer_expr(symbols, scopes, right);
            if lt == TypeKind.Float or rt_type == TypeKind.Float do
                out TypeKind.Float
            end
            if lt == TypeKind.String and rt_type == TypeKind.String do
                out TypeKind.String
            end
            if lt != TypeKind.Void do
                out lt
            end
            out rt_type
        end
        out TypeKind.Void
    end
    if node.node_type == AstType.Compare do
        out TypeKind.Bool
    end
    if node.node_type == AstType.Call or node.node_type == AstType.MethodCall do
        found = pass5_lookup(symbols, scopes, scopes.current_id, node.name);
        if found != -1 do
            sym = vec_get_rt(symbols.symbols, found);
            if sym.return_type != 0 do
                out sym.return_type >> TypeKind
            end
        end
        out TypeKind.Void
    end
    if node.node_type == AstType.ArrayLiteral do
        # Infer unified element type for ArrayLiteral
        child_count = vec_len_rt(node.children);
        var i = 0;
        var array_elem_type = TypeKind.Void;
        when i < child_count loop
            elem = vec_get_rt(node.children, i);
            elem_t = pass5_infer_expr(symbols, scopes, elem);
            if elem_t != TypeKind.Void do
                array_elem_type = elem_t
            end
            i = i + 1
        end
        out TypeKind.Array
    end
    if node.node_type == AstType.TupleExpr do
        out TypeKind.Tuple
    end
    if node.node_type == AstType.EntityLiteral do
        out TypeKind.Entity
    end
    if node.node_type == AstType.EnumAccess do
        out TypeKind.Enum
    end
    if node.node_type == AstType.AddrOf do
        out TypeKind.Ref
    end
    if node.node_type == AstType.CastExpr do
        if rt_strlen(node.name2) > 0 do
            # Cannot call pass4_resolve_type_name easily if it's not imported here
            # But normally we'd return the resolved type. For now returning Void or some parsed type.
            out TypeKind.Void
        end
        out TypeKind.Void
    end
    if node.node_type == AstType.UnaryMinus do
        child_count = vec_len_rt(node.children);
        if child_count > 0 do
            child = vec_get_rt(node.children, 0);
            out pass5_infer_expr(symbols, scopes, child)
        end
        out TypeKind.Int
    end
    out TypeKind.Void
end.
func pass5_walk(symbols: SymbolTable, scopes: ScopeTree, node: AstNode)

    if node.node_type == AstType.VarDecl or node.node_type == AstType.ConstDecl do
        found = pass5_lookup(symbols, scopes, scopes.current_id, node.name);
        if found != -1 do
            sym = vec_get_rt(symbols.symbols, found);
            if sym.type_id == 0 do
                child_count = vec_len_rt(node.children);
                if child_count > 0 do
                    init = vec_get_rt(node.children, 0);
                    inferred = pass5_infer_expr(symbols, scopes, init);
                    if inferred != TypeKind.Void do
                        sym.type_id = inferred >> i64
                    end
                end
            end
        end
        child_count = vec_len_rt(node.children);
        var i = 0;
        when i < child_count loop
            child = vec_get_rt(node.children, i);
            pass5_walk(symbols, scopes, child);
            i = i + 1
        end
        out 0
    end

    if node.node_type == AstType.FuncDef do
        scope_push(scopes, ScopeKind.Func);
        child_count = vec_len_rt(node.children);
        if child_count > 0 do
            last_idx = child_count - 1;
            body = vec_get_rt(node.children, last_idx);
            pass5_walk(symbols, scopes, body)
        end
        scope_pop(scopes);
        out 0
    end

    if node.node_type == AstType.Block do
        scope_push(scopes, ScopeKind.Block);
        child_count = vec_len_rt(node.children);
        var i = 0;
        when i < child_count loop
            child = vec_get_rt(node.children, i);
            pass5_walk(symbols, scopes, child);
            i = i + 1
        end
        scope_pop(scopes);
        out 0
    end

    # Default recurse
    child_count = vec_len_rt(node.children);
    var i = 0;
    when i < child_count loop
        child = vec_get_rt(node.children, i);
        pass5_walk(symbols, scopes, child);
        i = i + 1
    end
    out 0
end.
func pass5_lookup(symbols: SymbolTable, scopes: ScopeTree, start_scope: int, name: string)
    if rt_strlen(name) == 0 do
        out -1
    end
    curr = start_scope;
    when curr != -1 loop
        scope_node = vec_get_rt(scopes.scopes, curr);
        count = vec_len_rt(scope_node.symbols);
        var i = 0;
        when i < count loop
            sym_id = vec_get_rt(scope_node.symbols, i);
            sym = vec_get_rt(symbols.symbols, sym_id);
            sym_name = sym.name_id >> string;
            if rt_streq(sym_name, name) do
                out sym_id
            end
            i = i + 1
        end
        curr = scope_node.parent_id
    end
    out -1
end.

export pass5_infer_types, pass5_infer_expr
