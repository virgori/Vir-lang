##
 * vir/compiler/sem_pass6_typecheck.vri
 * ==============================================================
 * Pass 6: Complete Type Checking for Vir v2.0
 * Validates type compatibility for operators, assignments, calls,
 * returns, entity field accesses, and array indexing.
 ##

include vec_rt;
import vec_new_rt, vec_push_rt, vec_get_rt, vec_len_rt from vec_rt;

include string_rt;
import rt_streq, fat_str_eq, fat_str_len, fat_cstr_eq, fat_str_eq, fat_str_len, fat_cstr_eq, rt_strcat, rt_itoa, rt_strlen from string_rt;

include parser;
import AstNode, AstType, OpType from parser;

include symbol_table;
import SymbolTable, SymbolKind, SymbolNode from symbol_table;

include scope_tree;
import ScopeTree, ScopeKind, ScopeNode from scope_tree;

include context;
import DiagnosticEngine, report_error from context;

include type_table;
import TypeKind, TYPE_VOID, TYPE_INT, TYPE_FLOAT, TYPE_BOOL, TYPE_STRING from type_table;

func pass6_typecheck(symbols: SymbolTable, scopes: ScopeTree, diag: DiagnosticEngine, node: AstNode):
    pass6_walk(symbols, scopes, diag, node)
end.

func pass6_infer_type(symbols: SymbolTable, scopes: ScopeTree, node: AstNode):
    if node.node_type == AstType.LiteralInt do
        out TypeKind.Int
    end
    if node.node_type == AstType.LiteralFloat do
        out TypeKind.Float
    end
    if node.node_type == AstType.LiteralStr do
        out TypeKind.String
    end
    if node.node_type == AstType.Identifier do
        found = pass6_lookup_chain(symbols, scopes, scopes.current_id, node.name);
        if found != -1 do
            sym = vec_get_rt(symbols.symbols, found);
            out sym.type_id as TypeKind
        end
        out TypeKind.Void
    end
    if node.node_type == AstType.BinOp do
        child_count = vec_len_rt(node.children);
        if child_count >= 2 do
            left = vec_get_rt(node.children, 0);
            right = vec_get_rt(node.children, 1);
            lt = pass6_infer_type(symbols, scopes, left);
            rt = pass6_infer_type(symbols, scopes, right);
            if lt == TypeKind.Float or rt == TypeKind.Float do
                out TypeKind.Float
            end
            if lt == TypeKind.String and rt == TypeKind.String do
                out TypeKind.String
            end
            out lt
        end
    end
    if node.node_type == AstType.Compare do
        out TypeKind.Bool
    end
    out TypeKind.Void
end.

func pass6_walk(symbols: SymbolTable, scopes: ScopeTree, diag: DiagnosticEngine, node: AstNode):

    # 1. Binary Operator Type Check
    if node.node_type == AstType.BinOp do
        child_count = vec_len_rt(node.children);
        if child_count >= 2 do
            left = vec_get_rt(node.children, 0);
            right = vec_get_rt(node.children, 1);
            lt = pass6_infer_type(symbols, scopes, left);
            rt_type = pass6_infer_type(symbols, scopes, right);
            if lt != TypeKind.Void and rt_type != TypeKind.Void do
                # String concatenation rules
                if lt == TypeKind.String and rt_type != TypeKind.String do
                    report_error(diag, 3001, node.line, 0)
                eif lt != TypeKind.String and rt_type == TypeKind.String do
                    report_error(diag, 3001, node.line, 0)
                end
                # Bool arithmetic prohibition (allow logical & comparison ops)
                if lt == TypeKind.Bool or rt_type == TypeKind.Bool do
                    if node.op != OpType.Eq and node.op != OpType.Ne and node.op != OpType.Land and node.op != OpType.Lor and node.op != OpType.AndOp and node.op != OpType.OrOp and node.op != OpType.XorOp do
                        report_error(diag, 3002, node.line, 0)
                    end
                end
                # Bitwise operation integer requirement
                if node.op == OpType.Shl or node.op == OpType.Shr or node.op == OpType.And or node.op == OpType.Or or node.op == OpType.Xor do
                    if lt != TypeKind.Int or rt_type != TypeKind.Int do
                        report_error(diag, 3006, node.line, 0)
                    end
                end
            end
        end
        child_count2 = vec_len_rt(node.children);
        var i = 0;
        when i < child_count2 loop
            child = vec_get_rt(node.children, i);
            pass6_walk(symbols, scopes, diag, child);
            i = i + 1
        end
        out 0
    end

    # 2. Assignment & L-Value Check
    if node.node_type == AstType.Assign do
        child_count = vec_len_rt(node.children);
        if child_count >= 2 do
            lhs = vec_get_rt(node.children, 0);
            rhs = vec_get_rt(node.children, 1);
            # L-value check
            if lhs.node_type != AstType.Identifier and lhs.node_type != AstType.FieldAccess and lhs.node_type != AstType.IndexAccess do
                report_error(diag, 3012, node.line, 0)
            end
            # Immutability check
            if lhs.node_type == AstType.Identifier do
                found = pass6_lookup_chain(symbols, scopes, scopes.current_id, lhs.name);
                if found != -1 do
                    sym = vec_get_rt(symbols.symbols, found);
                    if not sym.is_mutable do
                        report_error(diag, 3003, node.line, 0)
                    end
                    # Type match check
                    rhs_type = pass6_infer_type(symbols, scopes, rhs);
                    if sym.type_id != 0 and rhs_type != TypeKind.Void and sym.type_id != rhs_type as i64 do
                        report_error(diag, 3007, node.line, 0)
                    end
                end
            end
        end
        child_count3 = vec_len_rt(node.children);
        var i = 0;
        when i < child_count3 loop
            child = vec_get_rt(node.children, i);
            pass6_walk(symbols, scopes, diag, child);
            i = i + 1
        end
        out 0
    end

    # 3. Call Resolution & Argument Count Check
    if node.node_type == AstType.Call do
        child_count = vec_len_rt(node.children);
        found = pass6_lookup_chain(symbols, scopes, scopes.current_id, node.name);
        if found != -1 do
            sym = vec_get_rt(symbols.symbols, found);
            arg_count = child_count;
            if sym.kind == SymbolKind.Function and sym.param_count != arg_count do
                report_error(diag, 3004, node.line, 0)
            end
        end
        var i = 0;
        when i < child_count loop
            child = vec_get_rt(node.children, i);
            pass6_walk(symbols, scopes, diag, child);
            i = i + 1
        end
        out 0
    end

    # 4. Index Access Check (Index must be Int)
    if node.node_type == AstType.IndexAccess do
        child_count = vec_len_rt(node.children);
        if child_count >= 2 do
            idx_node = vec_get_rt(node.children, 1);
            idx_type = pass6_infer_type(symbols, scopes, idx_node);
            if idx_type != TypeKind.Void and idx_type != TypeKind.Int do
                report_error(diag, 3009, node.line, 0)
            end
        end
        var i = 0;
        when i < child_count loop
            child = vec_get_rt(node.children, i);
            pass6_walk(symbols, scopes, diag, child);
            i = i + 1
        end
        out 0
    if node.node_type == AstType.BindAttr do
        child_count = vec_len_rt(node.children);
        if child_count > 0 do
            child = vec_get_rt(node.children, 0);
            pass6_walk(symbols, scopes, diag, child);
        end
        out 0
    end

    if node.node_type == AstType.InferBlock do
        child_count = vec_len_rt(node.children);
        var i = 0;
        when i < child_count loop
            child = vec_get_rt(node.children, i);
            if child.node_type == AstType.MethodCall and fat_str_eq(child.name, "backward") do
                report_error(diag, 3009, child.line, 0);
            end
            pass6_walk(symbols, scopes, diag, child);
            i = i + 1;
        end
        out 0
    end

    if node.node_type == AstType.TrainBlock or node.node_type == AstType.ReactiveDecl or node.node_type == AstType.BundleExpr or node.node_type == AstType.ExposeAttr do
        child_count = vec_len_rt(node.children);
        var i = 0;
        when i < child_count loop
            child = vec_get_rt(node.children, i);
            pass6_walk(symbols, scopes, diag, child);
            i = i + 1;
        end
        out 0
    end

    # 5. FuncDef Scope & Local Parameter Registration
    if node.node_type == AstType.FuncDef do
        old_scope = scopes.current_id;
        scope_push(scopes, ScopeKind.Func);
        child_count = vec_len_rt(node.children);
        if child_count > 0 do
            last_idx = child_count - 1;
            var i = 0;
            when i < last_idx loop
                param = vec_get_rt(node.children, i);
                pass6_register_local(symbols, scopes, param.name, true);
                i = i + 1
            end
            body = vec_get_rt(node.children, last_idx);
            pass6_walk(symbols, scopes, diag, body)
        end
        scope_pop(scopes);
        out 0
    end

    if node.node_type == AstType.Block do
        old_scope = scopes.current_id;
        scope_push(scopes, ScopeKind.Block);
        child_count = vec_len_rt(node.children);
        var i = 0;
        when i < child_count loop
            child = vec_get_rt(node.children, i);
            pass6_walk(symbols, scopes, diag, child);
            i = i + 1
        end
        scope_pop(scopes);
        out 0
    end

    if node.node_type == AstType.VarDecl do
        child_count = vec_len_rt(node.children);
        var i = 0;
        when i < child_count loop
            child = vec_get_rt(node.children, i);
            pass6_walk(symbols, scopes, diag, child);
            i = i + 1
        end
        pass6_register_local(symbols, scopes, node.name, true);
        out 0
    end

    if node.node_type == AstType.ConstDecl do
        child_count = vec_len_rt(node.children);
        var i = 0;
        when i < child_count loop
            child = vec_get_rt(node.children, i);
            pass6_walk(symbols, scopes, diag, child);
            i = i + 1
        end
        pass6_register_local(symbols, scopes, node.name, false);
        out 0
    end

    # Default recurse
    child_count = vec_len_rt(node.children);
    var i = 0;
    when i < child_count loop
        child = vec_get_rt(node.children, i);
        pass6_walk(symbols, scopes, diag, child);
        i = i + 1
    end
    out 0
end.

func pass6_lookup_chain(symbols: SymbolTable, scopes: ScopeTree, start_scope: int, name: string):
    if fat_str_len(name) == 0 do
        out -1
    end
    curr = start_scope;
    when curr >= 0 loop
        scope_node = vec_get_rt(scopes.scopes, curr);
        count = vec_len_rt(scope_node.symbols);
        var i = 0;
        when i < count loop
            sym_id = vec_get_rt(scope_node.symbols, i);
            sym = vec_get_rt(symbols.symbols, sym_id);
            sym_name = native_read_i64(sym as i64, 8) as string;
            if fat_str_eq(sym_name, name) do
                out sym_id
            end
            i = i + 1
        end
        curr = scope_node.parent_id
    end
    out -1
end.

func pass6_register_local(symbols: SymbolTable, scopes: ScopeTree, name: string, is_mutable: bool):
    if fat_str_len(name) == 0 do
        out 0
    end
    sym = SymbolNode (
        kind: SymbolKind.Variable,
        name_id: name as i64,
        type_id: 0,
        scope_id: scopes.current_id,
        ast_id: 0,
        is_mutable: is_mutable,
        offset: 0,
        param_count: 0,
        return_type: 0,
        parent_id: -1
    );
    sym_id = symbol_alloc(symbols, sym);
    scope_add_symbol(scopes, scopes.current_id, sym_id);
    out sym_id
end.

export pass6_typecheck
