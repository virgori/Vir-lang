##
 * vir/compiler/sem_pass6_typecheck.vri
 * ==============================================================
 * Pass 6: Complete Type Checking for Vir v2.0
 * Validates type compatibility for operators, assignments, calls,
 * returns, entity field accesses, and array indexing.
 ##

include vec_rt
import vec_new_rt, vec_push_rt, vec_get_rt, vec_len_rt, vec_set_rt from vec_rt

include string_rt
import rt_streq, fat_str_eq, fat_str_len, fat_str_byte_at, fat_cstr_eq, fat_str_new, rt_strcat, rt_itoa, rt_strlen from string_rt

include parser
import AstNode, AstType, OpType from parser

include symbol_table
import SymbolTable, SymbolKind, SymbolNode, symbol_alloc from symbol_table

include scope_tree
import ScopeTree, ScopeKind, ScopeNode, scope_push, scope_pop, scope_add_symbol, scope_current_id from scope_tree

include context
import DiagnosticEngine, report_error from context

include type_table
import TypeKind, TYPE_VOID, TYPE_INT, TYPE_FLOAT, TYPE_BOOL, TYPE_STRING, is_tensor_type_str, parse_tensor_shape, parse_tensor_rank from type_table

# Hash ONLY global scope.  Orphan Func/Block nodes from prior passes would
# make a dense per-scope 256-bucket table allocate millions of vecs.
const PASS6_BUCKETS: int = 256
var g_pass6_global_buckets: i64 = 0

func pass6_hash_name(name: string):
    n = fat_str_len(name)
    if n <= 0 do
        out 0
    end
    h = n * 17
    var i = 0
    when i < n loop
        h = h * 131 + fat_str_byte_at(name, i)
        i = i + 1
    end
    if h < 0 do
        h = 0 - h
    end
    out h mod PASS6_BUCKETS
end.

func pass6_global_map_new():
    buckets = vec_new_rt()
    var bi = 0
    when bi < PASS6_BUCKETS loop
        buckets = vec_push_rt(buckets, vec_new_rt())
        bi = bi + 1
    end
    out buckets
end.

func pass6_index_global(name: string, sym_id: int):
    if fat_str_len(name) == 0 do
        out 0
    end
    if g_pass6_global_buckets == 0 do
        g_pass6_global_buckets = pass6_global_map_new()
    end
    bid = pass6_hash_name(name)
    bucket = vec_get_rt(g_pass6_global_buckets, bid)
    bucket = vec_push_rt(bucket, sym_id)
    vec_set_rt(g_pass6_global_buckets, bid, bucket)
    out 0
end.

func pass6_rebuild_index(symbols: SymbolTable, scopes: ScopeTree):
    g_pass6_global_buckets = pass6_global_map_new()
    scopes_vec = native_read_i64(scopes as i64, 0)
    syms_vec = native_read_i64(symbols as i64, 0)
    if vec_len_rt(scopes_vec) == 0 do
        out 0
    end
    scope_node = vec_get_rt(scopes_vec, 0)
    sym_list = native_read_i64(scope_node as i64, 16)
    count = vec_len_rt(sym_list)
    var i = 0
    when i < count loop
        sym_id = vec_get_rt(sym_list, i)
        sym = vec_get_rt(syms_vec, sym_id)
        sym_name = native_read_i64(sym as i64, 8) as string
        pass6_index_global(sym_name, sym_id)
        i = i + 1
    end
end.

func pass6_typecheck(symbols: SymbolTable, scopes: ScopeTree, diag: DiagnosticEngine, node: AstNode):
    pass6_rebuild_index(symbols, scopes)
    pass6_walk(symbols, scopes, diag, node)
end.

func pass6_symbol_at(symbols: SymbolTable, id: int):
    # Avoid ambiguous nested entity-field lowering in native self-host code.
    syms_vec = native_read_i64(symbols as i64, 0)
    out vec_get_rt(syms_vec, id)
end.

func pass6_call_returns_first_arg(name: i64):
    if fat_cstr_eq(name, "ast_add_child") == 1 do out 1 end
    if fat_cstr_eq(name, "vec_push_rt") == 1 do out 1 end
    if fat_cstr_eq(name, "vec_set_rt") == 1 do out 1 end
    if fat_cstr_eq(name, "vec_push") == 1 do out 1 end
    if fat_cstr_eq(name, "ast_vec_push") == 1 do out 1 end
    if fat_cstr_eq(name, "ast_vec_bump_new") == 1 do out 1 end
    if fat_cstr_eq(name, "codebuf_emit_byte") == 1 do out 1 end
    if fat_cstr_eq(name, "codebuf_emit_u32") == 1 do out 1 end
    if fat_cstr_eq(name, "codebuf_emit_u64") == 1 do out 1 end
    if fat_cstr_eq(name, "codebuf_emit_i32") == 1 do out 1 end
    if fat_cstr_eq(name, "buf_write_u8") == 1 do out 1 end
    if fat_cstr_eq(name, "buf_align") == 1 do out 1 end
    if fat_cstr_eq(name, "bvec_push") == 1 do out 1 end
    if fat_cstr_eq(name, "text_splice_at") == 1 do out 1 end
    out 0
end.

func pass6_infer_call_return(symbols: SymbolTable, scopes: ScopeTree, node: AstNode):
    if node.node_type != AstType.Call and node.node_type != AstType.MethodCall do
        out TypeKind.Void
    end
    found = pass6_lookup_chain(symbols, scopes, scope_current_id(scopes), node.name)
    if found != -1 do
        sym = pass6_symbol_at(symbols, found)
        if sym.return_type != 0 do
            out sym.return_type as TypeKind
        end
    end
    if pass6_call_returns_first_arg(node.name as i64) == 1 do
        child_count = vec_len_rt(node.children)
        if child_count > 0 do
            arg0 = vec_get_rt(node.children, 0)
            arg0_ty = pass6_infer_type(symbols, scopes, arg0)
            if arg0_ty != TypeKind.Void do
                out arg0_ty
            end
        end
    end
    out TypeKind.Int
end.

func pass6_infer_type(symbols: SymbolTable, scopes: ScopeTree, node: AstNode):
    if node.node_type == AstType.LiteralInt do
        out TypeKind.Int
    end
    if node.node_type == AstType.LiteralFloat do
        out TypeKind.Float
    end
    if node.node_type == AstType.LiteralStr do
        out TypeKind.String
    end
    if node.node_type == AstType.Identifier do
        found = pass6_lookup_chain(symbols, scopes, scope_current_id(scopes), node.name)
        if found != -1 do
            sym = pass6_symbol_at(symbols, found)
            out sym.type_id as TypeKind
        end
        out TypeKind.Void
    end
    if node.node_type == AstType.BinOp do
        child_count = vec_len_rt(node.children)
        if child_count >= 2 do
            left = vec_get_rt(node.children, 0)
            right = vec_get_rt(node.children, 1)
            lt = pass6_infer_type(symbols, scopes, left)
            rt_type = pass6_infer_type(symbols, scopes, right)
            if node.op == OpType.MatMulOp do
                out TypeKind.Tensor
            end
            if node.op == OpType.Eq or node.op == OpType.Ne or node.op == OpType.Gt or node.op == OpType.Lt or node.op == OpType.Ge or node.op == OpType.Le do
                out TypeKind.Bool
            end
            if node.op == OpType.Land or node.op == OpType.Lor do
                out TypeKind.Bool
            end
            if node.op == OpType.AndOp or node.op == OpType.OrOp or node.op == OpType.XorOp do
                if lt == TypeKind.Bool and rt_type == TypeKind.Bool do
                    out TypeKind.Bool
                end
                out TypeKind.Int
            end
            if node.op == OpType.ShlOp or node.op == OpType.ShrOp do
                out TypeKind.Int
            end
            if lt == TypeKind.Float or rt_type == TypeKind.Float do
                out TypeKind.Float
            end
            if lt == TypeKind.String and rt_type == TypeKind.String do
                out TypeKind.String
            end
            if lt == TypeKind.Bool or rt_type == TypeKind.Bool do
                out TypeKind.Bool
            end
            if lt != TypeKind.Void do
                out lt
            end
            out rt_type
        end
    end
    if node.node_type == AstType.Compare do
        out TypeKind.Bool
    end
    if node.node_type == AstType.Call or node.node_type == AstType.MethodCall do
        out pass6_infer_call_return(symbols, scopes, node)
    end
    if node.node_type == AstType.BuiltinCall do
        out TypeKind.Int
    end
    if node.node_type == AstType.IndexAccess or node.node_type == AstType.FieldAccess or node.node_type == AstType.CastExpr or node.node_type == AstType.UnaryMinus do
        out TypeKind.Int
    end
    if node.node_type == AstType.UnaryNot do
        out TypeKind.Bool
    end
    out TypeKind.Void
end.

func pass6_is_integer_like(k: TypeKind):
    if k == TypeKind.Float or k == TypeKind.String do
        out 0
    end
    out 1
end.

# `and`/`or`/`xor` are Tok→AndOp/OrOp/XorOp (not only pure bitwise).
# Codebase mixes Compare/UnaryNot (Bool) with Call (inferred Int) in one expr
# (`not has_sep or check(...)`). Allow Bool ∪ integer-like on both sides.
func pass6_types_compatible(declared: i64, actual: TypeKind):
    if declared == actual as i64 do
        out 1
    end
    if actual == TypeKind.Void do
        out 1
    end
    if declared == 0 do
        out 1
    end
    if pass6_is_integer_like(declared as TypeKind) == 1 and pass6_is_integer_like(actual) == 1 do
        out 1
    end
    # Vir bool literals are 0/1; comparisons infer Bool but runtime is int-like.
    if declared == TypeKind.Bool as i64 and pass6_is_integer_like(actual) == 1 do
        out 1
    end
    if actual == TypeKind.Bool and pass6_is_integer_like(declared as TypeKind) == 1 do
        out 1
    end
    if declared == TypeKind.Array as i64 and actual == TypeKind.Entity do
        out 1
    end
    if declared == TypeKind.Entity as i64 and actual == TypeKind.Array do
        out 1
    end
    # Fat-pointer ABI: many `string` / entity handles are i64 at runtime.
    if declared == TypeKind.String as i64 and pass6_is_integer_like(actual) == 1 do
        out 1
    end
    if declared == TypeKind.Entity as i64 and pass6_is_integer_like(actual) == 1 do
        out 1
    end
    out 0
end.

func pass6_is_logic_bit_operand(k: TypeKind):
    if k == TypeKind.Bool do
        out 1
    end
    out pass6_is_integer_like(k)
end.

func pass6_walk(symbols: SymbolTable, scopes: ScopeTree, diag: DiagnosticEngine, node: AstNode):

    # 1. Binary Operator Type Check
    if node.node_type == AstType.BinOp do
        child_count = vec_len_rt(node.children)
        if child_count >= 2 do
            left = vec_get_rt(node.children, 0)
            right = vec_get_rt(node.children, 1)
            lt = pass6_infer_type(symbols, scopes, left)
            rt_type = pass6_infer_type(symbols, scopes, right)
            if lt != TypeKind.Void and rt_type != TypeKind.Void do
                # String concatenation rules (`+` only).
                if node.op == OpType.Add do
                    if lt == TypeKind.String and rt_type != TypeKind.String and pass6_is_integer_like(rt_type) == 0 do
                        report_error(diag, 3001, node.line, 0)
                    eif lt != TypeKind.String and rt_type == TypeKind.String and pass6_is_integer_like(lt) == 0 do
                        report_error(diag, 3001, node.line, 0)
                    end
                end
                # Bool arithmetic prohibition (allow logical & comparison ops).
                # Vir bool is 0/1 at runtime — allow arithmetic with integer-like other side.
                if lt == TypeKind.Bool or rt_type == TypeKind.Bool do
                    if node.op != OpType.Eq and node.op != OpType.Ne and node.op != OpType.Land and node.op != OpType.Lor and node.op != OpType.AndOp and node.op != OpType.OrOp and node.op != OpType.XorOp do
                        other = rt_type
                        if lt == TypeKind.Bool do
                            other = rt_type
                        else
                            other = lt
                        end
                        if pass6_is_integer_like(other) == 0 do
                            report_error(diag, 3002, node.line, 0)
                        end
                    end
                end
                # Bitwise shifts require integers.  And/Or/Xor are also used as
                # boolean logical ops — allow Int×Int or Bool×Bool; Enum~Int OK.
                if node.op == OpType.ShlOp or node.op == OpType.ShrOp do
                    if pass6_is_integer_like(lt) == 0 or pass6_is_integer_like(rt_type) == 0 do
                        report_error(diag, 3006, node.line, 0)
                    end
                end
                if node.op == OpType.AndOp or node.op == OpType.OrOp or node.op == OpType.XorOp or node.op == OpType.Land or node.op == OpType.Lor do
                    if pass6_is_logic_bit_operand(lt) == 0 or pass6_is_logic_bit_operand(rt_type) == 0 do
                        report_error(diag, 3006, node.line, 0)
                    end
                end
                if node.op == OpType.MatMulOp do
                    if lt != TypeKind.Void and lt != TypeKind.Tensor do
                        report_error(diag, 3002, node.line, 0)
                    end
                    if rt_type != TypeKind.Void and rt_type != TypeKind.Tensor do
                        report_error(diag, 3002, node.line, 0)
                    end
                    var type_a_str = ""
                    var type_b_str = ""
                    if left.node_type == AstType.Identifier do
                        found_a = pass6_lookup_chain(symbols, scopes, scope_current_id(scopes), left.name)
                        if found_a != -1 do
                            sym_a = pass6_symbol_at(symbols, found_a)
                            if sym_a.ast_id != 0 do
                                ast_a = sym_a.ast_id as AstNode
                                type_a_str = ast_a.name2
                            end
                        end
                    end
                    if right.node_type == AstType.Identifier do
                        found_b = pass6_lookup_chain(symbols, scopes, scope_current_id(scopes), right.name)
                        if found_b != -1 do
                            sym_b = pass6_symbol_at(symbols, found_b)
                            if sym_b.ast_id != 0 do
                                ast_b = sym_b.ast_id as AstNode
                                type_b_str = ast_b.name2
                            end
                        end
                    end
                    if is_tensor_type_str(type_a_str) and is_tensor_type_str(type_b_str) do
                        shape_a = parse_tensor_shape(type_a_str)
                        shape_b = parse_tensor_shape(type_b_str)
                        rank_a = vec_len_rt(shape_a)
                        rank_b = vec_len_rt(shape_b)
                        if rank_a != 2 or rank_b != 2 do
                            report_error(diag, 3014, node.line, 0)
                        else
                            k_a = vec_get_rt(shape_a, 1) as i64
                            k_b = vec_get_rt(shape_b, 0) as i64
                            if k_a != k_b do
                                report_error(diag, 3014, node.line, 0)
                            end
                        end
                    end
                end
            end
        end
        child_count2 = vec_len_rt(node.children)
        var i = 0
        when i < child_count2 loop
            child = vec_get_rt(node.children, i)
            pass6_walk(symbols, scopes, diag, child)
            i = i + 1
        end
        out 0
    end

    # 2. Assignment & L-Value Check
    # Parser shape: Assign.name = LHS ident; children[0] = RHS (not lhs child).
    if node.node_type == AstType.Assign do
        child_count = vec_len_rt(node.children)
        if fat_str_len(node.name) > 0 do
            found = pass6_lookup_chain(symbols, scopes, scope_current_id(scopes), node.name)
            if found == -1 do
                pass6_register_local(symbols, scopes, node.name, true)
                found = pass6_lookup_chain(symbols, scopes, scope_current_id(scopes), node.name)
            end
            if found != -1 do
                sym = pass6_symbol_at(symbols, found)
                if sym.kind != SymbolKind.Variable and sym.kind != SymbolKind.Param do
                    pass6_register_local(symbols, scopes, node.name, true)
                    found = pass6_lookup_chain(symbols, scopes, scope_current_id(scopes), node.name)
                    sym = pass6_symbol_at(symbols, found)
                end
                if not sym.is_mutable do
                    report_error(diag, 3003, node.line, 0)
                end
                if child_count >= 1 do
                    rhs = vec_get_rt(node.children, 0)
                    rhs_type = pass6_infer_type(symbols, scopes, rhs)
                    if sym.type_id != 0 and rhs_type != TypeKind.Void and pass6_types_compatible(sym.type_id, rhs_type) == 0 do
                        report_error(diag, 3007, node.line, 0)
                    end
                    if sym.type_id == 0 and rhs_type != TypeKind.Void do
                        native_write_i64(sym as i64, 16, rhs_type as i64)
                    end
                end
            end
        eif child_count >= 2 do
            lhs = vec_get_rt(node.children, 0)
            rhs = vec_get_rt(node.children, 1)
            if lhs.node_type != AstType.Identifier and lhs.node_type != AstType.FieldAccess and lhs.node_type != AstType.IndexAccess do
                report_error(diag, 3012, node.line, 0)
            end
            if lhs.node_type == AstType.Identifier do
                found = pass6_lookup_chain(symbols, scopes, scope_current_id(scopes), lhs.name)
                if found != -1 do
                    sym = pass6_symbol_at(symbols, found)
                    if sym.kind != SymbolKind.Variable and sym.kind != SymbolKind.Param do
                        pass6_register_local(symbols, scopes, lhs.name, true)
                        found = pass6_lookup_chain(symbols, scopes, scope_current_id(scopes), lhs.name)
                        sym = pass6_symbol_at(symbols, found)
                    end
                    if not sym.is_mutable do
                        report_error(diag, 3003, node.line, 0)
                    end
                    rhs_type = pass6_infer_type(symbols, scopes, rhs)
                    if sym.type_id != 0 and rhs_type != TypeKind.Void and pass6_types_compatible(sym.type_id, rhs_type) == 0 do
                        report_error(diag, 3007, node.line, 0)
                    end
                end
            end
        end
        var i = 0
        when i < child_count loop
            child = vec_get_rt(node.children, i)
            pass6_walk(symbols, scopes, diag, child)
            i = i + 1
        end
        out 0
    end

    # 3. Call Resolution & Argument Count Check
    if node.node_type == AstType.Call do
        child_count = vec_len_rt(node.children)
        found = pass6_lookup_chain(symbols, scopes, scope_current_id(scopes), node.name)
        if found != -1 do
            sym = pass6_symbol_at(symbols, found)
            arg_count = child_count
            # param_count < 0 means unknown (fresh extern stub) — skip arity check.
            if sym.kind == SymbolKind.Func and sym.param_count >= 0 and sym.param_count != arg_count do
                report_error(diag, 3004, node.line, 0)
            end
        end
        var i = 0
        when i < child_count loop
            child = vec_get_rt(node.children, i)
            pass6_walk(symbols, scopes, diag, child)
            i = i + 1
        end
        out 0
    end

    # 4. Index Access Check (Index must be Int, rank matching for tensor)
    if node.node_type == AstType.IndexAccess or node.node_type == AstType.ExprIndex do
        child_count = vec_len_rt(node.children)
        var start_idx = 0
        var is_tensor_base = false
        var expected_rank = 0
        if node.node_type == AstType.IndexAccess do
            start_idx = 0
            found_base = pass6_lookup_chain(symbols, scopes, scope_current_id(scopes), node.name)
            if found_base != -1 do
                sym_base = pass6_symbol_at(symbols, found_base)
                if (sym_base.type_id as TypeKind) == TypeKind.Tensor do
                    is_tensor_base = true
                    if sym_base.ast_id != 0 do
                        base_ast = sym_base.ast_id as AstNode
                        if is_tensor_type_str(base_ast.name2) do
                            expected_rank = parse_tensor_rank(base_ast.name2)
                        end
                    end
                end
            end
        else
            start_idx = 1
            if child_count > 0 do
                base_expr = vec_get_rt(node.children, 0)
                base_ty = pass6_infer_type(symbols, scopes, base_expr)
                if base_ty == TypeKind.Tensor do
                    is_tensor_base = true
                end
            end
        end
        # Check rank if tensor
        if is_tensor_base and expected_rank > 0 do
            given_indices = child_count - start_idx
            if given_indices != expected_rank do
                report_error(diag, 3013, node.line, 0)
            end
        end
        # Check all index expressions are Int
        var ii = start_idx
        when ii < child_count loop
            idx_node = vec_get_rt(node.children, ii)
            idx_type = pass6_infer_type(symbols, scopes, idx_node)
            if idx_type != TypeKind.Void and idx_type != TypeKind.Int do
                report_error(diag, 3015, node.line, 0)
            end
            ii = ii + 1
        end
        var i = 0
        when i < child_count loop
            child = vec_get_rt(node.children, i)
            pass6_walk(symbols, scopes, diag, child)
            i = i + 1
        end
        out 0
    end

    # 4b. Index Assign Check (Index must be Int, rank matching for tensor)
    if node.node_type == AstType.IndexAssign do
        child_count = vec_len_rt(node.children)
        if child_count >= 2 do
            found_base = pass6_lookup_chain(symbols, scopes, scope_current_id(scopes), node.name)
            if found_base != -1 do
                sym_base = pass6_symbol_at(symbols, found_base)
                if (sym_base.type_id as TypeKind) == TypeKind.Tensor and sym_base.ast_id != 0 do
                    base_ast = sym_base.ast_id as AstNode
                    if is_tensor_type_str(base_ast.name2) do
                        expected_rank = parse_tensor_rank(base_ast.name2)
                        num_indices = child_count - 1
                        if expected_rank > 0 and num_indices != expected_rank do
                            report_error(diag, 3013, node.line, 0)
                        end
                    end
                end
            end
            var ii = 0
            when ii < child_count - 1 loop
                idx_node = vec_get_rt(node.children, ii)
                idx_type = pass6_infer_type(symbols, scopes, idx_node)
                if idx_type != TypeKind.Void and idx_type != TypeKind.Int do
                    report_error(diag, 3015, node.line, 0)
                end
                ii = ii + 1
            end
        end
        var i = 0
        when i < child_count loop
            child = vec_get_rt(node.children, i)
            pass6_walk(symbols, scopes, diag, child)
            i = i + 1
        end
        out 0
    end
    if node.node_type == AstType.BindAttr do
        child_count = vec_len_rt(node.children)
        if child_count > 0 do
            child = vec_get_rt(node.children, 0)
            pass6_walk(symbols, scopes, diag, child)
        end
        out 0
    end

    if node.node_type == AstType.InferBlock do
        child_count = vec_len_rt(node.children)
        var i = 0
        when i < child_count loop
            child = vec_get_rt(node.children, i)
            if child.node_type == AstType.MethodCall and fat_str_eq(child.name, fat_str_new("backward")) == 1 do
                report_error(diag, 3009, child.line, 0)
            end
            pass6_walk(symbols, scopes, diag, child)
            i = i + 1
        end
        out 0
    end

    if node.node_type == AstType.TrainBlock or node.node_type == AstType.ReactiveDecl or node.node_type == AstType.BundleExpr or node.node_type == AstType.ExposeAttr do
        child_count = vec_len_rt(node.children)
        var i = 0
        when i < child_count loop
            child = vec_get_rt(node.children, i)
            pass6_walk(symbols, scopes, diag, child)
            i = i + 1
        end
        out 0
    end

    # 5. FuncDef Scope & Local Parameter Registration
    if node.node_type == AstType.FuncDef do
        scope_push(scopes, ScopeKind.Func)
        child_count = vec_len_rt(node.children)
        body_idx = child_count - 1
        if body_idx < 0 do
            body_idx = 0
        end
        var bi = 0
        when bi < child_count loop
            ch = vec_get_rt(node.children, bi)
            if ch.node_type == AstType.Block do
                body_idx = bi
                bi = child_count
            else
                bi = bi + 1
            end
        end
        var i = 0
        when i < body_idx loop
            param = vec_get_rt(node.children, i)
            sid = pass6_register_local(symbols, scopes, param.name, true)
            if sid != -1 do
                psym = pass6_symbol_at(symbols, sid)
                native_write_i64(psym as i64, 32, param as i64)
                if fat_str_len(param.name2) > 0 and is_tensor_type_str(param.name2) do
                    native_write_i64(psym as i64, 16, TypeKind.Tensor as i64)
                eif psym.type_id == 0 do
                    native_write_i64(psym as i64, 16, TypeKind.Int as i64)
                end
            end
            i = i + 1
        end
        var j = body_idx
        when j < child_count loop
            child = vec_get_rt(node.children, j)
            pass6_walk(symbols, scopes, diag, child)
            j = j + 1
        end
        scope_pop(scopes)
        out 0
    end

    if node.node_type == AstType.Block do
        scope_push(scopes, ScopeKind.Block)
        child_count = vec_len_rt(node.children)
        var i = 0
        when i < child_count loop
            child = vec_get_rt(node.children, i)
            pass6_walk(symbols, scopes, diag, child)
            i = i + 1
        end
        scope_pop(scopes)
        out 0
    end

    if node.node_type == AstType.ExternFunc do
        out 0
    end

    if node.node_type == AstType.VarDecl do
        child_count = vec_len_rt(node.children)
        var i = 0
        when i < child_count loop
            child = vec_get_rt(node.children, i)
            pass6_walk(symbols, scopes, diag, child)
            i = i + 1
        end
        sid = pass6_register_local(symbols, scopes, node.name, true)
        if sid != -1 do
            syms_vec = native_read_i64(symbols as i64, 0)
            sym = vec_get_rt(syms_vec, sid)
            native_write_i64(sym as i64, 32, node as i64)
            if fat_str_len(node.name2) > 0 and is_tensor_type_str(node.name2) do
                native_write_i64(sym as i64, 16, TypeKind.Tensor as i64)
            eif child_count > 0 do
                child0 = vec_get_rt(node.children, 0)
                inferred = pass6_infer_type(symbols, scopes, child0)
                if inferred != TypeKind.Void do
                    native_write_i64(sym as i64, 16, inferred as i64)
                end
            end
        end
        out 0
    end

    if node.node_type == AstType.ConstDecl do
        child_count = vec_len_rt(node.children)
        var i = 0
        when i < child_count loop
            child = vec_get_rt(node.children, i)
            pass6_walk(symbols, scopes, diag, child)
            i = i + 1
        end
        sid = pass6_register_local(symbols, scopes, node.name, false)
        if sid != -1 do
            syms_vec = native_read_i64(symbols as i64, 0)
            sym = vec_get_rt(syms_vec, sid)
            native_write_i64(sym as i64, 32, node as i64)
            if fat_str_len(node.name2) > 0 and is_tensor_type_str(node.name2) do
                native_write_i64(sym as i64, 16, TypeKind.Tensor as i64)
            end
        end
        out 0
    end

    # Default recurse
    child_count = vec_len_rt(node.children)
    var i = 0
    when i < child_count loop
        child = vec_get_rt(node.children, i)
        pass6_walk(symbols, scopes, diag, child)
        i = i + 1
    end
    out 0
end.

func pass6_lookup_global(symbols: SymbolTable, name: string):
    if g_pass6_global_buckets == 0 do
        out -1
    end
    bid = pass6_hash_name(name)
    bucket = vec_get_rt(g_pass6_global_buckets, bid)
    count = vec_len_rt(bucket)
    syms_vec = native_read_i64(symbols as i64, 0)
    var i = 0
    when i < count loop
        sym_id = vec_get_rt(bucket, i)
        sym = vec_get_rt(syms_vec, sym_id)
        sym_name_ptr = native_read_i64(sym as i64, 8)
        if fat_str_eq(sym_name_ptr as string, name) == 1 do
            out sym_id
        end
        i = i + 1
    end
    out -1
end.

func pass6_lookup_scope_linear(symbols: SymbolTable, scopes: ScopeTree, scope_id: int, name: string):
    if scope_id <= 0 do
        out -1
    end
    scopes_vec = native_read_i64(scopes as i64, 0)
    if scope_id >= vec_len_rt(scopes_vec) do
        out -1
    end
    scope_node = vec_get_rt(scopes_vec, scope_id)
    sym_list = native_read_i64(scope_node as i64, 16)
    count = vec_len_rt(sym_list)
    if count == 0 do
        out -1
    end
    syms_vec = native_read_i64(symbols as i64, 0)
    var i = 0
    when i < count loop
        sym_id = vec_get_rt(sym_list, i)
        sym = vec_get_rt(syms_vec, sym_id)
        sym_name_ptr = native_read_i64(sym as i64, 8)
        if fat_str_eq(sym_name_ptr as string, name) == 1 do
            out sym_id
        end
        i = i + 1
    end
    out -1
end.

func pass6_lookup_chain(symbols: SymbolTable, scopes: ScopeTree, start_scope: int, name: string):
    if fat_str_len(name) == 0 do
        out -1
    end
    # Inner scopes shadow globals (match pass 3 name resolution).
    curr = start_scope
    scopes_vec = native_read_i64(scopes as i64, 0)
    when curr >= 0 loop
        if curr == 0 do
            out pass6_lookup_global(symbols, name)
        end
        found2 = pass6_lookup_scope_linear(symbols, scopes, curr, name)
        if found2 != -1 do
            out found2
        end
        scope_node = vec_get_rt(scopes_vec, curr)
        curr = native_read_i64(scope_node as i64, 8)
    end
    out -1
end.

func pass6_enclosing_func_scope(scopes: ScopeTree, curr_scope: int):
    if curr_scope <= 0 do
        out curr_scope
    end
    scopes_vec = native_read_i64(scopes as i64, 0)
    var s = curr_scope
    when s > 0 loop
        scope_node = vec_get_rt(scopes_vec, s)
        skind = native_read_i64(scope_node as i64, 0)
        if skind == ScopeKind.Func do
            out s
        end
        s = native_read_i64(scope_node as i64, 8)
    end
    out curr_scope
end.

func pass6_register_local(symbols: SymbolTable, scopes: ScopeTree, name: string, is_mutable: bool):
    if fat_str_len(name) == 0 do
        out 0
    end
    curr = scope_current_id(scopes)
    sym = SymbolNode (
        kind: SymbolKind.Variable,
        name_id: name as i64,
        type_id: 0,
        scope_id: curr,
        ast_id: 0,
        is_mutable: is_mutable,
        offset: 0,
        param_count: 0,
        return_type: 0,
        parent_id: -1
    )
    sym_id = symbol_alloc(symbols, sym)
    func_scope = pass6_enclosing_func_scope(scopes, curr)
    scope_add_symbol(scopes, func_scope, sym_id)
    if func_scope != curr do
        scope_add_symbol(scopes, curr, sym_id)
    end
    # Locals live in tiny scopes — found via linear scan.  Only global is hashed.
    if curr == 0 do
        pass6_index_global(name, sym_id)
    end
    out sym_id
end.

export pass6_typecheck
