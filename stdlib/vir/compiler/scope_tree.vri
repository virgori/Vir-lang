##
 * vir/compiler/scope_tree.vri
 * ==============================================================
 * Quản lý phạm vi kế thừa (Block Scoping) cho Semantic Analysis.
 ##

include vec_rt
import vec_new_rt, vec_push_rt, vec_get_rt, vec_len_rt from vec_rt

enum ScopeKind:
    Global = 0,
    Func   = 1,
    Block  = 2,
    Loop   = 3,
    Module = 4,
    Entity = 5,
    Enum   = 6,
    Match  = 7
end.
entity ScopeNode:
    kind: ScopeKind,
    parent_id: i64,     # Trỏ về ScopeID cha, 0 else có (or là Global)
    symbols: [i64]      # Vec chứa các SymbolID được định nghĩa in scope này
end.
entity ScopeTree:
    scopes: [ScopeNode],
    current_id: i64     # ScopeID đang được duyệt (hoạt động như đỉnh stack)
end.
func scope_tree_new():
    tree = ScopeTree (
        scopes: vec_new_rt(),
        current_id: 0
    )
    
    # Global Scope có ScopeID = 0
    global_scope = ScopeNode (
        kind: ScopeKind.Global,
        parent_id: -1,  # Báo hiệu đây là root
        symbols: vec_new_rt()
    )
    tree.scopes = vec_push_rt(tree.scopes, global_scope)
    
    out tree
end.
func scope_push(tree: ScopeTree, kind: ScopeKind):
    scopes_vec = native_read_i64(tree as i64, 0)
    new_scope_id = vec_len_rt(scopes_vec)
    curr_id = native_read_i64(tree as i64, 8)
    
    node = ScopeNode (
        kind: kind,
        parent_id: curr_id,
        symbols: vec_new_rt()
    )
    
    scopes_vec = vec_push_rt(scopes_vec, node)
    native_write_i64(tree as i64, 0, scopes_vec)
    native_write_i64(tree as i64, 8, new_scope_id)
    out new_scope_id
end.
func scope_pop(tree: ScopeTree):
    curr_id = native_read_i64(tree as i64, 8)
    scopes_vec = native_read_i64(tree as i64, 0)
    current_node = vec_get_rt(scopes_vec, curr_id)
    parent = native_read_i64(current_node as i64, 8)
    if parent != -1 do
        native_write_i64(tree as i64, 8, parent)
    end
end.
func scope_current_id(tree: ScopeTree):
    out native_read_i64(tree as i64, 8)
end.
func scope_reset(tree: ScopeTree):
    native_write_i64(tree as i64, 8, 0)
end.
func scope_add_symbol(tree: ScopeTree, scope_id: i64, symbol_id: i64):
    scopes_vec = native_read_i64(tree as i64, 0)
    node = vec_get_rt(scopes_vec, scope_id)
    syms = native_read_i64(node as i64, 16)
    syms = vec_push_rt(syms, symbol_id)
    native_write_i64(node as i64, 16, syms)
end.
func scope_get_parent(tree: ScopeTree, scope_id: i64):
    scopes_vec = native_read_i64(tree as i64, 0)
    node = vec_get_rt(scopes_vec, scope_id)
    out native_read_i64(node as i64, 8)
end.