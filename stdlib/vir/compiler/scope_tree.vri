##
 * vir/compiler/scope_tree.vri
 * ==============================================================
 * Quản lý phạm vi kế thừa (Block Scoping) cho Semantic Analysis.
 ##

include vec_rt;
import vec_new_rt, vec_push_rt, vec_get_rt, vec_len_rt from vec_rt;

enum ScopeKind:
    Global = 0,
    Func   = 1,
    Block  = 2,
    Loop   = 3,
    Module = 4,
    Entity = 5,
    Enum   = 6,
    Match  = 7
end.
entity ScopeNode:
    kind: ScopeKind,
    parent_id: i64,     # Trỏ về ScopeID cha, 0 else có (or là Global)
    symbols: i64        # Vec chứa các SymbolID được định nghĩa in scope này
end.
entity ScopeTree:
    scopes: i64,        # Vec chứa ScopeNode
    current_id: i64     # ScopeID đang được duyệt (hoạt động như đỉnh stack)
end.
func scope_tree_new()
    tree = ScopeTree (
        scopes: vec_new_rt(),
        current_id: 0
    );
    
    # Global Scope có ScopeID = 0
    global_scope = ScopeNode (
        kind: ScopeKind.Global,
        parent_id: -1,  # Báo hiệu đây là root
        symbols: vec_new_rt()
    );
    vec_push_rt(tree.scopes, global_scope);
    
    out tree
end.
func scope_push(tree: ScopeTree, kind: ScopeKind)
    new_scope_id = vec_len_rt(tree.scopes);
    
    node = ScopeNode (
        kind: kind,
        parent_id: tree.current_id,
        symbols: vec_new_rt()
    );
    
    vec_push_rt(tree.scopes, node);
    tree.current_id = new_scope_id;
    out new_scope_id
end.
func scope_pop(tree: ScopeTree)
    # Trở về scope cha
    current_node = vec_get_rt(tree.scopes, tree.current_id);
    if current_node.parent_id == -1 do
        # Panic or handle error: popping global scope!
        # For now, let's just do nothing
    else
        tree.current_id = current_node.parent_id
end.
end
func scope_add_symbol(tree: ScopeTree, scope_id: i64, symbol_id: i64)
    node = vec_get_rt(tree.scopes, scope_id);
    vec_push_rt(node.symbols, symbol_id)
end.
func scope_get_parent(tree: ScopeTree, scope_id: i64)
    node = vec_get_rt(tree.scopes, scope_id);
    out node.parent_id
end.