##
 * vir/compiler/codegen.vri — Machine Code Generator (Pure Vir)
 ##

include types
include vec_rt
import vec_new_rt, vec_push_rt, vec_get_rt, vec_set_rt, vec_len_rt from vec_rt
include string_rt
import native_read_i64, native_write_i64, native_read_u8, native_write_u8 from string_rt
include buffer
import bvec_new, bvec_push, bvec_get, bvec_set, bvec_len from buffer

enum TargetArch:
    Unknown = 0
    X86_64  = 1
    ARM64   = 2
end.

enum OpndType:
    None  = 0
    VReg  = 1
    Imm   = 2
    Label = 3
end.

func detect_arch():
    out TargetArch.ARM64
end.

entity CodeBuf:
    arch: TargetArch,
    data: i64,
    len: i64,
    start_offset: i64
end.

func codebuf_new(arch: TargetArch):
    p = alloc(32)
    native_write_i64(p, 0, arch as i64)
    native_write_i64(p, 8, bvec_new())
    native_write_i64(p, 16, 0)
    native_write_i64(p, 24, 0)
    out p
end.

func codebuf_emit_byte(cb: CodeBuf, byte: int):
    data = native_read_i64(cb as i64, 8)
    data = bvec_push(data, byte bit_and 0xFF)
    native_write_i64(cb as i64, 8, data)
    native_write_i64(cb as i64, 16, bvec_len(data))
    out cb
end.

func codebuf_emit_u32(cb: CodeBuf, val: int):
    cb = codebuf_emit_byte(cb, val bit_and 0xFF)
    cb = codebuf_emit_byte(cb, (val shr 8) bit_and 0xFF)
    cb = codebuf_emit_byte(cb, (val shr 16) bit_and 0xFF)
    cb = codebuf_emit_byte(cb, (val shr 24) bit_and 0xFF)
    out cb
end.

func codebuf_emit_u64(cb: CodeBuf, val: int):
    cb = codebuf_emit_u32(cb, val bit_and 0xFFFFFFFF)
    cb = codebuf_emit_u32(cb, (val shr 32) bit_and 0xFFFFFFFF)
    out cb
end.

func codebuf_emit_i32(cb: CodeBuf, val: int):
    out codebuf_emit_u32(cb, val)
end.

func codebuf_offset(cb: CodeBuf):
    data = native_read_i64(cb as i64, 8)
    out bvec_len(data)
end.

func codebuf_patch_i32(cb: CodeBuf, offset: int, val: int):
    data = native_read_i64(cb as i64, 8)
    if offset + 4 <= bvec_len(data) do
        bvec_set(data, offset, val bit_and 0xFF)
        bvec_set(data, offset + 1, (val shr 8) bit_and 0xFF)
        bvec_set(data, offset + 2, (val shr 16) bit_and 0xFF)
        bvec_set(data, offset + 3, (val shr 24) bit_and 0xFF)
    end
    out cb
end.

func codebuf_patch_u32(cb: CodeBuf, offset: int, val: int):
    out codebuf_patch_i32(cb, offset, val)
end.

func codebuf_get_data(cb: CodeBuf, idx: int):
    data = native_read_i64(cb as i64, 8)
    out bvec_get(data, idx)
end.

func codebuf_hexdump(cb: CodeBuf):
    out 0
end.

# ═══════════════════════════════════════════════════════
# ARM64 Instruction Emitters
# ═══════════════════════════════════════════════════════

func arm64_add_rrr(cb: CodeBuf, rd: int, rn: int, rm: int):
    instr = 0x8B000000 bit_or ((rm bit_and 0x1F) shl 16) bit_or ((rn bit_and 0x1F) shl 5) bit_or (rd bit_and 0x1F)
    out codebuf_emit_u32(cb, instr)
end.

func arm64_sub_rrr(cb: CodeBuf, rd: int, rn: int, rm: int):
    instr = 0xCB000000 bit_or ((rm bit_and 0x1F) shl 16) bit_or ((rn bit_and 0x1F) shl 5) bit_or (rd bit_and 0x1F)
    out codebuf_emit_u32(cb, instr)
end.

func arm64_mul_rrr(cb: CodeBuf, rd: int, rn: int, rm: int):
    instr = 0x9B007C00 bit_or ((rm bit_and 0x1F) shl 16) bit_or ((rn bit_and 0x1F) shl 5) bit_or (rd bit_and 0x1F)
    out codebuf_emit_u32(cb, instr)
end.

func arm64_sdiv_rrr(cb: CodeBuf, rd: int, rn: int, rm: int):
    instr = 0x9AC00C00 bit_or ((rm bit_and 0x1F) shl 16) bit_or ((rn bit_and 0x1F) shl 5) bit_or (rd bit_and 0x1F)
    out codebuf_emit_u32(cb, instr)
end.

func arm64_msub_rrrr(cb: CodeBuf, rd: int, rn: int, rm: int, ra: int):
    instr = 0x9B008000 bit_or ((rm bit_and 0x1F) shl 16) bit_or ((ra bit_and 0x1F) shl 10) bit_or ((rn bit_and 0x1F) shl 5) bit_or (rd bit_and 0x1F)
    out codebuf_emit_u32(cb, instr)
end.

func arm64_mov_imm16(cb: CodeBuf, rd: int, imm: int):
    instr = 0xD2800000 bit_or ((imm bit_and 0xFFFF) shl 5) bit_or (rd bit_and 0x1F)
    out codebuf_emit_u32(cb, instr)
end.

func arm64_movz_imm64(cb: CodeBuf, rd: int, imm: int):
    var uimm = imm
    instr = 0xD2800000 bit_or ((uimm bit_and 0xFFFF) shl 5) bit_or (rd bit_and 0x1F)
    cb = codebuf_emit_u32(cb, instr)
    if (uimm shr 16) != 0 do
        instr = 0xF2A00000 bit_or (((uimm shr 16) bit_and 0xFFFF) shl 5) bit_or (rd bit_and 0x1F)
        cb = codebuf_emit_u32(cb, instr)
    end
    if (uimm shr 32) != 0 do
        instr = 0xF2C00000 bit_or (((uimm shr 32) bit_and 0xFFFF) shl 5) bit_or (rd bit_and 0x1F)
        cb = codebuf_emit_u32(cb, instr)
    end
    if (uimm shr 48) != 0 do
        instr = 0xF2E00000 bit_or (((uimm shr 48) bit_and 0xFFFF) shl 5) bit_or (rd bit_and 0x1F)
        cb = codebuf_emit_u32(cb, instr)
    end
    out cb
end.

func arm64_mov_rr(cb: CodeBuf, rd: int, rm: int):
    instr = 0xAA0003E0 bit_or ((rm bit_and 0x1F) shl 16) bit_or (rd bit_and 0x1F)
    out codebuf_emit_u32(cb, instr)
end.

func arm64_mov_from_sp(cb: CodeBuf, rd: int):
    out codebuf_emit_u32(cb, 0x910003E0 bit_or (rd bit_and 0x1F))
end.

func arm64_cmp_rr(cb: CodeBuf, rn: int, rm: int):
    instr = 0xEB00001F bit_or ((rm bit_and 0x1F) shl 16) bit_or ((rn bit_and 0x1F) shl 5)
    out codebuf_emit_u32(cb, instr)
end.

func arm64_cmp_imm0(cb: CodeBuf, rn: int):
    out codebuf_emit_u32(cb, 0xF100001F bit_or ((rn bit_and 0x1F) shl 5))
end.

func arm64_cset_eq(cb: CodeBuf, rd: int):
    out codebuf_emit_u32(cb, 0x9A9F17E0 bit_or (rd bit_and 0x1F))
end.

func arm64_cset_ne(cb: CodeBuf, rd: int):
    out codebuf_emit_u32(cb, 0x9A9F07E0 bit_or (rd bit_and 0x1F))
end.

func arm64_cset_gt(cb: CodeBuf, rd: int):
    out codebuf_emit_u32(cb, 0x9A9FD7E0 bit_or (rd bit_and 0x1F))
end.

func arm64_cset_lt(cb: CodeBuf, rd: int):
    out codebuf_emit_u32(cb, 0x9A9FA7E0 bit_or (rd bit_and 0x1F))
end.

func arm64_cset_ge(cb: CodeBuf, rd: int):
    out codebuf_emit_u32(cb, 0x9A9FB7E0 bit_or (rd bit_and 0x1F))
end.

func arm64_cset_le(cb: CodeBuf, rd: int):
    out codebuf_emit_u32(cb, 0x9A9FC7E0 bit_or (rd bit_and 0x1F))
end.

func arm64_b_imm26(cb: CodeBuf, offset: int):
    imm26 = (offset shr 2) bit_and 0x03FFFFFF
    out codebuf_emit_u32(cb, 0x14000000 bit_or imm26)
end.

func arm64_beq_imm19(cb: CodeBuf, offset: int):
    imm19 = (offset shr 2) bit_and 0x7FFFF
    out codebuf_emit_u32(cb, 0x54000000 bit_or (imm19 shl 5))
end.

func arm64_bne_imm19(cb: CodeBuf, offset: int):
    imm19 = (offset shr 2) bit_and 0x7FFFF
    out codebuf_emit_u32(cb, 0x54000001 bit_or (imm19 shl 5))
end.

func arm64_bl_imm26(cb: CodeBuf, offset: int):
    imm26 = (offset shr 2) bit_and 0x03FFFFFF
    out codebuf_emit_u32(cb, 0x94000000 bit_or imm26)
end.

func arm64_ret(cb: CodeBuf):
    out codebuf_emit_u32(cb, 0xD65F03C0)
end.

func arm64_nop(cb: CodeBuf):
    out codebuf_emit_u32(cb, 0xD503201F)
end.

func arm64_stp_pre(cb: CodeBuf, rt: int, rt2: int, rn: int, imm: int):
    simm7 = (imm / 8) bit_and 0x7F
    instr = 0xA9800000 bit_or (simm7 shl 15) bit_or ((rt2 bit_and 0x1F) shl 10) bit_or ((rn bit_and 0x1F) shl 5) bit_or (rt bit_and 0x1F)
    out codebuf_emit_u32(cb, instr)
end.

func arm64_ldp_post(cb: CodeBuf, rt: int, rt2: int, rn: int, imm: int):
    simm7 = (imm / 8) bit_and 0x7F
    instr = 0xA8C00000 bit_or (simm7 shl 15) bit_or ((rt2 bit_and 0x1F) shl 10) bit_or ((rn bit_and 0x1F) shl 5) bit_or (rt bit_and 0x1F)
    out codebuf_emit_u32(cb, instr)
end.

func arm64_str_pre(cb: CodeBuf, rt: int, rn: int, imm: int):
    simm9 = imm bit_and 0x1FF
    instr = 0xF8000C00 bit_or (simm9 shl 12) bit_or ((rn bit_and 0x1F) shl 5) bit_or (rt bit_and 0x1F)
    out codebuf_emit_u32(cb, instr)
end.

func arm64_ldr_post(cb: CodeBuf, rt: int, rn: int, imm: int):
    simm9 = imm bit_and 0x1FF
    instr = 0xF8400400 bit_or (simm9 shl 12) bit_or ((rn bit_and 0x1F) shl 5) bit_or (rt bit_and 0x1F)
    out codebuf_emit_u32(cb, instr)
end.

func arm64_svc(cb: CodeBuf, imm: int):
    out codebuf_emit_u32(cb, 0xD4000001 bit_or ((imm bit_and 0xFFFF) shl 5))
end.

func arm64_blr_x16(cb: CodeBuf):
    out codebuf_emit_u32(cb, 0xD63F0200)
end.

func arm64_and_rrr(cb: CodeBuf, rd: int, rn: int, rm: int):
    instr = 0x8A000000 bit_or ((rm bit_and 0x1F) shl 16) bit_or ((rn bit_and 0x1F) shl 5) bit_or (rd bit_and 0x1F)
    out codebuf_emit_u32(cb, instr)
end.

func arm64_orr_rrr(cb: CodeBuf, rd: int, rn: int, rm: int):
    instr = 0xAA000000 bit_or ((rm bit_and 0x1F) shl 16) bit_or ((rn bit_and 0x1F) shl 5) bit_or (rd bit_and 0x1F)
    out codebuf_emit_u32(cb, instr)
end.

func arm64_eor_rrr(cb: CodeBuf, rd: int, rn: int, rm: int):
    instr = 0xCA000000 bit_or ((rm bit_and 0x1F) shl 16) bit_or ((rn bit_and 0x1F) shl 5) bit_or (rd bit_and 0x1F)
    out codebuf_emit_u32(cb, instr)
end.

func arm64_lsl_rrr(cb: CodeBuf, rd: int, rn: int, rm: int):
    instr = 0x9AC02000 bit_or ((rm bit_and 0x1F) shl 16) bit_or ((rn bit_and 0x1F) shl 5) bit_or (rd bit_and 0x1F)
    out codebuf_emit_u32(cb, instr)
end.

func arm64_lsr_rrr(cb: CodeBuf, rd: int, rn: int, rm: int):
    instr = 0x9AC02400 bit_or ((rm bit_and 0x1F) shl 16) bit_or ((rn bit_and 0x1F) shl 5) bit_or (rd bit_and 0x1F)
    out codebuf_emit_u32(cb, instr)
end.

func arm64_mvn_rr(cb: CodeBuf, rd: int, rm: int):
    instr = 0xAA2003E0 bit_or ((rm bit_and 0x1F) shl 16) bit_or (rd bit_and 0x1F)
    out codebuf_emit_u32(cb, instr)
end.

func arm64_ror_imm32(cb: CodeBuf, rd: int, rn: int, shift: int):
    instr = 0x13800000 bit_or ((rn bit_and 0x1F) shl 16) bit_or ((shift bit_and 0x1F) shl 10) bit_or ((rn bit_and 0x1F) shl 5) bit_or (rd bit_and 0x1F)
    out codebuf_emit_u32(cb, instr)
end.

func arm64_eor_lsr64(cb: CodeBuf, rd: int, rn: int, rm: int, shift: int):
    instr = 0xCA400000 bit_or ((rm bit_and 0x1F) shl 16) bit_or ((shift bit_and 0x3F) shl 10) bit_or ((rn bit_and 0x1F) shl 5) bit_or (rd bit_and 0x1F)
    out codebuf_emit_u32(cb, instr)
end.
func arm64_eor_lsr32(cb: CodeBuf, rd: int, rn: int, rm: int, shift: int):
    instr = 0x4A400000 bit_or ((rm bit_and 0x1F) shl 16) bit_or ((shift bit_and 0x1F) shl 10) bit_or ((rn bit_and 0x1F) shl 5) bit_or (rd bit_and 0x1F)
    out codebuf_emit_u32(cb, instr)
end.

func arm64_add_imm(cb: CodeBuf, rd: int, rn: int, imm: int):
    instr = 0x91000000 bit_or ((imm bit_and 0xFFF) shl 10) bit_or ((rn bit_and 0x1F) shl 5) bit_or (rd bit_and 0x1F)
    out codebuf_emit_u32(cb, instr)
end.

func arm64_sub_imm(cb: CodeBuf, rd: int, rn: int, imm: int):
    instr = 0xD1000000 bit_or ((imm bit_and 0xFFF) shl 10) bit_or ((rn bit_and 0x1F) shl 5) bit_or (rd bit_and 0x1F)
    out codebuf_emit_u32(cb, instr)
end.

func arm64_str_uoff(cb: CodeBuf, rt: int, rn: int, uoff: int):
    imm12 = (uoff / 8) bit_and 0xFFF
    instr = 0xF9000000 bit_or (imm12 shl 10) bit_or ((rn bit_and 0x1F) shl 5) bit_or (rt bit_and 0x1F)
    out codebuf_emit_u32(cb, instr)
end.

func arm64_stur(cb: CodeBuf, rt: int, rn: int, simm9: int):
    instr = 0xF8000000 bit_or ((simm9 bit_and 0x1FF) shl 12) bit_or ((rn bit_and 0x1F) shl 5) bit_or (rt bit_and 0x1F)
    out codebuf_emit_u32(cb, instr)
end.

func arm64_ldur(cb: CodeBuf, rt: int, rn: int, simm9: int):
    instr = 0xF8400000 bit_or ((simm9 bit_and 0x1FF) shl 12) bit_or ((rn bit_and 0x1F) shl 5) bit_or (rt bit_and 0x1F)
    out codebuf_emit_u32(cb, instr)
end.

func arm64_ldr_uoff(cb: CodeBuf, rt: int, rn: int, uoff: int):
    imm12 = (uoff / 8) bit_and 0xFFF
    instr = 0xF9400000 bit_or (imm12 shl 10) bit_or ((rn bit_and 0x1F) shl 5) bit_or (rt bit_and 0x1F)
    out codebuf_emit_u32(cb, instr)
end.

func arm64_ldrb_reg(cb: CodeBuf, rt: int, rn: int, rm: int):
    instr = 0x38606800 bit_or ((rm bit_and 0x1F) shl 16) bit_or ((rn bit_and 0x1F) shl 5) bit_or (rt bit_and 0x1F)
    out codebuf_emit_u32(cb, instr)
end.

func arm64_strb_reg(cb: CodeBuf, rt: int, rn: int, rm: int):
    instr = 0x38206800 bit_or ((rm bit_and 0x1F) shl 16) bit_or ((rn bit_and 0x1F) shl 5) bit_or (rt bit_and 0x1F)
    out codebuf_emit_u32(cb, instr)
end.

func arm64_strb_uoff(cb: CodeBuf, rt: int, rn: int, uoff: int):
    instr = 0x39000000 bit_or ((uoff bit_and 0xFFF) shl 10) bit_or ((rn bit_and 0x1F) shl 5) bit_or (rt bit_and 0x1F)
    out codebuf_emit_u32(cb, instr)
end.

func arm64_ldrb_uoff(cb: CodeBuf, rt: int, rn: int, uoff: int):
    instr = 0x39400000 bit_or ((uoff bit_and 0xFFF) shl 10) bit_or ((rn bit_and 0x1F) shl 5) bit_or (rt bit_and 0x1F)
    out codebuf_emit_u32(cb, instr)
end.

func arm64_str_reg(cb: CodeBuf, rt: int, rn: int, rm: int):
    instr = 0xF8206800 bit_or ((rm bit_and 0x1F) shl 16) bit_or ((rn bit_and 0x1F) shl 5) bit_or (rt bit_and 0x1F)
    out codebuf_emit_u32(cb, instr)
end.

func arm64_ldr_reg(cb: CodeBuf, rt: int, rn: int, rm: int):
    instr = 0xF8606800 bit_or ((rm bit_and 0x1F) shl 16) bit_or ((rn bit_and 0x1F) shl 5) bit_or (rt bit_and 0x1F)
    out codebuf_emit_u32(cb, instr)
end.

func lir_emit_module(lir_funcs: i64, arch: TargetArch):
    out codebuf_new(arch)
end.

entity PatchState:
    labels: i64,
    fixups: i64,
    label_count: int,
    fixup_count: int
end.

func patch_new():
    p = alloc(32)
    native_write_i64(p, 0, vec_new_rt())
    native_write_i64(p, 8, vec_new_rt())
    native_write_i64(p, 16, 0)
    native_write_i64(p, 24, 0)
    out p
end.

func patch_add_label(ps: PatchState, label_id: int, offset: int):
    out ps
end.

func patch_add_fixup(ps: PatchState, patch_offset: int, target_label: int, is_cond: int):
    out ps
end.

func backpatch_x86(cb: CodeBuf, ps: PatchState):
    out cb
end.

func backpatch_arm64(cb: CodeBuf, ps: PatchState):
    out cb
end.

func backpatch(cb: CodeBuf, ps: PatchState):
    out cb
end.

func arm64_stp_off(cb: CodeBuf, rt: int, rt2: int, rn: int, imm: int):
    simm7 = (imm / 8) bit_and 0x7F
    instr = 0xA9000000 bit_or (simm7 shl 15) bit_or ((rt2 bit_and 0x1F) shl 10) bit_or ((rn bit_and 0x1F) shl 5) bit_or (rt bit_and 0x1F)
    out codebuf_emit_u32(cb, instr)
end.

func arm64_ldp_off(cb: CodeBuf, rt: int, rt2: int, rn: int, imm: int):
    simm7 = (imm / 8) bit_and 0x7F
    instr = 0xA9400000 bit_or (simm7 shl 15) bit_or ((rt2 bit_and 0x1F) shl 10) bit_or ((rn bit_and 0x1F) shl 5) bit_or (rt bit_and 0x1F)
    out codebuf_emit_u32(cb, instr)
end.

func arm64_lsl_imm(cb: CodeBuf, rd: int, rn: int, shift: int):
    immr = (0 - shift) bit_and 0x3F
    imms = 63 - shift
    instr = 0xD3400000 bit_or (immr shl 16) bit_or (imms shl 10) bit_or ((rn bit_and 0x1F) shl 5) bit_or (rd bit_and 0x1F)
    out codebuf_emit_u32(cb, instr)
end.

func arm64_asr_rrr(cb: CodeBuf, rd: int, rn: int, rm: int):
    instr = 0x9AC02800 bit_or ((rm bit_and 0x1F) shl 16) bit_or ((rn bit_and 0x1F) shl 5) bit_or (rd bit_and 0x1F)
    out codebuf_emit_u32(cb, instr)
end.

func arm64_ldr_reg(cb: CodeBuf, rt: int, rn: int, rm: int):
    instr = 0xF8607800 bit_or ((rm bit_and 0x1F) shl 16) bit_or ((rn bit_and 0x1F) shl 5) bit_or (rt bit_and 0x1F)
    out codebuf_emit_u32(cb, instr)
end.

func arm64_str_reg(cb: CodeBuf, rt: int, rn: int, rm: int):
    instr = 0xF8207800 bit_or ((rm bit_and 0x1F) shl 16) bit_or ((rn bit_and 0x1F) shl 5) bit_or (rt bit_and 0x1F)
    out codebuf_emit_u32(cb, instr)
end.

func arm64_str_xzr_uoff(cb: CodeBuf, rn: int, uoff: int):
    imm12 = (uoff / 8) bit_and 0xFFF
    instr = 0xF900001F bit_or (imm12 shl 10) bit_or ((rn bit_and 0x1F) shl 5)
    out codebuf_emit_u32(cb, instr)
end.

func arm64_ubfx(cb: CodeBuf, rd: int, rn: int, lsb: int, width: int):
    immr = lsb bit_and 0x3F
    imms = (lsb + width - 1) bit_and 0x3F
    instr = 0xD3400000 bit_or (immr shl 16) bit_or (imms shl 10) bit_or ((rn bit_and 0x1F) shl 5) bit_or (rd bit_and 0x1F)
    out codebuf_emit_u32(cb, instr)
end.

func arm64_bfi(cb: CodeBuf, rd: int, rn: int, lsb: int, width: int):
    immr = (64 - lsb) bit_and 0x3F
    imms = (width - 1) bit_and 0x3F
    instr = 0xB3400000 bit_or (immr shl 16) bit_or (imms shl 10) bit_or ((rn bit_and 0x1F) shl 5) bit_or (rd bit_and 0x1F)
    out codebuf_emit_u32(cb, instr)
end.

func arm64_dmb_ishld(cb: CodeBuf):
    out codebuf_emit_u32(cb, 0xD50339BF)
end.

func arm64_dmb_ishst(cb: CodeBuf):
    out codebuf_emit_u32(cb, 0xD5033ABF)
end.

func arm64_dmb_sy(cb: CodeBuf):
    out codebuf_emit_u32(cb, 0xD5033FBF)
end.

func arm64_dsb_sy(cb: CodeBuf):
    out codebuf_emit_u32(cb, 0xD5033F9F)
end.

func arm64_isb(cb: CodeBuf):
    out codebuf_emit_u32(cb, 0xD5033FDF)
end.

func arm64_wfi(cb: CodeBuf):
    out codebuf_emit_u32(cb, 0xD503207F)
end.

func arm64_wfe(cb: CodeBuf):
    out codebuf_emit_u32(cb, 0xD503205F)
end.

func arm64_sev(cb: CodeBuf):
    out codebuf_emit_u32(cb, 0xD503209F)
end.

func arm64_clz(cb: CodeBuf, rd: int, rn: int):
    out codebuf_emit_u32(cb, 0xDAC01000 bit_or ((rn bit_and 0x1F) << 5) bit_or (rd bit_and 0x1F))
end.

func arm64_rbit(cb: CodeBuf, rd: int, rn: int):
    out codebuf_emit_u32(cb, 0xDAC00000 bit_or ((rn bit_and 0x1F) << 5) bit_or (rd bit_and 0x1F))
end.

func arm64_rev(cb: CodeBuf, rd: int, rn: int):
    out codebuf_emit_u32(cb, 0xDAC00C00 bit_or ((rn bit_and 0x1F) << 5) bit_or (rd bit_and 0x1F))
end.

func arm64_brk(cb: CodeBuf, imm16: int):
    out codebuf_emit_u32(cb, 0xD4200000 bit_or ((imm16 bit_and 0xFFFF) << 5))
end.

func vreg_to_arm(vreg: int):
    if vreg >= 0 and vreg < 16 do
        out vreg
    end
    out 0
end.

func vreg_to_x86(vreg: int):
    if vreg == 0 do out 0 end
    if vreg == 1 do out 1 end
    if vreg == 2 do out 2 end
    if vreg == 3 do out 6 end
    if vreg == 4 do out 7 end
    if vreg == 5 do out 8 end
    if vreg == 6 do out 9 end
    if vreg == 7 do out 10 end
    if vreg == 8 do out 11 end
    if vreg == 9 do out 3 end
    if vreg == 10 do out 12 end
    if vreg == 11 do out 13 end
    if vreg == 12 do out 14 end
    if vreg == 13 do out 15 end
    out 0
end.

