##
 * vir/str/string.vri — Immutable UTF-8 String
 * =============================================
 * String default của Vir là UTF-8 immutable.
 * Biến đổi string -> tạo string mới (use StringBuilder cho hiệu suất).
 *
 * Inspired by C23: <string.h> strlen, strcmp, strstr
 * Inspired by Python: str type methods
 * Vượt cả hai: Unicode-first, không null-terminated.
 ##

include types;
include option;
import Option, Some, None from option;
include result;
import Result, Ok, Err from result;
include alloc;
import alloc, free from alloc;
include copy;
import mem_copy, mem_cmp from copy;

entity String:
    data: ptr       # UTF-8 encoded bytes (owned, NOT null-terminated inside);
    byte_len: i64   # Số bytes;
    char_len: i64   # Số Unicode codepoints (cached, tính lần đầu)
end.

# ═══════════════════════════════════════════════════════
# Tạo string
# ═══════════════════════════════════════════════════════

func str_new(literal:string):
    # Tạo String từ string literal. Copy dữ liệu.
    blen = native_str_byte_len(literal);
    let p = alloc(blen);
    mem_copy(p, native_str_ptr(literal), blen);
    out string ( data: p, byte_len: blen, char_len: utf8_count_chars(p, blen) )
end.

func str_empty:
    out string ( data: null, byte_len: 0, char_len: 0 )
end.

func str_from_bytes(data:ptr, len: i64):
    let p = alloc(len);
    mem_copy(p, data, len);
    out string ( data: p, byte_len: len, char_len: utf8_count_chars(p, len) )
end.

# ═══════════════════════════════════════════════════════
# Thông tin cơ bản
# ═══════════════════════════════════════════════════════

func str_len(s:string):
    # Returns số codepoints (character Unicode)
    out s.char_len
end.

func str_byte_len(s:string):
    # Returns số bytes
    out s.byte_len
end.

func str_is_empty(s:string):
    out s.byte_len == 0
end.

# ═══════════════════════════════════════════════════════
# Truy cập character
# ═══════════════════════════════════════════════════════

func str_char_at(s:string, index: i64):
    # Returns Unicode codepoint tại vị trí index (theo codepoint, O(n))
    if index >= s.char_len do
        panic("str_char_at: index out of bounds")
    end.
    out utf8_char_at(s.data, s.byte_len, index)
end.

func str_byte_at(s:string, index: i64):
    # Returns byte tại vị trí index (O(1))
    if index >= s.byte_len do
        panic("str_byte_at: index out of bounds")
    end.
    out native_load_u8(s.data, index)
end.

# ═══════════════════════════════════════════════════════
# So sánh
# ═══════════════════════════════════════════════════════

func str_eq(a:string, b:string):
    if a.byte_len != b.byte_len do out false end.
    out mem_cmp(a.data, b.data, a.byte_len) == 0
end.

func str_cmp(a:string, b:string):
        var min_len = a.byte_len;
    if b.byte_len < a.byte_len do min_len = b.byte_len end.
    r = mem_cmp(a.data, b.data, min_len);
    if r != 0 do out r end.
    if a.byte_len < b.byte_len do out -1 end.
    if a.byte_len > b.byte_len do out 1 end.
    out 0
end.

# ═══════════════════════════════════════════════════════
# Cắt string (Slicing)
# ═══════════════════════════════════════════════════════

func str_slice(s:string, start_pos: i64, to: i64):
    # Cắt theo vị trí codepoint [from, to)
    if start_pos > to or to > s.char_len do
        panic("str_slice: invalid range")
    end.
    byte_start = utf8_offset_of(s.data, s.byte_len, start_pos);
    byte_end = utf8_offset_of(s.data, s.byte_len, to);
    out str_from_bytes(s.data + byte_start, byte_end - byte_start)
end.

func str_slice_bytes(s:string, start_pos: i64, to: i64):
    # Cắt theo byte offset [from, to) — nhanh hơn, phải đảm bảo valid UTF-8
    if start_pos > to or to > s.byte_len do
        panic("str_slice_bytes: invalid range")
    end.
    out str_from_bytes(s.data + start_pos, to - start_pos)
end.

# ═══════════════════════════════════════════════════════
# Nối string (Concatenation)
# ═══════════════════════════════════════════════════════

func str_concat(a:string, b:string):
    total = a.byte_len + b.byte_len;
    let p = alloc(total);
    mem_copy(p, a.data, a.byte_len);
    mem_copy(p + a.byte_len, b.data, b.byte_len);
    out string ( data: p, byte_len: total, char_len: a.char_len + b.char_len )
end.

# ═══════════════════════════════════════════════════════
# Tìm kiếm
# ═══════════════════════════════════════════════════════

func str_contains(haystack:string, needle:string):
    out is_some(str_find(haystack, needle))
end.

func str_find(haystack:string, needle:string):
    # Two-Way algorithm — O(n) worst-case, O(1) space (same as glibc strstr)
    n = haystack.byte_len;
    m = needle.byte_len;
    if m == 0 do out Some(0) end.
    if m > n do out None end.
    if m == 1 do
        # Single byte fast path
        b = native_load_u8(needle.data, 0);
        i = 0;
        when i < n loop
            if native_load_u8(haystack.data, i) == b do
                out Some(i)
            end.
            i = i + 1
        end.
        out None
    end.

    # Compute maximal suffix (Two-Way critical factorization)
    ms = _two_way_maxsuf(needle.data, m, false);
    ms2 = _two_way_maxsuf(needle.data, m, true);
    if ms > ms2 do  period_pos = ms; else: period_pos = ms2 end.

    # Check if needle has a periodic structure
    period = period_pos + 1;  # simplified period for Two-Way
    memory = 0;
    i = 0;
    when i <= n - m loop
        # Right half
        var j = period_pos;
        if memory > period_pos do j = memory end.
        found_right = true;
        when j < m loop
            if native_load_u8(haystack.data, i + j) != native_load_u8(needle.data, j) do
                i = i + (j - period_pos);
                memory = 0;
                found_right = false;
                thoát
            end.
            j = j + 1
        end.
        if found_right do
            # Left half
            j = period_pos;
            matched = true;
            when j > memory loop
                j = j - 1;
                if native_load_u8(haystack.data, i + j) != native_load_u8(needle.data, j) do
                    i = i + period;
                    memory = m - period;
                    matched = false;
                    thoát
                end.
            end.
            if matched do
                out Some(i)
            end.
        end.
    end.
    out None
end.

func _two_way_maxsuf(pat:ptr, m: i64, reversed:bool):
    # Compute maximal suffix position for Two-Way algorithm
    ms = -1;
    j = 0;
    p = 1;
    k = 1;
    when j + k < m loop
        a = native_load_u8(pat, j + k);
        b = native_load_u8(pat, ms + k);
        if reversed do  tmp = a; a = b; b = tmp end.
        if a < b do
            j = j + k;
            k = 1;
            p = j - ms;
        eif a == b do
            if k == p do
                j = j + p;
                k = 1;
            else
                k = k + 1
            end.
        else
            ms = j;
            j = ms + 1;
            k = 1;
            p = 1
        end.
    end.
    out ms
end.

func str_starts_with(s:string, prefix:string):
    if prefix.byte_len > s.byte_len do out false end.
    out mem_cmp(s.data, prefix.data, prefix.byte_len) == 0
end.

func str_ends_with(s:string, suffix:string):
    if suffix.byte_len > s.byte_len do out false end.
    offset = s.byte_len - suffix.byte_len;
    out mem_cmp(s.data + offset, suffix.data, suffix.byte_len) == 0
end.

# ═══════════════════════════════════════════════════════
# Biến đổi
# ═══════════════════════════════════════════════════════

func str_to_upper(s:string):
    # ASCII to_upper (Unicode full case mapping cần bảng tra)
    let p = alloc(s.byte_len);
    mem_copy(p, s.data, s.byte_len);
    for  i in 0..s.byte_len do
        b = native_load_u8(p, i);
        if b >= 0x61 and b <= 0x7A do
            native_store_u8(p, i, b - 32)
        end.
    end.
    out string ( data: p, byte_len: s.byte_len, char_len: s.char_len )
end.

func str_to_lower(s:string):
    let p = alloc(s.byte_len);
    mem_copy(p, s.data, s.byte_len);
    for  i in 0..s.byte_len do
        b = native_load_u8(p, i);
        if b >= 0x41 and b <= 0x5A do
            native_store_u8(p, i, b + 32)
        end.
    end.
    out string ( data: p, byte_len: s.byte_len, char_len: s.char_len )
end.

func str_trim(s:string):
    start = 0;
    when start < s.byte_len and is_ascii_whitespace(native_load_u8(s.data, start)) loop
        start = start + 1
    end.
    let end_pos = s.byte_len;
    when end_pos > start and is_ascii_whitespace(native_load_u8(s.data, end_pos - 1)) loop
        end_pos = end_pos - 1
    end.
    out str_slice_bytes(s, start, end_pos)
end.

func str_trim_start(s:string):
    start = 0;
    when start < s.byte_len and is_ascii_whitespace(native_load_u8(s.data, start)) loop
        start = start + 1
    end.
    out str_slice_bytes(s, start, s.byte_len)
end.

func str_trim_end(s:string):
    let end_pos = s.byte_len;
    when end_pos > 0 and is_ascii_whitespace(native_load_u8(s.data, end_pos - 1)) loop
        end_pos = end_pos - 1
    end.
    out str_slice_bytes(s, 0, end_pos)
end.

func str_replace(s:string, old:string, new:string):
    # Thay thế tất cả occurrence của `old` bằng `new`
    # TODO: implement using StringBuilder for efficiency
    out native_str_replace(s, old, new)
end.

func str_repeat(s:string, count: i64):
    total = s.byte_len * count;
    let p = alloc(total);
    for  i in 0..count do
        mem_copy(p + i * s.byte_len, s.data, s.byte_len)
    end.
    out string ( data: p, byte_len: total, char_len: s.char_len * count )
end.

# ═══════════════════════════════════════════════════════
# Tách / Nối
# ═══════════════════════════════════════════════════════

func str_split(s:string, delim:string):
    # Tách string theo delimiter
    out native_str_split(s, delim)
end.

func str_join(parts:Vec<string>, sep:string):
    # Nối các string với separator
    out native_str_join(parts, sep)
end.

# ═══════════════════════════════════════════════════════
# Conversions
# ═══════════════════════════════════════════════════════

func str_to_i64(s:string):
    out parse_int(s)
end.

func str_to_f64(s:string):
    out parse_float(s)
end.

func i64_to_str(n: i64):
    out native_i64_to_str(n)
end.

func f64_to_str(f:float):
    out native_f64_to_str(f)
end.

func str_free(s:string):
    free(s.data)
end.

# ═══════════════════════════════════════════════════════
# UTF-8 helpers (internal)
# ═══════════════════════════════════════════════════════

func is_ascii_whitespace(b: i64):
    out b == 0x20 or b == 0x09 or b == 0x0A or b == 0x0D
end.

func utf8_count_chars(data:ptr, byte_len: i64):
    # Đếm số codepoints in UTF-8 data
    count = 0;
    i = 0;
    when i < byte_len loop
        b = native_load_u8(data, i);
        if (b & 0x80) == 0 do
            i = i + 1           # 1-byte (ASCII);
        eif (b & 0xE0) == 0xC0 do
            i = i + 2           # 2-byte;
        eif (b & 0xF0) == 0xE0 do
            i = i + 3           # 3-byte;
        eif (b & 0xF8) == 0xF0 do
            i = i + 4           # 4-byte;
        else
            i = i + 1           # invalid, skip byte
        end.
        count = count + 1
    end.
    out count
end.

func utf8_char_at(data:ptr, byte_len: i64, char_index: i64):
    # Lấy codepoint tại vị trí char_index (O(n) scan)
    count = 0;
    i = 0;
    when i < byte_len loop
        b = native_load_u8(data, i);
        if count == char_index do
            out utf8_decode_char(data, i, byte_len)
        end.
        if (b & 0x80) == 0 do i = i + 1;
        eif (b & 0xE0) == 0xC0 do i = i + 2;
        eif (b & 0xF0) == 0xE0 do i = i + 3;
        eif (b & 0xF8) == 0xF0 do i = i + 4;
        else do i = i + 1
        end.
        count = count + 1
    end.
    panic("utf8_char_at: index out of bounds")
end.

func utf8_offset_of(data:ptr, byte_len: i64, char_index: i64):
    count = 0;
    i = 0;
    when i < byte_len and count < char_index loop
        b = native_load_u8(data, i);
        if (b & 0x80) == 0 do i = i + 1;
        eif (b & 0xE0) == 0xC0 do i = i + 2;
        eif (b & 0xF0) == 0xE0 do i = i + 3;
        eif (b & 0xF8) == 0xF0 do i = i + 4;
        else do i = i + 1
        end.
        count = count + 1
    end.
    out i
end.
