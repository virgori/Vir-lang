##
 * Soft-bootstrap prelude for string_rt (fat string helpers).
 * Soft lower cannot yet emit calls to `extern` symbols, so these are
 * identity / thin wrappers over values the soft ABI already uses as
 * fat-string handles (LiteralStr, etc.).
 ##

func fat_str_new(s: string):
    let data = s as i64
    let len = rt_strlen(data)
    let result = alloc(24)
    native_write_i64(result, 0, data)
    native_write_i64(result, 8, len)
    native_write_i64(result, 16, len)
    out result as string
end.

func fat_str_len(s: string):
    if (s as i64) == 0 do out 0 end
    out native_read_i64(s as i64, 8)
end.

func fat_str_byte_at(s: string, index: int):
    if (s as i64) == 0 do out 0 end
    data = native_read_i64(s as i64, 0)
    out native_read_u8(data, index)
end.

func fat_str_concat(a: string, b: string):
    var da = 0
    var la = 0
    if (a as i64) != 0 do
        da = native_read_i64(a as i64, 0)
        la = native_read_i64(a as i64, 8)
    end
    var db = 0
    var lb = 0
    if (b as i64) != 0 do
        db = native_read_i64(b as i64, 0)
        lb = native_read_i64(b as i64, 8)
    end
    let total = la + lb
    let p = alloc(total + 1)
    var i = 0
    when i < la loop
        native_write_u8(p, i, native_read_u8(da, i))
        i = i + 1
    end
    var j = 0
    when j < lb loop
        native_write_u8(p, la + j, native_read_u8(db, j))
        j = j + 1
    end
    native_write_u8(p, total, 0)
    let s = alloc(24)
    native_write_i64(s, 0, p)
    native_write_i64(s, 8, total)
    native_write_i64(s, 16, total)
    out s as string
end.

func fat_str_eq(a: string, b: string):
    if (a as i64) == (b as i64) do
        out 1
    end
    if (a as i64) == 0 or (b as i64) == 0 do
        out 0
    end
    la = native_read_i64(a as i64, 8)
    lb = native_read_i64(b as i64, 8)
    if la != lb do
        out 0
    end
    da = native_read_i64(a as i64, 0)
    db = native_read_i64(b as i64, 0)
    if da == db do
        out 1
    end
    if da == 0 or db == 0 do
        out 0
    end
    var i = 0
    when i < la loop
        ca = native_read_u8(da, i)
        cb = native_read_u8(db, i)
        if ca != cb do
            out 0
        end
        i = i + 1
    end
    out 1
end.

func fat_str_eq_span(source: int, start: int, span_len: int, word: int):
    if source == 0 or word == 0 do out 0 end
    if span_len < 0 do out 0 end
    let source_len = fat_str_len(source as string)
    if start < 0 or (start + span_len) > source_len do out 0 end
    let word_len = fat_str_len(word as string)
    if span_len != word_len do out 0 end
    if span_len == 0 do out 1 end
    let source_data = native_read_i64(source, 0)
    let word_data = native_read_i64(word, 0)
    var i = 0
    when i < span_len loop
        if native_read_u8(source_data, start + i) != native_read_u8(word_data, i) do
            out 0
        end
        i = i + 1
    end
    out 1
end.

func fat_str_sentinel_pad(source: int):
    if source == 0 do out fat_str_new("") end
    let source_len = fat_str_len(source as string)
    let source_data = native_read_i64(source, 0)
    let data = alloc(source_len + 2)
    var i = 0
    when i < source_len loop
        native_write_u8(data, i, native_read_u8(source_data, i))
        i = i + 1
    end
    native_write_u8(data, source_len, 0)
    let result = alloc(24)
    native_write_i64(result, 0, data)
    native_write_i64(result, 8, source_len)
    native_write_i64(result, 16, source_len + 1)
    out result
end.

func fat_str_slice(source: int, start: int, span_len: int):
    if source == 0 or span_len <= 0 do out fat_str_new("") end
    let source_len = fat_str_len(source as string)
    if start < 0 or (start + span_len) > source_len do out fat_str_new("") end
    let source_data = native_read_i64(source, 0)
    let data = alloc(span_len + 1)
    var i = 0
    when i < span_len loop
        native_write_u8(data, i, native_read_u8(source_data, start + i))
        i = i + 1
    end
    native_write_u8(data, span_len, 0)
    let result = alloc(24)
    native_write_i64(result, 0, data)
    native_write_i64(result, 8, span_len)
    native_write_i64(result, 16, span_len)
    out result
end.

func fat_cstr_eq(fat: string, cstr: string):
    out fat_str_eq(fat, cstr)
end.

func fat_char_to_str(ch: int):
    let data = alloc(2)
    native_write_u8(data, 0, ch)
    native_write_u8(data, 1, 0)
    let result = alloc(24)
    native_write_i64(result, 0, data)
    native_write_i64(result, 8, 1)
    native_write_i64(result, 16, 1)
    out result as string
end.

func rt_streq(a: string, b: string):
    out fat_str_eq(a, b)
end.

func str_from_cstr(p: int):
    var len = 0
    if p != 0 do
        len = rt_strlen(p)
    end
    let result = alloc(24)
    native_write_i64(result, 0, p)
    native_write_i64(result, 8, len)
    native_write_i64(result, 16, len)
    out result as string
end.

func rt_strlen(s: int):
    if s == 0 do out 0 end
    var i = 0
    when native_read_u8(s, i) != 0 loop
        i = i + 1
    end
    out i
end.

func rt_strcmp(a: int, b: int):
    var i = 0
    when true loop
        let ca = native_read_u8(a, i)
        let cb = native_read_u8(b, i)
        if ca != cb do out ca - cb end
        if ca == 0 do out 0 end
        i = i + 1
    end
    out 0
end.

func rt_strcat(a: int, b: int):
    let a_len = rt_strlen(a)
    let b_len = rt_strlen(b)
    let result = alloc(a_len + b_len + 1)
    var i = 0
    when i < a_len loop
        native_write_u8(result, i, native_read_u8(a, i))
        i = i + 1
    end
    var j = 0
    when j < b_len loop
        native_write_u8(result, a_len + j, native_read_u8(b, j))
        j = j + 1
    end
    native_write_u8(result, a_len + b_len, 0)
    out result
end.

func rt_strdup(s: int):
    let len = rt_strlen(s)
    let result = alloc(len + 1)
    var i = 0
    when i <= len loop
        native_write_u8(result, i, native_read_u8(s, i))
        i = i + 1
    end
    out result
end.

func rt_atoi(s: int):
    var i = 0
    var sign = 1
    var result = 0
    when native_read_u8(s, i) == 32 || native_read_u8(s, i) == 9 loop
        i = i + 1
    end
    if native_read_u8(s, i) == 45 do
        sign = 0 - 1
        i = i + 1
    eif native_read_u8(s, i) == 43 do
        i = i + 1
    end
    var ch = native_read_u8(s, i)
    when (ch >= 48) & (ch <= 57) loop
        result = result * 10 + (ch - 48)
        i = i + 1
        ch = native_read_u8(s, i)
    end
    out result * sign
end.

func rt_itoa(n: int):
    let buf = alloc(24)
    var pos = 0
    var val = n
    if val < 0 do
        native_write_u8(buf, 0, 45)
        pos = 1
        val = 0 - val
    end
    if val == 0 do
        native_write_u8(buf, pos, 48)
        pos = pos + 1
        native_write_u8(buf, pos, 0)
        out buf
    end
    let tmp = alloc(24)
    var tlen = 0
    when val > 0 loop
        let digit = val mod 10
        native_write_u8(tmp, tlen, 48 + digit)
        tlen = tlen + 1
        val = val / 10
    end
    var i = tlen - 1
    when i >= 0 loop
        native_write_u8(buf, pos, native_read_u8(tmp, i))
        pos = pos + 1
        i = i - 1
    end
    native_write_u8(buf, pos, 0)
    out buf
end.

entity StringBuilder:
    buf: int,
    len: int,
    cap: int
end.

func sb_new:
    let capacity = 256
    out StringBuilder ( buf: alloc(capacity), len: 0, cap: capacity )
end.

func sb_grow(sb: StringBuilder, needed: int):
    if sb.len + needed <= sb.cap do out sb end
    var new_capacity = sb.cap * 2
    when new_capacity < sb.len + needed loop
        new_capacity = new_capacity * 2
    end
    let new_buf = alloc(new_capacity)
    var i = 0
    when i < sb.len loop
        native_write_u8(new_buf, i, native_read_u8(sb.buf, i))
        i = i + 1
    end
    sb.buf = new_buf
    sb.cap = new_capacity
    out sb
end.

func sb_append(sb: StringBuilder, s: int):
    let value_len = rt_strlen(s)
    sb = sb_grow(sb, value_len)
    var i = 0
    when i < value_len loop
        native_write_u8(sb.buf, sb.len + i, native_read_u8(s, i))
        i = i + 1
    end
    sb.len = sb.len + value_len
    out sb
end.

func sb_append_char(sb: StringBuilder, ch: int):
    sb = sb_grow(sb, 1)
    native_write_u8(sb.buf, sb.len, ch)
    sb.len = sb.len + 1
    out sb
end.

func sb_append_int(sb: StringBuilder, n: int):
    out sb_append(sb, rt_itoa(n))
end.

func sb_to_string(sb: StringBuilder):
    native_write_u8(sb.buf, sb.len, 0)
    out sb.buf
end.

func sb_len(sb: StringBuilder):
    out sb.len
end.

func sb_free(sb: StringBuilder):
    out 0
end.

extern func native_read_i64(addr: int, offset: int) -> int
extern func native_write_i64(addr: int, offset: int, val: int) -> int
extern func native_read_u8(addr: int, offset: int) -> int
extern func native_write_u8(addr: int, offset: int, val: int) -> int
