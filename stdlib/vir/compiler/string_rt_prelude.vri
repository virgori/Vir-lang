##
 * Soft-bootstrap prelude for string_rt (fat string helpers).
 * Soft lower cannot yet emit calls to `extern` symbols, so these are
 * identity / thin wrappers over values the soft ABI already uses as
 * fat-string handles (LiteralStr, etc.).
 ##

func fat_str_new(s: string):
    out s
end.

func fat_str_len(s: string):
    if (s as i64) == 0 do out 0 end
    out native_read_i64(s as i64, 8)
end.

func fat_str_byte_at(s: string, index: int):
    if (s as i64) == 0 do out 0 end
    data = native_read_i64(s as i64, 0)
    out native_read_u8(data, index)
end.

func fat_str_concat(a: string, b: string):
    var da = 0
    var la = 0
    if (a as i64) != 0 do
        da = native_read_i64(a as i64, 0)
        la = native_read_i64(a as i64, 8)
    end
    var db = 0
    var lb = 0
    if (b as i64) != 0 do
        db = native_read_i64(b as i64, 0)
        lb = native_read_i64(b as i64, 8)
    end
    let total = la + lb
    let p = alloc(total + 1)
    var i = 0
    when i < la loop
        native_write_u8(p, i, native_read_u8(da, i))
        i = i + 1
    end
    var j = 0
    when j < lb loop
        native_write_u8(p, la + j, native_read_u8(db, j))
        j = j + 1
    end
    native_write_u8(p, total, 0)
    let s = alloc(24)
    native_write_i64(s, 0, p)
    native_write_i64(s, 8, total)
    native_write_i64(s, 16, total)
    out s as string
end.

func fat_str_eq(a: string, b: string):
    if (a as i64) == (b as i64) do
        out 1
    end
    if (a as i64) == 0 or (b as i64) == 0 do
        out 0
    end
    la = native_read_i64(a as i64, 8)
    lb = native_read_i64(b as i64, 8)
    if la != lb do
        out 0
    end
    da = native_read_i64(a as i64, 0)
    db = native_read_i64(b as i64, 0)
    if da == db do
        out 1
    end
    if da == 0 or db == 0 do
        out 0
    end
    var i = 0
    when i < la loop
        ca = native_read_u8(da, i)
        cb = native_read_u8(db, i)
        if ca != cb do
            out 0
        end
        i = i + 1
    end
    out 1
end.

func fat_cstr_eq(fat: string, cstr: string):
    out fat_str_eq(fat, cstr)
end.

func fat_char_to_str(ch: int):
    out ""
end.

func rt_streq(a: string, b: string):
    out fat_str_eq(a, b)
end.

func str_from_cstr(p: int):
    out ""
end.

func rt_strlen(s: string):
    out fat_str_len(s)
end.

extern func native_read_i64(addr: int, offset: int) -> int
extern func native_write_i64(addr: int, offset: int, val: int) -> int
extern func native_read_u8(addr: int, offset: int) -> int
extern func native_write_u8(addr: int, offset: int, val: int) -> int
