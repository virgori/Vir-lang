##
 * vir/compiler/lir_regalloc_color.vri — Chaitin-Briggs Graph Coloring Register Allocator
 * ======================================================================================
 * Maps Virtual Registers to Physical Registers using the
 * Chaitin-Briggs Graph Coloring Algorithm (K=8).
 * Spilled registers are allocated 8-byte stack memory slots.
 *
 * Colors map to callee-saved X19..X26 so values that live across
 * Call/print are not clobbered. ABI still uses X0..X7 via PARAM/SetArg
 * / Call-result moves at the call boundary.
 *
 * Architecture (compiler spec): LIR is cleaned *before* this pass; George–Appel
 * iterated coalescing is intended *after* coloring for remaining copies only —
 * see MUST_READ_CONTEXT/REGISTER_ALLOCATION_ARCHITECTURE.md.
 ##

include types
include vec_rt
import vec_new_rt, vec_push_rt, vec_get_rt, vec_set_rt, vec_len_rt from vec_rt
include string_rt
import native_read_i64 from string_rt
include compiler.context
import print_str, print_int from compiler.context
include vir.compiler.lir
import LirPhysReg, LirFunc, LirOperand, LirOperandType, LirInstr, LirBlock, lir_instr_new, lir_block_new, lir_func_new, lir_opnd_phys_reg, lir_opnd_stack_mem, lir_func_id, lir_func_name, lir_func_blocks, lir_func_stack_size, lir_func_strings, lir_block_id, lir_block_instrs from vir.compiler.lir
include vir.compiler.lir_interference
import InterferenceGraph, build_interference_graph, get_edge, ig_num_nodes, ig_degrees from vir.compiler.lir_interference
include vir.compiler.lir_liveness
import LiveInterval, lir_compute_liveness, lir_opnd_is_vreg, lir_opnd_vreg_id, lir_instr_dst, lir_instr_src1, lir_instr_src2 from vir.compiler.lir_liveness

# Color index 0..K-1 → ARM64 callee-saved X19..X28.
func color_to_phys(color: i64):
    out 19 + color
end.

func lir_rewrite_opnd(opnd: LirOperand, assigned_phys: i64, assigned_stack: i64, n_nodes: i64):
    if lir_opnd_is_vreg(opnd) do
        v = lir_opnd_vreg_id(opnd)
        if v >= 0 and v < n_nodes do
            p_reg = vec_get_rt(assigned_phys, v)
            if p_reg >= 0 do
                out lir_opnd_phys_reg(color_to_phys(p_reg) as LirPhysReg)
            end
            s_off = vec_get_rt(assigned_stack, v)
            if s_off != 0 do
                out lir_opnd_stack_mem(s_off)
            end
        end
    end
    out opnd
end.

func lir_rewrite_instr(ins: LirInstr, assigned_phys: i64, assigned_stack: i64, n_nodes: i64):
    ins_i = ins as i64
    r_op = native_read_i64(ins_i, 0)
    r_typ = native_read_i64(ins_i, 8)
    r_dst = lir_rewrite_opnd(native_read_i64(ins_i, 16) as LirOperand, assigned_phys, assigned_stack, n_nodes)
    r_src1 = lir_rewrite_opnd(native_read_i64(ins_i, 24) as LirOperand, assigned_phys, assigned_stack, n_nodes)
    r_src2 = lir_rewrite_opnd(native_read_i64(ins_i, 32) as LirOperand, assigned_phys, assigned_stack, n_nodes)
    r_aux = native_read_i64(ins_i, 40)
    res = lir_instr_new(r_op, r_typ, r_dst as i64, r_src1 as i64, r_src2 as i64, r_aux)
    out res
end.

func lir_allocate_registers_color(func_obj: LirFunc, intervals: i64):
    ig = build_interference_graph(intervals)
    n_nodes = ig_num_nodes(ig)
    # X19..X27 callee-saved (9). X28 is reserved for global heap arena.
    K = 9

    removed = vec_new_rt()
    assigned_phys = vec_new_rt()
    assigned_stack = vec_new_rt()
    stack = vec_new_rt()

    i = 0
    when i < n_nodes loop
        removed = vec_push_rt(removed, 0)
        assigned_phys = vec_push_rt(assigned_phys, -1)
        assigned_stack = vec_push_rt(assigned_stack, 0)
        i = i + 1
    end

    degrees_vec = ig_degrees(ig)
    curr_degrees = vec_new_rt()
    i = 0
    when i < n_nodes loop
        curr_degrees = vec_push_rt(curr_degrees, vec_get_rt(degrees_vec, i))
        i = i + 1
    end
    nodes_left = n_nodes

    # Simplify & spill heuristic
    when nodes_left > 0 loop
        found = -1
        i = 0
        when i < n_nodes loop
            if vec_get_rt(removed, i) == 0 do
                deg = vec_get_rt(curr_degrees, i)
                if deg < K do
                    found = i
                    i = n_nodes
                end
            end
            i = i + 1
        end
        if found == -1 do
            max_deg = -1
            i = 0
            when i < n_nodes loop
                if vec_get_rt(removed, i) == 0 do
                    deg = vec_get_rt(curr_degrees, i)
                    if deg > max_deg do
                        max_deg = deg
                        found = i
                    end
                end
                i = i + 1
            end
        end
        if found >= 0 do
            stack = vec_push_rt(stack, found)
            vec_set_rt(removed, found, 1)
            nodes_left = nodes_left - 1
            j = 0
            when j < n_nodes loop
                if vec_get_rt(removed, j) == 0 do
                    if get_edge(ig, found, j) == 1 do
                        d = vec_get_rt(curr_degrees, j)
                        vec_set_rt(curr_degrees, j, d - 1)
                    end
                end
                j = j + 1
            end
        end
    end

    # Select (color non-precolored nodes)
    stack_size = lir_func_stack_size(func_obj)
    top = vec_len_rt(stack) - 1
    when top >= 0 loop
        u = vec_get_rt(stack, top)
        top = top - 1

        used_colors = vec_new_rt()
        c = 0
        when c < K loop
            used_colors = vec_push_rt(used_colors, 0)
            c = c + 1
        end
        j = 0
        when j < n_nodes loop
            if get_edge(ig, u, j) == 1 do
                neighbor_color = vec_get_rt(assigned_phys, j)
                if neighbor_color >= 0 and neighbor_color < K do
                    vec_set_rt(used_colors, neighbor_color, 1)
                end
            end
            j = j + 1
        end
        color = -1
        c = 0
        when c < K loop
            if vec_get_rt(used_colors, c) == 0 do
                color = c
                c = K
            end
            c = c + 1
        end
        if color != -1 do
            vec_set_rt(assigned_phys, u, color)
        else
            # No spill-store/reload pass yet — force a color rather than
            # StackMem that SetArg cannot materialize (was Imm#0 SEGV).
            vec_set_rt(assigned_phys, u, u mod K)
        end
    end

    # Rewrite operands via whole-instr rebuild (typed; no nested field assign).
    blocks = native_read_i64(func_obj as i64, 16)
    n_blocks = vec_len_rt(blocks)
    var bi = 0
    when bi < n_blocks loop
        lb = vec_get_rt(blocks, bi)
        instrs = native_read_i64(lb as i64, 8)
        n_instrs = vec_len_rt(instrs)
        var ii = 0
        when ii < n_instrs loop
            ins = vec_get_rt(instrs, ii)
            rewritten = lir_rewrite_instr(ins, assigned_phys, assigned_stack, n_nodes)
            vec_set_rt(instrs, ii, rewritten)
            ii = ii + 1
        end
        # Persist block with updated instrs pointer (may have been realloc'd).
        vec_set_rt(blocks, bi, lir_block_new(
            native_read_i64(lb as i64, 0),
            instrs
        ))
        bi = bi + 1
    end

    out (lir_func_new(
        native_read_i64(func_obj as i64, 0),
        native_read_i64(func_obj as i64, 8) as string,
        blocks,
        stack_size,
        native_read_i64(func_obj as i64, 32)
    ), assigned_phys, assigned_stack)
end.

export lir_allocate_registers_color
