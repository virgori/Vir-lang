##
 * vir/compiler/lir_regalloc_color.vri — Chaitin-Briggs Graph Coloring Register Allocator
 * ======================================================================================
 * Maps Virtual Registers to Physical Registers using the 
 * Chaitin-Briggs Graph Coloring Algorithm (K=8).
 * Spilled registers are allocated 8-byte stack memory slots.
 ##

include types;
include vec_rt;
import vec_new_rt, vec_push_rt, vec_get_rt, vec_set_rt, vec_len_rt from vec_rt;
include lir;
import LirPhysReg, LirFunc, LirOperand, LirOperandType, lir_opnd_phys_reg, lir_opnd_stack_mem from lir;
include lir_interference;
import InterferenceGraph, build_interference_graph, get_edge from lir_interference;

func lir_allocate_registers_color(func_obj: LirFunc, intervals: i64)
    ig = build_interference_graph(intervals);
    n_nodes = ig.num_nodes;
    K = 8; # R0 to R7 physical registers

    # 1. State initialization
    removed = vec_new_rt();
    assigned_phys = vec_new_rt();
    assigned_stack = vec_new_rt();
    stack = vec_new_rt();

    i = 0;
    when i < n_nodes loop
        removed = vec_push_rt(removed, 0);
        assigned_phys = vec_push_rt(assigned_phys, -1);
        assigned_stack = vec_push_rt(assigned_stack, 0);
        i = i + 1
    end

    curr_degrees = vec_new_rt();
    i = 0;
    when i < n_nodes loop
        curr_degrees = vec_push_rt(curr_degrees, vec_get_rt(ig.degrees, i));
        i = i + 1
    end
    nodes_left = n_nodes;

    # 2. Simplify & Spill Heuristic
    when nodes_left > 0 loop
        found = -1;
        i = 0;
        when i < n_nodes loop
            if vec_get_rt(removed, i) == 0 do
                deg = vec_get_rt(curr_degrees, i);
                if deg < K do
                    found = i;
                    i = n_nodes
                end
            end
            i = i + 1
        end
        if found == -1 do
            max_deg = -1;
            i = 0;
            when i < n_nodes loop
                if vec_get_rt(removed, i) == 0 do
                    deg = vec_get_rt(curr_degrees, i);
                    if deg > max_deg do
                        max_deg = deg;
                        found = i
                    end
                end
                i = i + 1
            end
        end
        if found >= 0 do
            stack = vec_push_rt(stack, found);
            vec_set_rt(removed, found, 1);
            nodes_left = nodes_left - 1;

            j = 0;
            when j < n_nodes loop
                if vec_get_rt(removed, j) == 0 do
                    edge = get_edge(ig, found, j);
                    if edge == 1 do
                        d = vec_get_rt(curr_degrees, j);
                        vec_set_rt(curr_degrees, j, d - 1)
                    end
                end
                j = j + 1
            end
        end
    end

    # 3. Select (Graph Coloring)
    stack_size = func_obj.stack_size;
    top = vec_len_rt(stack) - 1;

    when top >= 0 loop
        u = vec_get_rt(stack, top);
        top = top - 1;

        used_colors = vec_new_rt();
        c = 0;
        when c < K loop
            used_colors = vec_push_rt(used_colors, 0);
            c = c + 1
        end
        j = 0;
        when j < n_nodes loop
            edge = get_edge(ig, u, j);
            if edge == 1 do
                neighbor_color = vec_get_rt(assigned_phys, j);
                if neighbor_color >= 0 do
                    vec_set_rt(used_colors, neighbor_color, 1)
                end
            end
            j = j + 1
        end
        color = -1;
        c = 0;
        when c < K loop
            if vec_get_rt(used_colors, c) == 0 do
                color = c;
                c = K
            end
            c = c + 1
        end
        if color != -1 do
            vec_set_rt(assigned_phys, u, color)
        else
            stack_size = stack_size + 8;
            vec_set_rt(assigned_stack, u, 0 - stack_size)
        end
    end
    func_obj.stack_size = stack_size;

    # 4. Rewrite VRegs in LirFunc with assigned PhysReg / StackMem
    n_blocks = vec_len_rt(func_obj.blocks);
    var bi = 0;
    when bi < n_blocks loop
        lb = vec_get_rt(func_obj.blocks, bi);
        n_instrs = vec_len_rt(lb.instrs);
        var ii = 0;
        when ii < n_instrs loop
            ins = vec_get_rt(lb.instrs, ii);
            if ins.dst.op_type == LirOperandType.VRegInt and ins.dst.vreg < n_nodes do
                p_reg = vec_get_rt(assigned_phys, ins.dst.vreg);
                if p_reg >= 0 do
                    ins.dst = lir_opnd_phys_reg(p_reg as LirPhysReg)
                else
                    s_off = vec_get_rt(assigned_stack, ins.dst.vreg);
                    if s_off != 0 do
                        ins.dst = lir_opnd_stack_mem(s_off)
                    end
                end
            end
            if ins.src1.op_type == LirOperandType.VRegInt and ins.src1.vreg < n_nodes do
                p_reg = vec_get_rt(assigned_phys, ins.src1.vreg);
                if p_reg >= 0 do
                    ins.src1 = lir_opnd_phys_reg(p_reg as LirPhysReg)
                else
                    s_off = vec_get_rt(assigned_stack, ins.src1.vreg);
                    if s_off != 0 do
                        ins.src1 = lir_opnd_stack_mem(s_off)
                    end
                end
            end
            if ins.src2.op_type == LirOperandType.VRegInt and ins.src2.vreg < n_nodes do
                p_reg = vec_get_rt(assigned_phys, ins.src2.vreg);
                if p_reg >= 0 do
                    ins.src2 = lir_opnd_phys_reg(p_reg as LirPhysReg)
                else
                    s_off = vec_get_rt(assigned_stack, ins.src2.vreg);
                    if s_off != 0 do
                        ins.src2 = lir_opnd_stack_mem(s_off)
                    end
                end
            end
            vec_set_rt(lb.instrs, ii, ins);
            ii = ii + 1
        end
        vec_set_rt(func_obj.blocks, bi, lb);
        bi = bi + 1
    end

    out (func_obj, assigned_phys, assigned_stack)
end.

export lir_allocate_registers_color
