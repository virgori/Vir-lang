##
 * vir/compiler/lir_regalloc_color.vri — Chaitin-Briggs Graph Coloring Register Allocator
 * ======================================================================================
 * Maps Virtual Registers to Physical Registers using the
 * Chaitin-Briggs Graph Coloring Algorithm (K=8).
 * Spilled registers are allocated 8-byte stack memory slots.
 *
 * Colors map to callee-saved X19..X26 so values that live across
 * Call/print are not clobbered. ABI still uses X0..X7 via PARAM/SetArg
 * / Call-result moves at the call boundary.
 *
 * Architecture (compiler spec): LIR is cleaned *before* this pass; George–Appel
 * iterated coalescing is intended *after* coloring for remaining copies only —
 * see MUST_READ_CONTEXT/REGISTER_ALLOCATION_ARCHITECTURE.md.
 ##

include types
include vec_rt
import vec_new_rt, vec_push_rt, vec_get_rt, vec_set_rt, vec_len_rt from vec_rt
include string_rt
import native_read_i64 from string_rt
include compiler.context
import print_str, print_int from compiler.context
include vir.compiler.lir
import LirPhysReg, LirFunc, LirOperand, LirOperandType, LirInstr, LirBlock, lir_instr_new, lir_block_new, lir_func_new, lir_opnd_phys_reg, lir_opnd_stack_mem, lir_func_id, lir_func_name, lir_func_blocks, lir_func_stack_size, lir_func_strings, lir_block_id, lir_block_instrs from vir.compiler.lir
include vir.compiler.lir_interference
import InterferenceGraph, build_interference_graph, get_edge, ig_num_nodes, ig_degrees, intervals_overlap from vir.compiler.lir_interference
include vir.compiler.lir_liveness
import LiveInterval, lir_compute_liveness, lir_opnd_is_vreg, lir_opnd_vreg_id, lir_instr_dst, lir_instr_src1, lir_instr_src2 from vir.compiler.lir_liveness

include vir.compiler.target
import get_codegen_target from vir.compiler.target

func func_has_calls(func_obj: LirFunc):
    f_blocks = native_read_i64(func_obj as i64, 16)
    n_fb = vec_len_rt(f_blocks)
    var bi = 0
    when bi < n_fb loop
        fb = vec_get_rt(f_blocks, bi)
        fb_instrs = native_read_i64(fb as i64, 8)
        n_ins = vec_len_rt(fb_instrs)
        var ii = 0
        when ii < n_ins loop
            ins = vec_get_rt(fb_instrs, ii)
            if native_read_i64(ins as i64, 0) == 2 do # LirOp.Call
                out 1
            end
            ii = ii + 1
        end
        bi = bi + 1
    end
    out 0
end.

# Color index → physical register (arch-aware).
# ARM64 Leaf: X9..X15 (no callee saves needed).
# ARM64 Non-leaf: X19..X27 (callee-saved).
# x86_64: RBX, R12..R14 (R15 reserved for heap arena).
func color_to_phys(color: i64, is_leaf: i64):
    if get_codegen_target() == 1 do
        if color == 0 do out 3 end    # RBX
        if color == 1 do out 12 end   # R12
        if color == 2 do out 13 end   # R13
        if color == 3 do out 14 end   # R14
        out 3
    end
    out 19 + color
end.

func lir_rewrite_opnd(opnd: LirOperand, assigned_phys: i64, assigned_stack: i64, n_nodes: i64, is_leaf: i64):
    if (opnd as i64) == 0 do
        out opnd
    end
    if lir_opnd_is_vreg(opnd) do
        v = lir_opnd_vreg_id(opnd)
        if v >= 0 and v < n_nodes do
            p_reg = vec_get_rt(assigned_phys, v)
            if p_reg >= 0 do
                out lir_opnd_phys_reg(color_to_phys(p_reg, is_leaf) as LirPhysReg)
            end
            s_off = vec_get_rt(assigned_stack, v)
            if s_off != 0 do
                out lir_opnd_stack_mem(s_off)
            end
        end
    end
    out opnd
end.

func lir_rewrite_instr(ins: LirInstr, assigned_phys: i64, assigned_stack: i64, n_nodes: i64, is_leaf: i64):
    ins_i = ins as i64
    r_op = native_read_i64(ins_i, 0)
    r_typ = native_read_i64(ins_i, 8)
    r_dst = lir_rewrite_opnd(native_read_i64(ins_i, 16) as LirOperand, assigned_phys, assigned_stack, n_nodes, is_leaf)
    r_src1 = lir_rewrite_opnd(native_read_i64(ins_i, 24) as LirOperand, assigned_phys, assigned_stack, n_nodes, is_leaf)
    r_src2 = lir_rewrite_opnd(native_read_i64(ins_i, 32) as LirOperand, assigned_phys, assigned_stack, n_nodes, is_leaf)
    r_aux = native_read_i64(ins_i, 40)
    if r_op == 1 do # LirOp.Mov
        if (r_dst as i64) != 0 and (r_src1 as i64) != 0 do
            dt = native_read_i64(r_dst as i64, 0)
            st = native_read_i64(r_src1 as i64, 0)
            if dt == 2 and st == 2 do
                if native_read_i64(r_dst as i64, 16) == native_read_i64(r_src1 as i64, 16) do
                    out lir_instr_new(0, 0, lir_opnd_none() as i64, lir_opnd_none() as i64, lir_opnd_none() as i64, 0)
                end
            eif dt == 3 and st == 3 do
                if native_read_i64(r_dst as i64, 24) == native_read_i64(r_src1 as i64, 24) do
                    out lir_instr_new(0, 0, lir_opnd_none() as i64, lir_opnd_none() as i64, lir_opnd_none() as i64, 0)
                end
            end
        end
    end
    res = lir_instr_new(r_op, r_typ, r_dst as i64, r_src1 as i64, r_src2 as i64, r_aux)
    out res
end.

func lir_allocate_registers_color(func_obj: LirFunc, intervals: i64):
    ig = build_interference_graph(intervals)
    n_nodes = ig_num_nodes(ig)
    # ARM64: X19..X27 (9). x86_64: RBX,R12-R14 (4). Heap reg reserved separately.
    K = 9
    if get_codegen_target() == 1 do
        K = 4
    end

    removed = vec_new_rt()
    assigned_phys = vec_new_rt()
    assigned_stack = vec_new_rt()
    stack = vec_new_rt()

    i = 0
    when i < n_nodes loop
        removed = vec_push_rt(removed, 0)
        assigned_phys = vec_push_rt(assigned_phys, -1)
        assigned_stack = vec_push_rt(assigned_stack, 0)
        i = i + 1
    end

    degrees_vec = ig_degrees(ig)
    curr_degrees = vec_new_rt()
    move_partner = vec_new_rt()
    i = 0
    when i < n_nodes loop
        curr_degrees = vec_push_rt(curr_degrees, vec_get_rt(degrees_vec, i))
        move_partner = vec_push_rt(move_partner, 0 - 1)
        i = i + 1
    end

    # Extract move affinities for biased coloring
    f_blocks = native_read_i64(func_obj as i64, 16)
    n_fb = vec_len_rt(f_blocks)
    var fbi = 0
    when fbi < n_fb loop
        fb = vec_get_rt(f_blocks, fbi)
        fb_instrs = native_read_i64(fb as i64, 8)
        n_fbi = vec_len_rt(fb_instrs)
        var ii_b = 0
        when ii_b < n_fbi loop
            ins_m = vec_get_rt(fb_instrs, ii_b)
            if native_read_i64(ins_m as i64, 0) == 1 do # LirOp.Mov
                d_opnd = native_read_i64(ins_m as i64, 16)
                s_opnd = native_read_i64(ins_m as i64, 24)
                if d_opnd != 0 and s_opnd != 0 do
                    if native_read_i64(d_opnd, 0) == 1 and native_read_i64(s_opnd, 0) == 1 do
                        u_v = native_read_i64(d_opnd, 8)
                        v_v = native_read_i64(s_opnd, 8)
                        if u_v >= 0 and u_v < n_nodes and v_v >= 0 and v_v < n_nodes do
                            vec_set_rt(move_partner, u_v, v_v)
                            vec_set_rt(move_partner, v_v, u_v)
                        end
                    end
                end
            end
            ii_b = ii_b + 1
        end
        fbi = fbi + 1
    end
    # 1. Compute block loop nesting depths
    block_depths = vec_new_rt()
    var bdi = 0
    when bdi < n_fb loop
        block_depths = vec_push_rt(block_depths, 0)
        bdi = bdi + 1
    end
    bdi = 0
    when bdi < n_fb loop
        fb = vec_get_rt(f_blocks, bdi)
        fb_instrs = native_read_i64(fb as i64, 8)
        n_ins = vec_len_rt(fb_instrs)
        var ini = 0
        when ini < n_ins loop
            ins_lp = vec_get_rt(fb_instrs, ini)
            op_lp = native_read_i64(ins_lp as i64, 0)
            if op_lp == 8 or op_lp == 9 do # LirOp.Jmp or JmpCond
                s_lp = native_read_i64(ins_lp as i64, 24)
                if op_lp == 9 do s_lp = native_read_i64(ins_lp as i64, 32) end
                if s_lp != 0 do
                    typ_lp = native_read_i64(s_lp, 0)
                    tgt_b = 0 - 1
                    if typ_lp == 5 or typ_lp == 6 do
                        tgt_b = native_read_i64(s_lp, 40)
                    eif typ_lp == 4 do
                        tgt_b = native_read_i64(s_lp, 32)
                    end
                    if tgt_b >= 0 and tgt_b <= bdi and tgt_b < n_fb do
                        var k_b = tgt_b
                        when k_b <= bdi loop
                            cur_dep = vec_get_rt(block_depths, k_b)
                            vec_set_rt(block_depths, k_b, cur_dep + 1)
                            k_b = k_b + 1
                        end
                    end
                end
            end
            ini = ini + 1
        end
        bdi = bdi + 1
    end

    # 2. Compute vreg execution weights based on loop depth
    vreg_weight = vec_new_rt()
    var vwi = 0
    when vwi < n_nodes loop
        vreg_weight = vec_push_rt(vreg_weight, 1)
        vwi = vwi + 1
    end
    bdi = 0
    when bdi < n_fb loop
        fb = vec_get_rt(f_blocks, bdi)
        fb_instrs = native_read_i64(fb as i64, 8)
        n_ins = vec_len_rt(fb_instrs)
        dep = vec_get_rt(block_depths, bdi)
        w = 1
        if dep == 1 do w = 10 end
        if dep == 2 do w = 100 end
        if dep >= 3 do w = 1000 end
        var ini = 0
        when ini < n_ins loop
            ins_w = vec_get_rt(fb_instrs, ini)
            op_w = native_read_i64(ins_w as i64, 0)
            d_w = native_read_i64(ins_w as i64, 16)
            s1_w = native_read_i64(ins_w as i64, 24)
            s2_w = native_read_i64(ins_w as i64, 32)

            var d_mult = 1
            var s1_mult = 1
            var s2_mult = 1

            # Role multipliers: Base pointer / accumulator / induction / bounds
            if op_w == 10 do # Cmp
                s1_mult = 8 # Loop bound (read-only)
                s2_mult = 8
            eif op_w == 3 or op_w == 4 do # Add / Sub
                if d_w != 0 and s1_w != 0 and native_read_i64(d_w, 8) == native_read_i64(s1_w, 8) do
                    d_mult = 64 # Dynamic loop accumulator / step (read+write on every iteration)
                    s1_mult = 64
                else
                    d_mult = 32
                    s1_mult = 32
                end
            eif op_w == 18 or op_w == 19 do # Load / Store
                s1_mult = 16 # Base pointer
            end

            if d_w != 0 and native_read_i64(d_w, 0) == 1 do
                vw = native_read_i64(d_w, 8)
                if vw >= 0 and vw < n_nodes do
                    vec_set_rt(vreg_weight, vw, vec_get_rt(vreg_weight, vw) + (w * d_mult))
                end
            end
            if s1_w != 0 and native_read_i64(s1_w, 0) == 1 do
                vw = native_read_i64(s1_w, 8)
                if vw >= 0 and vw < n_nodes do
                    vec_set_rt(vreg_weight, vw, vec_get_rt(vreg_weight, vw) + (w * s1_mult))
                end
            end
            if s2_w != 0 and native_read_i64(s2_w, 0) == 1 do
                vw = native_read_i64(s2_w, 8)
                if vw >= 0 and vw < n_nodes do
                    vec_set_rt(vreg_weight, vw, vec_get_rt(vreg_weight, vw) + (w * s2_mult))
                end
            end
            ini = ini + 1
        end
        bdi = bdi + 1
    end

    nodes_left = n_nodes

    # Simplify & spill heuristic
    when nodes_left > 0 loop
        found = -1
        i = 0
        when i < n_nodes loop
            if vec_get_rt(removed, i) == 0 do
                deg = vec_get_rt(curr_degrees, i)
                if deg < K do
                    found = i
                    i = n_nodes
                end
            end
            i = i + 1
        end
        if found == -1 do
            min_cost = 999999999
            var i = 0
            when i < n_nodes loop
                if vec_get_rt(removed, i) == 0 do
                    deg = vec_get_rt(curr_degrees, i)
                    w = vec_get_rt(vreg_weight, i)
                    # spill_cost = (w * 1000) / (deg + 1)
                    cost = (w * 1000) / (deg + 1)
                    if cost < min_cost do
                        min_cost = cost
                        found = i
                    end
                end
                i = i + 1
            end
        end
        if found >= 0 do
            stack = vec_push_rt(stack, found)
            vec_set_rt(removed, found, 1)
            nodes_left = nodes_left - 1
            j = 0
            when j < n_nodes loop
                if vec_get_rt(removed, j) == 0 do
                    if get_edge(ig, found, j) == 1 do
                        d = vec_get_rt(curr_degrees, j)
                        vec_set_rt(curr_degrees, j, d - 1)
                    end
                end
                j = j + 1
            end
        end
    end

    # Select (color non-precolored nodes with Move-Biased preference)
    stack_size = lir_func_stack_size(func_obj)
    var spill_count = 0
    top = vec_len_rt(stack) - 1
    when top >= 0 loop
        u = vec_get_rt(stack, top)
        top = top - 1

        used_colors = vec_new_rt()
        c = 0
        when c < K loop
            used_colors = vec_push_rt(used_colors, 0)
            c = c + 1
        end
        j = 0
        when j < n_nodes loop
            if get_edge(ig, u, j) == 1 and intervals_overlap(vec_get_rt(intervals, u), vec_get_rt(intervals, j)) do
                neighbor_color = vec_get_rt(assigned_phys, j)
                if neighbor_color >= 0 and neighbor_color < K do
                    vec_set_rt(used_colors, neighbor_color, 1)
                end
            end
            j = j + 1
        end
        color = -1
        # Biased coloring: prefer color of move partner if available
        if u >= 0 and u < n_nodes do
            partner = vec_get_rt(move_partner, u)
            if partner >= 0 and partner < n_nodes do
                partner_color = vec_get_rt(assigned_phys, partner)
                if partner_color >= 0 and partner_color < K do
                    if vec_get_rt(used_colors, partner_color) == 0 do
                        color = partner_color
                    end
                end
            end
        end
        # Fallback to first available color
        if color == -1 do
            c = 0
            when c < K loop
                if vec_get_rt(used_colors, c) == 0 do
                    color = c
                    c = K
                end
                c = c + 1
            end
        end
        if color != -1 do
            vec_set_rt(assigned_phys, u, color)
        else
            # Uncolorable: assign a dedicated stack slot (real spill).
            # Slot offsets are negative from X29, placed below the callee-saved
            # area (which occupies X29-16 .. X29-80). Codegen reloads spilled
            # sources into scratch regs and stores spilled defs after each op.
            off = 0 - (88 + 8 * spill_count)
            vec_set_rt(assigned_stack, u, off)
            spill_count = spill_count + 1
        end
    end

    ##
     * George–Appel Conservative Move Coalescing.
     * After coloring: scan all Mov instructions. If both src and dst
     * operands resolve to the SAME physical register (color), the copy is
     * redundant — replace it with Nop. This is the primary coalescing
     * insight from the George-Appel IRC paper (1996).
     ##
    is_leaf = func_has_calls(func_obj) == 0
    blocks = native_read_i64(func_obj as i64, 16)
    n_blocks = vec_len_rt(blocks)
    var bi = 0
    when bi < n_blocks loop
        lb = vec_get_rt(blocks, bi)
        instrs = native_read_i64(lb as i64, 8)
        n_instrs = vec_len_rt(instrs)
        var ii = 0
        when ii < n_instrs loop
            ins = vec_get_rt(instrs, ii)
            rewritten = lir_rewrite_instr(ins, assigned_phys, assigned_stack, n_nodes, is_leaf as i64)
            vec_set_rt(instrs, ii, rewritten)
            ii = ii + 1
        end
        # Persist block with updated instrs pointer (may have been realloc'd).
        vec_set_rt(blocks, bi, lir_block_new(
            native_read_i64(lb as i64, 0),
            instrs
        ))
        bi = bi + 1
    end

    # Grow the frame to hold spill slots (deepest slot is X29-(80+8*spill_count)).
    spill_bytes = 8 * spill_count
    if (spill_bytes mod 16) != 0 do
        spill_bytes = spill_bytes + (16 - (spill_bytes mod 16))
    end
    new_stack_size = stack_size + spill_bytes

    out (lir_func_new(
        native_read_i64(func_obj as i64, 0),
        native_read_i64(func_obj as i64, 8) as string,
        blocks,
        new_stack_size,
        native_read_i64(func_obj as i64, 32)
    ), assigned_phys, assigned_stack)
end.

export lir_allocate_registers_color
