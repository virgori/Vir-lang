## Soft thin driver — lex → parse → MIR/LIR pipeline (bootstrap probe).
## emit_lir_module_arm64 under C-VM currently SEGV; Mach-O wire-up next.
include rt.io
import read_file_str from rt.io
include rt.string_rt
import str_from_cstr from rt.string_rt
include rt.vec_rt
import vec_new_rt, vec_push_rt, vec_len_rt from rt.vec_rt
include compiler.lexer
import lexer_new, tokenize from compiler.lexer
include vec
import vec_len, vec_get from vec
include compiler.parser
import parser_new, parse_program from compiler.parser
include compiler.pipeline
import compile_pipeline from compiler.pipeline

func main:
 let in_path = get_arg(0)
 let src = str_from_cstr(read_file_str(in_path))
 let lex = tokenize(lexer_new(src))
 let n = vec_len(lex.tokens)
 print(n)
 print(10)
 let tok_rt = vec_new_rt()
 let i = 0
 when i < n loop
 tok_rt = vec_push_rt(tok_rt, vec_get(lex.tokens, i))
 i = i + 1
 end
 var (p2, ast) = parse_program(parser_new(tok_rt))
 let lir = compile_pipeline(in_path, ast, 0)
 print(vec_len_rt(lir))
 print(10)
end.
