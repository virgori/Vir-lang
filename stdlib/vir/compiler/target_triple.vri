##
 * vir/compiler/target_triple.vri — Target Triple Parser & Host Detection
 * ========================================================================
 * Decomposes triples into TargetArch, TargetOS, TargetABI, ObjectFormat,
 * and AsmDialect. Delegates to target_spec.vri.
 ##

module vir.compiler.target_triple

include types
include string_rt
import rt_streq, native_read_i64, native_write_i64 from string_rt
include compiler.mc
import TargetArch, TargetOS, TargetABI, ObjectFormat, AsmDialect, TargetTriple, target_triple_new, triple_arch, triple_os, triple_abi, triple_format, triple_dialect from compiler.mc
include compiler.target_spec
import TargetSpec, parse_target_spec, get_host_target_spec, target_spec_arch, target_spec_os, target_spec_abi, target_spec_format, target_spec_dialect from compiler.target_spec

func get_host_triple():
    let s = get_host_target_spec()
    out target_triple_new(target_spec_arch(s), target_spec_os(s), target_spec_abi(s), target_spec_format(s), target_spec_dialect(s))
end.

func parse_target_triple(str_val: string):
    let s = parse_target_spec(str_val)
    if s == 0 do
        out 0
    end
    out target_triple_new(target_spec_arch(s), target_spec_os(s), target_spec_abi(s), target_spec_format(s), target_spec_dialect(s))
end.
