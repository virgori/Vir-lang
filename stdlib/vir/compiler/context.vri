##
 * vir/compiler/context.vri — Compiler Context & Core Infrastructure
 * ==============================================================
 * Centralized context holding all compiler state: Interner, Arenas, Diagnostics.
 ##

include types
include result
import Result, Ok, Err from result

include string_rt
import rt_streq, rt_strdup from string_rt

include vec_rt
import vec_new_rt, vec_push_rt, vec_get_rt, vec_len_rt, vec_set_rt from vec_rt

# ═══════════════════════════════════════════════════════
# String Interner (InternPool)
# ═══════════════════════════════════════════════════════

entity StringInterner:
    strings: i64 # vec
end.
func interner_new()
    var i = StringInterner(
        strings: vec_new_rt()
    )
    i.strings = vec_push_rt(i.strings, ""); # index 0 is invalid/empty string
    out i
end.
func intern_string(interner: StringInterner, s: string)
    strs = native_read_i64(interner as i64, 0)
    len = vec_len_rt(strs)
    var i = 1
    when i < len loop
        existing = vec_get_rt(strs, i)
        if rt_streq(existing, s as int) == 1 do
            out i
        end
        i = i + 1
    end
    strs = vec_push_rt(strs, rt_strdup(s as int))
    native_write_i64(interner as i64, 0, strs)
    out len
end.
func get_interned_string(interner: StringInterner, id: i64)
    strs = native_read_i64(interner as i64, 0)
    out vec_get_rt(strs, id)
end.
include source_manager
import SourceFile, SourceMapSegment, SourceSpan, SourceManager, g_active_source_manager,
       sm_new, sm_register_file, sm_get_file_path, sm_add_segment, sm_find_segment,
       sm_file_from_line, sm_line_from_expanded, sm_add_span, sm_get_span, sm_build_from_source from source_manager

# ═══════════════════════════════════════════════════════
# Diagnostic Engine
# ═══════════════════════════════════════════════════════

enum DiagnosticLevel:
    Error = 0
    Warning = 1
    Info = 2
end.
entity Diagnostic:
    level: DiagnosticLevel,
    message: i64; # InternID
    line: i64,
    col: i64,
    extra: string,
    secondary_line: i64,
    secondary_col: i64,
    secondary_note: string,
    file_id: i64,
    span_id: i64,
    file_path: i64,
    secondary_file_id: i64,
    secondary_file_path: i64
end.
entity DiagnosticEngine:
    diagnostics: i64; # vec of Diagnostic
    error_count: i64
end.
func diagnostic_engine_new()
    out DiagnosticEngine(
        diagnostics: vec_new_rt(),
        error_count: 0
    )
end.
func report_error_loc_related(engine: &DiagnosticEngine, message_id: i64, file_id: i64, line: i64, col: i64, extra: string, secondary_line: i64, secondary_col: i64, secondary_note: string):
    var cur_file = 0
    var cur_fid = file_id
    var cur_line = line
    if g_active_source_manager != 0 do
        if cur_fid == 0 and cur_line > 0 do
            cur_fid = sm_file_from_line(g_active_source_manager, cur_line)
            cur_line = sm_line_from_expanded(g_active_source_manager, cur_line)
        end
        # Always resolve the display path so the renderer never needs source_path.
        cur_file = sm_get_file_path(g_active_source_manager, cur_fid)
        if cur_file == 0 do
            cur_file = sm_get_file_path(g_active_source_manager, 0)
        end
    end
    var source_col = col
    if source_col <= 0 do source_col = 1 end
    var source_span = 0
    if g_active_source_manager != 0 do
        source_span = sm_add_span(g_active_source_manager, cur_fid, cur_line, source_col, cur_line, source_col + 1)
    end
    var sec_line = secondary_line
    var sec_col = secondary_col
    var sec_fid = 0
    var sec_file = 0
    if g_active_source_manager != 0 and sec_line > 0 do
        sec_fid = sm_file_from_line(g_active_source_manager, sec_line)
        sec_line = sm_line_from_expanded(g_active_source_manager, sec_line)
        sec_file = sm_get_file_path(g_active_source_manager, sec_fid)
    end
    if sec_file == 0 do
        sec_file = cur_file
    end
    if sec_col <= 0 and sec_line > 0 do sec_col = 1 end
    d = Diagnostic(
        level: DiagnosticLevel.Error,
        message: message_id,
        line: cur_line,
        col: source_col,
        extra: extra,
        secondary_line: sec_line,
        secondary_col: sec_col,
        secondary_note: secondary_note,
        file_id: cur_fid,
        span_id: source_span,
        file_path: cur_file,
        secondary_file_id: sec_fid,
        secondary_file_path: sec_file
    )
    diags = native_read_i64(engine as i64, 0)
    diags = vec_push_rt(diags, d)
    native_write_i64(engine as i64, 0, diags)
    errs = native_read_i64(engine as i64, 8)
    native_write_i64(engine as i64, 8, errs + 1)
end.
func report_error_span_related(engine: &DiagnosticEngine, message_id: i64, span_id: i64, extra: string, secondary_span_id: i64, secondary_note: string):
    var cur_fid = 0
    var cur_line = 1
    var cur_col = 1
    var cur_file = 0
    if span_id > 0 and g_active_source_manager != 0 do
        let sp = sm_get_span(g_active_source_manager, span_id)
        if sp != 0 do
            cur_fid = native_read_i64(sp, 0)
            cur_line = native_read_i64(sp, 8)
            cur_col = native_read_i64(sp, 16)
            cur_file = sm_get_file_path(g_active_source_manager, cur_fid)
        end
    end
    if cur_file == 0 and g_active_source_manager != 0 do
        cur_file = sm_get_file_path(g_active_source_manager, 0)
    end
    var sec_fid = 0
    var sec_line = 0
    var sec_col = 0
    var sec_file = 0
    if secondary_span_id > 0 and g_active_source_manager != 0 do
        let ssp = sm_get_span(g_active_source_manager, secondary_span_id)
        if ssp != 0 do
            sec_fid = native_read_i64(ssp, 0)
            sec_line = native_read_i64(ssp, 8)
            sec_col = native_read_i64(ssp, 16)
            sec_file = sm_get_file_path(g_active_source_manager, sec_fid)
        end
    end
    if sec_file == 0 do sec_file = cur_file end
    let d = Diagnostic(
        level: DiagnosticLevel.Error,
        message: message_id,
        line: cur_line,
        col: cur_col,
        extra: extra,
        secondary_line: sec_line,
        secondary_col: sec_col,
        secondary_note: secondary_note,
        file_id: cur_fid,
        span_id: span_id,
        file_path: cur_file,
        secondary_file_id: sec_fid,
        secondary_file_path: sec_file
    )
    var diags = native_read_i64(engine as i64, 0)
    diags = vec_push_rt(diags, d)
    native_write_i64(engine as i64, 0, diags)
    let errs = native_read_i64(engine as i64, 8)
    native_write_i64(engine as i64, 8, errs + 1)
end.

func report_error_span(engine: &DiagnosticEngine, message_id: i64, span_id: i64, extra: string):
    report_error_span_related(engine, message_id, span_id, extra, 0, "")
end.

func report_error_loc(engine: &DiagnosticEngine, message_id: i64, file_id: i64, line: i64, col: i64, extra: string):
    report_error_loc_related(engine, message_id, file_id, line, col, extra, 0, 0, "")
end.
func report_error(engine: &DiagnosticEngine, message_id: i64, line: i64, col: i64):
    report_error_info(engine, message_id, line, col, "")
end.
func report_error_info(engine: &DiagnosticEngine, message_id: i64, line: i64, col: i64, extra: string):
    report_error_loc(engine, message_id, 0, line, col, extra)
end.
func report_error_related(engine: &DiagnosticEngine, message_id: i64, line: i64, col: i64,
                          extra: string, secondary_line: i64, secondary_col: i64, secondary_note: string):
    var related_line = secondary_line
    if related_line <= 0 do
        related_line = line
    end
    report_error_loc_related(engine, message_id, 0, line, col, extra, related_line, secondary_col, secondary_note)
end.
func report_warning_span(engine: &DiagnosticEngine, message_id: i64, span_id: i64, extra: string):
    var cur_fid = 0
    var cur_line = 1
    var cur_col = 1
    var cur_file = 0
    if span_id > 0 and g_active_source_manager != 0 do
        let sp = sm_get_span(g_active_source_manager, span_id)
        if sp != 0 do
            cur_fid = native_read_i64(sp, 0)
            cur_line = native_read_i64(sp, 8)
            cur_col = native_read_i64(sp, 16)
            cur_file = sm_get_file_path(g_active_source_manager, cur_fid)
        end
    end
    if cur_file == 0 and g_active_source_manager != 0 do
        cur_file = sm_get_file_path(g_active_source_manager, 0)
    end
    let d = Diagnostic(
        level: DiagnosticLevel.Warning,
        message: message_id,
        line: cur_line,
        col: cur_col,
        extra: extra,
        secondary_line: 0,
        secondary_col: 0,
        secondary_note: "",
        file_id: cur_fid,
        span_id: span_id,
        file_path: cur_file,
        secondary_file_id: 0,
        secondary_file_path: 0
    )
    var diags = native_read_i64(engine as i64, 0)
    diags = vec_push_rt(diags, d)
    native_write_i64(engine as i64, 0, diags)
end.
func report_warning_loc(engine: &DiagnosticEngine, message_id: i64, file_id: i64, line: i64, col: i64, extra: string):
    var cur_file = 0
    var cur_fid = file_id
    var cur_line = line
    if g_active_source_manager != 0 do
        if cur_fid == 0 and cur_line > 0 do
            cur_fid = sm_file_from_line(g_active_source_manager, cur_line)
            cur_line = sm_line_from_expanded(g_active_source_manager, cur_line)
        end
        # Always resolve the display path so the renderer never needs source_path.
        cur_file = sm_get_file_path(g_active_source_manager, cur_fid)
        if cur_file == 0 do
            cur_file = sm_get_file_path(g_active_source_manager, 0)
        end
    end
    var source_col = col
    if source_col <= 0 do source_col = 1 end
    var source_span = 0
    if g_active_source_manager != 0 do
        source_span = sm_add_span(g_active_source_manager, cur_fid, cur_line, source_col, cur_line, source_col + 1)
    end
    d = Diagnostic(
        level: DiagnosticLevel.Warning,
        message: message_id,
        line: cur_line,
        col: source_col,
        extra: extra,
        secondary_line: 0,
        secondary_col: 0,
        secondary_note: "",
        file_id: cur_fid,
        span_id: source_span,
        file_path: cur_file,
        secondary_file_id: 0,
        secondary_file_path: 0
    )
    diags = native_read_i64(engine as i64, 0)
    diags = vec_push_rt(diags, d)
    native_write_i64(engine as i64, 0, diags)
end.
func report_warning(engine: &DiagnosticEngine, message_id: i64, line: i64, col: i64):
    report_warning_loc(engine, message_id, 0, line, col, "")
end.
func has_errors(engine: DiagnosticEngine)
    errs = native_read_i64(engine as i64, 8)
    out errs > 0
end.

var g_precomp_throw_kind: int = 0
var g_precomp_throw_val: i64 = 0
var g_precomp_throw_str: string = ""
var g_disable_specialization: int = 0
# ═══════════════════════════════════════════════════════
# AST Arena
# ═══════════════════════════════════════════════════════

entity ASTArena:
    nodes: i64 # vec of AstNode (or ANY)
end.
func ast_arena_new()
    arena = ASTArena(
        nodes: vec_new_rt()
    )
    arena.nodes = vec_push_rt(arena.nodes, 0); # index 0 is null/invalid node
    out arena
end.
func ast_arena_alloc(arena: ASTArena, node: any)
    nodes = native_read_i64(arena as i64, 0)
    id = vec_len_rt(nodes)
    nodes = vec_push_rt(nodes, node)
    native_write_i64(arena as i64, 0, nodes)
    out id
end.
func ast_arena_get(arena: ASTArena, id: i64)
    nodes = native_read_i64(arena as i64, 0)
    out vec_get_rt(nodes, id)
end.
func ast_arena_set(arena: ASTArena, id: i64, node: any)
    nodes = native_read_i64(arena as i64, 0)
    vec_set_rt(nodes, id, node)
end.
# ═══════════════════════════════════════════════════════
# CompilerContext
# ═══════════════════════════════════════════════════════

include type_table
include symbol_table
include scope_tree

entity CompilerContext:
    interner: StringInterner,
        diagnostics: DiagnosticEngine,
        ast_arena: ASTArena,
        types: i64,         # TypeTable
        symbols: i64,       # SymbolTable
        scopes: i64         # ScopeTree
end.
func context_new()
    out CompilerContext(
        interner: interner_new(),
        diagnostics: diagnostic_engine_new(),
        ast_arena: ast_arena_new(),
        types: 0,
        symbols: 0,
        scopes: 0
    )
end.
