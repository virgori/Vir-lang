##
 * vir/compiler/context.vri — Compiler Context & Core Infrastructure
 * ==============================================================
 * Centralized context holding all compiler state: Interner, Arenas, Diagnostics.
 ##

include types;
include result;
import Result, Ok, Err from result;

include string_rt;
import rt_streq, rt_strdup from string_rt;

include vec_rt;
import vec_new_rt, vec_push_rt, vec_get_rt, vec_len_rt, vec_set_rt from vec_rt;

# ═══════════════════════════════════════════════════════
# String Interner (InternPool)
# ═══════════════════════════════════════════════════════

entity StringInterner:
    strings: i64 # vec
end
func interner_new()
    var i = StringInterner(
        strings: vec_new_rt()
    );
    vec_push_rt(i.strings, ""); # index 0 is invalid/empty string
    out i
end
func intern_string(interner: StringInterner, s: string)
    len = vec_len_rt(interner.strings);
    var i = 1;
    when i < len loop
        existing = vec_get_rt(interner.strings, i);
        if rt_streq(existing, s) == 1 do
            out i
        end
        i = i + 1
    end
    vec_push_rt(interner.strings, rt_strdup(s));
    out len
end
func get_interned_string(interner: StringInterner, id: i64)
    out vec_get_rt(interner.strings, id)
end
# ═══════════════════════════════════════════════════════
# Diagnostic Engine
# ═══════════════════════════════════════════════════════

enum DiagnosticLevel:
    Error = 0;
    Warning = 1;
    Info = 2
end
entity Diagnostic:
    level: DiagnosticLevel,
        message: i64; # InternID
    line: i64,
        col: i64
end
entity DiagnosticEngine:
    diagnostics: i64; # vec of Diagnostic
    error_count: i64
end
func diagnostic_engine_new()
    out DiagnosticEngine(
        diagnostics: vec_new_rt(),
        error_count: 0
    )
end
func report_error(engine: DiagnosticEngine, message_id: i64, line: i64, col: i64)
    d = Diagnostic(
        level: DiagnosticLevel.Error,
        message: message_id,
        line: line,
        col: col
    );
    vec_push_rt(engine.diagnostics, d);
    engine.error_count = engine.error_count + 1
end
# ═══════════════════════════════════════════════════════
# AST Arena
# ═══════════════════════════════════════════════════════

entity ASTArena:
    nodes: i64 # vec of AstNode (or ANY)
end
func ast_arena_new()
    arena = ASTArena(
        nodes: vec_new_rt()
    );
    vec_push_rt(arena.nodes, 0); # index 0 is null/invalid node
    out arena
end
func ast_arena_alloc(arena: ASTArena, node: any)
    id = vec_len_rt(arena.nodes);
    vec_push_rt(arena.nodes, node);
    out id
end
func ast_arena_get(arena: ASTArena, id: i64)
    out vec_get_rt(arena.nodes, id)
end
# TODO: Needs vec_set_rt to be implemented in vec_rt if it isn't.
# For now, assuming vec_set_rt(vec, idx, val) exists.
func ast_arena_set(arena: ASTArena, id: i64, node: any)
    # In C-Core, we might need a vec_set_rt function.
    # Currently assuming it exists or we will add it.
    vec_set_rt(arena.nodes, id, node)
end
# ═══════════════════════════════════════════════════════
# CompilerContext
# ═══════════════════════════════════════════════════════

entity CompilerContext:
    interner: StringInterner,
        diagnostics: DiagnosticEngine,
        ast_arena: ASTArena
end
func context_new()
    out CompilerContext(
        interner: interner_new(),
        diagnostics: diagnostic_engine_new(),
        ast_arena: ast_arena_new()
    )
end