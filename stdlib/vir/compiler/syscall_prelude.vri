##
 * Soft-bootstrap prelude for `include syscall;` / alloc deps.
 * Full syscall.vri is large (hex consts, Platform.X, SVC wrappers).
 ##

enum Platform:
    MacOS_ARM64    = 0
    MacOS_x86_64   = 1
    Linux_ARM64    = 2
    Linux_x86_64   = 3
    Linux_RISCV64  = 4
    Wasm32_WASI_P1 = 5
end.

extern func sys_platform() -> int
func sys_platform() -> int:
    out 0
end.

# mmap flags used by soft alloc stubs (values match macOS ARM64)
const PROT_READ: 1
const PROT_WRITE: 2
const MAP_PRIVATE: 2
const MAP_ANONYMOUS: 0x1000

extern func sys_mmap(addr: int, len: int, prot: int, flags: int, fd: int, off: int) -> int
extern func sys_munmap(addr: int, len: int) -> int
func sys_mmap(addr: int, len: int, prot: int, flags: int, fd: int, off: int) -> int:
    out 0
end.
func sys_munmap(addr: int, len: int) -> int:
    out 0
end.

const STDIN_FD: 0
const STDOUT_FD: 1
const STDERR_FD: 2

const O_RDONLY: 0
const O_WRONLY: 1
const O_RDWR: 2
const O_CREAT: 0x0200
const O_TRUNC: 0x0400
const O_APPEND: 0x0008

extern func syscall1(num: int, a0: int) -> int
extern func syscall2(num: int, a0: int, a1: int) -> int
extern func syscall3(num: int, a0: int, a1: int, a2: int) -> int
extern func syscall4(num: int, a0: int, a1: int, a2: int, a3: int) -> int

func sys_write(fd: int, buf: int, count: int) -> int:
    out syscall3(0x2000004, fd, buf, count)
end.

func sys_read(fd: int, buf: int, count: int) -> int:
    out syscall3(0x2000003, fd, buf, count)
end.

func sys_open(path: int, flags: int, mode: int) -> int:
    out syscall3(0x2000005, path, flags, mode)
end.

func sys_close(fd: int) -> int:
    out syscall1(0x2000006, fd)
end.

func sys_lseek(fd: int, offset: int, whence: int) -> int:
    out syscall3(0x2000008, fd, offset, whence)
end.

func sys_fstat(fd: int, stat_buf: int) -> int:
    out syscall2(0x20000bd, fd, stat_buf)
end.

func sys_exit(code: int):
    syscall1(0x2000001, code)
end.

