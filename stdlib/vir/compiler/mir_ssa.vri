##
 * vir/compiler/mir_ssa.vri — SSA Construction & Variable Renaming
 * ==============================================================
 * Inserts Phi nodes and renames variables to guarantee
 * Static Single Assignment form (Cytron-style rename over idom tree).
 ##

include types
include vec_rt
import vec_new_rt, vec_push_rt, vec_get_rt, vec_set_rt, vec_len_rt, vec_pop_rt from vec_rt
include mir
import MirOp, MirOperandType, MirOperand, MirPhi, MirBlock, MirFunc, MirInstr, mir_opnd_none, mir_opnd_vreg, mir_instr_new, mir_phi_new, mir_block_new, mir_func_new, mir_instr_op, mir_instr_dst, mir_instr_src1, mir_instr_src2, mir_block_id, mir_block_head, mir_block_tail, mir_block_successors, mir_block_preds, mir_block_idom, mir_block_dom_children, mir_block_df, mir_block_next_block, mir_block_phis, mir_phi_dst, mir_phi_orig_vreg, mir_phi_incoming_blocks, mir_phi_incoming_values, mir_opnd_type, mir_opnd_vreg_id, mir_func_id, mir_func_name, mir_func_next_vreg, mir_func_def_uses, mir_func_next_block_id, mir_func_entry_block, mir_func_blocks, mir_func_strings, mir_func_var_buckets from mir

func find_max_vreg(func_obj: MirFunc, blocks: i64):
    max_vreg = 0
    n_blocks = vec_len_rt(blocks)
    var i = 0
    when i < n_blocks loop
        b = vec_get_rt(blocks, i)
        instrs = mir_block_head(b)
        if instrs >= 0 do
            n_instrs = vec_len_rt(instrs)
            var j = 0
            when j < n_instrs loop
                ins = vec_get_rt(instrs, j)
                d = mir_instr_dst(ins)
                s1 = mir_instr_src1(ins)
                s2 = mir_instr_src2(ins)
                if mir_opnd_type(d) == MirOperandType.VReg and mir_opnd_vreg_id(d) > max_vreg do
                    max_vreg = mir_opnd_vreg_id(d)
                end
                if mir_opnd_type(s1) == MirOperandType.VReg and mir_opnd_vreg_id(s1) > max_vreg do
                    max_vreg = mir_opnd_vreg_id(s1)
                end
                if mir_opnd_type(s2) == MirOperandType.VReg and mir_opnd_vreg_id(s2) > max_vreg do
                    max_vreg = mir_opnd_vreg_id(s2)
                end
                j = j + 1
            end
        end
        b_phis = mir_block_phis(b)
        if b_phis >= 0 do
            np = vec_len_rt(b_phis)
            var p = 0
            when p < np loop
                phi = vec_get_rt(b_phis, p)
                if mir_phi_orig_vreg(phi) > max_vreg do
                    max_vreg = mir_phi_orig_vreg(phi)
                end
                if mir_phi_dst(phi) > max_vreg do
                    max_vreg = mir_phi_dst(phi)
                end
                p = p + 1
            end
        end
        i = i + 1
    end
    out max_vreg
end.

func mir_collect_defined_vregs(blocks: i64, max_vreg: i64):
    # O(B*I): only vregs that actually have a def — skip empty slots in 0..max_vreg.
    vregs = vec_new_rt()
    if max_vreg < 0 do out vregs end
    seen = vec_new_rt()
    var si = 0
    when si <= max_vreg loop
        seen = vec_push_rt(seen, 0)
        si = si + 1
    end
    n_blocks = vec_len_rt(blocks)
    var bi = 0
    when bi < n_blocks loop
        b = vec_get_rt(blocks, bi)
        instrs = mir_block_head(b)
        if instrs >= 0 do
            n_instrs = vec_len_rt(instrs)
            var j = 0
            when j < n_instrs loop
                ins = vec_get_rt(instrs, j)
                d = mir_instr_dst(ins)
                if mir_opnd_type(d) == MirOperandType.VReg do
                    vid = mir_opnd_vreg_id(d)
                    if vid >= 0 and vid <= max_vreg and vec_get_rt(seen, vid) == 0 do
                        vec_set_rt(seen, vid, 1)
                        vregs = vec_push_rt(vregs, vid)
                    end
                end
                j = j + 1
            end
        end
        bi = bi + 1
    end
    out vregs
end.

func mir_insert_phi_nodes(func_obj: MirFunc, blocks: i64):
    max_vreg = find_max_vreg(func_obj, blocks)
    n_blocks = vec_len_rt(blocks)
    if n_blocks == 0 do
        out blocks
    end

    defined_vregs = mir_collect_defined_vregs(blocks, max_vreg)
    def_blocks = vec_new_rt()
    has_phi = vec_new_rt()
    var i = 0
    when i < n_blocks loop
        def_blocks = vec_push_rt(def_blocks, 0)
        has_phi = vec_push_rt(has_phi, 0)
        i = i + 1
    end

    # Precompute vreg -> def_blocks map once (O(I) instead of O(V * I))
    vreg_defs = vec_new_rt()
    var vdi = 0
    when vdi <= max_vreg loop
        vreg_defs = vec_push_rt(vreg_defs, 0)
        vdi = vdi + 1
    end

    var bi = 0
    when bi < n_blocks loop
        b = vec_get_rt(blocks, bi)
        instrs = mir_block_head(b)
        if instrs >= 0 do
            n_instrs = vec_len_rt(instrs)
            var j = 0
            when j < n_instrs loop
                ins = vec_get_rt(instrs, j)
                d = mir_instr_dst(ins)
                if mir_opnd_type(d) == MirOperandType.VReg do
                    vid = mir_opnd_vreg_id(d)
                    if vid >= 0 & vid <= max_vreg do
                        blist = vec_get_rt(vreg_defs, vid)
                        if blist == 0 do
                            blist = vec_new_rt()
                        end
                        blen = vec_len_rt(blist)
                        var push_block = false
                        if blen == 0 do
                            push_block = true
                        else
                            if vec_get_rt(blist, blen - 1) != bi do
                                push_block = true
                            end
                        end
                        if push_block do
                            blist = vec_push_rt(blist, bi)
                            vec_set_rt(vreg_defs, vid, blist)
                        end
                    end
                end
                j = j + 1
            end
        end
        bi = bi + 1
    end

    var vi = 0
    when vi < vec_len_rt(defined_vregs) loop
        v = vec_get_rt(defined_vregs, vi)
        defs = vec_get_rt(vreg_defs, v)
        if defs == 0 do
            vi = vi + 1
            skip
        end
        if vec_len_rt(defs) <= 1 do
            vi = vi + 1
            skip
        end

        bi = 0
        when bi < n_blocks loop
            vec_set_rt(def_blocks, bi, 0)
            vec_set_rt(has_phi, bi, 0)
            bi = bi + 1
        end

        worklist = vec_new_rt()
        n_defs = vec_len_rt(defs)
        var di = 0
        when di < n_defs loop
            blk_idx = vec_get_rt(defs, di)
            vec_set_rt(def_blocks, blk_idx, 1)
            worklist = vec_push_rt(worklist, blk_idx)
            di = di + 1
        end

        if vec_len_rt(worklist) > 1 do
            var head = 0
            when head < vec_len_rt(worklist) loop
                x = vec_get_rt(worklist, head)
                head = head + 1

                b = vec_get_rt(blocks, x)
                b_df = mir_block_df(b)

                if b_df >= 0 do
                    df_len = vec_len_rt(b_df)
                    var j = 0
                    when j < df_len loop
                        y_idx = vec_get_rt(b_df, j)
                        if vec_get_rt(has_phi, y_idx) == 0 do
                            y = vec_get_rt(blocks, y_idx)
                            y_preds = mir_block_preds(y)
                            n_preds = vec_len_rt(y_preds)

                            inc_vals = vec_new_rt()
                            inc_blks = vec_new_rt()
                            var p = 0
                            when p < n_preds loop
                                pred_idx = vec_get_rt(y_preds, p)
                                inc_vals = vec_push_rt(inc_vals, mir_opnd_vreg(v))
                                inc_blks = vec_push_rt(inc_blks, pred_idx)
                                p = p + 1
                            end

                            phi_node = mir_phi_new(
                                v,
                                v,
                                inc_vals,
                                inc_blks,
                                0
                            )

                            y_phis = mir_block_phis(y)
                            if y_phis < 0 do
                                y_phis = vec_new_rt()
                            end
                            y_phis = vec_push_rt(y_phis, phi_node)

                            y_new = mir_block_new(
                                mir_block_id(y),
                                y_phis,
                                mir_block_head(y),
                                mir_block_tail(y),
                                mir_block_successors(y),
                                mir_block_preds(y),
                                mir_block_idom(y),
                                mir_block_dom_children(y),
                                mir_block_df(y),
                                mir_block_next_block(y)
                            )
                            vec_set_rt(blocks, y_idx, y_new)

                            vec_set_rt(has_phi, y_idx, 1)

                            if vec_get_rt(def_blocks, y_idx) == 0 do
                                vec_set_rt(def_blocks, y_idx, 1)
                                worklist = vec_push_rt(worklist, y_idx)
                            end
                        end
                        j = j + 1
                    end
                end
            end
        end
        vi = vi + 1
    end
    out blocks
end.

func ssa_stack_top(stacks: i64, v: i64):
    if v < 0 or v >= vec_len_rt(stacks) do
        out v
    end
    stk = vec_get_rt(stacks, v)
    n = vec_len_rt(stk)
    if n <= 0 do
        out v
    end
    out vec_get_rt(stk, n - 1)
end.

func ssa_stack_push(stacks: i64, v: i64, name: i64):
    stk = vec_get_rt(stacks, v)
    stk = vec_push_rt(stk, name)
    vec_set_rt(stacks, v, stk)
    out stacks
end.

func ssa_stack_pop(stacks: i64, v: i64):
    stk = vec_get_rt(stacks, v)
    if vec_len_rt(stk) <= 0 do
        out stacks
    end
    vec_pop_rt(stk)
    out stacks
end.

func ssa_fresh(func_obj: MirFunc):
    n = mir_func_next_vreg(func_obj)
    native_write_i64(func_obj as i64, 16, n + 1)
    out (func_obj, n)
end.

func mir_rename_block(func_obj: MirFunc, blocks: i64, bi: i64, stacks: i64):
    b = vec_get_rt(blocks, bi)
    pushed = vec_new_rt()

    # 1. Rename phi destinations
    b_phis = mir_block_phis(b)
    if b_phis >= 0 do
        np = vec_len_rt(b_phis)
        var p = 0
        when p < np loop
            phi = vec_get_rt(b_phis, p)
            var (func_obj_new, nn) = ssa_fresh(func_obj)
            func_obj = func_obj_new
            stacks = ssa_stack_push(stacks, mir_phi_orig_vreg(phi), nn)
            pushed = vec_push_rt(pushed, mir_phi_orig_vreg(phi))
            phi_new = mir_phi_new(
                nn,
                mir_phi_orig_vreg(phi),
                mir_phi_incoming_values(phi),
                mir_phi_incoming_blocks(phi),
                0
            )
            vec_set_rt(b_phis, p, phi_new)
            p = p + 1
        end
    end

    # 2. Rename instruction uses then defs
    b_head = mir_block_head(b)
    if b_head >= 0 do
        n_instrs = vec_len_rt(b_head)
        var j = 0
        when j < n_instrs loop
            ins = vec_get_rt(b_head, j)
            s1 = mir_instr_src1(ins)
            s2 = mir_instr_src2(ins)
            dst = mir_instr_dst(ins)
            if mir_opnd_type(s1) == MirOperandType.VReg do
                s1 = mir_opnd_vreg(ssa_stack_top(stacks, mir_opnd_vreg_id(s1)))
            end
            if mir_opnd_type(s2) == MirOperandType.VReg do
                s2 = mir_opnd_vreg(ssa_stack_top(stacks, mir_opnd_vreg_id(s2)))
            end
            if mir_opnd_type(dst) == MirOperandType.VReg do
                orig = mir_opnd_vreg_id(dst)
                var (func_obj_new2, nn2) = ssa_fresh(func_obj)
                func_obj = func_obj_new2
                stacks = ssa_stack_push(stacks, orig, nn2)
                pushed = vec_push_rt(pushed, orig)
                dst = mir_opnd_vreg(nn2)
            end
            ins_new = mir_instr_new(
                mir_instr_op(ins),
                dst,
                s1,
                s2
            )
            vec_set_rt(b_head, j, ins_new)
            j = j + 1
        end
    end
    b_new = mir_block_new(
        mir_block_id(b),
        b_phis,
        b_head,
        mir_block_tail(b),
        mir_block_successors(b),
        mir_block_preds(b),
        mir_block_idom(b),
        mir_block_dom_children(b),
        mir_block_df(b),
        mir_block_next_block(b)
    )
    vec_set_rt(blocks, bi, b_new)

    # 3. Fill phi operands in successors for this predecessor
    b_succs = mir_block_successors(b)
    if b_succs >= 0 do
        ns = vec_len_rt(b_succs)
        var s = 0
        when s < ns loop
            succ = vec_get_rt(b_succs, s)
            sb = vec_get_rt(blocks, succ)
            sb_phis = mir_block_phis(sb)
            if sb_phis >= 0 do
                np2 = vec_len_rt(sb_phis)
                var p2 = 0
                when p2 < np2 loop
                    phi2 = vec_get_rt(sb_phis, p2)
                    phi2_inc_blks = mir_phi_incoming_blocks(phi2)
                    phi2_inc_vals = mir_phi_incoming_values(phi2)
                    nin = vec_len_rt(phi2_inc_blks)
                    var k = 0
                    when k < nin loop
                        if vec_get_rt(phi2_inc_blks, k) == bi do
                            cur = ssa_stack_top(stacks, mir_phi_orig_vreg(phi2))
                            vec_set_rt(phi2_inc_vals, k, mir_opnd_vreg(cur))
                        end
                        k = k + 1
                    end
                    p2 = p2 + 1
                end
            end
            s = s + 1
        end
    end

    # 4. Recurse on dominator-tree children
    b = vec_get_rt(blocks, bi)
    b_dom_children = mir_block_dom_children(b)
    if b_dom_children >= 0 do
        nc = vec_len_rt(b_dom_children)
        var c = 0
        when c < nc loop
            child = vec_get_rt(b_dom_children, c)
            var (func_obj_rec, blocks_rec, stacks_rec) = mir_rename_block(func_obj, blocks, child, stacks)
            func_obj = func_obj_rec
            blocks = blocks_rec
            stacks = stacks_rec
            c = c + 1
        end
    end

    # 5. Pop names defined in this block
    var pi = 0
    when pi < vec_len_rt(pushed) loop
        ov = vec_get_rt(pushed, pi)
        stacks = ssa_stack_pop(stacks, ov)
        pi = pi + 1
    end

    out (func_obj, blocks, stacks)
end.

func mir_rename_variables(func_obj: MirFunc, blocks: i64):
    max_vreg = find_max_vreg(func_obj, blocks)
    stacks = vec_new_rt()
    var v = 0
    when v <= max_vreg loop
        stk = vec_new_rt()
        stk = vec_push_rt(stk, v)
        stacks = vec_push_rt(stacks, stk)
        v = v + 1
    end
    if mir_func_next_vreg(func_obj) <= max_vreg do
        native_write_i64(func_obj as i64, 16, max_vreg + 1)
    end
    entry = 0
    if mir_func_entry_block(func_obj) >= 0 do
        entry = mir_func_entry_block(func_obj)
    end
    var (func_obj2, blocks2, _) = mir_rename_block(func_obj, blocks, entry, stacks)
    out (func_obj2, blocks2)
end.

export mir_insert_phi_nodes, mir_rename_variables, find_max_vreg
