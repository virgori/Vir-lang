##
 * vir/compiler/mir_ssa.vri — SSA Construction & Variable Renaming
 * ==============================================================
 * Inserts Phi nodes and renames variables to guarantee
 * Static Single Assignment form (Cytron-style rename over idom tree).
 ##

include types;
include vec_rt;
import vec_new_rt, vec_push_rt, vec_get_rt, vec_set_rt, vec_len_rt from vec_rt;
include mir;
import MirOp, MirOperandType, MirOperand, MirPhi, MirBlock, MirFunc, mir_opnd_none, mir_opnd_vreg from mir;

func find_max_vreg(func_obj: MirFunc, blocks: i64):
    max_vreg = 0;
    n_blocks = vec_len_rt(blocks);
    i = 0;
    when i < n_blocks loop
        b = vec_get_rt(blocks, i);
        instrs = b.head;
        if instrs >= 0 do
            n_instrs = vec_len_rt(instrs);
            j = 0;
            when j < n_instrs loop
                ins = vec_get_rt(instrs, j);
                if ins.dst.op_type == MirOperandType.VReg and ins.dst.vreg > max_vreg do
                    max_vreg = ins.dst.vreg
                end
                if ins.src1.op_type == MirOperandType.VReg and ins.src1.vreg > max_vreg do
                    max_vreg = ins.src1.vreg
                end
                if ins.src2.op_type == MirOperandType.VReg and ins.src2.vreg > max_vreg do
                    max_vreg = ins.src2.vreg
                end
                j = j + 1
            end
        end
        if b.phis >= 0 do
            np = vec_len_rt(b.phis);
            p = 0;
            when p < np loop
                phi = vec_get_rt(b.phis, p);
                if phi.orig_vreg > max_vreg do
                    max_vreg = phi.orig_vreg
                end
                if phi.dst_vreg > max_vreg do
                    max_vreg = phi.dst_vreg
                end
                p = p + 1
            end
        end
        i = i + 1
    end
    out max_vreg
end.

func mir_insert_phi_nodes(func_obj: MirFunc, blocks: i64):
    max_vreg = find_max_vreg(func_obj, blocks);
    n_blocks = vec_len_rt(blocks);
    if n_blocks == 0 do
        out blocks
    end

    v = 0;
    when v <= max_vreg loop
        def_blocks = vec_new_rt();
        has_phi = vec_new_rt();

        i = 0;
        when i < n_blocks loop
            def_blocks = vec_push_rt(def_blocks, 0);
            has_phi = vec_push_rt(has_phi, 0);
            i = i + 1
        end
        worklist = vec_new_rt();

        i = 0;
        when i < n_blocks loop
            b = vec_get_rt(blocks, i);
            defined = false;

            instrs = b.head;
            if instrs >= 0 do
                n_instrs = vec_len_rt(instrs);
                j = 0;
                when j < n_instrs loop
                    ins = vec_get_rt(instrs, j);
                    if ins.dst.op_type == MirOperandType.VReg and ins.dst.vreg == v do
                        defined = true
                    end
                    j = j + 1
                end
            end
            if defined do
                vec_set_rt(def_blocks, i, 1);
                worklist = vec_push_rt(worklist, i)
            end
            i = i + 1
        end

        head = 0;
        when head < vec_len_rt(worklist) loop
            x = vec_get_rt(worklist, head);
            head = head + 1;

            b = vec_get_rt(blocks, x);

            if b.df >= 0 do
                df_len = vec_len_rt(b.df);
                j = 0;
                when j < df_len loop
                    y_idx = vec_get_rt(b.df, j);
                    if vec_get_rt(has_phi, y_idx) == 0 do
                        y = vec_get_rt(blocks, y_idx);

                        phi_node = MirPhi (
                            orig_vreg: v,
                            dst_vreg: v,
                            incoming_values: vec_new_rt(),
                            incoming_blocks: vec_new_rt(),
                            next: y.phis
                        );

                        n_preds = vec_len_rt(y.preds);
                        p = 0;
                        when p < n_preds loop
                            pred_idx = vec_get_rt(y.preds, p);
                            phi_node.incoming_values = vec_push_rt(phi_node.incoming_values, mir_opnd_vreg(v));
                            phi_node.incoming_blocks = vec_push_rt(phi_node.incoming_blocks, pred_idx);
                            p = p + 1
                        end
                        if y.phis < 0 do
                            y.phis = vec_new_rt()
                        end
                        y.phis = vec_push_rt(y.phis, phi_node);
                        vec_set_rt(blocks, y_idx, y);

                        vec_set_rt(has_phi, y_idx, 1);

                        if vec_get_rt(def_blocks, y_idx) == 0 do
                            vec_set_rt(def_blocks, y_idx, 1);
                            worklist = vec_push_rt(worklist, y_idx)
                        end
                    end
                    j = j + 1
                end
            end
        end
        v = v + 1
    end
    out blocks
end.

func ssa_stack_top(stacks: i64, v: i64):
    if v < 0 or v >= vec_len_rt(stacks) do
        out v
    end
    stk = vec_get_rt(stacks, v);
    n = vec_len_rt(stk);
    if n <= 0 do
        out v
    end
    out vec_get_rt(stk, n - 1)
end.

func ssa_stack_push(stacks: i64, v: i64, name: i64):
    stk = vec_get_rt(stacks, v);
    stk = vec_push_rt(stk, name);
    vec_set_rt(stacks, v, stk);
    out stacks
end.

func ssa_stack_pop(stacks: i64, v: i64):
    stk = vec_get_rt(stacks, v);
    n = vec_len_rt(stk);
    if n <= 0 do
        out stacks
    end
    new_stk = vec_new_rt();
    i = 0;
    when i < n - 1 loop
        new_stk = vec_push_rt(new_stk, vec_get_rt(stk, i));
        i = i + 1
    end
    vec_set_rt(stacks, v, new_stk);
    out stacks
end.

func ssa_fresh(func_obj: MirFunc):
    n = func_obj.next_vreg;
    func_obj.next_vreg = n + 1;
    out (func_obj, n)
end.

func mir_rename_block(func_obj: MirFunc, blocks: i64, bi: i64, stacks: i64):
    b = vec_get_rt(blocks, bi);
    pushed = vec_new_rt();

    # 1. Rename phi destinations
    if b.phis >= 0 do
        np = vec_len_rt(b.phis);
        p = 0;
        when p < np loop
            phi = vec_get_rt(b.phis, p);
            var (func_obj, nn) = ssa_fresh(func_obj);
            stacks = ssa_stack_push(stacks, phi.orig_vreg, nn);
            pushed = vec_push_rt(pushed, phi.orig_vreg);
            phi.dst_vreg = nn;
            vec_set_rt(b.phis, p, phi);
            p = p + 1
        end
    end

    # 2. Rename instruction uses then defs
    if b.head >= 0 do
        n_instrs = vec_len_rt(b.head);
        j = 0;
        when j < n_instrs loop
            ins = vec_get_rt(b.head, j);
            if ins.src1.op_type == MirOperandType.VReg do
                ins.src1 = mir_opnd_vreg(ssa_stack_top(stacks, ins.src1.vreg))
            end
            if ins.src2.op_type == MirOperandType.VReg do
                ins.src2 = mir_opnd_vreg(ssa_stack_top(stacks, ins.src2.vreg))
            end
            if ins.dst.op_type == MirOperandType.VReg do
                orig = ins.dst.vreg;
                var (func_obj, nn2) = ssa_fresh(func_obj);
                stacks = ssa_stack_push(stacks, orig, nn2);
                pushed = vec_push_rt(pushed, orig);
                ins.dst = mir_opnd_vreg(nn2)
            end
            vec_set_rt(b.head, j, ins);
            j = j + 1
        end
    end
    vec_set_rt(blocks, bi, b);

    # 3. Fill phi operands in successors for this predecessor
    if b.successors >= 0 do
        ns = vec_len_rt(b.successors);
        s = 0;
        when s < ns loop
            succ = vec_get_rt(b.successors, s);
            sb = vec_get_rt(blocks, succ);
            if sb.phis >= 0 do
                np2 = vec_len_rt(sb.phis);
                p2 = 0;
                when p2 < np2 loop
                    phi2 = vec_get_rt(sb.phis, p2);
                    nin = vec_len_rt(phi2.incoming_blocks);
                    k = 0;
                    when k < nin loop
                        if vec_get_rt(phi2.incoming_blocks, k) == bi do
                            cur = ssa_stack_top(stacks, phi2.orig_vreg);
                            vec_set_rt(phi2.incoming_values, k, mir_opnd_vreg(cur));
                            vec_set_rt(sb.phis, p2, phi2)
                        end
                        k = k + 1
                    end
                    p2 = p2 + 1
                end
                vec_set_rt(blocks, succ, sb)
            end
            s = s + 1
        end
    end

    # 4. Recurse on dominator-tree children
    b = vec_get_rt(blocks, bi);
    if b.dom_children >= 0 do
        nc = vec_len_rt(b.dom_children);
        c = 0;
        when c < nc loop
            child = vec_get_rt(b.dom_children, c);
            var (func_obj, blocks, stacks) = mir_rename_block(func_obj, blocks, child, stacks);
            c = c + 1
        end
    end

    # 5. Pop names defined in this block
    pi = 0;
    when pi < vec_len_rt(pushed) loop
        ov = vec_get_rt(pushed, pi);
        stacks = ssa_stack_pop(stacks, ov);
        pi = pi + 1
    end

    out (func_obj, blocks, stacks)
end.

func mir_rename_variables(func_obj: MirFunc, blocks: i64):
    max_vreg = find_max_vreg(func_obj, blocks);
    stacks = vec_new_rt();
    v = 0;
    when v <= max_vreg loop
        stk = vec_new_rt();
        stk = vec_push_rt(stk, v);
        stacks = vec_push_rt(stacks, stk);
        v = v + 1
    end
    if func_obj.next_vreg <= max_vreg do
        func_obj.next_vreg = max_vreg + 1
    end
    entry = 0;
    if func_obj.entry_block >= 0 do
        entry = func_obj.entry_block
    end
    var (func_obj2, blocks2, _) = mir_rename_block(func_obj, blocks, entry, stacks);
    out (func_obj2, blocks2)
end.

export mir_insert_phi_nodes, mir_rename_variables, find_max_vreg
