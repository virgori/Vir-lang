##
 * vir/compiler/mir_ssa.vri — SSA Construction
 * ==============================================================
 * Inserts Phi nodes and renames variables to guarantee
 * Static Single Assignment form.
 ##

include types;
include vec_rt;
import vec_new_rt, vec_push_rt, vec_get_rt, vec_set_rt, vec_len_rt from vec_rt;
include mir;
import MirOp, MirOperandType, MirOperand, MirInstr, MirPhi, MirBlock, MirFunc, mir_opnd_none, mir_opnd_vreg from mir;

# ═══════════════════════════════════════════════════════
# SSA Phi Node Insertion
# ═══════════════════════════════════════════════════════

func find_max_vreg(func_obj: MirFunc, blocks: i64):
    max_vreg = 0;
    n_blocks = vec_len_rt(blocks);
    i = 0;
    when i < n_blocks loop
        b = vec_get_rt(blocks, i);
        
        # We don't have direct linked list walking yet, assume we store instrs in a Vec<MirInstr>
        # Let's say b.head is the start index in a global instr array, but for now
        # let's assume we iterate over a Vec stored in b.head for simplicity, or we have a global instrs array.
        # This requires the data structure to hold instrs. 
        # In this self-hosted bootstrap, let's assume b.head is a Vec<MirInstr>.
        
        instrs = b.head; 
        if instrs >= 0 do
            n_instrs = vec_len_rt(instrs);
            j = 0;
            when j < n_instrs loop
                ins = vec_get_rt(instrs, j);
                if ins.dst.op_type == MirOperandType.VReg and ins.dst.vreg > max_vreg do
                    max_vreg = ins.dst.vreg
                end.
                if ins.src1.op_type == MirOperandType.VReg and ins.src1.vreg > max_vreg do
                    max_vreg = ins.src1.vreg
                end.
                if ins.src2.op_type == MirOperandType.VReg and ins.src2.vreg > max_vreg do
                    max_vreg = ins.src2.vreg
                end.
                j = j + 1
            end.
        end.
        i = i + 1
    end.
    out max_vreg
end.

func mir_insert_phi_nodes(func_obj: MirFunc, blocks: i64):
    max_vreg = find_max_vreg(func_obj, blocks);
    if max_vreg == 0 do
        out blocks
    end.
    
    n_blocks = vec_len_rt(blocks);
    
    v = 1;
    when v <= max_vreg loop
        def_blocks = vec_new_rt();
        has_phi = vec_new_rt();
        
        i = 0;
        when i < n_blocks loop
            def_blocks = vec_push_rt(def_blocks, 0);
            has_phi = vec_push_rt(has_phi, 0);
            i = i + 1
        end.
        
        worklist = vec_new_rt();
        
        # Find defining blocks
        i = 0;
        when i < n_blocks loop
            b = vec_get_rt(blocks, i);
            defined = false;
            
            instrs = b.head;
            if instrs >= 0 do
                n_instrs = vec_len_rt(instrs);
                j = 0;
                when j < n_instrs loop
                    ins = vec_get_rt(instrs, j);
                    if ins.dst.op_type == MirOperandType.VReg and ins.dst.vreg == v do
                        defined = true
                    end.
                    j = j + 1
                end.
            end.
            
            if defined do
                vec_set_rt(def_blocks, i, 1);
                worklist = vec_push_rt(worklist, i)
            end.
            i = i + 1
        end.
        
        # Compute IDF
        head = 0;
        when head < vec_len_rt(worklist) loop
            x = vec_get_rt(worklist, head);
            head = head + 1;
            
            b = vec_get_rt(blocks, x);
            
            if b.df >= 0 do
                df_len = vec_len_rt(b.df);
                j = 0;
                when j < df_len loop
                    y_idx = vec_get_rt(b.df, j);
                    if vec_get_rt(has_phi, y_idx) == 0 do
                        y = vec_get_rt(blocks, y_idx);
                        
                        # Insert Phi
                        phi_node = MirPhi (
                            orig_vreg: v,
                            dst_vreg: v,
                            incoming_values: vec_new_rt(),
                            incoming_blocks: vec_new_rt(),
                            next: y.phis
                        );
                        
                        n_preds = vec_len_rt(y.preds);
                        p = 0;
                        when p < n_preds loop
                            pred_idx = vec_get_rt(y.preds, p);
                            phi_node.incoming_values = vec_push_rt(phi_node.incoming_values, mir_opnd_none());
                            phi_node.incoming_blocks = vec_push_rt(phi_node.incoming_blocks, pred_idx);
                            p = p + 1
                        end.
                        
                        if y.phis < 0 do
                            y.phis = vec_new_rt()
                        end.
                        y.phis = vec_push_rt(y.phis, phi_node);
                        vec_set_rt(blocks, y_idx, y);
                        
                        vec_set_rt(has_phi, y_idx, 1);
                        
                        if vec_get_rt(def_blocks, y_idx) == 0 do
                            vec_set_rt(def_blocks, y_idx, 1);
                            worklist = vec_push_rt(worklist, y_idx)
                        end.
                    end.
                    j = j + 1
                end.
            end.
        end.
        v = v + 1
    end.
    
    out blocks
end.


# ═══════════════════════════════════════════════════════
# SSA Variable Renaming
# ═══════════════════════════════════════════════════════

func top_version(stacks: i64, orig: i64):
    st = vec_get_rt(stacks, orig);
    if vec_len_rt(st) > 0 do
        out vec_get_rt(st, vec_len_rt(st) - 1)
    end.
    out orig
end.

func push_version(stacks: i64, orig: i64, new_v: i64):
    st = vec_get_rt(stacks, orig);
    st = vec_push_rt(st, new_v);
    vec_set_rt(stacks, orig, st);
    out stacks
end.

func pop_version(stacks: i64, orig: i64):
    st = vec_get_rt(stacks, orig);
    len = vec_len_rt(st);
    if len > 0 do
        # We don't have pop yet in vec_rt, so we simulate it by ignoring the last element
        # In a real compiler we'd have vec_pop_rt
        # For now, we assume we have a custom pop or we resize
    end.
    out stacks
end.

export mir_insert_phi_nodes;
