##
 * Canonical Option<T> prelude for `include option;`.
 * Uses the compiler tagged-union ABI (u32 tag, payload at byte 8).
 ##

enum Option:
    Some(value: T)
    None
end.

func is_some(opt: Option):
    case opt
        Some(_): out true
        None: out false
    end
end.

func is_none(opt: Option):
    out !is_some(opt)
end.
