##
 * vir/compiler/main.vri — Vir Self-Hosting Compiler Driver
 * =========================================================
 * Phase 5: Bootstrap — Vir compiles itself to a standalone binary.
 *
 * Pipeline
 *   source.vri → lex → parse → HIR → MIR → LIR → Q-IR → codegen → Mach-O
 *
 * Produces a standalone Mach-O ARM64 executable that uses direct
 * BSD syscalls — no Python, no C library, no external linker needed.
 *
 * Usage (Stage 1 — bootstrapped via C runtime)
 *   vir jit stdlib/vir/compiler/main.vri <input.vri> [-o output]
 *
 * Usage (Stage 2 — self-hosted)
 *   ./virc <input.vri> [-o output]
 *
 * Date: 9/3/2026
 ##

include lexer;
include parser;
include pipeline;
import compile_pipeline from pipeline;
include ir_optimizer;
import QOp, QModule, OperandType from ir_optimizer;
include codegen;
include binary;
import Arch, ByteBuffer, buf_new, buf_write_u8, buf_write_u32_le, buf_write_u64_le, buf_write_zeros, buf_write_string_padded, buf_write_cstr_padded, buf_write_bytes, buf_size, buf_align, buf_get_u8 from binary;
include linker;
import link_single_kernel from linker;
include file;
import File, FileMode, file_open, file_read_all, file_create, file_write_all, file_close from file;
include slice;
import Slice, slice_new from slice;
include "stdlib/vir/rt/string_rt.vri";
import fat_str_new, fat_str_len, fat_str_byte_at, fat_cstr_eq, rt_streq, str_from_cstr from "stdlib/vir/rt/string_rt.vri";
    str_concat;
include "stdlib/vir/rt/vec_rt.vri";
import bvec_len, bvec_get, vec_len_rt, vec_get_rt, vec_new_rt, vec_push_rt from "stdlib/vir/rt/vec_rt.vri";
include vec;
import Vec, vec_len, vec_get from vec;



# ═══════════════════════════════════════════════════════
# Mach-O Constants (macOS ARM64)
# ═══════════════════════════════════════════════════════

const MACHO_MAGIC: 0xFEEDFACF;
const CPU_ARM64: 0x0100000C;
const CPU_SUB_ALL: 0x00000000;
const MH_EXECUTE: 2;
const MH_FLAGS: 0x00200085    # PIE | TWOLEVEL | DYLDLINK;
const LC_SEGMENT_64: 0x19;
const LC_SYMTAB: 0x02;
const LC_DYSYMTAB: 0x0B;
const LC_LOAD_DYLIB: 0x0C;
const LC_LOAD_DYLINKER: 0x0E;
const LC_UUID: 0x1B;
const LC_MAIN: 0x80000028;
const LC_DYLD_CHAINED_FIXUPS: 0x80000034;
const TEXT_BASE: 0x100000000;
const PAGE_SIZE: 0x4000;

# macOS BSD syscall numbers (add 0x2000000 for BSD layer)
const SYS_EXIT: 0x2000001;
const SYS_WRITE: 0x2000004;
const SYS_CHMOD: 0x200000F;


# ═══════════════════════════════════════════════════════
# Module-Level Code Emission
# ═══════════════════════════════════════════════════════
# Emits all functions from a Q-IR module into a single
# code buffer with cross-function call resolution.

entity FuncLayout:
    name:       string,
        offset:     int    # byte offset in the code buffer,
        size:       int
end.
# Emit the ARM64 runtime stubs that compiled programs need
#   offset 0: _rt_print_i64  — print integer to stdout + newline
#   offset N: _rt_exit       — exit process
# Returns (cb, print_offset, exit_offset, total_runtime_size)

func emit_runtime_arm64(cb: CodeBuf):

    print_offset = codebuf_offset(cb);

    # ── _rt_print_i64: X0 = value to print ──
    # Prologue: save frame + callee-saved registers
    cb = arm64_stp_pre(cb, 29, 30, 31, -96)    # STP X29, X30, [SP, #-96]!;
    cb = arm64_mov_rr(cb, 29, 31)              # MOV X29, SP;
    cb = arm64_mov_rr(cb, 19, 0)               # MOV X19, X0 (save value);

    # Buffer at SP+16, X20 = buffer base, X21 = position
    cb = arm64_add_rrr(cb, 20, 31, 0)          # ADD X20, SP, X0 (wrong, needs imm);
    # Actually: ADD X20, SP, #16
    # ARM64 ADD immediate: 0x91004000 | (imm12 << 10) | (Rn << 5) | Rd
    cb = codebuf_emit_u32(cb, 0x91004000 | (16 << 10) | (31 << 5) | 20);
    cb = arm64_mov_imm16(cb, 21, 0)            # MOV X21, #0 (position);
    cb = arm64_mov_imm16(cb, 22, 0)            # MOV X22, #0 (is_neg);

    # Handle negative: if X19 < 0
    # CMP X19, #0
    cb = arm64_cmp_imm0(cb, 19);
    # B.GE +3 instructions (skip negate)
    # B.GE is B.cond with cond=0b1010=10, imm19 = 3
    cb = codebuf_emit_u32(cb, 0x5400006A)   # B.GE +3*4;
    # NEG X19, X19 → SUB X19, XZR, X19
    cb = codebuf_emit_u32(cb, 0xCB1303F3)   # SUB X19, XZR, X19;
    # MOV X22, #1 (is_neg = true)
    cb = arm64_mov_imm16(cb, 22, 1);

    # Handle zero: CBZ X19, .is_zero → 4 instructions forward to .is_zero
    # CBZ X19 = 0xB4000000 | (imm19 << 5) | 19
    # .is_zero is after the digit loop, need forward ref
    # Use placeholder, will back-patch
    zero_check_patch = codebuf_offset(cb);
    cb = codebuf_emit_u32(cb, 0xB4000013)       # CBZ X19, placeholder;

    # Digit conversion loop
    cb = arm64_mov_imm16(cb, 23, 10)             # MOV X23, #10;
    # .digit_loop
    digit_loop = codebuf_offset(cb);
    # CBZ X19, .digits_done
    digits_done_patch = codebuf_offset(cb);
    cb = codebuf_emit_u32(cb, 0xB4000013)       # CBZ X19, placeholder;

    # UDIV X24, X19, X23
    cb = codebuf_emit_u32(cb, 0x9AC30A78)       # UDIV X24, X19, X23;
    # MSUB X25, X24, X23, X19 → X25 = X19 - X24*X23
    cb = codebuf_emit_u32(cb, 0x9B178F19)       # MSUB X25, X24, X23, X19;
    # ADD X25, X25, #48 ('0')
    cb = codebuf_emit_u32(cb, 0x9100C339)       # ADD X25, X25, #48;
    # STRB W25, [X20, X21]
    cb = codebuf_emit_u32(cb, 0x38216A99)       # STRB W25, [X20, X21];
    # ADD X21, X21, #1
    cb = codebuf_emit_u32(cb, 0x910006B5)       # ADD X21, X21, #1;
    # MOV X19, X24 (quotient)
    cb = arm64_mov_rr(cb, 19, 24);
    # B .digit_loop
    back = (digit_loop - codebuf_offset(cb)) / 4;
    cb = codebuf_emit_u32(cb, 0x14000000 | (back & 0x03FFFFFF));
    # B .reverse (skip .is_zero)
    skip_zero_patch = codebuf_offset(cb);
    cb = codebuf_emit_u32(cb, 0x14000000)        # B placeholder;

    # .is_zero: store '0'
    is_zero = codebuf_offset(cb);
    cb = arm64_mov_imm16(cb, 25, 48)             # MOV X25, #'0';
    cb = codebuf_emit_u32(cb, 0x38216A99)        # STRB W25, [X20, X21];
    cb = codebuf_emit_u32(cb, 0x910006B5)        # ADD X21, X21, #1;

    # .digits_done / .reverse
    reverse_start = codebuf_offset(cb);

    # Patch zero_check_patch → .is_zero
    zc_off = (is_zero - zero_check_patch) / 4;
    cb = codebuf_patch_u32(cb, zero_check_patch,
        0xB4000013 | ((zc_off & 0x7FFFF) << 5));

    # Patch digits_done_patch → reverse_start
    dd_off = (reverse_start - digits_done_patch) / 4;
    cb = codebuf_patch_u32(cb, digits_done_patch,
        0xB4000013 | ((dd_off & 0x7FFFF) << 5));

    # Patch skip_zero_patch → reverse_start
    sz_off = (reverse_start - skip_zero_patch) / 4;
    cb = codebuf_patch_u32(cb, skip_zero_patch,
        0x14000000 | (sz_off & 0x03FFFFFF));

    # Add '-' if negative
    # CBZ X22, .skip_minus
    skip_minus_patch = codebuf_offset(cb);
    cb = codebuf_emit_u32(cb, 0xB4000016)       # CBZ X22, placeholder;
    cb = arm64_mov_imm16(cb, 25, 45)            # MOV X25, #'-';
    cb = codebuf_emit_u32(cb, 0x38216A99)       # STRB W25, [X20, X21];
    cb = codebuf_emit_u32(cb, 0x910006B5)       # ADD X21, X21, #1;
    # .skip_minus
    skip_minus = codebuf_offset(cb);
    sm_off = (skip_minus - skip_minus_patch) / 4;
    cb = codebuf_patch_u32(cb, skip_minus_patch,
        0xB4000016 | ((sm_off & 0x7FFFF) << 5));

    # Reverse the digit string in-place
    cb = arm64_mov_imm16(cb, 23, 0)             # X23 = left = 0;
    cb = arm64_sub_rrr(cb, 24, 21, 0)           # X24 = right = X21 (len);
    cb = codebuf_emit_u32(cb, 0xD1000718)       # SUB X24, X24, #1;

    # .rev_loop
    rev_loop = codebuf_offset(cb);
    # CMP X23, X24
    cb = codebuf_emit_u32(cb, 0xEB18031F)       # CMP X23, X24;
    # B.GE .rev_done
    rev_done_patch = codebuf_offset(cb);
    cb = codebuf_emit_u32(cb, 0x5400000A)       # B.GE placeholder;

    # LDRB W25, [X20, X23]
    cb = codebuf_emit_u32(cb, 0x38776A99)       # LDRB W25, [X20, X23];
    # LDRB W26, [X20, X24]
    cb = codebuf_emit_u32(cb, 0x38786A9A)       # LDRB W26, [X20, X24];
    # STRB W26, [X20, X23]
    cb = codebuf_emit_u32(cb, 0x38376A9A)       # STRB W26, [X20, X23];
    # STRB W25, [X20, X24]
    cb = codebuf_emit_u32(cb, 0x38386A99)       # STRB W25, [X20, X24];
    # ADD X23, X23, #1
    cb = codebuf_emit_u32(cb, 0x910006F7)       # ADD X23, X23, #1;
    # SUB X24, X24, #1
    cb = codebuf_emit_u32(cb, 0xD1000718)       # SUB X24, X24, #1;
    # B .rev_loop
    rv_off = (rev_loop - codebuf_offset(cb)) / 4;
    cb = codebuf_emit_u32(cb, 0x14000000 | (rv_off & 0x03FFFFFF));

    # .rev_done
    rev_done = codebuf_offset(cb);
    rd_off = (rev_done - rev_done_patch) / 4;
    cb = codebuf_patch_u32(cb, rev_done_patch,
        0x5400000A | ((rd_off & 0x7FFFF) << 5))

    # Append newline: '\n' = 10
    cb = arm64_mov_imm16(cb, 25, 10);
    cb = codebuf_emit_u32(cb, 0x38216A99)       # STRB W25, [X20, X21];
    cb = codebuf_emit_u32(cb, 0x910006B5)       # ADD X21, X21, #1;

    # syscall write(1, X20, X21)
    cb = arm64_mov_imm16(cb, 0, 1)              # fd = stdout;
    cb = arm64_mov_rr(cb, 1, 20)                # buf;
    cb = arm64_mov_rr(cb, 2, 21)                # len;
    # MOV X16, #0x2000004 (SYS_WRITE with BSD offset)
    cb = arm64_mov_imm16(cb, 16, 4)             # low 16 bits;
    cb = codebuf_emit_u32(cb, 0xF2A04010)       # MOVK X16, #0x200, LSL#16;

    cb = arm64_svc(cb)                           # SVC #0x80;

    # Epilogue
    cb = arm64_ldp_post(cb, 29, 30, 31, 96)     # LDP X29, X30, [SP], #96;
    cb = arm64_ret(cb);

    print_size = codebuf_offset(cb) - print_offset;

    # ── _rt_exit: X0 = exit code (already in X0) ──
    exit_offset = codebuf_offset(cb);
    # MOV X16, #0x2000001 (SYS_EXIT with BSD offset)
    cb = arm64_mov_imm16(cb, 16, 1)             # low bits;
    cb = codebuf_emit_u32(cb, 0xF2A04010)       # MOVK X16, #0x200, LSL#16;
    cb = arm64_svc(cb)                           # SVC #0x80;

    out (cb, print_offset, exit_offset)
end.
# ═══════════════════════════════════════════════════════
# Module Codegen
# ═══════════════════════════════════════════════════════
# Emits all functions in a QModule into a single CodeBuf.
# Cross-function calls are resolved via the FuncLayout table.

func codegen_emit_module(m: QModule, arch: TargetArch):

    # Phase 1: Emit runtime stubs + all functions
    cb = codebuf_new(arch);
    layouts = []       # [FuncLayout];
    layout_count = 0;
    fixups = []        # [(patch_offset, func_idx)] for cross-func calls;
    fixup_count = 0;
    main_idx = -1;
    main_code_off = -1;

    # Emit runtime stubs first
    var (cb2, rt_print_off, rt_exit_off) = emit_runtime_arm64(cb);
    cb = cb2;
    runtime_size = codebuf_offset(cb);

    # Emit each function
    fi = 0;
    when fi < vec_len(m.functions) loop
        fn_obj = vec_get(m.functions, fi);
        func_start = codebuf_offset(cb);

        # Track main function (name is a fat-string under C-core)
        if fat_cstr_eq(fn_obj.name, "main") or fat_cstr_eq(fn_obj.name, "__main__") do
            main_idx = fi;
            main_code_off = func_start
        end

        # Detect if function needs a stack frame
        needs_frame = 0;
        ii = 0;
        when ii < vec_len(fn_obj.body) loop
            ins = vec_get(fn_obj.body, ii);
            op = ins.opcode;
            if op == QOp.Call or op == QOp.CallFunc or op == QOp.Print do
                needs_frame = 1
            end
            ii = ii + 1
        end

        # Emit prologue
        if needs_frame == 1 do
            cb = arm64_stp_pre(cb, 29, 30, 31, -16);
            cb = arm64_mov_rr(cb, 29, 31)
        end

        # Emit instructions
        ps = patch_new();
        j = 0;
        when j < vec_len(fn_obj.body) loop
            ins = vec_get(fn_obj.body, j);

            if ins.opcode == QOp.Nop do
                cb = arm64_nop(cb)

            eif ins.opcode == QOp.Load do
                rd = vreg_to_arm(ins.dest.vreg);
                if ins.src1.op_type == OperandType.Immediate do
                    cb = arm64_movz_imm64(cb, rd, ins.src1.imm_val as i64)
                end

            eif ins.opcode == QOp.Move do
                cb = arm64_mov_rr(cb, vreg_to_arm(ins.dest.vreg), vreg_to_arm(ins.src1.vreg))

            eif ins.opcode == QOp.Add do
                cb = arm64_add_rrr(cb, vreg_to_arm(ins.dest.vreg), vreg_to_arm(ins.src1.vreg), vreg_to_arm(ins.src2.vreg))

            eif ins.opcode == QOp.Sub do
                cb = arm64_sub_rrr(cb, vreg_to_arm(ins.dest.vreg), vreg_to_arm(ins.src1.vreg), vreg_to_arm(ins.src2.vreg))

            eif ins.opcode == QOp.Mul do
                cb = arm64_mul_rrr(cb, vreg_to_arm(ins.dest.vreg), vreg_to_arm(ins.src1.vreg), vreg_to_arm(ins.src2.vreg))

            eif ins.opcode == QOp.Div do
                cb = arm64_sdiv_rrr(cb, vreg_to_arm(ins.dest.vreg), vreg_to_arm(ins.src1.vreg), vreg_to_arm(ins.src2.vreg))

            eif ins.opcode == QOp.Mod do
                # ARM64: dest = src1 - (src1/src2)*src2
                rd = vreg_to_arm(ins.dest.vreg);
                rs1 = vreg_to_arm(ins.src1.vreg);
                rs2 = vreg_to_arm(ins.src2.vreg);
                cb = arm64_sdiv_rrr(cb, 17, rs1, rs2)           # X17 = X_s1 / X_s2;
                cb = codebuf_emit_u32(cb, 0x9B118000 | (rs1 << 10) | (17 << 5) | rd)  # MSUB rd, X17, rs2, rs1 → approximate;
                # Correct MSUB: 0x9B_Rm_1_Ra_Rn_Rd
                # MSUB Xd, Xn, Xm, Xa = Xa - Xn*Xm
                # We want: rd = rs1 - X17 * rs2
                # MSUB rd, X17, rs2, rs1 → rd = rs1 - X17*rs2
                # Encoding: 0x9B008000 | (Rm << 16) | (Ra << 10) | (Rn << 5) | Rd
                # Where: Rn=X17, Rm=rs2, Ra=rs1, Rd=rd
                # Recalculate
                msub = 0x9B008000 | (rs2 << 16) | (rs1 << 10) | (17 << 5) | rd;
                # Actually rewrite: emit SDIV + MSUB properly
                # We already emitted a wrong instruction. Let me fix by patching.
                cb.len = cb.len - 4   # remove the wrong MSUB;
                cb = codebuf_emit_u32(cb, msub)

            eif ins.opcode == QOp.CmpEq do
                cb = arm64_cmp_rr(cb, vreg_to_arm(ins.src1.vreg), vreg_to_arm(ins.src2.vreg));
                cb = arm64_cset_eq(cb, vreg_to_arm(ins.dest.vreg))

            eif ins.opcode == QOp.CmpGt do
                cb = arm64_cmp_rr(cb, vreg_to_arm(ins.src1.vreg), vreg_to_arm(ins.src2.vreg));
                cb = arm64_cset_gt(cb, vreg_to_arm(ins.dest.vreg))

            eif ins.opcode == QOp.CmpLt do
                cb = arm64_cmp_rr(cb, vreg_to_arm(ins.src1.vreg), vreg_to_arm(ins.src2.vreg));
                cb = arm64_cset_lt(cb, vreg_to_arm(ins.dest.vreg))

            eif ins.opcode == QOp.CmpGe do
                cb = arm64_cmp_rr(cb, vreg_to_arm(ins.src1.vreg), vreg_to_arm(ins.src2.vreg));
                cb = arm64_cset_ge(cb, vreg_to_arm(ins.dest.vreg))

            eif ins.opcode == QOp.CmpLe do
                cb = arm64_cmp_rr(cb, vreg_to_arm(ins.src1.vreg), vreg_to_arm(ins.src2.vreg));
                cb = arm64_cset_le(cb, vreg_to_arm(ins.dest.vreg))

            eif ins.opcode == QOp.And do
                cb = arm64_and_rrr(cb, vreg_to_arm(ins.dest.vreg), vreg_to_arm(ins.src1.vreg), vreg_to_arm(ins.src2.vreg))

            eif ins.opcode == QOp.Or do
                cb = arm64_orr_rrr(cb, vreg_to_arm(ins.dest.vreg), vreg_to_arm(ins.src1.vreg), vreg_to_arm(ins.src2.vreg))

            eif ins.opcode == QOp.Xor do
                cb = arm64_eor_rrr(cb, vreg_to_arm(ins.dest.vreg), vreg_to_arm(ins.src1.vreg), vreg_to_arm(ins.src2.vreg))

            eif ins.opcode == QOp.Shl do
                cb = arm64_lsl_rrr(cb, vreg_to_arm(ins.dest.vreg), vreg_to_arm(ins.src1.vreg), vreg_to_arm(ins.src2.vreg))

            eif ins.opcode == QOp.Shr do
                cb = arm64_asr_rrr(cb, vreg_to_arm(ins.dest.vreg), vreg_to_arm(ins.src1.vreg), vreg_to_arm(ins.src2.vreg))

            eif ins.opcode == QOp.Label do
                ps = patch_add_label(ps, ins.dest.label, codebuf_offset(cb))

            eif ins.opcode == QOp.Jump do
                if ins.dest.op_type == OperandType.LabelRef do
                    ps = patch_add_fixup(ps, codebuf_offset(cb), ins.dest.label, 0)
                end
                cb = arm64_b_imm26(cb, 0)

            eif ins.opcode == QOp.JumpIf do
                if ins.src1.op_type == OperandType.VReg do
                    cb = arm64_cmp_imm0(cb, vreg_to_arm(ins.src1.vreg))
                end
                if ins.src2.op_type == OperandType.LabelRef do
                    ps = patch_add_fixup(ps, codebuf_offset(cb), ins.src2.label, 1)
                end
                cb = arm64_bne_imm19(cb, 0)

            eif ins.opcode == QOp.JumpIfNot do
                if ins.src1.op_type == OperandType.VReg do
                    cb = arm64_cmp_imm0(cb, vreg_to_arm(ins.src1.vreg))
                end
                if ins.src2.op_type == OperandType.LabelRef do
                    ps = patch_add_fixup(ps, codebuf_offset(cb), ins.src2.label, 1)
                end
                cb = arm64_beq_imm19(cb, 0)

            eif ins.opcode == QOp.Call or ins.opcode == QOp.CallFunc do
                if ins.src1.op_type == OperandType.LabelRef do
                    ps = patch_add_fixup(ps, codebuf_offset(cb), ins.src1.label, 0)
                eif ins.src1.op_type == OperandType.FuncIdx do
                    # Record for module-level fixup (Phase 2)
                    fixups = fixups + [(codebuf_offset(cb), ins.src1.func_idx)];
                    fixup_count = fixup_count + 1
                end
                cb = arm64_bl_imm26(cb, 0)

            eif ins.opcode == QOp.Ret do
                if ins.src1.op_type == OperandType.VReg and vreg_to_arm(ins.src1.vreg) != 0 do
                    cb = arm64_mov_rr(cb, 0, vreg_to_arm(ins.src1.vreg))
                end
                if needs_frame == 1 do
                    cb = arm64_ldp_post(cb, 29, 30, 31, 16)
                end
                cb = arm64_ret(cb)

            eif ins.opcode == QOp.Print do
                # Move value to X0, then BL to _rt_print_i64
                if ins.src1.op_type == OperandType.VReg do
                    cb = arm64_mov_rr(cb, 0, vreg_to_arm(ins.src1.vreg))
                end
                print_bl_off = codebuf_offset(cb);
                delta = (rt_print_off - print_bl_off) / 4;
                cb = codebuf_emit_u32(cb, 0x94000000 | (delta & 0x03FFFFFF))

            eif ins.opcode == QOp.Exit do
                if ins.src1.op_type == OperandType.VReg do
                    cb = arm64_mov_rr(cb, 0, vreg_to_arm(ins.src1.vreg))
                end
                exit_bl_off = codebuf_offset(cb);
                delta = (rt_exit_off - exit_bl_off) / 4;
                cb = codebuf_emit_u32(cb, 0x94000000 | (delta & 0x03FFFFFF))

            eif ins.opcode == QOp.Halt do
                cb = arm64_mov_imm16(cb, 0, 0);
                cb = arm64_ret(cb)

            eif ins.opcode == QOp.LoadByte do
                cb = arm64_ldrb_reg(cb, vreg_to_arm(ins.dest.vreg), vreg_to_arm(ins.src1.vreg), vreg_to_arm(ins.src2.vreg))

            eif ins.opcode == QOp.StoreByte do
                cb = arm64_strb_reg(cb, vreg_to_arm(ins.dest.vreg), vreg_to_arm(ins.src1.vreg), vreg_to_arm(ins.src2.vreg))

            eif ins.opcode == QOp.LoadWord do
                cb = arm64_ldr_reg(cb, vreg_to_arm(ins.dest.vreg), vreg_to_arm(ins.src1.vreg), vreg_to_arm(ins.src2.vreg))

            eif ins.opcode == QOp.StoreWord do
                cb = arm64_str_reg(cb, vreg_to_arm(ins.dest.vreg), vreg_to_arm(ins.src1.vreg), vreg_to_arm(ins.src2.vreg))

            eif ins.opcode == QOp.PatchPoint do
                cb = arm64_nop(cb)

            else
                cb = arm64_nop(cb)
            end

            j = j + 1
        end

        # If function has no explicit RET, add one
        if vec_len(fn_obj.body) == 0 or vec_get(fn_obj.body, vec_len(fn_obj.body) - 1).opcode != QOp.Ret do
            if needs_frame == 1 do
                cb = arm64_ldp_post(cb, 29, 30, 31, 16)
            end
            cb = arm64_ret(cb)
        end

        # Back-patch intra-function jumps
        cb = backpatch_arm64(cb, ps);

        func_size = codebuf_offset(cb) - func_start;
        layouts = layouts + [FuncLayout (
        name:   fn_obj.name,
            offset: func_start,
            size:   func_size
        )];
        layout_count = layout_count + 1;

        fi = fi + 1
    end

    # Phase 2: Resolve cross-function calls
    fxi = 0;
    when fxi < fixup_count loop
        var (patch_at, target_idx) = fixups[fxi];
        if target_idx >= 0 and target_idx < layout_count do
            target_off = layouts[target_idx].offset;
            byte_offset = target_off - patch_at;
            imm26 = (byte_offset / 4) & 0x03FFFFFF;
            cb = codebuf_patch_u32(cb, patch_at, 0x94000000 | imm26)
        end
        fxi = fxi + 1
    end

    # Phase 3: Emit _start entry point
    # _start calls main(), then exits with return value
    start_offset = codebuf_offset(cb);
    cb.start_offset = start_offset;
    # STP X29, X30, [SP, #-16]!
    cb = arm64_stp_pre(cb, 29, 30, 31, -16);
    cb = arm64_mov_rr(cb, 29, 31);

    if main_code_off >= 0 do
        # BL to main function
        main_bl = codebuf_offset(cb);
        delta = (main_code_off - main_bl) / 4;
        cb = codebuf_emit_u32(cb, 0x94000000 | (delta & 0x03FFFFFF))
    else
        # No main found — return 0
        cb = arm64_mov_imm16(cb, 0, 0)
    end

    # Exit: BL _rt_exit
    exit_bl = codebuf_offset(cb);
    exit_delta = (rt_exit_off - exit_bl) / 4;
    cb = codebuf_emit_u32(cb, 0x94000000 | (exit_delta & 0x03FFFFFF));

    # LDP + RET (fallback, shouldn't reach)
    cb = arm64_ldp_post(cb, 29, 30, 31, 16);
    cb = arm64_ret(cb);

    out cb
end.
# ═══════════════════════════════════════════════════════
# Mach-O Executable Emitter
# ═══════════════════════════════════════════════════════
# Produces a minimal Mach-O ARM64 executable
#   __PAGEZERO + __TEXT (code) + LC_MAIN + LC_SYMTAB

func emit_macho_executable(code: CodeBuf):

    out_buf = buf_new();
    code_size = codebuf_offset(code) as i64;

    # Full dyld-linked layout (codesign / kernel require __LINKEDIT):
    #   PAGEZERO(72) + TEXT+sect(152) + LINKEDIT(72)
    #   + CHAINED_FIXUPS(16) + SYMTAB(24) + DYSYMTAB(80)
    #   + LOAD_DYLINKER(32) + UUID(24) + MAIN(24) + LOAD_DYLIB(56)
    # = 10 cmds, 552 bytes
    ncmds = 10 as i64;
    cmds_size = 552 as i64;
    header_end = 32 + cmds_size;
    code_offset = header_end + 32;

    entry_in_code = code.start_offset;
    if entry_in_code < 0 do
        entry_in_code = 0
    end
    if entry_in_code >= code_size do
        entry_in_code = 0
    end
    entryoff = code_offset + entry_in_code;

    text_raw = code_offset + code_size;
    text_filesize = ((text_raw + PAGE_SIZE - 1) / PAGE_SIZE) * PAGE_SIZE;

    chained_fixups_size = 48 as i64;
    string_table_size = 4 as i64;
    linkedit_data_size = chained_fixups_size + string_table_size;
    linkedit_fileoff = text_filesize;
    linkedit_vmaddr = TEXT_BASE + text_filesize;
    strtab_off = linkedit_fileoff + chained_fixups_size;

    # ── Mach-O Header (32 bytes) ──
    out_buf = buf_write_u8(out_buf, 0xCF);
    out_buf = buf_write_u8(out_buf, 0xFA);
    out_buf = buf_write_u8(out_buf, 0xED);
    out_buf = buf_write_u8(out_buf, 0xFE);
    out_buf = buf_write_u8(out_buf, 0x0C);
    out_buf = buf_write_u8(out_buf, 0x00);
    out_buf = buf_write_u8(out_buf, 0x00);
    out_buf = buf_write_u8(out_buf, 0x01);
    out_buf = buf_write_u32_le(out_buf, 0);
    out_buf = buf_write_u32_le(out_buf, 2);
    out_buf = buf_write_u32_le(out_buf, ncmds);
    out_buf = buf_write_u32_le(out_buf, cmds_size);
    out_buf = buf_write_u32_le(out_buf, MH_FLAGS);
    out_buf = buf_write_u32_le(out_buf, 0);

    # ── 1. __PAGEZERO ──
    out_buf = buf_write_u32_le(out_buf, LC_SEGMENT_64);
    out_buf = buf_write_u32_le(out_buf, 72);
    out_buf = buf_write_cstr_padded(out_buf, "__PAGEZERO", 16);
    out_buf = buf_write_u64_le(out_buf, 0);
    out_buf = buf_write_u64_le(out_buf, TEXT_BASE);
    out_buf = buf_write_u64_le(out_buf, 0);
    out_buf = buf_write_u64_le(out_buf, 0);
    out_buf = buf_write_u32_le(out_buf, 0);
    out_buf = buf_write_u32_le(out_buf, 0);
    out_buf = buf_write_u32_le(out_buf, 0);
    out_buf = buf_write_u32_le(out_buf, 0);

    # ── 2. __TEXT + __text ──
    out_buf = buf_write_u32_le(out_buf, LC_SEGMENT_64);
    out_buf = buf_write_u32_le(out_buf, 152);
    out_buf = buf_write_cstr_padded(out_buf, "__TEXT", 16);
    out_buf = buf_write_u64_le(out_buf, TEXT_BASE);
    out_buf = buf_write_u64_le(out_buf, text_filesize);
    out_buf = buf_write_u64_le(out_buf, 0);
    out_buf = buf_write_u64_le(out_buf, text_filesize);
    out_buf = buf_write_u32_le(out_buf, 5);
    out_buf = buf_write_u32_le(out_buf, 5);
    out_buf = buf_write_u32_le(out_buf, 1);
    out_buf = buf_write_u32_le(out_buf, 0);

    out_buf = buf_write_cstr_padded(out_buf, "__text", 16);
    out_buf = buf_write_cstr_padded(out_buf, "__TEXT", 16);
    out_buf = buf_write_u64_le(out_buf, TEXT_BASE + code_offset);
    out_buf = buf_write_u64_le(out_buf, code_size);
    out_buf = buf_write_u32_le(out_buf, code_offset);
    out_buf = buf_write_u32_le(out_buf, 2);
    out_buf = buf_write_u32_le(out_buf, 0);
    out_buf = buf_write_u32_le(out_buf, 0);
    out_buf = buf_write_u32_le(out_buf, 0x80000400);
    out_buf = buf_write_u32_le(out_buf, 0);
    out_buf = buf_write_u32_le(out_buf, 0);
    out_buf = buf_write_u32_le(out_buf, 0);

    # ── 3. __LINKEDIT ──
    out_buf = buf_write_u32_le(out_buf, LC_SEGMENT_64);
    out_buf = buf_write_u32_le(out_buf, 72);
    out_buf = buf_write_cstr_padded(out_buf, "__LINKEDIT", 16);
    out_buf = buf_write_u64_le(out_buf, linkedit_vmaddr);
    out_buf = buf_write_u64_le(out_buf, PAGE_SIZE);
    out_buf = buf_write_u64_le(out_buf, linkedit_fileoff);
    out_buf = buf_write_u64_le(out_buf, linkedit_data_size);
    out_buf = buf_write_u32_le(out_buf, 1);
    out_buf = buf_write_u32_le(out_buf, 1);
    out_buf = buf_write_u32_le(out_buf, 0);
    out_buf = buf_write_u32_le(out_buf, 0);

    # ── 4. LC_DYLD_CHAINED_FIXUPS ──
    out_buf = buf_write_u32_le(out_buf, LC_DYLD_CHAINED_FIXUPS);
    out_buf = buf_write_u32_le(out_buf, 16);
    out_buf = buf_write_u32_le(out_buf, linkedit_fileoff);
    out_buf = buf_write_u32_le(out_buf, chained_fixups_size);

    # ── 5. LC_SYMTAB ──
    out_buf = buf_write_u32_le(out_buf, LC_SYMTAB);
    out_buf = buf_write_u32_le(out_buf, 24);
    out_buf = buf_write_u32_le(out_buf, strtab_off);
    out_buf = buf_write_u32_le(out_buf, 0);
    out_buf = buf_write_u32_le(out_buf, strtab_off);
    out_buf = buf_write_u32_le(out_buf, string_table_size);

    # ── 6. LC_DYSYMTAB (80 bytes) ──
    out_buf = buf_write_u32_le(out_buf, LC_DYSYMTAB);
    out_buf = buf_write_u32_le(out_buf, 80);
    dsi = 0;
    when dsi < 18 loop
        out_buf = buf_write_u32_le(out_buf, 0);
        dsi = dsi + 1
    end

    # ── 7. LC_LOAD_DYLINKER ──
    out_buf = buf_write_u32_le(out_buf, LC_LOAD_DYLINKER);
    out_buf = buf_write_u32_le(out_buf, 32);
    out_buf = buf_write_u32_le(out_buf, 12);
    out_buf = buf_write_cstr_padded(out_buf, "/usr/lib/dyld", 20);

    # ── 8. LC_UUID ──
    out_buf = buf_write_u32_le(out_buf, LC_UUID);
    out_buf = buf_write_u32_le(out_buf, 24);
    ui = 1;
    when ui <= 16 loop
        out_buf = buf_write_u8(out_buf, ui);
        ui = ui + 1
    end

    # ── 9. LC_MAIN ──
    out_buf = buf_write_u32_le(out_buf, LC_MAIN);
    out_buf = buf_write_u32_le(out_buf, 24);
    out_buf = buf_write_u64_le(out_buf, entryoff);
    out_buf = buf_write_u64_le(out_buf, 0);

    # ── 10. LC_LOAD_DYLIB (libSystem) ──
    out_buf = buf_write_u32_le(out_buf, LC_LOAD_DYLIB);
    out_buf = buf_write_u32_le(out_buf, 56);
    out_buf = buf_write_u32_le(out_buf, 24);
    out_buf = buf_write_u32_le(out_buf, 0);
    out_buf = buf_write_u32_le(out_buf, 0x00010000);
    out_buf = buf_write_u32_le(out_buf, 0x00010000);
    out_buf = buf_write_cstr_padded(out_buf, "/usr/lib/libSystem.B.dylib", 32);

    # ── Pad to code_offset (fixed layout — do not use buf_size) ──
    pad_i = 0;
    pad_n = code_offset - (32 + cmds_size);
    when pad_i < pad_n loop
        out_buf = buf_write_u8(out_buf, 0);
        pad_i = pad_i + 1
    end

    # ── Code ──
    ci = 0;
    when ci < code_size loop
        b = bvec_get(code.data, ci);
        out_buf = buf_write_u8(out_buf, b);
        ci = ci + 1
    end

    # ── Pad __TEXT to page ──
    code_pad = text_filesize - code_offset - code_size;
    if code_pad > 0 do
        out_buf = buf_write_zeros(out_buf, code_pad as i64)
    end

    # ── LINKEDIT: chained fixups (48) + strtab (4) ──
    out_buf = buf_write_u32_le(out_buf, 0);
    out_buf = buf_write_u32_le(out_buf, 28);
    out_buf = buf_write_u32_le(out_buf, 44);
    out_buf = buf_write_u32_le(out_buf, 44);
    out_buf = buf_write_u32_le(out_buf, 0);
    out_buf = buf_write_u32_le(out_buf, 1);
    out_buf = buf_write_u32_le(out_buf, 0);
    out_buf = buf_write_u32_le(out_buf, 3);
    out_buf = buf_write_u32_le(out_buf, 0);
    out_buf = buf_write_u32_le(out_buf, 0);
    out_buf = buf_write_u32_le(out_buf, 0);
    out_buf = buf_write_u32_le(out_buf, 0);
    out_buf = buf_write_u32_le(out_buf, 0);

    out out_buf
end.

# Emit with known _start offset
func emit_macho_with_entry(code: CodeBuf, start_offset: int):

    out_buf = emit_macho_executable(code);

    # Patch LC_MAIN entryoff
    # LC_MAIN is at offset: 32 (header) + 72 (PAGEZERO) + 152 (TEXT+sect) + 8 (cmd+cmdsize)
    # = 264
    lc_main_entryoff = 264 as i64;
    # Entry offset in file = header_plus_cmds + start_offset
    header_plus_cmds = 304 as i64       # 32 + 72 + 152 + 24 + 24 = 304;

    # The entryoff field is at byte 264 (after cmd and cmdsize)
    # Entryoff = file offset relative to __TEXT vmaddr mapping
    # Since __TEXT maps from file offset 0 with vmaddr TEXT_BASE,
    # entryoff = header_plus_cmds + start_offset
    # No — LC_MAIN.entryoff is relative to __TEXT file offset which is 0
    # So entryoff = offset of _start code in the file = header_plus_cmds + start_offset

    # Actually looking at Apple docs: LC_MAIN.entryoff is the file offset
    # of the entry point from the start of the __TEXT segment.
    # __TEXT segment starts at file offset 0, so entryoff = header_plus_cmds + start_offset

    # Patch the entry offset in the output buffer
    # LC_MAIN starts at offset 256 (32+72+152), entryoff is at +8
    entry_patch_off = 32 + 72 + 152 + 8;
    entryoff_val = header_plus_cmds + start_offset;

    # Write little-endian u64 at entry_patch_off
    out_buf.data = vec_set_at(out_buf.data, entry_patch_off, (entryoff_val & 0xFF) as i64);
    out_buf.data = vec_set_at(out_buf.data, entry_patch_off + 1, ((entryoff_val shr 8) & 0xFF) as i64);
    out_buf.data = vec_set_at(out_buf.data, entry_patch_off + 2, ((entryoff_val shr 16) & 0xFF) as i64);
    out_buf.data = vec_set_at(out_buf.data, entry_patch_off + 3, ((entryoff_val shr 24) & 0xFF) as i64);
    out_buf.data = vec_set_at(out_buf.data, entry_patch_off + 4, 0);
    out_buf.data = vec_set_at(out_buf.data, entry_patch_off + 5, 0);
    out_buf.data = vec_set_at(out_buf.data, entry_patch_off + 6, 0);
    out_buf.data = vec_set_at(out_buf.data, entry_patch_off + 7, 0);

    out out_buf
end.
# ═══════════════════════════════════════════════════════
# Compile Pipeline
# ═══════════════════════════════════════════════════════

# Write ByteBuffer bytes to an already-opened builtin file handle.
func write_buf_to_file(f: int, buf: ByteBuffer):
    wi = 0;
    n = buf_size(buf);
    when wi < n loop
        b = buf_get_u8(buf, wi);
        file_write_byte(f, b);
        wi = wi + 1
    end
end.

func compile(source: string, output_path: string):

    # Step 1: Tokenize
    print "virc: tokenizing...";
    lex = lexer_new(source);
    lex = tokenize(lex);

    if fat_str_len(lex.error_msg) > 0 do
        print "virc: lex error";
        out 1
    end

    tok_count = vec_len(lex.tokens);

    # Parser expects rt-vec of token pointers; lexer uses collections Vec.
    tok_rt = vec_new_rt();
    ti = 0;
    when ti < tok_count loop
        tok = vec_get(lex.tokens, ti);
        tok_rt = vec_push_rt(tok_rt, tok);
        ti = ti + 1
    end

    # Step 2: Parse
    print "virc: parsing...";
    parser = parser_new(tok_rt);
    var (parser2, ast) = parse_program(parser);

    if ast.node_type == AstType.Program and vec_len_rt(ast.children) == 0 do
        print "virc: parse produced empty program";
        out 1
    end

    # Step 3: Lower
    print "virc: lowering...";
    ctx = compile_pipeline("", ast, 0);

    if ctx.error_count > 0 do
        print "virc: lower error";
        out 1
    end

    func_count = vec_len(ctx.prog.functions);
    if func_count == 0 do
        print "virc: no functions lowered";
        out 1
    end

    # Step 4: Optimize (identity under C-core bootstrap)
    print "virc: optimizing...";
    ctx.prog = optimize_module(ctx.prog);

    # Step 5: Code generation (ARM64)
    print "virc: generating ARM64 machine code...";
    code = codegen_emit_module(ctx.prog, TargetArch.ARM64);
    code_size = codebuf_offset(code);

    # Step 6: Link into Mach-O executable
    print "virc: linking Mach-O ARM64 executable...";
    binary = emit_macho_executable(code);

    # Step 7: Write output (C-core: output_path is a C string from get_arg)
    print "virc: writing...";
    f = file_open(output_path, "w");
    if f == 0 do
        print "virc: error_msg: cannot create output file";
        out 1
    end

    file_size = buf_size(binary);
    write_buf_to_file(f, binary);
    file_close(f);

    print "virc: done";
    print file_size;
    out 0
end.
# ═══════════════════════════════════════════════════════
# Main Entry Point
# ═══════════════════════════════════════════════════════

func main:
    print "╔══════════════════════════════════════════════╗";
    print "║  virc — Vir Self-Hosting Compiler v2.0      ║";
    print "║  Phase 5: Bootstrap Binary                   ║";
    print "╚══════════════════════════════════════════════╝";

    if arg_count() < 1 do
        print "Usage: virc <input.vri> [-o output]";
        print "";
        print "Compiles a Vir source file to a standalone";
        print "Mach-O ARM64 binary. No Python, no C runtime.";
        out 1
    end

    input_path = get_arg(0);
    output_path = "a.out";

    # Parse -o flag
    if arg_count() >= 3 do
        if rt_streq(get_arg(1), "-o") do
            output_path = get_arg(2)
        end
    end

    # Read source file (C-core: get_arg returns C strings; use builtin file I/O)
    print "virc: reading...";
    f = file_open(input_path, "r");
    if f == 0 do
        print "virc: error_msg: cannot open input";
        out 1
    end

    source_cstr = file_read(f);
    file_close(f);

    if source_cstr == 0 do
        out 1
    end

    # Builtin file_read returns a C string; lexer expects .byte_len via str_from_cstr.
    source = str_from_cstr(source_cstr);

    # Compile!
    result = compile(source, output_path);
    out result
end.
export compile, main, codegen_emit_module, emit_runtime_arm64, emit_macho_executable, emit_macho_with_entry, FuncLayout;
