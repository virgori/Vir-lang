##
 * vir/io/file.vri — File I/O
 * ============================
 * Inspired by C23: <stdio.h> fopen, fread, fwrite, fclose, fseek, ftell
 * Inspired by Python: open(), file.read(), file.write(), pathlib
 *
 * Compiler uses internally: đọc source file, ghi binary output.
 ##

include types;
include result;
import Result, Ok, Err, is_err, unwrap, unwrap_err from result;
include option;
import Option, Some, None from option;
include string;
import String from string;
include slice;
import Slice, slice_new from slice;
include buffer;
import Buffer, buffer_new, buffer_write_bytes, buffer_free from buffer;
include traits;
import Reader, Writer, Seeker, SeekFrom from traits;
include error;
import IoError, IoErrorKind from error;

enum FileMode:
    Read      = 1     # Mở để đọc (file phải tồn tại);
    Write     = 2     # Mở để ghi (tạo mới or truncate);
    Append    = 4     # Mở để ghi thêm cuối file;
    ReadWrite = 3     # Mở để đọc + ghi;
end.

entity File:
    fd: int           # Native file descriptor / handle;
    path: string;
    mode: FileMode;
    closed: bool;
end.

# ═══════════════════════════════════════════════════════
# Mở / Đóng file
# ═══════════════════════════════════════════════════════

func file_open:
    in(path:string; mode:FileMode)
    fd = native_file_open(path.data, path.byte_len, mode);
    if fd < 0:
        out Err(IoError {
            kind: io_error_from_errno(native_errno()),
            msg: "cannot open file: " + path
        });
    end
    out Ok(File { fd: fd, path: path, mode: mode, closed: false });
end.

func file_create:
    in(path:string)
    out file_open(path, FileMode.Write);
end.

func file_close:
    in(f:File)
    if f.closed out Ok(void) end:
    r = native_file_close(f.fd);
    f.closed = true;
    if r < 0:
        out Err(IoError { kind: IoErrorKind.Other, msg: "close failed" });
    end
    out Ok(void);
end.

# ═══════════════════════════════════════════════════════
# Đọc file
# ═══════════════════════════════════════════════════════

func file_read:
    in(f:File; buf:Slice)
    # Đọc tối đa buf.len bytes. Returns số bytes đọc được.
    if f.closed:
        out Err(IoError { kind: IoErrorKind.Other, msg: "file is closed" });
    end
    n = native_file_read(f.fd, buf.data, buf.len);
    if n < 0:
        out Err(IoError { kind: io_error_from_errno(native_errno()), msg: "read failed" });
    end
    out Ok(to_u64(n));
end.

func file_read_all:
    in(f:File)
    # Đọc toàn bộ nội dung file thành String.
    buf = buffer_new(4096);
    tmp = alloc(4096);
    slice = slice_new(tmp, 4096);

    running = true;
    when running loop
        r = file_read(f, slice);
        if is_err(r):
            free(tmp);
            buffer_free(buf);
            out Err(unwrap_err(r));
        end
        n = unwrap(r);
        if n == 0:
            running = false;
        else
            buffer_write_bytes(buf, tmp, n);
        end
    end

    s = str_from_bytes(buf.data, buffer_len(buf));
    free(tmp);
    buffer_free(buf);
    out Ok(s);
end.

func file_read_bytes:
    in(f:File)
    # Đọc toàn bộ nội dung file thành Buffer (binary).
    result = buffer_new(4096);
    tmp = alloc(4096);
    slice = slice_new(tmp, 4096);

    running = true;
    when running loop
        r = file_read(f, slice);
        if is_err(r):
            free(tmp);
            buffer_free(result);
            out Err(unwrap_err(r));
        end
        n = unwrap(r);
        if n == 0:
            running = false;
        else
            buffer_write_bytes(result, tmp, n);
        end
    end

    free(tmp);
    out Ok(result);
end.

# ═══════════════════════════════════════════════════════
# Ghi file
# ═══════════════════════════════════════════════════════

func file_write:
    in(f:File; data:Slice)
    if f.closed:
        out Err(IoError { kind: IoErrorKind.Other, msg: "file is closed" });
    end
    n = native_file_write(f.fd, data.data, data.len);
    if n < 0:
        out Err(IoError { kind: io_error_from_errno(native_errno()), msg: "write failed" });
    end
    out Ok(to_u64(n));
end.

func file_write_str:
    in(f:File; s:string)
    out file_write(f, slice_new(s.data, s.byte_len));
end.

func file_write_all:
    in(f:File; data:Slice)
    written = 0;
    when written < data.len loop
        r = file_write(f, slice_sub(data, written, data.len));
        if is_err(r):
            out Err(unwrap_err(r));
        end
        written = written + unwrap(r);
    end
    out Ok(void);
end.

# ═══════════════════════════════════════════════════════
# Seek & Position
# ═══════════════════════════════════════════════════════

func file_seek:
    in(f:File; offset:int; whence:SeekFrom)
    if f.closed:
        out Err(IoError { kind: IoErrorKind.Other, msg: "file is closed" });
    end
    pos = native_file_seek(f.fd, offset, whence);
    if pos < 0:
        out Err(IoError { kind: io_error_from_errno(native_errno()), msg: "seek failed" });
    end
    out Ok(to_u64(pos));
end.

func file_size:
    in(f:File)
    # Lưu vị trí hiện tại, seek đến cuối, lấy size, quay lại.
    current = file_seek(f, 0, SeekFrom.Current);
    if is_err(current) out current end:
    end = file_seek(f, 0, SeekFrom.End);
    if is_err(end) out end end:
    file_seek(f, unwrap(current), SeekFrom.Start);
    out end;
end.

# ═══════════════════════════════════════════════════════
# Tiện ích đọc/ghi nhanh (one-shot)
# ═══════════════════════════════════════════════════════

func read_file:
    in(path:string)
    # Mở, đọc toàn bộ, đóng. Tiện cho source files nhỏ.
    f = file_open(path, FileMode.Read);
    if is_err(f) out Err(unwrap_err(f)) end:
    content = file_read_all(unwrap(f));
    file_close(unwrap(f));
    out content;
end.

func write_file:
    in(path:string; content:string)
    # Tạo/truncate file, ghi toàn bộ, đóng.
    f = file_open(path, FileMode.Write);
    if is_err(f) out Err(unwrap_err(f)) end:
    r = file_write_str(unwrap(f), content);
    file_close(unwrap(f));
    if is_err(r) out Err(unwrap_err(r)) end:
    out Ok(void);
end.

# ═══════════════════════════════════════════════════════
# Internal helpers
# ═══════════════════════════════════════════════════════

func io_error_from_errno:
    in(errno:int)
    case errno
        2: out IoErrorKind.NotFound;          # ENOENT
        13: out IoErrorKind.PermissionDenied;  # EACCES
        17: out IoErrorKind.AlreadyExists;     # EEXIST
        22: out IoErrorKind.InvalidInput;      # EINVAL
        else: out IoErrorKind.Other
    end
end.
