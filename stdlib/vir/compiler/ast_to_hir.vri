##
 * vir/compiler/ast_to_hir.vri — AST to HIR Lowering (Vir v2.0)
 * =============================================================
 * Constructs full-fidelity High-Level IR from Parser AST.
 ##

include types;
include vec_rt;
import vec_new_rt, vec_push_rt, vec_get_rt, vec_len_rt, vec_set_rt from vec_rt;

include string_rt;
import fat_str_eq, fat_str_len, native_read_i64, native_write_i64 from string_rt;

include parser;
import AstNode, AstType, OpType from parser;

include hir;
import HirKind, HirNode, HirFunc, hir_new, hir_add_arg, hir_add_stmt, hir_func_new from hir;

include ast_to_mir;
import ast_node_name, ast_node_name2, ast_node_type_of, ast_node_op_of, ast_node_line, ast_node_int_val, ast_node_child, ast_node_child_count, ast_node_builtin_id, set_global_prog_ast from ast_to_mir;

func ast_to_hir_expr(expr: AstNode):
    if (expr as i64) == 0 do
        out (0 as HirNode)
    end
    t = ast_node_type_of(expr);

    # 1. Literal Int / Float
    if t == AstType.LiteralInt or t == AstType.LiteralFloat do
        node = hir_new(HirKind.Const, 0);
        node.imm_val = ast_node_int_val(expr);
        node.line = ast_node_line(expr);
        out node
    end

    # 2. Literal String
    if t == AstType.LiteralStr do
        node = hir_new(HirKind.StrLit, 0);
        node.name = ast_node_name(expr);
        node.line = ast_node_line(expr);
        out node
    end

    # 3. Identifier
    if t == AstType.Identifier do
        node = hir_new(HirKind.Load, 0);
        node.name = ast_node_name(expr);
        node.line = ast_node_line(expr);
        out node
    end

    # 4. Binary Operation & Comparison
    if t == AstType.BinOp or t == AstType.Compare do
        node = hir_new(HirKind.BinOp, 0);
        node.op = ast_node_op_of(expr) as i64;
        node.line = ast_node_line(expr);
        n = ast_node_child_count(expr);
        if n >= 2 do
            node.left_node = ast_to_hir_expr(ast_node_child(expr, 0)) as i64;
            node.right_node = ast_to_hir_expr(ast_node_child(expr, 1)) as i64;
        end
        out node
    end

    # 5. Unary Minus
    if t == AstType.UnaryMinus do
        node = hir_new(HirKind.UnaryOp, 0);
        node.op = 0; # Unary minus
        node.line = ast_node_line(expr);
        n = ast_node_child_count(expr);
        if n >= 1 do
            node.left_node = ast_to_hir_expr(ast_node_child(expr, 0)) as i64;
        end
        out node
    end

    # 5b. Unary Not (bitwise `~`)
    if t == AstType.UnaryNot do
        node = hir_new(HirKind.UnaryOp, 0);
        node.op = 27; # Not
        node.line = ast_node_line(expr);
        n = ast_node_child_count(expr);
        if n >= 1 do
            node.left_node = ast_to_hir_expr(ast_node_child(expr, 0)) as i64;
        end
        out node
    end

    # 5c. AddrOf (`&` / `&mut`)
    if t == AstType.AddrOf do
        node = hir_new(HirKind.UnaryOp, 0);
        node.op = 25; # AddrOf
        node.name = ast_node_name(expr);
        node.line = ast_node_line(expr);
        n = ast_node_child_count(expr);
        if n >= 1 do
            node.left_node = ast_to_hir_expr(ast_node_child(expr, 0)) as i64;
        end
        out node
    end

    # 5c. Cast Expression (`expr as Type`)
    if t == AstType.CastExpr do
        n = ast_node_child_count(expr);
        if n >= 1 do
            out ast_to_hir_expr(ast_node_child(expr, 0))
        end
    end

    # 6. Function Call & Builtin Call & Method Call
    if t == AstType.Call or t == AstType.BuiltinCall or t == AstType.MethodCall do
        k = HirKind.Call;
        if t == AstType.BuiltinCall do
            k = HirKind.BuiltinCall;
        end
        node = hir_new(k, 0);
        node.name = ast_node_name(expr);
        node.imm_val = ast_node_builtin_id(expr) as i64;
        node.line = ast_node_line(expr);
        n = ast_node_child_count(expr);
        var i = 0;
        when i < n loop
            arg_h = ast_to_hir_expr(ast_node_child(expr, i));
            node = hir_add_arg(node, arg_h);
            i = i + 1
        end
        out node
    end

    # 7. Field Access (obj.field)
    if t == AstType.FieldAccess do
        node = hir_new(HirKind.FieldAccess, 0);
        node.name = ast_node_name(expr); # field name
        node.line = ast_node_line(expr);
        n = ast_node_child_count(expr);
        if n >= 1 do
            node.left_node = ast_to_hir_expr(ast_node_child(expr, 0)) as i64;
        end
        out node
    end

    # 8. Index Access (arr[i])
    if t == AstType.IndexAccess or t == AstType.ExprIndex do
        node = hir_new(HirKind.IndexAccess, 0);
        node.line = ast_node_line(expr);
        n = ast_node_child_count(expr);
        if n >= 2 do
            node.left_node = ast_to_hir_expr(ast_node_child(expr, 0)) as i64;
            node.right_node = ast_to_hir_expr(ast_node_child(expr, 1)) as i64;
        else
            node.name = ast_node_name(expr);
            if n >= 1 do
                node.right_node = ast_to_hir_expr(ast_node_child(expr, 0)) as i64;
            end
        end
        out node
    end

    # 9. Aggregate Literals (Entity, Array, Tuple)
    if t == AstType.EntityLiteral or t == AstType.ArrayLiteral or t == AstType.TupleExpr do
        node = hir_new(HirKind.Aggregate, 0);
        node.name = ast_node_name(expr);
        node.imm_val = t as i64;
        node.line = ast_node_line(expr);
        n = ast_node_child_count(expr);
        var i = 0;
        when i < n loop
            elem_h = ast_to_hir_expr(ast_node_child(expr, i));
            node = hir_add_arg(node, elem_h);
            i = i + 1
        end
        out node
    end

    out (0 as HirNode)
end.

func ast_to_hir_stmt(stmt: AstNode):
    if (stmt as i64) == 0 do
        out (0 as HirNode)
    end
    t = ast_node_type_of(stmt);

    # 1. Block
    if t == AstType.Block do
        node = hir_new(HirKind.Block, 0);
        node.line = ast_node_line(stmt);
        n = ast_node_child_count(stmt);
        var i = 0;
        when i < n loop
            s_h = ast_to_hir_stmt(ast_node_child(stmt, i));
            if (s_h as i64) != 0 do
                node = hir_add_stmt(node, s_h);
            end
            i = i + 1
        end
        out node
    end

    # 2. Variable / Constant Declaration
    if t == AstType.VarDecl or t == AstType.ConstDecl do
        node = hir_new(HirKind.VarDecl, 0);
        node.name = ast_node_name(stmt);
        node.line = ast_node_line(stmt);
        n = ast_node_child_count(stmt);
        if n >= 1 do
            node.left_node = ast_to_hir_expr(ast_node_child(stmt, 0)) as i64;
        end
        out node
    end

    # 3. Simple Assignment (var = val)
    if t == AstType.Assign do
        node = hir_new(HirKind.Store, 0);
        node.name = ast_node_name(stmt);
        node.line = ast_node_line(stmt);
        n = ast_node_child_count(stmt);
        if n >= 1 do
            node.left_node = ast_to_hir_expr(ast_node_child(stmt, 0)) as i64;
        end
        out node
    end

    # 4. Field Assignment (obj.field = val)
    if t == AstType.FieldAssign do
        node = hir_new(HirKind.FieldStore, 0);
        node.name = ast_node_name(stmt);  # obj name
        node.name2 = ast_node_name2(stmt); # field name
        node.line = ast_node_line(stmt);
        n = ast_node_child_count(stmt);
        if n >= 1 do
            node.left_node = ast_to_hir_expr(ast_node_child(stmt, 0)) as i64;
        end
        out node
    end

    # 5. Index Assignment (arr[idx] = val)
    if t == AstType.IndexAssign do
        node = hir_new(HirKind.IndexStore, 0);
        node.name = ast_node_name(stmt);
        node.line = ast_node_line(stmt);
        n = ast_node_child_count(stmt);
        if n >= 2 do
            node.left_node = ast_to_hir_expr(ast_node_child(stmt, 0)) as i64; # index
            node.right_node = ast_to_hir_expr(ast_node_child(stmt, 1)) as i64; # val
        end
        out node
    end

    # 6. If Statement
    if t == AstType.IfStmt do
        node = hir_new(HirKind.If, 0);
        node.line = ast_node_line(stmt);
        n = ast_node_child_count(stmt);
        if n >= 2 do
            node.cond_node = ast_to_hir_expr(ast_node_child(stmt, 0)) as i64;
            node.then_block = ast_to_hir_stmt(ast_node_child(stmt, 1)) as i64;
            if n >= 3 do
                node.else_block = ast_to_hir_stmt(ast_node_child(stmt, 2)) as i64;
            end
        end
        out node
    end

    # 7. Loop / When Statement
    if t == AstType.LoopStmt or t == AstType.WhenStmt or t == AstType.WhileStmt do
        node = hir_new(HirKind.Loop, 0);
        node.line = ast_node_line(stmt);
        n = ast_node_child_count(stmt);
        if n >= 2 do
            node.cond_node = ast_to_hir_expr(ast_node_child(stmt, 0)) as i64;
            node.then_block = ast_to_hir_stmt(ast_node_child(stmt, 1)) as i64;
        end
        out node
    end

    # 8. Return Statement (out / return)
    if t == AstType.ReturnStmt do
        node = hir_new(HirKind.Return, 0);
        node.line = ast_node_line(stmt);
        n = ast_node_child_count(stmt);
        if n >= 1 do
            node.left_node = ast_to_hir_expr(ast_node_child(stmt, 0)) as i64;
        end
        out node
    end

    # 9. Break & Continue
    if t == AstType.BreakStmt do
        node = hir_new(HirKind.Break, 0);
        node.line = ast_node_line(stmt);
        out node
    end
    if t == AstType.ContinueStmt do
        node = hir_new(HirKind.Continue, 0);
        node.line = ast_node_line(stmt);
        out node
    end

    # 10. Print Statement
    if t == AstType.PrintStmt do
        node = hir_new(HirKind.Print, 0);
        node.line = ast_node_line(stmt);
        n = ast_node_child_count(stmt);
        if n >= 1 do
            node.left_node = ast_to_hir_expr(ast_node_child(stmt, 0)) as i64;
        end
        out node
    end

    # 11. SAGA & Arena Blocks & Statements (Ensure, Revert, Try, Arena, Throw, Resume, Emit)
    if t == AstType.ArenaBlock do
        node = hir_new(HirKind.Block, 0);
        node.name = "__mir_arena_block";
        node.line = ast_node_line(stmt);
        n = ast_node_child_count(stmt);
        if n >= 1 do
            body_ch = ast_node_child(stmt, n - 1);
            sh = ast_to_hir_stmt(body_ch);
            if (sh as i64) != 0 do
                node = hir_add_stmt(node, sh);
            end
        end
        out node
    end

    if t == AstType.EnsureBlock do
        node = hir_new(HirKind.Block, 0);
        node.line = ast_node_line(stmt);
        m_ens = hir_new(HirKind.Call, 0);
        m_ens.name = "__mir_ensure";
        node = hir_add_stmt(node, m_ens);
        n = ast_node_child_count(stmt);
        if n >= 1 do
            sh = ast_to_hir_stmt(ast_node_child(stmt, 0));
            if (sh as i64) != 0 do
                node = hir_add_stmt(node, sh);
            end
        end
        out node
    end

    if t == AstType.RevertBlock do
        node = hir_new(HirKind.Block, 0);
        node.line = ast_node_line(stmt);
        m_rev = hir_new(HirKind.Call, 0);
        m_rev.name = "__mir_revert";
        node = hir_add_stmt(node, m_rev);
        n = ast_node_child_count(stmt);
        if n >= 1 do
            sh = ast_to_hir_stmt(ast_node_child(stmt, 0));
            if (sh as i64) != 0 do
                node = hir_add_stmt(node, sh);
            end
        end
        out node
    end

    if t == AstType.TryStmt do
        node = hir_new(HirKind.Block, 0);
        node.line = ast_node_line(stmt);
        m_try = hir_new(HirKind.Call, 0);
        m_try.name = "__mir_try";
        node = hir_add_stmt(node, m_try);
        n = ast_node_child_count(stmt);
        var ti = 0;
        when ti < n loop
            ch = ast_node_child(stmt, ti);
            sh = ast_to_hir_stmt(ch);
            if (sh as i64) != 0 do
                node = hir_add_stmt(node, sh);
            end
            ti = ti + 1
        end
        out node
    end

    if t == AstType.ThrowStmt or t == AstType.ResumeStmt or t == AstType.EmitStmt do
        node = hir_new(HirKind.Call, 0);
        node.line = ast_node_line(stmt);
        if t == AstType.ThrowStmt do node.name = "__mir_throw" end
        if t == AstType.ResumeStmt do
            node.name = "__mir_resume";
            node.name2 = ast_node_name(stmt);
        end
        if t == AstType.EmitStmt do node.name = "__mir_emit" end
        n = ast_node_child_count(stmt);
        if n >= 1 do
            arg_h = ast_to_hir_expr(ast_node_child(stmt, 0));
            if (arg_h as i64) != 0 do
                node = hir_add_arg(node, arg_h);
            end
        end
        out node
    end

    # 12. Expression as Statement (Call, etc.)
    expr_h = ast_to_hir_expr(stmt);
    if (expr_h as i64) != 0 do
        out expr_h
    end

    out (0 as HirNode)
end.

func ast_to_hir_func(func_id: i64, ast_func: AstNode):
    fname = ast_node_name(ast_func);
    fname2 = ast_node_name2(ast_func);
    params = vec_new_rt();
    body_blk = hir_new(HirKind.Block, 0);
    n = ast_node_child_count(ast_func);
    if n > 0 do
        var i = 0;
        var param_idx = 0;
        when i < n loop
            p = ast_node_child(ast_func, i);
            pnt = ast_node_type_of(p);
            if pnt == AstType.Identifier or pnt == AstType.RefParam or pnt == AstType.ParamDef do
                p_node = hir_new(HirKind.Param, 0);
                p_node.name = ast_node_name(p);
                p_node.imm_val = param_idx;
                params = vec_push_rt(params, p_node as i64);
                param_idx = param_idx + 1;
            else
                sh = ast_to_hir_stmt(p);
                if (sh as i64) != 0 do
                    body_blk = hir_add_stmt(body_blk, sh);
                end
            end
            i = i + 1
        end
    end
    out hir_func_new(func_id, fname, fname2, params, body_blk)
end.

func ast_to_hir_program(prog: AstNode):
    set_global_prog_ast(prog);
    hir_funcs = vec_new_rt();
    n = ast_node_child_count(prog);
    var i = 0;
    when i < n loop
        child = ast_node_child(prog, i);
        t = ast_node_type_of(child);
        if t == AstType.FuncDef or t == AstType.ExternFunc do
            hf = ast_to_hir_func(i, child);
            hir_funcs = vec_push_rt(hir_funcs, hf as i64);
        end
        i = i + 1
    end
    out hir_funcs
end.

export ast_to_hir_expr, ast_to_hir_stmt, ast_to_hir_func, ast_to_hir_program
