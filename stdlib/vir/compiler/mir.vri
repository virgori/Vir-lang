##
 * vir/compiler/mir.vri — Mid-level Intermediate Representation
 * ==============================================================
 * Converted from C (core/include/mir.h) for self-hosting.
 * Implements SSA (Static Single Assignment) form and CFG.
 * Unified block edges: successors/preds Vec (matches ast_to_mir).
 ##

include types
include vec_rt
import vec_new_rt, vec_push_rt, vec_get_rt, vec_len_rt from vec_rt
include string_rt
import rt_streq from string_rt

enum MirOp:
    Nop         = 0
    Move        = 1
    Load        = 2
    Store       = 3
    Add         = 4
    Sub         = 5
    Mul         = 6
    Div         = 7
    Call        = 8
    Intrinsic   = 9
    Jump        = 10
    JumpIf      = 11
    Return      = 12
    CmpEq       = 13
    CmpNe       = 14
    CmpGt       = 15
    CmpLt       = 16
    CmpGe       = 17
    CmpLe       = 18
    Mod         = 19
    # Call ABI: SetArg(index, value)* then Call(dst, nargs).
    SetArg      = 20
    JumpIfNot   = 21
    # Bitwise / logic ISA (Spec §30)
    And         = 22
    Or          = 23
    Xor         = 24
    Shl         = 25
    Shr         = 26
    Not         = 27
    # Power + ML (§26 / §30 prec 30 & 22)
    Pow         = 28
    MatMul      = 29
    Fma         = 30
end.

# Intrinsic kind codes (MirInstr.src2.imm when op == Intrinsic).
# Keep in sync with MUST_READ_CONTEXT/AST_TO_MIR_LOWERING_CHECKLIST.md
const MIR_INTR_STR_LIT:     i64 = 1
const MIR_INTR_PRINT:       i64 = 2
const MIR_INTR_ARRAY:       i64 = 3
const MIR_INTR_TUPLE:       i64 = 4
const MIR_INTR_ENTITY:      i64 = 5
const MIR_INTR_ADDR_OF:     i64 = 6
const MIR_INTR_INTERP:      i64 = 7
const MIR_INTR_BUILTIN:     i64 = 8
const MIR_INTR_INDEX:       i64 = 9
const MIR_INTR_FIELD:       i64 = 10
const MIR_INTR_MATCH_PAT:   i64 = 11
const MIR_INTR_INPUT:       i64 = 12
const MIR_INTR_ENUM:        i64 = 13
const MIR_INTR_CAST:        i64 = 14
const MIR_INTR_THROW:       i64 = 15
const MIR_INTR_CANCEL:      i64 = 16
const MIR_INTR_QUIET:       i64 = 17
const MIR_INTR_ARENA:       i64 = 18
const MIR_INTR_ENSURE:      i64 = 19
const MIR_INTR_REVERT:      i64 = 20
const MIR_INTR_INDEX_STORE: i64 = 21
const MIR_INTR_FIELD_STORE: i64 = 22
const MIR_INTR_STR_EQ:      i64 = 23
const MIR_INTR_CHECK_CPU:   i64 = 24
const MIR_INTR_PATCH_POINT: i64 = 25
const MIR_INTR_DECL:        i64 = 26;   # src1=AstType#; SetArg0=name pool id
const MIR_INTR_AWAIT:       i64 = 27
const MIR_INTR_NOP_MARKER:  i64 = 28;   # reserved / debug
const MIR_INTR_TASK:        i64 = 29
const MIR_INTR_WAIT:        i64 = 30
const MIR_INTR_SELECT:      i64 = 31
const MIR_INTR_SEND:        i64 = 32
const MIR_INTR_RECV:        i64 = 33
const MIR_INTR_EMIT:        i64 = 34
const MIR_INTR_ERX:         i64 = 35
const MIR_INTR_TRY:         i64 = 36
const MIR_INTR_RESUME:      i64 = 37
const MIR_INTR_LOCK:        i64 = 38
const MIR_INTR_SWIZZLE:     i64 = 39
const MIR_INTR_INFER:       i64 = 40
const MIR_INTR_TRAIN:       i64 = 41
const MIR_INTR_QUANTIZE:    i64 = 42
const MIR_INTR_AWAIT_PASS:  i64 = 43
const MIR_INTR_SAFE_ACCESS: i64 = 44
const MIR_INTR_ATOMIC:      i64 = 45
const MIR_INTR_EXIST:       i64 = 46;   # postfix `?`
const MIR_INTR_PATTERN:     i64 = 47;   # `a :~ b`
const MIR_INTR_MAP:         i64 = 48
const MIR_INTR_ARR_COMPACT: i64 = 49
const MIR_INTR_BUNDLE:      i64 = 50
const MIR_INTR_TIMEOUT:     i64 = 51
const MIR_INTR_ISOLATE:     i64 = 52
const MIR_INTR_ERROR:       i64 = 53;   # `error` keyword expr
const MIR_INTR_PRECOMP:     i64 = 54
const MIR_INTR_REACTIVE:    i64 = 55
const MIR_INTR_MORPH:       i64 = 56
const MIR_INTR_EXPOSE:      i64 = 57
const MIR_INTR_PTR:         i64 = 58
const MIR_INTR_ASYNC:       i64 = 59;   # async func marker (name2)
const MIR_INTR_ATOMIC_VAR:  i64 = 60
enum MirOperandType:
    None    = 0
    VReg    = 1
    Imm     = 2
    Block   = 3
end.
entity MirOperand:
    op_type: MirOperandType,
        vreg: i64,
        imm: i64,
        block_id: i64
end.
func mir_opnd_none:
    out MirOperand ( op_type: MirOperandType.None, vreg: 0, imm: 0, block_id: 0 )
end.
func mir_opnd_vreg(r: i64):
    out MirOperand ( op_type: MirOperandType.VReg, vreg: r, imm: 0, block_id: 0 )
end.
func mir_opnd_imm(val: i64):
    out MirOperand ( op_type: MirOperandType.Imm, vreg: 0, imm: val, block_id: 0 )
end.
func mir_opnd_block(id: i64):
    out MirOperand ( op_type: MirOperandType.Block, vreg: 0, imm: 0, block_id: id )
end.
entity MirInstr:
    op: MirOp,
        dst: MirOperand,
        src1: MirOperand,
        src2: MirOperand,
        next: i64
end.
entity MirPhi:
    dst_vreg: i64,
        orig_vreg: i64,
        incoming_values: i64,
        incoming_blocks: i64,
        next: i64
end.
entity MirUse:
    instr_idx: i64,
        phi_idx: i64,
        opnd_idx: i64,
        next: i64
end.
entity MirBlock:
    id: i64,
        phis: i64,
        head: i64,
        tail: i64,
        successors: i64,
        preds: i64,
        idom: i64,
        dom_children: i64,
        df: i64,
        next_block: i64
end.
entity MirFunc:
    id: i64,
        name: string,
        next_vreg: i64,
        def_uses: i64,
        next_block_id: i64,
        entry_block: i64,
        blocks: i64,
        strings: i64          # Vec<string> — LiteralStr / Call callee / Field names
end.
func mir_create_func(id: i64):
    out MirFunc (
        id: id,
        name: "",
        next_vreg: 0,
        def_uses: vec_new_rt(),
        next_block_id: 0,
        entry_block: -1,
        blocks: -1,
        strings: vec_new_rt()
    )
end.
func mir_intern_string(f: MirFunc, s: string)
    n = vec_len_rt(f.strings)
    var i = 0
    when i < n loop
        if rt_streq(vec_get_rt(f.strings, i), s) do
            out (f, i)
        end
        i = i + 1
    end
    f.strings = vec_push_rt(f.strings, s)
    out (f, n)
end.
func mir_block_new(id: i64):
    out MirBlock (
        id: id,
        phis: -1,
        head: vec_new_rt(),
        tail: -1,
        successors: vec_new_rt(),
        preds: vec_new_rt(),
        idom: -1,
        dom_children: vec_new_rt(),
        df: vec_new_rt(),
        next_block: -1
    )
end.

# Exact tags for MIR_/LIR — keep in sync with MUST_READ_CONTEXT/MIR_OPCODE_REGISTRY.md
func mir_op_tag(op: i64)
    if op == 0 do out "Nop" end
    if op == 1 do out "Move" end
    if op == 2 do out "Load" end
    if op == 3 do out "Store" end
    if op == 4 do out "Add" end
    if op == 5 do out "Sub" end
    if op == 6 do out "Mul" end
    if op == 7 do out "Div" end
    if op == 8 do out "Call" end
    if op == 9 do out "Intrinsic" end
    if op == 10 do out "Jump" end
    if op == 11 do out "JumpIf" end
    if op == 12 do out "Return" end
    if op == 13 do out "CmpEq" end
    if op == 14 do out "CmpNe" end
    if op == 15 do out "CmpGt" end
    if op == 16 do out "CmpLt" end
    if op == 17 do out "CmpGe" end
    if op == 18 do out "CmpLe" end
    if op == 19 do out "Mod" end
    if op == 20 do out "SetArg" end
    if op == 21 do out "JumpIfNot" end
    if op == 22 do out "And" end
    if op == 23 do out "Or" end
    if op == 24 do out "Xor" end
    if op == 25 do out "Shl" end
    if op == 26 do out "Shr" end
    if op == 27 do out "Not" end
    if op == 28 do out "Pow" end
    if op == 29 do out "MatMul" end
    if op == 30 do out "Fma" end
    out "Unknown"
end.
func mir_intr_tag(kind: i64)
    if kind == 1 do out "STR_LIT" end
    if kind == 2 do out "PRINT" end
    if kind == 3 do out "ARRAY" end
    if kind == 4 do out "TUPLE" end
    if kind == 5 do out "ENTITY" end
    if kind == 6 do out "ADDR_OF" end
    if kind == 7 do out "INTERP" end
    if kind == 8 do out "BUILTIN" end
    if kind == 9 do out "INDEX" end
    if kind == 10 do out "FIELD" end
    if kind == 11 do out "MATCH_PAT" end
    if kind == 12 do out "INPUT" end
    if kind == 13 do out "ENUM" end
    if kind == 14 do out "CAST" end
    if kind == 15 do out "THROW" end
    if kind == 16 do out "CANCEL" end
    if kind == 17 do out "QUIET" end
    if kind == 18 do out "ARENA" end
    if kind == 19 do out "ENSURE" end
    if kind == 20 do out "REVERT" end
    if kind == 21 do out "INDEX_STORE" end
    if kind == 22 do out "FIELD_STORE" end
    if kind == 23 do out "STR_EQ" end
    if kind == 24 do out "CHECK_CPU" end
    if kind == 25 do out "PATCH_POINT" end
    if kind == 26 do out "DECL" end
    if kind == 27 do out "AWAIT" end
    if kind == 28 do out "NOP_MARKER" end
    if kind == 29 do out "TASK" end
    if kind == 30 do out "WAIT" end
    if kind == 31 do out "SELECT" end
    if kind == 32 do out "SEND" end
    if kind == 33 do out "RECV" end
    if kind == 34 do out "EMIT" end
    if kind == 35 do out "ERX" end
    if kind == 36 do out "TRY" end
    if kind == 37 do out "RESUME" end
    if kind == 38 do out "LOCK" end
    if kind == 39 do out "SWIZZLE" end
    if kind == 40 do out "INFER" end
    if kind == 41 do out "TRAIN" end
    if kind == 42 do out "QUANTIZE" end
    if kind == 43 do out "AWAIT_PASS" end
    if kind == 44 do out "SAFE_ACCESS" end
    if kind == 45 do out "ATOMIC" end
    if kind == 46 do out "EXIST" end
    if kind == 47 do out "PATTERN" end
    if kind == 48 do out "MAP" end
    if kind == 49 do out "ARR_COMPACT" end
    if kind == 50 do out "BUNDLE" end
    if kind == 51 do out "TIMEOUT" end
    if kind == 52 do out "ISOLATE" end
    if kind == 53 do out "ERROR" end
    if kind == 54 do out "PRECOMP" end
    if kind == 55 do out "REACTIVE" end
    if kind == 56 do out "MORPH" end
    if kind == 57 do out "EXPOSE" end
    if kind == 58 do out "PTR" end
    if kind == 59 do out "ASYNC" end
    if kind == 60 do out "ATOMIC_VAR" end
    out "UNKNOWN_INTR"
end.
export MirOp, MirOperandType, MirOperand, MirInstr, MirPhi, MirUse, MirBlock, MirFunc, mir_opnd_none, mir_opnd_vreg, mir_opnd_imm, mir_opnd_block, mir_create_func, mir_block_new, mir_intern_string, mir_op_tag, mir_intr_tag, MIR_INTR_STR_LIT, MIR_INTR_PRINT, MIR_INTR_ARRAY, MIR_INTR_TUPLE, MIR_INTR_ENTITY, MIR_INTR_ADDR_OF, MIR_INTR_INTERP, MIR_INTR_BUILTIN, MIR_INTR_INDEX, MIR_INTR_FIELD, MIR_INTR_MATCH_PAT, MIR_INTR_INPUT, MIR_INTR_ENUM, MIR_INTR_CAST, MIR_INTR_THROW, MIR_INTR_CANCEL, MIR_INTR_QUIET, MIR_INTR_ARENA, MIR_INTR_ENSURE, MIR_INTR_REVERT, MIR_INTR_INDEX_STORE, MIR_INTR_FIELD_STORE, MIR_INTR_STR_EQ, MIR_INTR_CHECK_CPU, MIR_INTR_PATCH_POINT, MIR_INTR_DECL, MIR_INTR_AWAIT, MIR_INTR_NOP_MARKER, MIR_INTR_TASK, MIR_INTR_WAIT, MIR_INTR_SELECT, MIR_INTR_SEND, MIR_INTR_RECV, MIR_INTR_EMIT, MIR_INTR_ERX, MIR_INTR_TRY, MIR_INTR_RESUME, MIR_INTR_LOCK, MIR_INTR_SWIZZLE, MIR_INTR_INFER, MIR_INTR_TRAIN, MIR_INTR_QUANTIZE, MIR_INTR_AWAIT_PASS, MIR_INTR_SAFE_ACCESS, MIR_INTR_ATOMIC, MIR_INTR_EXIST, MIR_INTR_PATTERN, MIR_INTR_MAP, MIR_INTR_ARR_COMPACT, MIR_INTR_BUNDLE, MIR_INTR_TIMEOUT, MIR_INTR_ISOLATE, MIR_INTR_ERROR, MIR_INTR_PRECOMP, MIR_INTR_REACTIVE, MIR_INTR_MORPH, MIR_INTR_EXPOSE, MIR_INTR_PTR, MIR_INTR_ASYNC, MIR_INTR_ATOMIC_VAR
