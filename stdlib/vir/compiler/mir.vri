##
 * vir/compiler/mir.vri — Mid-level Intermediate Representation
 * ==============================================================
 * Converted from C (core/include/mir.h) for self-hosting.
 * Implements SSA (Static Single Assignment) form and CFG.
 ##

include types;
include vec_rt;
import vec_new_rt, vec_push_rt, vec_get_rt, vec_len_rt from vec_rt;

enum MirOp:
    Nop         = 0;
    Move        = 1;
    Load        = 2;
    Store       = 3;
    Add         = 4;
    Sub         = 5;
    Mul         = 6;
    Div         = 7;
    Call        = 8;
    Intrinsic   = 9;
    Jump        = 10;
    JumpIf      = 11;
    Return      = 12
end.

enum MirOperandType:
    None    = 0;
    VReg    = 1;
    Imm     = 2;
    Block   = 3
end.

entity MirOperand:
    op_type: MirOperandType,
        vreg: i64,
        imm: i64,
        block_id: i64
end.

func mir_opnd_none:
    out MirOperand ( op_type: MirOperandType.None, vreg: 0, imm: 0, block_id: 0 )
end.

func mir_opnd_vreg(r: i64)
    out MirOperand ( op_type: MirOperandType.VReg, vreg: r, imm: 0, block_id: 0 )
end.

func mir_opnd_imm(val: i64)
    out MirOperand ( op_type: MirOperandType.Imm, vreg: 0, imm: val, block_id: 0 )
end.

func mir_opnd_block(id: i64)
    out MirOperand ( op_type: MirOperandType.Block, vreg: 0, imm: 0, block_id: id )
end.

# Since Vir doesn't have recursive entity pointers directly without i64 indexing yet,
# we simulate linked lists with arrays (Vec) or indices. We use `i64` as pointers.
entity MirInstr:
    op: MirOp,
        dst: MirOperand,
        src1: MirOperand,
        src2: MirOperand,
        next: i64      # index/pointer to next instr
end.

entity MirPhi:
    dst_vreg: i64,
        orig_vreg: i64,
        incoming_values: i64;  # Vec<MirOperand>
    incoming_blocks: i64;  # Vec<i64> (block ids)
    next: i64
end.

entity MirUse:
    instr_idx: i64,
        phi_idx: i64,
        opnd_idx: i64,
        next: i64
end.

entity MirBlock:
    id: i64,
        phis: i64;       # index to first phi
    head: i64;       # index to first instr
    tail: i64;       # index to last instr
    
    succ_true: i64;  # block id
    succ_false: i64; # block id
    
    preds: i64;      # Vec<i64> (block ids)
    
    idom: i64;       # block id
    dom_children: i64; # Vec<i64>
    
    df: i64;         # Dominance Frontier Vec<i64>
    
    next_block: i64 # For linked list
end.

entity MirFunc:
    id: i64,
        next_vreg: i64,
        def_uses: i64;    # Vec<i64> pointing to first MirUse
    next_block_id: i64,
        entry_block: i64,
        blocks: i64      # Vec<MirBlock> or index to head
end.

func mir_create_func(id: i64)
    out MirFunc (
        id: id,
        next_vreg: 0,
        def_uses: vec_new_rt(),
        next_block_id: 0,
        entry_block: -1,
        blocks: -1
    )
end.

export MirOp, MirOperandType, MirOperand, MirInstr, MirPhi, MirUse, MirBlock, MirFunc;
export mir_opnd_none, mir_opnd_vreg, mir_opnd_imm, mir_opnd_block, mir_create_func;
