##
 * vir/compiler/mir.vri — Mid-level Intermediate Representation
 * ==============================================================
 * Converted from C (core/include/mir.h) for self-hosting.
 * Implements SSA (Static Single Assignment) form and CFG.
 * Unified block edges: successors/preds Vec (matches ast_to_mir).
 ##

include types;
include vec_rt;
import vec_new_rt, vec_push_rt, vec_get_rt, vec_len_rt from vec_rt;

enum MirOp:
    Nop         = 0;
    Move        = 1;
    Load        = 2;
    Store       = 3;
    Add         = 4;
    Sub         = 5;
    Mul         = 6;
    Div         = 7;
    Call        = 8;
    Intrinsic   = 9;
    Jump        = 10;
    JumpIf      = 11;
    Return      = 12;
    CmpEq       = 13;
    CmpNe       = 14;
    CmpGt       = 15;
    CmpLt       = 16;
    CmpGe       = 17;
    CmpLe       = 18;
    Mod         = 19
end.
enum MirOperandType:
    None    = 0;
    VReg    = 1;
    Imm     = 2;
    Block   = 3
end.
entity MirOperand:
    op_type: MirOperandType,
        vreg: i64,
        imm: i64,
        block_id: i64
end.
func mir_opnd_none:
    out MirOperand ( op_type: MirOperandType.None, vreg: 0, imm: 0, block_id: 0 )
end.
func mir_opnd_vreg(r: i64):
    out MirOperand ( op_type: MirOperandType.VReg, vreg: r, imm: 0, block_id: 0 )
end.
func mir_opnd_imm(val: i64):
    out MirOperand ( op_type: MirOperandType.Imm, vreg: 0, imm: val, block_id: 0 )
end.
func mir_opnd_block(id: i64):
    out MirOperand ( op_type: MirOperandType.Block, vreg: 0, imm: 0, block_id: id )
end.
entity MirInstr:
    op: MirOp,
        dst: MirOperand,
        src1: MirOperand,
        src2: MirOperand,
        next: i64
end.
entity MirPhi:
    dst_vreg: i64,
        orig_vreg: i64,
        incoming_values: i64,
        incoming_blocks: i64,
        next: i64
end.
entity MirUse:
    instr_idx: i64,
        phi_idx: i64,
        opnd_idx: i64,
        next: i64
end.
entity MirBlock:
    id: i64,
        phis: i64,
        head: i64,
        tail: i64,
        successors: i64,
        preds: i64,
        idom: i64,
        dom_children: i64,
        df: i64,
        next_block: i64
end.
entity MirFunc:
    id: i64,
        next_vreg: i64,
        def_uses: i64,
        next_block_id: i64,
        entry_block: i64,
        blocks: i64
end.
func mir_create_func(id: i64):
    out MirFunc (
        id: id,
        next_vreg: 0,
        def_uses: vec_new_rt(),
        next_block_id: 0,
        entry_block: -1,
        blocks: -1
    )
end.
func mir_block_new(id: i64):
    out MirBlock (
        id: id,
        phis: -1,
        head: vec_new_rt(),
        tail: -1,
        successors: vec_new_rt(),
        preds: vec_new_rt(),
        idom: -1,
        dom_children: vec_new_rt(),
        df: vec_new_rt(),
        next_block: -1
    )
end.
export MirOp, MirOperandType, MirOperand, MirInstr, MirPhi, MirUse, MirBlock, MirFunc, mir_opnd_none, mir_opnd_vreg, mir_opnd_imm, mir_opnd_block, mir_create_func, mir_block_new
