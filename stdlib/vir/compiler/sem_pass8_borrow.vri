##
 * vir/compiler/sem_pass8_borrow.vri
 * ==============================================================
 * Pass 8: Borrow / Ownership / Lifetime Analysis (Pure Vir AST).
 * Implements rigorous CS affine ownership rules & borrow checking:
 *   - Move semantics for non-copy types (Array, String, Entity, Dict, etc.)
 *   - Use-after-move / Double move detection (E5001)
 *   - Re-assignment / Re-initialization reviving moved variables
 *   - Ownership transfer on by-value function call arguments
 *   - Aliasing XOR Mutability exclusivity (& vs &mut) (E5002, E5003, E5006)
 *   - Moving values while borrowed prevention (E5008)
 *   - Borrow of moved value prevention (E5004)
 *   - Function-local reference escape detection (E5007)
 *   - Region / Arena-allocated lifetime escape detection (E5005)
 ##

include vec_rt
import vec_new_rt, vec_push_rt, vec_get_rt, vec_len_rt, vec_set_rt, vec_pop_rt from vec_rt

include string_rt
import rt_streq, fat_str_eq, fat_str_len, fat_str_byte_at, fat_cstr_eq, rt_strcat, rt_itoa, rt_strlen from string_rt

include parser
import AstNode, AstType from parser

include symbol_table
import SymbolTable, SymbolKind, SymbolNode from symbol_table

include scope_tree
import ScopeTree, ScopeKind, ScopeNode, scope_push, scope_pop from scope_tree

include context
import DiagnosticEngine, report_error, report_warning from context

include type_table
import TypeKind, type_is_move, type_is_copy from type_table

include alloc
import vir_alloc, vir_free from alloc

# ═══════════════════════════════════════════════════════
# Boxed Vector Helpers (Pointer-safe across recursive walks)
# Box layout: [0]=vec, [8]=lazy name→item hash (256 chain heads).
# Avoids O(n²) linear scans on var_types / moved / locals / borrows.
# ═══════════════════════════════════════════════════════

const PASS8_BUCKETS: int = 256

func pass8_hash_name(name: string):
    let n = fat_str_len(name)
    if n <= 0 do
        out 0
    end
    var h = n * 17
    var i = 0
    when i < n loop
        h = h * 131 + fat_str_byte_at(name, i)
        i = i + 1
    end
    if h < 0 do
        h = 0 - h
    end
    out h mod PASS8_BUCKETS
end.

func pass8_map_new():
    let heads = vir_alloc(PASS8_BUCKETS * 8)
    var i = 0
    when i < PASS8_BUCKETS loop
        native_write_i64(heads, i * 8, 0)
        i = i + 1
    end
    out heads
end.

func pass8_box_new():
    let p = vir_alloc(16)
    native_write_i64(p, 0, vec_new_rt())
    native_write_i64(p, 8, 0)
    out p
end.

func pass8_box_map(b: int):
    out native_read_i64(b, 8)
end.

func pass8_box_ensure_map(b: int):
    var ht = native_read_i64(b, 8)
    if ht == 0 do
        ht = pass8_map_new()
        native_write_i64(b, 8, ht)
    end
    out ht
end.

# Chain node: [0]=next, [8]=item ptr
func pass8_map_index(ht: int, name: string, item: int):
    if fat_str_len(name) == 0 do
        out 0
    end
    if ht == 0 do
        out 0
    end
    let bid = pass8_hash_name(name)
    let node = vir_alloc(16)
    native_write_i64(node, 0, native_read_i64(ht, bid * 8))
    native_write_i64(node, 8, item as i64)
    native_write_i64(ht, bid * 8, node)
    out 0
end.

func pass8_map_unindex_one(ht: int, name: string, item: int):
    if ht == 0 or fat_str_len(name) == 0 do
        out 0
    end
    let bid = pass8_hash_name(name)
    var prev = 0
    var node = native_read_i64(ht, bid * 8)
    var nxt = 0
    var it = 0
    when node != 0 loop
        nxt = native_read_i64(node, 0)
        it = native_read_i64(node, 8)
        if it == item as i64 do
            if prev == 0 do
                native_write_i64(ht, bid * 8, nxt)
            else
                native_write_i64(prev, 0, nxt)
            end
            out 0
        end
        prev = node
        node = nxt
    end
    out 0
end.

func pass8_map_find(ht: int, name: string):
    if ht == 0 or fat_str_len(name) == 0 do
        out 0
    end
    let bid = pass8_hash_name(name)
    let name_ptr = name as i64
    var node = native_read_i64(ht, bid * 8)
    var it = 0
    var nm_ptr = 0
    when node != 0 loop
        it = native_read_i64(node, 8)
        if it >= 4096 do
            nm_ptr = native_read_i64(it, 0)
            if nm_ptr == name_ptr do
                out it
            end
            if fat_str_eq(nm_ptr as string, name) == 1 do
                out it
            end
        end
        node = native_read_i64(node, 0)
    end
    out 0
end.

func pass8_map_count(ht: int, name: string):
    if ht == 0 or fat_str_len(name) == 0 do
        out 0
    end
    let bid = pass8_hash_name(name)
    let name_ptr = name as i64
    var total = 0
    var node = native_read_i64(ht, bid * 8)
    var it = 0
    var nm_ptr = 0
    when node != 0 loop
        it = native_read_i64(node, 8)
        if it >= 4096 do
            nm_ptr = native_read_i64(it, 0)
            if nm_ptr == name_ptr or fat_str_eq(nm_ptr as string, name) == 1 do
                total = total + 1
            end
        end
        node = native_read_i64(node, 0)
    end
    out total
end.

func pass8_box_len(b: int):
    let v = native_read_i64(b, 0)
    out vec_len_rt(v)
end.

func pass8_box_get(b: int, i: int):
    let v = native_read_i64(b, 0)
    out vec_get_rt(v, i)
end.

func pass8_box_set(b: int, i: int, val: int):
    let v = native_read_i64(b, 0)
    vec_set_rt(v, i, val)
end.

func pass8_box_push(b: int, val: int):
    var v = native_read_i64(b, 0)
    v = vec_push_rt(v, val)
    native_write_i64(b, 0, v)
    # Index by name@0 (VarItem and BorrowBinding both store a string there).
    if val >= 4096 do
        let nm = native_read_i64(val, 0) as string
        if fat_str_len(nm) > 0 do
            pass8_map_index(pass8_box_ensure_map(b), nm, val)
        end
    end
end.

func pass8_box_pop(b: int):
    let v = native_read_i64(b, 0)
    out vec_pop_rt(v)
end.

func pass8_box_truncate_to(b: int, watermark: int):
    let v = native_read_i64(b, 0)
    let ht = native_read_i64(b, 8)
    var popped = 0
    var nm = fat_str_new("")
    when vec_len_rt(v) > watermark loop
        popped = vec_pop_rt(v)
        if ht != 0 and popped >= 4096 do
            nm = native_read_i64(popped, 0) as string
            pass8_map_unindex_one(ht, nm, popped)
        end
    end
end.

# ═══════════════════════════════════════════════════════
# VarItem and BorrowBinding Layouts
# ═══════════════════════════════════════════════════════

func pass8_streq(a: string, b: string):
    out fat_str_eq(a, b) == 1
end.

func pass8_strlen(s: string):
    out fat_str_len(s)
end.

func var_item_new(name: string, val: int):
    let p = vir_alloc(16)
    native_write_i64(p, 0, name as i64)
    native_write_i64(p, 8, val as i64)
    out p
end.

func var_item_name(item: int):
    if item < 4096 do
        out fat_str_new("")
    end
    out native_read_i64(item, 0) as string
end.

func var_item_val(item: int):
    if item < 4096 do
        out 0
    end
    out native_read_i64(item, 8)
end.

func var_item_set_val(item: int, val: int):
    if item >= 4096 do
        native_write_i64(item, 8, val as i64)
    end
end.

func borrow_binding_new(lhs: string, target: string, kind: int):
    let p = vir_alloc(24)
    native_write_i64(p, 0, lhs as i64)
    native_write_i64(p, 8, target as i64)
    native_write_i64(p, 16, kind as i64)
    out p
end.

func borrow_binding_lhs(b: int):
    if b < 4096 do
        out fat_str_new("")
    end
    out native_read_i64(b, 0) as string
end.

func borrow_binding_target(b: int):
    if b < 4096 do
        out fat_str_new("")
    end
    out native_read_i64(b, 8) as string
end.

func borrow_binding_kind(b: int):
    if b < 4096 do
        out 0
    end
    out native_read_i64(b, 16)
end.

func pass8_analyze_borrow(symbols: SymbolTable, scopes: ScopeTree, diag: DiagnosticEngine, node: AstNode):
    let moved_vars = pass8_box_new()
    let shared_borrows = pass8_box_new()
    let mut_borrows = pass8_box_new()
    let bound_borrows = pass8_box_new()
    let arena_locals = pass8_box_new()
    let pre_arena_names = pass8_box_new()
    let var_types = pass8_box_new()
    let func_locals = pass8_box_new()
    pass8_walk(symbols, scopes, diag, node, moved_vars, shared_borrows, mut_borrows,
               bound_borrows, arena_locals, pre_arena_names, 0, var_types, func_locals)
end.

func pass8_is_moved(moved_vars: int, name: string):
    if pass8_strlen(name) == 0 do
        out 0
    end
    if pass8_map_find(pass8_box_map(moved_vars), name) != 0 do
        out 1
    end
    out 0
end.

func pass8_mark_moved(moved_vars: int, name: string):
    if pass8_strlen(name) == 0 do
        out 0
    end
    if pass8_is_moved(moved_vars, name) == 0 do
        pass8_box_push(moved_vars, var_item_new(name, 0) as i64)
    end
    out 0
end.

func pass8_unmark_moved(moved_vars: int, name: string):
    if pass8_strlen(name) == 0 do
        out 0
    end
    let item = pass8_map_find(pass8_box_map(moved_vars), name)
    if item == 0 do
        out 0
    end
    let count = pass8_box_len(moved_vars)
    var i = 0
    var v = 0
    when i < count loop
        if pass8_box_get(moved_vars, i) == item do
            pass8_map_unindex_one(pass8_box_map(moved_vars), name, item)
            if i < count - 1 do
                pass8_box_set(moved_vars, i, pass8_box_get(moved_vars, count - 1))
            end
            # Truncate without re-unindexing the swapped tail: pop raw.
            v = native_read_i64(moved_vars, 0)
            vec_pop_rt(v)
            out 0
        end
        i = i + 1
    end
    out 0
end.

func pass8_vec_contains(names: int, name: string):
    if pass8_strlen(name) == 0 do
        out 0
    end
    if pass8_map_find(pass8_box_map(names), name) != 0 do
        out 1
    end
    out 0
end.

func pass8_borrow_count(borrows: int, name: string):
    if pass8_strlen(name) == 0 do
        out 0
    end
    out pass8_map_count(pass8_box_map(borrows), name)
end.

func pass8_truncate_to(lst: int, watermark: int):
    pass8_box_truncate_to(lst, watermark)
end.

func pass8_remove_one_borrow(borrows: int, name: string):
    if pass8_strlen(name) == 0 do
        out 0
    end
    let item = pass8_map_find(pass8_box_map(borrows), name)
    if item == 0 do
        out 0
    end
    let len = pass8_box_len(borrows)
    var i = len - 1
    var v = 0
    when i >= 0 loop
        if pass8_box_get(borrows, i) == item do
            pass8_map_unindex_one(pass8_box_map(borrows), name, item)
            if i < len - 1 do
                pass8_box_set(borrows, i, pass8_box_get(borrows, len - 1))
            end
            v = native_read_i64(borrows, 0)
            vec_pop_rt(v)
            out 0
        end
        i = i - 1
    end
    out 0
end.

func pass8_release_borrower(bound_borrows: int, shared_borrows: int, mut_borrows: int, borrower: string):
    if pass8_strlen(borrower) == 0 do
        out 0
    end
    let b = pass8_map_find(pass8_box_map(bound_borrows), borrower)
    if b == 0 do
        out 0
    end
    if borrow_binding_kind(b) == 2 do
        pass8_remove_one_borrow(mut_borrows, borrow_binding_target(b))
    else
        pass8_remove_one_borrow(shared_borrows, borrow_binding_target(b))
    end
    let len = pass8_box_len(bound_borrows)
    var i = 0
    var v = 0
    when i < len loop
        if pass8_box_get(bound_borrows, i) == b do
            pass8_map_unindex_one(pass8_box_map(bound_borrows), borrower, b)
            if i < len - 1 do
                pass8_box_set(bound_borrows, i, pass8_box_get(bound_borrows, len - 1))
            end
            v = native_read_i64(bound_borrows, 0)
            vec_pop_rt(v)
            out 0
        end
        i = i + 1
    end
    out 0
end.

func pass8_claim_borrow(bound_borrows: int, borrower: string, target: string, kind: int):
    pass8_box_push(bound_borrows, borrow_binding_new(borrower, target, kind) as i64)
end.

func pass8_register_var_type(var_types: int, name: string, kind: TypeKind):
    if pass8_strlen(name) == 0 do
        out 0
    end
    let item = pass8_map_find(pass8_box_map(var_types), name)
    if item != 0 do
        var_item_set_val(item, kind as int)
        out 0
    end
    pass8_box_push(var_types, var_item_new(name, kind as int) as i64)
    out 0
end.

func pass8_get_var_type(var_types: int, name: string):
    if pass8_strlen(name) == 0 do
        out TypeKind.Void
    end
    let item = pass8_map_find(pass8_box_map(var_types), name)
    if item != 0 do
        out var_item_val(item) as TypeKind
    end
    out TypeKind.Void
end.

func pass8_infer_expr_type(var_types: int, expr: AstNode):
    if (expr as i64) == 0 do
        out TypeKind.Void
    end
    let t = expr.node_type
    if t == AstType.ArrayLiteral do
        out TypeKind.Array
    end
    if t == AstType.LiteralStr do
        out TypeKind.String
    end
    if t == AstType.EntityLiteral do
        out TypeKind.Entity
    end
    if t == AstType.LiteralInt do
        out TypeKind.Int
    end
    if t == AstType.LiteralFloat do
        out TypeKind.Float
    end
    if t == AstType.Identifier do
        out pass8_get_var_type(var_types, expr.name)
    end
    if t == AstType.AddrOf do
        if fat_cstr_eq(expr.name, "mut") == 1 do
            out TypeKind.MutRef
        else
            out TypeKind.Ref
        end
    end
    out TypeKind.Void
end.

func pass8_expr_has_arena_local(expr: AstNode, arena_locals: int, in_arena: int):
    if (expr as i64) == 0 do
        out 0
    end
    if expr.node_type == AstType.Identifier do
        if pass8_vec_contains(arena_locals, expr.name) == 1 do
            out 1
        end
        out 0
    end
    let child_count = vec_len_rt(expr.children)
    var i = 0
    when i < child_count loop
        let child = vec_get_rt(expr.children, i)
        if pass8_expr_has_arena_local(child, arena_locals, in_arena) == 1 do
            out 1
        end
        i = i + 1
    end
    out 0
end.

func pass8_check_arena_escape_assign(diag: DiagnosticEngine, lhs: string, rhs: AstNode,
                                     arena_locals: int, pre_arena_names: int, in_arena: int, line: int):
    if in_arena == 0 do
        out 0
    end
    if pass8_strlen(lhs) == 0 do
        out 0
    end
    if pass8_vec_contains(pre_arena_names, lhs) == 0 do
        out 0
    end
    if pass8_expr_has_arena_local(rhs, arena_locals, in_arena) == 1 do
        report_error(diag, 5005, line, 0)
        out 1
    end
    out 0
end.

func pass8_register_arena_local(arena_locals: int, pre_arena_names: int, name: string, in_arena: int):
    if pass8_strlen(name) == 0 do
        out 0
    end
    if in_arena == 0 do
        if pass8_vec_contains(pre_arena_names, name) == 0 do
            pass8_box_push(pre_arena_names, var_item_new(name, 0) as i64)
        end
        out 0
    end
    if pass8_vec_contains(pre_arena_names, name) == 1 do
        out 0
    end
    if pass8_vec_contains(arena_locals, name) == 0 do
        pass8_box_push(arena_locals, var_item_new(name, 0) as i64)
    end
    out 0
end.

func pass8_check_arena_borrow_escape(diag: DiagnosticEngine, arena_locals: int, pre_arena_names: int,
                                     bound_borrows: int, line: int):
    let count = pass8_box_len(bound_borrows)
    var i = 0
    when i < count loop
        let b = pass8_box_get(bound_borrows, i)
        let tgt = borrow_binding_target(b)
        let lhs = borrow_binding_lhs(b)
        if pass8_vec_contains(arena_locals, tgt) == 1 do
            if pass8_vec_contains(pre_arena_names, lhs) == 1 do
                report_error(diag, 5005, line, 0)
            end
        end
        i = i + 1
    end
    out 0
end.

func pass8_end_stmt(shared_borrows: int, mut_borrows: int, shared_wm: int, mut_wm: int, claimed: int):
    if claimed == 0 do
        pass8_truncate_to(shared_borrows, shared_wm)
        pass8_truncate_to(mut_borrows, mut_wm)
    end
    out 0
end.

func pass8_get_addr_target(node: AstNode):
    if (node as i64) == 0 do
        out fat_str_new("")
    end
    if node.node_type != AstType.AddrOf do
        out fat_str_new("")
    end
    let child_count = vec_len_rt(node.children)
    if child_count < 1 do
        out fat_str_new("")
    end
    let child = vec_get_rt(node.children, 0)
    if child.node_type == AstType.Identifier do
        out child.name
    end
    out fat_str_new("")
end.

func pass8_handle_addr_of(symbols: SymbolTable, scopes: ScopeTree, diag: DiagnosticEngine,
                          node: AstNode, moved_vars: int, shared_borrows: int, mut_borrows: int,
                          bound_borrows: int, arena_locals: int, pre_arena_names: int, in_arena: int,
                          var_types: int, func_locals: int):
    let child_count = vec_len_rt(node.children)
    if child_count < 1 do
        out fat_str_new("")
    end
    let child = vec_get_rt(node.children, 0)
    if child.node_type != AstType.Identifier do
        pass8_walk(symbols, scopes, diag, child, moved_vars, shared_borrows, mut_borrows,
                   bound_borrows, arena_locals, pre_arena_names, in_arena, var_types, func_locals)
        out fat_str_new("")
    end
    let tgt = child.name
    if pass8_strlen(tgt) == 0 do
        out fat_str_new("")
    end
    if pass8_is_moved(moved_vars, tgt) == 1 do
        report_error(diag, 5004, node.line, 0)
        out fat_str_new("")
    end
    var is_mut = 0
    if fat_cstr_eq(node.name, "mut") == 1 do
        is_mut = 1
    end
    if is_mut == 1 do
        if pass8_borrow_count(shared_borrows, tgt) > 0 do
            report_error(diag, 5002, node.line, 0)
        end
        if pass8_borrow_count(mut_borrows, tgt) > 0 do
            report_error(diag, 5003, node.line, 0)
        end
        pass8_box_push(mut_borrows, var_item_new(tgt, 0) as i64)
    else
        if pass8_borrow_count(mut_borrows, tgt) > 0 do
            report_error(diag, 5006, node.line, 0)
        end
        pass8_box_push(shared_borrows, var_item_new(tgt, 0) as i64)
    end
    out tgt
end.

func pass8_process_binding_rhs(symbols: SymbolTable, scopes: ScopeTree, diag: DiagnosticEngine,
                               rhs: AstNode, moved_vars: int, shared_borrows: int, mut_borrows: int,
                               bound_borrows: int, lhs: string, arena_locals: int, pre_arena_names: int, in_arena: int,
                               var_types: int, func_locals: int):
    var claimed = 0
    var borrow_tgt = fat_str_new("")
    var borrow_kind = 0

    if rhs.node_type == AstType.AddrOf do
        borrow_tgt = pass8_handle_addr_of(symbols, scopes, diag, rhs, moved_vars,
                                          shared_borrows, mut_borrows, bound_borrows,
                                          arena_locals, pre_arena_names, in_arena, var_types, func_locals)
        if pass8_strlen(borrow_tgt) > 0 do
            if fat_cstr_eq(rhs.name, "mut") == 1 do
                borrow_kind = 2
            else
                borrow_kind = 1
            end
            pass8_claim_borrow(bound_borrows, lhs, borrow_tgt, borrow_kind)
            claimed = 1
        end
    else
        pass8_walk(symbols, scopes, diag, rhs, moved_vars, shared_borrows, mut_borrows,
                   bound_borrows, arena_locals, pre_arena_names, in_arena, var_types, func_locals)
        if rhs.node_type == AstType.Identifier do
            let rhs_name = rhs.name
            if pass8_is_moved(moved_vars, rhs_name) == 1 do
                report_error(diag, 5001, rhs.line, 0)
            else
                if pass8_borrow_count(shared_borrows, rhs_name) > 0 or pass8_borrow_count(mut_borrows, rhs_name) > 0 do
                    report_error(diag, 5008, rhs.line, 0)
                end
                let rhs_type = pass8_get_var_type(var_types, rhs_name)
                if type_is_move(rhs_type) do
                    pass8_mark_moved(moved_vars, rhs_name)
                end
            end
        end
    end
    out claimed
end.

func pass8_walk_children_stmts(symbols: SymbolTable, scopes: ScopeTree, diag: DiagnosticEngine,
                               node: AstNode, moved_vars: int, shared_borrows: int, mut_borrows: int,
                               bound_borrows: int, arena_locals: int, pre_arena_names: int, in_arena: int,
                               var_types: int, func_locals: int):
    let child_count = vec_len_rt(node.children)
    var i = 0
    var claimed_any = 0
    when i < child_count loop
        let shared_wm = pass8_box_len(shared_borrows)
        let mut_wm = pass8_box_len(mut_borrows)
        let child = vec_get_rt(node.children, i)
        let claimed = pass8_walk(symbols, scopes, diag, child, moved_vars, shared_borrows, mut_borrows,
                                 bound_borrows, arena_locals, pre_arena_names, in_arena, var_types, func_locals)
        if claimed == 1 do
            claimed_any = 1
        end
        pass8_end_stmt(shared_borrows, mut_borrows, shared_wm, mut_wm, claimed)
        i = i + 1
    end
    out claimed_any
end.

func pass8_walk(symbols: SymbolTable, scopes: ScopeTree, diag: DiagnosticEngine, node: AstNode,
                moved_vars: int, shared_borrows: int, mut_borrows: int,
                bound_borrows: int, arena_locals: int, pre_arena_names: int, in_arena: int,
                var_types: int, func_locals: int):
    if (node as i64) == 0 do
        out 0
    end

    # 1. Identifier — check use of moved value
    if node.node_type == AstType.Identifier do
        if pass8_strlen(node.name) > 0 do
            if pass8_is_moved(moved_vars, node.name) == 1 do
                report_error(diag, 5001, node.line, 0)
            end
        end
    end

    # 2. AddrOf
    if node.node_type == AstType.AddrOf do
        pass8_handle_addr_of(symbols, scopes, diag, node, moved_vars, shared_borrows, mut_borrows,
                             bound_borrows, arena_locals, pre_arena_names, in_arena, var_types, func_locals)
        out 0
    end

    # 3. Variable Assignment (x = rhs)
    if node.node_type == AstType.Assign do
        let assign_name = node.name
        if pass8_strlen(assign_name) > 0 do
            # Cannot mutate variable while shared borrow is active
            if pass8_borrow_count(shared_borrows, assign_name) > 0 do
                report_error(diag, 5002, node.line, 0)
            end
            # Cannot mutate variable while mutable borrow is held by another reference
            if pass8_borrow_count(mut_borrows, assign_name) > 0 do
                report_error(diag, 5003, node.line, 0)
            end
            # Release previous borrows held by this variable
            pass8_release_borrower(bound_borrows, shared_borrows, mut_borrows, assign_name)
            # Re-assignment revives moved variable (clears moved state)
            pass8_unmark_moved(moved_vars, assign_name)
        end

        var claimed = 0
        let child_count = vec_len_rt(node.children)
        if child_count > 0 do
            let rhs = vec_get_rt(node.children, 0)
            let rhs_type = pass8_infer_expr_type(var_types, rhs)
            if pass8_strlen(assign_name) > 0 do
                pass8_register_var_type(var_types, assign_name, rhs_type)
                pass8_register_arena_local(arena_locals, pre_arena_names, assign_name, in_arena)
                pass8_check_arena_escape_assign(diag, assign_name, rhs, arena_locals, pre_arena_names, in_arena, node.line)
            end
            claimed = pass8_process_binding_rhs(symbols, scopes, diag, rhs, moved_vars,
                                                  shared_borrows, mut_borrows, bound_borrows,
                                                  assign_name, arena_locals, pre_arena_names, in_arena, var_types, func_locals)
        end
        out claimed
    end

    # 4. Variable / Constant Declaration (let x = init / var x = init)
    if node.node_type == AstType.VarDecl or node.node_type == AstType.ConstDecl do
        var claimed = 0
        let child_count = vec_len_rt(node.children)
        if node.int_val == 16384 do
            var ti = 0
            when ti < child_count loop
                let tuple_child = vec_get_rt(node.children, ti)
                if tuple_child.node_type == AstType.Identifier do
                    pass8_register_arena_local(arena_locals, pre_arena_names, tuple_child.name, in_arena)
                    if pass8_vec_contains(func_locals, tuple_child.name) == 0 do
                        pass8_box_push(func_locals, var_item_new(tuple_child.name, 0) as i64)
                    end
                end
                ti = ti + 1
            end
        else
            pass8_register_arena_local(arena_locals, pre_arena_names, node.name, in_arena)
            if pass8_strlen(node.name) > 0 and pass8_vec_contains(func_locals, node.name) == 0 do
                pass8_box_push(func_locals, var_item_new(node.name, 0) as i64)
            end
        end
        if child_count > 0 do
            let init = vec_get_rt(node.children, child_count - 1)
            var bind_name = node.name
            if node.int_val == 16384 do
                bind_name = fat_str_new("")
            end
            if pass8_strlen(bind_name) > 0 do
                let init_type = pass8_infer_expr_type(var_types, init)
                pass8_register_var_type(var_types, bind_name, init_type)
                pass8_check_arena_escape_assign(diag, bind_name, init, arena_locals, pre_arena_names, in_arena, node.line)
                claimed = pass8_process_binding_rhs(symbols, scopes, diag, init, moved_vars,
                                                      shared_borrows, mut_borrows, bound_borrows,
                                                      bind_name, arena_locals, pre_arena_names, in_arena, var_types, func_locals)
            else
                pass8_walk(symbols, scopes, diag, init, moved_vars, shared_borrows, mut_borrows,
                           bound_borrows, arena_locals, pre_arena_names, in_arena, var_types, func_locals)
            end
        end
        out claimed
    end

    # 5. Function & Method Calls — arguments are borrowed by default
    if node.node_type == AstType.Call or node.node_type == AstType.MethodCall do
        let child_count = vec_len_rt(node.children)
        var i = 0
        when i < child_count loop
            let arg = vec_get_rt(node.children, i)
            if arg.node_type == AstType.AddrOf do
                pass8_handle_addr_of(symbols, scopes, diag, arg, moved_vars, shared_borrows, mut_borrows,
                                     bound_borrows, arena_locals, pre_arena_names, in_arena, var_types, func_locals)
            else
                pass8_walk(symbols, scopes, diag, arg, moved_vars, shared_borrows, mut_borrows,
                           bound_borrows, arena_locals, pre_arena_names, in_arena, var_types, func_locals)
            end
            i = i + 1
        end
        out 0
    end

    # 6. Return Statement — verify no local reference / arena reference escape
    if node.node_type == AstType.ReturnStmt do
        let child_count = vec_len_rt(node.children)
        if child_count > 0 do
            let val = vec_get_rt(node.children, 0)
            # Check local reference escape
            if val.node_type == AstType.AddrOf do
                let tgt = pass8_get_addr_target(val)
                if pass8_strlen(tgt) > 0 and pass8_vec_contains(func_locals, tgt) == 1 do
                    report_error(diag, 5007, node.line, 0)
                end
            end
            if in_arena == 1 and pass8_expr_has_arena_local(val, arena_locals, in_arena) == 1 do
                report_error(diag, 5005, node.line, 0)
            end
            pass8_walk(symbols, scopes, diag, val, moved_vars, shared_borrows, mut_borrows,
                       bound_borrows, arena_locals, pre_arena_names, in_arena, var_types, func_locals)
        end
        out 0
    end

    # 7. Print / Throw Statements
    if node.node_type == AstType.PrintStmt or node.node_type == AstType.ThrowStmt do
        let child_count = vec_len_rt(node.children)
        var i = 0
        when i < child_count loop
            let child = vec_get_rt(node.children, i)
            pass8_walk(symbols, scopes, diag, child, moved_vars, shared_borrows, mut_borrows,
                       bound_borrows, arena_locals, pre_arena_names, in_arena, var_types, func_locals)
            i = i + 1
        end
        out 0
    end

    # 8. Attribute bindings
    if node.node_type == AstType.BindAttr do
        let child_count = vec_len_rt(node.children)
        if child_count > 0 do
            let child = vec_get_rt(node.children, 0)
            out pass8_walk(symbols, scopes, diag, child, moved_vars, shared_borrows, mut_borrows,
                           bound_borrows, arena_locals, pre_arena_names, in_arena, var_types, func_locals)
        end
        out 0
    end

    # 9. Function Definition — fresh function-level ownership tracking context
    if node.node_type == AstType.FuncDef do
        scope_push(scopes, ScopeKind.Func)
        let func_moved = pass8_box_new()
        let func_shared = pass8_box_new()
        let func_mut = pass8_box_new()
        let func_bound_borrows = pass8_box_new()
        let func_arena_locals = pass8_box_new()
        let func_pre_arena = pass8_box_new()
        let func_var_types = pass8_box_new()
        let fn_locals = pass8_box_new()

        let child_count = vec_len_rt(node.children)
        var i = 0
        when i < child_count loop
            let child = vec_get_rt(node.children, i)
            if child.node_type == AstType.Identifier or child.node_type == AstType.ParamDef or child.node_type == AstType.RefParam do
                if pass8_strlen(child.name) > 0 do
                    pass8_box_push(fn_locals, var_item_new(child.name, 0) as i64)
                    if child.node_type == AstType.RefParam do
                        pass8_register_var_type(func_var_types, child.name, TypeKind.Ref)
                    else
                        pass8_register_var_type(func_var_types, child.name, TypeKind.Int)
                    end
                end
            end
            pass8_walk(symbols, scopes, diag, child, func_moved, func_shared, func_mut,
                       func_bound_borrows, func_arena_locals, func_pre_arena, 0, func_var_types, fn_locals)
            i = i + 1
        end
        scope_pop(scopes)
        out 0
    end

    # 10. Generic Block — lexical borrow lifetime scope
    if node.node_type == AstType.Block do
        scope_push(scopes, ScopeKind.Block)
        let bound_wm = pass8_box_len(bound_borrows)
        let shared_wm = pass8_box_len(shared_borrows)
        let mut_wm = pass8_box_len(mut_borrows)
        let claimed = pass8_walk_children_stmts(symbols, scopes, diag, node, moved_vars, shared_borrows, mut_borrows,
                                                bound_borrows, arena_locals, pre_arena_names, in_arena, var_types, func_locals)
        # Release block-scoped borrows
        pass8_truncate_to(bound_borrows, bound_wm)
        pass8_truncate_to(shared_borrows, shared_wm)
        pass8_truncate_to(mut_borrows, mut_wm)
        scope_pop(scopes)
        out claimed
    end

    # 11. Arena Block — region lifetime validation
    if node.node_type == AstType.ArenaBlock do
        scope_push(scopes, ScopeKind.Block)
        let moved_wm = pass8_box_len(moved_vars)
        let shared_wm = pass8_box_len(shared_borrows)
        let mut_wm = pass8_box_len(mut_borrows)
        let bound_wm = pass8_box_len(bound_borrows)
        let arena_wm = pass8_box_len(arena_locals)
        pass8_walk_children_stmts(symbols, scopes, diag, node, moved_vars, shared_borrows, mut_borrows,
                                  bound_borrows, arena_locals, pre_arena_names, 1, var_types, func_locals)
        pass8_check_arena_borrow_escape(diag, arena_locals, pre_arena_names, bound_borrows, node.line)
        pass8_truncate_to(moved_vars, moved_wm)
        pass8_truncate_to(shared_borrows, shared_wm)
        pass8_truncate_to(mut_borrows, mut_wm)
        pass8_truncate_to(bound_borrows, bound_wm)
        pass8_truncate_to(arena_locals, arena_wm)
        scope_pop(scopes)
        out 0
    end

    # 12. Control Flow: IfStmt, LoopStmt, WhileStmt, ForRange
    if node.node_type == AstType.IfStmt or node.node_type == AstType.LoopStmt or node.node_type == AstType.WhileStmt or node.node_type == AstType.ForRange do
        scope_push(scopes, ScopeKind.Block)
        let moved_wm = pass8_box_len(moved_vars)
        let shared_wm = pass8_box_len(shared_borrows)
        let mut_wm = pass8_box_len(mut_borrows)
        let bound_wm = pass8_box_len(bound_borrows)
        let child_count = vec_len_rt(node.children)
        if child_count > 0 do
            let cond = vec_get_rt(node.children, 0)
            pass8_walk(symbols, scopes, diag, cond, moved_vars, shared_borrows, mut_borrows,
                       bound_borrows, arena_locals, pre_arena_names, in_arena, var_types, func_locals)
        end
        var i = 1
        when i < child_count loop
            let shared_stmt_wm = pass8_box_len(shared_borrows)
            let mut_stmt_wm = pass8_box_len(mut_borrows)
            let child = vec_get_rt(node.children, i)
            let claimed = pass8_walk(symbols, scopes, diag, child, moved_vars, shared_borrows, mut_borrows,
                                     bound_borrows, arena_locals, pre_arena_names, in_arena, var_types, func_locals)
            pass8_end_stmt(shared_borrows, mut_borrows, shared_stmt_wm, mut_stmt_wm, claimed)
            i = i + 1
        end
        pass8_truncate_to(shared_borrows, shared_wm)
        pass8_truncate_to(mut_borrows, mut_wm)
        pass8_truncate_to(bound_borrows, bound_wm)
        scope_pop(scopes)
        out 0
    end

    # 13. Default: walk all child AST nodes
    let child_count = vec_len_rt(node.children)
    var i = 0
    when i < child_count loop
        let child = vec_get_rt(node.children, i)
        pass8_walk(symbols, scopes, diag, child, moved_vars, shared_borrows, mut_borrows,
                   bound_borrows, arena_locals, pre_arena_names, in_arena, var_types, func_locals)
        i = i + 1
    end
    out 0
end.

export pass8_analyze_borrow
