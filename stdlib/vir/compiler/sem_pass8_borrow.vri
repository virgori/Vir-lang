##
 * vir/compiler/sem_pass8_borrow.vri
 * ==============================================================
 * Pass 8: Borrow / Ownership / Lifetime Analysis (Pure Vir AST).
 * Implements rigorous CS affine ownership rules & borrow checking:
 *   - Move semantics for non-copy types (Array, String, Entity, Dict, etc.)
 *   - Use-after-move / Double move detection (E5001)
 *   - Re-assignment / Re-initialization reviving moved variables
 *   - Ownership transfer on by-value function call arguments
 *   - Aliasing XOR Mutability exclusivity (& vs &mut) (E5002, E5003, E5006)
 *   - Moving values while borrowed prevention (E5008)
 *   - Borrow of moved value prevention (E5004)
 *   - Function-local reference escape detection (E5007)
 *   - Region / Arena-allocated lifetime escape detection (E5005)
 ##

include vec_rt
import vec_new_rt, vec_push_rt, vec_get_rt, vec_len_rt, vec_set_rt, vec_pop_rt from vec_rt

include string_rt
import rt_streq, fat_str_eq, fat_str_len, fat_str_byte_at, fat_str_concat, fat_str_new, fat_cstr_eq, rt_strcat, rt_itoa, rt_strlen, native_read_i64, native_read_u8 from string_rt

include parser
import AstNode, AstType from parser

include symbol_table
import SymbolTable, SymbolKind, SymbolNode from symbol_table

include scope_tree
import ScopeTree, ScopeKind, ScopeNode, scope_push, scope_pop from scope_tree

include context
import DiagnosticEngine, report_error, report_warning, report_error_info, report_error_related from context

include type_table
import TypeKind, type_is_move, type_is_copy from type_table

include alloc
import vir_alloc, vir_free from alloc

var g_pass8_func_map: int = 0
var g_pass8_func_params: int = 0
var g_pass8_shadow_frames: int = 0

func pass8_ast_name(n: &AstNode):
    out native_read_i64(n as i64, 0) as string
end.

func pass8_ast_name2(n: &AstNode):
    out native_read_i64(n as i64, 8) as string
end.

func pass8_type_kind_from_type_str(type_str: string):
    if pass8_strlen(type_str) == 0 do
        out TypeKind.Int
    end
    if pass8_cstr_eq(type_str, "string") == 1 do
        out TypeKind.String
    end
    if pass8_cstr_eq(type_str, "dict") == 1 do
        out TypeKind.Dict
    end
    if pass8_cstr_eq(type_str, "tensor") == 1 or pass8_cstr_eq(type_str, "Tensor") == 1 do
        out TypeKind.Tensor
    end
    # Fieldless enums are copy types with scalar integer representation (Spec §3, §4).
    if pass8_cstr_eq(type_str, "TypeKind") == 1 or pass8_cstr_eq(type_str, "AstType") == 1 or pass8_cstr_eq(type_str, "MirOp") == 1 or pass8_cstr_eq(type_str, "MirOperandType") == 1 or pass8_cstr_eq(type_str, "MirType") == 1 or pass8_cstr_eq(type_str, "SymbolKind") == 1 or pass8_cstr_eq(type_str, "ScopeKind") == 1 or pass8_cstr_eq(type_str, "TokType") == 1 or pass8_cstr_eq(type_str, "LirOp") == 1 or pass8_cstr_eq(type_str, "MCOpcode") == 1 or pass8_cstr_eq(type_str, "AsmDialect") == 1 or pass8_cstr_eq(type_str, "TargetArch") == 1 or pass8_cstr_eq(type_str, "TargetOS") == 1 or pass8_cstr_eq(type_str, "TargetABI") == 1 or pass8_cstr_eq(type_str, "DiagnosticLevel") == 1 or pass8_cstr_eq(type_str, "HirKind") == 1 or pass8_cstr_eq(type_str, "ParamMode") == 1 or pass8_cstr_eq(type_str, "Option") == 1 or pass8_cstr_eq(type_str, "Result") == 1 do
        out TypeKind.Enum
    end
    let c0 = pass8_str_byte_at(type_str, 0)
    if c0 == 38 do
        if pass8_strlen(type_str) > 4 and pass8_str_byte_at(type_str, 1) == 109 and pass8_str_byte_at(type_str, 2) == 117 and pass8_str_byte_at(type_str, 3) == 116 do
            out TypeKind.MutRef
        else
            out TypeKind.Ref
        end
    end
    if c0 == 91 do
        out TypeKind.Array
    end
    if c0 >= 65 and c0 <= 90 do
        out TypeKind.Entity
    end
    out TypeKind.Int
end.

func pass8_ast_type(n: &AstNode):
    if (n as i64) == 0 do out 0 as AstType end
    out native_read_i64(n as i64, 16) as AstType
end.

func pass8_ast_line(n: &AstNode):
    if (n as i64) == 0 do out 0 end
    out native_read_i64(n as i64, 32)
end.

func pass8_ast_int_val(n: &AstNode):
    if (n as i64) == 0 do out 0 end
    out native_read_i64(n as i64, 40)
end.

func pass8_ast_children(n: &AstNode):
    if (n as i64) == 0 do out 0 end
    out native_read_i64(n as i64, 64)
end.

# ═══════════════════════════════════════════════════════
# Boxed Vector Helpers (Pointer-safe across recursive walks)
# Box layout: [0]=vec, [8]=lazy name→item hash (256 chain heads).
# Avoids O(n²) linear scans on var_types / moved / locals / borrows.
# ═══════════════════════════════════════════════════════

const PASS8_BUCKETS: int = 256
const PASS8_BUCKET_MASK: int = 255

func pass8_hash_name(name: int):
    let n = pass8_strlen(name)
    if n <= 0 do
        out 0
    end
    var h = (n * 17) and PASS8_BUCKET_MASK
    var i = 0
    when i < n loop
        h = (h * 131 + pass8_str_byte_at(name, i)) and PASS8_BUCKET_MASK
        i = i + 1
    end
    out h
end.

func pass8_map_new():
    let heads = vir_alloc(PASS8_BUCKETS * 8)
    var i = 0
    when i < PASS8_BUCKETS loop
        native_write_i64(heads, i * 8, 0)
        i = i + 1
    end
    out heads
end.

func pass8_box_new():
    let p = vir_alloc(16)
    native_write_i64(p, 0, vec_new_rt())
    native_write_i64(p, 8, 0)
    out p
end.

func pass8_box_map(b: int):
    out native_read_i64(b, 8)
end.

func pass8_box_ensure_map(b: int):
    var ht = native_read_i64(b, 8)
    if ht == 0 do
        ht = pass8_map_new()
        native_write_i64(b, 8, ht)
    end
    out ht
end.

# Chain node: [0]=next, [8]=item ptr
func pass8_map_index(ht: int, name: int, item: int):
    if pass8_strlen(name) == 0 do
        out 0
    end
    if ht == 0 do
        out 0
    end
    let bid = pass8_hash_name(name)
    let node = vir_alloc(16)
    native_write_i64(node, 0, native_read_i64(ht, bid * 8))
    native_write_i64(node, 8, item as i64)
    native_write_i64(ht, bid * 8, node)
    out 0
end.

func pass8_map_unindex_one(ht: int, name: int, item: int):
    if ht == 0 or pass8_strlen(name) == 0 do
        out 0
    end
    let bid = pass8_hash_name(name)
    var prev = 0
    var node = native_read_i64(ht, bid * 8)
    var nxt = 0
    var it = 0
    when node != 0 loop
        if pass8_is_heap_ptr(node) == 0 do
            out 0
        end
        nxt = native_read_i64(node, 0)
        it = native_read_i64(node, 8)
        if it == item as i64 do
            if prev == 0 do
                native_write_i64(ht, bid * 8, nxt)
            else
                native_write_i64(prev, 0, nxt)
            end
            out 0
        end
        prev = node
        node = nxt
    end
    out 0
end.

func pass8_map_find(ht: int, name: int):
    if ht == 0 or pass8_strlen(name) == 0 do
        out 0
    end
    let bid = pass8_hash_name(name)
    var node = native_read_i64(ht, bid * 8)
    var it = 0
    var nm_ptr = 0
    when node != 0 loop
        if pass8_is_heap_ptr(node) == 0 do
            out 0
        end
        it = native_read_i64(node, 8)
        if pass8_is_heap_ptr(it) == 1 do
            nm_ptr = native_read_i64(it, 0)
            if nm_ptr == name do
                out it
            end
            if pass8_streq(nm_ptr, name) == 1 do
                out it
            end
        end
        node = native_read_i64(node, 0)
    end
    out 0
end.

func pass8_map_count(ht: int, name: int):
    if ht == 0 or pass8_strlen(name) == 0 do
        out 0
    end
    let bid = pass8_hash_name(name)
    var total = 0
    var node = native_read_i64(ht, bid * 8)
    var it = 0
    var nm_ptr = 0
    when node != 0 loop
        if pass8_is_heap_ptr(node) == 0 do
            out total
        end
        it = native_read_i64(node, 8)
        if pass8_is_heap_ptr(it) == 1 do
            nm_ptr = native_read_i64(it, 0)
            if nm_ptr == name or pass8_streq(nm_ptr, name) == 1 do
                total = total + 1
            end
        end
        node = native_read_i64(node, 0)
    end
    out total
end.

func pass8_box_len(b: int):
    let v = native_read_i64(b, 0)
    out vec_len_rt(v)
end.

func pass8_box_get(b: int, i: int):
    let v = native_read_i64(b, 0)
    out vec_get_rt(v, i)
end.

func pass8_box_set(b: int, i: int, val: int):
    let v = native_read_i64(b, 0)
    vec_set_rt(v, i, val)
end.

func pass8_box_push(b: int, val: int):
    var v = native_read_i64(b, 0)
    v = vec_push_rt(v, val)
    native_write_i64(b, 0, v)
end.

func pass8_box_pop(b: int):
    let v = native_read_i64(b, 0)
    out vec_pop_rt(v)
end.

func pass8_box_truncate_to(b: int, watermark: int):
    let v = native_read_i64(b, 0)
    var popped = 0
    when vec_len_rt(v) > watermark loop
        popped = vec_pop_rt(v)
    end
end.

# ═══════════════════════════════════════════════════════
# VarItem and BorrowBinding Layouts
# ═══════════════════════════════════════════════════════

func pass8_streq(a: int, b: int):
    if a < 4096 or b < 4096 do
        out 0
    end
    if pass8_is_packed_ascii_word(a) == 1 or pass8_is_packed_ascii_word(b) == 1 do
        out 0
    end
    let fa = pass8_str_is_fat(a)
    let fb = pass8_str_is_fat(b)
    if fa == 1 and fb == 1 do
        out fat_str_eq(a as string, b as string) == 1
    end
    if fa == 1 and fb == 0 do
        out fat_cstr_eq(a as string, b) == 1
    end
    if fa == 0 and fb == 1 do
        out fat_cstr_eq(b as string, a) == 1
    end
    out rt_streq(a, b) == 1
end.

func pass8_item_name(item: int):
    if pass8_is_heap_ptr(item) == 0 do
        out 0
    end
    out native_read_i64(item, 0)
end.

func pass8_box_find(b: int, name: int):
    if b == 0 or pass8_strlen(name) == 0 do
        out 0
    end
    let v = native_read_i64(b, 0)
    let n = vec_len_rt(v)
    var i = 0
    when i < n loop
        let item = vec_get_rt(v, i)
        if pass8_streq(pass8_item_name(item), name) == 1 do
            out item
        end
        i = i + 1
    end
    out 0
end.

func pass8_box_count_name(b: int, name: int):
    if b == 0 or pass8_strlen(name) == 0 do
        out 0
    end
    let v = native_read_i64(b, 0)
    let n = vec_len_rt(v)
    var total = 0
    var i = 0
    when i < n loop
        let item = vec_get_rt(v, i)
        if pass8_streq(pass8_item_name(item), name) == 1 do
            total = total + 1
        end
        i = i + 1
    end
    out total
end.

func pass8_cstr_eq(s: int, cstr: string):
    if s < 4096 do
        out 0
    end
    if pass8_is_packed_ascii_word(s) == 1 do
        out 0
    end
    if pass8_str_is_fat(s) == 1 do
        out fat_cstr_eq(s, cstr)
    end
    out rt_streq(s, cstr)
end.

func pass8_str_is_fat(s: int):
    if s < 4096 do
        out 0
    end
    if pass8_is_packed_ascii_word(s) == 1 do
        out 0
    end
    let data_ptr = native_read_i64(s, 0)
    let n = native_read_i64(s, 8)
    if data_ptr >= 4096 and n >= 0 and n < 1048576 do
        out 1
    end
    out 0
end.

func pass8_strlen(s: int):
    if s < 4096 do
        out 0
    end
    if pass8_is_packed_ascii_word(s) == 1 do
        out 0
    end
    if pass8_str_is_fat(s) == 1 do
        out fat_str_len(s as string)
    end
    out rt_strlen(s)
end.

func pass8_str_byte_at(s: int, index: int):
    if s < 4096 do
        out 0
    end
    if pass8_is_packed_ascii_word(s) == 1 do
        out 0
    end
    if pass8_str_is_fat(s) == 1 do
        out fat_str_byte_at(s as string, index)
    end
    out native_read_u8(s, index)
end.

func pass8_str_starts_with(s: int, prefix: int) -> int:
    let slen = pass8_strlen(s)
    let plen = pass8_strlen(prefix)
    if plen > slen do out 0 end
    var i = 0
    when i < plen loop
        if pass8_str_byte_at(s, i) != pass8_str_byte_at(prefix, i) do
            out 0
        end
        i = i + 1
    end
    out 1
end.

func pass8_str_contains(s: int, sub: int) -> int:
    let slen = pass8_strlen(s)
    let sublen = pass8_strlen(sub)
    if sublen > slen do out 0 end
    var i = 0
    let limit = slen - sublen
    when i <= limit loop
        var j = 0
        var matched = 1
        when j < sublen loop
            if pass8_str_byte_at(s, i + j) != pass8_str_byte_at(sub, j) do
                matched = 0
                j = sublen
            end
            j = j + 1
        end
        if matched == 1 do out 1 end
        i = i + 1
    end
    out 0
end.


func pass8_is_packed_ascii_word(v: int):
    if v < 4096 do
        out 0
    end
    var i = 0
    var printable = 0
    var zeros = 0
    var other = 0
    when i < 8 loop
        let b = (v shr (i * 8)) and 255
        if b >= 32 and b <= 126 do
            printable = printable + 1
        eif b == 0 do
            zeros = zeros + 1
        else
            other = other + 1
        end
        i = i + 1
    end
    if other == 0 and printable >= 1 do
        out 1
    end
    out 0
end.

func pass8_is_heap_ptr(v: int):
    if v < 4294967296 do
        out 0
    end
    if pass8_is_packed_ascii_word(v) == 1 do
        out 0
    end
    out 1
end.

func var_item_new(name: int, val: int):
    let p = vir_alloc(16)
    native_write_i64(p, 0, name)
    native_write_i64(p, 8, val as i64)
    out p
end.

func var_item_name(item: int):
    if pass8_is_heap_ptr(item) == 0 do
        out 0
    end
    out native_read_i64(item, 0)
end.

func var_item_val(item: int):
    if pass8_is_heap_ptr(item) == 0 do
        out 0
    end
    out native_read_i64(item, 8)
end.

func var_item_set_val(item: int, val: int):
    if pass8_is_heap_ptr(item) == 1 do
        native_write_i64(item, 8, val as i64)
    end
end.

func borrow_binding_new(lhs: int, target: int, kind: int):
    let p = vir_alloc(24)
    native_write_i64(p, 0, lhs)
    native_write_i64(p, 8, target)
    native_write_i64(p, 16, kind as i64)
    out p
end.

func borrow_binding_lhs(b: int):
    if pass8_is_heap_ptr(b) == 0 do
        out 0
    end
    out native_read_i64(b, 0)
end.

func borrow_binding_target(b: int):
    if pass8_is_heap_ptr(b) == 0 do
        out 0
    end
    out native_read_i64(b, 8)
end.

func borrow_binding_kind(b: int):
    if pass8_is_heap_ptr(b) == 0 do
        out 0
    end
    out native_read_i64(b, 16)
end.

func pass8_collect_funcs(node: &AstNode, func_map: int):
    if (node as i64) == 0 do out 0 end
    let nt = pass8_ast_type(node)
    if nt == AstType.FuncDef do
        let fname = pass8_ast_name(node)
        if pass8_strlen(fname) > 0 do
            let item = var_item_new(fname, node as int)
            pass8_map_index(func_map, fname, item as int)
        end
    end
    let ch_vec = pass8_ast_children(node)
    if ch_vec != 0 do
        let count = vec_len_rt(ch_vec)
        var i = 0
        when i < count loop
            let ch = vec_get_rt(ch_vec, i)
            if nt != AstType.FuncDef do
                pass8_collect_funcs(ch, func_map)
            end
            i = i + 1
        end
    end
    out 0
end.

func pass8_find_func(fname: string):
    if g_pass8_func_map == 0 or pass8_strlen(fname) == 0 do
        out 0 as AstNode
    end
    let item = pass8_map_find(g_pass8_func_map, fname)
    if item != 0 do
        out var_item_val(item) as AstNode
    end
    out 0 as AstNode
end.

func pass8_get_param(fn_node: &AstNode, param_idx: int):
    if (fn_node as i64) == 0 or param_idx < 0 do
        out 0 as AstNode
    end
    let ch_vec = pass8_ast_children(fn_node)
    if ch_vec == 0 do
        out 0 as AstNode
    end
    let count = vec_len_rt(ch_vec)
    var cur_idx = 0
    var i = 0
    when i < count loop
        let ch = vec_get_rt(ch_vec, i)
        let t = pass8_ast_type(ch)
        if t == AstType.ParamDef or t == AstType.RefParam or t == AstType.OutParam do
            if cur_idx == param_idx do
                out ch
            end
            cur_idx = cur_idx + 1
        eif t == AstType.Identifier do
            if cur_idx == param_idx do
                out ch
            end
            cur_idx = cur_idx + 1
        eif t == AstType.Block do
            out 0 as AstNode
        end
        i = i + 1
    end
    out 0 as AstNode
end.

func pass8_analyze_borrow(ref symbols: SymbolTable, ref scopes: ScopeTree, diag: &DiagnosticEngine, node: &AstNode):
    g_pass8_func_map = pass8_map_new()
    g_pass8_shadow_frames = pass8_box_new()
    pass8_collect_funcs(node, g_pass8_func_map)
    let moved_vars = pass8_box_new()
    let shared_borrows = pass8_box_new()
    let mut_borrows = pass8_box_new()
    let bound_borrows = pass8_box_new()
    let arena_locals = pass8_box_new()
    let pre_arena_names = pass8_box_new()
    let var_types = pass8_box_new()
    let func_locals = pass8_box_new()
    pass8_walk(symbols, scopes, diag, node, moved_vars, shared_borrows, mut_borrows,
               bound_borrows, arena_locals, pre_arena_names, 0, var_types, func_locals)
end.

func pass8_is_moved(moved_vars: int, name: int):
    if pass8_strlen(name) == 0 do
        out 0
    end
    if pass8_box_find(moved_vars, name) != 0 do
        out 1
    end
    out 0
end.

func pass8_mark_moved(moved_vars: int, name: int):
    out pass8_mark_moved_at(moved_vars, name, 0)
end.

func pass8_mark_moved_at(moved_vars: int, name: int, line: int):
    if pass8_strlen(name) == 0 do
        out 0
    end
    if pass8_is_moved(moved_vars, name) == 0 do
        let moved_item = var_item_new(name, line)
        pass8_box_push(moved_vars, moved_item as i64)
    end
    out 0
end.

func pass8_moved_line(moved_vars: int, name: int):
    let item = pass8_box_find(moved_vars, name)
    if item == 0 do out 0 end
    out var_item_val(item)
end.

func pass8_record_local_binding(moved_vars: int, name: int):
    if g_pass8_shadow_frames == 0 or pass8_box_len(g_pass8_shadow_frames) == 0 do out 0 end
    let frame = pass8_box_get(g_pass8_shadow_frames, pass8_box_len(g_pass8_shadow_frames) - 1)
    let saved = var_item_new(name, pass8_moved_line(moved_vars, name))
    pass8_box_push(frame, saved)
    pass8_unmark_moved(moved_vars, name)
end.

func pass8_restore_local_bindings(moved_vars: int, frame: int):
    var i = pass8_box_len(frame) - 1
    when i >= 0 loop
        let saved = pass8_box_get(frame, i)
        let name = var_item_name(saved)
        pass8_unmark_moved(moved_vars, name)
        let prior_line = var_item_val(saved)
        if prior_line > 0 do pass8_mark_moved_at(moved_vars, name, prior_line) end
        i = i - 1
    end
end.

func pass8_paths_overlap(left: int, right: int):
    let nl = pass8_strlen(left)
    let nr = pass8_strlen(right)
    if nl == 0 or nr == 0 do out 0 end
    var common = nl
    if nr < common do common = nr end
    var i = 0
    when i < common loop
        if fat_str_byte_at(left, i) != fat_str_byte_at(right, i) do out 0 end
        i = i + 1
    end
    if nl == nr do out 1 end
    if nl < nr do out fat_str_byte_at(right, nl) == 46 end
    out fat_str_byte_at(left, nr) == 46
end.

func pass8_conflicting_borrow_line(borrows: int, target: int):
    var i = 0
    let count = pass8_box_len(borrows)
    when i < count loop
        let item = pass8_box_get(borrows, i)
        if pass8_paths_overlap(var_item_name(item), target) == 1 do
            out var_item_val(item)
        end
        i = i + 1
    end
    out 0
end.

func pass8_borrow_line(borrows: int, name: int):
    out pass8_conflicting_borrow_line(borrows, name)
end.

func pass8_first_borrow_line(borrows: int):
    if pass8_box_len(borrows) == 0 do out 0 end
    out var_item_val(pass8_box_get(borrows, 0))
end.

func pass8_unmark_moved(moved_vars: int, name: int):
    if pass8_strlen(name) == 0 do
        out 0
    end
    let item = pass8_box_find(moved_vars, name)
    if item == 0 do
        out 0
    end
    let count = pass8_box_len(moved_vars)
    var i = 0
    var v = 0
    when i < count loop
        if pass8_box_get(moved_vars, i) == item do
            if i < count - 1 do
                pass8_box_set(moved_vars, i, pass8_box_get(moved_vars, count - 1))
            end
            # Truncate without re-unindexing the swapped tail: pop raw.
            v = native_read_i64(moved_vars, 0)
            vec_pop_rt(v)
            out 0
        end
        i = i + 1
    end
    out 0
end.

# Capture the moves introduced after a watermark.  The snapshot only lives
# while an if-statement is joined; merging creates fresh entries in the
# destination set, so the branch state itself never escapes.
func pass8_snapshot_moved_since(moved_vars: int, watermark: int):
    let snapshot = pass8_box_new()
    let count = pass8_box_len(moved_vars)
    var i = watermark
    when i < count loop
        let snap_item = pass8_box_get(moved_vars, i)
        pass8_box_push(snapshot, snap_item)
        i = i + 1
    end
    out snapshot
end.

func pass8_merge_moved(moved_vars: int, snapshot: int):
    let count = pass8_box_len(snapshot)
    var i = 0
    when i < count loop
        let item = pass8_box_get(snapshot, i)
        let name = var_item_name(item)    # returns int
        if pass8_strlen(name) > 0 do
            pass8_mark_moved_at(moved_vars, name, var_item_val(item))
        end
        i = i + 1
    end
    out 0
end.

func pass8_vec_contains(names: int, name: int):
    if pass8_strlen(name) == 0 do
        out 0
    end
    if pass8_box_find(names, name) != 0 do
        out 1
    end
    out 0
end.

func pass8_borrow_count(borrows: int, name: int):
    if borrows == 0 or pass8_strlen(name) == 0 do
        out 0
    end
    let v = native_read_i64(borrows, 0)
    let n = vec_len_rt(v)
    var total = 0
    var i = 0
    when i < n loop
        let item = vec_get_rt(v, i)
        if pass8_paths_overlap(var_item_name(item), name) == 1 do
            total = total + 1
        end
        i = i + 1
    end
    out total
end.

func pass8_truncate_to(lst: int, watermark: int):
    pass8_box_truncate_to(lst, watermark)
end.

func pass8_remove_one_borrow(borrows: int, name: int):
    if pass8_strlen(name) == 0 do
        out 0
    end
    let item = pass8_box_find(borrows, name)
    if item == 0 do
        out 0
    end
    let len = pass8_box_len(borrows)
    var i = len - 1
    var v = 0
    when i >= 0 loop
        if pass8_box_get(borrows, i) == item do
            if i < len - 1 do
                pass8_box_set(borrows, i, pass8_box_get(borrows, len - 1))
            end
            v = native_read_i64(borrows, 0)
            vec_pop_rt(v)
            out 0
        end
        i = i - 1
    end
    out 0
end.

func pass8_release_borrower(bound_borrows: int, shared_borrows: int, mut_borrows: int, borrower: int):
    if pass8_strlen(borrower) == 0 do
        out 0
    end
    let b = pass8_box_find(bound_borrows, borrower)
    if b == 0 do
        out 0
    end
    if borrow_binding_kind(b) == 2 do
        pass8_remove_one_borrow(mut_borrows, borrow_binding_target(b))
    else
        pass8_remove_one_borrow(shared_borrows, borrow_binding_target(b))
    end
    let len = pass8_box_len(bound_borrows)
    var i = 0
    var v = 0
    when i < len loop
        if pass8_box_get(bound_borrows, i) == b do
            if i < len - 1 do
                pass8_box_set(bound_borrows, i, pass8_box_get(bound_borrows, len - 1))
            end
            v = native_read_i64(bound_borrows, 0)
            vec_pop_rt(v)
            out 0
        end
        i = i + 1
    end
    out 0
end.

func pass8_claim_borrow(bound_borrows: int, borrower: int, target: int, kind: int):
    let binding = borrow_binding_new(borrower, target, kind)
    pass8_box_push(bound_borrows, binding as i64)
end.

func pass8_register_var_type(var_types: int, name: int, kind: TypeKind):
    if pass8_strlen(name) == 0 do
        out 0
    end
    let item = pass8_box_find(var_types, name)
    if item != 0 do
        var_item_set_val(item, kind as int)
        out 0
    end
    let type_item = var_item_new(name, kind as int)
    pass8_box_push(var_types, type_item as i64)
    out 0
end.

func pass8_get_var_type(var_types: int, name: int):
    if pass8_strlen(name) == 0 do
        out TypeKind.Void
    end
    let item = pass8_box_find(var_types, name)
    if item != 0 do
        out var_item_val(item) as TypeKind
    end
    out TypeKind.Void
end.

func pass8_infer_expr_type(var_types: int, expr: &AstNode):
    if (expr as i64) == 0 do
        out TypeKind.Void
    end
    let t = pass8_ast_type(expr)
    if t == AstType.ArrayLiteral do
        out TypeKind.Array
    end
    if t == AstType.DictLiteral do
        out TypeKind.Dict
    end
    if t == AstType.LiteralStr or t == AstType.InterpExpr do
        out TypeKind.String
    end
    if t == AstType.EntityLiteral do
        out TypeKind.Entity
    end
    if t == AstType.LiteralInt do
        out TypeKind.Int
    end
    if t == AstType.LiteralFloat do
        out TypeKind.Float
    end
    if t == AstType.LiteralBool do
        out TypeKind.Bool
    end
    if t == AstType.LiteralNone do
        out TypeKind.None
    end
    if t == AstType.Identifier do
        out pass8_get_var_type(var_types, pass8_ast_name(expr))
    end
    if t == AstType.AddrOf do
        if pass8_cstr_eq(pass8_ast_name(expr), "mut") == 1 do
            out TypeKind.MutRef
        else
            out TypeKind.Ref
        end
    end
    out TypeKind.Void
end.

func pass8_expr_has_arena_local(expr: &AstNode, arena_locals: int, in_arena: int):
    if (expr as i64) == 0 do
        out 0
    end
    if pass8_ast_type(expr) == AstType.Identifier do
        if pass8_vec_contains(arena_locals, pass8_ast_name(expr)) == 1 do
            out 1
        end
        out 0
    end
    let child_count = vec_len_rt(pass8_ast_children(expr))
    var i = 0
    when i < child_count loop
        let child = vec_get_rt(pass8_ast_children(expr), i)
        if pass8_expr_has_arena_local(child, arena_locals, in_arena) == 1 do
            out 1
        end
        i = i + 1
    end
    out 0
end.

func pass8_check_arena_escape_assign(diag: &DiagnosticEngine, lhs: string, rhs: &AstNode,
                                     arena_locals: int, pre_arena_names: int, in_arena: int, line: int):
    # Owned values may escape by being moved or assigned to a longer-lived owner (Spec §4.5–§4.8.5).
    # Borrow escapes are strictly rejected with E5005.
    if in_arena == 1 and pass8_vec_contains(pre_arena_names, lhs) == 1 do
        if (rhs as i64) != 0 do
            var rhs_esc = rhs
            when (rhs_esc as i64) != 0 and pass8_ast_type(rhs_esc) == AstType.CastExpr and vec_len_rt(pass8_ast_children(rhs_esc)) > 0 loop
                rhs_esc = vec_get_rt(pass8_ast_children(rhs_esc), 0) as AstNode
            end
            let rt = pass8_ast_type(rhs_esc)
            if rt == AstType.AddrOf do
                let tgt = pass8_get_addr_target(rhs_esc)
                if pass8_strlen(tgt) > 0 and pass8_vec_contains(arena_locals, tgt) == 1 do
                    report_error(diag, 5005, line, 0)
                    out 1
                end
            end
            if pass8_expr_has_arena_local(rhs_esc, arena_locals, in_arena) == 1 and rt == AstType.AddrOf do
                report_error(diag, 5005, line, 0)
                out 1
            end
        end
    end
    out 0
end.

func pass8_register_arena_local(arena_locals: int, pre_arena_names: int, name: string, in_arena: int):
    if pass8_strlen(name) == 0 do
        out 0
    end
    if in_arena == 0 do
        if pass8_vec_contains(pre_arena_names, name) == 0 do
            let pre_item = var_item_new(name, 0)
            pass8_box_push(pre_arena_names, pre_item as i64)
        end
        out 0
    end
    if pass8_vec_contains(pre_arena_names, name) == 1 do
        out 0
    end
    if pass8_vec_contains(arena_locals, name) == 0 do
        let arena_item = var_item_new(name, 0)
        pass8_box_push(arena_locals, arena_item as i64)
    end
    out 0
end.

func pass8_check_arena_borrow_escape(diag: &DiagnosticEngine, arena_locals: int, pre_arena_names: int,
                                     bound_borrows: int, line: int):
    let count = pass8_box_len(bound_borrows)
    var i = 0
    when i < count loop
        let b = pass8_box_get(bound_borrows, i)
        let tgt = borrow_binding_target(b)
        let lhs = borrow_binding_lhs(b)
        if pass8_vec_contains(arena_locals, tgt) == 1 do
            if pass8_vec_contains(pre_arena_names, lhs) == 1 do
                report_error(diag, 5005, line, 0)
            end
        end
        i = i + 1
    end
    out 0
end.

func pass8_end_stmt(shared_borrows: int, mut_borrows: int, shared_wm: int, mut_wm: int, claimed: int):
    if claimed == 0 do
        pass8_truncate_to(shared_borrows, shared_wm)
        pass8_truncate_to(mut_borrows, mut_wm)
    end
    out 0
end.

func pass8_owner_path(node: &AstNode):
    if (node as i64) == 0 do out fat_str_new("") end
    let nt = pass8_ast_type(node)
    if nt == AstType.Identifier do out pass8_ast_name(node) end
    if nt == AstType.FieldAccess and vec_len_rt(pass8_ast_children(node)) > 0 do
        let base = pass8_owner_path(vec_get_rt(pass8_ast_children(node), 0))
        if pass8_strlen(base) == 0 do out base end
        out fat_str_concat(fat_str_concat(base, fat_str_new(".")), pass8_ast_name(node))
    end
    out fat_str_new("")
end.

func pass8_get_addr_target(node: i64):
    if (node as i64) == 0 do
        out fat_str_new("")
    end
    if pass8_ast_type(node) != AstType.AddrOf do
        out fat_str_new("")
    end
    let child_count = vec_len_rt(pass8_ast_children(node))
    if child_count < 1 do
        out fat_str_new("")
    end
    out pass8_owner_path(vec_get_rt(pass8_ast_children(node), 0))
end.

func pass8_root_owner(path: string) -> string:
    let n = pass8_strlen(path)
    if n == 0 do out path end
    var dot_pos = -1
    var i = 0
    when i < n loop
        if fat_str_byte_at(path, i) == 46 do
            dot_pos = i
            i = n
        else
            i = i + 1
        end
    end
    if dot_pos <= 0 do
        out path
    end
    out fat_str_slice(path as int, 0, dot_pos) as string
end.

func pass8_resolve_borrow_root(bound_borrows: int, path: string) -> string:
    var curr = pass8_root_owner(path)
    var depth = 0
    when depth < 10 loop
        if bound_borrows != 0 do
            let binding = pass8_box_find(bound_borrows, curr)
            if binding != 0 do
                let tgt = borrow_binding_target(binding)
                if pass8_strlen(tgt) > 0 do
                    curr = pass8_root_owner(tgt)
                else
                    depth = 10
                end
            else
                depth = 10
            end
        else
            depth = 10
        end
        depth = depth + 1
    end
    out curr
end.

func pass8_handle_addr_of(ref symbols: SymbolTable, ref scopes: ScopeTree, diag: &DiagnosticEngine,
                          node: i64, moved_vars: int, shared_borrows: int, mut_borrows: int,
                          bound_borrows: int, arena_locals: int, pre_arena_names: int, in_arena: int,
                          var_types: int, func_locals: int):
    let child_count = vec_len_rt(pass8_ast_children(node))
    if child_count < 1 do
        out fat_str_new("")
    end
    let child = vec_get_rt(pass8_ast_children(node), 0)
    if pass8_ast_type(child) != AstType.Identifier do
        pass8_walk(symbols, scopes, diag, child, moved_vars, shared_borrows, mut_borrows,
                   bound_borrows, arena_locals, pre_arena_names, in_arena, var_types, func_locals)
    end
    let tgt = pass8_owner_path(child)
    if pass8_strlen(tgt) == 0 do
        out fat_str_new("")
    end
    if pass8_is_moved(moved_vars, tgt) == 1 do
        report_error(diag, 5004, pass8_ast_line(node), 0)
        out fat_str_new("")
    end
    var is_mut = 0
    if pass8_cstr_eq(pass8_ast_name(node), "mut") == 1 do
        is_mut = 1
    end
    if is_mut == 1 do
        let shared_line = pass8_conflicting_borrow_line(shared_borrows, tgt)
        if shared_line > 0 do
            report_error_related(diag, 5002, pass8_ast_line(node), 0, tgt,
                                 shared_line, 0, "Shared borrow started here")
        end
        let mut_line = pass8_conflicting_borrow_line(mut_borrows, tgt)
        if mut_line > 0 do
            report_error_related(diag, 5003, pass8_ast_line(node), 0, tgt,
                                 mut_line, 0, "Mutable borrow started here")
        end
        let mut_item = var_item_new(tgt, pass8_ast_line(node))
        pass8_box_push(mut_borrows, mut_item as i64)
    else
        let mut_line = pass8_conflicting_borrow_line(mut_borrows, tgt)
        if mut_line > 0 do
            report_error_related(diag, 5006, pass8_ast_line(node), 0, tgt,
                                 mut_line, 0, "Mutable borrow started here")
        end
        let shared_item = var_item_new(tgt, pass8_ast_line(node))
        pass8_box_push(shared_borrows, shared_item as i64)
    end
    out tgt
end.

func pass8_process_binding_rhs(ref symbols: SymbolTable, ref scopes: ScopeTree, diag: &DiagnosticEngine,
                               rhs: AstNode, moved_vars: int, shared_borrows: int, mut_borrows: int,
                               bound_borrows: int, lhs: string, arena_locals: int, pre_arena_names: int, in_arena: int,
                               var_types: int, func_locals: int):
    var claimed = 0
    var borrow_tgt = fat_str_new("")
    var borrow_kind = 0

    if pass8_ast_type(rhs) == AstType.AddrOf do
        borrow_tgt = pass8_handle_addr_of(symbols, scopes, diag, rhs, moved_vars,
                                          shared_borrows, mut_borrows, bound_borrows,
                                          arena_locals, pre_arena_names, in_arena, var_types, func_locals)
        if pass8_strlen(borrow_tgt) > 0 do
            if pass8_cstr_eq(pass8_ast_name(rhs), "mut") == 1 do
                borrow_kind = 2
            else
                borrow_kind = 1
            end
            pass8_claim_borrow(bound_borrows, lhs, borrow_tgt, borrow_kind)
            claimed = 1
        end
    else
        pass8_walk(symbols, scopes, diag, rhs, moved_vars, shared_borrows, mut_borrows,
                   bound_borrows, arena_locals, pre_arena_names, in_arena, var_types, func_locals)
        if pass8_ast_type(rhs) == AstType.Identifier do
            let rhs_name = pass8_ast_name(rhs)
            if pass8_is_moved(moved_vars, rhs_name) == 1 do
                report_error_related(diag, 5001, pass8_ast_line(rhs), 0, rhs_name,
                                     pass8_moved_line(moved_vars, rhs_name), 0, "Value was moved here")
            else
                if pass8_borrow_count(shared_borrows, rhs_name) > 0 or pass8_borrow_count(mut_borrows, rhs_name) > 0 do
                    var borrow_line = pass8_borrow_line(shared_borrows, rhs_name)
                    if borrow_line == 0 do borrow_line = pass8_borrow_line(mut_borrows, rhs_name) end
                    report_error_related(diag, 5008, pass8_ast_line(rhs), 0, rhs_name,
                                         borrow_line, 0, "Borrow started here")
                end
                let rhs_type = pass8_get_var_type(var_types, rhs_name)
                if type_is_move(rhs_type) do
                    pass8_mark_moved_at(moved_vars, rhs_name, pass8_ast_line(rhs))
                end
            end
        end
    end
    out claimed
end.

func pass8_tree_uses_ident(node: &AstNode, name: string) -> int:
    if (node as i64) == 0 do out 0 end
    if pass8_ast_type(node) == AstType.Identifier do
        if pass8_streq(pass8_ast_name(node), name) == 1 do
            out 1
        end
    end
    let ch_vec = pass8_ast_children(node)
    if ch_vec != 0 do
        let count = vec_len_rt(ch_vec)
        var i = 0
        when i < count loop
            let ch = vec_get_rt(ch_vec, i)
            if pass8_tree_uses_ident(ch, name) == 1 do
                out 1
            end
            i = i + 1
        end
    end
    out 0
end.

func pass8_has_await(node: &AstNode) -> int:
    if (node as i64) == 0 do out 0 end
    if pass8_ast_type(node) == AstType.AwaitExpr do out 1 end
    let ch_vec = pass8_ast_children(node)
    if ch_vec != 0 do
        let count = vec_len_rt(ch_vec)
        var i = 0
        when i < count loop
            if pass8_has_await(vec_get_rt(ch_vec, i)) == 1 do out 1 end
            i = i + 1
        end
    end
    out 0
end.

func pass8_branch_terminates(node: &AstNode) -> int:
    if (node as i64) == 0 do out 0 end
    let nt = pass8_ast_type(node)
    if nt == AstType.ReturnStmt or nt == AstType.ThrowStmt or nt == AstType.BreakStmt or nt == AstType.ContinueStmt do
        out 1
    end
    if nt == AstType.Block do
        let ch_vec = pass8_ast_children(node)
        if ch_vec != 0 do
            let count = vec_len_rt(ch_vec)
            var i = 0
            when i < count loop
                let ch = vec_get_rt(ch_vec, i)
                if pass8_branch_terminates(ch) == 1 do
                    out 1
                end
                i = i + 1
            end
        end
    end
    if nt == AstType.IfStmt do
        let ch_vec = pass8_ast_children(node)
        if ch_vec != 0 do
            let count = vec_len_rt(ch_vec)
            if count > 2 do
                let then_ch = vec_get_rt(ch_vec, 1)
                let else_ch = vec_get_rt(ch_vec, 2)
                if pass8_branch_terminates(then_ch) == 1 and pass8_branch_terminates(else_ch) == 1 do
                    out 1
                end
            end
        end
    end
    out 0
end.

func pass8_walk_children_stmts(ref symbols: SymbolTable, ref scopes: ScopeTree, diag: &DiagnosticEngine,
                               node: AstNode, moved_vars: int, shared_borrows: int, mut_borrows: int,
                               bound_borrows: int, arena_locals: int, pre_arena_names: int, in_arena: int,
                               var_types: int, func_locals: int):
    let child_count = vec_len_rt(pass8_ast_children(node))
    var i = 0
    var claimed_any = 0
    when i < child_count loop
        let shared_wm = pass8_box_len(shared_borrows)
        let mut_wm = pass8_box_len(mut_borrows)
        let child = vec_get_rt(pass8_ast_children(node), i)

        # Liveness-aware borrow across await check (MEM-BOR-015):
        # A borrow whose last use precedes await must NOT be flagged.
        # Only report E5011 if an active borrow is actually referenced in this statement or subsequent statements.
        if pass8_has_await(child) == 1 do
            var bi = 0
            let b_len = pass8_box_len(bound_borrows)
            when bi < b_len loop
                let b_item = pass8_box_get(bound_borrows, bi)
                let b_name = borrow_binding_lhs(b_item)
                var used_future = 0
                var j = i
                when j < child_count loop
                    if pass8_tree_uses_ident(vec_get_rt(pass8_ast_children(node), j), b_name) == 1 do
                        used_future = 1
                        j = child_count
                    else
                        j = j + 1
                    end
                end
                if used_future == 1 do
                    report_error(diag, 5011, pass8_ast_line(child), 0)
                end
                bi = bi + 1
            end
        end

        let claimed = pass8_walk(symbols, scopes, diag, child, moved_vars, shared_borrows, mut_borrows,
                                 bound_borrows, arena_locals, pre_arena_names, in_arena, var_types, func_locals)
        if claimed == 1 do
            claimed_any = 1
        end
        pass8_end_stmt(shared_borrows, mut_borrows, shared_wm, mut_wm, claimed)
        i = i + 1
    end
    out claimed_any
end.

func pass8_walk(ref symbols: SymbolTable, ref scopes: ScopeTree, diag: &DiagnosticEngine, node: &AstNode,
                moved_vars: int, shared_borrows: int, mut_borrows: int,
                bound_borrows: int, arena_locals: int, pre_arena_names: int, in_arena: int,
                var_types: int, func_locals: int):
    if (node as i64) == 0 do
        out 0
    end

    # 1. Identifier — check use of moved value
    if pass8_ast_type(node) == AstType.Identifier do
        if pass8_strlen(pass8_ast_name(node)) > 0 do
            if pass8_is_moved(moved_vars, pass8_ast_name(node)) == 1 do
                report_error_related(diag, 5001, pass8_ast_line(node), 0, pass8_ast_name(node),
                                     pass8_moved_line(moved_vars, pass8_ast_name(node)), 0, "Value was moved here")
            end
        end
    end

    # 1b. IndexAccess — check use of moved base container
    if pass8_ast_type(node) == AstType.IndexAccess do
        let base_name = pass8_ast_name(node)
        if pass8_strlen(base_name) > 0 do
            if pass8_is_moved(moved_vars, base_name) == 1 do
                report_error_related(diag, 5001, pass8_ast_line(node), 0, base_name,
                                     pass8_moved_line(moved_vars, base_name), 0, "Value was moved here")
            end
        end
    end

    # 1c. AwaitExpr — temporary borrow directly inside await expression
    if pass8_ast_type(node) == AstType.AwaitExpr do
        let aw_count = vec_len_rt(pass8_ast_children(node))
        var ai = 0
        when ai < aw_count loop
            let ach = vec_get_rt(pass8_ast_children(node), ai)
            if pass8_ast_type(ach) == AstType.AddrOf do
                report_error(diag, 5011, pass8_ast_line(node), 0)
            end
            ai = ai + 1
        end
    end

    # 2. AddrOf
    if pass8_ast_type(node) == AstType.AddrOf do
        pass8_handle_addr_of(symbols, scopes, diag, node, moved_vars, shared_borrows, mut_borrows,
                             bound_borrows, arena_locals, pre_arena_names, in_arena, var_types, func_locals)
        out 0
    end

    # 3. Variable Assignment (x = rhs)
    if pass8_ast_type(node) == AstType.Assign or pass8_ast_type(node) == AstType.SwizzleAssign do
        var assign_name = pass8_ast_name(node)
        let child_count = vec_len_rt(pass8_ast_children(node))
        var rhs = 0
        if child_count == 1 do
            rhs = vec_get_rt(pass8_ast_children(node), 0)
        eif child_count >= 2 do
            rhs = vec_get_rt(pass8_ast_children(node), 1)
            if pass8_strlen(assign_name) == 0 do
                let lhs = vec_get_rt(pass8_ast_children(node), 0)
                assign_name = pass8_ast_name(lhs)
            end
        end

        if pass8_strlen(assign_name) > 0 do
            # Cannot mutate variable while shared borrow is active
            if pass8_borrow_count(shared_borrows, assign_name) > 0 do
                report_error_related(diag, 5009, pass8_ast_line(node), 0, assign_name,
                                     pass8_borrow_line(shared_borrows, assign_name), 0, "Shared borrow started here")
            end
            # Cannot mutate variable while mutable borrow is held by another reference
            if pass8_borrow_count(mut_borrows, assign_name) > 0 do
                report_error_related(diag, 5003, pass8_ast_line(node), 0, assign_name,
                                     pass8_borrow_line(mut_borrows, assign_name), 0, "Mutable borrow started here")
            end
        end

        var claimed = 0
        if (rhs as i64) != 0 do
            if pass8_strlen(assign_name) > 0 do
                let rhs_type = pass8_infer_expr_type(var_types, rhs)
                pass8_register_var_type(var_types, assign_name, rhs_type)
                pass8_register_arena_local(arena_locals, pre_arena_names, assign_name, in_arena)
                pass8_check_arena_escape_assign(diag, assign_name, rhs, arena_locals, pre_arena_names, in_arena, pass8_ast_line(node))
            end
            if pass8_ast_type(rhs) == AstType.AddrOf do
                # Validate a rebind while the old borrow is still active.
                # Releasing it first would hide &x -> &mut x conflicts.
                let borrow_tgt = pass8_handle_addr_of(symbols, scopes, diag, rhs, moved_vars,
                                                      shared_borrows, mut_borrows, bound_borrows,
                                                      arena_locals, pre_arena_names, in_arena, var_types, func_locals)
                if pass8_strlen(assign_name) > 0 do
                    pass8_release_borrower(bound_borrows, shared_borrows, mut_borrows, assign_name)
                    pass8_unmark_moved(moved_vars, assign_name)
                end
                if pass8_strlen(borrow_tgt) > 0 do
                    var borrow_kind = 1
                    if pass8_cstr_eq(pass8_ast_name(rhs), "mut") == 1 do
                        borrow_kind = 2
                    end
                    pass8_claim_borrow(bound_borrows, assign_name, borrow_tgt, borrow_kind)
                    claimed = 1
                end
            else
                claimed = pass8_process_binding_rhs(symbols, scopes, diag, rhs, moved_vars,
                                                      shared_borrows, mut_borrows, bound_borrows,
                                                      assign_name, arena_locals, pre_arena_names, in_arena, var_types, func_locals)
                if pass8_strlen(assign_name) > 0 do
                    pass8_release_borrower(bound_borrows, shared_borrows, mut_borrows, assign_name)
                    pass8_unmark_moved(moved_vars, assign_name)
                end
            end
        end
        out claimed
    end

    if pass8_ast_type(node) == AstType.VarDeclGroup do
        let child_count = vec_len_rt(pass8_ast_children(node))
        var vi = 0
        var claimed = 0
        when vi < child_count loop
            let child = vec_get_rt(pass8_ast_children(node), vi)
            claimed = pass8_walk(symbols, scopes, diag, child, moved_vars, shared_borrows, mut_borrows,
                                bound_borrows, arena_locals, pre_arena_names, in_arena, var_types, func_locals)
            vi = vi + 1
        end
        out claimed
    end

    # 4. Variable / Constant Declaration (let x = init / var x = init)
    if pass8_ast_type(node) == AstType.VarDecl or pass8_ast_type(node) == AstType.ConstDecl do
        var claimed = 0
        let child_count = vec_len_rt(pass8_ast_children(node))
        if pass8_ast_int_val(node) == 16384 do
            var ti = 0
            when ti < child_count loop
                let tuple_child = vec_get_rt(pass8_ast_children(node), ti)
                if pass8_ast_type(tuple_child) == AstType.Identifier do
                    let tuple_name = pass8_ast_name(tuple_child)
                    pass8_record_local_binding(moved_vars, tuple_name)
                    pass8_register_arena_local(arena_locals, pre_arena_names, tuple_name, in_arena)
                    if pass8_vec_contains(func_locals, tuple_name) == 0 do
                        let tuple_item = var_item_new(tuple_name, 0)
                        pass8_box_push(func_locals, tuple_item as i64)
                    end
                    pass8_unmark_moved(moved_vars, tuple_name)
                end
                ti = ti + 1
            end
        else
            let decl_name = pass8_ast_name(node)
            if pass8_strlen(decl_name) > 0 do pass8_record_local_binding(moved_vars, decl_name) end
            pass8_register_arena_local(arena_locals, pre_arena_names, decl_name, in_arena)
            if pass8_strlen(decl_name) > 0 and pass8_vec_contains(func_locals, decl_name) == 0 do
                let decl_item = var_item_new(decl_name, 0)
                pass8_box_push(func_locals, decl_item as i64)
            end
        end
        if child_count > 0 do
            let init = vec_get_rt(pass8_ast_children(node), child_count - 1)
            var bind_name = pass8_ast_name(node)
            if pass8_ast_int_val(node) == 16384 do
                bind_name = fat_str_new("")
            end
            if pass8_strlen(bind_name) > 0 do
                let init_type = pass8_infer_expr_type(var_types, init)
                pass8_register_var_type(var_types, bind_name, init_type)
                pass8_check_arena_escape_assign(diag, bind_name, init, arena_locals, pre_arena_names, in_arena, pass8_ast_line(node))
                claimed = pass8_process_binding_rhs(symbols, scopes, diag, init, moved_vars,
                                                      shared_borrows, mut_borrows, bound_borrows,
                                                      bind_name, arena_locals, pre_arena_names, in_arena, var_types, func_locals)
                pass8_unmark_moved(moved_vars, bind_name)
            else
                pass8_walk(symbols, scopes, diag, init, moved_vars, shared_borrows, mut_borrows,
                           bound_borrows, arena_locals, pre_arena_names, in_arena, var_types, func_locals)
            end
        end
        out claimed
    end

    # 5. Function & Method Calls — by-value arguments transfer ownership.
    if pass8_ast_type(node) == AstType.Call or pass8_ast_type(node) == AstType.MethodCall do
        let call_name = pass8_ast_name(node)
        if pass8_cstr_eq(call_name, "arena_reset") == 1 or pass8_cstr_eq(call_name, "arena_free") == 1 do
            if pass8_box_len(shared_borrows) > 0 or pass8_box_len(mut_borrows) > 0 or pass8_box_len(bound_borrows) > 0 do
                var borrow_line = pass8_first_borrow_line(shared_borrows)
                if borrow_line == 0 do borrow_line = pass8_first_borrow_line(mut_borrows) end
                report_error_related(diag, 5010, pass8_ast_line(node), 0, call_name,
                                     borrow_line, 0, "Live borrow started here")
            end
        end
        let callee_fn = pass8_find_func(call_name)
        let child_count = vec_len_rt(pass8_ast_children(node))
        var i = 0
        when i < child_count loop
            let arg = vec_get_rt(pass8_ast_children(node), i)
            # Method-call child 0 is the receiver.  It is an implicit `this`
            # borrow, not a by-value argument, so repeated mutating method
            # calls must not consume the receiver.
            if pass8_ast_type(node) == AstType.MethodCall and i == 0 do
                pass8_walk(symbols, scopes, diag, arg, moved_vars, shared_borrows, mut_borrows,
                           bound_borrows, arena_locals, pre_arena_names, in_arena, var_types, func_locals)
            eif pass8_ast_type(arg) == AstType.AddrOf do
                pass8_handle_addr_of(symbols, scopes, diag, arg, moved_vars, shared_borrows, mut_borrows,
                                     bound_borrows, arena_locals, pre_arena_names, in_arena, var_types, func_locals)
            eif pass8_ast_type(arg) == AstType.Identifier do
                # Do this here instead of delegating to the generic identifier
                # visitor so a repeated call argument produces one E5001.
                let arg_name = pass8_ast_name(arg)
                if pass8_is_moved(moved_vars, arg_name) == 1 do
                    report_error_related(diag, 5001, pass8_ast_line(arg), 0, arg_name,
                                         pass8_moved_line(moved_vars, arg_name), 0, "Value was moved here")
                else
                    if pass8_borrow_count(shared_borrows, arg_name) > 0 or pass8_borrow_count(mut_borrows, arg_name) > 0 do
                        var borrow_line = pass8_borrow_line(shared_borrows, arg_name)
                        if borrow_line == 0 do borrow_line = pass8_borrow_line(mut_borrows, arg_name) end
                        report_error_related(diag, 5008, pass8_ast_line(arg), 0, arg_name,
                                             borrow_line, 0, "Borrow started here")
                    end
                    var param_idx = i
                    if pass8_ast_type(node) == AstType.MethodCall do
                        param_idx = i - 1
                    end
                    let arg_type = pass8_get_var_type(var_types, arg_name)
                    if type_is_move(arg_type) do
                        var should_move = 0
                        if (callee_fn as i64) != 0 do
                            let p_node = pass8_get_param(callee_fn, param_idx)
                            if (p_node as i64) != 0 do
                                let p_type = pass8_ast_type(p_node)
                                let p_mode = pass8_ast_int_val(p_node)
                                if p_type != AstType.RefParam and p_mode != 1 and p_type != AstType.OutParam and p_mode != 2 do
                                    let p_type_str = pass8_ast_name2(p_node)
                                    let p_kind = pass8_type_kind_from_type_str(p_type_str)
                                    if type_is_move(p_kind) do
                                        should_move = 1
                                    end
                                end
                            end
                        end
                        if should_move == 1 do
                            pass8_mark_moved_at(moved_vars, arg_name, pass8_ast_line(arg))
                        end
                    end
                end
            else
                pass8_walk(symbols, scopes, diag, arg, moved_vars, shared_borrows, mut_borrows,
                           bound_borrows, arena_locals, pre_arena_names, in_arena, var_types, func_locals)
            end
            i = i + 1
        end
        out 0
    end

    # 6. Return Statement — verify no local reference / arena reference escape
    if pass8_ast_type(node) == AstType.ReturnStmt do
        let child_count = vec_len_rt(pass8_ast_children(node))
        if child_count > 0 do
            let val = vec_get_rt(pass8_ast_children(node), 0)
            var esc_val = val
            when (esc_val as i64) != 0 and pass8_ast_type(esc_val) == AstType.CastExpr and vec_len_rt(pass8_ast_children(esc_val)) > 0 loop
                esc_val = vec_get_rt(pass8_ast_children(esc_val), 0) as AstNode
            end
            # Check local reference escape / arena borrow escape
            if pass8_ast_type(esc_val) == AstType.AddrOf do
                let tgt = pass8_get_addr_target(esc_val)
                if pass8_strlen(tgt) > 0 do
                    let root = pass8_resolve_borrow_root(bound_borrows, tgt)
                    if in_arena == 1 or pass8_vec_contains(arena_locals, root) == 1 do
                        report_error(diag, 5005, pass8_ast_line(node), 0)
                    eif pass8_vec_contains(func_locals, root) == 1 do
                        if pass8_box_find(g_pass8_func_params, root) == 0 or (pass8_get_var_type(var_types, root) != TypeKind.Ref and pass8_get_var_type(var_types, root) != TypeKind.MutRef) do
                            report_error(diag, 5007, pass8_ast_line(node), 0)
                        end
                    end
                end
            end
            if pass8_ast_type(esc_val) == AstType.Identifier do
                let esc_name = pass8_ast_name(esc_val)
                let root = pass8_resolve_borrow_root(bound_borrows, esc_name)
                if pass8_streq(root, esc_name) == 0 or pass8_box_find(bound_borrows, esc_name) != 0 do
                    if in_arena == 1 or pass8_vec_contains(arena_locals, root) == 1 do
                        report_error(diag, 5005, pass8_ast_line(node), 0)
                    eif pass8_vec_contains(func_locals, root) == 1 do
                        if pass8_box_find(g_pass8_func_params, root) == 0 or (pass8_get_var_type(var_types, root) != TypeKind.Ref and pass8_get_var_type(var_types, root) != TypeKind.MutRef) do
                            report_error(diag, 5007, pass8_ast_line(node), 0)
                        end
                    end
                end
            end
            pass8_walk(symbols, scopes, diag, val, moved_vars, shared_borrows, mut_borrows,
                       bound_borrows, arena_locals, pre_arena_names, in_arena, var_types, func_locals)
        end
        out 0
    end

    # 7. Print / Throw Statements
    if pass8_ast_type(node) == AstType.PrintStmt or pass8_ast_type(node) == AstType.ThrowStmt do
        let child_count = vec_len_rt(pass8_ast_children(node))
        var i = 0
        when i < child_count loop
            let child = vec_get_rt(pass8_ast_children(node), i)
            pass8_walk(symbols, scopes, diag, child, moved_vars, shared_borrows, mut_borrows,
                       bound_borrows, arena_locals, pre_arena_names, in_arena, var_types, func_locals)
            i = i + 1
        end
        out 0
    end

    # 8. Attribute bindings
    if pass8_ast_type(node) == AstType.BindAttr or pass8_ast_type(node) == AstType.ExposeAttr do
        let child_count = vec_len_rt(pass8_ast_children(node))
        if child_count > 0 do
            let child = vec_get_rt(pass8_ast_children(node), 0)
            out pass8_walk(symbols, scopes, diag, child, moved_vars, shared_borrows, mut_borrows,
                           bound_borrows, arena_locals, pre_arena_names, in_arena, var_types, func_locals)
        end
        out 0
    end

    if pass8_ast_type(node) == AstType.ExternFunc do
        out 0
    end

    # 9. Function Definition — fresh function-level ownership tracking context
    if pass8_ast_type(node) == AstType.FuncDef do
        scope_push(scopes, ScopeKind.Func)
        let old_params = g_pass8_func_params
        g_pass8_func_params = pass8_box_new()
        pass8_box_push(g_pass8_func_params, var_item_new(fat_str_new("this"), 0) as i64)
        let func_moved = pass8_box_new()
        let func_shared = pass8_box_new()
        let func_mut = pass8_box_new()
        let func_bound_borrows = pass8_box_new()
        let func_arena_locals = pass8_box_new()
        let func_pre_arena = pass8_box_new()
        let func_var_types = pass8_box_new()
        let fn_locals = pass8_box_new()

        let child_count = vec_len_rt(pass8_ast_children(node))
        var i = 0
        when i < child_count loop
            let child = vec_get_rt(pass8_ast_children(node), i)
            if pass8_ast_type(child) == AstType.Identifier or pass8_ast_type(child) == AstType.ParamDef or pass8_ast_type(child) == AstType.RefParam or pass8_ast_type(child) == AstType.OutParam do
                if pass8_strlen(pass8_ast_name(child)) > 0 do
                    let child_name = pass8_ast_name(child)
                    let fn_item = var_item_new(child_name, 0)
                    pass8_box_push(fn_locals, fn_item as i64)
                    let p_item = var_item_new(child_name, 0)
                    pass8_box_push(g_pass8_func_params, p_item as i64)
                    if pass8_ast_type(child) == AstType.RefParam or pass8_ast_type(child) == AstType.OutParam do
                        pass8_register_var_type(func_var_types, child_name, TypeKind.Ref)
                    else
                        let p_type_str = pass8_ast_name2(child)
                        let p_kind = pass8_type_kind_from_type_str(p_type_str)
                        pass8_register_var_type(func_var_types, child_name, p_kind)
                    end
                end
            end
            pass8_walk(symbols, scopes, diag, child, func_moved, func_shared, func_mut,
                       func_bound_borrows, func_arena_locals, func_pre_arena, 0, func_var_types, fn_locals)
            i = i + 1
        end
        g_pass8_func_params = old_params
        scope_pop(scopes)
        out 0
    end

    # 10. Generic Block — lexical borrow lifetime scope
    if pass8_ast_type(node) == AstType.Block do
        scope_push(scopes, ScopeKind.Block)
        let shadow_frame = pass8_box_new()
        pass8_box_push(g_pass8_shadow_frames, shadow_frame)
        let bound_wm = pass8_box_len(bound_borrows)
        let shared_wm = pass8_box_len(shared_borrows)
        let mut_wm = pass8_box_len(mut_borrows)
        let claimed = pass8_walk_children_stmts(symbols, scopes, diag, node, moved_vars, shared_borrows, mut_borrows,
                                                bound_borrows, arena_locals, pre_arena_names, in_arena, var_types, func_locals)
        # Release block-scoped borrows
        if in_arena == 0 do
            pass8_truncate_to(bound_borrows, bound_wm)
        end
        pass8_truncate_to(shared_borrows, shared_wm)
        pass8_truncate_to(mut_borrows, mut_wm)
        pass8_restore_local_bindings(moved_vars, shadow_frame)
        pass8_box_pop(g_pass8_shadow_frames)
        scope_pop(scopes)
        out claimed
    end

    # 11. Arena Block — region lifetime validation
    if pass8_ast_type(node) == AstType.ArenaBlock do
        scope_push(scopes, ScopeKind.Block)
        let moved_wm = pass8_box_len(moved_vars)
        let shared_wm = pass8_box_len(shared_borrows)
        let mut_wm = pass8_box_len(mut_borrows)
        let bound_wm = pass8_box_len(bound_borrows)
        let arena_wm = pass8_box_len(arena_locals)
        pass8_walk_children_stmts(symbols, scopes, diag, node, moved_vars, shared_borrows, mut_borrows,
                                  bound_borrows, arena_locals, pre_arena_names, 1, var_types, func_locals)
        pass8_check_arena_borrow_escape(diag, arena_locals, pre_arena_names, bound_borrows, pass8_ast_line(node))
        pass8_truncate_to(moved_vars, moved_wm)
        pass8_truncate_to(shared_borrows, shared_wm)
        pass8_truncate_to(mut_borrows, mut_wm)
        pass8_truncate_to(bound_borrows, bound_wm)
        pass8_truncate_to(arena_locals, arena_wm)
        scope_pop(scopes)
        out 0
    end

    # 12. If joins branch move sets conservatively.  Each branch starts from
    # the condition state; moves from either branch remain moved after merge.
    if pass8_ast_type(node) == AstType.IfStmt do
        scope_push(scopes, ScopeKind.Block)
        let shared_wm = pass8_box_len(shared_borrows)
        let mut_wm = pass8_box_len(mut_borrows)
        let bound_wm = pass8_box_len(bound_borrows)
        let child_count = vec_len_rt(pass8_ast_children(node))
        if child_count > 0 do
            let cond = vec_get_rt(pass8_ast_children(node), 0)
            pass8_walk(symbols, scopes, diag, cond, moved_vars, shared_borrows, mut_borrows,
                       bound_borrows, arena_locals, pre_arena_names, in_arena, var_types, func_locals)
        end
        let moved_branch_wm = pass8_box_len(moved_vars)
        let shared_branch_wm = pass8_box_len(shared_borrows)
        let mut_branch_wm = pass8_box_len(mut_borrows)
        let bound_branch_wm = pass8_box_len(bound_borrows)
        var then_term = 0
        if child_count > 1 do
            let then_branch = vec_get_rt(pass8_ast_children(node), 1)
            then_term = pass8_branch_terminates(then_branch)
            let claimed = pass8_walk(symbols, scopes, diag, then_branch, moved_vars, shared_borrows, mut_borrows,
                                     bound_borrows, arena_locals, pre_arena_names, in_arena, var_types, func_locals)
            pass8_end_stmt(shared_borrows, mut_borrows, shared_branch_wm, mut_branch_wm, claimed)
        end
        let moved_then = pass8_snapshot_moved_since(moved_vars, moved_branch_wm)
        pass8_truncate_to(moved_vars, moved_branch_wm)
        pass8_truncate_to(shared_borrows, shared_branch_wm)
        pass8_truncate_to(mut_borrows, mut_branch_wm)
        pass8_truncate_to(bound_borrows, bound_branch_wm)
        var else_term = 0
        if child_count > 2 do
            let else_branch = vec_get_rt(pass8_ast_children(node), 2)
            else_term = pass8_branch_terminates(else_branch)
            let claimed = pass8_walk(symbols, scopes, diag, else_branch, moved_vars, shared_borrows, mut_borrows,
                                     bound_borrows, arena_locals, pre_arena_names, in_arena, var_types, func_locals)
            pass8_end_stmt(shared_borrows, mut_borrows, shared_branch_wm, mut_branch_wm, claimed)
        end
        if then_term == 1 and else_term == 1 do
            pass8_truncate_to(moved_vars, moved_branch_wm)
        eif then_term == 1 do
            # then terminated; only else or condition fallthrough path continues
        eif else_term == 1 do
            pass8_truncate_to(moved_vars, moved_branch_wm)
            pass8_merge_moved(moved_vars, moved_then)
        else
            pass8_merge_moved(moved_vars, moved_then)
        end
        pass8_truncate_to(shared_borrows, shared_wm)
        pass8_truncate_to(mut_borrows, mut_wm)
        pass8_truncate_to(bound_borrows, bound_wm)
        scope_pop(scopes)
        out 0
    end

    # 13. Control Flow: LoopStmt, WhileStmt, ForRange, WhenStmt
    if pass8_ast_type(node) == AstType.LoopStmt or pass8_ast_type(node) == AstType.WhileStmt or pass8_ast_type(node) == AstType.ForRange or pass8_ast_type(node) == AstType.WhenStmt do
        scope_push(scopes, ScopeKind.Block)
        let shared_wm = pass8_box_len(shared_borrows)
        let mut_wm = pass8_box_len(mut_borrows)
        let bound_wm = pass8_box_len(bound_borrows)
        let child_count = vec_len_rt(pass8_ast_children(node))
        if child_count > 0 do
            let cond = vec_get_rt(pass8_ast_children(node), 0)
            pass8_walk(symbols, scopes, diag, cond, moved_vars, shared_borrows, mut_borrows,
                       bound_borrows, arena_locals, pre_arena_names, in_arena, var_types, func_locals)
        end
        var i = 1
        when i < child_count loop
            let shared_stmt_wm = pass8_box_len(shared_borrows)
            let mut_stmt_wm = pass8_box_len(mut_borrows)
            let child = vec_get_rt(pass8_ast_children(node), i)
            let claimed = pass8_walk(symbols, scopes, diag, child, moved_vars, shared_borrows, mut_borrows,
                                     bound_borrows, arena_locals, pre_arena_names, in_arena, var_types, func_locals)
            pass8_end_stmt(shared_borrows, mut_borrows, shared_stmt_wm, mut_stmt_wm, claimed)
            i = i + 1
        end
        pass8_truncate_to(shared_borrows, shared_wm)
        pass8_truncate_to(mut_borrows, mut_wm)
        pass8_truncate_to(bound_borrows, bound_wm)
        scope_pop(scopes)
        out 0
    end

    # 14. Default: walk all child AST nodes
    let child_count = vec_len_rt(pass8_ast_children(node))
    var i = 0
    when i < child_count loop
        let child = vec_get_rt(pass8_ast_children(node), i)
        pass8_walk(symbols, scopes, diag, child, moved_vars, shared_borrows, mut_borrows,
                   bound_borrows, arena_locals, pre_arena_names, in_arena, var_types, func_locals)
        i = i + 1
    end
    out 0
end.

export pass8_analyze_borrow
