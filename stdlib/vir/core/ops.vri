##
 * vir/core/ops.vri — Checked Arithmetic
 * =======================================================
 * Inspired by C23: <stdckdint.h> — checked integer arithmetic
 * All operations return Result, avoiding undefined behavior on integer overflow.
 *
 * Compiler uses internally: safe offset calculation, buffer size, instruction count.
 ##

include types;
include result;
import Result, Ok, Err from result;

entity OverflowError:
    msg: string,
        operation: string,
        operand_a: int,
        operand_b: int;
end

# ═══════════════════════════════════════════════════════
# Addition with overflow check
# ═══════════════════════════════════════════════════════

func add_checked:
    in(a:int; b:int)
    # Check: if b > 0 and a > I64_MAX - b -> overflow
    #           if b < 0 and a < I64_MIN - b -> overflow
    if b > 0 and a > I64_MAX - b do
        out Err(OverflowError { msg: "addition overflow", operation: "add", operand_a: a, operand_b: b });
    end
    if b < 0 and a < I64_MIN - b do
        out Err(OverflowError { msg: "addition underflow", operation: "add", operand_a: a, operand_b: b });
    end
    out Ok(a + b);
end.

# ═══════════════════════════════════════════════════════
# Subtraction with overflow check
# ═══════════════════════════════════════════════════════

func sub_checked:
    in(a:int; b:int)
    if b > 0 and a < I64_MIN + b do
        out Err(OverflowError { msg: "subtraction underflow", operation: "sub", operand_a: a, operand_b: b });
    end
    if b < 0 and a > I64_MAX + b do
        out Err(OverflowError { msg: "subtraction overflow", operation: "sub", operand_a: a, operand_b: b });
    end
    out Ok(a - b);
end.

# ═══════════════════════════════════════════════════════
# Multiplication with overflow check
# ═══════════════════════════════════════════════════════

func mul_checked:
    in(a:int; b:int)
    if a == 0 or b == 0 do
        out Ok(0);
    end
    if a == I64_MIN and b == -1 do
        out Err(OverflowError { msg: "multiplication overflow", operation: "mul", operand_a: a, operand_b: b });
    end
    if b == I64_MIN and a == -1 do
        out Err(OverflowError { msg: "multiplication overflow", operation: "mul", operand_a: a, operand_b: b });
    end
    result = a * b;
    if result / a != b do
        out Err(OverflowError { msg: "multiplication overflow", operation: "mul", operand_a: a, operand_b: b });
    end
    out Ok(result);
end

# ═══════════════════════════════════════════════════════
# Division with check
# ═══════════════════════════════════════════════════════

func div_checked:
    in(a:int; b:int)
    if b == 0 do
        out Err(OverflowError { msg: "division by zero", operation: "div", operand_a: a, operand_b: b });
    end
    if a == I64_MIN and b == -1 do
        out Err(OverflowError { msg: "division overflow", operation: "div", operand_a: a, operand_b: b });
    end
    out Ok(a / b);
end

# ═══════════════════════════════════════════════════════
# Modulo operation (modulo)
# ═══════════════════════════════════════════════════════

func mod_checked:
    in(a:int; b:int)
    if b == 0 do
        out Err(OverflowError { msg: "modulo by zero", operation: "mod", operand_a: a, operand_b: b });
    end
    out Ok(a % b);
end

# ═══════════════════════════════════════════════════════
# Exponentiation with overflow check
# ═══════════════════════════════════════════════════════

func pow_checked:
    in(base:int; exp:int)
    result = 1;
    b = base;
    e = exp;

    when e > 0 loop
        if e & 1 == 1 do
            r = mul_checked(result, b);
            if is_err(r) do out r end
            result = unwrap(r);
        end
        e = e >> 1;
        if e > 0 do
            r = mul_checked(b, b);
            if is_err(r) do out r end
            b = unwrap(r);
        end
    end

    out Ok(result);
end

# ═══════════════════════════════════════════════════════
# Bit shift with overflow check
# ═══════════════════════════════════════════════════════

func shl_checked:
    in(a:int; shift:int)
    if shift >= 64 do
        out Err(OverflowError { msg: "shift amount >= 64", operation: "shl", operand_a: a, operand_b: shift });
    end
    out Ok(a << shift);
end.

func shr_checked:
    in(a:int; shift:int)
    if shift >= 64 do
        out Err(OverflowError { msg: "shift amount >= 64", operation: "shr", operand_a: a, operand_b: shift });
    end
    out Ok(a >> shift);
end

# ═══════════════════════════════════════════════════════
# Saturating arithmetic (clamp instead of error)
# ═══════════════════════════════════════════════════════

func add_saturating:
    in(a:int; b:int)
    r = add_checked(a, b);
    case r;
        Ok(v): out v;
        Err(_):
            if b > 0 out I64_MAX do
            else out I64_MIN;
            end
    end
end.

func sub_saturating:
    in(a:int; b:int)
    r = sub_checked(a, b);
    case r;
        Ok(v): out v;
        Err(_):
            if b > 0 out I64_MIN do
            else out I64_MAX;
            end
    end
end.

func mul_saturating:
    in(a:int; b:int)
    r = mul_checked(a, b);
    case r;
        Ok(v): out v;
        Err(_):
            if (a > 0 and b > 0) or (a < 0 and b < 0) do
                out I64_MAX;
            else
                out I64_MIN;
            end
    end
end

# ═══════════════════════════════════════════════════════
# Wrapping arithmetic (wrap around — no overflow check)
# ═══════════════════════════════════════════════════════

func add_wrapping:
    in(a:int; b:int)
    # Result modulo 2^64, same as C default behavior
    out native_wrapping_add(a, b);
end.

func sub_wrapping:
    in(a:int; b:int)
    out native_wrapping_sub(a, b);
end.

func mul_wrapping:
    in(a:int; b:int)
    out native_wrapping_mul(a, b);
end.

func neg_checked:
    in(a:int)
    if a == I64_MIN do
        out Err(OverflowError { msg: "negation overflow (I64_MIN)", operation: "neg", operand_a: a, operand_b: 0 });
    end
    out Ok(-a);
end.

func abs_checked:
    in(a:int)
    if a == I64_MIN do
        out Err(OverflowError { msg: "abs overflow (I64_MIN)", operation: "abs", operand_a: a, operand_b: 0 });
    end
    if a < 0 out Ok(-a) do
    else out Ok(a);
    end
end
