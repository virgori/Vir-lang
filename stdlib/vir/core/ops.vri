/*
 * vir/core/ops.vri — Checked Arithmetic (Số học an toàn)
 * =======================================================
 * Inspired by C23: <stdckdint.h> — checked integer arithmetic
 * Mọi operation đều trả Result, tránh undefined behavior khi overflow số.
 *
 * Compiler uses internally: tính offset an toàn, size buffer, instruction count.
 */

import "vir/core/types" use all
import "vir/core/result" use Result, Ok, Err

entity OverflowError
    msg: String
    operation: String
    operand_a: i64
    operand_b: i64
end

# ═══════════════════════════════════════════════════════
# Phép cộng có kiểm tra overflow
# ═══════════════════════════════════════════════════════

func add_checked(a: i64, b: i64) -> Result<i64, OverflowError>
    # Kiểm tra: if b > 0 and a > I64_MAX - b -> overflow
    #           if b < 0 and a < I64_MIN - b -> overflow
    if b > 0 and a > I64_MAX - b
        out Err(OverflowError { msg: "addition overflow", operation: "add", operand_a: a, operand_b: b })
    end
    if b < 0 and a < I64_MIN - b
        out Err(OverflowError { msg: "addition underflow", operation: "add", operand_a: a, operand_b: b })
    end
    out Ok(a + b)
end

# ═══════════════════════════════════════════════════════
# Phép trừ có kiểm tra overflow
# ═══════════════════════════════════════════════════════

func sub_checked(a: i64, b: i64) -> Result<i64, OverflowError>
    if b > 0 and a < I64_MIN + b
        out Err(OverflowError { msg: "subtraction underflow", operation: "sub", operand_a: a, operand_b: b })
    end
    if b < 0 and a > I64_MAX + b
        out Err(OverflowError { msg: "subtraction overflow", operation: "sub", operand_a: a, operand_b: b })
    end
    out Ok(a - b)
end

# ═══════════════════════════════════════════════════════
# Phép nhân có kiểm tra overflow
# ═══════════════════════════════════════════════════════

func mul_checked(a: i64, b: i64) -> Result<i64, OverflowError>
    if a == 0 or b == 0
        out Ok(0)
    end
    if a == I64_MIN and b == -1
        out Err(OverflowError { msg: "multiplication overflow", operation: "mul", operand_a: a, operand_b: b })
    end
    if b == I64_MIN and a == -1
        out Err(OverflowError { msg: "multiplication overflow", operation: "mul", operand_a: a, operand_b: b })
    end
    var result = a * b
    if result / a != b
        out Err(OverflowError { msg: "multiplication overflow", operation: "mul", operand_a: a, operand_b: b })
    end
    out Ok(result)
end

# ═══════════════════════════════════════════════════════
# Phép chia có kiểm tra
# ═══════════════════════════════════════════════════════

func div_checked(a: i64, b: i64) -> Result<i64, OverflowError>
    if b == 0
        out Err(OverflowError { msg: "division by zero", operation: "div", operand_a: a, operand_b: b })
    end
    if a == I64_MIN and b == -1
        out Err(OverflowError { msg: "division overflow", operation: "div", operand_a: a, operand_b: b })
    end
    out Ok(a / b)
end

# ═══════════════════════════════════════════════════════
# Phép chia dư (modulo)
# ═══════════════════════════════════════════════════════

func mod_checked(a: i64, b: i64) -> Result<i64, OverflowError>
    if b == 0
        out Err(OverflowError { msg: "modulo by zero", operation: "mod", operand_a: a, operand_b: b })
    end
    out Ok(a % b)
end

# ═══════════════════════════════════════════════════════
# Phép lũy thừa có kiểm tra
# ═══════════════════════════════════════════════════════

func pow_checked(base: i64, exp: u32) -> Result<i64, OverflowError>
    var result = 1
    var b = base
    var e = exp

    while e > 0
        if e & 1 == 1
            var r = mul_checked(result, b)
            if is_err(r) out r end
            result = unwrap(r)
        end
        e = e >> 1
        if e > 0
            var r = mul_checked(b, b)
            if is_err(r) out r end
            b = unwrap(r)
        end
    end

    out Ok(result)
end

# ═══════════════════════════════════════════════════════
# Phép dịch bit có kiểm tra
# ═══════════════════════════════════════════════════════

func shl_checked(a: i64, shift: u32) -> Result<i64, OverflowError>
    if shift >= 64
        out Err(OverflowError { msg: "shift amount >= 64", operation: "shl", operand_a: a, operand_b: shift })
    end
    out Ok(a << shift)
end

func shr_checked(a: i64, shift: u32) -> Result<i64, OverflowError>
    if shift >= 64
        out Err(OverflowError { msg: "shift amount >= 64", operation: "shr", operand_a: a, operand_b: shift })
    end
    out Ok(a >> shift)
end

# ═══════════════════════════════════════════════════════
# Saturating arithmetic (bão hòa — clamp thay vì lỗi)
# ═══════════════════════════════════════════════════════

func add_saturating(a: i64, b: i64) -> i64
    var r = add_checked(a, b)
    chọn r
        case Ok(v) out v
        case Err(_)
            if b > 0 out I64_MAX
            else out I64_MIN
            end
    end
end

func sub_saturating(a: i64, b: i64) -> i64
    var r = sub_checked(a, b)
    chọn r
        case Ok(v) out v
        case Err(_)
            if b > 0 out I64_MIN
            else out I64_MAX
            end
    end
end

func mul_saturating(a: i64, b: i64) -> i64
    var r = mul_checked(a, b)
    chọn r
        case Ok(v) out v
        case Err(_)
            if (a > 0 and b > 0) or (a < 0 and b < 0)
                out I64_MAX
            else
                out I64_MIN
            end
    end
end

# ═══════════════════════════════════════════════════════
# Wrapping arithmetic (xoay vòng — không kiểm tra)
# ═══════════════════════════════════════════════════════

func add_wrapping(a: i64, b: i64) -> i64
    # Result modulo 2^64, giống C behavior default
    out native_wrapping_add(a, b)
end

func sub_wrapping(a: i64, b: i64) -> i64
    out native_wrapping_sub(a, b)
end

func mul_wrapping(a: i64, b: i64) -> i64
    out native_wrapping_mul(a, b)
end

func neg_checked(a: i64) -> Result<i64, OverflowError>
    if a == I64_MIN
        out Err(OverflowError { msg: "negation overflow (I64_MIN)", operation: "neg", operand_a: a, operand_b: 0 })
    end
    out Ok(-a)
end

func abs_checked(a: i64) -> Result<i64, OverflowError>
    if a == I64_MIN
        out Err(OverflowError { msg: "abs overflow (I64_MIN)", operation: "abs", operand_a: a, operand_b: 0 })
    end
    if a < 0 out Ok(-a)
    else out Ok(a)
    end
end
