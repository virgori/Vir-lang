##
 * vir/core/result.vri — Result of (T, E) = Success(T) or Failure(E)
 * =====================================================
 * Explicit error handling, no exceptions.
 * Inspired by Rust Result type, replaces C errno + Python try/except.
 *
 * Compiler uses internally: parse result, codegen result, file I/O result.
 ##

include types
include option
include vec

# ═══════════════════════════════════════════════════════
# Result type — tagged union
# ═══════════════════════════════════════════════════════

enum Result:
    Success(value)
    Failure(error)
end.
# ═══════════════════════════════════════════════════════
# State check
# ═══════════════════════════════════════════════════════

func isSuccess(r: Result):
    case r
        Result.Success(_): out true
        Result.Failure(_): out false
    end
end.
func isFailure(r: Result):
    out not isSuccess(r)
end.
# ═══════════════════════════════════════════════════════
# Get value
# ═══════════════════════════════════════════════════════

func unwrap(r: Result):
    # Get Success value. Panic if Failure.
    case r
        Result.Success(v): out v
        Result.Failure(_): panic("unwrap() called on Failure")
    end
end.
func unwrapFailure(r: Result):
    # Get Failure value. Panic if Success.
    case r
        Result.Success(_): panic("unwrapFailure() called on Success")
        Result.Failure(e): out e
    end
end.
func unwrapOr(r: Result, default):
    case r
        Result.Success(v): out v
        Result.Failure(_): out default
    end
end.
func orWith(r: Result, f: func):
    case r
        Result.Success(v): out v
        Result.Failure(e): out f(e)
    end
end.
func expect(r: Result, msg: string):
    case r
        Result.Success(v): out v
        Result.Failure(_): panic(msg)
    end
end.
# ═══════════════════════════════════════════════════════
# Transformations
# ═══════════════════════════════════════════════════════

func map(r: Result, f: func):
    # Success(x).map(f) -> Success(f(x))
    # Failure(e).map(f) -> Failure(e)
    case r
        Result.Success(v): out Result.Success(f(v))
        Result.Failure(e): out Result.Failure(e)
    end
end.
func mapFailure(r: Result, f: func):
    # Success(x).mapFailure(f) -> Success(x)
    # Failure(e).mapFailure(f) -> Failure(f(e))
    case r
        Result.Success(v): out Result.Success(v)
        Result.Failure(e): out Result.Failure(f(e))
    end
end.
func flatMap(r: Result, f: func):
    # Success(x).flatMap(f) -> f(x)   (f must return Result)
    # Failure(e).flatMap(f) -> Failure(e)
    case r
        Result.Success(v): out f(v)
        Result.Failure(e): out Result.Failure(e)
    end
end.
func recover(r: Result, f: func):
    # Success(x).recover(f) -> Success(x)
    # Failure(e).recover(f) -> f(e)
    case r
        Result.Success(v): out Result.Success(v)
        Result.Failure(e): out f(e)
    end
end.
# ═══════════════════════════════════════════════════════
# Conversions
# ═══════════════════════════════════════════════════════

func toOption(r: Result):
    # Success(v) -> Some(v), Failure(_) -> None
    case r
        Result.Success(v): out Option.Some(v)
        Result.Failure(_): out Option.None
    end
end.
func error(r: Result):
    # Success(_) -> None, Failure(e) -> Some(e)
    case r
        Result.Success(_): out Option.None
        Result.Failure(e): out Option.Some(e)
    end
end.
# ═══════════════════════════════════════════════════════
# Result utilities (Result chaining)
# ═══════════════════════════════════════════════════════

func all(results: Vec of (Result)):
    # If all Success -> Success(Vec values)
    # If any Failure -> return first Failure
    values = vec_new()
    for i in 0 .. vec_len(results) do
        let r = vec_get(results, i)
        case r
            Result.Success(v): vec_push(values, v)
            Result.Failure(e): out Result.Failure(e)
        end
    end
    out Result.Success(values)
end.

export Result, Success, Failure, isSuccess, isFailure, unwrap, unwrapFailure, unwrapOr
export orWith, expect, map, mapFailure, flatMap, recover, toOption, error, all
