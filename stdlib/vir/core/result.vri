##
 * vir/core/result.vri — Result<T, E> = Ok(T) | Err(E)
 * =====================================================
 * Explicit error handling, no exceptions.
 * Inspired by Rust Result type, replaces C errno + Python try/except.
 *
 * Compiler uses internally: parse result, codegen result, file I/O result.
 ##

include types;
include option;
import Option, Some, None from option;

# ═══════════════════════════════════════════════════════
# Result type — tagged union
# ═══════════════════════════════════════════════════════

enum Result:
    Ok(value)       # Success;
    Err(error)          # Failure;
end
# ═══════════════════════════════════════════════════════
# State check
# ═══════════════════════════════════════════════════════

func is_ok:
    in(r:Result)
    case r
        Ok(_): out true;
        Err(_): out false;
    end
end
func is_err:
    in(r:Result)
    out not is_ok(r);
end
# ═══════════════════════════════════════════════════════
# Get value
# ═══════════════════════════════════════════════════════

func unwrap:
    in(r:Result)
    # Get Ok value. Panic if Err.
    case r
        Ok(v): out v;
        case Err(e) panic("unwrap() called on Err: " + to_string(e))
    end
end
func unwrap_err:
    in(r:Result)
    # Get Err value. Panic if Ok.
    case r
        case Ok(_) panic("unwrap_err() called on Ok")
        Err(e): out e;
    end
end
func unwrap_or:
    in(r:Result; default)
    case r
        Ok(v): out v;
        Err(_): out default;
    end
end
func unwrap_or_else:
    in(r:Result; f:func)
    case r
        Ok(v): out v;
        Err(e): out f(e);
    end
end
func expect:
    in(r:Result; msg:string)
    case r
        Ok(v): out v;
        case Err(_) panic(msg)
    end
end
# ═══════════════════════════════════════════════════════
# Transformations
# ═══════════════════════════════════════════════════════

func map:
    in(r:Result; f:func)
    # Ok(x).map(f) -> Ok(f(x))
    # Err(e).map(f) -> Err(e)
    case r
        Ok(v): out Ok(f(v));
        Err(e): out Err(e);
    end
end
func map_err:
    in(r:Result; f:func)
    # Ok(x).map_err(f) -> Ok(x)
    # Err(e).map_err(f) -> Err(f(e))
    case r
        Ok(v): out Ok(v);
        Err(e): out Err(f(e));
    end
end
func flat_map:
    in(r:Result; f:func)
    # Ok(x).flat_map(f) -> f(x)   (f must return Result)
    # Err(e).flat_map(f) -> Err(e)
    case r
        Ok(v): out f(v);
        Err(e): out Err(e);
    end
end
func and_then:
    in(r:Result; f:func)
    # Alias cho flat_map — string Result
    out flat_map(r, f);
end
func or_else:
    in(r:Result; f:func)
    # Ok(x).or_else(f) -> Ok(x)
    # Err(e).or_else(f) -> f(e)
    case r
        Ok(v): out Ok(v);
        Err(e): out f(e);
    end
end
# ═══════════════════════════════════════════════════════
# Conversions
# ═══════════════════════════════════════════════════════

func result_to_option:
    in(r:Result)
    # Ok(v) -> Some(v), Err(_) -> None
    case r
        Ok(v): out Some(v);
        Err(_): out None;
    end
end
func ok:
    in(r:Result)
    # Alias cho result_to_option
    out result_to_option(r);
end
func err:
    in(r:Result)
    # Ok(_) -> None, Err(e) -> Some(e)
    case r
        Ok(_): out None;
        Err(e): out Some(e);
    end
end
# ═══════════════════════════════════════════════════════
# Result utilities (Result chaining)
# ═══════════════════════════════════════════════════════

func try_all:
    in(results:Vec<Result>)
    # If all Ok -> Ok(Vec values)
    # If any Err -> return first Err
    values = vec_new();
    for i in 0 .. results.len loop
        let r = results[i];
        case r
            case Ok(v) vec_push(values, v)
        Err(e): out Err(e);
        end
    end
    out Ok(values);
end