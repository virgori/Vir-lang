##
 * vir/core/result.vri — Result of (T, E) = Ok(T) | Err(E)
 * =====================================================
 * Explicit error handling, no exceptions.
 * Inspired by Rust Result type, replaces C errno + Python try/except.
 *
 * Compiler uses internally: parse result, codegen result, file I/O result.
 ##

include types
include option
import Option, Some, None from option
include vec
import Vec, vec_new, vec_push from vec

# ═══════════════════════════════════════════════════════
# Result type — tagged union
# ═══════════════════════════════════════════════════════

enum Result:
    Ok(value)       # Success
    Err(error)          # Failure
end.
# ═══════════════════════════════════════════════════════
# State check
# ═══════════════════════════════════════════════════════

func is_ok(r: Result):
    case r
        Result.Ok(_): out true
        Result.Err(_): out false
    end
end.
func is_err(r: Result):
    out not is_ok(r)
end.
# ═══════════════════════════════════════════════════════
# Get value
# ═══════════════════════════════════════════════════════

func unwrap(r: Result):
    # Get Ok value. Panic if Err.
    case r
        Result.Ok(v): out v
        Result.Err(_): panic("unwrap() called on Err")
    end
end.
func unwrap_err(r: Result):
    # Get Err value. Panic if Ok.
    case r
        Result.Ok(_): panic("unwrap_err() called on Ok")
        Result.Err(e): out e
    end
end.
func unwrap_or(r: Result, default):
    case r
        Result.Ok(v): out v
        Result.Err(_): out default
    end
end.
func unwrap_or_else(r: Result, f: func):
    case r
        Result.Ok(v): out v
        Result.Err(e): out f(e)
    end
end.
func expect(r: Result, msg: string):
    case r
        Result.Ok(v): out v
        Result.Err(_): panic(msg)
    end
end.
# ═══════════════════════════════════════════════════════
# Transformations
# ═══════════════════════════════════════════════════════

func map(r: Result, f: func):
    # Ok(x).map(f) -> Ok(f(x))
    # Err(e).map(f) -> Err(e)
    case r
        Result.Ok(v): out Result.Ok(f(v))
        Result.Err(e): out Result.Err(e)
    end
end.
func map_err(r: Result, f: func):
    # Ok(x).map_err(f) -> Ok(x)
    # Err(e).map_err(f) -> Err(f(e))
    case r
        Result.Ok(v): out Result.Ok(v)
        Result.Err(e): out Result.Err(f(e))
    end
end.
func flat_map(r: Result, f: func):
    # Ok(x).flat_map(f) -> f(x)   (f must return Result)
    # Err(e).flat_map(f) -> Err(e)
    case r
        Result.Ok(v): out f(v)
        Result.Err(e): out Result.Err(e)
    end
end.
func and_then(r: Result, f: func):
    # Alias cho flat_map — string Result
    out flat_map(r, f)
end.
func or_else(r: Result, f: func):
    # Ok(x).or_else(f) -> Ok(x)
    # Err(e).or_else(f) -> f(e)
    case r
        Result.Ok(v): out Result.Ok(v)
        Result.Err(e): out f(e)
    end
end.
# ═══════════════════════════════════════════════════════
# Conversions
# ═══════════════════════════════════════════════════════

func result_to_option(r: Result):
    # Ok(v) -> Some(v), Err(_) -> None
    case r
        Result.Ok(v): out Option.Some(v)
        Result.Err(_): out Option.None
    end
end.
func ok(r: Result):
    # Alias cho result_to_option
    out result_to_option(r)
end.
func err(r: Result):
    # Ok(_) -> None, Err(e) -> Some(e)
    case r
        Result.Ok(_): out Option.None
        Result.Err(e): out Option.Some(e)
    end
end.
# ═══════════════════════════════════════════════════════
# Result utilities (Result chaining)
# ═══════════════════════════════════════════════════════

func try_all(results: Vec of (Result)):
    # If all Ok -> Ok(Vec values)
    # If any Err -> return first Err
    values = vec_new()
    for i in 0 .. results.len do
        let r = results[i]
        case r
            Result.Ok(v): vec_push(values, v)
            Result.Err(e): out Result.Err(e)
        end
    end
    out Result.Ok(values)
end.