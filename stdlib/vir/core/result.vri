/*
 * vir/core/result.vri — Result<T, E> = Ok(T) | Err(E)
 * =====================================================
 * Error handling tường minh, không use exception.
 * Inspired by Rust Result type, thay thế C errno + Python try/except.
 *
 * Compiler uses internally: parse result, codegen result, file I/O result.
 */

import "vir/core/types" use all
import "vir/core/option" use Option, Some, None

# ═══════════════════════════════════════════════════════
# Result type — tagged union
# ═══════════════════════════════════════════════════════

enum Result
    Ok(giá_trị)       # Thành công
    Err(lỗi)          # Thất bại
end

# ═══════════════════════════════════════════════════════
# Kiểm tra trạng thái
# ═══════════════════════════════════════════════════════

func is_ok(r: Result) -> bool
    chọn r
        case Ok(_) out true
        case Err(_) out false
    end
end

func is_err(r: Result) -> bool
    out not is_ok(r)
end

# ═══════════════════════════════════════════════════════
# Lấy value
# ═══════════════════════════════════════════════════════

func unwrap(r: Result)
    # Lấy value Ok. Panic if Err.
    chọn r
        case Ok(v) out v
        case Err(e) panic("unwrap() called on Err: " + to_string(e))
    end
end

func unwrap_err(r: Result)
    # Lấy value Err. Panic if Ok.
    chọn r
        case Ok(_) panic("unwrap_err() called on Ok")
        case Err(e) out e
    end
end

func unwrap_or(r: Result, mặc_định)
    chọn r
        case Ok(v) out v
        case Err(_) out mặc_định
    end
end

func unwrap_or_else(r: Result, f: func)
    chọn r
        case Ok(v) out v
        case Err(e) out f(e)
    end
end

func expect(r: Result, msg: String)
    chọn r
        case Ok(v) out v
        case Err(_) panic(msg)
    end
end

# ═══════════════════════════════════════════════════════
# Biến đổi (Transformations)
# ═══════════════════════════════════════════════════════

func map(r: Result, f: func) -> Result
    # Ok(x).map(f) -> Ok(f(x))
    # Err(e).map(f) -> Err(e)
    chọn r
        case Ok(v) out Ok(f(v))
        case Err(e) out Err(e)
    end
end

func map_err(r: Result, f: func) -> Result
    # Ok(x).map_err(f) -> Ok(x)
    # Err(e).map_err(f) -> Err(f(e))
    chọn r
        case Ok(v) out Ok(v)
        case Err(e) out Err(f(e))
    end
end

func flat_map(r: Result, f: func) -> Result
    # Ok(x).flat_map(f) -> f(x)   (f phải out Result)
    # Err(e).flat_map(f) -> Err(e)
    chọn r
        case Ok(v) out f(v)
        case Err(e) out Err(e)
    end
end

func and_then(r: Result, f: func) -> Result
    # Alias cho flat_map — string Result
    out flat_map(r, f)
end

func or_else(r: Result, f: func) -> Result
    # Ok(x).or_else(f) -> Ok(x)
    # Err(e).or_else(f) -> f(e)
    chọn r
        case Ok(v) out Ok(v)
        case Err(e) out f(e)
    end
end

# ═══════════════════════════════════════════════════════
# Chuyển đổi
# ═══════════════════════════════════════════════════════

func result_to_option(r: Result) -> Option
    # Ok(v) -> Some(v), Err(_) -> None
    chọn r
        case Ok(v) out Some(v)
        case Err(_) out None
    end
end

func ok(r: Result) -> Option
    # Alias cho result_to_option
    out result_to_option(r)
end

func err(r: Result) -> Option
    # Ok(_) -> None, Err(e) -> Some(e)
    chọn r
        case Ok(_) out None
        case Err(e) out Some(e)
    end
end

# ═══════════════════════════════════════════════════════
# Tiện ích string Result (Result chaining)
# ═══════════════════════════════════════════════════════

func try_all(results: Vec<Result>) -> Result
    # Nếu tất cả Ok -> Ok(Vec values)
    # Nếu bất kỳ Err -> trả Err đầu tiên
    var values = vec_new()
    với mỗi r in results
        chọn r
            case Ok(v) vec_push(values, v)
            case Err(e) out Err(e)
        end
    end
    out Ok(values)
end
