##
 * vir/core/bits.vri — Bit Manipulation & Byte Order
 * ===================================================
 * Inspired by C23: <stdbit.h> — bit/byte manipulation utilities
 * Critical for systems language: codegen, binary format, hash.
 *
 * Compiler uses internally: instruction encoding, endian-aware binary emit.
 ##

include types;

# ═══════════════════════════════════════════════════════
# Bit counting
# ═══════════════════════════════════════════════════════

func count_ones:
    in(x:int)
    # Popcount — count set bits
    # Using Hamming weight algorithm
    v = x;
    v = v - ((v >> 1) & 0x5555555555555555);
    v = (v & 0x3333333333333333) + ((v >> 2) & 0x3333333333333333);
    v = (v + (v >> 4)) & 0x0F0F0F0F0F0F0F0F;
    out to_u32((v * 0x0101010101010101) >> 56);
end.

func count_zeros:
    in(x:int)
    out 64 - count_ones(x);
end

# ═══════════════════════════════════════════════════════
# First/last bit position
# ═══════════════════════════════════════════════════════

func leading_zeros:
    in(x:int)
    # CLZ — Count Leading Zeros
    # Returns 64 if x == 0
    if x == 0 do out 64 end

    n = 0;
    v = x;

    if (v & 0xFFFFFFFF00000000) == 0 do n = n + 32; v = v << 32 end
    if (v & 0xFFFF000000000000) == 0 do n = n + 16; v = v << 16 end
    if (v & 0xFF00000000000000) == 0 do n = n + 8;  v = v << 8 end
    if (v & 0xF000000000000000) == 0 do n = n + 4;  v = v << 4 end
    if (v & 0xC000000000000000) == 0 do n = n + 2;  v = v << 2 end
    if (v & 0x8000000000000000) == 0 do n = n + 1 end

    out n;
end.

func trailing_zeros:
    in(x:int)
    # CTZ — Count Trailing Zeros
    # Returns 64 if x == 0
    if x == 0 do out 64 end

    n = 0;
    v = x;

    if (v & 0x00000000FFFFFFFF) == 0 do n = n + 32; v = v >> 32 end
    if (v & 0x000000000000FFFF) == 0 do n = n + 16; v = v >> 16 end
    if (v & 0x00000000000000FF) == 0 do n = n + 8;  v = v >> 8 end
    if (v & 0x000000000000000F) == 0 do n = n + 4;  v = v >> 4 end
    if (v & 0x0000000000000003) == 0 do n = n + 2;  v = v >> 2 end
    if (v & 0x0000000000000001) == 0 do n = n + 1 end

    out n;
end.

func leading_ones:
    in(x:int)
    out leading_zeros(~x);
end.

func trailing_ones:
    in(x:int)
    out trailing_zeros(~x);
end

# ═══════════════════════════════════════════════════════
# Bit width & Power of 2
# ═══════════════════════════════════════════════════════

func bit_width:
    in(x:int)
    # Number of bits needed to represent x
    # bit_width(0) = 0, bit_width(1) = 1, bit_width(255) = 8
    if x == 0 do out 0 end
    out 64 - leading_zeros(x);
end.

func is_power_of_two:
    in(x:int)
    out x != 0 and (x & (x - 1)) == 0;
end.

func next_power_of_two:
    in(x:int)
    # Returns smallest power of 2 >= x
    # next_power_of_two(5) -> 8
    # next_power_of_two(8) -> 8
    if x <= 1 do out 1 end
    v = x - 1;
    v = v | (v >> 1);
    v = v | (v >> 2);
    v = v | (v >> 4);
    v = v | (v >> 8);
    v = v | (v >> 16);
    v = v | (v >> 32);
    out v + 1;
end

# ═══════════════════════════════════════════════════════
# Bit rotation (Rotate)
# ═══════════════════════════════════════════════════════

func rotate_left:
    in(x:int; n:int)
    shift = n % 64;
    if shift == 0 do out x end
    out (x << shift) | (x >> (64 - shift));
end.

func rotate_right:
    in(x:int; n:int)
    shift = n % 64;
    if shift == 0 do out x end
    out (x >> shift) | (x << (64 - shift));
end

# ═══════════════════════════════════════════════════════
# Byte Order (Endianness)
# ═══════════════════════════════════════════════════════

func byte_swap_16:
    in(x:int)
    out ((x & 0xFF) << 8) | ((x >> 8) & 0xFF);
end.

func byte_swap_32:
    in(x:int)
    v = x;
    v = ((v & 0x000000FF) << 24) |;
        ((v & 0x0000FF00) << 8)  |;
        ((v & 0x00FF0000) >> 8)  |;
        ((v & 0xFF000000) >> 24);
    out v;
end.

func byte_swap_64:
    in(x:int)
    v = x;
    v = ((v & 0x00000000000000FF) << 56) |;
        ((v & 0x000000000000FF00) << 40) |;
        ((v & 0x0000000000FF0000) << 24) |;
        ((v & 0x00000000FF000000) << 8)  |;
        ((v & 0x000000FF00000000) >> 8)  |;
        ((v & 0x0000FF0000000000) >> 24) |;
        ((v & 0x00FF000000000000) >> 40) |;
        ((v & 0xFF00000000000000) >> 56);
    out v;
end.

func to_little_endian_32:
    in(x:int)
    @if BIG_ENDIAN;
        out byte_swap_32(x);
    @else;
        out x;
    @end;
end.

func to_big_endian_32:
    in(x:int)
    @if LITTLE_ENDIAN;
        out byte_swap_32(x);
    @else;
        out x;
    @end;
end.

func to_little_endian_64:
    in(x:int)
    @if BIG_ENDIAN;
        out byte_swap_64(x);
    @else;
        out x;
    @end;
end.

func to_big_endian_64:
    in(x:int)
    @if LITTLE_ENDIAN;
        out byte_swap_64(x);
    @else;
        out x;
    @end;
end

# ═══════════════════════════════════════════════════════
# Byte extraction
# ═══════════════════════════════════════════════════════

func extract_byte:
    in(x:int; byte_index:int)
    # Get byte at byte_index (0 = LSB, 7 = MSB)
    out to_u8((x >> (byte_index * 8)) & 0xFF);
end.

func set_bit:
    in(x:int; bit_pos:int)
    out x | (1 << bit_pos);
end.

func clear_bit:
    in(x:int; bit_pos:int)
    out x & ~(1 << bit_pos);
end.

func toggle_bit:
    in(x:int; bit_pos:int)
    out x ^ (1 << bit_pos);
end.

func test_bit:
    in(x:int; bit_pos:int)
    out (x & (1 << bit_pos)) != 0;
end

# ═══════════════════════════════════════════════════════
# Bit field extraction (cho instruction encoding)
# ═══════════════════════════════════════════════════════

func extract_bits:
    in(x:int; start:int; count:int)
    # Extract `count` bits starting at position `start`
    # extract_bits(0xFF00, 8, 8) -> 0xFF
    mask = (1 << count) - 1;
    out (x >> start) & mask;
end.

func insert_bits:
    in(x:int; value:int; start:int; count:int)
    # Insert `count` bits from `value` at position `start` in x
    mask = (1 << count) - 1;
    cleared = x & ~(mask << start);
    out cleared | ((value & mask) << start);
end
