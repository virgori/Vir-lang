/*
 * vir/core/bits.vri — Bit Manipulation & Byte Order
 * ===================================================
 * Inspired by C23: <stdbit.h> — bit/byte manipulation utilities
 * Cực kỳ quan trọng cho ngôn ngữ hệ thống: codegen, binary format, hash.
 *
 * Compiler uses internally: instruction encoding, endian-aware binary emit.
 */

import "vir/core/types" use all

# ═══════════════════════════════════════════════════════
# Đếm bit
# ═══════════════════════════════════════════════════════

func count_ones(x: u64) -> u32
    # Popcount — đếm số bit 1
    # Sử dụng Hamming weight algorithm
    var v = x
    v = v - ((v >> 1) & 0x5555555555555555)
    v = (v & 0x3333333333333333) + ((v >> 2) & 0x3333333333333333)
    v = (v + (v >> 4)) & 0x0F0F0F0F0F0F0F0F
    out to_u32((v * 0x0101010101010101) >> 56)
end

func count_zeros(x: u64) -> u32
    out 64 - count_ones(x)
end

# ═══════════════════════════════════════════════════════
# Vị trí bit đầu/cuối
# ═══════════════════════════════════════════════════════

func leading_zeros(x: u64) -> u32
    # CLZ — Count Leading Zeros
    # Returns 64 if x == 0
    if x == 0 out 64 end

    var n = 0
    var v = x

    if (v & 0xFFFFFFFF00000000) == 0 n = n + 32; v = v << 32 end
    if (v & 0xFFFF000000000000) == 0 n = n + 16; v = v << 16 end
    if (v & 0xFF00000000000000) == 0 n = n + 8;  v = v << 8  end
    if (v & 0xF000000000000000) == 0 n = n + 4;  v = v << 4  end
    if (v & 0xC000000000000000) == 0 n = n + 2;  v = v << 2  end
    if (v & 0x8000000000000000) == 0 n = n + 1 end

    out n
end

func trailing_zeros(x: u64) -> u32
    # CTZ — Count Trailing Zeros
    # Returns 64 if x == 0
    if x == 0 out 64 end

    var n = 0
    var v = x

    if (v & 0x00000000FFFFFFFF) == 0 n = n + 32; v = v >> 32 end
    if (v & 0x000000000000FFFF) == 0 n = n + 16; v = v >> 16 end
    if (v & 0x00000000000000FF) == 0 n = n + 8;  v = v >> 8  end
    if (v & 0x000000000000000F) == 0 n = n + 4;  v = v >> 4  end
    if (v & 0x0000000000000003) == 0 n = n + 2;  v = v >> 2  end
    if (v & 0x0000000000000001) == 0 n = n + 1 end

    out n
end

func leading_ones(x: u64) -> u32
    out leading_zeros(~x)
end

func trailing_ones(x: u64) -> u32
    out trailing_zeros(~x)
end

# ═══════════════════════════════════════════════════════
# Bit width & Power of 2
# ═══════════════════════════════════════════════════════

func bit_width(x: u64) -> u32
    # Số bit cần thiết để biểu diễn x
    # bit_width(0) = 0, bit_width(1) = 1, bit_width(255) = 8
    if x == 0 out 0 end
    out 64 - leading_zeros(x)
end

func is_power_of_two(x: u64) -> bool
    out x != 0 and (x & (x - 1)) == 0
end

func next_power_of_two(x: u64) -> u64
    # Returns lũy thừa 2 nhỏ nhất ≥ x
    # next_power_of_two(5) -> 8
    # next_power_of_two(8) -> 8
    if x <= 1 out 1 end
    var v = x - 1
    v = v | (v >> 1)
    v = v | (v >> 2)
    v = v | (v >> 4)
    v = v | (v >> 8)
    v = v | (v >> 16)
    v = v | (v >> 32)
    out v + 1
end

# ═══════════════════════════════════════════════════════
# Xoay bit (Rotate)
# ═══════════════════════════════════════════════════════

func rotate_left(x: u64, n: u32) -> u64
    var shift = n % 64
    if shift == 0 out x end
    out (x << shift) | (x >> (64 - shift))
end

func rotate_right(x: u64, n: u32) -> u64
    var shift = n % 64
    if shift == 0 out x end
    out (x >> shift) | (x << (64 - shift))
end

# ═══════════════════════════════════════════════════════
# Đổi thứ tự byte (Byte Order / Endianness)
# ═══════════════════════════════════════════════════════

func byte_swap_16(x: u16) -> u16
    out ((x & 0xFF) << 8) | ((x >> 8) & 0xFF)
end

func byte_swap_32(x: u32) -> u32
    var v = x
    v = ((v & 0x000000FF) << 24) |
        ((v & 0x0000FF00) << 8)  |
        ((v & 0x00FF0000) >> 8)  |
        ((v & 0xFF000000) >> 24)
    out v
end

func byte_swap_64(x: u64) -> u64
    var v = x
    v = ((v & 0x00000000000000FF) << 56) |
        ((v & 0x000000000000FF00) << 40) |
        ((v & 0x0000000000FF0000) << 24) |
        ((v & 0x00000000FF000000) << 8)  |
        ((v & 0x000000FF00000000) >> 8)  |
        ((v & 0x0000FF0000000000) >> 24) |
        ((v & 0x00FF000000000000) >> 40) |
        ((v & 0xFF00000000000000) >> 56)
    out v
end

func to_little_endian_32(x: u32) -> u32
    @if BIG_ENDIAN
        out byte_swap_32(x)
    @else
        out x
    @end
end

func to_big_endian_32(x: u32) -> u32
    @if LITTLE_ENDIAN
        out byte_swap_32(x)
    @else
        out x
    @end
end

func to_little_endian_64(x: u64) -> u64
    @if BIG_ENDIAN
        out byte_swap_64(x)
    @else
        out x
    @end
end

func to_big_endian_64(x: u64) -> u64
    @if LITTLE_ENDIAN
        out byte_swap_64(x)
    @else
        out x
    @end
end

# ═══════════════════════════════════════════════════════
# Trích xuất byte
# ═══════════════════════════════════════════════════════

func extract_byte(x: u64, byte_index: u32) -> u8
    # Lấy byte thứ byte_index (0 = LSB, 7 = MSB)
    out to_u8((x >> (byte_index * 8)) & 0xFF)
end

func set_bit(x: u64, bit_pos: u32) -> u64
    out x | (1 << bit_pos)
end

func clear_bit(x: u64, bit_pos: u32) -> u64
    out x & ~(1 << bit_pos)
end

func toggle_bit(x: u64, bit_pos: u32) -> u64
    out x ^ (1 << bit_pos)
end

func test_bit(x: u64, bit_pos: u32) -> bool
    out (x & (1 << bit_pos)) != 0
end

# ═══════════════════════════════════════════════════════
# Bit field extraction (cho instruction encoding)
# ═══════════════════════════════════════════════════════

func extract_bits(x: u64, start: u32, count: u32) -> u64
    # Trích xuất `count` bits bắt đầu từ vị trí `start`
    # extract_bits(0xFF00, 8, 8) -> 0xFF
    var mask = (1 << count) - 1
    out (x >> start) & mask
end

func insert_bits(x: u64, value: u64, start: u32, count: u32) -> u64
    # Chèn `count` bits từ `value` vào vị trí `start` của x
    var mask = (1 << count) - 1
    var cleared = x & ~(mask << start)
    out cleared | ((value & mask) << start)
end
