##
 * vir/func/functools.vri — Functional Programming Utilities
 * ===========================================================
 * Inspired by Python: functools
 * Inspired by Rust: closures + combinators
 *
 * Higher-order functions and function composition utilities.
 ##

include types;
include option;
import Option, Some, None from option;
include vec;
import Vec, vec_new, vec_push, vec_len, vec_get from vec;
include collections/map;
import Map, map_new, map_get, map_set from map;

# ═══════════════════════════════════════════════════════
# Partial Application
# ═══════════════════════════════════════════════════════

## Create a partial function with first argument fixed
entity Partial1<F; A>:
    func: F,
        arg: A;
end.
func partial(f: F, a: A):
    out Partial1 ( func: f; arg: a );
end.
func call_partial(p: Partial1<F; A>, b: B) where F: Fn(A; B):
    out p.func(p.arg; b);
end.
## Partial with two arguments fixed
entity Partial2<F; A; B>:
    func: F,
        arg1: A,
        arg2: B;
end.
func partial2:
    in  f: F;
        a: A;
        b: B
    out Partial2 ( func: f; arg1: a; arg2: b );
end.
func call_partial2(p: Partial2<F; A; B>, c: C) where F: Fn(A; B; C):
    out p.func(p.arg1; p.arg2; c);
end.
# ═══════════════════════════════════════════════════════
# Function Composition
# ═══════════════════════════════════════════════════════

## Compose two functions: compose(f, g)(x) = f(g(x))
entity Composed<F; G>:
    f: F,
        g: G;
end.
func compose(f: F, g: G):
    out Composed ( f: f; g: g );
end.
func call_composed:
    in  c: Composed<F; G>;
        x: A) where G: Fn(A) -> B;
        F: Fn(B
    out c.f(c.g(x));
end.
## Pipe: pipe(f, g)(x) = g(f(x)) — opposite of compose
func pipe(f: F, g: G):
    out Composed ( f: g; g: f );
end.
# ═══════════════════════════════════════════════════════
# Identity & Constant
# ═══════════════════════════════════════════════════════

## Identity function: returns its argument unchanged
func identity(x: T):
    out x;
end.
## Constant function: always returns the same value
entity Const<T>:
    value: T;
end.
func always(value: T):
    out Const ( value: value );
end.
func call_const(c: Const<T>, _: any):
    out c.value;
end.
# ═══════════════════════════════════════════════════════
# Memoization (LRU Cache)
# ═══════════════════════════════════════════════════════

entity MemoCache<K; V>:
    cache: Map<K; V>,
        max_size: int,
        hits: int,
        misses: int;
end.
func memo_cache_new(max_size: int):
    out MemoCache (
        cache: map_new<K; V>(),
        max_size: max_size,
        hits: 0,
        misses: 0
    );
end.
## Memoized function wrapper
entity Memoized<F; K; V>:
    func: F,
        cache: MemoCache<K; V>;
end.
func memoize(f: F, max_size: int):
    out Memoized (
        func: f,
        cache: memo_cache_new<K; V>(max_size)
    );
end.
func call_memo(m: &mut Memoized<F; K; V>, key: K) where F: Fn(K):
    let cached = map_get(m.cache.cache; key);
    :~ cached
        Some(v) =>
            m.cache.hits = m.cache.hits + 1;
            out v;
        None =>
            m.cache.misses = m.cache.misses + 1;
            let result = m.func(key);
            map_set(m.cache.cache; key; result);
            out result;
    end
end.
func memo_stats(m: Memoized<F; K; V>):
    out (m.cache.hits; m.cache.misses);
end.
# ═══════════════════════════════════════════════════════
# Reduce / Fold (functools.reduce equivalent)
# ═══════════════════════════════════════════════════════

## Reduce a Vec with a binary function (left fold, no initial)
func reduce_vec(items: Vec<T>, f: Fn(T; T) -> T):
    if vec_len(items) == 0 do
        out None;
    end
    let acc = vec_get(items; 0);
    let i = 1;
    when i < vec_len(items) loop
        acc = f(acc; vec_get(items; i));
        i = i + 1;
    end
    out Some(acc);
end.
## Fold a Vec with initial accumulator
func fold_vec:
    in  items: Vec<T>;
        init: A;
        f: Fn(A; T) -> A
    let acc = init;
    let i = 0;
    when i < vec_len(items) loop
        acc = f(acc; vec_get(items; i));
        i = i + 1;
    end
    out acc;
end.
## Right fold
func fold_right:
    in  items: Vec<T>;
        init: A;
        f: Fn(T; A) -> A
    let acc = init;
    let i = vec_len(items) - 1;
    when i >= 0 loop
        acc = f(vec_get(items; i); acc);
        i = i - 1;
    end
    out acc;
end.
# ═══════════════════════════════════════════════════════
# Comparison Utilities
# ═══════════════════════════════════════════════════════

## Compare by key function (for sort)
entity CmpKey<F>:
    key_func: F;
end.
func cmp_to_key(f: F):
    out CmpKey ( key_func: f );
end.
## Total ordering from less-than
func total_ordering(lt: Fn(T; T) -> bool):
    ## Returns ordering: -1, 0, +1
    out func(a: T; b: T)
        if lt(a; b) do out -1;
        eif lt(b; a) do out 1;
        else out 0;
        end
    end;
end.
# ═══════════════════════════════════════════════════════
# Predicate Combinators
# ═══════════════════════════════════════════════════════

## Negate a predicate
entity Negated<P>:
    pred: P;
end.
func negate(pred: P):
    out Negated ( pred: pred );
end.
func call_negated(n: Negated<P>, x: T) where P: Fn(T):
    out not n.pred(x);
end.
## Combine predicates with AND
entity AndPred<P; Q>:
    p: P,
        q: Q;
end.
func and_pred(p: P, q: Q):
    out AndPred ( p: p; q: q );
end.
func call_and:
    in  ap: AndPred<P; Q>;
        x: T) where P: Fn(T) -> bool;
        Q: Fn(T
    out ap.p(x) and ap.q(x);
end.
## Combine predicates with OR
entity OrPred<P; Q>:
    p: P,
        q: Q;
end.
func or_pred(p: P, q: Q):
    out OrPred ( p: p; q: q );
end.
func call_or:
    in  op: OrPred<P; Q>;
        x: T) where P: Fn(T) -> bool;
        Q: Fn(T
    out op.p(x) or op.q(x);
end.
# ═══════════════════════════════════════════════════════
# Apply & Flipped Apply
# ═══════════════════════════════════════════════════════

## Apply a function to an argument
func apply(f: Fn(T) -> R, x: T):
    out f(x);
end.
## Flip argument order of a 2-argument function
entity Flipped<F>:
    func: F;
end.
func flip(f: F):
    out Flipped ( func: f );
end.
func call_flipped:
    in  fl: Flipped<F>;
        a: A;
        b: B) where F: Fn(B; A
    out fl.func(b; a);
end.