##
 * vir/ai/metrics.vri — Evaluation Metrics
 * =========================================
 * Performance metrics for model evaluation.
 *
 * Classification
 *   - accuracy, precision, recall, f1_score
 *   - confusion_matrix
 *   - top_k_accuracy
 *
 * Regression
 *   - mae, mse, rmse, r_squared
 *
 * All functions operate on flat float/int arrays.
 ##

include types;
include alloc;
import alloc, alloc_zeroed, free from alloc;
include basic;
import sqrt, abs_f, max_f from basic;

# ═══════════════════════════════════════════════════════
# Classification Metrics
# ═══════════════════════════════════════════════════════

# Accuracy: fraction of correct predictions;
func accuracy:
    in(pred: ptr; target: ptr; n: int)
    var correct = 0;
    var i = 0;
    when i < n loop
        var p = native_load<int>(pred; i);
        var t = native_load<int>(target; i);
        if p == t do
            correct = correct + 1;
        end
        i = i + 1;
    end
    out correct >> float / n >> float;
end
# Precision for a specific class;
func precision:
    in(pred: ptr; target: ptr; n: int; class_id: int)
    var tp = 0;
    var fp = 0;
    var i = 0;
    when i < n loop
        var p = native_load<int>(pred; i);
        var t = native_load<int>(target; i);
        if p == class_id do
            if t == class_id do
                tp = tp + 1;
            else
                fp = fp + 1;
            end
        end
        i = i + 1;
    end
    if tp + fp == 0 do
        out 0.0;
    end
    out tp >> float / (tp + fp) >> float;
end
# Recall for a specific class;
func recall:
    in(pred: ptr; target: ptr; n: int; class_id: int)
    var tp = 0;
    var fn_count = 0;
    var i = 0;
    when i < n loop
        var p = native_load<int>(pred; i);
        var t = native_load<int>(target; i);
        if t == class_id do
            if p == class_id do
                tp = tp + 1;
            else
                fn_count = fn_count + 1;
            end
        end
        i = i + 1;
    end
    if tp + fn_count == 0 do
        out 0.0;
    end
    out tp >> float / (tp + fn_count) >> float;
end
# F1 score for a specific class;
func f1_score:
    in(pred: ptr; target: ptr; n: int; class_id: int)
    var p = precision(pred; target; n; class_id);
    var r = recall(pred; target; n; class_id);
    if p + r < 0.000001 do
        out 0.0;
    end
    out 2.0 * p * r / (p + r);
end
# Top-K accuracy: prediction is correct if true label is in top K logits;
func top_k_accuracy:
    in(logits: ptr; targets: ptr; n: int; num_classes: int; k: int)
    var correct = 0;
    var i = 0;
    when i < n loop
        var target = native_load<int>(targets; i);
        var target_score = native_load<float>(logits; i * num_classes + target);

        # Count how many classes have score >= target_score;
        var rank = 0;
        var c = 0;
        when c < num_classes loop
            var s = native_load<float>(logits; i * num_classes + c);
            if s > target_score do
                rank = rank + 1;
            end
            c = c + 1;
        end

        if rank < k do
            correct = correct + 1;
        end
        i = i + 1;
    end
    out correct >> float / n >> float;
end
# ═══════════════════════════════════════════════════════
# Regression Metrics
# ═══════════════════════════════════════════════════════

# Mean Absolute Error;
func mae:
    in(pred: ptr; target: ptr; n: int)
    var total = 0.0;
    var i = 0;
    when i < n loop
        var diff = native_load<float>(pred; i) - native_load<float>(target; i);
        total = total + abs_f(diff);
        i = i + 1;
    end
    out total / n >> float;
end
# Mean Squared Error;
func mse:
    in(pred: ptr; target: ptr; n: int)
    var total = 0.0;
    var i = 0;
    when i < n loop
        var diff = native_load<float>(pred; i) - native_load<float>(target; i);
        total = total + diff * diff;
        i = i + 1;
    end
    out total / n >> float;
end
# Root Mean Squared Error;
func rmse:
    in(pred: ptr; target: ptr; n: int)
    out sqrt(mse(pred; target; n));
end
# R² (coefficient of determination);
func r_squared:
    in(pred: ptr; target: ptr; n: int)
    # Compute mean of targets;
    var sum = 0.0;
    var i = 0;
    when i < n loop
        sum = sum + native_load<float>(target; i);
        i = i + 1;
    end
    var mean = sum / n >> float;

    # SS_res and SS_tot;
    var ss_res = 0.0;
    var ss_tot = 0.0;
    i = 0;
    when i < n loop
        var t = native_load<float>(target; i);
        var p = native_load<float>(pred; i);
        var res = t - p;
        var tot = t - mean;
        ss_res = ss_res + res * res;
        ss_tot = ss_tot + tot * tot;
        i = i + 1;
    end
    if ss_tot < 0.000001 do
        out 1.0;
    end
    out 1.0 - ss_res / ss_tot;
end
export accuracy, precision, recall, f1_score, top_k_accuracy;
export mae, mse, rmse, r_squared;
