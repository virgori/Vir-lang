##
 * vir/ai/quantize.vri — Weight & Activation Quantization
 * =========================================================
 * INT8 symmetric quantization for model compression.
 *
 * Algorithm (symmetric, per-tensor)
 *   scale  = max(|x_i|) / Q_max        where Q_max = 127 (INT8)
 *   q_i    = round(x_i / scale)         clamped to [-127, 127]
 *   x_hat_i   = q_i * scale                 (dequantize)
 *
 * Per-channel variant: one scale per output channel (row), better
 * accuracy for weight matrices with large inter-channel variance.
 *
 * Usage
 *   include ai.quantize
 *   var qtensor = quantize_tensor(weights, bits: 8)
 *   # ... run inference using quantized_matmul ...
 *   var result = dequantize_tensor(qtensor)
 ##

include types
include alloc
import alloc, alloc_zeroed, free from alloc
include basic
import abs_f, sqrt, max_f from basic
include math.tensor
import Tensor, tensor_zeros, tensor_get_flat, tensor_set_flat, tensor_free from tensor

# ===================================================
# Constants
# ===================================================

const QBITS_INT8:  8
const QBITS_INT4:  4
const QMAX_INT8:   127
const QMAX_INT4:   7

# ===================================================
# QuantizedTensor: holds INT8 data + scale
# ===================================================

entity QuantizedTensor:
    data:       ptr,    # int8 buffer
        scale:      ptr,    # float scale per channel ([n_channels] or [1])
        n_channels: int,    # 1 = per-tensor, N = per-channel
        numel:      int,    # total number of quantized values
        bits:       int,    # 8 or 4
        channel_sz: int     # elements per channel (numel / n_channels)
end.

func qtensor_free(q: QuantizedTensor):
    if q.data != null do free(q.data) end
    if q.scale != null do free(q.scale) end
    q.data = null
    q.scale = null
end.

# ===================================================
# Internal helpers
# ===================================================

func _round_to_int(x: float):
    if x >= 0.0 do
        out (x + 0.5) as int
    end
    out (x - 0.5) as int
end.

func _clamp_i(v: int, clamp_max: int):
    if v > clamp_max do out clamp_max end
    if v < (0 - clamp_max) do out (0 - clamp_max) end
    out v
end.

# ===================================================
# Per-Tensor Quantize (INT8 / INT4)
# ===================================================
#
# Computes one global scale = max(|x|) / qmax.
# All elements share the same scale factor.
#
func quantize_tensor(t: Tensor, bits: int):
    qmax = QMAX_INT8
    if bits == QBITS_INT4 do qmax = QMAX_INT4 end

    n = t.numel

    # Find global max |x|
    max_abs = 0.0
    i = 0
    when i < n loop
        v = tensor_get_flat(t, i)
        av = abs_f(v)
        if av > max_abs do max_abs = av end
        i = i + 1
    end

    # Compute scale (avoid divide-by-zero)
    scale = max_abs / (qmax as float)
    if max_abs == 0.0 do scale = 1.0 end

    scale_buf = alloc(size_of<float>())
    native_store<float>(scale_buf, 0, scale)
    q_buf = alloc_zeroed(n)

    i = 0
    when i < n loop
        x = tensor_get_flat(t, i)
        q = _clamp_i(_round_to_int(x / scale), qmax)
        native_store<byte>(q_buf, i, q as byte)
        i = i + 1
    end

    out QuantizedTensor (
        data:       q_buf,
        scale:      scale_buf,
        n_channels: 1,
        numel:      n,
        bits:       bits,
        channel_sz: n
    )
end.

# ===================================================
# Per-Channel Quantize (for weight matrices)
# ===================================================
#
# t must be contiguous 2D: shape [n_channels, channel_sz]
# Computes one scale per row — better accuracy than per-tensor.
#
func quantize_tensor_perchannel(t: Tensor, bits: int):
    if t.rank != 2 do panic("quantize_tensor_perchannel: must be rank-2") end
    qmax = QMAX_INT8
    if bits == QBITS_INT4 do qmax = QMAX_INT4 end

    n_ch = native_load<int>(t.shape, 0)
    ch_sz = native_load<int>(t.shape, 1)
    n = n_ch * ch_sz

    scale_buf = alloc(n_ch * size_of<float>())
    q_buf = alloc_zeroed(n)

    c = 0
    when c < n_ch loop
        max_abs = 0.0
        k = 0
        when k < ch_sz loop
            v = tensor_get_flat(t, c * ch_sz + k)
            av = abs_f(v)
            if av > max_abs do max_abs = av end
            k = k + 1
        end

        scale = max_abs / (qmax as float)
        if max_abs == 0.0 do scale = 1.0 end
        native_store<float>(scale_buf, c, scale)

        k = 0
        when k < ch_sz loop
            x = tensor_get_flat(t, c * ch_sz + k)
            q = _clamp_i(_round_to_int(x / scale), qmax)
            native_store<byte>(q_buf, c * ch_sz + k, q as byte)
            k = k + 1
        end

        c = c + 1
    end

    out QuantizedTensor (
        data:       q_buf,
        scale:      scale_buf,
        n_channels: n_ch,
        numel:      n,
        bits:       bits,
        channel_sz: ch_sz
    )
end.

# ===================================================
# Dequantize -> float Tensor
# ===================================================
#
# Reconstructs float values: x_hat_i = q_i * scale_channel(i)
#
func dequantize_tensor(q: QuantizedTensor):
    out_shape = alloc(size_of<int>())
    native_store<int>(out_shape, 0, q.numel)
    t = tensor_zeros(out_shape, 1)
    free(out_shape)

    i = 0
    when i < q.numel loop
        qi = native_load<byte>(q.data, i) as int
        # Sign-extend INT8 byte
        if qi > 127 do qi = qi - 256 end
        c = i / q.channel_sz
        if c >= q.n_channels do c = q.n_channels - 1 end
        scale = native_load<float>(q.scale, c)
        tensor_set_flat(t, i, qi as float * scale)
        i = i + 1
    end
    out t
end.

# ===================================================
# Quantized MatMul: [M,K] INT8 x [K,N] INT8 -> [M,N] float
# ===================================================
#
# Accumulates in INT32 (no overflow for K <= 16M).
# Dequantizes result by sa * sb at write time.
#
func quantized_matmul(qa: QuantizedTensor, qb: QuantizedTensor, M: int, K: int, N: int):
    sa = native_load<float>(qa.scale, 0)
    sb = native_load<float>(qb.scale, 0)

    out_shape = alloc(2 * size_of<int>())
    native_store<int>(out_shape, 0, M)
    native_store<int>(out_shape, 1, N)
    c = tensor_zeros(out_shape, 2)
    free(out_shape)

    i = 0
    when i < M loop
        j = 0
        when j < N loop
            acc = 0
            k = 0
            when k < K loop
                ai = native_load<byte>(qa.data, i * K + k) as int
                bi = native_load<byte>(qb.data, k * N + j) as int
                if ai > 127 do ai = ai - 256 end
                if bi > 127 do bi = bi - 256 end
                acc = acc + ai * bi
                k = k + 1
            end
            tensor_set_flat(c, i * N + j, acc as float * sa * sb)
            j = j + 1
        end
        i = i + 1
    end
    out c
end.

export QuantizedTensor, QBITS_INT8, QBITS_INT4, QMAX_INT8, QMAX_INT4
export quantize_tensor, quantize_tensor_perchannel
export dequantize_tensor
export quantized_matmul
export qtensor_free
