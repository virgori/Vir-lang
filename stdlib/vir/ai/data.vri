##
 * vir/ai/data.vri — Data Loading & Batching Pipeline
 * ====================================================
 * Dataset abstraction with batching, shuffling, and preprocessing.
 * Replaces torch.utils.data.DataLoader at the stdlib level.
 *
 * Features
 *   - Sequential and shuffled iteration
 *   - Configurable batch size with optional drop-last
 *   - Prefetch buffer for async I/O (future)
 *   - Data augmentation hooks via transform functions
 *   - Fisher-Yates shuffle (unbiased)
 ##

include types;
include alloc;
import alloc, alloc_zeroed, free from alloc;
include copy;
import mem_copy from copy;
include basic;
import abs_f from basic;
include rand;
import rand_int from rand;

# ═══════════════════════════════════════════════════════
# Dataset Entity
# ═══════════════════════════════════════════════════════

entity Dataset:
    data:       ptr;       # flat buffer of samples,
        labels:     ptr;       # flat buffer of labels (optional),
        n_samples:  int;       # total number of samples,
        sample_size: int;      # size of each sample in floats,
        label_size: int;       # size of each label in floats (0 = unsupervised);
end.

func dataset_new:
    in(data: ptr; labels: ptr; n_samples: int; sample_size: int; label_size: int)
    out Dataset (
        data:       data,
        labels:     labels,
        n_samples:  n_samples,
        sample_size: sample_size,
        label_size: label_size
    );
end

# Get a sample by index (returns pointer to start of sample);
func dataset_get_sample:
    in(ds: Dataset; idx: int)
    out ds.data + idx * ds.sample_size;
end

# Get a label by index;
func dataset_get_label:
    in(ds: Dataset; idx: int)
    if ds.label_size == 0 do
        out none;
    end
    out ds.labels + idx * ds.label_size;
end

# ═══════════════════════════════════════════════════════
# DataLoader Entity
# ═══════════════════════════════════════════════════════

entity DataLoader:
    dataset:    Dataset,
        batch_size: int,
        shuffle:    bool,
        drop_last:  bool,
        indices:    ptr;       # shuffled index array,
        current:    int;       # current position,
        n_batches:  int;       # total batches per epoch;
end.

func dataloader_new:
    in(dataset: Dataset; batch_size: int; shuffle: bool)
    var n_batches = dataset.n_samples / batch_size;
    if dataset.n_samples mod batch_size != 0 do
        n_batches = n_batches + 1;
    end

    # Allocate index array;
    var indices = alloc(dataset.n_samples * 4);
    var i = 0;
    when i < dataset.n_samples loop
        native_store<int>(indices; i; i);
        i = i + 1;
    end

    out DataLoader (
        dataset:    dataset,
        batch_size: batch_size,
        shuffle:    shuffle,
        drop_last:  false,
        indices:    indices,
        current:    0,
        n_batches:  n_batches
    );
end

# ═══════════════════════════════════════════════════════
# Shuffling (Fisher-Yates)
# ═══════════════════════════════════════════════════════

func shuffle_indices:
    in(loader: DataLoader)
    var n = loader.dataset.n_samples;
    var i = n - 1;
    when i > 0 loop
        var j = rand_int(0; i + 1);
        # Swap indices[i] and indices[j];
        var tmp = native_load<int>(loader.indices; i);
        native_store<int>(loader.indices; i; native_load<int>(loader.indices; j));
        native_store<int>(loader.indices; j; tmp);
        i = i - 1;
    end
end

# ═══════════════════════════════════════════════════════
# Iteration
# ═══════════════════════════════════════════════════════

entity Batch:
    data:    ptr;     # batch_size × sample_size buffer,
        labels:  ptr;     # batch_size × label_size buffer,
        size:    int;     # actual batch size (may be < batch_size for last batch);
end

# Reset loader for new epoch (optionally shuffle);
func dataloader_reset:
    in(loader: DataLoader)
    loader.current = 0;
    if loader.shuffle do
        shuffle_indices(loader);
    end
end

# Get next batch, returns none when exhausted;
func dataloader_next:
    in(loader: DataLoader)
    if loader.current >= loader.dataset.n_samples do
        out none;
    end

    var start = loader.current;
    var end_idx = start + loader.batch_size;
    if end_idx > loader.dataset.n_samples do
        if loader.drop_last do
            out none;
        end
        end_idx = loader.dataset.n_samples;
    end
    var actual_size = end_idx - start;

    # Allocate batch buffers;
    var batch_data = alloc(actual_size * loader.dataset.sample_size * 8);
    var batch_labels = none;
    if loader.dataset.label_size > 0 do
        batch_labels = alloc(actual_size * loader.dataset.label_size * 8);
    end

    # Copy samples via index array;
    var i = 0;
    when i < actual_size loop
        var idx = native_load<int>(loader.indices; start + i);
        var src = loader.dataset.data + idx * loader.dataset.sample_size * 8;
        var dst = batch_data + i * loader.dataset.sample_size * 8;
        mem_copy(dst; src; loader.dataset.sample_size * 8);

        if loader.dataset.label_size > 0 do
            var lsrc = loader.dataset.labels + idx * loader.dataset.label_size * 8;
            var ldst = batch_labels + i * loader.dataset.label_size * 8;
            mem_copy(ldst; lsrc; loader.dataset.label_size * 8);
        end
        i = i + 1;
    end

    loader.current = end_idx;

    out Batch (
        data:   batch_data,
        labels: batch_labels,
        size:   actual_size
    );
end

# Free batch buffers;
func batch_free:
    in(batch: Batch)
    free(batch.data);
    if batch.labels != none do
        free(batch.labels);
    end
end

# Free dataloader;
func dataloader_free:
    in(loader: DataLoader)
    free(loader.indices);
end

export Dataset, DataLoader, Batch;
export dataset_new, dataset_get_sample, dataset_get_label;
export dataloader_new, dataloader_reset, dataloader_next;
export batch_free, dataloader_free;
export shuffle_indices;
