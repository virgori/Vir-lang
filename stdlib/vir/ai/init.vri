##
 * vir/ai/init.vri — AI Module Index
 * ====================================
 * Convenience module that re-exports all AI submodules.
 *
 * Usage
 *   include ai;
 *   # Now all AI functions available
 ##

include ai/train;
include ai/data;
include ai/model;
include ai/transform;
include ai/metrics;
include ai/tokenizer;

# Re-export from math (neural network primitives);
include math/tensor;
include math/nn;
include math/grad;
include math/optim;
include math/attention;

export TrainConfig, TrainState;
export train_config, train_state_new, train_step;
export lr_schedule, clip_grad_norm, clip_grad_value;
export mse_loss, cross_entropy_loss;

export Dataset, DataLoader, Batch;
export dataset_new, dataloader_new, dataloader_reset, dataloader_next;
export batch_free, dataloader_free;

export Model, Checkpoint;
export model_new, model_free, model_save, model_load;
export checkpoint_save, checkpoint_load;

export normalize, normalize_auto, standardize;
export noise_inject, dropout_mask, dropout_apply;
export one_hot;

export accuracy, precision, recall, f1_score, top_k_accuracy;
export mae, mse, rmse, r_squared;

export Vocab, WordTokenizer;
export vocab_new, word_tokenizer_new, word_encode, word_decode;
