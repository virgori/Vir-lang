##
 * vir/ai/onnx.vri — ONNX Runtime Inference
 * ==========================================
 * Inspired by Python: onnxruntime
 * Inspired by Rust: ort (onnxruntime-rs)
 * Inspired by C: ONNX Runtime C API
 *
 * FFI wrapper to load and execute ONNX models.
 * Supports CPU execution provider, tensor I/O.
 ##

include types;
include result;
import Result, Ok, Err from result;
include option;
import Option, Some, None from option;
include string;
import String, str_new, str_ptr from string;
include vec;
import Vec, vec_new, vec_push, vec_len, vec_get from vec;

# ═══════════════════════════════════════════════════════
# Tensor Element Types (ONNX TensorProto.DataType)
# ═══════════════════════════════════════════════════════

const ONNX_FLOAT:   1;
const ONNX_UINT8:   2;
const ONNX_INT8:    3;
const ONNX_INT16:   5;
const ONNX_INT32:   6;
const ONNX_INT64:   7;
const ONNX_FLOAT16: 10;
const ONNX_DOUBLE:  11;
const ONNX_BOOL:    9;

# ═══════════════════════════════════════════════════════
# Entities
# ═══════════════════════════════════════════════════════

entity OnnxEnv:
    _handle: ptr;
end
entity OnnxSession:
    _handle: ptr,
        _env:    ptr,
        model_path: string;
end
entity OnnxTensor:
    _handle: ptr,
        shape:   Vec<int>,
        dtype:   int;        # ONNX_FLOAT, etc.
    name:    string;
end
entity OnnxSessionOptions:
    _handle: ptr;
end

# ═══════════════════════════════════════════════════════
# Environment
# ═══════════════════════════════════════════════════════

## Create the ONNX Runtime environment (call once).
func onnx_env_new:
    in(name: string)
    h = native_ort_create_env(str_ptr(name));
    if h == 0 do
        out Err(str_new("onnx: failed to create environment"));
    end
    out Ok(OnnxEnv ( _handle = h ));
end
func onnx_env_release:
    in(env: OnnxEnv)
    native_ort_release_env(env._handle);
end
# ═══════════════════════════════════════════════════════
# Session Options
# ═══════════════════════════════════════════════════════

func onnx_session_options_new:
    h = native_ort_create_session_options();
    out OnnxSessionOptions ( _handle = h );
end
## Set inter-op thread count.
func onnx_options_set_threads:
    in(opts: OnnxSessionOptions; count: int)
    native_ort_set_intra_op_threads(opts._handle, count);
end
## Enable graph optimization (0=disabled, 1=basic, 2=extended, 99=all).
func onnx_options_set_optimization:
    in(opts: OnnxSessionOptions; level: int)
    native_ort_set_graph_optimization(opts._handle, level);
end
func onnx_session_options_release:
    in(opts: OnnxSessionOptions)
    native_ort_release_session_options(opts._handle);
end
# ═══════════════════════════════════════════════════════
# Session (Model Loading)
# ═══════════════════════════════════════════════════════

## Load an ONNX model file.
func onnx_session_new:
    in(env: OnnxEnv; path: string; opts: OnnxSessionOptions)
    h = native_ort_create_session(env._handle, str_ptr(path), opts._handle);
    if h == 0 do
        out Err(str_new("onnx: failed to load model"));
    end
    out Ok(OnnxSession ( _handle = h, _env = env._handle, model_path = path ));
end
## Release session resources.
func onnx_session_release:
    in(session: OnnxSession)
    native_ort_release_session(session._handle);
end
## Get input names.
func onnx_session_input_names:
    in(session: OnnxSession)
    count = native_ort_session_input_count(session._handle);
    names = vec_new<string>();
    i = 0;
    when i < count loop
        name = native_ort_session_input_name(session._handle, i);
        vec_push<string>(&names, name);
        i = i + 1;
    end
    out names;
end
## Get output names.
func onnx_session_output_names:
    in(session: OnnxSession)
    count = native_ort_session_output_count(session._handle);
    names = vec_new<string>();
    i = 0;
    when i < count loop
        name = native_ort_session_output_name(session._handle, i);
        vec_push<string>(&names, name);
        i = i + 1;
    end
    out names;
end
# ═══════════════════════════════════════════════════════
# Tensor Creation
# ═══════════════════════════════════════════════════════

## Create a float tensor from a flat Vec<float> and shape.
func onnx_tensor_from_floats:
    in(name: string; data: Vec<float>; shape: Vec<int>)
    h = native_ort_create_tensor_float(
        vec_data_ptr(data), vec_len<float>(data),
        vec_data_ptr(shape), vec_len<int>(shape)
    );
    if h == 0 do
        out Err(str_new("onnx: tensor creation failed"));
    end
    out Ok(OnnxTensor ( _handle = h, shape = shape, dtype = ONNX_FLOAT, name = name ));
end
## Create an int32 tensor.
func onnx_tensor_from_ints:
    in(name: string; data: Vec<int>; shape: Vec<int>)
    h = native_ort_create_tensor_int32(
        vec_data_ptr(data), vec_len<int>(data),
        vec_data_ptr(shape), vec_len<int>(shape)
    );
    if h == 0 do
        out Err(str_new("onnx: tensor creation failed"));
    end
    out Ok(OnnxTensor ( _handle = h, shape = shape, dtype = ONNX_INT32, name = name ));
end
## Release a tensor.
func onnx_tensor_release:
    in(tensor: OnnxTensor)
    native_ort_release_value(tensor._handle);
end
## Extract float data from output tensor.
func onnx_tensor_to_floats:
    in(tensor: OnnxTensor)
    count = 1;
    i = 0;
    when i < vec_len<int>(tensor.shape) loop
        count = count * vec_get<int>(tensor.shape, i);
        i = i + 1;
    end
    data = vec_new<float>();
    data_ptr = native_ort_get_tensor_data(tensor._handle);
    j = 0;
    when j < count loop
        vec_push<float>(&data, native_load_f32(ptr_add(data_ptr, j * 4)));
        j = j + 1;
    end
    out data;
end
# ═══════════════════════════════════════════════════════
# Inference
# ═══════════════════════════════════════════════════════

## Run inference with input tensors, returns output tensors.
func onnx_run:
    in(session: OnnxSession; inputs: Vec<OnnxTensor>)
    ninputs = vec_len<OnnxTensor>(inputs);

    # Build arrays for C API
    input_names = vec_new<ptr>();
    input_vals = vec_new<ptr>();
    i = 0;
    when i < ninputs loop
        t = vec_get<OnnxTensor>(inputs, i);
        vec_push<ptr>(&input_names, str_ptr(t.name));
        vec_push<ptr>(&input_vals, t._handle);
        i = i + 1;
    end

    output_names_str = onnx_session_output_names(session);
    noutputs = vec_len<string>(output_names_str);
    output_name_ptrs = vec_new<ptr>();
    j = 0;
    when j < noutputs loop
        vec_push<ptr>(&output_name_ptrs, str_ptr(vec_get<string>(output_names_str, j)));
        j = j + 1;
    end

    rc = native_ort_run(
        session._handle,
        vec_data_ptr(input_names), vec_data_ptr(input_vals), ninputs,
        vec_data_ptr(output_name_ptrs), noutputs
    );

    if rc == 0 do
        out Err(str_new("onnx: inference failed"));
    end

    # Collect output tensors
    outputs = vec_new<OnnxTensor>();
    k = 0;
    when k < noutputs loop
        oh = native_ort_get_output(rc, k);
        out_shape = _onnx_get_output_shape(oh);
        vec_push<OnnxTensor>(&outputs, OnnxTensor (
            _handle = oh, shape = out_shape,
            dtype = ONNX_FLOAT, name = vec_get<string>(output_names_str, k)
        ));
        k = k + 1;
    end
    out Ok(outputs);
end
func _onnx_get_output_shape:
    in(tensor_handle: ptr)
    ndim = native_ort_tensor_ndim(tensor_handle);
    shape = vec_new<int>();
    i = 0;
    when i < ndim loop
        vec_push<int>(&shape, native_ort_tensor_dim(tensor_handle, i));
        i = i + 1;
    end
    out shape;
end
# ═══════════════════════════════════════════════════════
# Native FFI
# ═══════════════════════════════════════════════════════

extern func native_ort_create_env(name: ptr) -> ptr
extern func native_ort_release_env(env: ptr)
extern func native_ort_create_session_options() -> ptr
extern func native_ort_release_session_options(opts: ptr)
extern func native_ort_set_intra_op_threads(opts: ptr; count: int)
extern func native_ort_set_graph_optimization(opts: ptr; level: int)
extern func native_ort_create_session(env: ptr; path: ptr; opts: ptr) -> ptr
extern func native_ort_release_session(session: ptr)
extern func native_ort_session_input_count(session: ptr) -> int
extern func native_ort_session_input_name(session: ptr; index: int) -> string
extern func native_ort_session_output_count(session: ptr) -> int
extern func native_ort_session_output_name(session: ptr; index: int) -> string
extern func native_ort_create_tensor_float(data: ptr; len: int; shape: ptr; ndim: int) -> ptr
extern func native_ort_create_tensor_int32(data: ptr; len: int; shape: ptr; ndim: int) -> ptr
extern func native_ort_release_value(val: ptr)
extern func native_ort_get_tensor_data(val: ptr) -> ptr
extern func native_ort_tensor_ndim(val: ptr) -> int
extern func native_ort_tensor_dim(val: ptr; i: int) -> int
extern func native_ort_run(session: ptr; in_names: ptr; in_vals: ptr; nin: int; out_names: ptr; nout: int) -> ptr
extern func native_ort_get_output(result: ptr; i: int) -> ptr
