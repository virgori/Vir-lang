##
 * vir/ai/tokenizer.vri — Text Tokenizer for NLP
 * ================================================
 * Byte-Pair Encoding (BPE) and word-level tokenization
 * for natural language processing tasks.
 *
 * Features:
 *   - Word-level tokenizer with vocabulary
 *   - BPE tokenizer (subword) for open-vocabulary models
 *   - Vocabulary builder from corpus
 *   - Encode text → token IDs, decode IDs → text
 *   - Special tokens: [PAD], [UNK], [BOS], [EOS]
 ##

include types;
include alloc;
import alloc, alloc_zeroed, free, realloc from alloc;
include str;
import str_len, str_char_at, str_split, str_lower from str;

# ═══════════════════════════════════════════════════════
# Special Token IDs
# ═══════════════════════════════════════════════════════

const PAD_ID: 0;
const UNK_ID: 1;
const BOS_ID: 2;
const EOS_ID: 3;
const FIRST_REAL_ID: 4;

# ═══════════════════════════════════════════════════════
# Vocabulary Entity
# ═══════════════════════════════════════════════════════

entity Vocab:
    tokens:   ptr;       # array of strings;
    ids:      ptr;       # hash map: string → int;
    size:     int;       # total vocabulary size;
    capacity: int;       # allocated capacity;
end

func vocab_new:
    in(capacity: int)
    var v = Vocab {
        tokens:   alloc(capacity * 8);
        ids:      alloc_zeroed(capacity * 12);
        size:     FIRST_REAL_ID;
        capacity: capacity;
    };
    # Add special tokens;
    native_store<string>(v.tokens; 0; "[PAD]");
    native_store<string>(v.tokens; 1; "[UNK]");
    native_store<string>(v.tokens; 2; "[BOS]");
    native_store<string>(v.tokens; 3; "[EOS]");
    out v;
end

func vocab_add:
    in(v: Vocab; token: string)
    if v.size >= v.capacity:
        out UNK_ID;
    end
    var id = v.size;
    native_store<string>(v.tokens; id; token);
    # Store in hash map (simplified);
    native_store<int>(v.ids; id; id);
    v.size = v.size + 1;
    out id;
end

func vocab_lookup:
    in(v: Vocab; token: string)
    var i = 0;
    when i < v.size loop
        if native_load<string>(v.tokens; i) == token:
            out i;
        end
        i = i + 1;
    end
    out UNK_ID;
end

func vocab_decode:
    in(v: Vocab; id: int)
    if id < 0:
        out "[UNK]";
    eif id >= v.size:
        out "[UNK]";
    end
    out native_load<string>(v.tokens; id);
end

func vocab_free:
    in(v: Vocab)
    free(v.tokens);
    free(v.ids);
end

# ═══════════════════════════════════════════════════════
# Word-Level Tokenizer
# ═══════════════════════════════════════════════════════

entity WordTokenizer:
    vocab:     Vocab;
    lowercase: bool;
end

func word_tokenizer_new:
    in(vocab_size: int; lowercase: bool)
    out WordTokenizer {
        vocab:     vocab_new(vocab_size);
        lowercase: lowercase;
    };
end

# Encode text → array of token IDs;
func word_encode:
    in(tok: WordTokenizer; text: string; max_len: int)
    var result = alloc(max_len * 4);
    var processed = text;
    if tok.lowercase:
        processed = str_lower(text);
    end
    var words = str_split(processed; " ");
    var i = 0;
    var pos = 0;

    # BOS token;
    native_store<int>(result; pos; BOS_ID);
    pos = pos + 1;

    when i < words.len & pos < max_len - 1 loop
        var id = vocab_lookup(tok.vocab; words[i]);
        native_store<int>(result; pos; id);
        pos = pos + 1;
        i = i + 1;
    end

    # EOS token;
    native_store<int>(result; pos; EOS_ID);
    pos = pos + 1;

    # Pad remaining;
    when pos < max_len loop
        native_store<int>(result; pos; PAD_ID);
        pos = pos + 1;
    end

    out result;
end

# Decode token IDs → text string;
func word_decode:
    in(tok: WordTokenizer; ids: ptr; n: int)
    var result = "";
    var i = 0;
    when i < n loop
        var id = native_load<int>(ids; i);
        if id != PAD_ID & id != BOS_ID & id != EOS_ID:
            if result != "":
                result = result + " ";
            end
            result = result + vocab_decode(tok.vocab; id);
        end
        i = i + 1;
    end
    out result;
end

# Build vocabulary from corpus (array of sentences);
func vocab_build:
    in(tok: WordTokenizer; corpus: ptr; n_docs: int; min_freq: int)
    # Simple frequency-based vocabulary building;
    # Count word frequencies across all documents;
    var freq_words = alloc(tok.vocab.capacity * 8);
    var freq_counts = alloc_zeroed(tok.vocab.capacity * 4);
    var n_unique = 0;

    var doc = 0;
    when doc < n_docs loop
        var text = native_load<string>(corpus; doc);
        if tok.lowercase:
            text = str_lower(text);
        end
        var words = str_split(text; " ");
        var w = 0;
        when w < words.len loop
            # Find or insert word;
            var found = false;
            var k = 0;
            when k < n_unique loop
                if native_load<string>(freq_words; k) == words[w]:
                    var c = native_load<int>(freq_counts; k);
                    native_store<int>(freq_counts; k; c + 1);
                    found = true;
                    break;
                end
                k = k + 1;
            end
            if !found & n_unique < tok.vocab.capacity:
                native_store<string>(freq_words; n_unique; words[w]);
                native_store<int>(freq_counts; n_unique; 1);
                n_unique = n_unique + 1;
            end
            w = w + 1;
        end
        doc = doc + 1;
    end

    # Add words meeting min_freq threshold;
    var i = 0;
    when i < n_unique loop
        var count = native_load<int>(freq_counts; i);
        if count >= min_freq:
            vocab_add(tok.vocab; native_load<string>(freq_words; i));
        end
        i = i + 1;
    end

    free(freq_words);
    free(freq_counts);
end

func word_tokenizer_free:
    in(tok: WordTokenizer)
    vocab_free(tok.vocab);
end

export Vocab, WordTokenizer;
export PAD_ID, UNK_ID, BOS_ID, EOS_ID;
export vocab_new, vocab_add, vocab_lookup, vocab_decode, vocab_free;
export word_tokenizer_new, word_encode, word_decode, vocab_build;
export word_tokenizer_free;
