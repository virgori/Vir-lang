##
 * vir/ai/vision.vri — Computer Vision Utilities
 * =================================================
 * Inspired by Python: OpenCV (cv2), torchvision.transforms
 * Inspired by Rust: imageproc
 *
 * Image processing functions for ML/AI: convolution filters,
 * edge detection, image-to-tensor conversion, augmentation.
 ##

include types;
include result;
import Result, Ok, Err from result;
include string;
import String, str_new from string;
include vec;
import Vec, vec_new, vec_push, vec_len, vec_get from vec;
include math;
import sqrt, abs_f, min, max from math;
include image;
import Image, image_new, image_get_pixel, image_set_pixel,
       Rgba, PixelFormat from image;

# ═══════════════════════════════════════════════════════
# Convolution Kernel
# ═══════════════════════════════════════════════════════

entity Kernel:
    data:   Vec<float>,
        width:  int;          # must be odd
    height: int;
end.
func kernel_new:
    in  data: Vec<float>;
        width: int;
        height: int
    out Kernel ( data = data, width = width, height = height );
end.
## Apply convolution filter to a grayscale image.
func convolve(img: Image, kern: Kernel):
    out_img = image_new(img.width, img.height, img.format);
    half_w = kern.width / 2;
    half_h = kern.height / 2;

    y = 0;
    when y < img.height loop
        x = 0;
        when x < img.width loop
            sum_r = 0.0; sum_g = 0.0; sum_b = 0.0;
            ky = 0;
            when ky < kern.height loop
                kx = 0;
                when kx < kern.width loop
                    sx = x + kx - half_w;
                    sy = y + ky - half_h;
                    px = image_get_pixel(img, sx, sy);
                    w = vec_get<float>(kern.data, ky * kern.width + kx);
                    sum_r = sum_r + px.r * w;
                    sum_g = sum_g + px.g * w;
                    sum_b = sum_b + px.b * w;
                    kx = kx + 1;
                end
                ky = ky + 1;
            end
            nr = _clamp_byte_f(sum_r);
            ng = _clamp_byte_f(sum_g);
            nb = _clamp_byte_f(sum_b);
            image_set_pixel(out_img, x, y,
                Rgba ( r = nr, g = ng, b = nb, a = 255 ));
            x = x + 1;
        end
        y = y + 1;
    end
    out out_img;
end.
# ═══════════════════════════════════════════════════════
# Built-in Kernels
# ═══════════════════════════════════════════════════════

## 3x3 Gaussian blur.
func kernel_gaussian_3x3:
    d = vec_new<float>();
    # 1/16 * [1 2 1; 2 4 2; 1 2 1]
    vec_push<float>(&d, 0.0625); vec_push<float>(&d, 0.125);  vec_push<float>(&d, 0.0625);
    vec_push<float>(&d, 0.125);  vec_push<float>(&d, 0.25);   vec_push<float>(&d, 0.125);
    vec_push<float>(&d, 0.0625); vec_push<float>(&d, 0.125);  vec_push<float>(&d, 0.0625);
    out Kernel ( data = d, width = 3, height = 3 );
end.
## 3x3 Sharpen.
func kernel_sharpen_3x3:
    d = vec_new<float>();
    vec_push<float>(&d,  0.0); vec_push<float>(&d, -1.0); vec_push<float>(&d,  0.0);
    vec_push<float>(&d, -1.0); vec_push<float>(&d,  5.0); vec_push<float>(&d, -1.0);
    vec_push<float>(&d,  0.0); vec_push<float>(&d, -1.0); vec_push<float>(&d,  0.0);
    out Kernel ( data = d, width = 3, height = 3 );
end.
## Sobel X (horizontal edge).
func kernel_sobel_x:
    d = vec_new<float>();
    vec_push<float>(&d, -1.0); vec_push<float>(&d, 0.0); vec_push<float>(&d, 1.0);
    vec_push<float>(&d, -2.0); vec_push<float>(&d, 0.0); vec_push<float>(&d, 2.0);
    vec_push<float>(&d, -1.0); vec_push<float>(&d, 0.0); vec_push<float>(&d, 1.0);
    out Kernel ( data = d, width = 3, height = 3 );
end.
## Sobel Y (vertical edge).
func kernel_sobel_y:
    d = vec_new<float>();
    vec_push<float>(&d, -1.0); vec_push<float>(&d, -2.0); vec_push<float>(&d, -1.0);
    vec_push<float>(&d,  0.0); vec_push<float>(&d,  0.0); vec_push<float>(&d,  0.0);
    vec_push<float>(&d,  1.0); vec_push<float>(&d,  2.0); vec_push<float>(&d,  1.0);
    out Kernel ( data = d, width = 3, height = 3 );
end.
# ═══════════════════════════════════════════════════════
# Edge Detection
# ═══════════════════════════════════════════════════════

## Sobel edge detection (magnitude of Gx,Gy).
func edge_detect_sobel(img: Image):
    gx_img = convolve(img, kernel_sobel_x());
    gy_img = convolve(img, kernel_sobel_y());
    out_img = image_new(img.width, img.height, PixelFormat.FormatGray);

    y = 0;
    when y < img.height loop
        x = 0;
        when x < img.width loop
            gx = image_get_pixel(gx_img, x, y);
            gy = image_get_pixel(gy_img, x, y);
            mag = sqrt(gx.r * gx.r + gy.r * gy.r);
            v = _clamp_byte_f(mag);
            out_img.data[y * img.width + x] = v;
            x = x + 1;
        end
        y = y + 1;
    end
    out out_img;
end.
## Simple threshold: pixels above threshold become 255, below become 0.
func threshold(img: Image, thresh: int):
    out_img = image_new(img.width, img.height, PixelFormat.FormatGray);
    y = 0;
    when y < img.height loop
        x = 0;
        when x < img.width loop
            px = image_get_pixel(img, x, y);
            gray = (px.r * 299 + px.g * 587 + px.b * 114) / 1000;
            out_img.data[y * img.width + x] = if gray > thresh do 255; else 0; end;
            x = x + 1;
        end
        y = y + 1;
    end
    out out_img;
end.
# ═══════════════════════════════════════════════════════
# Image ↔ Tensor Conversion (for ML)
# ═══════════════════════════════════════════════════════

## Convert image to NCHW float tensor (batch=1, channels=3, H, W).
## Values normalized to [0.0, 1.0].
func image_to_tensor_nchw(img: Image):
    # Output shape: [1, 3, H, W]
    total = 3 * img.height * img.width;
    tensor = vec_new<float>();
    # Pre-allocate
    i = 0;
    when i < total loop
        vec_push<float>(&tensor, 0.0);
        i = i + 1;
    end

    ch_stride = img.height * img.width;
    y = 0;
    when y < img.height loop
        x = 0;
        when x < img.width loop
            px = image_get_pixel(img, x, y);
            idx = y * img.width + x;
            tensor[0 * ch_stride + idx] = px.r / 255.0;    # R channel
            tensor[1 * ch_stride + idx] = px.g / 255.0;    # G channel
            tensor[2 * ch_stride + idx] = px.b / 255.0;    # B channel
            x = x + 1;
        end
        y = y + 1;
    end
    out tensor;
end.
## Convert image to NHWC float tensor (batch=1, H, W, channels=3).
func image_to_tensor_nhwc(img: Image):
    tensor = vec_new<float>();
    y = 0;
    when y < img.height loop
        x = 0;
        when x < img.width loop
            px = image_get_pixel(img, x, y);
            vec_push<float>(&tensor, px.r / 255.0);
            vec_push<float>(&tensor, px.g / 255.0);
            vec_push<float>(&tensor, px.b / 255.0);
            x = x + 1;
        end
        y = y + 1;
    end
    out tensor;
end.
## Normalize tensor with per-channel mean and std (ImageNet defaults).
func tensor_normalize:
    in  tensor: Vec<float>;
        channels: int;
        h: int;
        w: int;
        mean: Vec<float>;
        std: Vec<float>
    ch_stride = h * w;
    c = 0;
    when c < channels loop
        m = vec_get<float>(mean, c);
        s = vec_get<float>(std, c);
        i = 0;
        when i < ch_stride loop
            idx = c * ch_stride + i;
            tensor[idx] = (vec_get<float>(tensor, idx) - m) / s;
            i = i + 1;
        end
        c = c + 1;
    end
    out tensor;
end.
## ImageNet normalization defaults.
func imagenet_mean:
    m = vec_new<float>();
    vec_push<float>(&m, 0.485);
    vec_push<float>(&m, 0.456);
    vec_push<float>(&m, 0.406);
    out m;
end.
func imagenet_std:
    s = vec_new<float>();
    vec_push<float>(&s, 0.229);
    vec_push<float>(&s, 0.224);
    vec_push<float>(&s, 0.225);
    out s;
end.
# ═══════════════════════════════════════════════════════
# Data Augmentation
# ═══════════════════════════════════════════════════════

## Add random noise to an image.
func augment_noise(img: Image, intensity: int):
    out_img = image_new(img.width, img.height, img.format);
    y = 0;
    when y < img.height loop
        x = 0;
        when x < img.width loop
            px = image_get_pixel(img, x, y);
            # Simple deterministic noise based on position
            noise = ((x * 7 + y * 13) % (intensity * 2 + 1)) - intensity;
            nr = _clamp_byte_i(px.r + noise);
            ng = _clamp_byte_i(px.g + noise);
            nb = _clamp_byte_i(px.b + noise);
            image_set_pixel(out_img, x, y,
                Rgba ( r = nr, g = ng, b = nb, a = px.a ));
            x = x + 1;
        end
        y = y + 1;
    end
    out out_img;
end.
## Center crop to square.
func augment_center_crop(img: Image, size: int):
    sx = (img.width - size) / 2;
    sy = (img.height - size) / 2;
    if sx < 0 do sx = 0 end
    if sy < 0 do sy = 0 end
    out_img = image_new(size, size, img.format);
    y = 0;
    when y < size loop
        x = 0;
        when x < size loop
            px = image_get_pixel(img, sx + x, sy + y);
            image_set_pixel(out_img, x, y, px);
            x = x + 1;
        end
        y = y + 1;
    end
    out out_img;
end.
# ═══════════════════════════════════════════════════════
# Helpers
# ═══════════════════════════════════════════════════════

func _clamp_byte_f(v: float):
    if v < 0.0 do out 0 end
    if v > 255.0 do out 255 end
    out v;
end.
func _clamp_byte_i(v: int):
    if v < 0 do out 0 end
    if v > 255 do out 255 end
    out v;
end.