##
 * vir/ai/transform.vri — Data Augmentation & Transforms
 * =======================================================
 * Image and data preprocessing transforms for training pipelines.
 * Operates on flat float buffers (tensors).
 *
 * Transforms
 *   - normalize: zero-mean, unit-variance
 *   - standardize: min-max to [0, 1]
 *   - random_crop: extract random sub-region
 *   - random_flip: horizontal/vertical flip
 *   - noise_inject: add Gaussian noise
 *   - dropout_mask: random binary mask
 ##

include types;
include alloc;
import alloc, alloc_zeroed, free from alloc;
include basic;
import sqrt, abs_f from basic;
include rand;
import rand_float, rand_int from rand;

# ═══════════════════════════════════════════════════════
# Normalize: (x - mean) / std
# ═══════════════════════════════════════════════════════

func normalize:
    in(data: ptr; n: int; mean: float; std: float)
    var i = 0;
    when i < n loop
        var v = native_load<float>(data; i);
        native_store<float>(data; i; (v - mean) / std);
        i = i + 1;
    end
end

# Auto-compute mean and std, then normalize;
func normalize_auto:
    in(data: ptr; n: int)
    # Compute mean;
    var sum = 0.0;
    var i = 0;
    when i < n loop
        sum = sum + native_load<float>(data; i);
        i = i + 1;
    end
    var mean = sum / n >> float;

    # Compute std;
    var var_sum = 0.0;
    i = 0;
    when i < n loop
        var diff = native_load<float>(data; i) - mean;
        var_sum = var_sum + diff * diff;
        i = i + 1;
    end
    var std = sqrt(var_sum / n >> float);
    if std < 0.000001 do
        std = 0.000001;
    end

    normalize(data; n; mean; std);
end

# ═══════════════════════════════════════════════════════
# Standardize: min-max scaling to [0, 1]
# ═══════════════════════════════════════════════════════

func standardize:
    in(data: ptr; n: int)
    var min_val = native_load<float>(data; 0);
    var max_val = min_val;
    var i = 1;
    when i < n loop
        var v = native_load<float>(data; i);
        if v < min_val do
            min_val = v;
        end
        if v > max_val do
            max_val = v;
        end
        i = i + 1;
    end
    var range = max_val - min_val;
    if range < 0.000001 do
        range = 0.000001;
    end
    i = 0;
    when i < n loop
        var v = native_load<float>(data; i);
        native_store<float>(data; i; (v - min_val) / range);
        i = i + 1;
    end
end

# ═══════════════════════════════════════════════════════
# Noise Injection: Gaussian noise via Box-Muller
# ═══════════════════════════════════════════════════════

func noise_inject:
    in(data: ptr; n: int; stddev: float)
    var i = 0;
    when i < n loop
        # Box-Muller transform for Gaussian;
        var u1 = rand_float(0.0001; 1.0);
        var u2 = rand_float(0.0; 1.0);
        var PI = 3.14159265358979;
        var z = sqrt(0.0 - 2.0 * native_log(u1)) * native_cos(2.0 * PI * u2);
        var v = native_load<float>(data; i);
        native_store<float>(data; i; v + z * stddev);
        i = i + 1;
    end
end

# ═══════════════════════════════════════════════════════
# Dropout Mask: random binary mask
# ═══════════════════════════════════════════════════════

# Generate dropout mask: 1 with prob (1-rate), 0 with prob rate;
func dropout_mask:
    in(mask: ptr; n: int; dropout_rate: float)
    var i = 0;
    when i < n loop
        var r = rand_float(0.0; 1.0);
        if r < dropout_rate do
            native_store<float>(mask; i; 0.0);
        else
            native_store<float>(mask; i; 1.0 / (1.0 - dropout_rate));
        end
        i = i + 1;
    end
end

# Apply dropout mask in-place;
func dropout_apply:
    in(data: ptr; mask: ptr; n: int)
    var i = 0;
    when i < n loop
        var v = native_load<float>(data; i);
        var m = native_load<float>(mask; i);
        native_store<float>(data; i; v * m);
        i = i + 1;
    end
end

# ═══════════════════════════════════════════════════════
# One-Hot Encoding
# ═══════════════════════════════════════════════════════

func one_hot:
    in(labels: ptr; n: int; num_classes: int; output: ptr)
    var i = 0;
    when i < n loop
        var label = native_load<int>(labels; i);
        var j = 0;
        when j < num_classes loop
            if j == label do
                native_store<float>(output; i * num_classes + j; 1.0);
            else
                native_store<float>(output; i * num_classes + j; 0.0);
            end
            j = j + 1;
        end
        i = i + 1;
    end
end

export normalize, normalize_auto, standardize;
export noise_inject, dropout_mask, dropout_apply;
export one_hot;
