##
 * vir/ai/pipeline.vri — ML Data Pipeline
 * =========================================
 * Inspired by Python: scikit-learn Pipeline, torchvision.transforms
 * Inspired by Rust: smartcore
 *
 * Composable data transformation pipeline for ML preprocessing.
 * Chain steps like normalize, tokenize, one-hot encode, etc.
 ##

include types;
include result;
import Result, Ok, Err from result;
include string;
import String, str_new, str_byte_len, str_ptr from string;
include vec;
import Vec, vec_new, vec_push, vec_len, vec_get from vec;
include math;
import sqrt, abs_f from math;

# ═══════════════════════════════════════════════════════
# Pipeline Core
# ═══════════════════════════════════════════════════════

## A single transform step.
entity PipelineStep:
    name:        string,
        transform:   func(Vec<float>) -> Vec<float>,
        fit:         func(Vec<float>);   # learn params from data
end

## A pipeline chains multiple steps.
entity Pipeline:
    steps: Vec<PipelineStep>;
end.

func pipeline_new:
    out Pipeline { steps = vec_new<PipelineStep>() };
end

## Add a transformation step.
func pipeline_add:
    in(pipe: Pipeline; step: PipelineStep)
    vec_push<PipelineStep>(&pipe.steps, step);
end

## Fit all steps on training data.
func pipeline_fit:
    in(pipe: Pipeline; data: Vec<float>)
    current = data;
    i = 0;
    when i < vec_len<PipelineStep>(pipe.steps) loop
        step = vec_get<PipelineStep>(pipe.steps, i);
        step.fit(current);
        current = step.transform(current);
        i = i + 1;
    end
end

## Transform data through all steps.
func pipeline_transform:
    in(pipe: Pipeline; data: Vec<float>)
    current = data;
    i = 0;
    when i < vec_len<PipelineStep>(pipe.steps) loop
        step = vec_get<PipelineStep>(pipe.steps, i);
        current = step.transform(current);
        i = i + 1;
    end
    out current;
end

## Fit + transform in one pass.
func pipeline_fit_transform:
    in(pipe: Pipeline; data: Vec<float>)
    pipeline_fit(pipe, data);
    out pipeline_transform(pipe, data);
end

# ═══════════════════════════════════════════════════════
# Built-in Steps
# ═══════════════════════════════════════════════════════

# --- Min-Max Normalize to [0, 1] ---

var _minmax_min: float = 0.0;
var _minmax_max: float = 1.0;

func _minmax_fit:
    in(data: Vec<float>)
    if vec_len<float>(data) == 0 do out end
    lo = vec_get<float>(data, 0);
    hi = lo;
    i = 1;
    when i < vec_len<float>(data) loop
        v = vec_get<float>(data, i);
        if v < lo do lo = v end
        if v > hi do hi = v end
        i = i + 1;
    end
    _minmax_min = lo;
    _minmax_max = hi;
end.

func _minmax_transform:
    in(data: Vec<float>)
    out_data = vec_new<float>();
    range = _minmax_max - _minmax_min;
    if range == 0.0 do range = 1.0 end
    i = 0;
    when i < vec_len<float>(data) loop
        v = vec_get<float>(data, i);
        vec_push<float>(&out_data, (v - _minmax_min) / range);
        i = i + 1;
    end
    out out_data;
end.

func step_minmax_normalize:
    out PipelineStep {
        name = str_new("minmax"),
        transform = _minmax_transform,
        fit = _minmax_fit
    };
end

# --- Z-Score Standardize (mean=0, std=1) ---

var _zscore_mean: float = 0.0;
var _zscore_std: float = 1.0;

func _zscore_fit:
    in(data: Vec<float>)
    n = vec_len<float>(data);
    if n == 0 do out end
    sum = 0.0;
    i = 0;
    when i < n loop
        sum = sum + vec_get<float>(data, i);
        i = i + 1;
    end
    _zscore_mean = sum / n;
    sq_sum = 0.0;
    j = 0;
    when j < n loop
        diff = vec_get<float>(data, j) - _zscore_mean;
        sq_sum = sq_sum + diff * diff;
        j = j + 1;
    end
    _zscore_std = sqrt(sq_sum / n);
    if _zscore_std == 0.0 do _zscore_std = 1.0 end
end.

func _zscore_transform:
    in(data: Vec<float>)
    out_data = vec_new<float>();
    i = 0;
    when i < vec_len<float>(data) loop
        v = vec_get<float>(data, i);
        vec_push<float>(&out_data, (v - _zscore_mean) / _zscore_std);
        i = i + 1;
    end
    out out_data;
end.

func step_zscore_standardize:
    out PipelineStep {
        name = str_new("zscore"),
        transform = _zscore_transform,
        fit = _zscore_fit
    };
end

# --- Clip values to [lo, hi] ---

func step_clip:
    in(lo: float; hi: float)
    out PipelineStep {
        name = str_new("clip"),
        transform = func(data: Vec<float>) -> Vec<float>
            out_data = vec_new<float>();
            i = 0;
            when i < vec_len<float>(data) loop
                v = vec_get<float>(data, i);
                if v < lo do v = lo end
                if v > hi do v = hi end
                vec_push<float>(&out_data, v);
                i = i + 1;
            end
            out out_data;
        end,
        fit = func(data: Vec<float>): end  # no-op
    };
end

# --- Add constant offset ---

func step_offset:
    in(amount: float)
    out PipelineStep {
        name = str_new("offset"),
        transform = func(data: Vec<float>) -> Vec<float>
            out_data = vec_new<float>();
            i = 0;
            when i < vec_len<float>(data) loop
                vec_push<float>(&out_data, vec_get<float>(data, i) + amount);
                i = i + 1;
            end
            out out_data;
        end,
        fit = func(data: Vec<float>): end
    };
end

# --- Scale by a factor ---

func step_scale:
    in(factor: float)
    out PipelineStep {
        name = str_new("scale"),
        transform = func(data: Vec<float>) -> Vec<float>
            out_data = vec_new<float>();
            i = 0;
            when i < vec_len<float>(data) loop
                vec_push<float>(&out_data, vec_get<float>(data, i) * factor);
                i = i + 1;
            end
            out out_data;
        end,
        fit = func(data: Vec<float>): end
    };
end

# ═══════════════════════════════════════════════════════
# Dataset Utilities
# ═══════════════════════════════════════════════════════

## Split dataset into train/test by ratio (e.g., 0.8 = 80% train).
func dataset_split:
    in(data: Vec<float>; ratio: float)
    n = vec_len<float>(data);
    split_idx = (n * ratio);
    train = vec_new<float>();
    test = vec_new<float>();
    i = 0;
    when i < n loop
        if i < split_idx do
            vec_push<float>(&train, vec_get<float>(data, i));
        else
            vec_push<float>(&test, vec_get<float>(data, i));
        end
        i = i + 1;
    end
    out train, test;
end

## One-hot encode integer labels (0-based) into float vectors.
func one_hot_encode:
    in(labels: Vec<int>; num_classes: int)
    encoded = vec_new<float>();
    i = 0;
    when i < vec_len<int>(labels) loop
        label = vec_get<int>(labels, i);
        j = 0;
        when j < num_classes loop
            if j == label do
                vec_push<float>(&encoded, 1.0);
            else
                vec_push<float>(&encoded, 0.0);
            end
            j = j + 1;
        end
        i = i + 1;
    end
    out encoded;
end

## Softmax over a float vector.
func softmax:
    in(data: Vec<float>)
    n = vec_len<float>(data);
    # Find max for numerical stability
    mx = vec_get<float>(data, 0);
    i = 1;
    when i < n loop
        v = vec_get<float>(data, i);
        if v > mx do mx = v end
        i = i + 1;
    end
    # exp and sum
    exps = vec_new<float>();
    sum = 0.0;
    j = 0;
    when j < n loop
        v = vec_get<float>(data, j);
        e = native_exp(v - mx);
        vec_push<float>(&exps, e);
        sum = sum + e;
        j = j + 1;
    end
    # normalize
    result = vec_new<float>();
    k = 0;
    when k < n loop
        vec_push<float>(&result, vec_get<float>(exps, k) / sum);
        k = k + 1;
    end
    out result;
end

## Argmax over a float vector.
func argmax:
    in(data: Vec<float>)
    n = vec_len<float>(data);
    best_idx = 0;
    best_val = vec_get<float>(data, 0);
    i = 1;
    when i < n loop
        v = vec_get<float>(data, i);
        if v > best_val do
            best_val = v;
            best_idx = i;
        end
        i = i + 1;
    end
    out best_idx;
end

extern func native_exp(x: float) -> float
