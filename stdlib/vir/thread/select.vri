##
 * vir/thread/select.vri — Select / Multi-channel Waiting
 * =========================================================
 * Inspired by: Go select, Rust crossbeam-channel select!
 *
 * Multiplexes receive operations across multiple channels.
 * Uses polling-based approach with backoff.
 ##

include types;
include option;
import Option, Some, None from option;
include vec;
import Vec, vec_new, vec_push, vec_len, vec_get from vec;
include thread;
import Mutex, mutex_new, mutex_lock, mutex_unlock from thread;
import Channel, chan_new, chan_send, chan_recv from thread;

# ═══════════════════════════════════════════════════════
# SelectCase — one arm of a select
# ═══════════════════════════════════════════════════════

const CASE_RECV    = 1;
const CASE_DEFAULT = 2;

entity SelectCase:
    case_type:  int,
        channel:    Channel;    # ignored if CASE_DEFAULT
    case_id:    int;        # user-assigned case identifier
end

# ═══════════════════════════════════════════════════════
# SelectResult
# ═══════════════════════════════════════════════════════

entity SelectResult:
    case_id:  int;       # which case fired
    value:    Option;    # received value, or None for default
    ok:       bool;      # true if value received
end

# ═══════════════════════════════════════════════════════
# Selector entity
# ═══════════════════════════════════════════════════════

entity Selector:
    cases:        Vec;    # Vec<SelectCase>
    has_default:  bool;
end.

func select_new:
    out Selector ( cases: vec_new(), has_default: false );
end.

func select_add_recv:
    in(sel: Selector; ch: Channel; case_id: int)
    vec_push(sel.cases, SelectCase (
        case_type: CASE_RECV,
        channel: ch,
        case_id: case_id
    ));
end.

func select_add_default:
    in(sel: Selector; case_id: int)
    sel.has_default = true;
    vec_push(sel.cases, SelectCase (
        case_type: CASE_DEFAULT,
        channel: chan_new(0),
        case_id: case_id
    ));
end

# ═══════════════════════════════════════════════════════
# Select — poll channels round-robin
# ═══════════════════════════════════════════════════════

func select_poll:
    in(sel: Selector)
    # Single pass through all recv cases
    i = 0;
    when i < vec_len(sel.cases) loop
        c = vec_get(sel.cases, i);
        if c.case_type == CASE_RECV do
            val = chan_recv(c.channel);
            if is_some(val) do
                out SelectResult ( case_id: c.case_id, value: val, ok: true );
            end
        end
        i = i + 1;
    end

    # No recv ready, check for default
    if sel.has_default do
        i = 0;
        when i < vec_len(sel.cases) loop
            c = vec_get(sel.cases, i);
            if c.case_type == CASE_DEFAULT do
                out SelectResult ( case_id: c.case_id, value: None, ok: false );
            end
            i = i + 1;
        end
    end

    # Nothing ready and no default
    out SelectResult ( case_id: -1, value: None, ok: false );
end

# ═══════════════════════════════════════════════════════
# Select with spin — poll repeatedly up to max_spins
# ═══════════════════════════════════════════════════════

func select_wait:
    in(sel: Selector; max_spins: int)
    spin = 0;
    when spin < max_spins loop
        result = select_poll(sel);
        if result.ok || result.case_id >= 0 do
            out result;
        end
        # Backoff: busy wait briefly
        _pause = 0;
        when _pause < 100 loop
            _pause = _pause + 1;
        end
        spin = spin + 1;
    end
    out SelectResult ( case_id: -1, value: None, ok: false );
end

# ═══════════════════════════════════════════════════════
# Convenience: select over exactly 2 channels
# ═══════════════════════════════════════════════════════

func select2:
    in(ch1: Channel; ch2: Channel; max_spins: int)
    sel = select_new();
    select_add_recv(sel, ch1, 1);
    select_add_recv(sel, ch2, 2);
    out select_wait(sel, max_spins);
end

# ═══════════════════════════════════════════════════════
# Convenience: select over exactly 3 channels
# ═══════════════════════════════════════════════════════

func select3:
    in(ch1: Channel; ch2: Channel; ch3: Channel; max_spins: int)
    sel = select_new();
    select_add_recv(sel, ch1, 1);
    select_add_recv(sel, ch2, 2);
    select_add_recv(sel, ch3, 3);
    out select_wait(sel, max_spins);
end
