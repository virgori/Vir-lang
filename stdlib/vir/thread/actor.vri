##
 * vir/thread/actor.vri — Actor Model
 * =====================================
 * Inspired by: Erlang/OTP, Akka, actix
 *
 * Lightweight actors with mailboxes, message passing,
 * supervision trees, actor lifecycle.
 ##

include types;
include option;
import Option, Some, None from option;
include vec;
import Vec, vec_new, vec_push, vec_len, vec_get from vec;
include thread;
import Mutex, mutex_new, mutex_lock, mutex_unlock from thread;

# ═══════════════════════════════════════════════════════
# Actor states
# ═══════════════════════════════════════════════════════

const ACTOR_IDLE     = 0;
const ACTOR_RUNNING  = 1;
const ACTOR_STOPPED  = 2;
const ACTOR_FAILED   = 3;

# ═══════════════════════════════════════════════════════
# Messages
# ═══════════════════════════════════════════════════════

entity Message:
    msg_type: string,
        payload:  string,
        sender:   int;      # sender actor ID, -1 if external
end

# ═══════════════════════════════════════════════════════
# Mailbox
# ═══════════════════════════════════════════════════════

entity Mailbox:
    messages: Vec;    # Vec<Message>
    lock:     Mutex,
        capacity: int;
end.

func mailbox_new:
    in(capacity: int)
    out Mailbox ( messages: vec_new(), lock: mutex_new(), capacity: capacity );
end.

func mailbox_send:
    in(mb: Mailbox; msg: Message)
    mutex_lock(mb.lock);
    if vec_len(mb.messages) < mb.capacity do
        vec_push(mb.messages, msg);
    end
    mutex_unlock(mb.lock);
end.

func mailbox_recv:
    in(mb: Mailbox)
    mutex_lock(mb.lock);
    if vec_len(mb.messages) == 0 do
        mutex_unlock(mb.lock);
        out None;
    end
    msg = vec_get(mb.messages, 0);
    new_msgs = vec_new();
    i = 1;
    when i < vec_len(mb.messages) loop
        vec_push(new_msgs, vec_get(mb.messages, i));
        i = i + 1;
    end
    mb.messages = new_msgs;
    mutex_unlock(mb.lock);
    out Some(msg);
end.

func mailbox_len:
    in(mb: Mailbox)
    mutex_lock(mb.lock);
    n = vec_len(mb.messages);
    mutex_unlock(mb.lock);
    out n;
end

# ═══════════════════════════════════════════════════════
# Actor
# ═══════════════════════════════════════════════════════

entity Actor:
    id:        int,
        name:      string,
        state:     int,
        mailbox:   Mailbox,
        children:  Vec;       # Vec<int> child actor IDs
    parent_id: int;       # -1 if root
end.

func actor_new:
    in(id: int; name: string; mailbox_cap: int)
    out Actor (
        id: id, name: name, state: ACTOR_IDLE,
        mailbox: mailbox_new(mailbox_cap),
        children: vec_new(), parent_id: -1
    );
end

# ═══════════════════════════════════════════════════════
# Actor System
# ═══════════════════════════════════════════════════════

entity ActorSystem:
    actors:       Vec;    # Vec<Actor>
    next_id:      int,
        name:         string;
end.

func system_new:
    in(name: string)
    out ActorSystem ( actors: vec_new(), next_id: 0, name: name );
end.

func system_spawn:
    in(sys: ActorSystem; name: string; mailbox_cap: int)
    id = sys.next_id;
    sys.next_id = sys.next_id + 1;
    actor = actor_new(id, name, mailbox_cap);
    vec_push(sys.actors, actor);
    out id;
end.

func system_spawn_child:
    in(sys: ActorSystem; parent_id: int; name: string; mailbox_cap: int)
    id = system_spawn(sys, name, mailbox_cap);
    child_actor = vec_get(sys.actors, id);
    child_actor.parent_id = parent_id;
    parent = vec_get(sys.actors, parent_id);
    vec_push(parent.children, id);
    out id;
end.

func system_get_actor:
    in(sys: ActorSystem; id: int)
    if id >= 0 && id < vec_len(sys.actors) do
        out Some(vec_get(sys.actors, id));
    end
    out None;
end

# ═══════════════════════════════════════════════════════
# Message sending
# ═══════════════════════════════════════════════════════

func system_send:
    in(sys: ActorSystem; target_id: int; msg: Message)
    actor_opt = system_get_actor(sys, target_id);
    if is_some(actor_opt) do
        actor = unwrap(actor_opt);
        if actor.state != ACTOR_STOPPED do
            mailbox_send(actor.mailbox, msg);
        end
    end
end.

func msg_new:
    in(msg_type: string; payload: string; sender: int)
    out Message ( msg_type: msg_type, payload: payload, sender: sender );
end

# ═══════════════════════════════════════════════════════
# Actor lifecycle
# ═══════════════════════════════════════════════════════

func actor_start:
    in(actor: Actor)
    actor.state = ACTOR_RUNNING;
end.

func actor_stop:
    in(actor: Actor)
    actor.state = ACTOR_STOPPED;
end.

func actor_fail:
    in(actor: Actor)
    actor.state = ACTOR_FAILED;
end

# ═══════════════════════════════════════════════════════
# Supervision strategies
# ═══════════════════════════════════════════════════════

const STRATEGY_ONE_FOR_ONE  = 1;   # restart only failed child
const STRATEGY_ALL_FOR_ONE  = 2;   # restart all children
const STRATEGY_REST_FOR_ONE = 3;   # restart failed + later siblings

func system_restart_child:
    in(sys: ActorSystem; child_id: int)
    actor_opt = system_get_actor(sys, child_id);
    if is_some(actor_opt) do
        actor = unwrap(actor_opt);
        actor.state = ACTOR_IDLE;
        # Clear mailbox
        actor.mailbox.messages = vec_new();
    end
end.

func system_stop_children:
    in(sys: ActorSystem; parent_id: int)
    parent_opt = system_get_actor(sys, parent_id);
    if is_some(parent_opt) do
        parent = unwrap(parent_opt);
        i = 0;
        when i < vec_len(parent.children) loop
            cid = vec_get(parent.children, i);
            child_opt = system_get_actor(sys, cid);
            if is_some(child_opt) do
                actor_stop(unwrap(child_opt));
            end
            i = i + 1;
        end
    end
end

# ═══════════════════════════════════════════════════════
# System stats
# ═══════════════════════════════════════════════════════

func system_actor_count:
    in(sys: ActorSystem)
    out vec_len(sys.actors);
end.

func system_active_count:
    in(sys: ActorSystem)
    count = 0;
    i = 0;
    when i < vec_len(sys.actors) loop
        a = vec_get(sys.actors, i);
        if a.state == ACTOR_RUNNING || a.state == ACTOR_IDLE do
            count = count + 1;
        end
        i = i + 1;
    end
    out count;
end
