/*
 * vir/thread/thread.vri — Thread & Synchronization
 * ==================================================
 * Inspired by C23: threads.h, stdatomic.h
 * Inspired by Python: threading, _thread
 *
 * Phase C — production primitives
 */

import "vir/core/types" use all
import "vir/core/option" use Option, Some, None
import "vir/core/result" use Result, Ok, Err
import "vir/str/string" use String

# ═══════════════════════════════════════════════════════
# Thread
# ═══════════════════════════════════════════════════════

entity ThreadHandle
    id:   u64
    _raw: ptr     # native thread handle
end

entity JoinHandle<T>
    _handle: ThreadHandle
    _result: Option<T>
end

func ngoài native_thread_spawn(func_ptr: ptr, arg: ptr) -> ptr
func ngoài native_thread_join(handle: ptr) -> i32
func ngoài native_thread_detach(handle: ptr) -> i32
func ngoài native_thread_current_id() -> u64
func ngoài native_thread_sleep_ms(ms: u64)
func ngoài native_thread_yield()

func thread_spawn(func: func() -> void) -> Result<ThreadHandle, String>
    var raw = native_thread_spawn(func, ptr_null())
    if raw == ptr_null()
        out Err(str_new("failed to spawn thread"))
    end
    var id = native_thread_current_id()
    out Ok(ThreadHandle { id = id, _raw = raw })
end

func thread_join(handle: ThreadHandle) -> Result<void, String>
    var rc = native_thread_join(handle._raw)
    if rc != 0 out Err(str_new("thread join failed")) end
    out Ok(())
end

func thread_detach(handle: ThreadHandle)
    native_thread_detach(handle._raw)
end

func thread_current_id() -> u64
    out native_thread_current_id()
end

func thread_sleep(ms: u64)
    native_thread_sleep_ms(ms)
end

func thread_yield()
    native_thread_yield()
end

# ═══════════════════════════════════════════════════════
# Mutex
# ═══════════════════════════════════════════════════════

entity Mutex
    _raw: ptr
end

func ngoài native_mutex_create() -> ptr
func ngoài native_mutex_destroy(m: ptr)
func ngoài native_mutex_lock(m: ptr) -> i32
func ngoài native_mutex_trylock(m: ptr) -> i32
func ngoài native_mutex_unlock(m: ptr) -> i32

func mutex_new() -> Mutex
    out Mutex { _raw = native_mutex_create() }
end

func mutex_lock(m: &Mutex)
    native_mutex_lock(m._raw)
end

func mutex_trylock(m: &Mutex) -> bool
    out native_mutex_trylock(m._raw) == 0
end

func mutex_unlock(m: &Mutex)
    native_mutex_unlock(m._raw)
end

func mutex_destroy(m: &Mutex)
    native_mutex_destroy(m._raw)
end

# ═══════════════════════════════════════════════════════
# RwLock — Reader-Writer Lock
# ═══════════════════════════════════════════════════════

entity RwLock
    _raw: ptr
end

func ngoài native_rwlock_create() -> ptr
func ngoài native_rwlock_destroy(rw: ptr)
func ngoài native_rwlock_read_lock(rw: ptr) -> i32
func ngoài native_rwlock_write_lock(rw: ptr) -> i32
func ngoài native_rwlock_unlock(rw: ptr) -> i32

func rwlock_new() -> RwLock
    out RwLock { _raw = native_rwlock_create() }
end

func rwlock_read(rw: &RwLock)
    native_rwlock_read_lock(rw._raw)
end

func rwlock_write(rw: &RwLock)
    native_rwlock_write_lock(rw._raw)
end

func rwlock_unlock(rw: &RwLock)
    native_rwlock_unlock(rw._raw)
end

func rwlock_destroy(rw: &RwLock)
    native_rwlock_destroy(rw._raw)
end

# ═══════════════════════════════════════════════════════
# CondVar — Condition Variable
# ═══════════════════════════════════════════════════════

entity CondVar
    _raw: ptr
end

func ngoài native_condvar_create() -> ptr
func ngoài native_condvar_destroy(cv: ptr)
func ngoài native_condvar_wait(cv: ptr, mutex: ptr) -> i32
func ngoài native_condvar_wait_timeout(cv: ptr, mutex: ptr, ms: u64) -> i32
func ngoài native_condvar_signal(cv: ptr) -> i32
func ngoài native_condvar_broadcast(cv: ptr) -> i32

func condvar_new() -> CondVar
    out CondVar { _raw = native_condvar_create() }
end

func condvar_wait(cv: &CondVar, m: &Mutex)
    native_condvar_wait(cv._raw, m._raw)
end

func condvar_wait_timeout(cv: &CondVar, m: &Mutex, ms: u64) -> bool
    out native_condvar_wait_timeout(cv._raw, m._raw, ms) == 0
end

func condvar_signal(cv: &CondVar)
    native_condvar_signal(cv._raw)
end

func condvar_broadcast(cv: &CondVar)
    native_condvar_broadcast(cv._raw)
end

func condvar_destroy(cv: &CondVar)
    native_condvar_destroy(cv._raw)
end

# ═══════════════════════════════════════════════════════
# Atomic — Lock-free atomics
# ═══════════════════════════════════════════════════════

enum Ordering
    Relaxed   = 0
    Acquire   = 1
    Release   = 2
    AcqRel    = 3
    SeqCst    = 4
end

entity AtomicI64
    _val: ptr    # native aligned storage
end

entity AtomicU64
    _val: ptr
end

entity AtomicBool
    _val: ptr
end

func ngoài native_atomic_i64_create(init: i64) -> ptr
func ngoài native_atomic_i64_load(p: ptr, order: i32) -> i64
func ngoài native_atomic_i64_store(p: ptr, val: i64, order: i32)
func ngoài native_atomic_i64_fetch_add(p: ptr, val: i64, order: i32) -> i64
func ngoài native_atomic_i64_fetch_sub(p: ptr, val: i64, order: i32) -> i64
func ngoài native_atomic_i64_cas(p: ptr, expected: i64, desired: i64, order: i32) -> bool

func atomic_i64_new(val: i64) -> AtomicI64
    out AtomicI64 { _val = native_atomic_i64_create(val) }
end

func atomic_i64_load(a: &AtomicI64, order: Ordering) -> i64
    out native_atomic_i64_load(a._val, order)
end

func atomic_i64_store(a: &AtomicI64, val: i64, order: Ordering)
    native_atomic_i64_store(a._val, val, order)
end

func atomic_i64_fetch_add(a: &AtomicI64, val: i64, order: Ordering) -> i64
    out native_atomic_i64_fetch_add(a._val, val, order)
end

func atomic_i64_cas(a: &AtomicI64, expected: i64, desired: i64, order: Ordering) -> bool
    out native_atomic_i64_cas(a._val, expected, desired, order)
end

# ═══════════════════════════════════════════════════════
# Channel — MPSC message passing
# ═══════════════════════════════════════════════════════

entity Sender<T>
    _raw: ptr
end

entity Receiver<T>
    _raw: ptr
end

func ngoài native_channel_create(cap: usize) -> ptr   # returns [sender, receiver] pair
func ngoài native_channel_send(ch: ptr, data: ptr, size: usize) -> i32
func ngoài native_channel_recv(ch: ptr, buf: ptr, size: usize) -> i32
func ngoài native_channel_try_recv(ch: ptr, buf: ptr, size: usize) -> i32
func ngoài native_channel_close(ch: ptr)

func channel<T>() -> (Sender<T>, Receiver<T>)
    var raw = native_channel_create(0)   # unbounded
    out (Sender<T> { _raw = raw }, Receiver<T> { _raw = raw })
end

func channel_bounded<T>(cap: usize) -> (Sender<T>, Receiver<T>)
    var raw = native_channel_create(cap)
    out (Sender<T> { _raw = raw }, Receiver<T> { _raw = raw })
end

func send<T>(tx: &Sender<T>, val: T) -> Result<void, String>
    var rc = native_channel_send(tx._raw, &val, size_of<T>())
    if rc != 0 out Err(str_new("channel closed")) end
    out Ok(())
end

func recv<T>(rx: &Receiver<T>) -> Result<T, String>
    var val: T
    var rc = native_channel_recv(rx._raw, &val, size_of<T>())
    if rc != 0 out Err(str_new("channel closed")) end
    out Ok(val)
end

func try_recv<T>(rx: &Receiver<T>) -> Option<T>
    var val: T
    var rc = native_channel_try_recv(rx._raw, &val, size_of<T>())
    if rc != 0 out None end
    out Some(val)
end

# ═══════════════════════════════════════════════════════
# Once — One-time initialization
# ═══════════════════════════════════════════════════════

entity Once
    _done: AtomicBool
    _mutex: Mutex
end

func once_new() -> Once
    out Once {
        _done = atomic_bool_new(false),
        _mutex = mutex_new()
    }
end

func once_call(o: &Once, func: func() -> void)
    if atomic_bool_load(&o._done, Ordering.Acquire) out end
    mutex_lock(&o._mutex)
    if !atomic_bool_load(&o._done, Ordering.Relaxed)
        func()
        atomic_bool_store(&o._done, true, Ordering.Release)
    end
    mutex_unlock(&o._mutex)
end

# ═══════════════════════════════════════════════════════
# Barrier
# ═══════════════════════════════════════════════════════

entity Barrier
    _count:   usize
    _waiting: AtomicI64
    _mutex:   Mutex
    _cv:      CondVar
end

func barrier_new(count: usize) -> Barrier
    out Barrier {
        _count = count,
        _waiting = atomic_i64_new(0),
        _mutex = mutex_new(),
        _cv = condvar_new()
    }
end

func barrier_wait(b: &Barrier)
    mutex_lock(&b._mutex)
    var n = atomic_i64_fetch_add(&b._waiting, 1, Ordering.SeqCst) + 1
    if n >= b._count
        atomic_i64_store(&b._waiting, 0, Ordering.SeqCst)
        condvar_broadcast(&b._cv)
    else
        condvar_wait(&b._cv, &b._mutex)
    end
    mutex_unlock(&b._mutex)
end
