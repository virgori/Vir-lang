##
 * vir/thread/thread.vri — Thread & Synchronization
 * ==================================================
 * Inspired by C23: threads.h, stdatomic.h
 * Inspired by Python: threading, _thread
 *
 * Phase C — production primitives
 ##

include types;
include option;
import Option, Some, None from option;
include result;
import Result, Ok, Err from result;
include string;
import String from string;

# ═══════════════════════════════════════════════════════
# Thread
# ═══════════════════════════════════════════════════════

entity ThreadHandle:
    id:   int;
    _raw: ptr     # native thread handle;
end

entity JoinHandle<T>:
    _handle: ThreadHandle;
    _result: Option<T>;
    _result_ptr: ptr;
    _done_ptr: ptr;
end

extern func native_thread_spawn(func_ptr: ptr, arg: ptr) -> ptr
extern func native_thread_join(handle: ptr) -> int
extern func native_thread_detach(handle: ptr) -> int
extern func native_thread_current_id() -> int
extern func native_thread_sleep_ms(ms: int)
extern func native_thread_yield()

func thread_spawn:
    in(func:func()
    raw = native_thread_spawn(func, ptr_null());
    if raw == ptr_null():
        out Err(str_new("failed to spawn thread"));
    end
    id = native_thread_current_id();
    out Ok(ThreadHandle { id = id, _raw = raw });
end

func thread_join:
    in(handle:ThreadHandle)
    rc = native_thread_join(handle._raw);
    if rc != 0 out Err(str_new("thread join failed")) end:
    out Ok(());
end

## Spawn a thread that returns a value, retrievable via join_with_result
func thread_spawn_with_result<T>:
    in(func: func() -> T)
    # Allocate shared storage for result
    result_ptr = alloc(size_of<T>());
    done_ptr = alloc(size_of<bool>());
    native_store_bool(done_ptr, false);
    
    # Wrapper that writes result to shared memory
    wrapper = lambda():
        val = func();
        native_store<T>(result_ptr, val);
        native_store_bool(done_ptr, true);
    end;
    
    raw = native_thread_spawn(wrapper, ptr_null());
    if raw == ptr_null():
        free(result_ptr);
        free(done_ptr);
        out Err(str_new("failed to spawn thread"));
    end
    id = native_thread_current_id();
    handle = ThreadHandle { id = id, _raw = raw };
    out Ok(JoinHandle<T> { _handle = handle, _result = None, _result_ptr = result_ptr, _done_ptr = done_ptr });
end

func join_with_result<T>:
    in(jh: JoinHandle<T>)
    rc = native_thread_join(jh._handle._raw);
    if rc != 0 out Err(str_new("thread join failed")) end:
    val = native_load<T>(jh._result_ptr, 0);
    free(jh._result_ptr);
    free(jh._done_ptr);
    out Ok(val);
end

func thread_detach:
    in(handle:ThreadHandle)
    native_thread_detach(handle._raw);
end

func thread_current_id:
    out native_thread_current_id();
end

func thread_sleep:
    in(ms:int)
    native_thread_sleep_ms(ms);
end

func thread_yield:
    native_thread_yield();
end

# ═══════════════════════════════════════════════════════
# Mutex
# ═══════════════════════════════════════════════════════

entity Mutex:
    _raw: ptr;
end

extern func native_mutex_create() -> ptr
extern func native_mutex_destroy(m: ptr)
extern func native_mutex_lock(m: ptr) -> int
extern func native_mutex_trylock(m: ptr) -> int
extern func native_mutex_unlock(m: ptr) -> int

func mutex_new:
    out Mutex { _raw = native_mutex_create() };
end

func mutex_lock:
    in(m:Mutex)
    native_mutex_lock(m._raw);
end

func mutex_trylock:
    in(m:Mutex)
    out native_mutex_trylock(m._raw) == 0;
end

func mutex_unlock:
    in(m:Mutex)
    native_mutex_unlock(m._raw);
end

func mutex_destroy:
    in(m:Mutex)
    native_mutex_destroy(m._raw);
end

# ═══════════════════════════════════════════════════════
# RwLock — Reader-Writer Lock
# ═══════════════════════════════════════════════════════

entity RwLock:
    _raw: ptr;
end

extern func native_rwlock_create() -> ptr
extern func native_rwlock_destroy(rw: ptr)
extern func native_rwlock_read_lock(rw: ptr) -> int
extern func native_rwlock_write_lock(rw: ptr) -> int
extern func native_rwlock_unlock(rw: ptr) -> int

func rwlock_new:
    out RwLock { _raw = native_rwlock_create() };
end

func rwlock_read:
    in(rw:RwLock)
    native_rwlock_read_lock(rw._raw);
end

func rwlock_write:
    in(rw:RwLock)
    native_rwlock_write_lock(rw._raw);
end

func rwlock_unlock:
    in(rw:RwLock)
    native_rwlock_unlock(rw._raw);
end

func rwlock_destroy:
    in(rw:RwLock)
    native_rwlock_destroy(rw._raw);
end

# ═══════════════════════════════════════════════════════
# CondVar — Condition Variable
# ═══════════════════════════════════════════════════════

entity CondVar:
    _raw: ptr;
end

extern func native_condvar_create() -> ptr
extern func native_condvar_destroy(cv: ptr)
extern func native_condvar_wait(cv: ptr, mutex: ptr) -> int
extern func native_condvar_wait_timeout(cv: ptr, mutex: ptr, ms: int) -> int
extern func native_condvar_signal(cv: ptr) -> int
extern func native_condvar_broadcast(cv: ptr) -> int

func condvar_new:
    out CondVar { _raw = native_condvar_create() };
end

func condvar_wait:
    in(cv:CondVar; m:Mutex)
    native_condvar_wait(cv._raw, m._raw);
end

func condvar_wait_timeout:
    in(cv:CondVar; m:Mutex; ms:int)
    out native_condvar_wait_timeout(cv._raw, m._raw, ms) == 0;
end

func condvar_signal:
    in(cv:CondVar)
    native_condvar_signal(cv._raw);
end

func condvar_broadcast:
    in(cv:CondVar)
    native_condvar_broadcast(cv._raw);
end

func condvar_destroy:
    in(cv:CondVar)
    native_condvar_destroy(cv._raw);
end

# ═══════════════════════════════════════════════════════
# Atomic — Lock-free atomics
# ═══════════════════════════════════════════════════════

enum Ordering:
    Relaxed   = 0;
    Acquire   = 1;
    Release   = 2;
    AcqRel    = 3;
    SeqCst    = 4;
end

entity AtomicI64:
    _val: ptr    # native aligned storage;
end

entity AtomicU64:
    _val: ptr;
end

entity AtomicBool:
    _val: ptr;
end

extern func native_atomic_i64_create(init: int) -> ptr
extern func native_atomic_i64_load(p: ptr, order: int) -> int
extern func native_atomic_i64_store(p: ptr, val: int, order: int)
extern func native_atomic_i64_fetch_add(p: ptr, val: int, order: int) -> int
extern func native_atomic_i64_fetch_sub(p: ptr, val: int, order: int) -> int
extern func native_atomic_i64_cas(p: ptr, expected: int, desired: int, order: int) -> bool

func atomic_i64_new:
    in(val:int)
    out AtomicI64 { _val = native_atomic_i64_create(val) };
end

func atomic_i64_load:
    in(a:AtomicI64; order:Ordering)
    out native_atomic_i64_load(a._val, order);
end

func atomic_i64_store:
    in(a:AtomicI64; val:int; order:Ordering)
    native_atomic_i64_store(a._val, val, order);
end

func atomic_i64_fetch_add:
    in(a:AtomicI64; val:int; order:Ordering)
    out native_atomic_i64_fetch_add(a._val, val, order);
end

func atomic_i64_cas:
    in(a:AtomicI64; expected:int; desired:int; order:Ordering)
    out native_atomic_i64_cas(a._val, expected, desired, order);
end

# ═══════════════════════════════════════════════════════
# Channel — MPSC message passing
# ═══════════════════════════════════════════════════════

entity Sender<T>:
    _raw: ptr;
end

entity Receiver<T>:
    _raw: ptr;
end

extern func native_channel_create(cap: int) -> ptr   # returns [sender, receiver] pair
extern func native_channel_send(ch: ptr, data: ptr, size: int) -> int
extern func native_channel_recv(ch: ptr, buf: ptr, size: int) -> int
extern func native_channel_try_recv(ch: ptr, buf: ptr, size: int) -> int
extern func native_channel_close(ch: ptr)

func channel<T>:
    raw = native_channel_create(0)   # unbounded;
    out (Sender<T> { _raw = raw }, Receiver<T> { _raw = raw });
end

func channel_bounded<T>:
    in(cap:int)
    raw = native_channel_create(cap);
    out (Sender<T> { _raw = raw }, Receiver<T> { _raw = raw });
end

func send<T>:
    in(tx:Sender<T>; val:T)
    rc = native_channel_send(tx._raw, &val, size_of<T>());
    if rc != 0 out Err(str_new("channel closed")) end:
    out Ok(());
end

func recv<T>:
    in(rx:Receiver<T>)
    var val:T;
    rc = native_channel_recv(rx._raw, &val, size_of<T>());
    if rc != 0 out Err(str_new("channel closed")) end:
    out Ok(val);
end

func try_recv<T>:
    in(rx:Receiver<T>)
    var val:T;
    rc = native_channel_try_recv(rx._raw, &val, size_of<T>());
    if rc != 0 out None end:
    out Some(val);
end

# ═══════════════════════════════════════════════════════
# Once — One-time initialization
# ═══════════════════════════════════════════════════════

entity Once:
    _done: AtomicBool;
    _mutex: Mutex;
end

func once_new:
    out Once {;
        _done = atomic_bool_new(false),;
        _mutex = mutex_new();
    };
end

func once_call:
    in(o:Once; func:func()
    if atomic_bool_load(&o._done, Ordering.Acquire) out end:
    mutex_lock(&o._mutex);
    if !atomic_bool_load(&o._done, Ordering.Relaxed):
        func();
        atomic_bool_store(&o._done, true, Ordering.Release);
    end
    mutex_unlock(&o._mutex);
end

# ═══════════════════════════════════════════════════════
# Barrier
# ═══════════════════════════════════════════════════════

entity Barrier:
    _count:   int;
    _waiting: AtomicI64;
    _mutex:   Mutex;
    _cv:      CondVar;
end

func barrier_new:
    in(count:int)
    out Barrier {;
        _count = count,;
        _waiting = atomic_i64_new(0),;
        _mutex = mutex_new(),;
        _cv = condvar_new();
    };
end

func barrier_wait:
    in(b:Barrier)
    mutex_lock(&b._mutex);
    n = atomic_i64_fetch_add(&b._waiting, 1, Ordering.SeqCst) + 1;
    if n >= b._count:
        atomic_i64_store(&b._waiting, 0, Ordering.SeqCst);
        condvar_broadcast(&b._cv);
    else
        condvar_wait(&b._cv, &b._mutex);
    end
    mutex_unlock(&b._mutex);
end
