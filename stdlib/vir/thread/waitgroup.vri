##
 * vir/thread/waitgroup.vri — WaitGroup
 * =====================================
 * Counter-based thread synchronization.
 * Wait for a collection of tasks to finish.
 ##

include types;
include thread;
import Mutex, mutex_new, mutex_lock, mutex_unlock from thread;
import CondVar, condvar_new, condvar_wait, condvar_notify_all from thread;

# ═══════════════════════════════════════════════════════
# WaitGroup entity
# ═══════════════════════════════════════════════════════

entity WaitGroup:
    counter:  int,
        lock:     Mutex,
        cond:     CondVar;
end

# ═══════════════════════════════════════════════════════
# Constructor
# ═══════════════════════════════════════════════════════

func wg_new:
    out WaitGroup (
        counter: 0,
        lock: mutex_new(),
        cond: condvar_new()
    );
end

# ═══════════════════════════════════════════════════════
# Add: increment the counter by delta
# ═══════════════════════════════════════════════════════

func wg_add:
    in(wg: WaitGroup; delta: int)
    mutex_lock(wg.lock);
    wg.counter = wg.counter + delta;
    mutex_unlock(wg.lock);
end

# ═══════════════════════════════════════════════════════
# Done: decrement counter by 1, signal when zero
# ═══════════════════════════════════════════════════════

func wg_done:
    in(wg: WaitGroup)
    mutex_lock(wg.lock);
    wg.counter = wg.counter - 1;
    if wg.counter <= 0 do
        wg.counter = 0;
        condvar_notify_all(wg.cond);
    end
    mutex_unlock(wg.lock);
end

# ═══════════════════════════════════════════════════════
# Wait: block until counter reaches zero
# ═══════════════════════════════════════════════════════

func wg_wait:
    in(wg: WaitGroup)
    mutex_lock(wg.lock);
    when wg.counter > 0 loop
        condvar_wait(wg.cond, wg.lock);
    end
    mutex_unlock(wg.lock);
end

# ═══════════════════════════════════════════════════════
# Reset: reset counter to zero
# ═══════════════════════════════════════════════════════

func wg_reset:
    in(wg: WaitGroup)
    mutex_lock(wg.lock);
    wg.counter = 0;
    condvar_notify_all(wg.cond);
    mutex_unlock(wg.lock);
end

# ═══════════════════════════════════════════════════════
# Count: current outstanding tasks
# ═══════════════════════════════════════════════════════

func wg_count:
    in(wg: WaitGroup)
    mutex_lock(wg.lock);
    c = wg.counter;
    mutex_unlock(wg.lock);
    out c;
end
