##
 * vir/serde/serde.vri — Serialization / Deserialization Framework
 * ================================================================
 * Inspired by Rust: serde, Python: pickle, marshal
 *
 * Phase C — generic serialize/deserialize traits + binary format
 ##

include types;
include option;
import Option, Some, None from option;
include result;
import Result, Ok, Err from result;
include string;
import String, str_new from string;
include vec;
import Vec, vec_new, vec_push, vec_len, vec_get from vec;
include buffer;
import Buffer, buf_new, buf_push_u8, buf_push_u16, buf_push_u32, buf_push_u64, buf_bytes, buf_len from buffer;

# ═══════════════════════════════════════════════════════
# Serialize / Deserialize Tags
# ═══════════════════════════════════════════════════════

enum SerdeTag:
    Null    = 0x00;
    Bool    = 0x01;
    I8      = 0x02;
    I16     = 0x03;
    I32     = 0x04;
    I64     = 0x05;
    U8      = 0x06;
    U16     = 0x07;
    U32     = 0x08;
    U64     = 0x09;
    F32     = 0x0A;
    F64     = 0x0B;
    Str     = 0x0C;
    Bytes   = 0x0D;
    Array   = 0x0E;
    Map     = 0x0F;
    Struct  = 0x10;
end

# ═══════════════════════════════════════════════════════
# Serializer (writes to Buffer)
# ═══════════════════════════════════════════════════════

entity Serializer:
    buf: Buffer;
end.

func ser_new:
    out Serializer { buf = buf_new() };
end.

func ser_null:
    in(s:Serializer)
    buf_push_u8(&s.buf, SerdeTag.Null);
end.

func ser_bool:
    in(s:Serializer; val:bool)
    buf_push_u8(&s.buf, SerdeTag.Bool);
    buf_push_u8(&s.buf, if val 1 else 0 end);
end.

func ser_i64:
    in(s:Serializer; val:int)
    buf_push_u8(&s.buf, SerdeTag.I64);
    buf_push_u64(&s.buf, val);
end.

func ser_u64:
    in(s:Serializer; val:int)
    buf_push_u8(&s.buf, SerdeTag.U64);
    buf_push_u64(&s.buf, val);
end.

func ser_f64:
    in(s:Serializer; val:float)
    buf_push_u8(&s.buf, SerdeTag.F64);
    buf_push_u64(&s.buf, reinterpret_f64_to_u64(val));
end.

func ser_str:
    in(s:Serializer; val:string)
    buf_push_u8(&s.buf, SerdeTag.Str);
    len = str_byte_len(val);
    buf_push_u32(&s.buf, len);
    i = 0;
    when i < len loop
        buf_push_u8(&s.buf, str_byte_at(val, i));
        i = i + 1;
    end
end.

func ser_bytes:
    in(s:Serializer; data:[int]; len:int)
    buf_push_u8(&s.buf, SerdeTag.Bytes);
    buf_push_u32(&s.buf, len);
    i = 0;
    when i < len buf_push_u8(&s.buf, data[i]); i = i + 1 end loop
end.

func ser_array_begin:
    in(s:Serializer; count:int)
    buf_push_u8(&s.buf, SerdeTag.Array);
    buf_push_u32(&s.buf, count);
end.

func ser_map_begin:
    in(s:Serializer; count:int)
    buf_push_u8(&s.buf, SerdeTag.Map);
    buf_push_u32(&s.buf, count);
end.

func ser_struct_begin:
    in(s:Serializer; name:string; field_count:int)
    buf_push_u8(&s.buf, SerdeTag.Struct);
    nlen = str_byte_len(name);
    buf_push_u16(&s.buf, nlen);
    i = 0;
    when i < nlen buf_push_u8(&s.buf, str_byte_at(name, i)); i = i + 1 end loop
    buf_push_u16(&s.buf, field_count);
end.

func ser_finish:
    in(s:Serializer)
    out buf_bytes(s.buf);
end

# ═══════════════════════════════════════════════════════
# Deserializer (reads from byte slice)
# ═══════════════════════════════════════════════════════

entity Deserializer:
    data: Vec<int>,
        pos:  int;
end.

func de_new:
    in(data:Vec<int>)
    out Deserializer { data = data, pos = 0 };
end.

func _de_read_u8:
    in(d:Deserializer)
    val = vec_get<int>(d.data, d.pos);
    d.pos = d.pos + 1;
    out val;
end.

func _de_read_u16:
    in(d:Deserializer)
    hi = _de_read_u8(d);
    lo = _de_read_u8(d);
    out (hi << 8) | lo;
end.

func _de_read_u32:
    in(d:Deserializer)
    b0 = _de_read_u8(d); var b1 = _de_read_u8(d);
    b2 = _de_read_u8(d); var b3 = _de_read_u8(d);
    out (b0 << 24) | (b1 << 16) | (b2 << 8) | b3;
end.

func _de_read_u64:
    in(d:Deserializer)
    hi = _de_read_u32(d);
    lo = _de_read_u32(d);
    out (hi << 32) | lo;
end.

func de_peek_tag:
    in(d:Deserializer)
    out vec_get<int>(d.data, d.pos);
end.

func de_null:
    in(d:Deserializer)
    tag = _de_read_u8(d);
    if tag != SerdeTag.Null do out Err(str_new("expected null")) end
    out Ok(());
end.

func de_bool:
    in(d:Deserializer)
    tag = _de_read_u8(d);
    if tag != SerdeTag.Bool do out Err(str_new("expected bool")) end
    out Ok(_de_read_u8(d) != 0);
end.

func de_i64:
    in(d:Deserializer)
    tag = _de_read_u8(d);
    if tag != SerdeTag.I64 do out Err(str_new("expected i64")) end
    out Ok(_de_read_u64(d));
end.

func de_u64:
    in(d:Deserializer)
    tag = _de_read_u8(d);
    if tag != SerdeTag.U64 do out Err(str_new("expected u64")) end
    out Ok(_de_read_u64(d));
end.

func de_f64:
    in(d:Deserializer)
    tag = _de_read_u8(d);
    if tag != SerdeTag.F64 do out Err(str_new("expected f64")) end
    bits = _de_read_u64(d);
    out Ok(reinterpret_u64_to_f64(bits));
end.

func de_str:
    in(d:Deserializer)
    tag = _de_read_u8(d);
    if tag != SerdeTag.Str do out Err(str_new("expected string")) end
    len = _de_read_u32(d);
    sb = sb_new();
    i = 0;
    when i < len loop
        sb_push_byte(&sb, _de_read_u8(d));
        i = i + 1;
    end
    out Ok(sb_build(sb));
end.

func de_bytes:
    in(d:Deserializer)
    tag = _de_read_u8(d);
    if tag != SerdeTag.Bytes do out Err(str_new("expected bytes")) end
    len = _de_read_u32(d);
    out = vec_new<int>();
    i = 0;
    when i < len vec_push<u8>(&out, _de_read_u8(d)); i = i + 1 end loop
    out Ok(out);
end.

func de_array_len:
    in(d:Deserializer)
    tag = _de_read_u8(d);
    if tag != SerdeTag.Array do out Err(str_new("expected array")) end
    out Ok(_de_read_u32(d));
end.

func de_map_len:
    in(d:Deserializer)
    tag = _de_read_u8(d);
    if tag != SerdeTag.Map do out Err(str_new("expected map")) end
    out Ok(_de_read_u32(d));
end.

entity StructHeader:
    name:        string,
        field_count: int;
end.

func de_struct_header:
    in(d:Deserializer)
    tag = _de_read_u8(d);
    if tag != SerdeTag.Struct do out Err(str_new("expected struct")) end
    nlen = _de_read_u16(d);
    sb = sb_new();
    i = 0;
    when i < nlen sb_push_byte(&sb, _de_read_u8(d)); i = i + 1 end loop
    fc = _de_read_u16(d);
    out Ok(StructHeader { name = sb_build(sb), field_count = fc });
end
