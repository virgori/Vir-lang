##
 * vir/serde/xml.vri — XML Parser & Emitter
 * ==========================================
 * Inspired by Rust: quick-xml, xml-rs crates
 * Inspired by Python: xml.etree.ElementTree
 * Inspired by Go: encoding/xml
 *
 * Phase C — Tier 2: SAX-style tokenizer + DOM tree builder.
 * Supports: elements, attributes, text, CDATA, comments.
 * Does not support: namespaces, DTD, processing instructions.
 ##

include types;
include option;
import Option, Some, None, is_some, is_none, unwrap from option;
include vec;
import Vec, vec_new, vec_push, vec_get, vec_set, vec_len from vec;
include builder;
import StringBuilder, sb_new, sb_append, sb_append_byte, sb_append_i64,
       sb_build, sb_free from builder;

# ═══════════════════════════════════════════════════════
# XML Node types
# ═══════════════════════════════════════════════════════

const XML_ELEMENT = 0;
const XML_TEXT    = 1;
const XML_COMMENT = 2;
const XML_CDATA   = 3;

entity XmlAttr:
    name:  string,
        value: string;
end.

entity XmlNode:
    kind:      int,
        tag:       string,
        text:      string,
        attrs:     Vec;        # Vec<XmlAttr>
    children:  Vec;        # Vec<XmlNode>
    parent:    Option;     # Option<XmlNode>
end

# ─── Constructors ───────────────────────────────────

func xml_element:
    in(tag: string)
    out XmlNode {
        kind: XML_ELEMENT, tag: tag, text: "",
        attrs: vec_new(), children: vec_new(), parent: None
    };
end.

func xml_text:
    in(text: string)
    out XmlNode {
        kind: XML_TEXT, tag: "", text: text,
        attrs: vec_new(), children: vec_new(), parent: None
    };
end.

func xml_comment:
    in(text: string)
    out XmlNode {
        kind: XML_COMMENT, tag: "", text: text,
        attrs: vec_new(), children: vec_new(), parent: None
    };
end.

func xml_cdata:
    in(text: string)
    out XmlNode {
        kind: XML_CDATA, tag: "", text: text,
        attrs: vec_new(), children: vec_new(), parent: None
    };
end

# ─── Attributes ─────────────────────────────────────

func xml_set_attr:
    in(node: XmlNode; name: string; value: string)
    # Check if attribute already exists
    i = 0;
    found = false;
    when i < vec_len(node.attrs) and not found loop
        attr = vec_get(node.attrs, i);
        if attr.name == name do
            attr.value = value;
            found = true;
        end
        i = i + 1;
    end
    if not found do
        vec_push(node.attrs, XmlAttr { name: name, value: value });
    end
end.

func xml_get_attr:
    in(node: XmlNode; name: string)
    i = 0;
    when i < vec_len(node.attrs) loop
        attr = vec_get(node.attrs, i);
        if attr.name == name do
            out Some(attr.value);
        end
        i = i + 1;
    end
    out None;
end

# ─── Children ───────────────────────────────────────

func xml_add_child:
    in(parent: XmlNode; child: XmlNode)
    child.parent = Some(parent);
    vec_push(parent.children, child);
end.

func xml_child_count:
    in(node: XmlNode)
    out vec_len(node.children);
end.

func xml_child_at:
    in(node: XmlNode; idx: int)
    out vec_get(node.children, idx);
end

# ─── Find by tag name ──────────────────────────────

func xml_find_first:
    in(node: XmlNode; tag: string)
    i = 0;
    when i < vec_len(node.children) loop
        child = vec_get(node.children, i);
        if child.kind == XML_ELEMENT and child.tag == tag do
            out Some(child);
        end
        i = i + 1;
    end
    out None;
end.

func xml_find_all:
    in(node: XmlNode; tag: string)
    result = vec_new();
    i = 0;
    when i < vec_len(node.children) loop
        child = vec_get(node.children, i);
        if child.kind == XML_ELEMENT and child.tag == tag do
            vec_push(result, child);
        end
        i = i + 1;
    end
    out result;
end

# ─── Text content ──────────────────────────────────

func xml_text_content:
    in(node: XmlNode)
    sb = sb_new();
    _collect_text(sb, node);
    result = sb_build(sb);
    sb_free(sb);
    out result;
end.

func _collect_text:
    in(sb: StringBuilder; node: XmlNode)
    if node.kind == XML_TEXT or node.kind == XML_CDATA do
        sb_append(sb, node.text);
    end
    i = 0;
    when i < vec_len(node.children) loop
        _collect_text(sb, vec_get(node.children, i));
        i = i + 1;
    end
end

# ═══════════════════════════════════════════════════════
# XML Parser
# ═══════════════════════════════════════════════════════

entity XmlParser:
    src:  string,
        pos:  int,
        len:  int;
end.

func xml_parse:
    in(src: string)
    p = XmlParser { src: src, pos: 0, len: str_len(src) };
    _xml_skip_whitespace(p);

    # Skip XML declaration if present: <?xml ... ?>
    if _xml_starts_with(p, "<?") do
        _xml_skip_until(p, "?>");
    end
    _xml_skip_whitespace(p);

    out _xml_parse_node(p);
end.

func _xml_peek:
    in(p: XmlParser)
    if p.pos >= p.len do out 0 end
    out str_byte_at(p.src, p.pos);
end.

func _xml_advance:
    in(p: XmlParser)
    p.pos = p.pos + 1;
end.

func _xml_skip_whitespace:
    in(p: XmlParser)
    when p.pos < p.len loop
        ch = str_byte_at(p.src, p.pos);
        if ch == 32 or ch == 9 or ch == 10 or ch == 13 do
            p.pos = p.pos + 1;
        else
            out;
        end
    end
end.

func _xml_starts_with:
    in(p: XmlParser; s: string)
    if p.pos + str_len(s) > p.len do out false end
    i = 0;
    when i < str_len(s) loop
        if str_byte_at(p.src, p.pos + i) != str_byte_at(s, i) do
            out false;
        end
        i = i + 1;
    end
    out true;
end.

func _xml_skip_until:
    in(p: XmlParser; marker: string)
    mlen = str_len(marker);
    when p.pos + mlen <= p.len loop
        if _xml_starts_with(p, marker) do
            p.pos = p.pos + mlen;
            out;
        end
        p.pos = p.pos + 1;
    end
end.

func _xml_read_name:
    in(p: XmlParser)
    sb = sb_new();
    when p.pos < p.len loop
        ch = str_byte_at(p.src, p.pos);
        is_name_char = (ch >= 97 and ch <= 122)   # a-z
                    or (ch >= 65 and ch <= 90)     # A-Z
                    or (ch >= 48 and ch <= 57)     # 0-9
                    or ch == 45 or ch == 95        # - _
                    or ch == 46 or ch == 58;       # . 
        if not is_name_char do
            result = sb_build(sb);
            sb_free(sb);
            out result;
        end
        sb_append_byte(sb, ch);
        p.pos = p.pos + 1;
    end
    result = sb_build(sb);
    sb_free(sb);
    out result;
end.

func _xml_read_attr_value:
    in(p: XmlParser)
    _xml_skip_whitespace(p);
    if _xml_peek(p) != 61 do out "" end # '='
    _xml_advance(p);
    _xml_skip_whitespace(p);
    quote = _xml_peek(p);
    if quote != 34 and quote != 39 do out "" end # " or '
    _xml_advance(p);

    sb = sb_new();
    when p.pos < p.len and str_byte_at(p.src, p.pos) != quote loop
        sb_append_byte(sb, str_byte_at(p.src, p.pos));
        p.pos = p.pos + 1;
    end
    _xml_advance(p);   # skip closing quote
    result = sb_build(sb);
    sb_free(sb);
    out _xml_unescape(result);
end

# ─── Entity unescaping ─────────────────────────────

func _xml_unescape:
    in(s: string)
    sb = sb_new();
    i = 0;
    when i < str_len(s) loop
        ch = str_byte_at(s, i);
        if ch == 38 do # '&'
            if _str_match_at(s, i, "&amp;") do
                sb_append_byte(sb, 38);
                i = i + 5;
            eif _str_match_at(s, i, "&lt;") do
                sb_append_byte(sb, 60);
                i = i + 4;
            eif _str_match_at(s, i, "&gt;") do
                sb_append_byte(sb, 62);
                i = i + 4;
            eif _str_match_at(s, i, "&quot;") do
                sb_append_byte(sb, 34);
                i = i + 6;
            eif _str_match_at(s, i, "&apos;") do
                sb_append_byte(sb, 39);
                i = i + 6;
            else
                sb_append_byte(sb, ch);
                i = i + 1;
            end
        else
            sb_append_byte(sb, ch);
            i = i + 1;
        end
    end
    result = sb_build(sb);
    sb_free(sb);
    out result;
end.

func _str_match_at:
    in(s: string; pos: int; pattern: string)
    if pos + str_len(pattern) > str_len(s) do out false end
    i = 0;
    when i < str_len(pattern) loop
        if str_byte_at(s, pos + i) != str_byte_at(pattern, i) do
            out false;
        end
        i = i + 1;
    end
    out true;
end

# ─── Parse a node ──────────────────────────────────

func _xml_parse_node:
    in(p: XmlParser)
    _xml_skip_whitespace(p);
    if p.pos >= p.len do out xml_text("") end

    # Comment: <!-- ... -->
    if _xml_starts_with(p, "<!--") do
        p.pos = p.pos + 4;
        sb = sb_new();
        when p.pos < p.len and not _xml_starts_with(p, "-->") loop
            sb_append_byte(sb, str_byte_at(p.src, p.pos));
            p.pos = p.pos + 1;
        end
        p.pos = p.pos + 3;   # skip -->
        text = sb_build(sb);
        sb_free(sb);
        out xml_comment(text);
    end

    # CDATA: <![CDATA[ ... ]]>
    if _xml_starts_with(p, "<![CDATA[") do
        p.pos = p.pos + 9;
        sb = sb_new();
        when p.pos < p.len and not _xml_starts_with(p, "]]>") loop
            sb_append_byte(sb, str_byte_at(p.src, p.pos));
            p.pos = p.pos + 1;
        end
        p.pos = p.pos + 3;   # skip ]]>
        text = sb_build(sb);
        sb_free(sb);
        out xml_cdata(text);
    end

    # Element: <tag ...> ... </tag>
    if _xml_peek(p) == 60 do # '<'
        _xml_advance(p);
        tag = _xml_read_name(p);
        node = xml_element(tag);

        # Parse attributes
        _xml_skip_whitespace(p);
        when p.pos < p.len and _xml_peek(p) != 62 and _xml_peek(p) != 47 loop
            attr_name = _xml_read_name(p);
            if str_len(attr_name) > 0 do
                attr_val = _xml_read_attr_value(p);
                xml_set_attr(node, attr_name, attr_val);
            end
            _xml_skip_whitespace(p);
        end

        # Self-closing: />
        if _xml_peek(p) == 47 do # '/'
            _xml_advance(p);
            _xml_advance(p);      # skip >
            out node;
        end

        _xml_advance(p);          # skip >

        # Parse children until </tag>
        done = false;
        when not done loop
            _xml_skip_whitespace(p);
            if p.pos >= p.len do
                done = true;
            eif _xml_starts_with(p, "</") do
                # Closing tag
                p.pos = p.pos + 2;
                _xml_read_name(p);     # consume closing tag name
                _xml_skip_whitespace(p);
                if _xml_peek(p) == 62 do
                    _xml_advance(p);   # skip >
                end
                done = true;
            eif _xml_peek(p) == 60 do
                # Child element or comment or CDATA
                child = _xml_parse_node(p);
                xml_add_child(node, child);
            else
                # Text content
                sb = sb_new();
                when p.pos < p.len and str_byte_at(p.src, p.pos) != 60 loop
                    sb_append_byte(sb, str_byte_at(p.src, p.pos));
                    p.pos = p.pos + 1;
                end
                text = sb_build(sb);
                sb_free(sb);
                trimmed_text = _xml_unescape(text);
                if str_len(trimmed_text) > 0 do
                    xml_add_child(node, xml_text(trimmed_text));
                end
            end
        end
        out node;
    end

    # Plain text (shouldn't happen at top level, but handle gracefully)
    sb = sb_new();
    when p.pos < p.len and str_byte_at(p.src, p.pos) != 60 loop
        sb_append_byte(sb, str_byte_at(p.src, p.pos));
        p.pos = p.pos + 1;
    end
    text = sb_build(sb);
    sb_free(sb);
    out xml_text(text);
end

# ═══════════════════════════════════════════════════════
# XML Emitter
# ═══════════════════════════════════════════════════════

func xml_emit:
    in(node: XmlNode)
    sb = sb_new();
    _xml_emit_node(sb, node, 0);
    result = sb_build(sb);
    sb_free(sb);
    out result;
end.

func xml_emit_pretty:
    in(node: XmlNode)
    sb = sb_new();
    sb_append(sb, "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n");
    _xml_emit_node(sb, node, 0);
    result = sb_build(sb);
    sb_free(sb);
    out result;
end.

func _xml_emit_indent:
    in(sb: StringBuilder; level: int)
    i = 0;
    when i < level * 2 loop
        sb_append_byte(sb, 32);
        i = i + 1;
    end
end.

func _xml_escape:
    in(sb: StringBuilder; s: string)
    i = 0;
    when i < str_len(s) loop
        ch = str_byte_at(s, i);
        if ch == 60 do sb_append(sb, "&lt;");
        eif ch == 62 do sb_append(sb, "&gt;");
        eif ch == 38 do sb_append(sb, "&amp;");
        eif ch == 34 do sb_append(sb, "&quot;");
        eif ch == 39 do sb_append(sb, "&apos;");
        else sb_append_byte(sb, ch);
        end
        i = i + 1;
    end
end.

func _xml_emit_node:
    in(sb: StringBuilder; node: XmlNode; level: int)
    if node.kind == XML_TEXT do
        _xml_escape(sb, node.text);
    eif node.kind == XML_COMMENT do
        _xml_emit_indent(sb, level);
        sb_append(sb, "<!--");
        sb_append(sb, node.text);
        sb_append(sb, "-->\n");
    eif node.kind == XML_CDATA do
        sb_append(sb, "<![CDATA[");
        sb_append(sb, node.text);
        sb_append(sb, "]]>");
    eif node.kind == XML_ELEMENT do
        _xml_emit_indent(sb, level);
        sb_append_byte(sb, 60);    # '<'
        sb_append(sb, node.tag);

        # Attributes
        i = 0;
        when i < vec_len(node.attrs) loop
            attr = vec_get(node.attrs, i);
            sb_append_byte(sb, 32);
            sb_append(sb, attr.name);
            sb_append(sb, "=\"");
            _xml_escape(sb, attr.value);
            sb_append_byte(sb, 34);
            i = i + 1;
        end

        if vec_len(node.children) == 0 do
            sb_append(sb, "/>\n");
        else
            sb_append(sb, ">");
            # Check if only text children
            all_text = true;
            j = 0;
            when j < vec_len(node.children) loop
                child = vec_get(node.children, j);
                if child.kind != XML_TEXT do
                    all_text = false;
                end
                j = j + 1;
            end

            if all_text do
                k = 0;
                when k < vec_len(node.children) loop
                    _xml_emit_node(sb, vec_get(node.children, k), 0);
                    k = k + 1;
                end
            else
                sb_append_byte(sb, 10);
                k = 0;
                when k < vec_len(node.children) loop
                    _xml_emit_node(sb, vec_get(node.children, k), level + 1);
                    k = k + 1;
                end
                _xml_emit_indent(sb, level);
            end

            sb_append(sb, "</");
            sb_append(sb, node.tag);
            sb_append(sb, ">\n");
        end
    end
end
