##
 * vir/serde/msgpack.vri — MessagePack Binary Serialization
 * =========================================================
 * Inspired by Rust: rmp, rmp-serde crates
 * Inspired by Python: msgpack-python
 * Inspired by Go: vmihailenco/msgpack
 *
 * Phase C — Tier 2: MessagePack encoder/decoder.
 * Supports: nil, bool, int, string, binary, array, map.
 * Spec: https://github.com/msgpack/msgpack/blob/master/spec.md
 ##

include types;
include option;
import Option, Some, None, is_some, is_none, unwrap from option;
include vec;
import Vec, vec_new, vec_push, vec_get, vec_set, vec_len from vec;
include map;
import Map, map_new, map_insert, map_get, map_keys, native_hash_str from map;
include builder;
import StringBuilder, sb_new, sb_append, sb_append_byte, sb_append_i64, sb_build, sb_free from builder;

# ═══════════════════════════════════════════════════════
# MsgPack Value enum (tagged)
# ═══════════════════════════════════════════════════════

const MP_NIL    = 0;
const MP_BOOL   = 1;
const MP_INT    = 2;
const MP_STR    = 3;
const MP_BIN    = 4;
const MP_ARRAY  = 5;
const MP_MAP    = 6;

entity MsgValue:
    kind:      int,
        bool_val:  bool,
        int_val:   int,
        str_val:   string,
        bin_val:   Vec;       # Vec<int> (bytes)
    arr_val:   Vec;       # Vec<MsgValue>
    map_keys:  Vec;       # Vec<MsgValue>
    map_vals:  Vec;       # Vec<MsgValue>
end

# ─── Constructors ───────────────────────────────────

func msg_nil:
    in()
    out MsgValue (
        kind: MP_NIL, bool_val: false, int_val: 0,
        str_val: "", bin_val: vec_new(),
        arr_val: vec_new(), map_keys: vec_new(), map_vals: vec_new()
    );
end
func msg_bool:
    in(v: bool)
    out MsgValue (
        kind: MP_BOOL, bool_val: v, int_val: 0,
        str_val: "", bin_val: vec_new(),
        arr_val: vec_new(), map_keys: vec_new(), map_vals: vec_new()
    );
end
func msg_int:
    in(v: int)
    out MsgValue (
        kind: MP_INT, bool_val: false, int_val: v,
        str_val: "", bin_val: vec_new(),
        arr_val: vec_new(), map_keys: vec_new(), map_vals: vec_new()
    );
end
func msg_str:
    in(v: string)
    out MsgValue (
        kind: MP_STR, bool_val: false, int_val: 0,
        str_val: v, bin_val: vec_new(),
        arr_val: vec_new(), map_keys: vec_new(), map_vals: vec_new()
    );
end
func msg_bin:
    in(v: Vec)
    out MsgValue (
        kind: MP_BIN, bool_val: false, int_val: 0,
        str_val: "", bin_val: v,
        arr_val: vec_new(), map_keys: vec_new(), map_vals: vec_new()
    );
end
func msg_array:
    in()
    out MsgValue (
        kind: MP_ARRAY, bool_val: false, int_val: 0,
        str_val: "", bin_val: vec_new(),
        arr_val: vec_new(), map_keys: vec_new(), map_vals: vec_new()
    );
end
func msg_map:
    in()
    out MsgValue (
        kind: MP_MAP, bool_val: false, int_val: 0,
        str_val: "", bin_val: vec_new(),
        arr_val: vec_new(), map_keys: vec_new(), map_vals: vec_new()
    );
end
# ─── Array/Map builders ────────────────────────────

func msg_array_push:
    in(v: MsgValue; item: MsgValue)
    vec_push(v.arr_val, item);
end
func msg_map_put:
    in(v: MsgValue; key: MsgValue; val: MsgValue)
    vec_push(v.map_keys, key);
    vec_push(v.map_vals, val);
end
# ─── Accessors ──────────────────────────────────────

func msg_is_nil:   in(v: MsgValue) out v.kind == MP_NIL;   end
func msg_is_bool:  in(v: MsgValue) out v.kind == MP_BOOL;  end
func msg_is_int:   in(v: MsgValue) out v.kind == MP_INT;   end
func msg_is_str:   in(v: MsgValue) out v.kind == MP_STR;   end
func msg_is_bin:   in(v: MsgValue) out v.kind == MP_BIN;   end
func msg_is_array: in(v: MsgValue) out v.kind == MP_ARRAY; end
func msg_is_map:   in(v: MsgValue) out v.kind == MP_MAP;   end

func msg_get_bool:  in(v: MsgValue) out v.bool_val; end
func msg_get_int:   in(v: MsgValue) out v.int_val;  end
func msg_get_str:   in(v: MsgValue) out v.str_val;  end
func msg_get_bin:   in(v: MsgValue) out v.bin_val;  end

func msg_array_len: in(v: MsgValue) out vec_len(v.arr_val); end
func msg_array_get: in(v: MsgValue; i: int) out vec_get(v.arr_val, i); end

func msg_map_len:      in(v: MsgValue) out vec_len(v.map_keys); end
func msg_map_key_at:   in(v: MsgValue; i: int) out vec_get(v.map_keys, i); end
func msg_map_val_at:   in(v: MsgValue; i: int) out vec_get(v.map_vals, i); end

# ═══════════════════════════════════════════════════════
# Encoder — MsgValue to Vec<int> (byte buffer)
# ═══════════════════════════════════════════════════════

func _write_byte:
    in(buf: Vec; b: int)
    vec_push(buf, b);
end
func _write_u16_be:
    in(buf: Vec; v: int)
    vec_push(buf, (v / 256) - ((v / 256) / 256) * 256);
    vec_push(buf, v - (v / 256) * 256);
end
func _write_u32_be:
    in(buf: Vec; v: int)
    vec_push(buf, (v / 16777216) - ((v / 16777216) / 256) * 256);
    vec_push(buf, (v / 65536) - ((v / 65536) / 256) * 256);
    vec_push(buf, (v / 256) - ((v / 256) / 256) * 256);
    vec_push(buf, v - (v / 256) * 256);
end
func msgpack_encode:
    in(v: MsgValue)
    buf = vec_new();
    _encode_value(buf, v);
    out buf;
end
func _encode_value:
    in(buf: Vec; v: MsgValue)
    if v.kind == MP_NIL do
        _write_byte(buf, 192);   # 0xc0

    eif v.kind == MP_BOOL do
        if v.bool_val do
            _write_byte(buf, 195);  # 0xc3
        else
            _write_byte(buf, 194);  # 0xc2
        end

    eif v.kind == MP_INT do
        _encode_int(buf, v.int_val);

    eif v.kind == MP_STR do
        _encode_str(buf, v.str_val);

    eif v.kind == MP_BIN do
        _encode_bin(buf, v.bin_val);

    eif v.kind == MP_ARRAY do
        _encode_array(buf, v);

    eif v.kind == MP_MAP do
        _encode_map(buf, v);
    end
end
func _encode_int:
    in(buf: Vec; val: int)
    if val >= 0 and val <= 127 do
        # positive fixint
        _write_byte(buf, val);
    eif val < 0 and val >= -32 do
        # negative fixint (0xe0 + val)
        _write_byte(buf, 256 + val);
    eif val >= 0 and val <= 255 do
        # uint8
        _write_byte(buf, 204);  # 0xcc
        _write_byte(buf, val);
    eif val >= 0 and val <= 65535 do
        # uint16
        _write_byte(buf, 205);  # 0xcd
        _write_u16_be(buf, val);
    eif val >= 0 and val <= 4294967295 do
        # uint32
        _write_byte(buf, 206);  # 0xce
        _write_u32_be(buf, val);
    eif val < 0 and val >= -128 do
        # int8
        _write_byte(buf, 208);  # 0xd0
        _write_byte(buf, 256 + val);
    eif val < 0 and val >= -32768 do
        # int16
        _write_byte(buf, 209);  # 0xd1
        _write_u16_be(buf, 65536 + val);
    else
        # int32
        _write_byte(buf, 210);  # 0xd2
        _write_u32_be(buf, 4294967296 + val);
    end
end
func _encode_str:
    in(buf: Vec; s: string)
    n = str_len(s);
    if n <= 31 do
        # fixstr
        _write_byte(buf, 160 + n);   # 0xa0 + len
    eif n <= 255 do
        _write_byte(buf, 217);       # 0xd9
        _write_byte(buf, n);
    eif n <= 65535 do
        _write_byte(buf, 218);       # 0xda
        _write_u16_be(buf, n);
    else
        _write_byte(buf, 219);       # 0xdb
        _write_u32_be(buf, n);
    end
    i = 0;
    when i < n loop
        _write_byte(buf, str_byte_at(s, i));
        i = i + 1;
    end
end
func _encode_bin:
    in(buf: Vec; data: Vec)
    n = vec_len(data);
    if n <= 255 do
        _write_byte(buf, 196);       # 0xc4
        _write_byte(buf, n);
    eif n <= 65535 do
        _write_byte(buf, 197);       # 0xc5
        _write_u16_be(buf, n);
    else
        _write_byte(buf, 198);       # 0xc6
        _write_u32_be(buf, n);
    end
    i = 0;
    when i < n loop
        _write_byte(buf, vec_get(data, i));
        i = i + 1;
    end
end
func _encode_array:
    in(buf: Vec; v: MsgValue)
    n = vec_len(v.arr_val);
    if n <= 15 do
        _write_byte(buf, 144 + n);   # 0x90 + len
    eif n <= 65535 do
        _write_byte(buf, 220);       # 0xdc
        _write_u16_be(buf, n);
    else
        _write_byte(buf, 221);       # 0xdd
        _write_u32_be(buf, n);
    end
    i = 0;
    when i < n loop
        _encode_value(buf, vec_get(v.arr_val, i));
        i = i + 1;
    end
end
func _encode_map:
    in(buf: Vec; v: MsgValue)
    n = vec_len(v.map_keys);
    if n <= 15 do
        _write_byte(buf, 128 + n);   # 0x80 + len
    eif n <= 65535 do
        _write_byte(buf, 222);       # 0xde
        _write_u16_be(buf, n);
    else
        _write_byte(buf, 223);       # 0xdf
        _write_u32_be(buf, n);
    end
    i = 0;
    when i < n loop
        _encode_value(buf, vec_get(v.map_keys, i));
        _encode_value(buf, vec_get(v.map_vals, i));
        i = i + 1;
    end
end
# ═══════════════════════════════════════════════════════
# Decoder — Vec<int> (byte buffer) to MsgValue
# ═══════════════════════════════════════════════════════

entity MsgReader:
    data: Vec,
        pos:  int;
end
func _read_byte:
    in(r: MsgReader)
    b = vec_get(r.data, r.pos);
    r.pos = r.pos + 1;
    out b;
end
func _read_u16_be:
    in(r: MsgReader)
    hi = _read_byte(r);
    lo = _read_byte(r);
    out hi * 256 + lo;
end
func _read_u32_be:
    in(r: MsgReader)
    b3 = _read_byte(r);
    b2 = _read_byte(r);
    b1 = _read_byte(r);
    b0 = _read_byte(r);
    out b3 * 16777216 + b2 * 65536 + b1 * 256 + b0;
end
func _read_str:
    in(r: MsgReader; n: int)
    sb = sb_new();
    i = 0;
    when i < n loop
        sb_append_byte(sb, _read_byte(r));
        i = i + 1;
    end
    result = sb_build(sb);
    sb_free(sb);
    out result;
end
func _read_bin:
    in(r: MsgReader; n: int)
    buf = vec_new();
    i = 0;
    when i < n loop
        vec_push(buf, _read_byte(r));
        i = i + 1;
    end
    out buf;
end
func msgpack_decode:
    in(data: Vec)
    r = MsgReader ( data: data, pos: 0 );
    out _decode_value(r);
end
func _decode_value:
    in(r: MsgReader)
    b = _read_byte(r);

    # positive fixint (0x00-0x7f)
    if b <= 127 do
        out msg_int(b);
    end

    # fixmap (0x80-0x8f)
    if b >= 128 and b <= 143 do
        n = b - 128;
        out _decode_map_n(r, n);
    end

    # fixarray (0x90-0x9f)
    if b >= 144 and b <= 159 do
        n = b - 144;
        out _decode_array_n(r, n);
    end

    # fixstr (0xa0-0xbf)
    if b >= 160 and b <= 191 do
        n = b - 160;
        out msg_str(_read_str(r, n));
    end

    # nil (0xc0)
    if b == 192 do out msg_nil() end

    # false (0xc2)
    if b == 194 do out msg_bool(false) end

    # true (0xc3)
    if b == 195 do out msg_bool(true) end

    # bin8 (0xc4)
    if b == 196 do
        n = _read_byte(r);
        out msg_bin(_read_bin(r, n));
    end

    # bin16 (0xc5)
    if b == 197 do
        n = _read_u16_be(r);
        out msg_bin(_read_bin(r, n));
    end

    # bin32 (0xc6)
    if b == 198 do
        n = _read_u32_be(r);
        out msg_bin(_read_bin(r, n));
    end

    # uint8 (0xcc)
    if b == 204 do
        out msg_int(_read_byte(r));
    end

    # uint16 (0xcd)
    if b == 205 do
        out msg_int(_read_u16_be(r));
    end

    # uint32 (0xce)
    if b == 206 do
        out msg_int(_read_u32_be(r));
    end

    # int8 (0xd0)
    if b == 208 do
        v = _read_byte(r);
        if v >= 128 do
            v = v - 256;
        end
        out msg_int(v);
    end

    # int16 (0xd1)
    if b == 209 do
        v = _read_u16_be(r);
        if v >= 32768 do
            v = v - 65536;
        end
        out msg_int(v);
    end

    # int32 (0xd2)
    if b == 210 do
        v = _read_u32_be(r);
        if v >= 2147483648 do
            v = v - 4294967296;
        end
        out msg_int(v);
    end

    # str8 (0xd9)
    if b == 217 do
        n = _read_byte(r);
        out msg_str(_read_str(r, n));
    end

    # str16 (0xda)
    if b == 218 do
        n = _read_u16_be(r);
        out msg_str(_read_str(r, n));
    end

    # str32 (0xdb)
    if b == 219 do
        n = _read_u32_be(r);
        out msg_str(_read_str(r, n));
    end

    # array16 (0xdc)
    if b == 220 do
        n = _read_u16_be(r);
        out _decode_array_n(r, n);
    end

    # array32 (0xdd)
    if b == 221 do
        n = _read_u32_be(r);
        out _decode_array_n(r, n);
    end

    # map16 (0xde)
    if b == 222 do
        n = _read_u16_be(r);
        out _decode_map_n(r, n);
    end

    # map32 (0xdf)
    if b == 223 do
        n = _read_u32_be(r);
        out _decode_map_n(r, n);
    end

    # negative fixint (0xe0-0xff)
    if b >= 224 do
        out msg_int(b - 256);
    end

    # Unknown type
    out msg_nil();
end
func _decode_array_n:
    in(r: MsgReader; n: int)
    arr = msg_array();
    i = 0;
    when i < n loop
        msg_array_push(arr, _decode_value(r));
        i = i + 1;
    end
    out arr;
end
func _decode_map_n:
    in(r: MsgReader; n: int)
    mp = msg_map();
    i = 0;
    when i < n loop
        key = _decode_value(r);
        val = _decode_value(r);
        msg_map_put(mp, key, val);
        i = i + 1;
    end
    out mp;
end
# ═══════════════════════════════════════════════════════
# Convenience: encode/decode round-trip
# ═══════════════════════════════════════════════════════

func msgpack_encoded_size:
    in(data: Vec)
    out vec_len(data);
end