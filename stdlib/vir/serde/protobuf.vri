##
 * vir/serde/protobuf.vri — Protocol Buffers Wire Format
 * =====================================================
 * Inspired by Google: protobuf wire format
 * Inspired by Rust: prost crate
 *
 * Phase D — Varint encoding, wire types, message encode/decode.
 * Supports: varint, fixed32, fixed64, length-delimited, embedded messages.
 ##

include types;
include option;
import Option, Some, None, is_some, is_none, unwrap from option;
include vec;
import Vec, vec_new, vec_push, vec_get, vec_set, vec_len from vec;
include builder;
import StringBuilder, sb_new, sb_append_byte, sb_build, sb_free from builder;

# ═══════════════════════════════════════════════════════
# Wire types
# ═══════════════════════════════════════════════════════

const WIRE_VARINT           = 0;
const WIRE_FIXED64          = 1;
const WIRE_LENGTH_DELIMITED = 2;
const WIRE_FIXED32          = 5;

# ═══════════════════════════════════════════════════════
# Varint encoding/decoding
# ═══════════════════════════════════════════════════════

func pb_encode_varint:
    in(buf: StringBuilder; value: int)
    v = value;
    # Handle negative via ZigZag for signed types
    done = false;
    when not done loop
        byte_val = v & 127;
        v = v / 128;
        if v > 0 do
            sb_append_byte(buf, byte_val | 128);
        else
            sb_append_byte(buf, byte_val);
            done = true;
        end
    end
end.

entity PbDecodeResult:
    value: int,
        pos:   int;
end.

func pb_decode_varint:
    in(data: string; pos: int)
    result = 0;
    shift = 0;
    done = false;
    when not done loop
        byte_val = str_byte_at(data, pos);
        result = result | ((byte_val & 127) * (1 + shift));
        pos = pos + 1;
        if (byte_val & 128) == 0 do
            done = true;
        end
        shift = shift + 7;
    end
    out PbDecodeResult { value: result, pos: pos };
end

# ═══════════════════════════════════════════════════════
# ZigZag encoding for signed integers
# ═══════════════════════════════════════════════════════

func pb_zigzag_encode:
    in(n: int)
    # (n << 1) ^ (n >> 63)
    out (n * 2) ^ (n / 4611686018427387904);    # 2^62 approximation
end.

func pb_zigzag_decode:
    in(n: int)
    out (n / 2) ^ -(n & 1);
end

# ═══════════════════════════════════════════════════════
# Field encoding
# ═══════════════════════════════════════════════════════

func pb_encode_tag:
    in(buf: StringBuilder; field_num: int; wire_type: int)
    tag = field_num * 8 + wire_type;
    pb_encode_varint(buf, tag);
end.

func pb_encode_int:
    in(buf: StringBuilder; field_num: int; value: int)
    pb_encode_tag(buf, field_num, WIRE_VARINT);
    pb_encode_varint(buf, value);
end.

func pb_encode_sint:
    in(buf: StringBuilder; field_num: int; value: int)
    pb_encode_tag(buf, field_num, WIRE_VARINT);
    pb_encode_varint(buf, pb_zigzag_encode(value));
end.

func pb_encode_bool:
    in(buf: StringBuilder; field_num: int; value: bool)
    pb_encode_tag(buf, field_num, WIRE_VARINT);
    if value do
        pb_encode_varint(buf, 1);
    else
        pb_encode_varint(buf, 0);
    end
end.

func pb_encode_bytes:
    in(buf: StringBuilder; field_num: int; data: string; data_len: int)
    pb_encode_tag(buf, field_num, WIRE_LENGTH_DELIMITED);
    pb_encode_varint(buf, data_len);
    i = 0;
    when i < data_len loop
        sb_append_byte(buf, str_byte_at(data, i));
        i = i + 1;
    end
end.

func pb_encode_string:
    in(buf: StringBuilder; field_num: int; s: string)
    pb_encode_bytes(buf, field_num, s, str_len(s));
end.

func pb_encode_submessage:
    in(buf: StringBuilder; field_num: int; sub_data: string; sub_len: int)
    pb_encode_bytes(buf, field_num, sub_data, sub_len);
end

# ═══════════════════════════════════════════════════════
# Field decoding
# ═══════════════════════════════════════════════════════

entity PbField:
    field_num: int,
        wire_type: int,
        int_val:   int;        # for varint/fixed
    bytes_val: string;     # for length-delimited
    bytes_len: int,
        end_pos:   int;
end.

func pb_decode_field:
    in(data: string; pos: int)
    tag_r = pb_decode_varint(data, pos);
    tag = tag_r.value;
    pos = tag_r.pos;

    field_num = tag / 8;
    wire_type = tag & 7;

    field = PbField {
        field_num: field_num, wire_type: wire_type,
        int_val: 0, bytes_val: "", bytes_len: 0, end_pos: pos
    };

    if wire_type == WIRE_VARINT do
        val_r = pb_decode_varint(data, pos);
        field.int_val = val_r.value;
        field.end_pos = val_r.pos;
    eif wire_type == WIRE_FIXED64 do
        # Read 8 bytes little-endian
        val = 0;
        i = 7;
        when i >= 0 loop
            val = val * 256 + str_byte_at(data, pos + i);
            i = i - 1;
        end
        field.int_val = val;
        field.end_pos = pos + 8;
    eif wire_type == WIRE_FIXED32 do
        val = 0;
        i = 3;
        when i >= 0 loop
            val = val * 256 + str_byte_at(data, pos + i);
            i = i - 1;
        end
        field.int_val = val;
        field.end_pos = pos + 4;
    eif wire_type == WIRE_LENGTH_DELIMITED do
        len_r = pb_decode_varint(data, pos);
        field.bytes_len = len_r.value;
        field.bytes_val = str_slice(data, len_r.pos, len_r.pos + len_r.value);
        field.end_pos = len_r.pos + len_r.value;
    end

    out field;
end

# ═══════════════════════════════════════════════════════
# Message decoder: iterate all fields
# ═══════════════════════════════════════════════════════

func pb_decode_message:
    in(data: string; data_len: int)
    fields = vec_new();
    pos = 0;
    when pos < data_len loop
        field = pb_decode_field(data, pos);
        vec_push(fields, field);
        pos = field.end_pos;
    end
    out fields;    # Vec<PbField>
end.

func pb_find_field:
    in(fields: Vec; field_num: int)
    i = 0;
    when i < vec_len(fields) loop
        f = vec_get(fields, i);
        if f.field_num == field_num do
            out Some(f);
        end
        i = i + 1;
    end
    out None;
end
