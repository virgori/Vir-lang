##
 * vir/viron/fs_cmd.vri — Quản lý hệ thống tệp
 * ================================================
 * Syntax
 *   fs list [path]         Liệt kê tệp (thay ls)
 *   fs read <file>         Đọc nội dung (thay cat)
 *   fs copy <src> <dst>    Sao chép (thay cp)
 *   fs move <src> <dst>    Di chuyển (thay mv)
 *   fs remove <path>       Xoá (thay rm)
 *   fs mkdir <path>        Tạo directory
 *   fs info <path>         Thông tin tệp
 *   fs disk                Dung lượng đĩa (thay df)
 *   fs usage <path>        Dung lượng (thay du)
 *   fs find <name>         Tìm tệp
 ##

include types;
include result;
import Result, Ok, Err from result;
include string;
import String, str_new, str_eq from string;
include vec;
import Vec, vec_new, vec_push, vec_len, vec_get from vec;
include fs;
import exists, is_file, is_dir, metadata, Metadata from fs;
include file;
import file_open, file_read_all, FileMode from file;
include process;
import Command, command_new, command_arg, command_output from process;
include stdio;
import println from stdio;

func fs_dispatch:
    in(args:Vec<string>)
    if vec_len<String>(args) == 0 do
        out fs_list(vec_new<string>());
    end
    
    subcmd = vec_get<string>(args, 0);
    subargs = vec_new<string>();
    i = 1;
    when i < vec_len<String>(args) loop
        vec_push<string>(&subargs, vec_get<string>(args, i));
        i = i + 1;
    end
    
    if str_eq(subcmd, str_new("list")) do
        out fs_list(subargs);
    ngược_nếu str_eq(subcmd, str_new("read"));
        out fs_read(subargs);
    ngược_nếu str_eq(subcmd, str_new("copy"));
        out fs_copy(subargs);
    ngược_nếu str_eq(subcmd, str_new("move"));
        out fs_move(subargs);
    ngược_nếu str_eq(subcmd, str_new("remove"));
        out fs_remove(subargs);
    ngược_nếu str_eq(subcmd, str_new("mkdir"));
        out fs_mkdir(subargs);
    ngược_nếu str_eq(subcmd, str_new("info"));
        out fs_info(subargs);
    ngược_nếu str_eq(subcmd, str_new("disk"));
        out fs_disk(subargs);
    ngược_nếu str_eq(subcmd, str_new("usage"));
        out fs_usage(subargs);
    ngược_nếu str_eq(subcmd, str_new("find"));
        out fs_find(subargs);
    ngược_nếu str_eq(subcmd, str_new("chmod"));
        out fs_chmod(subargs);
    ngược;
        # Nếu subcmd là path -> list
        if exists(subcmd) do
            p_args = vec_new<string>();
            vec_push<string>(&p_args, subcmd);
            out fs_list(p_args);
        end
        println("Lệnh con invalid: " + subcmd);
        out 1;
    end
end.

func fs_list:
    in(args:Vec<string>)
    path = str_new(".");
    if vec_len<String>(args) > 0 do
        path = vec_get<string>(args, 0);
    end
    
    cmd = command_new(str_new("ls"));
    command_arg(&cmd, str_new("-la"));
    command_arg(&cmd, path);
    result = command_output(cmd);
    case result
        Ok(output);
            println(output.stdout);
            out 0;
        end
        Err(msg);
            println("Error: " + msg);
            out 1;
        end
    end
end.

func fs_read:
    in(args:Vec<string>)
    if vec_len<String>(args) == 0 do
        println("Syntax: fs read <file>");
        out 1;
    end
    path = vec_get<string>(args, 0);
    if !is_file(path) do
        println("Không phải tệp: " + path);
        out 1;
    end
    file_result = file_open(path, FileMode.Read);
    case file_result
        Ok(f);
            content = file_read_all(f);
            println(content);
            out 0;
        end
        Err(msg);
            println("Error: " + msg);
            out 1;
        end
    end
end.

func fs_copy:
    in(args:Vec<string>)
    if vec_len<String>(args) < 2 do
        println("Syntax: fs copy <nguồn> <đích>");
        out 1;
    end
    src = vec_get<string>(args, 0);
    dst = vec_get<string>(args, 1);
    cmd = command_new(str_new("cp"));
    command_arg(&cmd, str_new("-r"));
    command_arg(&cmd, src);
    command_arg(&cmd, dst);
    result = command_output(cmd);
    case result
        Ok(output);
            if output.exit_code == 0 do
                println("✓ Đã sao chép " + src + " -> " + dst);
            ngược;
                println("⛔ " + output.stderr);
            end
            out output.exit_code;
        end
        Err(_) out 1 end;
    end
end.

func fs_move:
    in(args:Vec<string>)
    if vec_len<String>(args) < 2 do
        println("Syntax: fs move <nguồn> <đích>");
        out 1;
    end
    src = vec_get<string>(args, 0);
    dst = vec_get<string>(args, 1);
    cmd = command_new(str_new("mv"));
    command_arg(&cmd, src);
    command_arg(&cmd, dst);
    result = command_output(cmd);
    case result
        Ok(output);
            if output.exit_code == 0 do
                println("✓ Đã di chuyển " + src + " -> " + dst);
            ngược;
                println("⛔ " + output.stderr);
            end
            out output.exit_code;
        end
        Err(_) out 1 end;
    end
end.

func fs_remove:
    in(args:Vec<string>)
    if vec_len<String>(args) == 0 do
        println("Syntax: fs remove <path>");
        out 1;
    end
    path = vec_get<string>(args, 0);
    if !exists(path) do
        println("Không tồn tại: " + path);
        out 1;
    end
    cmd = command_new(str_new("rm"));
    if is_dir(path) do
        command_arg(&cmd, str_new("-rf"));
    end
    command_arg(&cmd, path);
    result = command_output(cmd);
    case result
        Ok(output);
            if output.exit_code == 0 do
                println("✓ Đã xoá " + path);
            end
            out output.exit_code;
        end
        Err(_) out 1 end;
    end
end.

func fs_mkdir:
    in(args:Vec<string>)
    if vec_len<String>(args) == 0 do
        println("Syntax: fs mkdir <path>");
        out 1;
    end
    path = vec_get<string>(args, 0);
    cmd = command_new(str_new("mkdir"));
    command_arg(&cmd, str_new("-p"));
    command_arg(&cmd, path);
    result = command_output(cmd);
    case result
        Ok(output);
            if output.exit_code == 0 do
                println("✓ Đã tạo " + path);
            end
            out output.exit_code;
        end
        Err(_) out 1 end;
    end
end.

func fs_info:
    in(args:Vec<string>)
    if vec_len<String>(args) == 0 do
        println("Syntax: fs info <path>");
        out 1;
    end
    path = vec_get<string>(args, 0);
    if !exists(path) do
        println("Không tồn tại: " + path);
        out 1;
    end
    meta_result = metadata(path);
    case meta_result
        Ok(meta);
            println("  Đường dẫn:  " + path);
            println("  Kích thước: " + (meta.size >> string) + " bytes");
            println("  Chỉ đọc:   " + (meta.readonly >> string));
            out 0;
        end
        Err(msg);
            println("Error: " + msg);
            out 1;
        end
    end
end.

func fs_disk:
    in(args:Vec<string>)
    cmd = command_new(str_new("df"));
    command_arg(&cmd, str_new("-h"));
    result = command_output(cmd);
    case result
        Ok(output);
            println("Dung lượng đĩa:");
            println(output.stdout);
            out 0;
        end
        Err(_) out 1 end;
    end
end.

func fs_usage:
    in(args:Vec<string>)
    path = str_new(".");
    if vec_len<String>(args) > 0 do
        path = vec_get<string>(args, 0);
    end
    cmd = command_new(str_new("du"));
    command_arg(&cmd, str_new("-sh"));
    command_arg(&cmd, path);
    result = command_output(cmd);
    case result
        Ok(output);
            println(output.stdout);
            out 0;
        end
        Err(_) out 1 end;
    end
end.

func fs_find:
    in(args:Vec<string>)
    if vec_len<String>(args) == 0 do
        println("Syntax: fs find <name> [path]");
        out 1;
    end
    name = vec_get<string>(args, 0);
    search_path = str_new(".");
    if vec_len<String>(args) > 1 do
        search_path = vec_get<string>(args, 1);
    end
    cmd = command_new(str_new("find"));
    command_arg(&cmd, search_path);
    command_arg(&cmd, str_new("-name"));
    command_arg(&cmd, str_new("*") + name + str_new("*"));
    command_arg(&cmd, str_new("-maxdepth"));
    command_arg(&cmd, str_new("5"));
    result = command_output(cmd);
    case result
        Ok(output);
            println(output.stdout);
            out 0;
        end
        Err(_) out 1 end;
    end
end.

func fs_chmod:
    in(args:Vec<string>)
    if vec_len<String>(args) < 2 do
        println("Syntax: fs chmod <mode> <path>");
        out 1;
    end
    mode = vec_get<string>(args, 0);
    path = vec_get<string>(args, 1);
    cmd = command_new(str_new("chmod"));
    command_arg(&cmd, mode);
    command_arg(&cmd, path);
    result = command_output(cmd);
    case result
        Ok(output);
            if output.exit_code == 0 do
                println("✓ Đã đổi quyền " + path + " -> " + mode);
            end
            out output.exit_code;
        end
        Err(_) out 1 end;
    end
end
