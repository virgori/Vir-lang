/*
 * vir/viron/fs_cmd.vri — Quản lý hệ thống tệp
 * ================================================
 * Syntax:
 *   fs list [path]         Liệt kê tệp (thay ls)
 *   fs read <file>         Đọc nội dung (thay cat)
 *   fs copy <src> <dst>    Sao chép (thay cp)
 *   fs move <src> <dst>    Di chuyển (thay mv)
 *   fs remove <path>       Xoá (thay rm)
 *   fs mkdir <path>        Tạo directory
 *   fs info <path>         Thông tin tệp
 *   fs disk                Dung lượng đĩa (thay df)
 *   fs usage <path>        Dung lượng (thay du)
 *   fs find <name>         Tìm tệp
 */

import "vir/core/types" use all
import "vir/core/result" use Result, Ok, Err
import "vir/str/string" use String, str_new, str_eq
import "vir/collections/vec" use Vec, vec_new, vec_push, vec_len, vec_get
import "vir/fs/fs" use exists, is_file, is_dir, metadata, Metadata
import "vir/io/file" use file_open, file_read_all, FileMode
import "vir/process/process" use Command, command_new, command_arg, command_output
import "vir/io/stdio" use println

func fs_dispatch(args: Vec<String>) -> i32
    if vec_len<String>(args) == 0
        out fs_list(vec_new<String>())
    end
    
    var subcmd = vec_get<String>(args, 0)
    var subargs = vec_new<String>()
    var i: usize = 1
    lặp_khi i < vec_len<String>(args)
        vec_push<String>(&subargs, vec_get<String>(args, i))
        i = i + 1
    end
    
    if str_eq(subcmd, str_new("list"))
        out fs_list(subargs)
    ngược_nếu str_eq(subcmd, str_new("read"))
        out fs_read(subargs)
    ngược_nếu str_eq(subcmd, str_new("copy"))
        out fs_copy(subargs)
    ngược_nếu str_eq(subcmd, str_new("move"))
        out fs_move(subargs)
    ngược_nếu str_eq(subcmd, str_new("remove"))
        out fs_remove(subargs)
    ngược_nếu str_eq(subcmd, str_new("mkdir"))
        out fs_mkdir(subargs)
    ngược_nếu str_eq(subcmd, str_new("info"))
        out fs_info(subargs)
    ngược_nếu str_eq(subcmd, str_new("disk"))
        out fs_disk(subargs)
    ngược_nếu str_eq(subcmd, str_new("usage"))
        out fs_usage(subargs)
    ngược_nếu str_eq(subcmd, str_new("find"))
        out fs_find(subargs)
    ngược_nếu str_eq(subcmd, str_new("chmod"))
        out fs_chmod(subargs)
    ngược
        # Nếu subcmd là path -> list
        if exists(subcmd)
            var p_args = vec_new<String>()
            vec_push<String>(&p_args, subcmd)
            out fs_list(p_args)
        end
        println("Lệnh con invalid: " + subcmd)
        out 1
    end
end

func fs_list(args: Vec<String>) -> i32
    var path = str_new(".")
    if vec_len<String>(args) > 0
        path = vec_get<String>(args, 0)
    end
    
    var cmd = command_new(str_new("ls"))
    command_arg(&cmd, str_new("-la"))
    command_arg(&cmd, path)
    var result = command_output(cmd)
    case result
        Ok(output)
            println(output.stdout)
            out 0
        end
        Err(msg)
            println("Error: " + msg)
            out 1
        end
    end
end

func fs_read(args: Vec<String>) -> i32
    if vec_len<String>(args) == 0
        println("Syntax: fs read <file>")
        out 1
    end
    var path = vec_get<String>(args, 0)
    if !is_file(path)
        println("Không phải tệp: " + path)
        out 1
    end
    var file_result = file_open(path, FileMode.Read)
    case file_result
        Ok(f)
            var content = file_read_all(f)
            println(content)
            out 0
        end
        Err(msg)
            println("Error: " + msg)
            out 1
        end
    end
end

func fs_copy(args: Vec<String>) -> i32
    if vec_len<String>(args) < 2
        println("Syntax: fs copy <nguồn> <đích>")
        out 1
    end
    var src = vec_get<String>(args, 0)
    var dst = vec_get<String>(args, 1)
    var cmd = command_new(str_new("cp"))
    command_arg(&cmd, str_new("-r"))
    command_arg(&cmd, src)
    command_arg(&cmd, dst)
    var result = command_output(cmd)
    case result
        Ok(output)
            if output.exit_code == 0
                println("✓ Đã sao chép " + src + " -> " + dst)
            ngược
                println("⛔ " + output.stderr)
            end
            out output.exit_code
        end
        Err(_) out 1 end
    end
end

func fs_move(args: Vec<String>) -> i32
    if vec_len<String>(args) < 2
        println("Syntax: fs move <nguồn> <đích>")
        out 1
    end
    var src = vec_get<String>(args, 0)
    var dst = vec_get<String>(args, 1)
    var cmd = command_new(str_new("mv"))
    command_arg(&cmd, src)
    command_arg(&cmd, dst)
    var result = command_output(cmd)
    case result
        Ok(output)
            if output.exit_code == 0
                println("✓ Đã di chuyển " + src + " -> " + dst)
            ngược
                println("⛔ " + output.stderr)
            end
            out output.exit_code
        end
        Err(_) out 1 end
    end
end

func fs_remove(args: Vec<String>) -> i32
    if vec_len<String>(args) == 0
        println("Syntax: fs remove <path>")
        out 1
    end
    var path = vec_get<String>(args, 0)
    if !exists(path)
        println("Không tồn tại: " + path)
        out 1
    end
    var cmd = command_new(str_new("rm"))
    if is_dir(path)
        command_arg(&cmd, str_new("-rf"))
    end
    command_arg(&cmd, path)
    var result = command_output(cmd)
    case result
        Ok(output)
            if output.exit_code == 0
                println("✓ Đã xoá " + path)
            end
            out output.exit_code
        end
        Err(_) out 1 end
    end
end

func fs_mkdir(args: Vec<String>) -> i32
    if vec_len<String>(args) == 0
        println("Syntax: fs mkdir <path>")
        out 1
    end
    var path = vec_get<String>(args, 0)
    var cmd = command_new(str_new("mkdir"))
    command_arg(&cmd, str_new("-p"))
    command_arg(&cmd, path)
    var result = command_output(cmd)
    case result
        Ok(output)
            if output.exit_code == 0
                println("✓ Đã tạo " + path)
            end
            out output.exit_code
        end
        Err(_) out 1 end
    end
end

func fs_info(args: Vec<String>) -> i32
    if vec_len<String>(args) == 0
        println("Syntax: fs info <path>")
        out 1
    end
    var path = vec_get<String>(args, 0)
    if !exists(path)
        println("Không tồn tại: " + path)
        out 1
    end
    var meta_result = metadata(path)
    case meta_result
        Ok(meta)
            println("  Đường dẫn:  " + path)
            println("  Kích thước: " + (meta.size >> String) + " bytes")
            println("  Chỉ đọc:   " + (meta.readonly >> String))
            out 0
        end
        Err(msg)
            println("Error: " + msg)
            out 1
        end
    end
end

func fs_disk(args: Vec<String>) -> i32
    var cmd = command_new(str_new("df"))
    command_arg(&cmd, str_new("-h"))
    var result = command_output(cmd)
    case result
        Ok(output)
            println("Dung lượng đĩa:")
            println(output.stdout)
            out 0
        end
        Err(_) out 1 end
    end
end

func fs_usage(args: Vec<String>) -> i32
    var path = str_new(".")
    if vec_len<String>(args) > 0
        path = vec_get<String>(args, 0)
    end
    var cmd = command_new(str_new("du"))
    command_arg(&cmd, str_new("-sh"))
    command_arg(&cmd, path)
    var result = command_output(cmd)
    case result
        Ok(output)
            println(output.stdout)
            out 0
        end
        Err(_) out 1 end
    end
end

func fs_find(args: Vec<String>) -> i32
    if vec_len<String>(args) == 0
        println("Syntax: fs find <name> [path]")
        out 1
    end
    var name = vec_get<String>(args, 0)
    var search_path = str_new(".")
    if vec_len<String>(args) > 1
        search_path = vec_get<String>(args, 1)
    end
    var cmd = command_new(str_new("find"))
    command_arg(&cmd, search_path)
    command_arg(&cmd, str_new("-name"))
    command_arg(&cmd, str_new("*") + name + str_new("*"))
    command_arg(&cmd, str_new("-maxdepth"))
    command_arg(&cmd, str_new("5"))
    var result = command_output(cmd)
    case result
        Ok(output)
            println(output.stdout)
            out 0
        end
        Err(_) out 1 end
    end
end

func fs_chmod(args: Vec<String>) -> i32
    if vec_len<String>(args) < 2
        println("Syntax: fs chmod <mode> <path>")
        out 1
    end
    var mode = vec_get<String>(args, 0)
    var path = vec_get<String>(args, 1)
    var cmd = command_new(str_new("chmod"))
    command_arg(&cmd, mode)
    command_arg(&cmd, path)
    var result = command_output(cmd)
    case result
        Ok(output)
            if output.exit_code == 0
                println("✓ Đã đổi quyền " + path + " -> " + mode)
            end
            out output.exit_code
        end
        Err(_) out 1 end
    end
end
