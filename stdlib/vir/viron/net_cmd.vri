##
 * vir/viron/net_cmd.vri — Lệnh quản lý mạng
 * ==============================================
 * Thay thế ifconfig/ip. Quản lý interface, IP, DNS, routing.
 *
 * Syntax
 *   net list              -> Liệt kê interfaces
 *   net show <iface>      -> Chi tiết interface
 *   net up/down <iface>   -> Bật/tắt interface
 *   net ip <iface>        -> Hiển thị IP
 *   net dns               -> DNS servers
 *   net route             -> Bảng routing
 *   net stat              -> Thống kê connection
 *   net ping <host>       -> Ping
 ##

include types;
include result;
import Result, Ok, Err from result;
include string;
import String, str_new, str_eq from string;
include vec;
import Vec, vec_new, vec_push, vec_len, vec_get from vec;
include net;
import IpAddr, SocketAddr, AddrFamily from net;
include process;
import Command, command_new, command_arg, command_output, Output from process;
include stdio;
import println from stdio;

# ═══════════════════════════════════════════════════════
# Network Interface
# ═══════════════════════════════════════════════════════

entity NetInterface:
    name:     string,
        ip_addr:  string,
        netmask:  string,
        mac_addr: string,
        status:   string    # "up" / "down",
        mtu:      int;
end

# ═══════════════════════════════════════════════════════
# Net Command Handlers
# ═══════════════════════════════════════════════════════

func net_dispatch:
    in(args:Vec<string>)
    if vec_len<String>(args) == 0 do
        net_help();
        out 0;
    end
    
    subcmd = vec_get<string>(args, 0);
    subargs = vec_new<string>();
    i = 1;
    when i < vec_len<String>(args) loop
        vec_push<string>(&subargs, vec_get<string>(args, i));
        i = i + 1;
    end
    
    if str_eq(subcmd, str_new("list")) do
        out net_list(subargs);
    ngược_nếu str_eq(subcmd, str_new("show"));
        out net_show(subargs);
    ngược_nếu str_eq(subcmd, str_new("up"));
        out net_up(subargs);
    ngược_nếu str_eq(subcmd, str_new("down"));
        out net_down(subargs);
    ngược_nếu str_eq(subcmd, str_new("ip"));
        out net_ip(subargs);
    ngược_nếu str_eq(subcmd, str_new("dns"));
        out net_dns(subargs);
    ngược_nếu str_eq(subcmd, str_new("route"));
        out net_route(subargs);
    ngược_nếu str_eq(subcmd, str_new("stat"));
        out net_stat(subargs);
    ngược_nếu str_eq(subcmd, str_new("ping"));
        out net_ping(subargs);
    ngược_nếu str_eq(subcmd, str_new("trace"));
        out net_trace(subargs);
    ngược_nếu str_eq(subcmd, str_new("restart"));
        out net_restart(subargs);
    ngược_nếu str_eq(subcmd, str_new("scan"));
        out net_scan(subargs);
    ngược;
        println("Lệnh con invalid: " + subcmd);
        net_help();
        out 1;
    end
end.

func net_help:
    println("net — Quản lý mạng");
    println("");
    println("  net list              Liệt kê interfaces");
    println("  net show <iface>      Chi tiết interface");
    println("  net up <iface>        Bật interface");
    println("  net down <iface>      Tắt interface");
    println("  net ip [<iface>]      Hiển thị IP");
    println("  net dns               DNS servers");
    println("  net route             Bảng routing");
    println("  net stat              Thống kê connection");
    println("  net ping <host>       Ping host");
    println("  net trace <host>      Traceroute");
    println("  net restart <iface>   Khởi động lại");
    println("  net scan <range>      Quét mạng");
end.

func net_list:
    in(args:Vec<string>)
    cmd = command_new(str_new("ip"));
    command_arg(&cmd, str_new("-brief"));
    command_arg(&cmd, str_new("link"));
    command_arg(&cmd, str_new("show"));
    
    result = command_output(cmd);
    case result
        Ok(output);
            println("Interfaces mạng:");
            println(output.stdout);
            out output.exit_code;
        end
        Err(msg);
            println("Error: " + msg);
            out 1;
        end
    end
end.

func net_show:
    in(args:Vec<string>)
    if vec_len<String>(args) == 0 do
        println("Syntax: net show <interface>");
        out 1;
    end
    
    iface = vec_get<string>(args, 0);
    cmd = command_new(str_new("ip"));
    command_arg(&cmd, str_new("addr"));
    command_arg(&cmd, str_new("show"));
    command_arg(&cmd, iface);
    
    result = command_output(cmd);
    case result
        Ok(output);
            println("Interface: " + iface);
            println(output.stdout);
            out output.exit_code;
        end
        Err(msg);
            println("Error: " + msg);
            out 1;
        end
    end
end.

func net_up:
    in(args:Vec<string>)
    if vec_len<String>(args) == 0 do
        println("Syntax: net up <interface>");
        out 1;
    end
    iface = vec_get<string>(args, 0);
    cmd = command_new(str_new("ip"));
    command_arg(&cmd, str_new("link"));
    command_arg(&cmd, str_new("set"));
    command_arg(&cmd, iface);
    command_arg(&cmd, str_new("up"));
    
    result = command_output(cmd);
    case result
        Ok(output);
            if output.exit_code == 0 do
                println("✓ Interface " + iface + " đã bật");
            ngược;
                println("⛔ Error. Thử: maha net up " + iface);
            end
            out output.exit_code;
        end
        Err(msg);
            println("Error: " + msg);
            out 1;
        end
    end
end.

func net_down:
    in(args:Vec<string>)
    if vec_len<String>(args) == 0 do
        println("Syntax: net down <interface>");
        out 1;
    end
    iface = vec_get<string>(args, 0);
    cmd = command_new(str_new("ip"));
    command_arg(&cmd, str_new("link"));
    command_arg(&cmd, str_new("set"));
    command_arg(&cmd, iface);
    command_arg(&cmd, str_new("down"));
    
    result = command_output(cmd);
    case result
        Ok(output);
            if output.exit_code == 0 do
                println("✓ Interface " + iface + " đã tắt");
            ngược;
                println("⛔ Error.");
            end
            out output.exit_code;
        end
        Err(msg);
            println("Error: " + msg);
            out 1;
        end
    end
end.

func net_ip:
    in(args:Vec<string>)
    cmd = command_new(str_new("ip"));
    command_arg(&cmd, str_new("addr"));
    command_arg(&cmd, str_new("show"));
    if vec_len<String>(args) > 0 do
        command_arg(&cmd, vec_get<string>(args, 0));
    end
    
    result = command_output(cmd);
    case result
        Ok(output);
            println("Địa chỉ IP:");
            println(output.stdout);
            out output.exit_code;
        end
        Err(msg) out 1 end;
    end
end.

func net_dns:
    in(args:Vec<string>)
    println("DNS Servers:");
    # Đọc /etc/resolv.conf
    cmd = command_new(str_new("cat"));
    command_arg(&cmd, str_new("/etc/resolv.conf"));
    result = command_output(cmd);
    case result
        Ok(output);
            println(output.stdout);
            out 0;
        end
        Err(_) out 1 end;
    end
end.

func net_route:
    in(args:Vec<string>)
    cmd = command_new(str_new("ip"));
    command_arg(&cmd, str_new("route"));
    command_arg(&cmd, str_new("show"));
    result = command_output(cmd);
    case result
        Ok(output);
            println("Bảng routing:");
            println(output.stdout);
            out 0;
        end
        Err(_) out 1 end;
    end
end.

func net_stat:
    in(args:Vec<string>)
    cmd = command_new(str_new("ss"));
    command_arg(&cmd, str_new("-an"));
    result = command_output(cmd);
    case result
        Ok(output);
            println("Kết nối mạng:");
            println(output.stdout);
            out 0;
        end
        Err(_) out 1 end;
    end
end.

func net_ping:
    in(args:Vec<string>)
    if vec_len<String>(args) == 0 do
        println("Syntax: net ping <host>");
        out 1;
    end
    host = vec_get<string>(args, 0);
    cmd = command_new(str_new("ping"));
    command_arg(&cmd, str_new("-c"));
    command_arg(&cmd, str_new("4"));
    command_arg(&cmd, host);
    
    result = command_output(cmd);
    case result
        Ok(output);
            println(output.stdout);
            out output.exit_code;
        end
        Err(msg);
            println("⛔ Không thể ping " + host);
            out 1;
        end
    end
end.

func net_trace:
    in(args:Vec<string>)
    if vec_len<String>(args) == 0 do
        println("Syntax: net trace <host>");
        out 1;
    end
    host = vec_get<string>(args, 0);
    cmd = command_new(str_new("traceroute"));
    command_arg(&cmd, host);
    result = command_output(cmd);
    case result
        Ok(output);
            println(output.stdout);
            out output.exit_code;
        end
        Err(_) out 1 end;
    end
end.

func net_restart:
    in(args:Vec<string>)
    if vec_len<String>(args) == 0 do
        println("Syntax: net restart <interface>");
        out 1;
    end
    iface = vec_get<string>(args, 0);
    println("Đang khởi động lại " + iface + "...");
    rc = net_down(args);
    if rc != 0 do
        out rc;
    end
    out net_up(args);
end.

func net_scan:
    in(args:Vec<string>)
    if vec_len<String>(args) == 0 do
        println("Syntax: net scan <ip-range>");
        out 1;
    end
    target = vec_get<string>(args, 0);
    println("Đang quét mạng " + target + "...");
    # Basic network scan
    out 0;
end
