/*
 * vir/viron/pkg_cmd.vri — Quản lý gói phần mềm
 * =================================================
 * Syntax:
 *   pkg install <name>    Cài đặt gói
 *   pkg remove <name>     Gỡ gói
 *   pkg update            Cập nhật list
 *   pkg upgrade           Nâng cấp tất cả
 *   pkg search <name>     Tìm gói
 *   pkg list              Liệt kê đã cài
 *   pkg info <name>       Thông tin gói
 */

import "vir/core/types" use all
import "vir/core/result" use Result, Ok, Err
import "vir/str/string" use String, str_new, str_eq
import "vir/collections/vec" use Vec, vec_new, vec_push, vec_len, vec_get
import "vir/process/process" use Command, command_new, command_arg, command_output
import "vir/io/stdio" use println

func pkg_dispatch(args: Vec<String>) -> i32
    if vec_len<String>(args) == 0
        pkg_help()
        out 0
    end
    
    var subcmd = vec_get<String>(args, 0)
    var subargs = vec_new<String>()
    var i: usize = 1
    lặp_khi i < vec_len<String>(args)
        vec_push<String>(&subargs, vec_get<String>(args, i))
        i = i + 1
    end
    
    if str_eq(subcmd, str_new("install"))
        out pkg_install(subargs)
    ngược_nếu str_eq(subcmd, str_new("remove"))
        out pkg_remove(subargs)
    ngược_nếu str_eq(subcmd, str_new("update"))
        out pkg_update()
    ngược_nếu str_eq(subcmd, str_new("upgrade"))
        out pkg_upgrade()
    ngược_nếu str_eq(subcmd, str_new("search"))
        out pkg_search(subargs)
    ngược_nếu str_eq(subcmd, str_new("list"))
        out pkg_list()
    ngược_nếu str_eq(subcmd, str_new("info"))
        out pkg_info(subargs)
    ngược
        println("Lệnh con invalid: " + subcmd)
        pkg_help()
        out 1
    end
end

func pkg_help()
    println("pkg — Quản lý gói phần mềm")
    println("")
    println("  pkg install <name>    Cài đặt")
    println("  pkg remove <name>     Gỡ bỏ")
    println("  pkg update            Cập nhật list")
    println("  pkg upgrade           Nâng cấp tất cả")
    println("  pkg search <name>     Tìm kiếm")
    println("  pkg list              Liệt kê đã cài")
    println("  pkg info <name>       Thông tin")
end

func pkg_install(args: Vec<String>) -> i32
    if vec_len<String>(args) == 0
        println("Syntax: pkg install <name>")
        out 1
    end
    var name = vec_get<String>(args, 0)
    println("Đang cài đặt '" + name + "'...")
    
    # Thử các package manager
    var cmd = command_new(str_new("brew"))
    command_arg(&cmd, str_new("install"))
    command_arg(&cmd, name)
    var result = command_output(cmd)
    case result
        Ok(output)
            if output.exit_code == 0
                println("✓ Đã cài đặt '" + name + "'")
            ngược
                println("⛔ Error: " + output.stderr)
            end
            out output.exit_code
        end
        Err(_)
            println("Không tìm thấy package manager")
            out 1
        end
    end
end

func pkg_remove(args: Vec<String>) -> i32
    if vec_len<String>(args) == 0
        println("Syntax: pkg remove <name>")
        out 1
    end
    var name = vec_get<String>(args, 0)
    var cmd = command_new(str_new("brew"))
    command_arg(&cmd, str_new("uninstall"))
    command_arg(&cmd, name)
    var result = command_output(cmd)
    case result
        Ok(output)
            if output.exit_code == 0
                println("✓ Đã gỡ '" + name + "'")
            end
            out output.exit_code
        end
        Err(_) out 1 end
    end
end

func pkg_update() -> i32
    println("Đang cập nhật list gói...")
    var cmd = command_new(str_new("brew"))
    command_arg(&cmd, str_new("update"))
    var result = command_output(cmd)
    case result
        Ok(_)
            println("✓ Đã cập nhật")
            out 0
        end
        Err(_) out 1 end
    end
end

func pkg_upgrade() -> i32
    println("Đang nâng cấp gói...")
    var cmd = command_new(str_new("brew"))
    command_arg(&cmd, str_new("upgrade"))
    var result = command_output(cmd)
    case result
        Ok(output)
            if output.exit_code == 0
                println("✓ Đã nâng cấp xong")
            end
            out output.exit_code
        end
        Err(_) out 1 end
    end
end

func pkg_search(args: Vec<String>) -> i32
    if vec_len<String>(args) == 0
        println("Syntax: pkg search <name>")
        out 1
    end
    var name = vec_get<String>(args, 0)
    var cmd = command_new(str_new("brew"))
    command_arg(&cmd, str_new("search"))
    command_arg(&cmd, name)
    var result = command_output(cmd)
    case result
        Ok(output)
            println(output.stdout)
            out 0
        end
        Err(_) out 1 end
    end
end

func pkg_list() -> i32
    var cmd = command_new(str_new("brew"))
    command_arg(&cmd, str_new("list"))
    var result = command_output(cmd)
    case result
        Ok(output)
            println("Gói đã cài:")
            println(output.stdout)
            out 0
        end
        Err(_) out 1 end
    end
end

func pkg_info(args: Vec<String>) -> i32
    if vec_len<String>(args) == 0
        println("Syntax: pkg info <name>")
        out 1
    end
    var name = vec_get<String>(args, 0)
    var cmd = command_new(str_new("brew"))
    command_arg(&cmd, str_new("info"))
    command_arg(&cmd, name)
    var result = command_output(cmd)
    case result
        Ok(output)
            println(output.stdout)
            out 0
        end
        Err(_)
            println("Không tìm thấy gói '" + name + "'")
            out 1
        end
    end
end
