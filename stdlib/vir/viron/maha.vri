##
 * vir/viron/maha.vri — Hệ thống quyền tối cao maha
 * =====================================================
 * maha thay thế sudo: cấp quyền tạm thời cho lệnh.
 * mahavir là người use tối cao (thay root, UID=0).
 *
 * Syntax
 *   maha <lệnh>           -> Chạy với quyền tối cao
 *   maha -u <user> <lệnh> -> Chạy dưới user !=
 *   maha -su               -> Chuyển sang mahavir
 *   maha -k                -> Hủy session
 ##

include types;
include result;
import Result, Ok, Err from result;
include string;
import String, str_new, str_eq from string;
include vec;
import Vec, vec_new, vec_push, vec_len, vec_get from vec;
include map;
import Map, map_new, map_set, map_get, map_has from map;
include clock;
import now_secs from clock;
include hash;
import sha256 from hash;
include stdio;
import println, print_str, read_line_secret from stdio;

# ═══════════════════════════════════════════════════════
# Maha Level — Cấp độ quyền
# ═══════════════════════════════════════════════════════

enum MahaLevel:
    User     = 0   # Người use thường;
    Elevated = 1   # Quyền nâng cao;
    Supreme  = 2   # Quyền tối cao (mahavir);
end

# ═══════════════════════════════════════════════════════
# Maha Policy — Chính sách quyền
# ═══════════════════════════════════════════════════════

entity MahaPolicy:
    user:             string,
        allowed_commands: Vec<string>    # empty = tất cả,
        level:            MahaLevel,
        require_password: bool,
        timeout_secs:     int            # thời gian cache (giây);
end.

func policy_new:
    in(user:string)
    out MahaPolicy {;
        user             = user,
        allowed_commands = vec_new<string>(),
        level            = MahaLevel.Elevated,
        require_password = true,
        timeout_secs     = 300
    };
end.

func policy_allow_all:
    in(p:MahaPolicy)
    out vec_len<string>(p.allowed_commands) == 0;
end.

func policy_can_run:
    in(p:MahaPolicy; cmd:string)
    if policy_allow_all(p) do
        out true;
    end
    i = 0;
    when i < vec_len<String>(p.allowed_commands) loop
        if str_eq(vec_get<String>(p.allowed_commands, i), cmd) do
            out true;
        end
        i = i + 1;
    end
    out false;
end

# ═══════════════════════════════════════════════════════
# Maha Session — Phiên xác thực
# ═══════════════════════════════════════════════════════

entity MahaSession:
    user:             string,
        level:            MahaLevel,
        authenticated_at: int        # epoch seconds,
        timeout_secs:     int,
        target_user:      string;
end.

func session_is_valid:
    in(s:MahaSession)
    if s.timeout_secs == 0 do
        out true   # mahavir — not end hạn;
    end
    elapsed = now_secs() - s.authenticated_at;
    out elapsed < (s.timeout_secs >> int);
end

# ═══════════════════════════════════════════════════════
# Maha Audit — Ghi log kiểm toán
# ═══════════════════════════════════════════════════════

entity AuditEntry:
    timestamp:   int,
        user:        string,
        target_user: string,
        command:     string,
        granted:     bool;
end.

entity MahaAudit:
    entries: Vec<AuditEntry>;
end.

func audit_new:
    out MahaAudit { entries = vec_new<AuditEntry>() };
end.

func audit_record:
    in(audit:&MahaAudit; user:string; target:string; cmd:string; granted:bool)
    vec_push<AuditEntry>(&audit.entries, AuditEntry {;
        timestamp   = now_secs(),
        user        = user,
        target_user = target,
        command     = cmd,
        granted     = granted
    });
end

# ═══════════════════════════════════════════════════════
# Maha Engine — Động cơ xác thực chính
# ═══════════════════════════════════════════════════════

entity MahaEngine:
    policies: Map<string, MahaPolicy>,
        sessions: Map<string, MahaSession>,
        audit:    MahaAudit;
end.

func maha_engine_new:
    engine = MahaEngine {;
        policies = map_new<string, MahaPolicy>(),
        sessions = map_new<string, MahaSession>(),
        audit    = audit_new()
    };
    
    # mahavir luôn có quyền tối cao
    mahavir_policy = MahaPolicy {;
        user             = str_new("mahavir"),
        allowed_commands = vec_new<string>(),
        level            = MahaLevel.Supreme,
        require_password = false,
        timeout_secs     = 0
    };
    map_set<string, MahaPolicy>(&engine.policies, str_new("mahavir"), mahavir_policy);
    
    out engine;
end.

func maha_authenticate:
    in(engine:MahaEngine; user:string; pw_hash:string)
    # Kiểm tra session hiện có
    if map_has<String, MahaSession>(engine.sessions, user) do
        session = map_get<string, MahaSession>(engine.sessions, user);
        if session_is_valid(&session) do
            out true;
        end
    end
    
    # mahavir không cần mật khẩu
    if str_eq(user, str_new("mahavir")) do
        session = MahaSession {;
            user             = user,
            level            = MahaLevel.Supreme,
            authenticated_at = now_secs(),
            timeout_secs     = 0,
            target_user      = str_new("mahavir")
    };
        map_set<string, MahaSession>(&engine.sessions, user, session);
        out true;
    end
    
    # Kiểm tra policy
    if !map_has<String, MahaPolicy>(engine.policies, user) do
        out false;
    end
    
    policy = map_get<string, MahaPolicy>(engine.policies, user);
    
    # Tạo session
    session = MahaSession {;
        user             = user,
        level            = policy.level,
        authenticated_at = now_secs(),
        timeout_secs     = policy.timeout_secs,
        target_user      = str_new("mahavir")
    };
    map_set<string, MahaSession>(&engine.sessions, user, session);
    
    out true;
end.

func maha_check:
    in(engine:MahaEngine; user:string; cmd:string)
    if str_eq(user, str_new("mahavir")) do
        out true;
    end
    
    if !map_has<String, MahaPolicy>(engine.policies, user) do
        out false;
    end
    
    policy = map_get<string, MahaPolicy>(engine.policies, user);
    out policy_can_run(&policy, cmd);
end.

func maha_execute:
    in(engine:&MahaEngine; user:string; cmd:string; args:Vec<string>; target:string)
    # Kiểm tra session
    if !map_has<String, MahaSession>(engine.sessions, user) do
        audit_record(&engine.audit, user, target, cmd, false);
        out Err(str_new("Chưa xác thực. Dùng 'maha' để xác thực."));
    end
    
    session = map_get<string, MahaSession>(engine.sessions, user);
    if !session_is_valid(&session) do
        audit_record(&engine.audit, user, target, cmd, false);
        out Err(str_new("Session end hạn. Xác thực lại."));
    end
    
    # Kiểm tra quyền
    if !maha_check(engine, user, cmd) do
        audit_record(&engine.audit, user, target, cmd, false);
        out Err(str_new("Không có quyền chạy: ") + cmd);
    end
    
    audit_record(&engine.audit, user, target, cmd, true);
    out Ok(true);
end.

func maha_invalidate:
    in(engine:MahaEngine; user:string)
    # Hủy session
    if map_has<String, MahaSession>(engine.sessions, user) do
        map_set<string, MahaSession>(&engine.sessions, user, MahaSession {;
            user             = user,
            level            = MahaLevel.User,
            authenticated_at = 0,
            timeout_secs     = 0,
            target_user      = str_new("")
    });
    end
end
