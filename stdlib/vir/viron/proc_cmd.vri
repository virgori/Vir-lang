##
 * vir/viron/proc_cmd.vri — Quản lý tiến trình
 * ===============================================
 * Syntax
 *   proc list          -> Liệt kê tiến trình
 *   proc show <pid>    -> Chi tiết
 *   proc kill <pid>    -> Dừng tiến trình
 *   proc find <name>   -> Tìm theo tên
 *   proc tree          -> Cây tiến trình
 ##

include types;
include result;
import Result, Ok, Err from result;
include string;
import String, str_new, str_eq, str_to_int, str_contains_ci from string;
include vec;
import Vec, vec_new, vec_push, vec_len, vec_get from vec;
include process;
import Command, command_new, command_arg, command_output from process;
include stdio;
import println from stdio;

func proc_dispatch(args: Vec<string>):
    if vec_len<String>(args) == 0 do
        out proc_list(vec_new<string>());
    end
    
    subcmd = vec_get<string>(args, 0);
    subargs = vec_new<string>();
    i = 1;
    when i < vec_len<String>(args) loop
        vec_push<string>(&subargs, vec_get<string>(args, i));
        i = i + 1;
    end
    
    if str_eq(subcmd, str_new("list")) do
        out proc_list(subargs);
    ngược_nếu str_eq(subcmd, str_new("show"));
        out proc_show(subargs);
    ngược_nếu str_eq(subcmd, str_new("kill"));
        out proc_kill(subargs);
    ngược_nếu str_eq(subcmd, str_new("find"));
        out proc_find(subargs);
    ngược_nếu str_eq(subcmd, str_new("tree"));
        out proc_tree(subargs);
    ngược;
        println("Lệnh con invalid: " + subcmd);
        out 1;
    end
end.
func proc_list(args: Vec<string>):
    cmd = command_new(str_new("ps"));
    command_arg(&cmd, str_new("aux"));
    result = command_output(cmd);
    case result
        Ok(output);
            println(output.stdout);
            out 0;
        end
        Err(_) out 1 end;
    end
end.
func proc_show(args: Vec<string>):
    if vec_len<String>(args) == 0 do
        println("Syntax: proc show <pid>");
        out 1;
    end
    pid = vec_get<string>(args, 0);
    cmd = command_new(str_new("ps"));
    command_arg(&cmd, str_new("-p"));
    command_arg(&cmd, pid);
    command_arg(&cmd, str_new("-o"));
    command_arg(&cmd, str_new("pid,ppid,user,%cpu,%mem,stat,command"));
    result = command_output(cmd);
    case result
        Ok(output);
            println(output.stdout);
            out output.exit_code;
        end
        Err(_);
            println("Tiến trình " + pid + " không tồn tại");
            out 1;
        end
    end
end.
func proc_kill(args: Vec<string>):
    if vec_len<String>(args) == 0 do
        println("Syntax: proc kill [-9] <pid>");
        out 1;
    end
    
    signal = str_new("TERM");
    pid_str = vec_get<string>(args, 0);
    
    if str_eq(pid_str, str_new("-9")) && vec_len<String>(args) > 1 do
        signal = str_new("KILL");
        pid_str = vec_get<string>(args, 1);
    end
    
    cmd = command_new(str_new("kill"));
    command_arg(&cmd, str_new("-") + signal);
    command_arg(&cmd, pid_str);
    
    result = command_output(cmd);
    case result
        Ok(output);
            if output.exit_code == 0 do
                println("✓ Đã gửi " + signal + " đến PID " + pid_str);
            ngược;
                println("⛔ Không có quyền. Thử: maha proc kill " + pid_str);
            end
            out output.exit_code;
        end
        Err(_) out 1 end;
    end
end.
func proc_find(args: Vec<string>):
    if vec_len<String>(args) == 0 do
        println("Syntax: proc find <name>");
        out 1;
    end
    name = vec_get<string>(args, 0);
    cmd = command_new(str_new("pgrep"));
    command_arg(&cmd, str_new("-la"));
    command_arg(&cmd, name);
    result = command_output(cmd);
    case result
        Ok(output);
            if output.exit_code == 0 do
                println("Tiến trình '" + name + "':");
                println(output.stdout);
            ngược;
                println("Không tìm thấy: " + name);
            end
            out 0;
        end
        Err(_) out 1 end;
    end
end.
func proc_tree(args: Vec<string>):
    cmd = command_new(str_new("pstree"));
    result = command_output(cmd);
    case result
        Ok(output);
            println(output.stdout);
            out 0;
        end
        Err(_);
            # Fallback
            cmd2 = command_new(str_new("ps"));
            command_arg(&cmd2, str_new("-eo"));
            command_arg(&cmd2, str_new("pid,ppid,command"));
            r2 = command_output(cmd2);
            case r2
                Ok(out) println(out.stdout); out 0 end;
                Err(_) out 1 end;
            end
        end
    end
end.