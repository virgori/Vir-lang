/*
 * vir/viron/proc_cmd.vri — Quản lý tiến trình
 * ===============================================
 * Syntax:
 *   proc list          -> Liệt kê tiến trình
 *   proc show <pid>    -> Chi tiết
 *   proc kill <pid>    -> Dừng tiến trình
 *   proc find <name>   -> Tìm theo tên
 *   proc tree          -> Cây tiến trình
 */

import "vir/core/types" use all
import "vir/core/result" use Result, Ok, Err
import "vir/str/string" use String, str_new, str_eq, str_to_int, str_contains_ci
import "vir/collections/vec" use Vec, vec_new, vec_push, vec_len, vec_get
import "vir/process/process" use Command, command_new, command_arg, command_output
import "vir/io/stdio" use println

func proc_dispatch(args: Vec<String>) -> i32
    if vec_len<String>(args) == 0
        out proc_list(vec_new<String>())
    end
    
    var subcmd = vec_get<String>(args, 0)
    var subargs = vec_new<String>()
    var i: usize = 1
    lặp_khi i < vec_len<String>(args)
        vec_push<String>(&subargs, vec_get<String>(args, i))
        i = i + 1
    end
    
    if str_eq(subcmd, str_new("list"))
        out proc_list(subargs)
    ngược_nếu str_eq(subcmd, str_new("show"))
        out proc_show(subargs)
    ngược_nếu str_eq(subcmd, str_new("kill"))
        out proc_kill(subargs)
    ngược_nếu str_eq(subcmd, str_new("find"))
        out proc_find(subargs)
    ngược_nếu str_eq(subcmd, str_new("tree"))
        out proc_tree(subargs)
    ngược
        println("Lệnh con invalid: " + subcmd)
        out 1
    end
end

func proc_list(args: Vec<String>) -> i32
    var cmd = command_new(str_new("ps"))
    command_arg(&cmd, str_new("aux"))
    var result = command_output(cmd)
    case result
        Ok(output)
            println(output.stdout)
            out 0
        end
        Err(_) out 1 end
    end
end

func proc_show(args: Vec<String>) -> i32
    if vec_len<String>(args) == 0
        println("Syntax: proc show <pid>")
        out 1
    end
    var pid = vec_get<String>(args, 0)
    var cmd = command_new(str_new("ps"))
    command_arg(&cmd, str_new("-p"))
    command_arg(&cmd, pid)
    command_arg(&cmd, str_new("-o"))
    command_arg(&cmd, str_new("pid,ppid,user,%cpu,%mem,stat,command"))
    var result = command_output(cmd)
    case result
        Ok(output)
            println(output.stdout)
            out output.exit_code
        end
        Err(_)
            println("Tiến trình " + pid + " không tồn tại")
            out 1
        end
    end
end

func proc_kill(args: Vec<String>) -> i32
    if vec_len<String>(args) == 0
        println("Syntax: proc kill [-9] <pid>")
        out 1
    end
    
    var signal = str_new("TERM")
    var pid_str = vec_get<String>(args, 0)
    
    if str_eq(pid_str, str_new("-9")) && vec_len<String>(args) > 1
        signal = str_new("KILL")
        pid_str = vec_get<String>(args, 1)
    end
    
    var cmd = command_new(str_new("kill"))
    command_arg(&cmd, str_new("-") + signal)
    command_arg(&cmd, pid_str)
    
    var result = command_output(cmd)
    case result
        Ok(output)
            if output.exit_code == 0
                println("✓ Đã gửi " + signal + " đến PID " + pid_str)
            ngược
                println("⛔ Không có quyền. Thử: maha proc kill " + pid_str)
            end
            out output.exit_code
        end
        Err(_) out 1 end
    end
end

func proc_find(args: Vec<String>) -> i32
    if vec_len<String>(args) == 0
        println("Syntax: proc find <name>")
        out 1
    end
    var name = vec_get<String>(args, 0)
    var cmd = command_new(str_new("pgrep"))
    command_arg(&cmd, str_new("-la"))
    command_arg(&cmd, name)
    var result = command_output(cmd)
    case result
        Ok(output)
            if output.exit_code == 0
                println("Tiến trình '" + name + "':")
                println(output.stdout)
            ngược
                println("Không tìm thấy: " + name)
            end
            out 0
        end
        Err(_) out 1 end
    end
end

func proc_tree(args: Vec<String>) -> i32
    var cmd = command_new(str_new("pstree"))
    var result = command_output(cmd)
    case result
        Ok(output)
            println(output.stdout)
            out 0
        end
        Err(_)
            # Fallback
            var cmd2 = command_new(str_new("ps"))
            command_arg(&cmd2, str_new("-eo"))
            command_arg(&cmd2, str_new("pid,ppid,command"))
            var r2 = command_output(cmd2)
            case r2
                Ok(out) println(out.stdout); out 0 end
                Err(_) out 1 end
            end
        end
    end
end
