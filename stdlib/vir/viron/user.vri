##
 * vir/viron/user.vri — Quản lý người use & input dạng
 * ======================================================
 * mahavir là người use tối cao (thay root, UID=0).
 *
 * Syntax
 *   user whoami       -> Ai đang đăng import
 *   user list         -> Liệt kê người use
 *   user add <name>   -> Tạo user
 *   user del <name>   -> Xoá user
 *   user passwd       -> Đổi mật khẩu
 *   user groups       -> Nhóm
 *   user maha-add     -> Cấp quyền maha
 ##

include types;
include result;
import Result, Ok, Err from result;
include string;
import String, str_new, str_eq from string;
include vec;
import Vec, vec_new, vec_push, vec_len, vec_get from vec;
include map;
import Map, map_new, map_set, map_get, map_has from map;
include stdio;
import println from stdio;

# ═══════════════════════════════════════════════════════
# User Role — Vai trò người use
# ═══════════════════════════════════════════════════════

enum UserRole:
    Guest       = 0   # Khách;
    User        = 1   # Người use thường;
    MahaMember  = 2   # Thành viên nhóm maha;
    Admin       = 3   # Quản trị viên;
    Mahavir     = 4   # Người use tối cao ✦;
end

# ═══════════════════════════════════════════════════════
# VirUser — Đại diện người use
# ═══════════════════════════════════════════════════════

entity VirUser:
    uid:      int,
        username: string,
        role:     UserRole,
        groups:   Vec<string>,
        home_dir: string,
        shell:    string;
end
func user_is_mahavir:
    in(u:VirUser)
    out u.uid == 0 || u.role == UserRole.Mahavir;
end
func user_can_maha:
    in(u:VirUser)
    if user_is_mahavir(u) do
        out true;
    end
    if u.role >= UserRole.MahaMember do
        out true;
    end
    # Kiểm tra nhóm maha
    i = 0;
    when i < vec_len<String>(u.groups) loop
        if str_eq(vec_get<String>(u.groups, i), str_new("maha")) do
            out true;
        end
        i = i + 1;
    end
    out false;
end
# ═══════════════════════════════════════════════════════
# VirGroup — Nhóm người use
# ═══════════════════════════════════════════════════════

entity VirGroup:
    gid:     int,
        name:    string,
        members: Vec<string>;
end

# ═══════════════════════════════════════════════════════
# Identity Manager — Quản lý danh tính
# ═══════════════════════════════════════════════════════

entity IdentityManager:
    users:    Map<string, VirUser>,
        groups:   Map<string, VirGroup>,
        uid_map:  Map<int, string>,
        next_uid: int,
        next_gid: int;
end
func identity_new:
    mgr = IdentityManager (;
        users    = map_new<string, VirUser>(),
        groups   = map_new<string, VirGroup>(),
        uid_map  = map_new<int, string>(),
        next_uid = 1000,
        next_gid = 1000
    );
    
    # Tạo mahavir — người use tối cao default
    mahavir = VirUser (;
        uid      = 0,
        username = str_new("mahavir"),
        role     = UserRole.Mahavir,
        groups   = vec_new<string>(),
        home_dir = str_new("/home/mahavir"),
        shell    = str_new("/usr/bin/viron")
    );
    vec_push<string>(&mahavir.groups, str_new("mahavir"));
    vec_push<string>(&mahavir.groups, str_new("maha"));
    
    map_set<string, VirUser>(&mgr.users, str_new("mahavir"), mahavir);
    map_set<int, string>(&mgr.uid_map, 0, str_new("mahavir"));
    
    # Tạo nhóm maha default
    maha_group = VirGroup (;
        gid     = 0,
        name    = str_new("maha"),
        members = vec_new<string>()
    );
    vec_push<string>(&maha_group.members, str_new("mahavir"));
    map_set<string, VirGroup>(&mgr.groups, str_new("maha"), maha_group);
    
    out mgr;
end
func identity_add_user:
    in(mgr:&IdentityManager; username:string; role:UserRole)
    if map_has<String, VirUser>(mgr.users, username) do
        out Err(str_new("Người use already exists: ") + username);
    end
    
    uid = mgr.next_uid;
    mgr.next_uid = mgr.next_uid + 1;
    
    user = VirUser (;
        uid      = uid,
        username = username,
        role     = role,
        groups   = vec_new<string>(),
        home_dir = str_new("/home/") + username,
        shell    = str_new("/usr/bin/viron")
    );
    
    map_set<string, VirUser>(&mgr.users, username, user);
    map_set<int, string>(&mgr.uid_map, uid, username);
    
    out Ok(user);
end
func identity_remove_user:
    in(mgr:IdentityManager; username:string)
    if str_eq(username, str_new("mahavir")) do
        out false   # Không bao giờ xoá mahavir;
    end
    
    if !map_has<String, VirUser>(mgr.users, username) do
        out false;
    end
    
    # Xoá user (in thực tế: map_remove)
    out true;
end
func identity_get_user:
    in(mgr:IdentityManager; username:string)
    if map_has<String, VirUser>(mgr.users, username) do
        out Ok(map_get<string, VirUser>(mgr.users, username));
    end
    out Err(str_new("Không tìm thấy: ") + username);
end
func identity_add_to_group:
    in(mgr:&IdentityManager; username:string; group_name:string)
    if !map_has<String, VirUser>(mgr.users, username) do
        out false;
    end
    if !map_has<String, VirGroup>(mgr.groups, group_name) do
        out false;
    end
    
    group = map_get<string, VirGroup>(mgr.groups, group_name);
    vec_push<string>(&group.members, username);
    
    user = map_get<string, VirUser>(mgr.users, username);
    vec_push<string>(&user.groups, group_name);
    
    out true;
end
func identity_grant_maha:
    in(mgr:IdentityManager; username:string)
    # Cấp quyền maha cho user
    result = identity_add_to_group(mgr, username, str_new("maha"));
    if !result do
        out false;
    end
    
    # Nâng role
    if map_has<String, VirUser>(mgr.users, username) do
        user = map_get<string, VirUser>(mgr.users, username);
        user.role = UserRole.MahaMember;
    end
    
    out true;
end
# ═══════════════════════════════════════════════════════
# User Command Dispatcher
# ═══════════════════════════════════════════════════════

func user_dispatch:
    in(mgr:IdentityManager; args:Vec<string>)
    if vec_len<String>(args) == 0 do
        user_whoami(mgr);
        out 0;
    end
    
    subcmd = vec_get<string>(args, 0);
    subargs = vec_new<string>();
    i = 1;
    when i < vec_len<String>(args) loop
        vec_push<string>(&subargs, vec_get<string>(args, i));
        i = i + 1;
    end
    
    if str_eq(subcmd, str_new("whoami")) do
        user_whoami(mgr);
        out 0;
    ngược_nếu str_eq(subcmd, str_new("list"));
        out user_list(mgr);
    ngược_nếu str_eq(subcmd, str_new("add"));
        out user_add(mgr, subargs);
    ngược_nếu str_eq(subcmd, str_new("del"));
        out user_del(mgr, subargs);
    ngược_nếu str_eq(subcmd, str_new("maha-add"));
        out user_maha_add(mgr, subargs);
    ngược;
        println("Lệnh con invalid: " + subcmd);
        out 1;
    end
end
func user_whoami:
    in(mgr:IdentityManager)
    # Lấy user hiện tại
    println("mahavir")    # Placeholder;
end
func user_list:
    in(mgr:IdentityManager)
    println("Danh sách người use:");
    println("  UID  Username             Role");
    println("  ---  ---                  ---");
    println("    0  mahavir              MAHAVIR ✦");
    out 0;
end
func user_add:
    in(mgr:IdentityManager; args:Vec<string>)
    if vec_len<String>(args) == 0 do
        println("Syntax: user add <username>");
        out 1;
    end
    username = vec_get<string>(args, 0);
    result = identity_add_user(mgr, username, UserRole.User);
    case result
        Ok(user);
            println("✓ Đã tạo: " + username + " (UID " + (user.uid >> string) + ")");
            out 0;
        end
        Err(msg);
            println("⛔ " + msg);
            out 1;
        end
    end
end
func user_del:
    in(mgr:IdentityManager; args:Vec<string>)
    if vec_len<String>(args) == 0 do
        println("Syntax: user del <username>");
        out 1;
    end
    username = vec_get<string>(args, 0);
    if str_eq(username, str_new("mahavir")) do
        println("⛔ Không thể xoá mahavir!");
        out 1;
    end
    if identity_remove_user(mgr, username) do
        println("✓ Đã xoá: " + username);
        out 0;
    ngược;
        println("Không tìm thấy: " + username);
        out 1;
    end
end
func user_maha_add:
    in(mgr:IdentityManager; args:Vec<string>)
    if vec_len<String>(args) == 0 do
        println("Syntax: user maha-add <username>");
        out 1;
    end
    username = vec_get<string>(args, 0);
    if identity_grant_maha(mgr, username) do
        println("✓ Đã cấp quyền maha cho: " + username);
        out 0;
    ngược;
        println("⛔ Không tìm thấy user: " + username);
        out 1;
    end
end