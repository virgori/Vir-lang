##
 * vir/viron/svc.vri — Quản lý dịch vụ hệ thống
 * =================================================
 * Thay thế systemctl/launchctl/service.
 *
 * Syntax
 *   svc list              Liệt kê dịch vụ
 *   svc status <name>     Trạng thái
 *   svc start <name>      Khởi động
 *   svc stop <name>       Dừng
 *   svc restart <name>    Khởi động lại
 *   svc enable <name>     Bật auto-start
 *   svc disable <name>    Tắt auto-start
 *   svc log <name>        Xem log
 ##

include types;
include result;
import Result, Ok, Err from result;
include string;
import String, str_new, str_eq from string;
include vec;
import Vec, vec_new, vec_push, vec_len, vec_get from vec;
include process;
import Command, command_new, command_arg, command_output from process;
include stdio;
import println from stdio;

enum SvcBackend:
    Systemd   = 0;
    Launchctl = 1;
    Generic   = 2;
end.

enum SvcState:
    Running  = 0;
    Stopped  = 1;
    Failed   = 2;
    Unknown  = 3;
end.

entity ServiceInfo:
    name:    string,
        state:   SvcState,
        enabled: bool,
        pid:     int;
end.

func svc_dispatch:
    in(args:Vec<string>)
    if vec_len<String>(args) == 0 do
        out svc_list(vec_new<string>());
    end
    
    subcmd = vec_get<string>(args, 0);
    subargs = vec_new<string>();
    i = 1;
    when i < vec_len<String>(args) loop
        vec_push<string>(&subargs, vec_get<string>(args, i));
        i = i + 1;
    end
    
    if str_eq(subcmd, str_new("list")) do
        out svc_list(subargs);
    ngược_nếu str_eq(subcmd, str_new("status"));
        out svc_status(subargs);
    ngược_nếu str_eq(subcmd, str_new("start"));
        out svc_start(subargs);
    ngược_nếu str_eq(subcmd, str_new("stop"));
        out svc_stop(subargs);
    ngược_nếu str_eq(subcmd, str_new("restart"));
        out svc_restart(subargs);
    ngược_nếu str_eq(subcmd, str_new("enable"));
        out svc_enable(subargs);
    ngược_nếu str_eq(subcmd, str_new("disable"));
        out svc_disable(subargs);
    ngược_nếu str_eq(subcmd, str_new("log"));
        out svc_log(subargs);
    ngược;
        out svc_status(args)    # Coi as status;
    end
end.

func svc_list:
    in(args:Vec<string>)
    cmd = command_new(str_new("systemctl"));
    command_arg(&cmd, str_new("list-units"));
    command_arg(&cmd, str_new("--type=service"));
    command_arg(&cmd, str_new("--no-pager"));
    result = command_output(cmd);
    case result
        Ok(output);
            println("Dịch vụ hệ thống:");
            println(output.stdout);
            out 0;
        end
        Err(_);
            println("Không xác định được hệ thống quản lý dịch vụ");
            out 1;
        end
    end
end.

func svc_status:
    in(args:Vec<string>)
    if vec_len<String>(args) == 0 do
        println("Syntax: svc status <name>");
        out 1;
    end
    name = vec_get<string>(args, 0);
    cmd = command_new(str_new("systemctl"));
    command_arg(&cmd, str_new("status"));
    command_arg(&cmd, name);
    command_arg(&cmd, str_new("--no-pager"));
    result = command_output(cmd);
    case result
        Ok(output);
            println(output.stdout);
            out output.exit_code;
        end
        Err(_);
            println("Dịch vụ '" + name + "' not found");
            out 1;
        end
    end
end.

func svc_start:
    in(args:Vec<string>)
    if vec_len<String>(args) == 0 do
        println("Syntax: svc start <name>");
        out 1;
    end
    name = vec_get<string>(args, 0);
    cmd = command_new(str_new("systemctl"));
    command_arg(&cmd, str_new("start"));
    command_arg(&cmd, name);
    result = command_output(cmd);
    case result
        Ok(output);
            if output.exit_code == 0 do
                println("✓ Dịch vụ '" + name + "' đã khởi động");
            ngược;
                println("⛔ Error. Thử: maha svc start " + name);
            end
            out output.exit_code;
        end
        Err(msg);
            println("Error: " + msg);
            out 1;
        end
    end
end.

func svc_stop:
    in(args:Vec<string>)
    if vec_len<String>(args) == 0 do
        println("Syntax: svc stop <name>");
        out 1;
    end
    name = vec_get<string>(args, 0);
    cmd = command_new(str_new("systemctl"));
    command_arg(&cmd, str_new("stop"));
    command_arg(&cmd, name);
    result = command_output(cmd);
    case result
        Ok(output);
            if output.exit_code == 0 do
                println("✓ Dịch vụ '" + name + "' stopped");
            ngược;
                println("⛔ Error.");
            end
            out output.exit_code;
        end
        Err(_) out 1 end;
    end
end.

func svc_restart:
    in(args:Vec<string>)
    if vec_len<String>(args) == 0 do
        println("Syntax: svc restart <name>");
        out 1;
    end
    name = vec_get<string>(args, 0);
    cmd = command_new(str_new("systemctl"));
    command_arg(&cmd, str_new("restart"));
    command_arg(&cmd, name);
    result = command_output(cmd);
    case result
        Ok(output);
            if output.exit_code == 0 do
                println("✓ Dịch vụ '" + name + "' đã khởi động lại");
            ngược;
                println("⛔ Error. Thử: maha svc restart " + name);
            end
            out output.exit_code;
        end
        Err(_) out 1 end;
    end
end.

func svc_enable:
    in(args:Vec<string>)
    if vec_len<String>(args) == 0 do
        out 1;
    end
    name = vec_get<string>(args, 0);
    cmd = command_new(str_new("systemctl"));
    command_arg(&cmd, str_new("enable"));
    command_arg(&cmd, name);
    result = command_output(cmd);
    case result
        Ok(output);
            if output.exit_code == 0 do
                println("✓ Dịch vụ '" + name + "' sẽ tự khởi động");
            end
            out output.exit_code;
        end
        Err(_) out 1 end;
    end
end.

func svc_disable:
    in(args:Vec<string>)
    if vec_len<String>(args) == 0 do
        out 1;
    end
    name = vec_get<string>(args, 0);
    cmd = command_new(str_new("systemctl"));
    command_arg(&cmd, str_new("disable"));
    command_arg(&cmd, name);
    result = command_output(cmd);
    case result
        Ok(output);
            if output.exit_code == 0 do
                println("✓ Dịch vụ '" + name + "' tắt auto-start");
            end
            out output.exit_code;
        end
        Err(_) out 1 end;
    end
end.

func svc_log:
    in(args:Vec<string>)
    if vec_len<String>(args) == 0 do
        println("Syntax: svc log <name>");
        out 1;
    end
    name = vec_get<string>(args, 0);
    cmd = command_new(str_new("journalctl"));
    command_arg(&cmd, str_new("-u"));
    command_arg(&cmd, name);
    command_arg(&cmd, str_new("-n"));
    command_arg(&cmd, str_new("50"));
    command_arg(&cmd, str_new("--no-pager"));
    result = command_output(cmd);
    case result
        Ok(output);
            println("Log của '" + name + "':");
            println(output.stdout);
            out 0;
        end
        Err(_) out 1 end;
    end
end
