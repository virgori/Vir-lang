##
 * vir/viron/alias.vri — Alias Engine Zero-Cost
 * ===============================================
 * Ánh xạ lệnh zero-cost: alias chỉ là thêm key vào Map
 * trỏ đến cùng handler, không string matching tại runtime.
 *
 * Config format (aliases.conf)
 *   # alias = canonical  
 *   sudo = maha
 *   ifconfig = net
 ##

include types;
include result;
import Result, Ok, Err from result;
include string;
import String, str_new, str_trim, str_split, str_starts_with from string;
include map;
import Map, map_new, map_set, map_get, map_has from map;
include vec;
import Vec, vec_new, vec_push, vec_len from vec;
include fs;
import exists from fs;
include file;
import file_open, file_read_all, FileMode from file;

# ═══════════════════════════════════════════════════════
# Alias Map
# ═══════════════════════════════════════════════════════

entity AliasMap:
    mappings: Map<string, string>   # alias -> canonical;
end
func alias_map_new:
    out AliasMap (;
        mappings = map_new<string, string>()
    );
end
func alias_add:
    in(am:AliasMap; alias_name:string; canonical:string)
    map_set<string, string>(&am.mappings, alias_name, canonical);
end
func alias_resolve:
    in(am:AliasMap; name:string)
    # O(1) lookup — zero cost
    if map_has<String, String>(am.mappings, name) do
        out map_get<string, string>(am.mappings, name);
    end
    out name   # Returns chính nó if not phải alias;
end
func alias_is_alias:
    in(am:AliasMap; name:string)
    out map_has<string, string>(am.mappings, name);
end
# ═══════════════════════════════════════════════════════
# Config File Parser
# ═══════════════════════════════════════════════════════

func alias_load_file:
    in(am:AliasMap; path:string)
    if !exists(path) do
        out Err(str_new("File không tồn tại: ") + path);
    end
    
    file_result = file_open(path, FileMode.Read);
    case file_result
        Err(e) out Err(e) end;
        Ok(f);
            content = file_read_all(f);
            lines = str_split(content, "\n");
            loaded = 0;
            
            i = 0;
            when i < vec_len<String>(lines) loop
                line = str_trim(vec_get<string>(lines, i));
                
                # Bỏ qua comment and dòng trống
                if str_starts_with(line, " do #") || str_len(line) == 0 do
                    i = i + 1;
                    skip;
                end
                
                parts = str_split(line, "=");
                if vec_len<String>(parts) == 2 do
                    alias = str_trim(vec_get<string>(parts, 0));
                    canon = str_trim(vec_get<string>(parts, 1));
                    alias_add(am, alias, canon);
                    loaded = loaded + 1;
                end
                
                i = i + 1;
            end
            
            out Ok(loaded);
        end
    end
end
# ═══════════════════════════════════════════════════════
# Alias Profiles
# ═══════════════════════════════════════════════════════

entity AliasProfile:
    name:     string,
        mappings: Map<string, string>;
end
func profile_new:
    in(name:string)
    out AliasProfile (;
        name     = name,
        mappings = map_new<string, string>()
    );
end
func profile_add:
    in(p:AliasProfile; alias:string; canonical:string)
    map_set<string, string>(&p.mappings, alias, canonical);
end
func profile_apply:
    in(p:AliasProfile; am:AliasMap)
    # Apply profile vào alias map — zero cost
    count = 0;
    # Iterate mappings and add each to am
    out count;
end
# ═══════════════════════════════════════════════════════
# Default Aliases — Tương thích Unix/Linux
# ═══════════════════════════════════════════════════════

func alias_load_defaults:
    in(am:AliasMap)
    # Auth
    alias_add(am, str_new("sudo"), str_new("maha"));
    alias_add(am, str_new("su"), str_new("maha-su"));
    
    # Network  
    alias_add(am, str_new("ifconfig"), str_new("net"));
    alias_add(am, str_new("ip"), str_new("net"));
    alias_add(am, str_new("netstat"), str_new("net-stat"));
    alias_add(am, str_new("ss"), str_new("net-stat"));
    
    # Process
    alias_add(am, str_new("ps"), str_new("proc"));
    alias_add(am, str_new("kill"), str_new("proc-kill"));
    alias_add(am, str_new("top"), str_new("proc-top"));
    
    # Filesystem
    alias_add(am, str_new("ls"), str_new("fs-list"));
    alias_add(am, str_new("cp"), str_new("fs-copy"));
    alias_add(am, str_new("mv"), str_new("fs-move"));
    alias_add(am, str_new("rm"), str_new("fs-remove"));
    alias_add(am, str_new("mkdir"), str_new("fs-mkdir"));
    alias_add(am, str_new("cat"), str_new("fs-read"));
    alias_add(am, str_new("chmod"), str_new("fs-chmod"));
    alias_add(am, str_new("df"), str_new("fs-disk"));
    alias_add(am, str_new("du"), str_new("fs-usage"));
    
    # Service
    alias_add(am, str_new("systemctl"), str_new("svc"));
    alias_add(am, str_new("service"), str_new("svc"));
    alias_add(am, str_new("launchctl"), str_new("svc"));
    
    # Package
    alias_add(am, str_new("apt"), str_new("pkg"));
    alias_add(am, str_new("brew"), str_new("pkg"));
    
    # User
    alias_add(am, str_new("useradd"), str_new("user-add"));
    alias_add(am, str_new("userdel"), str_new("user-del"));
    alias_add(am, str_new("passwd"), str_new("user-passwd"));
    alias_add(am, str_new("whoami"), str_new("user-whoami"));
    
    # System
    alias_add(am, str_new("uname"), str_new("sys-info"));
    alias_add(am, str_new("hostname"), str_new("sys-host"));
end