 ##

include types;
include option;
import Option, Some, None from option;
include result;
import Result, Ok, Err from result;
include string;
import String, str_new, str_eq, str_concat from string;
include vec;
import Vec, vec_new, vec_push, vec_len, vec_get from vec;
include map;
import Map, map_new, map_set, map_get from map;
include file;
import file_read_string, file_write_string from file;

# ═══════════════════════════════════════════════════════
# Version
# ═══════════════════════════════════════════════════════

entity SemVer:
    major: int,
        minor: int,
        patch: int,
        pre:   string    # "alpha.1", "beta.2", "";
end.

func semver:
    in(major:int; minor:int; patch:int)
    out SemVer ( major = major, minor = minor, patch = patch, pre = str_new("") );
end.

func semver_to_string:
    in(v:SemVer)
    s = str_concat(int_to_string(v.major), str_new("."));
    s = str_concat(s, int_to_string(v.minor));
    s = str_concat(s, str_new("."));
    s = str_concat(s, int_to_string(v.patch));
    if str_byte_len(v.pre) > 0 do
        s = str_concat(s, str_new("-"));
        s = str_concat(s, v.pre);
    end
    out s;
end.

func semver_cmp:
    in(a:SemVer; b:SemVer)
    if a.major != b.major do out if a.major < b.major -1 else 1 end end
    if a.minor != b.minor do out if a.minor < b.minor -1 else 1 end end
    if a.patch != b.patch do out if a.patch < b.patch -1 else 1 end end
    out 0;
end.

func semver_compatible:
    in(required:SemVer; actual:SemVer)
    # ^major.minor.patch — same major, >= minor.patch
    if required.major != actual.major do out false end
    if actual.minor > required.minor do out true end
    if actual.minor < required.minor do out false end
    out actual.patch >= required.patch;
end

# ═══════════════════════════════════════════════════════
# Package Manifest
# ═══════════════════════════════════════════════════════

entity Dependency:
    name:    string,
        version: string     # version constraint: "^0.2.0", ">=1.0";
end.

entity Manifest:
    name:         string,
        version:      SemVer,
        description:  string,
        authors:      Vec<string>,
        license:      string,
        dependencies: Vec<Dependency>,
        dev_deps:     Vec<Dependency>,
        entry:        string        # main source file;
end.

func manifest_new:
    in(name:string; version:SemVer)
    out Manifest (;
        name = name, version = version,
        description = str_new(""),
        authors = vec_new<string>(),
        license = str_new("MIT"),
        dependencies = vec_new<Dependency>(),
        dev_deps = vec_new<Dependency>(),
        entry = str_new("src/main.vri")
    );
end.

func manifest_add_dep:
    in(m:Manifest; name:string; version:string)
    vec_push<Dependency>(&m.dependencies, Dependency ( name = name, version = version ));
end

# ═══════════════════════════════════════════════════════
# Lock File
# ═══════════════════════════════════════════════════════

entity LockEntry:
    name:     string,
        version:  SemVer,
        checksum: string     # SHA-256 hex,
        source:   string     # registry URL;
end.

entity LockFile:
    entries: Vec<LockEntry>;
end

# ═══════════════════════════════════════════════════════
# Package Registry (stub)
# ═══════════════════════════════════════════════════════

entity Registry:
    url: string;
end.

func default_registry:
    out Registry ( url = str_new("https://pkg.vri-lang.org/v1") );
end.

func pkg_search:
    in(reg:Registry; query:string)
    # TODO: HTTP GET to registry
    out Ok(vec_new<string>());
end.

func pkg_fetch:
    in(reg:Registry; name:string; version:string)
    # TODO: download package tarball
    out Err(str_new("not implemented"));
end

# ═══════════════════════════════════════════════════════
# Dependency Resolution (topological sort)
# ═══════════════════════════════════════════════════════

entity ResolvedPkg:
    name:    string,
        version: SemVer,
        deps:    Vec<string>;
end.

func resolve:
    in(manifest:Manifest)
    # Simplified resolver: no version ranges, direct deps only
    resolved = vec_new<ResolvedPkg>();
    i = 0;
    when i < vec_len<Dependency>(manifest.dependencies) loop
        dep = vec_get<Dependency>(manifest.dependencies, i);
        vec_push<ResolvedPkg>(&resolved, ResolvedPkg (;
            name = dep.name,
            version = semver(0, 0, 0),   # placeholder;
            deps = vec_new<string>()
    ));
        i = i + 1;
    end
    out Ok(resolved);
end
