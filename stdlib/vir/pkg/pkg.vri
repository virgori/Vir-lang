import "vir/core/types" use all
import "vir/core/option" use Option, Some, None
import "vir/core/result" use Result, Ok, Err
import "vir/str/string" use String, str_new, str_eq, str_concat
import "vir/collections/vec" use Vec, vec_new, vec_push, vec_len, vec_get
import "vir/collections/map" use Map, map_new, map_set, map_get
import "vir/io/file" use file_read_string, file_write_string

# ═══════════════════════════════════════════════════════
# Version
# ═══════════════════════════════════════════════════════

entity SemVer
    major: u32
    minor: u32
    patch: u32
    pre:   String    # "alpha.1", "beta.2", ""
end

func semver(major: u32, minor: u32, patch: u32) -> SemVer
    out SemVer { major = major, minor = minor, patch = patch, pre = str_new("") }
end

func semver_to_string(v: SemVer) -> String
    var s = str_concat(int_to_string(v.major), str_new("."))
    s = str_concat(s, int_to_string(v.minor))
    s = str_concat(s, str_new("."))
    s = str_concat(s, int_to_string(v.patch))
    if str_byte_len(v.pre) > 0
        s = str_concat(s, str_new("-"))
        s = str_concat(s, v.pre)
    end
    out s
end

func semver_cmp(a: SemVer, b: SemVer) -> i32
    if a.major != b.major out if a.major < b.major -1 else 1 end end
    if a.minor != b.minor out if a.minor < b.minor -1 else 1 end end
    if a.patch != b.patch out if a.patch < b.patch -1 else 1 end end
    out 0
end

func semver_compatible(required: SemVer, actual: SemVer) -> bool
    # ^major.minor.patch — same major, >= minor.patch
    if required.major != actual.major out false end
    if actual.minor > required.minor out true end
    if actual.minor < required.minor out false end
    out actual.patch >= required.patch
end

# ═══════════════════════════════════════════════════════
# Package Manifest
# ═══════════════════════════════════════════════════════

entity Dependency
    name:    String
    version: String     # version constraint: "^0.2.0", ">=1.0"
end

entity Manifest
    name:         String
    version:      SemVer
    description:  String
    authors:      Vec<String>
    license:      String
    dependencies: Vec<Dependency>
    dev_deps:     Vec<Dependency>
    entry:        String        # main source file
end

func manifest_new(name: String, version: SemVer) -> Manifest
    out Manifest {
        name = name, version = version,
        description = str_new(""),
        authors = vec_new<String>(),
        license = str_new("MIT"),
        dependencies = vec_new<Dependency>(),
        dev_deps = vec_new<Dependency>(),
        entry = str_new("src/main.vri")
    }
end

func manifest_add_dep(m: &Manifest, name: String, version: String)
    vec_push<Dependency>(&m.dependencies, Dependency { name = name, version = version })
end

# ═══════════════════════════════════════════════════════
# Lock File
# ═══════════════════════════════════════════════════════

entity LockEntry
    name:     String
    version:  SemVer
    checksum: String     # SHA-256 hex
    source:   String     # registry URL
end

entity LockFile
    entries: Vec<LockEntry>
end

# ═══════════════════════════════════════════════════════
# Package Registry (stub)
# ═══════════════════════════════════════════════════════

entity Registry
    url: String
end

func default_registry() -> Registry
    out Registry { url = str_new("https://pkg.vri-lang.org/v1") }
end

func pkg_search(reg: Registry, query: String) -> Result<Vec<String>, String>
    # TODO: HTTP GET to registry
    out Ok(vec_new<String>())
end

func pkg_fetch(reg: Registry, name: String, version: String) -> Result<Vec<u8>, String>
    # TODO: download package tarball
    out Err(str_new("not implemented"))
end

# ═══════════════════════════════════════════════════════
# Dependency Resolution (topological sort)
# ═══════════════════════════════════════════════════════

entity ResolvedPkg
    name:    String
    version: SemVer
    deps:    Vec<String>
end

func resolve(manifest: Manifest) -> Result<Vec<ResolvedPkg>, String>
    # Simplified resolver: no version ranges, direct deps only
    var resolved = vec_new<ResolvedPkg>()
    var i: usize = 0
    lặp_khi i < vec_len<Dependency>(manifest.dependencies)
        var dep = vec_get<Dependency>(manifest.dependencies, i)
        vec_push<ResolvedPkg>(&resolved, ResolvedPkg {
            name = dep.name,
            version = semver(0, 0, 0),   # placeholder
            deps = vec_new<String>()
        })
        i = i + 1
    end
    out Ok(resolved)
end
