##
 * vir/parser_kit/parser_kit.vri — Parser Combinator Kit
 * =======================================================
 * Phase D — self-hosting: parser for Vir language
 *
 * Recursive descent parser using token stream from vir/token
 ##

include types;
include option;
import Option, Some, None from option;
include result;
import Result, Ok, Err from result;
include string;
import String, str_new, str_concat, str_eq from string;
include vec;
import Vec, vec_new, vec_push, vec_len, vec_get from vec;
include token;
import Token, TokenKind, Lexer, lexer_new, lexer_tokenize from token;
include ast;
import * from ast;

# ═══════════════════════════════════════════════════════
# Parser State
# ═══════════════════════════════════════════════════════

entity Parser:
    tokens: Vec<Token>,
        pos:    int,
        errors: Vec<ParseError>;
end
entity ParseError:
    message: string,
        span:    Span;
end
func parser_new:
    in(source:string; file:string)
    lex = lexer_new(source, file);
    tokens = lexer_tokenize(&lex);
    out Parser (;
        tokens = tokens,
        pos = 0,
        errors = vec_new<ParseError>()
    );
end
# ─── Token navigation ────────────────────────────────

func _peek:
    in(p:Parser)
    if p.pos >= vec_len<Token>(p.tokens) do
        out Token ( kind = TokenKind.EOF, text = str_new(""), span = span_new(str_new(""), 0, 0, 0, 0) );
    end
    out vec_get<Token>(p.tokens, p.pos);
end
func _peek_kind:
    in(p:Parser)
    out _peek(p).kind;
end
func _advance:
    in(p:Parser)
    tok = _peek(p);
    if p.pos < vec_len<Token>(p.tokens) do
        p.pos = p.pos + 1;
    end
    out tok;
end
func _expect:
    in(p:Parser; kind:TokenKind)
    tok = _peek(p);
    if tok.kind != kind do
        err = ParseError (;
            message = str_concat(str_new("expected "), token_kind_name(kind)),
            span = tok.span
    );
        vec_push<ParseError>(&p.errors, err);
        out Err(err);
    end
    out Ok(_advance(p));
end
func _check:
    in(p:Parser; kind:TokenKind)
    out _peek_kind(p) == kind;
end
func _match:
    in(p:Parser; kind:TokenKind)
    if _peek_kind(p) == kind do
        _advance(p);
        out true;
    end
    out false;
end
func token_kind_name:
    in(k:TokenKind)
    case k;
        case TokenKind.KwHàm out str_new("'func'")
        case TokenKind.KwBiến out str_new("'var'")
        case TokenKind.KwBảnGhi out str_new("'entity'")
        case TokenKind.KwLiệtKê out str_new("'enum'")
        case TokenKind.Ident out str_new("identifier")
        case TokenKind.EOF out str_new("end of file")
        default out str_new("token");
    end
end
# ═══════════════════════════════════════════════════════
# Parse: Program
# ═══════════════════════════════════════════════════════

func parse_program:
    in(p:Parser)
    prog = program_new();
    items = vec_new<Item>();
    
    when _peek_kind(p) != TokenKind.EOF loop
        item_result = _parse_item(p);
        case item_result;
            case Ok(item) vec_push<Item>(&items, item)
        Err(e):
                # Error recovery: skip to next item boundary
                _recover_to_item_boundary(p);
        end
    end
    
    if vec_len<ParseError>(p.errors) > 0 do
        out Err(p.errors);
    end
    
    mod_ = Module ( name = str_new("main"), path = str_new(""), items = items );
    program_add_module(&prog, mod_);
    out Ok(prog);
end
func _recover_to_item_boundary:
    in(p:Parser)
    loop
        k = _peek_kind(p);
        if k == TokenKind.EOF do break end
        if k == TokenKind.KwHàm or k == TokenKind.KwBảnGhi or k == TokenKind.KwLiệtKê do
           or k == TokenKind.KwNhập or k == TokenKind.KwHằngSố break end;
        _advance(p);
    end
end
# ═══════════════════════════════════════════════════════
# Parse: Items
# ═══════════════════════════════════════════════════════

func _parse_item:
    in(p:Parser)
    k = _peek_kind(p);
    
    case k;
        case TokenKind.KwHàm out _parse_fn_def(p)
        case TokenKind.KwBảnGhi out _parse_struct_def(p)
        case TokenKind.KwLiệtKê out _parse_enum_def(p)
        case TokenKind.KwNhập out _parse_import(p)
        case TokenKind.KwHằngSố out _parse_const_item(p)
        default;
            tok = _advance(p);
            err = ParseError (;
                message = str_concat(str_new("unexpected token: "), tok.text),
                span = tok.span
    );
            vec_push<ParseError>(&p.errors, err);
            out Err(err);
    end
end
func _parse_fn_def:
    in(p:Parser)
    kw = _advance(p)   # func;
    
    # Check for 'ngoài' (extern)
    if _check(p, TokenKind.KwNgoài) do
        _advance(p);
        out _parse_extern_fn(p, kw.span);
    end
    
    name_tok = _expect(p, TokenKind.Ident);
    var name:string;
    var name_span:Span;
    case name_tok;
        Err(e): out Err(e);
        case Ok(t) name = t.text; name_span = t.span
    end
    
    # Generics: <T, U>
    generics = vec_new<string>();
    if _match(p, TokenKind.Lt) do
        loop
            g_tok = _expect(p, TokenKind.Ident);
            case g_tok;
                case Ok(t) vec_push<string>(&generics, t.text)
                case Err(e) break
            end
            if ! do _match(p, TokenKind.Comma) break end
        end
        _expect(p, TokenKind.Gt);
    end
    
    # Params: (name: Type, ...)
    _expect(p, TokenKind.LParen);
    params = _parse_params(p);
    _expect(p, TokenKind.RParen);
    
    # Return type: -> Type
    return_ty = None;
    if _match(p, TokenKind.Arrow) do
        ty = _parse_type(p);
        return_ty = Some(ty);
    end
    
    # Body
    body = _parse_block(p);
    
    out Ok(Item.Function(FnDef (;
        name = name, vis = Visibility.Public,
        params = params, return_ty = return_ty,
        generics = generics, body = body,
        span = span_merge(kw.span, name_span)
    )));
end
func _parse_extern_fn:
    in(p:Parser; start_span:Span)
    name_tok = _expect(p, TokenKind.Ident);
    var name:string;
    case name_tok;
        Err(e): out Err(e);
        case Ok(t) name = t.text
    end
    
    _expect(p, TokenKind.LParen);
    params = _parse_params(p);
    _expect(p, TokenKind.RParen);
    
    return_ty = None;
    if _match(p, TokenKind.Arrow) do
        return_ty = Some(_parse_type(p));
    end
    
    out Ok(Item.ExternFn(ExternFnDef (;
        name = name, params = params,
        return_ty = return_ty, span = start_span
    )));
end
func _parse_struct_def:
    in(p:Parser)
    kw = _advance(p)   # entity;
    name_tok = _expect(p, TokenKind.Ident);
    var name:string;
    case name_tok;
        Err(e): out Err(e);
        case Ok(t) name = t.text
    end
    
    _expect(p, TokenKind.KwThì)    #;
    fields = vec_new<FieldDef>();
    when !_check(p, TokenKind.KwHết) and !_check(p, TokenKind.EOF) loop
        fname = _expect(p, TokenKind.Ident);
        _expect(p, TokenKind.Colon);
        ftype = _parse_type(p);
        case fname;
        Ok(ft):
                vec_push<FieldDef>(&fields, FieldDef (;
                    name = ft.text, type_ = ftype, span = ft.span
    ));
            case Err(_) ()
        end
    end
    _expect(p, TokenKind.KwHết)    # end;
    
    out Ok(Item.Struct(StructDef (;
        name = name, vis = Visibility.Public,
        generics = vec_new<string>(), fields = fields,
        span = kw.span
    )));
end
func _parse_enum_def:
    in(p:Parser)
    kw = _advance(p)   # enum;
    name_tok = _expect(p, TokenKind.Ident);
    var name:string;
    case name_tok;
        Err(e): out Err(e);
        case Ok(t) name = t.text
    end
    
    _expect(p, TokenKind.KwThì);
    
    variants = vec_new<VariantDef>();
    when !_check(p, TokenKind.KwHết) and !_check(p, TokenKind.EOF) loop
        vname = _expect(p, TokenKind.Ident);
        var_fields = vec_new<TypeNode>();
        var_value = None;
        
        # Variant(T1, T2) or Variant = value
        if _match(p, TokenKind.LParen) do
            loop
                vec_push<TypeNode>(&var_fields, _parse_type(p));
                if ! do _match(p, TokenKind.Comma) break end
            end
            _expect(p, TokenKind.RParen);
        eif _match(p, TokenKind.Eq) do
            val_tok = _expect(p, TokenKind.IntLiteral);
            case val_tok;
                case Ok(t) var_value = Some(str_to_i64(t.text))
                case Err(_) ()
            end
        end
        
        case vname;
        Ok(vt):
                vec_push<VariantDef>(&variants, VariantDef (;
                    name = vt.text, fields = var_fields,
                    value = var_value, span = vt.span
    ));
            case Err(_) ()
        end
    end
    _expect(p, TokenKind.KwHết);
    
    out Ok(Item.Enum(EnumDef (;
        name = name, vis = Visibility.Public,
        generics = vec_new<string>(), variants = variants,
        span = kw.span
    )));
end
func _parse_import:
    in(p:Parser)
    kw = _advance(p)   # import;
    path_tok = _expect(p, TokenKind.StringLiteral);
    var path_str:string;
    case path_tok;
        Err(e): out Err(e);
        Ok(t):
            # Strip quotes
            path_str = str_slice_bytes(t.text, 1, str_byte_len(t.text) - 1);
    end
    
    path_parts = str_split(path_str, str_new("/"));
    items = vec_new<string>();
    all = false;
    
    if _match(p, TokenKind.KwDùng) do
        if _check(p, TokenKind.KwHết) do # use all do
            _advance(p);
            all = true;
        else
            loop
                item_tok = _expect(p, TokenKind.Ident);
                case item_tok;
                    case Ok(t) vec_push<string>(&items, t.text)
                    case Err(_) break
                end
                if ! do _match(p, TokenKind.Comma) break end
            end
        end
    end
    
    out Ok(Item.Import(ImportDef (;
        path = path_parts, items = items, all = all,
        alias = None, span = kw.span
    )));
end
func _parse_const_item:
    in(p:Parser)
    kw = _advance(p)   # hằng_số;
    name_tok = _expect(p, TokenKind.Ident);
    var name:string;
    case name_tok;
        Err(e): out Err(e);
        case Ok(t) name = t.text
    end
    
    ty = TypeNode.Infer;
    if _match(p, TokenKind.Colon) do ty = _parse_type(p) end
    _expect(p, TokenKind.Eq);
    expr = _parse_expr(p);
    
    out Ok(Item.Const(name, ty, expr, kw.span));
end
# ═══════════════════════════════════════════════════════
# Parse: Types, Params, Block, Expr (stubs)
# ═══════════════════════════════════════════════════════

func _parse_params:
    in(p:Parser)
    params = vec_new<Param>();
    when !_check(p, TokenKind.RParen) and !_check(p, TokenKind.EOF) loop
        name_tok = _expect(p, TokenKind.Ident);
        _expect(p, TokenKind.Colon);
        ty = _parse_type(p);
        case name_tok;
        Ok(t):
                vec_push<Param>(&params, Param (;
                    name = t.text, type_ = ty,
                    default_ = None, span = t.span
    ));
            case Err(_) ()
        end
        if ! do _match(p, TokenKind.Comma) break end
    end
    out params;
end
func _parse_type:
    in(p:Parser)
    tok = _advance(p);
    if tok.kind == TokenKind.Ampersand do
        out TypeNode.Ref(_parse_type(p));
    end
    if tok.kind == TokenKind.Ident do
        # Check for generic: Name<T>
        if _match(p, TokenKind.Lt) do
            args = vec_new<TypeNode>();
            loop
                vec_push<TypeNode>(&args, _parse_type(p));
                if ! do _match(p, TokenKind.Comma) break end
            end
            _expect(p, TokenKind.Gt);
            out TypeNode.Generic(tok.text, args);
        end
        out TypeNode.Named(tok.text);
    end
    out TypeNode.Infer;
end
func _parse_block:
    in(p:Parser)
    # Simplified: parse statements until 'end'
    stmts = vec_new<Stmt>();
    when !_check(p, TokenKind.KwHết) and !_check(p, TokenKind.EOF) loop
        stmt = _parse_stmt(p);
        vec_push<Stmt>(&stmts, stmt);
    end
    _match(p, TokenKind.KwHết);
    out stmts;
end
func _parse_stmt:
    in(p:Parser)
    k = _peek_kind(p);
    case k;
        case TokenKind.KwBiến out _parse_let_stmt(p)
        case TokenKind.KwTrảVề out _parse_return_stmt(p)
        case TokenKind.KwThoát
            t = _advance(p); out Stmt.Break(t.span);
        case TokenKind.KwTiếpTục
            t = _advance(p); out Stmt.Continue(t.span);
        default;
            expr = _parse_expr(p);
            out Stmt.ExprStmt(expr, _peek(p).span);
    end
end
func _parse_let_stmt:
    in(p:Parser)
    kw = _advance(p)   # var;
    name_tok = _advance(p);
    ty = None;
    if _match(p, TokenKind.Colon) do ty = Some(_parse_type(p)) end
    init = None;
    if _match(p, TokenKind.Eq) do init = Some(_parse_expr(p)) end
    out Stmt.Let(name_tok.text, ty, init, kw.span);
end
func _parse_return_stmt:
    in(p:Parser)
    kw = _advance(p)   # out;
    if _check(p, TokenKind.KwHết) or _check(p, TokenKind.EOF) do
        out Stmt.Return(None, kw.span);
    end
    out Stmt.Return(Some(_parse_expr(p)), kw.span);
end
func _parse_expr:
    in(p:Parser)
    # Simplified expression parser — Pratt parsing for full impl
    tok = _advance(p);
    case tok.kind;
        case TokenKind.IntLiteral
            out Expr.IntLit(str_to_i64(tok.text), tok.span);
        case TokenKind.FloatLiteral
            out Expr.FloatLit(str_to_f64(tok.text), tok.span);
        case TokenKind.StringLiteral
            out Expr.StrLit(tok.text, tok.span);
        case TokenKind.KwĐúng
            out Expr.BoolLit(true, tok.span);
        case TokenKind.KwSai
            out Expr.BoolLit(false, tok.span);
        case TokenKind.Ident
            # Check for function call
            if _check(p, TokenKind.LParen) do
                _advance(p);
                args = vec_new<Expr>();
                when !_check(p, TokenKind.RParen) and !_check(p, TokenKind.EOF) loop
                    vec_push<Expr>(&args, _parse_expr(p));
                    _match(p, TokenKind.Comma);
                end
                _expect(p, TokenKind.RParen);
                out Expr.Call(Expr.Ident(tok.text, tok.span), args, tok.span);
            end
            out Expr.Ident(tok.text, tok.span);
        default;
            out Expr.NullLit(tok.span);
    end
end