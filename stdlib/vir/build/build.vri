/*
 * vir/build/build.vri — Build System
 * =====================================
 * Phase D — compile Vir projects
 *
 * Inspired by: cargo build, make, meson
 */

import "vir/core/types" use all
import "vir/core/option" use Option, Some, None
import "vir/core/result" use Result, Ok, Err
import "vir/str/string" use String, str_new, str_concat, str_eq
import "vir/collections/vec" use Vec, vec_new, vec_push, vec_len, vec_get
import "vir/collections/map" use Map, map_new, map_set, map_get
import "vir/fs/fs" use exists, create_dir_all
import "vir/path/path" use path_join
import "vir/io/stdio" use println
import "vir/process/process" use Command, cmd_new, cmd_arg, cmd_output
import "vir/pkg/pkg" use Manifest, SemVer

# ═══════════════════════════════════════════════════════
# Build Configuration
# ═══════════════════════════════════════════════════════

enum BuildMode
    Debug   = 0
    Release = 1
end

enum Target
    Native      = 0
    Wasm32      = 1
    Aarch64     = 2
    X86_64      = 3
end

entity BuildConfig
    mode:        BuildMode
    target:      Target
    out_dir:     String
    src_dir:     String
    opt_level:   i32        # 0-3
    debug_info:  bool
    link_libs:   Vec<String>
    defines:     Map<String, String>
end

func build_config_debug() -> BuildConfig
    out BuildConfig {
        mode = BuildMode.Debug,
        target = Target.Native,
        out_dir = str_new("build/debug"),
        src_dir = str_new("src"),
        opt_level = 0,
        debug_info = true,
        link_libs = vec_new<String>(),
        defines = map_new<String, String>()
    }
end

func build_config_release() -> BuildConfig
    out BuildConfig {
        mode = BuildMode.Release,
        target = Target.Native,
        out_dir = str_new("build/release"),
        src_dir = str_new("src"),
        opt_level = 2,
        debug_info = false,
        link_libs = vec_new<String>(),
        defines = map_new<String, String>()
    }
end

# ═══════════════════════════════════════════════════════
# Build Steps
# ═══════════════════════════════════════════════════════

enum BuildStep
    Parse      = 1
    TypeCheck  = 2
    IRGen      = 3
    Optimize   = 4
    CodeGen    = 5
    Link       = 6
end

entity BuildResult
    success:    bool
    output:     String       # executable path
    errors:     Vec<String>
    warnings:   Vec<String>
    step_times: Map<String, u64>   # step name -> nanoseconds
end

# ═══════════════════════════════════════════════════════
# Build Driver
# ═══════════════════════════════════════════════════════

func build(manifest: Manifest, config: BuildConfig) -> Result<BuildResult, String>
    println(str_concat(str_new("Building "), manifest.name))
    println(str_concat(str_new("  version: "), semver_to_string(manifest.version)))
    println(str_concat(str_new("  mode: "), if config.mode == BuildMode.Debug str_new("debug") else str_new("release") end))
    
    # Ensure output directory exists
    var mkdir_result = create_dir_all(config.out_dir)
    chọn mkdir_result
        case Err(e) out Err(e)
        case Ok(_) {}
    end
    
    var errors = vec_new<String>()
    var warnings = vec_new<String>()
    var times = map_new<String, u64>()
    
    # Step 1: Discover source files
    var sources = _discover_sources(config.src_dir)
    println(str_concat(str_new("  sources: "), int_to_string(vec_len<String>(sources))))
    
    # Steps 2-5: invoke vir compiler phases
    # Each step is delegated to native compiler (virc)
    var virc = cmd_new(str_new("virc"))
    cmd_arg(&virc, str_new("build"))
    cmd_arg(&virc, str_new("--src"))
    cmd_arg(&virc, config.src_dir)
    cmd_arg(&virc, str_new("--out"))
    cmd_arg(&virc, config.out_dir)
    cmd_arg(&virc, str_new("-O"))
    cmd_arg(&virc, int_to_string(config.opt_level))
    
    if config.debug_info cmd_arg(&virc, str_new("-g")) end
    
    # Add link libraries
    var i: usize = 0
    lặp_khi i < vec_len<String>(config.link_libs)
        cmd_arg(&virc, str_new("-l"))
        cmd_arg(&virc, vec_get<String>(config.link_libs, i))
        i = i + 1
    end
    
    var output_result = cmd_output(virc)
    chọn output_result
        case Err(e) out Err(e)
        case Ok(out)
            if out.status != 0
                vec_push<String>(&errors, out.stderr)
                out Ok(BuildResult {
                    success = false,
                    output = str_new(""),
                    errors = errors, warnings = warnings,
                    step_times = times
                })
            end
    end
    
    var exe_path = path_join(config.out_dir, manifest.name)
    println(str_concat(str_new("  output: "), exe_path))
    
    out Ok(BuildResult {
        success = true,
        output = exe_path,
        errors = errors, warnings = warnings,
        step_times = times
    })
end

func _discover_sources(dir: String) -> Vec<String>
    # TODO: recursively find *.vri files
    var sources = vec_new<String>()
    out sources
end

# ═══════════════════════════════════════════════════════
# Build Commands
# ═══════════════════════════════════════════════════════

func build_and_run(manifest: Manifest, config: BuildConfig, args: Vec<String>) -> Result<i32, String>
    var result = build(manifest, config)
    chọn result
        case Err(e) out Err(e)
        case Ok(br)
            if !br.success out Err(str_new("build failed")) end
            var run = cmd_new(br.output)
            var i: usize = 0
            lặp_khi i < vec_len<String>(args)
                cmd_arg(&run, vec_get<String>(args, i))
                i = i + 1
            end
            var out = cmd_output(run)
            chọn out
                case Err(e) out Err(e)
                case Ok(o) out Ok(o.status)
            end
    end
end

func clean(config: BuildConfig) -> Result<void, String>
    var rm = cmd_new(str_new("rm"))
    cmd_arg(&rm, str_new("-rf"))
    cmd_arg(&rm, config.out_dir)
    var out = cmd_output(rm)
    chọn out
        case Err(e) out Err(e)
        case Ok(_) out Ok(())
    end
end
