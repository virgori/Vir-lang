##
 * vir/build/build.vri — Build System
 * =====================================
 * Phase D — compile Vir projects
 *
 * Inspired by: cargo build, make, meson
 ##

include types;
include option;
import Option, Some, None from option;
include result;
import Result, Ok, Err from result;
include string;
import String, str_new, str_concat, str_eq from string;
include vec;
import Vec, vec_new, vec_push, vec_len, vec_get from vec;
include map;
import Map, map_new, map_set, map_get from map;
include fs;
import exists, create_dir_all from fs;
include path;
import path_join from path;
include stdio;
import println from stdio;
include process;
import Command, cmd_new, cmd_arg, cmd_output from process;
include pkg;
import Manifest, SemVer from pkg;

# ═══════════════════════════════════════════════════════
# Build Configuration
# ═══════════════════════════════════════════════════════

enum BuildMode:
    Debug   = 0;
    Release = 1;
end.

enum Target:
    Native      = 0;
    Wasm32      = 1;
    Aarch64     = 2;
    X86_64      = 3;
end.

entity BuildConfig:
    mode:        BuildMode,
        target:      Target,
        out_dir:     string,
        src_dir:     string,
        opt_level:   int        # 0-3,
        debug_info:  bool,
        link_libs:   Vec<string>,
        defines:     Map<string, string>;
end.

func build_config_debug:
    out BuildConfig {;
        mode = BuildMode.Debug,
        target = Target.Native,
        out_dir = str_new("build/debug"),
        src_dir = str_new("src"),
        opt_level = 0,
        debug_info = true,
        link_libs = vec_new<string>(),
        defines = map_new<string, string>()
    };
end.

func build_config_release:
    out BuildConfig {;
        mode = BuildMode.Release,
        target = Target.Native,
        out_dir = str_new("build/release"),
        src_dir = str_new("src"),
        opt_level = 2,
        debug_info = false,
        link_libs = vec_new<string>(),
        defines = map_new<string, string>()
    };
end

# ═══════════════════════════════════════════════════════
# Build Steps
# ═══════════════════════════════════════════════════════

enum BuildStep:
    Parse      = 1;
    TypeCheck  = 2;
    IRGen      = 3;
    Optimize   = 4;
    CodeGen    = 5;
    Link       = 6;
end.

entity BuildResult:
    success:    bool,
        output:     string       # executable path,
        errors:     Vec<string>,
        warnings:   Vec<string>,
        step_times: Map<string, int>   # step name -> nanoseconds;
end

# ═══════════════════════════════════════════════════════
# Build Driver
# ═══════════════════════════════════════════════════════

func build:
    in(manifest:Manifest; config:BuildConfig)
    println(str_concat(str_new("Building "), manifest.name));
    println(str_concat(str_new("  version: "), semver_to_string(manifest.version)));
    println(str_concat(str_new("  mode: "), if config.mode == BuildMode.Debug str_new("debug") else str_new("release") end));
    
    # Ensure output directory exists
    mkdir_result = create_dir_all(config.out_dir);
    case mkdir_result;
        Err(e): out Err(e);
        case Ok(_) {}
    end
    
    errors = vec_new<string>();
    warnings = vec_new<string>();
    times = map_new<string, int>();
    
    # Step 1: Discover source files
    sources = _discover_sources(config.src_dir);
    println(str_concat(str_new("  sources: "), int_to_string(vec_len<string>(sources))));
    
    # Steps 2-5: invoke vir compiler phases
    # Each step is delegated to native compiler (virc)
    virc = cmd_new(str_new("virc"));
    cmd_arg(&virc, str_new("build"));
    cmd_arg(&virc, str_new("--src"));
    cmd_arg(&virc, config.src_dir);
    cmd_arg(&virc, str_new("--out"));
    cmd_arg(&virc, config.out_dir);
    cmd_arg(&virc, str_new("-O"));
    cmd_arg(&virc, int_to_string(config.opt_level));
    
    if config.debug_info do cmd_arg(&virc, str_new("-g")) end
    
    # Add link libraries
    i = 0;
    when i < vec_len<String>(config.link_libs) loop
        cmd_arg(&virc, str_new("-l"));
        cmd_arg(&virc, vec_get<string>(config.link_libs, i));
        i = i + 1;
    end
    
    output_result = cmd_output(virc);
    case output_result;
        Err(e): out Err(e);
        Ok(out):
            if out.status != 0 do
                vec_push<string>(&errors, out.stderr);
                out Ok(BuildResult {;
                    success = false,
                    output = str_new(""),
                    errors = errors, warnings = warnings,
                    step_times = times
    });
            end
    end
    
    exe_path = path_join(config.out_dir, manifest.name);
    println(str_concat(str_new("  output: "), exe_path));
    
    out Ok(BuildResult {;
        success = true,
        output = exe_path,
        errors = errors, warnings = warnings,
        step_times = times
    });
end.

func _discover_sources:
    in(dir:string)
    # TODO: recursively find *.vri files
    sources = vec_new<string>();
    out sources;
end

# ═══════════════════════════════════════════════════════
# Build Commands
# ═══════════════════════════════════════════════════════

func build_and_run:
    in(manifest:Manifest; config:BuildConfig; args:Vec<string>)
    result = build(manifest, config);
    case result;
        Err(e): out Err(e);
        Ok(br):
            if !br.success do out Err(str_new("build failed")) end
            run = cmd_new(br.output);
            i = 0;
            when i < vec_len<String>(args) loop
                cmd_arg(&run, vec_get<string>(args, i));
                i = i + 1;
            end
            out = cmd_output(run);
            case out;
        Err(e): out Err(e);
        Ok(o): out Ok(o.status);
            end
    end
end.

func clean:
    in(config:BuildConfig)
    rm = cmd_new(str_new("rm"));
    cmd_arg(&rm, str_new("-rf"));
    cmd_arg(&rm, config.out_dir);
    out = cmd_output(rm);
    case out;
        Err(e): out Err(e);
        Ok(_): out Ok(());
    end
end
