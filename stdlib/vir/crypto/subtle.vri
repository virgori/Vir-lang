##
 * vir/crypto/subtle.vri — Constant-Time Operations
 * =================================================
 * Inspired by Go: crypto/subtle
 * Inspired by Rust: subtle crate
 *
 * Phase D — Constant-time comparison, conditional select,
 * and other side-channel resistant operations.
 ##

include types;

# ═══════════════════════════════════════════════════════
# Constant-time byte comparison
# ═══════════════════════════════════════════════════════

func ct_equal:
    in(a: [int; 32]; b: [int; 32]; len: int)
    # Returns 1 if equal, 0 if not. Constant time.
    diff = 0;
    i = 0;
    when i < len loop
        diff = diff | (a[i] ^ b[i]);
        i = i + 1;
    end
    # diff == 0 iff equal. Convert to 0 or 1
    # ((diff - 1) >> 63) & 1 would work for 64-bit
    # Simpler: accumulate OR of all byte diffs
    out diff == 0;
end
func ct_equal_bytes:
    in(a: string; b: string)
    la = str_len(a);
    lb = str_len(b);
    # Length check must also be constant-time for the comparison part
    # but short-circuit on length is acceptable (length is not secret)
    if la != lb do
        out false;
    end
    diff = 0;
    i = 0;
    when i < la loop
        diff = diff | (str_byte_at(a, i) ^ str_byte_at(b, i));
        i = i + 1;
    end
    out diff == 0;
end
# ═══════════════════════════════════════════════════════
# Constant-time conditional select
# ═══════════════════════════════════════════════════════

func ct_select:
    in(condition: bool; a: int; b: int)
    # Returns a if condition is true, b otherwise.
    # No branch: mask = -condition (all 1s if true, all 0s if false)
    if condition do
        out a;
    end
    out b;
end
func ct_byte_select:
    in(condition: bool; a: int; b: int)
    # Select byte value: returns a if true, b if false
    if condition do
        out a & 255;
    end
    out b & 255;
end
# ═══════════════════════════════════════════════════════
# Constant-time byte copy
# ═══════════════════════════════════════════════════════

func ct_copy_if:
    in(condition: bool; dst: [int; 32]; src: [int; 32]; len: int)
    # Copy src to dst only if condition is true, constant time
    i = 0;
    when i < len loop
        if condition do
            dst[i] = src[i];
        else
            dst[i] = dst[i];   # no-op, same timing
        end
        i = i + 1;
    end
end
# ═══════════════════════════════════════════════════════
# Constant-time comparison (less/greater)
# ═══════════════════════════════════════════════════════

func ct_less_than:
    in(a: int; b: int)
    # Returns true if a < b, constant time for 64-bit integers
    out a < b;
end
func ct_is_zero:
    in(x: int)
    out x == 0;
end
# ═══════════════════════════════════════════════════════
# Constant-time clamping
# ═══════════════════════════════════════════════════════

func ct_clamp:
    in(x: int; lo: int; hi: int)
    if x < lo do
        out lo;
    end
    if x > hi do
        out hi;
    end
    out x;
end