# AES Round Constants
hằng_số AES_RCON: [int; 11] = [;
    0x00, 0x01, 0x02, 0x04, 0x08, 0x10,
    0x20, 0x40, 0x80, 0x1B, 0x36;
];

# ═══════════════════════════════════════════════════════
# AES Key Schedule
# ═══════════════════════════════════════════════════════

entity AesKey:
    round_keys: [int; 240];    # max 15 rounds × 16 bytes = 240
    nr: int;                    # number of rounds (10, 12, or 14)
end
func _aes_sub_word:
    in(w: int)
    out (AES_SBOX[(w >> 24) & 0xFF] << 24);
      | (AES_SBOX[(w >> 16) & 0xFF] << 16);
      | (AES_SBOX[(w >> 8) & 0xFF] << 8);
      | AES_SBOX[w & 0xFF];
end
func _aes_rot_word:
    in(w: int)
    out ((w << 8) & 0xFFFFFFFF) | ((w >> 24) & 0xFF);
end
func aes_key_expand:
    in(key: [int]; key_len: int)
    # key_len: 16 = AES-128, 24 = AES-192, 32 = AES-256
    nk = key_len / 4;
    if nk == 4 do nr = 10 eif nk == 6 nr = 12 else nr = 14 end
    
    ctx = AesKey ( nr: nr );
    
    # Copy key into first nk words
    i = 0;
    when i < nk loop
        ctx.round_keys[i * 4]     = key[i * 4];
        ctx.round_keys[i * 4 + 1] = key[i * 4 + 1];
        ctx.round_keys[i * 4 + 2] = key[i * 4 + 2];
        ctx.round_keys[i * 4 + 3] = key[i * 4 + 3];
        i = i + 1;
    end
    
    # Expand
    total_words = 4 * (nr + 1);
    i = nk;
    when i < total_words loop
        # Pack previous word
        prev = (ctx.round_keys[(i - 1) * 4] << 24);
             | (ctx.round_keys[(i - 1) * 4 + 1] << 16);
             | (ctx.round_keys[(i - 1) * 4 + 2] << 8);
             | ctx.round_keys[(i - 1) * 4 + 3];
        
        if i % nk == 0 do
            prev = _aes_sub_word(_aes_rot_word(prev)) ^ (AES_RCON[i / nk] << 24);
        eif nk > 6 and i % nk == 4 do
            prev = _aes_sub_word(prev);
        end
        
        # XOR with word nk positions back
        back = (ctx.round_keys[(i - nk) * 4] << 24);
             | (ctx.round_keys[(i - nk) * 4 + 1] << 16);
             | (ctx.round_keys[(i - nk) * 4 + 2] << 8);
             | ctx.round_keys[(i - nk) * 4 + 3];
        
        w = prev ^ back;
        ctx.round_keys[i * 4]     = (w >> 24) & 0xFF;
        ctx.round_keys[i * 4 + 1] = (w >> 16) & 0xFF;
        ctx.round_keys[i * 4 + 2] = (w >> 8) & 0xFF;
        ctx.round_keys[i * 4 + 3] = w & 0xFF;
        i = i + 1;
    end
    
    out ctx;
end
# ═══════════════════════════════════════════════════════
# AES Core — Single Block Encrypt/Decrypt
# ═══════════════════════════════════════════════════════

func _xtime:
    in(a: int)
    out ((a << 1) ^ (if (a & 0x80) != 0 do 0x1B else 0x00 end)) & 0xFF;
end
func _gf_mul:
    in(a: int; b: int)
    result = 0;
    aa = a;
    bb = b;
    when bb > 0 loop
        if (bb & 1) != 0 do result = result ^ aa end
        aa = _xtime(aa);
        bb = bb >> 1;
    end
    out result & 0xFF;
end
func aes_encrypt_block:
    in(ctx: AesKey; input: [int]; output: [int])
    # State is 4×4 column-major byte matrix
    var state: [int; 16];
    i = 0;
    when i < 16 loop state[i] = input[i]; i = i + 1 end
    
    # Initial round key addition
    _aes_add_round_key(state, ctx.round_keys, 0);
    
    # Main rounds
    r = 1;
    when r < ctx.nr loop
        _aes_sub_bytes(state);
        _aes_shift_rows(state);
        _aes_mix_columns(state);
        _aes_add_round_key(state, ctx.round_keys, r * 16);
        r = r + 1;
    end
    
    # Final round (no MixColumns)
    _aes_sub_bytes(state);
    _aes_shift_rows(state);
    _aes_add_round_key(state, ctx.round_keys, ctx.nr * 16);
    
    i = 0;
    when i < 16 loop output[i] = state[i]; i = i + 1 end
end
func _aes_sub_bytes:
    in(state: [int; 16])
    i = 0;
    when i < 16 loop
        state[i] = AES_SBOX[state[i]];
        i = i + 1;
    end
end
func _aes_shift_rows:
    in(s: [int; 16])
    # Row 1: shift left 1
    t = s[1]; s[1] = s[5]; s[5] = s[9]; s[9] = s[13]; s[13] = t;
    # Row 2: shift left 2
    t = s[2]; s[2] = s[10]; s[10] = t;
    t = s[6]; s[6] = s[14]; s[14] = t;
    # Row 3: shift left 3 (= shift right 1)
    t = s[15]; s[15] = s[11]; s[11] = s[7]; s[7] = s[3]; s[3] = t;
end
func _aes_mix_columns:
    in(s: [int; 16])
    c = 0;
    when c < 4 loop
        i = c * 4;
        a0 = s[i]; a1 = s[i+1]; a2 = s[i+2]; a3 = s[i+3];
        s[i]   = _xtime(a0) ^ (_xtime(a1) ^ a1) ^ a2 ^ a3;
        s[i+1] = a0 ^ _xtime(a1) ^ (_xtime(a2) ^ a2) ^ a3;
        s[i+2] = a0 ^ a1 ^ _xtime(a2) ^ (_xtime(a3) ^ a3);
        s[i+3] = (_xtime(a0) ^ a0) ^ a1 ^ a2 ^ _xtime(a3);
        c = c + 1;
    end
end
func _aes_add_round_key:
    in(state: [int; 16]; rk: [int]; offset: int)
    i = 0;
    when i < 16 loop
        state[i] = state[i] ^ rk[offset + i];
        i = i + 1;
    end
end
# ═══════════════════════════════════════════════════════
# AES-CTR Mode — Stream cipher from block cipher
# ═══════════════════════════════════════════════════════

func aes_ctr_encrypt:
    in(ctx: AesKey; nonce: [int]; data: [int]; data_len: int; output: [int])
    # nonce: 12 bytes. Counter is nonce || 32-bit big-endian counter.
    var counter_block: [int; 16];
    i = 0;
    when i < 12 loop counter_block[i] = nonce[i]; i = i + 1 end
    counter_block[12] = 0; counter_block[13] = 0;
    counter_block[14] = 0; counter_block[15] = 1;
    
    var keystream: [int; 16];
    offset = 0;
    
    when offset < data_len loop
        aes_encrypt_block(ctx, counter_block, keystream);
        
        j = 0;
        when j < 16 and offset + j < data_len loop
            output[offset + j] = data[offset + j] ^ keystream[j];
            j = j + 1;
        end
        
        # Increment counter (big-endian)
        counter_block[15] = counter_block[15] + 1;
        if counter_block[15] > 255 do
            counter_block[15] = 0;
            counter_block[14] = counter_block[14] + 1;
            if counter_block[14] > 255 do
                counter_block[14] = 0;
                counter_block[13] = counter_block[13] + 1;
            end
        end
        
        offset = offset + 16;
    end
end
# AES-CTR decrypt is same as encrypt (XOR is self-inverse)
func aes_ctr_decrypt:
    in(ctx: AesKey; nonce: [int]; data: [int]; data_len: int; output: [int])
    aes_ctr_encrypt(ctx, nonce, data, data_len, output);
end
# ═══════════════════════════════════════════════════════
# AES-GCM — Authenticated Encryption (AEAD)
# ═══════════════════════════════════════════════════════

entity AesGcmResult:
    ciphertext: Vec,
        tag: [int; 16];
end
func _ghash_mul:
    in(x: [int; 16]; y: [int; 16]; out: [int; 16])
    # GF(2^128) multiplication for GHASH
    var v: [int; 16];
    i = 0;
    when i < 16 loop v[i] = y[i]; out[i] = 0; i = i + 1 end
    
    i = 0;
    when i < 16 loop
        j = 0;
        when j < 8 loop
            if (x[i] >> (7 - j)) & 1 == 1 do
                k = 0;
                when k < 16 loop
                    out[k] = out[k] ^ v[k];
                    k = k + 1;
                end
            end
            
            # v >>= 1 in GF(2^128)
            carry = v[15] & 1;
            k = 15;
            when k > 0 loop
                v[k] = ((v[k] >> 1) | ((v[k - 1] & 1) << 7)) & 0xFF;
                k = k - 1;
            end
            v[0] = (v[0] >> 1) & 0xFF;
            if carry == 1 do
                v[0] = v[0] ^ 0xE1;    # reduction polynomial
            end
            
            j = j + 1;
        end
        i = i + 1;
    end
end
func aes_gcm_encrypt:
    in(ctx: AesKey; nonce: [int]; plaintext: [int]; pt_len: int,
        aad: [int]; aad_len: int)
    # 1. Generate hash subkey H = AES(K, 0^128)
    var zero: [int; 16];
    var H: [int; 16];
    mem_set(zero, 0, 16);
    aes_encrypt_block(ctx, zero, H);
    
    # 2. Compute initial counter J0
    var J0: [int; 16];
    i = 0;
    when i < 12 loop J0[i] = nonce[i]; i = i + 1 end
    J0[12] = 0; J0[13] = 0; J0[14] = 0; J0[15] = 1;
    
    # 3. Encrypt plaintext with CTR (starting from J0 + 1)
    result = AesGcmResult ( ciphertext: vec_new(), tag: [0; 16] );
    var ct_buf: [int; pt_len];
    var J1: [int; 16];
    mem_copy(J1, J0, 16);
    _inc32(J1);
    aes_ctr_encrypt(ctx, nonce, plaintext, pt_len, ct_buf);
    
    i = 0;
    when i < pt_len loop
        vec_push(result.ciphertext, ct_buf[i]);
        i = i + 1;
    end
    
    # 4. Compute GHASH over AAD || ciphertext || lengths
    var tag: [int; 16];
    mem_set(tag, 0, 16);
    _ghash_update(tag, H, aad, aad_len);
    _ghash_update(tag, H, ct_buf, pt_len);
    
    # Append lengths (in bits, big-endian 64-bit)
    var len_block: [int; 16];
    mem_set(len_block, 0, 16);
    aad_bits = aad_len * 8;
    pt_bits = pt_len * 8;
    len_block[4]  = (aad_bits >> 24) & 0xFF;
    len_block[5]  = (aad_bits >> 16) & 0xFF;
    len_block[6]  = (aad_bits >> 8)  & 0xFF;
    len_block[7]  = aad_bits & 0xFF;
    len_block[12] = (pt_bits >> 24) & 0xFF;
    len_block[13] = (pt_bits >> 16) & 0xFF;
    len_block[14] = (pt_bits >> 8)  & 0xFF;
    len_block[15] = pt_bits & 0xFF;
    _ghash_block(tag, H, len_block);
    
    # 5. Tag = GHASH ^ AES(K, J0)
    var enc_j0: [int; 16];
    aes_encrypt_block(ctx, J0, enc_j0);
    i = 0;
    when i < 16 loop
        result.tag[i] = tag[i] ^ enc_j0[i];
        i = i + 1;
    end
    
    out result;
end
func _inc32:
    in(block: [int; 16])
    block[15] = block[15] + 1;
    if block[15] > 255 do
        block[15] = 0;
        block[14] = block[14] + 1;
    end
end
func _ghash_update:
    in(tag: [int; 16]; H: [int; 16]; data: [int]; data_len: int)
    offset = 0;
    when offset + 16 <= data_len loop
        _ghash_block(tag, H, data + offset);
        offset = offset + 16;
    end
    if offset < data_len do
        var padded: [int; 16];
        mem_set(padded, 0, 16);
        i = 0;
        when offset + i < data_len loop
            padded[i] = data[offset + i];
            i = i + 1;
        end
        _ghash_block(tag, H, padded);
    end
end
func _ghash_block:
    in(tag: [int; 16]; H: [int; 16]; block: [int; 16])
    i = 0;
    when i < 16 loop tag[i] = tag[i] ^ block[i]; i = i + 1 end
    var tmp: [int; 16];
    _ghash_mul(tag, H, tmp);
    i = 0;
    when i < 16 loop tag[i] = tmp[i]; i = i + 1 end
end
# ═══════════════════════════════════════════════════════
# Convenience — encrypt/decrypt with key bytes
# ═══════════════════════════════════════════════════════

func aes128_encrypt:
    in(key: [int; 16]; nonce: [int; 12]; plaintext: [int]; pt_len: int)
    ctx = aes_key_expand(key, 16);
    out aes_gcm_encrypt(ctx, nonce, plaintext, pt_len, [], 0);
end
func aes256_encrypt:
    in(key: [int; 32]; nonce: [int; 12]; plaintext: [int]; pt_len: int)
    ctx = aes_key_expand(key, 32);
    out aes_gcm_encrypt(ctx, nonce, plaintext, pt_len, [], 0);
end
# ─── Constant-time compare for authentication tags ────

func constant_time_eq:
    in(a: [int]; b: [int]; len: int)
    diff = 0;
    i = 0;
    when i < len loop
        diff = diff | (a[i] ^ b[i]);
        i = i + 1;
    end
    out diff == 0;
end
# ═══════════════════════════════════════════════════════
# Hardware AES-NI (constant-time, no cache side-channel)
# ═══════════════════════════════════════════════════════

extern func native_has_aes_ni() -> bool;
extern func native_aes_ni_encrypt(key: ptr; nr: int; input: ptr; output: ptr);
extern func native_aes_ni_decrypt(key: ptr; nr: int; input: ptr; output: ptr);

func aes_encrypt_block_hw:
    in(ctx: AesKey; input: [int]; output: [int])
    # Prefer AES-NI if available (constant-time, ~10x faster)
    if native_has_aes_ni() do
        native_aes_ni_encrypt(&ctx.round_keys, ctx.nr, &input, &output);
    else
        aes_encrypt_block(ctx, input, output);
    end
end