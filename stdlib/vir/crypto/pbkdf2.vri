##
 * vir/crypto/pbkdf2.vri — PBKDF2 Key Derivation (RFC 8018)
 * ==========================================================
 * Inspired by Rust: pbkdf2 crate (RustCrypto)
 * Inspired by Python: hashlib.pbkdf2_hmac
 * Inspired by Go: golang.org/x/crypto/pbkdf2
 *
 * Phase C — Tier 2: PBKDF2-HMAC-SHA256 password hashing.
 * Derives a key from password + salt + iteration count.
 * Output length up to 256 bytes (8 blocks of SHA-256).
 ##

include types;
include crypto/crypto;
import sha256_new, sha256_update, sha256_finish, sha256_hash,
       hmac_sha256 from crypto/crypto;

# ═══════════════════════════════════════════════════════
# PBKDF2-HMAC-SHA256
# ═══════════════════════════════════════════════════════
#
# DK = T1 || T2 || ... || T_dklen/hlen
# T_i = U_1 XOR U_2 XOR ... XOR U_c
# U_1 = PRF(password, salt || INT_32_BE(i))
# U_j = PRF(password, U_{j-1})
#
# PRF = HMAC-SHA256 (hlen = 32)
# ═══════════════════════════════════════════════════════

const PBKDF2_HASH_LEN = 32;
const PBKDF2_MAX_DK_LEN = 256;

func pbkdf2_sha256:
    in  password: [int];
        pass_len: int;
        salt: [int];
        salt_len: int;
        iterations: int;
        dk_len: int

    # Clamp dk_len
    actual_len = dk_len;
    if actual_len > PBKDF2_MAX_DK_LEN do
        actual_len = PBKDF2_MAX_DK_LEN;
    end

    var dk: [int; 256] = [0; 256];
    num_blocks = (actual_len + PBKDF2_HASH_LEN - 1) / PBKDF2_HASH_LEN;

    block_idx = 1;
    dk_offset = 0;
    when block_idx <= num_blocks loop
        # Build salt || INT_32_BE(block_idx)
        var salt_ext: [int; 1024] = [0; 1024];
        mem_copy(&salt_ext, salt, salt_len);
        salt_ext[salt_len]     = (block_idx / 16777216) % 256;
        salt_ext[salt_len + 1] = (block_idx / 65536) % 256;
        salt_ext[salt_len + 2] = (block_idx / 256) % 256;
        salt_ext[salt_len + 3] = block_idx % 256;
        ext_len = salt_len + 4;

        # U_1 = HMAC(password, salt || INT_32_BE(i))
        u = hmac_sha256(password, pass_len, &salt_ext, ext_len);

        # T = U_1
        var t: [int; 32];
        mem_copy(&t, &u, 32);

        # U_2 ... U_c
        iter = 1;
        when iter < iterations loop
            u = hmac_sha256(password, pass_len, &u, 32);
            # T = T XOR U_j
            j = 0;
            when j < 32 loop
                t[j] = t[j] ^ u[j];
                j = j + 1;
            end
            iter = iter + 1;
        end

        # Copy T into dk
        copy_len = 32;
        remaining = actual_len - dk_offset;
        if copy_len > remaining do
            copy_len = remaining;
        end
        j = 0;
        when j < copy_len loop
            dk[dk_offset + j] = t[j];
            j = j + 1;
        end

        dk_offset = dk_offset + copy_len;
        block_idx = block_idx + 1;
    end

    # Return result as fixed-size (caller uses dk_len to know length)
    out dk;
end.
# ═══════════════════════════════════════════════════════
# Convenience: password string hashing
# ═══════════════════════════════════════════════════════

func pbkdf2_hash_password:
    in  password: [int];
        pass_len: int;
        salt: [int];
        salt_len: int;
        iterations: int
    # Default: 32 bytes output (256-bit key)
    out pbkdf2_sha256(password, pass_len, salt, salt_len, iterations, 32);
end.
# ═══════════════════════════════════════════════════════
# Constant-time comparison (prevent timing attacks)
# ═══════════════════════════════════════════════════════

func pbkdf2_verify:
    in  password: [int];
        pass_len: int;
        salt: [int];
        salt_len: int;
        iterations: int;
        expected: [int];
        expected_len: int

    derived = pbkdf2_sha256(password, pass_len, salt, salt_len, iterations, expected_len);

    # Constant-time compare
    diff = 0;
    i = 0;
    when i < expected_len loop
        diff = diff | (derived[i] ^ expected[i]);
        i = i + 1;
    end
    out diff == 0;
end.
# ═══════════════════════════════════════════════════════
# HKDF-SHA256 (RFC 5869) — Extract-and-Expand
# ═══════════════════════════════════════════════════════

# HKDF-Extract: PRK = HMAC-SHA256(salt, IKM)
func hkdf_extract:
    in  salt: [int];
        salt_len: int;
        ikm: [int];
        ikm_len: int
    # If salt not provided, use zero-filled 32-byte salt
    if salt_len == 0 do
        var zero_salt: [int; 32] = [0; 32];
        out hmac_sha256(&zero_salt, 32, ikm, ikm_len);
    end
    out hmac_sha256(salt, salt_len, ikm, ikm_len);
end.
# HKDF-Expand: OKM = T(1) || T(2) || ...
# T(0) = empty, T(i) = HMAC-SHA256(PRK, T(i-1) || info || i)
func hkdf_expand:
    in  prk: [int];
        prk_len: int;
        info: [int];
        info_len: int;
        out_len: int

    var okm: [int; 256] = [0; 256];
    actual = out_len;
    if actual > 256 do
        actual = 256;
    end

    num_blocks = (actual + 31) / 32;
    var prev: [int; 32] = [0; 32];
    prev_len = 0;

    block = 1;
    offset = 0;
    when block <= num_blocks loop
        # Build input: T(i-1) || info || byte(i)
        var input: [int; 1024] = [0; 1024];
        in_len = 0;

        # Copy previous T
        j = 0;
        when j < prev_len loop
            input[in_len] = prev[j];
            in_len = in_len + 1;
            j = j + 1;
        end

        # Copy info
        j = 0;
        when j < info_len loop
            input[in_len] = info[j];
            in_len = in_len + 1;
            j = j + 1;
        end

        # Append counter byte
        input[in_len] = block;
        in_len = in_len + 1;

        # T(i) = HMAC(PRK, input)
        t = hmac_sha256(prk, prk_len, &input, in_len);
        mem_copy(&prev, &t, 32);
        prev_len = 32;

        # Copy to output
        copy_len = 32;
        remaining = actual - offset;
        if copy_len > remaining do
            copy_len = remaining;
        end
        j = 0;
        when j < copy_len loop
            okm[offset + j] = t[j];
            j = j + 1;
        end
        offset = offset + copy_len;
        block = block + 1;
    end

    out okm;
end.
# ═══════════════════════════════════════════════════════
# Full HKDF: Extract then Expand
# ═══════════════════════════════════════════════════════

func hkdf:
    in  salt: [int];
        salt_len: int;
        ikm: [int];
        ikm_len: int;
        info: [int];
        info_len: int;
        out_len: int
    prk = hkdf_extract(salt, salt_len, ikm, ikm_len);
    out hkdf_expand(&prk, 32, info, info_len, out_len);
end.