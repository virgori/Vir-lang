##
 * vir/crypto — Cryptography package index
 * ========================================
 *
 * ⚠️  EXPERIMENTAL — NOT production-ready as a whole.
 *
 * Milestone 1 (include-clean on native virc, vectors for hash/hmac):
 *   crypto.hash / crypto.hmac / crypto.rng
 *
 * Still blocked / experimental: aes, chacha20, ed25519, x25519, x509, jwt,
 * rsa, subtle, pbkdf2, tls, auth.
 *
 * Non-crypto PRNG: vir/rand (xoshiro256**) — do NOT use for keys.
 ##

module vir.crypto

include crypto.hash
include crypto.hmac
include crypto.rng

import sha256, sha256_hash, sha256_hex, sha256_new, sha256_update, sha256_finish from crypto.hash
import sha512, sha512_hash, sha512_hex from crypto.hash
import hmac_sha256, hmac_sha256_hex, verify, hmac_sha256_verify from crypto.hmac
import bytes, fill, csprng_128, csprng_256, csprng_fill, crypto_random_bytes from crypto.rng

export sha256, sha256_hash, sha256_hex, sha512, sha512_hash, sha512_hex
export hmac_sha256, hmac_sha256_hex, verify, hmac_sha256_verify
export bytes, fill, csprng_128, csprng_256, csprng_fill, crypto_random_bytes
