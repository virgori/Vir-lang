##
 * vir/crypto/crypto.vri — Cryptographic Primitives
 * ===================================================
 * Inspired by Python: hashlib, hmac, secrets
 *
 * Phase C — hashing, HMAC, secure random
 * NOTE: SHA-256, SHA-512 implementations. For production TLS, use vir/tls.
 ##

include types;
include result;
import Result, Ok, Err from result;
include string;
import String, str_new from string;
include vec;
import Vec, vec_new, vec_push, vec_len, vec_get from vec;

# ═══════════════════════════════════════════════════════
# Secure Random
# ═══════════════════════════════════════════════════════

extern func native_getrandom(buf: ptr, len: int) -> int   # /dev/urandom or arc4random

func crypto_random_bytes:
    in(buf:[int]; len:int)
    rc = native_getrandom(buf, len);
    if rc != 0 do out Err(str_new("getrandom failed")) end
    out Ok(());
end.

func crypto_random_u64:
    var buf: [int; 8];
    native_getrandom(&buf, 8);
    out (buf[0] << 56) | (buf[1] << 48) | (buf[2] << 40) | (buf[3] << 32);
         | (buf[4] << 24) | (buf[5] << 16) | (buf[6] << 8) | buf[7];
end.

func crypto_random_range:
    in(min:int; max:int)
    # Rejection sampling to avoid modulo bias
    range = max - min;
    if range <= 0 do out min end
    
    mask = 0xFFFFFFFFFFFFFFFF;
    bits = range;
    # Find minimum bitmask
    bits = bits | (bits >> 1);
    bits = bits | (bits >> 2);
    bits = bits | (bits >> 4);
    bits = bits | (bits >> 8);
    bits = bits | (bits >> 16);
    bits = bits | (bits >> 32);
    mask = bits;
    
    loop
        val = crypto_random_u64() & mask;
        if val < range do
            out min + val;
        end
    end
end

# ═══════════════════════════════════════════════════════
# SHA-256
# ═══════════════════════════════════════════════════════

entity Sha256:
    h:        [int; 8],
        buf:      [int; 64],
        buf_len:  int,
        total:    int;
end

hằng_số SHA256_K: [int; 64] = [;
    0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5,
    0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
    0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3,
    0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
    0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc,
    0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
    0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7,
    0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
    0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13,
    0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
    0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3,
    0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
    0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5,
    0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
    0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208,
    0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2;
];

func sha256_new:
    out Sha256 (;
        h = [0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a,
             0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19],
        buf = [0; 64],
        buf_len = 0,
        total = 0
    );
end.

func sha256_update:
    in(ctx:Sha256; data:[int]; len:int)
    i = 0;
    when i < len loop
        ctx.buf[ctx.buf_len] = data[i];
        ctx.buf_len = ctx.buf_len + 1;
        if ctx.buf_len == 64 do
            _sha256_compress(ctx);
            ctx.buf_len = 0;
        end
        ctx.total = ctx.total + 1;
        i = i + 1;
    end
end.

func sha256_finish:
    in(ctx:Sha256)
    # Padding
    bit_len = ctx.total * 8;
    ctx.buf[ctx.buf_len] = 0x80;
    ctx.buf_len = ctx.buf_len + 1;
    
    if ctx.buf_len > 56 do
        when ctx.buf_len < 64 ctx.buf[ctx.buf_len] = 0; ctx.buf_len = ctx.buf_len + 1 end loop
        _sha256_compress(ctx);
        ctx.buf_len = 0;
    end
    when ctx.buf_len < 56 ctx.buf[ctx.buf_len] = 0; ctx.buf_len = ctx.buf_len + 1 end loop
    
    # Append length (big-endian 64-bit)
    j = 0;
    when j < 8 loop
        ctx.buf[56 + j] = (bit_len >> (56 - j * 8)) & 0xFF;
        j = j + 1;
    end
    _sha256_compress(ctx);
    
    # Output
    var out: [int; 32];
    j = 0;
    when j < 8 loop
        out[j * 4]     = (ctx.h[j] >> 24) & 0xFF;
        out[j * 4 + 1] = (ctx.h[j] >> 16) & 0xFF;
        out[j * 4 + 2] = (ctx.h[j] >> 8)  & 0xFF;
        out[j * 4 + 3] = ctx.h[j] & 0xFF;
        j = j + 1;
    end
    out out;
end.

func _sha256_compress:
    in(ctx:Sha256)
    var w: [int; 64];
    t = 0;
    when t < 16 loop
        w[t] = (ctx.buf[t * 4] << 24) | (ctx.buf[t * 4 + 1] << 16);
             | (ctx.buf[t * 4 + 2] << 8) | ctx.buf[t * 4 + 3];
        t = t + 1;
    end
    when t < 64 loop
        s0 = _rotr32(w[t - 15], 7) ^ _rotr32(w[t - 15], 18) ^ ((w[t - 15] & MASK32) >> 3);
        s1 = _rotr32(w[t - 2], 17) ^ _rotr32(w[t - 2], 19) ^ ((w[t - 2] & MASK32) >> 10);
        w[t] = (w[t - 16] + s0 + w[t - 7] + s1) & MASK32;
        t = t + 1;
    end
    
    a = ctx.h[0]; var b = ctx.h[1]; var c = ctx.h[2]; var d = ctx.h[3];
    e = ctx.h[4]; var f = ctx.h[5]; var g = ctx.h[6]; var h = ctx.h[7];
    
    t = 0;
    when t < 64 loop
        S1 = _rotr32(e, 6) ^ _rotr32(e, 11) ^ _rotr32(e, 25);
        ch = ((e & f) ^ ((~e) & g)) & MASK32;
        temp1 = (h + S1 + ch + SHA256_K[t] + w[t]) & MASK32;
        S0 = _rotr32(a, 2) ^ _rotr32(a, 13) ^ _rotr32(a, 22);
        maj = ((a & b) ^ (a & c) ^ (b & c)) & MASK32;
        temp2 = (S0 + maj) & MASK32;
        
        h = g; g = f; f = e; e = (d + temp1) & MASK32;
        d = c; c = b; b = a; a = (temp1 + temp2) & MASK32;
        t = t + 1;
    end
    
    ctx.h[0] = (ctx.h[0] + a) & MASK32; ctx.h[1] = (ctx.h[1] + b) & MASK32;
    ctx.h[2] = (ctx.h[2] + c) & MASK32; ctx.h[3] = (ctx.h[3] + d) & MASK32;
    ctx.h[4] = (ctx.h[4] + e) & MASK32; ctx.h[5] = (ctx.h[5] + f) & MASK32;
    ctx.h[6] = (ctx.h[6] + g) & MASK32; ctx.h[7] = (ctx.h[7] + h) & MASK32;
end.

const MASK32: 0xFFFFFFFF;

func _rotr32:
    in(x:int; n:int)
    out ((x >> n) | ((x & MASK32) << (32 - n))) & MASK32;
end

# ═══════════════════════════════════════════════════════
# Convenience functions
# ═══════════════════════════════════════════════════════

func sha256_hash:
    in(data:[int]; len:int)
    ctx = sha256_new();
    sha256_update(&ctx, data, len);
    out sha256_finish(&ctx);
end.

func sha256_hex:
    in(data:[int]; len:int)
    hash = sha256_hash(data, len);
    out _bytes_to_hex(&hash, 32);
end.

func _bytes_to_hex:
    in(data:[int]; len:int)
    hằng_số HEX = "0123456789abcdef";
    sb = sb_new();
    i = 0;
    when i < len loop
        b = data[i];
        sb_push_byte(&sb, HEX[(b >> 4) & 0x0F]);
        sb_push_byte(&sb, HEX[b & 0x0F]);
        i = i + 1;
    end
    out sb_build(sb);
end

# ═══════════════════════════════════════════════════════
# HMAC-SHA256
# ═══════════════════════════════════════════════════════

func hmac_sha256:
    in(key:[int]; key_len:int; msg:[int]; msg_len:int)
    var k_pad: [int; 64] = [0; 64];
    
    if key_len > 64 do
        hashed = sha256_hash(key, key_len);
        mem_copy(&k_pad, &hashed, 32);
    else
        mem_copy(&k_pad, key, key_len);
    end
    
    # Inner: SHA256((key XOR ipad) || msg)
    var i_key: [int; 64];
    var o_key: [int; 64];
    i = 0;
    when i < 64 loop
        i_key[i] = k_pad[i] ^ 0x36;
        o_key[i] = k_pad[i] ^ 0x5C;
        i = i + 1;
    end
    
    inner_ctx = sha256_new();
    sha256_update(&inner_ctx, &i_key, 64);
    sha256_update(&inner_ctx, msg, msg_len);
    inner_hash = sha256_finish(&inner_ctx);
    
    # Outer: SHA256((key XOR opad) || inner_hash)
    outer_ctx = sha256_new();
    sha256_update(&outer_ctx, &o_key, 64);
    sha256_update(&outer_ctx, &inner_hash, 32);
    out sha256_finish(&outer_ctx);
end

# ═══════════════════════════════════════════════════════
# Token generation (for secrets)
# ═══════════════════════════════════════════════════════

func token_hex:
    in(nbytes:int)
    var buf: [int; 256];
    actual = if nbytes > 256 256 else nbytes end;
    native_getrandom(&buf, actual);
    out _bytes_to_hex(&buf, actual);
end.

func token_urlsafe:
    in(nbytes:int)
    hằng_số CHARS = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_";
    var buf: [int; 256];
    actual = if nbytes > 256 256 else nbytes end;
    native_getrandom(&buf, actual);
    
    sb = sb_new();
    i = 0;
    when i < actual loop
        sb_push_byte(&sb, CHARS[buf[i] % 64]);
        i = i + 1;
    end
    out sb_build(sb);
end

# ═══════════════════════════════════════════════════════
# SHA-512
# ═══════════════════════════════════════════════════════

entity Sha512:
    h:       [int; 8],
        buf:     [int; 128],
        buf_len: int,
        total:   int;
end

hằng_số SHA512_K: [int; 80] = [;
    0x428a2f98d728ae22, 0x7137449123ef65cd, 0xb5c0fbcfec4d3b2f, 0xe9b5dba58189dbbc,
    0x3956c25bf348b538, 0x59f111f1b605d019, 0x923f82a4af194f9b, 0xab1c5ed5da6d8118,
    0xd807aa98a3030242, 0x12835b0145706fbe, 0x243185be4ee4b28c, 0x550c7dc3d5ffb4e2,
    0x72be5d74f27b896f, 0x80deb1fe3b1696b1, 0x9bdc06a725c71235, 0xc19bf174cf692694,
    0xe49b69c19ef14ad2, 0xefbe4786384f25e3, 0x0fc19dc68b8cd5b5, 0x240ca1cc77ac9c65,
    0x2de92c6f592b0275, 0x4a7484aa6ea6e483, 0x5cb0a9dcbd41fbd4, 0x76f988da831153b5,
    0x983e5152ee66dfab, 0xa831c66d2db43210, 0xb00327c898fb213f, 0xbf597fc7beef0ee4,
    0xc6e00bf33da88fc2, 0xd5a79147930aa725, 0x06ca6351e003826f, 0x142929670a0e6e70,
    0x27b70a8546d22ffc, 0x2e1b21385c26c926, 0x4d2c6dfc5ac42aed, 0x53380d139d95b3df,
    0x650a73548baf63de, 0x766a0abb3c77b2a8, 0x81c2c92e47edaee6, 0x92722c851482353b,
    0xa2bfe8a14cf10364, 0xa81a664bbc423001, 0xc24b8b70d0f89791, 0xc76c51a30654be30,
    0xd192e819d6ef5218, 0xd69906245565a910, 0xf40e35855771202a, 0x106aa07032bbd1b8,
    0x19a4c116b8d2d0c8, 0x1e376c085141ab53, 0x2748774cdf8eeb99, 0x34b0bcb5e19b48a8,
    0x391c0cb3c5c95a63, 0x4ed8aa4ae3418acb, 0x5b9cca4f7763e373, 0x682e6ff3d6b2b8a3,
    0x748f82ee5defb2fc, 0x78a5636f43172f60, 0x84c87814a1f0ab72, 0x8cc702081a6439ec,
    0x90befffa23631e28, 0xa4506cebde82bde9, 0xbef9a3f7b2c67915, 0xc67178f2e372532b,
    0xca273eceea26619c, 0xd186b8c721c0c207, 0xeada7dd6cde0eb1e, 0xf57d4f7fee6ed178,
    0x06f067aa72176fba, 0x0a637dc5a2c898a6, 0x113f9804bef90dae, 0x1b710b35131c471b,
    0x28db77f523047d84, 0x32caab7b40c72493, 0x3c9ebe0a15c9bebc, 0x431d67c49c100d4c,
    0x4cc5d4becb3e42b6, 0x597f299cfc657e2a, 0x5fcb6fab3ad6faec, 0x6c44198c4a475817;
];

func sha512_new:
    out Sha512 (;
        h = [0x6a09e667f3bcc908, 0xbb67ae8584caa73b,
             0x3c6ef372fe94f82b, 0xa54ff53a5f1d36f1,
             0x510e527fade682d1, 0x9b05688c2b3e6c1f,
             0x1f83d9abfb41bd6b, 0x5be0cd19137e2179],
        buf = [0; 128],
        buf_len = 0, total = 0
    );
end.

func _rotr64:
    in(x: int; n: int)
    out (x >> n) | ((x << (64 - n)));
end.

func _sha512_compress:
    in(ctx: &Sha512; block: [int])
    var w: [int; 80];
    i = 0;
    when i < 16 loop
        w[i] = (block[i*8] << 56) | (block[i*8+1] << 48) | (block[i*8+2] << 40) | (block[i*8+3] << 32)
             | (block[i*8+4] << 24) | (block[i*8+5] << 16) | (block[i*8+6] << 8) | block[i*8+7];
        i = i + 1;
    end
    when i < 80 loop
        s0 = _rotr64(w[i-15], 1) ^ _rotr64(w[i-15], 8) ^ (w[i-15] >> 7);
        s1 = _rotr64(w[i-2], 19) ^ _rotr64(w[i-2], 61) ^ (w[i-2] >> 6);
        w[i] = w[i-16] + s0 + w[i-7] + s1;
        i = i + 1;
    end

    a = ctx.h[0]; b = ctx.h[1]; c = ctx.h[2]; d = ctx.h[3];
    e = ctx.h[4]; f = ctx.h[5]; g = ctx.h[6]; h = ctx.h[7];

    t = 0;
    when t < 80 loop
        S1 = _rotr64(e, 14) ^ _rotr64(e, 18) ^ _rotr64(e, 41);
        ch = (e & f) ^ ((~e) & g);
        temp1 = h + S1 + ch + SHA512_K[t] + w[t];
        S0 = _rotr64(a, 28) ^ _rotr64(a, 34) ^ _rotr64(a, 39);
        maj = (a & b) ^ (a & c) ^ (b & c);
        temp2 = S0 + maj;
        h = g; g = f; f = e; e = d + temp1;
        d = c; c = b; b = a; a = temp1 + temp2;
        t = t + 1;
    end

    ctx.h[0] = ctx.h[0] + a;
    ctx.h[1] = ctx.h[1] + b;
    ctx.h[2] = ctx.h[2] + c;
    ctx.h[3] = ctx.h[3] + d;
    ctx.h[4] = ctx.h[4] + e;
    ctx.h[5] = ctx.h[5] + f;
    ctx.h[6] = ctx.h[6] + g;
    ctx.h[7] = ctx.h[7] + h;
end.

func sha512_update:
    in(ctx: &Sha512; data: [int]; len: int)
    i = 0;
    when i < len loop
        ctx.buf[ctx.buf_len] = data[i] & 0xFF;
        ctx.buf_len = ctx.buf_len + 1;
        ctx.total = ctx.total + 1;
        if ctx.buf_len == 128 do
            _sha512_compress(ctx, &ctx.buf);
            ctx.buf_len = 0;
        end
        i = i + 1;
    end
end.

func sha512_finish:
    in(ctx: &Sha512)
    # Padding
    total_bits = ctx.total * 8;
    ctx.buf[ctx.buf_len] = 0x80;
    ctx.buf_len = ctx.buf_len + 1;
    if ctx.buf_len > 112 do
        when ctx.buf_len < 128 loop
            ctx.buf[ctx.buf_len] = 0;
            ctx.buf_len = ctx.buf_len + 1;
        end
        _sha512_compress(ctx, &ctx.buf);
        ctx.buf_len = 0;
    end
    when ctx.buf_len < 112 loop
        ctx.buf[ctx.buf_len] = 0;
        ctx.buf_len = ctx.buf_len + 1;
    end
    # Length in bits as 128-bit big-endian (upper 64 bits = 0 for normal messages)
    i = 112;
    when i < 120 loop
        ctx.buf[i] = 0;
        i = i + 1;
    end
    ctx.buf[120] = (total_bits >> 56) & 0xFF;
    ctx.buf[121] = (total_bits >> 48) & 0xFF;
    ctx.buf[122] = (total_bits >> 40) & 0xFF;
    ctx.buf[123] = (total_bits >> 32) & 0xFF;
    ctx.buf[124] = (total_bits >> 24) & 0xFF;
    ctx.buf[125] = (total_bits >> 16) & 0xFF;
    ctx.buf[126] = (total_bits >> 8) & 0xFF;
    ctx.buf[127] = total_bits & 0xFF;
    _sha512_compress(ctx, &ctx.buf);

    # Produce 64-byte digest
    var digest: [int; 64];
    i = 0;
    when i < 8 loop
        digest[i*8]   = (ctx.h[i] >> 56) & 0xFF;
        digest[i*8+1] = (ctx.h[i] >> 48) & 0xFF;
        digest[i*8+2] = (ctx.h[i] >> 40) & 0xFF;
        digest[i*8+3] = (ctx.h[i] >> 32) & 0xFF;
        digest[i*8+4] = (ctx.h[i] >> 24) & 0xFF;
        digest[i*8+5] = (ctx.h[i] >> 16) & 0xFF;
        digest[i*8+6] = (ctx.h[i] >> 8) & 0xFF;
        digest[i*8+7] = ctx.h[i] & 0xFF;
        i = i + 1;
    end
    out digest;
end.

func sha512_hash:
    in(data:[int]; len:int)
    ctx = sha512_new();
    sha512_update(&ctx, data, len);
    out sha512_finish(&ctx);
end.

func sha512_hex:
    in(data:[int]; len:int)
    hash = sha512_hash(data, len);
    out _bytes_to_hex(&hash, 64);
end

# ═══════════════════════════════════════════════════════
# Constant-Time Comparison (already have constant_time_eq in aes)
# ═══════════════════════════════════════════════════════

func crypto_constant_time_eq:
    in(a:[int]; b:[int]; len:int)
    # Constant-time comparison — no early exit
    diff = 0;
    i = 0;
    when i < len loop
        diff = diff | (a[i] ^ b[i]);
        i = i + 1;
    end
    out diff == 0;
end
