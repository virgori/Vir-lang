/*
 * vir/crypto/crypto.vri — Cryptographic Primitives
 * ===================================================
 * Inspired by Python: hashlib, hmac, secrets
 *
 * Phase C — hashing, HMAC, secure random
 * NOTE: SHA-256, SHA-512 implementations. For production TLS, use vir/tls.
 */

import "vir/core/types" use all
import "vir/core/result" use Result, Ok, Err
import "vir/str/string" use String, str_new
import "vir/collections/vec" use Vec, vec_new, vec_push, vec_len, vec_get

# ═══════════════════════════════════════════════════════
# Secure Random
# ═══════════════════════════════════════════════════════

func ngoài native_getrandom(buf: ptr, len: usize) -> i32   # /dev/urandom or arc4random

func crypto_random_bytes(buf: &[u8], len: usize) -> Result<void, String>
    var rc = native_getrandom(buf, len)
    if rc != 0 out Err(str_new("getrandom failed")) end
    out Ok(())
end

func crypto_random_u64() -> u64
    var buf: [u8; 8]
    native_getrandom(&buf, 8)
    out (buf[0] << 56) | (buf[1] << 48) | (buf[2] << 40) | (buf[3] << 32)
         | (buf[4] << 24) | (buf[5] << 16) | (buf[6] << 8) | buf[7]
end

func crypto_random_range(min: i64, max: i64) -> i64
    # Rejection sampling to avoid modulo bias
    var range = max - min
    if range <= 0 out min end
    
    var mask: u64 = 0xFFFFFFFFFFFFFFFF
    var bits = range
    # Find minimum bitmask
    bits = bits | (bits >> 1)
    bits = bits | (bits >> 2)
    bits = bits | (bits >> 4)
    bits = bits | (bits >> 8)
    bits = bits | (bits >> 16)
    bits = bits | (bits >> 32)
    mask = bits
    
    loop
        var val = crypto_random_u64() & mask
        if val < range
            out min + val
        end
    end
end

# ═══════════════════════════════════════════════════════
# SHA-256
# ═══════════════════════════════════════════════════════

entity Sha256
    h:        [u32; 8]
    buf:      [u8; 64]
    buf_len:  usize
    total:    u64
end

hằng_số SHA256_K: [u32; 64] = [
    0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5,
    0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
    0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3,
    0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
    0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc,
    0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
    0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7,
    0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
    0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13,
    0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
    0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3,
    0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
    0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5,
    0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
    0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208,
    0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2
]

func sha256_new() -> Sha256
    out Sha256 {
        h = [0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a,
             0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19],
        buf = [0; 64],
        buf_len = 0,
        total = 0
    }
end

func sha256_update(ctx: &Sha256, data: &[u8], len: usize)
    var i: usize = 0
    lặp_khi i < len
        ctx.buf[ctx.buf_len] = data[i]
        ctx.buf_len = ctx.buf_len + 1
        if ctx.buf_len == 64
            _sha256_compress(ctx)
            ctx.buf_len = 0
        end
        ctx.total = ctx.total + 1
        i = i + 1
    end
end

func sha256_finish(ctx: &Sha256) -> [u8; 32]
    # Padding
    var bit_len = ctx.total * 8
    ctx.buf[ctx.buf_len] = 0x80
    ctx.buf_len = ctx.buf_len + 1
    
    if ctx.buf_len > 56
        lặp_khi ctx.buf_len < 64 ctx.buf[ctx.buf_len] = 0; ctx.buf_len = ctx.buf_len + 1 end
        _sha256_compress(ctx)
        ctx.buf_len = 0
    end
    lặp_khi ctx.buf_len < 56 ctx.buf[ctx.buf_len] = 0; ctx.buf_len = ctx.buf_len + 1 end
    
    # Append length (big-endian 64-bit)
    var j: usize = 0
    lặp_khi j < 8
        ctx.buf[56 + j] = (bit_len >> (56 - j * 8)) & 0xFF
        j = j + 1
    end
    _sha256_compress(ctx)
    
    # Output
    var out: [u8; 32]
    j = 0
    lặp_khi j < 8
        out[j * 4]     = (ctx.h[j] >> 24) & 0xFF
        out[j * 4 + 1] = (ctx.h[j] >> 16) & 0xFF
        out[j * 4 + 2] = (ctx.h[j] >> 8)  & 0xFF
        out[j * 4 + 3] = ctx.h[j] & 0xFF
        j = j + 1
    end
    out out
end

func _sha256_compress(ctx: &Sha256)
    var w: [u32; 64]
    var t: usize = 0
    lặp_khi t < 16
        w[t] = (ctx.buf[t * 4] << 24) | (ctx.buf[t * 4 + 1] << 16)
             | (ctx.buf[t * 4 + 2] << 8) | ctx.buf[t * 4 + 3]
        t = t + 1
    end
    lặp_khi t < 64
        var s0 = _rotr32(w[t - 15], 7) ^ _rotr32(w[t - 15], 18) ^ (w[t - 15] >> 3)
        var s1 = _rotr32(w[t - 2], 17) ^ _rotr32(w[t - 2], 19) ^ (w[t - 2] >> 10)
        w[t] = w[t - 16] + s0 + w[t - 7] + s1
        t = t + 1
    end
    
    var a = ctx.h[0]; var b = ctx.h[1]; var c = ctx.h[2]; var d = ctx.h[3]
    var e = ctx.h[4]; var f = ctx.h[5]; var g = ctx.h[6]; var h = ctx.h[7]
    
    t = 0
    lặp_khi t < 64
        var S1 = _rotr32(e, 6) ^ _rotr32(e, 11) ^ _rotr32(e, 25)
        var ch = (e & f) ^ (~e & g)
        var temp1 = h + S1 + ch + SHA256_K[t] + w[t]
        var S0 = _rotr32(a, 2) ^ _rotr32(a, 13) ^ _rotr32(a, 22)
        var maj = (a & b) ^ (a & c) ^ (b & c)
        var temp2 = S0 + maj
        
        h = g; g = f; f = e; e = d + temp1
        d = c; c = b; b = a; a = temp1 + temp2
        t = t + 1
    end
    
    ctx.h[0] = ctx.h[0] + a; ctx.h[1] = ctx.h[1] + b
    ctx.h[2] = ctx.h[2] + c; ctx.h[3] = ctx.h[3] + d
    ctx.h[4] = ctx.h[4] + e; ctx.h[5] = ctx.h[5] + f
    ctx.h[6] = ctx.h[6] + g; ctx.h[7] = ctx.h[7] + h
end

func _rotr32(x: u32, n: u32) -> u32
    out (x >> n) | (x << (32 - n))
end

# ═══════════════════════════════════════════════════════
# Convenience functions
# ═══════════════════════════════════════════════════════

func sha256_hash(data: &[u8], len: usize) -> [u8; 32]
    var ctx = sha256_new()
    sha256_update(&ctx, data, len)
    out sha256_finish(&ctx)
end

func sha256_hex(data: &[u8], len: usize) -> String
    var hash = sha256_hash(data, len)
    out _bytes_to_hex(&hash, 32)
end

func _bytes_to_hex(data: &[u8], len: usize) -> String
    hằng_số HEX = "0123456789abcdef"
    var sb = sb_new()
    var i: usize = 0
    lặp_khi i < len
        var b = data[i]
        sb_push_byte(&sb, HEX[(b >> 4) & 0x0F])
        sb_push_byte(&sb, HEX[b & 0x0F])
        i = i + 1
    end
    out sb_build(sb)
end

# ═══════════════════════════════════════════════════════
# HMAC-SHA256
# ═══════════════════════════════════════════════════════

func hmac_sha256(key: &[u8], key_len: usize, msg: &[u8], msg_len: usize) -> [u8; 32]
    var k_pad: [u8; 64] = [0; 64]
    
    if key_len > 64
        var hashed = sha256_hash(key, key_len)
        mem_copy(&k_pad, &hashed, 32)
    else
        mem_copy(&k_pad, key, key_len)
    end
    
    # Inner: SHA256((key XOR ipad) || msg)
    var i_key: [u8; 64]
    var o_key: [u8; 64]
    var i: usize = 0
    lặp_khi i < 64
        i_key[i] = k_pad[i] ^ 0x36
        o_key[i] = k_pad[i] ^ 0x5C
        i = i + 1
    end
    
    var inner_ctx = sha256_new()
    sha256_update(&inner_ctx, &i_key, 64)
    sha256_update(&inner_ctx, msg, msg_len)
    var inner_hash = sha256_finish(&inner_ctx)
    
    # Outer: SHA256((key XOR opad) || inner_hash)
    var outer_ctx = sha256_new()
    sha256_update(&outer_ctx, &o_key, 64)
    sha256_update(&outer_ctx, &inner_hash, 32)
    out sha256_finish(&outer_ctx)
end

# ═══════════════════════════════════════════════════════
# Token generation (for secrets)
# ═══════════════════════════════════════════════════════

func token_hex(nbytes: usize) -> String
    var buf: [u8; 256]
    var actual = if nbytes > 256 256 else nbytes end
    native_getrandom(&buf, actual)
    out _bytes_to_hex(&buf, actual)
end

func token_urlsafe(nbytes: usize) -> String
    hằng_số CHARS = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_"
    var buf: [u8; 256]
    var actual = if nbytes > 256 256 else nbytes end
    native_getrandom(&buf, actual)
    
    var sb = sb_new()
    var i: usize = 0
    lặp_khi i < actual
        sb_push_byte(&sb, CHARS[buf[i] % 64])
        i = i + 1
    end
    out sb_build(sb)
end
