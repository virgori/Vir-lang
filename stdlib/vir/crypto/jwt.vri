##
 * vir/crypto/jwt.vri — JSON Web Token (RFC 7519)
 * ================================================
 * Inspired by Rust: jsonwebtoken crate
 * Inspired by Python: PyJWT
 * Inspired by Go: golang-jwt/jwt
 *
 * Phase C — Tier 2: JWT creation and verification.
 * Supports HS256 (HMAC-SHA256) signing algorithm.
 * Base64url encoding, JSON claim building.
 ##

include types;
include option;
import Option, Some, None, is_some, is_none, unwrap from option;
include vec;
import Vec, vec_new, vec_push, vec_get, vec_set, vec_len from vec;
include builder;
import StringBuilder, sb_new, sb_append, sb_append_byte, sb_append_i64,
       sb_build, sb_free from builder;
include crypto/crypto;
import hmac_sha256 from crypto/crypto;

# ═══════════════════════════════════════════════════════
# Base64url encoding (RFC 4648 §5, no padding)
# ═══════════════════════════════════════════════════════

const _B64URL_TABLE = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_";

func _b64url_encode:
    in(data: [int]; len: int)
    sb = sb_new();
    i = 0;
    when i < len loop
        # Process 3 bytes at a time
        b0 = data[i];
        b1 = 0;
        b2 = 0;
        if i + 1 < len do
            b1 = data[i + 1];
        end
        if i + 2 < len do
            b2 = data[i + 2];
        end

        # 4 6-bit groups
        c0 = b0 / 4;
        c1 = (b0 - c0 * 4) * 16 + b1 / 16;
        c2 = (b1 - (b1 / 16) * 16) * 4 + b2 / 64;
        c3 = b2 - (b2 / 64) * 64;

        sb_append_byte(sb, str_byte_at(_B64URL_TABLE, c0));
        sb_append_byte(sb, str_byte_at(_B64URL_TABLE, c1));

        remaining = len - i;
        if remaining > 1 do
            sb_append_byte(sb, str_byte_at(_B64URL_TABLE, c2));
        end
        if remaining > 2 do
            sb_append_byte(sb, str_byte_at(_B64URL_TABLE, c3));
        end

        i = i + 3;
    end
    result = sb_build(sb);
    sb_free(sb);
    out result;
end
func _b64url_encode_str:
    in(s: string)
    var buf: [int; 4096];
    n = str_len(s);
    i = 0;
    when i < n loop
        buf[i] = str_byte_at(s, i);
        i = i + 1;
    end
    out _b64url_encode(&buf, n);
end
# ─── Base64url decode ──────────────────────────────

func _b64url_char_val:
    in(ch: int)
    if ch >= 65 and ch <= 90 do out ch - 65 end # A-Z
    if ch >= 97 and ch <= 122 do out ch - 97 + 26 end # a-z
    if ch >= 48 and ch <= 57 do out ch - 48 + 52 end # 0-9
    if ch == 45 do out 62 end # -
    if ch == 95 do out 63 end # _
    out 0;
end
func _b64url_decode:
    in(s: string; out_buf: [int]; out_len: [int])
    n = str_len(s);
    oi = 0;
    i = 0;
    when i < n loop
        v0 = _b64url_char_val(str_byte_at(s, i));
        v1 = 0;
        v2 = 0;
        v3 = 0;
        if i + 1 < n do
            v1 = _b64url_char_val(str_byte_at(s, i + 1));
        end
        if i + 2 < n do
            v2 = _b64url_char_val(str_byte_at(s, i + 2));
        end
        if i + 3 < n do
            v3 = _b64url_char_val(str_byte_at(s, i + 3));
        end

        out_buf[oi] = v0 * 4 + v1 / 16;
        oi = oi + 1;

        chars_left = n - i;
        if chars_left > 2 do
            out_buf[oi] = (v1 - (v1 / 16) * 16) * 16 + v2 / 4;
            oi = oi + 1;
        end
        if chars_left > 3 do
            out_buf[oi] = (v2 - (v2 / 4) * 4) * 64 + v3;
            oi = oi + 1;
        end

        i = i + 4;
    end
    out_len[0] = oi;
end
# ═══════════════════════════════════════════════════════
# JWT Claim entity
# ═══════════════════════════════════════════════════════

entity JwtClaims:
    sub:     string;     # subject
    iss:     string;     # issuer
    aud:     string;     # audience
    exp:     int;        # expiration (unix timestamp)
    iat:     int;        # issued at
    nbf:     int;        # not before
    jti:     string;     # JWT ID
    custom:  Vec;        # Vec<string> — alternating key, value pairs
end
func jwt_claims_new:
    in()
    out JwtClaims (
        sub: "", iss: "", aud: "",
        exp: 0, iat: 0, nbf: 0,
        jti: "",
        custom: vec_new()
    );
end
func jwt_set_sub:     in(c: JwtClaims; v: string) c.sub = v; end
func jwt_set_iss:     in(c: JwtClaims; v: string) c.iss = v; end
func jwt_set_aud:     in(c: JwtClaims; v: string) c.aud = v; end
func jwt_set_exp:     in(c: JwtClaims; v: int)    c.exp = v; end
func jwt_set_iat:     in(c: JwtClaims; v: int)    c.iat = v; end
func jwt_set_nbf:     in(c: JwtClaims; v: int)    c.nbf = v; end
func jwt_set_jti:     in(c: JwtClaims; v: string) c.jti = v; end

func jwt_add_claim:
    in(c: JwtClaims; key: string; value: string)
    vec_push(c.custom, key);
    vec_push(c.custom, value);
end
# ═══════════════════════════════════════════════════════
# JSON serialization (minimal, for JWT payloads)
# ═══════════════════════════════════════════════════════

func _jwt_escape_str:
    in(sb: StringBuilder; s: string)
    sb_append_byte(sb, 34);   # "
    i = 0;
    when i < str_len(s) loop
        ch = str_byte_at(s, i);
        if ch == 34 do # escape "
            sb_append_byte(sb, 92);
            sb_append_byte(sb, 34);
        eif ch == 92 do # escape backslash
            sb_append_byte(sb, 92);
            sb_append_byte(sb, 92);
        else
            sb_append_byte(sb, ch);
        end
        i = i + 1;
    end
    sb_append_byte(sb, 34);
end
func _claims_to_json:
    in(c: JwtClaims)
    sb = sb_new();
    sb_append(sb, "{");
    first = true;

    # Helper: append string field
    if str_len(c.sub) > 0 do
        if not first do sb_append(sb, ","); end
        sb_append(sb, "\"sub\":");
        _jwt_escape_str(sb, c.sub);
        first = false;
    end
    if str_len(c.iss) > 0 do
        if not first do sb_append(sb, ","); end
        sb_append(sb, "\"iss\":");
        _jwt_escape_str(sb, c.iss);
        first = false;
    end
    if str_len(c.aud) > 0 do
        if not first do sb_append(sb, ","); end
        sb_append(sb, "\"aud\":");
        _jwt_escape_str(sb, c.aud);
        first = false;
    end
    if c.exp > 0 do
        if not first do sb_append(sb, ","); end
        sb_append(sb, "\"exp\":");
        sb_append_i64(sb, c.exp);
        first = false;
    end
    if c.iat > 0 do
        if not first do sb_append(sb, ","); end
        sb_append(sb, "\"iat\":");
        sb_append_i64(sb, c.iat);
        first = false;
    end
    if c.nbf > 0 do
        if not first do sb_append(sb, ","); end
        sb_append(sb, "\"nbf\":");
        sb_append_i64(sb, c.nbf);
        first = false;
    end
    if str_len(c.jti) > 0 do
        if not first do sb_append(sb, ","); end
        sb_append(sb, "\"jti\":");
        _jwt_escape_str(sb, c.jti);
        first = false;
    end

    # Custom claims
    i = 0;
    when i + 1 < vec_len(c.custom) loop
        if not first do sb_append(sb, ","); end
        key = vec_get(c.custom, i);
        val = vec_get(c.custom, i + 1);
        _jwt_escape_str(sb, key);
        sb_append(sb, ":");
        _jwt_escape_str(sb, val);
        first = false;
        i = i + 2;
    end

    sb_append(sb, "}");
    result = sb_build(sb);
    sb_free(sb);
    out result;
end
# ═══════════════════════════════════════════════════════
# JWT Sign (HS256)
# ═══════════════════════════════════════════════════════

func jwt_encode:
    in(claims: JwtClaims; secret: [int]; secret_len: int)
    # Header: {"alg":"HS256","typ":"JWT"}
    header_json = "{\"alg\":\"HS256\",\"typ\":\"JWT\"}";
    header_b64 = _b64url_encode_str(header_json);

    # Payload
    payload_json = _claims_to_json(claims);
    payload_b64 = _b64url_encode_str(payload_json);

    # Signing input: header.payload
    sb = sb_new();
    sb_append(sb, header_b64);
    sb_append_byte(sb, 46);    # '.'
    sb_append(sb, payload_b64);
    signing_input = sb_build(sb);
    sb_free(sb);

    # HMAC-SHA256 signature
    var input_bytes: [int; 4096];
    n = str_len(signing_input);
    i = 0;
    when i < n loop
        input_bytes[i] = str_byte_at(signing_input, i);
        i = i + 1;
    end

    sig = hmac_sha256(secret, secret_len, &input_bytes, n);
    sig_b64 = _b64url_encode(&sig, 32);

    # Final token: header.payload.signature
    sb2 = sb_new();
    sb_append(sb2, signing_input);
    sb_append_byte(sb2, 46);   # '.'
    sb_append(sb2, sig_b64);
    token = sb_build(sb2);
    sb_free(sb2);
    out token;
end
# ═══════════════════════════════════════════════════════
# JWT Verify
# ═══════════════════════════════════════════════════════

func jwt_verify:
    in(token: string; secret: [int]; secret_len: int)
    # Find the two dots
    dot1 = -1;
    dot2 = -1;
    i = 0;
    when i < str_len(token) loop
        if str_byte_at(token, i) == 46 do
            if dot1 < 0 do
                dot1 = i;
            else
                dot2 = i;
            end
        end
        i = i + 1;
    end

    if dot1 < 0 or dot2 < 0 do out false end

    # signing_input = header.payload (up to dot2)
    var input_bytes: [int; 4096];
    j = 0;
    when j < dot2 loop
        input_bytes[j] = str_byte_at(token, j);
        j = j + 1;
    end

    expected_sig = hmac_sha256(secret, secret_len, &input_bytes, dot2);
    expected_b64 = _b64url_encode(&expected_sig, 32);

    # Extract actual signature from token
    sb = sb_new();
    k = dot2 + 1;
    when k < str_len(token) loop
        sb_append_byte(sb, str_byte_at(token, k));
        k = k + 1;
    end
    actual_sig = sb_build(sb);
    sb_free(sb);

    # Constant-time compare
    if str_len(expected_b64) != str_len(actual_sig) do out false end
    diff = 0;
    ci = 0;
    when ci < str_len(expected_b64) loop
        diff = diff | (str_byte_at(expected_b64, ci) ^ str_byte_at(actual_sig, ci));
        ci = ci + 1;
    end
    out diff == 0;
end
# ═══════════════════════════════════════════════════════
# JWT Decode (extract payload without verification)
# ═══════════════════════════════════════════════════════

func jwt_decode_payload:
    in(token: string)
    # Find dots
    dot1 = -1;
    dot2 = -1;
    i = 0;
    when i < str_len(token) loop
        if str_byte_at(token, i) == 46 do
            if dot1 < 0 do
                dot1 = i;
            else
                dot2 = i;
            end
        end
        i = i + 1;
    end
    if dot1 < 0 or dot2 < 0 do out "" end

    # Extract base64url payload between dot1 and dot2
    sb = sb_new();
    j = dot1 + 1;
    when j < dot2 loop
        sb_append_byte(sb, str_byte_at(token, j));
        j = j + 1;
    end
    payload_b64 = sb_build(sb);
    sb_free(sb);

    # Decode base64url
    var decoded: [int; 4096];
    var decoded_len: [int; 1];
    _b64url_decode(payload_b64, &decoded, &decoded_len);

    sb2 = sb_new();
    k = 0;
    when k < decoded_len[0] loop
        sb_append_byte(sb2, decoded[k]);
        k = k + 1;
    end
    result = sb_build(sb2);
    sb_free(sb2);
    out result;
end