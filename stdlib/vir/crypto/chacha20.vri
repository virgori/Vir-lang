##
 * vir/crypto/chacha20.vri — ChaCha20-Poly1305 AEAD
 * ===================================================
 * Inspired by Rust: chacha20poly1305 crate
 * Inspired by Go: crypto/chacha20poly1305
 * Inspired by RFC: 8439 (ChaCha20 and Poly1305 for IETF Protocols)
 *
 * Phase C — Tier 2: Authenticated Encryption with Associated Data.
 * ChaCha20 stream cipher + Poly1305 MAC.
 * Pure Vir implementation — no external dependencies.
 ##

module vir.crypto.chacha20

include types
include vec
import Vec, vec_new, vec_push, vec_get, vec_set, vec_len from vec

# ═══════════════════════════════════════════════════════
# Constants
# ═══════════════════════════════════════════════════════

const CHACHA_ROUNDS:   20
const CHACHA_KEY_LEN:  32;     # 256 bits
const CHACHA_NONCE_LEN: 12;    # 96 bits (IETF)
const POLY1305_TAG_LEN: 16;    # 128 bits

# ═══════════════════════════════════════════════════════
# 32-bit word operations (within int range)
# ═══════════════════════════════════════════════════════

const WORD_MASK: 4294967295;   # 0xFFFFFFFF

func _u32_add(a: int, b: int):
    out (a + b) % 4294967296
end.
func _u32_xor(a: int, b: int):
    result = 0
    power = 1
    bit = 0
    when bit < 32 loop
        ba = (a / power) % 2
        bb = (b / power) % 2
        if ba != bb do
            result = result + power
        end
        power = power * 2
        bit = bit + 1
    end
    out result
end.
func _u32_rotl(x: int, n: int):
    # (x << n) | (x >> (32 - n))
    shift_left = x
    i = 0
    when i < n loop
        shift_left = shift_left * 2
        i = i + 1
    end
    shift_left = shift_left % 4294967296

    shift_right = x
    i = 0
    when i < 32 - n loop
        shift_right = shift_right / 2
        i = i + 1
    end

    out _u32_xor(shift_left, shift_right)
end.
# ═══════════════════════════════════════════════════════
# ChaCha20 Quarter Round
# ═══════════════════════════════════════════════════════

func _quarter_round:
    in  state: Vec
        a: int
        b: int
        c: int
        d: int
    sa = vec_get(state, a)
    sb_v = vec_get(state, b)
    sc = vec_get(state, c)
    sd = vec_get(state, d)

    sa = _u32_add(sa, sb_v); sd = _u32_xor(sd, sa); sd = _u32_rotl(sd, 16)
    sc = _u32_add(sc, sd);   sb_v = _u32_xor(sb_v, sc); sb_v = _u32_rotl(sb_v, 12)
    sa = _u32_add(sa, sb_v); sd = _u32_xor(sd, sa); sd = _u32_rotl(sd, 8)
    sc = _u32_add(sc, sd);   sb_v = _u32_xor(sb_v, sc); sb_v = _u32_rotl(sb_v, 7)

    vec_set(state, a, sa)
    vec_set(state, b, sb_v)
    vec_set(state, c, sc)
    vec_set(state, d, sd)
end.
# ═══════════════════════════════════════════════════════
# Read / Write little-endian u32 from byte Vec
# ═══════════════════════════════════════════════════════

func _le_u32(bytes: Vec, offset: int):
    out vec_get(bytes, offset)
      + vec_get(bytes, offset + 1) * 256
      + vec_get(bytes, offset + 2) * 65536
      + vec_get(bytes, offset + 3) * 16777216
end.
func _u32_to_le(out_vec: Vec, val: int):
    vec_push(out_vec, val % 256)
    vec_push(out_vec, (val / 256) % 256)
    vec_push(out_vec, (val / 65536) % 256)
    vec_push(out_vec, (val / 16777216) % 256)
end.
# ═══════════════════════════════════════════════════════
# ChaCha20 Block Function
# ═══════════════════════════════════════════════════════

func _chacha20_block:
    in  key: Vec
        counter: int
        nonce: Vec
    # Initialize state: 4 constants + 8 key words + 1 counter + 3 nonce words
    state = vec_new()
    vec_push(state, 1634760805);    # "expa"
    vec_push(state, 857760878);     # "nd 3"
    vec_push(state, 2036477234);    # "2-by"
    vec_push(state, 1797285236);    # "te k"

    # Key words (8 x 32-bit from 32 bytes)
    i = 0
    when i < 8 loop
        vec_push(state, _le_u32(key, i * 4))
        i = i + 1
    end

    # Counter
    vec_push(state, counter % 4294967296)

    # Nonce (3 x 32-bit from 12 bytes)
    i = 0
    when i < 3 loop
        vec_push(state, _le_u32(nonce, i * 4))
        i = i + 1
    end

    # Save initial state
    initial = vec_new()
    i = 0
    when i < 16 loop
        vec_push(initial, vec_get(state, i))
        i = i + 1
    end

    # 20 rounds (10 double-rounds)
    round = 0
    when round < 10 loop
        # Column rounds
        _quarter_round(state, 0, 4, 8,  12)
        _quarter_round(state, 1, 5, 9,  13)
        _quarter_round(state, 2, 6, 10, 14)
        _quarter_round(state, 3, 7, 11, 15)
        # Diagonal rounds
        _quarter_round(state, 0, 5, 10, 15)
        _quarter_round(state, 1, 6, 11, 12)
        _quarter_round(state, 2, 7, 8,  13)
        _quarter_round(state, 3, 4, 9,  14)
        round = round + 1
    end

    # Add initial state
    result = vec_new()
    i = 0
    when i < 16 loop
        sum = _u32_add(vec_get(state, i), vec_get(initial, i))
        _u32_to_le(result, sum)
        i = i + 1
    end

    out result;   # 64 bytes
end.
# ═══════════════════════════════════════════════════════
# ChaCha20 Encrypt/Decrypt (same operation — XOR)
# ═══════════════════════════════════════════════════════

func chacha20_crypt:
    in  key: Vec
        nonce: Vec
        data: Vec
        initial_counter: int
    output = vec_new()
    counter = initial_counter
    pos = 0

    when pos < vec_len(data) loop
        keystream = _chacha20_block(key, counter, nonce)

        # XOR up to 64 bytes
        j = 0
        when j < 64 and pos + j < vec_len(data) loop
            plain_byte = vec_get(data, pos + j)
            ks_byte = vec_get(keystream, j)
            vec_push(output, _u32_xor(plain_byte, ks_byte) % 256)
            j = j + 1
        end

        pos = pos + 64
        counter = counter + 1
    end

    out output
end.
func chacha20_encrypt:
    in  key: Vec
        nonce: Vec
        plaintext: Vec
    out chacha20_crypt(key, nonce, plaintext, 1)
end.
func chacha20_decrypt:
    in  key: Vec
        nonce: Vec
        ciphertext: Vec
    out chacha20_crypt(key, nonce, ciphertext, 1)
end.
# ═══════════════════════════════════════════════════════
# Poly1305 MAC (RFC 8439 / poly1305-donna 32-bit limbs)
# ═══════════════════════════════════════════════════════

entity Poly1305State:
    r0: int; r1: int; r2: int; r3: int; r4: int,
        h0: int; h1: int; h2: int; h3: int; h4: int,
        pad0: int; pad1: int; pad2: int; pad3: int
end.

func _poly1305_init(key: Vec):
    # r = key[0..15] clamped; s = key[16..31]
    t0 = _le_u32(key, 0)
    t1 = _le_u32(key, 4)
    t2 = _le_u32(key, 8)
    t3 = _le_u32(key, 12)

    r0 = t0 bit_and 0x3ffffff
    r1 = ((t0 shr 26) bit_or (t1 shl 6)) bit_and 0x3ffff03
    r2 = ((t1 shr 20) bit_or (t2 shl 12)) bit_and 0x3ffc0ff
    r3 = ((t2 shr 14) bit_or (t3 shl 18)) bit_and 0x3f03fff
    r4 = (t3 shr 8) bit_and 0x00fffff

    out Poly1305State (
        r0: r0, r1: r1, r2: r2, r3: r3, r4: r4,
        h0: 0, h1: 0, h2: 0, h3: 0, h4: 0,
        pad0: _le_u32(key, 16),
        pad1: _le_u32(key, 20),
        pad2: _le_u32(key, 24),
        pad3: _le_u32(key, 28)
    )
end.

func _poly1305_blocks(st: Poly1305State, msg: Vec, pos: int, bytes: int, hibit: int):
    # Process `bytes` starting at msg[pos]. hibit=1<<24 for full blocks, 0 for final.
    r0 = st.r0; r1 = st.r1; r2 = st.r2; r3 = st.r3; r4 = st.r4
    s1 = r1 * 5; s2 = r2 * 5; s3 = r3 * 5; s4 = r4 * 5
    h0 = st.h0; h1 = st.h1; h2 = st.h2; h3 = st.h3; h4 = st.h4

    offset = 0
    when offset < bytes loop
        t0 = _le_u32(msg, pos + offset)
        t1 = _le_u32(msg, pos + offset + 4)
        t2 = _le_u32(msg, pos + offset + 8)
        t3 = _le_u32(msg, pos + offset + 12)

        h0 = h0 + (t0 bit_and 0x3ffffff)
        h1 = h1 + (((t0 shr 26) bit_or (t1 shl 6)) bit_and 0x3ffffff)
        h2 = h2 + (((t1 shr 20) bit_or (t2 shl 12)) bit_and 0x3ffffff)
        h3 = h3 + (((t2 shr 14) bit_or (t3 shl 18)) bit_and 0x3ffffff)
        h4 = h4 + ((t3 shr 8) bit_and 0x3ffffff) + hibit

        # h *= r  (mod 2^130 - 5), schoolbook with 26-bit limbs
        d0 = h0 * r0 + h1 * s4 + h2 * s3 + h3 * s2 + h4 * s1
        d1 = h0 * r1 + h1 * r0 + h2 * s4 + h3 * s3 + h4 * s2
        d2 = h0 * r2 + h1 * r1 + h2 * r0 + h3 * s4 + h4 * s3
        d3 = h0 * r3 + h1 * r2 + h2 * r1 + h3 * r0 + h4 * s4
        d4 = h0 * r4 + h1 * r3 + h2 * r2 + h3 * r1 + h4 * r0

        c = d0 shr 26; h0 = d0 bit_and 0x3ffffff; d1 = d1 + c
        c = d1 shr 26; h1 = d1 bit_and 0x3ffffff; d2 = d2 + c
        c = d2 shr 26; h2 = d2 bit_and 0x3ffffff; d3 = d3 + c
        c = d3 shr 26; h3 = d3 bit_and 0x3ffffff; d4 = d4 + c
        c = d4 shr 26; h4 = d4 bit_and 0x3ffffff; h0 = h0 + c * 5
        c = h0 shr 26; h0 = h0 bit_and 0x3ffffff; h1 = h1 + c

        offset = offset + 16
    end

    st.h0 = h0; st.h1 = h1; st.h2 = h2; st.h3 = h3; st.h4 = h4
end.

func poly1305_mac(key: Vec, msg: Vec):
    st = _poly1305_init(key)
    msg_len = vec_len(msg)
    full = (msg_len / 16) * 16
    if full > 0 do
        _poly1305_blocks(st, msg, 0, full, 1 shl 24)
    end

    # Final partial block (pad with 0x01 then zeros) — MUST NOT be skipped
    if full < msg_len do
        block = vec_new()
        i = full
        when i < msg_len loop
            vec_push(block, vec_get(msg, i))
            i = i + 1
        end
        vec_push(block, 1)
        when vec_len(block) < 16 loop
            vec_push(block, 0)
        end
        _poly1305_blocks(st, block, 0, 16, 0)
    end

    # Fully carry h
    h0 = st.h0; h1 = st.h1; h2 = st.h2; h3 = st.h3; h4 = st.h4
    c = h1 shr 26; h1 = h1 bit_and 0x3ffffff; h2 = h2 + c
    c = h2 shr 26; h2 = h2 bit_and 0x3ffffff; h3 = h3 + c
    c = h3 shr 26; h3 = h3 bit_and 0x3ffffff; h4 = h4 + c
    c = h4 shr 26; h4 = h4 bit_and 0x3ffffff; h0 = h0 + c * 5
    c = h0 shr 26; h0 = h0 bit_and 0x3ffffff; h1 = h1 + c

    # h + -p
    g0 = h0 + 5
    c = g0 shr 26; g0 = g0 bit_and 0x3ffffff
    g1 = h1 + c; c = g1 shr 26; g1 = g1 bit_and 0x3ffffff
    g2 = h2 + c; c = g2 shr 26; g2 = g2 bit_and 0x3ffffff
    g3 = h3 + c; c = g3 shr 26; g3 = g3 bit_and 0x3ffffff
    g4 = (h4 + c) bit_and 0x3ffffff
    # mask select: if g4 has bit 26 cleared relative to h, use g
    mask = (g4 shr 26) bit_xor 1
    mask = 0 - mask
    g0 = g0 bit_and mask; g1 = g1 bit_and mask; g2 = g2 bit_and mask
    g3 = g3 bit_and mask; g4 = g4 bit_and mask
    mask = mask bit_xor (-1)
    h0 = (h0 bit_and mask) bit_or g0
    h1 = (h1 bit_and mask) bit_or g1
    h2 = (h2 bit_and mask) bit_or g2
    h3 = (h3 bit_and mask) bit_or g3
    h4 = (h4 bit_and mask) bit_or g4

    # h = h % (2^128)
    h0 = ((h0) bit_or (h1 shl 26)) bit_and 0xFFFFFFFF
    h1 = ((h1 shr 6) bit_or (h2 shl 20)) bit_and 0xFFFFFFFF
    h2 = ((h2 shr 12) bit_or (h3 shl 14)) bit_and 0xFFFFFFFF
    h3 = ((h3 shr 18) bit_or (h4 shl 8)) bit_and 0xFFFFFFFF

    # tag = (h + pad) mod 2^128
    f = h0 + st.pad0
    h0 = f bit_and 0xFFFFFFFF
    f = h1 + st.pad1 + (f shr 32)
    h1 = f bit_and 0xFFFFFFFF
    f = h2 + st.pad2 + (f shr 32)
    h2 = f bit_and 0xFFFFFFFF
    f = h3 + st.pad3 + (f shr 32)
    h3 = f bit_and 0xFFFFFFFF

    tag = vec_new()
    _u32_to_le(tag, h0)
    _u32_to_le(tag, h1)
    _u32_to_le(tag, h2)
    _u32_to_le(tag, h3)
    out tag
end.
# ═══════════════════════════════════════════════════════
# AEAD: ChaCha20-Poly1305 (RFC 8439)
# ═══════════════════════════════════════════════════════

entity AeadResult:
    ciphertext: Vec,
        tag:        Vec
end.
func chacha20_poly1305_encrypt:
    in  key: Vec
        nonce: Vec
        plaintext: Vec
        aad: Vec

    # Generate Poly1305 key (first block with counter=0)
    poly_key = _chacha20_block(key, 0, nonce)
    # Take first 32 bytes
    mac_key = vec_new()
    i = 0
    when i < 32 loop
        vec_push(mac_key, vec_get(poly_key, i))
        i = i + 1
    end

    # Encrypt with counter starting at 1
    ct = chacha20_encrypt(key, nonce, plaintext)

    # Build MAC input: AAD || pad || ciphertext || pad || len(AAD) || len(CT)
    mac_input = vec_new()
    i = 0
    when i < vec_len(aad) loop
        vec_push(mac_input, vec_get(aad, i))
        i = i + 1
    end
    # Pad AAD to 16-byte boundary
    when vec_len(mac_input) % 16 != 0 loop
        vec_push(mac_input, 0)
    end
    # Ciphertext
    i = 0
    when i < vec_len(ct) loop
        vec_push(mac_input, vec_get(ct, i))
        i = i + 1
    end
    # Pad CT to 16-byte boundary
    when vec_len(mac_input) % 16 != 0 loop
        vec_push(mac_input, 0)
    end
    # len(AAD) as 8 bytes LE
    aad_len = vec_len(aad)
    _u32_to_le(mac_input, aad_len % 4294967296)
    _u32_to_le(mac_input, aad_len / 4294967296)
    # len(CT) as 8 bytes LE
    ct_len = vec_len(ct)
    _u32_to_le(mac_input, ct_len % 4294967296)
    _u32_to_le(mac_input, ct_len / 4294967296)

    tag = poly1305_mac(mac_key, mac_input)

    out AeadResult ( ciphertext: ct, tag: tag )
end.
func chacha20_poly1305_decrypt:
    in  key: Vec
        nonce: Vec
        ciphertext: Vec
        aad: Vec
        tag: Vec

    # Generate Poly1305 key
    poly_key = _chacha20_block(key, 0, nonce)
    mac_key = vec_new()
    i = 0
    when i < 32 loop
        vec_push(mac_key, vec_get(poly_key, i))
        i = i + 1
    end

    # Verify MAC
    mac_input = vec_new()
    i = 0
    when i < vec_len(aad) loop
        vec_push(mac_input, vec_get(aad, i))
        i = i + 1
    end
    when vec_len(mac_input) % 16 != 0 loop
        vec_push(mac_input, 0)
    end
    i = 0
    when i < vec_len(ciphertext) loop
        vec_push(mac_input, vec_get(ciphertext, i))
        i = i + 1
    end
    when vec_len(mac_input) % 16 != 0 loop
        vec_push(mac_input, 0)
    end
    aad_len = vec_len(aad)
    _u32_to_le(mac_input, aad_len % 4294967296)
    _u32_to_le(mac_input, aad_len / 4294967296)
    ct_len = vec_len(ciphertext)
    _u32_to_le(mac_input, ct_len % 4294967296)
    _u32_to_le(mac_input, ct_len / 4294967296)

    computed_tag = poly1305_mac(mac_key, mac_input)

    # CRITICAL: reject wrong tag length (empty tag must NOT authenticate)
    if vec_len(tag) != POLY1305_TAG_LEN do
        out vec_new()
    end
    if vec_len(computed_tag) != POLY1305_TAG_LEN do
        out vec_new()
    end

    # Constant-time compare over exactly 16 bytes
    diff = 0
    i = 0
    when i < POLY1305_TAG_LEN loop
        diff = diff bit_or _u32_xor(vec_get(tag, i), vec_get(computed_tag, i))
        i = i + 1
    end

    if diff != 0 do
        out vec_new()
    end

    out chacha20_decrypt(key, nonce, ciphertext)
end.

export CHACHA_ROUNDS, CHACHA_KEY_LEN, CHACHA_NONCE_LEN, POLY1305_TAG_LEN
export chacha20_crypt, chacha20_encrypt, chacha20_decrypt
export poly1305_mac, chacha20_poly1305_encrypt, chacha20_poly1305_decrypt
