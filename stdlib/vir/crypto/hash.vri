func _w64_get(wp: ptr, i: int):
    out read_byte(wp, i * 8) bit_or
        (read_byte(wp, i * 8 + 1) shl 8) bit_or
        (read_byte(wp, i * 8 + 2) shl 16) bit_or
        (read_byte(wp, i * 8 + 3) shl 24) bit_or
        (read_byte(wp, i * 8 + 4) shl 32) bit_or
        (read_byte(wp, i * 8 + 5) shl 40) bit_or
        (read_byte(wp, i * 8 + 6) shl 48) bit_or
        (read_byte(wp, i * 8 + 7) shl 56)
end.

func _w64_set(wp: ptr, i: int, v: int):
    write_byte(wp, i * 8, v bit_and 255)
    write_byte(wp, i * 8 + 1, (v shr 8) bit_and 255)
    write_byte(wp, i * 8 + 2, (v shr 16) bit_and 255)
    write_byte(wp, i * 8 + 3, (v shr 24) bit_and 255)
    write_byte(wp, i * 8 + 4, (v shr 32) bit_and 255)
    write_byte(wp, i * 8 + 5, (v shr 40) bit_and 255)
    write_byte(wp, i * 8 + 6, (v shr 48) bit_and 255)
    write_byte(wp, i * 8 + 7, (v shr 56) bit_and 255)
end.

func sha512_new:
    let buf = alloc(128)
    _buf_zero(buf, 128)
    out Sha512(
        h0 = 0x6a09e667f3bcc908, h1 = 0xbb67ae8584caa73b,
        h2 = 0x3c6ef372fe94f82b, h3 = 0xa54ff53a5f1d36f1,
        h4 = 0x510e527fade682d1, h5 = 0x9b05688c2b3e6c1f,
        h6 = 0x1f83d9abfb41bd6b, h7 = 0x5be0cd19137e2179,
        buf = buf, buf_len = 0, total = 0, finalized = 0
    )
end.

func _sha512_compress(ref ctx: Sha512):
    let wp = alloc(80 * 8)
    i = 0
    when i < 16 loop
        word = ((read_byte(ctx.buf, i * 8) bit_and 255) shl 56) bit_or
               ((read_byte(ctx.buf, i * 8 + 1) bit_and 255) shl 48) bit_or
               ((read_byte(ctx.buf, i * 8 + 2) bit_and 255) shl 40) bit_or
               ((read_byte(ctx.buf, i * 8 + 3) bit_and 255) shl 32) bit_or
               ((read_byte(ctx.buf, i * 8 + 4) bit_and 255) shl 24) bit_or
               ((read_byte(ctx.buf, i * 8 + 5) bit_and 255) shl 16) bit_or
               ((read_byte(ctx.buf, i * 8 + 6) bit_and 255) shl 8) bit_or
               (read_byte(ctx.buf, i * 8 + 7) bit_and 255)
        _w64_set(wp, i, word)
        i = i + 1
    end
    when i < 80 loop
        w15 = _w64_get(wp, i - 15)
        w2 = _w64_get(wp, i - 2)
        s0 = _rotr64(w15, 1) bit_xor _rotr64(w15, 8) bit_xor (w15 shr 7)
        s1 = _rotr64(w2, 19) bit_xor _rotr64(w2, 61) bit_xor (w2 shr 6)
        _w64_set(wp, i, _w64_get(wp, i - 16) + s0 + _w64_get(wp, i - 7) + s1)
        i = i + 1
    end

    a = ctx.h0; b = ctx.h1; c = ctx.h2; d = ctx.h3
    e = ctx.h4; f = ctx.h5; g = ctx.h6; h = ctx.h7
    t = 0
    when t < 80 loop
        S1 = _rotr64(e, 14) bit_xor _rotr64(e, 18) bit_xor _rotr64(e, 41)
        ch = (e bit_and f) bit_xor (((e bit_xor (-1)) bit_and g))
        temp1 = h + S1 + ch + _sha512_k(t) + _w64_get(wp, t)
        S0 = _rotr64(a, 28) bit_xor _rotr64(a, 34) bit_xor _rotr64(a, 39)
        maj = (a bit_and b) bit_xor (a bit_and c) bit_xor (b bit_and c)
        temp2 = S0 + maj
        h = g; g = f; f = e; e = d + temp1
        d = c; c = b; b = a; a = temp1 + temp2
        t = t + 1
    end
    ctx.h0 = ctx.h0 + a
    ctx.h1 = ctx.h1 + b
    ctx.h2 = ctx.h2 + c
    ctx.h3 = ctx.h3 + d
    ctx.h4 = ctx.h4 + e
    ctx.h5 = ctx.h5 + f
    ctx.h6 = ctx.h6 + g
    ctx.h7 = ctx.h7 + h
end.

func sha512_update(ref ctx: Sha512, data: [int], len: int):
    if ctx.finalized != 0 do out end
    if len < 0 do out end
    i = 0
    when i < len loop
        write_byte(ctx.buf, ctx.buf_len, data[i] bit_and 255)
        ctx.buf_len = ctx.buf_len + 1
        ctx.total = ctx.total + 1
        if ctx.buf_len == 128 do
            _sha512_compress(ctx)
            ctx.buf_len = 0
        end
        i = i + 1
    end
end.

func sha512_finish(ref ctx: Sha512):
    let dig = alloc(HASH_SHA512_LEN)
    _buf_zero(dig, HASH_SHA512_LEN)
    if ctx.finalized != 0 do
        out dig
    end
    total_bits = ctx.total * 8
    write_byte(ctx.buf, ctx.buf_len, 0x80)
    ctx.buf_len = ctx.buf_len + 1
    if ctx.buf_len > 112 do
        when ctx.buf_len < 128 loop
            write_byte(ctx.buf, ctx.buf_len, 0)
            ctx.buf_len = ctx.buf_len + 1
        end
        _sha512_compress(ctx)
        ctx.buf_len = 0
    end
    when ctx.buf_len < 112 loop
        write_byte(ctx.buf, ctx.buf_len, 0)
        ctx.buf_len = ctx.buf_len + 1
    end
    i = 112
    when i < 120 loop
        write_byte(ctx.buf, i, 0)
        i = i + 1
    end
    write_byte(ctx.buf, 120, (total_bits shr 56) bit_and 255)
    write_byte(ctx.buf, 121, (total_bits shr 48) bit_and 255)
    write_byte(ctx.buf, 122, (total_bits shr 40) bit_and 255)
    write_byte(ctx.buf, 123, (total_bits shr 32) bit_and 255)
    write_byte(ctx.buf, 124, (total_bits shr 24) bit_and 255)
    write_byte(ctx.buf, 125, (total_bits shr 16) bit_and 255)
    write_byte(ctx.buf, 126, (total_bits shr 8) bit_and 255)
    write_byte(ctx.buf, 127, total_bits bit_and 255)
    _sha512_compress(ctx)
    ctx.finalized = 1

    # Unrolled — avoid relying on temp arrays for 64-bit state words.
    v = ctx.h0
    write_byte(dig, 0, (v shr 56) bit_and 255)
    write_byte(dig, 1, (v shr 48) bit_and 255)
    write_byte(dig, 2, (v shr 40) bit_and 255)
    write_byte(dig, 3, (v shr 32) bit_and 255)
    write_byte(dig, 4, (v shr 24) bit_and 255)
    write_byte(dig, 5, (v shr 16) bit_and 255)
    write_byte(dig, 6, (v shr 8) bit_and 255)
    write_byte(dig, 7, v bit_and 255)
    v = ctx.h1
    write_byte(dig, 8, (v shr 56) bit_and 255)
    write_byte(dig, 9, (v shr 48) bit_and 255)
    write_byte(dig, 10, (v shr 40) bit_and 255)
    write_byte(dig, 11, (v shr 32) bit_and 255)
    write_byte(dig, 12, (v shr 24) bit_and 255)
    write_byte(dig, 13, (v shr 16) bit_and 255)
    write_byte(dig, 14, (v shr 8) bit_and 255)
    write_byte(dig, 15, v bit_and 255)
    v = ctx.h2
    write_byte(dig, 16, (v shr 56) bit_and 255)
    write_byte(dig, 17, (v shr 48) bit_and 255)
    write_byte(dig, 18, (v shr 40) bit_and 255)
    write_byte(dig, 19, (v shr 32) bit_and 255)
    write_byte(dig, 20, (v shr 24) bit_and 255)
    write_byte(dig, 21, (v shr 16) bit_and 255)
    write_byte(dig, 22, (v shr 8) bit_and 255)
    write_byte(dig, 23, v bit_and 255)
    v = ctx.h3
    write_byte(dig, 24, (v shr 56) bit_and 255)
    write_byte(dig, 25, (v shr 48) bit_and 255)
    write_byte(dig, 26, (v shr 40) bit_and 255)
    write_byte(dig, 27, (v shr 32) bit_and 255)
    write_byte(dig, 28, (v shr 24) bit_and 255)
    write_byte(dig, 29, (v shr 16) bit_and 255)
    write_byte(dig, 30, (v shr 8) bit_and 255)
    write_byte(dig, 31, v bit_and 255)
    v = ctx.h4
    write_byte(dig, 32, (v shr 56) bit_and 255)
    write_byte(dig, 33, (v shr 48) bit_and 255)
    write_byte(dig, 34, (v shr 40) bit_and 255)
    write_byte(dig, 35, (v shr 32) bit_and 255)
    write_byte(dig, 36, (v shr 24) bit_and 255)
    write_byte(dig, 37, (v shr 16) bit_and 255)
    write_byte(dig, 38, (v shr 8) bit_and 255)
    write_byte(dig, 39, v bit_and 255)
    v = ctx.h5
    write_byte(dig, 40, (v shr 56) bit_and 255)
    write_byte(dig, 41, (v shr 48) bit_and 255)
    write_byte(dig, 42, (v shr 40) bit_and 255)
    write_byte(dig, 43, (v shr 32) bit_and 255)
    write_byte(dig, 44, (v shr 24) bit_and 255)
    write_byte(dig, 45, (v shr 16) bit_and 255)
    write_byte(dig, 46, (v shr 8) bit_and 255)
    write_byte(dig, 47, v bit_and 255)
    v = ctx.h6
    write_byte(dig, 48, (v shr 56) bit_and 255)
    write_byte(dig, 49, (v shr 48) bit_and 255)
    write_byte(dig, 50, (v shr 40) bit_and 255)
    write_byte(dig, 51, (v shr 32) bit_and 255)
    write_byte(dig, 52, (v shr 24) bit_and 255)
    write_byte(dig, 53, (v shr 16) bit_and 255)
    write_byte(dig, 54, (v shr 8) bit_and 255)
    write_byte(dig, 55, v bit_and 255)
    v = ctx.h7
    write_byte(dig, 56, (v shr 56) bit_and 255)
    write_byte(dig, 57, (v shr 48) bit_and 255)
    write_byte(dig, 58, (v shr 40) bit_and 255)
    write_byte(dig, 59, (v shr 32) bit_and 255)
    write_byte(dig, 60, (v shr 24) bit_and 255)
    write_byte(dig, 61, (v shr 16) bit_and 255)
    write_byte(dig, 62, (v shr 8) bit_and 255)
    write_byte(dig, 63, v bit_and 255)
    out dig
end.

func sha512(data: [int], len: int):
    if len < 0 do
        out _digest_ptr_to_arr(alloc(HASH_SHA512_LEN), HASH_SHA512_LEN)
    end
    var ctx = sha512_new()
    sha512_update(ctx, data, len)
    let dig = sha512_finish(ctx)
    out _digest_ptr_to_arr(dig, HASH_SHA512_LEN)
end.

func sha512_hash(data: [int], len: int):
    out sha512(data, len)
end.

func sha512_hex(data: [int], len: int):
    dig = sha512(data, len)
    out hash_bytes_to_hex(dig, HASH_SHA512_LEN)
end.

export sha256, sha256_new, sha256_update, sha256_finish, sha256_hash, sha256_hex
export sha512, sha512_new, sha512_update, sha512_finish, sha512_hash, sha512_hex
export hash_bytes_to_hex, HASH_SHA256_LEN, HASH_SHA512_LEN
export Sha256, Sha512
