##
 * vir/crypto/rsa.vri — RSA Encryption & Signatures
 * =================================================
 * Inspired by Rust: rsa crate
 * Inspired by Go: crypto/rsa
 *
 * Phase D — RSA key generation (basic), PKCS#1 v1.5 sign/verify,
 * OAEP encrypt/decrypt. Uses BigInt for modular arithmetic.
 ##

include types
include option
import Option, Some, None, is_some, is_none, unwrap from option
include vec
import Vec, vec_new, vec_push, vec_get, vec_len from vec
include math.bigint
import BigInt, bi_from_int, bi_add, bi_sub, bi_mul, bi_div, bi_mod,
       bi_cmp, bi_eq, bi_to_string from math.bigint
include crypto.crypto
import sha256_hash from crypto.crypto
include builder
import StringBuilder, sb_new, sb_append, sb_append_byte, sb_build, sb_free from builder

# ═══════════════════════════════════════════════════════
# RSA Key entities
# ═══════════════════════════════════════════════════════

entity RsaPublicKey:
    n: BigInt;       # modulus
    e: BigInt;       # public exponent (typically 65537)
end.
entity RsaPrivateKey:
    n: BigInt;       # modulus
    e: BigInt;       # public exponent
    d: BigInt;       # private exponent
    p: BigInt;       # prime factor 1
    q: BigInt;       # prime factor 2
end.
entity RsaKeyPair:
    public:  RsaPublicKey,
        private: RsaPrivateKey
end.

# ═══════════════════════════════════════════════════════
# Modular exponentiation: base^exp mod modulus
# ═══════════════════════════════════════════════════════

func _bi_mod_exp:
    in  base: BigInt
        exp: BigInt
        modulus: BigInt
    result = bi_from_int(1)
    b = bi_mod(base, modulus)
    e = exp
    zero = bi_from_int(0)
    two = bi_from_int(2)

    when bi_cmp(e, zero) > 0 loop
        # If exp is odd
        remainder = bi_mod(e, two)
        if bi_eq(remainder, bi_from_int(1)) do
            result = bi_mod(bi_mul(result, b), modulus)
        end
        e = bi_div(e, two)
        b = bi_mod(bi_mul(b, b), modulus)
    end
    out result
end.
# ═══════════════════════════════════════════════════════
# Extended GCD for modular inverse
# ═══════════════════════════════════════════════════════

func _bi_mod_inverse(a: BigInt, m: BigInt):
    # Extended Euclidean: find x such that a*x ≡ 1 (mod m)
    zero = bi_from_int(0)
    one = bi_from_int(1)
    old_r = a
    r = m
    old_s = one
    s = zero

    when bi_cmp(r, zero) != 0 loop
        quotient = bi_div(old_r, r)
        temp_r = r
        r = bi_sub(old_r, bi_mul(quotient, r))
        old_r = temp_r

        temp_s = s
        s = bi_sub(old_s, bi_mul(quotient, s))
        old_s = temp_s
    end

    if bi_cmp(old_s, zero) < 0 do
        old_s = bi_add(old_s, m)
    end
    out old_s
end.
# ═══════════════════════════════════════════════════════
# Key generation (simplified — uses provided primes)
# ═══════════════════════════════════════════════════════

func rsa_keygen_from_primes(p: BigInt, q: BigInt):
    one = bi_from_int(1)
    n = bi_mul(p, q)
    phi = bi_mul(bi_sub(p, one), bi_sub(q, one))
    e = bi_from_int(65537)
    d = _bi_mod_inverse(e, phi)

    pub = RsaPublicKey ( n: n, e: e )
    priv = RsaPrivateKey ( n: n, e: e, d: d, p: p, q: q )
    out RsaKeyPair ( public: pub, private: priv )
end.
# ═══════════════════════════════════════════════════════
# Raw RSA — UNSAFE (no padding / no blinding)
# Prefer rsa_sign_sha256 / rsa_verify_sha256 (PKCS#1 v1.5).
# ═══════════════════════════════════════════════════════

func rsa_encrypt_raw_unsafe(pub: RsaPublicKey, message: BigInt):
    out _bi_mod_exp(message, pub.e, pub.n)
end.
func rsa_decrypt_raw_unsafe(priv: RsaPrivateKey, ciphertext: BigInt):
    out _bi_mod_exp(ciphertext, priv.d, priv.n)
end.
func rsa_sign_raw_unsafe(priv: RsaPrivateKey, message_hash: BigInt):
    out _bi_mod_exp(message_hash, priv.d, priv.n)
end.
func rsa_verify_raw_unsafe:
    in  pub: RsaPublicKey
        message_hash: BigInt
        signature: BigInt
    recovered = _bi_mod_exp(signature, pub.e, pub.n)
    out bi_eq(recovered, message_hash)
end.

func _bi_byte_len(n: BigInt):
    zero = bi_from_int(0)
    two56 = bi_from_int(256)
    x = n
    len = 0
    when bi_cmp(x, zero) > 0 loop
        x = bi_div(x, two56)
        len = len + 1
    end
    out len
end.

func _bytes_to_bi(bytes: [int], len: int):
    v = bi_from_int(0)
    i = 0
    when i < len loop
        v = bi_add(bi_mul(v, bi_from_int(256)), bi_from_int(bytes[i] bit_and 255))
        i = i + 1
    end
    out v
end.

func _pkcs1_v15_emsa_sha256_fill(hash: [int], k: int, em: [int]):
    # Writes EMSA-PKCS1-v1_5 block into em[0..k). Returns k, or 0 on error.
    if k < 11 + 51 do
        out 0
    end
    if k > 512 do
        out 0
    end
    t_len = 51
    ps_len = k - 3 - t_len
    if ps_len < 8 do
        out 0
    end
    i = 0
    when i < k loop
        em[i] = 0
        i = i + 1
    end
    em[0] = 0x00
    em[1] = 0x01
    i = 0
    when i < ps_len loop
        em[2 + i] = 0xFF
        i = i + 1
    end
    em[2 + ps_len] = 0x00
    off = 3 + ps_len
    # DigestInfo prefix for SHA-256 (19 bytes)
    em[off + 0] = 0x30; em[off + 1] = 0x31; em[off + 2] = 0x30
    em[off + 3] = 0x0d; em[off + 4] = 0x06; em[off + 5] = 0x09
    em[off + 6] = 0x60; em[off + 7] = 0x86; em[off + 8] = 0x48
    em[off + 9] = 0x01; em[off + 10] = 0x65; em[off + 11] = 0x03
    em[off + 12] = 0x04; em[off + 13] = 0x02; em[off + 14] = 0x01
    em[off + 15] = 0x05; em[off + 16] = 0x00; em[off + 17] = 0x04
    em[off + 18] = 0x20
    j = 0
    when j < 32 loop
        em[off + 19 + j] = hash[j] bit_and 255
        j = j + 1
    end
    out k
end.

# ═══════════════════════════════════════════════════════
# PKCS#1 v1.5 signature (EMSA with DigestInfo)
# ═══════════════════════════════════════════════════════

func rsa_sign_sha256:
    in  priv: RsaPrivateKey
        data: string
        data_len: int
    hash = sha256_hash(data, data_len)
    k = _bi_byte_len(priv.n)
    var em: [int; 512]
    em_len = _pkcs1_v15_emsa_sha256_fill(hash, k, em)
    if em_len == 0 do
        out bi_from_int(0)
    end
    m = _bytes_to_bi(em, em_len)
    out rsa_sign_raw_unsafe(priv, m)
end.

func rsa_verify_sha256:
    in  pub: RsaPublicKey
        data: string
        data_len: int
        signature: BigInt
    hash = sha256_hash(data, data_len)
    k = _bi_byte_len(pub.n)
    var em: [int; 512]
    em_len = _pkcs1_v15_emsa_sha256_fill(hash, k, em)
    if em_len == 0 do
        out false
    end
    expect_bi = _bytes_to_bi(em, em_len)
    recovered = _bi_mod_exp(signature, pub.e, pub.n)
    out bi_eq(recovered, expect_bi)
end.
# ═══════════════════════════════════════════════════════
# Key accessors
# ═══════════════════════════════════════════════════════

func rsa_public_key(kp: RsaKeyPair):
    out kp.public
end.
func rsa_private_key(kp: RsaKeyPair):
    out kp.private
end.
func rsa_key_bits(pub: RsaPublicKey):
    # Approximate bit length from modulus
    s = bi_to_string(pub.n)
    out str_len(s) * 3;   # rough: log2(10) ≈ 3.32
end.