##
 * vir/crypto/x509.vri — X.509 Certificate Parsing & Validation
 * =============================================================
 * Inspired by Go: crypto/x509
 *
 * ⚠️  EXPERIMENTAL / INCOMPLETE
 * PEM unwrap + hostname matching helpers only. DER field extraction
 * and cryptographic chain validation are NOT implemented — x509_validate
 * always fails closed.
 ##

module vir.crypto.x509

include types
include option
import Option, Some, None, is_some, is_none, unwrap from option
include vec
import Vec, vec_new, vec_push, vec_get, vec_len from vec
include builder
import StringBuilder, sb_new, sb_append, sb_append_i64, sb_build, sb_free from builder

# ═══════════════════════════════════════════════════════
# ASN.1 tag constants
# ═══════════════════════════════════════════════════════

const ASN1_INTEGER          = 2
const ASN1_BIT_STRING       = 3
const ASN1_OCTET_STRING     = 4
const ASN1_NULL             = 5
const ASN1_OID              = 6
const ASN1_UTF8_STRING      = 12
const ASN1_PRINTABLE_STRING = 19
const ASN1_IA5_STRING       = 22
const ASN1_UTC_TIME         = 23
const ASN1_GENERALIZED_TIME = 24
const ASN1_SEQUENCE         = 48;  # 0x30
const ASN1_SET              = 49;  # 0x31

# ═══════════════════════════════════════════════════════
# ASN.1 DER TLV parser
# ═══════════════════════════════════════════════════════

entity Asn1Tlv:
    tag:    int,
        length: int,
        offset: int;      # offset of value in the data stream
    data:   string;   # raw bytes
end.
func asn1_parse_tlv(data: string, pos: int):
    tag = str_byte_at(data, pos)
    pos = pos + 1

    # Parse length
    first_len = str_byte_at(data, pos)
    pos = pos + 1
    length = 0

    if first_len < 128 do
        length = first_len
    else
        num_bytes = first_len & 127
        i = 0
        when i < num_bytes loop
            length = length * 256 + str_byte_at(data, pos)
            pos = pos + 1
            i = i + 1
        end
    end

    out Asn1Tlv (
        tag: tag,
        length: length,
        offset: pos,
        data: data
    )
end.
# ═══════════════════════════════════════════════════════
# X.509 Certificate fields
# ═══════════════════════════════════════════════════════

entity X509Name:
    common_name:  string,
        organization: string,
        country:      string,
        raw:          string
end.
entity X509Cert:
    version:      int;           # 1, 2, or 3
    serial:       string;        # serial number as hex
    issuer:       X509Name,
        subject:      X509Name,
        not_before:   string;        # UTC time string
    not_after:    string;        # UTC time string
    sig_algo:     string;        # e.g. "sha256WithRSAEncryption"
    pub_key_algo: string;        # e.g. "RSA", "EC"
    pub_key_bits: int,
        is_ca:        bool,
        dns_names:    Vec;           # Vec<string> — Subject Alternative Names
    raw_der:      string;        # raw DER bytes
end.
func x509_empty_name():
    out X509Name (
        common_name: "", organization: "", country: "", raw: ""
    )
end.

func x509_empty_cert():
    out X509Cert (
        version: 3,
        serial: "",
        issuer: x509_empty_name(),
        subject: x509_empty_name(),
        not_before: "",
        not_after: "",
        sig_algo: "",
        pub_key_algo: "",
        pub_key_bits: 0,
        is_ca: false,
        dns_names: vec_new(),
        raw_der: ""
    )
end.

# ═══════════════════════════════════════════════════════
# PEM decode
# ═══════════════════════════════════════════════════════

func pem_decode(pem_text: string):
    # Extract base64 content between -----BEGIN...---- and -----END...-----
    lines = vec_new()
    start = 0
    i = 0
    in_body = false
    len = str_len(pem_text)

    when i < len loop
        c = str_byte_at(pem_text, i)
        if c == 10 do # newline
            line = str_slice(pem_text, start, i)
            if str_starts_with(line, "-----BEGIN") do
                in_body = true
            eif str_starts_with(line, "-----END") do
                in_body = false
            eif in_body do
                vec_push(lines, line)
            end
            start = i + 1
        end
        i = i + 1
    end

    # Concatenate base64 lines
    sb = sb_new()
    j = 0
    when j < vec_len(lines) loop
        sb_append(sb, vec_get(lines, j))
        j = j + 1
    end
    result = sb_build(sb)
    sb_free(sb)
    out result;    # base64 encoded DER
end.

func x509_parse_pem(pem: string):
    # PEM unwrap only — does NOT parse ASN.1/DER fields or verify signatures.
    cert = x509_empty_cert()
    cert.raw_der = pem_decode(pem)
    out cert
end.

# ═══════════════════════════════════════════════════════
# Certificate chain validation
# ═══════════════════════════════════════════════════════

entity CertPool:
    certs: Vec;     # Vec<X509Cert>
end.
func certpool_new():
    out CertPool ( certs: vec_new() )
end.
func certpool_add(pool: CertPool, cert: X509Cert):
    vec_push(pool.certs, cert)
end.
func certpool_find_issuer(pool: CertPool, subject_issuer: X509Name):
    i = 0
    when i < vec_len(pool.certs) loop
        cert = vec_get(pool.certs, i)
        if str_eq(cert.subject.common_name, subject_issuer.common_name) do
            out Some(cert)
        end
        i = i + 1
    end
    out None
end.
# ═══════════════════════════════════════════════════════
# Validation result
# ═══════════════════════════════════════════════════════

entity CertValidation:
    valid:   bool,
        error:   string,
        chain:   Vec;      # Vec<X509Cert>
end.
func x509_validate:
    in  cert: X509Cert
        roots: CertPool
        now_timestamp: int
    # FAIL-CLOSED: no DER field parse, no signature check, no expiry/CA
    # path validation. Never claim success until a real verifier exists.
    chain = vec_new()
    vec_push(chain, cert)
    out CertValidation (
        valid: false,
        error: "x509_validate: signature/chain verification not implemented",
        chain: chain
    )
end.

func _dns_label_count(s: string):
    if str_len(s) == 0 do
        out 0
    end
    n = 1
    i = 0
    when i < str_len(s) loop
        if str_byte_at(s, i) == 46 do
            n = n + 1
        end
        i = i + 1
    end
    out n
end.

func _wildcard_matches(pattern: string, hostname: string):
    # RFC 6125: only leftmost label may be '*'; must match exactly one label.
    # Reject: *.example.com vs evilexample.com (suffix without leading '.')
    if str_starts_with(pattern, "*.") == false do
        out false
    end
    if str_starts_with(hostname, ".") do
        out false
    end
    suffix = str_slice(pattern, 1, str_len(pattern))
    # suffix begins with '.'  e.g. ".example.com"
    if str_ends_with(hostname, suffix) == false do
        out false
    end
    # hostname must have exactly one more label than the suffix domain
    # pattern "*.example.com" → 3 labels; host "a.example.com" → 3 labels
    if _dns_label_count(hostname) != _dns_label_count(pattern) do
        out false
    end
    # left label must not contain '.'
    host_prefix_len = str_len(hostname) - str_len(suffix)
    if host_prefix_len <= 0 do
        out false
    end
    j = 0
    when j < host_prefix_len loop
        if str_byte_at(hostname, j) == 46 do
            out false
        end
        j = j + 1
    end
    out true
end.

func x509_matches_hostname(cert: X509Cert, hostname: string):
    # Check SANs first, then CN (exact only — CN wildcards still use helper)
    i = 0
    when i < vec_len(cert.dns_names) loop
        san = vec_get(cert.dns_names, i)
        if str_eq(san, hostname) do
            out true
        end
        if _wildcard_matches(san, hostname) do
            out true
        end
        i = i + 1
    end
    cn = cert.subject.common_name
    if str_eq(cn, hostname) do
        out true
    end
    out _wildcard_matches(cn, hostname)
end.

export Asn1Tlv, asn1_parse_tlv, pem_decode
export X509Name, X509Cert, x509_empty_name, x509_empty_cert, x509_parse_pem
export CertPool, certpool_new, certpool_add, certpool_find_issuer
export CertValidation, x509_validate, x509_matches_hostname