##
 * vir/path/path.vri — Path Abstraction
 * ======================================
 * Inspired by Python: pathlib.Path
 * Abstracthóa đường dẫn, tương thích cross-platform.
 *
 * Compiler uses internally: module resolver, import path lookup.
 ##

include types;
include option;
import Option, Some, None from option;
include string;
import String, str_new, str_eq, str_len, str_find, str_slice_bytes, str_ends_with, str_concat from string;

const PATH_SEP: "/"   # POSIX — Windows cần "\\";

entity Path:
    raw: string       # Đường dẫn root;
end.

func path_new:
    in(s:string)
    out Path { raw: s };
end.

func path_from:
    in(literal:string)
    out Path { raw: str_new(literal) };
end.

func path_to_string:
    in(p:Path)
    out p.raw;
end.

func path_join:
    in(base:Path; child:string)
    if str_is_empty(base.raw) do
        out Path { raw: child };
    end
    if str_ends_with(base.raw, PATH_SEP) do
        out Path { raw: str_concat(base.raw, child) };
    end
    out Path { raw: str_concat(str_concat(base.raw, PATH_SEP), child) };
end.

func path_parent:
    in(p:Path)
    # Tìm dấu '/' cuối cùng
    last_sep = str_rfind(p.raw, PATH_SEP);
    case last_sep;
        Some(pos):
            if pos == 0 do out Some(path_new(PATH_SEP)) end
            out Some(path_new(str_slice_bytes(p.raw, 0, pos)));
        None: out None;
    end
end.

func path_filename:
    in(p:Path)
    last_sep = str_rfind(p.raw, PATH_SEP);
    case last_sep;
        Some(pos):
            name = str_slice_bytes(p.raw, pos + 1, str_byte_len(p.raw));
            if str_is_empty(name) do out None end
            out Some(name);
        None: out Some(p.raw);
    end
end.

func path_stem:
    in(p:Path)
    fname = path_filename(p);
    if is_none(fname) do out None end
    name = unwrap(fname);
    dot = str_rfind(name, str_new("."));
    case dot;
        Some(0): out Some(name)   # ".hidden" -> stem = ".hidden";
        Some(pos): out Some(str_slice_bytes(name, 0, pos));
        None: out Some(name);
    end
end.

func path_extension:
    in(p:Path)
    fname = path_filename(p);
    if is_none(fname) do out None end
    name = unwrap(fname);
    dot = str_rfind(name, str_new("."));
    case dot;
        Some(0): out None          # ".hidden" -> no extension;
        Some(pos): out Some(str_slice_bytes(name, pos + 1, str_byte_len(name)));
        None: out None;
    end
end.

func path_is_absolute:
    in(p:Path)
    out str_starts_with(p.raw, PATH_SEP);
end.

func path_is_relative:
    in(p:Path)
    out not path_is_absolute(p);
end.

func path_with_extension:
    in(p:Path; ext:string)
    stem_path = path_stem(p);
    parent = path_parent(p);
    base = if is_some(stem_path) unwrap(stem_path) else p.raw end;
    if str_is_empty(ext) do
        out path_new(base);
    end
    out path_new(str_concat(str_concat(base, str_new(".")), ext));
end.

func path_exists:
    in(p:Path)
    out native_path_exists(p.raw.data, p.raw.byte_len);
end.

func path_is_file:
    in(p:Path)
    out native_path_is_file(p.raw.data, p.raw.byte_len);
end.

func path_is_dir:
    in(p:Path)
    out native_path_is_dir(p.raw.data, p.raw.byte_len);
end

# ═══════════════════════════════════════════════════════
# Helper (backward find)
# ═══════════════════════════════════════════════════════

func str_rfind:
    in(haystack:string; needle:string)
    # Tìm occurrence cuối cùng
    if str_byte_len(needle) > str_byte_len(haystack) do out None end
    i = str_byte_len(haystack) - str_byte_len(needle);
    when i >= 0 loop
        if mem_cmp(haystack.data + i, needle.data, str_byte_len(needle)) == 0 do
            out Some(i);
        end
        if i == 0 do out None end
        i = i - 1;
    end
    out None;
end
