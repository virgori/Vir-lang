# vir/path/path.vri — lexical Path (registry path.md)

include types
include option
import Option, Some, None, is_none, is_some, unwrap from option
include string
import str_new, str_concat, str_ends_with, str_is_empty, str_from_bytes from string

entity Path:
    raw: string
end.

func _pathCstrLen(data: int) -> int:
    if data == 0 do out 0 end
    n = 0
    when native_read_u8(data, n) != 0 loop
        n = n + 1
    end
    out n
end.

func _pathSliceBytes(s: string, start: int, stop: int) -> string:
    if start >= stop do out str_new("") end
    data = (s as ptr) as int
    out str_from_bytes((data + start) as ptr, stop - start)
end.

func _pathRfindByte(data: int, n: int, ch: int) -> Option of (int):
    i = n - 1
    when i >= 0 loop
        if native_read_u8(data, i) == ch do out Some(i) end
        i = i - 1
    end
    out None
end.

func _pathStartsWithSep(s: string) -> bool:
    data = (s as ptr) as int
    n = _pathCstrLen(data)
    if n == 0 do out false end
    out native_read_u8(data, 0) == 0x2F
end.

func _pathNew(s: string) -> Path:
    out Path ( raw: s )
end.

func _pathJoin(base: Path, child: string) -> Path:
    raw = base.raw
    if str_is_empty(raw) do out Path ( raw: child ) end
    if str_ends_with(raw, "/") do out Path ( raw: str_concat(raw, child) ) end
    mid = str_concat(raw, "/")
    out Path ( raw: str_concat(mid, child) )
end.

func _pathParent(p: Path) -> Option of (Path):
    raw = p.raw
    data = (raw as ptr) as int
    n = _pathCstrLen(data)
    last_sep = _pathRfindByte(data, n, 0x2F)
    case last_sep
        Some(pos):
            if pos == 0 do out Some(_pathNew("/")) end
            out Some(_pathNew(_pathSliceBytes(raw, 0, pos)))
        None: out None
    end
end.

func _pathName(p: Path) -> Option of (string):
    raw = p.raw
    data = (raw as ptr) as int
    n = _pathCstrLen(data)
    last_sep = _pathRfindByte(data, n, 0x2F)
    case last_sep
        Some(pos):
            name = _pathSliceBytes(raw, pos + 1, n)
            if str_is_empty(name) do out None end
            out Some(name)
        None: out Some(raw)
    end
end.

func _pathStem(p: Path) -> Option of (string):
    fname = _pathName(p)
    if is_none(fname) do out None end
    name = unwrap(fname)
    ndata = (name as ptr) as int
    nd = _pathCstrLen(ndata)
    dot = _pathRfindByte(ndata, nd, 0x2E)
    case dot
        None: out Some(name)
        Some(pos):
            if pos == 0 do out Some(name) end
            out Some(_pathSliceBytes(name, 0, pos))
    end
end.

func _pathExtension(p: Path) -> Option of (string):
    fname = _pathName(p)
    if is_none(fname) do out None end
    name = unwrap(fname)
    ndata = (name as ptr) as int
    nd = _pathCstrLen(ndata)
    dot = _pathRfindByte(ndata, nd, 0x2E)
    case dot
        None: out None
        Some(pos):
            if pos == 0 do out None end
            out Some(_pathSliceBytes(name, pos + 1, nd))
    end
end.

func _pathIsAbsolute(p: Path) -> bool:
    out _pathStartsWithSep(p.raw)
end.

func _pathIsRelative(p: Path) -> bool:
    out not _pathStartsWithSep(p.raw)
end.

func _pathAppendExt(base: string, ext_data: int, ext_len: int) -> Path:
    if ext_len == 0 do out _pathNew(base) end
    dotted = str_concat(base, str_new("."))
    ext = str_from_bytes(ext_data as ptr, ext_len)
    out _pathNew(str_concat(dotted, ext))
end.

func _pathWithExt(p: Path, ext: string) -> Path:
    raw = p.raw
    stem_opt = _pathStem(p)
    ext_data = (ext as ptr) as int
    ext_len = _pathCstrLen(ext_data)
    case stem_opt
        Some(st): out _pathAppendExt(st, ext_data, ext_len)
        None: out _pathAppendExt(raw, ext_data, ext_len)
    end
    out _pathNew(str_new(""))
end.

entity PathNamespace:
    method new(s: string) -> Path:
        let result = _pathNew(s)
        out result
    end.

    method join(base: Path, child: string) -> Path:
        let result = _pathJoin(base, child)
        out result
    end.

    method parent(p: Path):
        out _pathParent(p)
    end.

    method name(p: Path):
        out _pathName(p)
    end.

    method stem(p: Path):
        out _pathStem(p)
    end.

    method extension(p: Path):
        out _pathExtension(p)
    end.

    method withExt(p: Path, ext: string) -> Path:
        out _pathWithExt(p, ext)
    end.

    method isAbsolute(p: Path) -> bool:
        out _pathIsAbsolute(p)
    end.

    method isRelative(p: Path) -> bool:
        out _pathIsRelative(p)
    end.

    method string(p: Path) -> string:
        out p.raw
    end.
end.

var path: PathNamespace

# Migration wrappers until the compiler lowers `path.new(...)` as a method
# instead of treating `new` as an entity constructor.
func path_new(s: string) -> Path:
    let result = _pathNew(s)
    out result
end.

func path_join(base: Path, child: string) -> Path:
    let result = _pathJoin(base, child)
    out result
end.

func path_to_string(p: Path) -> string:
    out p.raw
end.

func path_name(p: Path):
    out _pathName(p)
end.

export Path, PathNamespace, path, path_new, path_join, path_to_string, path_name
