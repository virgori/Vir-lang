# virc_slim.vri - Slim bootstrap compiler (macOS ARM64 only)

# -- BEGIN vir/rt/syscall.vri --

enum Platform:
    MacOS_ARM64    = 0;
    MacOS_x86_64   = 1;
    Linux_ARM64    = 2;
    Linux_x86_64   = 3;
end

const HOST_PLATFORM = Platform::MacOS_ARM64;

const SYS_EXIT:         0x2000001;
const SYS_FORK:         0x2000002;
const SYS_READ:         0x2000003;
const SYS_WRITE:        0x2000004;
const SYS_OPEN:         0x2000005;
const SYS_CLOSE:        0x2000006;
const SYS_WAIT4:        0x2000007;
const SYS_UNLINK:       0x200000A;
const SYS_CHDIR:        0x200000C;
const SYS_FCHMOD:       0x200007C;
const SYS_CHMOD:        0x200000F;
const SYS_GETPID:       0x2000014;
const SYS_KILL:         0x2000025;
const SYS_DUP:          0x2000029;
const SYS_PIPE:         0x200002A;
const SYS_GETUID:       0x2000018;
const SYS_GETGID:       0x200002F;
const SYS_STAT64:       0x2000152;
const SYS_LSEEK:        0x20000C7;
const SYS_MMAP:         0x20000C5;
const SYS_MUNMAP:       0x2000049;
const SYS_MPROTECT:     0x200004A;
const SYS_IOCTL:        0x2000036;
const SYS_FCNTL:        0x200005C;
const SYS_FSTAT64:      0x2000153;
const SYS_MKDIR:        0x2000088;
const SYS_RMDIR:        0x2000089;
const SYS_RENAME:       0x2000080;
const SYS_FTRUNCATE:    0x20000C9;
const SYS_EXECVE:       0x200003B;
const SYS_GETCWD:       0x2000128;
const SYS_SOCKET:       0x2000061;
const SYS_CONNECT:      0x2000062;
const SYS_BIND:         0x2000068;
const SYS_LISTEN:       0x200006A;
const SYS_ACCEPT:       0x200001E;
const SYS_SENDTO:       0x2000085;
const SYS_RECVFROM:     0x200001D;
const SYS_KQUEUE:       0x200016A;
const SYS_KEVENT:       0x200016B;
const SYS_CLOCK_GETTIME: 0x20001A0;

const LINUX_SYS_READ:       63;
const LINUX_SYS_WRITE:      64;
const LINUX_SYS_OPENAT:     56;
const LINUX_SYS_CLOSE:      57;
const LINUX_SYS_FSTAT:      80;
const LINUX_SYS_LSEEK:      62;
const LINUX_SYS_MMAP:       222;
const LINUX_SYS_MUNMAP:     215;
const LINUX_SYS_MPROTECT:   226;
const LINUX_SYS_EXIT:       93;
const LINUX_SYS_EXIT_GROUP: 94;
const LINUX_SYS_FORK:       220;  
const LINUX_SYS_EXECVE:     221;
const LINUX_SYS_WAIT4:      260;
const LINUX_SYS_GETPID:     172;
const LINUX_SYS_KILL:       129;
const LINUX_SYS_PIPE2:      59;
const LINUX_SYS_GETCWD:     17;
const LINUX_SYS_MKDIR:      34;
const LINUX_SYS_RMDIR:      84; 
const LINUX_SYS_RENAME:     38; 
const LINUX_SYS_FCHMOD:     52;
const LINUX_SYS_SOCKET:     198;
const LINUX_SYS_CONNECT:    203;
const LINUX_SYS_BIND:       200;
const LINUX_SYS_LISTEN:     201;
const LINUX_SYS_ACCEPT:     202;
const LINUX_SYS_SENDTO:     206;
const LINUX_SYS_RECVFROM:   207;
const LINUX_SYS_EPOLL_CREATE1: 20;
const LINUX_SYS_EPOLL_CTL:    21;
const LINUX_SYS_EPOLL_WAIT:   22;

const O_RDONLY:    0x0000;
const O_WRONLY:    0x0001;
const O_RDWR:      0x0002;
const O_CREAT:     0x0200;   
const O_TRUNC:     0x0400;
const O_APPEND:    0x0008;   
const O_EXCL:      0x0800;

const LINUX_O_CREAT:  0x0040;
const LINUX_O_TRUNC:  0x0200;
const LINUX_O_APPEND: 0x0400;

const PROT_NONE:   0x0;
const PROT_READ:   0x1;
const PROT_WRITE:  0x2;
const PROT_EXEC:   0x4;

const MAP_PRIVATE:   0x02;
const MAP_ANONYMOUS: 0x1000;   
const MAP_FIXED:     0x10;

const LINUX_MAP_ANONYMOUS: 0x20;

const STDIN_FD:  0;
const STDOUT_FD: 1;
const STDERR_FD: 2;

extern func syscall0(num: int) -> int;
extern func syscall1(num: int, a0: int) -> int;
extern func syscall2(num: int, a0: int, a1: int) -> int;
extern func syscall3(num: int, a0: int, a1: int, a2: int) -> int;
extern func syscall4(num: int, a0: int, a1: int, a2: int, a3: int) -> int;
extern func syscall5(num: int, a0: int, a1: int, a2: int, a3: int, a4: int) -> int;
extern func syscall6(num: int, a0: int, a1: int, a2: int, a3: int, a4: int, a5: int) -> int;

func sys_exit:
    in(code: int)
    syscall1(SYS_EXIT, code);
end

func sys_getpid:
    out syscall0(SYS_GETPID);
end

func sys_fork:
    out syscall0(SYS_FORK);
end

func sys_kill:
    in(pid: int, sig: int)
    out syscall2(SYS_KILL, pid, sig);
end

func sys_wait4:
    in(pid: int, status_ptr: int, options: int)
    out syscall4(SYS_WAIT4, pid, status_ptr, options, 0);
end

func sys_execve:
    in(path: int, argv: int, envp: int)
    out syscall3(SYS_EXECVE, path, argv, envp);
end

func sys_read:
    in(fd: int, buf: int, count: int)
    out syscall3(SYS_READ, fd, buf, count);
end

func sys_write:
    in(fd: int, buf: int, count: int)
    out syscall3(SYS_WRITE, fd, buf, count);
end

func sys_open:
    in(path: int, flags: int, mode: int)
    out syscall3(SYS_OPEN, path, flags, mode);
end

func sys_close:
    in(fd: int)
    out syscall1(SYS_CLOSE, fd);
end

func sys_lseek:
    in(fd: int, offset: int, whence: int)
    out syscall3(SYS_LSEEK, fd, offset, whence);
end

func sys_fstat:
    in(fd: int, buf: int)
    out syscall2(SYS_FSTAT64, fd, buf);
end

func sys_ftruncate:
    in(fd: int, length: int)
    out syscall2(SYS_FTRUNCATE, fd, length);
end

func sys_unlink:
    in(path: int)
    out syscall1(SYS_UNLINK, path);
end

func sys_rename:
    in(old_path: int, new_path: int)
    out syscall2(SYS_RENAME, old_path, new_path);
end

func sys_mkdir:
    in(path: int, mode: int)
    out syscall2(SYS_MKDIR, path, mode);
end

func sys_rmdir:
    in(path: int)
    out syscall1(SYS_RMDIR, path);
end

func sys_getcwd:
    in(buf: int, size: int)
    out syscall2(SYS_GETCWD, buf, size);
end

func sys_chmod:
    in(path: int, mode: int)
    out syscall2(SYS_CHMOD, path, mode);
end

func sys_mmap:
    in(addr: int, length: int, prot: int, flags: int, fd: int, offset: int)
    out syscall6(SYS_MMAP, addr, length, prot, flags, fd, offset);
end

func sys_munmap:
    in(addr: int, length: int)
    out syscall2(SYS_MUNMAP, addr, length);
end

func sys_mprotect:
    in(addr: int, length: int, prot: int)
    out syscall3(SYS_MPROTECT, addr, length, prot);
end

func sys_pipe:
    in(fds: int)  
    out syscall1(SYS_PIPE, fds);
end

func sys_dup:
    in(fd: int)
    out syscall1(SYS_DUP, fd);
end

func sys_socket:
    in(domain: int, sock_type: int, protocol: int)
    out syscall3(SYS_SOCKET, domain, sock_type, protocol);
end

func sys_connect:
    in(fd: int, addr: int, addr_len: int)
    out syscall3(SYS_CONNECT, fd, addr, addr_len);
end

func sys_bind:
    in(fd: int, addr: int, addr_len: int)
    out syscall3(SYS_BIND, fd, addr, addr_len);
end

func sys_listen:
    in(fd: int, backlog: int)
    out syscall2(SYS_LISTEN, fd, backlog);
end

func sys_accept:
    in(fd: int, addr: int, addr_len: int)
    out syscall3(SYS_ACCEPT, fd, addr, addr_len);
end

func sys_sendto:
    in(fd: int, buf: int, len: int, flags: int, addr: int, addr_len: int)
    out syscall6(SYS_SENDTO, fd, buf, len, flags, addr, addr_len);
end

func sys_recvfrom:
    in(fd: int, buf: int, len: int, flags: int, addr: int, addr_len_ptr: int)
    out syscall6(SYS_RECVFROM, fd, buf, len, flags, addr, addr_len_ptr);
end

func sys_kqueue:
    out syscall0(SYS_KQUEUE);
end

func sys_kevent:
    in(kq: int, changelist: int, nchanges: int, eventlist: int, nevents: int, timeout: int)
    out syscall6(SYS_KEVENT, kq, changelist, nchanges, eventlist, nevents, timeout);
end

func sys_clock_gettime:
    in(clock_id: int, tp: int)
    out syscall2(SYS_CLOCK_GETTIME, clock_id, tp);
end

func write_stdout:
    in(data: int, len: int)
    sys_write(STDOUT_FD, data, len);
end

func write_stderr:
    in(data: int, len: int)
    sys_write(STDERR_FD, data, len);
end

func read_file_raw:
    in(path: int)
    let fd = sys_open(path, O_RDONLY, 0);
    if fd < 0:
        out 0;  
    end

    let end_pos = sys_lseek(fd, 0, 2);   
    sys_lseek(fd, 0, 0);                  

    let buf = sys_mmap(0, end_pos + 1,
                       PROT_READ | PROT_WRITE,
                       MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
    if buf < 0:
        sys_close(fd);
        out 0;
    end

    let total = 0;
    when total < end_pos loop
        let n = sys_read(fd, buf + total, end_pos - total);
        if n <= 0:
            out skip;
        end
        total = total + n;
    end

    extern func native_write_byte(addr: int, offset: int, val: int);
    native_write_byte(buf, end_pos, 0);

    sys_close(fd);
    out buf;  
end

func write_file_raw:
    in(path: int, data: int, len: int, mode: int)
    let fd = sys_open(path, O_WRONLY | O_CREAT | O_TRUNC, mode);
    if fd < 0:
        out -1;
    end

    let written = 0;
    when written < len loop
        let n = sys_write(fd, data + written, len - written);
        if n <= 0:
            out skip;
        end
        written = written + n;
    end

    sys_close(fd);
    out 0;
end

