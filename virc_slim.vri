end

func arm64_movz_imm64:
    in(cb:CodeBuf; rd:int; imm:int)
    uimm = imm;

    instr = 0xD2800000 | ((uimm & 0xFFFF) << 5) | (rd & 0x1F);
    cb = codebuf_emit_u32(cb, instr);

    if (uimm >> 16) != 0:
        instr = 0xF2A00000 | (((uimm >> 16) & 0xFFFF) << 5) | (rd & 0x1F);
        cb = codebuf_emit_u32(cb, instr);
    end

    if (uimm >> 32) != 0:
        instr = 0xF2C00000 | (((uimm >> 32) & 0xFFFF) << 5) | (rd & 0x1F);
        cb = codebuf_emit_u32(cb, instr);
    end

    if (uimm >> 48) != 0:
        instr = 0xF2E00000 | (((uimm >> 48) & 0xFFFF) << 5) | (rd & 0x1F);
        cb = codebuf_emit_u32(cb, instr);
    end

    out cb;
end

