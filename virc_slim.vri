    buf_write_u32_le, buf_write_u64_le, buf_write_zeros,;
    buf_write_string_padded, buf_write_bytes, buf_size, buf_align;
    file_create, file_write_all, file_close;

const MACHO_MAGIC: 0xFEEDFACF;
const CPU_ARM64: 0x0100000C;
const CPU_SUB_ALL: 0x00000000;
const MH_EXECUTE: 2;
const MH_FLAGS: 0x00200085   
const LC_SEGMENT_64: 0x19;
const LC_MAIN: 0x80000028;
const LC_SYMTAB: 0x02;
const TEXT_BASE: 0x100000000;
const PAGE_SIZE: 0x4000;

const SYS_EXIT: 0x2000001;
const SYS_WRITE: 0x2000004;
const SYS_CHMOD: 0x200000F;

entity FuncLayout:
    name:       string;
    code_off:   int   
    fsize:      int;
end

func emit_runtime_arm64:
    in(cb:CodeBuf)
    g_rt_print_off = codebuf_offset(cb);

    cb = arm64_stp_pre(cb, 29, 30, 31, -160)   
    cb = arm64_mov_sp_to(cb, 29)              
    cb = codebuf_emit_u32(cb, 0xA90153F3);
    cb = codebuf_emit_u32(cb, 0xA9025BF5);
    cb = codebuf_emit_u32(cb, 0xA90363F7);
    cb = codebuf_emit_u32(cb, 0xA9046BF9);
    cb = codebuf_emit_u32(cb, 0xA90573FB);
    cb = arm64_mov_rr(cb, 19, 0)              
    cb = arm64_mov_rr(cb, 27, 0)              

    cb = codebuf_emit_u32(cb, 0x91000000 | (96 << 10) | (31 << 5) | 20);
    cb = arm64_mov_imm16(cb, 21, 0)           
    cb = arm64_mov_imm16(cb, 22, 0)           

    cb = arm64_cmp_imm0(cb, 19);
    cb = codebuf_emit_u32(cb, 0x5400006A)  
    cb = codebuf_emit_u32(cb, 0xCB1303F3)  
    cb = arm64_mov_imm16(cb, 22, 1);

    zero_check_patch = codebuf_offset(cb);
    cb = codebuf_emit_u32(cb, 0xB4000013)      

    cb = arm64_mov_imm16(cb, 23, 10)            
    digit_loop = codebuf_offset(cb);
    digits_done_patch = codebuf_offset(cb);
    cb = codebuf_emit_u32(cb, 0xB4000013)      

    cb = codebuf_emit_u32(cb, 0x9AD70A78)      
    cb = codebuf_emit_u32(cb, 0x9B17CF19)      
    cb = codebuf_emit_u32(cb, 0x9100C339)      
    cb = codebuf_emit_u32(cb, 0x38356A99)      
    cb = codebuf_emit_u32(cb, 0x910006B5)      
    cb = arm64_mov_rr(cb, 19, 24);
    back = (digit_loop - codebuf_offset(cb)) / 4;
    cb = codebuf_emit_u32(cb, 0x14000000 | (back & 0x03FFFFFF));
    skip_zero_patch = codebuf_offset(cb);
    cb = codebuf_emit_u32(cb, 0x14000000)       

    is_zero = codebuf_offset(cb);
    cb = arm64_mov_imm16(cb, 25, 48)            
    cb = codebuf_emit_u32(cb, 0x38356A99)       
    cb = codebuf_emit_u32(cb, 0x910006B5)       

    reverse_start = codebuf_offset(cb);

    zc_off = (is_zero - zero_check_patch) / 4;
    cb = codebuf_patch_u32(cb, zero_check_patch,;
        0xB4000013 | ((zc_off & 0x7FFFF) << 5));

    dd_off = (reverse_start - digits_done_patch) / 4;
    cb = codebuf_patch_u32(cb, digits_done_patch,;
        0xB4000013 | ((dd_off & 0x7FFFF) << 5));

    sz_off = (reverse_start - skip_zero_patch) / 4;
    cb = codebuf_patch_u32(cb, skip_zero_patch,;
        0x14000000 | (sz_off & 0x03FFFFFF));

    skip_minus_patch = codebuf_offset(cb);
    cb = codebuf_emit_u32(cb, 0xB4000016)      
    cb = arm64_mov_imm16(cb, 25, 45)           
    cb = codebuf_emit_u32(cb, 0x38356A99)      
    cb = codebuf_emit_u32(cb, 0x910006B5)      
    skip_minus = codebuf_offset(cb);
    sm_off = (skip_minus - skip_minus_patch) / 4;
    cb = codebuf_patch_u32(cb, skip_minus_patch,;
        0xB4000016 | ((sm_off & 0x7FFFF) << 5));

    cb = arm64_mov_imm16(cb, 23, 0)            
    cb = arm64_mov_rr(cb, 24, 21)              
    cb = codebuf_emit_u32(cb, 0xD1000718)      

    rev_loop = codebuf_offset(cb);
    cb = codebuf_emit_u32(cb, 0xEB1802FF)      
    rev_done_patch = codebuf_offset(cb);
    cb = codebuf_emit_u32(cb, 0x5400000A)      

    cb = codebuf_emit_u32(cb, 0x38776A99)      
    cb = codebuf_emit_u32(cb, 0x38786A9A)      
    cb = codebuf_emit_u32(cb, 0x38376A9A)      
    cb = codebuf_emit_u32(cb, 0x38386A99)      
    cb = codebuf_emit_u32(cb, 0x910006F7)      
    cb = codebuf_emit_u32(cb, 0xD1000718)      
    rv_off = (rev_loop - codebuf_offset(cb)) / 4;
    cb = codebuf_emit_u32(cb, 0x14000000 | (rv_off & 0x03FFFFFF));

    rev_done = codebuf_offset(cb);
    rd_off = (rev_done - rev_done_patch) / 4;
    cb = codebuf_patch_u32(cb, rev_done_patch,;
        0x5400000A | ((rd_off & 0x7FFFF) << 5));

    cb = arm64_mov_imm16(cb, 25, 10);
    cb = codebuf_emit_u32(cb, 0x38356A99)      
    cb = codebuf_emit_u32(cb, 0x910006B5)      

    cb = arm64_mov_imm16(cb, 0, 1)             
    cb = arm64_mov_rr(cb, 1, 20)               
    cb = arm64_mov_rr(cb, 2, 21)               
    cb = arm64_mov_imm16(cb, 16, 4)            
    cb = codebuf_emit_u32(cb, 0xF2A04010)      

    cb = arm64_svc(cb, 128)                     

    cb = arm64_mov_rr(cb, 0, 27)              

    cb = codebuf_emit_u32(cb, 0xA94153F3);
    cb = codebuf_emit_u32(cb, 0xA9425BF5);
    cb = codebuf_emit_u32(cb, 0xA94363F7);
    cb = codebuf_emit_u32(cb, 0xA9446BF9);
    cb = codebuf_emit_u32(cb, 0xA94573FB);

    cb = arm64_ldp_post(cb, 29, 30, 31, 160)    
    cb = arm64_ret(cb);

    print_size = codebuf_offset(cb) - g_rt_print_off;

    cb.rt_printstr_off = codebuf_offset(cb);
    g_rt_printstr_off = cb.rt_printstr_off;
    cb = arm64_stp_pre(cb, 29, 30, 31, -16);
    cb = arm64_mov_rr(cb, 2, 1);              
    cb = arm64_mov_rr(cb, 1, 0);              
    cb = arm64_mov_imm16(cb, 0, 1);           
    cb = arm64_mov_imm16(cb, 16, 4);          
    cb = codebuf_emit_u32(cb, 0xF2A04010);    
    cb = arm64_svc(cb, 128);
    cb = arm64_mov_imm16(cb, 17, 10);
    cb = codebuf_emit_u32(cb, 0xD10043FF);    
    cb = codebuf_emit_u32(cb, 0x390003F1);    
    cb = arm64_mov_imm16(cb, 0, 1);           
    cb = arm64_mov_sp_to(cb, 1);              
    cb = arm64_mov_imm16(cb, 2, 1);           
    cb = arm64_mov_imm16(cb, 16, 4);
    cb = codebuf_emit_u32(cb, 0xF2A04010);
    cb = arm64_svc(cb, 128);
    cb = codebuf_emit_u32(cb, 0x910043FF);    
    cb = arm64_ldp_post(cb, 29, 30, 31, 16);
    cb = arm64_ret(cb);

    local_strlen_off = codebuf_offset(cb);
    cb = arm64_mov_rr(cb, 1, 0);               
    cb = codebuf_emit_u32(cb, 0x38401402);     
    cb = codebuf_emit_u32(cb, 0x35FFFFE2);     
    cb = arm64_sub_rrr(cb, 0, 0, 1);           
    cb = codebuf_emit_u32(cb, 0xD1000400);     
    cb = arm64_ret(cb);

    local_strcat_off = codebuf_offset(cb);
    cb = arm64_stp_pre(cb, 29, 30, 31, -48);   
    cb = codebuf_emit_u32(cb, 0xA90153F3);     
    cb = codebuf_emit_u32(cb, 0xA9025BF5);     
    cb = arm64_mov_rr(cb, 19, 0);              
    cb = arm64_mov_rr(cb, 20, 1);              
    strlen_bl1 = codebuf_offset(cb);
    strlen_delta1 = (local_strlen_off - strlen_bl1) / 4;
    cb = codebuf_emit_u32(cb, 0x94000000 | (strlen_delta1 & 0x03FFFFFF));
    cb = arm64_mov_rr(cb, 21, 0);              
    cb = arm64_mov_rr(cb, 0, 20);              
    strlen_bl2 = codebuf_offset(cb);
    strlen_delta2 = (local_strlen_off - strlen_bl2) / 4;
    cb = codebuf_emit_u32(cb, 0x94000000 | (strlen_delta2 & 0x03FFFFFF));
    cb = arm64_mov_rr(cb, 22, 0);              
    cb = arm64_add_rrr(cb, 2, 21, 22);         
    cb = codebuf_emit_u32(cb, 0x91000442);     
    cb = arm64_ldr_imm(cb, 3, 15, 0);          
    cb = arm64_mov_rr(cb, 4, 3);               
    cb = arm64_add_rrr(cb, 3, 3, 2);           
    cb = arm64_str_imm(cb, 3, 15, 0);          
    cb = arm64_mov_rr(cb, 0, 4);               
    cb = arm64_mov_rr(cb, 1, 19);              
    cb = arm64_mov_rr(cb, 2, 21);              
    cb = codebuf_emit_u32(cb, 0xB4000082);     
    cb = codebuf_emit_u32(cb, 0x38401423);     
    cb = codebuf_emit_u32(cb, 0x38001403);     
    cb = codebuf_emit_u32(cb, 0xD1000442);     
    cb = codebuf_emit_u32(cb, 0xB5FFFFA2);     
    cb = arm64_mov_rr(cb, 1, 20);              
    cb = arm64_mov_rr(cb, 2, 22);              
    cb = codebuf_emit_u32(cb, 0xB4000082);     
    cb = codebuf_emit_u32(cb, 0x38401423);     
    cb = codebuf_emit_u32(cb, 0x38001403);     
    cb = codebuf_emit_u32(cb, 0xD1000442);     
    cb = codebuf_emit_u32(cb, 0xB5FFFFA2);     
    cb = codebuf_emit_u32(cb, 0x3900001F);     
    cb = arm64_mov_rr(cb, 0, 4);               
    cb = codebuf_emit_u32(cb, 0xA9425BF5);     
    cb = codebuf_emit_u32(cb, 0xA94153F3);     
    cb = arm64_ldp_post(cb, 29, 30, 31, 48);   
    cb = arm64_ret(cb);

    cb.rt_exit_off = codebuf_offset(cb);
    g_rt_exit_off = cb.rt_exit_off;
    cb = arm64_mov_imm16(cb, 16, 1)            
    cb = codebuf_emit_u32(cb, 0xF2A04010)      
    cb = arm64_svc(cb, 128)                     

    out cb;
end

func codegen_emit_module:
    in(module:QModule; arch:TargetArch)
    cb = codebuf_new(arch);
    layouts = vec_new_rt();
    layout_count = 0;
    fixup_offsets = vec_new_rt();
    fixup_targets = vec_new_rt();
    fixup_count = 0;
    func_adr_patches = vec_new_rt();
    func_adr_targets = vec_new_rt();
    func_adr_dregs = vec_new_rt();
    main_idx = -1;
    ginit_idx = -1;

    max_gidx = -1;
    gi = 0;
    nfuncs_scan = vec_len_rt(module.functions);
    when gi < nfuncs_scan loop
        gfn = vec_get_rt(module.functions, gi);
        gj = 0;
        gbodylen = vec_len_rt(gfn.body);
        when gj < gbodylen loop
            gins = vec_get_rt(gfn.body, gj);
            if gins.opcode == QOp::LoadGlobal or gins.opcode == QOp::StoreGlobal:
                gval = gins.src1.imm_val;
                if gval > max_gidx:
                    max_gidx = gval;
                end
            end
            gj = gj + 1;
        end
        gi = gi + 1;
    end
    num_globals = max_gidx + 1;

    str_count = vec_len_rt(module.strings);
    str_globals_base = 1 + num_globals; 
    str_adr_patches = vec_new_rt();  
    str_adr_indices = vec_new_rt();  

    rt_print_off = codebuf_offset(cb);
    cb = emit_runtime_arm64(cb);
    rt_exit_off = cb.rt_exit_off;
    rt_printstr_off = cb.rt_printstr_off;
    rt_strlen_off = rt_exit_off - 172;
    rt_strcat_off = rt_exit_off - 148;
    runtime_size = codebuf_offset(cb);

    fi = 0;
    nfuncs = vec_len_rt(module.functions);
    when fi < nfuncs loop
        qfn = vec_get_rt(module.functions, fi);
        bodylen = vec_len_rt(qfn.body);
        func_start = codebuf_offset(cb);

        if rt_streq(qfn.name, "main") or rt_streq(qfn.name, "__main__"):
            main_idx = fi;
        end
        if rt_streq(qfn.name, "__ginit"):
            ginit_idx = fi;
        end

        needs_frame = 1;

        max_vreg = 0;
        vi = 0;
        when vi < bodylen loop
            vins = vec_get_rt(qfn.body, vi);
            if vins.dest.op_type == OperandType::VReg and vins.dest.vreg > max_vreg:
                max_vreg = vins.dest.vreg;
            end
            if vins.src1.op_type == OperandType::VReg and vins.src1.vreg > max_vreg:
                max_vreg = vins.src1.vreg;
            end
            if vins.src2.op_type == OperandType::VReg and vins.src2.vreg > max_vreg:
                max_vreg = vins.src2.vreg;
            end
            vi = vi + 1;
        end
        spill_count = 0;
        if max_vreg >= 16:
            spill_count = max_vreg - 15;
        end
        spill_extra = ((spill_count + 1) / 2) * 16;
        frame_size = 160 + spill_extra;

        if needs_frame == 1:
            cb = arm64_stp_pre(cb, 29, 30, 31, 0 - frame_size);
            cb = arm64_mov_sp_to(cb, 29);
            cb = codebuf_emit_u32(cb, 0xA90153F3);  
            cb = codebuf_emit_u32(cb, 0xA9025BF5);  
            cb = codebuf_emit_u32(cb, 0xA90363F7);  
            cb = codebuf_emit_u32(cb, 0xA9046BF9);  
            cb = codebuf_emit_u32(cb, 0xA90573FB);  
        end

        nparams = qfn.param_count;
        if nparams > 0:
            cb = arm64_mov_rr(cb, 19, 0);
        end
        if nparams > 1:
            cb = arm64_mov_rr(cb, 20, 1);
        end
        if nparams > 2:
            cb = arm64_mov_rr(cb, 21, 2);
        end
        if nparams > 3:
            cb = arm64_mov_rr(cb, 22, 3);
        end
        if nparams > 4:
            cb = arm64_mov_rr(cb, 23, 4);
        end
        if nparams > 5:
            cb = arm64_mov_rr(cb, 24, 5);
        end
        if nparams > 6:
            cb = arm64_mov_rr(cb, 25, 6);
        end
        if nparams > 7:
            cb = arm64_mov_rr(cb, 26, 7);
        end

        ps = patch_new();
        j = 0;
        when j < vec_len_rt(qfn.body) loop
            ins = vec_get_rt(qfn.body, j);

            handled = 0;
            if ins.opcode == QOp::Print:
                if ins.src1.op_type == OperandType::VReg:
                    if ins.src1.vreg >= 16:
                        cb = arm64_ldr_imm(cb, 8, 29, 160 + (ins.src1.vreg - 16) * 8);
                    end
                    cb = arm64_mov_rr(cb, 0, vreg_to_arm(ins.src1.vreg));
                end
                cb = codebuf_emit_u32(cb, 0xA9062BE9);  
                cb = codebuf_emit_u32(cb, 0xA90733EB);  
                cb = codebuf_emit_u32(cb, 0xA9083BED);  
                print_bl_off = codebuf_offset(cb);
                delta = (rt_print_off - print_bl_off) / 4;
                cb = codebuf_emit_u32(cb, 0x94000000 | (delta & 0x03FFFFFF));
                cb = codebuf_emit_u32(cb, 0xA9462BE9);  
                cb = codebuf_emit_u32(cb, 0xA94733EB);  
                cb = codebuf_emit_u32(cb, 0xA9483BED);  
                handled = 1;
            end
            if ins.opcode == QOp::Ret:
                if ins.src1.op_type == OperandType::VReg:
                    if ins.src1.vreg >= 16:
                        cb = arm64_ldr_imm(cb, 8, 29, 160 + (ins.src1.vreg - 16) * 8);
                    end
                    if vreg_to_arm(ins.src1.vreg) != 0:
                        cb = arm64_mov_rr(cb, 0, vreg_to_arm(ins.src1.vreg));
                    end
                end
                if needs_frame == 1:
                    cb = codebuf_emit_u32(cb, 0xA94153F3);  
                    cb = codebuf_emit_u32(cb, 0xA9425BF5);  
                    cb = codebuf_emit_u32(cb, 0xA94363F7);  
                    cb = codebuf_emit_u32(cb, 0xA9446BF9);  
                    cb = codebuf_emit_u32(cb, 0xA94573FB);  
                    cb = arm64_ldp_post(cb, 29, 30, 31, frame_size);
                end
                cb = arm64_ret(cb);
                handled = 1;
            end
            if ins.opcode == QOp::Exit:
                if ins.src1.op_type == OperandType::VReg:
                    cb = arm64_mov_rr(cb, 0, vreg_to_arm(ins.src1.vreg));
                end
                exit_bl_off = codebuf_offset(cb);
                delta = (rt_exit_off - exit_bl_off) / 4;
                cb = codebuf_emit_u32(cb, 0x94000000 | (delta & 0x03FFFFFF));
                handled = 1;
            end
            if ins.opcode == QOp::Halt:
                cb = arm64_mov_imm16(cb, 0, 0);
                cb = arm64_ret(cb);
                handled = 1;
            end
            if ins.opcode == QOp::Label:
                ps = patch_add_label(ps, ins.dest.vreg, codebuf_offset(cb));
                handled = 1;
            end
            if ins.opcode == QOp::Jump:
                if ins.src1.op_type == OperandType::LabelRef:
                    ps = patch_add_fixup(ps, codebuf_offset(cb), ins.src1.vreg, 0);
                end
                cb = arm64_b_imm26(cb, 0);
                handled = 1;
            end
            if ins.opcode == QOp::JumpIfNot:
                if ins.src1.op_type == OperandType::VReg:
                    cb = arm64_cmp_imm0(cb, vreg_to_arm(ins.src1.vreg));
                end
                if ins.src2.op_type == OperandType::LabelRef:
                    ps = patch_add_fixup(ps, codebuf_offset(cb), ins.src2.vreg, 1);
                end
                cb = arm64_beq_imm19(cb, 0);
                handled = 1;
            end
            if ins.opcode == QOp::JumpIf:
                if ins.src1.op_type == OperandType::VReg:
                    cb = arm64_cmp_imm0(cb, vreg_to_arm(ins.src1.vreg));
                end
                if ins.src2.op_type == OperandType::LabelRef:
                    ps = patch_add_fixup(ps, codebuf_offset(cb), ins.src2.vreg, 1);
                end
                cb = arm64_bne_imm19(cb, 0);
                handled = 1;
            end
            if ins.opcode == QOp::SetArg:
                cb = arm64_mov_rr(cb, ins.dest.imm_val, vreg_to_arm(ins.src1.vreg));
                handled = 1;
            end
            if ins.opcode == QOp::LoadFuncAddr:
                dreg = vreg_to_arm(ins.dest.vreg);
                func_adr_patches = vec_push_rt(func_adr_patches, codebuf_offset(cb));
                func_adr_targets = vec_push_rt(func_adr_targets, ins.src1.vreg);
                func_adr_dregs = vec_push_rt(func_adr_dregs, dreg);
                cb = codebuf_emit_u32(cb, 0x10000000 | dreg);  
                handled = 1;
            end
            if ins.opcode == QOp::Call or ins.opcode == QOp::CallFunc:
                cb = codebuf_emit_u32(cb, 0xA9062BE9);  
                cb = codebuf_emit_u32(cb, 0xA90733EB);  
                cb = codebuf_emit_u32(cb, 0xA9083BED);  
                if ins.src1.op_type == OperandType::VReg:
                    cb = arm64_mov_rr(cb, 16, vreg_to_arm(ins.src1.vreg));
                    cb = arm64_blr_x16(cb);
                eif ins.src1.op_type == OperandType::LabelRef:
                    ps = patch_add_fixup(ps, codebuf_offset(cb), ins.src1.vreg, 0);
                    cb = arm64_bl_imm26(cb, 0);
                eif ins.src1.op_type == OperandType::FuncIdx:
                    fixup_offsets = vec_push_rt(fixup_offsets, codebuf_offset(cb));
                    fixup_targets = vec_push_rt(fixup_targets, ins.src1.vreg);
                    fixup_count = fixup_count + 1;
                    cb = arm64_bl_imm26(cb, 0);
                end
                cb = codebuf_emit_u32(cb, 0xA9462BE9);  
                cb = codebuf_emit_u32(cb, 0xA94733EB);  
                cb = codebuf_emit_u32(cb, 0xA9483BED);  
                if ins.dest.op_type == OperandType::VReg:
                    cb = arm64_mov_rr(cb, vreg_to_arm(ins.dest.vreg), 0);
                end
                handled = 1;
            end
            if ins.opcode == QOp::LoadGlobal:
                gidx = ins.src1.imm_val + 1;
                cb = arm64_movz_imm64(cb, 17, gidx >> int);
                cb = arm64_ldr_reg(cb, vreg_to_arm(ins.dest.vreg), 15, 17);
                handled = 1;
            end
            if ins.opcode == QOp::StoreGlobal:
                gidx = ins.src1.imm_val + 1;
                cb = arm64_movz_imm64(cb, 17, gidx >> int);
                cb = arm64_str_reg(cb, vreg_to_arm(ins.src2.vreg), 15, 17);
                handled = 1;
            end
            if ins.opcode == QOp::Alloc:
                cb = arm64_ldr_imm(cb, 17, 15, 0);              
                cb = arm64_mov_rr(cb, vreg_to_arm(ins.dest.vreg), 17); 
                cb = arm64_add_rrr(cb, 17, 17, vreg_to_arm(ins.src1.vreg)); 
                cb = arm64_str_imm(cb, 17, 15, 0);              
                handled = 1;
            end
            if ins.opcode == QOp::ArrNew:
                cb = arm64_add_imm(cb, 17, vreg_to_arm(ins.src1.vreg), 2); 
                cb = codebuf_emit_u32(cb, 0xD37DF231);          
                rd = vreg_to_arm(ins.dest.vreg);
                cb = arm64_ldr_imm(cb, rd, 15, 0);              
                cb = arm64_add_rrr(cb, 17, rd, 17);             
                cb = arm64_str_imm(cb, 17, 15, 0);              
                cb = arm64_str_imm(cb, vreg_to_arm(ins.src1.vreg), rd, 0); 
                cb = arm64_mov_imm16(cb, 17, 0);                
                cb = arm64_str_imm(cb, 17, rd, 8);              
                handled = 1;
            end
            if ins.opcode == QOp::ArrPush:
                arr_reg = vreg_to_arm(ins.src1.vreg);
                elem_reg = vreg_to_arm(ins.src2.vreg);
                cb = arm64_ldr_imm(cb, 17, arr_reg, 8);         
                cb = arm64_add_imm(cb, 17, 17, 2);              
                cb = arm64_str_reg(cb, elem_reg, arr_reg, 17);  
                cb = arm64_ldr_imm(cb, 17, arr_reg, 8);         
                cb = arm64_add_imm(cb, 17, 17, 1);              
                cb = arm64_str_imm(cb, 17, arr_reg, 8);         
                handled = 1;
            end
            if ins.opcode == QOp::ArrGet:
                arr_reg = vreg_to_arm(ins.src1.vreg);
                idx_reg = vreg_to_arm(ins.src2.vreg);
                cb = arm64_add_imm(cb, 17, idx_reg, 2);         
                cb = arm64_ldr_reg(cb, vreg_to_arm(ins.dest.vreg), arr_reg, 17); 
                handled = 1;
            end
            if ins.opcode == QOp::ArrSet:
                arr_reg = vreg_to_arm(ins.src1.vreg);
                idx_reg = vreg_to_arm(ins.src2.vreg);
                cb = arm64_add_imm(cb, 17, idx_reg, 2);         
                cb = arm64_str_reg(cb, vreg_to_arm(ins.dest.vreg), arr_reg, 17); 
                handled = 1;
            end
            if ins.opcode == QOp::PrintStr:
                cb = codebuf_emit_u32(cb, 0xA9062BE9);
                cb = codebuf_emit_u32(cb, 0xA90733EB);
                cb = codebuf_emit_u32(cb, 0xA9083BED);
                if ins.src1.op_type == OperandType::StringRef:
                    str_idx = ins.src1.vreg;
                    slot = str_globals_base + str_idx * 2;
                    cb = arm64_movz_imm64(cb, 17, slot);
                    cb = arm64_ldr_reg(cb, 0, 15, 17);    
                    slot_len = slot + 1;
                    cb = arm64_movz_imm64(cb, 17, slot_len);
                    cb = arm64_ldr_reg(cb, 1, 15, 17);    
                else
                    cb = arm64_mov_rr(cb, 0, vreg_to_arm(ins.dest.vreg)); 
                    ps_bl_off = codebuf_offset(cb);
                    ps_delta = (rt_strlen_off - ps_bl_off) / 4;
                    cb = codebuf_emit_u32(cb, 0x94000000 | (ps_delta & 0x03FFFFFF));
                    cb = arm64_mov_rr(cb, 1, 0);           
                    cb = arm64_mov_rr(cb, 0, vreg_to_arm(ins.dest.vreg)); 
                end
                ps_bl_off = codebuf_offset(cb);
                ps_delta = (rt_printstr_off - ps_bl_off) / 4;
                cb = codebuf_emit_u32(cb, 0x94000000 | (ps_delta & 0x03FFFFFF));
                cb = codebuf_emit_u32(cb, 0xA9462BE9);
                cb = codebuf_emit_u32(cb, 0xA94733EB);
                cb = codebuf_emit_u32(cb, 0xA9483BED);
                handled = 1;
            end
            if ins.opcode == QOp::ArrLen:
                cb = arm64_ldr_imm(cb, vreg_to_arm(ins.dest.vreg), vreg_to_arm(ins.src1.vreg), 8);
                handled = 1;
            end
            if ins.opcode == QOp::StrCat:
                cb = arm64_mov_rr(cb, 0, vreg_to_arm(ins.src1.vreg)); 
                cb = arm64_mov_rr(cb, 1, vreg_to_arm(ins.src2.vreg)); 
                cb = codebuf_emit_u32(cb, 0xA9062BE9);
                cb = codebuf_emit_u32(cb, 0xA90733EB);
                cb = codebuf_emit_u32(cb, 0xA9083BED);
                sc_bl_off = codebuf_offset(cb);
                sc_delta = (rt_strcat_off - sc_bl_off) / 4;
                cb = codebuf_emit_u32(cb, 0x94000000 | (sc_delta & 0x03FFFFFF));
                cb = arm64_mov_rr(cb, vreg_to_arm(ins.dest.vreg), 0);
                cb = codebuf_emit_u32(cb, 0xA9462BE9);
                cb = codebuf_emit_u32(cb, 0xA94733EB);
                cb = codebuf_emit_u32(cb, 0xA9483BED);
                handled = 1;
            end
            if ins.opcode == QOp::StrLenOp:
                cb = arm64_mov_rr(cb, 0, vreg_to_arm(ins.src1.vreg)); 
                cb = codebuf_emit_u32(cb, 0xA9062BE9); 
                cb = codebuf_emit_u32(cb, 0xA90733EB);
                cb = codebuf_emit_u32(cb, 0xA9083BED);
                sl_bl_off = codebuf_offset(cb);
                sl_delta = (rt_strlen_off - sl_bl_off) / 4;
                cb = codebuf_emit_u32(cb, 0x94000000 | (sl_delta & 0x03FFFFFF));
                cb = arm64_mov_rr(cb, vreg_to_arm(ins.dest.vreg), 0); 
                cb = codebuf_emit_u32(cb, 0xA9462BE9); 
                cb = codebuf_emit_u32(cb, 0xA94733EB);
                cb = codebuf_emit_u32(cb, 0xA9483BED);
                handled = 1;
            end

            if handled == 0:

            s1_reg = 0;
            s2_reg = 0;
            d_reg = 0;
            if ins.src1.op_type == OperandType::VReg:
                s1_reg = vreg_to_arm(ins.src1.vreg);
                if spill_count > 0 and ins.src1.vreg >= 16:
                    cb = arm64_ldr_imm(cb, 8, 29, 160 + (ins.src1.vreg - 16) * 8);
                end
            end
            if ins.src2.op_type == OperandType::VReg:
                s2_reg = vreg_to_arm(ins.src2.vreg);
                if spill_count > 0 and ins.src2.vreg >= 16:
                    cb = arm64_ldr_imm(cb, 16, 29, 160 + (ins.src2.vreg - 16) * 8);
                    s2_reg = 16;
                end
            end
            if ins.dest.op_type == OperandType::VReg:
                d_reg = vreg_to_arm(ins.dest.vreg);
            end

            if ins.opcode == QOp::Nop:
                cb = arm64_nop(cb);

            eif ins.opcode == QOp::Load:
                if ins.src1.op_type == OperandType::Immediate:
                    cb = arm64_movz_imm64(cb, d_reg, ins.src1.imm_val >> int);
                eif ins.src1.op_type == OperandType::StringRef:
                    slot = str_globals_base + ins.src1.vreg * 2;
                    cb = arm64_movz_imm64(cb, 17, slot);
                    cb = arm64_ldr_reg(cb, d_reg, 15, 17);
                end

            eif ins.opcode == QOp::Move:
                cb = arm64_mov_rr(cb, d_reg, s1_reg);

            eif ins.opcode == QOp::Add:
                cb = arm64_add_rrr(cb, d_reg, s1_reg, s2_reg);

            eif ins.opcode == QOp::Sub:
                cb = arm64_sub_rrr(cb, d_reg, s1_reg, s2_reg);

            eif ins.opcode == QOp::Mul:
                cb = arm64_mul_rrr(cb, d_reg, s1_reg, s2_reg);

            eif ins.opcode == QOp::Div:
                cb = arm64_sdiv_rrr(cb, d_reg, s1_reg, s2_reg);

            eif ins.opcode == QOp::Mod:
                cb = arm64_sdiv_rrr(cb, 17, s1_reg, s2_reg);
                msub = 0x9B008000 | (s2_reg << 16) | (s1_reg << 10) | (17 << 5) | d_reg;
                cb = codebuf_emit_u32(cb, msub);

            eif ins.opcode == QOp::CmpEq:
                cb = arm64_cmp_rr(cb, s1_reg, s2_reg);
                cb = arm64_cset_eq(cb, d_reg);

            eif ins.opcode == QOp::CmpNe:
                cb = arm64_cmp_rr(cb, s1_reg, s2_reg);
                cb = codebuf_emit_u32(cb, 0x9A9F07E0 | (d_reg & 0x1F));

            eif ins.opcode == QOp::CmpGt:
                cb = arm64_cmp_rr(cb, s1_reg, s2_reg);
                cb = arm64_cset_gt(cb, d_reg);

            eif ins.opcode == QOp::CmpLt:
                cb = arm64_cmp_rr(cb, s1_reg, s2_reg);
                cb = arm64_cset_lt(cb, d_reg);

            eif ins.opcode == QOp::CmpGe:
                cb = arm64_cmp_rr(cb, s1_reg, s2_reg);
                cb = arm64_cset_ge(cb, d_reg);

            eif ins.opcode == QOp::CmpLe:
                cb = arm64_cmp_rr(cb, s1_reg, s2_reg);
                cb = arm64_cset_le(cb, d_reg);

            eif ins.opcode == QOp::And:
                cb = arm64_and_rrr(cb, d_reg, s1_reg, s2_reg);

            eif ins.opcode == QOp::Or:
                cb = arm64_orr_rrr(cb, d_reg, s1_reg, s2_reg);

            eif ins.opcode == QOp::Xor:
                cb = arm64_eor_rrr(cb, d_reg, s1_reg, s2_reg);

            eif ins.opcode == QOp::Shl:
                cb = arm64_lsl_rrr(cb, d_reg, s1_reg, s2_reg);

            eif ins.opcode == QOp::Shr:
                cb = arm64_asr_rrr(cb, d_reg, s1_reg, s2_reg);

            eif ins.opcode == QOp::LoadByte:
                cb = arm64_ldrb_reg(cb, d_reg, s1_reg, s2_reg);

            eif ins.opcode == QOp::StoreByte:
                cb = arm64_strb_reg(cb, d_reg, s1_reg, s2_reg);

            eif ins.opcode == QOp::LoadWord:
                cb = arm64_ldr_reg(cb, d_reg, s1_reg, s2_reg);

            eif ins.opcode == QOp::StoreWord:
                cb = arm64_str_reg(cb, d_reg, s1_reg, s2_reg);

            eif ins.opcode == QOp::PatchPoint:
                cb = arm64_nop(cb);

            else
                cb = arm64_nop(cb);
            end

            end

            if spill_count > 0 and ins.dest.op_type == OperandType::VReg and ins.dest.vreg >= 16:
                cb = arm64_str_imm(cb, d_reg, 29, 160 + (ins.dest.vreg - 16) * 8);
            end

            j = j + 1;
        end

        if vec_len_rt(qfn.body) == 0 or vec_get_rt(qfn.body, vec_len_rt(qfn.body) - 1).opcode != QOp::Ret:
            if needs_frame == 1:
                cb = codebuf_emit_u32(cb, 0xA94153F3);  
                cb = codebuf_emit_u32(cb, 0xA9425BF5);  
                cb = codebuf_emit_u32(cb, 0xA94363F7);  
                cb = codebuf_emit_u32(cb, 0xA9446BF9);  
                cb = codebuf_emit_u32(cb, 0xA94573FB);  
                cb = arm64_ldp_post(cb, 29, 30, 31, frame_size);
            end
            cb = arm64_ret(cb);
        end

        cb = backpatch_arm64(cb, ps);

        func_size = codebuf_offset(cb) - func_start;
        fl = FuncLayout (;
            name:   qfn.name,;
            code_off: func_start,;
            fsize:   func_size
        );
        layouts = vec_push_rt(layouts, fl);
        layout_count = layout_count + 1;

        fi = fi + 1;
    end

    fxi = 0;
    when fxi < fixup_count loop
        patch_at = vec_get_rt(fixup_offsets, fxi);
        target_idx = vec_get_rt(fixup_targets, fxi);
        if target_idx >= 0 and target_idx < layout_count:
            target_layout = vec_get_rt(layouts, target_idx);
            target_off = target_layout.code_off;
            byte_offset = target_off - patch_at;
            imm26 = (byte_offset / 4) & 0x03FFFFFF;
            cb = codebuf_patch_u32(cb, patch_at, 0x94000000 | imm26);
        end
        fxi = fxi + 1;
    end

    fai = 0;
    when fai < vec_len_rt(func_adr_patches) loop
        adr_off = vec_get_rt(func_adr_patches, fai);
        target_fi = vec_get_rt(func_adr_targets, fai);
        adr_rd = vec_get_rt(func_adr_dregs, fai);
        if target_fi >= 0 and target_fi < layout_count:
            target_layout = vec_get_rt(layouts, target_fi);
            target_off = target_layout.code_off;
            adr_imm = target_off - adr_off;
            immlo = adr_imm & 3;
            immhi = (adr_imm >> 2) & 0x7FFFF;
            adr_enc = 0x10000000 | (immlo << 29) | (immhi << 5) | adr_rd;
            cb = codebuf_patch_u32(cb, adr_off, adr_enc);
        end
        fai = fai + 1;
    end

    start_offset = codebuf_offset(cb);
    cb = arm64_stp_pre(cb, 29, 30, 31, -16);
    cb = arm64_mov_sp_to(cb, 29);

    cb = arm64_mov_imm16(cb, 0, 0);             
    cb = codebuf_emit_u32(cb, 0xD2A00021);       
    cb = arm64_mov_imm16(cb, 2, 3);             
    cb = arm64_mov_imm16(cb, 3, 4098);          
    cb = codebuf_emit_u32(cb, 0xAA3F03E4);       
    cb = arm64_mov_imm16(cb, 5, 0);             
    cb = arm64_mov_imm16(cb, 16, 197);           
    cb = codebuf_emit_u32(cb, 0xF2A04010);       
    cb = arm64_svc(cb, 128);
    cb = arm64_mov_rr(cb, 15, 0);               

    cb = arm64_mov_imm16(cb, 0, 0);             
    cb = codebuf_emit_u32(cb, 0xD2A00201);       
    cb = arm64_mov_imm16(cb, 2, 3);             
    cb = arm64_mov_imm16(cb, 3, 4098);          
    cb = codebuf_emit_u32(cb, 0xAA3F03E4);       
    cb = arm64_mov_imm16(cb, 5, 0);             
    cb = arm64_mov_imm16(cb, 16, 197);           
    cb = codebuf_emit_u32(cb, 0xF2A04010);       
    cb = arm64_svc(cb, 128);
    cb = arm64_str_imm(cb, 0, 15, 0);           

    si = 0;
    when si < str_count loop
        str_val = vec_get_rt(module.strings, si);
        slen = rt_strlen(str_val);
        slot = str_globals_base + si * 2;
        slot_len = slot + 1;

        str_adr_patches = vec_push_rt(str_adr_patches, codebuf_offset(cb));
        str_adr_indices = vec_push_rt(str_adr_indices, si);
        cb = codebuf_emit_u32(cb, 0x10000011);  

        cb = arm64_movz_imm64(cb, 16, slot);
        cb = arm64_str_reg(cb, 17, 15, 16);     

        cb = arm64_movz_imm64(cb, 17, slen);
        cb = arm64_movz_imm64(cb, 16, slot_len);
        cb = arm64_str_reg(cb, 17, 15, 16);     

        si = si + 1;
    end

    if ginit_idx >= 0:
        ginit_layout = vec_get_rt(layouts, ginit_idx);
        ginit_off = ginit_layout.code_off;
        ginit_bl = codebuf_offset(cb);
        delta_gi = (ginit_off - ginit_bl) / 4;
        cb = codebuf_emit_u32(cb, 0x94000000 | (delta_gi & 0x03FFFFFF));
    end

    if main_idx >= 0:
        main_layout = vec_get_rt(layouts, main_idx);
        main_off = main_layout.code_off;
        main_bl = codebuf_offset(cb);
        delta = (main_off - main_bl) / 4;
        cb = codebuf_emit_u32(cb, 0x94000000 | (delta & 0x03FFFFFF));
    else
        cb = arm64_mov_imm16(cb, 0, 0);
    end

    cb = arm64_mov_imm16(cb, 0, 0);
    exit_bl = codebuf_offset(cb);
    exit_delta = (rt_exit_off - exit_bl) / 4;
    cb = codebuf_emit_u32(cb, 0x94000000 | (exit_delta & 0x03FFFFFF));

    cb = arm64_ldp_post(cb, 29, 30, 31, 16);
    cb = arm64_ret(cb);

    str_data_offsets = vec_new_rt();
    si = 0;
    when si < str_count loop
        str_val = vec_get_rt(module.strings, si);
        slen = rt_strlen(str_val);
        str_data_offsets = vec_push_rt(str_data_offsets, codebuf_offset(cb));
        ci = 0;
        when ci < slen loop
            ch = str_get(str_val, ci);
            cb = codebuf_emit_byte(cb, ch);
            ci = ci + 1;
        end
        cb = codebuf_emit_byte(cb, 0);
        when (codebuf_offset(cb) % 4) != 0 loop
            cb = codebuf_emit_byte(cb, 0);
        end
        si = si + 1;
    end

    pi = 0;
    when pi < vec_len_rt(str_adr_patches) loop
        adr_off = vec_get_rt(str_adr_patches, pi);
        sidx = vec_get_rt(str_adr_indices, pi);
        data_off = vec_get_rt(str_data_offsets, sidx);
        adr_imm = data_off - adr_off;
        immlo = adr_imm & 3;
        immhi = (adr_imm >> 2) & 0x7FFFF;
        adr_enc = 0x10000011 | (immlo << 29) | (immhi << 5);
        cb = codebuf_patch_u32(cb, adr_off, adr_enc);
        pi = pi + 1;
    end

    cb.start_offset = start_offset;
    out cb;
end

func emit_macho_executable:
    in(code:CodeBuf)
    obuf = buf_new();
    code_size = codebuf_offset(code) >> int;

    if PAGE_SIZE == 0:
        text_filesize = code_size;
    else
        text_filesize = ((code_size + PAGE_SIZE - 1) / PAGE_SIZE) * PAGE_SIZE;
    end

    ncmds = 4 >> int;
    cmds_size = (72 + 72 + 80 + 24 + 24) >> int  
    header_plus_cmds = 32 + cmds_size >> int;

    obuf = buf_write_u32_le(obuf, MACHO_MAGIC);
    obuf = buf_write_u32_le(obuf, CPU_ARM64);
    obuf = buf_write_u32_le(obuf, CPU_SUB_ALL);
    obuf = buf_write_u32_le(obuf, MH_EXECUTE);
    obuf = buf_write_u32_le(obuf, ncmds);
    obuf = buf_write_u32_le(obuf, cmds_size);
    obuf = buf_write_u32_le(obuf, MH_FLAGS);
    obuf = buf_write_u32_le(obuf, 0)              

    obuf = buf_write_u32_le(obuf, LC_SEGMENT_64);
    obuf = buf_write_u32_le(obuf, 72);
    obuf = buf_write_string_padded(obuf, "__PAGEZERO", 16);
    obuf = buf_write_u64_le(obuf, 0)              
    obuf = buf_write_u64_le(obuf, TEXT_BASE)       
    obuf = buf_write_u64_le(obuf, 0)              
    obuf = buf_write_u64_le(obuf, 0)              
    obuf = buf_write_u32_le(obuf, 0)              
    obuf = buf_write_u32_le(obuf, 0)              
    obuf = buf_write_u32_le(obuf, 0)              
    obuf = buf_write_u32_le(obuf, 0)              

    obuf = buf_write_u32_le(obuf, LC_SEGMENT_64);
    obuf = buf_write_u32_le(obuf, 152)            
    obuf = buf_write_string_padded(obuf, "__TEXT", 16);
    obuf = buf_write_u64_le(obuf, TEXT_BASE)       
    obuf = buf_write_u64_le(obuf, text_filesize)  
    obuf = buf_write_u64_le(obuf, 0)              
    obuf = buf_write_u64_le(obuf, header_plus_cmds + text_filesize) 
    obuf = buf_write_u32_le(obuf, 5)              
    obuf = buf_write_u32_le(obuf, 5)              
    obuf = buf_write_u32_le(obuf, 1)              
    obuf = buf_write_u32_le(obuf, 0)              

    obuf = buf_write_string_padded(obuf, "__text", 16)      
    obuf = buf_write_string_padded(obuf, "__TEXT", 16)      
    obuf = buf_write_u64_le(obuf, TEXT_BASE + header_plus_cmds)      
    obuf = buf_write_u64_le(obuf, code_size)                         
    obuf = buf_write_u32_le(obuf, header_plus_cmds >> int)           
    obuf = buf_write_u32_le(obuf, 2)              
    obuf = buf_write_u32_le(obuf, 0)              
    obuf = buf_write_u32_le(obuf, 0)              
    obuf = buf_write_u32_le(obuf, 0x80000400)     
    obuf = buf_write_u32_le(obuf, 0)              
    obuf = buf_write_u32_le(obuf, 0)              
    obuf = buf_write_u32_le(obuf, 0)              

    obuf = buf_write_u32_le(obuf, LC_MAIN);
    obuf = buf_write_u32_le(obuf, 24);
    obuf = buf_write_u64_le(obuf, 0)              
    obuf = buf_write_u64_le(obuf, 0)              

    obuf = buf_write_u32_le(obuf, LC_SYMTAB);
    obuf = buf_write_u32_le(obuf, 24);
    obuf = buf_write_u32_le(obuf, 0)              
    obuf = buf_write_u32_le(obuf, 0)              
    obuf = buf_write_u32_le(obuf, 0)              
    obuf = buf_write_u32_le(obuf, 0)              

    current = buf_size(obuf);
    pad_needed = header_plus_cmds >> int - current;
    if pad_needed > 0:
        obuf = buf_write_zeros(obuf, pad_needed >> int);
    end

    cdata = code.data;
    ci = 0;
    when ci < code_size loop
        obuf = buf_write_u8(obuf, cdata[ci] >> int);
        ci = ci + 1;
    end

    code_pad = text_filesize >> int - code_size >> int;
    if code_pad > 0:
        obuf = buf_write_zeros(obuf, code_pad >> int);
    end

    out obuf;
end

func emit_macho_with_entry:
    in(code:CodeBuf; start_offset:int)
    obuf = emit_macho_executable(code);

    lc_main_entryoff = 264 >> int;
    header_plus_cmds = 304 >> int      

    entry_patch_off = 32 + 72 + 152 + 8;
    entryoff_val = header_plus_cmds + start_offset;

    obuf.data = vec_set_at(obuf.data, entry_patch_off, (entryoff_val & 0xFF) >> int);
    obuf.data = vec_set_at(obuf.data, entry_patch_off + 1, ((entryoff_val >> 8) & 0xFF) >> int);
    obuf.data = vec_set_at(obuf.data, entry_patch_off + 2, ((entryoff_val >> 16) & 0xFF) >> int);
    obuf.data = vec_set_at(obuf.data, entry_patch_off + 3, ((entryoff_val >> 24) & 0xFF) >> int);
    obuf.data = vec_set_at(obuf.data, entry_patch_off + 4, 0);
    obuf.data = vec_set_at(obuf.data, entry_patch_off + 5, 0);
    obuf.data = vec_set_at(obuf.data, entry_patch_off + 6, 0);
    obuf.data = vec_set_at(obuf.data, entry_patch_off + 7, 0);

    out obuf;
end

func compile:
    in(source:string; output_path:string)
    print "virc: tokenizing...";
    lex = lexer_new(source);
    lex = tokenize(lex);

    if rt_strlen(lex.error_msg) > 0:
        print "virc: lex error_msg: " + lex.error_msg;
        out 1;
    end

    tok_count = vec_len_rt(lex.tokens);
    print "virc: " + str_from_i64(tok_count) + " tokens";

    print "virc: parsing...";
    parser = parser_new(lex.tokens);
    var (parser2, ast) = parse_program(parser);

    if ast.node_type == AstType::Program and vec_len_rt(ast.children) == 0:
        print "virc: parse error_msg: empty program";
        out 1;
    end

    print "virc: lowering to Q-IR...";
    ctx = lower_ctx_new("main");
    ctx = lower_program(ctx, ast);

    if ctx.error_count > 0:
        print "virc: lower error_msg: " + ctx.last_error;
        out 1;
    end

    func_count = vec_len_rt(ctx.module.functions);
    print "virc: " + str_from_i64(func_count) + " functions";

    print "virc: optimizing...";
    fi = 0;
    when fi < func_count loop
        qfn = vec_get_rt(ctx.module.functions, fi);
        print "virc: opt func";

        var (func2, tco_count) = tco_pass(qfn);
        qfn = func2
        print "virc: tco done";

        intervals = compute_liveness(qfn);
        print "virc: liveness done";
        allocated = regalloc_linear_scan(intervals, 14)   
        print "virc: regalloc done";

        print "virc: rewrite pass...";
        print vec_len_rt(allocated);
        ri = 0;
        when ri < vec_len_rt(qfn.body) loop
            rins = vec_get_rt(qfn.body, ri);
            rchanged = 0;
            if rins.dest.op_type == OperandType::VReg:
                rpr = get_phys_reg(allocated, rins.dest.vreg);
                if rpr >= 0 and (rpr as u32) != rins.dest.vreg:
                    rins.dest.vreg = rpr;
                    rchanged = 1;
                end
            end
            if rins.src1.op_type == OperandType::VReg:
                rpr = get_phys_reg(allocated, rins.src1.vreg);
                if rpr >= 0 and (rpr as u32) != rins.src1.vreg:
                    rins.src1.vreg = rpr;
                    rchanged = 1;
                end
            end
            if rins.src2.op_type == OperandType::VReg:
                rpr = get_phys_reg(allocated, rins.src2.vreg);
                if rpr >= 0 and (rpr as u32) != rins.src2.vreg:
                    rins.src2.vreg = rpr;
                    rchanged = 1;
                end
            end
            if rchanged == 1:
                vec_set_rt(qfn.body, ri, rins);
            end
            ri = ri + 1;
        end

        vec_set_rt(ctx.module.functions, fi, qfn);
        fi = fi + 1;
    end

    print "virc: generating ARM64 machine code...";
    code = codegen_emit_module(ctx.module, TargetArch::ARM64);
    code_size = codebuf_offset(code);
    print "virc: " + str_from_i64(code_size) + " bytes of machine code";

    print "virc: linking Mach-O ARM64 executable...";
    binary = emit_macho_executable(code);

    print "virc: writing " + output_path + "...";
    f = file_create(output_path);
    if is_err(f):
        print "virc: error_msg: cannot create output file";
        out 1;
    end

    file = unwrap(f);
    data_slice = slice_new(binary.data.data, vec_len_rt(binary.data));
    file_write_all(file, data_slice);
    file_close(file);

    file_size = vec_len_rt(binary.data);
    print "virc: done! " + output_path + " (" + str_from_i64(file_size) + " bytes)";
    out 0;
end

func virc_legacy_main:
    print "________________________________________________";
    print "_  virc _ Vir Self-Hosting Compiler v1.2      _";
    print "_  Phase 5: Bootstrap Binary                   _";
    print "________________________________________________";

    if arg_count() < 1:
        print "Usage: virc <input.vri> [-o output]";
        print "";
        print "Compiles a Vir source file to a standalone";
        print "Mach-O ARM64 binary. No Python, no C runtime.";
        out 1;
    end

    input_path = get_arg(0);
    output_path = "a.out";

    if arg_count() >= 3:
        if rt_streq(get_arg(1), "-o"):
            output_path = get_arg(2);
        end
    end

    print "virc: reading " + input_path + "...";
    f = file_open(input_path, FileMode::Read);
    if is_err(f):
        print "virc: error_msg: cannot open " + input_path;
        out 1;
    end

    file = unwrap(f);
    source_result = file_read_all(file);
    file_close(file);

    if is_err(source_result):
        print "virc: error_msg: cannot read " + input_path;
        out 1;
    end

    source = unwrap(source_result);
    print "virc: " + str_from_i64(rt_strlen(source)) + " bytes source";

    result = compile(source, output_path);
    out result;
end

export compile, virc_legacy_main, codegen_emit_module;
export emit_runtime_arm64, emit_macho_executable, emit_macho_with_entry;
export FuncLayout;

# -- END vir/compiler/main.vri --

# -- BEGIN vir/collections/vec.vri --

entity Vec<T>:
    data: ptr      
    len:  int    
    cap:  int    
end

func vec_new<T>:
    out Vec<T> ( data = null, len = 0, cap = 0 );
end

func vec_with_cap<T>:
    in(cap:int)
    size = cap * size_of<T>();
    data = alloc(size);
    out Vec<T> ( data = data, len = 0, cap = cap );
end

func vec_from_slice<T>:
    in(src:ptr; count:int)
    v = vec_with_cap<T>(count);
    mem_copy(v.data, src, count * size_of<T>());
    v.len = count;
    out v;
end

func vec_filled<T>:
    in(val:T; count:int)
    v = vec_with_cap<T>(count);
    i = 0;
    when i < count loop
        native_store<T>(v.data, i, val);
        i = i + 1;
    end
    v.len = count;
    out v;
end

func vec_len<T>:
    in(v:Vec<T>)
    out v.len;
end

func vec_cap<T>:
    in(v:Vec<T>)
    out v.cap;
end

func vec_is_empty<T>:
    in(v:Vec<T>)
    out v.len == 0;
end

func vec_reserve<T>:
    in(v:Vec<T>; additional:int)
    new_cap = v.len + additional;
    if new_cap <= v.cap out end:
    
    target = v.cap * 2;
    if target < new_cap target = new_cap end:
    if target < 8 target = 8 end  
    
    new_size = target * size_of<T>();
    if v.data == null:
        v.data = alloc(new_size);
    else
        v.data = realloc(v.data, new_size);
    end
    v.cap = target;
end

func vec_shrink_to_fit<T>:
    in(v:Vec<T>)
    if v.len == v.cap out end:
    if v.len == 0:
        free(v.data);
        v.data = null;
        v.cap = 0;
        out;
    end
    v.data = realloc(v.data, v.len * size_of<T>());
    v.cap = v.len;
end

func vec_get<T>:
    in(v:Vec<T>; idx:int)
    if idx >= v.len:
        panic(str_new("vec_get: index out of bounds"));
    end
    out native_load<T>(v.data, idx);
end

func vec_try_get<T>:
    in(v:Vec<T>; idx:int)
    if idx >= v.len out None end:
    out Some(native_load<T>(v.data, idx));
end

func vec_set<T>:
    in(v:Vec<T>; idx:int; val:T)
    if idx >= v.len:
        panic(str_new("vec_set: index out of bounds"));
    end
    native_store<T>(v.data, idx, val);
end

func vec_first<T>:
    in(v:Vec<T>)
    if v.len == 0 out None end:
    out Some(native_load<T>(v.data, 0));
end

func vec_last<T>:
    in(v:Vec<T>)
    if v.len == 0 out None end:
    out Some(native_load<T>(v.data, v.len - 1));
end

func vec_push<T>:
    in(v:Vec<T>; val:T)
    vec_reserve<T>(v, 1);
    native_store<T>(v.data, v.len, val);
    v.len = v.len + 1;
end

func vec_pop<T>:
    in(v:Vec<T>)
    if v.len == 0 out None end:
    v.len = v.len - 1;
    out Some(native_load<T>(v.data, v.len));
end

func vec_insert<T>:
    in(v:Vec<T>; idx:int; val:T)
    if idx > v.len:
        panic(str_new("vec_insert: index out of bounds"));
    end
    vec_reserve<T>(v, 1);
    if idx < v.len:
        src = v.data + idx * size_of<T>();
        dst = src + size_of<T>();
        mem_move(dst, src, (v.len - idx) * size_of<T>());
    end
    native_store<T>(v.data, idx, val);
    v.len = v.len + 1;
end

func vec_remove<T>:
    in(v:Vec<T>; idx:int)
    if idx >= v.len:
        panic(str_new("vec_remove: index out of bounds"));
    end
    val = native_load<T>(v.data, idx);
    remaining = v.len - idx - 1;
    if remaining > 0:
        dst = v.data + idx * size_of<T>();
        src = dst + size_of<T>();
        mem_move(dst, src, remaining * size_of<T>());
    end
    v.len = v.len - 1;
    out val;
end

func vec_swap_remove<T>:
    in(v:Vec<T>; idx:int)
    if idx >= v.len:
        panic(str_new("vec_swap_remove: index out of bounds"));
    end
    val = native_load<T>(v.data, idx);
    v.len = v.len - 1;
    if idx < v.len:
        last = native_load<T>(v.data, v.len);
        native_store<T>(v.data, idx, last);
    end
    out val;
end

func vec_clear<T>:
    in(v:Vec<T>)
    v.len = 0;
end

func vec_truncate<T>:
    in(v:Vec<T>; new_len:int)
    if new_len < v.len:
        v.len = new_len;
    end
end

func vec_extend<T>:
    in(v:Vec<T>; other:Vec<T>)
    if other.len == 0 out end:
    vec_reserve<T>(v, other.len);
    mem_copy(;
        v.data + v.len * size_of<T>(),;
        other.data,;
        other.len * size_of<T>()
    );
    v.len = v.len + other.len;
end

func vec_extend_from_slice<T>:
    in(v:Vec<T>; src:ptr; count:int)
    if count == 0 out end:
    vec_reserve<T>(v, count);
    mem_copy(;
        v.data + v.len * size_of<T>(),;
        src,;
        count * size_of<T>()
    );
    v.len = v.len + count;
end

func vec_contains<T>:
    in(v:Vec<T>; val:T)
    i = 0;
    when i < v.len loop
        if native_load<T>(v.data, i) == val:
            out true;
        end
        i = i + 1;
    end
    out false;
end

func vec_find<T>:
    in(v:Vec<T>; val:T)
    i = 0;
    when i < v.len loop
        if native_load<T>(v.data, i) == val:
            out Some(i);
        end
        i = i + 1;
    end
    out None;
end

func vec_count<T>:
    in(v:Vec<T>; val:T)
    count = 0;
    i = 0;
    when i < v.len loop
        if native_load<T>(v.data, i) == val:
            count = count + 1;
        end
        i = i + 1;
    end
    out count;
end

func vec_reverse<T>:
    in(v:Vec<T>)
    if v.len <= 1 out end:
    lo = 0;
    hi = v.len - 1;
    when lo < hi loop
        tmp = native_load<T>(v.data, lo);
        native_store<T>(v.data, lo, native_load<T>(v.data, hi));
        native_store<T>(v.data, hi, tmp);
        lo = lo + 1;
        hi = hi - 1;
    end
end

func vec_clone<T>:
    in(v:Vec<T>)
    if v.len == 0 out vec_new<T>() end:
    nv = vec_with_cap<T>(v.len);
    mem_copy(nv.data, v.data, v.len * size_of<T>());
    nv.len = v.len;
    out nv;
end

func vec_slice<T>:
    in(v:Vec<T>; start:int; end:int)
    if start > end or end > v.len:
        panic(str_new("vec_slice: range out of bounds"));
    end
    count = end - start;
    nv = vec_with_cap<T>(count);
    mem_copy(nv.data, v.data + start * size_of<T>(), count * size_of<T>());
    nv.len = count;
    out nv;
end

func vec_eq<T>:
    in(a:Vec<T>; b:Vec<T>)
    if a.len != b.len out false end:
    i = 0;
    when i < a.len loop
        if native_load<T>(a.data, i) != native_load<T>(b.data, i):
            out false;
        end
        i = i + 1;
    end
    out true;
end

func vec_free<T>:
    in(v:Vec<T>)
    if v.data != null:
        free(v.data);
        v.data = null;
    end
    v.len = 0;
    v.cap = 0;
end

func vec_as_ptr<T>:
    in(v:Vec<T>)
    out v.data;
end

func vec_as_slice<T>:
    in(v:Vec<T>)
    out Slice ( data = v.data, len = v.len * size_of<T>() );
end

func vec_for_each<T>(v: Vec<T>, f: func(T))
    i = 0;
    when i < v.len loop
        f(native_load<T>(v.data, i));
        i = i + 1;
    end
end

func vec_map<T, U>(v: Vec<T>, f: func(T) -> U) -> Vec<U>
    out = vec_with_cap<U>(v.len);
    i = 0;
    when i < v.len loop
        vec_push<U>(&out, f(native_load<T>(v.data, i)));
        i = i + 1;
    end
    out out;
end

func vec_filter<T>:
    in(v:Vec<T>; pred:func(T)
    out = vec_new<T>();
    i = 0;
    when i < v.len loop
        elem = native_load<T>(v.data, i);
        if pred(elem):
            vec_push<T>(&out, elem);
        end
        i = i + 1;
    end
    out out;
end

func vec_any<T>:
    in(v:Vec<T>; pred:func(T)
    i = 0;
    when i < v.len loop
        if pred(native_load<T>(v.data, i)) out true end:
        i = i + 1;
    end
    out false;
end

func vec_all<T>:
    in(v:Vec<T>; pred:func(T)
    i = 0;
    when i < v.len loop
        if !pred(native_load<T>(v.data, i)) out false end:
        i = i + 1;
    end
    out true;
end

func vec_fold<T, U>(v: Vec<T>, init: U, f: func(U, T) -> U) -> U
    acc = init;
    i = 0;
    when i < v.len loop
        acc = f(acc, native_load<T>(v.data, i));
        i = i + 1;
    end
    out acc;
end

entity Pair<A, B>:
    first: A;
    second: B;
end

func vec_zip<A, B>(a: Vec<A>, b: Vec<B>) -> Vec<Pair<A, B>>
    n = if a.len < b.len: a.len; else: b.len; end;
    result = vec_with_cap<Pair<A, B>>(n);
    i = 0;
    when i < n loop
        vec_push<Pair<A, B>>(&result, Pair<A, B> ( first: native_load<A>(a.data, i), second: native_load<B>(b.data, i) ));
        i = i + 1;
    end
    out result;
end

func vec_enumerate<T>(v: Vec<T>) -> Vec<Pair<int, T>>
    result = vec_with_cap<Pair<int, T>>(v.len);
    i = 0;
    when i < v.len loop
        vec_push<Pair<int, T>>(&result, Pair<int, T> ( first: i, second: native_load<T>(v.data, i) ));
        i = i + 1;
    end
    out result;
end

func vec_flatten<T>(nested: Vec<Vec<T>>) -> Vec<T>
    result = vec_new<T>();
    i = 0;
    when i < nested.len loop
        inner = native_load<Vec<T>>(nested.data, i);
        j = 0;
        when j < inner.len loop
            vec_push<T>(&result, native_load<T>(inner.data, j));
            j = j + 1;
        end
        i = i + 1;
    end
    out result;
end

func vec_dedup<T>(v: Vec<T>, eq: func(T, T) -> bool) -> Vec<T>
    result = vec_new<T>();
    if v.len == 0 out result end:
    vec_push<T>(&result, native_load<T>(v.data, 0));
    i = 1;
    when i < v.len loop
        cur = native_load<T>(v.data, i);
        prev = native_load<T>(v.data, i - 1);
        if !eq(cur, prev):
            vec_push<T>(&result, cur);
        end
        i = i + 1;
    end
    out result;
end

# -- END vir/collections/vec.vri --

# -- BEGIN vir/compiler/binary.vri --

enum ObjFormat:
    MachO64  = 0;
    ELF64    = 1;
end

enum Arch:
    ARM64    = 0;
    X86_64   = 1;
end

entity ByteBuffer:
    data:   Vec<int>;
    pos:    int;
end

func buf_new:
    out ByteBuffer ( data: vec_new(), pos: 0 );
end

func buf_write_u8:
    in(buf:ByteBuffer; val:int)
    vec_push(buf.data, val);
    buf.pos = buf.pos + 1;
    out buf;
end

func buf_write_u16_le:
    in(buf:ByteBuffer; val:int)
    buf = buf_write_u8(buf, (val & 0xFF) >> int);
    buf = buf_write_u8(buf, ((val >> 8) & 0xFF) >> int);
    out buf;
end

func buf_write_u32_le:
    in(buf:ByteBuffer; val:int)
    buf = buf_write_u8(buf, (val & 0xFF) >> int);
    buf = buf_write_u8(buf, ((val >> 8) & 0xFF) >> int);
    buf = buf_write_u8(buf, ((val >> 16) & 0xFF) >> int);
    buf = buf_write_u8(buf, ((val >> 24) & 0xFF) >> int);
    out buf;
end

func buf_write_u64_le:
    in(buf:ByteBuffer; val:int)
    buf = buf_write_u32_le(buf, (val & 0xFFFFFFFF) >> int);
    buf = buf_write_u32_le(buf, ((val >> 32) & 0xFFFFFFFF) >> int);
    out buf;
end

func buf_write_zeros:
    in(buf:ByteBuffer; count:int)
    i = 0;
    when i < count loop
        buf = buf_write_u8(buf, 0);
        i = i + 1;
    end
    out buf;
end

func buf_write_bytes:
    in(buf:ByteBuffer; bytes:Vec<int>)
    i = 0;
    when i < vec_len(bytes) loop
        buf = buf_write_u8(buf, vec_get(bytes, i));
        i = i + 1;
    end
    out buf;
end

func buf_write_string_padded:
    in(buf:ByteBuffer; s:string; pad_to:int)
    slen = str_len(s);
    i = 0;
    when i < slen and i < pad_to loop
        buf = buf_write_u8(buf, str_byte_at(s, i));
        i = i + 1;
    end
    when i < pad_to loop
        buf = buf_write_u8(buf, 0);
        i = i + 1;
    end
    out buf;
end

func buf_align:
    in(buf:ByteBuffer; alignment:int)
    when (buf.pos % alignment as i64) != 0 loop
        buf = buf_write_u8(buf, 0);
    end
    out buf;
end

func buf_size:
    in(buf:ByteBuffer)
    out buf.pos;
end

enum SymbolType:
    Function   = 0;
    Data       = 1;
    External   = 2;
end

entity Symbol:
    name:       string;
    sym_type:   SymbolType;
    section:    int       
    offset:     int       
    size:       int;
    is_global:  bool;
end

enum RelocType:
    Branch26       = 0  
    Page21         = 1  
    PageOff12      = 2  
    PLT32          = 3  
    PC32           = 4  
    GOTLoad        = 5  
end

entity Relocation:
    offset:     int;
    sym_idx:    int;
    reloc_type: RelocType;
    addend:     int;
end

entity Section:
    name:       string;
    seg_name:   string      
    data:       ByteBuffer;
    alignment:  int;
    relocs:     Vec<Relocation>;
end

func section_text:
    out Section (;
        name: str_new("__text"),;
        seg_name: str_new("__TEXT"),;
        data: buf_new(),;
        alignment: 4,;
        relocs: vec_new()
    );
end

func section_data:
    out Section (;
        name: str_new("__data"),;
        seg_name: str_new("__DATA"),;
        data: buf_new(),;
        alignment: 8,;
        relocs: vec_new()
    );
end

func section_const:
    out Section (;
        name: str_new("__const"),;
        seg_name: str_new("__TEXT"),;
        data: buf_new(),;
        alignment: 16,;
        relocs: vec_new()
    );
end

const MH_MAGIC_64: 0xFEEDFACF;
const MH_OBJECT: 1    

const CPU_TYPE_ARM64: 0x0100000C  
const CPU_TYPE_X86_64: 0x01000007  
const CPU_SUBTYPE_ALL: 0;

const LC_SEGMENT_64: 0x19;
const LC_SYMTAB: 0x02;
const LC_BUILD_VERSION: 0x32;

const S_REGULAR: 0x00;
const S_ATTR_PURE_INSTRUCTIONS: 0x80000000;
const S_ATTR_SOME_INSTRUCTIONS: 0x00000400;

entity MachOBuilder:
    arch:       Arch;
    sections:   Vec<Section>;
    symbols:    Vec<Symbol>;
    strtab:     ByteBuffer;
end

func macho_new:
    in(arch:Arch)
    builder = MachOBuilder (;
        arch: arch,;
        sections: vec_new(),;
        symbols: vec_new(),;
        strtab: buf_new()
    );
    builder.strtab = buf_write_u8(builder.strtab, 0);
    out builder;
end

func macho_add_section:
    in(builder:MachOBuilder; sec:Section)
    vec_push(builder.sections, sec);
    out builder;
end

func macho_add_symbol:
    in(builder:MachOBuilder; sym:Symbol)
    vec_push(builder.symbols, sym);
    out builder;
end

func macho_strtab_add:
    in(builder:MachOBuilder; name:string)
    offset = buf_size(builder.strtab) >> int;
    i = 0;
    when i < str_len(name) loop
        builder.strtab = buf_write_u8(builder.strtab, str_byte_at(name, i));
        i = i + 1;
    end
    builder.strtab = buf_write_u8(builder.strtab, 0);
    out (builder, offset);
end

func macho_emit_header:
    in(buf:ByteBuffer; arch:Arch; ncmds:int; sizeofcmds:int)
    buf = buf_write_u32_le(buf, MH_MAGIC_64);

    if arch == Arch::ARM64:
        buf = buf_write_u32_le(buf, CPU_TYPE_ARM64);
    else
        buf = buf_write_u32_le(buf, CPU_TYPE_X86_64);
    end

    buf = buf_write_u32_le(buf, CPU_SUBTYPE_ALL)  
    buf = buf_write_u32_le(buf, MH_OBJECT)        
    buf = buf_write_u32_le(buf, ncmds)            
    buf = buf_write_u32_le(buf, sizeofcmds)       
    buf = buf_write_u32_le(buf, 0)                
    buf = buf_write_u32_le(buf, 0)                
    out buf;
end

func macho_emit_segment_cmd:
    in(buf:ByteBuffer; seg_name:string; nsects:int; sect_data_offset:int; ; sect_data_size: int)
    cmdsize = 72 + nsects * 80 >> int;

    buf = buf_write_u32_le(buf, LC_SEGMENT_64);
    buf = buf_write_u32_le(buf, cmdsize);
    buf = buf_write_string_padded(buf, seg_name, 16)     
    buf = buf_write_u64_le(buf, 0)                       
    buf = buf_write_u64_le(buf, sect_data_size >> int) 
    buf = buf_write_u64_le(buf, sect_data_offset >> int)
    buf = buf_write_u64_le(buf, sect_data_size >> int)  
    buf = buf_write_u32_le(buf, 7)                       
    buf = buf_write_u32_le(buf, 7)                       
    buf = buf_write_u32_le(buf, nsects);
    buf = buf_write_u32_le(buf, 0)                       

    out buf;
end

func macho_emit_section_hdr:
    in(buf:ByteBuffer; sec:Section; file_offset:int; reloc_offset:int)
    buf = buf_write_string_padded(buf, sec.name, 16)     
    buf = buf_write_string_padded(buf, sec.seg_name, 16) 
    buf = buf_write_u64_le(buf, 0)                       
    buf = buf_write_u64_le(buf, buf_size(sec.data) >> int) 
    buf = buf_write_u32_le(buf, file_offset >> int)       
    buf = buf_write_u32_le(buf, sec.alignment >> int)     
    buf = buf_write_u32_le(buf, reloc_offset >> int)      
    buf = buf_write_u32_le(buf, vec_len(sec.relocs) >> int)
    buf = buf_write_u32_le(buf, S_REGULAR)                
    buf = buf_write_u32_le(buf, 0)                        
    buf = buf_write_u32_le(buf, 0)                        
    buf = buf_write_u32_le(buf, 0)                        

    out buf;
end

func macho_emit_symtab_cmd:
    in(buf:ByteBuffer; symoff:int; nsyms:int; stroff:int; strsize:int)
    buf = buf_write_u32_le(buf, LC_SYMTAB);
    buf = buf_write_u32_le(buf, 24)       
    buf = buf_write_u32_le(buf, symoff);
    buf = buf_write_u32_le(buf, nsyms);
    buf = buf_write_u32_le(buf, stroff);
    buf = buf_write_u32_le(buf, strsize);
    out buf;
end

func macho_build:
    in(builder:MachOBuilder)
    out = buf_new();

    nsections = vec_len(builder.sections) >> int;
    if nsections == 0:
        out Err(str_new("No sections to emit"));
    end

    header_size = 32 >> int;
    segment_cmd_size = (72 + nsections * 80) >> int;
    symtab_cmd_size = 24 >> int;
    total_cmd_size = segment_cmd_size + symtab_cmd_size;
    data_offset = header_size + total_cmd_size;

    total_data_size = 0;
    i = 0;
    when i < nsections as i32 loop
        total_data_size = total_data_size + buf_size(vec_get(builder.sections, i).data);
        i = i + 1;
    end

    out = macho_emit_header(out, builder.arch, 2, total_cmd_size >> int);

    out = macho_emit_segment_cmd(out, str_new(""), nsections,;
                                  data_offset, total_data_size);

    sec_offset = data_offset;
    i = 0;
    when i < nsections as i32 loop
        sec = vec_get(builder.sections, i);
        out = macho_emit_section_hdr(out, sec, sec_offset, 0);
        sec_offset = sec_offset + buf_size(sec.data);
        i = i + 1;
    end

    symoff = (data_offset + total_data_size) >> int;
    nsyms = vec_len(builder.symbols) >> int;
    stroff = symoff + nsyms * 16  
    strsize = buf_size(builder.strtab) >> int;
    out = macho_emit_symtab_cmd(out, symoff, nsyms, stroff, strsize);

    i = 0;
    when i < nsections as i32 loop
        sec = vec_get(builder.sections, i);
        out = buf_write_bytes(out, sec.data.data);
        i = i + 1;
    end

    i = 0;
    when i < vec_len(builder.symbols) loop
        sym = vec_get(builder.symbols, i);
        var (builder2, str_idx) = macho_strtab_add(builder, sym.name);
        builder = builder2;

        out = buf_write_u32_le(out, str_idx >> int)    
        if sym.is_global:
            out = buf_write_u8(out, 0x0F)                      
        else
            out = buf_write_u8(out, 0x0E)                      
        end
        out = buf_write_u8(out, sym.section >> int)      
        out = buf_write_u16_le(out, 0)                         
        out = buf_write_u64_le(out, sym.offset >> int)  

        i = i + 1;
    end

    out = buf_write_bytes(out, builder.strtab.data);

    out Ok(out);
end

func emit_object_file:
    in(code:Vec<int>; arch:Arch)
    builder = macho_new(arch);

    text = section_text();
    text.data = buf_new();
    text.data = buf_write_bytes(text.data, code);

    builder = macho_add_section(builder, text);

    out macho_build(builder);
end

func emit_kernel_object:
    in(kernel_name:string; code:Vec<int>; arch:Arch)
    builder = macho_new(arch);

    text = section_text();
    text.data = buf_new();
    text.data = buf_write_bytes(text.data, code);
    builder = macho_add_section(builder, text);

    builder = macho_add_symbol(builder, Symbol (;
        name: format("_vir_()", kernel_name),;
        sym_type: SymbolType::Function,;
        section: 1,;
        offset: 0,;
        size: vec_len(code) >> int,;
        is_global: true
    ));

    out macho_build(builder);
end

# -- END vir/compiler/binary.vri --

# -- BEGIN vir/compiler/linker.vri --

const MH_EXECUTE: 2    
const LC_MAIN: 0x80000028;
const LC_LOAD_DYLIB: 0x0C;
const LC_DYLD_INFO_ONLY: 0x80000022;

const TEXT_BASE: 0x100000000;
const DATA_BASE: 0x100004000;
const PAGE_SIZE: 0x4000;

entity ObjectFile:
    name:       string;
    sections:   Vec<Section>;
    symbols:    Vec<Symbol>;
    relocs:     Vec<Relocation>;
end

entity ResolvedSymbol:
    name:           string;
    final_address:  int;
    obj_idx:        int;
    sec_idx:        int;
    is_external:    bool;
end

entity Linker:
    objects:        Vec<ObjectFile>;
    symtab:         Map<string, ResolvedSymbol>;
    text_buf:       ByteBuffer;
    data_buf:       ByteBuffer;
    entry_point:    int;
    errors:         Vec<string>;
end

func linker_new:
    out Linker (;
        objects: vec_new(),;
        symtab: map_new(),;
        text_buf: buf_new(),;
        data_buf: buf_new(),;
        entry_point: TEXT_BASE,;
        errors: vec_new()
    );
end

func linker_add_object:
    in(lnk:Linker; obj:ObjectFile)
    vec_push(lnk.objects, obj);
    out lnk;
end

func linker_resolve_symbols:
    in(lnk:Linker)
    text_offset = 0;

    obj_i = 0;
    when obj_i < vec_len(lnk.objects) loop
        obj = vec_get(lnk.objects, obj_i);

        sym_i = 0;
        when sym_i < vec_len(obj.symbols) loop
            sym = vec_get(obj.symbols, sym_i);

            if sym.is_global:
                if map_contains(lnk.symtab, sym.name):
                    vec_push(lnk.errors, format(;
                        "Duplicate symbol: () (in () and previous object)",;
                        sym.name, obj.name));
                else
                    resolved = ResolvedSymbol (;
                        name: sym.name,;
                        final_address: TEXT_BASE + text_offset + (sym.offset >> int),;
                        obj_idx: obj_i,;
                        sec_idx: sym.section,;
                        is_external: false
                    );
                    map_set(lnk.symtab, sym.name, resolved);
                end
            end

            sym_i = sym_i + 1;
        end

        sec_i = 0;
        when sec_i < vec_len(obj.sections) loop
            sec = vec_get(obj.sections, sec_i);
            if str_eq(sec.name, str_new("__text")):
                text_offset = text_offset + (buf_size(sec.data) >> int);
            end
            sec_i = sec_i + 1;
        end

        obj_i = obj_i + 1;
    end

    main_sym = map_get(lnk.symtab, str_new("_main"));
    if main_sym != None:
        lnk.entry_point = main_sym.final_address;
    end

    out lnk;
end

func linker_apply_relocations:
    in(lnk:Linker)
    obj_i = 0;
    when obj_i < vec_len(lnk.objects) loop
        obj = vec_get(lnk.objects, obj_i);

        sec_i = 0;
        when sec_i < vec_len(obj.sections) loop
            sec = vec_get(obj.sections, sec_i);

            rel_i = 0;
            when rel_i < vec_len(sec.relocs) loop
                reloc = vec_get(sec.relocs, rel_i);
                target_sym = vec_get(obj.symbols, reloc.sym_idx);
                resolved = map_get(lnk.symtab, target_sym.name);

                if resolved == None:
                    vec_push(lnk.errors, format(;
                        "Undefined symbol: () (referenced in ())",;
                        target_sym.name, obj.name));
                else
                    if reloc.reloc_type == RelocType::Branch26:
                        pc = TEXT_BASE + (reloc.offset >> int);
                        delta = (resolved.final_address - pc) >> int;
                        imm26 = ((delta >> 2) & 0x03FFFFFF) >> int;
                        patch_u32(sec.data, reloc.offset >> int,;
                                  0x94000000 | imm26);
                    end

                    if reloc.reloc_type == RelocType::Page21:
                        pc_page = (TEXT_BASE + (reloc.offset >> int)) & ~0xFFF_u64;
                        sym_page = resolved.final_address & ~0xFFF_u64;
                        page_delta = ((sym_page - pc_page) >> 12) >> int;
                        immlo = (page_delta & 0x3) >> int;
                        immhi = ((page_delta >> 2) & 0x7FFFF) >> int;
                        insn = 0x90000000_u32 | (immlo << 29) | (immhi << 5);
                        patch_u32(sec.data, reloc.offset >> int, insn);
                    end

                    if reloc.reloc_type == RelocType::PageOff12:
                        page_off = (resolved.final_address & 0xFFF) >> int;
                        insn = read_u32(sec.data, reloc.offset >> int);
                        insn = (insn & 0xFFC003FF_u32) | (page_off << 10);
                        patch_u32(sec.data, reloc.offset >> int, insn);
                    end

                    if reloc.reloc_type == RelocType::PC32:
                        pc = TEXT_BASE + (reloc.offset >> int) + 4;
                        delta = (resolved.final_address - pc) >> int;
                        patch_i32(sec.data, reloc.offset >> int, delta);
                    end
                end

                rel_i = rel_i + 1;
            end

            sec_i = sec_i + 1;
        end

        obj_i = obj_i + 1;
    end
    out lnk;
end

func linker_merge_sections:
    in(lnk:Linker)
    obj_i = 0;
    when obj_i < vec_len(lnk.objects) loop
        obj = vec_get(lnk.objects, obj_i);

        sec_i = 0;
        when sec_i < vec_len(obj.sections) loop
            sec = vec_get(obj.sections, sec_i);

            if str_eq(sec.seg_name, str_new("__TEXT")):
                lnk.text_buf = buf_write_bytes(lnk.text_buf, sec.data.data);
                lnk.text_buf = buf_align(lnk.text_buf, 4);
            end

            if str_eq(sec.seg_name, str_new("__DATA")):
                lnk.data_buf = buf_write_bytes(lnk.data_buf, sec.data.data);
                lnk.data_buf = buf_align(lnk.data_buf, 8);
            end

            sec_i = sec_i + 1;
        end

        obj_i = obj_i + 1;
    end
    out lnk;
end

func linker_emit_executable:
    in(lnk:Linker; arch:Arch)
    if vec_len(lnk.errors) > 0:
        msg = str_new("Linker errors:\n");
        i = 0;
        when i < vec_len(lnk.errors) loop
            msg = str_concat(msg, format("  - ()\n", vec_get(lnk.errors, i)));
            i = i + 1;
        end
        out Err(msg);
    end

    out = buf_new();

    text_size = buf_size(lnk.text_buf) >> int;
    data_size = buf_size(lnk.data_buf) >> int;

    text_filesize = ((text_size + PAGE_SIZE - 1) / PAGE_SIZE) * PAGE_SIZE;
    data_filesize = ((data_size + PAGE_SIZE - 1) / PAGE_SIZE) * PAGE_SIZE;

    ncmds = 5_u32;
    header_and_cmds_size = 32 + 72 + (72 + 80) + (72 + 80) + 24 + 24;

    out = buf_write_u32_le(out, MH_MAGIC_64);
    if arch == Arch::ARM64:
        out = buf_write_u32_le(out, CPU_TYPE_ARM64);
    else
        out = buf_write_u32_le(out, CPU_TYPE_X86_64);
    end
    out = buf_write_u32_le(out, CPU_SUBTYPE_ALL);
    out = buf_write_u32_le(out, MH_EXECUTE);
    out = buf_write_u32_le(out, ncmds);
    out = buf_write_u32_le(out, (header_and_cmds_size - 32) >> int);
    out = buf_write_u32_le(out, 0x00200085_u32) 
    out = buf_write_u32_le(out, 0)              

    out = buf_write_u32_le(out, LC_SEGMENT_64);
    out = buf_write_u32_le(out, 72)        
    out = buf_write_string_padded(out, str_new("__PAGEZERO"), 16);
    out = buf_write_u64_le(out, 0)         
    out = buf_write_u64_le(out, TEXT_BASE)  
    out = buf_write_u64_le(out, 0)         
    out = buf_write_u64_le(out, 0)         
    out = buf_write_u32_le(out, 0)         
    out = buf_write_u32_le(out, 0)         
    out = buf_write_u32_le(out, 0)         
    out = buf_write_u32_le(out, 0)         

    out = macho_emit_segment_cmd(out, str_new("__TEXT"), 1,;
                                  0, text_filesize >> int);
    text_sec = section_text();
    text_sec.data = lnk.text_buf;
    out = macho_emit_section_hdr(out, text_sec,;
                                  header_and_cmds_size >> int, 0);

    out = macho_emit_segment_cmd(out, str_new("__DATA"), 1,;
                                  text_filesize >> int, data_filesize >> int);
    data_sec = section_data();
    data_sec.data = lnk.data_buf;
    out = macho_emit_section_hdr(out, data_sec,;
                                  (header_and_cmds_size >> int + text_filesize) >> int, 0);

    out = buf_write_u32_le(out, LC_MAIN);
    out = buf_write_u32_le(out, 24)                       
    out = buf_write_u64_le(out, lnk.entry_point - TEXT_BASE) 
    out = buf_write_u64_le(out, 0)                        

    out = macho_emit_symtab_cmd(out, 0, 0, 0, 0);

    pad_needed = (text_filesize >> int) - (buf_size(out));
    if pad_needed > 0:
        out = buf_write_zeros(out, pad_needed >> int);
    end

    out = buf_write_bytes(out, lnk.text_buf.data);
    text_pad = (text_filesize >> int) - (buf_size(lnk.text_buf));
    if text_pad > 0:
        out = buf_write_zeros(out, text_pad >> int);
    end

    out = buf_write_bytes(out, lnk.data_buf.data);
    data_pad = (data_filesize >> int) - (buf_size(lnk.data_buf));
    if data_pad > 0:
        out = buf_write_zeros(out, data_pad >> int);
    end

    out Ok(out);
end

func link_objects:
    in(objects:Vec<ObjectFile>; arch:Arch)
    lnk = linker_new();

    i = 0;
    when i < vec_len(objects) loop
        lnk = linker_add_object(lnk, vec_get(objects, i));
        i = i + 1;
    end

    lnk = linker_resolve_symbols(lnk);
    lnk = linker_apply_relocations(lnk);
    lnk = linker_merge_sections(lnk);

    out linker_emit_executable(lnk, arch);
end

func link_single_kernel:
    in(kernel_name:string; code:Vec<int>; arch:Arch)
    obj = ObjectFile (;
        name: format("().o", kernel_name),;
        sections: vec_new(),;
        symbols: vec_new(),;
        relocs: vec_new()
    );

    text = section_text();
    text.data = buf_new();
    text.data = buf_write_bytes(text.data, code);
    vec_push(obj.sections, text);

    vec_push(obj.symbols, Symbol (;
        name: format("_main"),;
        sym_type: SymbolType::Function,;
        section: 1,;
        offset: 0,;
        size: vec_len(code) >> int,;
        is_global: true
    ));

    objects = vec_new();
    vec_push(objects, obj);
    out link_objects(objects, arch);
end

# -- END vir/compiler/linker.vri --

# -- BEGIN vir/compiler/file.vri --

enum FileMode:
    Read      = 1    
    Write     = 2    
    Append    = 4    
    ReadWrite = 3    
end

entity File:
    fd: int          
    path: string;
    mode: FileMode;
    closed: bool;
end

func file_open:
    in(path:string; mode:FileMode)
    fd = native_file_open(path.data, path.byte_len, mode);
    if fd < 0:
        out Err(IoError (;
            kind: io_error_from_errno(native_errno()),;
            msg: "cannot open file: " + path
        ));
    end
    out Ok(File ( fd: fd, path: path, mode: mode, closed: false ));
end

func file_create:
    in(path:string)
    out file_open(path, FileMode.Write);
end

func file_close:
    in(f:File)
    if f.closed out Ok(void) end:
    r = native_file_close(f.fd);
    f.closed = true;
    if r < 0:
        out Err(IoError ( kind: IoErrorKind.Other, msg: "close failed" ));
    end
    out Ok(void);
end

func file_read:
    in(f:File; buf:Slice)
    if f.closed:
        out Err(IoError ( kind: IoErrorKind.Other, msg: "file is closed" ));
    end
    n = native_file_read(f.fd, buf.data, buf.len);
    if n < 0:
        out Err(IoError ( kind: io_error_from_errno(native_errno()), msg: "read failed" ));
    end
    out Ok(to_u64(n));
end

func file_read_all:
    in(f:File)
    buf = buffer_new(4096);
    tmp = alloc(4096);
    slice = slice_new(tmp, 4096);

    running = true;
    when running loop
        r = file_read(f, slice);
        case r;
            case Ok(0) running = false
            case Ok(n) buffer_write_bytes(buf, tmp, n)
            case Err(e)
                free(tmp);
                buffer_free(buf);
                out Err(e);
        end
    end

    s = str_from_bytes(buf.data, buffer_len(buf));
    free(tmp);
    buffer_free(buf);
    out Ok(s);
end

func file_read_bytes:
    in(f:File)
    result = buffer_new(4096);
    tmp = alloc(4096);
    slice = slice_new(tmp, 4096);

    running = true;
    when running loop
        r = file_read(f, slice);
        case r;
            case Ok(0) running = false
            case Ok(n) buffer_write_bytes(result, tmp, n)
            case Err(e)
                free(tmp);
                buffer_free(result);
                out Err(e);
        end
    end

    free(tmp);
    out Ok(result);
end

func file_write:
    in(f:File; data:Slice)
    if f.closed:
        out Err(IoError ( kind: IoErrorKind.Other, msg: "file is closed" ));
    end
    n = native_file_write(f.fd, data.data, data.len);
    if n < 0:
        out Err(IoError ( kind: io_error_from_errno(native_errno()), msg: "write failed" ));
    end
    out Ok(to_u64(n));
end

func file_write_str:
    in(f:File; s:string)
    out file_write(f, slice_new(s.data, s.byte_len));
end

func file_write_all:
    in(f:File; data:Slice)
    written = 0;
    when written < data.len loop
        r = file_write(f, slice_sub(data, written, data.len));
        case r;
            case Ok(n) written = written + n
            case Err(e) out Err(e)
        end
    end
    out Ok(void);
end

func file_seek:
    in(f:File; offset:int; whence:SeekFrom)
    if f.closed:
        out Err(IoError ( kind: IoErrorKind.Other, msg: "file is closed" ));
    end
    pos = native_file_seek(f.fd, offset, whence);
    if pos < 0:
        out Err(IoError ( kind: io_error_from_errno(native_errno()), msg: "seek failed" ));
    end
    out Ok(to_u64(pos));
end

func file_size:
    in(f:File)
    current = file_seek(f, 0, SeekFrom.Current);
    if is_err(current) out current end:
    end = file_seek(f, 0, SeekFrom.End);
    if is_err(end) out end end:
    file_seek(f, unwrap(current), SeekFrom.Start);
    out end;
end

func read_file:
    in(path:string)
    f = file_open(path, FileMode.Read);
    if is_err(f) out Err(unwrap_err(f)) end:
    content = file_read_all(unwrap(f));
    file_close(unwrap(f));
    out content;
end

func write_file:
    in(path:string; content:string)
    f = file_open(path, FileMode.Write);
    if is_err(f) out Err(unwrap_err(f)) end:
    r = file_write_str(unwrap(f), content);
    file_close(unwrap(f));
    if is_err(r) out Err(unwrap_err(r)) end:
    out Ok(void);
end

func io_error_from_errno:
    in(errno:int)
    case errno;
        case 2  out IoErrorKind.NotFound         
        case 13 out IoErrorKind.PermissionDenied 
        case 17 out IoErrorKind.AlreadyExists    
        case 22 out IoErrorKind.InvalidInput     
        default out IoErrorKind.Other;
    end
end

# -- END vir/compiler/file.vri --

# -- BEGIN vir/compiler/slice.vri --

entity Slice:
    data: ptr;
    len: int;
end

func slice_new:
    in(data:ptr; len:int)
    out Slice ( data: data, len: len );
end

func slice_empty:
    out Slice ( data: null, len: 0 );
end

func slice_get:
    in(s:Slice; i:int)
    if i >= s.len:
        panic("slice index out of bounds: " + to_string(i) + " >= " + to_string(s.len));
    end
    out native_read_u8(s.data, i);
end

func slice_set:
    in(s:Slice; i:int; val:int)
    if i >= s.len:
        panic("slice index out of bounds");
    end
    native_write_u8(s.data, i, val);
end

func slice_sub:
    in(s:Slice; from:int; to:int)
    if from > to or to > s.len:
        panic("slice_sub: invalid range");
    end
    out Slice ( data: s.data + from, len: to - from );
end

func slice_eq:
    in(a:Slice; b:Slice)
    if a.len != b.len out false end:
    out mem_cmp(a.data, b.data, a.len) == 0;
end

func slice_find_byte:
    in(s:Slice; b:int)
    v_i m_i i in 0..s.len;
        if slice_get(s, i) == b:
            out Some(i);
        end
    end
    out None;
end

func slice_copy_to:
    in(src:Slice; dst:Slice)
    n = min(src.len, dst.len);
    mem_copy(dst.data, src.data, n);
end

func slice_fill:
    in(s:Slice; val:int)
    mem_set(s.data, val, s.len);
end

# -- END vir/compiler/slice.vri --

# -- BEGIN vir/mem/buffer.vri --

const BUFFER_INITIAL_CAP: 256;

entity Buffer:
    data: ptr;
    len: int;
    cap: int;
end

func buffer_new:
    in(cap:int)
    actual_cap = if cap > 0 cap else BUFFER_INITIAL_CAP end;
    out Buffer (;
        data: alloc(actual_cap),;
        len: 0,;
        cap: actual_cap
    );
end

func buffer_default:
    out buffer_new(BUFFER_INITIAL_CAP);
end

func buffer_grow:
    in(b:Buffer; min_cap:int)
    if min_cap <= b.cap out end:
    new_cap = b.cap * 2;
    when new_cap < min_cap loop
        new_cap = new_cap * 2;
    end
    b.data = realloc(b.data, new_cap);
    b.cap = new_cap;
end

func buffer_push:
    in(b:Buffer; byte:int)
    buffer_grow(b, b.len + 1);
    native_write_u8(b.data, b.len, byte);
    b.len = b.len + 1;
end

func buffer_push_u16:
    in(b:Buffer; val:int)
    buffer_grow(b, b.len + 2);
    native_write_u16_le(b.data, b.len, val);
    b.len = b.len + 2;
end

func buffer_push_u32:
    in(b:Buffer; val:int)
    buffer_grow(b, b.len + 4);
    native_write_u32_le(b.data, b.len, val);
    b.len = b.len + 4;
end

func buffer_push_u64:
    in(b:Buffer; val:int)
    buffer_grow(b, b.len + 8);
    native_write_u64_le(b.data, b.len, val);
    b.len = b.len + 8;
end

func buffer_write:
    in(b:Buffer; data:Slice)
    buffer_grow(b, b.len + data.len);
    mem_copy(b.data + b.len, data.data, data.len);
    b.len = b.len + data.len;
end

func buffer_write_bytes:
    in(b:Buffer; src:ptr; count:int)
    buffer_grow(b, b.len + count);
    mem_copy(b.data + b.len, src, count);
    b.len = b.len + count;
end

func buffer_read_u8:
    in(b:Buffer; offset:int)
    if offset >= b.len panic("buffer read out of bounds") end:
    out native_read_u8(b.data, offset);
end

func buffer_read_u32:
    in(b:Buffer; offset:int)
    if offset + 4 > b.len panic("buffer read out of bounds") end:
    out native_read_u32_le(b.data, offset);
end

func buffer_write_at:
    in(b:Buffer; offset:int; val:int)
    if offset >= b.len panic("buffer write out of bounds") end:
    native_write_u8(b.data, offset, val);
end

func buffer_write_u32_at:
    in(b:Buffer; offset:int; val:int)
    if offset + 4 > b.len panic("buffer write out of bounds") end:
    native_write_u32_le(b.data, offset, val);
end

func buffer_patch_u32:
    in(b:Buffer; offset:int; val:int)
    buffer_write_u32_at(b, offset, val);
end

func buffer_as_slice:
    in(b:Buffer)
    out slice_new(b.data, b.len);
end

func buffer_clear:
    in(b:Buffer)
    b.len = 0;
end

func buffer_free:
    in(b:Buffer)
    free(b.data);
    b.data = null;
    b.len = 0;
    b.cap = 0;
end

func buffer_len:
    in(b:Buffer)
    out b.len;
end

func buffer_cap:
    in(b:Buffer)
    out b.cap;
end

func buffer_is_empty:
    in(b:Buffer)
    out b.len == 0;
end

func buffer_reserve:
    in(b:Buffer; additional:int)
    buffer_grow(b, b.len + additional);
end

func buffer_truncate:
    in(b:Buffer; new_len:int)
    if new_len < b.len:
        b.len = new_len;
    end
end

# -- END vir/mem/buffer.vri --

# -- BEGIN vir/io/traits.vri --

giao_di_n Reader;
    func read:
        in(buf:Slice)
end

giao_di_n Writer;
    func write:
        in(data:Slice)

    func flush:
end

enum SeekFrom:
    Start = 0      
    Current = 1    
    End = 2        
end

giao_di_n Seeker;
    func seek:
        in(offset:int; whence:SeekFrom)
end

giao_di_n ReadWriter;
    th_c_hi_n Reader;
    th_c_hi_n Writer;
end

func read_all:
    in(reader:Reader)
    result = buffer_new(4096);
    buf = alloc(4096);
    slice = slice_new(buf, 4096);

    loop_running = true;
    when loop_running loop
        n = reader.read(slice);
        case n;
            case Ok(0) loop_running = false
            case Ok(count) buffer_write_bytes(result, buf, count)
            case Err(e)
                free(buf);
                buffer_free(result);
                out Err(e);
        end
    end

    free(buf);
    out Ok(result);
end

func write_all:
    in(writer:Writer; data:Slice)
    written = 0;
    when written < data.len loop
        remaining = slice_sub(data, written, data.len);
        n = writer.write(remaining);
        case n;
            case Ok(count) written = written + count
            case Err(e) out Err(e)
        end
    end
    out Ok(void);
end

func copy:
    in(reader:Reader; writer:Writer)
    total = 0;
    buf = alloc(8192);
    slice = slice_new(buf, 8192);

    loop_running = true;
    when loop_running loop
        n = reader.read(slice);
        case n;
            case Ok(0) loop_running = false
            case Ok(count)
                w = writer.write(slice_new(buf, count));
                case w;
                    case Ok(_) total = total + count
                    case Err(e) free(buf); out Err(e)
                end
            case Err(e) free(buf); out Err(e)
        end
    end

    free(buf);
    out Ok(total);
end

# -- END vir/io/traits.vri --

# -- BEGIN vir/error/error.vri --

enum ErrorKind:
    NotFound        = 1;
    PermissionDenied = 2;
    AlreadyExists   = 3;
    BrokenPipe      = 4;
    WouldBlock      = 5;
    TimedOut        = 6;
    ConnectionRefused = 7;
    ConnectionReset = 8;
    Interrupted     = 9;
    
    InvalidInput    = 20;
    InvalidData     = 21;
    InvalidEncoding = 22;
    ParseIntError   = 23;
    ParseFloatError = 24;
    SyntaxError     = 25;
    
    OutOfMemory     = 40;
    Overflow        = 41;
    DivisionByZero  = 42;
    IndexOutOfBounds = 43;
    NullPointer     = 44;
    StackOverflow   = 45;
    
    Unimplemented   = 60;
    Unreachable     = 61;
    AssertionFailed = 62;
    
    Other           = 99;
end

entity Error:
    kind:    ErrorKind;
    message: string;
    source:  Option<ptr>  
end

func error_new:
    in(kind:ErrorKind; msg:string)
    out Error ( kind = kind, message = msg, source = None );
end

func error_with_source:
    in(kind:ErrorKind; msg:string; src:Error)
    src_ptr = native_box(src)  
    out Error ( kind = kind, message = msg, source = Some(src_ptr) );
end

func error_kind:
    in(e:Error)
    out e.kind;
end

func error_message:
    in(e:Error)
    out e.message;
end

func error_source:
    in(e:Error)
    case e.source;
        case Some(p) out Some(native_unbox<Error>(p))
        case None out None
    end
end

func error_to_string:
    in(e:Error)
    prefix = error_kind_name(e.kind);
    out str_concat(str_concat(prefix, str_new(": ")), e.message);
end

func error_chain:
    in(e:Error)
    s = error_to_string(e);
    cause = error_source(e);
    when is_some(cause) loop
        c = unwrap(cause);
        s = str_concat(s, str_new("\n  caused by: "));
        s = str_concat(s, error_to_string(c));
        cause = error_source(c);
    end
    out s;
end

func error_kind_name:
    in(kind:ErrorKind)
    case kind;
        case ErrorKind.NotFound out str_new("NotFound")
        case ErrorKind.PermissionDenied out str_new("PermissionDenied")
        case ErrorKind.AlreadyExists out str_new("AlreadyExists")
        case ErrorKind.BrokenPipe out str_new("BrokenPipe")
        case ErrorKind.InvalidInput out str_new("InvalidInput")
        case ErrorKind.InvalidData out str_new("InvalidData")
        case ErrorKind.ParseIntError out str_new("ParseIntError")
        case ErrorKind.ParseFloatError out str_new("ParseFloatError")
        case ErrorKind.SyntaxError out str_new("SyntaxError")
        case ErrorKind.OutOfMemory out str_new("OutOfMemory")
        case ErrorKind.Overflow out str_new("Overflow")
        case ErrorKind.DivisionByZero out str_new("DivisionByZero")
        case ErrorKind.IndexOutOfBounds out str_new("IndexOutOfBounds")
        case ErrorKind.NullPointer out str_new("NullPointer")
        case ErrorKind.Unimplemented out str_new("Unimplemented")
        case ErrorKind.AssertionFailed out str_new("AssertionFailed")
        default out str_new("Error");
    end
end

func io_error:
    in(msg:string)
    out error_new(ErrorKind.NotFound, msg);
end

func parse_error:
    in(msg:string)
    out error_new(ErrorKind.InvalidInput, msg);
end

func overflow_error:
    in(msg:string)
    out error_new(ErrorKind.Overflow, msg);
end

func index_error:
    in(msg:string)
    out error_new(ErrorKind.IndexOutOfBounds, msg);
end

func null_error:
    out error_new(ErrorKind.NullPointer, str_new("null pointer dereference"));
end

func todo_error:
    in(msg:string)
    out error_new(ErrorKind.Unimplemented, msg);
end

entity IoError:
    kind:    ErrorKind;
    message: string;
    errno:   int          
end

func io_error_from_errno:
    in(errno:int)
    var kind:ErrorKind;
    var msg:string;
    
    case errno;
        case 2
            kind = ErrorKind.NotFound;
            msg = str_new("file not found");
        case 13
            kind = ErrorKind.PermissionDenied;
            msg = str_new("permission denied");
        case 17
            kind = ErrorKind.AlreadyExists;
            msg = str_new("already exists");
        case 12
            kind = ErrorKind.OutOfMemory;
            msg = str_new("out of memory");
        default;
            kind = ErrorKind.Other;
            msg = str_new("I/O error");
    end
    
    out IoError ( kind = kind, message = msg, errno = errno );
end

func io_error_to_error:
    in(e:IoError)
    out error_new(e.kind, e.message);
end

func panic_msg:
    in(msg:string)
    eprintln(str_concat(str_new("PANIC: "), msg));
    native_abort();
end

func unreachable:
    panic_msg(str_new("entered unreachable code"));
end

func unimplemented:
    in(feature:string)
    panic_msg(str_concat(str_new("not yet implemented: "), feature));
end

func todo:
    in(what:string)
    panic_msg(str_concat(str_new("TODO: "), what));
end

# -- END vir/error/error.vri --
