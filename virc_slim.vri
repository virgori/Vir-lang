type i8;     
type i16;    
type i32;    
type i64;    

type u8;     
type u16;    
type u32;    
type u64;    

type f32;    
type f64;    

type bool;   
type byte;   
type ptr;    
type void;   

type usize;  
type isize;  

const I8_MIN: -128;
const I8_MAX: 127;
const I16_MIN: -32768;
const I16_MAX: 32767;
const I32_MIN: -2147483648;
const I32_MAX: 2147483647;
const I64_MIN: -9223372036854775808;
const I64_MAX: 9223372036854775807;

const U8_MAX: 255;
const U16_MAX: 65535;
const U32_MAX: 4294967295;
const U64_MAX: 18446744073709551615;

const F32_EPSILON: 1.1920929e-7;
const F32_MIN: 1.17549435e-38;
const F32_MAX: 3.40282347e+38;

const F64_EPSILON: 2.2204460492503131e-16;
const F64_MIN: 2.2250738585072014e-308;
const F64_MAX: 1.7976931348623157e+308;

func to_i8:
    in(x:i64)
    if x < I8_MIN or x > I8_MAX:
        panic("overflow: i64 -> i8");
    end
    out x >> i8;
end

func to_i16:
    in(x:i64)
    if x < I16_MIN or x > I16_MAX:
        panic("overflow: i64 -> i16");
    end
    out x >> i16;
end

func to_i32:
    in(x:i64)
    if x < I32_MIN or x > I32_MAX:
        panic("overflow: i64 -> i32");
    end
    out x >> i32;
end

func to_u8:
    in(x:i64)
    if x < 0 or x > U8_MAX:
        panic("overflow: i64 -> u8");
    end
    out x >> u8;
end

func to_u16:
    in(x:i64)
    if x < 0 or x > U16_MAX:
        panic("overflow: i64 -> u16");
    end
    out x >> u16;
end

func to_u32:
    in(x:i64)
    if x < 0 or x > U32_MAX:
        panic("overflow: i64 -> u32");
    end
    out x >> u32;
end

func to_u64:
    in(x:i64)
    if x < 0:
        panic("overflow: i64 -> u64 (negative)");
    end
    out x >> u64;
end

func to_f32:
    in(x:f64)
    out x >> f32;
end

func to_f64:
    in(x:i64)
    out x >> f64;
end

func to_bool:
    in(x:int)
    out x != 0;
end

func parse_int:
    in(s:string)
    result = 0;
    negative = false;
    pos = 0;
    base = 10;

    if len(s) == 0:
        out Err(ParseError ( msg: "empty string" ));
    end

    if s[0] == '-':
        negative = true;
        pos = 1;
    end

    if pos + 1 < len(s):
        if s[pos] == '0':
            case s[pos + 1];
                case 'x' base = 16; pos = pos + 2
                case 'b' base = 2;  pos = pos + 2
                case 'o' base = 8;  pos = pos + 2
            end
        end
    end

    when pos < len(s) loop
        ch = s[pos];
        digit = char_to_digit(ch, base);
        if is_err(digit):
            out Err(ParseError ( msg: "invalid digit" ));
        end
        result = result * base + unwrap(digit);
        pos = pos + 1;
    end

    if negative result = -result end:
    out Ok(result);
end

func parse_float:
    in(s:string)
    out native_parse_float(s);
end

# -- END vir/core/types.vri --

# -- BEGIN vir/rt/alloc.vri --

const PAGE_SIZE:        16384;       
const MIN_ARENA_SIZE:   1048576;     
const BLOCK_HEADER:     16;          
const BLOCK_FREE:       0x0;
const BLOCK_USED:       0x1;
const ALIGNMENT:        16;          

func page_alloc:
    in(size: int)
    let pages = (size + PAGE_SIZE - 1) / PAGE_SIZE;
    let actual = pages * PAGE_SIZE;

    let ptr = sys_mmap(0, actual,
                       PROT_READ | PROT_WRITE,
                       MAP_PRIVATE | MAP_ANONYMOUS,
                       -1, 0);
    if ptr < 0:
        out 0;  
    end
    out ptr;
end

func page_free:
    in(ptr: int, size: int)
    let pages = (size + PAGE_SIZE - 1) / PAGE_SIZE;
    let actual = pages * PAGE_SIZE;
    sys_munmap(ptr, actual);
end

entity Arena:
    base:       int;     
    capacity:   int;     
    offset:     int;     
end

func arena_new:
    in(size: int)
    let actual = size;
    if actual < MIN_ARENA_SIZE:
        actual = MIN_ARENA_SIZE;
    end
    let base = page_alloc(actual);
    if base == 0:
        out Arena ( base: 0, capacity: 0, offset: 0 );
    end
    out Arena ( base: base, capacity: actual, offset: 0 );
end

func arena_alloc:
    in(arena: Arena, size: int)
    let aligned = (size + ALIGNMENT - 1) & ~(ALIGNMENT - 1);

    if arena.offset + aligned > arena.capacity:
        out 0;  
    end

    let ptr = arena.base + arena.offset;
    arena.offset = arena.offset + aligned;
    out ptr;
end

func arena_reset:
    in(arena: Arena)
    arena.offset = 0;
    out arena;
end

func arena_destroy:
    in(arena: Arena)
    if arena.base != 0:
        page_free(arena.base, arena.capacity);
    end
end

entity FreeNode:
    size:       int;     
    next_ptr:   int;     
end

entity Heap:
    base:       int;     
    capacity:   int;     
    free_head:  int;     
    used:       int;     
end

var g_heap = Heap ( base: 0, capacity: 0, free_head: 0, used: 0 );

func heap_init:
    in(size: int)
    let actual = size;
    if actual < MIN_ARENA_SIZE:
        actual = MIN_ARENA_SIZE;
    end
    let base = page_alloc(actual);
    if base == 0:
        out false;
    end

    extern func native_write_i64(addr: int, offset: int, val: int);
    native_write_i64(base, 0, actual);      
    native_write_i64(base, 1, 0);           

    g_heap = Heap ( base: base, capacity: actual, free_head: base, used: 0 );
    out true;
end

func heap_alloc:
    in(size: int)
    let needed = size + BLOCK_HEADER;
    needed = (needed + ALIGNMENT - 1) & ~(ALIGNMENT - 1);

    extern func native_read_i64(addr: int, offset: int) -> int;
    extern func native_write_i64(addr: int, offset: int, val: int);

    let prev_ptr = 0;
    let cur = g_heap.free_head;

    when cur != 0 loop
        let block_size = native_read_i64(cur, 0);
        let next = native_read_i64(cur, 1);

        if block_size >= needed:
            let remainder = block_size - needed;

            if remainder >= (BLOCK_HEADER + ALIGNMENT):
                native_write_i64(cur, 0, needed);   
                let new_free = cur + needed;
                native_write_i64(new_free, 0, remainder);  
                native_write_i64(new_free, 1, next);        

                if prev_ptr == 0:
                    g_heap.free_head = new_free;
                else
                    native_write_i64(prev_ptr, 1, new_free);
                end
            else
                needed = block_size;
                if prev_ptr == 0:
                    g_heap.free_head = next;
                else
                    native_write_i64(prev_ptr, 1, next);
                end
            end

            native_write_i64(cur, 0, needed);
            native_write_i64(cur, 1, BLOCK_USED);
            g_heap.used = g_heap.used + needed;

            out cur + BLOCK_HEADER;  
        end

        prev_ptr = cur;
        cur = next;
    end

    let grow = needed;
    if grow < MIN_ARENA_SIZE:
        grow = MIN_ARENA_SIZE;
    end
    let new_region = page_alloc(grow);
    if new_region == 0:
        out 0;  
    end

    native_write_i64(new_region, 0, needed);
    native_write_i64(new_region, 1, BLOCK_USED);

    let remainder = grow - needed;
    if remainder >= (BLOCK_HEADER + ALIGNMENT):
        let new_free = new_region + needed;
        native_write_i64(new_free, 0, remainder);
        native_write_i64(new_free, 1, g_heap.free_head);
        g_heap.free_head = new_free;
    end

    g_heap.used = g_heap.used + needed;
    g_heap.capacity = g_heap.capacity + grow;
    out new_region + BLOCK_HEADER;
end

func heap_free:
    in(ptr: int)
    if ptr == 0:
        out;
    end

    extern func native_read_i64(addr: int, offset: int) -> int;
    extern func native_write_i64(addr: int, offset: int, val: int);

    let block = ptr - BLOCK_HEADER;
    let block_size = native_read_i64(block, 0);

    native_write_i64(block, 0, block_size);
    native_write_i64(block, 1, g_heap.free_head);
    g_heap.free_head = block;
    g_heap.used = g_heap.used - block_size;
end

func heap_realloc:
    in(ptr: int, new_size: int)
    if ptr == 0:
        out heap_alloc(new_size);
    end

    extern func native_read_i64(addr: int, offset: int) -> int;
    extern func native_mem_copy(dst: int, src: int, len: int);

    let block = ptr - BLOCK_HEADER;
    let old_size = native_read_i64(block, 0) - BLOCK_HEADER;

    if new_size <= old_size:
        out ptr;  
    end

    let new_ptr = heap_alloc(new_size);
    if new_ptr == 0:
        out 0;
    end

    let copy_len = old_size;
    if new_size < copy_len:
        copy_len = new_size;
    end
    native_mem_copy(new_ptr, ptr, copy_len);
    heap_free(ptr);
    out new_ptr;
end

var g_initialized = false;

func vir_alloc:
    in(size: int)
    if g_initialized == false:
        heap_init(MIN_ARENA_SIZE * 4);  
        g_initialized = true;
    end
    out heap_alloc(size);
end

func vir_free:
    in(ptr: int)
    heap_free(ptr);
end

func vir_realloc:
    in(ptr: int, new_size: int)
    if g_initialized == false:
        heap_init(MIN_ARENA_SIZE * 4);
        g_initialized = true;
    end
    out heap_realloc(ptr, new_size);
end

# -- END vir/rt/alloc.vri --

# -- BEGIN vir/rt/string_rt.vri --

extern func native_read_u8(addr: int, offset: int) -> int;
extern func native_write_u8(addr: int, offset: int, val: int);
extern func native_mem_copy(dst: int, src: int, len: int);
extern func native_mem_set(dst: int, val: int, len: int);

func rt_strlen:
    in(s: int)
    if s == 0:
        out 0;
    end
    let i = 0;
    when native_read_u8(s, i) != 0 loop
        i = i + 1;
    end
    out i;
end

func rt_strcpy:
    in(dst: int, src: int)
    let i = 0;
    let ch = native_read_u8(src, i);
    when ch != 0 loop
        native_write_u8(dst, i, ch);
        i = i + 1;
        ch = native_read_u8(src, i);
    end
    native_write_u8(dst, i, 0);   
    out dst;
end

func rt_strcmp:
    in(a: int, b: int)
    let i = 0;
    when true loop
        let ca = native_read_u8(a, i);
        let cb = native_read_u8(b, i);
        if ca != cb:
            out ca - cb;
        end
        if ca == 0:
            out 0;   
        end
        i = i + 1;
    end
    out 0;
end

func rt_streq:
    in(a: int, b: int)
    out rt_strcmp(a, b) == 0;
end

func rt_strcat:
    in(a: int, b: int)
    let la = rt_strlen(a);
    let lb = rt_strlen(b);
    let result = vir_alloc(la + lb + 1);
    native_mem_copy(result, a, la);
    native_mem_copy(result + la, b, lb);
    native_write_u8(result, la + lb, 0);
    out result;
end

func rt_strdup:
    in(s: int)
    let len = rt_strlen(s);
    let result = vir_alloc(len + 1);
    native_mem_copy(result, s, len + 1);  
    out result;
end

func rt_substr:
    in(s: int, start: int, len: int)
    let slen = rt_strlen(s);
    if start >= slen:
        let empty = vir_alloc(1);
        native_write_u8(empty, 0, 0);
        out empty;
    end
    let actual = len;
    if start + actual > slen:
        actual = slen - start;
    end
    let result = vir_alloc(actual + 1);
    native_mem_copy(result, s + start, actual);
    native_write_u8(result, actual, 0);
    out result;
end

func rt_strcontains:
    in(haystack: int, needle: int)
    let hlen = rt_strlen(haystack);
    let nlen = rt_strlen(needle);
    if nlen == 0:
        out true;
    end
    if nlen > hlen:
        out false;
    end
    let i = 0;
    when i <= hlen - nlen loop
        let j = 0;
        let match = true;
        when j < nlen loop
            if native_read_u8(haystack, i + j) != native_read_u8(needle, j):
                match = false;
                out skip;
            end
            j = j + 1;
        end
        if match:
            out true;
        end
        i = i + 1;
    end
    out false;
end

func rt_str_from_cstr:
    in(cstr: int)
    out rt_strdup(cstr);
end

func rt_itoa:
    in(n: int)
    let buf = vir_alloc(24);   
    let pos = 0;
    let val = n;

    if val < 0:
        native_write_u8(buf, 0, 45);  
        pos = 1;
        val = 0 - val;
    end

    if val == 0:
        native_write_u8(buf, pos, 48);  
        pos = pos + 1;
        native_write_u8(buf, pos, 0);
        out buf;
    end

    let tmp = vir_alloc(24);
    let tlen = 0;
    when val > 0 loop
        let digit = val % 10;
        native_write_u8(tmp, tlen, 48 + digit);
        tlen = tlen + 1;
        val = val / 10;
    end

    let i = tlen - 1;
    when i >= 0 loop
        native_write_u8(buf, pos, native_read_u8(tmp, i));
        pos = pos + 1;
        i = i - 1;
    end
    native_write_u8(buf, pos, 0);
    vir_free(tmp);
    out buf;
end

func rt_atoi:
    in(s: int)
    let i = 0;
    let sign = 1;
    let result = 0;

    when native_read_u8(s, i) == 32 or native_read_u8(s, i) == 9 loop
        i = i + 1;
    end

    if native_read_u8(s, i) == 45:  
        sign = -1;
        i = i + 1;
    eif native_read_u8(s, i) == 43: 
        i = i + 1;
    end

    let ch = native_read_u8(s, i);
    when ch >= 48 and ch <= 57 loop
        result = result * 10 + (ch - 48);
        i = i + 1;
        ch = native_read_u8(s, i);
    end

    out result * sign;
end

func rt_itoa_hex:
    in(n: int, width: int)
    let hex_chars = "0123456789abcdef";
    let buf = vir_alloc(width + 3);
    native_write_u8(buf, 0, 48);   
    native_write_u8(buf, 1, 120);  
    let pos = 2;
    let i = width - 1;
    when i >= 0 loop
        let nibble = (n >> (i * 4)) & 0xF;
        native_write_u8(buf, pos, native_read_u8(hex_chars, nibble));
        pos = pos + 1;
        i = i - 1;
    end
    native_write_u8(buf, pos, 0);
    out buf;
end

entity StringBuilder:
    buf:     int;    
    len:     int;    
    cap:     int;    
end

func sb_new:
    let cap = 256;
    let buf = vir_alloc(cap);
    out StringBuilder ( buf: buf, len: 0, cap: cap );
end

func sb_grow:
    in(sb: StringBuilder, needed: int)
    if sb.len + needed <= sb.cap:
        out sb;
    end
    let new_cap = sb.cap * 2;
    when new_cap < sb.len + needed loop
        new_cap = new_cap * 2;
    end
    sb.buf = vir_realloc(sb.buf, new_cap);
    sb.cap = new_cap;
    out sb;
end

func sb_append:
    in(sb: StringBuilder, s: int)
    let slen = rt_strlen(s);
    sb = sb_grow(sb, slen);
    native_mem_copy(sb.buf + sb.len, s, slen);
    sb.len = sb.len + slen;
    out sb;
end

func sb_append_char:
    in(sb: StringBuilder, ch: int)
    sb = sb_grow(sb, 1);
    native_write_u8(sb.buf, sb.len, ch);
    sb.len = sb.len + 1;
    out sb;
end

func sb_append_int:
    in(sb: StringBuilder, n: int)
    let s = rt_itoa(n);
    sb = sb_append(sb, s);
    vir_free(s);
    out sb;
end

func sb_to_string:
    in(sb: StringBuilder)
    native_write_u8(sb.buf, sb.len, 0);
    out sb.buf;
end

func sb_len:
    in(sb: StringBuilder)
    out sb.len;
end

func sb_clear:
    in(sb: StringBuilder)
    sb.len = 0;
    out sb;
end

func sb_free:
    in(sb: StringBuilder)
    vir_free(sb.buf);
end

# -- END vir/rt/string_rt.vri --

# -- BEGIN vir/rt/io.vri --

    sys_fstat, STDIN_FD, STDOUT_FD, STDERR_FD,
    O_RDONLY, O_WRONLY, O_RDWR, O_CREAT, O_TRUNC, O_APPEND from syscall;
    sb_append_int, sb_to_string, sb_free, StringBuilder from string_rt;

func print_str:
    in(s: int)
    let len = rt_strlen(s);
    sys_write(STDOUT_FD, s, len);
end

func print_int:
    in(n: int)
    let s = rt_itoa(n);
    print_str(s);
    vir_free(s);
end

func print_ln:
    in(s: int)
    print_str(s);
    print_str("\n");
end

func print_newline:
    let nl = "\n";
    sys_write(STDOUT_FD, nl, 1);
end

func eprint_str:
    in(s: int)
    let len = rt_strlen(s);
    sys_write(STDERR_FD, s, len);
end

func eprint_ln:
    in(s: int)
    eprint_str(s);
    let nl = "\n";
    sys_write(STDERR_FD, nl, 1);
end

func read_line:
    let buf = vir_alloc(4096);
    let pos = 0;
    let byte_buf = vir_alloc(1);

    when true loop
        let n = sys_read(STDIN_FD, byte_buf, 1);
        if n <= 0:
            out skip;
        end

        extern func native_read_u8(addr: int, offset: int) -> int;
        extern func native_write_u8(addr: int, offset: int, val: int);

        let ch = native_read_u8(byte_buf, 0);
        if ch == 10:  
            out skip;
        end
        native_write_u8(buf, pos, ch);
        pos = pos + 1;

        if pos >= 4095:
            out skip;
        end
    end

    extern func native_write_u8(addr: int, offset: int, val: int);
    native_write_u8(buf, pos, 0);
    vir_free(byte_buf);
    out buf;
end

entity VirFile:
    fd:       int;
    is_open:  bool;
    mode:     int;    
end

const FILE_NONE = VirFile ( fd: -1, is_open: false, mode: 0 );

func file_open_read:
    in(path: int)
    let fd = sys_open(path, O_RDONLY, 0);
    if fd < 0:
        out FILE_NONE;
    end
    out VirFile ( fd: fd, is_open: true, mode: O_RDONLY );
end

func file_open_write:
    in(path: int, mode: int)
    let fd = sys_open(path, O_WRONLY | O_CREAT | O_TRUNC, mode);
    if fd < 0:
        out FILE_NONE;
    end
    out VirFile ( fd: fd, is_open: true, mode: O_WRONLY );
end

func file_open_append:
    in(path: int, mode: int)
    let fd = sys_open(path, O_WRONLY | O_CREAT | O_APPEND, mode);
    if fd < 0:
        out FILE_NONE;
    end
    out VirFile ( fd: fd, is_open: true, mode: O_WRONLY );
end

func file_close:
    in(f: VirFile)
    if f.is_open:
        sys_close(f.fd);
    end
end

func file_read_all:
    in(f: VirFile)
    if f.is_open == false:
        out 0;
    end

    let end_pos = sys_lseek(f.fd, 0, 2);   
    sys_lseek(f.fd, 0, 0);                  

    if end_pos <= 0:
        let empty = vir_alloc(1);
        extern func native_write_u8(addr: int, offset: int, val: int);
        native_write_u8(empty, 0, 0);
        out empty;
    end

    let buf = vir_alloc(end_pos + 1);
    let total = 0;
    when total < end_pos loop
        let n = sys_read(f.fd, buf + total, end_pos - total);
        if n <= 0:
            out skip;
        end
        total = total + n;
    end

    extern func native_write_u8(addr: int, offset: int, val: int);
    native_write_u8(buf, total, 0);   
    out buf;
end

func file_read_bytes:
    in(f: VirFile, buf: int, count: int)
    if f.is_open == false:
        out -1;
    end
    out sys_read(f.fd, buf, count);
end

func file_write_str:
    in(f: VirFile, s: int)
    if f.is_open == false:
        out -1;
    end
    let len = rt_strlen(s);
    out sys_write(f.fd, s, len);
end

func file_write_bytes:
    in(f: VirFile, data: int, len: int)
    if f.is_open == false:
        out -1;
    end
    let written = 0;
    when written < len loop
        let n = sys_write(f.fd, data + written, len - written);
        if n <= 0:
            out skip;
        end
        written = written + n;
    end
    out written;
end

func file_size:
    in(f: VirFile)
    let cur = sys_lseek(f.fd, 0, 1);     
    let end_pos = sys_lseek(f.fd, 0, 2); 
    sys_lseek(f.fd, cur, 0);             
    out end_pos;
end

func read_file_str:
    in(path: int)
    let f = file_open_read(path);
    if f.is_open == false:
        out 0;
    end
    let content = file_read_all(f);
    file_close(f);
    out content;
end

func write_file_str:
    in(path: int, content: int)
    let f = file_open_write(path, 0o644);
    if f.is_open == false:
        out false;
    end
    file_write_str(f, content);
    file_close(f);
    out true;
end

func write_file_bytes:
    in(path: int, data: int, len: int, mode: int)
    let f = file_open_write(path, mode);
    if f.is_open == false:
        out false;
    end
    file_write_bytes(f, data, len);
    sys_close(f.fd);
    out true;
end

# -- END vir/rt/io.vri --

# -- BEGIN vir/rt/vec_rt.vri --

extern func native_read_i64(addr: int, offset: int) -> int;
extern func native_write_i64(addr: int, offset: int, val: int);
extern func native_mem_copy(dst: int, src: int, len: int);

const VEC_INIT_CAP = 16;
const ELEM_SIZE = 8;         
const HEADER_SIZE = 16;      

func vec_new_rt:
    let base = vir_alloc(HEADER_SIZE + VEC_INIT_CAP * ELEM_SIZE);
    let data = base + HEADER_SIZE;
    native_write_i64(base, 0, VEC_INIT_CAP);  
    native_write_i64(base, 1, 0);              
    out data;
end

func vec_len_rt:
    in(v: int)
    if v == 0:
        out 0;
    end
    out native_read_i64(v - 8, 0);   
end

func vec_cap_rt:
    in(v: int)
    out native_read_i64(v - 16, 0);  
end

func vec_push_rt:
    in(v: int, val: int)
    let len = vec_len_rt(v);
    let cap = vec_cap_rt(v);

    if len >= cap:
        let new_cap = cap * 2;
        if new_cap < VEC_INIT_CAP:
            new_cap = VEC_INIT_CAP;
        end
        let base = v - HEADER_SIZE;
        let new_base = vir_realloc(base, HEADER_SIZE + new_cap * ELEM_SIZE);
        let new_data = new_base + HEADER_SIZE;
        native_write_i64(new_base, 0, new_cap);
        v = new_data;
    end

    native_write_i64(v, len, val);
    native_write_i64(v - 8, 0, len + 1);
    out v;
end

func vec_get_rt:
    in(v: int, index: int)
    if v == 0:
        out 0;
    end
    out native_read_i64(v, index);
end

func vec_set_rt:
    in(v: int, index: int, val: int)
    native_write_i64(v, index, val);
end

func vec_pop_rt:
    in(v: int)
    let len = vec_len_rt(v);
    if len == 0:
        out 0;
    end
    let val = vec_get_rt(v, len - 1);
    native_write_i64(v - 8, 0, len - 1);
    out val;
end

func vec_last_rt:
    in(v: int)
    let len = vec_len_rt(v);
    if len == 0:
        out 0;
    end
    out vec_get_rt(v, len - 1);
end

func vec_clear_rt:
    in(v: int)
    native_write_i64(v - 8, 0, 0);
end

func vec_free_rt:
    in(v: int)
    vir_free(v - HEADER_SIZE);
end

func vec_copy_rt:
    in(v: int)
    let len = vec_len_rt(v);
    let new_v = vec_new_rt();
    let i = 0;
    when i < len loop
        new_v = vec_push_rt(new_v, vec_get_rt(v, i));
        i = i + 1;
    end
    out new_v;
end

func vec_contains_rt:
    in(v: int, val: int)
    let len = vec_len_rt(v);
    let i = 0;
    when i < len loop
        if vec_get_rt(v, i) == val:
            out true;
        end
        i = i + 1;
    end
    out false;
end

func vec_index_of_rt:
    in(v: int, val: int)
    let len = vec_len_rt(v);
    let i = 0;
    when i < len loop
        if vec_get_rt(v, i) == val:
            out i;
        end
        i = i + 1;
    end
    out -1;
end

extern func native_read_u8(addr: int, offset: int) -> int;
extern func native_write_u8(addr: int, offset: int, val: int);

const BVEC_INIT_CAP = 4096;

func bvec_new:
    let base = vir_alloc(HEADER_SIZE + BVEC_INIT_CAP);
    let data = base + HEADER_SIZE;
    native_write_i64(base, 0, BVEC_INIT_CAP);
    native_write_i64(base, 1, 0);
    out data;
end

func bvec_len:
    in(v: int)
    out native_read_i64(v - 8, 0);
end

func bvec_push:
    in(v: int, byte: int)
    let len = bvec_len(v);
    let cap = native_read_i64(v - 16, 0);

    if len >= cap:
        let new_cap = cap * 2;
        let base = v - HEADER_SIZE;
        let new_base = vir_realloc(base, HEADER_SIZE + new_cap);
        let new_data = new_base + HEADER_SIZE;
        native_write_i64(new_base, 0, new_cap);
        v = new_data;
    end

    native_write_u8(v, len, byte & 0xFF);
    native_write_i64(v - 8, 0, len + 1);
    out v;
end

func bvec_push_u16_le:
    in(v: int, val: int)
    v = bvec_push(v, val & 0xFF);
    v = bvec_push(v, (val >> 8) & 0xFF);
    out v;
end

func bvec_push_u32_le:
    in(v: int, val: int)
    v = bvec_push(v, val & 0xFF);
    v = bvec_push(v, (val >> 8) & 0xFF);
    v = bvec_push(v, (val >> 16) & 0xFF);
    v = bvec_push(v, (val >> 24) & 0xFF);
    out v;
end

func bvec_push_u64_le:
    in(v: int, val: int)
    v = bvec_push_u32_le(v, val & 0xFFFFFFFF);
    v = bvec_push_u32_le(v, (val >> 32) & 0xFFFFFFFF);
    out v;
end

func bvec_get:
    in(v: int, index: int)
    out native_read_u8(v, index);
end

func bvec_set:
    in(v: int, index: int, byte: int)
    native_write_u8(v, index, byte & 0xFF);
end

func bvec_patch_u32_le:
    in(v: int, offset: int, val: int)
    native_write_u8(v, offset, val & 0xFF);
    native_write_u8(v, offset + 1, (val >> 8) & 0xFF);
    native_write_u8(v, offset + 2, (val >> 16) & 0xFF);
    native_write_u8(v, offset + 3, (val >> 24) & 0xFF);
end

func bvec_data_ptr:
    in(v: int)
    out v;  
end

func bvec_free:
    in(v: int)
    vir_free(v - HEADER_SIZE);
end

# -- END vir/rt/vec_rt.vri --

# -- BEGIN vir/rt/start.vri --

var g_argc = 0;
var g_argv = 0;    

func rt_argc:
    out g_argc;
end

func rt_argv:
    in(index: int)
    if index < 0 or index >= g_argc:
        out 0;
    end
    extern func native_read_i64(addr: int, offset: int) -> int;
    out native_read_i64(g_argv, index * 8);
end

extern func vir_main() -> int;

func _vir_start:
    in(argc: int, argv: int)

    g_argc = argc;
    g_argv = argv;

    heap_init(MIN_ARENA_SIZE * 4);

    let exit_code = vir_main();

    sys_exit(exit_code);
end


# -- END vir/rt/start.vri --

# -- BEGIN vir/str/string.vri --

entity String:
    data: ptr      
    byte_len: int  
    char_len: int  
end

func str_new:
    in(literal:string)
    blen = native_str_byte_len(literal);
    p = alloc(blen);
    mem_copy(p, native_str_ptr(literal), blen);
    out string ( data: p, byte_len: blen, char_len: utf8_count_chars(p, blen) );
end

func str_empty:
    out string ( data: null, byte_len: 0, char_len: 0 );
end

func str_from_bytes:
    in(data:ptr; len:int)
    p = alloc(len);
    mem_copy(p, data, len);
    out string ( data: p, byte_len: len, char_len: utf8_count_chars(p, len) );
end

func str_len:
    in(s:string)
    out s.char_len;
end

func str_byte_len:
    in(s:string)
    out s.byte_len;
end

func str_is_empty:
    in(s:string)
    out s.byte_len == 0;
end

func str_char_at:
    in(s:string; index:int)
    if index >= s.char_len:
        panic("str_char_at: index out of bounds");
    end
    out utf8_char_at(s.data, s.byte_len, index);
end

func str_byte_at:
    in(s:string; index:int)
    if index >= s.byte_len:
        panic("str_byte_at: index out of bounds");
    end
    out native_read_u8(s.data, index);
end

func str_eq:
    in(a:string; b:string)
    if a.byte_len != b.byte_len out false end:
    out mem_cmp(a.data, b.data, a.byte_len) == 0;
end

func str_cmp:
    in(a:string; b:string)
    min_len = if a.byte_len < b.byte_len a.byte_len else b.byte_len end;
    r = mem_cmp(a.data, b.data, min_len);
    if r != 0 out r end:
    if a.byte_len < b.byte_len out -1 end:
    if a.byte_len > b.byte_len out 1 end:
    out 0;
end

func str_slice:
    in(s:string; from:int; to:int)
    if from > to or to > s.char_len:
        panic("str_slice: invalid range");
    end
    byte_start = utf8_offset_of(s.data, s.byte_len, from);
    byte_end = utf8_offset_of(s.data, s.byte_len, to);
    out str_from_bytes(s.data + byte_start, byte_end - byte_start);
end

func str_slice_bytes:
    in(s:string; from:int; to:int)
    if from > to or to > s.byte_len:
        panic("str_slice_bytes: invalid range");
    end
    out str_from_bytes(s.data + from, to - from);
end

func str_concat:
    in(a:string; b:string)
    total = a.byte_len + b.byte_len;
    p = alloc(total);
    mem_copy(p, a.data, a.byte_len);
    mem_copy(p + a.byte_len, b.data, b.byte_len);
    out string ( data: p, byte_len: total, char_len: a.char_len + b.char_len );
end

func str_contains:
    in(haystack:string; needle:string)
    out is_some(str_find(haystack, needle));
end

func str_find:
    in(haystack:string; needle:string)
    n = haystack.byte_len;
    m = needle.byte_len;
    if m == 0 out Some(0) end:
    if m > n out None end:
    if m == 1:
        b = native_read_u8(needle.data, 0);
        i = 0;
        when i < n loop
            if native_read_u8(haystack.data, i) == b:
                out Some(i);
            end
            i = i + 1;
        end
        out None;
    end

    ms = _two_way_maxsuf(needle.data, m, false);
    ms2 = _two_way_maxsuf(needle.data, m, true);
    if ms > ms2: period_pos = ms; else: period_pos = ms2; end

    period = period_pos + 1; 
    memory = 0;
    i = 0;
    when i <= n - m loop
        j = if memory > period_pos: memory; else: period_pos; end;
        found_right = true;
        when j < m loop
            if native_read_u8(haystack.data, i + j) != native_read_u8(needle.data, j):
                i = i + (j - period_pos);
                memory = 0;
                found_right = false;
                tho_t;
            end
            j = j + 1;
        end
        if found_right:
            j = period_pos;
            matched = true;
            when j > memory loop
                j = j - 1;
                if native_read_u8(haystack.data, i + j) != native_read_u8(needle.data, j):
                    i = i + period;
                    memory = m - period;
                    matched = false;
                    tho_t;
                end
            end
            if matched:
                out Some(i);
            end
        end
    end
    out None;
end

func _two_way_maxsuf:
    in(pat:ptr; m:int; reversed:bool)
    ms = -1;
    j = 0;
    p = 1;
    k = 1;
    when j + k < m loop
        a = native_read_u8(pat, j + k);
        b = native_read_u8(pat, ms + k);
        if reversed: tmp = a; a = b; b = tmp; end
        if a < b:
            j = j + k;
            k = 1;
            p = j - ms;
        eif a == b:
            if k == p:
                j = j + p;
                k = 1;
            else
                k = k + 1;
            end
        else
            ms = j;
            j = ms + 1;
            k = 1;
            p = 1;
        end
    end
    out ms;
end

func str_starts_with:
    in(s:string; prefix:string)
    if prefix.byte_len > s.byte_len out false end:
    out mem_cmp(s.data, prefix.data, prefix.byte_len) == 0;
end

func str_ends_with:
    in(s:string; suffix:string)
    if suffix.byte_len > s.byte_len out false end:
    offset = s.byte_len - suffix.byte_len;
    out mem_cmp(s.data + offset, suffix.data, suffix.byte_len) == 0;
end

func str_to_upper:
    in(s:string)
    p = alloc(s.byte_len);
    mem_copy(p, s.data, s.byte_len);
    v_i m_i i in 0..s.byte_len;
        b = native_read_u8(p, i);
        if b >= 0x61 and b <= 0x7A:
            native_write_u8(p, i, b - 32);
        end
    end
    out string ( data: p, byte_len: s.byte_len, char_len: s.char_len );
end

func str_to_lower:
    in(s:string)
    p = alloc(s.byte_len);
    mem_copy(p, s.data, s.byte_len);
    v_i m_i i in 0..s.byte_len;
        b = native_read_u8(p, i);
        if b >= 0x41 and b <= 0x5A:
            native_write_u8(p, i, b + 32);
        end
    end
    out string ( data: p, byte_len: s.byte_len, char_len: s.char_len );
end

func str_trim:
    in(s:string)
    start = 0;
    when start < s.byte_len and is_ascii_whitespace(native_read_u8(s.data, start)) loop
        start = start + 1;
    end
    end = s.byte_len;
    when end > start and is_ascii_whitespace(native_read_u8(s.data, end - 1)) loop
        end = end - 1;
    end
    out str_slice_bytes(s, start, end);
end

func str_trim_start:
    in(s:string)
    start = 0;
    when start < s.byte_len and is_ascii_whitespace(native_read_u8(s.data, start)) loop
        start = start + 1;
    end
    out str_slice_bytes(s, start, s.byte_len);
end

func str_trim_end:
    in(s:string)
    end = s.byte_len;
    when end > 0 and is_ascii_whitespace(native_read_u8(s.data, end - 1)) loop
        end = end - 1;
    end
    out str_slice_bytes(s, 0, end);
end

func str_replace:
    in(s:string; old:string; new:string)
    out native_str_replace(s, old, new);
end

func str_repeat:
    in(s:string; count:int)
    total = s.byte_len * count;
    p = alloc(total);
    v_i m_i i in 0..count;
        mem_copy(p + i * s.byte_len, s.data, s.byte_len);
    end
    out string ( data: p, byte_len: total, char_len: s.char_len * count );
end

func str_split:
    in(s:string; delim:string)
    out native_str_split(s, delim);
end

func str_join:
    in(parts:Vec<string>; sep:string)
    out native_str_join(parts, sep);
end

func str_to_i64:
    in(s:string)
    out parse_int(s);
end

func str_to_f64:
    in(s:string)
    out parse_float(s);
end

func i64_to_str:
    in(n:int)
    out native_i64_to_str(n);
end

func f64_to_str:
    in(f:float)
    out native_f64_to_str(f);
end

func str_free:
    in(s:string)
    free(s.data);
end

func is_ascii_whitespace:
    in(b:int)
    out b == 0x20 or b == 0x09 or b == 0x0A or b == 0x0D;
end

func utf8_count_chars:
    in(data:ptr; byte_len:int)
    count = 0;
    i = 0;
    when i < byte_len loop
        b = native_read_u8(data, i);
        if (b & 0x80) == 0:
            i = i + 1          
        eif (b & 0xE0) == 0xC0:
            i = i + 2          
        eif (b & 0xF0) == 0xE0:
            i = i + 3          
        eif (b & 0xF8) == 0xF0:
            i = i + 4          
        else
            i = i + 1          
        end
        count = count + 1;
    end
    out count;
end

func utf8_char_at:
    in(data:ptr; byte_len:int; char_index:int)
    count = 0;
    i = 0;
    when i < byte_len loop
        b = native_read_u8(data, i);
        if count == char_index:
            out utf8_decode_char(data, i, byte_len);
        end
        if (b & 0x80) == 0 i = i + 1:
        eif (b & 0xE0) == 0xC0 i = i + 2:
        eif (b & 0xF0) == 0xE0 i = i + 3:
        eif (b & 0xF8) == 0xF0 i = i + 4:
        else i = i + 1;
        end
        count = count + 1;
    end
    panic("utf8_char_at: index out of bounds");
end

func utf8_offset_of:
    in(data:ptr; byte_len:int; char_index:int)
    count = 0;
    i = 0;
    when i < byte_len and count < char_index loop
        b = native_read_u8(data, i);
        if (b & 0x80) == 0 i = i + 1:
        eif (b & 0xE0) == 0xC0 i = i + 2:
        eif (b & 0xF0) == 0xE0 i = i + 3:
        eif (b & 0xF8) == 0xF0 i = i + 4:
        else i = i + 1;
        end
        count = count + 1;
    end
    out i;
end

# -- END vir/str/string.vri --

# -- BEGIN vir/compiler/option.vri --

enum Option:
    Some(value)    
    None             
end

func is_some:
    in(opt:Option)
    case opt;
        case Some(_) out true
        case None out false
    end
end

func is_none:
    in(opt:Option)
    out not is_some(opt);
end

func unwrap:
    in(opt:Option)
    case opt;
        case Some(v) out v
        case None panic("unwrap() called on None")
    end
end

func unwrap_or:
    in(opt:Option; default)
    case opt;
        case Some(v) out v
        case None out default
    end
end

func unwrap_or_else:
    in(opt:Option; f:func)
    case opt;
        case Some(v) out v
        case None out f()
    end
end

func expect:
    in(opt:Option; msg:string)
    case opt;
        case Some(v) out v
        case None panic(msg)
    end
end

func map:
    in(opt:Option; f:func)
    case opt;
        case Some(v) out Some(f(v))
        case None out None
    end
end

func flat_map:
    in(opt:Option; f:func)
    case opt;
        case Some(v) out f(v)
        case None out None
    end
end

func filter:
    in(opt:Option; predicate:func)
    case opt;
        case Some(v)
            if predicate(v):
                out Some(v);
            else
                out None;
            end
        case None out None
    end
end

func or_else:
    in(opt:Option; alternative:Option)
    case opt;
        case Some(_) out opt
        case None out alternative
    end
end

func zip:
    in(a:Option; b:Option)
    if is_some(a) and is_some(b):
        out Some((unwrap(a), unwrap(b)));
    end
    out None;
end

func option_to_result:
    in(opt:Option; err:string)
    case opt
        Some(v): out Ok(v)
        None: out Err(err)
    end
end

# -- END vir/compiler/option.vri --

# -- BEGIN vir/compiler/result.vri --

enum Result:
    Ok(value)      
    Err(error)         
end

func is_ok:
    in(r:Result)
    case r
        Ok(_): out true
        Err(_): out false
    end
end

func is_err:
    in(r:Result)
    out not is_ok(r);
end

func unwrap:
    in(r:Result)
    case r
        Ok(v): out v
        Err(e): panic("unwrap() called on Err: " + to_string(e))
    end
end

func unwrap_err:
    in(r:Result)
    case r
        Ok(_): panic("unwrap_err() called on Ok")
        Err(e): out e
    end
end

func unwrap_or:
    in(r:Result; default:int)
    case r
        Ok(v): out v
        Err(_): out default
    end
end

func unwrap_or_else:
    in(r:Result; f:func)
    case r;
        case Ok(v) out v
        case Err(e) out f(e)
    end
end

func expect:
    in(r:Result; msg:string)
    case r;
        case Ok(v) out v
        case Err(_) panic(msg)
    end
end

func map:
    in(r:Result; f:func)
    case r;
        case Ok(v) out Ok(f(v))
        case Err(e) out Err(e)
    end
end

func map_err:
    in(r:Result; f:func)
    case r;
        case Ok(v) out Ok(v)
        case Err(e) out Err(f(e))
    end
end

func flat_map:
    in(r:Result; f:func)
    case r;
        case Ok(v) out f(v)
        case Err(e) out Err(e)
    end
end

func and_then:
    in(r:Result; f:func)
    out flat_map(r, f);
end

func or_else:
    in(r:Result; f:func)
    case r;
        case Ok(v) out Ok(v)
        case Err(e) out f(e)
    end
end

func result_to_option:
    in(r:Result)
    case r;
        case Ok(v) out Some(v)
        case Err(_) out None
    end
end

func ok:
    in(r:Result)
    out result_to_option(r);
end

func err:
    in(r:Result)
    case r;
        case Ok(_) out None
        case Err(e) out Some(e)
    end
end

func try_all:
    in(results:Vec<Result>)
    values = vec_new();
    for each r in results;
        case r;
            case Ok(v) vec_push(values, v)
            case Err(e) out Err(e)
        end
    end
    out Ok(values);
end

# -- END vir/compiler/result.vri --

# -- BEGIN vir/mem/copy.vri --

func mem_copy:
    in(dst:ptr; src:ptr; n:int)
    native_memcpy(dst, src, n);
end

func mem_move:
    in(dst:ptr; src:ptr; n:int)
    native_memmove(dst, src, n);
end

func mem_set:
    in(dst:ptr; val:int; n:int)
    native_memset(dst, val, n);
end

func mem_zero:
    in(dst:ptr; n:int)
    mem_set(dst, 0, n);
end

func mem_cmp:
    in(a:ptr; b:ptr; n:int)
    out native_memcmp(a, b, n);
end

func mem_eq:
    in(a:ptr; b:ptr; n:int)
    out mem_cmp(a, b, n) == 0;
end

# -- END vir/mem/copy.vri --

# -- BEGIN vir/rt/macho.vri --

    bvec_len, bvec_get, bvec_set, bvec_patch_u32_le, bvec_data_ptr, bvec_free from vec_rt;

const MH_MAGIC_64:      0xFEEDFACF;

const CPU_TYPE_X86_64:  0x01000007;
const CPU_TYPE_ARM64:   0x0100000C;
const CPU_SUB_ALL:      0x00000000;
const CPU_SUB_ARM64_ALL: 0x00000000;

const MH_EXECUTE:       2;

const MH_NOUNDEFS:      0x00000001;
const MH_DYLDLINK:      0x00000004;
const MH_TWOLEVEL:      0x00000080;
const MH_PIE:           0x00200000;

const LC_SEGMENT_64:    0x19;
const LC_MAIN:          0x80000028;
const LC_SYMTAB:        0x02;
const LC_DYSYMTAB:      0x0B;
const LC_UUID:          0x1B;
const LC_BUILD_VERSION: 0x32;
const LC_SOURCE_VERSION: 0x2A;
const LC_LOAD_DYLIB:    0x0C;
const LC_LOAD_DYLINKER: 0x0E;
const LC_DYLD_INFO_ONLY: 0x80000022;
const LC_DYLD_CHAINED_FIXUPS: 0x80000034;

const VM_PROT_READ:     1;
const VM_PROT_WRITE:    2;
const VM_PROT_EXECUTE:  4;

const S_ATTR_PURE_INSTRUCTIONS: 0x80000000;
const S_ATTR_SOME_INSTRUCTIONS: 0x00000400;
const S_REGULAR:        0x00000000;
const S_ZEROFILL:       0x00000001;

const PAGE_SIZE_ARM64:  0x4000;    
const PAGE_SIZE_X86:    0x1000;    
const TEXT_BASE:        0x100000000;

entity MachOBuilder:
    buf:            int;       
    arch:           int;       
    page_size:      int;
    text_code:      int;       
    data_bytes:     int;       
    entry_offset:   int;       
end

func macho_new:
    in(arch: int)
    let page = PAGE_SIZE_ARM64;
    if arch == 1:
        page = PAGE_SIZE_X86;
    end
    out MachOBuilder (
        buf: bvec_new(),
        arch: arch,
        page_size: page,
        text_code: bvec_new(),
        data_bytes: bvec_new(),
        entry_offset: 0
    );
end

func macho_write_header:
    in(b: MachOBuilder, ncmds: int, sizeofcmds: int)
    let buf = b.buf;

    buf = bvec_push_u32_le(buf, MH_MAGIC_64);

    if b.arch == 0:
        buf = bvec_push_u32_le(buf, CPU_TYPE_ARM64);
        buf = bvec_push_u32_le(buf, CPU_SUB_ARM64_ALL);
    else
        buf = bvec_push_u32_le(buf, CPU_TYPE_X86_64);
        buf = bvec_push_u32_le(buf, CPU_SUB_ALL);
    end

    buf = bvec_push_u32_le(buf, MH_EXECUTE);

    buf = bvec_push_u32_le(buf, ncmds);

    buf = bvec_push_u32_le(buf, sizeofcmds);

    buf = bvec_push_u32_le(buf, MH_PIE | MH_NOUNDEFS | MH_DYLDLINK | MH_TWOLEVEL);

    buf = bvec_push_u32_le(buf, 0);

    b.buf = buf;
    out b;
end

func macho_write_segment:
    in(b: MachOBuilder, name: int, vmaddr: int, vmsize: int,
       fileoff: int, filesize: int, maxprot: int, initprot: int,
       nsects: int)
    let buf = b.buf;

    buf = bvec_push_u32_le(buf, LC_SEGMENT_64);

    let cmdsize = 72 + 80 * nsects;
    buf = bvec_push_u32_le(buf, cmdsize);

    let name_len = rt_strlen(name);
    let i = 0;
    extern func native_read_u8(addr: int, offset: int) -> int;
    when i < 16 loop
        if i < name_len:
            buf = bvec_push(buf, native_read_u8(name, i));
        else
            buf = bvec_push(buf, 0);
        end
        i = i + 1;
    end

    buf = bvec_push_u64_le(buf, vmaddr);
    buf = bvec_push_u64_le(buf, vmsize);

    buf = bvec_push_u64_le(buf, fileoff);
    buf = bvec_push_u64_le(buf, filesize);

    buf = bvec_push_u32_le(buf, maxprot);
    buf = bvec_push_u32_le(buf, initprot);

    buf = bvec_push_u32_le(buf, nsects);
    buf = bvec_push_u32_le(buf, 0);

    b.buf = buf;
    out b;
end

func macho_write_section:
    in(b: MachOBuilder, sectname: int, segname: int,
       addr: int, size: int, offset: int, align: int,
       flags: int)
    let buf = b.buf;

    extern func native_read_u8(addr: int, offset: int) -> int;

    let sn_len = rt_strlen(sectname);
    let i = 0;
    when i < 16 loop
        if i < sn_len:
            buf = bvec_push(buf, native_read_u8(sectname, i));
        else
            buf = bvec_push(buf, 0);
        end
        i = i + 1;
    end

    let sg_len = rt_strlen(segname);
    i = 0;
    when i < 16 loop
        if i < sg_len:
            buf = bvec_push(buf, native_read_u8(segname, i));
        else
            buf = bvec_push(buf, 0);
        end
        i = i + 1;
    end

    buf = bvec_push_u64_le(buf, addr);
    buf = bvec_push_u64_le(buf, size);

    buf = bvec_push_u32_le(buf, offset);
    buf = bvec_push_u32_le(buf, align);

    buf = bvec_push_u32_le(buf, 0);
    buf = bvec_push_u32_le(buf, 0);

    buf = bvec_push_u32_le(buf, flags);
    buf = bvec_push_u32_le(buf, 0);
    buf = bvec_push_u32_le(buf, 0);
    buf = bvec_push_u32_le(buf, 0);

    b.buf = buf;
    out b;
end

func macho_write_lc_main:
    in(b: MachOBuilder, entryoff: int)
    let buf = b.buf;

    buf = bvec_push_u32_le(buf, LC_MAIN);
    buf = bvec_push_u32_le(buf, 24);          
    buf = bvec_push_u64_le(buf, entryoff);     
    buf = bvec_push_u64_le(buf, 0);            

    b.buf = buf;
    out b;
end

func macho_emit:
    in(b: MachOBuilder, entry_off_param: int)

    let page = b.page_size;
    let code_size = bvec_len(b.text_code);

    let ncmds = 10;
    let sizeofcmds = 552;
    let header_end = 32 + sizeofcmds;

    let code_offset = header_end + 32;

    let entry_file_offset = code_offset + entry_off_param;

    let text_raw_size = code_offset + code_size;
    let text_segment_size = ((text_raw_size + page - 1) / page) * page;

    let chained_fixups_size = 48;
    let string_table_size = 4;
    let linkedit_data_size = chained_fixups_size + string_table_size;
    let linkedit_fileoff = text_segment_size;
    let linkedit_vmaddr = TEXT_BASE + text_segment_size;
    let strtab_off = linkedit_fileoff + chained_fixups_size;

    b = macho_write_header(b, ncmds, sizeofcmds);

    b = macho_write_segment(b, "__PAGEZERO", 0, TEXT_BASE, 0, 0, 0, 0, 0);

    b = macho_write_segment(b, "__TEXT",
                            TEXT_BASE, text_segment_size,
                            0, text_segment_size,
                            VM_PROT_READ | VM_PROT_WRITE | VM_PROT_EXECUTE,
                            VM_PROT_READ | VM_PROT_EXECUTE,
                            1);
    b = macho_write_section(b, "__text", "__TEXT",
                            TEXT_BASE + code_offset, code_size, code_offset,
                            2,
                            S_ATTR_PURE_INSTRUCTIONS | S_ATTR_SOME_INSTRUCTIONS);

    b = macho_write_segment(b, "__LINKEDIT",
                            linkedit_vmaddr, page,
                            linkedit_fileoff, linkedit_data_size,
                            VM_PROT_READ,
                            VM_PROT_READ,
                            0);

    b.buf = bvec_push_u32_le(b.buf, LC_DYLD_CHAINED_FIXUPS);
    b.buf = bvec_push_u32_le(b.buf, 16);
    b.buf = bvec_push_u32_le(b.buf, linkedit_fileoff);
    b.buf = bvec_push_u32_le(b.buf, chained_fixups_size);

    b.buf = bvec_push_u32_le(b.buf, LC_SYMTAB);
    b.buf = bvec_push_u32_le(b.buf, 24);
    b.buf = bvec_push_u32_le(b.buf, strtab_off);
    b.buf = bvec_push_u32_le(b.buf, 0);
    b.buf = bvec_push_u32_le(b.buf, strtab_off);
    b.buf = bvec_push_u32_le(b.buf, string_table_size);

    b.buf = bvec_push_u32_le(b.buf, LC_DYSYMTAB);
    b.buf = bvec_push_u32_le(b.buf, 80);
    let dsi = 0;
    when dsi < 18 loop
        b.buf = bvec_push_u32_le(b.buf, 0);
        dsi = dsi + 1;
    end

    b.buf = bvec_push_u32_le(b.buf, LC_LOAD_DYLINKER);
    b.buf = bvec_push_u32_le(b.buf, 32);
    b.buf = bvec_push_u32_le(b.buf, 12);
    extern func native_read_u8(addr: int, offset: int) -> int;
    let dyld_path = "/usr/lib/dyld";
    let dyld_len = 13;
    let di = 0;
    when di < 20 loop
        if di < dyld_len:
            b.buf = bvec_push(b.buf, native_read_u8(dyld_path, di));
        else
            b.buf = bvec_push(b.buf, 0);
        end
        di = di + 1;
    end

    b.buf = bvec_push_u32_le(b.buf, LC_UUID);
    b.buf = bvec_push_u32_le(b.buf, 24);
    let ui = 1;
    when ui <= 16 loop
        b.buf = bvec_push(b.buf, ui);
        ui = ui + 1;
    end

    b = macho_write_lc_main(b, entry_file_offset);

    b.buf = bvec_push_u32_le(b.buf, LC_LOAD_DYLIB);
    b.buf = bvec_push_u32_le(b.buf, 56);
    b.buf = bvec_push_u32_le(b.buf, 24);
    b.buf = bvec_push_u32_le(b.buf, 0);
    b.buf = bvec_push_u32_le(b.buf, 0x00010000);
    b.buf = bvec_push_u32_le(b.buf, 0x00010000);
    let dylib_path = "/usr/lib/libSystem.B.dylib";
    let dylib_len = 26;
    let dli = 0;
    when dli < 32 loop
        if dli < dylib_len:
            b.buf = bvec_push(b.buf, native_read_u8(dylib_path, dli));
        else
            b.buf = bvec_push(b.buf, 0);
        end
        dli = dli + 1;
    end

    let current = bvec_len(b.buf);
    when current < code_offset loop
        b.buf = bvec_push(b.buf, 0);
        current = current + 1;
    end

    let i = 0;
    when i < code_size loop
        b.buf = bvec_push(b.buf, bvec_get(b.text_code, i));
        i = i + 1;
    end

    current = bvec_len(b.buf);
    when current < text_segment_size loop
        b.buf = bvec_push(b.buf, 0);
        current = current + 1;
    end

    b.buf = bvec_push_u32_le(b.buf, 0);    
    b.buf = bvec_push_u32_le(b.buf, 28);   
    b.buf = bvec_push_u32_le(b.buf, 44);   
    b.buf = bvec_push_u32_le(b.buf, 44);   
    b.buf = bvec_push_u32_le(b.buf, 0);    
    b.buf = bvec_push_u32_le(b.buf, 1);    
    b.buf = bvec_push_u32_le(b.buf, 0);    

    b.buf = bvec_push_u32_le(b.buf, 3);    
    b.buf = bvec_push_u32_le(b.buf, 0);    
    b.buf = bvec_push_u32_le(b.buf, 0);    
    b.buf = bvec_push_u32_le(b.buf, 0);    

    b.buf = bvec_push_u32_le(b.buf, 0);

    b.buf = bvec_push_u32_le(b.buf, 0);

    out b;
end

func macho_write_to_file:
    in(b: MachOBuilder, path: int)
    let eo = b.entry_offset;
    b = macho_emit(b, eo);
    let data = bvec_data_ptr(b.buf);
    let size = bvec_len(b.buf);
    write_file_bytes(path, data, size, 0o755);
    out true;
end
# -- END vir/rt/macho.vri --

# -- BEGIN vir/compiler/lexer.vri --

extern func rt_strlen(s: int) -> int;
extern func rt_streq(a: int; b: int) -> int;

enum TokType:
    Eof         = 0;
    Error       = 1;
    Int         = 2;
    Float       = 3;
    Str         = 4;
    Ident       = 5;
    Newline     = 6;

    Func        = 10;
    Var         = 11;
    Const       = 12;
    Entity      = 13;
    Enum        = 14;
    Method      = 15;
    Class       = 16;
    Has         = 17;
    Share       = 18;
    Async       = 19;
    Task        = 20;
    Wait        = 21;
    Extern      = 22;

    If          = 30;
    Else        = 31;
    Eif         = 32;
    Loop        = 33;
    While       = 34;
    When        = 35;
    For         = 36;
    Break       = 37;
    Skip        = 38;
    Out         = 39;
    Case        = 40;
    End         = 41;
    In          = 42;

    Plus        = 50;
    Minus       = 51;
    Star        = 52;
    Slash       = 53;
    Percent     = 54;
    Power       = 55;
    Mod         = 56;

    Eq          = 60;
    Ne          = 61;
    Gt          = 62;
    Lt          = 63;
    Ge          = 64;
    Le          = 65;
    SafeEq      = 66;
    SafeNe      = 67;

    And         = 70;
    Or          = 71;
    Not         = 72;

    BitXor      = 75;
    BitShl      = 76;
    BitShr      = 77;
    BitAnd      = 78;
    BitOr       = 79;
    BitNot      = 80;

    SafeAccess  = 85;
    Exist       = 86;
    Cast        = 87;
    Pattern     = 88;

    Assign      = 90;

    LParen      = 100;
    RParen      = 101;
    LBracket    = 102;
    RBracket    = 103;
    LBrace      = 104;
    RBrace      = 105;
    Comma       = 106;
    Dot         = 107;
    DotDot      = 108;
    Colon       = 109;
    Semicolon   = 110;
    Arrow       = 111;
    DoubleColon = 112;
    Let         = 113;

    Print       = 120;
    Input       = 121;
    CheckCpu    = 122;
    Patch       = 123;

    Import      = 130;
    From        = 131;
    Module      = 132;
    Export      = 133;
    As          = 134;
    Include     = 135;
    Get         = 136;

    True        = 140;
    False       = 141;
    NoneLit     = 142;

    Try         = 150;
    ErrorKw     = 151;
    MapKw       = 152;
end

entity Token:
    tok_type:   TokType;
    line:       int;
    col:        int;
    str_val:    string;
    tok_ival:   int;
    tok_fval:   float;
end

func token_new:
    in(t:TokType; line:int; col:int)
    out Token (;
        tok_type: t,;
        line: line,;
        col: col,;
        str_val: "",;
        tok_ival: 0,;
        tok_fval: 0
    );
end

entity KeywordEntry:
    word:   string;
    tok:    TokType;
end

func build_keyword_table:
    table = vec_new_rt();

    table = vec_push_rt(table, KeywordEntry ( word: "func", tok: TokType::Func ));
    table = vec_push_rt(table, KeywordEntry ( word: "function", tok: TokType::Func ));
    table = vec_push_rt(table, KeywordEntry ( word: "var", tok: TokType::Var ));
    table = vec_push_rt(table, KeywordEntry ( word: "let", tok: TokType::Var ));
    table = vec_push_rt(table, KeywordEntry ( word: "const", tok: TokType::Const ));
    table = vec_push_rt(table, KeywordEntry ( word: "entity", tok: TokType::Entity ));
    table = vec_push_rt(table, KeywordEntry ( word: "enum", tok: TokType::Enum ));
    table = vec_push_rt(table, KeywordEntry ( word: "method", tok: TokType::Method ));
    table = vec_push_rt(table, KeywordEntry ( word: "class", tok: TokType::Class ));
    table = vec_push_rt(table, KeywordEntry ( word: "has", tok: TokType::Has ));
    table = vec_push_rt(table, KeywordEntry ( word: "share", tok: TokType::Share ));
    table = vec_push_rt(table, KeywordEntry ( word: "async", tok: TokType::Async ));
    table = vec_push_rt(table, KeywordEntry ( word: "task", tok: TokType::Task ));
    table = vec_push_rt(table, KeywordEntry ( word: "wait", tok: TokType::Wait ));
    table = vec_push_rt(table, KeywordEntry ( word: "extern", tok: TokType::Extern ));

    table = vec_push_rt(table, KeywordEntry ( word: "if", tok: TokType::If ));
    table = vec_push_rt(table, KeywordEntry ( word: "else", tok: TokType::Else ));
    table = vec_push_rt(table, KeywordEntry ( word: "eif", tok: TokType::Eif ));
    table = vec_push_rt(table, KeywordEntry ( word: "loop", tok: TokType::Loop ));
    table = vec_push_rt(table, KeywordEntry ( word: "while", tok: TokType::While ));
    table = vec_push_rt(table, KeywordEntry ( word: "when", tok: TokType::When ));
    table = vec_push_rt(table, KeywordEntry ( word: "for", tok: TokType::For ));
    table = vec_push_rt(table, KeywordEntry ( word: "break", tok: TokType::Break ));
    table = vec_push_rt(table, KeywordEntry ( word: "skip", tok: TokType::Skip ));
    table = vec_push_rt(table, KeywordEntry ( word: "continue", tok: TokType::Skip ));
    table = vec_push_rt(table, KeywordEntry ( word: "out", tok: TokType::Out ));
    table = vec_push_rt(table, KeywordEntry ( word: "return", tok: TokType::Out ));
    table = vec_push_rt(table, KeywordEntry ( word: "case", tok: TokType::Case ));
    table = vec_push_rt(table, KeywordEntry ( word: "end", tok: TokType::End ));
    table = vec_push_rt(table, KeywordEntry ( word: "in", tok: TokType::In ));

    table = vec_push_rt(table, KeywordEntry ( word: "print", tok: TokType::Print ));
    table = vec_push_rt(table, KeywordEntry ( word: "input", tok: TokType::Input ));
    table = vec_push_rt(table, KeywordEntry ( word: "check_cpu", tok: TokType::CheckCpu ));
    table = vec_push_rt(table, KeywordEntry ( word: "patch", tok: TokType::Patch ));

    table = vec_push_rt(table, KeywordEntry ( word: "true", tok: TokType::True ));
    table = vec_push_rt(table, KeywordEntry ( word: "false", tok: TokType::False ));
    table = vec_push_rt(table, KeywordEntry ( word: "none", tok: TokType::NoneLit ));

    table = vec_push_rt(table, KeywordEntry ( word: "and", tok: TokType::And ));
    table = vec_push_rt(table, KeywordEntry ( word: "or", tok: TokType::Or ));
    table = vec_push_rt(table, KeywordEntry ( word: "not", tok: TokType::Not ));

    table = vec_push_rt(table, KeywordEntry ( word: "xor", tok: TokType::BitXor ));
    table = vec_push_rt(table, KeywordEntry ( word: "shl", tok: TokType::BitShl ));
    table = vec_push_rt(table, KeywordEntry ( word: "shr", tok: TokType::BitShr ));
    table = vec_push_rt(table, KeywordEntry ( word: "mod", tok: TokType::Mod ));

    table = vec_push_rt(table, KeywordEntry ( word: "import", tok: TokType::Import ));
    table = vec_push_rt(table, KeywordEntry ( word: "from", tok: TokType::From ));
    table = vec_push_rt(table, KeywordEntry ( word: "module", tok: TokType::Module ));
    table = vec_push_rt(table, KeywordEntry ( word: "export", tok: TokType::Export ));
    table = vec_push_rt(table, KeywordEntry ( word: "as", tok: TokType::As ));
    table = vec_push_rt(table, KeywordEntry ( word: "include", tok: TokType::Include ));
    table = vec_push_rt(table, KeywordEntry ( word: "get", tok: TokType::Get ));

    table = vec_push_rt(table, KeywordEntry ( word: "try", tok: TokType::Try ));
    table = vec_push_rt(table, KeywordEntry ( word: "error", tok: TokType::ErrorKw ));
    table = vec_push_rt(table, KeywordEntry ( word: "map", tok: TokType::MapKw ));

    table = vec_push_rt(table, KeywordEntry ( word: "struct", tok: TokType::Entity ));
    table = vec_push_rt(table, KeywordEntry ( word: "record", tok: TokType::Entity ));
    table = vec_push_rt(table, KeywordEntry ( word: "elif", tok: TokType::Eif ));
    table = vec_push_rt(table, KeywordEntry ( word: "then", tok: TokType::End ));

    out table;
end

func lookup_keyword:
    in(table:int; word:string)
    i = 0;
    if table == 0:
        out TokType::Eof;
    end
    kw_count = vec_len_rt(table);
    when i < kw_count loop
        entry = vec_get_rt(table, i);
        if entry == 0:
            i = i + 1;
            skip;
        end
        eq_result = rt_streq(entry.word, word);
        if eq_result:
            out entry.tok;
        end
        i = i + 1;
    end
    out TokType::Eof 
end

entity Lexer:
    source:         string;
    source_len:     int;
    pos:            int;
    line:           int;
    col:            int;
    tokens:         int;
    paren_depth:    int;
    keywords:       int;
    error_msg:          string;
end

func lexer_new:
    in(source:string)
    kw_tbl = build_keyword_table();
    out Lexer (;
        source: source,;
        source_len: rt_strlen(source),;
        pos: 0,;
        line: 1,;
        col: 1,;
        tokens: vec_new_rt(),;
        paren_depth: 0,;
        keywords: kw_tbl,;
        error_msg: ""
    );
end

func is_eof:
    in(lex:Lexer)
    out lex.pos >= lex.source_len;
end

func lex_peek:
    in(lex:Lexer)
    if lex.pos < lex.source_len:
        out native_read_u8(lex.source, lex.pos);
    end
    out 0;
end

func lex_peek_at:
    in(lex:Lexer; offset:int)
    p = lex.pos + offset;
    if p < lex.source_len:
        out native_read_u8(lex.source, p);
    end
    out 0;
end

func lex_advance:
    in(lex:Lexer)
    c = lex_peek(lex);
    if c == 10 
        lex.line = lex.line + 1;
        lex.col = 1;
    else
        lex.col = lex.col + 1;
    end
    lex.pos = lex.pos + 1;
    out (lex, c);
end

func is_alpha:
    in(c:int)
    out (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or c == 95;
end

func is_digit:
    in(c:int)
    out c >= 48 and c <= 57;
end

func is_hex_digit:
    in(c:int)
    out is_digit(c) or (c >= 65 and c <= 70) or (c >= 97 and c <= 102);
end

func is_word_char:
    in(c:int)
    out is_alpha(c) or is_digit(c) or c >= 128;
end

func skip_whitespace:
    in(lex:Lexer)
    when not is_eof(lex) loop
        c = lex_peek(lex);
        if c == 32 or c == 9 or c == 13  
            var (lex2, _) = lex_advance(lex);
            lex = lex2;
        else
            out lex;
        end
    end
    out lex;
end

func skip_comment:
    in(lex:Lexer)
    when not is_eof(lex) and lex_peek(lex) != 10 loop
        var (lex2, _) = lex_advance(lex);
        lex = lex2;
    end
    out lex;
end

func skip_block_comment:
    in(lex:Lexer)
    var (lex2, _) = lex_advance(lex) 
    var (lex3, _) = lex_advance(lex2) 
    lex = lex3;
    when not is_eof(lex) loop
        if lex_peek(lex) == 35 and lex_peek_at(lex, 1) == 35:
            var (lex4, _) = lex_advance(lex);
            var (lex5, _) = lex_advance(lex4);
            out lex5;
        end
        var (lex6, _) = lex_advance(lex);
        lex = lex6;
    end
    out lex;
end

func lex_number:
    in(lex:Lexer)
    tok = token_new(TokType::Int, lex.line, lex.col);
    num = 0;
    is_float = false;

    if lex_peek(lex) == 48 and (lex_peek_at(lex, 1) == 120 or lex_peek_at(lex, 1) == 88):
        var (lex2, _) = lex_advance(lex)   
        var (lex3, _) = lex_advance(lex2)  
        lex = lex3;
        when not is_eof(lex) and is_hex_digit(lex_peek(lex)) loop
            c = lex_peek(lex);
            digit = 0;
            if c >= 48 and c <= 57:
                digit = (c - 48) >> int;
            end
            if c >= 65 and c <= 70:
                digit = (c - 55) >> int;
            end
            if c >= 97 and c <= 102:
                digit = (c - 87) >> int;
            end
            num = num * 16 + digit;
            var (lex4, _) = lex_advance(lex);
            lex = lex4;
        end
        tok.tok_ival = num;
        out (lex, tok);
    end

    when not is_eof(lex) and (is_digit(lex_peek(lex)) or lex_peek(lex) == 46) loop
        c = lex_peek(lex);
        if c == 46 
            if is_float:
                out (lex, tok);
            end
            if lex_peek_at(lex, 1) == 46:
                out (lex, tok);
            end
            is_float = true;
        else
            if not is_float:
                num = num * 10 + (c - 48);
            end
        end
        var (lex2, _) = lex_advance(lex);
        lex = lex2;
    end

    if is_float:
        tok.tok_type = TokType::Float;
    else
        tok.tok_ival = num;
    end

    out (lex, tok);
end

func lex_string:
    in(lex:Lexer)
    tok = token_new(TokType::Str, lex.line, lex.col);
    var (lex2, quote) = lex_advance(lex) 
    lex = lex2;
    sb = sb_new();

    when not is_eof(lex) and lex_peek(lex) != quote loop
        if lex_peek(lex) == 92 
            var (lex3, _) = lex_advance(lex);
            lex = lex3;
            if is_eof(lex):
                tok.str_val = sb_to_string(sb);
                out (lex, tok);
            end
            var (lex4, esc) = lex_advance(lex);
            lex = lex4;
            if esc == 110     
                sb = sb_append_char(sb, 10);
            end
            if esc == 116     
                sb = sb_append_char(sb, 9);
            end
            if esc == 92      
                sb = sb_append_char(sb, 92);
            end
            if esc == 34      
                sb = sb_append_char(sb, 34);
            end
            if esc == 39      
                sb = sb_append_char(sb, 39);
            end
        else
            var (lex5, ch) = lex_advance(lex);
            lex = lex5;
            sb = sb_append_char(sb, ch);
        end
    end

    if not is_eof(lex):
        var (lex6, _) = lex_advance(lex);
        lex = lex6;
    end

    tok.str_val = sb_to_string(sb);
    out (lex, tok);
end

func lex_word:
    in(lex:Lexer)
    start_line = lex.line;
    start_col = lex.col;
    sb = sb_new();

    when not is_eof(lex) and is_word_char(lex_peek(lex)) loop
        var (lex2, ch) = lex_advance(lex);
        lex = lex2;
        sb = sb_append_char(sb, ch);
    end

    buf = sb_to_string(sb);

    kw_type = lookup_keyword(lex.keywords, buf);
    if kw_type != TokType::Eof:
        tok = token_new(kw_type, start_line, start_col);
        out (lex, tok);
    end

    tok = token_new(TokType::Ident, start_line, start_col);
    tok.str_val = buf;
    out (lex, tok);
end

func tokenize:
    in(lex:Lexer)
    prev_was_newline = true;

    when not is_eof(lex) loop
        lex = skip_whitespace(lex);
        if is_eof(lex):
            out lex;
        end

        c = lex_peek(lex);

        if c == 10:
            var (lex2, _) = lex_advance(lex);
            lex = lex2;
            if not prev_was_newline and lex.paren_depth == 0:
                lex.tokens = vec_push_rt(lex.tokens, token_new(TokType::Newline, lex.line, lex.col));
                prev_was_newline = true;
            end
            skip 
        end

        prev_was_newline = false;

        if c == 35 
            if lex_peek_at(lex, 1) == 35:
                lex = skip_block_comment(lex);
            else
                lex = skip_comment(lex);
            end
            skip;
        end

        if c == 34 or c == 39 
            var (lex2, tok) = lex_string(lex);
            lex = lex2;
            lex.tokens = vec_push_rt(lex.tokens, tok);
            skip;
        end

        if is_digit(c):
            var (lex2, tok) = lex_number(lex);
            lex = lex2;
            lex.tokens = vec_push_rt(lex.tokens, tok);
            skip;
        end

        c2 = lex_peek_at(lex, 1);

        if c == 61 and c2 == 61 
            tok = token_new(TokType::Eq, lex.line, lex.col);
            var (l1, _) = lex_advance(lex);
            var (l2, _) = lex_advance(l1);
            lex = l2;
            lex.tokens = vec_push_rt(lex.tokens, tok);
            skip;
        end

        if c == 33 and c2 == 61 
            tok = token_new(TokType::Ne, lex.line, lex.col);
            var (l1, _) = lex_advance(lex);
            var (l2, _) = lex_advance(l1);
            lex = l2;
            lex.tokens = vec_push_rt(lex.tokens, tok);
            skip;
        end

        if c == 62 and c2 == 61 
            tok = token_new(TokType::Ge, lex.line, lex.col);
            var (l1, _) = lex_advance(lex);
            var (l2, _) = lex_advance(l1);
            lex = l2;
            lex.tokens = vec_push_rt(lex.tokens, tok);
            skip;
        end

        if c == 60 and c2 == 61 
            tok = token_new(TokType::Le, lex.line, lex.col);
            var (l1, _) = lex_advance(lex);
            var (l2, _) = lex_advance(l1);
            lex = l2;
            lex.tokens = vec_push_rt(lex.tokens, tok);
            skip;
        end

        if c == 63 and c2 == 61 and lex_peek_at(lex, 2) == 47 and lex_peek_at(lex, 3) == 61:
            tok = token_new(TokType::SafeNe, lex.line, lex.col);
            var (l1, _) = lex_advance(lex);
            var (l2, _) = lex_advance(l1);
            var (l3, _) = lex_advance(l2);
            var (l4, _) = lex_advance(l3);
            lex = l4;
            lex.tokens = vec_push_rt(lex.tokens, tok);
            skip;
        end

        if c == 63 and c2 == 61:
            tok = token_new(TokType::SafeEq, lex.line, lex.col);
            var (l1, _) = lex_advance(lex);
            var (l2, _) = lex_advance(l1);
            lex = l2;
            lex.tokens = vec_push_rt(lex.tokens, tok);
            skip;
        end

        if c == 63 and c2 == 46:
            tok = token_new(TokType::SafeAccess, lex.line, lex.col);
            var (l1, _) = lex_advance(lex);
            var (l2, _) = lex_advance(l1);
            lex = l2;
            lex.tokens = vec_push_rt(lex.tokens, tok);
            skip;
        end

        if c == 58 and c2 == 126:
            tok = token_new(TokType::Pattern, lex.line, lex.col);
            var (l1, _) = lex_advance(lex);
            var (l2, _) = lex_advance(l1);
            lex = l2;
            lex.tokens = vec_push_rt(lex.tokens, tok);
            skip;
        end

        if c == 124 and c2 == 124:
            tok = token_new(TokType::Or, lex.line, lex.col);
            var (l1, _) = lex_advance(lex);
            var (l2, _) = lex_advance(l1);
            lex = l2;
            lex.tokens = vec_push_rt(lex.tokens, tok);
            skip;
        end

        if c == 45 and c2 == 62:
            tok = token_new(TokType::Arrow, lex.line, lex.col);
            var (l1, _) = lex_advance(lex);
            var (l2, _) = lex_advance(l1);
            lex = l2;
            lex.tokens = vec_push_rt(lex.tokens, tok);
            skip;
        end

        if c == 60 and c2 == 60:
            tok = token_new(TokType::BitShl, lex.line, lex.col);
            var (l1, _) = lex_advance(lex);
            var (l2, _) = lex_advance(l1);
            lex = l2;
            lex.tokens = vec_push_rt(lex.tokens, tok);
            skip;
        end

        if c == 62 and c2 == 62:
            tok = token_new(TokType::Cast, lex.line, lex.col);
            var (l1, _) = lex_advance(lex);
            var (l2, _) = lex_advance(l1);
            lex = l2;
            lex.tokens = vec_push_rt(lex.tokens, tok);
            skip;
        end

        if c == 58 and c2 == 58:
            tok = token_new(TokType::DoubleColon, lex.line, lex.col);
            var (l1, _) = lex_advance(lex);
            var (l2, _) = lex_advance(l1);
            lex = l2;
            lex.tokens = vec_push_rt(lex.tokens, tok);
            skip;
        end

        if c == 46 and c2 == 46:
            tok = token_new(TokType::DotDot, lex.line, lex.col);
            var (l1, _) = lex_advance(lex);
            var (l2, _) = lex_advance(l1);
            lex = l2;
            lex.tokens = vec_push_rt(lex.tokens, tok);
            skip;
        end

        single_tok = TokType::Eof;
        if c == 43:
            single_tok = TokType::Plus;
        end
        if c == 45 and single_tok == TokType::Eof:
            single_tok = TokType::Minus;
        end
        if c == 42:
            single_tok = TokType::Star;
        end
        if c == 47:
            single_tok = TokType::Slash;
        end
        if c == 37:
            single_tok = TokType::Percent;
        end
        if c == 94:
            single_tok = TokType::Power;
        end
        if c == 61 and single_tok == TokType::Eof:
            single_tok = TokType::Assign;
        end
        if c == 62 and single_tok == TokType::Eof:
            single_tok = TokType::Gt;
        end
        if c == 60 and single_tok == TokType::Eof:
            single_tok = TokType::Lt;
        end
        if c == 33 and single_tok == TokType::Eof:
            single_tok = TokType::Not;
        end
        if c == 63 and single_tok == TokType::Eof:
            single_tok = TokType::Exist;
        end
        if c == 38:
            single_tok = TokType::And;
        end
        if c == 124 and single_tok == TokType::Eof:
            single_tok = TokType::BitOr;
        end
        if c == 126:
            single_tok = TokType::BitNot;
        end

        if c == 40:
            single_tok = TokType::LParen;
            lex.paren_depth = lex.paren_depth + 1;
        end
        if c == 41:
            single_tok = TokType::RParen;
            if lex.paren_depth > 0:
                lex.paren_depth = lex.paren_depth - 1;
            end
        end
        if c == 91:
            single_tok = TokType::LBracket;
            lex.paren_depth = lex.paren_depth + 1;
        end
        if c == 93:
            single_tok = TokType::RBracket;
            if lex.paren_depth > 0:
                lex.paren_depth = lex.paren_depth - 1;
            end
        end
        if c == 123:
            single_tok = TokType::LBrace;
            lex.paren_depth = lex.paren_depth + 1;
        end
        if c == 125:
            single_tok = TokType::RBrace;
            if lex.paren_depth > 0:
                lex.paren_depth = lex.paren_depth - 1;
            end
        end
        if c == 44:
            single_tok = TokType::Comma;
        end
        if c == 46 and single_tok == TokType::Eof:
            single_tok = TokType::Dot;
        end
        if c == 58 and single_tok == TokType::Eof:
            single_tok = TokType::Colon;
        end
        if c == 59:
            single_tok = TokType::Semicolon;
        end

        if single_tok != TokType::Eof:
            tok = token_new(single_tok, lex.line, lex.col);
            var (lex2, _) = lex_advance(lex);
            lex = lex2;
            lex.tokens = vec_push_rt(lex.tokens, tok);
            skip;
        end

        if is_word_char(c):
            var (lex2, tok) = lex_word(lex);
            lex = lex2;
            lex.tokens = vec_push_rt(lex.tokens, tok);
            skip;
        end

        var (lex2, _) = lex_advance(lex);
        lex = lex2;
    end

    lex.tokens = vec_push_rt(lex.tokens, token_new(TokType::Eof, lex.line, lex.col));
    out lex;
end

func token_name:
    in(t:TokType)
    if t == TokType::Eof:
        out "EOF";
    end
    if t == TokType::Int:
        out "INT";
    end
    if t == TokType::Float:
        out "FLOAT";
    end
    if t == TokType::Str:
        out "STRING";
    end
    if t == TokType::Ident:
        out "IDENT";
    end
    if t == TokType::Newline:
        out "NEWLINE";
    end
    if t == TokType::Func:
        out "FUNC";
    end
    if t == TokType::Var:
        out "VAR";
    end
    if t == TokType::Const:
        out "CONST";
    end
    if t == TokType::Entity:
        out "ENTITY";
    end
    if t == TokType::Enum:
        out "ENUM";
    end
    if t == TokType::If:
        out "IF";
    end
    if t == TokType::Else:
        out "ELSE";
    end
    if t == TokType::End:
        out "END";
    end
    if t == TokType::Out:
        out "OUT";
    end
    if t == TokType::While:
        out "WHILE";
    end
    if t == TokType::Break:
        out "BREAK";
    end
    if t == TokType::Skip:
        out "SKIP";
    end
    out "???";
end

# -- END vir/compiler/lexer.vri --

# -- BEGIN vir/compiler/parser.vri --

enum AstType:
    Program         = 0;
    Block           = 1;
    FuncDef         = 2;
    VarDecl         = 3;
    ConstDecl       = 4;
    Assign          = 5;
    IndexAssign     = 6;
    FieldAssign     = 7;
    IfStmt          = 8;
    LoopStmt        = 9;
    WhileStmt       = 10;
    ForRange        = 11;
    ReturnStmt      = 12;
    PrintStmt       = 13;
    BreakStmt       = 14;
    ContinueStmt    = 15;
    EnumDef         = 16;
    EntityDef       = 17;
    ImportStmt      = 18;
    ModuleStmt      = 19;
    ExportStmt      = 20;
    IncludeStmt     = 21;
    LiteralInt      = 30;
    LiteralFloat    = 31;
    LiteralStr      = 32;
    Identifier      = 33;
    BinOp           = 34;
    Compare         = 35;
    Call            = 36;
    BuiltinCall     = 37;
    InputExpr       = 38;
    ArrayLiteral    = 39;
    IndexAccess     = 40;
    FieldAccess     = 41;
    EnumAccess      = 42;
    EntityLiteral   = 43;
    CheckCpu        = 50;
    PatchPoint      = 51;
    ExternFunc      = 52;
    WhenStmt        = 53;
    CastExpr        = 54;
    UnaryMinus      = 55;
    ExprIndex       = 56;
    TupleExpr       = 57;
end

enum OpType:
    Add     = 0;
    Sub     = 1;
    Mul     = 2;
    Div     = 3;
    ModOp   = 4;
    Eq      = 10;
    Ne      = 11;
    Gt      = 12;
    Lt      = 13;
    Ge      = 14;
    Le      = 15;
    AndOp   = 20;
    OrOp    = 21;
    XorOp   = 22;
    ShlOp   = 23;
    ShrOp   = 24;
end

entity AstNode:
    name:           string;
    name2:          string;
    node_type:      AstType;
    op:             OpType;
    line:           int;
    int_val:        int;
    float_val:      float;
    builtin_id:     int;
    children:       int;
end

func ast_new:
    in(typ:AstType)
    out AstNode (;
        name:       "",;
        name2:      "",;
        node_type:  typ,;
        op:         OpType::Add,;
        line:       0,;
        int_val:    0,;
        float_val:  0.0,;
        builtin_id: 0,;
        children:   vec_new_rt()
    );
end

func ast_add_child:
    in(parent:AstNode; child:AstNode)
    parent.children = vec_push_rt(parent.children, child);
    out parent;
end

enum BuiltinId:
    None            = 0;
    Len             = 1;
    Push            = 2;
    Alloc           = 3;
    FreeMem         = 4;
    Read8           = 5;
    Write8          = 6;
    Read64          = 7;
    Write64         = 8;
    StrLen          = 9;
    StrGet          = 10;
    StrCat          = 11;
    StrEq           = 12;
    FileOpen        = 13;
    FileRead        = 14;
    FileWrite       = 15;
    FileClose       = 16;
    FileWriteByte   = 17;
    Exit            = 18;
    IToStr          = 19;
    StrToI          = 20;
    ArrNew          = 21;
    PrintStr        = 22;
    GetArg          = 23;
    ArgCount        = 24;
end

entity BuiltinEntry:
    name:   string;
    bid:    BuiltinId;
end

func build_builtins:
    table = vec_new_rt();
    table = vec_push_rt(table, BuiltinEntry ( name: "len", bid: BuiltinId::Len ));
    table = vec_push_rt(table, BuiltinEntry ( name: "push", bid: BuiltinId::Push ));
    table = vec_push_rt(table, BuiltinEntry ( name: "alloc", bid: BuiltinId::Alloc ));
    table = vec_push_rt(table, BuiltinEntry ( name: "dealloc", bid: BuiltinId::FreeMem ));
    table = vec_push_rt(table, BuiltinEntry ( name: "read_byte", bid: BuiltinId::Read8 ));
    table = vec_push_rt(table, BuiltinEntry ( name: "write_byte", bid: BuiltinId::Write8 ));
    table = vec_push_rt(table, BuiltinEntry ( name: "read_word", bid: BuiltinId::Read64 ));
    table = vec_push_rt(table, BuiltinEntry ( name: "write_word", bid: BuiltinId::Write64 ));
    table = vec_push_rt(table, BuiltinEntry ( name: "str_len", bid: BuiltinId::StrLen ));
    table = vec_push_rt(table, BuiltinEntry ( name: "str_get", bid: BuiltinId::StrGet ));
    table = vec_push_rt(table, BuiltinEntry ( name: "str_cat", bid: BuiltinId::StrCat ));
    table = vec_push_rt(table, BuiltinEntry ( name: "str_eq", bid: BuiltinId::StrEq ));
    table = vec_push_rt(table, BuiltinEntry ( name: "file_open", bid: BuiltinId::FileOpen ));
    table = vec_push_rt(table, BuiltinEntry ( name: "file_read", bid: BuiltinId::FileRead ));
    table = vec_push_rt(table, BuiltinEntry ( name: "file_write", bid: BuiltinId::FileWrite ));
    table = vec_push_rt(table, BuiltinEntry ( name: "file_close", bid: BuiltinId::FileClose ));
    table = vec_push_rt(table, BuiltinEntry ( name: "file_write_byte", bid: BuiltinId::FileWriteByte ));
    table = vec_push_rt(table, BuiltinEntry ( name: "exit_prog", bid: BuiltinId::Exit ));
    table = vec_push_rt(table, BuiltinEntry ( name: "i_to_str", bid: BuiltinId::IToStr ));
    table = vec_push_rt(table, BuiltinEntry ( name: "int_to_str", bid: BuiltinId::IToStr ));
    table = vec_push_rt(table, BuiltinEntry ( name: "str_to_i", bid: BuiltinId::StrToI ));
    table = vec_push_rt(table, BuiltinEntry ( name: "str_to_int", bid: BuiltinId::StrToI ));
    table = vec_push_rt(table, BuiltinEntry ( name: "arr_new", bid: BuiltinId::ArrNew ));
    table = vec_push_rt(table, BuiltinEntry ( name: "arr_push", bid: BuiltinId::Push ));
    table = vec_push_rt(table, BuiltinEntry ( name: "arr_len", bid: BuiltinId::Len ));
    table = vec_push_rt(table, BuiltinEntry ( name: "print_str", bid: BuiltinId::PrintStr ));
    table = vec_push_rt(table, BuiltinEntry ( name: "get_arg", bid: BuiltinId::GetArg ));
    table = vec_push_rt(table, BuiltinEntry ( name: "arg_count", bid: BuiltinId::ArgCount ));
    out table;
end

func lookup_builtin:
    in(table:int; name:string)
    i = 0;
    when i < vec_len_rt(table) loop
        entry = vec_get_rt(table, i);
        if rt_streq(entry.name, name):
            out entry.bid;
        end
        i = i + 1;
    end
    out BuiltinId::None;
end

entity Parser:
    tokens:         int;
    pos:            int;
    token_count:    int;
    error_msg:          string;
    error_line:     int;
    builtins:       int;
end

func parser_new:
    in(tokens:int)
    tc = vec_len_rt(tokens);
    bi = build_builtins();
    p = Parser (;
        tokens:      tokens,;
        pos:         0,;
        token_count: tc,;
        error_msg:       "",;
        error_line:  0,;
        builtins:    bi
    );
    out p;
end

func parse_error:
    in(p:Parser; msg:string)
    if rt_strlen(p.error_msg) == 0:
        t = peek(p);
        p.error_msg = rt_strcat(rt_strcat("line ", rt_itoa(t.line >> int)), rt_strcat(": ", msg));
        p.error_line = t.line;
    end
    out p;
end

func peek:
    in(p:Parser)
    idx = p.pos;
    if idx >= p.token_count:
        idx = p.token_count - 1;
    end
    out vec_get_rt(p.tokens, idx >> int);
end

func advance:
    in(p:Parser)
    t = peek(p);
    if p.pos < p.token_count:
        p.pos = p.pos + 1;
    end
    out (p, t);
end

func check:
    in(p:Parser; tok_type:TokType)
    out peek(p).tok_type == tok_type;
end

func match_tok:
    in(p:Parser; tok_type:TokType)
    if check(p, tok_type):
        var (p2, _) = advance(p);
        out (p2, true);
    end
    out (p, false);
end

func expect_tok:
    in(p:Parser; tok_type:TokType; msg:string)
    if check(p, tok_type):
        var (p2, t) = advance(p);
        out (p2, t, true);
    end
    p = parse_error(p, msg);
    out (p, peek(p), false);
end

func skip_newlines:
    in(p:Parser)
    when check(p, TokType::Newline) loop
        var (p2, _) = advance(p);
        p = p2;
    end
    out p;
end

func is_stmt_start:
    in(t:TokType)
    out t == TokType::Var or t == TokType::Const or t == TokType::If or;
        t == TokType::Loop or t == TokType::While or t == TokType::When or t == TokType::For or;
        t == TokType::Out or t == TokType::Print or t == TokType::Input or;
        t == TokType::Ident or t == TokType::Int or t == TokType::Float or;
        t == TokType::Str or t == TokType::LParen or t == TokType::Minus or;
        t == TokType::Not or t == TokType::CheckCpu or t == TokType::Patch or;
        t == TokType::Func or t == TokType::Break or t == TokType::Skip or;
        t == TokType::True or t == TokType::False or t == TokType::LBracket or;
        t == TokType::Enum or t == TokType::Entity or;
        t == TokType::Import or t == TokType::From or t == TokType::Module or;
        t == TokType::Export or t == TokType::Include;
end

func parse_primary:
    in(p:Parser)
    t = peek(p);

    if t.tok_type == TokType::Int:
        var (p2, t2) = advance(p);
        n = ast_new(AstType::LiteralInt);
        n.int_val = t2.tok_ival;
        n.line = t2.line;
        out (p2, n);
    end

    if t.tok_type == TokType::Float:
        var (p2, t2) = advance(p);
        n = ast_new(AstType::LiteralFloat);
        n.float_val = t2.tok_fval;
        n.line = t2.line;
        out (p2, n);
    end

    if t.tok_type == TokType::Str:
        var (p2, t2) = advance(p);
        n = ast_new(AstType::LiteralStr);
        n.name = t2.str_val;
        n.line = t2.line;
        out (p2, n);
    end

    if t.tok_type == TokType::True:
        var (p2, _) = advance(p);
        n = ast_new(AstType::LiteralInt);
        n.int_val = 1;
        n.line = t.line;
        out (p2, n);
    end

    if t.tok_type == TokType::False or t.tok_type == TokType::NoneLit:
        var (p2, _) = advance(p);
        n = ast_new(AstType::LiteralInt);
        n.int_val = 0;
        n.line = t.line;
        out (p2, n);
    end

    if t.tok_type == TokType::Ident:
        var (p2, id_tok) = advance(p);

        if check(p, TokType::DoubleColon):
            var (p3, _) = advance(p); 
            vt = peek(p3);
            var (p4, _) = advance(p3);
            ea = ast_new(AstType::EnumAccess);
            ea.name = id_tok.str_val;
            ea.name2 = vt.str_val;
            ea.line = id_tok.line;
            out (p4, ea);
        end

        if check(p, TokType::LBrace) and check_entity_literal(p):
            var (p3, _) = advance(p) 
            el = ast_new(AstType::EntityLiteral);
            el.name = id_tok.str_val;
            el.line = id_tok.line;
            when not check(p3, TokType::RBrace) and not check(p3, TokType::Eof) loop
                var (p4, fname, ok) = expect_tok(p3, TokType::Ident, "expected field name");
                p3 = p4;
                if not ok:
                    out (p3, el);
                end
                var (p5, _, _) = expect_tok(p3, TokType::Colon, "expected ':' after field");
                p3 = p5;
                var (p6, val) = parse_expr(p3);
                p3 = p6;
                val.name2 = fname.str_val;
                el = ast_add_child(el, val);
                var (p7, _) = match_tok(p3, TokType::Comma);
                p3 = p7;
                p3 = skip_newlines(p3);
            end
            var (p8, _, _) = expect_tok(p3, TokType::RBrace, "expected ')' after entity literal");
            out (p8, el);
        end

        if check(p, TokType::Lt):
            save_pos = p.pos;
            p.pos = p.pos + 1;
            next_tok_type = peek(p).tok_type;
            p.pos = save_pos;
            if next_tok_type == TokType::Ident:
                var (p_g1, _) = advance(p); 
                depth = 1;
                success = false;
                when depth > 0 and not check(p_g1, TokType::Eof) loop
                    g_tok = peek(p_g1);
                    if g_tok.tok_type == TokType::Lt:
                        depth = depth + 1;
                    end
                    if g_tok.tok_type == TokType::Gt:
                        depth = depth - 1;
                    end
                    var (p_g2, _) = advance(p_g1);
                    p_g1 = p_g2;
                end
                if depth == 0 and check(p_g1, TokType::LParen):
                    p = p_g1;
                    success = true;
                else
                    p.pos = save_pos;
                end
            end
        end

        if check(p, TokType::LParen):
            bid = lookup_builtin(p.builtins, id_tok.str_val);
            if bid != BuiltinId::None:
                call = ast_new(AstType::BuiltinCall);
                call.builtin_id = bid >> int;
                call.name = id_tok.str_val;
                call.line = id_tok.line;
                var (p3, _) = advance(p) 
                if not check(p3, TokType::RParen):
                    var (p4, arg) = parse_expr(p3);
                    p3 = p4;
                    call = ast_add_child(call, arg);
                    should_loop = true;
                    when should_loop loop
                        var (p5, matched) = match_tok(p3, TokType::Comma);
                        p3 = p5;
                        if not matched:
                            should_loop = false;
                        else
                            var (p6, arg2) = parse_expr(p3);
                            p3 = p6;
                            call = ast_add_child(call, arg2);
                        end
                    end
                end
                var (p7, _, _) = expect_tok(p3, TokType::RParen, "expected ')' after builtin args");
                out (p7, call);
            end

            call = ast_new(AstType::Call);
            call.name = id_tok.str_val;
            call.line = id_tok.line;
            var (p3, _) = advance(p) 
            if not check(p3, TokType::RParen):
                var (p4, arg) = parse_expr(p3);
                p3 = p4;
                call = ast_add_child(call, arg);
                should_loop = true;
                when should_loop loop
                    var (p5, matched) = match_tok(p3, TokType::Comma);
                    p3 = p5;
                    if not matched:
                        should_loop = false;
                    else
                        var (p6, arg2) = parse_expr(p3);
                        p3 = p6;
                        call = ast_add_child(call, arg2);
                    end
                end
            end
            var (p7, _, _) = expect_tok(p3, TokType::RParen, "expected ')' after arguments");
            out (p7, call);
        end

        if check(p, TokType::LBracket):
            var (p3, _) = advance(p) 
            var (p4, idx_expr) = parse_expr(p3);
            var (p5, _, _) = expect_tok(p4, TokType::RBracket, "expected ']' after index");
            access = ast_new(AstType::IndexAccess);
            access.name = id_tok.str_val;
            access.line = id_tok.line;
            access = ast_add_child(access, idx_expr);
            out (p5, access);
        end

        n = ast_new(AstType::Identifier);
        n.name = id_tok.str_val;
        n.line = id_tok.line;
        out (p, n);
    end

    if t.tok_type == TokType::Input:
        var (p2, _) = advance(p);
        n = ast_new(AstType::InputExpr);
        n.line = t.line;
        out (p2, n);
    end

    if t.tok_type == TokType::LParen:
        var (p2, _) = advance(p);
        var (p3, inner) = parse_expr(p2);
        var (p4, _, _) = expect_tok(p3, TokType::RParen, "expected ')'");
        out (p4, inner);
    end

    if t.tok_type == TokType::LBracket:
        var (p2, _) = advance(p);
        arr = ast_new(AstType::ArrayLiteral);
        arr.line = t.line;
        if not check(p2, TokType::RBracket):
            var (p3, elem) = parse_expr(p2);
            p2 = p3;
            arr = ast_add_child(arr, elem);
            should_loop = true;
            when should_loop loop
                var (p4, matched) = match_tok(p2, TokType::Comma);
                p2 = p4;
                if not matched:
                    should_loop = false;
                else
                    var (p5, elem2) = parse_expr(p2);
                    p2 = p5;
                    arr = ast_add_child(arr, elem2);
                end
            end
        end
        var (p6, _, _) = expect_tok(p2, TokType::RBracket, "expected ']' after array literal");
        out (p6, arr);
    end

    p = parse_error(p, "expected expression");
    out (p, ast_new(AstType::LiteralInt));
end

func check_entity_literal:
    in(p:Parser)
    if not check(p, TokType::LBrace):
        out false;
    end
    next_idx = p.pos + 1;
    if next_idx < p.token_count:
        t1 = vec_get_rt(p.tokens, next_idx >> int);
        if t1.tok_type == TokType::RBrace:
            out true;
        end
        if next_idx + 1 < p.token_count:
            t2 = vec_get_rt(p.tokens, (next_idx + 1) >> int);
            if t1.tok_type == TokType::Ident and t2.tok_type == TokType::Colon:
                out true;
            end
        end
    end
    out false;
end

func parse_unary:
    in(p:Parser)
    if check(p, TokType::Minus):
        var (p2, t) = advance(p);
        var (p3, operand) = parse_unary(p2);
        zero = ast_new(AstType::LiteralInt);
        zero.int_val = 0;
        zero.line = t.line;
        n = ast_new(AstType::BinOp);
        n.op = OpType::Sub;
        n.line = t.line;
        n = ast_add_child(n, zero);
        n = ast_add_child(n, operand);
        out (p3, n);
    end

    if check(p, TokType::Not):
        var (p2, t) = advance(p);
        var (p3, operand) = parse_unary(p2);
        zero = ast_new(AstType::LiteralInt);
        zero.int_val = 0;
        zero.line = t.line;
        n = ast_new(AstType::Compare);
        n.op = OpType::Eq;
        n.line = t.line;
        n = ast_add_child(n, operand);
        n = ast_add_child(n, zero);
        out (p3, n);
    end

    var (p2, left) = parse_primary(p);
    when check(p2, TokType::Dot) loop
        var (p3, _) = advance(p2);
        var (p4, field, ok) = expect_tok(p3, TokType::Ident, "expected field name after '.'");
        if not ok:
            out (p4, left);
        end
        fa = ast_new(AstType::FieldAccess);
        fa.name = field.str_val;
        fa.line = field.line;
        fa = ast_add_child(fa, left);
        left = fa;
        p2 = p4;
    end
    out (p2, left);
end

func parse_mult:
    in(p:Parser)
    var (p2, left) = parse_unary(p);

    when check(p2, TokType::Star) or check(p2, TokType::Slash) or check(p2, TokType::Percent) loop
        var (p3, op_tok) = advance(p2);
        op = OpType::Mul;
        if op_tok.tok_type == TokType::Slash:
            op = OpType::Div;
        end
        if op_tok.tok_type == TokType::Percent:
            op = OpType::ModOp;
        end
        var (p4, right) = parse_unary(p3);
        bin = ast_new(AstType::BinOp);
        bin.op = op;
        bin.line = op_tok.line;
        bin = ast_add_child(bin, left);
        bin = ast_add_child(bin, right);
        left = bin;
        p2 = p4;
    end
    out (p2, left);
end

func parse_addition:
    in(p:Parser)
    var (p2, left) = parse_mult(p);

    when check(p2, TokType::Plus) or check(p2, TokType::Minus) loop
        var (p3, op_tok) = advance(p2);
        op = OpType::Add;
        if op_tok.tok_type == TokType::Minus:
            op = OpType::Sub;
        end
        var (p4, right) = parse_mult(p3);
        bin = ast_new(AstType::BinOp);
        bin.op = op;
        bin.line = op_tok.line;
        bin = ast_add_child(bin, left);
        bin = ast_add_child(bin, right);
        left = bin;
        p2 = p4;
    end
    out (p2, left);
end

func parse_bitwise:
    in(p:Parser)
    var (p2, left) = parse_addition(p);

    is_bitwise = check(p2, TokType::BitAnd) or check(p2, TokType::BitOr) or;
                 check(p2, TokType::BitXor) or check(p2, TokType::BitShl) or;
                 check(p2, TokType::BitShr);
    when is_bitwise loop
        var (p3, op_tok) = advance(p2);
        op = OpType::AndOp;
        if op_tok.tok_type == TokType::BitOr:
            op = OpType::OrOp;
        end
        if op_tok.tok_type == TokType::BitXor:
            op = OpType::XorOp;
        end
        if op_tok.tok_type == TokType::BitShl:
            op = OpType::ShlOp;
        end
        if op_tok.tok_type == TokType::BitShr:
            op = OpType::ShrOp;
        end
        var (p4, right) = parse_addition(p3);
        bin = ast_new(AstType::BinOp);
        bin.op = op;
        bin.line = op_tok.line;
        bin = ast_add_child(bin, left);
        bin = ast_add_child(bin, right);
        left = bin;
        p2 = p4;
        is_bitwise = check(p2, TokType::BitAnd) or check(p2, TokType::BitOr) or;
                     check(p2, TokType::BitXor) or check(p2, TokType::BitShl) or;
                     check(p2, TokType::BitShr);
    end
    out (p2, left);
end

func parse_compare:
    in(p:Parser)
    var (p2, left) = parse_bitwise(p);

    has_cmp = check(p2, TokType::Eq) or check(p2, TokType::Ne) or;
              check(p2, TokType::Gt) or check(p2, TokType::Lt) or;
              check(p2, TokType::Ge) or check(p2, TokType::Le);
    if has_cmp:
        var (p3, op_tok) = advance(p2);
        op = OpType::Eq;
        if op_tok.tok_type == TokType::Ne:
            op = OpType::Ne;
        end
        if op_tok.tok_type == TokType::Gt:
            op = OpType::Gt;
        end
        if op_tok.tok_type == TokType::Lt:
            op = OpType::Lt;
        end
        if op_tok.tok_type == TokType::Ge:
            op = OpType::Ge;
        end
        if op_tok.tok_type == TokType::Le:
            op = OpType::Le;
        end
        var (p4, right) = parse_bitwise(p3);
        cmp = ast_new(AstType::Compare);
        cmp.op = op;
        cmp.line = op_tok.line;
        cmp = ast_add_child(cmp, left);
        cmp = ast_add_child(cmp, right);
        out (p4, cmp);
    end
    out (p2, left);
end

func parse_and_expr:
    in(p:Parser)
    var (p2, left) = parse_compare(p);

    when check(p2, TokType::And) loop
        var (p3, _) = advance(p2);
        var (p4, right) = parse_compare(p3);
        bin = ast_new(AstType::BinOp);
        bin.op = OpType::AndOp;
        bin = ast_add_child(bin, left);
        bin = ast_add_child(bin, right);
        left = bin;
        p2 = p4;
    end
    out (p2, left);
end

func parse_or_expr:
    in(p:Parser)
    var (p2, left) = parse_and_expr(p);

    when check(p2, TokType::Or) loop
        var (p3, _) = advance(p2);
        var (p4, right) = parse_and_expr(p3);
        bin = ast_new(AstType::BinOp);
        bin.op = OpType::OrOp;
        bin = ast_add_child(bin, left);
        bin = ast_add_child(bin, right);
        left = bin;
        p2 = p4;
    end
    out (p2, left);
end

func parse_expr:
    in(p:Parser)
    out parse_or_expr(p);
end

func parse_block:
    in(p:Parser)
    block = ast_new(AstType::Block);
    p = skip_newlines(p);

    should_continue = true;
    when should_continue loop
        if check(p, TokType::End) or check(p, TokType::Else) or check(p, TokType::Eif) or check(p, TokType::Eof):
            should_continue = false;
        else
            var (p2, stmt) = parse_statement(p);
            p = p2;
            block = ast_add_child(block, stmt);
            if rt_strlen(p.error_msg) > 0:
                out (p, block);
            end
            p = skip_newlines(p);
        end
    end
    out (p, block);
end

func parse_var_decl:
    in(p:Parser; is_const:bool)
    var (p2, name_tok, ok) = expect_tok(p, TokType::Ident, "expected variable name");
    if not ok:
        out (p2, ast_new(AstType::VarDecl));
    end

    decl_type = AstType::VarDecl;
    if is_const:
        decl_type = AstType::ConstDecl;
    end
    decl = ast_new(decl_type);
    decl.name = name_tok.str_val;
    decl.line = name_tok.line;

    var (p3, matched) = match_tok(p2, TokType::Assign);
    if not matched:
        var (p3b, matched2) = match_tok(p2, TokType::Colon);
        if matched2:
            matched = true;
            p3 = p3b;
        end
    end
    if matched:
        var (p4, init) = parse_expr(p3);
        decl = ast_add_child(decl, init);
        var (p5, _) = match_tok(p4, TokType::Semicolon);
        out (p5, decl);
    end
    out (p3, decl);
end

func parse_if_stmt:
    in(p:Parser)
    line = peek(p).line;
    var (p2, cond) = parse_expr(p);

    var (p2b, _) = match_tok(p2, TokType::Colon);
    p2 = p2b;

    p2 = skip_newlines(p2);

    var (p3, then_block) = parse_block(p2);

    if_node = ast_new(AstType::IfStmt);
    if_node.line = line;
    if_node = ast_add_child(if_node, cond);
    if_node = ast_add_child(if_node, then_block);

    if check(p3, TokType::Eif):
        var (p4, _) = advance(p3);
        var (p5, elif_as_if) = parse_if_stmt(p4);
        else_block = ast_new(AstType::Block);
        else_block = ast_add_child(else_block, elif_as_if);
        if_node = ast_add_child(if_node, else_block);
        out (p5, if_node);
    end

    var (p4, has_else) = match_tok(p3, TokType::Else);
    if has_else:
        var (p4b, _) = match_tok(p4, TokType::Colon);
        p4 = p4b;
        p4 = skip_newlines(p4);
        var (p5, else_block) = parse_block(p4);
        if_node = ast_add_child(if_node, else_block);
        p4 = p5;
    end

    var (p5, _, _) = expect_tok(p4, TokType::End, "expected 'end' after if block");
    out (p5, if_node);
end

func parse_loop_stmt:
    in(p:Parser)
    line = peek(p).line;
    var (p2, count) = parse_expr(p);
    var (p2b, _) = match_tok(p2, TokType::Colon);
    p2 = p2b;
    p2 = skip_newlines(p2);
    var (p3, body) = parse_block(p2);
    var (p4, _, _) = expect_tok(p3, TokType::End, "expected 'end' after loop block");
    n = ast_new(AstType::LoopStmt);
    n.line = line;
    n = ast_add_child(n, count);
    n = ast_add_child(n, body);
    out (p4, n);
end

func parse_while_stmt:
    in(p:Parser)
    line = peek(p).line;
    var (_, cond) = parse_expr(p);
    var (_, _) = match_tok(p, TokType::Loop);
    var (_, _) = match_tok(p, TokType::Colon);
    p = skip_newlines(p);
    var (_, body) = parse_block(p);
    var (_, _, _) = expect_tok(p, TokType::End, "expected 'end' after while block");
    n = ast_new(AstType::WhileStmt);
    n.line = line;
    n = ast_add_child(n, cond);
    n = ast_add_child(n, body);
    out (p, n);
end

func parse_return_stmt:
    in(p:Parser)
    line = peek(p).line;
    n = ast_new(AstType::ReturnStmt);
    n.line = line;
    has_val = not check(p, TokType::Newline) and not check(p, TokType::End) and;
              not check(p, TokType::Eof) and not check(p, TokType::Else);
    if has_val:
        var (p2, val) = parse_expr(p);
        n = ast_add_child(n, val);
        out (p2, n);
    end
    out (p, n);
end

func parse_print_stmt:
    in(p:Parser)
    line = peek(p).line;
    n = ast_new(AstType::PrintStmt);
    n.line = line;
    var (p2, val) = parse_expr(p);
    n = ast_add_child(n, val);
    out (p2, n);
end

func parse_func_def:
    in(p:Parser)
    var (p2, name_tok, ok) = expect_tok(p, TokType::Ident, "expected function name");
    if not ok:
        out (p2, ast_new(AstType::FuncDef));
    end

    fn_node = ast_new(AstType::FuncDef);
    fn_node.name = name_tok.str_val;
    fn_node.line = name_tok.line;

    if check(p2, TokType::LParen):
        var (p3, _) = advance(p2);

        if not check(p3, TokType::RParen):
            var (p4, param_tok, ok2) = expect_tok(p3, TokType::Ident, "expected parameter name");
            p3 = p4;
            if ok2:
                param = ast_new(AstType::Identifier);
                param.name = param_tok.str_val;
                fn_node = ast_add_child(fn_node, param);
            end
            if check(p3, TokType::Colon):
                var (p_skip, _) = advance(p3);
                p3 = p_skip;
                if check(p3, TokType::Ident):
                    var (p_skip2, _) = advance(p3);
                    p3 = p_skip2;
                end
            end
            should_loop = true;
            when should_loop loop
                has_sep = false;
                var (p5, matched_comma) = match_tok(p3, TokType::Comma);
                p3 = p5;
                if matched_comma:
                    has_sep = true;
                end
                if not has_sep:
                    var (p5b, matched_semi) = match_tok(p3, TokType::Semicolon);
                    p3 = p5b;
                    if matched_semi:
                        has_sep = true;
                    end
                end
                if not has_sep:
                    should_loop = false;
                else
                    var (p6, pt, ok3) = expect_tok(p3, TokType::Ident, "expected parameter name");
                    p3 = p6;
                    if ok3:
                        param2 = ast_new(AstType::Identifier);
                        param2.name = pt.str_val;
                        fn_node = ast_add_child(fn_node, param2);
                    end
                    if check(p3, TokType::Colon):
                        var (p_skip3, _) = advance(p3);
                        p3 = p_skip3;
                        if check(p3, TokType::Ident):
                            var (p_skip4, _) = advance(p3);
                            p3 = p_skip4;
                        end
                    end
                end
            end
        end

        var (p4, _, _) = expect_tok(p3, TokType::RParen, "expected ')' after parameters");
        p2 = p4;
    end

    if check(p2, TokType::Arrow):
        var (p_arr, _) = advance(p2);
        p2 = p_arr;
        if check(p2, TokType::Ident):
            var (p_rt, _) = advance(p2);
            p2 = p_rt;
        end
    end

    var (p_colon, _) = match_tok(p2, TokType::Colon);
    p2 = p_colon;

    p2 = skip_newlines(p2);

    var (p5, body) = parse_block(p2);
    fn_node = ast_add_child(fn_node, body);

    var (p6, _, _) = expect_tok(p5, TokType::End, "expected 'end' to close function");
    var (p6b, _) = match_tok(p6, TokType::Dot);
    out (p6b, fn_node);
end

func parse_for_range_stmt:
    in(p:Parser)
    line = peek(p).line;
    var (p2, var_tok, ok) = expect_tok(p, TokType::Ident, "expected loop variable");
    if not ok:
        out (p2, ast_new(AstType::ForRange));
    end

    var (p3, _, ok2) = expect_tok(p2, TokType::In, "expected 'in' after for variable");
    if not ok2:
        out (p3, ast_new(AstType::ForRange));
    end

    var (p4, start_expr) = parse_expr(p3);
    var (p5, _, ok3) = expect_tok(p4, TokType::DotDot, "expected '..' in range");
    if not ok3:
        out (p5, ast_new(AstType::ForRange));
    end

    var (p6, end_expr) = parse_expr(p5);
    var (p6b, _) = match_tok(p6, TokType::Colon);
    p6 = p6b;
    p6 = skip_newlines(p6);

    var (p7, body) = parse_block(p6);
    var (p8, _, _) = expect_tok(p7, TokType::End, "expected 'end' after for block");

    n = ast_new(AstType::ForRange);
    n.name = var_tok.str_val;
    n.line = line;
    n = ast_add_child(n, start_expr);
    n = ast_add_child(n, end_expr);
    n = ast_add_child(n, body);
    out (p8, n);
end

func parse_enum_def:
    in(p:Parser)
    line = peek(p).line;
    var (p2, name_tok, ok) = expect_tok(p, TokType::Ident, "expected enum name");
    if not ok:
        out (p2, ast_new(AstType::EnumDef));
    end

    p2 = skip_newlines(p2);

    en = ast_new(AstType::EnumDef);
    en.name = name_tok.str_val;
    en.line = line;

    var (p2b, _) = match_tok(p2, TokType::Colon);
    p2 = p2b;
    p2 = skip_newlines(p2);

    next_val = 0;
    when not check(p2, TokType::End) and not check(p2, TokType::Eof) loop
        var (p3, vname, ok2) = expect_tok(p2, TokType::Ident, "expected enum variant");
        p2 = p3;
        if not ok2:
            out (p2, en);
        end

        val = next_val;
        var (p4, has_val) = match_tok(p2, TokType::Assign);
        if has_val:
            var (p5, vt, _) = expect_tok(p4, TokType::Int, "expected integer value");
            p2 = p5;
            val = vt.tok_ival;
        else
            p2 = p4;
        end
        next_val = val + 1;

        variant = ast_new(AstType::LiteralInt);
        variant.name = vname.str_val;
        variant.int_val = val;
        variant.line = vname.line;
        en = ast_add_child(en, variant);
        var (p6, _) = match_tok(p2, TokType::Semicolon);
        p2 = p6;
        p2 = skip_newlines(p2);
    end

    var (p3, _, _) = expect_tok(p2, TokType::End, "expected 'end' after enum");
    var (p3b, _) = match_tok(p3, TokType::Dot);
    out (p3b, en);
end

func parse_entity_def:
    in(p:Parser)
    line = peek(p).line;
    var (p2, name_tok, ok) = expect_tok(p, TokType::Ident, "expected entity name");
    if not ok:
        out (p2, ast_new(AstType::EntityDef));
    end

    p2 = skip_newlines(p2);

    var (p2b, _) = match_tok(p2, TokType::Colon);
    p2 = p2b;
    p2 = skip_newlines(p2);

    ed = ast_new(AstType::EntityDef);
    ed.name = name_tok.str_val;
    ed.line = line;

    when not check(p2, TokType::End) and not check(p2, TokType::Eof) loop
        var (p3, fname, ok2) = expect_tok(p2, TokType::Ident, "expected field name");
        p2 = p3;
        if not ok2:
            out (p2, ed);
        end

        field = ast_new(AstType::Identifier);
        field.name = fname.str_val;
        field.line = fname.line;

        var (p4, has_colon) = match_tok(p2, TokType::Colon);
        if has_colon:
            if check(p4, TokType::Ident):
                var (p5, type_tok) = advance(p4);
                field.name2 = type_tok.str_val;
                p2 = p5;
            else
                p2 = p4;
            end
        else
            p2 = p4;
        end

        ed = ast_add_child(ed, field);
        var (p6, _) = match_tok(p2, TokType::Semicolon);
        p2 = p6;
        p2 = skip_newlines(p2);
    end

    var (p3, _, _) = expect_tok(p2, TokType::End, "expected 'end' after entity");
    var (p3b, _) = match_tok(p3, TokType::Dot);
    out (p3b, ed);
end

func parse_statement:
    in(p:Parser)
    p = skip_newlines(p);
    t = peek(p);

    if t.tok_type == TokType::Extern:
        var (p2, _) = advance(p);
        if check(p2, TokType::Func):
            var (p3, _) = advance(p2);
            var (p4, name_tok, ok) = expect_tok(p3, TokType::Ident, "expected function name after extern func");
            n = ast_new(AstType::ExternFunc);
            n.name = name_tok.str_val;
            n.line = t.line;
            when not check(p4, TokType::Semicolon) and not check(p4, TokType::Newline) and not check(p4, TokType::Eof) loop
                var (p5, _) = advance(p4);
                p4 = p5;
            end
            var (p5, _) = match_tok(p4, TokType::Semicolon);
            out (p5, n);
        end
        when not check(p2, TokType::Newline) and not check(p2, TokType::Eof) loop
            var (p3, _) = advance(p2);
            p2 = p3;
        end
        out (p2, ast_new(AstType::ExternFunc));
    end

    if t.tok_type == TokType::Func:
        var (p2, _) = advance(p);
        out parse_func_def(p2);
    end

    if t.tok_type == TokType::Var:
        var (p2, _) = advance(p);
        out parse_var_decl(p2, false);
    end

    if t.tok_type == TokType::Const:
        var (p2, _) = advance(p);
        out parse_var_decl(p2, true);
    end

    if t.tok_type == TokType::If:
        var (p2, _) = advance(p);
        out parse_if_stmt(p2);
    end

    if t.tok_type == TokType::Loop:
        var (p2, _) = advance(p);
        out parse_loop_stmt(p2);
    end

    if t.tok_type == TokType::While or t.tok_type == TokType::When:
        var (p2, _) = advance(p);
        out parse_while_stmt(p2);
    end

    if t.tok_type == TokType::For:
        var (p2, _) = advance(p);
        out parse_for_range_stmt(p2);
    end

    if t.tok_type == TokType::Enum:
        var (p2, _) = advance(p);
        out parse_enum_def(p2);
    end

    if t.tok_type == TokType::Entity:
        var (p2, _) = advance(p);
        out parse_entity_def(p2);
    end

    if t.tok_type == TokType::Out:
        var (p2, _) = advance(p);
        out parse_return_stmt(p2);
    end

    if t.tok_type == TokType::Print:
        var (p2, _) = advance(p);
        out parse_print_stmt(p2);
    end

    if t.tok_type == TokType::Break:
        var (p2, _) = advance(p);
        n = ast_new(AstType::BreakStmt);
        n.line = t.line;
        out (p2, n);
    end

    if t.tok_type == TokType::Skip:
        var (p2, _) = advance(p);
        n = ast_new(AstType::ContinueStmt);
        n.line = t.line;
        out (p2, n);
    end

    if t.tok_type == TokType::Import:
        var (p2, _) = advance(p);
        var (p3, first_tok, ok) = expect_tok(p2, TokType::Ident, "expected name after import");
        if not ok:
            out (p3, ast_new(AstType::ImportStmt));
        end
        names = vec_new_rt();
        names = vec_push_rt(names, first_tok.str_val);
        p4 = p3;
        when check(p4, TokType::Comma) loop
            var (p5, _) = advance(p4);
            p5 = skip_newlines(p5);
            var (p6, sym, _) = expect_tok(p5, TokType::Ident, "expected symbol name");
            names = vec_push_rt(names, sym.str_val);
            p4 = p6;
        end
        if check(p4, TokType::From):
            var (p5, _) = advance(p4);
            var (p6, mod_tok, _) = expect_tok(p5, TokType::Ident, "expected module name after 'from'");
            n = ast_new(AstType::ImportStmt);
            n.name = mod_tok.str_val;
            n.line = t.line;
            ni = 0;
            when ni < vec_len_rt(names) loop
                s = ast_new(AstType::Identifier);
                s.name = vec_get_rt(names, ni);
                n = ast_add_child(n, s);
                ni = ni + 1;
            end
            var (p7, _) = match_tok(p6, TokType::Semicolon);
            out (p7, n);
        end
        n = ast_new(AstType::ImportStmt);
        n.name = first_tok.str_val;
        n.line = t.line;
        var (p5, has_as) = match_tok(p4, TokType::As);
        if has_as:
            var (p6, alias, _) = expect_tok(p5, TokType::Ident, "expected alias");
            n.name2 = alias.str_val;
            out (p6, n);
        end
        out (p5, n);
    end

    if t.tok_type == TokType::From:
        var (p2, _) = advance(p);
        var (p3, mod_tok, ok) = expect_tok(p2, TokType::Ident, "expected module name");
        if not ok:
            out (p3, ast_new(AstType::ImportStmt));
        end
        var (p4, _, _) = expect_tok(p3, TokType::Import, "expected 'import'");
        n = ast_new(AstType::ImportStmt);
        n.name = mod_tok.str_val;
        n.line = t.line;
        should_loop = true;
        when should_loop loop
            var (p5, sym, _) = expect_tok(p4, TokType::Ident, "expected symbol name");
            p4 = p5;
            s = ast_new(AstType::Identifier);
            s.name = sym.str_val;
            s.line = sym.line;
            n = ast_add_child(n, s);
            var (p6, matched) = match_tok(p4, TokType::Comma);
            p4 = p6;
            if not matched:
                should_loop = false;
            end
        end
        out (p4, n);
    end

    if t.tok_type == TokType::Module:
        var (p2, _) = advance(p);
        var (p3, mod_tok, _) = expect_tok(p2, TokType::Ident, "expected module name");
        mod_path = mod_tok.str_val;
        when check(p3, TokType::DoubleColon) loop
            var (p4, _) = advance(p3);
            var (p5, seg, _) = expect_tok(p4, TokType::Ident, "expected name after '::'");
            mod_path = mod_path + "::" + seg.str_val;
            p3 = p5;
        end
        n = ast_new(AstType::ModuleStmt);
        n.name = mod_path;
        n.line = t.line;
        var (p4, _) = match_tok(p3, TokType::Semicolon);
        out (p4, n);
    end

    if t.tok_type == TokType::Export:
        var (p2, _) = advance(p);
        var (p3, fn_tok, _) = expect_tok(p2, TokType::Ident, "expected function name after export");
        n = ast_new(AstType::ExportStmt);
        n.name = fn_tok.str_val;
        n.line = t.line;
        out (p3, n);
    end

    if t.tok_type == TokType::Include:
        var (p2, _) = advance(p);
        n = ast_new(AstType::IncludeStmt);
        n.line = t.line;
        if check(p2, TokType::Str):
            var (p3, file_tok, _) = expect_tok(p2, TokType::Str, "expected filename after include");
            n.name = file_tok.str_val;
            p2 = p3;
        else
            var (p3, id_tok, _) = expect_tok(p2, TokType::Ident, "expected module name after include");
            path = id_tok.str_val;
            p2 = p3;
            when check(p2, TokType::DoubleColon) loop
                var (p4, _) = advance(p2);
                var (p5, seg, _) = expect_tok(p4, TokType::Ident, "expected name after '::'");
                path = path + "::" + seg.str_val;
                p2 = p5;
            end
            n.name = path;
        end
        var (p3, _) = match_tok(p2, TokType::Semicolon);
        out (p3, n);
    end

    if t.tok_type == TokType::CheckCpu:
        var (p2, _) = advance(p);
        n = ast_new(AstType::CheckCpu);
        n.line = t.line;
        out (p2, n);
    end

    if t.tok_type == TokType::Patch:
        var (p2, _) = advance(p);
        n = ast_new(AstType::PatchPoint);
        n.line = t.line;
        out (p2, n);
    end

    if t.tok_type == TokType::Ident:
        save_pos = p.pos;
        p.pos = p.pos + 1;
        next_type = peek(p).tok_type;
        p.pos = save_pos;
        if next_type == TokType::LParen:
            out parse_expr(p);
        end

        var (p2, id_tok) = advance(p);

        if check(p, TokType::Assign):
            var (p3, _) = advance(p);
            var (p4, val) = parse_expr(p3);
            assign = ast_new(AstType::Assign);
            assign.name = id_tok.str_val;
            assign.line = id_tok.line;
            assign = ast_add_child(assign, val);
            out (p4, assign);
        end

        if check(p, TokType::Dot):
            var (p3, _) = advance(p);
            var (p4, field_tok, ok) = expect_tok(p3, TokType::Ident, "expected field name");
            if ok and check(p4, TokType::Assign):
                var (p5, _) = advance(p4);
                var (p6, val) = parse_expr(p5);
                fa = ast_new(AstType::FieldAssign);
                fa.name = id_tok.str_val;
                fa.line = id_tok.line;
                fa = ast_add_child(fa, val);
                fa.name2 = field_tok.str_val;
                out (p6, fa);
            end
            p2 = p;
            var (p5, expr) = parse_expr(p2);
            out (p5, expr);
        end

        if check(p, TokType::LBracket):
            var (p3, _) = advance(p);
            var (p4, idx_expr) = parse_expr(p3);
            var (p5, _, _) = expect_tok(p4, TokType::RBracket, "expected ']'");
            if check(p5, TokType::Assign):
                var (p6, _) = advance(p5);
                var (p7, val) = parse_expr(p6);
                ia = ast_new(AstType::IndexAssign);
                ia.name = id_tok.str_val;
                ia.line = id_tok.line;
                ia = ast_add_child(ia, idx_expr);
                ia = ast_add_child(ia, val);
                out (p7, ia);
            end
            acc = ast_new(AstType::IndexAccess);
            acc.name = id_tok.str_val;
            acc.line = id_tok.line;
            acc = ast_add_child(acc, idx_expr);
            out (p5, acc);
        end

        p.pos = p.pos - 1;
        var (p3, expr) = parse_expr(p);
        out (p3, expr);
    end

    is_terminator = t.tok_type == TokType::Eof or t.tok_type == TokType::End or;
                    t.tok_type == TokType::Else or t.tok_type == TokType::Eif;
    if is_terminator:
        out (p, ast_new(AstType::LiteralInt));
    end

    out parse_expr(p);
end

func parse_program:
    in(p:Parser)
    prog = ast_new(AstType::Program);
    p = skip_newlines(p);

    when not check(p, TokType::Eof) loop
        var (p2, stmt) = parse_statement(p);
        p = p2;
        if rt_strlen(p.error_msg) > 0:
            p.error_msg = "";
            when not check(p, TokType::Eof) and not check(p, TokType::Func) and not check(p, TokType::Enum) and not check(p, TokType::Entity) and not check(p, TokType::Const) and not check(p, TokType::Var) and not check(p, TokType::Extern) and not check(p, TokType::Import) loop
                var (p3, _) = advance(p);
                p = p3;
            end
        else
            prog = ast_add_child(prog, stmt);
        end
        p = skip_newlines(p);
    end

    out (p, prog);
end

# -- END vir/compiler/parser.vri --

# -- BEGIN vir/compiler/ir_optimizer.vri --

enum QOp:
    Nop             = 0;
    Load            = 1;
    Move            = 2;
    Add             = 3;
    Sub             = 4;
    Mul             = 5;
    Div             = 6;
    Mod             = 7;
    And             = 8;
    Or              = 9;
    Xor             = 10;
    Shl             = 11;
    Shr             = 12;
    CmpEq           = 20;
    CmpNe           = 21;
    CmpGt           = 22;
    CmpLt           = 23;
    CmpGe           = 24;
    CmpLe           = 25;
    Jump            = 30;
    JumpIfNot       = 31;
    Label           = 32;
    Call            = 33;
    CallFunc        = 34;
    Ret             = 35;
    Print           = 40;
    PrintStr        = 41;
    Input           = 42;
    Alloc           = 50;
    Free            = 51;
    LoadByte        = 52;
    StoreByte       = 53;
    LoadWord        = 54;
    StoreWord       = 55;
    ArrNew          = 60;
    ArrPush         = 61;
    ArrGet          = 62;
    ArrSet          = 63;
    ArrLen          = 64;
    StrLenOp        = 70;
    StrGet          = 71;
    StrCat          = 72;
    StrEq           = 73;
    IToStr          = 74;
    StrToI          = 75;
    FileOpen        = 80;
    FileRead        = 81;
    FileWrite       = 82;
    FileClose       = 83;
    FileWriteByte   = 84;
    Exit            = 90;
    PatchPoint      = 91;
    LoadGlobal      = 92;
    StoreGlobal     = 93;
    GetArg          = 94;
    ArgCount        = 95;
    SetArg          = 96;
    LoadFuncAddr    = 97;
end

enum OperandType:
    None        = 0;
    VReg        = 1;
    Immediate   = 2;
    LabelRef    = 3;
    StringRef   = 4;
    FuncIdx     = 5;
end

entity QOperand:
    op_type:    OperandType;
    vreg:       int;
    imm_val:    int;
end

func q_none:
    out QOperand ( op_type: OperandType::None, vreg: 0, imm_val: 0 );
end

func q_vreg:
    in(r:int)
    out QOperand ( op_type: OperandType::VReg, vreg: r, imm_val: 0 );
end

func q_imm:
    in(val:int)
    out QOperand ( op_type: OperandType::Immediate, vreg: 0, imm_val: val );
end

func q_label:
    in(id:int)
    out QOperand ( op_type: OperandType::LabelRef, vreg: id, imm_val: 0 );
end

func q_str_ref:
    in(idx:int)
    out QOperand ( op_type: OperandType::StringRef, vreg: idx, imm_val: 0 );
end

func q_func_idx:
    in(idx:int)
    out QOperand ( op_type: OperandType::FuncIdx, vreg: idx, imm_val: 0 );
end

entity QInstr:
    opcode:     QOp;
    dest:       QOperand;
    src1:       QOperand;
    src2:       QOperand;
    patch_id:   int;
end

func q_instr:
    in(op:QOp; d:QOperand; s1:QOperand; s2:QOperand)
    out QInstr ( opcode: op, dest: d, src1: s1, src2: s2, patch_id: 0 );
end

entity QFunction:
    name:           string;
    body:           Vec<QInstr>;
    param_count:    int;
    param_vregs:    Vec<int>;
end

func q_func_new:
    in(name:string)
    out QFunction (;
        name:        name,;
        body:        vec_new_rt(),;
        param_count: 0,;
        param_vregs: vec_new_rt()
    );
end

func q_func_emit:
    in(f:QFunction; instr:QInstr)
    f.body = vec_push_rt(f.body, instr);
    out f;
end

entity QModule:
    name:       string;
    functions:  Vec<QFunction>;
    strings:    Vec<string>;
end

func q_module_new:
    in(name:string)
    out QModule (;
        name:       name,;
        functions:  vec_new_rt(),;
        strings:    vec_new_rt()
    );
end

func q_module_add_func:
    in(m:QModule; name:string)
    f = q_func_new(name);
    m.functions = vec_push_rt(m.functions, f);
    idx = vec_len_rt(m.functions) - 1;
    out (m, idx >> int);
end

func q_module_add_string:
    in(m:QModule; s:string)
    i = 0;
    when i < vec_len_rt(m.strings) loop
        if str_eq(vec_get_rt(m.strings, i), s):
            out (m, i >> int);
        end
        i = i + 1;
    end
    m.strings = vec_push_rt(m.strings, s);
    out (m, (vec_len_rt(m.strings) - 1) >> int);
end

entity SymEntry:
    name:       string;
    vreg:       int;
end

entity SymTable:
    entries:    Vec<SymEntry>;
end

func sym_new:
    out SymTable ( entries: vec_new_rt() );
end

func sym_define:
    in(st:SymTable; name:string; vreg:int)
    i = 0;
    when i < vec_len_rt(st.entries) loop
        entry = vec_get_rt(st.entries, i);
        if str_eq(entry.name, name):
            entry.vreg = vreg;
            vec_set_rt(st.entries, i, entry);
            out st;
        end
        i = i + 1;
    end
    st.entries = vec_push_rt(st.entries, SymEntry ( name: name, vreg: vreg ));
    out st;
end

func sym_lookup:
    in(st:SymTable; name:string)
    i = 0;
    when i < vec_len_rt(st.entries) loop
        entry = vec_get_rt(st.entries, i);
        if str_eq(entry.name, name):
            out (true, entry.vreg);
        end
        i = i + 1;
    end
    out (false, 0);
end

entity EnumVariant:
    name:   string;
    value:  int;
end

entity EnumType:
    name:       string;
    variants:   Vec<EnumVariant>;
end

entity EntityField:
    name:   string;
    offset: int;
end

entity EntityType:
    name:       string;
    fields:     Vec<EntityField>;
end

func find_enum_type:
    in(types:Vec<EnumType>; name:string)
    i = 0;
    when i < vec_len_rt(types) loop
        et = vec_get_rt(types, i);
        if str_eq(et.name, name):
            out (true, i);
        end
        i = i + 1;
    end
    out (false, -1);
end

func enum_lookup_variant:
    in(et:EnumType; variant:string)
    i = 0;
    when i < vec_len_rt(et.variants) loop
        v = vec_get_rt(et.variants, i);
        if str_eq(v.name, variant):
            out (true, v.value);
        end
        i = i + 1;
    end
    out (false, 0);
end

func find_entity_type:
    in(types:Vec<EntityType>; name:string)
    i = 0;
    when i < vec_len_rt(types) loop
        et = vec_get_rt(types, i);
        if str_eq(et.name, name):
            out (true, i);
        end
        i = i + 1;
    end
    out (false, -1);
end

func entity_field_offset:
    in(et:EntityType; field:string)
    i = 0;
    when i < vec_len_rt(et.fields) loop
        f = vec_get_rt(et.fields, i);
        if str_eq(f.name, field):
            out (true, f.offset >> int);
        end
        i = i + 1;
    end
    out (false, -1);
end

func find_ent_flat:
    in(names:Vec<string>; name:string)
    i = 0;
    when i < vec_len_rt(names) loop
        n = vec_get_rt(names, i);
        if str_eq(n, name):
            out (true, i);
        end
        i = i + 1;
    end
    out (false, -1);
end

func ent_field_offset_flat:
    in(field_names:Vec<string>; field_offsets:Vec<int>; field_counts:Vec<int>; eidx:int; field:string)
    start = 0;
    j = 0;
    when j < eidx loop
        start = start + vec_get_rt(field_counts, j);
        j = j + 1;
    end
    count = vec_get_rt(field_counts, eidx);
    i = 0;
    when i < count loop
        fn = vec_get_rt(field_names, start + i);
        if str_eq(fn, field):
            out (true, vec_get_rt(field_offsets, start + i));
        end
        i = i + 1;
    end
    out (false, -1);
end

func ent_field_count_flat:
    in(field_counts:Vec<int>; eidx:int)
    out vec_get_rt(field_counts, eidx);
end

entity LowerCtx:
    module:             QModule;
    next_vreg:          int;
    label_counter:      int;
    symbols:            SymTable;
    global_symbols:     SymTable;
    global_idx_counter: int;
    enum_types:         Vec<EnumType>;
    entity_types:       Vec<EntityType>;
    ent_names:          Vec<string>;
    ent_field_names:    Vec<string>;
    ent_field_offsets:  Vec<int>;
    ent_field_counts:   Vec<int>;
    current_func_idx:   int;
    loop_depth:         int;
    loop_start_labels:  Vec<int>;
    loop_end_labels:    Vec<int>;
    error_count:        int;
    last_error:         string;
    patch_counter:      int;
end

func lower_ctx_new:
    in(mod_name:string)
    out LowerCtx (;
        module:             q_module_new(mod_name),;
        next_vreg:          0,;
        label_counter:      0,;
        symbols:            sym_new(),;
        global_symbols:     sym_new(),;
        global_idx_counter: 0,;
        enum_types:         vec_new_rt(),;
        entity_types:       vec_new_rt(),;
        ent_names:          vec_new_rt(),;
        ent_field_names:    vec_new_rt(),;
        ent_field_offsets:  vec_new_rt(),;
        ent_field_counts:   vec_new_rt(),;
        current_func_idx:   -1,;
        loop_depth:         0,;
        loop_start_labels:  vec_new_rt(),;
        loop_end_labels:    vec_new_rt(),;
        error_count:        0,;
        last_error:         str_new(""),;
        patch_counter:      0
    );
end

func fresh_vreg:
    in(ctx:LowerCtx)
    r = ctx.next_vreg;
    ctx.next_vreg = ctx.next_vreg + 1;
    out (ctx, r);
end

func fresh_label:
    in(ctx:LowerCtx)
    l = ctx.label_counter;
    ctx.label_counter = ctx.label_counter + 1;
    out (ctx, l);
end

func lower_error:
    in(ctx:LowerCtx; msg:string)
    ctx.last_error = msg;
    ctx.error_count = ctx.error_count + 1;
    out ctx;
end

func emit:
    in(ctx:LowerCtx; instr:QInstr)
    if ctx.current_func_idx >= 0:
        f = vec_get_rt(ctx.module.functions, ctx.current_func_idx);
        f = q_func_emit(f, instr);
        vec_set_rt(ctx.module.functions, ctx.current_func_idx, f);
    end
    out ctx;
end

func sym_lookup_both:
    in(ctx:LowerCtx; name:string)
    var (found, vreg) = sym_lookup(ctx.symbols, name);
    if found:
        out (0, vreg);
    end
    var (found2, idx) = sym_lookup(ctx.global_symbols, name);
    if found2:
        out (1, idx);
    end
    out (-1, 0);
end

func find_func_index:
    in(ctx:LowerCtx; name:string)
    i = 0;
    when i < vec_len_rt(ctx.module.functions) loop
        f = vec_get_rt(ctx.module.functions, i);
        if str_eq(f.name, name):
            out i >> int;
        end
        i = i + 1;
    end
    out -1;
end

func lower_expr:
    in(ctx:LowerCtx; expr:AstNode)
    if expr.node_type == AstType::LiteralInt:
        var (ctx2, r) = fresh_vreg(ctx);
        ctx2 = emit(ctx2, q_instr(QOp::Load, q_vreg(r), q_imm(expr.int_val), q_none()));
        out (ctx2, r >> int);
    end

    if expr.node_type == AstType::LiteralFloat:
        var (ctx2, r) = fresh_vreg(ctx);
        ctx2 = emit(ctx2, q_instr(QOp::Load, q_vreg(r), q_imm(expr.float_val >> int), q_none()));
        out (ctx2, r >> int);
    end

    if expr.node_type == AstType::LiteralStr:
        var (ctx2, str_idx) = q_module_add_string(ctx.module, expr.name);
        ctx.module = ctx2;
        var (ctx3, r) = fresh_vreg(ctx);
        ctx3 = emit(ctx3, q_instr(QOp::Load, q_vreg(r), q_str_ref(str_idx), q_none()));
        out (ctx3, r >> int);
    end

    if expr.node_type == AstType::Identifier:
        var (scope, idx) = sym_lookup_both(ctx, expr.name);
        if scope < 0:
            fidx = find_func_index(ctx, expr.name);
            if fidx >= 0:
                var (ctx2, rd) = fresh_vreg(ctx);
                ctx2 = emit(ctx2, q_instr(QOp::LoadFuncAddr, q_vreg(rd), q_func_idx(fidx >> int), q_none()));
                out (ctx2, rd >> int);
            end
            ctx = lower_error(ctx, str_concat(str_new("undefined variable: "), expr.name));
            out (ctx, -1);
        end
        if scope == 1:
            var (ctx2, rd) = fresh_vreg(ctx);
            ctx2 = emit(ctx2, q_instr(QOp::LoadGlobal, q_vreg(rd), q_imm(idx >> int), q_none()));
            out (ctx2, rd >> int);
        end
        out (ctx, idx >> int);
    end

    if expr.node_type == AstType::BinOp:
        var (ctx2, lhs) = lower_expr(ctx, vec_get_rt(expr.children, 0));
        if lhs < 0:
            out (ctx2, -1);
        end
        var (ctx3, rhs) = lower_expr(ctx2, vec_get_rt(expr.children, 1));
        if rhs < 0:
            out (ctx3, -1);
        end
        var (ctx4, rd) = fresh_vreg(ctx3);
        op = QOp::Add;
        if expr.op == OpType::Sub:
            op = QOp::Sub;
        end
        if expr.op == OpType::Mul:
            op = QOp::Mul;
        end
        if expr.op == OpType::Div:
            op = QOp::Div;
        end
        if expr.op == OpType::ModOp:
            op = QOp::Mod;
        end
        if expr.op == OpType::AndOp:
            op = QOp::And;
        end
        if expr.op == OpType::OrOp:
            op = QOp::Or;
        end
        if expr.op == OpType::XorOp:
            op = QOp::Xor;
        end
        if expr.op == OpType::ShlOp:
            op = QOp::Shl;
        end
        if expr.op == OpType::ShrOp:
            op = QOp::Shr;
        end
        ctx4 = emit(ctx4, q_instr(op, q_vreg(rd), q_vreg(lhs >> int), q_vreg(rhs >> int)));
        out (ctx4, rd >> int);
    end

    if expr.node_type == AstType::Compare:
        var (ctx2, lhs) = lower_expr(ctx, vec_get_rt(expr.children, 0));
        if lhs < 0:
            out (ctx2, -1);
        end
        var (ctx3, rhs) = lower_expr(ctx2, vec_get_rt(expr.children, 1));
        if rhs < 0:
            out (ctx3, -1);
        end
        var (ctx4, rd) = fresh_vreg(ctx3);

        if expr.op == OpType::Ne:
            var (ctx5, eq_r) = fresh_vreg(ctx4);
            var (ctx6, one_r) = fresh_vreg(ctx5);
            ctx6 = emit(ctx6, q_instr(QOp::CmpEq, q_vreg(eq_r), q_vreg(lhs >> int), q_vreg(rhs >> int)));
            ctx6 = emit(ctx6, q_instr(QOp::Load, q_vreg(one_r), q_imm(1), q_none()));
            ctx6 = emit(ctx6, q_instr(QOp::Xor, q_vreg(rd), q_vreg(eq_r), q_vreg(one_r)));
            out (ctx6, rd >> int);
        end

        cmp_op = QOp::CmpEq;
        if expr.op == OpType::Gt:
            cmp_op = QOp::CmpGt;
        end
        if expr.op == OpType::Lt:
            cmp_op = QOp::CmpLt;
        end
        if expr.op == OpType::Ge:
            cmp_op = QOp::CmpGe;
        end
        if expr.op == OpType::Le:
            cmp_op = QOp::CmpLe;
        end
        ctx4 = emit(ctx4, q_instr(cmp_op, q_vreg(rd), q_vreg(lhs >> int), q_vreg(rhs >> int)));
        out (ctx4, rd >> int);
    end

    if expr.node_type == AstType::Call:
        fidx = find_func_index(ctx, expr.name);
        is_indirect = 0;
        indirect_vreg = -1;
        if fidx < 0:
            var (scope, varvreg) = sym_lookup_both(ctx, expr.name);
            if scope < 0:
                ctx = lower_error(ctx, str_concat(str_new("undefined function: "), expr.name));
                var (ctx2, rd) = fresh_vreg(ctx);
                ctx2 = emit(ctx2, q_instr(QOp::Load, q_vreg(rd), q_imm(0), q_none()));
                out (ctx2, rd >> int);
            end
            is_indirect = 1;
            indirect_vreg = varvreg >> int;
            if scope == 1:
                var (ctxg, grd) = fresh_vreg(ctx);
                ctxg = emit(ctxg, q_instr(QOp::LoadGlobal, q_vreg(grd), q_imm(varvreg >> int), q_none()));
                ctx = ctxg;
                indirect_vreg = grd >> int;
            end
        end

        arg_vregs = vec_new_rt();
        i = 0;
        when i < vec_len_rt(expr.children) loop
            var (ctx2, av) = lower_expr(ctx, vec_get_rt(expr.children, i));
            ctx = ctx2;
            if av < 0:
                out (ctx, -1);
            end
            arg_vregs = vec_push_rt(arg_vregs, av);
            i = i + 1;
        end

        i = 0;
        when i < vec_len_rt(arg_vregs) loop
            av = vec_get_rt(arg_vregs, i);
            ctx = emit(ctx, q_instr(QOp::SetArg, q_imm(i >> int), q_vreg(av >> int), q_none()));
            i = i + 1;
        end

        var (ctx3, rd) = fresh_vreg(ctx);
        if is_indirect == 1:
            ctx3 = emit(ctx3, q_instr(QOp::CallFunc, q_vreg(rd), q_vreg(indirect_vreg), q_none()));
            out (ctx3, rd >> int);
        end
        ctx3 = emit(ctx3, q_instr(QOp::CallFunc, q_vreg(rd), q_func_idx(fidx >> int), q_none()));
        out (ctx3, rd >> int);
    end

    if expr.node_type == AstType::BuiltinCall:
        bid = expr.builtin_id;
        arg_vregs = vec_new_rt();
        i = 0;
        when i < vec_len_rt(expr.children) loop
            var (ctx2, av) = lower_expr(ctx, vec_get_rt(expr.children, i));
            ctx = ctx2;
            arg_vregs = vec_push_rt(arg_vregs, av);
            i = i + 1;
        end

        nargs = vec_len_rt(expr.children);
        a0 = -1;
        a1 = -1;
        a2 = -1;
        if nargs > 0:
            a0 = vec_get_rt(arg_vregs, 0);
        end
        if nargs > 1:
            a1 = vec_get_rt(arg_vregs, 1);
        end
        if nargs > 2:
            a2 = vec_get_rt(arg_vregs, 2);
        end

        if bid == 21:
            if nargs == 0:
                var (ctx3, cr) = fresh_vreg(ctx);
                ctx = ctx3;
                ctx = emit(ctx, q_instr(QOp::Load, q_vreg(cr), q_imm(16), q_none()));
                a0 = cr;
            end
            var (ctx4, rd) = fresh_vreg(ctx);
            ctx4 = emit(ctx4, q_instr(QOp::ArrNew, q_vreg(rd), q_vreg(a0 >> int), q_none()));
            out (ctx4, rd >> int);
        end

        if bid == 2:
            ctx = emit(ctx, q_instr(QOp::ArrPush, q_none(), q_vreg(a0 >> int), q_vreg(a1 >> int)));
            out (ctx, a0);
        end

        if bid == 1:
            var (ctx2, rd) = fresh_vreg(ctx);
            ctx2 = emit(ctx2, q_instr(QOp::ArrLen, q_vreg(rd), q_vreg(a0 >> int), q_none()));
            out (ctx2, rd >> int);
        end

        if bid == 3:
            var (ctx2, rd) = fresh_vreg(ctx);
            ctx2 = emit(ctx2, q_instr(QOp::Alloc, q_vreg(rd), q_vreg(a0 >> int), q_none()));
            out (ctx2, rd >> int);
        end

        if bid == 7:
            var (ctx2, rd) = fresh_vreg(ctx);
            ctx2 = emit(ctx2, q_instr(QOp::LoadWord, q_vreg(rd), q_vreg(a0 >> int), q_vreg(a1 >> int)));
            out (ctx2, rd >> int);
        end

        if bid == 8:
            ctx = emit(ctx, q_instr(QOp::StoreWord, q_vreg(a2 >> int), q_vreg(a0 >> int), q_vreg(a1 >> int)));
            out (ctx, 0);
        end

        if bid == 5:
            var (ctx2, rd) = fresh_vreg(ctx);
            ctx2 = emit(ctx2, q_instr(QOp::LoadByte, q_vreg(rd), q_vreg(a0 >> int), q_vreg(a1 >> int)));
            out (ctx2, rd >> int);
        end

        if bid == 6:
            ctx = emit(ctx, q_instr(QOp::StoreByte, q_vreg(a2 >> int), q_vreg(a0 >> int), q_vreg(a1 >> int)));
            out (ctx, 0);
        end

        if bid == 11:
            var (ctx2, rd) = fresh_vreg(ctx);
            ctx2 = emit(ctx2, q_instr(QOp::StrCat, q_vreg(rd), q_vreg(a0 >> int), q_vreg(a1 >> int)));
            out (ctx2, rd >> int);
        end

        if bid == 9:
            var (ctx2, rd) = fresh_vreg(ctx);
            ctx2 = emit(ctx2, q_instr(QOp::StrLenOp, q_vreg(rd), q_vreg(a0 >> int), q_none()));
            out (ctx2, rd >> int);
        end

        if bid == 12:
            var (ctx2, rd) = fresh_vreg(ctx);
            ctx2 = emit(ctx2, q_instr(QOp::StrEq, q_vreg(rd), q_vreg(a0 >> int), q_vreg(a1 >> int)));
            out (ctx2, rd >> int);
        end

        if bid == 10:
            var (ctx2, rd) = fresh_vreg(ctx);
            ctx2 = emit(ctx2, q_instr(QOp::StrGet, q_vreg(rd), q_vreg(a0 >> int), q_vreg(a1 >> int)));
            out (ctx2, rd >> int);
        end

        if bid == 22:
            ctx = emit(ctx, q_instr(QOp::PrintStr, q_vreg(a0 >> int), q_none(), q_none()));
            out (ctx, 0);
        end

        if bid == 18:
            ctx = emit(ctx, q_instr(QOp::Exit, q_none(), q_vreg(a0 >> int), q_none()));
            out (ctx, 0);
        end

        if bid == 19:
            var (ctx2, rd) = fresh_vreg(ctx);
            ctx2 = emit(ctx2, q_instr(QOp::IToStr, q_vreg(rd), q_vreg(a0 >> int), q_none()));
            out (ctx2, rd >> int);
        end

        if bid == 20:
            var (ctx2, rd) = fresh_vreg(ctx);
            ctx2 = emit(ctx2, q_instr(QOp::StrToI, q_vreg(rd), q_vreg(a0 >> int), q_none()));
            out (ctx2, rd >> int);
        end

        if bid == 4:
            ctx = emit(ctx, q_instr(QOp::Free, q_none(), q_vreg(a0 >> int), q_none()));
            out (ctx, 0);
        end

        if bid == 23:
            var (ctx2, rd) = fresh_vreg(ctx);
            ctx2 = emit(ctx2, q_instr(QOp::GetArg, q_vreg(rd), q_vreg(a0 >> int), q_none()));
            out (ctx2, rd >> int);
        end

        if bid == 24:
            var (ctx2, rd) = fresh_vreg(ctx);
            ctx2 = emit(ctx2, q_instr(QOp::ArgCount, q_vreg(rd), q_none(), q_none()));
            out (ctx2, rd >> int);
        end

        if bid == 13:
            var (ctx2, rd) = fresh_vreg(ctx);
            ctx2 = emit(ctx2, q_instr(QOp::FileOpen, q_vreg(rd), q_vreg(a0 >> int), q_vreg(a1 >> int)));
            out (ctx2, rd >> int);
        end
        if bid == 14:
            var (ctx2, rd) = fresh_vreg(ctx);
            ctx2 = emit(ctx2, q_instr(QOp::FileRead, q_vreg(rd), q_vreg(a0 >> int), q_vreg(a1 >> int)));
            out (ctx2, rd >> int);
        end
        if bid == 15:
            var (ctx2, rd) = fresh_vreg(ctx);
            ctx2 = emit(ctx2, q_instr(QOp::FileWrite, q_vreg(rd), q_vreg(a0 >> int), q_vreg(a1 >> int)));
            out (ctx2, rd >> int);
        end
        if bid == 16:
            ctx = emit(ctx, q_instr(QOp::FileClose, q_none(), q_vreg(a0 >> int), q_none()));
            out (ctx, 0);
        end
        if bid == 17:
            ctx = emit(ctx, q_instr(QOp::FileWriteByte, q_none(), q_vreg(a0 >> int), q_vreg(a1 >> int)));
            out (ctx, 0);
        end

        ctx = lower_error(ctx, str_new("unknown builtin"));
        out (ctx, -1);
    end

    if expr.node_type == AstType::InputExpr:
        var (ctx2, rd) = fresh_vreg(ctx);
        ctx2 = emit(ctx2, q_instr(QOp::Input, q_vreg(rd), q_none(), q_none()));
        out (ctx2, rd >> int);
    end

    if expr.node_type == AstType::ArrayLiteral:
        var (ctx2, cap_r) = fresh_vreg(ctx);
        var (ctx3, arr_r) = fresh_vreg(ctx2);
        n = vec_len_rt(expr.children) >> int;
        cap = n;
        if cap < 16:
            cap = 16;
        end
        ctx3 = emit(ctx3, q_instr(QOp::Load, q_vreg(cap_r), q_imm(cap), q_none()));
        ctx3 = emit(ctx3, q_instr(QOp::ArrNew, q_vreg(arr_r), q_vreg(cap_r), q_none()));
        i = 0;
        when i < vec_len_rt(expr.children) loop
            var (ctx4, elem) = lower_expr(ctx3, vec_get_rt(expr.children, i));
            ctx3 = ctx4;
            if elem >= 0:
                ctx3 = emit(ctx3, q_instr(QOp::ArrPush, q_none(), q_vreg(arr_r), q_vreg(elem >> int)));
            end
            i = i + 1;
        end
        out (ctx3, arr_r >> int);
    end

    if expr.node_type == AstType::IndexAccess:
        var (scope, arr_idx) = sym_lookup_both(ctx, expr.name);
        if scope < 0:
            ctx = lower_error(ctx, str_new("undefined variable for index"));
            out (ctx, -1);
        end
        arr_vreg = arr_idx;
        if scope == 1:
            var (ctx2, gv) = fresh_vreg(ctx);
            ctx = ctx2;
            ctx = emit(ctx, q_instr(QOp::LoadGlobal, q_vreg(gv), q_imm(arr_idx >> int), q_none()));
            arr_vreg = gv;
        end
        var (ctx3, idx_v) = lower_expr(ctx, vec_get_rt(expr.children, 0));
        if idx_v < 0:
            out (ctx3, -1);
        end
        var (ctx4, rd) = fresh_vreg(ctx3);
        ctx4 = emit(ctx4, q_instr(QOp::ArrGet, q_vreg(rd), q_vreg(arr_vreg), q_vreg(idx_v >> int)));
        out (ctx4, rd >> int);
    end

    if expr.node_type == AstType::FieldAccess:
        base = vec_get_rt(expr.children, 0);
        if base.node_type == AstType::Identifier:
            var (found, eidx) = find_enum_type(ctx.enum_types, base.name);
            if found:
                et = vec_get_rt(ctx.enum_types, eidx);
                var (ok, val) = enum_lookup_variant(et, expr.name);
                if ok:
                    var (ctx2, r) = fresh_vreg(ctx);
                    ctx2 = emit(ctx2, q_instr(QOp::Load, q_vreg(r), q_imm(val), q_none()));
                    out (ctx2, r >> int);
                end
                ctx = lower_error(ctx, str_concat(str_new("unknown variant: "), expr.name));
                out (ctx, -1);
            end
        end

        var (ctx2, base_r) = lower_expr(ctx, vec_get_rt(expr.children, 0));
        if base_r < 0:
            out (ctx2, -1);
        end

        offset = -1;
        j = 0;
        when j < vec_len_rt(ctx2.ent_names) and offset < 0 loop
            var (ok, off) = ent_field_offset_flat(ctx2.ent_field_names, ctx2.ent_field_offsets, ctx2.ent_field_counts, j, expr.name);
            if ok:
                offset = off;
            end
            j = j + 1;
        end

        if offset < 0:
            ctx2 = lower_error(ctx2, str_concat(str_new("unknown field: "), expr.name));
            out (ctx2, -1);
        end

        var (ctx3, off_r) = fresh_vreg(ctx2);
        var (ctx4, rd) = fresh_vreg(ctx3);
        ctx4 = emit(ctx4, q_instr(QOp::Load, q_vreg(off_r), q_imm(offset >> int), q_none()));
        ctx4 = emit(ctx4, q_instr(QOp::LoadWord, q_vreg(rd), q_vreg(base_r >> int), q_vreg(off_r)));
        out (ctx4, rd >> int);
    end

    if expr.node_type == AstType::EntityLiteral:
        var (found, eidx) = find_ent_flat(ctx.ent_names, expr.name);
        if not found:
            ctx = lower_error(ctx, str_concat(str_new("undefined entity: "), expr.name));
            out (ctx, -1);
        end
        var (ctx2, sz_r) = fresh_vreg(ctx);
        var (ctx3, ptr_r) = fresh_vreg(ctx2);
        sz = ent_field_count_flat(ctx.ent_field_counts, eidx) * 8;
        ctx3 = emit(ctx3, q_instr(QOp::Load, q_vreg(sz_r), q_imm(sz), q_none()));
        ctx3 = emit(ctx3, q_instr(QOp::Alloc, q_vreg(ptr_r), q_vreg(sz_r), q_none()));

        i = 0;
        when i < vec_len_rt(expr.children) loop
            child = vec_get_rt(expr.children, i);
            var (ok, foff) = ent_field_offset_flat(ctx.ent_field_names, ctx.ent_field_offsets, ctx.ent_field_counts, eidx, child.name2);
            if ok:
                var (ctx4, val_r) = lower_expr(ctx3, child);
                ctx3 = ctx4;
                if val_r >= 0:
                    var (ctx5, off_r) = fresh_vreg(ctx3);
                    ctx3 = ctx5;
                    ctx3 = emit(ctx3, q_instr(QOp::Load, q_vreg(off_r), q_imm(foff), q_none()));
                    ctx3 = emit(ctx3, q_instr(QOp::StoreWord, q_vreg(val_r >> int), q_vreg(ptr_r), q_vreg(off_r)));
                end
            end
            i = i + 1;
        end
        out (ctx3, ptr_r >> int);
    end

    ctx = lower_error(ctx, str_new("unsupported expression type"));
    out (ctx, -1);
end

func lower_stmt:
    in(ctx:LowerCtx; stmt:AstNode)

    let ls_type = stmt.node_type >> int;

    if ls_type == 36:
        fidx = find_func_index(ctx, stmt.name);
        if fidx < 0:
            out ctx;
        end
        arg_count = vec_len_rt(stmt.children);
        if arg_count > 0:
            i = 0;
            when i < arg_count loop
                var (ctx_a, av) = lower_expr(ctx, vec_get_rt(stmt.children, i));
                if av >= 0:
                    emit(ctx, q_instr(QOp::SetArg, q_imm(i >> int), q_vreg(av >> int), q_none()));
                end
                i = i + 1;
            end
        end
        emit(ctx, q_instr(QOp::CallFunc, q_vreg(0), q_func_idx(fidx >> int), q_none()));
        out ctx;
    end

    if stmt.node_type == 37:
        if ls_type == 36:
            print(1037);
        end
        var (ctx2, _) = lower_expr(ctx, stmt);
        out ctx2;
    end

    if stmt.node_type == AstType::VarDecl or stmt.node_type == AstType::ConstDecl:
        var (ctx2, r) = fresh_vreg(ctx);
        ctx2.symbols = sym_define(ctx2.symbols, stmt.name, r);
        if vec_len_rt(stmt.children) > 0:
            var (ctx3, val) = lower_expr(ctx2, vec_get_rt(stmt.children, 0));
            if val >= 0 and (val as u32) != r:
                ctx3 = emit(ctx3, q_instr(QOp::Move, q_vreg(r), q_vreg(val >> int), q_none()));
            end
            out ctx3;
        else
            ctx2 = emit(ctx2, q_instr(QOp::Load, q_vreg(r), q_imm(0), q_none()));
            out ctx2;
        end
    end

    if stmt.node_type == AstType::Assign:
        var (scope, idx) = sym_lookup_both(ctx, stmt.name);
        if scope < 0:
            out lower_error(ctx, str_concat(str_new("assign to undefined: "), stmt.name));
        end
        var (ctx2, val) = lower_expr(ctx, vec_get_rt(stmt.children, 0));
        if val < 0:
            out ctx2;
        end
        if scope == 1:
            ctx2 = emit(ctx2, q_instr(QOp::StoreGlobal, q_none(), q_imm(idx >> int), q_vreg(val >> int)));
        else
            if (val as u32) != idx:
                ctx2 = emit(ctx2, q_instr(QOp::Move, q_vreg(idx), q_vreg(val >> int), q_none()));
            end
        end
        out ctx2;
    end

    if stmt.node_type == AstType::IndexAssign:
        var (scope, arr_idx) = sym_lookup_both(ctx, stmt.name);
        if scope < 0:
            out lower_error(ctx, str_new("index assign to undefined variable"));
        end
        arr_vreg = arr_idx;
        if scope == 1:
            var (ctx2, gv) = fresh_vreg(ctx);
            ctx = ctx2;
            ctx = emit(ctx, q_instr(QOp::LoadGlobal, q_vreg(gv), q_imm(arr_idx >> int), q_none()));
            arr_vreg = gv;
        end
        var (ctx3, idx_v) = lower_expr(ctx, vec_get_rt(stmt.children, 0));
        var (ctx4, val_v) = lower_expr(ctx3, vec_get_rt(stmt.children, 1));
        if idx_v >= 0 and val_v >= 0:
            ctx4 = emit(ctx4, q_instr(QOp::ArrSet, q_vreg(val_v >> int), q_vreg(arr_vreg), q_vreg(idx_v >> int)));
        end
        out ctx4;
    end

    if stmt.node_type == AstType::PrintStmt:
        child = vec_get_rt(stmt.children, 0);
        if child.node_type == AstType::LiteralStr:
            var (ctx2, str_idx) = q_module_add_string(ctx.module, child.name);
            ctx.module = ctx2;
            emit(ctx, q_instr(QOp::PrintStr, q_none(), q_str_ref(str_idx), q_none()));
            out ctx;
        end
        var (ctx2, val) = lower_expr(ctx, child);
        if val >= 0:
            emit(ctx, q_instr(QOp::Print, q_none(), q_vreg(val >> int), q_none()));
        end
        out ctx;
    end

    if stmt.node_type == AstType::ReturnStmt:
        if vec_len_rt(stmt.children) > 0:
            var (ctx2, val) = lower_expr(ctx, vec_get_rt(stmt.children, 0));
            if val >= 0:
                ctx2 = emit(ctx2, q_instr(QOp::Ret, q_none(), q_vreg(val >> int), q_none()));
            end
            out ctx2;
        else
            ctx = emit(ctx, q_instr(QOp::Ret, q_none(), q_none(), q_none()));
            out ctx;
        end
    end

    if stmt.node_type == AstType::IfStmt:
        var (_, cond_r) = lower_expr(ctx, vec_get_rt(stmt.children, 0));
        if cond_r < 0:
            out ctx;
        end
        var (_, else_lbl) = fresh_label(ctx);
        var (_, end_lbl) = fresh_label(ctx);

        emit(ctx, q_instr(QOp::JumpIfNot, q_none(), q_vreg(cond_r >> int), q_label(else_lbl)));

        lower_stmt(ctx, vec_get_rt(stmt.children, 1));

        if vec_len_rt(stmt.children) > 2:
            emit(ctx, q_instr(QOp::Jump, q_none(), q_label(end_lbl), q_none()));
        end

        emit(ctx, q_instr(QOp::Label, q_label(else_lbl), q_none(), q_none()));

        if vec_len_rt(stmt.children) > 2:
            lower_stmt(ctx, vec_get_rt(stmt.children, 2));
            emit(ctx, q_instr(QOp::Label, q_label(end_lbl), q_none(), q_none()));
        end
        out ctx;
    end

    if stmt.node_type == AstType::WhileStmt:
        var (_, loop_lbl) = fresh_label(ctx);
        var (_, end_lbl) = fresh_label(ctx);

        emit(ctx, q_instr(QOp::Label, q_label(loop_lbl), q_none(), q_none()));

        var (_, cond_r) = lower_expr(ctx, vec_get_rt(stmt.children, 0));
        if cond_r < 0:
            out ctx;
        end
        emit(ctx, q_instr(QOp::JumpIfNot, q_none(), q_vreg(cond_r >> int), q_label(end_lbl)));

        ctx.loop_start_labels = vec_push_rt(ctx.loop_start_labels, loop_lbl);
        ctx.loop_end_labels = vec_push_rt(ctx.loop_end_labels, end_lbl);
        ctx.loop_depth = ctx.loop_depth + 1;

        lower_stmt(ctx, vec_get_rt(stmt.children, 1));

        ctx.loop_depth = ctx.loop_depth - 1;

        emit(ctx, q_instr(QOp::Jump, q_none(), q_label(loop_lbl), q_none()));

        emit(ctx, q_instr(QOp::Label, q_label(end_lbl), q_none(), q_none()));
        out ctx;
    end

    if stmt.node_type == AstType::LoopStmt:
        var (ctx2, counter) = fresh_vreg(ctx);
        ctx2 = emit(ctx2, q_instr(QOp::Load, q_vreg(counter), q_imm(0), q_none()));

        var (ctx3, limit_r) = lower_expr(ctx2, vec_get_rt(stmt.children, 0));
        if limit_r < 0:
            out ctx3;
        end

        var (ctx4, loop_lbl) = fresh_label(ctx3);
        var (ctx5, cont_lbl) = fresh_label(ctx4);
        var (ctx6, end_lbl) = fresh_label(ctx5);

        ctx6 = emit(ctx6, q_instr(QOp::Label, q_label(loop_lbl), q_none(), q_none()));

        var (ctx7, cmp_r) = fresh_vreg(ctx6);
        ctx7 = emit(ctx7, q_instr(QOp::CmpLt, q_vreg(cmp_r), q_vreg(counter), q_vreg(limit_r >> int)));
        ctx7 = emit(ctx7, q_instr(QOp::JumpIfNot, q_none(), q_vreg(cmp_r), q_label(end_lbl)));

        ctx7.loop_start_labels = vec_push_rt(ctx7.loop_start_labels, cont_lbl);
        ctx7.loop_end_labels = vec_push_rt(ctx7.loop_end_labels, end_lbl);
        ctx7.loop_depth = ctx7.loop_depth + 1;

        ctx7 = lower_stmt(ctx7, vec_get_rt(stmt.children, 1));

        ctx7.loop_depth = ctx7.loop_depth - 1;

        ctx7 = emit(ctx7, q_instr(QOp::Label, q_label(cont_lbl), q_none(), q_none()));
        var (ctx8, one_r) = fresh_vreg(ctx7);
        ctx8 = emit(ctx8, q_instr(QOp::Load, q_vreg(one_r), q_imm(1), q_none()));
        ctx8 = emit(ctx8, q_instr(QOp::Add, q_vreg(counter), q_vreg(counter), q_vreg(one_r)));
        ctx8 = emit(ctx8, q_instr(QOp::Jump, q_none(), q_label(loop_lbl), q_none()));

        ctx8 = emit(ctx8, q_instr(QOp::Label, q_label(end_lbl), q_none(), q_none()));
        out ctx8;
    end

    if stmt.node_type == AstType::ForRange:
        var (ctx2, start_v) = lower_expr(ctx, vec_get_rt(stmt.children, 0));
        if start_v < 0:
            out ctx2;
        end
        var (ctx3, end_v) = lower_expr(ctx2, vec_get_rt(stmt.children, 1));
        if end_v < 0:
            out ctx3;
        end

        var (ctx4, loop_var) = fresh_vreg(ctx3);
        ctx4.symbols = sym_define(ctx4.symbols, stmt.name, loop_var);
        ctx4 = emit(ctx4, q_instr(QOp::Move, q_vreg(loop_var), q_vreg(start_v >> int), q_none()));

        var (ctx5, loop_lbl) = fresh_label(ctx4);
        var (ctx6, end_lbl) = fresh_label(ctx5);
        var (ctx7, cont_lbl) = fresh_label(ctx6);

        ctx7 = emit(ctx7, q_instr(QOp::Label, q_label(loop_lbl), q_none(), q_none()));

        var (ctx8, cmp_r) = fresh_vreg(ctx7);
        ctx8 = emit(ctx8, q_instr(QOp::CmpLt, q_vreg(cmp_r), q_vreg(loop_var), q_vreg(end_v >> int)));
        ctx8 = emit(ctx8, q_instr(QOp::JumpIfNot, q_none(), q_vreg(cmp_r), q_label(end_lbl)));

        ctx8.loop_start_labels = vec_push_rt(ctx8.loop_start_labels, cont_lbl);
        ctx8.loop_end_labels = vec_push_rt(ctx8.loop_end_labels, end_lbl);
        ctx8.loop_depth = ctx8.loop_depth + 1;

        ctx8 = lower_stmt(ctx8, vec_get_rt(stmt.children, 2));

        ctx8.loop_depth = ctx8.loop_depth - 1;

        ctx8 = emit(ctx8, q_instr(QOp::Label, q_label(cont_lbl), q_none(), q_none()));
        var (ctx9, one_r) = fresh_vreg(ctx8);
        ctx9 = emit(ctx9, q_instr(QOp::Load, q_vreg(one_r), q_imm(1), q_none()));
        ctx9 = emit(ctx9, q_instr(QOp::Add, q_vreg(loop_var), q_vreg(loop_var), q_vreg(one_r)));
        ctx9 = emit(ctx9, q_instr(QOp::Jump, q_none(), q_label(loop_lbl), q_none()));

        ctx9 = emit(ctx9, q_instr(QOp::Label, q_label(end_lbl), q_none(), q_none()));
        out ctx9;
    end

    if stmt.node_type == AstType::Block:
        i = 0;
        when i < vec_len_rt(stmt.children) loop
            let saved_nv = ctx.next_vreg;
            let bch = vec_get_rt(stmt.children, i);
            let bch_type = bch.node_type >> int;
            lower_stmt(ctx, bch);
            if bch_type == 3 or bch_type == 4:
                ctx.next_vreg = saved_nv + 1;
            else
                ctx.next_vreg = saved_nv;
            end
            i = i + 1;
        end
        out ctx;
    end

    if stmt.node_type == AstType::BreakStmt:
        if ctx.loop_depth == 0:
            out lower_error(ctx, str_new("break outside of loop"));
        end
        end_lbl = vec_get_rt(ctx.loop_end_labels, (ctx.loop_depth - 1) >> int);
        ctx = emit(ctx, q_instr(QOp::Jump, q_none(), q_label(end_lbl), q_none()));
        out ctx;
    end

    if stmt.node_type == AstType::ContinueStmt:
        if ctx.loop_depth == 0:
            out lower_error(ctx, str_new("continue outside of loop"));
        end
        start_lbl = vec_get_rt(ctx.loop_start_labels, (ctx.loop_depth - 1) >> int);
        ctx = emit(ctx, q_instr(QOp::Jump, q_none(), q_label(start_lbl), q_none()));
        out ctx;
    end

    if stmt.node_type == AstType::EnumDef:
        et = EnumType ( name: stmt.name, variants: vec_new_rt() );
        i = 0;
        when i < vec_len_rt(stmt.children) loop
            v = vec_get_rt(stmt.children, i);
            et.variants = vec_push_rt(et.variants, EnumVariant ( name: v.name, value: v.int_val ));
            i = i + 1;
        end
        ctx.enum_types = vec_push_rt(ctx.enum_types, et);
        out ctx;
    end

    if stmt.node_type == AstType::EntityDef:
        et = EntityType ( name: stmt.name, fields: vec_new_rt() );
        ctx.ent_names = vec_push_rt(ctx.ent_names, stmt.name);
        field_count = 0;
        i = 0;
        when i < vec_len_rt(stmt.children) loop
            f = vec_get_rt(stmt.children, i);
            et.fields = vec_push_rt(et.fields, EntityField ( name: f.name, offset: i >> int ));
            ctx.ent_field_names = vec_push_rt(ctx.ent_field_names, f.name);
            ctx.ent_field_offsets = vec_push_rt(ctx.ent_field_offsets, i);
            field_count = field_count + 1;
            i = i + 1;
        end
        ctx.ent_field_counts = vec_push_rt(ctx.ent_field_counts, field_count);
        ctx.entity_types = vec_push_rt(ctx.entity_types, et);
        out ctx;
    end

    if stmt.node_type == AstType::FieldAssign:
        offset = -1;
        j = 0;
        let fa_nent2 = vec_len_rt(ctx.ent_names);
        when j < fa_nent2 and offset < 0 loop
            let fa_fc2 = vec_get_rt(ctx.ent_field_counts, j);
            let fa_s2 = 0;
            let fa_k2 = 0;
            when fa_k2 < j loop
                fa_s2 = fa_s2 + vec_get_rt(ctx.ent_field_counts, fa_k2);
                fa_k2 = fa_k2 + 1;
            end
            let fa_i2 = 0;
            when fa_i2 < fa_fc2 loop
                let fa_fn2 = vec_get_rt(ctx.ent_field_names, fa_s2 + fa_i2);
                if str_eq(fa_fn2, stmt.name2):
                    offset = vec_get_rt(ctx.ent_field_offsets, fa_s2 + fa_i2);
                end
                fa_i2 = fa_i2 + 1;
            end
            j = j + 1;
        end

        var (scope, idx) = sym_lookup_both(ctx, stmt.name);
        if scope < 0:
            out lower_error(ctx, str_concat(str_new("field assign to undefined var"), str_new("")));
        end
        base_vreg = idx;
        if scope == 1:
            var (ctx2, gv) = fresh_vreg(ctx);
            ctx = ctx2;
            ctx = emit(ctx, q_instr(QOp::LoadGlobal, q_vreg(gv), q_imm(idx >> int), q_none()));
            base_vreg = gv;
        end

        if offset < 0:
            out lower_error(ctx, str_concat(str_new("unknown field in assign"), str_new("")));
        end

        var (ctx3, val_r) = lower_expr(ctx, vec_get_rt(stmt.children, 0));
        if val_r < 0:
            out ctx3;
        end
        var (ctx4, off_r) = fresh_vreg(ctx3);
        ctx4 = emit(ctx4, q_instr(QOp::Load, q_vreg(off_r), q_imm(offset >> int), q_none()));
        ctx4 = emit(ctx4, q_instr(QOp::StoreWord, q_vreg(val_r >> int), q_vreg(base_vreg), q_vreg(off_r)));
        out ctx4;
    end

    if stmt.node_type == AstType::CheckCpu or stmt.node_type == AstType::PatchPoint:
        ctx.patch_counter = ctx.patch_counter + 1;
        pp = q_instr(QOp::PatchPoint, q_none(), q_none(), q_none());
        pp.patch_id = ctx.patch_counter;
        ctx = emit(ctx, pp);
        out ctx;
    end

    if stmt.node_type == AstType::ImportStmt or stmt.node_type == AstType::ModuleStmt or stmt.node_type == AstType::ExportStmt or stmt.node_type == AstType::IncludeStmt do
        out ctx;
    end

    var (ctx2, _) = lower_expr(ctx, stmt);
    out ctx2;
end

func lower_func_def:
    in(ctx:LowerCtx; func_def:AstNode)
    fidx = find_func_index(ctx, func_def.name);
    if fidx < 0:
        var (ctx2, fidx2) = q_module_add_func(ctx.module, func_def.name);
        ctx.module = ctx2;
        fidx = fidx2;
    end
    ctx.current_func_idx = fidx;

    ctx.next_vreg = 0;

    saved_syms = ctx.symbols;
    ctx.symbols = sym_new();

    body_idx = vec_len_rt(func_def.children) - 1;
    param_count = 0;
    i = 0;
    when i < body_idx loop
        param = vec_get_rt(func_def.children, i);
        if param.node_type == AstType::Identifier:
            var (ctx3, pr) = fresh_vreg(ctx);
            ctx = ctx3;
            ctx.symbols = sym_define(ctx.symbols, param.name, pr);
            param_count = param_count + 1;
        end
        i = i + 1;
    end

    f = vec_get_rt(ctx.module.functions, fidx);
    f.param_count = param_count;
    vec_set_rt(ctx.module.functions, fidx, f);

    if vec_len_rt(func_def.children) > 0:
        ctx = lower_stmt(ctx, vec_get_rt(func_def.children, body_idx));
    end

    ctx.symbols = saved_syms;
    ctx.current_func_idx = -1;
    out ctx;
end

func lower_program:
    in(ctx:LowerCtx; program:AstNode)
    i = 0;
    when i < vec_len_rt(program.children) loop
        child = vec_get_rt(program.children, i);
        if child.node_type == AstType::EnumDef or child.node_type == AstType::EntityDef:
            ctx = lower_stmt(ctx, child);
        end
        i = i + 1;
    end

    has_main = false;
    has_top_stmt = false;
    i = 0;
    when i < vec_len_rt(program.children) loop
        child = vec_get_rt(program.children, i);
        if child.node_type == AstType::FuncDef:
            var (mod2, _) = q_module_add_func(ctx.module, child.name);
            ctx.module = mod2;
            if str_eq(child.name, "main"):
                has_main = true;
            end
        else
            if not is_metadata(child.node_type):
                has_top_stmt = true;
            end
        end
        i = i + 1;
    end

    if has_main:
        has_globals = false;
        i = 0;
        when i < vec_len_rt(program.children) loop
            child = vec_get_rt(program.children, i);
            if child.node_type == AstType::VarDecl or child.node_type == AstType::ConstDecl:
                has_globals = true;
            end
            i = i + 1;
        end

        if has_globals:
            var (mod3, ginit_idx) = q_module_add_func(ctx.module, "__ginit");
            ctx.module = mod3;
            ctx.current_func_idx = ginit_idx;
            ctx.next_vreg = 0;

            i = 0;
            when i < vec_len_rt(program.children) loop
                child = vec_get_rt(program.children, i);
                if child.node_type == AstType::VarDecl or child.node_type == AstType::ConstDecl:
                    gidx = ctx.global_idx_counter;
                    ctx.global_idx_counter = gidx + 1;
                    ctx.global_symbols = sym_define(ctx.global_symbols, child.name, gidx);
                    if vec_len_rt(child.children) > 0:
                        var (ctx2, val) = lower_expr(ctx, vec_get_rt(child.children, 0));
                        ctx = ctx2;
                        if val >= 0:
                            ctx = emit(ctx, q_instr(QOp::StoreGlobal, q_none(), q_imm(gidx >> int), q_vreg(val >> int)));
                        end
                    end
                end
                i = i + 1;
            end

            var (ctx3, rz) = fresh_vreg(ctx);
            ctx = ctx3;
            ctx = emit(ctx, q_instr(QOp::Load, q_vreg(rz), q_imm(0), q_none()));
            ctx = emit(ctx, q_instr(QOp::Ret, q_none(), q_vreg(rz), q_none()));
            ctx.current_func_idx = -1;
        end
    end

    if not has_main:
        var (mod3, main_idx) = q_module_add_func(ctx.module, "main");
        ctx.module = mod3;
        ctx.current_func_idx = main_idx;

        i = 0;
        when i < vec_len_rt(program.children) loop
            child = vec_get_rt(program.children, i);
            if child.node_type != AstType::FuncDef:
                ctx = lower_stmt(ctx, child);
            end
            i = i + 1;
        end

        var (ctx2, rz) = fresh_vreg(ctx);
        ctx = ctx2;
        ctx = emit(ctx, q_instr(QOp::Load, q_vreg(rz), q_imm(0), q_none()));
        ctx = emit(ctx, q_instr(QOp::Ret, q_none(), q_vreg(rz), q_none()));
        ctx.current_func_idx = -1;
    end

    i = 0;
    when i < vec_len_rt(program.children) loop
        child = vec_get_rt(program.children, i);
        if child.node_type == AstType::FuncDef:
            ctx = lower_func_def(ctx, child);
        end
        i = i + 1;
    end

    out ctx;
end

func is_metadata:
    in(t:AstType)
    out t == AstType::EnumDef or t == AstType::EntityDef or t == AstType::ModuleStmt or t == AstType::ImportStmt or t == AstType::ExportStmt or t == AstType::IncludeStmt;
end

entity LiveInterval:
    vreg:       int;
    start:      int;
    end_pos:    int;
    phys_reg:   int;
    spill_slot: int;
end

func compute_liveness:
    in(func:QFunction)
    intervals = vec_new_rt();

    i = 0;
    when i < vec_len_rt(func.body) loop
        instr = vec_get_rt(func.body, i);

        if instr.dest.op_type == OperandType::VReg:
            iv = find_or_create_interval(intervals, instr.dest.vreg);
            intervals = iv.0;
            idx = iv.1;
            interval = vec_get_rt(intervals, idx);
            if (i as u32) < interval.start:
                interval.start = i >> int;
            end
            if (i as u32) > interval.end_pos:
                interval.end_pos = i >> int;
            end
            vec_set_rt(intervals, idx, interval);
        end

        if instr.src1.op_type == OperandType::VReg:
            iv = find_or_create_interval(intervals, instr.src1.vreg);
            intervals = iv.0;
            idx = iv.1;
            interval = vec_get_rt(intervals, idx);
            if (i as u32) < interval.start:
                interval.start = i >> int;
            end
            if (i as u32) > interval.end_pos:
                interval.end_pos = i >> int;
            end
            vec_set_rt(intervals, idx, interval);
        end

        if instr.src2.op_type == OperandType::VReg:
            iv = find_or_create_interval(intervals, instr.src2.vreg);
            intervals = iv.0;
            idx = iv.1;
            interval = vec_get_rt(intervals, idx);
            if (i as u32) < interval.start:
                interval.start = i >> int;
            end
            if (i as u32) > interval.end_pos:
                interval.end_pos = i >> int;
            end
            vec_set_rt(intervals, idx, interval);
        end

        i = i + 1;
    end
    out intervals;
end

func find_or_create_interval:
    in(intervals:Vec<LiveInterval>; vreg:int)
    i = 0;
    when i < vec_len_rt(intervals) loop
        iv = vec_get_rt(intervals, i);
        if iv.vreg == vreg:
            out (intervals, i);
        end
        i = i + 1;
    end
    intervals = vec_push_rt(intervals, LiveInterval (;
        vreg:       vreg,;
        start:      0xFFFFFFFF >> int,;
        end_pos:    0,;
        phys_reg:   -1,;
        spill_slot: -1
    ));
    out (intervals, vec_len_rt(intervals) - 1);
end

func regalloc_linear_scan:
    in(intervals:Vec<LiveInterval>; num_phys_regs:int)
    if num_phys_regs == 0 or vec_len_rt(intervals) == 0:
        out intervals;
    end

    n = vec_len_rt(intervals);
    s = 0;
    when s < n - 1 loop
        t = 0;
        when t < n - s - 1 loop
            a = vec_get_rt(intervals, t);
            b = vec_get_rt(intervals, t + 1);
            if a.start > b.start:
                vec_set_rt(intervals, t, b);
                vec_set_rt(intervals, t + 1, a);
            end
            t = t + 1;
        end
        s = s + 1;
    end

    max_regs = num_phys_regs;
    if max_regs > 32:
        max_regs = 32;
    end
    free_mask = (1 << max_regs) - 1;

    active = vec_new_rt();
    next_spill = 0;

    i = 0;
    when i < n loop
        cur = vec_get_rt(intervals, i);

        new_active = vec_new_rt();
        a = 0;
        when a < vec_len_rt(active) loop
            aidx = vec_get_rt(active, a);
            act = vec_get_rt(intervals, aidx);
            if act.end_pos < cur.start:
                if act.phys_reg >= 0:
                    free_mask = free_mask or (1 << (act.phys_reg >> int));
                end
            else
                new_active = vec_push_rt(new_active, aidx);
            end
            a = a + 1;
        end
        active = new_active;

        if free_mask != 0:
            bit = 0;
            tmp = free_mask;
            when (tmp and 1) == 0 loop
                bit = bit + 1;
                tmp = tmp >> 1;
            end

            cur.phys_reg = bit >> int;
            free_mask = free_mask and (not (1 << bit));
            vec_set_rt(intervals, i, cur);

            pos = vec_len_rt(active);
            k = 0;
            when k < vec_len_rt(active) loop
                aidx = vec_get_rt(active, k);
                act = vec_get_rt(intervals, aidx);
                if act.end_pos > cur.end_pos:
                    pos = k;
                    k = vec_len_rt(active) 
                end
                k = k + 1;
            end
            active = vec_push_rt(active, i) 
            j = vec_len_rt(active) - 1;
            when j > pos loop
                vec_set_rt(active, j, vec_get_rt(active, j - 1));
                j = j - 1;
            end
            vec_set_rt(active, pos, i);
        else
            if vec_len_rt(active) > 0:
                last_idx = vec_get_rt(active, vec_len_rt(active) - 1);
                spill_cand = vec_get_rt(intervals, last_idx);
                if spill_cand.end_pos > cur.end_pos:
                    cur.phys_reg = spill_cand.phys_reg;
                    spill_cand.phys_reg = -1;
                    spill_cand.spill_slot = next_spill;
                    next_spill = next_spill + 1;
                    vec_set_rt(intervals, last_idx, spill_cand);
                    vec_set_rt(intervals, i, cur);
                    new_active2 = vec_new_rt();
                    k = 0;
                    when k < vec_len_rt(active) - 1 loop
                        new_active2 = vec_push_rt(new_active2, vec_get_rt(active, k));
                        k = k + 1;
                    end
                    active = new_active2;
                    active = vec_push_rt(active, i);
                else
                    cur.phys_reg = -1;
                    cur.spill_slot = next_spill;
                    next_spill = next_spill + 1;
                    vec_set_rt(intervals, i, cur);
                end
            else
                cur.phys_reg = -1;
                cur.spill_slot = next_spill;
                next_spill = next_spill + 1;
                vec_set_rt(intervals, i, cur);
            end
        end

        i = i + 1;
    end

    out intervals;
end

func apply_regalloc:
    in(func:QFunction; intervals:Vec<LiveInterval>)
    niv = vec_len_rt(intervals);
    print niv;
    k = 0;
    when k < niv loop
        iv = vec_get_rt(intervals, k);
        print iv.vreg;
        print iv.phys_reg;
        k = k + 1;
    end
    i = 0;
    when i < vec_len_rt(func.body) loop
        ins = vec_get_rt(func.body, i);
        changed = 0;
        if ins.dest.op_type == OperandType::VReg:
            pr = get_phys_reg(intervals, ins.dest.vreg);
            if pr >= 0 and (pr as u32) != ins.dest.vreg:
                ins.dest.vreg = pr;
                changed = 1;
            end
        end
        if ins.src1.op_type == OperandType::VReg:
            pr = get_phys_reg(intervals, ins.src1.vreg);
            if pr >= 0 and (pr as u32) != ins.src1.vreg:
                ins.src1.vreg = pr;
                changed = 1;
            end
        end
        if ins.src2.op_type == OperandType::VReg:
            pr = get_phys_reg(intervals, ins.src2.vreg);
            if pr >= 0 and (pr as u32) != ins.src2.vreg:
                ins.src2.vreg = pr;
                changed = 1;
            end
        end
        if changed == 1:
            vec_set_rt(func.body, i, ins);
        end
        i = i + 1;
    end
    out func;
end

func tco_pass:
    in(func:QFunction)
    tco_count = 0;
    body_len = vec_len_rt(func.body);
    if body_len < 2:
        out (func, 0);
    end

    i = 0;
    when i + 1 < body_len loop
        cur = vec_get_rt(func.body, i);
        next_instr = vec_get_rt(func.body, i + 1);

        if cur.opcode == QOp::Call and next_instr.opcode == QOp::Ret:
            cur.opcode = QOp::Jump;
            cur.dest = q_none();
            cur.src2 = q_none();
            vec_set_rt(func.body, i, cur);

            next_instr.opcode = QOp::Nop;
            next_instr.dest = q_none();
            next_instr.src1 = q_none();
            next_instr.src2 = q_none();
            vec_set_rt(func.body, i + 1, next_instr);

            tco_count = tco_count + 1;
            i = i + 2;
        else
            i = i + 1;
        end
    end
    out (func, tco_count);
end

func get_phys_reg:
    in(intervals:Vec<LiveInterval>; vreg:int)
    i = 0;
    when i < vec_len_rt(intervals) loop
        iv = vec_get_rt(intervals, i);
        if iv.vreg == vreg:
            out iv.phys_reg;
        end
        i = i + 1;
    end
    out -1;
end

# -- END vir/compiler/ir_optimizer.vri --

# -- BEGIN vir/compiler/codegen.vri --

enum TargetArch:
    Unknown = 0;
    X86_64  = 1;
    ARM64   = 2;
end

func detect_arch:
    out TargetArch::ARM64;
end

enum X86Reg:
    RAX = 0;
    RCX = 1;
    RDX = 2;
    RBX = 3;
    RSP = 4;
    RBP = 5;
    RSI = 6;
    RDI = 7;
    R8  = 8;
    R9  = 9;
    R10 = 10;
    R11 = 11;
    R12 = 12;
    R13 = 13;
    R14 = 14;
    R15 = 15;
end

enum ArmReg:
    X0  = 0;
    X1  = 1;
    X2  = 2;
    X3  = 3;
    X4  = 4;
    X5  = 5;
    X6  = 6;
    X7  = 7;
    X8  = 8;
    X9  = 9;
    X10 = 10;
    X11 = 11;
    X12 = 12;
    X13 = 13;
    X14 = 14;
    X15 = 15;
    X16 = 16;
    X17 = 17;
    X29 = 29  
    X30 = 30  
    SP  = 31;
end

const CODEBUF_INIT_CAP = 4096;

entity CodeBuf:
    data:   int     
    len:    int;
    cap:    int;
    arch:   TargetArch;
end

func codebuf_new:
    in(arch:TargetArch)
    buf = CodeBuf (;
        data: vec_new_rt(),;
        len:  0,;
        cap:  CODEBUF_INIT_CAP,;
        arch: arch
    );
    out buf;
end

func codebuf_emit_byte:
    in(buf:CodeBuf; byte:int)
    buf.data = vec_push_rt(buf.data, byte & 0xFF);
    buf.len = buf.len + 1;
    out buf;
end

func codebuf_emit_u32:
    in(buf:CodeBuf; val:int)
    buf.data = vec_push_rt(buf.data, val & 0xFF);
    buf.data = vec_push_rt(buf.data, (val >> 8) & 0xFF);
    buf.data = vec_push_rt(buf.data, (val >> 16) & 0xFF);
    buf.data = vec_push_rt(buf.data, (val >> 24) & 0xFF);
    buf.len = buf.len + 4;
    out buf;
end

func codebuf_emit_u64:
    in(buf:CodeBuf; val:int)
    buf = codebuf_emit_u32(buf, val & 0xFFFFFFFF);
    buf = codebuf_emit_u32(buf, (val >> 32) & 0xFFFFFFFF);
    out buf;
end

func codebuf_emit_i32:
    in(buf:CodeBuf; val:int)
    out codebuf_emit_u32(buf, val);
end

func codebuf_offset:
    in(buf:CodeBuf)
    out buf.len;
end

func codebuf_get_data:
    in(buf:CodeBuf; index:int)
    out vec_get_rt(buf.data, index);
end

func codebuf_patch_i32:
    in(buf:CodeBuf; offset:int; val:int)
    if offset + 4 <= buf.len:
        vec_set_rt(buf.data, offset, val & 0xFF);
        vec_set_rt(buf.data, offset + 1, (val >> 8) & 0xFF);
        vec_set_rt(buf.data, offset + 2, (val >> 16) & 0xFF);
        vec_set_rt(buf.data, offset + 3, (val >> 24) & 0xFF);
    end
    out buf;
end

func codebuf_patch_u32:
    in(buf:CodeBuf; offset:int; val:int)
    out codebuf_patch_i32(buf, offset, val);
end

func rex_w:
    in(r:int; rm:int)
    rex = 0x48;
    if r >= 8:
        rex = rex | 0x04;
    end
    if rm >= 8:
        rex = rex | 0x01;
    end
    out rex;
end

func modrm:
    in(mod_:int; reg:int; rm:int)
    out (mod_ << 6) | ((reg & 7) << 3) | (rm & 7);
end

func x86_add_rr:
    in(cb:CodeBuf; dst:int; src:int)
    cb = codebuf_emit_byte(cb, rex_w(src, dst));
    cb = codebuf_emit_byte(cb, 0x01);
    cb = codebuf_emit_byte(cb, modrm(0x03, src, dst));
    out cb;
end

func x86_sub_rr:
    in(cb:CodeBuf; dst:int; src:int)
    cb = codebuf_emit_byte(cb, rex_w(src, dst));
    cb = codebuf_emit_byte(cb, 0x29);
    cb = codebuf_emit_byte(cb, modrm(0x03, src, dst));
    out cb;
end

func x86_imul_rr:
    in(cb:CodeBuf; dst:int; src:int)
    cb = codebuf_emit_byte(cb, rex_w(dst, src));
    cb = codebuf_emit_byte(cb, 0x0F);
    cb = codebuf_emit_byte(cb, 0xAF);
    cb = codebuf_emit_byte(cb, modrm(0x03, dst, src));
    out cb;
end

func x86_mov_reg_imm64:
    in(cb:CodeBuf; dst:int; imm:int)
    rex = 0x48;
    if dst >= 8:
        rex = rex | 0x01;
    end
    cb = codebuf_emit_byte(cb, rex);
    cb = codebuf_emit_byte(cb, 0xB8 + (dst & 7));
    cb = codebuf_emit_u64(cb, imm);
    out cb;
end

func x86_mov_reg_imm32:
    in(cb:CodeBuf; dst:int; imm:int)
    rex = 0x48;
    if dst >= 8:
        rex = rex | 0x01;
    end
    cb = codebuf_emit_byte(cb, rex);
    cb = codebuf_emit_byte(cb, 0xC7);
    cb = codebuf_emit_byte(cb, modrm(0x03, 0, dst));
    cb = codebuf_emit_i32(cb, imm);
    out cb;
end

func x86_mov_rr:
    in(cb:CodeBuf; dst:int; src:int)
    cb = codebuf_emit_byte(cb, rex_w(src, dst));
    cb = codebuf_emit_byte(cb, 0x89);
    cb = codebuf_emit_byte(cb, modrm(0x03, src, dst));
    out cb;
end

func x86_push:
    in(cb:CodeBuf; reg:int)
    if reg >= 8:
        cb = codebuf_emit_byte(cb, 0x41);
    end
    cb = codebuf_emit_byte(cb, 0x50 + (reg & 7));
    out cb;
end

func x86_pop:
    in(cb:CodeBuf; reg:int)
    if reg >= 8:
        cb = codebuf_emit_byte(cb, 0x41);
    end
    cb = codebuf_emit_byte(cb, 0x58 + (reg & 7));
    out cb;
end

func x86_ret:
    in(cb:CodeBuf)
    out codebuf_emit_byte(cb, 0xC3);
end

