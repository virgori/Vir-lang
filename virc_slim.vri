export backpatch, backpatch_x86, backpatch_arm64;
export PatchState, patch_new, patch_add_label, patch_add_fixup;
export CodeVariant, CodegenResult, codegen_result_new;

export x86_add_rr, x86_sub_rr, x86_imul_rr, x86_mov_reg_imm64, x86_mov_reg_imm32;
export x86_mov_rr, x86_push, x86_pop, x86_ret, x86_nop, x86_jmp_rel32;
export x86_call_rel32, x86_cmp_rr, x86_sete, x86_setg, x86_setl, x86_setge, x86_setle;
