# virc_stage1.vri — thin Stage-1 compiler (macOS ARM64)
# Globals-free: one state block `st` (Stage-0 LoadGlobal/StoreGlobal unreliable).
# Build: ./core/build/vir run virc_boot.vri -- virc_stage1.vri -o dist/virc-stage1
# Smoke: ./dist/virc-stage1 tests/bootstrap_codegen/cg_call.vri -o /tmp/cg1 && /tmp/cg1 → 42
#
# st layout (i64 slots):
#  0 src  1 slen  2 pos  3 tok  4 tival  5 tname
#  6 bump  7 bump_end  8 out  9 out_n  10 rt_print
#  11 fn_off  12 fn_name  13 fn_n  14 main_off
#  15 call_sites  16 call_tgts  17 call_n  226 call_cap (bytes)
#  87 rt_slurp  88 rt_exit  229 rt_write  230 rt_slurp_len
#  231 cond-site stack  232 cond-op stack  233 loop/else-site stack
#  91 rt_alloc  92 rt_get_arg  93 rt_argc  94 rt_printstr
#  95 fn_hk  96 fn_hv  97 loc_hk  98 loc_hv   (open-addr hash, 128 slots)
#  66 expr_nest  67 call_nest  89 stmt_nest
#  116 scan_loop  (MUST NOT reuse 18 — next_tok clobbers st[18])
#  220 code_cap   (emit_u32 hard-fail 90; NOT 100..119 — label stack)
#  140+n callee  160+n dest  180+n saved argc  190+n saved arg-loop
#  100..106 hash scratch  107..109 hash/declare park
#  HASH_N = 128 (mask 127) — O(1) avg find_fn / slot_of
#  Nest caps: expr≤32 call≤16 stmt≤32 — hard-fail (92) before stack blow-up
#  Peak slots: 221=max_expr 222=max_call 223=max_stmt (printed at end: 660/670/890)
#  Fatal codes: 89=call-site OOM  90=code OOM  91=bump OOM  92=nest  98=unknown fn
#  call_sites/tgts must be large: self-host ~2K BL sites; 4KB (512) overflowed into fn_hk
#  Include expand (before parse):
#    240 out 241 out_n 242 out_cap  247 depth  248 seen[] 249 seen_n
#    250 scan_src 251 scan_len 252 scan_pos  253 dir 254 dir_len
#    268 save_stack 269 save_n   Fatal 93=include cycle/depth 94=include path
#  v2.0 Entity table (flat struct):
#    290 ent_names (ptr to buf of 128 name-ptrs)
#    291 ent_sizes (ptr to buf of 128 i64: #fields per entity)
#    292 ent_n     (count of declared entities)
#    293 ent_fnames (ptr to buf 128*8 name-ptrs, row=entity, col=field)
#    294 ent_foffs  (ptr to buf 128*8 i64 byte-offsets)
#    295 cur_ent_idx (entity being parsed, -1 = none)
#
# Token table:
#  0=EOF  1=IDENT  2=NUMBER  3=func  4=in  5=out  6=let  7=print  8=end
#  9=(  10=)  11=:  12=;  13=,  14=+  15==  16=.
#  17=mod (modulo — v2.0 §10.1)
#  20=*  21=-  22=/  23=<=  24=<  25=>=  26=>  27=!=  28===
#  30=when  31=loop  32=if  33=do  34=else  35=STRING
#  40=bit_and  41=bit_or  42_kw=shl  43_kw=shr  44=arena
#  45=entity  46=null/none  47=import  48=from  49=type  50=method  51=export
#  52=i8 53=i16 54=i32 55=i64 56=u8 57=u16 58=u32 59=u64 60=int 61=uint
#  62=f32 63=f64 64=float 65=bool 66=char 67=ptr 68=void 69=string
#  70=true 71=false 72=enum 73=packed 74=const 75=var
#  §4.6 arena: … end — watermark on _rt_alloc bump [x27,#24]

func st_get(st, i):
    out read_word(st, i * 8)
end.

func st_set:
    in
        st
        i
        v
    write_word(st, i * 8, v)
end.

# Avoid `or` — Stage-0 lowers `a or b` to broken ADD of slots (hangs lexer).
func is_space(c):
    if c == 32 do
        out 1
    end
    if c == 9 do
        out 1
    end
    if c == 10 do
        out 1
    end
    if c == 13 do
        out 1
    end
    out 0
end.

func is_alpha(c):
    if c >= 97 do
        if c <= 122 do
            out 1
        end
    end
    if c >= 65 do
        if c <= 90 do
            out 1
        end
    end
    if c == 95 do
        out 1
    end
    out 0
end.

func is_digit(c):
    if c >= 48 do
        if c <= 57 do
            out 1
        end
    end
    out 0
end.

func ch(st, i):
    if i < 0 do
        out 0
    end
    let slen = st_get(st, 1)
    if i >= slen do
        out 0
    end
    let src = st_get(st, 0)
    out read_byte(src, i)
end.

func bump_alloc(st, n):
    let p = st_get(st, 6)
    st_set(st, 6, p + n)
    if st_get(st, 6) > st_get(st, 7) do
        out 0
    end
    out p
end.

func bump_cstr:
    in
        st
        start
        len
    # Park bump ptr in st[25] — Stage-0 breaks `let p = bump_alloc(...)`
    # (Call lowered to st_get with wrong index; `out p` became 0).
    st_set(st, 25, st_get(st, 6))
    st_set(st, 6, st_get(st, 25) + len + 1)
    if st_get(st, 6) > st_get(st, 7) do
        # Returning 0 used to SEGV later on null cstr — fail loudly.
        print(91)
        exit_prog(1)
    end
    # st[19]=i — Stage-0 drops `i = i + 1` inside when bodies.
    st_set(st, 19, 0)
    when st_get(st, 19) < len loop
        let i = st_get(st, 19)
        write_byte(st_get(st, 25), i, ch(st, start + i))
        st_set(st, 19, i + 1)
    end
    write_byte(st_get(st, 25), len, 0)
    out st_get(st, 25)
end.

func bump_unescaped_cstr:
    in
        st
        start
        raw_len
    st_set(st, 25, st_get(st, 6))
    st_set(st, 6, st_get(st, 25) + raw_len + 1)
    if st_get(st, 6) > st_get(st, 7) do
        print(91)
        exit_prog(1)
    end
    var src_i = 0
    var dst_i = 0
    when src_i < raw_len loop
        let b = ch(st, start + src_i)
        if b == 92 do
            src_i = src_i + 1
            if src_i < raw_len do
                let esc = ch(st, start + src_i)
                var out_b = esc
                if esc == 110 do
                    out_b = 10
                end
                if esc == 116 do
                    out_b = 9
                end
                if esc == 114 do
                    out_b = 13
                end
                if esc == 48 do
                    out_b = 0
                end
                if esc == 92 do
                    out_b = 92
                end
                if esc == 34 do
                    out_b = 34
                end
                if esc == 39 do
                    out_b = 39
                end
                if esc == 36 do
                    out_b = 36
                end
                write_byte(st_get(st, 25), dst_i, out_b)
                dst_i = dst_i + 1
                src_i = src_i + 1
            else
                write_byte(st_get(st, 25), dst_i, 92)
                dst_i = dst_i + 1
            end
        else
            write_byte(st_get(st, 25), dst_i, b)
            dst_i = dst_i + 1
            src_i = src_i + 1
        end
    end
    write_byte(st_get(st, 25), dst_i, 0)
    st_set(st, 4, dst_i)
    out st_get(st, 25)
end.

func ident_is_str:
    in
        s
        kw
    if s == 0 do out 0 end
    if kw == 0 do out 0 end
    if read_byte(s, 0) != read_byte(kw, 0) do out 0 end
    if read_byte(s, 0) == 0 do out 1 end
    if read_byte(s, 1) != read_byte(kw, 1) do out 0 end
    if read_byte(s, 1) == 0 do out 1 end
    if read_byte(s, 2) != read_byte(kw, 2) do out 0 end
    if read_byte(s, 2) == 0 do out 1 end
    if read_byte(s, 3) != read_byte(kw, 3) do out 0 end
    if read_byte(s, 3) == 0 do out 1 end
    if read_byte(s, 4) != read_byte(kw, 4) do out 0 end
    if read_byte(s, 4) == 0 do out 1 end
    if read_byte(s, 5) != read_byte(kw, 5) do out 0 end
    if read_byte(s, 5) == 0 do out 1 end
    if read_byte(s, 6) != read_byte(kw, 6) do out 0 end
    if read_byte(s, 6) == 0 do out 1 end
    if read_byte(s, 7) != read_byte(kw, 7) do out 0 end
    if read_byte(s, 7) == 0 do out 1 end
    if read_byte(s, 8) != read_byte(kw, 8) do out 0 end
    if read_byte(s, 8) == 0 do out 1 end
    if read_byte(s, 9) != read_byte(kw, 9) do out 0 end
    if read_byte(s, 9) == 0 do out 1 end
    if read_byte(s, 10) != read_byte(kw, 10) do out 0 end
    if read_byte(s, 10) == 0 do out 1 end
    if read_byte(s, 11) != read_byte(kw, 11) do out 0 end
    if read_byte(s, 11) == 0 do out 1 end
    if read_byte(s, 12) != read_byte(kw, 12) do out 0 end
    if read_byte(s, 12) == 0 do out 1 end
    if read_byte(s, 13) != read_byte(kw, 13) do out 0 end
    if read_byte(s, 13) == 0 do out 1 end
    if read_byte(s, 14) != read_byte(kw, 14) do out 0 end
    if read_byte(s, 14) == 0 do out 1 end
    if read_byte(s, 15) != read_byte(kw, 15) do out 0 end
    if read_byte(s, 15) == 0 do out 1 end
    out 1
end.

func classify_kw(st):
    st_set(st, 3, 1)
    let s = st_get(st, 5)
    let c0 = read_byte(s, 0)
    if c0 == 102 do
        if ident_is_str(s, "func") != 0 do st_set(st, 3, 3) end
        if ident_is_str(s, "from") != 0 do st_set(st, 3, 48) end
        if ident_is_str(s, "false") != 0 do st_set(st, 3, 71) end
        if ident_is_str(s, "for") != 0 do st_set(st, 3, 81) end
    end
    if c0 == 105 do
        if ident_is_str(s, "in") != 0 do st_set(st, 3, 4) end
        if ident_is_str(s, "if") != 0 do st_set(st, 3, 32) end
        if ident_is_str(s, "import") != 0 do st_set(st, 3, 47) end
        if ident_is_str(s, "include") != 0 do st_set(st, 3, 108) end
    end
    if c0 == 111 do
        if ident_is_str(s, "out") != 0 do st_set(st, 3, 5) end
        if ident_is_str(s, "or") != 0 do st_set(st, 3, 41) end
    end
    if c0 == 108 do
        if ident_is_str(s, "let") != 0 do st_set(st, 3, 6) end
        if ident_is_str(s, "loop") != 0 do st_set(st, 3, 31) end
        if ident_is_str(s, "lazy") != 0 do st_set(st, 3, 106) end
    end
    if c0 == 118 do
        if ident_is_str(s, "var") != 0 do st_set(st, 3, 75) end
    end
    if c0 == 112 do
        if ident_is_str(s, "print") != 0 do st_set(st, 3, 7) end
        if ident_is_str(s, "packed") != 0 do st_set(st, 3, 73) end
    end
    if c0 == 101 do
        if ident_is_str(s, "end") != 0 do st_set(st, 3, 8) end
        if ident_is_str(s, "else") != 0 do st_set(st, 3, 34) end
        if ident_is_str(s, "entity") != 0 do st_set(st, 3, 45) end
        if ident_is_str(s, "export") != 0 do st_set(st, 3, 51) end
        if ident_is_str(s, "enum") != 0 do st_set(st, 3, 72) end
        if ident_is_str(s, "eif") != 0 do st_set(st, 3, 80) end
        if ident_is_str(s, "ensure") != 0 do st_set(st, 3, 102) end
        if ident_is_str(s, "erx") != 0 do st_set(st, 3, 104) end
    end
    if c0 == 119 do
        if ident_is_str(s, "when") != 0 do st_set(st, 3, 30) end
    end
    if c0 == 100 do
        if ident_is_str(s, "do") != 0 do st_set(st, 3, 33) end
    end
    if c0 == 98 do
        if ident_is_str(s, "bit_and") != 0 do st_set(st, 3, 40) end
        if ident_is_str(s, "bit_or") != 0 do st_set(st, 3, 41) end
        if ident_is_str(s, "bit_xor") != 0 do st_set(st, 3, 130) end
        if ident_is_str(s, "break") != 0 do st_set(st, 3, 82) end
    end
    if c0 == 97 do
        if ident_is_str(s, "and") != 0 do st_set(st, 3, 40) end
        if ident_is_str(s, "arena") != 0 do st_set(st, 3, 44) end
        if ident_is_str(s, "as") != 0 do st_set(st, 3, 109) end
    end
    if c0 == 120 do
        if ident_is_str(s, "xor") != 0 do st_set(st, 3, 130) end
    end
    if c0 == 115 do
        if ident_is_str(s, "shl") != 0 do st_set(st, 3, 42) end
        if ident_is_str(s, "shr") != 0 do st_set(st, 3, 43) end
        if ident_is_str(s, "struct") != 0 do st_set(st, 3, 45) end
        if ident_is_str(s, "skip") != 0 do st_set(st, 3, 83) end
        if ident_is_str(s, "share") != 0 do st_set(st, 3, 105) end
    end
    if c0 == 109 do
        if ident_is_str(s, "mod") != 0 do st_set(st, 3, 17) end
        if ident_is_str(s, "method") != 0 do st_set(st, 3, 50) end
        if ident_is_str(s, "mut") != 0 do st_set(st, 3, 78) end
    end
    if c0 == 110 do
        if ident_is_str(s, "null") != 0 do st_set(st, 3, 46) end
        if ident_is_str(s, "none") != 0 do st_set(st, 3, 46) end
    end
    if c0 == 116 do
        if ident_is_str(s, "type") != 0 do st_set(st, 3, 49) end
        if ident_is_str(s, "true") != 0 do st_set(st, 3, 70) end
        if ident_is_str(s, "throw") != 0 do st_set(st, 3, 101) end
    end
    if c0 == 99 do
        if ident_is_str(s, "const") != 0 do st_set(st, 3, 74) end
        if ident_is_str(s, "case") != 0 do st_set(st, 3, 84) end
    end
    if c0 == 114 do
        if ident_is_str(s, "ref") != 0 do st_set(st, 3, 79) end
        if ident_is_str(s, "revert") != 0 do st_set(st, 3, 103) end
    end
    if c0 == 103 do
        if ident_is_str(s, "get") != 0 do st_set(st, 3, 107) end
    end
end.

func next_tok(st):
    # Cursor only in st[2]. Flag in st[18]. Stage-0 drops `pos = pos+1` in when-bodies.
    # No `let` inside when-bodies: Stage-0 drops the store and the local keeps
    # a stale value from an earlier loop. st[57]=cursor, st[58]=char.
    st_set(st, 18, 1)
    when st_get(st, 18) != 0 loop
        st_set(st, 57, st_get(st, 2))
        if st_get(st, 57) >= st_get(st, 1) do
            st_set(st, 18, 0)
        else
            st_set(st, 58, read_byte(st_get(st, 0), st_get(st, 57)))
            st_set(st, 46, 0)
            if st_get(st, 58) == 32 do
                st_set(st, 46, 1)
            end
            if st_get(st, 58) == 9 do
                st_set(st, 46, 1)
            end
            if st_get(st, 58) == 10 do
                st_set(st, 46, 1)
            end
            if st_get(st, 58) == 13 do
                st_set(st, 46, 1)
            end
            if st_get(st, 46) == 0 do
                st_set(st, 18, 0)
            else
                st_set(st, 2, st_get(st, 57) + 1)
            end
        end
    end
    if st_get(st, 2) >= st_get(st, 1) do
        st_set(st, 3, 0)
        out
    end
    # Park current char in st[42] — Stage-0 clobbers `let c` across calls.
    # Inline alpha/digit tests (no Call) — nested is_alpha/is_digit SEGV'd under parse_func.
    st_set(st, 42, ch(st, st_get(st, 2)))
    st_set(st, 46, 0)
    if st_get(st, 42) >= 97 do
        if st_get(st, 42) <= 122 do
            st_set(st, 46, 1)
        end
    end
    if st_get(st, 42) >= 65 do
        if st_get(st, 42) <= 90 do
            st_set(st, 46, 1)
        end
    end
    if st_get(st, 42) == 95 do
        st_set(st, 46, 1)
    end
    if st_get(st, 46) != 0 do
        # st[26]=start — avoid dead `let start` across when-loop temps
        st_set(st, 26, st_get(st, 2))
        st_set(st, 18, 1)
        when st_get(st, 18) != 0 loop
            st_set(st, 57, st_get(st, 2))
            if st_get(st, 57) >= st_get(st, 1) do
                st_set(st, 18, 0)
            else
                st_set(st, 58, read_byte(st_get(st, 0), st_get(st, 57)))
                st_set(st, 46, 0)
                if st_get(st, 58) >= 97 do
                    if st_get(st, 58) <= 122 do
                        st_set(st, 46, 1)
                    end
                end
                if st_get(st, 58) >= 65 do
                    if st_get(st, 58) <= 90 do
                        st_set(st, 46, 1)
                    end
                end
                if st_get(st, 58) == 95 do
                    st_set(st, 46, 1)
                end
                if st_get(st, 58) >= 48 do
                    if st_get(st, 58) <= 57 do
                        st_set(st, 46, 1)
                    end
                end
                if st_get(st, 46) == 0 do
                    st_set(st, 18, 0)
                else
                    st_set(st, 2, st_get(st, 57) + 1)
                end
            end
        end
        st_set(st, 59, st_get(st, 2))
        st_set(st, 5, bump_cstr(st, st_get(st, 26), st_get(st, 59) - st_get(st, 26)))
        classify_kw(st)
        out
    end
    # ── comment: # → skip to end of line, restart ──
    if st_get(st, 42) == 35 do
        st_set(st, 18, 1)
        when st_get(st, 18) != 0 loop
            if st_get(st, 2) >= st_get(st, 1) do
                st_set(st, 18, 0)
            else
                st_set(st, 58, read_byte(st_get(st, 0), st_get(st, 2)))
                st_set(st, 2, st_get(st, 2) + 1)
                if st_get(st, 58) == 10 do
                    st_set(st, 18, 0)
                end
            end
        end
        next_tok(st)
        out
    end
    # ── string literal "..." or """...""" ──
    if st_get(st, 42) == 34 do
        if st_get(st, 2) + 2 < st_get(st, 1) do
            if read_byte(st_get(st, 0), st_get(st, 2) + 1) == 34 do
                if read_byte(st_get(st, 0), st_get(st, 2) + 2) == 34 do
                    st_set(st, 2, st_get(st, 2) + 3)
                    st_set(st, 26, st_get(st, 2))
                    st_set(st, 18, 1)
                    when st_get(st, 18) != 0 loop
                        if st_get(st, 2) + 2 >= st_get(st, 1) do
                            st_set(st, 18, 0)
                        else
                            if read_byte(st_get(st, 0), st_get(st, 2)) == 34 do
                                if read_byte(st_get(st, 0), st_get(st, 2) + 1) == 34 do
                                    if read_byte(st_get(st, 0), st_get(st, 2) + 2) == 34 do
                                        st_set(st, 18, 0)
                                    else
                                        st_set(st, 2, st_get(st, 2) + 1)
                                    end
                                else
                                    st_set(st, 2, st_get(st, 2) + 1)
                                end
                            else
                                st_set(st, 2, st_get(st, 2) + 1)
                            end
                        end
                    end
                    st_set(st, 5, bump_cstr(st, st_get(st, 26), st_get(st, 2) - st_get(st, 26)))
                    st_set(st, 4, st_get(st, 2) - st_get(st, 26))
                    if st_get(st, 2) + 2 < st_get(st, 1) do
                        st_set(st, 2, st_get(st, 2) + 3)
                    end
                    st_set(st, 3, 35)
                    out
                end
            end
        end
        st_set(st, 2, st_get(st, 2) + 1)
        st_set(st, 26, st_get(st, 2))
        st_set(st, 18, 1)
        when st_get(st, 18) != 0 loop
            if st_get(st, 2) >= st_get(st, 1) do
                st_set(st, 18, 0)
            else
                st_set(st, 58, read_byte(st_get(st, 0), st_get(st, 2)))
                if st_get(st, 58) == 92 do
                    st_set(st, 2, st_get(st, 2) + 2)
                else
                    if st_get(st, 58) == 34 do
                        st_set(st, 18, 0)
                    else
                        st_set(st, 2, st_get(st, 2) + 1)
                    end
                end
            end
        end
        st_set(st, 5, bump_unescaped_cstr(st, st_get(st, 26), st_get(st, 2) - st_get(st, 26)))
        if st_get(st, 2) < st_get(st, 1) do
            st_set(st, 2, st_get(st, 2) + 1)
        end
        st_set(st, 3, 35)
        out
    end
    # ── character literal 'c' ──
    if st_get(st, 42) == 39 do
        st_set(st, 2, st_get(st, 2) + 1)
        var cv = 0
        if st_get(st, 2) < st_get(st, 1) do
            let cb = read_byte(st_get(st, 0), st_get(st, 2))
            if cb == 92 do
                st_set(st, 2, st_get(st, 2) + 1)
                if st_get(st, 2) < st_get(st, 1) do
                    let esc = read_byte(st_get(st, 0), st_get(st, 2))
                    cv = esc
                    if esc == 110 do cv = 10 end
                    if esc == 116 do cv = 9 end
                    if esc == 114 do cv = 13 end
                    if esc == 48 do cv = 0 end
                    if esc == 92 do cv = 92 end
                    if esc == 39 do cv = 39 end
                    if esc == 34 do cv = 34 end
                    st_set(st, 2, st_get(st, 2) + 1)
                end
            else
                cv = cb
                st_set(st, 2, st_get(st, 2) + 1)
            end
        end
        if st_get(st, 2) < st_get(st, 1) do
            if read_byte(st_get(st, 0), st_get(st, 2)) == 39 do
                st_set(st, 2, st_get(st, 2) + 1)
            end
        end
        st_set(st, 4, cv)
        st_set(st, 3, 2)
        out
    end
    # ── number (decimal or hex 0x…) ──
    st_set(st, 46, 0)
    if st_get(st, 42) >= 48 do
        if st_get(st, 42) <= 57 do
            st_set(st, 46, 1)
        end
    end
    if st_get(st, 46) != 0 do
        st_set(st, 4, 0)
        # Hex 0x… — peek next byte (pos still on first digit).
        st_set(st, 60, 0)
        if st_get(st, 42) == 48 do
            if st_get(st, 2) + 1 < st_get(st, 1) do
                if read_byte(st_get(st, 0), st_get(st, 2) + 1) == 120 do
                    st_set(st, 60, 1)
                    st_set(st, 2, st_get(st, 2) + 2)
                end
            end
        end
        if st_get(st, 60) != 0 do
            # hex digits from pos
            st_set(st, 18, 1)
            when st_get(st, 18) != 0 loop
                st_set(st, 57, st_get(st, 2))
                if st_get(st, 57) >= st_get(st, 1) do
                    st_set(st, 18, 0)
                else
                    st_set(st, 58, read_byte(st_get(st, 0), st_get(st, 57)))
                    st_set(st, 61, 0 - 1)
                    if st_get(st, 58) >= 48 do
                        if st_get(st, 58) <= 57 do
                            st_set(st, 61, st_get(st, 58) - 48)
                        end
                    end
                    if st_get(st, 58) >= 97 do
                        if st_get(st, 58) <= 102 do
                            st_set(st, 61, st_get(st, 58) - 87)
                        end
                    end
                    if st_get(st, 58) >= 65 do
                        if st_get(st, 58) <= 70 do
                            st_set(st, 61, st_get(st, 58) - 55)
                        end
                    end
                    if st_get(st, 61) < 0 do
                        st_set(st, 18, 0)
                    else
                        st_set(st, 4, st_get(st, 4) * 16 + st_get(st, 61))
                        st_set(st, 2, st_get(st, 57) + 1)
                    end
                end
            end
        else
            # decimal — consume every digit from pos (includes first)
            st_set(st, 18, 1)
            when st_get(st, 18) != 0 loop
                st_set(st, 57, st_get(st, 2))
                if st_get(st, 57) >= st_get(st, 1) do
                    st_set(st, 18, 0)
                else
                    st_set(st, 58, read_byte(st_get(st, 0), st_get(st, 57)))
                    if st_get(st, 58) >= 48 do
                        if st_get(st, 58) <= 57 do
                            st_set(st, 4, st_get(st, 4) * 10 + (st_get(st, 58) - 48))
                            st_set(st, 2, st_get(st, 57) + 1)
                        else
                            st_set(st, 18, 0)
                        end
                    else
                        st_set(st, 18, 0)
                    end
                end
            end
        end
        st_set(st, 3, 2)
        out
    end
    # ── single / double-char punctuation ──
    st_set(st, 2, st_get(st, 2) + 1)
    st_set(st, 3, 0)
    if st_get(st, 42) == 40 do
        st_set(st, 3, 9)
    end
    if st_get(st, 42) == 41 do
        st_set(st, 3, 10)
    end
    if st_get(st, 42) == 58 do
        st_set(st, 3, 11)
    end
    if st_get(st, 42) == 59 do
        st_set(st, 3, 12)
    end
    if st_get(st, 42) == 44 do
        st_set(st, 3, 13)
    end
    if st_get(st, 42) == 91 do
        st_set(st, 3, 110)
    end
    if st_get(st, 42) == 93 do
        st_set(st, 3, 111)
    end
    # '+' or '+='
    if st_get(st, 42) == 43 do
        if st_get(st, 2) < st_get(st, 1) do
            if read_byte(st_get(st, 0), st_get(st, 2)) == 61 do
                st_set(st, 3, 86)
                st_set(st, 2, st_get(st, 2) + 1)
            else
                st_set(st, 3, 14)
            end
        else
            st_set(st, 3, 14)
        end
    end
    # '.' or '..'
    if st_get(st, 42) == 46 do
        if st_get(st, 2) < st_get(st, 1) do
            if read_byte(st_get(st, 0), st_get(st, 2)) == 46 do
                st_set(st, 3, 85)
                st_set(st, 2, st_get(st, 2) + 1)
            else
                st_set(st, 3, 16)
            end
        else
            st_set(st, 3, 16)
        end
    end
    # '*' or '*='
    if st_get(st, 42) == 42 do
        if st_get(st, 2) < st_get(st, 1) do
            if read_byte(st_get(st, 0), st_get(st, 2)) == 61 do
                st_set(st, 3, 88)
                st_set(st, 2, st_get(st, 2) + 1)
            else
                st_set(st, 3, 20)
            end
        else
            st_set(st, 3, 20)
        end
    end
    # '-' or '-='
    if st_get(st, 42) == 45 do
        if st_get(st, 2) < st_get(st, 1) do
            if read_byte(st_get(st, 0), st_get(st, 2)) == 61 do
                st_set(st, 3, 87)
                st_set(st, 2, st_get(st, 2) + 1)
            else
                st_set(st, 3, 21)
            end
        else
            st_set(st, 3, 21)
        end
    end
    # '/' or '/='
    if st_get(st, 42) == 47 do
        if st_get(st, 2) < st_get(st, 1) do
            if read_byte(st_get(st, 0), st_get(st, 2)) == 61 do
                st_set(st, 3, 89)
                st_set(st, 2, st_get(st, 2) + 1)
            else
                st_set(st, 3, 22)
            end
        else
            st_set(st, 3, 22)
        end
    end
    # '=' or '=='
    if st_get(st, 42) == 61 do
        if st_get(st, 2) < st_get(st, 1) do
            if read_byte(st_get(st, 0), st_get(st, 2)) == 61 do
                st_set(st, 3, 28)
                st_set(st, 2, st_get(st, 2) + 1)
            else
                st_set(st, 3, 15)
            end
        else
            st_set(st, 3, 15)
        end
    end
    # '<' or '<='
    if st_get(st, 42) == 60 do
        if st_get(st, 2) < st_get(st, 1) do
            if read_byte(st_get(st, 0), st_get(st, 2)) == 61 do
                st_set(st, 3, 23)
                st_set(st, 2, st_get(st, 2) + 1)
            else
                st_set(st, 3, 24)
            end
        else
            st_set(st, 3, 24)
        end
    end
    # '>' or '>=' or '>>'
    if st_get(st, 42) == 62 do
        if st_get(st, 2) < st_get(st, 1) do
            if read_byte(st_get(st, 0), st_get(st, 2)) == 62 do
                st_set(st, 3, 131)
                st_set(st, 2, st_get(st, 2) + 1)
            else
                if read_byte(st_get(st, 0), st_get(st, 2)) == 61 do
                    st_set(st, 3, 25)
                    st_set(st, 2, st_get(st, 2) + 1)
                else
                    st_set(st, 3, 26)
                end
            end
        else
            st_set(st, 3, 26)
        end
    end
    # '!' or '!='
    if st_get(st, 42) == 33 do
        if st_get(st, 2) < st_get(st, 1) do
            if read_byte(st_get(st, 0), st_get(st, 2)) == 61 do
                st_set(st, 3, 27)
                st_set(st, 2, st_get(st, 2) + 1)
            else
                st_set(st, 3, 129)
            end
        else
            st_set(st, 3, 129)
        end
    end
    # '&' or '&&' or '&mut'
    if st_get(st, 42) == 38 do
        if st_get(st, 2) < st_get(st, 1) do
            if read_byte(st_get(st, 0), st_get(st, 2)) == 38 do
                st_set(st, 3, 127)
                st_set(st, 2, st_get(st, 2) + 1)
            else
                if st_get(st, 2) + 2 < st_get(st, 1) do
                    if read_byte(st_get(st, 0), st_get(st, 2)) == 109 do
                        if read_byte(st_get(st, 0), st_get(st, 2) + 1) == 117 do
                            if read_byte(st_get(st, 0), st_get(st, 2) + 2) == 116 do
                                st_set(st, 3, 77)
                                st_set(st, 2, st_get(st, 2) + 3)
                            else
                                st_set(st, 3, 76)
                            end
                        else
                            st_set(st, 3, 76)
                        end
                    else
                        st_set(st, 3, 76)
                    end
                else
                    st_set(st, 3, 76)
                end
            end
        else
            st_set(st, 3, 76)
        end
    end
    # '|' or '||'
    if st_get(st, 42) == 124 do
        if st_get(st, 2) < st_get(st, 1) do
            if read_byte(st_get(st, 0), st_get(st, 2)) == 124 do
                st_set(st, 3, 128)
                st_set(st, 2, st_get(st, 2) + 1)
            else
                st_set(st, 3, 41)
            end
        else
            st_set(st, 3, 41)
        end
    end
    # '^'
    if st_get(st, 42) == 94 do
        st_set(st, 3, 130)
    end
    # '?' or '?.' or '?=' or '?=/='
    if st_get(st, 42) == 63 do
        if st_get(st, 2) < st_get(st, 1) do
            if read_byte(st_get(st, 0), st_get(st, 2)) == 46 do
                st_set(st, 3, 126)
                st_set(st, 2, st_get(st, 2) + 1)
            else
                if read_byte(st_get(st, 0), st_get(st, 2)) == 61 do
                    if st_get(st, 2) + 2 < st_get(st, 1) do
                        if read_byte(st_get(st, 0), st_get(st, 2) + 1) == 47 do
                            if read_byte(st_get(st, 0), st_get(st, 2) + 2) == 61 do
                                st_set(st, 3, 125)
                                st_set(st, 2, st_get(st, 2) + 3)
                            else
                                st_set(st, 3, 124)
                                st_set(st, 2, st_get(st, 2) + 1)
                            end
                        else
                            st_set(st, 3, 124)
                            st_set(st, 2, st_get(st, 2) + 1)
                        end
                    else
                        st_set(st, 3, 124)
                        st_set(st, 2, st_get(st, 2) + 1)
                    end
                else
                    st_set(st, 3, 63)
                end
            end
        else
            st_set(st, 3, 63)
        end
    end
end.

func emit_u32(st, w):
    # No `let buf/n` — Stage-0 mis-slots `st` in `let x = st_get(st, …)`.
    if st_get(st, 9) + 4 > st_get(st, 220) do
        print(90)
        exit_prog(1)
    end
    write_byte(st_get(st, 8), st_get(st, 9), w bit_and 255)
    write_byte(st_get(st, 8), st_get(st, 9) + 1, (w shr 8) bit_and 255)
    write_byte(st_get(st, 8), st_get(st, 9) + 2, (w shr 16) bit_and 255)
    write_byte(st_get(st, 8), st_get(st, 9) + 3, (w shr 24) bit_and 255)
    st_set(st, 9, st_get(st, 9) + 4)
end.

func emit_u32_at:
    in
        st
        off
        w
    write_byte(st_get(st, 8), off, w bit_and 255)
    write_byte(st_get(st, 8), off + 1, (w shr 8) bit_and 255)
    write_byte(st_get(st, 8), off + 2, (w shr 16) bit_and 255)
    write_byte(st_get(st, 8), off + 3, (w shr 24) bit_and 255)
end.

func emit_runtime(st):
    st_set(st, 10, st_get(st, 9))
    # Preserve callee-saved x19-x26 (Stage-1 RA keeps locals there).
    emit_u32(st, 0xA9BF53F3)
    emit_u32(st, 0xA9BF5BF5)
    emit_u32(st, 0xA9BF63F7)
    emit_u32(st, 0xA9BF6BF9)
    emit_u32(st, 0xA9BA7BFD)
    emit_u32(st, 0x910003FD)
    emit_u32(st, 0xAA0003F3)
    emit_u32(st, 0x910043F4)
    emit_u32(st, 0xD2800015)
    emit_u32(st, 0xD2800016)
    emit_u32(st, 0xF100027F)
    emit_u32(st, 0x5400006A)
    emit_u32(st, 0xCB1303F3)
    emit_u32(st, 0xD2800036)
    st_set(st, 28, st_get(st, 9))
    emit_u32(st, 0xB4000013)
    emit_u32(st, 0xD2800157)
    st_set(st, 29, st_get(st, 9))
    st_set(st, 30, st_get(st, 9))
    emit_u32(st, 0xB4000013)
    emit_u32(st, 0x9AD70A78)
    emit_u32(st, 0x9B17CF19)
    emit_u32(st, 0x9100C339)
    emit_u32(st, 0x38356A99)
    emit_u32(st, 0x910006B5)
    emit_u32(st, 0xAA1803F3)
    st_set(st, 31, (st_get(st, 29) - st_get(st, 9)) / 4)
    emit_u32(st, 0x14000000 bit_or (st_get(st, 31) bit_and 0x03FFFFFF))
    st_set(st, 32, st_get(st, 9))
    emit_u32(st, 0x14000000)
    st_set(st, 33, st_get(st, 9))
    emit_u32(st, 0xD2800619)
    emit_u32(st, 0x38356A99)
    emit_u32(st, 0x910006B5)
    st_set(st, 34, st_get(st, 9))
    emit_u32_at(st, st_get(st, 28), 0xB4000013 bit_or ((((st_get(st, 33) - st_get(st, 28)) / 4) bit_and 0x7FFFF) shl 5))
    emit_u32_at(st, st_get(st, 30), 0xB4000013 bit_or ((((st_get(st, 34) - st_get(st, 30)) / 4) bit_and 0x7FFFF) shl 5))
    emit_u32_at(st, st_get(st, 32), 0x14000000 bit_or (((st_get(st, 34) - st_get(st, 32)) / 4) bit_and 0x03FFFFFF))
    st_set(st, 35, st_get(st, 9))
    emit_u32(st, 0xB4000016)
    emit_u32(st, 0xD28005B9)
    emit_u32(st, 0x38356A99)
    emit_u32(st, 0x910006B5)
    st_set(st, 36, st_get(st, 9))
    emit_u32_at(st, st_get(st, 35), 0xB4000016 bit_or ((((st_get(st, 36) - st_get(st, 35)) / 4) bit_and 0x7FFFF) shl 5))
    emit_u32(st, 0xD2800017)
    emit_u32(st, 0xAA1503F8)
    emit_u32(st, 0xD1000718)
    st_set(st, 37, st_get(st, 9))
    emit_u32(st, 0xEB1802FF)
    st_set(st, 38, st_get(st, 9))
    emit_u32(st, 0x5400000A)
    emit_u32(st, 0x38776A99)
    emit_u32(st, 0x38786A9A)
    emit_u32(st, 0x38376A9A)
    emit_u32(st, 0x38386A99)
    emit_u32(st, 0x910006F7)
    emit_u32(st, 0xD1000718)
    st_set(st, 39, (st_get(st, 37) - st_get(st, 9)) / 4)
    emit_u32(st, 0x14000000 bit_or (st_get(st, 39) bit_and 0x03FFFFFF))
    st_set(st, 40, st_get(st, 9))
    emit_u32_at(st, st_get(st, 38), 0x5400000A bit_or ((((st_get(st, 40) - st_get(st, 38)) / 4) bit_and 0x7FFFF) shl 5))
    emit_u32(st, 0xD2800020)
    emit_u32(st, 0xAA1403E1)
    emit_u32(st, 0xAA1503E2)
    emit_u32(st, 0xD2800090)
    emit_u32(st, 0xF2A04010)
    emit_u32(st, 0xD4001001)
    emit_u32(st, 0xD2800151)
    emit_u32(st, 0xD10043FF)
    emit_u32(st, 0x390003F1)
    emit_u32(st, 0xD2800020)
    emit_u32(st, 0x910003E1)
    emit_u32(st, 0xD2800022)
    emit_u32(st, 0xD2800090)
    emit_u32(st, 0xF2A04010)
    emit_u32(st, 0xD4001001)
    emit_u32(st, 0x910043FF)
    emit_u32(st, 0xA8C67BFD)
    emit_u32(st, 0xA8C16BF9)
    emit_u32(st, 0xA8C163F7)
    emit_u32(st, 0xA8C15BF5)
    emit_u32(st, 0xA8C153F3)
    emit_u32(st, 0xD65F03C0)
    # ── _rt_printstr: X0=ptr X1=len; write + newline ──
    st_set(st, 94, st_get(st, 9))
    emit_u32(st, 0xA9BF7BFD)
    emit_u32(st, 0xAA0103E2)
    emit_u32(st, 0xAA0003E1)
    emit_u32(st, 0xD2800020)
    emit_u32(st, 0xD2800090)
    emit_u32(st, 0xF2A04010)
    emit_u32(st, 0xD4001001)
    emit_u32(st, 0xD2800151)
    emit_u32(st, 0xD10043FF)
    emit_u32(st, 0x390003F1)
    emit_u32(st, 0xD2800020)
    emit_u32(st, 0x910003E1)
    emit_u32(st, 0xD2800022)
    emit_u32(st, 0xD2800090)
    emit_u32(st, 0xF2A04010)
    emit_u32(st, 0xD4001001)
    emit_u32(st, 0x910043FF)
    emit_u32(st, 0xA8C17BFD)
    emit_u32(st, 0xD65F03C0)
    # ── _rt_argc: LDR X0, [X27] ──
    st_set(st, 93, st_get(st, 9))
    emit_u32(st, 0xF9400360)
    emit_u32(st, 0xD65F03C0)
    # ── _rt_get_arg: LDR X1,[X27,#8]; LDR X0,[X1,X0,LSL#3] ──
    st_set(st, 92, st_get(st, 9))
    emit_u32(st, 0xF9400761)
    emit_u32(st, 0xF8607820)
    emit_u32(st, 0xD65F03C0)
    # ── _rt_alloc: X0=size → bump at [X27,#24] ──
    st_set(st, 91, st_get(st, 9))
    emit_u32(st, 0xA9BE7BFD)
    emit_u32(st, 0xF9000BE0)
    emit_u32(st, 0xF9400F61)
    st_set(st, 28, st_get(st, 9))
    emit_u32(st, 0xB4000001)
    st_set(st, 29, st_get(st, 9))
    emit_u32(st, 0xAA0103E0)
    emit_u32(st, 0xF9400BE2)
    # Round size (X2) up to 16-byte boundary: (size + 15) & ~15
    emit_u32(st, 0x91003C42)
    emit_u32(st, 0x927DEC42)
    emit_u32(st, 0x8B020021)
    emit_u32(st, 0xF9000F61)
    emit_u32(st, 0xA8C27BFD)
    emit_u32(st, 0xD65F03C0)
    st_set(st, 30, st_get(st, 9))
    emit_u32_at(st, st_get(st, 28), 0xB4000001 bit_or ((((st_get(st, 30) - st_get(st, 28)) / 4) bit_and 0x7FFFF) shl 5))
    emit_u32(st, 0xD2800000)
    # MOVZ X1, #0x1000, LSL#16 → 256MiB virtual heap (zero physical cost until pages touched)
    emit_u32(st, 0xD2A20001)
    emit_u32(st, 0xD2800062)
    # MOVZ X3, #0x1002 (MAP_PRIVATE|MAP_ANON) — imm16 at bits[20:5]
    emit_u32(st, 0xD2820043)
    emit_u32(st, 0x92800004)
    emit_u32(st, 0xD2800005)
    emit_u32(st, 0xD28018B0)
    emit_u32(st, 0xF2A04010)
    emit_u32(st, 0xD4001001)
    emit_u32(st, 0xF9000F60)
    emit_u32(st, 0xF9400F61)
    st_set(st, 31, (st_get(st, 29) - st_get(st, 9)) / 4)
    emit_u32(st, 0x14000000 bit_or (st_get(st, 31) bit_and 0x03FFFFFF))

    # ── _rt_slurp_len: LDR X0, [X27,#16] ──
    st_set(st, 230, st_get(st, 9))
    emit_u32(st, 0xF9400B60)
    emit_u32(st, 0xD65F03C0)

    # ── _rt_slurp: X0=path → X0=ptr; len → [X27,#16] (port of boot) ──
    st_set(st, 87, st_get(st, 9))
    emit_u32(st, 0xA9BD7BFD)
    emit_u32(st, 0xF9000BE0)
    emit_u32(st, 0xD2800001)
    emit_u32(st, 0xD2800002)
    emit_u32(st, 0xD28000B0)
    emit_u32(st, 0xF2A04010)
    emit_u32(st, 0xD4001001)
    emit_u32(st, 0xF100001F)
    st_set(st, 28, st_get(st, 9))
    emit_u32(st, 0x5400000B)
    emit_u32(st, 0xF9000FE0)
    emit_u32(st, 0xD2800001)
    emit_u32(st, 0xD2800042)
    emit_u32(st, 0xD28018F0)
    emit_u32(st, 0xF2A04010)
    emit_u32(st, 0xD4001001)
    emit_u32(st, 0xF100001F)
    st_set(st, 29, st_get(st, 9))
    emit_u32(st, 0x5400000B)
    st_set(st, 30, st_get(st, 9))
    emit_u32(st, 0xB4000000)
    emit_u32(st, 0xF90013E0)
    emit_u32(st, 0xF9400FE0)
    emit_u32(st, 0xD2800001)
    emit_u32(st, 0xD2800002)
    emit_u32(st, 0xD28018F0)
    emit_u32(st, 0xF2A04010)
    emit_u32(st, 0xD4001001)
    emit_u32(st, 0xF94013E1)
    emit_u32(st, 0xD2800000)
    emit_u32(st, 0xD2800022)
    emit_u32(st, 0xD2800063)
    emit_u32(st, 0xF9400FE4)
    emit_u32(st, 0xD2800005)
    emit_u32(st, 0xD28018B0)
    emit_u32(st, 0xF2A04010)
    emit_u32(st, 0xD4001001)
    emit_u32(st, 0xF90017E0)
    emit_u32(st, 0xF9400FE0)
    emit_u32(st, 0xD28000D0)
    emit_u32(st, 0xF2A04010)
    emit_u32(st, 0xD4001001)
    emit_u32(st, 0xF94013E0)
    emit_u32(st, 0xF9000B60)
    emit_u32(st, 0xF94017E0)
    emit_u32(st, 0xA8C37BFD)
    emit_u32(st, 0xD65F03C0)
    st_set(st, 31, st_get(st, 9))
    emit_u32_at(st, st_get(st, 28), 0x5400000B bit_or ((((st_get(st, 31) - st_get(st, 28)) / 4) bit_and 0x7FFFF) shl 5))
    emit_u32_at(st, st_get(st, 29), 0x5400000B bit_or ((((st_get(st, 31) - st_get(st, 29)) / 4) bit_and 0x7FFFF) shl 5))
    emit_u32_at(st, st_get(st, 30), 0xB4000000 bit_or ((((st_get(st, 31) - st_get(st, 30)) / 4) bit_and 0x7FFFF) shl 5))
    emit_u32(st, 0xD2800000)
    emit_u32(st, 0xA8C37BFD)
    emit_u32(st, 0xD65F03C0)

    # ── _rt_write: X0=path X1=buf X2=len → X0=1/0 ──
    st_set(st, 229, st_get(st, 9))
    emit_u32(st, 0xA9BD7BFD)
    emit_u32(st, 0xF9000BE0)
    emit_u32(st, 0xF9000FE1)
    emit_u32(st, 0xF90013E2)
    emit_u32(st, 0xD280C021)
    emit_u32(st, 0xD2803DA2)
    emit_u32(st, 0xD28000B0)
    emit_u32(st, 0xF2A04010)
    emit_u32(st, 0xD4001001)
    emit_u32(st, 0xF100001F)
    st_set(st, 28, st_get(st, 9))
    emit_u32(st, 0x5400000B)
    emit_u32(st, 0xF90017E0)
    emit_u32(st, 0xF9400FE1)
    emit_u32(st, 0xF94013E2)
    emit_u32(st, 0xD2800090)
    emit_u32(st, 0xF2A04010)
    emit_u32(st, 0xD4001001)
    emit_u32(st, 0xF94017E0)
    emit_u32(st, 0xD28000D0)
    emit_u32(st, 0xF2A04010)
    emit_u32(st, 0xD4001001)
    emit_u32(st, 0xD2800020)
    emit_u32(st, 0xA8C37BFD)
    emit_u32(st, 0xD65F03C0)
    st_set(st, 29, st_get(st, 9))
    emit_u32_at(st, st_get(st, 28), 0x5400000B bit_or ((((st_get(st, 29) - st_get(st, 28)) / 4) bit_and 0x7FFFF) shl 5))
    emit_u32(st, 0xD2800000)
    emit_u32(st, 0xA8C37BFD)
    emit_u32(st, 0xD65F03C0)

    # ── _rt_str_len: X0=ptr → X0=len (st[420]) ──
    st_set(st, 420, st_get(st, 9))
    emit_u32(st, 0xAA0003E1)
    emit_u32(st, 0x39400022)
    emit_u32(st, 0x34000062)
    emit_u32(st, 0x91000421)
    emit_u32(st, 0x17FFFFFD)
    emit_u32(st, 0xCB000020)
    emit_u32(st, 0xD65F03C0)

    # ── _rt_str_eq: X0=ptr1, X1=ptr2 → X0=1/0 (st[421]) ──
    st_set(st, 421, st_get(st, 9))
    emit_u32(st, 0xEB01001F)
    emit_u32(st, 0x540000C0)
    emit_u32(st, 0x38401402)
    emit_u32(st, 0x38401423)
    emit_u32(st, 0x6B03005F)
    emit_u32(st, 0x54000081)
    emit_u32(st, 0x35FFFF82)
    emit_u32(st, 0xD2800020)
    emit_u32(st, 0xD65F03C0)
    emit_u32(st, 0xD2800000)
    emit_u32(st, 0xD65F03C0)

    # ── _rt_str_concat: X0=ptr1, X1=ptr2 → X0=new_ptr (st[422]) ──
    st_set(st, 422, st_get(st, 9))
    emit_u32(st, 0xA9BD53F3)
    emit_u32(st, 0xA9015BF5)
    emit_u32(st, 0xA9027BF7)
    emit_u32(st, 0xAA0003F3)
    emit_u32(st, 0xAA0103F4)
    emit_bl(st, st_get(st, 420))
    emit_u32(st, 0xAA0003F5)
    emit_u32(st, 0xAA1403E0)
    emit_bl(st, st_get(st, 420))
    emit_u32(st, 0xAA0003F6)
    emit_u32(st, 0x8B1602A0)
    emit_u32(st, 0x91000400)
    emit_bl(st, st_get(st, 91))
    emit_u32(st, 0xAA0003F7)
    emit_u32(st, 0xAA1703E0)
    emit_u32(st, 0xAA1303E1)
    emit_u32(st, 0xAA1503E2)
    emit_u32(st, 0xB40000A2)
    emit_u32(st, 0x38401423)
    emit_u32(st, 0x38001403)
    emit_u32(st, 0xD1000442)
    emit_u32(st, 0x17FFFFFC)
    emit_u32(st, 0xAA1403E1)
    emit_u32(st, 0xAA1603E2)
    emit_u32(st, 0xB40000A2)
    emit_u32(st, 0x38401423)
    emit_u32(st, 0x38001403)
    emit_u32(st, 0xD1000442)
    emit_u32(st, 0x17FFFFFC)
    emit_u32(st, 0x3900001F)
    emit_u32(st, 0xAA1703E0)
    emit_u32(st, 0xA9415BF5)
    emit_u32(st, 0xA9427BF7)
    emit_u32(st, 0xA8C353F3)
    emit_u32(st, 0xD65F03C0)

    # ── _rt_int_to_str: X0=val → X0=ptr (st[423]) ──
    st_set(st, 423, st_get(st, 9))
    emit_u32(st, 0xA9BD53F3)
    emit_u32(st, 0xA9015BF5)
    emit_u32(st, 0xA9027BF7)
    emit_u32(st, 0xD10083FF)
    emit_u32(st, 0xAA0003F3)
    emit_u32(st, 0xD2800014)
    emit_u32(st, 0xF100027F)
    emit_u32(st, 0x5400006A)
    emit_u32(st, 0xD2800034)
    emit_u32(st, 0xCB1303F3)
    emit_u32(st, 0x91007FF5)
    emit_u32(st, 0xD2800016)
    emit_u32(st, 0xD2800141)
    emit_u32(st, 0x9AC10A62)
    emit_u32(st, 0x9B01CC43)
    emit_u32(st, 0x1100C063)
    emit_u32(st, 0xD10006B5)
    emit_u32(st, 0x390002A3)
    emit_u32(st, 0x910006D6)
    emit_u32(st, 0xAA0203F3)
    emit_u32(st, 0xB5FFFF13)
    emit_u32(st, 0xB40000B4)
    emit_u32(st, 0xD10006B5)
    emit_u32(st, 0x528005A3)
    emit_u32(st, 0x390002A3)
    emit_u32(st, 0x910006D6)
    emit_u32(st, 0x910006C0)
    emit_bl(st, st_get(st, 91))
    emit_u32(st, 0xAA0003F7)
    emit_u32(st, 0xAA1703E0)
    emit_u32(st, 0xAA1503E1)
    emit_u32(st, 0xAA1603E2)
    emit_u32(st, 0xB40000A2)
    emit_u32(st, 0x38401423)
    emit_u32(st, 0x38001403)
    emit_u32(st, 0xD1000442)
    emit_u32(st, 0x17FFFFFC)
    emit_u32(st, 0x3900001F)
    emit_u32(st, 0x910083FF)
    emit_u32(st, 0xAA1703E0)
    emit_u32(st, 0xA9415BF5)
    emit_u32(st, 0xA9427BF7)
    emit_u32(st, 0xA8C353F3)
    emit_u32(st, 0xD65F03C0)

    # ── _rt_print_str: X0=ptr → prints with len + \n (st[424]) ──
    st_set(st, 424, st_get(st, 9))
    emit_u32(st, 0xA9BF7BF3)     # stp x19, x30, [sp, #-16]!
    emit_u32(st, 0xAA0003F3)     # mov x19, x0
    emit_bl(st, st_get(st, 420)) # call _rt_str_len
    emit_u32(st, 0xAA0003E1)     # mov x1, x0
    emit_u32(st, 0xAA1303E0)     # mov x0, x19
    emit_bl(st, st_get(st, 94))  # call _rt_printstr
    emit_u32(st, 0xA8C17BF3)     # ldp x19, x30, [sp], #16
    emit_u32(st, 0xD65F03C0)     # ret

    # ── _rt_exit: X0=code → SYS_EXIT ──
    st_set(st, 88, st_get(st, 9))
    emit_u32(st, 0xD2800030)
    emit_u32(st, 0xF2A04010)
    emit_u32(st, 0xD4001001)
end.

# builtin_kind: 0=none 1=alloc 2=read_byte 3=write_byte 4=read_word
# 5=write_word 6=get_arg 7=arg_count 8=exit_prog 9=slurp_file
# 10=slurp_len 11=write_bytes 12=str_len 13=str_concat 14=int_to_str 15=str_eq 16=print_str
func builtin_kind(st, name):
    st_set(st, 70, 0)
    if ident_is_str(name, "alloc") != 0 do st_set(st, 70, 1) end
    if ident_is_str(name, "read_byte") != 0 do st_set(st, 70, 2) end
    if ident_is_str(name, "write_byte") != 0 do st_set(st, 70, 3) end
    if ident_is_str(name, "read_word") != 0 do st_set(st, 70, 4) end
    if ident_is_str(name, "write_word") != 0 do st_set(st, 70, 5) end
    if ident_is_str(name, "getarg") != 0 do st_set(st, 70, 6) end
    if ident_is_str(name, "get_arg") != 0 do st_set(st, 70, 6) end
    if ident_is_str(name, "argc") != 0 do st_set(st, 70, 7) end
    if ident_is_str(name, "arg_count") != 0 do st_set(st, 70, 7) end
    if ident_is_str(name, "exit_prog") != 0 do st_set(st, 70, 8) end
    if ident_is_str(name, "slurp_file") != 0 do st_set(st, 70, 9) end
    if ident_is_str(name, "slurp_len") != 0 do st_set(st, 70, 10) end
    if ident_is_str(name, "write_bytes") != 0 do st_set(st, 70, 11) end
    if ident_is_str(name, "str_len") != 0 do st_set(st, 70, 12) end
    if ident_is_str(name, "str_concat") != 0 do st_set(st, 70, 13) end
    if ident_is_str(name, "int_to_str") != 0 do st_set(st, 70, 14) end
    if ident_is_str(name, "str_eq") != 0 do st_set(st, 70, 15) end
    if ident_is_str(name, "print_str") != 0 do st_set(st, 70, 16) end
    if ident_is_str(name, "len") != 0 do st_set(st, 70, 17) end
    if ident_is_str(name, "cap") != 0 do st_set(st, 70, 18) end
    out st_get(st, 70)
end.

# Emit builtin after args are in x0/x1/x2. Kind in st[55].
func emit_builtin(st):
    if st_get(st, 55) == 1 do
        emit_bl(st, st_get(st, 91))
    end
    if st_get(st, 55) == 2 do
        emit_u32(st, 0x38616800)
    end
    if st_get(st, 55) == 3 do
        emit_u32(st, 0x38216802)
    end
    if st_get(st, 55) == 4 do
        emit_u32(st, 0xF8616800)
    end
    if st_get(st, 55) == 5 do
        emit_u32(st, 0xF8216802)
    end
    if st_get(st, 55) == 6 do
        emit_bl(st, st_get(st, 92))
    end
    if st_get(st, 55) == 7 do
        emit_bl(st, st_get(st, 93))
    end
    if st_get(st, 55) == 8 do
        emit_bl(st, st_get(st, 88))
    end
    if st_get(st, 55) == 9 do
        emit_bl(st, st_get(st, 87))
    end
    if st_get(st, 55) == 10 do
        emit_bl(st, st_get(st, 230))
    end
    if st_get(st, 55) == 11 do
        emit_bl(st, st_get(st, 229))
    end
    if st_get(st, 55) == 12 do
        emit_bl(st, st_get(st, 420))
    end
    if st_get(st, 55) == 13 do
        emit_bl(st, st_get(st, 422))
    end
    if st_get(st, 55) == 14 do
        emit_bl(st, st_get(st, 423))
    end
    if st_get(st, 55) == 15 do
        emit_bl(st, st_get(st, 421))
    end
    if st_get(st, 55) == 16 do
        emit_bl(st, st_get(st, 424))
    end
    if st_get(st, 55) == 17 do
        emit_u32(st, 0xF85F8008) # ldur x8, [x0, #-8]
        emit_u32(st, 0xAA0803E0) # mov x0, x8
    end
    if st_get(st, 55) == 18 do
        emit_u32(st, 0xF85F8008) # ldur x8, [x0, #-8]
        emit_u32(st, 0xAA0803E0) # mov x0, x8
    end
end.

func emit_movz_x8(st, imm):
    emit_u32(st, 0xD2800008 bit_or ((imm bit_and 65535) shl 5))
end.

func emit_movz_x9(st, imm):
    emit_u32(st, 0xD2800009 bit_or ((imm bit_and 65535) shl 5))
end.

# Load 64-bit imm into x8 via MOVZ + up to 3 MOVK.
func emit_movz64(st, imm):
    emit_u32(st, 0xD2800008 bit_or ((imm bit_and 65535) shl 5))
    st_set(st, 70, (imm shr 16) bit_and 65535)
    if st_get(st, 70) != 0 do
        emit_u32(st, 0xF2A00008 bit_or (st_get(st, 70) shl 5))
    end
    st_set(st, 70, (imm shr 32) bit_and 65535)
    if st_get(st, 70) != 0 do
        emit_u32(st, 0xF2C00008 bit_or (st_get(st, 70) shl 5))
    end
    st_set(st, 70, (imm shr 48) bit_and 65535)
    if st_get(st, 70) != 0 do
        emit_u32(st, 0xF2E00008 bit_or (st_get(st, 70) shl 5))
    end
end.

# High byte → bits 31:24 via chained shl-8. Boot mis-lowers a fat 0xF9xxxxxx /
# ORR Xd, XZR, Xm — base 0xAA0003E0
func emit_mov_rr:
    in
        st
        rd
        rm
    st_set(st, 200, (170 shl 24) bit_or 992)
    st_set(st, 201, (rm bit_and 31) shl 16)
    st_set(st, 202, rd bit_and 31)
    emit_u32(st, st_get(st, 200) bit_or st_get(st, 201) bit_or st_get(st, 202))
end.

# Allocate storage for local index `idx`. Prefer phys x19..x26 (8 registers).
func ra_alloc_local(st, idx):
    if st_get(st, 111) < 8 do
        st_set(st, 113, 19 + st_get(st, 111))
        st_set(st, 111, st_get(st, 111) + 1)
        out 0 - (st_get(st, 113) + 1)
    end
    out 16 + idx * 8
end.

# STR/LDR [fp+off], or a mov when the slot is a phys reg (negative).
func emit_str_x8_fp(st, off):
    if off < 0 do
        emit_mov_rr(st, (0 - off) - 1, 8)
    else
        st_set(st, 200, (249 shl 24))
        st_set(st, 201, off / 8)
        st_set(st, 201, st_get(st, 201) bit_and 4095)
        st_set(st, 201, st_get(st, 201) shl 10)
        st_set(st, 202, 29 shl 5)
        st_set(st, 203, st_get(st, 200) bit_or 8 bit_or st_get(st, 201) bit_or st_get(st, 202))
        emit_u32(st, st_get(st, 203))
    end
end.

func emit_ldr_x0_fp(st, off):
    if off < 0 do
        emit_mov_rr(st, 0, (0 - off) - 1)
    else
        st_set(st, 200, (249 shl 24) bit_or (1 shl 22))
        st_set(st, 201, off / 8)
        st_set(st, 201, st_get(st, 201) bit_and 4095)
        st_set(st, 201, st_get(st, 201) shl 10)
        st_set(st, 202, 29 shl 5)
        emit_u32(st, st_get(st, 200) bit_or st_get(st, 201) bit_or st_get(st, 202))
    end
end.

func emit_ldr_x8_fp(st, off):
    if off < 0 do
        emit_mov_rr(st, 8, (0 - off) - 1)
    else
        st_set(st, 200, (249 shl 24) bit_or (1 shl 22) bit_or 8)
        st_set(st, 201, off / 8)
        st_set(st, 201, st_get(st, 201) bit_and 4095)
        st_set(st, 201, st_get(st, 201) shl 10)
        st_set(st, 202, 29 shl 5)
        emit_u32(st, st_get(st, 200) bit_or st_get(st, 201) bit_or st_get(st, 202))
    end
end.

# Load [fp+off] or phys into register xN (N=0..7).
func emit_ldr_xN_fp:
    in
        st
        n
        off
    if off < 0 do
        emit_mov_rr(st, n, (0 - off) - 1)
    else
        st_set(st, 200, (249 shl 24) bit_or (1 shl 22) bit_or (n bit_and 31))
        st_set(st, 201, off / 8)
        st_set(st, 201, st_get(st, 201) bit_and 4095)
        st_set(st, 201, st_get(st, 201) shl 10)
        st_set(st, 202, 29 shl 5)
        emit_u32(st, st_get(st, 200) bit_or st_get(st, 201) bit_or st_get(st, 202))
    end
end.

func emit_load_args(st, num_args, base_off):
    var i = 0
    when i < num_args loop
        emit_ldr_xN_fp(st, i, base_off + i * 8)
        i = i + 1
    end
end.

# Prologue: 4KB locals + 64B callee-save (x19-x26).
func emit_prologue(st):
    emit_u32(st, 0xD14007FF)
    emit_u32(st, 0xD10103FF)
    emit_u32(st, 0xA9007BFD)
    emit_u32(st, 0x910003FD)
    # add x8, x29, #1, lsl #12  → fp+4096; stp x19/x20, x21/x22, x23/x24, x25/x26
    emit_u32(st, 0x914007A8)
    emit_u32(st, 0xA9005113)
    emit_u32(st, 0xA9015915)
    emit_u32(st, 0xA9026117)
    emit_u32(st, 0xA9036919)
end.

func emit_epilogue(st):
    emit_u32(st, 0x914007A8)
    emit_u32(st, 0xA9405113)
    emit_u32(st, 0xA9415915)
    emit_u32(st, 0xA9426117)
    emit_u32(st, 0xA9436919)
    emit_u32(st, 0xA9407BFD)
    emit_u32(st, 0x910103FF)
    emit_u32(st, 0x914007FF)
    emit_u32(st, 0xD65F03C0)
end.

func emit_bl(st, target):
    # `let site = st_get(st, 9)` is fine after the Stage-0 Identifier fix.
    # Avoid a second `let d = (target - site) / 4` — nested BinOp init is still
    # constant-folded to 0 via parse-time vconst (emits `bl #0` → hang).
    let site = st_get(st, 9)
    emit_u32(st, 0x94000000 bit_or (((target - site) / 4) bit_and 0x03FFFFFF))
end.

func emit_bl_later(st, fi):
    # st[226] = call-site capacity (bytes). Overflow used to smash fn_hk (call_tgts+1).
    if st_get(st, 17) * 8 + 8 > st_get(st, 226) do
        print(89)
        exit_prog(1)
    end
    let site = st_get(st, 9)
    emit_u32(st, 0x94000000)
    write_word(st_get(st, 15), st_get(st, 17) * 8, site)
    write_word(st_get(st, 16), st_get(st, 17) * 8, fi)
    st_set(st, 17, st_get(st, 17) + 1)
end.

func cstr_eq:
    in
        st
        a
        b
    if a == 0 do
        if b == 0 do
            out 1
        end
        out 0
    end
    if b == 0 do
        out 0
    end
    st_set(st, 19, 0)
    when st_get(st, 19) < 256 loop
        let i = st_get(st, 19)
        let ca = read_byte(a, i)
        let cb = read_byte(b, i)
        if ca != cb do
            out 0
        end
        if ca == 0 do
            out 1
        end
        st_set(st, 19, i + 1)
    end
    out 0
end.

# djb2 → bucket [0,127]. Scratch st[100..103].
func cstr_hash(st, s):
    st_set(st, 100, 5381)
    st_set(st, 101, 0)
    st_set(st, 102, 1)
    when st_get(st, 102) != 0 loop
        st_set(st, 103, read_byte(s, st_get(st, 101)))
        if st_get(st, 103) == 0 do
            st_set(st, 102, 0)
        else
            st_set(st, 100, (st_get(st, 100) shl 5) + st_get(st, 100) + st_get(st, 103))
            st_set(st, 101, st_get(st, 101) + 1)
        end
    end
    out st_get(st, 100) bit_and 127
end.

# Clear open-addr keys at st[which]. which=95 fn / 97 loc.
func hash_clear_at(st, which):
    st_set(st, 105, 0)
    when st_get(st, 105) < 128 loop
        write_word(st_get(st, which), st_get(st, 105) * 8, 0)
        st_set(st, 105, st_get(st, 105) + 1)
    end
end.

# Get from keys@st[hk] vals@st[hv]. Result → out; -1 if miss.
# Parks name in st[107] so nested Calls cannot clobber the arg.
func hash_get_at:
    in
        st
        hk
        hv
        name
    st_set(st, 107, name)
    st_set(st, 104, cstr_hash(st, st_get(st, 107)))
    st_set(st, 105, 0)
    when st_get(st, 105) < 128 loop
        st_set(st, 106, read_word(st_get(st, hk), st_get(st, 104) * 8))
        if st_get(st, 106) == 0 do
            out 0 - 1
        end
        if cstr_eq(st, st_get(st, 106), st_get(st, 107)) != 0 do
            out read_word(st_get(st, hv), st_get(st, 104) * 8)
        end
        st_set(st, 104, (st_get(st, 104) + 1) bit_and 127)
        st_set(st, 105, st_get(st, 105) + 1)
    end
    out 0 - 1
end.

# Put name→val into keys@st[hk] vals@st[hv].
func hash_put_at:
    in
        st
        hk
        hv
        name
        val
    st_set(st, 107, name)
    st_set(st, 108, val)
    st_set(st, 104, cstr_hash(st, st_get(st, 107)))
    st_set(st, 105, 0)
    when st_get(st, 105) < 128 loop
        st_set(st, 106, read_word(st_get(st, hk), st_get(st, 104) * 8))
        if st_get(st, 106) == 0 do
            write_word(st_get(st, hk), st_get(st, 104) * 8, st_get(st, 107))
            write_word(st_get(st, hv), st_get(st, 104) * 8, st_get(st, 108))
            out 0
        end
        if cstr_eq(st, st_get(st, 106), st_get(st, 107)) != 0 do
            write_word(st_get(st, hv), st_get(st, 104) * 8, st_get(st, 108))
            out 0
        end
        st_set(st, 104, (st_get(st, 104) + 1) bit_and 127)
        st_set(st, 105, st_get(st, 105) + 1)
    end
    print(93)
    exit_prog(1)
    out 0
end.

func find_fn(st, name):
    let res = hash_get_at(st, 95, 96, name)
    if res >= 0 do
        out res
    end
    if st_get(st, 393) != 0 do
        let target = hash_get_at(st, 393, 394, name)
        if target != 0 - 1 do
            out hash_get_at(st, 95, 96, target)
        end
    end
    out 0 - 1
end.

# Forward declare name → fn index (offset 0 until parse_func fills it).
func declare_fn(st, name):
    st_set(st, 108, name)
    st_set(st, 109, find_fn(st, st_get(st, 108)))
    if st_get(st, 109) < 0 do
        write_word(st_get(st, 11), st_get(st, 13) * 8, 0)
        write_word(st_get(st, 12), st_get(st, 13) * 8, st_get(st, 108))
        hash_put_at(st, 95, 96, st_get(st, 108), st_get(st, 13))
        st_set(st, 109, st_get(st, 13))
        st_set(st, 13, st_get(st, 13) + 1)
    end
    out st_get(st, 109)
end.

func cstr_eq_ci:
    in
        st
        a
        b
    if a == 0 do
        if b == 0 do
            out 1
        end
        out 0
    end
    if b == 0 do
        out 0
    end
    st_set(st, 19, 0)
    when st_get(st, 19) < 256 loop
        let i = st_get(st, 19)
        let ca = read_byte(a, i)
        let cb = read_byte(b, i)
        st_set(st, 46, ca)
        if ca >= 65 do
            if ca <= 90 do
                st_set(st, 46, ca + 32)
            end
        end
        st_set(st, 47, cb)
        if cb >= 65 do
            if cb <= 90 do
                st_set(st, 47, cb + 32)
            end
        end
        if st_get(st, 46) != st_get(st, 47) do
            out 0
        end
        if ca == 0 do
            out 1
        end
        st_set(st, 19, i + 1)
    end
    out 0
end.

# find_entity: returns entity index (0-based) or -1 if not found.
func find_entity(st, name):
    st_set(st, 309, 0)
    when st_get(st, 309) < st_get(st, 292) loop
        let ei = st_get(st, 309)
        let ename = read_word(st_get(st, 290), ei * 8)
        if cstr_eq_ci(st, ename, name) != 0 do
            out ei
        end
        st_set(st, 309, ei + 1)
    end
    out 0 - 1
end.

# find_field_off: returns byte offset of field name across entities, or -1.
func find_field_off(st, fname):
    st_set(st, 310, 0)
    when st_get(st, 310) < st_get(st, 292) loop
        let ei = st_get(st, 310)
        let nf = read_word(st_get(st, 291), ei * 8)
        st_set(st, 311, 0)
        when st_get(st, 311) < nf loop
            let fi = st_get(st, 311)
            let fpos = ei * 16 + fi
            let fld_name = read_word(st_get(st, 293), fpos * 8)
            if cstr_eq_ci(st, fld_name, fname) != 0 do
                out read_word(st_get(st, 294), fpos * 8)
            end
            st_set(st, 311, fi + 1)
        end
        st_set(st, 310, ei + 1)
    end
    out 0 - 1
end.

# find_field_size: returns byte size of field name across entities, or 8.
func find_field_size(st, fname):
    st_set(st, 310, 0)
    when st_get(st, 310) < st_get(st, 292) loop
        let ei = st_get(st, 310)
        let nf = read_word(st_get(st, 291), ei * 8)
        st_set(st, 311, 0)
        when st_get(st, 311) < nf loop
            let fi = st_get(st, 311)
            let fpos = ei * 16 + fi
            let fld_name = read_word(st_get(st, 293), fpos * 8)
            if cstr_eq_ci(st, fld_name, fname) != 0 do
                out read_word(st_get(st, 298), fpos * 8)
            end
            st_set(st, 311, fi + 1)
        end
        st_set(st, 310, ei + 1)
    end
    out 8
end.

func emit_field_load(st, off, sz):
    if sz == 1 do
        emit_u32(st, 0x39400108 bit_or ((off bit_and 4095) shl 10))
    else
        if sz == 2 do
            emit_u32(st, 0x79400108 bit_or (((off / 2) bit_and 4095) shl 10))
        else
            if sz == 4 do
                emit_u32(st, 0xB9400108 bit_or (((off / 4) bit_and 4095) shl 10))
            else
                emit_u32(st, 0xF9400108 bit_or (((off / 8) bit_and 4095) shl 10))
            end
        end
    end
end.

func emit_field_store(st, off, sz):
    if sz == 1 do
        emit_u32(st, 0x39000100 bit_or ((off bit_and 4095) shl 10))
    else
        if sz == 2 do
            emit_u32(st, 0x79000100 bit_or (((off / 2) bit_and 4095) shl 10))
        else
            if sz == 4 do
                emit_u32(st, 0xB9000100 bit_or (((off / 4) bit_and 4095) shl 10))
            else
                emit_u32(st, 0xF9000100 bit_or (((off / 8) bit_and 4095) shl 10))
            end
        end
    end
end.

# find_type_alias: returns alias index (0-based) or -1 if not found.
func find_type_alias(st, name):
    st_set(st, 337, 0)
    when st_get(st, 337) < st_get(st, 332) loop
        let ai = st_get(st, 337)
        let aname = read_word(st_get(st, 330), ai * 8)
        if cstr_eq_ci(st, aname, name) != 0 do
            out ai
        end
        st_set(st, 337, ai + 1)
    end
    out 0 - 1
end.

# parse_type_alias: parses `type Alias = Target;`
func parse_type_alias(st):
    expect(st, 49)
    if st_get(st, 3) != 1 do
        print(96)
        exit_prog(1)
    end
    st_set(st, 338, st_get(st, 5))
    next_tok(st)
    expect(st, 15)
    st_set(st, 339, parse_type_spec(st))
    st_set(st, 340, st_get(st, 332))
    write_word(st_get(st, 330), st_get(st, 340) * 8, st_get(st, 338))
    write_word(st_get(st, 331), st_get(st, 340) * 8, st_get(st, 339))
    st_set(st, 332, st_get(st, 340) + 1)
    next_tok(st)
    if st_get(st, 3) == 12 do
        next_tok(st)
    end
end.

# find_enum: returns enum index (0-based) or -1 if not found.
func find_enum(st, name):
    st_set(st, 326, 0)
    when st_get(st, 326) < st_get(st, 322) loop
        let ei = st_get(st, 326)
        let ename = read_word(st_get(st, 320), ei * 8)
        if cstr_eq_ci(st, ename, name) != 0 do
            out ei
        end
        st_set(st, 326, ei + 1)
    end
    out 0 - 1
end.

# find_enum_variant: returns tag index (0-based) or -1.
func find_enum_variant(st, ei, vname):
    let nv = read_word(st_get(st, 321), ei * 8)
    st_set(st, 327, 0)
    when st_get(st, 327) < nv loop
        let vi = st_get(st, 327)
        let pos = ei * 16 + vi
        let var_name = read_word(st_get(st, 323), pos * 8)
        if cstr_eq_ci(st, var_name, vname) != 0 do
            out read_word(st_get(st, 324), pos * 8)
        end
        st_set(st, 327, vi + 1)
    end
    out 0 - 1
end.

# parse_enum: parses `enum Name: Variant1, Variant2(Type) end.`
func parse_enum(st):
    expect(st, 72)
    if st_get(st, 3) != 1 do
        print(96)
        exit_prog(1)
    end
    st_set(st, 328, st_get(st, 5))
    next_tok(st)
    if st_get(st, 3) == 11 do
        next_tok(st)
    end
    st_set(st, 329, st_get(st, 322))
    write_word(st_get(st, 320), st_get(st, 329) * 8, st_get(st, 328))
    st_set(st, 322, st_get(st, 329) + 1)
    st_set(st, 301, 0)
    when st_get(st, 3) != 8 loop
        if st_get(st, 3) == 0 do
            print(96)
            exit_prog(1)
        end
        if st_get(st, 3) == 1 do
            st_set(st, 305, st_get(st, 5))
            st_set(st, 306, st_get(st, 301))
            st_set(st, 308, st_get(st, 329) * 16 + st_get(st, 306))
            write_word(st_get(st, 323), st_get(st, 308) * 8, st_get(st, 305))
            write_word(st_get(st, 324), st_get(st, 308) * 8, st_get(st, 306))
            write_word(st_get(st, 325), st_get(st, 308) * 8, 0)
            st_set(st, 301, st_get(st, 306) + 1)
            next_tok(st)
            if st_get(st, 3) == 9 do
                next_tok(st)
                if st_get(st, 3) == 1 do
                    st_set(st, 119, st_get(st, 2))
                    st_set(st, 18, 1)
                    when st_get(st, 18) != 0 loop
                        if st_get(st, 119) >= st_get(st, 1) do
                            st_set(st, 18, 0)
                        else
                            st_set(st, 58, read_byte(st_get(st, 0), st_get(st, 119)))
                            if st_get(st, 58) == 32 do
                                st_set(st, 119, st_get(st, 119) + 1)
                            else
                                if st_get(st, 58) == 9 do
                                    st_set(st, 119, st_get(st, 119) + 1)
                                else
                                    st_set(st, 18, 0)
                                end
                            end
                        end
                    end
                    if st_get(st, 119) < st_get(st, 1) do
                        if read_byte(st_get(st, 0), st_get(st, 119)) == 58 do
                            next_tok(st)
                            next_tok(st)
                        end
                    end
                end
                st_set(st, 341, parse_type_spec(st))
                write_word(st_get(st, 325), st_get(st, 308) * 8, st_get(st, 341))
                next_tok(st)
                expect(st, 10)
            end
            if st_get(st, 3) == 13 do
                next_tok(st)
            end
            if st_get(st, 3) == 12 do
                next_tok(st)
            end
        else
            if st_get(st, 3) == 12 do
                next_tok(st)
            else
                if st_get(st, 3) == 13 do
                    next_tok(st)
                else
                    next_tok(st)
                end
            end
        end
    end
    write_word(st_get(st, 321), st_get(st, 329) * 8, st_get(st, 301))
    expect(st, 8)
    if st_get(st, 3) == 16 do
        next_tok(st)
    end
end.

# parse_type_spec: maps current token/ident to Type ID
func parse_type_spec(st):
    let tk = st_get(st, 3)
    if tk == 76 do
        next_tok(st)
        let inner = parse_type_spec(st)
        out 100 + inner
    end
    if tk == 77 do
        next_tok(st)
        let inner = parse_type_spec(st)
        out 200 + inner
    end
    if tk == 110 do
        next_tok(st)
        let inner = parse_type_spec(st)
        next_tok(st)
        if st_get(st, 3) == 12 do
            next_tok(st)
            if st_get(st, 3) == 2 do
                next_tok(st)
            end
            out 300 + inner
        else
            out 400 + inner
        end
    end
    let name = st_get(st, 5)
    # Primitive types check by ident
    if ident_is_str(name, "i8") != 0 do out 1 end
    if ident_is_str(name, "i16") != 0 do out 2 end
    if ident_is_str(name, "i32") != 0 do out 3 end
    if ident_is_str(name, "i64") != 0 do out 4 end
    if ident_is_str(name, "u8") != 0 do out 5 end
    if ident_is_str(name, "u16") != 0 do out 6 end
    if ident_is_str(name, "u32") != 0 do out 7 end
    if ident_is_str(name, "u64") != 0 do out 8 end
    if ident_is_str(name, "int") != 0 do out 9 end
    if ident_is_str(name, "uint") != 0 do out 10 end
    if ident_is_str(name, "f32") != 0 do out 11 end
    if ident_is_str(name, "f64") != 0 do out 12 end
    if ident_is_str(name, "float") != 0 do out 13 end
    if ident_is_str(name, "bool") != 0 do out 14 end
    if ident_is_str(name, "char") != 0 do out 15 end
    if ident_is_str(name, "ptr") != 0 do out 16 end
    if ident_is_str(name, "void") != 0 do out 0 end
    if ident_is_str(name, "string") != 0 do out 17 end
    # Aliases, Entities, and Enums
    st_set(st, 336, find_type_alias(st, name))
    if st_get(st, 336) >= 0 do
        out read_word(st_get(st, 331), st_get(st, 336) * 8)
    end
    st_set(st, 336, find_entity(st, name))
    if st_get(st, 336) >= 0 do
        out 20 + st_get(st, 336)
    end
    st_set(st, 336, find_enum(st, name))
    if st_get(st, 336) >= 0 do
        out 50 + st_get(st, 336)
    end
    out 9
end.

# ═══════════════════════════════════════════════════════════════
# BORROW CHECKER & OWNERSHIP SYSTEM (Vir Spec §4.5–§4.8)
# ═══════════════════════════════════════════════════════════════

func find_local_idx(st, name):
    var li = 0
    let n = st_get(st, 21)
    when li < n loop
        let lname = read_word(st_get(st, 43), li * 8)
        var match = 1
        var ci = 0
        when ci < 256 loop
            let ca = read_byte(lname, ci)
            let cb = read_byte(name, ci)
            if ca != cb do
                match = 0
                ci = 300
            else
                if ca == 0 do
                    ci = 300
                else
                    ci = ci + 1
                end
            end
        end
        if match != 0 do
            out li
        end
        li = li + 1
    end
    out 0 - 1
end.

func is_type_move(st, type_id):
    if type_id >= 100 do
        out 0
    end
    if type_id <= 16 do
        out 0
    end
    out 1
end.

func bc_init_func(st):
    st_set(st, 364, 0)
    st_set(st, 367, 0)
    st_set(st, 369, 999)
    st_set(st, 380, 0)
    st_set(st, 382, 0)
    var i = 0
    when i < 64 loop
        write_word(st_get(st, 360), i * 8, 0)
        write_word(st_get(st, 361), i * 8, 0)
        write_word(st_get(st, 362), i * 8, 0)
        write_word(st_get(st, 363), i * 8, 0)
        write_word(st_get(st, 365), i * 8, 0)
        write_word(st_get(st, 366), i * 8, 0)
        write_word(st_get(st, 368), i * 8, 999)
        i = i + 1
    end
end.

func bc_stmt_end(st):
    var li = 0
    let n = st_get(st, 21)
    when li < n loop
        let state = read_word(st_get(st, 360), li * 8)
        if state != 4 do
            write_word(st_get(st, 361), li * 8, 0)
            write_word(st_get(st, 362), li * 8, 0)
            write_word(st_get(st, 360), li * 8, 1)
        end
        li = li + 1
    end
    # Re-apply borrows from active reference variables
    var ri = 0
    when ri < n loop
        let rtype = read_word(st_get(st, 366), ri * 8)
        if rtype >= 100 do
            let target = read_word(st_get(st, 368), ri * 8)
            if target < 64 do
                if rtype >= 200 do
                    write_word(st_get(st, 362), target * 8, 1)
                    write_word(st_get(st, 360), target * 8, 3)
                else
                    let sc = read_word(st_get(st, 361), target * 8)
                    write_word(st_get(st, 361), target * 8, sc + 1)
                    write_word(st_get(st, 360), target * 8, 2)
                end
            end
        end
        ri = ri + 1
    end
end.

func bc_release_borrow(st, li):
    if li < 64 do
        let mc = read_word(st_get(st, 362), li * 8)
        if mc > 0 do
            write_word(st_get(st, 362), li * 8, mc - 1)
        end
        let sc = read_word(st_get(st, 361), li * 8)
        if sc > 0 do
            write_word(st_get(st, 361), li * 8, sc - 1)
        end
        let cur_mc = read_word(st_get(st, 362), li * 8)
        let cur_sc = read_word(st_get(st, 361), li * 8)
        if cur_mc == 0 do
            if cur_sc == 0 do
                write_word(st_get(st, 360), li * 8, 1)
            end
        end
    end
end.

func bc_register_local(st, li, is_mut, type_id):
    if li >= 0 do
        write_word(st_get(st, 360), li * 8, 1)
        write_word(st_get(st, 361), li * 8, 0)
        write_word(st_get(st, 362), li * 8, 0)
        write_word(st_get(st, 363), li * 8, st_get(st, 364))
        write_word(st_get(st, 365), li * 8, is_mut)
        write_word(st_get(st, 366), li * 8, type_id)
    end
end.

func bc_check_read(st, name):
    let li = find_local_idx(st, name)
    if li >= 0 do
        let state = read_word(st_get(st, 360), li * 8)
        if state == 4 do
            print(382)
            exit_prog(1)
        end
        let mc = read_word(st_get(st, 362), li * 8)
        if mc > 0 do
            print(502)
            exit_prog(1)
        end
    end
end.

func bc_check_write(st, name):
    let li = find_local_idx(st, name)
    if li >= 0 do
        let is_mut = read_word(st_get(st, 365), li * 8)
        if is_mut == 0 do
            print(read_byte(name, 0))
            print(read_byte(name, 1))
            print(read_byte(name, 2))
            print(384)
            exit_prog(1)
        end
        let sc = read_word(st_get(st, 361), li * 8)
        if sc > 0 do
            print(506)
            exit_prog(1)
        end
        let mc = read_word(st_get(st, 362), li * 8)
        if mc > 0 do
            print(506)
            exit_prog(1)
        end
    end
end.

func bc_check_move(st, name):
    let li = find_local_idx(st, name)
    if li >= 0 do
        let type_id = read_word(st_get(st, 366), li * 8)
        if is_type_move(st, type_id) != 0 do
            bc_check_read(st, name)
            let sc = read_word(st_get(st, 361), li * 8)
            if sc > 0 do
                print(505)
                exit_prog(1)
            end
            let mc = read_word(st_get(st, 362), li * 8)
            if mc > 0 do
                print(505)
                exit_prog(1)
            end
            write_word(st_get(st, 360), li * 8, 4)
        end
    end
end.

func bc_borrow_shared(st, name):
    let li = find_local_idx(st, name)
    if li >= 0 do
        bc_check_read(st, name)
        let sc = read_word(st_get(st, 361), li * 8)
        write_word(st_get(st, 361), li * 8, sc + 1)
        write_word(st_get(st, 360), li * 8, 2)
        if st_get(st, 382) > 0 do
            let tbc = st_get(st, 380)
            write_word(st_get(st, 381), tbc * 8, li)
            st_set(st, 380, tbc + 1)
        end
    end
end.

func bc_borrow_mut(st, name):
    let li = find_local_idx(st, name)
    if li >= 0 do
        let is_mut = read_word(st_get(st, 365), li * 8)
        if is_mut == 0 do
            print(596)
            exit_prog(1)
        end
        let state = read_word(st_get(st, 360), li * 8)
        if state == 4 do
            print(382)
            exit_prog(1)
        end
        let sc = read_word(st_get(st, 361), li * 8)
        if sc > 0 do
            print(502)
            exit_prog(1)
        end
        let mc = read_word(st_get(st, 362), li * 8)
        if mc > 0 do
            print(499)
            exit_prog(1)
        end
        write_word(st_get(st, 362), li * 8, 1)
        write_word(st_get(st, 360), li * 8, 3)
        if st_get(st, 382) > 0 do
            let tbc = st_get(st, 380)
            write_word(st_get(st, 381), tbc * 8, li)
            st_set(st, 380, tbc + 1)
        end
    end
end.

func bc_check_escape(st, src_name, target_scope):
    let li = find_local_idx(st, src_name)
    if li >= 0 do
        let src_type = read_word(st_get(st, 366), li * 8)
        if is_type_move(st, src_type) != 0 do
            let src_scope = read_word(st_get(st, 363), li * 8)
            if src_scope > target_scope do
                print(597)
                exit_prog(1)
            end
        end
    end
end.

func bc_scope_enter(st):
    st_set(st, 364, st_get(st, 364) + 1)
end.

func bc_scope_exit(st):
    let cur = st_get(st, 364)
    var li = 0
    let n = st_get(st, 21)
    when li < n loop
        let sc = read_word(st_get(st, 363), li * 8)
        if sc >= cur do
            write_word(st_get(st, 361), li * 8, 0)
            write_word(st_get(st, 362), li * 8, 0)
        end
        li = li + 1
    end
    st_set(st, 364, cur - 1)
end.

# ── Loop & Case Stack Helpers (Spec §9 & §21) ──
func loop_push(st, skip_target):
    let d = st_get(st, 371) + 1
    st_set(st, 371, d)
    write_word(st_get(st, 373), d * 8, skip_target)
    write_word(st_get(st, 375), d * 8, 0)
end.

func loop_set_skip(st, skip_target):
    let d = st_get(st, 371)
    if d > 0 do
        write_word(st_get(st, 373), d * 8, skip_target)
    end
end.

func loop_emit_break(st):
    let d = st_get(st, 371)
    if d <= 0 do
        print(95)
        exit_prog(1)
    end
    let cnt = read_word(st_get(st, 375), d * 8)
    let site = st_get(st, 9)
    emit_u32(st, 0x14000000)
    write_word(st_get(st, 374), (d * 32 + cnt) * 8, site)
    write_word(st_get(st, 375), d * 8, cnt + 1)
end.

func loop_emit_skip(st):
    let d = st_get(st, 371)
    if d <= 0 do
        print(95)
        exit_prog(1)
    end
    let target = read_word(st_get(st, 373), d * 8)
    let rel = (target - st_get(st, 9)) / 4
    emit_u32(st, 0x14000000 bit_or (rel bit_and 0x03FFFFFF))
end.

func loop_pop(st, end_target):
    let d = st_get(st, 371)
    if d > 0 do
        let cnt = read_word(st_get(st, 375), d * 8)
        var i = 0
        when i < cnt loop
            let site = read_word(st_get(st, 374), (d * 32 + i) * 8)
            let rel = (end_target - site) / 4
            emit_u32_at(st, site, 0x14000000 bit_or (rel bit_and 0x03FFFFFF))
            i = i + 1
        end
        st_set(st, 371, d - 1)
    end
end.

func when_finish(st):
    let top_d = st_get(st, 371)
    let top_hdr = read_word(st_get(st, 373), top_d * 8)
    let top_cond = read_word(st_get(st, 372), top_d * 8)
    let top_op = read_word(st_get(st, 379), top_d * 8)
    let rel = (top_hdr - st_get(st, 9)) / 4
    emit_u32(st, 0x14000000 bit_or (rel bit_and 0x03FFFFFF))
    let end_off = st_get(st, 9)
    let cond_imm = (end_off - top_cond) / 4
    let cond_shift = (cond_imm bit_and 0x7FFFF) * 32
    var cond_code = 0
    if top_op == 28 do cond_code = 1 end
    if top_op == 27 do cond_code = 0 end
    if top_op == 24 do cond_code = 10 end
    if top_op == 25 do cond_code = 11 end
    if top_op == 26 do cond_code = 13 end
    if top_op == 23 do cond_code = 12 end
    emit_u32_at(st, top_cond, 0x54000000 bit_or (cond_code bit_and 15) bit_or cond_shift)
    loop_pop(st, end_off)
end.

func for_finish(st, i_slot):
    let top_d = st_get(st, 371)
    let top_hdr = read_word(st_get(st, 373), top_d * 8)
    let top_cond = read_word(st_get(st, 372), top_d * 8)
    let rel = (top_hdr - st_get(st, 9)) / 4
    emit_u32(st, 0x14000000 bit_or (rel bit_and 0x03FFFFFF))
    let end_off = st_get(st, 9)
    patch_br(st, top_cond, 10)
    loop_pop(st, end_off)
end.

func loop_cnt_finish(st):
    let top_d = st_get(st, 371)
    let top_hdr = read_word(st_get(st, 373), top_d * 8)
    let top_cond = read_word(st_get(st, 372), top_d * 8)
    let rel = (top_hdr - st_get(st, 9)) / 4
    emit_u32(st, 0x14000000 bit_or (rel bit_and 0x03FFFFFF))
    let end_off = st_get(st, 9)
    let cond_imm = (end_off - top_cond) / 4
    let cond_shift = (cond_imm bit_and 0x7FFFF) * 32
    emit_u32_at(st, top_cond, 0x5400000D bit_or cond_shift)
    loop_pop(st, end_off)
end.

func loop_finish(st):
    let top_d = st_get(st, 371)
    let top_hdr = read_word(st_get(st, 373), top_d * 8)
    let rel = (top_hdr - st_get(st, 9)) / 4
    emit_u32(st, 0x14000000 bit_or (rel bit_and 0x03FFFFFF))
    let end_off = st_get(st, 9)
    loop_pop(st, end_off)
end.

func if_push(st):
    let d = st_get(st, 385) + 1
    st_set(st, 385, d)
    write_word(st_get(st, 387), d * 8, 0)
end.

func if_emit_end_jump(st):
    let d = st_get(st, 385)
    if d > 0 do
        let cnt = read_word(st_get(st, 387), d * 8)
        let site = st_get(st, 9)
        emit_u32(st, 0x14000000)
        write_word(st_get(st, 386), (d * 32 + cnt) * 8, site)
        write_word(st_get(st, 387), d * 8, cnt + 1)
    end
end.

func if_pop(st, end_target):
    let d = st_get(st, 385)
    if d > 0 do
        let cnt = read_word(st_get(st, 387), d * 8)
        var i = 0
        when i < cnt loop
            let site = read_word(st_get(st, 386), (d * 32 + i) * 8)
            let rel = (end_target - site) / 4
            emit_u32_at(st, site, 0x14000000 bit_or (rel bit_and 0x03FFFFFF))
            i = i + 1
        end
        st_set(st, 385, d - 1)
    end
end.

func case_push(st):
    let d = st_get(st, 378) + 1
    st_set(st, 378, d)
    write_word(st_get(st, 377), d * 8, 0)
end.

func case_emit_end_jump(st):
    let d = st_get(st, 378)
    if d > 0 do
        let cnt = read_word(st_get(st, 377), d * 8)
        let site = st_get(st, 9)
        emit_u32(st, 0x14000000)
        write_word(st_get(st, 376), (d * 32 + cnt) * 8, site)
        write_word(st_get(st, 377), d * 8, cnt + 1)
    end
end.

func case_pop(st, end_target):
    let d = st_get(st, 378)
    if d > 0 do
        let cnt = read_word(st_get(st, 377), d * 8)
        var i = 0
        when i < cnt loop
            let site = read_word(st_get(st, 376), (d * 32 + i) * 8)
            let rel = (end_target - site) / 4
            emit_u32_at(st, site, 0x14000000 bit_or (rel bit_and 0x03FFFFFF))
            i = i + 1
        end
        st_set(st, 378, d - 1)
    end
end.

func patch_br(st, site, cond_code):
    let end_off = st_get(st, 9)
    let imm = (end_off - site) / 4
    let shift = (imm bit_and 0x7FFFF) * 32
    emit_u32_at(st, site, 0x54000000 bit_or (cond_code bit_and 15) bit_or shift)
end.

func is_case_pattern(st):
    if st_get(st, 378) <= 0 do
        out 0
    end
    let tok = st_get(st, 3)
    if tok == 30 do
        # 'when' keyword in case pattern
        out 1
    end
    if tok == 34 do
        # 'else' keyword in case pattern
        out 1
    end
    # For literal patterns (number, string, bool, ident): peek if followed by ':' or '..'
    if tok == 1 or tok == 2 or tok == 35 or tok == 70 or tok == 71 or tok == 46 do
        st_set(st, 57, st_get(st, 2))
        let slen = st_get(st, 1)
        st_set(st, 379, 1)
        when st_get(st, 379) != 0 loop
            if st_get(st, 57) >= slen do
                st_set(st, 379, 0)
            else
                let c = read_byte(st_get(st, 0), st_get(st, 57))
                if c == 32 or c == 9 or c == 10 or c == 13 do
                    st_set(st, 57, st_get(st, 57) + 1)
                else
                    st_set(st, 379, 0)
                end
            end
        end
        if st_get(st, 57) < slen do
            let next_c = read_byte(st_get(st, 0), st_get(st, 57))
            if next_c == 58 or next_c == 46 do
                out 1
            end
        end
    end
    out 0
end.

# type_size_of: returns byte size for a Type ID
func type_size_of(st, type_id):
    if type_id == 0 do
        out 0
    end
    if type_id == 1 do
        out 1
    end
    if type_id == 5 do
        out 1
    end
    if type_id == 14 do
        out 1
    end
    if type_id == 15 do
        out 1
    end
    if type_id == 2 do
        out 2
    end
    if type_id == 6 do
        out 2
    end
    if type_id == 3 do
        out 4
    end
    if type_id == 7 do
        out 4
    end
    if type_id == 11 do
        out 4
    end
    out 8
end.

# parse_entity_packed: parses `entity Name:` or `packed entity Name:`
func parse_entity_packed(st, is_packed):
    expect(st, 45)
    if st_get(st, 3) != 1 do
        print(96)
        exit_prog(1)
    end
    st_set(st, 303, st_get(st, 5))
    next_tok(st)
    if st_get(st, 3) == 11 do
        next_tok(st)
    end
    st_set(st, 304, st_get(st, 292))
    write_word(st_get(st, 290), st_get(st, 304) * 8, st_get(st, 303))
    write_word(st_get(st, 299), st_get(st, 304) * 8, is_packed)
    st_set(st, 292, st_get(st, 304) + 1)
    st_set(st, 301, 0)
    st_set(st, 307, 0)
    when st_get(st, 3) != 8 loop
        if st_get(st, 3) == 0 do
            print(96)
            exit_prog(1)
        end
        if st_get(st, 3) == 50 do
            # skip method ... end.
            st_set(st, 302, 1)
            when st_get(st, 302) != 0 loop
                next_tok(st)
                if st_get(st, 3) == 0 do
                    st_set(st, 302, 0)
                end
                if st_get(st, 3) == 8 do
                    next_tok(st)
                    if st_get(st, 3) == 16 do
                        next_tok(st)
                        st_set(st, 302, 0)
                    end
                end
            end
        else
            if st_get(st, 3) == 1 do
                st_set(st, 305, st_get(st, 5))
                st_set(st, 306, st_get(st, 301))
                st_set(st, 308, st_get(st, 304) * 16 + st_get(st, 306))
                next_tok(st)
                st_set(st, 343, 9)
                if st_get(st, 3) == 11 do
                    next_tok(st)
                    st_set(st, 343, parse_type_spec(st))
                    next_tok(st)
                end
                st_set(st, 344, type_size_of(st, st_get(st, 343)))
                if is_packed != 0 do
                    write_word(st_get(st, 294), st_get(st, 308) * 8, st_get(st, 307))
                    st_set(st, 307, st_get(st, 307) + st_get(st, 344))
                else
                    write_word(st_get(st, 294), st_get(st, 308) * 8, st_get(st, 306) * 8)
                    st_set(st, 307, (st_get(st, 306) + 1) * 8)
                end
                write_word(st_get(st, 293), st_get(st, 308) * 8, st_get(st, 305))
                write_word(st_get(st, 295), st_get(st, 308) * 8, st_get(st, 343))
                write_word(st_get(st, 298), st_get(st, 308) * 8, st_get(st, 344))
                st_set(st, 301, st_get(st, 306) + 1)
                if st_get(st, 3) == 13 do
                    next_tok(st)
                end
                if st_get(st, 3) == 12 do
                    next_tok(st)
                end
            else
                if st_get(st, 3) == 12 do
                    next_tok(st)
                else
                    if st_get(st, 3) == 13 do
                        next_tok(st)
                    else
                        next_tok(st)
                    end
                end
            end
        end
    end
    write_word(st_get(st, 291), st_get(st, 304) * 8, st_get(st, 301))
    expect(st, 8)
    if st_get(st, 3) == 16 do
        next_tok(st)
    end
end.

func parse_export_decl(st):
    next_tok(st)
    var cont = 1
    when cont != 0 loop
        if st_get(st, 3) == 1 do
            hash_put_at(st, 391, 392, st_get(st, 5), 1)
            st_set(st, 390, st_get(st, 390) + 1)
            next_tok(st)
        end
        if st_get(st, 3) == 17 do
            next_tok(st)
        else
            cont = 0
        end
    end
    if st_get(st, 3) == 12 do
        next_tok(st)
    end
end.

func parse_import_decl(st):
    next_tok(st)
    var sym_cnt = 0
    var temp_syms = bump_alloc(st, 128)
    var temp_alias = bump_alloc(st, 128)
    var cont = 1
    when cont != 0 loop
        if st_get(st, 3) == 1 do
            let s_name = st_get(st, 5)
            write_word(temp_syms, sym_cnt * 8, s_name)
            write_word(temp_alias, sym_cnt * 8, s_name)
            next_tok(st)
            if st_get(st, 3) == 109 do
                next_tok(st)
                if st_get(st, 3) == 1 do
                    write_word(temp_alias, sym_cnt * 8, st_get(st, 5))
                    next_tok(st)
                end
            end
            sym_cnt = sym_cnt + 1
        end
        if st_get(st, 3) == 17 do
            next_tok(st)
        else
            cont = 0
        end
    end
    if st_get(st, 3) == 48 do
        next_tok(st)
        if st_get(st, 3) == 1 do
            let mod_name = st_get(st, 5)
            next_tok(st)
            if st_get(st, 3) == 109 do
                next_tok(st)
                if st_get(st, 3) == 1 do
                    let trailing_alias = st_get(st, 5)
                    if sym_cnt > 0 do
                        write_word(temp_alias, (sym_cnt - 1) * 8, trailing_alias)
                    end
                    next_tok(st)
                end
            end
            var i = 0
            when i < sym_cnt loop
                let orig_sym = read_word(temp_syms, i * 8)
                let ali_sym = read_word(temp_alias, i * 8)
                if st_get(st, 390) > 0 do
                    if hash_get_at(st, 391, 392, orig_sym) == 0 - 1 do
                        print(603)
                        exit_prog(1)
                    end
                end
                hash_put_at(st, 393, 394, ali_sym, orig_sym)
                i = i + 1
            end
        end
    end
    if st_get(st, 3) == 12 do
        next_tok(st)
    end
end.

func parse_get_decl(st):
    next_tok(st)
    if st_get(st, 3) == 1 do
        let orig_sym = st_get(st, 5)
        var ali_sym = orig_sym
        next_tok(st)
        if st_get(st, 3) == 48 do
            next_tok(st)
            if st_get(st, 3) == 1 do
                let mod_name = st_get(st, 5)
                next_tok(st)
                if st_get(st, 3) == 109 do
                    next_tok(st)
                    if st_get(st, 3) == 1 do
                        ali_sym = st_get(st, 5)
                        next_tok(st)
                    end
                end
                hash_put_at(st, 393, 394, ali_sym, orig_sym)
            end
        end
    end
    if st_get(st, 3) == 12 do
        next_tok(st)
    end
end.

func parse_share_decl(st):
    next_tok(st)
    var cont = 1
    when cont != 0 loop
        if st_get(st, 3) == 1 do
            hash_put_at(st, 398, 399, st_get(st, 5), 1)
            st_set(st, 397, st_get(st, 397) + 1)
            next_tok(st)
        end
        if st_get(st, 3) == 17 do
            next_tok(st)
        else
            cont = 0
        end
    end
    if st_get(st, 3) == 12 do
        next_tok(st)
    end
end.

func parse_include_decl(st):
    next_tok(st)
    var cont = 1
    when cont != 0 loop
        if st_get(st, 3) == 1 do
            let mod_name = st_get(st, 5)
            var mod_alias = mod_name
            next_tok(st)
            if st_get(st, 3) == 109 do
                next_tok(st)
                if st_get(st, 3) == 1 do
                    mod_alias = st_get(st, 5)
                    next_tok(st)
                end
            end
            hash_put_at(st, 395, 396, mod_alias, mod_name)
        end
        if st_get(st, 3) == 17 do
            next_tok(st)
        else
            cont = 0
        end
    end
    if st_get(st, 3) == 12 do
        next_tok(st)
    end
end.

# Pass 1: register every `func name`, `entity`, `packed entity`, `enum`, `type`, `export`, `import`, `get`, `share`, `include`
func predeclare_funcs(st):
    st_set(st, 2, 0)
    next_tok(st)
    st_set(st, 116, 1)
    when st_get(st, 116) != 0 loop
        if st_get(st, 3) == 0 do
            st_set(st, 116, 0)
        else
            if st_get(st, 3) == 3 do
                next_tok(st)
                if st_get(st, 3) == 1 do
                    declare_fn(st, st_get(st, 5))
                end
                next_tok(st)
            else
                if st_get(st, 3) == 51 do
                    parse_export_decl(st)
                else
                    if st_get(st, 3) == 47 do
                        parse_import_decl(st)
                    else
                        if st_get(st, 3) == 107 do
                            parse_get_decl(st)
                        else
                            if st_get(st, 3) == 105 do
                                parse_share_decl(st)
                            else
                                if st_get(st, 3) == 108 do
                                    parse_include_decl(st)
                                else
                                    if st_get(st, 3) == 73 do
                                        next_tok(st)
                                        if st_get(st, 3) == 45 do
                                            parse_entity_packed(st, 1)
                                        end
                                    else
                                        if st_get(st, 3) == 45 do
                                            parse_entity_packed(st, 0)
                                        else
                                            if st_get(st, 3) == 72 do
                                                parse_enum(st)
                                            else
                                                if st_get(st, 3) == 49 do
                                                    parse_type_alias(st)
                                                else
                                                    next_tok(st)
                                                end
                                            end
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
    end
    st_set(st, 2, 0)
    next_tok(st)
end.

# names/n kept for call-site compat; lookup is hashed via loc_hk/hv.
func slot_of:
    in
        st
        name
        names
        n
    out hash_get_at(st, 97, 98, name)
end.

func expect(st, k):
    if st_get(st, 3) != k do
        print(99)
        print(k)
        print(st_get(st, 3))
        exit_prog(1)
    end
    next_tok(st)
end.

# Spec §30 Stage-1 subset (tight→loose, all left-assoc):
#   * /  (20)  →  shl shr (12)  →  + - (10)  →  bit_and (3)  →  bit_or (2)
# RHS of each level = next-tighter parser only (never full parse_expr_to).

func nest_peak:
    in
        st
        depth
        max_slot
    if depth > st_get(st, max_slot) do
        st_set(st, max_slot, depth)
    end
end.

func nest_guard:
    in
        st
        depth
        lim
    if depth > lim do
        print(92)
        print(depth)
        exit_prog(1)
    end
end.

func expr_alloc_rhs(st):
    st_set(st, 66, st_get(st, 66) + 1)
    nest_peak(st, st_get(st, 66), 221)
    nest_guard(st, st_get(st, 66), 32)
    st_set(st, 130 + st_get(st, 66), st_get(st, 50))
    if st_get(st, 50) < 0 - 1 do
        st_set(st, 170 + st_get(st, 66), 512 + st_get(st, 66) * 16)
    else
        st_set(st, 170 + st_get(st, 66), st_get(st, 50) + 64)
    end
    st_set(st, 50, st_get(st, 170 + st_get(st, 66)))
    st_set(st, 74, st_get(st, 50))
end.

func expr_emit_binop(st):
    st_set(st, 77, st_get(st, 120 + st_get(st, 66)))
    st_set(st, 50, st_get(st, 130 + st_get(st, 66)))
    st_set(st, 78, st_get(st, 50))
    st_set(st, 79, st_get(st, 170 + st_get(st, 66)))
    st_set(st, 66, st_get(st, 66) - 1)
    emit_ldr_x8_fp(st, st_get(st, 78))
    emit_ldr_x0_fp(st, st_get(st, 79))
    if st_get(st, 77) == 14 do
        emit_u32(st, 0x8B000108)
    end
    if st_get(st, 77) == 21 do
        emit_u32(st, 0xCB000108)
    end
    if st_get(st, 77) == 20 do
        emit_u32(st, 0x9B007D08)
    end
    if st_get(st, 77) == 22 do
        emit_u32(st, 0x9AC00D08)
    end
    if st_get(st, 77) == 17 do
        emit_u32(st, 0x9AC00D09)
        emit_u32(st, 0x9B00A128)
    end
    if st_get(st, 77) == 40 do
        emit_u32(st, 0x8A000108)
    end
    if st_get(st, 77) == 41 do
        emit_u32(st, 0xAA000108)
    end
    if st_get(st, 77) == 42 do
        emit_u32(st, 0x9AC02108)
    end
    if st_get(st, 77) == 43 do
        emit_u32(st, 0x9AC02508)
    end
    if st_get(st, 77) == 130 do
        emit_u32(st, 0xCA000108) # eor x8, x8, x0
    end
    if st_get(st, 77) == 127 do
        emit_u32(st, 0x8A000108) # and x8, x8, x0
    end
    if st_get(st, 77) == 128 do
        emit_u32(st, 0xAA000108) # orr x8, x8, x0
    end
    if st_get(st, 77) == 28 do
        emit_u32(st, 0xEB00011F) # cmp x8, x0
        emit_u32(st, 0x9A9F17E8) # cset x8, eq
    end
    if st_get(st, 77) == 27 do
        emit_u32(st, 0xEB00011F) # cmp x8, x0
        emit_u32(st, 0x9A9F07E8) # cset x8, ne
    end
    if st_get(st, 77) == 24 do
        emit_u32(st, 0xEB00011F) # cmp x8, x0
        emit_u32(st, 0x9A9FA7E8) # cset x8, lt
    end
    if st_get(st, 77) == 23 do
        emit_u32(st, 0xEB00011F) # cmp x8, x0
        emit_u32(st, 0x9A9FC7E8) # cset x8, le
    end
    if st_get(st, 77) == 26 do
        emit_u32(st, 0xEB00011F) # cmp x8, x0
        emit_u32(st, 0x9A9FD7E8) # cset x8, gt
    end
    if st_get(st, 77) == 25 do
        emit_u32(st, 0xEB00011F) # cmp x8, x0
        emit_u32(st, 0x9A9FB7E8) # cset x8, ge
    end
    if st_get(st, 77) == 124 do
        emit_u32(st, 0xEB00011F) # cmp x8, x0
        emit_u32(st, 0x9A9F17E8) # cset x8, eq
    end
    if st_get(st, 77) == 125 do
        emit_u32(st, 0xEB00011F) # cmp x8, x0
        emit_u32(st, 0x9A9F07E8) # cset x8, ne
    end
    emit_str_x8_fp(st, st_get(st, 50))
    st_set(st, 74, st_get(st, 50))
end.

# Primary: number | ident | call | (expr) | null
func parse_primary_to(st):
    if st_get(st, 3) == 129 do
        next_tok(st)
        parse_primary_to(st)
        emit_ldr_x8_fp(st, st_get(st, 50))
        emit_u32(st, 0xF100011F) # cmp x8, #0
        emit_u32(st, 0x9A9F17E8) # cset x8, eq
        emit_str_x8_fp(st, st_get(st, 50))
        out
    end
    if st_get(st, 3) == 35 do
        let s_ptr = st_get(st, 5)
        let s_len = cstr_len(st, s_ptr)
        
        var has_interp = 0
        var chk_i = 0
        when chk_i < s_len loop
            if read_byte(s_ptr, chk_i) == 36 do
                if chk_i + 1 < s_len do
                    if read_byte(s_ptr, chk_i + 1) != 36 do
                        has_interp = 1
                    end
                else
                    has_interp = 1
                end
            end
            chk_i = chk_i + 1
        end

        if has_interp == 0 do
            emit_movz_x8(st, s_len + 1)
            emit_u32(st, 0xAA0803E0)
            emit_bl(st, st_get(st, 91))
            emit_u32(st, 0xAA0003E8)
            emit_str_x8_fp(st, st_get(st, 50))
            
            emit_ldr_x8_fp(st, st_get(st, 50))
            var cp_i = 0
            var dst_i = 0
            when cp_i < s_len loop
                var b_val = read_byte(s_ptr, cp_i)
                if b_val == 36 do
                    if cp_i + 1 < s_len do
                        if read_byte(s_ptr, cp_i + 1) == 36 do
                            cp_i = cp_i + 1
                        end
                    end
                end
                emit_movz_x9(st, b_val)
                emit_u32(st, 0x39000109 bit_or ((dst_i bit_and 4095) shl 10))
                dst_i = dst_i + 1
                cp_i = cp_i + 1
            end
            emit_u32(st, 0x3900011F bit_or ((dst_i bit_and 4095) shl 10))
            st_set(st, 343, 3)
            next_tok(st)
            out
        else
            emit_movz_x8(st, 1)
            emit_u32(st, 0xAA0803E0)
            emit_bl(st, st_get(st, 91))
            emit_u32(st, 0x3900001F)
            emit_u32(st, 0xAA0003E8)
            emit_str_x8_fp(st, st_get(st, 50))
            
            var cur_i = 0
            when cur_i < s_len loop
                var seg_start = cur_i
                var seg_len = 0
                var hit_dollar = 0
                when hit_dollar == 0 loop
                    if cur_i >= s_len do
                        hit_dollar = 1
                    else
                        let c = read_byte(s_ptr, cur_i)
                        if c == 36 do
                            if cur_i + 1 < s_len do
                                if read_byte(s_ptr, cur_i + 1) == 36 do
                                    cur_i = cur_i + 2
                                    seg_len = seg_len + 1
                                else
                                    hit_dollar = 1
                                end
                            else
                                hit_dollar = 1
                            end
                        else
                            cur_i = cur_i + 1
                            seg_len = seg_len + 1
                        end
                    end
                end
                
                if seg_len > 0 do
                    let seg_slot = 496
                    emit_movz_x8(st, seg_len + 1)
                    emit_u32(st, 0xAA0803E0)
                    emit_bl(st, st_get(st, 91))
                    emit_u32(st, 0xAA0003E8)
                    emit_str_x8_fp(st, seg_slot)
                    
                    emit_ldr_x8_fp(st, seg_slot)
                    var di = 0
                    var scan_p = seg_start
                    when di < seg_len loop
                        var sb = read_byte(s_ptr, scan_p)
                        if sb == 36 do
                            if scan_p + 1 < s_len do
                                if read_byte(s_ptr, scan_p + 1) == 36 do
                                    scan_p = scan_p + 1
                                end
                            end
                        end
                        emit_movz_x9(st, sb)
                        emit_u32(st, 0x39000109 bit_or ((di bit_and 4095) shl 10))
                        di = di + 1
                        scan_p = scan_p + 1
                    end
                    emit_u32(st, 0x3900011F bit_or ((seg_len bit_and 4095) shl 10))
                    
                    emit_ldr_x0_fp(st, st_get(st, 50))
                    emit_ldr_xN_fp(st, 1, seg_slot)
                    emit_bl(st, st_get(st, 422))
                    emit_u32(st, 0xAA0003E8)
                    emit_str_x8_fp(st, st_get(st, 50))
                end

                if cur_i < s_len do
                    if read_byte(s_ptr, cur_i) == 36 do
                        cur_i = cur_i + 1
                        if cur_i < s_len do
                            if read_byte(s_ptr, cur_i) == 40 do
                                cur_i = cur_i + 1
                                let expr_start = cur_i
                                var paren_depth = 1
                                when paren_depth > 0 loop
                                    if cur_i >= s_len do
                                        paren_depth = 0
                                    else
                                        let pc = read_byte(s_ptr, cur_i)
                                        if pc == 40 do
                                            paren_depth = paren_depth + 1
                                        end
                                        if pc == 41 do
                                            paren_depth = paren_depth - 1
                                        end
                                        if paren_depth > 0 do
                                            cur_i = cur_i + 1
                                        end
                                    end
                                end
                                let expr_len = cur_i - expr_start
                                if cur_i < s_len do
                                    cur_i = cur_i + 1
                                end
                                
                                let sub_src = bump_alloc(st, expr_len + 2)
                                var ei = 0
                                when ei < expr_len loop
                                    write_byte(sub_src, ei, read_byte(s_ptr, expr_start + ei))
                                    ei = ei + 1
                                end
                                write_byte(sub_src, expr_len, 0)
                                
                                let sv_src = st_get(st, 0)
                                let sv_len = st_get(st, 1)
                                let sv_pos = st_get(st, 2)
                                let sv_tok = st_get(st, 3)
                                let sv_num = st_get(st, 4)
                                let sv_str = st_get(st, 5)
                                let sv_tgt = st_get(st, 50)
                                
                                st_set(st, 0, sub_src)
                                st_set(st, 1, expr_len)
                                st_set(st, 2, 0)
                                st_set(st, 50, 496)
                                next_tok(st)
                                parse_expr_to(st)
                                
                                st_set(st, 0, sv_src)
                                st_set(st, 1, sv_len)
                                st_set(st, 2, sv_pos)
                                st_set(st, 3, sv_tok)
                                st_set(st, 4, sv_num)
                                st_set(st, 5, sv_str)
                                st_set(st, 50, sv_tgt)
                                
                                emit_ldr_x0_fp(st, 496)
                                emit_bl(st, st_get(st, 423))
                                emit_u32(st, 0xAA0003E1)
                                emit_ldr_x0_fp(st, st_get(st, 50))
                                emit_bl(st, st_get(st, 422))
                                emit_u32(st, 0xAA0003E8)
                                emit_str_x8_fp(st, st_get(st, 50))
                            else
                                let id_start = cur_i
                                var id_len = 0
                                var id_cont = 1
                                when id_cont != 0 loop
                                    if cur_i >= s_len do
                                        id_cont = 0
                                    else
                                        let ic = read_byte(s_ptr, cur_i)
                                        var is_id = 0
                                        if ic >= 97 do if ic <= 122 do is_id = 1 end end
                                        if ic >= 65 do if ic <= 90 do is_id = 1 end end
                                        if ic >= 48 do if ic <= 57 do is_id = 1 end end
                                        if ic == 95 do is_id = 1 end
                                        if is_id != 0 do
                                            cur_i = cur_i + 1
                                            id_len = id_len + 1
                                        else
                                            id_cont = 0
                                        end
                                    end
                                end
                                let id_buf = bump_alloc(st, id_len + 1)
                                var ii = 0
                                when ii < id_len loop
                                    write_byte(id_buf, ii, read_byte(s_ptr, id_start + ii))
                                    ii = ii + 1
                                end
                                write_byte(id_buf, id_len, 0)
                                
                                let v_slot = slot_of(st, id_buf, st_get(st, 51), st_get(st, 52))
                                if v_slot != 0 - 1 do
                                    let v_idx = find_local_idx(st, id_buf)
                                    var is_str_var = 0
                                    if v_idx >= 0 do
                                        if read_word(st_get(st, 366), v_idx * 8) == 3 do
                                            is_str_var = 1
                                        end
                                    end
                                    emit_ldr_x0_fp(st, v_slot)
                                    if is_str_var == 0 do
                                        emit_bl(st, st_get(st, 423))
                                    end
                                    emit_u32(st, 0xAA0003E1)
                                    emit_ldr_x0_fp(st, st_get(st, 50))
                                    emit_bl(st, st_get(st, 422))
                                    emit_u32(st, 0xAA0003E8)
                                    emit_str_x8_fp(st, st_get(st, 50))
                                end
                            end
                        end
                    end
                end
            end
            st_set(st, 343, 3)
            next_tok(st)
            out
        end
    end
    if st_get(st, 3) == 9 do
        next_tok(st)
        parse_expr_to(st)
        expect(st, 10)
        out
    end
    if st_get(st, 3) == 110 do
        # Array literal [e0, e1, ...] or [init_val; count]
        next_tok(st)
        if st_get(st, 3) == 111 do
            # Empty array []
            emit_movz_x8(st, 8)
            emit_u32(st, 0xAA0803E0) # mov x0, x8
            emit_bl(st, st_get(st, 91)) # alloc
            emit_u32(st, 0xF900001F) # str xzr, [x0, #0]
            emit_u32(st, 0x91002008) # add x8, x0, #8
            emit_str_x8_fp(st, st_get(st, 50))
            next_tok(st)
            out
        end
        st_set(st, 354, st_get(st, 50))
        st_set(st, 50, 488)
        st_set(st, 74, 488)
        parse_expr_to(st)
        if st_get(st, 3) == 12 do
            # [init_val; count]
            next_tok(st)
            if st_get(st, 3) != 2 do
                print(96)
                exit_prog(1)
            end
            st_set(st, 353, st_get(st, 4))
            next_tok(st)
            expect(st, 111)
            emit_movz_x8(st, st_get(st, 353) * 8 + 8)
            emit_u32(st, 0xAA0803E0)
            emit_bl(st, st_get(st, 91))
            emit_movz_x8(st, st_get(st, 353))
            emit_u32(st, 0xF9000008)
            emit_ldr_x8_fp(st, 488)
            st_set(st, 351, 0)
            when st_get(st, 351) < st_get(st, 353) loop
                emit_u32(st, 0xF9000008 bit_or (((st_get(st, 351) + 1) bit_and 4095) shl 10))
                st_set(st, 351, st_get(st, 351) + 1)
            end
            emit_u32(st, 0x91002008) # add x8, x0, #8
            emit_str_x8_fp(st, st_get(st, 354))
            st_set(st, 50, st_get(st, 354))
            st_set(st, 74, st_get(st, 354))
            out
        else
            # [e0, e1, e2, ...]
            st_set(st, 351, 1) # arr_len
            st_set(st, 352, 1) # more_elem
            if st_get(st, 3) == 13 do
                next_tok(st)
            else
                if st_get(st, 3) == 111 do
                    st_set(st, 352, 0)
                    next_tok(st)
                else
                    print(96)
                    exit_prog(1)
                end
            end
            when st_get(st, 352) != 0 loop
                st_set(st, 50, 488 - st_get(st, 351) * 8)
                st_set(st, 74, st_get(st, 50))
                parse_expr_to(st)
                st_set(st, 351, st_get(st, 351) + 1)
                if st_get(st, 3) == 13 do
                    next_tok(st)
                else
                    if st_get(st, 3) == 111 do
                        st_set(st, 352, 0)
                        next_tok(st)
                    else
                        print(96)
                        exit_prog(1)
                    end
                end
            end
            emit_movz_x8(st, st_get(st, 351) * 8 + 8)
            emit_u32(st, 0xAA0803E0)
            emit_bl(st, st_get(st, 91))
            emit_movz_x8(st, st_get(st, 351))
            emit_u32(st, 0xF9000008)
            st_set(st, 353, 0)
            when st_get(st, 353) < st_get(st, 351) loop
                emit_ldr_x8_fp(st, 488 - st_get(st, 353) * 8)
                emit_u32(st, 0xF9000008 bit_or (((st_get(st, 353) + 1) bit_and 4095) shl 10))
                st_set(st, 353, st_get(st, 353) + 1)
            end
            emit_u32(st, 0x91002008) # add x8, x0, #8
            emit_str_x8_fp(st, st_get(st, 354))
            st_set(st, 50, st_get(st, 354))
            st_set(st, 74, st_get(st, 354))
            out
        end
    end
    if st_get(st, 3) == 46 do
        emit_movz_x8(st, 0)
        emit_str_x8_fp(st, st_get(st, 50))
        next_tok(st)
        out
    end
    if st_get(st, 3) == 70 do
        emit_movz_x8(st, 1)
        emit_str_x8_fp(st, st_get(st, 50))
        next_tok(st)
        out
    end
    if st_get(st, 3) == 71 do
        emit_movz_x8(st, 0)
        emit_str_x8_fp(st, st_get(st, 50))
        next_tok(st)
        out
    end
    if st_get(st, 3) == 104 do
        emit_ldr_x8_fp(st, 504)
        emit_str_x8_fp(st, st_get(st, 50))
        next_tok(st)
        out
    end
    if st_get(st, 3) == 2 do
        if st_get(st, 4) > 65535 do
            emit_movz64(st, st_get(st, 4))
        else
            emit_movz_x8(st, st_get(st, 4))
        end
        emit_str_x8_fp(st, st_get(st, 50))
        next_tok(st)
        out
    end
    if st_get(st, 3) == 76 do
        # &ident (shared borrow)
        next_tok(st)
        if st_get(st, 3) != 1 do
            print(96)
            exit_prog(1)
        end
        st_set(st, 53, st_get(st, 5))
        bc_borrow_shared(st, st_get(st, 53))
        let src_li = find_local_idx(st, st_get(st, 53))
        if src_li >= 0 do
            st_set(st, 369, src_li)
            st_set(st, 343, 100 + read_word(st_get(st, 366), src_li * 8))
        end
        st_set(st, 75, slot_of(st, st_get(st, 53), st_get(st, 51), st_get(st, 52)))
        if st_get(st, 75) == 0 - 1 do
            print(97)
            exit_prog(1)
        end
        emit_ldr_x8_fp(st, st_get(st, 75))
        emit_str_x8_fp(st, st_get(st, 50))
        next_tok(st)
        out
    end
    if st_get(st, 3) == 77 do
        # &mut ident (exclusive mutable borrow)
        next_tok(st)
        if st_get(st, 3) != 1 do
            print(96)
            exit_prog(1)
        end
        st_set(st, 53, st_get(st, 5))
        bc_borrow_mut(st, st_get(st, 53))
        let src_li = find_local_idx(st, st_get(st, 53))
        if src_li >= 0 do
            st_set(st, 369, src_li)
            st_set(st, 343, 200 + read_word(st_get(st, 366), src_li * 8))
        end
        st_set(st, 75, slot_of(st, st_get(st, 53), st_get(st, 51), st_get(st, 52)))
        if st_get(st, 75) == 0 - 1 do
            print(97)
            exit_prog(1)
        end
        emit_ldr_x8_fp(st, st_get(st, 75))
        emit_str_x8_fp(st, st_get(st, 50))
        next_tok(st)
        out
    end
    if st_get(st, 3) == 1 do
        st_set(st, 53, st_get(st, 5))
        # Check if ident is an Enum
        st_set(st, 335, find_enum(st, st_get(st, 53)))
        if st_get(st, 335) >= 0 do
            st_set(st, 345, st_get(st, 335))
            next_tok(st)
            expect(st, 16)
            if st_get(st, 3) != 1 do
                print(96)
                exit_prog(1)
            end
            st_set(st, 346, st_get(st, 5))
            st_set(st, 347, find_enum_variant(st, st_get(st, 345), st_get(st, 346)))
            if st_get(st, 347) < 0 do
                print(97)
                exit_prog(1)
            end
            st_set(st, 348, st_get(st, 345) * 16 + st_get(st, 347))
            st_set(st, 349, read_word(st_get(st, 325), st_get(st, 348) * 8))
            next_tok(st)
            if st_get(st, 3) == 9 do
                # Tagged union constructor with payload: Enum.Variant(payload)
                st_set(st, 350, st_get(st, 50))
                next_tok(st)
                st_set(st, 50, 488)
                st_set(st, 74, 488)
                st_set(st, 51, st_get(st, 43))
                st_set(st, 52, st_get(st, 21))
                parse_expr_to(st)
                expect(st, 10)
                emit_movz_x8(st, 16)
                emit_u32(st, 0xAA0803E0)
                emit_bl(st, st_get(st, 91))
                emit_u32(st, 0xAA0003E8)
                emit_u32(st, 0xD2800000 bit_or ((st_get(st, 347) bit_and 65535) shl 5))
                emit_u32(st, 0xF9000100)
                emit_ldr_x0_fp(st, 488)
                emit_u32(st, 0xF9000500)
                emit_str_x8_fp(st, st_get(st, 350))
                st_set(st, 50, st_get(st, 350))
                st_set(st, 74, st_get(st, 350))
                out
            else
                # Simple enum: Enum.Variant -> tag int
                emit_movz_x8(st, st_get(st, 347))
                emit_str_x8_fp(st, st_get(st, 50))
                out
            end
        end
        next_tok(st)
        if st_get(st, 3) == 9 do
            st_set(st, 67, st_get(st, 67) + 1)
            nest_peak(st, st_get(st, 67), 222)
            nest_guard(st, st_get(st, 67), 16)
            st_set(st, 140 + st_get(st, 67), st_get(st, 53))
            st_set(st, 160 + st_get(st, 67), st_get(st, 74))
            # Nest-save arg loop state — inner calls clobber st[71]/st[48].
            st_set(st, 180 + st_get(st, 67), st_get(st, 71))
            st_set(st, 190 + st_get(st, 67), st_get(st, 48))
            next_tok(st)
            st_set(st, 71, 0)
            if st_get(st, 3) != 10 do
                st_set(st, 48, 1)
                when st_get(st, 48) != 0 loop
                    if st_get(st, 3) == 1 do
                        st_set(st, 119, st_get(st, 2))
                        st_set(st, 18, 1)
                        when st_get(st, 18) != 0 loop
                            if st_get(st, 119) >= st_get(st, 1) do
                                st_set(st, 18, 0)
                            else
                                st_set(st, 58, read_byte(st_get(st, 0), st_get(st, 119)))
                                if st_get(st, 58) == 32 do
                                    st_set(st, 119, st_get(st, 119) + 1)
                                else
                                    if st_get(st, 58) == 9 do
                                        st_set(st, 119, st_get(st, 119) + 1)
                                    else
                                        st_set(st, 18, 0)
                                    end
                                end
                            end
                        end
                        if st_get(st, 119) < st_get(st, 1) do
                            if read_byte(st_get(st, 0), st_get(st, 119)) == 58 do
                                next_tok(st)
                                next_tok(st)
                            end
                        end
                    end
                    st_set(st, 72, 400 + st_get(st, 67) * 64 + st_get(st, 71) * 8)
                    st_set(st, 50, st_get(st, 72))
                    st_set(st, 74, st_get(st, 72))
                    parse_expr_to(st)
                    st_set(st, 71, st_get(st, 71) + 1)
                    if st_get(st, 3) == 13 do
                        next_tok(st)
                    else
                        st_set(st, 48, 0)
                    end
                end
            end
            expect(st, 10)
            emit_load_args(st, st_get(st, 71), 400 + st_get(st, 67) * 64)
            st_set(st, 314, st_get(st, 71))
            st_set(st, 56, st_get(st, 140 + st_get(st, 67)))
            st_set(st, 50, st_get(st, 160 + st_get(st, 67)))
            st_set(st, 74, st_get(st, 160 + st_get(st, 67)))
            st_set(st, 71, st_get(st, 180 + st_get(st, 67)))
            st_set(st, 48, st_get(st, 190 + st_get(st, 67)))
            st_set(st, 67, st_get(st, 67) - 1)
            st_set(st, 55, find_fn(st, st_get(st, 56)))
            if st_get(st, 55) < 0 do
                st_set(st, 55, builtin_kind(st, st_get(st, 56)))
                if st_get(st, 55) == 0 do
                    st_set(st, 312, find_entity(st, st_get(st, 56)))
                    if st_get(st, 312) >= 0 do
                        st_set(st, 317, st_get(st, 312))
                        st_set(st, 313, read_word(st_get(st, 291), st_get(st, 317) * 8))
                        st_set(st, 318, read_word(st_get(st, 299), st_get(st, 317) * 8))
                        if st_get(st, 318) != 0 do
                            st_set(st, 319, st_get(st, 317) * 16 + st_get(st, 313) - 1)
                            st_set(st, 316, read_word(st_get(st, 294), st_get(st, 319) * 8) + read_word(st_get(st, 298), st_get(st, 319) * 8))
                            st_set(st, 316, ((st_get(st, 316) + 7) / 8) * 8)
                            emit_movz_x8(st, st_get(st, 316))
                        else
                            emit_movz_x8(st, st_get(st, 313) * 8)
                        end
                        emit_u32(st, 0xAA0803E0)
                        emit_bl(st, st_get(st, 91))
                        emit_u32(st, 0xAA0003E8)
                        st_set(st, 73, 0)
                        when st_get(st, 73) < st_get(st, 314) loop
                            let ai = st_get(st, 73)
                            emit_ldr_xN_fp(st, 0, 400 + (st_get(st, 67) + 1) * 64 + ai * 8)
                            st_set(st, 319, st_get(st, 317) * 16 + ai)
                            st_set(st, 315, read_word(st_get(st, 294), st_get(st, 319) * 8))
                            st_set(st, 316, read_word(st_get(st, 298), st_get(st, 319) * 8))
                            emit_field_store(st, st_get(st, 315), st_get(st, 316))
                            st_set(st, 73, ai + 1)
                        end
                        emit_u32(st, 0xAA0803E0)
                        st_set(st, 343, 20 + st_get(st, 317))
                    else
                        print(98)
                        exit_prog(1)
                    end
                else
                    emit_builtin(st)
                end
            else
                emit_bl_later(st, st_get(st, 55))
            end
            emit_u32(st, 0xAA0003E8)
            emit_str_x8_fp(st, st_get(st, 74))
            out
        end
        st_set(st, 75, slot_of(st, st_get(st, 53), st_get(st, 51), st_get(st, 52)))
        if st_get(st, 75) == 0 - 1 do
            if st_get(st, 3) == 16 do
                next_tok(st)
                if st_get(st, 3) != 1 do
                    print(96)
                    exit_prog(1)
                end
                st_set(st, 53, st_get(st, 5))
                next_tok(st)
                if st_get(st, 3) == 9 do
                    st_set(st, 67, st_get(st, 67) + 1)
                    nest_peak(st, st_get(st, 67), 222)
                    nest_guard(st, st_get(st, 67), 16)
                    st_set(st, 140 + st_get(st, 67), st_get(st, 53))
                    st_set(st, 160 + st_get(st, 67), st_get(st, 74))
                    st_set(st, 180 + st_get(st, 67), st_get(st, 71))
                    st_set(st, 190 + st_get(st, 67), st_get(st, 48))
                    next_tok(st)
                    st_set(st, 71, 0)
                    if st_get(st, 3) != 10 do
                        st_set(st, 48, 1)
                        when st_get(st, 48) != 0 loop
                            if st_get(st, 3) == 1 do
                                st_set(st, 119, st_get(st, 2))
                                st_set(st, 18, 1)
                                when st_get(st, 18) != 0 loop
                                    if st_get(st, 119) >= st_get(st, 1) do
                                        st_set(st, 18, 0)
                                    else
                                        st_set(st, 58, read_byte(st_get(st, 0), st_get(st, 119)))
                                        if st_get(st, 58) == 32 do
                                            st_set(st, 119, st_get(st, 119) + 1)
                                        else
                                            if st_get(st, 58) == 9 do
                                                st_set(st, 119, st_get(st, 119) + 1)
                                            else
                                                st_set(st, 18, 0)
                                            end
                                        end
                                    end
                                end
                                if st_get(st, 119) < st_get(st, 1) do
                                    if read_byte(st_get(st, 0), st_get(st, 119)) == 58 do
                                        next_tok(st)
                                        next_tok(st)
                                    end
                                end
                            end
                            st_set(st, 72, 400 + st_get(st, 67) * 64 + st_get(st, 71) * 8)
                            st_set(st, 50, st_get(st, 72))
                            st_set(st, 74, st_get(st, 72))
                            parse_expr_to(st)
                            st_set(st, 71, st_get(st, 71) + 1)
                            if st_get(st, 3) == 13 do
                                next_tok(st)
                            else
                                st_set(st, 48, 0)
                            end
                        end
                    end
                    expect(st, 10)
                    emit_load_args(st, st_get(st, 71), 400 + st_get(st, 67) * 64)
                    st_set(st, 314, st_get(st, 71))
                    st_set(st, 56, st_get(st, 140 + st_get(st, 67)))
                    st_set(st, 50, st_get(st, 160 + st_get(st, 67)))
                    st_set(st, 74, st_get(st, 160 + st_get(st, 67)))
                    st_set(st, 71, st_get(st, 180 + st_get(st, 67)))
                    st_set(st, 48, st_get(st, 190 + st_get(st, 67)))
                    st_set(st, 67, st_get(st, 67) - 1)
                    st_set(st, 55, find_fn(st, st_get(st, 56)))
                    if st_get(st, 55) < 0 do
                        print(99)
                        exit_prog(1)
                    end
                    emit_bl_later(st, st_get(st, 55))
                    emit_u32(st, 0xAA0003E8)
                    emit_str_x8_fp(st, st_get(st, 74))
                    out
                end
            end
            print(97)
            exit_prog(1)
        end
        bc_check_read(st, st_get(st, 53))
        let v_li = find_local_idx(st, st_get(st, 53))
        if v_li >= 0 do
            let v_type = read_word(st_get(st, 366), v_li * 8)
            st_set(st, 343, v_type)
        end
        let var_ident = st_get(st, 53)
        let v_slot = st_get(st, 75)
        let orig_target = st_get(st, 50)
        emit_ldr_x8_fp(st, v_slot)
        var had_postfix = 0
        when (st_get(st, 3) == 16) bit_or (st_get(st, 3) == 110) loop
            had_postfix = 1
            if st_get(st, 3) == 16 do
                next_tok(st)
                if st_get(st, 3) != 1 do
                    print(96)
                    exit_prog(1)
                end
                let sec_name = st_get(st, 5)
                let ufcs_fn = find_fn(st, sec_name)
                let ufcs_bk = builtin_kind(st, sec_name)
                if ufcs_fn >= 0 do
                    # UFCS user function call: x.method(args...)
                    emit_str_x8_fp(st, 400 + (st_get(st, 67) + 1) * 64 + 0 * 8)
                    st_set(st, 67, st_get(st, 67) + 1)
                    st_set(st, 140 + st_get(st, 67), sec_name)
                    st_set(st, 160 + st_get(st, 67), orig_target)
                    st_set(st, 180 + st_get(st, 67), 1)
                    st_set(st, 190 + st_get(st, 67), st_get(st, 48))
                    next_tok(st)
                    if st_get(st, 3) == 9 do
                        next_tok(st)
                        if st_get(st, 3) != 10 do
                            st_set(st, 48, 1)
                            when st_get(st, 48) != 0 loop
                                st_set(st, 72, 400 + st_get(st, 67) * 64 + st_get(st, 180 + st_get(st, 67)) * 8)
                                st_set(st, 50, st_get(st, 72))
                                st_set(st, 74, st_get(st, 72))
                                parse_expr_to(st)
                                st_set(st, 180 + st_get(st, 67), st_get(st, 180 + st_get(st, 67)) + 1)
                                if st_get(st, 3) == 13 do
                                    next_tok(st)
                                else
                                    st_set(st, 48, 0)
                                end
                            end
                        end
                        expect(st, 10)
                    end
                    let num_args = st_get(st, 180 + st_get(st, 67))
                    emit_load_args(st, num_args, 400 + st_get(st, 67) * 64)
                    emit_bl_later(st, ufcs_fn)
                    emit_u32(st, 0xAA0003E8)
                    st_set(st, 48, st_get(st, 190 + st_get(st, 67)))
                    st_set(st, 67, st_get(st, 67) - 1)
                else
                    if ufcs_bk > 0 do
                        # UFCS builtin call: x.len() or x.len
                        emit_str_x8_fp(st, 400 + (st_get(st, 67) + 1) * 64 + 0 * 8)
                        st_set(st, 67, st_get(st, 67) + 1)
                        st_set(st, 140 + st_get(st, 67), sec_name)
                        st_set(st, 160 + st_get(st, 67), orig_target)
                        st_set(st, 180 + st_get(st, 67), 1)
                        st_set(st, 190 + st_get(st, 67), st_get(st, 48))
                        next_tok(st)
                        if st_get(st, 3) == 9 do
                            next_tok(st)
                            expect(st, 10)
                        end
                        emit_ldr_xN_fp(st, 0, 400 + st_get(st, 67) * 64 + 0 * 8)
                        st_set(st, 55, ufcs_bk)
                        emit_builtin(st)
                        emit_u32(st, 0xAA0003E8)
                        st_set(st, 48, st_get(st, 190 + st_get(st, 67)))
                        st_set(st, 67, st_get(st, 67) - 1)
                    else
                        st_set(st, 118, find_field_off(st, sec_name))
                        st_set(st, 119, find_field_size(st, sec_name))
                        if st_get(st, 118) < 0 do
                            print(97)
                            exit_prog(1)
                        end
                        emit_field_load(st, st_get(st, 118), st_get(st, 119))
                        next_tok(st)
                    end
                end
            else
                # Indexing: target[index] or slicing: target[start..end]
                next_tok(st)
                emit_str_x8_fp(st, 504) # intermediate base in 504
                st_set(st, 50, 496)
                st_set(st, 74, 496)
                parse_expr_to(st)
                if st_get(st, 3) == 85 do
                    # Slicing: target[start..end]
                    next_tok(st)
                    st_set(st, 50, 488)
                    st_set(st, 74, 488)
                    parse_expr_to(st)
                    expect(st, 111)
                    # src_ptr = base + start * 8 (compute before alloc)
                    emit_ldr_x8_fp(st, 504)  # base
                    emit_ldr_x0_fp(st, 496)  # start
                    emit_u32(st, 0x8B204D08) # add x8, x8, x0, lsl #3 (src_ptr in x8)
                    emit_str_x8_fp(st, 496)  # src_ptr in 496
                    # len = end - start
                    emit_ldr_x8_fp(st, 488)  # end
                    emit_ldr_xN_fp(st, 9, 504) # base in x9
                    emit_ldr_x0_fp(st, 496)    # src_ptr in x0
                    emit_u32(st, 0xCB090000)   # sub x0, x0, x9 (start * 8)
                    emit_u32(st, 0xD343FC00)   # lsr x0, x0, #3 (start in x0)
                    emit_u32(st, 0xCB000108)   # sub x8, x8, x0 (len in x8)
                    emit_str_x8_fp(st, 488)    # len in 488
                    # alloc (len * 8 + 8) bytes
                    emit_u32(st, 0xD37DF108)   # lsl x8, x8, #3
                    emit_u32(st, 0x91002108)   # add x8, x8, #8
                    emit_u32(st, 0xAA0803E0)   # mov x0, x8
                    emit_bl(st, st_get(st, 91)) # alloc -> x0 = new_buf
                    emit_ldr_x8_fp(st, 488)    # len
                    emit_u32(st, 0xF9000008)   # str x8, [x0, #0] (store header len)
                    emit_u32(st, 0x91002008)   # add x8, x0, #8 (dst_ptr)
                    emit_str_x8_fp(st, 504)    # dst_ptr in 504
                    # loop copy elements:
                    emit_ldr_xN_fp(st, 1, 496) # src in x1
                    emit_ldr_xN_fp(st, 2, 504) # dst in x2
                    emit_ldr_xN_fp(st, 3, 488) # len in x3
                    emit_u32(st, 0xB40000A3)   # cbz x3, +20 (skip to done)
                    emit_u32(st, 0xF8408424)   # ldr x4, [x1], #8
                    emit_u32(st, 0xF8008444)   # str x4, [x2], #8
                    emit_u32(st, 0xD1000463)   # sub x3, x3, #1
                    emit_u32(st, 0xB5FFFFA3)   # cbnz x3, -12
                    emit_ldr_x8_fp(st, 504)    # x8 = slice data_ptr
                else
                    expect(st, 111)
                    emit_ldr_x8_fp(st, 504)
                    emit_ldr_x0_fp(st, 496)
                    emit_u32(st, 0xF8607908) # ldr x8, [x8, x0, lsl #3]
                end
            end
        end
        if had_postfix == 0 do
            bc_check_move(st, var_ident)
        end
        emit_str_x8_fp(st, orig_target)
        out
    end
end.

# prec 20: * / %
func parse_mul_to(st):
    parse_primary_to(st)
    var active = 1
    when active != 0 loop
        let tok = st_get(st, 3)
        var is_op = 0
        if tok == 20 do is_op = 1 end
        if tok == 22 do is_op = 1 end
        if tok == 17 do is_op = 1 end
        if is_op != 0 do
            next_tok(st)
            expr_alloc_rhs(st)
            st_set(st, 120 + st_get(st, 66), tok)
            parse_primary_to(st)
            expr_emit_binop(st)
        else
            active = 0
        end
    end
end.

# prec 12: shl shr >>
func parse_shift_to(st):
    parse_mul_to(st)
    var active = 1
    when active != 0 loop
        let tok = st_get(st, 3)
        var is_op = 0
        if tok == 42 do is_op = 1 end
        if tok == 43 do is_op = 1 end
        if tok == 131 do is_op = 1 end
        if is_op != 0 do
            next_tok(st)
            expr_alloc_rhs(st)
            st_set(st, 120 + st_get(st, 66), tok)
            parse_mul_to(st)
            expr_emit_binop(st)
        else
            active = 0
        end
    end
end.

# prec 10: + -
func parse_add_to(st):
    parse_shift_to(st)
    var active = 1
    when active != 0 loop
        let tok = st_get(st, 3)
        var is_op = 0
        if tok == 14 do is_op = 1 end
        if tok == 21 do is_op = 1 end
        if is_op != 0 do
            next_tok(st)
            expr_alloc_rhs(st)
            st_set(st, 120 + st_get(st, 66), tok)
            parse_shift_to(st)
            expr_emit_binop(st)
        else
            active = 0
        end
    end
end.

# prec 6 & 5: ==, !=, <, <=, >, >=, ?=, ?=/=
func parse_rel_to(st):
    parse_add_to(st)
    var active = 1
    when active != 0 loop
        let tok = st_get(st, 3)
        var is_rel = 0
        if tok >= 23 do
            if tok <= 28 do
                is_rel = 1
            end
        end
        if tok == 124 do is_rel = 1 end
        if tok == 125 do is_rel = 1 end
        if is_rel != 0 do
            next_tok(st)
            expr_alloc_rhs(st)
            st_set(st, 120 + st_get(st, 66), tok)
            parse_add_to(st)
            expr_emit_binop(st)
        else
            active = 0
        end
    end
end.

# prec 3: bit_and / and / & / &&
func parse_band_to(st):
    parse_rel_to(st)
    var active = 1
    when active != 0 loop
        let tok = st_get(st, 3)
        var is_op = 0
        if tok == 40 do is_op = 1 end
        if tok == 127 do is_op = 1 end
        if tok == 76 do is_op = 1 end
        if is_op != 0 do
            next_tok(st)
            expr_alloc_rhs(st)
            st_set(st, 120 + st_get(st, 66), tok)
            parse_rel_to(st)
            expr_emit_binop(st)
        else
            active = 0
        end
    end
end.

# parse_expr_to: prec 2 bit_or / or / || / xor / bit_xor / ^ — entry for all expression contexts.
# st[50]=dest_slot, st[51]=loc_names, st[52]=num_locals.
func parse_expr_to(st):
    parse_band_to(st)
    var active = 1
    when active != 0 loop
        let tok = st_get(st, 3)
        var is_op = 0
        if tok == 41 do is_op = 1 end
        if tok == 128 do is_op = 1 end
        if tok == 130 do is_op = 1 end
        if is_op != 0 do
            next_tok(st)
            expr_alloc_rhs(st)
            st_set(st, 120 + st_get(st, 66), tok)
            parse_band_to(st)
            expr_emit_binop(st)
        else
            active = 0
        end
    end
end.

# parse_stmts: parse statement body until `end` (tok 8) or EOF (tok 0).
func parse_stmts(st):
    st_set(st, 89, st_get(st, 89) + 1)
    nest_peak(st, st_get(st, 89), 223)
    nest_guard(st, st_get(st, 89), 32)
    var stmt_active = 1
    when stmt_active != 0 loop
        let prev_pos = st_get(st, 2)
        st_set(st, 77, st_get(st, 3))
        if st_get(st, 77) == 8 do
            stmt_active = 0
        end
        if st_get(st, 77) == 0 do
            stmt_active = 0
        end
        if st_get(st, 77) == 34 do
            stmt_active = 0
        end
        if st_get(st, 77) == 80 do
            stmt_active = 0
        end
        if st_get(st, 77) == 102 do
            stmt_active = 0
        end
        if st_get(st, 77) == 103 do
            stmt_active = 0
        end
        if is_case_pattern(st) != 0 do
            stmt_active = 0
        end
        if st_get(st, 77) == 12 do
            next_tok(st)
        end
        st_set(st, 128, 0)
        if st_get(st, 77) == 6 do
            st_set(st, 128, 1)
        end
        if st_get(st, 77) == 75 do
            st_set(st, 128, 1)
        end
        if st_get(st, 77) == 74 do
            st_set(st, 128, 1)
        end
        if st_get(st, 128) != 0 do
            st_set(st, 129, 0)
            if st_get(st, 77) == 75 do
                st_set(st, 129, 1)
            end
            st_set(st, 342, 9)
            next_tok(st)
            if st_get(st, 3) != 1 do
                print(95)
                exit_prog(1)
            end
            st_set(st, 45, st_get(st, 5))
            next_tok(st)
            if st_get(st, 3) == 11 do
                next_tok(st)
                st_set(st, 342, parse_type_spec(st))
                next_tok(st)
            end
            expect(st, 15)
            st_set(st, 78, st_get(st, 21))
            write_word(st_get(st, 43), st_get(st, 78) * 8, st_get(st, 45))
            st_set(st, 79, ra_alloc_local(st, st_get(st, 78)))
            st_set(st, 21, st_get(st, 78) + 1)
            hash_put_at(st, 97, 98, st_get(st, 45), st_get(st, 79))
            bc_register_local(st, st_get(st, 78), st_get(st, 129), st_get(st, 342))
            # Mini coalesce: only `let a = b;` (next non-ws is ';') — not `a+b` / `f()`.
            st_set(st, 116, 0)
            if st_get(st, 3) == 1 do
                st_set(st, 117, st_get(st, 2))
                st_set(st, 118, 1)
                when st_get(st, 118) != 0 loop
                    if st_get(st, 117) >= st_get(st, 1) do
                        st_set(st, 118, 0)
                    else
                        st_set(st, 58, read_byte(st_get(st, 0), st_get(st, 117)))
                        st_set(st, 46, 0)
                        if st_get(st, 58) == 32 do
                            st_set(st, 46, 1)
                        end
                        if st_get(st, 58) == 9 do
                            st_set(st, 46, 1)
                        end
                        if st_get(st, 58) == 10 do
                            st_set(st, 46, 1)
                        end
                        if st_get(st, 58) == 13 do
                            st_set(st, 46, 1)
                        end
                        if st_get(st, 46) != 0 do
                            st_set(st, 117, st_get(st, 117) + 1)
                        else
                            st_set(st, 118, 0)
                        end
                    end
                end
                if st_get(st, 117) < st_get(st, 1) do
                    if read_byte(st_get(st, 0), st_get(st, 117)) == 59 do
                        st_set(st, 116, 1)
                    end
                end
            end
            if st_get(st, 116) != 0 do
                let src_li = find_local_idx(st, st_get(st, 5))
                if src_li >= 0 do
                    write_word(st_get(st, 368), st_get(st, 78) * 8, src_li)
                end
                bc_check_move(st, st_get(st, 5))
                st_set(st, 115, slot_of(st, st_get(st, 5), st_get(st, 43), st_get(st, 21)))
                if st_get(st, 79) < 0 - 1 do
                    if st_get(st, 115) < 0 - 1 do
                        emit_mov_rr(st, (0 - st_get(st, 79)) - 1, (0 - st_get(st, 115)) - 1)
                    else
                        emit_ldr_x8_fp(st, st_get(st, 115))
                        emit_str_x8_fp(st, st_get(st, 79))
                    end
                else
                    emit_ldr_x8_fp(st, st_get(st, 115))
                    emit_str_x8_fp(st, st_get(st, 79))
                end
                next_tok(st)
                if st_get(st, 3) == 12 do
                    next_tok(st)
                end
            else
                st_set(st, 343, 0)
                st_set(st, 369, 0 - 1)
                st_set(st, 50, st_get(st, 79))
                st_set(st, 74, st_get(st, 79))
                st_set(st, 51, st_get(st, 43))
                st_set(st, 52, st_get(st, 21))
                parse_expr_to(st)
                if st_get(st, 343) > 0 do
                    write_word(st_get(st, 366), st_get(st, 78) * 8, st_get(st, 343))
                end
                if st_get(st, 369) >= 0 do
                    write_word(st_get(st, 368), st_get(st, 78) * 8, st_get(st, 369))
                end
                if st_get(st, 3) == 12 do
                    next_tok(st)
                end
            end
        end
        if st_get(st, 77) == 49 do
            parse_type_alias(st)
        end
        if st_get(st, 77) == 72 do
            parse_enum(st)
        end
        # ── print expr; | print "str"; ──
        if st_get(st, 77) == 7 do
            next_tok(st)
            if st_get(st, 3) == 35 do
                # string literal → materialize on stack, call _rt_printstr
                st_set(st, 53, st_get(st, 5))
                st_set(st, 70, 0)
                st_set(st, 18, 1)
                when st_get(st, 18) != 0 loop
                    if read_byte(st_get(st, 53), st_get(st, 70)) == 0 do
                        st_set(st, 18, 0)
                    else
                        st_set(st, 70, st_get(st, 70) + 1)
                    end
                end
                st_set(st, 72, ((st_get(st, 70) + 15) / 16) * 16)
                if st_get(st, 72) < 16 do
                    st_set(st, 72, 16)
                end
                emit_u32(st, 0xD10003FF bit_or ((st_get(st, 72) bit_and 4095) shl 10))
                st_set(st, 71, 0)
                when st_get(st, 71) < st_get(st, 70) loop
                    st_set(st, 58, read_byte(st_get(st, 53), st_get(st, 71)))
                    emit_movz_x8(st, st_get(st, 58))
                    emit_u32(st, 0x390003E8 bit_or ((st_get(st, 71) bit_and 4095) shl 10))
                    st_set(st, 71, st_get(st, 71) + 1)
                end
                emit_u32(st, 0x910003E0)
                emit_movz_x8(st, st_get(st, 70))
                emit_u32(st, 0xAA0803E1)
                emit_bl(st, st_get(st, 94))
                emit_u32(st, 0x910003FF bit_or ((st_get(st, 72) bit_and 4095) shl 10))
                next_tok(st)
                if st_get(st, 3) == 12 do
                    next_tok(st)
                end
            else
                st_set(st, 50, 480)
                st_set(st, 74, 480)
                st_set(st, 51, st_get(st, 43))
                st_set(st, 52, st_get(st, 21))
                parse_expr_to(st)
                emit_ldr_x0_fp(st, 480)
                emit_bl(st, st_get(st, 10))
                if st_get(st, 3) == 12 do
                    next_tok(st)
                end
            end
        end
        # ── out [expr]; ──
        if st_get(st, 77) == 5 do
            next_tok(st)
            if st_get(st, 3) == 12 do
                # bare `out;` — void return
                next_tok(st)
                emit_epilogue(st)
            else
                if st_get(st, 3) == 1 do
                    let ret_li = find_local_idx(st, st_get(st, 5))
                    if ret_li >= 0 do
                        let ret_type = read_word(st_get(st, 366), ret_li * 8)
                        if is_type_move(st, ret_type) != 0 do
                            bc_check_escape(st, st_get(st, 5), 0)
                        end
                    end
                end
                st_set(st, 50, 480)
                st_set(st, 74, 480)
                st_set(st, 51, st_get(st, 43))
                st_set(st, 52, st_get(st, 21))
                parse_expr_to(st)
                emit_ldr_x0_fp(st, 480)
                emit_epilogue(st)
                if st_get(st, 3) == 12 do
                    next_tok(st)
                end
            end
        end
        # ── arena: … end — §4.6 sub-arena via heap bump watermark ──
        if st_get(st, 77) == 44 do
            bc_scope_enter(st)
            next_tok(st)
            expect(st, 11)
            # Keep arena watermarks above local/expression/call scratch (< 1.5KB).
            st_set(st, 118, 2048 + st_get(st, 89) * 8)
            emit_u32(st, 0xF9400F68)
            emit_str_x8_fp(st, st_get(st, 118))
            parse_stmts(st)
            # Restore bump — reclaim all alloc() inside the block.
            # parse_stmts/next_tok clobber st[118], so recompute the slot.
            st_set(st, 118, 2048 + st_get(st, 89) * 8)
            emit_ldr_x8_fp(st, st_get(st, 118))
            emit_u32(st, 0xF9000F68)
            expect(st, 8)
            bc_scope_exit(st)
        end
        # ── break — §9.6 exit nearest loop ──
        if st_get(st, 77) == 82 do
            loop_emit_break(st)
            next_tok(st)
            if st_get(st, 3) == 12 do
                next_tok(st)
            end
        end
        # ── skip — §9.6 jump to next iteration of nearest loop ──
        if st_get(st, 77) == 83 do
            loop_emit_skip(st)
            next_tok(st)
            if st_get(st, 3) == 12 do
                next_tok(st)
            end
        end
        # ── throw expr; — §13.1 error throwing ──
        if st_get(st, 77) == 101 do
            next_tok(st)
            st_set(st, 50, 480)
            st_set(st, 74, 480)
            st_set(st, 51, st_get(st, 43))
            st_set(st, 52, st_get(st, 21))
            parse_expr_to(st)
            emit_ldr_x8_fp(st, 480)
            emit_str_x8_fp(st, 504)
            emit_ldr_x0_fp(st, 480)
            emit_u32(st, 0xD2800030)
            emit_u32(st, 0xD4001001)
            if st_get(st, 3) == 12 do
                next_tok(st)
            end
        end
        # ── for i in start..end OR for item in arr — §9.3 range & array loop ──
        if st_get(st, 77) == 81 do
            next_tok(st)
            if st_get(st, 3) != 1 do
                print(96)
                exit_prog(1)
            end
            let var_name = st_get(st, 5)
            var i_slot = slot_of(st, var_name, st_get(st, 43), st_get(st, 21))
            if i_slot == 0 - 1 do
                let li = st_get(st, 21)
                write_word(st_get(st, 43), li * 8, var_name)
                i_slot = ra_alloc_local(st, li)
                st_set(st, 21, li + 1)
                hash_put_at(st, 97, 98, var_name, i_slot)
                bc_register_local(st, li, 1, 9)
            end
            next_tok(st)
            expect(st, 4)
            st_set(st, 50, 480)
            st_set(st, 74, 480)
            st_set(st, 51, st_get(st, 43))
            st_set(st, 52, st_get(st, 21))
            parse_expr_to(st)
            if st_get(st, 3) == 85 do
                # Range loop: for i in start..end
                next_tok(st)
                emit_ldr_x8_fp(st, 480)
                emit_str_x8_fp(st, i_slot)
                st_set(st, 50, 488)
                st_set(st, 74, 488)
                st_set(st, 51, st_get(st, 43))
                st_set(st, 52, st_get(st, 21))
                parse_expr_to(st)
                emit_ldr_x8_fp(st, 488)
                emit_str_x8_fp(st, 496)
                if st_get(st, 3) == 33 do
                    next_tok(st)
                else
                    if st_get(st, 3) == 11 do
                        next_tok(st)
                    else
                        expect(st, 33)
                    end
                end
                let check_site = st_get(st, 9)
                emit_u32(st, 0x14000000)
                let hdr_off = st_get(st, 9)
                loop_push(st, hdr_off)
                emit_ldr_x8_fp(st, i_slot)
                emit_u32(st, 0x91000508)
                emit_str_x8_fp(st, i_slot)
                let check_target = st_get(st, 9)
                let check_imm = (check_target - check_site) / 4
                emit_u32_at(st, check_site, 0x14000000 bit_or (check_imm bit_and 0x03FFFFFF))
                emit_ldr_x8_fp(st, i_slot)
                emit_ldr_x0_fp(st, 496)
                emit_u32(st, 0xEB00011F)
                let cur_d = st_get(st, 371)
                let cond_site = st_get(st, 9)
                write_word(st_get(st, 372), cur_d * 8, cond_site)
                emit_u32(st, 0x5400000A)
                parse_stmts(st)
                expect(st, 8)
                for_finish(st, i_slot)
            else
                # Array iteration loop: for item in arr
                let arr_slot = ra_alloc_local(st, st_get(st, 21))
                st_set(st, 21, st_get(st, 21) + 1)
                let idx_slot = ra_alloc_local(st, st_get(st, 21))
                st_set(st, 21, st_get(st, 21) + 1)
                let len_slot = ra_alloc_local(st, st_get(st, 21))
                st_set(st, 21, st_get(st, 21) + 1)
                emit_ldr_x8_fp(st, 480)
                emit_str_x8_fp(st, arr_slot)
                emit_movz_x8(st, 0)
                emit_str_x8_fp(st, idx_slot)
                emit_ldr_x8_fp(st, arr_slot)
                emit_u32(st, 0xF85F8108)
                emit_str_x8_fp(st, len_slot)
                if st_get(st, 3) == 33 do
                    next_tok(st)
                else
                    if st_get(st, 3) == 11 do
                        next_tok(st)
                    end
                end
                let hdr_off = st_get(st, 9)
                loop_push(st, hdr_off)
                emit_ldr_x8_fp(st, idx_slot)
                emit_ldr_x0_fp(st, len_slot)
                emit_u32(st, 0xEB00011F)
                let cur_d = st_get(st, 371)
                let cond_site = st_get(st, 9)
                write_word(st_get(st, 372), cur_d * 8, cond_site)
                emit_u32(st, 0x5400000A)
                emit_ldr_x8_fp(st, arr_slot)
                emit_ldr_x0_fp(st, idx_slot)
                emit_u32(st, 0xF8607908)
                emit_str_x8_fp(st, i_slot)
                emit_ldr_x8_fp(st, idx_slot)
                emit_u32(st, 0x91000508)
                emit_str_x8_fp(st, idx_slot)
                parse_stmts(st)
                expect(st, 8)
                let rel = (hdr_off - st_get(st, 9)) / 4
                emit_u32(st, 0x14000000 bit_or (rel bit_and 0x03FFFFFF))
                let end_off = st_get(st, 9)
                let cond_imm = (end_off - cond_site) / 4
                let cond_shift = (cond_imm bit_and 0x7FFFF) * 32
                emit_u32_at(st, cond_site, 0x5400000A bit_or cond_shift)
                loop_pop(st, end_off)
            end
        end
        # ── loop … end & loop N: … end — §9.4 & §9.5 ──
        if st_get(st, 77) == 31 do
            next_tok(st)
            if st_get(st, 3) == 2 do
                st_set(st, 50, 480)
                st_set(st, 74, 480)
                st_set(st, 51, st_get(st, 43))
                st_set(st, 52, st_get(st, 21))
                parse_expr_to(st)
                expect(st, 11)
                emit_ldr_x8_fp(st, 480)
                emit_str_x8_fp(st, 496)
                let hdr_off = st_get(st, 9)
                loop_push(st, hdr_off)
                emit_ldr_x8_fp(st, 496)
                emit_u32(st, 0xF100011F)
                let cur_d = st_get(st, 371)
                let cond_site = st_get(st, 9)
                write_word(st_get(st, 372), cur_d * 8, cond_site)
                emit_u32(st, 0x5400000D)
                emit_u32(st, 0xD1000508)
                emit_str_x8_fp(st, 496)
                parse_stmts(st)
                expect(st, 8)
                loop_cnt_finish(st)
            else
                if st_get(st, 3) == 11 do
                    next_tok(st)
                end
                let hdr_off = st_get(st, 9)
                loop_push(st, hdr_off)
                parse_stmts(st)
                expect(st, 8)
                loop_finish(st)
            end
        end
        # ── case expr … end — §21 pattern matching ──
        if st_get(st, 77) == 84 do
            next_tok(st)
            if st_get(st, 3) == 11 do
                next_tok(st)
            end
            st_set(st, 50, 480)
            st_set(st, 74, 480)
            st_set(st, 51, st_get(st, 43))
            st_set(st, 52, st_get(st, 21))
            parse_expr_to(st)
            if st_get(st, 3) == 11 do
                next_tok(st)
            end
            case_push(st)
            var case_active = 1
            when case_active != 0 loop
                if st_get(st, 3) == 8 do
                    case_active = 0
                else
                    if st_get(st, 3) == 0 do
                        case_active = 0
                    else
                        if st_get(st, 3) == 34 do
                            # else: default branch
                            next_tok(st)
                            if st_get(st, 3) == 11 do
                                next_tok(st)
                            end
                            parse_stmts(st)
                            case_emit_end_jump(st)
                            case_active = 0
                        else
                            st_set(st, 50, 488)
                            st_set(st, 74, 488)
                            st_set(st, 51, st_get(st, 43))
                            st_set(st, 52, st_get(st, 21))
                            parse_expr_to(st)
                            if st_get(st, 3) == 85 do
                                # Range pattern: min..max:
                                next_tok(st)
                                st_set(st, 50, 496)
                                st_set(st, 74, 496)
                                st_set(st, 51, st_get(st, 43))
                                st_set(st, 52, st_get(st, 21))
                                parse_expr_to(st)
                                expect(st, 11)
                                emit_ldr_x8_fp(st, 480)
                                emit_ldr_x0_fp(st, 488)
                                emit_u32(st, 0xEB00011F)
                                let br_site1 = st_get(st, 9)
                                emit_u32(st, 0x5400000B)
                                emit_ldr_x8_fp(st, 480)
                                emit_ldr_x0_fp(st, 496)
                                emit_u32(st, 0xEB00011F)
                                let br_site2 = st_get(st, 9)
                                emit_u32(st, 0x5400000C)
                                parse_stmts(st)
                                case_emit_end_jump(st)
                                patch_br(st, br_site1, 11)
                                patch_br(st, br_site2, 12)
                            else
                                expect(st, 11)
                                emit_ldr_x8_fp(st, 480)
                                emit_ldr_x0_fp(st, 488)
                                emit_u32(st, 0xEB00011F)
                                let next_br_site = st_get(st, 9)
                                emit_u32(st, 0x54000001)
                                parse_stmts(st)
                                case_emit_end_jump(st)
                                patch_br(st, next_br_site, 1)
                            end
                            if st_get(st, 3) == 12 do
                                next_tok(st)
                            end
                        end
                    end
                end
            end
            expect(st, 8)
            let end_off = st_get(st, 9)
            case_pop(st, end_off)
        end
        # ── if cond do … [eif …] [else …] end ──
        if st_get(st, 77) == 32 do
            next_tok(st)
            if_push(st)
            # parse LHS of condition → slot 480
            st_set(st, 50, 480)
            st_set(st, 74, 480)
            st_set(st, 51, st_get(st, 43))
            st_set(st, 52, st_get(st, 21))
            parse_expr_to(st)
            var if_op = 27
            if st_get(st, 3) == 33 do
                # Unary bool cond: if cond do
                if_op = 27
                expect(st, 33)
                emit_ldr_x8_fp(st, 480)
                emit_u32(st, 0xEB1F011F)
            else
                # Binary comparison: if lhs op rhs do
                if_op = st_get(st, 3)
                next_tok(st)
                # parse RHS → slot 488
                st_set(st, 50, 488)
                st_set(st, 74, 488)
                st_set(st, 51, st_get(st, 43))
                st_set(st, 52, st_get(st, 21))
                parse_expr_to(st)
                expect(st, 33)
                emit_ldr_x8_fp(st, 480)
                emit_ldr_x0_fp(st, 488)
                emit_u32(st, 0xEB00011F)
            end
            let cur_if_d = st_get(st, 385)
            write_word(st_get(st, 388), cur_if_d * 8, if_op)
            var if_cond_site = st_get(st, 9)
            emit_u32(st, 0x54000000)
            parse_stmts(st)
            var if_chain_active = 1
            when if_chain_active != 0 loop
                if st_get(st, 3) == 80 do
                    if_emit_end_jump(st)
                    let if_imm = (st_get(st, 9) - if_cond_site) / 4
                    let if_shift = (if_imm bit_and 0x7FFFF) * 32
                    let top_if_op = read_word(st_get(st, 388), cur_if_d * 8)
                    var if_code = 0
                    if top_if_op == 28 do if_code = 1 end
                    if top_if_op == 27 do if_code = 0 end
                    if top_if_op == 24 do if_code = 10 end
                    if top_if_op == 25 do if_code = 11 end
                    if top_if_op == 26 do if_code = 13 end
                    if top_if_op == 23 do if_code = 12 end
                    emit_u32_at(st, if_cond_site, 0x54000000 bit_or (if_code bit_and 15) bit_or if_shift)
                    next_tok(st)
                    st_set(st, 50, 480)
                    st_set(st, 74, 480)
                    st_set(st, 51, st_get(st, 43))
                    st_set(st, 52, st_get(st, 21))
                    parse_expr_to(st)
                    var next_if_op = 27
                    if st_get(st, 3) == 33 do
                        next_if_op = 27
                        expect(st, 33)
                        emit_ldr_x8_fp(st, 480)
                        emit_u32(st, 0xEB1F011F)
                    else
                        next_if_op = st_get(st, 3)
                        next_tok(st)
                        st_set(st, 50, 488)
                        st_set(st, 74, 488)
                        st_set(st, 51, st_get(st, 43))
                        st_set(st, 52, st_get(st, 21))
                        parse_expr_to(st)
                        expect(st, 33)
                        emit_ldr_x8_fp(st, 480)
                        emit_ldr_x0_fp(st, 488)
                        emit_u32(st, 0xEB00011F)
                    end
                    write_word(st_get(st, 388), cur_if_d * 8, next_if_op)
                    if_cond_site = st_get(st, 9)
                    emit_u32(st, 0x54000000)
                    parse_stmts(st)
                else
                    if st_get(st, 3) == 34 do
                        if_emit_end_jump(st)
                        let if_imm = (st_get(st, 9) - if_cond_site) / 4
                        let if_shift = (if_imm bit_and 0x7FFFF) * 32
                        let top_if_op = read_word(st_get(st, 388), cur_if_d * 8)
                        var if_code = 0
                        if top_if_op == 28 do if_code = 1 end
                        if top_if_op == 27 do if_code = 0 end
                        if top_if_op == 24 do if_code = 10 end
                        if top_if_op == 25 do if_code = 11 end
                        if top_if_op == 26 do if_code = 13 end
                        if top_if_op == 23 do if_code = 12 end
                        emit_u32_at(st, if_cond_site, 0x54000000 bit_or (if_code bit_and 15) bit_or if_shift)
                        next_tok(st)
                        parse_stmts(st)
                        if_chain_active = 0
                    else
                        let if_imm = (st_get(st, 9) - if_cond_site) / 4
                        let if_shift = (if_imm bit_and 0x7FFFF) * 32
                        let top_if_op = read_word(st_get(st, 388), cur_if_d * 8)
                        var if_code = 0
                        if top_if_op == 28 do if_code = 1 end
                        if top_if_op == 27 do if_code = 0 end
                        if top_if_op == 24 do if_code = 10 end
                        if top_if_op == 25 do if_code = 11 end
                        if top_if_op == 26 do if_code = 13 end
                        if top_if_op == 23 do if_code = 12 end
                        emit_u32_at(st, if_cond_site, 0x54000000 bit_or (if_code bit_and 15) bit_or if_shift)
                        if_chain_active = 0
                    end
                end
            end
            expect(st, 8)
            let end_off = st_get(st, 9)
            if_pop(st, end_off)
        end
        # ── when cond loop … end ──
        if st_get(st, 77) == 30 do
            next_tok(st)
            loop_push(st, st_get(st, 9))
            # parse LHS of condition → slot 480
            st_set(st, 50, 480)
            st_set(st, 74, 480)
            st_set(st, 51, st_get(st, 43))
            st_set(st, 52, st_get(st, 21))
            parse_expr_to(st)
            var when_op = 27
            if st_get(st, 3) == 31 do
                # Unary bool cond: when cond loop
                when_op = 27
                expect(st, 31)
                emit_ldr_x8_fp(st, 480)
                emit_u32(st, 0xEB1F011F)
            else
                # Binary comparison: when lhs op rhs loop
                when_op = st_get(st, 3)
                next_tok(st)
                # parse RHS → slot 488
                st_set(st, 50, 488)
                st_set(st, 74, 488)
                st_set(st, 51, st_get(st, 43))
                st_set(st, 52, st_get(st, 21))
                parse_expr_to(st)
                expect(st, 31)
                emit_ldr_x8_fp(st, 480)
                emit_ldr_x0_fp(st, 488)
                emit_u32(st, 0xEB00011F)
            end
            let cur_d = st_get(st, 371)
            let cond_site = st_get(st, 9)
            write_word(st_get(st, 372), cur_d * 8, cond_site)
            write_word(st_get(st, 379), cur_d * 8, when_op)
            emit_u32(st, 0x54000000)
            parse_stmts(st)
            expect(st, 8)
            when_finish(st)
        end
        # ── import / type / export / share / lazy / get / include — skip statement ──
        if st_get(st, 77) == 47 do
            st_set(st, 18, 1)
            when st_get(st, 18) != 0 loop
                next_tok(st)
                if st_get(st, 3) == 0 do
                    st_set(st, 18, 0)
                end
                if st_get(st, 3) == 12 do
                    next_tok(st)
                    st_set(st, 18, 0)
                end
            end
        end
        if st_get(st, 77) == 49 do
            st_set(st, 18, 1)
            when st_get(st, 18) != 0 loop
                next_tok(st)
                if st_get(st, 3) == 0 do
                    st_set(st, 18, 0)
                end
                if st_get(st, 3) == 12 do
                    next_tok(st)
                    st_set(st, 18, 0)
                end
            end
        end
        if st_get(st, 77) == 51 do
            st_set(st, 18, 1)
            when st_get(st, 18) != 0 loop
                next_tok(st)
                if st_get(st, 3) == 0 do
                    st_set(st, 18, 0)
                end
                if st_get(st, 3) == 12 do
                    next_tok(st)
                    st_set(st, 18, 0)
                end
            end
        end
        if st_get(st, 77) == 105 do
            st_set(st, 18, 1)
            when st_get(st, 18) != 0 loop
                next_tok(st)
                if st_get(st, 3) == 0 do
                    st_set(st, 18, 0)
                end
                if st_get(st, 3) == 12 do
                    next_tok(st)
                    st_set(st, 18, 0)
                end
            end
        end
        if st_get(st, 77) == 106 do
            st_set(st, 18, 1)
            when st_get(st, 18) != 0 loop
                next_tok(st)
                if st_get(st, 3) == 0 do
                    st_set(st, 18, 0)
                end
                if st_get(st, 3) == 12 do
                    next_tok(st)
                    st_set(st, 18, 0)
                end
            end
        end
        if st_get(st, 77) == 107 do
            st_set(st, 18, 1)
            when st_get(st, 18) != 0 loop
                next_tok(st)
                if st_get(st, 3) == 0 do
                    st_set(st, 18, 0)
                end
                if st_get(st, 3) == 12 do
                    next_tok(st)
                    st_set(st, 18, 0)
                end
            end
        end
        if st_get(st, 77) == 108 do
            st_set(st, 18, 1)
            when st_get(st, 18) != 0 loop
                next_tok(st)
                if st_get(st, 3) == 0 do
                    st_set(st, 18, 0)
                end
                if st_get(st, 3) == 12 do
                    next_tok(st)
                    st_set(st, 18, 0)
                end
            end
        end
        # ── ident = expr; (assignment) or ident.field = expr; or ident[i] = expr; or ident(args...); (call-as-stmt) ──
        if st_get(st, 77) == 1 do
            st_set(st, 53, st_get(st, 5))
            next_tok(st)
            if st_get(st, 3) == 16 do
                # field assignment: ident.field = expr  OR  module call: mod.func(args...);
                next_tok(st)
                if st_get(st, 3) != 1 do
                    print(96)
                    exit_prog(1)
                end
                let sec_name = st_get(st, 5)
                next_tok(st)
                if st_get(st, 3) == 9 do
                    let target_slot = slot_of(st, st_get(st, 53), st_get(st, 43), st_get(st, 21))
                    st_set(st, 67, st_get(st, 67) + 1)
                    nest_peak(st, st_get(st, 67), 222)
                    nest_guard(st, st_get(st, 67), 16)
                    st_set(st, 140 + st_get(st, 67), sec_name)
                    st_set(st, 190 + st_get(st, 67), st_get(st, 48))
                    if target_slot != 0 - 1 do
                        # UFCS method call on local variable: ident.method(args...)
                        emit_ldr_x8_fp(st, target_slot)
                        emit_str_x8_fp(st, 400 + st_get(st, 67) * 64 + 0 * 8)
                        st_set(st, 180 + st_get(st, 67), 1)
                        st_set(st, 71, 1)
                    else
                        st_set(st, 180 + st_get(st, 67), 0)
                        st_set(st, 71, 0)
                    end
                    next_tok(st)
                    if st_get(st, 3) != 10 do
                        st_set(st, 48, 1)
                        when st_get(st, 48) != 0 loop
                            if st_get(st, 3) == 1 do
                                st_set(st, 119, st_get(st, 2))
                                st_set(st, 18, 1)
                                when st_get(st, 18) != 0 loop
                                    if st_get(st, 119) >= st_get(st, 1) do
                                        st_set(st, 18, 0)
                                    else
                                        st_set(st, 58, read_byte(st_get(st, 0), st_get(st, 119)))
                                        if st_get(st, 58) == 32 do
                                            st_set(st, 119, st_get(st, 119) + 1)
                                        else
                                            if st_get(st, 58) == 9 do
                                                st_set(st, 119, st_get(st, 119) + 1)
                                            else
                                                st_set(st, 18, 0)
                                            end
                                        end
                                    end
                                end
                                if st_get(st, 119) < st_get(st, 1) do
                                    if read_byte(st_get(st, 0), st_get(st, 119)) == 58 do
                                        next_tok(st)
                                        next_tok(st)
                                    end
                                end
                            end
                            st_set(st, 72, 400 + st_get(st, 67) * 64 + st_get(st, 71) * 8)
                            st_set(st, 50, st_get(st, 72))
                            st_set(st, 74, st_get(st, 72))
                            st_set(st, 51, st_get(st, 43))
                            st_set(st, 52, st_get(st, 21))
                            parse_expr_to(st)
                            st_set(st, 71, st_get(st, 71) + 1)
                            if st_get(st, 3) == 13 do
                                next_tok(st)
                            else
                                st_set(st, 48, 0)
                            end
                        end
                    end
                    expect(st, 10)
                    emit_load_args(st, st_get(st, 71), 400 + st_get(st, 67) * 64)
                    st_set(st, 56, st_get(st, 140 + st_get(st, 67)))
                    st_set(st, 71, st_get(st, 180 + st_get(st, 67)))
                    st_set(st, 48, st_get(st, 190 + st_get(st, 67)))
                    st_set(st, 67, st_get(st, 67) - 1)
                    st_set(st, 55, find_fn(st, st_get(st, 56)))
                    if st_get(st, 55) < 0 do
                        st_set(st, 55, builtin_kind(st, st_get(st, 56)))
                        if st_get(st, 55) == 0 do
                            print(99)
                            exit_prog(1)
                        else
                            emit_builtin(st)
                        end
                    else
                        emit_bl_later(st, st_get(st, 55))
                    end
                    if st_get(st, 3) == 12 do
                        next_tok(st)
                    end
                else
                    st_set(st, 118, find_field_off(st, sec_name))
                    st_set(st, 119, find_field_size(st, sec_name))
                    if st_get(st, 118) < 0 do
                        print(97)
                        exit_prog(1)
                    end
                    var field_op_tok = 15
                    if st_get(st, 3) == 15 do
                        field_op_tok = 15
                        next_tok(st)
                    else
                        if st_get(st, 3) >= 86 do
                            if st_get(st, 3) <= 89 do
                                field_op_tok = st_get(st, 3)
                                next_tok(st)
                            else
                                expect(st, 15)
                            end
                        else
                            expect(st, 15)
                        end
                    end
                    st_set(st, 75, slot_of(st, st_get(st, 53), st_get(st, 43), st_get(st, 21)))
                    if st_get(st, 75) == 0 - 1 do
                        print(97)
                        exit_prog(1)
                    end
                    st_set(st, 114, st_get(st, 75))
                    st_set(st, 115, st_get(st, 118))
                    st_set(st, 127, st_get(st, 119))
                    st_set(st, 50, 488)
                    st_set(st, 74, 488)
                    st_set(st, 51, st_get(st, 43))
                    st_set(st, 52, st_get(st, 21))
                    parse_expr_to(st)
                    if field_op_tok == 15 do
                        emit_ldr_x8_fp(st, st_get(st, 114))
                        emit_ldr_x0_fp(st, 488)
                        emit_field_store(st, st_get(st, 115), st_get(st, 127))
                    else
                        # compound field assignment: user.age += 1
                        emit_ldr_x8_fp(st, st_get(st, 114))
                        emit_field_load(st, st_get(st, 115), st_get(st, 127))
                        emit_ldr_x0_fp(st, 488)
                        if field_op_tok == 86 do emit_u32(st, 0x8B000108) end
                        if field_op_tok == 87 do emit_u32(st, 0xCB000108) end
                        if field_op_tok == 88 do emit_u32(st, 0x9B007D08) end
                        if field_op_tok == 89 do emit_u32(st, 0x9AC00D08) end
                        emit_str_x8_fp(st, 488)
                        emit_ldr_x8_fp(st, st_get(st, 114))
                        emit_ldr_x0_fp(st, 488)
                        emit_field_store(st, st_get(st, 115), st_get(st, 127))
                    end
                    if st_get(st, 3) == 12 do
                        next_tok(st)
                    end
                end
            end
            if st_get(st, 3) == 110 do
                # Array element assignment: ident[index] = expr; or ident[index] += expr;
                next_tok(st)
                st_set(st, 75, slot_of(st, st_get(st, 53), st_get(st, 43), st_get(st, 21)))
                if st_get(st, 75) == 0 - 1 do
                    print(97)
                    exit_prog(1)
                end
                st_set(st, 114, st_get(st, 75))
                st_set(st, 50, 496)
                st_set(st, 74, 496)
                parse_expr_to(st)
                expect(st, 111)
                var arr_assign_op = 15
                if st_get(st, 3) == 15 do
                    arr_assign_op = 15
                    next_tok(st)
                else
                    if st_get(st, 3) >= 86 do
                        if st_get(st, 3) <= 89 do
                            arr_assign_op = st_get(st, 3)
                            next_tok(st)
                        else
                            expect(st, 15)
                        end
                    else
                        expect(st, 15)
                    end
                end
                st_set(st, 50, 488)
                st_set(st, 74, 488)
                parse_expr_to(st)
                if arr_assign_op == 15 do
                    emit_ldr_x8_fp(st, st_get(st, 114))
                    emit_ldr_xN_fp(st, 9, 496)
                    emit_ldr_x0_fp(st, 488)
                    emit_u32(st, 0xF8297900)
                else
                    # compound assign arr[i] += val
                    emit_ldr_x8_fp(st, st_get(st, 114))
                    emit_ldr_x0_fp(st, 496)
                    emit_u32(st, 0xF8607908)
                    emit_ldr_x0_fp(st, 488)
                    if arr_assign_op == 86 do emit_u32(st, 0x8B000108) end
                    if arr_assign_op == 87 do emit_u32(st, 0xCB000108) end
                    if arr_assign_op == 88 do emit_u32(st, 0x9B007D08) end
                    if arr_assign_op == 89 do emit_u32(st, 0x9AC00D08) end
                    emit_str_x8_fp(st, 488)
                    emit_ldr_x8_fp(st, st_get(st, 114))
                    emit_ldr_xN_fp(st, 9, 496)
                    emit_ldr_x0_fp(st, 488)
                    emit_u32(st, 0xF8297900)
                end
                if st_get(st, 3) == 12 do
                    next_tok(st)
                end
            end
            if st_get(st, 3) == 15 do
                # assignment: ident = expr
                bc_check_write(st, st_get(st, 53))
                let target_li = find_local_idx(st, st_get(st, 53))
                if target_li >= 0 do
                    let target_type = read_word(st_get(st, 366), target_li * 8)
                    if is_type_move(st, target_type) != 0 do
                        let target_scope = read_word(st_get(st, 363), target_li * 8)
                        if st_get(st, 3) == 1 do
                            bc_check_escape(st, st_get(st, 5), target_scope)
                        end
                    end
                end
                next_tok(st)
                st_set(st, 75, slot_of(st, st_get(st, 53), st_get(st, 43), st_get(st, 21)))
                if st_get(st, 75) == 0 - 1 do
                    print(97)
                    exit_prog(1)
                end
                st_set(st, 50, st_get(st, 75))
                st_set(st, 74, st_get(st, 75))
                st_set(st, 51, st_get(st, 43))
                st_set(st, 52, st_get(st, 21))
                parse_expr_to(st)
                if st_get(st, 3) == 12 do
                    next_tok(st)
                end
            end
            if st_get(st, 3) >= 86 do
                if st_get(st, 3) <= 89 do
                    st_set(st, 115, st_get(st, 3))
                    bc_check_write(st, st_get(st, 53))
                    st_set(st, 114, slot_of(st, st_get(st, 53), st_get(st, 43), st_get(st, 21)))
                    if st_get(st, 114) == 0 - 1 do
                        print(97)
                        exit_prog(1)
                    end
                    next_tok(st)
                    st_set(st, 50, 488)
                    st_set(st, 74, 488)
                    st_set(st, 51, st_get(st, 43))
                    st_set(st, 52, st_get(st, 21))
                    parse_expr_to(st)
                    emit_ldr_x8_fp(st, st_get(st, 114))
                    emit_ldr_x0_fp(st, 488)
                    if st_get(st, 115) == 86 do
                        emit_u32(st, 0x8B000108)
                    end
                    if st_get(st, 115) == 87 do
                        emit_u32(st, 0xCB000108)
                    end
                    if st_get(st, 115) == 88 do
                        emit_u32(st, 0x9B007D08)
                    end
                    if st_get(st, 115) == 89 do
                        emit_u32(st, 0x9AC00D08)
                    end
                    emit_str_x8_fp(st, st_get(st, 114))
                    if st_get(st, 3) == 12 do
                        next_tok(st)
                    end
                end
            end
            if st_get(st, 3) == 9 do
                # call-as-statement: ident(args...)
                st_set(st, 67, st_get(st, 67) + 1)
                nest_peak(st, st_get(st, 67), 222)
                nest_guard(st, st_get(st, 67), 16)
                st_set(st, 140 + st_get(st, 67), st_get(st, 53))
                st_set(st, 180 + st_get(st, 67), st_get(st, 71))
                st_set(st, 190 + st_get(st, 67), st_get(st, 48))
                next_tok(st)
                st_set(st, 71, 0)
                if st_get(st, 3) != 10 do
                    st_set(st, 48, 1)
                    when st_get(st, 48) != 0 loop
                        if st_get(st, 3) == 1 do
                            st_set(st, 119, st_get(st, 2))
                            st_set(st, 18, 1)
                            when st_get(st, 18) != 0 loop
                                if st_get(st, 119) >= st_get(st, 1) do
                                    st_set(st, 18, 0)
                                else
                                    st_set(st, 58, read_byte(st_get(st, 0), st_get(st, 119)))
                                    if st_get(st, 58) == 32 do
                                        st_set(st, 119, st_get(st, 119) + 1)
                                    else
                                        if st_get(st, 58) == 9 do
                                            st_set(st, 119, st_get(st, 119) + 1)
                                        else
                                            st_set(st, 18, 0)
                                        end
                                    end
                                end
                            end
                            if st_get(st, 119) < st_get(st, 1) do
                                if read_byte(st_get(st, 0), st_get(st, 119)) == 58 do
                                    next_tok(st)
                                    next_tok(st)
                                end
                            end
                        end
                        st_set(st, 72, 400 + st_get(st, 67) * 64 + st_get(st, 71) * 8)
                        st_set(st, 50, st_get(st, 72))
                        st_set(st, 74, st_get(st, 72))
                        parse_expr_to(st)
                        st_set(st, 71, st_get(st, 71) + 1)
                        if st_get(st, 3) == 13 do
                            next_tok(st)
                        else
                            st_set(st, 48, 0)
                        end
                    end
                end
                expect(st, 10)
                emit_load_args(st, st_get(st, 71), 400 + st_get(st, 67) * 64)
                st_set(st, 56, st_get(st, 140 + st_get(st, 67)))
                st_set(st, 71, st_get(st, 180 + st_get(st, 67)))
                st_set(st, 48, st_get(st, 190 + st_get(st, 67)))
                st_set(st, 67, st_get(st, 67) - 1)
                st_set(st, 55, find_fn(st, st_get(st, 56)))
                if st_get(st, 55) < 0 do
                    st_set(st, 55, builtin_kind(st, st_get(st, 56)))
                    if st_get(st, 55) == 0 do
                        print(read_byte(st_get(st, 56), 0))
                        print(read_byte(st_get(st, 56), 1))
                        print(read_byte(st_get(st, 56), 2))
                        print(read_byte(st_get(st, 56), 3))
                        print(read_byte(st_get(st, 56), 4))
                        print(99)
                        exit_prog(1)
                    else
                        emit_builtin(st)
                    end
                else
                    emit_bl_later(st, st_get(st, 55))
                end
                if st_get(st, 3) == 12 do
                    next_tok(st)
                end
            end
        end
        # Unknown statement token: bail instead of spinning on an unchanged cursor.
        if st_get(st, 24) != 0 do
            if st_get(st, 2) == st_get(st, 47) do
                print(94)
                print(st_get(st, 2))
                print(st_get(st, 3))
                exit_prog(1)
            end
        end
        bc_stmt_end(st)
    end
    st_set(st, 89, st_get(st, 89) - 1)
    if st_get(st, 89) > 0 do
        st_set(st, 24, 1)
    end
end.

# Skip whitespace at st[2] (does not change the current token kind).
func skip_spaces(st):
    st_set(st, 18, 1)
    when st_get(st, 18) != 0 loop
        st_set(st, 57, st_get(st, 2))
        if st_get(st, 57) >= st_get(st, 1) do
            st_set(st, 18, 0)
        else
            st_set(st, 58, read_byte(st_get(st, 0), st_get(st, 57)))
            st_set(st, 46, 0)
            if st_get(st, 58) == 32 do
                st_set(st, 46, 1)
            end
            if st_get(st, 58) == 9 do
                st_set(st, 46, 1)
            end
            if st_get(st, 58) == 10 do
                st_set(st, 46, 1)
            end
            if st_get(st, 58) == 13 do
                st_set(st, 46, 1)
            end
            if st_get(st, 46) == 0 do
                st_set(st, 18, 0)
            else
                st_set(st, 2, st_get(st, 57) + 1)
            end
        end
    end
end.

# §14.2 block-`in`: current token is a body stmt, not another param name.
# Stop on keywords, or IDENT followed by `(`, `=`, `.`, `[`.
# Scratch st[224]/st[225] — must NOT touch 100..120 (label/expr stacks) or 140+.
func in_params_done(st):
    if st_get(st, 3) != 1 do
        out 1
    end
    st_set(st, 224, st_get(st, 2))
    st_set(st, 18, 1)
    when st_get(st, 18) != 0 loop
        if st_get(st, 224) >= st_get(st, 1) do
            st_set(st, 225, 0)
            st_set(st, 18, 0)
        else
            st_set(st, 225, read_byte(st_get(st, 0), st_get(st, 224)))
            st_set(st, 46, 0)
            if st_get(st, 225) == 32 do
                st_set(st, 46, 1)
            end
            if st_get(st, 225) == 9 do
                st_set(st, 46, 1)
            end
            if st_get(st, 225) == 10 do
                st_set(st, 46, 1)
            end
            if st_get(st, 225) == 13 do
                st_set(st, 46, 1)
            end
            if st_get(st, 46) == 0 do
                st_set(st, 18, 0)
            else
                st_set(st, 224, st_get(st, 224) + 1)
            end
        end
    end
    if st_get(st, 225) == 40 do
        out 1
    end
    if st_get(st, 225) == 61 do
        out 1
    end
    if st_get(st, 225) == 46 do
        out 1
    end
    if st_get(st, 225) == 91 do
        out 1
    end
    out 0
end.

# Register current IDENT as a local/param. Advances past optional `: type`.
func bind_param(st):
    if st_get(st, 3) != 1 do
        print(96)
        exit_prog(1)
    end
    st_set(st, 78, st_get(st, 21))
    write_word(st_get(st, 43), st_get(st, 78) * 8, st_get(st, 5))
    hash_put_at(st, 97, 98, st_get(st, 5), ra_alloc_local(st, st_get(st, 78)))
    st_set(st, 21, st_get(st, 78) + 1)
    st_set(st, 90, st_get(st, 90) + 1)
    next_tok(st)
    st_set(st, 342, 9)
    if st_get(st, 3) == 11 do
        next_tok(st)
        st_set(st, 342, parse_type_spec(st))
        next_tok(st)
    end
    bc_register_local(st, st_get(st, 78), 1, st_get(st, 342))
end.

# Params inside `( ... )`. Current token is first param or `)`.
# Separators: `,` | `;` | NEWLINE (next_tok already skips newlines).
# Leaves current token as `)`.
func parse_params_rparen(st):
    st_set(st, 48, 1)
    when st_get(st, 48) != 0 loop
        if st_get(st, 3) == 10 do
            st_set(st, 48, 0)
        else
            bind_param(st)
            if st_get(st, 3) == 13 do
                next_tok(st)
            else
                if st_get(st, 3) == 12 do
                    next_tok(st)
                else
                    if st_get(st, 3) != 10 do
                        if st_get(st, 3) != 1 do
                            st_set(st, 48, 0)
                        end
                    end
                end
            end
        end
    end
end.

func parse_func(st):
    expect(st, 3)
    if st_get(st, 3) != 1 do
        print(96)
        exit_prog(1)
    end
    st_set(st, 41, st_get(st, 5))
    st_set(st, 21, 0)
    st_set(st, 90, 0)
    st_set(st, 111, 0)
    st_set(st, 371, 0)
    st_set(st, 378, 0)
    hash_clear_at(st, 97)
    bc_init_func(st)

    # ── Form A: `func name(params):` ──
    skip_spaces(st)
    if ch(st, st_get(st, 2)) == 40 do
        st_set(st, 2, st_get(st, 2) + 1)
        st_set(st, 3, 9)
        next_tok(st)
        parse_params_rparen(st)
        expect(st, 10)
        # expect(10) already advanced onto `:`.
        expect(st, 11)
    else
        # ── Form B: `func name:` then optional `in` / `in(...)` ──
        skip_spaces(st)
        if ch(st, st_get(st, 2)) == 58 do
            st_set(st, 2, st_get(st, 2) + 1)
            st_set(st, 3, 11)
        else
            next_tok(st)
        end
        expect(st, 11)
        if st_get(st, 3) == 4 do
            skip_spaces(st)
            if ch(st, st_get(st, 2)) == 40 do
                # `in(params)` — current tok is `in`; consume `(` then params.
                st_set(st, 2, st_get(st, 2) + 1)
                st_set(st, 3, 9)
                next_tok(st)
                parse_params_rparen(st)
                expect(st, 10)
            else
                # block `in` / name / name — stop before body stmt
                next_tok(st)
                st_set(st, 48, 1)
                when st_get(st, 48) != 0 loop
                    if in_params_done(st) != 0 do
                        st_set(st, 48, 0)
                    else
                        bind_param(st)
                        if st_get(st, 3) == 13 do
                            next_tok(st)
                        else
                            if st_get(st, 3) == 12 do
                                next_tok(st)
                            end
                        end
                    end
                end
            end
        end
    end

    # ── register function (fill forward declare or append) ──
    st_set(st, 44, st_get(st, 9))
    st_set(st, 55, find_fn(st, st_get(st, 41)))
    if st_get(st, 55) >= 0 do
        write_word(st_get(st, 11), st_get(st, 55) * 8, st_get(st, 44))
    else
        write_word(st_get(st, 11), st_get(st, 13) * 8, st_get(st, 44))
        write_word(st_get(st, 12), st_get(st, 13) * 8, st_get(st, 41))
        hash_put_at(st, 95, 96, st_get(st, 41), st_get(st, 13))
        st_set(st, 13, st_get(st, 13) + 1)
    end
    if ident_is_str(st_get(st, 41), "main") != 0 do
        st_set(st, 14, st_get(st, 44))
    end

    # ── prologue: 16KB frame + callee-save x19-x22 ──
    emit_prologue(st)
    # save params into RA slots (phys x19+ or fp)
    st_set(st, 22, 0)
    when st_get(st, 22) < st_get(st, 90) loop
        let pi = st_get(st, 22)
        if pi < 8 do
            st_set(st, 114, read_word(st_get(st, 43), pi * 8))
            st_set(st, 115, slot_of(st, st_get(st, 114), st_get(st, 43), st_get(st, 21)))
            if st_get(st, 115) < 0 do
                emit_mov_rr(st, (0 - st_get(st, 115)) - 1, pi)
            else
                # mov x8, xPi — stage through st[] (fat 0xAA0003E8|… mis-lowers)
                st_set(st, 200, (170 shl 24) bit_or 1000)
                st_set(st, 201, (pi bit_and 31) shl 16)
                emit_u32(st, st_get(st, 200) bit_or st_get(st, 201))
                emit_str_x8_fp(st, st_get(st, 115))
            end
        end
        st_set(st, 22, pi + 1)
    end

    # ── parse body statements ──
    parse_stmts(st)

    # ── parse optional revert block (§13.3) ──
    if st_get(st, 3) == 103 do
        next_tok(st)
        if st_get(st, 3) == 11 do
            next_tok(st)
        end
        parse_stmts(st)
    end

    # ── parse optional ensure block (§13.2) ──
    if st_get(st, 3) == 102 do
        next_tok(st)
        if st_get(st, 3) == 11 do
            next_tok(st)
        end
        parse_stmts(st)
    end

    # ── expect `end.` ──
    expect(st, 8)
    if st_get(st, 3) == 16 do
        next_tok(st)
    end
    # ── fallthrough epilogue (x0 = 0) ──
    emit_u32(st, 0xD2800000)
    emit_epilogue(st)
end.

func patch_calls(st):
    st_set(st, 20, 0)
    when st_get(st, 20) < st_get(st, 17) loop
        st_set(st, 62, read_word(st_get(st, 15), st_get(st, 20) * 8))
        st_set(st, 63, read_word(st_get(st, 16), st_get(st, 20) * 8))
        st_set(st, 64, read_word(st_get(st, 11), st_get(st, 63) * 8))
        emit_u32_at(st, st_get(st, 62), 0x94000000 bit_or ((((st_get(st, 64) - st_get(st, 62)) / 4)) bit_and 0x03FFFFFF))
        st_set(st, 20, st_get(st, 20) + 1)
    end
end.

func emit_entry(st):
    let ent = st_get(st, 9)
    # SUB SP,#48; STP X0,X1,[SP]; MOV X27,SP; STP XZR,XZR,[X27,#16]
    emit_u32(st, 0xD100C3FF)
    emit_u32(st, 0xA90007E0)
    emit_u32(st, 0x910003FB)
    emit_u32(st, 0xA9017F7F)
    emit_u32(st, 0xA9BF7BFD)
    emit_u32(st, 0x910003FD)
    emit_bl(st, st_get(st, 14))
    emit_u32(st, 0xD2800000)
    emit_u32(st, 0xD2800030)
    emit_u32(st, 0xF2A04010)
    emit_u32(st, 0xD4001001)
    out ent
end.

func u32_le:
    in
        buf
        off
        w
    write_byte(buf, off, w bit_and 255)
    write_byte(buf, off + 1, (w shr 8) bit_and 255)
    write_byte(buf, off + 2, (w shr 16) bit_and 255)
    write_byte(buf, off + 3, (w shr 24) bit_and 255)
end.

func u64_le:
    in
        buf
        off
        lo
        hi
    u32_le(buf, off, lo)
    u32_le(buf, off + 4, hi)
end.

func write_macho:
    in
        st
        path
        entry_off
    # 10 load commands (552 bytes) + 32 bytes pad => code at 616, matching the
    # layout codesign accepts: __PAGEZERO / __TEXT+__text / __LINKEDIT /
    # CHAINED_FIXUPS / SYMTAB / DYSYMTAB / LOAD_DYLINKER / UUID / MAIN / DYLIB.
    # text_seg = page-round(code_off + code_size); hard 16KB truncated self-host.
    let code_off = 616
    let code_size = st_get(st, 9)
    st_set(st, 227, code_off + code_size + 16383)
    st_set(st, 227, (st_get(st, 227) / 16384) * 16384)
    let text_seg = st_get(st, 227)
    let link_sz = 52
    let file_size = text_seg + link_sz
    let buf = alloc(file_size)
    st_set(st, 20, 0)
    when st_get(st, 20) < file_size loop
        write_byte(buf, st_get(st, 20), 0)
        st_set(st, 20, st_get(st, 20) + 1)
    end

    # ── header ──
    u32_le(buf, 0, 0xFEEDFACF)
    u32_le(buf, 4, 0x0100000C)
    u32_le(buf, 8, 0)
    u32_le(buf, 12, 2)
    u32_le(buf, 16, 10)
    u32_le(buf, 20, 552)
    u32_le(buf, 24, 0x00200085)
    u32_le(buf, 28, 0)

    # ── 1. __PAGEZERO (72) ──
    u32_le(buf, 32, 0x19)
    u32_le(buf, 36, 72)
    write_byte(buf, 40, 95)
    write_byte(buf, 41, 95)
    write_byte(buf, 42, 80)
    write_byte(buf, 43, 65)
    write_byte(buf, 44, 71)
    write_byte(buf, 45, 69)
    write_byte(buf, 46, 90)
    write_byte(buf, 47, 69)
    write_byte(buf, 48, 82)
    write_byte(buf, 49, 79)
    u64_le(buf, 56, 0, 0)
    u64_le(buf, 64, 0, 1)
    u64_le(buf, 72, 0, 0)
    u64_le(buf, 80, 0, 0)
    u32_le(buf, 88, 0)
    u32_le(buf, 92, 0)
    u32_le(buf, 96, 0)
    u32_le(buf, 100, 0)

    # ── 2. __TEXT (72) + __text section (80) ──
    u32_le(buf, 104, 0x19)
    u32_le(buf, 108, 152)
    write_byte(buf, 112, 95)
    write_byte(buf, 113, 95)
    write_byte(buf, 114, 84)
    write_byte(buf, 115, 69)
    write_byte(buf, 116, 88)
    write_byte(buf, 117, 84)
    u64_le(buf, 128, 0, 1)
    u64_le(buf, 136, text_seg, 0)
    u64_le(buf, 144, 0, 0)
    u64_le(buf, 152, text_seg, 0)
    u32_le(buf, 160, 7)
    u32_le(buf, 164, 5)
    u32_le(buf, 168, 1)
    u32_le(buf, 172, 0)
    write_byte(buf, 176, 95)
    write_byte(buf, 177, 95)
    write_byte(buf, 178, 116)
    write_byte(buf, 179, 101)
    write_byte(buf, 180, 120)
    write_byte(buf, 181, 116)
    write_byte(buf, 192, 95)
    write_byte(buf, 193, 95)
    write_byte(buf, 194, 84)
    write_byte(buf, 195, 69)
    write_byte(buf, 196, 88)
    write_byte(buf, 197, 84)
    u64_le(buf, 208, code_off, 1)
    u64_le(buf, 216, code_size, 0)
    u32_le(buf, 224, code_off)
    u32_le(buf, 228, 2)
    u32_le(buf, 232, 0)
    u32_le(buf, 236, 0)
    u32_le(buf, 240, 0x80000400)
    u32_le(buf, 244, 0)
    u32_le(buf, 248, 0)
    u32_le(buf, 252, 0)

    # ── 3. __LINKEDIT (72) ──
    u32_le(buf, 256, 0x19)
    u32_le(buf, 260, 72)
    write_byte(buf, 264, 95)
    write_byte(buf, 265, 95)
    write_byte(buf, 266, 76)
    write_byte(buf, 267, 73)
    write_byte(buf, 268, 78)
    write_byte(buf, 269, 75)
    write_byte(buf, 270, 69)
    write_byte(buf, 271, 68)
    write_byte(buf, 272, 73)
    write_byte(buf, 273, 84)
    u64_le(buf, 280, text_seg, 1)
    u64_le(buf, 288, text_seg, 0)
    u64_le(buf, 296, text_seg, 0)
    u64_le(buf, 304, link_sz, 0)
    u32_le(buf, 312, 1)
    u32_le(buf, 316, 1)
    u32_le(buf, 320, 0)
    u32_le(buf, 324, 0)

    # ── 4. LC_DYLD_CHAINED_FIXUPS (16) ──
    u32_le(buf, 328, 0x80000034)
    u32_le(buf, 332, 16)
    u32_le(buf, 336, text_seg)
    u32_le(buf, 340, 48)

    # ── 5. LC_SYMTAB (24) ──
    u32_le(buf, 344, 2)
    u32_le(buf, 348, 24)
    u32_le(buf, 352, text_seg + 48)
    u32_le(buf, 356, 0)
    u32_le(buf, 360, text_seg + 48)
    u32_le(buf, 364, 4)

    # ── 6. LC_DYSYMTAB (80, zeros after cmd/cmdsize) ──
    u32_le(buf, 368, 0x0B)
    u32_le(buf, 372, 80)

    # ── 7. LC_LOAD_DYLINKER (32): "/usr/lib/dyld" at offset 12 ──
    u32_le(buf, 448, 0x0E)
    u32_le(buf, 452, 32)
    u32_le(buf, 456, 12)
    write_byte(buf, 460, 47)
    write_byte(buf, 461, 117)
    write_byte(buf, 462, 115)
    write_byte(buf, 463, 114)
    write_byte(buf, 464, 47)
    write_byte(buf, 465, 108)
    write_byte(buf, 466, 105)
    write_byte(buf, 467, 98)
    write_byte(buf, 468, 47)
    write_byte(buf, 469, 100)
    write_byte(buf, 470, 121)
    write_byte(buf, 471, 108)
    write_byte(buf, 472, 100)

    # ── 8. LC_UUID (24) ──
    u32_le(buf, 480, 0x1B)
    u32_le(buf, 484, 24)
    st_set(st, 20, 0)
    when st_get(st, 20) < 16 loop
        write_byte(buf, 488 + st_get(st, 20), st_get(st, 20) + 1)
        st_set(st, 20, st_get(st, 20) + 1)
    end

    # ── 9. LC_MAIN (24) ──
    u32_le(buf, 504, 0x80000028)
    u32_le(buf, 508, 24)
    u64_le(buf, 512, code_off + entry_off, 0)
    u64_le(buf, 520, 0, 0)

    # ── 10. LC_LOAD_DYLIB (56): "/usr/lib/libSystem.B.dylib" at offset 24 ──
    u32_le(buf, 528, 0x0C)
    u32_le(buf, 532, 56)
    u32_le(buf, 536, 24)
    u32_le(buf, 540, 0)
    u32_le(buf, 544, 0x00010000)
    u32_le(buf, 548, 0x00010000)
    write_byte(buf, 552, 47)
    write_byte(buf, 553, 117)
    write_byte(buf, 554, 115)
    write_byte(buf, 555, 114)
    write_byte(buf, 556, 47)
    write_byte(buf, 557, 108)
    write_byte(buf, 558, 105)
    write_byte(buf, 559, 98)
    write_byte(buf, 560, 47)
    write_byte(buf, 561, 108)
    write_byte(buf, 562, 105)
    write_byte(buf, 563, 98)
    write_byte(buf, 564, 83)
    write_byte(buf, 565, 121)
    write_byte(buf, 566, 115)
    write_byte(buf, 567, 116)
    write_byte(buf, 568, 101)
    write_byte(buf, 569, 109)
    write_byte(buf, 570, 46)
    write_byte(buf, 571, 66)
    write_byte(buf, 572, 46)
    write_byte(buf, 573, 100)
    write_byte(buf, 574, 121)
    write_byte(buf, 575, 108)
    write_byte(buf, 576, 105)
    write_byte(buf, 577, 98)

    # ── machine code ──
    st_set(st, 20, 0)
    st_set(st, 65, st_get(st, 8))
    when st_get(st, 20) < code_size loop
        write_byte(buf, code_off + st_get(st, 20), read_byte(st_get(st, 65), st_get(st, 20)))
        st_set(st, 20, st_get(st, 20) + 1)
    end

    # ── __LINKEDIT payload: dyld_chained_fixups header + empty string table ──
    u32_le(buf, text_seg + 0, 0)
    u32_le(buf, text_seg + 4, 28)
    u32_le(buf, text_seg + 8, 44)
    u32_le(buf, text_seg + 12, 44)
    u32_le(buf, text_seg + 16, 0)
    u32_le(buf, text_seg + 20, 1)
    u32_le(buf, text_seg + 24, 0)
    u32_le(buf, text_seg + 28, 3)

    write_bytes(path, buf, file_size)
end.

# ── include "rel/path.vri" expander (line-leading; `;` optional when newline) ──

func cstr_len(st, p):
    st_set(st, 260, 0)
    st_set(st, 287, 1)
    when st_get(st, 287) != 0 loop
        if read_byte(p, st_get(st, 260)) == 0 do
            st_set(st, 287, 0)
        else
            st_set(st, 260, st_get(st, 260) + 1)
        end
    end
    out st_get(st, 260)
end.

func inc_append_byte(st, b):
    if st_get(st, 241) >= st_get(st, 242) do
        print(91)
        exit_prog(1)
    end
    write_byte(st_get(st, 240), st_get(st, 241), b)
    st_set(st, 241, st_get(st, 241) + 1)
end.

func inc_copy_cstr(st, p):
    st_set(st, 264, cstr_len(st, p))
    st_set(st, 265, bump_alloc(st, st_get(st, 264) + 1))
    if st_get(st, 265) == 0 do
        print(91)
        exit_prog(1)
    end
    st_set(st, 260, 0)
    when st_get(st, 260) < st_get(st, 264) loop
        write_byte(st_get(st, 265), st_get(st, 260), read_byte(p, st_get(st, 260)))
        st_set(st, 260, st_get(st, 260) + 1)
    end
    write_byte(st_get(st, 265), st_get(st, 264), 0)
    out st_get(st, 265)
end.

func inc_seen(st, path):
    st_set(st, 281, 0)
    st_set(st, 282, 0)
    when st_get(st, 281) < st_get(st, 249) loop
        if cstr_eq(st, read_word(st_get(st, 248), st_get(st, 281) * 8), path) != 0 do
            st_set(st, 282, 1)
        end
        st_set(st, 281, st_get(st, 281) + 1)
    end
    out st_get(st, 282)
end.

func inc_mark(st, path):
    if st_get(st, 249) >= 16 do
        print(93)
        exit_prog(1)
    end
    write_word(st_get(st, 248), st_get(st, 249) * 8, path)
    st_set(st, 249, st_get(st, 249) + 1)
end.

func inc_dirname(st, path):
    st_set(st, 264, cstr_len(st, path))
    st_set(st, 266, 0 - 1)
    st_set(st, 260, 0)
    when st_get(st, 260) < st_get(st, 264) loop
        if read_byte(path, st_get(st, 260)) == 47 do
            st_set(st, 266, st_get(st, 260))
        end
        st_set(st, 260, st_get(st, 260) + 1)
    end
    if st_get(st, 266) < 0 do
        st_set(st, 265, bump_alloc(st, 2))
        write_byte(st_get(st, 265), 0, 46)
        write_byte(st_get(st, 265), 1, 0)
        st_set(st, 253, st_get(st, 265))
        st_set(st, 254, 1)
        out
    end
    st_set(st, 265, bump_alloc(st, st_get(st, 266) + 1))
    st_set(st, 260, 0)
    when st_get(st, 260) < st_get(st, 266) loop
        write_byte(st_get(st, 265), st_get(st, 260), read_byte(path, st_get(st, 260)))
        st_set(st, 260, st_get(st, 260) + 1)
    end
    write_byte(st_get(st, 265), st_get(st, 266), 0)
    st_set(st, 253, st_get(st, 265))
    st_set(st, 254, st_get(st, 266))
end.

func inc_resolve(st, rel):
    if read_byte(rel, 0) == 47 do
        out inc_copy_cstr(st, rel)
    end
    if st_get(st, 254) == 1 do
        if read_byte(st_get(st, 253), 0) == 46 do
            out inc_copy_cstr(st, rel)
        end
    end
    st_set(st, 264, cstr_len(st, rel))
    st_set(st, 265, bump_alloc(st, st_get(st, 254) + 1 + st_get(st, 264) + 1))
    st_set(st, 260, 0)
    when st_get(st, 260) < st_get(st, 254) loop
        write_byte(st_get(st, 265), st_get(st, 260), read_byte(st_get(st, 253), st_get(st, 260)))
        st_set(st, 260, st_get(st, 260) + 1)
    end
    write_byte(st_get(st, 265), st_get(st, 254), 47)
    st_set(st, 260, 0)
    when st_get(st, 260) < st_get(st, 264) loop
        write_byte(st_get(st, 265), st_get(st, 254) + 1 + st_get(st, 260), read_byte(rel, st_get(st, 260)))
        st_set(st, 260, st_get(st, 260) + 1)
    end
    write_byte(st_get(st, 265), st_get(st, 254) + 1 + st_get(st, 264), 0)
    out st_get(st, 265)
end.

func inc_push_scan(st):
    st_set(st, 270, st_get(st, 269) * 40)
    write_word(st_get(st, 268), st_get(st, 270) + 0, st_get(st, 250))
    write_word(st_get(st, 268), st_get(st, 270) + 8, st_get(st, 251))
    write_word(st_get(st, 268), st_get(st, 270) + 16, st_get(st, 252))
    write_word(st_get(st, 268), st_get(st, 270) + 24, st_get(st, 253))
    write_word(st_get(st, 268), st_get(st, 270) + 32, st_get(st, 254))
    st_set(st, 269, st_get(st, 269) + 1)
end.

func inc_pop_scan(st):
    st_set(st, 269, st_get(st, 269) - 1)
    st_set(st, 270, st_get(st, 269) * 40)
    st_set(st, 250, read_word(st_get(st, 268), st_get(st, 270) + 0))
    st_set(st, 251, read_word(st_get(st, 268), st_get(st, 270) + 8))
    st_set(st, 252, read_word(st_get(st, 268), st_get(st, 270) + 16))
    st_set(st, 253, read_word(st_get(st, 268), st_get(st, 270) + 24))
    st_set(st, 254, read_word(st_get(st, 268), st_get(st, 270) + 32))
end.

func expand_file(st, path):
    if st_get(st, 247) >= 8 do
        print(93)
        exit_prog(1)
    end
    st_set(st, 271, inc_copy_cstr(st, path))
    # Include-once: skip if already expanded (also blocks A↔B cycles).
    if inc_seen(st, st_get(st, 271)) != 0 do
        out
    end
    inc_mark(st, st_get(st, 271))
    st_set(st, 247, st_get(st, 247) + 1)
    st_set(st, 272, slurp_file(st_get(st, 271)))
    st_set(st, 273, slurp_len())
    if st_get(st, 273) < 0 do
        print(94)
        exit_prog(1)
    end
    st_set(st, 274, bump_alloc(st, st_get(st, 273) + 1))
    if st_get(st, 274) == 0 do
        print(91)
        exit_prog(1)
    end
    st_set(st, 260, 0)
    when st_get(st, 260) < st_get(st, 273) loop
        write_byte(st_get(st, 274), st_get(st, 260), read_byte(st_get(st, 272), st_get(st, 260)))
        st_set(st, 260, st_get(st, 260) + 1)
    end
    write_byte(st_get(st, 274), st_get(st, 273), 0)
    inc_dirname(st, st_get(st, 271))
    st_set(st, 250, st_get(st, 274))
    st_set(st, 251, st_get(st, 273))
    st_set(st, 252, 0)
    st_set(st, 266, 1)
    st_set(st, 283, 1)
    when st_get(st, 283) != 0 loop
        if st_get(st, 252) >= st_get(st, 251) do
            st_set(st, 283, 0)
        else
            st_set(st, 275, 0)
            if st_get(st, 266) != 0 do
                # Save pos before skipping spaces — restore if not an include.
                st_set(st, 288, st_get(st, 252))
                st_set(st, 276, 1)
                when st_get(st, 276) != 0 loop
                    if st_get(st, 252) >= st_get(st, 251) do
                        st_set(st, 276, 0)
                    else
                        st_set(st, 261, read_byte(st_get(st, 250), st_get(st, 252)))
                        st_set(st, 262, 0)
                        if st_get(st, 261) == 32 do
                            st_set(st, 262, 1)
                        end
                        if st_get(st, 261) == 9 do
                            st_set(st, 262, 1)
                        end
                        if st_get(st, 262) == 0 do
                            st_set(st, 276, 0)
                        else
                            st_set(st, 252, st_get(st, 252) + 1)
                        end
                    end
                end
                st_set(st, 289, 0)
                if st_get(st, 252) + 7 < st_get(st, 251) do
                    if read_byte(st_get(st, 250), st_get(st, 252) + 0) == 105 do
                        if read_byte(st_get(st, 250), st_get(st, 252) + 1) == 110 do
                            if read_byte(st_get(st, 250), st_get(st, 252) + 2) == 99 do
                                if read_byte(st_get(st, 250), st_get(st, 252) + 3) == 108 do
                                    if read_byte(st_get(st, 250), st_get(st, 252) + 4) == 117 do
                                        if read_byte(st_get(st, 250), st_get(st, 252) + 5) == 100 do
                                            if read_byte(st_get(st, 250), st_get(st, 252) + 6) == 101 do
                                                st_set(st, 289, 1)
                                            end
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
                if st_get(st, 289) == 0 do
                    st_set(st, 252, st_get(st, 288))
                else
                    if st_get(st, 289) != 0 do
                        st_set(st, 252, st_get(st, 252) + 7)
                        st_set(st, 276, 1)
                        when st_get(st, 276) != 0 loop
                            if st_get(st, 252) >= st_get(st, 251) do
                                st_set(st, 276, 0)
                            else
                                st_set(st, 261, read_byte(st_get(st, 250), st_get(st, 252)))
                                st_set(st, 262, 0)
                                if st_get(st, 261) == 32 do
                                    st_set(st, 262, 1)
                                end
                                if st_get(st, 261) == 9 do
                                    st_set(st, 262, 1)
                                end
                                if st_get(st, 262) == 0 do
                                    st_set(st, 276, 0)
                                else
                                    st_set(st, 252, st_get(st, 252) + 1)
                                end
                            end
                        end
                        if st_get(st, 252) < st_get(st, 251) do
                            if read_byte(st_get(st, 250), st_get(st, 252)) == 34 do
                                st_set(st, 252, st_get(st, 252) + 1)
                                st_set(st, 277, st_get(st, 252))
                                st_set(st, 276, 1)
                                when st_get(st, 276) != 0 loop
                                    if st_get(st, 252) >= st_get(st, 251) do
                                        st_set(st, 276, 0)
                                    else
                                        if read_byte(st_get(st, 250), st_get(st, 252)) == 34 do
                                            st_set(st, 276, 0)
                                        else
                                            st_set(st, 252, st_get(st, 252) + 1)
                                        end
                                    end
                                end
                                st_set(st, 278, st_get(st, 252) - st_get(st, 277))
                                st_set(st, 279, bump_alloc(st, st_get(st, 278) + 1))
                                st_set(st, 260, 0)
                                when st_get(st, 260) < st_get(st, 278) loop
                                    write_byte(st_get(st, 279), st_get(st, 260), read_byte(st_get(st, 250), st_get(st, 277) + st_get(st, 260)))
                                    st_set(st, 260, st_get(st, 260) + 1)
                                end
                                write_byte(st_get(st, 279), st_get(st, 278), 0)
                                if st_get(st, 252) < st_get(st, 251) do
                                    st_set(st, 252, st_get(st, 252) + 1)
                                end
                                st_set(st, 276, 1)
                                when st_get(st, 276) != 0 loop
                                    if st_get(st, 252) >= st_get(st, 251) do
                                        st_set(st, 276, 0)
                                    else
                                        st_set(st, 261, read_byte(st_get(st, 250), st_get(st, 252)))
                                        st_set(st, 262, 0)
                                        if st_get(st, 261) == 32 do
                                            st_set(st, 262, 1)
                                        end
                                        if st_get(st, 261) == 9 do
                                            st_set(st, 262, 1)
                                        end
                                        if st_get(st, 262) == 0 do
                                            st_set(st, 276, 0)
                                        else
                                            st_set(st, 252, st_get(st, 252) + 1)
                                        end
                                    end
                                end
                                if st_get(st, 252) < st_get(st, 251) do
                                    if read_byte(st_get(st, 250), st_get(st, 252)) == 59 do
                                        st_set(st, 252, st_get(st, 252) + 1)
                                    end
                                end
                                st_set(st, 280, inc_resolve(st, st_get(st, 279)))
                                inc_push_scan(st)
                                expand_file(st, st_get(st, 280))
                                inc_pop_scan(st)
                                st_set(st, 283, 1)
                                st_set(st, 275, 1)
                                st_set(st, 266, 1)
                            else
                                var inc_more = 1
                                when inc_more != 0 loop
                                    st_set(st, 277, st_get(st, 252))
                                    st_set(st, 276, 1)
                                    when st_get(st, 276) != 0 loop
                                        if st_get(st, 252) >= st_get(st, 251) do
                                            st_set(st, 276, 0)
                                        else
                                            let c = read_byte(st_get(st, 250), st_get(st, 252))
                                            var is_p = 0
                                            if c >= 97 do
                                                if c <= 122 do
                                                    is_p = 1
                                                end
                                            end
                                            if c >= 65 do
                                                if c <= 90 do
                                                    is_p = 1
                                                end
                                            end
                                            if c >= 48 do
                                                if c <= 57 do
                                                    is_p = 1
                                                end
                                            end
                                            if c == 95 do
                                                is_p = 1
                                            end
                                            if c == 46 do
                                                is_p = 1
                                            end
                                            if is_p == 0 do
                                                st_set(st, 276, 0)
                                            else
                                                st_set(st, 252, st_get(st, 252) + 1)
                                            end
                                        end
                                    end
                                    st_set(st, 278, st_get(st, 252) - st_get(st, 277))
                                    if st_get(st, 278) > 0 do
                                        st_set(st, 279, bump_alloc(st, st_get(st, 278) + 6))
                                        st_set(st, 260, 0)
                                        when st_get(st, 260) < st_get(st, 278) loop
                                            var bc = read_byte(st_get(st, 250), st_get(st, 277) + st_get(st, 260))
                                            if bc == 46 do
                                                bc = 47
                                            end
                                            write_byte(st_get(st, 279), st_get(st, 260), bc)
                                            st_set(st, 260, st_get(st, 260) + 1)
                                        end
                                        write_byte(st_get(st, 279), st_get(st, 278) + 0, 46)
                                        write_byte(st_get(st, 279), st_get(st, 278) + 1, 118)
                                        write_byte(st_get(st, 279), st_get(st, 278) + 2, 114)
                                        write_byte(st_get(st, 279), st_get(st, 278) + 3, 105)
                                        write_byte(st_get(st, 279), st_get(st, 278) + 4, 0)
                                        st_set(st, 276, 1)
                                        when st_get(st, 276) != 0 loop
                                            if st_get(st, 252) >= st_get(st, 251) do
                                                st_set(st, 276, 0)
                                            else
                                                st_set(st, 261, read_byte(st_get(st, 250), st_get(st, 252)))
                                                st_set(st, 262, 0)
                                                if st_get(st, 261) == 32 do
                                                    st_set(st, 262, 1)
                                                end
                                                if st_get(st, 261) == 9 do
                                                    st_set(st, 262, 1)
                                                end
                                                if st_get(st, 262) == 0 do
                                                    st_set(st, 276, 0)
                                                else
                                                    st_set(st, 252, st_get(st, 252) + 1)
                                                end
                                            end
                                        end
                                        if st_get(st, 252) + 2 < st_get(st, 251) do
                                            if read_byte(st_get(st, 250), st_get(st, 252) + 0) == 97 do
                                                if read_byte(st_get(st, 250), st_get(st, 252) + 1) == 115 do
                                                    st_set(st, 252, st_get(st, 252) + 2)
                                                    st_set(st, 276, 1)
                                                    when st_get(st, 276) != 0 loop
                                                        if st_get(st, 252) >= st_get(st, 251) do
                                                            st_set(st, 276, 0)
                                                        else
                                                            let ac = read_byte(st_get(st, 250), st_get(st, 252))
                                                            if ac == 44 do
                                                                st_set(st, 276, 0)
                                                            else
                                                                if ac == 59 do
                                                                    st_set(st, 276, 0)
                                                                else
                                                                    if ac == 10 do
                                                                        st_set(st, 276, 0)
                                                                    else
                                                                        st_set(st, 252, st_get(st, 252) + 1)
                                                                    end
                                                                end
                                                            end
                                                        end
                                                    end
                                                end
                                            end
                                        end
                                        # Skip spaces after alias
                                        st_set(st, 276, 1)
                                        when st_get(st, 276) != 0 loop
                                            if st_get(st, 252) >= st_get(st, 251) do
                                                st_set(st, 276, 0)
                                            else
                                                st_set(st, 261, read_byte(st_get(st, 250), st_get(st, 252)))
                                                st_set(st, 262, 0)
                                                if st_get(st, 261) == 32 do
                                                    st_set(st, 262, 1)
                                                end
                                                if st_get(st, 261) == 9 do
                                                    st_set(st, 262, 1)
                                                end
                                                if st_get(st, 262) == 0 do
                                                    st_set(st, 276, 0)
                                                else
                                                    st_set(st, 252, st_get(st, 252) + 1)
                                                end
                                            end
                                        end
                                        st_set(st, 280, inc_resolve(st, st_get(st, 279)))
                                        inc_push_scan(st)
                                        expand_file(st, st_get(st, 280))
                                        inc_pop_scan(st)
                                        st_set(st, 283, 1)
                                        st_set(st, 275, 1)
                                        st_set(st, 266, 1)

                                        if st_get(st, 252) < st_get(st, 251) do
                                            if read_byte(st_get(st, 250), st_get(st, 252)) == 44 do
                                                st_set(st, 252, st_get(st, 252) + 1)
                                                # skip spaces after comma
                                                st_set(st, 276, 1)
                                                when st_get(st, 276) != 0 loop
                                                    if st_get(st, 252) >= st_get(st, 251) do
                                                        st_set(st, 276, 0)
                                                    else
                                                        st_set(st, 261, read_byte(st_get(st, 250), st_get(st, 252)))
                                                        st_set(st, 262, 0)
                                                        if st_get(st, 261) == 32 do
                                                            st_set(st, 262, 1)
                                                        end
                                                        if st_get(st, 261) == 9 do
                                                            st_set(st, 262, 1)
                                                        end
                                                        if st_get(st, 262) == 0 do
                                                            st_set(st, 276, 0)
                                                        else
                                                            st_set(st, 252, st_get(st, 252) + 1)
                                                        end
                                                    end
                                                end
                                            else
                                                if read_byte(st_get(st, 250), st_get(st, 252)) == 59 do
                                                    st_set(st, 252, st_get(st, 252) + 1)
                                                end
                                                inc_more = 0
                                            end
                                        else
                                            inc_more = 0
                                        end
                                    else
                                        inc_more = 0
                                    end
                                end
                            end
                        end
                        if st_get(st, 275) == 0 do
                            st_set(st, 252, st_get(st, 288))
                        end
                    end
                end
            end
            if st_get(st, 275) == 0 do
                if st_get(st, 252) < st_get(st, 251) do
                    st_set(st, 261, read_byte(st_get(st, 250), st_get(st, 252)))
                    inc_append_byte(st, st_get(st, 261))
                    st_set(st, 252, st_get(st, 252) + 1)
                    st_set(st, 266, 0)
                    if st_get(st, 261) == 10 do
                        st_set(st, 266, 1)
                    end
                end
            end
        end
    end
    st_set(st, 247, st_get(st, 247) - 1)
end.

func src_has_include(st, src, slen):
    st_set(st, 252, 0)
    st_set(st, 266, 1)
    st_set(st, 289, 0)
    st_set(st, 283, 1)
    when st_get(st, 283) != 0 loop
        if st_get(st, 252) >= slen do
            st_set(st, 283, 0)
        else
            if st_get(st, 266) != 0 do
                st_set(st, 288, st_get(st, 252))
                st_set(st, 276, 1)
                when st_get(st, 276) != 0 loop
                    if st_get(st, 252) >= slen do
                        st_set(st, 276, 0)
                    else
                        st_set(st, 261, read_byte(src, st_get(st, 252)))
                        st_set(st, 262, 0)
                        if st_get(st, 261) == 32 do
                            st_set(st, 262, 1)
                        end
                        if st_get(st, 261) == 9 do
                            st_set(st, 262, 1)
                        end
                        if st_get(st, 262) == 0 do
                            st_set(st, 276, 0)
                        else
                            st_set(st, 252, st_get(st, 252) + 1)
                        end
                    end
                end
                if st_get(st, 252) + 7 < slen do
                    if read_byte(src, st_get(st, 252) + 0) == 105 do
                        if read_byte(src, st_get(st, 252) + 1) == 110 do
                            if read_byte(src, st_get(st, 252) + 2) == 99 do
                                if read_byte(src, st_get(st, 252) + 3) == 108 do
                                    if read_byte(src, st_get(st, 252) + 4) == 117 do
                                        if read_byte(src, st_get(st, 252) + 5) == 100 do
                                            if read_byte(src, st_get(st, 252) + 6) == 101 do
                                                st_set(st, 289, 1)
                                                st_set(st, 283, 0)
                                            end
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
                if st_get(st, 289) == 0 do
                    st_set(st, 252, st_get(st, 288))
                end
            end
            if st_get(st, 283) != 0 do
                if st_get(st, 252) < slen do
                    st_set(st, 261, read_byte(src, st_get(st, 252)))
                    st_set(st, 252, st_get(st, 252) + 1)
                    st_set(st, 266, 0)
                    if st_get(st, 261) == 10 do
                        st_set(st, 266, 1)
                    end
                end
            end
        end
    end
    out st_get(st, 289)
end.

func expand_includes(st, entry_path):
    # Fast path: no `include` → keep slurped buffer (self-host of virc_stage1).
    st_set(st, 272, slurp_file(entry_path))
    st_set(st, 273, slurp_len())
    if src_has_include(st, st_get(st, 272), st_get(st, 273)) == 0 do
        st_set(st, 0, st_get(st, 272))
        st_set(st, 1, st_get(st, 273))
        out
    end
    # Buffers use 262144 (known-good imm); avoid 1MB/2MB literals (MOVZ truncation).
    st_set(st, 240, alloc(262144))
    st_set(st, 241, 0)
    st_set(st, 242, 262144)
    st_set(st, 248, alloc(128))
    st_set(st, 249, 0)
    st_set(st, 268, alloc(640))
    st_set(st, 269, 0)
    st_set(st, 247, 0)
    expand_file(st, entry_path)
    st_set(st, 0, st_get(st, 240))
    st_set(st, 1, st_get(st, 241))
end.

func main:
    let in_path = get_arg(1)
    let out_path = get_arg(3)

    # 4096 bytes = 512 i64 slots (include scratch uses 240..287).
    let st = alloc(4096)
    st_set(st, 2, 0)
    # Self-host needs ~2× ident copies (predeclare + parse); 8KB was SEGV via null cstr.
    let bump = alloc(4194304)
    st_set(st, 6, bump)
    st_set(st, 7, bump + 4194304)
    expand_includes(st, in_path)
    # Code buffer: Stage-1 TEXT ~96KB; 16KB overflow → SIGSEGV.
    st_set(st, 8, alloc(4194304))
    st_set(st, 9, 0)
    st_set(st, 220, 4194304)
    st_set(st, 11, alloc(1024))
    st_set(st, 12, alloc(1024))
    st_set(st, 13, 0)
    st_set(st, 14, 0 - 1)
    # BL relocation tables — self-host needs ~2K sites; 4KB (512) smashed fn_hk.
    st_set(st, 226, 65536)
    st_set(st, 15, alloc(65536))
    st_set(st, 16, alloc(65536))
    st_set(st, 17, 0)
    st_set(st, 18, 0)
    st_set(st, 66, 0)
    st_set(st, 67, 0)
    st_set(st, 89, 0)
    st_set(st, 221, 0)
    st_set(st, 222, 0)
    st_set(st, 223, 0)
    st_set(st, 371, 0)
    st_set(st, 378, 0)
    # Open-addressing symbol tables (128 buckets × 8 bytes).
    st_set(st, 95, alloc(1024))
    st_set(st, 96, alloc(1024))
    st_set(st, 97, alloc(1024))
    st_set(st, 98, alloc(1024))
    # Nest-indexed control-flow metadata; recursive parse_stmts must not clobber it.
    st_set(st, 231, alloc(256))
    st_set(st, 232, alloc(256))
    st_set(st, 233, alloc(256))
    hash_clear_at(st, 95)
    hash_clear_at(st, 97)
    # Entity tables
    st_set(st, 290, alloc(512))
    st_set(st, 291, alloc(512))
    st_set(st, 292, 0)
    st_set(st, 293, alloc(4096))
    st_set(st, 294, alloc(4096))
    st_set(st, 295, alloc(4096))
    st_set(st, 298, alloc(4096))
    st_set(st, 299, alloc(512))
    # Enum tables
    st_set(st, 320, alloc(512))
    st_set(st, 321, alloc(512))
    st_set(st, 322, 0)
    st_set(st, 323, alloc(4096))
    st_set(st, 324, alloc(4096))
    st_set(st, 325, alloc(4096))
    # Type alias tables
    st_set(st, 330, alloc(512))
    st_set(st, 331, alloc(512))
    st_set(st, 332, 0)
    # loc_names for parse_func — must NOT alloc() inside parse_func (Call clobbers st).
    st_set(st, 43, alloc(512))
    # Borrow checker tables
    st_set(st, 360, alloc(512))
    st_set(st, 361, alloc(512))
    st_set(st, 362, alloc(512))
    st_set(st, 363, alloc(512))
    st_set(st, 364, 0)
    st_set(st, 365, alloc(512))
    st_set(st, 366, alloc(512))
    st_set(st, 367, 0)
    st_set(st, 368, alloc(512))
    # Loop & Case tables (Spec §9 & §21)
    st_set(st, 371, 0)
    st_set(st, 372, alloc(256))
    st_set(st, 373, alloc(256))
    st_set(st, 374, alloc(2048))
    st_set(st, 375, alloc(256))
    st_set(st, 376, alloc(2048))
    st_set(st, 377, alloc(256))
    st_set(st, 378, 0)
    st_set(st, 379, alloc(256))
    st_set(st, 385, 0)
    st_set(st, 386, alloc(2048))
    st_set(st, 387, alloc(256))
    st_set(st, 388, alloc(256))

    # Module & Symbol Export / Import tables (Spec §3, §29)
    st_set(st, 390, 0)
    st_set(st, 391, alloc(1024))
    st_set(st, 392, alloc(1024))
    st_set(st, 393, alloc(1024))
    st_set(st, 394, alloc(1024))
    st_set(st, 395, alloc(1024))
    st_set(st, 396, alloc(1024))
    st_set(st, 397, 0)
    st_set(st, 398, alloc(1024))
    st_set(st, 399, alloc(1024))
    hash_clear_at(st, 391)
    hash_clear_at(st, 393)
    hash_clear_at(st, 395)
    hash_clear_at(st, 398)

    predeclare_funcs(st)
    emit_runtime(st)
    when st_get(st, 3) != 0 loop
        if st_get(st, 3) == 3 do
            parse_func(st)
        else
            st_set(st, 18, 0)
            if st_get(st, 3) == 45 do
                st_set(st, 18, 1)
            end
            if st_get(st, 3) == 73 do
                st_set(st, 18, 1)
            end
            if st_get(st, 3) == 72 do
                st_set(st, 18, 1)
            end
            if st_get(st, 18) != 0 do
                # skip entity / packed entity / enum until end.
                st_set(st, 18, 1)
                when st_get(st, 18) != 0 loop
                    next_tok(st)
                    if st_get(st, 3) == 0 do
                        st_set(st, 18, 0)
                    end
                    if st_get(st, 3) == 8 do
                        next_tok(st)
                        if st_get(st, 3) == 16 do
                            next_tok(st)
                            st_set(st, 18, 0)
                        end
                    end
                end
            else
                next_tok(st)
            end
        end
    end
    patch_calls(st)
    let ent = emit_entry(st)
    write_macho(st, out_path, ent)
    out 0
end.
