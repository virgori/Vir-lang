# virc_stage1.vri — thin Stage-1 compiler (macOS ARM64)
# Globals-free: one state block `st` (Stage-0 LoadGlobal/StoreGlobal unreliable).
# Build: ./core/build/vir run virc_boot.vri -- virc_stage1.vri -o dist/virc-stage1
# Smoke: ./dist/virc-stage1 tests/bootstrap_codegen/cg_call.vri -o /tmp/cg1 && /tmp/cg1 → 42
#
# st layout (i64 slots):
#  0 src  1 slen  2 pos  3 tok  4 tival  5 tname
#  6 bump  7 bump_end  8 out  9 out_n  10 rt_print
#  11 fn_off  12 fn_name  13 fn_n  14 main_off
#  15 call_sites  16 call_tgts  17 call_n

func st_get:
    in(st, i)
    out read_word(st, i * 8);
end.

func st_set:
    in(st, i, v)
    write_word(st, i * 8, v);
end.

# Avoid `or` — Stage-0 lowers `a or b` to broken ADD of slots (hangs lexer).
func is_space:
    in(c)
    if c == 32 do
        out 1;
    end
    if c == 9 do
        out 1;
    end
    if c == 10 do
        out 1;
    end
    if c == 13 do
        out 1;
    end
    out 0;
end.

func is_alpha:
    in(c)
    if c >= 97 do
        if c <= 122 do
            out 1;
        end
    end
    if c >= 65 do
        if c <= 90 do
            out 1;
        end
    end
    if c == 95 do
        out 1;
    end
    out 0;
end.

func is_digit:
    in(c)
    if c >= 48 do
        if c <= 57 do
            out 1;
        end
    end
    out 0;
end.

func ch:
    in(st, i)
    if i < 0 do
        out 0;
    end
    let slen = st_get(st, 1);
    if i >= slen do
        out 0;
    end
    let src = st_get(st, 0);
    out read_byte(src, i);
end.

func bump_alloc:
    in(st, n)
    let p = st_get(st, 6);
    st_set(st, 6, p + n);
    if st_get(st, 6) > st_get(st, 7) do
        out 0;
    end
    out p;
end.

func bump_cstr:
    in(st, start, len)
    # Park bump ptr in st[25] — Stage-0 breaks `let p = bump_alloc(...)`
    # (Call lowered to st_get with wrong index; `out p` became 0).
    st_set(st, 25, st_get(st, 6));
    st_set(st, 6, st_get(st, 25) + len + 1);
    if st_get(st, 6) > st_get(st, 7) do
        out 0;
    end
    # st[19]=i — Stage-0 drops `i = i + 1` inside when bodies.
    st_set(st, 19, 0);
    when st_get(st, 19) < len loop
        let i = st_get(st, 19);
        write_byte(st_get(st, 25), i, ch(st, start + i));
        st_set(st, 19, i + 1);
    end
    write_byte(st_get(st, 25), len, 0);
    out st_get(st, 25);
end.

func ident_is:
    in(s, c0, c1, c2, c3, n)
    if read_byte(s, 0) != c0 do
        out 0;
    end
    if n >= 2 do
        if read_byte(s, 1) != c1 do
            out 0;
        end
    end
    if n >= 3 do
        if read_byte(s, 2) != c2 do
            out 0;
        end
    end
    if n >= 4 do
        if read_byte(s, 3) != c3 do
            out 0;
        end
    end
    if read_byte(s, n) != 0 do
        out 0;
    end
    out 1;
end.

func next_tok:
    in(st)
    # Cursor only in st[2]. Flag in st[18]. Stage-0 drops `pos = pos+1` in when-bodies.
    # No `let` inside when-bodies: Stage-0 drops the store and the local keeps
    # a stale value from an earlier loop. st[57]=cursor, st[58]=char.
    st_set(st, 18, 1);
    when st_get(st, 18) != 0 loop
        st_set(st, 57, st_get(st, 2));
        if st_get(st, 57) >= st_get(st, 1) do
            st_set(st, 18, 0);
        else
            st_set(st, 58, read_byte(st_get(st, 0), st_get(st, 57)));
            st_set(st, 46, 0);
            if st_get(st, 58) == 32 do
                st_set(st, 46, 1);
            end
            if st_get(st, 58) == 9 do
                st_set(st, 46, 1);
            end
            if st_get(st, 58) == 10 do
                st_set(st, 46, 1);
            end
            if st_get(st, 58) == 13 do
                st_set(st, 46, 1);
            end
            if st_get(st, 46) == 0 do
                st_set(st, 18, 0);
            else
                st_set(st, 2, st_get(st, 57) + 1);
            end
        end
    end
    if st_get(st, 2) >= st_get(st, 1) do
        st_set(st, 3, 0);
        out;
    end
    # Park current char in st[42] — Stage-0 clobbers `let c` across calls.
    # Inline alpha/digit tests (no Call) — nested is_alpha/is_digit SEGV'd under parse_func.
    st_set(st, 42, ch(st, st_get(st, 2)));
    st_set(st, 46, 0);
    if st_get(st, 42) >= 97 do
        if st_get(st, 42) <= 122 do
            st_set(st, 46, 1);
        end
    end
    if st_get(st, 42) >= 65 do
        if st_get(st, 42) <= 90 do
            st_set(st, 46, 1);
        end
    end
    if st_get(st, 42) == 95 do
        st_set(st, 46, 1);
    end
    if st_get(st, 46) != 0 do
        # st[26]=start — avoid dead `let start` across when-loop temps
        st_set(st, 26, st_get(st, 2));
        st_set(st, 18, 1);
        when st_get(st, 18) != 0 loop
            st_set(st, 57, st_get(st, 2));
            if st_get(st, 57) >= st_get(st, 1) do
                st_set(st, 18, 0);
            else
                st_set(st, 58, read_byte(st_get(st, 0), st_get(st, 57)));
                st_set(st, 46, 0);
                if st_get(st, 58) >= 97 do
                    if st_get(st, 58) <= 122 do
                        st_set(st, 46, 1);
                    end
                end
                if st_get(st, 58) >= 65 do
                    if st_get(st, 58) <= 90 do
                        st_set(st, 46, 1);
                    end
                end
                if st_get(st, 58) == 95 do
                    st_set(st, 46, 1);
                end
                if st_get(st, 58) >= 48 do
                    if st_get(st, 58) <= 57 do
                        st_set(st, 46, 1);
                    end
                end
                if st_get(st, 46) == 0 do
                    st_set(st, 18, 0);
                else
                    st_set(st, 2, st_get(st, 57) + 1);
                end
            end
        end
        st_set(st, 59, st_get(st, 2));
        st_set(st, 5, bump_cstr(st, st_get(st, 26), st_get(st, 59) - st_get(st, 26)));
        classify_kw(st);
        out;
    end
    st_set(st, 46, 0);
    if st_get(st, 42) >= 48 do
        if st_get(st, 42) <= 57 do
            st_set(st, 46, 1);
        end
    end
    if st_get(st, 46) != 0 do
        st_set(st, 4, 0);
        st_set(st, 18, 1);
        when st_get(st, 18) != 0 loop
            st_set(st, 57, st_get(st, 2));
            if st_get(st, 57) >= st_get(st, 1) do
                st_set(st, 18, 0);
            else
                st_set(st, 58, read_byte(st_get(st, 0), st_get(st, 57)));
                if st_get(st, 58) >= 48 do
                    if st_get(st, 58) <= 57 do
                        st_set(st, 4, st_get(st, 4) * 10 + (st_get(st, 58) - 48));
                        st_set(st, 2, st_get(st, 57) + 1);
                    else
                        st_set(st, 18, 0);
                    end
                else
                    st_set(st, 18, 0);
                end
            end
        end
        st_set(st, 3, 2);
        out;
    end
    st_set(st, 2, st_get(st, 2) + 1);
    st_set(st, 3, 0);
    if st_get(st, 42) == 40 do
        st_set(st, 3, 9);
    end
    if st_get(st, 42) == 41 do
        st_set(st, 3, 10);
    end
    if st_get(st, 42) == 58 do
        st_set(st, 3, 11);
    end
    if st_get(st, 42) == 59 do
        st_set(st, 3, 12);
    end
    if st_get(st, 42) == 44 do
        st_set(st, 3, 13);
    end
    if st_get(st, 42) == 43 do
        st_set(st, 3, 14);
    end
    if st_get(st, 42) == 61 do
        st_set(st, 3, 15);
    end
    if st_get(st, 42) == 46 do
        st_set(st, 3, 16);
    end
end.

func classify_kw:
    in(st)
    st_set(st, 3, 1);
    if ident_is(st_get(st, 5), 102, 117, 110, 99, 4) != 0 do
        st_set(st, 3, 3);
    end
    if ident_is(st_get(st, 5), 105, 110, 0, 0, 2) != 0 do
        st_set(st, 3, 4);
    end
    if ident_is(st_get(st, 5), 111, 117, 116, 0, 3) != 0 do
        st_set(st, 3, 5);
    end
    if ident_is(st_get(st, 5), 108, 101, 116, 0, 3) != 0 do
        st_set(st, 3, 6);
    end
    if read_byte(st_get(st, 5), 0) == 112 do
        if read_byte(st_get(st, 5), 1) == 114 do
            if read_byte(st_get(st, 5), 2) == 105 do
                if read_byte(st_get(st, 5), 3) == 110 do
                    if read_byte(st_get(st, 5), 4) == 116 do
                        if read_byte(st_get(st, 5), 5) == 0 do
                            st_set(st, 3, 7);
                        end
                    end
                end
            end
        end
    end
    if ident_is(st_get(st, 5), 101, 110, 100, 0, 3) != 0 do
        st_set(st, 3, 8);
    end
end.

func emit_u32:
    in(st, w)
    # No `let buf/n` — Stage-0 mis-slots `st` in `let x = st_get(st, …)`.
    write_byte(st_get(st, 8), st_get(st, 9), w bit_and 255);
    write_byte(st_get(st, 8), st_get(st, 9) + 1, (w shr 8) bit_and 255);
    write_byte(st_get(st, 8), st_get(st, 9) + 2, (w shr 16) bit_and 255);
    write_byte(st_get(st, 8), st_get(st, 9) + 3, (w shr 24) bit_and 255);
    st_set(st, 9, st_get(st, 9) + 4);
end.

func emit_u32_at:
    in(st, off, w)
    write_byte(st_get(st, 8), off, w bit_and 255);
    write_byte(st_get(st, 8), off + 1, (w shr 8) bit_and 255);
    write_byte(st_get(st, 8), off + 2, (w shr 16) bit_and 255);
    write_byte(st_get(st, 8), off + 3, (w shr 24) bit_and 255);
end.

func emit_runtime:
    in(st)
    st_set(st, 10, st_get(st, 9));
    emit_u32(st, 0xA9BA7BFD);
    emit_u32(st, 0x910003FD);
    emit_u32(st, 0xAA0003F3);
    emit_u32(st, 0x910043F4);
    emit_u32(st, 0xD2800015);
    emit_u32(st, 0xD2800016);
    emit_u32(st, 0xF100027F);
    emit_u32(st, 0x5400006A);
    emit_u32(st, 0xCB1303F3);
    emit_u32(st, 0xD2800036);
    st_set(st, 28, st_get(st, 9));
    emit_u32(st, 0xB4000013);
    emit_u32(st, 0xD2800157);
    st_set(st, 29, st_get(st, 9));
    st_set(st, 30, st_get(st, 9));
    emit_u32(st, 0xB4000013);
    emit_u32(st, 0x9AD70A78);
    emit_u32(st, 0x9B17CF19);
    emit_u32(st, 0x9100C339);
    emit_u32(st, 0x38356A99);
    emit_u32(st, 0x910006B5);
    emit_u32(st, 0xAA1803F3);
    st_set(st, 31, (st_get(st, 29) - st_get(st, 9)) / 4);
    emit_u32(st, 0x14000000 bit_or (st_get(st, 31) bit_and 0x03FFFFFF));
    st_set(st, 32, st_get(st, 9));
    emit_u32(st, 0x14000000);
    st_set(st, 33, st_get(st, 9));
    emit_u32(st, 0xD2800619);
    emit_u32(st, 0x38356A99);
    emit_u32(st, 0x910006B5);
    st_set(st, 34, st_get(st, 9));
    emit_u32_at(st, st_get(st, 28), 0xB4000013 bit_or ((((st_get(st, 33) - st_get(st, 28)) / 4) bit_and 0x7FFFF) shl 5));
    emit_u32_at(st, st_get(st, 30), 0xB4000013 bit_or ((((st_get(st, 34) - st_get(st, 30)) / 4) bit_and 0x7FFFF) shl 5));
    emit_u32_at(st, st_get(st, 32), 0x14000000 bit_or (((st_get(st, 34) - st_get(st, 32)) / 4) bit_and 0x03FFFFFF));
    st_set(st, 35, st_get(st, 9));
    emit_u32(st, 0xB4000016);
    emit_u32(st, 0xD28005B9);
    emit_u32(st, 0x38356A99);
    emit_u32(st, 0x910006B5);
    st_set(st, 36, st_get(st, 9));
    emit_u32_at(st, st_get(st, 35), 0xB4000016 bit_or ((((st_get(st, 36) - st_get(st, 35)) / 4) bit_and 0x7FFFF) shl 5));
    emit_u32(st, 0xD2800017);
    emit_u32(st, 0xAA1503F8);
    emit_u32(st, 0xD1000718);
    st_set(st, 37, st_get(st, 9));
    emit_u32(st, 0xEB1802FF);
    st_set(st, 38, st_get(st, 9));
    emit_u32(st, 0x5400000A);
    emit_u32(st, 0x38776A99);
    emit_u32(st, 0x38786A9A);
    emit_u32(st, 0x38376A9A);
    emit_u32(st, 0x38386A99);
    emit_u32(st, 0x910006F7);
    emit_u32(st, 0xD1000718);
    st_set(st, 39, (st_get(st, 37) - st_get(st, 9)) / 4);
    emit_u32(st, 0x14000000 bit_or (st_get(st, 39) bit_and 0x03FFFFFF));
    st_set(st, 40, st_get(st, 9));
    emit_u32_at(st, st_get(st, 38), 0x5400000A bit_or ((((st_get(st, 40) - st_get(st, 38)) / 4) bit_and 0x7FFFF) shl 5));
    emit_u32(st, 0xD2800020);
    emit_u32(st, 0xAA1403E1);
    emit_u32(st, 0xAA1503E2);
    emit_u32(st, 0xD2800090);
    emit_u32(st, 0xF2A04010);
    emit_u32(st, 0xD4001001);
    emit_u32(st, 0xD2800151);
    emit_u32(st, 0xD10043FF);
    emit_u32(st, 0x390003F1);
    emit_u32(st, 0xD2800020);
    emit_u32(st, 0x910003E1);
    emit_u32(st, 0xD2800022);
    emit_u32(st, 0xD2800090);
    emit_u32(st, 0xF2A04010);
    emit_u32(st, 0xD4001001);
    emit_u32(st, 0x910043FF);
    emit_u32(st, 0xA8C67BFD);
    emit_u32(st, 0xD65F03C0);
end.

func emit_movz_x8:
    in(st, imm)
    emit_u32(st, 0xD2800008 bit_or ((imm bit_and 65535) shl 5));
end.

func emit_str_x8_fp:
    in(st, off)
    emit_u32(st, 0xF9000008 bit_or ((((off / 8) bit_and 4095) shl 10) bit_or (29 shl 5)));
end.

func emit_ldr_x0_fp:
    in(st, off)
    emit_u32(st, 0xF9400000 bit_or ((((off / 8) bit_and 4095) shl 10) bit_or (29 shl 5)));
end.

func emit_ldr_x8_fp:
    in(st, off)
    emit_u32(st, 0xF9400008 bit_or ((((off / 8) bit_and 4095) shl 10) bit_or (29 shl 5)));
end.

func emit_bl:
    in(st, target)
    # `let site = st_get(st, 9)` is fine after the Stage-0 Identifier fix.
    # Avoid a second `let d = (target - site) / 4` — nested BinOp init is still
    # constant-folded to 0 via parse-time vconst (emits `bl #0` → hang).
    let site = st_get(st, 9);
    emit_u32(st, 0x94000000 bit_or (((target - site) / 4) bit_and 0x03FFFFFF));
end.

func emit_bl_later:
    in(st, fi)
    let site = st_get(st, 9);
    emit_u32(st, 0x94000000);
    write_word(st_get(st, 15), st_get(st, 17) * 8, site);
    write_word(st_get(st, 16), st_get(st, 17) * 8, fi);
    st_set(st, 17, st_get(st, 17) + 1);
end.

func cstr_eq:
    in(st, a, b)
    st_set(st, 19, 0);
    when st_get(st, 19) < 256 loop
        let i = st_get(st, 19);
        let ca = read_byte(a, i);
        let cb = read_byte(b, i);
        if ca != cb do
            out 0;
        end
        if ca == 0 do
            out 1;
        end
        st_set(st, 19, i + 1);
    end
    out 0;
end.

func find_fn:
    in(st, name)
    let names = st_get(st, 12);
    let n = st_get(st, 13);
    st_set(st, 20, 0);
    when st_get(st, 20) < n loop
        let i = st_get(st, 20);
        let nm = read_word(names, i * 8);
        let eq = cstr_eq(st, nm, name);
        if eq != 0 do
            out i;
        end
        st_set(st, 20, i + 1);
    end
    out 0 - 1;
end.

func slot_of:
    in(st, name, names, n)
    st_set(st, 20, 0);
    when st_get(st, 20) < n loop
        let i = st_get(st, 20);
        let nm = read_word(names, i * 8);
        let eq = cstr_eq(st, nm, name);
        if eq != 0 do
            out 16 + i * 8;
        end
        st_set(st, 20, i + 1);
    end
    out 0 - 1;
end.

func expect:
    in(st, k)
    if st_get(st, 3) != k do
        print(99);
        print(k);
        print(st_get(st, 3));
        exit_prog(1);
    end
    next_tok(st);
end.

# Non-recursive expr (Stage-0 SEGV'd on recursive parse_expr_to).
# Enough for cg_call: number | local | call(number|local) | + chain of those.
func parse_expr_to:
    # st[50]=dest_slot. Locals: first local always fp+16 for Stage-1 smoke.
    in(st)
    if st_get(st, 3) == 2 do
        emit_movz_x8(st, st_get(st, 4));
        emit_str_x8_fp(st, st_get(st, 50));
        next_tok(st);
    else
        if st_get(st, 3) == 1 do
            st_set(st, 53, st_get(st, 5));
            next_tok(st);
            if st_get(st, 3) == 9 do
                # call(arg)
                next_tok(st);
                if st_get(st, 3) == 2 do
                    emit_movz_x8(st, st_get(st, 4));
                    emit_str_x8_fp(st, 200);
                    next_tok(st);
                    emit_ldr_x0_fp(st, 200);
                else
                    emit_ldr_x0_fp(st, 16);
                    if st_get(st, 3) == 1 do
                        next_tok(st);
                    end
                end
                expect(st, 10);
                st_set(st, 55, find_fn(st, st_get(st, 53)));
                if st_get(st, 55) < 0 do
                    print(98);
                    exit_prog(1);
                end
                emit_bl_later(st, st_get(st, 55));
                emit_u32(st, 0xAA0003E8);
                emit_str_x8_fp(st, st_get(st, 50));
            else
                # local var → fp+16 (single-local funcs)
                emit_ldr_x8_fp(st, 16);
                emit_str_x8_fp(st, st_get(st, 50));
            end
        end
    end
    when st_get(st, 3) == 14 loop
        next_tok(st);
        st_set(st, 56, st_get(st, 50) + 64);
        if st_get(st, 3) == 2 do
            emit_movz_x8(st, st_get(st, 4));
            emit_str_x8_fp(st, st_get(st, 56));
            next_tok(st);
        else
            if st_get(st, 3) == 1 do
                next_tok(st);
                emit_ldr_x8_fp(st, 16);
                emit_str_x8_fp(st, st_get(st, 56));
            end
        end
        emit_ldr_x8_fp(st, st_get(st, 50));
        emit_ldr_x0_fp(st, st_get(st, 56));
        emit_u32(st, 0x8B000108);
        emit_str_x8_fp(st, st_get(st, 50));
    end
end.

func parse_func:
    in(st)
    expect(st, 3);
    if st_get(st, 3) != 1 do
        print(96);
        exit_prog(1);
    end
    st_set(st, 41, st_get(st, 5));
    # Manual ':' — avoid next_tok punct under nesting when possible.
    if ch(st, st_get(st, 2)) == 58 do
        st_set(st, 2, st_get(st, 2) + 1);
        st_set(st, 3, 11);
    else
        next_tok(st);
    end
    expect(st, 11);
    st_set(st, 21, 0);
    if st_get(st, 3) == 4 do
        if ch(st, st_get(st, 2)) == 40 do
            st_set(st, 2, st_get(st, 2) + 1);
            st_set(st, 3, 9);
        else
            next_tok(st);
        end
        expect(st, 9);
        # One param: name : type  (cg_call). No nested when — lets after Call clobber st.
        if st_get(st, 3) != 1 do
            print(96);
            exit_prog(1);
        end
        write_word(st_get(st, 43), 0, st_get(st, 5));
        st_set(st, 21, 1);
        if ch(st, st_get(st, 2)) == 58 do
            st_set(st, 2, st_get(st, 2) + 1);
        end
        # Skip until ')' using read_byte + st slots only (no ch/let).
        st_set(st, 48, 1);
        when st_get(st, 48) != 0 loop
            st_set(st, 49, st_get(st, 2));
            st_set(st, 46, read_byte(st_get(st, 0), st_get(st, 49)));
            if st_get(st, 46) == 41 do
                st_set(st, 48, 0);
            else
                if st_get(st, 46) == 0 do
                    st_set(st, 48, 0);
                else
                    st_set(st, 2, st_get(st, 49) + 1);
                end
            end
        end
        st_set(st, 2, st_get(st, 2) + 1);
        st_set(st, 3, 10);
        expect(st, 10);
    end

    st_set(st, 44, st_get(st, 9));
    write_word(st_get(st, 11), st_get(st, 13) * 8, st_get(st, 44));
    write_word(st_get(st, 12), st_get(st, 13) * 8, st_get(st, 41));
    st_set(st, 13, st_get(st, 13) + 1);
    if ident_is(st_get(st, 41), 109, 97, 105, 110, 4) != 0 do
        st_set(st, 14, st_get(st, 44));
    end

    emit_u32(st, 0xA9B07BFD);
    emit_u32(st, 0x910003FD);
    st_set(st, 22, 0);
    when st_get(st, 22) < st_get(st, 21) loop
        let pi = st_get(st, 22);
        if pi < 8 do
            emit_u32(st, 0xAA0003E8 bit_or (pi shl 16));
            emit_str_x8_fp(st, 16 + pi * 8);
        end
        st_set(st, 22, pi + 1);
    end

    st_set(st, 24, 1);
    when st_get(st, 24) != 0 loop
        st_set(st, 47, st_get(st, 2));
        let tk = st_get(st, 3);
        if tk == 8 do
            st_set(st, 24, 0);
        else
            if tk == 0 do
                st_set(st, 24, 0);
            else
                if tk == 6 do
                    next_tok(st);
                    if st_get(st, 3) != 1 do
                        print(95);
                        exit_prog(1);
                    end
                    st_set(st, 45, st_get(st, 5));
                    next_tok(st);
                    expect(st, 15);
                    let ln2 = st_get(st, 21);
                    write_word(st_get(st, 43), ln2 * 8, st_get(st, 45));
                    let vslot = 16 + ln2 * 8;
                    st_set(st, 21, ln2 + 1);
                    st_set(st, 50, vslot);
st_set(st, 51, st_get(st, 43));
st_set(st, 52, st_get(st, 21));
parse_expr_to(st);
                    if st_get(st, 3) == 12 do
                        next_tok(st);
                    end
                end
                if st_get(st, 3) == 7 do
                    next_tok(st);
                    st_set(st, 50, 180);
st_set(st, 51, st_get(st, 43));
st_set(st, 52, st_get(st, 21));
parse_expr_to(st);
                    emit_ldr_x0_fp(st, 180);
                    emit_bl(st, st_get(st, 10));
                    if st_get(st, 3) == 12 do
                        next_tok(st);
                    end
                end
                if st_get(st, 3) == 5 do
                    next_tok(st);
                    st_set(st, 50, 180);
st_set(st, 51, st_get(st, 43));
st_set(st, 52, st_get(st, 21));
parse_expr_to(st);
                    emit_ldr_x0_fp(st, 180);
                    emit_u32(st, 0xA8D07BFD);
                    emit_u32(st, 0xD65F03C0);
                    if st_get(st, 3) == 12 do
                        next_tok(st);
                    end
                end
            end
        end
        # Unknown statement token: bail instead of spinning on an unchanged cursor.
        if st_get(st, 24) != 0 do
            if st_get(st, 2) == st_get(st, 47) do
                print(94);
                print(st_get(st, 3));
                exit_prog(1);
            end
        end
    end
    expect(st, 8);
    if st_get(st, 3) == 16 do
        next_tok(st);
    end
    emit_u32(st, 0xD2800000);
    emit_u32(st, 0xA8D07BFD);
    emit_u32(st, 0xD65F03C0);
end.

func patch_calls:
    in(st)
    st_set(st, 20, 0);
    when st_get(st, 20) < st_get(st, 17) loop
        st_set(st, 62, read_word(st_get(st, 15), st_get(st, 20) * 8));
        st_set(st, 63, read_word(st_get(st, 16), st_get(st, 20) * 8));
        st_set(st, 64, read_word(st_get(st, 11), st_get(st, 63) * 8));
        emit_u32_at(st, st_get(st, 62), 0x94000000 bit_or ((((st_get(st, 64) - st_get(st, 62)) / 4)) bit_and 0x03FFFFFF));
        st_set(st, 20, st_get(st, 20) + 1);
    end
end.

func emit_entry:
    in(st)
    let ent = st_get(st, 9);
    emit_u32(st, 0xA9BF7BFD);
    emit_u32(st, 0x910003FD);
    emit_bl(st, st_get(st, 14));
    emit_u32(st, 0xD2800000);
    emit_u32(st, 0xD2800030);
    emit_u32(st, 0xF2A04010);
    emit_u32(st, 0xD4001001);
    out ent;
end.

func u32_le:
    in(buf, off, w)
    write_byte(buf, off, w bit_and 255);
    write_byte(buf, off + 1, (w shr 8) bit_and 255);
    write_byte(buf, off + 2, (w shr 16) bit_and 255);
    write_byte(buf, off + 3, (w shr 24) bit_and 255);
end.

func u64_le:
    in(buf, off, lo, hi)
    u32_le(buf, off, lo);
    u32_le(buf, off + 4, hi);
end.

func write_macho:
    in(st, path, entry_off)
    # 10 load commands (552 bytes) + 32 bytes pad => code at 616, matching the
    # layout codesign accepts: __PAGEZERO / __TEXT+__text / __LINKEDIT /
    # CHAINED_FIXUPS / SYMTAB / DYSYMTAB / LOAD_DYLINKER / UUID / MAIN / DYLIB.
    let code_off = 616;
    let text_seg = 16384;
    let code_size = st_get(st, 9);
    let link_sz = 52;
    let file_size = text_seg + link_sz;
    let buf = alloc(file_size);
    st_set(st, 20, 0);
    when st_get(st, 20) < file_size loop
        write_byte(buf, st_get(st, 20), 0);
        st_set(st, 20, st_get(st, 20) + 1);
    end

    # ── header ──
    u32_le(buf, 0, 0xFEEDFACF);
    u32_le(buf, 4, 0x0100000C);
    u32_le(buf, 8, 0);
    u32_le(buf, 12, 2);
    u32_le(buf, 16, 10);
    u32_le(buf, 20, 552);
    u32_le(buf, 24, 0x00200085);
    u32_le(buf, 28, 0);

    # ── 1. __PAGEZERO (72) ──
    u32_le(buf, 32, 0x19);
    u32_le(buf, 36, 72);
    write_byte(buf, 40, 95);
    write_byte(buf, 41, 95);
    write_byte(buf, 42, 80);
    write_byte(buf, 43, 65);
    write_byte(buf, 44, 71);
    write_byte(buf, 45, 69);
    write_byte(buf, 46, 90);
    write_byte(buf, 47, 69);
    write_byte(buf, 48, 82);
    write_byte(buf, 49, 79);
    u64_le(buf, 56, 0, 0);
    u64_le(buf, 64, 0, 1);
    u64_le(buf, 72, 0, 0);
    u64_le(buf, 80, 0, 0);
    u32_le(buf, 88, 0);
    u32_le(buf, 92, 0);
    u32_le(buf, 96, 0);
    u32_le(buf, 100, 0);

    # ── 2. __TEXT (72) + __text section (80) ──
    u32_le(buf, 104, 0x19);
    u32_le(buf, 108, 152);
    write_byte(buf, 112, 95);
    write_byte(buf, 113, 95);
    write_byte(buf, 114, 84);
    write_byte(buf, 115, 69);
    write_byte(buf, 116, 88);
    write_byte(buf, 117, 84);
    u64_le(buf, 128, 0, 1);
    u64_le(buf, 136, text_seg, 0);
    u64_le(buf, 144, 0, 0);
    u64_le(buf, 152, text_seg, 0);
    u32_le(buf, 160, 7);
    u32_le(buf, 164, 5);
    u32_le(buf, 168, 1);
    u32_le(buf, 172, 0);
    write_byte(buf, 176, 95);
    write_byte(buf, 177, 95);
    write_byte(buf, 178, 116);
    write_byte(buf, 179, 101);
    write_byte(buf, 180, 120);
    write_byte(buf, 181, 116);
    write_byte(buf, 192, 95);
    write_byte(buf, 193, 95);
    write_byte(buf, 194, 84);
    write_byte(buf, 195, 69);
    write_byte(buf, 196, 88);
    write_byte(buf, 197, 84);
    u64_le(buf, 208, code_off, 1);
    u64_le(buf, 216, code_size, 0);
    u32_le(buf, 224, code_off);
    u32_le(buf, 228, 2);
    u32_le(buf, 232, 0);
    u32_le(buf, 236, 0);
    u32_le(buf, 240, 0x80000400);
    u32_le(buf, 244, 0);
    u32_le(buf, 248, 0);
    u32_le(buf, 252, 0);

    # ── 3. __LINKEDIT (72) ──
    u32_le(buf, 256, 0x19);
    u32_le(buf, 260, 72);
    write_byte(buf, 264, 95);
    write_byte(buf, 265, 95);
    write_byte(buf, 266, 76);
    write_byte(buf, 267, 73);
    write_byte(buf, 268, 78);
    write_byte(buf, 269, 75);
    write_byte(buf, 270, 69);
    write_byte(buf, 271, 68);
    write_byte(buf, 272, 73);
    write_byte(buf, 273, 84);
    u64_le(buf, 280, text_seg, 1);
    u64_le(buf, 288, text_seg, 0);
    u64_le(buf, 296, text_seg, 0);
    u64_le(buf, 304, link_sz, 0);
    u32_le(buf, 312, 1);
    u32_le(buf, 316, 1);
    u32_le(buf, 320, 0);
    u32_le(buf, 324, 0);

    # ── 4. LC_DYLD_CHAINED_FIXUPS (16) ──
    u32_le(buf, 328, 0x80000034);
    u32_le(buf, 332, 16);
    u32_le(buf, 336, text_seg);
    u32_le(buf, 340, 48);

    # ── 5. LC_SYMTAB (24) ──
    u32_le(buf, 344, 2);
    u32_le(buf, 348, 24);
    u32_le(buf, 352, text_seg + 48);
    u32_le(buf, 356, 0);
    u32_le(buf, 360, text_seg + 48);
    u32_le(buf, 364, 4);

    # ── 6. LC_DYSYMTAB (80, zeros after cmd/cmdsize) ──
    u32_le(buf, 368, 0x0B);
    u32_le(buf, 372, 80);

    # ── 7. LC_LOAD_DYLINKER (32): "/usr/lib/dyld" at offset 12 ──
    u32_le(buf, 448, 0x0E);
    u32_le(buf, 452, 32);
    u32_le(buf, 456, 12);
    write_byte(buf, 460, 47);
    write_byte(buf, 461, 117);
    write_byte(buf, 462, 115);
    write_byte(buf, 463, 114);
    write_byte(buf, 464, 47);
    write_byte(buf, 465, 108);
    write_byte(buf, 466, 105);
    write_byte(buf, 467, 98);
    write_byte(buf, 468, 47);
    write_byte(buf, 469, 100);
    write_byte(buf, 470, 121);
    write_byte(buf, 471, 108);
    write_byte(buf, 472, 100);

    # ── 8. LC_UUID (24) ──
    u32_le(buf, 480, 0x1B);
    u32_le(buf, 484, 24);
    st_set(st, 20, 0);
    when st_get(st, 20) < 16 loop
        write_byte(buf, 488 + st_get(st, 20), st_get(st, 20) + 1);
        st_set(st, 20, st_get(st, 20) + 1);
    end

    # ── 9. LC_MAIN (24) ──
    u32_le(buf, 504, 0x80000028);
    u32_le(buf, 508, 24);
    u64_le(buf, 512, code_off + entry_off, 0);
    u64_le(buf, 520, 0, 0);

    # ── 10. LC_LOAD_DYLIB (56): "/usr/lib/libSystem.B.dylib" at offset 24 ──
    u32_le(buf, 528, 0x0C);
    u32_le(buf, 532, 56);
    u32_le(buf, 536, 24);
    u32_le(buf, 540, 0);
    u32_le(buf, 544, 0x00010000);
    u32_le(buf, 548, 0x00010000);
    write_byte(buf, 552, 47);
    write_byte(buf, 553, 117);
    write_byte(buf, 554, 115);
    write_byte(buf, 555, 114);
    write_byte(buf, 556, 47);
    write_byte(buf, 557, 108);
    write_byte(buf, 558, 105);
    write_byte(buf, 559, 98);
    write_byte(buf, 560, 47);
    write_byte(buf, 561, 108);
    write_byte(buf, 562, 105);
    write_byte(buf, 563, 98);
    write_byte(buf, 564, 83);
    write_byte(buf, 565, 121);
    write_byte(buf, 566, 115);
    write_byte(buf, 567, 116);
    write_byte(buf, 568, 101);
    write_byte(buf, 569, 109);
    write_byte(buf, 570, 46);
    write_byte(buf, 571, 66);
    write_byte(buf, 572, 46);
    write_byte(buf, 573, 100);
    write_byte(buf, 574, 121);
    write_byte(buf, 575, 108);
    write_byte(buf, 576, 105);
    write_byte(buf, 577, 98);

    # ── machine code ──
    st_set(st, 20, 0);
    st_set(st, 65, st_get(st, 8));
    when st_get(st, 20) < code_size loop
        write_byte(buf, code_off + st_get(st, 20), read_byte(st_get(st, 65), st_get(st, 20)));
        st_set(st, 20, st_get(st, 20) + 1);
    end

    # ── __LINKEDIT payload: dyld_chained_fixups header + empty string table ──
    u32_le(buf, text_seg + 0, 0);
    u32_le(buf, text_seg + 4, 28);
    u32_le(buf, text_seg + 8, 44);
    u32_le(buf, text_seg + 12, 44);
    u32_le(buf, text_seg + 16, 0);
    u32_le(buf, text_seg + 20, 1);
    u32_le(buf, text_seg + 24, 0);
    u32_le(buf, text_seg + 28, 3);

    write_bytes(path, buf, file_size);
end.

func main:
    let in_path = get_arg(1);
    let out_path = get_arg(3);
    let src = slurp_file(in_path);
    let slen = slurp_len();

    let st = alloc(512);
    st_set(st, 0, src);
    st_set(st, 1, slen);
    st_set(st, 2, 0);
    let bump = alloc(4096);
    st_set(st, 6, bump);
    st_set(st, 7, bump + 4096);
    st_set(st, 8, alloc(4096));
    st_set(st, 9, 0);
    st_set(st, 11, alloc(1024));
    st_set(st, 12, alloc(1024));
    st_set(st, 13, 0);
    st_set(st, 14, 0 - 1);
    st_set(st, 15, alloc(4096));
    st_set(st, 16, alloc(4096));
    st_set(st, 17, 0);
    st_set(st, 18, 0);
    # loc_names for parse_func — must NOT alloc() inside parse_func (Call clobbers st).
    st_set(st, 43, alloc(256));

    next_tok(st);
    emit_runtime(st);
    when st_get(st, 3) == 3 loop
        parse_func(st);
    end
    patch_calls(st);
    let ent = emit_entry(st);
    write_macho(st, out_path, ent);
    out 0;
end.
