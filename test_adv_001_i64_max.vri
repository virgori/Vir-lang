# test_adv_001: 64-bit math with large values
# Test arithmetic near i64 boundaries
# Expected: 9223372036854775806, 1, -9223372036854775807

func main:
    # 2^63 - 1 = 9223372036854775807
    # We can't write that literal directly, so build it
    var max_half = 4611686018427387903
    var x = max_half + max_half
    print x
    # x = 9223372036854775806 (2^63 - 2)

    var y = x - x + 1
    print y

    # Negate a large positive
    var z = __neg(9223372036854775807)
    print z
end.
