# Git ignore rules for Vir Compiler repository

# Build artifacts and binaries
/build/
/.build/
/dist/
core/build/
core/lib/
core/test_*
core/print_ast*
*.dSYM/
*.egg-info/
a.out
*.o
*.bin
*.dylib
*.a
*.log
bench_cpp
bench_rust
_python_archive/

# Temporary test scraps
/tmp/
/scratch/
tmp_*
tokens.txt
unix.out
two.out
var_kw.out
virc4
*.out
bench_*
vir-bench/**/bench_*
hello_out
todos.txt
test_arena.vri

# Dependency directories
node_modules/
.venv/

# Python caches
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# OS/editor metadata
.DS_Store

# Debug dumps and failed patch artifacts
*.bak
*.orig
*.rej
*.patch
*_trace.txt
*dump*.txt
*qir*.txt
*_out.txt
*_err.txt
stderr.txt
err.txt
out.txt
