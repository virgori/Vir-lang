{
  "$schema": "vscode://schemas/color-theme",
  "name": "Vir Quantum Dark",
  "type": "dark",
  "colors": {
    "editor.background": "#0B1020",
    "editor.foreground": "#E6EDF7",
    "editorLineNumber.foreground": "#475569",
    "editorLineNumber.activeForeground": "#94A3B8",
    "editor.lineHighlightBackground": "#161D33",
    "editor.selectionBackground": "#22304F",
    "editor.inactiveSelectionBackground": "#1A2640",
    "editorCursor.foreground": "#E6EDF7",
    "editorWhitespace.foreground": "#2B364E",
    "editorIndentGuide.background1": "#1F2A44",
    "editorIndentGuide.activeBackground1": "#344566",
    "editorError.foreground": "#FF5370",
    "editorWarning.foreground": "#FFB020",
    "editorInfo.foreground": "#38BDF8",
    "editorHint.foreground": "#8B9BB4",
    "editorGutter.modifiedBackground": "#38BDF8",
    "editorGutter.addedBackground": "#22C55E",
    "editorGutter.deletedBackground": "#EF4444",
    "sideBar.background": "#11172A",
    "activityBar.background": "#11172A",
    "panel.background": "#11172A",
    "statusBar.background": "#11172A",
    "statusBar.foreground": "#E6EDF7",
    "titleBar.activeBackground": "#11172A",
    "titleBar.activeForeground": "#E6EDF7"
  },
  "semanticHighlighting": true,
  "tokenColors": [
    {
      "name": "Vir Declaration Keywords",
      "scope": [
        "keyword.declaration.vri"
      ],
      "settings": {
        "foreground": "#E879F9"
      }
    },
    {
      "name": "Vir Control Keywords",
      "scope": [
        "keyword.control.vri"
      ],
      "settings": {
        "foreground": "#C792EA"
      }
    },
    {
      "name": "Vir Secondary Keywords",
      "scope": [
        "keyword.control.secondary.vri"
      ],
      "settings": {
        "foreground": "#B388FF"
      }
    },
    {
      "name": "Vir Import Export Get",
      "scope": [
        "keyword.control.import.vri"
      ],
      "settings": {
        "foreground": "#FF5D73"
      }
    },
    {
      "name": "Vir End Terminator",
      "scope": [
        "keyword.control.terminator.vri"
      ],
      "settings": {
        "foreground": "#7A4FA0",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Vir Tensor Types",
      "scope": [
        "storage.type.tensor.vri"
      ],
      "settings": {
        "foreground": "#FFD166"
      }
    },
    {
      "name": "Vir Scalar Types",
      "scope": [
        "storage.type.scalar.vri"
      ],
      "settings": {
        "foreground": "#EBCB8B"
      }
    },
    {
      "name": "Vir Function Names",
      "scope": [
        "entity.name.function.vri"
      ],
      "settings": {
        "foreground": "#82AAFF"
      }
    },
    {
      "name": "Vir Entity Names",
      "scope": [
        "entity.name.type.vri"
      ],
      "settings": {
        "foreground": "#4FC1FF"
      }
    },
    {
      "name": "Vir Parameters",
      "scope": [
        "variable.parameter.vri"
      ],
      "settings": {
        "foreground": "#F8C555"
      }
    },
    {
      "name": "Vir AI Ops",
      "scope": [
        "support.function.ai.matmul.vri",
        "support.function.ai.embed.vri",
        "support.function.ai.train.vri"
      ],
      "settings": {
        "foreground": "#00E5FF"
      }
    },
    {
      "name": "Vir Grad Op",
      "scope": [
        "support.function.ai.grad.vri"
      ],
      "settings": {
        "foreground": "#00F5A0"
      }
    },
    {
      "name": "Vir Grade S Intrinsics (SIMD/NEON/AVX)",
      "scope": [
        "support.function.intrinsic.grade-s.simd.vri",
        "support.function.intrinsic.grade-s.matmul.vri",
        "support.function.intrinsic.grade-s.kernel.vri"
      ],
      "settings": {
        "foreground": "#FF2D6F",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Vir System Ops",
      "scope": [
        "support.function.system.xor.vri",
        "support.function.system.shift.vri"
      ],
      "settings": {
        "foreground": "#F59E0B"
      }
    },
    {
      "name": "Vir Numbers",
      "scope": [
        "constant.numeric.vri",
        "constant.numeric.dimension.vri"
      ],
      "settings": {
        "foreground": "#A6E3A1"
      }
    },
    {
      "name": "Vir Strings",
      "scope": [
        "string.quoted.double.vri"
      ],
      "settings": {
        "foreground": "#F2A97F"
      }
    },
    {
      "name": "Vir Boolean Literals",
      "scope": [
        "constant.language.boolean.vri"
      ],
      "settings": {
        "foreground": "#8BD5CA"
      }
    },
    {
      "name": "Vir Operators",
      "scope": [
        "keyword.operator.vri"
      ],
      "settings": {
        "foreground": "#89DDFF"
      }
    },
    {
      "name": "Vir Power Operator",
      "scope": [
        "keyword.operator.power.vri"
      ],
      "settings": {
        "foreground": "#FF79C6"
      }
    },
    {
      "name": "Vir Cast Operator",
      "scope": [
        "keyword.operator.cast.vri"
      ],
      "settings": {
        "foreground": "#7DD3FC"
      }
    },
    {
      "name": "Vir Math Context Operator",
      "scope": [
        "keyword.operator.math-context.vri"
      ],
      "settings": {
        "foreground": "#F472B6"
      }
    },
    {
      "name": "Vir Matrix Punctuation",
      "scope": [
        "punctuation.section.matrix.vri"
      ],
      "settings": {
        "foreground": "#64748B"
      }
    },
    {
      "name": "Vir Matrix Separators",
      "scope": [
        "punctuation.separator.matrix.vri"
      ],
      "settings": {
        "foreground": "#526077"
      }
    },
    {
      "name": "Vir Shape Angle Brackets",
      "scope": [
        "punctuation.definition.typeparameters.begin.vri",
        "punctuation.definition.typeparameters.end.vri"
      ],
      "settings": {
        "foreground": "#7DD3FC"
      }
    },
    {
      "name": "Vir Metadata",
      "scope": [
        "meta.annotation.vri"
      ],
      "settings": {
        "foreground": "#38BDF8"
      }
    },
    {
      "name": "Vir Comments",
      "scope": [
        "comment.vri",
        "comment.block.vri",
        "comment.line.double-slash.vri",
        "comment.line.number-sign.vri"
      ],
      "settings": {
        "foreground": "#6B7280",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Vir Doc Comments",
      "scope": [
        "comment.block.documentation.vri"
      ],
      "settings": {
        "foreground": "#7C8DA6",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Vir TODO",
      "scope": [
        "keyword.other.todo.vri"
      ],
      "settings": {
        "foreground": "#F59E0B",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Vir FIXME",
      "scope": [
        "keyword.other.fixme.vri"
      ],
      "settings": {
        "foreground": "#EF4444",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Vir NOTE",
      "scope": [
        "keyword.other.note.vri"
      ],
      "settings": {
        "foreground": "#38BDF8",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Vir OPTIMIZE",
      "scope": [
        "keyword.other.optimize.vri",
        "keyword.other.virnn.vri"
      ],
      "settings": {
        "foreground": "#22C55E",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Vir Double-Hash Doc Comment",
      "scope": ["comment.block.doc.double-hash.vri"],
      "settings": {
        "foreground": "#38BDF8",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Vir Exported Function Names",
      "scope": ["entity.name.function.exported.vri"],
      "settings": {
        "foreground": "#FFD700",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Vir Imported Function Names",
      "scope": ["entity.name.function.imported.vri"],
      "settings": {
        "foreground": "#C8A800"
      }
    },
    {
      "name": "Vir Module Name",
      "scope": ["entity.name.module.vri"],
      "settings": {
        "foreground": "#82AAFF"
      }
    },
    {
      "name": "Vir Alias Keyword",
      "scope": ["keyword.declaration.alias.vri"],
      "settings": {
        "foreground": "#E879F9"
      }
    },
    {
      "name": "Vir Alias Names",
      "scope": ["entity.name.alias.vri"],
      "settings": {
        "foreground": "#A78BFA"
      }
    },
    {
      "name": "Vir Async Modifier",
      "scope": ["storage.modifier.async.vri"],
      "settings": {
        "foreground": "#FF6B9D",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Vir Const Keyword",
      "scope": ["keyword.declaration.const.vri"],
      "settings": {
        "foreground": "#E879F9"
      }
    },
    {
      "name": "Vir Constant Names",
      "scope": ["variable.other.constant.vri"],
      "settings": {
        "foreground": "#FFB020",
        "fontStyle": "bold"
      }
    }
  ],
  "semanticTokenColors": {
    "keyword": "#C792EA",
    "importKeyword": "#FF5D73",
    "terminatorKeyword": {
      "foreground": "#7A4FA0",
      "fontStyle": "bold"
    },
    "function": "#82AAFF",
    "type": "#FFD166",
    "number": "#A6E3A1",
    "string": "#F2A97F",
    "operator": "#89DDFF",
    "aiOp": "#00E5FF",
    "systemOp": "#F59E0B",
    "gradeSOp": "#FF2D6F",
    "tensorType": "#FFD166",
    "shape": "#22C55E"
  },
  "semanticHighlighting": true
}
