{
  "$schema": "vscode://schemas/color-theme",
  "name": "Vir Forge Dark",
  "type": "dark",
  "colors": {
    "editor.background": "#111111",
    "editor.foreground": "#E5E5E5",
    "editor.lineHighlightBackground": "#1B1B1B",
    "editor.selectionBackground": "#2D2D2D",
    "editorError.foreground": "#FF5370",
    "editorWarning.foreground": "#FFB020",
    "editorInfo.foreground": "#61AFEF",
    "sideBar.background": "#161616",
    "panel.background": "#161616",
    "activityBar.background": "#161616",
    "statusBar.background": "#161616",
    "statusBar.foreground": "#E5E5E5"
  },
  "semanticHighlighting": true,
  "tokenColors": [
    {
      "scope": "keyword.declaration.vri",
      "settings": { "foreground": "#D19A66" }
    },
    {
      "scope": ["keyword.control.vri", "keyword.control.secondary.vri"],
      "settings": { "foreground": "#C586C0" }
    },
    {
      "scope": "keyword.control.import.vri",
      "settings": { "foreground": "#E06C75" }
    },
    {
      "scope": "keyword.control.terminator.vri",
      "settings": { "foreground": "#8E5FA8", "fontStyle": "bold" }
    },
    {
      "scope": "entity.name.function.vri",
      "settings": { "foreground": "#61AFEF" }
    },
    {
      "scope": "entity.name.type.vri",
      "settings": { "foreground": "#56B6C2" }
    },
    {
      "scope": ["storage.type.tensor.vri", "storage.type.scalar.vri"],
      "settings": { "foreground": "#E5C07B" }
    },
    {
      "scope": ["support.function.ai.matmul.vri", "support.function.ai.embed.vri", "support.function.ai.train.vri"],
      "settings": { "foreground": "#61AFEF" }
    },
    {
      "scope": "support.function.ai.grad.vri",
      "settings": { "foreground": "#98C379" }
    },
    {
      "scope": ["support.function.intrinsic.grade-s.simd.vri", "support.function.intrinsic.grade-s.matmul.vri", "support.function.intrinsic.grade-s.kernel.vri"],
      "settings": { "foreground": "#FF2D6F", "fontStyle": "bold" }
    },
    {
      "scope": ["support.function.system.xor.vri", "support.function.system.shift.vri"],
      "settings": { "foreground": "#E06C75" }
    },
    {
      "scope": "constant.numeric.vri",
      "settings": { "foreground": "#98C379" }
    },
    {
      "scope": "string.quoted.double.vri",
      "settings": { "foreground": "#D19A66" }
    },
    {
      "scope": "keyword.operator.vri",
      "settings": { "foreground": "#ABB2BF" }
    },
    {
      "scope": ["keyword.operator.power.vri", "keyword.operator.math-context.vri", "keyword.operator.cast.vri"],
      "settings": { "foreground": "#C678DD" }
    },
    {
      "scope": ["comment.block.vri", "comment.line.double-slash.vri", "comment.line.number-sign.vri"],
      "settings": { "foreground": "#5C6370", "fontStyle": "italic" }
    },
    {
      "scope": "comment.block.doc.double-hash.vri",
      "settings": { "foreground": "#61AFEF", "fontStyle": "italic" }
    },
    {
      "scope": "entity.name.function.exported.vri",
      "settings": { "foreground": "#E5C07B", "fontStyle": "bold" }
    },
    {
      "scope": "entity.name.function.imported.vri",
      "settings": { "foreground": "#B8973B" }
    },
    {
      "scope": "entity.name.module.vri",
      "settings": { "foreground": "#61AFEF" }
    },
    {
      "scope": ["keyword.declaration.alias.vri", "keyword.declaration.const.vri"],
      "settings": { "foreground": "#D19A66" }
    },
    {
      "scope": "entity.name.alias.vri",
      "settings": { "foreground": "#ABB2BF" }
    },
    {
      "scope": "storage.modifier.async.vri",
      "settings": { "foreground": "#C678DD", "fontStyle": "bold" }
    },
    {
      "scope": "variable.other.constant.vri",
      "settings": { "foreground": "#E06C75", "fontStyle": "bold" }
    }
  ],
  "semanticTokenColors": {
    "keyword": "#C586C0",
    "importKeyword": "#E06C75",
    "terminatorKeyword": {
      "foreground": "#8E5FA8",
      "fontStyle": "bold"
    },
    "function": "#61AFEF",
    "type": "#E5C07B",
    "number": "#98C379",
    "string": "#D19A66",
    "operator": "#ABB2BF",
    "aiOp": "#61AFEF",
    "systemOp": "#E06C75",
    "tensorType": "#E5C07B",
    "shape": "#98C379"
  }
}
