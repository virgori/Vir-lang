# Test Float Arithmetic
var f1 = 1.5;
var f2 = 2.7;
var f3 = f1 + f2;
print f3;  # Expected: 4.2

# Test Map Literal
var m = map
    "name": "Vir v1.2";
    "version": 1.2;
    "status": "awesome";
end;
print m;

# Test Entity Definition & Instantiation
entity Person:
    name: string;
    age: int;
end

var p = Person:
    name: "Alex";
    age: 30;
end

print p.name;
print p.age;

# Test Math Functions
var s = sin(1.0);
print s;

# Test Try/Catch (Error Handling)
try
    print "Doing something risky...";
    # Q_THROW isn't exposed as a keyword yet, but we can test fallback
fallback
    print "Caught an error!";
end

print "Test complete.";
