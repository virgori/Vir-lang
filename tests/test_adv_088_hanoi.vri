# test_adv_088: Tower of Hanoi
# Expected: 7

var move_count = 0

func hanoi:
    in(n, src, dst, aux)
    if n == 0 do
        out 0
    end
    hanoi(n - 1, src, aux, dst)
    move_count = move_count + 1
    hanoi(n - 1, aux, dst, src)
end.
func main:
    hanoi(3, 1, 3, 2)
    print move_count
end.
