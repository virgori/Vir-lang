# test_adv_007: Popcount / CLZ / CTZ edge cases
# Expected: 64, 1, 64, 0, 1, 64

func main:
    # CLZ(0) = 64 (all zeros in 64-bit)
    var r1 = __clz(0)
    print r1

    # CLZ with MSB set: very large number
    # Use shift to set high bit
    var big = 1 shl 62
    var r2 = __clz(big)
    print r2

    # CTZ(0) = 64
    var r3 = __ctz(0)
    print r3

    # POPCNT(0) = 0
    var r4 = __popcnt(0)
    print r4

    # POPCNT(1) = 1
    var r5 = __popcnt(1)
    print r5

    # POPCNT(0xFFFFFFFFFFFFFFFF) = 64
    # Build it: -1 in 2's complement = all ones
    var all_ones = __not(0)
    var r6 = __popcnt(all_ones)
    print r6
end.