# test_adv_011: Memory - write and read at various offsets
# Expected: 100, 200, 300

func main:
    var ptr = alloc(64)
    write_word(ptr, 0, 100)
    write_word(ptr, 8, 200)
    write_word(ptr, 16, 300)
    var a = read_word(ptr, 0)
    var b = read_word(ptr, 8)
    var c = read_word(ptr, 16)
    print a
    print b
    print c
end.