# ═════════════════════════════════════════════════════════════════════
# tests/opt/tail_call_test.vri — Native LIR Tail-Call Optimization Verification
# Governed by VIRC-ISS-0024 / VIRC-ISS-0035 / VIRC-ISS-0053 /
# VIRC-PLN-0014 / VIRC-RPT-0030 / VIRC-SPC-0008 / VIRC-ISS-0050
# ═════════════════════════════════════════════════════════════════════

extern func syscall0(num: int) -> int
extern func syscall1(num: int, a0: int) -> int
extern func syscall2(num: int, a0: int, a1: int) -> int
extern func syscall3(num: int, a0: int, a1: int, a2: int) -> int
extern func syscall4(num: int, a0: int, a1: int, a2: int, a3: int) -> int
extern func syscall5(num: int, a0: int, a1: int, a2: int, a3: int, a4: int) -> int
extern func vir_get_platform() -> int
extern func usleep(usec: int) -> int
extern func kill(pid: int, sig: int) -> int
extern func exit_prog(code: int)

func s_strlen(s: int) -> int:
    if s == 0 do out 0 end
    var i = 0
    when read_byte(s, i) != 0 loop
        i = i + 1
    end
    out i
end.

func s_streq(a: int, b: int) -> int:
    if a == 0 and b == 0 do out 1 end
    if a == 0 or b == 0 do out 0 end
    let la = s_strlen(a)
    let lb = s_strlen(b)
    if la != lb do out 0 end
    var i = 0
    when i < la loop
        if read_byte(a, i) != read_byte(b, i) do out 0 end
        i = i + 1
    end
    out 1
end.

func s_concat2(a: int, b: int) -> int:
    let la = s_strlen(a)
    let lb = s_strlen(b)
    let res = alloc(la + lb + 1)
    var idx = 0
    var i = 0
    when i < la loop
        write_byte(res, idx, read_byte(a, i))
        idx = idx + 1
        i = i + 1
    end
    i = 0
    when i < lb loop
        write_byte(res, idx, read_byte(b, i))
        idx = idx + 1
        i = i + 1
    end
    write_byte(res, idx, 0)
    out res
end.

func s_find_str(haystack: int, needle: int) -> int:
    let hlen = s_strlen(haystack)
    let nlen = s_strlen(needle)
    if nlen == 0 do out 0 end
    if hlen < nlen do out -1 end
    var i = 0
    let limit = hlen - nlen
    when i <= limit loop
        var match = 1
        var j = 0
        when j < nlen loop
            if read_byte(haystack, i + j) != read_byte(needle, j) do
                match = 0
                j = nlen
            else
                j = j + 1
            end
        end
        if match == 1 do out i end
        i = i + 1
    end
    out -1
end.

func s_find_str_from(haystack: int, needle: int, from_pos: int) -> int:
    let hlen = s_strlen(haystack)
    let nlen = s_strlen(needle)
    if nlen == 0 do out from_pos end
    if hlen < nlen or from_pos > hlen - nlen do out -1 end
    var i = from_pos
    let limit = hlen - nlen
    when i <= limit loop
        var match = 1
        var j = 0
        when j < nlen loop
            if read_byte(haystack, i + j) != read_byte(needle, j) do
                match = 0
                j = nlen
            else
                j = j + 1
            end
        end
        if match == 1 do out i end
        i = i + 1
    end
    out -1
end.

func s_slice(s: int, start: int, len: int) -> int:
    if s == 0 or len <= 0 do
        let empty = alloc(1)
        write_byte(empty, 0, 0)
        out empty
    end
    let res = alloc(len + 1)
    var i = 0
    when i < len loop
        write_byte(res, i, read_byte(s, start + i))
        i = i + 1
    end
    write_byte(res, len, 0)
    out res
end.

func s_int_to_str(n: int) -> int:
    if n == 0 do
        let r = alloc(2)
        write_byte(r, 0, 48)
        write_byte(r, 1, 0)
        out r
    end
    var v = n
    var is_neg = 0
    if v < 0 do
        is_neg = 1
        v = 0 - v
    end
    let digits = alloc(32)
    var dlen = 0
    when v > 0 loop
        write_byte(digits, dlen, 48 + (v mod 10))
        v = v / 10
        dlen = dlen + 1
    end
    let res = alloc(dlen + is_neg + 1)
    var ri = 0
    if is_neg == 1 do
        write_byte(res, ri, 45)
        ri = ri + 1
    end
    var i = dlen - 1
    when i >= 0 loop
        write_byte(res, ri, read_byte(digits, i))
        ri = ri + 1
        i = i - 1
    end
    write_byte(res, ri, 0)
    out res
end.

func s_print(s: int):
    let len = s_strlen(s)
    if len > 0 do
        let plat = vir_get_platform()
        if plat == 2 or plat == 3 or plat == 4 do
            syscall3(1, 1, s, len)
        else
            syscall3(0x2000004, 1, s, len)
        end
    end
end.

func s_println(s: int):
    s_print(s)
    s_print("\n" as int)
end.

func sys_getpid() -> int:
    let plat = vir_get_platform()
    if plat == 2 or plat == 4 do out syscall0(172) end
    if plat == 3 do out syscall0(39) end
    out syscall0(0x2000014)
end.

func sys_fork() -> int:
    let plat = vir_get_platform()
    if plat == 2 or plat == 4 do out syscall5(220, 17, 0, 0, 0, 0) end
    if plat == 3 do out syscall0(57) end
    out syscall0(0x2000002)
end.

func sys_dup2(old_fd: int, new_fd: int) -> int:
    let plat = vir_get_platform()
    if plat == 2 or plat == 4 do out syscall3(24, old_fd, new_fd, 0) end
    if plat == 3 do out syscall2(33, old_fd, new_fd) end
    out syscall2(0x200005A, old_fd, new_fd)
end.

func sys_open_write(path: int) -> int:
    let plat = vir_get_platform()
    if plat == 2 or plat == 4 do out syscall4(56, -100, path, 577, 420) end
    if plat == 3 do out syscall3(2, path, 577, 420) end
    out syscall3(0x2000005, path, 0x0601, 420)
end.

func sys_close(fd: int) -> int:
    let plat = vir_get_platform()
    if plat == 2 or plat == 3 or plat == 4 do out syscall1(3, fd) end
    out syscall1(0x2000006, fd)
end.

func sys_wait4(pid: int, status_ptr: int, options: int) -> int:
    let plat = vir_get_platform()
    if plat == 2 or plat == 4 do out syscall4(260, pid, status_ptr, options, 0) end
    if plat == 3 do out syscall4(61, pid, status_ptr, options, 0) end
    out syscall4(0x2000007, pid, status_ptr, options, 0)
end.

func sys_execve(path: int, argv: int, envp: int) -> int:
    let plat = vir_get_platform()
    if plat == 2 or plat == 4 do out syscall3(221, path, argv, envp) end
    if plat == 3 do out syscall3(59, path, argv, envp) end
    out syscall3(0x200003B, path, argv, envp)
end.

func sys_unlink(path: int) -> int:
    let plat = vir_get_platform()
    if plat == 2 or plat == 4 do out syscall3(35, -100, path, 0) end
    if plat == 3 do out syscall1(87, path) end
    out syscall1(0x200000A, path)
end.

func sys_read_file(path: int) -> int:
    let plat = vir_get_platform()
    var fd = -1
    if plat == 2 or plat == 4 do
        fd = syscall4(56, -100, path, 0, 0)
    eif plat == 3 do
        fd = syscall3(2, path, 0, 0)
    else
        fd = syscall3(0x2000005, path, 0, 0)
    end
    if fd < 0 do out 0 end

    let cap = 524288 # 512KB
    let buf = alloc(cap)
    var total = 0
    if plat == 2 or plat == 3 or plat == 4 do
        total = syscall3(0, fd, buf, cap - 1)
    else
        total = syscall3(0x2000003, fd, buf, cap - 1)
    end
    sys_close(fd)
    if total <= 0 do out 0 end
    write_byte(buf, total, 0)
    out buf
end.

func sys_trim(s: int) -> int:
    let len = s_strlen(s)
    if len == 0 do
        let empty = alloc(1)
        write_byte(empty, 0, 0)
        out empty
    end
    var start = 0
    when start < len and (read_byte(s, start) == 32 or read_byte(s, start) == 9 or read_byte(s, start) == 13 or read_byte(s, start) == 10) loop
        start = start + 1
    end
    var end_pos = len
    when end_pos > start and (read_byte(s, end_pos - 1) == 32 or read_byte(s, end_pos - 1) == 9 or read_byte(s, end_pos - 1) == 13 or read_byte(s, end_pos - 1) == 10) loop
        end_pos = end_pos - 1
    end
    let tlen = end_pos - start
    if tlen <= 0 do
        let empty = alloc(1)
        write_byte(empty, 0, 0)
        out empty
    end
    let res = alloc(tlen + 1)
    var i = 0
    when i < tlen loop
        write_byte(res, i, read_byte(s, start + i))
        i = i + 1
    end
    write_byte(res, tlen, 0)
    out res
end.

func run_cmd_captured(cmd_argv: int, out_file: int) -> int:
    let my_pid = sys_getpid()
    let child_pid = sys_fork()
    let cur_pid = sys_getpid()

    if cur_pid != my_pid or child_pid == 0 do
        if s_strlen(out_file) > 0 do
            let out_fd = sys_open_write(out_file)
            if out_fd >= 0 do
                sys_dup2(out_fd, 1)
                sys_dup2(out_fd, 2)
                sys_close(out_fd)
            end
        end

        let bin_prog = native_read_i64(cmd_argv, 0)
        let envp = alloc(32)
        native_write_i64(envp, 0, "VIRC_UI=classic" as int)
        native_write_i64(envp, 8, "NO_COLOR=1" as int)
        native_write_i64(envp, 16, 0)

        sys_execve(bin_prog, cmd_argv, envp)
        exit_prog(127)
    end

    let st = alloc(8)
    var ticks = 0
    when ticks < 3000 loop
        let wpid = sys_wait4(child_pid, st, 1)
        if wpid == child_pid do
            let raw_status = native_read_i64(st, 0)
            let term_signal = raw_status and 127
            if term_signal != 0 do
                out 128 + term_signal
            end
            out (raw_status shr 8) and 255
        end
        usleep(10000)
        ticks = ticks + 1
    end
    kill(child_pid, 9)
    sys_wait4(child_pid, st, 0)
    out -999
end.

func run_vir_status:
    in
        virc_bin: int
        fixture: int
        opt: int
        tmp_bin: int
        tmp_out: int

    sys_unlink(tmp_bin)
    sys_unlink(tmp_out)

    let argv_comp = alloc(64)
    native_write_i64(argv_comp, 0, virc_bin)
    native_write_i64(argv_comp, 8, fixture)
    native_write_i64(argv_comp, 16, opt)
    native_write_i64(argv_comp, 24, "-o" as int)
    native_write_i64(argv_comp, 32, tmp_bin)
    native_write_i64(argv_comp, 40, "-q" as int)
    native_write_i64(argv_comp, 48, 0)

    let rc_comp = run_cmd_captured(argv_comp, 0)
    if rc_comp != 0 do out -1000 end

    let argv_run = alloc(16)
    native_write_i64(argv_run, 0, tmp_bin)
    native_write_i64(argv_run, 8, 0)
    out run_cmd_captured(argv_run, tmp_out)
end.

func run_vir_status_ulimit:
    in
        virc_bin: int
        fixture: int
        opt: int
        tmp_bin: int
        tmp_out: int
        ulimit_kb: int

    sys_unlink(tmp_bin)
    sys_unlink(tmp_out)

    let argv_comp = alloc(64)
    native_write_i64(argv_comp, 0, virc_bin)
    native_write_i64(argv_comp, 8, fixture)
    native_write_i64(argv_comp, 16, opt)
    native_write_i64(argv_comp, 24, "-o" as int)
    native_write_i64(argv_comp, 32, tmp_bin)
    native_write_i64(argv_comp, 40, "-q" as int)
    native_write_i64(argv_comp, 48, 0)

    let rc_comp = run_cmd_captured(argv_comp, 0)
    if rc_comp != 0 do out -1000 end

    let cmd_str = s_concat2("ulimit -s " as int, s_concat2(s_int_to_str(ulimit_kb), s_concat2("; " as int, tmp_bin)))
    let argv_sh = alloc(32)
    native_write_i64(argv_sh, 0, "/bin/sh" as int)
    native_write_i64(argv_sh, 8, "-c" as int)
    native_write_i64(argv_sh, 16, cmd_str)
    native_write_i64(argv_sh, 24, 0)
    out run_cmd_captured(argv_sh, tmp_out)
end.

func has_stack_overflow_diagnostic(output: int) -> int:
    if output == 0 do out 0 end
    if s_find_str(output, "stack overflow" as int) >= 0 do out 1 end
    if s_find_str(output, "Stack overflow" as int) >= 0 do out 1 end
    if s_find_str(output, "StackOverflow" as int) >= 0 do out 1 end
    if s_find_str(output, "call-stack exhaustion" as int) >= 0 do out 1 end
    out 0
end.

func run_vir_exec(virc_bin: int, fixture: int, opt: int, tmp_bin: int, tmp_out: int) -> int:
    sys_unlink(tmp_bin)
    sys_unlink(tmp_out)

    let argv_comp = alloc(64)
    native_write_i64(argv_comp, 0, virc_bin)
    native_write_i64(argv_comp, 8, fixture)
    native_write_i64(argv_comp, 16, opt)
    native_write_i64(argv_comp, 24, "-o" as int)
    native_write_i64(argv_comp, 32, tmp_bin)
    native_write_i64(argv_comp, 40, "-q" as int)
    native_write_i64(argv_comp, 48, 0)

    let rc_comp = run_cmd_captured(argv_comp, 0)
    if rc_comp != 0 do out 0 end

    let argv_run = alloc(16)
    native_write_i64(argv_run, 0, tmp_bin)
    native_write_i64(argv_run, 8, 0)
    let rc_run = run_cmd_captured(argv_run, tmp_out)
    if rc_run != 0 do out 0 end

    let out_data = sys_read_file(tmp_out)
    out sys_trim(out_data)
end.

func run_vir_asm(virc_bin: int, fixture: int, opt: int, target: int, tmp_asm: int) -> int:
    sys_unlink(tmp_asm)

    let argv_asm = alloc(80)
    native_write_i64(argv_asm, 0, virc_bin)
    native_write_i64(argv_asm, 8, fixture)
    native_write_i64(argv_asm, 16, opt)
    native_write_i64(argv_asm, 24, "-S" as int)
    native_write_i64(argv_asm, 32, "-o" as int)
    native_write_i64(argv_asm, 40, tmp_asm)
    var argc_idx = 48
    if s_strlen(target) > 0 do
        native_write_i64(argv_asm, argc_idx, "--target" as int)
        native_write_i64(argv_asm, argc_idx + 8, target)
        argc_idx = argc_idx + 16
    end
    native_write_i64(argv_asm, argc_idx, "-q" as int)
    native_write_i64(argv_asm, argc_idx + 8, 0)

    let rc_comp = run_cmd_captured(argv_asm, 0)
    if rc_comp != 0 do out 0 end

    out sys_read_file(tmp_asm)
end.

func extract_func_body(asm_text: int, func_name: int) -> int:
    if asm_text == 0 or func_name == 0 do out 0 end
    let label_macho = s_concat2(s_concat2("_" as int, func_name), ":" as int)
    let label_elf = s_concat2(func_name, ":" as int)

    var p = s_find_str(asm_text, label_macho)
    if p < 0 do
        p = s_find_str(asm_text, label_elf)
    end
    if p < 0 do out 0 end

    # Find the end of this function body: next .globl or next function label
    let p_next = s_find_str_from(asm_text, ".globl " as int, p + 16)
    var end_pos = s_strlen(asm_text)
    if p_next > p do
        end_pos = p_next
    end

    out s_slice(asm_text, p, end_pos - p)
end.

func count_substr(haystack: int, needle: int) -> int:
    if haystack == 0 or needle == 0 do out 0 end
    var cnt = 0
    var pos = s_find_str(haystack, needle)
    let nlen = s_strlen(needle)
    when pos >= 0 loop
        cnt = cnt + 1
        pos = s_find_str_from(haystack, needle, pos + nlen)
    end
    out cnt
end.

func main:
    var virc_bin = "bin/virc" as int
    let argc = arg_count()
    var i = 1
    when i < argc loop
        let arg = get_arg(i) as int
        if s_streq(arg, "--virc" as int) == 1 and i + 1 < argc do
            virc_bin = get_arg(i + 1) as int
            i = i + 1
        end
        i = i + 1
    end

    s_println("=== Running Native LIR Tail-Call Optimization Verification (VIRC-ISS-0024) ===" as int)

    let pid = sys_getpid()
    let tmp_bin = s_concat2("scratch/.tmp_tco_bin_" as int, s_int_to_str(pid))
    let tmp_out = s_concat2("scratch/.tmp_tco_out_" as int, s_int_to_str(pid))
    let tmp_asm = s_concat2("scratch/.tmp_tco_asm_" as int, s_int_to_str(pid))

    var all_ok = 1

    # ── Test 1: Direct self-recursion 1M iterations in O(1) stack space across -O1..-O3 ──
    var t1_ok = 1
    var opt_i = 1
    when opt_i <= 3 loop
        let opt_flag = s_concat2("-O" as int, s_int_to_str(opt_i))
        let out_v = run_vir_exec(virc_bin, "tests/opt/fixtures/tco_countdown_1m.vri" as int, opt_flag, tmp_bin, tmp_out)
        if s_streq(out_v, "0" as int) == 0 do t1_ok = 0 end

        let asm_text = run_vir_asm(virc_bin, "tests/opt/fixtures/tco_countdown_1m.vri" as int, opt_flag, "" as int, tmp_asm)
        let body = extract_func_body(asm_text, "countdown" as int)
        if body == 0 do
            t1_ok = 0
        else
            let bl_cnt = count_substr(body, "bl _countdown" as int) + count_substr(body, "bl countdown" as int)
            if bl_cnt > 0 do t1_ok = 0 end
            if s_find_str(body, "b LBB_" as int) < 0 and s_find_str(body, "b .LBB_" as int) < 0 do t1_ok = 0 end
        end
        opt_i = opt_i + 1
    end
    if t1_ok == 1 do
        s_println("  [PASS] test_01_direct_recursion_1m_stack_bounded" as int)
    else
        s_println("  [FAIL] test_01_direct_recursion_1m_stack_bounded" as int)
        all_ok = 0
    end

    # ── Test 2: Argument permutation GCD across -O1..-O3 ──
    var t2_ok = 1
    opt_i = 1
    when opt_i <= 3 loop
        let opt_flag = s_concat2("-O" as int, s_int_to_str(opt_i))
        let out_v = run_vir_exec(virc_bin, "tests/opt/fixtures/tco_gcd.vri" as int, opt_flag, tmp_bin, tmp_out)
        if s_streq(out_v, "21" as int) == 0 do t2_ok = 0 end

        let asm_text = run_vir_asm(virc_bin, "tests/opt/fixtures/tco_gcd.vri" as int, opt_flag, "" as int, tmp_asm)
        let body = extract_func_body(asm_text, "gcd" as int)
        if body == 0 do
            t2_ok = 0
        else
            let bl_cnt = count_substr(body, "bl _gcd" as int) + count_substr(body, "bl gcd" as int)
            if bl_cnt > 0 do t2_ok = 0 end
            if s_find_str(body, "b LBB_" as int) < 0 and s_find_str(body, "b .LBB_" as int) < 0 do t2_ok = 0 end
        end
        opt_i = opt_i + 1
    end
    if t2_ok == 1 do
        s_println("  [PASS] test_02_argument_permutation_gcd" as int)
    else
        s_println("  [FAIL] test_02_argument_permutation_gcd" as int)
        all_ok = 0
    end

    # ── Test 3: Stack arguments >8 updated before direct branch across -O1..-O3 ──
    var t3_ok = 1
    opt_i = 1
    when opt_i <= 3 loop
        let opt_flag = s_concat2("-O" as int, s_int_to_str(opt_i))
        let out_v = run_vir_exec(virc_bin, "tests/opt/fixtures/tco_sum9.vri" as int, opt_flag, tmp_bin, tmp_out)
        if s_streq(out_v, "10000" as int) == 0 do t3_ok = 0 end

        let asm_text = run_vir_asm(virc_bin, "tests/opt/fixtures/tco_sum9.vri" as int, opt_flag, "" as int, tmp_asm)
        let body = extract_func_body(asm_text, "sum9" as int)
        if body == 0 do
            t3_ok = 0
        else
            let bl_cnt = count_substr(body, "bl _sum9" as int) + count_substr(body, "bl sum9" as int)
            if bl_cnt > 0 do t3_ok = 0 end
            if s_find_str(body, "[fp, #16]" as int) < 0 and s_find_str(body, "qword ptr [rbp + 16]" as int) < 0 do t3_ok = 0 end
        end
        opt_i = opt_i + 1
    end
    if t3_ok == 1 do
        s_println("  [PASS] test_03_stack_arguments_greater_than_8" as int)
    else
        s_println("  [FAIL] test_03_stack_arguments_greater_than_8" as int)
        all_ok = 0
    end

    # ── Test 4: Negative non-tail call preserved with linked bl across -O1..-O3 ──
    var t4_ok = 1
    opt_i = 1
    when opt_i <= 3 loop
        let opt_flag = s_concat2("-O" as int, s_int_to_str(opt_i))
        let out_v = run_vir_exec(virc_bin, "tests/opt/fixtures/tco_nontail.vri" as int, opt_flag, tmp_bin, tmp_out)
        if s_streq(out_v, "10" as int) == 0 do t4_ok = 0 end

        let asm_text = run_vir_asm(virc_bin, "tests/opt/fixtures/tco_nontail.vri" as int, opt_flag, "" as int, tmp_asm)
        let body = extract_func_body(asm_text, "countdown" as int)
        if body == 0 do
            t4_ok = 0
        else
            let has_bl = s_find_str(body, "bl _countdown" as int) >= 0 or s_find_str(body, "bl countdown" as int) >= 0
            if has_bl == 0 do t4_ok = 0 end
            if s_find_str(body, "b LBB_1_0" as int) >= 0 or s_find_str(body, "b .LBB_1_0" as int) >= 0 do t4_ok = 0 end
        end
        opt_i = opt_i + 1
    end
    if t4_ok == 1 do
        s_println("  [PASS] test_04_negative_non_tail_call_preserved" as int)
    else
        s_println("  [FAIL] test_04_negative_non_tail_call_preserved" as int)
        all_ok = 0
    end

    # ── Test 5: Negative pending ensure cleanup preserved with linked bl across -O1..-O3 ──
    var t5_ok = 1
    opt_i = 1
    when opt_i <= 3 loop
        let opt_flag = s_concat2("-O" as int, s_int_to_str(opt_i))
        let out_v = run_vir_exec(virc_bin, "tests/opt/fixtures/tco_cleanup_ensure.vri" as int, opt_flag, tmp_bin, tmp_out)
        if s_streq(out_v, "0" as int) == 0 do t5_ok = 0 end

        let asm_text = run_vir_asm(virc_bin, "tests/opt/fixtures/tco_cleanup_ensure.vri" as int, opt_flag, "" as int, tmp_asm)
        let body = extract_func_body(asm_text, "countdown_cleanup" as int)
        if body == 0 do
            t5_ok = 0
        else
            let has_bl = s_find_str(body, "bl _countdown_cleanup" as int) >= 0 or s_find_str(body, "bl countdown_cleanup" as int) >= 0
            if has_bl == 0 do t5_ok = 0 end
            if s_find_str(body, "b LBB_1_0" as int) >= 0 or s_find_str(body, "b .LBB_1_0" as int) >= 0 do t5_ok = 0 end
        end
        opt_i = opt_i + 1
    end
    if t5_ok == 1 do
        s_println("  [PASS] test_05_negative_pending_cleanup_preserved" as int)
    else
        s_println("  [FAIL] test_05_negative_pending_cleanup_preserved" as int)
        all_ok = 0
    end

    # ── Test 6: Backend Pass 11 (TCO) trace in --json at -O1..-O3 and absent at -O0 ──
    var t6_ok = 1
    sys_unlink(tmp_out)
    let argv_j0 = alloc(48)
    native_write_i64(argv_j0, 0, virc_bin)
    native_write_i64(argv_j0, 8, "tests/test_adv_023_tailcall.vri" as int)
    native_write_i64(argv_j0, 16, "-O0" as int)
    native_write_i64(argv_j0, 24, "--json" as int)
    native_write_i64(argv_j0, 32, "-q" as int)
    native_write_i64(argv_j0, 40, 0)
    let rc_j0 = run_cmd_captured(argv_j0, tmp_out)
    let json_o0 = sys_read_file(tmp_out)
    let p_pass0 = s_find_str(json_o0, "\"passInvocations\"" as int)
    let p_end0 = s_find_str_from(json_o0, "]" as int, p_pass0)
    let slice0 = s_slice(json_o0, p_pass0, p_end0 - p_pass0 + 1)
    if rc_j0 != 0 or s_find_str(slice0, "11" as int) >= 0 do
        t6_ok = 0
    end

    opt_i = 1
    when opt_i <= 3 loop
        let opt_flag = s_concat2("-O" as int, s_int_to_str(opt_i))
        sys_unlink(tmp_out)
        let argv_ji = alloc(48)
        native_write_i64(argv_ji, 0, virc_bin)
        native_write_i64(argv_ji, 8, "tests/test_adv_023_tailcall.vri" as int)
        native_write_i64(argv_ji, 16, opt_flag)
        native_write_i64(argv_ji, 24, "--json" as int)
        native_write_i64(argv_ji, 32, "-q" as int)
        native_write_i64(argv_ji, 40, 0)
        let rc_ji = run_cmd_captured(argv_ji, tmp_out)
        let json_oi = sys_read_file(tmp_out)
        let p_passi = s_find_str(json_oi, "\"passInvocations\"" as int)
        let p_endi = s_find_str_from(json_oi, "]" as int, p_passi)
        let slicei = s_slice(json_oi, p_passi, p_endi - p_passi + 1)
        if rc_ji != 0 or s_find_str(slicei, "11" as int) < 0 do
            t6_ok = 0
        end
        opt_i = opt_i + 1
    end
    if t6_ok == 1 do
        s_println("  [PASS] test_06_opt_trace_pass_11_json" as int)
    else
        s_println("  [FAIL] test_06_opt_trace_pass_11_json" as int)
        all_ok = 0
    end

    # ── Test 7: Register spills runtime across -O1..-O3 ──
    var t7_ok = 1
    opt_i = 1
    when opt_i <= 3 loop
        let opt_flag = s_concat2("-O" as int, s_int_to_str(opt_i))
        let out_v = run_vir_exec(virc_bin, "tests/opt/fixtures/tco_spills.vri" as int, opt_flag, tmp_bin, tmp_out)
        if s_streq(out_v, "46876" as int) == 0 do t7_ok = 0 end

        let asm_text = run_vir_asm(virc_bin, "tests/opt/fixtures/tco_spills.vri" as int, opt_flag, "" as int, tmp_asm)
        let body = extract_func_body(asm_text, "spill_tail" as int)
        if body == 0 do
            t7_ok = 0
        else
            let bl_cnt = count_substr(body, "bl _spill_tail" as int) + count_substr(body, "bl spill_tail" as int)
            if bl_cnt > 0 do t7_ok = 0 end
            if s_find_str(body, "b LBB_" as int) < 0 and s_find_str(body, "b .LBB_" as int) < 0 do t7_ok = 0 end
        end
        opt_i = opt_i + 1
    end
    if t7_ok == 1 do
        s_println("  [PASS] test_07_register_spills_runtime" as int)
    else
        s_println("  [FAIL] test_07_register_spills_runtime" as int)
        all_ok = 0
    end

    # ── Test 8: Error propagation runtime across -O1..-O3 ──
    var t8_ok = 1
    opt_i = 1
    when opt_i <= 3 loop
        let opt_flag = s_concat2("-O" as int, s_int_to_str(opt_i))
        let out_v = run_vir_exec(virc_bin, "tests/opt/fixtures/tco_error.vri" as int, opt_flag, tmp_bin, tmp_out)
        if s_streq(out_v, "42" as int) == 0 do t8_ok = 0 end
        opt_i = opt_i + 1
    end
    if t8_ok == 1 do
        s_println("  [PASS] test_08_error_propagation_runtime" as int)
    else
        s_println("  [FAIL] test_08_error_propagation_runtime" as int)
        all_ok = 0
    end

    # ── Test 9: x86-64 stack args assembly across -O1..-O3 ──
    var t9_ok = 1
    opt_i = 1
    when opt_i <= 3 loop
        let opt_flag = s_concat2("-O" as int, s_int_to_str(opt_i))
        let asm_text = run_vir_asm(virc_bin, "tests/opt/fixtures/tco_sum9.vri" as int, opt_flag, "linux-x86_64" as int, tmp_asm)
        let body = extract_func_body(asm_text, "sum9" as int)
        if body == 0 do
            t9_ok = 0
        else
            if s_find_str(body, "qword ptr [rbp + 16]" as int) < 0 do t9_ok = 0 end
            if s_find_str(body, "qword ptr [rbp + 24]" as int) < 0 do t9_ok = 0 end
            if s_find_str(body, "qword ptr [rbp + 32]" as int) < 0 do t9_ok = 0 end
            if s_find_str(body, "jmp .LBB_" as int) < 0 do t9_ok = 0 end
            if s_find_str(body, "call sum9" as int) >= 0 do t9_ok = 0 end
        end
        opt_i = opt_i + 1
    end
    if t9_ok == 1 do
        s_println("  [PASS] test_09_x86_64_stack_args_assembly" as int)
    else
        s_println("  [FAIL] test_09_x86_64_stack_args_assembly" as int)
        all_ok = 0
    end

    # ── Test 10: 10M-step arena TCO with watermark restore before branch at -O1..-O3 ──
    var t10_ok = 1
    opt_i = 1
    when opt_i <= 3 loop
        let opt_flag = s_concat2("-O" as int, s_int_to_str(opt_i))
        let out_v = run_vir_exec(virc_bin, "tests/opt/fixtures/tco_arena.vri" as int, opt_flag, tmp_bin, tmp_out)
        if s_streq(out_v, "660305" as int) == 0 do t10_ok = 0 end

        let asm_text = run_vir_asm(virc_bin, "tests/opt/fixtures/tco_arena.vri" as int, opt_flag, "" as int, tmp_asm)
        let body = extract_func_body(asm_text, "arena_tail_step" as int)
        if body == 0 do
            t10_ok = 0
        else
            let reset_pos = s_find_str(body, "[x28]" as int)
            var branch_pos = s_find_str(body, "b LBB_1_0" as int)
            if branch_pos < 0 do branch_pos = s_find_str(body, "b .LBB_1_0" as int) end
            if branch_pos < 0 do branch_pos = s_find_str(body, "b LBB_0_0" as int) end
            if branch_pos < 0 do branch_pos = s_find_str(body, "b .LBB_0_0" as int) end
            if reset_pos < 0 or branch_pos < 0 or reset_pos > branch_pos do t10_ok = 0 end
            if s_find_str(body, "bl _arena_tail_step" as int) >= 0 or s_find_str(body, "bl arena_tail_step" as int) >= 0 do t10_ok = 0 end
        end
        opt_i = opt_i + 1
    end
    if t10_ok == 1 do
        s_println("  [PASS] test_10_arena_tco_stack_and_memory_bounded" as int)
    else
        s_println("  [FAIL] test_10_arena_tco_stack_and_memory_bounded" as int)
        all_ok = 0
    end

    # ── Test 11: Arena shadowed callable binding no miscompile across -O0..-O3 ──
    var t11_ok = 1
    opt_i = 0
    when opt_i <= 3 loop
        let opt_flag = s_concat2("-O" as int, s_int_to_str(opt_i))
        let out_v = run_vir_exec(virc_bin, "tests/opt/fixtures/tco_arena_shadow.vri" as int, opt_flag, tmp_bin, tmp_out)
        if s_streq(out_v, "999" as int) == 0 do t11_ok = 0 end
        opt_i = opt_i + 1
    end
    if t11_ok == 1 do
        s_println("  [PASS] test_11_arena_tco_shadowed_callable_no_miscompile" as int)
    else
        s_println("  [FAIL] test_11_arena_tco_shadowed_callable_no_miscompile" as int)
        all_ok = 0
    end

    # ── Test 12: VIRC-ISS-0053 controlled stack exhaustion ──
    # Check 1: default stack limit
    let
        stack_status_def = run_vir_status(virc_bin, "tests/opt/fixtures/stack_overflow_nontail.vri" as int, "-O0" as int, tmp_bin, tmp_out)
        stack_output_def = sys_read_file(tmp_out)
        stack_diag_def = has_stack_overflow_diagnostic(stack_output_def)
    var t12_def_ok = 0
    if stack_status_def != 0 & stack_status_def != 139 & stack_diag_def == 1 do
        t12_def_ok = 1
    end

    # Check 2: controlled small stack limit ulimit -s 1024
    let
        stack_status_1024 = run_vir_status_ulimit(virc_bin, "tests/opt/fixtures/stack_overflow_nontail.vri" as int, "-O0" as int, tmp_bin, tmp_out, 1024)
        stack_output_1024 = sys_read_file(tmp_out)
        stack_diag_1024 = has_stack_overflow_diagnostic(stack_output_1024)
    var t12_1024_ok = 0
    if stack_status_1024 != 0 & stack_status_1024 != 139 & stack_diag_1024 == 1 do
        t12_1024_ok = 1
    end

    # Check 3: controlled small stack limit ulimit -s 4096
    let
        stack_status_4096 = run_vir_status_ulimit(virc_bin, "tests/opt/fixtures/stack_overflow_nontail.vri" as int, "-O0" as int, tmp_bin, tmp_out, 4096)
        stack_output_4096 = sys_read_file(tmp_out)
        stack_diag_4096 = has_stack_overflow_diagnostic(stack_output_4096)
    var t12_4096_ok = 0
    if stack_status_4096 != 0 & stack_status_4096 != 139 & stack_diag_4096 == 1 do
        t12_4096_ok = 1
    end

    if t12_def_ok == 1 & t12_1024_ok == 1 & t12_4096_ok == 1 do
        s_println("  [PASS] test_12_controlled_stack_exhaustion" as int)
    else
        s_println("  [FAIL] test_12_controlled_stack_exhaustion (VIRC-ISS-0053)" as int)
        all_ok = 0
    end

    # Cleanup temporary files
    sys_unlink(tmp_bin)
    sys_unlink(tmp_out)
    sys_unlink(tmp_asm)

    if all_ok == 1 do
        s_println("ALL 12 TESTS PASSED SUCCESSFULLY!" as int)
        exit_prog(0)
    else
        s_println("SOME TESTS FAILED!" as int)
        exit_prog(1)
    end
end.
