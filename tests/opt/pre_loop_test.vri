    # ── Test 21: Loop tiling negative expression pattern ──
    let t21_o0 = run_vir_exec(virc_bin, "tests/opt_structural/loop_tiling_negative_pattern.vri" as int, "-O0" as int, tmp_bin, tmp_out)
    let t21_j2 = run_vir_json(virc_bin, "tests/opt_structural/loop_tiling_negative_pattern.vri" as int, "-O2" as int, "" as int, tmp_out)
    let t21_rec1 = find_transform_record(t21_j2, "test_tiling_pattern" as int, "loop_tiling" as int)
    let t21_rec2 = find_transform_record(t21_j2, "test_tiling_overwrite" as int, "loop_tiling" as int)
    let t21_o2 = run_vir_exec(virc_bin, "tests/opt_structural/loop_tiling_negative_pattern.vri" as int, "-O2" as int, tmp_bin, tmp_out)
    var t21_ok = 1
    if s_streq(t21_o0, "23040\n67" as int) == 0 do t21_ok = 0 end
    if check_rec_changed(t21_rec1, 0) == 0 do t21_ok = 0 end
    if check_rec_reason(t21_rec1, "unsupported_loop_body" as int) == 0 do t21_ok = 0 end
    if check_rec_verified(t21_rec1) == 0 do t21_ok = 0 end
    if check_rec_changed(t21_rec2, 0) == 0 do t21_ok = 0 end
    if check_rec_reason(t21_rec2, "unsupported_loop_body" as int) == 0 do t21_ok = 0 end
    if check_rec_verified(t21_rec2) == 0 do t21_ok = 0 end
    if s_streq(t21_o2, "23040\n67" as int) == 0 do t21_ok = 0 end
    if t21_ok == 1 do
