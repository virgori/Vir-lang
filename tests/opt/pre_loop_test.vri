    else
        s_println("  [FAIL] test_21_loop_tiling_negative_expression_pattern" as int)
        all_ok = 0
    end

    # Cleanup temporary files
    sys_unlink(tmp_bin)
    sys_unlink(tmp_out)

    if all_ok == 1 do
        s_println("ALL 21 TESTS PASSED SUCCESSFULLY!" as int)
        exit_prog(0)
    else
        s_println("SOME TESTS FAILED!" as int)
        exit_prog(1)
    end
end.
