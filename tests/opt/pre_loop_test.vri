    # ── Test 12: Cross optimization level parity across -O0..-O3 ──
    var t12_ok = 1
    var f_i = 0
    when f_i < 4 loop
        var fix_path = "tests/opt_structural/pre_positive.vri" as int
        var fix_exp = "95\n57" as int
        if f_i == 1 do
            fix_path = "tests/opt_structural/loop_fusion_positive.vri" as int
            fix_exp = "255" as int
        eif f_i == 2 do
            fix_path = "tests/opt_structural/loop_tiling_positive.vri" as int
            fix_exp = "31744" as int
        eif f_i == 3 do
            fix_path = "tests/opt_structural/loop_interchange_positive.vri" as int
            fix_exp = "2016" as int
        end

        var opt_idx = 0
        when opt_idx < 4 loop
            let opt_flg = s_concat2("-O" as int, s_int_to_str(opt_idx))
            let out_p = run_vir_exec(virc_bin, fix_path, opt_flg, tmp_bin, tmp_out)
            if s_streq(out_p, fix_exp) == 0 do t12_ok = 0 end
            opt_idx = opt_idx + 1
        end
        f_i = f_i + 1
    end
    if t12_ok == 1 do
        s_println("  [PASS] test_12_cross_optimization_level_parity" as int)
    else
        s_println("  [FAIL] test_12_cross_optimization_level_parity" as int)
        all_ok = 0
    end

    # ── Test 13: Bootstrap tests pass across -O0..-O3 ──
    var t13_ok = 1
    var b_i = 0
    when b_i < 2 loop
        var b_path = "tests/bootstrap_codegen/cg_optimizer_pre.vri" as int
        if b_i == 1 do b_path = "tests/bootstrap_codegen/cg_optimizer_loop_tiling_fusion.vri" as int end
        var opt_idx = 0
        when opt_idx < 4 loop
            let opt_flg = s_concat2("-O" as int, s_int_to_str(opt_idx))
            let out_b = run_vir_exec(virc_bin, b_path, opt_flg, tmp_bin, tmp_out)
            if out_b == 0 do t13_ok = 0 end
            opt_idx = opt_idx + 1
        end
        b_i = b_i + 1
    end
    if t13_ok == 1 do
        s_println("  [PASS] test_13_bootstrap_tests_pass" as int)
    else
        s_println("  [FAIL] test_13_bootstrap_tests_pass" as int)
        all_ok = 0
