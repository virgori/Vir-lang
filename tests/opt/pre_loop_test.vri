    if check_rec_changed(t8_rec, 0) == 0 do t8_ok = 0 end
    if check_rec_reason(t8_rec, "barrier_in_body" as int) == 0 do t8_ok = 0 end
    if check_rec_verified(t8_rec) == 0 do t8_ok = 0 end
    if s_streq(t8_o2, t8_o0) == 0 do t8_ok = 0 end
