# ═════════════════════════════════════════════════════════════════════
# tests/opt/pre_loop_test.vri — Native MIR PRE & Loop Transforms Verification
# Governed by VIRC-ISS-0001 / VIRC-PLN-0001 / VIRC-RPT-0025 / VIRC-SPC-0008 / VIRC-ISS-0050
# ═════════════════════════════════════════════════════════════════════

extern func syscall0(num: int) -> int
extern func syscall1(num: int, a0: int) -> int
extern func syscall2(num: int, a0: int, a1: int) -> int
extern func syscall3(num: int, a0: int, a1: int, a2: int) -> int
extern func syscall4(num: int, a0: int, a1: int, a2: int, a3: int) -> int
extern func syscall5(num: int, a0: int, a1: int, a2: int, a3: int, a4: int) -> int
extern func vir_get_platform() -> int
extern func usleep(usec: int) -> int
extern func kill(pid: int, sig: int) -> int
extern func exit_prog(code: int)

func s_strlen(s: int) -> int:
    if s == 0 do out 0 end
    var i = 0
    when read_byte(s, i) != 0 loop
        i = i + 1
    end
    out i
end.

func s_streq(a: int, b: int) -> int:
    if a == 0 and b == 0 do out 1 end
    if a == 0 or b == 0 do out 0 end
    let la = s_strlen(a)
    let lb = s_strlen(b)
    if la != lb do out 0 end
    var i = 0
    when i < la loop
        if read_byte(a, i) != read_byte(b, i) do out 0 end
        i = i + 1
    end
    out 1
end.

func s_concat2(a: int, b: int) -> int:
    let la = s_strlen(a)
    let lb = s_strlen(b)
    let res = alloc(la + lb + 1)
    var idx = 0
    var i = 0
    when i < la loop
        write_byte(res, idx, read_byte(a, i))
        idx = idx + 1
        i = i + 1
    end
    i = 0
    when i < lb loop
        write_byte(res, idx, read_byte(b, i))
        idx = idx + 1
        i = i + 1
    end
    write_byte(res, idx, 0)
    out res
end.

func s_find_str(haystack: int, needle: int) -> int:
    let hlen = s_strlen(haystack)
    let nlen = s_strlen(needle)
    if nlen == 0 do out 0 end
    if hlen < nlen do out -1 end
    var i = 0
    let limit = hlen - nlen
    when i <= limit loop
        var match = 1
        var j = 0
        when j < nlen loop
            if read_byte(haystack, i + j) != read_byte(needle, j) do
                match = 0
                j = nlen
            else
                j = j + 1
            end
        end
        if match == 1 do out i end
        i = i + 1
    end
    out -1
end.

func s_find_str_from(haystack: int, needle: int, from_pos: int) -> int:
    let hlen = s_strlen(haystack)
    let nlen = s_strlen(needle)
    if nlen == 0 do out from_pos end
    if hlen < nlen or from_pos > hlen - nlen do out -1 end
    var i = from_pos
    let limit = hlen - nlen
    when i <= limit loop
        var match = 1
        var j = 0
        when j < nlen loop
            if read_byte(haystack, i + j) != read_byte(needle, j) do
                match = 0
                j = nlen
            else
                j = j + 1
            end
        end
        if match == 1 do out i end
        i = i + 1
    end
    out -1
end.

func s_slice(s: int, start: int, len: int) -> int:
    if s == 0 or len <= 0 do
        let empty = alloc(1)
        write_byte(empty, 0, 0)
        out empty
    end
    let res = alloc(len + 1)
    var i = 0
    when i < len loop
        write_byte(res, i, read_byte(s, start + i))
        i = i + 1
    end
    write_byte(res, len, 0)
    out res
end.

func s_int_to_str(n: int) -> int:
    if n == 0 do
        let r = alloc(2)
        write_byte(r, 0, 48)
        write_byte(r, 1, 0)
        out r
    end
    var v = n
    var is_neg = 0
    if v < 0 do
        is_neg = 1
        v = 0 - v
    end
    let digits = alloc(32)
    var dlen = 0
    when v > 0 loop
        write_byte(digits, dlen, 48 + (v mod 10))
        v = v / 10
        dlen = dlen + 1
    end
    let res = alloc(dlen + is_neg + 1)
    var ri = 0
    if is_neg == 1 do
        write_byte(res, ri, 45)
        ri = ri + 1
    end
    var i = dlen - 1
    when i >= 0 loop
        write_byte(res, ri, read_byte(digits, i))
        ri = ri + 1
        i = i - 1
    end
    write_byte(res, ri, 0)
    out res
end.

func s_print(s: int):
    let len = s_strlen(s)
    if len > 0 do
        let plat = vir_get_platform()
        if plat == 2 or plat == 3 or plat == 4 do
            syscall3(1, 1, s, len)
        else
            syscall3(0x2000004, 1, s, len)
        end
    end
end.

func s_println(s: int):
    s_print(s)
    s_print("\n" as int)
end.

func sys_getpid() -> int:
    let plat = vir_get_platform()
    if plat == 2 or plat == 4 do out syscall0(172) end
    if plat == 3 do out syscall0(39) end
    out syscall0(0x2000014)
end.

func sys_fork() -> int:
    let plat = vir_get_platform()
    if plat == 2 or plat == 4 do out syscall5(220, 17, 0, 0, 0, 0) end
    if plat == 3 do out syscall0(57) end
    out syscall0(0x2000002)
end.

func sys_dup2(old_fd: int, new_fd: int) -> int:
    let plat = vir_get_platform()
    if plat == 2 or plat == 4 do out syscall3(24, old_fd, new_fd, 0) end
    if plat == 3 do out syscall2(33, old_fd, new_fd) end
    out syscall2(0x200005A, old_fd, new_fd)
end.

func sys_open_write(path: int) -> int:
    let plat = vir_get_platform()
    if plat == 2 or plat == 4 do out syscall4(56, -100, path, 577, 420) end
    if plat == 3 do out syscall3(2, path, 577, 420) end
    out syscall3(0x2000005, path, 0x0601, 420)
end.

func sys_close(fd: int) -> int:
    let plat = vir_get_platform()
    if plat == 2 or plat == 3 or plat == 4 do out syscall1(3, fd) end
    out syscall1(0x2000006, fd)
end.

func sys_wait4(pid: int, status_ptr: int, options: int) -> int:
    let plat = vir_get_platform()
    if plat == 2 or plat == 4 do out syscall4(260, pid, status_ptr, options, 0) end
    if plat == 3 do out syscall4(61, pid, status_ptr, options, 0) end
    out syscall4(0x2000007, pid, status_ptr, options, 0)
end.

func sys_execve(path: int, argv: int, envp: int) -> int:
    let plat = vir_get_platform()
    if plat == 2 or plat == 4 do out syscall3(221, path, argv, envp) end
    if plat == 3 do out syscall3(59, path, argv, envp) end
    out syscall3(0x200003B, path, argv, envp)
end.

func sys_unlink(path: int) -> int:
    let plat = vir_get_platform()
    if plat == 2 or plat == 4 do out syscall3(35, -100, path, 0) end
    if plat == 3 do out syscall1(87, path) end
    out syscall1(0x200000A, path)
end.

func sys_read_file(path: int) -> int:
    let plat = vir_get_platform()
    var fd = -1
    if plat == 2 or plat == 4 do
        fd = syscall4(56, -100, path, 0, 0)
    eif plat == 3 do
        fd = syscall3(2, path, 0, 0)
    else
        fd = syscall3(0x2000005, path, 0, 0)
    end
    if fd < 0 do out 0 end

    let cap = 524288 # 512KB
    let buf = alloc(cap)
    var total = 0
    if plat == 2 or plat == 3 or plat == 4 do
        total = syscall3(0, fd, buf, cap - 1)
    else
        total = syscall3(0x2000003, fd, buf, cap - 1)
    end
    sys_close(fd)
    if total <= 0 do out 0 end
    write_byte(buf, total, 0)
    out buf
end.

func sys_trim(s: int) -> int:
    let len = s_strlen(s)
    if len == 0 do
        let empty = alloc(1)
        write_byte(empty, 0, 0)
        out empty
    end
    var start = 0
    when start < len and (read_byte(s, start) == 32 or read_byte(s, start) == 9 or read_byte(s, start) == 13 or read_byte(s, start) == 10) loop
        start = start + 1
    end
    var end_pos = len
    when end_pos > start and (read_byte(s, end_pos - 1) == 32 or read_byte(s, end_pos - 1) == 9 or read_byte(s, end_pos - 1) == 13 or read_byte(s, end_pos - 1) == 10) loop
        end_pos = end_pos - 1
    end
    let tlen = end_pos - start
    if tlen <= 0 do
        let empty = alloc(1)
        write_byte(empty, 0, 0)
        out empty
    end
    let res = alloc(tlen + 1)
    var i = 0
    when i < tlen loop
        write_byte(res, i, read_byte(s, start + i))
        i = i + 1
    end
    write_byte(res, tlen, 0)
    out res
end.

func run_cmd_captured(cmd_argv: int, out_file: int) -> int:
    let my_pid = sys_getpid()
    let child_pid = sys_fork()
    let cur_pid = sys_getpid()

    if cur_pid != my_pid or child_pid == 0 do
        if s_strlen(out_file) > 0 do
            let out_fd = sys_open_write(out_file)
            if out_fd >= 0 do
                sys_dup2(out_fd, 1)
                sys_close(out_fd)
            end
        end

        let bin_prog = native_read_i64(cmd_argv, 0)
        let envp = alloc(32)
        native_write_i64(envp, 0, "VIRC_UI=classic" as int)
        native_write_i64(envp, 8, "NO_COLOR=1" as int)
        native_write_i64(envp, 16, 0)

        sys_execve(bin_prog, cmd_argv, envp)
        exit_prog(127)
    end

    let st = alloc(8)
    var ticks = 0
    when ticks < 3000 loop
        let wpid = sys_wait4(child_pid, st, 1)
        if wpid == child_pid do
            let code = read_byte(st, 1)
            out code
        end
        usleep(10000)
        ticks = ticks + 1
    end
    kill(child_pid, 9)
    sys_wait4(child_pid, st, 0)
    out -999
end.

func run_vir_exec(virc_bin: int, fixture: int, opt: int, tmp_bin: int, tmp_out: int) -> int:
    sys_unlink(tmp_bin)
    sys_unlink(tmp_out)

    let argv_comp = alloc(64)
    native_write_i64(argv_comp, 0, virc_bin)
    native_write_i64(argv_comp, 8, fixture)
    native_write_i64(argv_comp, 16, opt)
    native_write_i64(argv_comp, 24, "-o" as int)
    native_write_i64(argv_comp, 32, tmp_bin)
    native_write_i64(argv_comp, 40, "-q" as int)
    native_write_i64(argv_comp, 48, 0)

    let rc_comp = run_cmd_captured(argv_comp, 0)
    if rc_comp != 0 do out 0 end

    let argv_run = alloc(16)
    native_write_i64(argv_run, 0, tmp_bin)
    native_write_i64(argv_run, 8, 0)
    let rc_run = run_cmd_captured(argv_run, tmp_out)
    if rc_run != 0 do out 0 end

    let out_data = sys_read_file(tmp_out)
    out sys_trim(out_data)
end.

func run_vir_json(virc_bin: int, fixture: int, opt: int, mut_arg: int, tmp_out: int) -> int:
    sys_unlink(tmp_out)

    let argv_j = alloc(64)
    native_write_i64(argv_j, 0, virc_bin)
    native_write_i64(argv_j, 8, fixture)
    native_write_i64(argv_j, 16, opt)
    native_write_i64(argv_j, 24, "--json" as int)
    var argc_idx = 32
    if s_strlen(mut_arg) > 0 do
        native_write_i64(argv_j, argc_idx, mut_arg)
        argc_idx = argc_idx + 8
    end
    native_write_i64(argv_j, argc_idx, "-q" as int)
    native_write_i64(argv_j, argc_idx + 8, 0)

    let rc = run_cmd_captured(argv_j, tmp_out)
    if rc != 0 do out 0 end

    out sys_read_file(tmp_out)
end.

func find_transform_record(json_str: int, func_name: int, transform_name: int) -> int:
    if json_str == 0 or func_name == 0 or transform_name == 0 do out 0 end
    let key_fn = s_concat2("\"function\":\"", s_concat2(func_name, "\"" as int))
    let key_tr = s_concat2("\"transform\":\"", s_concat2(transform_name, "\"" as int))
    var pos = s_find_str(json_str, key_fn)
    let klen = s_strlen(key_fn)
    when pos >= 0 loop
        var obj_start = pos
        when obj_start > 0 and read_byte(json_str, obj_start) != 123 loop
            obj_start = obj_start - 1
        end
        let obj_end = s_find_str_from(json_str, "}" as int, pos)
        if obj_end > pos do
            let obj_slice = s_slice(json_str, obj_start, obj_end - obj_start + 1)
            if s_find_str(obj_slice, key_tr) >= 0 do
                out obj_slice
            end
        end
        pos = s_find_str_from(json_str, key_fn, pos + klen)
    end
    out 0
end.

func check_rec_changed(rec: int, exp_changed: int) -> int:
    if rec == 0 do out 0 end
    if exp_changed == 1 do
        if s_find_str(rec, "\"changed\":1" as int) >= 0 or s_find_str(rec, "\"changed\": 1" as int) >= 0 do out 1 end
    else
        if s_find_str(rec, "\"changed\":0" as int) >= 0 or s_find_str(rec, "\"changed\": 0" as int) >= 0 do out 1 end
    end
    out 0
end.

func check_rec_verified(rec: int) -> int:
    if rec == 0 do out 0 end
    if s_find_str(rec, "\"verified\":1" as int) >= 0 or s_find_str(rec, "\"verified\": 1" as int) >= 0 do out 1 end
    out 0
end.

func check_rec_reason(rec: int, exp_reason: int) -> int:
    if rec == 0 or exp_reason == 0 do out 0 end
    let pattern = s_concat2("\"reason\":\"", s_concat2(exp_reason, "\"" as int))
    if s_find_str(rec, pattern) >= 0 do out 1 end
    out 0
end.

func main:
    var virc_bin = "bin/virc" as int
    let argc = arg_count()
    var i = 1
    when i < argc loop
        let arg = get_arg(i) as int
        if s_streq(arg, "--virc" as int) == 1 and i + 1 < argc do
            virc_bin = get_arg(i + 1) as int
            i = i + 1
        end
        i = i + 1
    end

    s_println("=== Running Native MIR PRE & Loop Transforms Verification ===" as int)

    let pid = sys_getpid()
    let tmp_bin = s_concat2("scratch/.tmp_pre_loop_bin_" as int, s_int_to_str(pid))
    let tmp_out = s_concat2("scratch/.tmp_pre_loop_out_" as int, s_int_to_str(pid))

    var all_ok = 1

    # ── Test 1: PRE positive structural & runtime ──
    let t1_o0 = run_vir_exec(virc_bin, "tests/opt_structural/pre_positive.vri" as int, "-O0" as int, tmp_bin, tmp_out)
    let t1_j2 = run_vir_json(virc_bin, "tests/opt_structural/pre_positive.vri" as int, "-O2" as int, "" as int, tmp_out)
    let t1_rec = find_transform_record(t1_j2, "compute_pre" as int, "pre" as int)
    let t1_o2 = run_vir_exec(virc_bin, "tests/opt_structural/pre_positive.vri" as int, "-O2" as int, tmp_bin, tmp_out)
    var t1_ok = 1
    if s_streq(t1_o0, "95\n57" as int) == 0 do t1_ok = 0 end
    if check_rec_changed(t1_rec, 1) == 0 do t1_ok = 0 end
    if check_rec_reason(t1_rec, "changed" as int) == 0 do t1_ok = 0 end
    if check_rec_verified(t1_rec) == 0 do t1_ok = 0 end
    if s_find_str(t1_rec, "phi=" as int) < 0 do t1_ok = 0 end
    if s_streq(t1_o2, "95\n57" as int) == 0 do t1_ok = 0 end
    if t1_ok == 1 do
        s_println("  [PASS] test_01_pre_positive_structural_and_runtime" as int)
    else
        s_println("  [FAIL] test_01_pre_positive_structural_and_runtime" as int)
        all_ok = 0
    end

    # ── Test 2: PRE negative redefinition safety ──
    let t2_o0 = run_vir_exec(virc_bin, "tests/opt_structural/pre_redef_negative.vri" as int, "-O0" as int, tmp_bin, tmp_out)
    let t2_j2 = run_vir_json(virc_bin, "tests/opt_structural/pre_redef_negative.vri" as int, "-O2" as int, "" as int, tmp_out)
    let t2_rec = find_transform_record(t2_j2, "compute_pre_redef" as int, "pre" as int)
    let t2_o2 = run_vir_exec(virc_bin, "tests/opt_structural/pre_redef_negative.vri" as int, "-O2" as int, tmp_bin, tmp_out)
    var t2_ok = 1
    if check_rec_changed(t2_rec, 0) == 0 do t2_ok = 0 end
    if check_rec_verified(t2_rec) == 0 do t2_ok = 0 end
    if s_streq(t2_o2, t2_o0) == 0 do t2_ok = 0 end
    if t2_ok == 1 do
        s_println("  [PASS] test_02_pre_negative_redefinition_safety" as int)
    else
        s_println("  [FAIL] test_02_pre_negative_redefinition_safety" as int)
        all_ok = 0
    end

    # ── Test 3: PRE negative barrier safety ──
    let t3_o0 = run_vir_exec(virc_bin, "tests/opt_structural/pre_barrier_negative.vri" as int, "-O0" as int, tmp_bin, tmp_out)
    let t3_j2 = run_vir_json(virc_bin, "tests/opt_structural/pre_barrier_negative.vri" as int, "-O2" as int, "" as int, tmp_out)
    let t3_rec = find_transform_record(t3_j2, "test_pre_barrier" as int, "pre" as int)
    let t3_o2 = run_vir_exec(virc_bin, "tests/opt_structural/pre_barrier_negative.vri" as int, "-O2" as int, tmp_bin, tmp_out)
    var t3_ok = 1
    if check_rec_changed(t3_rec, 0) == 0 do t3_ok = 0 end
    if check_rec_verified(t3_rec) == 0 do t3_ok = 0 end
    if s_streq(t3_o2, t3_o0) == 0 do t3_ok = 0 end
    if t3_ok == 1 do
        s_println("  [PASS] test_03_pre_negative_barrier_safety" as int)
    else
        s_println("  [FAIL] test_03_pre_negative_barrier_safety" as int)
        all_ok = 0
    end

    # ── Test 4: PRE mutation identity fails oracle ──
    let t4_j = run_vir_json(virc_bin, "tests/opt_structural/pre_positive.vri" as int, "-O2" as int, "--mutate-mir=identity_pre" as int, tmp_out)
    let t4_rec = find_transform_record(t4_j, "compute_pre" as int, "pre" as int)
    var t4_ok = 1
    if check_rec_changed(t4_rec, 0) == 0 do t4_ok = 0 end
    if check_rec_reason(t4_rec, "mutation_identity_pre" as int) == 0 do t4_ok = 0 end
    if t4_ok == 1 do
        s_println("  [PASS] test_04_pre_mutation_identity_fails_oracle" as int)
    else
        s_println("  [FAIL] test_04_pre_mutation_identity_fails_oracle" as int)
        all_ok = 0
    end

    # ── Test 5: PRE mutation corrupt phi fails verifier ──
    sys_unlink(tmp_out)
    let argv_cphi = alloc(64)
    native_write_i64(argv_cphi, 0, virc_bin)
    native_write_i64(argv_cphi, 8, "tests/opt_structural/pre_positive.vri" as int)
    native_write_i64(argv_cphi, 16, "-O2" as int)
    native_write_i64(argv_cphi, 24, "--mutate-mir=corrupt_pre_phi" as int)
    native_write_i64(argv_cphi, 32, "-o" as int)
    native_write_i64(argv_cphi, 40, tmp_bin)
    native_write_i64(argv_cphi, 48, 0)
    let rc_cphi = run_cmd_captured(argv_cphi, tmp_out)
    let out_cphi = sys_read_file(tmp_out)
    var t5_ok = 1
    if rc_cphi == 0 do t5_ok = 0 end
    if s_find_str(out_cphi, "E6001" as int) < 0 and s_find_str(out_cphi, "MIR CFG/SSA verification failed" as int) < 0 do t5_ok = 0 end
    if t5_ok == 1 do
        s_println("  [PASS] test_05_pre_mutation_corrupt_phi_fails_verifier" as int)
    else
        s_println("  [FAIL] test_05_pre_mutation_corrupt_phi_fails_verifier" as int)
        all_ok = 0
    end

    # ── Test 6: Loop fusion positive structural & runtime ──
    let t6_o0 = run_vir_exec(virc_bin, "tests/opt_structural/loop_fusion_positive.vri" as int, "-O0" as int, tmp_bin, tmp_out)
    let t6_j2 = run_vir_json(virc_bin, "tests/opt_structural/loop_fusion_positive.vri" as int, "-O2" as int, "" as int, tmp_out)
    let t6_rec = find_transform_record(t6_j2, "test_fusion" as int, "loop_fusion" as int)
    let t6_o2 = run_vir_exec(virc_bin, "tests/opt_structural/loop_fusion_positive.vri" as int, "-O2" as int, tmp_bin, tmp_out)
    var t6_ok = 1
    if s_streq(t6_o0, "255" as int) == 0 do t6_ok = 0 end
    if check_rec_changed(t6_rec, 1) == 0 do t6_ok = 0 end
    if check_rec_reason(t6_rec, "changed" as int) == 0 do t6_ok = 0 end
    if check_rec_verified(t6_rec) == 0 do t6_ok = 0 end
    if s_streq(t6_o2, "255" as int) == 0 do t6_ok = 0 end
    if t6_ok == 1 do
        s_println("  [PASS] test_06_loop_fusion_positive_structural_and_runtime" as int)
    else
        s_println("  [FAIL] test_06_loop_fusion_positive_structural_and_runtime" as int)
        all_ok = 0
    end

    # ── Test 7: Loop fusion negative bounds ──
    let t7_o0 = run_vir_exec(virc_bin, "tests/opt_structural/loop_fusion_negative_bounds.vri" as int, "-O0" as int, tmp_bin, tmp_out)
    let t7_j2 = run_vir_json(virc_bin, "tests/opt_structural/loop_fusion_negative_bounds.vri" as int, "-O2" as int, "" as int, tmp_out)
    let t7_rec = find_transform_record(t7_j2, "test_fusion_bounds" as int, "loop_fusion" as int)
    let t7_o2 = run_vir_exec(virc_bin, "tests/opt_structural/loop_fusion_negative_bounds.vri" as int, "-O2" as int, tmp_bin, tmp_out)
    var t7_ok = 1
    if check_rec_changed(t7_rec, 0) == 0 do t7_ok = 0 end
    if check_rec_reason(t7_rec, "mismatched_bounds" as int) == 0 do t7_ok = 0 end
    if check_rec_verified(t7_rec) == 0 do t7_ok = 0 end
    if s_streq(t7_o2, t7_o0) == 0 do t7_ok = 0 end
    if t7_ok == 1 do
        s_println("  [PASS] test_07_loop_fusion_negative_bounds" as int)
    else
        s_println("  [FAIL] test_07_loop_fusion_negative_bounds" as int)
        all_ok = 0
    end

    # ── Test 8: Loop fusion negative barrier ──
    let t8_o0 = run_vir_exec(virc_bin, "tests/opt_structural/loop_fusion_negative_barrier.vri" as int, "-O0" as int, tmp_bin, tmp_out)
    let t8_j2 = run_vir_json(virc_bin, "tests/opt_structural/loop_fusion_negative_barrier.vri" as int, "-O2" as int, "" as int, tmp_out)
    let t8_rec = find_transform_record(t8_j2, "test_fusion_barrier" as int, "loop_fusion" as int)
