func arena_tail_step(n: int, acc: int) -> int:
    if n <= 0 do
        out acc
    end
    arena:
        var tmp = [n, acc, (n + acc) mod 997]
        var head = tmp[0]
        var mid = tmp[1]
        var tail = tmp[2]
        out arena_tail_step(n - 1, (acc + tail) mod 1000000)
    end
end.
func main:
    let res = arena_tail_step(10000000, 42)
    print res
end.
