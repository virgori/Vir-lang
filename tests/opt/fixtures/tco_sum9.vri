func sum9:
    in
        n: int
        a1: int
        a2: int
        a3: int
        a4: int
        a5: int
        a6: int
        a7: int
        acc: int
    if n <= 0 do
        out acc
    end
    out sum9(n - 1, a1, a2, a3, a4, a5, a6, a7, acc + a1)
end.
func main:
    let r = sum9(10000, 1, 1, 1, 1, 1, 1, 1, 0)
    print r
end.
