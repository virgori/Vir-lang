# VIRC-ISS-0053: non-tail recursion must report controlled stack exhaustion,
# never terminate as an unclassified SIGSEGV.
func sum_non_tail(n: int) -> int:
    if n <= 0 do
        out 0
    end
    out n + sum_non_tail(n - 1)
end.

func main:
    let total = sum_non_tail(500000)
    print total
end.
