func spill_tail:
    in
        n: int
        acc: int
    if n <= 0 do
        out acc
    end
    let v1 = acc + 1
    let v2 = v1 + 2
    let v3 = v2 + 3
    let v4 = v3 + 4
    let v5 = v4 + 5
    let v6 = v5 + 6
    let v7 = v6 + 7
    let v8 = v7 + 8
    let v9 = v8 + 9
    let v10 = v9 + 10
    let v11 = v10 + 11
    let v12 = v11 + 12
    let next_acc = v1 + v2 + v3 + v4 + v5 + v6 + v7 + v8 + v9 + v10 + v11 + v12
    out spill_tail(n - 1, next_acc mod 100000)
end.
func main:
    let r = spill_tail(1000, 1)
    print r
end.
