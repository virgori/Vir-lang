# test_adv_005: Shift operations - extreme cases
# Expected: 42, 1, 0, 8, 2

func main:
    # Shift left by 0 = identity
    var x = 42
    var r1 = x shl 0
    print r1

    # Shift left by 0 then right
    var r2 = 1 shl 0
    print r2

    # Shift right large = 0
    var r3 = 1 shr 10
    print r3

    # Shift left by 3 = multiply by 8
    var r4 = 1 shl 3
    print r4

    # Shift right by 2 = divide by 4
    var r5 = 8 shrrr 2
    print r5
end.
