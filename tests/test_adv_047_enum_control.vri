# test_adv_047: Enum used in control flow
# Expected: red, green, blue

enum Color:
    Red = 1
    Green = 2
    Blue = 3
end.
func print_color:
    in(c)
    if c == 1 do
        print_str("red")
    eif c == 2 do
        print_str("green")
    eif c == 3 do
        print_str("blue")
    end
end
func main:
    print_color(Color.Red)
    print_color(Color.Green)
    print_color(Color.Blue)
end