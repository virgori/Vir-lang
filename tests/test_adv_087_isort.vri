# test_adv_087: Insertion sort
# Expected: 1, 2, 3, 4, 5, 6

func main:
    var arr = arr_new(8)
    push(arr, 6)
    push(arr, 3)
    push(arr, 1)
    push(arr, 5)
    push(arr, 2)
    push(arr, 4)

    var n = len(arr)
    var i = 1
    when i < n loop
        var key = arr[i]
        var j = i - 1
        when j >= 0 loop
            if arr[j] > key do
                arr[j + 1] = arr[j]
                j = j - 1
            else
                break
            end
        end
        arr[j + 1] = key
        i = i + 1
    end

    i = 0
    when i < n loop
        print arr[i]
        i = i + 1
    end
end.
