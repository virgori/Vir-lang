extern func native_read_u8(addr: int, offset: int) -> int;
extern func native_write_u8(addr: int, offset: int, val: int) -> int;
extern func syscall3(n: int, a1: int, a2: int, a3: int) -> int;

const SYS_READ:  0x2000003;
const SYS_WRITE: 0x2000004;
const SYS_OPEN:  0x2000005;
const SYS_CLOSE: 0x2000006;
const SYS_LSEEK: 0x20000c8;
const O_RDONLY: 0;
const STDOUT_FD: 1;

func sys_read:
    in(fd: int, buf: int, count: int)
    out syscall3(SYS_READ, fd, buf, count);
end.

func sys_write:
    in(fd: int, buf: int, count: int)
    out syscall3(SYS_WRITE, fd, buf, count);
end.

func sys_open:
    in(path: int, flags: int, mode: int)
    out syscall3(SYS_OPEN, path, flags, mode);
end.

func sys_close:
    in(fd: int)
    out syscall3(SYS_CLOSE, fd, 0, 0);
end.

func sys_lseek:
    in(fd: int, offset: int, whence: int)
    out syscall3(SYS_LSEEK, fd, offset, whence);
end.

func rt_strlen:
    in(s: int)
    if s == 0 do
        out 0
    end
    let i = 0
    when native_read_u8(s, i) != 0 loop
        i = i + 1
    end
    out i
end.

func print_str:
    in(s: int)
    sys_write(STDOUT_FD, s, rt_strlen(s));
end.

func vir_alloc:
    in(size: int)
    out syscall3(197, 0, size, 3);
end.

func file_open_read:
    in(path: int)
    let fd = sys_open(path, O_RDONLY, 0);
    if fd < 0 do
        out 0
    end
    out fd
end.

func file_read_all_fd:
    in(fd: int)
    let end_pos = sys_lseek(fd, 0, 2);
    sys_lseek(fd, 0, 0);
    if end_pos <= 0 do
        out 0
    end
    let buf = vir_alloc(end_pos + 1);
    let total = 0;
    when total < end_pos loop
        let n = sys_read(fd, buf + total, end_pos - total);
        if n <= 0 do
            out skip;
        end
        total = total + n;
    end
    native_write_u8(buf, total, 0);
    out buf;
end.

func main:
    let fd = file_open_read("tests/test_basic_42.vri");
    print_str("opened\n");
    let content = file_read_all_fd(fd);
    print_str("read done\n");
    sys_close(fd);
    out rt_strlen(content);
end.
