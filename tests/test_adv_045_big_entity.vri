# test_adv_045: Entity with many fields (6+)
# Expected: 1, 2, 3, 4, 5, 6, 21

entity BigStruct:
    a
    b
    c
    d
    e
    f
end.
func main:
    var s = BigStruct(a: 1, b: 2, c: 3, d: 4, e: 5, f: 6)
    print s.a
    print s.b
    print s.c
    print s.d
    print s.e
    print s.f
    var sum = s.a + s.b + s.c + s.d + s.e + s.f
    print sum
end.
