# test_adv_082: Complex eif chain with function calls
# Expected: small, medium, large

func classify:
    in(x)
    if x < 10 do
        print_str("small")
    eif x < 100 do
        print_str("medium")
    else
        print_str("large")
    end
end
func main:
    classify(5)
    classify(50)
    classify(500)
end.