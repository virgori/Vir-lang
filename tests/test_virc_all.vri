entity Pair:
    key: int
    val: int
end.
var counter = 2

func make_pair(k: int, v: int) -> Pair:
    out Pair( key: k, val: v )
end.
func add_counter(n: int) -> int:
    counter = counter + n
    out counter
end.
func check(p: Pair) -> int:
    var k = p.key
    var v = p.val
    var result = 0
    if k == 1: do
        result = v + 10
    eif k == 2: do
        result = v + 20
    else
        result = v
    end
    out result
end
func main:
    var p1 = make_pair(1, 5)
    var p2 = make_pair(2, 5)
    print check(p1)
    print check(p2)
    print add_counter(10)
    print add_counter(20)
    var arr = arr_new(8)
    push(arr, 100)
    push(arr, 200)
    print arr[0]
    print arr[1]
    print len(arr)
    var s = "hello"
    print_str(s)
    print str_len(s)
end.