include vir.env

extern func native_read_u8(addr: int, offset: int) -> int

func test_str_eq(a: string, b: string) -> bool:
    let pa = a as int
    let pb = b as int
    if pa == pb do out true end
    if pa == 0 or pb == 0 do out false end
    var i = 0
    loop
        let ca = native_read_u8(pa, i)
        let cb = native_read_u8(pb, i)
        if ca != cb do out false end
        if ca == 0 do out true end
        i = i + 1
    end
    out true
end.

func opt_int_or(opt, default: int) -> int:
    case opt
        Some(v): out v
        None: out default
    end
    out default
end.

func opt_bool_or(opt, default: bool) -> bool:
    case opt
        Some(v): out v
        None: out default
    end
    out default
end.

func main:
    # 1. Test env.int -> Option (registry)
    env.set("TEST_PORT", "8080")
    env.set("TEST_NEG", "-42")
    env.set("TEST_BAD_INT", "not_a_number")
    let p1 = opt_int_or(env.int("TEST_PORT"), 3000)
    let p2 = opt_int_or(env.int("TEST_NEG"), 0)
    let p3 = opt_int_or(env.int("TEST_BAD_INT"), 99)
    let p4 = opt_int_or(env.int("TEST_MISSING_INT"), 5000)
    if p1 == 8080 and p2 == 0 - 42 and p3 == 99 and p4 == 5000 do
        print 1
    end

    # 2. Test env.str
    env.set("TEST_HOST", "127.0.0.1")
    env.set("TEST_EMPTY", "")
    let h1 = env.str("TEST_HOST", "0.0.0.0")
    let h2 = env.str("TEST_EMPTY", "default_val")
    let h3 = env.str("TEST_MISSING_STR", "fallback_host")
    if test_str_eq(h1, "127.0.0.1") and test_str_eq(h2, "") and test_str_eq(h3, "fallback_host") do
        print 2
    end

    # 3. Test env.bool truthy
    env.set("TEST_B_TRUE", "true")
    env.set("TEST_B_TRUE_UP", "TRUE")
    env.set("TEST_B_ONE", "1")
    env.set("TEST_B_YES", "yes")
    env.set("TEST_B_ON", "on")
    let bt1 = opt_bool_or(env.bool("TEST_B_TRUE"), false)
    let bt2 = opt_bool_or(env.bool("TEST_B_TRUE_UP"), false)
    let bt3 = opt_bool_or(env.bool("TEST_B_ONE"), false)
    let bt4 = opt_bool_or(env.bool("TEST_B_YES"), false)
    let bt5 = opt_bool_or(env.bool("TEST_B_ON"), false)
    if bt1 and bt2 and bt3 and bt4 and bt5 do
        print 3
    end

    # 4. Test env.bool falsy
    env.set("TEST_B_FALSE", "false")
    env.set("TEST_B_FALSE_UP", "FALSE")
    env.set("TEST_B_ZERO", "0")
    env.set("TEST_B_NO", "no")
    env.set("TEST_B_OFF", "off")
    let bf1 = opt_bool_or(env.bool("TEST_B_FALSE"), true)
    let bf2 = opt_bool_or(env.bool("TEST_B_FALSE_UP"), true)
    let bf3 = opt_bool_or(env.bool("TEST_B_ZERO"), true)
    let bf4 = opt_bool_or(env.bool("TEST_B_NO"), true)
    let bf5 = opt_bool_or(env.bool("TEST_B_OFF"), true)
    if bf1 == false and bf2 == false and bf3 == false and bf4 == false and bf5 == false do
        print 4
    end

    # 5. Test env.bool invalid / missing -> None (fallback via helper)
    env.set("TEST_B_INVALID", "maybe")
    let b_inv1 = opt_bool_or(env.bool("TEST_B_INVALID"), true)
    let b_inv2 = opt_bool_or(env.bool("TEST_B_INVALID"), false)
    let b_miss1 = opt_bool_or(env.bool("TEST_B_MISSING"), true)
    let b_miss2 = opt_bool_or(env.bool("TEST_B_MISSING"), false)
    if b_inv1 == true and b_inv2 == false and b_miss1 == true and b_miss2 == false do
        print 5
    end

    # 6. Test env.require success
    env.set("DATABASE_URL", "postgres://localhost:5432/mydb")
    let r_ok = env.require("DATABASE_URL")
    case r_ok
        Ok(db_url):
            if test_str_eq(db_url, "postgres://localhost:5432/mydb") do
                print 6
            end
        Err(_):
            print 0
    end

    # 7. Test env.require missing
    let r_err = env.require("VIR_TOTALLY_ABSENT_VAR_XYZ")
    case r_err
        Ok(_):
            print 0
        Err(_):
            print 7
    end

    # 8. Registry: unwrapOr (SPEC env.or blocked — keyword) / name / home / temp
    let fb = env.unwrapOr("VIR_NON_EXISTENT_OR_XYZ", "fallback_or")
    if test_str_eq(fb, "fallback_or") do
        print 8
    end
    let hm = env.home()
    let tp = env.temp()
    let nm = env.name()
    print 9

    # Cleanup
    env.remove("TEST_PORT")
    env.remove("TEST_NEG")
    env.remove("TEST_BAD_INT")
    env.remove("TEST_HOST")
    env.remove("TEST_EMPTY")
    env.remove("TEST_B_TRUE")
    env.remove("TEST_B_TRUE_UP")
    env.remove("TEST_B_ONE")
    env.remove("TEST_B_YES")
    env.remove("TEST_B_ON")
    env.remove("TEST_B_FALSE")
    env.remove("TEST_B_FALSE_UP")
    env.remove("TEST_B_ZERO")
    env.remove("TEST_B_NO")
    env.remove("TEST_B_OFF")
    env.remove("TEST_B_INVALID")
    env.remove("DATABASE_URL")

    print 999
    out 0
end.
