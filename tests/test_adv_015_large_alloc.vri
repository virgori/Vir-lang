# test_adv_015: Large allocation - write to far offset
# Expected: 12345, 99999

func main:
    # Allocate 64KB
    var size = 65536
    var ptr = alloc(size)
    # Write to last word (offset size - 8)
    var off = size - 8
    write_word(ptr, off, 12345)
    var val = read_word(ptr, off)
    print val

    # Write to middle
    var mid = size / 2
    write_word(ptr, mid, 99999)
    var val2 = read_word(ptr, mid)
    print val2
end.