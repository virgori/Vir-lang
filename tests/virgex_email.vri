include vir.pattern.virgex as v
include vir.env.env

func main:
    let pattern = "| @Az0!1~ :( . @Az0!1~ :) !~ @ @Az0!1~ :( . @Az0!1~ :) !1~ |"
    print "Pattern: $pattern"
    
    var emails = [
        "test@example.com",
        "user.name@domain.co.uk",
        "invalid-email",
        "no@domain",
        "@missinguser.com"
    ]
    
    var i = 0
    let count = len(emails)
    when i < count loop
        let email = emails[i]
        case v.virgex_fullmatch(pattern, email)
            true: print "✅ $email"
            false: print "❌ $email"
        end
        i = i + 1
    end
end.
