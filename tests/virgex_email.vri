# EXPECT_START
# Pattern: | @Az0!1~ :( . @Az0!1~ :) !~ $@ @Az0!1~ :( . @Az0!1~ :) !1~ |
# MATCH: test@example.com
# MATCH: user.name@domain.co.uk
# NO: invalid-email
# NO: no@domain
# NO: @missinguser.com
# EXPECT_END

include virgex

func main:
    let pattern = "| @Az0!1~ :( . @Az0!1~ :) !~ $@ @Az0!1~ :( . @Az0!1~ :) !1~ |"
    let pat = virgex.compile(pattern)
    print "Pattern: $pattern"

    var emails = [
        "test@example.com",
        "user.name@domain.co.uk",
        "invalid-email",
        "no@domain",
        "@missinguser.com"
    ]

    var i = 0
    let count = len(emails)
    when i < count loop
        let email = emails[i]
        if virgex.fullMatch(pat, email) do
            print "MATCH: $email"
        else
            print "NO: $email"
        end
        i = i + 1
    end
end.
