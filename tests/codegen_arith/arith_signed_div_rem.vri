# Signed division and remainder corner cases
func main:
    # 7 / 3
    print 7 / 3
    print 7 mod 3

    # -7 / 3
    print (0 - 7) / 3
    print (0 - 7) mod 3

    # 7 / -3
    print 7 / (0 - 3)
    print 7 mod (0 - 3)

    # -7 / -3
    print (0 - 7) / (0 - 3)
    print (0 - 7) mod (0 - 3)

    out 0
end.
