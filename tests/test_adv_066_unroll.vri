# test_adv_066: Loop unrolling candidate (small fixed loop)
# Expected: 10

func main:
    var sum = 0
    for i in 0..4 loop
        sum = sum + i
    end.
    # 0+1+2+3 = 6... wait, + 4 more
    # Actually 0..4 = [0,1,2,3] → sum = 6
    # Let me fix: we need 10
    sum = sum + 4
    print sum
end.