func process(x: int) -> int:
    var result = 0
    if x > 100 do
        result = x - 100
    eif x > 50 do
        result = x - 50
    eif x > 0 do
        result = x
    else
        result = 0
    end
    out result
end
func main:
    var r1 = process(200)
    print r1
    var r2 = process(75)
    print r2
    var r3 = process(30)
    print r3
end
