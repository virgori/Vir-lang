# test_adv_025: Break from nested loops
# Expected: 6

func main:
    var total = 0
    var i = 0
    when i < 10 loop
        var j = 0
        when j < 10 loop
            if j == 3 do
                break
            end
            total = total + 1
            j = j + 1
        end.
        i = i + 1
        if i == 2 do
            break
        end
    end.
    print total
end.
