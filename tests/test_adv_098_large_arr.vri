# test_adv_098: Large array processing (1000 elements)
# Expected: 499500

func main:
    var arr = arr_new(1024)
    var i = 0
    when i < 1000 loop
        push(arr, i)
        i = i + 1
    end.

    var sum = 0
    i = 0
    when i < 1000 loop
        sum = sum + arr[i]
        i = i + 1
    end.
    # 0+1+2+...+999 = 499500
    print sum
end.
