# test_adv_053: Power function (iterative)
# Expected: 1, 8, 1024, 1

func power:
    in(base, exp)
    var result = 1
    var i = 0
    when i < exp loop
        result = result * base
        i = i + 1
    end.
    out result
end.
func main:
    print power(2, 0)
    print power(2, 3)
    print power(2, 10)
    print power(99, 0)
end.