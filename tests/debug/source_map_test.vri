# ═════════════════════════════════════════════════════════════════════
# tests/debug/source_map_test.vri — Native Source Map Span Verification
# Governed by VIRC-ISS-0050 / VIRC-PLN-0029 Phase 3 (Gate Nhóm 12)
# ═════════════════════════════════════════════════════════════════════

extern func syscall0(num: int) -> int
extern func syscall1(num: int, a0: int) -> int
extern func syscall2(num: int, a0: int, a1: int) -> int
extern func syscall3(num: int, a0: int, a1: int, a2: int) -> int
extern func syscall4(num: int, a0: int, a1: int, a2: int, a3: int) -> int
extern func syscall5(num: int, a0: int, a1: int, a2: int, a3: int, a4: int) -> int
extern func vir_get_platform() -> int
extern func usleep(usec: int) -> int
extern func kill(pid: int, sig: int) -> int
extern func exit_prog(code: int)

func s_strlen(s: int) -> int:
    if s == 0 do out 0 end
    var i = 0
    when read_byte(s, i) != 0 loop
        i = i + 1
    end
    out i
end.

func s_streq(a: int, b: int) -> int:
    if a == 0 and b == 0 do out 1 end
    if a == 0 or b == 0 do out 0 end
    let la = s_strlen(a)
    let lb = s_strlen(b)
    if la != lb do out 0 end
    var i = 0
    when i < la loop
        if read_byte(a, i) != read_byte(b, i) do out 0 end
        i = i + 1
    end
    out 1
end.

func s_concat2(a: int, b: int) -> int:
    let la = s_strlen(a)
    let lb = s_strlen(b)
    let res = alloc(la + lb + 1)
    var idx = 0
    var i = 0
    when i < la loop
        write_byte(res, idx, read_byte(a, i))
        idx = idx + 1
        i = i + 1
    end
    i = 0
    when i < lb loop
        write_byte(res, idx, read_byte(b, i))
        idx = idx + 1
        i = i + 1
    end
    write_byte(res, idx, 0)
    out res
end.

func s_concat3(a: int, b: int, c: int) -> int:
    out s_concat2(s_concat2(a, b), c)
end.

func s_find_str(haystack: int, needle: int) -> int:
    let hlen = s_strlen(haystack)
    let nlen = s_strlen(needle)
    if nlen == 0 do out 0 end
    if hlen < nlen do out -1 end
    var i = 0
    let limit = hlen - nlen
    when i <= limit loop
        var match = 1
        var j = 0
        when j < nlen loop
            if read_byte(haystack, i + j) != read_byte(needle, j) do
                match = 0
                j = nlen
            else
                j = j + 1
            end
        end
        if match == 1 do out i end
        i = i + 1
    end
    out -1
end.

func s_parse_int_after(s: int, key: int) -> int:
    let pos = s_find_str(s, key)
    if pos < 0 do out -1 end
    var p = pos + s_strlen(key)
    when read_byte(s, p) == 32 or read_byte(s, p) == 9 loop
        p = p + 1
    end
    var n = 0
    var has_digit = 0
    when read_byte(s, p) >= 48 and read_byte(s, p) <= 57 loop
        n = n * 10 + (read_byte(s, p) - 48)
        has_digit = 1
        p = p + 1
    end
    if has_digit == 0 do out -1 end
    out n
end.

func s_int_to_str(n: int) -> int:
    if n == 0 do
        let r = alloc(2)
        write_byte(r, 0, 48)
        write_byte(r, 1, 0)
        out r
    end
    var v = n
    var is_neg = 0
    if v < 0 do
        is_neg = 1
        v = 0 - v
    end
    let digits = alloc(32)
    var dlen = 0
    when v > 0 loop
        write_byte(digits, dlen, 48 + (v mod 10))
        v = v / 10
        dlen = dlen + 1
    end
    let res = alloc(dlen + is_neg + 1)
    var ri = 0
    if is_neg == 1 do
        write_byte(res, ri, 45)
        ri = ri + 1
    end
    var i = dlen - 1
    when i >= 0 loop
        write_byte(res, ri, read_byte(digits, i))
        ri = ri + 1
        i = i - 1
    end
    write_byte(res, ri, 0)
    out res
end.

func s_print(s: int):
    let len = s_strlen(s)
    if len > 0 do
        let plat = vir_get_platform()
        if plat == 2 or plat == 3 or plat == 4 do
            syscall3(1, 1, s, len)
        else
            syscall3(0x2000004, 1, s, len)
        end
    end
end.

func s_println(s: int):
    s_print(s)
    s_print("\n" as int)
end.

func sys_getpid() -> int:
    let plat = vir_get_platform()
    if plat == 2 or plat == 4 do out syscall0(172) end
    if plat == 3 do out syscall0(39) end
    out syscall0(0x2000014)
end.

func sys_fork() -> int:
    let plat = vir_get_platform()
    if plat == 2 or plat == 4 do out syscall5(220, 17, 0, 0, 0, 0) end
    if plat == 3 do out syscall0(57) end
    out syscall0(0x2000002)
end.

func sys_dup2(old_fd: int, new_fd: int) -> int:
    let plat = vir_get_platform()
    if plat == 2 or plat == 4 do out syscall3(24, old_fd, new_fd, 0) end
    if plat == 3 do out syscall2(33, old_fd, new_fd) end
    out syscall2(0x200005A, old_fd, new_fd)
end.

func sys_open_write(path: int) -> int:
    let plat = vir_get_platform()
    if plat == 2 or plat == 4 do out syscall4(56, -100, path, 577, 420) end
    if plat == 3 do out syscall3(2, path, 577, 420) end
    out syscall3(0x2000005, path, 0x0601, 420)
end.

func sys_close(fd: int) -> int:
    let plat = vir_get_platform()
    if plat == 2 or plat == 3 or plat == 4 do out syscall1(3, fd) end
    out syscall1(0x2000006, fd)
end.

func sys_wait4(pid: int, status_ptr: int, options: int) -> int:
    let plat = vir_get_platform()
    if plat == 2 or plat == 4 do out syscall4(260, pid, status_ptr, options, 0) end
    if plat == 3 do out syscall4(61, pid, status_ptr, options, 0) end
    out syscall4(0x2000007, pid, status_ptr, options, 0)
end.

func sys_execve(path: int, argv: int, envp: int) -> int:
    let plat = vir_get_platform()
    if plat == 2 or plat == 4 do out syscall3(221, path, argv, envp) end
    if plat == 3 do out syscall3(59, path, argv, envp) end
    out syscall3(0x200003B, path, argv, envp)
end.

func sys_unlink(path: int) -> int:
    let plat = vir_get_platform()
    if plat == 2 or plat == 4 do out syscall3(35, -100, path, 0) end
    if plat == 3 do out syscall1(87, path) end
    out syscall1(0x200000A, path)
end.

func sys_read_file(path: int) -> int:
    let plat = vir_get_platform()
    var fd = -1
    if plat == 2 or plat == 4 do
        fd = syscall4(56, -100, path, 0, 0)
    eif plat == 3 do
        fd = syscall3(2, path, 0, 0)
    else
        fd = syscall3(0x2000005, path, 0, 0)
    end
    if fd < 0 do out 0 end

    let cap = 65536
    let buf = alloc(cap)
    var total = 0
    if plat == 2 or plat == 3 or plat == 4 do
        total = syscall3(0, fd, buf, cap - 1)
    else
        total = syscall3(0x2000003, fd, buf, cap - 1)
    end
    sys_close(fd)
    if total <= 0 do out 0 end
    write_byte(buf, total, 0)
    out buf
end.

func run_virc_json(virc_bin: int, fixture: int, out_file: int) -> int:
    let my_pid = sys_getpid()
    let child_pid = sys_fork()
    let cur_pid = sys_getpid()

    if cur_pid != my_pid or child_pid == 0 do
        let out_fd = sys_open_write(out_file)
        if out_fd >= 0 do
            sys_dup2(out_fd, 1)
            sys_close(out_fd)
        end

        let argv = alloc(64)
        write_byte(argv, 0, 0)
        native_write_i64(argv, 0, virc_bin)
        native_write_i64(argv, 8, fixture)
        native_write_i64(argv, 16, "--check" as int)
        native_write_i64(argv, 24, "--json" as int)
        native_write_i64(argv, 32, 0)

        let envp = alloc(32)
        native_write_i64(envp, 0, "VIRC_UI=classic" as int)
        native_write_i64(envp, 8, "NO_COLOR=1" as int)
        native_write_i64(envp, 16, 0)

        sys_execve(virc_bin, argv, envp)
        exit_prog(127)
    end

    let st = alloc(8)
    var ticks = 0
    when ticks < 3000 loop
        let wpid = sys_wait4(child_pid, st, 1)
        if wpid == child_pid do
            let code = read_byte(st, 1)
            out code
        end
        usleep(10000)
        ticks = ticks + 1
    end
    kill(child_pid, 9)
    sys_wait4(child_pid, st, 0)
    out -999
end.

func check_span(virc_bin: int, fixture: int, expected_code: int, exp_sl: int, exp_sc: int, exp_el: int, exp_ec: int, out_file: int, is_mutation: int) -> int:
    let rc = run_virc_json(virc_bin, fixture, out_file)
    if rc == 0 do
        if is_mutation == 0 do
            s_println("  [FAIL] negative fixture unexpectedly passed!" as int)
        end
        out 0
    end

    let json = sys_read_file(out_file)
    if json == 0 do
        if is_mutation == 0 do
            s_println("  [FAIL] failed to read json output!" as int)
        end
        out 0
    end

    # Check expected code in json
    let code_key = s_concat3("\"code\":\"" as int, expected_code, "\"" as int)
    if s_find_str(json, code_key) < 0 do
        if is_mutation == 0 do
            s_print("  [FAIL] missing code " as int)
            s_print(expected_code)
            s_println(" in diagnostic output" as int)
        end
        out 0
    end

    # Check fixture in primary_span
    let file_key = s_concat3("\"file\":\"" as int, fixture, "\"" as int)
    let fpos = s_find_str(json, file_key)
    if fpos < 0 do
        if is_mutation == 0 do
            s_print("  [FAIL] missing file " as int)
            s_print(fixture)
            s_println(" in primary_span" as int)
        end
        out 0
    end

    let span_slice = json + fpos
    let sl = s_parse_int_after(span_slice, "\"start_line\":" as int)
    let sc = s_parse_int_after(span_slice, "\"start_column\":" as int)
    let el = s_parse_int_after(span_slice, "\"end_line\":" as int)
    let ec = s_parse_int_after(span_slice, "\"end_column\":" as int)

    if sl != exp_sl or sc != exp_sc or el != exp_el or ec != exp_ec do
        if is_mutation == 0 do
            s_print("  [FAIL] span mismatch! Got (" as int)
            s_print(s_int_to_str(sl))
            s_print(":" as int)
            s_print(s_int_to_str(sc))
            s_print("-" as int)
            s_print(s_int_to_str(el))
            s_print(":" as int)
            s_print(s_int_to_str(ec))
            s_print("), expected (" as int)
            s_print(s_int_to_str(exp_sl))
            s_print(":" as int)
            s_print(s_int_to_str(exp_sc))
            s_print("-" as int)
            s_print(s_int_to_str(exp_el))
            s_print(":" as int)
            s_print(s_int_to_str(exp_ec))
            s_println(")" as int)
        end
        out 0
    end

    if is_mutation == 0 do
        s_print("  [PASS] " as int)
        s_print(fixture)
        s_print(" (" as int)
        s_print(expected_code)
        s_print(" " as int)
        s_print(s_int_to_str(sl))
        s_print(":" as int)
        s_print(s_int_to_str(sc))
        s_print("-" as int)
        s_print(s_int_to_str(el))
        s_print(":" as int)
        s_print(s_int_to_str(ec))
        s_println(")" as int)
    end
    out 1
end.

func main():
    var virc_bin = "bin/virc" as int
    let argc = arg_count()
    var i = 1
    when i < argc loop
        let arg = get_arg(i) as int
        if s_streq(arg, "--virc" as int) == 1 and i + 1 < argc do
            virc_bin = get_arg(i + 1) as int
            i = i + 1
        end
        i = i + 1
    end

    s_println("=== Running Native Source Map Span Verification ===" as int)

    let pid = sys_getpid()
    let tmp_file = s_concat2("scratch/.tmp_span_" as int, s_concat2(s_int_to_str(pid), ".json" as int))

    var all_ok = 1

    # Case 1: UFCS unresolved receiver
    if check_span(virc_bin, "tests/strict_v2/ufcs_unresolved_receiver_rejected.vri" as int, "E2001" as int, 12, 15, 12, 25, tmp_file, 0) == 0 do
        all_ok = 0
    end

    # Case 2: UFCS entity receiver type mismatch
    if check_span(virc_bin, "tests/strict_v2/ufcs_entity_receiver_type_mismatch_rejected.vri" as int, "E3001" as int, 17, 15, 17, 18, tmp_file, 0) == 0 do
        all_ok = 0
    end

    # Case 3: UFCS free argument type mismatch
    if check_span(virc_bin, "tests/strict_v2/ufcs_free_arg_type_mismatch_rejected.vri" as int, "E3001" as int, 11, 23, 11, 26, tmp_file, 0) == 0 do
        all_ok = 0
    end

    # Case 4: Include boundary span
    if check_span(virc_bin, "tests/test_source_map_include_boundary_rejected.vri" as int, "E2001" as int, 7, 13, 7, 25, tmp_file, 0) == 0 do
        all_ok = 0
    end

    # Case 5: Import boundary span
    if check_span(virc_bin, "tests/test_source_map_import_boundary_rejected.vri" as int, "E2001" as int, 7, 13, 7, 25, tmp_file, 0) == 0 do
        all_ok = 0
    end

    # Mutation test: Verify that shifted span (expected line 8 != actual line 7) is rejected
    s_println("Running oracle mutation check (line shift rejection)..." as int)
    let mutated_res = check_span(virc_bin, "tests/test_source_map_include_boundary_rejected.vri" as int, "E2001" as int, 8, 13, 8, 25, tmp_file, 1)
    if mutated_res != 0 do
        s_println("  [FAIL] mutation test was unexpectedly accepted!" as int)
        all_ok = 0
    else
        s_println("  [PASS] oracle successfully rejected mutated span (expected 8 != actual 7)" as int)
    end

    sys_unlink(tmp_file)

    if all_ok == 1 do
        s_println("=== All 6 source map span tests PASSED successfully ===" as int)
        exit_prog(0)
    else
        s_println("=== Source map span tests FAILED ===" as int)
        exit_prog(1)
    end
end.
