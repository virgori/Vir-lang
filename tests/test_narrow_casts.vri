mold Packet16: u16
    low: 8, high: 8
end.

mold Packet8: u8
    b: 8
end.

func main:
    var a: u8 = 300 as u8
    print a as i64

    var b: u8 = -5 as u8
    print b as i64

    var c: i16 = 481036381006 as i16
    print c as i64

    var d: u16 = 481036381006 as u16
    print d as i64

    var e: u32 = 0x123456789abcdef0 as u32
    print e as i64

    var f: i32 = 0x123456789abcdef0 as i32
    print f as i64

    var g: i8 = 0x123456789abcdef0 as i8
    print g as i64

    var h: u8 = 0x123456789abcdef0 as u8
    print h as i64

    var p16: Packet16 = 481036381006 as Packet16
    print (p16 as u16) as i64

    var p8: Packet8 = 300 as Packet8
    print (p8 as u8) as i64
end.
