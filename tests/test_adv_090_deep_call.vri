# test_adv_090: Nested function calls 4-deep
# Expected: 120

func f1:
    in(x)
    out x * 2
end.
func f2:
    in(x)
    var r = f1(x)
    out r + 10
end.
func f3:
    in(x)
    var r = f2(x)
    out r * 2
end.
func f4:
    in(x)
    var r = f3(x)
    out r + 0
end.
func main:
    # f4(5) = f3(5)+0 = f2(5)*2+0 = (f1(5)+10)*2 = (10+10)*2 = 40... 
    # Wait: f4(5) = f3(5) = f2(5)*2 = (f1(5)+10)*2 = (10+10)*2 = 40
    # That's 40, not 120. Let me recalculate with different inputs.
    # f4(25): f3(25) = f2(25)*2 = (f1(25)+10)*2 = (50+10)*2 = 120
    var r = f4(25)
    print r
end.