# test_adv_099: Complex entity operations - distance calculation
# Expected: 25

entity Point:
    x
    y
end.
func dist_sq:
    in(a, b)
    var dx = a.x - b.x
    var dy = a.y - b.y
    out dx * dx + dy * dy
end.
func main:
    var p1 = Point(x: 0, y: 0)
    var p2 = Point(x: 3, y: 4)
    var d = dist_sq(p1, p2)
    # d = 9 + 16 = 25
    print d
end.