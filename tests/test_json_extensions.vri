include vir.data.json

extern func native_read_u8(addr: int, offset: int) -> int

func test_str_eq(a: string, b: string) -> bool:
    let pa = a as int
    let pb = b as int
    if pa == pb do out true end
    if pa == 0 or pb == 0 do out false end
    var i = 0
    loop
        let ca = native_read_u8(pa, i)
        let cb = native_read_u8(pb, i)
        if ca != cb do out false end
        if ca == 0 do out true end
        i = i + 1
    end
    out true
end.

func main:
    # 1. Test fromInts
    let ints = [10, 20, 30]
    let arr_int = json.fromInts(ints)
    if json.count(arr_int) == 3 do
        let a0 = json.at(arr_int, 0)
        let a1 = json.at(arr_int, 1)
        let a2 = json.at(arr_int, 2)
        case a0
            Some(v0):
                case a1
                    Some(v1):
                        case a2
                            Some(v2):
                                if as_int(v0) == 10 and as_int(v1) == 20 and as_int(v2) == 30 do
                                    print 1
                                end
                            None: print 0
                        end
                    None: print 0
                end
            None: print 0
        end
    end

    # 2. Test fromStrings
    let strs = ["alpha", "beta", "gamma"]
    let arr_str = json.fromStrings(strs)
    if json.count(arr_str) == 3 do
        let s0 = json.at(arr_str, 0)
        let s2 = json.at(arr_str, 2)
        case s0
            Some(v0):
                case s2
                    Some(v2):
                        if test_str_eq(as_string(v0), "alpha") and test_str_eq(as_string(v2), "gamma") do
                            print 2
                        end
                    None: print 0
                end
            None: print 0
        end
    end

    # 3. Test fromBools
    let bools = [true, false, true]
    let arr_bool = json.fromBools(bools)
    if json.count(arr_bool) == 3 do
        let b0 = json.at(arr_bool, 0)
        let b1 = json.at(arr_bool, 1)
        let b2 = json.at(arr_bool, 2)
        case b0
            Some(v0):
                case b1
                    Some(v1):
                        case b2
                            Some(v2):
                                if as_bool(v0) == true and as_bool(v1) == false and as_bool(v2) == true do
                                    print 3
                                end
                            None: print 0
                        end
                    None: print 0
                end
            None: print 0
        end
    end

    # 4. Prepare test object
    let obj = json.object()
    json.set(obj, "port", json.number(8080))
    json.set(obj, "host", json.string("127.0.0.1"))
    json.set(obj, "debug", json.bool(true))
    json.set(obj, "null_field", json.null())

    # 5. Test getInt
    let p1 = json.getInt(obj, "port", 3000)
    let p2 = json.getInt(obj, "missing", 3000)
    let p3 = json.getInt(obj, "host", 3000)
    let p4 = json.getInt(obj, "null_field", 3000)
    if p1 == 8080 and p2 == 3000 and p3 == 3000 and p4 == 3000 do
        print 4
    end

    # 6. Test getStr
    let h1 = json.getStr(obj, "host", "localhost")
    let h2 = json.getStr(obj, "missing", "localhost")
    let h3 = json.getStr(obj, "port", "localhost")
    let h4 = json.getStr(obj, "null_field", "localhost")
    if test_str_eq(h1, "127.0.0.1") and test_str_eq(h2, "localhost") and test_str_eq(h3, "localhost") and test_str_eq(h4, "localhost") do
        print 5
    end

    # 7. Test getBool
    let b1 = json.getBool(obj, "debug", false)
    let b2 = json.getBool(obj, "missing", false)
    let b3 = json.getBool(obj, "port", false)
    let b4 = json.getBool(obj, "null_field", true)
    if b1 == true and b2 == false and b3 == false and b4 == true do
        print 6
    end

    # 8. Test UFCS syntax
    let ufcs_p = obj.getInt("port", 3000)
    let ufcs_h = obj.getStr("host", "def")
    let ufcs_b = obj.getBool("debug", false)
    if ufcs_p == 8080 and test_str_eq(ufcs_h, "127.0.0.1") and ufcs_b == true do
        print 7
    end

    print 999
    out 0
end.
