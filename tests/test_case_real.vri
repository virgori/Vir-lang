# test_case_real: case arms end with ';', statements inside one arm use ','
# Also verifies that commas inside function-call arguments do not split statements.
# Expected:
# 5
# 1
# -1

func sum2:
    in(a, b)
    out a + b
end.
func classify:
    in(n)
    case n
        10: var x = sum2(1, 9), out 1;
        20: var x = sum2(2, 18), out 2;
        50: var x = sum2(5, 45), out 5;
        else var x = sum2(-1, 0), out -1
    end.
end.
func main:
    print classify(50)
    print classify(10)
    print classify(7)
end.
