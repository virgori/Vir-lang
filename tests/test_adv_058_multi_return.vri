# test_adv_058: Multiple return simulation via entity
# Expected: 5, 2

entity Pair:
    first
    second
end.

func divmod(a, b):
    var q = a / b
    var r = a % b
    out Pair(first: q, second: r)
end.

func main:
    var result = divmod(17, 3)
    print result.first
    print result.second
end.
