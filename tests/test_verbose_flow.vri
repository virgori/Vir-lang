extern func native_read_u8(addr: int, offset: int) -> int;
extern func syscall3(n: int, a1: int, a2: int, a3: int) -> int;
extern func syscall6(n: int, a1: int, a2: int, a3: int, a4: int, a5: int, a6: int) -> int;

const STDOUT_FD: 1;
const SYS_WRITE: 0x2000004;
const SYS_READ: 0x2000003;
const SYS_OPEN: 0x2000005;
const SYS_CLOSE: 0x2000006;
const SYS_MMAP: 0x20000C5;
const O_RDONLY: 0;
const PROT_READ: 1;
const PROT_WRITE: 2;
const MAP_PRIVATE: 2;
const MAP_ANONYMOUS: 4096;

func sys_write:
    in(fd: int, buf: int, count: int)
    out syscall3(SYS_WRITE, fd, buf, count);
end.

func sys_read:
    in(fd: int, buf: int, count: int)
    out syscall3(SYS_READ, fd, buf, count);
end.

func sys_open:
    in(path: int, flags: int, mode: int)
    out syscall3(SYS_OPEN, path, flags, mode);
end.

func sys_close:
    in(fd: int)
    out syscall3(SYS_CLOSE, fd, 0, 0);
end.

func sys_mmap:
    in(addr: int, length: int, prot: int, flags: int, fd: int, offset: int)
    out syscall6(SYS_MMAP, addr, length, prot, flags, fd, offset);
end.

func rt_strlen:
    in(s: int)
    if s == 0 do
        out 0
    end
    let i = 0
    when native_read_u8(s, i) != 0 loop
        i = i + 1
    end
    out i
end.

func print_str:
    in(s: int)
    sys_write(STDOUT_FD, s, rt_strlen(s));
end.

func print_ln:
    in(s: int)
    print_str(s);
    print_str("\n");
end.

func vir_alloc:
    in(size: int)
    out sys_mmap(0, size, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
end.

func read_file_simple:
    in(path: int)
    let fd = sys_open(path, O_RDONLY, 0);
    if fd < 0 do
        out 0;
    end
    let buf = vir_alloc(4096);
    let n = sys_read(fd, buf, 4096);
    sys_close(fd);
    if n <= 0 do
        out 0;
    end
    out buf;
end.

func main:
    let verbose = 1;
    if verbose == 1 do
        print_ln("virc: reading...");
    end
    let src = read_file_simple("tests/test_basic_42.vri");
    if src == 0 do
        print_ln("read failed");
        out 1;
    end
    if verbose == 1 do
        print_ln("virc: tokenizing...");
    end
    out 0
end.
