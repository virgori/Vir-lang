# test_adv_033: Matrix multiply 3x3 using flat arrays
# Expected: 30, 36, 42, 66, 81, 96, 102, 126, 150

func mat_get:
    in(m, r, c)
    var idx = r * 3 + c
    out m[idx]
end.
func main:
    # Matrix A = [[1,2,3],[4,5,6],[7,8,9]]
    var a = arr_new(16)
    push(a, 1)
    push(a, 2)
    push(a, 3)
    push(a, 4)
    push(a, 5)
    push(a, 6)
    push(a, 7)
    push(a, 8)
    push(a, 9)

    # Matrix B = [[1,2,3],[4,5,6],[7,8,9]]
    var b = arr_new(16)
    push(b, 1)
    push(b, 2)
    push(b, 3)
    push(b, 4)
    push(b, 5)
    push(b, 6)
    push(b, 7)
    push(b, 8)
    push(b, 9)

    # Result C = A * B
    var c = arr_new(16)
    var i = 0
    when i < 9 loop
        push(c, 0)
        i = i + 1
    end.

    i = 0
    when i < 3 loop
        var j = 0
        when j < 3 loop
            var sum = 0
            var k = 0
            when k < 3 loop
                var av = mat_get(a, i, k)
                var bv = mat_get(b, k, j)
                sum = sum + av * bv
                k = k + 1
            end.
            var idx = i * 3 + j
            c[idx] = sum
            j = j + 1
        end.
        i = i + 1
    end.

    var p = 0
    when p < 9 loop
        print c[p]
        p = p + 1
    end.
end.
