func main():
    var nums = [1, 2, 3, 4]
    var doubled = map x in nums:
        out x * 2
    end.
    print doubled[0]
    print doubled[1]
    print doubled[2]
    print doubled[3]
    print len(doubled)

    var evens = map x in nums:
        if x % 2 == 0 do
            out x
        end
    end
    print len(evens)
    print evens[0]
    print evens[1]
end
