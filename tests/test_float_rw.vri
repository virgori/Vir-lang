# EXPECT: FLOAT MATCH EXACT!
include types
include alloc
import alloc, free from alloc
include vir.rt.io
import print_str, print_ln from vir.rt.io

func main():
    var p = alloc(32)
    var f: float = 3.14159
    native_write_i64(p as int, 0, f as int)
    var f2: float = native_read_i64(p as int, 0) as float
    if f2 == 3.0 do
        print_ln("FLOAT MATCH EXACT!")
    else
        print_ln("FLOAT MISMATCH")
    end
    out 0
end.
