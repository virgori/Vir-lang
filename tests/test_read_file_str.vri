extern func native_read_u8(addr: int, offset: int) -> int;
extern func syscall3(n: int, a1: int, a2: int, a3: int) -> int;
extern func syscall6(n: int, a1: int, a2: int, a3: int, a4: int, a5: int, a6: int) -> int;

const STDOUT_FD: 1;
const SYS_WRITE: 0x2000004;
const SYS_READ: 0x2000003;
const SYS_OPEN: 0x2000005;
const SYS_CLOSE: 0x2000006;
const O_RDONLY: 0;

func sys_write:
    in(fd: int, buf: int, count: int)
    out syscall3(SYS_WRITE, fd, buf, count);
end.

func sys_read:
    in(fd: int, buf: int, count: int)
    out syscall3(SYS_READ, fd, buf, count);
end.

func sys_open:
    in(path: int, flags: int, mode: int)
    out syscall3(SYS_OPEN, path, flags, mode);
end.

func sys_close:
    in(fd: int)
    out syscall3(SYS_CLOSE, fd, 0, 0);
end.

const SYS_MMAP: 0x20000C5;
const PROT_WRITE: 2;
const MAP_PRIVATE: 2;
const MAP_ANONYMOUS: 4096;

func vir_alloc:
    in(size: int)
    out sys_mmap(0, size, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
end.

func rt_strlen:
    in(s: int)
    if s == 0:
        out 0
    end
    let i = 0
    when native_read_u8(s, i) != 0 loop
        i = i + 1
    end
    out i
end.

entity FileHandle:
    fd: int;
    is_open: int;
end.

func file_open_read:
    in(path: int)
    let fd = sys_open(path, O_RDONLY, 0);
    if fd < 0:
        out FileHandle ( fd: -1, is_open: 0 );
    end
    out FileHandle ( fd: fd, is_open: 1 );
end.

func file_read_all:
    in(f: FileHandle)
    let buf = vir_alloc(4096);
    let n = sys_read(f.fd, buf, 4096);
    if n <= 0:
        out 0;
    end
    out buf;
end.

func file_close:
    in(f: FileHandle)
    if f.is_open == 1:
        sys_close(f.fd);
    end
end.

func read_file_str:
    in(path: int)
    let f = file_open_read(path);
    if f.is_open == 0:
        out 0;
    end
    let content = file_read_all(f);
    file_close(f);
    out content;
end.

func print_int:
    in(n: int)
    if n == 0:
        sys_write(STDOUT_FD, "0", 1);
        out 0;
    end
    out 0
end.

func main:
    let path = "tests/test_basic_42.vri";
    let content = read_file_str(path);
    print content;
    print rt_strlen(content);
    out 0
end.
