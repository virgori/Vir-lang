# test_adv_095: Mutual recursion with counters
# Expected: 1

var calls = 0

func ping:
    in(n)
    calls = calls + 1
    if n <= 0 do
        out 0
    end
    out pong(n - 1)
end.
func pong:
    in(n)
    calls = calls + 1
    if n <= 0 do
        out 0
    end
    out ping(n - 1)
end.
func main:
    ping(10)
    # ping/pong alternate, 10 + 1 calls total = 11
    # But we print a flag showing it completed
    print 1
end.
