# test_adv_032: Sorting - bubble sort on array
# Expected: 1, 2, 3, 4, 5

func main:
    var arr = arr_new(8)
    push(arr, 5)
    push(arr, 3)
    push(arr, 1)
    push(arr, 4)
    push(arr, 2)

    var n = len(arr)
    var i = 0
    when i < n loop
        var j = 0
        when j < n - 1 - i loop
            var a = arr[j]
            var b = arr[j + 1]
            if a > b do
                arr[j] = b
                arr[j + 1] = a
            end
            j = j + 1
        end.
        i = i + 1
    end.

    var k = 0
    when k < n loop
        print arr[k]
        k = k + 1
    end.
end.
