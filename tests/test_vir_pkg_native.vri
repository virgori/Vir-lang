# ═════════════════════════════════════════════════════════════════════
# Test Suite: Vir Native Package Manager (Pure Vir Verification)
# ═════════════════════════════════════════════════════════════════════

func cstr_len(s):
    if s == 0 do out 0 end
    var i = 0
    when read_byte(s, i) != 0 loop
        i = i + 1
    end
    out i
end.

func cstr_eq(a, b):
    if a == 0 do
        if b == 0 do out 1 end
        out 0
    end
    if b == 0 do out 0 end
    let la = cstr_len(a)
    let lb = cstr_len(b)
    if la != lb do out 0 end
    var i = 0
    when i < la loop
        if read_byte(a, i) != read_byte(b, i) do
            out 0
        end
        i = i + 1
    end
    out 1
end.

func print_raw(s):
    if s == 0 do out 0 end
    let slen = cstr_len(s)
    if slen == 0 do out 0 end
    write_bytes("/dev/stdout", s, slen)
    out slen
end.

func print_raw_ln(s):
    print_raw(s)
    write_bytes("/dev/stdout", "\n", 1)
    out 0
end.

# ═════════════════════════════════════════════════════════════════════
# SemVer 2.0.0 Logic
# ═════════════════════════════════════════════════════════════════════

func semver_create:
    let sv = alloc(24)
    write_word(sv, 0, 0)
    write_word(sv, 8, 0)
    write_word(sv, 16, 0)
    out sv
end.

func semver_parse(src, sv):
    let slen = cstr_len(src)
    var p = 0

    var maj = 0
    when (p < slen) and (read_byte(src, p) >= 48) and (read_byte(src, p) <= 57) loop
        maj = maj * 10 + (read_byte(src, p) - 48)
        p = p + 1
    end
    write_word(sv, 0, maj)

    if p >= slen do out 0 end
    if read_byte(src, p) != 46 do out 0 end
    p = p + 1

    var min = 0
    when (p < slen) and (read_byte(src, p) >= 48) and (read_byte(src, p) <= 57) loop
        min = min * 10 + (read_byte(src, p) - 48)
        p = p + 1
    end
    write_word(sv, 8, min)

    if p >= slen do out 0 end
    if read_byte(src, p) != 46 do out 0 end
    p = p + 1

    var pat = 0
    when (p < slen) and (read_byte(src, p) >= 48) and (read_byte(src, p) <= 57) loop
        pat = pat * 10 + (read_byte(src, p) - 48)
        p = p + 1
    end
    write_word(sv, 16, pat)

    out 1
end.

func semver_cmp(a, b):
    let maj_a = read_word(a, 0)
    let maj_b = read_word(b, 0)
    if maj_a > maj_b do out 1 end
    if maj_a < maj_b do out 0 - 1 end

    let min_a = read_word(a, 8)
    let min_b = read_word(b, 8)
    if min_a > min_b do out 1 end
    if min_a < min_b do out 0 - 1 end

    let pat_a = read_word(a, 16)
    let pat_b = read_word(b, 16)
    if pat_a > pat_b do out 1 end
    if pat_a < pat_b do out 0 - 1 end

    out 0
end.

func semver_satisfies_caret(ver, base):
    let maj_v = read_word(ver, 0)
    let maj_b = read_word(base, 0)
    let min_v = read_word(ver, 8)
    let min_b = read_word(base, 8)
    let pat_v = read_word(ver, 16)
    let pat_b = read_word(base, 16)

    if maj_b > 0 do
        if maj_v != maj_b do out 0 end
        if semver_cmp(ver, base) >= 0 do out 1 end
        out 0
    end

    if min_b > 0 do
        if maj_v != 0 do out 0 end
        if min_v != min_b do out 0 end
        if pat_v >= pat_b do out 1 end
        out 0
    end

    if maj_v != 0 do out 0 end
    if min_v != 0 do out 0 end
    if pat_v == pat_b do out 1 end
    out 0
end.

func semver_satisfies_tilde(ver, base):
    let maj_v = read_word(ver, 0)
    let maj_b = read_word(base, 0)
    let min_v = read_word(ver, 8)
    let min_b = read_word(base, 8)
    if maj_v != maj_b do out 0 end
    if min_v != min_b do out 0 end
    if semver_cmp(ver, base) >= 0 do out 1 end
    out 0
end.

func semver_satisfies_gte(ver, base):
    if semver_cmp(ver, base) >= 0 do out 1 end
    out 0
end.

# ═════════════════════════════════════════════════════════════════════
# Checksum & Hash Logic
# ═════════════════════════════════════════════════════════════════════

func fnv1a_hash(str_ptr):
    if str_ptr == 0 do out 0 end
    let slen = cstr_len(str_ptr)
    var h = 14695981039346656037
    var i = 0
    when i < slen loop
        let b = read_byte(str_ptr, i)
        h = h xor b
        h = h * 1099511628211
        i = i + 1
    end
    out h
end.

func hex_u64(val, buf):
    let hex_chars = "0123456789abcdef"
    var i = 15
    var v = val
    when i >= 0 loop
        let digit = v & 15
        write_byte(buf, i, read_byte(hex_chars, digit))
        v = v shr 4
        i = i - 1
    end
    write_byte(buf, 16, 0)
    out buf
end.

# ═════════════════════════════════════════════════════════════════════
# DAG Topological Sort & Cycle Detection
# ═════════════════════════════════════════════════════════════════════

func pkg_create(name, version, deps_array, dep_count):
    let p = alloc(40)
    write_word(p, 0, name)
    write_word(p, 8, version)
    write_word(p, 16, dep_count)
    write_word(p, 24, deps_array)
    write_word(p, 32, 0)
    out p
end.

func topo_sort_visit(pkgs, node_idx, out_order, order_idx):
    let node = read_word(pkgs, node_idx * 8)
    let status = read_word(node, 32)
    if status == 2 do
        out order_idx
    end
    if status == 1 do
        out 0 - 1
    end

    write_word(node, 32, 1)

    let dep_cnt = read_word(node, 16)
    let deps = read_word(node, 24)
    var i = 0
    when i < dep_cnt loop
        let dep_idx = read_word(deps, i * 8)
        order_idx = topo_sort_visit(pkgs, dep_idx, out_order, order_idx)
        if order_idx < 0 do
            out 0 - 1
        end
        i = i + 1
    end

    write_word(node, 32, 2)
    write_word(out_order, order_idx * 8, node_idx)
    out order_idx + 1
end.

func topo_sort(pkgs, count, out_order):
    var order_idx = 0
    var i = 0
    when i < count loop
        let node = read_word(pkgs, i * 8)
        let status = read_word(node, 32)
        if status == 0 do
            order_idx = topo_sort_visit(pkgs, i, out_order, order_idx)
            if order_idx < 0 do
                out 0 - 1
            end
        end
        i = i + 1
    end
    out order_idx
end.

# ═════════════════════════════════════════════════════════════════════
# Assertion Helpers
# ═════════════════════════════════════════════════════════════════════

func check_assert(cond, test_name):
    if cond == 0 do
        print_raw("  [FAIL] ")
        print_raw_ln(test_name)
        out 0
    end
    print_raw("  [PASS] ")
    print_raw_ln(test_name)
    out 1
end.

# ═════════════════════════════════════════════════════════════════════
# Main Test Runner
# ═════════════════════════════════════════════════════════════════════

func main:
    print_raw_ln("==================================================")
    print_raw_ln("   VIR NATIVE PACKAGE MANAGER TEST SUITE (100% VRI)")
    print_raw_ln("==================================================")

    var failures = 0

    # -------------------------------------------------------------
    # Test 1: SemVer 2.0.0 Parsing
    # -------------------------------------------------------------
    let sv1 = semver_create()
    let ok1 = semver_parse("2.14.99", sv1)
    var pass1 = ok1
    if read_word(sv1, 0) != 2 do pass1 = 0 end
    if read_word(sv1, 8) != 14 do pass1 = 0 end
    if read_word(sv1, 16) != 99 do pass1 = 0 end
    if check_assert(pass1, "Test 1: SemVer 2.0.0 Parsing (2.14.99)") == 0 do
        failures = failures + 1
    end

    # -------------------------------------------------------------
    # Test 2: SemVer Comparison (<, ==, >)
    # -------------------------------------------------------------
    let sva = semver_create()
    let svb = semver_create()
    semver_parse("1.2.3", sva)
    semver_parse("1.2.3", svb)
    var pass2 = 1
    if semver_cmp(sva, svb) != 0 do pass2 = 0 end

    semver_parse("1.2.4", svb)
    if semver_cmp(sva, svb) != (0 - 1) do pass2 = 0 end

    semver_parse("2.0.0", sva)
    semver_parse("1.9.9", svb)
    if semver_cmp(sva, svb) != 1 do pass2 = 0 end
    if check_assert(pass2, "Test 2: SemVer Comparison (<, ==, >)") == 0 do
        failures = failures + 1
    end

    # -------------------------------------------------------------
    # Test 3: Caret Constraint Matching (^)
    # -------------------------------------------------------------
    let req_caret = semver_create()
    let cand_caret = semver_create()
    semver_parse("1.2.0", req_caret)

    semver_parse("1.2.5", cand_caret)
    var pass3 = semver_satisfies_caret(cand_caret, req_caret)

    semver_parse("1.9.0", cand_caret)
    if semver_satisfies_caret(cand_caret, req_caret) != 1 do pass3 = 0 end

    semver_parse("2.0.0", cand_caret)
    if semver_satisfies_caret(cand_caret, req_caret) != 0 do pass3 = 0 end

    # Test 0.x caret behavior: ^0.2.0 matches 0.2.3, rejects 0.3.0
    semver_parse("0.2.0", req_caret)
    semver_parse("0.2.3", cand_caret)
    if semver_satisfies_caret(cand_caret, req_caret) != 1 do pass3 = 0 end

    semver_parse("0.3.0", cand_caret)
    if semver_satisfies_caret(cand_caret, req_caret) != 0 do pass3 = 0 end

    if check_assert(pass3, "Test 3: Caret Constraint Matching (^1.2.0 and ^0.2.0)") == 0 do
        failures = failures + 1
    end

    # -------------------------------------------------------------
    # Test 4: Tilde Constraint Matching (~)
    # -------------------------------------------------------------
    let req_tilde = semver_create()
    let cand_tilde = semver_create()
    semver_parse("1.2.0", req_tilde)

    semver_parse("1.2.8", cand_tilde)
    var pass4 = semver_satisfies_tilde(cand_tilde, req_tilde)

    semver_parse("1.3.0", cand_tilde)
    if semver_satisfies_tilde(cand_tilde, req_tilde) != 0 do pass4 = 0 end

    semver_parse("1.1.9", cand_tilde)
    if semver_satisfies_tilde(cand_tilde, req_tilde) != 0 do pass4 = 0 end

    if check_assert(pass4, "Test 4: Tilde Constraint Matching (~1.2.0)") == 0 do
        failures = failures + 1
    end

    # -------------------------------------------------------------
    # Test 5: Greater-Than-or-Equal Matching (>=)
    # -------------------------------------------------------------
    let req_gte = semver_create()
    let cand_gte = semver_create()
    semver_parse("1.5.0", req_gte)

    semver_parse("1.5.0", cand_gte)
    var pass5 = semver_satisfies_gte(cand_gte, req_gte)

    semver_parse("2.0.1", cand_gte)
    if semver_satisfies_gte(cand_gte, req_gte) != 1 do pass5 = 0 end

    semver_parse("1.4.9", cand_gte)
    if semver_satisfies_gte(cand_gte, req_gte) != 0 do pass5 = 0 end

    if check_assert(pass5, "Test 5: Greater-Than-or-Equal (>=1.5.0)") == 0 do
        failures = failures + 1
    end

    # -------------------------------------------------------------
    # Test 6: Deterministic FNV-1a Checksum
    # -------------------------------------------------------------
    let h1 = fnv1a_hash("vir_pkg_demo_checksum")
    let h2 = fnv1a_hash("vir_pkg_demo_checksum")
    let h3 = fnv1a_hash("vir_pkg_demo_checksum_diff")
    var pass6 = 0
    if h1 != 0 do
        if h1 == h2 do
            if h1 != h3 do
                pass6 = 1
            end
        end
    end
    if check_assert(pass6, "Test 6: FNV-1a 64-bit Deterministic Hashing") == 0 do
        failures = failures + 1
    end

    # -------------------------------------------------------------
    # Test 7: Hex Formatting for Checksum Hashes
    # -------------------------------------------------------------
    let hex_buf = alloc(32)
    hex_u64(1311768467463790320, hex_buf) # 0x123456789abcdef0
    let pass7 = cstr_eq(hex_buf, "123456789abcdef0")
    if check_assert(pass7, "Test 7: Hexadecimal 64-bit Serialization") == 0 do
        failures = failures + 1
    end

    # -------------------------------------------------------------
    # Test 8: DAG Topological Sort Build Order
    # -------------------------------------------------------------
    # 3 packages:
    # 0: core (0 deps)
    # 1: middle (depends on 0)
    # 2: top (depends on 1)
    let pkgs = alloc(24)
    let deps_core = alloc(8)
    let deps_mid = alloc(8)
    write_word(deps_mid, 0, 0)
    let deps_top = alloc(8)
    write_word(deps_top, 0, 1)

    write_word(pkgs, 0, pkg_create("core", "1.0.0", deps_core, 0))
    write_word(pkgs, 8, pkg_create("mid", "1.0.0", deps_mid, 1))
    write_word(pkgs, 16, pkg_create("top", "1.0.0", deps_top, 1))

    let out_order = alloc(24)
    let sorted_count = topo_sort(pkgs, 3, out_order)

    var pass8 = 0
    if sorted_count == 3 do
        # Build order must be: 0 (core), then 1 (mid), then 2 (top)
        if read_word(out_order, 0) == 0 do
            if read_word(out_order, 8) == 1 do
                if read_word(out_order, 16) == 2 do
                    pass8 = 1
                end
            end
        end
    end
    if check_assert(pass8, "Test 8: Topological DAG Dependency Ordering") == 0 do
        failures = failures + 1
    end

    # -------------------------------------------------------------
    # Test 9: Cycle Detection in Dependency Graph
    # -------------------------------------------------------------
    # A -> B -> A (Cycle)
    let cyclic_pkgs = alloc(16)
    let deps_a = alloc(8)
    write_word(deps_a, 0, 1) # A depends on B
    let deps_b = alloc(8)
    write_word(deps_b, 0, 0) # B depends on A

    write_word(cyclic_pkgs, 0, pkg_create("pkg_a", "1.0.0", deps_a, 1))
    write_word(cyclic_pkgs, 8, pkg_create("pkg_b", "1.0.0", deps_b, 1))

    let cyclic_order = alloc(16)
    let cycle_res = topo_sort(cyclic_pkgs, 2, cyclic_order)
    var pass9 = 0
    if cycle_res < 0 do
        pass9 = 1
    end
    if check_assert(pass9, "Test 9: Circular Dependency Cycle Detection (Returns -1)") == 0 do
        failures = failures + 1
    end

    # -------------------------------------------------------------
    # Test 10: Manifest & Lockfile Model Verification
    # -------------------------------------------------------------
    let sample_name = "vir_auth"
    let sample_ver = "1.0.0"
    let sample_hash = fnv1a_hash(sample_name)
    let hbuf = alloc(32)
    hex_u64(sample_hash, hbuf)

    var pass10 = 0
    if cstr_len(hbuf) == 16 do
        pass10 = 1
    end
    if check_assert(pass10, "Test 10: Lockfile 64-bit Checksum Digest Generation") == 0 do
        failures = failures + 1
    end

    # -------------------------------------------------------------
    # Results Summary
    # -------------------------------------------------------------
    print_raw_ln("--------------------------------------------------")
    if failures == 0 do
        print_raw_ln("ALL 10 VIR PACKAGE MANAGER TESTS PASSED (100% OK)")
        print_raw_ln("--------------------------------------------------")
        out 0
    end

    print_raw("FAILURES DETECTED: ")
    print_raw_ln(int_to_str(failures))
    print_raw_ln("--------------------------------------------------")
    out 1
end.
