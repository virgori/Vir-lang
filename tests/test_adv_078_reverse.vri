# test_adv_078: Array reverse in-place
# Expected: 5, 4, 3, 2, 1

func swap:
    in(arr, i, j)
    var tmp = arr[i]
    arr[i] = arr[j]
    arr[j] = tmp
end.
func main:
    var arr = arr_new(8)
    push(arr, 1)
    push(arr, 2)
    push(arr, 3)
    push(arr, 4)
    push(arr, 5)

    var lo = 0
    var hi = 4
    when lo < hi loop
        swap(arr, lo, hi)
        lo = lo + 1
        hi = hi - 1
    end.

    var i = 0
    when i < 5 loop
        print arr[i]
        i = i + 1
    end.
end.
