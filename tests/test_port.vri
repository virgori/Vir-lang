# §23 Port + send + recv + select
port q: int(cap: 4)
port r: int(cap: 4)

func main:
    send q <- 10
    send q <- 20
    send q <- 30

    var x = recv q
    print x
    var y = recv q
    print y

    send r <- 99
    select:
        case recv v from q:
            print v
        case recv w from r:
            print w
    end
    # Drain r in second select
    select:
        case recv v2 from q:
            print v2
        case recv w2 from r:
            print w2
    end

    # recv on empty port returns -1
    print recv q
end.
