func main:
    # i_to_str
    var s = i_to_str(42)
    print_str(s)

    # str_to_i
    var n = str_to_i("123")
    print n

    # str_eq
    var eq1 = str_eq("hello", "hello")
    print eq1
    var eq2 = str_eq("hello", "world")
    print eq2

    # str_get
    var c = str_get("ABC", 1)
    print c
end.