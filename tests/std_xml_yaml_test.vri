include vir.data.xml
include vir.data.yaml

extern func native_read_u8(addr: int, offset: int) -> int

func test_str_eq(a: string, b: string) -> bool:
    let pa = a as int
    let pb = b as int
    if pa == pb do out true end
    if pa == 0 or pb == 0 do out false end
    var i = 0
    loop
        let ca = native_read_u8(pa, i)
        let cb = native_read_u8(pb, i)
        if ca != cb do out false end
        if ca == 0 do out true end
        i = i + 1
    end
    out true
end.

func main:
    # 1. Simple element with text
    let xml1 = "<greeting>Hello Vir</greeting>"
    let r1 = xml_parse(xml1)
    case r1
        Ok(node1):
            if test_str_eq(xml_get_tag(node1), "greeting") and xml_children_len(node1) == 1 do
                let child = xml_child_at(node1, 0)
                if xml_get_type(child) == XmlNodeType.Text and test_str_eq(xml_get_text(child), "Hello Vir") do
                    print 1
                end
            end
        Err(_): print 0
    end

    # 2. Attributes and text
    let xml2 = "<user id=\"42\" role=\"admin\">Alice</user>"
    let r2 = xml_parse(xml2)
    case r2
        Ok(node2):
            let opt_id = xml_get_attr(node2, "id")
            case opt_id
                Some(id_val):
                    if test_str_eq(id_val, "42") do
                        let opt_role = xml_get_attr(node2, "role")
                        case opt_role
                            Some(role_val):
                                if test_str_eq(role_val, "admin") do print 2 end
                            None: print 0
                        end
                    end
                None: print 0
            end
        Err(_): print 0
    end

    # 3. Self-closing tag with attributes
    let xml3 = "<img src=\"logo.png\" alt=\"Vir Logo\"/>"
    let r3 = xml_parse(xml3)
    case r3
        Ok(node3):
            if test_str_eq(xml_get_tag(node3), "img") and xml_children_len(node3) == 0 do
                let opt_src = xml_get_attr(node3, "src")
                case opt_src
                    Some(s):
                        if test_str_eq(s, "logo.png") do print 3 end
                    None: print 0
                end
            end
        Err(_): print 0
    end

    # 4. XML Entity decoding: &amp;, &lt;, &gt;, &quot;, &apos;
    let xml4 = "<data>&amp; &lt; &gt; &quot; &apos;</data>"
    let r4 = xml_parse(xml4)
    case r4
        Ok(node4):
            if xml_children_len(node4) == 1 do
                let ch4 = xml_child_at(node4, 0)
                if test_str_eq(xml_get_text(ch4), "& < > \" '") do
                    print 4
                end
            end
        Err(_): print 0
    end

    # 5. Nested elements
    let xml5 = "<catalog><item id=\"1\"/><item id=\"2\"/></catalog>"
    let r5 = xml_parse(xml5)
    case r5
        Ok(node5):
            if test_str_eq(xml_get_tag(node5), "catalog") and xml_children_len(node5) == 2 do
                let it1 = xml_child_at(node5, 0)
                let it2 = xml_child_at(node5, 1)
                let opt_id1 = xml_get_attr(it1, "id")
                case opt_id1
                    Some(v1):
                        if test_str_eq(v1, "1") do
                            let opt_id2 = xml_get_attr(it2, "id")
                            case opt_id2
                                Some(v2):
                                    if test_str_eq(v2, "2") do print 5 end
                                None: print 0
                            end
                        end
                    None: print 0
                end
            end
        Err(_): print 0
    end

    # 6. XML Serializer round-trip
    let orig_node = xml_element_new("card")
    xml_set_attr(orig_node, "suit", "hearts")
    xml_add_child(orig_node, xml_text_new("Ace"))
    let ser_xml = xml_stringify(orig_node)
    let r6 = xml_parse(ser_xml)
    case r6
        Ok(node6):
            if test_str_eq(xml_get_tag(node6), "card") do
                let opt_suit = xml_get_attr(node6, "suit")
                case opt_suit
                    Some(s):
                        if test_str_eq(s, "hearts") and xml_children_len(node6) == 1 do
                            let txt_node = xml_child_at(node6, 0)
                            if test_str_eq(xml_get_text(txt_node), "Ace") do
                                print 6
                            end
                        end
                    None: print 0
                end
            end
        Err(_): print 0
    end

    # 7. XXE Protection: DOCTYPE rejected
    let xxe_doc = "<!DOCTYPE foo [<!ENTITY xxe SYSTEM \"file:///etc/passwd\">]><foo>&xxe;</foo>"
    let r7 = xml_parse(xxe_doc)
    case r7
        Ok(_): print 0
        Err(_): print 7
    end

    # 8. XXE Protection: ENTITY rejected
    let xxe_ent = "<!ENTITY xxe \"exploit\"><foo>test</foo>"
    let r8 = xml_parse(xxe_ent)
    case r8
        Ok(_): print 0
        Err(_): print 8
    end

    # 9. Strict syntax errors: mismatched tags
    let r9 = xml_parse("<open>mismatched</close>")
    case r9
        Ok(_): print 0
        Err(_): print 9
    end

    # 10. Strict syntax errors: unclosed tag
    let r10 = xml_parse("<unclosed>content")
    case r10
        Ok(_): print 0
        Err(_): print 10
    end

    # 11. YAML: explicitly NOT IMPLEMENTED
    let r11 = yaml_parse("name: Vir\nversion: 2.9\n")
    case r11
        Ok(_): print 0
        Err(e):
            if test_str_eq(e.message, "YAML parser: NOT IMPLEMENTED (complexity and security attack surface; use vir.data.toml or vir.data.json)") do
                print 11
            end
    end

    print 333
    out 0
end.
