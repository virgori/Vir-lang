# Vir2.0 Module System Demonstration
# Form 1: Include whole module
include "stdlib/vir/rt/vec_rt.vri";

# Form 2: Import specific symbols directly from module (no include required beforehand)
import vec_new_rt, vec_len_rt from "stdlib/vir/rt/vec_rt.vri";

func main:
    # Use symbol imported directly
    var v = vec_new_rt()
    print vec_len_rt(v)
end
