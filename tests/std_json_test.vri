include vir.data.json

extern func native_read_u8(addr: int, offset: int) -> int
extern func native_write_u8(addr: int, offset: int, val: int)

func test_str_eq(a: string, b: string) -> bool:
    let pa = a as int
    let pb = b as int
    if pa == pb do out true end
    if pa == 0 or pb == 0 do out false end
    var i = 0
    loop
        let ca = native_read_u8(pa, i)
        let cb = native_read_u8(pb, i)
        if ca != cb do out false end
        if ca == 0 do out true end
        i = i + 1
    end
    out true
end.

func test_str_len(s: string) -> int:
    let p = s as int
    if p == 0 do out 0 end
    var i = 0
    when native_read_u8(p, i) != 0 loop
        i = i + 1
    end
    out i
end.

func main:
    # 1. Primitives parse & stringify
    let r_null = json.read("null")
    case r_null
        Ok(v):
            if v.kind() == JsonType.Null and test_str_eq(json.write(v), "null") do
                print 1
            end
        Err(_): print 0
    end

    let r_true = json.read("true")
    case r_true
        Ok(v):
            if v.kind() == JsonType.Bool and v.as_bool() and test_str_eq(json.write(v), "true") do
                print 2
            end
        Err(_): print 0
    end

    let r_false = json.read("false")
    case r_false
        Ok(v):
            if v.kind() == JsonType.Bool and v.as_bool() == false and test_str_eq(json.write(v), "false") do
                print 3
            end
        Err(_): print 0
    end

    let r_num = json.read("42")
    case r_num
        Ok(v):
            if v.kind() == JsonType.Number and v.as_int() == 42 do
                print 4
            end
        Err(_): print 0
    end

    let r_neg = json.read("-100")
    case r_neg
        Ok(v):
            if v.kind() == JsonType.Number and v.as_int() == 0 - 100 do
                print 5
            end
        Err(_): print 0
    end

    let r_str = json.read("\"hello world\"")
    case r_str
        Ok(v):
            if v.kind() == JsonType.Str and test_str_eq(v.as_string(), "hello world") do
                print 6
            end
        Err(_): print 0
    end

    # 2. Escape characters
    let r_esc = json.read("\"line1\\nline2\\ttab\\\"quote\\\\slash\"")
    case r_esc
        Ok(v):
            if v.kind() == JsonType.Str and test_str_eq(v.as_string(), "line1\nline2\ttab\"quote\\slash") do
                print 7
            end
        Err(_): print 0
    end

    # 3. Array parse & round trip
    let r_arr = json.read("[1, 2, 3]")
    case r_arr
        Ok(v):
            if v.kind() == JsonType.Array and json.count(v) == 3 do
                let item0 = json.at(v, 0)
                let item1 = json.at(v, 1)
                let item2 = json.at(v, 2)
                if item0.as_int() == 1 and item1.as_int() == 2 and item2.as_int() == 3 do
                    print 8
                end
            end
        Err(_): print 0
    end

    # 4. Object parse & round trip
    let r_obj = json.read("{\"name\": \"Vir\", \"version\": 2}")
    case r_obj
        Ok(v):
            if v.kind() == JsonType.Object and json.count(v) == 2 do
                let opt_name = json.get(v, "name")
                case opt_name
                    Some(name_val):
                        if test_str_eq(json.as_string(name_val), "Vir") do
                            print 9
                        end
                    None: print 0
                end
                let opt_ver = json.get(v, "version")
                case opt_ver
                    Some(ver_val):
                        if json.as_int(ver_val) == 2 do
                            print 10
                        end
                    None: print 0
                end
            end
        Err(_): print 0
    end

    # 5. Strict RFC 8259 rejection: leading zero
    let err_lead_zero = json.read("01")
    case err_lead_zero
        Ok(_): print 0
        Err(_): print 11
    end

    let err_neg_zero = json.read("-01")
    case err_neg_zero
        Ok(_): print 0
        Err(_): print 12
    end

    # 6. Strict rejection: trailing comma in array
    let err_arr_comma = json.read("[1, 2,]")
    case err_arr_comma
        Ok(_): print 0
        Err(_): print 13
    end

    # 7. Strict rejection: trailing comma in object
    let err_obj_comma = json.read("{\"a\": 1,}")
    case err_obj_comma
        Ok(_): print 0
        Err(_): print 14
    end

    # 8. Strict rejection: unquoted key
    let err_unquoted = json.read("{a: 1}")
    case err_unquoted
        Ok(_): print 0
        Err(_): print 15
    end

    # 9. Strict rejection: comments (dynamically build '//' to avoid preprocessor comment strip)
    let comment_buf = vir_alloc(16)
    native_write_u8(comment_buf, 0, 47) # '/'
    native_write_u8(comment_buf, 1, 47) # '/'
    native_write_u8(comment_buf, 2, 97) # 'a'
    native_write_u8(comment_buf, 3, 0)
    let err_comment = json.read(comment_buf as string)
    case err_comment
        Ok(_): print 0
        Err(_): print 16
    end

    # 10. Strict rejection: trailing garbage
    let err_garbage = json.read("{\"a\": 1} extra")
    case err_garbage
        Ok(_): print 0
        Err(_): print 17
    end

    # 11. Surrogate pair handling: \uD83D\uDE00 (Grinning face: U+1F600, UTF-8: 0xF0 0x9F 0x98 0x80)
    let r_surr = json.read("\"\\uD83D\\uDE00\"")
    case r_surr
        Ok(v):
            let p = v.as_string() as int
            if native_read_u8(p, 0) == 240 and
               native_read_u8(p, 1) == 159 and
               native_read_u8(p, 2) == 152 and
               native_read_u8(p, 3) == 128 and
               native_read_u8(p, 4) == 0 do
                print 18
            end
        Err(_): print 0
    end

    # 12. Strict rejection: lone surrogate
    let err_lone = json.read("\"\\uD83D\"")
    case err_lone
        Ok(_): print 0
        Err(_): print 19
    end

    # 13. Serializer & Pretty printing
    let obj2 = json.object()
    obj2.set("title", json.string("Vir Lang"))
    obj2.set("active", json.bool(true))
    let str_compact = json.write(obj2)
    let str_pretty = json.pretty(obj2)
    if test_str_len(str_compact) > 0 and test_str_len(str_pretty) > test_str_len(str_compact) do
        print 20
    end

    print 999
    out 0
end.
