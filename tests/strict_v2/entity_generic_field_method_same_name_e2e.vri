entity Container of (T):
    len: int
    cap: int

    method len() -> int:
        out this.len + 100
    end.

    method cap() -> int:
        out this.cap + 200
    end.
end.

func main:
    var c = Container of (int)(len: 5, cap: 10)
    print(c.len)
    print(c.len())
    print(c.cap)
    print(c.cap())
    out 0
end.
