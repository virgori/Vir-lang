# EXPECT_DIAGNOSTIC: E3001
# VIR-SPC-0023: method type failure must not fall back to compatible free UFCS.

entity Selector:
    value: int

    method choose(value: int) -> int:
        out this.value + value
    end
end.

func choose(this: Selector, value: string) -> int:
    out 900 + this.value
end.

func main:
    let selector = Selector(value: 7)
    print(selector.choose("free-compatible"))
    out 0
end.
