# EXPECT_START
# 77
# 92
# EXPECT_END

entity Holder of (T):
    value: T
end.

func peek of (T)(ref h: Holder of (T)) -> T:
    out h.value
end.

func bump of (T)(ref h: Holder of (T), delta: T):
    h.value = h.value + delta
end.

func main:
    var h = Holder of (int)(value: 77)
    print(h.peek())
    h.bump(15)
    print(h.peek())
    out 0
end.
