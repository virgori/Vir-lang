# EXPECT: 0
entity TensorBox:
    value: tensor[i32; 2, 2]
end.

func make_tensor() -> tensor[i32; 2, 2]:
    var value: tensor[i32; 2, 2] = [1, 2, 3, 4]
    out value
end.

func tensor_sum(value: tensor[i32; 2, 2]) -> int:
    out value[0, 0] + value[0, 1] + value[1, 0] + value[1, 1]
end.

func main() -> int:
    var direct = make_tensor()
    if tensor_sum(direct) != 10 do out 1 end

    var box = TensorBox(value: make_tensor())
    if tensor_sum(box.value) != 10 do out 2 end
    out 0
end.
