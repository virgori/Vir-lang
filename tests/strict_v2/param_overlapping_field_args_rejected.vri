# EXPECT_DIAGNOSTIC: E5003
# §14.4: the same field cannot back two simultaneous mutable parameters.

entity Pair:
    left: int
    right: int
end.

func swap(ref first: int, ref second: int):
    var temporary = first
    first = second
    second = temporary
end.

func main:
    var pair = Pair(left: 1, right: 2)
    swap(pair.left, pair.left)
    out 0
end.
