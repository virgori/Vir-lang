# EXPECT_DIAGNOSTIC: E3022
# VIR-SPC-0023: a same-named method is terminal even when free UFCS would match.

entity Selector:
    value: int

    method choose(value: int) -> int:
        out this.value + value
    end
end.

func choose(this: Selector) -> int:
    out 900 + this.value
end.

func main:
    let selector = Selector(value: 7)
    print(selector.choose())
    out 0
end.
