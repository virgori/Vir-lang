# EXPECT_START
# test_flush_ok
# err_line1
# err_line2
# from_readln: Hello CRLF
# from_read_line: Hello LF
# from_eof: EMPTY
# EXPECT_END
# STDIN: Hello CRLF\r\nHello LF\n

import input, readln, read_line, print, println, eprint, eprintln, flush, flush_stdout, flush_stderr from stdio
include types
include string_rt
import rt_strlen from string_rt

func main:
    flush()
    flush_stdout()
    flush_stderr()
    println("test_flush_ok")

    eprint("err_line1\n")
    eprintln("err_line2")

    let s1 = readln()
    println("from_readln: " + s1)

    let s2 = read_line()
    println("from_read_line: " + s2)

    let s3 = readln()
    if rt_strlen(s3 as int) == 0 do
        println("from_eof: EMPTY")
    else
        println("from_eof: " + s3)
    end

    out 0
end.
