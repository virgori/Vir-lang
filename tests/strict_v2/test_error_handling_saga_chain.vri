# EXPECT_START
# 10
# 20
# 30
# 100
# EXPECT_END
# §13: Multi-level try-revert saga compensation chain with unannotated functions

func step1:
    try:
        throw 1
    revert
        print 10
        resume revert
    end
revert
    print 20
ensure
    print 30
end.

func step2:
    try:
        step1()
    revert
        print 40
    end
ensure
    print 100
end.

func main:
    step2()
end.
