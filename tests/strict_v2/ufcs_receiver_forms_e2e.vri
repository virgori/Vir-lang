# EXPECT_START
# 10
# 5
# 7
# 42
# EXPECT_END

entity Box:
    value: int

    method score() -> int:
        out this.value + 1
    end.
end.

entity Holder:
    box: Box
end.

func clamp(this: int, lo: int, hi: int) -> int:
    if this < lo do out lo end
    if this > hi do out hi end
    out this
end.

func main:
    print(15.clamp(0, 10))
    print((2 + 3).clamp(0, 10))
    var values = [3, 7]
    print(values[1].clamp(0, 10))
    var holder = Holder(box: Box(value: 41))
    print(holder.box.score())
    out 0
end.
