#*#
  File: tests/strict_v2/test_spec2_comments_comprehensive_e2e.vri
  Spec 2: Comments (Chu thich)
  - Single line: # ...
  - Multi-line block: hash-star-hash
  - Legacy block: hash-hash
  - UTF-8 and Vietnamese accented text inside comments
  - Inline block comments within expressions
  - Delimiters and quotes within comments
  - Same-line block comment before UTF-8 code (regression test)
#*#

# EXPECT_START
# 125
# 999
# xin chào thế giới
# 天地玄黃
# 42
# EXPECT_END

# Line comment with special characters: / * + - = < > ( ) [ ] { } : ; , . @ $ % ^ & | ! ? ~
# Line comment with Vietnamese: Chú thích dòng đơn với tiếng Việt có dấu: á à ả ã ạ đ ê ô ơ ư
# Empty comment next line:
#

func main:
    # 1. Inline block comment in expression
    var sum = 100 + #*# inline block comment #*# 20 + ## legacy inline comment ## 5
    print sum

    # 2. Block comment containing Vir keywords and code that should be ignored
    #*#
        func fake_function:
            var ignored = 12345
            print ignored
        end.
    #*#

    # 3. Block comment containing quotes and interpolation markers
    #*#
        "this is not a string literal"
        'not a char'
        $should_not_interpolate
        #{1 + 2}
        ## inside preferred block ##
        * # * #
    #*#

    # 4. Legacy block comment containing preferred delimiter lookalike
    ##
        inside legacy block comment
        var dummy = 9999
        $unexpanded
    ##

    var val = 999
    print val

    # 5. Same-line block comment before UTF-8 string literal (regression test for text_ascii_sanitize)
    #*# block on same line #*# var s_vn: string = "xin chào thế giới"
    print_str(s_vn)

    # 6. Same-line legacy block comment before CJK string literal
    ## legacy block on same line ## var s_cjk: string = "天地玄黃"
    print_str(s_cjk)

    # 7. Consecutive empty block comments
    #*##*#
    ####
    var final_val = 42
    print final_val

    out 0
end.
# Trailing line comment at EOF
