extern func native_read_u8(addr: int, offset: int) -> int
extern func native_read_i64(addr: int, offset: int) -> int

func main() -> int:
    # ── Test 1: INT8, scale=1 (max_abs=4 <= 127) ──────────────────────────
    var w: tensor<f32>[2, 2] = [1.0, 2.0, 3.0, 4.0]
    var q8 = quantize(w, bits: 8)
    var p8 = q8 as int
    if native_read_i64(p8, 0) != 4 do out 1 end   # numel
    if native_read_i64(p8, 8) != 8 do out 2 end   # bits
    if native_read_i64(p8, 16) != 1 do out 3 end  # scale
    if native_read_i64(p8, 24) != 0 do out 4 end  # zero_point
    if native_read_u8(p8, 32) != 1 do out 10 end  # q[0]=1
    if native_read_u8(p8, 33) != 2 do out 11 end  # q[1]=2
    if native_read_u8(p8, 34) != 3 do out 12 end  # q[2]=3
    if native_read_u8(p8, 35) != 4 do out 13 end  # q[3]=4

    # ── Test 2: INT8, negative values ─────────────────────────────────────
    var neg: tensor<f32>[2, 1] = [-5.0, 10.0]
    var qn = quantize(neg, bits: 8)
    var pn = qn as int
    if native_read_i64(pn, 16) != 1 do out 20 end  # scale=1
    if native_read_u8(pn, 32) != 251 do out 21 end # -5 as u8 = 251 (0xFB)
    if native_read_u8(pn, 33) != 10 do out 22 end  # 10 as u8 = 10

    # ── Test 3: INT8, large values -> scale=2 ─────────────────────────────
    var big: tensor<f32>[2, 1] = [127.0, 254.0]
    var qb = quantize(big, bits: 8)
    var pb = qb as int
    if native_read_i64(pb, 16) != 2 do out 30 end  # scale=2
    if native_read_u8(pb, 32) != 63 do out 31 end  # 127/2=63
    if native_read_u8(pb, 33) != 127 do out 32 end # 254/2=127

    # ── Test 4: INT4 packing ──────────────────────────────────────────────
    var q4 = quantize(w, bits: 4)
    var p4 = q4 as int
    if native_read_i64(p4, 0) != 4 do out 40 end   # numel
    if native_read_i64(p4, 8) != 4 do out 41 end   # bits=4
    if native_read_i64(p4, 16) != 1 do out 42 end  # scale=1 (4 <= 7)
    # 1.0 (low 0x1) and 2.0 (high 0x2) packed into byte 0 = 0x21 = 33
    if native_read_u8(p4, 32) != 33 do out 43 end
    # 3.0 (low 0x3) and 4.0 (high 0x4) packed into byte 1 = 0x43 = 67
    if native_read_u8(p4, 33) != 67 do out 44 end

    print "PASS: quantize E2E all tests (INT8 + INT4 + negative + scale)"
    out 0
end.
