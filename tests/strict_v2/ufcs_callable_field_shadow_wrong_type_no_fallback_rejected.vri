# EXPECT_DIAGNOSTIC: E3001
# VIR-SPC-0023: callable-field type failure must not fall back to free UFCS.

func identity(value: int) -> int:
    out value
end.

entity Handler:
    execute: func(int) -> int
end.

func execute(this: Handler, value: string) -> int:
    out 900
end.

func main:
    let handler = Handler(execute: identity)
    print(handler.execute("free-compatible"))
    out 0
end.
