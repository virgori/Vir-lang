# EXPECT_DIAGNOSTIC: E3022
# VIR-SPC-0023: a selected callable field is terminal even when free UFCS matches.

func identity(value: int) -> int:
    out value
end.

entity Handler:
    execute: func(int) -> int
end.

func execute(this: Handler) -> int:
    out 900
end.

func main:
    let handler = Handler(execute: identity)
    print(handler.execute())
    out 0
end.
