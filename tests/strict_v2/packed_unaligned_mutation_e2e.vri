extern func native_read_u8(addr: int, offset: int) -> int

packed entity Frame:
    head: u8
    code: u32
    tail: u16
end.

func main:
    var frame: Frame = Frame(head: 165, code: 287454020, tail: 23205)
    frame.code = 2005440938
    print(frame.head)
    print(frame.code)
    print(frame.tail)
    print(native_read_u8(frame as int, 0))
    print(native_read_u8(frame as int, 1))
    print(native_read_u8(frame as int, 2))
    print(native_read_u8(frame as int, 3))
    print(native_read_u8(frame as int, 4))
    print(native_read_u8(frame as int, 5))
    print(native_read_u8(frame as int, 6))
    out 0
end.
