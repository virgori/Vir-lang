# UFCS: An inherent method takes precedence over a callable field with the same name (VIR-SPC-0017 §11.4).

func fallback_handler(value: int) -> int:
    out 12
end.

entity Dispatcher:
    action: func(int) -> int

    method action(value: int) -> int:
        out 88
    end.
end.

func main:
    var d = Dispatcher(action: fallback_handler)
    print(d.action(1))
    out 0
end.
