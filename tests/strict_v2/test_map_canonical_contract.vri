# EXPECT_START
# 5
# 8
# 3
# 230
# 4
# 20
# 3
# 27
# EXPECT_END
func main():
    let r = map x in 0..5:
        out x * 2
    end
    print len(r)
    print r[4]

    let arr = [10, 20, 30]
    let res2 = map i, v in arr:
        out i * 100 + v
    end
    print len(res2)
    print res2[2]

    let res3 = map x in [1, 2, 3, 4]:
        if x mod 2 == 0 do
            out x * 10
        else
            out x
        end
    end
    print len(res3)
    print res3[1]

    let res4 = map x in [5, 6, 7]:
        let y = x + 2
        out y * 3
    end
    print len(res4)
    print res4[2]
end.
