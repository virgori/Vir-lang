# Minimal UFCS fixture for RISC-V fail-closed mutation tests.
# No port/send/async — only basic free UFCS function calls.
# EXPECT_START
# 42
# EXPECT_END

func add_one(x: int):
    out x + 1
end.

func double(x: int):
    out x * 2
end.

func main:
    let a = 20
    let b = a.add_one().double()
    print(b)
    out 0
end.
