# EXPECT_START
# 101
# 1
# 1
# 202
# 303
# EXPECT_END

include option
include result

func option_value(opt: Option of (int)) -> int:
    case opt
        Some(value): out value
        None: out 0
    end
end.

func result_value(result: Result of (int, int)) -> int:
    case result
        Success(value): out value
        Failure(err): out err
    end
end.

func main:
    let some = Some(101)
    let absent = None
    let ok = Success(202)
    let failed = Failure(303)

    print(option_value(some))
    print(is_some(some))
    print(is_none(absent))
    print(result_value(ok))
    print(result_value(failed))
    out 0
end.
