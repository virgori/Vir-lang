# EXPECT_START
# 101
# 1
# 1
# 202
# 303
# EXPECT_END

include option
import Option, Some, None, is_some, is_none from option
include result
import Result, Ok, Err, is_ok, is_err from result

func option_value(opt: Option<int>) -> int:
    case opt
        Some(value): out value
        None: out 0
    end
end.

func result_value(result: Result<int, int>) -> int:
    case result
        Ok(value): out value
        Err(err): out err
    end
end.

func main:
    let some = Some(101)
    let absent = None
    let ok = Ok(202)
    let failed = Err(303)

    print(option_value(some))
    print(is_some(some))
    print(is_none(absent))
    print(result_value(ok))
    print(result_value(failed))
    out 0
end.
