func main:
    var weights: tensor[f16; 2, 2] = [1.0, 2.0, 3.0, 4.0]
    var input: tensor[f16; 2, 1] = [1.0, 1.0]
    var compact4 = quantize(weights, bits: 4)
    var compact8 = quantize(weights, bits: 8)
    var compact16 = quantize(weights, bits: 16)
    var compact32 = quantize(weights, bits: 32)
    infer:
        var output4 = compact4 ** input
        var output8 = compact8 ** input
        var output16 = compact16 ** input
        var output32 = compact32 ** input
        print output4[0, 0]
        print output4[1, 0]
        print output8[0, 0]
        print output8[1, 0]
        print output16[0, 0]
        print output16[1, 0]
        print output32[0, 0]
        print output32[1, 0]
    end
end.
