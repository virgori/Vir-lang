# EXPECT_DIAGNOSTIC: E3008
# EXPECT_CAUSE: Field name does not exist on the target entity
# EXPECT_ACTION: Check field name spelling in entity definition
# EXPECT_COMPILE_FAIL: Unknown entity field access 'tone_name'
entity Syllable:
    initial: string,
    final: string,
    tone: int
end.

func main:
    var s = Syllable(initial: "d", final: "ang", tone: 1)
    print s.tone_name
end.
