# EXPECT: 137
# UFCS: Deeply nested arguments causing register pressure must preserve values across calls.

entity Calculator:
    base: int

    method calc(a: int, b: int) -> int:
        out this.base + a * 2 + b * 3
    end.

    method add_all(x: int, y: int) -> int:
        out this.base + x + y
    end.
end.

func main:
    var c = Calculator(base: 10)
    let res = c.add_all(c.calc(1, c.calc(2, 3)), c.calc(c.calc(1, 1), 2))
    print(res)
    out 0
end.
