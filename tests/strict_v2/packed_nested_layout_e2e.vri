extern func native_read_u8(addr: int, offset: int) -> int

packed entity Inner:
    low: u16
    high: u8
end.

packed entity Outer:
    tag: u8
    inner: Inner
    tail: u32
end.

func main:
    var inner: Inner = Inner(low: 8755, high: 68)
    var outer: Outer = Outer(tag: 17, inner: inner, tail: 1432778632)
    print(outer.tag)
    print(outer.inner.low)
    print(outer.inner.high)
    print(outer.tail)
    print(native_read_u8(outer as int, 0))
    print(native_read_u8(outer as int, 1))
    print(native_read_u8(outer as int, 2))
    print(native_read_u8(outer as int, 3))
    print(native_read_u8(outer as int, 4))
    out 0
end.
