# EXPECT_START
# 999
# 1
# 999
# 10
# 20
# 999
# 100
# 999
# 500
# EXPECT_END

func helper:
    print 999
end.

func main:
    # 1. Single var decl followed by function call on same line via semicolon
    var x = 1; helper()
    print x

    # 2. Multi-var decl group followed by function call on same line via semicolon
    var a = 10; b = 20; helper()
    print a
    print b

    # 3. Let decl followed by function call on same line via semicolon
    let m = 100; helper()
    print m

    # 4. Const decl followed by function call on same line via semicolon
    const K = 500; helper()
    print K
end.
