# VIR-SPC-0023: data-field access and free-function UFCS are distinct.

entity HasLabel:
    label: int
end.

func label(this: HasLabel) -> int:
    out this.label + 7
end.

func main:
    let value = HasLabel(label: 40)
    print(value.label)
    print(value.label())
    out 0
end.
