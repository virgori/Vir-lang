# EXPECT_DIAGNOSTIC: E5001
# EXPECT_DIAGNOSTIC_LINE: 19
# Use after move rejection: accessing generic entity receiver after ownership transfer.

entity Resource of (T):
    data: T
end.

func take_move of (T)(r: Resource of (T)) -> T:
    out r.data
end.

func read_val of (T)(ref r: Resource of (T)) -> T:
    out r.data
end.

func main:
    var r = Resource of (int)(data: 10)
    let moved_val = r.take_move()
    r.read_val()
    out 0
end.
