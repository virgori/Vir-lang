# EXPECT_END
# End-to-end verification of canonical symbol identity:
# Module MyMod defines foo(x) returning x + 10, and bar(x) calling x.foo().
# Root scope defines foo(x) returning x + 20.
# Both share the bare function name 'foo' without collision.

module MyMod

func foo(x: int):
    out x + 10
end.

func bar(x: int):
    out x.foo()
end.

module root

func foo(x: int):
    out x + 20
end.

func main:
    let r1 = bar(5)
    print(r1)
    let r2 = 5.foo()
    print(r2)
    out 0
end.
