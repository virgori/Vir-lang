# EXPECT: 153
# UFCS & function pointer spill under register pressure.

entity Handler:
    callback: func(int) -> int
end.

func add_one(x: int) -> int:
    out x + 1
end.

func test_spill(base: int) -> int:
    let fn_ptr = add_one
    let
        a1 = base + 1
        a2 = base + 2
        a3 = base + 3
        a4 = base + 4
        a5 = base + 5
        a6 = base + 6
        a7 = base + 7
        a8 = base + 8
        a9 = base + 9
        a10 = base + 10
        a11 = base + 11
        a12 = base + 12
        a13 = base + 13
        a14 = base + 14
        a15 = base + 15
        a16 = base + 16
    var h = Handler(callback: fn_ptr)
    let extra = h.callback(16)
    out a1 + a2 + a3 + a4 + a5 + a6 + a7 + a8 + a9 + a10 + a11 + a12 + a13 + a14 + a15 + a16 + extra
end.

func main:
    let res = test_spill(0)
    print(res)
    out 0
end.
