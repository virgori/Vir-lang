# EXPECT_START
# 7
# 42
# 43
# 420
# EXPECT_END

enum ExplicitTag:
    Ready = 7
    Running = 42
    Done
end.

func tag_code(value: ExplicitTag) -> int:
    case value
        ExplicitTag.Ready: out 70
        ExplicitTag.Running: out 420
        ExplicitTag.Done: out 430
    end
    out -1
end.

func main:
    print(ExplicitTag.Ready)
    print(ExplicitTag.Running)
    print(ExplicitTag.Done)
    print(tag_code(ExplicitTag.Running))
    out 0
end.
