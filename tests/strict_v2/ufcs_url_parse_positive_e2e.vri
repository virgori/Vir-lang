# EXPECT_EXIT: 1
# Positive control for url parsing with canonical url.*
# main returns the parse result as its process exit code; it does not print it.

include url

extern func native_read_u8(addr: int, offset: int) -> int

func test_str_eq(a: string, b: string) -> bool:
    pa = a as int
    pb = b as int
    if pa == pb do out true end
    if pa == 0 or pb == 0 do out false end
    i = 0
    loop
        ca = native_read_u8(pa, i)
        cb = native_read_u8(pb, i)
        if ca != cb do out false end
        if ca == 0 do out true end
        i = i + 1
    end
    out true
end.

func parse(raw_uri: string) -> int:
    case url.parse(raw_uri)
    Ok(u):
        p = u.path
        if test_str_eq(p, "/health") do
            out 1
        end
        out 0
    Err(_):
        out 0
    end
end.

func main:
    out parse("http://127.0.0.1:8080/health")
end.
