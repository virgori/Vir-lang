#
# mc_verify: error: missing or invalid symbol operand in instruction
#
# 1
# EXPECT_END
# Structural negative tests verifying that MC verifiers and backends
# fail closed on malformed/unresolved direct call and address-of symbol metadata
# across ARM64, x86-64, and RISC-V architectures.

include types
include string_rt
import fat_str_new from string_rt
include vec_rt
import vec_new_rt, vec_push_rt from vec_rt
include compiler.mc
import TargetArch, MCOpcode, RelocKind, MCInst, MCOperand,
       mc_inst_new, mc_opnd_new, mc_opnd_none, mc_opnd_reg, mc_opnd_symbol, mc_opnd_symbol_fat from compiler.mc
include compiler.mc.verify
import mc_verify_inst, mc_verify_function, mc_verify_register_symbol from compiler.mc.verify

func main:
    let op_n0 = mc_opnd_none()
    let op_n1 = mc_opnd_none()
    let op_d = mc_opnd_reg(0)

    # 1. ARM64: direct call with missing symbol operand (null symbol)
    let bad_sym_arm = mc_opnd_symbol(0, RelocKind.ARM64_CALL26, 0)
    let inst_arm = mc_inst_new(MCOpcode.ARM64_BL, bad_sym_arm, op_n0, op_n0, op_n1, 0)
    let res_arm = mc_verify_inst(inst_arm, TargetArch.ARM64, 0)
    if res_arm != 0 do
        print(101) # ARM64 should fail verification
        out 1
    end

    # 2. x86-64: direct call with missing symbol operand (null symbol)
    let bad_sym_x86 = mc_opnd_symbol(0, RelocKind.X86_64_PLT32, 0)
    let inst_x86 = mc_inst_new(MCOpcode.X86_64_CALL, bad_sym_x86, op_n0, op_n0, op_n1, 0)
    let res_x86 = mc_verify_inst(inst_x86, TargetArch.X86_64, 0)
    if res_x86 != 0 do
        print(102) # x86-64 should fail verification
        out 1
    end

    # 3. RISC-V: direct call with missing symbol operand (null symbol)
    let bad_sym_rv_call = mc_opnd_symbol(0, RelocKind.RISCV_CALL, 0)
    let inst_rv_call = mc_inst_new(MCOpcode.RISCV_JAL, bad_sym_rv_call, op_n0, op_n0, op_n1, 0)
    let res_rv_call = mc_verify_inst(inst_rv_call, TargetArch.RISCV64, 0)
    if res_rv_call != 0 do
        print(103) # RISC-V call should fail verification
        out 1
    end

    # 4. RISC-V: address-of with missing symbol operand (null symbol)
    let bad_sym_rv_la = mc_opnd_symbol(0, RelocKind.RISCV_HI20, 0)
    let inst_rv_la = mc_inst_new(MCOpcode.RISCV_LA, op_d, bad_sym_rv_la, op_n0, op_n1, 0)
    let res_rv_la = mc_verify_inst(inst_rv_la, TargetArch.RISCV64, 0)
    if res_rv_la != 0 do
        print(104) # RISC-V LA should fail verification
        out 1
    end

    # 5. mc_verify_function on stream containing malformed inst
    let bad_stream = vec_new_rt()
    vec_push_rt(bad_stream, inst_arm as i64)
    let res_fn_bad = mc_verify_function(bad_stream, TargetArch.ARM64)
    if res_fn_bad != 0 do
        print(105) # Function verification should fail on malformed stream
        out 1
    end

    # 6. Reject raw integer as symbol pointer
    let bad_sym_int = mc_opnd_symbol(12345, RelocKind.ARM64_CALL26, 0)
    let inst_int_arm = mc_inst_new(MCOpcode.ARM64_BL, bad_sym_int, op_n0, op_n0, op_n1, 0)
    let res_int_arm = mc_verify_inst(inst_int_arm, TargetArch.ARM64, 0)
    if res_int_arm != 0 do
        print(106) # Raw integer must fail verification
        out 1
    end

    # 6b. Reject fake pointer >= 65536 without SIGSEGV (raw integer 999999)
    let bad_sym_ptr1 = mc_opnd_symbol(999999, RelocKind.ARM64_CALL26, 0)
    let inst_ptr1 = mc_inst_new(MCOpcode.ARM64_BL, bad_sym_ptr1, op_n0, op_n0, op_n1, 0)
    let res_ptr1 = mc_verify_inst(inst_ptr1, TargetArch.ARM64, 0)
    if res_ptr1 != 0 do
        print(161) # Fake pointer >= 65536 must fail verification
        out 1
    end

    # 6c. Reject fake fat pointer >= 65536 without SIGSEGV (raw integer 1000000)
    let bad_sym_ptr2 = mc_opnd_symbol_fat(1000000, RelocKind.ARM64_CALL26, 0)
    let inst_ptr2 = mc_inst_new(MCOpcode.ARM64_BL, bad_sym_ptr2, op_n0, op_n0, op_n1, 0)
    let res_ptr2 = mc_verify_inst(inst_ptr2, TargetArch.ARM64, 0)
    if res_ptr2 != 0 do
        print(162) # Fake fat pointer >= 65536 must fail verification
        out 1
    end

    # 6d. Reject fake addresses >= 4MB without SIGSEGV (4194304)
    let bad_sym_4m = mc_opnd_symbol(4194304, RelocKind.ARM64_CALL26, 0)
    let inst_4m = mc_inst_new(MCOpcode.ARM64_BL, bad_sym_4m, op_n0, op_n0, op_n1, 0)
    let res_4m = mc_verify_inst(inst_4m, TargetArch.ARM64, 0)
    if res_4m != 0 do
        print(163) # Fake address 4194304 must fail verification without SIGSEGV
        out 1
    end

    # 6e. Reject fake address 5000000
    let bad_sym_5m = mc_opnd_symbol(5000000, RelocKind.ARM64_CALL26, 0)
    let inst_5m = mc_inst_new(MCOpcode.ARM64_BL, bad_sym_5m, op_n0, op_n0, op_n1, 0)
    let res_5m = mc_verify_inst(inst_5m, TargetArch.ARM64, 0)
    if res_5m != 0 do
        print(164) # Fake address 5000000 must fail verification
        out 1
    end

    # 6f. Reject fake address 10000000 via mc_opnd_new directly
    let bad_sym_10m = mc_opnd_new(4, 1, 0, 0, 0, 0, 0, 10000000, RelocKind.ARM64_CALL26, 0)
    let inst_10m = mc_inst_new(MCOpcode.ARM64_BL, bad_sym_10m, op_n0, op_n0, op_n1, 0)
    let res_10m = mc_verify_inst(inst_10m, TargetArch.ARM64, 0)
    if res_10m != 0 do
        print(165) # Fake address 10000000 must fail verification
        out 1
    end

    # 6g. Reject fake address 0x70000000 (1879048192) via mc_opnd_new directly
    let bad_sym_high = mc_opnd_new(4, 1, 0, 0, 0, 0, 0, 1879048192, RelocKind.ARM64_CALL26, 0)
    let inst_high = mc_inst_new(MCOpcode.ARM64_BL, bad_sym_high, op_n0, op_n0, op_n1, 0)
    let res_high = mc_verify_inst(inst_high, TargetArch.ARM64, 0)
    if res_high != 0 do
        print(166) # Fake address 0x70000000 must fail verification
        out 1
    end

    # 6h. Reject fake fat address 4194304
    let bad_fat_4m = mc_opnd_symbol_fat(4194304, RelocKind.ARM64_CALL26, 0)
    let inst_fat_4m = mc_inst_new(MCOpcode.ARM64_BL, bad_fat_4m, op_n0, op_n0, op_n1, 0)
    let res_fat_4m = mc_verify_inst(inst_fat_4m, TargetArch.ARM64, 0)
    if res_fat_4m != 0 do
        print(167) # Fake fat address 4194304 must fail verification
        out 1
    end

    # 7. Reject invalid character in symbol string
    let bad_str_chars = fat_str_new("bad#sym!")
    let bad_sym_str = mc_opnd_symbol_fat(bad_str_chars as int, RelocKind.ARM64_CALL26, 0)
    let inst_bad_chars = mc_inst_new(MCOpcode.ARM64_BL, bad_sym_str, op_n0, op_n0, op_n1, 0)
    let res_bad_chars = mc_verify_inst(inst_bad_chars, TargetArch.ARM64, 0)
    if res_bad_chars != 0 do
        print(107) # Illegal characters must fail verification
        out 1
    end

    # 8. Valid runtime symbol passes verification
    let valid_str_rt = fat_str_new("rt_print_int")
    let valid_sym_rt = mc_opnd_symbol_fat(valid_str_rt as int, RelocKind.ARM64_CALL26, 0)
    let valid_inst_rt = mc_inst_new(MCOpcode.ARM64_BL, valid_sym_rt, op_n0, op_n0, op_n1, 0)
    let res_valid_rt = mc_verify_inst(valid_inst_rt, TargetArch.ARM64, 0)
    if res_valid_rt != 1 do
        print(108) # Runtime symbol should pass verification
        out 1
    end

    # 9. Registered user symbol passes verification
    let valid_str_user = fat_str_new("custom_calc")
    mc_verify_register_symbol(valid_str_user)
    let valid_sym_user = mc_opnd_symbol_fat(valid_str_user as int, RelocKind.ARM64_CALL26, 0)
    let valid_inst_user = mc_inst_new(MCOpcode.ARM64_BL, valid_sym_user, op_n0, op_n0, op_n1, 0)
    let res_valid_user = mc_verify_inst(valid_inst_user, TargetArch.ARM64, 0)
    if res_valid_user != 1 do
        print(109) # Registered symbol should pass verification
        out 1
    end

    # 10. Valid function stream passes verification
    let good_stream = vec_new_rt()
    vec_push_rt(good_stream, valid_inst_user as i64)
    let res_fn_good = mc_verify_function(good_stream, TargetArch.ARM64)
    if res_fn_good != 1 do
        print(110) # Valid function stream should pass verification
        out 1
    end

    print(1)
    out 0
end.
