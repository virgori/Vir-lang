extern func native_read_u8(addr: int, offset: int) -> int

packed entity Ordered:
    first: u8
    second: u16
    third: u32
end.

func main:
    var value: Ordered = Ordered(third: 1146447479, first: 17, second: 8755)
    print(value.first)
    print(value.second)
    print(value.third)
    print(native_read_u8(value as int, 0))
    print(native_read_u8(value as int, 1))
    print(native_read_u8(value as int, 2))
    print(native_read_u8(value as int, 3))
    out 0
end.
