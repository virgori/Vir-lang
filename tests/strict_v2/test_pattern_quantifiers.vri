include virgex.virgex
include regex.regex

func main:
    print(regex_compile("a*").match(""))
    print(regex_compile("a*").match("aaa"))
    print(!regex_compile("a+").match(""))
    print(regex_compile("a+").match("aaa"))
    print(regex_compile("a?").match(""))
    print(regex_compile("a?").match("a"))
    print(regex_compile("[0-9]{2,}").match("123"))
    print(regex_compile("[0-9]{2,4}").match("123"))
    print(!regex_compile("[0-9]{2,4}").match("12345"))

    print(virgex_compile("a!~").match(""))
    print(virgex_compile("a!~").match("aaa"))
    print(virgex_compile("a!2~").match("aaa"))
    print(virgex_compile("a!2~4").match("aaa"))
    print(!virgex_compile("a!2~4").match("aaaaa"))
    print(virgex_compile("?a").match(""))
    print(virgex_compile("?a").match("a"))
    out 0
end.
