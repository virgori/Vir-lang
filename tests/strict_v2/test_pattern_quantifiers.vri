include virgex
include regex

func main:
    print(regex.compile("a*").fullMatch(""))
    print(regex.compile("a*").fullMatch("aaa"))
    print(!regex.compile("a+").fullMatch(""))
    print(regex.compile("a+").fullMatch("aaa"))
    print(regex.compile("a?").fullMatch(""))
    print(regex.compile("a?").fullMatch("a"))
    print(regex.compile("[0-9]{2,}").fullMatch("123"))
    print(regex.compile("[0-9]{2,4}").fullMatch("123"))
    print(!regex.compile("[0-9]{2,4}").fullMatch("12345"))

    print(virgex.compile("a!~").fullMatch(""))
    print(virgex.compile("a!~").fullMatch("aaa"))
    print(virgex.compile("a!2~").fullMatch("aaa"))
    print(virgex.compile("a!2~4").fullMatch("aaa"))
    print(!virgex.compile("a!2~4").fullMatch("aaaaa"))
    print(virgex.compile("?a").fullMatch(""))
    print(virgex.compile("?a").fullMatch("a"))
    out 0
end.
