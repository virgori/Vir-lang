# EXPECT_START
# 10
# 20
# EXPECT_END

func before_fn of (T)(ref h: OrderBox of (T)) -> T:
    out h.item
end.

entity OrderBox of (T):
    item: T
end.

func after_fn of (T)(ref h: OrderBox of (T), delta: T) -> T:
    out h.item + delta
end.

func main:
    var b = OrderBox of (int)(item: 10)
    print(b.before_fn())
    print(b.after_fn(10))
    out 0
end.
