# Test unannotated function parameter reassignment and inference in loop

func fib(n):
    var a = 0
    var b = 1
    var i = 0
    when i < n loop
        var next = a + b
        a = b
        b = next
        i = i + 1
    end
    out a
end.

func sum_to(limit):
    var total = 0
    var c = 1
    when c <= limit loop
        total = total + c
        c = c + 1
    end
    out total
end.

func main:
    print fib(7)
    print sum_to(5)
end.
