# EXPECT_START
# 7
# EXPECT_END

enum LoopResult:
    Ok(value)
    Err(reason)
end.

func propagate_error:
    for index in 0 .. 1 do
        let r = LoopResult.Err(7)
        case r
            Ok(value): print(value)
            Err(reason):
                print(reason)
                out LoopResult.Err(reason)
        end
    end
    out LoopResult.Ok(0)
end.

func main:
    let propagated = propagate_error()
    out 0
end.
