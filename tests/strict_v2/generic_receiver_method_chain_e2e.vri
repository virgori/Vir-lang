# EXPECT_START
# 123
# EXPECT_END

entity Box of (T):
    value: T

    method get_value() -> T:
        out this.value
    end
end.

entity Container of (T):
    boxed: Box of (T)

    method get_box() -> Box of (T):
        out this.boxed
    end
end.

func main:
    var b = Box of (int)(value: 123)
    var c = Container of (int)(boxed: b)
    print(c.get_box().get_value())
    out 0
end.
