# EXPECT: 42
# §14: entity-method calls preserve out caller-slot semantics.

entity Factory:
    seed: int

    method make:
        out value: int
        value = 42
    end.
end.

func main:
    var factory = Factory(seed: 0)
    var value: int
    factory.make(value)
    print value
    out 0
end.
