func main:
    var ints = arr_new(2)
    push(ints, 0)
    push(ints, 0)
    ints[0] = 12.9 as int
    ints[1] = -12.9 as int
    print ints[0]
    print ints[1]

    var floats = arr_new(2)
    push(floats, 0.0)
    push(floats, 0.0)
    floats[0] = 7 as float
    floats[1] = -8 as float
    if floats[0] == 7.0 do print 1 else print 0 end
    if floats[1] == -8.0 do print 1 else print 0 end

    var d = ["i": 0, "f": 0.0]
    d["i"] = 33.8 as int
    d["f"] = 44 as float
    print d["i"]
    if d["f"] == 44.0 do print 1 else print 0 end
end.
# EXPECT_START
# 12
# -12
# 1
# 1
# 33
# 1
# EXPECT_END
