# EXPECT_DIAGNOSTIC: E3021
# UFCS declaration order independence: A declared before B.
# Neither module is imported into root; calling 5.foo() must fail with E3021.

module A
export foo
func foo(x: int) -> int:
    out x * 5
end.

module B
export foo
func foo(x: int) -> int:
    out x * 3
end.

module root
func main:
    print(5.foo())
    out 0
end.
